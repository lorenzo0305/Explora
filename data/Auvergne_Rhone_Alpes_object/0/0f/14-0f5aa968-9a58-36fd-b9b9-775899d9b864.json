  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c68e15f7-1aed-39f4-a779-ca570216326f",
      "dc:description": {
        "de": [
          "Informationen :\n\nBesuchen Sie die Facebook-Seite, um zu erfahren, welche Artikel zum Verkauf stehen\n\nBestellung :\n\nPer Telefon 07 68 17 42 84 und messenger\n\nAbholung:\nTäglich von Montag bis Freitag vor dem Geschäft zum Mitnehmen.\n\n "
        ],
        "en": [
          "Information :\n\nVisit our Facebook page to see what's on sale\n\nHow to order:\n\nBy phone 07 68 17 42 84 and messenger\n\nPick-up:\nTakeaway every day from Monday to Friday in front of the store.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nVisitate la pagina Facebook per vedere cosa c'è in vendita\n\nCome ordinare:\n\nPer telefono 07 68 17 42 84 e messenger\n\nRitiro:\nDa asporto tutti i giorni dal lunedì al venerdì davanti al negozio.\n\n "
        ],
        "fr": [
          "Informations :\n\nConsultez la page Facebook pour connaitre les articles en vente\n\nCommande :\n\nPar téléphone 07 68 17 42 84 et messenger\n\nRetrait :\nÀ emporter tous les jours du lundi au vendredi devant le magasin.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nBezoek de Facebook-pagina om te zien wat er te koop is\n\nHoe te bestellen:\n\nTelefonisch 07 68 17 42 84 en via messenger\n\nAfhalen:\nAfhalen elke dag van maandag tot vrijdag voor de winkel.\n\n "
        ],
        "es": [
          "Más información :\n\nVisite la página de Facebook para saber qué está a la venta\n\nCómo hacer un pedido:\n\nPor teléfono 07 68 17 42 84 y messenger\n\nRecogida:\nPara llevar todos los días de lunes a viernes delante de la tienda.\n\n "
        ]
      },
