  "rdfs:comment": {
    "de": [
      "Möbel und Dekorationen von Philippe & Grégoire Allemand. Der Ursprung der Marke Le Héron: drei Jahrzehnte exzellentes Know-how in der Kunsttischlerei und der Intarsienarbeit, verbunden mit zwei Generationen, die ihre kreativen Wünsche teilen wollen."
    ],
    "en": [
      "Furniture and decor by Philippe & Grégoire Allemand. The origin of the Le Héron brand: three decades of excellence in cabinetmaking and marquetry, combined with two generations eager to share their creative desires."
    ],
    "it": [
      "Mobili e decorazioni di Philippe & Grégoire Allemand. Le origini del marchio Le Héron risiedono in tre decenni di eccellenza nell'ebanisteria e nell'intarsio, uniti a due generazioni desiderose di condividere i loro desideri creativi."
    ],
    "fr": [
      "Mobilier et décors signés Philippe & Grégoire Allemand. À l’origine de la marque Le Héron : trois décennies de savoir-faire d’excellence dans l’ébénisterie d’art et la marqueterie, alliées à deux générations désireuses de partager leurs envies créatrices."
    ],
    "es": [
      "Muebles y decoración de Philippe & Grégoire Allemand. Los orígenes de la marca Le Héron se remontan a tres décadas de excelencia en ebanistería y marquetería, combinadas con dos generaciones deseosas de compartir sus deseos creativos."
    ],
    "nl": [
      "Meubels en decor van Philippe & Grégoire Allemand. De oorsprong van het merk Le Héron ligt in drie decennia van uitmuntendheid in meubelmakerij en inlegwerk, gecombineerd met twee generaties die graag hun creatieve verlangens delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique Le Héron Création by Atelier Philippe Allemand"
    ]
  },
