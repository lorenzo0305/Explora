  "rdfs:comment": {
    "de": [
      "Unter der Seilbahn Transarc und oberhalb des Busbahnhofs von Les Villards auf dem Platz Aiguille des Glaciers gelegen, bieten wir köstliche FRISCHE Produkte an."
    ],
    "en": [
      "Located under the Transarc gondola and above the Villards bus station on the Aiguille des Glaciers square, we offer delicious FRESH produce."
    ],
    "it": [
      "Situati sotto la funivia del Transarc e sopra la stazione degli autobus di Villards, sul piazzale dell'Aiguille des Glaciers, offriamo deliziosi prodotti FRESCHI."
    ],
    "fr": [
      "Situés sous la télécabine Transarc et au dessus de la gare routière des Villards sur la place Aiguille des Glaciers, nous proposons de délicieux produits FRAIS."
    ],
    "es": [
      "Situado bajo el teleférico de Transarc y sobre la estación de autobuses de Villards, en la plaza Aiguille des Glaciers, ofrecemos deliciosos productos FRESCOS."
    ],
    "nl": [
      "Gelegen onder de Transarc kabelbaan en boven het Villards busstation op het Aiguille des Glaciers plein, bieden wij heerlijke FRESH producten."
    ]
  },
