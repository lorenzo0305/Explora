  "rdfs:comment": {
    "de": [
      "Schreibwettbewerb, der vom Département de la Drôme im Rahmen des Sevigne-Jahres 2026 organisiert wird. Die Teilnehmer werden aufgefordert, einen Brief an einen Verwandten zu verfassen, der von einer Fotografie aus dem Archiv des Departements inspiriert ist. Schreibzimmer in der Mediathek."
    ],
    "en": [
      "Writing competition organized by the Département de la Drôme as part of 2026, Année Sévigné. Participants are invited to write a letter to a loved one, inspired by a photograph in the Archives départementales. Writing room at the mediatheque."
    ],
    "it": [
      "Concorso di scrittura organizzato dal Dipartimento della Drôme nell'ambito di 2026, Année Sévigné. I partecipanti sono invitati a scrivere una lettera a una persona cara, ispirandosi a una fotografia presente negli archivi del Dipartimento. Sala di scrittura presso la mediateca."
    ],
    "fr": [
      "Concours d'écriture organisé par le Département de la Drôme ds le cadre de 2026, Année Sévigné. Les participants sont invités à rédiger une lettre à un proche, inspirée d’une photographie des Archives départementales. Chambre d'écriture à la médiathèque."
    ],
    "nl": [
      "Schrijfwedstrijd georganiseerd door het Département de la Drôme in het kader van 2026, Année Sévigné. Deelnemers worden uitgenodigd een brief te schrijven aan een dierbare, geïnspireerd op een foto in het departementale archief. Schrijfzaal in de mediatheek."
    ],
    "es": [
      "Concurso de escritura organizado por el Département de la Drôme en el marco de 2026, Année Sévigné. Se invita a los participantes a escribir una carta a un ser querido, inspirándose en una fotografía de los Archivos Departamentales. Sala de redacción de la mediateca."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Correspondances animées : un concours d’écriture où vos mots prennent vie"
    ]
  },
