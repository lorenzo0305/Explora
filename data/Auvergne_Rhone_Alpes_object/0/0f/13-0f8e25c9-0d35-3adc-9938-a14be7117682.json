  "rdfs:comment": {
    "de": [
      "Vom Plateau von Saint-Agrève über die Boutières, Le Cheylard und das Land der Kastanienbäume empfängt Sie das Fremdenverkehrsamt Ardèche Hautes Vallées das ganze Jahr über in seinen vier Informationsbüros."
    ],
    "en": [
      "From the plateau of Saint-Agrève, passing by Les Boutières, Le Cheylard and the Pays des Châtaigniers, the Tourist Office Ardèche Hautes Vallées welcomes you all year round in its 4 information offices."
    ],
    "it": [
      "Dall'altopiano di Saint-Agrève, attraverso le Boutières, Le Cheylard e il Pays des Châtaigniers, l'Ufficio del Turismo dell'Ardèche Hautes Vallées vi accoglie tutto l'anno nei suoi 4 uffici informazioni."
    ],
    "fr": [
      "Du plateau de Saint-Agrève, en passant par les Boutières, Le Cheylard et le Pays des Châtaigniers, l'Office de Tourisme Ardèche Hautes Vallées vous accueille toute l'année sur ses 4 bureaux d'informations."
    ],
    "nl": [
      "Vanaf het plateau van Saint-Agrève, via de Boutières, Le Cheylard en het Pays des Châtaigniers, verwelkomt het Office du Tourisme des Hautes Vallées Ardèche je het hele jaar door in zijn 4 informatiekantoren."
    ],
    "es": [
      "Desde la meseta de Saint-Agrève, pasando por las Boutières, Le Cheylard y el Pays des Châtaigniers, la Oficina de Turismo de los Altos Valles de Ardèche le recibe todo el año en sus 4 oficinas de información."
    ]
  },
