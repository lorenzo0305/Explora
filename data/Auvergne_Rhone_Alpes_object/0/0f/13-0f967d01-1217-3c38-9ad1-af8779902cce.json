  "rdfs:comment": {
    "de": [
      "Das Atelier de Parfumerie naturelle ist eine Organisation, die sich mit der Popularisierung und Ausbildung von Parfums befasst. Seine Spezialität ist die 100% natürliche Parfümerie. Ein kulturelles Angebot an Animationen, Entdeckungs- und Fortgeschrittenen-Workshops und Praktika."
    ],
    "en": [
      "The natural perfume workshop is an organization dedicated to education and training in perfumery. Its specialty is 100% natural perfumery. It offers a cultural program including events, introductory and advanced workshops, and training courses."
    ],
    "it": [
      "L'Atelier de Parfumerie naturelle è un'organizzazione che si occupa della divulgazione e della formazione in profumeria. La sua specialità è la profumeria 100% naturale. Un'offerta culturale di eventi, laboratori di scoperta e di perfezionamento e corsi."
    ],
    "fr": [
      "L'Atelier de Parfumerie naturelle est un organisme de vulgarisation et de formation sur le parfum. Sa spécialité est la parfumerie 100% naturelle. Une offre culturelle d'animations, d'ateliers découverte et perfectionnement, et de stages."
    ],
    "nl": [
      "L'Atelier de Parfumerie naturelle is een organisatie die parfum populair maakt en opleidingen verzorgt. Haar specialiteit is 100% natuurlijke parfumerie. Een cultureel aanbod van evenementen, ontdekkings- en gevorderde workshops en cursussen."
    ],
    "es": [
      "L'Atelier de Parfumerie naturelle es una organización de divulgación y formación en perfumería. Su especialidad es la perfumería 100% natural. Una oferta cultural de eventos, talleres de descubrimiento y perfeccionamiento, y cursos."
    ]
  },
  "rdfs:label": {
    "en": [
