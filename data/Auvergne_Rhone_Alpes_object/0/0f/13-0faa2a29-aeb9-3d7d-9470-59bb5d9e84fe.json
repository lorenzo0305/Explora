  "rdfs:comment": {
    "de": [
      "Unterhalb des Bataillières-Sees und in der Nähe der Hautes-Alpes enthält der Curtalès-See Bach- und Regenbogenforellen, die Angler, die die Ruhe und Reinheit der Berge suchen, glücklich machen werden."
    ],
    "en": [
      "Below the Bataillières lake and close to the Hautes-Alpes, the Curtalès lake contains fario and rainbow trouts, which will make the happiness of the fishermen looking for the calm and the purity of the mountain."
    ],
    "it": [
      "Sotto il lago di Bataillières e vicino alle Hautes-Alpes, il lago di Curtalès ospita trote fario e iridee, che faranno la gioia dei pescatori alla ricerca della calma e della purezza delle montagne."
    ],
    "fr": [
      "En dessous du lac des Bataillières et près des Hautes-Alpes, le lac Curtalès contient truites fario et arc-en-ciel, qui feront le bonheur des pêcheurs cherchant le calme et la pureté de la montagne."
    ],
    "es": [
      "Por debajo del lago de Bataillières y cerca de los Hautes-Alpes, el lago de Curtalès contiene truchas fario y arco iris, que harán las delicias de los pescadores que buscan la calma y la pureza de la montaña."
    ],
    "nl": [
      "Onder het meer van Bataillières en nabij de Hautes-Alpes, bevat het meer van Curtalès fario en regenboogforel, die de vissers op zoek naar de rust en de zuiverheid van de bergen zullen plezieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le lac Curtalès"
    ]
  },
