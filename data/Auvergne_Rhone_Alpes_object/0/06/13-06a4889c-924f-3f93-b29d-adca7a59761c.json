  "rdfs:comment": {
    "de": [
      "MGM Sports Skiverleih/-verkauf im Zentrum des Skigebiets mit Abfahrt und Rückfahrt auf Skiern, Einzigartig!\r\nWir befinden uns an der Mittelstation des \"Télécentre\" im Zentrum des Skiortes und ermöglichen Ihnen so einen einfachen Zugang zu den Skipisten."
    ],
    "en": [
      "MGM Sports ski rental/sales store in resort center with ski departure and return, Unique!\r\nWe're located at the \"Télécentre\" mid-station in the resort center, giving you easy access to the ski slopes."
    ],
    "it": [
      "MGM Sports noleggio/vendita di sci nel centro della stazione con partenza e ritorno degli sci, unico!\r\nSiamo situati presso la stazione intermedia \"Télécentre\", nel centro della località, e vi consentiamo di accedere facilmente alle piste da sci."
    ],
    "fr": [
      "MGM Sports magasin de location/vente de ski en centre station avec départ et retour à ski, Unique !\r\nNous nous situons à la gare intermédiaire du \"Télécentre\" en centre station, vous permettant un accès facile aux pistes de ski."
    ],
    "es": [
      "Tienda de alquiler/venta de esquís MGM Sports en el centro de la estación con salida y regreso de esquís, ¡Único!\r\nEstamos situados en la estación intermedia \"Télécentre\", en el centro de la estación, lo que le permite acceder fácilmente a las pistas de esquí."
    ],
    "nl": [
      "MGM Sports skiverhuur/verkoop winkel in het centrum met vertrek en terugkomst van ski's, uniek!\r\nWij bevinden ons bij het tussenstation \"Télécentre\" in het centrum van het skioord, waardoor je gemakkelijk toegang hebt tot de skipistes."
    ]
  },
