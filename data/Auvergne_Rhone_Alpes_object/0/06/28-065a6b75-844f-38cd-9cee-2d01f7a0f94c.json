  "rdfs:comment": {
    "de": [
      "Der Chefkoch M. Lernould bietet Ihnen im Café-Restaurant \"Au Bon Accueil\" eine traditionelle Küche zu erschwinglichen Preisen. Das \"Bon Accueil\" ist auch ein Catering-Unternehmen und bietet Ihnen die Möglichkeit, Bankette und Empfänge zu organisieren."
    ],
    "en": [
      "Mr. Lernould, the Chef, offers you at the Café-Restaurant \" Au Bon Accueil \", traditional cuisine at affordable prices. Also a caterer, the \" Bon Accueil \" offers you the possibility to organize banquets and receptions."
    ],
    "it": [
      "Il signor Lernould, lo chef, vi offre una cucina tradizionale a prezzi accessibili presso il Café-Ristorante \"Au Bon Accueil\". Anche catering, il \"Bon Accueil\" vi offre la possibilità di organizzare banchetti e ricevimenti."
    ],
    "fr": [
      "M. Lernould, le Chef, vous propose au Café-Restaurant « Au Bon Accueil », une cuisine traditionnelle à des prix abordables. Également Traiteur, le « Bon Accueil » vous offre la possibilité d’organiser banquets et réceptions."
    ],
    "es": [
      "El Sr. Lernould, el Chef, le ofrece cocina tradicional a precios asequibles en el Café-Restaurante \"Au Bon Accueil\". El \"Bon Accueil\" también ofrece la posibilidad de organizar banquetes y recepciones."
    ],
    "nl": [
      "De heer Lernould, de chef-kok, biedt u een traditionele keuken tegen betaalbare prijzen in het Café-Restaurant \"Au Bon Accueil\". Als traiteur biedt \"Bon Accueil\" u de mogelijkheid om banketten en recepties te organiseren."
    ]
  },
