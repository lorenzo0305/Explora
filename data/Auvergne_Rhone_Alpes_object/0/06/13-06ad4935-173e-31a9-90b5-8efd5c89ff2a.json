  "rdfs:comment": {
    "de": [
      "Willkommen bei Sallanches Tourisme! Informationen, Kartenvorverkauf, Souvenirs und Führungen: Unser Team begleitet Sie, damit Sie ihre sehr schöne Stadt im Pays du Mont-Blanc und ihre Schätze voll und ganz genießen können."
    ],
    "en": [
      "Welcome to Sallanches Tourism! Information, ticketing, souvenirs, and guided tours: our team is here to help you fully enjoy this beautiful town in the Mont-Blanc region and its treasures."
    ],
    "it": [
      "Benvenuti a Sallanches Turismo! Informazioni, biglietteria, souvenir e visite guidate: il nostro team vi accompagna per farvi godere appieno di questa splendida città nel territorio del Monte Bianco e dei suoi tesori."
    ],
    "fr": [
      "Bienvenue à Sallanches Tourisme ! Informations, billetteries, souvenirs et visites guidées : notre équipe vous accompagne pour profiter pleinement de sa très belle ville au Pays du Mont-Blanc et de ses trésors."
    ],
    "es": [
      "¡Bienvenido a Sallanches Tourisme! Información, venta de entradas, recuerdos y visitas guiadas: nuestro equipo le ayudará a disfrutar al máximo de esta hermosa ciudad de la región del Mont Blanc y de sus tesoros."
    ],
    "nl": [
      "Welkom bij Sallanches Tourisme! Informatie, kaartverkoop, souvenirs en rondleidingen: ons team helpt je om optimaal te genieten van dit prachtige stadje in de Mont Blanc en zijn schatten."
    ]
  },
