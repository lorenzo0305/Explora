  "rdfs:comment": {
    "de": [
      "Das Team von La Grolle empfängt Sie zu sympathischen und geselligen Abenden in zwei verschiedenen Umgebungen: in der Bar-Pub mit Musik, Cocktails und Bier und im Restaurant in einem anderen Raum mit warmem und geselligem savoyischen Dekor."
    ],
    "en": [
      "The team of La Grolle welcomes you for nice and friendly evenings with two atmospheres; the bar-pub music, cocktails, beers... and the restaurant in another room with a warm and friendly Savoyard decor."
    ],
    "it": [
      "Il team de La Grolle vi accoglie per serate divertenti e conviviali in due ambienti: il bar-pub con musica, cocktail e birre e il ristorante in un'altra sala con un arredamento savoiardo caldo e accogliente."
    ],
    "fr": [
      "L'équipe de La Grolle vous accueille pour des soirées sympas et conviviales avec deux ambiances; le bar-pub musique, cocktails, bières… et le restaurant dans une autre salle au décor savoyard chaleureux et convivial."
    ],
    "nl": [
      "Het team van La Grolle verwelkomt u voor leuke en vriendelijke avonden met twee sferen; de bar-pub muziek, cocktails, bier... en het restaurant in een andere kamer met een warme en vriendelijke Savoyaardse inrichting."
    ],
    "es": [
      "El equipo de La Grolle le acoge para veladas divertidas y acogedoras en dos ambientes: el bar-pub con música, cócteles y cervezas... y el restaurante en otra sala con una decoración saboyana cálida y acogedora."
    ]
  },
