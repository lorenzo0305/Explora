  "rdfs:comment": {
    "de": [
      "Naturmaler mit einer großen Beobachtungsgabe für die Natur und den Menschen.\r\nBildhauer auf Holz. Er erschafft keine Schönheit, sondern entdeckt sie."
    ],
    "en": [
      "Nature painter with a keen sense of observation of nature and people.\r\nWoodcarver. He doesn't create beauty, he discovers it."
    ],
    "it": [
      "Pittore naturalista con uno spiccato senso di osservazione della natura e delle persone.\r\nScultore del legno. Non crea la bellezza, la scopre."
    ],
    "fr": [
      "Peintre de la nature avec un grand sens de l’observation de la nature et de l’humain.\r\nSculpteur sur bois. Il ne crée pas la beauté, il la découvre."
    ],
    "es": [
      "Pintor de naturaleza con un agudo sentido de la observación de la naturaleza y las personas.\r\nEscultor de madera. No crea la belleza, la descubre."
    ],
    "nl": [
      "Natuurschilder met een scherp gevoel voor observatie van natuur en mensen.\r\nHoutsnijder. Hij creëert geen schoonheid, hij ontdekt het."
    ]
  },
  "rdfs:label": {
