  "rdfs:comment": {
    "de": [
      "Auf dem Gelände des Aven d'Orgnac, nur wenige Schritte vom Ausgang der Höhle entfernt, erzählt die Cité de la Préhistoire von 350 000 Jahren menschlicher Abenteuer anhand von Sammlungen, die lokale Überreste der menschlichen Besiedlung zeigen. Besuchen Sie sie vor oder nach dem Besuch der Aven d'Orgnac!"
    ],
    "en": [
      "On the Grand Site de l'Aven d'Orgnac, just a stone's throw from the Grotto exit, the Cité de la Préhistoire evokes 350,000 years of human adventure through collections of local remains of human occupation. Visit before or after the Aven d'Orgnac!"
    ],
    "it": [
      "Sul Grand Site de l'Aven d'Orgnac, a pochi passi dall'uscita della Grotta, la Cité de la Préhistoire rievoca 350.000 anni di avventure umane attraverso collezioni di resti locali di occupazione umana. Da visitare prima o dopo l'Aven d'Orgnac!"
    ],
    "fr": [
      "Sur le Grand Site de l'Aven d'Orgnac, à quelques pas de la sortie de la Grotte, la Cité de la Préhistoire évoque 350 000 ans d'aventures humaines au travers de collections, vestiges locaux de l’occupation humaine. A visiter avant ou après l'aven d'Orgnac!"
    ],
    "nl": [
      "Op de Grand Site Aven d'Orgnac roept de Cité de la Préhistoire (Prehistorisch Centrum) - een moderne, ludieke museografische ruimte met erkenning van het Musée de France - 350.000 jaar menselijke avonturen op door middel van authentieke collecties van plaatselijke overblijfselen van menselijke bewoning."
    ],
    "es": [
      "En el Grand Site de l'Aven d'Orgnac, a dos pasos de la salida de la Gruta, la Cité de la Préhistoire evoca 350.000 años de aventuras humanas a través de colecciones de restos locales de ocupación humana. Visítela antes o después del Aven d'Orgnac."
    ]
  },
  "rdfs:label": {
    "de": [
      "Aven d'Orgnac - Grand Site de France - La Cité de la Préhistoire (Stadt der Vorgeschichte)"
    ],
    "ru": [
      "Авен д'Оргнак - Великий объект Франции - город доисторического периода"
    ],
    "en": [
      "Aven d'Orgnac - Grand Site de France - The City of Prehistory"
    ],
    "it": [
      "Aven d'Orgnac - Grand Site de France - La città della preistoria"
    ],
    "fr": [
      "Aven d'Orgnac - Grand Site de France - La Cité de la Préhistoire"
    ],
    "zh": [
      "阿文德奥格纳克--法国大遗址--史前之城"
    ],
    "es": [
      "Aven d'Orgnac - Grand Site de France - La Ciudad de la Prehistoria"
    ],
    "nl": [
      "Aven d'Orgnac - Grand Site de France - De stad van de prehistorie"
