  "rdfs:comment": {
    "de": [
      "Lust auf ein bisschen Exotik? Verwöhnen Sie sich mit vietnamesischen, chinesischen und thailändischen Spezialitäten. Dieses Familienrestaurant empfängt Sie in einer herzlichen Atmosphäre und kitzelt Ihren Gaumen mit diesen fein gewürzten Gerichten."
    ],
    "en": [
      "Looking for a bit of the exotic? Treat yourself to Vietnamese, Chinese and Thai specialties. This family-run restaurant welcomes you in a warm atmosphere and will tickle your taste buds with its delicately spiced dishes."
    ],
    "it": [
      "Cercate un po' di esotico? Concedetevi le specialità vietnamite, cinesi e thailandesi. Questo ristorante a conduzione familiare vi accoglierà in una calda atmosfera e stuzzicherà il vostro palato con i suoi piatti delicatamente speziati."
    ],
    "fr": [
      "Envie d'un peu d'exotisme ? Régalez-vous avec des spécialités vietnamiennes, chinoises et thaïlandaises. Ce restaurant familial vous accueille dans une ambiance chaleureuse et titillera vos papilles par ces mets délicatement épicés."
    ],
    "es": [
      "¿Busca algo exótico? Deléitese con especialidades vietnamitas, chinas y tailandesas. Este restaurante familiar le da la bienvenida en un ambiente cálido y le deleitará el paladar con sus platos delicadamente condimentados."
    ],
    "nl": [
      "Op zoek naar een beetje exotisch? Trakteer jezelf op Vietnamese, Chinese en Thaise specialiteiten. Dit familierestaurant verwelkomt je in een warme sfeer en zal je smaakpapillen prikkelen met zijn delicaat gekruide gerechten."
    ]
  },
