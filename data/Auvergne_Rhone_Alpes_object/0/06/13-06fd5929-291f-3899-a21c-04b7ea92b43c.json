  "rdfs:comment": {
    "de": [
      "Coeur de Gaïa lädt Sie ein, ihr Universum zu entdecken, das von der Natur und der Welt des Wohlbefindens inspiriert ist. Sie stellt handgefertigte Töpferwaren und Trommeln aus Leinen her. Ihre Stücke werden in ihrem Atelier in Brangues von Hand gefertigt."
    ],
    "en": [
      "Coeur de Gaïa invites you to discover her world, inspired by nature and the world of well-being. She makes handmade pottery and canvas drums. Her pieces are handmade in her workshop in Brangues."
    ],
    "it": [
      "Coeur de Gaïa vi invita a scoprire il suo mondo, ispirato alla natura e al mondo del benessere. Realizza ceramiche fatte a mano e tamburi in tela. I suoi pezzi sono realizzati a mano nel suo laboratorio di Brangues."
    ],
    "fr": [
      "Coeur de Gaïa vous invite à découvrir son univers inspiré de la nature et du monde du bien-être. Elle réalise des poteries artisanales et des tambours en toile. Ses pièces sont fabriqués à la main dans son atelier à Brangues."
    ],
    "nl": [
      "Coeur de Gaïa nodigt je uit om haar wereld te ontdekken, geïnspireerd door de natuur en de wereld van welzijn. Ze maakt handgemaakt aardewerk en canvas trommels. Haar stukken worden met de hand gemaakt in haar atelier in Brangues."
    ],
    "es": [
      "Coeur de Gaïa le invita a descubrir su universo, inspirado en la naturaleza y el mundo del bienestar. Hace cerámica artesanal y tambores de lona. Sus piezas están hechas a mano en su taller de Brangues."
    ]
  },
