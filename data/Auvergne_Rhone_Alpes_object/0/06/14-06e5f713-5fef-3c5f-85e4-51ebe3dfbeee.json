  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c2bf7ff6-d9df-3cd4-87af-153165a49e86",
      "dc:description": {
        "de": [
          "Willkommen bei K'Raboss, Ihrer Modeboutique, die allen Frauen gewidmet ist, die auf der Suche nach Stil und Eleganz sind.\nSie befindet sich in 6, rue Carnot, Berck.\nTrendteile für jede Jahreszeit.\nItalienische Kleidung."
        ],
        "en": [
          "Welcome to K'Raboss, your fashion boutique dedicated to all women in search of style and elegance.\nLocated at 6, rue Carnot, Berck.\nTrendy pieces for every season.\nItalian clothing."
        ],
        "it": [
          "Benvenuti da K'Raboss, la boutique di moda per le donne che cercano stile ed eleganza.\nSi trova al 6 di rue Carnot, a Berck.\nPezzi di tendenza per ogni stagione.\nAbbigliamento italiano."
        ],
        "fr": [
          "Bienvenue chez K'Raboss, votre boutique de mode dédiée à toutes les femmes en quête de style et d'élégance.\nSituée au 6, rue Carnot, Berck.\nPièces tendances pour chaque saison.\nVétements Italien."
        ],
        "nl": [
          "Welkom bij K'Raboss, uw modeboetiek voor vrouwen die op zoek zijn naar stijl en elegantie.\nGevestigd op 6, rue Carnot, Berck.\nTrendy stukken voor elk seizoen.\nItaliaanse kleding."
        ],
        "es": [
          "Bienvenido a K'Raboss, su tienda de moda para mujeres que buscan estilo y elegancia.\nSituada en 6, rue Carnot, Berck.\nPiezas de moda para cada temporada.\nRopa italiana."
        ]
      },
