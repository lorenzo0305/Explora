  "rdfs:comment": {
    "de": [
      "Châtel Fun Bike ist ein speziell entwickeltes BMX-Rad mit großen Reifen für alpine Pfade, kombiniert mit Laser-Biathlon-Schießen.\r\nSind Sie bereit für neue Sensationen?"
    ],
    "en": [
      "Châtel Fun Bike is an activity combining a BMX designed for mountain trails and laser shooting.\r\nAre you up for a new challenge?"
    ],
    "it": [
      "Châtel Fun Bike è una BMX appositamente progettata con grandi pneumatici per i percorsi alpini, abbinata al tiro laser del Biathlon.\r\nSiete pronti per nuove sensazioni?"
    ],
    "fr": [
      "Châtel Fun Bike c’est un BMX spécialement conçu avec de gros pneus pour les sentiers alpins, combiné au tir Biathlon laser.\r\nEtes-vous prêts pour de nouvelles sensations ?"
    ],
    "nl": [
      "Châtel Fun Bike is een BMX speciaal ontworpen voor onze bergparcours, gecombineerd met Biatlon laserschieten.\r\nBent u klaar voor nieuwe sensaties ?"
    ],
    "es": [
      "Châtel Fun Bike es una bicicleta BMX especialmente diseñada con grandes neumáticos para pistas alpinas, combinada con tiro láser de biatlón.\r\n¿Estás preparado para nuevas sensaciones?"
    ]
  },
