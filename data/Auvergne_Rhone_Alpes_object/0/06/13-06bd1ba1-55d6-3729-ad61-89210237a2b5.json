  "rdfs:comment": {
    "de": [
      "Das Semnoz und sein Restaurant Le Saint-Hubert stehen für die Geschichte einer Familie, die eng mit Savoyen verbunden ist. Jean-Philippe lädt Sie ein, sein Hotel kennen zu lernen."
    ],
    "en": [
      "Le Semnoz and its Saint-Hubert restaurant are the embodiment of a Savoie family and its soul. Jean-Philippe would love to welcome you to his hotel."
    ],
    "it": [
      "Le Semnoz e il suo ristorante Saint-Hubert, è la storia di una famiglia savoiarda nell'animo. Jean-Philippe vi invita a scoprire il suo stabilimento."
    ],
    "fr": [
      "Le Semnoz et son restaurant le Saint-Hubert, c'est l'histoire d'une famille savoyarde dans l'âme. Jean-Philippe vous invite à découvrir son établissement."
    ],
    "es": [
      "El Semnoz y su restaurante, el Saint-Hubert, son la historia de una familia saboyana de corazón. Jean-Philippe le invita a descubrir su establecimiento."
    ],
    "nl": [
      "De Semnoz en zijn restaurant le Saint-Hubert, is de geschiedenis van een familie bij wie de Savoie door de aderen stroomt. Jean-Philippe nodigt u uit voor een kennismaking."
    ]
  },
