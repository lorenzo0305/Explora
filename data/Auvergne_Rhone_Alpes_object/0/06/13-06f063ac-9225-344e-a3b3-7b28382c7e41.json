  "rdfs:comment": {
    "de": [
      "Im Rahmen von Danse au Fil d'Avril\r\nOusmane Sy\r\nMit Queen Blood setzt Ousmane Sy seine ästhetische Suche fort, die sowohl vom Corps de Ballet als auch vom Freestyle-Geist des Hip Hop beeinflusst ist."
    ],
    "en": [
      "As part of Danse au Fil d'Avril\r\nOusmane Sy\r\nWith Queen Blood, Ousmane Sy pursues an aesthetic research influenced as much by corps de ballet as by the freestyle spirit of hip hop."
    ],
    "it": [
      "Nell'ambito della Danse au Fil d'Avril\r\nOusmane Sy\r\nCon Queen Blood, Ousmane Sy persegue una ricerca estetica influenzata tanto dal corpo di ballo quanto dallo spirito freestyle dell'hip hop."
    ],
    "fr": [
      "Dans le cadre de Danse au Fil d'Avril\r\nOusmane Sy\r\nAvec Queen Blood, Ousmane Sy poursuit une recherche esthétique influencée autant par le corps de ballet, que l’esprit freestyle du hip hop."
    ],
    "nl": [
      "In het kader van Danse au Fil d'Avril\r\nOusmane Sy\r\nMet Queen Blood streeft Ousmane Sy een esthetisch onderzoek na dat zowel beïnvloed is door het corps de ballet als door de freestyle geest van hiphop."
    ],
    "es": [
      "En el marco de Danse au Fil d'Avril\r\nOusmane Sy\r\nCon Queen Blood, Ousmane Sy persigue una búsqueda estética influida tanto por el cuerpo de ballet como por el espíritu freestyle del hip hop."
    ]
  },
