  "rdfs:comment": {
    "de": [
      "Das L'Estaminet Lillois liegt im Herzen der Altstadt von Lille. Hier können Sie die Spezialitäten des Nordens entdecken, indem Sie hausgemachte regionale Gerichte aus frischen und saisonalen Produkten sowie eine große Auswahl an handwerklich gebrauten Bieren aus der Region genießen. Sein traditionelles Ambiente wird Sie durch die Geschichte der Region führen."
    ],
    "en": [
      "Located in the heart of Vieux-Lille, L'Estaminet Lillois introduces you to the specialties of the Nord region, with home-cooked regional cuisine based on fresh, seasonal produce, and a wide choice of local craft beers. Its traditional setting will take you through the history of the region."
    ],
    "it": [
      "Situato nel cuore della vecchia Lilla, L'Estaminet Lillois vi invita a scoprire le specialità del nord della Francia, con una cucina regionale fatta in casa a base di prodotti freschi di stagione e un'ampia scelta di birre artigianali locali. Il suo ambiente tradizionale vi farà ripercorrere la storia della regione."
    ],
    "fr": [
      "Situé au cœur du Vieux-Lille, L'Estaminet Lillois vous fait découvrir les spécialités du Nord à travers une cuisine régionale faite maison à base de produits frais et de saison, ainsi qu'un large choix de bières artisanales de la région. Son cadre traditionnel vous feront traverser l'histoire de la région."
    ],
    "es": [
      "Situado en el corazón del casco antiguo de Lille, L'Estaminet Lillois le invita a descubrir las especialidades del norte de Francia, con una cocina regional casera basada en productos frescos de temporada y una amplia selección de cervezas artesanales locales. Su ambiente tradicional le hará viajar a través de la historia de la región."
    ],
    "nl": [
      "L'Estaminet Lillois ligt in het hart van het oude Lille en nodigt u uit om de specialiteiten van Noord-Frankrijk te ontdekken, met huisgemaakte regionale gerechten op basis van verse seizoensproducten en een ruime keuze aan lokale ambachtelijke bieren. Het traditionele kader neemt je mee door de geschiedenis van de streek."
    ]
  },
