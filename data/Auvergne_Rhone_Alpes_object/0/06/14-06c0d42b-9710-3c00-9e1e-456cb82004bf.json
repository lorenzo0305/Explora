  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3e80e5d9-9c8a-3f08-bee2-2107e213d174",
      "dc:description": {
        "de": [
          "- Ohne Reservierungen\n- Konzerte, Veranstaltungen\n- Weltmeisterschaft auf Großleinwand\n- Bar\n- Hausgemachte Küche\n- Lokale Produkte\n\nNachhaltiger Ansatz: Anti-Verschwendung, kurze Wege, lokale Produkte, ökologisch verantwortungsbewusster Ort (wiederverwertete Materialien, Trockentoiletten), ökologische Reinigungsprodukte"
        ],
        "en": [
          "- Without reservation\n- Concerts, events\n- World Cup on giant screen\n- Bar\n- Home cooking\n- Local products\n\nSustainable approach: anti-gasppi, short circuit, local products, eco-responsible venue (recycled materials, dry toilets), ecological cleaning products"
        ],
        "it": [
          "- Senza prenotazione\n- Concerti, eventi\n- Coppa del Mondo su schermo gigante\n- Bar\n- Cucina casalinga\n- Prodotti locali\n\nApproccio sostenibile: anti-gasppi, cortocircuito, prodotti locali, sede eco-responsabile (materiali riciclati, servizi igienici a secco), prodotti di pulizia ecologici"
        ],
        "fr": [
          "- Sans réservations \n- Concerts, événements \n- Coupe du monde sur écran géant \n- Bar \n- Cuisine maison \n- Produits locaux\n\nDémarche durable : anti gaspi, circuit court, produits locaux, lieu eco responsable (matériaux de récupération, toilettes sèches), produits d'entretien écologiques"
        ],
        "nl": [
          "- Zonder reservering\n- Concerten, evenementen\n- Wereldbeker op reuzenscherm\n- Bar\n- Thuis koken\n- Lokale producten\n\nDuurzame aanpak: antigasppi, kortsluiting, lokale producten, ecologisch verantwoorde locatie (gerecycleerde materialen, droge toiletten), ecologische schoonmaakproducten"
        ],
        "es": [
          "- Sin reserva\n- Conciertos, eventos\n- Copa del Mundo en pantalla gigante\n- Bar\n- Cocina casera\n- Productos locales\n\nEnfoque sostenible: antigasppi, cortocircuito, productos locales, lugar de celebración ecorresponsable (materiales reciclados, aseos secos), productos de limpieza ecológicos"
        ]
      },
