  "rdfs:comment": {
    "de": [
      "Als Treffpunkt für Künstler und Feinschmecker ist Corso die erste Social Bar&Food in Amiens. Hier gibt es italienische Küche.\nTäglich mittags und abends geöffnet."
    ],
    "en": [
      "A meeting place for artists and gourmets, Corso is the first Social Bar&Food in Amiens. Italian cuisine.\nOpen every day for lunch and dinner."
    ],
    "it": [
      "Luogo di incontro per artisti e buongustai, Corso è il primo Social Bar&Food di Amiens. Cucina italiana.\nAperto tutti i giorni a pranzo e a cena."
    ],
    "fr": [
      "Rendez vous des artistes et des gourmands, Corso est le premier Social Bar&Food à Amiens. Cuisine italienne.\nOuvert tous les jours midis et soirs."
    ],
    "es": [
      "Lugar de encuentro de artistas y gastrónomos, Corso es el primer Social Bar&Food de Amiens. Cocina italiana.\nAbierto todos los días para el almuerzo y la cena."
    ],
    "nl": [
      "Als ontmoetingsplaats voor kunstenaars en fijnproevers is Corso de eerste Social Bar&Food in Amiens. Italiaanse keuken.\nDagelijks geopend voor lunch en diner."
    ]
