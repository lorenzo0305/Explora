  "rdfs:comment": {
    "de": [
      "5 Designerinnen laden Sie ein, ihren Raum zu entdecken, der dem Kunsthandwerk gewidmet ist. Geschenkideen von 5 bis 900 ?, Tischkultur, Kunsthandwerk, Schmuck, Dekoration, Textilien. Alle drei Monate enthüllen neue Gäste ihre verschiedenen Fertigkeiten."
    ],
    "en": [
      "5 designers invite you to discover their space dedicated to arts and crafts. Gift ideas from 5 to 900 ?, tableware, arts and crafts, jewelry, decoration, textiles. Every three months, new guests unveil their different skills."
    ],
    "it": [
      "5 designer vi invitano a scoprire il loro spazio dedicato all'artigianato. Idee regalo da 5 a 900?, articoli per la tavola, artigianato artistico, gioielli, decorazioni e tessuti. Ogni tre mesi, nuovi ospiti svelano le loro diverse abilità."
    ],
    "fr": [
      "5 créatrices vous invitent à découvrir leur espace dédié aux métiers d'art. Idées cadeaux de 5 à 900 €, arts de la table, métiers d'art, bijoux, décoration, textile. Tous les trois mois, de nouveaux invités dévoilent leurs différents savoir-faire."
    ],
    "nl": [
      "5 ontwerpers nodigen je uit om hun ruimte gewijd aan kunst en ambacht te ontdekken. Cadeau-ideeën van 5 tot 900?, servies, kunstnijverheid, sieraden, decoratie en textiel. Elke drie maanden onthullen nieuwe gasten hun verschillende vaardigheden."
    ],
    "es": [
      "5 diseñadores le invitan a descubrir su espacio dedicado a la artesanía. Ideas para regalos de 5 a 900?, vajillas, artesanía, joyería, decoración y textil. Cada tres meses, nuevos invitados desvelan sus diferentes habilidades."
    ]
  },
