  "rdfs:comment": {
    "de": [
      "Der Weinberg Vernusses, der früher unter dem Namen Terres de ROA bekannt war, ist seit über 15 Jahren Vorreiter in der Appellation für Praktiken des biologischen und biodynamischen Landbaus."
    ],
    "en": [
      "The Vernusses vineyard, formerly known as Terres de ROA, has been pioneering organic and biodynamic farming practices in the appellation for over 15 years."
    ],
    "it": [
      "Il vigneto Vernusses, precedentemente noto come Terres de ROA, è stato pioniere delle pratiche agricole biologiche e biodinamiche nella denominazione per oltre 15 anni."
    ],
    "fr": [
      "Le vignoble des Vernusses anciennement connu sous le nom de Terres de ROA est précurseur sur l'appellation de pratiques de l'agriculture biologique et bio-dynamique depuis plus de 15 ans."
    ],
    "nl": [
      "Het enige gecertificeerde biologische familiebedrijf in biodynamische visie van alle wijngaarden in Saint-Pourçain."
    ],
    "es": [
      "El viñedo de Vernusses, antes conocido como Terres de ROA, es pionero en prácticas de agricultura ecológica y biodinámica en la denominación desde hace más de 15 años."
    ]
  },
