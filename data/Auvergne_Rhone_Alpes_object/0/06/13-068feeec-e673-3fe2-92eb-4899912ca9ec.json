  "rdfs:comment": {
    "de": [
      "Angelreservoir auf den Höhen von Riom-ès-Montagnes. Forelle Area Roussillou Lake erwartet Sie für die verrückteste Angelpartie des Jahres. Forellenangeln mit vollem No Kill."
    ],
    "en": [
      "Fishing reservoir on the heights of Riom-ès-Montagnes. Truite Area Roussillou Lake awaits you for the most insane fishing trip of the year. Full no-kill trout fishing."
    ],
    "it": [
      "Bacino di pesca sulle alture di Riom-ès-Montagnes. Il lago Truite Area Roussillou vi aspetta per la pesca più pazza dell'anno. Pesca alla trota completamente no kill."
    ],
    "fr": [
      "Réservoir de pêche sur les hauteurs de Riom-ès-Montagnes. Truite Area Roussillou Lake vous attend pour la partie de pêche la plus démentielle de l'année. Pêche de la truite en no kill intégral."
    ],
    "nl": [
      "Visreservoir op de hoogten van Riom-ès-Montagnes. Het meer van Truite Area Roussillou wacht op je voor de meest waanzinnige visserij van het jaar. Volledig no kill vissen op forel."
    ],
    "es": [
      "Embalse de pesca en las alturas de Riom-ès-Montagnes. El lago Truite Area Roussillou le espera para la pesca más alocada del año. Pesca de la trucha sin muerte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Réservoir de pêche - Truite Area - Lac de Roussillou"
    ]
  },
