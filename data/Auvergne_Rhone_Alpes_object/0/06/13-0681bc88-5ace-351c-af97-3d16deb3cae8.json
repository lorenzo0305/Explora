  "rdfs:comment": {
    "de": [
      "Frédérique Séret gründete das Unternehmen Yvonne & Alexis (Vornamen ihrer Großeltern mütterlicherseits) mit dem Ziel, mit Goldfaden bestickte Produkte zu entwerfen und zu vermarkten."
    ],
    "en": [
      "Frédérique Séret founded Yvonne & Alexis (the first names of her maternal grandparents) with the aim of creating and marketing products embroidered with gold thread."
    ],
    "it": [
      "Frédérique Séret ha fondato Yvonne & Alexis (i nomi di battesimo dei nonni materni) con l'obiettivo di creare e commercializzare prodotti ricamati con filo d'oro."
    ],
    "fr": [
      "Frédérique Séret a créé la société Yvonne & Alexis (prénoms de ses grands parents maternels) dans le but de créer et commercialiser des produits brodés au fil d'Or."
    ],
    "nl": [
      "Frédérique Séret richtte Yvonne & Alexis (de voornamen van haar grootouders van moederskant) op met als doel het creëren en op de markt brengen van producten geborduurd met gouddraad."
    ],
    "es": [
      "Frédérique Séret fundó Yvonne & Alexis (los nombres de pila de sus abuelos maternos) con el objetivo de crear y comercializar productos bordados con hilo de oro."
    ]
  },
