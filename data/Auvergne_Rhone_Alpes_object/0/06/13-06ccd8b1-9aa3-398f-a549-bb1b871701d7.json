  "rdfs:comment": {
    "de": [
      "Die Domaine Duculty liegt auf 300 m Höhe an den Hängen des Dorfes Charnas und erstreckt sich über 7 ha, die hauptsächlich mit roten und weißen AOP Saint-Joseph-Weinen bepflanzt sind."
    ],
    "en": [
      "Situated at an altitude of 300m on the slopes of the village of Charnas, Domaine Duculty extends over 7 hectares, mainly AOP Saint-Joseph red and white."
    ],
    "it": [
      "Situata a 300 metri di altitudine sulle pendici del villaggio di Charnas, la tenuta Duculty si estende su 7 ettari di colline prevalentemente AOP Saint-Joseph rosse e bianche."
    ],
    "fr": [
      "Situé à 300m d’altitude sur les coteaux du village de Charnas, le domaine Duculty s’étend sur 7 ha principalement des coteaux en AOP Saint-Joseph rouge et blanc."
    ],
    "es": [
      "Situada a 300 metros de altitud, en las laderas del pueblo de Charnas, la finca Duculty se extiende sobre 7 hectáreas de laderas, principalmente blancas y rojas, de la AOP Saint-Joseph."
    ],
    "nl": [
      "Het domein Duculty ligt op 300 meter hoogte op de hellingen van het dorp Charnas en strekt zich uit over 7 hectare voornamelijk rode en witte hellingen van de AOP Saint-Joseph."
    ]
  },
  "rdfs:label": {
