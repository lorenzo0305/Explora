  "rdfs:comment": {
    "de": [
      "Die blaue Patisserie von THE FRENCH ART DE VIVRE. ®\r\nDer Gourmettempel im Herzen von Die!"
    ],
    "en": [
      "La pâtisserie bleue by THE FRENCH ART DE VIVRE. ®\r\nThe temple of gourmet delights in the heart of Die!"
    ],
    "it": [
      "La pâtisserie bleue di THE FRENCH ART DE VIVRE. ®\r\nIl tempio delle delizie gastronomiche nel cuore di Die!\r\nPasticceria fine, viennoiseries al burro puro, cioccolatini, gastronomia, snack, sala da tè e terrazza soleggiata.\r\nDisponibili opzioni senza glutine."
    ],
    "fr": [
      "La pâtisserie bleue par THE FRENCH ART DE VIVRE. ®\r\nLe temple de la gourmandise au coeur de Die !\r\nPâtisseries fines, viennoiseries pur beurre, chocolats, épicerie fine, snacking, salon de thé et terrasse ensoleillée.\r\nOptions sans gluten disponibles."
    ],
    "nl": [
      "La pâtisserie bleue van DE FRANSE ART DE VIVRE. ®\r\nDe tempel van gastronomische lekkernijen in het hart van Die!"
    ],
    "es": [
      "La pâtisserie bleue por THE FRENCH ART DE VIVRE. ®\r\n¡El templo de las delicias gourmet en el corazón de Die!\r\nRepostería fina, viennoiseries de mantequilla pura, chocolates, delicatessen, meriendas, salón de té y terraza soleada.\r\nSin gluten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Pâtisserie Bleue"
    ]
  },
