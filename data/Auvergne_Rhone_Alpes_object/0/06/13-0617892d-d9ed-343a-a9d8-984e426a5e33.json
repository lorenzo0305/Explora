  "rdfs:comment": {
    "de": [
      "Diese Route im Herzen des Arvan-Tals ist eine Abfolge von Schotterpassagen, Panoramastraßen und wilden Straßen, die Sie bis zum Gipfel des Col de la Croix-de-Fer führen."
    ],
    "en": [
      "In the heart of the Arvan valley, this itinerary is a succession of gravel sections and wild, panoramic roads that will take you to the summit of the Col de la Croix-de-Fer."
    ],
    "it": [
      "Nel cuore della valle dell'Arvan, questo percorso è un susseguirsi di tratti sterrati e strade panoramiche e selvagge che vi porteranno in cima al Col de la Croix-de-Fer."
    ],
    "fr": [
      "Au plein cœur de la vallée de l'Arvan, cet itinéraire est une succession de passages gravel, de routes panoramiques et sauvages qui vous conduiront jusqu’au sommet du col de la Croix-de-Fer."
    ],
    "es": [
      "En pleno valle de Arvan, esta ruta es una sucesión de tramos de grava y carreteras salvajes y panorámicas que le llevarán hasta la cima del Col de la Croix-de-Fer."
    ],
    "nl": [
      "Deze route ligt in het hart van de Arvan-vallei en is een aaneenschakeling van grindpaden en wilde, panoramische wegen die je naar de top van de Col de la Croix-de-Fer brengen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to Col de la Croix de Fer"
    ],
    "fr": [
      "Montée au Col de la Croix de Fer"
    ]
  },
