  "rdfs:comment": {
    "de": [
      "Entdecken Sie Les Petits Crus Lyon im Herzen von Lyon, im Stadtteil Perrache. Die ideale Adresse für ein Gourmet-Dinner mit Freunden, Familie oder Kollegen in der gemütlichen Atmosphäre einer Weinbar. Erleben Sie eine einzigartige Wein- und Käseprobe in Lyon!"
    ],
    "en": [
      "Discover Les Petits Crus Lyon, in the heart of Lyon, in the Perrache district. The ideal place for a gourmet dinner with friends, family or colleagues in the friendly atmosphere of a wine bar. A unique wine and cheese tasting experience in Lyon!"
    ],
    "it": [
      "Scoprite Les Petits Crus Lyon, nel cuore di Lione, nel quartiere Perrache. L'indirizzo ideale per una cena gourmet con gli amici, la famiglia o i colleghi in un'atmosfera da wine bar. Un'esperienza unica di degustazione di vini e formaggi a Lione!"
    ],
    "fr": [
      "Découvrez Les Petits Crus Lyon, au cœur de Lyon, quartier Perrache. L’adresse idéale pour un dîner gourmand entre amis, en famille ou entre collègues dans une ambiance conviviale de bar à vin. Expérience unique de dégustation vins et fromages à Lyon !"
    ],
    "nl": [
      "Ontdek Les Petits Crus Lyon, in het hart van Lyon, in de wijk Perrache. Het ideale adres voor een gastronomisch diner met vrienden, familie of collega's in een gezellige wijnbarsfeer. Een unieke wijn- en kaasdegustatie in Lyon!"
    ],
    "es": [
      "Descubra Les Petits Crus Lyon, en el corazón de Lyon, en el barrio de Perrache. La dirección ideal para una cena gourmet con amigos, familia o colegas en un ambiente agradable de bar de vinos. Una experiencia única de degustación de vinos y quesos en Lyon"
    ]
  },
