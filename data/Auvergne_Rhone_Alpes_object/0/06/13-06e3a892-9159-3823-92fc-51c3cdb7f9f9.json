  "rdfs:comment": {
    "de": [
      "Seit 2022 bietet das Restaurant \" La Chênaie\"  ein geselliger Ort, der hiesigen Gastronomie wo gute Laune weilt. Unser Küchenteam bietet Ihnen eine zeitgenössische französische Küche an, die auf gute, frische, lokale Produkte spezialisiert ist. Im Winter bieten wir ein Truffel Menu an."
    ],
    "en": [
      "Discover a haven of peace and taste our fresh and local products developed by our chef. Truffle menu in season."
    ],
    "it": [
      "Il ristorante \"La Chênaie\" dell'Hôtel La Bastide de Grignan propone una cucina locale con prodotti di stagione.\r\nA seconda del tempo, c'è un'ampia terrazza all'ombra delle querce. In inverno proponiamo un menu a base di tartufi, una specialità locale"
    ],
    "fr": [
      "Le restaurant \"La Chênaie\" à l'Hôtel La Bastide de Grignan vous propose une cuisine de terroir avec des produits locaux et de saison.\r\nSelon météo, grande terrasse  à l'ombre des  chênes. l'hiver nous proposons un menu basé sur la Truffe, spécialité locale"
    ],
    "es": [
      "El restaurante \"La Chênaie\" del Hôtel La Bastide de Grignan sirve cocina local elaborada con productos de temporada.\r\nDependiendo del tiempo, dispone de una amplia terraza a la sombra de los robles. En invierno ofrecemos un menú a base de trufas, una especialidad local"
    ],
    "nl": [
      "Een traditionele en bistotachtige keuken op basis van markt- en streekproducten die u laat smullen. Geniet van de serene sfeer en het comfort van de locatie in Grignan, tussen Nyons, Pierrelatte en Montélimar."
    ]
  },
  "rdfs:label": {
