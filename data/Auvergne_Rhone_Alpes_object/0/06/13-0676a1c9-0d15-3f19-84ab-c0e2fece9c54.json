  "rdfs:comment": {
    "de": [
      "Façon Chocolat ist ein Atelier/Boutique für die handwerkliche Herstellung von biologischer, laktosefreier, veganer Schokolade, Shortbread und Sorbets. Cafés. Teesalon. Verkostung."
    ],
    "en": [
      "Dark, organic, hand-made chocolates without any dairy product, without lecithin. Façon Chocolat is committed to working with local producers. \r\nCafés. Tea house. Tasting."
    ],
    "it": [
      "Façon Chocolat è un laboratorio/negozio dove si producono a mano cioccolatini pregiati, frollini e sorbetti biologici, senza lattosio e vegani. Caffè. Sala da tè. Sessioni di degustazione."
    ],
    "fr": [
      "Façon Chocolat est un atelier/boutique de fabrication artisanale de chocolats fins, mais aussi sablés et sorbets bio, sans lactose, vegan. Cafés. Salon de thé. Dégustation."
    ],
    "nl": [
      "Façon Chocolat is een atelier/boutique waar biologische, lactosevrije en veganistische pralines, zandkoekjes en sorbets worden gemaakt. Cafés. Theeschenkerij. Proeverijen."
    ],
    "es": [
      "Façon Chocolat es un taller/tienda donde se elaboran artesanalmente chocolates finos, así como mantecados y sorbetes ecológicos, sin lactosa y veganos. Cafetería. Salón de té. Degustaciones."
    ]
  },
