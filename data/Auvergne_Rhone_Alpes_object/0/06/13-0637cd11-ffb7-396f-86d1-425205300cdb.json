  "rdfs:comment": {
    "de": [
      "In einem geschmackvoll restaurierten Bauernhof bietet ein Laden mit 18 Produzenten aus dem Mézenc Käse, Wurstwaren, Marmeladen, Fertiggerichte und vieles mehr an. Jede Permanenz wird von einem Produzenten betreut. Ein authentischer und schmackhafter Ort! Restaurant im Obergeschoss."
    ],
    "en": [
      "In a tastefully restored farmhouse, a boutique of 18 Mezenc producers offers cheeses, charcuterie, jams, ready-made meals and much more. Each shop is staffed by a producer. An authentic, tasty place! Restaurant upstairs."
    ],
    "it": [
      "In una casa colonica restaurata con gusto, un negozio con 18 produttori della regione del Mézenc offre formaggi, salumi, marmellate, piatti pronti e molto altro. Ogni negozio è gestito da un produttore. Un luogo autentico e gustoso! Ristorante al piano superiore."
    ],
    "fr": [
      "Dans une ferme restaurée avec goût, une boutique de 18 producteurs du Mézenc propose fromages, charcuteries, confitures, plats cuisinés et bien plus. Chaque permanence est tenue par un producteur. Un lieu authentique et savoureux ! Restaurant à l'étage."
    ],
    "nl": [
      "In een smaakvol gerestaureerde boerderij biedt een winkel met 18 producenten uit de streek Mézenc kazen, vleeswaren, jam, kant-en-klaarmaaltijden en nog veel meer. Elke winkel wordt bemand door een producent. Een authentieke en smakelijke plek! Restaurant boven."
    ],
    "es": [
      "En una granja restaurada con gusto, una tienda con 18 productores de la región de Mézenc ofrece quesos, embutidos, mermeladas, platos preparados y mucho más. Cada tienda está atendida por un productor. Un lugar auténtico y sabroso Restaurante en el piso de arriba."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Fermiers du Mézenc"
    ]
  },
