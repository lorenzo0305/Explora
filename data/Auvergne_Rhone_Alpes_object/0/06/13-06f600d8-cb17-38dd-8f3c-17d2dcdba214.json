  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Herz einer üppigen Biodiversität, die Ferme aux\r\nKrokodilfarm ist einer der größten europäischen Tierparks, der Reptilien gewidmet ist."
    ],
    "en": [
      "Immerse yourself in the heart of lush biodiversity at Ferme aux Crocodiles.\r\nCrocodile Farm is one of Europe's largest animal parks dedicated to reptiles."
    ],
    "it": [
      "Immergetevi nel cuore di una rigogliosa biodiversità alla Crocodile Farm.\r\nLa Crocodile Farm è uno dei più grandi parchi animali d'Europa dedicati ai rettili."
    ],
    "fr": [
      "Plongez au cœur d’une biodiversité luxuriante dans le plus grand parc animalier européen dédié aux reptiles."
    ],
    "es": [
      "Sumérjase en el corazón de la exuberante biodiversidad de Crocodile Farm.\r\nCrocodile Farm es uno de los mayores parques de animales de Europa dedicado a los reptiles."
    ],
    "nl": [
      "Op een oppervlakte van 9.500m2 wordt u ondergedompeld in de wondere wereld van de reptielen. Maak kennis met krokodillen, schildpadden, vogels, varanen, slangen en alligators die zich ophouden in een weelderige vegetatie (meer dan 600 botanische variëteiten)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Krokodilfarm"
    ],
    "ru": [
      "Крокодиловая ферма"
    ],
    "en": [
      "The crocodile farm"
    ],
    "it": [
      "L'allevamento di coccodrilli"
    ],
    "fr": [
      "La Ferme aux Crocodiles"
    ],
    "zh": [
      "鳄鱼养殖场"
    ],
    "es": [
      "La granja de cocodrilos"
    ],
    "nl": [
      "De krokodillenboerderij"
    ]
  },
