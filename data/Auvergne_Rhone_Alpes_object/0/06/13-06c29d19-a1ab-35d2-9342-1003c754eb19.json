  "rdfs:comment": {
    "de": [
      "Die Brücke von Cognet wurde 1605 auf Initiative von Lesdiguières errichtet. Sie ist das einzige Beispiel einer Eselsrückenbrücke in der Matheysine und eine der ältesten im Département Isère."
    ],
    "en": [
      "The Cognet bridge was built in 1605 at the demand of Lesdiguières. It's the unique example on the Matheysine territory of bridge built in speed bump and one of the oldest of the Isère department."
    ],
    "it": [
      "Il Ponte di Cognet fu stata edificato in 1605 alla domanda di Lesdiguières. Sta l'unico esempio sul territorio di La Matheysine di ponte costruito in dorso d'asino e uno dei più vecchi del departamento dell'Isère."
    ],
    "fr": [
      "Le Pont de Cognet a été édifié en 1605 à l’initiative de Lesdiguières. Il est l’unique exemple sur le territoire de la Matheysine de pont construit en dos d’âne et un des plus ancien du département de l’Isère."
    ],
    "es": [
      "El Pont de Cognet se construyó en 1605 por iniciativa de Lesdiguières. Es el único ejemplo de puente jorobado del Matheysine y uno de los más antiguos del departamento de Isère."
    ],
    "nl": [
      "De Pont de Cognet werd in 1605 gebouwd op initiatief van Lesdiguières. Het is het enige voorbeeld van een bultrugbrug in de Matheysine en een van de oudste in het departement Isère."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cognet bridge"
    ],
    "it": [
      "Ponte di Cognet"
    ],
    "fr": [
      "Pont de Cognet"
    ]
  },
