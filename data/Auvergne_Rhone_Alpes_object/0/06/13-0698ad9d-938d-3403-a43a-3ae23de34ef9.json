  "rdfs:comment": {
    "de": [
      "Das Le Bruit qui Cour bietet Ihnen eine leckere und lokale Bistronomieküche. Das Restaurant befindet sich in Saint-Georges d'Espéranche in der Nähe von Vienne. Entdecken Sie einen gemütlichen und designorientierten Ort. Für Weinliebhaber wartet hier eine schöne Auswahl an Weinen aus Vienne auf Sie!"
    ],
    "en": [
      "Le Bruit qui Cour offers you a gourmet and local bistronomic cuisine. Located in Saint-Georges d'Espéranche near Vienne, come and discover a design and warm place. For the amateurs, a beautiful selection of wine of Vienne awaits you there!"
    ],
    "it": [
      "Le Bruit qui Cour offre una cucina gourmet e bistronomica locale. Situato a Saint-Georges d'Espéranche, vicino a Vienne, venite a scoprire un luogo accogliente e di design. Per gli amanti del vino, una raffinata selezione di vini di Vienne vi aspetta!"
    ],
    "fr": [
      "Le Bruit qui Cour vous propose une cuisine bistronomique gourmande et locale. Situé à  Saint-Georges d'Espéranche près de Vienne, venez découvrir un lieu design et chaleureux. Pour les amateurs, une belle sélection de vin de Vienne vous y attend !"
    ],
    "es": [
      "Le Bruit qui Cour ofrece una cocina gastronómica y bistronómica local. Situado en Saint-Georges d'Espéranche, cerca de Vienne, venga a descubrir un lugar cálido y de diseño. Para los amantes del vino, ¡una cuidada selección de vinos de Vienne les espera!"
    ],
    "nl": [
      "Le Bruit qui Cour biedt een gastronomische en lokale bistronomische keuken. Gelegen in Saint-Georges d'Espéranche nabij Vienne, kom en ontdek een design en warme plek. Voor wijnliefhebbers, een fijne selectie van Vienne wijnen wacht op u!"
    ]
  },
