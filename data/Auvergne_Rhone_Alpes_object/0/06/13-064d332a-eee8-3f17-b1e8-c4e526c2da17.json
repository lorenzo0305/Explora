  "rdfs:comment": {
    "de": [
      "In einer Fußgängerzone der Altstadt steht am Fuß von Saint-André-le-Bas das Steinhaus von Alquimia. Hier erhalten Sie hausgemachte Küche aus Produkten, die alle frisch, lokal und regional sind."
    ],
    "en": [
      "Situated in a small, quiet street, with a great view of Saint-André-le-Bas church, L'Alquimia is a typical restaurant with stone walls and stylish decoration. The cuisine is traditional and high on quality."
    ],
    "it": [
      "Situato nel cuore del centro storico di Vienna, Alquimia è un luogo in cui le persone si incontrano per scoprire una nuova esperienza!\r\nCucina gastronomica franco-paraguaiana."
    ],
    "fr": [
      "Situé au cœur du centre ancien de la ville de Vienne, Alquimia est un lieu de partage ou l’on se retrouve pour découvrir une nouvelle expérience !\r\nCuisine gastronomique, Franco Paraguayenne."
    ],
    "es": [
      "Situado en el corazón del casco antiguo de Viena, Alquimia es un lugar donde la gente se reúne para descubrir una nueva experiencia\r\nCocina gastronómica franco-paraguaya."
    ],
    "nl": [
      "Alquimia ligt in het hart van het oude stadscentrum van Wenen en is een plek waar mensen samenkomen om een nieuwe ervaring te ontdekken!\r\nGastronomische, Frans-Paraguayaanse keuken."
    ]
  },
