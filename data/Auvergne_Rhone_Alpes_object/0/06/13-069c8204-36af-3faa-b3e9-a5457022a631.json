  "rdfs:comment": {
    "de": [
      "Saint-André-en-Royans ist ein kleines Dorf, das sich an die Ausläufer des Vercors-Gebirges schmiegt. Seine schöne Silhouette mit den um das Schloss gruppierten Häusern wurde schon immer von Besuchern und durchreisenden Malern geschätzt."
    ],
    "en": [
      "Saint-André-en-Royans is a small village in the foothills of the Vercors. Its beautiful silhouette, with houses grouped around the castle, has always been appreciated by visitors and visiting painters."
    ],
    "it": [
      "Saint-André-en-Royans è un piccolo villaggio situato ai piedi del Vercors. La sua bella silhouette, con le case raggruppate intorno al castello, è sempre stata apprezzata dai visitatori e dai pittori in visita."
    ],
    "fr": [
      "Saint-André-en-Royans est un petit village adossé aux contreforts du Vercors. Sa belle silhouette, aux maisons groupées autour du château, a toujours été appréciée par les visiteurs et les peintres de passage."
    ],
    "nl": [
      "Saint-André-en-Royans is een klein dorp aan de voet van de Vercors. Zijn mooie silhouet, met huizen gegroepeerd rond het kasteel, is altijd gewaardeerd door bezoekers en bezoekende schilders."
    ],
    "es": [
      "Saint-André-en-Royans es un pequeño pueblo situado en las estribaciones del Vercors. Su bella silueta, con las casas agrupadas alrededor del castillo, siempre ha sido apreciada por los visitantes y los pintores visitantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Saint-André-en-Royans"
    ]
  },
