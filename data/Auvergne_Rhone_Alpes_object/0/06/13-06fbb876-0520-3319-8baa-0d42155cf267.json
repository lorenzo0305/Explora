  "rdfs:comment": {
    "de": [
      "Semi-gastronomisches Restaurant mit einer Küche aus frischen lokalen Produkten: Fischsuppe, Froschschenkel, Bavarois mit Früchten... Das Ganze findet in einem Gasthaus aus dem 18. Jahrhundert statt."
    ],
    "en": [
      "Gourmet eatery serving local produce: fish soup, frog's legs, fruit bavarois and more all in an 18th century inn."
    ],
    "it": [
      "Ristorante semi-gastronomico che offre una cucina a base di prodotti freschi locali: zuppa di pesce, cosce di rana, bavarese di frutta... Il tutto in una locanda del XVIII secolo."
    ],
    "fr": [
      "Restaurant semi-gastronomique proposant une cuisine de produits locaux frais: Soupe de Poisson, cuisses de grenouilles, bavarois aux fruits... Le tout dans une auberge du 18ème siècles."
    ],
    "nl": [
      "Semi-gastronomisch restaurant met verse streekproducten: vissoep, kikkerbilletjes, vruchtenbavarois... Alles in een 18e eeuwse herberg."
    ],
    "es": [
      "Restaurante semigastronómico que ofrece una cocina de productos frescos de la zona: sopa de pescado, ancas de rana, bavarois de frutas... Todo ello en una posada del siglo XVIII."
    ]
  },
