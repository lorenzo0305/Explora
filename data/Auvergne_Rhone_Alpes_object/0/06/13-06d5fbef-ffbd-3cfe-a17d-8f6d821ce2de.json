  "rdfs:comment": {
    "de": [
      "Der KIWANIS Club de VICHY veranstaltet seinen traditionellen Abend der Eleganz. Eine Wohltätigkeitsmodenschau, die am Samstag, den 28. März 2026, im Espace Chambon in Cusset veranstaltet wird."
    ],
    "en": [
      "The KIWANIS Club de VICHY is organizing its traditional Soirée de l'Elégance. A charity fashion show, organized on Saturday March 28, 2026, at the Espace Chambon in Cusset."
    ],
    "it": [
      "Il Club KIWANIS di VICHY organizza la sua tradizionale serata d'eleganza. Sabato 28 marzo 2026, presso l'Espace Chambon di Cusset, si terrà una sfilata di moda a scopo benefico."
    ],
    "fr": [
      "Le KIWANIS Club de VICHY organise sa traditionnelle soirée de l'Elégance. Un défilé de mode caritatif, organisé le samedi 28 mars 2026, à l'Espace Chambon à Cusset."
    ],
    "es": [
      "El KIWANIS Club de VICHY organiza su tradicional velada Elegance. El sábado 28 de marzo de 2026 se celebrará un desfile de moda benéfico en el Espace Chambon de Cusset."
    ],
    "nl": [
      "De KIWANIS Club de VICHY organiseert haar traditionele Elegance avond. Een modeshow voor het goede doel wordt gehouden op zaterdag 28 maart 2026 in de Espace Chambon in Cusset."
    ]
  },
  "rdfs:label": {
    "fr": [
