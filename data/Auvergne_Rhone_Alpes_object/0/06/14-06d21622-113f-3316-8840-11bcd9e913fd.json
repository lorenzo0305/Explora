        ],
        "fr": [
          "Rendez vous rue de la Coharte\nReconstitution d'un camp militaire 39-45\ndéfilé voitures militaires, commémoration\nEntrée : 1 €\nSpectacle : 5 €"
        ],
        "es": [
          "Encuentro en la rue de la Coharte\nReconstrucción de un campamento militar del 39-45\ndesfile de vehículos militares, conmemoración\nEntrada : 1 ?\nEspectáculo: 5 ?"
        ],
        "nl": [
