  "rdfs:comment": {
    "de": [
      "Seit 1998 pflegt die handwerkliche Nougat-Manufaktur „Le Genêt d’Or“ die Tradition der Ardèche durch eine handwerkliche Herstellung. All unsere Nougat-Spezialitäten werden mit Honig aus der Ardèche zubereitet. Wir fertigen direkt vor Ort Nougat, Marshmallows, Pralinen und Fruchtgelees an."
    ],
    "en": [
      "Artisan nougat maker since 1998, Le Genêt d’Or carries on the traditional Ardèche expertise through artisanal cooking. All our nougats are crafted with honey from Ardèche, and we produce our own nougats, marshmallows, pralines, and fruit jellies on-site."
    ],
    "it": [
      "Produttore di torrone artigianale dal 1998, Le Genêt d'Or perpetua il know-how dell'Ardèche con metodi di cottura tradizionali. Tutti i nostri torroni sono fatti con miele dell'Ardèche e produciamo torroni, marshmallow, praline e gelatine di frutta in loco."
    ],
    "fr": [
      "Artisan nougatier depuis 1998, Le Genêt d’Or perpétue le savoir-faire ardéchois avec une cuisson artisanale. Tous nos nougats sont élaborés avec du miel d’Ardèche, et nous fabriquons sur place nougats, guimauves, pralines et pâtes de fruits."
    ],
    "es": [
      "Turronero artesano desde 1998, Le Genêt d'Or perpetúa el saber hacer de Ardèche con métodos de fabricación tradicionales. Todos nuestros turrones se elaboran con miel de Ardèche, y producimos turrones, malvaviscos, pralinés y gelatinas de frutas in situ."
    ],
    "nl": [
      "Ambachtelijke nougatmaker sinds 1998, Le Genêt d’Or zet het vakmanschap van de Ardèche voort met een traditionele bereidingswijze. Al onze nougat wordt bereid met honing uit de Ardèche, en wij maken ter plaatse nougat, marshmallows, pralines en vruchtenpasta's."
    ]
  },
