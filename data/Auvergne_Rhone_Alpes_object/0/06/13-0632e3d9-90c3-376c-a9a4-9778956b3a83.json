  "rdfs:comment": {
    "de": [
      "Bar / Restaurant in der Höhe und auf der Alm. Berghütte.\r\nProdukte aus der Region. Wurstteller / Käseteller / Gemischter Teller. Menü des Tages. Plancha Samstag- und Sonntagmittag.\r\n\r\nTerrasse mit Blick auf den Mont Blanc und den Beaufortain."
    ],
    "en": [
      "Alpine restaurant and bar. \r\nLocal produce. Charcuterie platter / Cheese platter / Mixed platter. Menu of the day or plancha. Grilled meats on Saturdays and Sundays.\r\n\r\nTerrace with views of Mont Blanc and Beaufortain."
    ],
    "it": [
      "Ristorante e bar alpino. \r\nProdotti locali. Piatto di salumi / Piatto di formaggi / Piatto misto. Menu del giorno o plancha. Carni alla griglia il sabato e la domenica.\r\n\r\nTerrazza con vista sul Monte Bianco e sul Beaufortain."
    ],
    "fr": [
      "Bar / restaurant d'altitude et d'alpage. Refuge.\r\nProduits locaux. Assiette de charcuterie / Assiette de fromage / Assiette mixte. Menu du jour. Plancha samedi et dimanche midi.\r\n\r\nTerrasse avec vue sur le Mont Blanc et le Beaufortain."
    ],
    "es": [
      "Bar/restaurante en altura y en los pastos de montaña. Refugio.\r\nProductos locales. Tabla de embutidos / Tabla de quesos / Tabla mixta. Menú del día. Plancha sábado y domingo al mediodía.\r\n\r\nTerraza con vistas al Mont Blanc y Beaufortain."
    ],
    "nl": [
      "Alpine restaurant en bar. \r\nLokale producten. Charcuterie schotel / Kaas schotel / Gemengde schotel. Dagmenu of plancha. Gegrild vlees op zaterdag en zondag.\r\n\r\nTerras met uitzicht op de Mont Blanc en de Beaufortain."
    ]
  },
