  "rdfs:comment": {
    "de": [
      "Für Liebhaber guter Gerichte, die in einer entspannten Atmosphäre genossen werden können! Lokaler Fischfang, Tagesgerichte bereichern Ihr Mittag- oder Abendessen! Man schätzt die überdachte und beheizte Terrasse, die nur wenige Schritte vom Meer entfernt ist."
    ],
    "en": [
      "For lovers of good food to enjoy in a relaxed atmosphere! Local fish, dishes of the day come to decorate your lunch or your dinner! We appreciate the covered and heated terrace close to the sea."
    ],
    "it": [
      "Per chi ama la buona cucina in un'atmosfera rilassata! Il pesce locale e le specialità del giorno arricchiranno il vostro pranzo o la vostra cena! Apprezzerete la terrazza coperta e riscaldata a pochi passi dal mare."
    ],
    "fr": [
      "Pour les amateurs de bons petits plats à déguster dans  une ambiance décontractée ! Pêche locale, plats du jour viennent agrémenter votre déjeuner ou votre dîner ! On apprécie la terrasse couverte et chauffée à deux pas de la mer."
    ],
    "nl": [
      "Voor liefhebbers van lekker eten in een ontspannen sfeer! Lokale vis en dagschotels verrijken uw lunch of diner! U zult het overdekte en verwarmde terras op een steenworp afstand van de zee waarderen."
    ],
    "es": [
      "Para los amantes de la buena comida en un ambiente relajado El pescado local y las especialidades del día realzarán su almuerzo o cena Apreciará la terraza cubierta y climatizada a un paso del mar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jardins de la Terrasse (Hôtel la Terrasse)"
    ]
  },
