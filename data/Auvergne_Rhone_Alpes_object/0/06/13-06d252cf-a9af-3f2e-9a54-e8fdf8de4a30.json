  "rdfs:comment": {
    "de": [
      "Dieser außergewöhnliche Aussichtspunkt auf 2285 m Höhe führt Sie zu den Toren des Naturschutzgebiets Carlaveyron. Mit einem herrlichen Panoramablick auf den Mont Blanc erhebt sich dieser Berg gegenüber diesem prächtigen Massiv."
    ],
    "en": [
      "This exceptional viewpoint located at 2285m of altitude will lead you to the doors of the natural reserve of Carlaveyron. With a magnificent and panoramic view on the Mont Blanc, this mountain rises in front of this sumptuous massif."
    ],
    "it": [
      "Questo punto di osservazione eccezionale, situato a 2285 m di altitudine, vi condurrà alle porte della riserva naturale di Carlaveyron. Con una magnifica vista panoramica sul Monte Bianco, questa montagna si erge davanti a questo sontuoso massiccio."
    ],
    "fr": [
      "Ce point de vue exceptionnel situé à 2285m d'altitude vous menera aux portes de la réserve naturelle de Carlaveyron. Avec une vue magnifique et panoramique sur le Mont Blanc, cette montagne s'élève face à ce somptueux massif."
    ],
    "es": [
      "Este excepcional mirador, situado a 2285 m de altitud, le conducirá a las puertas de la reserva natural de Carlaveyron. Con una magnífica y panorámica vista del Mont Blanc, esta montaña se alza frente a este suntuoso macizo."
    ],
    "nl": [
      "Dit uitzonderlijke uitkijkpunt, gelegen op een hoogte van 2285m, leidt u naar de poorten van het natuurreservaat Carlaveyron. Deze berg biedt een prachtig en panoramisch uitzicht op de Mont Blanc."
    ]
  },
