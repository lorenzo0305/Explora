  "rdfs:comment": {
    "de": [
      "Verkaufsausstellung verschiedener Kunsthandwerke aus den Klöstern Bethlehems (Statuetten, Ikonen, Krippenfiguren, Medaillen, in den Monts Voirons hergestelltes Steingutgeschirr und verzierte Fayence)."
    ],
    "en": [
      "Exhibition and sale of various Bethlehem monastery crafts (statuettes, icons, cribs, medals, stoneware made in Monts Voirons and decorated earthenware)."
    ],
