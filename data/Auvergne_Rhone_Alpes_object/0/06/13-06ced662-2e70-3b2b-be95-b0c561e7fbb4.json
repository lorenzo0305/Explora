  "rdfs:comment": {
    "de": [
      "Diversifizierter Bauernhof, wir produzieren: Weichweizen (darunter Dinkel), Körnermais, Sojabohnen, Freiland- und geschütztes Gemüse, Masthähnchen."
    ],
    "en": [
      "A diversified farm, we produce: soft wheat (including spelt), grain corn, soybeans, field and protected vegetables, broiler chickens."
    ],
    "it": [
      "Un'azienda agricola diversificata, che produce: grano tenero (compreso il farro), mais da granella, soia, ortaggi da campo e da interno e polli da carne."
    ],
    "fr": [
      "Ferme diversifiée, nous produisons : blé tendre (dont épeautre), maïs grain, soja, légumes de plein champ et sous abris, poulets de chair."
    ],
    "es": [
      "Granja diversificada, producimos: trigo blando (incluida la espelta), maíz en grano, soja, hortalizas de campo y de interior y pollos de engorde."
    ],
    "nl": [
      "Een gediversifieerde boerderij, we produceren: zachte tarwe (inclusief spelt), korrelmaïs, soja, vollegronds- en binnengroenten en vleeskippen."
    ]
  },
