  "rdfs:comment": {
    "de": [
      "Das Atelier Dioica, Kunsthandwerker und Korbflechter, bietet Ihnen die Anfertigung von Stücken auf Bestellung und Einführungskurse in die Korbflechterei an."
    ],
    "en": [
      "Atelier Dioica, a basket weaving artisan, offer custom-made pieces and introductory courses in basket weaving."
    ],
    "it": [
      "L'Atelier Dioica e Athénaïs Vercelloti vi offrono la possibilità di realizzare pezzi su misura e di partecipare a corsi di introduzione alla cesteria a Saint-Myon (63)."
    ],
    "fr": [
      "Atelier Dioica et Athénaïs Vercelloti vous proposent la réalisation de pièces sur commande et des stages d'initiation à la vannerie sur la commune de Saint-Myon (63)."
    ],
    "es": [
      "Atelier Dioica y Athénaïs Vercelloti le ofrecen la posibilidad de realizar piezas a medida y participar en cursos de iniciación a la cestería en Saint-Myon (63)."
    ],
    "nl": [
      "Atelier Dioica en Athénaïs Vercelloti bieden je de mogelijkheid om stukken op maat te maken en deel te nemen aan inleidende cursussen mandenvlechten in Saint-Myon (63)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Dioica - Vannerie"
    ]
  },
