  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Esel-Pool Bourbonnais in Braize, der dem Esel gewidmet ist.\r\nDie Besichtigung umfasst das Eselsmuseum, die Werkstatt des Stellmachers, die Rekonstruktion einer Holzschuhmacherwerkstatt, eine Agrarsammlung, die Werkstatt des Langsägers und die Scheune mit den Kutschen."
    ],
    "en": [
      "Come and discover the Pôle Asin Bourbonnais, dedicated to the donkey, in Braize.\r\nThe visit includes the donkey museum, the wheelwright's workshop, a reconstruction of a clogmaker's workshop, an agrarian collection, the pit saw workshop and the carriage barn."
    ],
    "it": [
      "Venite a scoprire il Pôle Asin Bourbonnais, dedicato all'asino, a Braize.\r\nLa visita comprende il museo dell'asino, l'officina del carradore, la ricostruzione dell'officina di uno zoccolaio, una collezione agricola, l'officina della sega a tazza e la stalla del carro."
    ],
    "fr": [
      "Venez découvrir le Pôle Asin Bourbonnais consacré à l'âne, à Braize.\r\nLa visite comprend le musée de l'âne, l'atelier du charron, reconstitution d'un atelier de sabotier une collection agraire, atelier du scieur de long, la grange aux carrioles."
    ],
    "es": [
      "Venga a descubrir el Pôle Asin Bourbonnais, dedicado al burro, en Braize.\r\nLa visita incluye el museo del burro, el taller del carretero, la reconstrucción de un taller de zueco, una colección agrícola, el taller de sierra de foso y el granero de carros."
    ],
    "nl": [
      "Kom en ontdek de Pôle Asin Bourbonnais, gewijd aan de ezel, in Braize.\r\nHet bezoek omvat het ezelmuseum, de werkplaats van de wagenmaker, een reconstructie van de werkplaats van een klompenmaker, een landbouwcollectie, de werkplaats van de steenzaag en de schuur van de kar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pôle asin bourbonnais"
    ]
  },
