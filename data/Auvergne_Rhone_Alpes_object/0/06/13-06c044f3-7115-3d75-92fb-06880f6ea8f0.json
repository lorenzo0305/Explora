  "rdfs:comment": {
    "de": [
      "Ein theatralisches und musikalisches Epos, das von 40 Schauspielern, Sängern und Musikern getragen wird, wobei der Ch?ur, der aus den Bewohnern von 15 Dörfern zwischen Crest und Montélimar besteht, zum schlagenden Herzen der Erzählung wird."
    ],
    "en": [
      "A theatrical and musical epic performed by 40 actor-singers and musicians, where the Choir, made up of inhabitants from about fifteen villages between Crest and Montélimar, becomes the beating heart of the story."
    ],
    "it": [
      "Un'epopea teatrale e musicale interpretata da 40 attori, cantanti e musicisti, in cui il Coro, composto dagli abitanti di una quindicina di villaggi tra Crest e Montélimar, diventa il cuore pulsante della storia."
    ],
    "fr": [
      "Une épopée théâtrale et musicale portée par 40 comédien·nes-chanteurs et musiciens, où le Chœur, formé d’habitant·es d’une quinzaine de villages entre Crest et Montélimar, devient le cœur battant du récit."
    ],
    "es": [
      "Una epopeya teatral y musical interpretada por 40 actores, cantantes y músicos, en la que el Coro, formado por los habitantes de una quincena de pueblos entre Crest y Montélimar, se convierte en el corazón palpitante de la historia."
    ],
    "nl": [
      "Een theatraal en muzikaal epos uitgevoerd door 40 acteurs, zangers en muzikanten, waarin het koor, bestaande uit de inwoners van een vijftiental dorpen tussen Crest en Montélimar, het kloppend hart van het verhaal wordt."
    ]
  },
