  "rdfs:comment": {
    "de": [
      "Herstellung von Gebrauchs- und Ziersteinzeugkeramik. Texturierung des Materials zum Zeitpunkt der Formgebung für eine natürliche Wiedergabe.\r\nGeschirrsortiment und farbenfrohe Küchenaccessoires für jeden Tag!"
    ],
    "en": [
      "Creation of utilitarian and ornamental stoneware ceramics. Work of texturing the material at the time of shaping for a natural rendering.\r\nRange of crockery and colorful kitchen accessories for every day!"
    ],
    "it": [
      "Creazione di ceramiche utilitarie e ornamentali in gres.\r\nUna gamma di stoviglie colorate e accessori da cucina per tutti i giorni!\r\nCorsi e laboratori di lancio."
    ],
    "fr": [
      "Création de céramique utilitaire et ornementale en grès. \r\nGamme de vaisselle et accessoires de cuisine colorée pour tous les jours!\r\nCours et stage de tournage."
    ],
    "nl": [
      "Maken van gebruiks- en sierkeramiek van steengoed.\r\nEen assortiment kleurrijk servies en keukenaccessoires voor elke dag!\r\nCursussen en workshops in gooien."
    ],
    "es": [
      "Creación de cerámica de gres utilitaria y ornamental.\r\nVajilla de colores y accesorios de cocina para todos los días\r\nCursos y talleres de lanzamiento."
    ]
  },
