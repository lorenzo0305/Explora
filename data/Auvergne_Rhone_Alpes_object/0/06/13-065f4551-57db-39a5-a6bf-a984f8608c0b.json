  "rdfs:comment": {
    "de": [
      "Kanu und Kajak Vermietung – Fahrt durch die Ardèche-Schlucht."
    ],
    "en": [
      "Canoe-Kayak hire - Trips down the Ardèche Gorges."
    ],
    "it": [
      "Noleggio di canoe e kayak. Discesa delle Gole dell'Ardèche. scoprire la mini-discesa del \"Moulin à Saint-Just\". Scoperta del canyon del Sud: partenza e ritorno alla nostra base di sport nautici, senza vincoli di orario\r\nPercorsi: 25km, 32km, 55km e 70km, 8km pont d'arc"
    ],
    "fr": [
      "Location de canoës- kayak. Descente des Gorges de l'Ardèche. , mini-descente du Moulin à Saint-Just. Découverte du canyon Sud : départ et retour à notre base nautique, pas de contrainte d'horaire\r\nParcours : 25 km, 32 km, 55km et 70 km, 8km pont d’arc"
    ],
    "nl": [
      "Verhuur van kano's-kajakken - afdaling in de Gorges de l'Ardèche."
    ],
    "es": [
      "Alquiler de canoas y kayacs. Descenso de las Gargantas del Ardèche. descubrimiento del mini-descenso del \"Moulin à Saint-Just\". Descubrimiento del cañón Sur: salida y regreso a nuestra base náutica, sin límite de tiempo\r\nRecorridos: 25km, 32km, 55km y 70km, 8km pont d'arc"
    ]
  },
