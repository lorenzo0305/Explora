  "rdfs:comment": {
    "de": [
      "Restaurant mit Blick aufs Meer, traditionelle Küche, Speisesaal mit Themenabenden, Tanzdinner.  Frische und lokale Produkte, einfache und großzügige Küche.\n\nSignature Dishes: Miesmuscheln, Picardy Ficelle, Fisch aus der Bucht, regionale Spezialitäten\n\nCocktailbar Lounge mit Blick aufs Meer"
    ],
    "en": [
      "Restaurant facing the sea, traditional cuisine, dining room with theme evenings, dinner dances.  Fresh, local produce, simple, generous cuisine.\n\nSignature dishes: mussels, ficelle picarde, fish from the bay, regional specialties\n\nCocktail bar Lounge facing the sea"
    ],
    "it": [
      "Ristorante fronte mare, cucina tradizionale, sala ristorante con serate a tema e cene danzanti.  Prodotti freschi e locali, cucina semplice e generosa.\n\nPiatti tipici: cozze, ficelle picarde, pesce della baia, specialità regionali, ecc\n\nCocktail bar e lounge di fronte al mare"
    ],
    "fr": [
      "Restaurant face mer, cuisine traditionnelle, salle de restaurant avec soirées à thèmes, dîners dansants.  Produits frais et locaux, cuisine simple et généreuse.\n\nPlats signature : moules, ficelle picarde, poissons de la baie, spécialités régionales\n\nBar à cocktails  Lounge face mer"
    ],
    "es": [
      "Restaurante frente al mar, cocina tradicional, sala de restaurante con veladas temáticas y cenas con baile.  Productos frescos y locales, cocina sencilla y generosa.\n\nPlatos de autor: mejillones, ficelle picarde, pescado de la bahía, especialidades regionales, etc\n\nBar de cócteles y salón frente al mar"
    ],
    "nl": [
      "Restaurant met uitzicht op zee, traditionele keuken, restaurantzaal met thema-avonden en dansavonden.  Verse, lokale producten, eenvoudige, gulle keuken.\n\nTypische gerechten: mosselen, ficelle picarde, vis uit de baai, regionale specialiteiten, enz\n\nCocktailbar en lounge met uitzicht op zee"
    ]
  },
