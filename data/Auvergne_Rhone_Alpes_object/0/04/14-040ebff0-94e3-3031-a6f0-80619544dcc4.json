      "@id": "https://data.datatourisme.fr/dc2a3f04-f8a8-395b-ab96-3cf7f34d7868",
      "dc:description": {
        "de": [
          "Samstag, 14. Februar\n------------------------------------------------\nOrganisiert vom Centre Communal d'Action Social de Merlimont in der Salle Polyvalente (Place de la gare)\n\nDie große Valentinstags-Dance-Party ab 21 Uhr\nPreise: 5 ? pro Erwachsener und kostenlos für Kinder\nBezahlung: Zahlung vor Ort und nur in bar.\nGetränke werden während des Abends zugunsten des CCAS von Merlimont verkauft\n\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Saturday, February 14th\n------------------------------------------------\nOrganized by the Centre Communal d'Action Social de Merlimont at the Salle Polyvalente (Place de la gare)\n\nLa Grande Soirée Saint Valentin Dance Party from 9pm\nPrices: 5? per adult and free for children\nPayment: on the spot and by cash only.\nRefreshments available during the evening to benefit the Merlimont CCAS\n\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Sabato 14 febbraio\n------------------------------------------------\nOrganizzato dal Centre Communal d'Action Social de Merlimont presso la Salle Polyvalente (Place de la gare)\n\nFesta di ballo La Grande Soirée Saint Valentin dalle ore 21.00\nPrezzi: 5? per adulto e gratis per i bambini\nPagamento: sul posto e solo in contanti.\nDurante la serata sarà disponibile un rinfresco a favore del CCAS di Merlimont\n\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Samedi 14 février\n------------------------------------------------\nOrganisée par le Centre Communal d'Action Social de Merlimont  à la Salle Polyvalente (Place de la gare)\n\nLa Grande Soirée Saint Valentin Dance Party à partir de 21h\nTarifs : 5€ par adulte et gratuit pour les enfants \nRéglement : paiement sur place et uniquement par espèces.\nBuvette présente durant cette soirée au profit du CCAS du Merlimont\n\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Zaterdag 14 februari\n------------------------------------------------\nGeorganiseerd door het Centre Communal d'Action Social de Merlimont in de Salle Polyvalente (Place de la gare)\n\nLa Grande Soirée Saint Valentin Dansfeest vanaf 21u\nPrijzen: 5 euro per volwassene en gratis voor kinderen\nBetaling: ter plaatse en alleen contant.\nVersnaperingen verkrijgbaar tijdens de avond ter ondersteuning van het CCAS van Merlimont\n\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Sábado 14 de febrero\n------------------------------------------------\nOrganizado por el Centre Communal d'Action Social de Merlimont en la Salle Polyvalente (Place de la gare)\n\nLa Grande Soirée Saint Valentin Fiesta de baile a partir de las 21 h\nPrecios: 5? por adulto y gratis para los niños\nPago: in situ y sólo en efectivo.\nRefrescos disponibles durante la velada a beneficio de la CCAS de Merlimont\n\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
