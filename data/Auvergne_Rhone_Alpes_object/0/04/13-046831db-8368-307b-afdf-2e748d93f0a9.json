  "rdfs:comment": {
    "de": [
      "Als Glashandwerker kreiere ich einzigartige Stücke, die verschiedene Schmelz- und Gießtechniken miteinander verbinden. In meinem Geschäft finden Sie diese Kollektionen mit überraschenden Farben."
    ],
    "en": [
      "As an artisan glassmaker, I create unique pieces combining various melting and casting techniques. You'll find these colorful collections in my boutique."
    ],
    "it": [
      "In qualità di artigiano vetraio, creo pezzi unici utilizzando diverse tecniche di fusione e colata. Troverete queste collezioni sorprendentemente colorate nel mio negozio."
    ],
    "fr": [
      "Artisan verrier, je crée des pièces uniques associant diverses techniques de fusion et de coulage. Vous trouverez dans ma boutique ces collections aux couleurs surprenantes."
    ],
    "es": [
      "Como artesana vidriera, creo piezas únicas utilizando diversas técnicas de fundición y moldeado. En mi tienda encontrará estas sorprendentes colecciones llenas de color."
    ],
    "nl": [
      "Als ambachtelijk glasblazer maak ik unieke stukken met behulp van verschillende smelt- en giettechnieken. Je vindt deze verrassend kleurrijke collecties in mijn winkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Artisan verrier : Non mais oui"
    ]
