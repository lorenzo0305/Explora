    "de": [
      "Nicht verpassen: Die Rodelbahn Alpine Coaster in Chamonix ist das ganze Jahr über geöffnet! Sogar bei Regenwetter!"
    ],
    "en": [
      "Don't miss: Chamonix's Alpine Coaster toboggan run is open all year round! Even in the rain!"
    ],
    "it": [
      "Da non perdere: la pista da slittino Alpine Coaster di Chamonix è aperta tutto l'anno! Anche sotto la pioggia!"
    ],
    "fr": [
      "À ne pas manquer : la piste de Luge Alpine Coaster de Chamonix est ouverte toute l'année ! Même par temps de pluie !"
    ],
    "nl": [
      "Wat je niet mag missen: de rodelbaan Alpine Coaster in Chamonix is het hele jaar door geopend! Zelfs in de regen!"
    ],
    "es": [
