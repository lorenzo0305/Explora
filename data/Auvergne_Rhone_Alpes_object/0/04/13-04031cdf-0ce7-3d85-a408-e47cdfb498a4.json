  "rdfs:comment": {
    "de": [
      "Eine einzigartige Kombination aus einem wunderschön restaurierten Schloss, das auf einem der schönsten Terroirs, Le Marestel, einen außergewöhnlichen Wein produziert.\r\nProbieren Sie mit Freunden oder der Familie alle unsere Cuvées, begleitet von regionalen Produkten oder einem önologischen Escape Game."
    ],
    "en": [
      "Unique combination of a beautifully restored castle producing exceptional wine on one of the most beautiful terroirs, Le Marestel.\r\nEnjoy with friends or family all our vintages paired with regional products or an oenological escape game."
    ],
    "it": [
      "Combinazione unica di un castello splendidamente restaurato che produce un vino eccezionale su uno dei terroir più belli, Le Marestel.\r\nGoditi con amici o famiglia tutte le nostre cuvée accompagnate da prodotti regionali o da un escape game enologico."
    ],
    "fr": [
      "Combinaison unique d'un château magnifiquement restauré produisant un vin d'exception sur l'un des plus beaux terroirs, Le Marestel.\r\nDégustez entre amis ou en famille toutes nos cuvées accompagnées de produits régionaux ou d'un escape game oenologique."
    ],
    "es": [
      "Una combinación única de un hermoso château restaurado que produce un vino excepcional en uno de los terruños más bellos, Le Marestel.\r\nDeguste todos nuestros vinos con amigos o en familia, acompañados de productos regionales o de un juego de escape enológico."
    ],
    "nl": [
      "Een unieke combinatie van een prachtig gerestaureerd château dat een uitzonderlijke wijn produceert op een van de mooiste terroirs, Le Marestel.\r\nGeniet van al onze wijnen met vrienden of familie, vergezeld van streekproducten of een oenologisch ontsnappingsspel."
    ]
  },
