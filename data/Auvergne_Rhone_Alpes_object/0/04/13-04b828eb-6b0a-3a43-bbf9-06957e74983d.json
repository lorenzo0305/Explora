  "rdfs:comment": {
    "de": [
      "Menüs, Speisekarte, Spezialitäten. Frische und regionale Produkte.\r\nDie Raffinesse des \"La Table\" beginnt mit einem freundlichen Empfang und setzt sich in der Küche durch den Respekt vor frischen und regionalen Produkten fort.\r\nTalentierter Service, qualitativ hochwertige Leistungen."
    ],
    "en": [
      "Menus, à la carte, specialities, gastronomy. Fresh and regional produce. Terrace during the summer.\r\nThe refinement of the table starts with the welcome followed by the cuisine in which there should be only fresh regional produce.  Whatever the season, talented, quality service. When it's nice weather : terrace - garden right in the centre of Thones."
    ],
    "it": [
      "Menu, menu, specialità. Prodotti freschi locali.\r\nLa raffinatezza de La Table inizia con un'accoglienza sorridente e prosegue in cucina nel rispetto dei prodotti freschi regionali.\r\nServizio di talento, servizi di qualità."
    ],
    "fr": [
      "Menus, carte, spécialités. Produits frais et régionaux. \r\nLe raffinement de la Table commence par un accueil souriant et se décline en cuisine par le respect dû aux produits frais et régionaux.\r\nService talentueux, prestations de qualité."
    ],
    "nl": [
      "Menu's, menukaart, specialiteiten. Verse streekproducten.\r\nDe verfijning van La Table begint met een glimlachend welkom en gaat verder in de keuken met respect voor verse streekproducten.\r\nGetalenteerde service, kwaliteitsvoorzieningen."
    ],
    "es": [
      "Menús, carta, especialidades. Productos locales frescos.\r\nEl refinamiento de La Table comienza con una bienvenida sonriente y continúa en la cocina, respetando los productos frescos de la región.\r\nServicio con talento, servicios de calidad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Commerce"
    ],
    "fr": [
      "Le Commerce"
    ]
  },
