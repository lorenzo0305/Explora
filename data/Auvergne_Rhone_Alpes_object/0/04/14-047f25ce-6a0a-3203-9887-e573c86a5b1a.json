  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0e6cbc6e-1130-39de-93ee-3f0a0a08e275",
      "dc:description": {
        "de": [
          "Der Herbst bringt eine Vielzahl von Beeren hervor. Lernen Sie, sie zu erkennen, und kochen Sie sie zu köstlichen Marmeladen."
        ],
        "en": [
          "Autumn brings us a whole host of berries, so learn to recognize them and cook them to make delicious jams."
        ],
        "it": [
          "L'autunno ci regala un'infinità di frutti di bosco: imparate a riconoscerli e a cucinarli per preparare deliziose marmellate."
        ],
        "fr": [
          "L’automne nous livre toute une quantité de baies, apprenez à les reconnaitre et à les cuisinez afin d'en réaliser de succulentes confitures."
        ],
        "es": [
          "El otoño nos trae un sinfín de bayas, así que aprenda a reconocerlas y a cocinarlas para preparar deliciosas mermeladas."
        ],
        "nl": [
          "De herfst brengt ons een heleboel bessen, dus leer ze herkennen en kook ze om er heerlijke jam van te maken."
        ]
      },
