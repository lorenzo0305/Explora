  "rdfs:comment": {
    "de": [
      "Herstellung und Verkauf von ReblochonAOP, Beaufort AOP, Tomme, Raclette de Savoie IGP, Joghurts und Quark. Verkauf von Produkten aus der Region und traditionelle Aromen aus Savoyen – Eis, Käse vom Hof, Wein, Pökelfleisch, Fleisch aus der Gegend …"
    ],
    "en": [
      "Manufacture and sale of Reblochon AOP, Beaufort AOP, Tomme and Raclette de Savoie IGP, Whole milk yogurts. Sale of products from the local area and traditional Savoie flavours: ice cream/farm cheeses, wines, cured meats."
    ],
    "it": [
      "Produzione e vendita di Reblochon DOP, Beaufort DOP, Tomme e Raclette de Savoie IGP, yogurt intero.... Selezione di prodotti locali e sapori della tradizione locale: gelati e formaggi di fattoria, vini, salumi e carni locali..."
    ],
    "fr": [
      "Fabrication et vente de Reblochon AOP, Beaufort AOP, Tomme et Raclette de Savoie IGP, Yaourts au lait entier.... Sélection de produits du territoire et saveurs traditionnelles locales : glaces/fromages fermiers, vins, salaisons et viande locale..."
    ],
    "nl": [
      "Vervaardiging en verkoop van Reblochon AOP, Beaufort AOP, Tomme en Raclette de Savoie IGP, yoghurt met volle melk.... Selectie van lokale producten en traditionele lokale smaken: Ijs / boerderij kazen, wijnen, vleeswaren en lokaal vlees..."
    ],
    "es": [
      "Producción y venta de Reblochon DOP, Beaufort DOP, Tomme y Raclette de Savoie IGP, yogures de leche entera.... Selección de productos locales y sabores tradicionales de la región: helados y quesos de granja, vinos, embutidos y carnes locales..."
    ]
  },
