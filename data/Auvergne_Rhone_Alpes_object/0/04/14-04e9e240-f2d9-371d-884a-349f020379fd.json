      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag: 7:00 - 13:00 Uhr / 15:30 - 19:00 Uhr\nSamstag: 7:00 - 14:00 Uhr\nsonntag: 7:30 - 12:30 Uhr\n\nWöchentliche Schließung am Dienstag.\n \n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday: 7am - 1pm / 3:30pm - 7pm\nSaturday: 7am - 2pm\nsunday: 7:30am - 12:30pm\n\nWeekly closing on Tuesday.\n \n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a venerdì: 7.00-13.00 / 15.30-19.00\nSabato: dalle 7.00 alle 14.00\ndomenica: 7.30 - 12.30\n\nChiuso il martedì.\n \n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu lundi au vendredi : 7h - 13h / 15h30 - 19h\nLe samedi : 7h - 14h\nle dimanche : 7h30 - 12h30\n\nFermeture hebdomadaire le mardi.\n \n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag: 7u - 13u / 15u30 - 19u\nZaterdag: 7u - 14u\nzondag: 7.30 - 12.30 uur\n\nDinsdag gesloten.\n \n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes: de 7.00 h. a 13.00 h. / de 15.30 h. a 19.00 h\nSábado: de 7.00 h. a 14.00 h\ndomingo: 7.30 h - 12.30 h\n\nMartes cerrado.\n \n "
        ]
