  "rdfs:comment": {
    "de": [
      "Dieses Chalet aus Stein mit Kaminecke, Terrasse, großem Saal mit Panoramablick auf das Tal und die Gipfel bietet Ihnen eine traditionelle oder schnelle, hausgemachte Küche. Für Fußgänger leicht mit der Gondelbahn zu erreichen."
    ],
    "en": [
      "This stone chalet with fireplace, terrace and large panoramic room overlooking the valley and peaks offers traditional or fast cuisine. Easy gondola access for pedestrians."
    ],
    "it": [
      "Questo chalet in pietra, con camino, terrazza e ampia sala panoramica con vista sulla valle e sulle cime, offre una cucina casalinga tradizionale o veloce. Facile accesso pedonale con la gondola."
    ],
    "fr": [
      "Ce chalet en pierre avec coin cheminée, terrasse, grande salle panoramique sur la vallée et les sommets, vous propose une cuisine traditionnelle ou rapide, faite maison. Facile d'accès par télécabine pour les piétons."
    ],
    "es": [
      "Este chalet de piedra, con chimenea, terraza y gran sala panorámica con vistas al valle y las cumbres, ofrece cocina casera tradicional o rápida. Fácil acceso peatonal en telecabina."
    ],
    "nl": [
      "Dit stenen chalet met open haard, terras en grote panoramische kamer met uitzicht op de vallei en de bergtoppen biedt een traditionele of snelle keuken. Gemakkelijke toegang voor voetgangers met de gondel."
    ]
  },
