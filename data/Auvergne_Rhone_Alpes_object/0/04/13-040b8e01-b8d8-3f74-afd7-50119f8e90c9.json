  "rdfs:comment": {
    "de": [
      "Bemerkenswertes Klettergebiet in natürlicher Umgebung in den Schluchten des Bès. Ausgestattete Sektoren; 75 Routen, von 3 bis 8 plus TA. Klettern: Technik über Platten, Dieder, Risse auf porphyroidem Granit."
    ],
    "en": [
      "Remarkable natural climbing site in the Bès gorges. Equipped sectors; 75 routes, from 3 to 8 plus TA. Technical climbing on slabs, dihedrals and cracks on porphyroid granite."
    ],
    "it": [
      "Notevole sito di arrampicata naturale nelle gole di Bès. Settori attrezzati; 75 vie, dal 3 all'8 più TA. Arrampicata tecnica su placche, diedri e fessure di granito porfirico."
    ],
    "fr": [
      "Site remarquable d’escalade en milieu naturel dans les gorges du Bès. Secteurs équipés ; 75 voies, du 3 au 8 plus TA. Escalade : technique sur dalles, dièdres, fissures sur granit porphyroïde."
    ],
    "nl": [
      "Opmerkelijk natuurlijk klimgebied in de kloven van Bès. Uitgeruste sectoren; 75 routes, van 3 tot 8 plus TA. Technisch klimmen op platen, dihedralen en scheuren op porfierisch graniet."
    ],
    "es": [
      "Notable sitio natural de escalada en las gargantas de Bès. Sectores equipados; 75 vías, de 3 a 8 más TA. Escalada técnica en placas, diedros y fisuras de granito porfiroide."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site d'escalade des gorges du Bès"
    ]
  },
