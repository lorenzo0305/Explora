  "rdfs:comment": {
    "de": [
      "Fotograf in St Martin de Valamas, ich mache Porträtfotos im Studio oder draußen nach Vereinbarung, Landschafts- und Dorffotos, Fotos von Flora und Fauna, Souvenirs aus der Ardèche: Tischsets, Magnete, Schlüsselanhänger, Postkarten, Lesezeichen?"
    ],
    "en": [
      "Photographer in St Martin de Valamas, I take studio portraits by appointment, landscape photos, photos of villages, flora, fauna, memories of the Ardèche..."
    ],
    "it": [
      "Come fotografo a St Martin de Valamas, posso realizzare ritratti in studio o in loco su appuntamento, ma anche foto di paesaggi, villaggi, flora e fauna e souvenir dell'Ardèche: tovagliette, calamite, portachiavi, cartoline, segnalibri?"
    ],
    "fr": [
      "Photographe à St Martin de Valamas, je réalise du portrait en studio ou en extérieur sur rendez-vous, des photos de paysages, de villages, de flore, de faune, des souvenirs d'Ardèche : sets de table, magnets, porte-clés, cartes postales, marque-pages…"
    ],
    "es": [
      "Como fotógrafo en St Martin de Valamas, puedo hacer retratos en estudio o en exteriores con cita previa, así como fotos de paisajes, pueblos, flora y fauna, y recuerdos de Ardèche: manteles individuales, imanes, llaveros, postales, marcapáginas.."
    ],
    "nl": [
      "Als fotograaf in St Martin de Valamas kan ik op afspraak portretten maken in de studio of op locatie, maar ook foto's van landschappen, dorpen, flora en fauna, en Ardèche-souvenirs: placemats, magneten, sleutelhangers, ansichtkaarten, boekenleggers?"
    ]
  },
