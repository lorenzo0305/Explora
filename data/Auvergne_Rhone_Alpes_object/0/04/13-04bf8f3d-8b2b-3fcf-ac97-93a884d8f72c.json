  "rdfs:comment": {
    "de": [
      "Im Herzen der 3 Täler in Méribel Mottaret ist das Mont Vallon ein 4-Sterne-Ski-in/Ski-out-Hotel. Es beherbergt wunderschöne Lounges, eine Pianobar, ein Restaurant, eine Brasserie, komfortable Zimmer und Suiten, ein Penthouse, Seminarräume und einen Wellnessbereich."
    ],
    "en": [
      "In the heart of the \"3 vallées\" the bigger ski area of the world, enjoy our ski-in & ski-out 4* hotel Mont Vallon in Meribel Mottaret. Cozy lounges, piano-bar, brasserie, restaurant, comfortable rooms and suites, penthouse, wellness center, seminar and group reception areas."
    ],
    "it": [
      "Nel cuore delle 3 Valli di Méribel Mottaret, il Mont Vallon è un hotel 4* con accesso diretto alle piste da sci. Ospita splendidi saloni, un piano bar, un ristorante, una brasserie, confortevoli camere e suite, un attico, sale per seminari e un'area benessere."
    ],
    "fr": [
      "Au cœur des 3 Vallées à Méribel Mottaret, le Mont Vallon un hôtel 4* skis aux pieds. Il abrite de beaux salons, un piano-bar, un restaurant, une brasserie, des chambres et suites tout confort, un penthouse, des salles de séminaire et un espace bien-être."
    ],
    "nl": [
      "In het hart van de 3 Valleien in Méribel Mottaret is het Mont Vallon een 4* hotel met ski's aan. Het beschikt over mooie salons, een bar, open haard, restaurant, brasserie, kamers en suites met alle comfort, seminariezalen en een wellnessruimte."
    ],
    "es": [
      "En el corazón de los 3 Valles, en Méribel Mottaret, el Mont Vallon es un hotel de 4 estrellas con acceso directo a las pistas de esquí. Cuenta con hermosos salones, un piano bar, un restaurante, una brasserie, cómodas habitaciones y suites, un ático, salas para seminarios y una zona de bienestar."
    ]
  },
