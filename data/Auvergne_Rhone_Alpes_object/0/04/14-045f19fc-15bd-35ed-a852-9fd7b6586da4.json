  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/566ebc00-b174-3548-9ec7-7936ddd0a287",
      "dc:description": {
        "de": [
          "Freitag, 20. Februar\n--------------------------------------\nAktivität: Wandern und Sammeln, angeboten von der Abteilung Animation des Rathauses von Merlimont\nTreffpunkt: Fremdenverkehrsamt Merlimont, von 15:00 bis 16:00 Uhr\nKostenlos und offen für alle\n\nSie können sich beim Service Animation im Office de Tourisme de Merlimont anmelden: 70 Avenue du Centre in Merlimont, Montag bis Freitag von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Friday, February 20\n--------------------------------------\nActivity: Walk and Pick-up proposed by the Service Animation of the Mairie de Merlimont\nMeet at Merlimont Tourist Office, from 3pm to 4pm\nFree and open to all\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Venerdì 20 febbraio\n--------------------------------------\nAttività: Passeggiata e collezionismo a cura dell'Assessorato alle Manifestazioni del Comune di Merlimont\nRitrovo presso l'Ufficio del Turismo di Merlimont, dalle 15.00 alle 16.00\nGratuito e aperto a tutti\n\nÈ possibile iscriversi presso il servizio di animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Vendredi 20 Février\n--------------------------------------\nActivité : Marche et Ramasse proposée par le Service Animation de la Mairie de Merlimont\nRendez-vous à l'Office de Tourisme de Merlimont, de 15h à 16h\nGratuit et ouvert à tous\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Vrijdag 20 februari\n--------------------------------------\nActiviteit: Wandelen en verzamelen aangeboden door de dienst evenementen van het gemeentebestuur van Merlimont\nAfspraak aan de Dienst voor Toerisme van Merlimont, van 15u tot 16u\nGratis en open voor iedereen\n\nU kunt zich inschrijven bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Viernes 20 de febrero\n--------------------------------------\nActividad: Pasear y coleccionar ofrecida por el Departamento de Eventos del Ayuntamiento de Merlimont\nCita en la Oficina de Turismo de Merlimont, de 15.00 a 16.00 horas\nGratuito y abierto a todos\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
