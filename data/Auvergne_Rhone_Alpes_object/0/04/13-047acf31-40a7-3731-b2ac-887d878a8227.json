  "rdfs:comment": {
    "de": [
      "LE CHALET hat sich zum ASIAN CHALET umgestaltet.\r\nEntdecken Sie unsere thailändische Speisekarte mit Frühlingsrollen, Frühlingsrollen, Pas Thai, sautiertem Reis, Poke Bowl, Suppe, Mango Stick Rice....."
    ],
    "en": [
      "LE CHALET has been transformed into ASIAN CHALET.\r\nCome and discover our Thai menu with nems, spring rolls, Pas Thaï, stir-fried rice, poke bowl, soup, mango stick rice...."
    ],
    "it": [
      "LE CHALET si è trasformato in ASIAN CHALET.\r\nVenite a scoprire il nostro menu thailandese con nems, involtini primavera, Pas Thaï, riso saltato in padella, poke bowl, zuppa, riso con bastoncini di mango...."
    ],
    "fr": [
      "LE CHALET s'est fait une beauté pour devenir ASIAN CHALET.\r\nVenez découvrir notre carte Thaïlandaise avec nos nems, rouleaux de printemps, Pas Thaï, riz sauté, poke bowl, soupe, mango stick rice...."
    ],
    "es": [
      "LE CHALET se transforma en ASIAN CHALET.\r\nVenga a descubrir nuestro menú tailandés con nems, rollitos de primavera, Pas Thaï, arroz salteado, poke bowl, sopa, arroz con palo de mango...."
    ],
    "nl": [
      "LE CHALET heeft een make-over gehad en is nu ASIAN CHALET.\r\nKom en ontdek onze Thaise kaart met nems, loempia's, Pas Thaï, roergebakken rijst, poke bowl, soep, mangosticks rijst...."
    ]
  },
