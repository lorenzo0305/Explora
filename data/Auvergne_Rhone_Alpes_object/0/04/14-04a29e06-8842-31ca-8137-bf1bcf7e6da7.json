  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa02ee0f-bfc6-3f45-a6fc-c1c2c6cbd714",
      "dc:description": {
        "de": [
          "Das Rathaus der Stadt ? Freie Besichtigung\n\nBesuchen Sie die historischen Räume, den japanischen Garten und die mit der Stadt verbundenen Gemälde."
        ],
        "en": [
          "Town Hall ? Self-guided tour\n\nVisit the historic rooms, the Japanese garden and the paintings related to the town."
        ],
        "it": [
          "Il municipio? Visita guidata\n\nVisitate le sale storiche, il giardino giapponese e i dipinti relativi alla città."
        ],
        "fr": [
          "L’Hôtel de Ville – Visite libre\n\nVisite des salles historiques, du jardin japonais et des tableaux liés à la ville."
        ],
        "nl": [
          "Stadhuis ? Zelf rondleiding\n\nBezoek de historische kamers, de Japanse tuin en de schilderijen die betrekking hebben op de stad."
        ],
        "es": [
          "Ayuntamiento ? Visita autoguiada\n\nVisite las salas históricas, el jardín japonés y los cuadros relacionados con la ciudad."
        ]
      },
