  "rdfs:comment": {
    "de": [
      "Country-Tanzkurs für Anfänger und Fortgeschrittene, geleitet von Alain Thomas und anderen Freiwilligen, im Saal des Mille Club neben der Feuerwache in Langeac. Auch in Saugues findet ein Kurs statt."
    ],
    "en": [
      "Country dance classes for beginners or advanced, led by Alain Thomas and other volunteers, at the Salle du Mille Club next to the Langeac fire station. There's also a class in Saugues."
    ],
    "it": [
      "Corsi di danza country per principianti e avanzati condotti da Alain Thomas e altri volontari, presso il Club Salle du Mille vicino alla stazione dei pompieri di Langeac. C'è anche un corso a Saugues."
    ],
    "fr": [
      "Cours de danse Country pour débutant ou confirmé animé par Alain Thomas et d'autres bénévoles, à la salle du Mille Club à côté de la caserne des pompiers de Langeac. Un cours à Saugues également."
    ],
    "nl": [
      "Countrydanslessen voor beginners en gevorderden onder leiding van Alain Thomas en andere vrijwilligers, in de Salle du Mille Club naast de brandweerkazerne van Langeac. Er is ook een les in Saugues."
    ],
    "es": [
      "Clases de baile country para principiantes y avanzados, dirigidas por Alain Thomas y otros voluntarios, en el club Salle du Mille, junto al parque de bomberos de Langeac. También hay clases en Saugues."
    ]
  },
  "rdfs:label": {
    "fr": [
