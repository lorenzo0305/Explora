  "rdfs:comment": {
    "de": [
      "Vélo'box ist ein individueller oder kollektiver Schließfachservice, ideal für die Kombination von Busfahrten / Auto + Fahrrad.\r\n\r\nEine Station: Maison des Associations.\r\n\r\nAbonnement in der Citéa-Agentur in Valence, Reservierungsmöglichkeit unter 04 75 600 626."
    ],
    "en": [
      "Vélo'box is an individual or collective locker service, ideal for combining bus / car + bike travel.\r\n\r\nOne station: Maison des Associations.\r\n\r\nSubscription at the Valence Citéa agency, reservation possible on 04 75 600 626."
    ],
    "it": [
      "Vélo?box è un servizio di armadietto individuale o collettivo, ideale per combinare viaggi in autobus/auto + bici.\r\n\r\nUna stazione: Maison des Associations.\r\n\r\nAbbonamento presso l'agenzia Valence Citéa, prenotazione possibile al numero 04 75 600 626."
    ],
    "fr": [
      "Vélo’box est un service de consigne individuelle ou collective, idéal pour combiner déplacements en bus / voiture + vélo.\r\n\r\nUne station : Maison des Associations.\r\n\r\nSouscription en agence Citéa de Valence, possibilité de réservation au 04 75 600 626."
    ],
    "es": [
      "Vélo?box es un servicio de consigna individual o colectiva, ideal para combinar viajes en autobús / coche + bicicleta.\r\n\r\nUna estación: Maison des Associations.\r\n\r\nInscripción en la agencia Valence Citéa, posibilidad de reserva en el 04 75 600 626."
    ],
    "nl": [
      "Vélo'box is een individuele of collectieve lockerservice, ideaal voor het combineren van bus / auto + fiets reizen.\r\n\r\nEén station: Maison des Associations.\r\n\r\nInschrijving in het filiaal Valence Citéa, reservering mogelijk op 04 75 600 626."
    ]
  },
  "rdfs:label": {
