  "rdfs:comment": {
    "de": [
      "Treten Sie in den Verkaufsstand ein und lassen Sie sich in die Welt des Mittelalters entführen! Entdecken Sie unseren handwerklich hergestellten Hypocras, Fruchtpasten und andere mittelalterliche Köstlichkeiten, die vor Ort mit Liebe hergestellt werden."
    ],
    "en": [
      "Step into our shop and let yourself be transported into a medieval world! Discover our artisanal Hypocras, fruit jellies and other medieval delights, lovingly crafted on site."
    ],
    "it": [
      "Entrate nel nostro negozio e lasciatevi trasportare nel mondo del Medioevo! Scoprite le nostre Ipocras fatte in casa, le gelatine di frutta e altre delizie medievali, prodotte con amore in loco."
    ],
    "fr": [
      "Entrez dans l'échoppe et laissez-vous transporter dans l'univers médiéval ! Découvrez notre Hypocras artisanal, pâtes de fruits et autres délices médiévaux, fabriqués sur place avec amour."
    ],
    "nl": [
      "Stap onze winkel binnen en laat je meevoeren naar de wereld van de middeleeuwen! Ontdek onze zelfgemaakte Hypocras, vruchtengelei en andere middeleeuwse lekkernijen, met liefde ter plekke gemaakt."
    ],
    "es": [
      "Entre en nuestra tienda y déjese transportar al mundo de la Edad Media Descubra nuestras Hypocras caseras, gelatinas de frutas y otras delicias medievales, elaboradas con esmero in situ."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Échoppe médiévale - Au Chaudron Percé"
    ]
  },
