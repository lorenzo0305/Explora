  "rdfs:comment": {
    "de": [
      "Große Auswahl an Produkten für Genießer. Auf Kaviar und Trüffel spezialisiertes Lebensmittelgeschäft mit einem Angebot an Weinen und Spirituosen. Lokale Produkte und Wurstwaren aus aller Welt. Verkostungsraum im Laden und regelmäßige Themenabende zur Verkostung."
    ],
    "en": [
      "Wide range of products for Epucureans. Grocery specializing in caviar and truffles, with a range of wines and spirits. Local products and charcuterie from around the world. In-store tasting area and regular themed tasting evenings."
    ],
    "it": [
      "Un'ampia gamma di prodotti per gli epicurei. Drogheria specializzata in caviale e tartufi, con una gamma di vini e liquori. Prodotti locali e salumi da tutto il mondo. Area di degustazione nel negozio e serate di degustazione a tema."
    ],
    "fr": [
      "Large gamme de produits à destination des épicuriens. Epicerie  spécialisée caviars et truffes avec une offre de vins et spiritueux. Produits locaux et charcuterie du monde. Espace dégustation dans le magasin et soirées dégustation à thème régulières."
    ],
    "es": [
      "Una amplia gama de productos para epicúreos. Tienda de comestibles especializada en caviar y trufas, con una gama de vinos y licores. Productos locales y charcutería de todo el mundo. Zona de degustación en la tienda y degustaciones temáticas regulares."
    ],
    "nl": [
      "Een breed scala aan producten voor levensgenieters. Kruidenierszaak gespecialiseerd in kaviaar en truffels, met een assortiment wijnen en sterke dranken. Lokale producten en vleeswaren uit de hele wereld. Proefruimte in de winkel en regelmatig thematische proefavonden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Distrilux House"
    ],
    "fr": [
      "Maison Distrilux"
    ]
  },
