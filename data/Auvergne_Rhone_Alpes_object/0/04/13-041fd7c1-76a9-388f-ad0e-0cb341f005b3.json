  "rdfs:comment": {
    "de": [
      "ROCK THE PISTES, EIN UNGEWÖHNLICHES POP/ROCK-FESTIVAL IM HERZEN DER SKIPISTEN VON PORTES DU SOLEIL.\r\nDas Rock the Pistes Festival ist ein einzigartiges Festival. Jeden Tag Live-Konzerte auf den Skipisten, mitten in den Bergen. Internationale Künstler."
    ],
    "en": [
      "ROCK THE PISTES, UNUSUAL POP/ROCK FESTIVAL IN THE HEART OF THE PORTES DU SOLEIL SKI SLOPES.\r\nThe Rock the Pistes festival is a unique festival. Every day, live concerts on the ski slopes, in the middle of the mountain. International artists."
    ],
    "it": [
      "ROCK THE PISTES, UN INSOLITO FESTIVAL POP/ROCK NEL CUORE DELLE PISTE DA SCI DI PORTES DU SOLEIL.\r\nIl festival Rock the Pistes è un festival unico nel suo genere. Ogni giorno, concerti dal vivo di artisti internazionali sulle piste da sci, in mezzo alle montagne."
    ],
    "fr": [
      "ROCK THE PISTES, FESTIVAL POP/ ROCK INSOLITE AU CŒUR DES PISTES DE SKI DES PORTES DU SOLEIL.\r\nLe festival Rock the Pistes est un festival unique. Chaque jour, des concerts live d'artistes internationaux sur les pistes de ski, en pleine montagne."
    ],
    "es": [
      "ROCK THE PISTES, UN INUSUAL FESTIVAL DE POP/ROCK EN EL CORAZÓN DE LAS PISTAS DE ESQUÍ DE PORTES DU SOLEIL.\r\nEl festival Rock the Pistes es un festival único. Todos los días, conciertos en directo de artistas internacionales en las pistas de esquí, en plena montaña."
    ],
    "nl": [
      "Het Rock the Pistes Festival is uniek in Europa. Iedere dag live concerten van internationale artiesten, midden op de skipistes."
    ]
  },
