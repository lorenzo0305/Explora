  "rdfs:comment": {
    "de": [
      "Jean-Philippe und sein Team bieten Ihnen eine regionale Küche mit Produkten vom Bauernhof: Schweinefleisch, Lammfleisch und Gemüse... (zum Mitnehmen und Essen auf Bestellung)"
    ],
    "en": [
      "Jean-Philippe and his team offer you local cuisine using products from the farm: pork, lamb and vegetables e..(takeaway & meals on order)"
    ],
    "it": [
      "Jean-Philippe e il suo team vi propongono una cucina locale a base di prodotti della fattoria: maiale, agnello e verdure...(piatti da asporto e su ordinazione)"
    ],
    "fr": [
      "Jean-Philippe et toute son équipe vous proposent une cuisine du terroir utilisant  certains produits de la ferme : porc, agneau  et légumes e..(à emporter & portage repas sur commande)"
    ],
    "es": [
      "Jean-Philippe y su equipo le proponen una cocina local a base de productos de la granja: cerdo, cordero y verduras...(comida para llevar y por encargo)"
    ],
