  "rdfs:comment": {
    "de": [
      "Wir entwickeln und vermarkten eine Reihe von Gourmet-Zubereitungen, die zu 100 % pflanzlich sind (auf der Grundlage von Kichererbsen und Gemüse), proteinreich, glutenfrei, schmackhaft und einfach zu kochen sind."
    ],
    "en": [
      "We develop and sell a range of 100% vegetable-based gourmet preparations (based on Ardèche chickpeas and vegetables) that are rich in protein, gluten-free, tasty and easy to cook."
    ],
    "it": [
      "Sviluppiamo e commercializziamo una gamma di preparati gastronomici 100% vegetali (a base di ceci e verdure) ricchi di proteine, privi di glutine, gustosi e facili da cucinare."
    ],
    "fr": [
      "Nous élaborons et commercialisons une gamme de préparations gourmandes 100% végétales (à base de pois chiches et de légumes), riches en protéines, sans gluten, savoureuses et faciles à cuisiner."
    ],
    "nl": [
      "We ontwikkelen en verkopen een assortiment 100% plantaardige gastronomische bereidingen (op basis van kikkererwten en groenten) die rijk zijn aan eiwitten, glutenvrij, smakelijk en gemakkelijk te bereiden."
    ],
    "es": [
      "Desarrollamos y comercializamos una gama de preparados gourmet 100% vegetales (a base de garbanzos y verduras) ricos en proteínas, sin gluten, sabrosos y fáciles de cocinar."
    ]
  },
