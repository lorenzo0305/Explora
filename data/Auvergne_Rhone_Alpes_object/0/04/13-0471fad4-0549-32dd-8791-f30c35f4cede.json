  "rdfs:comment": {
    "de": [
      "Wir sind seit über 40 Jahren in Brioude (Haute-Loire) im Herzen der Auvergne ansässig und bieten Ihnen eine große Auswahl an Motorsportausrüstung und Anhängern der bekanntesten Marken."
    ],
    "en": [
      "Based in Brioude (Haute-Loire), in the heart of the Auvergne, for more than 40 years, we offer a wide range of motorized recreational equipment and trailers in the biggest brands."
    ],
    "it": [
      "Con sede a Brioude (Haute-Loire), nel cuore dell'Alvernia, da oltre 40 anni, offriamo un'ampia gamma di attrezzature per moto da diporto e rimorchi delle principali marche."
    ],
    "fr": [
      "Installés à Brioude (Haute-Loire), au cœur de l'Auvergne, depuis plus de 40 ans, nous vous proposons une large gamme de matériel de motoculture de plaisance et de remorques dans les plus grandes marques."
    ],
    "es": [
      "Con sede en Brioude (Haute-Loire), en el corazón de Auvergne, desde hace más de 40 años, ofrecemos una amplia gama de equipamiento para motos de recreo y remolques de las principales marcas."
    ],
    "nl": [
      "Al meer dan 40 jaar gevestigd in Brioude (Haute-Loire), in het hart van de Auvergne, bieden wij een breed scala aan recreatieve motoruitrusting en aanhangwagens van de toonaangevende merken."
    ]
  },
  "rdfs:label": {
