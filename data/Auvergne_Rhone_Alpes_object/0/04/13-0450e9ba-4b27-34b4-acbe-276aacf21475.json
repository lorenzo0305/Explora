  "rdfs:comment": {
    "de": [
      "Buchen Sie einen Moment der Entspannung mit Camille, unserer Masseurin.\r\nWellnessbereich, regenerierende, entspannende, belebende Massage...\r\nSie müssen nur noch Ihre Skier abstellen, um davon zu profitieren!"
    ],
    "en": [
      "Book a moment of relaxation with Camille, our physiotherapist. \r\nWellness area, rejuvenating, relaxing, invigorating massage...\r\nJust drop off your skis to enjoy!"
    ],
    "it": [
      "Prenota un momento di relax con Maxime, il nostro fisioterapista. \r\nArea benessere, massaggio rigenerante, rilassante, rinvigorente...\r\nTutto quello che devi fare è posare gli sci per godertelo!"
    ],
    "fr": [
      "Réservez un moment de détente avec Camille, notre masseuse. \r\nEspace bien-être, massage ressourçant, relaxant, revigorant...\r\nIl n'y a plus qu'à déposer vos skis pour en profiter !"
    ],
    "es": [
      "Reserve un momento de relajación con Camille, nuestra masajista.\r\nEspacio bienestar, masaje rejuvenecedor, relajante, tonificante...\r\nSólo tiene que dejar los esquís y disfrutar"
    ],
    "nl": [
      "Boek een moment van ontspanning met Camille, onze masseuse.\r\nWellnessruimte, verjongende, ontspannende, verkwikkende massage...\r\nJe hoeft alleen maar je ski's neer te leggen en te genieten!"
    ]
  },
