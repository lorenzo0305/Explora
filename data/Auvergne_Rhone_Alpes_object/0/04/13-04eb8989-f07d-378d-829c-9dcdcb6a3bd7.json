  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant Le Saint-Nazaire liegt am Bourne-See zwischen Isère und Drôme, am Eingang des Regionalen Naturparks Vercors, auf Ihrer Geschäfts- oder Urlaubsroute."
    ],
    "en": [
      "Le Saint-Nazaire hotel-restaurant is located on Lac de la Bourne between Isère and Drôme, at the entrance to the Vercors Regional Nature Park, on your business or vacation itinerary."
    ],
    "it": [
      "L'hotel-ristorante Le Saint-Nazaire si trova sul Lac de la Bourne, tra Isère e Drôme, all'ingresso del Parco Naturale Regionale del Vercors, nel vostro itinerario di lavoro o di vacanza."
    ],
    "fr": [
      "L'hôtel-restaurant Le Saint-Nazaire est situé sur le lac de la Bourne entre Isère et Drôme, à l'entrée du Parc Naturel Régional du Vercors, sur votre itinéraire professionnel ou de vacances."
    ],
    "nl": [
      "Hotel-restaurant Le Saint-Nazaire ligt aan het Lac de la Bourne tussen Isère en Drôme, bij de ingang van het Regionale Natuurpark Vercors, op uw zakenreis of vakantiebestemming."
    ],
    "es": [
      "El hotel-restaurante Le Saint-Nazaire está situado en el lago de la Bourne, entre Isère y Drôme, a la entrada del Parque Natural Regional de Vercors, en su itinerario de negocios o de vacaciones."
