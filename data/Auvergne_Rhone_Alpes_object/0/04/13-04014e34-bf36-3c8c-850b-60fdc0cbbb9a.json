  "rdfs:comment": {
    "de": [
      "Le comptoir du Pied de la Lettre ist der Weinkeller von Grignan, in dem Sie eine Weinprobe machen und die besten Weine der Region kaufen können (300 Bio-Weine), wo Sie einen schnellen Imbiss zu sich nehmen und handverlesene handwerkliche Produkte kaufen können."
    ],
    "en": [
      "The Comptoir du Pied de la Lettre is the place in Grignan where you can taste and buy the best wines in the region (300 organic references), where you can grab a bite to eat and buy hand-picked artisanal products ."
    ],
    "it": [
      "Le comptoir du Pied de la Lettre è l'enoteca di Grignan, dove è possibile degustare e acquistare i migliori vini della regione (300 referenze biologiche), fare spuntini e acquistare prodotti artigianali raccolti a mano."
    ],
    "fr": [
      "Le comptoir du Pied de la Lettre, c'est la cave de Grignan où faire une dégustation et acheter les meilleurs vins de la région (300 références en bio), où grignoter un morceau sur le pouce et acheter des produits artisanaux triés sur le volet."
    ],
    "nl": [
      "Le comptoir du Pied de la Lettre is de wijnkelder van Grignan, waar je de beste wijnen van de streek (300 biologische referenties) kunt proeven en kopen, onderweg kunt knabbelen en handgemaakte ambachtelijke producten kunt kopen."
    ],
    "es": [
      "Le comptoir du Pied de la Lettre es la bodega de Grignan, donde podrá degustar y comprar los mejores vinos de la región (300 referencias ecológicas), picar algo sobre la marcha y adquirir productos artesanales recogidos a mano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir du Pied de la Lettre"
    ]
  },
