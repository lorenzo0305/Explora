  "rdfs:comment": {
    "de": [
      "Wir stellen handgemachte Seifen im Kaltverseifungsverfahren her, außerdem natürliche Pflegeprodukte und Duftkerzen aus Pflanzenwachs."
    ],
    "en": [
      "We make handmade soaps using the cold saponification method, as well as natural skincare products and scented candles in vegetable wax."
    ],
    "it": [
      "Produciamo saponi artigianali con il metodo della saponificazione a freddo, oltre a prodotti naturali per la cura della pelle e candele profumate in cera vegetale."
    ],
    "fr": [
      "Nous fabriquons des savons à la main en méthode de saponification à froid, ainsi que des produits de soins naturels et des bougies parfumées en cire végétale."
    ],
    "nl": [
      "We maken handgemaakte zepen volgens de koude verzepingsmethode, evenals natuurlijke huidverzorgingsproducten en geurkaarsen van plantaardige was."
    ],
    "es": [
      "Fabricamos jabones artesanales mediante el método de saponificación en frío, así como productos naturales para el cuidado de la piel y velas perfumadas de cera vegetal."
    ]
  },
