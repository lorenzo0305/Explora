  "rdfs:comment": {
    "de": [
      "Le C?ur d'Or, auf 1525 m in Combloux gelegen.\r\nHöhenrestaurant auf den Pisten im Winter (an der Ankunft der Seilbahn von Beauregard) und auf den Wanderwegen im Sommer (in 30 - 45 Minuten vom Parkplatz von Cuchet aus)."
    ],
    "en": [
      "Le Cœur d'Or, located at 1525 m in Combloux.\r\nHigh-altitude restaurant on the slopes in winter (at the arrival of the Beauregard gondola) and on the hiking trails in summer (30 - 45 minutes from the Cuchet parking lot)."
    ],
    "it": [
      "Ristorante sulle piste in inverno (accessibile con la gondola di Beauregard) e sui sentieri di escursioni in estate (in 30 - 45 minuti dal parcheggio di Cuchet).\r\nSerata con salita e discesa in attrezzi, su prenotazione."
    ],
    "fr": [
      "Le Cœur d'Or, situé à 1525 m à Combloux.\r\nRestaurant d'altitude sur les pistes en hiver (à l'arrivée du télécabine de Beauregard) et sur les sentiers de randonnées l'été (en 30 - 45 minutes depuis le parking de Cuchet)."
    ],
    "es": [
      "Le Coeur d'Or, situado a 1525 m en Combloux.\r\nRestaurante de altitud en las pistas en invierno (accesible por la góndola de Beauregard) y en las rutas de senderismo en verano (en 30 - 45 minutos desde el aparcamiento de Cuchet.)"
    ],
    "nl": [
      "Le C?ur d'Or, gelegen op 1525 m in Combloux.\r\nRestaurant op grote hoogte op de pistes in de winter (bij de aankomst van de Beauregard kabelbaan) en op de wandelpaden in de zomer (30 - 45 minuten van de Cuchet parkeerplaats)."
    ]
  },
