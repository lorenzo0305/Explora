  "rdfs:comment": {
    "de": [
      "Das Café-Restaurant-Brasserie le Napoléon liegt im Herzen der Stadt und ist leicht zu erreichen. In einem schönen, kürzlich renovierten Herrenhaus können Sie eine regionale Küche mit frischen Produkten genießen."
    ],
    "en": [
      "Located in the heart of the city, easy access, the Café-Restaurant-Brasserie le Napoléon offers you the opportunity to taste local cuisine with fresh products, in a beautiful recently renovated residence."
    ],
    "it": [
      "Situato nel cuore della città, di facile accesso, il Café-Restaurant-Brasserie le Napoléon vi offre di gustare una cucina locale con prodotti freschi, in una bella casa recentemente ristrutturata."
    ],
    "fr": [
      "Situé en plein cœur de ville, facile d’accès, le Café-Restaurant-Brasserie le Napoléon vous propose de déguster une cuisine de terroir avec des produits frais, dans une belle demeure récemment rénovée."
    ],
    "es": [
      "Situado en el corazón de la ciudad, de fácil acceso, el Café-Restaurante-Brasserie le Napoléon le ofrece degustar una cocina local con productos frescos, en una hermosa casa recientemente renovada."
    ],
    "nl": [
      "Het Café-Restaurant-Brasserie le Napoléon, gelegen in het hart van de stad en gemakkelijk bereikbaar, biedt u de mogelijkheid een lokale keuken met verse producten te proeven, in een prachtig, onlangs gerenoveerd huis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Brasserie Restaurant Le Napoléon"
    ]
  },
