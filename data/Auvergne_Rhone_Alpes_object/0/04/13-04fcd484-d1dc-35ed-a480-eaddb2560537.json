  "rdfs:comment": {
    "de": [
      "Saisonale, großzügige und elegante Küche für ein zugängliches Gourmet-Mittagessen in einem gemütlichen Rahmen.\r\nGepflegte und kreative Teller, die die Aromen der Region und die bei unseren Erzeugern ausgewählten Qualitätsprodukte hervorheben."
    ],
    "en": [
      "Generous, elegant seasonal cuisine for an affordable, gourmet lunch in warm surroundings.\r\nMeticulous, creative dishes that highlight local flavors and quality products selected from our producers."
    ],
    "it": [
      "Una cucina generosa, elegante e di stagione per un pranzo gourmet a prezzi accessibili in un ambiente accogliente.\r\nPiatti curati e creativi che esaltano i sapori locali e i prodotti di qualità selezionati dai nostri produttori."
    ],
    "fr": [
      "Cuisine de saison, généreuse et élégante pour un déjeuner gourmand et accessible dans un cadre chaleureux.\r\nDes assiettes soignées et créatives, qui mettent en valeur les saveurs du terroir et les produits de qualité sélectionnés auprès de nos producteurs."
    ],
    "nl": [
      "Royale, elegante, seizoensgebonden gerechten voor een betaalbare, gastronomische lunch in een warme omgeving.\r\nZorgvuldige, creatieve gerechten met lokale smaken en kwaliteitsproducten van onze producenten."
    ],
    "es": [
      "Cocina generosa, elegante y de temporada para un almuerzo asequible y gourmet en un entorno cálido.\r\nPlatos cuidados y creativos que ponen de relieve los sabores locales y los productos de calidad seleccionados entre nuestros productores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Maison Cellard"
    ]
  },
