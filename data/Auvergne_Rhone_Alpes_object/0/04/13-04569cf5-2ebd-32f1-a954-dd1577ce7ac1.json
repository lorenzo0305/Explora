  "rdfs:comment": {
    "de": [
      "Röstung, Verkauf von Produkten zum Thema Kaffee und Tee.\r\nDas Extra: im Gebiet von Vienne Condrieu einmalig. Hochwertige Kaffeesorten mit traditioneller Röstung direkt vor Ort. Zahlreiche Kaffee- und Teesorten aus der ganzen Welt."
    ],
    "en": [
      "A point of sale for regional produce alongside the departmental road. Here you can find cooked meats, cheese, organic and traditional vegetables, bread, fruit, wine and meat. Something extra: customers are welcomed by a farmer."
    ],
    "it": [
      "Torrefazione e vendita di prodotti a base di caffè e tè.\r\nVantaggi: storia nella zona di Vienne-Condrieu. Selezione accurata dei caffè verdi prima della tostatura in casa. Ampia gamma di caffè e tè provenienti da tutto il mondo."
    ],
    "fr": [
      "Torréfaction, vente de produits sur le thème du café et du thé.\r\nLes plus : historique sur le territoire de Vienne-Condrieu. Sélection attentive des cafés verts avant torréfaction artisanale. Nombreuses variétés de cafés et thés du monde."
    ],
    "es": [
      "Tostado y venta de productos de café y té.\r\nVentajas: historia en la zona de Vienne-Condrieu. Cuidadosa selección de cafés verdes antes del tueste a domicilio. Amplia gama de cafés y tés de todo el mundo."
    ],
    "nl": [
      "Branden en verkoop van koffie- en theeproducten.\r\nVoordelen: geschiedenis in de regio Vienne-Condrieu. Zorgvuldige selectie van groene koffie vóór het thuisbranden. Breed assortiment koffie en thee uit de hele wereld."
    ]
  },
