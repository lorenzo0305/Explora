  "rdfs:comment": {
    "de": [
      "Unsere Honigfabrik befindet sich auf dem Col du Fût d'Avenas in 762 m Höhe und bietet Ihnen die Früchte der Sammeltätigkeit unserer Bienen: mehr als 10 Honigsorten, die von uns extrahiert und in Töpfe abgefüllt werden."
    ],
    "en": [
      "Located at the Col du Fût d'Avenas, at an altitude of 762m, our honey house offers you the fruit of the foraging of our bees: more than 10 varieties of honey extracted and bottled by us."
    ],
    "it": [
      "Situata al Col du Fût d'Avenas, a 762 m di altitudine, la nostra casa del miele vi offre il frutto della raccolta delle nostre api: più di 10 varietà di miele estratto e imbottigliato da noi."
    ],
    "fr": [
      "Située au Col du Fût d’Avenas, à 762m d’altitude, notre miellerie vous propose le fruit du butinage de nos abeilles : plus de 10 variétés de miels extraits et mis en pots par nos soins."
    ],
    "es": [
      "Situada en el Col du Fût d'Avenas, a 762 m de altitud, nuestra casa de la miel le ofrece el fruto de la recolección de nuestras abejas: más de 10 variedades de miel extraídas y embotelladas por nosotros."
    ],
    "nl": [
      "Gelegen op de Col du Fût d'Avenas, op een hoogte van 762m, biedt ons honinghuis u de vruchten van de bijenverzameling: meer dan 10 soorten honing die door ons worden gewonnen en gebotteld."
    ]
  },
