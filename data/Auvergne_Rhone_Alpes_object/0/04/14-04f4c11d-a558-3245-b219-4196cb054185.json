  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08d64610-6539-3017-811c-12275283bc7e",
      "dc:description": {
        "de": [
          "Verkostung in der Nähe des Kamins!\nSamstag, den 24. Januar von 15:00 bis 17:00 Uhr\nOrt: 7 rue de la Vendée ? Attin\n---------------------------------\nKommen Sie und teilen Sie einen Moment puren Vergnügens im Warmen und plaudern Sie, lernen Sie sich kennen und erzählen Sie von unseren Plänen für 2026!\n\nInformationen/Reservierungen per SMS: 06 21 83 65 44\nCredit: Pixabay"
        ],
        "en": [
          "Tasting by the chimney!\nSaturday January 24th from 3pm to 5pm\nLocation: 7 rue de la Vendée ? Attin\n---------------------------------\nCome and share a moment of pure pleasure in the warmth, chat, get to know each other and talk about our plans for 2026!\n\nInformation/reservations by SMS: 06 21 83 65 44\nCredit: Pixabay"
        ],
        "it": [
          "Degustazione al camino!\nSabato 24 gennaio dalle 15.00 alle 17.00\nLuogo: 7 rue de la Vendée? Attin\n---------------------------------\nVenite a condividere un momento di puro piacere al calore del camino, a chiacchierare, a conoscervi e a parlare dei nostri progetti per il 2026!\n\nInformazioni/prenotazioni via SMS: 06 21 83 65 44\nCredito: Pixabay"
        ],
        "fr": [
          "Dégustation près de la Cheminée !\nSamedi 24 janvier de 15h à 17h\nLieu : 7 rue de la Vendée – Attin\n---------------------------------\nVenez partager un moment de pur plaisir au chaud et papoter, apprendre à se connaître et raconter nos projets pour 2026 !\n\nInformations/réservations par SMS : 06 21 83 65 44\nCrédit : Pixabay"
        ],
        "nl": [
          "Proeverij bij de schoorsteen!\nZaterdag 24 januari van 15u tot 17u\nLocatie: 7 rue de la Vendée ? Attin\n---------------------------------\nKom en deel een moment van puur plezier in de warmte van de open haard, maak een praatje, leer elkaar kennen en praat over onze plannen voor 2026!\n\nInformatie/reserveringen per sms: 06 21 83 65 44\nKrediet: Pixabay"
        ],
        "es": [
          "Degustación junto a la chimenea\nSábado 24 de enero de 15:00 a 17:00\nLugar: 7 rue de la Vendée ? Attin\n---------------------------------\nVenga a compartir un momento de puro placer al calor de la chimenea, charlar, conocerse y hablar de nuestros planes para 2026\n\nInformación/reservas por SMS: 06 21 83 65 44\nCrédito: Pixabay"
        ]
      },
