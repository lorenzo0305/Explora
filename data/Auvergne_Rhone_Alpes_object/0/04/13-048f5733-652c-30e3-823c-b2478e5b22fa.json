  "rdfs:comment": {
    "de": [
      "Lachenal hat etwa 20 Einwohner. Das Dorf hat, wie die anderen Dörfer der Gemeinde, eine Kapelle und Bachals, diese Steinbecken, die es wert sind, dass man einen Moment innehält und sie betrachtet."
    ],
    "en": [
      "Lachenal has got nearly 20 resident. It has, like the other villages, its chapel and its “bachals”, basin built with rocks, which deserve to make a break to be contemplated."
    ],
    "it": [
      "Lachenal ha una ventina di abitanti. Come gli altri villaggi del comune, il villaggio ha una cappella e dei bachal, bacini di pietra che vale la pena di contemplare."
    ],
    "fr": [
      "Lachenal compte une vingtaine d'habitants. Le village possède, comme les autres villages de la commune, une chapelle et des bachals, ces bassins de pierres qui méritent que l'on s'arrête un instant pour les contempler."
    ],
    "nl": [
      "Lachenal heeft ongeveer twintig inwoners. Net als de andere dorpen in de gemeente heeft het dorp een kapel en bachals, stenen bekkens die het waard zijn om even bij stil te staan."
    ],
    "es": [
      "Lachenal cuenta con una veintena de habitantes. Al igual que los demás pueblos de la comuna, cuenta con una capilla y bachals, pilas de piedra que merece la pena detenerse a contemplar."
    ]
  },
