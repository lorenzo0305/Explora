  "rdfs:comment": {
    "de": [
      "Im Rahmen der nationalen Woche der frühen Kindheit werden Zirkusworkshops mit dem Zirkusunternehmen \"Cirque à Roulettes\" veranstaltet\r\nEs werden auch Austauschmöglichkeiten mit den Fachkräften der Krippe \"Les Petits Pas\" angeboten."
    ],
    "en": [
      "As part of National Childcare Week, circus workshops are organized with the Cirque à Roulettes company!\r\nThere will also be time for exchanges with professionals from the \"Les Petits Pas\" crèche."
    ],
    "it": [
      "Nell'ambito della Settimana nazionale dell'infanzia, vengono organizzati laboratori di circo con la compagnia Cirque à Roulettes!\r\nCi sarà anche un momento di confronto con i professionisti dell'asilo nido \"Les Petits Pas\"."
    ],
    "fr": [
      "Dans le cadre de la semaine nationale de la petite enfance, des ateliers cirque sont mit en place avec la compagnie Cirque à Roulettes!\r\nDes temps d'échanges avec les professionnels de la crèche \"Les Petits Pas\" sont proposés."
    ],
    "nl": [
      "In het kader van de Nationale Week van de Kinderopvang worden er circusworkshops georganiseerd met het gezelschap Cirque à Roulettes!\r\nEr zal ook tijd zijn voor discussies met professionals van het kinderdagverblijf \"Les Petits Pas\"."
    ],
    "es": [
      "Con motivo de la Semana Nacional de la Infancia, se organizarán talleres de circo con la compañía Cirque à Roulettes\r\nTambién habrá tiempo para charlas con profesionales de la guardería \"Les Petits Pas\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers enfant Comme au cirque! - Semaine nationale de la petite enfance"
    ]
  },
