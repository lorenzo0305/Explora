  "rdfs:comment": {
    "de": [
      "Im Rahmen der Europäischen Tage der Kunsthandwerke öffnet das Atelier de poterie des Terres Brunes seine Türen für Sie: Laura Ghaninejad lädt Sie ein, ihr Atelier zu entdecken."
    ],
    "en": [
      "As part of the Journées Européennes des Métiers d'Art, the Terres Brunes pottery studio opens its doors to you: Laura Ghaninejad invites you to discover her workshop."
    ],
    "it": [
      "Nell'ambito delle Journées Européennes des Métiers d'Art, il laboratorio di ceramica Terres Brunes vi apre le porte: Laura Ghaninejad vi invita a scoprire il suo laboratorio."
    ],
    "fr": [
      "Dans le cadre des Journées Européennes des Métiers d'Art, l'Atelier de poterie des Terres Brunes vous ouvre ses portes: Laura Ghaninejad vous invite à découvrir son atelier."
    ],
    "nl": [
      "In het kader van de Journées Européennes des Métiers d'Art opent het aardewerkatelier Terres Brunes zijn deuren voor jou: Laura Ghaninejad nodigt je uit om haar atelier te ontdekken."
    ],
    "es": [
      "En el marco de las Journées Européennes des Métiers d'Art, el taller de cerámica Terres Brunes le abre sus puertas: Laura Ghaninejad le invita a descubrir su taller."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite de l'atelier des Terres Brunes de Laura Ghaninejad - Journées Européennes des Métiers d'Art"
    ]
  },
