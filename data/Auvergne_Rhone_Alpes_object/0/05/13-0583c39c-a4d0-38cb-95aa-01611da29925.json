  "rdfs:comment": {
    "de": [
      "Julien Gatillon lädt Sie ein, seine Theke mit französischer Küche und Gerichten aus den Bergen in einer entspannten gastronomischen Atmosphäre zu entdecken. Die Gerichte werden vor Ihren Augen zubereitet."
    ],
    "en": [
      "Julien Gatillon invites you to discover his comptoir de cuisine française and mountain cuisine, in a relaxed gastronomic atmosphere. Dishes are prepared before your very eyes"
    ],
    "it": [
      "Julien Gatillon vi invita a scoprire il suo banco di cucina francese e di montagna, in un'atmosfera gastronomica rilassata. I piatti sono preparati davanti ai vostri occhi"
    ],
    "fr": [
      "Julien Gatillon vous propose de découvrir son comptoir de cuisine française et de montagne, dans une ambiance gastronomique décontractée. Les plats sont préparés sous vos yeux."
    ],
    "nl": [
      "Julien Gatillon nodigt je uit om zijn toonbank van de Franse en bergkeuken te ontdekken, in een ontspannen gastronomische sfeer. De gerechten worden voor je ogen bereid."
    ],
    "es": [
      "Julien Gatillon le invita a descubrir su mostrador de cocina francesa y de montaña, en un ambiente gastronómico relajado. Los platos se preparan ante sus propios ojos."
    ]
  },
