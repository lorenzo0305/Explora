  "rdfs:comment": {
    "de": [
      "Das interkommunale Fremdenverkehrsamt Terres de Maurienne empfängt Sie in seinem Büro für touristische Informationen im Hauptort Saint Colomban des Villards für alle Informationen und Ratschläge zu Ihrem Aufenthalt im Tal der Villards!"
    ],
    "en": [
      "The Terres de Maurienne Intercommunal Tourist Office welcomes you to its tourist information office in the Chef-lieu of Saint Colomban des Villards for all information and advice concerning your stay in the Vallée des Villards!"
    ],
    "it": [
      "L'Ufficio Intercomunale del Turismo di Terres de Maurienne vi dà il benvenuto nel suo ufficio di informazioni turistiche nel capoluogo di Saint Colomban des Villards per tutte le informazioni e i consigli sul vostro soggiorno nella Vallée des Villards!"
    ],
    "fr": [
      "L'Office de tourisme de intercommunal Terres de Maurienne vous accueille dans son bureau d'informations touristiques au Chef-lieu de Saint Colomban des Villards pour toutes informations, conseils concernant votre séjour dans la Vallée des Villards !"
    ],
    "es": [
      "La Oficina Intermunicipal de Turismo de Terres de Maurienne le da la bienvenida a su oficina de información turística situada en la ciudad principal de Saint Colomban des Villards para informarle y aconsejarle sobre su estancia en el Valle de los Villardos"
    ],
    "nl": [
      "Het Intercommunaal Bureau voor Toerisme van Terres de Maurienne heet u van harte welkom in zijn VVV-kantoor in de hoofdplaats Saint Colomban des Villards voor alle informatie en advies over uw verblijf in de Vallée des Villards!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Espace Glandon Tourist Office"
