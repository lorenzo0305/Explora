  "rdfs:comment": {
    "de": [
      "Die Kathedrale Saint-Apollinaire ist eines der ältesten Bauwerke von Valencia. Sie steht im Zentrum des Kathedralenviertels und grenzt im Süden an das ehemalige frühchristliche Baptisterium und den Bischofspalast, das heutige Museum."
    ],
    "en": [
      "Saint-Apollinaire Cathedral is one of Valence's oldest monuments. It stands at the center of the cathedral quarter, adjacent to the ancient Paleo-Christian baptistery and the episcopal palace (now a museum) to the south."
    ],
    "it": [
      "La cattedrale di Saint-Apollinaire è uno dei monumenti più antichi di Valence. Si trova al centro del quartiere della cattedrale e confina con l'antico battistero paleocristiano e il palazzo episcopale, oggi museo, a sud."
    ],
    "fr": [
      "La cathédrale Saint-Apollinaire est un des plus anciens monuments de Valence. Elle s’inscrit au centre du quartier cathédral et jouxte au sud l’ancien baptistère paléochrétien et le palais épiscopal, actuel musée."
    ],
    "es": [
      "La catedral Saint-Apollinaire es uno de los monumentos más antiguos de Valence. Está situada en el centro del barrio de la catedral y linda al sur con el antiguo baptisterio paleocristiano y el palacio episcopal, hoy museo."
    ],
    "nl": [
      "De Saint-Apollinaire kathedraal is een van de oudste monumenten van Valence. Het ligt in het centrum van de kathedrale wijk en grenst in het zuiden aan de oude paleochristelijke doopkapel en het bisschoppelijk paleis, nu een museum."
    ]
  },
