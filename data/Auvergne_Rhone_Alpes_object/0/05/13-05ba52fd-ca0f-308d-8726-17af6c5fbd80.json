  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes gelegen, 200 m von der Seilbahn La Brive entfernt.\r\nGepflegte Küche, savoyische Spezialitäten, Bar, Atmosphäre, komfortable Zimmer."
    ],
    "en": [
      "Located in the heart of the village, 200 m from the Brive cable car.\r\nCarefully prepared, traditional Savoy cooking, bar, nice ambiance, comfortable rooms."
    ],
    "it": [
      "Ubicato in centro paese a 200 m della telecabina della Brive. Cucina raffinata, specialità savoiarde, bar, atmosfera calorosa, camere di grande comfort."
    ],
    "fr": [
      "Situé au centre du village à 200 mètres de la télécabine de la Brive.\r\nCuisine soignée, spécialités savoyardes, bar, ambiance, chambres confortables."
    ],
    "es": [
