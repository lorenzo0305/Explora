  "rdfs:comment": {
    "de": [
      "Bureau Montagne Plagne Evasions bietet Ihnen mehrere Aktivitäten an: \r\n- Wanderungen und Schneeschuhwanderungen\r\n- Wanderungen und Balladen zu bestimmten Themen\r\n- Trail \r\n- Nordic Walking\r\n- Praktika und Einführungen zum Überleben und zur Autonomie in den Bergen"
    ],
    "en": [
      "The Plagne Evasions Mountain Office proposes several activities: \r\n- Snowshoe walks and hikes\r\n- Theme walks and hikes\r\n- Trail running\r\n- Nordic walking\r\n- Mountain survival courses."
    ],
    "it": [
      "Il Bureau Montagne Plagne Evasions offre una serie di attività:\r\n- Escursioni e passeggiate con le racchette da neve\r\n- Escursioni e passeggiate a tema\r\n- Sentieri\r\n- Camminata nordica\r\n- Corsi e introduzioni alla sopravvivenza e all'autosufficienza in montagna"
    ],
    "fr": [
      "Bureau Montagne Plagne Evasions vous propose plusieurs activités : \r\n- Randonnées et Balades raquettes\r\n- Randonnées et Balades à thème\r\n- Trail \r\n- Marche Nordique\r\n- Stages et initiations à la survie et à l'autonomie en montagne"
    ],
    "es": [
      "Bureau Montagne Plagne Evasions ofrece diversas actividades:\r\n- Paseos con raquetas de nieve\r\n- Paseos temáticos\r\n- Senderos\r\n- Marcha nórdica\r\n- Cursos e iniciación a la supervivencia y la autosuficiencia en montaña"
    ],
    "nl": [
      "Bureau Montagne Plagne Evasions biedt diverse activiteiten: \r\n- Sneeuwwandelingen en -tochten\r\n- Wandelingen en tochten met thema\r\n- Trailrunning\r\n- Nordic walking\r\n- Workshops survivaling en zelfstandig door de bergen trekken."
    ]
  },
