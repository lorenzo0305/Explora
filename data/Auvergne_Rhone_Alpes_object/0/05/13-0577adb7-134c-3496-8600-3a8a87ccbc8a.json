  "rdfs:comment": {
    "de": [
      "Das Grandes Rousses Hotel & Spa liegt im Zentrum des Dorfes mit direktem Zugang zu den Skiliften und Wanderwegen. Es empfängt Sie 9 Monate im Jahr und genießt die schönste Lage des Ortes mit einem atemberaubenden Blick auf das Bergmassiv."
    ],
    "en": [
      "Located in the center of the village with direct access to the ski lifts and hiking trails, Grandes Rousses Hotel & Spa welcomes you 9 months of the year and boasts the most beautiful location in the resort with a breathtaking view of the massif."
    ],
    "it": [
      "Situato nel centro del villaggio, con accesso diretto agli impianti di risalita e ai sentieri escursionistici, il Grandes Rousses Hotel & Spa vi accoglie 9 mesi all'anno e vanta la posizione più bella della località con una vista mozzafiato sul Massiccio."
    ],
    "fr": [
      "Situé au centre du village avec un accès direct aux remontées mécaniques et aux chemins de randonnée, Grandes Rousses Hotel & Spa vous accueille 9 mois dans l'année et bénéficie du plus bel emplacement de la station avec une vue imprenable sur le massif."
    ],
    "es": [
      "Situado en el centro del pueblo, con acceso directo a los remontes y a las rutas de senderismo, Grandes Rousses Hotel & Spa le da la bienvenida 9 meses al año y goza de la ubicación más hermosa de la estación, con una vista impresionante del Macizo."
    ],
    "nl": [
      "Grandes Rousses Hotel & Spa ligt in het centrum van het dorp met directe toegang tot de skiliften en wandelpaden, verwelkomt je 9 maanden per jaar en beschikt over de mooiste locatie in het resort met een adembenemend uitzicht op het Massif."
    ]
  },
