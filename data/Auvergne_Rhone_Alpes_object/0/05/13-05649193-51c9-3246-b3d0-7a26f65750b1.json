  "rdfs:comment": {
    "de": [
      "Ein eklektisches Programm, das auf dem roten Faden des Jazz balanciert. Konzerte auf der großen Bühne und auch im Herzen der Stadt, der internationale Wettbewerb für Vokaljazz, eine Konferenzreihe, Off-Konzerte sowie Praktika und Workshops."
    ],
    "en": [
      "An eclectic program, balanced on the red thread of jazz. Concerts on the main stage and in the heart of the town, the international vocal jazz competition, a series of conferences, off concerts and workshops."
    ],
    "it": [
      "Un programma eclettico, in equilibrio sul filo rosso del jazz. Concerti sul palco principale e anche nel cuore della città, il concorso internazionale di jazz vocale, una serie di conferenze, concerti fuori dal campus, corsi e workshop."
    ],
    "fr": [
      "Une programmation éclectique, en équilibre sur le fil rouge du jazz. Des concerts sur la grande scène et aussi au cœur de la ville, le concours international de jazz vocal, un cycle de conférences, des concerts off et des stages et ateliers."
    ],
    "es": [
      "Un programa ecléctico, equilibrado sobre el hilo rojo del jazz. Conciertos en el escenario principal y también en el corazón de la ciudad, el concurso internacional de jazz vocal, una serie de conferencias, conciertos fuera del campus y cursos y talleres."
    ],
    "nl": [
      "Een eclectisch programma, gebalanceerd op de rode draad van jazz. Concerten op het hoofdpodium en ook in het hart van de stad, de internationale vocale jazzcompetitie, een reeks lezingen, off-campus concerten en cursussen en workshops."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crest Jazz Festival - 50ème édition"
    ]
  },
