  "rdfs:comment": {
    "de": [
      "Die Terrasse des Thermes bietet einfache, schmackhafte Küche von Küchenchef Claude Brioude: Tagesmenü und Tagesgericht, Salate und herzhafte Tartes. Das Tagesgericht ist auch zum Mitnehmen erhältlich."
    ],
    "en": [
      "The Thermes terrace offers simple, tasty cuisine by chef Claude Brioude: set menu and dish of the day, salads and savoury tarts. Dish of the day available to take away."
    ],
    "it": [
      "La terrazza delle Thermes offre una cucina semplice e gustosa dello chef Claude Brioude: menu e piatto del giorno, insalate e torte salate. Specialità giornaliere da asporto."
    ],
    "fr": [
      "La terrasse des Thermes vous propose une cuisine simple et goûteuse par le chef Claude Brioude : menu et plat du jour, salades et tartes salées. Possibilité de plat du jour à emporter."
    ],
    "es": [
      "La terraza de las Thermes ofrece una cocina sencilla y sabrosa del chef Claude Brioude: menú y plato del día, ensaladas y tartas saladas. Especialidades del día para llevar."
    ],
    "nl": [
      "Het terras van de Thermen biedt eenvoudige, smakelijke gerechten van chef-kok Claude Brioude: menu en dagschotel, salades en hartige taartjes. Dagelijkse specialiteiten om mee te nemen."
    ]
  },
