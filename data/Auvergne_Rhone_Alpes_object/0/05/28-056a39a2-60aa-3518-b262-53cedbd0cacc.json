  "rdfs:comment": {
    "de": [
      "La Belle Ferme ist ein traditionelles Restaurant im Herzen des schönsten Dorfes des Departements Oise: Gerberoy. Frische, hausgemachte Gerichte von unserer Köchin Nadia. Die Bar ist geöffnet und bietet Ihnen Cocktails, Bier und andere Spirituosen, aber auch alkoholfreie Getränke."
    ],
    "en": [
      "La Belle Ferme is a traditional restaurant in the heart of Gerberoy, the most beautiful village in the Oise region. Fresh, home-cooked dishes by our chef Nadia. The bar is open and offers cocktails, beers and other spirits, as well as non-alcoholic drinks."
    ],
    "it": [
      "La Belle Ferme è un ristorante tradizionale situato nel cuore del più bel villaggio dell'Oise: Gerberoy. Piatti freschi e fatti in casa dalla nostra chef Nadia. Il bar è aperto e offre cocktail, birre e altri alcolici, oltre a bevande analcoliche."
    ],
    "fr": [
      "La Belle Ferme est un restaurant traditionnel situé au cœur du plus beau village de l'Oise : Gerberoy. Des plats frais, fait maison par notre chef Nadia. Le bar est ouvert et vous propose des cocktails, bières et autres spiritueux mais aussi des boissons non alcoolisées."
    ],
    "nl": [
      "La Belle Ferme is een traditioneel restaurant in het hart van het mooiste dorp van de Oise: Gerberoy. Verse, huisgemaakte gerechten door onze chef Nadia. De bar is open en biedt cocktails, bieren en andere sterke dranken, evenals niet-alcoholische dranken."
    ],
    "es": [
      "La Belle Ferme es un restaurante tradicional situado en el corazón del pueblo más bonito de la Oise: Gerberoy. Platos frescos y caseros elaborados por nuestra chef Nadia. El bar está abierto y ofrece cócteles, cervezas y otros licores, así como bebidas sin alcohol."
    ]
  },
