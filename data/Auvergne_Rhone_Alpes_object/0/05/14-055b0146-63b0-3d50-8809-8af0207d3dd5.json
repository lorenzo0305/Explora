      "@id": "https://data.datatourisme.fr/891dc8c7-0085-3054-a342-b88f3b9032e0",
      "dc:description": {
        "de": [
          "Willkommen im Schönheitsinstitut Les Secrets de Loane in Frencq. Tauchen Sie ein in ein einzigartiges Schönheitserlebnis, bei dem Ihnen das Know-how einer Expertin gewidmet ist."
        ],
        "en": [
          "Welcome to Les Secrets de Loane beauty salon in Frencq. Immerse yourself in a unique beauty experience, where the know-how of an expert is dedicated to you."
        ],
        "it": [
          "Benvenuti nel salone di bellezza Les Secrets de Loane a Frencq. Immergetevi in un'esperienza di bellezza unica, dove il know-how di un esperto è dedicato a voi."
        ],
        "fr": [
          "Bienvenue à l'institut de beauté Les Secrets de Loane, situé à Frencq. Plongez dans une expériences de beauté unique, où le savoir-faire d'un expert vous est dédié."
        ],
        "nl": [
          "Welkom bij schoonheidssalon Les Secrets de Loane in Frencq. Dompel jezelf onder in een unieke schoonheidservaring, waar de knowhow van een expert aan jou is gewijd."
        ],
        "es": [
          "Bienvenido al salón de belleza Les Secrets de Loane en Frencq. Sumérjase en una experiencia de belleza única, donde el saber hacer de un experto se dedica a usted."
        ]
      },
