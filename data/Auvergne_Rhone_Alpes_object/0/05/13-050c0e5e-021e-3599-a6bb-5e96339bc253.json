  "rdfs:comment": {
    "de": [
      "Ein Spielplatz für alle! Das City Stadium des Espace Nature et Loisirs du Collet liegt mitten in den Bergen und empfängt Sie in einer außergewöhnlichen natürlichen Umgebung, wo Sie Sport treiben, teilen und Spaß an der frischen Luft haben können."
    ],
    "en": [
      "A playground for everyone! Nestled in the heart of the mountains, the City Stadium at the Espace Nature et Loisirs du Collet welcomes you to an exceptional natural setting for moments of sport, sharing, and outdoor fun."
    ],
    "it": [
      "Un parco giochi per tutti! Immerso nel cuore delle montagne, il City Stade dell'Espace Nature et Loisirs du Collet vi accoglie in un ambiente naturale eccezionale, per momenti di sport, condivisione e divertimento all'aria aperta."
    ],
    "fr": [
      "Un terrain de jeu pour tous ! Niché au cœur des montagnes, le City Stade de l'Espace Nature et Loisirs du Collet vous accueille dans un cadre naturel exceptionnel, pour des moments de sport, de partage et de plaisir en plein air."
    ],
    "es": [
      "Un parque infantil para todos Enclavado en el corazón de las montañas, el City Stade del Espace Nature et Loisirs du Collet le acoge en un marco natural excepcional, para momentos de deporte, convivencia y diversión al aire libre."
    ],
    "nl": [
      "Een speeltuin voor iedereen! Midden in de bergen verwelkomt het City Stadium in de Espace Nature et Loisirs du Collet u in een uitzonderlijke natuurlijke omgeving voor sportieve, ontspannende en buitensportende momenten."
    ]
  },
