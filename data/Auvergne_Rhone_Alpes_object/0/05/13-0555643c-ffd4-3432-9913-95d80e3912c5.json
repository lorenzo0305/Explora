  "rdfs:comment": {
    "de": [
      "Das Le Bottleneck ist ein neues Restaurant im K2 Chogori. Hier werden in einer intimen, gedämpften und geselligen Atmosphäre gegrillte Gerichte und Käsefondues serviert."
    ],
    "en": [
      "As the new restaurant of K2 Chogori, Bottleneck offers wood-fired cuisine and cheese fondues in an intimate, refined and convivial atmosphere."
    ],
    "it": [
      "Il nuovo ristorante del K2 Chogori, Le Bottleneck, propone una cucina alla brace e fondute di formaggio in un'atmosfera intima, accogliente e conviviale."
    ],
    "fr": [
      "Nouveau restaurant du K2 Chogori, Le Bottleneck propose une cuisine à la braise et des fondues fromagères dans une ambiance intimiste, feutrée et conviviale."
    ],
    "nl": [
      "Le Bottleneck, het nieuwe restaurant van K2 Chogori, biedt gegrilde gerechten en kaasfondues in een intieme, gezellige en vriendelijke sfeer."
    ],
    "es": [
      "Le Bottleneck, el nuevo restaurante del K2 Chogori, ofrece platos a la parrilla y fondues de queso en un ambiente íntimo, acogedor y agradable."
    ]
  },
