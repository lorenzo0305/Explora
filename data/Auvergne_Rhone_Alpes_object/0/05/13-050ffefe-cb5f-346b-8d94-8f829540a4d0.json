  "rdfs:comment": {
    "de": [
      "Die Rennstrecke von Bourbonnais ist eine 2,3 km lange und 10 m breite Piste, die viele verschiedene Streckenkonfigurationen ermöglicht. Freizeit- und Trainingsstrecke, zugelassen für Auto/Motorrad über 200km/h."
    ],
    "en": [
      "The Bourbonnais circuit is a 2.3 km long and 10m wide track, allowing many configurations of course. Circuit leisure and training, approved car / motorcycle more than 200km / h."
    ],
    "it": [
      "Il circuito di Bourbonnais è una pista lunga 2,3 km e larga 10 metri, che consente numerose configurazioni di percorso. Circuito per il tempo libero e l'allenamento, omologato per auto e moto a velocità superiori a 200 km/h."
    ],
    "fr": [
      "Le circuit du Bourbonnais est une piste de 2,3 km de long sur 10m de largeur, permettant de nombreuses configurations de parcours. Circuit loisirs et entrainements, agréer auto/moto plus de 200km/h."
    ],
    "nl": [
      "Het circuit van Bourbonnais is 2,3 km lang en 10 m breed, zodat er talrijke parcoursconfiguraties mogelijk zijn. Recreatie- en trainingscircuit, goedgekeurd voor auto's en motoren met snelheden van meer dan 200 km/u."
    ],
    "es": [
      "El circuito de Bourbonnais es una pista de 2,3 km de largo y 10 m de ancho, que permite numerosas configuraciones de recorrido. Circuito de ocio y entrenamiento, homologado para coches y motos a velocidades superiores a 200km/h."
    ]
  },
  "rdfs:label": {
