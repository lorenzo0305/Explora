  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: Auf der Terrasse oder hinter den Glasfenstern können Sie den Blick auf die Kathedrale von Amiens und den Justizpalast genießen."
    ],
    "en": [
      "You'll love the view of Amiens Cathedral and the Palais de Justice from the terrace or behind the bay windows."
    ],
    "it": [
      "La vista sulla Cattedrale di Amiens e sul Palazzo di Giustizia si gode dalla terrazza o dietro le finestre a golfo."
    ],
    "fr": [
      "Vous aimerez : en terrasse ou derrière les baies vitrées, vous pourrez profiter de la vue sur la Cathédrale d'Amiens et le palais de Justice."
    ],
    "es": [
      "Le encantarán las vistas de la catedral de Amiens y del Palacio de Justicia desde la terraza o tras los ventanales."
    ],
    "nl": [
      "Je zult genieten van het uitzicht op de kathedraal van Amiens en het Palais de Justice vanaf het terras of achter de erkers."
    ]
  },
