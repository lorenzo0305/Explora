  "rdfs:comment": {
    "de": [
      "Die Troupe de Coubon präsentiert am 24. April 2026 im Palais des Spectacles in Vals-près-le-Puy ein Hommage-Konzert an Starmania. Ein Abend, an dem Sie die mythischen Titel des Kultmusicals noch einmal erleben können. Reservierung wird empfohlen."
    ],
    "en": [
      "La Troupe de Coubon presents a Starmania tribute concert on April 24, 2026 at the Palais des Spectacles in Vals-près-le-Puy. An evening to relive the legendary songs of the cult musical. Reservations recommended."
    ],
    "it": [
      "La Troupe de Coubon presenta un concerto tributo a Starmania il 24 aprile 2026 al Palais des Spectacles di Vals-près-le-Puy. Una serata per rivivere le leggendarie canzoni del musical cult. Si consiglia la prenotazione."
    ],
    "fr": [
      "La Troupe de Coubon présente un concert hommage à Starmania le 24 avril 2026 au Palais des Spectacles de Vals-près-le-Puy. Une soirée pour revivre les titres mythiques de la comédie musicale culte. Réservation conseillée."
    ],
    "nl": [
      "La Troupe de Coubon presenteert een hommageconcert aan Starmania op 24 april 2026 in het Palais des Spectacles in Vals-près-le-Puy. Een avond om de legendarische liedjes uit de cultmusical te herbeleven. Reserveren aanbevolen."
    ],
    "es": [
      "La Troupe de Coubon presenta un concierto homenaje a Starmania el 24 de abril de 2026 en el Palais des Spectacles de Vals-près-le-Puy. Una velada para revivir las míticas canciones del musical de culto. Se recomienda reservar."
    ]
  },
