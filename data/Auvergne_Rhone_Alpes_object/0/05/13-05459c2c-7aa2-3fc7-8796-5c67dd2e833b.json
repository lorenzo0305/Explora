  "rdfs:comment": {
    "de": [
      "Die Amicale Laïque von La Garde-Adhémar bietet Ihnen das ganze Jahr über zwei Aktivitäten an:\r\n- Sanfte Gymnastik\r\n- Chor \"Mistral Chantant\" (Singender Mistral).\r\nUnd eine neue Aktivität: Gartenarbeit."
    ],
    "en": [
      "The Amicale Laïque de La Garde-Adhémar offers 2 activities throughout the year:\r\n- Gentle gymnastics\r\n- Mistral Chantant\" choir\r\nAnd a new activity: gardening."
    ],
    "it": [
      "L'Amicale Laïque de La Garde-Adhémar propone 2 attività durante tutto l'anno\r\n- Ginnastica dolce\r\n- Coro \"Mistral Chantant\r\nE una nuova attività: il giardinaggio."
    ],
    "fr": [
      "L'Amicale Laïque de La Garde-Adhémar vous propose 2 activités tout au long de l'année : \r\n- Gymnastique douce  \r\n- Chorale \"Mistral Chantant\"\r\nEt une nouvelle activité : jardinage."
    ],
    "es": [
      "La Amicale Laïque de La Garde-Adhémar ofrece 2 actividades a lo largo del año\r\n- Gimnasia suave\r\n- Coro \"Mistral Chantant\r\nY una nueva actividad: la jardinería."
    ],
    "nl": [
      "De Amicale Laïque de La Garde-Adhémar biedt het hele jaar door 2 activiteiten aan:\r\n- Lichte gymnastiek\r\n- Koor \"Mistral Chantant\r\nEn een nieuwe activiteit: tuinieren."
    ]
  },
