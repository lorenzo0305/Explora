  "rdfs:comment": {
    "de": [
      "Weinbar, die die Marktküche mit lokalen Produkten von Kleinbauern neu interpretiert. Die beiden Küchenchefs beschreiben eine Küche, die \"zum Teilen einlädt\". Lassen Sie sich von der warmen und originellen Umgebung verführen!"
    ],
    "en": [
      "Wine bar revisiting market cuisine with local products from small producers. The two chefs describe their cuisine as \"an invitation to share\". Let yourself be tempted by the warm and original setting!"
    ],
    "it": [
      "Un wine bar che rivisita la cucina del mercato utilizzando prodotti locali di piccoli produttori. I due chef descrivono la loro cucina come \"un invito alla condivisione\". Lasciatevi tentare da un ambiente caldo e originale!"
    ],
    "fr": [
      "Bar à vins revisitant la cuisine du marché avec des produits locaux issus de petits producteurs. Les deux chefs décrivent une cuisine \"invitant au partage\". Laissez vous tenter par le cadre chaleureux et original !"
    ],
    "es": [
      "Un bar de vinos que revisita la cocina de mercado con productos locales de pequeños productores. Los dos chefs describen su cocina como \"una invitación a compartir\". Déjese seducir por un ambiente cálido y original"
    ],
    "nl": [
      "Een wijnbar die de marktkeuken herziet met lokale producten van kleine producenten. De twee chef-koks omschrijven hun keuken als \"een uitnodiging om te delen\". Laat u verleiden door het warme en originele kader!"
    ]
  },
  "rdfs:label": {
