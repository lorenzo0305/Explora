  "rdfs:comment": {
    "de": [
      "Bei einem Rundgang durch das Viertel Les Tanneurs schlendern Sie entlang der Ufer bis zur Baustelle der Mediathek Simone de Beauvoir.\r\nVerfolgen Sie die Geschichte dieses Viertels bis hin zu seinen jüngsten Entwicklungen."
    ],
    "en": [
      "On a guided tour from the Tanneurs district, stroll along the quays to the site of the Médiathèque Simone de Beauvoir.\r\nFollow the history of this district through to its most recent developments."
    ],
    "it": [
      "Partecipate a una visita guidata dal quartiere dei Tanneurs e passeggiate lungo le banchine fino al sito della biblioteca multimediale Simone de Beauvoir.\r\nSeguite la storia di questo quartiere fino ai suoi sviluppi più recenti."
    ],
    "fr": [
      "Au cours d'une visite guidée depuis le quartier des Tanneurs, flânez le long des quais jusqu’au chantier de la Médiathèque Simone de Beauvoir.\r\nSuivez le cours de l’histoire de ce quartier jusqu’à ses aménagements les plus récents."
    ],
    "nl": [
      "Volg een rondleiding door de wijk Tanneurs en wandel langs de kades naar de locatie van de mediatheek van Simone de Beauvoir.\r\nVolg de geschiedenis van deze wijk tot de meest recente ontwikkelingen."
    ],
    "es": [
      "Realice una visita guiada desde el barrio de Tanneurs y pasee por los muelles hasta la sede de la biblioteca multimedia Simone de Beauvoir.\r\nSiga la historia de este barrio hasta sus últimos desarrollos."
    ]
  },
