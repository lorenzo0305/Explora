  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von den hervorragenden Angeboten dieses Restaurants verführen, wenn Sie einen Bärenhunger haben! Probieren Sie unbedingt ihre Hauptgerichte wie Burger und besonders leckeres Fleisch."
    ],
    "en": [
      "Let yourself be seduced by this restaurant's excellent offers for a wolf's hunger! Taste their flagship dishes such as the particularly delicious burger and meat."
    ],
    "it": [
      "Lasciatevi sedurre dalle eccellenti offerte di questo ristorante per soddisfare la vostra fame! Non mancate di provare i loro piatti forti, come l'hamburger e la carne, particolarmente deliziosi."
    ],
    "fr": [
      "Laissez-vous séduire par les excellentes offres de ce restaurant pour une faim de loup ! Goûtez absolument leurs plats phares tels que le burger et viande particulièrement délicieuses."
    ],
    "nl": [
      "Laat je verleiden door de uitstekende aanbiedingen van dit restaurant om je honger te stillen! Probeer zeker hun topgerechten, zoals de bijzonder lekkere hamburger met vlees."
    ],
    "es": [
      "Déjese seducir por las excelentes ofertas de este restaurante para saciar su hambre No deje de probar sus platos estrella, como la hamburguesa y la carne, especialmente deliciosas."
    ]
  },
