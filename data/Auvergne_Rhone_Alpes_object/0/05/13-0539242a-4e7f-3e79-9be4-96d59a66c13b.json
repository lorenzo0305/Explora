  "rdfs:comment": {
    "de": [
      "Ich habe einen unerschütterlichen Sinn für Humor und werde Sie über die Puys im Herzen des Parc des Volcans d'Auvergne führen."
    ],
    "en": [
      "With my unfailing sense of humor, I'll be able to guide you around the puys in the heart of the Parc des Volcans d'Auvergne."
    ],
    "it": [
      "Con il mio immancabile senso dell'umorismo, saprò guidarvi alla scoperta dei puys nel cuore del Parc des Volcans d'Auvergne."
    ],
    "fr": [
      "Un sens de l'humour à toute épreuve, je saurai vous guider sur les puys au cœur du Parc des Volcans d'Auvergne."
    ],
    "nl": [
