  "rdfs:comment": {
    "de": [
      "In Zusammenarbeit mit Laurent Gerra, dem Zeremonienmeister, entdecken Sie das Programm der 13. Ausgabe!\r\nEin außergewöhnliches jährliches Treffen! Drei Tage Festival in einer herzlichen und geselligen Atmosphäre unter Freunden."
    ],
    "en": [
      "In collaboration with Laurent Gerra, Master of Ceremonies, discover the program for this 13th edition!\r\nAn exceptional annual event. 3 days of festival fun in a warm, friendly atmosphere."
    ],
    "it": [
      "In collaborazione con Laurent Gerra, maestro di cerimonie, scoprite il programma di questa 13a edizione!\r\nUn evento annuale eccezionale! Tre giorni di divertimento in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "En collaboration avec Laurent Gerra, maître de cérémonie, découvrez la programmation de cette 13ème édition !\r\nUn rendez-vous annuel exceptionnel ! Trois jours de festival dans une ambiance chaleureuse et conviviale, entre amis."
    ],
    "nl": [
      "Ontdek in samenwerking met Laurent Gerra, ceremoniemeester, het programma voor deze 13e editie!\r\nEen uitzonderlijk jaarlijks evenement. 3 dagen festivalplezier in een warme en gezellige sfeer."
    ],
    "es": [
      "En colaboración con Laurent Gerra, maestro de ceremonias, descubra el programa de esta 13ª edición\r\nUn acontecimiento anual excepcional Tres días de fiesta en un ambiente cálido y acogedor."
    ]
  },
