  "rdfs:comment": {
    "de": [
      "An der Schnittstelle von Traditionen und Know-how lädt Sie dieser Museumsbereich zu einer erstaunlichen Kultur- und Erbreise in die hohen Cevennen der Ardèche ein. \r\nSie kommen mit Kindern? Fragen Sie am Empfang nach dem Spielheft."
    ],
    "en": [
      "At the crossroads of tradition and know-how, this museum invites you on an astonishing cultural and heritage journey through the high Cévennes of the Ardèche. \r\nAre you coming with children? Ask for the game booklet at reception."
    ],
    "it": [
      "Al crocevia tra tradizione e know-how, questo museo vi invita a un sorprendente viaggio culturale e patrimoniale attraverso le alte Cévennes dell'Ardèche.\r\nVenite con i bambini? Richiedete il libretto dei giochi alla reception."
    ],
    "fr": [
      "Au carrefour des traditions et des savoir-faire, cet espace muséographique vous invite à un étonnant voyage culturel et patrimonial dans les hautes Cévennes ardéchoises. \r\nVous venez avec des enfants ? Demandez le livret-jeu à l’accueil."
    ],
    "nl": [
      "Op het kruispunt van traditie en knowhow nodigt dit museum je uit voor een verbazingwekkende culturele en erfgoedreis door de hoge Cevennen van de Ardèche. \r\nKom je met kinderen? Vraag bij de receptie naar het spelletjesboekje."
    ],
    "es": [
      "En la encrucijada de la tradición y el saber hacer, este museo le invita a un sorprendente viaje cultural y patrimonial por las altas Cevenas de la Ardèche.\r\n¿Viene con niños? Solicite el cuaderno de juegos en recepción."
    ]
  },
