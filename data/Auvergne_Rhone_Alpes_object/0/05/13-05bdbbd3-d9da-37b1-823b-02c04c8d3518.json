  "rdfs:comment": {
    "de": [
      "Verpflegungsstation beim Trail des Ducs de Savoie, einem Naturlauf über 145 km und 9176 Höhenmeter zwischen Courmayeur und Chamonix, der über die Fernwanderwege des Mont-Blanc-Gebiets, des Aostatals, der Haute Tarentaise und des Beaufortain führt."
    ],
    "en": [
      "Refreshment stage of the Trail des Ducs de Savoie, a 145km, 9176m+ nature trail between Courmayeur and Chamonix, following the Grande Randonnée trails of the Mont-Blanc region, the Aosta Valley, the Haute Tarentaise and the Beaufortain."
    ],
    "it": [
      "Tappa di ristoro del Trail des Ducs de Savoie, un percorso naturalistico di 145 km e 9176 m+ tra Courmayeur e Chamonix, che segue i sentieri della Grande Randonnée della regione del Monte Bianco, della Valle d'Aosta, dell'Alta Tarentaise e del Beaufortain."
    ],
    "fr": [
      "Étape ravitaillement de Trail des Ducs de Savoie de pleine nature de 145 km et  9176 mètres D+ entre Courmayeur et Chamonix, empruntant les sentiers de Grande Randonnée du pays du Mont-Blanc, la Vallée d'Aoste, la Haute Tarentaise et le Beaufortain."
    ],
    "nl": [
      "Opfrissingsetappe van de Trail des Ducs de Savoie, een 145 km lang, 9176 m+ natuurpad tussen Courmayeur en Chamonix, dat de Grande Randonnée-paden van de Mont-Blanc regio, de Aostavallei, de Haute Tarentaise en de Beaufortain volgt."
    ],
    "es": [
      "Etapa de avituallamiento del Trail des Ducs de Savoie, un sendero natural de 145 km y 9176 m+ entre Courmayeur y Chamonix, siguiendo los senderos de la Grande Randonnée de la región del Mont-Blanc, el Valle de Aosta, la Haute Tarentaise y el Beaufortain."
    ]
  },
  "rdfs:label": {
    "en": [
      "TDS Trail Race - In the Footsteps of the Dukes of Savoie"
    ],
    "fr": [
      "Sur les Traces des Ducs de Savoie - TDS"
    ]
  },
