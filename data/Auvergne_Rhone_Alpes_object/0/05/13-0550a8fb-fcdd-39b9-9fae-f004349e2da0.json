  "rdfs:comment": {
    "de": [
      "Vorführung des Films \"Mon frère Sotos\" (40 Minuten), gefolgt von einem Rundtischgespräch mit Doumé, Meije Bidault und Cédric Amafroi-Broisat.\r\nUm über das Erlernen des Skifahrens und die Selbstverwirklichung mit einer Behinderung zu sprechen...manchmal sogar bis hin zu Medaillen!"
    ],
    "en": [
      "Screening of the film 'Mon frère Sotos' (40 minutes), followed by a round table with Doumé, Meije Bidault and Cédric Amafroi-Broisat\r\nTo evoke learning to ski and personal achievement with a disability... sometimes even to medals!"
    ],
    "it": [
      "Proiezione del film \"Mon frère Sotos\" (40 minuti), seguita da una tavola rotonda con Doumé, Meije Bidault e Cédric Amafroi-Broisat.\r\nUna discussione su come imparare a sciare e raggiungere il successo personale con una disabilità... a volte anche vincendo medaglie!"
    ],
    "fr": [
      "Projection du film \"Mon frère Sotos\" (40 minutes), suivie d'une table ronde réunissant Doumé, Meije Bidault et Cédric Amafroi-Broisat.\r\nPour évoquer l'apprentissage du ski et la réalisation personnelle avec un handicap...parfois même jusqu'aux médailles !"
    ],
    "nl": [
      "Vertoning van de film \"Mon frère Sotos\" (40 minuten), gevolgd door een rondetafelgesprek met Doumé, Meije Bidault en Cédric Amafroi-Broisat.\r\nEen discussie over leren skiën en het behalen van persoonlijk succes met een handicap... soms zelfs het winnen van medailles!"
    ],
    "es": [
      "Proyección de la película \"Mon frère Sotos\" (40 minutos), seguida de una mesa redonda con Doumé, Meije Bidault y Cédric Amafroi-Broisat.\r\nUn debate sobre el aprendizaje del esquí y la consecución de éxitos personales con una discapacidad... ¡a veces incluso ganando medallas!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Handiski"
    ]
  },
