  "rdfs:comment": {
    "de": [
      "Besuchen Sie unseren Mini-Bauernhof und lassen Sie sich (von Groß und Klein) von unseren Ziegen, Schafen, Kaninchen und anderen Tieren aus dem Hinterhof begeistern.  Die Kinder dürfen die Tiere füttern und natürlich auch mit ihnen kuscheln!"
    ],
    "en": [
      "Visit our mini-farm and be amazed (young and old) by our goats, sheep, rabbits and other farmyard animals.  Children can feed the animals and, of course, cuddle them!"
    ],
    "it": [
      "Visitate la nostra mini-fattoria e lasciatevi stupire (grandi e piccini) dalle nostre capre, pecore, conigli e altri animali da cortile.  I bambini possono dare da mangiare agli animali e, naturalmente, coccolarli!"
    ],
    "fr": [
      "Visiter notre mini-ferme et laissez-vous (petits et grands) émerveillez par nos chèvres, moutons, lapins et autres animaux de la basse-cour.  Les enfants peuvent nourrir les animaux et bien sûr les câliner !"
    ],
    "es": [
      "Visite nuestra minigranja y sorpréndase (grandes y pequeños) con nuestras cabras, ovejas, conejos y otros animales de corral.  Los niños pueden dar de comer a los animales y, por supuesto, ¡hacerles mimos!"
    ],
    "nl": [
      "Bezoek onze miniboerderij en laat je (jong en oud) verrassen door onze geiten, schapen, konijnen en andere boerderijdieren.  Kinderen kunnen de dieren voeren en natuurlijk knuffelen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mini-ferme Aux 5 gnomes"
    ]
  },
