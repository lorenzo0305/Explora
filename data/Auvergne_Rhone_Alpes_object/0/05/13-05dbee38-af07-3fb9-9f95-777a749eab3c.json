  "rdfs:comment": {
    "de": [
      "Sie suchen ein Gourmet-Restaurant in Ain, in dem das Auge mit dem Gaumen verwöhnt wird?"
    ],
    "en": [
      "The Auberge Campagnarde Restaurant is located in Evosge and has been in the hands of the same family for five generations.  Today chef Jeanne-Marie Merloz proposes the finest home cooked cuisine based on fresh local produce."
    ],
    "it": [
      "Siete alla ricerca di un ristorante gourmet nell'Ain dove il piacere degli occhi incontra quello delle papille gustative?"
    ],
    "fr": [
      "Vous cherchez un restaurant gastronomique dans l’Ain où le plaisir des yeux rejoint celui des papilles ?"
    ],
    "es": [
      "¿Busca un restaurante gastronómico en Ain donde los placeres de la vista se encuentren con los del paladar?"
    ],
    "nl": [
      "Ben je op zoek naar een gastronomisch restaurant in Ain waar het genot van de ogen en dat van de smaakpapillen samenkomen?"
    ]
