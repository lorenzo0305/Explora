      "dc:description": {
        "de": [
          "An Samstagvormittagen können Sie an diesem Eltern-Kind-Workshop teilnehmen, um sich wieder miteinander zu verbinden."
        ],
        "en": [
          "On Saturday mornings, you can take part in this parent-child workshop to reconnect with each other."
        ],
        "it": [
          "Il sabato mattina potete partecipare a questo laboratorio per genitori e figli per riconnettervi l'uno con l'altro."
        ],
        "fr": [
          "Les samedis matins vous pourrez participer à cet atelier parentalité parent-enfant pour vous reconnecter ensemble."
        ],
        "nl": [
          "Op zaterdagochtend kun je deelnemen aan deze ouder-kind workshop om weer in contact te komen met elkaar."
        ],
        "es": [
          "Los sábados por la mañana, puede participar en este taller para padres e hijos para reconectar entre sí."
        ]
      },
