  "rdfs:comment": {
    "de": [
      "Für einen einzigartigen Moment der Entspannung und des Wohlbefindens im Herzen der Berge in einer Wassertemperatur zwischen 32 und 34 Grad, begeben Sie sich in den Balneoform-Bereich von Le Palais!"
    ],
    "en": [
      "For a unique moment of relaxation and well-being in the heart of the mountains, in water between 32 and 34 degrees, visit the Balneoform area at Le Palais!"
    ],
    "it": [
      "Per un momento unico di relax e benessere nel cuore delle montagne, in un'acqua tra i 32 e i 34 gradi, visitate l'area Balneoform di Le Palais!"
    ],
    "fr": [
      "Pour un moment unique de détente et de bien-être au cœur des montagnes dans une eau entre 32 et 34 degrés, rendez-vous dans l'espace Balnéoforme du Palais !"
    ],
    "nl": [
      "Voor een uniek moment van ontspanning en welzijn in het hart van de bergen in water tussen 32 en 34 graden, bezoek de Balneoform ruimte van het Palais!"
    ],
    "es": [
      "Para disfrutar de un momento único de relajación y bienestar en el corazón de las montañas, en aguas de entre 32 y 34 grados, ¡visite el espacio Balneoform del Palacio!"
    ]
  },
