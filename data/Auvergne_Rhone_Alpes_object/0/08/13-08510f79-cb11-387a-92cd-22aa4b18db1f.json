  "rdfs:comment": {
    "de": [
      "Die Logoris de l'harmonie de Saint-Pourçain präsentieren eine spritzige Komödie von Vivien Lhéraux. Inszeniert von Isabelle Cléret mit einer talentierten Truppe. Lachen und gute Laune sind garantiert! Reservierung empfohlen."
    ],
    "en": [
      "Les Logoris de l'harmonie de Saint-Pourçain present a sparkling comedy by Vivien Lhéraux. Directed by Isabelle Cléret with a talented cast. Laughter and good humor guaranteed! Reservations recommended."
    ],
    "it": [
      "Les Logoris de l'harmonie de Saint-Pourçain presentano una commedia frizzante di Vivien Lhéraux. La regia è di Isabelle Cléret con un cast di talento. Risate e buonumore garantiti! Si consiglia la prenotazione."
    ],
    "fr": [
      "Les Logoris de l'harmonie de Saint-Pourçain présentent une comédie pétillante de Vivien Lhéraux. Mise en scène par Isabelle Cléret avec une troupe talentueuse. Rires et bonne humeur garantis ! Réservation conseillée."
    ],
    "nl": [
      "Les Logoris de l'harmonie de Saint-Pourçain presenteren een sprankelende komedie van Vivien Lhéraux. Geregisseerd door Isabelle Cléret met een getalenteerde cast. Lachen en goede humor gegarandeerd! Reserveren aanbevolen."
    ],
    "es": [
      "Les Logoris de l'harmonie de Saint-Pourçain presentan una comedia chispeante de Vivien Lhéraux. Dirigida por Isabelle Cléret con un reparto de talento. Risas y buen humor garantizados Se recomienda reservar."
    ]
  },
