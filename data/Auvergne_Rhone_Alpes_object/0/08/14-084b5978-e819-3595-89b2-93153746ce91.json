  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30edb2b3-82a5-3d3f-bff8-df66c7948439",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt\n-Samstag, 13. Dezember von 10 bis 20 Uhr\n-Sonntag, 14. Dezember von 10h bis 18h\nPlatz des Dorfes - Montcavrel\n-----------------------\nOrganisiert von Montcavreloisirs\n\nAuf dem Programm stehen:\n-Lokale Produzenten\n-Geschenkideen\n-Kleine Restauration (Crêpes, Wein, heiße Schokolade)\n   Samstagabend : Croziflette\n   Sonntagmittag: O? Gras de B?uf\n\nFotoshooting mit dem Weihnachtsmann!\nCredit: Montcavreloisirs"
        ],
        "en": [
          "Christmas Market\n-Saturday December 13 from 10am to 8pm\n-Sunday, December 14, 10am to 6pm\nPlace du Village - Montcavrel\n-----------------------\nOrganized by Montcavreloisirs\n\nOn the program:\n-Local producers\n-Gift ideas\n-Snacks (crêpes, wine, hot chocolate)\n   Saturday evening: Croziflette\n   Sunday lunchtime: O? Gras de B?uf\n\nPhoto session with Santa Claus!\nCredit: Montcavreloisirs"
        ],
        "it": [
          "Mercatino di Natale\n-Sabato 13 dicembre dalle 10.00 alle 20.00\n-Domenica 14 dicembre dalle 10.00 alle 18.00\nPiazza del Villaggio - Montcavrel\n-----------------------\nOrganizzato da Montcavreloisirs\n\nIl programma\n-Produttori locali\n-Idee regalo\n-Spuntini (crêpes, vino, cioccolata calda)\n   Sabato sera : Croziflette\n   Domenica a pranzo: O? Gras de B?uf\n\nSessione fotografica con Babbo Natale!\nCredito: Montcavreloisirs"
        ],
        "fr": [
          "Marché de Noël \n-Samedi 13 décembre de 10h à 20h\n-Dimanche 14 décembre de 10h à 18h\nPlace du Village - Montcavrel\n-----------------------\nOrganisé par Montcavreloisirs\n\nAu programme : \n-Producteurs locaux\n-Idées cadeaux\n-Petite restauration (crêpes, vin, chocolat chaud)\n   Samedi soir : Croziflette\n   Dimanche midi : O’ Gras de Bœuf \n\nSéance photo avec le Père Noël !\nCrédit : Montcavreloisirs"
        ],
        "es": [
          "Mercado de Navidad\n-Sábado 13 de diciembre de 10:00 a 20:00\n-Domingo 14 de diciembre de 10h a 18h\nPlaza del Pueblo - Montcavrel\n-----------------------\nOrganizado por Montcavreloisirs\n\nEn el programa\n-Productores locales\n-Ideas para regalar\n-Aperitivos (crepes, vino, chocolate caliente)\n   Sábado por la noche : Croziflette\n   Domingo al mediodía: O? Gras de B?uf\n\nSesión de fotos con Papá Noel\nCrédito: Montcavreloisirs"
        ],
        "nl": [
          "Kerstmarkt\n-Zaterdag 13 december van 10.00 tot 20.00 uur\n-Zondag 14 december van 10 tot 18 uur\nDorpsplein - Montcavrel\n-----------------------\nGeorganiseerd door Montcavreloisirs\n\nOp het programma\n-Lokale producenten\n-Cadeau-ideeën\n-Snacks (pannenkoeken, wijn, warme chocolademelk)\n   Zaterdagavond : Croziflette\n   Zondagmiddag: O? Gras van B?uf\n\nFotosessie met de kerstman!\nKrediet: Montcavreloisirs"
        ]
      },
