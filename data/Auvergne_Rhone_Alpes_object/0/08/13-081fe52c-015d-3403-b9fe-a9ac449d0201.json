  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Herzen der Drôme des Collines unsere Ziegenzucht und die Herstellung von Käse, darunter den AOP Picodon, 5 Minuten vom Palais du Facteur Cheval entfernt."
    ],
    "en": [
      "Discover, in the heart of hilly Drôme, our goat-breeding farm and the making of cheese with the AOP (guaranteed regional production) label. Only 5 minutes from the well-known Palais Idéal du Facteur Cheval in Hauterives."
    ],
    "it": [
      "Nel cuore della Drôme des Collines, venite a scoprire il nostro allevamento di capre e la nostra produzione di formaggi, tra cui il Picodon DOP (Denominazione di Origine Protetta), a soli 5 minuti dal Palais du Facteur Cheval."
    ],
    "fr": [
      "Venez découvrir, au cœur de la Drôme des Collines, notre élevage de chèvres et notre fabrication de fromages dont le Picodon AOP (Appellation d'Origine Protégée) à 5 minutes du Palais du Facteur Cheval."
    ],
    "es": [
      "En el corazón de la Drôme des Collines, venga a descubrir nuestra granja de cabras y nuestra producción de quesos, entre ellos el Picodon DOP (Denominación de Origen Protegida), a sólo 5 minutos del Palais du Facteur Cheval."
    ],
    "nl": [
      "Boerengeitenkaas."
    ]
  },
