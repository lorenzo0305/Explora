  "rdfs:comment": {
    "de": [
      "La Table du Daria bietet Ihnen eine authentische Bistroküche, die von regionalen Produkten aus den Bergen inspiriert ist, in einer gemütlichen Atmosphäre. Erleben Sie eine einzigartige Erfahrung, die Tradition und transalpine Aromen miteinander verbindet."
    ],
    "en": [
      "La Table du Daria offers authentic bistronomic cuisine inspired by regional mountain produce, in a warm and welcoming atmosphere. Experience a unique blend of traditional and transalpine flavors."
    ],
    "it": [
      "La Table du Daria offre un'autentica cucina da bistrot ispirata ai prodotti regionali di montagna, in un'atmosfera calda e accogliente. Godetevi un'esperienza unica, che unisce tradizione e sapori transalpini."
    ],
    "fr": [
      "La Table du Daria vous propose une cuisine bistronomique authentique, inspirée des produits régionaux de montagne, dans une ambiance chaleureuse. Vivez une expérience unique, alliant tradition et saveurs transalpines."
    ],
    "es": [
      "La Table du Daria ofrece una auténtica cocina de bistró inspirada en los productos regionales de montaña, en un ambiente cálido y acogedor. Disfrute de una experiencia única, combinando tradición y sabores transalpinos."
    ],
    "nl": [
      "La Table du Daria biedt een authentieke bistrokeuken geïnspireerd door regionale bergproducten, in een warme en gastvrije sfeer. Geniet van een unieke ervaring, een combinatie van traditie en transalpiene smaken."
    ]
  },
