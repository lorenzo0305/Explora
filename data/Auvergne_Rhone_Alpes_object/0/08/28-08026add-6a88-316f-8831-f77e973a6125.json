  "rdfs:comment": {
    "de": [
      "Produzent von Rindfleisch der Limousin-Rasse, Kalbfleisch aus Mutterkuhhaltung, Freilandgeflügel, Eiern.\nVerkauf in Kisten und im Einzelhandel.\nGrillpakete Rindfleisch von April bis einschließlich September\nVerkauf von Rindfleischterrinen und -rillettes in Gläsern\nVerkauf von Fertiggerichten in Gläsern (Fleischbällchen in Tomatensauce, flämische Karbonade, Hachis parmentier, Bolognese)\nVerkaufsautomat"
    ],
    "en": [
      "Producer of Limousin beef, veal, free-range poultry, eggs.\nBoxed and retail sales.\nBeef Barbecue Packages from April to September inclusive\nSale of jarred beef terrines and rillettes\nSale of prepared dishes in jars (Meatballs in tomato sauce, Flemish stew, Shepherd's pie, Bolognese)\nVending machine"
    ],
    "it": [
      "Produttore di carne di manzo, vitello, pollame e uova di razza Limousin.\nVendita al dettaglio e confezionata.\nPacchetti per barbecue di manzo da aprile a settembre compresi\nVendita di terrine e rillettes di manzo in vasetto\nVendita di piatti pronti in barattolo (polpette al pomodoro, stufato fiammingo, pasticcio di carne, bolognese)\nDistributore automatico"
    ],
    "fr": [
      "Producteur de boeuf de race limousine, veau sous la mère, volailles fermières, oeufs.\nVente en caissettes et au détail. \nColis Barbecue Bœuf d'Avril à Septembre inclus\nVente de terrines et rillettes de bœuf en bocaux\nVente de plats préparés en bocaux (Boulettes sauce tomate ,Carbonade flamande, Hachis parmentier, Bolognaise)\nDistributeur automatique"
    ],
    "es": [
      "Productor de carne de vacuno Limousin, aves de corral camperas y huevos.\nVenta envasada y al por menor.\nPaquetes de barbacoa de ternera de abril a septiembre inclusive\nVenta de terrinas y rillettes de vacuno en tarro\nVenta de platos preparados en tarros (albóndigas en salsa de tomate, estofado flamenco, pastel de pastor, boloñesa)\nMáquina expendedora automática"
    ],
    "nl": [
      "Producent van Limousin-rundvlees, kalfsvlees, scharrelpluimvee en eieren.\nVerpakte producten en detailhandel.\nBarbecuepakketten met rundvlees van april tot en met september\nVerkoop van rundvleesterrines en rillettes in potten\nVerkoop van bereide gerechten in potten (Gehaktballetjes in tomatensaus, Vlaams stoofvlees, Herderstaart, Bolognese)\nVerkoopautomaat"
    ]
  },
