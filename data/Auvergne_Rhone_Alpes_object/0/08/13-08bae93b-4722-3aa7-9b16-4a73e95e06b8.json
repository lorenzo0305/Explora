  "rdfs:comment": {
    "de": [
      "Der Grésy-See mit seinen barrierefreien Angelstellen für Menschen mit eingeschränkter Mobilität ist der perfekte Ort für entspanntes Familienangeln auf Raubfische, Karpfen und andere Weißfische."
    ],
    "en": [
      "The Grésy lake, with its accessible fishing spots for people with reduced mobility, is the perfect place for relaxing family fishing for predators, carp and other white fish."
    ],
    "it": [
      "Il lago di Grésy, con i suoi punti di pesca accessibili anche alle persone con mobilità ridotta, è il luogo ideale per una rilassante pesca in famiglia di predatori, carpe e altri pesci bianchi."
    ],
    "fr": [
      "Plan d'eau de détente par excellence, le plan d'eau de Grésy avec ses postes de pêche accessible PMR est idéal pour une pêche de détente en famille des carnassiers, de la carpe et autres poissons blancs."
    ],
    "nl": [
      "Het Grésy-meer, met zijn toegankelijke visplekken voor mensen met een beperkte mobiliteit, is de perfecte plek voor een ontspannen familievisserij op roofvissen, karpers en andere witvissen."
    ],
    "es": [
      "El lago de Grésy, con sus lugares de pesca accesibles para personas con movilidad reducida, es el lugar perfecto para pescar en familia y de forma relajante de depredadores, carpas y otros pescados blancos."
    ]
  },
  "rdfs:label": {
    "de": [
      "„Familien“-Angelpfad am See von Grésy-sur-Isère"
    ],
    "en": [
      "\"Family\" fishing trail at Lake Grésy-sur-Isère"
    ],
    "it": [
      "Sentiero di pesca \"famiglia\" sul lago di Grésy-sur-Isère"
    ],
    "fr": [
      "Parcours pêche \"Famille\" du lac de Grésy-sur-Isère"
    ],
    "es": [
      "Zona de pesca \"familiar\" del lago Grésy-sur-Isère"
    ],
    "nl": [
      "Vispad \"Familie\" aan het meer van Grésy-sur-Isère"
    ]
  },
