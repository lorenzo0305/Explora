  "rdfs:comment": {
    "de": [
      "Ma Balade à Vélo liegt am Grünen Weg Via Ardèche und ist der Spezialist für den Verleih von Elektrofahrrädern in der südlichen Ardèche. Ob mit der Familie oder mit Freunden, die elektrischen VTCs und das angebotene Zubehör garantieren Ihnen eine gelungene Radtour."
    ],
    "en": [
      "Located on the Via Ardèche greenway, Ma Balade à Vélo is the specialist in electric bike rental in the South Ardèche. Whether with family or friends, the electric VTCs and accessories on offer will guarantee you a successful bike ride."
    ],
    "it": [
      "Specialista in biciclette da diporto a pedalata assistita per tutta la famiglia.\r\nSituato lungo la Via Ardèche a Ruoms."
    ],
    "fr": [
      "Spécialiste du vélo à assistance électrique de loisir pour toute la famille.\r\nInstallé le long de la Via Ardèche à Ruoms."
    ],
    "nl": [
      "Ma Balade à Vélo, gelegen aan de groene weg Via Ardèche, is de specialist in het verhuren van elektrische fietsen in de Zuidelijke Ardèche. Met familie of vrienden, de aangeboden elektrische VTC's en accessoires garanderen je een geslaagde fietstocht."
    ],
    "es": [
      "Especialista en bicicletas de ocio con asistencia eléctrica para toda la familia.\r\nSituado a lo largo de la Via Ardèche en Ruoms."
    ]
  },
