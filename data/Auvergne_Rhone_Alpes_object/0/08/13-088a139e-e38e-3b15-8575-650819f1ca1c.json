  "rdfs:comment": {
    "de": [
      "En K2 Pause bietet Tagesgerichte, aktuellen Fisch oder Metzgerstück mit Pommes frites oder Gemüse, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "En K2 Pause offers daily specials, fish of the moment or Pièce du Boucher with French fries or vegetables, on the spot or to take away."
    ],
    "it": [
      "En K2 Pause offre specialità giornaliere, pesce del momento o tagli di macelleria, patatine fritte o verdure, da consumare all'interno o da asporto."
    ],
    "fr": [
      "En K2 Pause propose des plats du jour, poisson du moment ou Pièce du Boucher frites ou Légumes , sur place ou à emporter."
    ],
    "es": [
      "En K2 Pause ofrecen platos del día, pescado del momento o cortes de carnicería, patatas fritas o verduras, para comer en el restaurante o para llevar."
    ],
