  "rdfs:comment": {
    "de": [
      "Céline und Renaud Bouxin, Landwirte in Any-Martin-Rieux, züchten Kühe der Rasse Blonde d'Aquitaine und bieten Ihnen Fleischpakete an, die von einer zugelassenen Werkstatt vakuumverpackt werden. Auf dem Betrieb: freitags ab 16H00, Bestellungen werden vorab telefonisch entgegengenommen."
    ],
    "en": [
      "Céline and Renaud Bouxin, farmers in Any-Martin-Rieux, raise cows of the Blonde d'Aquitaine breed and offer you vacuum-packed meat packages from an approved workshop. On the farm: Fridays from 4:00 pm, orders must be made in advance by phone."
    ],
    "it": [
      "Céline e Renaud Bouxin, allevatori di Any-Martin-Rieux, allevano vacche di razza Blonde d'Aquitaine e vi offrono confezioni di carne sottovuoto provenienti da un laboratorio autorizzato. In azienda: il venerdì dalle ore 16.00, le ordinazioni vengono prese telefonicamente in anticipo."
    ],
    "fr": [
      "Céline et Renaud Bouxin, éleveurs à Any-Martin-Rieux, élèvent des vaches de race blonde d’Aquitaine et vous proposent des colis de viande conditionnés sous vide par un atelier agréé. Sur l’exploitation : les vendredis à partir de 16H00, les commandes se font au préalable par téléphone."
    ],
    "es": [
      "Céline y Renaud Bouxin, criadores de Any-Martin-Rieux, crían vacas de la raza Blonde d'Aquitaine y le ofrecen paquetes de carne envasados al vacío en un taller autorizado. En la granja: los viernes a partir de las 16:00 horas, los pedidos se toman por teléfono previamente."
    ],
    "nl": [
      "Céline en Renaud Bouxin, fokkers van Any-Martin-Rieux, fokken koeien van het ras Blonde d'Aquitaine en bieden u vacuümverpakte vleespakketten uit een erkend atelier. Op de boerderij: vrijdag vanaf 16.00 uur, bestellingen moeten vooraf telefonisch worden doorgegeven."
    ]
  },
