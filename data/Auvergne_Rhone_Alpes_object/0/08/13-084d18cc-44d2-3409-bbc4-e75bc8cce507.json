  "rdfs:comment": {
    "de": [
      "Seifenfabrik von Vercors\r\nHerstellung von Pflegeseifen (Kaltverseifung) und Naturkosmetik (mit Wildpflanzen aus dem Vercors) mit biologischen Rohstoffen.\r\nKostenlose Besichtigung der Werkstatt & Boutique.\r\nPflege im Dienste Ihrer Haut."
    ],
    "en": [
      "Savonnerie du Vercors\r\nProduction of care soaps (cold saponification) and natural cosmetics (with wild Vercors plants) using organic raw materials.\r\nFree tour of the workshop & boutique.\r\nCare for your skin."
    ],
    "it": [
      "Savonnerie du Vercors\r\nProduzione di saponi curativi (saponificazione a freddo) e cosmetici naturali (con piante selvatiche del Vercors) utilizzando materie prime biologiche.\r\nVisita gratuita del laboratorio e del negozio.\r\nCura della pelle."
    ],
    "fr": [
      "Savonnerie du Vercors\r\nFabrication de savons de soins (saponification à froid) et cosmétiques naturels (aux plantes sauvages du Vercors) avec des matières premières biologiques.\r\nVisite gratuite de l'atelier & boutique.\r\nDes soins au service de votre peau."
    ],
    "nl": [
      "Savonnerie du Vercors\r\nProductie van verzorgende zepen (koude verzeping) en natuurlijke cosmetica (met wilde Vercorsplanten) met biologische grondstoffen.\r\nGratis rondleiding door het atelier en de winkel.\r\nVerzorg je huid."
    ],
    "es": [
      "Savonnerie du Vercors\r\nFabricación de jabones de cuidado (saponificación en frío) y cosméticos naturales (con plantas silvestres de Vercors) a partir de materias primas ecológicas.\r\nVisita gratuita del taller y la tienda.\r\nCuide su piel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier de la source"
    ]
  },
