  "rdfs:comment": {
    "de": [
      "Mit 1900 m² Fläche, die dem Klettern gewidmet ist, 300 Routen aller Schwierigkeitsgrade, einem Boulderbereich und einem Anfängerbereich. EV Grenoble ist der ideale Ort, um das Klettern zu erlernen oder seine Technik zu perfektionieren, während Sie auf die schöne Jahreszeit warten!"
    ],
    "en": [
      "With 1900 square feet of climbing area, 300 colored routes and a bouldering space, EV Grenoble is the perfect place to learn climbing or to train hard before the sunny days !"
    ],
    "it": [
      "Con 1.900 m² dedicati all'arrampicata, 300 vie per tutti i livelli, un'area boulder e un'area per principianti. EV Grenoble è il luogo ideale per imparare ad arrampicare o per perfezionare la propria tecnica in attesa dell'estate!"
    ],
    "fr": [
      "Avec ses 1900m² de surfaces dédiées à l'escalade, 300 voies de tous niveaux, un espace bloc et un espace initiation. EV Grenoble est le lieu idéal pour apprendre l'escalade ou bien parfaire sa technique en attendant la belle saison !"
    ],
    "nl": [
      "Met 1.900m² gewijd aan klimmen, 300 routes voor alle niveaus, een bouldergebied en een beginnersgebied. EV Grenoble is de ideale plek om te leren klimmen of om je techniek te perfectioneren terwijl je wacht op de zomer!"
    ],
    "es": [
      "Con 1.900 m² dedicados a la escalada, 300 vías para todos los niveles, una zona de búlder y una zona para principiantes. EV Grenoble es el lugar ideal para aprender a escalar o perfeccionar tu técnica mientras esperas al verano"
    ]
  },
  "rdfs:label": {
    "en": [
      "Espace Vertical Grenoble"
    ],
    "fr": [
      "Espace Vertical 3 Grenoble - Salle d'escalade"
    ]
  },
