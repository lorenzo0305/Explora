  "rdfs:comment": {
    "de": [
      "Ökologischer Bienenhof seit 1972, der sich für die Erhaltung der Dunklen Biene, unserer lokalen Bauernbiene, einsetzt. Gründer des Vereins \"L'abeille noire des Boutières\". Produkte aus dem Bienenstock, Kastanien, Äpfel, Beeren."
    ],
    "en": [
      "Ecological bee farm since 1972, committed to the conservation of the black bee, our local peasant bee. Founder of the \"L'abeille noire des Boutières\" association. Hive products, chestnuts, apples, berries."
    ],
    "it": [
      "Azienda apistica ecologica dal 1972, impegnata nella conservazione dell'ape nera, la nostra ape contadina locale. Fondatore dell'associazione \"L'abeille noire des Boutières\". Prodotti dell'alveare, castagne, mele, frutti di bosco."
    ],
    "fr": [
      "Ferme apicole écologique depuis 1972, engagée dans la conservation de l'abeille noire, notre abeille paysanne locale. Fondateur de l'association \"L'abeille noire des Boutières\". Produits de la ruche, châtaigne, pommes, petits fruits."
    ],
    "es": [
      "Explotación apícola ecológica desde 1972, comprometida con la conservación de la abeja negra, nuestra abeja campesina local. Fundador de la asociación \"L'abeille noire des Boutières\". Productos de la colmena, castañas, manzanas, bayas."
    ],
    "nl": [
      "Ecologische imkerij sinds 1972, toegewijd aan het behoud van de zwarte bij, onze lokale boerenbij. Oprichter van de vereniging \"L'abeille noire des Boutières\". Producten van de bijenkorf, kastanjes, appels, bessen."
    ]
  },
