  "rdfs:comment": {
    "de": [
      "Familienbetrieb mit 16 Hektar AB-Weinbergen, Kellerbesichtigung und Weinlehrpfade. Anbau von Getreide in AB. Brauerei mit unserem gemälzten Getreide. Schatzsuche für Kinder und Möglichkeit eines Imbisses vor Ort nach vorheriger Reservierung."
    ],
    "en": [
      "Family estate with 18 hectares of AB vines, cellar tours and wine trails. Organic cereal growing. Brewer with our malted cereals. Children's treasure hunt and snack bar available on reservation."
    ],
    "it": [
      "Tenuta familiare con 16 ettari di vigneti AB, visite in cantina e percorsi enologici. Coltivazione biologica di cereali. Produzione di birra con i nostri cereali maltati. Caccia al tesoro per bambini e snack bar disponibili su prenotazione."
    ],
    "fr": [
      "Domaine familial de 16 hectares de vignes en AB, visite de cave et sentiers oenotouristiques. Culture de céréales en AB. Brasseur avec nos céréales maltées. Chasse aux trésors pour les enfants et possibilité de casse-croûte sur place sur réservation."
    ],
    "es": [
      "Finca familiar con 16 hectáreas de viñedos AB, visitas a bodegas y rutas del vino. Cultivo ecológico de cereales. Elaboración de cerveza con nuestros cereales malteados. Búsqueda del tesoro para niños y merienda en el bar con reserva previa."
    ],
    "nl": [
      "Familie landgoed van 15 hectare is overgegaan naar biologische landbouw. Cultuur van Bourgondische truffel - uncinatum. Oenotouristische wandelpaden."
    ]
  },
