  "rdfs:comment": {
    "de": [
      "Die Kapelle des Hospizes, die dem Heiligen Nikolaus und dem Heiligen Jakobus geweiht ist, wurde zum letzten Mal im 16. Jahrhundert im gotischen Stil umgebaut. Das Gebäude weist ein wunderschönes Gewölbe auf, das auf geschnitzten Sandsteinen ruht."
    ],
    "en": [
      "The Hospice Chapel, dedicated to Saint Nicholas and Santiago de Compostela, was last rebuilt in the 16th century in a Gothic style. The building has a magnificent vault resting on carved sandpits."
    ],
    "it": [
      "La cappella dell'Ospizio, dedicata a San Nicola e a Santiago de Compostela, fu ricostruita per l'ultima volta nel XVI secolo in stile gotico. L'edificio presenta una magnifica volta che poggia su sablières intagliati."
    ],
    "fr": [
      "La chapelle de l'Hospice, dédiée à Saint Nicolas et à Saint-Jacques de Compostelle, fut reconstruite pour la dernière fois au XVIème siècle dans un style gothique. L'édifice présente une magnifique voûte reposant sur des sablières sculptées."
    ],
    "es": [
      "La Capilla del Hospicio, dedicada a San Nicolás y a Santiago de Compostela, fue reconstruida por última vez en el siglo XVI en estilo gótico. El edificio tiene una magnífica bóveda que descansa sobre sables tallados."
    ],
    "nl": [
      "De hospitaalkapel, gewijd aan Sint-Nicolaas en Santiago de Compostela, werd voor het laatst herbouwd in de 16e eeuw in gotische stijl. Het gebouw heeft een prachtig gewelf dat rust op gebeeldhouwde sablières."
    ]
  },
