  "rdfs:comment": {
    "de": [
      "Site de la Caboche, angelegte und gesicherte Piste, die von einem überdachten und kostenlosen Förderband bedient wird (ohne Zugangspass Chamois/Rocharbois). Ab 2 Jahren."
    ],
    "en": [
      "La Caboche site, equipped and secure run served by a free covered conveyor belt (excluding Chamois/Rocharbois access pass). For children aged 2 and over."
    ],
    "it": [
      "Sito di La Caboche, pista attrezzata e sicura servita da un nastro trasportatore coperto gratuito (escluso il pass di accesso Chamois/Rocharbois). Per i bambini a partire dai 2 anni."
    ],
    "fr": [
      "Site de la Caboche, piste aménagée et sécurisée desservie par un tapis roulant couvert et gratuit (hors forfait accès Chamois/Rocharbois). A partir de 2 ans."
    ],
    "nl": [
      "Terrein van La Caboche, uitgerust en beveiligd parcours met gratis overdekte transportband (behalve toegangspas Chamois/Rocharbois). Voor kinderen vanaf 2 jaar."
    ],
    "es": [
      "Recinto de La Caboche, pista segura y equipada servida por una cinta transportadora cubierta y gratuita (sin forfait de acceso a Chamois/Rocharbois). Para niños a partir de 2 años."
    ]
  },
