  "rdfs:comment": {
    "de": [
      "Produzent von Obst und Gemüse.\r\nDrive fermier und Direktverkauf ab Hof, und freitags und sonntags auf dem Markt in Romans sur Isère präsent."
    ],
    "en": [
      "Fruit and vegetable producer.\nFarm drive and direct sales at the farm, and present at the Romans sur Isère market on Fridays and Sundays."
    ],
    "it": [
      "Produttore di frutta e verdura.\r\nConduzione dell'azienda agricola e vendita diretta in azienda, e presenza al mercato di Romans sur Isère il venerdì e la domenica"
    ],
    "fr": [
      "Producteur de fruits, de légumes.\r\nDrive fermier et vente directe à la ferme, et présent sur le marché de Romans sur Isère les vendredis et dimanche"
    ],
    "es": [
      "Productor de frutas y verduras.\r\nConducción de la explotación y venta directa en la granja, y presencia en el mercado de Romans sur Isère los viernes y domingos"
    ],
    "nl": [
      "Producent van groenten en fruit.\nFarm drive en directe verkoop op de boerderij, en aanwezig op de Romans sur Isère markt op vrijdag en zondag."
    ]
  },
