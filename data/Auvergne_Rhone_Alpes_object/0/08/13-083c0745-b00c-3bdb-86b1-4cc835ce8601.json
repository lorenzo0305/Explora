  "rdfs:comment": {
    "de": [
      "Bar, Restaurant, Eisdiele zwischen See und Kanal.\r\nBrasero gambas à all you can eat am Montagabend von Mai bis September. Froschschenkel, frittierter Barsch, Lavaret."
    ],
    "en": [
      "Bar, restaurant, ice cream parlor between the lake and the canal.\r\nAll-you-can-eat shrimp on the grill on Monday evenings from May to September. Frog legs, fried perch, lavaret."
    ],
    "it": [
      "Bar, ristorante, gelateria tra il lago e il canale.\r\nGamberi alla brace a volontà il lunedì sera da maggio a settembre. Cosce di rana, frittura di persici, lavarello."
    ],
    "fr": [
      "Bar, restaurant, glacier entre lac et canal.\r\nBrasero gambas à volonté le lundi soir de mai à septembre. Cuisses de grenouilles, friture de perchots, lavaret."
    ],
    "es": [
      "Bar, restaurante, heladería entre el lago y el canal.\r\nBrasero de gambas todo lo que puedas comer los lunes por la noche de mayo a septiembre. Ancas de rana, perca frita, lavaret."
    ],
    "nl": [
      "Bar, restaurant, ijssalon tussen meer en kanaal.\r\nGambaschotel met alles erop en eraan op maandagavond van mei tot september. Kikkerbilletjes, gebakken baars, lavaret."
    ]
  },
