  "rdfs:comment": {
    "de": [
      "Bernex Tourisme steht Ihnen für alle verschiedenen Informationen über den Dorfort Bernex und seine umliegenden Dörfer im Pays de Gavot und Pays d'Evian-vallée d'Abondance sowie in der benachbarten Schweiz zur Verfügung."
    ],
    "en": [
      "Bernex Tourism is at your disposal for any information concerning the resort-village of Bernex and its surrounding villages of the Pays de Gavot and the Pays d'Evian-vallée d'Abondance as well as the neighbouring Switzerland."
    ],
    "it": [
      "Bernex Tourism è a vostra disposizione per tutte le informazioni sul villaggio turistico di Bernex e sui villaggi circostanti nelle regioni di Gavot e Evian-Vallée d'Abondance e nella vicina Svizzera."
    ],
    "fr": [
      "Bernex Tourisme est à votre disposition pour toutes les informations diverses concernant la station-village de Bernex et ses villages environnants du pays de Gavot et du Pays d'Evian-vallée d'Abondance ainsi que de la Suisse voisine."
    ],
    "es": [
      "Bernex Turismo está a su disposición para toda la información relativa a la localidad-balneario de Bernex y sus pueblos circundantes en las regiones de Gavot y Evian-Vallée d'Abondance, así como en la vecina Suiza."
    ],
    "nl": [
      "Bernex Tourism staat tot uw beschikking voor alle informatie over het resort-dorp Bernex en de omliggende dorpen in de regio's Gavot en Evian-Vallée d'Abondance, evenals in het aangrenzende Zwitserland."
    ]
  },
