  "rdfs:comment": {
    "de": [
      "Les Temps Nouveaux empfängt Sie am Ortseingang von Estivareilles, um Ihnen je nach Jahreszeit eine feine, geschmackvolle Küche zu bieten, die ausschließlich frische und lokale Produkte verwendet."
    ],
    "en": [
      "In a setting where heritage mixes with nature, Les Temps Nouveaux suggests a traditional cooking. Several options available : banquets, groups and family meals. Only on request."
    ],
    "it": [
      "Les Temps Nouveaux vi accoglie all'ingresso del villaggio di Estivareilles per offrirvi, a seconda delle stagioni, una cucina raffinata, fatta solo di prodotti freschi e locali."
    ],
    "fr": [
      "Les Temps Nouveaux vous accueillent à l'entrée du village d'Estivareilles pour vous faire découvrir, au gré des saisons, une cuisine fine, au goût du jour, confectionnée uniquement à base de produits frais et locaux."
    ],
    "nl": [
      "Les Temps Nouveaux ontvangt u bij de ingang van het dorp Estivareilles om u, afhankelijk van de seizoenen, een fijne keuken aan te bieden, uitsluitend bereid met verse en lokale producten."
    ],
    "es": [
      "Les Temps Nouveaux le da la bienvenida a la entrada del pueblo de Estivareilles para ofrecerle, según las estaciones, una cocina fina, elaborada únicamente con productos frescos y locales."
    ]
  },
  "rdfs:label": {
    "de": [
      "Traditionelle und gastronomische Küche - Les Temps Nouveaux"
    ],
    "en": [
      "Les Temps Nouveaux Restaurant"
    ],
    "fr": [
      "Les Temps Nouveaux"
    ]
  },
