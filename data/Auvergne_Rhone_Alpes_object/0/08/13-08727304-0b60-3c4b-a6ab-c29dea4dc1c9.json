  "rdfs:comment": {
    "de": [
      "Willkommen auf dem GAEC à la Bonne Fourche, einem Familienbetrieb im Herzen des Mézenc, wo Aubrac-Rinder in Freilandhaltung gezüchtet werden. Ihre Spezialität ist das Bœuf Fin Gras du Mézenc, das in Metzgereien verkauft wird. Auf dem Hof werden Sirupe und Heugelees verkauft."
    ],
    "en": [
      "Welcome to GAEC à la Bonne Fourche, a family farm nestled in the heart of the Mézenc, where Aubrac cows are raised in the open air. Their specialty: Fin Gras du Mézenc beef, sold in butcher shops. On sale at the farm are hay syrups and jellies."
    ],
    "it": [
      "Benvenuti al GAEC à la Bonne Fourche, un'azienda agricola a conduzione familiare situata nel cuore del Mézenc, dove si allevano mucche di razza Aubrac. La loro specialità: la carne Fin Gras du Mézenc, venduta nelle macellerie. In azienda si vendono anche sciroppi e gelatine di fieno."
    ],
    "fr": [
      "Bienvenue au GAEC à la Bonne Fourche, une ferme familiale nichée au cœur du Mézenc, où sont élevées des vaches Aubrac en plein air. Leur spécialité : le bœuf Fin Gras du Mézenc vendu en boucherie. Retrouvez, en vente à la ferme, sirops et gelées de foin."
    ],
    "nl": [
      "Welkom bij GAEC à la Bonne Fourche, een familieboerderij in het hart van de Mézenc, waar Aubrac-koeien met vrije uitloop worden gehouden. Hun specialiteit: het rundvlees Fin Gras du Mézenc, dat in de slagerij wordt verkocht. Op de boerderij wordt ook hooisiroop en gelei verkocht."
    ],
    "es": [
      "Bienvenido al GAEC à la Bonne Fourche, una granja familiar situada en el corazón del Mézenc, donde se crían vacas de raza Aubrac en libertad. Su especialidad: la ternera Fin Gras du Mézenc, que se vende en las carnicerías. En la granja también se venden jarabes y jaleas de heno."
    ]
  },
  "rdfs:label": {
