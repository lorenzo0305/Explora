  "rdfs:comment": {
    "de": [
      "IHRE GOURMET-BURGER IN MONTLUÇON, AUSSERGEWÖHNLICHES FLEISCH UND HAUSGEMACHTE POMMES FRITES TRADITION.\r\nErliegen Sie dem ultimativen kulinarischen Erlebnis mit unseren Fleischrassen-Burgern (Limousine, Charolais) und gereiften Käsesorten zum Mitnehmen oder als Lieferservice!"
    ],
    "en": [
      "YOUR GOURMET BURGERS IN MONTLUÇON, EXCEPTIONAL MEAT AND TRADITIONAL HOME FRIES.\r\nSuccumb to the ultimate culinary experience with our Burgers featuring meat breeds (Limousine, Charolaise) and mature cheeses to take away or deliver!"
    ],
    "it": [
      "I VOSTRI HAMBURGER GOURMET A MONTLUÇON, CARNE ECCEZIONALE E PATATINE TRADIZIONALI.\r\nProvate l'esperienza culinaria più bella con i nostri hamburger di carne (Limousin, Charolais) e i nostri formaggi stagionati da portare via o da consegnare!"
    ],
    "fr": [
      "VOS BURGERS GOURMETS À MONTLUÇON, VIANDE D'EXCEPTION ET FRITES MAISON TRADITION.\r\nSuccombez à l'expérience culinaire ultime avec nos Burgers aux races à viande (Limousine, Charolaise) et fromages affinés à emporter ou en livraison !"
    ],
    "es": [
      "SUS HAMBURGUESAS GOURMET EN MONTLUÇON, CARNE EXCEPCIONAL Y PATATAS FRITAS CASERAS TRADICIONALES.\r\nSucumba a la experiencia culinaria definitiva con nuestras hamburguesas de carne (Limousin, Charolais) y quesos curados para llevar o entregar a domicilio"
    ],
    "nl": [
      "JE HAMBURGERS VOOR FIJNPROEVERS IN MONTLUÇON, UITZONDERLIJK VLEES EN TRADITIONELE FRIETJES VAN HET HUIS.\r\nGeniet van de ultieme culinaire ervaring met onze vleesburgers (Limousin, Charolais) en gerijpte kazen om mee te nemen of te bezorgen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restauration à emporter : Cocotte Burger"
    ]
  },
