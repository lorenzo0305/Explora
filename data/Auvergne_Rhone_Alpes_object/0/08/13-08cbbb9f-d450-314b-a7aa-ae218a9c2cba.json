  "rdfs:comment": {
    "de": [
      "Diese kurze, gut zugängliche Strecke in der Gemeinde Vallon-en-Sully eignet sich hervorragend für alle, die einen angenehmen Spaziergang suchen, der Natur, Kulturerbe und dörfliche Ruhe miteinander verbindet."
    ],
    "en": [
      "This short, accessible circuit in Vallon-en-Sully is perfect for those looking for a pleasant walk combining nature, heritage and village tranquillity."
    ],
    "it": [
      "Questo percorso breve e accessibile attraverso Vallon-en-Sully è perfetto per chi cerca una piacevole passeggiata che combini natura, patrimonio e tranquillità del villaggio."
    ],
    "fr": [
      "Ce circuit court et accessible sur la commune de Vallon-en-Sully convient parfaitement à ceux qui recherchent une promenade agréable, mêlant nature, patrimoine et quiétude villageoise."
    ],
    "es": [
      "Esta ruta corta y accesible por Vallon-en-Sully es perfecta para quienes buscan un paseo agradable que combine naturaleza, patrimonio y tranquilidad de pueblo."
    ],
    "nl": [
      "Deze korte, toegankelijke route door Vallon-en-Sully is perfect voor wie op zoek is naar een aangename wandeling die natuur, erfgoed en dorpse rust combineert."
    ]
  },
  "rdfs:label": {
    "fr": [
