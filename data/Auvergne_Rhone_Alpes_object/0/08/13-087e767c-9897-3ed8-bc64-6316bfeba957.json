  "rdfs:comment": {
    "de": [
      "Familienweingut, \r\njeder unserer Weine spie- gelt unsere Leidenschaft für unsere verschie- denen Gebiete wider, Verkostung feiner und seidiger, sowie komplexer und \r\ntanninhaltiger, Rot-, Weiß- und Roséweine."
    ],
    "en": [
      "Family-owned wine estate producing wines which reflect their passion for the land, delicious red, white and rosé."
    ],
    "it": [
      "Vigneti a conduzione familiare dal 1926, questi viticoltori lavorano con passione le vigne da 4 generazioni. La loro gamma di vini comprende rosso, bianco e rosé."
    ],
    "fr": [
      "Vignoble familial depuis 1926, vignerons récoltants, passionnés par le travail de la vigne depuis 4 générations. Leur gamme de vins se décline en rouge, blanc et rosé."
    ],
    "es": [
      "Viñedo familiar desde 1926, estos viticultores se dedican con pasión al trabajo de la vid desde hace 4 generaciones. Su gama de vinos incluye tintos, blancos y rosados."
    ],
    "nl": [
      "Familiale wijngaard, al onze wijnen drukken onze passie uit voor onze verscheidene domeinen, u proeft smaakvolle, zijdeachtige wijnen, complexe en \r\ntanninerijke wijnen, rood, wit en rosé."
    ]
  },
