  "rdfs:comment": {
    "de": [
      "Die Touristeninformation Sucs & Loire Tourisme - Büro Yssingeaux empfängt Sie das ganze Jahr über, um Ihnen Informationen zu geben und Ihren Aufenthalt in unseren Dörfern zu erleichtern."
    ],
    "en": [
      "The Sucs & Loire Tourisme - Yssingeaux Tourist Information Office welcomes you all year round to help you make the most of your stay in our villages."
    ],
    "it": [
      "L'Ufficio del Turismo di Sucs & Loire - Yssingeaux è aperto tutto l'anno per aiutarvi a sfruttare al meglio il vostro soggiorno nei nostri villaggi."
    ],
    "fr": [
      "Le Bureau d'information touristique Sucs & Loire Tourisme - Bureau d'Yssingeaux vous accueille toute l'année pour vous renseigner et faciliter votre séjour dans nos villages."
    ],
    "es": [
      "La Oficina de Turismo de Sucs & Loire Tourisme - Yssingeaux está abierta todo el año para ayudarle a aprovechar al máximo su estancia en nuestros pueblos."
    ],
    "nl": [
      "Het VVV-kantoor van Sucs & Loire - Yssingeaux is het hele jaar geopend om u te helpen optimaal van uw verblijf in onze dorpen te genieten."
    ]
  },
