  "rdfs:comment": {
    "de": [
      "Eine intime Adresse im Stadtzentrum von Montélimar, abseits des Trubels, an einem schönen schattigen Platz. Ein einladender Ort, an dem sich Authentizität, Aromen aus aller Welt und hausgemachte Küche vermischen. Entdecken Sie unser entspanntes Gourmet-Universum"
    ],
    "en": [
      "An intimate address in downtown Montélimar, away from the hustle and bustle, on a beautiful shaded square. A welcoming place to live where authenticity, world flavors and home cooking are mixed. Come and discover our gourmet and relaxed universe"
    ],
    "it": [
      "Un indirizzo intimo nel centro di Montélimar, lontano dal trambusto, in una bella piazza ombreggiata. Un luogo accogliente dove si fondono autenticità, sapori del mondo e cucina casalinga. Venite a scoprire il nostro mondo rilassato e gourmet"
    ],
    "fr": [
      "Une adresse intimiste du centre ville de Montélimar, à l’écart de l’agitation, sur une belle place ombragée. Un lieu de vie accueillant où se mélangent authenticité, saveurs du monde et cuisine maison. Venez découvrir notre univers gourmand et décontracté"
    ],
    "es": [
      "Una dirección íntima en el centro de Montélimar, lejos del bullicio, en una bonita plaza sombreada. Un lugar acogedor donde se unen la autenticidad, los sabores del mundo y la cocina casera. Venga a descubrir nuestro mundo gastronómico y relajado"
    ],
    "nl": [
      "Een intiem adresje in het centrum van Montélimar, weg van de drukte, aan een heerlijk schaduwrijk plein. Een gastvrije plek waar authenticiteit, wereldse smaken en huisgemaakte gerechten samenkomen. Kom en ontdek onze ontspannen, gastronomische wereld"
    ]
  },
