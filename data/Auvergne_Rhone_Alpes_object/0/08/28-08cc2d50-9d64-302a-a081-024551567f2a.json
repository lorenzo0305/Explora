  "rdfs:comment": {
    "de": [
      "Das Sphinx ist ein Lounge-Restaurant mit Veranstaltungen an den Wochenenden. Es befindet sich im Stadtzentrum von Amiens, am Fuße der Kathedrale, und seine Dekoration und Speisekarte laden zum Reisen ein."
    ],
    "en": [
      "The Sphinx is a lounge restaurant, with animations generally planned on weekends, located in the center of Amiens, at the foot of the cathedral, with a decoration and a menu which invite to travel."
    ],
    "it": [
      "La Sfinge è un ristorante lounge, con intrattenimento generalmente previsto nei fine settimana, situato nel cuore di Amiens, ai piedi della cattedrale, con una decorazione e un menu che invitano al viaggio."
    ],
    "fr": [
      "Le Sphinx est un restaurant lounge, avec des animations généralement prévues les weekends, situé en plein centre ville d'Amiens, au pied de la cathédrale, avec une déco et une carte qui invitent au voyage."
    ],
    "es": [
      "La Esfinge es un restaurante lounge, con animación prevista generalmente para los fines de semana, situado en pleno centro de Amiens, a los pies de la catedral, con una decoración y una carta que invitan a viajar."
    ],
    "nl": [
      "De Sfinx is een loungerestaurant, met meestal in het weekend entertainment, gelegen in het centrum van Amiens, aan de voet van de kathedraal, met een inrichting en een menu die uitnodigen tot reizen."
    ]
  },
