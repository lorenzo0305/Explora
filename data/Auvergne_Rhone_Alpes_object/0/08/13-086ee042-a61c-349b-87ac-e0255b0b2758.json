  "rdfs:comment": {
    "de": [
      "Die Freunde der Stiftskirche Saint-Barnard und des Calvaire des Récollets bieten den ganzen Sommer über Führungen durch den Kreuzweg und den Calvaire des Récollets an. Kommen Sie zahlreich, um diese Angebote zu nutzen!"
    ],
    "en": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets (Friends of the Collegiate Church of Saint-Barnard and the Calvary of the Récollets) are offering guided tours of the Way of the Cross and the Calvary of the Récollets throughout the summer. Come one, come all!"
    ],
    "it": [
      "Gli Amici della Collegiata di Saint-Barnard e del Calvario dei Récollets propongono visite guidate alla Via Crucis e al Calvario dei Récollets per tutta l'estate, non mancate!"
    ],
    "fr": [
      "Les Amis de la Collégiale Saint-Barnard et du Calvaire des Récollets vous propose des visites guidées du Chemin de croix et du Calvaire des Récollets tout au long de l'été, venez nombreux pour en profiter !"
    ],
    "es": [
      "Los Amigos de la Colegiata de Saint-Barnard y del Calvario de los Récollets proponen visitas guiadas al Vía Crucis y al Calvario de los Récollets durante todo el verano, ¡no se lo pierda!"
    ],
    "nl": [
      "De Vrienden van de collegiale kerk Saint-Barnard en de calvarieberg van de Récollets bieden de hele zomer rondleidingen aan langs de kruisweg en de calvarieberg van de Récollets, dus mis het niet!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Chemin de croix et du calvaire des Récollets"
    ]
  },
