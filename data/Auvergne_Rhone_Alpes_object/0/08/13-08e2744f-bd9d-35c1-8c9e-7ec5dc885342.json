  "rdfs:comment": {
    "de": [
      "Les Crinières d'Attel'Anges, das ist die Möglichkeit, mit der Familie oder mit Freunden zu großen und kleinen Anlässen in einer Kutsche (Wagen für 5 oder 12 Personen) zu entfliehen. Genießen Sie den Moment, gewiegt vom Schritt der Pferde und der Freundlichkeit von Blandine."
    ],
    "en": [
      "Les Crinières d'Attel’Anges is the opportunity to escape in a carriage (wagon of 5 to 12 people) with family or friends. Enjoy the moment, rocked by the footsteps of horses and the kindness of Blandine."
    ],
    "it": [
      "Les Crinières d'Attel'Anges vi offrono la possibilità di staccare la spina in una carrozza trainata da cavalli (per 5 o 12 persone) con la famiglia o gli amici, per grandi o piccole occasioni. Godetevi il momento, cullati dal passo dei cavalli e dalla gentilezza di Blandine."
    ],
    "fr": [
      "Les Crinières d'Attel'Anges, c'est la possibilité de s'évader en calèche (chariot de 5 ou 12 personnes) en famille ou entre amis, pour de grandes et petites occasions. Profitez du moment, bercés par le pas des chevaux et la gentillesse de Blandine."
    ],
    "es": [
      "Les Crinières d'Attel'Anges le ofrecen la posibilidad de evadirse en coche de caballos (para 5 o 12 personas) con su familia o amigos, para grandes o pequeñas ocasiones. Disfrute del momento, arrullado por los pasos de los caballos y la amabilidad de Blandine."
    ],
    "nl": [
      "Les Crinières d'Attel'Anges biedt je de kans om er even helemaal tussenuit te zijn in een koets (voor 5 of 12 personen) met je familie of vrienden, voor grote of kleine gelegenheden. Geniet van het moment, gesust door de stappen van de paarden en de vriendelijkheid van Blandine."
    ]
  },
  "rdfs:label": {
    "en": [
