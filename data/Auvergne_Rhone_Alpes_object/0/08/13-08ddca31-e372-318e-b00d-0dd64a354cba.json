  "rdfs:comment": {
    "de": [
      "Bhéatrice CHANARD Künstlerin und Malerin\r\nIhre 2 bevorzugten Medien sind Aquarell und Öl.\r\nBhéatrice lädt Sie ein, ihr Galerie-Atelier im Étang d'Art de Commelle zu besuchen\r\nSie bietet Ihnen Praktika und Workshops à la carte für verschiedene Techniken an."
    ],
    "en": [
      "Bhéatrice CHANARD Artist Painter\r\nHer 2 favorite mediums are watercolor and oil.\r\nBhéatrice invites you to visit her Atelier Galerie at the Etang d'Art in Commelle\r\nShe offers workshops and courses in various techniques."
    ],
    "it": [
      "Bhéatrice CHANARD Pittrice\r\nI suoi due mezzi preferiti sono l'acquerello e l'olio.\r\nBhéatrice vi invita a visitare la sua galleria-studio all'Etang d'Art di Commelle\r\nOffre corsi e laboratori di varie tecniche."
    ],
    "fr": [
      "Bhéatrice  CHANARD Artiste Peintre \r\nSes 2 médiums préférés sont l'aquarelle et l'huile.\r\nBhéatrice vous invite à venir visiter son Atelier Galerie à l'étang d'Art de Commelle\r\nElle vous propose des stages et ateliers à la carte pour diverses techniques."
    ],
    "nl": [
      "Bhéatrice CHANARD Schilder\r\nHaar 2 favoriete mediums zijn aquarel en olieverf.\r\nBhéatrice nodigt je uit om haar ateliergalerie in het Etang d'Art in Commelle te bezoeken\r\nZe geeft cursussen en workshops in verschillende technieken."
    ],
    "es": [
      "Bhéatrice CHANARD Pintora\r\nSus dos técnicas preferidas son la acuarela y el óleo.\r\nBhéatrice te invita a visitar su estudio galería en el Etang d'Art de Commelle\r\nOfrece cursos y talleres de diversas técnicas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Galerie l'Etang d'Art Commelle"
    ]
  },
