  "rdfs:comment": {
    "de": [
      "Das Hotel Daria-I Nor lädt Sie mit seinem 800m² großen Spa zu einem außergewöhnlichen Wellnesserlebnis ein. Nutzen Sie die zahlreichen Einrichtungen und entdecken Sie unsere Karte mit hochwertigen Behandlungen, die in Zusammenarbeit mit Valmont und Phytomer angeboten werden."
    ],
    "en": [
      "Hotel Daria-I Nor invites you to enjoy an exceptional wellness experience in its 800m² spa. Take advantage of our many facilities and discover our high-end treatment menu in partnership with Valmont and Phytomer."
    ],
    "it": [
      "L'Hotel Daria-I Nor vi invita a vivere un'esperienza di benessere eccezionale nella sua spa di 800 m². Approfittate delle numerose strutture e scoprite la nostra gamma di trattamenti di alta gamma in collaborazione con Valmont e Phytomer."
    ],
    "fr": [
      "L'Hôtel Daria-I Nor vous invite à une expérience de bien-être exceptionnelle grâce à son spa de 800m². Profitez de nombreuses installations et découvrez notre carte de soins haut de gamme en partenariat avec Valmont et Phytomer."
    ],
    "nl": [
      "Hotel Daria-I Nor nodigt u uit om te genieten van een uitzonderlijke wellnesservaring in de 800 m² grote spa. Profiteer van de vele faciliteiten en ontdek ons aanbod behandelingen van topkwaliteit in samenwerking met Valmont en Phytomer."
    ],
    "es": [
      "El Hotel Daria-I Nor le invita a disfrutar de una experiencia de bienestar excepcional en su spa de 800 m². Aproveche las numerosas instalaciones y descubra nuestra gama de tratamientos de alta gama en colaboración con Valmont y Phytomer."
    ]
  },
