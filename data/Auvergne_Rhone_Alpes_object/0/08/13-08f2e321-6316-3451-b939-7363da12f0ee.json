  "rdfs:comment": {
    "de": [
      "Entdecken Sie das schwimmende Becken des Plan d'eau de Vieure: ein zu 100 % natürliches Badeerlebnis. Dieser kostenlose, überwachte und für alle zugängliche Ort ist ideal, um sich abzukühlen und an einem Holzstrand inmitten der Natur zu entspannen."
    ],
    "en": [
      "Discover the floating pool at the Vieure lake: a 100% natural swimming experience. Free, supervised and accessible to all, this is the ideal place to cool off and relax on a wooden beach in the heart of nature."
    ],
    "it": [
      "Scoprite la piscina galleggiante del lago Vieure: un'esperienza di nuoto naturale al 100%. Gratuita, sorvegliata e accessibile a tutti, è il luogo ideale per rinfrescarsi e rilassarsi su una spiaggia di legno nel cuore della natura."
    ],
    "fr": [
      "Découvrez le bassin flottant du plan d’eau de Vieure : une expérience de baignade 100 % naturelle. Gratuit, surveillé et accessible à tous, ce lieu est idéal pour se rafraîchir et se détendre sur une plage en bois, en pleine nature."
    ],
    "nl": [
      "Ontdek het drijvende zwembad bij het meer van Vieure: een 100% natuurlijke zwemervaring. Gratis, onder toezicht en toegankelijk voor iedereen, is dit de ideale plek om af te koelen en te ontspannen op een houten strand midden in de natuur."
    ],
    "es": [
      "Descubra la piscina flotante del lago de Vieure: una experiencia de baño 100% natural. Gratuita, vigilada y accesible a todos, es el lugar ideal para refrescarse y relajarse en una playa de madera en plena naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bassin flottant du plan d'eau de Vieure"
    ]
  },
