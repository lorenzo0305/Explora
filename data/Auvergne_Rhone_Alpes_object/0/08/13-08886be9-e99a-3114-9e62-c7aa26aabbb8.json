  "rdfs:comment": {
    "de": [
      "Unser Bergspa liegt außergewöhnlich schön am Fuße des Mont-Aiguille und bietet Platz für bis zu 12 Personen. Es verfügt über ein Becken mit Massagedüsen, einen Whirlpool, eine Sauna, ein Dampfbad, ein Solarium, eine Kräuterteestube und einen herrlichen Blick auf die Hautes Falaises du Vercors."
    ],
    "en": [
      "Exceptionally located at the foot of Mont-Aiguille, our mountain spa welcomes up to 12 guests with a massage jet pool, Jacuzzi, sauna, steam room, solarium, herbal tea room and a magnificent view of the Vercors High Cliffs."
    ],
    "it": [
      "Situata in una posizione eccezionale ai piedi del Mont-Aiguille, la nostra spa di montagna può ospitare fino a 12 persone, con piscina per massaggi, jacuzzi, sauna, bagno turco, solarium, tisaneria e una magnifica vista sulle alte falesie del Vercors."
    ],
    "fr": [
      "Exceptionnellement situé au pied du Mont-Aiguille, notre spa de montagne accueille jusqu’à 12 personnes avec un bassin à jets de massage, un jacuzzi, un sauna, un hammam, un solarium, une tisanerie et une vue magnifique sur les Hautes Falaises du Vercors."
    ],
    "nl": [
      "Onze bergspa is uitzonderlijk gelegen aan de voet van de Mont-Aiguille en biedt plaats aan maximaal 12 personen, met een massagebad, jacuzzi, sauna, stoombad, solarium, kruidentheekamer en een prachtig uitzicht op de hoge kliffen van de Vercors."
    ],
    "es": [
      "Excepcionalmente situado a los pies del Mont-Aiguille, nuestro spa de montaña tiene capacidad para 12 personas, con piscina de masajes, jacuzzi, sauna, baño de vapor, solárium, sala de tisanas y magníficas vistas a los altos acantilados del Vercors."
    ]
  },
  "rdfs:label": {
