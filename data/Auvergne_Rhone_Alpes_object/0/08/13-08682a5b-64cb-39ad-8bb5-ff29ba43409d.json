  "rdfs:comment": {
    "de": [
      "Das Restaurant \"le Courpatta\" empfängt Sie jeden Tag und bietet Mahlzeiten für Arbeiter an. Sie können auch Froschschenkel probieren."
    ],
    "en": [
      "The restaurant \"le Courpatta\" welcomes you every day and offers meals for workers. You can also taste frog's legs."
    ],
    "it": [
      "Il ristorante \"le Courpatta\" vi accoglie ogni giorno e offre pasti per i lavoratori. Si possono anche assaggiare le cosce di rana."
    ],
    "fr": [
      "Le restaurant  \"le Courpatta\" vous accueille tous les jours et propose des repas pour les ouvriers. Vous pouvez également déguster des cuisses de grenouilles."
    ],
    "nl": [
      "Het restaurant \"le Courpatta\" ontvangt u dagelijks en biedt maaltijden voor de werknemers. Je kunt ook kikkerbilletjes proeven."
    ],
    "es": [
      "El restaurante \"le Courpatta\" le da la bienvenida todos los días y ofrece comidas para los trabajadores. También puedes probar las ancas de rana."
    ]
  },
