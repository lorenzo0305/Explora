  "rdfs:comment": {
    "de": [
      "Lust auf eine Entdeckungstour in Ihrem eigenen Rhythmus? Das Fremdenverkehrsamt bietet Ihnen einen Besuch des römischen Aquädukts des Flusses Gier mithilfe eines Audioguides an. 2000 Jahre Geschichte werden Ihnen mit Fotos, alten Postkarten und Schemata erzählt. Dauer: 1 Stunde."
    ],
    "en": [
      "Would you like to discover the aqueduct at your own pace? The tourist office offers an audio-guide tour of the Gier Roman aqueduct. 2000 years of history will be recounted with photos, old postcards and diagrams. Duration: 1 hour."
    ],
    "it": [
      "Volete scoprire l'acquedotto al vostro ritmo? L'Ufficio del Turismo offre una visita audio-guidata dell'acquedotto romano sul Gier. potrete conoscere 2.000 anni di storia grazie a foto, vecchie cartoline e diagrammi. Durata: 1 ora."
    ],
    "fr": [
      "Envie d'une découverte à votre rythme ? L'office de tourisme vous propose une visite de l'aqueduc romain du Gier à l'aide d'un audio-guide. 2000 ans d'histoire vous seront racontés avec photos, cartes postales anciennes et schémas à l'appui. Durée : 1h."
    ],
    "es": [
      "¿Desea descubrir el acueducto a su ritmo? La Oficina de Turismo ofrece una visita con audioguía del acueducto romano del Gier. conocerá 2.000 años de historia con fotos, postales antiguas y esquemas. Duración: 1 hora."
    ],
    "nl": [
      "Wil je het aquaduct op je eigen tempo ontdekken? De Dienst voor Toerisme biedt een audiogidstocht aan over het Romeinse aquaduct op de Gier. aan de hand van foto's, oude ansichtkaarten en diagrammen leer je over 2000 jaar geschiedenis. Duur: 1 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite audio guidée de l'aqueduc"
    ]
  },
