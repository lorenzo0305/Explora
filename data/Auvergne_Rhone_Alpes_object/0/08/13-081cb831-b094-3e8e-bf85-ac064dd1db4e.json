  "rdfs:comment": {
    "de": [
      "EIFFEL, das Rockprojekt von Romain Humeau, bewegt sich außerhalb der Codes, getragen von einem Autor und Komponisten, der die Genres durchquert, ohne jemals den Faden der Lieder zu verlieren. Sein Rock, der von Bowie, Pixies, Bach oder Brel geprägt ist, bleibt roh, intensiv und zutiefst menschlich."
    ],
    "en": [
      "EIFFEL, Romain Humeau's rock project, moves ahead outside the box, driven by a songwriter who crosses genres without ever losing the thread of his songs. Inspired by Bowie, Pixies, Bach and Brel, his rock is raw, intense and deeply human."
    ],
    "it": [
      "EIFFEL, il progetto rock di Romain Humeau, procede in modo nuovo, guidato da un cantautore che attraversa i generi senza mai perdere il filo delle sue canzoni. Ispirato da Bowie, Pixies, Bach e Brel, il suo rock è crudo, intenso e profondamente umano."
    ],
    "fr": [
      "EIFFEL, projet rock de Romain Humeau, avance hors des codes, porté par un auteur-compositeur qui traverse les genres sans jamais perdre le fil des chansons. Nourri de Bowie, Pixies, Bach ou Brel, son rock reste brut, intense, profondément humain."
    ],
    "nl": [
      "EIFFEL, het rockproject van Romain Humeau, beweegt zich op een nieuwe manier voort, gedreven door een songwriter die genres doorkruist zonder ooit de draad van zijn songs te verliezen. Geïnspireerd door Bowie, Pixies, Bach en Brel is zijn rock rauw, intens en diep menselijk."
    ],
    "es": [
      "EIFFEL, el proyecto de rock de Romain Humeau, avanza de una forma nueva, impulsado por un compositor que cruza géneros sin perder nunca el hilo de sus canciones. Inspirado por Bowie, Pixies, Bach y Brel, su rock es crudo, intenso y profundamente humano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : EIFFEL + WINDSOR"
    ]
  },
