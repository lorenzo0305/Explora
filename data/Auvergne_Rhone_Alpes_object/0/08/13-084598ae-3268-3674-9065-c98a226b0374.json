  "rdfs:comment": {
    "de": [
      "Das Team des Kyriad empfängt Sie in einer grünen Umgebung mit Blick auf Lyon. Verpassen Sie auf keinen Fall eine Schlemmerpause im Restaurant, wo Sie der Chefkoch mit seinen Lyoner Spezialitäten verwöhnen wird."
    ],
    "en": [
      "In a lush green setting, the Kyriad team welcomes you to a verdant location with views of Lyon. Don't miss out on a gourmet break in the restaurant, where the chef will treat you to his Lyon specialities."
    ],
    "it": [
      "Circondato dal verde, il team del Kyriad vi accoglie in un ambiente verde con vista su Lione. Non perdetevi una pausa gourmet nel ristorante, dove lo chef vi delizierà con le sue specialità lionesi."
    ],
    "fr": [
      "Dans un écrin de verdure, l'équipe du Kyriad vous accueille dans un cadre verdoyant avec vue sur Lyon. Ne ratez surtout pas une halte gourmande dans le restaurant où le Chef vous régalera avec ses spécialités lyonnaises."
    ],
    "es": [
      "Rodeado de vegetación, el equipo de Kyriad le da la bienvenida en un entorno verde con vistas a Lyon. No se pierda una pausa gastronómica en el restaurante, donde el chef le deleitará con sus especialidades lionesas."
    ],
    "nl": [
      "Het Kyriad team verwelkomt je in een groene omgeving met uitzicht over Lyon. Mis een gastronomische pauze in het restaurant niet, waar de chef u zal verrukken met zijn specialiteiten uit Lyon."
    ]
  },
