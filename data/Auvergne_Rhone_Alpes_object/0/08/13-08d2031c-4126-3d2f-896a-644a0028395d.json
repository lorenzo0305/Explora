  "rdfs:comment": {
    "de": [
      "Mit Poesie, Humor und Energie mischt Gaétan Gali für die Compagnie terre de break Tanz, Slam, Akrobatik und Worte, um unsere kleinen und großen Entscheidungen des Alltags zu hinterfragen.\r\nIm Rahmen von \"Danse au fil d'Avril\" (Tanz im April)."
    ],
    "en": [
      "With poetry, humor and energy, Gaétan Gali, for Compagnie terre de break, mixes dance, slam, acrobatics and words to question our choices, big and small, in everyday life.\r\nAs part of \"Danse au fil d'Avril\"."
    ],
    "it": [
      "Con poesia, umorismo ed energia, Gaétan Gali, per la Compagnie terre de break, mescola danza, slam, acrobazie e parole per mettere in discussione le nostre scelte, grandi e piccole, nella vita quotidiana.\r\nNell'ambito del festival \"Danse au fil d'Avril\"."
    ],
    "fr": [
      "Avec poésie, humour et énergie, Gaétan Gali, pour la Compagnie terre de break, mêle danse, slam, acrobaties et mots pour questionner nos choix, petits et grands, du quotidien.\r\nDans le cadre de \"Danse au fil d'Avril\"."
    ],
    "nl": [
      "Met poëzie, humor en energie mixt Gaétan Gali voor Compagnie terre de break dans, slam, acrobatiek en woorden om onze grote en kleine keuzes in het dagelijks leven in vraag te stellen.\r\nIn het kader van het festival \"Danse au fil d'Avril\"."
    ],
    "es": [
      "Con poesía, humor y energía, Gaétan Gali, para la Compagnie terre de break, mezcla danza, slam, acrobacia y palabras para cuestionar nuestras elecciones, grandes y pequeñas, en la vida cotidiana.\r\nEn el marco del festival \"Danse au fil d'Avril\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chab'en scène: Confliture - Danse au Fil d'Avril"
    ]
  },
