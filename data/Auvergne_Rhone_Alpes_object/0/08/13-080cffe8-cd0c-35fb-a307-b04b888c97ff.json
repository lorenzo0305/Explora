  "rdfs:comment": {
    "de": [
      "10.30 Uhr: Lesung von Auszügen aus \"L'excursion des jeunes filles qui ne sont plus\" von A. Seghers von MH Boisse.\r\n10:30 Uhr: Lesungen aus Jugendalben, Geschichten vom Himmel und von Wolken, in Verbindung mit der Fotoausstellung 6x6."
    ],
    "en": [
      "10:30 am: reading of extracts from \"L'excursion des jeunes filles qui ne sont plus\" by A. Seghers by MH Boisse.\r\n10:30 am: readings from children's albums, stories of sky and clouds, in connection with the 6x6 photo exhibition."
    ],
    "it": [
      "10.30: Lettura di brani da \"L'excursion des jeunes filles qui ne sont plus\" di A. Seghers di MH Boisse.\r\n10.30: letture di libri per bambini, storie di cielo e nuvole, in concomitanza con la mostra fotografica 6x6."
    ],
    "fr": [
      "10h30 : lecture d'extraits de \"L'excursion des jeunes filles qui ne sont plus\" de A. Seghers par MH Boisse.\r\n10h30 : lectures d'albums jeunesses, des histoires de ciel et de nuages, en lien avec l'expo photographique 6x6."
    ],
    "nl": [
      "10.30 uur: Lezing van fragmenten uit \"L'excursion des jeunes filles qui ne sont plus\" van A. Seghers door MH Boisse.\r\n10.30 uur: voorlezen uit kinderboeken, verhalen over lucht en wolken, in het kader van de 6x6 fototentoonstelling."
    ],
    "es": [
      "10.30 h: Lectura de extractos de \"L'excursion des jeunes filles qui ne sont plus\" de A. Seghers por MH Boisse.\r\n10.30 h: lectura de libros infantiles, historias de cielo y nubes, en relación con la exposición fotográfica 6x6."
    ]
  },
