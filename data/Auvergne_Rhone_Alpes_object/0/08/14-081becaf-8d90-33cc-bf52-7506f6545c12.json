      "dc:description": {
        "de": [
          "Informationen :\n\n\nÖffnungstage:\n\nMontag bis Freitag von 8:45 bis 12:15 Uhr und von 14:00 bis 19:30 Uhr\nSamstags von 8:45 bis 12:15 Uhr und von 14:00 bis 18:00 Uhr\n\nSonntag geschlossen\n "
        ],
        "en": [
          "Information :\n\n\nOpening days:\n\nMonday to Friday, 8.45am to 12.15pm and 2pm to 7.30pm\nSaturday 8.45am to 12.15pm and 2pm to 6pm\n\nClosed on Sunday\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 8.45 alle 12.15 e dalle 14.00 alle 19.30\nSabato dalle 8.45 alle 12.15 e dalle 14.00 alle 18.00\n\nChiuso la domenica\n "
        ],
        "fr": [
          "Informations :\n\n\nJours d'ouverture:\n\nDu lundi au vendredi de 8h45 à 12h15 et de 14h00 à 19h30\nLe samedi de 8h45 à 12h15 et de 14h00 à 18h00\n\nFermeture le dimanche\n "
        ],
        "nl": [
          "Meer informatie :\n\n\nOpeningsdagen:\n\nMaandag t/m vrijdag van 8.45 tot 12.15 uur en van 14.00 tot 19.30 uur\nZaterdag van 8.45 tot 12.15 uur en van 14.00 tot 18.00 uur\n\nZondag gesloten\n "
        ],
        "es": [
          "Más información :\n\n\nDías de apertura:\n\nDe lunes a viernes, de 8.45 a 12.15 h. y de 14.00 a 19.30 h\nSábados de 8.45 a 12.15 y de 14.00 a 18.00 horas\n\nDomingos cerrado\n "
        ]
      },
