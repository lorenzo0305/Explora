  "rdfs:comment": {
    "de": [
      "Die Küche entwickelt sich mit den Jahreszeiten, es werden nur frische, hausgemachte Produkte verwendet.\r\nIn einem schlichten, naturbelassenen Rahmen gegenüber dem Rathaus von La Mure."
    ],
    "en": [
      "Cooking evolves with the seasons, with fresh and home-made products. In a simple decorated room, facing the city hall of La Mure."
    ],
    "it": [
      "La cucina cambia a seconda delle stagioni, utilizzando prodotti freschi e fatti in casa.\r\nIn un ambiente raffinato e naturale, di fronte al municipio di La Mure."
    ],
    "fr": [
      "Cuisine évolutive au grès des saisons, utilisation de produits frais, fait maison.\r\nDans un cadre épuré, nature en face de l'Hôtel de Ville de La Mure."
    ],
    "es": [
      "La cocina cambia con las estaciones, con productos frescos y caseros.\r\nEn un marco natural y refinado, frente al ayuntamiento de La Mure."
    ],
    "nl": [
      "In dit restaurant gelegen tegenover het stadhuis kun je genieten van een seizoensgerichte keuken."
    ]
  },
