  "rdfs:comment": {
    "de": [
      "Die Boutique de l'Artelier partagé vereint mehr als 20 Designer in einem Umkreis von 50 km um Novalaise. Das ganze Jahr über bietet sie Workshops für alle an."
    ],
    "en": [
      "The shared Artelier boutique brings together more than 20 designers within a 50 km radius of Novalaise. Throughout the year, it offers workshops for everyone."
    ],
    "it": [
      "Il negozio condiviso Artelier riunisce più di 20 designer nel raggio di 50 km da Novalaise. Durante tutto l'anno, offre workshop per tutti."
    ],
    "fr": [
      "La boutique de l'Artelier partagé regroupe plus de 20 créateurs dans un rayon de 50 km autour de Novalaise. Tout au long de l'année, elle propose des ateliers pour tous."
    ],
    "es": [
      "La tienda compartida Artelier reúne a más de 20 diseñadores en un radio de 50 km de Novalaise. A lo largo del año, ofrece talleres para todos los públicos."
    ],
    "nl": [
      "De gezamenlijke Artelier-winkel brengt meer dan 20 ontwerpers in een straal van 50 km rond Novalaise samen. Het hele jaar door worden er workshops voor iedereen aangeboden."
    ]
  },
