  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Know-how und unsere Erfahrung bei einem Besuch des Betriebs, gefolgt von einem Imbiss oder einer Brotzeit. Verkauf unserer Produkte: Wurstwaren, Eier, Beeren..."
    ],
    "en": [
      "Discover our know-how and experience during a tour of the farm, followed by a snack. Sale of our products: cold meats, eggs, berries..."
    ],
    "it": [
      "Scoprite il nostro know-how e la nostra esperienza durante un tour della fattoria, seguito da uno spuntino. Vendita dei nostri prodotti: salumi, uova, frutti di bosco, ecc."
    ],
    "fr": [
      "Découvrez notre savoir-faire et notre expérience au cours d'une visite de l'exploitation, suivie d'un goûter ou d'un casse-croûte. Vente de nos produits : charcuterie, oeufs, petits fruits..."
    ],
    "nl": [
      "Ontdek onze kennis en ervaring tijdens een rondleiding over de boerderij, gevolgd door een hapje. Verkoop van onze producten: vleeswaren, eieren, bessen, enz."
    ],
    "es": [
      "Descubra nuestro saber hacer y nuestra experiencia durante una visita a la granja, seguida de un aperitivo. Venta de nuestros productos: embutidos, huevos, bayas, etc."
    ]
  },
  "rdfs:label": {
