  "rdfs:comment": {
    "de": [
      "Marie-Pierre Bonnardel stellt Alltagskeramik aus glasierter Erde her. Einfache Dekore und Linien sorgen für das Gleichgewicht der Stücke.\r\nOrt des Flüsterns... wo sich Schalen, Bücher, Krüge, Papier, Schalen... vermischen.Atelierbesuche, Praktika auf Anfrage."
    ],
    "en": [
      "Marie-Pierre Bonnardel makes everyday pottery in glazed earth, with simple designs and lines to balance the pieces.\r\nA place of whispers... where bowls, books, jugs, papers, cups... mingle. Studio visits, workshops on request."
    ],
    "it": [
      "Marie-Pierre Bonnardel realizza ceramiche di uso quotidiano in argilla smaltata, con disegni e linee semplici per bilanciare i pezzi.\r\nUn luogo di sussurri... dove si mescolano ciotole, libri, brocche, carte, tazze... Visite ai laboratori, corsi su richiesta."
    ],
    "fr": [
      "Marie-Pierre Bonnardel fabrique de la poterie du quotidien en terre vernissée, décors et lignes simples pour l'équilibre des pièces.\r\nLieu de murmure... où se mêlent bols, livres, pichets, papiers, coupes...Visites d'ateliers, stages sur demande."
    ],
    "nl": [
      "Marie-Pierre Bonnardel maakt alledaags aardewerk van geglazuurde klei, met eenvoudige ontwerpen en lijnen om de stukken in evenwicht te brengen.\r\nEen plek van gefluister... waar kommen, boeken, kannen, papieren, kopjes... zich vermengen. Atelierbezoeken en cursussen op aanvraag."
    ],
    "es": [
      "Marie-Pierre Bonnardel hace cerámica de uso cotidiano en arcilla vidriada, con diseños y líneas sencillas para equilibrar las piezas.\r\nUn lugar de susurros... donde se mezclan cuencos, libros, jarras, papeles, tazas... Visitas a talleres, cursos a petición."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier du Hanneton"
    ]
  },
