  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels Le Christel? Cit?Hôtel bietet hausgemachte und aus frischen Produkten zubereitete Speisen in einer gemütlichen Umgebung im Herzen von Le Puy-en-Velay. Es ist in der Hochsaison jeden Abend und in der Nebensaison unter der Woche geöffnet und eignet sich ideal für ein"
    ],
    "en": [
      "The restaurant at Hôtel Le Christel ? Cit?Hôtel offers homemade cuisine made with fresh produce, in a warm setting in the heart of Le Puy-en-Velay. Open every evening in high season and weekdays in low season, it's the ideal place for a delicious meal"
    ],
    "it": [
      "Il ristorante dell'Hôtel Le Christel ? Cit?Hôtel offre una cucina casalinga a base di prodotti freschi, in un ambiente accogliente nel cuore di Le Puy-en-Velay. Aperto tutte le sere in alta stagione e durante la settimana in bassa stagione, è l'ideale per un pasto rilassante"
    ],
    "fr": [
      "Le restaurant de l’Hôtel Le Christel – Cit’Hôtel propose une cuisine maison et élaborée à partir de produits frais, dans un cadre chaleureux au cœur du Puy-en-Velay. Ouvert tous les soirs en haute saison et en semaine en basse saison, il est idéal pour un"
    ],
    "nl": [
      "Het restaurant van Hôtel Le Christel ? Cit?Hôtel biedt huisgemaakte gerechten met verse producten, in een warme omgeving in het hart van Le Puy-en-Velay. Het is elke avond geopend in het hoogseizoen en doordeweeks in het laagseizoen en is ideaal voor een ontspannen maaltijd"
    ],
    "es": [
      "El restaurante del Hôtel Le Christel ? Cit'Hôtel ofrece cocina casera elaborada con productos frescos, en un ambiente cálido en el corazón de Le Puy-en-Velay. Abierto todas las noches en temporada alta y durante la semana en temporada baja, es ideal para una comida relajante"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Chris'tel"
    ]
  },
