  "rdfs:comment": {
    "de": [
      "Im Tourismusbüro finden Sie alle Informationen, die Sie brauchen, um einen angenehmen Aufenthalt in Les Gets zu verbringen. Hier erhalten Sie touristische Informationen über das Dorf und auch über die umliegenden Sehenswürdigkeiten."
    ],
    "en": [
      "You will find at the Tourist Office all the information you need to have a pleasant stay in Les Gets. You can get tourist information on the village and also on the surrounding sites."
    ],
    "it": [
      "Presso l'Ufficio del Turismo troverete tutte le informazioni necessarie per trascorrere un piacevole soggiorno a Les Gets. Potrete ottenere informazioni turistiche sul villaggio e sui siti circostanti."
    ],
    "fr": [
      "Vous trouverez à l'Office de Tourisme tous les renseignements nécessaires pour passer un agréable séjour aux Gets. Vous pourrez obtenir des informations touristiques sur le village et également sur les sites alentours."
    ],
    "nl": [
      "U vindt alle nodige informatie voor een aangenaam verblijf in Les Gets op het VVV-kantoor. U kunt hier alle toeristische informatie over het skioord en de omgeving krijgen."
    ],
    "es": [
      "En la Oficina de Turismo encontrará toda la información necesaria para pasar una agradable estancia en Les Gets. Podrá obtener información turística sobre el pueblo y también sobre los lugares de los alrededores."
    ]
  },
