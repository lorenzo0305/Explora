  "rdfs:comment": {
    "de": [
      "Mit einer Höhe von 80 m dominiert der Volpie-Felsen das Dore-Tal und bietet 28 Kletterrouten in verschiedenen Schwierigkeitsgraden (von 4B bis 7C). Der Fels wird als mittelschwer eingestuft/aguerris"
    ],
    "en": [
      "At a height of 80m, the Volpie rock overlooks the Dore valley and offers 28 climbing routes of varying difficulty (from 4B to 7C). The site is rated as medium/aguerristic"
    ],
    "it": [
      "A 80 m di altezza, la roccia delle Volpie domina la valle del Dore e offre 28 vie di arrampicata di vario grado di difficoltà (dal 4B al 7C). Il sito è considerato di media difficoltà"
    ],
    "fr": [
      "D'une hauteur de 80m, le rocher de la Volpie domine la vallée de la Dore et propose 28 voies d'escalade pour plusieurs niveaux de difficultés (de 4B à 7C). Le site est considéré comme moyen/aguerris"
    ],
    "nl": [
      "Op 80 meter hoogte kijkt de Volpie rots uit over de Dore vallei en biedt 28 klimroutes van verschillende moeilijkheidsgraden (van 4B tot 7C). De site wordt beschouwd als van gemiddelde moeilijkheidsgraad"
    ],
    "es": [
      "A 80 m de altura, la roca Volpie domina el valle del Dore y ofrece 28 vías de escalada de distintos grados de dificultad (de 4B a 7C). El sitio se considera de dificultad media"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rocher de la Volpie - Site d'escalade"
    ]
  },
