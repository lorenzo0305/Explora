  "rdfs:comment": {
    "de": [
      "Das Museum befindet sich auf einer Klippe aus Basaltorgeln mit Blick auf den Fluss und beherbergt fossile Überreste, die in Chilhac gefunden wurden und 2 Millionen Jahre alt sind."
    ],
    "en": [
      "Situated on a basalt organ cliff overlooking the river, the museum houses fossilized remains found in Chilhac dating back 2 million years."
    ],
    "it": [
      "Situato su una scogliera a organo basaltico che domina il fiume, il museo ospita resti fossili trovati a Chilhac e risalenti a 2 milioni di anni fa."
    ],
    "fr": [
      "Situé sur la falaise d'orgues basaltiques, dominant la rivière, le musée abrite les restes fossilisés retrouvés à Chilhac et datant de 2 millions d'années."
    ],
    "es": [
      "Situado en un acantilado de órganos de basalto que domina el río, el museo alberga restos fósiles hallados en Chilhac que datan de hace 2 millones de años."
    ],
    "nl": [
      "Het museum ligt op een basaltorgelklif die uitkijkt over de rivier en herbergt fossiele resten die in Chilhac zijn gevonden en die 2 miljoen jaar oud zijn."
    ]
  },
  "rdfs:label": {
