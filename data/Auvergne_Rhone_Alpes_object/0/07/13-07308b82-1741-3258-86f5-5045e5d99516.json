  "rdfs:comment": {
    "de": [
      "Auf dem majestätischen Skigebiet Grands Montets oder dem familienfreundlichen und sonnigen Tour Col de Balme unterrichtet ein Team von mittlerweile 50 Fachleuten alle Disziplinen des Wintersports, von den traditionellsten bis zu den innovativsten."
    ],
    "en": [
      "On the majestic Grands Montets ski area or the sunny, family-friendly Tour Col de Balme, a team of 50 professionals teaches all winter sports disciplines, from the most traditional to the most innovative."
    ],
    "it": [
      "Nel maestoso comprensorio sciistico dei Grands Montets o nel soleggiato e familiare Tour Col de Balme, un team di 50 professionisti insegna tutte le discipline degli sport invernali, dalle più tradizionali alle più innovative."
    ],
    "fr": [
      "Sur le domaine majestueux des Grands Montets ou celui, familial et ensoleillé du Tour Col de Balme, une équipe, de professionnels, enseignent toutes les disciplines de la glisse, des plus traditionnelles aux plus novatrices."
    ],
    "nl": [
      "In het majestueuze skigebied Grands Montets of de zonnige, gezinsvriendelijke Tour Col de Balme geeft een team van professionals les in alle wintersportdisciplines, van de meest traditionele tot de meest innovatieve."
    ],
    "es": [
      "En el majestuoso dominio esquiable de Grands Montets o en el soleado y familiar Tour Col de Balme, un equipo de 50 profesionales enseña todas las disciplinas de los deportes de invierno, desde las más tradicionales a las más innovadoras."
    ]
  },
