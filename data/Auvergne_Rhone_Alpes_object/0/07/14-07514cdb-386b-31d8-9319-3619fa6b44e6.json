      "@id": "https://data.datatourisme.fr/430c0fb3-3b41-38fd-a32a-097e4056a3b0",
      "dc:description": {
        "de": [
          "Treffpunkt im Stadion Michel Engrand in Fruges am 31. August von 19 bis 23 Uhr\nRadio Crochet Festival, präsentiert vom Saint-Gilliet-Komitee und dem Festkomitee von Fruges\nEintritt 5 ? - bar und Restaurant vor Ort"
        ],
        "en": [
          "Rendezvous at the Michel Engrand stadium in Fruges on August 31st from 7pm to 11pm\nRadio Crochet Festival presented by the Comité de la Saint-Gilliet and the Comité des Fêtes de Fruges\nAdmission: 5? - bar and catering on site"
        ],
        "it": [
          "Appuntamento allo stadio Michel Engrand di Fruges il 31 agosto dalle 19.00 alle 23.00\nFesta di Radio Crochet presentata dal Comitato di Saint-Gilliet e dal Comitato delle Feste di Fruges\nIngresso: 5? - bar e ristorazione sul posto"
        ],
        "fr": [
          "Rendez-vous au stade Michel Engrand à Fruges le 31 août de 19h à 23h\nFestival Radio Crochet présenté par le Comité de la Saint-Gilliet et le Comité des Fêtes de Fruges\nEntrée 5€ - bar et restauration sur place"
        ],
        "nl": [
          "Rendez-vous in het Michel Engrand stadion in Fruges op 31 augustus van 19u tot 23u\nRadio Crochet Festival gepresenteerd door het Comité de la Saint-Gilliet en het Comité des Fêtes de Fruges\nToegangsprijs: 5? - bar en catering ter plaatse"
        ],
        "es": [
          "Cita en el estadio Michel Engrand de Fruges el 31 de agosto de 19.00 a 23.00 horas\nFestival Radio Crochet presentado por el Comité de la Saint-Gilliet y el Comité des Fêtes de Fruges\nEntrada: 5? - bar y catering in situ"
        ]
      },
