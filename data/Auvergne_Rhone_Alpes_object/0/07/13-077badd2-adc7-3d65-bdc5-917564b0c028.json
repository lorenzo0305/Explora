  "rdfs:comment": {
    "de": [
      "Unser Lokal liegt im Herzen des Dorfes Le Désert en Valjouffrey und verfügt über eine Sonnenterrasse und einen großen Saal, um Sie in Ruhe zu empfangen. Nur im Sommer geöffnet."
    ],
    "en": [
      "At the heart of the village, our mountain restaurant welcomes you in a friendly and warm atmosphere with a lounge and a chimney. Enjoy the terrace and the relax and green area. Open summer and autumn in 2018"
    ],
    "it": [
      "Situato nel cuore del villaggio di Le Désert en Valjouffrey, il nostro stabilimento è dotato di una terrazza soleggiata e di un'ampia sala per accogliervi in un ambiente tranquillo. Aperto solo in estate."
    ],
    "fr": [
      "Situé au cœur du village du Désert en Valjouffrey, notre établissement est équipé d'une terrasse ensoleillée et d'une grande salle pour vous accueillir au calme. Ouvert l'été uniquement."
    ],
    "es": [
      "Situado en el corazón del pueblo de Le Désert en Valjouffrey, nuestro establecimiento está dotado de una soleada terraza y una amplia sala para acogerle en un ambiente tranquilo. Abierto sólo en verano."
    ],
    "nl": [
      "In het midden van het dorp vind je een typische berg herberg met z'n ypische conviviale atmosfeer dankzij z'n monumentale openhaard. Op in de zomer en de herfst"
    ]
  },
