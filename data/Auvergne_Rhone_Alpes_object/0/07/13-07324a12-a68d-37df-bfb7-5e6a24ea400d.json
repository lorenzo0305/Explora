  "rdfs:comment": {
    "de": [
      "Die Fruitière de Bogève besteht seit 1913. Sie wurde von den Milchbauern der Gemeinde gegründet. Die Besonderheit dieser Molkerei ist die Herstellung von Reblochon, Tomme de Savoie und Abondance."
    ],
    "en": [
      "The fruit farm of Bogève has existed since 1913. It was created by the milk producers of the town. The particularity of this is the production of Reblochon, Tomme de Savoie and Abondance."
    ],
    "it": [
      "Il caseificio Bogève esiste dal 1913. È stato creato dai produttori di latte del comune. La particolarità di questa è la produzione di Reblochon, Tomme de Savoie e Abondance."
    ],
    "fr": [
      "La fruitière de Bogève existe depuis 1913. Elle fut crée par les producteurs de lait de la commune. La particularité de celle-ci étant la fabrication du Reblochon, de la Tomme de Savoie et de l'Abondance."
    ],
    "es": [
      "La lechería Bogève existe desde 1913. Fue creado por los productores de leche de la comuna. La particularidad de ésta es la fabricación de Reblochon, Tomme de Savoie y Abondance."
    ],
    "nl": [
      "De melkfabriek Bogève bestaat sinds 1913. Het is opgericht door de melkproducenten van de gemeente. De bijzonderheid van deze is de vervaardiging van Reblochon, Tomme de Savoie en Abondance."
    ]
  },
