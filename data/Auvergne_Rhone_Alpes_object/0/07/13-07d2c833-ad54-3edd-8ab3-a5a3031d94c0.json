  "rdfs:comment": {
    "de": [
      "Vermietung von Luxus-Vans mit Hotelservice und maßgeschneiderten Road-Trips für Abenteuer auf den Straßen Frankreichs, der Schweiz und Italiens."
    ],
    "en": [
      "Rental of ultra-luxury converted vans with hotel service and tailor-made road-trips for adventure on the roads of France, Switzerland and Italy."
    ],
    "it": [
      "Noleggiate furgoni convertiti extralusso con servizio alberghiero e viaggi su misura per un'avventura completamente libera sulle strade di Francia, Svizzera e Italia."
    ],
    "fr": [
      "Location de vans aménagés ultra luxes proposant un service hôtelier et des road-trips sur-mesure pour vivre l’aventure en toute liberté sur les routes de la France, la Suisse et l’Italie."
    ],
    "nl": [
      "Huur ultraluxe omgebouwde bestelwagens met hotelservice en op maat gemaakte roadtrips voor een volledig vrij avontuur op de wegen van Frankrijk, Zwitserland en Italië."
    ],
    "es": [
      "Alquile furgonetas transformadas de ultralujo con servicio de hotel y viajes por carretera a medida para vivir una aventura completamente libre por las carreteras de Francia, Suiza e Italia."
    ]
  },
