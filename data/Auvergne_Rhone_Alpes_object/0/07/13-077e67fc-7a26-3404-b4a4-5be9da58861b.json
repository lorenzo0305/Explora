  "rdfs:comment": {
    "de": [
      "Tipik? bietet eine originelle und komfortable Unterkunftslösung für Ihre Veranstaltung: liebevoll eingerichtete Tipi-Zelte direkt am Ort Ihrer Feier."
    ],
    "en": [
      "At Tipik? we offer an original and comfortable accommodation solution for your events: carefully designed tepee tents, right on the site of your party."
    ],
    "it": [
      "Noi di Tipik? offriamo una soluzione di alloggio originale e confortevole per i vostri eventi: tende Tipi progettate con cura proprio nel luogo della vostra festa."
    ],
    "fr": [
      "Chez Tipik’, nous proposons une solution d’hébergement originale et tout confort pour vos événements : des tentes tipi aménagées avec soin, directement sur le lieu de votre fête."
    ],
    "es": [
      "En Tipik? le ofrecemos una solución de alojamiento original y confortable para sus eventos: carpas tipi cuidadosamente diseñadas justo en el lugar de su fiesta."
    ],
    "nl": [
      "Bij Tipik bieden we een originele en comfortabele accommodatieoplossing voor uw evenementen: zorgvuldig ontworpen tipitenten op uw feestlocatie."
    ]
  },
