  "rdfs:comment": {
    "de": [
      "LUX Scène nationale de Valence bietet eine Saison mit Aufführungen (Tanz und Musik), Ausstellungen und Filmen, die jedes Jahr im Januar durch das Festival Viva Cinéma unterstrichen wird."
    ],
    "en": [
      "LUX Scène nationale de Valence offers a season of shows (dance and music), exhibitions and films, punctuated by the Viva Cinéma festival every January."
    ],
    "it": [
      "LUX Scène nationale de Valence offre una stagione di spettacoli (danza e musica), mostre e film, punteggiata dal festival Viva Cinéma ogni gennaio."
    ],
    "fr": [
      "LUX Scène nationale de Valence propose une saison de spectacles (danse et musique), d’expositions et de films, ponctuée du festival Viva Cinéma chaque année en janvier."
    ],
    "es": [
      "La LUX Scène nationale de Valence ofrece una temporada de espectáculos (danza y música), exposiciones y películas, amenizada por el festival Viva Cinéma cada mes de enero."
    ],
    "nl": [
      "LUX Scène nationale de Valence biedt een seizoen van voorstellingen (dans en muziek), tentoonstellingen en films, onderbroken door het Viva Cinéma festival in januari."
    ]
  },
