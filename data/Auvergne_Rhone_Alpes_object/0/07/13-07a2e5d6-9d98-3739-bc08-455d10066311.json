  "rdfs:comment": {
    "de": [
      "Marlène Vincent ist eine leidenschaftliche Therapeutin und bietet Sonotherapie-Sitzungen an, um Körper und Geist mithilfe der Vibrationen tibetanischer Klangschalen, Gongs und Stimmgabeln zu harmonisieren. Sie begleitet Sie sanft auf dem Weg zu Entspannung, Zentrierung und Wohlbefinden."
    ],
    "en": [
      "A passionate therapist, Marlène Vincent offers sound therapy sessions to harmonize body and mind using the vibrations of Tibetan bowls, gongs and tuning forks. She gently guides you towards relaxation, refocusing and well-being."
    ],
    "it": [
      "Terapeuta appassionata, Marlène Vincent offre sessioni di terapia del suono per armonizzare il corpo e la mente utilizzando le vibrazioni di ciotole tibetane, gong e diapason. Marlène vi guida dolcemente verso il rilassamento, la concentrazione e il benessere."
    ],
    "fr": [
      "Thérapeute passionnée, Marlène Vincent propose des séances de sonothérapie pour harmoniser le corps et l’esprit grâce aux vibrations des bols tibétains, gongs et diapasons. Elle vous accompagne avec douceur vers la détente, le recentrage et le bien-être."
    ],
    "es": [
      "Marlène Vincent, terapeuta apasionada, ofrece sesiones de sonoterapia para armonizar cuerpo y mente mediante las vibraciones de cuencos tibetanos, gongs y diapasones. Le guiará suavemente hacia la relajación, la concentración y el bienestar."
    ],
    "nl": [
      "Marlène Vincent is een gepassioneerd therapeute en biedt klanktherapiesessies om lichaam en geest te harmoniseren met behulp van de trillingen van Tibetaanse schalen, gongs en stemvorken. Ze begeleidt je zachtjes naar ontspanning, heroriëntatie en welzijn."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marlène Vincent - Sonothérapeute & Thérapeute du bien-être"
    ]
  },
