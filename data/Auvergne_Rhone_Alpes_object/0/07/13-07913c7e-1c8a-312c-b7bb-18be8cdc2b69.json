  "rdfs:comment": {
    "de": [
      "Jacques Gouillet, Holzdrechsler, führt die ornamentale Drechseltechnik des 17. Jahrhunderts auf ausschließlich bugistischen Hölzern sowie auf Gebrauchsgegenständen aus."
    ],
    "en": [
      "Jacques Gouillet, a woodturner, uses the ornamental woodturning technique of the 17th century to turn exclusively Bugist wood, as well as utilitarian objects."
    ],
    "it": [
      "Jacques Gouillet, tornitore, utilizza la tecnica di tornitura ornamentale del XVII secolo per trasformare legni esclusivamente bugeschi, oltre a oggetti utilitari."
    ],
    "fr": [
      "Jacques Gouillet, tourneur sur bois, exécute la technique de tournage ornemental du 17 ème siècle sur des bois exclusivement bugistes, ainsi que des objets utilitaires."
    ],
    "es": [
      "Jacques Gouillet, tornero de madera, utiliza la técnica del torneado ornamental del siglo XVII para tornear madera exclusivamente bugesca, así como objetos utilitarios."
    ],
    "nl": [
      "Jacques Gouillet, een houtdraaier, gebruikt de decoratieve houtdraaitechniek van de 17e eeuw om uitsluitend Bugesque hout te draaien, maar ook gebruiksvoorwerpen."
    ]
  },
  "rdfs:label": {
    "en": [
