  "rdfs:comment": {
    "de": [
      "La Ferme des Plaines liegt in der Gemeinde Saint-Nazaire-le-Désert auf 600 m Höhe im Roanne-Tal, das sich über den Süden des Diois und die provenzalische Drôme erstreckt. Produzent von Tausendblüten- und Lavendelhonig."
    ],
    "en": [
      "Ferme des Plaines is located in the commune of Saint-Nazaire-le-Désert at 600m altitude, in the Roanne valley, straddling the southern Diois and Drôme Provençale regions. Producer of thousand-flower and lavender honeys."
    ],
    "it": [
      "La Ferme des Plaines si trova nel comune di Saint-Nazaire-le-Désert a 600 m di altitudine, nella valle di Roanne, a cavallo tra il Diois meridionale e la Drôme provenzale. Produttore di mieli millefiori e di lavanda."
    ],
    "fr": [
      "La Ferme des Plaines est située sur la commune de Saint-Nazaire-le-Désert à 600m d’altitude, dans la vallée de la Roanne, à cheval sur le sud du Diois et sur la Drôme provençale. Producteur de miels de mille fleurs et de lavande."
    ],
    "nl": [
      "La Ferme des Plaines ligt in de gemeente Saint-Nazaire-le-Désert op 600 m hoogte, in de vallei van Roanne, op de grens tussen de zuidelijke regio's Diois en Drôme Provençale. Producent van duizendbloemen- en lavendelhoning."
    ],
    "es": [
      "La Ferme des Plaines está situada en el municipio de Saint-Nazaire-le-Désert, a 600 m de altitud, en el valle de Roanne, a caballo entre el sur del Diois y la Drôme provenzal. Produce mieles de mil flores y de lavanda."
    ]
  },
