  "rdfs:comment": {
    "de": [
      "Ich entwerfe und realisiere Acrylgemälde auf verschiedenen Untergründen: Leinwand, Wände, Sperrholz, Vitrinen, Objekte usw. in Form von Fresken, Trompe l'oeil, Illustrationen und Beschriftungen."
    ],
    "en": [
      "I design and create acrylic paintings on various supports: canvas, walls, plywood, display cases, objects, etc. in the form of frescoes, trompe l'oeil, illustrations and lettering."
    ],
    "it": [
      "Progetto e realizzo dipinti in acrilico su diverse superfici: tela, pareti, compensato, vetrine, oggetti, ecc. sotto forma di affreschi, trompe l'oeil, illustrazioni e lettering."
    ],
    "fr": [
      "Je conçois et réalise des peintures acryliques sur différents supports : toiles, murs, contreplaqués, vitrines, objets, etc... sous forme de fresque, trompe l'œil, illustration et lettrage."
    ],
    "nl": [
      "Ik ontwerp en maak acrylschilderijen op verschillende oppervlakken: canvas, muren, multiplex, vitrines, objecten, enz. in de vorm van fresco's, trompe l'oeil, illustraties en belettering."
    ],
    "es": [
      "Diseño y realizo pinturas acrílicas sobre distintas superficies: lienzos, paredes, contrachapados, vitrinas, objetos, etc. en forma de frescos, trampantojos, ilustraciones y letras."
    ]
