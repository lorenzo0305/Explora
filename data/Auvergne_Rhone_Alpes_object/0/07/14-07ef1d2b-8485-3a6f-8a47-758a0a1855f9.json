      "dc:description": {
        "de": [
          "Supermarkt mit Lebensmitteln und Nicht-Lebensmitteln. Elektrische Ladestationen.\n\nGeöffnet montags bis samstags von 08:30 bis 20:00 Uhr, sonntags von 08:30 bis 12:15 Uhr"
        ],
        "en": [
          "Food and non-food supermarket. Electric charging stations.\n\nOpen Monday to Saturday 08:30 to 20:00, Sunday 08:30 to 12:15"
        ],
        "it": [
          "Supermercato di prodotti alimentari e non. Punti di ricarica elettrica.\n\nAperto da lunedì a sabato dalle 8.30 alle 20.00, domenica dalle 8.30 alle 12.15"
        ],
        "fr": [
          "Supermarché alimentaire et non alimentaire. Bornes de recharge électrique. \n\nOuvert du lundi au samedi de 08h30 à 20h, le dimanche de 08h30 à 12h15"
        ],
        "es": [
          "Supermercado de alimentación y no alimentación. Puntos de recarga eléctrica.\n\nAbierto de lunes a sábado de 8.30 a 20.00 h, domingos de 8.30 a 12.15 h"
        ],
        "nl": [
          "Supermarkt voor levensmiddelen en non-food. Elektrische oplaadpunten.\n\nGeopend van maandag tot zaterdag van 8.30 tot 20.00 uur, zondag van 8.30 tot 12.15 uur"
        ]
      },
