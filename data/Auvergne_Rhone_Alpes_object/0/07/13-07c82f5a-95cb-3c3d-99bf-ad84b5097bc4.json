  "rdfs:comment": {
    "de": [
      "Le comptoir empfängt Sie in einem gemütlichen Rahmen mitten im Stadtzentrum von Murat. Probieren Sie hier seine regionalen Spezialitäten oder entdecken Sie seine lokalen Biere bei einem Brett mit Wurstwaren oder Käse aus der Auvergne."
    ],
    "en": [
      "Le comptoir offers a warm welcome in the heart of Murat town center. Come and sample our regional specialities or discover our local beers over a platter of charcuterie or Auvergne cheeses."
    ],
    "it": [
      "Le comptoir vi accoglie in un ambiente accogliente nel centro di Murat. Venite a gustare le sue specialità regionali o a scoprire le sue birre locali con un piatto di salumi o di formaggi d'Alvernia."
    ],
    "fr": [
      "Le comptoir vous accueille dans un cadre chaleureux en plein centre ville de Murat. Venez y déguster ses spécialités régionales ou découvrir ses bières locales autour d'une planche de charcuteries ou de fromages d'Auvergne."
    ],
    "nl": [
      "Le comptoir ontvangt u in een warme omgeving in het centrum van Murat. Kom de regionale specialiteiten proeven of ontdek de lokale bieren met een schotel vleeswaren of kazen uit de Auvergne."
    ],
    "es": [
      "Le comptoir le da la bienvenida en un ambiente cálido en el centro de Murat. Venga a degustar sus especialidades regionales o a descubrir sus cervezas locales con una tabla de embutidos o quesos de Auvernia."
    ]
  },
