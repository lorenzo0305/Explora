  "rdfs:comment": {
    "de": [
      "Zucht von reinrassigen Gascogne-Schweinen und Highland-Kühen, die vollständig im Freien gehalten und biologisch angebaut werden. Unsere Produkte (Fleisch, Wurstwaren usw.) werden von uns selbst auf dem Hof hergestellt und sind 100 % natürlich. Direktverkauf und Feinkostläden."
    ],
    "en": [
      "Organic farm raising pure-bred Gascon pigs and Highland cows in the open air. We make our products (meat, charcuterie) ourselves on the farm from 100% natural ingredients.  We sell direct from the farm and in select food shops."
    ],
    "it": [
      "Allevamento di maiali guasconi di razza pura e di mucche delle Highlands, interamente all'aperto e con metodo biologico. I nostri prodotti (carne, salumi, ecc.) sono realizzati in azienda da noi e sono naturali al 100%. Vendita diretta e gastronomia."
    ],
    "fr": [
      "Élevage de porcs gascons pure race et de vaches Highland, intégralement en plein air et en agriculture biologique. Nos produits (viande, charcuterie…) sont fabriqués à la ferme par nos soins et sont 100 % naturels. Vente en direct et épiceries fines."
    ],
    "nl": [
      "Fokkerij van raszuivere Gasconse varkens en Highland koeien, volledig scharrel en biologisch gekweekt. Onze producten (vlees, vleeswaren, enz.) worden door ons op de boerderij gemaakt en zijn 100% natuurlijk. Directe verkoop en delicatessenwinkels."
    ],
    "es": [
      "Explotación de cerdos de pura raza gascona y vacas de raza Highland, criados totalmente en libertad y de forma ecológica. Nuestros productos (carne, charcutería, etc.) los elaboramos nosotros mismos en la granja y son 100% naturales. Venta directa y charcutería."
    ]
  },
