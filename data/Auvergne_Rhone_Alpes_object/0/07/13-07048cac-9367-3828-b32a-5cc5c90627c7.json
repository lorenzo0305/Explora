  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg seiner früheren Tourneen kehrt der britische Künstler auf die Bühne zurück, um seine Fans wiederzusehen und seine neuen Songs live zu präsentieren."
    ],
    "en": [
      "Following the success of his previous tours, the British artist is returning to the stage to perform his new songs live and reunite with his fans."
    ],
    "it": [
      "Dopo il successo dei suoi precedenti tour, l'artista britannica torna sul palco per riunirsi ai suoi fan e presentare dal vivo le sue nuove canzoni."
    ],
    "fr": [
      "Après le succès de ses précédentes tournées, l’artiste britannique revient sur scène pour retrouver ses fans et présenter ses nouveaux titres en live."
    ],
    "es": [
      "Tras el éxito de sus giras anteriores, la artista británica vuelve a los escenarios para reencontrarse con sus fans y presentar en directo sus nuevas canciones."
    ],
    "nl": [
      "Na het succes van haar vorige tours keert de Britse artieste terug naar het podium om haar fans weer te zien en haar nieuwe nummers live te presenteren."
    ]
  },
