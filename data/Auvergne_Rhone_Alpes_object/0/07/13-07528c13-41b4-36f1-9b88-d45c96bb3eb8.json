  "rdfs:comment": {
    "de": [
      "Das Bar-Restaurant Le Serpaton in Gresse en Vercors empfängt Sie täglich von Mai bis November. Ideal am Ortseingang und in der Nähe eines großen Parkplatzes gelegen, entdecken Sie unsere Terrasse mit herrlichem Blick auf die Almen von Le Serpaton."
    ],
    "en": [
      "The bar-restaurant Le Serpaton in Gresse en Vercors welcomes you every day from May to November. Ideally located at the entrance to the village and close to a large parking lot, come and discover our terrace with a breathtaking view of the Serpaton mountain pastures."
    ],
    "it": [
      "Il bar-ristorante Le Serpaton di Gresse en Vercors vi accoglie tutti i giorni da maggio a novembre. In una posizione ideale all'ingresso del paese e vicino a un ampio parcheggio, venite a scoprire la nostra terrazza con una vista mozzafiato sui pascoli del Serpaton."
    ],
    "fr": [
      "Le bar-restaurant Le Serpaton à Gresse en Vercors vous accueille tous les jours de mai à novembre. Idéalement situé à l'entrée du village et à proximité d'un grand parking, venez découvrir notre terrasse avec vue imprenable sur les alpages du Serpaton."
    ],
    "nl": [
      "Het bar-restaurant Le Serpaton in Gresse en Vercors ontvangt u dagelijks van mei tot november. Ideaal gelegen aan de ingang van het dorp en dicht bij een grote parkeerplaats, kom en ontdek ons terras met een adembenemend uitzicht op de bergweiden van Serpaton."
    ],
    "es": [
      "El bar-restaurante Le Serpaton de Gresse en Vercors le da la bienvenida todos los días de mayo a noviembre. Idealmente situado a la entrada del pueblo y cerca de un gran aparcamiento, venga a descubrir nuestra terraza con una vista impresionante de los pastos de la montaña Serpaton."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Serpaton"
    ]
  },
