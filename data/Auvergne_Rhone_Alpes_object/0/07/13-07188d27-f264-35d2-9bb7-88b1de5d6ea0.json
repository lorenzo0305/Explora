  "rdfs:comment": {
    "de": [
      "„Les Bricoleries de Nanie“ ist eine kleine Modellierwerkstatt aus Kaltporzellan. Alle meine Figuren sind einzigartige, handgeformte Kreationen.  Diese Kreationen können in der Werkstatt erworben werden."
    ],
    "en": [
      "‘Les Bricoleries de Nanie’ is a small cold porcelain modelling workshop. All my figurines are unique, hand-modelled creations.  These creations are on sale at the workshop."
    ],
    "it": [
      "\"Les Bricoleries de Nanie\" è un piccolo laboratorio di modellazione di porcellana a freddo. Tutte le mie figurine sono creazioni uniche, modellate a mano.  Queste creazioni sono in vendita presso il laboratorio."
    ],
    "fr": [
      "\"Les Bricoleries de Nanie\" est un petit atelier de modelage en porcelaine froide. Toutes mes figurines sont des créations uniques modelées à la main.  Ces créations sont en vente à l'atelier."
    ],
    "nl": [
      "\"Les Bricoleries de Nanie\" is een klein koud porselein boetseeratelier. Al mijn beeldjes zijn unieke, met de hand gemodelleerde creaties.  Deze creaties zijn te koop in het atelier."
    ],
    "es": [
      "\"Les Bricoleries de Nanie\" es un pequeño taller de modelado en porcelana fría. Todas mis figuras son creaciones únicas modeladas a mano.  Estas creaciones están a la venta en el taller."
    ]
  },
