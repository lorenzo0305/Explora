  "rdfs:comment": {
    "de": [
      "Ein bretonischer Wind weht durch L'Arbresle. Hier gibt es kein Chichi: gut gefüllte Galettes und Crêpes, frische Produkte und eine gute Portion gute Laune! Kommen Sie und genießen Sie einen Moment der Gaumenfreuden mit der Familie oder mit Freunden."
    ],
    "en": [
      "A Breton breeze blows through L'Arbresle. There's no fuss here: well-stocked galettes and crêpes, fresh produce, and a good dose of good humor! Come and enjoy a gourmet moment with family or friends."
    ],
    "it": [
      "Una brezza bretone soffia su L'Arbresle. Qui non ci sono fronzoli: galettes e crêpes ben fornite, prodotti freschi e una buona dose di buon umore! Venite a godervi un momento gastronomico in famiglia o con gli amici."
    ],
    "fr": [
      "Un vent breton souffle sur L'Arbresle. Ici pas de chichi : des galettes et crêpes bien garnies, des produits frais, et une bonne dose de bonne humeur ! Venez profiter d'un moment gourmand en famille ou entre amis."
    ],
    "es": [
      "Una brisa bretona recorre L'Arbresle. Aquí no hay complicaciones: galettes y crêpes bien surtidas, productos frescos y una buena dosis de buen humor Venga a disfrutar de un momento gastronómico en familia o entre amigos."
    ],
    "nl": [
      "Er waait een Bretons briesje door L'Arbresle. Geen poespas hier: goed gevulde galettes en crêpes, verse producten en een flinke dosis goed humeur! Kom genieten van een gastronomisch moment met je familie of vrienden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ô P'tit Gouelle"
    ]
  },
