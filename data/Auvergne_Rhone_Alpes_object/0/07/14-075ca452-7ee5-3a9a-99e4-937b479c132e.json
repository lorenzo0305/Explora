      "dc:description": {
        "de": [
          "In den Schulferien täglich von 9:00 bis 19:00 Uhr geöffnet.\nPreise: 2? für ein kleines Schließfach und 4? für ein größeres Schließfach (Tagestarif)."
        ],
        "en": [
          "Open every day during school holidays from 9am to 7pm.\nRates: 2€ for a small locker and 4€ for a larger one (daily rate)."
        ],
        "it": [
          "Aperto tutti i giorni durante le vacanze scolastiche dalle 9.00 alle 19.00.\nTariffe: 2? per un armadietto piccolo e 4? per uno più grande (tariffa giornaliera)."
        ],
        "fr": [
          "Ouvert tous les jours des vacances scolaires de 9h à 19h.\nTarifs : 2€ pour un petit casier et 4€ pour un plus grand (tarif à la journée)."
        ],
        "nl": [
          "Tijdens schoolvakanties elke dag geopend van 9.00 tot 19.00 uur.\nTarieven: 2? voor een kleine locker en 4? voor een grotere (dagtarief)."
        ],
        "es": [
          "Abierto todos los días durante las vacaciones escolares de 9h a 19h.\nTarifas: 2? por una taquilla pequeña y 4? por una más grande (tarifa diaria)."
        ]
      },
