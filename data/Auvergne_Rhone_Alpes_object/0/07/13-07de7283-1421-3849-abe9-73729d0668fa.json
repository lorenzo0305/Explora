  "rdfs:comment": {
    "de": [
      "Die Konferenz steht allen offen, sowohl ACCES-Mitgliedern als auch Nichtmitgliedern, und wird von Côme Simien, Dozent für moderne Geschichte an der Universität Paris 1 La Sorbonne, geleitet."
    ],
    "en": [
      "Conference open to all, ACCES members and non-members alike, hosted by Côme Simien, lecturer in modern history at Paris 1 La Sorbonne University."
    ],
    "it": [
      "La conferenza è aperta a tutti, soci e non soci ACCES, e sarà condotta da Côme Simien, docente di storia moderna all'Università di Parigi 1 La Sorbona."
    ],
    "fr": [
      "Conférence ouverte à tous, personnes adhérentes comme non adhérents à ACCES, animée par Côme Simien, maître de conférences en histoire moderne à l'Université Paris 1 La Sorbonne."
    ],
    "es": [
      "La conferencia, abierta a todos, miembros y no miembros de ACCES, correrá a cargo de Côme Simien, profesor de Historia Moderna en la Universidad de París 1 La Sorbona."
    ],
    "nl": [
      "De conferentie is toegankelijk voor iedereen, zowel ACCES-leden als niet-leden, en wordt geleid door Côme Simien, docent moderne geschiedenis aan de Universiteit Paris 1 La Sorbonne."
    ]
  },
  "rdfs:label": {
