  "rdfs:comment": {
    "de": [
      "Das Museum befasst sich auf einzigartige und zeitgenössische Weise mit der Geschichte der Stadt und ihrer Umgebung. Der Rundgang durch die Sammlungen zeigt Gemälde, Gravuren, Skulpturen, Handwerks- und Industriegegenstände, um Rumilly und seine Entwicklungen zu verstehen."
    ],
    "en": [
      "The museum adopts a singular approach to the history of the town and its surrounding area. Progress past the exhibits reveals paintings, engravings, sculptures, artisanal and industrial objects to give an understanding of Rumilly and its development."
    ],
    "it": [
      "Il museo affronta la storia della città e del suo territorio in modo unico e contemporaneo. Le collezioni presentano dipinti, incisioni, sculture, oggetti artigianali e industriali per comprendere Rumilly e la sua evoluzione."
    ],
    "fr": [
      "Le musée aborde de manière singulière et contemporaine l'histoire de la ville et de son territoire. Le parcours des collections présente des tableaux, gravures, sculptures, objets d'artisanat et d'industrie pour comprendre Rumilly et ses évolutions."
    ],
    "nl": [
      "Het museum benadert de geschiedenis van de stad en haar grondgebied op een unieke en hedendaagse manier. De collecties tonen schilderijen, gravures, beeldhouwwerken, ambachtelijke en industriële voorwerpen om Rumilly en zijn evolutie te begrijpen."
    ],
    "es": [
      "El museo aborda la historia de la ciudad y su territorio de una manera única y contemporánea. Las colecciones presentan pinturas, grabados, esculturas, artesanía y objetos industriales para comprender a Rumilly y su evolución."
    ]
  },
  "rdfs:label": {
