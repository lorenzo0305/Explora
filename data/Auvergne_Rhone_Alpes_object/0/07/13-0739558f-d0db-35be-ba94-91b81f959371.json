  "rdfs:comment": {
    "de": [
      "Das Café du Centre befindet sich im Stadtzentrum von Aime und verfügt über eine schöne Terrasse."
    ],
    "en": [
      "Le Café du Centre is right in the middle of Aime with a lovely terrace.\r\nSpecial evening events and screening of sports events are organised year round!"
    ],
