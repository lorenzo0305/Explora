  "rdfs:comment": {
    "de": [
      "Sarah ist eine diplomierte und leidenschaftliche Heilpraktikerin und empfängt Sie in einer gemütlichen Praxis im Herzen der Stadt La Roche-sur-Foron, um Ihnen mit Hilfe von Magnetismus, Yoga und Handmassage zu einem funktionellen und emotionalen Gleichgewicht zu verhelfen."
    ],
    "en": [
      "Qualified and passionate, Sarah welcomes you to a warm and welcoming practice in the heart of La Roche-sur-Foron, to help you regain functional and emotional balance through magnetism sessions, yoga classes and hand massage."
    ],
    "it": [
      "Qualificata e appassionata, Sarah vi accoglie nel suo studio caldo e accogliente nel cuore della città di La Roche-sur-Foron, per aiutarvi a ritrovare l'equilibrio funzionale ed emotivo attraverso sedute di magnetismo, lezioni di yoga e massaggi alle mani."
    ],
    "fr": [
      "Diplômée et passionnée, Sarah vous accueille dans un chaleureux cabinet au cœur de la ville de La Roche-sur-Foron, afin de retrouver un équilibre fonctionnel et émotionnel global, au travers de séance de magnétisme, cours de yoga et massage des mains."
    ],
    "nl": [
      "Sarah is gekwalificeerd en gepassioneerd. Ze verwelkomt je in haar warme en gastvrije praktijk in het hart van het stadje La Roche-sur-Foron, om je te helpen je functionele en emotionele balans te hervinden door middel van magnetise-sessies, yogalessen en handmassages."
    ],
    "es": [
      "Cualificada y apasionada, Sarah le da la bienvenida a su cálida y acogedora consulta en el corazón de la ciudad de La Roche-sur-Foron, para ayudarle a recuperar el equilibrio funcional y emocional a través de sesiones de magnetismo, clases de yoga y masajes de manos."
    ]
  },
