  "rdfs:comment": {
    "de": [
      "Die Bar Les 2 Zèbres, die ideal an der Schneefront gelegen und von der Einkaufsstraße von Montalbert aus erreichbar ist, empfängt Sie im Saal oder auf der Terrasse zu einer entspannten Pause."
    ],
    "en": [
      "The bar Les 2 Zèbres, ideally located in front of the snow and accessible from the shopping street of Montalbert, welcomes you indoors or outdoors for a relaxing break."
    ],
    "it": [
      "Il bar Les 2 Zèbres, situato in posizione ideale sul fronte della neve e accessibile dalla via commerciale Montalbert, vi accoglie all'interno o sulla terrazza per una pausa rilassante."
    ],
    "fr": [
      "Le bar Les 2 Zèbres, idéalement situé en front de neige et accessible depuis la rue commerçante de Montalbert, vous accueille en salle ou en terrasse pour une pause détente."
    ],
    "es": [
      "El bar Les 2 Zèbres, idealmente situado en el frente de la nieve y accesible desde la calle comercial Montalbert, le da la bienvenida en el interior o en la terraza para un descanso."
    ],
    "nl": [
      "De bar Les 2 Zèbres, ideaal gelegen aan de voorkant van de sneeuw en bereikbaar vanaf de winkelstraat Montalbert, verwelkomt u binnen of op het terras voor een ontspannende pauze."
    ]
  },
