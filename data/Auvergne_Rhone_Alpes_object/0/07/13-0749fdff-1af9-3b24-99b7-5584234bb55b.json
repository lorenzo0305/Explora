  "rdfs:comment": {
    "de": [
      "Mit Belledonne Création gönnen Sie sich einzigartige Holzstücke, die nach Maß angefertigt werden. Ob zartes Schmuckstück, Dekorationsobjekt oder funktionales Möbelstück, jede Kreation wird im Atelier mit Leidenschaft durchdacht und umgesetzt."
    ],
    "en": [
      "With Belledonne Création, treat yourself to unique, made-to-measure pieces of wood. Whether it's a delicate piece of jewelry, a decorative object or a functional piece of furniture, each creation is thought out and crafted with passion in our workshop."
    ],
    "it": [
      "Con Belledonne Création potete regalarvi pezzi di legno unici e su misura. Che si tratti di un gioiello delicato, di un oggetto decorativo o di un mobile funzionale, ogni creazione è pensata e realizzata con passione in laboratorio."
    ],
    "fr": [
      "Avec Belledonne Création, offrez-vous des pièces uniques en bois, réalisées sur mesure. Qu'il s'agisse d'un bijou délicat, d'un objet de décoration ou d'un meuble fonctionnel, chaque création est pensée et réalisée avec passion dans l'atelier."
    ],
    "es": [
      "Con Belledonne Création, podrá regalarse piezas únicas de madera hechas a medida. Ya sea una delicada joya, un objeto decorativo o un mueble funcional, cada creación está pensada y creada con pasión en el taller."
    ],
    "nl": [
      "Bij Belledonne Création kun je jezelf trakteren op unieke, op maat gemaakte stukken hout. Of het nu gaat om een delicaat sieraad, een decoratief object of een functioneel meubelstuk, elke creatie is doordacht en met passie gemaakt in het atelier."
    ]
  },
  "rdfs:label": {
