  "rdfs:comment": {
    "de": [
      "Verkauf zum Mitnehmen und vor Ort in unserem Restaurant\r\nSoße und Zutaten HAUSGEMACHT.\r\nMit der Treuekarte wird Ihnen für die 12. Pizza ein Wert von 9? abgezogen."
    ],
    "en": [
      "Takeaway and on-site sales in our restaurant\r\nHomemade sauces and ingredients.\r\nA value of 9? will be deducted on the 12th pizza with the loyalty card."
    ],
    "it": [
      "Vendita da asporto e in loco nel nostro ristorante\r\nSalse e ingredienti fatti in casa.\r\nUn valore di 9? sarà detratto dalla vostra dodicesima pizza con la vostra carta fedeltà."
    ],
    "fr": [
      "Vente à emporter et sur place dans notre restaurant \r\nSauce et ingrédients MAISON.\r\nUne valeur de 9€ vous sera déduite sur la 12ème pizza avec la carte de fidélité."
    ],
    "es": [
      "Comida para llevar y venta in situ en nuestro restaurante\r\nSalsas e ingredientes caseros.\r\nSe descontará un valor de 9€ de tu 12ª pizza con tu tarjeta de fidelidad."
    ],
    "nl": [
      "Afhaalmaaltijden en verkoop ter plaatse in ons restaurant\r\nHuisgemaakte sauzen en ingrediënten.\r\nEen waarde van 9? wordt in mindering gebracht op uw 12e pizza met uw klantenkaart."
    ]
  },
