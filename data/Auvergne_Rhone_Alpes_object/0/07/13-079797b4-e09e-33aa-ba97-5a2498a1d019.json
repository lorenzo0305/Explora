  "rdfs:comment": {
    "de": [
      "Das Clos de Breuilly ist ein 10 Hektar großes Weingut, das biologisch bewirtschaftet wird. Besuchen Sie das Weingut und probieren Sie unsere Weine nach vorheriger Anmeldung 48 Stunden im Voraus."
    ],
    "en": [
      "Le Clos de Breuilly is a 10-hectare organic winegrowing estate. Visit the estate and taste our wines by appointment 48 hours in advance."
    ],
    "it": [
      "Le Clos de Breuilly è un'azienda vinicola biologica di 10 ettari. Visitate la tenuta e degustate i nostri vini su appuntamento con 48 ore di anticipo."
    ],
    "fr": [
      "Le Clos de Breuilly est un domaine viticole de 10 hectares cultivé en bio. Visite du domaine et dégustation de nos vins sur rendez-vous 48h à l'avance."
    ],
    "nl": [
      "Le Clos de Breuilly is een biologisch wijndomein van 10 hectare. Bezoek het landgoed en proef onze wijnen op afspraak 48 uur van tevoren."
    ],
    "es": [
      "Le Clos de Breuilly es una finca vinícola ecológica de 10 hectáreas. Visite la finca y deguste nuestros vinos concertando una cita con 48 horas de antelación."
    ]
  },
