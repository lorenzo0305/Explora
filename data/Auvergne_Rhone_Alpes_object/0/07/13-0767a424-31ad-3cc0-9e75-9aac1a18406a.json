  "rdfs:comment": {
    "de": [
      "Besuchen Sie den von Attelage 43 organisierten Nationalen Gespannwettbewerb: Dressur- und Manövrierwettbewerb am Samstag und Marathon am Sonntag.\r\nDer Eintritt ist frei. Getränkestand."
    ],
    "en": [
      "Come and see the National Driving Competition organized by Attelage 43: dressage and handling competitions on Saturday, and a marathon on Sunday.\r\nFree admission. Refreshment bar."
    ],
    "it": [
      "Venite a vedere il Concorso Nazionale di Guida organizzato da Attelage 43: gare di dressage e di handling il sabato e una maratona la domenica.\r\nIngresso libero. Bar per il ristoro."
    ],
    "fr": [
      "Venez assister au Concours National d'Attelage organisé par Attelage 43 : concours de dressage et maniabilité le samedi, et marathon le dimanche. \r\nEntrée libre. Buvette."
    ],
    "es": [
      "Venga a ver el Concurso Nacional de Conducción organizado por Attelage 43: competiciones de doma y manejo el sábado, y un maratón el domingo.\r\nEntrada gratuita. Bar."
    ],
    "nl": [
      "Kom kijken naar de Nationale Rijcompetitie georganiseerd door Attelage 43: dressuur- en menwedstrijden op zaterdag en een marathon op zondag.\r\nGratis toegang. Versnaperingsbar."
    ]
  },
