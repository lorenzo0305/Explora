  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser gesamtes Kulturprogramm: Wir erwarten Sie zahlreich, um an einem Salsa-Abend, einer Partie Coinche, Improvisationstheater oder auch einem Abend mit Musik teilzunehmen!"
    ],
    "en": [
      "Discover our full cultural program: we look forward to welcoming you to a salsa night, a game of coinche, improv theater or an evening of music!"
    ],
    "it": [
      "Scoprite il nostro programma culturale: non vediamo l'ora di accogliervi per una serata di salsa, una partita di coinche, un'improvvisazione teatrale o una serata di musica!"
    ],
    "fr": [
      "Découvrez toute notre programmation culturelle : on vous attend nombreux pour participer à une soirée salsa, une partie de coinche, du théâtre d'impro ou encore une soirée en musique !"
    ],
    "nl": [
      "Ontdek alles over ons culturele programma: we verwelkomen je graag op een salsa-avond, een spelletje coinche, improvisatietheater of een muziekavond!"
    ],
    "es": [
      "Infórmese sobre nuestro programa cultural: ¡le esperamos para una noche de salsa, una partida de coinche, teatro de improvisación o una velada musical!"
    ]
  },
  "rdfs:label": {
