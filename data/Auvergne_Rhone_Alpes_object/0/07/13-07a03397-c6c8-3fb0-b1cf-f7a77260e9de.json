  "rdfs:comment": {
    "de": [
      "In Partnerschaft mit LADAPT Drôme Ardèche ? zugänglich für Personen mit eingeschränkter Mobilität.\r\nStreet Art, Fresken, Installationen, Skulpturen - machen Sie sich auf den Weg, um die Kunst auf der Straße kennenzulernen. Beobachten Sie auf einem Rundgang durch die Stadt die verschiedenen Techniken und Medien, die verwendet werden."
    ],
    "en": [
      "In partnership with LADAPT Drôme Ardèche ? accessible for wheelchair users.\r\nStreet art, frescoes, installations, sculptures: come and discover art in the street. Take a tour of the city to see the different techniques and media used."
    ],
    "it": [
      "In collaborazione con LADAPT Drôme Ardèche ? accessibile alle PRM.\r\nArte di strada, affreschi, installazioni, sculture: venite a scoprire l'arte in strada. Fate un giro per la città e osservate le diverse tecniche e i diversi supporti utilizzati."
    ],
    "fr": [
      "En partenariat avec LADAPT Drôme Ardèche – accessible PMR.\r\nStreet art, fresques, installations, sculptures, partez à la rencontre de l’art dans la rue. Observez, à travers un parcours dans la ville, les différentes techniques et médiums utilisés."
    ],
    "nl": [
      "In samenwerking met LADAPT Drôme Ardèche ? toegankelijk voor PBM's.\r\nStraatkunst, fresco's, installaties, beeldhouwwerken: kom en ontdek kunst op straat. Maak een rondleiding door de stad en bekijk de verschillende technieken en media die worden gebruikt."
    ],
    "es": [
      "En colaboración con LADAPT Drôme Ardèche... accesible para PMR.\r\nArte callejero, frescos, instalaciones, esculturas: venga a descubrir el arte en la calle. Recorra la ciudad y observe las diferentes técnicas y soportes utilizados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : l'Art dans la rue à Romans"
    ]
  },
