  "rdfs:comment": {
    "de": [
      "Verstecktes Höhenrestaurant am Fuße der Pointe Percée, wo das Tal von Doran seine Authentizität bewahrt hat. Entdecken Sie einen Ort, an dem Pastoralismus, Sport und Natur in perfekter Harmonie zusammenleben."
    ],
    "en": [
      "Mountain restaurant nestled at the foot of La Pointe Percée where the Doran Valley has stayed true to its roots. Soak up a spot where agriculture, sport and nature thrive in perfect harmony."
    ],
    "it": [
      "Ristorante d'altitudine situato ai piedi della Pointe Percée, dove la valle di Doran ha saputo mantenere la propria autenticità. Scoprite un luogo in cui pastorizia, sport e natura convivono in perfetta armonia."
    ],
    "fr": [
      "Restaurant d'altitude caché au pied de la Pointe Percée où le vallon de Doran a su garder son authenticité. Découvrez un lieu où pastoralisme, sport et nature cohabitent en parfaite harmonie."
    ],
    "es": [
      "Restaurante de altura escondido al pie de la Pointe Percée, donde el valle de Doran ha conservado su autenticidad. Descubra un lugar donde el pastoreo, el deporte y la naturaleza conviven en perfecta armonía."
    ],
    "nl": [
      "Hooggelegen restaurant verborgen aan de voet van de Pointe Percée waar de Doran-vallei zijn authenticiteit heeft behouden. Ontdek een plek waar veehouderij, sport en natuur in perfecte harmonie samenleven."
    ]
  },
