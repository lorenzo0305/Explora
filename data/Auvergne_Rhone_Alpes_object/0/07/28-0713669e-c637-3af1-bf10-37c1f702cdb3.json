  "rdfs:comment": {
    "de": [
      "Betreuung von Kindern ab 2 Jahren, Jugendlichen und Erwachsenen pro Sitzung oder pro Tag.\nEmpfang von Gruppen mit Ausarbeitung eines individuellen pädagogischen Projekts.\nReittourismus, Pferdeclub, Poney-Club."
    ],
    "en": [
      "We welcome children from 2 years old, teenagers and adults for a session or a day.\nReception of groups with elaboration of a personalized pedagogical project.\nEquestrian tourism, horse club, pony club."
    ],
    "it": [
      "Bambini a partire dai 2 anni, adolescenti e adulti sono i benvenuti per una sessione o una giornata.\nI gruppi possono essere accolti con un progetto educativo personalizzato.\nTurismo equestre, club di cavalli, pony club."
    ],
    "fr": [
      "Accueil à la séance ou à la journée d'enfants dès 2 ans, d'ados et d'adultes.\nAccueil de groupes avec élaboration d'un projet pédagogique personnalisé.\nTourisme équestre, cheval-club, poney-club."
    ],
    "es": [
      "Niños a partir de 2 años, adolescentes y adultos son bienvenidos para una sesión o un día.\nLos grupos pueden ser acomodados con un proyecto educativo personalizado.\nTurismo ecuestre, club de caballos, club de ponis."
    ],
    "nl": [
      "Kinderen vanaf 2 jaar, tieners en volwassenen zijn welkom per sessie of per dag.\nGroepen kunnen worden ontvangen met een gepersonaliseerd educatief project.\nHippisch toerisme, paardenclub, ponyclub."
    ]
  },
