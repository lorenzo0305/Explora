  "rdfs:comment": {
    "de": [
      "Die Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire ist ein gemeinnütziger Verein, der für den Naturschutz zugelassen ist."
    ],
    "en": [
      "The Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire (Haute-Loire Federation for Fishing and Protection of the Aquatic Environment) is a not-for-profit, public interest association approved for the protection of nature."
    ],
    "it": [
      "La Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire (Federazione della Pesca e della Protezione dell'Ambiente Acquatico dell'Alta Loira) è un'associazione di interesse pubblico senza scopo di lucro, approvata per la conservazione della natura."
    ],
    "fr": [
      "La Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire est une association à but non lucratif, à caractère d'utilité publique et agréée au titre de la protection de la nature."
    ],
    "es": [
      "La Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire (Federación de Pesca y Protección del Medio Acuático del Alto Loira) es una asociación sin ánimo de lucro y de interés público aprobada para la conservación de la naturaleza."
    ],
    "nl": [
      "De Fédération de Pêche et de Protection du Milieu Aquatique de la Haute-Loire (Federatie voor Visserij en Bescherming van het Aquatisch Milieu in de Haute-Loire) is een vereniging zonder winstoogmerk en van openbaar belang die is erkend voor natuurbehoud."
    ]
  },
  "rdfs:label": {
