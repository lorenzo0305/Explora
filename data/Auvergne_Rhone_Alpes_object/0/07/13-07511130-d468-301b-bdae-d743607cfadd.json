  "rdfs:comment": {
    "de": [
      "Honig und daraus hergestellte Produkte; AB-zertifiziert.\r\nVerkauf auf dem Markt: Saint-Péray, Mittwochmorgen; Vernoux-en-Vivarais, Donnerstagmorgen; Romans-sur-Isère, Sonntagmorgen. Im Betrieb nach Vereinbarung (Tel. 06 38 01 32 96)."
    ],
    "en": [
      "Honey and by-products; certified AB.\r\nMarket sales: Saint-Péray, Wednesday morning; Vernoux-en-Vivarais, Thursday morning; Romans-sur-Isère, Sunday morning. At the farm by appointment (tel. 06 38 01 32 96)."
    ],
    "it": [
      "Miele e sottoprodotti; certificato AB.\r\nVendita al mercato: Saint-Péray, mercoledì mattina; Vernoux-en-Vivarais, giovedì mattina; Romans-sur-Isère, domenica mattina. In azienda su appuntamento (tel. 06 38 01 32 96)."
    ],
    "fr": [
      "Miel et produits dérivés ; certifiés AB.\r\nVente au marché : Saint-Péray, le mercredi matin ; Vernoux-en-Vivarais, le jeudi matin ; Romans-sur-Isère, le dimanche matin. A l'exploitation sur rendez-vous (tel. 06 38 01 32 96)."
    ],
    "es": [
      "Miel y subproductos; certificado AB.\r\nVenta en el mercado: Saint-Péray, miércoles por la mañana; Vernoux-en-Vivarais, jueves por la mañana; Romans-sur-Isère, domingos por la mañana. En la granja con cita previa (tel. 06 38 01 32 96)."
    ],
    "nl": [
      "Honing en bijproducten; gecertificeerd AB.\r\nMarktverkoop: Saint-Péray, woensdagochtend; Vernoux-en-Vivarais, donderdagochtend; Romans-sur-Isère, zondagochtend. Op de boerderij op afspraak (tel. 06 38 01 32 96)."
    ]
  },
  "rdfs:label": {
