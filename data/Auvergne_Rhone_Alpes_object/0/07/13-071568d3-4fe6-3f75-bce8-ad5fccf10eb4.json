  "rdfs:comment": {
    "de": [
      "Das Weingut JACQUELINE Père et Filles baut seine Weinberge am Ufer des Lac du Bourget wie einen Garten an, um in einem hundertjährigen Weinkeller in Aix-les-Bains biologische Savoyer Weine herzustellen."
    ],
    "en": [
      "Domaine JACQUELINE Père et Filles cultivates their vineyards on the shores of Lac du Bourget like a garden to produce organic Savoy wines in a century-old cellar in Aix-les-Bains."
    ],
    "it": [
      "La tenuta JACQUELINE Père et Filles coltiva le sue viti sulle rive del Lac du Bourget come un giardino per produrre vini savoiardi biologici in una cantina centenaria ad Aix-les-Bains."
    ],
    "fr": [
      "Le domaine JACQUELINE Père et Filles cultive leurs vignes au bord du Lac du Bourget comme un jardin pour élaborer des vins de Savoie biologiques au sein d'une cave centenaire à Aix-les-Bains."
    ],
    "es": [
      "La finca JACQUELINE Père et Filles cultiva sus viñas a orillas del lago Bourget como un jardín para producir vinos ecológicos de Saboya en una bodega centenaria de Aix-les-Bains."
    ],
    "nl": [
      "Het domein JACQUELINE Père et Filles cultiveert zijn wijnstokken aan de oevers van het Lac du Bourget als een tuin om biologische Savoie-wijnen te produceren in een eeuwenoude kelder in Aix-les-Bains."
    ]
  },
