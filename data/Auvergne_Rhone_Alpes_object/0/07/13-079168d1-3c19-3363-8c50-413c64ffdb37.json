  "rdfs:comment": {
    "de": [
      "Das Schloss von Aulan ist der einzige private Wohnsitz in den Baronnies, der für Besucher zugänglich ist. Es birgt zahlreiche Familienandenken der Suarez d'Aulan, insbesondere aus der Zeit Napoleons III. Es wurde auf einem Felsvorsprung erbaut, der das Tal des Toulourenc überragt."
    ],
    "en": [
      "The only private residence in the Baronnies region open to visitors, the Château d'Aulan holds many Suarez d'Aulan family heirlooms, particularly from the time of Napoleon III. It is built on a rocky spur overlooking the Toulourenc valley."
    ],
    "it": [
      "Unica residenza privata delle Baronnies aperta ai visitatori, il castello d'Aulan contiene molti ricordi di famiglia della famiglia Suarez d'Aulan, in particolare sotto Napoleone III. È costruito su uno sperone roccioso che domina la valle di Toulourenc."
    ],
    "fr": [
      "Seule demeure privée des Baronnies ouverte à la visite, le château d'Aulan recèle de nombreux souvenirs de famille des Suarez d'Aulan, en particulier sous Napoléon III. Il est construit sur un éperon rocheux dominant la vallée du Toulourenc."
    ],
    "es": [
      "Única residencia privada de las Baronnies abierta a los visitantes, el castillo de Aulan contiene numerosos recuerdos familiares de la familia Suárez de Aulan, especialmente bajo el mandato de Napoleón III. Está construido en un espolón rocoso que domina el valle de Toulourenc."
    ],
    "nl": [
      "Het Château d'Aulan is het enige privéverblijf in de Baronnies dat toegankelijk is voor bezoekers en herbergt veel erfstukken van de familie Suarez d'Aulan, vooral uit de tijd van Napoleon III. Het is gebouwd op een rotsachtige uitloper die uitkijkt over de vallei van Toulourenc."
    ]
  },
