  "rdfs:comment": {
    "de": [
      "Zwischen Saint-Martin d'Ardèche und Vallon-Pont d'Arc verwöhnt Sie das Bistrot de la Grotte (Standort der Grotte Saint-Marcel) mit Salaten und Wurstplatten aus frischen, lokalen Produkten, die zu 100 % aus der Ardèche stammen."
    ],
    "en": [
      "Between Saint-Martin d'Ardèche and Vallon-Pont d'Arc, the Bistrot de la Grotte (on the site of the Grotte Saint-Marcel) serves up salads and charcuterie platters made with fresh, local, 100% Ardèche produce."
    ],
    "it": [
      "Tra Saint-Martin d'Ardèche e Vallon-Pont d'Arc, il Bistrot de la Grotte (sul sito della Grotte Saint-Marcel) propone insalate e taglieri di salumi preparati con prodotti freschi, locali e 100% Ardèche."
    ],
    "fr": [
      "Entre Saint-Martin d’Ardèche et Vallon-Pont d’Arc, le Bistrot de la Grotte (site de la Grotte Saint-Marcel) vous régale avec salades et planches de charcuterie composées de produits frais, locaux et 100 % ardéchois."
    ],
    "nl": [
      "Tussen Saint-Martin d'Ardèche en Vallon-Pont d'Arc serveert de Bistrot de la Grotte (op de plek van de Grotte Saint-Marcel) salades en vleesgerechten op basis van verse, lokale producten en 100% producten uit de Ardèche."
    ],
    "es": [
      "Entre Saint-Martin d'Ardèche y Vallon-Pont d'Arc, el Bistrot de la Grotte (en el emplazamiento de la Grotte Saint-Marcel) sirve ensaladas y tablas de embutidos elaborados con productos frescos, locales y 100% de Ardèche."
    ]
  },
