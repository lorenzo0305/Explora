  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cb202ab2-83b3-333b-8da5-b2c457d188ab",
      "dc:description": {
        "de": [
          "Rustikales Ambiente, das abwechslungsreiche Rezepte rund um die Kartoffel bietet.\n\nTagesgericht, Salate, Fisch, Kindermenü\n\nAnsatz \"Zero Waste\" (Null Abfall)"
        ],
        "en": [
          "A rustic atmosphere with a variety of potato recipes.\n\nDaily specials, salads, fish, children's menu\n\nZero waste\" approach"
        ],
        "it": [
          "Un ambiente rustico con una varietà di ricette a base di patate.\n\nPiatti del giorno, insalate, pesce, menù per bambini\n\nApproccio \"rifiuti zero"
        ],
        "fr": [
          "Ambiance rustique offrant des recettes variées autour de la pomme de terre.\n\nPlat du jour, salades, poissons, menu enfant\n\nDémarche \"Zéro déchet\""
        ],
        "es": [
          "Un ambiente rústico con una gran variedad de recetas a base de patatas.\n\nPlato del día, ensaladas, pescado, menú infantil\n\nEnfoque \"Residuo cero"
        ],
        "nl": [
          "Een rustieke sfeer met een verscheidenheid aan aardappelrecepten.\n\nDagschotel, salades, vis, kindermenu\n\nZero waste\" benadering"
        ]
      },
