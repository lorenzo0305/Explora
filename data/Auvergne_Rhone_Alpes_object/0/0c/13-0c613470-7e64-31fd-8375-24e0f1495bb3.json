  "rdfs:comment": {
    "de": [
      "In einem typischen Dorf des Cantal, Vezels-Roussy (20 km von Aurillac), empfangen Sie Céline und Marcel in der Bergerie** in einer familiären und authentischen Umgebung."
    ],
    "en": [
      "In a typical Cantal village, Vezels-Roussy located at 20km from Aurillac, Céline and Marcel welcome you to La Bergerie, in a family and authentic setting."
    ],
    "it": [
      "In un tipico villaggio del Cantal, Vezels-Roussy (a 20 km da Aurillac), Céline e Marcel vi danno il benvenuto alla Bergerie**, in un ambiente familiare e autentico."
    ],
    "fr": [
      "Dans un village typique du Cantal, Vezels-Roussy (20km d’Aurillac), Céline et Marcel vous accueillent à la Bergerie**, dans un cadre familial et authentique."
    ],
    "nl": [
      "In een typisch dorpje in de Cantal, Vezels-Roussy (20 km van Aurillac), heten Céline en Marcel u welkom in de Bergerie**, in een familiale en authentieke omgeving."
    ],
