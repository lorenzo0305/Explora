  "rdfs:comment": {
    "de": [
      "Jachthaafen mit Aufnahmekapazität für 8 bis 16 Boote .Anlage zur Überwinterung der Boote geeignet. Anlegeplatz für Handels- oder Kreuzfahrtschiffe. Ausflugslokal im Sommer geöffnet"
    ],
    "en": [
      "Marina with capacity for 8 to 16 boats. Nautical sports centre for wintering of small boats. Quai fluvial authorises mooring of commercial vessels, cruise boats and pleasure boats. Open-air café open in summer."
    ],
    "it": [
      "Marina con capacità da 8 a 18 barche. Base nautica per lo svernamento delle imbarcazioni. Banchina fluviale per l'ormeggio di navi commerciali, navi da crociera e imbarcazioni da diporto. Guinguettes aperte in estate."
    ],
    "fr": [
      "Port de plaisance d'une capacité de 8 à 18 bateaux. Base nautique permettant l'hivernage des embarcations. Quai fluvial autorisant l'amarrage de bateaux de commerce, navires de croisière et bateaux de plaisance. Guinguettes ouvertes en été."
    ],
    "es": [
      "Puerto deportivo con capacidad de 8 a 18 embarcaciones. Base náutica para invernada de embarcaciones. Muelle fluvial para amarre de buques comerciales, cruceros y embarcaciones de recreo. Guinguettes abiertas en verano."
    ],
    "nl": [
      "Jachthaven met plaats van 8 tot 16 boten. Drooghaven voor de winter. Rivierkade met aanlegplaatsen voor schepen en cruiseboten. Strandsnackbar geopend in de zomermaanden"
    ]
  },
  "rdfs:label": {
    "de": [
      "Jachthafen : Freizeit- und Wassersportanlage"
    ],
    "en": [
      "Port de Plaisance : halte fluviale et base nautique"
    ],
    "fr": [
      "Port de plaisance"
    ],
    "nl": [
      "Jachthaven: aanlegsteiger en haven"
    ]
  },
