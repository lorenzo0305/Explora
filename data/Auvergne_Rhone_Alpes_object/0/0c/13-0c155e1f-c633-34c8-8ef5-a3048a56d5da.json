  "rdfs:comment": {
    "de": [
      "Mitten auf dem Land bietet die Ferme Équestre Jolinka eine familiäre und fürsorgliche Hundepension. Die Hunde werden in einer ruhigen Umgebung mit täglichen Spaziergängen, persönlicher Zuwendung und sicheren Räumen untergebracht. Tägliche Videos."
    ],
    "en": [
      "In the heart of the countryside, the Jolinka Equestrian Farm offers a family-run, friendly dog boarding service. Dogs are welcomed into a calm environment, with daily walks, personalised attention and secure areas. Daily videos."
    ],
    "it": [
      "Nel cuore della campagna, la fattoria equestre Jolinka offre un servizio di pensione per cani a conduzione familiare e amichevole. I cani sono accolti in un ambiente tranquillo, con passeggiate quotidiane, attenzione personalizzata e aree sicure. Video giornalieri."
    ],
    "fr": [
      "En pleine campagne, la Ferme Équestre Jolinka propose une pension canine familiale et bienveillante. Les chiens sont accueillis dans un environnement calme, avec balades quotidiennes, attention personnalisée et espaces sécurisés. Vidéos quotidiennes."
    ],
    "nl": [
      "In het hart van het platteland biedt de Jolinka Equestrian Farm een gezinsvriendelijk hondenpension. Honden worden verwelkomd in een rustige omgeving, met dagelijkse wandelingen, persoonlijke aandacht en veilige zones. Dagelijkse video's."
    ],
    "es": [
      "En plena naturaleza, la Granja Ecuestre Jolinka ofrece un servicio familiar y acogedor de alojamiento de perros. Los perros son acogidos en un ambiente tranquilo, con paseos diarios, atención personalizada y zonas seguras. Vídeos diarios."
    ]
  },
  "rdfs:label": {
