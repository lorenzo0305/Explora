  "rdfs:comment": {
    "de": [
      "Zësar Bahamonte stammt aus der Peripherie von Sevilla. Schon in jungen Jahren gehörte das Zeichnen zu ihrem Alltag."
    ],
    "en": [
      "Zësar Bahamonte hails from the outskirts of Seville. From an early age, drawing has been part of her daily routine."
    ],
    "it": [
      "Zësar Bahamonte viene dalla periferia di Siviglia. Il disegno fa parte della sua vita quotidiana fin dalla più tenera età."
    ],
    "fr": [
      "Zësar Bahamonte est originaire de la périphérie de Séville. Dès son plus jeune âge, la pratique du dessin fait partie de son quotidien."
    ],
    "nl": [
      "Zësar Bahamonte komt uit de buitenwijken van Sevilla. Tekenen maakt al van jongs af aan deel uit van haar dagelijks leven."
    ],
    "es": [
      "Zësar Bahamonte es natural de las afueras de Sevilla. El dibujo forma parte de su vida cotidiana desde muy pequeña."
    ]
