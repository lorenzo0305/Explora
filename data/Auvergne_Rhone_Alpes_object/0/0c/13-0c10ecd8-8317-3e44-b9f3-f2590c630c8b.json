  "rdfs:comment": {
    "de": [
      "In diesem Körper-an-Körper mit einem Schlagzeug widmet Aina Alegre eine neue Studie der Geste des \"Hämmerns\", die seit jeher im Zentrum ihrer choreografischen Handschrift steht."
    ],
    "en": [
      "In this hand-to-hand encounter with a drum kit, Aina Alegre devotes a new study to the gesture of \"hammering\", which has always been at the heart of her choreographic writing."
    ],
    "it": [
      "In questo incontro corpo a corpo con una batteria, Aina Alegre dedica un nuovo studio al gesto del \"martellare\", da sempre al centro della sua scrittura coreografica."
    ],
    "fr": [
      "Dans ce corps-à-corps avec une batterie, Aina Alegre consacre une nouvelle étude au geste du « martèlement », depuis toujours au cœur de son écriture chorégraphique."
    ],
    "nl": [
      "In deze ontmoeting van hand tot hand met een drumstel wijdt Aina Alegre een nieuw onderzoek aan het gebaar van 'hameren', dat altijd centraal heeft gestaan in haar choreografieën."
    ],
    "es": [
      "En este encuentro mano a mano con una batería, Aina Alegre dedica un nuevo estudio al gesto del \"martilleo\", que siempre ha estado en el centro de su escritura coreográfica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de danse : Réverbérations - Étude 8"
    ]
  },
