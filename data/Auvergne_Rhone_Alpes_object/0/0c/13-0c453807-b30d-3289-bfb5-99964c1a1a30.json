  "rdfs:comment": {
    "de": [
      "Im Herzen der Natur, in einer grünen Oase, entdecken Sie das Bar-Restaurant \"La Table du golf\". Küche mit regionalen und saisonalen Produkten.\r\nBar von 8 Uhr bis 19 Uhr geöffnet. Restaurant von 12 bis 16 Uhr geöffnet."
    ],
    "en": [
      "In the heart of nature, in a green setting, come and discover the Bar-Restaurant \"La Table du golf\". Local and seasonal cuisine.\r\nBar open from 8am to 7pm. Restaurant open from 12pm to 4pm."
    ],
    "it": [
      "Nel cuore della natura, in un ambiente verde, venite a scoprire il Bar-Ristorante \"La Table du golf\". Cucina locale e stagionale.\r\nBar aperto dalle 8.00 alle 19.00. Ristorante aperto dalle 12.00 alle 16.00."
    ],
    "fr": [
      "Au cœur de la nature, dans un écrin de verdure, venez découvrir le Bar-Restaurant à \"La Table du golf\". Cuisine de produits du terroir et de saison. \r\nBar ouvert de 8h à 19h. Restaurant service de 12h à 16h."
    ],
    "nl": [
      "In het hart van de natuur, in een groene omgeving, kom en ontdek de Bar-Restaurant \"La Table du golf\". Lokale en seizoensgebonden keuken.\r\nBar open van 8 tot 19 uur. Restaurant open van 12 tot 16 uur."
    ],
    "es": [
      "En plena naturaleza, en un entorno verde, venga a descubrir el Bar-Restaurante \"La Table du golf\". Cocina local y de temporada.\r\nBar abierto de 8h a 19h. Restaurante abierto de 12h a 16h."
    ]
  },
  "rdfs:label": {
