  "rdfs:comment": {
    "de": [
      "Unser absolutes Engagement für die Kunst des Wohlbefindens.\r\nDas Spa Le Mont Anis, eine wahre Oase der Raffinesse im Herzen der Stadt Le Puy-en-Velay, lädt Sie zu einer Sinnesreise ein, bei der die Kunst des Wohlbefindens mit authentischem Luxus verbunden wird."
    ],
    "en": [
      "Our absolute commitment to the art of well-being.\r\nThe Spa Le Mont Anis, a haven of refinement nestled in the heart of the city of Le Puy-en-Velay, invites you to a sensory escape where the art of well-being combines with authentic luxury."
    ],
    "it": [
      "Il nostro impegno assoluto per l'arte del benessere.\r\nLa Spa Le Mont Anis, un'oasi di raffinatezza nel cuore della città di Le Puy-en-Velay, vi invita a una fuga sensoriale in cui l'arte del benessere si combina con il lusso autentico."
    ],
    "fr": [
      "Notre engagement absolu envers l'art du bien-être.\r\nLe Spa Le Mont Anis, véritable havre de raffinement niché au cœur de la cité du Puy-en-Velay, vous invite à une évasion sensorielle où l’art du bien-être s’allie au luxe authentique."
    ],
    "nl": [
      "Onze absolute toewijding aan de kunst van het welzijn.\r\nSpa Le Mont Anis, een oase van verfijning in het hart van de stad Le Puy-en-Velay, nodigt u uit voor een zintuiglijke ontsnapping waar de kunst van het welzijn wordt gecombineerd met authentieke luxe."
    ],
    "es": [
      "Nuestro compromiso absoluto con el arte del bienestar.\r\nEl Spa Le Mont Anis, un remanso de refinamiento enclavado en el corazón de la ciudad de Le Puy-en-Velay, le invita a una escapada sensorial donde el arte del bienestar se combina con el auténtico lujo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Spa Le Mont Anis"
    ]
  },
