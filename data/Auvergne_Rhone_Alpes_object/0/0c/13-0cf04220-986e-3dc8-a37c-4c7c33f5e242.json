  "rdfs:comment": {
    "de": [
      "Als leidenschaftliche Anhängerin des Kulturerbes der Auvergne werde ich Ihnen mittelalterliche Dörfer zeigen und mit Ihnen die kleinen Geschichten und Anekdoten teilen, die die Besichtigungen würzen."
    ],
    "en": [
      "Passionate about Auvergne's heritage, I'll help you discover medieval villages and share with you the stories and anecdotes that spice up your visits."
    ],
    "it": [
      "Appassionata del patrimonio dell'Alvernia, vi porterò in giro per i villaggi medievali e condividerò con voi le piccole storie e gli aneddoti che arricchiscono le visite."
    ],
    "fr": [
      "Passionnée par le patrimoine auvergnat, je vous ferai découvrir des villages médiévaux et partagerai avec vous les petites histoires et anecdotes qui pimentent les visites."
    ],
    "nl": [
      "Gepassioneerd door het erfgoed van de Auvergne, neem ik je mee op een tocht door de middeleeuwse dorpen en deel ik met jou de kleine verhalen en anekdotes die de bezoeken opleuken."
    ],
    "es": [
      "Apasionada del patrimonio de Auvernia, le llevaré a recorrer pueblos medievales y compartiré con usted las pequeñas historias y anécdotas que aderezan las visitas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Agnès Bertet - Guide conférencière"
    ]
  },
