  "rdfs:comment": {
    "de": [
      "Seit 1955 hat eine asiatische Gemeinde die Bergleute von Noyant ersetzt und eine Pagode und Statuen (1983) errichtet, um die Verehrung Buddhas zu zelebrieren. Kostenlose Besichtigung auf eigene Faust oder mit Führung."
    ],
    "en": [
      "Since 1955, an Asian community has replaced the miners of Noyant and has built a pagoda and statues (in 1983) to celebrate the cult of Buddha. Free visit or guided tour."
    ],
    "it": [
      "Dal 1955, una comunità asiatica ha sostituito i minatori di Noyant e ha costruito una pagoda e delle statue (nel 1983) per celebrare il culto di Buddha. Visita guidata o autoguidata gratuita."
    ],
    "fr": [
      "Depuis 1955, une communauté asiatique a remplacé les mineurs de Noyant et a édifié une pagode et des statues (en 1983) pour célébrer le culte de Bouddha. Visite gratuite libre ou guidée."
    ],
    "nl": [
      "Sinds 1955 heeft een Aziatische gemeenschap de mijnwerkers van Noyant vervangen en een pagode en beelden gebouwd (in 1983) om de cultus van Boeddha te vieren. Gratis rondleiding met of zonder gids."
    ],
    "es": [
      "Desde 1955, una comunidad asiática ha sustituido a los mineros de Noyant y ha construido una pagoda y estatuas (en 1983) para celebrar el culto a Buda. Visita guiada o autoguiada gratuita."
    ]
  },
  "rdfs:label": {
