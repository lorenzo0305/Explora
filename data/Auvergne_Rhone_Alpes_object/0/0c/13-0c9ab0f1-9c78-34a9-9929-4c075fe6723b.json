  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen eine Auswahl von über 6000 Medien, die Ihnen zur Verfügung stehen: Bücher, Zeitschriften, DVDs. Mit dieser großen Auswahl werden Sie das Buch finden, das Sie auf eine Reise mitnehmen wird."
    ],
    "en": [
      "The library offers you a choice of over 6,000 items, including books, magazines and DVDs. With this wide range, you're sure to find the book that will take you on a journey."
    ],
    "it": [
      "La biblioteca dispone di oltre 6.000 articoli tra cui scegliere, tra cui libri, riviste e DVD. Grazie a questa vasta gamma, sarete in grado di trovare il libro che vi porterà via per un po'."
    ],
    "fr": [
      "La bibliothèque vous propose un choix de plus de 6000 documents qui sont à votre disposition : livres, magazines, DVD. Avec ce large éventail, vous dénicherez le livre qui vous fera voyager le temps d'une lecture."
    ],
    "es": [
      "La biblioteca cuenta con más de 6.000 artículos para elegir, entre libros, revistas y DVD. Con esta amplia gama, podrás encontrar el libro que te lleve lejos durante un rato."
    ],
    "nl": [
      "De bibliotheek heeft meer dan 6000 items om uit te kiezen, waaronder boeken, tijdschriften en dvd's. Met dit ruime aanbod vind je vast het boek dat je even meeneemt."
    ]
  },
