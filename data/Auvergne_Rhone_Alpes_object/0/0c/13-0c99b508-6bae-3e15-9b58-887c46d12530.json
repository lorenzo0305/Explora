  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Dorf Usson en Forez mit einer lustigen Orientierungskarte. 1 Karte, 2 Wege von 2 und 3 km. 30 Orientierungspunkte auf der Strecke mit Hilfe einer Liste von ungewöhnlichen Fotos zu finden und wiederzuerkenne"
    ],
    "en": [
      "Discover Usson-en-Forez with a orienteering around the body of water and the village.\r\nDiscover Usson en Forez thanks to a compass and a map. Observe monuments and landscape and play with photos."
    ],
    "it": [
      "Venite a Usson-en-Forez per praticare e scoprire l'orienteering intorno al lago e in città. 4 percorsi per 4 livelli di difficoltà, 56 marcatori e 7 punti da trovare e individuare lungo i sentieri e nel bosco."
    ],
    "fr": [
      "Venez à Usson-en-Forez pratiquer et découvrir la course d'orientation autour du plan d'eau et dans le bourg. 4 parcours pour 4 niveaux de difficulté, 56 balises et 7 lieux à trouver et à repérer aux bords des chemins et en forêts."
    ],
    "es": [
      "Venga a Usson-en-Forez para practicar y descubrir la orientación alrededor del lago y en la ciudad. 4 recorridos para 4 niveles de dificultad, 56 balizas y 7 lugares para encontrar y localizar a lo largo de los senderos y en el bosque."
    ],
    "nl": [
      "Kom naar Usson-en-Forez om te oefenen en kennis te maken met oriëntatielopen rond het meer en in de stad. 4 parcoursen voor 4 moeilijkheidsgraden, 56 markeringen en 7 plekken om te vinden en te spotten langs de paden en in het bos."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungsläufe"
    ],
    "en": [
      "Orienteering track"
    ],
    "fr": [
      "Parcours permanent de course d'orientation - Espace Sport d'Orientation"
    ]
  },
