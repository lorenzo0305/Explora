  "rdfs:comment": {
    "de": [
      "Das Enduro Electric ist der Kategorie E-Bike vorbehalten und verspricht ein Gipfeltreffen auf 5 Sonderprüfungen, die auf den besten Spots der Skigebiete von Samoëns und Morillon ausgetragen werden."
    ],
    "en": [
      "Reserved for the e-bike category, the Enduro Electric promises a race to the top over a format of 5 special stages on the best spots in the Samoëns and Morillon resorts."
    ],
    "it": [
      "Riservato alla categoria delle e-bike, l'Enduro Electric promette una gara al vertice su un formato di 5 prove speciali, allestite nei migliori luoghi delle località di Samoëns e Morillon."
    ],
    "fr": [
      "Réservé à la catégorie e-bike, l’Enduro Electric promet une épreuve au sommet sur un format de 5 spéciales tracés sur les meilleurs spots des stations de Samoëns et Morillon."
    ],
    "es": [
      "Reservado a la categoría e-bike, el Enduro Electric promete una carrera hasta la cima en un formato de 5 etapas especiales trazadas en los mejores lugares de las estaciones de Samoëns y Morillon."
    ],
    "nl": [
      "De Enduro Electric, gereserveerd voor de categorie e-bikes, belooft een race naar de top over een format van 5 speciale etappes op de beste plekken in de resorts van Samoëns en Morillon."
    ]
  },
  "rdfs:label": {
    "en": [
