  "rdfs:comment": {
    "de": [
      "Das Restaurant La Réserve liegt inmitten eines wunderschönen Schilfgürtels und bietet Ihnen eine traditionelle und großzügige Küche mit Tischservice in einem typischen Dombistarahmen."
    ],
    "en": [
      "Nestling in the heart of a magnificent reed bed, La Réserve restaurant offers generous, traditional cuisine with table service, in a typically Dombist setting."
    ],
    "it": [
      "Immerso nel cuore di un magnifico canneto, il ristorante La Réserve propone un'abbondante cucina tradizionale con servizio al tavolo, in un ambiente tipicamente dombista."
    ],
    "fr": [
      "Niché au cœur d’une magnifique roselière, le restaurant La Réserve vous propose une cuisine traditionnelle et généreuse avec service à table, dans un cadre typiquement dombiste."
    ],
    "es": [
      "Ubicado en el corazón de un magnífico cañaveral, el restaurante La Réserve ofrece una cocina tradicional y generosa con servicio de mesa, en un entorno típico dombista."
    ],
    "nl": [
      "Het restaurant La Réserve, gelegen in het hart van een prachtig rietveld, biedt een traditionele en royale keuken met bediening aan tafel, in een typisch Dombistisch kader."
    ]
  },
  "rdfs:label": {
