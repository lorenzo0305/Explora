  "rdfs:comment": {
    "de": [
      "Étoile-sur-Rhône, eine charmante Gemeinde mit reichem Kulturerbe, bietet Ihnen einen privilegierten Lebensrahmen im Herzen der Drôme. Als dynamische Stadt verpflichten wir uns, unseren Einwohnern qualitativ hochwertige Dienstleistungen anzubieten."
    ],
    "en": [
      "Étoile-sur-Rhône, a charming town with a rich heritage, offers you a privileged living environment right in the heart of the Drôme. As a dynamic town, we are committed to offering quality services to our residents."
    ],
    "it": [
      "Étoile-sur-Rhône, città affascinante con un ricco patrimonio, offre un ambiente di vita privilegiato nel cuore della Drôme. In quanto città dinamica, ci impegniamo a offrire servizi di qualità ai nostri residenti."
    ],
    "fr": [
      "Étoile-sur-Rhône, charmante commune au patrimoine riche, vous propose un cadre de vie privilégié, en plein cœur de la Drôme. En tant que ville dynamique, nous nous engageons à offrir des services de qualité à nos habitants."
    ],
    "nl": [
      "Étoile-sur-Rhône, een charmante stad met een rijk erfgoed, biedt u een bevoorrechte leefomgeving in het hart van de Drôme. Als dynamische stad zetten we ons in om onze inwoners kwaliteitsdiensten aan te bieden."
    ],
    "es": [
      "Étoile-sur-Rhône, ciudad encantadora con un rico patrimonio, ofrece un entorno de vida privilegiado en el corazón de la Drôme. Como ciudad dinámica, nos comprometemos a ofrecer servicios de calidad a nuestros residentes."
    ]
  },
  "rdfs:label": {
