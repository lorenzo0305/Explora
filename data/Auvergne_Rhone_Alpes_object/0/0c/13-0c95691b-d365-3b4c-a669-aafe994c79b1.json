  "rdfs:comment": {
    "de": [
      "Wir züchten Schafe und ernten Kastanien (AOP Châtaigne d'Ardèche - biologische Landwirtschaft).\r\nDirektverkauf ab Hof nach Vereinbarung: Terrinen aus Schafsfleisch, ganze Kastanien, Kastanienmarmelade, Kastanienmehl..."
    ],
    "en": [
      "We rear ewes and harvest chestnuts (\"Châtaigne d'Ardèche\" PDO - organic farming). \r\nDirect sale at the farm by appointment : terrines made from ewe meat, whole chestnuts, chestnut jams, chestnut flour..."
    ],
    "it": [
      "Alleviamo pecore e raccogliamo castagne (DOP Châtaigne d'Ardèche - agricoltura biologica).\r\nVendita diretta in azienda su appuntamento: terrine di carne di pecora, castagne intere, marmellata di castagne, farina di castagne, ecc."
    ],
    "fr": [
      "Nous élevons des brebis et récoltons des châtaignes (AOP Châtaigne d'Ardèche - agriculture biologique). \r\nVente directe à la ferme sur rendez-vous : terrines à base de viande de brebis, châtaignes entières, confitures de châtaigne, farine de châtaigne..."
    ],
    "nl": [
      "We fokken ooien en oogsten kastanjes (BOB Châtaigne d'Ardèche - biologische landbouw).\r\nDirecte boerderijverkoop op afspraak: terrines van schapenvlees, hele kastanjes, kastanjejam, kastanjemeel, enz."
    ],
    "es": [
      "Criamos ovejas y cosechamos castañas (DOP Châtaigne d'Ardèche - agricultura ecológica).\r\nVenta directa en la granja con cita previa: terrinas de carne de oveja, castañas enteras, mermelada de castañas, harina de castañas, etc."
    ]
  },
