  "rdfs:comment": {
    "de": [
      "Die Domaine les Genêts in Ponet ist eine kleine Privatkellerei im Diois-Tal. Sie arbeitet im Einklang mit der Natur und produziert BIO-Clairette de Die sowie trockene Weißweine."
    ],
    "en": [
      "Small individual winery in the Diois Valley, the Domaine des Genêts in Ponet works  according to the nature and produces an organic Clairette de Die."
    ],
    "it": [
      "Piccola cantina privata biologica nella valle del Diois, il Domaine les Genêts di Ponet-et-saint-Auban lavora in armonia con la natura, producendo Clairette de Die, vini bianchi secchi e uno spumante analcolico."
    ],
    "fr": [
      "Petite cave particulière en Agriculture Biologique dans la vallée du Diois, le Domaine les Genêts à Ponet-et-saint-Auban travaille en accord avec la nature et produit de la Clairette de Die, des vins blancs secs ainsi qu'un pétillant sans alcool."
    ],
    "nl": [
      "Kleine wijnkelder in de Diois-vallei, het Domaine les Genets in Ponet werkt op milieuvriendelijke wijze en produceert biologische Clairette de Die."
    ],
    "es": [
      "El Domaine les Genêts de Ponet-et-saint-Auban, una pequeña bodega ecológica privada del valle del Diois, trabaja en armonía con la naturaleza y produce Clairette de Die, vinos blancos secos y un espumoso sin alcohol."
    ]
  },
  "rdfs:label": {
