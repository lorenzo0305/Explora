  "rdfs:comment": {
    "de": [
      "traditionelle Gastronomie (plus Fastfood und Take-away für die Skisaison); uns liegt es am Herzen, Ihnen Gerichte mit frischen und lokalen Produkten anzubieten."
    ],
    "en": [
      "traditional catering (plus fast food and takeaway during the ski season), we are committed to offering you dishes made with fresh and local products."
    ],
    "it": [
      "oltre alla ristorazione tradizionale (oltre a fast food e take-away durante la stagione sciistica), ci impegniamo a offrirvi piatti realizzati con prodotti freschi e locali."
    ],
    "fr": [
      "restauration traditionnelle (plus de la restauration rapide et à emporter pour la saison de ski), nous avons à cœur de vous proposer des plats avec des produits frais et locaux."
    ],
    "nl": [
      "naast de traditionele catering (plus fastfood en take-away tijdens het skiseizoen), zetten wij ons in om u gerechten aan te bieden die gemaakt zijn met verse, lokale producten."
    ],
    "es": [
      "además de la restauración tradicional (más comida rápida y para llevar durante la temporada de esquí), nos comprometemos a ofrecerle platos elaborados con productos frescos y locales."
    ]
  },
