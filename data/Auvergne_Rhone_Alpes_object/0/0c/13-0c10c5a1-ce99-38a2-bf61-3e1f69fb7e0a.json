  "rdfs:comment": {
    "de": [
      "Mit der Erde kreativ werden, sich von der Natur inspirieren lassen und dabei den Körper nicht vergessen! Keramik- und Kreativwerkstatt, die ein Ort der Weitergabe, der gemeinsamen Momente und des Auftankens sein soll, mit Veranstaltungen, die das ganze Jahr über angeboten werden."
    ],
    "en": [
      "Create with the earth, inspired by nature, and without forgetting your body! Ceramic and creativity workshop which strives to be a place of transmission, sharing and rejuvenation, with activities on offer throughout the year."
    ],
    "it": [
      "Creare con l'argilla, ispirandosi alla natura, senza dimenticare il proprio corpo! Laboratorio di ceramica e creatività che vuole essere un luogo di trasmissione, condivisione e rigenerazione, con attività proposte durante tutto l'anno."
    ],
    "fr": [
      "Créer avec la terre en s'inspirant de la nature, et sans oublier son corps! Atelier de céramique et de créativité qui se veut un lieu de transmission, de partage et de ressourcement, avec des animations proposées tout au long de l'année."
    ],
    "es": [
      "Crea con arcilla, inspirándote en la naturaleza, ¡sin olvidar tu cuerpo! Taller de cerámica y creatividad que pretende ser un lugar de transmisión, intercambio y rejuvenecimiento, con actividades ofrecidas durante todo el año."
    ],
    "nl": [
      "Creëer met klei, geïnspireerd door de natuur, zonder je lichaam te vergeten! Keramiek- en creativiteitsatelier dat een plaats van overdracht, delen en verjonging wil zijn, met activiteiten die het hele jaar door worden aangeboden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Workshop \"Terre en Vercors\""
    ],
    "en": [
      "Earth Workshop in Vercors"
    ],
    "fr": [
      "Atelier Terre en Vercors"
    ]
  },
