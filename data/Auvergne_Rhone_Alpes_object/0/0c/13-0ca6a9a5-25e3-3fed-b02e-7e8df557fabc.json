  "rdfs:comment": {
    "de": [
      "Hydrospeed in der Schlucht der Bonne: Die Strecke erstreckt sich über 3 km im Wildwasser der Klasse 3+ von der Pont du prêtre bis zur Mühle von Malbuisson, wo sich unsere Basis befindet.\r\nAQUA PLOUF: Familienfreundliche Alternative, um sich mit La Bonne Aventure zu erfrischen."
    ],
    "en": [
      "Hydrospeed in the Bonne gorge: the course extends over 3 km in class 3+ white water from the Priest bridge to the Malbuisson mill where our base is located.\r\nAQUA PLOUF: a family alternative to cool off with La Bonne Aventure."
    ],
    "it": [
      "Hydrospeed nelle Gorge de la Bonne: un tratto di 3 km di acque bianche di classe 3+ da Pont du Prêtre al Moulin de Malbuisson, dove si trova la nostra base.\r\nAQUA PLOUF: un'alternativa rinfrescante per le famiglie con La Bonne Aventure."
    ],
    "fr": [
      "Hydrospeed dans la gorge de la Bonne : le parcours est étendu sur 3 km en eau vive de classe 3+ du pont du prêtre jusqu'au moulin de Malbuisson là où se situe notre base. \r\nAQUA PLOUF : alternative familiale pour vous rafraichir avec La Bonne Aventure."
    ],
    "nl": [
      "Hydrospeed in de Gorge de la Bonne: een 3 km lang stuk wildwater van klasse 3+ van Pont du Prêtre tot de Moulin de Malbuisson, waar onze basis ligt.\r\nAQUA PLOUF: een verfrissend gezinsalternatief met La Bonne Aventure."
    ],
    "es": [
      "Hydrospeed en la Garganta de la Bonne: un tramo de 3 km de aguas bravas de clase 3+ desde Pont du Prêtre hasta el Moulin de Malbuisson, donde se encuentra nuestra base.\r\nAQUA PLOUF: una refrescante alternativa familiar con La Bonne Aventure."
    ]
  },
