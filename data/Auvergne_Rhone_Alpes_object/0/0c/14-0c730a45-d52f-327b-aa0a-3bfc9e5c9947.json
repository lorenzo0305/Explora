  "rdfs:comment": {
    "de": [
      "Genießen Sie in Zusammenarbeit mit dem Pays d'art et d'histoire de Lens-Liévin ein außergewöhnliches und geselliges Erlebnis rund um die Ausstellung La mine et le crayon: eine Führung durch die Ausstellung und ein Aperitif-Konzert."
    ],
    "en": [
      "In partnership with the Pays d'art et d'histoire de Lens-Liévin, enjoy an exceptional and convivial experience around the exhibition La mine et le crayon: guided tour of the exhibition and aperitif-concert."
    ],
    "it": [
      "In collaborazione con il Pays d'art et d'histoire de Lens-Liévin, vivete un'esperienza eccezionale e conviviale intorno alla mostra La mine et le crayon: visita guidata alla mostra e aperitivo-concerto."
    ],
    "fr": [
      "En partenariat avec le Pays d'art et d'histoire de Lens-Liévin, profitez d’une expérience exceptionnelle et conviviale autour de l’exposition La mine et le crayon : visite guidée de l’exposition et apéritif-concert."
    ],
    "nl": [
      "Geniet in samenwerking met het Pays d'art et d'histoire de Lens-Liévin van een uitzonderlijke en gezellige ervaring rond de tentoonstelling La mine et le crayon: rondleiding door de tentoonstelling en aperitief-concert."
    ],
    "es": [
      "En colaboración con el Pays d'art et d'histoire de Lens-Liévin, disfrute de una experiencia excepcional y distendida en torno a la exposición La mine et le crayon: visita guiada a la exposición y aperitivo-concierto."
    ]
  },
