  "rdfs:comment": {
    "de": [
      "Laëtitia Bastien ist auf die Schaffung und Restaurierung von Mosaiken und Glasmalereien (klassisch, zeitgenössisch) für Privatpersonen, religiöse Gebäude, denkmalgeschützte Gebäude und Körperschaften spezialisiert. Das Atelier ist offen für Ausbildungen"
    ],
    "en": [
      "Laëtitia Bastien specializes in the creation and restoration of mosaics and stained glass (classical and contemporary) for individuals, religious buildings, listed monuments and local authorities. The workshop is open for training"
    ],
    "it": [
      "Laëtitia Bastien è specializzata nella creazione e nel restauro di mosaici e vetrate (classiche e contemporanee) per privati, edifici religiosi, monumenti tutelati e autorità locali. Il laboratorio è aperto per la formazione"
    ],
    "fr": [
      "Laëtitia Bastien est spécialisée dans la création et la restauration de mosaïques et de vitraux (classiques, contemporains)  pour le particuliers, édifices religieux, monuments classés et collectivités. L'atelier est ouvert à la formation"
    ],
    "nl": [
      "Laëtitia Bastien is gespecialiseerd in de creatie en restauratie van mozaïeken en glas-in-lood (klassiek en hedendaags) voor particulieren, religieuze gebouwen, beschermde monumenten en lokale overheden. Het atelier is open voor opleidingen"
    ],
    "es": [
      "Laëtitia Bastien está especializada en la creación y restauración de mosaicos y vidrieras (clásicas y contemporáneas) para particulares, edificios religiosos, monumentos catalogados y autoridades locales. El taller está abierto a la formación"
    ]
  },
