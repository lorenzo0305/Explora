  "rdfs:comment": {
    "de": [
      "Als erste Eröffnung in der Region wurde 1991 die überdachte Boulodrome Pétrus- Chapiron (stellvertretender Bürgermeister, nationaler Boule-Schiedsrichter und Gründer der Boule-Schule von Fidésienne) eröffnet."
    ],
    "en": [
      "The first to open in the region, the Pétrus-Chapiron covered boulodrome (deputy mayor, national boules referee and founder of the fidésienne bouliste school) opened in 1991."
    ],
    "it": [
      "Pétrus Chapiron (vicesindaco, arbitro nazionale di bocce e fondatore della scuola bouliste fidésienne) è stato il primo boulodromo coperto ad aprire nella regione, nel 1991."
    ],
    "fr": [
      "Premier à ouvrir dans la région, le boulodrome couvert Pétrus- Chapiron (adjoint au maire, arbitre national de boules et créateur de l’école bouliste fidésienne) a ouvert en 1991."
    ],
    "es": [
      "Pétrus Chapiron (teniente de alcalde, árbitro nacional de petanca y fundador de la escuela fidésienne bouliste) fue el primer boulodrome cubierto que abrió sus puertas en la región, en 1991."
    ],
    "nl": [
      "Pétrus Chapiron (loco-burgemeester, nationaal jeu de boules scheidsrechter en oprichter van de fidésienne bouliste school) was de eerste overdekte boulodroom die in de regio werd geopend, in 1991."
    ]
  },
  "rdfs:label": {
