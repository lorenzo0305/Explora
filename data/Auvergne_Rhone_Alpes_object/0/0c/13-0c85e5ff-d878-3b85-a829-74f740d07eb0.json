  "rdfs:comment": {
    "de": [
      "La Grappe ist eine Weinkellerei, die sich auf biologisch angebaute, biodynamische und naturbelassene Weine spezialisiert hat und fast 200 Referenzen (Weine, Biere, Spirituosen) anbietet.\r\nReservieren Sie Ihren Verkostungsabend (siehe Programm, ca. 2 Abende pro Monat)."
    ],
    "en": [
      "La Grappe is a cellar specializing in organic, biodynamic and natural wines, with nearly 200 references (wines, beers, spirits).\r\nBook your tasting evening (see program, about 2 evenings a month)."
    ],
    "it": [
      "La Grappe è una cantina specializzata in vini biologici, biodinamici e naturali, con una gamma di quasi 200 vini, birre e liquori.\r\nPrenotate la vostra serata di degustazione (vedi programma, circa 2 sere al mese)."
    ],
    "fr": [
      "La Grappe est une cave spécialisée dans les vins bio, cultivés en biodynamie et nature et propose près de 200 références (vins, bières, spiritueux).\r\nRéserver votre soirée dégustation (voir programme, environ 2 soirées par mois)."
    ],
    "nl": [
      "La Grappe is een wijnkelder gespecialiseerd in biologische, biodynamische en natuurlijke wijnen, met een assortiment van bijna 200 wijnen, bieren en sterke dranken.\r\nReserveer je proefavond (zie programma, ongeveer 2 avonden per maand)."
    ],
    "es": [
      "La Grappe es una bodega especializada en vinos ecológicos, biodinámicos y naturales, con una gama de casi 200 vinos, cervezas y licores.\r\nReserve su velada de degustación (consulte el programa, unas 2 veladas al mes)."
    ]
  },
  "rdfs:label": {
