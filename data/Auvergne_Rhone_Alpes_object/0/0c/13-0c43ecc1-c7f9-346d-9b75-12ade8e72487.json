  "rdfs:comment": {
    "de": [
      "Die Genossenschaftler von Trelins heißen Sie in ihrem neuen Laden Vilavigne willkommen, um die Weine zu entdecken, die hier mit Trauben aus unseren Parzellen der Côtes du Forez hergestellt werden."
    ],
    "en": [
      "Since 1962, our collaborating wine growers produce with passion wines with character in the heart of the Forez."
    ],
    "it": [
      "I cooperatori di Trelins vi danno il benvenuto nel loro nuovo negozio di Vilavigne per scoprire i vini prodotti qui, con uve provenienti dalle nostre parcelle della Côtes du Forez."
    ],
    "fr": [
      "Les coopérateurs de Trelins vous accueillent dans leur nouveau magasin Vilavigne pour découvrir les vins produits ici, avec des raisins provenant de nos parcelles de Côtes du Forez."
    ],
    "es": [
      "Los cooperativistas de Trelins le dan la bienvenida a su nueva tienda de Vilavigne para que descubra los vinos que aquí se producen, con uvas procedentes de nuestras parcelas de Côtes du Forez."
    ],
    "nl": [
      "De medewerkers van Trelins heten je welkom in hun nieuwe winkel in Vilavigne om de wijnen te ontdekken die hier gemaakt worden, met druiven van onze Côtes du Forez percelen."
    ]
  },
