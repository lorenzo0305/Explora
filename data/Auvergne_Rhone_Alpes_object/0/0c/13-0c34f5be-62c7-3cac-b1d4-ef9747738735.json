  "rdfs:comment": {
    "de": [
      "Das Haus von Jean-Baptiste Bernard oder Maison Champollion, einem königlichen Notar, ist ein großer Komplex, der in der Nähe des östlichen Ausgangs des Dorfes errichtet wurde. Ein Wohnhaus und wichtige Nebengebäude von besonders gepflegter Bauweise..."
    ],
    "en": [
      "Jean-Baptiste Bernard's house or Champollion house, royal notary, is a big structure, built next to the exit of the village."
    ],
    "it": [
      "La casa di Jean-Baptiste Bernard o Maison Champollion, notaio reale, è un grande complesso costruito vicino all'estremità orientale del villaggio. Un'abitazione e grandi annessi di particolare pregio artigianale..."
    ],
    "fr": [
      "La maison de Jean-Baptiste Bernard ou Maison Champollion, notaire royal, se présente comme un gros ensemble, construit à proximité de la sortie est du bourg. Un logis et d'importantes dépendances d'une facture particulièrement soignée..."
    ],
    "es": [
      "La casa de Jean-Baptiste Bernard o Maison Champollion, notario real, es un gran complejo construido cerca del extremo oriental del pueblo. Una vivienda y grandes dependencias de artesanía particularmente fina..."
    ],
    "nl": [
      "Het huis van Jean-Baptiste Bernard of Maison Champollion, een koninklijke notaris, is een groot complex gebouwd aan de oostkant van het dorp. Een woning en grote bijgebouwen van bijzonder fijn vakmanschap..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mr Bernard's house or Champollion House"
    ],
