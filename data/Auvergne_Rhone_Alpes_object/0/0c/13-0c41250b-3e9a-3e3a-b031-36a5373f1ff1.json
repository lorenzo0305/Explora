  "rdfs:comment": {
    "de": [
      "Werk- und Ausstellungsort Entdeckung von Ton. Dieulefit, Traditionsland Töpferin. Mehr als 200 ausgestellte(ausgesetzte) Stücke(Zimmer) illustrieren den Reichtum der Vergangenheit Töpfer seit der gallo-romanischen Epoche bis zum XXè Jahrhundert +"
    ],
    "en": [
      "Exhibition and workshop to discover clay. The village of Dieulefit has always been associated to pottery. More than 200 exhibits illustrate the wealth of the potter's history since the Gallo-Roman time until the 20th century + a retrospective of the past of the venue."
    ],
    "it": [
      "Mostra e laboratorio per scoprire l'argilla. Dieulefit, terra di tradizione ceramica. Più di 200 oggetti esposti illustrano la ricchezza del passato del vasaio, dall'epoca gallo-romana al XX secolo + retrospettiva della storia del luogo."
    ],
    "fr": [
      "Lieu d'exposition et d'atelier découverte de l'argile. Dieulefit, un pays de tradition potière. Plus de 200 pièces exposées illustrent la richesse du passé potier depuis l'époque gallo-romaine jusqu'aux XXè siècle + rétrospective de l'histoire du lieu."
    ],
    "nl": [
      "Expositieruimte en atelier voor kleiworkshops. Dieulefit, het land van de pottenbakkerstraditie. Meer dan 200 werken tonen het rijke verleden op het gebied van pottenbakkerij van de Gallo-Romeinse tijd tot de 20e eeuw + tentoonstelling over de geschiedenis van de locatie."
    ],
    "es": [
      "Exposición y taller para descubrir la arcilla. Dieulefit, tierra de tradición alfarera. Más de 200 exposiciones ilustran la riqueza del pasado alfarero desde la época galorromana hasta el siglo XX + retrospectiva de la historia del lugar."
    ]
  },
  "rdfs:label": {
    "fr": [
