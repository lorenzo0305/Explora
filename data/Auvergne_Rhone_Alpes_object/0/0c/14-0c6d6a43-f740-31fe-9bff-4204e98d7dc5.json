  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/370dbfd7-e583-3b94-a6dd-730bbd30a59d",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\nMontags von 14:00 bis 19:00 Uhr\nDienstag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 13:00 Uhr\n\nSonntag geschlossen\n \n Abholung:\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\nMonday, 2pm to 7pm\nTuesday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday, 9am to 1pm\n\nClosed on Sunday\n \n Pick-up :\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\nLunedì, dalle 14.00 alle 19.00\nDa martedì a venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 13.00\n\nChiuso la domenica\n \n Ritiro:\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nLe lundi de 14h à 19h\nDu mardi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 13h\n\nFermeture le dimanche\n \n Retrait :\nAux horaires d'ouverture de l'officine\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\nMaandag van 14u tot 19u\nDinsdag tot vrijdag, 9u tot 12u en 14u tot 19u\nZaterdag van 9 tot 13 uur\n\nZondag gesloten\n \n Afhalen:\nTijdens openingstijden van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\nLunes, de 14.00 a 19.00 h\nDe martes a viernes, de 9.00 a 12.00 h. y de 14.00 a 19.00 h\nSábado de 9h a 13h\n\nDomingos cerrado\n \n Recogida:\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
