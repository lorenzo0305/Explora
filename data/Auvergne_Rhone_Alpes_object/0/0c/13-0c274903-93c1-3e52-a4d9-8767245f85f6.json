  "rdfs:comment": {
    "de": [
      "Entdecken Sie die freundliche und herzliche Atmosphäre des Lokals und seine einfache und effiziente Speisekarte. Restaurant, Crêperie, Eisdiele, Snackbar vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Snack, bar, speed restaurant, eat-in or take away. Glacier. Caterer."
    ],
    "it": [
      "Venite a scoprire l'atmosfera calda e accogliente e il menu semplice ed efficace. Ristorante, crêperie, gelateria, snack bar in loco o da asporto."
    ],
    "fr": [
      "Venez découvrir l'ambiance conviviale et chaleureuse des lieux et  sa carte simple et efficace. Restaurant, crêperie, glacier, snack bar sur place ou à emporter."
    ],
    "es": [
      "Venga a descubrir un ambiente cálido y acogedor y una carta sencilla y eficaz. Restaurante, crepería, heladería, snack bar in situ o para llevar."
    ],
    "nl": [
      "Kom en ontdek de warme, vriendelijke sfeer en het eenvoudige, doeltreffende menu. Restaurant, crêperie, ijssalon, snackbar ter plaatse of om mee te nemen."
    ]
  },
