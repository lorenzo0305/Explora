  "rdfs:comment": {
    "de": [
      "Verkauf von nativem Bio-Walnussöl, Walnusskernen, karamellisierten Walnüssen, Rindfleischwürsten, tiefgefrorenen Hacksteaks, Merguez, Chipolatas, Godiveaux, Fleisch in Paketen."
    ],
    "en": [
      "Farm sales of organic virgin walnut oil, walnut kernels, caramelized walnuts, beef sausages, frozen minced steaks, merguez, chipolatas, meat in packages."
    ],
    "it": [
      "Vendita in azienda di olio di noce vergine biologico, mezze noci, noci caramellate, salsicce di manzo, bistecche macinate congelate, salsicce merguez, chipolatas, carne in pacchi."
    ],
    "fr": [
      "Vente à la ferme d'Huile de noix vierge bio, Cerneaux de Noix , Noix caramélisées, Saucissons de boeuf, Steaks hachés surgelés, merguez, chipolatas, godiveaux, viande en colis."
    ],
    "es": [
      "Venta en granja de aceite de nuez virgen ecológico, mitades de nuez, nueces caramelizadas, salchichas de ternera, filetes picados congelados, salchichas merguez, chipolatas, carne en paquetes."
    ],
    "nl": [
      "Boerderijverkoop van biologische walnootolie van eerste persing, walnoothelften, gekarameliseerde walnoten, runderworstjes, diepvriesgehakt, merguezworstjes, chipolata's, vlees in pakketten."
    ]
  },
