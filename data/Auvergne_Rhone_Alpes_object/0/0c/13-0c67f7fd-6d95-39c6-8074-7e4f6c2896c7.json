  "rdfs:comment": {
    "de": [
      "Jean-Baptiste André, ein Spezialist für Handstand, ist eine Referenz im zeitgenössischen Zirkus. Als erster Künstler, der mit dem Programm Villa Medici Hors Les Murs ausgezeichnet wurde, werden seine Aufführungen in ganz Frankreich und außerhalb unserer Grenzen gezeigt"
    ],
    "en": [
      "Jean-Baptiste André, a specialist in hand balancing, is a benchmark in contemporary circus. The first winner of the Villa Médicis Hors Les Murs program, his shows are presented throughout France and abroad"
    ],
    "it": [
      "Jean-Baptiste André, specialista dell'equilibrio delle mani, è un punto di riferimento del circo contemporaneo. Primo artista a ricevere il programma Villa Médicis Hors Les Murs, i suoi spettacoli sono rappresentati in tutta la Francia e all'estero"
    ],
    "fr": [
      "Jean-Baptiste André, spécialiste de l’équilibre sur les mains, est une référence dans le cirque contemporain. Premier artiste lauréat du programme Villa Médicis Hors Les Murs, ses spectacles sont présentés partout en France et hors de nos frontières"
    ],
    "nl": [
      "Jean-Baptiste André, specialist in handbalanceren, is een referentie in het hedendaagse circus. Hij is de eerste artiest die het Villa Médicis Hors Les Murs-programma heeft ontvangen en zijn shows worden overal in Frankrijk en daarbuiten opgevoerd"
    ],
    "es": [
      "Jean-Baptiste André, especialista en equilibrios de manos, es una referencia en el circo contemporáneo. Primer artista galardonado con el programa Villa Médicis Hors Les Murs, sus espectáculos se representan en toda Francia y en el extranjero"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Intérieur nuit • Association W"
    ]
  },
