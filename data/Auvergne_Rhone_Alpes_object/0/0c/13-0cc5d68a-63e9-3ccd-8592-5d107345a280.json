  "rdfs:comment": {
    "de": [
      "Hier finden Sie alle touristischen Informationen über die Combrailles sowie unseren Shopbereich."
    ],
    "en": [
      "Find all the tourist information on the Combrailles, as well as our store."
    ],
    "it": [
      "Nel cuore delle Combrailles, l'ufficio turistico di Saint-Gervais-d'Auvergne vi accoglie per farvi scoprire una destinazione naturale. Trovate tutte le informazioni turistiche sulle Combrailles e il nostro negozio."
    ],
    "fr": [
      "Au cœur des Combrailles, le bureau de tourisme de Saint-Gervais-d'Auvergne, vous accueille pour découvrir une destination nature. Retrouvez toutes les informations touristiques sur les Combrailles, ainsi que notre espace boutique."
    ],
    "nl": [
      "In het hart van de Combrailles heet het toeristenbureau van Saint-Gervais-d'Auvergne u welkom om een natuurlijke bestemming te ontdekken. Hier vindt u alle toeristische informatie over de Combrailles en onze winkel."
    ],
    "es": [
      "En el corazón de las Combrailles, la oficina de turismo de Saint-Gervais-d'Auvergne le da la bienvenida para que descubra un destino natural. Encuentre toda la información turística que necesite sobre las Combrailles, así como nuestra tienda."
    ]
  },
  "rdfs:label": {
