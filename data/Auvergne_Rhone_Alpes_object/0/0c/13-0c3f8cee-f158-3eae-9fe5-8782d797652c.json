  "rdfs:comment": {
    "de": [
      "Das Château de Villars bietet Ihnen die Möglichkeit, Ihre Seminare und Firmenveranstaltungen in einer landschaftlich reizvollen Umgebung zu organisieren, mit allen Dienstleistungen, die Sie benötigen."
    ],
    "en": [
      "The Château de Villars is the ideal venue for your seminars and corporate events, with all the services you need."
    ],
    "it": [
      "Lo Château de Villars vi offre l'opportunità di organizzare seminari ed eventi aziendali in una cornice mozzafiato, con tutti i servizi necessari."
    ],
    "fr": [
      "Le Château de Villars vous propose d’organiser vos séminaires et évènements d’entreprise dans un cadre dépaysant, avec tous les services dont vous aurez besoin."
    ],
    "es": [
      "El Château de Villars le ofrece la oportunidad de organizar sus seminarios y eventos corporativos en un marco impresionante, con todos los servicios que necesite."
    ],
    "nl": [
      "Château de Villars biedt u de mogelijkheid om uw seminars en bedrijfsevenementen te organiseren in een adembenemende omgeving, met alle diensten die u nodig heeft."
    ]
  },
