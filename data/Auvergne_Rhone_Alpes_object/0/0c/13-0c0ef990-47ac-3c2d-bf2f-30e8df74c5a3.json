  "rdfs:comment": {
    "de": [
      "Das Héritage bietet eine großzügige, ehrliche, lokale und saisonale Bergküche. Eine lukullische Hommage an die alpine Lebenskunst zwischen Tradition und Moderne, die Sie in einem warmen und eleganten Rahmen genießen können."
    ],
    "en": [
      "Héritage offers generous, authentic, local, and seasonal mountain cuisine. A gourmet tribute to the Alpine way of life, blending tradition and modernity, to be enjoyed in a warm and elegant setting."
    ],
    "it": [
      "Héritage offre una cucina di montagna generosa, autentica, locale e di stagione. Un omaggio gourmet allo stile di vita alpino, che unisce tradizione e modernità, da gustare in un ambiente caldo ed elegante."
    ],
    "fr": [
      "Héritage propose une cuisine de montagne généreuse, sincère, locale et de saison. Un hommage gourmand à l’art de vivre alpin, entre tradition et modernité, à savourer dans un cadre chaleureux et élégant."
    ],
    "es": [
      "Héritage ofrece una cocina de montaña generosa, sincera, local y de temporada. Un homenaje gastronómico al arte de vivir alpino, que combina tradición y modernidad, para saborear en un entorno cálido y elegante."
    ],
    "nl": [
      "Héritage biedt een gulle, eerlijke, lokale en seizoensgebonden bergkeuken. Een gastronomisch eerbetoon aan de levenskunst van de Alpen, een combinatie van traditie en moderniteit, om van te genieten in een warme, elegante omgeving."
    ]
  },
