  "rdfs:comment": {
    "de": [
      "55. Jahrestag des P?tit train de la Haute Somme\nund 110. Jahrestag der Strecke des P?tit train.\n\n? Fahrten mit dem Dampfzug.\n? Historische Dampflokomotiven als Gäste von anderen Eisenbahnen.\n? Fahrten mit historischen Güterzügen.\n? Große Ausstellung von Modelleisenbahnen.\n? Stände von Vereinen im Museum.\n? Frittenbude vor Ort.\n? Museum, Shop und Erfrischungsstand von 10:00 bis 19:00 Uhr geöffnet.\n\nDetails zu Öffnungszeiten und Ticketverkauf folgen."
    ],
    "en": [
      "55th anniversary of the P?tit train de la Haute Somme\nand 110th anniversary of the P?tit train line.\n\n? Steam train rides.\n? Historic steam locomotives invited from other railroads.\n? Historic freight trains.\n? Large-scale model railway exhibition.\n? Association stands in the museum.\n? French fry shop on site.\n? Museum, store and refreshment area open from 10am to 7pm.\n\nDetails of opening hours and ticketing to follow."
    ],
    "it": [
      "55° anniversario del treno del P?tit dell'Alta Somme\ne 110° anniversario della linea ferroviaria del P?tit.\n\n? Gite in treno a vapore.\n? Locomotive a vapore storiche invitate da altre ferrovie.\n? Treni merci storici.\n? Mostra di modellismo ferroviario in grande scala.\n? Stand associativi nel museo.\n? Negozio di patatine fritte in loco.\n? Museo, negozio e area di ristoro aperti dalle 10.00 alle 19.00.\n\nSeguiranno dettagli sugli orari di apertura e sulla vendita dei biglietti."
    ],
    "fr": [
      "55e anniversaire du P’tit train de la Haute Somme\net 110e anniversaire de la ligne du P’tit train.\n\n– Balades en train à vapeur.\n– Locomotives à vapeur historiques invitées d’autres chemins de fer.\n– Circulations de trains de marchandises historiques.\n– Grande exposition de modélisme ferroviaire.\n– Stands associatifs dans le musée.\n– Friterie sur place.\n– Musée, boutique et buvette ouverts de 10h00 à 19h00.\n\nDétail des horaires et billetterie à venir."
    ],
    "nl": [
      "55e verjaardag van de Peertjestrein van de Haute Somme\nen 110e verjaardag van de P?tit treinlijn.\n\n? Stoomtreinritten.\n? Uitgenodigde historische stoomlocomotieven van andere spoorwegen.\n? Historische goederentreinen.\n? Modeltreintentoonstelling op grote schaal.\n? Verenigingsstands in het museum.\n? Frituur op het terrein.\n? Museum, winkel en verfrissingsruimte geopend van 10.00 tot 19.00 uur.\n\nDetails over openingstijden en kaartverkoop volgen."
    ],
    "es": [
      "55º aniversario del tren P?tit de la Haute Somme\ny 110 aniversario de la línea de tren P?tit.\n\n? Paseos en tren de vapor.\n? Locomotoras de vapor históricas invitadas de otros ferrocarriles.\n? Trenes de mercancías históricos.\n? Exposición de maquetas a gran escala.\n? Stands de asociaciones en el museo.\n? Tienda de patatas fritas in situ.\n? Museo, tienda y zona de restauración abiertos de 10.00 a 19.00 h.\n\nMás información sobre horarios y venta de entradas."
    ]
  },
