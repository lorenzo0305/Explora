  "rdfs:comment": {
    "de": [
      "Wir bieten gekochte Konservengerichte, Rillettes und Wurstwaren aus Rindfleisch der Salers-Rasse sowie Kaninchenterrinen an. Wir verkaufen auch direkt Salers-Fleisch, das wir nach Hause liefern."
    ],
    "en": [
      "We offer prepared canned dishes, rillettes and charcuterie made from Salers beef, as well as rabbit terrines. We also offer direct sales of Salers meat for home delivery."
    ],
    "it": [
      "Offriamo piatti pronti in scatola, rillettes e salumi a base di carne di Salers, oltre a terrine di coniglio. Vendiamo anche carne di Salers direttamente a casa vostra."
    ],
    "fr": [
      "Nous proposons des plats en conserves cuisinés, des rillettes et des charcuteries à base de viande de boeuf de race Salers, ainsi que des terrines de lapins. Nous faisons également de la vente directe de viande de Salers que nous livrons a domicile."
    ],
    "nl": [
      "We bieden kant-en-klare gerechten in blik, rillettes en vleeswaren gemaakt van Salers rundvlees, evenals konijnenterrines. We verkopen ook Salers vlees rechtstreeks aan huis."
    ],
    "es": [
      "Ofrecemos platos preparados en conserva, rillettes y embutidos de ternera de Salers, así como terrinas de conejo. También vendemos carne de Salers directamente a domicilio."
    ]
  },
  "rdfs:label": {
