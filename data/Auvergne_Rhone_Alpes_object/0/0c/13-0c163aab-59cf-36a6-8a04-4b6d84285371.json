  "rdfs:comment": {
    "de": [
      "In den Ausläufern des Jura und des Ain lädt Sie der Trail des Chamois dazu ein, Ihre Grenzen auf außergewöhnlichen Strecken im Herzen der Berge zu erweitern, die sich perfekt für Läufer und Läuferinnen eignen, die sich auf Ihre zukünftigen Wettkämpfe vorbereiten."
    ],
    "en": [
      "In the foothills of the Jura and Ain, the Trail des Chamois invites you to push back your limits on exceptional courses in the heart of the mountains, perfect for runners preparing for future events."
    ],
    "it": [
      "Ai piedi del Giura e dell'Ain, il Trail des Chamois invita a superare i propri limiti su percorsi eccezionali nel cuore delle montagne, perfetti per i corridori che si preparano agli eventi futuri."
    ],
    "fr": [
      "Dans les contreforts du Jura et de l’Ain, le Trail des Chamois vous invite à repousser vos limites sur des parcours d’exception, au cœur des montagnes, parfaits pour les coureurs et coureuses en préparation pour vos futures échéances."
    ],
    "nl": [
      "In de uitlopers van de Jura en de Ain nodigt de Trail des Chamois je uit om je grenzen te verleggen op uitzonderlijke parcours in het hart van de bergen, perfect voor lopers die zich voorbereiden op toekomstige evenementen."
    ],
    "es": [
      "En las estribaciones del Jura y del Ain, el Trail des Chamois le invita a superar sus límites en recorridos excepcionales en plena montaña, perfectos para los corredores que se preparan para futuras pruebas."
    ]
  },
  "rdfs:label": {
