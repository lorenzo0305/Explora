  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3ef42b08-bcbb-3575-b6f9-f3637e16d7d5",
      "dc:description": {
        "de": [
          "Kleiner, gepflegter Laden in einem authentischen und freundlichen Rahmen.<br> Felix, der 30 Jahre lang in der Spitzengastronomie tätig war, freut sich, Ihnen die strenge Auswahl zu zeigen, die er bei etwa 30 regionalen Lieferanten getroffen hat"
        ],
        "en": [
          "A small, well-kept boutique in an authentic and friendly setting.<br>Félix, with 30 years of experience in top-level catering, will be happy to show you the rigorous selection he has made from some thirty regional suppliers"
        ],
        "it": [
          "Felix, che ha trascorso 30 anni nel settore della ristorazione di alto livello, sarà lieto di mostrarvi la rigorosa selezione che ha effettuato tra una trentina di fornitori regionali"
        ],
        "fr": [
          "Petite boutique soignée dans un cadre authentique et convivial.<br>Félix, fort des 30 années passées en restauration de haut niveau se fera un plaisir de vous faire découvrir la sélection rigoureuse qu'il a effectué auprès d'une trentaine de fournisseurs régionaux"
        ],
        "nl": [
          "Felix, die 30 jaar in de horeca op hoog niveau heeft gewerkt, zal u met plezier de strenge selectie laten zien die hij heeft gemaakt uit een dertigtal regionale leveranciers"
        ],
        "es": [
          "Félix, que lleva 30 años en la restauración de alto nivel, estará encantado de mostrarle la rigurosa selección que ha realizado entre una treintena de proveedores regionales"
        ]
      },
      "@type": [
        "Description"
