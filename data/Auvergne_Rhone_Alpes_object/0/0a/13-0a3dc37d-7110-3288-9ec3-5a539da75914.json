  "rdfs:comment": {
    "de": [
      "UNES ist ein lokaler, feministischer und engagierter Verein, der von einem Team von Freiwilligen getragen wird, die an die Kraft des Kollektivs, der Volksbildung und der Kultur als Hebel für die soziale Transformation glauben."
    ],
    "en": [
      "UNES is a local, feminist, and committed association run by a team of volunteers who believe in the power of collective action, popular education, and culture as levers for social change."
    ],
    "it": [
      "UNES è un'associazione locale, femminista e impegnata, gestita da un team di volontari che crede nel potere dell'azione collettiva, dell'educazione popolare e della cultura come leve per il cambiamento sociale."
    ],
    "fr": [
      "UNES est une association locale, féministe et engagée, portée par une équipe de bénévoles qui croient à la force du collectif, de l’éducation populaire et de la culture comme leviers de transformation sociale."
    ],
    "nl": [
      "UNES is een lokale, feministische en toegewijde vereniging, geleid door een team van vrijwilligers die geloven in de kracht van collectieve actie, volksopvoeding en cultuur als hefbomen voor sociale verandering."
    ],
    "es": [
      "UNES es una asociación local, feminista y comprometida, dirigida por un equipo de voluntarios que creen en el poder de la acción colectiva, la educación popular y la cultura como palancas del cambio social."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival UNES"
    ]
  },
