  "rdfs:comment": {
    "de": [
      "Der Strand von Siauve liegt in der Mitte des Sees von Bort-les-Orgues und ist ruhig und friedlich."
    ],
    "en": [
      "Nestling in the hollow of the Bort-les-Orgues lake, the Siauve beach is calm and peaceful, with picnic tables and a children's play area."
    ],
    "it": [
      "Immersa nella conca del lago di Bort-les-Orgues, la spiaggia di Siauve è calma e tranquilla, con tavoli da picnic, un'area giochi per bambini e un ristorante."
    ],
    "fr": [
      "Logée au creux du lac de Bort-les-Orgues, la plage de la Siauve est calme et paisible, vous y trouverez des tables de pique-nique, une aire de jeux pour enfants, ainsi qu'un restaurant."
    ],
    "nl": [
      "Het strand van Siauve, genesteld in de holte van het meer van Bort-les-Orgues, is rustig en vredig, met picknicktafels, een speeltuin en een restaurant."
    ],
    "es": [
      "Enclavada en la hondonada del lago de Bort-les-Orgues, la playa de Siauve es tranquila y apacible, con mesas de picnic, zona de juegos infantiles y restaurante."
    ]
  },
  "rdfs:label": {
    "en": [
