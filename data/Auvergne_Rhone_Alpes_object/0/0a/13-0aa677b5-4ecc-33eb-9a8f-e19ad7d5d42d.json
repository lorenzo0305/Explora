  "rdfs:comment": {
    "de": [
      "Ars zieht jedes Jahr etwa 300.000 Pilger an, die in die Stadt kommen, um sich dort zu besinnen und den Fußstapfen Jean-Marie Vianney, des heiligen Pfarrers von Ars, zu folgen. Dank dieses reichen Erbes zählt Ars zu den Heiligtumsstädten Frankreichs."
    ],
    "en": [
      "Saint Jean-Marie Vianney the patron saint of priests was parish priest of Ars-sur-Formans from 1818 until 1859.  Today his shrine is located in the village and it welcomes nearly 500,000 pilgrims and tourists annually."
    ],
    "it": [
      "Ogni anno, centinaia di migliaia di pellegrini si recano ad Ars, un villaggio della regione di Dombes, per seguire le orme di Jean-Marie Vianney, il Curato d'Ars.\r\nForte di questo patrimonio, Ars è membro dell'associazione Villes Sanctuaires en France."
    ],
    "fr": [
      "Ars, village de la Dombes, reçoit chaque année des centaines de milliers de pèlerins qui viennent se recueillir, sur les pas de Jean-Marie Vianney, Saint Curé d'Ars.\r\nForte de cet héritage, Ars fait partie de l'association Villes Sanctuaires en France."
    ],
    "nl": [
      "Elk jaar komen honderdduizenden pelgrims naar Ars, een dorp in de regio Dombes, om in de voetsporen te treden van Jean-Marie Vianney, de Curé d'Ars.\r\nDankzij dit erfgoed is Ars lid van de vereniging Villes Sanctuaires en France."
    ],
    "es": [
      "Cada año, cientos de miles de peregrinos acuden a Ars, pueblo de la región de Dombes, para seguir los pasos de Jean-Marie Vianney, el Cura de Ars.\r\nGracias a este patrimonio, Ars es miembro de la asociación Villes Sanctuaires en France."
    ]
  },
  "rdfs:label": {
    "de": [
      "Ars, Dorf des Heiligen Pfarrers"
    ],
    "en": [
      "Town of Ars-sur-Formans, sanctuary town"
    ],
    "fr": [
      "Ars-sur-Formans, ville sanctuaire"
    ]
  },
