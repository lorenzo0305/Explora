  "rdfs:comment": {
    "de": [
      "Am Südufer des Genfer Sees übt die Familie FICHARD, Erntebesitzer auf dem Weingut Crépy, seit 1888 mit Leidenschaft und Know-how den Beruf des Weinbauern und Weinhändlers vom Vater auf den Sohn aus."
    ],
    "en": [
      "On the southern shore of Lake Geneva, the FICHARD family, owners harvesting in the Crépy vineyard, have been practising with passion and know-how the trade of producer-dealer from father to son since 1888."
    ],
    "it": [
      "Sulla sponda meridionale del Lago di Ginevra, la famiglia FICHARD, proprietaria del vigneto Crépy, esercita la professione di produttore/negoziatore di padre in figlio con passione e know-how dal 1888."
    ],
    "fr": [
      "Sur la rive sud du lac Léman, la famille FICHARD, propriétaire récoltant au vignoble de Crépy, exerce avec passion et savoir-faire le métier de producteur négociant de père en fils depuis 1888."
    ],
    "es": [
      "En la orilla sur del lago Lemán, la familia FICHARD, propietaria del viñedo Crépy, ejerce el oficio de productor/negociador de padre a hijo con pasión y saber hacer desde 1888."
    ],
    "nl": [
      "Aan de zuidoever van het meer van Genève oefent de familie FICHARD, eigenaars van de wijngaard van Crépy, sinds 1888 met passie en knowhow het beroep van producent/onderhandelaar uit van vader op zoon."
    ]
  },
