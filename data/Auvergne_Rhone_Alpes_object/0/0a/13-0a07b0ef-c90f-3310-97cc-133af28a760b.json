  "rdfs:comment": {
    "de": [
      "Der Grand Parc d'Andilly ist der achtgrößte Themenpark Frankreichs und wird Sie mit seinen vier Welten, die den Rhythmus des Jahres bestimmen, willkommen heißen."
    ],
    "en": [
      "France's 8th largest theme park, the Grand Parc d'Andilly welcomes you with its four universes that punctuate the year."
    ],
    "it": [
      "Il Grand Parc d'Andilly, l'ottavo parco a tema più grande di Francia, è in grado di soddisfare con i suoi quattro mondi che si susseguono nel corso dell'anno."
    ],
    "fr": [
      "8ème plus grand parc à thème de France, le Grand Parc d'Andilly saura vous accueillir avec ses quatre univers qui rythment l'année."
    ],
    "nl": [
      "het Grand Parc d'Andilly, het op acht na grootste themapark van Frankrijk, zal zeker in de smaak vallen met zijn vier werelden die het hele jaar door geopend zijn."
    ],
    "es": [
      "Octavo parque temático de Francia, el Grand Parc d'Andilly le seducirá con sus cuatro mundos que se suceden a lo largo del año."
    ]
  },
