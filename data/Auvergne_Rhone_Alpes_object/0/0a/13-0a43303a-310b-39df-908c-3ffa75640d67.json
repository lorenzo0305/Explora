  "rdfs:comment": {
    "de": [
      "Seit über 30 Jahren empfangen Sie Sylvie und Alain in einer ländlichen und erholsamen Umgebung. In der Sommersaison können Sie auf der Terrasse unter der Pergola eine Mahlzeit oder einen Snack zu sich nehmen."
    ],
    "en": [
      "For over 30 years, Sylvie and Alain have been welcoming you to their relaxing country setting. In summer, you can enjoy a meal or snack on the terrace under the pergola."
    ],
    "it": [
      "Da oltre 30 anni, Sylvie e Alain vi accolgono nel loro rilassante ambiente di campagna. In estate, potrete gustare un pasto o uno spuntino sulla terrazza sotto la pergola."
    ],
    "fr": [
      "Depuis plus de 30 ans , Sylvie et Alain, vous accueillent dans un cadre campagnard et reposant. En saison estivale, vous pourrez être servis en terrasse sous la pergola pour un repas ou une collation."
    ],
    "nl": [
      "Sylvie en Alain verwelkomen je al meer dan 30 jaar in hun ontspannende landelijke omgeving. In de zomer kun je genieten van een maaltijd of snack op het terras onder de pergola."
    ],
    "es": [
      "Desde hace más de 30 años, Sylvie y Alain le dan la bienvenida a su relajante entorno campestre. En verano, podrá disfrutar de una comida o un aperitivo en la terraza bajo la pérgola."
    ]
  },
  "rdfs:label": {
