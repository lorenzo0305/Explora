  "rdfs:comment": {
    "de": [
      "Vincent Gobet ist seit 2018 Imker und hat sich auf dem Plateau Casadéen niedergelassen. Er bietet Ihnen verschiedene Bienenprodukte an: Verkauf von Honig (Akazie, Bergblumen, Tanne, Linde, Frühling, ... ), Haselnusskonfit, Schwarm, Herstellung von Bienenstöcken..."
    ],
    "en": [
      "Beekeeper since 2018, installed on the Casadean plateau, Vincent Gobet offers various beekeeping products: sale of honey (acacia, mountain flowers, fir, lime, spring, ... ), hazelnut confit, swarm, hive making..."
    ],
    "it": [
      "Apicoltore dal 2018, con sede sull'altopiano di Casade, Vincent Gobet offre una gamma di prodotti apistici: vendita di miele (acacia, fiori di montagna, abete, tiglio, primavera, ecc.), conserve di nocciole, sciami, costruzione di alveari, ecc."
    ],
    "fr": [
      "Apiculteur depuis 2018, installé sur le plateau casadéen, Vincent Gobet vous propose divers produits apicoles : vente de miel (acacia, fleurs de montagne, sapin, tilleul, printemps, ... ), confit de noisettes, essaim, fabrication de ruches..."
    ],
    "nl": [
      "Vincent Gobet is imker sinds 2018 en is gevestigd op het plateau van Casade. Hij biedt een scala aan imkerijproducten: verkoop van honing (acacia, bergbloemen, spar, linde, lente, enz.), hazelnootconserven, zwermen, bouw van bijenkasten, enz."
    ],
    "es": [
      "Apicultor desde 2018, con sede en la meseta de Casade, Vincent Gobet ofrece una gama de productos apícolas: venta de miel (acacia, flores de montaña, abeto, tilo, primavera, etc.), conservas de avellana, enjambres, construcción de colmenas, etc."
    ]
  },
  "rdfs:label": {
