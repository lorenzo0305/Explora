  "rdfs:comment": {
    "de": [
      "Die Brasserie La Ringale est wurde Ende des Jahres 2018 von zwei Freunden in Hochsavoyen unweit von Thonon-Les-Bains gegründet. Herstellung/Verkauf von handwerklich gebrauten Bieren an Privat- und Geschäftskunden!"
    ],
    "en": [
      "La Ringale Brewery was created at the end of 2018 by two friends in Haute Savoie not far from Thonon-Les-Bains. Manufacturing/selling craft beers to individuals and professionals!"
    ],
    "it": [
      "Il birrificio La Ringale è stato creato alla fine del 2018 da due amici in Alta Savoia, non lontano da Thonon-Les-Bains. Produzione/vendita di birre artigianali a privati e professionisti!"
    ],
    "fr": [
      "La Brasserie La Ringale est a été créé en fin d'année 2018 par deux amis en Haute Savoie non loin de Thonon-Les-Bains. Fabrication/ventes bières artisanales aux particuliers et aux professionnels !"
    ],
    "es": [
      "La cervecería La Ringale fue creada a finales de 2018 por dos amigos en la Alta Saboya, no lejos de Thonon-Les-Bains. Fabricación y venta de cervezas artesanales a particulares y profesionales"
    ],
    "nl": [
      "Brouwerij La Ringale werd eind 2018 opgericht door twee vrienden in de Haute Savoie, niet ver van Thonon-Les-Bains. Productie/verkoop van ambachtelijke bieren aan particulieren en professionals!"
    ]
  },
