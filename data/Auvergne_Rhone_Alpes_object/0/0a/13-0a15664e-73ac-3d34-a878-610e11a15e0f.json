  "rdfs:comment": {
    "de": [
      "Weinbereitung und Verkauf von Côtes du Rhône Villages, CDR Bio, Grignan les Adhémar und IGP Drôme-Weinen in Flaschen und Bag-in-Box. Verkauf von Produkten aus der Region (Nougat, Öle, Oliven, Marmeladen, Gewürze)."
    ],
    "en": [
      "Vinification and sale of wines Côtes du Rhônes PDO, Côtes du Rhônes Villages Grignan les Adhémar and PGI in bottles or bag-in-box, sale of regional products (nougat, oils, olives, marmalades.)"
    ],
    "it": [
      "Vinificazione e vendita di vini Côtes du Rhône Villages, CDR Bio, Grignan les Adhémar e IGP Drôme in bottiglia e bag in box. Vendita di prodotti locali (torroni, oli, olive, marmellate, condimenti)."
    ],
    "fr": [
      "Vinification et vente de vins Côtes du Rhône Villages, CDR Bio, Grignan les Adhémar et IGP Drôme en bouteilles et bag in box. Vente de produits du terroir (nougats, huiles, olives, confitures, condiments)."
    ],
    "nl": [
      "Wijnbereiding en verkoop van wijnen AOP, CDR, CDR Villages Grignan les Adhémar en IGP Drôme in flessen of bag in box, verkoop van streekproducten (noga, olijfolie, jam, kruiden, etc.)."
    ],
    "es": [
      "Vinificación y venta de vinos Côtes du Rhône Villages, CDR Bio, Grignan les Adhémar e IGP Drôme en botella y bag in box. Venta de productos locales (turrones, aceites, aceitunas, mermeladas, condimentos)."
    ]
  },
