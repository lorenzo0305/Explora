  "rdfs:comment": {
    "de": [
      "Entdecken Sie die poetische und sensible grafische Welt von Camille. Auf dem Programm stehen: Ausstellung von Malerei - Risographie - Linolschnitt - Gestaltung und Realisierung von Wandmalereien. Workshops/Schnupperkurse zur Einführung in den Linolschnitt (auf Anmeldung)."
    ],
    "en": [
      "Come and discover Camille's poetic and sensitive graphic world in her studio-boutique. Exhibition of paintings, risographs, linocuts, and the creation and execution of murals. Linocut workshops (registration required)."
    ],
    "it": [
      "Venite a scoprire l'universo grafico poetico e sensibile di Camille. In programma: Mostra di pittura - Risografia - Linocut - Creazione e realizzazione di un affresco murale. Workshop di introduzione alla linoleografia (iscrizione obbligatoria)."
    ],
    "fr": [
      "Venez découvrir l'univers graphique poétique et sensible de Camille. Au programme : Exposition de Peinture - Risographie - Linogravure - Création et réalisation de fresque murale. Ateliers/stages d'initiation à la Linogravure (sur inscription)."
    ],
    "es": [
      "Venga a descubrir el universo gráfico poético y sensible de Camille. En el programa: Exposición de pintura - Risografía - Linograbado - Creación y realización de un fresco mural. Talleres de iniciación al linograbado (inscripción obligatoria)."
    ],
    "nl": [
      "Kom het poëtische en gevoelige grafische universum van Camille ontdekken. Op het programma: Schilderijententoonstelling - Risografie - Linosnede - Creatie en uitvoering van een muurschildering. Kennismakingsworkshops Linosnede (inschrijving verplicht)."
    ]
  },
