  "rdfs:comment": {
    "de": [
      "Im Rahmen ihrer Welttournee werden OneRepublic am 7. Juli 2026 für ein außergewöhnliches Konzert in der LDLC Arena in Lyon-Décines Halt machen."
    ],
    "en": [
      "As part of their world tour, OneRepublic will be stopping off at the LDLC Arena in Lyon-Décines for a special concert on July 7, 2026."
    ],
    "it": [
      "Nell'ambito del loro tour mondiale, gli OneRepublic faranno tappa all'Arena LDLC di Lione-Décines per un concerto speciale il 7 luglio 2026."
    ],
    "fr": [
      "Dans le cadre de leur tournée mondiale, OneRepublic fera escale à la LDLC Arena de Lyon-Décines pour un concert exceptionnel le 7 juillet 2026."
    ],
    "es": [
      "En el marco de su gira mundial, OneRepublic hará escala en el LDLC Arena de Lyon-Décines para un concierto especial el 7 de julio de 2026."
    ],
    "nl": [
      "Als onderdeel van hun wereldtournee doet OneRepublic de LDLC Arena in Lyon-Décines aan voor een speciaal concert op 7 juli 2026."
    ]
