  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Forum für Saisonjobs teil! Treffen Sie Personalvermittler, entdecken Sie verschiedene Angebote und finden Sie Ihren Job für die Saison. Eine ideale Gelegenheit, um schnell einen Job zu bekommen und sich in aller Ruhe auf den Sommer vorzubereiten."
    ],
    "en": [
      "Take part in the Seasonal Jobs Forum! Meet recruiters, discover a variety of job offers and find your job for the season. It's the ideal opportunity to land a job quickly and prepare for your summer with peace of mind."
    ],
    "it": [
      "Partecipate al Forum sulle offerte di lavoro stagionali! Incontrate i reclutatori, informatevi su un'ampia gamma di offerte di lavoro e trovate il vostro impiego per la stagione. È l'occasione perfetta per trovare rapidamente un lavoro e prepararsi all'estate in tutta tranquillità."
    ],
    "fr": [
      "Participez au Forum des Jobs Saisonnier ! Rencontrez des recruteurs, découvrez des offres variées et trouvez votre emploi pour la saison. Une occasion idéale pour décrocher un job rapidement et préparer votre été en toute sérénité."
    ],
    "es": [
      "Participe en el Foro de Empleo de Temporada Reúnase con reclutadores, infórmese sobre una amplia gama de vacantes y encuentre su trabajo para la temporada. Es la oportunidad perfecta para conseguir un empleo rápidamente y preparar el verano con tranquilidad."
    ],
    "nl": [
      "Neem deel aan het Seizoensbanenforum! Ontmoet recruiters, ontdek een brede waaier aan vacatures en vind jouw job voor het seizoen. Het is de perfecte kans om snel een baan te vinden en je met een gerust hart voor te bereiden op de zomer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forum des jobs saisonniers 2026"
    ]
  },
