  "rdfs:comment": {
    "de": [
      "Das Village des Étoiles befindet sich im Ferienort Les Plans d'Hotonnes und soll möglichst vielen Menschen die Astronomie näher bringen."
    ],
    "en": [
      "Located in the resort of Les Plans d'Hotonnes, the Village des Étoiles is designed to help as many people as possible discover astronomy."
    ],
    "it": [
      "Situato nella località di Les Plans d'Hotonnes, il Village des Étoiles è stato progettato per aiutare il maggior numero di persone a scoprire l'astronomia."
    ],
    "fr": [
      "Situé sur la station des Plans d'Hotonnes, le Village des Étoiles est destiné à faire découvrir l'astronomie au plus grand nombre."
    ],
    "es": [
      "Situado en la estación de Les Plans d'Hotonnes, el Village des Étoiles está concebido para ayudar al mayor número posible de personas a descubrir la astronomía."
    ],
    "nl": [
      "Het Village des Étoiles, gelegen in het vakantieoord Les Plans d'Hotonnes, is ontworpen om zoveel mogelijk mensen de sterrenkunde te laten ontdekken."
    ]
  },
