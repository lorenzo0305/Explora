  "rdfs:comment": {
    "de": [
      "Milch von Kühen der Rassen Tarine und Abondance, die mit Gras und Heu aus unserem Tal gefüttert werden. Wird in den Dörfern Albiez, Saint Jean d'Arves und Saint Sorlin d'Arves gesammelt."
    ],
    "en": [
      "Milk from Tarine and Abondance cows fed on grass and hay from our valley. Collected in the villages of Albiez, Saint Jean d'Arves and Saint Sorlin d'Arves."
    ],
    "it": [
      "Latte di mucche di Tarine e Abondance alimentate con erba e fieno della nostra valle. Raccolto nei villaggi di Albiez, Saint Jean d'Arves e Saint Sorlin d'Arves."
    ],
    "fr": [
      "Lait des Vaches de races Tarine et Abondance nourries à l'herbe et foin de notre vallée. Collecté sur les villages d'Albiez, Saint Jean d'Arves et Saint Sorlin d'Arves."
    ],
    "nl": [
      "Melk van Tarine en Abondance koeien gevoed met gras en hooi uit onze vallei. Verzameld in de dorpen Albiez, Saint Jean d'Arves en Saint Sorlin d'Arves."
    ],
    "es": [
      "Leche de vacas de Tarine y Abondance alimentadas con hierba y heno de nuestro valle. Recolectada en los pueblos de Albiez, Saint Jean d'Arves y Saint Sorlin d'Arves."
    ]
  },
