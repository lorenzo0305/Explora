  "rdfs:comment": {
    "de": [
      "Das Bibliothekarinnenteam empfängt Sie jeden Dienstag in seiner charmanten Bibliothek im Herzen des Hurtières-Gebirges. Sie bieten Ihnen eine große Auswahl an Büchern für alle Altersgruppen sowie Animationen an."
    ],
    "en": [
      "The team of librarians welcomes you every Tuesday to their charming library nestled in the heart of Les Hurtières. They offer a wide choice of books for all ages, as well as a variety of activities."
    ],
    "it": [
      "Il team di bibliotecari vi accoglie ogni martedì nella loro incantevole biblioteca nel cuore di Les Hurtières. Offrono un'ampia selezione di libri per tutte le età e una serie di attività."
    ],
    "fr": [
      "L'équipe de bibliothécaires vous accueille tous les mardis dans leur charmante bibliothèque nichée au cœur des Hurtières. Elles vous proposent un large choix de livres pour tous les âges ainsi que des animations."
    ],
    "nl": [
      "Het team van bibliothecarissen verwelkomt je elke dinsdag in hun charmante bibliotheek in het hart van Les Hurtières. Ze bieden een brede selectie boeken voor alle leeftijden, evenals een reeks activiteiten."
    ],
    "es": [
      "El equipo de bibliotecarios le da la bienvenida todos los martes a su encantadora biblioteca situada en el corazón de Les Hurtières. Ofrecen una amplia selección de libros para todas las edades, así como diversas actividades."
    ]
  },
