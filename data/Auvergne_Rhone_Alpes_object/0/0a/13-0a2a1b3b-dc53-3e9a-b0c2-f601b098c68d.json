  "rdfs:comment": {
    "de": [
      "Das Bowlingcenter in Flaine bietet Ihnen 6 Bahnen, von denen eine speziell für Kinder ab 2 1/2 Jahren geeignet ist.\r\nEmpfang von Gruppen. Bar, Brasserie, Snack.\r\nSpielsaal, Billard, Simulatoren, Großbildschirm und Übertragung von Sportereignissen."
    ],
    "en": [
      "The Flaine bowling alley has 6 lanes, including one specially adapted for children aged 2 and a half and over.\r\nGroups welcome. Bar, brasserie, snack bar. \r\nGames room, billiards, simulators, giant screen and sports broadcasts."
    ],
    "it": [
      "La pista da bowling di Flaine dispone di 6 corsie, di cui una appositamente adattata per i bambini a partire dai 2 anni e mezzo.\r\nSi accettano gruppi. Bar, brasserie, snack bar.\r\nSala giochi, biliardo, simulatori, schermo gigante e trasmissioni sportive."
    ],
    "fr": [
      "Le bowling de Flaine vous propose 6 pistes, dont une spécialement adaptée aux enfants dès 2 ans et demi.\r\nAccueil de groupes. Bar, brasserie, snack. \r\nSalle de jeux, billard, simulateurs, écran géant et retransmission des événements sportifs."
    ],
    "es": [
      "La bolera de Flaine cuenta con 6 pistas, incluida una especialmente adaptada para niños a partir de 2 años y medio.\r\nSe admiten grupos. Bar, brasserie, snack bar.\r\nSala de juegos, billar, simuladores, pantalla gigante y retransmisiones deportivas."
    ],
    "nl": [
      "De bowlingbaan van Flaine heeft 6 banen, waaronder een speciaal aangepaste baan voor kinderen vanaf 2,5 jaar.\r\nGroepen zijn welkom. Bar, brasserie, snackbar.\r\nSpeelzaal, biljart, simulators, reuzenscherm en sportuitzendingen."
    ]
  },
