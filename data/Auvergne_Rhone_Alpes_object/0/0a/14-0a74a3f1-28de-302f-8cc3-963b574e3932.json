  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d836efbe-b059-3c55-ade8-0e3d9289de99",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 9:30 bis 12:30 Uhr und 14:30 bis 19:00 Uhr\n \nAbholung :\n\nZum Mitnehmen während der Öffnungszeiten des Geschäfts\n\nBestellungen:\n\nSie haben die Möglichkeit, per E-Mail zu bestellen:\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 9:30am to 12:30pm and 2:30pm to 7pm\n \nCollection :\n\nTakeaway during store opening hours\n\nOrdering :\n\nYou can order by e-mail:\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: dalle 9.30 alle 12.30 e dalle 14.30 alle 19.00\n \nRaccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nÈ possibile ordinare via e-mail:\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi: 9h30 à 12h30 et 14h30 à 19h\n \nRetrait :\n\nÀ emporter au horaires d'ouverture du magasin\n\nCommandes :\n\nVous avez la possibilité de commander par mail :\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 9u30 tot 12u30 en 14u30 tot 19u00\n \nOphalen :\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nBestellen kan per e-mail:\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 9.30 a 12.30 h. y de 14.30 a 19 h\n \nRecogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPara pedir :\n\nPuede hacer su pedido por correo electrónico:\ncynthia@chocolats-diot.fr\nchristelle@chocolats-diot.fr\n\n\n "
        ]
      },
