  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes La Chaise-Dieu begrüßen wir Sie in unserem kleinen, altmodischen Lebensmittelladen.\r\nLieferung zu Ihnen nach Hause. Versand. Paket-Relais-Punkt."
    ],
    "en": [
      "In the heart of the village of La Chaise-Dieu, we welcome you in our small grocery store.\r\nHome delivery. Shipping. Parcel relay point."
    ],
    "it": [
      "Nel cuore del villaggio di La Chaise-Dieu, vi diamo il benvenuto nel nostro piccolo negozio di alimentari vecchio stile.\r\nConsegna a domicilio. Spedizione. Punto di rilancio delle parcelle."
    ],
    "fr": [
      "Au cœur du village de La Chaise-Dieu, nous vous accueillons dans notre petite épicerie à l'ancienne.\r\nLivraison à domicile. Expédition. Point relais colis."
    ],
    "nl": [
      "In het hart van het dorp La Chaise-Dieu verwelkomen wij u in onze kleine ouderwetse kruidenierswinkel.\r\nThuisbezorging. Verzending. Pakket relaispunt."
    ],
    "es": [
      "En el corazón del pueblo de La Chaise-Dieu, le damos la bienvenida a nuestra pequeña tienda de ultramarinos a la antigua usanza.\r\nEntrega a domicilio. Envío. Punto de relevo de paquetes."
    ]
  },
  "rdfs:label": {
