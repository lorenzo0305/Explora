  "rdfs:comment": {
    "de": [
      "Die Olympiaschanzen von Le Claret wurden für die olympischen Wettkämpfe 1968 gebaut. Sie werden heute noch von den örtlichen Vereinen für Training, Vorführungen und Wettkämpfe genutzt."
    ],
    "en": [
      "The Tremplins Olympiques du Claret were built for the 1968 Olympic Games. Today, they are still used by local clubs for training, demonstrations and competitions."
    ],
    "it": [
      "I Tremplins Olympiques du Claret sono stati costruiti per i Giochi Olimpici del 1968. Oggi sono ancora utilizzati dai club locali per allenamenti, dimostrazioni e gare."
    ],
    "fr": [
      "Les Tremplins Olympiques du Claret furent construits pour les épreuves olympiques de 1968. Ils sont aujourd'hui toujours utilisés par les clubs locaux pour entraînements, démonstrations et compétitions."
    ],
    "es": [
      "Los Tremplins Olympiques du Claret se construyeron para los Juegos Olímpicos de 1968. Hoy en día, siguen siendo utilizados por los clubes locales para entrenamientos, demostraciones y competiciones."
    ],
    "nl": [
      "De Tremplins Olympiques du Claret werden gebouwd voor de Olympische Spelen van 1968. Vandaag de dag worden ze nog steeds gebruikt door lokale clubs voor trainingen, demonstraties en wedstrijden."
    ]
  },
  "rdfs:label": {
