  "rdfs:comment": {
    "de": [
      "Produktion von Ente (fett und zum Braten), Huhn und Eiern. Auf dem Markt in Saint-Médard-en-Forez am Samstagmorgen und in Veauche am Mittwochmorgen vertreten."
    ],
    "en": [
      "Production of duck (fat and roast), chicken and eggs. Present at the Saint-Médard-en-Forez market on Saturday mornings, and at Veauche on Wednesday mornings."
    ],
    "it": [
      "Produce anatre (ingrassate e arrosto), polli e uova. Bancarelle a Saint-Médard-en-Forez il sabato mattina e a Veauche il mercoledì mattina."
    ],
    "fr": [
      "Production de canard (gras et à rotir), de poulet et d'œufs. Présent sur le marché de Saint-Médard-en-Forez le samedi matin, à Veauche le mercredi matin."
    ],
    "nl": [
      "Produceert eend (vetgemest en gebraden), kip en eieren. Marktkramen in Saint-Médard-en-Forez op zaterdagochtend en Veauche op woensdagochtend."
    ],
    "es": [
      "Produce pato (cebado y asado), pollo y huevos. Puestos de mercado en Saint-Médard-en-Forez los sábados por la mañana y en Veauche los miércoles por la mañana."
    ]
  },
