  "rdfs:comment": {
    "de": [
      "Sind Sie auf der Durchreise in der Nähe des Aire des Vérités oder in Montluçon? Kommen Sie und essen Sie zu kleinen Preisen, schnell oder in Ruhe, in einem schönen, einladenden und angenehmen Rahmen. Oder auch zum Mitnehmen...!"
    ],
    "en": [
      "Passing near the Aire des Vérités or Montluçon? Come and eat at low prices, quickly or by taking your time, in a nice and pleasant setting. Or to take away...!"
    ],
    "it": [
      "Passate dall'Aire des Vérités o da Montluçon? Venite a mangiare a prezzi bassi, velocemente o con i vostri tempi, in un ambiente piacevole e accogliente. O di portar via...!"
    ],
    "fr": [
      "De passage près de l'Aire des Vérités ou de Montluçon ? Venez vous restaurer à petits prix, rapidement ou en prenant votre temps, dans un joli cadre accueillant et agréable. Ou bien à emporter...!"
    ],
    "es": [
      "¿Pasas por el Aire de las Verdades o por Montluçon? Venga a comer a precios bajos, rápidamente o en su tiempo libre, en un entorno agradable y acogedor. O quitar.."
    ],
    "nl": [
      "Komt u door de Aire des Vérités of Montluçon? Kom eten tegen lage prijzen, snel of in uw eigen tijd, in een gezellig en gastvrij kader. Of meenemen...!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restauration rapide : L'Aire des Vérités"
    ]
  },
