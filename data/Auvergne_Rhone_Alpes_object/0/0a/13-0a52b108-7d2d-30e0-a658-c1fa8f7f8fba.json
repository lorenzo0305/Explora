  "rdfs:comment": {
    "de": [
      "Verkauf von biologischen Produkten: Lebensmittel hauptsächlich aus lokaler Landwirtschaft und fairem Handel, Bio-Brot, lokale Bio-Weine, Bio-Gemüse, Reinigungsmittel, Hygieneartikel, Kosmetika, einige makrobiotische Produkte."
    ],
    "en": [
      "Organic products for sale. Local Food, Cleaning products, hygiene, cosmetics..."
    ],
    "it": [
      "Vendita di prodotti biologici: alimenti provenienti principalmente da agricoltura locale e commercio equo e solidale, pane biologico, vini biologici locali, verdure biologiche, prodotti per la pulizia, l'igiene, cosmetici, alcuni prodotti macrobiotici."
    ],
    "fr": [
      "Vente de produits biologiques : alimentaires principalement issus de l'agriculture locale et du commerce équitable, pains bio, vins locaux bio, légumes bio, produits d'entretien, hygiène, cosmétiques, quelques produits macrobiotiques."
    ],
    "nl": [
      "Verkoop van biologische producten: voedingsmiddelen die hoofdzakelijk afkomstig zijn van lokale landbouw en fairtrade handel, biologische broden, lokale biologische wijnen, biologische groenten, schoonmaakmiddelen, verzorgings- en cosmeticaproducten en vele andere macrobiotische producten."
    ],
    "es": [
      "Venta de productos ecológicos: alimentos procedentes principalmente de la agricultura local y del comercio justo, pan ecológico, vinos ecológicos locales, verduras ecológicas, productos de limpieza, higiene, cosméticos, algunos productos macrobióticos."
    ]
  },
