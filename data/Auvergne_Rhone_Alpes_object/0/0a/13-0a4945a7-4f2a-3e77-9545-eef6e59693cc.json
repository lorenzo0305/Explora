  "rdfs:comment": {
    "de": [
      "Bist du ein Geist?\r\nVersuche, den Geist zu befreien, der im Schloss herumspukt?\r\nVon 2 bis 4 Spielern.\r\nAb 15 Jahren."
    ],
    "en": [
      "Are you there?\r\nTry to free the spirit haunting the castle....\r\nFrom 2 to 4 players.\r\nAges 15 and up."
    ],
    "it": [
      "Siete lì?\r\nCerca di liberare lo spirito che infesta il castello....\r\nDa 2 a 4 giocatori.\r\nDai 15 anni in su."
    ],
    "fr": [
      "Esprit es-tu là ?\r\nTentez de libérer l'esprit qui hante le château….\r\nDe 2 à 4  joueurs.\r\nÀ partir de 15 ans."
    ],
    "es": [
      "¿Estás ahí?\r\nIntenta liberar al espíritu que ronda el castillo....\r\nDe 2 a 4 jugadores.\r\nA partir de 15 años."
    ],
    "nl": [
      "Ben jij daar?\r\nProbeer de geest te bevrijden die rondwaart in het kasteel....\r\n2 tot 4 spelers.\r\nVanaf 15 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game : Esprit es-tu là ?"
    ]
  },
