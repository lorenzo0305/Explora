  "rdfs:comment": {
    "de": [
      "Choclo, das ist eine bistronomische Küche voller Aromen, die traditionelle französische Küche mit Weltküche verbindet, die von den Reisen von Lucas und Astrid geprägt ist. Alle Produkte stammen von Erzeugern aus der Gegend und die Weinkarte ist präzise und engagiert"
    ],
    "en": [
      "Choclo is a bistronomic cuisine full of flavors, blending traditional French cuisine with world cuisine marked by Lucas and Astrid's travels. All products come from local producers, and the wine list is precise and committed"
    ],
    "it": [
      "Choclo è un ristorante bistronomico ricco di sapori, che combina la cucina tradizionale francese con la cucina mondiale ispirata ai viaggi di Lucas e Astrid. Tutti i prodotti provengono da produttori locali e la carta dei vini è precisa e impegnata"
    ],
    "fr": [
      "Choclo, c'est une cuisine bistronomique pleine de saveurs mêlant cuisine traditionnelle française et cuisine du monde marquée par les voyages de Lucas et Astrid. Tous les produits viennent de producteurs du coin et la carte des vins est précise et engagée"
    ],
    "nl": [
      "Choclo is een bistronomisch restaurant vol smaak, waar de traditionele Franse keuken wordt gecombineerd met wereldkeuken geïnspireerd door de reizen van Lucas en Astrid. Alle producten komen van lokale producenten en de wijnkaart is nauwkeurig en toegewijd"
    ],
    "es": [
      "Choclo es un restaurante bistronómico lleno de sabor, que combina la cocina tradicional francesa con la cocina del mundo inspirada en los viajes de Lucas y Astrid. Todos los productos proceden de productores locales, y la carta de vinos es precisa y comprometida"
    ]
  },
