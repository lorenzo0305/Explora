  "rdfs:comment": {
    "de": [
      "Mein Atelier liegt 5 Minuten von der Autobahn A75 entfernt und entführt Sie in eine bunte Welt, die von Schachteln, Häusern aller Art, Bilderrahmen, Schmuck, Landschaften und anderem bevölkert wird."
    ],
    "en": [
      "Located 5 minutes from the A75 freeway, my studio will take you into a colorful world, populated by boxes, houses of all kinds, frames, jewelry, landscapes and more."
    ],
    "it": [
      "A soli 5 minuti dall'autostrada A75, il mio studio vi porterà in un mondo colorato di scatole, case di ogni tipo, cornici, gioielli, paesaggi e altro ancora."
    ],
    "fr": [
      "Situé à 5 mn de l'autoroute A75, mon atelier vous emmènera dans un univers coloré, peuplé de boîtes, maisons de toutes sortes, cadres, bijoux, paysages et autre."
    ],
    "nl": [
      "Mijn studio ligt op slechts 5 minuten van de snelweg A75 en neemt je mee in een kleurrijke wereld van dozen, allerlei soorten huizen, lijsten, sieraden, landschappen en nog veel meer."
    ],
    "es": [
      "A sólo 5 minutos de la autopista A75, mi estudio le llevará a un colorido mundo de cajas, casas de todo tipo, marcos, joyas, paisajes y mucho más."
    ]
  },
  "rdfs:label": {
