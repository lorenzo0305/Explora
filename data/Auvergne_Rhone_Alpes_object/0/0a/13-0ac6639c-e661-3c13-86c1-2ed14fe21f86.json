  "rdfs:comment": {
    "de": [
      "Jeder für seinen eigenen Apfel oder im Team: Entscheide, wie du gegen deine Freunde oder deine Familie antrittst! Für die Sitzungen von 20:00 bis 22:00 Uhr am Freitag und Samstag ist eine Reservierung erforderlich."
    ],
    "en": [
      "Each to his own, or as a team, choose how you'll take on your friends and family! Reservations essential for sessions from 8pm to 10pm on Fridays and Saturdays."
    ],
    "it": [
      "Da soli o in squadra, scegliete come affrontare i vostri amici e la vostra famiglia! Prenotazione obbligatoria per le sessioni dalle 20.00 alle 22.00 il venerdì e il sabato."
    ],
    "fr": [
      "Chacun pour sa pomme ou en équipe, choisis comment tu affronteras tes amis ou ta famille ! Réservation obligatoire pour les sessions de 20h à 22h les vendredis et samedis."
    ],
    "es": [
      "Ya sea en solitario o en equipo, ¡elige cómo vas a enfrentarte a tus amigos y familiares! Imprescindible reservar para las sesiones de 20:00 a 22:00 los viernes y sábados."
    ],
    "nl": [
      "Of je nu alleen gaat of met een team, kies zelf hoe je het opneemt tegen je vrienden en familie! Reserveren is noodzakelijk voor sessies van 20.00 tot 22.00 uur op vrijdag en zaterdag."
    ]
  },
