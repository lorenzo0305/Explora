  "rdfs:comment": {
    "de": [
      "La Marmotte Gourmande verwöhnt Sie im Stadtzentrum von Roanne. Sie bietet Ihnen eine traditionelle und savoyische Küche (Frösche und Muscheln ab April). Wegen der Genesung des Küchenchefs muss sie von Juni bis August eine Pause einlegen!"
    ],
    "en": [
      "La Marmotte Gourmande is located in downtown Roanne. It offers traditional Savoyard cuisine (frogs and mussels from April). From June to August, La Marmotte Gourmande has to put its stoves on hold due to the chef's convalescence!"
    ],
    "it": [
      "La Marmotte Gourmande si trova nel centro di Roanne. Offre una cucina tradizionale savoiarda (rane e cozze da aprile). Da giugno ad agosto deve mettere in pausa i fornelli per la convalescenza dello chef!"
    ],
    "fr": [
      "La Marmotte Gourmande vous régale au centre-ville de Roanne. Elle vous propose une cuisine traditionnelle et savoyarde (grenouilles et moules à partir d'avril). Elle doit mettre ses fourneaux en pause pour convalescence du chef de juin à août !"
    ],
    "es": [
      "La Marmotte Gourmande se encuentra en el centro de Roanne. Ofrece cocina tradicional saboyana (ranas y mejillones a partir de abril). De junio a agosto, los fogones se paran por convalecencia del chef"
    ],
    "nl": [
      "La Marmotte Gourmande ligt in het centrum van Roanne. Het biedt traditionele Savoyaardse gerechten (kikkers en mosselen vanaf april). Van juni tot augustus moeten de kachels uit voor het herstel van de chef-kok!"
    ]
  },
  "rdfs:label": {
