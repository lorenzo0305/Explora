  "rdfs:comment": {
    "de": [
      "Der Verein Les Amis de Léoncel hat sich zum Ziel gesetzt, das Kulturerbe von Léoncel aufzuwerten und zu verteidigen. Sie erfüllt diese Aufgabe durch die Organisation von Veranstaltungen, Aktivitäten und Renovierungen."
    ],
    "en": [
      "Les Amis de Léoncel aims to promote and protect Léoncel's heritage. It accomplishes this mission by organizing events, activities and renovations."
    ],
    "it": [
      "Les Amis de Léoncel si propone di promuovere e proteggere il patrimonio di Léoncel. Svolge questa missione organizzando eventi, attività e restauri."
    ],
    "fr": [
      "L'association Les Amis de Léoncel a pour but la mise en valeur et la défense du patrimoine de Léoncel. Elle accomplit cette mission en organisant des animations, activités et rénovations."
    ],
    "es": [
      "Les Amis de Léoncel tiene como objetivo promover y proteger el patrimonio de Léoncel. Cumple esta misión organizando eventos, actividades y renovaciones."
    ],
    "nl": [
      "Les Amis de Léoncel heeft als doel het erfgoed van Léoncel te promoten en te beschermen. Het vervult deze missie door het organiseren van evenementen, activiteiten en renovaties."
    ]
  },
