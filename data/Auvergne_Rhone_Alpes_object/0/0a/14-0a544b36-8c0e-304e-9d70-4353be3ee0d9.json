      "@id": "https://data.datatourisme.fr/96beeca1-2d4b-3fc0-8887-bf81a8cc2877",
      "dc:description": {
        "de": [
          "05 05 2024\nFahrradtour - Empfang Zentrum St. Joseph\nauf den Spuren von Napoleon\n50 KMS: 1 ?\n70 KMS : 2 ?\n90 KMS : 2 ?\n150 KMS : 2 ?\nNicht FFCT: 4 ?\nWanderer: 10 kms kostenlos\nKONTAKT: 06.08.99.23.96 UND 06.66.23.46.04.\n\nAUSZEICHNUNG DER PREISE um 17.00 Uhr"
        ],
        "en": [
          "05 05 2024\nCycle tour - welcome at St Joseph center\nin the footsteps of Napoleon\n50 KMS : 1 ?\n70 KMS : 2 ?\n90 KMS : 2 ?\n150 KMS : 2 ?\nNon FFCT : 4 ?\nWalker : 10 kms free\nCONTACT : 06.08.99.23.96 AND 06.66.23.46.04.\n\nAWARDS at 5:00 p.m"
        ],
        "it": [
          "05 05 2024\nCicloturismo - accoglienza presso il centro St Joseph\nsulle orme di Napoleone\n50 KM : 1 ?\n70 KM : 2 ?\n90 KM : 2 ?\n150 KMS : 2 ?\nNon FFCT : 4 ?\nPasseggero : 10 km gratis\nCONTATTO : 06.08.99.23.96 E 06.66.23.46.04.\n\nPREMIAZIONI alle 17.00"
        ],
        "fr": [
          "05 05 2024\nRandonnée cyclotouriste - accueil centre St Joseph \nsur les traces de Napoléon \n50 KMS : 1 €\n70 KMS : 2 €\n90 KMS : 2 €\n150 KMS : 2 €\nNon FFCT : 4 €\nMarcheur : 10 kms gratuit\nCONTACT : 06.08.99.23.96 ET 06.66.23.46.04.\n\nREMISE DES RECOMPENSES à 17H00"
        ],
        "nl": [
          "05 05 2024\nFietstocht - ontvangst in het Sint-Jozefcentrum\nin de voetsporen van Napoleon\n50 KMS : 1 ?\n70 KM : 2 ?\n90 KM : 2 ?\n150 KM : 2 ?\nNiet FFCT : 4 ?\nWandelaar : 10 km gratis\nCONTACT : 06.08.99.23.96 EN 06.66.23.46.04.\n\nAWARDS om 17.00 uur"
        ],
        "es": [
          "05 05 2024\nCicloturismo - acogida en el centro St Joseph\ntras las huellas de Napoleón\n50 KMS : 1 ?\n70 KMS : 2 ?\n90 KMS : 2 ?\n150 KMS : 2 ?\nNo FFCT : 4 ?\nCaminante : 10 kms gratis\nCONTACTO : 06.08.99.23.96 Y 06.66.23.46.04.\n\nPREMIOS a las 17h00"
        ]
      },
