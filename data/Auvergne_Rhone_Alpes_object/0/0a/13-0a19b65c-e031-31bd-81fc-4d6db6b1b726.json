  "rdfs:comment": {
    "de": [
      "Fluchtspiel für Teams von 2 bis 12 Personen in Bourg-en-Bresse.\r\nEine begrenzte Zeit - Ein Team - Eine Mission. Trauen Sie sich, die Herausforderung anzunehmen?\r\n6 Räume, die für Familien zugänglich sind, Kinder ab 8 Jahren. Kurzlebige Räume für Abwechslung."
    ],
    "en": [
      "Escape game for teams of 2 to 12 people in Bourg-en-Bresse.\r\nLimited time - One team - One mission. Do you dare to take up the challenge?\r\n6 rooms accessible to families, children aged 8 and over. Ephemeral rooms to vary the pleasures."
    ],
    "it": [
      "Gioco di fuga per squadre da 2 a 12 persone a Bourg-en-Bresse.\r\nTempo limitato - Una squadra - Una missione. Avrete il coraggio di accettare la sfida?\r\n6 stanze accessibili alle famiglie, ai bambini dagli 8 anni in su. Stanze effimere per variare i piaceri."
    ],
    "fr": [
      "Jeu d'évasion en équipe de 2 à 12 personnes à Bourg-en-Bresse. \r\nUn temps limité - Une équipe - Une mission. Oserez-vous relever le défi ?\r\n6 salles accessibles aux familles, enfants à partir de 8 ans. Des salles éphémères pour varier les plaisirs."
    ],
    "nl": [
      "Ontsnappingsspel voor teams van 2 tot 12 personen in Bourg-en-Bresse.\r\nBeperkte tijd - Eén team - Eén missie. Durven jullie de uitdaging aan?\r\n6 kamers toegankelijk voor gezinnen, kinderen vanaf 8 jaar. Tijdelijke kamers om het plezier te variëren."
    ],
    "es": [
      "Juego de escape para equipos de 2 a 12 personas en Bourg-en-Bresse.\r\nTiempo limitado - Un equipo - Una misión. ¿Os atreveréis a aceptar el reto?\r\n6 salas accesibles para familias, niños a partir de 8 años. Habitaciones efímeras para variar los placeres."
    ]
  },
  "rdfs:label": {
    "en": [
      "Challenge 01 - Escape Game"
    ],
    "fr": [
      "Défi 01 - Escape Game"
    ]
  },
