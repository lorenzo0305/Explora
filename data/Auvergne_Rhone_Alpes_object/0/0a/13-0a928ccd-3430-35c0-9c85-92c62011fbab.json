  "rdfs:comment": {
    "de": [
      "Claudine, Herstellerin von Krippenfiguren, präsentiert diese Figuren, die so typisch für die Region sind. Zwischen 15 und 25 cm groß, präsentieren sie die Berufe von früher. Krippendekore in verschiedenen Größen von 3 bis 15 cm. Verkauf \r\nvon Santons in 7 cm."
    ],
    "en": [
      "Claudine makes clay figurines or santons. She presents her 15cm and 25cm creations representing the trades and occupations of yesteryear. Nativity crib scenes for different sizes of santons from 3 to 15 cm. Stopper à Sales of 7cm santons."
    ],
    "it": [
      "Venite a scoprire il lavoro di Claudine Hugues santonnière. L'artista realizza santoni di 18 e 28 cm vestiti di stoffa, che rappresentano i vari mestieri di un tempo. Potrete anche scoprire le sue decorazioni per il presepe per santoni da 3 a 15 cm."
    ],
    "fr": [
      "Venez découvrir le travail de Claudine Hugues santonnière. Elle réalise des santons de 18 et 28cm habillés de tissus, représentant les différents métiers d’antan. Vous pourrez découvrir aussi ses décors de crèches pour santons de 3 à 15cm."
    ],
    "es": [
      "Venga a descubrir el trabajo de Claudine Hugues santonnière. Realiza santones de 18 y 28 cm vestidos de tela, que representan los distintos oficios de antaño. También podrá descubrir sus decoraciones de belén para santones de 3 a 15 cm."
    ],
    "nl": [
      "Claudine, santonnière, presenteert haar creaties van santons van 15 en 25 cm, welke ambachten van vroeger vertegenwoordigen. Kerststal decoraties in verschillende maten behorend tot santons van 3 tot 15 cm. Verkoop van santons \r\nvan 7 cm."
    ]
  },
