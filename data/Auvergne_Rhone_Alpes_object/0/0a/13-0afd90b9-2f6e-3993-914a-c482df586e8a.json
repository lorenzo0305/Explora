  "rdfs:comment": {
    "de": [
      "In unserer Käserei können Sie unsere Produktion von der Faselle bis zum Picodon AOC entdecken. Je nach Verfügbarkeit und Verkauf vor Ort. Auf dem Markt von Bourdeaux am Donnerstag."
    ],
    "en": [
      "Discover our cheese dairy where we produce cottage cheese and Picodon AOC. Visit of the farm by reservation. Sale of our products."
    ],
    "it": [
      "Venite a scoprire la nostra produzione di formaggi, dalle faisselle al Picodon AOC. Visite alla fattoria su prenotazione (5 euro/adulto). Vendita in loco e al mercato di Bourdeaux il giovedì."
    ],
    "fr": [
      "Dans notre fromagerie venez découvrir notre production de la faisselle au Picodon AOC. Visite  de la ferme sur réservation (5€/adulte). Vente sur place et sur le marché de Bourdeaux le jeudi."
    ],
    "es": [
      "Venga a descubrir nuestra producción quesera, desde el faisselle hasta el Picodon AOC. Visitas a la granja concertadas (5 €/adulto). Venta in situ y en el mercado de Bourdeaux los jueves."
    ],
    "nl": [
      "Kom en ontdek onze kaasproductie, van faisselle tot Picodon AOC.  bezoek aan de boerderij op afspraak, afhankelijk van beschikbaarheid en verkoop ter plaatse. Op de markt van Bourdeaux op donderdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec Chez Amandine"
    ]
  },
