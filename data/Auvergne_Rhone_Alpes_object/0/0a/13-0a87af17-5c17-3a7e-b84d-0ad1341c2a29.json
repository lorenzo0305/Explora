  "rdfs:comment": {
    "de": [
      "In Anneyron bietet Ihnen Le Village de Marques ein einzigartiges Einkaufserlebnis, das Sie das ganze Jahr über nutzen können. Profitieren Sie von Schnäppchen bei einer Auswahl an Qualitätsmarken wie Lafuma, Oxbow, Calida, Millet, Aubade und Lafuma Mobilier."
    ],
    "en": [
      "A large shopping hall on the Lafuma site offers a large range of  well-known brands : OXBOW, along with Lafuma."
    ],
    "it": [
      "Ad Anneyron, Le Village de Marques vi offre un'esperienza di shopping unica, disponibile tutto l'anno. Approfittate delle occasioni su una selezione di marchi di qualità come Lafuma, Millet, Oxbow, Calida, Aubade e Lafuma Mobilier."
    ],
    "fr": [
      "À Anneyron, Le Village de Marques vous offre une expérience shopping unique, accessible tout au long de l’année. Profitez de bonnes affaires sur une sélection de marques de qualité telles que Lafuma, Millet, Oxbow, Calida, Aubade, et Lafuma Mobilier."
    ],
    "nl": [
      "In Anneyron biedt Le Village de Marques je een unieke winkelervaring, het hele jaar door. Profiteer van de koopjes op een selectie kwaliteitsmerken zoals Lafuma, Oxbow, Calida, Millet, Aubade en Lafuma Mobilier."
    ],
    "es": [
      "En Anneyron, Le Village de Marques le ofrece una experiencia de compras única, disponible todo el año. Aproveche las ofertas de una selección de marcas de calidad como Lafuma, Millet, Oxbow, Calida, Aubade y Lafuma Mobilier."
    ]
  },
  "rdfs:label": {
