  "rdfs:comment": {
    "de": [
      "Die Boulderhalle Vertical?Art empfängt Sie jeden Tag in Saint-Martin-D?Hérès in einem großen Raum von 1700m² mit unterschiedlichen Profilen und Niveaus, die mehrmals pro Woche erneuert werden."
    ],
    "en": [
      "The Vertical?Art bouldering gym welcomes you every day in Saint-Martin-D?Hérès in a large 1700m² space, with a variety of profiles and levels that are renewed several times a week."
    ],
    "it": [
      "La palestra di bouldering Vertical?Art vi accoglie ogni giorno a Saint-Martin-D'Hérès in un ampio spazio di 1700 m², con una varietà di profili e livelli che vengono rinnovati più volte alla settimana."
    ],
    "fr": [
      "La salle de bloc Vertical’Art vous accueillera tous les jours à Saint-Martin-D’Hérès dans un grand espace de 1700m², aux profils et niveaux variés et renouvelés plusieurs fois par semaine."
    ],
    "es": [
      "El gimnasio de boulder Vertical?Art le acoge cada día en Saint-Martin-D'Hérès en un gran espacio de 1700 m², con una variedad de perfiles y niveles que se renuevan varias veces por semana."
    ],
    "nl": [
      "De boulderzaal Vertical?Art verwelkomt je elke dag in Saint-Martin-D?Hérès in een grote ruimte van 1700 m², met verschillende profielen en niveaus die meerdere keren per week worden vernieuwd."
    ]
  },
