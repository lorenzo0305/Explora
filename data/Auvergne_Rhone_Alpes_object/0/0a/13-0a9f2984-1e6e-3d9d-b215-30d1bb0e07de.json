  "rdfs:comment": {
    "de": [
      "Die heißen Quellen, die aus dem Zentrum der Erde entspringen, bringen ein weltweit einzigartiges Handwerk hervor: die Kunst der Versteinerung. Verbringen Sie einen zeitlosen Moment in der Höhle, in den Galerien, Werkstätten und dem Versteinerten Brunnen."
    ],
    "en": [
      "The hot springs that gush out from the centre of the earth give birth to a craft that is unique in the world: the art of petrifaction. Spend a timeless moment in the cave, the galleries, the workshops and the Petrifying Fountain."
    ],
    "it": [
      "Qui l'uomo trasforma l'acqua in pietra! A Saint-Nectaire, l'attività vulcanica è ancora forte: sorgenti calde sgorgano dal centro della terra, dando origine a un'arte unica al mondo: la pietrificazione."
    ],
    "fr": [
      "Ici, l'homme transforme l'eau en pierre! A Saint-Nectaire, l'activité volcanique se manifeste toujours : des sources chaudes jaillissent du centre de la Terre et donnent naissance à un artisanat unique au monde : la pétrification."
    ],
    "nl": [
      "Hier verandert de mens water in steen! In Saint-Nectaire is er nog steeds vulkanische activiteit: hete bronnen borrelen op uit het middelpunt van de aarde en geven aanleiding tot een ambacht dat uniek is in de wereld: verstening."
    ],
    "es": [
      "Aquí, ¡el hombre convierte el agua en piedra! En Saint-Nectaire, la actividad volcánica sigue su curso: las aguas termales burbujean desde el centro de la tierra, dando lugar a una artesanía única en el mundo: la petrificación."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die versteinernden Brunnen von Saint-Nectaire"
    ],
    "en": [
      "The Petrifying Fountains of Saint-Nectaire"
    ],
    "fr": [
      "Fontaines Pétrifiantes de Saint-Nectaire"
    ]
  },
