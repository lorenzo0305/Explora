  "rdfs:comment": {
    "de": [
      "Die nautische Basis von Chambonas Brücke bietet einen Abstieg von 10 Kilometern im Kanufahren auf Chassezac Fluss."
    ],
    "en": [
      "Canoeing or kayaking : 10kms. Paddling, introduction to canoeing or pedal boat."
    ],
    "it": [
      "Il centro di sport acquatici offre il noleggio di pedalò, canoe, kayak e pagaie sul lago Pont de Chambonas.\r\nUn servizio di camioncino per bevande, gelati e pizza"
    ],
    "fr": [
      "La base nautique vous propose la location sur le plan d’eau du pont de Chambonas de pédalo, canoë, kayak, paddle.\r\nUn service boissons, glaces et camion pizzas"
    ],
    "es": [
      "El centro de deportes náuticos ofrece alquiler de pedalós, canoas, kayaks y remos en el lago Pont de Chambonas.\r\nServicio de camión de bebidas, helados y pizzas"
    ],
    "nl": [
      "Bij het watersportcentrum kun je waterfietsen, kano's, kajaks en peddels huren op het meer Pont de Chambonas.\r\nEen drank-, ijs- en pizzawagen"
    ]
  },
