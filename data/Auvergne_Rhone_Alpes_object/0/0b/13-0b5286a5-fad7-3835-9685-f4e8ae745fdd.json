  "rdfs:comment": {
    "de": [
      "Yannick Billard ist Bergführer und hat Aventure & Coopération gegründet, um Sie bei Ihren Wanderungen, Fahrradtouren oder Mikroabenteuern durch die Alpen zu begleiten."
    ],
    "en": [
      "Yannick Billard is a mountain guide and has created Aventure & Coopération to accompany you on your hikes, bike rides or micro-adventures through the Alps."
    ],
    "it": [
      "Yannick Billard è una guida alpina e ha creato Aventure & Coopération per accompagnarvi nelle vostre escursioni, gite in bicicletta o micro-avventure attraverso le Alpi."
    ],
    "fr": [
      "Yannick Billard est accompagnateur en montagne et a crée Aventure & Coopération pour vous accompagner dans vos randonnées, vos sorties vélos ou vos micro-aventures à travers les Alpes."
    ],
    "nl": [
      "Yannick Billard is berggids en heeft Aventure & Coopération opgericht om je te begeleiden op je wandelingen, fietstochten of micro-avonturen door de Alpen."
    ],
    "es": [
      "Yannick Billard es guía de montaña y ha creado Aventure & Coopération para acompañarle en sus caminatas, paseos en bicicleta o microaventuras por los Alpes."
    ]
  },
  "rdfs:label": {
