  "rdfs:comment": {
    "de": [
      "Dinge, die Sie mögen: die Spezialitäten der Region Hauts-de-France, die Panches zum Teilen und die Spezialität des Hauses, das gegrillte Spanferkel."
    ],
    "en": [
      "You'll love the Hauts-de-France specialities, the panches to share and the speciality of the establishment, the grilled suckling pig."
    ],
    "it": [
      "Vi piaceranno le specialità dell'Hauts-de-France, le panche da condividere e la specialità del ristorante, il maialino da latte alla griglia."
    ],
    "fr": [
      "Vous aimerez : les spécialités des Hauts-de-France, les panches à partager et la spéciaiité de l'établissement, le cochon de lait grillé."
    ],
    "es": [
      "Le encantarán las especialidades de Hauts-de-France, los panches para compartir y la especialidad del restaurante, el cochinillo a la parrilla."
    ],
    "nl": [
      "Je zult dol zijn op de specialiteiten uit de Hauts-de-France, de panches om te delen en de specialiteit van het restaurant, het gegrilde speenvarken."
    ]
  },
