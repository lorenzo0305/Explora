  "rdfs:comment": {
    "de": [
      "Les Voyageurs des Cimes ist ein Verein nach dem Gesetz von 1901, dessen Ziel es ist, die Verbindung zwischen den Menschen und ihrer Umwelt (wieder) herzustellen."
    ],
    "en": [
      "Les Voyageurs des Cimes is an association under the law of 1901 whose aim is to (re)create the link between people and their environment."
    ],
    "it": [
      "Les Voyageurs des Cimes è un'associazione di diritto francese del 1901 il cui scopo è quello di (ri)creare il legame tra l'uomo e il suo ambiente."
    ],
    "fr": [
      "Les Voyageurs des Cimes est une association loi 1901 qui a pour objet de (re)créer le lien entre les humains et leur environnement."
    ],
    "nl": [
      "Les Voyageurs des Cimes is een vereniging onder de wet van 1901 met als doel de band tussen mensen en hun omgeving te (her)creëren."
    ],
    "es": [
      "Les Voyageurs des Cimes es una asociación de derecho francés de 1901 cuyo objetivo es (re)crear el vínculo entre el ser humano y su entorno."
    ]
  },
