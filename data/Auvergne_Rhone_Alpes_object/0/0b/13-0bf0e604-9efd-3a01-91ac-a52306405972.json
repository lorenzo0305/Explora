  "rdfs:comment": {
    "de": [
      "Tische auf Vorbestellung.\r\nProdukte vom eigenen Hof, aber auch von anderen lokalen Landwirten, alles aus biologischem Anbau. Lamm, Schwein, Kichererbsen, Linsen..."
    ],
    "en": [
      "Tables available by reservation.\r\nProducts from our farm as well as other local farmers, all organically grown. Lamb, pork, chickpeas, lentils..."
    ],
    "it": [
      "Tavoli su prenotazione.\r\nProdotti dell'azienda agricola ma anche di altri agricoltori locali, tutti di coltivazione biologica. Agnello, maiale, ceci, lenticchie..."
    ],
    "fr": [
      "Tables sur réservation.\r\nProduits de la ferme mais aussi d'autres agriculteurs(trices) locaux, le tout en agriculture biologique. Agneau, cochon, pois chiches, lentilles..."
    ],
    "nl": [
      "Tafels op afspraak.\r\nProducten van de boerderij maar ook van andere lokale boeren, allemaal biologisch geteeld. Lam, varkensvlees, kikkererwten, linzen..."
    ],
    "es": [
      "Mesas con cita previa.\r\nProductos de la granja, pero también de otros agricultores locales, todos de cultivo ecológico. Cordero, cerdo, garbanzos, lentejas..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Auberge Le Merlet"
    ]
  },
