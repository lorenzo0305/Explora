  "rdfs:comment": {
    "de": [
      "Im Herzen von Saint-Joseph, auf den Anhöhen des Dorfes Saint-Jean de Muzols, empfängt Sie die Domaine Farge im Weinkeller, um Condrieu, Saint-Joseph und Saint-Peray zu verkosten."
    ],
    "en": [
      "In the heart of Saint-Joseph, on the heights of the village of Saint-Jean de Muzols, Domaine Farge welcomes you to the cellar, by appointment only, to taste its wines (Condrieu, Saint-Joseph, Saint-Peray, Cornas)."
    ],
    "it": [
      "Nel cuore di Saint-Joseph, sulle alture del villaggio di Saint-Jean de Muzols, il Domaine Farge vi accoglie nella sua cantina, solo su appuntamento, per degustare i suoi vini (Condrieu, Saint-Joseph, Saint-Peray, Cornas)."
    ],
    "fr": [
      "Au cœur du Saint-Joseph, sur les hauteurs du village de Saint-Jean de Muzols, le Domaine Farge vous accueille à la cave, uniquement sur rendez-vous, pour déguster ses vins (Condrieu, Saint-Joseph, Saint-Peray, Cornas)."
    ],
    "nl": [
      "In het hart van Saint-Joseph, op de hoogten van het dorp Saint-Jean de Muzols, verwelkomt Domaine Farge je in zijn kelder om Condrieu, Saint-Joseph en Saint-Peray te proeven."
    ],
    "es": [
      "En el corazón de Saint-Joseph, en las alturas del pueblo de Saint-Jean de Muzols, el Domaine Farge le recibe en su bodega, con cita previa, para degustar sus vinos (Condrieu, Saint-Joseph, Saint-Peray, Cornas)."
    ]
  },
