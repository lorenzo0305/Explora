  "rdfs:comment": {
    "de": [
      "Das KFT: Das Café-Theater 100% Humor in Saint Galmier.\r\nEin einzigartiger Ort an der Loire im Herzen des ehemaligen Klosters von Saint-Galmier. Winter- und Sommerterrasse mit Panoramablick auf die Ebene und die Monts du Forez."
    ],
    "en": [
      "Le KFT: the 100% humor café-theater in Saint Galmier.\r\nA unique venue in the Loire in the heart of Saint-Galmier's old cloister, with winter and summer terraces and panoramic views over the plain and the Forez mountains."
    ],
    "it": [
      "Le KFT: il caffè-teatro 100% comico di Saint Galmier.\r\nUn locale unico nella Loira, situato nel cuore dell'antico chiostro di Saint-Galmier, con una terrazza invernale e una estiva con vista panoramica sulla pianura e sulle montagne del Forez."
    ],
    "fr": [
      "Le KFT : le café-théâtre 100% humour à Saint Galmier.\r\nUn lieu unique dans la Loire situé au coeur de l'ancien cloître de Saint-Galmier, terrasse d'hiver et terrasse d'été avec vue panoramique sur la plaine et les monts du Forez."
    ],
    "nl": [
      "Le KFT: het 100% komische café-theater in Saint Galmier.\r\nEen unieke locatie in de Loire, gelegen in het hart van het oude klooster van Saint-Galmier, met een winterterras en een zomerterras met panoramisch uitzicht over de vlakte en het Forez-gebergte."
    ],
    "es": [
      "Le KFT: el café-teatro 100% cómico de Saint Galmier.\r\nUn local único en el Loira situado en el corazón del antiguo claustro de Saint-Galmier, con terraza de invierno y terraza de verano con vistas panorámicas sobre la llanura y los montes de Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "KFT Café-Théâtre"
    ]
  },
