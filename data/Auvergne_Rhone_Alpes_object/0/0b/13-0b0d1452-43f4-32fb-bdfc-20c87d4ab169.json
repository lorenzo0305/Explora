  "rdfs:comment": {
    "de": [
      "Ein Boutique-Geschäft von 5 volle kreative Ideen, die Schmuck, Accessoires, Dekorationsgegenstände und Bilder haben geteilt. Alle Kreationen im Shop-Bereich vorgestellt werden vor Ort hergestellt."
    ],
    "en": [
      "A workshop and store shared by five designers with plenty of ideas who present their jewellery, art prints, accessories, and decorative items. All designer items displayed in the shop are manufactured on-site."
    ],
    "it": [
      "Un atelier-boutique condiviso da 5 creatrici fantasiose che vi espongono gioielli, accessori, oggetti decorativi e quadri. Tutte le creazioni presentate nell'area boutique sono fabbricate in loco."
    ],
    "fr": [
      "Un atelier-boutique partagé par 5 créatrices pleines d'idées qui y présentent bijoux, dessins, accessoires et objets de décoration. Toutes les créations présentées dans l'espace boutique sont fabriquées sur place."
    ],
    "es": [
      "Una boutique compartida por 5 ideas creativas completos que tienen joyas, accesorios, objetos de decoración y pinturas. Todas las creaciones presentadas en el área del taller se realizan en el sitio."
    ],
    "nl": [
      "Een workshopboetiek gedeeld door 5 fantasierijke ontwerpers, met sieraden, ontwerpen, accessoires en decoratieve artikelen. Alle creaties in de boetiek worden ter plekke gemaakt."
    ]
  },
