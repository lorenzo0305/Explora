  "rdfs:comment": {
    "de": [
      "Das Not a Beer wurde 2017 gegründet und hat sich als Referenz in der Craft-Beer-Szene in Grenoble etabliert. Das Not a Beer bietet lokale und internationale handwerklich gebraute Biere aller Art an, die bio, alkoholfrei und glutenfrei sind."
    ],
    "en": [
      "Founded in 2017, Not a Beer has established itself as a benchmark on Grenoble's craft beer scene. Not a Beer offers local and international craft beers of all types that are organic, alcohol-free and gluten-free."
    ],
    "it": [
      "Fondato nel 2017, Not a Beer si è affermato come punto di riferimento sulla scena della birra artigianale di Grenoble. Not a Beer offre birre artigianali locali e internazionali di tutti i tipi, biologiche, senza alcol e senza glutine."
    ],
    "fr": [
      "Fondé en 2017, le Not a Beer s'est installé comme une référence sur la scène de la bière artisanale à Grenoble. Le Not a Beer propose des bières artisanales locales ou internationales de tous types bio, sans alcool, sans gluten."
    ],
    "nl": [
      "Not a Beer werd opgericht in 2017 en heeft zichzelf gevestigd als een referentie in de ambachtelijke bierscene van Grenoble. Not a Beer biedt lokale en internationale ambachtelijke bieren van alle soorten die biologisch, alcoholvrij en glutenvrij zijn."
    ],
    "es": [
      "Fundada en 2017, Not a Beer se ha consolidado como un referente en el panorama de la cerveza artesanal de Grenoble. Not a Beer ofrece cervezas artesanales locales e internacionales de todo tipo, ecológicas, sin alcohol y sin gluten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Not A Beer"
    ]
  },
