  "rdfs:comment": {
    "de": [
      "Rocher de Comborcière RD 926.\r\nNatürlicher Felsen, ausgestattet mit 20 Routen aller Schwierigkeitsgrade (4 bis 6b+) bis zu 80m Höhenunterschied.\r\nSüdost-Ausrichtung, Fels: Gneis.\r\nDer Zugang ist kostenlos. Beschreibung im Tourismusbüro."
    ],
    "en": [
      "Rocher de Comborcière RD 926.\r\nNatural rock with 20 tracks of all levels (4 to 6b +) up to 80m in altitude.\r\nSouth-east, rock gneiss. Free access."
    ],
    "it": [
      "Rocher de Comborcière RD 926.\r\nRoccia naturale attrezzata con 20 vie di tutti i livelli (dal 4 al 6b+) fino a 80 m di dislivello.\r\nEsposizione sud-est, roccia: gneiss.\r\nAccesso libero. Descrizione presso l'Ufficio del Turismo."
    ],
    "fr": [
      "Rocher de Comborcière RD 926.\r\nRocher naturel équipé de 20 voies de tout niveau (4 à 6b+) jusqu'à 80m de dénivelé.\r\nExposition sud-est, rocher : gneiss.\r\nAccès gratuit. Descriptif à l'Office de Tourisme."
    ],
    "nl": [
      "Rots van Comborcière RD926. Natuurlijke\r\nrots voorzien van 20 routes voor ieder niveau\r\n(4 tot 6b+) tot 80m hoogteverschil. Zuidoostelijke\r\nligging, rots: gneiss. Gratis toegankelijk. Document en\r\nbeschrijving bij het VVV-kantoor."
    ],
    "es": [
      "Rocher de Comborcière RD 926.\r\nRoca natural equipada con 20 rutas de todos los niveles (4 a 6b+) hasta 80m de caída vertical.\r\nExposición sureste, roca: gneis.\r\nAcceso gratuito. Descripción en la Oficina de Turismo."
    ]
  },
