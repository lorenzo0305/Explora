  "rdfs:comment": {
    "de": [
      "Wellness-Massagen in Murat: Gönnen Sie sich eine erholsame Pause im Herzen des Cantal. Bewusste Berührung, Tiefenentspannung, Neuausrichtung. Individuelle Sitzungen in einem beruhigenden Rahmen. Nach Vereinbarung."
    ],
    "en": [
      "Well-being massages in Murat: treat yourself to a rejuvenating break in the heart of the Cantal. Conscious touch, deep relaxation, refocusing. Personalized sessions in soothing surroundings. By appointment only."
    ],
    "it": [
      "Massaggi benessere a Murat: concedetevi una pausa rigenerante nel cuore del Cantal. Tocco consapevole, rilassamento profondo, riorganizzazione. Sessioni personalizzate in un ambiente rilassante. Solo su appuntamento."
    ],
    "fr": [
      "Massages bien-être à Murat : offrez-vous une pause ressourçante au cœur du Cantal. Toucher conscient, relaxation profonde, recentrage. Séances personnalisées dans un cadre apaisant. Sur rendez-vous."
    ],
    "nl": [
      "Wellnessmassages in Murat: trakteer jezelf op een verjongende pauze in het hart van de Cantal. Bewuste aanraking, diepe ontspanning, heroriëntatie. Persoonlijke sessies in een rustgevende omgeving. Alleen op afspraak."
    ],
    "es": [
      "Masajes de bienestar en Murat: regálese una pausa rejuvenecedora en el corazón del Cantal. Tacto consciente, relajación profunda, desconcentración. Sesiones personalizadas en un entorno relajante. Con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Massage - Le Toucher du Papillon"
    ]
  },
