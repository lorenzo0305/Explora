  "rdfs:comment": {
    "de": [
      "Das gemütliche und familiäre Hotel** du Tétras-Lyre befindet sich im Zentrum des Dorfes Vassieux en Vercors in der Drôme. Das Hotel ist ideal für Sommer- und Winteraufenthalte geeignet."
    ],
    "en": [
      "This warm and welcoming inn is located in the heart of the village of Vassieux-en-Vercors. It is the perfect location for enjoying a break both in summer and winter as you can enjoy skiing, dog-sledding, hiking and mountain biking."
    ],
    "it": [
      "L'accogliente Hotel du Tétras-Lyre**, a conduzione familiare, si trova nel centro del villaggio di Vassieux en Vercors, nella Drôme. In una posizione ideale per soggiorni estivi e invernali, potrete praticare sci, sleddog, escursioni a piedi e in mountain bike."
    ],
    "fr": [
      "L'hôtel** du Tétras-Lyre chaleureux et familial est situé au centre du Village de Vassieux en Vercors, dans la  Drôme. Idéalement placé pour les séjours d'été et d'hiver, vous pratiquerez le ski, des sorties chiens de traineaux, la randonnée, le VTT."
    ],
    "es": [
      "El acogedor y familiar Hotel du Tétras-Lyre** está situado en el centro del pueblo de Vassieux en Vercors, en la Drôme. Idealmente situado para estancias de verano e invierno, podrá disfrutar del esquí, los trineos tirados por perros, el senderismo y la bicicleta de montaña."
    ],
    "nl": [
      "De gezellige en familiale Auberge ligt in het dorpscentrum van Vassieux-en-Vercors. Ideaal gelegen voor zomer- en winterverblijven, u kunt hier skiën, met sledehonden rijden, wandelen, mountainbiken"
    ]
  },
