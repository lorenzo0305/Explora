  "rdfs:comment": {
    "de": [
      "Öffnung der Außenanlagen nur zu den Tagen des Kulturerbes mit dem Thema 2026: Kulturerbe in Gefahr.\r\nDas Schloss Clusors befindet sich auf einer alten Motte gegenüber von Saint-Menoux und gegen den Wald von Bagnolet."
    ],
    "en": [
      "The exterior is open only for the Journées du Patrimoine, with the theme for 2026: Heritage in danger.\r\nChâteau de Clusors stands on an ancient motte facing Saint-Menoux and the Bagnolet forest."
    ],
    "it": [
      "L'esterno è aperto solo per le Giornate del Patrimonio, il cui tema per il 2026 è: Patrimonio in pericolo.\r\nIl castello di Clusors sorge su un'antica motta di fronte a Saint-Menoux e alla foresta di Bagnolet."
    ],
    "fr": [
      "Ouverture des extérieurs uniquement pour les Journées du Patrimoine avec pour thème en 2026 : Patrimoine en danger.\r\nLe château de Clusors est situé sur une ancienne motte face à Saint-Menoux et contre la forêt de Bagnolet."
    ],
    "es": [
      "El exterior sólo está abierto durante las Jornadas del Patrimonio, cuyo tema para 2026 es: Patrimonio en Peligro.\r\nEl castillo de Clusors se alza sobre una antigua muela frente a Saint-Menoux y el bosque de Bagnolet."
    ],
    "nl": [
      "De buitenkant is alleen open tijdens de Open Monumentendagen, met als thema voor 2026: Erfgoed in gevaar.\r\nChâteau de Clusors staat op een oude motte tegenover Saint-Menoux en het bos van Bagnolet."
    ]
  },
