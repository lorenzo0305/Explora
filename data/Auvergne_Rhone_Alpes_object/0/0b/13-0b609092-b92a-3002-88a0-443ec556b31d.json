  "rdfs:comment": {
    "de": [
      "La Magnanerie ist ein Veranstaltungsort für kulturelle und handwerkliche Events in Langeac, der in einem schönen alten Gebäude aus Saint-Roch-Steinen untergebracht ist."
    ],
    "en": [
      "La Magnanerie is a third-party venue for shows and cultural and craft events in Langeac, in a beautiful old building & built of Saint-Roch stone."
    ],
    "it": [
      "La Magnanerie è un locale di terze parti per spettacoli ed eventi culturali e artigianali a Langeac, ospitato in un bellissimo edificio antico in pietra di Saint-Roch."
    ],
    "fr": [
      "La Magnanerie est un tiers lieu de spectacles et de tenue d’évènements culturels et artisanal installé à Langeac dans une belle bâtisse ancienne & construite en pierres de Saint-Roch."
    ],
    "nl": [
      "La Magnanerie is een locatie van derden voor voorstellingen en culturele en ambachtelijke evenementen in Langeac, gevestigd in een prachtig oud gebouw van Saint-Roch-steen."
    ],
    "es": [
      "La Magnanerie es un lugar de espectáculos y actos culturales y artesanales para terceros en Langeac, ubicado en un bello edificio antiguo de piedra de Saint-Roch."
    ]
  },
