  "rdfs:comment": {
    "de": [
      "Eine gesicherte Rodelbahn mit einem ziemlich sanften Gefälle, sodass das Gleiten für Kleinkinder und große Kinder ein Vergnügen ist!"
    ],
    "en": [
      "A safe toboggan run so that sliding down the hill is fun for toddlers and older children alike!"
    ],
    "it": [
      "Una pista per slittini sicura, con una pendenza abbastanza dolce da rendere la scivolata un piacere sia per i più piccoli che per i più grandi!"
    ],
    "fr": [
      "Une piste de luge sécurisée avec une pente assez douce pour que la glisse soit un plaisir pour les tout-petits et les grands enfants !"
    ],
    "es": [
      "Una pista de trineo segura con una pendiente lo suficientemente suave como para que deslizarse sea un placer tanto para los niños pequeños como para los mayores"
    ],
    "nl": [
      "Een veilige rodelbaan met een helling die zacht genoeg is om het glijden leuk te maken voor zowel peuters als oudere kinderen!"
    ]
  },
