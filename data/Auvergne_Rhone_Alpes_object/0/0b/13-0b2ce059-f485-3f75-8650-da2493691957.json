  "rdfs:comment": {
    "de": [
      "Süße und herzhafte Crêpes, aber auch Salate und Wurst- und Käsebretter, die Sie im Freien oder in einem gemütlichen Innenraum genießen können."
    ],
    "en": [
      "Savoury and sweet crêpes, as well as salads and platters of cold meats and cheeses to enjoy outside or in a cosy interior."
    ],
    "it": [
      "Crêpes salate e dolci, ma anche insalate e taglieri di salumi e formaggi da gustare all'aperto o all'interno."
    ],
    "fr": [
      "Des crêpes salées et sucrées, mais aussi des salades et planches charcuterie et fromages à déguster en extérieur ou dans un intérieur chaleureux."
    ],
    "nl": [
      "Hartige en zoete crêpes, salades en schotels met vleeswaren en kazen om buiten of binnen van te genieten."
    ],
    "es": [
      "Crepes salados y dulces, así como ensaladas y tablas de embutidos y quesos para degustar al aire libre o en el interior."
    ]
  },
