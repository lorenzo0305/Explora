  "rdfs:comment": {
    "de": [
      "Ziegenkäse aus Rohmilch.\r\nRigotte de Condrieu AOP, Kästchen und Konserven mit Zickleinfleisch, Milchkonfitüre, Seifen aus Ziegenmilch.\r\nWenn Sie beim Melken zuschauen möchten, kommen Sie bitte um 16 Uhr."
    ],
    "en": [
      "Raw-milk goat cheeses.\r\nRigotte de Condrieu AOP, goat meat boxes and preserves, milk jam, goat's milk soaps.\r\nIf you'd like to watch the milking, come at 4pm."
    ],
    "it": [
      "Formaggi di capra a latte crudo.\r\nRigotte de Condrieu DOP, scatole e conserve di carne di capra, marmellata di latte, saponi di latte di capra.\r\nSe volete assistere alla mungitura, venite alle 16.00."
    ],
    "fr": [
      "Fromages de chèvre au lait cru.\r\nRigotte de Condrieu AOP, caissettes et conserves de viande de chevreau, confiture de lait, savons au lait de chèvre.\r\nSi vous souhaitez assister à la traite, venir à 16h."
    ],
    "es": [
      "Quesos de leche cruda de cabra.\r\nRigotte de Condrieu DOP, cajas y conservas de carne de cabra, mermelada de leche, jabones de leche de cabra.\r\nSi desea asistir al ordeño, venga a las 16 h."
    ],
    "nl": [
      "Kaas van rauwe geitenmelk.\r\nRigotte de Condrieu BOB, geitenvleesdozen en -conserven, melkjam, geitenmelkzepen.\r\nAls je het melken wilt zien, kom dan om 16.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des Pommeaux Blancs"
    ]
  },
