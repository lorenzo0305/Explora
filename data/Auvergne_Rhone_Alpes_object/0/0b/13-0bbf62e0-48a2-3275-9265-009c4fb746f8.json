  "rdfs:comment": {
    "de": [
      "ZUGANGSVERBOT 2025\r\nNach einem Erdrutsch in der Achse des Standorts Les Lames hat die Gemeinde ein AM für ein Zugangsverbot für den gesamten Berg Rachais erlassen.\r\n  \r\nSonnenschein und schönes Panorama mit abwechslungsreichen und interessanten Routen."
    ],
    "en": [
      "ACCESS PROHIBITED 2025\r\nFollowing a landslide in the axis of the Lames site, the commune has issued an AM prohibiting access to the entire Rachais mountain.\r\n  \r\nSunny and beautiful panorama, with varied and interesting routes."
    ],
    "it": [
      "ACCESSO VIETATO 2025\r\nA seguito di una frana nell'asse del sito di Lames, l'autorità locale ha emesso un'ordinanza che vieta l'accesso all'intera montagna di Rachais.\r\n  \r\nPanorami soleggiati e bellissimi, con percorsi variegati e interessanti."
    ],
    "fr": [
      "ACCES INTERDIT 2025\r\nSuite à un éboulement dans l’axe du site des Lames, la commune a pris un AM d’interdiction d’accès à toute la montagne du Rachais.\r\n  \r\nEnsoleillement et joli panorama, avec des voies variées et intéressantes."
    ],
    "nl": [
      "TOEGANG VERBODEN 2025\r\nNa een aardverschuiving in de as van de Lames-site heeft de lokale overheid een AM uitgevaardigd dat de toegang tot de hele Rachais-berg verbiedt.\r\n  \r\nZonnig en mooie uitzichten, met gevarieerde en interessante routes."
    ],
    "es": [
      "ACCESO PROHIBIDO 2025\r\nTras un corrimiento de tierras en el eje del sitio de Lames, la autoridad local ha emitido un AM que prohíbe el acceso a toda la montaña de Rachais.\r\n  \r\nVistas soleadas y hermosas, con rutas variadas e interesantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site d'escalade de la Bastille - Le Pèr'Gras"
    ]
  },
