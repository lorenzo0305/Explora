  "rdfs:comment": {
    "de": [
      "Aux Ducs de Bourbons lädt Sie zu einem raffinierten gastronomischen Erlebnis ein. Der Chefkoch ehrt eine traditionelle Küche, die mit Leidenschaft aus frischen und saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "Aux Ducs de Bourbons invites you to enjoy a refined gastronomic experience. The Chef honors traditional cuisine, passionately crafted from fresh seasonal produce."
    ],
    "it": [
      "Aux Ducs de Bourbons vi invita a vivere un'esperienza gastronomica raffinata. Lo chef propone una cucina tradizionale, preparata con passione utilizzando prodotti freschi di stagione."
    ],
    "fr": [
      "Aux Ducs de Bourbons vous invite à une expérience gastronomique raffinée. Le Chef met à l'honneur une cuisine de tradition, élaborée avec passion à partir de produits frais et de saison."
    ],
    "nl": [
      "Aux Ducs de Bourbons nodigt je uit om te genieten van een verfijnde gastronomische ervaring. De chef biedt een traditionele keuken, met passie bereid met verse seizoensproducten."
    ],
    "es": [
      "Aux Ducs de Bourbons le invita a disfrutar de una refinada experiencia gastronómica. El Chef ofrece una cocina tradicional, preparada con pasión con productos frescos de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Aux Ducs de Bourbon"
    ]
  },
