  "rdfs:comment": {
    "de": [
      "Überqueren Sie den Col du Petit Saint-Bernard und anschließend das Zentrum von Séez des Fußlaufs \"sur les Traces des Ducs de Savoie\" (auf den Spuren der Herzöge von Savoyen) im Rahmen des UTMB. Kommen Sie und feuern Sie diese mutigen Sportler an! Verpflegung mit Getränken für die Läufer im Dorfzentrum."
    ],
    "en": [
      "Ultra Trail du Mont Blanc passes through \"In the path of the Dukes of Savoie\" at the Little Saint Bernard Pass and at the center of Seez."
    ],
    "it": [
      "Passaggio del Col du Petit Saint-Bernard e poi il centro di Séez per la corsa a piedi \"sur les Traces des Ducs de Savoie\" nell'ambito dell'UTMB. Venite a fare il tifo per questi coraggiosi atleti! Ristoro per i corridori nel centro del paese."
    ],
    "fr": [
      "Passage au Col du Petit Saint-Bernard puis au centre de Séez de la course pédestre \"sur les Traces des Ducs de Savoie\" dans le cadre de l'UTMB. Venez encourager ces courageux sportifs ! Ravitaillement boissons pour les coureurs au centre du village."
    ],
    "nl": [
      "Passage van de Col du Petit Saint-Bernard en dan het centrum van Séez voor de voetwedstrijd \"sur les Traces des Ducs de Savoie\" als onderdeel van de UTMB. Kom deze moedige atleten aanmoedigen! Versnaperingen voor de lopers in het dorpscentrum."
    ],
    "es": [
      "Paso del Col du Petit Saint-Bernard y después el centro de Séez para la carrera a pie \"sur les Traces des Ducs de Savoie\" en el marco del UTMB. Venga a animar a estos valientes atletas Refrigerio para los corredores en el centro del pueblo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ultra Trail du Mont Blanc passes through"
    ],
    "fr": [
      "Passage du trail sur les traces des ducs de Savoie (TDS)"
    ]
  },
