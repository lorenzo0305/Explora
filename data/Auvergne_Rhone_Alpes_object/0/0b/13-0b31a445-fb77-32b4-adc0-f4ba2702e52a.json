  "rdfs:comment": {
    "de": [
      "Förderung des Olivenbaums und seiner Nebenprodukte: Empfang, Auskünfte und Faltblätter. Zentrum für Dokumentation. Kostenlose Ausstellung über französische Olivenbaumsorten und Verkostung von Olivenölen aus Frankreich. Fête de l'Olive piquée (Fest der gespickten Olive)."
    ],
    "en": [
      "Promotion of the olive tree and its by-products: reception, information and leaflets. Documentation center. Free exhibition on French olive varieties and tastings of French olive oils. Olive festival."
    ],
    "it": [
      "Promozione dell'olivo e dei prodotti derivati: accoglienza, informazioni e opuscoli. Centro di documentazione. Mostra gratuita sulle varietà di olivo francesi e degustazione di oli d'oliva francesi. Festival delle olive snocciolate."
    ],
    "fr": [
      "Promotion de l'olivier et produits dérivés : accueil, renseignements et dépliants. Centre de documentation. Exposition gratuite sur les variétés françaises d'olivier et dégustations des huiles d'olive de France. Fête de l'Olive piquée."
    ],
    "nl": [
      "Promotie van de olijfboom en zijn producten: ontvangst, inlichtingen en folders. Documentatiecentrum. Gratis expositie over de franse olijfsoorten en proeverij van olijfoliën van Frankrijk. Feest van de Olive piquée."
    ],
    "es": [
      "Promoción del olivo y los productos derivados: recepción, información y folletos. Centro de documentación. Exposición gratuita sobre las variedades de olivos franceses y degustación de aceites de oliva franceses. Festival de aceitunas sin hueso."
    ]
  },
  "rdfs:label": {
