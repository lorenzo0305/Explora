  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7d6dce08-cd24-30d5-8c97-80fbf305aab5",
      "dc:description": {
        "de": [
          "LA FLEUR AU FUSIL: FRAUEN UND EIN KRIEG\nCHANSONS CÔTÉ FEMME\nDI 11. NOVEMBER - 16H11 | AB 12 JAHREN LA MENUISERIE\n\nMit Les Jacquotte - photo credit Anzer centerblog\n\nSchicksale während des Großen Krieges: Lieder, Erzählungen und Zeugnisse in Theaterform, um eine Episode unserer Geschichte aus der Sicht der Frauen zu erzählen. Les Jacquottes kehren mit einem neuen Stück über die Situation der Frauen auf die Bühne zurück.\nAU POTCH"
        ],
        "en": [
          "LA FLEUR AU FUSIL: WOMEN AND WAR\nCHANSONS CÔTÉ FEMME\nTUESDAY, NOVEMBER 11 - 16H11 | AGES 12 AND UP LA MENUISERIE\n\nWith Les Jacquotte - photo credit Anzer centerblog\n\nEvocation of destinies during the Great War: songs, stories and testimonies put into theatrical form, to tell an episode of our history from the women's side. Les Jacquottes return to the stage for a new show on the status of women.\nAT THE POTCH"
        ],
        "it": [
          "LA FLEUR AU FUSIL: LE DONNE E LA GUERRA\nCHANSONS CÔTÉ FEMME\nMARTEDÌ 11 NOVEMBRE - ORE 16.11 | DAI 12 ANNI IN SU LA MENUISERIE\n\nCon Les Jacquotte - credito fotografico Anzer centerblog\n\nEvocare i destini delle donne durante la Grande Guerra: canzoni, storie e testimonianze messe in forma teatrale per raccontare un episodio della nostra storia dal punto di vista delle donne. Les Jacquottes tornano in scena per un nuovo spettacolo sulla condizione femminile.\nAL VASO"
        ],
        "fr": [
          "LA FLEUR AU FUSIL : DES FEMMES ET UNE GUERRE\nCHANSONS CÔTÉ FEMME\nMAR 11 NOVEMBRE - 16H11 | DÈS 12 ANS LA MENUISERIE\n\nAvec Les Jacquotte - crédit photo Anzer centerblog\n\nÉvocation de destins durant la grande guerre : Des chansons, des récits, des témoignages mis en forme théâtrale, pour raconter un épisode de notre histoire du côté des femmes. Les Jacquottes reviennent sur scène pour un nouveau spectacle autour de la condition féminine.\nAU POTCH"
        ],
        "nl": [
          "LA FLEUR AU FUSIL: VROUWEN EN OORLOG\nCHANSONS CÔTÉ FEMME\nDINSDAG 11 NOVEMBER - 16.11 UUR | VANAF 12 JAAR LA MENUISERIE\n\nMet Les Jacquotte - foto credit Anzer centrumblog\n\nHet lot van vrouwen tijdens de Grote Oorlog: liederen, verhalen en getuigenissen in theatrale vorm om het verhaal van een episode uit onze geschiedenis te vertellen vanuit het standpunt van de vrouw. Les Jacquottes keren terug naar het podium voor een nieuwe voorstelling over de status van de vrouw.\nAAN DE POTCH"
        ],
        "es": [
          "LA FLEUR AU FUSIL: LAS MUJERES Y LA GUERRA\nCHANSONS CÔTÉ FEMME\nMARTES 11 DE NOVIEMBRE - 16.11 H | A PARTIR DE 12 AÑOS LA MENUISERIE\n\nCon Les Jacquotte - foto Anzer centerblog\n\nEvocación de los destinos de las mujeres durante la Gran Guerra: canciones, historias y testimonios puestos en forma teatral para contar un episodio de nuestra historia desde el punto de vista de las mujeres. Les Jacquottes vuelven a escena para un nuevo espectáculo sobre la condición de la mujer.\nEN EL POTCH"
        ]
      },
