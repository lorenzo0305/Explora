  "rdfs:comment": {
    "de": [
      "Der Verein Les Fous d'Royans organisiert und verbreitet Aktivitäten (soziale, kulturelle, sportliche), die allen offen stehen, und entwickelt dabei die Verbindung zwischen lokalen Akteuren in einer Logik der Solidarität und Geselligkeit."
    ],
    "en": [
      "Les Fous d'Royans organizes and promotes social, cultural and sporting activities open to all, developing links between local players in a spirit of solidarity and conviviality."
    ],
    "it": [
      "Les Fous d'Royans organizza e promuove attività (sociali, culturali e sportive) aperte a tutti, sviluppando legami tra gli attori locali in uno spirito di solidarietà e convivialità."
    ],
    "fr": [
      "L'Association Les Fous d'Royans organise et diffuse des activités (sociales, culturelles, sportives) ouvertes à tous en développant le lien entre acteurs locaux dans une logique de solidarité et de convivialité."
    ],
    "es": [
      "Les Fous d'Royans organiza y promueve actividades (sociales, culturales y deportivas) abiertas a todos, desarrollando vínculos entre los actores locales en un espíritu de solidaridad y convivencia."
    ],
    "nl": [
      "Les Fous d'Royans organiseert en promoot activiteiten (sociaal, cultureel en sportief) die voor iedereen toegankelijk zijn en ontwikkelt banden tussen lokale spelers in een geest van solidariteit en gezelligheid."
    ]
  },
