  "rdfs:comment": {
    "de": [
      "\"Die Einheit von Körper und Geist\"\r\nKeramikerin, die mit Steingut und Porzellan arbeitet. Kurse und Praktikum zur Einführung in das Drehen. (Ziele: sich mit der Technik des Drehens vertraut machen)"
    ],
    "en": [
      "\"Unity between body and mind.\"\r\nCeramist working in stoneware and porcelain. Classes and introductory course in throwing. (Objectives: to become familiar with the technique of throwing)"
    ],
    "it": [
      "\"Unità tra corpo e spirito\"\r\nCeramista che lavora in gres e porcellana. Corsi e laboratori di lancio per principianti. (Obiettivi: familiarizzare con la tecnica del lancio)"
    ],
    "fr": [
      "\"L'unité entre le corps et l'esprit.\"\r\nCéramiste travaillant le grès et la porcelaine. Cours et stage d'initiation au tournage. (Objectifs : se familiariser avec la technique du tournage)"
    ],
    "es": [
      "\"La unidad entre el cuerpo y el espíritu\"\r\nCeramista que trabaja en gres y porcelana. Cursos y talleres de iniciación al lanzamiento. (Objetivos: familiarizarse con la técnica del lanzamiento)"
    ],
    "nl": [
      "\"Eenheid tussen lichaam en geest.\"\r\nKeramist die werkt in steengoed en porselein. Cursussen en workshops voor beginners in het werpen. (Doelstellingen: vertrouwd raken met de techniek van het werpen)"
    ]
  },
  "rdfs:label": {
