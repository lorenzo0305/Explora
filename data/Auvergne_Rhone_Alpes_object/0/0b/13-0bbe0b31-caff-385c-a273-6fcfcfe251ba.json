  "rdfs:comment": {
    "de": [
      "ESI ist ein Spezialist für Einzelunterricht. Die Treffpunkte sind flexibel in allen Plagne. Gruppenunterricht in kleinen Gruppen, Videos und Medaillen werden angeboten.\r\nSnowboard-Einführung, Sitzung abseits der Piste"
    ],
    "en": [
      "The specialists in privat lessons. Meeting point anywhere in la Plagne, our main meeting point is in Plagne Centre.\r\nGroup lessons : small groups with English speaking instructors, free video and badges. \r\nSnowboard taster and off piste sessions"
    ],
    "it": [
      "ESI è specializzata in lezioni private. I punti di incontro sono flessibili in tutte le zone di Plagne. Lezioni collettive in piccoli gruppi, video e medaglie.\r\nIniziazione allo snowboard, sessione fuoripista"
    ],
    "fr": [
      "ESI est un spécialiste des cours particuliers. Les points de rendez-vous sont flexibles dans toutes les Plagne. Cours collectifs en petits groupes, vidéos et médailles offertes.\r\nInitiation snowboard, session hors piste"
    ],
    "nl": [
      "ESI is gespecialiseerd in privé lessen.  De punten van bijeenkomst zijn flexibel in gans Plagne.  Groepslessen in kleine groepen, video's en aangeboden medailles.\r\nInitiatie snowboard, sessie off-track."
    ],
    "es": [
      "ESI es especialista en clases particulares. Los puntos de encuentro son flexibles en todas las zonas de Plagne. Se ofrecen clases en grupos reducidos, vídeos y medallas.\r\nIniciación al snowboard, sesión fuera de pista"
    ]
  },
