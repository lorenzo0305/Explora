  "rdfs:comment": {
    "de": [
      "Dieses Bergrestaurant an der Bergstation der Seilbahn Mont-Rond empfängt Sie zu den Öffnungszeiten der Seilbahnen im Sommer wie im Winter. Es wird Selbstbedienung angeboten bis 15 Uhr."
    ],
    "en": [
      "This mountain restaurant located at the arrival station of the telecom of MontRond will welcome you to the opening hours of gondolas summer and winter.. Self-service (until 3 pm)."
    ],
    "it": [
      "Questo ristorante d'alta quota, situato presso la stazione di arrivo della funivia del Mont-Rond, è aperto quando le funivie sono in funzione in estate e in inverno. Self-service fino alle 15:00."
    ],
    "fr": [
      "Ce restaurant d'altitude situé à la gare d'arrivée du télécombi du Mont-Rond vous accueille aux horaires d'ouverture des télécabines été comme hiver. Self-service jusqu'à 15h."
    ],
    "es": [
      "Este restaurante de altura, situado en la estación de llegada del teleférico del Mont-Rond, está abierto cuando funcionan los teleféricos, tanto en verano como en invierno. Autoservicio hasta las 15 h."
    ],
    "nl": [
      "Dit hooggelegen restaurant bij het aankomststation van de Mont-Rond kabelbaan is geopend wanneer de kabelbanen in bedrijf zijn, zowel in de zomer als in de winter. Zelfbediening tot 15.00 uur."
    ]
  },
