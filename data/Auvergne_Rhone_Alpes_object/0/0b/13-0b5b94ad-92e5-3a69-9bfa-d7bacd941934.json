  "rdfs:comment": {
    "de": [
      "Egal, ob Sie Anfänger oder Fortgeschrittener sind, die Ecuries d'Amarel begrüßen Sie in einer herzlichen Umgebung, 15 Minuten von Villefranche-sur-Saône, 1 Stunde von der Schweiz und 45 Minuten von Lyon entfernt."
    ],
    "en": [
      "Whether you are a beginner or an expert, the Ecuries d'Amarel welcome you in a warm setting 15 minutes from Villefranche-sur-Saône, 1 hour from Switzerland and 45 minutes from Lyon."
    ],
    "it": [
      "Che siate principianti o esperti, le Ecuries d'Amarel vi offrono un'accoglienza calorosa e amichevole a 15 minuti da Villefranche-sur-Saône, a 1 ora dalla Svizzera e a 45 minuti da Lione."
    ],
    "fr": [
      "Que vous soyez débutant ou confirmé, les Ecuries d'Amarel vous accueillent dans un cadre chaleureux à 15 minutes de Villefranche-sur-Saône, 1 heure de la Suisse et 45 min de Lyon."
    ],
    "es": [
      "Tanto para principiantes como para jinetes experimentados, las Ecuries d'Amarel ofrecen una acogida cálida y acogedora a 15 minutos de Villefranche-sur-Saône, a 1 hora de Suiza y a 45 minutos de Lyon."
    ],
    "nl": [
      "Of je nu een beginner of een ervaren ruiter bent, de Ecuries d'Amarel bieden een warm en vriendelijk welkom op 15 minuten van Villefranche-sur-Saône, 1 uur van Zwitserland en 45 minuten van Lyon."
    ]
  },
  "rdfs:label": {
    "en": [
      "Riding stable \"Les Ecuries d'Amarel\""
    ],
    "fr": [
      "Centre équestre \"Les Ecuries d'Amarel\""
    ]
  },
