  "rdfs:comment": {
    "de": [
      "Dank der Studios W?t? Worksh, die für die Szenerie der Herr der Ringe-Trilogie verantwortlich sind, erleben Sie eine emotionale, immersive Erfahrung, die die Befreiung der Stadt Le Quesnoy durch die Rifle Brigade unter der Führung von Leutnant Averill nachzeichnet."
    ],
    "en": [
      "Thanks to Studios W?t? Worksh, responsible for the set design of the Lord of the Rings trilogy, offer an immersive, emotionally-charged experience retracing the liberation of the town of Le Quesnoy by the Rifle Brigade led by Lieutenant Averill."
    ],
    "it": [
      "Grazie agli Studios W?t? Worksh, che hanno realizzato le scenografie della trilogia del Signore degli Anelli, proponiamo un'esperienza coinvolgente ed emotiva che racconta la liberazione della città di Le Quesnoy da parte della Brigata Fucilieri guidata dal tenente Averill."
    ],
    "fr": [
      "Grâce aux Studios Wētā Worksh a qui l'on doit la scénographie de la trilogie du Seigneur des anneaux, vivez une expérience immersive toute en émotion  retraçant la libération de la ville du Quesnoy par la rifle Brigade emmenée par le lieutenant Averill."
    ],
    "es": [
      "Gracias a Studios W?t? Worksh, creadores de la escenografía de la trilogía de El Señor de los Anillos, ofrecen una experiencia inmersiva y cargada de emoción que narra la liberación de la ciudad de Le Quesnoy por la Brigada de Fusileros dirigida por el teniente Averill."
    ],
    "nl": [
      "Dankzij Studios W?t? Worksh, die de decors voor de Lord of the Rings-trilogie ontwierpen, bieden we een meeslepende, emotioneel geladen ervaring die de bevrijding van de stad Le Quesnoy door de Rifle Brigade onder leiding van luitenant Averill vertelt."
    ]
  },
  "rdfs:label": {
