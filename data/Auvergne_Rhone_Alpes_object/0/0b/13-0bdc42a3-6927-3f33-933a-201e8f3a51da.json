  "rdfs:comment": {
    "de": [
      "Anbau von Saisonblumen aus biologischem Anbau. Frische Blumen und Trockenblumen. Kreationen aus Blumen. Verkauf an Privatpersonen und Gewerbetreibende. Sie können Blumensträuße bestellen, um jeden Moment Ihres Lebens zu verschönern!"
    ],
    "en": [
      "Organically grown seasonal flowers. Fresh and dried flowers. Floral creations. Sales to individuals and professionals. You can order bouquets to embellish every moment of your life!"
    ],
    "it": [
      "Fiori biologici di stagione. Fiori freschi e secchi. Creazioni floreali. Vendita a privati e professionisti. Potete ordinare bouquet per abbellire ogni momento della vostra vita!"
    ],
    "fr": [
      "Culture de fleurs de saison en agriculture biologique. Fleurs fraîches et fleurs séchées. Créations florales. Vente aux particuliers et aux professionnels. Vous pouvez commander des bouquets pour embellir tous les moments de votre vie !"
    ],
    "es": [
      "Flores ecológicas de temporada. Flores frescas y secas. Creaciones florales. Venta a particulares y profesionales. Puede encargar ramos para embellecer cada momento de su vida"
    ],
    "nl": [
      "Biologische seizoensbloemen. Verse en gedroogde bloemen. Bloemcreaties. Verkoop aan particulieren en professionals. U kunt boeketten bestellen om elk moment van uw leven te verfraaien!"
    ]
  },
  "rdfs:label": {
