  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Haus Richard und seine Ölmühle, in der gastronomische Öle (Walnuss, Haselnuss, gerösteter Raps) hergestellt werden. Die Geschichte des Hauses Richard wird Ihnen bei einer Besichtigung unserer Mühle erzählt, gefolgt von einer Verkostung der Öle aus unseren vier Mühlen."
    ],
    "en": [
      "Come and discover Maison Richard and its gourmet oil mill (walnut, hazelnut, roasted rapeseed). The history of Maison Richard will be explained during a tour of our mill. After that, a tasting session is offered to taste the oils produced in our 4 mills."
    ],
    "it": [
      "Venite a scoprire la Maison Richard e il suo frantoio gourmet (noce, nocciola, colza tostata). La storia della Maison Richard vi sarà raccontata durante un tour del nostro frantoio, seguito da una degustazione di oli dei nostri 4 frantoi."
    ],
    "fr": [
      "Venez découvrir la maison Richard ainsi que son moulin à huiles gastronomiques (noix, noisette, colza grillé). L’histoire de la Maison Richard vous sera contée au cours d’une visite de notre moulin, suivie par une dégustation des huiles de nos 4 moulins."
    ],
    "es": [
      "Venga a descubrir la Maison Richard y su almazara gourmet (nuez, avellana, colza tostada). La historia de la Maison Richard le será contada durante una visita a nuestra almazara, seguida de una degustación de aceites de nuestras 4 almazaras."
    ],
    "nl": [
      "Kom het Maison Richard en zijn molen voor gastronomische olie ontdekken (walnoot, hazelnoot, geroosterd koolzaad). De geschiedenis van Maison Richard wordt u verteld tijdens een rondleiding door onze molen, gevolgd door een proeverij van oliën uit onze 4 molens."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite du moulin à huile - Huilerie Richard"
    ]
  },
