  "rdfs:comment": {
    "de": [
      "Musiktheater über Brassens: Embrasse-les tous, dédicace aux femmes von Georges B.\r\nEine kulturelle und humorvolle Show, um Georges Brassens (wieder) zu entdecken. Mit Thierry Deauplais, Schauspieler, Sänger und Gitarrist."
    ],
    "en": [
      "Musical theater about Brassens: Embrasse-les toutes, a dedication to the women of Georges B.\r\nA cultural and humorous show to (re)discover Georges Brassens. With Thierry Deauplais, actor-singer-guitarist."
    ],
    "it": [
      "Teatro musicale su Brassens: Embrasse-les toutes, una dedica alle donne di Georges B.\r\nUno spettacolo culturale e umoristico per (ri)scoprire Georges Brassens. Con Thierry Deauplais, attore-cantante-chitarrista."
    ],
    "fr": [
      "Théâtre musical sur Brassens  : Embrasse-les toutes, dédicace aux femmes de Georges B. \r\nUn spectacle culturel et humoristique pour (re)découvrir Georges Brassens. Avec Thierry Deauplais, comédien-chanteur-guitariste."
    ],
    "es": [
      "Teatro musical sobre Brassens: Embrasse-les toutes, una dedicatoria a las mujeres de Georges B.\r\nUn espectáculo cultural y humorístico para (re)descubrir a Georges Brassens. Con Thierry Deauplais, actor-cantante-guitarrista."
    ],
