  "rdfs:comment": {
    "de": [
      "Geführte Innen- und Außenbesichtigung dieses seltenen und typischen Ensembles der Bourbonen-Architektur des 15., 16. und 17. Jahrhunderts: das von Wassergräben umgebene Schloss aus dem 15. Jahrhundert, der Wachsaal, die Kapelle und die Scheune aus dem 16."
    ],
    "en": [
      "Guided tour of the interior and exterior of this rare ensemble typical of 15th, 16th and 17th-century Bourbonnais architecture: the 15th-century château surrounded by a moat, the guard room, the chapel and the 16th-century barn."
    ],
    "it": [
      "Visita guidata all'interno e all'esterno di questo raro insieme tipico dell'architettura borbonica del XV, XVI e XVII secolo: il castello del XV secolo circondato da un fossato, la sala delle guardie, la cappella e il granaio del XVI secolo."
    ],
    "fr": [
      "Visite guidée de l'intérieur et de l'extérieur de cet ensemble rare et typique de l'architecture bourbonnaise des XVe, XVIe et XVIIe siècles : le château du XVe entouré de douves en eaux, la salle des gardes, la chapelle et la grange du XVIe."
    ],
    "es": [
      "Visita guiada del interior y el exterior de este raro conjunto típico de la arquitectura Bourbonnais de los siglos XV, XVI y XVII: el castillo del siglo XV rodeado por un foso, la sala de guardia, la capilla y el granero del siglo XVI."
    ],
    "nl": [
      "Rondleiding door het interieur en exterieur van dit zeldzame ensemble dat typisch is voor de 15e, 16e en 17e-eeuwse Bourbonnais-architectuur: het 15e-eeuwse kasteel omgeven door een slotgracht, de wachtkamer, de kapel en de 16e-eeuwse schuur."
    ]
  },
  "rdfs:label": {
