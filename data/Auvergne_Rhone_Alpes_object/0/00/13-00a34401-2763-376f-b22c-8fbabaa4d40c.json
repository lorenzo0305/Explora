  "rdfs:comment": {
    "de": [
      "Die Trail-Schule in Thônes hat es sich zur Aufgabe gemacht, Trail Running zu unterrichten, zu trainieren und zu betreuen, unabhängig vom Niveau der Teilnehmer."
    ],
    "en": [
      "The mission of the Thônes Trail School is to teach, train and supervise Trail Running at all levels."
    ],
    "it": [
      "La missione della Thônes Trail School è insegnare, formare e supervisionare il trail running a tutti i livelli."
    ],
    "fr": [
      "L'école de Trail de Thônes a pour mission l'enseignement, l'entraînement et l'encadrement du Trail Running quelque soit le niveau du pratiquant."
    ],
    "es": [
      "La misión de la Escuela de Trail de Thônes es enseñar, formar y supervisar el Trail Running a todos los niveles."
    ],
    "nl": [
      "De missie van de Thônes Trail School is het onderwijzen, trainen en begeleiden van Trail Running op alle niveaus."
    ]
  },
