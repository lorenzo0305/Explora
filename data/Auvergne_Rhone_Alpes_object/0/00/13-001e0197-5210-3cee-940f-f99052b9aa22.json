  "rdfs:comment": {
    "de": [
      "Komplett renoviertes Berghotel: vom Einzelzimmer bis zur Familiensuite mit 6 Plätzen. Idealer Ort für Etappen und Aufenthalte mit der Familie oder einer Gruppe. Geräumige Zimmer von 18 bis 40m², komplett ausgestattet: WIFI, TV, Badezimmer und separates WC."
    ],
    "en": [
      "Completely renovated mountain hotel: from single rooms to 6-person family suites. The ideal place for a stopover or a family or group stay. Spacious rooms from 18 to 40m², fully equipped with WIFI, TV, separate bathroom and toilet."
    ],
    "it": [
      "Hotel di montagna completamente rinnovato: dalle camere singole alle suite familiari da 6 posti. Il luogo ideale per una sosta o un soggiorno in famiglia o in gruppo. Camere spaziose da 18 a 40 m², completamente attrezzate: WIFI, TV, bagno e WC separati."
    ],
    "fr": [
      "Hôtel de montagne entièrement rénové : de la chambre single à la suite familiale de 6 places. Lieu idéal pour étape et séjour en famille ou groupe. Chambres spacieuses de 18 à 40m² entièrement équipée : WIFI, TV, salle de bains et Wc séparés."
    ],
    "nl": [
      "Volledig gerenoveerd berghotel: van eenpersoonskamers tot 6-persoons familiesuites. De ideale plek voor een tussenstop of een familie- of groepsverblijf. Ruime kamers van 18 tot 40m², van alle gemakken voorzien: WIFI, TV, aparte badkamer en WC."
    ],
    "es": [
      "Hotel de montaña completamente renovado: desde habitaciones individuales hasta suites familiares de 6 plazas. El lugar ideal para una escala o una estancia en familia o en grupo. Amplias habitaciones de 18 a 40 m², totalmente equipadas: WIFI, TV, cuarto de baño y WC independientes."
    ]
  },
