  "rdfs:comment": {
    "de": [
      "Das Hotel und Restaurant Campanile in Maubeuge empfängt Sie in einer modernen und beruhigenden Umgebung, die zum Entspannen einlädt. Es verfügt über 39 Zimmer, die mit einem eigenen Bad mit Dusche oder Badewanne ausgestattet sind. Jedes Zimmer verfügt über einen Schreibtisch, einen Wecker, kostenloses WLAN+ und einen Fernseher."
    ],
    "en": [
      "The hotel restaurant Campanile de Maubeuge welcomes you in a contemporary and soothing setting, conducive to rest. It has 39 rooms equipped with a private bathroom with shower or bathtub. Each room has a desk, alarm clock, free wifi+ connection and a TV."
    ],
    "it": [
      "Il Campanile Hotel Restaurant di Maubeuge vi accoglie in un ambiente contemporaneo e rilassante, favorevole al riposo. Dispone di 39 camere dotate di bagno privato con doccia o vasca. Ogni camera è dotata di scrivania, sveglia, connessione Wi-Fi gratuita e TV."
    ],
    "fr": [
      "L'hôtel restaurant Campanile de Maubeuge vous accueille dans un cadre contemporain et apaisant, propice au repos. Il compte 39 chambres pourvues d'une salle de bain privative avec douche ou baignoire. Chacune des chambres possède un coin bureau, un réveil, une connexion wifi+ gratuite et une télévision."
    ],
    "nl": [
      "Het Campanile Hotel Restaurant in Maubeuge verwelkomt u in een modern en rustgevend kader dat bevorderlijk is voor de rust. Het beschikt over 39 kamers met een eigen badkamer met douche of bad. Elke kamer heeft een bureau, een wekker, gratis WiFi en een televisie."
    ],
    "es": [
      "El Campanile Hotel Restaurant de Maubeuge le da la bienvenida en un ambiente contemporáneo y relajante, propicio para el descanso. Dispone de 39 habitaciones equipadas con cuarto de baño privado con ducha o bañera. Cada habitación dispone de escritorio, despertador, conexión Wi-Fi gratuita y TV."
    ]
  },
