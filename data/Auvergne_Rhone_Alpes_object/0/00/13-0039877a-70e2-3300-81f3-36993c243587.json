  "rdfs:comment": {
    "de": [
      "Der Bürgermeister von Félines heißt Herr Philippe MEYZONET\r\nDie Gemeinde Félines gehört zur Communauté d'agglomération du Puy-en-Velay und ist eine Gemeinde im regionalen Naturpark Livradois-Forez."
    ],
    "en": [
      "The mayor of Félines is Philippe MEYZONET\r\nThe commune of Félines is part of the Communauté d'agglomération du Puy-en-Velay and a commune of the Livradois-Forez Regional Nature Park."
    ],
    "it": [
      "Il sindaco di Félines è Philippe MEYZONET\r\nIl comune di Félines fa parte della Communauté d'agglomération du Puy-en-Velay ed è un comune del Parco naturale regionale Livradois-Forez."
    ],
    "fr": [
      "Le maire de Félines se nomme Monsieur Philippe MEYZONET \r\nLa commune de Félines fait partie de la Communauté d'agglomération du Puy-en-Velay et est une commune du parc naturel régional Livradois-Forez."
    ],
    "es": [
      "El alcalde de Félines es Philippe MEYZONET\r\nEl municipio de Félines forma parte de la Communauté d'agglomération du Puy-en-Velay y es un municipio del Parque Natural Regional de Livradois-Forez."
    ],
    "nl": [
      "De burgemeester van Félines is Philippe MEYZONET\r\nDe gemeente Félines maakt deel uit van de Communauté d'agglomération du Puy-en-Velay en is een gemeente van het Regionale Natuurpark Livradois-Forez."
