  "rdfs:comment": {
    "de": [
      "Willkommen im Atelier du Coin! Wie der Name schon sagt, befindet sich dieses kleine Geschäft in einer Straßenecke am unteren Ende des Viertels Crêt de Roc."
    ],
    "en": [
      "Welcome to Atelier du Coin! As the name suggests, this little shop is located on a street corner in the Crêt de Roc district."
    ],
    "it": [
      "Benvenuti all'Atelier du Coin! Come suggerisce il nome, questo piccolo negozio si trova all'angolo di una strada in fondo al quartiere di Crêt de Roc."
    ],
    "fr": [
      "Bienvenue à l’Atelier du Coin ! Comme son nom le laisse entendre, ce petit commerce est situé dans un coin de rue, en bas du quartier du Crêt de Roc."
    ],
    "es": [
      "¡Bienvenido al Atelier du Coin! Como su nombre indica, esta pequeña tienda se encuentra en la esquina de una calle del barrio de Crêt de Roc."
    ],
