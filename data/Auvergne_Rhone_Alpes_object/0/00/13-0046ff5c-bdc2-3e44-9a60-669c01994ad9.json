  "rdfs:comment": {
    "de": [
      "Mit Blick auf das Maronne-Tal steht das Haus seit nunmehr drei Generationen dem größten Vulkan Europas gegenüber. Es verfügt über 15 geräumige Zimmer, eine gepflegte regionale Küche, ein Spa und eine Panoramaterrasse mit Blick auf die Landschaft."
    ],
    "en": [
      "15 renovated large bedrooms - flat screen television, phone, safety deposit box and wifi -  one bedroom is accessible for disabled people. Comfortable hotel built along the ramparts with a view of the mountains."
    ],
    "it": [
      "Affacciato sulla valle della Maronne, l'hotel si trova di fronte al vulcano più grande d'Europa da 3 generazioni. Vanta 15 camere spaziose, una raffinata cucina regionale, un centro benessere e una terrazza panoramica con vista sulla campagna."
    ],
    "fr": [
      "Surplombant la vallée de la Maronne, l'établissement fait face au plus vaste volcan d'Europe depuis maintenant 3 générations. Il est doté de 15 chambres spacieuses, une cuisine régionale soignée, un spa, une terrasse panoramique ouverte sur la campagne."
    ],
    "nl": [
      "Het hotel kijkt uit over de Maronne-vallei en staat al 3 generaties tegenover de grootste vulkaan van Europa. Het heeft 15 ruime kamers, een verfijnde regionale keuken, een spa en een panoramisch terras met uitzicht op het platteland."
    ],
    "es": [
      "Con vistas al valle del Maronne, el hotel lleva 3 generaciones frente al volcán más grande de Europa. Dispone de 15 amplias habitaciones, cocina regional, spa y terraza panorámica con vistas al campo."
    ]
  },
