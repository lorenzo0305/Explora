  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet Ihnen eine große Auswahl an Romanen, Comics, Mangas, Zeitschriften, CDs und DVDs. Um Ihre Recherchen zu erleichtern, steht Ihnen hier ein Computerarbeitsplatz zur Verfügung."
    ],
    "en": [
      "The media library offers a wide selection of novels, comics, mangas, magazines, CDs and DVDs. A computer workstation is available for your research."
    ],
    "it": [
      "La mediateca offre una vasta gamma di romanzi, fumetti, manga, riviste, CD e DVD. Una postazione informatica è disponibile per aiutarvi nelle vostre ricerche."
    ],
    "fr": [
      "La médiathèque vous propose un large choix de romans, bandes dessinées, mangas, magazines, CD et DVD. Dans ce lieu, pour faciliter vos recherches un poste informatique est à votre disposition."
    ],
    "es": [
      "La mediateca ofrece una amplia gama de novelas, cómics, mangas, revistas, CD y DVD. Hay un puesto informático a su disposición para ayudarle en sus investigaciones."
    ],
    "nl": [
      "De mediatheek biedt een ruim aanbod aan romans, stripboeken, manga's, tijdschriften, cd's en dvd's. Er is een computerstation beschikbaar om je te helpen met je onderzoek."
    ]
  },
