  "rdfs:comment": {
    "de": [
      "Parkplatz in LAutin\r\nBefindet sich gegenüber dem Rathaus des Dorfes.\r\nParkverbot jeden Freitagabend 18H bis Samstag um 15H wegen des Marktes."
    ],
    "en": [
      "LAutin parking lot\r\nOpposite the village hall\r\nNo parking every Friday evening at 6 p.m. to Saturday at 3 p.m. due to the market."
    ],
    "it": [
      "Parcheggio di LAutin\r\nSituato di fronte al municipio\r\nDivieto di sosta dal venerdì sera alle 18.00 al sabato alle 15.00 a causa del mercato."
    ],
    "fr": [
      "Parking de LAutin \r\nSitué en face de la Mairie du village \r\nInterdiction de stationner tous les vendredis soir 18H au samedis à 15h en raison du marché."
    ],
    "es": [
      "Parking de LAutin\r\nSituado frente al ayuntamiento\r\nNo se puede aparcar desde el viernes a las 6 de la tarde hasta el sábado a las 3 de la tarde debido al mercado."
    ],
    "nl": [
      "LAutin parkeerplaats\r\nGelegen tegenover het dorpshuis\r\nGeen parkeergelegenheid elke vrijdagavond om 18.00 uur tot zaterdag om 15.00 uur vanwege de markt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parking de l'Autin"
    ]
  },
