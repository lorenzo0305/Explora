  "rdfs:comment": {
    "de": [
      "Gehen Sie mit den Flugzeugen des Aero-Club de l'Ardèche in die Luft: Flug über die Schluchten der Ardèche mit dem Flugzeug und Flugschule für Flugzeugpiloten."
    ],
    "en": [
      "Take to the air with the aeroclub de l'Ardèche: Fly over the gorges de l'Ardèche in an airplane and take part in an airplane piloting school."
    ],
    "it": [
      "Volare in cielo con l'aeroclub de l'Ardèche: sorvolate le gole dell'Ardèche in aeroplano e partecipate alla scuola di pilotaggio di aeroplani."
    ],
    "fr": [
      "Prenez l'air avec les avions de aéro-club de l'Ardèche : Survol des gorges de l'Ardèche en avion et Ecole de Pilotage Avion."
    ],
    "nl": [
      "Vlieg de lucht in met de vliegtuigen van de vliegclub van de Ardèche: Vlieg over de kloven van de Ardèche in een vliegtuig en maak een vlucht in een vliegtuig."
    ],
    "es": [
      "Surque los cielos con el aeroclub de l'Ardèche: sobrevuele las gargantas del Ardèche en avión y participe en la escuela de pilotaje de aviones."
    ]
  },
