  "rdfs:comment": {
    "de": [
      "Diese assoziative Galerie von Künstlern und Kunsthandwerkern bietet von Mai bis September Ausstellungen an. Jede Monatsausstellung umfasst mehrere Aussteller: Malerei, Bildhauerei, Keramik, Fadenkunst, Fotografie und viele andere, die es zu entdecken gilt."
    ],
    "en": [
      "This gallery of artists and craftspeople offers exhibitions from May to September. Each monthly exhibition features several exhibitors: painting, sculpture, ceramics, wire arts, photography and many others to discover."
    ],
    "it": [
      "Questa galleria di artisti e artigiani organizza mostre da maggio a settembre. Ogni mostra mensile presenta diversi espositori: pittura, scultura, ceramica, arte del filo, fotografia e molti altri da scoprire."
    ],
    "fr": [
      "Cette galerie associative d'artistes et artisans propose des expositions de mai à septembre. Chaque exposition mensuelle regroupe plusieurs exposants : peinture, sculpture, céramique, arts du fil, photographie et bien d'autres à découvrir."
    ],
    "es": [
      "Esta galería de artistas y artesanos organiza exposiciones de mayo a septiembre. Cada exposición mensual cuenta con varios expositores: pintura, escultura, cerámica, artes del alambre, fotografía y muchos otros por descubrir."
    ],
    "nl": [
      "Deze galerie voor kunstenaars en ambachtslieden organiseert tentoonstellingen van mei tot september. Elke maand zijn er verschillende exposanten: schilderkunst, beeldhouwkunst, keramiek, draadkunst, fotografie en nog veel meer om te ontdekken."
    ]
  },
