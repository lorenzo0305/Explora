  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte und die Ikonografie der Verveine du Velay an einem atypischen Ort. Ausstellung, Verkostung und Laden im Herzen von Le Puy-en-Velay.\r\nEmpfang von Gruppen auf Reservierung."
    ],
    "en": [
      "Discover the history and iconography of the Velay verbena in an atypical place. Exhibition, tasting and store in the heart of Puy-en-Velay.\r\nGroups welcome upon reservation."
    ],
    "it": [
      "Scoprite la storia e l'iconografia della Verveine du Velay in un luogo atipico. Esposizione, degustazione e negozio nel cuore di Puy-en-Velay.\r\nGruppi benvenuti su prenotazione."
    ],
    "fr": [
      "Découvrez l'histoire et l'iconographie de la Verveine du Velay dans un lieu atypique. Exposition, dégustation et boutique au cœur du Puy-en-Velay.\r\nAccueil groupes sur réservation."
    ],
    "nl": [
      "Ontdek de geschiedenis en de iconografie van Verveine du Velay op een atypische plek. Tentoonstelling, proeverij en winkel in het hart van Puy-en-Velay.\r\nGroepen zijn welkom op reservering."
    ],
    "es": [
      "Descubra la historia y la iconografía de Verveine du Velay en un lugar atípico. Exposición, degustación y tienda en el corazón de Puy-en-Velay.\r\nSe admiten grupos previa reserva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace Pagès Maison de la Verveine du Velay"
    ]
  },
