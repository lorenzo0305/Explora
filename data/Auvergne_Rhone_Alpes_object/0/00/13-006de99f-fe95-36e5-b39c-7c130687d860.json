  "rdfs:comment": {
    "de": [
      "Im Herzen einer alten Textilfabrik, die im zeitgenössischen Stil renoviert wurde, bieten Ihnen Fabien und Carine Gauthier eine leidenschaftliche, raffinierte und saisonal wechselnde Küche an."
    ],
    "en": [
      "In the heart of a former textile factory, renovated in a contemporary sense, Fabien and Carine Gauthier welcome you with their refined cuisine based on local fresh products, cooked with passion."
    ],
    "it": [
      "Nel cuore di un'antica fabbrica tessile ristrutturata con spirito contemporaneo, Fabien e Carine Gauthier vi propongono una cucina raffinata e appassionata che si rinnova a seconda delle stagioni."
    ],
    "fr": [
      "Au cœur d'une ancienne usine textile rénovée dans un esprit contemporain, Fabien et Carine Gauthier vous proposent une cuisine de passion, raffinée et renouvelée au fil des saisons."
    ],
    "nl": [
      "In het hart van een oude textielfabriek, gerenoveerd in een hedendaagse geest, bieden Fabien en Carine Gauthier u een keuken vol passie, verfijnd en vernieuwd met de seizoenen."
    ],
    "es": [
      "En el corazón de una antigua fábrica textil renovada con espíritu contemporáneo, Fabien y Carine Gauthier le ofrecen una cocina refinada y apasionada que se renueva según las estaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier Rongefer"
    ]
  },
