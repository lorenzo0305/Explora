  "rdfs:comment": {
    "de": [
      "In der Schneezeit ist der Empfang für Touristen im Chalet de la Croix de Chaubouret an der Schneefront gewährleistet.\r\nWenn kein Schnee liegt, ist der Empfang für Touristen im Büro im Dorfzentrum von Le Bessat."
    ],
    "en": [
      "When there's snow, tourists are welcomed at the Chalet de la Croix de Chaubouret, on the snow front.\r\nIn the absence of snow, the tourist office is located in the village center of Le Bessat."
    ],
    "it": [
      "In caso di neve, i turisti sono accolti allo Chalet de la Croix de Chaubouret, sul fronte della neve.\r\nIn assenza di neve, i turisti sono accolti presso l'ufficio nel centro del paese di Le Bessat."
    ],
    "fr": [
      "En période de neige l'accueil touristique est assuré au Chalet de la Croix de Chaubouret, sur le front de neige. \r\nEn cas d'absence de neige, accueil touristique au bureau du centre village du Bessat."
    ],
    "es": [
      "Cuando hay nieve, los turistas son recibidos en el Chalet de la Croix de Chaubouret, en el frente de nieve.\r\nCuando no hay nieve, está abierta la oficina de turismo en el centro de Le Bessat."
    ],
    "nl": [
      "Als er sneeuw ligt, worden toeristen verwelkomd in het Chalet de la Croix de Chaubouret, op het sneeuwfront.\r\nAls er geen sneeuw ligt, is het toeristenbureau in het centrum van Le Bessat geopend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Syndicat d'Initiative du Bessat"
    ]
  },
