  "rdfs:comment": {
    "de": [
      "Anhand von Beispielen aus der Kunst- und Filmgeschichte untersuchen wir drei Aspekte der Beziehungen zwischen Malerei und Film."
    ],
    "en": [
      "Using examples from the history of art and cinema, we explore three aspects of the relationship between painting and film."
    ],
    "it": [
      "Utilizzando esempi tratti dalla storia dell'arte e del cinema, esploreremo tre aspetti del rapporto tra pittura e cinema."
    ],
    "fr": [
      "À partir d'exemples pris dans l'histoire de l'art et dans celle du cinéma, nous explorerons trois aspects des relations qu'entretiennent la peinture et le cinéma."
    ],
    "es": [
      "Utilizando ejemplos de la historia del arte y del cine, exploraremos tres aspectos de la relación entre la pintura y el cine."
    ],
    "nl": [
      "Aan de hand van voorbeelden uit de kunst- en filmgeschiedenis verkennen we drie aspecten van de relatie tussen schilderkunst en film."
    ]
  },
