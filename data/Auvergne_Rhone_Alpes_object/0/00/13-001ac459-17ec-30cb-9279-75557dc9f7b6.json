  "rdfs:comment": {
    "de": [
      "Aventure Retournac beim 3. Trail Retournacois bietet eine Wanderung von 12,5 km mit 250 m Höhenunterschied und Verpflegung am Ziel. Anmeldung am Morgen vor Ort. Abfahrt von 8.00 bis 10.00 Uhr."
    ],
    "en": [
      "Aventure Retournac's 3rd trail retournacois offers a 12.5km hike with 250m of ascent and refreshments at the finish. Registration in the morning on site. Departures from 8:00 am to 10:00 am max."
    ],
    "it": [
      "In occasione del 3° Sentiero di Retournac, Aventure Retournac propone un'escursione di 12,5 km con 250 m di dislivello e un rinfresco all'arrivo. Iscrizioni al mattino sul posto. Partenze dalle 8.00 alle 10.00 al massimo."
    ],
    "fr": [
      "Aventure Retournac lors du 3ème trail retournacois propose une randonnée de 12.5km avec 250m de dénivelé et ravitaillement à l'arrivée. Inscriptions le matin sur place. Départs de 8h00 à 10h00 maxi."
    ],
    "nl": [
      "Op de 3e Retournac Trail biedt Aventure Retournac een wandeling van 12,5 km met 250 m klimmen en versnaperingen bij de finish. Inschrijving 's ochtends ter plaatse. Vertrek van 8 tot maximaal 10 uur."
    ],
    "es": [
      "En el 3er Trail de Retournac, Aventure Retournac propone una excursión de 12,5 km con 250 m de desnivel y un refrigerio a la llegada. Inscripción por la mañana in situ. Salidas de 8h a 10h como máximo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée du Trail Retournacois"
    ]
  },
