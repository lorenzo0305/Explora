  "rdfs:comment": {
    "de": [
      "Landeplatz in 450 m Höhe in der Ebene des Plan d'eau de Marlens in Val-de-Chaise, am Rande von Savoyen.\r\nStarke Brisen in der Tagesmitte, Stromleitungen in der Nähe."
    ],
    "en": [
      "Paragliding landing located at a 450m of altitude, in the Marlens - Val-de-Chaise artificial lake's plains, heading towards Savoie.\r\nElectric lines close-by, strong breeze mid-day."
    ],
    "it": [
      "Sito di atterraggio situato a 450 m di altitudine, sulla piana del lago di Marlens in Val-de-Chaise, alle porte della Savoia.\r\nForti brezze nelle ore centrali della giornata, linee elettriche nelle vicinanze."
    ],
    "fr": [
      "Site d'atterrissage situé à 450m d'altitude, dans la plaine du plan d'eau de Marlens à Val-de-Chaise, aux portes de la Savoie.\r\nBrises fortes en milieu de journée, lignes électriques à proximité."
    ],
    "es": [
      "Lugar de aterrizaje situado a 450 m de altitud, en la llanura del lago de Marlens, en Val-de-Chaise, a las puertas de Saboya.\r\nBrisas fuertes en las horas centrales del día, tendido eléctrico en las proximidades."
    ],
    "nl": [
      "Landingsplaats gelegen op 450m hoogte, op de vlakte van het meer van Marlens in Val-de-Chaise, aan de poort van de Savoie.\r\nSterke bries in het midden van de dag, hoogspanningskabels in de buurt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paragliding landing: Marlens-Val de Chaise"
    ],
    "fr": [
      "Aire d'atterrissage de Marlens-Val de Chaise"
    ]
  },
