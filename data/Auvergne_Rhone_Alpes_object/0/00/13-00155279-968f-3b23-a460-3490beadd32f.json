  "rdfs:comment": {
    "de": [
      "Um die Blüte des Olivenbaums zu feiern, profitieren Sie von Animationen, Wettbewerben, kommentierten Spaziergängen, Konzerten und der Messe für regionale Produkte in Nyons!"
    ],
    "en": [
      "Celebrate the olive blossom with events, competitions, guided walks, concerts and a regional produce fair in Nyons!"
    ],
    "it": [
      "Per celebrare la fioritura degli ulivi, godetevi eventi, concorsi, passeggiate guidate, concerti e la fiera dei prodotti regionali a Nyons!"
    ],
    "fr": [
      "Pour célébrer la fleur de l'olivier, profitez d'animations, concours, balades commentées, concert et du salon des produits régionaux à Nyons !"
    ],
    "es": [
      "Para celebrar la floración del olivo, disfrute de eventos, concursos, paseos guiados, conciertos y la feria de productos regionales de Nyons"
    ],
    "nl": [
      "Om de olijfbloesem te vieren, kunt u genieten van evenementen, wedstrijden, begeleide wandelingen, concerten en de regionale productenbeurs in Nyons!"
    ]
  },
  "rdfs:label": {
