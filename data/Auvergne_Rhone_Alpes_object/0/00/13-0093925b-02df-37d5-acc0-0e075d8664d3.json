      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/020fb8ee-1be2-3334-ba26-55e10e99c28c",
          "schema:validFrom": "2026-07-01T00:00:00",
          "schema:validThrough": "2026-08-30T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "von 10:00 bis 13:00 Uhr und von 15:00 bis 19:00 Uhr.\r\nEnde des Einlasses spätestens um 18:30 Uhr.\r\nVerlassen der Becken 15 Minuten vor der Schließzeit.\r\nBitte beachten Sie Die Vormittage vom bis zum 03. Juli sind den Schulkindern der Schule von Grignan vorbehalten. Der Zugang zum Schwimmbad wird daher für das externe Publikum geschlossen sein.\r\nÖffnungszeiten noch zu bestätigen"
            ],
            "en": [
              "10 a.m. to 1 p.m. and 3 p.m. to 7 p.m.\r\nAdmission ends at 6.30pm at the latest.\r\nPool exit 15 minutes before closing time.\r\nPlease note! Mornings from now until July 03 will be reserved for Grignan schoolchildren. Access to the pool will be closed to the general public.\r\nSchedules to be confirmed"
            ],
            "it": [
              "dalle 10.00 alle 13.00 e dalle 15.00 alle 19.00.\r\nL'ingresso chiude al più tardi alle 18.30.\r\nUscire dalle piscine 15 minuti prima dell'orario di chiusura.\r\nAttenzione! Le mattine da oggi al 03 luglio saranno riservate agli alunni delle scuole di Grignan. L'accesso alla piscina sarà quindi chiuso al pubblico.\r\nOrari di apertura da confermare"
            ],
            "fr": [
              "de 10h à 13h et de 15h à 19h.\r\nFin des entrées à 18h30 au plus tard.\r\nSortie des bassins 15 minutes avant l'heure de fermeture.\r\nAttention ! Les matins du jusqu'au 03 juillet seront réservés aux scolaires de l’école de Grignan. L'accès à la piscine sera donc fermé au public extérieur.\r\nHoraires à confirmer"
            ],
            "nl": [
              "van 10.00 tot 13.00 uur en van 15.00 tot 19.00 uur.\r\nDe toegang sluit uiterlijk om 18.30 uur.\r\nVerlaat de zwembaden 15 minuten voor sluitingstijd.\r\nLet op! De ochtenden van nu tot 03 juli zijn gereserveerd voor de schoolkinderen van Grignan. De toegang tot het zwembad is dan gesloten voor het grote publiek.\r\nOpeningstijden worden nog bevestigd"
            ],
            "es": [
              "de 10.00 a 13.00 y de 15.00 a 19.00 horas.\r\nLa admisión se cierra como muy tarde a las 18.30 horas.\r\nSalga de las piscinas 15 minutos antes del cierre.\r\nAtención A partir de ahora y hasta el 3 de julio, las mañanas estarán reservadas a los escolares de Grignan. Por lo tanto, el acceso a la piscina estará cerrado al público en general.\r\nHorario de apertura por confirmar"
            ]
          },
