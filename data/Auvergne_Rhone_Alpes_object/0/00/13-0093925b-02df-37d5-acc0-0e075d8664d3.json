  "rdfs:comment": {
    "de": [
      "Städtisches Schwimmbad mit einem 25 m langen Becken und einem Kinderbecken.\r\nKurse werden von Bademeistern angeboten.\r\nEin Imbiss steht den Besuchern zur Verfügung."
    ],
    "en": [
      "Municipal swimming pool with a 25 m pool and a children's pool.\r\nLessons are given by lifeguards.\r\nAn on-site refreshment bar is available to the public."
    ],
    "it": [
      "Piscina comunale con vasca da 25 m e vasca per bambini.\r\nLe lezioni sono tenute da bagnini.\r\nIl pubblico può usufruire di un bar per la ristorazione."
    ],
    "fr": [
      "Piscine municipale possédant un bassin de 25 m ainsi qu'un bassin pour les enfants . \r\nDes cours sont dispensés par des maîtres nageurs.\r\nUne buvette sur place est à la disposition du public."
    ],
    "es": [
      "Piscina municipal con un vaso de 25 m y una piscina infantil.\r\nLos socorristas imparten clases.\r\nHay un bar a disposición del público."
    ],
    "nl": [
      "Gemeentelijk zwembad met een 25 m bad en een kinderbad.\r\nEr worden lessen gegeven door badmeesters.\r\nEen verfrissingsbar is beschikbaar voor het publiek."
    ]
