  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, savoyische Spezialitäten, heißer Stein, Menüs, Karten.\r\nBedienung auf der Terrasse.\r\nIm Winter am Fuße der Seilbahn von Vercland und 100 m am Ende der roten Piste Grand Crêt gelegen. l'"
    ],
    "en": [
      "Traditional cuisine, Savoyard specialities, hot stone, menus, cards.\r\nTerrace service.\r\nIn winter, located at the foot of the Vercland cable car and 50m away from the red  ski run Grand Crêt."
    ],
    "it": [
      "Cucina tradizionale, specialità savoiarde, pietra calda, menu.\r\nServizio in terrazza.\r\nIn inverno, situato ai piedi della funivia del Vercland e a 100 m dalla pista rossa del Grand Crêt"
    ],
    "fr": [
      "Cuisine traditionnelle, spécialités savoyardes, pierre chaude, menus, cartes.\r\nService en terrasse.\r\nEn hiver, situé au pied de la télécabine de Vercland et à 100m à l'arrivée de la piste rouge Grand Crêt. l'"
    ],
    "nl": [
      "Traditionele keuken, Savoyaardse specialiteiten, hot stone, menu's, kaarten.\r\nTerrasservice.\r\nIn de winter, gelegen aan de voet van de Vercana kabelbaan en 50m afstand bij de aankomst van de Grand Crêt rode track."
    ],
    "es": [
      "Cocina tradicional, especialidades saboyanas, piedra caliente, menús.\r\nServicio en la terraza.\r\nEn invierno, situado al pie del teleférico de Vercland y a 100 m de la pista roja de Grand Crêt"
    ]
  },
