  "rdfs:comment": {
    "de": [
      "Mit seinem Kind zu lesen bedeutet, mehr als nur Geschichten zu teilen: Es weckt seine Neugier, fördert seine Vorstellungskraft und stärkt die Eltern-Kind-Bindung."
    ],
    "en": [
      "Reading with your child means sharing more than just stories: it awakens curiosity, nurtures the imagination and strengthens the parent-child bond."
    ],
    "it": [
      "Leggere con i propri figli significa condividere molto di più di semplici storie: risveglia la loro curiosità, nutre la loro immaginazione e rafforza il legame genitore-figlio."
    ],
    "fr": [
      "Lire avec son enfant, c’est partager bien plus que des histoires : c’est éveiller sa curiosité, nourrir son imaginaire et renforcer le lien parent-enfant."
    ],
    "nl": [
      "Lezen met je kind betekent veel meer delen dan alleen verhalen: het wekt hun nieuwsgierigheid, voedt hun verbeelding en versterkt de band tussen ouder en kind."
    ],
    "es": [
      "Leer con su hijo significa compartir mucho más que cuentos: despierta su curiosidad, alimenta su imaginación y refuerza el vínculo padre-hijo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre autour de la littérature jeunesse pour donner le goût de lire en famille"
    ]
  },
