  "rdfs:comment": {
    "de": [
      "Nach 20 Jahren eines Berufslebens fernab der Natur erfüllt sich Vanessa Peyre ihren Traum und kauft 2018 die Ferme de la Beaume."
    ],
    "en": [
      "After 20 years of a professional life far from nature, Vanessa Peyre realized her dream by buying the Beaume farm in 2018."
    ],
    "it": [
      "Dopo 20 anni di vita professionale lontana dalla natura, Vanessa Peyre ha realizzato il suo sogno acquistando la fattoria La Beaume nel 2018."
    ],
    "fr": [
      "Après 20 années d’une vie professionnelle loin de la nature, Vanessa Peyre réalise son rêve en achetant en 2018 la ferme de la Beaume."
    ],
    "es": [
      "Tras 20 años de vida profesional alejada de la naturaleza, Vanessa Peyre hizo realidad su sueño comprando la granja La Beaume en 2018."
    ],
    "nl": [
      "Na 20 jaar een beroepsleven ver van de natuur te hebben geleid, realiseerde Vanessa Peyre haar droom door in 2018 de boerderij La Beaume te kopen."
    ]
