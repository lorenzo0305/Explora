  "rdfs:comment": {
    "de": [
      "Der Ökomuseumsbauernhof Clos Parchet in Samoëns ist ein alter traditioneller Bauernhof. Sie zeigt eine beachtliche Sammlung von Utensilien aus der damaligen Zeit. Sie zeugt vor allem vom täglichen Leben auf den Adrets von Samoëns."
    ],
    "en": [
      "The ecomuseum farm of Clos Parchet in Samoëns is an old traditional farm. It displays a considerable collection of antique utensils. Above all, it illustrates daily life on the adrets of Samoëns."
    ],
    "it": [
      "La storia di una famiglia dell'alta valle del Giffre raccontata attraverso la visita di una fattoria tradizionale, in cui è esposta la collezione di Pierre e Simone Déchavassine. Visita seguita da una degustazione gratuita."
    ],
    "fr": [
      "La ferme écomusée du Clos Parchet à Samoëns est une ancienne ferme traditionnelle. Elle présente une collection considérable d'ustensiles d'époque. Elle témoigne surtout de la vie quotidienne sur les adrets de Samoëns."
    ],
    "es": [
      "La granja ecomuseo Clos Parchet de Samoëns es una antigua granja tradicional. Presenta una considerable colección de utensilios de época. Sobre todo, es testigo de la vida cotidiana en las laderas de Samoëns."
    ],
    "nl": [
      "De ecomuseumboerderij van Clos Parchet in Samoëns is een oude traditionele boerderij. Het toont een aanzienlijke collectie antieke gebruiksvoorwerpen. Het illustreert vooral het dagelijkse leven op de adresjes van Samoëns."
    ]
  },
