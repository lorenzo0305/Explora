  "rdfs:comment": {
    "de": [
      "Der 6er-Sessellift Morclan wird in Super-Châtel an der Ankunft der Gondelbahn abgeholt. Seine Ankunft befindet sich auf 1.970 m Höhe und sein Panorama ist atemberaubend!"
    ],
    "en": [
      "The 6-seater chairlift of Morclan is taken at Super-Châtel, at the arrival of the gondola. Its arrival is at 1,970m of altitude and its panorama is to take the breath!"
    ],
    "it": [
      "La seggiovia Morclan a 6 posti si trova a Super-Châtel, all'arrivo della telecabina. Il suo arrivo è a 1.970 metri di altitudine e il suo panorama è mozzafiato!"
    ],
    "fr": [
      "Le télésiège 6 places du Morclan se prend à Super-Châtel, à l'arrivée de la télécabine. Son arrivée se situe à 1 970m d'altitude et son panorama est à couper le souffle !"
    ],
    "es": [
      "El telesilla de 6 plazas Morclan se encuentra en Super-Châtel, a la llegada del telecabina. Su llegada es a 1.970 m de altitud y su panorama es impresionante"
    ],
    "nl": [
      "De 6-persoons stoeltjeslift Morclan start in Super-Châtel, bij het aankomstpunt van de gondellift. De stoeltjeslift stopt op 1970 m hoogte: het uitzicht is er adembenemend!"
    ]
  },
  "rdfs:label": {
