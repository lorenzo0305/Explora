  "rdfs:comment": {
    "de": [
      "Mittagessen mit Skiern an den Füßen! Unser Selbstbedienungsrestaurant ermöglicht es Ihnen, direkt auf den Pisten anzukommen und abzufahren, damit Sie möglichst viel Zeit zum Skifahren haben."
    ],
    "en": [
      "Lunch on skis! Our self-service service allows you to arrive and leave directly on the slopes for maximum skiing time."
    ],
    "it": [
      "Pranzo sugli sci! Il nostro ristorante self-service vi permette di arrivare e ripartire direttamente sulle piste, per un tempo massimo di sciata."
    ],
    "fr": [
      "Déjeuner ski aux pieds ! Notre self-service vous permet d'arriver et repartir directement sur les pistes pour un maximum de temps de glisse."
    ],
    "nl": [
      "Lunch op ski's! Ons zelfbedieningsrestaurant betekent dat je direct op de piste kunt aankomen en vertrekken voor maximale skitijd."
    ],
    "es": [
      "Almuerzo sobre esquís Nuestro restaurante autoservicio le permite llegar y salir directamente de las pistas para disfrutar al máximo del esquí."
    ]
