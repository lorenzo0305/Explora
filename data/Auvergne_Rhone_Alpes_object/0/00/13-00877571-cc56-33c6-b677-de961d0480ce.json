  "rdfs:comment": {
    "de": [
      "Neu in Courchevel Moriond: Das Restaurant Henri empfängt Sie mittags für eine Mittagspause zwischen zwei Abfahrten, 50 m von der Talstation, und abends zum Abendessen in einer gemütlichen Atmosphäre gegenüber von schneebedeckten Tannen des Dent du Villard."
    ],
    "ru": [
      "Новинка в Куршевель Морион! Ресторан Henri ждёт вас в обеденное время после утренней прогулки. Заведение расположено в 50 метров от горнолыжных склонов. Вечером в уютной обстановке насладитесь ужином, любуясь заснеженными елями на горе Дан дю Вилар."
    ],
    "en": [
      "New in Courchevel Moriond: come to the restaurant Chez Henri at lunchtime for a break from the slopes, just 50 m from the foot of the slopes, and in the evening for dinner in a warm atmosphere facing the snow-covered fir trees of the Dent du Villard mountain."
    ],
    "it": [
      "Novità a Courchevel Moriond: il Restaurant Henri apre le sue porte a mezzogiorno, per una pausa pranzo tra una discesa e l'altra, a 50 m dal fronte neve, ma anche la sera per cenare in un ambiente accogliente con vista sulla pineta innevata del Dent du Villard."
    ],
    "fr": [
      "Nouveau à Courchevel Moriond : le Restaurant Henri vous accueille le midi pour une pause déjeuner entre deux descentes, à 50 m du front de neige, le soir pour dîner dans une atmosphère chaleureuse face aux sapins enneigés de la dent du Villard."
    ],
    "nl": [
      "Nieuw in Courchevel Moriond: Restaurant Henri ontvangt u voor de lunch tussen twee pistes, op 50 m van het sneeuwfront, en voor het diner in een warme sfeer met uitzicht op de besneeuwde dennenbomen van de Dent du Villard."
    ],
    "zh": [
      "Henri餐厅是一家在Courchevel Moriond新开设的餐厅，欢迎您在午餐时来这里休息片刻再踏上新的滑雪道，距离雪线仅50米，晚上可在温暖的氛围中面对Dent du Villard雪地冷杉享用晚餐。"
    ],
    "es": [
      "Como novedad en Courchevel Moriond, el restaurante Henri te abre sus puertas al mediodía para que puedas parar a comer entre descenso y descenso, a 50 m del frente nevado. Además, por la noche sirve cenas en un ambiente acogedor frente a los abetos nevados de la Dent du Villard."
    ]
  },
