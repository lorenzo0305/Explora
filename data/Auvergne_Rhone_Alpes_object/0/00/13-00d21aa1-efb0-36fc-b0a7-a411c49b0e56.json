  "rdfs:comment": {
    "de": [
      "Erlebe eine unvergessliche Zeit mit Gänsehaut, Schweiß und Denkarbeit! In einem Raum eingesperrt, erleben Sie ein außergewöhnliches Abenteuer und haben 60 Minuten Zeit, um den Ausgang zu finden und zu fliehen. Ein Einbruch, der einem Meisterwerk würdig ist."
    ],
    "en": [
      "Escape game"
    ],
    "it": [
      "Venite a vivere un'esperienza memorabile che vi farà rabbrividire, sudare e pensare! Chiusi in una stanza, vivrete un'avventura straordinaria.\r\nAvrete solo 90 minuti"
    ],
    "fr": [
      "Venez passer un moment mémorable, frissons, sueurs, et réflexion seront au rendez-vous! Enfermé dans une salle, vivez une aventure hors du commun.\r\nVous aurez 90 minutes top chrono"
    ],
    "es": [
      "¡Venga y disfrute de una experiencia memorable que le dejará temblando, sudando y pensando! Encerrado en una habitación, viva una aventura extraordinaria.\r\nSólo dispondrá de 90 minutos"
    ],
    "nl": [
      "Kom en beleef een onvergetelijk moment, met spanning, zweet en reflectie! Opgesloten in een kamer heb je 60 minuten om de uitgang te vinden en te ontsnappen! Een inbraak die een meesterwerk waardig is."
    ]
  },
