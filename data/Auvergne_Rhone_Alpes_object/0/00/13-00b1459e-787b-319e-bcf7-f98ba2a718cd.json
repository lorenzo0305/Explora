  "rdfs:comment": {
    "de": [
      "Der Glandon ist ein Gebirgsbach, von dem man den oberen Teil und die Zuflüsse am linken Ufer bevorzugen sollte, da es dort von Forellen wimmelt."
    ],
    "en": [
      "The Glandon is a mountain torrent, and you should favour the upstream part and the left bank tributaries as they are full of trout."
    ],
    "it": [
      "Il Glandon è un torrente di montagna, di cui vanno privilegiati la parte a monte e gli affluenti di sinistra, ricchi di trote."
    ],
    "fr": [
      "Le Glandon est un torrent de montagne, dont il faudra privilégier la partie amont et les affluents rive gauche car ils regorgent de truites."
    ],
    "es": [
      "El Glandon es un torrente de montaña, del que conviene favorecer la parte aguas arriba y los afluentes de la orilla izquierda, ya que están repletos de truchas."
    ],
    "nl": [
      "De Glandon is een bergstroom, waarvan het stroomopwaartse deel en de zijrivieren aan de linkeroever favoriet zijn omdat ze vol forel zitten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Glandon et affluents"
