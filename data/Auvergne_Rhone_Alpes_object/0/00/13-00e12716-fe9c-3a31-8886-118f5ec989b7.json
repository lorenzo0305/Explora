  "rdfs:comment": {
    "de": [
      "Erstelle wunderschöne Kunstwerke mit diesem spielerischen und pädagogischen Frühförderungs-Kunstworkshop, um die Kunst mit Malen und Zeichnen zu entdecken."
    ],
    "en": [
      "Create magnificent works of art with this fun and educational early-learning workshop to discover art through painting and drawing."
    ],
    "it": [
      "Create magnifiche opere d'arte con questo divertente ed educativo laboratorio d'arte per l'apprendimento precoce, per scoprire l'arte attraverso la pittura e il disegno."
    ],
    "fr": [
      "Réalise de magnifiques œuvres avec cet atelier artistique d'éveil ludique et pédagogique pour découvrir l'art avec la peinture et le dessin."
    ],
    "nl": [
      "Maak prachtige kunstwerken met deze leuke en leerzame kunstworkshop voor jonge kinderen om kunst te ontdekken door schilderen en tekenen."
    ],
    "es": [
      "Crea magníficas obras de arte con este divertido y educativo taller de arte infantil para descubrir el arte a través de la pintura y el dibujo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier éveil artistique dessin/peinture - Enfants 4/6 ans"
    ]
  },
