      "dc:description": {
        "de": [
          "Produkte auf der Grundlage von Schweinen und Geflügel. Verarbeitete Produkte: Wurstwaren, Schinken, Pastete, Rillettes. Verkauf in Kisten."
        ],
        "en": [
          "Pork and poultry products. Processed products: charcuterie, ham, pâté, rillettes. Sale in boxes."
        ],
        "it": [
          "Prodotti a base di carne di maiale e pollame. Prodotti trasformati: salumi, prosciutto, paté, rillettes. Vendita in scatola."
        ],
        "fr": [
          "Produits à base de porcs et volailles. Produits transformés : charcuterie, jambon, pâté, rillettes. Vente en caissettes."
        ],
        "nl": [
          "Varkensvlees en pluimveeproducten. Verwerkte producten: vleeswaren, ham, paté, rillettes. Verkoop in dozen."
        ],
        "es": [
          "Carne de cerdo y productos avícolas. Productos transformados: charcutería, jamón, paté, rillettes. Venta en cajas."
        ]
