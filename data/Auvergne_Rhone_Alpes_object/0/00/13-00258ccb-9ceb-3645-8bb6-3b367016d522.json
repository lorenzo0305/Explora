  "rdfs:comment": {
    "de": [
      "Lernen Sie, Wild- und Heilpflanzen zu erkennen, sie zu pflücken und zu natürlichen Heilmitteln zu verarbeiten.\r\nThema des Tages: Öl aus Blütenmazeration"
    ],
    "en": [
      "Learn to recognize wild and medicinal plants, pick them and transform them into natural remedies.\r\nToday's theme: flower maceration oil"
    ],
    "it": [
      "Imparate a riconoscere le piante selvatiche e medicinali, a raccoglierle e a trasformarle in rimedi naturali.\r\nTema di oggi: olio di macerazione dei fiori"
    ],
    "fr": [
      "Apprenez à reconnaître les plantes sauvages et médicinales, les cueillir et les transformer en remède naturel. \r\nThème du jour :  huile de macération de fleurs"
    ],
    "nl": [
      "Leer hoe je wilde en geneeskrachtige planten kunt herkennen, plukken en omtoveren tot natuurlijke remedies.\r\nHet thema van vandaag: maceratie van bloemenolie"
    ],
    "es": [
      "Aprenda a reconocer las plantas silvestres y medicinales, a recolectarlas y a transformarlas en remedios naturales.\r\nTema del día: aceite de maceración de flores"
    ]
  },
  "rdfs:label": {
