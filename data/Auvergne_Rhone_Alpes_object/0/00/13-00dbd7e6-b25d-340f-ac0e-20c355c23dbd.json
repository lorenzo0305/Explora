  "rdfs:comment": {
    "de": [
      "Das Stadttheater von Moulins ist ein neoklassizistischer Bau aus dem Jahr 1847. Hier werden zahlreiche Theaterstücke, Varietévorstellungen, Opern und Vorstellungen für junges Publikum aufgeführt."
    ],
    "en": [
      "The municipal theater of Moulins is a neo-classical building from 1847. The hall hosts numerous plays, variety shows, operas, and shows for young audiences."
    ],
    "it": [
      "Il teatro comunale di Moulins è un edificio neoclassico del 1847. Il teatro ospita numerose opere teatrali, spettacoli di varietà, opere liriche e spettacoli per il pubblico giovane."
    ],
    "fr": [
      "Le théâtre municipal de Moulins est une construction néo-classique de 1847. La salle accueille de nombreuses pièces de théâtre, des spectacles de variétés, des opéras, des spectacles jeune public."
    ],
    "es": [
      "El teatro municipal de Moulins es un edificio neoclásico de 1847. El teatro acoge numerosas obras de teatro, espectáculos de variedades, óperas y espectáculos para el público joven."
    ],
    "nl": [
      "De stadsschouwburg van Moulins is een neoklassiek gebouw uit 1847. In het theater worden talrijke toneelstukken, variétévoorstellingen, opera's en voorstellingen voor een jong publiek opgevoerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre municipal"
    ]
  },
