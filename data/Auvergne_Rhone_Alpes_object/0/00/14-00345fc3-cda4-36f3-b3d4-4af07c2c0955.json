  "rdfs:comment": {
    "de": [
      "Souffle! lädt das Publikum ein, sich auf gemütlichen Inseln inmitten eines immersiven, von Licht und Klang vibrierenden Raums zusammenzurollen, mit der Absicht, einen zeitlosen Moment des Zuhörens zu bieten, der mit der akustischen Neugier der Kleinen und Großen in Resonanz steht."
    ],
    "en": [
      "Souffle! invites the public to curl up on cozy islands, in the heart of an immersive space vibrating with sound and light, with the intention of offering a moment of timeless listening, resonating with the sonic curiosity of young and old alike."
    ],
    "it": [
      "Souffle! invita il pubblico ad accoccolarsi su accoglienti isole nel cuore di uno spazio immersivo vivo di suoni e luci, con l'obiettivo di offrire un momento di ascolto senza tempo che risuoni con la curiosità sonora di grandi e piccini."
    ],
    "fr": [
      "Souffle ! invite le public à se lover sur des îlots douillets, au cœur d’un espace immersif vibrant de son et de lumière, avec l’intention d’offrir un moment d’écoute intemporelle, en résonance avec la curiosité sonore des petits et des plus grands."
    ],
    "nl": [
      "Souffle! nodigt het publiek uit om zich op te krullen op knusse eilanden in het hart van een meeslepende ruimte vol geluid en licht, met als doel een moment van tijdloos luisteren te bieden dat resoneert met de sonische nieuwsgierigheid van jong en oud."
    ],
    "es": [
      "Souffle! invita al público a acurrucarse en acogedoras islas en el corazón de un espacio inmersivo lleno de luz y sonido, con el objetivo de ofrecer un momento de escucha atemporal que resuene con la curiosidad sonora de pequeños y mayores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Souffle ! Cie Charabia"
    ]
  },
