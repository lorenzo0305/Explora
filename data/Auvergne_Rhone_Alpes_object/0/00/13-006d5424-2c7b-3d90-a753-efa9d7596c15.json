  "rdfs:comment": {
    "de": [
      "Thierry Ballay, ein Bergbegleiter, begleitet Sie auf einer halbtägigen Schneeschuhwanderung oder einem Ganztagesausflug, um ein anderes Gesicht des Cantalien-Massivs zu entdecken."
    ],
    "en": [
      "Mountain guide Thierry Ballay accompanies you on a snowshoe hike to discover a different face of the Cantalien Massif, in unspoilt surroundings far from the beaten track."
    ],
    "it": [
      "La guida alpina Thierry Ballay può accompagnarvi in un'escursione di mezza giornata con le racchette da neve o in una giornata intera alla scoperta di un'altra faccia del Massiccio del Cantalien."
    ],
    "fr": [
      "Thierry Ballay, accompagnateur en montagne vous accompagne pour une demi-journée de randonnée raquettes ou pour une journée complète afin de découvrir un autre visage du Massif Cantalien."
    ],
    "es": [
      "El guía de montaña Thierry Ballay puede llevarle a una excursión de media jornada con raquetas de nieve o a una jornada completa para descubrir una cara diferente del Macizo Cantaliense."
    ],
    "nl": [
      "Berggids Thierry Ballay kan je meenemen op een sneeuwschoenwandeling van een halve dag of een hele dag om een ander gezicht van het Cantalienmassief te ontdekken."
    ]
  },
