          "additionalInformation": {
            "de": [
              "Tage und Öffnungszeiten:\r\nMontag: 14h-20h\r\nMittwoch: 10:00-12:00 Uhr und 14:00-20:00 Uhr\r\nDonnerstag: 14h-21h\r\nFreitag: 14h -22h\r\nSamstag: 10h-22h\r\nSonntag: 10h-19h\r\n\r\nWährend der Schulferien täglich geöffnet :\r\n\r\nMontag, Dienstag, Mittwoch: 14h bis 20h\r\nDonnerstag: 14h bis 21h\r\nFreitag: 14 Uhr bis 22 Uhr\r\nSamstag: 10 Uhr bis 22 Uhr\r\nSonntag: 10 Uhr bis 19 Uhr"
            ],
            "en": [
