  "rdfs:comment": {
    "de": [
      "E.réel Brignais ist ein Virtual-Reality-Erlebnis, bei dem Sie einen spielerischen und außergewöhnlichen Moment verbringen werden. Spitzentechnologie, die leicht zu erlernen ist, Abenteuer, Emotionen, Teamzusammenhalt und Lachen sind garantiert!"
    ],
    "en": [
      "E.réel Brignais is a virtual reality experience where you will enjoy a fun and extraordinary moment. Cutting-edge technology that is easy to use, adventure, excitement, team building and laughter guaranteed!"
    ],
    "it": [
      "E.réel Brignais è un'esperienza di realtà virtuale che vi farà divertire come non mai. È facile familiarizzare con una tecnologia all'avanguardia e vi garantirà avventura, emozioni, team-building e tante risate!"
    ],
    "fr": [
      "E.réel  Brignais est une expérience en réalité virtuelle où vous passerez un moment ludique et hors du commun. Technologie de pointe facile à prendre en main, aventure, émotions, cohésion d'équipe et fous rires garantis !"
    ],
    "nl": [
      "E.réel Brignais is een virtual reality-ervaring waar je de tijd van je leven zult hebben. Het is gemakkelijk om de nieuwste technologie onder de knie te krijgen en je bent verzekerd van avontuur, spanning, teambuilding en veel gelach!"
    ],
    "es": [
      "E.réel Brignais es una experiencia de realidad virtual en la que te lo pasarás como nunca. Es fácil familiarizarse con la tecnología más avanzada y te garantizamos aventura, emoción, trabajo en equipo y muchas risas"
    ]
  },
