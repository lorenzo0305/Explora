  "rdfs:comment": {
    "de": [
      "Benoit und Cindy laden Sie ein, eine raffinierte Küche zu entdecken, in der alles hausgemacht ist und aus rohen, saisonalen Produkten besteht, die sorgfältig bei regionalen Erzeugern ausgewählt wurden."
    ],
    "en": [
      "Benoit and Cindy offer you delicious food prepared with carefully selected seasonal and regional products. Freshness, and respect of the product are the key words of a 100% homemade cooking, which draws its inspiration from the surrounding and authentic nature."
    ],
    "it": [
      "Benoit e Cindy vi invitano a scoprire la loro cucina raffinata, dove tutto è preparato in casa con prodotti crudi e di stagione accuratamente selezionati da produttori regionali."
    ],
    "fr": [
      "Benoit et Cindy vous invitent à découvrir une cuisine raffinée, où tout est préparé maison à partir de produits bruts, de saison et soigneusement sélectionnés auprès de producteurs régionaux."
    ],
    "es": [
      "Benoit y Cindy le invitan a descubrir su refinada cocina, en la que todo se elabora en casa con productos crudos de temporada cuidadosamente seleccionados entre los productores regionales."
    ],
    "nl": [
      "Benoit en Cindy nodigen u uit om een verfijnde keuken te ontdekken, waar alles thuis wordt bereid van rauwe producten, seizoensgebonden en zorgvuldig geselecteerd door regionale producenten."
    ]
  },
