  "rdfs:comment": {
    "de": [
      "Patrick, Jocelyne und Laurent Pavy arbeiten in der biologischen Landwirtschaft. Sie würden sich freuen, Sie auf ihrem Hof begrüßen zu dürfen, damit Sie ihre Käsesorten entdecken und probieren können."
    ],
    "en": [
      "Patrick, Jocelyne and Laurent Pavy will be delighted to welcome you on the farm to introduce you to the animals, their craft and taste the cheeses."
    ],
    "it": [
      "Patrick, Jocelyne e Laurent Pavy si occupano di agricoltura biologica. Saranno lieti di accogliervi in fattoria per farvi scoprire e degustare i loro formaggi."
    ],
    "fr": [
      "Patrick, Jocelyne et Laurent Pavy travaillent en agriculture biologique. Ils seront ravis de vous accueillir sur la ferme pour vous faire découvrir et déguster leurs fromages."
    ],
    "es": [
      "Patrick, Jocelyne y Laurent Pavy se dedican a la agricultura ecológica. Estarán encantados de recibirle en la granja para ayudarle a descubrir y degustar sus quesos."
    ],
    "nl": [
      "Patrick, Jocelyne en Laurent heten u van harte welkom op de boerderij waar u kennis kunt maken met de dieren en hun beroep en kazen mag proeven."
    ]
  },
  "rdfs:label": {
