  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie im vollständig restaurierten Buron du col de la Croix-Morand auf 1401 m Höhe. Entdecken Sie unsere Herberge: Restaurant, Café, Getränke, Eis?"
    ],
    "en": [
      "At the top of the Croix Morand pass (1401 metres), come and taste our Auvergne cuisine in the middle of the puys!"
    ],
    "it": [
      "Vi diamo il benvenuto nel buron du col de la Croix-Morand, completamente ristrutturato, a 1401 metri di altitudine. Scoprite la nostra locanda: ristorante, caffè, bevande, gelati?"
    ],
    "fr": [
      "Nous vous accueillons au buron du col de la Croix-Morand, entièrement restauré, à 1401 mètres d’altitude. Découvrez notre auberge : restaurant, café, boissons, glaces…"
    ],
    "nl": [
      "Wij heten u welkom in de volledig gerestaureerde buron du col de la Croix-Morand, op een hoogte van 1401 meter. Ontdek onze herberg: restaurant, café, drankjes, ijsjes?"
    ],
    "es": [
      "Le damos la bienvenida al buron du col de la Croix-Morand, totalmente restaurado, a 1.401 metros de altitud. Descubra nuestra posada: restaurante, cafetería, bebidas, helados.."
    ]
  },
