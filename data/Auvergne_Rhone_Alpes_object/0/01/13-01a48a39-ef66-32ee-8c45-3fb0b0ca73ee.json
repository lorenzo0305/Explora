  "rdfs:comment": {
    "de": [
      "Das Le Yule genießt eine hervorragende Lage direkt an der Schneefront am Fuße des Bellevarde-Gebirges und bietet Skifahren bis vor die Haustür.\r\nDas Hotel bietet außerdem ein Restaurant mit Panoramaterrassen, ein Spa und eine Bar."
    ],
    "en": [
      "With ski-in/ski-out access, Le Yule enjoys an exceptional location directly on the snow front, at the foot of the Bellevarde slope. \r\nThe hotel also offers a restaurant with panoramic terraces, a spa and a bar."
    ],
    "it": [
      "Con accesso diretto alle piste da sci, Le Yule gode di una posizione eccezionale direttamente sul fronte neve, ai piedi del versante di Bellevarde. \r\nL'hotel offre anche un ristorante con terrazze panoramiche, una spa e un bar."
    ],
    "fr": [
      "Avec un départ ski aux pieds, Le Yule jouit d’un emplacement exceptionnel directement sur le front de neige, au pied de la face de Bellevarde. \r\nL’hôtel propose également un restaurant avec terrasses panoramiques, un spa et un bar."
    ],
    "nl": [
      "Le Yule heeft een uitzonderlijke ligging direct aan het sneeuwfront, aan de voet van het Bellevarde-gebergte.\r\nHet hotel heeft ook een restaurant met panoramische terrassen, een spa en een bar."
    ],
    "es": [
      "Le Yule goza de una ubicación excepcional en primera línea de nieve, al pie de la cara Bellevarde.\r\nEl hotel también cuenta con un restaurante con terrazas panorámicas, un spa y un bar."
    ]
  },
