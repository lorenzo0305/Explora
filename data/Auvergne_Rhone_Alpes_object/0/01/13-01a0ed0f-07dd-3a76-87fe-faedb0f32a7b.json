  "rdfs:comment": {
    "de": [
      "Werkstatt für handwerkliches Holzdrehen. Möglichkeit, Aufträge für spezielle Gegenstände aus gedrechseltem Holz zu erteilen. Begleitung für diejenigen, die das Drechseln lernen möchten.\r\nZugang zur Werkstatt nur nach Vereinbarung."
    ],
    "en": [
      "Woodturning workshop. Orders can be placed for specific wood-turned objects. Guidance for those wishing to learn how to turn.\r\nAccess to the workshop by appointment only."
    ],
    "it": [
      "Laboratorio di tornitura del legno. È possibile effettuare ordini per oggetti specifici torniti in legno. Guida per chi desidera imparare a tornire.\r\nAccesso al laboratorio solo su appuntamento."
    ],
    "fr": [
      "Atelier tournage sur bois artisanal. Possibilité de passer commande pour des objets spécifiques en bois tourné. Accompagnement pour qui veut apprendre à tourner.\r\nAccès à l'atelier uniquement sur rendez-vous."
    ],
    "nl": [
      "Workshop houtdraaien. Er kunnen bestellingen worden geplaatst voor specifieke houtgedraaide voorwerpen. Begeleiding voor wie wil leren draaien.\r\nToegang tot de werkplaats alleen op afspraak."
    ],
    "es": [
      "Taller de torneado de madera. Se pueden hacer pedidos de objetos específicos torneados en madera. Orientación para quienes deseen aprender a tornear.\r\nAcceso al taller con cita previa."
    ]
  },
