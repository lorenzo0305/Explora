  "rdfs:comment": {
    "de": [
      "Die BangingBees Top To Bottom findet auf dem Sunset Park - Snowpark von Chamrousse 1750 statt. Eine fette, fette Snowboard-Jam-Session, die für alle offen ist!\r\nDie Top To Bottom des Bangingbees-Magazins, das größte französische Snowboardtreffen."
    ],
    "en": [
      "BangingBees Top To Bottom takes place at Sunset Park - Snowpark de Chamrousse 1750. A great big snowboard jam session open to all!\r\nBangingbees magazine's Top To Bottom, France's biggest snowboard gathering."
    ],
    "it": [
      "Il BangingBees Top To Bottom si svolge al Sunset Park - Snowpark di Chamrousse 1750. Una grande jam session di snowboard aperta a tutti!\r\nThe Bangingbees Top To Bottom, il più grande raduno francese di snowboard."
    ],
    "fr": [
      "La BangingBees Top To Bottom a lieu sur le Sunset Park - Snowpark de Chamrousse 1750. Une bonne grosse jam session snowboard ouverte à tous !\r\nLa Top To Bottom du magazine Bangingbees, le plus gros rassemblement snowboard français."
    ],
    "es": [
      "El BangingBees Top To Bottom tiene lugar en el Sunset Park - Snowpark de Chamrousse 1750. Una gran jam session de snowboard abierta a todos\r\nThe Bangingbees Top To Bottom, el mayor encuentro de snowboard de Francia."
    ],
    "nl": [
      "De BangingBees Top To Bottom vindt plaats in het Sunset Park - Snowpark in Chamrousse 1750. Een grote snowboard jamsessie voor iedereen!\r\nThe Bangingbees Top To Bottom, de grootste snowboardmeeting van Frankrijk."
    ]
  },
