  "rdfs:comment": {
    "de": [
      "Der Torrent des Glaciers ist ein wunderschöner Gebirgsbach, der am Fuße des Col de la Seigne entspringt. Dieser Gebirgsbach mit kristallklarem Wasser beherbergt auf natürliche Weise eine Population von Bachforellen und Brunnenlachsen."
    ],
    "en": [
      "The Torrent des Glaciers is a magnificent mountain stream that rises at the foot of the Col de la Seigne. This crystal-clear torrent is home to a natural population of fario trout and brook salmon."
    ],
    "it": [
      "Il Torrent des Glaciers è un magnifico torrente di montagna che nasce ai piedi del Col de la Seigne. Questo torrente cristallino ospita una popolazione naturale di trote fario e salmoni di ruscello."
    ],
    "fr": [
      "Le torrent des Glaciers est un magnifique torrent de montagne qui prend sa source au pied du col de la Seigne. Ce torrent aux eaux cristallines accueille naturellement une population de truites fario et de saumons de fontaine."
    ],
    "es": [
      "El Torrent des Glaciers es un magnífico arroyo de montaña que nace al pie del Col de la Seigne. Este arroyo cristalino alberga una población natural de truchas fario y salmones de arroyo."
    ],
    "nl": [
      "De Torrent des Glaciers is een prachtige bergstroom die ontspringt aan de voet van de Col de la Seigne. Deze kristalheldere beek herbergt een natuurlijke populatie fario-forel en beekzalm."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Pêche \"Passion\" du Torrent des Glaciers à Bourg-St-Maurice"
    ]
  },
