  "rdfs:comment": {
    "de": [
      "Museum mit den paläolithischen, prähistorischen und lokalgeschichtlichen Sammlungen von Raymond Pillon, einem militärischen Schuhmacher im Ersten Weltkrieg, die Fund um Fund um Chaumont-en-Vexin herum aufgebaut wurden."
    ],
    "en": [
      "Museum presenting the paleolithic, prehistoric and local history collections of Raymond Pillon, military shoemaker during the First World War, built after discoveries around Chaumont-en-Vexin."
    ],
    "it": [
      "Museo che presenta le collezioni paleolitiche, preistoriche e di storia locale di Raymond Pillon, calzolaio militare durante la Prima Guerra Mondiale, costruite di scoperta in scoperta intorno a Chaumont-en-Vexin."
    ],
    "fr": [
      "Musée présentant les collections paléolithiques, préhistoriques et d'histoire locale de Raymond Pillon, cordonnier militaire lors de la Première Guerre mondiale, construites découvertes après découvertes autour de Chaumont-en-Vexin."
    ],
    "nl": [
      "Museum waar de paleolithische, prehistorische en lokale geschiedeniscollecties van Raymond Pillon, militair schoenmaker tijdens de Eerste Wereldoorlog, worden gepresenteerd, opgebouwd van ontdekking naar ontdekking rond Chaumont-en-Vexin."
    ],
    "es": [
      "Museo que presenta las colecciones paleolíticas, prehistóricas y de historia local de Raymond Pillon, zapatero militar durante la Primera Guerra Mundial, construidas de descubrimiento en descubrimiento alrededor de Chaumont-en-Vexin."
    ]
  },
