  "rdfs:comment": {
    "de": [
      "Die Familie Mercier, die seit vier Generationen Winzer ist, ist der Ursprung des AOC Crépy im Jahr 1948. Familienbetrieb von 30 ha auf Douvaine, Loisin und Ballaison, produziert 6 Weiße, 4 Rote, 1 Rosé, 3 Reife und 1 Sekt nach alter Methode."
    ],
    "en": [
      "Winegrower for four generations, the Mercier family is at the origin of the AOC Crépy in 1948. Family estate of 30 ha located on Douvaine, Loisin and Ballaison, it produces 6 whites, 4 reds, 1 rosé, 3 mellow and 1 sparkling wine by ancestral methods."
    ],
    "it": [
      "La famiglia Mercier è viticoltrice da quattro generazioni e ha dato origine all'AOC Crépy nel 1948. Tenuta familiare di 30 ettari situata a Douvaine, Loisin e Ballaison, produce 6 bianchi, 4 rossi, 1 rosé, 3 mellows e 1 spumante con metodo ancestrale, in AOC"
    ],
    "fr": [
      "Vigneron depuis quatre générations, la famille Mercier est à l'origine de l'AOC Crépy en 1948. Domaine familial de 30 ha situé sur Douvaine, Loisin et Ballaison, il produit 6 blancs, 4 rouges, 1 rosé, 3 moelleux et 1 mousseux en méthode ancestrale, en AOC"
    ],
    "es": [
      "La familia Mercier es viticultora desde hace cuatro generaciones y fue la creadora de la AOC Crépy en 1948. Finca familiar de 30 hectáreas situada en Douvaine, Loisin y Ballaison, produce 6 blancos, 4 tintos, 1 rosado, 3 melosos y 1 espumoso según el método ancestral, en AOC"
    ],
    "nl": [
      "De familie Mercier is al vier generaties lang wijnbouwer en stond aan de wieg van de AOC Crépy in 1948. Een familiedomein van 30 hectare gelegen in Douvaine, Loisin en Ballaison, produceert 6 witte, 4 rode, 1 rosé, 3 mousserende en 1 mousserende wijn in de voorouderlijke methode, in AOC"
    ]
  },
