  "rdfs:comment": {
    "de": [
      "Alle Bienenstöcke von Eric stehen im Departement Allier. Er produziert Honig (Raps, Akazien, alle Blumen, Sonnenblumen usw.), der auf dem Hof geerntet und in Gläser abgefüllt wird."
    ],
    "en": [
      "All Eric's hives are located in the Allier region. He produces honey (rapeseed, acacia, all flowers, sunflowers, etc.) harvested and potted on the farm."
    ],
    "it": [
      "Tutti gli alveari di Eric si trovano nella regione di Allier. Produce miele (colza, acacia, tutti i fiori, girasoli, ecc.) che viene raccolto e invasato in azienda."
    ],
    "fr": [
      "Toutes les ruches d’Eric sont installées dans l’Allier. Il produit du miel (colza, acacia, toutes fleurs ou encore tournesols etc…) récolté et mis en pot sur l’exploitation."
    ],
    "es": [
      "Todas las colmenas de Eric están situadas en la región de Allier. Produce miel (colza, acacia, todas las flores, girasol, etc.) que se cosecha y se envasa en la granja."
    ],
    "nl": [
      "Alle bijenkasten van Eric bevinden zich in de Allier. Hij produceert honing (koolzaad, acacia, alle bloemen, zonnebloemen, enz.) die wordt geoogst en opgepot op de boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Happy Culteur"
    ]
  },
