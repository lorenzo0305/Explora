  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in das Alltagsleben der Bewohner der antiken Stadt Aosta! In den reichen Sammlungen des Museums können Sie in die Haut eines Gallo-Romans schlüpfen."
    ],
    "en": [
      "Learn about the everyday life in the ancient city of Vicus Augustus. A thematic and educational journey illustrated with a 2000 years collection of antique ceramics and glass objects."
    ],
    "it": [
      "Immergetevi nella vita quotidiana degli abitanti dell'antica città di Aosta! Visitate le ricche collezioni del Museo e calatevi nei panni di un gallo-romano."
    ],
    "fr": [
      "Plongez dans la vie quotidienne des habitants de la ville antique d'Aoste ! Le temps d'une visite entrez dans la peau d'un Gallo-Romain au travers des riches collections du Musée."
    ],
    "es": [
      "Sumérjase en la vida cotidiana de los habitantes de la antigua ciudad de Aosta Recorra las ricas colecciones del Museo y póngase en la piel de un galo-romano."
    ],
    "nl": [
      "Over het leven in de antieke stad Augustum in de Gallo-Romeinsetijd."
    ]
  },
