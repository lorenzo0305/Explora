  "rdfs:comment": {
    "de": [
      "Die Domaine Les P'tits Ballons ist ein kleiner Weinberg, der aus autochthonen und alten Rebsorten besteht. Er produziert in biologischer Landwirtschaft originelle Weiß- und Rotweine. Sarah lädt Sie ein, ihre Hänge und Crus in einer bemerkenswerten Lage zu entdecken."
    ],
    "en": [
      "Domaine Les P'tits Ballons is a small vineyard planted with indigenous, ancient grape varieties. It produces original red and white wines using organic farming methods. Sarah invites you to come and discover her slopes and vintages in a remarkable setting."
    ],
    "it": [
      "Il Domaine Les P'tits Ballons è un piccolo vigneto coltivato con vitigni autoctoni e antichi. Produce vini rossi e bianchi originali utilizzando metodi biologici. Sarah vi invita a venire a scoprire i suoi pendii e le sue annate in un ambiente straordinario."
    ],
    "fr": [
      "Le Domaine Les P'tits Ballons est un petit vignoble issu de cépages autochtones et anciens. Il produit en agriculture biologique des vins blancs et rouges originaux. Sarah vous invite à venir découvrir ses coteaux et ses crus dans un site remarquable."
    ],
    "nl": [
      "Domaine Les P'tits Ballons is een kleine wijngaard beplant met inheemse en oude druivenrassen. Er worden originele rode en witte wijnen geproduceerd op biologische wijze. Sarah nodigt je uit om haar hellingen en wijngaarden te komen ontdekken in een opmerkelijke omgeving."
    ],
    "es": [
      "Domaine Les P'tits Ballons es un pequeño viñedo plantado con variedades de uva autóctonas y antiguas. Produce vinos tintos y blancos originales con métodos ecológicos. Sarah le invita a descubrir sus laderas y sus cosechas en un marco excepcional."
    ]
  },
