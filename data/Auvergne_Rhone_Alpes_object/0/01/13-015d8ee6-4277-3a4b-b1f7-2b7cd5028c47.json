  "rdfs:comment": {
    "de": [
      "Le Bois de Belle, vereint Tradition und Innovation. Cremes, geröstete Maronen, Mehl, Gelees... Ein Gourmet-Abenteuer! Schulungen, Konferenzen und Expertise in Biberbau, Agrarökologie und Klimaresilienz."
    ],
    "en": [
      "Le Bois de Belle combines tradition and innovation. Creams, roasted chestnuts, flours, jellies... A gourmet adventure! Training, conferences and expertise in castaneiculture, agroecology and climate resilience."
    ],
    "it": [
      "Le Bois de Belle unisce tradizione e innovazione. Creme, caldarroste, farine, gelatine? Un'avventura gastronomica! Formazione, conferenze e competenze in castanicoltura, agroecologia e resilienza climatica."
    ],
    "fr": [
      "Le Bois de Belle, allie tradition et innovation. Crèmes, marrons grillés, farines, gelées… Une aventure gourmande ! Formations, conférences et expertise en castanéiculture, agroécologie et résilience climatique."
    ],
    "nl": [
      "Le Bois de Belle combineert traditie en innovatie. Crèmes, geroosterde kastanjes, meel, gelei? Een gastronomisch avontuur! Training, conferenties en expertise in castaneicultuur, agro-ecologie en klimaatbestendigheid."
    ],
    "es": [
      "Le Bois de Belle combina tradición e innovación. Cremas, castañas asadas, harinas, gelatinas.. Toda una aventura gastronómica Formación, conferencias y experiencia en castaneicultura, agroecología y resiliencia climática."
    ]
  },
