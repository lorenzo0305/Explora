  "rdfs:comment": {
    "de": [
      "Die Brasserie des Deux Rives, das Lyoner Haus der Nouvelle Garde, interpretiert alle großen Klassiker der französischen Brasserie neu. Die fröhliche Brigade kocht jeden Tag von A bis Z mit den besten lokal bezogenen Produkten aus dem französischen Terroir."
    ],
    "en": [
      "La Brasserie des Deux Rives, Lyon's home of the Nouvelle Garde, revisits all the great classics of French brasserie cuisine. Every day, the cheerful kitchen team prepares the finest locally sourced French produce from scratch."
    ],
    "it": [
      "La Brasserie des Deux Rives, la Nouvelle Garde di Lione, rivisita tutti i grandi classici della brasserie francese. Ogni giorno, l'allegra brigata cucina dalla A alla Z, utilizzando i migliori prodotti francesi di provenienza locale."
    ],
    "fr": [
      "La Brasserie des Deux Rives, maison lyonnaise de la Nouvelle Garde, revisite tous les grands classiques de la brasserie française. La joyeuse brigade cuisine chaque jour de A à Z les meilleurs produits du terroir français, sourcés localement."
    ],
    "es": [
      "La Brasserie des Deux Rives, la Nouvelle Garde lionesa, revisita todos los grandes clásicos de la brasserie francesa. Cada día, la alegre brigada cocina de la A a la Z, utilizando los mejores productos franceses de origen local."
    ],
    "nl": [
      "Brasserie des Deux Rives, de Nouvelle Garde uit Lyon, herneemt alle grote klassiekers van de Franse brasserie. Elke dag kookt de vrolijke brigade van A tot Z met de beste lokale Franse producten."
    ]
  },
