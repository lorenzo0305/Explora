  "rdfs:comment": {
    "de": [
      "Als passionierte Ski- und Bergprofis wissen wir, wie wir die ersten Gleitversuche Ihrer Kinder begleiten und Sie durch das fabelhafte Skigebiet von La Plagne und Paradiski® führen können."
    ],
    "en": [
      "Our ski and mountain professionals will accompany your children's first turns on skis and guide you in the fabulous La Plagne and Paradiski® area."
    ],
    "it": [
      "Siamo appassionati di sci e di montagna e guideremo i vostri bambini attraverso le favolose aree di La Plagne e Paradiski®."
    ],
    "fr": [
      "Professionels passionnés du ski et de la montagne nous saurons accompagner les premières glisses de vos enfants et vous guider sur le fabuleux domaine de la Plagne et du Paradiski®."
    ],
    "nl": [
      "Wij zijn  professionals, gepassioneerd door het skiën en de bergen, en wij kunnen  uw kinderen begeleiden op hun eerste afdalingen en u leiden op het prachtige skigebied van La Plagne en Paradiski®."
    ],
    "es": [
      "Nos apasiona el esquí y la montaña, y guiaremos a sus hijos por las fabulosas zonas de La Plagne y Paradiski®."
    ]
  },
