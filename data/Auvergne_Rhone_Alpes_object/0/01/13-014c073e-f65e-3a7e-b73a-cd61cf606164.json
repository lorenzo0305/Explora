  "rdfs:comment": {
    "de": [
      "Handarbeit von Geschirr in glänzender Fayence. Ein traditionelles Know-How; das einzige(einzigartige) handwerkliche einem altüberlieferten Rezept(Einnahme) folgende Stück(Zimmer): 2 Kochen im Ofen und ein enfumage in Wald(Holz)."
    ],
    "en": [
      "Handicraft production of pottery made from earthenware. Traditional “savoir-faire”: cooked in a wood-fired oven."
    ],
    "it": [
      "Produzione artigianale di ceramiche realizzate con cura nella Faïence Lustrée. Utilizzo un'argilla e uno smalto di tipo culinario\r\nLa terza cottura a legna conferisce a ogni pezzo un aspetto unico con riflessi metallici e iridescenti."
    ],
    "fr": [
      "Production artisanale de poteries réalisées avec soin en Faïence Lustrée. j'utilise une terre et un émail culinaires. \r\nLa 3ème cuisson au feu de bois confère à chaque pièce un aspect unique avec des reflets métallisés et irisés."
    ],
    "es": [
      "Producción artesanal de cerámica realizada con esmero en Faïence Lustrée. Utilizo una arcilla culinaria y un esmalte\r\nLa tercera cocción en un fuego de leña da a cada pieza un aspecto único con reflejos metálicos e iridiscentes."
    ],
    "nl": [
      "Handgemaakt aardewerk met zorg gemaakt in Faïence Lustrée. Ik gebruik een culinaire klei en glazuur.\r\nDe 3e bakbeurt boven een houtvuur geeft elk stuk een unieke uitstraling met metallic en iriserende reflecties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Petit Scarabée"
    ]
  },
