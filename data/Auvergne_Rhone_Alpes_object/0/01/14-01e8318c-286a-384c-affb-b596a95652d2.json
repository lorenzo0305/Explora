      "@id": "https://data.datatourisme.fr/2bdd5a7e-824c-3f24-9665-fbb8621feb91",
      "dc:description": {
        "de": [
          "Hochzeits- und Porträtfotograf in Montreuil-sur-Mer. Er stellt sein Talent in den Dienst Ihrer Veranstaltungen.\nEr bietet Ihnen sogar den Verleih von Photobooths an."
        ],
        "en": [
          "Wedding and portrait photographer based in Montreuil-sur-Mer. He puts his talent to work for your events.\nHe can even rent you a photobooth."
        ],
        "it": [
          "Fotografo di matrimoni e ritratti con sede a Montreuil-sur-Mer. Mette il suo talento al servizio dei vostri eventi.\nPuò anche noleggiare un photobooth."
        ],
        "fr": [
          "Photographe de mariage, de portrait installé à Montreuil-sur-Mer. Il met son talent au service de vos évènements. \nIl vous propose même la location de photobooth."
        ],
        "es": [
          "Fotógrafo de bodas y retratos afincado en Montreuil-sur-Mer. Pone su talento al servicio de sus eventos.\nIncluso puede alquilarle un fotomatón."
        ],
        "nl": [
          "Bruids- en portretfotograaf gevestigd in Montreuil-sur-Mer. Hij stelt zijn talent ten dienste van uw evenementen.\nHij kan zelfs een photobooth voor je huren."
        ]
      },
