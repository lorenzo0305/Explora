  "rdfs:comment": {
    "de": [
      "Die wichtigsten Aufgaben des Reiterhofs du Solat sind :- Die Zucht von Lusitanos- die Ausbildung von jungen Pferden- Unterbringung von Pferden- Dressur in der Unter- und Oberstufe- Reitanimationen"
    ],
    "en": [
      "\"The main activities of the Solat Equestrian Centre are:\r\n- Lusitanian horse-breeding\r\n- Educating young horses\r\n- Livery\r\n- Haute-école and basse-école dressage\r\n- Equestrian events\""
    ],
    "it": [
      "Il Domaine du Solat è un allevamento di cavalli lusitani e una scuderia per cavalli allevati dai proprietari."
    ],
    "fr": [
      "Le Domaine du Solat est un élevage de chevaux lusitaniens, et une écurie de chevaux de propriétaires."
    ],
    "nl": [
      "Het Domaine du Solat is een fokkerij voor Lusitano paarden en een stal voor door de eigenaar gefokte paarden."
    ],
    "es": [
      "El Domaine du Solat es una granja de cría de caballos lusitanos y un establo para caballos criados por sus propietarios."
    ]
  },
