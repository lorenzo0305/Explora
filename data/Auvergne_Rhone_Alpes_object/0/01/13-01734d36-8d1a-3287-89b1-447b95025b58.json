  "rdfs:comment": {
    "de": [
      "Was wäre, wenn das Wiedererleben von Kindheitserinnerungen zu einem Tanz werden könnte? Attendez-Moi! führt uns in eine intime und poetische Welt."
    ],
    "en": [
      "What if reliving childhood memories could become a dance? Wait for me! takes us into an intimate, poetic universe."
    ],
    "it": [
      "E se rivivere i ricordi dell'infanzia potesse diventare una danza? Wait for me! ci porta in un mondo intimo e poetico."
    ],
    "fr": [
      "Et si revivre ses souvenirs d’enfance pouvait devenir une danse ? Attendez-Moi ! nous entraîne dans un univers intime et poétique."
    ],
    "es": [
      "¿Y si revivir los recuerdos de la infancia pudiera convertirse en un baile? Espérame! nos adentra en un mundo íntimo y poético."
    ],
    "nl": [
      "Wat als het herbeleven van jeugdherinneringen een dans zou kunnen worden? Wacht op mij! neemt ons mee naar een intieme, poëtische wereld."
    ]
  },
  "rdfs:label": {
