  "rdfs:comment": {
    "de": [
      "2 Origami-Einführungsworkshops zu den Themen Frühling und Ostern mit AZACRAFT.\r\nErwachsene und Kinder ab 8 Jahren, 7 Jahre in Begleitung eines älteren Kindes.\r\nIn La Tanière des Jeux."
    ],
    "en": [
      "2 introductory origami workshops on the theme of spring and Easter with AZACRAFT.\r\nAdults and children aged 8 and over, 7 years old accompanied by an older child.\r\nAt La Tanière des Jeux."
    ],
    "it": [
      "2 laboratori introduttivi di origami sul tema della primavera e della Pasqua con AZACRAFT.\r\nAdulti e bambini a partire dagli 8 anni, 7 anni accompagnati da un bambino più grande.\r\nPresso La Tanière des Jeux."
    ],
    "fr": [
      "2 ateliers d’initiation à l’origami sur le thème du printemps et de pâques avec AZACRAFT. \r\nAdulte et enfant à partir de 8 ans, 7 ans accompagné d’un plus grand. \r\nA La Tanière des Jeux."
    ],
    "es": [
      "2 talleres de iniciación a la papiroflexia sobre el tema de la primavera y la Pascua con AZACRAFT.\r\nAdultos y niños a partir de 8 años, 7 años acompañados de un niño mayor.\r\nEn La Tanière des Jeux."
    ],
    "nl": [
