  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8c3ecd5e-9ea5-3369-849f-13632489b7a8",
      "dc:description": {
        "de": [
          "Ein Grafiktablett, wie funktioniert das?\" Lernen Sie diese Technik kennen und tauschen Sie sich mit dem Künstler Argegro Joseph Skrida am Samstag, den 15. März von 10:00 bis 11:30 Uhr im Rahmen des Connected Club aus."
        ],
        "en": [
          "How does a graphic tablet work? Come and discover this technique and chat with artist Argegro Joseph Skrida, on Saturday March 15 from 10:00 to 11:30 as part of the Connected Club."
        ],
        "it": [
          "Come funziona una tavoletta grafica? Venite a scoprire questa tecnica e a chiacchierare con l'artista Argegro Joseph Skrida, sabato 15 marzo dalle 10.00 alle 11.30 nell'ambito del Connected Club."
        ],
        "fr": [
          "Une tablette graphique, comment ça marche ?\" Venez découvrir cette technique et échanger avec l'artiste Argegro Joseph Skrida, le samedi 15 mars de 10h00 à 11h30 dans le cadre du Club Connecté."
        ],
        "es": [
          "¿Cómo funciona una tableta gráfica? Ven a descubrir esta técnica y a charlar con el artista Argegro Joseph Skrida, el sábado 15 de marzo de 10:00 a 11:30 en el marco del Club Conectado."
        ],
        "nl": [
          "Hoe werkt een grafisch tablet? Kom meer te weten over deze techniek en praat met de kunstenaar Argegro Joseph Skrida, op zaterdag 15 maart van 10.00 tot 11.30 uur als onderdeel van de Connected Club."
        ]
      },
