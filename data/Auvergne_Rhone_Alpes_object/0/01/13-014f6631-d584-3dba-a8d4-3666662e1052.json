  "rdfs:comment": {
    "de": [
      "Seit 1912, im Zentrum des Dorfes gelegen, lädt La Bérangère Sie ein, seine traditionelle savoyische Küche, seine Burger und seine hausgemachten Cocktails in einer geselligen Atmosphäre zu teilen"
    ],
    "en": [
      "Located in the village center, La Berangere has a large selection of salads, specialties and desserts."
    ],
    "it": [
      "dal 1912, situata al centro del paese, La Bérangère vi invita ad assaporare la sua cucina tradizionale savoiarda, galettes, gastro burgers, cocktail della casa e un’eccellente carta di vini, in un’ottima atmosfera."
    ],
    "fr": [
      "Depuis 1912, située au centre du village, La Bérangère vous invite à partager sa cuisine traditionnelle savoyarde, ses burgers, ses cocktails maison  dans une ambiance conviviale"
    ],
    "nl": [
      "Sinds 1912, gelegen in het centrum van het dorp, nodigt La Bérangère u uit om haar traditionele Savoyaardse keuken, haar hamburgers, haar huisgemaakte cocktails te delen in een vriendelijke sfeer"
    ],
    "es": [
      "Desde 1912, situado en el centro del pueblo, La Bérangère le invita a compartir su cocina tradicional saboyana, sus hamburguesas, sus cócteles caseros en un ambiente acogedor.."
    ]
  },
