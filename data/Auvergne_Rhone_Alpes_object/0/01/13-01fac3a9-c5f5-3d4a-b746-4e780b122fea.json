  "rdfs:comment": {
    "de": [
      "Alexandre LUCAS BARDOT, Imker in Chevagnes seit 2017 mit 800 Bienenstöcken, wir bieten Ihnen 5 natürliche Honigsorten an (cremiger Honig, Akazienhonig, Wiesenhonig, Kastanienhonig und Sonnenblumenhonig)"
    ],
    "en": [
      "Alexandre LUCAS BARDOT, beekeeper in Chevagnes since 2017 with 800 hives, we offer 5 types of natural honey (Creamy honey, Acacia honey, Prairie honey, Chestnut honey and Sunflower honey)"
    ],
    "it": [
      "Alexandre LUCAS BARDOT, apicoltore a Chevagnes dal 2017 con 800 alveari, offriamo 5 tipi di miele naturale (Miele cremoso, Miele di acacia, Miele di prateria, Miele di castagno e Miele di girasole)"
    ],
    "fr": [
      "Alexandre LUCAS BARDOT, apiculteur à Chevagnes depuis 2017 avec 800 ruches, nous vous proposons 5 types de miels naturels (miel Crémeux, miel d'Acacia, miel de Prairie, miel de Châtaignier et miel de Tournesol)"
    ],
    "nl": [
      "Alexandre LUCAS BARDOT, imker in Chevagnes sinds 2017 met 800 bijenkasten, wij bieden 5 soorten natuurlijke honing aan (Roomhoning, Acaciahoning, Prairiehoning, Kastanjehoning en Zonnebloemhoning)"
    ],
    "es": [
      "Alexandre LUCAS BARDOT, apicultor en Chevagnes desde 2017 con 800 colmenas, ofrecemos 5 tipos de miel natural (miel cremosa, miel de acacia, miel de pradera, miel de castaño y miel de girasol)"
    ]
  },
