  "rdfs:comment": {
    "de": [
      "Der Gargot ist ein Tieflandbach, der durch Umgestaltungen renaturiert wurde, um Forellen und Äschen zu beherbergen."
    ],
    "en": [
      "The Gargot is a lowland stream that has been renatured by improvements to accommodate trout and grayling."
