  "rdfs:comment": {
    "de": [
      "Nach einer Totalrenovierung im Sommer 2025 wird die Poutran-Gondelbahn, die Oz 3300 mit L'Alpe d'Huez verbindet, im Winter 2026 wiedereröffnet!"
    ],
    "en": [
      "After undergoing complete renovation during the summer of 2025, the Poutran gondola lift connecting Oz 3300 to Alpe d'Huez will reopen for the 2026 winter season!"
    ],
    "it": [
      "Dopo una ristrutturazione totale durante l'estate del 2025, la cabinovia Poutran, che collega Oz 3300 a l'Alpe d'Huez, riaprirà per l'inverno del 2026!"
    ],
    "fr": [
      "Après une rénovation totale durant l'été 2025, la télécabine de Poutran, reliant Oz 3300 à l'Alpe d'Huez, réouvrira pour l'hiver 2026 !"
    ],
    "es": [
      "Tras una renovación total durante el verano de 2025, el telecabina Poutran, que une Oz 3300 con l'Alpe d'Huez, reabrirá para el invierno de 2026"
    ],
    "nl": [
      "Na een totale renovatie in de zomer van 2025 gaat de kabelbaan van Poutran, die Oz 3300 met Alpe d'Huez verbindt, in de winter van 2026 weer open!"
    ]
  },
