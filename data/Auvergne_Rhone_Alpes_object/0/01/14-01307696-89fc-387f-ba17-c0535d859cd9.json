  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/918179ee-0dea-3c26-8064-6f9bd6990dce",
      "dc:description": {
        "de": [
          "Bar, Weinkeller, Brennerei und Teestube.\n\nFrançois und Vianney empfangen Sie in einer warmen und freundlichen Umgebung und zeigen Ihnen ihre Nuggets."
        ],
        "en": [
          "Bar, wine cellar, grill and tea room.\n\nFrançois and Vianney welcome you in a warm and friendly atmosphere to discover their nuggets."
        ],
        "it": [
          "Bar, cantina, grill e sala da tè.\n\nFrançois e Vianney vi accolgono in un'atmosfera calda e amichevole e vi faranno scoprire le loro pepite."
        ],
        "fr": [
          "Bar, cave à vin, brûlerie et salon de thé.\n\nFrançois et Vianney vous accueillent dans un cadre chaleureux et convivial et vous feront découvrir leurs pépites."
        ],
        "nl": [
          "Bar, wijnkelder, grill en theesalon.\n\nFrançois en Vianney verwelkomen je in een warme en vriendelijke sfeer en zullen je helpen hun klompjes te ontdekken."
        ],
        "es": [
          "Bar, bodega, asador y salón de té.\n\nFrançois y Vianney le dan la bienvenida en un ambiente cálido y acogedor y le ayudarán a descubrir sus pepitas."
        ]
      },
