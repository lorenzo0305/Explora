  "rdfs:comment": {
    "de": [
      "Die Agentur Layeux in La Giettaz en Aravis und Autrans-Méaudre en Vercors begleitet ihre Kunden seit 2016 bei der Erstellung ihrer Kommunikationsprojekte in den Bereichen Web (Website), Digital und Infografik (Logo, Broschüre...)."
    ],
    "en": [
      "The Layeux Agency in La Giettaz en Aravis and Autrans-Méaudre en Vercors has been assisting its clients since 2016 in the creation of their communication projects in Web (website), Digital and Computer Graphics (logo, brochure...)."
    ],
    "it": [
      "L'Agence Layeux di La Giettaz en Aravis e Autrans-Méaudre en Vercors supporta i suoi clienti dal 2016 nella creazione dei loro progetti di comunicazione web (sito web), digitale e di computer grafica (logo, brochure, ecc.)."
    ],
    "fr": [
      "L’Agence Layeux à la Giettaz en Aravis et à Autrans-Méaudre en Vercors accompagne ses clients depuis 2016 dans la création de leurs projets de communication en Web (site internet), Digitale et Infographie (logo, brochure...)."
    ],
    "nl": [
      "Agence Layeux in La Giettaz en Aravis en Autrans-Méaudre en Vercors ondersteunt haar klanten sinds 2016 bij de creatie van hun web (website), digitale en computergrafische (logo, brochure, etc.) communicatieprojecten."
    ],
    "es": [
      "Agence Layeux en La Giettaz en Aravis y Autrans-Méaudre en Vercors acompaña a sus clientes desde 2016 en la creación de sus proyectos de comunicación web (sitio web), digital e infografía (logotipo, folleto, etc.)."
    ]
