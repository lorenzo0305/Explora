  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Honig, den unsere Imker produzieren, sowie alle unsere hausgemachten Produkte auf Honigbasis.\r\nEine Honigverkostung ist das ganze Jahr über während der Öffnungszeiten unseres Ladens möglich."
    ],
    "en": [
      "Discover the honey produced by our beekeepers, as well as all our home-made honey products.\r\nHoney tasting is available all year round during our store opening hours."
    ],
    "it": [
      "Scoprite il miele prodotto dai nostri apicoltori e tutti i nostri prodotti artigianali.\r\nLa degustazione del miele è disponibile tutto l'anno durante gli orari di apertura del nostro negozio."
    ],
    "fr": [
      "Découvrez le miel produit par nos apiculteurs, ainsi que tous nos produits fait maison à base de miel.\r\nUne dégustation de miel est possible toute l’année pendant les heures d’ouverture de notre boutique."
    ],
    "nl": [
      "Ontdek de honing van onze imkers en al onze zelfgemaakte honingproducten.\r\nHoning proeven kan het hele jaar door tijdens de openingstijden van onze winkel."
    ],
    "es": [
      "Descubra la miel producida por nuestros apicultores, así como todos nuestros productos de miel artesanal.\r\nLa degustación de miel está disponible todo el año durante el horario de apertura de nuestra tienda."
    ]
  },
  "rdfs:label": {
