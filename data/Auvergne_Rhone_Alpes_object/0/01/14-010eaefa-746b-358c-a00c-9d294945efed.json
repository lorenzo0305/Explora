  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e1884110-2a62-3b8c-bf08-8d3cbfe92115",
      "dc:description": {
        "de": [
          "Ein Buch, ein Atelier, ein Autor... Nach der Lektüre einiger Alben von Hervé Tullet lädt Emilie Sie ein, ohne Hemmungen in die Welt dieses Künstlers einzutauchen, um gemeinsam eine \"ideale Expo\" zu schaffen."
        ],
        "en": [
          "A book, a workshop, an author... After reading a few of Hervé Tullet's albums, Emilie invites you to plunge into the artist's universe to create an \"Ideal Expo\" together."
        ],
        "it": [
          "Un libro, un laboratorio, un autore... Dopo aver letto alcuni album di Hervé Tullet, Emilie vi invita a tuffarvi nel mondo di questo artista per creare insieme un \"Expo ideale\"."
        ],
        "fr": [
          "Un livre, un atelier, un auteur... Après la lecture de quelques albums d'Hervé Tullet, Emilie vous invite à plonger sans retenue dans l'univers de cet artiste pour créer ensemble une \"Expo idéale\"."
        ],
        "es": [
          "Un libro, un taller, un autor... Tras leer algunos de los álbumes de Hervé Tullet, Emilie le invita a sumergirse de lleno en el universo de este artista para crear juntos una \"Expo ideal\"."
        ],
        "nl": [
          "Een boek, een workshop, een auteur... Na het lezen van enkele albums van Hervé Tullet, nodigt Emilie je uit om je onder te dompelen in de wereld van deze artiest om samen een \"ideale Expo\" te creëren."
        ]
      },
