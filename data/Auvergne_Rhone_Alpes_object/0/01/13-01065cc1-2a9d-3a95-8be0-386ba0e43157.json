  "rdfs:comment": {
    "de": [
      "Französisches Billard (oder Carambole), 5-Kegel-Spiel, amerikanisches Billard und Blackball.\r\nSpiele sind den Mitgliedern vorbehalten.\r\nOrganisiert manchmal Entdeckungsabende..."
    ],
    "en": [
      "Pool and French billiards for those aged 12+....We Organize evenings for people, groupes, or team building for firms   to learn billards  either blackball ( pool) , American billards  , french billards ( carambole ) or 5 Quille ( Italian game )    We also play petanque   on a billard table with billard balls. An evening    to chill out  ."
    ],
    "it": [
      "Biliardo francese (o carambola), biliardo a 5 birilli, blackball e biliardo americano.\r\nGiochi riservati ai soci.\r\nA volte organizza serate di scoperta\r\nOffre un periodo di prova di un mese"
    ],
    "fr": [
      "Billard français (ou carambole), jeu des 5 quilles, billard blackball et billard Américain.\r\nJeux réservés aux adhérents.\r\nOrganise parfois des soirées découvertes\r\nPropose de faire un mois d'essai"
    ],
    "nl": [
      "Frans biljart (of carambole), 5-pins biljart, Amerikaans biljart en blackball.\r\nSpelletjes gereserveerd voor leden.\r\nOrganiseert soms ontdekkingsavonden..."
    ],
    "es": [
      "Billar francés (o de carambola), billar de 5 bolos, blackball y billar americano.\r\nJuegos reservados a los socios.\r\nA veces organiza veladas de descubrimiento\r\nPeriodo de prueba de un mes"
    ]
  },
