  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0fb56c61-0440-32fe-8724-3e2b9a6719c5",
      "dc:description": {
        "de": [
          "Informationen :\n\n\nTage der Öffnung:\nDienstag bis Samstag: 9h - 12h / 14h - 17h\nSonntag: 9h - 12h\n\nMontag geschlossen\n\nAbholung:\nNur zum Mitnehmen auf Bestellung.\n\nAchtung kein Laden.\n\nBestellungen:\nPer Telefon unter 07 67 33 33 46 oder per Messenger.\n\nBestellung muss 48 Stunden im Voraus erfolgen.\n\nZahlung nur per Scheck oder in bar\n "
        ],
        "en": [
          "Information :\n\n\nOpening days:\nTuesday to Saturday: 9am - 12pm / 2pm - 5pm\nSunday: 9h - 12h\n\nClosed on Monday\n\nPick-up :\nTakeaway only on order.\n\nNo store.\n\nOrdering:\nBy phone 07 67 33 33 46 or by Messenger.\n\nOrder 48 hours in advance.\n\nPayment by cheque or cash only\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\n\nGiorni di apertura:\nDa martedì a sabato: 9.00 - 12.00 / 14.00 - 17.00\nDomenica: 9.00 - 12.00\n\nChiuso il lunedì\n\nRitiro :\nDa asporto solo su ordinazione.\n\nNessun negozio.\n\nPer ordinare :\nPer telefono al numero 07 67 33 33 46 o tramite Messenger.\n\nOrdinare con 48 ore di anticipo.\n\nPagamento solo con assegno o in contanti\n "
        ],
        "fr": [
          "Informations :\n\n\nJours d'ouverture:\nDu mardi au Samedi:   9h - 12h / 14h - 17h\nDimanche 9h - 12h\n\nFermé le lundi\n\nRetrait :\nUniquement à emporter sur commande. \n\nAttention pas de magasin.\n\nCommandes :\nPar téléphone au 07 67 33 33 46 ou par Messenger. \n\nCommande à passer 48h à l'avance. \n\nPaiement en chèque ou en espèce uniquement\n "
        ],
        "nl": [
          "Meer informatie :\n\n\nOpeningsdagen:\nDinsdag tot zaterdag: 9u - 12u / 14u - 17u\nZondag: 9u - 12u\n\nMaandag gesloten\n\nAfhalen :\nAfhalen alleen op bestelling.\n\nGeen winkel.\n\nOm te bestellen :\nTelefonisch op 07 67 33 33 46 of via Messenger.\n\nBestel 48 uur van tevoren.\n\nBetaling alleen per cheque of contant\n "
        ],
        "es": [
          "Más información :\n\n\nDías de apertura:\nDe martes a sábado: 9.00 h - 12.00 h / 14.00 h - 17.00 h\nDomingo de 9h a 12h\n\nLunes cerrado\n\nRecogida :\nPara llevar sólo bajo pedido.\n\nNo hay tienda.\n\nPara hacer un pedido :\nPor teléfono en el 07 67 33 33 46 o por Messenger.\n\nPedidos con 48 horas de antelación.\n\nPago mediante cheque o en efectivo\n "
        ]
      },
