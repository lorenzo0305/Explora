  "rdfs:comment": {
    "de": [
      "Sophies Gärten sind auf den Gartenbau spezialisiert und produzieren lokal und nachhaltig Blumen, Gemüsepflanzen, Zierpflanzen und aromatische Pflanzen."
    ],
    "en": [
      "Specializing in horticulture, Jardins de Sophie produces flowers, vegetable plants, ornamental nursery plants and aromatic plants locally and in a sustainable way."
    ],
    "it": [
      "Specializzata in orticoltura, Les Jardins de Sophie produce fiori, piante da orto, piante ornamentali da vivaio e piante aromatiche a livello locale e in modo sostenibile."
    ],
    "fr": [
      "Spécialisés dans l'horticulture, les Jardins de Sophie produisent localement et de manière raisonnée des fleurs, plants potager, pépinière d'ornements et des plantes aromatiques."
    ],
    "nl": [
      "Les Jardins de Sophie is gespecialiseerd in tuinbouw en produceert bloemen, groenteplanten, sierplanten en aromatische planten lokaal en op een duurzame manier."
    ],
    "es": [
      "Especializados en horticultura, Les Jardins de Sophie producen flores, plantas hortícolas, plantas ornamentales de vivero y plantas aromáticas de forma local y sostenible."
    ]
  },
