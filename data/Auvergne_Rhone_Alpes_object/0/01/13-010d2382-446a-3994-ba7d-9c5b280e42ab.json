  "rdfs:comment": {
    "de": [
      "Die Alchemilla bietet die Möglichkeit, Pflanzen als Quelle des Wissens zu entdecken. Zwischen Wissenschaft und Traditionen die Verbindungen zwischen Menschen und Pflanzen erkunden ..."
    ],
    "en": [
      "L'alchemille proposes to discover plants, a source of knowledge. Between science and tradition, explore the links between people and plants ..."
    ],
    "it": [
      "L'alchimista si propone di scoprire le piante come fonte di conoscenza. Tra scienza e tradizione, esplorate i legami che uniscono persone e piante ..."
    ],
    "fr": [
      "L'alchemille propose de découvrir les plantes, source de savoir. Entre sciences et traditions, explorer les liens qui unissent les hommes et les plantes ..."
    ],
    "nl": [
      "L'alchemille stelt voor planten te ontdekken als bron van kennis. Tussen wetenschap en traditie, verken de banden die mensen en planten verenigen ..."
    ],
    "es": [
      "L'alchemille se propone descubrir las plantas como fuente de conocimiento. Entre la ciencia y la tradición, explore los vínculos que unen a las personas y las plantas ..."
    ]
  },
