  "rdfs:comment": {
    "de": [
      "Im Herzen von Glandieu, gegenüber dem wunderschönen Wasserfall, finden Sie unser Restaurant mit seiner schattigen Terrasse unter einer über 400 Jahre alten Platane."
    ],
    "en": [
      "In the heart of Glandieu, facing the magnificent waterfall, discover our restaurant with its shaded terrace under a 200-year-old plane tree."
    ],
    "it": [
      "Nel cuore di Glandieu, di fronte alla magnifica cascata, scoprite il nostro ristorante con la sua terrazza ombreggiata da un platano di 400 anni."
    ],
    "fr": [
      "Au cœur de Glandieu, face à la magnifique cascade, découvrez notre restaurant avec sa terrasse ombragée sous un platane âgé de plus 400 ans."
    ],
    "nl": [
      "Ontdek in het hart van Glandieu, tegenover de prachtige waterval, ons restaurant met zijn terras in de schaduw van een 400 jaar oude plataan."
    ],
    "es": [
      "En el corazón de Glandieu, frente a la magnífica cascada, descubra nuestro restaurante con su terraza sombreada bajo un plátano de 400 años."
    ]
  },
