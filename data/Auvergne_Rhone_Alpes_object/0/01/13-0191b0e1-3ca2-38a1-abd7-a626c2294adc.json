  "rdfs:comment": {
    "de": [
      "Auf unserem landwirtschaftlichen Betrieb bemühen wir uns um die Erzeugung, Verarbeitung und Vermarktung von Qualitätsprodukten: Kuhkäse, Geflügel (Hähnchen/Pintade), Eier, Hacksteaks, Lammfleischpakete."
    ],
    "en": [
      "On our farm, we strive to produce, process and market quality products: cow's milk cheese, poultry (chicken/pintade), eggs, minced steak, lamb parcels."
    ],
    "it": [
      "Nella nostra azienda agricola lavoriamo duramente per produrre, trasformare e commercializzare prodotti di qualità: formaggio di latte vaccino, pollame (pollo e faraona), uova, bistecca macinata e pacchi di agnello."
    ],
    "fr": [
      "Sur notre exploitation agricole, nous nous appliquons à produire, transformer et commercialiser des produits de qualité : fromages de vache, volailles (poulets/pintades), œufs, steak hachés, colis d'agneau."
    ],
    "nl": [
      "Op onze boerderij werken we hard aan de productie, verwerking en verkoop van kwaliteitsproducten: koemelkkaas, gevogelte (kip en parelhoen), eieren, gehakt en lamsvlees."
    ],
    "es": [
      "En nuestra granja trabajamos duro para producir, transformar y comercializar productos de calidad: queso de leche de vaca, aves de corral (pollo y pintada), huevos, carne picada y paquetes de cordero."
    ]
  },
  "rdfs:label": {
