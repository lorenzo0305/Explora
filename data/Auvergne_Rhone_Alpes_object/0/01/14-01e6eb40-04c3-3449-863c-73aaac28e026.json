      "@id": "https://data.datatourisme.fr/4cf506e8-cf97-3e95-8030-ac7c7299d1b8",
      "dc:description": {
        "de": [
          "Konzert in der St.-Nikolaus-Kirche\nAm Sonntag, den 21. September um 14:30 Uhr\nGemeinde Longvilliers\n----------------------------\nMusikalische und gesangliche Parenthese zum Klang von Noten von 1859 bis 1934\n\nInformationen: Marie-Paul Lecoutre unter 03 21 05 47 80\nFreier Eintritt"
        ],
        "en": [
          "Concert in Saint-Nicolas church\nSunday, September 21 at 2:30 pm\nCommune of Longvilliers\n----------------------------\nA musical and sung interlude to the sound of notes from 1859 to 1934\n\nInformation: Marie-Paul Lecoutre on 03 21 05 47 80\nFree admission"
        ],
        "it": [
          "Concerto nella chiesa di Saint-Nicolas\nDomenica 21 settembre alle 14.30\nComune di Longvilliers\n----------------------------\nUn intermezzo musicale e cantato al suono delle note dal 1859 al 1934\n\nInformazioni: Marie-Paul Lecoutre allo 03 21 05 47 80\nIngresso libero"
        ],
        "fr": [
          "Concert dans l'église Saint-Nicolas\nLe dimanche 21 septembre à 14h30\nCommune de Longvilliers\n----------------------------\nParenthèse musicale et chantée au son de notes de 1859 à 1934\n\nInformations : Marie-Paul Lecoutre au 03 21 05 47 80\nEntrée libre"
        ],
        "es": [
          "Concierto en la iglesia de Saint-Nicolas\nDomingo 21 de septiembre a las 14.30 h\nAyuntamiento de Longvilliers\n----------------------------\nUn interludio musical y cantado al son de las notas de 1859 a 1934\n\nInformación: Marie-Paul Lecoutre en el 03 21 05 47 80\nEntrada gratuita"
        ],
        "nl": [
          "Concert in de kerk van Saint-Nicolas\nZondag 21 september om 14.30 uur\nGemeente Longvilliers\n----------------------------\nEen muzikaal en gezongen intermezzo op het geluid van noten van 1859 tot 1934\n\nInlichtingen: Marie-Paul Lecoutre op 03 21 05 47 80\nGratis toegang"
        ]
      },
