  "rdfs:comment": {
    "de": [
      "Ich bin seit drei Jahren als selbstständige Aquarellillustratorin tätig. Meine Welt ist sanft und poetisch, sehr inspiriert von der Jugendillustration. Ich male besonders gerne kleine Tiere mit einer besonderen Leidenschaft für den Fuchs und runde Formen."
    ],
    "en": [
      "I've been a freelance watercolor illustrator for 3 years. My world is soft and poetic, inspired by children's illustration. I particularly enjoy painting small animals, with a particular passion for foxes and round shapes."
    ],
    "it": [
      "Sono un'illustratrice freelance ad acquerello da 3 anni. Il mio mondo è dolce e poetico, ispirato all'illustrazione per bambini. Mi piace particolarmente dipingere piccoli animali, con una passione particolare per le volpi e le forme rotonde."
    ],
    "fr": [
      "Je suis illustratrice à l'aquarelle à mon compte depuis 3 ans. Mon univers est doux et poétique, très inspirée de l'illustration jeunesse. J'aime particulièrement peindre des petits animaux avec une passion particulière pour le renard, les formes rondes."
    ],
    "es": [
      "Soy ilustradora independiente en acuarela desde hace 3 años. Mi mundo es suave y poético, inspirado en la ilustración infantil. Me gusta especialmente pintar animales pequeños, con una pasión particular por los zorros y las formas redondas."
    ],
    "nl": [
      "Sinds 3 jaar ben ik freelance aquarelillustrator. Mijn wereld is zacht en poëtisch, geïnspireerd door kinderillustratie. Ik schilder vooral graag kleine dieren, met een bijzondere passie voor vossen en ronde vormen."
    ]
  },
  "rdfs:label": {
