  "rdfs:comment": {
    "de": [
      "Möbeltischler, Tischler für Möbel. Zeitgenössische Möbel - Stilkopien - Dekorationsgegenstände aus Massivholz, Feinholzfurnier oder Intarsien, Restaurierung von Möbeln und antiken Gegenständen."
    ],
    "en": [
      "Cabinetmaker, furniture carpenter. Contemporary furniture - style copies - decorative objects in solid wood, fine veneer or marquetry, restoration of antique furniture and objects."
    ],
    "it": [
