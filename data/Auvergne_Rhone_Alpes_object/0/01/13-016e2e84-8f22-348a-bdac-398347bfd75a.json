  "rdfs:comment": {
    "de": [
      "Aqualis liegt im Herzen eines Gebäudes aus den 30er Jahren und empfängt Sie in einem Universum, das dem größten natürlichen See Frankreichs gewidmet ist: dem Lac du Bourget."
    ],
    "en": [
      "Nestled in the heart of a typical building of the 30s, Aqualis welcomes you in a unique universe dedicated to the largest natural lake in France: Lake Bourget."
    ],
    "it": [
      "Immerso nel cuore di un tipico edificio degli anni '30, Aqualis vi accoglie in un universo unico dedicato al più grande lago naturale della Francia: il lago del Bourget."
    ],
    "fr": [
      "Niché au coeur d’un bâtiment des années 30, Aqualis vous accueille dans un univers dédié au plus grand lac naturel de France : le lac du Bourget."
    ],
    "es": [
      "Enclavado en el corazón de un edificio de los años 30, Aqualis le da la bienvenida a un mundo dedicado al mayor lago natural de Francia: el Lac du Bourget."
    ],
    "nl": [
      "Aqualis, genesteld in het hart van een gebouw uit 1930, verwelkomt je in een wereld die gewijd is aan het grootste natuurlijke meer van Frankrijk: Lac du Bourget."
    ]
  },
