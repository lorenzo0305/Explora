  "rdfs:comment": {
    "de": [
      "Bereite deine schrecklichsten Kostüme vor und komm am Freitag, den 31. Oktober zu uns, um einen verrückten Abend im Festsaal von Saint-Romain- Lachalm zu erleben!"
    ],
    "en": [
      "Get your scariest costumes ready and join us on Friday, October 31st for a wild evening at the Saint-Romain-Lachalm village hall!"
    ],
    "it": [
      "Preparate i vostri costumi più spaventosi e unitevi a noi venerdì 31 ottobre per una serata selvaggia nella sala del villaggio di Saint-Romain-Lachalm!"
    ],
    "fr": [
      "Préparez vos costumes les plus terrifiants et rejoignez nous le vendredi 31 octobre pour une soirée de folie à la salle des fêtes de Saint-Romain- Lachalm !"
    ],
    "es": [
      "Prepara tus disfraces más terroríficos y únete a nosotros el viernes 31 de octubre para disfrutar de una velada salvaje en el ayuntamiento de Saint-Romain-Lachalm"
    ],
    "nl": [
      "Maak je engste kostuums klaar en kom op vrijdag 31 oktober naar het dorpshuis van Saint-Romain-Lachalm voor een wilde avond!"
    ]
  },
  "rdfs:label": {
