  "rdfs:comment": {
    "de": [
      "Die Basis ist die Liebe zur traditionellen Gastronomie, die Liebe zu den Bistrots bonne France, den Bouillons Parisiens und den Guinguettes auf dem Land."
    ],
    "en": [
      "Basically, we have a love of traditional gastronomy, a love of bistrots bonne France, Parisian bouillons and country guinguettes."
    ],
    "it": [
      "Fondamentalmente, abbiamo un amore per la gastronomia tradizionale, un amore per i bistrot della bonne France, i bouillons di Parigi e le guinguettes della campagna."
    ],
    "fr": [
      "À la base, on a l’amour de la gastronomie traditionnelle, l’amour des bistrots bonne France, des bouillons Parisiens, des guinguettes de campagne."
    ],
    "nl": [
      "Eigenlijk hebben we een voorliefde voor traditionele gastronomie, een voorliefde voor de bistrots van bonne France, de bouillons van Parijs en de guinguettes van het platteland."
    ],
    "es": [
      "Básicamente, somos amantes de la gastronomía tradicional, de los bistrots de la bonne France, los bouillons de París y las guinguettes del campo."
    ]
