  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Coinche-Wettbewerb teil, der vom Pétanque-Club 43 organisiert wird! Begleiten Sie uns ab 14 Uhr zu einem geselligen Nachmittag. Melden Sie sich vor Ort an und versuchen Sie, Preise zu gewinnen, während Sie sich amüsieren!"
    ],
    "en": [
      "Take part in the Coinche competition organized by Club Petanque 43! Join us for a convivial afternoon from 2pm. Register on site and try to win prizes while having fun!"
    ],
    "it": [
      "Partecipate alla gara di coinche organizzata dal Petanque Club 43! Unitevi a noi per un pomeriggio conviviale a partire dalle 14:00. Registratevi sul posto e provate a vincere dei premi divertendovi!"
    ],
    "fr": [
      "Participez au concours de coinche organisé par le club de pétanque 43 ! Rejoignez-nous pour une après-midi conviviale dès 14h. Inscrivez-vous sur place et tentez de remporter des prix tout en vous amusant !"
    ],
    "es": [
      "¡Participe en el concurso de coinche organizado por el Club de Petanca 43! Únase a nosotros en una tarde amistosa a partir de las 14:00 horas. ¡Inscríbete in situ e intenta ganar premios mientras te diviertes!"
    ],
    "nl": [
      "Doe mee aan de coinche competitie georganiseerd door Petanque Club 43! Doe mee aan een gezellige middag vanaf 14.00 uur. Schrijf je ter plekke in en probeer prijzen te winnen terwijl je plezier hebt!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concours de coinche"
    ]
  },
