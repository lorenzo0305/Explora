  "rdfs:comment": {
    "de": [
      "Ob zu Fuß oder mit Schneeschuhen, entdecken Sie die Berge zu jeder Jahreszeit mit einem Bergwanderführer oder einer Bergwanderführerin. Wanderungen für alle und jeden, thematische Wanderungen, Übernachtungen in Berghütten, Biwaks..."
    ],
    "en": [
      "By hiking or snowshoeing, come and discover the mountains in all seasons with a mountain guide. Hikes for everyone, themed hikes, night in a refuge, bivouac..."
    ],
    "it": [
      "Con un'escursione o una ciaspolata, vieni a scoprire la montagna in tutte le stagioni con una guida alpina. Escursioni per tutti, escursioni a tema, notte in rifugio, bivacco..."
    ],
    "fr": [
      "En randonnée pédestre ou en raquettes à neige, venez découvrir la montagne en toute saison avec un accompagnateur – accompagnatrice en montagne. Des randonnées pour toutes et tous, randos thématiques, nuit en refuge, bivouac.."
    ],
    "nl": [
      "Door te wandelen of te sneeuwschoenwandelen, kom en ontdek de bergen in alle seizoenen met een berggids. Wandeltochten voor iedereen, themawandelingen, overnachting in een berghut, bivak..."
    ],
    "es": [
      "De excursión o con raquetas de nieve, venga a descubrir la montaña en todas las estaciones con un guía de montaña. Paseos para todos los gustos, paseos temáticos, pernoctaciones en refugios de montaña, vivacs..."
    ]
  },
