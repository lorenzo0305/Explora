  "rdfs:comment": {
    "de": [
      "Ein Ort, der dem Know-how des Kunsthandwerks, der Kunst, der Kultur, der Weitergabe, den Begegnungen und der Entdeckung gewidmet ist, in einem majestätischen Gebäude in Aubenas: dem Hôtel Goudard-Ruelle."
    ],
    "en": [
      "The Hôtel Goudard-Ruelle, a majestic building in Aubenas, is a place dedicated to craftsmanship, art, culture, transmission, encounters and discovery."
    ],
    "it": [
      "L'Hôtel Goudard-Ruelle, un maestoso edificio di Aubenas, è un luogo dedicato all'artigianato, all'arte, alla cultura, alla trasmissione, all'incontro e alla scoperta."
    ],
    "fr": [
      "Lieu dédié aux savoir-faire des métiers d’art, à l’art, à la culture, à la transmission, aux rencontres et à la découverte au sein d’un bâtiment majestueux d’Aubenas : l’Hôtel Goudard-Ruelle."
    ],
    "nl": [
      "Hôtel Goudard-Ruelle, een majestueus gebouw in Aubenas, is een plek gewijd aan vakmanschap, kunst, cultuur, overdracht, ontmoetingen en ontdekkingen."
    ],
    "es": [
      "El Hôtel Goudard-Ruelle, majestuoso edificio de Aubenas, es un lugar dedicado a la artesanía, el arte, la cultura, la transmisión, el encuentro y el descubrimiento."
    ]
  },
