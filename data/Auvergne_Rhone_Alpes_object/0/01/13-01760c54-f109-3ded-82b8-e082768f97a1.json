  "rdfs:comment": {
    "de": [
      "Ein sanfter und herzlicher Moment, um das Stricken, Häkeln oder Weben zu erlernen und kleine Gegenstände aus Wolle herzustellen. Das Atelier ist für alle offen, das Material wird gestellt, in einer gemütlichen und geselligen Atmosphäre."
    ],
    "en": [
      "A warm, gentle moment to learn knitting, crochet or weaving and create small woollen objects. Workshop open to all, materials provided, in a warm and friendly atmosphere."
    ],
    "it": [
      "Un momento dolce e caldo per imparare a lavorare a maglia, all'uncinetto o a tessere e creare piccoli oggetti in lana. Laboratorio aperto a tutti, materiali forniti, in un'atmosfera calda e amichevole."
    ],
    "fr": [
      "Un moment doux et chaleureux pour s'initier au tricot, crochet ou tissage et créer de petits objets en laine. Atelier ouvert à tous, matériel fourni, dans une ambiance accueillante et conviviale."
    ],
    "es": [
      "Un momento suave y cálido para aprender a tejer, hacer ganchillo o tejer y crear pequeños objetos de lana. Taller abierto a todos, materiales proporcionados, en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Een rustig, warm moment om te leren breien, haken of weven en kleine wollen voorwerpen te maken. Workshop open voor iedereen, materialen aanwezig, in een warme en vriendelijke sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Échangeons nos savoirs : Création laine"
    ]
  },
