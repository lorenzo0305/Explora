  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7a7c13a1-1597-3690-81d2-d3de21468e63",
      "dc:description": {
        "de": [
          "MITTWOCH, 10., 17. und 24. DEZEMBER 2025\n\n10:15 Uhr / 11:30 Uhr ? C.S.C. \"Audrey BARTIER\" (=Schülerin)\n\nEntdeckung der Spiele und Spielzeuge der Ludothek mit der ganzen Familie.\n\nKostenlos\n\nTarif: Reservierung am Empfang erforderlich\nKostenlos\n\nAuskunft: C.S.C. \"Audrey BARTIER\" 03.21.33.29.53.\nE-Mail: accueil@cscwimereux.org"
        ],
        "en": [
          "WEDNESDAY DECEMBER 10, 17 and 24, 2025\n\n10h15 / 11h30 ? C.S.C. \"Audrey BARTIER\n\nDiscover games and toys from the toy library with your family.\n\nFree\n\nPrice: Reservations required at reception\nFree\n\nInformation : C.S.C. \" Audrey BARTIER \" 03.21.33.29.53.\nEmail : accueil@cscwimereux.org"
        ],
        "it": [
          "MERCOLEDI' 10, 17 e 24 DICEMBRE 2025\n\nore 10.15 / 11.30 ? C.S.C. \"Audrey BARTIER\n\nScoprite i giochi e i giocattoli della ludoteca con la vostra famiglia.\n\nGratuito\n\nPrezzo: Prenotazione obbligatoria alla reception\nGratuito\n\nContatto: C.S.C. \" Audrey BARTIER \" 03.21.33.29.53.\nEmail: accueil@cscwimereux.org"
        ],
        "fr": [
          "MERCREDIS 10, 17 et 24 DECEMBRE 2025\n\n10h15 / 11h30 • C.S.C. «Audrey BARTIER»\n\nDécouverte des jeux et jouets de la ludothèque en famille.\n\nGratuit\n\nTarif : Réservation obligatoire auprès de l’accueil\nGratuit\n\nRens. : C.S.C. « Audrey BARTIER » 03.21.33.29.53.\nCourriel : accueil@cscwimereux.org"
        ],
        "nl": [
          "WEDDAGEN 10, 17 en 24 DECEMBER 2025\n\n10.15 uur / 11.30 uur ? C.S.C. \"Audrey BARTIER\n\nOntdek met het hele gezin de spelletjes en het speelgoed in de speelgoedbibliotheek.\n\nGratis\n\nPrijs: Reserveren bij de receptie verplicht\nGratis\n\nContact: C.S.C. \" Audrey BARTIER \" 03.21.33.29.53.\nE-mail: accueil@cscwimereux.org"
        ],
        "es": [
          "MIÉRCOLES 10, 17 y 24 DE DICIEMBRE DE 2025\n\n10.15 h / 11.30 h ? C.S.C. \"Audrey BARTIER\n\nDescubre en familia los juegos y juguetes de la ludoteca.\n\nGratis\n\nPrecio: Reserva previa en recepción\nGratis\n\nContacto: C.S.C. \" Audrey BARTIER \" 03.21.33.29.53.\nCorreo electrónico: accueil@cscwimereux.org"
        ]
      },
