  "rdfs:comment": {
    "de": [
      "Die Domaine de Nustrale öffnet ihre Türen, um Ihnen einen Einblick in ihre landwirtschaftlichen Aktivitäten zu geben, die sich hauptsächlich auf die Aufzucht von Freilandhühnern beziehen."
    ],
    "en": [
      "The Domaine de Nustrale opens its doors for you to discover its farming activities, which mainly involve raising and processing local chickens."
    ],
    "it": [
      "Il Domaine de Nustrale vi apre le porte per farvi scoprire le sue attività agricole, che prevedono principalmente l'allevamento di polli ruspanti."
    ],
    "fr": [
      "Le Domaine de Nustrale vous ouvre ses portes afin de vous faire découvrir ses activités agricoles qui ont principalement trait à l’élevage de poulet fermier plein air."
    ],
    "nl": [
      "Het Domaine de Nustrale opent zijn deuren voor je om zijn landbouwactiviteiten te ontdekken, die voornamelijk bestaan uit het fokken en verwerken van lokale kippen."
    ],
    "es": [
      "El Domaine de Nustrale le abre sus puertas para que descubra sus actividades agrícolas, que consisten principalmente en la cría de pollos camperos."
    ]
  },
