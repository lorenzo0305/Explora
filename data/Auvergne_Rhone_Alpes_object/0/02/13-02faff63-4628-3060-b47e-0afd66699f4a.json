  "rdfs:comment": {
    "de": [
      "Wir verkaufen Nüsse und Nussderivate: Öle, Nusskerne, Aperitifkerne, Geschenkpackungen, Konfitüren, Würste und Makronen ...\r\nWir sind BIOLOGISCH zertifiziert und unsere Nüsse sind AOP Noix de Grenoble."
    ],
    "en": [
      "We sell walnuts and their derivatives: oils, kernels, aperitif kernels, gift boxes, jams, sausages and macaroons...\r\nWe are certified ORGANIC and our walnuts AOP Noix de Grenoble."
    ],
    "it": [
      "Vendiamo noci e i loro derivati: oli, gherigli, gherigli per aperitivi, confezioni regalo, marmellate, salsicce e amaretti...\r\nSiamo certificati BIOLOGICI e le nostre noci sono DOP Noix de Grenoble."
    ],
    "fr": [
      "Nous vendons des noix et dérivés : Huiles, cerneaux, cerneaux apéritif, coffrets cadeaux, confitures, saucissons et macarons ...\r\nNous sommes certifiés BIOLOGIQUE et nos noix AOP Noix de Grenoble."
    ],
    "nl": [
      "Wij verkopen walnoten en afgeleide producten: oliën, pitten, aperitiefpitten, geschenkdozen, jam, worst en bitterkoekjes...\r\nWij zijn biologisch gecertificeerd en onze walnoten zijn BOB Noix de Grenoble."
    ],
    "es": [
      "Vendemos nueces y sus derivados: aceites, nueces en grano, nueces de aperitivo, cajas de regalo, mermeladas, embutidos y macarrones...\r\nEstamos certificados BIO y nuestras nueces son DOP Noix de Grenoble."
    ]
  },
