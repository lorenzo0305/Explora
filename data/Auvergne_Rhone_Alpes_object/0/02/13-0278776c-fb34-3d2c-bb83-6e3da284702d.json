  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt Volvic empfängt Sie das Office de Tourisme während der Sommersaison und bietet Ihnen Informationen, um Ihren Aufenthalt zu erleichtern."
    ],
    "en": [
      "Located in the heart of Volvic, the Tourist Office welcomes you during the summer season and provides you with all the information you need to make your stay as pleasant as possible."
    ],
    "it": [
      "Situato nel cuore di Volvic, l'Ufficio del Turismo vi accoglie durante la stagione estiva e vi fornisce tutte le informazioni necessarie per rendere il vostro soggiorno il più piacevole possibile."
    ],
    "fr": [
      "Situé au cœur du bourg de Volvic l'Office de Tourisme vous accueille durant la saison estivale et vous apporte les renseignements afin de faciliter votre séjour."
    ],
    "es": [
      "Situada en el corazón de Volvic, la Oficina de Turismo le da la bienvenida durante la temporada de verano y le proporciona toda la información necesaria para que su estancia sea lo más agradable posible."
    ],
    "nl": [
      "Het VVV-kantoor in het hart van Volvic verwelkomt je tijdens het zomerseizoen en geeft je alle informatie die je nodig hebt om je verblijf zo aangenaam mogelijk te maken."
    ]
  },
  "rdfs:label": {
