  "rdfs:comment": {
    "de": [
      "IRIDAT CEDF Le Puy, bietet wechselnde Ausstellungen, ein Zentrum für Berufs- und Freizeitunterricht (vom Einführungskurs bis zum BMA Arts de la Dentelle).  Vorführungen finden nur unter der Woche um 10:30, 14:30 und 15:30 Uhr statt, am Samstag nach Vereinbarung."
    ],
    "en": [
      "IRIDAT CEDF Le Puy, offers temporary exhibitions, vocational training and leisure activities (from introductory courses to BMA Arts de la Dentelle).  Demonstrations are available weekdays only at 10:30, 14:30 and 15:30, and on Saturdays by appointment."
    ],
    "it": [
      "IRIDAT CEDF Le Puy, offre mostre temporanee, un centro di formazione professionale e attività per il tempo libero (dai corsi introduttivi al BMA Arts de la Dentelle).  Le dimostrazioni si tengono solo nei giorni feriali alle 10.30, 14.30 e 15.30 e il sabato su appuntamento."
    ],
    "fr": [
      "IRIDAT CEDF Le Puy, propose des expositions temporaires, un centre d'enseignement professionnel et loisirs (du cours d'initiation au BMA Arts de la Dentelle).  Des démonstrations se font en semaine uniquement à 10h30, 14h30 et 15h30, le samedi sur RDV."
    ],
    "es": [
      "IRIDAT CEDF Le Puy, ofrece exposiciones temporales, un centro de formación profesional y actividades de ocio (desde cursos de iniciación a la BMA Arts de la Dentelle).  Las demostraciones se imparten únicamente los días laborables a las 10.30 h, 14.30 h y 15.30 h, y los sábados con cita previa."
    ],
    "nl": [
      "IRIDAT CEDF Le Puy, biedt tijdelijke tentoonstellingen, een beroepsopleidingscentrum en vrijetijdsactiviteiten (van inleidende cursussen tot de BMA Arts de la Dentelle).  Demonstraties worden alleen op weekdagen om 10.30, 14.30 en 15.30 uur gegeven en op zaterdag op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre d'Enseignement de la Dentelle aux Fuseaux (Iridat-Cedf)"
    ]
  },
