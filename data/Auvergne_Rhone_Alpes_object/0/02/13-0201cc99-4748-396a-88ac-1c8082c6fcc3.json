  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Montélimar-Agglomération empfängt Sie das ganze Jahr über, um unsere Gegend in der Drôme Provençale zu entdecken."
    ],
    "en": [
      "The Montélimar-Agglomération Tourist Office welcomes you all year round to discover our region in the Drôme provençale."
    ],
    "it": [
      "L'Ufficio del Turismo di Montélimar-Agglomerato vi accoglie tutto l'anno per farvi scoprire la nostra regione della Drôme provenzale."
    ],
    "fr": [
      "L'Office de Tourisme de Montélimar-Agglomération vous accueille toute l'année pour découvrir notre territoire en Drôme provençale."
    ],
    "es": [
      "La Oficina de Turismo de Montélimar-Agglomeración le da la bienvenida todo el año para que descubra nuestra región de la Drôme Provençale."
    ],
    "nl": [
      "Het VVV-kantoor van Montélimar-Agglomération heet u het hele jaar door welkom om onze streek in de Drôme Provençale te ontdekken."
