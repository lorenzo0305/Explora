  "rdfs:comment": {
    "de": [
      "Sanfte Arbeit, keine Knackgeräusche, keine gewaltsamen Manipulationen.\r\nBeratung auf dem Tisch und in weicher Kleidung für einen besseren Komfort und systematischer Vorschlag von, maximal, zwei Übungen, die Sie zu Hause machen können."
    ],
    "en": [
      "Gentle work, no cracking, no forceful manipulation.\r\nConsultation on a table, dressed in soft clothing for greater comfort, and systematic proposal of a maximum of two exercises to do at home."
    ],
    "it": [
      "Un lavoro delicato, senza screpolature, senza manipolazioni forzate.\r\nConsultazione su un tavolo e vestiti con abiti morbidi per un miglior comfort e proposta sistematica di massimo due esercizi da fare a casa."
    ],
    "fr": [
      "Travail en douceur, pas de craquements, pas de manipulation en force.\r\nConsultation sur table et habillé en tenue souple pour un meilleur confort et proposition systématique de, maximum, deux exercices à faire chez vous."
    ],
    "nl": [
      "Zacht werk, geen kraken, geen krachtige manipulatie.\r\nConsultatie op een tafel, gekleed in zachte kleding voor meer comfort, en systematische suggestie van maximaal twee oefeningen om thuis te doen."
    ],
    "es": [
      "Trabajo suave, sin grietas ni manipulaciones enérgicas.\r\nConsulta en camilla y vestido con ropa suave para una mayor comodidad y propuesta sistemática de, como máximo, dos ejercicios para realizar en casa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cabinet d'Osteopathie POYET"
    ]
  },
