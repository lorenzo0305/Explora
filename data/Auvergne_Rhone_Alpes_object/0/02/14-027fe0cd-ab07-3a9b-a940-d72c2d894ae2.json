  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d340b4be-ed0b-3fa0-98e5-7c6c28db23d4",
      "dc:description": {
        "de": [
          "Verpassen Sie nicht den Gourmet-Spaziergang durch das Course-Tal, der vom Fremdenverkehrsamt Haut-Pays d'Opale am Montag, dem 21. April, ab 10 Uhr angeboten wird und in Beussent beginnt. Weitere Informationen finden Sie auf dem Merkblatt"
        ],
        "en": [
          "Don't miss the gourmet walk through the Course valley proposed by the Haut-Pays d'Opale tourist office on Monday April 21, starting at 10am in Beussent. For further information, please see the fact sheet"
        ],
        "it": [
          "Non perdetevi la passeggiata gastronomica nella Valle del Corso organizzata dall'Ufficio del Turismo dell'Haut-Pays d'Opale lunedì 21 aprile dalle 10.00, con partenza da Beussent. Per maggiori informazioni, consultare la scheda informativa"
        ],
        "fr": [
          "Ne manquez pas la balade gourmande de la vallée de la Course proposée par l'office du tourisme du Haut-Pays d'Opale le lundi 21 avril à partir de 10h, qui débutera à Beussent. Pour plus d'informations, veuillez voir la fiche"
        ],
        "es": [
          "No se pierda el paseo gastronómico por el valle del Course organizado por la Oficina de Turismo del Haut-Pays d'Opale el lunes 21 de abril a partir de las 10:00 h, con salida de Beussent. Para más información, consulte la hoja informativa"
        ],
        "nl": [
          "Mis de gastronomische wandeling door de vallei van de Course niet, georganiseerd door het Office du Tourisme du Haut-Pays d'Opale op maandag 21 april vanaf 10 uur, met vertrek in Beussent. Zie voor meer informatie de informatiefolder"
        ]
      },
