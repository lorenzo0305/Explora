  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ea02d3d-e656-38e3-8d12-a63597137660",
      "dc:description": {
        "de": [
          "Prêt à Porter Herren.\n\nTäglich geöffnet außer am 1. Januar, 1. Mai und 25. Dezember.\nMontag bis Freitag von 10:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr.\nSamstags, sonntags und an Feiertagen von 10:00 bis 19:00 Uhr."
        ],
        "en": [
          "Prêt à Porter Homme.\n\nOpen every day except January 1st, May 1st and December 25th.\nMonday to Friday, 10am to 12:30pm and 2pm to 7pm.\nSaturday, Sunday and public holidays from 10am to 7pm."
        ],
        "it": [
          "Prêt à Porter Homme.\n\nAperto tutti i giorni tranne il 1° gennaio, il 1° maggio e il 25 dicembre.\nDal lunedì al venerdì, dalle 10.00 alle 12.30 e dalle 14.00 alle 19.00.\nSabato, domenica e festivi dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Prêt à Porter Homme.\n\nOuvert tous les jours sauf le 1er janvier, 1er mai et 25 décembre.\nDu lundi au vendredi de 10h à 12h30 et de 14h à 19h.\nSamedi, dimanche et jours fériés de 10h à 19h."
        ],
        "nl": [
          "Prêt à Porter Homme.\n\nElke dag geopend behalve 1 januari, 1 mei en 25 december.\nMaandag t/m vrijdag van 10.00 tot 12.30 uur en van 14.00 tot 19.00 uur.\nZaterdag, zondag en feestdagen van 10.00 tot 19.00 uur."
        ],
        "es": [
          "Prêt à Porter Homme.\n\nAbierto todos los días excepto el 1 de enero, el 1 de mayo y el 25 de diciembre.\nDe lunes a viernes, de 10.00 a 12.30 h. y de 14.00 a 19.00 h.\nSábados, domingos y festivos, de 10.00 a 19.00 h."
        ]
      },
