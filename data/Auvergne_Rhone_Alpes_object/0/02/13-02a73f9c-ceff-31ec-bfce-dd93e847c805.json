  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie die FIS Citadine Slalomrennen der Herren und Damen!\r\nDie Citadine-Kommission Ski alpin betrifft Vereine, die dem Französischen Skiverband (FFS) angehören."
    ],
    "en": [
      "Come and discover the FIS Citadine men’s and women slalom races!\r\nThe Citadine Alpine Skiing Commission concerns the affiliated clubs to the French Ski Federation (FFS)."
    ],
    "it": [
      "Venite a scoprire le gare FIS Citadine di slalom maschile e femminile!\r\nLa Commissione Sci Alpino Citadine è aperta ai club affiliati alla Federazione Francese di Sci (FFS)."
    ],
    "fr": [
      "Venez découvrir les courses slalom Hommes et Dames FIS Citadine !\r\nLa commission Citadine ski alpin concerne les clubs affiliés à la Fédération Française de Ski (FFS)."
    ],
    "es": [
      "¡Ven a descubrir las carreras de eslalon masculino y femenino de la FIS Citadine!\r\nLa Comisión de Esquí Alpino de Citadine está abierta a los clubes afiliados a la Federación Francesa de Esquí (FFS)."
    ],
    "nl": [
      "Kom en ontdek de FIS Citadine slalomwedstrijden voor mannen en vrouwen!\r\nDe Citadine Alpine Ski Commission staat open voor clubs die zijn aangesloten bij de Franse Ski Federatie (FFS)."
    ]
  },
