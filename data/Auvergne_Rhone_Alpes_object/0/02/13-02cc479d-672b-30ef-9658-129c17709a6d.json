  "rdfs:comment": {
    "de": [
      "Diese größtenteils gotische Kirche stützt sich jedoch auf einen alten romanischen Teil (um das Jahr 1000). Jahrhunderts (MH) und wurde von Ludwig II. von Bourbon in Auftrag gegeben."
    ],
    "en": [
      "This largely Gothic church, however, is based on an earlier Romanesque structure (circa 1000). Its construction dates from the 14th to the early 17th centuries (MH) and was initiated by Louis II de Bourbon."
    ],
    "it": [
      "Questa chiesa, in gran parte gotica, si basa tuttavia su una precedente sezione romanica (circa 1000). La sua costruzione risale al XIV e all'inizio del XVII secolo (MH) e fu iniziata da Luigi II di Borbone."
    ],
    "fr": [
      "Cette église en grande partie gothique s'appuie cependant sur une ancienne partie romane (environ an 1000). Sa construction s'étale du XIVe au début du XVIIe siècle (MH) a été initiée par Louis II de Bourbon."
    ],
    "es": [
      "Esta iglesia, en gran parte gótica, se basa sin embargo en una sección románica anterior (hacia 1000). Su construcción data de los siglos XIV a principios del XVII (MH) y fue iniciada por Luis II de Borbón."
    ],
    "nl": [
      "Deze grotendeels gotische kerk is echter gebaseerd op een eerder romaans gedeelte (rond 1000). De bouw dateert van de 14e tot de vroege 17e eeuw (MH) en werd geïnitieerd door Lodewijk II van Bourbon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Notre-Dame"
    ]
  },
