  "rdfs:comment": {
    "de": [
      "Eine dynamische und professionelle Schule, die auf Spaß und Lernen ausgerichtet ist. Alpinski-, Snowboard- und Langlaufkurse in Gruppenkursen oder Einzelunterricht. Weitere Aktivitäten werden angeboten: Schneeschuhwanderung, Biathlon und Skitouren."
    ],
    "en": [
      "A dynamic and professional ski school focused on pleasure and education. Alpine skiing, snowboarding, cross-country skiing lessons in group lessons or private lessons. Other activities are offered: snowshoeing, biathlon and ski touring."
    ],
    "it": [
      "Una scuola dinamica e professionale orientata al divertimento e all'apprendimento. Lezioni di sci alpino, snowboard e sci di fondo in gruppi o lezioni private. Altre attività sono le ciaspolate, il biathlon e lo sci alpinismo."
    ],
    "fr": [
      "Une école dynamique et professionnelle orientée vers le plaisir et l’apprentissage. Cours de ski alpin, snowboard, ski de fond en cours collectif ou leçon particulière. D'autres activités sont proposées : sortie raquettes, biathlon et ski de randonnée."
    ],
    "es": [
      "Una escuela dinámica y profesional orientada a la diversión y el aprendizaje. Clases de esquí alpino, snowboard y esquí de fondo en grupo o particulares. Otras actividades son las raquetas de nieve, el biatlón y el esquí de travesía."
    ],
    "nl": [
      "Een dynamische en professionele school gericht op plezier en leren. Alpineskiën, snowboarden, langlauflessen in groepslessen of privélessen. Andere activiteiten worden aangeboden: sneeuwschoenwandelen, biatlon en skitochten."
    ]
  },
