  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Kirche auf eigene Faust. Das Querschiff, das Kirchenschiff und die Seitenschiffe dieses Gebäudes stammen aus dem 12. Jahrhundert, die Apsis aus dem 14."
    ],
    "en": [
      "Self-guided tour. The transept, nave and aisles of this building date from the 12th century, and the apse from the 14th century."
    ],
    "it": [
      "Visita autoguidata. Il transetto, la navata centrale e le navate laterali di questo edificio risalgono al XII secolo e l'abside al XIV secolo."
    ],
    "fr": [
      "Visite libre. Le transept, la nef et les bas-côtés de cet édifice datent du XIIe siècle et l'abside du XIVe siècle."
    ],
    "nl": [
      "Zelf rondleiding. Het dwarsschip, het schip en de zijbeuken van dit gebouw dateren uit de 12e eeuw en de apsis uit de 14e eeuw."
    ],
    "es": [
      "Visita autoguiada. El crucero, la nave y las naves laterales de este edificio datan del siglo XII y el ábside del siglo XIV."
    ]
  },
