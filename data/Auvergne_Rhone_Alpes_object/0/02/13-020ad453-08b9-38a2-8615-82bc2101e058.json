  "rdfs:comment": {
    "de": [
      "Der Hof produziert seit 2011 Bio-Milch, die von Biolait vertrieben wird.Herstellung von Eisprodukten und Joghurt.\r\nDirektverkauf auf dem Bauernhof.\r\nVertriebspartner:\r\n Le Pain Fermier und Le Grand Panier Bio in BRIVES-CHARENSAC Echonature (BioCoop) in PUY-EN-VELAY"
    ],
    "en": [
      "The farm has been producing organic milk since 2011, distributed by Biolait.\r\nDirect sales at the farm.\r\nDistributors:\r\n Le Pain Fermier and Le Grand Panier Bio in BRIVES-CHARENSAC Echonature (BioCoop) in PUY-EN-VELAY"
    ],
    "it": [
      "L'azienda produce latte biologico dal 2011, distribuito da Biolait.\r\nVendita diretta presso la fattoria.\r\nDistributori:\r\n Le Pain Fermier e Le Grand Panier Bio a BRIVES-CHARENSAC Echonature (BioCoop) a PUY-EN-VELAY"
    ],
    "fr": [
      "La ferme produit du lait bio depuis 2011 distribué par Biolait.Fabrication de produits glacés et yaourts.\r\nVente directe à la ferme.\r\nDistributeurs :\r\n Le Pain Fermier et Le Grand Panier Bio à BRIVES-CHARENSAC Echonature (BioCoop) au PUY-EN-VELAY"
    ],
    "es": [
      "La granja produce leche ecológica desde 2011, distribuida por Biolait.\r\nVenta directa en la granja.\r\nDistribuidores:\r\n Le Pain Fermier y Le Grand Panier Bio en BRIVES-CHARENSAC Echonature (BioCoop) en PUY-EN-VELAY"
    ],
    "nl": [
      "De boerderij produceert biologische melk sinds 2011, gedistribueerd door Biolait.\r\nDirecte verkoop op de boerderij.\r\nDistributeurs:\r\n Le Pain Fermier en Le Grand Panier Bio in BRIVES-CHARENSAC Echonature (BioCoop) in PUY-EN-VELAY"
    ]
  },
