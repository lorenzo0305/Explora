        "de": [
          "Das Lebensmittelgeschäft an der Ecke 700m vom Strand entfernt, geöffnet mittwochs/freitags/samstags und sonntags von 10:00 bis 13:30 Uhr und von 15:30 bis 19:30 Uhr"
        ],
        "en": [
          "Local grocery store 700m from the beach, open Wednesday/Friday/Saturday and Sunday, 10am-1.30pm and 3.30pm-7.30pm"
        ],
        "it": [
          "L'épicerie du coin si trova a 700 m dalla spiaggia, aperta mercoledì/venerdì/sabato e domenica dalle 10.00 alle 13.30 e dalle 15.30 alle 19.30"
        ],
        "fr": [
          "L'épicerie du coin située à 700m de la plage, ouverte le mercredi/vendredi/samedi et dimanche de 10h à 13h30 et de 15h30 à 19h30"
        ],
        "es": [
          "L'épicerie du coin situada a 700m de la playa, abierta miércoles/viernes/sábado y domingo de 10h a 13h30 y de 15h30 a 19h30"
