  "rdfs:comment": {
    "de": [
      "Der Arly ist ein mächtiger und tosender Fluss, der Sie mit seinen Äschen und Forellen von stattlicher Größe in Erstaunen versetzen wird."
    ],
    "en": [
      "Powerful and tumultuous river, the Arly will amaze you with its common grayling and its large trout."
    ],
    "it": [
      "Fiume potente e tumultuoso, l'Arly vi stupirà con i suoi temoli comuni e le grandi trote."
    ],
    "fr": [
      "Rivière puissante et tumultueuse, l'Arly vous émerveillera par ses ombres communs et ses truites de belles tailles."
    ],
    "es": [
      "Río caudaloso y tumultuoso, el Arly le sorprenderá con sus tímalos comunes y sus grandes truchas."
    ],
    "nl": [
      "De Arly, een krachtige en onstuimige rivier, zal u verbazen met zijn vlagzalmen en grote forellen."
    ]
  },
  "rdfs:label": {
