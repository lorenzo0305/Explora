  "rdfs:comment": {
    "de": [
      "Tandem-Fallschirmspringen vom Flugplatz Montbeugny aus. Für Moulins en 2025 schlagen wir vor: 20/21. Juni und 22/23. Juli. Ansonsten sind die Geschenkgutscheine für alle Gebiete gültig, die wir auf unserer Website anbieten."
    ],
    "en": [
      "Tandem parachute jump from Montbeugny airfield. For Moulins en 2025 we propose: June 20/21 and July 22/23. Otherwise, gift vouchers are valid for all the areas we offer on our website."
    ],
    "it": [
      "Lancio con paracadute in tandem dall'aerodromo di Montbeugny. Per Moulins en 2025 proponiamo: 20/21 giugno e 22/23 luglio. Altrimenti, i buoni regalo sono validi per tutte le aree che proponiamo sul nostro sito."
    ],
    "fr": [
      "Saut en parachute en tandem depuis l'aérodrome de Montbeugny. Pour Moulins en 2025 nous proposons : le 20/21 juin et le 22/23 juillet. Sinon les bons cadeaux sont valides sur toutes les zones que nous proposons sur notre site internet."
    ],
    "nl": [
      "Tandem parachutesprong vanaf vliegveld Montbeugny. Voor Moulins en 2025 stellen we voor: 20/21 juni en 22/23 juli. Anders zijn cadeaubonnen geldig voor alle gebieden die we aanbieden op onze website."
    ],
    "es": [
      "Salto en paracaídas biplaza desde el aeródromo de Montbeugny. Para Moulins en 2025 proponemos: 20/21 de junio y 22/23 de julio. Por lo demás, los cheques regalo son válidos para todas las zonas que proponemos en nuestro sitio web."
    ]
  },
  "rdfs:label": {
