  "rdfs:comment": {
    "de": [
      "Seit nunmehr zwei Jahren habe ich mit der Bildhauerei aufgehört und mich der Malerei, dem Zeichnen mit dem Bic-Stift und den Fotos zugewandt. Ich stelle auf der Straße aus."
    ],
    "en": [
      "For two years now, I've stopped sculpting and turned to painting, drawing with a bic pen and photography. I exhibit in the street."
    ],
    "it": [
      "Da due anni ho smesso di scolpire per dedicarmi alla pittura, al disegno con la penna bic e alla fotografia. Espongo per strada."
    ],
    "fr": [
      "Depuis deux ans maintenant, j'ai arrêté la sculpture et je me suis tourné vers la peinture, le dessin au stylo bic et les photos. J'expose dans la rue."
    ],
    "nl": [
      "Sinds twee jaar ben ik gestopt met beeldhouwen en ben ik gaan schilderen, tekenen met een bic-pen en fotograferen. Ik exposeer op straat."
    ],
    "es": [
      "Desde hace dos años, he dejado de esculpir y me he dedicado a la pintura, al dibujo con bolígrafo Bic y a la fotografía. Expongo en la calle."
    ]
  },
  "rdfs:label": {
