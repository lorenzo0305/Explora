  "rdfs:comment": {
    "de": [
      "Kreuzen Sie die Klingen mit der Geschichte! Begeben Sie sich mit Madame de Sévigné und den Musketieren auf ein Abenteuer! Aber bleiben Sie auf der Hut! Eine Schnitzeljagd zwischen Fiktion und Realität! Für alle Altersgruppen. Nur mit vorheriger Reservierung. Angeboten und moderiert von Planète Guides."
    ],
    "en": [
      "Come cross swords with history! Go on an adventure with Madame de Sévigné and the Musketeers! But stay on your guard! A treasure hunt between fiction and reality! All ages. Reservations required. Organized by Planète Guides."
    ],
    "it": [
      "Venite a incrociare le spade con la storia! Vivi un'avventura con Madame de Sévigné e i Moschettieri! Ma state in guardia! Una caccia al tesoro tra finzione e realtà! Aperto a tutti. Prenotazione obbligatoria. Organizzato e gestito dalle Guide Planète."
    ],
    "fr": [
      "Venez croiser le fer avec l'Histoire ! Partez à l'aventure avec Madame de Sévigné et les mousquetaires ! Mais restez sur vos gardes ! Un jeu de piste entre fiction et réalité ! Tous publics. Sur réservations. Proposé et animé par Planète Guides."
    ],
    "es": [
      "¡Ven y cruza espadas con la historia! Embárcate en una aventura con Madame de Sévigné y los mosqueteros Pero, ¡cuidado! Una búsqueda del tesoro entre ficción y realidad Abierto a todos. Reserva obligatoria. Organizado y dirigido por Planète Guides."
    ],
    "nl": [
      "Kom en kruis de degens met de geschiedenis! Ga op avontuur met Madame de Sévigné en de Musketiers! Maar wees op je hoede! Een speurtocht tussen fictie en werkelijkheid! Voor iedereen toegankelijk. Reserveren verplicht. Georganiseerd en uitgevoerd door Planète Guides."
    ]
  },
