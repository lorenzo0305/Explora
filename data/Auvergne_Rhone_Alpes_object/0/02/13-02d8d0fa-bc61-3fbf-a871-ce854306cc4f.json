  "rdfs:comment": {
    "de": [
      "11 Zimmer (einige mit Blick auf den Puy Mary), alle mit Bad mit WC, TV - LL zur Verfügung - Kinderstuhl und -bett - WIFI - Terrasse mit Panoramablick auf den Puy Mary, Bar - Restaurant - Empfang von Einzelpersonen und Gruppen. Auf dem GR400 gelegen."
    ],
    "en": [
      "11 rooms (some with a view of Puy Mary) all with en-suite bathroom and WC, TV - washing machine available - high chair and cot - WIFI - Relaxation garden - Terrace - Bar - Restaurant - Individual and group bookings."
    ],
    "it": [
      "11 camere (alcune con vista sul Puy Mary) tutte con bagno privato e WC, TV - LL disponibile - seggiolone e culla - WIFI - Terrazza panoramica sul Puy Mary, bar - Ristorante - Accoglienza di singoli e gruppi. Situato sul GR400."
    ],
    "fr": [
      "11 chambres (certaines avec vue sur le Puy Mary) toutes équipées d'une salle de bain avec WC, TV - LL à disposition - chaise et lit bébé - WIFI - Terrasse panoramique sur le Puy Mary, bar - Restaurant - Accueil individuel et groupe. Situé sur le GR400."
    ],
    "nl": [
      "11 kamers (sommige met uitzicht op Puy Mary) allemaal met eigen badkamer en WC, TV - LL beschikbaar - kinderstoel en kinderbedje - WIFI - Panoramisch terras met uitzicht op Puy Mary, bar - Restaurant - Individueel en groepen welkom. Gelegen aan de GR400."
    ],
    "es": [
      "11 habitaciones (algunas con vistas al Puy Mary) todas con baño y WC, TV - LL disponible - trona y cuna - WIFI - Terraza panorámica con vistas al Puy Mary, bar - Restaurante - Individuales y grupos bienvenidos. Situado en el GR400."
