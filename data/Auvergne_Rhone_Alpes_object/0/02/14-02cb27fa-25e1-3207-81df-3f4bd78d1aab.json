      "dc:description": {
        "de": [
          "Nehmen Sie mit Ihrer Familie an einem Workshop zum Thema Buchfalten teil und lassen Sie Ihrer Kreativität freien Lauf!\nNehmen Sie Ihre Kreation mit nach Hause."
        ],
        "en": [
          "Bring the whole family to a book-folding workshop and let your creativity run wild!\nTake your creation home with you."
        ],
        "it": [
          "Partecipate a un laboratorio di piegatura di libri con tutta la famiglia e date sfogo alla vostra creatività!\nPortate a casa la vostra creazione."
        ],
        "fr": [
          "Participez en famille à un atelier de pliage de livre et laissez parler votre créativité !\nRamenez chez vous votre création."
        ],
        "es": [
          "Participe en un taller familiar de plegado de libros y dé rienda suelta a su creatividad\nLlévate tu creación a casa."
        ],
        "nl": [
          "Doe mee aan een boekvouwworkshop voor het hele gezin en laat je creativiteit de vrije loop!\nNeem je creatie mee naar huis."
        ]
      },
