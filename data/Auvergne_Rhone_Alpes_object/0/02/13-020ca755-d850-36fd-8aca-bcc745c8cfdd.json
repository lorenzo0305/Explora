  "rdfs:comment": {
    "de": [
      "Le Gypaète, Crêperie und Restaurant, empfängt Sie jeden Tag mittags und abends. Wir bieten Ihnen Fleischgerichte und Spezialitäten aus Savoyen, hausgemachte Cocktails und hausgemachte Desserts.\r\nFrische lokale Produkte und hausgemachte Speisen."
    ],
    "en": [
      "Le Gypaète, crêperie and restaurant, welcomes you every day for lunch and dinner. We offer Savoyard meats and specialties, homemade cocktails and desserts.\r\nFresh local and home-made products."
    ],
    "it": [
      "Le Gypaète, crêperie e ristorante, vi accoglie tutti i giorni a pranzo e a cena. Offriamo carni e specialità savoiarde, cocktail e dolci fatti in casa.\r\nProdotti freschi locali e piatti fatti in casa."
    ],
    "fr": [
      "Le Gypaète,  crêperie et restaurant, vous accueille tous les jours midi et soir. Nous vous proposons des viandes et des spécialités savoyardes, des cocktails maison, des desserts maison.\r\nProduits frais locaux et fait maison."
    ],
    "es": [
      "Le Gypaète, crêperie y restaurante, le da la bienvenida todos los días para el almuerzo y la cena. Ofrecemos carnes y especialidades de Saboya, cócteles caseros y postres caseros.\r\nProductos locales frescos y platos caseros."
    ],
    "nl": [
      "Le Gypaète, crêperie en restaurant, verwelkomt je elke dag voor lunch en diner. Wij bieden Savoyaardse vleeswaren en specialiteiten, huisgemaakte cocktails en huisgemaakte desserts.\r\nVerse streekproducten en huisgemaakte gerechten."
    ]
  },
