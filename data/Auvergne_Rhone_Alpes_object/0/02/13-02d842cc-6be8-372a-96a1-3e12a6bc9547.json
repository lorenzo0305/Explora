  "rdfs:comment": {
    "de": [
      "Im großen Park von Montrond, nur einen Steinwurf vom Stadtzentrum, dem Schloss und dem Casino entfernt, bieten die Thermes de Montrond von der Krankenkasse anerkannte medizinische Thermalkuren zur Behandlung von rheumatischen Beschwerden an ..."
    ],
    "en": [
      "In the large park of Montrond, a stone's throw from the city center, the Castle and the Casino, the Thermes de Montrond offer medical thermal cures approved by Health Insurance, to treat rheumatic ailments ..."
    ],
    "it": [
      "Concedetevi un momento di benessere alle terme di Montrond-les-Bains. Nella cornice verde del parco termale, a due passi dal castello, dal casinò e dall'hotel-ristorante Le Cirius, godetevi un trattamento medico termale."
    ],
    "fr": [
      "Offrez-vous un moment de bien-être aux Thermes de Montrond-les-Bains. Dans le cadre verdoyant du parc thermal, à deux pas du château, du casino et de l’hôtel-restaurant Le Cirius, profitez d’une cure thermale médicalisée."
    ],
    "es": [
      "Regálese un momento de bienestar en las termas de Montrond-les-Bains. En el marco verde del parque termal, a dos pasos del castillo, del casino y del hotel-restaurante Le Cirius, disfrute de un tratamiento médico termal."
    ],
    "nl": [
      "Gun jezelf een moment van welzijn in de thermen van Montrond-les-Bains. Geniet in de groene omgeving van het kuurpark, op een steenworp afstand van het kasteel, het casino en hotel-restaurant Le Cirius, van een medische kuur."
    ]
  },
