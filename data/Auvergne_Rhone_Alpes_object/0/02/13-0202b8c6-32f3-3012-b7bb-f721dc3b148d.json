  "rdfs:comment": {
    "de": [
      "Unterhalb des Ausgangs der Chailles-Schluchten weitet sich der Guiers und wechselt zwischen Stromschnellen und großen Becken. Auf dieser Route ist es nicht ungewöhnlich, eine schöne Forelle von über 50 cm zu fangen."
    ],
    "en": [
      "Below the exit of the Chailles Gorges, the Guiers widens, alternating between rapids and large pools. On this route, it is not uncommon to catch a nice trout of more than 50 cm."
    ],
    "it": [
      "A valle dell'uscita delle Gole di Chailles, il Guiers si allarga, alternando rapide e grandi pozze. Su questo percorso, non è raro catturare belle trote di oltre 50 cm."
    ],
    "fr": [
      "Sous la sortie des Gorges de Chailles, le Guiers s’élargit, alternant entre zones rapides et grandes fosses. Sur ce parcours, il n’est pas rare de prendre une jolie truite de plus de 50 cm."
    ],
    "es": [
      "Más allá de la salida de las Gargantas de Chailles, el Guiers se ensancha, alternando rápidos y grandes pozas. En esta ruta, no es raro pescar una hermosa trucha de más de 50 cm."
    ],
    "nl": [
      "Beneden de uitgang van de Gorges du Chailles wordt de Guiers breder, met afwisselend stroomversnellingen en grote poelen. Op deze route is het niet ongebruikelijk om een mooie forel van meer dan 50 cm te vangen."
    ]
  },
  "rdfs:label": {
    "de": [
      "No-Kill-Angelpfad „Passion“ von Guiers nach St. Béron"
    ],
    "en": [
      "No-kill \"Passion\" Fishing Trail from Guiers to St Béron"
    ],
    "it": [
      "Percorso di pesca \"Passion\" senza uccisioni da Guiers a St Béron"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" No-kill du Guiers à St Béron"
    ],
    "es": [
      "Ruta de pesca \"Pasión\" sin sacrificio, de Guiers a St Béron"
    ],
    "nl": [
      "No-kill \"Passion\"-visroute van Guiers naar St Béron"
    ]
  },
