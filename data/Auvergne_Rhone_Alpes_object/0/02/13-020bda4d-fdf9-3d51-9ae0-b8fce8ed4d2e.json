  "rdfs:comment": {
    "de": [
      "Le Réflex ist das Lehrrestaurant der Schule IFI03. Es bietet Restaurant- und Brasseriemenüs, die von den Schülern des CAP 1re und 2e année zubereitet und serviert werden. Geöffnet dienstags und donnerstags, nur während der Schulzeit."
    ],
    "en": [
      "Le Réflex is the IFI03 school restaurant. It offers restaurant and brasserie menus, created and served by 1st and 2nd year CAP students. Open Tuesdays and Thursdays, during school hours only."
    ],
    "it": [
      "Le Réflex è il ristorante della scuola IFI03. Offre menù da ristorante e brasserie, creati e serviti dagli studenti del 1° e 2° anno del CAP. È aperto il martedì e il giovedì, solo durante il periodo scolastico."
    ],
    "fr": [
      "Le Réflex est le restaurant pédagogique de l’école IFI03. Il propose des menus restaurant et brasserie, réalisés et servis par les élèves de CAP 1re et 2e année. Ouvert le mardi et le jeudi, uniquement pendant la période scolaire."
    ],
    "nl": [
      "Le Réflex is de schoolkantine van IFI03. Het biedt restaurant- en brasseriemenu's, gemaakt en geserveerd door 1e en 2e jaars CAP-studenten. Geopend op dinsdag en donderdag, alleen tijdens schooltijd."
    ],
    "es": [
      "Le Réflex es el comedor escolar del IFI03. Ofrece menús de restaurante y brasserie, creados y servidos por los alumnos de 1º y 2º del CAP. Abierto los martes y jueves, únicamente durante el periodo lectivo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant d'Application Le Réflexe"
    ]
  },
