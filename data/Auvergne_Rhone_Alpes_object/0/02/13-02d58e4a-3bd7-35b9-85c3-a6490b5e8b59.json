  "rdfs:comment": {
    "de": [
      "In der Nähe verschiedener Sehenswürdigkeiten sowie regionalen Weinbaugebieten gelegen, bietet Ihnen dieses Hotel alles, um Ihnen einen angenehmen Aufenthalt zu gestalten."
    ],
    "en": [
      "Within easy reach of all the local tourist attractions and the regional vineyards, this hotel offers every guarantee of a pleasant break."
    ],
    "it": [
      "Situato nelle vicinanze di diversi luoghi turistici e dei vigneti regionali, questo hotel ti offre tutte le garanzie per un piacevole soggiorno."
    ],
    "fr": [
      "A proximité des différents lieux touristiques ainsi que des vignobles régionaux, cet hôtel vous offre toutes les garanties d'un séjour agréable."
    ],
    "nl": [
      "Dicht bij de verschillende toeristische attracties en de regionale wijngaarden biedt dit hotel u alle garanties voor een aangenaam verblijf."
    ],
    "es": [
      "Cerca de los varios lugares turísticos y viñedos regionales, este hotel ofrece todas las garantías de una estancia agradable."
    ]
  },
