  "rdfs:comment": {
    "de": [
      "3 Rundwege für einen angenehmen Spaziergang durch den Wald auf 1400 m Höhe, bei dem man verschiedene Baumarten entdecken kann. Zugänglich für Rollstühle und Kinderwagen."
    ],
    "en": [
      "3 circuits for a pleasant stroll in the forest, at 1400m altitude, allowing you to discover several species of trees. Accessible to wheelchairs and pushchairs."
    ],
    "it": [
      "3 itinerari per un piacevole passeggiata in foresta, a 1400 m d'altitudine, permettendo di scoprire varie specie d'alberi. Accesso con sedie a rotelle e passeggini."
    ],
    "fr": [
      "3 circuits pour une agréable balade en forêt, à 1400m d'altitude, permettant de découvrir plusieurs espèces d'arbres. Accessible aux fauteuils roulants et poussette."
    ],
    "nl": [
      "3 circuits voor een aangename wandeling in het bos, op 1400 m hoogte, waarbij u verschillende boomsoorten kunt ontdekken. Toegankelijk voor rolstoelen en kinderwagens."
    ],
    "es": [
      "3 circuitos para un agradable paseo por el bosque, a 1400 m de altitud, que permiten descubrir varias especies de árboles. Accesible para sillas de ruedas y cochecitos."
    ]
  },
