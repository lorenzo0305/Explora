  "rdfs:comment": {
    "de": [
      "Die grüne Nordic-Skipiste \"Le Col\" führt Sie durch die Tannenwälder in eine Welt voller Ruhe. Sie können die 1,8 km lange, gespurte Loipe frei befahren und in Ihrem eigenen Rhythmus Fortschritte im klassischen oder Skating-Stil machen."
    ],
    "en": [
      "Through the fir trees, the green ‘Le Col’ Nordic ski run transports you into a world of peace and quiet. Enjoy free access to the 1.8 km groomed piste and progress at your own pace, in classic or skating style."
    ],
    "it": [
      "Attraverso gli abeti, la verde pista di sci nordico \"Le Col\" vi trasporta in un mondo di pace e tranquillità. Godetevi il libero accesso alla pista battuta di 1,8 km e progredite al vostro ritmo, in stile classico o skating."
    ],
    "fr": [
      "À travers les sapins, la piste verte \"Le Col\" de ski nordique vous transporte dans un univers empli de calme. Empruntez, en accès libre, la piste damée de 1,8 km et progressez à votre rythme en classique ou skating."
    ],
    "nl": [
      "Door de dennenbomen voert de groene noordse skipiste “Le Col” je mee naar een wereld van rust en stilte. Geniet van vrije toegang tot de 1,8 km geprepareerde piste en vorder in je eigen tempo, in klassieke of skatingstijl."
    ],
    "es": [
      "A través de los abetos, la verde pista de esquí nórdico \"Le Col\" le transporta a un mundo de paz y tranquilidad. Disfrute del libre acceso a la pista acondicionada de 1,8 km y progrese a su ritmo, en estilo clásico o patinador."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Le Col\" green nordic ski trail"
    ],
    "fr": [
      "Piste verte de ski nordique « Le Col »"
    ],
    "nl": [
      "Groene nordic ski-loipe “Le Col"
    ]
  },
