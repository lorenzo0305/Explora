  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #9.\nLucien Fradin gibt sich großzügig und erzählt von der schönen Baustelle, die der Aufbau der selbstgewählten Familie und der verschiedenen Arten, ein Junge zu sein, ist."
    ],
    "en": [
      "Show programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #9.\nLucien Fradin opens up with generosity, recounting the beautiful process of building the family we've chosen for ourselves, and the different ways of being a boy."
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\nLucien Fradin si apre generosamente sul meraviglioso processo di costruzione di una famiglia e sui diversi modi di essere un ragazzo."
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #9.\nLucien Fradin se livre avec générosité et raconte ce beau chantier qu’est la construction de la famille que l’on s’est choisie et des différentes manières d'être un garçon."
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\nLucien Fradin se abre generosamente sobre la construcción de la familia que hemos elegido y las diferentes maneras de ser niño."
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #9.\nLucien Fradin vertelt openhartig over het bouwen van het gezin dat we hebben gekozen en de verschillende manieren om een jongen te zijn."
    ]
  },
