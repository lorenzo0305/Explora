  "rdfs:comment": {
    "de": [
      "Mit einem Bein in der Dombes, mit dem anderen in der Bresse. Entdecken Sie die Vielfalt unserer Region: romanische Kirchen, alte Befestigungsanlagen, Kunsthandwerk, Wanderwege, Fauna und Flora der Dombes und der Bresse, Angeln in des Flüssen und Teichen."
    ],
    "ru": [
      "Одной ногой в Домбе, другой в Брессе. Откройте для себя богатства нашего региона: романские церкви, древние крепостные стены, гастрономию, декоративно-прикладное искусство, туристические маршруты, флору и фауну Домб, рыбалку в реках и прудах..."
    ],
    "en": [
      "One foot in Dombes, one foot in Bresse. Discover the riches of our region: Romanesque churches, ancient ramparts, gastronomy, arts and crafts, hiking trails, the flora and fauna of Dombes and fishing in rivers and ponds."
    ],
    "it": [
      "Un piede nella Dombes, un piede nella Bresse. Scoprite le ricchezze della nostra regione: chiese romaniche, antichi bastioni, gastronomia, artigianato, sentieri escursionistici, flora e fauna delle Dombes, pesca nei fiumi e negli stagni..."
    ],
    "fr": [
      "Un pied en Dombes, un pied en Bresse. Découvrez les richesses de notre région : églises romanes, anciens remparts, gastronomie, artisanat d'art, sentiers de randonnées, faune et flore de la Dombes, pêche en rivières et en étangs..."
    ],
    "zh": [
      "一脚在东贝，一脚在布雷斯。探索本地区的丰富资源：罗马式教堂、古城墙、美食、艺术和手工艺品、步行小径、东布省的动植物、河流和池塘垂钓......"
    ],
    "es": [
      "Un pie en Dombes, un pie en Bresse. Descubra las riquezas de nuestra región: iglesias románicas, antiguas murallas, gastronomía, artesanía, rutas de senderismo, flora y fauna de las Dombes, pesca en ríos y estanques..."
    ],
    "nl": [
      "Een voet in Dombes, een voet in Bresse. Ontdek de rijkdommen van onze streek: Romaanse kerken, oude stadsmuren, gastronomie, kunstnijverheid, wandelpaden, de flora en fauna van de Dombes, vissen in rivieren en vijvers..."
    ]
  },
