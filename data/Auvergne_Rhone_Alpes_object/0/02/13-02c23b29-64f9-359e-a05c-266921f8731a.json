  "rdfs:comment": {
    "de": [
      "Ein Leseclub, um sich zu treffen und sich über Bücher auszutauschen. Diskutieren Sie über Comics, Mangas und Romane, die Ihnen gefallen haben, und entdecken Sie unsere aktuellen Neuerscheinungen."
    ],
    "en": [
      "A book club where you can meet and talk about books. Discuss the comics, mangas and novels you've enjoyed and discover our latest releases."
    ],
    "it": [
      "Un club del libro dove incontrarsi e parlare di libri. Discutete dei fumetti, dei manga e dei romanzi che vi sono piaciuti e scoprite le nostre ultime uscite."
    ],
    "fr": [
      "Un club de lecture pour se rencontrer, échanger autour des livres. Discuter des BD, mangas, romans que vous avez aimés et découvrir nos dernières nouveautés."
    ],
    "es": [
      "Un club de lectura donde reunirse y hablar de libros. Comenta los cómics, mangas y novelas que te han gustado y descubre nuestros últimos lanzamientos."
    ],
    "nl": [
      "Een boekenclub waar je elkaar kunt ontmoeten en over boeken kunt praten. Bespreek de strips, manga en romans waarvan je hebt genoten en ontdek onze nieuwste releases."
    ]
  },
