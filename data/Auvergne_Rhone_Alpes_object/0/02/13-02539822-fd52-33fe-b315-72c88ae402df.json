  "rdfs:comment": {
    "de": [
      "\"Mujeres\": Konzert des Ensembles Vedado in der Kirche Saint-Pierre in Châteloy am Sonntag, den 19. Juli 2026, um 18 Uhr.\r\n\r\nDiana Baroni: Stimme, Traverso\r\nRonald Martin Alonso: Viola da gamba\r\nRafaël Guel Frias: Barockgitarre, Flöten und Perkussion"
    ],
    "en": [
      "\"Mujeres\": concert by Ensemble Vedado at Église Saint-Pierre de Châteloy, Sunday, July 19, 2026, at 6pm.\r\n\r\nDiana Baroni: voice, traverso\r\nRonald Martin Alonso: viola da gamba\r\nRafaël Guel Frias: baroque guitar, flutes and percussion"
    ],
    "it": [
      "\"Mujeres\": concerto dell'Ensemble Vedado nella chiesa di Saint-Pierre de Châteloy, domenica 19 luglio 2026, alle 18.00.\r\n\r\nDiana Baroni: voce, traverso\r\nRonald Martin Alonso: viola da gamba\r\nRafaël Guel Frias: chitarra barocca, flauti e percussioni"
    ],
    "fr": [
      "\"Mujeres\": concert de l'Ensemble Vedado en l'Église Saint-Pierre de Châteloy, le dimanche 19 juillet 2026, à 18h.\r\n\r\nDiana Baroni: voix, traverso\r\nRonald Martin Alonso: viole de gambe\r\nRafaël Guel Frias: guitare baroque, flutes et percussions"
    ],
    "es": [
      "\"Mujeres\": concierto del Ensemble Vedado en la iglesia de Saint-Pierre de Châteloy, el domingo 19 de julio de 2026, a las 18.00 h.\r\n\r\nDiana Baroni: voz, traverso\r\nRonald Martin Alonso: viola de gamba\r\nRafaël Guel Frías: guitarra barroca, flautas y percusión"
    ],
    "nl": [
      "\"Mujeres\": concert door Ensemble Vedado in de kerk Saint-Pierre de Châteloy, op zondag 19 juli 2026, om 18.00 uur.\r\n\r\nDiana Baroni: zang, traverso\r\nRonald Martin Alonso: viola da gamba\r\nRafaël Guel Frias: barokgitaar, fluiten en percussie"
