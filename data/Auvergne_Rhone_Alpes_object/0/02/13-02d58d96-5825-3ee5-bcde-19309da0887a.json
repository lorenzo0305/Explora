  "rdfs:comment": {
    "de": [
      "In Ville-en-Sallaz entsteht ein festliches Bar-Restaurant.\r\nFedern, Lachen, Musik und erhobene Gläser sind in Aussicht.\r\nLes Oies Sauvages, das ist der Wunsch, die Dinge gemeinsam und anders zu machen."
    ],
    "en": [
      "A festive bar-restaurant is springing up in Ville-en-Sallaz.\r\nFeathers, laughter, music and raised glasses in prospect.\r\nLes Oies Sauvages is all about doing things together, differently."
    ],
    "it": [
      "Un bar-ristorante festoso sta sorgendo a Ville-en-Sallaz.\r\nPiume, risate, musica e bicchieri alzati in vista.\r\nLes Oies Sauvages si propone di fare le cose insieme in modo diverso."
    ],
    "fr": [
      "Un bar-restaurant festif est en train d’éclore à Ville-en-Sallaz.\r\nPlumes, rires, musiques et verres levés en perspective.\r\nLes Oies Sauvages, c’est l’envie de faire les choses ensemble, autrement."
    ],
    "nl": [
      "In Ville-en-Sallaz verrijst een feestelijk bar-restaurant.\r\nVeren, gelach, muziek en geheven glazen in het vooruitzicht.\r\nLes Oies Sauvages draait om samen dingen doen op een andere manier."
    ],
    "es": [
      "En Ville-en-Sallaz nace un bar-restaurante festivo.\r\nPlumas, risas, música y copas alzadas.\r\nLes Oies Sauvages es una forma diferente de hacer las cosas juntos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les oies sauvages"
    ]
  },
