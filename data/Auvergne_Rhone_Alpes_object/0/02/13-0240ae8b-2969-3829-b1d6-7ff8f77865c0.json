  "rdfs:comment": {
    "de": [
      "Entdecken Sie die schönsten Wanderungen in einer authentischen Landschaft, die reich an Natur- und Geschichtserbe ist, mit Ihrem passionierten und erfahrenen Reiseleiter"
    ],
    "en": [
      "Discover the most beautiful hikes in an authentic landscape rich in natural and historical heritage with your experienced and passionate guide."
    ],
