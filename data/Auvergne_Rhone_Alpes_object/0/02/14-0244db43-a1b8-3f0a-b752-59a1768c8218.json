  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/08e50f6a-c17d-3e07-b95a-ce709b61ff83",
      "dc:description": {
        "de": [
          "Unternehmen für Fotografie und Video, für Privat- und Geschäftskunden.\nDas ganze Jahr über täglich geöffnet.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-Haves des Shops, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Photography and video company, for individuals and professionals.\nOpen every day of the year.\n\nWant to place an order?\nClick on the \"Book\" button to see the store's must-haves"
        ],
        "it": [
          "Società di fotografia e video, per privati e professionisti.\nAperto tutti i giorni dell'anno.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per vedere tutti i must del negozio"
        ],
        "fr": [
          "Entreprise de Photographie et Vidéo, pour particuliers et professionnels.\nOuvert tous les jours de l'année.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "nl": [
          "Fotografie- en videobedrijf, voor particulieren en professionals.\nElke dag van het jaar geopend.\n\nWil je een bestelling plaatsen?\nKlik op de knop \"Boeken\" om alle musthaves van de winkel te bekijken"
        ],
        "es": [
          "Empresa de fotografía y vídeo, para particulares y profesionales.\nAbierto todos los días del año.\n\n¿Quiere hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver todos los imprescindibles de la tienda"
        ]
      },
      "@type": [
        "Description"
