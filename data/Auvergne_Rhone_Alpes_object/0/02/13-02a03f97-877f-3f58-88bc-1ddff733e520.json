  "rdfs:comment": {
    "de": [
      "Das La Taiga bietet eine Lounge-Bar im Erdgeschoss mit einer großen Auswahl an Cocktails und einen großen Speisesaal in der ersten Etage."
    ],
    "ru": [
      "La Taiga предлагает на первом этаже лаунж-бар с большим выбором коктейлей и большой ресторан на втором этаже."
    ],
    "en": [
      "Cocktail lounge bar with an open fire down stairs  and  fine french cuisine on the first floor. Foie gras,  tuna tartar, fresh fish , savoyard specialities and homemade desserts all served in a typical mountain setting.\r\nSkiers menu at lunchtime,  apres ski cocktail Happy hours with Live music."
    ],
    "it": [
      "La Taiga ha un bar-lounge al piano terra, che serve un'ampia scelta di cocktail, e una grande sala ristorante al primo piano."
    ],
    "fr": [
      "La Taiga propose un bar-lounge au rez-de-chaussée avec un large choix de cocktails et une grande salle de restaurant au premier étage."
    ],
    "es": [
      "La Taiga dispone de un bar-salón en la planta baja con una gran variedad de cócteles, así como un amplio comedor en la primera planta."
    ],
    "nl": [
      "La Taiga biedt een bar-lounge op de begane grond met een breed scala aan cocktails en een grote eetzaal op de eerste verdieping."
    ]
  },
