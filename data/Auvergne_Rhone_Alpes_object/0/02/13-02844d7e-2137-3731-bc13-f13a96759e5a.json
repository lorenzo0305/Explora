  "rdfs:comment": {
    "de": [
      "Hotel und Restaurant 1 km von La Chapelle en Vercors entfernt. 6 geräumige Zimmer mit allem Komfort, die 2 bis 5 Personen beherbergen können, TV, kostenloses WLAN. Kreative Küche mit Lokalkolorit \"hausgemacht\", mit hochwertigen Rohprodukten."
    ],
    "en": [
      "Former farm of the 19th century, situated next to sports and tourist activities. 6 large bedrooms with all mod cons, and a restaurant with its original cooking and local specialties."
    ],
    "it": [
      "Hotel e ristorante a 1 km da La Chapelle en Vercors. 6 camere spaziose e confortevoli per 2-5 persone, TV, wifi gratuito. Cucina creativa casalinga dal sapore locale, con prodotti crudi di qualità."
    ],
    "fr": [
      "Hôtel et restaurant à 1 km de La Chapelle en Vercors. 6 chambres spacieuses tout confort pouvant accueillir de 2 à 5 personnes, TV, wifi gratuit. Cuisine créative aux couleurs locales «fait maison», avec des produits bruts de qualité."
    ],
    "es": [
      "Hotel y restaurante a 1 km de La Chapelle en Vercors. 6 habitaciones amplias y confortables para 2 a 5 personas, TV, wifi gratuito. Cocina casera y creativa con sabor local, a base de materias primas de calidad."
    ],
    "nl": [
      "Hotel en restaurant op 1 km van La Chapelle en Vercors. 6 ruime, comfortabele kamers voor 2 tot 5 personen, tv, gratis wifi. Creatieve huisgemaakte keuken met een lokaal tintje, met gebruik van kwaliteitsgrondstoffen."
    ]
  },
