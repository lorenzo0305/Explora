  "rdfs:comment": {
    "de": [
      "Diese Institution verwöhnt die Auvergne seit 1904 in einem großen Raum mit Eichenparkett, dessen Fenster zu einem Innengarten führen. Küche mit klugen und leckeren Ideen. Käsewagen gross. Hübsche Weinkarte."
    ],
    "en": [
      "The Restaurant Castel 1904 offers you a cuisine of wise and gourmet ideas. More than 120 years of existence in the Combrailles have forged its reputation and experience."
    ],
    "it": [
      "Situato in Alvernia, nel cuore delle Combrailles. Il ristorante Castel 1904 offre una cucina di idee sapienti e gourmet.\r\n\"Oltre 120 anni di esperienza nelle Combrailles hanno forgiato la nostra reputazione."
    ],
    "fr": [
      "Situé en Auvergne au cœur des Combrailles. Le Restaurant Castel 1904 vous propose une cuisine d'idées sages et gourmandes. \r\n\"Plus de 120 ans d’existence dans les Combrailles nous ont forgé notre expérience et notre notoriété\"."
    ],
    "es": [
      "Situado en Auvernia, en el corazón de las Combrailles. El restaurante Castel 1904 ofrece una cocina de ideas sabias y gastronómicas.\r\n\"Más de 120 años de experiencia en las Combrailles han forjado nuestra reputación."
    ],
    "nl": [
      "Deze instelling verrukt de Auvergne sinds 1904 in een grote kamer met eiken parket waarvan de ramen uitkomen op een binnentuin. Keuken van wijze en gastronomische ideeën. Grote kaaswagen. Leuke wijnkaart."
    ]
  },
  "rdfs:label": {
