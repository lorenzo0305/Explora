  "rdfs:comment": {
    "de": [
      "Lernen Sie Sara kennen, eine Passementierin, die ihren Beruf in Meyras mit Leidenschaft ausübt. Die Passementerie-Werkstatt befindet sich in den ehemaligen Fabriken von Neyrac am Ufer der Ardèche."
    ],
    "en": [
      "Meet Sara, a passementerie artisan who is passionate about her work in Meyras. The passementerie workshop is located in the former factories of Neyrac, on the banks of the Ardèche River."
    ],
    "it": [
      "Incontrate Sara, una passementière con la passione per il suo mestiere, che pratica a Meyras. Il laboratorio di passamaneria si trova nelle vecchie fabbriche di Neyrac, sulle rive dell'Ardèche."
    ],
    "fr": [
      "Partez à la rencontre de Sara, passementière passionnée par son métier qu'elle exerce à Meyras. L'atelier de passementerie est installé dans les anciennes fabriques de Neyrac, sur le bord de l’Ardèche."
    ],
    "nl": [
      "Maak kennis met Sara, een passementière met een passie voor haar vak, dat ze uitoefent in Meyras. Het garniturenatelier bevindt zich in de oude fabrieken van Neyrac, aan de oevers van de Ardèche."
    ],
    "es": [
      "Conozca a Sara, una pasamanera apasionada por su oficio, que practica en Meyras. El taller de pasamanería se encuentra en las antiguas fábricas de Neyrac, a orillas del Ardèche."
    ]
  },
  "rdfs:label": {
