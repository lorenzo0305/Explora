  "rdfs:comment": {
    "de": [
      "Dieser Orientierungslauf im Herzen des Kulturerbes der Stadt Coublevie garantiert eine gute Zeit der Herausforderung mit der Familie oder mit Freunden."
    ],
    "en": [
      "This orienteering course, in the heart of Coublevie's heritage, is guaranteed to be a great challenge for family and friends."
    ],
    "it": [
      "Questo percorso di orienteering, nel cuore del patrimonio di Coublevie, è una grande sfida per tutta la famiglia o per pochi amici."
    ],
    "fr": [
      "Ce parcours d'orientation au cœur du patrimoine de la ville de Coublevie, garantie un bon moment de défi en famille ou entre amis."
    ],
    "es": [
      "Este recorrido de orientación en el corazón del patrimonio de Coublevie garantiza un gran desafío para toda la familia o para unos pocos amigos."
    ],
    "nl": [
      "Dit oriëntatieloopparcours in het hart van het erfgoed van Coublevie is gegarandeerd een geweldige uitdaging voor het hele gezin of voor een paar vrienden."
