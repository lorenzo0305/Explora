  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung von Harnes veranstaltet in Zusammenarbeit mit der AGAC und der Region erneut ihre Sommerquartiere \"Nos quartiers préparent les jeux\" (Unsere Stadtviertel bereiten die Spiele vor) im Bouthemy-Komplex."
    ],
    "en": [
      "The Municipality of Harnes, in partnership with the AGAC and the Region, renews its Quartiers d?été \"Nos quartiers préparent les jeux\", at the Bouthemy complex."
    ],
    "it": [
      "Il Comune di Harnes, in collaborazione con l'AGAC e la Regione, organizza nuovamente il festival estivo \"Nos quartiers préparent les jeux\" (I nostri quartieri si preparano ai giochi) presso il complesso Bouthemy."
    ],
    "fr": [
      "La Municipalité de Harnes, en partenariat avec l’AGAC et la Région, renouvelle ses Quartiers d’été «Nos quartiers préparent les jeux», au complexe Bouthemy."
    ],
    "es": [
      "El Ayuntamiento de Harnes, en colaboración con la AGAC y la Región, organiza un año más su festival de verano \"Nos quartiers préparent les jeux\" (Nuestros barrios se preparan para los juegos) en el complejo Bouthemy."
    ],
    "nl": [
      "De gemeenteraad van Harnes organiseert in samenwerking met de AGAC en de regio opnieuw het zomerfestival \"Nos quartiers préparent les jeux\" (Onze wijken bereiden zich voor op de spelen) in het Bouthemy-complex."
    ]
  },
