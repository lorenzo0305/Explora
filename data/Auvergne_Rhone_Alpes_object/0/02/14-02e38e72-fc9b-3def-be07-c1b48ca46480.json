  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bb6ce0bb-7989-32a6-a5d5-0b87b9605623",
      "dc:description": {
        "de": [
          "Das Team der Mediathek bietet Kindern von 3 bis 6 Jahren die Möglichkeit, die Macht der Fantasie mithilfe von Büchern zu entdecken, die speziell für die Kleinsten bestimmt sind."
        ],
        "en": [
          "The mediatheque team invites children aged 3 to 6 to discover the power of imagination through books dedicated to the very young."
        ],
        "it": [
          "Il team della mediateca offre ai bambini dai 3 ai 6 anni la possibilità di scoprire il potere dell'immaginazione attraverso libri appositamente studiati per i più piccoli."
        ],
        "fr": [
          "L'équipe de la médiathèque propose aux enfants de 3 à 6 ans de découvrir le pouvoir imaginaire au travers d'ouvrages dédiés aux plus petits."
        ],
        "nl": [
          "Het mediatheekteam biedt kinderen van 3 tot 6 jaar de kans om de kracht van de verbeelding te ontdekken door middel van boeken die speciaal zijn ontworpen voor de allerkleinsten."
        ],
        "es": [
          "El equipo de la mediateca ofrece a los niños de 3 a 6 años la posibilidad de descubrir el poder de la imaginación a través de libros especialmente diseñados para los más pequeños."
        ]
      },
