  "rdfs:comment": {
    "de": [
      "Der Chaudron d'Or setzt sein ganzes Know-how in die traditionelle Herstellung von Nougat ein, dieser leckeren Delikatesse, die Symbolspezialität der Stadt."
    ],
    "en": [
      "Le Chaudron d´Or concentrates all its expertise into making nougat, this delicious delicacy and an iconic speciality of the town, according to traditional manufacturing methods."
    ],
    "it": [
      "Le Chaudron d'Or mette tutta la sua esperienza nella produzione tradizionale del Nougat de Montélimar, la deliziosa specialità della città."
    ],
    "fr": [
      "Le Chaudron d’Or met tout son savoir-faire dans la fabrication traditionnelle de Nougat de Montélimar, cette délicieuse gourmandise, spécialité emblématique de la ville."
    ],
    "es": [
      "Le Chaudron d'Or pone todo su saber hacer en la elaboración artesanal del Turrón de Montélimar, el delicioso manjar que constituye la especialidad emblemática de la ciudad."
    ],
    "nl": [
      "De fabriek in het hart van de stad zet de traditie sinds 1949 voort door de echte nougat van Montélimar te verzinnen in zijn authentieke koperen ketels."
    ]
  },
