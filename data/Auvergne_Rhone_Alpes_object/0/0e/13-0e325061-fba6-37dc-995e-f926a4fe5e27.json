  "rdfs:comment": {
    "de": [
      "Das MiL8, ein 4-Sterne-Designhotel im Herzen von Avoriaz, vereint Chic und Gemütlichkeit. Ski an den Füßen, direkter Zugang zu den Pisten, Wohnzimmer mit Kamin, Bar und Sonnenterrasse. Gewagte Architektur und modernes Bergambiente für einen unvergesslichen Aufenthalt."
    ],
    "en": [
      "Le MiL8, a 4-star design hotel in the heart of Avoriaz, combines chic style with a friendly atmosphere. Ski-in/ski-out access, direct access to the slopes, a lounge with fireplace, bar and sunny terrace. Bold architecture and contemporary mountain vibes for an unforgettable stay."
    ],
    "it": [
      "Il MiL8, hotel di design a 4 stelle nel cuore di Avoriaz, unisce chic e convivialità. Ski in, ski out, accesso diretto alle piste, lounge con camino, bar e terrazza soleggiata. Un'architettura audace e un'atmosfera di montagna contemporanea per un soggiorno indimenticabile."
    ],
    "fr": [
      "Le MiL8, hôtel 4 design au cœur d’Avoriaz, allie chic et convivialité. Ski aux pieds, accès direct aux pistes, salon avec cheminée, bar et terrasse ensoleillée. Architecture audacieuse et ambiance montagne contemporaine pour un séjour inoubliable."
    ],
    "nl": [
      "Le MiL8, een 4-sterren designhotel in het hart van Avoriaz, combineert stijl en gezelligheid. Ski-in/ski-out, directe toegang tot de pistes, lounge met open haard, bar en zonnig terras. Gedurfde architectuur en een eigentijdse bergsfeer voor een onvergetelijk verblijf."
    ],
    "es": [
      "El MiL8, hotel de diseño de 4 estrellas en el corazón de Avoriaz, combina elegancia y convivencia. Ski in, ski out, acceso directo a las pistas, salón con chimenea, bar y terraza soleada. Una arquitectura atrevida y un ambiente de montaña contemporáneo para una estancia inolvidable."
    ]
  },
