  "rdfs:comment": {
    "de": [
      "Das L'abside befindet sich im Herzen des Stadtzentrums von Aurillacois. Diese Bar-Brasserie ist 7 Tage die Woche geöffnet und bietet von Montag bis Samstag nur mittags einen Restaurantservice an."
    ],
    "en": [
      "L'Abside Antonelli, bar-brasserie is located next the Notre-Dame aux Neiges Church in the heart of Aurillac. A busy and vibrant restaurant and a warm, friendly atmosphere. Italian cuisine. Welcome Label for cyclists."
    ],
    "it": [
      "L'abside si trova nel cuore del centro di Aurillac. Questo bar-brasserie è aperto 7 giorni su 7 e offre un servizio di ristorazione dal lunedì al sabato solo a pranzo."
    ],
    "fr": [
      "L’abside est situé au cœur du centre-ville Aurillacois. Ce bar-brasserie est ouvert 7j/7 et assure un service de restauration du lundi au samedi uniquement le midi."
    ],
    "nl": [
      "L'abside ligt in het hart van het centrum van Aurillac. Deze bar-brasserie is 7 dagen per week geopend en biedt van maandag tot zaterdag alleen 's middags een restaurantservice."
    ],
    "es": [
      "El \"Abside\" es un lugar atípico ya que es un comercio centenario y está adosado a una iglesia."
    ]
  },
