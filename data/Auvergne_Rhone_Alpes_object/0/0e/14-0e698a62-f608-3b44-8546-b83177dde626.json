      "@id": "https://data.datatourisme.fr/6ebc60ea-592d-3927-b1ba-3e03b6d16622",
      "dc:description": {
        "de": [
          "Komm und erschrecke dich! Gruselige Kirmes, böses Buffet, Wahl des Terri?Fun-freundlichsten Kostüms.\nFür 8/15-Jährige. 15?/Kind.\nAnmeldungen (nächste) auf der Website www.billetweb.fr/animations-enfants-toussaint-2024"
        ],
        "en": [
          "Come and have a scare! Scary fair, evil buffet, election of the most Terri?Fun costume.\nAges 8/15. 15/child.\nRegistration (coming soon) on www.billetweb.fr/animations-enfants-toussaint-2024"
        ],
        "it": [
          "Venite a spaventarvi! Fiera spaventosa, buffet malefico, elezione del costume più divertente di Terri.\nPer bambini di 8/15 anni. 15/bambino.\nIscrizioni (a breve) sul sito www.billetweb.fr/animations-enfants-toussaint-2024"
        ],
        "fr": [
          "Viens te faire une frayeur ! Kermesse effrayante, buffet maléfique, élection du plus Terri’Fun des costumes. \nPour les 8/15 ans. 15€/enfant. \nInscriptions (prochaines) sur le site internet www.billetweb.fr/animations-enfants-toussaint-2024"
        ],
        "es": [
          "¡Ven a pasar miedo! Feria del miedo, buffet del mal, elección del disfraz más Terri?divertido.\nPara niños de 8/15 años. 15/niño.\nInscripciones (próximamente) en la web www.billetweb.fr/animations-enfants-toussaint-2024"
        ],
        "nl": [
          "Kom en laat je de stuipen op het lijf jagen! Enge kermis, boosaardig buffet, verkiezing van het meest Terri?-leuke kostuum.\nVoor 8/15 jaar. 15/kind.\nInschrijven (binnenkort) op de website www.billetweb.fr/animations-enfants-toussaint-2024"
        ]
      },
