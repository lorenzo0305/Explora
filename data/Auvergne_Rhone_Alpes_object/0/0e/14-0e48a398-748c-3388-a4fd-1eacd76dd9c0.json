  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16d759c6-1158-378f-ade9-bb3ec34e5630",
      "dc:description": {
        "de": [
          "Die Chèvrerie de la Planquette organisiert einen Couscous-Abend\nTreffpunkt ist am Samstag, den 23. August ab 19 Uhr in der Chèvrerie\nTarif für Erwachsene: 22 ? - Kindertarif: 12 ? (unter 12 Jahren)"
        ],
        "en": [
          "Chèvrerie de la Planquette organizes a couscous evening\nJoin us on Saturday August 23rd from 7pm at the goat farm\nAdult price: 22 ? - Children: 12 ? (under 12)"
        ],
        "it": [
          "La Chèvrerie de la Planquette organizza una serata di couscous\nSabato 23 agosto dalle 19.00 presso la fattoria delle capre\nPrezzo per gli adulti: 22 ? - Bambini: 12 ? (sotto i 12 anni)"
        ],
        "fr": [
          "La Chèvrerie de la Planquette organise une soirée couscous\nRendez-vous le samedi 23 août dès 19h à la chèvrerie\nTarif adulte : 22 € - Tarif enfant : 12 € (moins de 12 ans)"
        ],
        "es": [
          "La Chèvrerie de la Planquette organiza una velada de cuscús\nSábado 23 de agosto a partir de las 19 h en la granja de cabras\nPrecio adulto: 22€ - Niños: 12€ (menores de 12 años)"
        ],
        "nl": [
          "De Chèvrerie de la Planquette organiseert een couscousavond\nZaterdag 23 augustus vanaf 19u op de geitenboerderij\nPrijs volwassenen: 22 ? - Kinderen: 12 ? (onder 12 jaar)"
        ]
      },
