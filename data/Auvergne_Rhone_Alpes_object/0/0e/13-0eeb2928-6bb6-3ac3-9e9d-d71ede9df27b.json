  "rdfs:comment": {
    "de": [
      "An der Trailstation Place Fouillat an der D1 am Südeingang von Violay können Sie Ihre Umkleidekabinen finden und reservieren, um ein komfortables Sporterlebnis zu genießen."
    ],
    "en": [
      "From the Trail station, Place Fouillat on the D1, at the southern entrance to Violay, find and reserve your changing rooms, for a comfortable sporting experience."
    ],
    "it": [
      "Dalla stazione Trail di Place Fouillat sulla D1, all'ingresso sud di Violay, trovate e prenotate i vostri spogliatoi per un'esperienza sportiva confortevole."
    ],
    "fr": [
      "Au départ de la station Trail, Place Fouillat située sur la D1, à l’entrée sud de Violay, retrouvez et réservez vos vestiaires, pour une expérience sportive tout confort."
    ],
    "nl": [
      "Vanaf het Trail station op Place Fouillat op de D1, bij de zuidelijke ingang van Violay, kun je je kleedkamers vinden en reserveren voor een comfortabele sportieve ervaring."
    ],
    "es": [
      "Desde la estación de Trail de la Place Fouillat en la D1, en la entrada sur de Violay, busque y reserve sus vestuarios para disfrutar de una cómoda experiencia deportiva."
    ]
  },
