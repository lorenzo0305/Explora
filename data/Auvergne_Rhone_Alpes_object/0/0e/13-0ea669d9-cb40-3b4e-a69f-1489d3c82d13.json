  "rdfs:comment": {
    "de": [
      "Das Netz der Mediatheken von Ambert Livradois Forez ist in sechs Sektoren gegliedert: Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues und Vallée de l'Ance. Erkunden Sie die Buch- und Videosammlungen und nehmen Sie das ganze Jahr über an Animationen und Spielen teil."
    ],
    "en": [
      "The Ambert Livradois Forez media library network is structured around 6 sectors: Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues and Vallée de l?Ance. Explore the collections of books and videos, and take part in activities and games all year round."
    ],
    "it": [
      "La rete di mediateche Ambert Livradois Forez è strutturata in 6 settori: Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues e Vallée de l'Ance. Esplorate le collezioni di libri e video e partecipate a eventi e giochi durante tutto l'anno."
    ],
    "fr": [
      "Le réseau des médiathèques d’Ambert Livradois Forez est structuré autour de 6 secteurs : Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues et Vallée de l’Ance. Explorez les collections de livres, vidéos et participer aux animations, jeux toute l’année."
    ],
    "es": [
      "La red de mediatecas Ambert Livradois Forez se estructura en torno a 6 sectores: Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues y Vallée de l'Ance. Explore las colecciones de libros y vídeos y participe en eventos y juegos durante todo el año."
    ],
    "nl": [
      "Het netwerk van mediatheken Ambert Livradois Forez is gestructureerd rond 6 sectoren: Ambert, Arlanc, Cunlhat, Haut-Livradois, Olliergues en Vallée de l?Ance. Ontdek de collecties boeken en video's en doe het hele jaar door mee aan evenementen en spelletjes."
    ]
  },
