  "rdfs:comment": {
    "de": [
      "Ein Universum, in dem sich die Liebe zu Salers-Kühen, zeitgenössischer Kunst und Ökologie überschneidet.\r\nLucie-Maria De Paloma ist umweltbewusst und erweckt die poppigen und farbenfrohen Meuh Meuh-Kühe aus Abfallmaterialien zum Leben."
    ],
    "en": [
      "A universe at the intersection of a love of Salers cows, contemporary art and ecology.\r\nIn a spirit of environmental awareness, Lucie-Maria De Paloma gives life to Meuh Meuh, colorful pop cows made from recycled materials."
    ],
    "it": [
      "Un universo all'incrocio tra l'amore per le mucche Salers, l'arte contemporanea e l'ecologia.\r\nLucie-Maria De Paloma dà vita alle Meuh Meuh, coloratissime mucche pop realizzate con materiali riciclati."
    ],
    "fr": [
      "Univers à l’intersection d’un amour pour les vaches Salers, l’art contemporain et l’écologie. \r\nDans un sentiment soucieux de l’environnement, Lucie-Maria De Paloma donne vie aux Meuh Meuh, vaches pop et colorées, à partir de matériaux de récupération."
    ],
    "es": [
      "Un universo en el que confluyen el amor por las vacas Salers, el arte contemporáneo y la ecología.\r\nLucie-Maria De Paloma da vida a las Meuh Meuh, coloridas vacas pop fabricadas con materiales reciclados."
    ],
    "nl": [
      "Een universum op het kruispunt van liefde voor Salers koeien, hedendaagse kunst en ecologie.\r\nLucie-Maria De Paloma brengt de Meuh Meuh tot leven, kleurrijke popkoeien gemaakt van gerecycled materiaal."
    ]
  },
