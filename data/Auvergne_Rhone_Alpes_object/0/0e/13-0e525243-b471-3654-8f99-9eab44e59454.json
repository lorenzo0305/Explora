  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein Weingut mit authentischem Charakter, auf dem eine \"amerikanische Presse\" aus Holz thront, in der alle unsere Trauben gepresst werden. Verkostung, Verkauf und Versand von Beaujolais, Brouilly, Côte de Brouilly und Chardonnay-Weißwein IGP."
    ],
    "en": [
      "Discover an estate with an authentic character, featuring a wooden \"American press\" in which all our grapes are pressed. Tasting, sales and shipping of Beaujolais, Brouilly, Côte de Brouilly and IGP Chardonnay white wines."
    ],
    "it": [
      "Scoprite una tenuta dal carattere autentico, dove una \"pressa americana\" in legno viene utilizzata per pigiare tutte le nostre uve. Degustazione, vendita e spedizione di vino bianco Beaujolais, Brouilly, Côte de Brouilly e Chardonnay IGP."
    ],
    "fr": [
      "Découvrez un domaine au caractère authentique où trône un \"pressoir américain\" en bois dans lequel tous nos raisin sont pressés. Dégustation, vente et expédition de Beaujolais, Brouilly, Côte de Brouilly et de vin blanc Chardonnay IGP."
    ],
    "nl": [
      "Ontdek een domein met een authentiek karakter waar een \"Amerikaanse pers\" van hout wordt gebruikt om al onze druiven te persen. Proeverij, verkoop en verzending van Beaujolais, Brouilly, Côte de Brouilly en Chardonnay IGP witte wijn."
    ],
    "es": [
      "Descubra una finca con carácter auténtico donde se utiliza una \"prensa americana\" de madera para prensar todas nuestras uvas. Degustación, venta y envío de vino blanco Beaujolais, Brouilly, Côte de Brouilly y Chardonnay IGP."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Perrusset"
    ]
  },
