  "rdfs:comment": {
    "de": [
      "Atelier-Boutique von Kunsthandwerkern in St-Jean-St-Maurice-sur-Loire, Village de Caractère und von Kreativen... Illustration und Grafikdesign. Druck durch handwerklichen Siebdruck auf Papier und Textilien. Entdeckungsworkshop und Einführung in den Siebdruck."
    ],
    "en": [
      "Artisan's workshop-boutique in St-Jean-St-Maurice-sur-Loire, Village de Caractère et de créateurs... Illustration and graphic design. Handmade silk-screen printing on paper and textiles. Discovery workshop and introduction to screen printing."
    ],
    "it": [
      "Laboratorio artigianale a St-Jean-St-Maurice-sur-Loire, Village de Caractère e creatori... Illustrazione e design grafico. Serigrafia artigianale su carta e tessuti. Laboratorio di scoperta e introduzione alla serigrafia."
    ],
    "fr": [
      "Atelier-boutique d'artisan d'art à St-Jean-St-Maurice-sur-Loire, Village de Caractère et de créateurs... Illustration et graphisme. Impression par sérigraphie artisanale sur papier et textile. Atelier découverte et initiation à la sérigraphie."
    ],
    "es": [
      "Taller artesanal en St-Jean-St-Maurice-sur-Loire, Village de Caractère y creadores... Ilustración y diseño gráfico. Serigrafía artesanal sobre papel y textil. Taller de descubrimiento e iniciación a la serigrafía."
    ],
    "nl": [
      "Ambachtelijk atelier in St-Jean-St-Maurice-sur-Loire, Village de Caractère en... Illustratie en grafisch ontwerp. Handgemaakte zeefdruk op papier en textiel. Ontdekkingsworkshop en kennismaking met zeefdrukken."
    ]
  },
