  "rdfs:comment": {
    "de": [
      "Das Kino in Megève bietet sowohl kommerzielle Filme als auch Autorenfilme an. Es gibt zwei Vorstellungen pro Tag, und jeden Tag wird ein anderer Film gezeigt!"
    ],
    "en": [
      "The Megève cinema offers both commercial and arthouse films. There are two screenings a day, and a different film is shown every day!"
    ],
    "it": [
      "Il cinema Megève propone film commerciali e d'autore. Ci sono due proiezioni al giorno e ogni giorno viene proiettato un film diverso!"
    ],
    "fr": [
      "Le cinéma de Megève propose à la fois des films commerciaux, et des films d’auteur. Il y a deux séances par jour, et chaque jour un film différent est projeté !"
    ],
    "es": [
      "El cine de Megève ofrece tanto películas comerciales como de arte y ensayo. Hay dos proyecciones al día, ¡y cada día se proyecta una película diferente!"
    ],
    "nl": [
      "De bioscoop van Megève biedt zowel commerciële als arthousefilms. Er zijn twee voorstellingen per dag en er wordt elke dag een andere film vertoond!"
    ]
  },
