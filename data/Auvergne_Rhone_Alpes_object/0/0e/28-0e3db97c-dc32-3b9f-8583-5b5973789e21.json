  "rdfs:comment": {
    "de": [
      "Massage und Fußreflexzonenmassage in Outrebois und Doullennais.\n \nMehrere von Delphine angebotene Leistungen:\nHand-, Arm- und Rückenmassage, Beinmassage, balinesische, schwedische, thailändische und Hot-Stone-Massagen!\nDuo-Massage.\n\nReservierungen sind auf der Website möglich!"
    ],
    "en": [
      "Massage and foot reflexology in Outrebois and the Doullennais region.\n \nDelphine offers a range of services:\nHand, arm and back massages, leg massage, Balinese, Swedish, Thai and hot stone massages!\nDuo massage.\n\nReservations can be made online!"
    ],
    "it": [
      "Massaggio e riflessologia plantare a Outrebois e nel Doullennais.\n \nDelphine offre una gamma di servizi:\nMassaggi alle mani, alle braccia e alla schiena, massaggi alle gambe, massaggi balinesi, svedesi, thailandesi e con pietre calde!\nMassaggio duo.\n\nLe prenotazioni possono essere effettuate online!"
    ],
    "fr": [
      "Massage et réflexologie plantaire à Outrebois  et dans le Doullennais.\n \nPlusieurs prestations proposées par Delphine :\nMassages des mains, des bras et du dos, massage des jambes, massages balinais, suédois, thaïlandais et aux pierres chaudes !\nMassage Duo.\n\nRéservation possible sur le site internet !"
    ],
    "nl": [
      "Massage en voetreflexologie in Outrebois en de Doullennais.\n \nDelphine biedt een scala aan diensten:\nHand-, arm- en rugmassages, beenmassage, Balinese, Zweedse, Thaise en hot stone massages!\nDuo massage.\n\nReserveren kan online!"
    ],
    "es": [
      "Masaje y reflexología podal en Outrebois y el Doullennais.\n \nDelphine ofrece una amplia gama de servicios:\nMasajes de manos, brazos, espalda, piernas, balinés, sueco, tailandés y con piedras calientes\nMasaje a dúo.\n\nReservas en línea"
    ]
  },
