  "rdfs:comment": {
    "de": [
      "Bio-Bauernkäse mit Artisous, aus Rohmilch von Kühen, die mit Gras und Heu von natürlichen Wiesen gefüttert werden. Sie sind mild oder gereift und ein typisches Produkt der Haute-Loire. Entdecken Sie sie im Direktverkauf auf dem Bauernhof zu den angegebenen Öffnungszeiten."
    ],
    "en": [
      "Artisanal organic farmhouse cheeses, made with raw milk from cows fed on grass and hay from natural meadows. Mild or matured, they are typical Haute-Loire products. Come and discover them for direct sale at the farm, at the times indicated."
    ],
    "it": [
      "Formaggi artigianali biologici di fattoria, prodotti con latte crudo di mucche alimentate con erba e fieno di prati naturali. Delicati o stagionati, sono prodotti tipici dell'Alta Loira. È possibile acquistarli direttamente in fattoria negli orari indicati."
    ],
    "fr": [
      "Fromages fermiers bio aux artisous, au lait cru de vaches nourries à l’herbe et au foin des prairies naturelles. Doux ou affinés, ils sont des produits typiques de la Haute-Loire. Venez les découvrir en vente directe à la Ferme, aux horaires indiquées."
    ],
    "es": [
      "Quesos artesanos de granja ecológicos, elaborados con leche cruda de vacas alimentadas con hierba y heno de prados naturales. Suaves o madurados, son productos típicos del Alto Loira. Puede comprarlos directamente en la granja en los horarios indicados."
    ],
    "nl": [
      "Ambachtelijke biologische boerenkazen, gemaakt van rauwe melk van koeien die gras en hooi van natuurlijke weiden eten. Mild of gerijpt, het zijn typische Haute-Loire producten. U kunt ze rechtstreeks bij de boerderij kopen op de aangegeven tijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC Ferme des Granges"
    ]
  },
