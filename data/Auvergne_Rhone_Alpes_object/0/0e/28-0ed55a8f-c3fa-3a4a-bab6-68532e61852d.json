  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f748e69d-1838-3d18-8961-78188e062852",
      "dc:description": {
        "de": [
          "Hausgemachte Küche aus frischen Zutaten von einem ehemaligen Metzger. Estaminet-Karte und Brasserie-Karte, zahlreiche Burger.\nGroße Karte mit belgischen Bieren\n\nINFO +: Bietet vegetarische Gerichte an/ Sonntagmittag geöffnet.\nWir akzeptieren Gruppen bis zu 58 Personen nach vorheriger Reservierung."
        ],
        "en": [
          "Homemade cuisine based on fresh produce by a former butcher. A la carte estaminet and brasserie menu, with numerous burgers.\nExtensive Belgian beer list\n\nINFO + : vegetarian dishes available/open Sunday lunchtime.\nWe accept groups of up to 58 people on reservation."
        ],
        "it": [
          "Cucina casalinga con prodotti freschi di un ex macellaio. Menù da estaminet e brasserie, molti hamburger.\nAmpia selezione di birre belghe\n\nINFO + : piatti vegetariani disponibili/aperto la domenica a pranzo.\nAccettiamo gruppi fino a 58 persone su prenotazione."
        ],
        "fr": [
          "Cuisine faite maison à base de produits frais par un ancien boucher. Carte estaminet et carte brasserie, nombreux burgers.\nGrande carte de bières belges\n\nINFO + : propose des plats végétariens/ouvert le dimanche midi.\nNous acceptons les groupes jusqu'à 58 personnes sur réservation."
        ],
        "nl": [
          "Huisgemaakte keuken met verse producten van een voormalige slager. Estaminet en brasseriemenu, veel hamburgers.\nGrote selectie Belgische bieren\n\nINFO + : vegetarische gerechten mogelijk/open zondagmiddag.\nWij aanvaarden groepen tot 58 personen op reservatie."
        ],
        "es": [
          "Cocina casera elaborada con productos frescos por un antiguo carnicero. Menú de estaminet y brasserie, muchas hamburguesas.\nGran selección de cervezas belgas\n\nINFO + : platos vegetarianos disponibles/abierto los domingos al mediodía.\nAceptamos grupos de hasta 58 personas previa reserva."
        ]
      },
      "@type": [
        "Description"
      ],
