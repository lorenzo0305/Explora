  "rdfs:comment": {
    "de": [
      "Das Restaurant & Café \"Les Terrasses des Augustins\" liegt im Herzen von Crémieu, in der Nähe des Klosters und des Rathauses, am Place de la Nation. Es bietet Ihnen eine authentische und traditionelle Küche in einem angenehmen und gemütlichen Rahmen."
    ],
    "en": [
      "Located in the heart of Crémieu, near the cloister and the town hall, on the Place de la Nation, the Restaurant & Café, Les Terrasses des Augustins, offers authentic and traditional cuisine in a pleasant and warm setting."
    ],
    "it": [
      "Situato nel cuore di Crémieu, vicino al chiostro e al municipio, in Place de la Nation, il ristorante e caffè \"Les Terrasses des Augustins\" offre una cucina autentica e tradizionale in un ambiente caldo e accogliente."
    ],
    "fr": [
      "Situé en plein cœur de Crémieu, à proximité du cloître et de l’hôtel de ville, sur la place de la Nation, le restaurant & café \"Les Terrasses des Augustins\" vous propose une cuisine authentique et traditionnelle dans un cadre agréable et chaleureux."
    ],
    "es": [
      "Situado en el corazón de Crémieu, cerca del claustro y del ayuntamiento, en la Place de la Nation, el restaurante y café \"Les Terrasses des Augustins\" ofrece una cocina auténtica y tradicional en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Het restaurant en café \"Les Terrasses des Augustins\" ligt in het hart van Crémieu, dicht bij het klooster en het stadhuis, op de Place de la Nation. Het biedt authentieke, traditionele gerechten in een warme en gastvrije omgeving."
    ]
  },
