  "rdfs:comment": {
    "de": [
      "Im Land der 145 Quellen vereint die prickelnde Stadt Vals-les-Bains Wohlbefinden und Lebensfreude\r\n\r\n- Buchungsservice für Ihre Aktivitäten.\r\n- Ticketservice für lokale Veranstaltungen."
    ],
    "en": [
      "In the land of 145 springs, Vals-les-Bains, a sparkling town, combines well-being and pleasure of living\r\n\r\n- Booking service for your activities.\r\n- Ticketing service for local events."
    ],
    "it": [
      "Nella terra delle 145 sorgenti, Vals-les-Bains, città frizzante, unisce benessere e piacere di vivere\r\n\r\n- Servizio di prenotazione per le vostre attività.\r\n- Servizio di biglietteria per eventi locali."
    ],
    "fr": [
      "Au pays des 145 sources, Vals-les-Bains, ville pétillante, allie bien-être et plaisir de vivre. \r\n\r\n- Service de réservation pour vos activités.\r\n- Service Billetterie des animations locales."
    ],
    "nl": [
      "In het land van de 145 bronnen combineert Vals-les-Bains, een bruisende stad, welzijn en woongenot\r\n\r\n- Reserveringsdienst voor uw activiteiten.\r\n- Ticketing service voor lokale evenementen."
    ],
    "es": [
      "En la tierra de los 145 manantiales, Vals-les-Bains, una ciudad chispeante, combina el bienestar y el placer de vivir\r\n\r\n- Servicio de reservas para sus actividades.\r\n- Servicio de venta de entradas para eventos locales."
    ]
  },
