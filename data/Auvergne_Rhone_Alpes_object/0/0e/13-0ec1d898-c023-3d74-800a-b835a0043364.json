  "rdfs:comment": {
    "de": [
      "Die von uns angebotenen Produkte stammen ausschließlich aus unseren Bienenstöcken, werden geerntet und handwerklich verarbeitet, um in ihrer rohesten Integrität wiedergegeben zu werden."
    ],
    "en": [
      "The products we offer come exclusively from our own beehives, harvested and crafted by hand to be restored to their purest integrity."
    ],
    "it": [
      "I prodotti che offriamo provengono esclusivamente dai nostri alveari, raccolti e lavorati a mano per essere restituiti nella loro integrità grezza."
    ],
    "fr": [
      "Les produits que nous proposons sont exclusivement issus de nos ruches, récoltés et élaborés artisanalement pour être restitués dans leur intégrité la plus brute."
    ],
    "es": [
      "Los productos que ofrecemos proceden exclusivamente de nuestras propias colmenas, cosechados y procesados a mano para devolverlos en su integridad."
    ],
    "nl": [
      "De producten die we aanbieden komen uitsluitend uit onze eigen bijenkorven en worden op traditionele wijze geoogst en verwerkt, zodat ze in hun puurste vorm kunnen worden genoten."
    ]
  },
