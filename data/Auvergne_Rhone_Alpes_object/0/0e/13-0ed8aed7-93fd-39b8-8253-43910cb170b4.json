  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage von Aurec-sur-Loire ist ein Badeort, der sich für erfrischende Sprünge in die Loire anbietet. Im Juli und August wird das Baden überwacht."
    ],
    "en": [
      "The Aurec-sur-Loire leisure center is the perfect place to take a refreshing dip in the Loire. Supervised swimming in July and August."
    ],
    "it": [
      "Il centro ricreativo di Aurec-sur-Loire è un luogo ideale per fare un tuffo rinfrescante nella Loira. Nuoto sorvegliato in luglio e agosto."
    ],
    "fr": [
      "La base de loisirs d'Aurec-sur-Loire est un site de baignade propice aux plongeons rafraîchissants dans la Loire. Baignade surveillée en juillet et août."
    ],
    "nl": [
      "Het recreatiecentrum van Aurec-sur-Loire is een geweldige plek voor een verfrissende duik in de Loire. Zwemmen onder toezicht in juli en augustus."
    ],
    "es": [
      "El centro de ocio de Aurec-sur-Loire es un lugar ideal para refrescarse en el Loira. Natación vigilada en julio y agosto."
    ]
  },
  "rdfs:label": {
    "en": [
      "Supervised swimming on the banks of the Loire River"
    ],
    "fr": [
      "Baignade surveillée sur les rives de la Loire"
    ]
  },
