  "rdfs:comment": {
    "de": [
      "Vielfältiger Familienbauernhof mit Obst- und Gemüseanbau, Honig, Oliven und Öl mit geschützter Ursprungsbezeichnung Nyons, Fruchtsäften, Dinkel...\r\nIntegrierter und biologischer Landbau je nach Kulturen."
    ],
    "en": [
      "Diversified family farm with crops of fruit and vegetables, honey, olives and PDO Nyons oil, fruit juices, spelt...\r\nSustainable and organic farming depending on crop."
    ],
    "it": [
      "Azienda agricola familiare diversificata che coltiva frutta e verdura, miele, olive e olio di Nyons DOP, succhi di frutta, farro...\r\nAgricoltura sostenibile e biologica a seconda delle colture."
    ],
    "fr": [
      "Ferme familiale diversifiée avec des cultures de fruits et légumes, miel, olives et huile AOP Nyons, jus de fruits, épeautre...\r\nAgriculture raisonnée et biologique en fonction des cultures."
    ],
    "nl": [
      "Gediversifieerd familiebedrijf met fruit en groenten, honing, BOB Nyons olijven en olie, vruchtensappen, spelt...\r\nGeïntegreerde en biologische landbouw afhankelijk van het gewas."
    ],
    "es": [
      "Explotación familiar diversificada que cultiva frutas y hortalizas, miel, aceitunas y aceite de Nyons DOP, zumos de frutas, espelta...\r\nAgricultura integrada y ecológica según el cultivo."
    ]
  },
