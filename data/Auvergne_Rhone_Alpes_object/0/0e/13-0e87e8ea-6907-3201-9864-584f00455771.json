  "rdfs:comment": {
    "de": [
      "Folgen Sie dem bunten Faden ... und Sie finden handgefärbte Qualitätswolle (Merinowolle, Seide und Babyalpaka), wo \"Ihre Farbwünsche auf Nathalies Stränge abfärben!\""
    ],
    "en": [
      "Follow the colorful thread... and you'll find quality hand-dyed wools (merino wool, silk and baby alpaca) where \"your color cravings rub off on Nathalie's skeins!\""
    ],
    "it": [
      "Seguite il filo colorato... e troverete lane di qualità tinte a mano (lana merino, seta e baby alpaca) dove \"i vostri desideri colorati si riversano sulle matasse di Nathalie!\""
    ],
    "fr": [
      "Suivez le fil coloré... et vous trouverez des laines de qualité teintes à la main (laine mérinos, soie et baby alpaga) où \"vos envies de couleurs déteignent sur les écheveaux de Nathalie !\""
    ],
    "nl": [
      "Volg de kleurrijke draad... en je vindt handgeverfde kwaliteitswol (merinowol, zijde en baby-alpaca) waar \"jouw kleurrijke verlangens afgeven op Nathalie's strengen!\""
    ],
    "es": [
      "Siga el hilo de colores... y encontrará lanas de calidad teñidas a mano (lana merina, seda y baby alpaca) donde \"¡sus deseos de colores se contagian a las madejas de Nathalie!\""
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Balidoud, Nathalie Serpolet"
    ]
  },
