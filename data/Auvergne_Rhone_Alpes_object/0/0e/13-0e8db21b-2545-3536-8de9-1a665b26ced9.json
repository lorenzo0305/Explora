  "rdfs:comment": {
    "de": [
      "Ein Restaurant, in dem alles hausgemacht ist und auf dem Holzfeuer aus frischen Zutaten zubereitet wird, die aus einer lokalen, umweltfreundlichen, bäuerlichen Landwirtschaft stammen!\r\nRESTAURANT - BAR - LEBENSMITTELGESCHÄFT - POSTSTATION - FERIENWOHNUNGEN"
    ],
    "en": [
      "Located in Boffres, typical rural village, our restaurant serves modernised classical french food, made with locally-grown products, and cooked with wood furnace !"
    ],
    "it": [
      "Un ristorante dove tutto è fatto in casa e cucinato sul fuoco a legna con ingredienti freschi provenienti da agricoltura locale ed ecologica!\r\nRISTORANTE - BAR - DROGHERIA - UFFICIO POSTALE - GITES"
    ],
    "fr": [
      "Un restaurant où tout est fait maison et cuisiné au feu de bois à partir d'ingrédients frais, issus d'une agriculture paysanne locale et respectueuse de l'environnement !\r\nRESTAURANT - BAR - EPICERIE - RELAIS POSTE - GITES"
    ],
    "es": [
      "Un restaurante donde todo es casero y cocinado al fuego de leña con ingredientes frescos procedentes de la agricultura local y respetuosa con el medio ambiente\r\nRESTAURANTE - BAR - TIENDA DE COMESTIBLES - OFICINA DE CORREOS - CASAS RURALES"
    ],
    "nl": [
      "Een restaurant waar alles zelf wordt gemaakt en gekookt boven een houtvuur met verse ingrediënten van lokale, milieuvriendelijke landbouw!\r\nRESTAURANT - BAR - KRUIDENIER - POSTKANTOOR - GITES"
    ]
  },
