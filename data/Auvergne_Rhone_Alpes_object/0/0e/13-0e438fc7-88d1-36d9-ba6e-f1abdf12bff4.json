  "rdfs:comment": {
    "de": [
      "Die Garage Gires ist Vertragshändler für die Marke Renault.\r\nMechanische Werkstatt und Karosseriewerkstatt.\r\nVerkauf von Neu- und Gebrauchtwagen.\r\nService für den Fahrzeugschein.\r\nTotal-Station rund um die Uhr.\r\nBestellung von Heizöl."
    ],
    "en": [
      "Garage Gires is a Renault distributor.\r\nMechanical and bodywork workshop.\r\nSales of new and used vehicles.\r\nRegistration service.\r\n24/24 Total station.\r\nFuel oil orders."
    ],
    "it": [
      "Il Garage Gires è un distributore Renault.\r\nOfficina meccanica e di carrozzeria.\r\nVendita di veicoli nuovi e usati.\r\nServizio di immatricolazione.\r\nStazione totale 24/24.\r\nOrdini di gasolio."
    ],
    "fr": [
      "Le Garage Gires est agent distributeur de la marque Renault.\r\nAtelier mécanique et carrosserie.\r\nVentes de véhicules neufs et occasions.\r\nService carte grise.\r\nStation Total en 24/24.\r\nCommande de fioul."
    ],
    "nl": [
      "Garage Gires is een Renault-distributeur.\r\nWerkplaats voor mechaniek en carrosserie.\r\nVerkoop van nieuwe en tweedehandsvoertuigen.\r\nDienst inschrijving voertuigen.\r\n24/24 Total-station.\r\nBestelling van stookolie."
    ],
    "es": [
      "Garage Gires es distribuidor Renault.\r\nTaller mecánico y de carrocería.\r\nVenta de vehículos nuevos y usados.\r\nServicio de matriculación de vehículos.\r\nEstación Total 24/24.\r\nPedidos de gasóleo."
    ]
  },
