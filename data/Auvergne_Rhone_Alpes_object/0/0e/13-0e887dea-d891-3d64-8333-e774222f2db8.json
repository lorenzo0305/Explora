  "rdfs:comment": {
    "de": [
      "Restaurant - Bar - Pizzeria. \nDas Bar-Restaurant-Pizzeria Les 2 Zèbres liegt ideal direkt am Schnee und ist über die Einkaufsstraße von Montalbert erreichbar. Sie können hier im Speisesaal oder auf der Terrasse hausgemachte Speisen aus 100% frischen Produkten genießen."
    ],
    "en": [
      "Restaurant ‒ Bar ‒ Pizzeria.\r\nBar/restaurant/pizzeria \"Les 2 Zèbres\", ideally located at the bottom of the slopes and accessible from the main street in Montalbert, offers homemade cuisine in its indoor dining room or on the terrace."
    ],
    "it": [
      "Ristorante - Bar - Pizzeria\nIl bar-ristorante-pizzeria Les 2 Zèbres, situato in posizione ideale sul fronte della neve e accessibile dalla via dello shopping Montalbert, vi accoglie nella sala da pranzo o sulla terrazza per gustare una cucina casalinga a base di prodotti freschi al 100%."
    ],
    "fr": [
      "Restaurant - Bar - Pizzeria. \nLe bar restaurant pizzéria Les 2 Zèbres, idéalement situé en front de neige et accessible depuis la rue commerçante de Montalbert, vous accueille en salle ou en terrasse pour déguster une cuisine maison 100% produits frais."
    ],
    "es": [
      "Restaurante - Bar - Pizzería\nEl bar-restaurante-pizzería Les 2 Zèbres, idealmente situado en primera línea de nieve y accesible desde la calle comercial Montalbert, le acoge en el comedor o en la terraza para disfrutar de una cocina casera elaborada con productos 100% frescos."
    ],
    "nl": [
      "Restaurant - Bar - Pizzeria. \r\nBar restaurant pizzeria Les 2 Zèbres, ideaal gelegen op het sneeuwplein en bereikbaar vanuit de winkelstraat van Montalbert, heet u welkom in de restaurantzaal of buiten, waar u kunt proeven van een huisgemaakte keuken."
    ]
  },
