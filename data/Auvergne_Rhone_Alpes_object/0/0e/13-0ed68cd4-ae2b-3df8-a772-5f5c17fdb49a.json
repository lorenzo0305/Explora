  "rdfs:comment": {
    "de": [
      "Das Wanderhaus informiert Sie über das gesamte Netz der markierten Wanderwege im Val d'Ay. Mehr als 230 km Wanderwege warten darauf, von Ihnen entdeckt zu werden."
    ],
    "en": [
      "The house of the hike provides information on all the network of signposted trails in Val d'Ay. More than 230 km of trails await you!"
    ],
    "it": [
      "La Maison de la randonnée fornisce informazioni sull'intera rete di sentieri segnalati della Val d'Ay. Oltre 230 km di sentieri da scoprire."
    ],
    "fr": [
      "La maison de la randonnée vous renseigne sur tout le réseau de chemins balisés en Val d'Ay. Plus de 230 km de sentiers à découvrir."
    ],
    "es": [
      "La Maison de la randonnée ofrece información sobre toda la red de senderos señalizados del Val d'Ay. Más de 230 km de senderos por descubrir."
    ],
    "nl": [
      "Het Maison de la randonnée biedt informatie over het hele netwerk van bewegwijzerde wandelpaden in Val d'Ay. Meer dan 230 km paden om te ontdekken."
    ]
  },
