  "rdfs:comment": {
    "de": [
      "Das Opus ist eine elegante Adresse, an der raffinierte Küche auf Kreativität trifft. Schmackhafte Gerichte, hochwertige Produkte und eine gemütliche Atmosphäre sorgen für ein unvergessliches gastronomisches Erlebnis."
    ],
    "en": [
      "L'Opus is an elegant address where refined cuisine meets creativity. Tasty dishes, quality products and a warm atmosphere for an unforgettable gastronomic experience."
    ],
    "it": [
      "L'Opus è un indirizzo elegante dove la cucina raffinata incontra la creatività. Piatti gustosi, prodotti di qualità e un'atmosfera accogliente rendono l'esperienza culinaria indimenticabile."
    ],
    "fr": [
      "L’Opus est une adresse élégante où la cuisine raffinée rencontre la créativité. Des plats savoureux, des produits de qualité et une ambiance chaleureuse pour une expérience gastronomique inoubliable."
    ],
    "nl": [
      "L'Opus is een elegant adres waar verfijnde gerechten en creativiteit samenkomen. Smakelijke gerechten, kwaliteitsproducten en een warme sfeer zorgen voor een onvergetelijke eetervaring."
    ],
    "es": [
      "L'Opus es un lugar elegante donde la cocina refinada se une a la creatividad. Platos sabrosos, productos de calidad y un ambiente cálido para una experiencia gastronómica inolvidable."
    ]
  },
  "rdfs:label": {
    "fr": [
