  "rdfs:comment": {
    "de": [
      "Die Chocolaterie Beussent Lachelle baut ihre eigenen Plantagen in einem nachhaltigen Ansatz an. In der Boutique in Hazebrouck finden Sie eine ganze Kollektion von Ballotins, Schatullen, Häppchen, Tafeln und anderen Leckereien, die bio-zertifiziert sind!"
    ],
    "en": [
      "Chocolaterie Beussent Lachelle cultivates its own plantations as part of a sustainable approach. In the Hazebrouck boutique, you'll find a whole collection of certified organic ballotins, coffrets, bouchées, tablettes and other delicacies!"
    ],
    "it": [
      "La Chocolaterie Beussent Lachelle coltiva le proprie piantagioni nell'ambito di un approccio sostenibile. Nel negozio di Hazebrouck troverete un'intera collezione di ballotin, scatole, cioccolatini da mordere, barrette e altre prelibatezze certificate biologiche!"
    ],
    "fr": [
      "La Chocolaterie Beussent Lachelle cultive ses propres plantations dans une démarche durable. Dans la boutique de Hazebrouck, vous pourrez trouver toute une collection de ballotins, coffrets, bouchées, tablettes et autres gourmandises, certifiées Bio !"
    ],
    "es": [
      "La Chocolatería Beussent Lachelle cultiva sus propias plantaciones en el marco de un enfoque sostenible. En la tienda de Hazebrouck encontrará toda una colección de bombones, cajas, chocolatinas, tabletas y otras delicias con certificado ecológico"
    ],
    "nl": [
      "Chocolaterie Beussent Lachelle kweekt haar eigen plantages in het kader van een duurzame aanpak. In de winkel in Hazebrouck vind je een hele collectie gecertificeerde biologische ballotins, doosjes, hapklare chocolaatjes, repen en andere lekkernijen!"
    ]
  },
