  "rdfs:comment": {
    "de": [
      "Ferienhaus Gemütliches Hotel im Herzen der Berge, am Fuße der Pisten und an der Quelle der Dordogne gelegen. Genießen Sie die herrliche Aussicht auf das Val de Courre.\r\nIn der Nähe der Wanderwege GR30 und GR4 und der Seilbahn von Sancy, Ausgangspunkt für zahlreiche Wanderungen."
    ],
    "en": [
      "Warm gîte hotel in the heart of the mountains, located at the foot of the slopes at the source of the Dordogne, come and enjoy the superb view of the Val de Courre. Close to the GR30 and GR4 and the Sancy cable car, starting point of many hikes."
    ],
    "it": [
      "Gîte Un accogliente hotel nel cuore delle montagne, situato ai piedi delle piste, alle sorgenti della Dordogna, venite a godere della superba vista sulla Val de Courre.\r\nVicino ai sentieri GR30 e GR4 e alla funivia di Sancy, punto di partenza per numerose escursioni."
    ],
    "fr": [
      "Gîte Hôtel chaleureux au cœur des montagnes, situé au pied des pistes, à la source de la Dordogne, venez profiter de la superbe vue sur le Val de Courre. \r\nA proximité des GR30 et GR4 et du téléphérique du Sancy, point de départ de nombreuses randonnées."
    ],
    "nl": [
      "Gîte Een gezellig hotel in het hart van de bergen, gelegen aan de voet van de hellingen, aan de bron van de Dordogne, kom genieten van het prachtige uitzicht over de Val de Courre.\r\nDicht bij de GR30 en GR4 wandelpaden en de Sancy kabelbaan, het startpunt voor vele wandelingen."
    ],
    "es": [
      "Casa rural Un hotel acogedor en el corazón de la montaña, situado al pie de las pistas, en el nacimiento de la Dordoña, venga a disfrutar de la magnífica vista sobre el Val de Courre.\r\nCerca de los senderos GR30 y GR4 y del teleférico de Sancy, punto de partida de numerosas excursiones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gîte Hôtel le Ptit Cham"
    ]
  },
