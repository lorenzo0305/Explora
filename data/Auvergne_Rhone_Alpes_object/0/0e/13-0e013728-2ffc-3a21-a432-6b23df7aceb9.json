  "rdfs:comment": {
    "de": [
      "Jam Session\r\nDie Bühne ist offen für alle, die einen Groove, ein Riff oder eine Improvisation mit anderen teilen wollen.\r\nBring dein Instrument mit und lass die Musik den Rest erledigen!"
    ],
    "en": [
      "Jam Session\r\nThe stage is open to anyone who wants to share a groove, a riff or an improvisation.\r\nBring your instrument? and let the music do the rest!"
    ],
    "it": [
      "Jam Session\r\nIl palco è aperto a chiunque voglia condividere un groove, un riff o un'improvvisazione.\r\nPortate il vostro strumento e lasciate che la musica faccia il resto!"
    ],
    "fr": [
      "Jam Session \r\nLa scène s’ouvre à celles et ceux qui veulent partager un groove, un riff ou une impro.\r\nRamène ton instrument… et laisse la musique faire le reste !"
    ],
    "nl": [
      "Jamsessie\r\nHet podium staat open voor iedereen die een groove, riff of improvisatie wil delen.\r\nBreng je instrument mee en laat de muziek de rest doen!"
    ],
    "es": [
      "Jam Session\r\nEl escenario está abierto a cualquiera que quiera compartir un groove, un riff o una improvisación.\r\nTrae tu instrumento... ¡y deja que la música haga el resto!"
    ]
  },
