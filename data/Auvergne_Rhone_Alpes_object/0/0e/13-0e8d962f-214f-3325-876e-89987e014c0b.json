  "rdfs:comment": {
    "de": [
      "Lust auf Urlaub an der frischen Luft? La Plaine Tonique empfängt Sie im Herzen des Departements Ain! Nutzen Sie seinen Wasserfreizeitpark und die zahlreichen angebotenen Aktivitäten, Sensationen sind garantiert!"
    ],
    "en": [
      "Looking for an outdoor vacation? La Plaine Tonique welcomes you to the heart of the Ain region! Take advantage of its aquatic leisure park and the many activities on offer - thrills guaranteed!"
    ],
    "it": [
      "Siete alla ricerca di una vacanza all'aria aperta? La Plaine Tonique vi accoglie nel cuore dell'Ain! Approfittate del suo parco acquatico e delle numerose attività proposte, sensazioni garantite!"
    ],
    "fr": [
      "Envie de vacances en plein air ? La Plaine Tonique vous accueille au cœur de l'Ain ! Profitez de son parc de loisirs aquatiques et des nombreuses activités proposées, sensations garanties !"
    ],
    "es": [
      "¿Busca unas vacaciones al aire libre? ¡La Plaine Tonique le da la bienvenida al corazón del Ain! Aproveche su parque de ocio acuático y las numerosas actividades que ofrece, ¡sensaciones garantizadas!"
    ],
    "nl": [
      "Zin in een buitenvakantie? La Plaine Tonique heet u welkom in het hart van Ain! Profiteer van het waterpretpark en de vele activiteiten die worden aangeboden, sensatie gegarandeerd!"
    ]
  },
