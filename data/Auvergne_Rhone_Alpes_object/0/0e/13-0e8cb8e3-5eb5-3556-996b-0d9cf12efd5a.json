  "rdfs:comment": {
    "de": [
      "Méribel Alpina ist der Betreiber der Skilifte in Méribel. Er wird von der Gemeinde Les Allues beauftragt, die Pisten und Lifte des Skigebiets zu verwalten."
    ],
    "en": [
      "Meribel ski lift company. \r\n\r\nMéribel Alpina is the Méribel ski lift company. It is commissioned by the commune of Les Allues for the management of the slopes and ski lifts."
    ],
    "it": [
      "Méribel Alpina è il gestore degli impianti di risalita di Méribel. È incaricata dal comune di Les Allues di gestire le piste e gli impianti di risalita della zona."
    ],
    "fr": [
      "Méribel Alpina est l'exploitant des remontées mécaniques de Méribel. Il est missioné par la commune des Allues pour la gestion des pistes et remontées du domaine."
    ],
    "nl": [
      "Méribel Alpina is de exploitant van de skiliften van Méribel. Zij beheert in opdracht van de gemeente Les Allues de pistes en liften in het gebied."
    ],
    "es": [
      "Méribel Alpina es el operador de los remontes de Méribel. El municipio de Les Allues le encarga la gestión de las pistas y los remontes de la zona."
    ]
  },
