  "rdfs:comment": {
    "de": [
      "Die Compagnie du Détour interpretiert Molière neu in einer burlesken Inszenierung, in der fünf Schauspielerinnen \"Les Femmes Savantes\" in der Küche neu erfinden und dabei Humor, Satire und explosive Energie miteinander verbinden."
    ],
    "en": [
      "The Compagnie du Détour revisits Molière in a burlesque production in which five actresses reinvent \"Les Femmes Savantes\" in the kitchen, combining humor, satire and explosive energy."
    ],
    "it": [
      "La Compagnie du Détour rivisita Molière in una produzione burlesca in cui cinque attrici reinventano \"Les Femmes Savantes\" in cucina, combinando umorismo, satira ed energia esplosiva."
    ],
    "fr": [
      "La Compagnie du Détour revisite Molière dans une mise en scène burlesque où cinq comédiennes réinventent \"Les Femmes Savantes\" en cuisine, mêlant humour, satire et énergie explosive."
    ],
    "es": [
      "La Compagnie du Détour revisita a Molière en una producción burlesca en la que cinco actrices reinventan \"Les Femmes Savantes\" en la cocina, combinando humor, sátira y energía explosiva."
    ],
    "nl": [
      "De Compagnie du Détour keert terug naar Molière in een burleske productie waarin vijf actrices \"Les Femmes Savantes\" opnieuw uitvinden in de keuken en humor, satire en explosieve energie combineren."
    ]
  },
  "rdfs:label": {
