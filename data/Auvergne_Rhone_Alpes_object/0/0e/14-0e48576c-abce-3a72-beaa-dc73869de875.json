  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1c57af76-e7ce-3e08-bf73-6cf30af26e4d",
      "dc:description": {
        "de": [
          "Die Singing Brewers kommen, um Ihre Ohren mit dem Klang des French Galibot Blues zu wecken.\nDer French Galibot Blues, ein unwahrscheinlicher Stil, der von dem Duo erfunden wurde, vermischt Einflüsse aus Blues, Trink- und Textliedern, Soul und Rockabilly der beiden Komplizen."
        ],
        "en": [
          "The Singing Brewers are here to wake up your ears to the sound of French Galibot Blues.\nFrench Galibot Blues, an unlikely style invented by the duo, blends the blues, chanson à boire and chanson à texte, soul and rockabilly influences of the two accomplices."
        ],
        "it": [
          "I Singing Brewers sono qui per risvegliare le vostre orecchie al suono del French Galibot Blues.\nIl French Galibot Blues, un improbabile stile inventato dal duo, fonde influenze blues, chanson à boire e chanson à texte, soul e rockabilly dei due complici."
        ],
        "fr": [
          "Les Singing Brewers débarquent pour vous réveiller les oreilles au son du French Galibot Blues.\nLe French Galibot Blues, un style improbable inventé par le duo, mélange des influences de blues, chanson à boire et chanson à texte, soul et rockabilly des deux complices."
        ],
        "nl": [
          "The Singing Brewers zijn hier om je oren wakker te schudden met de sound van French Galibot Blues.\nFrench Galibot Blues, een onwaarschijnlijke stijl uitgevonden door het duo, mengt invloeden uit de blues, chanson à boire en chanson à texte, soul en rockabilly van de twee handlangers."
        ],
        "es": [
          "The Singing Brewers están aquí para despertar tus oídos al son del French Galibot Blues.\nEl French Galibot Blues, un improbable estilo inventado por el dúo, mezcla influencias del blues, la chanson à boire y la chanson à texte, el soul y el rockabilly."
        ]
      },
      "@type": [
        "Description"
