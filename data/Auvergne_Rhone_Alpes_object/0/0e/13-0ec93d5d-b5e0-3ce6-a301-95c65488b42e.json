  "rdfs:comment": {
    "de": [
      "Das Team des K empfängt Sie jeden Tag auf dem Gipfel der Seilbahn in seinem Restaurant. Tischservice, Snack und Self, Küche mit frischen und qualitativ hochwertigen Produkten."
    ],
    "en": [
      "The K's team welcomes you everyday at the top of Télécabine in the restaurant. Snack and self service with fresh and quality produces."
    ],
    "it": [
      "Il team K vi accoglie ogni giorno nel suo ristorante in cima alla Télécabine. Servizio al tavolo, snack bar e self-service, prodotti freschi e di qualità."
    ],
    "fr": [
      "L'équipe du K vous accueille  tous les jours au sommet de la Télécabine dans son restaurant. Service à table, Snack et Self, cuisine de produits frais et de qualité."
    ],
    "nl": [
      "Het team van K heet u elke dag welkom op de top van de kabelbaan in de restaurant. Snack en selfservice, keuken met verse en kwalitatieve producten."
    ],
    "es": [
      "El equipo de K le da la bienvenida cada día a su restaurante en lo alto de la Télécabine. Servicio de mesa, snack bar y autoservicio, productos frescos y de calidad."
    ]
  },
