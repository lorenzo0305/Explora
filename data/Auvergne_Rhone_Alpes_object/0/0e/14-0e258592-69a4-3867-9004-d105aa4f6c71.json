  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/64585176-b597-311b-9846-87c25988b4ff",
      "dc:description": {
        "de": [
          "Montag, 22. bis Freitag, 26. Juli 2024\n\nLego® Praktikum\nFührt Kinder an Technik, Mechanik und Architektur heran.\nFür Kinder ab +5 Jahren.\nVon 10:00 bis 13:00 Uhr."
        ],
        "en": [
          "Monday, July 22 to Friday, July 26, 2024\n\nLego® course\nIntroduce children to engineering, mechanics and architecture.\nFor children over 5.\nFrom 10 a.m. to 1 p.m."
        ],
        "it": [
          "Da lunedì 22 a venerdì 26 luglio 2024\n\nCorso Lego\nIntrodurre i bambini all'ingegneria, alla meccanica e all'architettura.\nPer bambini dai 5 anni in su.\nDalle 10.00 alle 13.00."
        ],
        "fr": [
          "Du lundi 22 au vendredi 26 juillet 2024\n\nStage Lego®\nInitier les enfants à l'ingénierie, la mécanique et l'architecture.\nPour les enfants de + de 5 ans.\nDe 10h à 13h."
        ],
        "nl": [
          "Van maandag 22 tot vrijdag 26 juli 2024\n\nLego® cursus\nLaat kinderen kennismaken met techniek, mechanica en architectuur.\nVoor kinderen vanaf 5 jaar.\nVan 10 tot 13 uur."
        ],
        "es": [
          "Del lunes 22 al viernes 26 de julio de 2024\n\nCurso Lego\nIntroduce a los niños en la ingeniería, la mecánica y la arquitectura.\nA partir de 5 años.\nDe 10 a 13 h."
        ]
      },
