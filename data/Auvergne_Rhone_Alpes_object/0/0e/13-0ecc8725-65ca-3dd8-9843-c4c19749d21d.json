  "rdfs:comment": {
    "de": [
      "Zugang über den Gipfel der Via Ferrata 1b, über die Vire des petits Montagnards 2 und dann über die luftige Überquerung der Vire du Raffour 3. Der Ausstieg erfolgt bei 6b, um auf den Rückweg 12 und dann 13 zu gelangen."
    ],
    "en": [
      "Starting from the top of the Via Ferrata at 1b, take the ledge of « Les Petits Montagnards » 2, then the aerial passage of the Vire du raffour 3. Exit near 6b to join the return path12 then 13."
    ],
    "it": [
      "Accedere dalla cima della Via Ferrata 1b, percorrere la Vire des petits Montagnards 2, quindi effettuare la traversata aerea della Vire du Raffour 3. Uscire al livello 6b per raggiungere il sentiero di ritorno 12 e poi 13."
    ],
    "fr": [
      "Accès par le sommet de la Via Ferrata 1b, on emprunte la Vire des petits Montagnards 2, puis on effectue la traversée aérienne de la Vire du Raffour 3. La sortie s’effectue au niveau de 6b pour rejoindre le sentier du retour 12 puis 13."
    ],
    "nl": [
      "Toegang vanaf de top van Via Ferrata 1b, neem de Vire des petits Montagnards 2, maak dan de luchttraverse van de Vire du Raffour 3. Verlaat het pad op niveau 6b om de terugweg 12 en 13 te nemen."
    ],
    "es": [
      "Acceso desde la cima de la Via Ferrata 1b, tomar la Vire des petits Montagnards 2, luego hacer la travesía aérea de la Vire du Raffour 3. Salir en el nivel 6b para incorporarse a la vía de retorno 12 y luego 13."
    ]
  },
  "rdfs:label": {
    "en": [
      "Via Ferrata du Mont : La traversée du Raffour"
    ],
    "fr": [
      "Via Ferrata du Mont : La traversée du Raffour"
    ]
  },
