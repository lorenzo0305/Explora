  "rdfs:comment": {
    "de": [
      "Die Taverne Alsacienne liegt mitten im Stadtzentrum und bietet Ihnen neben Sauerkraut auch eine ganze Karte mit regionalen und handwerklichen Produkten.\r\nGerichte zum Mitnehmen: nur für das Sauerkraut. Treffpunkt in einem vollständig renovierten, sehr eleganten Dekor."
    ],
    "en": [
      "Located right in the center of town, the Taverne Alsacienne offers not only sauerkraut, but also a whole menu of local and artisanal products.\r\nTakeaway dishes: sauerkraut only. Meet us in a completely renovated, elegant setting."
    ],
    "it": [
      "Situata proprio nel centro della città, la Taverne Alsacienne offre un intero menu di prodotti locali e artigianali, oltre ai suoi crauti.\r\nPiatti da asporto: solo crauti. Venite a trovarci in un ambiente elegante e completamente rinnovato."
    ],
    "fr": [
      "Située en plein centre-ville, la Taverne Alsacienne vous propose, outre ses choucroutes, toute une carte de produits du terroir et artisanaux.\r\nPlats à emporter : uniquement pour la choucroute. Rendez-vous dans un décor entièrement rénové très élégant."
    ],
    "nl": [
      "Taverne Alsacienne ligt in het centrum van de stad en biedt een hele kaart met lokale en ambachtelijke producten, maar ook zuurkool.\r\nAfhaalgerechten: alleen zuurkool. Ontmoet ons in een volledig gerenoveerd, elegant kader."
    ],
    "es": [
      "Situada en pleno centro de la ciudad, la Taverne Alsacienne ofrece toda una carta de productos locales y artesanales, así como su chucrut.\r\nPlatos para llevar: sólo chucrut. Reúnase con nosotros en un marco elegante y completamente renovado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie La Taverne Alsacienne"
    ]
  },
