  "rdfs:comment": {
    "de": [
      "Nana, Sylvain und ihr Team empfangen Sie im Herzen des Ortes mit Spezialitäten aus den Bergen: Crêpes, Ravioles, Pizzas, Gegrilltes, Snacks. Verkauf von Obst der Saison.\r\nIm Restaurant werden Konzertabende veranstaltet."
    ],
    "en": [
      "Nana, Sylvain, and their team welcome you in the heart of the resort, with mountain specialties, crepes, ravioli, pizzas, grilled dishes, and snacks.\r\nConcert nights are held at the restaurant."
    ],
    "it": [
      "Nana, Sylvain e il loro team vi accolgono nel cuore del resort, con specialità di montagna, crêpes, ravioli, pizze, grigliate e snack. Frutta di stagione in vendita.\r\nNel ristorante vengono organizzati concerti serali."
    ],
    "fr": [
      "Nana, Sylvain et leur équipe vous accueillent au cœur de la station,  avec des spécialités de montagne, crêpes, ravioles, pizzas, grillades, snack. Vente de fruits de saison. \r\nDes soirées concerts sont organisées dans le restaurant."
    ],
    "es": [
      "Nana, Sylvain y su equipo le dan la bienvenida al corazón de la estación, con especialidades de montaña, crepes, raviolis, pizzas, parrilladas y tentempiés. Venta de fruta de temporada.\r\nSe organizan conciertos nocturnos en el restaurante."
    ],
    "nl": [
      "Nana, Sylvain en hun team heten je welkom in het hart van het resort, met bergspecialiteiten, crêpes, ravioli, pizza's, grillgerechten en snacks. Verkoop van seizoensfruit.\r\nS Avonds worden er concerten georganiseerd in het restaurant."
    ]
  },
