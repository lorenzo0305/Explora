  "rdfs:comment": {
    "de": [
      "Eine komplett im Freien gelegene Eisbahn mit olympischen Maßen, die es Anfängern und Fortgeschrittenen ermöglicht, in einer einzigartigen Umgebung die Freuden des Schlittschuhlaufens zu genießen."
    ],
    "en": [
      "A fully outdoor ice rink with Olympic dimensions, allowing beginners and experts alike to enjoy the pleasures of ice skating in a unique setting."
    ],
    "it": [
      "Una pista di pattinaggio interamente all'aperto, di dimensioni olimpiche, che permette sia ai principianti che agli esperti di godersi il piacere del ghiaccio in un ambiente unico."
    ],
    "fr": [
      "Une patinoire entièrement en extérieur, aux dimensions olympiques permettant aux débutants comme aux experts de profiter des plaisirs de la glasse dans un cadre unique."
    ],
    "es": [
      "Una pista al aire libre de dimensiones olímpicas, que permite a principiantes y expertos disfrutar de los placeres del patinaje sobre hielo en un entorno único."
    ],
    "nl": [
      "Een buitenbaan met Olympische afmetingen, waar zowel beginners als gevorderden kunnen genieten van het plezier van schaatsen in een unieke omgeving."
    ]
  },
