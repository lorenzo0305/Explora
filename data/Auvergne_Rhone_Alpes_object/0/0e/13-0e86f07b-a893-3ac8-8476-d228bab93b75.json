  "rdfs:comment": {
    "de": [
      "Ab-Hof-Verkauf von Kartoffeln, Karotten, Kürbis und Butternut. Alles biologisch und lokal, angebaut auf den Ländereien von Boisset-lès-Montrond und Sainte-Foy-Saint-Sulpice."
    ],
    "en": [
      "Farm sales of potatoes, carrots, pumpkin and butternut. All organic and local, grown on land in Boisset-lès-Montrond and Sainte-Foy-Saint-Sulpice."
    ],
    "it": [
      "Vendita in azienda di patate, carote, zucca e noce di burro. Tutti prodotti biologici e locali, coltivati nei terreni di Boisset-lès-Montrond e Sainte-Foy-Saint-Sulpice."
    ],
    "fr": [
      "Vente à la ferme de pommes de terre, carottes, potimarron et butternut. Tout en bio et local, cultivé sur les terres de Boisset-lès-Montrond et Sainte-Foy-Saint-Sulpice."
    ],
    "nl": [
      "Verkoop op de boerderij van aardappelen, wortelen, pompoen en butternut. Allemaal biologisch en lokaal, geteeld op land in Boisset-lès-Montrond en Sainte-Foy-Saint-Sulpice."
    ],
    "es": [
      "Venta en la explotación de patatas, zanahorias, calabaza y calabaza butternut. Todo ecológico y local, cultivado en tierras de Boisset-lès-Montrond y Sainte-Foy-Saint-Sulpice."
    ]
  },
