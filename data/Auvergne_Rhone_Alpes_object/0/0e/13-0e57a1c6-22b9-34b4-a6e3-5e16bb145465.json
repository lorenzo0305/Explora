  "rdfs:comment": {
    "de": [
      "Musik aus Versehen, ohne Worte oder Instrumente! In Partnerschaft mit den Jeunesses Musicales de France, im Rahmen von Nyons en scène.\r\nBurleskes Musiktheater\r\nFür alle Altersgruppen ab 6 Jahren / Dauer: 50 Minuten / Um 10:30 und 14:30 Uhr"
    ],
    "en": [
      "Music by accident, without words or instruments! In partnership with Jeunesses Musicales de France, as part of Nyons en scène.\r\nBurlesque musical theater\r\nFor all ages 6 and up / Running time: 50 minutes / At 10:30 and 14:30"
    ],
    "it": [
      "Musica per caso, senza parole né strumenti! In collaborazione con Jeunesses Musicales de France, nell'ambito di Nyons en scène.\r\nTeatro musicale burlesco\r\nAdatto a tutte le età dai 6 anni in su / Durata: 50 minuti / Alle 10.30 e alle 14.30"
    ],
    "fr": [
      "Musique par accident, sans mot ni instrument ! En partenariat avec les Jeunesses Musicales de France, dans le cadre de Nyons en scène.\r\nThéâtre musical burlesque    \r\nTout public, à partir de 6 ans / Durée : 50 minutes / À 10h30 et 14h30"
    ],
    "nl": [
      "Muziek bij toeval, zonder woorden of instrumenten! In samenwerking met Jeunesses Musicales de France, in het kader van Nyons en scène.\r\nBurlesk muziektheater\r\nGeschikt voor alle leeftijden vanaf 6 jaar / Duur: 50 minuten / Om 10.30 uur en 14.30 uur"
    ],
    "es": [
      "Música por accidente, ¡sin palabras ni instrumentos! En colaboración con Jeunesses Musicales de France, en el marco de Nyons en scène.\r\nTeatro musical burlesco\r\nApto para todos los públicos a partir de 6 años / Duración: 50 minutos / A las 10.30 y a las 14.30 horas"
    ]
  },
