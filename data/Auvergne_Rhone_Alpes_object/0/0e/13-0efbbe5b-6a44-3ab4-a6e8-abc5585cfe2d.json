  "rdfs:comment": {
    "de": [
      "Dinnershow - Bar mit Musik\r\nWir begrüßen Sie an diesem außergewöhnlichen Ort mit drei verschiedenen Atmosphären. Entdecken Sie unsere verschiedenen Angebote, die es jedem ermöglichen, einen schönen Abend zu verbringen."
    ],
    "en": [
      "show - Music bar\r\n8 p.m. Bar Cocktail dinner,\r\n9:30 p.m. Show,\r\n10:30 p.m. Music Bar Club"
    ],
    "it": [
      "Cena e spettacolo - Bar musicale\r\nVi diamo il benvenuto in questo locale eccezionale con le sue 3 atmosfere. Venite a scoprire le nostre diverse formule per far sì che tutti possano godere di una splendida serata. È possibile prenotare una funzione privata per seminari, compleanni, matrimoni, ....."
    ],
    "fr": [
      "Diner spectacle - Bar musical\r\nNous vous accueillons dans ce lieu d'exception aux 3 ambiances. Venez découvrir nos différentes formules permettant à chacun de passer une belle soirée. Vous pouvez privatiser pour des séminaires, anniversaire, mariage, ...."
    ],
    "nl": [
      "Diner en show - Muzikale bar\r\nWij heten u van harte welkom in deze uitzonderlijke locatie met 3 sferen. Kom en ontdek onze verschillende formules zodat iedereen kan genieten van een heerlijke avond. U kunt een privéfeest boeken voor seminars, verjaardagen, bruiloften, ...."
    ],
    "es": [
      "Cena y espectáculo - Bar musical\r\nLe damos la bienvenida a este lugar excepcional con sus 3 ambientes. Venga a descubrir nuestras diferentes fórmulas para que todos puedan disfrutar de una velada maravillosa. Puede reservar una función privada para seminarios, cumpleaños, bodas, ...."
    ]
  },
