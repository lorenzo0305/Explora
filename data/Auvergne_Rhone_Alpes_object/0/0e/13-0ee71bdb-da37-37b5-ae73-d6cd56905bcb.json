  "rdfs:comment": {
    "de": [
      "Traditionelles Fest des Heiligen Férréol, das vom Club des 2 Marais organisiert wird. Wanderung am Vormittag vor dem Essen, das im Four banal auf dem Place du Foirail zubereitet wird."
    ],
    "en": [
      "Traditional Fête de la Saint-Férréol organized by the Club des 2 Marais. Hiking in the morning before a meal cooked in the communal oven on the Place du Foirail."
    ],
    "it": [
      "Festa tradizionale di Saint-Férréol organizzata dal Club dei 2 Marais. Una passeggiata al mattino prima del pasto cucinato nel forno comune sulla Place du Foirail."
    ],
    "fr": [
      "Traditionnelle Fête de la Saint-Férréol organisée par le Club des 2 Marais. Randonnée pédestre le matin avant le repas cuit au four banal sur la place du Foirail."
    ],
    "nl": [
      "Traditioneel feest van Saint-Férréol georganiseerd door de Club des 2 Marais. Een wandeling in de ochtend voor de maaltijd bereid in de gemeenschappelijke oven op de Place du Foirail."
    ],
    "es": [
      "Fiesta tradicional de Saint-Férréol organizada por el Club des 2 Marais. Un paseo por la mañana antes de la comida cocinada en el horno comunal de la Place du Foirail."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la Saint-Ferréol"
    ]
  },
