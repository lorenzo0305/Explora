  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten und auf dem GR 400 gelegen.\r\nTraditionelle Auberge aus Stein, rustikaler Rahmen mit Kamin und großer Terrasse. Traditionelle Küche und Spezialitäten der Auvergne: Trüffel, gefüllter Kohl, Pounti..."
    ],
    "en": [
      "Located at the foot of the pistes and on the GR 400.\r\nTraditional stone inn, rustic setting with fireplace and large terrace. Traditional cuisine and Auvergne specialities: truffade, chou farçi, pounti..."
    ],
    "it": [
      "Situato ai piedi delle piste da sci e sul GR 400.\r\nLocanda tradizionale in pietra, ambiente rustico con camino e ampia terrazza. Cucina tradizionale e specialità dell'Alvernia: truffade, chou farçi, pounti..."
    ],
    "fr": [
      "Situé au pied des pistes et sur le GR 400.\r\nAuberge traditionnelle en pierre, cadre rustique avec cheminée et grande terrasse. Cuisine traditionnelle et spécialités auvergnates : truffade, chou farçi, pounti..."
    ],
    "es": [
      "Situado al pie de las pistas y en el GR 400.\r\nPosada tradicional de piedra, ambiente rústico con chimenea y gran terraza. Cocina tradicional y especialidades de Auvernia: truffade, chou farçi, pounti..."
    ],
    "nl": [
      "Gelegen aan de voet van de pistes en aan de GR 400.\r\nTraditionele stenen herberg, rustieke omgeving met open haard en groot terras. Traditionele keuken en specialiteiten uit de Auvergne: truffade, chou farçi, pounti..."
    ]
  },
