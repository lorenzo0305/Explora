  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/33aa1ab1-2130-3fd0-a13e-6f0e4f385dee",
      "dc:description": {
        "de": [
          "Verkauf von Bauernhofprodukten, die hauptsächlich von Bauern aus der Umgebung stammen: Schweinefleisch, Rindfleisch, Kalbfleisch, Lammfleisch, Geflügel, Obst vom Bauernhof (Äpfel, Birnen, Walnüsse, Erdbeeren), Saisongemüse, Milchprodukte vom Bauernhof, regionale Produkte (Marmeladen, Waffeln, Apfelsaft, Konserven), Herstellung von gefüllten Körben auf Anfrage."
        ],
        "en": [
          "Sale of farm produce, mainly from local farmers: pork, beef, veal, lamb, poultry, farm fruit (apples, pears, walnuts, strawberries), seasonal vegetables, farm dairy products, regional products (jams, waffles, apple juice, preserves), packed baskets on request."
        ],
        "it": [
          "Vendita di prodotti di fattoria, principalmente di agricoltori locali: carne di maiale, manzo, vitello, agnello, pollame, frutta di fattoria (mele, pere, noci, fragole), verdure di stagione, prodotti caseari di fattoria, prodotti regionali (marmellate, cialde, succo di mela, conserve), cesti confezionati su ordinazione."
        ],
        "fr": [
          "Vente de produits fermiers provenant principalement d'agriculteurs des environs : porc, viande bovine, veau, agneau, volailles, fruits de la ferme (pommes, poires, noix, fraises) légumes de saison, produits laitiers fermiers, produits régionaux (confitures, gaufres, jus de pomme, conserves), confections de paniers garnis à la demande."
        ],
        "nl": [
          "Verkoop van boerderijproducten, voornamelijk van lokale boeren: varkensvlees, rundvlees, kalfsvlees, lamsvlees, gevogelte, fruit van de boerderij (appels, peren, walnoten, aardbeien), seizoensgroenten, zuivelproducten van de boerderij, regionale producten (jam, wafels, appelsap, conserven), verpakte manden op bestelling."
        ],
        "es": [
          "Venta de productos de granja, principalmente de agricultores locales: cerdo, ternera, cordero, aves de corral, fruta de granja (manzanas, peras, nueces, fresas), verduras de temporada, productos lácteos de granja, productos regionales (mermeladas, gofres, zumo de manzana, conservas), cestas envasadas por encargo."
        ]
      },
