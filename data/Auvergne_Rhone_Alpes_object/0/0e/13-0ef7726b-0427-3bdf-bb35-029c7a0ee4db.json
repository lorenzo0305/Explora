  "rdfs:comment": {
    "de": [
      "Ein 15 km langes Abenteuer durch die wilden Landschaften des Velay, auf einer Bergbahnstrecke: Viadukte, Tunnel und lange Abfahrten: Nervenkitzel für alle garantiert! Vélorail mit elektrischer Unterstützung. Reservierung über die Website dringend empfohlen."
    ],
    "en": [
      "A 15 km adventure through the wild Velay countryside, on a mountain railroad: viaducts, tunnels and long descents: thrills guaranteed for all! Electrically-assisted velorail. Reservations strongly recommended via the website."
    ],
    "it": [
      "Un'avventura di 15 km attraverso i paesaggi selvaggi del Velay, su una ferrovia di montagna: viadotti, gallerie e lunghe discese: emozioni garantite per tutti! Velocita' a trazione elettrica. Prenotazione fortemente consigliata tramite il sito web."
    ],
    "fr": [
      "Aventure de 15 km à travers des paysages sauvages du Velay, sur une voie ferrée de montagne: viaducs, tunnels et de longues descentes: frissons garantis pour tous ! Vélorail à assistance électrique. Réservation fortement recommandée via le site internet."
    ],
    "es": [
      "Una aventura de 15 km por los paisajes salvajes del Velay, en un ferrocarril de montaña: viaductos, túneles y largos descensos: ¡emociones garantizadas para todos! Velocarriles eléctricos. Se recomienda encarecidamente reservar a través del sitio web."
    ],
    "nl": [
      "Een avontuur van 15 km door de wilde landschappen van de Velay, op een bergspoor: viaducten, tunnels en lange afdalingen: sensatie gegarandeerd voor iedereen! Elektrische velorail. Reserveren sterk aanbevolen via de website."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vélorail du Velay"
    ]
  },
