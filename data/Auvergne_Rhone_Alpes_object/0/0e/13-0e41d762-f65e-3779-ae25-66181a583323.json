  "rdfs:comment": {
    "de": [
      "François Quérini ist Yogalehrer, Bergführer und Nordic-Ski-Lehrer/Trainer. Er lebt seit etwa 30 Jahren im Vercors, wo er Ihnen anbietet, Sie bei Ihren Aktivitäten zu begleiten."
    ],
    "en": [
      "Yoga teacher, mountain guide, Nordic ski instructor/trainer, François Quérini has been living in the Vercors for about thirty years where he supports you in your activities."
    ],
    "it": [
      "Insegnante di yoga, guida alpina, istruttore/allenatore di sci nordico, allenatore di salute e sport, François vive da circa trent'anni nel Vercors, dove si offre di accompagnarvi nelle vostre attività di escursionismo, sci nordico e yoga"
    ],
    "fr": [
      "Professeur de Yoga, accompagnateur en montagne, moniteur/entraîneur de ski nordique, coach sport santé, François vit dans le Vercors depuis une trentaine d’années où il propose de vous accompagner dans vos activités : rando, ski nordique et yoga"
    ],
    "nl": [
      "Yogaleraar, bergleider, nordic skileraar/trainer, gezondheids- en sportcoach, François woont al zo'n dertig jaar in de Vercors, waar hij aanbiedt om u te begeleiden bij uw wandel-, nordic ski- en yoga-activiteiten"
    ],
    "es": [
      "Profesor de yoga, monitor de montaña, monitor/entrenador de esquí nórdico, coach deportivo y de salud, François vive en el Vercors desde hace unos treinta años, donde se ofrece para acompañarle en sus actividades de senderismo, esquí nórdico y yoga"
    ]
  },
  "rdfs:label": {
    "de": [
      "Querini François - Sport, Natur und Yoga"
    ],
    "en": [
      "Querini François - Sport, Nature and Yoga"
    ],
    "fr": [
      "Querini François - Sport, Nature et Yoga"
    ]
  },
