  "rdfs:comment": {
    "de": [
      "LE MONT LOCAL ist ein Concept Store für Kunst und Kunsthandwerk, in dem jedes Stück das Können und die Leidenschaft unserer lokalen Designer aus Saint-Gervais Mont-Blanc und Umgebung widerspiegelt."
    ],
    "en": [
      "LE MONT LOCAL is an arts and crafts concept shop, where each piece reflects the know-how and passion of our local designers from Saint-Gervais Mont-Blanc and the surrounding area."
    ],
    "it": [
      "LE MONT LOCAL è un negozio di artigianato artistico, dove ogni pezzo riflette il know-how e la passione dei nostri designer locali di Saint-Gervais Mont-Blanc e dintorni."
    ],
    "fr": [
      "LE MONT LOCAL est une boutique concept store d'art et d'artisanat, où chaque pièce reflète le savoir faire et la passion de nos créateurs locaux de Saint-Gervais Mont-Blanc et ses alentours."
    ],
    "nl": [
      "LE MONT LOCAL is een artisanale conceptwinkel, waar elk stuk de knowhow en passie van onze lokale ontwerpers uit Saint-Gervais Mont-Blanc en omgeving weerspiegelt."
    ],
    "es": [
      "LE MONT LOCAL es un concepto de tienda de artesanía, donde cada pieza refleja el saber hacer y la pasión de nuestros diseñadores locales de Saint-Gervais Mont-Blanc y alrededores."
    ]
  },
