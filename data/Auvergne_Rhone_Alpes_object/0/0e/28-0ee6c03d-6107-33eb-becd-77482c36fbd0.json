  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dbe927fa-002c-338a-b1fe-a72d93ccc02d",
      "dc:description": {
        "de": [
          "Olivier und Pascale haben eine kleine Herde von \"clun forest\"-Schafen, die im Freien aufgezogen werden, und vermarkten zwischen November und Februar Pakete mit 1/2 Bio-Lamm."
        ],
        "en": [
          "Olivier and Pascale have a small flock of free-range \"clun forest\" ewes, and sell parcels of 1/2 organic lamb between November and February."
        ],
        "it": [
          "Olivier e Pascale hanno un piccolo gregge di pecore \"clun forest\" allevate all'aperto e vendono pacchi di 1/2 agnello biologico tra novembre e febbraio."
        ],
        "fr": [
          "Olivier et Pascale ont un petit troupeau de brebis \"clun forest\" élévé en plein air et commercialisent des colis de 1/2 agneau bio entre novembre et février."
        ],
        "es": [
          "Olivier y Pascale tienen un pequeño rebaño de ovejas camperas \"clun forest\" y venden lotes de 1/2 cordero ecológico entre noviembre y febrero."
        ],
        "nl": [
          "Olivier en Pascale hebben een kleine kudde ooien met vrije uitloop uit het 'clun forest' en verkopen tussen november en februari percelen van 1/2 biologisch lam."
        ]
      },
