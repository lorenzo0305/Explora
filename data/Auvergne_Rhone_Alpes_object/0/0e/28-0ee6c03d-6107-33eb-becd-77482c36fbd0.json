  "rdfs:comment": {
    "de": [
      "Die Fleischpakete sind vakuumverpackt und zum Einfrieren und Kochen geeignet! Die Pakete sind um die 7 kg schwer und können auf dem Bauernhof abgeholt werden."
    ],
    "en": [
      "Meat packages are vacuum-packed and ready to freeze and cook! Packages are around 7 kg, to be picked up at the farm."
    ],
    "it": [
      "I pacchi di carne sono confezionati sottovuoto e pronti per essere congelati e cucinati! I pacchi pesano circa 7 kg e possono essere ritirati presso la fattoria."
    ],
    "fr": [
      "Les colis de viande sont mis sous vide et près à congeler et à cuisiner ! les colis sont autour de 7 kg. à venir chercher à la ferme."
    ],
    "es": [
      "Los paquetes de carne están envasados al vacío y listos para congelar y cocinar. Los paquetes pesan unos 7 kg y pueden recogerse en la granja."
    ],
    "nl": [
      "De vleespakketten zijn vacuüm verpakt en klaar om in te vriezen en te koken! De pakketten wegen ongeveer 7 kg en kunnen worden opgehaald op de boerderij."
    ]
  },
  "rdfs:label": {
