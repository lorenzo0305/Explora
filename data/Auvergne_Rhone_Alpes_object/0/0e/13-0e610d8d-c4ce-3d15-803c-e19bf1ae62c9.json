  "rdfs:comment": {
    "de": [
      "Ideal gelegen für Ihren Geschäfts- oder Freizeitaufenthalt, in der Nähe von Genf, seinem Flughafen und seinem Messegelände sowie den Skigebieten, und das alles in einer grünen Umgebung. Willkommen im Hotel Mercure Annemasse Porte de Genève."
    ],
    "en": [
      "Ideally located for your business or leisure stays, close to Geneva, its airport and exhibition center, as well as ski resorts, all in a green setting, welcome to the Mercure Annemasse Porte de Genève hotel."
    ],
    "it": [
      "In posizione ideale per i vostri soggiorni d'affari o di piacere, vicino a Ginevra, al suo aeroporto, al centro espositivo e alle stazioni sciistiche, il tutto in un ambiente verde, benvenuti all'hotel Mercure Annemasse Porte de Genève."
    ],
    "fr": [
      "Idéalement situé pour vos séjours d'affaire ou de loisir, à proximité de Genève, de son aéroport et de son Parc des Expositions ainsi que des stations de ski, le tout dans un cadre de verdure, bienvenue à l'hôtel Mercure Annemasse Porte de Genève."
    ],
    "es": [
      "Idealmente situado para sus estancias de negocios o de ocio, cerca de Ginebra, su aeropuerto y su centro de exposiciones, así como de las estaciones de esquí, todo ello en un entorno verde, bienvenido al hotel Mercure Annemasse Porte de Genève."
    ],
    "nl": [
      "Het Mercure-hotel Annemasse Porte de Genève is ideaal gelegen voor uw zaken- of vakantieverblijf, dicht bij Genève, de luchthaven, het expositiecentrum en de skigebieden, allemaal in een groene omgeving."
    ]
  },
