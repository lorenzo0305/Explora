  "rdfs:comment": {
    "de": [
      "Nachdem wir die Polykultur in Allex übernommen haben, beschäftigen wir uns seit den 80er Jahren mit dem Anbau von Melonen. Wir möchten die direkten Beziehungen zu den Verbrauchern bevorzugen und so weit wie möglich ausbauen."
    ],
    "en": [
      "Having taken over mixed farming in Allex, we've been growing melons since the 1980s. Our aim is to develop direct links with the consumer as much as possible."
    ],
    "it": [
      "Avendo rilevato l'agricoltura mista ad Allex, coltiviamo meloni dagli anni Ottanta. Vogliamo favorire e sviluppare il più possibile i legami diretti con il consumatore."
    ],
    "fr": [
      "Ayant repris la polyculture sur Allex, nous nous sommes lancé dans la culture du melon depuis les années 80. Nous souhaitons privilégier et développer au maximum les liens directs avec le consommateur."
    ],
    "nl": [
      "We hebben de gemengde landbouw in Allex overgenomen en telen al meloenen sinds de jaren 1980. Ons doel is om zoveel mogelijk directe contacten met de consument te bevorderen en te ontwikkelen."
    ],
    "es": [
      "Tras asumir la agricultura mixta en Allex, cultivamos melones desde los años 80. Queremos favorecer y desarrollar al máximo los vínculos directos con el consumidor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "EARL Grégoire et Fils"
    ]
  },
