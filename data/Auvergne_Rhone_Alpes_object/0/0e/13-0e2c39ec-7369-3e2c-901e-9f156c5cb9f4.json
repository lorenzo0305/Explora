  "rdfs:comment": {
    "de": [
      "30 Parkplätze stehen auf dem Place du Dr Bourdongle (oder Place des Arcades) im Zentrum von Nyons zur Verfügung.\nDas Parken ist kostenlos, aber die Parkdauer ist auf 1 Stunde begrenzt. Ziehen Sie am Parkscheinautomaten ein Ticket."
    ],
    "en": [
      "30 parking spaces are available on the Place du Dr Bourdongle (or Place des Arcades) in the center of Nyons.\nFree parking, but limited to 1 hour. Take a ticket at the pay and display machine."
    ],
    "it": [
      "30 posti auto sono disponibili in Place du Dr Bourdongle (o Place des Arcades) nel centro di Nyons\nParcheggio gratuito ma limitato a 1 ora. Prendete una multa al parchimetro."
    ],
    "fr": [
      "30 places de parking sont disponibles sur la Place du Dr Bourdongle (ou Place des Arcades) en plein centre de Nyons. \nParking gratuit mais durée limitée à 1h de stationnement. Prendre un ticket à l'horodateur."
    ],
    "es": [
      "hay 30 plazas de aparcamiento disponibles en la Place du Dr Bourdongle (o Place des Arcades) en el centro de Nyons\nAparcamiento gratuito pero limitado a 1 hora. Toma un billete en el parquímetro."
    ],
    "nl": [
      "Er zijn 30 parkeerplaatsen beschikbaar op de Place du Dr Bourdongle (of Place des Arcades) in het centrum van Nyons.\nGratis parkeren, maar beperkt tot 1 uur. Neem een kaartje bij de betaalautomaat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parking de la Place du Dr Bourdongle"
    ]
  },
