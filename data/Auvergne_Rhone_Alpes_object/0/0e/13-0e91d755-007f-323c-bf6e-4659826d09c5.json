  "rdfs:comment": {
    "de": [
      "Handwerksbetrieb mit RGE-Qualifikation\r\nNeubau oder Renovierung von Holzarbeiten.\r\n Häuser mit Holzrahmen, Dachstühle für Gebäude und Wohnungen.\r\n Innenschreinereiarbeiten, Isolierung von Dachböden\r\nAnfertigung von Holzmöbeln nach Maß.\r\nMagazin für Bedarfsartikel"
    ],
    "en": [
      "RGE-qualified craft company\r\nNew or renovated wooden structures.\r\n Timber-framed houses, Carpentry for buildings and homes.\r\n Interior joinery, Attic insulation\r\nCustom-made wooden furniture.\r\nSupplies shop"
    ],
    "it": [
      "Impresa artigiana qualificata RGE\r\nNuove costruzioni o ristrutturazioni di strutture in legno.\r\n Case con struttura in legno, carpenteria edile e residenziale.\r\n Falegnameria interna, Isolamento del sottotetto\r\nMobili in legno su misura.\r\nNegozio di forniture"
    ],
    "fr": [
      "Entreprise artisanale  qualifié RGE\r\nNeuf ou  rénovation d'ouvrages en bois.\r\n Maisons à ossature bois, Charpente bâtiment et habitation.\r\n Menuiseries intérieures, Isolation des combles\r\nRéalisation de mobilier en bois sur mesure.\r\nMagazin de fournitures"
    ],
    "nl": [
      "RGE-gekwalificeerd ambachtelijk bedrijf\r\nNieuwbouw of renovatie van houten constructies.\r\n Huizen met houtskeletbouw, Bouwen en woningtimmerwerk.\r\n Binnenschrijnwerk, Zolderisolatie\r\nHouten meubelen op maat.\r\nWinkel"
    ],
    "es": [
      "Empresa artesanal cualificada RGE\r\nObra nueva o renovación de estructuras de madera.\r\n Casas con entramado de madera, Construcción y carpintería residencial.\r\n Carpintería interior, Aislamiento de áticos\r\nMuebles de madera a medida.\r\nTienda de suministros"
    ]
  },
