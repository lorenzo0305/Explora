  "rdfs:comment": {
    "de": [
      "Die Sitzungen der Trail-Schule haben das Ziel, den Trail für alle zugänglich zu machen, indem sie auf Technik und Kräftigung basieren."
    ],
    "en": [
      "Trail school sessions aim to make trail running accessible to all, with a focus on technique and strengthening."
    ],
    "it": [
      "L'obiettivo delle sessioni di trail school è quello di rendere il trail running accessibile a tutti, concentrandosi sulla tecnica e sul potenziamento."
    ],
    "fr": [
      "Les séances de l'école de trail ont pour objectif de rendre le Trail accessible à tous en étant basé sur la technique et le renforcement."
    ],
    "nl": [
      "Het doel van de trailschool sessies is om trailrunning toegankelijk te maken voor iedereen, door de nadruk te leggen op techniek en versterking."
    ],
    "es": [
      "El objetivo de las sesiones de la escuela de trail es poner el trail running al alcance de todos, centrándose en la técnica y el fortalecimiento."
    ]
  },
