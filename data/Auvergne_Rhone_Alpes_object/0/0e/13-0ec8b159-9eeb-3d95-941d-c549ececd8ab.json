  "rdfs:comment": {
    "de": [
      "In der Gemeinde Saint-Nectaire können Sie die Herstellung des Käses saint-nectaire fermier AOP kennenlernen. Alle unsere Besuche sind geführte, kommentierte Besichtigungen mit Verkostung von Saint-Nectaire (ca. 1 Stunde)"
    ],
    "en": [
      "In the commune of Saint-Nectaire, come and discover the production of Saint-Nectaire AOP farmhouse cheese. All our visits are guided, with commentary and tasting of saint-nectaire cheese (≈1h)"
    ],
    "it": [
      "Nel comune di Saint-Nectaire, venite a scoprire la produzione del formaggio Saint-Nectaire DOP. Tutte le nostre visite sono guidate, con commento e degustazione del formaggio Saint-Nectaire (circa 1 ora)"
    ],
    "fr": [
      "Sur la commune de Saint-Nectaire, venez découvrir la fabrication du fromage saint-nectaire fermier AOP. Toutes nos visites sont guidées, commentées avec dégustation de saint-nectaire (environ 1h)"
    ],
    "nl": [
      "Kom in de gemeente Saint-Nectaire de productie van de boerenkaas Saint-Nectaire BOB ontdekken. Al onze bezoeken worden begeleid, met commentaar en het proeven van Saint-Nectaire kaas (ongeveer 1 uur)"
    ],
    "es": [
      "En el municipio de Saint-Nectaire, venga a descubrir la producción de queso de granja de la DOP Saint-Nectaire. Todas nuestras visitas son guiadas, con comentarios y degustación de queso Saint-Nectaire (aproximadamente 1 hora)"
    ]
  },
