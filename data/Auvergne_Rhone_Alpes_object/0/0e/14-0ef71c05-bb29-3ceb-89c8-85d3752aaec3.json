      "dc:description": {
        "de": [
          "von 14.30 bis 18.30 Uhr\n-------------------------------\n\nModeriert von Steeve Deparis\nEintritt 5?\nVerkauf von Kuchen und Getränken\n\nOrganisiert von der Association Vivre son âge.\nReservierungen erwünscht"
        ],
        "en": [
          "from 2:30 pm to 6:30 pm\n-------------------------------\n\nHosted by Steeve Deparis\nAdmission 5?\nPies and drinks for sale\n\nOrganized by the Vivre son âge association.\nReservations required"
        ],
        "it": [
          "dalle 14.30 alle 18.30\n-------------------------------\n\nOspitato da Steeve Deparis\nIngresso 5?\nVendita di torte e bevande\n\nOrganizzato dall'associazione Vivre son âge.\nPrenotazione obbligatoria"
        ],
        "fr": [
          "de 14h30 à 18h30\n-------------------------------\n\nAnimé par Steeve Deparis\nEntrée 5€\nVente de tartes et boissons\n\nOrganisé par l'association Vivre son âge.\nRéservations souhaitées"
        ],
        "nl": [
          "van 14.30 tot 18.30 uur\n-------------------------------\n\nGegast door Steeve Deparis\nToegang 5?\nTaarten en drankjes te koop\n\nGeorganiseerd door de vereniging Vivre son âge.\nReserveren verplicht"
        ],
        "es": [
          "de 14.30 a 18.30 horas\n-------------------------------\n\nOrganizado por Steeve Deparis\nEntrada 5?\nVenta de tartas y bebidas\n\nOrganizado por la asociación Vivre son âge.\nReserva obligatoria"
        ]
      },
