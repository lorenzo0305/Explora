  "rdfs:comment": {
    "de": [
      "Bietet hauptsächlich drei Arten von Aktivitäten an: Kurse zur Selbsterkenntnis (geleitet von Dominique Giré), Wege und Seminare zur philosophischen Öffnung (geleitet von Alain Giré) und Schreibwerkstätten (geleitet von Lorette Nobécourt)."
    ],
    "en": [
      "We offer three main types of activity: self-awareness courses (led by Dominique Giré), philosophical openness courses and seminars (led by Alain Giré) and writing workshops (led by Lorette Nobécourt)."
    ],
    "it": [
      "Offre tre tipi principali di attività: corsi di autoconoscenza (guidati da Dominique Giré), corsi e seminari filosofici (guidati da Alain Giré) e laboratori di scrittura (guidati da Lorette Nobécourt)."
    ],
    "fr": [
      "Propose principalement trois types d’activités : des stages de connaissance de soi (animés par Dominique Giré), des parcours et séminaires d’ouverture philosophique (animés par Alain Giré) et des ateliers d’écritures (animés par Lorette Nobécourt)."
    ],
    "es": [
      "Ofrece tres tipos de actividades principales: cursos de autoconocimiento (dirigidos por Dominique Giré), cursos y seminarios filosóficos (dirigidos por Alain Giré) y talleres de escritura (dirigidos por Lorette Nobécourt)."
    ],
    "nl": [
      "Het biedt drie soorten activiteiten: cursussen zelfbewustzijn (onder leiding van Dominique Giré), filosofische cursussen en seminars (onder leiding van Alain Giré) en schrijfworkshops (onder leiding van Lorette Nobécourt)."
    ]
  },
