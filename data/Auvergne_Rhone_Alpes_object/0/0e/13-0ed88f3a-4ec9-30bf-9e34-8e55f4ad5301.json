  "rdfs:comment": {
    "de": [
      "La P'tite Cantine ist eine Bar/ein Café, die/das von Vereinen betrieben wird, um soziale und kulturelle Beziehungen zu fördern. Hier finden Veranstaltungen aller Art statt: literarische Aperitifs, Bier- oder Weinproben, Filmvorführungen und viele andere Überraschungen!"
    ],
    "en": [
      "La P'tite Cantine is a bar/café that promotes social and cultural interaction. Events of all kinds take place here: literary aperitifs, beer and wine tastings, film screenings, and many other surprises!"
    ],
    "it": [
      "La P'tite Cantine è un bar/caffetteria che promuove i legami sociali e culturali. Ospitiamo una vasta gamma di eventi, tra cui spettacoli, proiezioni di film, serate di gioco e tante altre sorprese, e abbiamo sempre un punto di ristoro!"
    ],
    "fr": [
      "La P'tite Cantine est un bar/café associatif permettant de favoriser le lien social et culturel. Des évènements en tout genre y ont lieu : spectacles, projections de films, soirée jeux, et bien d'autres surprises, avec toujours notre buvette !"
    ],
    "nl": [
      "La P'tite Cantine is een bar/café dat sociale en culturele banden bevordert. Er worden allerlei evenementen georganiseerd, zoals literaire aperitieven, bier- en wijnproeverijen, filmvertoningen en nog veel meer verrassingen!"
    ],
    "es": [
      "La P'tite Cantine es un bar-cafetería que fomenta los vínculos sociales y culturales. Organizamos una amplia gama de eventos, como espectáculos, proyecciones de películas, tardes de juegos y muchas otras sorpresas, ¡y siempre tenemos un bar de refrescos!"
    ]
  },
  "rdfs:label": {
