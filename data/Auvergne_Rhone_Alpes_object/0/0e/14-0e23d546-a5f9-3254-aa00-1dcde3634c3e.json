  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7436a1b0-03e0-3baa-8cc5-142b28a200a5",
      "dc:description": {
        "de": [
          "Organisiert von den Barsiers Portelois.\nvon 9 bis 12 Uhr und von 14 bis 17 Uhr.\nHochseefischen an Bord der für die Opalküste typischen Boote.\n\nPreis: 15 Euro für einen halben Tag.\nAnmeldung bei der Mediathek"
        ],
        "en": [
          "Organized by Les Barsiers Portelois.\n9am to 12pm and 2pm to 5pm.\nSea fishing aboard typical Opal Coast boats.\n\nPrice: 15 euros for half a day.\nRegistration at the media library"
        ],
        "it": [
          "Organizzato da Les Barsiers Portelois.\ndalle 9.00 alle 12.00 e dalle 14.00 alle 17.00.\nPesca in mare a bordo di barche tipiche della Costa d'Opale.\n\nPrezzo: 15 euro per mezza giornata.\nIscrizioni presso la mediateca"
        ],
        "fr": [
          "Organisées par les Barsiers Portelois.\nde 9h à 12h et de 14h à 17h.\nPêche en mer à bord des bateaux typique de la côte d'opale.\n\nTarif: 15 euros la demi journée.\nInscription auprès de la médiathèque"
        ],
        "es": [
          "Organizado por Les Barsiers Portelois.\nde 9.00 a 12.00 y de 14.00 a 17.00 horas.\nPesca marítima a bordo de embarcaciones típicas de la Costa de Ópalo.\n\nPrecio: 15 euros por media jornada.\nInscripciones en la mediateca"
        ],
        "nl": [
          "Georganiseerd door Les Barsiers Portelois.\n9u tot 12u en 14u tot 17u.\nZeevissen aan boord van boten die typisch zijn voor de Opaalkust.\n\nPrijs: 15 euro voor een halve dag.\nInschrijven bij de mediatheek"
        ]
      },
