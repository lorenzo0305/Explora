  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bietet Ihnen das Unternehmen Restaurant- oder Wanderkreuzfahrten auf dem größten natürlichen See Frankreichs, dem Canal de Savières und der Haut Rhône an. 100% elektrische Motorisierung."
    ],
    "en": [
      "Throughout the year, the Compagnie des Bateaux offers restaurant cruises or excursions on the largest natural lake in France, the Canal de Savières Canal and the Upper Rhône River. 100% electric motorization."
    ],
    "it": [
      "Nel corso dell'anno, la compagnia propone crociere-ristorante o gite sul più grande lago naturale della Francia, il canal de Savières e l'Alto Rodano. Azionamento 100% elettrico."
    ],
    "fr": [
      "Tout au long de l'année, la compagnie vous propose des croisières restaurant ou promenade sur le plus grand lac naturel de France, le canal de Savières et le Haut Rhône. Motorisation 100% électrique."
    ],
    "nl": [
      "Het hele jaar door biedt het bedrijf restaurantcruises of cruises op het grootste natuurlijke meer van Frankrijk, het Savières-kanaal en de Boven-Rhône. 100% elektrische aandrijving."
    ],
    "es": [
      "A lo largo del año, la empresa ofrece cruceros restaurante o cruceros por el lago natural más grande de Francia, el canal de Savières y el Alto Ródano. Propulsión 100% eléctrica."
    ]
  },
