  "rdfs:comment": {
    "de": [
      "Bistronomischer Kochkurs\nGemeinsam an Donnerstagen\nDUO-Formel Kochen/ Übernachtung/ Brunch\nPrivatunterricht ab 2 Personen\nEltern-Kind-Kurse\nErstellen Sie komplette Menüs unter Berücksichtigung der Jahreszeiten und teilen Sie diese in einer geselligen Atmosphäre."
    ],
    "en": [
      "Cookery courses and flower arranging. Fabienne offers cookery courses at her home. You'll create a full menu, using seasonal products."
    ],
    "it": [
      "Corsi di cucina bistronomica\nCollettivo il giovedì\nFormula DUO Cucina/ Pernottamento/ Brunch\nLezioni private per 2 o più persone\nCorsi per genitori e bambini\nMenù completi preparati in base alle stagioni e condivisi in un'atmosfera amichevole."
    ],
    "fr": [
      "Cours de cuisine Bistronomique\nCollectif les Jeudis\nFormule DUO Cuisine/ Nuitée/ Brunch \nCours Privés à partir de 2 pers\nCours Parents Enfants \nRéalisation de Menus complets élaborés dans le respect des saisons et partagé dans une ambiance conviviale."
    ],
    "es": [
      "Clases de cocina bistronómica\nColectiva los jueves\nDUO fórmula Cocina/ Pernoctación/ Brunch\nClases particulares a partir de 2 personas\nClases para padres e hijos\nMenús completos elaborados según las estaciones y compartidos en un ambiente agradable."
    ],
    "nl": [
      "Bistronomische kooklessen\nCollectief op donderdag\nDUO-formule Keuken/ Overnachting/ Brunch\nPrivélessen vanaf 2 personen\nLessen voor ouders en kinderen\nVolledige menu's bereid volgens de seizoenen en gedeeld in een gezellige sfeer."
    ]
  },
  "rdfs:label": {
