  "rdfs:comment": {
    "de": [
      "Die Emmaus-Anlaufstelle in Pradelles ist jeden Mittwoch- und Samstagnachmittag geöffnet. Freiwillige Helfer empfangen Sie von 14:00 bis 18:00 Uhr."
    ],
    "en": [
      "The Emmaüs branch in Pradelles is open every Wednesday and Saturday afternoon, with volunteers on hand to welcome you from 2pm to 6pm."
    ],
    "it": [
      "Lo sportello Emmaus di Pradelles è aperto tutti i mercoledì e i sabati pomeriggio, con volontari pronti ad accogliervi dalle 14.00 alle 18.00."
    ],
    "fr": [
      "L'antenne Emmaüs de Pradelles est ouverte tous les mercredis et samedis après-midi, les bénévoles vous accueillent de 14h00 à 18h00."
    ],
    "es": [
      "La sede de Pradelles Emaús está abierta todos los miércoles y sábados por la tarde, con voluntarios que le recibirán de 14.00 a 18.00 horas."
    ],
    "nl": [
      "De Emmaus-vestiging in Pradelles is elke woensdag- en zaterdagmiddag geopend, met vrijwilligers die je van 14.00 tot 18.00 uur verwelkomen."
    ]
  },
