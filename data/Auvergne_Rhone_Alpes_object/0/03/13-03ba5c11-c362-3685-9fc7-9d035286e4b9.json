  "rdfs:comment": {
    "de": [
      "Kleines Restaurant mit Reservierung in einer alten renovierten Scheune. Marktküche, frische und regionale Produkte. Authentische und ruhige Umgebung. Sie können in mehreren Räumen auf der Terrasse oder im Garten sitzen."
    ],
    "en": [
      "Little restaurant in an ancient farm. Fresh food and local products. Authentic and quiet place."
    ],
    "it": [
      "Piccolo ristorante su prenotazione, in una vecchia stalla ristrutturata. Cucina di mercato, prodotti freschi e locali. Ambiente autentico e tranquillo. È possibile sedersi in diversi spazi della terrazza o del giardino."
    ],
    "fr": [
      "Petit restaurant sur réservation, dans une ancienne étable rénovée. Cuisine du marché, produits frais et locaux. Cadre authentique et calme. Vous pourrez vous installer dans plusieurs espaces sur la terrasse ou dans le jardin."
    ],
    "es": [
      "Pequeño restaurante con reserva, en un antiguo establo renovado. Cocina de mercado, productos frescos y locales. Un entorno auténtico y tranquilo. Puedes sentarte en varios espacios de la terraza o en el jardín."
    ],
    "nl": [
      "Klein restaurant op reservering, in een gerenoveerde voormalige koeienstal. Marktkeuken, verse streekproducten. Authentieke en rustige omgeving. Er zijn verschillende zitjes op het terras of in de tuin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Refuge"
    ]
  },
