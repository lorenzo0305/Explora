  "rdfs:comment": {
    "de": [
      "Designerinnen-Boutique, in der die handgefertigten Kreationen von Chloé, Manon und Pauline neben 14 lokalen Kunsthandwerkern präsentiert werden. Schmuck, Accessoires, Dekoration, Kerzen? Handgefertigte Einzelstücke, das ganze Jahr über Kreativworkshops."
    ],
    "en": [
      "Designer boutique featuring the handcrafted creations of Chloé, Manon and Pauline, alongside 14 local artisans. Jewelry, accessories, home decor, candles? Unique, handmade pieces, with creative workshops offered all year round."
    ],
    "it": [
      "Un negozio di design che presenta le creazioni fatte a mano di Chloé, Manon e Pauline, insieme a 14 artigiani locali. Gioielli, accessori, decorazioni per la casa, candele? Pezzi unici e fatti a mano, con laboratori creativi offerti tutto l'anno."
    ],
    "fr": [
      "Boutique de créatrices mettant à l’honneur les créations artisanales de Chloé, Manon et Pauline, aux côtés de 14 artisans locaux. Bijoux, accessoires, décoration, bougies… Des pièces uniques, faites main, avec des ateliers créatifs proposés toute l’année."
    ],
    "es": [
      "Una tienda de diseño que exhibe las creaciones hechas a mano de Chloé, Manon y Pauline, junto a 14 artesanos locales. Joyas, accesorios, decoración, velas.. Piezas únicas hechas a mano y talleres creativos durante todo el año."
    ],
    "nl": [
      "Een designerwinkel met de handgemaakte creaties van Chloé, Manon en Pauline en 14 plaatselijke ambachtslieden. Sieraden, accessoires, woondecoratie, kaarsen? Unieke, handgemaakte stukken en het hele jaar door creatieve workshops."
    ]
  },
  "rdfs:label": {
