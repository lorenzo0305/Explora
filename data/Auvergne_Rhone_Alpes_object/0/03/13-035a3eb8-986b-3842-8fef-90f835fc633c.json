  "rdfs:comment": {
    "de": [
      "Die Marke Joh.S.creations engagiert sich und gibt bei ihren Kreationen der Qualität den Vorzug vor der Quantität.\r\nAlle ihre Kreationen werden in ihrem Atelier in der Auvergne in Frankreich entworfen und handgefertigt."
    ],
    "en": [
      "The Joh.S.creations brand is committed to quality rather than quantity in its creations.\r\nAll its creations are designed and handmade in France in its workshop in Auvergne."
    ],
    "it": [
      "Il marchio Joh.S.creations punta sulla qualità piuttosto che sulla quantità delle sue creazioni.\r\nTutte le sue creazioni sono progettate e realizzate a mano in Francia, nel suo laboratorio di Auvergne."
    ],
    "fr": [
      "La marque Joh.S.creations s’engage et privilégie la qualité à la quantité dans ses créations.\r\nToutes ses créations sont pensées et confectionnées à la main en France dans son atelier en Auvergne."
    ],
    "es": [
      "La marca Joh.S.creations apuesta por la calidad más que por la cantidad en sus creaciones.\r\nTodas sus creaciones se diseñan y fabrican a mano en Francia, en su taller de Auvernia."
    ],
    "nl": [
      "Het merk Joh.S.creations gaat voor kwaliteit in plaats van kwantiteit in zijn creaties.\r\nAlle creaties worden ontworpen en met de hand gemaakt in Frankrijk in het atelier in Auvergne."
    ]
  },
