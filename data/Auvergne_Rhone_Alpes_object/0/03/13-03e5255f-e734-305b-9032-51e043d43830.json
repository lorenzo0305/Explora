  "rdfs:comment": {
    "de": [
      "Ziegenkäse und Weizenmehl \r\nZu dieser landwirtschafltichen Betriebsgemeinschaft zählen 90 Ziegen. Die gesamte Produktion wird für die Herstellung von Ziegenrohmilchkäse und Joghurt verwendet. Die Weizenproduktion wird auf dem Hof zu Mehl verarbeitet."
    ],
    "en": [
      "Stéphanie and Jérôme Vray have 90 goats. Their entire production goes into making raw-milk goat’s cheese and yoghurt. The farm also cultivates wheat which is processed into flour on the premises."
    ],
    "it": [
      "Stéphanie e Jérôme Vray allevano 80 capre. L'intera produzione è dedicata alla produzione di formaggio e yogurt di capra a latte crudo."
    ],
    "fr": [
      "Stéphanie et Jérôme Vray élèvent 80 chèvres. La totalité de la production est consacrée à la fabrication de fromages de chèvre au lait cru et aux yaourts."
    ],
    "es": [
      "Stéphanie y Jérôme Vray crían 80 cabras. Toda su producción se dedica a la fabricación de queso y yogur de leche cruda de cabra."
    ],
    "nl": [
      "Stéphanie en Jérôme Vray houden 80 geiten. Hun hele productie is gewijd aan het maken van rauwmelkse geitenkaas en yoghurt."
    ]
  },
