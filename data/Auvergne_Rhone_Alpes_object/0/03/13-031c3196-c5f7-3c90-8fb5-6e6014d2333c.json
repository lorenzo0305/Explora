  "rdfs:comment": {
    "de": [
      "Willkommen auf unserem landwirtschaftlichen Familienbetrieb in Beauvoisin, wo die Leidenschaft für den Obstanbau und die Verarbeitung von Qualitätsprodukten seit 1918 von Generation zu Generation weitergegeben wird."
    ],
    "en": [
      "Welcome to our family farm in Beauvoisin, where a passion for growing fruit and processing quality products has been passed down from generation to generation since 1918."
    ],
    "it": [
      "Benvenuti nella nostra azienda agricola familiare di Beauvoisin, dove la passione per la coltivazione della frutta e la lavorazione di prodotti di qualità si tramanda di generazione in generazione dal 1918."
    ],
    "fr": [
      "Bienvenue à notre exploitation agricole familiale située à Beauvoisin, où la passion pour la culture des fruits et la transformation de produits de qualité se transmet de génération en génération depuis 1918."
    ],
    "nl": [
      "Welkom op onze familieboerderij in Beauvoisin, waar de passie voor het telen van fruit en het verwerken van kwaliteitsproducten al sinds 1918 van generatie op generatie wordt doorgegeven."
    ],
    "es": [
      "Bienvenido a nuestra explotación familiar de Beauvoisin, donde la pasión por el cultivo de frutas y la transformación de productos de calidad se transmite de generación en generación desde 1918."
    ]
  },
  "rdfs:label": {
