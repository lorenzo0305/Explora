  "rdfs:comment": {
    "de": [
      "Ausübung, Erlernen und Förderung des Fahrradtourismus. 2 wöchentliche Ausflüge (Mittwoch und Samstag) das ganze Jahr über. 2 Aufenthalte pro Jahr (3 Tage um den 14. Juli und eine Woche im September)."
    ],
    "en": [
      "Practice, training and promotion of cycle touring. 2 weekly outings (Wednesday and Saturday) all year round. 2 holidays a year (3 days around July 14th and a week in September)."
    ],
    "it": [
      "Pratica, apprendimento e promozione del cicloturismo. 2 uscite settimanali (mercoledì e sabato) durante tutto l'anno. 2 soggiorni all'anno (3 giorni intorno al 14 luglio e una settimana a settembre)."
    ],
    "fr": [
      "Pratique, apprentisage et promotion du cyclotourisme. 2 sorties hebdomadaires (mercredi et samedi) toute l'année. 2 séjours par an (3 jours vers le 14 juillet et une semaine en septembre)."
    ],
    "es": [
      "Práctica, aprendizaje y promoción del cicloturismo. 2 salidas semanales (miércoles y sábados) durante todo el año. 2 escapadas al año (3 días en torno al 14 de julio y una semana en septiembre)."
    ],
    "nl": [
      "Oefenen, leren en promoten van fietstochten. 2 wekelijkse uitstapjes (woensdag en zaterdag) het hele jaar door. 2 pauzes per jaar (3 dagen rond 14 juli en een week in september)."
    ]
  },
