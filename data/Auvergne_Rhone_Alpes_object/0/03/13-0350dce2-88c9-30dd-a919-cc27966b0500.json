  "rdfs:comment": {
    "de": [
      "ACHTUNG! Das Triptychon von Moulins ist derzeit im Louvre ausgestellt. Ein Faksimile ist während der Öffnungszeiten der Kathedrale in einer der Chorkapellen zu sehen."
    ],
    "en": [
      "ATTENTION: The Moulins Triptych is currently on display at the Louvre. A facsimile can be viewed during cathedral opening hours in one of the choir chapels."
    ],
    "it": [
      "Il Trittico di Moulins è attualmente esposto al Museo del Louvre. Un facsimile può essere ammirato durante gli orari di apertura della cattedrale in una delle cappelle del coro."
    ],
    "fr": [
      "ATTENTION ! Le Triptyque de Moulins est actuellement exposé au musée du Louvre. Un facsimilé est visible sur les horaires d'ouverture de la cathédrale dans l'une des chapelles du chœur."
    ],
    "es": [
      "El Tríptico de Moulins se expone actualmente en el Museo del Louvre. Un facsímil puede contemplarse durante el horario de apertura de la catedral en una de las capillas del coro."
    ],
    "nl": [
      "De Triptiek van Moulins wordt momenteel tentoongesteld in het Louvre Museum. Een facsimile kan worden bekeken tijdens de openingstijden van de kathedraal in een van de koorkapellen."
    ]
  },
