  "rdfs:comment": {
    "de": [
      "Christophe zeigt Ihnen seinen 10 Hektar großen Familienbetrieb, der gegenüber dem Dent du Chat liegt und die Ebene von Yenne überblickt. Der modernisierte und dekorierte Weinkeller ist ein Spiegelbild des herzlichen Empfangs, der den Besuchern bereitet wird."
    ],
    "en": [
      "Christophe invites you to discover his 10-hectare family estate located in front of the Dent du Chat and overlooking the plain of Yenne. The modernized and decorated cellar reflects the warm welcome reserved for visitors."
    ],
    "it": [
      "Christophe vi invita a scoprire la sua tenuta familiare di 10 ettari, situata di fronte alla Dent du Chat e affacciata sulla pianura di Yenne. La cantina, modernizzata e decorata, riflette la calorosa accoglienza riservata ai visitatori."
    ],
    "fr": [
      "Christophe vous fait découvrir son exploitation familiale de 10 hectares située face à la Dent du Chat et dominant la plaine de Yenne. Le caveau modernisé et décoré est à l'image de l'accueil chaleureux réservé aux visiteurs."
    ],
    "nl": [
      "Christophe neemt je mee op een rondleiding over zijn 10 hectare grote familielandgoed, dat uitkijkt over de Dent du Chat en de vlakte van de Yenne. De kelder is gemoderniseerd en ingericht om de warme ontvangst van bezoekers te weerspiegelen."
    ],
    "es": [
      "Christophe le invita a descubrir su finca familiar de 10 hectáreas situada frente al Dent du Chat y con vistas a la llanura de Yenne. La bodega, modernizada y decorada, refleja la cálida acogida que se dispensa a los visitantes."
    ]
  },
