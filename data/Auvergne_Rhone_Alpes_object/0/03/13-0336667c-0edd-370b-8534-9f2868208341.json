  "rdfs:comment": {
    "de": [
      "Lucy Germanangue, Sophrologin, Therapeutin für neurolinguistisches Programmieren und Praktikerin für Verhaltenstherapie. Ich bin leidenschaftliche Einzelbegleiterin und möchte jede Person zu einer besseren Version ihrer selbst führen."
    ],
    "en": [
      "Lucy Germanangue, sophrologist, neurolinguistic programming therapist and behavioral therapy practitioner. Passionate about individual coaching, I am committed to guiding each person towards a better version of themselves."
    ],
    "it": [
      "Lucy Germanangue, sofrologa, terapeuta di programmazione neuro-linguistica e praticante di terapia comportamentale. Appassionata di coaching individuale, mi impegno a guidare ogni persona verso una versione migliore di se stessa."
    ],
    "fr": [
      "Lucy Germanangue, sophrologue, thérapeute en programmation neurolinguistique et praticienne en thérapie comportementale. Passionnée par l'accompagnement individuel, j'ai à cœur de guider chaque personne vers une meilleure version d'elle-même."
    ],
    "nl": [
      "Lucy Germanangue, sofrologist, neurolinguïstisch programmeertherapeut en gedragstherapeut. Ik ben gepassioneerd door individuele coaching en wil iedereen begeleiden naar een betere versie van zichzelf."
    ],
    "es": [
      "Lucy Germanangue, sofróloga, terapeuta de programación neurolingüística y practicante de terapia conductual. Apasionada del coaching individual, me comprometo a guiar a cada persona hacia una mejor versión de sí misma."
    ]
  },
