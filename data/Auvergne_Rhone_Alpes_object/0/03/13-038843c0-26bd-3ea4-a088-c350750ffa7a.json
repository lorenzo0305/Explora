  "rdfs:comment": {
    "de": [
      "Der im Juni 2011 von Alain Choquart gegründete Verein Actes en Drôme, der 2016 in De l'écrit à l'écran umbenannt wurde, entstand aus dem Wunsch heraus, kulturelle Aktionen rund um das Schreiben und den Film anzubieten."
    ],
    "en": [
      "Founded in June 2011 by Alain Choquart, the Actes en Drôme association, renamed De l'écrit à l'écran in 2016, was born out of a desire to offer cultural initiatives around writing and film."
    ],
    "it": [
      "Fondata nel giugno 2011 da Alain Choquart, l'associazione Actes en Drôme, ribattezzata De l'écrit à l'écran nel 2016, è nata dal desiderio di offrire attività culturali basate sulla scrittura e sul cinema."
    ],
    "fr": [
      "Créée en juin 2011 par Alain Choquart, l’association Actes en Drôme, rebaptisée De l’écrit à l’écran en 2016, est née du désir de proposer des actions culturelles autour de l’écriture et du cinéma."
    ],
    "es": [
      "Fundada en junio de 2011 por Alain Choquart, la asociación Actes en Drôme, rebautizada De l'écrit à l'écran en 2016, nació del deseo de ofrecer actividades culturales en torno a la escritura y el cine."
    ],
    "nl": [
      "De vereniging Actes en Drôme, in juni 2011 opgericht door Alain Choquart en in 2016 omgedoopt tot De l'écrit à l'écran, is ontstaan uit de wens om culturele activiteiten rond schrijven en film aan te bieden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "De l'écrit à l'écran"
    ]
  },
