      "@id": "https://data.datatourisme.fr/b9725699-15f1-39d6-83b8-daed80e2f248",
      "dc:description": {
        "de": [
          "Von 16:00 bis 22:00 Uhr (nach dem 19.05. bis Mitternacht) - Lieferung nach Hause. Ein neuer Lebensmittelladen im Stadtzentrum, der geöffnet bleibt und am Ende des Tages eine Lieferung nach Hause anbietet."
        ],
        "en": [
          "From 4pm to 10pm (after 19/05 until midnight) - Home delivery. A new downtown grocery store that stays open and offers home delivery at the end of the day."
        ],
        "it": [
          "Dalle 16.00 alle 22.00 (dopo il 19/05 fino a mezzanotte) - Consegna a domicilio. Un nuovo negozio di alimentari in centro città che rimane aperto e offre la consegna a domicilio a fine giornata."
        ],
        "fr": [
          "De 16h à 22h (après le 19/05 jusque minuit) - Livraison à domicile. Une nouvelle épicerie en centre-ville qui reste ouverte et propose la livraison à domicile en fin de journée."
        ],
        "nl": [
          "Van 16.00 tot 22.00 uur (na 19/05 tot middernacht) - Thuisbezorging. Een nieuwe kruidenierswinkel in het stadscentrum die open blijft en aan het eind van de dag thuisbezorgd."
        ],
        "es": [
          "De 16:00 a 22:00 (después del 19/05 hasta medianoche) - Entrega a domicilio. Una nueva tienda de comestibles en el centro de la ciudad que permanece abierta y ofrece reparto a domicilio al final del día."
        ]
      },
