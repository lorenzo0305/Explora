  "rdfs:comment": {
    "de": [
      "Produzenten von Beerenfrüchten aus biologischem Anbau. Entdecken Sie das ganze Jahr über den guten Geschmack von Beerenfrüchten mit Konfitüren, Nektaren, Coulis und Fruchtpüree."
    ],
    "en": [
      "Organic berry producers. Enjoy the great taste of red fruit all year round with our jams, nectars, coulis and fruit purée."
    ],
    "it": [
      "Produttori biologici di piccoli frutti. Godetevi l'ottimo gusto dei frutti rossi tutto l'anno con le nostre marmellate, nettari, coulis e puree di frutta."
    ],
    "fr": [
      "Producteurs de petits fruits en Agriculture Biologique. Retrouvez le bon goût des fruits rouges toute l'année avec les confitures, nectars, coulis et purée de fruits."
    ],
    "es": [
      "Pequeños productores de fruta ecológica. Disfrute del gran sabor de los frutos rojos durante todo el año con nuestras mermeladas, néctares, coulis y purés de fruta."
    ],
    "nl": [
      "Biologische producenten van klein fruit. Geniet het hele jaar door van de heerlijke smaak van rood fruit met onze jam, nectar, coulis en vruchtenmoes."
    ]
  },
