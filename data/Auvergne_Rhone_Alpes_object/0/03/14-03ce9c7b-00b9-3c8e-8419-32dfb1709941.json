  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b5e9bfc7-4a95-3cac-9211-2410bb233279",
      "dc:description": {
        "de": [
          "Designerboutique mit lokalem Kunsthandwerk, französischen Kreationen, kleinen Marken in den Bereichen Dekoration, Schmuck, Accessoires...\n\nAnsatz \"Null Plastik\"\nAnsatz \"Null Abfall\"\nAnsatz \"Anti-Verschwendung\"\nAnsatz \"Ökologischer/100% natürlicher Haushalt\"\nAnsatz \"Nachhaltige Ernährung\""
        ],
        "en": [
          "Designer boutique with local crafts, French creations, small brands in decor, jewelry, accessories...\n\nZero plastic\" approach\nZero waste\" approach\nAnti-gaspi\" approach\nEcological household/100% natural\" approach\nSustainable food\" approach"
        ],
        "it": [
          "Negozio di design con artigianato locale, creazioni francesi, piccoli marchi di decorazione, gioielli, accessori...\n\nApproccio \"zero plastica\nApproccio \"zero rifiuti\nApproccio \"anti-gaspi\nApproccio \"casa ecologica/100% naturale\nIniziativa \"cibo sostenibile"
        ],
        "fr": [
          "Boutique de créateurs avec artisanat local, créations françaises, petites marques en déco, bijoux, accessoires...\n\nDémarche \"Zéro plastique\"\nDémarche \"Zéro déchet\"\nDémarche \"Anti-gaspi\"\nDémarche \"Ménage écologique/100% naturel\"\nDémarche  \"Alimentation durable\""
        ],
        "es": [
          "Tienda de diseño con artesanía local, creaciones francesas, pequeñas marcas de decoración, joyería, accesorios...\n\nPlástico cero\nEnfoque \"cero residuos\nEnfoque \"anti-gaspi\nEnfoque \"hogar ecológico/100% natural\nIniciativa \"Alimentos sostenibles"
        ],
        "nl": [
          "Designerwinkel met lokale ambachten, Franse creaties, kleine merken in decoratie, juwelen, accessoires...\n\nZero plastic\" benadering\nZero afval\" benadering\nAanpak \"antigas\nEcologisch huishouden/100% natuurlijk\nInitiatief \"Duurzaam voedsel"
        ]
      },
