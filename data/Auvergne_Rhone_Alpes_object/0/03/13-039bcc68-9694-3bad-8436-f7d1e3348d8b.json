  "rdfs:comment": {
    "de": [
      "Gemütliches und geselliges Restaurant, in dem Sie eine traditionelle, großzügige und hausgemachte Küche genießen können.\r\nEine Karte, die jeden Monat mit lokalen Produkten erneuert wird."
    ],
    "en": [
      "A warm and friendly restaurant where you can enjoy traditional, generous, home-cooked cuisine.\r\nA menu renewed every month with local produce."
    ],
    "it": [
      "Un ristorante caldo e accogliente dove gustare una cucina tradizionale, generosa e casalinga.\r\nIl menu viene rinnovato ogni mese e prevede l'utilizzo di prodotti locali."
    ],
    "fr": [
      "Restaurant chaleureux et convivial pour savourer une cuisine de tradition, généreuse et faite maison.\r\nUne carte, renouvelée tous les mois avec des produits locaux."
    ],
    "es": [
      "Un restaurante cálido y acogedor donde disfrutar de una cocina casera, tradicional y generosa.\r\nLa carta se renueva cada mes y está elaborada con productos locales."
    ],
    "nl": [
      "Een warm en vriendelijk restaurant waar je kunt genieten van traditionele, royale, huisgemaakte gerechten.\r\nHet menu wordt elke maand vernieuwd en bevat lokale producten."
    ]
  },
  "rdfs:label": {
