  "rdfs:comment": {
    "de": [
      "Drehen Sie die Zeit zurück, teilen Sie antike Geheimnisse und bewundern Sie die feinen Kreationen der damaligen Zeit in einer herrlichen und authentischen Umgebung!"
    ],
    "en": [
      "Set in a former pottery the museum dis- plays hundreds of artefacts from the Lezoux archaeological site, and offers several activities."
    ],
    "it": [
      "Tornate indietro nel tempo, condividete antichi segreti e ammirate la finezza delle creazioni dell'epoca in un ambiente splendido e autentico!"
    ],
    "fr": [
      "Remontez le temps, partagez d’antiques secrets et admirez la finesse des créations de l’époque dans un cadre splendide et authentique !"
    ],
    "es": [
      "Retroceda en el tiempo, comparta antiguos secretos y admire las bellas creaciones de la época en un entorno espléndido y auténtico"
    ],
    "nl": [
      "Ga terug in de tijd, deel oude geheimen en bewonder de mooie creaties van die tijd in een prachtig en authentiek kader!"
    ]
  },
