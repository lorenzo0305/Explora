  "rdfs:comment": {
    "de": [
      "Die Ferme des Lignières ist ein kleiner Gemüsebaubetrieb mit natürlichem konventionellem Anbau.\r\nWir bieten jede Woche Körbe mit Gemüse und Obst der Saison zum Verkauf an."
    ],
    "en": [
      "La ferme des Lignières is a small, natural, conventional market-garden farm.\r\nWe sell weekly baskets of seasonal fruit and vegetables."
    ],
    "it": [
      "La fattoria di Lignières è un piccolo orto naturale e convenzionale.\r\nVendiamo settimanalmente cesti di frutta e verdura di stagione."
    ],
    "fr": [
      "La ferme des Lignières est une petite exploitation maraîchère de culture conventionnelle naturelle.\r\nNous proposons à la vente chaque semaines des paniers de légumes et fruits de saison."
    ],
    "es": [
      "La granja de Lignières es una pequeña huerta natural y convencional.\r\nVendemos semanalmente cestas de frutas y verduras de temporada."
    ],
    "nl": [
      "De boerderij van Lignières is een kleine, natuurlijke, conventionele tuinderij.\r\nWe verkopen wekelijkse manden met seizoensfruit en -groenten."
    ]
  },
