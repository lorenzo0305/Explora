  "rdfs:comment": {
    "de": [
      "Das in Longues gelegene Schwimmbad Val d'Allier Comté wurde als Nahversorgungseinrichtung konzipiert, die ein breites Publikum aus dem gesamten Süden des Großraums Clermont-Ferrand ansprechen soll."
    ],
    "en": [
      "Located in Longues, the Val d'Allier Comté swimming pool was designed as a local facility intended to welcome a large public from all over the south of the Clermont-Ferrand area."
    ],
    "it": [
      "Situata a Longues, la piscina di Val d'Allier Comté è stata concepita come impianto locale per un gran numero di persone provenienti da tutto il sud dell'agglomerato di Clermont-Ferrand."
    ],
    "fr": [
      "Implantée à Longues, la piscine Val d’Allier Comté a été pensée comme un équipement de proximité destiné à accueillir un large public venu de tout le sud de l’agglomération clermontoise."
    ],
    "es": [
      "Situada en Longues, la piscina Val d'Allier Comté fue concebida como una instalación de proximidad para un gran número de personas procedentes de todo el sur de la aglomeración de Clermont-Ferrand."
    ],
    "nl": [
      "Het zwembad van Val d'Allier Comté, gelegen in Longues, is ontworpen als lokale voorziening voor een groot aantal mensen uit het zuiden van de agglomeratie Clermont-Ferrand."
    ]
  },
  "rdfs:label": {
