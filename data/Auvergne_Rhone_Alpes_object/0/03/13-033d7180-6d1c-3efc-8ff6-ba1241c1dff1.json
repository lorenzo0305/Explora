  "rdfs:comment": {
    "de": [
      "Unsere Vereinigung hat es sich zur Aufgabe gemacht, die italienische Kultur in all ihren Formen zu fördern: Sprache, Film, Literatur... Sie organisiert insbesondere das Festival des italienischen Films, das zwischen Le Teil, Cruas und Montélimar stattfindet."
    ],
    "en": [
      "Our association's mission is to promote Italian culture in all its forms: language, cinema, literature... In particular, it organizes the Italian Film Festival, which takes place between Le Teil, Cruas and Montélimar."
    ],
    "it": [
      "La missione della nostra associazione è promuovere la cultura italiana in tutte le sue forme: lingua, cinema, letteratura... In particolare, organizza il Festival del Cinema Italiano che si svolge tra Le Teil, Cruas e Montélimar."
    ],
    "fr": [
      "Notre association a pour mission la promotion de la culture italienne sous toutes ses formes : langue, cinéma, littérature... Elle organise notamment le Festival du Cinéma Italien qui se déroule entre le Teil, Cruas et Montélimar."
    ],
    "es": [
      "La misión de nuestra asociación es promover la cultura italiana en todas sus formas: lengua, cine, literatura... En particular, organiza el Festival de Cine Italiano que se celebra entre Le Teil, Cruas y Montélimar."
    ],
    "nl": [
      "De missie van onze vereniging is het promoten van de Italiaanse cultuur in al haar vormen: taal, film, literatuur, enz. Ze organiseert met name het Italiaanse filmfestival, dat plaatsvindt tussen Le Teil, Cruas en Montélimar."
    ]
  },
  "rdfs:label": {
    "fr": [
