  "rdfs:comment": {
    "de": [
      "Festival zur Unterstützung von L'Anthyllis, einem kollektiven, bäuerlichen Ort der Gastfreundschaft und des Experimentierens in Miscon. Sauna mobil mit Sonambul ab 14 Uhr. Ab 18 Uhr: Kantine und Getränkestand. Ab 20 Uhr Musikabend mit verschiedenen Gruppen."
    ],
    "en": [
      "Festival in support of L'Anthyllis, a collective space for peasant experimentation in Miscon. Mobile sauna with Sonambul from 2pm. From 6pm: canteen and refreshments. From 8pm: musical evening with various groups."
    ],
    "it": [
      "Festa a sostegno di l'Anthyllis, luogo collettivo di accoglienza e sperimentazione per gli agricoltori di Miscon. Sauna mobile con Sonambul dalle 14.00. Dalle 18:00: mensa e rinfresco. Serata musicale con vari gruppi dalle 20.00."
    ],
    "fr": [
      "Festival de soutien à l'Anthyllis, lieu collectif, d'accueil et d'expérimentation paysanne à Miscon. Sauna mobil avec Sonambul à partir de 14h. A partir de 18h : cantine et buvette. Dès 20h soirée musicale avec différents groupes."
    ],
    "nl": [
      "Festival ter ondersteuning van l'Anthyllis, een collectieve ontvangst- en experimenteerplek voor boeren in Miscon. Mobiele sauna met Sonambul vanaf 14.00 uur. Vanaf 18.00 uur: kantine en versnaperingen. Muziekavond met verschillende groepen vanaf 20.00 uur."
    ],
    "es": [
      "Festival en apoyo de l'Anthyllis, lugar colectivo de acogida y experimentación para los agricultores de Miscon. Sauna móvil con Sonambul a partir de las 14h. A partir de las 18:00: cantina y refrescos. Velada musical con varios grupos a partir de las 20.00 h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival de soutien à l'Anthyllis des montagnes"
    ]
  },
