  "rdfs:comment": {
    "de": [
      "Dieser kleine Strand neben der Ruderbasis ist zweifellos der schattigste am Ufer des Lac d'Aiguebelette! Er ist mit weitläufigen Rasenflächen bedeckt und wird durch einen breiten Sandstreifen aufgelockert."
    ],
    "en": [
      "This small beach, located next to the rowing base, is undoubtedly the most shaded one by the shores of Lake Aiguebelette! It is covered with vast lawns and complemented by a wide strip of sand."
    ],
    "it": [
      "Questa piccola spiaggia accanto al centro di canottaggio è senza dubbio la più ombrosa delle rive del lago di Aiguebelette! È ricoperta da un vasto prato e arricchita da un'ampia striscia di sabbia."
    ],
    "fr": [
      "Cette petite plage située à côté de la base d'aviron est sans conteste la plus ombragée au bord du lac d'Aiguebelette ! Elle est couverte de vastes pelouses et agrémentée d'une large bande de sable."
    ],
    "es": [
      "Esta pequeña playa situada junto al centro de remo es sin duda la más sombría de las orillas del lago de Aiguebelette Está cubierta de un extenso césped y realzada por una amplia franja de arena."
    ],
    "nl": [
      "Dit kleine strand naast het roeicentrum is ongetwijfeld het schaduwrijkste aan de oevers van het meer van Aiguebelette! Het is bedekt met uitgestrekte grasvelden en wordt versterkt door een brede strook zand."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bon Vent beach"
    ],
    "fr": [
      "Plage de Bon Vent"
    ]
  },
