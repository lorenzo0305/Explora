  "rdfs:comment": {
    "de": [
      "Pauline und Renaud züchten Milchkühe. Finden Sie ihre Joghurts und Milchdesserts auf dem Markt am Freitagmorgen in Saugues!"
    ],
    "en": [
      "Pauline and Renaud raise dairy cows, and you can find their yoghurts and dairy desserts at the Friday morning market in Saugues!"
    ],
    "it": [
      "Pauline e Renaud allevano mucche da latte e potete trovare i loro yogurt e dolci a base di latte al mercato del venerdì mattina a Saugues!"
    ],
    "fr": [
      "Pauline et Renaud élèvent des vaches laitières, retrouvez leurs yaourts et desserts lactés sur le marché du vendredi matin à Saugues !"
    ],
    "es": [
      "Pauline y Renaud crían vacas lecheras, y puedes encontrar sus yogures y postres lácteos en el mercado de los viernes por la mañana en Saugues"
    ],
