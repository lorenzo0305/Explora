  "rdfs:comment": {
    "de": [
      "Die seit 1800 in den Montagne Bourbonnaise ansässige Mühle stellt ausschließlich Mehl aus Getreide aus zertifiziert biologischem Anbau FR-B/O-01 (Weizen, Roggen, Dinkel, Kamut, Einkorn) sowie Walnuss- und Haselnussöl her."
    ],
    "en": [
      "The mill, established in the Montagne Bourbonnaise since 1800, produces only flours from organically grown FR-B/O-01 certified cereals (wheat, rye, spelt, kamut, small spelt) and walnut and hazelnut oil."
    ],
    "it": [
      "Il mulino, che ha sede nella Montagne Bourbonnaise dal 1800, produce solo farine di cereali (grano, segale, farro, kamut, piccolo farro) coltivati con metodo biologico certificato FR-B/O-01 e olio di noci e nocciole."
    ],
    "fr": [
      "Le moulin, installé en Montagne bourbonnaise depuis 1800 produit uniquement des farines issues de céréales en culture biologique certifiée FR-B/O-01 (blé, seigle, épeautre, kamut, petit épeautre) et de l'huile de noix et de noisettes."
    ],
    "es": [
      "El molino, instalado en la Montaña Bourbonnaise desde 1800, produce exclusivamente harinas a partir de cereales de cultivo ecológico certificados FR-B/O-01 (trigo, centeno, espelta, kamut, escanda pequeña) y aceite de nuez y avellana."
    ],
    "nl": [
      "De molen, die al sinds 1800 gevestigd is in de Montagne Bourbonnaise, produceert alleen meel van biologisch geteelde FR-B/O-01 gecertificeerde granen (tarwe, rogge, spelt, kamut, kleine spelt) en walnoot- en hazelnootolie."
    ]
  },
  "rdfs:label": {
    "fr": [
