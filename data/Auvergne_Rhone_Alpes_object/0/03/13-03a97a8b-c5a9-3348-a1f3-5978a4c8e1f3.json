  "rdfs:comment": {
    "de": [
      "Begleitet von Nicolas Leproust, einem Spieldesigner mit Vermittlungsresidenz im Netzwerk, entdecken die Kinder die Etappen der Konzeption eines Kartenspiels, seine Codes und Einschränkungen."
    ],
    "en": [
      "Accompanied by Nicolas Leproust, game designer in residence in the network, children will discover the steps involved in designing a card game, its codes and constraints."
    ],
    "it": [
      "Accompagnati da Nicolas Leproust, game designer in residenza nella rete, i bambini scopriranno le fasi di progettazione di un gioco di carte, i suoi codici e i suoi vincoli."
    ],
    "fr": [
      "Accompagnés par Nicolas Leproust, créateur de jeux en résidence de médiation dans le réseau, les enfants découvriront les étapes de la conception d'un jeu de cartes, ses codes et ses contraintes."
    ],
    "nl": [
      "Onder begeleiding van Nicolas Leproust, spelontwerper in residentie in het netwerk, ontdekken de kinderen de stadia die komen kijken bij het ontwerpen van een kaartspel, de codes en de beperkingen."
    ],
    "es": [
      "Acompañados por Nicolas Leproust, diseñador de juegos residente en la red, los niños descubrirán las etapas del diseño de un juego de cartas, sus códigos y sus limitaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Créer un jeu de carte"
    ]
  },
