  "rdfs:comment": {
    "de": [
      "Die Commune Mazerat zieht 2026 in die Markthallen von Saint-Etienne ein. Wir bieten ein einzigartiges Konzept, das gastronomische Inkubatoren, Geselligkeit, Kultur und Events miteinander verbindet."
    ],
    "en": [
      "La Commune Mazerat has taken over Les Halles de Saint-Etienne in 2026. We offer a unique concept combining gastronomic incubation, conviviality, culture and events."
    ],
    "it": [
      "La Commune Mazerat ha rilevato Les Halles de Saint-Etienne nel 2026. Offriamo un concetto unico che combina incubazione gastronomica, convivialità, cultura ed eventi."
    ],
    "fr": [
      "La Commune Mazerat a investi les Halles de Saint-Etienne en 2026. Nous proposons un concept unique mêlant Incubateur Gastronomique, Convivialité, Culture et Evènementiel."
    ],
    "nl": [
      "La Commune Mazerat heeft in 2026 Les Halles de Saint-Etienne overgenomen. Wij bieden een uniek concept dat gastronomische incubatie, gezelligheid, cultuur en evenementen combineert."
    ],
    "es": [
      "La Commune Mazerat ha tomado el relevo de Les Halles de Saint-Etienne en 2026. Ofrecemos un concepto único que combina incubación gastronómica, convivencia, cultura y eventos."
    ]
  },
