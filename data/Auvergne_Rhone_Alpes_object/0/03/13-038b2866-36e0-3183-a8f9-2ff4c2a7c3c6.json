  "rdfs:comment": {
    "de": [
      "Baaly wurde für Frauen entwickelt, die ihr graues Haar respektvoll und vollständig abdecken oder einfach nur ihr Haar mit gesunden, 100% natürlichen und umweltfreundlichen Produkten verschönern möchten."
    ],
    "en": [
      "Baaly has been designed for women who want to respectfully and totally cover their white hair or simply embellish their hair with healthy, 100% natural and environmentally-friendly products."
    ],
    "it": [
      "Baaly è un'azienda di Drôme fondata da Christelle Flouret, parrucchiera e colorista da oltre 30 anni.\nIspirata dal suo percorso personale e dalla ricerca di alternative più sane, ha creato una gamma di colori per capelli al 100% a base vegetale."
    ],
    "fr": [
      "Baaly, une entreprise drômoise fondée par Christelle Flouret, coiffeuse-coloriste depuis plus de 30 ans.\nInspirée par son parcours personnel et sa recherche d’alternatives plus saines, elle a créé une gamme de colorations 100 % végétales."
    ],
    "nl": [
      "Baaly is ontworpen voor vrouwen die hun grijze haar respectvol en volledig willen bedekken of gewoon hun haar willen verfraaien met gezonde, 100% natuurlijke en milieuvriendelijke producten."
    ],
    "es": [
      "Baaly es una empresa de Drôme fundada por Christelle Flouret, peluquera y colorista desde hace más de 30 años.\nInspirada por su trayectoria personal y su búsqueda de alternativas más saludables, ha creado una gama de tintes capilares 100% vegetales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baaly - Cosmétique végétale"
    ]
  },
