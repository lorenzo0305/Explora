  "rdfs:comment": {
    "de": [
      "Wie läuft eine Sitzung ab? : Sie kommen in den Raum in Pierrelatte und bringen Ihre Isomatte, Decke und Kissen mit und lassen sich von meiner Stimme führen. Kurze Meditation mit Stille, um sich auf sich selbst zu konzentrieren."
    ],
    "en": [
      "How does a session work? You come to the Pierrelatte studio, bring your own floor mat, blanket and cushion, and let my voice guide you. Short meditation in silence to refocus on yourself."
    ],
    "it": [
      "Come funziona una sessione? si viene in studio a Pierrelatte, si porta il tappetino, la coperta e il cuscino e ci si lascia guidare dalla mia voce. Breve meditazione in silenzio per ricentrarsi su se stessi."
    ],
    "fr": [
      "Comment se passe une séance ? : Vous venez au local de Pierrelatte et vous apportez votre tapis de sol, couverture et coussin et vous vous laisser guider par ma voix. Courte méditation avec le silence pour se recentrer sur soi."
    ],
    "es": [
      "¿Cómo funciona una sesión? vienes al estudio de Pierrelatte, traes tu esterilla, manta y cojín y te dejas guiar por mi voz. Breve meditación en silencio para volver a centrarte en ti mismo."
    ],
    "nl": [
      "Hoe werkt een sessie? Je komt naar de studio in Pierrelatte, brengt je vloermat, deken en kussen mee en laat je leiden door mijn stem. Korte meditatie in stilte om je weer op jezelf te concentreren."
    ]
  },
  "rdfs:label": {
