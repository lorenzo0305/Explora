  "rdfs:comment": {
    "de": [
      "Im Restaurant l'auberge de la Cascade du Rouget können Sie den ganzen Sommer über savoyische Spezialitäten genießen und dabei einen herrlichen Blick auf den Wasserfall Cascade du Rouget genießen."
    ],
    "en": [
      "The \"Auberge de la Cascade du Rouget\" welcomes you all summer to taste Savoyard specialties with a magnificent view of the Cascade du Rouget."
    ],
    "it": [
      "Il ristorante dell'Auberge de la Cascade du Rouget vi accoglie tutta l'estate per gustare le specialità savoiarde con una magnifica vista sulla Cascade du Rouget."
    ],
    "fr": [
      "Le restaurant l'auberge de la Cascade du Rouget vous accueille tout l'été pour déguster des spécialités savoyardes avec une magnifique vue sur la Cascade du Rouget."
    ],
    "nl": [
      "Het restaurant Auberge de la Cascade du Rouget verwelkomt u de hele zomer om te genieten van Savoyaardse specialiteiten met een prachtig uitzicht op de Cascade du Rouget."
    ],
    "es": [
      "El restaurante del Auberge de la Cascade du Rouget le recibe todo el verano para degustar especialidades saboyanas con una magnífica vista de la Cascade du Rouget."
    ]
  },
