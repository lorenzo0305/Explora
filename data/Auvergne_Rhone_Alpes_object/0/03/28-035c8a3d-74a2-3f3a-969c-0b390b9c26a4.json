  "rdfs:comment": {
    "de": [
      "Hier wird Ronny Coutteure, ein Künstler aus dem Norden, Dichter und Bierologe, geehrt und es werden traditionelle regionale Gerichte angeboten."
    ],
    "en": [
      "A tribute to Ronny Coutteure, northern artist, poet and beer-lover, is paid at this venue, which serves traditional regional dishes."
    ],
    "it": [
      "Un omaggio a Ronny Coutteure, artista nordico, poeta e amante della birra, viene reso in questo locale, che serve piatti della tradizione regionale."
    ],
    "fr": [
      "Un hommage à Ronny Coutteure, artiste du Nord, poète, biérologue est rendu dans ce lieu qui propose des plats traditionnels régionaux."
    ],
    "es": [
      "En este local, que sirve platos regionales tradicionales, se rinde homenaje a Ronny Coutteure, artista, poeta y amante de la cerveza del norte."
    ],
    "nl": [
      "Een eerbetoon aan Ronny Coutteure, noordelijke kunstenaar, dichter en bierliefhebber, wordt gebracht in dit restaurant, waar traditionele regionale gerechten worden geserveerd."
    ]
  },
