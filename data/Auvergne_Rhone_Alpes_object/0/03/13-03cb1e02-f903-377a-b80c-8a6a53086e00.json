  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, allein oder mit Freunden: Nehmen Sie die Herausforderung an, entspannen Sie sich und genießen Sie diesen schattigen 18-Loch-Parcours der Minigolfanlage des Parks."
    ],
    "en": [
      "A peaceful family time within the framework of the City Park and the racecourse."
    ],
    "it": [
      "Se siete in famiglia, da soli o con gli amici, venite a sfidarvi, a rilassarvi o a divertirvi sull'ombreggiato campo da minigolf a 18 buche del parco. Bevande disponibili in loco. Possibilità di feste di compleanno."
    ],
    "fr": [
      "En famille, seul ou entre amis venez vous défier, vous détendre ou vous amuser sur le parcours 18 trous ombragé du mini-golf du parc. Vente de boissons sur place. Possibilité d'organiser un anniversaire."
    ],
    "es": [
      "Ya sea en familia, solo o con amigos, venga a desafiarse, relajarse o divertirse en el sombreado campo de minigolf de 18 hoyos del parque. Bebidas disponibles in situ. Fiestas de cumpleaños."
    ],
    "nl": [
      "Of je nu met het gezin, alleen of met vrienden bent, kom en daag jezelf uit, ontspan of vermaak je op de schaduwrijke 18-holes midgetgolfbaan in het park. Drankjes ter plaatse verkrijgbaar. Verjaardagsfeestjes mogelijk."
    ]
  },
