  "rdfs:comment": {
    "de": [
      "Valérie erwartet Sie in ihrem Boutique-Atelier 10 Minuten zu Fuß von den Thermen von Neyrac-les-Bains entfernt. Hier können Sie sich in verschiedene Modellier- und Dekorationstechniken einführen lassen. Das Atelier ist jeden Donnerstag von 14:00 bis 17:00 Uhr oder nach Vereinbarung geöffnet."
    ],
    "en": [
      "Valérie Férulla awaits you in her workshop-boutique, a 10-minute walk from the Neyrac-les-Bains thermal baths. You can try your hand at different modelling and decoration techniques and leave with your own piece."
    ],
    "it": [
      "Valérie vi aspetta nel suo laboratorio boutique, a 10 minuti a piedi dalle terme di Neyrac-les-Bains. Potrete cimentarvi in diverse tecniche di modellazione e decorazione. Il laboratorio è aperto ogni giovedì dalle 14.00 alle 17.00, oppure su appuntamento."
    ],
    "fr": [
      "Valérie vous attend dans son atelier boutique à 10 min. à pied des Thermes de Neyrac-les-Bains. Vous pourrez vous initier à différentes techniques de modelage et de décoration. Ouverture de l'atelier tous les jeudis de 14h à 17h ou sur rendez-vous."
    ],
    "nl": [
      "Valérie wacht op je in haar boetiekatelier, op 10 minuten lopen van de thermale baden van Neyrac-les-Bains. Je kunt er verschillende boetseer- en decoratietechnieken uitproberen. Het atelier is elke donderdag open van 14 tot 17 uur, of op afspraak."
    ],
    "es": [
      "Valérie le espera en su taller boutique, a 10 minutos a pie de los baños termales de Neyrac-les-Bains. Podrá probar diferentes técnicas de modelado y decoración. El taller abre todos los jueves de 14:00 a 17:00, o con cita previa."
    ]
  },
