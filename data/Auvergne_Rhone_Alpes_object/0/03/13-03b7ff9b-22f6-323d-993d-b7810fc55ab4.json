  "rdfs:comment": {
    "de": [
      "Das Restaurant der Base Camp Lodge Les 2 Alpes bietet eine großzügige Küche, die savoyische Spezialitäten, Signature Dishes und hausgemachte Pizzen miteinander verbindet. In einer gemütlichen, bergischen Atmosphäre ist es die ideale Adresse, um ein leckeres Essen zu genießen."
    ],
    "en": [
      "The restaurant at Base Camp Lodge Les 2 Alpes offers generous cuisine combining Savoyard specialties, signature dishes, and homemade pizzas. In a warm and mountain-inspired atmosphere, it’s the ideal spot to share a delicious meal."
    ],
    "it": [
      "Il ristorante del Base Camp Lodge Les 2 Alpes propone una cucina generosa che unisce specialità savoiarde, piatti d’autore e pizze fatte in casa. In un’atmosfera conviviale e di montagna, è l’indirizzo ideale per condividere un pasto goloso."
    ],
    "fr": [
      "Le restaurant du Base Camp Lodge Les 2 Alpes propose une cuisine généreuse mêlant spécialités savoyardes, plats signature et pizzas maison. Dans une ambiance conviviale et montagnarde, c’est l’adresse idéale pour partager un repas gourmand."
    ],
    "nl": [
      "Het restaurant van Base Camp Lodge Les 2 Alpes serveert een royale selectie Savoyaardse specialiteiten, kenmerkende gerechten en zelfgemaakte pizza's. In een vriendelijke bergsfeer is het de ideale plek om te genieten van een gastronomische maaltijd."
    ],
    "es": [
      "El restaurante del Base Camp Lodge Les 2 Alpes sirve una generosa selección de especialidades saboyanas, platos de autor y pizzas caseras. En un ambiente acogedor de montaña, es el lugar ideal para disfrutar de una comida gourmet."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le BC7"
    ],
    "it": [
      "Restaurant Le BC7"
    ],
    "fr": [
      "Restaurant de l'Hôtel Base Camp Lodge"
    ]
  },
