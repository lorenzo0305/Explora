  "rdfs:comment": {
    "de": [
      "Ausstellung von Ingrid Eberspächer. Papierschnitte, Zeichnungen, Gemälde, Bilderspulen für diese erste Ausstellung in Frankreich. Der größte Teil ihrer Werke besteht aus großen Bildern, die mit einem Cutter aus schwarzem Tonpapier ausgeschnitten wurden."
    ],
    "en": [
      "Exhibition by Ingrid Eberspächer. Paper cut-outs, drawings, paintings and reels of images for this first exhibition in France. Most of her work consists of large images cut from black clay paper."
    ],
    "it": [
      "Mostra di Ingrid Eberspächer. Ritagli di carta, disegni, dipinti, bobine di immagini per questa prima mostra in Francia. La maggior parte del suo lavoro consiste in immagini di grandi dimensioni ritagliate da carta argillosa nera con un cutter."
    ],
    "fr": [
      "Exposition de Ingrid Eberspächer. Papiers découpés, dessins, peintures, bobines d’images pour cette première exposition en France. La plus grande partie de ses œuvres consiste en de grandes images découpées au cutter dans du papier d’argile noir."
    ],
    "nl": [
      "Tentoonstelling door Ingrid Eberspächer. Papieren cut-outs, tekeningen, schilderijen, beeldrollen voor deze eerste tentoonstelling in Frankrijk. Het meeste van haar werk bestaat uit grote afbeeldingen die met een cutter uit zwart kleipapier zijn gesneden."
    ],
    "es": [
      "Exposición de Ingrid Eberspächer. Recortes de papel, dibujos, pinturas, carretes de imágenes para esta primera exposición en Francia. La mayor parte de su obra consiste en grandes imágenes recortadas en papel de arcilla negra con un cúter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mon amie allemande"
    ]
  },
