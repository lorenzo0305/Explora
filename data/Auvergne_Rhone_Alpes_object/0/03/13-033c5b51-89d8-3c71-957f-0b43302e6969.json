  "rdfs:comment": {
    "de": [
      "Coralie rehabilitiert ein lokales und erneuerbares Material: Weide! Sie bietet Korbwaren an\r\ngeflochtene Objekte (Körbe, Dekoration) an, die zugleich nützlich, solide und zeitgemäß sind. Anbau von Weiden mit AB-Zertifizierung. Praktika und Animationen."
    ],
    "en": [
      "Coralie rehabilitates a local and renewable material: wicker! She offers\r\nwoven objects (baskets, decorations) that are useful, solid and contemporary. AB-certified wicker cultivation. Workshops and events."
    ],
    "it": [
      "Coralie riabilita un materiale locale e rinnovabile: il vimini! Offre\r\noggetti intrecciati (cesti, decorazioni) utili, solidi e contemporanei. Coltivazione di vimini certificata AB. Corsi ed eventi."
    ],
    "fr": [
      "Coralie réhabilite un matériau local et renouvelable : l’osier ! Elle propose des\r\nobjets tressés (paniers, décoration) à la fois utiles, solides et contemporains. Culture d'osier certifiée AB. Stages et animations."
    ],
    "nl": [
      "Coralie rehabiliteert een lokaal en hernieuwbaar materiaal: riet! Ze biedt\r\ngeweven voorwerpen (manden, decoraties) die nuttig, stevig en eigentijds zijn. AB-gecertificeerde rieten kweek. Cursussen en evenementen."
    ],
    "es": [
      "Coralie rehabilita un material local y renovable: ¡el mimbre! Ofrece\r\nobjetos tejidos (cestas, adornos) útiles, sólidos y contemporáneos. Cultivo de mimbre con certificado AB. Cursos y eventos."
    ]
  },
