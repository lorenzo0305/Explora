  "rdfs:comment": {
    "de": [
      "Im Herzen von Orcival, in einem Dekor, das Holzvertäfelungen, Vintage-Rahmen und gemütliche Sitzbänke verbindet, bietet das Restaurant und seine Terrasse einen direkten Blick auf die Basilika. Unsere Küche ist hausgemacht, saisonal und interpretiert die Gerichte der Auvergne neu."
    ],
    "en": [
      "In the heart of Orcival, in a setting combining wood panelling, vintage frames and cosy banquettes, the restaurant and its terrace offer a direct view of the basilica. Our cuisine is entirely homemade, seasonal and revisits Auvergne dishes."
    ],
    "it": [
      "Nel cuore di Orcival, in un ambiente che combina rivestimenti in legno, cornici d'epoca e accoglienti banquette, il ristorante e la sua terrazza offrono una vista diretta sulla basilica. La nostra cucina è interamente casalinga, stagionale e rivisita i piatti dell'Alvernia."
    ],
    "fr": [
      "Au cœur d'Orcival, dans un décor alliant boiseries, cadres vintages et banquettes cosy, le restaurant et sa terrasse offre une vue directe sur la basilique. Notre cuisine est entièrement maison, de saison et revisite les plats auvergnats."
    ],
    "nl": [
      "In het hart van Orcival, in een decor van houten lambrisering, vintage lijsten en gezellige banketten, bieden het restaurant en het terras een direct uitzicht op de basiliek. Onze keuken is volledig huisgemaakt, seizoensgebonden en herneemt gerechten uit de Auvergne."
    ],
    "es": [
      "En el corazón de Orcival, en un marco que combina paneles de madera, marcos de época y banquetas acogedoras, el restaurante y su terraza ofrecen una vista directa de la basílica. Nuestra cocina es totalmente casera, de temporada y revisita los platos de Auvernia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Restaurant Notre Dame"
    ]
  },
