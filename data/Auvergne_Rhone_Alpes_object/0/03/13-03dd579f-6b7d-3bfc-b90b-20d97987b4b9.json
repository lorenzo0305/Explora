  "rdfs:comment": {
    "de": [
      "Die Ateliers des Grands Cèdres bieten Ihnen die Möglichkeit, einen Raum zu mieten und empfangen Sie für die Organisation Ihrer Sitzungen, Direktionsausschüsse, Schulungen, Teambuilding-Sitzungen und kleinen Formen von Firmenseminaren."
    ],
    "en": [
      "Les Ateliers des Grands Cèdres offers room rental and welcomes you to organize your meetings, board meetings, training sessions, team building sessions and small-scale corporate seminars."
    ],
    "it": [
      "Les Ateliers des Grands Cèdres offrono la possibilità di affittare sale e di organizzare riunioni, consigli di amministrazione, corsi di formazione, sessioni di team building e piccoli seminari aziendali."
    ],
    "fr": [
      "Les Ateliers des Grands Cèdres vous proposent une location de salle et vous accueillent pour l’organisation de vos réunions, comités de direction, formations, sessions de team building et petites formes de séminaires d’entreprise."
    ],
    "es": [
      "Les Ateliers des Grands Cèdres ofrece alquiler de salas y puede organizar sus reuniones, juntas directivas, cursos de formación, sesiones de creación de equipos y seminarios corporativos a pequeña escala."
    ],
    "nl": [
      "Les Ateliers des Grands Cèdres biedt zaalverhuur en kan uw vergaderingen, directievergaderingen, trainingen, teambuildingsessies en kleinschalige bedrijfsseminars organiseren."
    ]
  },
