  "rdfs:comment": {
    "de": [
      "In Craponne sur Arzon in der Haute Loire, weit entfernt von den Lichtern der Großstädte (die Stadt schaltet zu diesem Anlass ihre Beleuchtung aus), treffen Sie sich zu diesem 28."
    ],
    "en": [
      "It's in Craponne sur Arzon, in the Haute Loire region, far from the lights of the big cities (the town turns off its lights for the occasion) that you'll find us for these 28th meetings."
    ],
    "it": [
      "È a Craponne sur Arzon, nell'Alta Loira, lontano dalle luci delle grandi città (la città spegne le sue luci per l'occasione) che si ha un appuntamento per questi 28 incontri."
    ],
    "fr": [
      "C’est à Craponne sur Arzon, en Haute Loire, loin des lumières des grandes villes (la ville éteint son éclairage pour l’occasion) que vous avez rendez-vous pour ces 28èmes rencontres."
    ],
    "nl": [
      "Het is in Craponne sur Arzon, in de Haute Loire, ver van de lichten van de grote steden (de stad dooft zijn lichten voor de gelegenheid) dat je een datum hebt voor deze 28e bijeenkomsten."
    ],
    "es": [
      "Es en Craponne sur Arzon, en la Haute Loire, lejos de las luces de las grandes ciudades (el pueblo apaga sus luces para la ocasión), donde tienen lugar estos 28 encuentros."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontres Astronomiques du Printemps"
    ]
  },
