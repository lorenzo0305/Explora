  "rdfs:comment": {
    "de": [
      "Der Versicherer für Privatpersonen und Gewerbetreibende. Die Agentur versichert Ihre Kredite, bietet Online-Banking und Geldanlagen. Drei Agenturen zu Ihrer Verfügung: Tence, Dunières und Yssingeaux"
    ],
    "en": [
      "The insurer for individuals and professionals. The agency insures your loans, and offers online banking and investment services. Three branches at your disposal: Tence, Dunières and Yssingeaux"
    ],
    "it": [
      "L'assicuratore per privati e professionisti. La filiale assicura i vostri prestiti e offre servizi bancari e di investimento online. Tre filiali a vostra disposizione: Tence, Dunières e Yssingeaux"
    ],
    "fr": [
      "L'assureur du particulier comme du professionnel. L'agence assure vos prêts, propose des services de banque en ligne et des placements. Trois agences à votre disposition : Tence, Dunières et Yssingeaux"
    ],
    "es": [
      "La aseguradora para particulares y profesionales. La sucursal asegura sus préstamos y le ofrece servicios bancarios y de inversión en línea. Tres sucursales a su disposición: Tence, Dunières e Yssingeaux"
    ],
    "nl": [
      "De verzekeraar voor zowel particulieren als professionals. Het kantoor verzekert uw leningen en biedt online bankieren en beleggingsdiensten aan. Drie kantoren tot uw beschikking: Tence, Dunières en Yssingeaux"
    ]
  },
  "rdfs:label": {
