  "rdfs:comment": {
    "de": [
      "Unumgängliche Adresse für Liebhaber einer ehrlichen und geselligen Küche. Hier wird alles mit Leidenschaft und Einfachheit hausgemacht und aus lokalen und saisonalen Produkten hergestellt."
    ],
    "en": [
      "Essential address for lovers of sincere and friendly cuisine. Here, everything is homemade, with passion and simplicity, from local and seasonal products."
    ],
    "it": [
      "Una tappa obbligata per gli amanti della cucina sincera e conviviale. Qui tutto è fatto in casa con passione e semplicità, utilizzando prodotti locali e di stagione."
    ],
    "fr": [
      "Adresse incontournable pour les amoureux de cuisine sincère et conviviale. Ici, tout est fait maison, avec passion et simplicité, à partir de produits locaux et de saison."
    ],
    "es": [
      "Una visita obligada para los amantes de la cocina sincera y cordial. Aquí, todo se hace en casa con pasión y sencillez, utilizando productos locales y de temporada."
    ],
    "nl": [
      "Een must voor liefhebbers van de oprechte, gezellige keuken. Hier wordt alles met passie en eenvoud zelfgemaakt, met lokale, seizoensgebonden producten."
    ]
  },
