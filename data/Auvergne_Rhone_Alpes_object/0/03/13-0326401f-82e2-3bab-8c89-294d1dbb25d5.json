  "rdfs:comment": {
    "de": [
      "Familienbauernhof 3 km von Nyons entfernt, biodynamischer Anbau mit Demeter-Zertifizierung, Handpflückungen. Auf dem Bauernhof verkauft: Aprikosenkonfitüre und -nektar, Öl und schwarze Oliven AOP Nyons, Oliven naturbelassen, Olivencreme, frisches Obst in der Saison."
    ],
    "en": [
      "Family farm, 3km from Nyons. Biodynamic (\"Demeter\") culture, hand picking. For sale on site: apricot juice, Nyons' black olives and oil PDO, natural olives, olive cream, fresh seasonal fruit."
    ],
    "it": [
      "Fattoria familiare a 3 km da Nyons, coltivazione biodinamica certificata Demeter, raccolta e vendita a mano in fattoria: marmellata e nettare di albicocche, olio DOP di Nyons e olive nere, olive al naturale, crema di olive, frutta fresca di stagione."
    ],
    "fr": [
      "Ferme familiale à 3km de Nyons, en culture biodynamique certifiée Demeter, cueillettes effectuées à la main,  vendues à la ferme : Confiture et nectar d'abricot, huile et olives noires AOP Nyons, olives au naturel, crème d'olive, fruits frais en saison."
    ],
    "es": [
      "Granja familiar a 3 km de Nyons, cultivo biodinámico certificado Demeter, recogida a mano y venta en la granja: mermelada y néctar de albaricoque, aceite y aceitunas negras DOP de Nyons, aceitunas al natural, crema de aceitunas, fruta fresca de temporada."
    ],
    "nl": [
      "Familieboerderij op 3 km van Nyons, biodynamische teelt, Demeter-certificaat, met de hand geoogst. Verkoop op de boerderij : abrikozennectar, AOP Nyons olie en olijven, natuurlijke olijven, olijvencrème, vers seizoensfruit."
    ]
  },
