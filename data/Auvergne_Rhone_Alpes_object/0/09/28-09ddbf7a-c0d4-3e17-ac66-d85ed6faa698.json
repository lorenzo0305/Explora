  "rdfs:comment": {
    "de": [
      "Entdecken Sie mit Ihrer Familie die naturwissenschaftlichen Sammlungen des Museums anhand der Figuren von Ernest Gallé und Jules Juillet. Der Besuch wird im Garten fortgesetzt, wo die Kinder eingeladen werden, Pflanzen zu sammeln und ihre eigene Herbariumsseite zusammenzustellen, indem sie sich im Schreiben mit der Feder versuchen, um die gesammelten Arten zu benennen."
    ],
    "en": [
      "Bring the whole family to discover the museum's natural science collections through the eyes of Ernest Gallé and Jules Juillet. The visit continues in the garden, where children are invited to collect plants and create their own herbarium page, trying their hand at writing with a pen to name the species they have collected."
    ],
    "it": [
      "Venite a scoprire con la vostra famiglia le collezioni di scienze naturali del museo, attraverso gli occhi di Ernest Gallé e Jules Juillet. La visita proseguirà in giardino, dove i bambini saranno invitati a raccogliere le piante e a creare la propria pagina di erbario, cimentandosi nella scrittura con la penna per dare un nome alle specie raccolte."
    ],
    "fr": [
      "Venez découvrir en famille les collections de sciences naturelles du musée à travers les figures de Ernest Gallé et Jules Juillet. La visite se poursuivra dans le jardin où les enfants seront invités à récolter des végétaux et constituer leur propre page d'herbier, en s'essayant à l'écriture à la plume pour nommer les espèces récoltées."
    ],
    "es": [
      "Venga a descubrir en familia las colecciones de ciencias naturales del museo, a través de los ojos de Ernest Gallé y Jules Juillet. La visita continuará en el jardín, donde se invitará a los niños a recolectar plantas y crear su propia página de herbario, probando a escribir con bolígrafo para nombrar las especies que han recogido."
    ],
    "nl": [
      "Kom met het gezin de natuurwetenschappelijke collecties van het museum ontdekken door de ogen van Ernest Gallé en Jules Juillet. Het bezoek wordt voortgezet in de tuin, waar kinderen worden uitgenodigd om planten te verzamelen en hun eigen herbariumpagina te maken, waarbij ze met een pen kunnen schrijven om de door hen verzamelde soorten een naam te geven."
    ]
  },
