  "rdfs:comment": {
    "de": [
      "Ein 3-Sterne-Hotel im Berg- und Zeitgeist, ideal gelegen in Arc 1600, perfekt für Ihr Abenteuer in unserem Skiort, im Herzen von Paradiski. L'Arcadien steht für den Geist von Les Arcs und seinen Spielplatz: Friendly, fun und familienfreundlich."
    ],
    "en": [
      "A 3-star hotel with a mountain/contemporary feel, ideally located in Arc 1600, perfect for your adventure in our resort, at the heart of Paradiski. L'Arcadien embodies the spirit of Les Arcs and its playground: friendly, fun and family-friendly."
    ],
    "it": [
      "Un hotel 3 stelle dall'atmosfera montana e contemporanea, situato in posizione ideale ad Arc 1600, perfetto per le vostre avventure nella nostra località, nel cuore del Paradiski. L'Arcadien incarna lo spirito di Les Arcs e del suo parco giochi: amichevole, divertente e familiare."
    ],
    "fr": [
      "Un hôtel 3 étoiles à l’esprit montagnard/contemporain idéalement situé à Arc 1600, parfait pour vivre votre aventure dans notre station, au cœur de Paradiski. L’Arcadien c’est l’esprit des Arcs et son terrain de jeu : Friendly, fun et familial."
    ],
    "nl": [
      "Een 3-sterrenhotel met een berg/eigentijdse uitstraling, ideaal gelegen in Arc 1600, perfect voor uw avontuur in ons resort, in het hart van Paradiski. L'Arcadien belichaamt de geest van Les Arcs en zijn speeltuin: vriendelijk, leuk en gezinsvriendelijk."
    ],
    "es": [
      "Contemporáneo, cálido y refinado, el hotel Arcadien tiene todo para seducir a usted y le ofrece toda la comodidad que usted tiene derecho a esperar un host 3 étoilesl renovado."
    ]
  },
