  "rdfs:comment": {
    "de": [
      "Nicolas, ein passionierter Falkner, lädt Sie mit einer Vorführung von frei fliegenden Vögeln ein, die Falknerei zu entdecken; eine Disziplin, die seit 2010 von der UNESCO zum immateriellen Kulturerbe der Menschheit erklärt wurde."
    ],
    "en": [
      "Nicolas, a passionate falconer, invites you to discover falconry through a demonstration of free-flying birds; a discipline classified as intangible heritage of humanity by UNESCO since 2010."
    ],
    "it": [
      "Nicolas, appassionato falconiere, vi invita a scoprire la falconeria attraverso una dimostrazione di volo libero degli uccelli; una disciplina classificata come patrimonio immateriale dell'umanità dall'UNESCO dal 2010."
    ],
    "fr": [
      "Nicolas, fauconnier passionné, vous invite à travers une démonstration d’oiseaux en vols libres à découvrir la Fauconnerie ; une discipline classée au patrimoine immatériel de l’humanité par l’UNESCO depuis 2010."
    ],
    "nl": [
      "Nicolas, een gepassioneerd valkenier, nodigt u uit om de valkerij te ontdekken aan de hand van een demonstratie van vrij vliegende vogels; een discipline die sinds 2010 door de UNESCO als immaterieel erfgoed van de mensheid is geclassificeerd."
    ],
    "es": [
      "Nicolas, cetrero apasionado, le invita a descubrir la cetrería a través de una demostración de vuelo libre de aves; una disciplina clasificada como patrimonio inmaterial de la humanidad por la UNESCO desde 2010."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de rapaces"
    ]
  },
