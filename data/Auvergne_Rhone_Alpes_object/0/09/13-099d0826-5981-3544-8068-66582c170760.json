  "rdfs:comment": {
    "de": [
      "Machen Sie einen Tagesausflug mit dem Bus, um Turin und Susa auf eigene Faust zu erkunden. Entdecken Sie die piemontesische Hauptstadt, die für ihren Porta-Palazzo-Markt, ihren Barockstil, ihre Plätze und Museen bekannt ist? Auf dem Rückweg können Sie Ihre Shoppingtour mit einem Stopp in Susa abschließen."
    ],
    "en": [
      "Take a full-day coach tour of Turin and Susa. Discover the Piedmontese capital known for its Porta Palazzo market, its Baroque style, its squares and museums... On the way back, you can conclude your shopping with a stop in Susa."
    ],
    "it": [
      "Fate una gita di un giorno in pullman per visitare Torino e Susa. Scoprite il capoluogo piemontese, famoso per il mercato di Porta Palazzo, lo stile barocco, le piazze e i musei? Al ritorno, potrete concludere il vostro shopping con una sosta a Susa."
    ],
    "fr": [
      "Partez en car sur une journée visiter librement Turin et Suse. Découvrez la capitale piémontaise connue pour son marché de la Porta Palazzo, son style baroque, ses places et musées… Au retour, vous pourrez conclure votre shopping lors d'un arrêt à Suse."
    ],
    "nl": [
      "Maak een dagtocht per bus naar Turijn en Susa. Ontdek de hoofdstad van Piemonte, beroemd om zijn Porta Palazzo markt, zijn barokke stijl, zijn pleinen en musea? Op de terugweg kun je je shopping afronden met een stop in Susa."
    ],
    "es": [
      "Haga una excursión de un día en autocar para visitar Turín y Susa. Descubra la capital del Piamonte, famosa por su mercado de Porta Palazzo, su estilo barroco, sus plazas y museos? A la vuelta, puede completar sus compras con una parada en Susa."
    ]
  },
