  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7db3b042-a041-32a5-a04d-d14f3d929af1",
      "dc:description": {
        "de": [
          "Gesellige Bar in der Nähe des Cinos Busbahnhof und Parkplatz ist 300m vom Strand entfernt\n\nUnd außerdem: Herzliche Atmosphäre, in der sich die Stammgäste zum ersten Kaffee/Tagesaperitif treffen\n1. Bar, die morgens am Strand geöffnet ist jkour le café (7.30 Uhr)"
        ],
        "en": [
          "Friendly bar close to Cinos bus station and parking lot 300m from the beach\n\nPlus: warm atmosphere where regulars meet for the first coffee/appetizer day\n1st bar open in the morning in the jkour le café beach area (7:30 a.m.)"
        ],
        "it": [
          "Bar accogliente vicino alla stazione degli autobus di Cinos e al parcheggio a 300 m dalla spiaggia\n\nE ancora: Atmosfera calorosa dove gli habitué si incontrano per il primo caffè/aperitivo del giorno\n1° bar aperto al mattino nella zona della spiaggia jkour le café (7.30)"
        ],
        "fr": [
          "Bar convivial à proximité du Cinos gare routière et parking est à 300m de la plage\n\nEt plus: Ambiance chaleureuse ou les habitués se retrouvent les premiers café/jour d'apéro\n1 er bar ouvert le matin sur le secteur de la plage jkour le café (7h30)"
        ],
        "nl": [
          "Vriendelijke bar vlakbij het busstation en de parkeerplaats van Cinos op 300 meter van het strand\n\nEn meer: Warme sfeer waar stamgasten elkaar ontmoeten voor de eerste koffie/aperitiefdag\n1e bar 's ochtends geopend in het strandgedeelte jkour le café (7.30 uur)"
        ],
        "es": [
          "Bar acogedor cerca de la estación de autobuses de Cinos y del aparcamiento a 300 m de la playa\n\nY más: ambiente cálido donde los habituales se reúnen para el primer café/appetitivo del día\n1er bar abierto por la mañana en la zona de la playa jkour le café (7h30)"
        ]
      },
