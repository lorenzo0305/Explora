  "rdfs:comment": {
    "de": [
      "Im Kreativviertel Manufacture (die ehemalige Waffenfabrik) erwachen die Gebäude nach einigen Jahren des Brachliegens zu neuem Leben und werden zu einem nonkonformistischen Rahmen: La Fabuleuse cantine!"
    ],
    "en": [
      "In the Manufacture creative district (the former Manufacture d'armes), the buildings are being brought back to life after a few years as a wasteland, and have become a non-conformist setting: La Fabuleuse cantine!"
    ],
    "it": [
      "Nel quartiere creativo della Manufacture (l'ex Manufacture d'armes), gli edifici stanno tornando a vivere dopo alcuni anni di abbandono e sono diventati un ambiente anticonformista: La Fabuleuse cantine!"
    ],
    "fr": [
      "Dans le quartier créatif Manufacture (l’ancienne Manufacture d’armes), le bâti reprend vie après quelques années de friches et devient un cadre anticonformiste : La Fabuleuse cantine !"
    ],
    "nl": [
      "In de creatieve wijk Manufacture (de voormalige Manufacture d'armes) komen de gebouwen na een paar jaar braakliggend terrein weer tot leven en zijn ze een non-conformistisch decor geworden: La Fabuleuse cantine!"
    ],
    "es": [
      "En el barrio creativo de Manufacture (antigua Manufacture d'armes), los edificios vuelven a la vida tras unos años como descampados, y se han convertido en un escenario inconformista: ¡La Fabuleuse cantine!"
    ]
  },
