  "rdfs:comment": {
    "de": [
      "Leckere Gerichte auf Gemüsebasis. Freude für Augen und Gaumen in einem gemütlichen Ambiente. Lassen Sie sich überraschen! Tapas-Abende."
    ],
    "en": [
      "Tasty home-made vegetarian cooking. It's a pleasure to see and a pleasure to taste, in a warm and intimate setting. Let yourself be tempted by this experience \r\n- you may be agreeably surprised! Theme menus: tapas evenings."
    ],
    "it": [
      "Cucina casalinga, a base vegetale, gustosa, fresca e con prodotti locali!\r\nUna festa per gli occhi e per le papille gustative, in un ambiente caldo e accogliente.\r\nLasciatevi tentare da questa esperienza! Potreste rimanere sorpresi!"
    ],
    "fr": [
      "Cuisine maison, végétale, gustative, produits frais, locaux !\r\nPlaisir pour les yeux et les papilles, dans un cadre cosy et chaleureux. \r\nLaissez-vous tenter par cette expérience ! Vous pourriez être surpris !!!"
    ],
    "es": [
      "Productos caseros, vegetales, sabrosos, frescos y locales\r\nUn festín para la vista y el paladar, en un ambiente cálido y acogedor.\r\nDéjese seducir por esta experiencia Le sorprenderá"
    ],
    "nl": [
      "Huisgemaakte vegetarische en smaakvolle keuken: een plezier voor de ogen en de smaakpapillen. Laat u zich hier, in een gezellige en warme setting, verleiden door deze ervaring, en u zult aangenaam verrast zijn! Themamenu’s: Tapas-avonden."
    ]
  },
