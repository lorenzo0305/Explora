  "rdfs:comment": {
    "de": [
      "Ihre Agentur empfängt Sie für alle Ihre Immobilienprojekte im Herzen des Drôme-Tals: Kauf, Verkauf, Vermietung und Gutachten zum Immobilienwert. Unser Team von Fachleuten steht Ihnen jederzeit zur Verfügung."
    ],
    "en": [
      "Your agency welcomes you for all your real estate projects in the heart of the Drôme Valley: buying, selling, renting and property appraisals. Our team of professionals is at your service."
    ],
    "it": [
      "La vostra agenzia vi accoglie per tutti i vostri progetti immobiliari nel cuore della Valle della Drôme: acquisto, vendita, affitto e valutazioni immobiliari. Il nostro team di professionisti è a vostra disposizione."
    ],
    "fr": [
      "Votre agence vous accueille pour tous vos projets immobiliers au cœur de la Vallée de la Drôme : achat, vente, location et expertises en valeur immobilière. Notre équipe de professionnels est à votre écoute."
    ],
    "nl": [
      "Uw makelaarskantoor kan u helpen bij al uw vastgoedprojecten in het hart van de Drômevallei: kopen, verkopen, verhuren en taxeren. Ons team van professionals staat tot uw dienst."
    ],
    "es": [
      "Su agencia le da la bienvenida para todos sus proyectos inmobiliarios en el corazón del Valle de la Drôme: compra, venta, alquiler y peritajes inmobiliarios. Nuestro equipo de profesionales está a su disposición."
    ]
  },
