  "rdfs:comment": {
    "de": [
      "Entdecken Sie das erste große Meisterwerk der Menschheit, das auf das Jahr vor 36.000 Jahren datiert wird. In einem 15 Hektar großen bewaldeten Park gibt die Chauvet-Höhle 2 - Ardèche, die größte Nachbildung einer Höhle der Welt, den Zauber der Chauvet-Höhle wieder, die zum UNESCO-Weltkulturerbe gehört."
    ],
    "en": [
      "Discover mankind's first great masterpiece, dating back 36,000 years. Set in a 15-hectare wooded park, Grotte Chauvet 2 - Ardèche, the world's largest replica of a cave, recreates the magic of the UNESCO-listed Chauvet cave."
    ],
    "it": [
      "Scoprite il primo grande capolavoro dell'umanità, risalente a 36.000 anni fa. Immersa in 15 ettari di parco alberato, la Grotte Chauvet 2 - Ardèche, la più grande riproduzione di una grotta al mondo, ricrea la magia della grotta Chauvet, dichiarata dall'UNESCO."
    ],
    "fr": [
      "Découvrez le premier grand chef-d'œuvre de l'Humanité, daté d'il y a 36.000 ans. Dans un parc boisé de 15 hectares, la grotte Chauvet 2 - Ardèche, plus grande réplique de grotte ornée au monde, restitue la magie de la grotte Chauvet, inscrite à l’UNESCO."
    ],
    "nl": [
      "Ontdek het eerste grote meesterwerk van de mensheid, dat dateert van 36.000 jaar geleden. Grotte Chauvet 2 - Ardèche, 's werelds grootste replica van een grot, ligt in 15 hectare bebost park en recreëert de magie van de Chauvet-grot die op de UNESCO-lijst staat."
    ],
    "es": [
      "Descubra la primera gran obra maestra de la humanidad, que data de hace 36.000 años. Situada en un parque arbolado de 15 hectáreas, la Grotte Chauvet 2 - Ardèche, la mayor réplica de una cueva del mundo, recrea la magia de la cueva de Chauvet, declarada Patrimonio de la Humanidad por la UNESCO."
    ]
  },
