  "rdfs:comment": {
    "de": [
      "Dieses Reitzentrum liegt 10 Minuten außerhalb des Ballungsraums Montluçon am Fuße des Combrailles-Massivs und unterrichtet Reiten, bietet Ausritte, Praktika, Pension und Arbeit mit Pferden, Beritt."
    ],
    "en": [
      "Located 10 minutes from Montluçon, at the foot of the Combrailles mountains, this equestrian center teaches riding, offers rides, training courses, horse boarding and work, and breaking-in."
    ],
    "it": [
      "Situato a 10 minuti da Montluçon, ai piedi delle montagne di Combrailles, questo centro ippico insegna l'equitazione e offre cavalcate, corsi, pensione, addestramento e rodaggio dei cavalli."
    ],
    "fr": [
      "Situé à  10 min de l'agglomération de Montluçon, au pied du massif des Combrailles., ce centre équestre enseigne l'équitation, propose des promenades, stages, pension et travail des chevaux, débourrage."
    ],
    "es": [
      "Situado a 10 minutos de Montluçon, a los pies de las montañas Combrailles, este centro ecuestre enseña a montar a caballo y ofrece paseos, cursos, pupilaje, entrenamiento y doma de caballos."
    ],
    "nl": [
      "Deze manege ligt op 10 minuten van Montluçon, aan de voet van het Combrailles-gebergte, en geeft les in paardrijden en biedt ritten, cursussen, pensionstalling, paardentraining en inrijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre équestre L'étrier de Villebret"
    ]
  },
