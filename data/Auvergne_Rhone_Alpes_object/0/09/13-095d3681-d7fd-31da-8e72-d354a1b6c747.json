  "rdfs:comment": {
    "de": [
      "Im Zentrum des historischen Dorfes, in der Nähe des Eingangs zum botanischen Garten La Jaysinia, empfangen wir Sie im Winter in einem rustikalen, bergischen Interieur und im Sommer auf unserer schattigen Terrasse."
    ],
    "en": [
      "In the centre of the historic village, close to the entrance of the La Jaysinia botanical garden, we welcome you in winter in a rustic and mountainous interior and in summer on our shaded terrace."
    ],
    "it": [
      "Nel centro del borgo storico, vicino all'ingresso del giardino botanico La Jaysinia, vi accogliamo in inverno nei nostri interni rustici in stile montano e in estate nella nostra terrazza ombreggiata."
    ],
    "fr": [
      "Au centre du village historique, à proximité de l'entrée du jardin botanique de La Jaysinia, nous vous accueillons l'hiver dans un intérieur rustique et montagnard et l'été sur notre terrasse ombragée."
    ],
    "nl": [
      "In het centrum van het historische dorp, dicht bij de ingang van de botanische tuin van La Jaysinia, verwelkomen wij u in de winter in een rustiek en bergachtig interieur en in de zomer op ons schaduwrijke terras."
    ],
    "es": [
      "En el centro del pueblo histórico, cerca de la entrada al jardín botánico La Jaysinia, le damos la bienvenida en invierno a nuestro interior rústico de estilo montañés y en verano a nuestra terraza a la sombra."
    ]
  },
