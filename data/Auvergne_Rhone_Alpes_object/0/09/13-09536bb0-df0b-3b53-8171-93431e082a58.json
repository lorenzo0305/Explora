  "rdfs:comment": {
    "de": [
      "La Main Heureuse, sich einen Moment der Pflege und Entspannung gönnen, dank verschiedener Techniken und manueller Praktiken der Entspannung und des Wohlbefindens empfangen. Nach Vereinbarung."
    ],
    "en": [
      "La Main Heureuse, treat yourself to a moment of care and relaxation, receive through various techniques and manual practices of relaxation and well-being. By appointment only."
    ],
    "it": [
      "La Main Heureuse, regalatevi un momento di cura e relax, ricevete grazie a diverse tecniche e pratiche manuali di rilassamento e benessere. Solo su appuntamento."
    ],
    "fr": [
      "La Main Heureuse, s'offrir un moment de soin et de détente, recevoir grâce à différentes techniques et pratiques manuelles de la détente et du bien-être. Sur rendez-vous."
    ],
    "nl": [
      "La Main Heureuse, trakteer jezelf op een moment van verwennerij en ontspanning, met behulp van een reeks manuele technieken en praktijken om ontspanning en welzijn te bevorderen. Alleen op afspraak."
    ],
    "es": [
      "La Main Heureuse, ofrézcase un momento de cuidados y relajación, reciba gracias a diferentes técnicas y prácticas manuales de relajación y bienestar. Sólo con cita previa."
    ]
  },
  "rdfs:label": {
    "de": [
