  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Spa Montagnes du Monde, einen wahren Kokon aus Authentizität und Modernität in der MGM-Residenz, wo jeder Augenblick darauf ausgerichtet ist, Ihnen eine unvergleichliche Entspannung zu bieten."
    ],
    "en": [
      "Discover the Montagnes du Monde Spa, a veritable cocoon combining authenticity and modernity within the MGM residence, where every moment is designed to offer you incomparable relaxation."
    ],
    "it": [
      "Scoprite la Montagnes du Monde Spa, un vero e proprio bozzolo che unisce autenticità e modernità all'interno della residenza MGM, dove ogni momento è pensato per offrirvi un relax incomparabile."
    ],
    "fr": [
      "Découvrez le Spa Montagnes du Monde, un véritable cocon mêlant authenticité et modernité au sein de la résidence MGM, où chaque instant est pensé pour vous offrir une détente incomparable."
    ],
    "nl": [
      "Ontdek de Montagnes du Monde Spa, een ware cocon die authenticiteit en moderniteit combineert binnen de MGM residentie, waar elk moment is ontworpen om je een onvergelijkbare ontspanning te bieden."
    ],
    "es": [
      "Descubra el Spa Montagnes du Monde, un verdadero capullo que combina autenticidad y modernidad dentro de la residencia MGM, donde cada momento está diseñado para ofrecerle una relajación incomparable."
    ]
  },
