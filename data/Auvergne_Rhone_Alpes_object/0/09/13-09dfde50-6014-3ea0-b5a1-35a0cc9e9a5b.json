  "rdfs:comment": {
    "de": [
      "Afterworks mit einer SBK-Party? Salsa, Bachata, Kizomba\r\n\r\nKomm auf ein Getränk, iss Sushi, genieße die Vereinsbar und tanze zu einer heißen Atmosphäre, die von unserem DJ gemixt wird."
    ],
    "en": [
      "Afterworks with an SBK evening ? Salsa, Bachata, Kizomba\r\n\r\nCome and have a drink, eat sushi, enjoy the bar and dance to a caliente atmosphere mixed by our DJ."
    ],
    "it": [
      "Afterworks con una serata SBK? Salsa, Bachata, Kizomba\r\n\r\nVenite a bere qualcosa, a mangiare sushi, a godervi il bar e a ballare in un'atmosfera caliente mixata dal nostro DJ."
    ],
    "fr": [
      "Afterworks avec une soirée SBK — Salsa, Bachata, Kizomba \r\n\r\nViens boire un verre, manger des sushis, profiter du bar associatif et danser sur une ambiance caliente mixée par notre DJ."
    ],
    "nl": [
      "Afterworks met een SBK avond ? Salsa, Bachata, Kizomba\r\n\r\nKom wat drinken, eet wat sushi, geniet van de bar en dans op een caliente sfeer gemixt door onze DJ."
    ],
    "es": [
      "Afterworks con una velada SBK ? Salsa, Bachata, Kizomba\r\n\r\nVen a tomar una copa, comer sushi, disfrutar del bar y bailar en un ambiente caliente mezclado por nuestro DJ."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeudi Oui! - Soirée SBK & Fête du court métrage"
    ]
  },
