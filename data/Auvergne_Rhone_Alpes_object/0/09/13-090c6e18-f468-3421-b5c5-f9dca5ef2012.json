  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen des Haut-Bréda-Tals im Belledonne-Massiv.\r\nLe Madame ist ein charmantes Hotel, das dank seiner Lage und der atemberaubenden Aussicht auf die Berge zum Abschalten einlädt.\r\nNeu: Spa & Wellness ab Dezember 2025."
    ],
    "en": [
      "Hotel located in the heart of the Haut-Bréda Valley, in the Belledonne region.\r\nOpen since January 2023.\r\n22 rooms with a capacity of 63 people.\r\nSwimming pool and breathtaking views of the peaks.\r\nLocated 10 minutes' drive from Les 7 Laux."
    ],
    "it": [
      "Hotel situato nel cuore della Valle dell'Haut-Bréda, nel Massiccio di Belledonne.\r\nLe Madame, un hotel di charme, è un invito a rilassarsi, grazie alla sua posizione e alla vista mozzafiato sulle montagne.\r\nNovità: Spa & Benessere da dicembre 2025."
    ],
    "fr": [
      "Hôtel situé en plein cœur de la Vallée du Haut-Bréda, dans le Massif de Belledonne.\r\nLe Madame, hôtel de charme, est un appel à la déconnexion grâce à sa localisation et la vue imprenable sur les montagnes.\r\nNouveau : Spa & Bien-être dès décembre 2025."
    ],
    "es": [
      "Hotel situado en el corazón del valle de Haut-Bréda, en el macizo de Belledonne.\r\nLe Madame, un hotel con encanto, invita a desconectar gracias a su ubicación y a sus impresionantes vistas a la montaña.\r\nNovedad: Spa & Bienestar a partir de diciembre de 2025."
    ],
    "nl": [
      "Hotel gelegen in het hart van de Haut-Bréda vallei, in de regio Belledonne.\r\nOpen sinds januari 2023.\r\n22 kamers met een capaciteit van 63 personen.\r\nZwembad en adembenemend uitzicht op de bergtoppen.\r\nGelegen op 10 minuten rijden van Les 7 Laux."
    ]
  },
