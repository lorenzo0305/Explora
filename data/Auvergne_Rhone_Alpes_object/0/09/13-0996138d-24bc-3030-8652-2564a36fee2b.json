  "rdfs:comment": {
    "de": [
      "Semi-gastronomisches Restaurant, savoyische Spezialitäten, Tagesgericht. Freundliche Atmosphäre und Familie."
    ],
    "en": [
      "Semi-gastronomic restaurant, Savoyard specialties, dish of the day. Friendly atmosphere and family."
    ],
    "it": [
      "Thomas e Maxime vi propongono tutto l'anno una cucina di breve durata. Cucina casalinga. Pranzo e cena con menù tradizionale, ampia scelta di birre, cocktail e vini"
    ],
    "fr": [
      "Thomas et Maxime vous proposent une cuisine autour du circuit court durant toute l’année. Cuisine fait maison. Midi et soir carte traditionnelle, large choix de bières, cocktails et vins"
    ],
    "es": [
      "Thomas y Maxime le ofrecen cocina de corta duración durante todo el año. Cocina casera. Almuerzo y cena menú tradicional, amplia selección de cervezas, cócteles y vinos"
    ],
    "nl": [
      "Thomas en Maxime bieden je het hele jaar door een korte keuken. Huisgemaakte gerechten. Traditioneel lunch- en dinermenu, ruime keuze aan bieren, cocktails en wijnen"
    ]
  },
