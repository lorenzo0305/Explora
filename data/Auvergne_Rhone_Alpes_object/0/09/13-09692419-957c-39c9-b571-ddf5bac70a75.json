  "rdfs:comment": {
    "de": [
      "Das Kino Le Clos hat ein sehr vielseitiges Programm an Filmvorführungen. Sein einzigartiger Saal bietet Platz für 150 Personen."
    ],
    "en": [
      "The Le Clos cinema has a very eclectic range of film screenings. It has a single room which can hold 150 people."
    ],
