  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes, nur wenige Schritte von der Eislaufbahn entfernt, entdecken Sie das Carnotzet!\r\nIn einem renovierten Rahmen und einem neuen Ambiente genießen Sie unsere savoyischen Spezialitäten und unsere ausgefeilte traditionelle Küche."
    ],
    "en": [
      "New restaurant: located in the village center, nearby the ice rink, discover a new address : \"Le Carnotzet\"\r\nFrench and local specialties, and traditionnal meals in a new atmosphere."
    ],
    "it": [
      "ristorante, bar. Cucina tradizionale e specialità: Menu alla carta e menu diversificati."
    ],
    "fr": [
      "Au centre du village, à deux pas de la patinoire, découvrez le Carnotzet ! \r\nDans un cadre rénové et une nouvelle ambiance, profitez de nos spécialités savoyardes et de notre cuisine traditionnelle élaborée."
    ],
    "nl": [
      "Ontdek in het centrum van het dorp, op een steenworp afstand van de ijsbaan, de Carnotzet!\r\nIn een gerenoveerd kader en een nieuwe sfeer kunt u genieten van onze Savoyaardse specialiteiten en onze uitgebreide traditionele keuken."
    ],
    "es": [
      "En el centro del pueblo, a dos pasos de la pista de hielo, ¡descubra el Carnotzet!\r\nEn un marco renovado y un nuevo ambiente, disfrute de nuestras especialidades saboyanas y de nuestra elaborada cocina tradicional."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant: Carnotzet"
    ],
