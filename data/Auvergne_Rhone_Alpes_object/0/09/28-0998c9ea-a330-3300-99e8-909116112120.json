  "rdfs:comment": {
    "de": [
      "Die Familie Piron stellt seit sieben Generationen in Godewaersvelde Stoffe her. Entdecken Sie im Fabrikladen Tausende von Ideen, Farben und Texturen im Dienste Ihrer Fantasie."
    ],
    "en": [
      "The Piron family has been making fabric for 7 generations in Godewaersvelde. Discover thousands of ideas, colors and textures for your imagination in the factory store."
    ],
    "it": [
      "La famiglia Piron produce tessuti da 7 generazioni a Godewaersvelde. Scoprite migliaia di idee, colori e tessuti per la vostra immaginazione nel negozio della fabbrica."
    ],
    "fr": [
      "La famille Piron fabrique du tissu depuis 7 générations à Godewaersvelde. Découvrez dans le magasin d'usine, des milliers d'idées, de couleurs, de textures au service de votre imagination."
    ],
    "es": [
      "La familia Piron lleva 7 generaciones fabricando tejidos en Godewaersvelde. Descubre miles de ideas, colores y texturas para tu imaginación en la tienda de la fábrica."
    ],
    "nl": [
      "De familie Piron maakt al 7 generaties lang stoffen in Godewaersvelde. Ontdek duizenden ideeën, kleuren en texturen voor uw verbeelding in de fabriekswinkel."
    ]
  },
