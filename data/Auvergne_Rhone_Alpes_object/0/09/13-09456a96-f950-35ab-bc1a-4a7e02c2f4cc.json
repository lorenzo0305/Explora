  "rdfs:comment": {
    "de": [
      "In den prestigeträchtigen Räumlichkeiten des ehemaligen Bischofspalastes können Sie eine außergewöhnliche Sammlung mauritianischer Trachten entdecken. Das Museum zeigt außerdem Werkzeuge und Utensilien aus dem Alltagsleben von früher."
    ],
    "en": [
      "Within the prestigious walls of the former episcopal palace, you'll discover an exceptional collection of Maurienne costumes. The museum also displays tools and utensils from everyday life in bygone days."
    ],
    "it": [
      "Tra le prestigiose mura dell'ex palazzo episcopale, scoprirete un'eccezionale collezione di costumi della Maurienne. Il museo espone anche strumenti e utensili utilizzati nella vita quotidiana di un tempo."
    ],
    "fr": [
      "Dans l'enceinte prestigieuse de l’ancien palais épiscopal vous découvrirez une collection exceptionnelle de costumes mauriennais. Le Musée présente également des outils et des ustensiles de la vie courante d'autrefois."
    ],
    "es": [
      "Dentro de los prestigiosos muros del antiguo palacio episcopal, descubrirá una excepcional colección de trajes maurienses. El museo también expone herramientas y utensilios utilizados en la vida cotidiana de antaño."
    ],
    "nl": [
      "Binnen de prestigieuze muren van het voormalige bisschoppelijk paleis ontdek je een uitzonderlijke collectie Mauriennekostuums. Het museum toont ook gereedschappen en gebruiksvoorwerpen die vroeger in het dagelijks leven werden gebruikt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of Popular Costumes, Arts and Traditions"
    ],
    "fr": [
      "Musée des Costumes, Arts et Traditions Populaires"
    ]
  },
