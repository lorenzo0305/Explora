  "rdfs:comment": {
    "de": [
      "Von Mai bis September bietet Ihnen unser Restaurant mittags und abends einen Service im Freien oder im Haus oder zum Mitnehmen (je nach Karte und Saison). Wählen Sie Ihre Mahlzeit aus einer großen Auswahl an Pizzas, Gerichten und gemischten Salaten."
    ],
    "en": [
      "From May to September, our restaurant offers you a lunch and dinner service for 100 to 120 people outside or inside, on site or take away (according to the menu). Choose your meal from a wide choice of pizzas, dishes and mixed salads."
    ],
    "it": [
      "Da maggio a settembre, il nostro ristorante offre un servizio di pranzo e cena all'aperto o all'interno, oppure da asporto (a seconda del menu e della stagione). Scegliete il vostro pasto tra un'ampia selezione di pizze, secondi piatti e insalate miste."
    ],
    "fr": [
      "De mai à septembre, notre restaurant vous offre un service midi et soir en extérieur, ou intérieur, ou à emporter (selon cartes et la saison). Choisissez votre repas parmi un large choix de pizzas, de plats, de salades composées."
    ],
    "nl": [
      "Van mei tot september kun je in ons restaurant buiten of binnen lunchen en dineren, of afhalen (afhankelijk van het menu en het seizoen). Kies je maaltijd uit een ruime selectie pizza's, hoofdgerechten en gemengde salades."
    ],
    "es": [
      "De mayo a septiembre, nuestro restaurante ofrece servicio de comidas y cenas al aire libre o en el interior, o para llevar (según el menú y la temporada). Elija su comida entre una amplia selección de pizzas, platos principales y ensaladas variadas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant du Camping du Viaduc des Fades"
    ],
