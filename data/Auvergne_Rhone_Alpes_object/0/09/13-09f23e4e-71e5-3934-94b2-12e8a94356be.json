  "rdfs:comment": {
    "de": [
      "Heute erstreckt sich die Domaine le Garrigon über 80 Hektar von Tulette bis Visan und produziert Weine mit kontrollierter Herkunftsbezeichnung (AOC), Côtes du Rhône und Côtes du Rhône Villages."
    ],
    "en": [
      "Today, Domaine le Garrigon extends over 80 hectares from Tulette to Visan, and produces AOC (Appellation d'Origine Contrôlée) Côtes du Rhône and Côtes du Rhône Villages wines."
    ],
    "it": [
      "Oggi il Domaine le Garrigon si estende su 80 ettari da Tulette a Visan e produce vini AOC, Côtes du Rhône e Côtes du Rhône Villages."
    ],
    "fr": [
      "Aujourd’hui, le Domaine le Garrigon s’étend sur 80 hectares depuis Tulette jusqu’à Visan et produit des vins d’appellation d’origine contrôlée (AOC), Côtes du Rhône et Côtes du Rhône Villages."
    ],
    "nl": [
      "Vandaag de dag strekt Domaine le Garrigon zich uit over 80 hectare van Tulette tot Visan en produceert het Côtes du Rhône en Côtes du Rhône Villages AOC-wijnen."
    ],
    "es": [
      "En la actualidad, el Domaine le Garrigon abarca 80 hectáreas desde Tulette hasta Visan y produce vinos AOC, Côtes du Rhône y Côtes du Rhône Villages."
    ]
  },
