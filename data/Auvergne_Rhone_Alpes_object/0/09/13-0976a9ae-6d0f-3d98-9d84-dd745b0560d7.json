  "rdfs:comment": {
    "de": [
      "Unser 3,5 ha großes Weingut liegt in den Ausläufern der Monts du Forez auf fast 500 m Höhe. Eine unserer Terrassenparzellen liegt auf dem Montaubourg, einem der ältesten Vulkane Europas (60 Millionen Jahre)."
    ],
    "en": [
      "Our 3.5 ha estate is located in the foothills of the Monts du Forez, at an altitude of almost 500 m. One of our terraced plots is located on Montaubourg, one of Europe's oldest volcanoes (60 million years old)."
    ],
    "it": [
      "La nostra tenuta di 3,5 ettari è situata ai piedi dei Monts du Forez, a un'altitudine di quasi 500 metri. Uno dei nostri appezzamenti terrazzati si trova sul Montaubourg, uno dei vulcani più antichi d'Europa (60 milioni di anni)."
    ],
    "fr": [
      "Notre Domaine de 3,5 ha est situé sur les contreforts des Monts du Forez, à presque 500 m d’altitude. Une de nos parcelles ; en terrasses ; est située sur le Montaubourg, un des plus vieux volcan d'Europe (60 millions d'années)."
    ],
    "nl": [
      "Ons landgoed van 3,5 hectare ligt aan de voet van de Monts du Forez, op een hoogte van bijna 500 meter. Een van onze terrasvormige percelen ligt op Montaubourg, een van de oudste vulkanen van Europa (60 miljoen jaar oud)."
    ],
    "es": [
      "Nuestra finca de 3,5 hectáreas está situada en las estribaciones de los Monts du Forez, a casi 500 metros de altitud. Una de nuestras parcelas en terrazas se encuentra en Montaubourg, uno de los volcanes más antiguos de Europa (60 millones de años)."
    ]
  },
