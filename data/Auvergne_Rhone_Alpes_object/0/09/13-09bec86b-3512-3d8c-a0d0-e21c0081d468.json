  "rdfs:comment": {
    "de": [
      "Lumières d'Ateliers, am Place du Mazel in Brioude gelegen, ist ein Vereinsladen für Kunsthandwerker. Die Boutique wird von der gleichnamigen Vereinigung betrieben und umfasst etwa 15 Kunsthandwerker aus den Regionen Haute-Loire, Puy de Dôme und Cantal."
    ],
    "en": [
      "Lumières d'Ateliers, located on Place du Mazel in Brioude, is a community store for craftspeople. The store is run by the association of the same name, and brings together some fifteen artisans from Haute-Loire, Puy de Dôme and Cantal."
    ],
    "it": [
      "Lumières d'Ateliers, situato in Place du Mazel a Brioude, è un negozio comunitario per artigiani. Il negozio è gestito dall'associazione omonima e riunisce una quindicina di artigiani delle regioni dell'Alta Loira, del Puy de Dôme e del Cantal."
    ],
    "fr": [
      "Lumières d'Ateliers, située place du Mazel à Brioude, est une boutique associative d'artisans. La boutique est gérée par l'association du même nom et regroupe une quinzaine d'artisans, issus de Haute-Loire, du Puy de Dôme et du Cantal."
    ],
    "es": [
      "Lumières d'Ateliers, situada en la Place du Mazel de Brioude, es una tienda comunitaria para artesanos. Dirigida por la asociación del mismo nombre, reúne a una quincena de artesanos de las regiones de Alto Loira, Puy de Dôme y Cantal."
    ],
    "nl": [
      "Lumières d'Ateliers, gelegen aan de Place du Mazel in Brioude, is een buurtwinkel voor ambachtslieden. De winkel wordt gerund door de gelijknamige vereniging en verenigt een vijftiental ambachtslieden uit de Haute-Loire, Puy de Dôme en Cantal."
    ]
  },
