  "rdfs:comment": {
    "de": [
      "Bei der Ankunft am Sessellift von Pré la Joux beginnt die Route genau gegenüber, einige Meter weiter, direkt vor Ihnen.\r\nDer Weg führt fast 2 km lang die Schlucht hinauf, die den Beinamen Happy Valley trägt."
    ],
    "en": [
      "At the arrival point of the Pré la Joux chairlift, the route starts directly opposite, a few metres ahead.\nIt runs for almost 2 km up the combe known as Happy Valley."
    ],
    "it": [
      "Arrivati alla seggiovia di Pré la Joux, il percorso inizia proprio di fronte, pochi metri più avanti.\r\nIl percorso si snoda per quasi 2 km lungo la combe denominata Happy Valley."
    ],
    "fr": [
      "À l’arrivée du télésiège de Pré la Joux, l’itinéraire démarre pile en face, quelques mètres plus loin, droit devant.\r\nIl remonte la combe surnommée Happy Valley sur près de 2 km."
    ],
    "nl": [
      "Als je aankomt bij de stoeltjeslift Pré la Joux, begint de route er recht tegenover, een paar meter verderop.\nDe route slingert zich bijna 2 km lang een weg omhoog door de combe die bekend staat als Happy Valley."
    ],
    "es": [
      "Al llegar al telesilla de Pré la Joux, la ruta comienza justo enfrente, unos metros más adelante.\r\nSerpentea por la combe conocida como Happy Valley durante casi 2 km."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski touring trail Happy Valley"
    ],
    "fr": [
      "Itinéraire de ski de randonnée Happy Valley"
    ],
    "nl": [
      "Toerskiroute Happy Valley"
    ]
  },
