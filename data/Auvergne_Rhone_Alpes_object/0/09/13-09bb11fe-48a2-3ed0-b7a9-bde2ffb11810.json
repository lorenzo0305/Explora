  "rdfs:comment": {
    "de": [
      "Für eine private Veranstaltung: Hochzeit, Seminar, Geburtstag... SSAM COREE bietet: Catering-Service. Buffet oder Tellerservice mit seinem Foodtruck, mehrere Formeln sind möglich, zögern Sie nicht, ihn für weitere Informationen zu kontaktieren."
    ],
    "en": [
      "For a private event: wedding, seminar, birthday... SSAM COREE offers a catering service. Buffet or plated service with his foodtruck, several formulas are possible. Don't hesitate to contact him for more information."
    ],
    "it": [
      "Per un evento privato: matrimonio, seminario, compleanno... SSAM COREE offre un servizio di catering. Servizio a buffet o al piatto con il suo foodtruck, sono possibili diverse formule, non esitate a contattarlo per maggiori informazioni."
    ],
    "fr": [
      "Pour un évènement privé : mariage, séminaire, anniversaire... SSAM COREE propose : service de traiteur. Buffet ou service à l'assiette avec son foodtruck, plusieurs formules sont possibles, n'hésitez pas à le contacter pour plus d'informations."
    ],
    "nl": [
      "Voor een privé-evenement: bruiloft, seminar, verjaardag... SSAM COREE biedt een traiteurdienst aan. Buffet of plate service met zijn foodtruck, verschillende formules zijn mogelijk, aarzel niet om contact op te nemen voor meer informatie."
    ],
    "es": [
      "Para un evento privado: boda, seminario, cumpleaños... SSAM COREE ofrece un servicio de catering. Buffet o servicio emplatado con su foodtruck, varias fórmulas son posibles, no dude en ponerse en contacto con él para obtener más información."
    ]
  },
