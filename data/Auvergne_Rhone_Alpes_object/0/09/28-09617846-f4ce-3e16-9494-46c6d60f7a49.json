  "COVID19SpecialMeasures": {
    "de": [
      "CBRE Lille begleitet Sie in der Region Nord-Pas-De-Calais bei der Suche nach Büro-, Geschäfts-, Lager- und Gewerbeflächen, aber auch bei der Erstellung von Gutachten, AMO, Raumplanung und Immobilienverwaltung."
    ],
    "en": [
      "CBRE Lille supports you in the Nord-Pas-De-Calais region in your search for office, retail, warehouse and business premises, as well as in appraisal, project management, space planning and property management."
    ],
    "it": [
      "CBRE Lille è in grado di assistervi nella regione Nord-Pas-De-Calais nella ricerca di uffici, negozi, magazzini e locali commerciali, nonché nella valutazione, nella gestione di progetti, nella pianificazione degli spazi e nella gestione immobiliare."
    ],
    "fr": [
      "CBRE Lille vous accompagne en région Nord-Pas-De-Calais pour votre recherche de bureaux, commerces, entrepôts et locaux d’activités, mais aussi en expertise, AMO, aménagement d’espace et gestion immobilière."
    ],
    "es": [
      "CBRE Lille puede ayudarle en la región de Nord-Pas-De-Calais en la búsqueda de oficinas, locales comerciales, almacenes y locales de negocios, así como en las valoraciones, la gestión de proyectos, la planificación de espacios y la gestión inmobiliaria."
    ],
    "nl": [
      "CBRE Lille kan u in de regio Nord-Pas-De-Calais helpen bij uw zoektocht naar kantoren, winkelpanden, magazijnen en bedrijfsruimten, maar ook bij taxaties, projectbeheer, ruimteplanning en vastgoedbeheer."
    ]
  },
