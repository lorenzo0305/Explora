  "rdfs:comment": {
    "de": [
      "Wir bieten hausgemachte Tagesgerichte, hauptsächlich thailändische, laotische und vietnamesische Gerichte (Nudelpfanne, lackiertes Schweinefleisch, Pad Thai?).\r\nSushi vom Vortag wird um 30 % reduziert, um Verschwendung zu vermeiden."
    ],
    "en": [
      "We offer homemade daily specials, mainly Thai, Laotian and Vietnamese dishes (stir-fried noodles, lacquered pork, pad Thai, etc.).\r\nSushi from the previous day is sold at a 30% discount to avoid waste"
    ],
    "it": [
      "Offriamo piatti del giorno fatti in casa, principalmente thailandesi, laotiani e vietnamiti (noodles saltati in padella, maiale glassato, pad thai, ecc.).\r\nIl sushi del giorno precedente viene venduto con uno sconto del 30% per evitare sprechi."
    ],
    "fr": [
      "Nous proposons des plats du jour fait maison, des plats principalement thaïlandais, laotiens et vietnamiens (nouilles sauté, porc laqué, pad thaï…).\r\nLes sushis de la veille sont vendus à -30% pour éviter le gaspillage."
    ],
    "nl": [
      "We bieden huisgemaakte dagschotels, voornamelijk Thais, Laotiaans en Vietnamees (roergebakken noedels, geglaceerd varkensvlees, pad thai, enz.).\r\nSushi van de vorige dag wordt verkocht met 30% korting om verspilling te voorkomen."
    ],
    "es": [
      "Ofrecemos platos caseros del día, principalmente tailandeses, laosianos y vietnamitas (fideos salteados, cerdo glaseado, pad thai, etc.).\r\nEl sushi del día anterior se vende con un 30% de descuento para evitar desperdicios."
    ]
  },
