  "rdfs:comment": {
    "de": [
      "Das Hotel Le Christel, Mitglied des Cit?Hôtel-Netzwerks, ist ein gemütliches Hotel im Herzen von Le Puy-en-Velay. Es bietet komfortable Zimmer, einen aufmerksamen Empfang und eine freundliche Atmosphäre, die sowohl für Touristen als auch für Geschäftsreisende ideal ist"
    ],
    "en": [
      "Hôtel Le Christel, a member of the Cit?Hôtel network, is a friendly establishment in the heart of Le Puy-en-Velay. It offers comfortable rooms, a warm welcome and a friendly atmosphere, ideal for both sightseeing and business stays"
    ],
    "it": [
      "L'Hôtel Le Christel, membro della rete Cit?Hôtel, è una struttura accogliente nel cuore di Le Puy-en-Velay. Offre camere confortevoli, un'accoglienza calorosa e un'atmosfera amichevole, ideale sia per i turisti che per i viaggiatori d'affari"
    ],
    "fr": [
      "L’Hôtel Le Christel, membre du réseau Cit’Hôtel, est un établissement chaleureux situé au cœur du Puy-en-Velay. Il propose des chambres confortables, un accueil attentionné et une atmosphère conviviale, idéale aussi bien pour les séjours touristiques que"
    ],
    "nl": [
      "Hôtel Le Christel, lid van het Cit?Hôtel-netwerk, is een vriendelijk etablissement in het hart van Le Puy-en-Velay. Het biedt comfortabele kamers, een warm welkom en een vriendelijke sfeer, ideaal voor zowel toeristen als zakenreizigers"
    ],
    "es": [
      "El Hôtel Le Christel, miembro de la red Cit'Hôtel, es un establecimiento acogedor situado en el corazón de Le Puy-en-Velay. Ofrece habitaciones confortables, una cálida bienvenida y un ambiente acogedor, ideal tanto para turistas como para viajeros de negocios"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Le Chris'tel"
    ]
  },
