  "rdfs:comment": {
    "de": [
      "Im Herzen des Belledonne-Massivs entdecken Sie das Le Madame, ein Lokal im Tal des Haut-Bréda. La table du Madame bietet eine ausgefeilte & kreative Küche. Das Restaurant ist von Mittwochabend bis Sonntagabend für alle geöffnet, auch mittags."
    ],
    "en": [
      "In the heart of the Belledonne massif, discover the charm of Haut-Bréda: an unspoilt valley in a unique environment!\r\n\r\nThe restaurant - featuring local cuisine - is open from Thursday to Sunday lunchtime."
    ],
    "it": [
      "Nel cuore del massiccio di Belledonne, scoprite Le Madame, una struttura situata nella valle dell'Haut-Bréda. La Table du Madame propone una cucina creativa e sofisticata. Il ristorante è aperto a tutti dal mercoledì sera alla domenica sera, anche a pranzo."
    ],
    "fr": [
      "Au cœur du massif de Belledonne, découvrez Le Madame, un établissement situé dans la Vallée du Haut-Bréda. La table du Madame propose une cuisine élaborée & créative. Le restaurant est ouvert à tous du mercredi soir au dimanche soir incluant les midis."
    ],
    "nl": [
      "Ontdek in het hart van het massief van Belledonne de charme van Haut-Bréda: een ongerepte vallei in een unieke omgeving!\r\n\r\nHet restaurant - met lokale gerechten - is geopend van donderdag tot zondag tijdens lunchtijd."
    ],
    "es": [
      "En el corazón del macizo de Belledonne, descubra Le Madame, un establecimiento situado en el valle de Haut-Bréda. La Table du Madame sirve una cocina creativa y sofisticada. El restaurante está abierto a todos desde el miércoles por la noche hasta el domingo por la noche, incluso a la hora del almuerzo."
    ]
  },
  "rdfs:label": {
