  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/628f48c3-e570-3610-a8c6-3ede5ac40966",
      "dc:description": {
        "de": [
          "Die Hartkopf-Familie ist eine Vogelfamilie mit starkem Charakter! Sie leben in bewaldeten Gebieten, wo sie ihre Jungen aufziehen und nach Nahrung suchen. Diese schöne Familie lädt dich ein, dich auf die Suche nach ihnen zu begeben und ihrem spöttischen Lachen zu folgen."
        ],
        "en": [
          "The hard-headed family is a family of birds with a strong character! They live in wooded areas, where they raise their young and forage for food. This beautiful family invites you to set off in search of them, following their mocking laughter."
        ],
        "it": [
          "La famiglia delle teste dure è una famiglia di uccelli dal carattere forte! Vivono in aree boschive dove allevano i loro piccoli e cercano cibo. Questa bella famiglia vi invita a partire alla loro ricerca, seguendo la loro risata beffarda."
        ],
        "fr": [
          "La famille tête dure, est une famille d’oiseaux au fort caractère ! Ils habitent dans les milieux boisés où ils élèvent leurs petits et cherchent leur nourriture. Cette belle famille, vous invite à partir à leur recherche en suivant leurs rires moqueurs."
        ],
        "es": [
          "La familia de los cabeza dura es una familia de pájaros de carácter fuerte Viven en zonas boscosas donde crían a sus polluelos y buscan comida. Esta hermosa familia te invita a partir en su busca, siguiendo sus risas burlonas."
        ],
        "nl": [
          "De hardkopfamilie is een familie vogels met een sterk karakter! Ze leven in bosrijke gebieden waar ze hun jongen grootbrengen en op zoek gaan naar voedsel. Deze prachtige familie nodigt je uit om naar ze op zoek te gaan en hun spottende gelach te volgen."
        ]
      },
      "@type": [
        "Description"
      ],
