  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bcb736f8-0942-3779-96d3-a9e09f49093b",
      "dc:description": {
        "de": [
          "Im Rahmen der Blauen Woche, die den Senioren gewidmet ist, bietet das Zentrum zur Entdeckung der Meeresfischerei Großeltern in Begleitung ihrer Enkelkinder einen kostenlosen Eintritt an."
        ],
        "en": [
          "As part of Blue Week, the sea fishing discovery center is offering free admission to grandparents accompanied by their grandchildren."
        ],
        "it": [
          "Nell'ambito della Semaine Bleue (Settimana Blu) dedicata agli anziani, il centro di scoperta della pesca in mare offre l'ingresso gratuito ai nonni accompagnati dai nipoti."
        ],
        "fr": [
          "Dans le cadre de la semaine bleue dédiée aux séniors, le centre de découverte de la pêche en mer offre une entrée gratuite aux grands parents accompagnés de leurs petits-enfants."
        ],
        "nl": [
          "In het kader van de Semaine Bleue (Blauwe Week) voor senioren biedt het centrum voor de ontdekking van de zeevisserij gratis toegang aan grootouders onder begeleiding van hun kleinkinderen."
        ],
        "es": [
          "En el marco de la Semana Azul de la tercera edad, el Centro de Descubrimiento de la Pesca Marítima ofrece entrada gratuita a los abuelos acompañados de sus nietos."
        ]
      },
