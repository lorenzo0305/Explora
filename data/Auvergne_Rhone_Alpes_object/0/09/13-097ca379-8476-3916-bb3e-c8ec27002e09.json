  "rdfs:comment": {
    "de": [
      "Vanoise Voyages bietet All-Inclusive-Aufenthalte im Sommer und Winter in der Vanoise, in den Alpen und den Bergen der Welt: Trekking, Skitouren, Schneeschuhwandern..."
    ],
    "en": [
      "Stays and travels organized by the mountains guides and tour leaders of the Vanoise Mountain leader association"
    ],
    "it": [
      "Vanoise Voyages propone vacanze all-inclusive in estate e in inverno in Vanoise, sulle Alpi e sulle montagne del mondo: trekking, sci alpinismo, ciaspolate..."
    ],
    "fr": [
      "Vanoise Voyages propose des séjours tout compris été comme hiver en Vanoise, dans les Alpes et les montagnes du monde : trekking, ski de rando, raquettes..."
    ],
