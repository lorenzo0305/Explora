  "rdfs:comment": {
    "de": [
      "Als diplomierte Sportpädagogin, die in ihre Auvergne verliebt ist, liebe ich es, Ihnen die wunderschönen Landschaften, die Region und die lokalen Produzenten durch körperliche Aktivitäten, die für alle zugänglich sind, näherzubringen."
    ],
    "en": [
      "As a qualified sports educator who loves the Auvergne region, I love to help you discover its magnificent landscapes, its terroir and its local producers through physical activities that are accessible to all."
    ],
    "it": [
      "Come istruttore sportivo qualificato che ama la regione dell'Alvernia, mi piace farvi scoprire i suoi magnifici paesaggi, i prodotti e i produttori locali attraverso attività fisiche accessibili a tutti."
    ],
    "fr": [
      "Éducatrice sportive diplômée amoureuse de son Auvergne, j’aime vous faire découvrir ses magnifiques paysages, son terroir, ses producteurs locaux par le biais d’activités physiques accessibles à tous."
    ],
    "es": [
      "Como monitor deportivo titulado y enamorado de la región de Auvernia, me gusta hacerle descubrir sus magníficos paisajes, sus productos locales y sus productores a través de actividades físicas accesibles a todos."
    ],
    "nl": [
      "Als gediplomeerd sportinstructeur die van de Auvergne houdt, laat ik je graag de prachtige landschappen, streekproducten en producenten ontdekken via fysieke activiteiten die voor iedereen toegankelijk zijn."
    ]
  },
