  "rdfs:comment": {
    "de": [
      "Wir empfangen Sie gut gelaunt, damit Sie entdecken können: Bagels, Panini, Salate, Bubble Tea, Bubble Waffel, Donuts, Cookies, Tee, Kaffee, Eis...\r\nVor Ort oder zum Mitnehmen, schneller Service."
    ],
    "en": [
      "We welcome you in a friendly atmosphere to discover bagels, paninis, salads, bubble tea, bubble waffles, doughnuts, cookies, tea, coffee, ice creams...\r\nOn the spot or takeaway, fast service."
    ],
    "it": [
      "Saremo lieti di accogliervi e di presentarvi bagel, panini, insalate, bubble tea, bubble waffle, ciambelle, biscotti, tè, caffè, gelati, ecc.\r\nSul posto o da asporto, servizio veloce."
    ],
    "fr": [
      "Nous vous accueillons dans la bonne humeur pour vous faire découvrir : bagels, panini, salades, bubble tea, bubble gaufre, donuts, cookies, thé, café, glaces...\r\nSur place ou à emporter, service rapide."
    ],
    "nl": [
      "We verwelkomen je graag en laten je kennismaken met bagels, panini's, salades, bubble tea, bubble wafels, donuts, koekjes, thee, koffie, ijsjes, enz.\r\nTer plekke of om mee te nemen, snelle service."
    ],
    "es": [
      "Estaremos encantados de recibirle y presentarle bagels, paninis, ensaladas, bubble tea, bubble waffles, donuts, galletas, té, café, helados, etc.\r\nEn el acto o para llevar, servicio rápido."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sand'Wich Snacking"
    ]
  },
