  "rdfs:comment": {
    "de": [
      "Genießen Sie die Landschaften des Diois mit einer erfahrenen Kavallerie und einer diplomierten Betreuung. Von einstündigen Ausritten bis hin zu mehrtägigen Wanderungen bieten wir Ihnen maßgeschneiderte Angebote, die auf Ihr Niveau und Ihre Erwartungen abgestimmt sind."
    ],
    "en": [
      "Come and enjoy the Diois countryside with our experienced team of riders and qualified guides. From one-hour rides to multi-day excursions, we offer tailor-made packages to suit your level and expectations."
    ],
    "it": [
      "Venite a godervi la campagna di Diois con il nostro team di esperti cavallerizzi e guide qualificate: dalle passeggiate di un'ora alle escursioni di più giorni, offriamo pacchetti su misura per soddisfare il vostro livello e le vostre aspettative."
    ],
    "fr": [
      "Venez profiter des paysages du Diois avec une cavalerie expérimentée et un encadrement diplômé de la balade d'une heure jusqu'aux randonnées de plusieurs jours, nous vous proposons des formules sur mesure en fonction de votre niveau et de vos attentes."
    ],
    "es": [
      "Venga a disfrutar del campo de Diois con nuestro experimentado equipo de jinetes y guías cualificados. Desde paseos de una hora hasta excursiones de varios días, ofrecemos paquetes a medida que se adaptan a su nivel y expectativas."
    ],
    "nl": [
      "Kom genieten van het platteland van Diois met ons ervaren team van ruiters en gediplomeerde gidsen. Van tochten van een uur tot meerdaagse excursies, wij bieden pakketten op maat die passen bij jouw niveau en verwachtingen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Reitzentrum le Relais du Diois"
    ],
    "en": [
      "Horse Riding with Le Relais du Diois"
    ],
    "fr": [
      "Centre équestre le Relais du Diois"
    ],
    "nl": [
      "Ruitersportcentrum Relais du Diois"
    ]
  },
