  "rdfs:comment": {
    "de": [
      "Pädagogischer Bauernhof in Isère. Hier können Sie kleine Huftiere wie Ouessant-Schafe und kleine Ziegen, aber auch andere Bauernhoftiere wie Frettchen, Zwergschweine, Meerschweinchen, Kaninchen, Geflügel usw. finden"
    ],
    "en": [
      "Educational farm in Isère. Here you can meet small ungulates such as Ouessant sheep and small goats, as well as other farm animals such as ferrets, dwarf pigs, guinea pigs, rabbits, poultry, and so on"
    ],
    "it": [
      "Fattoria didattica in Isère. Qui si trovano piccoli ungulati come pecore e caprette dell'Ouessant, oltre ad altri animali da fattoria come furetti, maiali nani, porcellini d'India, conigli, pollame, ecc"
    ],
    "fr": [
      "Ferme pédagogique en Isère. Vous pouvez y retrouver des petits ongulés comme les moutons d’Ouessant et des petites chèvres, mais également d’autres animaux de la ferme comme des furets, des cochons nains, des cochons d’inde, des lapins, des volailles, ect"
    ],
    "es": [
      "Granja educativa en Isère. Aquí encontrará pequeños ungulados como ovejas de Ouessant y cabras pequeñas, así como otros animales de granja como hurones, cerdos enanos, cobayas, conejos, aves de corral, etc"
    ],
    "nl": [
      "Educatieve boerderij in Isère. Hier vind je kleine hoefdieren zoals Ouessant schapen en kleine geiten, maar ook andere boerderijdieren zoals fretten, dwergvarkens, cavia's, konijnen, pluimvee, enz"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Ferlin - Peda Nat'"
    ]
  },
