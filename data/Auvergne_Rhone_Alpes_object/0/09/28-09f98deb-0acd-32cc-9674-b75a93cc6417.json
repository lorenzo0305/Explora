  "rdfs:comment": {
    "de": [
      "Von archäologischen Sammlungen über Gemälde vom 16. bis zum 20. Jahrhundert bis hin zu einem prächtigen gotischen Saal mit Skulpturen aus dem Mittelalter - der Besucher entdeckt vor seinen Augen die Entwicklung der Kunstgeschichte!"
    ],
    "en": [
      "From archaeological collections to paintings from the 16th to the 20th century, via a sumptuous Gothic room containing sculptures from the Middle Ages, visitors can discover the evolution of art history before their very eyes!"
    ],
    "it": [
      "Dalle collezioni archeologiche ai dipinti dal XVI al XX secolo, passando per una sontuosa sala gotica contenente sculture del Medioevo, il visitatore scopre l'evoluzione della storia dell'arte sotto i suoi occhi!"
    ],
    "fr": [
      "Des collections archéologiques aux peintures du XVIème au XXème siècle, en passant par une somptueuse salle gothique renfermant des  sculptures du Moyen-Age, le visiteur découvre sous ses yeux, l'évolution de l'histoire de l'art !"
    ],
    "nl": [
      "Van archeologische collecties tot schilderijen van de 16e tot de 20e eeuw, via een weelderige gotische zaal met beeldhouwwerken uit de Middeleeuwen, ontdekt de bezoeker voor zijn ogen de evolutie van de kunstgeschiedenis!"
    ],
    "es": [
      "Desde las colecciones arqueológicas hasta las pinturas de los siglos XVI al XX, pasando por una suntuosa sala gótica con esculturas de la Edad Media, ¡el visitante descubre la evolución de la historia del arte ante sus ojos!"
    ]
  },
