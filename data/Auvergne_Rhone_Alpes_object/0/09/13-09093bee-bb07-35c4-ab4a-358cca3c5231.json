  "rdfs:comment": {
    "de": [
      "France ist Keramikerin. In ihren Keramiken und Skulpturen drückt sie eine ihr eigene Sensibilität aus. Sie arbeitet vor allem mit Steinzeug und lässt ihrer Fantasie und Kreativität freien Lauf."
    ],
    "en": [
      "France expresses her creativity and imagination through her ceramic artworks and sculptures."
    ],
    "it": [
      "La Francia è una ceramista. Attraverso le sue creazioni, esprime nelle sue ceramiche e sculture una sensibilità che le è propria, lavorando prioritariamente il gres e dando libero sfogo alla sua immaginazione e creatività."
    ],
    "fr": [
      "France est céramiste. Au travers de ses créations, elle exprime dans ses céramiques et sculptures , une sensibilité qui lui est propre, travaillant le grès en priorité et laissant libre cours à son imagination et à sa créativité."
    ],
    "es": [
      "Francia es ceramista. A través de sus creaciones, expresa en sus cerámicas y esculturas, una sensibilidad propia, trabajando prioritariamente el gres y dando rienda suelta a su imaginación y creatividad."
    ],
    "nl": [
      "France is keramiste. In haar keramiek en sculpturen geeft ze uitdrukking aan haar eigen specifieke gevoeligheid, waarbij ze voornamelijk in steengoed werkt en haar verbeelding en creativiteit de vrije loop laat."
    ]
  },
  "rdfs:label": {
