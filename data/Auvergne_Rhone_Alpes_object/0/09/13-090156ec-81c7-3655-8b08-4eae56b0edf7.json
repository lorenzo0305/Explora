  "rdfs:comment": {
    "de": [
      "Der Empfang in Les Aillons-Margériaz - Grand Chambéry Alpes Tourisme - empfängt Sie und informiert Sie das ganze Jahr über Aktivitäten, Wanderungen, Geschäfte sowie das Kultur- und Naturerbe des Ferienortes Les Aillons-Margériaz."
    ],
    "en": [
      "The reception of Grand Chambéry Alpes Tourisme in Les Aillons-Margériaz welcomes you and informs you all year round about the activities, hiking, shopping, cultural and natural heritage of the Aillons-Margériaz resort."
    ],
    "it": [
      "L'accoglienza di Grand Chambéry Alpes Tourisme a Les Aillons-Margériaz vi accoglie e vi informa vi informa tutto l'anno sulle attività, escursioni, shopping, patrimonio culturale e naturale deldella stazione Aillons-Margeriaz."
    ],
    "fr": [
      "L'accueil des Aillons-Margériaz - Grand Chambéry Alpes Tourisme - vous reçoit et vous informe toute l'année sur les activités, les randonnées, les commerces, le patrimoine culturel et naturel de la station des Aillons-Margériaz."
    ],
    "es": [
      "La recepción de Aillons-Margériaz - Grand Chambéry Alpes Tourisme - le da la bienvenida y le informa durante todo el año de las actividades, excursiones, comercios, patrimonio cultural y natural de la estación de Aillons-Margériaz."
    ],
    "nl": [
      "De toeristendienst Grand Chambéry Alpes Tourisme in Aillons-Margériaz heet u het hele jaar welkom en kan u informeren over activiteiten, wandelingen, winkels, het cultureel en natuurlijk erfgoed van het Aillons-Margériaz gebied."
    ]
  },
