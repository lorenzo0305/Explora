  "rdfs:comment": {
    "de": [
      "Von der Cie Wejna. Partizipative Performance rund um alltägliche Gesten! Auf einfache und intime Weise lädt uns Sylvie Pabiot dazu ein, den Tanz unseres gewöhnlichen Lebens wahrzunehmen. Dauer: 35 Min. - Für alle ab 4 Jahren."
    ],
    "en": [
      "By Cie Wejna. A participatory performance based on everyday gestures! In a simple, intimate way, Sylvie Pabiot invites us to perceive the dance of our ordinary lives. Duration: 35 min - For all ages 4 and up."
    ],
    "it": [
      "A cura di Cie Wejna. Una performance partecipativa basata sui gesti quotidiani! In modo semplice e intimo, Sylvie Pabiot ci invita a percepire la danza della nostra vita ordinaria. Durata: 35 minuti - Per tutte le età dai 4 anni in su."
    ],
    "fr": [
      "Par la Cie Wejna. Performance participative autour des gestes quotidiens ! D'une manière simple et intime, Sylvie Pabiot nous invite à percevoir la danse de nos vies ordinaires. Durée : 35 min - Tout public à partir 4 ans."
    ],
    "nl": [
      "Door Cie Wejna. Een participatieve voorstelling gebaseerd op alledaagse gebaren! Op een eenvoudige en intieme manier nodigt Sylvie Pabiot ons uit om de dans van ons gewone leven waar te nemen. Duur: 35 min - Voor alle leeftijden vanaf 4 jaar."
    ],
    "es": [
      "A cargo de Cie Wejna. Un espectáculo participativo basado en gestos cotidianos De forma sencilla e íntima, Sylvie Pabiot nos invita a percibir la danza de nuestra vida ordinaria. Duración: 35 min - Para todos los públicos a partir de 4 años."
    ]
  },
  "rdfs:label": {
