  "rdfs:comment": {
    "de": [
      "Sie werden durch Drehen, mit der Platte sowie mit Tauben gefertigt und laden mit ihren Weißnuancen zu einer Reise in eine Welt der Gelassenheit und Reinheit ein."
    ],
    "en": [
      "Made using turning, plate and colombin techniques, all their shades of white are invitations to travel to a world of serenity and purity."
    ],
    "it": [
      "Realizzate al tornio, con piastra e con pellet, tutte le loro sfumature di bianco sono inviti a viaggiare in un mondo di serenità e purezza."
    ],
    "fr": [
      "Réalisées au tournage, à la plaque ainsi qu'aux colombins, toutes leurs nuances de blancs sont des invitations au voyage dans un monde de sérénité et de pureté."
    ],
    "es": [
      "Realizados con torneado, chapa y pellets, todos sus tonos de blanco son invitaciones a viajar a un mundo de serenidad y pureza."
    ],
    "nl": [
      "De witte tinten nodigen uit tot reizen in een wereld van sereniteit en zuiverheid."
    ]
  },
