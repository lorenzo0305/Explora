  "rdfs:comment": {
    "de": [
      "Warnung vor Überflutung!\r\nDer Pegel der Loire steigt gefährlich an. Versuche, dem Ertrinken zu entgehen!\r\nVon 2 bis 6 Spielern.\r\nAb 10 Jahren."
    ],
    "en": [
      "Submergence alert!\r\nThe Loire is rising dangerously, so try to escape drowning!\r\nFrom 2 to 6 players.\r\nAges 10 and up."
    ],
    "it": [
      "Allarme sommersione!\r\nIl livello della Loira sta salendo pericolosamente. Cercate di evitare di annegare!\r\nPer 2-6 giocatori.\r\nDai 10 anni in su."
    ],
    "fr": [
      "Alerte Submersion !\r\nLe niveau de la Loire monte dangereusement, tentez d'échapper à la noyade !\r\nDe 2 à 6  joueurs.\r\nÀ partir de 10 ans."
    ],
    "es": [
      "¡Alerta de sumersión!\r\nEl nivel del Loira está subiendo peligrosamente. ¡Intenta escapar de ahogarte!\r\nPara 2 a 6 jugadores.\r\nA partir de 10 años."
    ],
    "nl": [
      "Verdrinkingsalarm!\r\nHet niveau van de Loire stijgt gevaarlijk. Probeer aan de verdrinkingsdood te ontsnappen!\r\nVoor 2 tot 6 spelers.\r\nVanaf 10 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game : Alerte Submersion"
    ]
  },
