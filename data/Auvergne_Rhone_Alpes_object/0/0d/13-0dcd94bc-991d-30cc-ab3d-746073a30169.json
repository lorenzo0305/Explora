  "rdfs:comment": {
    "de": [
      "Eselverleih ausschließlich für Kinder. Wahl zwischen 20-minütigem Waldspaziergang oder 1-stündigem Verleih, um den Ort und die Umgebung zu erkunden."
    ],
    "en": [
      "Donkey rental exclusively for children. Choice between walk in the forest of 20 minutes or rental of 1 hour to discover the site and the surroundings of the Aydat lake."
    ],
    "it": [
      "Noleggio di asini esclusivamente per bambini. Potete scegliere tra una passeggiata di 20 minuti nella foresta o un noleggio di 1 ora per scoprire il sito e i dintorni."
    ],
    "fr": [
      "Location d'ânes exclusivement réservée aux enfants. Choix entre promenade en forêt de 20mn ou location d'1h pour découvrir le site et les alentours."
    ],
    "nl": [
      "Ezelverhuur exclusief voor kinderen. U kunt kiezen tussen een wandeling van 20 minuten in het bos of een huur van 1 uur om het terrein en de omgeving te ontdekken."
    ],
    "es": [
      "Alquiler de burros exclusivamente para niños. Puede elegir entre un paseo de 20 minutos por el bosque o un alquiler de 1 hora para descubrir el lugar y los alrededores."
    ]
  },
