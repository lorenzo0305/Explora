  "rdfs:comment": {
    "de": [
      "Vernissage am Sonntag, den 8. Februar um 18 Uhr\r\nDer Winter hält Einzug in das Herz der Blautöne,\r\nLinien und Schatten deuten die hiesigen Berge an."
    ],
    "en": [
      "Opening Sunday, February 8, 6pm\r\nWinter invites itself into the heart of the blues,\r\nLines and shadows suggest the mountains here."
    ],
    "it": [
      "Inaugurazione domenica 8 febbraio alle 18.00\r\nL'inverno si invita nel cuore del blues,\r\nLinee e ombre suggeriscono qui le montagne."
    ],
    "fr": [
      "Vernissage le dimanche 8 février à 18h\r\nL'hiver s'invite au cœur des bleus,\r\nDes lignes et des ombres suggèrent les montagnes d'ici."
    ],
    "nl": [
      "Opening op zondag 8 februari om 18.00 uur\r\nDe winter nodigt zichzelf uit in het hart van de blues,\r\nLijnen en schaduwen suggereren hier de bergen."
    ],
    "es": [
      "Inauguración el domingo 8 de febrero a las 18.00 horas\r\nEl invierno se invita a sí mismo en el corazón del blues,\r\nLíneas y sombras sugieren aquí las montañas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition - \"Bleus d'hiver\" - Encres de Nâni"
    ]
  },
