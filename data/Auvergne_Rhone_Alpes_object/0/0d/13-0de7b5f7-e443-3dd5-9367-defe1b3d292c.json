  "rdfs:comment": {
    "de": [
      "Besuchen Sie unseren Laden und gehen Sie auf Entdeckungsreise in die Geheimnisse des Tees und stellen Sie in unserem Workshop Ihren eigenen, individuell gestalteten Teebeutel zusammen."
    ],
    "en": [
      "Come and explore our boutique and discover the mysteries of tea, and assemble your own personalized tea bag in our workshop."
    ],
    "it": [
      "Venite a esplorare la nostra boutique e a scoprire i misteri del tè, assemblando la vostra bustina di tè personalizzata in uno dei nostri laboratori."
    ],
    "fr": [
      "Venez découvrir notre boutique et partez à la découverte des mystères du thé et assemblez votre propre sachet de thé personnalisé lors de nos ateliers."
    ],
    "es": [
      "Venga a explorar nuestra boutique y descubra los misterios del té, y monte su propia bolsita de té personalizada en uno de nuestros talleres."
    ],
    "nl": [
      "Kom onze boetiek verkennen en ontdek de mysteries van thee. Stel je eigen gepersonaliseerde theezakje samen in ons atelier."
    ]
  },
