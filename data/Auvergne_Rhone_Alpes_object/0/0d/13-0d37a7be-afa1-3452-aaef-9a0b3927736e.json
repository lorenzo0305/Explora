  "rdfs:comment": {
    "de": [
      "Authentisches warmes alpines Chalet, in dem Sie im Herzen der Verbindung Megève-La Giettaz Savoyer und Familienküche genießen können. Erreichbar im Winter mit Skiern oder Schneeschuhen über das Christomet und im Sommer zu Fuß oder mit dem Mountainbike (VTTAE-Aufladung möglich) über das Jaillet."
    ],
    "en": [
      "Authentic warm alpine chalet, where you can enjoy Savoyard and family cuisine in the heart of the Megève-La Giettaz link. Accessible in Winter on skis or snowshoes via the Christomet and in Summer on foot or mountain bike (VTTAE recharging possible) via the Jaillet."
    ],
    "it": [
      "Autentico e accogliente chalet d'alpeggio dove gustare la cucina savoiarda e familiare tra Megève e La Giettaz. Accessibile in inverno in sci o racchette da neve dal Christomet e in estate a piedi o in mountain-bike (possibilità di ricarica delle bicilette elettriche) da Jaillet."
    ],
    "fr": [
      "Authentique chalet d'alpage chaleureux, où déguster une cuisine savoyarde et familiale au centre de la liaison Megève-La Giettaz. Accessible l’hiver en skis ou raquettes par le Christomet et l’été à pied ou VTT (recharge VTTAE possible) par le Jaillet."
    ],
    "nl": [
      "Authentiek en gezellig alpenchalet, waar u kunt genieten van de Savoyaardse en familiale keuken in het centrum van de verbinding Megève-La Giettaz. Toegankelijk in de winter op ski's of sneeuwschoenen via de Christomet en in de zomer te voet of met de mountainbike (VTTAE opladen mogelijk) via het Jaillet."
    ],
    "es": [
      "Auténtico y acogedor chalet alpino, donde podrá degustar cocina saboyana y familiar en el centro del enlace Megève-La Giettaz. Accesible en invierno con esquís o raquetas por el Christomet y en verano a pie o en bicicleta de montaña (posibilidad de recarga VTTAE) por el Jaillet."
    ]
  },
