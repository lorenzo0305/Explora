  "rdfs:comment": {
    "de": [
      "Zwei Kräuterbäuerinnen in der Drôme Provençale bieten Ihnen ihr Sortiment an biologischen Heilpflanzen an, die auf ihrem Hof geerntet und verarbeitet werden. Hydrolate, ätherische Öle, Gemmotherapie, Urtinkturen, Massageöle, Kräutertees, Sirupe."
    ],
    "en": [
      "Two farmer-herbalists in Drôme Provençale offer you their range of organic medicinal plants harvested and processed on the farm. Hydrolats, essential oils, gemmotherapy, mother tinctures, massage oils, herbal teas, syrups."
    ],
    "it": [
      "Due agricoltori-erboristi della Drôme Provençale vi propongono la loro gamma di piante medicinali biologiche raccolte e lavorate in azienda. Idrolati, oli essenziali, gemmoterapia, tinture madri, oli da massaggio, tisane e sciroppi."
    ],
    "fr": [
      "Deux paysannes-herboristes en Drôme provençale vous proposent leur gamme de plantes médicinales biologiques récoltées et transformées à la ferme. Hydrolats, huiles essentielles, gemmothérapie, teintures mères, huiles de massage, tisanes, sirops."
    ],
    "nl": [
      "Twee boeren-kruideniers in Drôme Provençale bieden je hun assortiment biologische geneeskrachtige planten die op de boerderij worden geoogst en verwerkt. Hydrolaten, essentiële oliën, gemmotherapie, moedertincturen, massageoliën, kruidenthee en siropen."
    ],
    "es": [
      "Dos agricultores-herboristas de la Drôme provenzal le proponen su gama de plantas medicinales ecológicas recolectadas y transformadas en la granja. Hidrolatos, aceites esenciales, gemoterapia, tinturas madre, aceites de masaje, tisanas y jarabes."
    ]
  },
