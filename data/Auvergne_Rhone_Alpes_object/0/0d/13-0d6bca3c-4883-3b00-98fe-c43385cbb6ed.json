  "rdfs:comment": {
    "de": [
      "Der Bouleplatz befindet sich im Freizeitbereich, in der Nähe des Picknickplatzes und des Trinkwasserbrunnens.\r\nAchtung: Im Winter ist der Platz schneebedeckt."
    ],
    "en": [
      "Boules."
    ],
    "it": [
      "Il campo da bocce si trova nell'area ricreativa, vicino all'area picnic e alla fontana.\r\nAttenzione: in inverno la piazzola è coperta di neve."
    ],
    "fr": [
      "Le terrain de pétanque se situe sur la zone de loisirs, à proximité de l'aire de pique-nique et de la fontaine d'eau potable.\r\nAttention : en hiver, le terrain est enneigé."
    ],
    "es": [
      "La pista de petanca está situada en la zona de recreo, cerca de la zona de picnic y de la fuente.\r\nAtención: en invierno, el terreno de juego está cubierto de nieve."
    ],
    "nl": [
      "De petanquebaan ligt in het recreatiegebied, vlakbij de picknickplaats en de drinkfontein.\r\nLet op: in de winter is de standplaats bedekt met sneeuw."
    ]
  },
  "rdfs:label": {
    "en": [
