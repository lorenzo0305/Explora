  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7507edc5-8e07-31c1-9add-a746506d2aeb",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Gebäck\n\nTage der Öffnung:\n\nMontag bis Samstag von 8:30 bis 13:30 Uhr und von 15:00 bis 19:00 Uhr\nSonntags von 8:00 bis 12:30 Uhr\n\nMontags geschlossen\nAbholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellungen unter 03 21 51 79 97 möglich\n\nLieferung:\n \nLieferung am Nachmittag in Bapaume nur für gebrechliche Personen möglich.\n\n "
        ],
        "en": [
          "Information :\n\nProducts: pastries\n\nOpening days:\n\nMonday to Saturday, 8:30am to 1:30pm and 3pm to 7pm\nSunday from 8am to 12:30pm\n\nClosed on Mondays\nCollection:\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by telephone on 03 21 51 79 97\n\nDelivery:\n \nPossibility of afternoon delivery in Bapaume for frail people only.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti : Pasticceria\n\nGiorni di apertura:\n\nDal lunedì al sabato dalle 8.30 alle 13.30 e dalle 15.00 alle 19.00\nDomenica dalle 8.00 alle 12.30\n\nChiuso il lunedì\nRaccolta:\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 51 79 97\n\nConsegne:\n \nLe consegne pomeridiane sono disponibili a Bapaume solo per le persone fragili.\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pâtisseries\n\nJours d'ouverture:\n\nDu lundi au samedi de 8h30 à 13h30 et de 15h à 19h\nLe dimanche de 8h à 12h30\n\nFermeture le lundi\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au  03 21 51 79 97\n\nLivraison:\n \nPossibilité de livraison, l'après-midi sur Bapaume uniquement pour les personnes fragiles.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten : Gebak\n\nOpeningsdagen:\n\nMaandag tot zaterdag van 8u30 tot 13u30 en van 15u tot 19u\nZondag van 8.00 tot 12.30\n\nMaandag gesloten\nOphalen:\n\nAfhalen tijdens winkelopeningstijden\n\nBestellen :\n\nBestellingen kunnen telefonisch worden doorgegeven op 03 21 51 79 97\n\nLeveringen:\n \nLeveringen in de namiddag zijn enkel mogelijk in Bapaume voor kwetsbare personen.\n\n "
        ],
        "es": [
          "Más información :\n\nProductos : Bollería\n\nDías de apertura:\n\nDe lunes a sábado de 8h30 a 13h30 y de 15h00 a 19h00\nDomingo de 8h a 12h30\n\nLunes cerrado\nRecogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nSe pueden hacer pedidos por teléfono llamando al 03 21 51 79 97\n\nEntregas:\n \nLas entregas por la tarde están disponibles en Bapaume sólo para personas frágiles.\n\n "
        ]
      },
