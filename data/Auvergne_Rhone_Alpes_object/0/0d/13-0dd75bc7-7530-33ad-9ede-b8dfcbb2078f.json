  "rdfs:comment": {
    "de": [
      "Terrassen mit außergewöhnlicher Aussicht, Esszimmer am Kamin: Das Bistro Chapouton bietet eine großzügige Feinschmeckerküche aus regionalen Produkten. Vom Guide Michelin mit einem Bib Gourmand ausgezeichnet. Vor Ort, zeitgenössische Zimmer."
    ],
    "en": [
      "Terraces with exceptional views, dining room by the fireplace: the Bistro Chapouton offers generous, gourmet cuisine based on regional produce. Contemporary rooms on site."
    ],
    "it": [
      "Terrazze con viste eccezionali, sala da pranzo accanto al camino: il Bistro Chapouton offre una generosa cucina gourmet a base di prodotti regionali. Camere contemporanee in loco."
    ],
    "fr": [
      "Terrasses avec vue exceptionnelle, salle à manger au coin de la cheminée : le Bistro Chapouton propose une cuisine gourmande et généreuse à base de produits régionaux. Sur place, chambre contemporaines."
    ],
    "es": [
      "Terrazas con vistas excepcionales, comedor junto a la chimenea: el Bistro Chapouton ofrece una generosa cocina gourmet basada en productos regionales. Habitaciones contemporáneas in situ."
    ],
    "nl": [
      "Terrassen met een uitzonderlijk uitzicht, eetzaal bij de open haard: de Bistro Chapouton biedt een royale gastronomische keuken op basis van regionale producten. Bekroond met een Bib Gourmand door de Michelin-gids. Eigentijdse kamers op het terrein."
    ]
  },
