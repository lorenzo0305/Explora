  "rdfs:comment": {
    "de": [
      "PLANTZYDON ist ein Gemüsebauernhof in Pontcharra (Isère). Wir bieten das ganze Jahr über Saisongemüse und im Frühjahr Erdbeeren und Gemüsepflanzen an. Diese Produktionen sind als \"Agriculture Biologique\" zertifiziert."
    ],
    "en": [
      "PLANTZYDON is a market garden farm in Pontcharra (Isère). We offer seasonal vegetables all year round, and strawberries and vegetable plants in spring. These products are certified \"Agriculture Biologique\"."
    ],
    "it": [
      "PLANTZYDON è una fattoria-orto a Pontcharra (Isère). Offriamo verdure di stagione tutto l'anno e fragole e piante di ortaggi in primavera. Tutti i nostri prodotti sono certificati biologici."
    ],
    "fr": [
      "PLANTZYDON est une ferme maraîchère à Pontcharra (Isère). Nous proposons toute l’année des légumes de saison, et au printemps des fraises et des plants potagers. Ces productions sont certifiées « Agriculture Biologique »."
    ],
    "nl": [
      "PLANTZYDON is een tuinderij in Pontcharra (Isère). We bieden het hele jaar door seizoensgroenten en in het voorjaar aardbeien en groenteplanten. Al onze producten zijn biologisch gecertificeerd."
    ],
    "es": [
      "PLANTZYDON es una explotación hortícola situada en Pontcharra (Isère). Ofrecemos verduras de temporada durante todo el año, y fresas y plantones de hortalizas en primavera. Todos nuestros productos tienen certificación ecológica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Plantzydon"
    ]
  },
