  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Geschichte der Olympischen Spiele von Albertville 1992 und entdecken Sie die Schätze Savoyens auf einem einzigartigen interaktiven Rundgang."
    ],
    "en": [
      "Immerse yourself in the legacy of the 1992 Albertville Olympic Games and explore the wonders of Savoie through a unique interactive journey."
    ],
    "it": [
      "Immergetevi nell'epopea dei Giochi Olimpici di Albertville 1992 ed esplorate le ricchezze della Savoia attraverso un percorso interattivo unico."
    ],
    "fr": [
      "Plongez dans l'épopée des Jeux Olympiques d'Albertville de 1992 et explorez les richesses de la Savoie à travers un parcours intéractif unique."
    ],
    "es": [
      "Sumérjase en la épica historia de los Juegos Olímpicos de Albertville 1992 y explore las riquezas de Saboya a través de un recorrido interactivo único."
    ],
    "nl": [
      "Dompel u onder in het epos van de Olympische Spelen van Albertville 1992 en ontdek de rijkdommen van de Savoie via een uniek interactief parcours."
    ]
  },
