  "rdfs:comment": {
    "de": [
      "Der Bauernhof Les Frasses liegt oberhalb des Dorfes Le Reposoir, an der Straße zum Col de la Colombière. Der Hof produziert und verkauft : Reblochon fermier (A.O.P), Tomme de vache fermière (I.G.P), Tomme blanche (auf Bestellung) sowie den Käse le Béol."
    ],
    "en": [
      "Frasses's Farm is located above the village of Reposoir, on the col de la Colombière road. The farm manufactures and sells french cheeses like reblochon or tomme."
    ],
    "it": [
      "La fattoria Frasses si trova sopra il villaggio di Le Reposoir, sulla strada per il Col de la Colombière. L'azienda produce e vende : Reblochon fermier (A.O.P), Tomme de vache fermière (I.G.P), Tomme blanche (su ordinazione) e il formaggio Béol."
    ],
    "fr": [
      "La ferme des Frasses est située au dessus du village du Reposoir, sur la route du col de la Colombière. La ferme fabrique et vend : Reblochon fermier (A.O.P), Tomme de vache fermière (I.G.P), Tomme blanche (sur commande) ainsi que le fromage le Béol."
    ],
    "es": [
      "La granja de Frasses está situada por encima del pueblo de Le Reposoir, en la carretera del Col de la Colombière. La granja produce y vende : Reblochon fermier (A.O.P), Tomme de vache fermière (I.G.P), Tomme blanche (por encargo), así como el queso Béol."
    ],
    "nl": [
      "De boerderij van Frasses ligt boven het dorp Le Reposoir, op de weg naar de Col de la Colombière. De boerderij produceert en verkoopt : Reblochon fermier (A.O.P), Tomme de vache fermière (I.G.P), Tomme blanche (op bestelling) evenals de Béol kaas."
    ]
  },
