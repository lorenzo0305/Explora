  "rdfs:comment": {
    "de": [
      "Atelier/Boutique zur Herstellung von Grand Cru-Schokolade, Rösten von Bio- und Fairtrade-Kaffee, Verkostungen vor Ort.\r\nTextilkreationen mit bunten und grafischen Mustern, Kleidung und Accessoires.  Heilpflanzen und aromatische Zubereitungen."
    ],
    "en": [
      "Workshop/gallery for making Grand Cru chocolate from Latin America, roasting organic and fair trade coffee, tastings on site. Zen Jolo makes on site and offers creations with colorful and graphic patterns in 100% cotton fabrics. Medicinal plants and aromatic preparations."
    ],
    "it": [
      "Laboratorio/negozio di cioccolato Grand Cru, torrefazione di caffè biologico ed equo-solidale, degustazioni.\r\nCreazioni tessili, abbigliamento e accessori. Creazioni ceramiche in gres e terracotta smaltata, gioielli e oggetti decorativi."
    ],
    "fr": [
      "Atelier/boutique de fabrication de chocolat grand cru, torréfaction de cafés, bio et équitable, dégustations.\r\nCréations textiles, vêtements et accessoires. Créations céramiques en grès et faïences émaillées utilitaires, bijoux et objets décoratifs."
    ],
    "es": [
      "Taller/tienda de chocolatería Grand Cru, tostado de café ecológico y de comercio justo, degustaciones.\r\nCreaciones textiles, ropa y accesorios. Creaciones cerámicas en gres y loza vidriada, joyas y objetos de decoración."
    ],
    "nl": [
      "Grand Cru chocolaterie/winkel, biologische en fairtrade koffiebranderij, proeverijen ter plekke.\r\nTextielcreaties met kleurrijke, grafische ontwerpen, kleding en accessoires.  Medicinale planten en aromatische preparaten."
    ]
  },
