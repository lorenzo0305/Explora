  "rdfs:comment": {
    "de": [
      "Die Adler von Saint Maurice de Lignon erobern die Festung von Polignac für drei Aufführungen von Raubvögeln im freien Flug. Im Anschluss an die Vorstellung können die Besucher die Festung Polignac besichtigen."
    ],
    "en": [
      "Les Aigles de Saint Maurice de Lignon take over the Forteresse de Polignac for 3 performances of free-flying birds of prey. The show will be followed by a free tour of the Forteresse de Polignac."
    ],
    "it": [
      "Les Aigles de Saint Maurice de Lignon conquistano la Forteresse di Polignac per 3 spettacoli di volo libero di rapaci. Lo spettacolo sarà seguito, per chi lo desidera, da una visita gratuita della Fortezza di Polignac."
    ],
    "fr": [
      "Les Aigles de Saint Maurice de Lignon investissent la Forteresse de Polignac pour 3 représentations de rapaces en vol libre. Le spectacle sera suivi, pour les personnes qui le souhaitent, d’une visite libre de la Forteresse de Polignac."
    ],
    "es": [
      "Les Aigles de Saint Maurice de Lignon toman la Forteresse de Polignac para 3 espectáculos de vuelo libre de aves rapaces. El espectáculo irá seguido, para aquellos que lo deseen, de una visita gratuita a la Fortaleza de Polignac."
    ],
    "nl": [
      "Les Aigles de Saint Maurice de Lignon nemen de Forteresse de Polignac over voor 3 voorstellingen van vrij vliegende roofvogels. De show wordt, voor wie dat wil, gevolgd door een gratis rondleiding door het fort van Polignac."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle de rapaces à la Forteresse de Polignac"
    ]
  },
