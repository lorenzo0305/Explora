  "rdfs:comment": {
    "de": [
      "HYPERSENSIBLE ist eine Boutique mit einem originellen Konzept, die Folgendes bietet:\r\n\r\n- Pflanzenkreationen (Kokedamas, Terrarien, ...)\r\n- Schmuck für Männer und Frauen, der in unserem Atelier handgefertigt wird.\r\n- Kreative Workshops"
    ],
    "en": [
      "HYPERSENSIBLE is a boutique with an original concept:\r\n\r\n- Plant creations (Kokedamas, terrariums, ...)\r\n- Jewelry for men and women, handcrafted in our workshop.\r\n- Creative workshops"
    ],
    "it": [
      "HYPERSENSIBLE è un negozio dal concetto originale:\r\n\r\n- Creazioni vegetali (kokedama, terrari, ecc.)\r\n- Gioielli per uomo e donna, realizzati a mano nel nostro laboratorio.\r\n- Laboratori creativi"
    ],
    "fr": [
      "HYPERSENSIBLE est une boutique au concept original qui propose:\r\n\r\n- Des créations Végétales ( Kokedamas, terrariums, ...)\r\n- Des bijoux pour Homme et Femme confectionnés à la main dans notre atelier.\r\n- Des Ateliers créatifs"
    ],
    "nl": [
      "HYPERSENSIBLE is een winkel met een origineel concept:\r\n\r\n- Plantencreaties (kokedama's, terraria, enz.)\r\n- Sieraden voor mannen en vrouwen, handgemaakt in ons atelier.\r\n- Creatieve workshops"
    ],
    "es": [
      "HYPERSENSIBLE es una tienda con un concepto original:\r\n\r\n- Creaciones vegetales (Kokedamas, terrarios, etc.)\r\n- Joyas para hombre y mujer, hechas a mano en nuestro taller.\r\n- Talleres creativos"
    ]
  },
