  "rdfs:comment": {
    "de": [
      "Nach einer Rekord-Welttournee Ende 2024 kündigt Laura Pausini, ihre große Rückkehr auf die Bühne mit ihrer 11. Welttournee an: IO CANTO WORLD TOUR 2026/2027. Laura Pausini wird am 12. November 2027 in der LDLC Arena in Lyon-Décines auftreten."
    ],
    "en": [
      "After a record-breaking world tour at the end of 2024, Laura Pausini, announces her grand return to the stage with her 11th world tour: IO CANTO WORLD TOUR 2026/2027. Laura Pausini will be at the LDLC Arena in Lyon-Décines on November 12, 2027."
    ],
    "it": [
      "Dopo un tour mondiale da record alla fine del 2024, Laura Pausini annuncia il suo ritorno sul palco con il suo 11° tour mondiale: IO CANTO WORLD TOUR 2026/2027. Laura Pausini sarà all'Arena LDLC di Lione-Décines il 12 novembre 2027."
    ],
    "fr": [
      "Après une tournée mondiale record fin 2024, Laura Pausini, annonce son grand retour sur scène avec sa 11ème tournée mondiale : IO CANTO WORLD TOUR 2026/2027. Laura Pausini sera à la LDLC Arena de Lyon-Décines, le 12 novembre 2027."
    ],
    "es": [
      "Tras una gira mundial récord a finales de 2024, Laura Pausini anuncia su regreso a los escenarios con su undécima gira mundial: IO CANTO WORLD TOUR 2026/2027. Laura Pausini estará en el LDLC Arena de Lyon-Décines el 12 de noviembre de 2027."
    ],
    "nl": [
      "Na een recordbrekende wereldtournee eind 2024 kondigt Laura Pausini haar terugkeer naar het podium aan met haar 11e wereldtournee: IO CANTO WORLD TOUR 2026/2027. Laura Pausini staat op 12 november 2027 in de LDLC Arena in Lyon-Décines."
    ]
  },
