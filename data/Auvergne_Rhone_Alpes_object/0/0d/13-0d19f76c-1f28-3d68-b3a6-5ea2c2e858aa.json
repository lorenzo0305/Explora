  "rdfs:comment": {
    "de": [
      "Der Bréda ist ein typischer Wildbach in den Mittelgebirgen und wird ab seinem Grenzverlauf Savoyen/Isère zu einem reißenden Fluss in der Ebene."
    ],
    "en": [
      "A typical wild mid-mountain torrent, the Bréda becomes a torrential lowland river from the Savoie/Isère border onwards."
    ],
    "it": [
      "Tipico torrente selvaggio di media montagna, la Bréda diventa un fiume torrentizio di pianura a partire dal confine Savoia/Isère."
    ],
    "fr": [
      "Typique torrent sauvage de moyenne montagne, le Bréda devient une rivière torrentueuse de plaine à partir de son linéaire limitrophe Savoie/Isère."
    ],
    "es": [
      "Típico torrente salvaje de media montaña, el Bréda se convierte en un torrentoso río de llanura a partir de la frontera entre Saboya e Isère."
    ],
    "nl": [
      "De Bréda is een typische wilde bergrivier die vanaf de grens tussen de Savoie en de Isère verandert in een woeste laaglandrivier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bréda"
    ]
  },
