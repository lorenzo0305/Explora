  "rdfs:comment": {
    "de": [
      "Entdecken Sie das brandneue Hotel Les Caudalies mit seinen 6 geschmackvoll renovierten und klimatisierten Zimmern. Das Hotel bietet außerdem ein Restaurant und eine Bar mit einer modernen und raffinierten Speisekarte."
    ],
    "en": [
      "Discover the brand new hotel Les Caudalies with its 7 tastefully renovated rooms. The hotel also offers a restaurant and bar with a modern and refined menu."
    ],
    "it": [
      "Scoprite il nuovissimo hotel Les Caudalies con le sue 6 camere climatizzate rinnovate con gusto. L'hotel offre anche un ristorante e un bar con un menù moderno e raffinato."
    ],
    "fr": [
      "Découvrez le tout nouvel hôtel Les Caudalies avec ses 6 chambres rénovées avec goût et climatisées. L'hôtel propose également un restaurant et un bar avec une carte moderne et raffinée."
    ],
    "nl": [
      "Ontdek het gloednieuwe hotel Les Caudalies met zijn 6 smaakvol gerenoveerde kamers met airconditioning. Het hotel biedt ook een restaurant en bar met een modern en verfijnd menu."
    ],
    "es": [
      "Descubra el flamante hotel Les Caudalies con sus 6 habitaciones climatizadas y renovadas con gusto. El hotel también ofrece un restaurante y un bar con un menú moderno y refinado."
    ]
  },
