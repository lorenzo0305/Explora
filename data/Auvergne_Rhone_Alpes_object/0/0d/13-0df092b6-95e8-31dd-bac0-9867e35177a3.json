  "rdfs:comment": {
    "de": [
      "Restaurant, Familienessen, Gruppenessen wir stehen zu Ihrer Verfügung und hören Ihnen zu, um Sie zufrieden zu stellen.\r\nEin Panoramablick auf Châtel-Guyon. An schönen Tagen bieten wir auf unserer Terrasse gegrilltes Fleisch und Fisch vom Grill an."
    ],
    "en": [
      "Whether you're looking for a restaurant, family meals or group meals, we're here to help you.\r\nWith a panoramic view over Châtel-Guyon, we offer barbecued meat and fish on our terrace in fine weather."
    ],
    "it": [
      "Ristorante, pasti in famiglia, pasti di gruppo, siamo a vostra disposizione e pronti ad ascoltare le vostre esigenze.\r\nCon una vista panoramica su Châtel-Guyon, nella bella stagione offriamo carne e pesce alla griglia sulla nostra terrazza."
    ],
    "fr": [
      "Restaurant, repas de familles, repas de groupes nous sommes à votre disposition et à votre écoute pour vous satisfaire.\r\nUne vue panoramique sur Châtel-Guyon, nous proposons aux beaux jours sur notre terrasse des viandes et poissons grillés au barbecue."
    ],
    "es": [
      "Restaurante, comidas familiares, comidas de grupo, estamos a su disposición y dispuestos a escuchar sus necesidades.\r\nCon una vista panorámica sobre Châtel-Guyon, ofrecemos carnes y pescados a la barbacoa en nuestra terraza cuando hace buen tiempo."
    ],
    "nl": [
      "Restaurant, familiemaaltijden, groepsmaaltijden, wij staan tot uw beschikking en luisteren naar uw wensen.\r\nMet een panoramisch uitzicht over Châtel-Guyon bieden we bij mooi weer barbecuevlees en vis op ons terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Cèdre bleu"
    ]
  },
