  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf Sushi zum Abendessen? Gehen Sie in diesem gemütlichen japanischen Restaurant auf Entdeckungsreise und genießen Sie japanische Spezialitäten. Ein Abendessen vor Ort oder zum Mitnehmen - Sie haben die Wahl! Auf der Speisekarte: Maki, Nigiri, Sashimi, California Rolls, Suppen?"
    ],
    "en": [
      "Craving sushi for dinner? Discover Japanese specialties at this cozy Japanese restaurant. Dine-in or takeaway, the choice is yours! On the menu: maki, nigiri, sashimi, california rolls, soups?"
    ],
    "it": [
      "Voglia di sushi per cena? Scoprite le specialità giapponesi in questo accogliente ristorante giapponese. Cenate o portate via, la scelta è vostra! Nel menu: maki, nigiri, sashimi, california rolls, zuppe?"
    ],
    "fr": [
      "Une folle envie de sushis pour le dîner ? Partez à la découverte des spécialités japonaises dans ce restaurant nippon très cosy. Un dîner sur place ou à emporter, à vous de choisir ! Au menu : makis, nigiris, sashimis, california rolls, soupes…"
    ],
    "es": [
      "¿Le apetece sushi para cenar? Descubra las especialidades japonesas en este acogedor restaurante japonés. Para cenar o para llevar, ¡tú eliges! En el menú: maki, nigiri, sashimi, california rolls, sopas.."
    ],
    "nl": [
      "Trek in sushi als avondeten? Ontdek Japanse specialiteiten in dit gezellige Japanse restaurant. Dineren of afhalen, de keuze is aan jou! Op het menu: maki, nigiri, sashimi, california rolls, soepen?"
    ]
  },
