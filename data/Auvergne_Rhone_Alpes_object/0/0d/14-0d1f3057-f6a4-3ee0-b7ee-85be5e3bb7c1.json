      "@id": "https://data.datatourisme.fr/8bafe617-e72c-3fc3-b722-480b66e4ce85",
      "dc:description": {
        "de": [
          "iD Stock Boulogne-sur-Mer, das sind 900 m2 voller Schnäppchen auf dem Boulevard Daunou, mitten im Stadtzentrum!\n\nÖffnungszeiten:\nMontag: 14.00 ? 19h00\nDienstag bis Samstag: 09:30 ? 19h00"
        ],
        "en": [
          "iD Stock Boulogne-sur-Mer offers 900 m2 of bargains on boulevard Daunou, right in the city center!\n\nOpening hours :\nMonday : 14h00 ? 19h00\nTuesday to Saturday: 09h30 ? 19h00"
        ],
        "it": [
          "iD Stock Boulogne-sur-Mer offre 900 m2 di occasioni in boulevard Daunou, in pieno centro città!\n\nOrari di apertura :\nLunedì: 14h00 ? 19h00\nDa martedì a sabato: 09h30 ? 19h00"
        ],
        "fr": [
          "iD Stock Boulogne-sur-Mer, c’est 900 m2 de bonnes affaires sur le boulevard Daunou, en plein centre-ville !\n\nHoraires d’ouverture : \nLundi : 14h00 – 19h00\nMardi au Samedi : 09h30 – 19h00"
        ],
        "es": [
          "iD Stock Boulogne-sur-Mer ofrece 900 m2 de chollos en el bulevar Daunou, ¡en pleno centro de la ciudad!\n\nHorario de apertura :\nLunes: 14h00 ? 19h00\nDe martes a sábado: 09h30 ? 19h00"
        ],
        "nl": [
          "iD Stock Boulogne-sur-Mer biedt 900 m2 aan koopjes op de boulevard Daunou, midden in het centrum!\n\nOpeningstijden :\nMaandag: 14h00 ? 19h00\nDinsdag tot zaterdag: 09h30 ? 19h00"
        ]
      },
