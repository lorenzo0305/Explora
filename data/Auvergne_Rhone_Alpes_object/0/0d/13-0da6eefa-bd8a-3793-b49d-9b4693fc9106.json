  "rdfs:comment": {
    "de": [
      "Lachen Sie sich schlapp mit dieser urkomischen Komödie von Viviane Tardivel! Eine Geschichte über Liebe und Missverständnisse, die einen unvergesslichen Abend verspricht. Ideal für die ganze Familie. Buchen Sie Ihren Theaterabend jetzt! Begrenzte Plätze."
    ],
    "en": [
      "Laugh out loud with this hilarious comedy by Viviane Tardivel! A story of love and misunderstanding that promises an unforgettable evening. Ideal for the whole family. Book your theater evening now! Limited seating."
    ],
    "it": [
      "Venite a ridere a crepapelle con questa esilarante commedia di Viviane Tardivel! Una storia d'amore e di equivoci che promette una serata indimenticabile. Ideale per tutta la famiglia. Prenotate subito la vostra serata teatrale! I posti sono limitati."
    ],
    "fr": [
      "Venez rire aux éclats avec cette comédie hilarante de Viviane Tardivel ! Une histoire d'amour et de quiproquos qui promet une soirée inoubliable. Idéal pour toute la famille. Réservez votre soirée théâtre dès maintenant ! Places limitées."
    ],
    "es": [
      "Venga a reír a carcajadas con esta divertidísima comedia de Viviane Tardivel Una historia de amor y malentendidos que promete una velada inolvidable. Ideal para toda la familia. Reserve ya su velada teatral Plazas limitadas."
    ],
    "nl": [
      "Kom hardop lachen om deze hilarische komedie van Viviane Tardivel! Een verhaal over liefde en misverstanden dat een onvergetelijke avond belooft. Ideaal voor het hele gezin. Boek nu je theateravond! Plaatsen zijn beperkt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "\"...Et surtout pour le pire !\" - Comédie théâtrale"
    ]
  },
