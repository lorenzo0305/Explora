  "rdfs:comment": {
    "de": [
      "Der Samstag ist der Natur, der Entdeckung und der Geselligkeit mit dem Gravel gewidmet, während der Sonntag dem Wettkampf, der Sportlichkeit, aber auch der Entdeckung mit den Straßenwettbewerben gewidmet ist."
    ],
    "en": [
      "Saturday is dedicated to nature, discovery and conviviality with the gravel, while Sunday is devoted to competition, sport and discovery with the road races."
    ],
    "it": [
      "Il sabato è dedicato alla natura, alla scoperta e alla convivialità con lo sterrato, mentre la domenica è dedicata alla competizione, allo sport e alla scoperta con le gare su strada."
    ],
    "fr": [
      "Le samedi est consacré à la nature, à la découverte et à la convivialité avec le gravel alors que le dimanche est consacré à la compétition, à la sportivité mais aussi à la découverte avec les épreuves sur route."
    ],
    "nl": [
      "Zaterdag staat in het teken van natuur, ontdekking en gezelligheid met de gravel, terwijl zondag in het teken staat van competitie, sport en ontdekking met de wegraces."
    ],
    "es": [
      "El sábado se dedica a la naturaleza, el descubrimiento y la convivencia con la gravilla, mientras que el domingo se dedica a la competición, el deporte y el descubrimiento con las carreras de carretera."
    ]
  },
  "rdfs:label": {
