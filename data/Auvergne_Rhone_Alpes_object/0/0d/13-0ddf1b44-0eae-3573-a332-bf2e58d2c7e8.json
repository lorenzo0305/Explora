  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Entremont le Vieux empfangen wir Sie in einem geselligen Gasthaus und im Sommer auf einer Sonnenterrasse mit gepflegter Küche und reichhaltigen Tellern."
    ],
    "en": [
      "We welcome you in a pleasant renovated inn located in the heart of the village of Entremont le Vieux. The inn offers a well-exposed terrace, a nice cuisine with large plates."
    ],
    "it": [
      "Nel cuore del villaggio di Entremont le Vieux, vi diamo il benvenuto nella nostra accogliente locanda e, in estate, nella nostra terrazza ben esposta, dove potrete gustare una cucina raffinata e piatti sostanziosi."
    ],
    "fr": [
      "C'est au cœur du village d'Entremont le Vieux, que nous vous accueillons dans une auberge conviviale et en été sur une terrasse bien exposée, avec une cuisine soignée et des assiettes copieuses."
    ],
    "nl": [
      "In het hart van het dorp Entremont le Vieux verwelkomen wij u in onze gezellige herberg en, in de zomer, op ons goed belichte terras, waar u kunt genieten van een verfijnde keuken en stevige gerechten."
    ],
    "es": [
      "En el corazón del pueblo de Entremont le Vieux, le damos la bienvenida a nuestra acogedora posada y, en verano, a nuestra terraza bien expuesta, donde podrá degustar buena cocina y platos contundentes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Entremonts"
    ],
    "fr": [
      "Auberge des Entremonts"
    ]
  },
