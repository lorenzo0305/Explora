  "rdfs:comment": {
    "de": [
      "Besuchen Sie unsere authentischen und einzigartigen Pubs?\r\nDas Au Bureau ist ein Ort des Lebens mit angelsächsischem Dekor und gibt Ihrem Tag von morgens bis abends einen Rhythmus: Essen mit Freunden, Aperitif, Sport, Musik, Tanz?"
    ],
    "en": [
      "Visit our authentic and unique pubs?\r\nAu Bureau is a place of life with an Anglo-Saxon decor, where your day begins in the morning and ends in the evening: meals with friends, aperitifs, sports, music, dancing?"
    ],
    "it": [
      "Visitare i nostri pub autentici e unici?\r\nAu Bureau è un vero e proprio luogo di vita con un arredamento anglosassone, dove potrete godervi il ritmo della vostra giornata dalla mattina alla sera: pasti con gli amici, drink, sport, musica, balli?"
    ],
    "fr": [
      "Rendez-vous dans nos pubs authentiques et uniques…\r\nVéritables lieux de vie aux décors anglo-saxons, Au Bureau rythme votre journée du matin jusqu’au soir : repas entre amis, apéro, sport, musique, danse…"
    ],
    "es": [
      "Visite nuestros pubs auténticos y únicos?\r\nAu Bureau es un auténtico lugar de vida con decoración anglosajona, donde podrá disfrutar del ritmo de su día de la mañana a la noche: comidas con amigos, copas, deporte, música, baile?"
    ],
    "nl": [
      "Bezoek onze authentieke en unieke pubs?\r\nAu Bureau is een echte plek van leven met een Angelsaksisch decor, waar je van 's morgens vroeg tot 's avonds laat kunt genieten van het ritme van je dag: maaltijden met vrienden, drankjes, sport, muziek, dansen?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Au Bureau"
    ]
  },
