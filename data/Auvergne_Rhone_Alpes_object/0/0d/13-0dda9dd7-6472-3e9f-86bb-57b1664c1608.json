  "rdfs:comment": {
    "de": [
      "Biologische und ökologisch verantwortungsvolle Kosmetika, die in Broût-Vernet hergestellt und verkauft werden. Handgemachte kaltverseifte Seifen, ausgewählte Rohstoffe, ohne umstrittene Inhaltsstoffe. Labels Cosmos Organic & Natural."
    ],
    "en": [
      "Manufacture and sale of organic and eco-responsible cosmetics."
    ],
    "it": [
      "Cosmetici biologici ed eco-responsabili prodotti e venduti a Broût-Vernet. Saponi artigianali saponificati a freddo, materie prime selezionate, nessun ingrediente controverso. Etichette Cosmos Organic & Natural."
    ],
    "fr": [
      "Cosmétiques bio et éco-responsables fabriqués et vendus  à Broût-Vernet. Savons artisanaux saponifiés à froid, matières premières sélectionnées, sans ingrédients controversés. Labels Cosmos Organic & Natural."
    ],
    "es": [
      "Cosméticos ecológicos y eco-responsables fabricados y vendidos en Broût-Vernet. Jabones artesanales saponificados en frío, materias primas seleccionadas, sin ingredientes controvertidos. Etiquetas Cosmos Organic & Natural."
    ],
    "nl": [
      "Biologische en ecologisch verantwoorde cosmetica gemaakt en verkocht in Broût-Vernet. Handgemaakte koudgezeepte zepen, geselecteerde grondstoffen, geen controversiële ingrediënten. Cosmos Organic & Natural labels."
    ]
  },
