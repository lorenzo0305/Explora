  "rdfs:comment": {
    "de": [
      "Ganz in der Nähe des Sees, auf dem Land und mit Blick auf die umliegenden Berge, genießen Sie französische Küche, die mit lokalen und saisonalen Produkten zubereitet wird."
    ],
    "en": [
      "Located close to the lake, in the middle of the countryside and surrounded by mountains, enjoy French cuisine, crafted with local and seasonal produce."
    ],
    "it": [
      "Vicino al lago, nel cuore della campagna, con vista sulle montagne circostanti, potrete gustare la cucina francese a base di prodotti locali e di stagione."
    ],
    "fr": [
      "Tout près du lac, en pleine campagne, avec vue sur les montagnes environnantes, dégustez une cuisine française élaborée avec des produits locaux et de saison."
    ],
    "nl": [
      "Dicht bij het meer, in het hart van het platteland, met uitzicht op de omringende bergen, geniet van de Franse keuken gemaakt met lokale, seizoensgebonden producten."
    ],
    "es": [
      "Cerca del lago, en plena campiña y con vistas a las montañas circundantes, disfrute de la cocina francesa elaborada con productos locales de temporada."
    ]
  },
