  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Montriond gelegen, öffnet das Empfangsbüro im Winter und im Sommer seine Türen für Sie: Unsere Tourismusberaterinnen bieten Ihnen alle Informationen, die Sie für einen gelungenen Aufenthalt im Vallée d'Aulps benötigen."
    ],
    "en": [
      "Located in the heart of Montriond village, the tourist office is open winter and summer. Our trained holiday advisers are ready to give you all the information you need to make your stay in the Valley d’Aulps a real success."
    ],
    "it": [
      "Situato nel cuore del villaggio di Montriond, l'ufficio di accoglienza vi apre le porte in inverno e in estate: i nostri consulenti turistici vi forniranno tutte le informazioni necessarie per il successo del vostro soggiorno nella Vallée d'Aulps."
    ],
    "fr": [
      "Situé au coeur du village de Montriond, le bureau d'accueil vous ouvre ses portes en hiver et en été : nos conseillères touristiques vous apporteront toutes les informations nécessaires à la réussite de votre séjour en Vallée d'Aulps."
    ],
    "es": [
      "Situada en el corazón del pueblo de Montriond, la oficina de recepción le abre sus puertas en invierno y en verano: nuestros asesores turísticos le proporcionarán toda la información necesaria para que su estancia en el Valle de Aulps sea un éxito."
    ],
    "nl": [
      "Gelegen in het hart van het dorp Montriond, opent de receptie haar deuren voor u in de winter en in de zomer: onze toeristische adviseurs zullen u alle informatie verstrekken die u nodig heeft om uw verblijf in de Vallée d'Aulps tot een succes te maken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vallée d'Aulps Tourist Office - Montriond Tourist Point"
    ],
    "fr": [
      "Vallée d'Aulps Tourisme - Bureau d'accueil de Montriond"
    ]
  },
