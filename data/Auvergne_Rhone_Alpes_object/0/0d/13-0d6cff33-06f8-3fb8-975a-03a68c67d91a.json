  "rdfs:comment": {
    "de": [
      "Die Auberge des Ris bietet hausgemachte Gerichte in einer angenehmen, grünen Umgebung mit Blick auf den Teich."
    ],
    "en": [
      "L'Auberge des Ris offers homemade dishes in a pleasant, green setting overlooking the pond."
    ],
    "it": [
      "L'Auberge des Ris serve piatti fatti in casa in un ambiente piacevole e verdeggiante con vista sul lago."
    ],
    "fr": [
      "L'Auberge des Ris propose des plats fait maison dans un endroit agréable et verdoyant avec vue sur l'étang."
    ],
    "es": [
      "El Auberge des Ris sirve platos caseros en un entorno agradable y frondoso con vistas al lago."
    ],
    "nl": [
      "De Auberge des Ris serveert huisgemaakte gerechten in een aangename, groene omgeving met uitzicht op het meer."
    ]
