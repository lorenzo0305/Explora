  "rdfs:comment": {
    "de": [
      "Große Auswahl in den klassischen Bereichen der Buchhandlung: Romane, Krimis, SF, Geschichte, Jugendliteratur, Alben, Spiele, Comics, Praktisches Leben, Außerschulisches und natürlich Werke über Savoyen und die Berge."
    ],
    "en": [
      "Important choice in the classical fields of bookshops: novels, detective stories, sf, history, children's literature, albums, games, comics, practical life, extracurricular and of course books on Savoie and the mountains."
    ],
    "it": [
      "Una vasta gamma di libri classici: romanzi, gialli, narrativa, storia, letteratura per ragazzi, album, giochi, fumetti, informazioni pratiche, libri per il doposcuola e, naturalmente, libri sulla Savoia e sulle montagne."
    ],
    "fr": [
      "Choix important dans les domaines classiques de la librairie : romans, policiers, sf, histoire, littérature pour la jeunesse, albums, jeux, BD, vie pratique, parascolaire et naturellement des ouvrages sur la Savoie et la montagne."
    ],
    "es": [
      "Una amplia gama de libros clásicos: novelas, novelas policíacas, ficción, historia, literatura infantil, álbumes, juegos, cómics, información práctica, libros extraescolares y, por supuesto, libros sobre Saboya y la montaña."
    ],
    "nl": [
      "Een ruime keuze aan klassieke boeken: romans, detectiveverhalen, fictie, geschiedenis, kinderliteratuur, albums, spelletjes, strips, praktische informatie, naschoolse boeken en natuurlijk boeken over de Savoie en de bergen."
    ]
  },
