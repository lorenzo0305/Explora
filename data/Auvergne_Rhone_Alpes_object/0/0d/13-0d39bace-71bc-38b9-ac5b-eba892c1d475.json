  "rdfs:comment": {
    "de": [
      "Handwerklich hergestellte Pizzas, überwiegend frische und lokale Produkte. Das Melsam empfängt Sie auch in seiner Café-Bar. Am Samstag lassen Sie die Seele baumeln: Karaoke und Stimmung sind garantiert. Willkommen in Ihrem neuen Dorfspot in den Farben von La Réunion!"
    ],
    "en": [
      "Homemade pizzas, mostly fresh local produce. Melsam also welcomes you to its bar-café. On Saturdays, you can let loose with karaoke and a guaranteed good time. Welcome to your new village spot, with its Réunion Island flair!"
    ],
    "it": [
      "Pizze fatte in casa, per lo più con prodotti freschi locali. Il Melsam dispone anche di un bar-caffetteria. Il sabato, potrete scatenarvi con il karaoke e un divertimento assicurato. Benvenuti nel vostro nuovo locale nel villaggio di Réunion!"
    ],
    "fr": [
      "Pizzas artisanales, produits majoritairement frais et locaux. Le Melsam vous accueille aussi à son bar-café. Le samedi, on lâche prise : karaoké et ambiance garantie. Bienvenue dans votre nouveau spot du village au couleur de la Réunion !"
    ],
    "es": [
      "Pizzas caseras, en su mayoría productos locales frescos. Melsam también tiene un bar-cafetería. Los sábados, karaoke y diversión asegurada. Bienvenido a tu nuevo lugar en el pueblo de Reunión"
    ],
    "nl": [
      "Huisgemaakte pizza's, voornamelijk verse lokale producten. Melsam heeft ook een bar-café. Op zaterdag kun je je uitleven met karaoke en een gegarandeerd goede tijd. Welkom op je nieuwe plek in het dorp Réunion!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Multiservices - Melsam Pizza"
    ]
  },
