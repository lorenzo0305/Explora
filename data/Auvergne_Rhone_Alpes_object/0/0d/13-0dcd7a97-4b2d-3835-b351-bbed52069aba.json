  "rdfs:comment": {
    "de": [
      "Nathalie Choiseau, staatlich geprüfte Alpinskilehrerin und Bergbegleiterin seit 2005, bietet Ihnen Privatunterricht oder gemeinsamen Unterricht in Alpinski und Snowboard sowie Snowboard-Gruppenkurse mit reduzierter Teilnehmerzahl (auf 6 Schüler begrenzt) an."
    ],
    "en": [
      "Nathalie Choiseau, state-qualified downhill ski instructor and mountain guide since 2005, offers private or shared lessons in downhill skiing and snowboarding, as well as small group snowboarding courses (limited to 6 students)."
    ],
    "it": [
      "Nathalie Choiseau, istruttrice di sci alpino e guida alpina diplomata dal 2005, offre lezioni private o condivise di sci alpino e snowboard, nonché lezioni di snowboard per piccoli gruppi (limitati a 6 studenti)."
    ],
    "fr": [
      "Nathalie Choiseau, monitrice de ski alpin diplômée d'Etat et accompagnatrice en montagne depuis 2005 vous propose des cours privés ou partagés en ski alpin et snowboard et des cours collectifs snowboard à effectif réduit (limités à 6 élèves)."
    ],
    "es": [
      "Nathalie Choiseau, monitora de esquí alpino titulada por el Estado y guía de montaña desde 2005, ofrece clases particulares o compartidas de esquí alpino y snowboard, así como clases de snowboard en grupos reducidos (limitados a 6 alumnos)."
    ],
    "nl": [
      "Nathalie Choiseau, gediplomeerd skileraar en berggids sinds 2005, biedt privé- of gedeelde lessen in alpineskiën en snowboarden, evenals snowboardlessen in kleine groepen (beperkt tot 6 leerlingen)."
    ]
  },
