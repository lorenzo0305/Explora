  "rdfs:comment": {
    "de": [
      "Der 2011 gegründete Verein Y'A PAS PHOTO vereint leidenschaftliche Fotografen, die über Royans-Vercors verteilt sind.\r\nIhre Fotos werden auf ihrer Website veröffentlicht und drehen sich um die umliegende Natur (Landschaften, Fauna, Flora) des Parc du Vercors."
    ],
    "en": [
      "Created in 2011, the Y'A PAS PHOTO association brings together photography enthusiasts from all over the Royans-Vercors region.\r\nPublished on their website, their photos revolve around the surrounding nature (landscapes, fauna, flora) of the Vercors Park."
    ],
    "it": [
      "Creata nel 2011, l'associazione Y'A PAS PHOTO riunisce gli appassionati di fotografia di tutta la regione di Royans-Vercors.\r\nPubblicate sul loro sito web, le loro foto ruotano attorno alla natura circostante (paesaggi, fauna, flora) del Parco del Vercors."
    ],
    "fr": [
      "Créé en 2011, l'association Y'A PAS PHOTO fédère des passionnés de photographie, répartis sur le Royans-Vercors.\r\nPublié sur leur site internet, leurs photos tournent autour de la nature environnante (paysages, faune, flore) du Parc du Vercors."
    ],
    "nl": [
      "De vereniging Y'A PAS PHOTO, opgericht in 2011, verenigt fotografieliefhebbers uit de hele regio Royans-Vercors.\r\nHun foto's worden gepubliceerd op hun website en draaien om de omringende natuur (landschappen, fauna, flora) van het Parc des Vercors."
    ],
    "es": [
      "Creada en 2011, la asociación Y'A PAS PHOTO reúne a aficionados a la fotografía de toda la región de Royans-Vercors.\r\nPublicadas en su página web, sus fotos giran en torno a la naturaleza circundante (paisajes, fauna, flora) del Parque del Vercors."
    ]
  },
  "rdfs:label": {
