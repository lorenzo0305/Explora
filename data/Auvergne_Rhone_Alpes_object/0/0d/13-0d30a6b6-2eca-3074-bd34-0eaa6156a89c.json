  "rdfs:comment": {
    "de": [
      "La Remise arbeitet mit den Müllsammel- und -verwertungsverbänden zusammen, um gebrauchten Gegenständen ein zweites Leben zu ermöglichen.\r\nDer Laden ist mittwochs, freitags und samstags von 10 bis 18 Uhr für die Öffentlichkeit geöffnet."
    ],
    "en": [
      "La Remise works with waste collection and processing associations to give used objects a second life.\r\nThe shop is open to the public on Wednesday, Friday and Saturday from 10am to 6pm."
    ],
    "it": [
      "La Remise collabora con associazioni di raccolta e trattamento dei rifiuti e con privati per dare una seconda vita agli oggetti usati.\r\nIl negozio è aperto al pubblico il mercoledì, venerdì e sabato dalle 10.00 alle 18.00."
    ],
    "fr": [
      "La Remise travaille en lien avec les syndicats de collecte, de traitement des déchets, et les particuliers pour offrir une deuxième vie aux objets usagés.\r\nBoutique ouverte au public le mercredi, vendredi et samedi de 10h à 18h."
    ],
    "nl": [
      "La Remise werkt samen met verenigingen voor afvalinzameling en -verwerking en particulieren om gebruikte voorwerpen een tweede leven te geven.\r\nDe winkel is open voor het publiek op woensdag, vrijdag en zaterdag van 10.00 tot 18.00 uur."
    ],
    "es": [
      "La Remise colabora con asociaciones de recogida y tratamiento de residuos y con particulares para dar una segunda vida a objetos usados.\r\nLa tienda está abierta al público los miércoles, viernes y sábados de 10.00 a 18.00 horas."
    ]
  },
