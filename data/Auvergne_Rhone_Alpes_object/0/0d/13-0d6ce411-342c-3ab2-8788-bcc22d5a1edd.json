  "rdfs:comment": {
    "de": [
      "Die Industrie- und Handelskammer des Departements Drôme hat die Aufgabe, die wirtschaftliche Entwicklung der Unternehmen in ihrem Gebiet zu unterstützen. Sie unterstützt Sie bei Ihren Gründungsprojekten, Innovationen, auf internationaler Ebene und bei der Ausbildung."
    ],
    "en": [
      "The mission of the Drôme Chamber of Commerce and Industry is to serve the economic development of businesses in its region. We support you in your start-up, innovation, international and training projects."
    ],
    "it": [
      "La CCI de la Drôme è impegnata nello sviluppo economico delle imprese della sua regione. Sostiene gli imprenditori e i direttori d'azienda, dall'avvio al trasferimento, passando per lo sviluppo e la formazione."
    ],
    "fr": [
      "La CCI de la Drôme est au service du développement économique des entreprises de son territoire. Elle accompagne les porteurs de projets et dirigeants d'entreprise, de la création à la transmission, en passant par le développement et la formation."
    ],
    "es": [
      "La CCI de la Drôme está comprometida con el desarrollo económico de las empresas de su región. Apoya a empresarios y directivos de empresas, desde su creación hasta su transmisión, pasando por el desarrollo y la formación."
    ],
    "nl": [
      "De missie van de Kamer van Koophandel en Industrie van de Drôme is om de economische ontwikkeling van bedrijven in haar gebied te dienen. U kunt er terecht voor projecten op het gebied van start-ups, innovatie, internationale samenwerking en opleiding."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chambre de commerce et d'industrie de la Drôme"
    ]
  },
