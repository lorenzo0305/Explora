  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser neues, auf indische Küche spezialisiertes Lokal im Herzen von Romans in der Nähe des Jacquemart-Turms.\r\nHier finden Sie die unumgänglichen Gerichte der indischen Gastronomie mit ihren süßen und duftenden Gewürzen."
    ],
    "en": [
      "Come and discover our new establishment specializing in Indian cuisine in the heart of Romans, near the Tour Jacquemart.\r\nDiscover the must-try Indian cuisine with its sweet and fragrant spices."
    ],
    "it": [
      "Venite a scoprire il nostro nuovo ristorante specializzato in cucina indiana nel cuore di Roma, vicino alla Tour Jacquemart.\r\nScoprite l'imperdibile cucina indiana con le sue spezie dolci e profumate."
    ],
    "fr": [
      "Venez découvrir notre nouvel établissement spécialisé dans la cuisine indienne au cœur de Romans près de la Tour Jacquemart.\r\nRetrouvez les incontournables de la gastronomie indienne aux épices douces et parfumées."
    ],
    "es": [
      "Venga a descubrir nuestro nuevo restaurante especializado en cocina india en el corazón de Romans, cerca de la Tour Jacquemart.\r\nDescubra la imprescindible cocina india con sus especias dulces y aromáticas."
    ],
    "nl": [
      "Kom en ontdek ons nieuwe restaurant gespecialiseerd in de Indiase keuken in het hart van Rome, vlakbij de Tour Jacquemart.\r\nOntdek de Indiase keuken met zijn zoete en geurige specerijen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spice and smile"
    ]
  },
