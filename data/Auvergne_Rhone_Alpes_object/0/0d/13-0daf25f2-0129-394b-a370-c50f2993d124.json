  "rdfs:comment": {
    "de": [
      "Eine der Säulen des Restaurants L'As ist sein Bestreben, lokale und saisonale Produkte in den Vordergrund zu stellen. Anaïs arbeitet eng mit ihrem Vater zusammen, einem Gemüsebauern in Montmeyran, der sie täglich mit frischem Gemüse versorgt."
    ],
    "en": [
      "One of the pillars of the L'As restaurant is its emphasis on local, seasonal produce. Anaïs works closely with her father, a market gardener in Montmeyran, who supplies her with fresh vegetables every day."
    ],
    "it": [
      "Uno dei pilastri del ristorante L'As è l'attenzione ai prodotti locali e di stagione. Anaïs lavora a stretto contatto con il padre, giardiniere del mercato di Montmeyran, che le fornisce ogni giorno verdure fresche."
    ],
    "fr": [
      "L'un des piliers du restaurant L'As est sa volonté de mettre en avant les produits locaux et de saison. Anaïs travaille en étroite collaboration avec son père, maraîcher à Montmeyran, qui lui fournit des légumes frais chaque jour."
    ],
    "es": [
      "Uno de los pilares del restaurante L'As es su énfasis en los productos locales y de temporada. Anaïs trabaja en estrecha colaboración con su padre, horticultor en Montmeyran, que le suministra verduras frescas todos los días."
    ],
    "nl": [
      "Een van de pijlers van restaurant L'As is de nadruk op lokale, seizoensgebonden producten. Anaïs werkt nauw samen met haar vader, een tuinder in Montmeyran, die haar elke dag van verse groenten voorziet."
    ]
  },
  "rdfs:label": {
