  "rdfs:comment": {
    "de": [
      "Parallele Activities steht für das Gleiten in der Luft und auf den Pisten im Gebiet der Portes du Soleil in Avoriaz! Parallele Activities begleitet dich bei deinen Winteraktivitäten, sei es beim Skifahren, Snowboarden oder bei einer Gleitschirmtaufe."
    ],
    "en": [
      "Parallèle Activities is all about skiing and snowboarding in the Portes du Soleil area of Avoriaz! Parallèle Activities will accompany you in your winter activities, whether it be skiing, snowboarding or paragliding."
    ],
    "it": [
      "Parallèle Activities si occupa di sci e snowboard nella zona delle Portes du Soleil di Avoriaz! Parallèle Activities vi accompagnerà nelle vostre attività invernali, che si tratti di sci, snowboard o parapendio."
    ],
    "fr": [
      "Parallèle Activities c’est de la glisse dans les airs et sur les pistes sur le domaine des Portes du Soleil à Avoriaz! Parallèle Activities t'accompagne dans tes activités hivernales, que ce soit en ski en snowboard ou pour un baptême de parapente."
    ],
    "es": [
      "Parallèle Activities se dedica al esquí y al snowboard en la zona de Portes du Soleil, en Avoriaz Parallèle Activities le acompañará en sus actividades de invierno, ya sea esquí, snowboard o parapente."
    ],
    "nl": [
      "Bij Parallèle Activities draait alles om skiën en snowboarden in het Portes du Soleil-gebied van Avoriaz! Parallèle Activities begeleidt u bij uw winteractiviteiten, of het nu gaat om skiën, snowboarden of paragliden."
    ]
  },
