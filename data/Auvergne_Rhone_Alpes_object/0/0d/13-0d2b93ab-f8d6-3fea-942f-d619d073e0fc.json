  "rdfs:comment": {
    "de": [
      "Der Trail de l'Améthyste 2026 bietet Ihnen ein umfangreiches Programm für Familien und Vereine als Jahresausflug: 3 Trailstrecken: 12, 23, 37 km. 4 Trails und Rennen für 8- bis 15-Jährige. Eine 13 km lange Wanderung."
    ],
    "en": [
      "The Trail de l'Améthyste 2026 offers a comprehensive program for families and clubs on annual outings: 3 trail courses: 12, 23, 37 km. 4 trails and races for 8- to 15-year-olds. A 13km hike."
    ],
    "it": [
      "Il Trail de l'Améthyste 2026 offre un programma completo per famiglie e club in occasione delle uscite annuali: 3 percorsi di trail: 12, 23 e 37 km. 4 percorsi e gare per ragazzi dagli 8 ai 15 anni. Un'escursione di 13 km."
    ],
    "fr": [
      "Le Trail de l’Améthyste 2026 vous propose un programme très complet pour les familles et les clubs en sortie annuelle : 3 parcours de trail : 12, 23, 37 km. 4 trails et courses pour les 8 à 15 ans. Une rando 13km."
    ],
    "es": [
      "El Trail de l'Améthyste 2026 ofrece un programa completo para familias y clubes en salidas anuales: 3 recorridos de trail: 12, 23 y 37 km. 4 recorridos de trail y carreras para niños de 8 a 15 años. Una caminata de 13 km."
    ],
    "nl": [
      "De Trail de l'Améthyste 2026 biedt een uitgebreid programma voor gezinnen en clubs op jaarlijkse uitstapjes: 3 parcours: 12, 23 en 37 km. 4 parcoursen en wedstrijden voor kinderen van 8 tot 15 jaar. Een wandeling van 13 km."
    ]
  },
