      "dc:description": {
        "de": [
          "Wir bieten Ihnen eine traditionelle und frische Küche, die reich an bestimmten lokalen Produkten ist, sowie saisonale Produkte als Vorschläge auf der Schiefertafel."
        ],
        "en": [
          "We offer traditional, fresh cuisine featuring local produce and seasonal suggestions on the slate."
        ],
        "it": [
          "Offriamo una cucina tradizionale e fresca con una selezione di prodotti locali e proposte stagionali sulla lavagna."
        ],
        "fr": [
          "Nous vous proposons une cuisine traditionnelle et fraîche riche en certains produits locaux et des produits de saison en suggestions à l'ardoise."
        ],
        "nl": [
          "We bieden een traditionele, verse keuken met een selectie van lokale producten en seizoensgebonden suggesties op de lei."
        ],
        "es": [
          "Ofrecemos una cocina tradicional y fresca con una selección de productos locales y sugerencias de temporada en la pizarra."
        ]
