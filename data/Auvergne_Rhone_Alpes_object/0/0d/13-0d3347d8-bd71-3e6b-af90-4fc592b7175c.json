  "rdfs:comment": {
    "de": [
      "Kommen Sie und probieren Sie die köstlichen Produkte unserer Region. Der Bauernhof von Nathalie - Rognard Biagui bietet Ihnen Ziegenkäse aus eigener Produktion und Geflügel aus Bresse AOP."
    ],
    "en": [
      "Come and taste the good products of our land. The Nathalie's Farm - Rognard Biagui offers you goat cheese from their production and Bresse PDO poultry."
    ],
    "it": [
      "Venite a degustare i nostri prodotti locali. Nathalie - L'azienda agricola Rognard Biagui offre formaggi di capra e pollame della Bresse DOP."
    ],
    "fr": [
      "Venez goûter les bons produits de notre terroir. La ferme de Nathalie - Rognard Biagui vous propose des fromages de chèvre de leur production et de la volaille de Bresse AOP."
    ],
    "es": [
      "Venga a degustar nuestros productos locales. Nathalie - La granja de Rognard Biagui ofrece queso de cabra y aves de corral DOP de Bresse."
    ],
    "nl": [
      "Kom onze streekproducten proeven. Nathalie - De boerderij van Rognard Biagui biedt geitenkaas en Bressepluimvee met BOB."
    ]
  },
