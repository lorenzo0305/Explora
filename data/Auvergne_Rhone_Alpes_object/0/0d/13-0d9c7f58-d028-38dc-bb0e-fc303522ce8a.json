  "rdfs:comment": {
    "de": [
      "Besuch des tropischen Gewächshauses, Sammlung von Rhipsalis, Begonien, Haworthia-Sammlung (Zimmer- und Verandapflanzen), CCVS (Conservatoire français des Collections Végétales Spécialisées) zugelassene Sammlung von Commelinaceae (Misères)."
    ],
    "en": [
      "Visit the tropical greenhouse, Rhipsalis collection, Begonias, Haworthia collection (houseplants, veranda plants), CCVS (Conservatoire français des Collections Végétales Spécialisées) approved collection of Commelinacées (Misères)."
    ],
    "it": [
      "Visita della serra tropicale, della collezione di Rhipsalis, Begonie, della collezione di Haworthia (piante da interno, piante da veranda), della collezione approvata del CCVS (Conservatoire français des Collections Végétales Spécialisées) di Commelinacées (Miseries)."
    ],
    "fr": [
      "Visite de la serre tropicale, collection de Rhipsalis, Bégonias, collection d'Haworthia (plantes d'intérieur, de véranda), collection agréée CCVS (Conservatoire français des Collections Végétales Spécialisées) de Commelinacées  (Misères)."
    ],
    "es": [
      "Visita del invernadero tropical, colección de Rhipsalis, Begonias, colección de Haworthia (plantas de interior, plantas de veranda), CCVS (Conservatoire français des Collections Végétales Spécialisées) colección aprobada de Commelinacées (Miserias)."
    ],
    "nl": [
      "Bezoek de tropische kas met zijn collectie Rhipsalis, Begonia's, Haworthia (kamer- en serreplanten) en de CCVS (Conservatoire français des Collections Végétales Spécialisées) erkende collectie Commelinacées (Misères)."
    ]
  },
