  "rdfs:comment": {
    "de": [
      "VazyViens ist ein Kollektiv, das das kulturelle Angebot bereichern möchte! Ziel ist es, die Kultur im vassivainischen Raum zu entwickeln, indem der Zugang dazu gefördert wird."
    ],
    "en": [
      "VazyViens is a collective dedicated to enriching the cultural offering! The aim is to develop culture in the Vazy area by promoting access to it."
    ],
    "it": [
      "VazyViens è un gruppo desideroso di arricchire l'offerta culturale! L'obiettivo è quello di sviluppare la cultura nell'area di Vazy promuovendone l'accesso."
    ],
    "fr": [
      "VazyViens est un collectif désireux d'enrichir l'offre culturelle ! L'objectif est de développer la culture dans l'espace vassivain en favorisant son accès."
    ],
    "nl": [
      "VazyViens is een groep die het culturele aanbod wil verrijken! Het doel is om cultuur in de regio Vazy te ontwikkelen door de toegang ertoe te bevorderen."
    ],
    "es": [
      "VazyViens es un grupo que desea enriquecer la oferta cultural Su objetivo es desarrollar la cultura en la zona de Vazy fomentando el acceso a ella."
    ]
  },
