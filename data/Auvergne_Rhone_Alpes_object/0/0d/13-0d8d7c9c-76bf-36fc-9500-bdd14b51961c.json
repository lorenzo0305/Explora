  "rdfs:comment": {
    "de": [
      "Créa'tures Couture ist ein Unternehmen, das Stoffkreationen rund um die Zero-Waste-Bewegung und Upcycling sowie verschiedene Näharbeiten in Langeac anbietet."
    ],
    "en": [
      "Créa'tures Couture is a company specializing in fabric creations around the zero-waste and upcycling movement, as well as various sewing projects in Langeac."
    ],
    "it": [
      "Créa'tures Couture è un'azienda di design di tessuti basata sul movimento \"zero-waste\" e sull'upcycling, oltre a una serie di progetti di cucito a Langeac."
    ],
    "fr": [
      "Créa'tures Couture est une entreprise de créations en tissu autour du mouvement zéro déchet et du upcycling, ainsi que de divers travaux de couture à Langeac."
    ],
    "nl": [
      "Créa'tures Couture is een stoffenontwerpbedrijf dat is gebaseerd op de zero-waste en upcycling beweging, evenals een verscheidenheid aan naaiprojecten in Langeac."
    ],
    "es": [
      "Créa'tures Couture es una empresa de diseño de tejidos basada en los movimientos \"cero residuos\" y \"upcycling\", así como en diversos proyectos de costura en Langeac."
    ]
  },
