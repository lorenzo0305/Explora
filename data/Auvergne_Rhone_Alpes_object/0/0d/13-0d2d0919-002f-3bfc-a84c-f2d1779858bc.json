  "rdfs:comment": {
    "de": [
      "Benjamin, Therapeut, Magnetiseur und Wellness-Coach, hat jahrelange Erfahrung in der energetischen Harmonisierung und bietet Ihnen die Möglichkeit, von seinen Fähigkeiten und Erfahrungen zu profitieren, die er an der Schnittstelle verschiedener Zivilisationen und Kulturen gesammelt hat."
    ],
    "en": [
      "Benjamin, a therapist, magnetizer and well-being coach, has many years' experience in energy harmonisation, and offers you the benefit of his skills and experience stemming from the meeting point of a variety of civilisations and cultures."
    ],
    "it": [
      "Con diversi anni di esperienza nell'armonizzazione energetica, Benjamin, terapeuta - magnetizzatore e coach del benessere, vi offre il beneficio delle sue competenze e della sua esperienza al crocevia di diverse civiltà e culture."
    ],
    "fr": [
      "Fort d'une expérience de plusieurs années en harmonisation énergétique, Benjamin, thérapeute - magnétiseur et coach bien être - vous propose de bénéficier de ses compétences et de ses expériences au carrefour de plusieurs civilisations et cultures."
    ],
    "nl": [
      "Met zijn jarenlange ervaring in energieharmonisatie biedt Benjamin, therapeut, magnetiseur en welzijnscoach, je het voordeel van zijn vaardigheden en ervaring op het kruispunt van verschillende beschavingen en culturen."
    ],
    "es": [
      "Con varios años de experiencia en armonización energética, Benjamin, terapeuta - magnetizador y coach de bienestar - le ofrece el beneficio de sus habilidades y experiencia en la encrucijada de varias civilizaciones y culturas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Well-being coaching, energy treatments and harmonising your surroundings"
    ],
    "fr": [
      "Coaching bien-être, soins énergétiques et harmonisations des lieux"
    ],
    "nl": [
      "Welzijnscoaching, energiebehandelingen en het harmoniseren van je omgeving"
    ]
  },
