  "rdfs:comment": {
    "de": [
      "Drehen Sie die Zeit zurück, teilen Sie antike Geheimnisse und bewundern Sie die feinen Kreationen der damaligen Zeit! Verlängern Sie Ihre Entdeckungsreise anschließend im Entspannungsbereich der Boutique."
    ],
    "en": [
      "Set in a former pottery the museum dis- plays hundreds of artefacts from the Lezoux archaeological site, and offers several activities."
    ],
    "it": [
      "Fate un salto indietro nel tempo, condividete antichi segreti e ammirate la finezza delle creazioni di quell'epoca! Continuate poi la vostra scoperta nell'area relax della boutique."
    ],
    "fr": [
      "Remontez le temps, partagez d’antiques secrets et admirez la finesse des créations de l’époque ! Prolongez en suite la découverte dans l'espace détente de la boutique."
    ],
    "nl": [
      "Stap terug in de tijd, deel eeuwenoude geheimen en bewonder de finesse van creaties uit die tijd! Zet je ontdekkingstocht daarna voort in de ontspanningsruimte van de boetiek."
    ],
    "es": [
      "Retroceda en el tiempo, comparta antiguos secretos y admire la delicadeza de las creaciones de aquella época Después, continúe su descubrimiento en la zona de relajación de la boutique."
    ]
  },
  "rdfs:label": {
