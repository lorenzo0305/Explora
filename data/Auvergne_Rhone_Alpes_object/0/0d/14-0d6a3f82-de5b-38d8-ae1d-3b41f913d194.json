  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e44761dd-13f0-3c17-b74d-8d7049ae09d5",
      "dc:description": {
        "de": [
          "Die Mediathek von Camiers organisiert einen Zeichenwettbewerb zum Thema \"Die Olympischen Spiele und ihre Werte\", an dem Kinder von 3 bis 12 Jahren teilnehmen können. Die Regeln finden Sie auf der Website www.camiers.fr oder in der Mediathek während der üblichen Öffnungszeiten."
        ],
        "en": [
          "The Camiers media library is organizing a drawing competition on the theme of \"The Olympic Games and their values\", open to children aged 3 to 12. Rules to be found on www.camiers.fr or at the media library during normal opening hours."
        ],
        "it": [
          "La mediateca di Camiers organizza un concorso di disegno sul tema \"I Giochi Olimpici e i loro valori\", aperto ai bambini dai 3 ai 12 anni. Il regolamento è disponibile sul sito web www.camiers.fr o presso la mediateca durante i normali orari di apertura."
        ],
        "fr": [
          "La médiathèque de Camiers organise un concours de dessin sur le thème \"Les Jeux Olympiques et leurs valeurs\" ouvert aux enfants de 3 à 12 ans. Règlement à retrouver sur le site www.camiers.fr ou auprès de la médiathèque lors des horaires habituels d'ouverture."
        ],
        "es": [
          "La mediateca de Camiers organiza un concurso de dibujo sobre el tema \"Los Juegos Olímpicos y sus valores\", abierto a niños de 3 a 12 años. Las bases pueden consultarse en la página web www.camiers.fr o en la mediateca en horario de apertura."
        ],
        "nl": [
          "De mediatheek van Camiers organiseert een tekenwedstrijd met als thema \"De Olympische Spelen en hun waarden\", voor kinderen van 3 tot 12 jaar. De spelregels zijn te vinden op de website www.camiers.fr of in de mediatheek tijdens de normale openingstijden."
        ]
      },
      "@type": [
        "Description"
      ],
