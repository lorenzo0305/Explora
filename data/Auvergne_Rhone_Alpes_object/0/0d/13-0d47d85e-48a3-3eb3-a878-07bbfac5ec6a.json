  "rdfs:comment": {
    "de": [
      "La Boule de Neige empfängt Sie morgens, mittags und abends zum Frühstück, um die Spezialitäten aus Savoyen zu genießen oder eine Schlemmerpause bei einer heißen Schokolade auf der Terrasse einzulegen. Ob vor Ort oder zum Mitnehmen, schlemmen Sie, wo immer Sie wollen!"
    ],
    "en": [
      "La Boule de Neige welcomes you morning, noon and night for breakfast, to savour Savoyard specialities or to take a gourmet break with a hot chocolate on the terrace. Eat in or take away, enjoy wherever you like!"
    ],
    "it": [
      "La Boule de Neige vi accoglie mattina, mezzogiorno e sera per la colazione, per le specialità savoiarde o per una pausa golosa con una cioccolata calda in terrazza. Sul posto o da asporto, concedetevi dove volete!"
    ],
    "fr": [
      "La Boule de Neige vous accueille matin, midi et soir pour le petit-déjeuner, savourer les spécialités savoyardes ou faire une pause gourmande autour d’un chocolat chaud en terrasse. Sur place ou à emporter, régalez-vous où vous voulez !"
    ],
    "nl": [
      "La Boule de Neige verwelkomt u 's ochtends, 's middags en 's avonds voor het ontbijt, om te genieten van Savoyaardse specialiteiten of om even te pauzeren met een warme chocolademelk op het terras. Ter plaatse of om mee te nemen, geniet waar u maar wilt!"
    ],
    "es": [
      "La Boule de Neige le recibe mañana, tarde y noche para desayunar, degustar especialidades saboyanas o disfrutar de una pausa gastronómica con un chocolate caliente en la terraza. Allí mismo o para llevar, ¡dése el capricho que más le apetezca!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Boule de neige"
    ]
  },
