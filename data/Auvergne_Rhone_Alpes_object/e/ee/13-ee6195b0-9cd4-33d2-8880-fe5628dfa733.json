  "rdfs:comment": {
    "de": [
      "Die in Mandailles Saint Julien angesiedelte Naturstation ist der Empfangs- und Ausgangspunkt für zahlreiche Outdoor-Aktivitäten, unabhängig davon, ob Sie selbstständig sind oder von Fachleuten betreut werden möchten"
    ],
    "en": [
      "The Mandailles Saint Julien nature resort is the starting point for a wide range of outdoor activities, whether you're on your own or looking for professional supervision"
    ],
    "it": [
      "Il resort naturale di Mandailles Saint Julien è il punto di partenza per un'ampia gamma di attività all'aperto, sia che siate da soli sia che cerchiate una supervisione professionale"
    ],
    "fr": [
      "La Station de pleine nature implantée à Mandailles Saint Julien est le point d'accueil et de départ de nombreuses activités de plein air que vous soyez en autonomie ou souhaitant être encadré par des professionnels"
    ],
    "es": [
      "La estación natural de Mandailles Saint Julien es el punto de partida de un amplio abanico de actividades al aire libre, ya sea por su cuenta o con la supervisión de un profesional"
    ],
    "nl": [
      "Het natuurresort Mandailles Saint Julien is het startpunt voor een breed scala aan buitenactiviteiten, of je nu alleen bent of op zoek bent naar professionele begeleiding"
    ]
  },
  "rdfs:label": {
