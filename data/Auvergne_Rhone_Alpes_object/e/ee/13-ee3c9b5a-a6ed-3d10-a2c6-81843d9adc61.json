  "rdfs:comment": {
    "de": [
      "Ein Ort, an dem Austausch immer erwünscht ist!\r\nSammlung von Büchern, Comics und Mangas.\r\nLandkarten der Gegend und Flyer über Orte, die man besuchen kann.\r\nPuzzles und Gesellschaftsspiele."
    ],
    "en": [
      "A place where exchanges are always encouraged!\r\nCollection of books, comics, mangas.\r\nLocal maps and flyers on places to visit.\r\nPuzzles and board games."
    ],
    "it": [
      "Un luogo dove la condivisione è sempre incoraggiata!\r\nCollezione di libri, fumetti e manga.\r\nMappe della zona e volantini sui luoghi da visitare.\r\nPuzzle e giochi da tavolo."
    ],
    "fr": [
      "Lieu où les échanges sont toujours encouragés !\r\nCollection de livres, BD, mangas.\r\nCartes du coin et flyers sur les endroits à visiter.\r\nPuzzles et jeux de société."
    ],
    "es": [
      "¡Un lugar donde siempre se anima a compartir!\r\nColección de libros, cómics y manga.\r\nMapas de la zona y folletos sobre lugares para visitar.\r\nPuzzles y juegos de mesa."
    ],
    "nl": [
      "Een plek waar delen altijd wordt aangemoedigd!\r\nVerzameling boeken, strips en manga.\r\nKaarten van de omgeving en flyers over plaatsen om te bezoeken.\r\nPuzzels en bordspellen."
    ]
  },
