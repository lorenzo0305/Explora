  "rdfs:comment": {
    "de": [
      "Bar und Restaurant.\r\nFranzösisch-belgische Gastronomie im Stil einer Brasserie in den Räumlichkeiten der ehemaligen Quelle Saint-Pardoux in Theneuille. Das Restaurant grenzt an die Werkstatt für handgefertigte Gravuren.\r\nGemütliche Atmosphäre von Donnerstag bis Montag."
    ],
    "en": [
      "Bar-restaurant.\r\nFrench-Belgian brasserie-style restaurant on the premises of the former Saint-Pardoux de Theneuille spring. The restaurant adjoins the artisanal engraving workshop.\r\nWarm atmosphere Thursday to Monday."
    ],
    "it": [
      "Bar-ristorante.\r\nRistorante in stile brasserie franco-belga nei locali dell'ex sorgente Saint-Pardoux a Theneuille. Il ristorante è adiacente al laboratorio di incisione artigianale.\r\nAtmosfera calda da giovedì a lunedì."
    ],
    "fr": [
      "Bar-restaurant.\r\nRestauration franco-belge, type brasserie, dans les locaux de l'ancienne source Saint-Pardoux de Theneuille. Le restaurant jouxte l'atelier de gravures artisanales.\r\nAmbiance chaleureuse du jeudi au lundi."
    ],
    "es": [
      "Bar-restaurante.\r\nRestaurante tipo brasserie franco-belga situado en el antiguo manantial Saint-Pardoux de Theneuille. El restaurante linda con el taller de grabado artesanal.\r\nAmbiente acogedor de jueves a lunes."
    ],
    "nl": [
      "Bar-restaurant.\r\nFrans-Belgisch restaurant in brasseriestijl in de voormalige bron Saint-Pardoux in Theneuille. Het restaurant grenst aan het handgemaakte graveeratelier.\r\nGezellige sfeer van donderdag tot maandag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie La Source des Plaisirs"
    ]
  },
