  "rdfs:comment": {
    "de": [
      "Stellen Sie Ihr Fahrrad einfach und sicher in den dafür vorgesehenen Hütten ab. Verwenden Sie Ihr Fahrradschloss. Bewahren Sie Ihr Fahrrad an einem geschützten Ort auf."
    ],
    "en": [
      "Park your bike easily and securely in the dedicated cabins. Use your lock. Keep your bike safe."
    ],
    "it": [
      "Parcheggiate la vostra bicicletta in modo sicuro e semplice nei capannoni dedicati. Utilizzate il vostro lucchetto. Tenete la vostra bicicletta al sicuro."
    ],
    "fr": [
      "Garez votre vélo facilement et en sécurité dans les cabanes dédiées. Utilisez votre cadenas. Gardez votre vélo à l'abri."
    ],
    "nl": [
      "Parkeer je fiets veilig en gemakkelijk in de speciale fietsenstallingen. Gebruik je slot. Houd je fiets veilig."
    ],
    "es": [
      "Aparque su bicicleta de forma segura y sencilla en los cobertizos específicos para bicicletas. Utilice su candado. Mantenga su bicicleta a salvo."
    ]
  },
