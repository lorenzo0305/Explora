  "rdfs:comment": {
    "de": [
      "Entdeckung der althergebrachten Destillation (Bio-Lavendel und -Lavandin), des Unterschieds zwischen diesen beiden Pflanzen, der ätherischen Öle und Verkauf von Produkten aus der Region: Nussöl, Lavendelhonig, handgemachte Lavendelseife, Gesichtscreme, Parfum."
    ],
    "en": [
      "Discover the ancestral distillation process (organic lavender and lavendin) and learn the differences between the two. We also sell  regional products : walnut oil, lavender honey, artisanal lavender soap, moisturizer and fragrances."
    ],
    "it": [
      "Scoperta della distillazione ancestrale (lavanda biologica e lavandina), della differenza tra queste due piante, degli oli essenziali e vendita di prodotti locali: olio di noce, miele di lavanda, sapone artigianale alla lavanda, crema per il viso, profumo."
    ],
    "fr": [
      "Découverte de la distillation ancestrale (lavande et lavandin bio), de la différence entre ces deux plantes, des huiles essentielles et vente des produits du terroir : huile de noix, miel de lavande, savon artisanal à la lavande, crème visage, parfum."
    ],
    "nl": [
      "Ontdek de eeuwenoude manier van distilleren van lavendel en lavandin, het verschil tussen beide planten en de etherische oliën. Verkoop ter plekke van specialiteiten uit de streek: walnotenolie, lavendelhoning, ambachtelijke lavendelzeep, verzorgingscrème, parfum."
    ],
    "es": [
      "Descubrimiento de la destilación ancestral (lavanda orgánica y lavandín), la diferencia entre estas dos plantas, los aceites esenciales y la venta de productos locales: aceite de nuez, miel de lavanda, jabón artesanal de lavanda, crema facial, perfume."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bleudiois Lavender Oil Distillery"
    ],
    "fr": [
      "Bleudiois - Distillerie de lavande"
    ],
    "nl": [
      "Bleudiois - Distillerie de lavande"
    ]
  },
