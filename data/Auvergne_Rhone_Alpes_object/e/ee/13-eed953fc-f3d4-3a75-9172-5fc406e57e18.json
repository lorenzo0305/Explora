  "rdfs:comment": {
    "de": [
      "Das Hotel Restaurant Alpen Roc in Morzine Avoriaz in der Haute-Savoie vermietet ausgestattete Zimmer, Appartements mit Garten und Sommerschwimmbad, für Ihre Wanderungen und Skifahrten, im Herzen des wunderschönen Gebiets \"Portes du Soleil\"."
    ],
    "en": [
      "The Hotel Restaurant Alpen Roc in Morzine Avoriaz, Haute-Savoie, offers fully-equipped rooms and apartments with gardens and summer swimming pools for hiking and skiing, in the heart of the magnificent \"Portes du Soleil\" ski area."
    ],
    "it": [
      "L'Hotel Restaurant Alpen Roc di Morzine Avoriaz, in Alta Savoia, offre camere e appartamenti completamente attrezzati con giardino e piscina estiva per le vostre escursioni e sciate nel cuore della magnifica zona delle Portes du Soleil."
    ],
    "fr": [
      "L'Hôtel Restaurant Alpen Roc à Morzine Avoriaz en Haute-Savoie propose la location de chambres équipées, d'appartements avec jardin et piscine d'été, pour vos randonnées et faire du ski, au coeur du magnifique domaine des \"Portes du Soleil\"."
    ],
    "nl": [
      "Hôtel Restaurant Alpen Roc in Morzine Avoriaz in Haute-Savoie biedt volledig uitgeruste kamers en appartementen met tuinen en zomerzwembaden, om te wandelen en te skiën, in het hart van het prachtige skigebied \"Portes du Soleil\"."
    ],
    "es": [
      "El Hotel Restaurante Alpen Roc de Morzine Avoriaz, en la Alta Saboya, le ofrece habitaciones y apartamentos totalmente equipados con jardín y piscina de verano para sus excursiones y sus esquís en el corazón de la magnífica zona de \"Portes du Soleil\"."
    ]
  },
  "rdfs:label": {
