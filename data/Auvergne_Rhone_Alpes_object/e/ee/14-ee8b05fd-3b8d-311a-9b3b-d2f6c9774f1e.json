  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9b2f140a-a33e-3c4e-8708-062f8f110be9",
      "dc:description": {
        "de": [
          "Verein, der sich zum Ziel gesetzt hat, die Isolation von Menschen durch verschiedene Workshops in einer geselligen Atmosphäre zu bekämpfen: Englisch-, Spanisch- und Computerkurse, aber auch Stricken und kreative Hobbys."
        ],
        "en": [
          "Association which aims to fight against the isolation of people through various workshops in a friendly atmosphere: English, Spanish and computer courses, but also knitting, creative leisure activities."
        ],
        "it": [
          "Associazione che si propone di combattere l'isolamento delle persone attraverso vari laboratori in un'atmosfera amichevole: corsi di inglese, spagnolo, informatica, ma anche lavori a maglia, attività ricreative creative."
        ],
        "fr": [
          "Association qui a pour but de lutter contre l'isolement des personnes par le biais d'ateliers divers dans une ambiance conviviale : cours d'Anglais, d'Espagnol, d'informatique, mais aussi tricot, loisirs créatifs."
        ],
        "nl": [
          "Vereniging die het isolement van mensen wil bestrijden door middel van verschillende workshops in een gezellige sfeer: Engels, Spaans, computercursussen, maar ook breien, creatieve vrijetijdsbesteding."
        ],
        "es": [
          "Asociación que pretende luchar contra el aislamiento de las personas a través de diversos talleres en un ambiente acogedor: inglés, español, cursos de informática, pero también tejido, ocio creativo."
        ]
      },
