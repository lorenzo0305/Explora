  "rdfs:comment": {
    "de": [
      "Wenn die Nacht hereinbricht, entdecken Sie mit Ihrer Familie, was dieses hochgelegene Dorf zu erzählen hat. Machen wir uns gemeinsam auf den Weg, um mehr über die Baronnies zu erfahren."
    ],
    "en": [
      "At dusk, come and discover with your family what this perched village has to say. Let's set off together to find out more about the Baronnies."
    ],
    "it": [
      "Al calar della sera, venite a scoprire con la vostra famiglia cosa ha da dire questo villaggio in cima alla collina. Partiamo insieme per scoprire di più sulle Baronnies."
    ],
    "fr": [
      "À la tombée de la nuit, venez découvrir en famille ce que raconte ce village perché. Partons ensemble afin d'en connaître plus sur les Baronnies."
    ],
    "nl": [
      "Kom bij het vallen van de avond samen met je gezin ontdekken wat dit dorp op een heuvel te vertellen heeft. Laten we samen op pad gaan om meer te weten te komen over de Baronnies."
    ],
    "es": [
      "Al caer la noche, venga a descubrir en familia lo que tiene que contarle este pueblo situado en lo alto de una colina. Salgamos juntos a descubrir más cosas sobre las Baronnies."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mythes et légendes dans les Baronnies"
    ]
  },
