  "rdfs:comment": {
    "de": [
      "Mittelalterliche Kämpfe für Kinder und Erwachsene.\r\nOb mit Freunden, der Familie, auf Geburtstagen oder anderen Veranstaltungen - nehmen Sie mit unseren ebenso beeindruckend realistischen wie harmlosen Waffen an mittelalterlichen Kämpfen teil."
    ],
    "en": [
      "Medieval combat for children and adults.\r\nWith friends or family, for your birthday party or any other event, come and take part in medieval battles using our weapons, which are as impressive in their realism as they are in their harmlessness."
    ],
    "it": [
      "Combattimenti medievali per bambini e adulti.\r\nCon gli amici, la famiglia, per i vostri compleanni o per qualsiasi altro evento, venite a partecipare a combattimenti medievali con le nostre armi, tanto impressionanti quanto innocue."
    ],
    "fr": [
      "Combats médiévaux pour enfants et adultes.\r\nEntre amis, en famille, pour vos anniversaires ou pour tous autres événements, venez participer à des combats médiévaux  grâce à nos armes aussi impressionnantes de réalisme qu’inoffensives."
    ],
    "es": [
      "Peleas medievales para niños y adultos.\r\nCon los amigos, la familia, para sus cumpleaños o para cualquier otro evento, venga a participar en combates medievales con nuestras armas tan impresionantes como inofensivas."
    ],
    "nl": [
      "Middeleeuwse gevechten voor kinderen en volwassenen.\r\nKom met vrienden, familie, voor uw verjaardag of voor elk ander evenement deelnemen aan middeleeuwse gevechten met onze even indrukwekkende als ongevaarlijke wapens."
    ]
  },
  "rdfs:label": {
    "en": [
      "Woodclan Battle : Medieval War for children and adult"
    ],
    "fr": [
      "Woodclan Battle : Combats médiévaux pour enfants et adultes"
    ]
  },
