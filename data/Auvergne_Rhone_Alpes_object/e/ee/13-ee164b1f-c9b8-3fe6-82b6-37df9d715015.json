  "rdfs:comment": {
    "de": [
      "Le Tire Fesses bietet Ihnen vor Ort oder zum Mitnehmen handgemachte Pizzas aus Bio-Mehl. Burger mit hausgemachten Brötchen. Individuelle Spezialitäten aus Savoyen. Gerichte des Tages.  Bar und Après-Ski. Gruppen werden akzeptiert. Vom Routard empfohlen."
    ],
    "en": [
      "Sunny or covered & heated terrace. Savoyard specialties, pizzas made with organic flour and Fior Di Latte mozzarella, homemade bread burgers, slate dishes to be closer to the short chain. Takeaway. Recommended by the \"Routard\""
    ],
    "it": [
      "Le Tire Fesses vi offre pizze fatte in casa con farine biologiche, da mangiare o da portare via. Hamburger con panini fatti in casa. Specialità savoiarde individuali. Specialità giornaliere.  Bar e après-ski. Accoglienza gruppi. Raccomandato da Le Routard."
    ],
    "fr": [
      "Le Tire Fesses vous propose sur place ou à emporter des pizzas artisanales à base de farines bio. Des burgers aux buns maison. Des spécialités savoyardes individuelles. Des plats du jour.  Bar et après-ski. Groupes acceptés. Recommandé par le Routard."
    ],
    "es": [
      "Le Tire Fesses le ofrece pizzas caseras elaboradas con harinas ecológicas, para comer en casa o para llevar. Hamburguesas con pan casero. Especialidades individuales de Saboya. Ofertas del día.  Bar y après-ski. Acogida de grupos. Recomendado por Le Routard."
    ],
    "nl": [
      "Le Tire Fesses biedt je huisgemaakte pizza's gemaakt met biologisch meel, om te eten of om mee te nemen. Burgers met zelfgemaakte broodjes. Individuele Savoyaardse specialiteiten. Dagelijkse specialiteiten.  Bar en après-ski. Groepen welkom. Aanbevolen door Le Routard."
    ]
  },
