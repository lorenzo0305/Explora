  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b6ca7951-2655-309e-9680-817bd99e7bc5",
      "dc:description": {
        "de": [
          "Aktivitäten für Jugendliche* + Parade\nFreitag, den 31. Oktober 2025\nVon 14:30 bis 17:00 Uhr\n-----------------------------\n*6-10 Jahre: Dekoration des Wagens & handwerkliche Aktivitäten\n11-17 Jahre: Kürbiswettbewerb, Halloween-Spritzgebäck & gruseliger Werwolf\n\nAnschließend kostenloser Kostümumzug ab 17:30 Uhr\nStart: Place de la Libération (Platz der Befreiung)\n-----------------------------\nWettbewerb für das beste Kostüm & Abstimmung über den schönsten (oder gruseligsten) Kürbis auf dem Rückweg! Eine Suppe wird angeboten.\nKostenlos ? Die Kinder werden von einem Betreuer begleitet\nLaden Sie das Anmeldeformular auf der rechten Seite des Bildschirms herunter!\n\nInformationen: 06 15 95 49 33 oder per E-Mail: comitedesfetes62170@gmail.com\nCredit: Pixabay"
        ],
        "en": [
          "Activities for young people* + parade\nFriday, October 31, 2025\n2:30 pm to 5 pm\n-----------------------------\n*6-10 yrs: float decoration & manual activities\n11-17 yrs: pumpkin contest, Halloween shortbread & terrifying werewolf\n\nFollowed by a free costume parade from 5:30pm\nDeparture: Place de la Libération\n-----------------------------\nContest for the best disguise & vote for the most beautiful (or scariest) pumpkin on the way back! Free soup.\nFree admission ? Children must be accompanied by a leader\nDownload the registration form on the right!\n\nInformation: 06 15 95 49 33 or by e-mail: comitedesfetes62170@gmail.com\nCredit : Pixabay"
        ],
        "it": [
          "Attività per i giovani* + sfilata\nVenerdì 31 ottobre 2025\nDalle 14.30 alle 17.00\n-----------------------------\n*6-10 anni: decorazione del carro e attività manuali\n11-17 anni: gara di zucche, frollini di Halloween e terrificante lupo mannaro\n\nA seguire, sfilata in maschera gratuita dalle 17.30\nPartenza: Place de la Libération\n-----------------------------\nConcorso per il miglior travestimento e voto per la zucca più bella (o più spaventosa) al ritorno! Zuppa gratuita.\nIngresso libero? I bambini devono essere accompagnati da un responsabile\nScarica il modulo di iscrizione a destra dello schermo!\n\nInformazioni: 06 15 95 49 33 o via e-mail: comitedesfetes62170@gmail.com\nCredito: Pixabay"
        ],
        "fr": [
          "Activités pour jeunes* + défilé \nVendredi 31 octobre 2025\nDe 14h30 à 17h\n-----------------------------\n*6-10 ans : décoration du char & activités manuelle\n11-17 ans : concours de citrouilles, sablés d’Halloween & loup-garou terrifiant\n\nSuivi d’un défilé déguisé gratuit à partir de 17h30\nDépart : Place de la Libération\n-----------------------------\nConcours du meilleur déguisement & vote de la plus belle (ou la plus effrayante citrouille au retour ! Une soupe offerte.\nGratuit – Les enfants seront accompagnés d’un responsable\nTéléchargez le bulletin d’inscription à droite de l’écran !\n\nRenseignements : 06 15 95 49 33 ou par mail : comitedesfetes62170@gmail.com\nCrédit : Pixabay"
        ],
        "nl": [
          "Activiteiten voor jongeren* + parade\nVrijdag 31 oktober 2025\n14.30 tot 17.00 uur\n-----------------------------\n*6-10 jaar: versieren van de praalwagen & manuele activiteiten\n11-17 jaar: pompoenwedstrijd, Halloween zandkoekjes & angstaanjagende weerwolf\n\nGevolgd door een gratis verkleedoptocht vanaf 17.30 uur\nVertrek: Place de la Libération\n-----------------------------\nWedstrijd voor de beste vermomming & stem voor de mooiste (of engste) pompoen op de terugweg! Gratis soep.\nGratis toegang? Kinderen moeten begeleid worden door een leider\nDownload het inschrijfformulier rechts op het scherm!\n\nInformatie: 06 15 95 49 33 of per e-mail: comitedesfetes62170@gmail.com\nKrediet: Pixabay"
        ],
        "es": [
          "Actividades para jóvenes* + desfile\nViernes 31 de octubre de 2025\n14h30 a 17h00\n-----------------------------\n*6-10 años: decoración de la carroza y actividades manuales\n11-17 años: concurso de calabazas, galletas de Halloween y hombre lobo terrorífico\n\nSeguido de un desfile de disfraces gratuito a partir de las 17.30 h\nSalida: Place de la Libération\n-----------------------------\nConcurso para el mejor disfraz y votación de la calabaza más bonita (o más terrorífica) a la vuelta Sopa gratis.\nEntrada gratuita ? Los niños deben ir acompañados de un responsable\n¡Descarga el formulario de inscripción a la derecha de la pantalla!\n\nInformación: 06 15 95 49 33 o por correo electrónico: comitedesfetes62170@gmail.com\nCrédito: Pixabay"
        ]
      },
