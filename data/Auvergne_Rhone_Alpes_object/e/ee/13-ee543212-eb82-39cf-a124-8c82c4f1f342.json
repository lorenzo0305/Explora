  "rdfs:comment": {
    "de": [
      "Mit Blick auf den Fluss entdecken Sie einen geselligen, natürlich schattigen Ort, an dem Sie essen, baden und einen Moment der Entspannung am Tisch oder auf unseren Liegestühlen genießen können."
    ],
    "en": [
      "Come and discover\" La terrasse d'Eva\" a friendly place where you can meet friends or family. Enjoy a lunch or a moment of relaxation in our deckchairs overlooking a charming river."
    ],
    "it": [
      "Affacciato sul fiume, venite a scoprire un'area accogliente e naturalmente ombreggiata dove potrete mangiare, nuotare, giocare a minigolf e rilassarvi al tavolo o sulle nostre sedie a sdraio."
    ],
    "fr": [
      "Surplombant la rivière, venez découvrir un endroit convivial ombragé naturellement ou vous pourrez vous restaurer, vous baigner, jouer au mini golf et partager un moment de détente à table ou allongé dans nos transats."
    ],
    "nl": [
      "Kom met uitzicht op de rivier een gezellige, natuurlijke schaduwrijke plek ontdekken waar je kunt eten, zwemmen en ontspannen aan tafel of op een van onze ligstoelen."
    ],
    "es": [
      "Con vistas al río, venga a descubrir un espacio acogedor y naturalmente sombreado donde podrá comer, nadar, jugar al minigolf y relajarse en la mesa o en nuestras tumbonas."
    ]
  },
