  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Gorges de l'Ardèche - Pont d'Arc besteht aus 7 Büros, die sich um das Gebiet der Gorges de l'Ardèche kümmern. Ein Büro empfängt und informiert Fachleute in den Räumlichkeiten der Communauté de Communes."
    ],
    "en": [
      "Gorges de l'Ardèche - Pont d'Arc Tourist Information has 7 centres for the area of the Ardèche Gorges. There's a centre for professionals in the centre of Bourg-Saint-Andéol."
    ],
    "it": [
      "L'Ufficio del Turismo delle Gole dell'Ardèche - Pont d'Arc dispone di 7 uffici che servono la zona delle Gole dell'Ardèche. Un ufficio accoglie e fornisce informazioni ai professionisti, nei locali della Comunità dei Comuni."
    ],
    "fr": [
      "L'Office de Tourisme Gorges de l'Ardèche - Pont d'Arc, c'est 7 bureaux au service du territoire des Gorges de l'Ardèche. Un bureau accueille et renseigne les professionnels, dans les locaux de la Communauté de Communes."
    ],
    "es": [
      "La Oficina de Turismo de las Gargantas del Ardèche - Pont d'Arc cuenta con 7 oficinas al servicio de la zona de las Gargantas del Ardèche. Una oficina acoge e informa a los profesionales, en los locales de la Comunidad de Municipios."
    ],
    "nl": [
      "Het Bureau voor Toerisme van de Gorges de l'Ardèche - Pont d'Arc heeft 7 kantoren die het gebied van de Gorges de l'Ardèche bedienen. Een bureau ontvangt en verstrekt informatie aan professionals, in de gebouwen van de gemeente."
    ]
  },
