  "rdfs:comment": {
    "de": [
      "Seit 1985 entwickelt AD GARAGE CARROSSERIE BRIVADOISE die besten Serviceleistungen und Dienstleistungen für die Fahrzeuge von Privatpersonen und Gewerbetreibenden.\r\nMit seiner jahrelangen Erfahrung in der Automobilbranche heißt Sie das gesamte Team in Brioude herzlich willkommen."
    ],
    "en": [
      "Since 1985, AD GARAGE CARROSSERIE BRIVADOISE has been developing the best services for private and professional vehicles.\r\nWith years of experience in the automotive industry, the whole team welcomes you to Brioude."
    ],
    "it": [
      "Dal 1985, AD GARAGE CARROSSERIE BRIVADOISE sviluppa i migliori servizi per veicoli privati e professionali.\r\nCon anni di esperienza nel settore automobilistico, l'intero team vi dà il benvenuto a Brioude."
    ],
    "fr": [
      "Depuis 1985, AD GARAGE CARROSSERIE BRIVADOISE développe les meilleurs services et prestations pour les véhicules des particuliers et des professionnels.\r\nFort de ses années d'expérience dans l'automobile, toute l'équipe vous accueille à Brioude."
    ],
    "nl": [
      "Sinds 1985 ontwikkelt AD GARAGE CARROSSERIE BRIVADOISE de allerbeste diensten voor particuliere en professionele voertuigen.\r\nMet jarenlange ervaring in de auto-industrie, heet het hele team u welkom in Brioude."
    ],
    "es": [
      "Desde 1985, AD GARAGE CARROSSERIE BRIVADOISE desarrolla los mejores servicios para vehículos particulares y profesionales.\r\nCon años de experiencia en la industria del automóvil, todo el equipo le da la bienvenida a Brioude."
    ]
  },
