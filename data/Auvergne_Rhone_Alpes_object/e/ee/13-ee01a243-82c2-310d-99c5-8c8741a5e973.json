  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg der Ausstellungen von William Klein und Sebastião Salgado bestätigt Montélimar-Agglomération seinen Platz unter den kulturellen Reisezielen Frankreichs mit einer noch nie dagewesenen Retrospektive, die Nicolas Bouvier gewidmet ist."
    ],
    "en": [
      "Following on from the success of the William Klein and Sebastião Salgado exhibitions, Montélimar-Agglomération confirms its position as one of France's leading cultural destinations with an unprecedented retrospective devoted to Nicolas Bouvier."
    ],
    "it": [
      "Dopo il successo delle mostre di William Klein e Sebastião Salgado, Montélimar-Agglomération si conferma una delle principali destinazioni culturali francesi con una retrospettiva senza precedenti dedicata a Nicolas Bouvier."
    ],
    "fr": [
      "Après le succès des expositions de William Klein et Sebastião Salgado, Montélimar-Agglomération confirme sa place parmi les destinations culturelles françaises avec une rétrospective inédite consacrée à Nicolas Bouvier."
    ],
    "es": [
      "Tras el éxito de las exposiciones de William Klein y Sebastião Salgado, Montélimar-Agglomération se confirma como uno de los principales destinos culturales de Francia con una retrospectiva inédita dedicada a Nicolas Bouvier."
    ],
    "nl": [
      "Na het succes van de tentoonstellingen van William Klein en Sebastião Salgado bevestigt Montélimar-Agglomération zijn plaats als een van de belangrijkste culturele bestemmingen in Frankrijk met een nooit eerder vertoonde overzichtstentoonstelling gewijd aan Nicolas Bouvier."
    ]
  },
  "rdfs:label": {
