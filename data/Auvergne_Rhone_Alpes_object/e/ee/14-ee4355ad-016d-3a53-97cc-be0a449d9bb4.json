  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6c125d8e-e9d5-3788-bbef-e7da87b4b29d",
      "dc:description": {
        "de": [
          "In unseren Geschäften finden Sie die folgenden Marken: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nÖffnungszeiten:\n- dienstag bis Samstag von 9.00 bis 12.30 Uhr und von 14.30 bis 19.00 Uhr."
        ],
        "en": [
          "Our boutiques carry the following brands: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nOpening hours:\n- tuesday to Saturday, 9:00 am to 12:30 pm and 2:30 pm to 7:00 pm."
        ],
        "it": [
          "I nostri negozi offrono i seguenti marchi: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nOrari di apertura:\n- da martedì a sabato, dalle 9.00 alle 12.30 e dalle 14.30 alle 19.00."
        ],
        "fr": [
          "Nos boutiques vous proposent les marques suivantes: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nHoraires : \n- du mardi au samedi de 9h00 à 12h30 et de 14h30 à 19h00."
        ],
        "nl": [
          "Onze winkels bieden de volgende merken aan: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nOpeningstijden:\n- dinsdag t/m zaterdag van 9.00 tot 12.30 uur en van 14.30 tot 19.00 uur."
        ],
        "es": [
          "Nuestras tiendas ofrecen las siguientes marcas: REQINS, PATAUGAS, PIKOLINOS, PALLADIUM, CONVERSE, MIMMU, TAKE ME, PEPEROSE, BASE LONDON, MYMA, GADEA, LEMON JELLY, NEW BALANCE.\n\nHorario de apertura:\n- de martes a sábado, de 9.00 a 12.30 y de 14.30 a 19.00."
        ]
      },
