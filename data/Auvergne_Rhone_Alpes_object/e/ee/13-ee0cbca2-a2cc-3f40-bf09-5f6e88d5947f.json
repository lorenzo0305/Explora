  "rdfs:comment": {
    "de": [
      "Alpes Gyro Process liegt im Herzen des Grésivaudan, zwischen Belledonne und Chartreuse, und bietet Ihnen die Möglichkeit, die Region durch eine Lufttaufe an Bord eines Ultraleichtflugzeugs zu entdecken: Hängegleiter, Autogire oder 3-Achsen-Flugzeuge."
    ],
    "en": [
      "Based in the heart of the Grésivaudan, between Belledonne and Chartreuse, Alpes Gyro Process offers you the chance to discover the region through a first flight aboard one of our microlights: Pendular, Autogire or 3-axis aircraft."
    ],
    "it": [
      "Con sede nel cuore della regione del Grésivaudan, tra Belledonne e Chartreuse, Alpes Gyro Process vi offre la possibilità di scoprire la regione attraverso un primo volo a bordo di uno dei nostri ultraleggeri: Pendolare, Autogiro o 3 assi."
    ],
    "fr": [
      "Basée au coeur du Grésivaudan, entre Belledonne et Chartreuse, Alpes Gyro Process vous propose de découvrir la région par le baptême de l'air à bord de ses ULM: Pendulaire, Autogire ou avion 3 axes."
    ],
    "es": [
      "Con sede en el corazón de la región de Grésivaudan, entre Belledonne y Chartreuse, Alpes Gyro Process le ofrece la posibilidad de descubrir la región a través de un primer vuelo a bordo de uno de nuestros ultraligeros: Pendular, Autogiro o Avión de 3 ejes."
    ],
    "nl": [
      "Alpes Gyro Process, gevestigd in het hart van de Grésivaudan regio, tussen Belledonne en Chartreuse, biedt u de mogelijkheid om de regio te ontdekken tijdens een eerste vlucht aan boord van een van onze microlights: Pendular, Autogyro of 3-axis vliegtuigjes."
    ]
  },
  "rdfs:label": {
