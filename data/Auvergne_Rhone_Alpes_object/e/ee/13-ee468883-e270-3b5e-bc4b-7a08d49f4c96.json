  "rdfs:comment": {
    "de": [
      "Von 10 bis 12 Uhr: Erleben Sie außergewöhnliche Kochvorführungen unserer Köche, die ihre Geheimnisse rund ums Grillen verraten.\r\nAb 12 Uhr: Bühne frei für das Festmahl! Begleiten Sie uns zu einem köstlichen Grillmahl in geselliger Atmosphäre!"
    ],
    "en": [
      "10 a.m. to 12 p.m.: Take part in exceptional culinary demonstrations by our chefs, who will share their grilling secrets.\r\nFrom 12pm: Time for a feast! Join us for a delicious grilled meal in a convivial atmosphere!"
    ],
    "it": [
      "Dalle 10.00 alle 12.00: assistete alle eccezionali dimostrazioni di cucina dei nostri chef, che condividono i loro segreti per la cottura alla griglia.\r\nDalle 12.00: è l'ora della festa! Unitevi a noi per un delizioso pasto alla griglia in un'atmosfera amichevole!"
    ],
    "fr": [
      "De 10h à 12h : assistez à des démonstrations culinaires exceptionnelles par nos chefs qui partageront leurs secrets autour des grillades. \r\nDès 12h : Place au festin ! Rejoignez-nous pour un délicieux repas grillades dans une ambiance conviviale !."
    ],
    "nl": [
      "Van 10 tot 12 uur: kijk hoe onze chef-koks uitzonderlijke kookdemonstraties geven en hun grillgeheimen delen.\r\nVanaf 12 uur: Tijd voor een feestmaal! Schuif aan voor een heerlijke gegrilde maaltijd in een gezellige sfeer!"
    ],
    "es": [
      "De 10:00 a 12:00: vea a nuestros chefs hacer excepcionales demostraciones de cocina y compartir sus secretos de asado.\r\nA partir de las 12:00: ¡es hora de darse un festín! Disfrute de una deliciosa comida a la parrilla en un ambiente agradable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Grillade party"
    ]
  },
