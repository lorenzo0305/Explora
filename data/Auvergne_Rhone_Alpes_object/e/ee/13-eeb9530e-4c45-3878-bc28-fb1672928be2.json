  "rdfs:comment": {
    "de": [
      "An diesem Tag, dem Tag der Fête de la Musique und des Sommeranfangs, veranstaltet der Verein Loisirs et Voyages avec les Chiens Verts seinen jährlichen Flohmarkt auf dem Cours Lafayette."
    ],
    "en": [
      "To celebrate the Fête de la Musique and the start of summer, the Loisirs et Voyages avec les Chiens Verts association is holding its annual flea market on the Cours Lafayette."
    ],
    "it": [
      "Per celebrare la Festa della Musica e l'inizio dell'estate, l'associazione Loisirs et Voyages avec les Chiens Verts organizza il suo annuale mercatino delle pulci sul Cours Lafayette."
    ],
    "fr": [
      "En ce jour de Fête de la Musique et du début de l'été, l'association Loisirs et Voyages avec les Chiens Verts organise sa brocante annuelle sur le Cours Lafayette."
    ],
    "es": [
      "Para celebrar la Fiesta de la Música y el comienzo del verano, la asociación Loisirs et Voyages avec les Chiens Verts organiza su mercadillo anual en el Cours Lafayette."
    ],
    "nl": [
      "Om het Fête de la Musique en het begin van de zomer te vieren, houdt de vereniging Loisirs et Voyages avec les Chiens Verts haar jaarlijkse vlooienmarkt op het Cours Lafayette."
    ]
  },
  "rdfs:label": {
