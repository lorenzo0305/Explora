  "rdfs:comment": {
    "de": [
      "La kuisine de Karine bietet Ihnen eine Feinkostkarte mit Verrinen, Probierbrettern, Tagesmenüs, Aperitifs, Vorspeisen, Hauptgerichten und Desserts für Ihre festlichsten Momente: Geburtstage, Abendessen, Familienessen, Einweihungen, Abende mit Freunden ..."
    ],
    "en": [
      "La kuisine de Karine offers a catering menu with verrines, tasting boards, menu of the day, aperitifs, starters, main courses, desserts for your most festive occasions: birthdays, dinners, family meals, inaugurations, evenings with friends..."
    ],
    "it": [
      "La kuisine de Karine vi propone un menù di catering con verrine, taglieri da degustare, menù del giorno, aperitivi, antipasti, secondi, dessert per i vostri momenti più festosi: compleanni, cene, pranzi in famiglia, inaugurazioni, serate tra amici..."
    ],
    "fr": [
      "La kuisine de Karine vous propose une carte traiteur avec des verrines, planches à déguster, menu du jour, apéritifs, entrée, plats, desserts pour vos moments les plus festifs : anniversaire, dîners, repas de famille, inaugurations, soirée entre amis ..."
    ],
    "es": [
      "La kuisine de Karine le propone una carta de restauración con verrines, tablas al gusto, menú del día, aperitivos, entrantes, platos principales, postres para sus momentos más festivos: cumpleaños, cenas, comidas familiares, inauguraciones, veladas con amigos..."
    ],
    "nl": [
      "La kuisine de Karine biedt u een cateringmenu met verrines, borden naar smaak, menu van de dag, aperitieven, voorgerechten, hoofdgerechten, desserts voor uw meest feestelijke momenten: verjaardagen, diners, familiediners, inhuldigingen, avonden met vrienden..."
    ]
  },
  "rdfs:label": {
