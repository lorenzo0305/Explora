  "rdfs:comment": {
    "de": [
      "KANN NICHT BESICHTIGT WERDEN\r\nIm Herzen des Marktfleckens befindet sich ein wunderschönes Haus mit gedrungenem Grundriss aus dem Ende des 16. oder Anfang des 17. Jahrhunderts, das über ein polygonales Treppenhaus verfügt, das außerhalb des Werkes liegt."
    ],
    "en": [
      "NOT OPEN TO THE PUBLIC\r\nIn the heart of the village, a magnificent house with a compact floor plan, dating from the late 16th or early 17th century, features a polygonal staircase."
    ],
    "it": [
      "NON APERTO AL PUBBLICO\r\nNel cuore del villaggio, una magnifica casa a pianta compatta, risalente alla fine del XVI o all'inizio del XVII secolo, presenta una scala poligonale."
    ],
    "fr": [
      "NE SE VISITE PAS\r\nAu coeur du bourg, une magnifique maison de plan ramassé, datant de la fin du XVIème siècle ou du début du XVIIème siècle, comporte une cage d'escalier polygonale hors-oeuvre."
    ],
    "es": [
      "NO ABIERTA AL PÚBLICO\r\nEn el corazón del pueblo, una magnífica casa de planta compacta, de finales del siglo XVI o principios del XVII, presenta una escalera poligonal."
    ],
    "nl": [
      "NIET TOEGANKELIJK VOOR HET PUBLIEK\r\nIn het hart van het dorp staat een prachtig huis met een compacte plattegrond, dat dateert uit de late 16e of vroege 17e eeuw en een veelhoekige trap heeft."
    ]
  },
  "rdfs:label": {
    "en": [
      "Unicorn house"
    ],
    "fr": [
      "La maison à la Licorne"
    ]
  },
