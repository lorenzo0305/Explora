  "rdfs:comment": {
    "de": [
      "Ben Aven Tour - das ist Benito! Unabhängiger, diplomierter Führer für Höhlenforschung, Canyoning, Klettersteige, Via Corda, Klettern und Kanufahren. Als Spezialist für Outdoor-Aktivitäten wird sich meine professionelle Betreuung Ihren Wünschen anpassen und Sie in aller Sicherheit begleiten."
    ],
    "en": [
      "Ben Aven Tour is Benito! A certified independent guide specializing in caving, canyoning, via ferrata, via corda and climbing. An outdoor activity specialist, my professional guidance will be tailored to your desires and ensure your safety."
    ],
    "it": [
      "Ben Aven Tour è Benito! Guida indipendente qualificata in speleologia, canyoning, via ferrata, via corda, arrampicata e canoa. Specialista in attività all'aria aperta, la mia supervisione professionale si adatterà ai vostri desideri in tutta sicurezza."
    ],
    "fr": [
      "Ben Aven Tour c'est Benito! Guide indépendant diplômé en spéléologie, canyoning, via ferrata, via corda, escalade et canoë-kayak. Spécialiste des activités de plein air, mon encadrement professionnel s'adaptera au mieux à vos envies et en toute sécurité."
    ],
    "es": [
      "¡Ben Aven Tour es Benito! Un guía independiente cualificado en espeleología, barranquismo, vía ferrata, vía corda, escalada y piragüismo. Especialista en actividades al aire libre, mi supervisión profesional se adaptará a tus deseos con total seguridad."
    ],
    "nl": [
      "Ben Aven Tour is Benito! Een gekwalificeerde onafhankelijke gids in speleologie, canyoning, via ferrata, via corda, klimmen en kanoën. Als specialist in outdooractiviteiten zal mijn professionele begeleiding zich in alle veiligheid aanpassen aan jouw wensen."
    ]
  },
