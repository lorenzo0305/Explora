  "rdfs:comment": {
    "de": [
      "Mit Ihnen seit 2001, um Ihnen schöne Erlebnisse in den Bergen zu ermöglichen. Vielfältige Aktivitäten für Abenteuer im Plural.\r\nUnser Ziel ist es, Ihnen ein schönes Erlebnis zu bereiten!"
    ],
    "en": [
      "Mountain professionals based at the foot of Mont Blanc for over 15 years. Vecteur Montagne provides a wide range of sensory, heritage and sporting activities all year round."
    ],
    "it": [
      "Professionista della montagna, installato da oltre 15 anni ai piedi del Monte Bianco, Vecteur Montagne propone tutto l'anno un'ampia gamma di attività dedicate alla scoperta dei sensi, del patrimonio culturale e dello sport."
    ],
    "fr": [
      "Avec vous depuis 2001 pour vous faire vivre de belles expériences en montagne. Des activités variées pour des aventures au pluriel.\r\nNotre objectif est de vous faire vivre une belle expérience !"
    ],
    "nl": [
      "We zijn er al sinds 2001 en helpen je te genieten van geweldige ervaringen in de bergen. Een verscheidenheid aan activiteiten voor alle soorten avonturen.\r\nOns doel is om je een geweldige ervaring te bezorgen!"
    ],
    "es": [
      "Contigo desde 2001 para hacerte vivir grandes experiencias en la montaña. Una variedad de actividades para una variedad de aventuras.\r\nNuestro objetivo es ofrecerle una gran experiencia"
    ]
  },
