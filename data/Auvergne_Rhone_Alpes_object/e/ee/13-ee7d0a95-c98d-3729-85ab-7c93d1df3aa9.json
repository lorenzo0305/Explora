  "rdfs:comment": {
    "de": [
      "La Cantine ist eine Pizzeria, Bar und befindet sich im Herzen von Plagne 1800. Zu den besten Pizzen der Gegend gehörend, bietet sie auch einige Vorschläge der Woche an. Gute Atmosphäre und freundliches Personal. Die Cocktails sind super! Entdecken Sie sie!"
    ],
    "en": [
      "La Cantine is a pizzeria and a bar in the heart of Plagne 1800. Some of the best pizzas in town, suggestion of the week. A great atmosphere and friendly staff. Come and try our fabulous cocktails!"
    ],
    "it": [
      "La Cantine è una pizzeria e bar nel cuore di Plagne 1800. Tra le migliori pizze della zona, offre anche alcune proposte settimanali. Grande atmosfera e personale cordiale. Ottimi cocktail! Da provare!"
    ],
    "fr": [
      "La Cantine est une pizzeria, bar situé au cœur de Plagne 1800. Parmi les meilleures pizzas du coin, qui propose également quelques suggestions de la semaine. Bonne ambiance et staff chaleureux. Supers cocktails! A découvrir!"
    ],
    "nl": [
      "La Cantine is een pizzeria en bar in het hart van Plagne 1800. Het heeft een aantal van de beste pizza's in de omgeving, evenals een paar wekelijkse suggesties. Geweldige sfeer en vriendelijk personeel. Geweldige cocktails! Het proberen waard!"
    ],
    "es": [
      "La Cantine es una pizzería y bar en el corazón de Plagne 1800. Una de las mejores pizzas de la zona, también ofrece algunas sugerencias semanales. Gran ambiente y personal amable. Excelentes cócteles Merece la pena probarlo"
    ]
  },
