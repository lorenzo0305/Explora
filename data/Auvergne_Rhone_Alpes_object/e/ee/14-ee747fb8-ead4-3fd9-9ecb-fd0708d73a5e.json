  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/49e8e828-aa99-3b73-99e5-2812b9aabb28",
      "dc:description": {
        "de": [
          "Der Drive Fermier du Montreuillois ist eine Gruppe von lokalen Erzeugern und Handwerkern\nzu Ihren Diensten, um Ihnen unsere Produkte direkt anzubieten!\nBestellen Sie auf der Website bis Mittwoch und holen Sie Ihre Vorräte am Freitag ab!"
        ],
        "en": [
          "Le Drive Fermier du Montreuillois is a group of local producers and artisans\nat your service to offer you our products direct!\nOrder online by Wednesday and pick up your supplies on Friday!"
        ],
        "it": [
          "Il Drive Fermier du Montreuillois è un gruppo di produttori e artigiani locali\nal vostro servizio per offrirvi direttamente i nostri prodotti!\nOrdinate sul sito entro mercoledì e ritirate i vostri prodotti venerdì!"
        ],
        "fr": [
          "Le Drive Fermier du Montreuillois est un groupe de producteurs et d'artisans locaux\nà votre service pour vous proposer nos produits en direct !\nCommandez sur le site avant le mercredi et récupérez vos provisions le vendredi !"
        ],
        "es": [
          "El Drive Fermier du Montreuillois es un grupo de productores y artesanos locales\n¡a su servicio para ofrecerle nuestros productos directamente!\n¡Haga su pedido en la página web antes del miércoles y recoja sus provisiones el viernes!"
        ],
        "nl": [
          "De Drive Fermier du Montreuillois is een groep lokale producenten en ambachtslieden\ntot uw dienst om u onze producten rechtstreeks aan te bieden!\nBestel op de website voor woensdag en haal je voorraad vrijdag op!"
        ]
      },
