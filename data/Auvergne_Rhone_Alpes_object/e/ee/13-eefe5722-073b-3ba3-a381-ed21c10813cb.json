  "rdfs:comment": {
    "de": [
      "Raffinierte Küche mit savoyischen Akzenten, die in einem gemütlichen Rahmen am Fuße der Pisten serviert wird. Kamin, Holz, Sonnenterrasse... alles lädt zum Entspannen und Schlemmen ein"
    ],
    "en": [
      "Refined cuisine with Savoyard accents, served in a warm setting at the foot of the slopes. Fireplace, wood, sunny terrace... everything invites you to relax and indulge."
    ],
    "it": [
      "Raffinata cucina savoiarda servita in un ambiente accogliente ai piedi delle piste. Camino, legno, terrazza soleggiata: tutto invita al relax e al piacere"
    ],
    "fr": [
      "Cuisine raffinée aux accents savoyards, servie dans un cadre chaleureux, au pied des pistes. Cheminée, bois, terrasse ensoleillée… tout invite à la détente et à la gourmandise"
    ],
    "nl": [
      "Verfijnde keuken met Savoyaardse accenten, geserveerd in een gezellige omgeving, aan de voet van de pistes. Open haard, hout, zonnig terras... alles nodigt uit tot ontspanning en lekker eten."
    ],
    "es": [
      "Refinada cocina saboyana servida en un ambiente cálido a pie de pistas. Chimenea, leña, terraza soleada... todo invita a relajarse y darse un capricho"
    ]
  },
