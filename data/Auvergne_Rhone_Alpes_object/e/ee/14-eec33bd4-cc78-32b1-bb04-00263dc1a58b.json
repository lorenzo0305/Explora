  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/13d27927-bbb0-39f7-ab4e-146be8883dfa",
      "dc:description": {
        "de": [
          "Le P?tit Bacchus in Le Touquet empfängt Sie auf seiner gemütlichen Terrasse, wo Sie Qualitätsweine mit schmackhaften Wurst- und Käseplatten genießen können. Unsere Weinbar und unser Weinkeller bieten eine erlesene Auswahl, die durch einen Feinkostladen mit sorgfältig ausgewählten Produkten ergänzt wird, um alle Feinschmecker zufrieden zu stellen."
        ],
        "en": [
          "Le P?tit Bacchus in Le Touquet welcomes you to its convivial terrace to taste quality wines accompanied by tasty charcuterie and cheese slates. Our wine bar and wine cellar offer a refined selection, complemented by a delicatessen with products carefully chosen to satisfy all gourmets."
        ],
        "it": [
          "Le P?tit Bacchus di Le Touquet vi accoglie sulla sua terrazza conviviale per gustare vini di qualità accompagnati da gustosi salumi e taglieri di formaggi. Il nostro wine bar e la nostra cantina offrono una selezione raffinata, completata da una gastronomia con prodotti scelti con cura per soddisfare tutti i buongustai."
        ],
        "fr": [
          "Le P’tit Bacchus au Touquet vous accueille sur sa terrasse conviviale pour déguster des vins de qualité accompagnés de savoureuses ardoises de charcuterie et fromages. Notre bar à vin et cave à vin proposent une sélection raffinée, complétée par une épicerie fine aux produits soigneusement choisis pour satisfaire tous les gourmets."
        ],
        "nl": [
          "Le P?tit Bacchus in Le Touquet verwelkomt u op zijn gezellige terras om kwaliteitswijnen te proeven, vergezeld van smakelijke vleeswaren en kaasplankjes. Onze wijnbar en wijnkelder bieden een verfijnde selectie, aangevuld met een delicatessenzaak met zorgvuldig gekozen producten om alle fijnproevers tevreden te stellen."
        ],
        "es": [
          "Le P?tit Bacchus de Le Touquet le da la bienvenida a su acogedora terraza para disfrutar de vinos de calidad acompañados de sabrosas tablas de embutidos y quesos. Nuestro bar de vinos y nuestra bodega ofrecen una selección refinada, complementada por una charcutería con productos cuidadosamente seleccionados para satisfacer a todos los gourmets."
        ]
      },
      "@type": [
        "Description"
      ],
