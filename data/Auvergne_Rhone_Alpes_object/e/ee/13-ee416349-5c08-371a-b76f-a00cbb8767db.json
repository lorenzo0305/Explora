  "rdfs:comment": {
    "de": [
      "Erleben Sie eine einzigartige Erfahrung mit der Familie oder mit Freunden! Wir bieten Ihnen ein immersives Spiel \"Das Geheimnis des Kardinals\", Escape Games \"Die Abenteuer des DR Nevemore\" und Schnitzeljagden \"Die Rückkehr des Ringes\" und \"Die Legende vom Kelch der Herren \"."
    ],
    "en": [
      "Enjoy a unique experience with family and friends! We offer you an immersive game “Le Secret Cardinal”, escapade games “Les aventures du DR Nevemore” and trail games “Le Retour de l'Anneau” and “La Légende de la Coupe des Seigneurs”."
    ],
    "it": [
      "Godetevi un'esperienza unica con la vostra famiglia o i vostri amici! Alla ricerca di un alchimista, in un laboratorio del tempo o sulle tracce dell'anello unico, offriamo 5 avventure coinvolgenti per tutte le età, al chiuso o all'aperto."
    ],
    "fr": [
      "Vivez une expérience unique en famille ou entre amis ! Dans une quête alchimiste, dans un laboratoire temporel ou encore sur les traces de l’anneau unique, nous vous proposons 5 aventures immersives pour tout public, en intérieur comme en extérieur."
    ],
    "es": [
      "¡Disfrute de una experiencia única con su familia o amigos! En la búsqueda de un alquimista, en un laboratorio del tiempo o tras la pista del anillo único, ofrecemos 5 aventuras inmersivas para todas las edades, en interiores o al aire libre."
    ],
    "nl": [
      "Geniet van een unieke ervaring met je familie of vrienden! We hebben een meeslepend spel genaamd \"Het Kardinaal Geheim\", escapadespellen genaamd \"De Avonturen van Dr. Nevemore\" en schattenjachten genaamd \"De Terugkeer van de Ring\" en \"De Legende van de Beker der Heren\"."
    ]
  },
  "rdfs:label": {
    "de": [
      "Escape Game \"Mystery Hunters\" (Mysterienjäger)"
    ],
    "en": [
      "Mystery hunters\" Escape Game"
    ],
    "fr": [
      "Escape Game \"Chasseurs de mystères\""
    ],
    "nl": [
      "Mystery hunters\" Ontsnappingsspel"
    ]
  },
