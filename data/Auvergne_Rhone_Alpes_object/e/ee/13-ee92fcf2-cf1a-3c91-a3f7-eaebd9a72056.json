  "rdfs:comment": {
    "de": [
      "Ein kleines Café-Restaurant im Retro-Stil. Vom Elsass und der Auvergne inspirierte Knabbereien und Speisen, mittags und abends\r\nTagesgerichte, Aperitif- und Mittagsangebote, lokal gerösteter Kaffee (vom Torréfacteur de la Ribeyre)."
    ],
    "en": [
      "A little retro café-resto. Alsace- and Auvergne-inspired nibbling and dining, lunch and dinner\r\nDaily specials, aperitif and lunch formulas, locally roasted coffee (by Torréfacteur de la Ribeyre)."
    ],
    "it": [
      "Un piccolo caffè-ristorante dall'atmosfera retrò. Stuzzichini e piatti ispirati all'Alsazia e all'Alvernia, pranzo e cena\r\nSpecialità giornaliere, formule per aperitivi e pranzi, caffè tostato in loco (dal Torréfacteur de la Ribeyre)."
    ],
    "fr": [
      "Un p'tit café-resto un peu rétro. Grignotage et restauration inspirés d’Alsace et d’Auvergne, midi et soir \r\nPlats du jour, formules apéro et déjeuner, café torréfié localement (par le Torréfacteur de la Ribeyre)."
    ],
    "es": [
      "Un pequeño café-restaurante con aire retro. Aperitivos y comida inspirados en Alsacia y Auvernia, almuerzo y cena\r\nEspecialidades diarias, fórmulas de aperitivo y almuerzo, café tostado localmente (por el Torréfacteur de la Ribeyre)."
    ],
    "nl": [
      "Een klein café-resto met een retro uitstraling. Op de Elzas en de Auvergne geïnspireerde hapjes en gerechten, lunch en diner\r\nDagelijkse specials, aperitief- en lunchformules, lokaal gebrande koffie (door de Torréfacteur de la Ribeyre)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Paul et Nanard"
    ]
  },
