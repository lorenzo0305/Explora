  "rdfs:comment": {
    "de": [
      "Die Weine der Familie Royé sind die weinbauliche Erweiterung der Domaine de Mercoire. Die in Largentière, Planzolles und Balbiac angesiedelten Weinberge werden alle nach biologischer Landwirtschaft oder Vin Méthode Nature bewirtschaftet."
    ],
    "en": [
      "The Royé family wines are the viticultural extension of Domaine de Mercoire. The vines in Largentière, Planzolles and Balbiac are all grown using organic or Vin Méthode Nature methods."
    ],
    "it": [
      "I vini della famiglia Royé sono l'estensione viticola del Domaine de Mercoire. Le vigne di Lablachère, Planzolles e Balbiac sono tutte coltivate con metodo biologico o con Vin Méthode Nature."
    ],
    "fr": [
      "Les vins de la famille Royé sont l’extension viticole du Domaine de Mercoire. Les vignes établies à Lablachère, Planzolles et Balbiac sont toutes exploitées en agriculture biologique ou Vin Méthode Nature."
    ],
    "es": [
      "Los vinos de la familia Royé son la extensión vitícola del Domaine de Mercoire. Los viñedos de Lablachère, Planzolles y Balbiac se cultivan de forma ecológica o con Vin Méthode Nature."
    ],
    "nl": [
      "De wijnen van de familie Royé zijn de wijnbouwkundige uitbreiding van Domaine de Mercoire. De wijngaarden in Lablachère, Planzolles en Balbiac worden allemaal biologisch verbouwd of volgens de Vin Méthode Nature."
    ]
  },
