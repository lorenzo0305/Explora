  "rdfs:comment": {
    "de": [
      "Die Via Ferrata \"école\" bietet ein schönes Panorama über die Landschaften des Ferienortes Les Aillons-Margériaz. Eine angenehme Strecke mit steigendem Schwierigkeitsgrad."
    ],
    "en": [
      "There is a beginners’ route in the resort for learning basic climbing techniques."
    ],
    "it": [
      "La \"scuola\" di Via Ferrata offre un bellissimo panorama sulla località di Aillons-Margériaz. Un percorso piacevole di difficoltà crescente."
    ],
    "fr": [
      "La Via Ferrata \"école\" offre un beau panorama sur les paysages de la station des Aillons-Margériaz. Un parcours agréable et de difficulté croissante."
    ],
    "es": [
      "La \"escuela\" de vías ferratas ofrece un hermoso panorama de la estación de Aillons-Margériaz. Una ruta agradable de dificultad creciente."
    ],
    "nl": [
      "De Via Ferrata \"école\" biedt een prachtig uitzicht over het landschap en het skigebied Aillons-Margériaz. Een aangenaam circuit dat geleidelijk aan moeilijker wordt."
    ]
  },
  "rdfs:label": {
