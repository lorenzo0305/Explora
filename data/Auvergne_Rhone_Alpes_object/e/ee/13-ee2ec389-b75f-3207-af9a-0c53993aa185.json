  "rdfs:comment": {
    "de": [
      "Die Gnolus lassen Sie durch eine spielerische und kostenlose Geocaching-Erfahrung in das Herz des Departements Rhône und seiner Umgebung eintauchen.\r\nMehr als 60 Wanderungen von 1 bis 7 km erwarten Sie, um das Gebiet mithilfe dieser vernetzten Schatzsuche zu entdecken."
    ],
    "en": [
      "Les Gnolus plunges you into the heart of the Rhône department and surrounding area, through a fun and free geocaching experience.\r\nMore than 60 walks, ranging from 1 to 7km, await you as you discover the region through this connected treasure hunt."
    ],
    "it": [
      "Les Gnolus vi porta nel cuore del dipartimento del Rodano e dei suoi dintorni, con un'esperienza di geocaching divertente e gratuita.\r\nPiù di 60 passeggiate, da 1 a 7 km, vi aspettano per scoprire la regione attraverso questa caccia al tesoro collegata."
    ],
    "fr": [
      "Les Gnolus vous plongent au cœur du département du Rhône et ses environs, à travers une expérience ludique et gratuite de geocaching.\r\nPlus de 60 balades de 1 à 7km vous attendent pour découvrir le territoire grâce à cette chasse aux trésors connectée."
    ],
    "nl": [
      "Les Gnolus neemt je mee naar het hart van het departement Rhône en de omgeving, met een leuke, gratis geocaching-ervaring.\r\nMeer dan 60 wandelingen, variërend van 1 tot 7 km, wachten op je terwijl je de regio ontdekt via deze verbonden schattenjacht."
    ],
    "es": [
      "Les Gnolus le lleva al corazón del departamento del Ródano y sus alrededores, con una experiencia de geocaching lúdica y gratuita.\r\nMás de 60 recorridos, de 1 a 7 km, le esperan para descubrir la región a través de esta búsqueda del tesoro conectada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Geocaching Les Gnolus"
    ]
  },
