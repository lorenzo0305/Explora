      "dc:description": {
        "de": [
          "Auf dem Programm stehen viele Animationen, Konzerte, Spiele, Karikaturen, Ballonskulpturen, spezielle Getränke, eine Tombola und vieles mehr.\nSie sind alle herzlich willkommen!"
        ],
        "en": [
          "On the program, lots of animations, concerts, games, caricature, balloon sculpture, special drinks, tombola etc...\nYou are all welcome!"
        ],
        "it": [
          "In programma: tanta animazione, concerti, giochi, caricature, sculture di palloncini, bevande speciali, tombola ecc...\nSiete tutti benvenuti!"
        ],
        "fr": [
          "Au programme, plein d'animations, concerts, jeux, caricature, sculpture sur ballons, boissons spéciales, tombola etc...\nVous êtes tous les bienvenus !"
        ],
        "nl": [
          "Op het programma: veel entertainment, concerten, spelletjes, karikaturen, ballonsculpturen, speciale drankjes, tombola enzovoort.\nJullie zijn allemaal welkom!"
        ],
        "es": [
          "En el programa: muchas animaciones, conciertos, juegos, caricaturas, globoflexia, bebidas especiales, tómbola, etc...\n¡Todos son bienvenidos!"
        ]
      },
