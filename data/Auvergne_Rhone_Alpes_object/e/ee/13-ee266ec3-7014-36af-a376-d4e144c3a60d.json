  "rdfs:comment": {
    "de": [
      "2025 ist für die Fatals Picards das Jahr des 25-jährigen Bestehens! Musik, Humor, Witz, Engagement, schräge Lieder, unglaubliche Konzerte... Dieses Vierteljahrhundert wird auf allen Bühnen gebührend gefeiert."
    ],
    "en": [
      "For Les Fatals Picards, 2025 is the year of their 25th anniversary! With their music, their humor, their commitment, their offbeat songs and their incredible concerts, this quarter-century will be celebrated in style on every stage."
    ],
    "it": [
      "Per Les Fatals Picards, il 2025 è l'anno in cui compiono 25 anni! Con la loro musica, il loro umorismo, il loro impegno, le loro canzoni anticonformiste e i loro incredibili concerti, questo quarto di secolo sarà celebrato in grande stile su ogni palco."
    ],
    "fr": [
      "Pour les Fatals Picards, 2025 c’est l’année des 25 ans ! De musique, d’humour, de second degré, d’engagement, de chansons décalées, de concerts incroyables… alors, autant dire que ce quart de siècle sera fêté comme il se doit sur toutes les scènes."
    ],
    "nl": [
      "Voor Les Fatals Picards is 2025 het jaar dat ze 25 worden! Met hun muziek, hun humor, hun engagement, hun onconventionele liedjes en hun ongelooflijke concerten, zal deze kwart eeuw in stijl gevierd worden op elk podium."
    ],
    "es": [
      "Les Fatals Picards cumplen 25 años en 2025 Con su música, su humor, su compromiso, sus canciones fuera de lo común y sus increíbles conciertos, este cuarto de siglo se celebrará por todo lo alto en todos los escenarios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Fatals Picards - Rock français"
    ]
  },
