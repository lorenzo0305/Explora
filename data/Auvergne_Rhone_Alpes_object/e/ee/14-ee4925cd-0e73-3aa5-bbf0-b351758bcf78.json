  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e3f21bc8-dd8e-382d-84a7-6a0662104bd7",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 10:00-20:00 Uhr\n\nSonntag geschlossen\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\nBestellungen:\n\nVorbestellungen sind möglich und sogar ratsam, telefonisch unter 09.83.29.72.57 oder per E-Mail über lavapotithequearras@gmail.com\n \n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 10am-8pm\n\nClosed on Sunday\n\nCollection :\n\nDuring store opening hours\n\nOrdering :\n\nPre-orders can be placed by phone on 09.83.29.72.57 or by e-mail at lavapotithequearras@gmail.com\n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: dalle 10.00 alle 20.00\n\nChiuso la domenica\n\nRaccolta :\n\nDurante gli orari di apertura del negozio\n\nOrdini :\n\nI preordini possono essere effettuati per telefono al numero 09.83.29.72.57 o per e-mail all'indirizzo lavapotithequearras@gmail.com\n \n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi: 10h-20h\n\nFermeture le dimanche\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité et même conseillée de précommander par téléphone au 09.83.29.72.57 ou par mail  via lavapotithequearras@gmail.com\n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 10u-20u\n\nZondag gesloten\n\nAfhalen :\n\nTijdens winkelopeningstijden\n\nBestellen :\n\nPre-orders kunnen telefonisch geplaatst worden op 09.83.29.72.57 of per e-mail op lavapotithequearras@gmail.com\n \n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 10.00 a 20.00 h\n\nDomingos cerrado\n\nRecogida :\n\nDurante el horario de apertura de la tienda\n\nPedidos :\n\nLos pedidos se pueden realizar por teléfono llamando al 09.83.29.72.57 o por correo electrónico a lavapotithequearras@gmail.com\n \n\n "
        ]
      },
