      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 8:00 - 21:00 Uhr\nSonntag: 9:00 - 13:00 Uhr\n \n Abholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 8am - 9pm\nSunday: 9am - 1pm\n \n Pick-up :\n\nDuring store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: dalle 8.00 alle 21.00\nDomenica: dalle 9.00 alle 13.00\n \n Raccolta :\n\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi : 8h - 21h\nLe dimanche : 9h - 13h\n \n Retrait :\n\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 8u - 21u\nZondag: 9u - 13u\n \n Afhalen :\n\nTijdens winkelopeningstijden\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado: de 8.00 h. a 21.00 h\nDomingo: de 9.00 a 13.00\n \n Recogida :\n\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
