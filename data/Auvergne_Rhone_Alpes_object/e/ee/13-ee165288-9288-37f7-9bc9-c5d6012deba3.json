  "rdfs:comment": {
    "de": [
      "Der alte Ortskern von Cruseilles ist um den Place de la Halle herum angeordnet. Jahrhundertelang war dieser Platz das Lebenszentrum der Stadt. Hier kann man die Vergangenheit an den Fassaden ablesen und die Schritte der Geschichte klingen auf den Pflastersteinen wider."
    ],
    "en": [
      "The old town of Cruseilles revolves around the Place de la Halle. For centuries, this square was the vital center of the town. Here, the past can be read on the facades and the footsteps of history echo on the cobblestones."
    ],
    "it": [
      "Il centro storico di Cruseilles si sviluppa attorno a Place de la Halle. Per secoli, questa piazza è stata il centro vitale della città. Qui il passato si legge sulle facciate e i passi della storia riecheggiano sul selciato."
    ],
    "fr": [
      "Le vieux bourg de Cruseilles s'articule autour de la place de la Halle. Pendant des siècles cette place fut le centre vital de la ville. Ici, le passé se lit sur les façades et les pas de l'histoire résonnent sur les pavés."
    ],
    "es": [
      "El casco antiguo de Cruseilles se articula en torno a la plaza de la Halle. Durante siglos, esta plaza fue el centro vital de la ciudad. Aquí, el pasado se lee en las fachadas y los pasos de la historia resuenan en los adoquines."
    ],
    "nl": [
      "De oude stad Cruseilles is gebouwd rond de Place de la Halle. Eeuwenlang was dit plein het vitale centrum van de stad. Het verleden is hier te lezen op de gevels en de voetstappen van de geschiedenis weerklinken op de kasseien."
    ]
  },
  "rdfs:label": {
    "de": [
      "Altstadt von Cruseilles"
    ],
    "en": [
      "Old town of Cruseilles"
    ],
    "it": [
      "Centro storico di Cruseilles"
    ],
    "fr": [
      "Vieux bourg de Cruseilles"
    ],
    "es": [
      "Casco antiguo de Cruseilles"
    ]
  },
