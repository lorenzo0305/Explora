  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Eurre, gegenüber der Burg, liegt Eurre Gourmande.\r\nBar, Restaurant, Weinkeller, Tabakwarenladen... Wir bieten Gerichte aus frischen Zutaten."
    ],
    "en": [
      "In the heart of the village of Eurre, opposite its castle, lies Eurre Gourmande\r\nBar, Restaurant, Wine Cellar, Tobacco Shop... We offer dishes prepared with fresh ingredients."
    ],
    "it": [
      "L'Eurre Gourmande si trova nel cuore del villaggio di Eurre, di fronte al suo castello\r\nBar, ristorante, cantina, tabaccheria... Offriamo piatti a base di ingredienti freschi."
    ],
    "fr": [
      "Au cœur du village d'Eurre, face à son château, se situe l'Eurre Gourmande\r\nBar, Restaurant, Cave à vins, Tabac... Nous proposons des plats élaborés à partir d'ingrédients frais."
    ],
    "es": [
      "L'Eurre Gourmande está situado en el corazón del pueblo de Eurre, frente a su castillo\r\nBar, restaurante, bodega, estanco... Ofrecemos platos elaborados con ingredientes frescos."
    ],
    "nl": [
      "In het hart van het dorp Eurre, tegenover het kasteel, ligt Eurre Gourmande.\r\nBar, restaurant, wijnkelder, tabakswinkel... Wij serveren gerechten bereid met verse ingrediënten."
    ]
  },
  "rdfs:label": {
