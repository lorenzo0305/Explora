  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/44113250-523b-39c4-9fdf-e5f9a2dc1d95",
      "dc:description": {
        "de": [
          "Verbringen Sie einen Nachmittag, an dem Sie das Leben der Bergleute kennen lernen. Sehen Sie sich die Aufführung \"Leben und Kohle\" an, gefolgt von einem gemütlichen Imbiss."
        ],
        "en": [
          "Spend an afternoon discovering the lives of miners. Come and see the show Vie et charbon, followed by a convivial snack."
        ],
        "it": [
          "Trascorrete un pomeriggio alla scoperta della vita dei minatori. Venite a vedere lo spettacolo Vita e carbone, seguito da una merenda conviviale."
        ],
        "fr": [
          "Passez un après-midi consacré à la découverte de la vie des mineurs. Venez voir le spectacle Vie et charbon, qui sera suivi d’un goûter convivial."
        ],
        "es": [
          "Pase una tarde explorando la vida de los mineros. Venga a ver el espectáculo La vida y el carbón, seguido de una merienda de convivencia."
        ],
        "nl": [
          "Breng een middag door met het verkennen van het leven van mijnwerkers. Kom kijken naar de voorstelling Life and Coal, gevolgd door een gezellige snack."
        ]
      },
