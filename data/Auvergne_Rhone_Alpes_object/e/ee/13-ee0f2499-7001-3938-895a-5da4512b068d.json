  "rdfs:comment": {
    "de": [
      "Eine Bergkapelle in einem abgelegenen Weiler, der in den Hang gebaut wurde, empfängt Sie: Entdecken Sie hier die Geschichte des Schutzpatrons der Bergbewohner und die Fertigkeiten der Künstler der Barockzeit anhand eines farbenfrohen Altarbildes und Statuen!"
    ],
    "en": [
      "A mountain chapel in a secluded hamlet built on a slope; learn about the history of the patron saint of mountain dwellers and admire the expertise of artists from the Baroque period who created the altarpiece and colourful statues!"
    ],
    "it": [
      "Una cappella di montagna in una frazione nascosta e situata sul pendio. Scopri la storia del protettore dei montanari e il savoir-faire degli artisti dell'epoca barocca attraverso un retablo e statue variopinte!"
    ],
    "fr": [
      "Une chapelle de montagne dans un hameau reculé construit dans la pente vous accueille : venez y découvrir l'histoire du protecteur des montagnards et les savoir-faire des artistes de l'époque baroque au travers d'un retable et de statues colorés !"
    ],
    "es": [
      "Venga a descubrir la historia del protector de la montaña y las habilidades de los artistas barrocos a través de un colorido retablo y estatuas"
    ],
    "nl": [
      "Kom en ontdek de geschiedenis van de bergbeschermer en de vaardigheden van barokkunstenaars aan de hand van een kleurrijk altaarstuk en beelden!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Chapelle Saint-Bernard-des-Alpes (chapel): open access"
    ],
    "it": [
      "Chapelle Saint-Bernard-des-Alpes: accesso libero"
    ],
    "fr": [
      "Chapelle Saint-Bernard-des-Alpes"
    ]
  },
