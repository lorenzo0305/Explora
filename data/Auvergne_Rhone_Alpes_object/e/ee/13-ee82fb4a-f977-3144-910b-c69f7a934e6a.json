  "rdfs:comment": {
    "de": [
      "Treten Sie ins Le Névé ein und lassen Sie sich von einer authentischen, kreativen und entschiedenen Feinschmeckerküche tragen, in der frische Produkte, Know-how und Genuss mittags und abends auf dem Gipfel zusammentreffen."
    ],
    "en": [
      "Step into Le Névé and let yourself be carried away by an authentic, creative, and irresistibly gourmet cuisine, where fresh products, craftsmanship, and pure pleasure come together at the summit, for lunch and dinner."
    ],
    "it": [
      "Rilassatevi in un'atmosfera calda e in un arredamento contemporaneo."
    ],
    "fr": [
      "Entrez au Névé et laissez-vous porter par une cuisine authentique, créative et résolument gourmande, où produits frais, savoir-faire et plaisir se rencontrent au sommet le midi et le soir."
    ],
    "nl": [
      "Kom binnen in Le Névé en laat je meeslepen door de authentieke, creatieve en resoluut gastronomische keuken, waar verse producten, expertise en plezier elkaar 's middags en 's avonds ontmoeten."
    ],
    "es": [
      "Entre en Le Névé y déjese llevar por su cocina auténtica, creativa y decididamente gastronómica, donde los productos frescos, el saber hacer y el placer se dan cita en la cumbre al mediodía y por la noche."
    ]
  },
