  "rdfs:comment": {
    "de": [
      "Sie ist dem heiligen Franz von Sales gewidmet und wurde 1683 von Ambroise Broise, einem Dorfbewohner der damaligen Zeit, errichtet. Sie wurde in Erinnerung an das Wunder errichtet, das Franz von Sales 1606 vollbracht hatte, als er beim Beten zur Jungfrau Maria Rosenkränze vermehrte."
    ],
    "en": [
      "It is dedicated to Saint Francis de Sales and was built in 1683 by Ambroise Broise, a villager at the time. It was erected in memory of the miracle performed by François de Sales in 1606, who had multiplied rosaries while praying to the Virgin Mary."
    ],
    "it": [
      "Dedicata a San Francesco di Sales, fu costruita nel 1683 da Ambroise Broise, un abitante del villaggio dell'epoca. Fu eretta in memoria del miracolo compiuto da Francesco di Sales nel 1606, quando pregò la Vergine Maria e moltiplicò i suoi rosari."
    ],
    "fr": [
      "Elle est dédiée à saint François de Sales et construite en 1683 par Ambroise Broise, villageois de l'époque. Elle a été érigée en souvenir du miracle accompli par François de Sales en 1606, qui avait multiplié des chapelets en priant la Vierge Marie."
    ],
    "nl": [
      "Het is gewijd aan Saint François de Sales en werd in 1683 gebouwd door Ambroise Broise, een dorpeling uit die tijd. Het werd opgericht ter nagedachtenis aan het wonder dat François de Sales in 1606 verrichtte, toen hij tot de Maagd Maria bad en zijn rozenkransen vermenigvuldigde."
    ],
    "es": [
      "Dedicada a San Francisco de Sales, fue construida en 1683 por Ambroise Broise, un aldeano de la época. Se erigió en memoria del milagro realizado por Francisco de Sales en 1606, cuando rezó a la Virgen María y multiplicó sus rosarios."
    ]
  },
  "rdfs:label": {
