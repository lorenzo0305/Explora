  "rdfs:comment": {
    "de": [
      "Von Mai bis September\r\nLe Secret du Reposoir gehört zur großen Familie der Explor Games®. Diese inszenierten, von mobilen Anwendungen geleiteten Abenteuer- und Erkundungsspiele entwickeln sich in ganz Frankreich."
    ],
    "en": [
      "From May to September - Reopening next spring\r\nLe Secret du Reposoir is part of the Explor Games® family. These scripted adventures and exploration games, guided by mobile applications, are being developed throughout France."
    ],
    "it": [
      "Da maggio a settembre\r\nLe Secret du Reposoir fa parte della famiglia Explor Games®. Questi giochi di avventura ed esplorazione, guidati da applicazioni mobili, sono in fase di sviluppo in tutta la Francia."
    ],
    "fr": [
      "De mai à septembre\r\nLe Secret du Reposoir fait partie de la grande famille des Explor Games®. Ces jeux d'aventures et d'exploration scénarisés, guidés par des applications mobiles se développent sur la France entière."
    ],
    "nl": [
      "Van mei tot september\r\nLe Secret du Reposoir maakt deel uit van de Explor Games®-familie. Deze gescripte avonturen- en ontdekkingsspellen met mobiele toepassingen worden in heel Frankrijk ontwikkeld."
    ],
    "es": [
      "De mayo a septiembre\r\nLe Secret du Reposoir forma parte de la familia Explor Games®. Estos juegos de aventura y exploración guiados por aplicaciones móviles se desarrollan en toda Francia."
    ]
  },
  "rdfs:label": {
