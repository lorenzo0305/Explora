  "rdfs:comment": {
    "de": [
      "Canopée ist eine Kaffeerösterei: Wir rösten in unserer Werkstatt eine Reihe von Spezialitätenkaffees und Kakaos, die in einem verantwortungsvollen Verfahren eingeschrieben sind!\r\nVerkauf an Privatpersonen und Gewerbetreibende."
    ],
    "en": [
      "Canopée is a roasting workshop: we roast a range of specialty coffees and cocoas in our own workshop, as part of our responsible approach!\r\nSales to individuals and professionals."
    ],
    "it": [
      "Canopée è un laboratorio di torrefazione: nel nostro laboratorio tostiamo una gamma di caffè speciali e fave di cacao nell'ambito di un approccio responsabile: ORGANICO & FAIR TRADE\r\nVendita a privati e professionisti."
    ],
    "fr": [
      "Canopée est un atelier de torréfaction : nous torréfions dans notre atelier une gamme de cafés de spécialité et de cacaos inscrits dans une démarche responsable : BIO & Equitable\r\nVente aux particuliers et aux professionnels."
    ],
    "nl": [
      "Canopée is een branderij: we branden een gamma koffiespecialiteiten en cacao in onze branderij, in het kader van onze verantwoorde aanpak!\r\nWe verkopen aan particulieren en professionals."
    ],
    "es": [
      "Canopée es un taller de torrefacción: tostamos una gama de especialidades de café y cacao en grano en nuestro taller en el marco de un enfoque responsable: BIO Y COMERCIO JUSTO\r\nVenta a particulares y profesionales."
    ]
  },
