  "rdfs:comment": {
    "de": [
      "Möchten Sie das Gefühl eines Formel-1-Fahrers erleben? Die Rennstrecke Les Ecuyers empfängt Sie für einen Fahrkurs oder einfach nur, um an den OPEN-Tagen gegen andere angehende Rennfahrer anzutreten (mit Ihrem eigenen Auto, Motorrad, Seitenwagen oder Kart!). Wie geht's los? Los, GO GO GO!"
    ],
    "en": [
      "Do you want to experience the sensations of a F1 driver? The circuit des Ecuyers welcomes you for a driving course or simply to compete against other budding drivers (with your own car, motorcycle, sidecar or kart!) during the OPEN days. Are you ready to go? Go GO GO GO!"
    ],
    "it": [
      "Volete provare l'emozione di un pilota di F1? Il Circuit des Ecuyers vi accoglie per un corso di guida o semplicemente per gareggiare contro altri piloti in erba (con la vostra auto, moto, sidecar o kart!) durante le giornate OPEN. Siete pronti a partire? Vai GO GO GO!"
    ],
    "fr": [
      "Envie de vivre les sensations d’un pilote de F1 ? Le circuit des Ecuyers vous accueille le temps d’un stage de pilotage ou simplement pour concourir face à d’autres pilotes en herbe (avec votre propre voiture, moto, side-car ou karting!) lors des journées OPEN. C’est parti ? Allez GO GO GO !"
    ],
    "es": [
      "¿Quieres vivir la emoción de un piloto de F1? El Circuit des Ecuyers le da la bienvenida para realizar un curso de conducción o simplemente para competir con otros pilotos en ciernes (¡con su propio coche, moto, sidecar o kart!) durante las jornadas OPEN. ¿Estás listo para ir? ¡Vamos, vamos, vamos!"
    ],
    "nl": [
      "Wil je de sensatie van een F1 coureur meemaken? Het Circuit des Ecuyers verwelkomt u voor een rijcursus of gewoon om het op te nemen tegen andere coureurs in spe (met uw eigen auto, motor, zijspan of kart!) tijdens de OPEN dagen. Ben je er klaar voor? Go GO GO GO!"
    ]
  },
