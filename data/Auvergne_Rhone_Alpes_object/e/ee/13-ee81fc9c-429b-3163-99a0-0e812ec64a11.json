  "rdfs:comment": {
    "de": [
      "Am 25. Juni 2009 verlor die Welt den einflussreichsten Popkünstler: Michael Jackson. Mit Zuschauern auf der ganzen Welt ist FOREVER die einzige von der Jackson-Familie genehmigte Show, die Frankreich zu Ehren des King of Pop zum Beben bringt."
    ],
    "en": [
      "On June 25, 2009, the world lost its most influential pop artist: Michael Jackson. With audiences all over the world, FOREVER is the only show approved by the Jackson family, thrilling France in tribute to the King of Pop."
    ],
    "it": [
      "Il 25 giugno 2009 il mondo ha perso il suo artista pop più influente: Michael Jackson. Con un pubblico di tutto il mondo, FOREVER è l'unico spettacolo approvato dalla famiglia Jackson, che scuote la Francia in omaggio al Re del Pop."
    ],
    "fr": [
      "Le 25 juin 2009, le monde perdait l’artiste pop le plus influent : Michael Jackson. Avec des spectateurs partout dans le monde, FOREVER est l'unique spectacle approuvé par la famille Jackson, faisant vibrer la France en hommage au roi de la pop."
    ],
    "nl": [
      "Op 25 juni 2009 verloor de wereld zijn meest invloedrijke popartiest: Michael Jackson. Met publiek over de hele wereld is FOREVER de enige show die is goedgekeurd door de familie Jackson en die Frankrijk op zijn grondvesten doet schudden als eerbetoon aan de King of Pop."
    ],
    "es": [
      "El 25 de junio de 2009, el mundo perdió a su artista pop más influyente: Michael Jackson. Con público en todo el mundo, FOREVER es el único espectáculo aprobado por la familia Jackson que sacude Francia en homenaje al Rey del Pop."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forever : The Best Show About The King of Pop | Zénith d'Auvergne"
    ]
  },
