  "rdfs:comment": {
    "de": [
      "Pégase & Particule ist mit dem Gütesiegel \"École Française de Vol Libre\" ausgezeichnet und profitiert von einer günstigen Umgebung für das Gleitschirmfliegen und das Erlernen des Gleitschirmfliegens. Die Lehrer empfangen Sie, um das Gleitschirmfliegen, Minisegeln und Speed Riding zu praktizieren."
    ],
    "en": [
      "Pégase & Particule, which has been awarded the label of École Française de Vol Libre, benefits from a favourable environment for paragliding practice and learning. The instructors welcome you to practice paragliding, mini gliding and Speed Riding."
    ],
    "it": [
      "Pégase & Particule è una scuola di parapendio francese con un ambiente favorevole alla pratica e all'apprendimento del parapendio. Gli istruttori vi invitano a praticare il parapendio, il mini-sailing e lo Speed Riding."
    ],
    "fr": [
      "Labellisée École Française de Vol Libre, Pégase & Particule profite d’un environnement favorable pour la pratique du parapente et son apprentissage. Les moniteurs vous accueillent pour pratiquer le parapente, la mini voile et le Speed Riding."
    ],
    "nl": [
      "Pégase & Particule heeft het Franse label van vrije vliegschool gekregen en geniet van een gunstige omgeving voor paragliding en leren. De instructeurs heten u welkom om paragliding, minigliding en speed riding te beoefenen."
    ],
    "es": [
      "Pégase & Particule es una escuela de parapente francesa con un entorno favorable para la práctica y el aprendizaje del parapente. Los instructores te invitan a practicar parapente, minisailing y Speed Riding."
    ]
  },
  "rdfs:label": {
