  "rdfs:comment": {
    "de": [
      "[WANDERSHOW]\r\nCie Le Vieil?Art\r\nAusflug auf die Baustelle #5\r\nDauer 45 Min. Für Familien ab 9 Jahren\r\nRDV 18 Uhr vor der Halle.\r\nFür alle Altersgruppen.\r\nKOSTENLOS FÜR ALLE!\r\nÖffentliche Begegnungszeit im Anschluss an die Vorstellung."
    ],
    "en": [
      "[AMBULATORY SHOW]\r\nCie Le Vieil?Art\r\nSortie de chantier #5\r\nDuration 45 min Family from 9 years\r\nRDV 18h in front of the Halle.\r\nAll ages.\r\nFREE FOR ALL!\r\nMeet the public after the show."
    ],
    "it": [
      "[MOSTRA AMBULATORIALE]\r\nCie Le Vieil?Art\r\nSortie de chantier #5\r\nDurata 45 min Famiglia da 9 anni\r\nRDV 18h davanti alla Halle.\r\nAperto a tutti.\r\nGRATIS PER TUTTI!\r\nIncontro con il pubblico dopo lo spettacolo."
    ],
    "fr": [
      "[SPECTACLE DÉAMBULATOIRE]\r\nCie Le Vieil’Art\r\nSortie de chantier #5 \r\nDurée 45 min En famille dès 9 ans\r\nRDV 18h devant la Halle. \r\nTout public.\r\nGRATUIT POUR TOUS !\r\nTemps de rencontre public à l'issue de la représentation."
    ],
    "es": [
      "[ESPECTÁCULO AMBULANTE]\r\nCie Le Vieil?Art\r\nSortie de chantier #5\r\nDuración 45 min Familia a partir de 9 años\r\nRDV 18h delante del Halle.\r\nAbierto a todos.\r\nGRATIS PARA TODOS\r\nEncuentro con el público después de la representación."
    ],
    "nl": [
      "[AMBULANTE SHOW]\r\nCie Le Vieil?Art\r\nKettingkast # 5\r\nDuur 45 min. Familie vanaf 9 jaar\r\nRDV 18u voor de Halle.\r\nOpen voor iedereen.\r\nGRATIS VOOR IEDEREEN!\r\nOntmoet het publiek na de voorstelling."
    ]
  },
