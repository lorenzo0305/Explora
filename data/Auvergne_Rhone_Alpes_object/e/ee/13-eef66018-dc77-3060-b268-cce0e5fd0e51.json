  "rdfs:comment": {
    "de": [
      "Tour des Anglais aus dem 13. Jahrhundert.\r\nStiftskirche St Médard mit Jungfrau in Majestät aus dem 12. Jh. und Pietà aus polychromem Holz aus dem 16.\r\n Chapelle des Pénitents Blancs (Prozession am Gründonnerstag)\r\n Fantastisches Museum der Bestie von Gévaudan (Musée Fantastique de la Bête du Gévaudan)\r\n Diorama St-Bénilde\r\nWollerei"
    ],
    "en": [
      "13th-century Tour des Anglais.\r\nCollégiale St Médard with 12th-century Vierge en Majesté and 16th-century Pietà in polychrome wood.\r\n Chapelle des Pénitents Blancs (procession on Holy Thursday)\r\n Fantastic Museum of the Beast of Gévaudan\r\n Diorama St-Bénilde\r\nWoolen mill"
    ],
    "it": [
      "La Tour des Anglais del XIII secolo.\r\nCollegiata di San Médard, con una Vergine in Maestà del XII secolo e una Pietà in legno policromo del XVI secolo.\r\n Chapelle des Pénitents Blancs (processione del Giovedì Santo)\r\n Museo fantastico della Bestia di Gévaudan\r\n Diorama di St-Bénilde\r\nLanificio"
    ],
    "fr": [
      "Tour des Anglais du XIIIe siècle. \r\nCollégiale St Médard avec Vierge en Majesté du XIIe et Pietà du XVIe en bois polychrome.\r\n Chapelle des Pénitents Blancs (procession le Jeudi Saint)\r\n Musée Fantastique de la Bête du Gévaudan\r\n Diorama St-Bénilde\r\nLainerie"
    ],
    "es": [
      "Tour des Anglais del siglo XIII.\r\nColegiata de San Médard con una Virgen en Majestad del siglo XII y una Piedad del siglo XVI en madera policromada.\r\n Chapelle des Pénitents Blancs (procesión el Jueves Santo)\r\n Museo Fantástico de la Bestia de Gévaudan\r\n Diorama de St-Bénilde\r\nMolino de lana"
    ],
    "nl": [
      "De 13e-eeuwse Tour des Anglais.\r\nCollegiale kerk van St Médard met een 12e-eeuwse Maagd in Majesteit en een 16e-eeuwse Pietà in polychroom hout.\r\n Chapelle des Pénitents Blancs (processie op Witte Donderdag)\r\n Fantastisch museum van het beest van Gévaudan\r\n St-Bénilde diorama\r\nWollen molen"
    ]
  },
