  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant in Plagne Centre, in dem frische und hausgemachte Produkte im Vordergrund stehen. Genießen Sie die freundliche Atmosphäre und lassen Sie sich nach einem Tag auf der Piste leckere Gerichte schmecken."
    ],
    "en": [
      "Come and try our restaurant in Plagne Centre, where fresh produce and homemade dishes are the order of the day. You will find a convivial atmosphere as you enjoy our tasty food after a day on the ski slopes."
    ],
    "it": [
      "Scoprite il nostro ristorante nel centro di Plagne, dove i prodotti freschi e fatti in casa sono al primo posto. Approfittate dell'atmosfera amichevole per gustare piatti gustosi dopo una giornata sulle piste."
    ],
    "fr": [
      "Découvrez notre restaurant à Plagne centre, où des produits frais et faits maison sont à l'honneur. Profitez d'une ambiance conviviale pour déguster des plats savoureux après une journée sur les pistes."
    ],
    "nl": [
      "Ontdek ons restaurant in het centrum van Plagne, waar verse, huisgemaakte producten de boventoon voeren. Profiteer van de gezellige sfeer om te genieten van smakelijke gerechten na een dag op de piste."
    ],
    "es": [
      "Descubra nuestro restaurante en el centro de Plagne, donde los productos frescos y caseros son los protagonistas. Aproveche el ambiente acogedor para degustar sabrosos platos después de un día en las pistas."
    ]
  },
