  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Jardin des Secrets in Grospierres bietet  eine kreative Küche der Ardèche mit lokalen und saisonalen Produkten. Das moderne Ambiente, die blumengeschmückte Terrasse und die Musikabende jeden Freitag machen dieses Restaurant das ganze Jahr über zu einer beliebten Adresse für Feinschmecker."
    ],
    "en": [
      "Le Jardin des Secrets in Grospierres offers creative Ardéchois cuisine based on local, seasonal produce. Modern surroundings, a flower-filled terrace and live music every Friday make this a convivial, gourmet address all year round."
    ],
    "it": [
      "Il Giardino dei Segreti a Grospierres propone una cucina ardèchese creativa a base di prodotti locali e stagionali. Ambiente moderno, terrazza fiorita e serate musicali ogni venerdì rendono questo luogo un indirizzo goloso e accogliente durante tutto l'anno."
    ],
    "fr": [
      "Le Jardin des Secrets à Grospierres propose  une cuisine ardéchoise créative à base de produits locaux et de saison. Cadre moderne, terrasse fleurie et soirées musicales chaque vendredi font de ce lieu une adresse gourmande et conviviale toute l'année."
    ],
    "nl": [
      "Traditionele en geraffineerde keuken. Dagschotel suggesties volgens het seizoen. Huisspecialiteiten: salade met warme geitenkaas, carpaccio van rundsvlees, garnalen gratin, foie gras… Zaal voor groepen van 30 à 40 pers. (verjaardag, feestjes)."
    ],
    "es": [
      "Le Jardin des Secrets, en Grospierres, sirve cocina creativa de Ardèche basada en productos locales de temporada. Con un ambiente moderno, una terraza llena de flores y música en directo todos los viernes, es un lugar agradable para comer durante todo el año."
    ]
  },
