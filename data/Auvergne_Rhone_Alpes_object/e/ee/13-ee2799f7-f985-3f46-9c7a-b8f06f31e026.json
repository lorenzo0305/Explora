  "rdfs:comment": {
    "de": [
      "Entdecken Sie über 4500 m2 Indoor – Freizeitfläche. Das Sportzentrum bietet Multi-Aktivitäts-Programme aus Fitness, Sport und Entspannung, Aquaspa und einen Wellnessbereich zum Relaxen."
    ],
    "en": [
      "Over  4500 m2 of indoor leisure facilities,  offer relaxation and well-being as well as sport activities. Fun Park, squash, badminton, table tennis or basket, aquaspa with saunas steam room, jacuzzi, relaxation area, swimming pool."
    ],
    "it": [
      "Unico e originale, su 4500m², più di 15 attività: Spa, Sport, Divertimento, Massaggi e Trattamenti... Ideale per tutti!"
    ],
    "fr": [
      "Unique et inédit, sur 4500m², plus de 15 activités : Spa, Sport, Fun, Massages & Soins... Idéal pour chacun!"
    ],
    "es": [
      "Único y original, en 4500m², más de 15 actividades: Spa, Deporte, Diversión, Masajes y Tratamientos... Ideal para todos"
    ],
    "nl": [
