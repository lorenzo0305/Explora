  "rdfs:comment": {
    "de": [
      "Dieser Roller sieht aus wie ein Möbelpacker! ....Breite Downhill-Reifen, Scheibenbremsen, Teleskopgabel.\nMit Ihrem Fatscoot werden Sie die 5 Kilometer unserer Marvel-Strecke hinunterfahren"
    ],
    "en": [
      "This scooter is a real moover and shaker! Large riding tyres, disc brakes, telescopic fork.\r\nWith your fatscoot, you will be able to go down the slope after reaching the top with the chairlift."
    ],
    "it": [
      "Questo scooter sembra un vero e proprio traslocatore! .... Pneumatici da discesa larghi, freni a disco, forcella telescopica.\nIl vostro Fatscoot vi accompagnerà lungo i 5 chilometri del nostro percorso Marvel"
    ],
    "fr": [
      "Cette trottinette a un look de déménageur ! ....Larges pneus de descente, freins à disque, fourche télescopique.\nAvec votre Fatscoot vous allez descendre les 5 kilomètres de notre piste Marvel"
    ],
    "es": [
      "Este scooter tiene pinta de moverse! ....Neumáticos anchos para descenso, frenos de disco, horquilla telescópica.\nTu Fatscoot te llevará por los 5 kilómetros de nuestro sendero Marvel"
    ],
    "nl": [
      "Deze step ziet eruit als een mover! ....Brede downhillbanden, schijfremmen, telescoopvork.\nJe Fatscoot neemt je mee naar beneden over de 5 kilometer van onze Marvel trail."
    ]
  },
  "rdfs:label": {
    "en": [
