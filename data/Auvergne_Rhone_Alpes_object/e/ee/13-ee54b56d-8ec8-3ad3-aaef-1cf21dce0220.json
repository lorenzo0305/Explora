  "rdfs:comment": {
    "de": [
      "Die Driving Range ist ein Trainingszentrum mit 25 Stationen (überdacht und offen) und drei Greens, auf denen alle Spielsituationen nachgestellt werden können (Putting Green, Bunker)."
    ],
    "en": [
      "The driving range is a training center with 25 posts (covered and uncovered) and three greens allowing to reconstitute all the situations of game (putting green, bunker)."
    ],
    "it": [
      "Il campo pratica è un centro di allenamento con 25 postazioni (coperte e scoperte) e tre green che permettono di ricostruire tutte le situazioni di gioco (putting green, bunker)."
    ],
    "fr": [
      "Le practice est un training center de 25 postes (couverts et découverts) et trois greens permettant de reconstituer toutes les situations de jeu (putting green, bunker)."
    ],
    "es": [
      "El campo de prácticas es un centro de entrenamiento con 25 puestos (cubiertos y descubiertos) y tres greens que permiten reconstituir todas las situaciones de juego (putting green, bunker)."
    ],
    "nl": [
      "De driving range is een trainingscentrum met 25 posten (overdekt en onoverdekt) en drie greens die het mogelijk maken alle spelsituaties na te bootsen (putting green, bunker)."
