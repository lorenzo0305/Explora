  "rdfs:comment": {
    "de": [
      "Im Rahmen des Karnevals und nach einem einwöchigen Aufenthalt am Konservatorium bieten Hélène Marseille und Lionel Malric vom Grand Chahut Collectif ein Konzert rund um das Gamelan an, ein Instrumentarium, das von der indonesischen Insel Bali stammt."
    ],
    "en": [
      "Following a week-long residency at the Conservatoire, Hélène Marseille and Lionel Malric, from the Grand Chahut Collectif, present a concert featuring the gamelan, an instrument from the Indonesian island of Bali."
    ],
    "it": [
      "Nell'ambito delle celebrazioni del carnevale e dopo una settimana di residenza al Conservatorio, Hélène Marseille e Lionel Malric, del Grand Chahut Collectif, propongono un concerto basato sul gamelan, uno strumento originario dell'isola di Bali in Indonesia."
    ],
    "fr": [
      "Dans le cadre du carnaval et après une semaine de résidence au conservatoire, Hélène Marseille et Lionel Malric, du Grand Chahut Collectif, proposent un concert autour du gamelan, instrumentarium venu de l'île de Bali en Indonésie."
    ],
    "es": [
      "Como parte de las celebraciones de carnaval y tras una semana de residencia en el Conservatorio, Hélène Marseille y Lionel Malric, del Grand Chahut Collectif, ofrecen un concierto basado en el gamelán, instrumento procedente de la isla de Bali, en Indonesia."
    ],
    "nl": [
      "Als onderdeel van de carnavalsvieringen en na een residentie van een week in het Conservatorium, bieden Hélène Marseille en Lionel Malric, van het Grand Chahut Collectif, een concert gebaseerd op de gamelan, een instrument van het eiland Bali in Indonesië."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Le gamelan en concert !"
    ]
  },
