  "rdfs:comment": {
    "de": [
      "A weekend entirely dedicated to the showcasing of the two Forez AOC, a territory synonymous with the art of living and quality of life. Two days of events in the centre of Montbrison dedicated to Fourme cheese and Côtes du Forez wines."
    ],
    "en": [
      "A weekend entirely dedicated to the showcasing of the two Forez AOC, a territory synonymous with the art of living and quality of life. Two days of events in the centre of Montbrison dedicated to Fourme cheese and Côtes du Forez wines."
    ],
    "it": [
      "Un fine settimana interamente dedicato a Fourme de Montbrison.\r\nIn programma: tour a piedi, escursioni a piedi e in bicicletta, mercato, visita guidata della città, mostre, dimostrazioni e degustazioni, area formaggi DOP, sfilata, spettacolo, ecc"
    ],
    "fr": [
      "Un week-end entièrement dédié à la fourme de Montbrison.\r\nAu programme : Tour pédestre, randonnée pédestre et cyclotouriste, marché, visite guidée de la ville, expositions, démonstrations et dégustations, espace des fromages AOP, corso, spectacle"
    ],
    "es": [
      "Un fin de semana enteramente dedicado a Fourme de Montbrison.\r\nEn el programa: recorrido a pie, paseos a pie y en bicicleta, mercado, visita guiada por la ciudad, exposiciones, demostraciones y degustaciones, zona de quesos DOP, desfile, espectáculo, etc"
    ],
    "nl": [
      "Een weekend geheel gewijd aan Fourme de Montbrison.\r\nOp het programma: wandeltocht, wandel- en fietstochten, markt, rondleiding door de stad, tentoonstellingen, demonstraties en proeverijen, BOB kaasruimte, optocht, show, etc"
    ]
  },
