  "rdfs:comment": {
    "de": [
      "Unser Spa Montagnes du Monde bietet Ihnen Massagen, Gesichts- und Körperbehandlungen mit der Produktreihe Pure Altitude.\r\nWir freuen uns, externen Gästen bei Buchung einer 50-minütigen oder längeren Behandlung 1 Stunde Zugang zum Spa zu schenken."
    ],
    "en": [
      "Our Spa Montagnes du Monde offers massages, facials and body treatments using the Pure Altitude range.\r\nWe are pleased to offer outside customers 1 hour's access to the spa when they book a treatment of 50 minutes or more."
    ],
    "it": [
      "La nostra Spa Montagnes du Monde offre massaggi, trattamenti viso e corpo della linea Pure Altitude.\r\nSiamo lieti di offrire ai nostri clienti esterni un'ora di accesso alla spa per un trattamento di almeno 50 minuti."
    ],
    "fr": [
      "Notre Spa Montagnes du Monde vous propose massages, soins du visage et soins du corps réalisés avec la gamme Pure Altitude.\r\nNous avons le plaisir d'offrir à la clientèle extérieure 1 heure d'accès au spa pour la résevation d'un soin de 50 min ou plus."
    ],
    "nl": [
      "Onze Spa Montagnes du Monde biedt massages, gezichts- en lichaamsbehandelingen met het Pure Altitude assortiment.\r\nWe bieden onze externe klanten graag 1 uur toegang tot de spa voor een behandeling van 50 minuten of meer."
    ],
    "es": [
      "Nuestro Spa Montagnes du Monde ofrece masajes, tratamientos faciales y corporales de la gama Pure Altitude.\r\nNos complace ofrecer a nuestros clientes externos 1 hora de acceso al spa por un tratamiento de 50 minutos o más."
    ]
  },
