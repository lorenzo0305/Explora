  "rdfs:comment": {
    "de": [
      "Hotel mitten im Industriegebiet von Annemasse und in der Nähe der großen Verkehrsachsen nach Genf, Annecy oder auch Chamonix. Zu Ihrem Komfort hat sich das Hotel vergrößert."
    ],
    "en": [
      "An hotel in the centre of Annemasse's business area and close to the main roads to Geneva, Annecy and Chamonix."
    ],
    "it": [
      "Hotel nel cuore del parco commerciale di Annemasse e vicino alle principali strade per Ginevra, Annecy e Chamonix."
    ],
    "fr": [
      "Hôtel au cœur de la zone d'activités d'Annemasse et proche des grands axes pour se rendre à Genève, Annecy ou encore Chamonix."
    ],
    "nl": [
      "Hotel in het hart van het bedrijvenpark Annemasse en dicht bij de hoofdwegen naar Genève, Annecy en Chamonix."
    ],
    "es": [
      "Hotel con encanto, en el corazón de la zona con mayor actividad de Annemasse y cerca de los grandes ejes para llegar hasta Ginebra, Annecy o incluso Chamonix. Para su comodidad, el hotel va a agrandar y realizar obras de renovación en 2017."
    ]
  },
