  "rdfs:comment": {
    "de": [
      "Gemischter Friseursalon: Professionalität und gute Laune sind angesagt! Wir empfangen Sie in einem komfortablen Raum. Sie haben unsere ganze Aufmerksamkeit, um Ihre Haarwünsche zu erfüllen, und unser ganzes Fachwissen, um Sie zu beraten."
    ],
    "en": [
      "Mixed hair salon: professionalism and good humor are the order of the day! We welcome you in a comfortable space, you will have all our attention to satisfy your hair desires and all our expertise to advise you."
    ],
    "it": [
      "Parrucchiere misto: professionalità e buon umore sono all'ordine del giorno! Vi accogliamo in uno spazio confortevole, avrete tutta la nostra attenzione per soddisfare i vostri desideri in fatto di capelli e tutta la nostra esperienza per consigliarvi."
    ],
    "fr": [
      "Salon de coiffure mixte : professionnalisme et bonne humeur sont de mise ! Nous vous accueillons dans un espace confortable, vous aurez toute notre attention pour satisfaire vos désirs capillaires et toute notre expertise pour vous conseiller."
    ],
    "es": [
      "Peluquería mixta: ¡la profesionalidad y el buen humor están a la orden del día! Le acogemos en un espacio confortable, tendrá toda nuestra atención para satisfacer sus deseos capilares y toda nuestra experiencia para asesorarle."
    ],
    "nl": [
      "Gemengde kapsalon: professionaliteit en goed humeur zijn aan de orde van de dag! Wij ontvangen u in een comfortabele ruimte, u krijgt al onze aandacht om aan uw haarwensen te voldoen en al onze expertise om u te adviseren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coif'Hair"
    ]
  },
