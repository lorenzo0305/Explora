  "rdfs:comment": {
    "de": [
      "L' O Provençale, die Ferme aux Oliviers und ihre Ölmühle laden Sie ein, ihre außergewöhnlichen Olivenbäume, die mehrere hundert und tausend Jahre alt sind, sowie ihre Produkte zu entdecken: natives Olivenöl extra, Oliven mit geschützter Ursprungsbezeichnung, Trüffel..."
    ],
    "en": [
      "L'O Provençale, the olive tree farm and olive mill, invites you to discover its extraordinary olive trees of several hundreds and thousand years old and its products."
    ],
    "it": [
      "L'O Provençale, la Fattoria degli Olivi e il suo frantoio, vi invita a scoprire i suoi eccezionali olivi, vecchi di diversi secoli, e i suoi prodotti: olio extravergine di oliva, olive DOP, tartufi..."
    ],
    "fr": [
      "L' O Provençale, la Ferme aux Oliviers et son moulin à huile vous invite à découvrir ses oliviers exceptionnels, plusieurs fois centenaires et millénaires, ainsi que ses produits : huile d'olive vierge extra, olives AOP, truffes..."
    ],
    "es": [
      "L'O Provençale, la Granja Olivarera y su almazara, le invita a descubrir sus excepcionales olivos, centenarios, y sus productos: aceite de oliva virgen extra, aceitunas DOP, trufas..."
    ],
    "nl": [
      "L'O Provençale, de olijvenboerderij en zijn olijfoliemolen nodigen u uit om hun uitzonderlijke olijfbomen, meer dan honderden en duizenden jaren oud, en hun producten te ontdekken."
    ]
  },
