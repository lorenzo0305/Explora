  "rdfs:comment": {
    "de": [
      "Für die ganze Familie ab 2 Jahren. Freizeitpark mit Hüpfburgen (in der Turnhalle oder in der Sporthalle). Geöffnet während der Schulferien der Zone A. Daten, Orte, Zeiten und Preise auf www.woopzyparc.com"
    ],
    "en": [
      "For everyone in the family since 2 years old. Come and discover sevral inflatable structures."
    ],
    "it": [
      "Per tutta la famiglia dai 2 anni in su. Parco divertimenti con gonfiabili (nella palestra o nel palazzetto dello sport). Aperto durante le vacanze scolastiche della zona A. Date, luoghi, orari e prezzi su www.woopzyparc.com"
    ],
    "fr": [
      "Pour toute la famille à partir de 2 ans. Parc de loisirs avec structures gonflables (au gymnase ou à la halle des sports). Ouvert pendant les vacances scolaires de la zone A. Dates, lieux, horaires et tarifs sur www.woopzyparc.com"
    ],
    "nl": [
      "Voor het hele gezin vanaf 2 jaar. Funpark met springkussens (in de gymzaal of sporthal). Geopend tijdens schoolvakanties in zone A. Data, locaties, tijden en prijzen op www.woopzyparc.com"
    ],
    "es": [
      "Para toda la familia a partir de 2 años. Parque de atracciones con hinchables (en el gimnasio o el pabellón de deportes). Abierto durante las vacaciones escolares de la zona A. Fechas, lugares, horarios y precios en www.woopzyparc.com"
    ]
  },
