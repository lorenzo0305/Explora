  "rdfs:comment": {
    "de": [
      "Die Buvette de Prachanié bietet Ihnen kleine Snacks vor Ort an: Gemüsesuppen, salzige Kuchen, Gebäck und Crêpes, die selbst gebacken werden! \r\nHeiße Getränke zum Aufwärmen"
    ],
    "en": [
      "The Prachanié snack bar will offer you a small catering service: vegetable soups, savoury tarts, home-made pastries and pancakes! \r\nAnd hot drinks to warm up"
    ],
    "it": [
      "Il punto di ristoro Prachanié vi offrirà un piccolo servizio di catering: zuppe di verdure, torte salate, dolci fatti in casa e frittelle!\r\nBevande calde per riscaldarsi"
    ],
    "fr": [
      "La buvette de Prachanié vous propose une petite restauration sur place : Soupes de légumes, tarte salées, pâtisseries et crêpes cuisinées maison ! \r\nDes boissons chaudes pour se réchauffer"
    ],
    "es": [
      "El bar de refrescos Prachanié le ofrecerá un pequeño servicio de catering: sopas de verduras, tartas saladas, bollería casera ¡y tortitas!\r\nBebidas calientes para entrar en calor"
    ],
    "nl": [
      "De verfrissingsbar van Prachanié biedt u een kleine cateringdienst: groentesoepen, hartige taartjes, zelfgemaakt gebak en pannenkoeken! \r\nWarme dranken om op te warmen"
    ]
  },
