  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e5a166a6-be57-3c34-88a1-361ce595910f",
      "dc:description": {
        "de": [
          "Pub mit 25 frisch gezapften Bieren, Bar mit musikalischer Untermalung\n\nGeöffnet Montag, Dienstag, Mittwoch von 16:00 bis 1:00 Uhr, Donnerstag, Freitag, Samstag von 16:00 bis 3:00 Uhr, Sonntag von 17:00 bis 1:00 Uhr\n\nArt der Musik: generalistisch.\nArt der Kundschaft: 20 bis 35 Jahre.\n\n1 Saal mit einer Gesamtkapazität von 120 Personen\nAkzeptierte Gruppen von 10 bis 30 Personen"
        ],
        "en": [
          "Pub with 25 draught beers, bar with live music\n\nOpen Monday, Tuesday, Wednesday from 4 pm to 1 am, Thursday, Friday, Saturday from 4 pm to 3 am, Sunday from 5 pm to 1 am\n\nType of music: generalist.\nClientele: 20 to 35 years old.\n\n1 room with a total capacity of 120 people\nGroups accepted from 10 to 30 people"
        ],
        "it": [
          "Pub con 25 birre alla spina, bar con musica dal vivo\n\nAperto lunedì, martedì e mercoledì dalle 16.00 all'1.00, giovedì, venerdì e sabato dalle 16.00 alle 3.00, domenica dalle 17.00 all'1.00\n\nTipo di musica: generale.\nClientela: dai 20 ai 35 anni.\n\n1 sala con una capacità totale di 120 persone\nSi accettano gruppi da 10 a 30 persone"
        ],
        "fr": [
          "Pub offrant 25 bières pression, bar avec ambiance musicale\n\nOuvert lundi, mardi, mercredi de 16h à 1h, jeudi, vendredi, samedi de 16h à 3h, dimanche de 17h à 1h\n\nType de musique : généraliste.\nType de clientèle : 20 à 35 ans.\n\n1 salle d'une capacité totale de 120 personnes\nGroupes acceptés de 10 à 30 personnes"
        ],
        "nl": [
          "Pub met 25 bieren van het vat, bar met livemuziek\n\nGeopend op maandag, dinsdag en woensdag van 16.00 tot 01.00 uur, op donderdag, vrijdag en zaterdag van 16.00 tot 03.00 uur, op zondag van 17.00 tot 01.00 uur\n\nSoort muziek: algemeen.\nKlantenkring: 20 tot 35 jaar.\n\n1 zaal met een totale capaciteit van 120 mensen\nGroepen geaccepteerd van 10 tot 30 personen"
        ],
        "es": [
          "Pub con 25 cervezas de barril, bar con música en directo\n\nAbierto lunes, martes y miércoles de 16:00 a 01:00, jueves, viernes y sábado de 16:00 a 03:00, domingo de 17:00 a 01:00\n\nTipo de música: general.\nClientela: de 20 a 35 años.\n\n1 sala con una capacidad total de 120 personas\nSe aceptan grupos de 10 a 30 personas"
        ]
      },
