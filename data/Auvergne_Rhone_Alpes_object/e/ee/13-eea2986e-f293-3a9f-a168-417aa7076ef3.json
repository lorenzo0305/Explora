  "rdfs:comment": {
    "de": [
      "Dieser Berg in La Margeride an der Grenze zwischen Lozère und Haute-Loire bietet Ihnen einen herrlichen Ausblick auf La Margeride und Le Devès...\r\nHöhe: 1486 m\r\nPR 452 Rundweg ab Chanaleilles 14.5 km"
    ],
    "en": [
      "La Margeride mountain on the borders of Lozère and Haute-Loire, offering superb panoramic views over La Margeride and Le Devès...\r\nAltitude: 1486 m\r\nPR 452 Loop starting from Chanaleilles 14.5 km"
    ],
    "it": [
      "La montagna di Margeride, al confine tra Lozère e Haute-Loire, offre una superba vista panoramica su Margeride e Devès...\r\nAltitudine: 1486 m\r\nPR 452 Anello con partenza da Chanaleilles 14,5 km"
    ],
    "fr": [
      "Mont de La Margeride  aux confins de La Lozère et de la Haute - Loire qui vous offre un suberbe panorama sur La Margeride et Le Devès...\r\nAltitude : 1486 m\r\nPR 452 Boucle au départ de Chanaleilles 14.5 km"
    ],
    "es": [
      "El monte Margeride, en los límites de Lozère y Alto Loira, ofrece una magnífica vista panorámica de Margeride y Devès...\r\nAltitud: 1486 m\r\nPR 452 Loop a partir de Chanaleilles 14,5 km"
    ],
    "nl": [
      "De Margeride berg, op de grens van Lozère en Haute-Loire, biedt een prachtig panoramisch uitzicht op Margeride en Devès...\r\nHoogte: 1486 m\r\nPR 452 rondwandeling vanuit Chanaleilles 14,5 km"
    ]
  },
