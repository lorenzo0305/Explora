  "rdfs:comment": {
    "de": [
      "In diesem privaten See können Sie Forellen, Schleien, Barsche, Karpfen und viele andere Arten angeln. Angelschein erforderlich. Erhältlich in den Geschäften von Cruseilles."
    ],
    "en": [
      "This private lake is ideal for fishing for trout, tench, perch, carp and many other species. Fishing permit required, on sale in Cruseilles shops."
    ],
    "it": [
      "Questo lago privato è ideale per la pesca di trote, tinche, persici, carpe e molte altre specie. È necessaria una licenza di pesca che può essere acquistata nei negozi di Cruseilles."
    ],
    "fr": [
      "Ce lac privé vous permettra de pêcher des truites, des tanches, des perches, des carpes et bien d'autres espèces. Permis de pêche obligatoire en vente dans les commerces de Cruseilles."
    ],
    "nl": [
      "In dit privémeer kunt u vissen op forel, zeelt, baars, karper en vele andere soorten. Een visvergunning is verplicht en kan worden gekocht in de winkels in Cruseilles."
    ],
    "es": [
      "Este lago privado es ideal para pescar truchas, tencas, percas, carpas y muchas otras especies. Se necesita licencia de pesca, que se puede adquirir en las tiendas de Cruseilles."
    ]
  },
  "rdfs:label": {
