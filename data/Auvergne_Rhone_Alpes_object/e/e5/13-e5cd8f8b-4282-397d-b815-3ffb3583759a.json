  "rdfs:comment": {
    "de": [
      "Neuer polnischer Lebensmittelladen im Zentrum von Eymeux, wo Sie zahlreiche polnische Spezialitäten (Fertiggerichte, Suppen, Snacks),heiße und kalte Getränke, Aperitifprodukte, Souvenirs und Geschenkideen finden werden..."
    ],
    "en": [
      "New Polish grocery store in the center of Eymeux where you'll find a wide range of Polish specialties (ready meals, soups, snacks), hot and cold drinks, aperitifs, souvenirs and gift ideas..."
    ],
    "it": [
      "L'unico negozio polacco della regione Rodano-Alpi si trova nel centro di Eymeux, dove troverete una vasta gamma di specialità polacche (piatti pronti, zuppe, snack), bevande calde e fredde, aperitivi, souvenir e idee regalo..."
    ],
    "fr": [
      "Seule Boutique Polonaise dans la région RhoneAlpes est au centre d'Eymeux où vous retrouverez de nombreuses spécialités polonaises (plats cuisinés, soupes, snacking),des boissons chaudes et fraîches, des produits apéritifs, souvenirs et idées cadeaux..."
    ],
    "nl": [
      "Nieuwe Poolse kruidenierswinkel in het centrum van Eymeux waar u een ruim assortiment Poolse specialiteiten (kant-en-klaarmaaltijden, soepen, snacks), warme en koude dranken, aperitieven, souvenirs en geschenkideeën vindt..."
    ],
    "es": [
      "La única tienda polaca de la región de Ródano-Alpes se encuentra en el centro de Eymeux, donde encontrará una amplia gama de especialidades polacas (platos preparados, sopas, aperitivos), bebidas frías y calientes, aperitivos, recuerdos e ideas para regalos..."
    ]
  },
