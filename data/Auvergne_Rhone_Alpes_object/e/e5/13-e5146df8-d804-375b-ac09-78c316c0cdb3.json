  "rdfs:comment": {
    "de": [
      "Unsere Küche ist eine Sache der Leidenschaft und Aufrichtigkeit. Wir bieten Ihnen ein zu 100% hausgemachtes und saisonales Menü, das mit frischen und lokalen Produkten zubereitet wird, die bei unseren Erzeugern ausgewählt werden."
    ],
    "en": [
      "Traditional restaurant using fresh, local and seasonal produce."
    ],
    "it": [
      "La nostra cucina si basa su passione e sincerità. Il nostro menu è 100% casalingo e stagionale, con prodotti freschi locali selezionati dai nostri produttori."
    ],
    "fr": [
      "Notre cuisine est une affaire de passion et de sincérité. Nous vous proposons un menu 100% fait maison et de saison, élaboré avec des produits frais et locaux sélectionnés auprès de nos producteurs."
    ],
    "nl": [
      "Onze keuken is gebaseerd op passie en oprechtheid. Ons menu is 100% huisgemaakt en seizoensgebonden, met verse lokale producten van onze producenten."
    ],
    "es": [
      "Nuestra cocina se basa en la pasión y la sinceridad. Nuestra carta es 100% casera y de temporada, con productos locales frescos seleccionados entre nuestros productores."
    ]
  },
  "rdfs:label": {
    "fr": [
