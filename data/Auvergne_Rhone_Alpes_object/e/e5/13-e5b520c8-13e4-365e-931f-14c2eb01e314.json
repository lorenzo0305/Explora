  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine traditionelle, hausgemachte Küche mit frischen Zutaten und Produkten aus der Region. Verbringen Sie einen leckeren Moment mit der Familie oder mit Freunden. Seien Sie herzlich willkommen \"au gré du vent\"."
    ],
    "en": [
      "We serve traditional, homemade cuisine, made with fresh local products. Enjoy a delicious meal as a family or with friends. Come and see us «as the wind blows»! Closed on Tuesday evenings and Wednesdays."
    ],
    "it": [
      "Offriamo una cucina tradizionale e casalinga con prodotti freschi e locali. Godetevi un pasto delizioso con la famiglia e gli amici. Vi diamo il benvenuto \"alla brezza\"."
    ],
    "fr": [
      "Nous vous proposons une cuisine traditionnelle, faite maison, composée de produits frais et de produits du terroir. Passez un savoureux moment en famille ou entre amis. Soyez les bienvenus « au gré du vent »."
    ],
    "nl": [
      "We bieden een traditionele, huisgemaakte keuken met verse producten en lokale producten. Geniet van een heerlijke maaltijd met familie en vrienden. We verwelkomen je \"to the breeze\"."
    ],
    "es": [
      "Ofrecemos una cocina tradicional y casera elaborada con productos frescos y locales. Disfrute de una deliciosa comida con la familia y los amigos. Le damos la bienvenida \"a la brisa\"."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Au Gré du Vent"
    ],
    "fr": [
      "Restaurant Au Gré du Vent"
    ]
  },
