  "rdfs:comment": {
    "de": [
      "Komplex für Hallenfußball.\r\nEntdecken Sie unsere Tagesgerichte sowie unsere Pizzas, Burger und Salate. Sorgfältig zubereitet, für eine gelungene Mittagspause."
    ],
    "en": [
      "Indoor soccer complex.\r\nCome and discover our daily specials, pizzas, burgers and salads. Prepared with care, for a successful lunch break."
    ],
    "it": [
      "Complesso di calcio al coperto.\r\nVenite a scoprire le nostre specialità del giorno e le nostre pizze, hamburger e insalate. Preparati con cura, per una pausa pranzo di successo."
    ],
    "fr": [
      "Complexe de foot en salle.\r\nVenez découvrir nos plats du jour ainsi que nos pizzas, burgers et salades. Préparés avec soin, pour une pause déjeuner réussie."
    ],
    "nl": [
      "Zaalvoetbalcomplex.\r\nKom en ontdek onze dagschotels en onze pizza's, hamburgers en salades. Met zorg bereid, voor een geslaagde lunchpauze."
    ],
    "es": [
      "Complejo de fútbol sala.\r\nVenga a descubrir nuestras especialidades del día, así como nuestras pizzas, hamburguesas y ensaladas. Preparadas con esmero, para que la pausa del almuerzo sea todo un éxito."
    ]
  },
