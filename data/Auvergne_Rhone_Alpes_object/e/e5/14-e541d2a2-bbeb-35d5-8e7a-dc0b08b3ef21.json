  "rdfs:comment": {
    "de": [
      "Ein Roadmovie, ein Road-Konzert vielleicht?\nEine Bank, eine Straßenlaterne irgendwo?\nEin Mann wacht auf und stammelt Worte, als wäre er wiedergeboren?\n\"Früher war ich Sänger?"
    ],
    "en": [
      "A road-movie, a road-concert perhaps?\nA bench, a lamppost somewhere?\nA man wakes up and stammers out words as if reborn?\n\"Before I was a singer?"
    ],
    "it": [
      "Un road-movie, un road-concert forse?\nUna panchina, un lampione da qualche parte?\nUn uomo si sveglia e balbetta parole come se fosse rinato?\n\"Prima ero un cantante?"
    ],
    "fr": [
      "Un road-movie, un road-concert peut-être…\nUn banc, un réverbère quelque part…\nUn homme se réveille et balbutie des mots comme s’il venait de renaître…\n« Avant j’étais chanteur… »"
    ],
    "es": [
      "¿Una road-movie, un road-concert quizás?\n¿Un banco, una farola en algún lugar?\n¿Un hombre se despierta y balbucea palabras como si renaciera?\n\"¿Antes de ser cantante?"
    ],
    "nl": [
      "Een roadmovie, een roadconcert misschien?\nEen bankje, een lantaarnpaal ergens?\nEen man wordt wakker en stamelt woorden alsof hij herboren is?\n\"Voordat ik een zanger was?"
    ]
  },
