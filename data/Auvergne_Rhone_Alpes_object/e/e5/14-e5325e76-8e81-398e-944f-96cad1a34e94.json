  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f5405f31-5b89-3248-9115-d5ccb4ade581",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nMontag bis Samstag von 5:30 bis 20:00 Uhr\n\nSonntag geschlossen\n \n Abholung:\nZum Mitnehmen während der Ladenöffnungszeiten\n\nTouren:\nDie Touren finden montags, mittwochs und samstags statt.\nKontaktieren Sie die Bäckerei unter 03 21 22 33 31, um die Routen zu erfahren\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nMonday to Saturday, 5.30am to 8pm\n\nClosed on Sunday\n \n Pick-up :\nTakeaway during store opening hours\n\nRounds:\nRounds are held on Mondays, Wednesdays and Saturdays.\nContact the bakery on 03 21 22 33 31 to find out about their itineraries\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nDal lunedì al sabato dalle 5.30 alle 20.00\n\nChiuso la domenica\n \n Ritiro :\nDa asporto durante gli orari di apertura del negozio\n\nGiri:\nI giri si svolgono il lunedì, il mercoledì e il sabato.\nPer conoscere l'itinerario, contattare la panetteria al numero 03 21 22 33 31\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nDu lundi au samedi de 5h30 à 20h\n\nFermeture le dimanche\n \n Retrait :\nÀ emporter aux horaires d'ouverture du magasin\n\nTournées:\nDes tournées ont lieu les lundis, les mercredis et les samedis. \nContacter la boulangerie au 03 21 22 33 31 afin de connaître leurs itinéraires\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nMaandag t/m zaterdag van 5.30 tot 20.00 uur\n\nGesloten op zondag\n \n Afhalen :\nAfhalen tijdens winkelopeningstijden\n\nRondes:\nRondes vinden plaats op maandag, woensdag en zaterdag.\nNeem contact op met de bakkerij op 03 21 22 33 31 voor de route\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nDe lunes a sábado de 5h30 a 20h00\n\nDomingos cerrado\n \n Recogida :\nPara llevar durante el horario de apertura de la tienda\n\nRondas:\nLas rondas tienen lugar los lunes, miércoles y sábados.\nPóngase en contacto con la panadería en el 03 21 22 33 31 para conocer el itinerario\n\n "
        ]
      },
