      "rdfs:comment": {
        "de": [
          "Das Team des Bauernhofs Moyembrie empfängt Sie freitags von 17 bis 18.30 Uhr und bietet Ihnen seine Eier und köstlichen Käsesorten an"
        ],
        "en": [
          "The team of the Moyembrie farm welcomes you on Fridays from 5 to 6:30 pm and offers you its eggs and delicious cheeses"
        ],
        "it": [
          "Il team della fattoria Moyembrie vi accoglie il venerdì dalle 17.00 alle 18.30 e vi offre le sue uova e i suoi deliziosi formaggi"
        ],
        "fr": [
          "L'équipe de la ferme de Moyembrie vous accueille le vendredi de 17h à 18h30 et vous propose ses œufs et délicieux fromages"
        ],
        "nl": [
          "Het team van de boerderij Moyembrie verwelkomt u op vrijdag van 17.00 tot 18.30 uur en biedt u zijn eieren en heerlijke kazen aan"
        ],
        "es": [
          "El equipo de la granja Moyembrie le recibe los viernes de 17 a 18.30 horas y le ofrece sus huevos y deliciosos quesos"
        ]
      },
