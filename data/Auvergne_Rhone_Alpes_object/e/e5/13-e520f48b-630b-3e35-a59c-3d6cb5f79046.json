  "rdfs:comment": {
    "de": [
      "Die Tour des Monts du Cantal mit dem Elektrofahrrad (Mountainbike oder Mountainbike) ist ein 8-tägiges Abenteuer, bei dem Sie dem großen Cantal-Vulkan ganz nah sind! Die Route führt zu den emblematischsten Naturschauplätzen dieser außergewöhnlichen Region."
    ],
    "en": [
      "The Tour des Monts du Cantal by electric bike (MTB or VTC) is 8 days of adventure close to the great Cantalien volcano! The itinerary takes in the most emblematic natural sites of this exceptional region."
    ],
    "it": [
      "Il Tour des Monts du Cantal in bicicletta elettrica (MTB o VTC) è un'avventura di 8 giorni vicino al grande vulcano Cantalien! L'itinerario vi porta nei siti naturali più emblematici di questa regione eccezionale."
    ],
    "fr": [
      "Le Tour des Monts du Cantal en vélo électrique (VTT ou VTC)  c'est 8 jours d'aventures au plus proche du grand volcan cantalien ! L'itinéraire permet d'accéder aux sites naturels les plus emblématiques de ce territoire d'exception."
    ],
    "es": [
      "¡El Tour des Monts du Cantal en bicicleta eléctrica (BTT o VTC) son 8 días de aventura cerca del gran volcán Cantalien! El itinerario le llevará por los parajes naturales más emblemáticos de esta región excepcional."
    ],
    "nl": [
      "De Tour des Monts du Cantal per elektrische fiets (MTB of VTC) is 8 dagen avontuur in de buurt van de grote vulkaan van de Cantalien! De route neemt je mee naar de meest emblematische natuurgebieden van deze uitzonderlijke regio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tour des Monts du Cantal en vélo électrique (VTTAE ou VTCAE) en 8 jours"
    ]
  },
