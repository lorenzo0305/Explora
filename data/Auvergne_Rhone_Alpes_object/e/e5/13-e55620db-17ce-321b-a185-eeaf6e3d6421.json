  "rdfs:comment": {
    "de": [
      "Morzine Avoriaz ist das Spartan-Wochenende des Sommers! Eingebettet in die Alpen ist die Flucht aus dem Alltag in diesem authentischen Bergdorf zum Greifen nah."
    ],
    "en": [
      "Morzine Avoriaz is the Spartan weekend of the summer! Nestled in the hollow of the Alps, escape is within reach in this authentic mountain village."
    ],
    "it": [
      "Morzine Avoriaz è il weekend spartano dell'estate! Immerso nelle Alpi, l'evasione è a portata di mano in questo autentico villaggio di montagna."
    ],
    "fr": [
      "Morzine Avoriaz c’est le week-end Spartan de l’été ! Niché au creux des Alpes, l’évasion est à portée de main dans ce village montagnard et authentique."
    ],
    "es": [
      "¡Morzine Avoriaz es el fin de semana espartano del verano! Enclavado en los Alpes, la evasión está al alcance de la mano en este auténtico pueblo de montaña."
    ],
    "nl": [
      "Morzine Avoriaz is het Spartaanse weekend van de zomer! Dit authentieke bergdorp ligt in het hart van de Alpen en is de perfecte plek om er even helemaal tussenuit te zijn."
    ]
  },
  "rdfs:label": {
