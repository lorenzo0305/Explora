  "rdfs:comment": {
    "de": [
      "Ob mit der Familie, mit Freunden oder mit Kollegen, genießen Sie in einem warmen und geselligen Rahmen eine große Auswahl an Pizzen und Brasseriegerichten."
    ],
    "en": [
      "With family, friends or colleagues, come and enjoy a wide choice of pizzas and brasserie dishes in a warm and friendly setting."
    ],
    "it": [
      "Con la famiglia, gli amici o i colleghi, venite a gustare un'ampia scelta di pizze e piatti da brasserie in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "En famille, entre amis ou entre collègues, venez déguster dans un cadre chaleureux et convivial un large choix de pizzas et des plats brasserie."
    ],
    "nl": [
      "Kom met familie, vrienden of collega's genieten van een ruime keuze aan pizza's en brasseriegerechten in een warme en gezellige sfeer."
    ],
    "es": [
      "Con la familia, los amigos o los colegas, venga a disfrutar de una amplia selección de pizzas y platos de brasserie en un ambiente cálido y acogedor."
    ]
  },
