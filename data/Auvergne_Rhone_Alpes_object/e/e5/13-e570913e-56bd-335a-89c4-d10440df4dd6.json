  "rdfs:comment": {
    "de": [
      "Traditionelles Café-Restaurant in der Ortschaft Larajasse, im Herzen der Monts du Lyonnais. Unter der Woche wird ein Tagesmenü mit lokalen und saisonalen Produkten angeboten. Auch sonntags mittags geöffnet mit einem Menü mit doppelter Auswahl."
    ],
    "en": [
      "Traditional café-restaurant in the village of Larajasse, in the heart of the Monts du Lyonnais. A Menu du Jour is available during the week, featuring local, seasonal produce. Also open for lunch on Sundays, with a double-choice menu."
    ],
    "it": [
      "Caffè-ristorante tradizionale nel villaggio di Larajasse, nel cuore dei Monts du Lyonnais. Durante la settimana è disponibile un menu del giorno a base di prodotti locali e di stagione. Aperto anche la domenica a pranzo, con un menu a doppia scelta."
    ],
    "fr": [
      "Café restaurant traditionnel situé dans le bourg de Larajasse, au coeur des Monts du Lyonnais. Un Menu du jour est proposé en semaine, avec des produits locaux et de saison. Ouvert également les dimanches midis avec un Menu à double choix."
    ],
    "nl": [
      "Traditioneel café-restaurant in het dorp Larajasse, in het hart van de Monts du Lyonnais. Door de week is er een dagmenu beschikbaar met lokale seizoensproducten. Ook op zondag geopend voor de lunch, met een dubbel keuzemenu."
    ],
    "es": [
      "Café-restaurante tradicional en el pueblo de Larajasse, en el corazón de los Montes del Lyón. Entre semana, menú del día a base de productos locales de temporada. También abierto los domingos para el almuerzo, con un menú doble."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La table de Ninon"
    ]
  },
