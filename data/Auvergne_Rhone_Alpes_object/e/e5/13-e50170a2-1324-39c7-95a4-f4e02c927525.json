  "rdfs:comment": {
    "de": [
      "Ein Restaurant mit 120 Plätzen, das sieben Tage die Woche mittags und abends geöffnet ist, Räume für Gruppenessen mit bis zu 180 Personen sowie Räume für geschäftliche und private Veranstaltungen."
    ],
    "en": [
      "A 120-seat restaurant open 7 days a week for lunch and dinner, rooms for group meals of up to 180 people, and spaces for professional and private events."
    ],
    "it": [
      "Un ristorante da 120 posti aperto 7 giorni su 7 per pranzo e cena, sale per pranzi di gruppo fino a 180 persone e spazi per eventi aziendali e privati."
    ],
    "fr": [
      "Un restaurant de 120 places ouvert 7 jours sur 7 midi et soir, des salles pour accueillir des repas de groupe jusqu'à 180 personnes, et des espaces pour des évènements professionnels et privés."
    ],
    "es": [
      "Un restaurante de 120 plazas abierto 7 días a la semana para almuerzos y cenas, salas para comidas de grupos de hasta 180 personas y espacios para eventos empresariales y privados."
    ],
    "nl": [
      "Een restaurant met 120 zitplaatsen dat 7 dagen per week geopend is voor lunch en diner, zalen voor groepsmaaltijden tot 180 personen en ruimtes voor zakelijke en privé-evenementen."
    ]
  },
