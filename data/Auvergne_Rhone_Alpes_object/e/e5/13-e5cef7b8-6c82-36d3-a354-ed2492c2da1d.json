  "rdfs:comment": {
    "de": [
      "Das Fort Charles Albert gehört zu den fünf sardischen Forts, die die Barriere von Esseillon bilden und nach den Herrschern der Familie Savoyen benannt sind."
    ],
    "en": [
      "Fort Charles Albert is one of the five Sardinian forts that make up the Esseillon barrier and bear the names of the sovereigns of the Savoy family."
    ],
    "it": [
      "Il Forte Carlo Alberto è uno dei cinque forti sardi che compongono la barriera dell'Esseillon e che portano i nomi dei sovrani di casa Savoia."
    ],
    "fr": [
      "Le Fort Charles Albert fait partie des cinq forts sardes qui composent la barrière de l'Esseillon et portent les noms des souverains de la famille de Savoie."
    ],
    "nl": [
      "Fort Charles Albert is een van de vijf Sardijnse forten die samen de Esseillonbarrière vormen en de namen dragen van de vorsten van de familie Savoie."
    ],
    "es": [
      "El fuerte Carlos Alberto es uno de los cinco fuertes sardos que conforman la barrera del Esseillon y que llevan el nombre de los soberanos de la familia Saboya."
    ]
  },
