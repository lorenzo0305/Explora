      "rdfs:comment": {
        "de": [
          "Probieren Sie den guten Spargel in der schönen Jahreszeit (April bis Juni).\nBietet auch Weihnachtsbäume an."
        ],
        "en": [
          "Come and taste the good asparagus in the beautiful season (April to June).\nAlso offers Christmas trees."
        ],
        "it": [
          "Venite a gustare i buoni asparagi nella stagione estiva (da aprile a giugno).\nOffre anche alberi di Natale."
        ],
        "fr": [
          "Venez déguster les bonnes asperges à la belle saison (avril à juin).\nPropose également les sapins de Noël."
        ],
        "es": [
          "Venga a probar los buenos espárragos en la temporada de verano (de abril a junio).\nTambién ofrece árboles de Navidad."
        ],
        "nl": [
          "Kom en proef de goede asperges in het zomerseizoen (april tot juni).\nBiedt ook kerstbomen aan."
        ]
      },
