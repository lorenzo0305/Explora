  "rdfs:comment": {
    "de": [
      "Bernadette Pierrard, Malerin, Kalligraphin, unterrichtet seit 31 Jahren Qigong, Taijiquan, Daoyinfa, Meditation.  Sie ist Geobiologin und Fengshui-Praktikerin.\r\nEntdecken Sie kalligraphische Werke und Gemälde, in einer ruhigen und gelassenen Atmosphäre."
    ],
    "en": [
      "Bernadette Pierrard, a painter and calligrapher, has been teaching Qigong, Taijiquan, Daoyinfa and meditation for 31 years.  She is also a geobiologist and fengshui practitioner.\r\nDiscover her calligraphic works and paintings in a calm and serene atmosphere."
    ],
    "it": [
      "Bernadette Pierrard, pittrice e calligrafa, insegna Qigong, Taijiquan, Daoyinfa e meditazione da 31 anni.  È anche geobiologa e praticante di fengshui.\r\nScoprite le sue opere calligrafiche e i suoi dipinti in un'atmosfera calma e serena."
    ],
    "fr": [
      "Bernadette Pierrard, artiste peintre, calligraphe, enseigne du Qigong, Taijiquan, Daoyinfa, Méditation depuis 31 ans.  Elle est géobiologue, praticienne de fengshui.\r\nDécouvrez les oeuvres calligraphiques et peintures, dans une ambiance calme et sereine."
    ],
    "nl": [
      "Bernadette Pierrard, schilderes en kalligraaf, geeft al 31 jaar les in Qigong, Taijiquan, Daoyinfa en meditatie.  Ze is ook geobioloog en fengshui-beoefenaar.\r\nOntdek haar kalligrafische werken en schilderijen in een rustige en serene sfeer."
    ],
    "es": [
      "Bernadette Pierrard, pintora y calígrafa, lleva 31 años enseñando Qigong, Taijiquan, Daoyinfa y meditación.  También es geobióloga y practicante de fengshui.\r\nDescubra sus obras caligráficas y pinturas en un ambiente tranquilo y sereno."
    ]
  },
