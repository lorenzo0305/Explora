  "rdfs:comment": {
    "de": [
      "Der See von Passy besitzt einen Raum von Strand, das Baden erlaubend, nur, das der Sommer überwacht ist, aber ebenfalls ein Raum breiten Sandes für hübsche Bauten von Sandburg mit ihren Kindern."
    ],
    "en": [
      "The Passy lake has a beach area where you can swim, kept under surveillance during summertime. The long sand beach offers the opportunity to build sand castles with children."
    ],
    "it": [
      "Il lago di Passy ha un'area di spiaggia, che permette di fare il bagno, solo sorvegliato in estate, ma anche un'ampia zona sabbiosa per costruire simpatici castelli di sabbia con i vostri bambini."
    ],
    "fr": [
      "Le lac de Passy possède un espace de plage, permettant la baignade, uniquement surveillée l'été, mais également un espace de sable large pour de jolies constructions de château de sable avec vos enfants."
    ],
    "nl": [
      "Het meer van Passy heeft een strandgedeelte, waar u kunt zwemmen, alleen onder toezicht in de zomer, maar ook een grote zandvlakte om met uw kinderen leuke zandkastelen te bouwen."
    ],
    "es": [
      "El Lago de Passy posee una zona de playa, que permite bañarse, solo vigilada en verano, pero también un espacio de arena para bonitas contrucciones de castillo de arena con sus hijos."
    ]
  },
  "rdfs:label": {
    "de": [
      "Strand - Raum von Baden See von Passy"
    ],
    "en": [
      "Beach-swimming area Lac de Passy"
    ],
    "fr": [
      "Plage - espace de Baignade Lac de Passy"
    ],
    "es": [
      "Playa - zona de baño al Lago de Passy"
    ]
  },
