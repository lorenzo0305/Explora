  "rdfs:comment": {
    "de": [
      "Das Bistro - Weinkeller des Hotels Les Tanin empfängt Sie das ganze Jahr über in einer herzlichen und geselligen Atmosphäre. Genießen Sie einen Moment mit Freunden oder der Familie und lassen Sie sich von guten Produkten verwöhnen!"
    ],
    "en": [
      "The Bistrot - wine cellar of the Hôtel Les Tanin welcomes you all year round in a warm and friendly atmosphere. Come and share a moment with friends or family over a selection of tasty products that will delight your taste buds!"
    ],
    "it": [
      "Il Bistrot - cantina dell'Hôtel Les Tanin vi accoglie tutto l'anno in un'atmosfera calda e accogliente. Venite a condividere un momento con gli amici o la famiglia davanti a una selezione di prodotti deliziosi che delizieranno il vostro palato!"
    ],
    "fr": [
      "Le Bistrot - cave à vin de l'Hôtel Les Tanin vous accueille toute l'année dans une ambiance chaleureuse et conviviale. Le temps d'une halte, venez partager un moment entre amis ou en famille autour de bons produits qui sauront ravir vos papilles!"
    ],
    "es": [
      "El Bistrot - bodega del Hôtel Les Tanin le da la bienvenida todo el año en un ambiente cálido y acogedor. Venga a compartir un momento con los amigos o la familia en torno a una selección de deliciosos productos que harán las delicias de su paladar"
    ],
    "nl": [
      "De Bistrot - wijnkelder van Hôtel Les Tanin verwelkomt je het hele jaar door in een warme en gezellige sfeer. Kom en deel een moment met vrienden of familie onder het genot van een selectie heerlijke producten die uw smaakpapillen zullen verrukken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistrot de l'Hôtel Les Tanins"
    ]
  },
