  "rdfs:comment": {
    "de": [
      "Herzlich willkommen in unserem Hotel, das sich im Stadtzentrum gegenüber dem Thermalbad und in der Nähe der Pendelbusse befindet, die zum Fuß der Skipisten führen."
    ],
    "en": [
      "Welcome to pur Hotel, located in the city centre, in front of the Thermal baths and nearby the bus stops that brings you ti the slopes"
    ],
    "it": [
      "Benvenuti nel nostro hotel, situato nel centro della città, di fronte alle terme e vicino ai bus navetta che portano alle piste da sci."
    ],
    "fr": [
      "Soyez les bienvenus dans notre hôtel, situé en centre-ville, face à l'établissement thermal et proche des navettes qui conduisent au pied des pistes de ski."
    ],
    "nl": [
      "Welkom in ons hotel, gelegen in het centrum van de stad, tegenover de thermen en dicht bij de pendelbussen die naar de skipistes leiden."
