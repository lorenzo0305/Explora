  "rdfs:comment": {
    "de": [
      "Familienbetrieb seit vier Generationen. Gönnen Sie sich eine Mittagspause auf einer der schönsten schattigen Terrassen. Genießen Sie hausgemachte Gerichte mit lokalen Aromen in einer geselligen Atmosphäre. Ideal für Gruppen, Wanderer, Radfahrer, Motorradfahrer."
    ],
    "en": [
      "Family-run for 4 generations, treat yourself to a lunch break on one of the most beautiful shaded terraces. Enjoy home cooking with local flavors in a friendly atmosphere. Ideal for groups, hikers, bikers and motorcyclists."
    ],
    "it": [
      "A conduzione familiare da 4 generazioni, concedetevi una pausa pranzo su una delle più belle terrazze ombreggiate. Godetevi la cucina casalinga con i sapori locali in un'atmosfera amichevole. Ideale per gruppi, escursionisti, ciclisti e motociclisti."
    ],
    "fr": [
      "Maison familiale depuis 4 générations, offrez-vous une pause déjeuner sur l’une des plus belles terrasses ombragées. Savourez une cuisine maison aux saveurs locales dans une ambiance conviviale. Idéal pour groupes, randonneurs, cyclistes, motards."
    ],
    "es": [
      "Empresa familiar desde hace 4 generaciones, disfrute de una pausa para comer en una de las terrazas sombreadas más bonitas. Disfrute de la cocina casera con sabores locales en un ambiente acogedor. Ideal para grupos, excursionistas, ciclistas y motoristas."
    ],
    "nl": [
      "Al 4 generaties lang een familiebedrijf. Trakteer jezelf op een lunchpauze op een van de mooiste schaduwrijke terrassen. Geniet van huisgemaakte gerechten met lokale smaken in een vriendelijke sfeer. Ideaal voor groepen, wandelaars, fietsers en fietsers."
    ]
  },
