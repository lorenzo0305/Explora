  "rdfs:comment": {
    "de": [
      "Ihr Boutique-Café in Valence! Ein echter Moment der Entspannung.\r\nInnendekoration - Geschirr - Modeaccessoires - Prêt-à-porter - Schmuck\r\nKarte mit heißen und kalten Getränken und Süßigkeiten zum Picken in einem gemütlichen Rahmen!"
    ],
    "en": [
      "Your Café Boutique in Valence! A real moment of relaxation.\r\nHome decor - Tableware - Fashion accessories - Ready-to-wear - Jewelry\r\nA menu of hot and cold beverages and sweet treats to savor in a cosy setting!"
    ],
    "it": [
      "Il vostro Café Boutique a Valence! Un vero momento di relax.\r\nDecorazione d'interni - Articoli per la tavola - Accessori moda - Prêt-à-porter - Gioielli\r\nUn menu di bevande calde e fredde e dolci da gustare in un ambiente accogliente!"
    ],
    "fr": [
      "Votre Café Boutique à Valence ! Un vrai moment de détente.\r\nDécoration d'intérieur - Vaisselle - Accessoires de mode - Prêt-à-porter - Bijoux\r\nCarte de boissons chaudes et froides et douceurs à picorer dans un cadre chaleureux !"
    ],
    "es": [
      "¡Su Café Boutique en Valence! Un verdadero momento de relajación.\r\nDecoración - Vajilla - Accesorios de moda - Prêt-à-porter - Joyería\r\nUna carta de bebidas frías y calientes y dulces para degustar en un ambiente acogedor"
    ],
    "nl": [
      "Jouw Café Boetiek in Valence! Een echt moment van ontspanning.\r\nInterieurdecoratie - Serviesgoed - Modeaccessoires - Confectie - Sieraden\r\nEen kaart met warme en koude dranken en zoete lekkernijen om van te genieten in een gezellig kader!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café-boutique Né Ro Li"
    ]
  },
