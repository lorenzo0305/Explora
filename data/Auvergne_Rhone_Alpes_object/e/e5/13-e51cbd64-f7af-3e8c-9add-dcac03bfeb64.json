  "rdfs:comment": {
    "de": [
      "\"Cuir fer-os\" ist ein Atelier in Tailhac, in dem der Kunsthandwerker, Bruno Richard, mit Leidenschaft hochwertige Stücke aus natürlichen Materialien wie Knochen, Holz, Leder und Stahl herstellt."
    ],
    "en": [
      "\"Cuir fer-os\" is a workshop in Tailhac where craftsman Bruno Richard passionately creates quality pieces using natural materials such as bone, wood, leather and steel."
    ],
    "it": [
      "\"Cuir fer-os\" è un laboratorio di Tailhac dove l'artigiano Bruno Richard crea con passione pezzi di qualità utilizzando materiali naturali come osso, legno, pelle e acciaio."
    ],
    "fr": [
      "\"Cuir fer-os\" est un atelier à Tailhac où l'artisan d'art, Bruno Richard crée avec passion des pièces de qualité avec des matériaux naturels comme les os, le bois, le cuir et l'acier."
    ],
    "nl": [
      "\"Cuir fer-os\" is een atelier in Tailhac waar ambachtsman Bruno Richard met passie kwaliteitsstukken maakt van natuurlijke materialen zoals been, hout, leer en staal."
    ],
    "es": [
      "\"Cuir fer-os\" es un taller de Tailhac donde el artesano Bruno Richard crea con pasión piezas de calidad utilizando materiales naturales como el hueso, la madera, el cuero y el acero."
    ]
  },
