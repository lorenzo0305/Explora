  "rdfs:comment": {
    "de": [
      "Im Rahmen des Bibliotheksfrühlings 2026 laden die Bibliothèque départementale und die Bibliothek von Vallon-en-Sully Sie ein, \"Ivre d'infinis\" mit der Clownin Gabrielle und der Begleiterin Tout Contre zu entdecken"
    ],
    "en": [
      "As part of Printemps des Bibliothèques 2026, the Bibliothèque Départementale and the Vallon-en-Sully library invite you to discover \"Ivre d'infinis\" with clown Gabrielle and companion Tout Contre"
    ],
    "it": [
      "Nell'ambito del Printemps des Bibliothèques 2026, la biblioteca dipartimentale e la biblioteca di Vallon-en-Sully vi invitano a scoprire \"Ivre d'infinis\" con il clown Gabrielle e la compagnia Tout Contre"
    ],
    "fr": [
      "Dans le cadre du Printemps des Bibliothèques 2026, la bibliothèque départementale et la bibliothèque de Vallon-en-Sully vous invite à découvrir \"Ivre d'infinis\" avec la clown Gabrielle et la compagne Tout Contre"
    ],
    "nl": [
      "In het kader van Printemps des Bibliothèques 2026 nodigen de departementale bibliotheek en de bibliotheek Vallon-en-Sully je uit om \"Ivre d'infinis\" te ontdekken met de clown Gabrielle en het gezelschap Tout Contre"
    ],
    "es": [
      "En el marco de Printemps des Bibliothèques 2026, la biblioteca departamental y la biblioteca de Vallon-en-Sully le invitan a descubrir \"Ivre d'infinis\" con el clown Gabrielle y la compañía Tout Contre"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Ivre d'infinis"
    ]
  },
