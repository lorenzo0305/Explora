  "rdfs:comment": {
    "de": [
      "Vom 26. März bis zum 23. August 2026 lädt Sie das Musée de Fourvière ein, eine originelle und delikate Ausstellung zu entdecken: Sacrées Boîtes (Heilige Schachteln).\r\nEin faszinierendes Eintauchen in ein Miniaturuniversum, in dem Kunst, Glaube und religiöses Know-how aufeinandertreffen."
    ],
    "en": [
      "From March 26 to August 23, 2026, the Fourvière Museum invites you to discover an original and delicate exhibition : Sacred boxes.\r\nA fascinating immersion into a miniature world where art, faith, and religious craftsmanship come together."
    ],
    "it": [
      "Dal 26 marzo al 23 agosto 2026, il Musée de Fourvière vi invita a scoprire una mostra originale e delicata: Sacrées Boîtes.\r\nUn'affascinante immersione in un universo in miniatura dove si incontrano arte, fede e sapere religioso."
    ],
    "fr": [
      "Du 26 mars au 23 août 2026, le musée de Fourvière vous invite à découvrir une exposition originale et délicate : Sacrées Boîtes.\r\nUne immersion fascinante dans un univers miniature où l’art, la foi et le savoir-faire religieux se rencontrent."
    ],
    "nl": [
      "Van 26 maart tot 23 augustus 2026 nodigt het Musée de Fourvière u uit voor een originele en delicate tentoonstelling: Sacrées Boîtes.\r\nEen fascinerende onderdompeling in een miniatuuruniversum waar kunst, geloof en religieuze kennis elkaar ontmoeten."
    ],
    "es": [
      "Del 26 de marzo al 23 de agosto de 2026, el museo de Fourvière le invita a descubrir una exposición original y delicada : Malditas cajas.\r\nUna fascinante inmersión en un universo en miniatura donde se dan cita el arte, la fe y el saber hacer religioso."
    ]
  },
