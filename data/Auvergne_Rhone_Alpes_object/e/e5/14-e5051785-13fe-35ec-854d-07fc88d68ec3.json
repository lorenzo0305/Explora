  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3645bdd4-c3fb-3a78-9672-d0ff9111671d",
      "dc:description": {
        "de": [
          "Ihr Gifi-Geschäft Merlimont bietet Ihnen Tausende von Artikeln, mit denen Sie sich ausstatten und jedes Ereignis des Jahres (Geburtstage, Hochzeiten, Ostern, Halloween, Weihnachten) feiern können: Luftballons, Kerzen, Servietten, Einweggeschirr, Verkleidungen, Schminke und Accessoires."
        ],
        "en": [
          "Your Gifi Merlimont store offers thousands of items to equip you and celebrate every event of the year (birthdays, weddings, Easter, Halloween, Christmas): balloons, candles, napkins, disposable tableware, masquerade costume, make-up and accessories."
        ],
        "it": [
          "Il vostro negozio Gifi Merlimont ha migliaia di articoli per attrezzarvi e festeggiare ogni evento dell'anno (compleanni, matrimoni, Pasqua, Halloween, Natale): palloncini, candele, tovaglioli, stoviglie usa e getta, costumi, trucchi e accessori."
        ],
        "fr": [
          "Votre magasin Gifi Merlimont vous propose des milliers d’articles pour vous équiper et fêter chaque événement de l’année (anniversaires, mariages, Pâques, Halloween, Noël) : ballon, bougie, serviette, vaisselle jetable, déguisement, maquillage et accessoires."
        ],
        "es": [
          "Tu tienda Gifi Merlimont dispone de miles de artículos para equiparte y celebrar todos los acontecimientos del año (cumpleaños, bodas, Pascua, Halloween, Navidad): globos, velas, servilletas, vajilla desechable, disfraces, maquillaje y accesorios."
        ],
        "nl": [
          "Je Gifi Merlimont winkel heeft duizenden artikelen om je uit te rusten en elk evenement van het jaar te vieren (verjaardagen, huwelijken, Pasen, Halloween, Kerstmis): ballonnen, kaarsen, servetten, wegwerpservies, verkleedkleren, make-up en accessoires."
        ]
      },
      "@type": [
        "Description"
      ],
