  "rdfs:comment": {
    "de": [
      "Sie haben ein Buch gelesen und möchten es mit anderen teilen, es auf Reisen schicken? Lesen, Entspannungspause, ausleihen, einreichen.... Sie entscheiden!"
    ],
    "en": [
      "Have you read a book, do you want to share it, make it travel? Reading, relaxing break, loan, deposit .... You decide !"
    ],
    "it": [
      "Avete letto un libro, volete condividerlo, portarlo in viaggio? Leggere, fare una pausa, prendere in prestito, depositare? Sta a voi decidere!"
    ],
    "fr": [
      "Vous avez lu un livre, vous avez envie de le partager, le faire voyager ? Lecture, pause-détente, emprunt, dépôt…. à vous de décider !"
    ],
    "es": [
      "¿Has leído un libro y quieres compartirlo, llevarlo de viaje? Leer, descansar, pedir prestado, depositar... ¡usted decide!"
    ],
    "nl": [
      "Heb je een boek gelezen, wil je het delen, laten reizen? Lezen, uitrusten, lenen, storten…. Jij beslist !"
    ]
  },
