  "rdfs:comment": {
    "de": [
      "Züchter von Milchschafen\nVerarbeitung von Schafsmilch im Schafstall zu Joghurt und Rohmilchkäse.\nDirektverkauf von Käse, Schafsjoghurt und Lammfleisch.\n\nVerkaufsautomat auf dem Bauernhof."
    ],
    "en": [
      "Dairy sheep farmer\nProcessing of sheep's milk at the sheepfold, into yoghurts and raw-milk cheeses.\nDirect sales of cheese, ewe yogurt and lamb meat.\n\nVending machine on the farm."
    ],
    "it": [
      "Allevatore di pecore da latte\nTrasformazione del latte di pecora nell'ovile, in yogurt e formaggi a latte crudo.\nVendita diretta di formaggio, yogurt di pecora e carne di agnello.\n\nDistributore automatico in azienda."
    ],
    "fr": [
      "Éleveur de brebis laitières\nTransformation du lait de brebis à la bergerie, en yaourts et en fromages au lait cru.\nVente directe de fromages, yaourts  de brebis et de viande d'agneau. \n\nDistributeur automatique à la ferme."
    ],
    "nl": [
      "Melkschapenboer\nVerwerking van schapenmelk in de schaapskooi, tot yoghurt en rauwmelkse kazen.\nDirecte verkoop van kaas, schapenyoghurt en lamsvlees.\n\nVerkoopautomaat op de boerderij."
    ],
    "es": [
      "Ganadero de ovejas lecheras\nTransformación de la leche de oveja en el aprisco, en yogures y quesos de leche cruda.\nVenta directa de queso, yogur de oveja y carne de cordero.\n\nMáquina expendedora en la explotación."
    ]
  },
