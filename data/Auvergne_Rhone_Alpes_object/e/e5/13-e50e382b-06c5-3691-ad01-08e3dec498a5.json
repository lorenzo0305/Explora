  "rdfs:comment": {
    "de": [
      "Die von Romans Scènes erstellte Saison des spectacles zeigt ein eklektisches und multidisziplinäres Programm mit Theater, Tanz, Chanson, Musik, Oper, aber auch visueller Kunst, Zirkus oder Humor."
    ],
    "en": [
      "The Saison des spectacles, put together by Romans Scènes, features an eclectic, multidisciplinary program of theater, dance, song, music and opera, as well as visual arts, circus and comedy."
    ],
    "it": [
      "La Stagione degli spettacoli, organizzata da Romans Scènes, offre un programma eclettico e multidisciplinare con teatro, danza, canto, musica, opera, ma anche arti visive, circo e commedia."
    ],
    "fr": [
      "La Saison des spectacles, élaborée par Romans Scènes, affiche une programmation éclectique et pluridisciplinaire avec du théâtre, de la danse, de la chanson, de la musique, de l'opéra, mais aussi des arts visuels, du cirque, ou encore de l'humour."
    ],
    "es": [
      "La Temporada de Espectáculos, elaborada por Romans Scènes, ofrece un programa ecléctico y multidisciplinar con teatro, danza, canto, música, ópera, pero también artes visuales, circo y comedia."
    ],
    "nl": [
      "Het Seizoen van de Voorstellingen, samengesteld door Romans Scènes, biedt een eclectisch, multidisciplinair programma van theater, dans, zang, muziek en opera, maar ook beeldende kunst, circus en komedie."
    ]
  },
