  "rdfs:comment": {
    "de": [
      "Das City-Stadion befindet sich gegenüber dem Schwimmbad von Allevard. Der Belag besteht aus Teer, hier können Sie Basketball, Fußball und Handball spielen."
    ],
    "en": [
      "The city stadium is located opposite the Allevard swimming pool and has a tarmac surface where you can play basketball, football and handball."
    ],
    "it": [
      "Lo stadio cittadino si trova di fronte alla piscina Allevard, la superficie è in asfalto, si può giocare a basket, calcio, pallamano."
    ],
    "fr": [
      "Le city stade se trouve en face de la piscine d'Allevard, le revêtement est en goudron, vous pourrez y jouer au basket, foot, hand.."
    ],
    "nl": [
      "Het city stadion ligt tegenover het zwembad Allevard en heeft een geasfalteerd oppervlak waar je kunt basketballen, voetballen en handballen."
