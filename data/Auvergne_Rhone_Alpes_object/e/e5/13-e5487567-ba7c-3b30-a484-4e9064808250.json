  "rdfs:comment": {
    "de": [
      "Ama Théâtre ist eine Amateurtruppe, die zahlreiche Stücke auf dem Haut-Lignon und in der gesamten Haute-Loire aufführt. ihre Erfolgsliste ist reich und vielfältig!"
    ],
    "en": [
      "Ama Théâtre is an amateur troupe that puts on numerous plays in the Haut-Lignon and throughout the Haute-Loire region. Their track record is rich and varied!"
    ],
    "it": [
      "Ama Théâtre è una compagnia amatoriale che mette in scena numerosi spettacoli nell'Haut-Lignon e in tutta la Haute-Loire. Il loro curriculum è ricco e variegato!"
    ],
    "fr": [
      "Ama Théâtre est une troupe amateur qui présente de nombreuses pièces sur le Haut-Lignon et dans toute la Haute-Loire. leur palmarès est riche et varié !"
    ],
    "nl": [
      "Ama Théâtre is een amateurgezelschap dat een aantal toneelstukken opvoert in de Haut-Lignon en in de Haute-Loire. Hun staat van dienst is rijk en gevarieerd!"
    ],
    "es": [
      "Ama Théâtre es una compañía de aficionados que representa numerosas obras en Haut-Lignon y en todo el Alto Loira. ¡Su trayectoria es rica y variada!"
    ]
  },
