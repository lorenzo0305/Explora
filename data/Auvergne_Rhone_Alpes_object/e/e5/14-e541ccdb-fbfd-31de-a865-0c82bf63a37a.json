  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7d3471e4-b902-3968-9064-b6e4d920bfb1",
      "dc:description": {
        "de": [
          "Baby-Gym-Workshop in Preures\nWecken Sie die Sinne und die Motorik Ihres Kleinkindes!\n\nDer Workshop Baby Gym in Preures lädt Kinder von 1/3 bis 3/5 Jahren zu einem Vormittag voller Spiele und Erkundungen in einer spielerischen und sicheren Umgebung ein."
        ],
        "en": [
          "Baby Gym workshop at Preures\nAwaken your toddler's senses and motor skills!\n\nThe Preures Baby Gym workshop invites children aged 1/3 to 3/5 to a morning of play and exploration in a safe, fun environment."
        ],
        "it": [
          "Laboratorio Baby Gym a Preures\nRisvegliate i sensi e le capacità motorie del vostro piccolo!\n\nIl laboratorio Baby Gym di Preures invita i bambini di età compresa tra 1/3 e 3/5 anni a una mattinata di gioco ed esplorazione in un ambiente sicuro e divertente."
        ],
        "fr": [
          "Atelier Baby Gym à Preures\nEveillez les sens et la motricité de votre tout-petit !\n\nL'atelier Baby Gym de Preures invite les enfants de 1/3 ans à 3/5 ans à une matinée de jeux et d'exploration dans un environnement ludique et sécurisé."
        ],
        "es": [
          "Taller de gimnasia para bebés en Preures\n¡Despierta los sentidos y la motricidad de tu pequeño!\n\nEl taller Baby Gym de Preures invita a los niños de entre 1/3 y 3/5 años a una mañana de juego y exploración en un entorno seguro y divertido."
        ],
        "nl": [
          "Baby Gym workshop bij Preures\nPrikkel de zintuigen en motoriek van je kleintje!\n\nDe Preures Baby Gym workshop nodigt kinderen tussen 1/3 en 3/5 uit voor een ochtend vol spel en ontdekking in een veilige, leuke omgeving."
        ]
      },
      "@type": [
        "Description"
      ],
