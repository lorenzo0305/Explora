    ],
    "en": [
      "Saint-Flour, a medieval and historic city"
    ],
    "fr": [
      "Saint-Flour, Pays d'art et d'histoire"
    ],
    "nl": [
      "St-Flour, historische en middeleeuwse stad"
    ]
  },
