  "rdfs:comment": {
    "de": [
      "Hotel Restaurant Spa **** Ideal gelegen im Zentrum des Ortes, an einem ruhigen Ort in der Nähe des Golfplatzes, am Fuße der Pisten und nur wenige Schritte von den Geschäften entfernt.\r\nFamiliengeführtes Chalet mit 18 Zimmern."
    ],
    "en": [
      "A family 4-star Hotel Restaurant and Spa in the center of the resort, at the foot of the slopes and very close to the Jandry Express lift leading directly to the glacier."
    ],
    "it": [
      "Hotel Restaurant Spa **** situato in posizione ideale nel centro della località, in una zona tranquilla vicino al campo da golf, ai piedi delle piste e a pochi passi dai negozi.\r\nChalet di 18 camere a conduzione familiare."
    ],
    "fr": [
      "Hôtel Restaurant Spa ****  idéalement situé au centre de la station, dans un endroit calme à proximité du golf, au pied des pistes et à deux pas des commerces.\r\nChalet de 18 chambres de gestion familiale."
    ],
    "es": [
      "Hotel Restaurante Spa **** idealmente situado en el centro de la estación, en una zona tranquila cerca del campo de golf, a pie de pistas y a dos pasos de las tiendas.\r\nChalet familiar de 18 habitaciones."
    ],
    "nl": [
      "Hotel Restaurant Spa **** is ideaal gelegen in het centrum van het resort, in een rustige omgeving dicht bij de golfbaan, aan de voet van de pistes en op een steenworp afstand van de winkels.\r\nChalet met 18 kamers, beheerd door een familie."
    ]
  },
  "rdfs:label": {
