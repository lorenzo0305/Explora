  "rdfs:comment": {
    "de": [
      "Rudern. Traditionelles Rudern. Rettungsboot.\r\n\r\nKinder, Jugendliche und Erwachsene. Wettkampf und Freizeit.\r\n\r\nDer Ruderclub hat eine Abteilung für \"Wettkampfrudern\" und eine Abteilung für \"Freizeitrudern\"."
    ],
    "en": [
      "Rowing. Traditional oar. Lifeboat.\r\n\r\nChildren, teens and adults. Competition and leisure.\r\n\r\nThe rowing club has a \"competition rowing\" section and a \"leisure rowing\" section."
    ],
    "it": [
      "Canottaggio. Remi tradizionali. Scialuppa di salvataggio.\r\n\r\nBambini, adolescenti e adulti. Competizione e tempo libero.\r\n\r\nIl club di canottaggio ha una sezione \"canottaggio da competizione\" e una sezione \"canottaggio da diporto\"."
    ],
    "fr": [
      "Aviron. Rame traditionnelle. Barque de sauvetage.\r\n\r\nEnfants, ados et adultes. Compétition et loisir.\r\n\r\nLe club d'aviron a une section \"aviron compétition\" et une section \"aviron loisir\"."
    ],
    "nl": [
      "Roeien. Traditionele roeispaan. Reddingsboot.\r\n\r\nKinderen, tieners en volwassenen. Competitie en vrije tijd.\r\n\r\nDe roeivereniging heeft een sectie \"wedstrijdroeien\" en een sectie \"vrijetijdsroeien\"."
    ],
    "es": [
      "El remo. Remo tradicional. Bote salvavidas.\r\n\r\nNiños, adolescentes y adultos. Competencia y ocio.\r\n\r\nEl club de remo tiene una sección de \"remo de competición\" y otra de \"remo de ocio\"."
    ]
  },
