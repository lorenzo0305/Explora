  "rdfs:comment": {
    "de": [
      "Foot&Co ist ein Indoor-Sportkomplex, der sieben Tage die Woche geöffnet ist und zwei Fußball- und Badmintonplätze, ein 3x3-Basketballfeld, ein Paddle-Tennisfeld und bald auch zwei Bahnen für das Hackenwerfen bietet. Der ideale Ort, um mit Freunden, Familie oder Kollegen Spaß zu haben."
    ],
    "en": [
      "Foot&Co is an indoor sports complex open 7 days a week, offering two soccer pitches, badminton, a 3x3 basketball court, a padel court and soon 2 lanes for axe throwing. The ideal place to have fun with friends, family or colleagues."
    ],
    "it": [
      "Foot&Co è un complesso sportivo indoor aperto 7 giorni su 7 che offre due campi da calcio, badminton, un campo da basket 3x3, un campo da padel e presto 2 corsie per il lancio dell'ascia. Il luogo ideale per divertirsi con gli amici, la famiglia o i colleghi."
    ],
    "fr": [
      "Foot&Co est un complexe sportif indoor ouvert 7j/7 proposant deux terrains de foot, de badminton, un terrain de basket 3x3, un terrain de padel et bientôt 2 couloirs pour le lancer de hâche. Le lieu idéal pour vous amuser entre amis, famille ou collègues."
    ],
    "nl": [
      "Foot&Co is een indoor sportcomplex dat 7 dagen per week open is en twee voetbalvelden, badminton, een 3x3 basketbalveld, een padelveld en binnenkort 2 banen voor bijlwerpen biedt. De ideale plek om plezier te maken met vrienden, familie of collega's."
    ],
    "es": [
      "Foot&Co es un complejo deportivo cubierto abierto los 7 días de la semana que ofrece dos campos de fútbol, bádminton, una cancha de baloncesto 3x3, una pista de pádel y próximamente 2 pistas para lanzamiento de hacha. El lugar ideal para divertirse con los amigos, la familia o los colegas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Foot & Co : foot en salle, badminton, basket 3x3, padel et lancer de hâche"
    ]
  },
