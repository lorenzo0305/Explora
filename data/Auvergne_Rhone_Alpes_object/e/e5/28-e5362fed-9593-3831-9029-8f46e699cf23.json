  "rdfs:comment": {
    "de": [
      "In Noyon entdecken Sie Adele und Louis, die Boutique für Lederwaren im Vintage-Leder-Stil.  Handtaschen, Geldbörsen, Hüte, alle Accessoires, um das beste Geschenk für jeden Anlass zu finden."
    ],
    "en": [
      "In Noyon, discover Adèle et Louis, the leather goods boutique in vintage leather style.  Handbag, wallet, hat, all the accessories to find the best gift for any occasion."
    ],
    "it": [
      "A Noyon, scoprite il negozio di pelletteria vintage Adèle et Louis.  Borse, borsette, cappelli, tutti gli accessori per trovare il regalo migliore per ogni occasione."
    ],
    "fr": [
      "A Noyon, découvrez Adèle et Louis la boutique de maroquinerie style cuir vintage.  Sac à main, porte-monnaie, chapeau, tous les accessoires pour trouver le meilleur cadeau pour n’importe quelle occasion."
    ],
    "nl": [
      "Ontdek in Noyon de vintage lederwarenwinkel Adèle et Louis.  Handtas, tas, hoed, alle accessoires om het beste cadeau voor elke gelegenheid te vinden."
    ],
    "es": [
      "En Noyon, descubra la tienda de marroquinería vintage Adèle et Louis.  Bolso, monedero, sombrero, todos los accesorios para encontrar el mejor regalo para cualquier ocasión."
    ]
  },
