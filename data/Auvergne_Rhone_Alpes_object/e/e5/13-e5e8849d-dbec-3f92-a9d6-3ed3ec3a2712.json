  "rdfs:comment": {
    "de": [
      "Das Maison de la Musique ist sowohl eine Musikschule als auch ein Veranstaltungssaal. Hier werden Konzerte mit aktueller oder klassischer Musik, Theateraufführungen und Filmvorführungen veranstaltet."
    ],
    "en": [
      "Music venue"
    ],
    "it": [
      "La Maison de la Musique è sia una scuola di musica che una sala per spettacoli. Vi si programmano concerti di musica contemporanea o classica, spettacoli e proiezioni di film."
    ],
    "fr": [
      "La Maison de la musique est à la fois une école de musique et une salle de spectacle. Des concerts de musiques actuelles ou classique, des spectacles, des séances de cinéma y sont programmés."
    ],
    "es": [
      "La Maison de la Musique es a la vez escuela de música y auditorio. Aquí se programan conciertos de música contemporánea o clásica, espectáculos y proyecciones de películas."
    ],
    "nl": [
      "Het Maison de la Musique is zowel een muziekschool als een uitvoeringszaal. Er worden concerten van hedendaagse of klassieke muziek, voorstellingen en filmvertoningen geprogrammeerd."
    ]
  },
