  "rdfs:comment": {
    "de": [
      "Erkunden Sie die wunderschöne Landschaft der Balcons du Dauphiné mit einem geländegängigen E-Trottinett! Sie sind stabil, leistungsstark und umweltfreundlich und bieten Ihnen ein leicht zugängliches Fun-Erlebnis auf Wegen, Radwegen und grünen Routen."
    ],
    "en": [
      "Set off on an all-terrain e-scooter adventure and explore the magnificent landscapes of the Balcons du Dauphiné! Stable, powerful and environmentally-friendly, they offer a fun and accessible experience on paths, cycle tracks and greenways."
    ],
    "it": [
      "Partite per un'avventura in e-scooter su tutti i terreni ed esplorate i magnifici paesaggi dei Balcons du Dauphiné! Stabili, potenti ed ecologici, offrono un'esperienza divertente e accessibile su sentieri, piste ciclabili e greenways."
    ],
    "fr": [
      "Partez à l’aventure en e-trottinette tout-terrain et explorez les magnifiques paysages des Balcons du Dauphiné ! Stables, puissantes et écologiques, elles vous offrent une expérience fun et accessible sur chemins, pistes cyclables et voies vertes."
    ],
    "nl": [
      "Vertrek op een all-terrain e-scooteravontuur en verken de prachtige landschappen van de Balcons du Dauphiné! Ze zijn stabiel, krachtig en milieuvriendelijk en bieden een leuke en toegankelijke ervaring op paden, fietspaden en groene wegen."
    ],
    "es": [
      "Embárcate en una aventura en e-scooter todo terreno y explora los magníficos paisajes de los Balcons du Dauphiné Estables, potentes y respetuosos con el medio ambiente, ofrecen una experiencia divertida y accesible en senderos, carriles bici y vías verdes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Trott Explorer, all-terrain electric scooters"
    ],
    "fr": [
      "Trott Explorer,  trottinettes électriques tout-terrain"
    ]
  },
