  "rdfs:comment": {
    "de": [
      "Ein Bereich, der aus einer ca. 1 km langen Bahn, einem Strafring und einem Schießstand für 10m-Schießen und 50m-Schießen besteht.\r\nDas ganze Jahr über zugänglich (Skifahren im Winter - Inline-Skaten / Ski-Rollen etc. außerhalb der Schneeperioden)."
    ],
    "en": [
      "Area comprising a 1 km track, a penalty ring and a shooting range for 10m and 50m shooting.\r\nAccessible all year round (skiing in winter - inline skating / ski-wheeling etc. outside snowy periods)."
    ],
    "it": [
      "Un'area che comprende una pista di 1 km, un anello di penalità e un poligono di tiro a 10 e 50 metri.\r\nAccessibile tutto l'anno (sci in inverno - pattinaggio in linea/sci ecc. al di fuori dei periodi di neve)."
    ],
    "fr": [
      "Espace composé d'une piste d'environ 1 km, d’un anneau de pénalité et d’un pas de tir pour du tir à 10m et du tir à 50m.\r\nAccessible toute l'année (ski en hiver - roller / ski-roue etc en dehors des périodes de neige)."
    ],
    "es": [
      "Espacio compuesto por una pista de 1 km, un anillo de penalización y un campo de tiro de 10 y 50 metros.\r\nAccesible todo el año (esquí en invierno - patinaje en línea / esquí-rueda, etc. fuera de los periodos de nieve)."
    ],
    "nl": [
      "Een terrein bestaande uit een baan van 1 km, een penaltyring en een schietbaan voor 10m en 50m schieten.\r\nHet hele jaar toegankelijk (skiën in de winter - inline skaten / skiwheelen etc. buiten de sneeuwperiodes)."
    ]
  },
  "rdfs:label": {
