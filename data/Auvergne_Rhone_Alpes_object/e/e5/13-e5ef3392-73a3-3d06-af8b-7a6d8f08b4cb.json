  "rdfs:comment": {
    "de": [
      "Le P'tit Savoyard ist ein authentisches savoyisches Restaurant. Bei FABIEN, der dritten Generation von VALMINEUX-Händlern, werden die kulinarischen Traditionen unserer Altvorderen geehrt und mit Herzblut gekocht"
    ],
    "en": [
      "Le P'tit Savoyard is a bistronomic Savoyard restaurant, wine bar and cigar cellar with a terrace on the snow front.\r\nAnd still this winter 22/23, come and discover the Chalet du P'tit Savoyard (snack, waffles, pancakes, churros, drinks)."
    ],
    "it": [
      "Le P'tit Savoyard è un autentico ristorante savoiardo. Da FABIEN, 3a generazione di negozianti di VALMINEUX, le tradizioni culinarie dei nostri antenati sono onorate e preparate con cuore e anima"
    ],
    "fr": [
      "Le P'tit Savoyard est un restaurant savoyard authentique. Chez FABIEN, 3ème génération de commerçants VALMINEUX, les traditions culinaires de nos anciens sont à l'honneur et mitonnées avec coeur"
    ],
    "nl": [
      "Le P'tit Savoyard is een bistronomisch Savoyard restaurant, wijnbar en sigarenkelder met een terras aan de voorkant van de sneeuw.\r\nEn nog steeds deze winter 22/23, kom en ontdek de Chalet du P'tit Savoyard (snack, wafels, pannenkoeken, churros, drankjes)."
    ],
    "es": [
      "Le P'tit Savoyard es un auténtico restaurante saboyano. En FABIEN's, tercera generación de comerciantes de VALMINEUX, se honran las tradiciones culinarias de nuestros antepasados y se preparan con alma y corazón"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Table du P'Tit Savoyard"
    ],
    "fr": [
      "La Table du P'tit Savoyard"
    ],
    "nl": [
      "La Table du P'Tit Savoyard"
    ]
  },
