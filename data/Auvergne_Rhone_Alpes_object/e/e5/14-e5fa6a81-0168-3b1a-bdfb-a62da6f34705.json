  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6da90aa7-305c-3937-b314-686f83c72fe8",
      "dc:description": {
        "de": [
          "Die Stadtbibliothek veranstaltet im Rahmen des Literaturtreffens einen Zeichenwettbewerb zum Thema Ferien.\nPreisverleihung an die Gewinner um 16 Uhr im Espace MAHAHIEUDE"
        ],
        "en": [
          "The Municipal Library is organizing a holiday-themed drawing competition as part of the Rencontre Littéraire.\nWinners receive their prizes at 4pm at Espace MAHAHIEUDE"
        ],
        "it": [
          "Nell'ambito della Rencontre Littéraire, la Biblioteca comunale organizza un concorso di disegno sul tema delle vacanze.\nI premi saranno consegnati ai vincitori alle 16.00 nell'Espace MAHAHIEUDE"
        ],
        "fr": [
          "La Bibliothèque Municipale organise un concours de dessin sur le thème des vacances dans le cadre de la Rencontre Littéraire.\nRemise des prix aux gagnants à 16h à l'Espace MAHAHIEUDE"
        ],
        "es": [
          "La Biblioteca Municipal organiza un concurso de dibujo sobre el tema de las vacaciones en el marco del Rencontre Littéraire.\nLos premios se entregarán a los ganadores a las 16.00 horas en el Espacio MAHAHIEUDE"
        ],
        "nl": [
          "De Gemeentelijke Bibliotheek organiseert een tekenwedstrijd met als thema vakantie in het kader van de Rencontre Littéraire.\nOm 16.00 uur worden in de Espace MAHAHIEUDE prijzen uitgereikt aan de winnaars"
        ]
      },
