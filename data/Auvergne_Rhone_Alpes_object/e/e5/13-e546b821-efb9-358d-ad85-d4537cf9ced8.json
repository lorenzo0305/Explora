  "rdfs:comment": {
    "de": [
      "Naturgebiet mit einem 86 ha großen See. Möglichkeit für verschiedene Wassersportarten, Wanderungen oder Entspannung in einer geschützten Umgebung.\r\nVerschiedene Wassersportaktivitäten (Vermietung von Paddles, Booten, Kanus, Tretbooten ...)"
    ],
    "en": [
      "A natural site with an 86-hectare lake. A wide range of water sports, hiking and leisure activities in an unspoilt setting.\r\nVarious water sports activities (paddleboat hire, rowing boats, canoes, pedalos, etc.)."
    ],
    "it": [
      "Un sito naturale con un lago di 86 ettari. Un'ampia gamma di sport acquatici, escursioni e attività ricreative in un ambiente incontaminato.\r\nDiverse attività sportive acquatiche (noleggio pedalò, barche a remi, canoe, pedalò, ecc.)"
    ],
    "fr": [
      "Site naturel comprenant un lac de 86 ha. Possibilité de diverses activités nautiques, de randonnée ou de détente dans un cadre préservé.\r\nActivités nautiques diverses (location de paddles, barques, canoés, pédalos …)"
    ],
    "es": [
      "Un paraje natural con un lago de 86 hectáreas. Numerosas actividades náuticas, de senderismo y de ocio en un entorno natural.\r\nDiversas actividades náuticas (alquiler de barcas de remos, canoas, hidropedales, etc.)"
    ],
    "nl": [
      "Een natuurgebied met een meer van 86 hectare. Tal van watersport-, wandel- en vrijetijdsactiviteiten in een ongerepte omgeving.\r\nDiverse watersportactiviteiten (verhuur van waterfietsen, roeiboten, kano's, waterfietsen...)"
    ]
  },
