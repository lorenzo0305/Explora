  "rdfs:comment": {
    "de": [
      "Seit 1977, Bergstimmung im Herzen der 3 Täler. Nutzen Sie unsere Terrasse mit Blick auf den Mont Vallon zum Mittagessen oder für einen Snack nach der Rückkehr von Ihrer Wanderung (Crêpes, Waffeln, Dessert). Hausgemachte Pizzas zum Mittagessen oder abends zum Mitnehmen."
    ],
    "en": [
      "Since 1977 a mountain atmosphere in the heart of the 3 valleys, enjoy our terrace with a view of Mont Vallon for lunch or when you return from your hike (pancakes, waffles, dessert). Homemade pizza for lunch or in the evening to take away."
    ],
    "it": [
      "Dal 1977, un'atmosfera di montagna nel cuore delle 3 valli. Godetevi la nostra terrazza con vista sul Mont Vallon per un pranzo o uno spuntino al ritorno da un'escursione (crêpes, waffles, dessert). Pizze fatte in casa a pranzo o da asporto la sera."
    ],
    "fr": [
      "Depuis 1977, ambiance montagne au cœur des 3 vallées. Profitez de notre terrasse avec vue sur le Mont Vallon pour le déjeuner ou pour le goûter au retour de votre randonné (crêpes, gaufres, dessert). Pizzas maison au déjeuner ou bien le soir à emporter."
    ],
    "nl": [
      "Sinds 1977, bergsfeer in het hart van de 3 valleien. Geniet van ons terras met uitzicht op de Mont Vallon voor de lunch of voor een hapje bij terugkomst van uw wandeling (pannenkoeken, wafels, dessert). Huisgemaakte pizza's voor de lunch of om 's avonds mee te nemen."
    ],
    "es": [
      "Desde 1977, un ambiente de montaña en el corazón de los 3 valles. Disfrute de nuestra terraza con vistas al Mont Vallon para comer o tomar un tentempié a la vuelta de una excursión (crêpes, gofres, postre). Pizzas caseras para comer o para llevar por la noche."
    ]
  },
