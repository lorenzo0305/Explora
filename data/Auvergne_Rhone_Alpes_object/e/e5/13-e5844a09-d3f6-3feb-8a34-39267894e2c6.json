  "rdfs:comment": {
    "de": [
      "Im Herzen des Stadtzentrums gelegenes traditionelles Restaurant, das auf einer entspannten Küche basiert, in der frische Produkte durch \"eine Küche des Marktes, der Lust und der Jahreszeit\" im Vordergrund stehen."
    ],
    "en": [
      "In the heart of the city center, a traditional restaurant based on casual cuisine, where fresh produce is given pride of place through \"market, craving and seasonal cuisine\"."
    ],
    "it": [
      "Nel cuore del centro città, un ristorante tradizionale basato su una cucina rilassata, dove i prodotti freschi sono onorati attraverso \"una cucina di mercato, di desiderio e di stagione\"."
    ],
    "fr": [
      "En plein cœur du centre-ville, restaurant traditionnel basé sur une cuisine décontractée, où les produits frais sont à l’honneur à travers \"une cuisine du marché, d’envie et de saison\"."
    ],
    "nl": [
      "In het hart van het stadscentrum, een traditioneel restaurant gebaseerd op een ontspannen keuken, waar verse producten in ere worden gehouden door \"een keuken van de markt, het verlangen en het seizoen\"."
    ],
    "es": [
      "En el corazón del centro de la ciudad, un restaurante tradicional basado en una cocina relajada, donde se honran los productos frescos a través de \"una cocina de mercado, de deseo y de temporada\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Devant"
    ]
  },
