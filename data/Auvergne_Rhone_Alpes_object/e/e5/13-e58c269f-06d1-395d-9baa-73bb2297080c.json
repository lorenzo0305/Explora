  "rdfs:comment": {
    "de": [
      "Dieses luxuriöse Hotel mit 250 Zimmern wurde zwischen 1906 und 1909 für eine Tochtergesellschaft  der Société des eaux minérales nach den Plänen des Pariser Architekten Albert Hébrard erbaut."
    ],
    "en": [
      "This luxurious 250-room hotel was built between 1906 and 1909 for a subsidiary of the Société des eaux minérales, based on the plans of the Parisian architect Albert Hébrard."
    ],
    "it": [
      "Questo hotel di lusso di 250 camere fu costruito tra il 1906 e il 1909 per una filiale della Société des eaux minérales, su progetto dell'architetto parigino Albert Hébrard."
    ],
    "fr": [
      "Ce luxueux hôtel de 250 chambres est construit entre 1906 et 1909 pour une filiale de la Société des eaux minérales, sur les plans de l’architecte parisien Albert Hébrard."
    ],
    "es": [
      "Este hotel de lujo de 250 habitaciones fue construido entre 1906 y 1909 para una filial de la Société des eaux minérales, según los diseños del arquitecto parisino Albert Hébrard."
    ],
    "nl": [
      "Dit luxe hotel met 250 kamers werd tussen 1906 en 1909 gebouwd voor een dochteronderneming van de Société des eaux minérales, naar een ontwerp van de Parijse architect Albert Hébrard."
    ]
  },
