  "rdfs:comment": {
    "de": [
      "Das Château des Ravatys ist ein Veranstaltungsort für Firmen- und Privatveranstaltungen. Es ist außerdem ein Weingut mit den AOC-Weinen BROUILLY und CÔTE DE BROUILLY, darunter Parzellen in exponierter Lage an den Hängen des Mont Brouilly."
    ],
    "en": [
      "Château des Ravatys vineyard is spread over 36 hectares of Brouilly and Côte de Brouilly PDO. The only grape variety is black gamay with white juice, ideal on the sunny slopes of the Mont Brouilly."
    ],
    "it": [
      "Lo Château des Ravatys è un luogo di ricevimento per eventi aziendali e privati. È anche un'azienda vinicola AOC BROUILLY e CÔTE DE BROUILLY, con appezzamenti ben esposti sulle pendici del Mont Brouilly."
    ],
    "fr": [
      "Le Château des Ravatys est un lieu de réception pour les événements d'entreprises et privés. C'est aussi un domaine viticole en AOC BROUILLY et CÔTE DE BROUILLY dont des parcelles  bien exposées sur les coteaux du mont Brouilly."
    ],
    "es": [
      "El Château des Ravatys es un lugar de recepción para eventos corporativos y privados. También es una finca vinícola AOC BROUILLY y CÔTE DE BROUILLY, con parcelas bien expuestas en las laderas del Mont Brouilly."
    ],
    "nl": [
      "Château des Ravatys is een ontvangstlocatie voor bedrijfs- en privé-evenementen. Het is ook een AOC BROUILLY en CÔTE DE BROUILLY wijndomein, met goed belichte percelen op de hellingen van de Mont Brouilly."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ravatys' Castle"
    ],
    "fr": [
      "Château des Ravatys"
    ]
  },
