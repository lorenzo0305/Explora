  "rdfs:comment": {
    "de": [
      "Sandrine Rousseau wird über ihr neues Buch beim Verlag La Meute sprechen: \"Tu nuis à la cause\" in der Kollektion Permis de déconstruire.\r\n\r\nEine feministische Veranstaltung über die Injurien, die Frauen im militanten Milieu auferlegt werden, mit anschließender Signierstunde."
    ],
    "en": [
      "Sandrine Rousseau will talk about her new book published by La Meute: \"Tu nuis à la cause\", in the Permis de déconstruire collection.\r\n\r\nA feminist encounter on the injunctions imposed on women in militant circles, followed by a book signing."
    ],
    "it": [
      "Sandrine Rousseau parlerà del suo nuovo libro, pubblicato da La Meute: \"Tu nuis à la cause\", nella collana Permis de déconstruire.\r\n\r\nUn incontro femminista sulle ingiunzioni imposte alle donne nei circoli militanti, seguito dalla firma del libro."
    ],
    "fr": [
      "Sandrine Rousseau viendra nous parler de son nouveau livre aux éditions La Meute : \"Tu nuis à la cause\" dans la collection Permis de déconstruire. \r\n\r\nUne rencontre féministe sur les injonctions faites aux femmes en milieu militant, suivie d'une dédicace."
    ],
    "nl": [
      "Sandrine Rousseau zal aanwezig zijn om te praten over haar nieuwe boek, gepubliceerd door La Meute: \"Tu nuis à la cause\", in de Permis de déconstruire collectie.\r\n\r\nEen feministische ontmoeting over de voorschriften die aan vrouwen worden opgelegd in militante kringen, gevolgd door een signeersessie."
    ],
    "es": [
      "Sandrine Rousseau nos hablará de su nuevo libro, publicado por La Meute: \"Tu nuis à la cause\", de la colección Permis de déconstruire.\r\n\r\nUn encuentro feminista sobre los mandatos impuestos a las mujeres en los círculos militantes, seguido de una firma de libros."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre avec Sandrine Rousseau"
    ]
  },
