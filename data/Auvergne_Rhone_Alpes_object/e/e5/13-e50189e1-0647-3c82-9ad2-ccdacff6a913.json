  "rdfs:comment": {
    "de": [
      "Die Brauerei Ninkasi liegt wenige Minuten vom historischen Zentrum der Stadt Vienne entfernt. Probieren Sie die ausgewählten, in Lyon produzierten Ninkasi-Biere und dazu die schmackhaften Burger oder anderen Gerichte aus frischen Produkten."
    ],
    "en": [
      "The new Ninkasi is the place to go in the Vienne area. Beer, burgers and music at any time of day. Dishes are made with fresh ingredients, right before serving. Brunch on Saturdays, Sundays and public holidays."
    ],
    "it": [
      "A pochi minuti dal centro di Vienne, il Ninkasi è un birrificio nel cuore della zona. Assaggiate la selezione di birre Ninkasi prodotte a Lione e accompagnatele con gustosi hamburger e altri piatti a base di prodotti freschi."
    ],
    "fr": [
      "A quelques minutes du centre-ville de Vienne, le Ninkasi est un lieu de brassage au cœur du territoire. Dégustez la sélection de bières Ninkasi fabriquées à Lyon et accompagnez-les de savoureux burgers et autres plats fabriqués à base de produits frais."
    ],
    "nl": [
      "Op enkele minuten van het centrum van Vienne ligt de Ninkasi, een brouwerij in het hart van de streek. Proef de selectie Ninkasi-bieren die in Lyon worden gemaakt en begeleid ze met smakelijke hamburgers en andere gerechten op basis van verse producten."
    ],
    "es": [
      "A pocos minutos del centro de Vienne, el Ninkasi es una cervecería en el corazón de la zona. Disfrute de una selección de cervezas Ninkasi fabricadas en Lyon y acompáñelas de sabrosas hamburguesas y otros platos elaborados con productos frescos."
    ]
  },
