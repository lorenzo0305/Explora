  "rdfs:comment": {
    "de": [
      "Die Nayade kehrt am 19. April 2026 mit neuen Mountainbike-, ATVTAE- und Wanderstrecken nach St Jean de Nay zurück. Abfahrten ab 7 Uhr, Verpflegungsstellen, Duschen, Fahrradwäsche und ein Aligot?-Wurst-Essen, das allen offen steht, sorgen für einen sportlichen und geselligen Tag."
    ],
    "en": [
      "La Nayade returns to St Jean de Nay on April 19, 2026 with new mountain bike, ATV and pedestrian routes. Departures from 7am, refreshments, showers, bike wash and aligot-sausage meal open to all for a sporting and convivial day."
    ],
    "it": [
      "La Nayade torna a St Jean de Nay il 19 aprile 2026 con nuovi percorsi per mountain bike, ATV e passeggiate. Partenza dalle 7 del mattino, ristoro, docce, lavaggio delle biciclette e pasto a base di salsicce aperte a tutti per una giornata di sport in amicizia."
    ],
    "fr": [
      "La Nayade revient à St Jean de Nay le 19 avril 2026 avec de nouveaux parcours VTT, VTTAE et pédestres. Départs dès 7h, ravitaillements, douches, lavage vélo et repas aligot‑saucisse ouverts à tous pour une journée sportive et conviviale."
    ],
    "es": [
      "La Nayade vuelve a St Jean de Nay el 19 de abril de 2026 con nuevos recorridos en bicicleta de montaña, quad y a pie. Salidas a partir de las 7 de la mañana, refrescos, duchas, lavado de bicicletas y comida a base de aligot y salchichas."
    ],
    "nl": [
      "De Nayade keert terug naar St Jean de Nay op 19 april 2026 met nieuwe mountainbike-, ATV- en wandelroutes. Vertrek vanaf 7 uur, verfrissingen, douches, fiets wassen en een aligot-worstmaaltijd voor iedereen voor een sportieve dag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Nayade : journée sportive à Saint-Jean-de-Nay"
    ]
  },
