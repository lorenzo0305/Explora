  "rdfs:comment": {
    "de": [
      "Ich stelle meine Stücke im Atelier aus, der Ausstellungsraum Verkauf ist das ganze Jahr über geöffnet. Seit 2003 bin ich Mitglied der Maison des Artistes."
    ],
    "en": [
      "I show my work in my studio, and the exhibition and sales area is open all year round. I have been affiliated to the Maison des Artistes since 2003."
    ],
    "it": [
      "Presento i miei pezzi in studio, l'area espositiva e di vendita è aperta tutto l'anno. Sono affiliato alla Maison des Artistes dal 2003."
    ],
    "fr": [
      "Je présente mes pièces à l'atelier, l'espace d'exposition vente est ouvert toute l'année. Je suis affilié à la Maison des Artistes depuis 2003."
    ],
    "es": [
      "Presento mis piezas en el estudio, la zona de exposición y venta está abierta todo el año. Estoy afiliado a la Maison des Artistes desde 2003."
    ],
    "nl": [
      "Ik toon mijn werk in mijn atelier en de tentoonstellings- en verkoopruimte is het hele jaar door geopend. Sinds 2003 ben ik aangesloten bij het Maison des Artistes."
    ]
  },
