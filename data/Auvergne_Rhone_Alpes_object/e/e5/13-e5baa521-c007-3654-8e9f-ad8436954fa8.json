  "rdfs:comment": {
    "de": [
      "Vermietung von Eseln, die das Gepäck tragen, für einen Aufenthalt in den Bergen im Rhythmus der Schritte des Tieres bei der Entdeckung des Vénéon-Tals."
    ],
    "en": [
      "Hire a donkey to carry your luggage, and enjoy a mountain holiday at the animal's pace, discovering the Vénéon valley."
    ],
    "it": [
      "Noleggiate un asino per trasportare i vostri bagagli per un soggiorno in montagna al ritmo dei passi dell'animale per scoprire la valle del Vénéon."
    ],
    "fr": [
      "Location d'ânes bâtés portant les bagages, pour un séjour en montagne au rythme des pas de l'animal à la découverte de la vallée du Vénéon."
    ],
    "nl": [
      "Huur een pakezel om je bagage te dragen en geniet van een vakantie in de bergen op het ritme van de voetstappen van het dier terwijl je de vallei van de Vénéon ontdekt."
    ],
    "es": [
      "Alquile un burro para llevar su equipaje durante una estancia en la montaña al ritmo de los pasos del animal para descubrir el valle del Vénéon."
    ]
  },
