  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9bacbf01-9f5e-373e-abc8-16eaf766266b",
      "dc:description": {
        "de": [
          "Hinter der von großen, flämisch anmutenden Glasscheiben gesäumten Fassade begrüßen wir Sie mit alten Rock-, Soul- und Jazzklängen, in einem gedämpften und warmen Rahmen aus Holz, Backstein und guten Vibes."
        ],
        "en": [
          "Behind a facade lined with large, Flemish-style windows, we welcome you with a background of old rock, soul and jazz, in a cosy, warm setting of wood, brick and good vibes."
        ],
        "it": [
          "Dietro la facciata rivestita di grandi finestre in stile fiammingo, vi accogliamo con un sottofondo di vecchio rock, soul e jazz, in un ambiente accogliente e caldo di legno, mattoni e buone vibrazioni."
        ],
        "fr": [
          "Derrière la façade bordée de grandes vitres aux allures flamandes, nous vous accueillons sous fond de vieux rock, soul et jazz, dans un cadre feutré et chaleureux, de bois, de brique et de bonnes vibes."
        ],
        "es": [
          "Detrás de la fachada revestida de grandes ventanales de estilo flamenco, le damos la bienvenida con un fondo de rock, soul y jazz antiguos, en un ambiente acogedor y cálido de madera, ladrillo y buenas vibraciones."
        ],
        "nl": [
          "Achter de gevel met grote ramen in Vlaamse stijl verwelkomen we je op een achtergrond van oude rock, soul en jazz, in een gezellige, warme omgeving van hout, baksteen en goede vibes."
        ]
      },
      "@type": [
        "Description"
      ],
