  "rdfs:comment": {
    "de": [
      "Mit seinem Garten, seinem Restaurant, seinem WLAN-Zugang oder auch seinen klimatisierten Zimmern werden Sie vom Komfort des Hotels, seiner guten Erreichbarkeit und der Nähe zu Grenoble begeistert sein."
    ],
    "en": [
      "With its garden, restaurant, WiFi access and air-conditioned rooms, you'll love the hotel's comfort, easy access and proximity to Grenoble."
    ],
    "it": [
      "Con il suo giardino, il suo ristorante, il suo accesso wifi o le sue camere climatizzate Lei sarà sedotto dal comfort dell'hotel, dalle sue facilità di accesso e dalla vicinanza a Grenoble."
    ],
    "fr": [
      "Avec son jardin, son restaurant, son accès wifi ou bien ses chambres climatisées vous serez séduits par le confort de l'hôtel, ses facilités d'accès et la proximité de Grenoble."
    ],
    "nl": [
      "Met zijn tuin, restaurant, Wi-Fi-toegang en kamers met airconditioning zult u verleid worden door het comfort van het hotel, de gemakkelijke toegang en de nabijheid van Grenoble."
    ],
    "es": [
      "Con su jardín, restaurante, acceso Wi-Fi y habitaciones con aire acondicionado, le encantará la comodidad del hotel, su fácil acceso y su proximidad a Grenoble."
    ]
  },
