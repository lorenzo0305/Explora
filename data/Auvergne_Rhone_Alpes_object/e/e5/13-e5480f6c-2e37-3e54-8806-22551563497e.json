  "rdfs:comment": {
    "de": [
      "Man muss nicht lange suchen, um den Ton von CACTUS zu verstehen! Mit diesem Namen für seine neue Show kündigt Elie Semoun die Farbe an: Es wird stechen!"
    ],
    "en": [
      "You don't have to look far to understand the tone of CACTUS! By naming his new show CACTUS, Elie Semoun sets the tone: it's going to sting!"
    ],
    "it": [
      "Non c'è bisogno di guardare lontano per capire il tono di CACTUS! Dando questo nome al suo nuovo spettacolo, Elie Semoun ne stabilisce il tono: sarà pungente!"
    ],
    "fr": [
      "Inutile de chercher bien loin pour comprendre le ton de CACTUS ! En donnant ce nom à son nouveau spectacle, Elie Semoun annonce la couleur : ça va piquer !"
    ],
    "es": [
      "No hay que ir muy lejos para entender el tono de CACTUS Al dar este nombre a su nuevo espectáculo, Elie Semoun está marcando la pauta: ¡va a escocer!"
    ],
    "nl": [
      "Je hoeft niet ver te zoeken om de toon van CACTUS te begrijpen! Door zijn nieuwe show deze naam te geven, zet Elie Semoun de toon: het gaat steken!"
    ]
  },
