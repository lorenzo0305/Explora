  "rdfs:comment": {
    "de": [
      "Le Lichou bietet Ihnen einen geräumigen, klimatisierten Saal sowie einen Raum mit 80 Plätzen, der sich ideal für Bankette, Hochzeiten, Gruppen oder Geburtstage eignet. Traditionelle Küche mit regionalen Gerichten, die vollständig hausgemacht sind."
    ],
    "en": [
      "Le Lichou offers a spacious, air-conditioned dining room, as well as an 80-cover room, ideal for banquets, weddings, groups or birthdays. Traditional, home-cooked regional cuisine."
    ],
    "it": [
      "Le Lichou offre una spaziosa sala da pranzo climatizzata e una sala da 80 coperti, ideale per banchetti, matrimoni, gruppi o compleanni. Cucina regionale tradizionale e casalinga."
    ],
    "fr": [
      "Le Lichou vous propose une salle spacieuse et climatisée, ainsi qu'une salle de 80 couverts, idéal pour les banquets, mariages, groupes ou anniversaires. Cuisine traditionnelle de plats régionaux entièrement cuisinés maison."
    ],
    "es": [
      "Le Lichou ofrece un amplio comedor climatizado, así como un comedor de 80 cubiertos, ideal para banquetes, bodas, grupos o cumpleaños. Cocina regional tradicional y casera."
    ],
    "nl": [
      "Le Lichou biedt een ruime eetzaal met airconditioning en een eetzaal met 80 couverts, ideaal voor banketten, bruiloften, groepen of verjaardagen. Traditionele, huisgemaakte regionale keuken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Lichou"
    ]
  },
