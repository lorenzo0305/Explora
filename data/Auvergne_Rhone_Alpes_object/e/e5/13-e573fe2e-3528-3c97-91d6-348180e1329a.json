  "rdfs:comment": {
    "de": [
      "Physioski bietet Massagen und Osteopathie an, die von diplomierten Masseuren, Physiotherapeuten und Osteopathen in den Spas seiner Partnerhotels durchgeführt werden: Castillan und Pierre et vacances les bergers."
    ],
    "en": [
      "Physioski offers massages and osteopathy by qualified masseur-physiotherapists and osteopaths in the Spas of its partner hotels: Castillan and Pierre et Vacances les bergers."
    ],
    "it": [
      "Physioski offre massaggi e osteopatia da parte di massaggiatori-fisioterapisti e osteopati qualificati nelle Spa dei suoi hotel partner: Castillan e Pierre et Vacances les bergers."
    ],
    "fr": [
      "Physioski propose des massages et de l'ostéopathie réalisés par des masseurs-kinésithérapeutes et ostéopathes diplômés dans les Spas de ses hôtels partenaires : Castillan et Pierre et vacances les bergers."
    ],
    "es": [
      "Physioski ofrece masajes y osteopatía a cargo de masajistas-fisioterapeutas y osteópatas cualificados en los Spas de sus hoteles asociados: Castillan y Pierre et Vacances les bergers."
    ],
    "nl": [
      "Physioski biedt massages en osteopathie door gekwalificeerde masseur-fysiotherapeuten en osteopaten in de spa's van de partnerhotels: Castillan en Pierre et Vacances les bergers."
    ]
