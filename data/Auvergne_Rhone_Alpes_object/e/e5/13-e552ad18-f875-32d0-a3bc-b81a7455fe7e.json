  "rdfs:comment": {
    "de": [
      "Im Herzen der Region Trièves liegt Le Poulailler, ein Theater, das so winzig wie eine Libelle ist und auf seinem Rücken die Menschen von hier mit Aufführungen von dort mitreisen lässt. Besuchen Sie das Theater und seine Kostümwerkstatt und sehen Sie sich anschließend die Aufführungen von Donnerstag- bis Samstagabend an."
    ],
    "en": [
      "In the heart of the Trièves, Le Poulailler, a theatre as tiny as a dragonfly, takes local people on a journey on its back with shows from all over. Visit the theatre and its costume workshop, then take in a show Thursday to Saturday evenings."
    ],
    "it": [
      "Nel cuore delle Trièves, Le Poulailler, un teatro piccolo come una libellula, fa viaggiare gli abitanti del luogo con spettacoli provenienti da tutto il mondo. Visitate il teatro e il suo laboratorio di costumi e poi assistete allo spettacolo dal giovedì al sabato sera."
    ],
    "fr": [
      "Au cœur du Trièves Le Poulailler, théâtre aussi minuscule qu'une libellule, fait voyager sur son dos les gens d'ici avec des spectacles venus de là-bas. Visitez le théâtre et son atelier costume et ensuite assister au spectacle du jeudi au samedi soirs."
    ],
    "nl": [
      "In het hart van de Trièves neemt Le Poulailler, een theater zo klein als een libel, de lokale bevolking mee op reis met voorstellingen uit de hele wereld. Bezoek het theater en het kostuumatelier en ga vervolgens van donderdag- tot zaterdagavond naar de voorstelling."
    ],
    "es": [
      "En el corazón de las Trièves, Le Poulailler, un teatro tan pequeño como una libélula, lleva a los habitantes de la zona de viaje en su espalda con espectáculos de todo el mundo. Visite el teatro y su taller de vestuario y asista al espectáculo de jueves a sábado por la noche."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Poulailler: theater and costume design"
    ],
    "fr": [
      "Le Poulailler : théâtre et costumerie"
    ]
  },
