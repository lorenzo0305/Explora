  "rdfs:comment": {
    "de": [
      "Im Parc Pignal können Sie im Schatten der großen Bäume auf einem schattigen Weg joggen gehen. Der Park verfügt über einen Spielplatz für Kleinkinder, einen Bouleplatz, Mülleimer und einen Parkplatz in der Nähe."
    ],
    "en": [
      "At Parc Pignal, in the shade of the tall trees, a shady path allows you to go for a jog. The park is equipped with a playground for toddlers, a pétanque court, litter garbage cans and nearby parking."
    ],
    "it": [
      "Nel Parc Pignal, all'ombra degli alberi ad alto fusto, si trova un sentiero ombreggiato dove è possibile fare jogging. Il parco dispone di un'area giochi per i più piccoli, un'area per le bocce, cestini per i rifiuti e un parcheggio nelle vicinanze."
    ],
    "fr": [
      "Au Parc Pignal, à l’ombre des grands arbres, un chemin ombragé permet de faire un petit footing. Le parc est équipé d'une aire de jeux pour les tout-petits, d'un terrain de pétanque, de poubelles et d’un parking à proximité."
    ],
    "nl": [
      "In Parc Pignal, in de schaduw van de hoge bomen, is een schaduwrijk pad waar je kunt joggen. Het park heeft een speeltuin voor peuters, een petanqueterrein, afvalbakken en een nabijgelegen parkeerplaats."
    ],
    "es": [
      "En el Parc Pignal, a la sombra de los altos árboles, hay un sendero sombreado donde se puede hacer footing. El parque cuenta con una zona de juegos para niños pequeños, una zona de petanca, papeleras y un aparcamiento cercano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc Pignal"
    ]
  },
