  "rdfs:comment": {
    "de": [
      "Ein echter Nachbarschaftstreff, ein Treffpunkt für Stammgäste, wo Neuankömmlinge willkommen sind, um diese Atmosphäre, die reich an Begegnungen ist, zu nähren."
    ],
    "en": [
      "A real neighborhood meeting, a landmark of regulars where newcomers are welcome, to feed this atmosphere rich in meetings."
    ],
    "it": [
      "Un vero e proprio luogo di incontro di quartiere, un luogo per gli habitué dove i nuovi arrivati sono i benvenuti, per alimentare questa atmosfera ricca di incontri."
    ],
    "fr": [
      "Un vrai rendez-vous de quartier, un repère d'habitués où les nouveaux venus sont les bienvenus, pour nourrir cette atmosphère riche en rencontres."
    ],
    "es": [
      "Es un auténtico lugar de encuentro vecinal, un lugar habitual donde los recién llegados son bienvenidos y que alimenta una atmósfera rica en encuentros."
    ],
    "nl": [
      "Een echte buurtontmoetingsplaats, een plek voor stamgasten waar nieuwkomers welkom zijn, om deze sfeer rijk aan ontmoetingen te voeden."
    ]
  },
