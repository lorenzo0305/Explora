  "rdfs:comment": {
    "de": [
      "Almhütte auf dem Gebiet von Arc 2000. Bergküche aus dem Holzofen.\r\nMit Skiern und zu Fuß mit einem 10-minütigen Spaziergang erreichbar.\r\nJeden Mittag und am Mittwoch- und Donnerstagabend geöffnet."
    ],
    "en": [
      "Alpine chalet on the Arc 2000 ski area. Wood-fired mountain cooking.\r\nAccessible by ski and on foot (10-minute walk).\r\nOpen for lunch every day and on Wednesday and Thursday evenings."
    ],
    "it": [
      "Chalet alpino nel comprensorio sciistico Arc 2000. Cucina di montagna con forno a legna.\r\nRaggiungibile con gli sci e a piedi con una passeggiata di 10 minuti.\r\nAperto a pranzo tutti i giorni e il mercoledì e giovedì sera."
    ],
    "fr": [
      "Chalet d'alpage sur le domaine d'Arc 2000. Cuisine montagnarde au four à bois.\r\nAccessible en ski et à pied avec une marche de 10mn.\r\nOuvert tous les midi et le mercredi et jeudi soir."
    ],
    "es": [
      "Chalet alpino en el dominio esquiable Arc 2000. Cocina de montaña en horno de leña.\r\nAccesible en esquí y a pie con un paseo de 10 minutos.\r\nAbierto para comer todos los días y los miércoles y jueves por la noche."
    ],
    "nl": [
      "Alpenchalet in het skigebied Arc 2000. Koken in de bergen in een houtoven.\r\nBereikbaar per ski en te voet met een wandeling van 10 minuten.\r\nDagelijks geopend voor lunch en op woensdag- en donderdagavond."
    ]
  },
