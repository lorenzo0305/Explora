  "rdfs:comment": {
    "de": [
      "Genießen Sie ein Mittagsmenü für 38 € und lassen Sie sich abends mit köstlichen Pizzen verwöhnen. Authentische, traditionelle Küche aus dem Holzofen. Ein Muss für Feinschmecker."
    ],
    "en": [
      "Enjoy a €38 lunch menu, then treat yourself to delicious pizzas in the evening. Authentic traditional cuisine cooked in a wood-fired oven. A must-visit for food lovers."
    ],
    "it": [
      "Gustate un menu per il pranzo a 38€, poi lasciatevi tentare la sera da deliziose pizze. Autentica cucina tradizionale cotta a legna. Un indirizzo gastronomico da non perdere."
    ],
    "fr": [
      "Savourez un menu déjeuner à 38€, puis laissez-vous tenter le soir par de délicieuses pizzas. Une cuisine traditionnelle authentique cuite au feu de bois. Une adresse gourmande incontournable."
    ],
    "nl": [
      "Geniet van een lunchmenu voor €38 en trakteer uzelf 's avonds op heerlijke pizza's. Authentieke, traditionele gerechten bereid in een houtgestookte oven. Een absolute aanrader voor fijnproevers."
    ],
    "es": [
      "Disfrute de un menú de mediodía por 38? y, por la noche, déjese tentar por deliciosas pizzas. Auténtica cocina tradicional cocinada al fuego de leña. Una dirección gastronómica que no debe perderse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Pizzeria Vigna - Hôtel Restaurant Garenne"
    ]
  },
