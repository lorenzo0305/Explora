  "rdfs:comment": {
    "de": [
      "Ein Tanzspektakel, das mit einem Dutzend Amateurtänzerinnen und -tänzern ab 60 Jahren unter der Anleitung der Choreografin Brigitte Burdin, Mitbegründerin der Compagnie Transe Express, kreiert wurde.\r\nIn Partnerschaft mit der FOL, im Rahmen von Danse au Fil d'Avril."
    ],
    "en": [
      "A dance show created with a dozen amateur dancers aged 60 and over, guided by choreographer Brigitte Burdin, co-founder of Compagnie Transe Express.\r\nIn partnership with the FOL, as part of Danse au Fil d?Avril."
    ],
    "it": [
      "Uno spettacolo di danza creato con una dozzina di ballerini dilettanti dai 60 anni in su, guidati dalla coreografa Brigitte Burdin, cofondatrice della Compagnie Transe Express.\r\nIn collaborazione con il FOL, nell'ambito di Danse au Fil d'Avril."
    ],
    "fr": [
      "Un spectacle dansé créé avec une douzaine de danseuses et danseurs amateurs de 60 ans et plus, guidés par la chorégraphe Brigitte Burdin, co-fondatrice de la Compagnie Transe Express.\r\nEn partenariat avec la FOL, dans le cadre de Danse au Fil d’Avril."
    ],
    "es": [
      "Espectáculo de danza creado con una docena de bailarines aficionados mayores de 60 años, guiados por la coreógrafa Brigitte Burdin, cofundadora de la Compagnie Transe Express.\r\nEn colaboración con la FOL, en el marco de Danse au Fil d'Avril."
    ],
    "nl": [
      "Een dansvoorstelling met een dozijn amateurdansers van 60 jaar en ouder, begeleid door choreografe Brigitte Burdin, medeoprichtster van Compagnie Transe Express.\r\nIn samenwerking met de FOL, in het kader van Danse au Fil d'Avril."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Une vie, une danse - Danse au Fil d'Avril"
    ]
  },
