  "rdfs:comment": {
    "de": [
      "Der 4er-Sessellift Petit Châtel befindet sich in Petit-Châtel, etwa 2 km vom Zentrum entfernt, und bietet Ihnen Zugang zum Barbossine-Sektor.\r\nEr ist auch für Fußgänger zugänglich."
    ],
    "en": [
      "Located at Petit-Châtel about 2km from the center, the 4-seaters Petit Châtel chairlift gives you access to the area of ​​Barbossine.\r\nIt is accessible to pedestrians."
    ],
    "it": [
      "Situata a Petit-Châtel, a circa 2 km dal centro, la seggiovia quadriposto di Petit Châtel permette di accedere al settore di Barbossine.\r\nÈ accessibile ai pedoni."
    ],
    "fr": [
      "Situé au Petit-Châtel à environ 2km du centre, le télésiège 4 places du Petit Châtel vous donne accès au secteur de Barbossine.\r\nIl est accessible aux piétons."
    ],
    "es": [
      "Situado en Petit-Châtel, a unos 2 km del centro, el telesilla de 4 plazas de Petit Châtel le permite acceder al sector de Barbossine.\r\nEs accesible para los peatones."
    ],
    "nl": [
      "De stoeltjeslift Petit-Châtel ligt ongeveer 2 km van het centrum. Deze 4-persoons stoeltjeslift geeft u toegang het Barbossine gebied.\r\nToegankelijk voor voetgangers."
    ]
  },
