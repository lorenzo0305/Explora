  "rdfs:comment": {
    "de": [
      "Bildhauer, aus Holz und Stein, werden eine Woche lang unter freiem Himmel zur Freude der Besucher an dem Thema \"La Drôme par monts et par vaux\" arbeiten. Mit zahlreichen Animationen während der fünf Tage."
    ],
    "en": [
      "Wood and stone sculptors will be working in the open air for a week to delight visitors on the theme of \"La Drôme par monts et par vaux\". There will be plenty of entertainment over 5 days."
    ],
    "it": [
      "Per una settimana, scultori del legno e della pietra lavoreranno all'aria aperta per incantare i visitatori sul tema \"La Drôme par monts et par vaux\". Per 5 giorni, inoltre, non mancherà l'intrattenimento."
    ],
    "fr": [
      "Des sculpteurs, sur bois et pierre, travailleront pendant une semaine en plein air pour le plaisir des visiteurs sur le thème \"La Drôme par monts et par vaux\". Avec de nombreuses animations pendant 5 jours."
    ],
    "nl": [
      "Een week lang zullen beeldhouwers in hout en steen in de open lucht werken om de bezoekers in verrukking te brengen met als thema \"La Drôme par monts et par vaux\". Er zal ook veel entertainment zijn gedurende 5 dagen."
    ],
    "es": [
      "Durante una semana, escultores de madera y piedra trabajarán al aire libre para deleitar a los visitantes con el tema \"La Drôme par monts et par vaux\". Durante 5 días, no faltarán las animaciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Symposium de sculptures - 3ème édition"
    ]
  },
