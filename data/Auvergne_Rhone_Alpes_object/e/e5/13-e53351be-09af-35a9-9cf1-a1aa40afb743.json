  "rdfs:comment": {
    "de": [
      "Verkauf von Produkten aus der Straußenfarm: Straußensteak, -filet, -braten und -sauté, aber auch Wurstwaren wie Wurst, Terrine und Straußenmagen.\r\nSie können auch Straußeneier für Ihre Omeletts reservieren."
    ],
    "en": [
      "You can buy products from the farm: ostrich steaks, fillets, roasts and sautéed ostrich meat, as well as sausages, terrines and ostrich gizzards.\r\nYou can also reserve ostrich eggs for your omelettes."
    ],
    "it": [
      "In vendita: bistecche di struzzo, filetti, arrosti e carne di struzzo saltata, oltre a salsicce, terrine e ventrigli di struzzo.\r\nÈ inoltre possibile prenotare uova di struzzo per le vostre frittate."
    ],
    "fr": [
      "Vente des produits issus de l'exploitation : pavé, filet, rôti ficelé et sauté d’autruches, mais aussi de la charcuterie avec saucisson, terrine et gésier d’autruche.\r\nIl est également possible de réserver les œufs d’autruches pour vos omelettes."
    ],
    "nl": [
      "Te koop: struisvogelsteaks, filets, braadstukken en gebakken struisvogelvlees, maar ook worstjes, terrines en struisvogelmaagjes.\r\nJe kunt ook struisvogeleieren reserveren voor je omeletten."
    ],
    "es": [
      "A la venta: filetes, asados y salteados de carne de avestruz, así como salchichas, terrinas y mollejas de avestruz.\r\nTambién puede reservar huevos de avestruz para sus tortillas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Elevage d'Autruche Le Père Louis ostrich farm"
    ],
    "fr": [
      "Élevage d'autruches du Père Louis"
    ]
  },
