  "rdfs:comment": {
    "de": [
      "Ein Pumptrack ist ein geschlossener Rundkurs, der aus mehreren aufeinanderfolgenden Buckeln und Steilkurven besteht und von Fahrrädern, Skateboards, Rollern und sogar Rollschuhen genutzt werden kann."
    ],
    "en": [
      "Pump track is a closed-loop course consisting of several consecutive bumps and banked turns, suitable for bikes, skateboards, scooters and even roller skates."
    ],
    "it": [
      "Una pump track è un percorso ad anello chiuso composto da diversi dossi consecutivi e curve a gomito che può essere utilizzato da biciclette, skateboard, scooter e persino pattini a rotelle."
    ],
    "fr": [
      "La pump track est un parcours en boucle fermée, constitué de plusieurs bosses consécutives et de virages relevés, pouvant être utilisé par les vélos, les skateboards, les trottinettes et même les patins à roulettes."
    ],
    "es": [
      "Una pista de pump track es un circuito cerrado formado por varios baches consecutivos y curvas peraltadas por el que pueden circular bicicletas, monopatines, patinetes e incluso patines de ruedas."
    ],
    "nl": [
      "Een pump track is een gesloten circuit dat bestaat uit verschillende opeenvolgende hobbels en schuine bochten die kunnen worden gebruikt door fietsen, skateboards, scooters en zelfs rolschaatsen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pump Track"
    ]
  },
