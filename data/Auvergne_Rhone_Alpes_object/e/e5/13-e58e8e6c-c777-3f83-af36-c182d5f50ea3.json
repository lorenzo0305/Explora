  "rdfs:comment": {
    "de": [
      "Die Gemeinde Hostun liegt 15 km von Romans-sur-Isère entfernt zwischen Royans und der valentinianischen Ebene. Sie zählt zwei Dörfer: Saint-Maurice, das erst vor kurzem gegründet wurde, und Saint-Martin.\r\n\r\nAnzahl der Einwohner: 1063\r\nFläche: 1 8,24 km²."
    ],
    "en": [
      "The commune of Hostun is located 15 km from Romans-sur-Isère, between the Royans and Valence plains. It comprises two villages: Saint-Maurice, a recent creation, and Saint-Martin.\r\n\r\nNumber of inhabitants: 1063\r\nSurface area: 1 8,24 km²"
    ],
    "it": [
      "Hostun si trova a 15 km da Romans-sur-Isère, tra i Royans e la pianura di Valence. Ha due villaggi: Saint-Maurice, di recente creazione, e Saint-Martin.\r\n\r\nPopolazione: 1.063\r\nSuperficie: 1 8,24 km²"
    ],
    "fr": [
      "La commune d'Hostun est située à 15 km de Romans-sur-Isère, entre le Royans et la plaine valentinoise. Elle compte deux villages : Saint-Maurice, de création récente, et Saint-Martin.\r\n\r\nNombre d'habitants : 1063\r\nSuperficie : 1 8,24 km²"
    ],
    "nl": [
      "Hostun ligt op 15 km van Romans-sur-Isère, tussen de Royans en de vlakten van Valence. Het heeft twee dorpen: Saint-Maurice, een recente creatie, en Saint-Martin.\r\n\r\nBevolking: 1.063\r\nOppervlakte: 1 8,24 km²"
    ],
    "es": [
      "Hostun está situado a 15 km de Romans-sur-Isère, entre los Royans y la llanura de Valence. Cuenta con dos pueblos: Saint-Maurice, de reciente creación, y Saint-Martin.\r\n\r\nPoblación: 1.063 habitantes\r\nSuperficie: 1 8,24 km²"
    ]
  },
