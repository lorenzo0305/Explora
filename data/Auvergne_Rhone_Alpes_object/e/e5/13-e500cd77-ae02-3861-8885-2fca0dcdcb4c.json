  "rdfs:comment": {
    "de": [
      "Sie werden in einem Hotelkomplex mit zeitgenössischer Architektur empfangen, in dem jedes Detail bedacht wurde, um Ihren Aufenthalt zu einem unvergesslichen Erlebnis zu machen. Das Hotel liegt im Herzen eines Gewerbegebiets, aber in der Nähe der Natur, 3 Minuten vom Stadtzentrum entfernt."
    ],
    "en": [
      "You'll be welcomed into a hotel complex with contemporary architecture, where every detail has been thought of to make your stay an unforgettable one. Located in the heart of a business park, yet close to nature, just 3 minutes from the town center."
    ],
    "it": [
      "Sarete accolti in un complesso alberghiero dall'architettura contemporanea, dove ogni dettaglio è stato pensato per rendere il vostro soggiorno indimenticabile. Situato nel cuore di un parco commerciale, ma vicino alla natura, a soli 3 minuti dal centro città."
    ],
    "fr": [
      "Vous serez accueillis dans un complexe hôtelier à l'architecture contemporaine, où chaque détail a été pensé pour faire de votre séjour un moment inoubliable. Situé au cœur d'une zone d'activité, mais proche de la nature, à 3 min du centre ville."
    ],
    "es": [
      "Le daremos la bienvenida a un complejo hotelero de arquitectura contemporánea, donde se ha pensado en cada detalle para que su estancia sea inolvidable. Situado en el corazón de un parque empresarial, pero cerca de la naturaleza, a sólo 3 minutos del centro de la ciudad."
    ],
    "nl": [
      "Je wordt verwelkomd in een hotelcomplex met eigentijdse architectuur, waar aan elk detail is gedacht om je verblijf onvergetelijk te maken. Gelegen in het hart van een bedrijvenpark, maar toch dicht bij de natuur, op slechts 3 minuten van het stadscentrum."
    ]
  },
  "rdfs:label": {
