  "rdfs:comment": {
    "de": [
      "Der Île-Parc Girodet wurde für die Einwohner von Bourg-lès-Valence geschaffen: ein 12 Hektar großes Gebiet, das der Entspannung gewidmet ist, mit Bäumen verschiedenster Arten bepflanzt ist, eine echte grüne Lunge darstellt und als Refugium der Biodiversität von Bourg-lès-Valence eingestuft wurde."
    ],
    "en": [
      "The Île-Parc Girodet was created for the inhabitants of Bourg-lès-Valence: a 12-hectare space dedicated to relaxation, planted with trees of many species, a real green lung, classified as a biodiversity refuge for Bourg-lès-Valence."
    ],
    "it": [
      "L'Île-Parc Girodet è stata creata per gli abitanti di Bourg-lès-Valence: un'area di 12 ettari dedicata al relax, piantumata con una vasta gamma di specie arboree, un vero e proprio polmone verde, classificato come rifugio della biodiversità di Bourg-lès-Valence."
    ],
    "fr": [
      "L’Île-Parc Girodet a été créé pour les bourcains : un espace de 12 hectares dédié à la détente, planté d’arbres aux essences multiples, véritable poumon vert, classé refuge de biodiversité de Bourg-lès-Valence."
    ],
    "nl": [
      "Het Île-Parc Girodet werd aangelegd voor de inwoners van Bourg-lès-Valence: een 12 hectare groot gebied gewijd aan ontspanning, beplant met bomen van vele soorten, een echte groene long, geklasseerd als toevluchtsoord voor de biodiversiteit in Bourg-lès-Valence."
    ],
    "es": [
      "El Île-Parc Girodet fue creado para los habitantes de Bourg-lès-Valence: un espacio de 12 hectáreas dedicado al descanso, plantado con una amplia gama de especies arbóreas, un verdadero pulmón verde, clasificado como refugio de biodiversidad para Bourg-lès-Valence."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ile-Parc Girodet"
    ]
  },
