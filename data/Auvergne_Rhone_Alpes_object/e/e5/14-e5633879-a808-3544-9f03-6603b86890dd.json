  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich im Herzen von Arras, nur wenige Schritte von der Grande Place entfernt.\nDas Restaurant verfügt über einen großen, klimatisierten Saal mit 120 Plätzen."
    ],
    "en": [
      "Located in the heart of Arras, a few steps from the Grande Place.\nThe Restaurant has a large air-conditioned dining room with 120 seats."
    ],
    "it": [
      "Situato nel cuore di Arras, a pochi passi dalla Grande Place.\nIl ristorante dispone di un'ampia sala da pranzo climatizzata con 120 coperti."
    ],
    "fr": [
      "Situé au cœur d'Arras, à quelques pas de la Grande Place. \nLe Restaurant possède une grande salle climatisée avec 120 couverts."
    ],
    "es": [
