  "rdfs:comment": {
    "de": [
      "Ausritte , Kurse für Erwachsene und Kinder/Jugendliche und eine Unterkunft in einer Jurte mit eigenem Jacuzzi. In einem ruhigen Weiler mit einem Schloss aus dem 14. Jahrhundert empfangen Sie Sylvie und ihr Team im Herzen des PNR der Monts d'Ardèche."
    ],
    "en": [
      "Horseback or carriage rides, workshops, and a yurt accommodation with a private hot tub. In a peaceful hamlet with a 14th-century castle, Sylvie and her team welcome you to the heart of the Monts d'Ardèche Regional Nature Park."
    ],
    "it": [
      "Equitazione, corsi per adulti e bambini/adolescenti e una yurta con jacuzzi privata. In un borgo tranquillo con un castello del XIV secolo, Sylvie e il suo team vi accolgono nel cuore del Parco Naturale Regionale dei Monts d'Ardèche."
    ],
    "fr": [
      "Des promenades à cheval , stages adultes et enfants/ados, et un gîte en yourte avec jacuzzi privé. Dans un hameau tranquille avec un château du 14e siècle, Sylvie et son équipe vous accueillent au cœur du PNR des Monts d'Ardèche."
    ],
    "es": [
      "Paseos a caballo, cursos para adultos y niños/adolescentes, y una casa rural yurta con jacuzzi privado. En una tranquila aldea con un castillo del siglo XIV, Sylvie y su equipo le dan la bienvenida al corazón del Parque Natural Regional de los Montes de Ardèche."
    ],
    "nl": [
      "Paardrijden of met een koets, cursussen, en een vakantieverblijf in een yurt met een privé jacuzzi. In een rustig gehucht met een 14e-eeuws kasteel verwelkomen Sylvie en haar team je in het hart van het regionaal natuurpark Monts d'Ardèche."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Vergier Equestrian Centre"
    ],
    "fr": [
      "Centre équestre Le Vergier"
    ],
    "nl": [
      "Het ruitersportcentrum van Vergier"
    ]
  },
