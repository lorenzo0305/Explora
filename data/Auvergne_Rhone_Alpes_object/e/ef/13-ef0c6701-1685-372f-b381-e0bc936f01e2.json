  "rdfs:comment": {
    "de": [
      "Vor fünf Jahren kauften Aurélie und ihre Familie das Château de la Bouchatte, um es zu neuem Leben zu erwecken. Heute sind 900 m² auf einem 16 ha großen Anwesen renoviert."
    ],
    "en": [
      "5 years ago, Aurélie and her family bought Château de la Bouchatte and brought it back to life. Today, 900 m² have been renovated on a 16-hectare estate."
    ],
    "it": [
      "5 anni fa, Aurélie e la sua famiglia hanno acquistato Château de la Bouchatte e lo hanno riportato in vita. Oggi sono stati ristrutturati 900 m² su una tenuta di 16 ettari."
    ],
    "fr": [
      "Il y a 5 ans, Aurélie et sa famille ont racheté le Château de la Bouchatte pour lui redonner vie. Aujourd’hui, 900 m² sont rénovés sur un domaine de 16 ha."
    ],
    "es": [
      "Hace 5 años, Aurélie y su familia compraron el Château de la Bouchatte y le devolvieron la vida. Hoy en día, se han renovado 900 m² en una finca de 16 hectáreas."
    ],
    "nl": [
      "5 jaar geleden kochten Aurélie en haar familie Château de la Bouchatte en brachten het weer tot leven. Vandaag de dag is er 900 m² gerenoveerd op een landgoed van 16 hectare."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fête à La Bouchatte"
    ]
  },
