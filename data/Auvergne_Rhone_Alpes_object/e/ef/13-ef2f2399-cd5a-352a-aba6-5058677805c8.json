  "rdfs:comment": {
    "de": [
      "Boutique de Créateurs made in France\r\n5 Créatrices Drômoises und Ardéchois begrüssen Sie in ihrem brandneuen Laden im Stadtzentrum Montélimar."
    ],
    "en": [
      "Designer shop made in France\r\n5 Drômoises and Ardéchoises designers welcome you to their brand new boutique in the centre of Montélimar."
    ],
    "it": [
      "Boutique de Créateurs Made in France. 5 artigiane locali vi accolgono per farvi scoprire il loro mondo e il lavoro di una trentina di altre. Designer accuratamente selezionati da tutta la Francia."
    ],
    "fr": [
      "Boutique de Créateurs Made in France. 5 Artisanes locales vous accueillent pour vous faire découvrir leurs univers ainsi que le travail d’une trentaine d’autres. Créateurs de toute la France sélectionnés avec soin."
    ],
    "nl": [
      "Designerwinkel gemaakt in Frankrijk\r\n5 de ontwerpers van Drômoises en Ardéchoises heten u welkom in hun gloednieuwe boetiek in het centrum van Montélimar."
    ],
    "es": [
      "Boutique de Créateurs Made in France. 5 artesanas locales le dan la bienvenida para que descubra su mundo y el trabajo de una treintena más. Diseñadores de toda Francia cuidadosamente seleccionados."
    ]
  },
