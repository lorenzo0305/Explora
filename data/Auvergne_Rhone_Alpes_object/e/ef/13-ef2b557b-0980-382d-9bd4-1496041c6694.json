  "rdfs:comment": {
    "de": [
      "Dieser tief eingeschnittene Canyon bietet sehr schöne Sprünge (maximal 10 m), Abseilstellen und sensationelle Rutschen (10 m), wenn die Bedingungen es zulassen."
    ],
    "en": [
      "This steep-sided canyon offers spectacular jumps (maximum 10m), abseils and slides (10m), conditions permitting."
    ],
    "it": [
      "Questo canyon ripido offre alcuni salti molto belli (massimo 10 m), discese in corda doppia e scivoli sensazionali (10 m) se le condizioni lo permettono."
    ],
    "fr": [
      "Ce canyon encaissé offre de très jolis sauts (maximum 10m), des rappels et des toboggans sensationnels (10m) si les conditions le permettent."
    ],
    "es": [
      "Este escarpado cañón ofrece algunos saltos muy agradables (de un máximo de 10 metros), rápeles y sensacionales toboganes (de 10 metros) si las condiciones lo permiten."
    ],
    "nl": [
      "Deze steile canyon biedt enkele zeer mooie sprongen (maximaal 10m), abseils en sensationele glijbanen (10m) als de omstandigheden het toelaten."
    ]
  },
