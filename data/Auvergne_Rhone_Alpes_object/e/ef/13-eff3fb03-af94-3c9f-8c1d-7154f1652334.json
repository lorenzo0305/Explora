  "rdfs:comment": {
    "de": [
      "MULANE VOYAGES bietet Ihnen maßgeschneiderte oder schlüsselfertige Reisen in alle Ecken der Welt. Im Herzen der Monts du Genevois, mit MULANE CAMP, entdecken Sie unsere von Eseln begleiteten Touren mit Übernachtungen in Komfortzelten."
    ],
    "en": [
      "MULANE VOYAGES, nature and culture discoveries, offers tailor-made or turnkey trips to the four corners of the world. In the heart of the Monts du Genevois, with MULANE CAMP, discover our circuits accompanied by donkeys, with nights in comfort tents."
    ],
    "it": [
      "MULANE VOYAGES, scoperta della natura e della cultura, propone viaggi su misura o chiavi in mano ai quattro angoli del mondo. Nel cuore dei Monts du Genevois, con MULANE CAMP, scoprite i nostri circuiti accompagnati dagli asini con pernottamenti in tende comfort."
    ],
    "fr": [
      "MULANE VOYAGES découvertes nature et culture, vous propose des voyages sur mesure ou clef en mains aux quatre coins du monde . Au cœur des Monts du Genevois, avec MULANE CAMP découvrez nos circuits accompagnés d'ânes avec nuits sous tente confort."
    ],
    "nl": [
      "MULANE VOYAGES, ontdekkingsreizen in natuur en cultuur, biedt reizen op maat of kant-en-klare reizen naar de vier uithoeken van de wereld. In het hart van de Monts du Genevois, met MULANE CAMP, ontdek onze circuits begeleid door ezels met overnachtingen in comfortabele tenten."
    ],
    "es": [
      "MULANE VOYAGES, descubrimientos de naturaleza y cultura, ofrece viajes a medida o llave en mano a los cuatro rincones del mundo. En el corazón de los Monts du Genevois, con MULANE CAMP, descubra nuestros circuitos acompañados de burros con noches en tiendas de campaña confort."
    ]
  },
