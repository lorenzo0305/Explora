  "rdfs:comment": {
    "de": [
      "Dieses Jahr nimmt uns der Karneval mit auf eine Reise, bei der die Farben die Zeit überdauern. Von der Vergangenheit in die Zukunft, von den Traditionen in die Vorstellungswelt von heute."
    ],
    "en": [
      "This year, the carnival takes us on a journey where colours transcend time. From the past to the future, from traditions to today's imaginations"
    ],
    "it": [
      "Quest'anno il Carnevale ci porta in un viaggio in cui i colori viaggiano nel tempo. Dal passato al futuro, dalla tradizione all'immaginazione di oggi."
    ],
    "fr": [
      "Cette année, le carnaval nous entraîne dans un voyage où les couleurs traversent le temps. Du passé au futur, des traditions aux imaginaires d’aujourd’hui."
    ],
    "es": [
      "Este año, el Carnaval nos lleva a un viaje en el que los colores viajan a través del tiempo. Del pasado al futuro, de la tradición a la imaginación de hoy."
    ],
    "nl": [
      "Dit jaar neemt Carnaval ons mee op een reis waarbij kleuren door de tijd reizen. Van het verleden naar de toekomst, van traditie naar de verbeelding van vandaag."
    ]
  },
