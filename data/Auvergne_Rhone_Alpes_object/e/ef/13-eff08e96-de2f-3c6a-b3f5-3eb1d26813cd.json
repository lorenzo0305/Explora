  "rdfs:comment": {
    "de": [
      "Drei Goncourt-Preise aus Nyons? und eine Parodie\r\nVortrag von Éric Dautriat, Ingenieur, ehemaliger Vizepräsident der Académie de l'air et de l'espace, und Yves Guérin, Autor, ehemaliger Präsident der UNTL. Im Rahmen der Vortragsreihe der UNTL."
    ],
    "en": [
      "Three Goncourt prizes from Nyons? and a parody\r\nLecture by Éric Dautriat, engineer, former vice-president of the Académie de l'air et de l'Espace, and Yves Guérin, author, former president of UNTL. As part of the UNTL lecture series."
    ],
    "it": [
      "Tre premi Goncourt di Nyons e una parodia\r\nConferenza di Éric Dautriat, ingegnere, ex vicepresidente dell'Académie de l'air et de l'Espace e Yves Guérin, scrittore, ex presidente dell'UNTL. Nell'ambito del ciclo di conferenze dell'UNTL."
    ],
    "fr": [
      "Trois prix Goncourt nyonsais… et une parodie\r\nConférence d'Éric Dautriat, Ingénieur, ancien vice président de l’Académie de l’air et de l’Espace et d'Yves Guérin, auteur, ex-président de l’UNTL. Dans le cadre du cycle de conférences de l'UNTL."
    ],
    "es": [
      "Tres premios Goncourt de Nyons? y una parodia\r\nConferencia de Éric Dautriat, ingeniero, antiguo vicepresidente de la Académie de l'air et de l'Espace, e Yves Guérin, escritor, antiguo presidente de la UNTL. En el marco del ciclo de conferencias de la UNTL."
    ],
    "nl": [
      "Drie Goncourt-prijzen uit Nyons en een parodie\r\nLezing door Éric Dautriat, ingenieur, voormalig vicevoorzitter van de Académie de l'air et de l'Espace en Yves Guérin, auteur, voormalig voorzitter van de UNTL. Als onderdeel van de UNTL-lezingenreeks."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence sur les Prix Goncourt nyonsais"
    ]
  },
