  "rdfs:comment": {
    "de": [
      "Alpes Equitation liegt im Herzen des Geoparks Chablais und ist ein dem französischen Verband angeschlossenes Reitzentrum mit dem Gütesiegel Equures."
    ],
    "en": [
      "Located in the heart of the Chablais Geopark, Alpes Equitation is an equestrian centre affiliated to the French Equestrian Federation, with the Equures label and a mountain equestrian tourism centre."
    ],
    "it": [
      "Situato nel cuore del Geoparco dello Chablais, Alpes Equitation è un centro di equitazione affiliato alla Federazione Equestre Francese, con il marchio Equures, un centro di turismo equestre di montagna."
    ],
    "fr": [
      "Situé au cœur du Géoparc du chablais, Alpes Equitation est un centre équestre affilié à la fédération française, labellisé Equures, un centre de tourisme équestre de montagne."
    ],
    "es": [
      "Situado en el corazón del Geoparque del Chablais, Alpes Equitation es un centro ecuestre afiliado a la Federación Hípica Francesa, con la etiqueta Equures, centro de turismo ecuestre de montaña."
    ],
    "nl": [
      "Alpes Equitation, gelegen in het hart van het Chablais Geopark, is een paardrijcentrum dat is aangesloten bij de Franse paardensportfederatie, met het label Equures, een centrum voor paardentoerisme in de bergen."
    ]
  },
