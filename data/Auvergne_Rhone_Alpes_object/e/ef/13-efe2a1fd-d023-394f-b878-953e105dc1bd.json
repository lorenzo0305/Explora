  "rdfs:comment": {
    "de": [
      "RESERVIERUNG ERFORDERLICH\r\n\r\nBeobachten Sie die Tiere der Berge, die in diesem Tierpark in magischer Umgebung auf 1500 m Höhe direkt gegenüber dem Mont-Blanc frei herumlaufen."
    ],
    "en": [
      "BOOKING REQUIERED\r\nCome and watch the mountain animals roam freely in this animal park in a magical setting, at an altitude of 1500m, just opposite Mont-Blanc."
    ],
    "it": [
      "PRENOTAZIONE OBBLIGATORIA\r\nVenite a vedere gli animali di montagna che si muovono liberamente in questo parco animali in un ambiente magico, a 1500 m di altitudine, proprio di fronte al Monte Bianco."
    ],
    "fr": [
      "RESERVATION OBLIGATOIRE\r\n\r\nVenez observer les animaux de la montagne déambuler en toute liberté dans ce parc animalier au cadre magique, à 1500m d'altitude, juste en face du Mont-Blanc."
    ],
    "es": [
      "reserva obligatoria\r\nVenga a ver a los animales de montaña campar a sus anchas en este parque de animales en un entorno mágico, a 1500 m de altitud, justo enfrente del Mont-Blanc."
    ],
    "nl": [
      "RESERVERING VERPLICHT\r\n\r\nKom kijken naar de bergdieren die vrij rondlopen in dit dierenpark in een magische omgeving, op 1500 meter hoogte, tegenover de Mont Blanc."
    ]
  },
