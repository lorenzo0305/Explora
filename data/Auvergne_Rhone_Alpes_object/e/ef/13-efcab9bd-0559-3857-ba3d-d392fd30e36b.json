  "rdfs:comment": {
    "de": [
      "Die Mediathek in Brignais ist ein freundlicher, modernisierter Ort mit einem reichen Angebot an Dienstleistungen: Ausleihe von Dokumenten, Videospiele, Gesellschaftsspiele, Lesegeräte, Veranstaltungen für alle Altersgruppen und ein digitaler Raum."
    ],
    "en": [
      "The Brignais multimedia library is a friendly, modernized facility offering a wide range of services: document borrowing, video games, board games, reading devices, events for all ages, and a digital space."
    ],
    "it": [
      "La biblioteca multimediale di Brignais è una struttura accogliente e moderna che offre un'ampia gamma di servizi: prestito di documenti, videogiochi, giochi da tavolo, materiale di lettura, eventi per tutte le età e un'area digitale."
    ],
    "fr": [
      "La médiathèque de Brignais est un lieu convivial et modernisé qui propose un riche éventail de services : emprunt de documents, jeux vidéo, jeux de société, liseuses, animations pour tous les âges, et un espace numérique."
    ],
    "es": [
      "La biblioteca multimedia Brignais es una instalación moderna y acogedora que ofrece una amplia gama de servicios: préstamo de documentos, videojuegos, juegos de mesa, material de lectura, eventos para todas las edades y un espacio digital."
    ],
    "nl": [
      "De mediatheek van Brignais is een vriendelijke, moderne faciliteit die een breed scala aan diensten biedt: het lenen van documenten, videospellen, bordspellen, leesmateriaal, evenementen voor alle leeftijden en een digitale ruimte."
    ]
  },
