  "rdfs:comment": {
    "de": [
      "Zwischen karierten Tischdecken und rustikalen Akzenten bietet unser traditionelles Restaurant eine in Cocottes servierte Schmorküche aus frischen französischen Produkten. Vintage-Ambiente von früher."
    ],
    "en": [
      "With its checkered tablecloths and rustic touches, our traditional restaurant offers simmered cuisine, served in casseroles, using fresh French produce. Vintage atmosphere."
    ],
    "it": [
      "Con le sue tovaglie a quadretti e i suoi tocchi rustici, il nostro ristorante tradizionale serve piatti a cottura lenta, in stile casseruola, preparati con prodotti freschi francesi. Atmosfera vintage."
    ],
    "fr": [
      "Entre nappes à carreaux et touches rustiques, notre restaurant traditionnel propose une cuisine mijotée, servie en cocottes, à base de produits frais et français. Ambiance vintage d’antan."
    ],
    "nl": [
      "Met zijn geruite tafelkleden en rustieke accenten serveert ons traditionele restaurant langzaam gekookte, eenpansgerechten met verse Franse producten. Vintage sfeer."
    ],
    "es": [
      "Con sus manteles de cuadros y sus toques rústicos, nuestro restaurante tradicional sirve platos a la cazuela cocinados a fuego lento y elaborados con productos frescos franceses. Ambiente vintage."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Cocottes"
    ]
  },
