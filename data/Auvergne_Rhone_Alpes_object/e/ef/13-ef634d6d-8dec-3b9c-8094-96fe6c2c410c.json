  "rdfs:comment": {
    "de": [
      "Agathe Fifatin Houeto gründet ihre Marke FIFATIN, die ein Ort des Experimentierens, des Spiels und der Raffinesse ist. Ihre Kollektionen erforschen die Welt des Schmucks und des Haarschmucks in Verbindung mit traditionellen Stücken."
    ],
    "en": [
      "Agathe Fifatin Houeto founds her brand FIFATIN, a space for experimentation, play and refinement. Her collections explore the world of jewelry and hair ornaments, alongside traditional pieces."
    ],
    "it": [
      "Agathe Fifatin Houeto ha fondato il suo marchio FIFATIN, uno spazio di sperimentazione, gioco e raffinatezza. Le sue collezioni esplorano il mondo della gioielleria e degli ornamenti per capelli, accanto a pezzi tradizionali."
    ],
    "fr": [
      "Agathe Fifatin Houeto fonde sa marque FIFATIN, espace d'expérimentation, de jeu et de raffinement. Ses collections explorent l'univers du bijou et des ornements de cheveux, conjointement aux pièces traditionnelles."
    ],
    "nl": [
      "Agathe Fifatin Houeto richtte haar merk FIFATIN op, een ruimte voor experiment, spel en verfijning. Haar collecties verkennen de wereld van sieraden en haarversieringen, naast traditionele stukken."
    ],
    "es": [
      "Agathe Fifatin Houeto fundó su marca FIFATIN, un espacio para la experimentación, el juego y el refinamiento. Sus colecciones exploran el mundo de la joyería y los adornos para el pelo, junto a piezas tradicionales."
    ]
  },
