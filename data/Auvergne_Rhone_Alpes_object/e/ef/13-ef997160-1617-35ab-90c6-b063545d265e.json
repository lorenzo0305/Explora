  "rdfs:comment": {
    "de": [
      "4 Via Ferrata in Valloire ermöglichen es, eine gewisse Beherrschung des Vakuums anzustreben. Es ist die vertikale Welt in aller Sicherheit mit Sprossen und Kabeln.\r\nValloire bietet Ihnen außerdem rund 100 Kletterrouten von 3 bis 7."
    ],
    "en": [
      "There are 4 Via Ferrata routes in Valloire to help you master the void. This is the vertical world in complete safety, with rungs and cables.\r\nValloire also offers a hundred climbing routes, from 3 to 7."
    ],
    "it": [
      "A Valloire ci sono 4 vie ferrate per aiutarvi a padroneggiare l'arte del vuoto. Si tratta di un mondo verticale in tutta sicurezza, con pioli e cavi.\r\nValloire offre anche un centinaio di vie di arrampicata, da 3 a 7."
    ],
    "fr": [
      "4 Via Ferrata à Valloire permettent d'aborder une certaine maîtrise du vide. C'est le monde vertical en toute sécurité avec échelons et câbles.\r\nValloire vous propose également une centaine de voies d'escalade du 3 au 7."
    ],
    "es": [
      "en Valloire hay 4 vías ferratas para dominar el arte del vacío. Se trata del mundo vertical con total seguridad, con peldaños y cables.\r\nValloire también ofrece un centenar de vías de escalada, de 3 a 7."
    ],
    "nl": [
      "3 Via Ferrata in Valloire laten u kennis maken met een zekere beheersing van de leegte. Een verticale wereld, in alle veiligheid met klimsporen en kabels.\r\nValloire biedt ook een honderdtal beklimmingen, van niveau 3 tot 7."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing and Via Ferrata areas"
    ],
    "it": [
      "Siti di arrampicata e di via ferrata"
    ],
    "fr": [
      "Sites d'escalade et de via ferrata"
    ],
    "nl": [
      "Klimplekken en via ferrata"
    ]
  },
