  "rdfs:comment": {
    "de": [
      "Die Pizzeria du Midi ist ein Restaurant an der Alten Brücke in Bourg de Péage. Der Chefkoch bietet Ihnen hausgemachte Holzofenpizzen, Salate und Spezialitäten (Ravioli-Gratins)."
    ],
    "en": [
      "La Pizzeria du Midi is a restaurant located near the Vieux Pont in Bourg de Péage. The chef offers homemade wood-fired pizzas, salads and specialties (ravioli gratins)."
    ],
    "it": [
      "La Pizzeria du Midi è un ristorante situato vicino al Ponte Vecchio di Bourg de Péage, lo chef offre pizze fatte in casa con fuoco a legna, insalate e specialità (ravioli gratinati)"
    ],
    "fr": [
      "La Pizzeria du Midi est un restaurant situé du coté du Vieux Pont de Bourg de Péage, le chef vous propose des pizzas fait maison au feu de bois, des salades et spécialités (gratins de ravioles)"
    ],
    "nl": [
      "La Pizzeria du Midi is een restaurant vlakbij de Vieux Pont in Bourg de Péage. De chef biedt zelfgemaakte houtovenpizza's, salades en specialiteiten (ravioli gratins)."
    ],
    "es": [
      "La Pizzeria du Midi es un restaurante situado cerca del Puente Viejo de Bourg de Péage, el chef ofrece pizzas caseras hechas sobre un fuego de leña, ensaladas y especialidades (ravioli gratins)"
    ]
  },
