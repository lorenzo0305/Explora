  "rdfs:comment": {
    "de": [
      "Dies ist ein über 200 m² großer Bereich, der den Weinen und Spirituosen gewidmet ist. Hier finden Sie Weine aus allen Regionen Frankreichs, vom Rhône-Tal über das Languedoc Roussillon bis hin zur Region Bordeaux."
    ],
    "en": [
      "Over 200 m² dedicated to wines and spirits. You'll find wines from every region of France, from the Rhône Valley to Languedoc Roussillon and Bordeaux."
    ],
    "it": [
      "Si tratta di uno spazio di oltre 200 m² dedicato ai vini e agli alcolici. Troverete vini provenienti da tutte le regioni della Francia, dalla Valle del Rodano al Languedoc Roussillon o alla regione di Bordeaux."
    ],
    "fr": [
      "C’est un espace de plus de 200 m² dédié aux vins et spiritueux. Vous trouverez sur place des vins de toutes les régions de France, de la Vallée du Rhône en passant par le Languedoc Roussillon ou la région Bordelaise."
    ],
    "es": [
      "Se trata de un espacio de más de 200 m² dedicado a los vinos y licores. Encontrará vinos de todas las regiones de Francia, desde el Valle del Ródano hasta el Languedoc Roussillon y la región de Burdeos."
    ],
    "nl": [
      "Het is een ruimte van meer dan 200 m² gewijd aan wijnen en gedistilleerde dranken. Je vindt er wijnen uit heel Frankrijk, van de Rhônevallei tot de Languedoc Roussillon en Bordeaux."
    ]
  },
  "rdfs:label": {
