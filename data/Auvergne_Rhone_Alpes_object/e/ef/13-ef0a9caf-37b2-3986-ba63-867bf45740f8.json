  "rdfs:comment": {
    "de": [
      "Das Atelier bietet das ganze Jahr über Aquarellkurse und -praktika an. Wenn Sie Lust haben, die Aquarellmalerei für ein Wellness-Erlebnis und zum Loslassen zu erkunden ... Les Douces Bulles de Cécile wird Sie zufriedenstellen."
    ],
    "en": [
      "The studio offers watercolor courses and workshops all year round. If you're tempted to come and explore watercolor for an experience of well-being and letting go... Les Douces Bulles de Cécile is sure to satisfy."
    ],
    "it": [
      "Lo studio offre corsi e workshop di acquerello tutto l'anno. Se siete tentati di venire a esplorare l'acquerello per vivere un'esperienza di benessere e lasciarsi andare... Les Douces Bulles de Cécile è sicuramente di vostro gradimento."
    ],
    "fr": [
      "L'atelier propose des cours et des stages d'aquarelle toute l'année. Si vous êtes tentée de venir explorer l'aquarelle pour une expérience bien-être et lâcher-prise ... Les Douces Bulles de Cécile sauront vous satisfaire."
    ],
    "es": [
      "El taller ofrece cursos y talleres de acuarela durante todo el año. Si le tienta venir a explorar la acuarela para vivir una experiencia de bienestar y dejarse llevar... Les Douces Bulles de Cécile le encantarán."
    ],
    "nl": [
      "De studio biedt het hele jaar door aquarelcursussen en -workshops aan. Als je in de verleiding komt om aquarel te ontdekken voor een ervaring van welzijn en loslaten ... Les Douces Bulles de Cécile zal zeker in de smaak vallen."
    ]
  },
