  "rdfs:comment": {
    "de": [
      "Diese Zeit steht allen Eltern offen, um sich auszutauschen und in ihrer Elternschaft unterstützt zu werden. Offen für alle Eltern. Organisiert von Le Forum und Zimboum und geleitet von der Kinderkrankenschwester Maud Martinerie Binet."
    ],
    "en": [
      "This time is open to all parents, to exchange ideas and receive support in parenthood. Open to all parents. Organized by Le Forum and Zimboum, and led by childcare nurse Maud Martinerie Binet."
    ],
    "it": [
      "Questo momento è aperto a tutti i genitori, per scambiare idee e ricevere sostegno nella loro genitorialità. Aperto a tutti i genitori. Organizzato da Le Forum e Zimboum e condotto dall'infermiera Maud Martinerie Binet."
    ],
    "fr": [
      "Ce temps est ouvert à tous les parents, pour échanger et être soutenu dans sa parentalité. Ouvert à tous les parents. Organisé par Le Forum et Zimboum, et animé par l'infirmière puéricultrice Maud Martinerie Binet."
    ],
    "es": [
      "Este tiempo está abierto a todos los padres, para intercambiar ideas y recibir apoyo en su crianza. Abierto a todos los padres. Organizado por Le Forum y Zimboum, y dirigido por la enfermera de guardería Maud Martinerie Binet."
    ],
    "nl": [
      "Deze tijd staat open voor alle ouders, om ideeën uit te wisselen en steun te krijgen bij het opvoeden. Open voor alle ouders. Georganiseerd door Le Forum en Zimboum, en geleid door kinderverzorgster Maud Martinerie Binet."
    ]
  },
  "rdfs:label": {
    "fr": [
