  "rdfs:comment": {
    "de": [
      "Das Little Italy Festival bietet Ihnen einen Abend lang die italienische Disco-Szene der 80er Jahre: Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, dann die neue Generation mit Petit!"
    ],
    "en": [
      "The Little Italy Festival brings you the Italian Disco scene of the 80s: Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, then the new generation with Petit!"
    ],
    "it": [
      "Per una sola notte, il Little Italy Festival vi porta la scena disco italiana degli anni '80: Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, e poi la nuova generazione con Petit!"
    ],
    "fr": [
      "Le Little Italy Festival, vous offre le temps d'un soir, la scène Disco italienne des années 80 : Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, puis la nouvelle génération avec Petit!"
    ],
    "nl": [
      "Voor slechts één nacht brengt het Little Italy Festival je de Italiaanse Disco scene van de jaren 80: Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, en dan de nieuwe generatie met Petit!"
    ],
    "es": [
      "Por una sola noche, el Little Italy Festival te trae la escena Disco italiana de los años 80: Sabrina, Den Harrow, Gazebo, Ivana Spagna, Johnson Righeira, P. Lion, Ryan Paris, Scotch, Silver Pozzoli, DJ Antoine, ¡y luego la nueva generación con Petit!"
    ]
  },
