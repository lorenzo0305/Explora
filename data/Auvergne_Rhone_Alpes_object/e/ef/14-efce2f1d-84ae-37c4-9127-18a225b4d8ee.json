      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag von 7:00 bis 13:00 Uhr und von 15:30 bis 19:30 Uhr.\nSonntags von 7:00 bis 13:00 Uhr\nWöchentliche Schließung am Dienstag\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday, 7am to 1pm and 3:30pm to 7:30pm.\nSunday from 7am to 1pm\nWeekly closing on Tuesday\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al sabato dalle 7 alle 13 e dalle 15.30 alle 19.30.\nDomenica dalle 7.00 alle 13.00\nChiuso il martedì\n\n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu lundi au samedi de 7h à 13h et de 15h30 à 19h30.\nLe dimanche de 7h à 13h\nFermeture hebdomadaire le mardi\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag van 7u tot 13u en van 15u30 tot 19u30.\nZondag van 7 tot 13 uur\nDinsdag gesloten\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 7h a 13h y de 15h30 a 19h30.\nDomingo de 7h a 13h\nMartes cerrado\n\n\n "
        ]
      },
