  "rdfs:comment": {
    "de": [
      "Sie möchten hoch hinaus, ohne Ski zu fahren? Das ist möglich! Im Skigebiet La Toussuire sind zwei Skilifte für Fußgänger geöffnet: Télésiège Tête de Bellard und die Gondelbahn Côte du Bois."
    ],
    "en": [
      "Want to get some height without skiing? It's possible! At La Toussuire, two lifts are open to pedestrians: the Tête de Bellard chairlift and the Côte du Bois gondola."
    ],
    "it": [
      "Volete ottenere un po' di altezza senza sciare? È possibile! A La Toussuire, due impianti di risalita sono aperti ai pedoni: la seggiovia Tête de Bellard e la cabinovia Côte du Bois."
    ],
    "fr": [
      "Vous souhaitez prendre de la hauteur sans skier ? C'est possible ! Sur la station de La Toussuire, deux remontées mécaniques sont ouvertes aux piétons : Télésiège Tête de Bellard et la télécabine Côte du Bois."
    ],
    "es": [
      "¿Quieres ganar altura sin esquiar? Es posible En La Toussuire, dos remontes están abiertos a los peatones: el telesilla Tête de Bellard y la telecabina Côte du Bois."
    ],
    "nl": [
      "Wil je wat hoogte zonder te skiën? Dat kan! In La Toussuire zijn twee liften toegankelijk voor voetgangers: de stoeltjeslift Tête de Bellard en de gondelbaan Côte du Bois."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pedestrian ski lifts"
    ],
    "fr": [
      "Remontées mécaniques piétonnes"
    ],
    "nl": [
      "Skiliften voor voetgangers"
    ]
  },
