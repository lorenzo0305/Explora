  "rdfs:comment": {
    "de": [
      "Familienrestaurant, Tagesmenü mittags und abends und à la carte. Verkauf zum Mitnehmen (Burger, Rösti, Tender und Salat).  Terrasse im Innenhof, schattig, je nach Wetterlage. Frische Produkte und \"hausgemachte\" Küche."
    ],
    "en": [
      "The \"resto Gourmand\" offers traditional cuisine made with fresh and regional products. Lunch, day'specials and quick formulas. In the evening, simple and refined \"à la carte\". Themed nights on Thursdays. Take away from Thursday to Saturday evening."
    ],
    "it": [
      "Ristorante a conduzione familiare, menù giornaliero per pranzo e cena e menù à la carte. Da asporto (hamburger, röstis, tender e insalata).  Terrazza ombreggiata nel cortile, tempo permettendo. Prodotti freschi e cucina casalinga."
    ],
    "fr": [
      "Restaurant familial, menu du jour midi et soir et carte. Vente à emporter (burgers, röstis, tenders et salade).  Terrasse en cour intérieure, ombragée, selon la météo. Produits frais et cuisine \"maison\"."
    ],
    "es": [
      "Restaurante familiar, menús diarios de almuerzo y cena y menú a la carta. Comida para llevar (hamburguesas, röstis, tenders y ensalada).  Terraza a la sombra en el patio, si el tiempo lo permite. Productos frescos y cocina casera."
    ],
    "nl": [
      "Familierestaurant, dagelijks lunch- en dinermenu en à la carte menu. Afhaalmaaltijden (hamburgers, röstis, tenders en salade).  Schaduwrijk terras op de binnenplaats, als het weer het toelaat. Verse producten en huisgemaakte gerechten."
    ]
  },
