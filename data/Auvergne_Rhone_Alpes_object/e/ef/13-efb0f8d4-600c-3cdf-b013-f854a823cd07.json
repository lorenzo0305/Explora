  "rdfs:comment": {
    "de": [
      "Besuchen Sie uns auf eigene Faust. Die Kirche stammt aus dem 12. Jahrhundert, aber nur zwei Joche des Kirchenschiffs, das ein spitz zulaufendes Tonnengewölbe aufweist und mit Maskenmodillons verziert ist, sind romanisch."
    ],
    "en": [
      "Free visit .The church dates from XIIth century. ISMH"
    ],
    "it": [
      "Visita gratuita. La chiesa risale al XII secolo, ma solo due campate della navata, con volta a botte spezzata e decorata da modiglioni con maschere, sono romaniche."
    ],
    "fr": [
      "Visite libre. L'église date du XIIe siècle mais seules deux travées de la nef voûtée en berceau brisé et décorée de modillons à masques, sont romanes."
    ],
    "es": [
      "Visita gratuita. La iglesia data del siglo XII, pero sólo dos tramos de la nave, con su bóveda de cañón roto y decorada con modillones con mascarones, son románicos."
    ],
    "nl": [
      "Gratis bezoek. De kerk dateert uit de 12e eeuw, maar slechts twee traveeën van het schip, met zijn gebroken tongewelf en versierd met modillions met maskers, zijn Romaans."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Jacques Church"
    ],
    "fr": [
      "Église Saint-Jacques"
    ]
  },
