  "rdfs:comment": {
    "de": [
      "Flussliebhaber Julien ist im Süden der Ardèche aufgewachsen. Er wird Sie von seiner Erfahrung vor Ort profitieren lassen. Gerne begleitet er Sie bei der Entdeckung oder Vertiefung von spielerischen und fischschonenden Angeltechniken."
    ],
    "en": [
      "A river lover, Julien grew up in the southern Ardèche. He will share with you his experience in the field. He'll be delighted to help you discover or improve your fishing techniques, which are both fun and respectful of fish."
    ],
    "it": [
      "Amante dei fiumi, Julien è cresciuto nell'Ardèche meridionale. Condividerà con voi la sua esperienza sul campo. Sarà lieto di aiutarvi a scoprire o migliorare le vostre tecniche di pesca, divertenti e rispettose dei pesci."
    ],
    "fr": [
      "Amoureux des rivières Julien a grandi en sud Ardèche. Il vous fera profiter de son expérience du terrain. Il se fera un plaisir de vous accompagner dans la découverte ou l'approfondissement de techniques de pêche ludique et respectueuse du poisson."
    ],
    "nl": [
      "Julien is een liefhebber van rivieren en groeide op in de zuidelijke Ardèche. Hij zal zijn ervaring op dit gebied met je delen. Hij helpt je graag bij het ontdekken of verbeteren van je vistechnieken, die zowel leuk zijn als respectvol voor de vis."
    ],
    "es": [
      "Amante de los ríos, Julien creció en el sur de Ardèche. Compartirá con usted su experiencia sobre el terreno. Estará encantado de ayudarle a descubrir o mejorar sus técnicas de pesca, divertidas y respetuosas con los peces."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Julien Rochette"
    ]
  },
