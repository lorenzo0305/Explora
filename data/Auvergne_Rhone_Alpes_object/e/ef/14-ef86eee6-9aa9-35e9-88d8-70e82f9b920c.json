  "rdfs:comment": {
    "de": [
      "In Partnerschaft mit De la suite dans les images\nVorführung des Films Le Mystère Picasso von Henri-Georges Clouzot (1956) und anschließende Konferenzdiskussion mit Thierry Cormier, Referent, Ausbilder und Berater für Film und audiovisuelle Medien."
    ],
    "en": [
      "In partnership with De la suite dans les images\nScreening of the film Le Mystère Picasso by Henri-Georges Clouzot (1956) followed by a conference-discussion with Thierry Cormier, lecturer, trainer and consultant in cinema and audiovisual."
    ],
    "it": [
      "In collaborazione con De la suite dans les images\nProiezione del film Le Mystère Picasso (1956) di Henri-Georges Clouzot seguita da una conferenza e un dibattito con Thierry Cormier, docente, formatore e consulente di cinema e audiovisivi."
    ],
    "fr": [
      "En partenariat avec De la suite dans les images\nProjection du film Le Mystère Picasso d’Henri-Georges Clouzot (1956) suivi d’une conférence discussion avec Thierry Cormier, conférencier, formateur et consultant en cinéma et audiovisuel."
    ],
    "nl": [
      "In samenwerking met De la suite dans les images\nVertoning van de film Le Mystère Picasso (1956) van Henri-Georges Clouzot, gevolgd door een lezing en discussie met Thierry Cormier, docent, trainer en consultant in cinema en audiovisuele media."
    ],
    "es": [
      "En colaboración con De la suite dans les images\nProyección de la película Le Mystère Picasso (1956), de Henri-Georges Clouzot, seguida de una conferencia-coloquio con Thierry Cormier, conferenciante, formador y consultor en cine y audiovisual."
    ]
  },
