  "rdfs:comment": {
    "de": [
      "Willkommen in La Chapelle d'Abondance: Die Französische Skischule steht Ihnen zur Verfügung, um Sie während Ihres gesamten Aufenthalts im Ort und im Skigebiet Portes du Soleil zu begleiten."
    ],
    "en": [
      "Welcome to La Chapelle d'Abondance: the French Ski School is here to help you throughout your stay in the resort and in the Portes du Soleil area."
    ],
    "it": [
      "Benvenuti a La Chapelle d'Abondance: la Scuola di sci francese è qui per aiutarvi durante il vostro soggiorno nella località e nell'area delle Portes du Soleil."
    ],
    "fr": [
      "Bienvenue à La Chapelle d'Abondance : l’École du Ski Français est à votre disposition pour vous accompagner tout au long de votre séjour dans la station et dans le domaine des Portes du Soleil."
    ],
    "nl": [
      "Welkom in La Chapelle d'Abondance: de Franse Skischool is er om u te helpen tijdens uw verblijf in het skioord en in de Portes du Soleil."
    ],
    "es": [
      "Bienvenido a La Chapelle d'Abondance: la Escuela Francesa de Esquí está a su disposición para ayudarle durante toda su estancia en la estación y en la zona de Portes du Soleil."
    ]
  },
