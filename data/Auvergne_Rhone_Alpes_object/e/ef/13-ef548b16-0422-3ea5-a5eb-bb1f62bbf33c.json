  "rdfs:comment": {
    "de": [
      "Eine entfremdende Umgebung mit Urlaubsatmosphäre. Eine schicke und sehr softe Dekoration. Eine raffinierte Küche: hausgemachte Foie gras, Stierkotelett, Frösche mit Petersilie, Lachs-Carpaccio."
    ],
    "en": [
      "An exotic setting with a holiday atmosphere. A chic and very soft decoration. A refined cuisine: homemade foie gras, bull rib, frogs with parsley, salmon carpaccio."
    ],
    "it": [
      "Un ambiente esotico con un'atmosfera di vacanza. Una decorazione chic e molto morbida. Cucina raffinata: foie gras fatto in casa, costata di toro, rane al prezzemolo, carpaccio di salmone."
    ],
    "fr": [
      "Un cadre dépaysant avec une ambiance de vacances. Une décoration chic et très soft. Une cuisine raffinée : Foie gras maison, côte de taureau, grenouilles à la persillade, Carpaccio de saumon."
    ],
    "es": [
      "Un entorno exótico con ambiente de vacaciones. Una decoración chic y muy suave. Cocina refinada: foie gras casero, costilla de toro, ranas al perejil, carpaccio de salmón."
    ],
    "nl": [
      "Een exotische omgeving met een vakantiesfeer. Een chique en zeer zachte decoratie. Verfijnde keuken: huisgemaakte foie gras, stierenribstuk, kikkers met peterselie, zalmcarpaccio."
    ]
  },
