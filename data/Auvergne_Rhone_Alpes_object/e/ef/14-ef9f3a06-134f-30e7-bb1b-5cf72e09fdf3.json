      "dc:description": {
        "de": [
          "Herr und Frau Bodin begrüßen Sie auf ihrem Bauernhof: Herstellung von Reformhühnern, Eiern und Rindfleisch. Direktverkauf per Telefon."
        ],
        "en": [
          "Mr and Mrs Bodin welcome you to their farm: production of cull hens, eggs and beef. Direct sales by telephone."
        ],
        "it": [
          "I signori Bodin vi danno il benvenuto nella loro azienda agricola: produzione di galline da riforma, uova e carne bovina. Vendita diretta per telefono."
        ],
        "fr": [
          "Mr et Mme Bodin vous accueille à leur ferme : fabrication de Poules de réforme, œufs et viande bovine. Vente directe par téléphone."
        ],
        "es": [
          "El Sr. y la Sra. Bodin le dan la bienvenida a su granja: producción de gallinas de desvieje, huevos y carne de vacuno. Venta directa por teléfono."
        ],
        "nl": [
          "De heer en mevrouw Bodin heten u welkom op hun boerderij: productie van uitstootkippen, eieren en rundvlees. Directe verkoop per telefoon."
        ]
      },
