  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen mit Informationstafel. Die Kirche Saint-Georges, ein Gebäude aus dem 12. Jahrhundert, besitzt einen achteckigen Glockenturm auf quadratischer Basis, der mit einer Pfeilspitze aus dem Jahr 1950 abgeschlossen ist."
    ],
    "en": [
      "Self-guided tour of the exterior with information panel. Saint-Georges church, a 12th-century building, has an octagonal bell tower with a square base and a spire dating from 1950."
    ],
    "it": [
      "Visita gratuita dell'esterno con pannello informativo. La chiesa di Saint-Georges, un edificio del XII secolo, ha un campanile ottagonale a base quadrata e una guglia del 1950."
    ],
    "fr": [
      "Visite libre des extérieurs avec panneau d'information. L'église Saint-Georges, édifice du XIIe siècle, possède un clocher octogonal sur base carrée et terminée par une flèche datant de 1950."
    ],
    "es": [
      "Visita gratuita al exterior con panel informativo. La iglesia de Saint-Georges, un edificio del siglo XII, tiene un campanario octogonal de base cuadrada y una aguja que data de 1950."
    ],
    "nl": [
      "Gratis bezoek aan de buitenkant met informatiepaneel. De kerk Saint-Georges, een gebouw uit de 12e eeuw, heeft een achthoekige klokkentoren met vierkante basis en een torenspits uit 1950."
    ]
  },
