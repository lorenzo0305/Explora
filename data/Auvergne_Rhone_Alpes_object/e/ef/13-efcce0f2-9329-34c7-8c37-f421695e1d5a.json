  "rdfs:comment": {
    "de": [
      "Mezzé ist ein echter nationaler Brauch, der zwar auch in den Nachbarländern existiert, aber erst im Libanon seine wahre Bedeutung erlangt. Unsere Küche ist auf vegetarische, vegane und vegane Ernährung ausgerichtet. Alle unsere Fleischsorten sind hallal."
    ],
    "en": [
      "A veritable national custom, mezze may exist in neighboring countries, but it is only in Lebanon that it really comes into its own. Our cuisine accommodates vegetarian, vegan and vegan diets. All our meats are hallal."
    ],
    "it": [
      "Vera e propria usanza nazionale, il mezzé esiste anche nei Paesi vicini, ma solo in Libano. La nostra cucina è adatta a diete vegetariane, vegane e vegane. Tutte le nostre carni sono hallal."
    ],
    "fr": [
      "Véritable coutume nationale, le mezzé, s’il existe dans les pays avoisinants, n’atteint sa véritable ampleur qu’au Liban. Notre cuisine s’adapte aux régimes alimentaires végétarien, végan et végétalien. Toutes nos viandes sont hallal."
    ],
    "es": [
      "Verdadera costumbre nacional, el mezzé existe en los países vecinos, pero sólo en el Líbano. Nuestra cocina se adapta a dietas vegetarianas, veganas y vegetarianas. Todas nuestras carnes son hallal."
    ],
    "nl": [
      "Een echte nationale gewoonte, mezzé bestaat in de buurlanden, maar alleen in Libanon. Onze keuken is geschikt voor vegetarische, veganistische en veganistische diëten. Al ons vlees is hallal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Liban Vert"
    ]
  },
