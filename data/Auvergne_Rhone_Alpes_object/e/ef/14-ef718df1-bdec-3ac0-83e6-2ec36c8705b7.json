      "dc:description": {
        "de": [
          "Unser Frühlingskonzert findet am Sonntag, den 28. April um 15 Uhr in der Festhalle statt.\n\nDas Konzert ist kostenlos, kommen Sie zahlreich."
        ],
        "en": [
          "Our spring concert takes place on Sunday April 28 at 3pm in the Salle des Fêtes.\n\nCome one, come all."
        ],
        "it": [
          "Il nostro concerto di primavera si terrà domenica 28 aprile alle 15.00 nella Salle des Fêtes.\n\nÈ un concerto gratuito, quindi venite tutti."
        ],
        "fr": [
          "Notre concert de printemps aura lieu le dimanche  28 avril  à 15h à la salle des fêtes.\n\nConcert gratuit, venez nombreux."
        ],
        "nl": [
          "Ons lenteconcert vindt plaats op zondag 28 april om 15.00 uur in de Salle des Fêtes.\n\nHet is een gratis concert, dus komt allen."
        ],
        "es": [
          "Nuestro concierto de primavera tendrá lugar el domingo 28 de abril a las 15.00 horas en la Sala de Fiestas.\n\nEs un concierto gratuito, así que venid todos."
        ]
