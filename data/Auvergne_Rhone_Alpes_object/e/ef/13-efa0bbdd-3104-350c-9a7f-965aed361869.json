  "rdfs:comment": {
    "de": [
      "Insgesamt mehr als 25 verschiedene Früchte, Trauben und außergewöhnlichen Sorten (selten oder alt) ; ökologische Gemüse und Aromapflanzen ; Bio-Weine mit „IGP\"-Siegel in Weiß, Rot und Rosé : Verkauf und Ernte.\r\nFührungen und Animationen für alle Besucher : Kinder, Erwachsene, Gruppen... Veranstaltungsräume und Ferienquartieren zur Miete."
    ],
    "en": [
      "Producer of fruits, wines, vegetables, herbs and by-products, some of which are organic. Guided tours of the gardening,workshops... Shop."
    ],
    "it": [
      "Produttore di frutta, verdura e derivati; vini biologici; ortaggi ed erbe aromatiche biologiche.\r\nNegozio in fattoria aperto tutto l'anno.\r\nRaccolta di frutta e verdura durante i mesi estivi\r\nVisite alla fattoria, eventi...\r\nAffitto di gîtes e camere"
    ],
    "fr": [
      "Producteur de fruits et légumes et leurs produits dérivés; vins bio; légumes et aromatiques bio. \r\nBoutique à la ferme ouverte toute l'année.\r\nAuto-cueillette pendant la période estivale\r\nVisite de l'exploitation, Animations...\r\nLocation de gîtes et de salles"
    ],
    "es": [
      "Productor de frutas y hortalizas y subproductos; vinos ecológicos; hortalizas y hierbas ecológicas.\r\nTienda abierta todo el año.\r\nAutocosecha en verano\r\nVisitas a la granja, eventos...\r\nAlquiler de casas rurales y habitaciones"
    ],
    "nl": [
      "Producent van fruit, wijnen, groente, aromatische planten, aanverwante producten – Biologische productie (gedeeltelijk) – Ludieke en geanimeerde rondleidingen – Workshops tuinieren en koken – Evenementen - Winkel."
    ]
  },
