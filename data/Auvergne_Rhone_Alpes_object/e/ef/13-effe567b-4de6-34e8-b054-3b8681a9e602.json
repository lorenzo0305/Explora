  "rdfs:comment": {
    "de": [
      "Vom Opinel-Platz aus nehmen Sie den Anfang des Tré Cret-Weges, dann eine Säule, bevor Sie den Anfang dieses Weges erreichen. Dieser enge und technische Waldpfad wird Sie nicht gleichgültig lassen."
    ],
    "en": [
      "From Place Opinel, take the start of the Tré Cret route, then the column before reaching the start of the route. This narrow, technical forest trail will not leave you indifferent."
    ],
    "it": [
      "Da Place Opinel, prendere l'inizio dell'itinerario Tré Cret, poi la colonna prima di ricongiungersi all'inizio di questo. Questo sentiero forestale stretto e tecnico non vi lascerà indifferenti."
    ],
    "fr": [
      "Au départ de la Place Opinel, empruntez le début de l'itinéraire Tré Cret, puis colonne avant de rejoindre le début de celui-ci. Ce sentier en forêt étroit et technique ne vous laissera pas indifférent."
    ],
    "nl": [
      "Neem vanaf de Place Opinel het begin van de Tré Cret route, dan de zuil voordat je weer bij het begin van deze route komt. Dit smalle en technische bospad zal je niet onverschillig laten."
    ],
    "es": [
      "Desde la Place Opinel, tome el inicio del itinerario Tré Cret, luego la columna antes de retomar el inicio de éste. Esta estrecha y técnica pista forestal no le dejará indiferente."
    ]
  },
