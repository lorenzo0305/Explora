  "rdfs:comment": {
    "de": [
      "Windsurfen, Windfoil und Wingfoil haben sich schnell zu dynamischen Sportarten entwickelt, die sehr häufig unterrichtet werden und für jedermann zugänglich sind. Am Lac de Pignedoré können Sie diese Sportarten ausüben."
    ],
    "en": [
      "Windsurfing, Windfoil and Wingfoil have rapidly become dynamic sports disciplines, widely taught and accessible to all. And it's at Lac de Pignedoré that you'll be able to practice them."
    ],
    "it": [
      "Windsurf, Windfoil e Wingfoil sono diventati rapidamente discipline sportive dinamiche, ampiamente insegnate e accessibili a tutti. Ed è al Lac de Pignedoré che potrete praticarle."
    ],
    "fr": [
      "Windsurf, Windfoil et Wingfoil sont rapidement devenus des disciplines sportives dynamiques très largement enseignées et accessible à tous. Et c'est au lac de pignedoré que vous pourrez les pratiquer."
    ],
    "nl": [
      "Windsurfen, Windfoil en Wingfoil zijn snel dynamische sportdisciplines geworden die op grote schaal worden onderwezen en voor iedereen toegankelijk zijn. En op het Lac de Pignedoré kun je ze beoefenen."
    ],
    "es": [
      "El Windsurf, el Windfoil y el Wingfoil se han convertido rápidamente en disciplinas deportivas dinámicas, ampliamente enseñadas y accesibles a todos. Y es en el Lac de Pignedoré donde podrás practicarlas."
    ]
  },
