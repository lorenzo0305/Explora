  "rdfs:comment": {
    "de": [
      "Der Snowpark am Lac de la Vieille :\r\nDer Snowpark von Galibier Thabor wird regelmäßig von Snowboard- und Schneeprofis gewartet und öffnet sich für alle Fahrniveaus und alle Freestyle-Ausdrücke."
    ],
    "en": [
      "Snowpark\r\nMaintained regularly by snowboard professionnals and those specialising in snow, the Galibier Thabor snowpark is open for all levels of ski and freestyle."
    ],
    "it": [
      "Lo Snowpark Lac de la Vieille:\r\nMantenuto regolarmente da professionisti dello snowboard e della neve, lo snowpark Galibier Thabor è aperto a tutti i livelli di riding e a tutte le espressioni del freestyle."
    ],
    "fr": [
      "Le Snowpark du Lac de la Vieille :\r\nEntretenu régulièrement par des professionnels du snowboard et de la neige, le snowpark de Galibier Thabor s'ouvre à tous les niveaux de glisse et à toutes les expressions de freestyle."
    ],
    "nl": [
      "Snowpark \"Le Lac de la Vieille\" :\r\nDit snowpark wordt regelmatig onderhouden door professionele en snowboarders en snowmakers. Dit park is toegankelijk voor de beoefenaars van allerlei vormen van snowboard en ski en freestyle."
    ],
    "es": [
      "El Snowpark del Lac de la Vieille:\r\nMantenido regularmente por profesionales del snowboard y de la nieve, el snowpark de Galibier Thabor está abierto a todos los niveles y a todas las expresiones del freestyle."
    ]
  },
