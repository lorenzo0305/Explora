  "rdfs:comment": {
    "de": [
      "Hatha Yoga ist ein sanfter Yoga, bei dem die Haltungen mehr oder weniger schnell aufeinander folgen und jedem die Möglichkeit bietet, seine Beweglichkeit und die Verbindung zu unserem Körper zu entdecken oder wiederzuentdecken."
    ],
    "en": [
      "Hatha yoga is a gentle form of yoga in which the postures follow each other more or less quickly, offering everyone the opportunity to discover or rediscover our mobility and connection to our bodies.\r\noffers everyone the opportunity to discover or rediscover our mobility and our connection to our bodies."
    ],
    "it": [
      "L'Hatha yoga è una forma di yoga dolce in cui le posture si susseguono più o meno velocemente, dando a tutti la possibilità di scoprire o riscoprire la mobilità e la connessione con il proprio corpo."
    ],
    "fr": [
      "Le Hatha Yoga est un Yoga doux où les postures s’enchainent plus ou moins rapidement et offre à chacun l’opportunité de découvrir ou redécouvrir nos mobilités et le lien à nos corps."
    ],
    "nl": [
      "Hatha yoga is een zachte vorm van yoga waarbij de houdingen elkaar min of meer snel opvolgen. Het biedt iedereen de mogelijkheid om onze beweeglijkheid en verbinding met ons lichaam te ontdekken of te herontdekken.\r\nbiedt iedereen de mogelijkheid om onze beweeglijkheid en onze verbinding met ons lichaam te ontdekken of te herontdekken."
    ],
    "es": [
      "El hatha yoga es una forma suave de yoga en la que las posturas se suceden más o menos rápidamente, dando a cada uno la oportunidad de descubrir o redescubrir su movilidad y la conexión con su cuerpo."
    ]
  },
