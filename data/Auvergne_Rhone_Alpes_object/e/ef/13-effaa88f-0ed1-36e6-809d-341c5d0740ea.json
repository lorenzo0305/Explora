  "rdfs:comment": {
    "de": [
      "Sonia und Régis Gourru, Familienimkerei seit 2012.\r\nNiedergelassen in Brézins (38), mit 250 Bienenstöcken. Imkerei aus biologischem Anbau. Lokale und regionale Honige. Pollen von wilden Blumen.\r\nPains d'épices (Lebkuchen). Weißer Nougat. Kosmetika und Apitherapie."
    ],
    "en": [
      "Sonia and Régis Gourru, family beekeeping since 2012.\r\nBased in Brézins (38), with 250 hives. Organic beekeeping. Local and regional honeys. Wild flower pollen.\r\nGingerbread. White nougat. Cosmetics and apitherapy."
    ],
    "it": [
      "Sonia e Régis Gourru, apicoltori a conduzione familiare dal 2012.\r\nCon sede a Brézins (38), con 250 alveari. Apicoltura biologica. Mieli locali e regionali. Polline di fiori selvatici.\r\nPan di zenzero. Torrone bianco. Cosmetica e apiterapia."
    ],
    "fr": [
      "Sonia et Régis Gourru, apiculture familiale depuis 2012.\r\nInstallés à Brézins (38), avec 250 ruches. Apiculture biologique. Miels locaux et régionaux. Pollen de fleurs sauvages.\r\nPains d'épices. Nougat blanc. Cosmétiques et apithérapie."
    ],
    "es": [
      "Sonia y Régis Gourru, apicultura familiar desde 2012.\r\nCon sede en Brézins (38), con 250 colmenas. Apicultura ecológica. Mieles locales y regionales. Polen de flores silvestres.\r\nPan de especias. Turrón blanco. Cosmética y apiterapia."
    ],
    "nl": [
      "Sonia en Régis Gourru, bijentelersfamilie sinds 2012.\r\nGevestigd in Brézins (38), met 250 bijenkasten. Biologische bijenteelt. Lokale en regionale honing. Stuifmeel van wilde bloemen.\r\nPeperkoek. Witte noga. Cosmetica en apitherapie."
    ]
  },
