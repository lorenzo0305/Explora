  "rdfs:comment": {
    "de": [
      "Steeve Charvet, ein leidenschaftlicher Winzer in Chiroubles, der sein Terroir liebt, stellt authentische Weine in einem durchdachten Weinbau her. Unser 9 Hektar großes Familienweingut wird seit sechs Generationen von Generation zu Generation weitergegeben."
    ],
    "en": [
      "Our 9-hectare family estate has been passed down through 6 generations. We will be delighted to welcome you to our estate and give you a tasting of our 10 cuvées of Chiroubles, Morgon and red and rosé Beaujolais as well as a sparkling wine. We work in the purest of traditions to craft wines that bear the stamp of both their terroir and the winemaker."
    ],
    "it": [
      "Steeve Charvet, enologo di Chiroubles, appassionato dei suoi terroir, produce vini autentici utilizzando metodi di viticoltura sostenibile. La nostra tenuta familiare di 9 ettari è stata tramandata di generazione in generazione per sei generazioni."
    ],
    "fr": [
      "Steeve Charvet, vigneron à Chiroubles, passionné, amoureux de ses terroirs, élabore des vins authentiques dans une viticulture raisonnée. Notre domaine familial de 9 hectares se transmet de génération en génération depuis six générations."
    ],
    "nl": [
      "Steeve Charvet, wijnmaker in Chiroubles, gepassioneerd door zijn terroirs, maakt authentieke wijnen met behulp van duurzame wijnbouwmethoden. Ons familiedomein van 9 hectare wordt al zes generaties lang van generatie op generatie doorgegeven."
    ],
    "es": [
      "Steeve Charvet, enólogo de Chiroubles, apasionado de sus terruños, elabora vinos auténticos con métodos de viticultura sostenible. Nuestra propiedad familiar de 9 hectáreas ha pasado de generación en generación durante seis generaciones."
    ]
  },
