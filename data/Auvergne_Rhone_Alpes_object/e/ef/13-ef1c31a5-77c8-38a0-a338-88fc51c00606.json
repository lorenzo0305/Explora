  "rdfs:comment": {
    "de": [
      "Toulaba Outdoor hat sich auf Aktivitäten in der freien Natur, Umweltbildung und Tourismus in der Auvergne spezialisiert und bietet das ganze Jahr über im Rhythmus der Jahreszeiten spielerische und lehrreiche Ausflüge für alle Arten von Zielgruppen an."
    ],
    "en": [
      "Specializing in outdoor activities, environmental education and tourism in the Auvergne region, Toulaba Outdoor offers fun and educational outings all year round, in step with the seasons, for all types of public."
    ],
    "it": [
      "Specializzata in attività all'aria aperta, educazione ambientale e turismo in Alvernia, Toulaba Outdoor offre tutto l'anno uscite divertenti ed educative, in sintonia con le stagioni, per tutti i tipi di persone."
    ],
    "fr": [
      "Spécialisé dans les activités de pleine nature, dans l'éducation à l'environnement et le tourisme en Auvergne, Toulaba Outdoor propose des sorties ludiques et éducatives toute l'année au rythme des saisons, pour tous types de publics."
    ],
    "nl": [
      "Toulaba Outdoor is gespecialiseerd in outdooractiviteiten, milieueducatie en toerisme in de Auvergne en biedt het hele jaar door leuke en leerzame uitstapjes, afgestemd op de seizoenen, voor allerlei soorten mensen."
    ],
    "es": [
      "Especializada en actividades al aire libre, educación medioambiental y turismo en Auvernia, Toulaba Outdoor ofrece salidas lúdicas y educativas durante todo el año, en sintonía con las estaciones, para todo tipo de público."
    ]
  },
