  "rdfs:comment": {
    "de": [
      "Die Landwirtschaftskammer ist eine öffentliche Einrichtung, die von gewählten Vertretern geleitet wird. Sie vertritt alle Akteure der Landwirtschaft, des ländlichen Raums und der Forstwirtschaft: Landwirte, Eigentümer, Arbeitnehmer, Berufsverbände..."
    ],
    "en": [
      "The Chamber of Agriculture is a public institution run by elected officials. It represents all the actors of the agricultural, rural and forestry world: farmers, owners, employees, professional groups..."
    ],
    "it": [
      "La Camera dell'Agricoltura è un'istituzione pubblica gestita da rappresentanti eletti. Rappresenta tutti gli attori del mondo agricolo, rurale e forestale: agricoltori, proprietari, dipendenti, gruppi professionali, ecc."
    ],
    "fr": [
      "La chambre d'agriculture est un établissement public dirigé par des élus. Elle représente l'ensemble des acteurs du monde agricole, rural et forestier : exploitants, propriétaires, salariés, groupements professionnels..."
    ],
    "es": [
      "La Cámara de Agricultura es una institución pública dirigida por representantes elegidos. Representa a todos los actores del mundo agrícola, rural y forestal: agricultores, propietarios, empleados, grupos profesionales, etc."
    ],
    "nl": [
      "De Kamer van Landbouw is een openbare instelling die wordt bestuurd door gekozen vertegenwoordigers. Zij vertegenwoordigt alle actoren van de landbouw-, plattelands- en bosbouwwereld: landbouwers, eigenaars, werknemers, beroepsgroepen, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chambre d'Agriculture de l'Allier"
    ]
  },
