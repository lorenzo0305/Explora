  "rdfs:comment": {
    "de": [
      "Schmuck-Uhrmacherei\r\nVerkauf und Reparatur von Schmuck Gold, Silber, vergoldet und Stahl\r\nVerkauf und Reparatur von Quarzuhren, Weckern und Pendeluhren\r\nWiederverkäufer: LIP, Casio, Orient, Swiss Military, Obaku,\r\nRückkauf Gold , Silber , versilbertes und vergoldetes Metall\r\nKreationen"
    ],
    "en": [
      "Jewellery-Horlogerie\r\nSale and repair of gold, silver, gold-plated and steel jewelry\r\nSale and repair of quartz watches, clocks and alarm clocks\r\nRetailers: LIP, Casio, Orient, Swiss Military, Obaku,\r\nRepurchase of gold, silver, silver-plated and gold-plated jewellery\r\nCreations"
    ],
    "it": [
      "Gioielleria e orologeria\r\nVendita e riparazione di gioielli in oro, argento, placcati oro e acciaio\r\nVendita e riparazione di orologi, pendole e sveglie al quarzo\r\nRivenditore: LIP, Casio, Orient, Swiss Military, Obaku,\r\nRiacquisto di gioielli in oro, argento, argentati e placcati in oro\r\nCreazioni"
    ],
    "fr": [
      "Bijouterie-Horlogerie\r\nVente et réparation de bijoux Or , Argent, plaqué or et acier\r\nVente et réparation de montre, réveil et pendule quartz\r\nRevendeur : LIP, Casio, Orient, Swiss Military, Obaku,\r\nRachat Or , Argent , métal argenté et plaqué or\r\nCréations"
    ],
    "nl": [
      "Juwelen en horlogerie\r\nVerkoop en reparatie van gouden, zilveren, vergulde en stalen sieraden\r\nVerkoop en reparatie van kwartshorloges, klokken en wekkers\r\nWederverkoper: LIP, Casio, Orient, Swiss Military, Obaku,\r\nTerugkoop van gouden, zilveren, verzilverde en vergulde juwelen\r\nCreaties"
    ],
    "es": [
