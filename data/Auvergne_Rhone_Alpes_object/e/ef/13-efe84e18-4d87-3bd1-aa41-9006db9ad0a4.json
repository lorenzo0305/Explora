  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen an all seine Lyoner Spezialitäten zu entdecken. In einem typischen Umfeld werden Sie sich sofort wohl fühlen, bereit einen Moment in Geselligkeit zu verbringen."
    ],
    "en": [
      "The restaurant invites you to discover its Lyonnais specialities. You’ll instantly relax in this authentic setting, ready to enjoy a delicious meal in a friendly atmosphere."
    ],
    "it": [
      "Questo ristorante ti propone di scoprire tutte le sue specialità lionesi. In un'ambientazione tradizionale ti sentirai subito a tuo agio, pronto a trascorrere un momento allegro e saporito."
    ],
    "fr": [
      "Le restaurant vous propose de découvrir toutes ses spécialités lyonnaises. Dans ce cadre typique, vous serez immédiatement à l’aise, prêts à passer un moment de convivialité."
    ],
    "es": [
      "Nuestro restaurante ofrece la posibilidad de descubrir todas sus especialidades lionesas. En este marco típico nuestros comensales enseguida se sienten cómodos y dispuestos a disfrutar."
    ],
    "nl": [
      "Het restaurant nodigt u uit om al zijn specialiteiten uit Lyon te ontdekken. In dit typische kader voelt u zich onmiddellijk op uw gemak, klaar om een gezellig moment door te brengen."
    ]
  },
