  "rdfs:comment": {
    "de": [
      "Wiedereröffnung (maximal 5 Personen in den gemeinsamen Räumen mit der Mediathek). Vereinbaren Sie einen Termin per Telefon oder E-Mail. Internetberatung, Nutzung von Office-Tools, Begleitung von Anfängern, individuelle Schulungen, Empfang von Schulklassen."
    ],
    "en": [
      "Internet consultation, office equipment using, novices accompagnying, individual shooling, school welcoming."
    ],
    "it": [
      "Riapertura (massimo 5 persone nei locali in comune con la mediateca). Fissare un appuntamento per telefono o via e-mail. Consultazioni via Internet, utilizzo di strumenti d'ufficio, coaching per principianti, formazione individuale, visite scolastiche."
    ],
    "fr": [
      "Réouverture (5 personnes maximum dans les locaux en commun avec médiathèque). Prenez-rdv par téléphone ou mail. Consultations Internet, utilisation des outils bureautiques, accompagnements des débutants, formations individuelles, accueil des scolaires."
    ],
    "es": [
      "Reapertura (máximo 5 personas en los locales comunes con la mediateca). Pida una cita por teléfono o por correo electrónico. Consultas por Internet, uso de herramientas ofimáticas, entrenamiento para principiantes, formación individual, visitas a escuelas."
    ],
    "nl": [
      "Heropening (maximaal 5 personen in de gemeenschappelijke ruimte met de mediatheek). Maak een afspraak per telefoon of e-mail. Internetconsultaties, gebruik van kantoorinstrumenten, coaching voor beginners, individuele opleiding, schoolbezoeken."
    ]
  },
