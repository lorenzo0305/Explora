  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/24fa97f2-4f53-3f07-9ca4-5dab72959189",
      "dc:description": {
        "de": [
          "Die Union Sportive Humbert organisiert die 5. Ausgabe der Wanderung des Bras-de-Brosne\nTreffpunkt ist das Stadion von Humbert\nGrill und Erfrischungsgetränke vor Ort\nFreie Abfahrt ab 7.30 Uhr\nAnmeldung vor Ort ab 7 Uhr"
        ],
        "en": [
          "Union Sportive Humbert organizes the 5th Bras-de-Brosne hike\nMeet at the Humbert stadium\nBarbecue and refreshment bar on site\nFree start from 7:30 am\nOn-site registration from 7am"
        ],
        "it": [
          "L'Unione Sportiva Humbert organizza la 5ª camminata Bras-de-Brosne\nRitrovo allo stadio Humbert\nBarbecue e bar sul posto\nPartenza libera dalle 7.30\nIscrizioni sul posto dalle 7.00"
        ],
        "fr": [
          "L'Union Sportive Humbert organise la 5è édition de la randonnée du Bras-de-Brosne\nRendez-vous au stade d'Humbert\nBarbecue et buvette sur place\nDépart libre à partir de 7h30\nInscription sur place à partir de 7h"
        ],
        "nl": [
          "Union Sportive Humbert organiseert de 5e Bras-de-Brosne wandeltocht\nVerzamelen bij het Humbertstadion\nBarbecue en bar ter plaatse\nVrije start vanaf 7.30 uur\nInschrijving ter plaatse vanaf 7u"
        ],
        "es": [
          "La Union Sportive Humbert organiza la 5ª marcha Bras-de-Brosne\nEncuentro en el estadio Humbert\nBarbacoa y bar in situ\nSalida libre a partir de las 7h30\nInscripciones in situ a partir de las 7h"
        ]
      },
