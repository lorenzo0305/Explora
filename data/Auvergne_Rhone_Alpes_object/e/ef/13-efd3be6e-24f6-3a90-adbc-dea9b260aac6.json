  "rdfs:comment": {
    "de": [
      "Die Carole?s, die aus der Ardèche stammen und als Fremdenführerinnen tätig sind, teilen mit Begeisterung ihre Leidenschaft für das Kulturerbe zwischen Rhône und Gorges de l'Ardèche!"
    ],
    "en": [
      "Ardéchoises pur jus and guides-conférencières, the Carole?s enthusiastically share their passion for heritage between the Rhône and the Gorges de l'Ardèche!"
    ],
    "it": [
      "I Carole, originari della regione dell'Ardèche, sono guide entusiaste che condividono la loro passione per il patrimonio tra il Rodano e le Gole dell'Ardèche"
    ],
    "fr": [
      "Ardéchoises pur jus et guides-conférencières, les Carole’s, partagent avec enthousiasme leur passion pour le patrimoine entre Rhône et Gorges de l’Ardèche !"
    ],
    "es": [
      "Los Carole, originarios de la región de Ardèche, son guías entusiastas que comparten su pasión por el patrimonio entre el Ródano y las Gargantas del Ardèche"
    ],
    "nl": [
      "De Carole's, afkomstig uit de Ardèche, zijn enthousiaste gidsen die hun passie delen voor het erfgoed tussen de Rhône en de Gorges de l'Ardèche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Un guide en Sud Ardèche"
    ]
  },
