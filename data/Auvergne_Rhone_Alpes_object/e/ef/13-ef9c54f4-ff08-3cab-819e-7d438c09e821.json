  "rdfs:comment": {
    "de": [
      "Spezialitäten: Gegrilltes.\r\nWir sind ein sehr gastfreundliches Lokal, das eine große und originelle Auswahl an Gerichten anbietet - \"Barbecue, Ribbs, Winqs, usw. ...\r\nWir bereiten den Kindern einen besonderen Empfang (Geschenke, etc.)"
    ],
    "en": [
      "Specialties: Grill.\r\nWe are a very welcoming establishment that offers a wide range of original dishes - \"Barbecue, Ribbs, Winqs, etc...\r\nWe have a special welcome for children (gifts, etc. ...)"
    ],
    "it": [
      "Specialità: Grigliate.\r\nSiamo un locale molto accogliente che offre una vasta gamma di piatti originali - \"Barbecue, Ribbs, Winqs, etc...\r\nAbbiamo un'attenzione particolare per i bambini (regali, ecc...)"
    ],
    "fr": [
      "Spécialités : Grillades.\r\nNous sommes un établissement très accueillant qui propose un large choix original de plats - \"Barbecue, Ribbs, Winqs, etc... \r\nNous portons un accueil particulier aux enfants (cadeaux, etc...)"
    ],
    "nl": [
      "Specialiteiten: Grill.\r\nWij zijn een zeer vriendelijk etablissement dat een breed scala aan originele gerechten aanbiedt - \"Barbecue, Ribbetjes, Winqs, enz....\r\nWe hebben speciale aandacht voor kinderen (geschenken, enz...)"
    ],
    "es": [
      "Especialidades: Parrilla.\r\nSomos un establecimiento muy acogedor que ofrece una amplia gama de platos originales - \"Barbecue, Ribbs, Winqs, etc...\r\nNos centramos especialmente en los niños (regalos, etc...)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Buffalo Grill"
    ]
  },
