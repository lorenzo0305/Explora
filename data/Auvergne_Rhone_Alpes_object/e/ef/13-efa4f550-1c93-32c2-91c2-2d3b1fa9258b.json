  "rdfs:comment": {
    "de": [
      "Nehmen Sie am Ball der Schülerinnen und Schüler der Abteilung für traditionelle Musik teil, der in Zusammenarbeit mit der Calendreta Velava veranstaltet wird, die auch Erfrischungen anbietet."
    ],
    "en": [
      "Come and join in the Traditional Music Department students' dance, in partnership with Calendreta Velava, who will be providing refreshments."
    ],
    "it": [
      "Partecipate alla danza degli studenti del Dipartimento di Musica Tradizionale in collaborazione con Calendreta Velava, che offrirà un rinfresco."
    ],
    "fr": [
      "Venez participer au bal des élèves du département de Musiques Traditionnelles en partenariat avec la Calendreta Velava qui proposera de quoi se désaltérer."
    ],
    "es": [
      "Ven y participa en el baile de los alumnos del Departamento de Música Tradicional en colaboración con Calendreta Velava, que ofrecerá un refrigerio."
    ],
    "nl": [
      "Kom dansen met de studenten van de afdeling Traditionele Muziek in samenwerking met Calendreta Velava, die voor verfrissingen zullen zorgen."
    ]
