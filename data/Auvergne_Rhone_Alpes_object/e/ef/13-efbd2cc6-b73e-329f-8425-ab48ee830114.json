  "rdfs:comment": {
    "de": [
      "SECRETS d'ALOYSE, eine Bio-Kosmetikmarke aus Savoyen, stellt in Chambéry handgefertigte Produkte in Kleinserien aus streng ausgewählten natürlichen Inhaltsstoffen her.\r\nEin lokales, engagiertes und einzigartiges Know-how, das es zu entdecken gilt."
    ],
    "en": [
      "Secrets of Aloyse is a range of cosmetics 100% natural and certified organic. The ingredients used in the manufacture of the products are carefully selected and come from organic agriculture or fair trade."
    ],
    "it": [
      "SECRETS d'ALOYSE, marchio di cosmetici biologici della Savoia, realizza prodotti artigianali in piccoli lotti a Chambéry, utilizzando ingredienti naturali rigorosamente selezionati.\r\nScoprite questa competenza locale unica e impegnata."
    ],
    "fr": [
      "SECRETS d’ALOYSE, marque savoyarde de cosmétiques bio, fabrique à la main à Chambéry des produits artisanaux en petites séries, avec des ingrédients naturels rigoureusement sélectionnés.\r\nUn savoir-faire local, engagé et unique, à découvrir."
    ],
    "nl": [
      "SECRETS d?ALOYSE, een biologisch cosmeticamerk uit de Savoie, maakt handgemaakte producten in kleine series in Chambéry, met streng geselecteerde natuurlijke ingrediënten.\r\nOntdek deze unieke, toegewijde lokale expertise."
    ],
    "es": [
      "SECRETS d'ALOYSE, marca de cosméticos ecológicos de Saboya, elabora productos artesanales en pequeños lotes en Chambéry, a partir de ingredientes naturales rigurosamente seleccionados.\r\nDescubra este saber hacer local único y comprometido."
    ]
  },
