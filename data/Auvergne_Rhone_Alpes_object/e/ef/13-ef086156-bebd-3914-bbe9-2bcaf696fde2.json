      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/51e89017-5fc9-34fe-9b1a-5e66ea4ac6d9",
          "schema:validFrom": "2026-09-01T00:00:00",
          "schema:validThrough": "2026-05-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Schulzeit :\r\nMontag: 11.30-13.15 Uhr, 17.00-19.30 Uhr\r\nDienstag: 11.30-13.15 Uhr, 17.20.30 Uhr\r\nMittwoch: 12-18.30 Uhr\r\nDonnerstag: 7-8 Uhr, 11.30-13.15 Uhr\r\nFreitag: 11.30-13.15 Uhr, 17.00-19.30 Uhr\r\nSamstag: 9-12.30 Uhr, 14-17.30 Uhr Sonntag: 8-12.30 Uhr\r\n\r\nKleine Ferien:\r\nMontag bis Freitag\r\n10:00-13:30 Uhr, 15:00-19:30 Uhr\r\nSamstag: 10h-13h30, 15h-17h30\r\nSonntag: 8-12.30 Uhr\r\n\r\nGanzjährig: Räumung der Becken 30 Minuten vor Schließung der Einrichtung.\r\nSchließung der Kassen und Ende des Zugangs für die Öffentlichkeit 50 Minuten vor Schließung der Einrichtung."
            ],
            "en": [
              "School period :\r\nMonday: 11:30am-1:15pm, 5pm-7:30pm\r\nTuesday: 11:30am-1:15pm, 5pm-8:30pm\r\nWednesday: 12h-18h30\r\nThursday: 7am-8am, 11:30am-1:15pm\r\nFriday: 11:30am-1:15pm, 5pm-7:30pm\r\nSaturday: 9am-12.30pm, 2pm-5.30pm Sunday: 8am-12.30pm\r\n\r\nShort vacations:\r\nMonday to Friday\r\n10am-1.30pm, 3pm-7.30pm\r\nSaturday: 10h-13h30, 15h-17h30\r\nSunday: 8h-12h30\r\n\r\nAll year round, pools evacuated 30 minutes before closing time.\r\nTicket offices close and public access ends 50 minutes before closing time."
            ],
            "it": [
              "Orario scolastico :\r\nLunedì: 11.30-13.15, 17.00-19.30\r\nMartedì: 11.30-13.15, 17.00-20.30\r\nMercoledì: 12.00-18.30\r\nGiovedì: 7.00-8.00, 11.30-13.15\r\nVenerdì: 11.30-13.15, 17.00-19.30\r\nSabato: 9.00-12.30, 14.00-17.30 Domenica: 8.00-12.30\r\n\r\nVacanze brevi:\r\nDa lunedì a venerdì\r\n10.00-13.30, 15.00-19.30\r\nSabato: 10.00-13.30, 15.00-17.30\r\nDomenica: 8.00-12.30\r\n\r\nTutto l'anno, le piscine vengono evacuate 30 minuti prima della chiusura.\r\nLe casse chiudono e l'accesso al pubblico termina 50 minuti prima della chiusura."
            ],
            "fr": [
              "Période scolaire :\r\nLundi           : 11h30-13h15, 17h-19h30\r\nMardi    : 11h30-13h15, 17h-20h30\r\nMercredi     : 12h-18h30 \r\nJeudi     : 7h-8h, 11h30-13h15\r\nVendredi     : 11h30-13h15, 17h-19h30\r\nSamedi        : 9h-12h30, 14h-17h30  Dimanche   : 8h-12h30  \r\n\r\nPetites vacances:\r\nDu lundi au vendredi\r\n10h-13h30, 15h-19h30\r\nSamedi      : 10h-13h30, 15h-17h30\r\nDimanche  : 8h-12h30\r\n\r\nToute l'année, évacuation des bassins 30 minutes avant la fermeture de l'établissement.\r\nFermeture des caisses et fin accès du public 50 minutes avant la fermeture de l'établissement."
            ],
            "nl": [
              "Schooltijd :\r\nMaandag: 11.30-13.15, 17.00-19.30\r\nDinsdag: 11.30-1.15, 17.00-20.30\r\nWoensdag: 12.00-18.30\r\nDonderdag: 7.00-8.00, 11.30-1.15\r\nVrijdag: 11.30-1.15, 17.00-19.30\r\nZaterdag: 9-12.30u, 14-17.30u Zondag: 8-12.30u\r\n\r\nKorte vakanties:\r\nMaandag t/m vrijdag\r\n10.00-1.30, 15.00-19.30\r\nZaterdag: 10.00-13.30, 15.00-17.30\r\nZondag: 8.00-12.30\r\n\r\nHet hele jaar door, zwembaden worden 30 minuten voor sluitingstijd ontruimd.\r\nDe kassa's sluiten en de toegang voor het publiek eindigt 50 minuten voor sluitingstijd."
            ],
            "es": [
              "Horario escolar :\r\nLunes: 11.30-1.15pm, 5pm-7.30pm\r\nMartes: 11.30-1.15pm, 5pm-8.30pm\r\nMiércoles: de 12.00 a 18.30\r\nJueves: de 7.00 a 8.00 h. y de 11.30 a 13.15 h\r\nViernes: de 11.30 a 13.15 h. y de 17.00 a 19.30 h\r\nSábado: de 9.00 a 12.30 h. y de 14.00 a 17.30 h. Domingo: de 8.00 a 12.30 h\r\n\r\nVacaciones cortas:\r\nDe lunes a viernes\r\nde 10.00 a 13.30 h. y de 15.00 a 19.30 h\r\nSábado: de 10.00 a 13.30 h. y de 15.00 a 17.30 h\r\nDomingo: de 8.00 a 12.30\r\n\r\nTodo el año, las piscinas se cierran 30 minutos antes del cierre.\r\nLas cajas cierran y el acceso al público finaliza 50 minutos antes del cierre."
            ]
          },
