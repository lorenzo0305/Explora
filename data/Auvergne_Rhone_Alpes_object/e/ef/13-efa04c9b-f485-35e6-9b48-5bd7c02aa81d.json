  "rdfs:comment": {
    "de": [
      "Bella Ciao bietet Ihnen handgemachte Pizzas und traditionelle italienische Gerichte: Pasta mit typischen hausgemachten Soßen, Antipasti und italienische Wurstwaren auf Brettern, hausgemachte Desserts, Tagesgerichte...Verschiedene Mittagsangebote"
    ],
    "en": [
      "Bella Ciao offers homemade pizzas and traditional Italian dishes: pasta with typical homemade sauces, antipasti and Italian charcuterie on a plank, homemade desserts, daily specials...Various lunch formulas"
    ],
    "it": [
      "Bella Ciao offre pizze fatte in casa e piatti della tradizione italiana: pasta con sughi tipici fatti in casa, antipasti e salumi italiani su assi, dolci fatti in casa, piatti del giorno... Sono disponibili diverse opzioni per il pranzo"
    ],
    "fr": [
      "Bella Ciao vous propose pizzas artisanales et plats traditionnels italiens : pâtes aux sauces typiques faites maisons, antipasti et charcuteries italiennes sur planche, desserts maison, plats du jour...Différentes formules midi"
    ],
    "es": [
      "Bella Ciao ofrece pizzas caseras y platos tradicionales italianos: pasta con salsas típicas caseras, antipasti y embutidos italianos a la plancha, postres caseros, platos del día... Se ofrecen diversas opciones de almuerzo"
    ],
    "nl": [
      "Bella Ciao biedt huisgemaakte pizza's en traditionele Italiaanse gerechten: pasta met typische huisgemaakte sauzen, antipasti en Italiaanse vleeswaren op een plank, huisgemaakte desserts, dagschotels... Er zijn verschillende lunchopties beschikbaar"
    ]
  },
