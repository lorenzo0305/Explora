  "rdfs:comment": {
    "de": [
      "In einem modernen savoyischen Rahmen und einer herzlichen Atmosphäre, nur wenige Schritte vom historischen Zentrum von Chambéry entfernt, können Sie unsere savoyischen und traditionellen Spezialitäten entdecken."
    ],
    "en": [
      "Cosy and rustic restaurant with a typical Savoy setting and a warm atmosphere, a step or two away from Chambéry’s historical centre. Come and enjoy our local and traditional specialities."
    ],
    "it": [
      "In un ambiente savoiardo moderno e in una calda atmosfera, a due passi dal centro storico di Chambéry, venite a scoprire le nostre specialità savoiarde e tradizionali."
    ],
    "fr": [
      "Dans un cadre moderne savoyard et une ambiance chaleureuse, à deux pas du centre historique de Chambéry, venez découvrir nos spécialités savoyardes et traditionnelles."
    ],
    "nl": [
      "In een moderne Savoyaardse omgeving en een warme sfeer, op een steenworp afstand van het historische centrum van Chambéry, kom onze Savoyaardse en traditionele specialiteiten ontdekken."
    ],
    "es": [
      "En un marco saboyano moderno y un ambiente cálido, a dos pasos del centro histórico de Chambéry, venga a descubrir nuestras especialidades saboyanas y tradicionales."
    ]
  },
