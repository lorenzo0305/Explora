  "rdfs:comment": {
    "de": [
      "Seit 500 Jahren bietet Ihnen das befestigte Haus von Durianne, das sich in der Nähe von Le Puy-en-Velay am Eingang der Loire-Schlucht befindet, das Leben eines Schlosses auf dem Bauernhof."
    ],
    "en": [
      "For 500 years, the fortified house of Durianne near Le Puy-en-Velay, at the entrance to the Loire Gorge, has been offering you castle life on the farm."
    ],
    "it": [
      "Da 500 anni, la casa fortificata Durianne vicino a Le Puy-en-Velay, all'ingresso delle Gole della Loira, vi offre la possibilità di sperimentare la vita di uno château in una fattoria."
    ],
    "fr": [
      "Depuis 500 ans, la maison forte de Durianne se situant près du Puy-en-Velay, à l'entrée des gorges de la Loire, vous propose la vie de château à la ferme."
    ],
    "nl": [
      "Het versterkte huis Durianne in de buurt van Le Puy-en-Velay, aan de ingang van de Gorges de la Loire, biedt je al 500 jaar de mogelijkheid om het leven als kasteel op een boerderij te ervaren."
    ],
    "es": [
      "Desde hace 500 años, la casa fortificada de Durianne, cerca de Le Puy-en-Velay, a la entrada de las Gargantas del Loira, le ofrece la posibilidad de experimentar la vida de un castillo en una granja."
    ]
  },
  "rdfs:label": {
