  "rdfs:comment": {
    "de": [
      "Wir bieten Gerichte aus frischen, lokalen und hausgemachten Produkten an. Mittagstisch von Montag bis Freitag sowie Burger-Abend am Freitagabend. Bar die ganze Woche geöffnet."
    ],
    "en": [
      "We offer dishes made from fresh, local, homemade products. Lunch service from Monday to Friday and Burger Night on Friday evening. Bar open all week."
    ],
    "it": [
      "Bar-ristorante del villaggio che serve piatti a base di prodotti freschi, locali e fatti in casa. Servizio di pranzo solo dal lunedì al venerdì e serata hamburger il venerdì sera. Servizio bar durante tutta la settimana."
    ],
    "fr": [
      "Bar-restaurant de village, nous proposons des plats élaborés à partir de produits frais, locaux et faits maison. Service du midi uniquement du lundi au vendredi et soirée Burger le vendredi soir. Bar toute la semaine."
    ],
    "nl": [
      "Dorpsbar-restaurant waar gerechten worden geserveerd van verse, lokale, zelfgemaakte producten. Alleen lunchservice van maandag tot vrijdag en burgeravond op vrijdagavond. Barservice gedurende de hele week."
    ],
    "es": [
      "Bar-restaurante de pueblo que sirve platos elaborados con productos frescos, locales y caseros. Servicio de comidas sólo de lunes a viernes y noche de hamburguesas los viernes por la noche. Servicio de bar durante toda la semana."
    ]
  },
