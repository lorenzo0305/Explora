  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro empfängt Sie das ganze Jahr über, um Sie während Ihres Aufenthalts bei uns bestmöglich zu beraten."
    ],
    "en": [
      "The tourist office welcomes you all year round and offers you all the brochures for a pleasant stay. We offer for sale a hiking map."
    ],
