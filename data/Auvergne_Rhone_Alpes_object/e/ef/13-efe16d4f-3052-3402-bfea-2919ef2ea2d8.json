  "rdfs:comment": {
    "de": [
      "Das Fahrraderlebnis in den Alpen : Die Mission von Bike & Trip ist es, Ihren Fahrradurlaub so zu organisieren, dass Sie sich nur noch darum kümmern müssen, in die Pedale zu treten."
    ],
    "en": [
      "The cycling experience in the Alps: Bike & Trip's mission is to organize your cycling holiday so that the only thing you have to worry about is pedaling."
    ],
    "it": [
      "L'esperienza ciclistica nelle Alpi: La missione di Bike & Trip è organizzare la vostra vacanza in bicicletta in modo che l'unica cosa di cui dobbiate preoccuparvi sia pedalare."
    ],
    "fr": [
      "L'expérience vélo dans les Alpes : La mission de Bike & Trip est d’organiser votre séjour vélo pour que la seule chose à laquelle vous ayez à vous soucier est de pédaler."
    ],
    "es": [
      "La experiencia ciclista en los Alpes : La misión de Bike & Trip es organizar sus vacaciones en bicicleta para que lo único de lo que tenga que preocuparse sea de pedalear."
    ],
    "nl": [
      "De fietservaring in de Alpen : De missie van Bike & Trip is om uw fietsvakantie zo te organiseren dat u zich alleen nog maar zorgen hoeft te maken over het trappen."
    ]
  },
