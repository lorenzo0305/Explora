  "rdfs:comment": {
    "de": [
      "Praxis für Physiotherapie.\r\nMasseur und Physiotherapeut, der auf ärztliche Verordnung für alle Arten von Rehabilitation oder in freier Praxis arbeitet. Dieser Physiotherapeut richtet sich sowohl an Urlauber als auch an Einheimische oder Saisonarbeiter."
    ],
    "en": [
      "Physiotherapy Clinic\r\nPhysiotherapist masseur acting upon medical prescription for any type of physical therapy or free consultation. Equally suitable for holidaymakers, locals and seasonal workers."
    ],
    "it": [
      "Studio di fisioterapia.\r\nFisioterapista che lavora su prescrizione medica per tutti i tipi di riabilitazione o per consulenze gratuite. Questo fisioterapista è aperto ai vacanzieri, agli abitanti del luogo e ai lavoratori stagionali."
    ],
    "fr": [
      "Cabinet de Kinésithérapie.\r\nMasseur kinésithérapeute exerçant sur prescription médicale pour tout type de rééducation ou en libre consultation. Ce kiné s'adresse aussi bien aux vacanciers qu'aux locaux ou saisonniers."
    ],
    "nl": [
      "Kabinet van fysiotherapie.\r\nMasseur kinesytherapeut die werkt op medisch voorschrift voor elke vorm van revalidatie of in vrij overleg. Richt zich zowel tot vakantiegangers als lokale bewoners of seizoensarbeiders."
    ],
    "es": [
      "Consulta de fisioterapia.\r\nFisioterapeuta que trabaja por prescripción médica para todo tipo de rehabilitación o consulta gratuita. Este fisioterapeuta está abierto tanto a veraneantes como a locales y temporeros."
    ]
  },
  "rdfs:label": {
    "de": [
      "Praxis für Physiotherapie in Plagne Centre"
    ],
    "en": [
      "Plagne Centre Physiotherapy Clinic"
    ],
    "fr": [
      "Cabinet de Kinésithérapie de Plagne Centre"
    ],
    "nl": [
      "Kabinet van fysiotherapie.van Plagne Centre"
    ]
  },
