  "rdfs:comment": {
    "de": [
      "Schmuckdesigner für Modeschmuck. Während Ihres Besuchs werden Gilbert und Christine Giraud ihre Leidenschaft für die Herstellung von Schmucksets und verschiedenen Objekten sowie ihren autonomen Herstellungsprozess in ihren Werkstätten teilen."
    ],
    "en": [
      "Fashion Jewelry Creator. During your visit, Gilbert and Christine Giraud will share their passion for creating jewelry sets and various objects, as well as their self-sufficient manufacturing process in their workshops."
    ],
    "it": [
      "Creatore di gioielli di fantasia. Durante la vostra visita, Gilbert e Christine Giraud condivideranno la loro passione per la creazione di parure di gioielli e oggetti vari, nonché il loro processo di produzione autonomo nei loro laboratori."
    ],
    "fr": [
      "Créateurs de bijoux fantaisies. Lors de votre visite, Gilbert et Christine Giraud vous feront partager leur passion pour la création de parures de bijoux et d'objets divers et leur fabrication en autonomie de fonctionnement dans leurs ateliers."
    ],
    "nl": [
      "Maker van fantasiejuwelen. Tijdens uw bezoek zullen Gilbert en Christine Giraud hun passie voor het maken van sieradensets en verschillende objecten delen, evenals hun zelfvoorzienende fabricageproces in hun werkplaatsen."
    ],
    "es": [
      "Creadores de bisutería. Durante su visita, Gilbert y Christine Giraud compartirán con usted su pasión por crear adornos de bisutería y otros objetos, y por fabricarlos de forma independiente en sus talleres."
    ]
  },
