  "rdfs:comment": {
    "de": [
      "Im Herzen des Waldes von Tronçais, dem schönsten Eichenwald Europas, empfängt Sie das Hotel le Tronçais, das ehemalige Wohnhaus des Meisters der Schmiede von Tronçais (18. Jahrhundert), zu einem ruhigen und entspannenden Moment."
    ],
    "en": [
      "In the heart of the forest of Tronçais, the most beautiful oak forest in Europe, the hotel le Tronçais, former residence of the master of the forges of Tronçais (18th century) welcomes you in a moment of calm and relaxation."
    ],
    "it": [
      "Nel cuore della foresta di Tronçais, il più bel querceto d'Europa, l'hotel Tronçais, antica residenza del maestro delle fucine di Tronçais (XVIII secolo), vi accoglie in un momento di calma e relax."
    ],
    "fr": [
      "Au coeur de la forêt de Tronçais, plus belle chênaie d'Europe, l'hôtel le Tronçais, ancienne demeure du maître des forges de Tronçais (18e siècle) vous accueille dans un moment de calme et relaxant."
    ],
    "nl": [
      "In het hart van het bos van Tronçais, het mooiste eikenbos van Europa, verwelkomt het hotel Tronçais, de voormalige residentie van de meester van de smederijen van Tronçais (18e eeuw), u in een rustig en ontspannen moment."
    ],
    "es": [
      "En el corazón del bosque de Tronçais, el robledal más bello de Europa, el hotel Tronçais, antigua residencia del maestro de las fraguas de Tronçais (siglo XVIII), le acoge en un momento de calma y relajación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Le Tronçais"
    ]
  },
