  "rdfs:comment": {
    "de": [
      "Stéphane und Francette empfangen Sie im Dekor einer Almhütte, zwischen alten Werkzeugen, glänzendem Kupfer, altem Holz und Pelzen. Jeden Abend werden Ihnen raffinierte Spezialitäten für einen Gourmetmoment angeboten."
    ],
    "en": [
      "Frédéric and Monique welcome you to their restaurant decorated in the style of a traditional Alpine chalet with olden-day tools, shiny brass, old wood and furs. Refined specialities are on the menu every lunchtime and evening, for a gourmet treat."
    ],
    "it": [
      "Frédéric e Monique vi danno il benvenuto nel loro chalet di montagna, dove troverete vecchi attrezzi, ottone scintillante, legno antico e pellicce. A pranzo e a sera vengono servite specialità raffinate."
    ],
    "fr": [
      "Frédéric et Monique vous accueillent dans un décor de chalet d'alpage, entre vieux outils, cuivres rutilants, vieux bois et fourrures. Des spécialités raffinées vous seront proposées pour un moment gourmand, tous les midis et tous les soirs."
    ],
    "es": [
      "Frédéric y Monique le dan la bienvenida a su chalet de montaña, donde encontrará herramientas antiguas, latón reluciente, madera vieja y pieles. Todos los mediodías y todas las noches se sirven especialidades refinadas."
    ],
    "nl": [
      "Frédéric en Monique heten je welkom in hun berghut, waar je oud gereedschap, glanzend messing, oud hout en bont vindt. Verfijnde specialiteiten worden elke middag en avond geserveerd."
    ]
  },
