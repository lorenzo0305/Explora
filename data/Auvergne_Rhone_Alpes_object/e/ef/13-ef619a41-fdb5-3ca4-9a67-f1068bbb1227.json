  "rdfs:comment": {
    "de": [
      "Der Hof ist ein kleines Stück Paradies und liegt an den ersten Ausläufern des Bugey-Gebirges, nur 45 Minuten von Bourg-en-Bresse und 1 Stunde von Lyon oder Genf entfernt. Die Wiesen verteilen sich zwischen Plateaus und Hügeln auf 500 m Höhe."
    ],
    "en": [
      "The farm is a little corner of paradise in the foothills of the Bugey, just 45 minutes from Bourg-en-Bresse and 1 hour from Lyon or Geneva. The meadows are spread between plateaus and hills, at an altitude of 500 m."
    ],
    "it": [
      "La fattoria è un piccolo angolo di paradiso ai piedi del Bugey, a soli 45 minuti da Bourg-en-Bresse e a 1 ora da Lione o Ginevra. I prati sono distribuiti tra altipiani e colline, a un'altitudine di 500 metri."
    ],
    "fr": [
      "La ferme est un petit coin de paradis qui se situe sur les premiers contreforts du Bugey, à seulement 45 minutes de Bourg-en-Bresse, et à 1 heure de Lyon ou de Genève. Les prés sont répartis entre plateaux et collines, à 500 m d'altitude."
    ],
    "es": [
      "La granja es un pequeño rincón del paraíso en las estribaciones del Bugey, a sólo 45 minutos de Bourg-en-Bresse, y a 1 hora de Lyon o Ginebra. Los prados se extienden entre mesetas y colinas, a una altura de 500 m."
    ],
    "nl": [
      "De boerderij is een stukje paradijs in de uitlopers van de Bugey, op slechts 45 minuten van Bourg-en-Bresse, en 1 uur van Lyon of Genève. De weiden liggen verspreid tussen plateaus en heuvels, op een hoogte van 500 m."
    ]
  },
  "rdfs:label": {
    "fr": [
      "EARL de Plan Poncieux"
    ]
  },
