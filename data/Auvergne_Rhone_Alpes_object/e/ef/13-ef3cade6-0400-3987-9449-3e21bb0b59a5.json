  "rdfs:comment": {
    "de": [
      "Diese Route, die speziell für Anfänger und gemütliche Skifahrer gedacht ist, führt Sie zu unserem einfachsten Massiv, dem Massiv von Solaise! Sie fahren nur auf grünen und blauen Pisten."
    ],
    "en": [
      "Specially designed for beginners and leisurely skiers, this route takes you to our easiest massif, the Solaise! You'll be skiing on green and blue runs only."
    ],
    "it": [
      "Questo itinerario, appositamente studiato per i principianti e gli sciatori più tranquilli, vi porta sul nostro massiccio più facile, il massiccio della Solaise! Si scierà solo su piste verdi e blu."
    ],
    "fr": [
      "Cet itinéraire spécialement pensé pour les débutants et les skieurs tranquilles vous emmène sur notre massif le plus facile le massif de Solaise ! Vous emprunterez uniquement des pistes vertes et bleues."
    ],
    "es": [
      "Este itinerario, especialmente diseñado para principiantes y esquiadores suaves, le llevará a nuestro macizo más fácil, el macizo de la Solaise Esquiarás únicamente en pistas verdes y azules."
    ],
    "nl": [
      "Deze route, speciaal ontworpen voor beginners en lichte skiërs, neemt je mee naar ons gemakkelijkste massief, het Solaise-massief! Je skiet alleen op groene en blauwe pistes."
    ]
  },
  "rdfs:label": {
    "en": [
      "Solaise \"Ski Tranquille\" easy skiing route"
    ],
    "fr": [
      "Itinéraire Ski tranquille Solaise"
    ]
  },
