  "rdfs:comment": {
    "de": [
      "Üben Sie eine Stunde oder ein Wochenende lang auf den drei Greenset-Freiluftplätzen (beleuchtet) und der Trainingswand. Ganzjährige Kurse für Groß und Klein möglich."
    ],
    "en": [
      "Come and practise for an hour or a weekend on the three outdoor Greenset courts (floodlit) and the practice wall. Year-round lessons available for adults and children."
    ],
    "it": [
      "Venite ad allenarvi per un'ora o per un weekend sui tre campi da gioco all'aperto (illuminati) e sul muro di allenamento. Tutto l'anno sono disponibili corsi per adulti e bambini."
    ],
    "fr": [
      "Venez vous exercer le temps d'une heure ou d'un week end, sur les trois terrains extérieurs en Greenset (éclairés) et le mur d'entraînement. Possibilité de cours à l'année pour les grands et les petits."
    ],
    "es": [
      "Venga a practicar durante una hora o un fin de semana en las tres pistas exteriores de greenset (iluminadas) y el muro de entrenamiento. Hay cursos disponibles todo el año para adultos y niños."
    ],
    "nl": [
      "Kom een uur of een weekend oefenen op de drie buitenbanen (verlicht) en de oefenmuur. Het hele jaar door zijn er cursussen voor volwassenen en kinderen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tennis courts of Viuz en Sallaz"
    ],
    "fr": [
      "Courts de Tennis de Viuz-en-Sallaz"
    ]
  },
