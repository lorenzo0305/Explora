  "rdfs:comment": {
    "de": [
      "Der argentinische Gitarrist Lautaro präsentiert Ihnen \"Bayum\", eine fesselnde musikalische Reise zwischen Buenos Aires und den Landschaften Argentiniens, in der sich Tango und Folklore vermischen."
    ],
    "en": [
      "Argentine guitarist Lautaro presents \"Bayum\", a captivating musical journey between Buenos Aires and the Argentine countryside, blending tango and folklore."
    ],
    "it": [
      "Il chitarrista argentino Lautaro presenta \"Bayum\", un accattivante viaggio musicale tra Buenos Aires e i paesaggi dell'Argentina, mescolando tango e folklore."
    ],
    "fr": [
      "Guitariste argentin, Lautaro vous présente \"Bayum\", un voyage musical captivant entre Buenos Aires et les paysages de l'Argentine, mêlant tango et folklore."
    ],
    "es": [
      "El guitarrista argentino Lautaro presenta \"Bayum\", un cautivador viaje musical entre Buenos Aires y los paisajes de Argentina, mezclando tango y folclore."
    ],
    "nl": [
      "De Argentijnse gitarist Lautaro presenteert \"Bayum\", een meeslepende muzikale reis tussen Buenos Aires en de landschappen van Argentinië, waarbij tango en folklore vermengd worden."
    ]
