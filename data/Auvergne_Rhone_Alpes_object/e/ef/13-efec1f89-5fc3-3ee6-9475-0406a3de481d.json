  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese seit 1909 unter Denkmalschutz stehende Kirche, die im späten Mittelalter im Stil der Flamboyant-Gotik erbaut wurde, und bewundern Sie ihren markanten Renaissance-Glockenturm."
    ],
    "en": [
      "Discover this church, listed as a historic monument since 1909, built in the late Middle Ages in the flamboyant Gothic style, and admire its distinctive Renaissance bell tower."
    ],
    "it": [
      "Scoprite questa chiesa, classificata come monumento storico dal 1909, costruita nel tardo Medioevo in stile gotico fiammeggiante e ammirate il suo caratteristico campanile rinascimentale."
    ],
    "fr": [
      "Découvrez cette église classée monument historique depuis 1909,  édifiée à la fin du Moyen Âge en style gothique flamboyant et admirez son clocher Renaissance si particulier."
    ],
    "nl": [
      "Ontdek deze kerk, die sinds 1909 op de monumentenlijst staat, gebouwd in de late middeleeuwen in de flamboyante gotische stijl en bewonder de kenmerkende klokkentoren uit de renaissance."
    ],
    "es": [
      "Descubra esta iglesia, declarada monumento histórico desde 1909, construida a finales de la Edad Media en estilo gótico flamígero y admire su característico campanario renacentista."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Jean"
    ]
  },
