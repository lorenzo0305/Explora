  "rdfs:comment": {
    "de": [
      "Willkommen in der provenzalischen Drôme. Ob mit der Familie, mit Freunden oder für einen Geschäftsaufenthalt, unsere brandneuen, zeitgenössisch gestalteten Zimmer bieten Platz für bis zu 4 Personen."
    ],
    "en": [
      "Welcome to Drôme provençale. Whether you're with family, friends or on business, our brand-new, contemporary-designed rooms can accommodate up to 4 people. Close to the highway and tourist places."
    ],
    "it": [
      "Benvenuti nella Drôme provençale. Che siate in famiglia, con amici o in viaggio d'affari, le nostre nuovissime camere dal design contemporaneo possono ospitare fino a 4 persone. Vicino all'autostrada e alle attrazioni turistiche."
    ],
    "fr": [
      "Bienvenue dans la Drôme provençale. En famille, entre amis ou bien pour un séjour d'affaires, nos chambres au design contemporain, flambant neuf, accueillent jusqu'à 4 personnes. A proximité de l'autoroute et des lieux touristiques."
    ],
    "nl": [
      "Welkom in de Drôme provençale. Of je nu met je gezin, met vrienden of op zakenreis bent, onze gloednieuwe, modern ingerichte kamers zijn geschikt voor maximaal 4 personen."
    ],
    "es": [
      "Bienvenido a la Drôme provenzal. En familia, entre amigos o en viaje de negocios, nuestras nuevas habitaciones de diseño contemporáneo pueden alojar hasta 4 personas. Cerca de la autopista y de las atracciones turísticas."
    ]
  },
