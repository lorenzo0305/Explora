  "rdfs:comment": {
    "de": [
      "Als Bergbegleiter organisiere ich Tages- und Mehrtageswanderungen in Trièves und Umgebung (Vercors, Dévoluy), Teambuilding-Aktivitäten für alle Gruppen sowie Trekking- und Wanderrouten in den Alpen."
    ],
    "en": [
      "Alizane Montagne is a mountain guide with a passion for nature and hiking!\r\nDay and multi-day outings in the Trièves, Vercors and Dévoluy, nature-oriented team-building activities."
    ],
    "it": [
      "Come leader di montagna, organizzo escursioni di un giorno o di più giorni nel Trièves e nelle zone circostanti (Vercors, Dévoluy), attività di team building nella natura per gruppi, nonché escursioni e itinerari nelle Alpi."
    ],
    "fr": [
      "Alizane Montagne, c’est une accompagnatrice et un accompagnateur en montagne, passionné·e·s de nature et de randonnée !\r\nSorties à la journée / sur plusieurs jours dans le Trièves, Vercors, Dévoluy, activités de team-building orientées nature."
    ],
    "es": [
      "Como monitor de montaña, organizo excursiones de un día o de varios días en Trièves y alrededores (Vercors, Dévoluy), actividades de team-building para cualquier grupo, así como trekkings e itinerarios en los Alpes."
    ],
    "nl": [
      "Alizane Montagne is een berggids met een passie voor natuur en wandelen!\r\nDag- of meerdaagse uitstapjes in de Trièves, Vercors en Dévoluy, natuurgerichte teambuildingactiviteiten."
    ]
  },
