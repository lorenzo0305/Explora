  "rdfs:comment": {
    "de": [
      "Der Saal des Schulrestaurants in Les Vennes kann 66 Personen aufnehmen. Sie haben Zugang zum Speisesaal, in dem Tische und Stühle zur Verfügung stehen + Toiletten und Zugang zu einer kleinen Küche mit Kühlschrank."
    ],
    "en": [
      "The Les Vennes school restaurant can accommodate 66 people. You have access to the dining room with tables and chairs + toilets and access to a small kitchen with a fridge."
    ],
    "it": [
      "Il ristorante della scuola Les Vennes può ospitare 66 persone. È possibile accedere alla sala da pranzo con tavoli e sedie + servizi igienici e accedere a una piccola cucina con frigorifero."
    ],
    "fr": [
      "La salle du restaurant scolaire des Vennes est en capacité d'accueillir 66 personnes. Vous avez accès à la salle de restauration avec tables et chaises à disposition + des toilettes et un accès à une petite cuisine avec un frigo."
    ],
    "nl": [
      "Het schoolrestaurant Les Vennes biedt plaats aan 66 personen. Je hebt toegang tot de eetzaal met tafels en stoelen + toiletten en toegang tot een kleine keuken met een koelkast."
    ],
    "es": [
      "El restaurante de la escuela Les Vennes tiene capacidad para 66 personas. Usted tiene acceso al comedor con mesas y sillas + aseos y acceso a una pequeña cocina con nevera."
    ]
  },
