  "rdfs:comment": {
    "de": [
      "Zweites Restaurant im Telebar Resort, mit einer frischen, international ausgerichteten Küche (verschiedene Salate, frische Pasta, Gegrilltes, hausgemachte Burger...), in der sich Abwechslung auf Schnelligkeit reimt."
    ],
    "en": [
      "Second restaurant of the Telebar's resort, with a fresh international cuisine (different salad, fresh pasta, mixed grill, burgers...)"
    ],
    "it": [
      "Secondo ristorante del resort Telebar, con una fresca cucina internazionale (insalate varie, pasta fresca, carne alla griglia, hamburger fatti in casa...) dove varietà fa rima con velocità."
    ],
    "fr": [
      "Deuxième restaurant du resort Telebar, avec une cuisine fraicheur d'orientation internationale (salades variées, pate fraiche, grillade, burger maison...)  ou variété rime avec rapidité."
    ],
    "nl": [
      "Tweede restaurant van het Telebar resort, met een frisse internationale keuken (diverse salades, verse pasta, gegrild vlees, zelfgemaakte hamburger...) waar variatie en snelheid hand in hand gaan."
    ],
    "es": [
      "Segundo restaurante de la entidad Telebar, con una cocina fresca de gusto internacional (ensaladas diversas, pasta fresca, parillada, hamburguesa de casa...) donde variedad rima con rapidez."
    ]
  },
