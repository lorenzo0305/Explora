  "rdfs:comment": {
    "de": [
      "Im Herzen des Vexin empfangen Emmanuel und Frédérique ihre Gäste seit 20 Jahren mit der gleichen Herzlichkeit. Ihr Restaurant ist ein Muss: Zu jedem Anlass, ob zu Weihnachten mit der Familie, zum Valentinstag mit Verliebten oder einfach nur für eine gute Paella, trifft man sich an ihrem Tisch."
    ],
    "en": [
      "In the heart of the Vexin, Emmanuel and Frédérique have been welcoming their customers with the same warmth for 20 years. Their restaurant is a must: for any occasion, Christmas with the family, Valentine's Day for lovers, or simply a good paella, you'll find yourself at their table."
    ],
    "it": [
      "Nel cuore del Vexin, Emmanuel e Frédérique accolgono i loro clienti con lo stesso calore da 20 anni. Il loro ristorante è una tappa obbligata: per qualsiasi occasione, Natale in famiglia, San Valentino con i vostri cari o semplicemente per una buona paella, vi ritroverete alla loro tavola."
    ],
    "fr": [
      "Au coeur du Vexin, Emmanuel et Frédérique accueillent leurs clients depuis 20 ans avec la même chaleur. Leur restaurant est un incontournable : pour toute occasion, à Noël en famille, à la Saint-Valentin en amoureux, ou simplement pour une bonne paella, on se retrouve à leur table."
    ],
    "nl": [
      "In het hart van de Vexin ontvangen Emmanuel en Frédérique hun klanten al 20 jaar met dezelfde warmte. Hun restaurant is een aanrader: voor elke gelegenheid, Kerstmis met de familie, Valentijnsdag met je geliefden of gewoon een goede paella, je vindt jezelf bij hen aan tafel."
    ],
    "es": [
      "En el corazón del Vexin, Emmanuel y Frédérique acogen a sus clientes con la misma calidez desde hace 20 años. Su restaurante es una visita obligada: para cualquier ocasión, Navidad en familia, San Valentín con los tuyos o simplemente una buena paella, te encontrarás en su mesa."
    ]
  },
  "rdfs:label": {
