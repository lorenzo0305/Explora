  "rdfs:comment": {
    "de": [
      "Philéone Tissus ist eine große Auswahl an französischen Stoffen, die aus Lagerbeständen und Anproben stammen. Entdecken Sie Seidenstoffe, Leinen, Jacquard, Baumwolle, Frottierwaren für Kleidung und Möbel in dieser Boutique im 4."
    ],
    "en": [
      "Philéone Tissus offers a wide range of French fabrics from stock and trials. Discover silks, linens, jacquards, cottons and terrycloths for clothing and furnishings in this shop in Lyon's 4th arrondissement."
    ],
    "it": [
      "Philéone Tissus offre un'ampia gamma di tessuti francesi in stock e in prova. Scoprite sete, lini, jacquard, cotoni e spugne per l'abbigliamento e l'arredamento in questo negozio del 4° arrondissement di Lione."
    ],
    "fr": [
      "Philéone Tissus c'est un grand choix de tissus français provenant de stocks et d’essais. Découvrez soieries, lin, jacquard, coton, éponge pour l’habillement et l’ameublement dans cette boutique du 4ème arrondissement de Lyon."
    ],
    "es": [
      "Philéone Tissus ofrece una amplia gama de tejidos franceses de stock y de prueba. Descubra sedas, linos, jacquards, algodones y tejidos de rizo para la confección y el mobiliario en esta tienda del distrito 4 de Lyon."
    ],
    "nl": [
      "Philéone Tissus biedt een breed assortiment Franse stoffen uit voorraad en op proef. Ontdek zijde, linnen, jacquards, katoen en badstof voor kleding en meubels in deze winkel in het 4e arrondissement van Lyon."
    ]
  },
