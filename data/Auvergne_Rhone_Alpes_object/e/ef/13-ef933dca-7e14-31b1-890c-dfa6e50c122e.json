  "rdfs:comment": {
    "de": [
      "Restaurant im Herzen des Dorfes mit Panoramaterrasse.\r\nWir bieten Ihnen eine raffinierte Küche, die aus sorgfältig ausgewählten frischen und lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Restaurant in the heart of the village with a panoramic terrace.\r\nWe offer refined cuisine, prepared with carefully selected fresh, local produce."
    ],
    "it": [
      "Ristorante nel cuore del villaggio con terrazza panoramica.\r\nOffriamo una cucina raffinata preparata con prodotti freschi locali accuratamente selezionati."
    ],
    "fr": [
      "Restaurant  au cœur du village avec terrasse panoramique.\r\nNous vous proposons une cuisine raffinée, préparée à partir de produits frais et locaux soigneusement sélectionnés."
    ],
    "es": [
      "Restaurante en el corazón del pueblo con terraza panorámica.\r\nOfrecemos una cocina refinada elaborada con productos locales frescos cuidadosamente seleccionados."
    ],
    "nl": [
      "Restaurant in het hart van het dorp met panoramisch terras.\r\nWe bieden een verfijnde keuken bereid met zorgvuldig geselecteerde verse lokale producten."
    ]
  },
