  "rdfs:comment": {
    "de": [
      "Anderer Name: Magerman-Kapelle\r\nVor der heutigen Kapelle Notre Dame soll es eine Kapelle gegeben haben. Um 1900 soll Monsieur Jules Cuisset Zeuge eines ungewöhnlichen Ereignisses geworden sein."
    ],
    "en": [
      "Other name: chapelle Magerman\r\nA chapel may have existed before the present-day Notre Dame chapel. Around 1900, Monsieur Jules Cuisset witnessed an unusual event."
    ],
    "it": [
      "Altro nome: chapelle Magerman\r\nSi pensa che prima dell'attuale cappella di Notre Dame esistesse una cappella. Intorno al 1900, il signor Jules Cuisset sarebbe stato testimone di un evento insolito."
    ],
    "fr": [
      "Autre nom : chapelle Magerman\r\nUne chapelle aurait existé avant l’actuelle chapelle Notre Dame. Vers 1900, Monsieur Jules Cuisset aurait été témoin d’un événement insolite."
    ],
    "es": [
      "Otro nombre: chapelle Magerman\r\nSe cree que existió una capilla antes de la actual capilla de Notre Dame. Alrededor de 1900, el Sr. Jules Cuisset fue testigo de un acontecimiento insólito."
    ],
    "nl": [
      "Andere naam: chapelle Magerman\r\nEr zou een kapel hebben bestaan vóór de huidige Notre Dame kapel. Rond 1900 zou Jules Cuisset getuige zijn geweest van een ongewone gebeurtenis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Notre-Dame de Lourdes"
    ]
  },
