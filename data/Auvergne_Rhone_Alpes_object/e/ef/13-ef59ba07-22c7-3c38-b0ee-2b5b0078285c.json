  "rdfs:comment": {
    "de": [
      "Täglich frisch zubereitete Gerichte: Sandwiches, Focaccia, Quiches und Pizza sowie hausgemachtes Gebäck für Feinschmecker! Zum Hieressen oder Mitnehmen. Heiße und kalte Getränke sowie Eis."
    ],
    "en": [
      "Daily meals made on-site with fresh ingredients: sandwiches, focaccias, quiches and pizzas, as well as homemade pastries for the delight of food lovers!  Eat in or take away. Hot and cold drinks, and ice cream."
    ],
    "it": [
      "Spuntini preparati in loco con prodotti freschi: panini, focacce, quiche e pizze, oltre a dolci fatti in casa per deliziare la vostra voglia di dolce! Sala climatizzata o terrazza ombreggiata. Bevande calde, bibite e gelati."
    ],
    "fr": [
      "Petite restauration fabriquée sur place avec des produits frais : sandwichs, focaccias, quiches et pizzas, ainsi que pâtisseries maison pour le plaisir des gourmands ! Salle climatisée ou terrasse ombragée. Boissons chaudes, rafraîchissements et glaces."
    ],
    "nl": [
      "Dagelijks worden er ter plekke maaltijden bereid met verse ingrediënten: sandwiches, focaccia's, quiches en pizza's, en huisgemaakt gebak voor de echte fijnproevers! U kunt hier eten of afhalen. Warme en koude dranken en ijs zijn ook verkrijgbaar."
    ],
    "es": [
      "Bocadillos elaborados in situ con productos frescos: sándwiches, focaccias, quiches y pizzas, así como repostería casera para deleitar a los más golosos Sala climatizada o terraza a la sombra. Bebidas calientes, refrescos y helados."
    ]
  },
