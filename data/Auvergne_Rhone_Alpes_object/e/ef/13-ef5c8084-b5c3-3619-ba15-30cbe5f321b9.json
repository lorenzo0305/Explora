  "rdfs:comment": {
    "de": [
      "Die 1972 aus Beton errichtete zeitgenössische Architektur weist schlichte und elegante Linien auf. Im Inneren wird das einzelne, breite Kirchenschiff von einem Mittelgang erschlossen und öffnet sich zu einem originell beleuchteten Chor."
    ],
    "en": [
      "Built of concrete in 1972, this contemporary architecture presents sober and elegant lines. Inside, the single, wide nave is served by a central aisle and opens onto an originally lit choir."
    ],
    "it": [
      "Costruita in cemento nel 1972, questa architettura contemporanea presenta linee sobrie ed eleganti. All'interno, la navata unica e ampia è servita da una navata centrale e si apre su un coro originariamente illuminato."
    ],
    "fr": [
      "Construite en béton en 1972, cette architecture contemporaine présente des lignes sobres et élégantes. À l'intérieur, la nef unique et large est desservie par une allée centrale et s'ouvre sur un choeur éclairé de manière originale."
    ],
    "nl": [
      "Gebouwd in beton in 1972, presenteert deze hedendaagse architectuur sobere en elegante lijnen. Binnenin wordt het enkele, brede schip bediend door een centrale zijbeuk en komt uit op een oorspronkelijk verlicht koor."
    ],
    "es": [
      "Construida en hormigón en 1972, esta arquitectura contemporánea presenta líneas sobrias y elegantes. En el interior, la nave única y ancha está servida por una nave central y se abre a un coro originalmente iluminado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Sainte-Jeanne d'Arc"
    ]
  },
