  "rdfs:comment": {
    "de": [
      "Der See von Chênex ist ein privater Speichersee, der als geschlossenes Gewässer der Kategorie 1 eingestuft ist und vom Angelverein der Haute-Savoie verwaltet wird, der über die Fischereipachtverträge verfügt."
    ],
    "en": [
      "Lake Chênex is a private hillside reservoir classified as first class closed water and managed as a fishing lake by the Haute-Savoir Fishing Federation, which holds the fishing leases."
    ],
    "it": [
      "Il lago di Chênex è un bacino collinare privato, classificato come acqua chiusa di 1a categoria e gestito come bacino di pesca dalla Federazione di pesca dell'Alta Savoia, che detiene i diritti di pesca."
    ],
    "fr": [
      "Le plan d’eau de Chênex est une retenue collinaire privée, classée en eau close de 1ère catégorie et gérée en réservoir de pêche par la Fédération de Pêche de Haute-Savoie qui détient les baux de pêche."
    ],
    "nl": [
      "Het meer van Chênex is een privé-stuwmeer in de heuvels, geklasseerd als gesloten water van de eerste categorie en beheerd als visreservoir door de Haute-Savoie Fishing Federation, die de vispachten bezit."
    ],
    "es": [
      "El lago de Chênex es un embalse privado de ladera, clasificado como agua cerrada de 1ª categoría y gestionado como embalse de pesca por la Federación de Pesca de la Alta Saboya, que es la titular de los contratos de pesca."
    ]
  },
