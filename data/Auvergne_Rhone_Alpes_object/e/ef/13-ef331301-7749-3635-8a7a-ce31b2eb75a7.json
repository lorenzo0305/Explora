  "rdfs:comment": {
    "de": [
      "Dieses im historischen Teil von Annonay gelegene Restaurant bietet Ihnen ein Kompendium japanischer und hawaiianischer Aromen mit Sushi, Maki, Sashimi, aber auch Poke Bowl, Donburi, Chirashi und Ramen"
    ],
    "en": [
      "Located in the historical part of Annonay, this restaurant offers a condensed Japanese and Hawaiian flavors with sushi, maki, sashimi but also poke bowl, donburi, chirashi and ramen"
    ],
    "it": [
      "Situato nella parte storica di Annonay, questo ristorante offre un condensato di sapori giapponesi e hawaiani con sushi, maki, sashimi ma anche poke bowl, donburi, chirashi e ramen"
    ],
    "fr": [
      "Situé dans la partie historique d'Annonay., ce restaurant vous propose un condensé de saveurs japonaises et hawaïennes avec des sushi, maki, sashimi mais aussi des poke bowl, des donburi, des chirashi et des ramens"
    ],
    "es": [
      "Situado en el casco histórico de Annonay, este restaurante ofrece una versión condensada de sabores japoneses y hawaianos con sushi, maki, sashimi pero también poke bowl, donburi, chirashi y ramen"
    ],
    "nl": [
      "Gelegen in het historische gedeelte van Annonay, biedt dit restaurant een verkorte versie van Japanse en Hawaiiaanse smaken met sushi, maki, sashimi maar ook poke bowl, donburi, chirashi en ramen"
    ]
  },
