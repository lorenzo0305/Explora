  "rdfs:comment": {
    "de": [
      "Entdecken Sie das VAE im Herzen des Chartreuse-Massivs. Diese Strecke von 16 km und 300D+ ist für die meisten zugänglich und führt durch die zahlreichen Weiler der Gemeinde Saint-Pierre-de-Chartreuse, mit einer herrlichen Aussicht auf den Grand Som!"
    ],
    "en": [
      "Discover the VAE in the heart of the Chartreuse massif. This 16 km and 300D+ route is accessible to all and allows you to cross the numerous hamlets of the commune of Saint-Pierre-de-Chartreuse, with a magnificent view of the Grand Som!"
    ],
    "it": [
      "Scoprite la mountain bike nel cuore del massiccio della Chartreuse. Questo percorso di 16 km, 300D+, è accessibile a tutti e vi porterà attraverso le numerose frazioni di Saint-Pierre-de-Chartreuse, con una magnifica vista sul Grand Som!"
    ],
    "fr": [
      "Découvrez le VAE au cœur du massif de Chartreuse. Ce parcours de 16 km et 300D+ est accessible au plus grand nombre et permet de traverser les nombreux hameaux de la commune de Saint-Pierre-de-Chartreuse, avec une vue magnifique sur le Grand Som !"
    ],
    "nl": [
      "Ontdek mountainbiken in het hart van het Chartreuse-massief. Deze route van 16 km, 300D+, is toegankelijk voor iedereen en voert je door de vele gehuchten van Saint-Pierre-de-Chartreuse, met een prachtig uitzicht op de Grand Som!"
    ],
    "es": [
      "Descubra la bicicleta de montaña en el corazón del macizo de Chartreuse. Esta ruta de 16 km y 300D+ es accesible para todos y le llevará por las numerosas aldeas de Saint-Pierre-de-Chartreuse, ¡con una magnífica vista del Grand Som!"
    ]
  },
