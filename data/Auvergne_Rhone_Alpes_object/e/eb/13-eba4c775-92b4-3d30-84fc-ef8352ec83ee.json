  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Sauveur liegt an der nördlichen Lippe des Forêt de Saoû und weist einen der größten Höhenunterschiede im Vorland des Diois auf.\r\nTausend Höhenmeter trennen die Kieselsteine des Flusses Drôme, der zu ihren Füßen fließt, von den 3 Becs."
    ],
    "en": [
      "Situated on the northern edge of the Forêt de Saoû, the commune of Saint-Sauveur has one of the steepest gradients in the Diois foreland.\r\nA thousand meters of altitude separate the gravel of the river Drôme, which flows at its foot, from the 3 Becs."
    ],
    "it": [
      "Situato sul margine settentrionale della Forêt de Saoû, il comune di Saint-Sauveur presenta uno dei versanti più ripidi dell'avampaese di Diois.\r\nMille metri di altitudine separano la ghiaia del fiume Drôme, che scorre ai suoi piedi, dai 3 Becs."
    ],
    "fr": [
      "Installée, sur la lèvre septentrionale de la Forêt de Saoû, la commune de Saint-Sauveur présente une des plus fortes dénivellations de l’avant-pays diois.\r\nMille mètres d’altitude séparent les graviers de la rivière Drôme qui coule à ses pieds, des 3 Becs."
    ],
    "es": [
      "Situado en el extremo norte del Forêt de Saoû, el municipio de Saint-Sauveur tiene una de las pendientes más pronunciadas del antepaís de Diois.\r\nMil metros de altitud separan la grava del río Drôme, que fluye a sus pies, de los 3 Becs."
    ],
    "nl": [
      "De gemeente Saint-Sauveur ligt aan de noordelijke rand van het Forêt de Saoû en heeft een van de steilste hellingen van het voorland van de Diois.\r\nDuizend meter hoogte scheiden het grind van de Drôme, die aan de voet stroomt, van de 3 Becs."
    ]
  },
