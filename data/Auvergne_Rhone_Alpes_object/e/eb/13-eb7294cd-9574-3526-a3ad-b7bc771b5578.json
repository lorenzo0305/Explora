  "rdfs:comment": {
    "de": [
      "In einer gemütlichen Atmosphäre können Sie hier gute Pommes frites und Snacks genießen, aber auch erstklassiges Fleisch wie Entrecôte, Pavé, Black Angus? Von der Vorspeise bis zum Dessert ist für jeden Geschmack etwas dabei!"
    ],
    "en": [
      "In a warm and friendly atmosphere, come and enjoy our delicious French fries and snacks, as well as top-quality meats such as entrecôte, pavé, Black Angus? From starters to desserts, there's something for everyone!"
    ],
    "it": [
      "Venite a gustare le nostre deliziose patatine fritte e gli snack, oltre a carni di prima qualità come entrecôte, pavé, Black Angus? Dagli antipasti ai dessert, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "Dans un cadre chaleureux venez déguster les bonnes frites et la partie snack mais aussi des viandes de premier choix entrecôte, pavé, Black Angus… De l'entrée au dessert, il y en a pour tous les goûts !"
    ],
    "es": [
      "Venga y disfrute de nuestras deliciosas patatas fritas y aperitivos, así como de carnes de primera calidad como entrecot, pavé, Black Angus? De los entrantes a los postres, ¡hay para todos los gustos!"
    ],
    "nl": [
      "Kom genieten van onze heerlijke frietjes en snacks, maar ook van vlees van topkwaliteit zoals entrecote, pavé, Black Angus? Van voorgerechten tot desserts, er is voor elk wat wils!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Beuxeidienne"
    ]
  },
