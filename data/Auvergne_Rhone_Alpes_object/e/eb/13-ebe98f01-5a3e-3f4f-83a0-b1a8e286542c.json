  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Imkerei bei Lilo Nectar! Seit 2022 halte ich unsere Bienen in Ehren und verarbeite ihren Honig zu handgefertigten Köstlichkeiten. Tauchen Sie in unseren Bienenstock ein, entdecken Sie unsere einzigartigen Geschmacksrichtungen und teilen Sie unsere Leidenschaft für eine naturverträgliche Bienenzucht."
    ],
    "en": [
      "Discover beekeeping at Lilo Nectar! Since 2022, I've been cherishing our bees and transforming their honey into artisanal delights. Immerse yourself in our apiary, discover our unique flavors and share our passion for beekeeping that respects nature."
    ],
    "it": [
      "Scoprite l'apicoltura di Lilo Nectar! Dal 2022, mi prendo cura delle nostre api e trasformo il loro miele in delizie artigianali. Immergetevi nel nostro apiario, scoprite i nostri sapori unici e condividete la nostra passione per un'apicoltura rispettosa della natura."
    ],
    "fr": [
      "Découvrez l'apiculture chez Lilo Nectar ! Depuis 2022, je chéris nos abeilles et transforme leur miel en délices artisanaux. Plongez dans notre rucher, découvrez nos saveurs uniques et partagez notre passion pour une apiculture respectueuse de la nature."
    ],
    "es": [
      "¡Descubra la apicultura en Lilo Nectar! Desde 2022, cuido de nuestras abejas y transformo su miel en delicias artesanales. Sumérjase en nuestro colmenar, descubra nuestros sabores únicos y comparta nuestra pasión por una apicultura respetuosa con la naturaleza."
    ],
    "nl": [
      "Ontdek de bijenteelt bij Lilo Nectar! Sinds 2022 koester ik onze bijen en zet ik hun honing om in artisanale lekkernijen. Dompel je onder in onze bijenstal, ontdek onze unieke smaken en deel onze passie voor bijenteelt met respect voor de natuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LILO NECTAR"
    ]
  },
