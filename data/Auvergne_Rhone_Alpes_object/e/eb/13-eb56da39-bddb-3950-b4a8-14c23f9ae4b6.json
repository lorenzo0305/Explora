  "rdfs:comment": {
    "de": [
      "Im Winter am Fuße der Pisten gelegen, Sonnenterrasse, Brasserie. Gemütliche Atmosphäre nach dem Skifahren oder einem schönen Spaziergang, Abende auf Reservierung, Sonderpreise für Gruppen. Übertragung von Sportereignissen."
    ],
    "en": [
      "Located at the foot of the slopes in winter, sunny terrace, cafeteria. Warm après-ski or after a nice walk, evenings by reservation, special group prices. Broadcasting of sporting events."
    ],
    "it": [
      "Situato ai piedi delle piste in inverno, terrazza soleggiata, brasserie. Atmosfera calda dopo lo sci o una bella passeggiata, serate su prenotazione, prezzi speciali per gruppi. Trasmissione di eventi sportivi."
    ],
    "fr": [
      "Situé au pied des pistes l'hiver, terrasse ensoleillée, brasserie. Ambiance chaleureuse après-ski ou après une belle balade, soirées sur réservation, prix spéciaux groupes. Retransmission des évènements sportifs."
    ],
    "es": [
      "Situado a pie de pistas en invierno, terraza soleada, brasserie. Ambiente cálido después de esquiar o de un agradable paseo, veladas con reserva, precios especiales para grupos. Retransmisión de acontecimientos deportivos."
    ],
    "nl": [
      "Gelegen aan de voet van de pistes in de winter, zonnig terras, cafetaria. Warme après-ski of na een mooie wandeling, avonden op reservatie, speciale groepsprijzen. Uitzending van sportevenementen."
    ]
  },
