  "rdfs:comment": {
    "de": [
      "La Clairière ist von Februar bis Oktober geöffnet und bietet Ihnen ein besonderes Abenteuer inmitten der Natur und der Tiere: Ponys, Esel, Lamas, Schafe, Kaninchen, Hühner, Enten, Alpakas, Pfauen, Fasane... ..."
    ],
    "en": [
      "Open from February to October, La Clairière offers you the chance to experience a special adventure, surrounded by nature and animals: ponies, donkeys, llamas, sheep, rabbits, chickens, ducks, alpacas, peacocks, pheasants...."
    ],
    "it": [
      "Aperta da febbraio a ottobre, La Clairière vi offre la possibilità di vivere un'avventura speciale, circondati dalla natura e dagli animali: pony, asini, lama, pecore, conigli, galline, anatre, alpaca, pavoni, fagiani..."
    ],
    "fr": [
      "Ouvert de Février à Octobre, La Clairière vous propose de vivre une aventure particulière, au beau milieu de la nature et des animaux : poneys, ânes, lamas, moutons, lapins, poules, canards, alpagas, paons, faisans. ..."
    ],
    "nl": [
      "La Clairière is geopend van februari tot oktober en biedt je de kans om een bijzonder avontuur te beleven, omringd door natuur en dieren: pony's, ezels, lama's, schapen, konijnen, kippen, eenden, alpaca's, pauwen, fazanten..."
    ],
    "es": [
      "Abierto de febrero a octubre, La Clairière le ofrece la oportunidad de vivir una aventura especial, rodeado de naturaleza y animales: ponis, burros, llamas, ovejas, conejos, gallinas, patos, alpacas, pavos reales, faisanes..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ludoparc animalier La Clairière"
    ]
  },
