  "rdfs:comment": {
    "de": [
      "Geführte Besichtigung des Schlosses, freie Besichtigung des Parks. Dieses möblierte Schloss (MH) aus dem 12., 15. und 16. Jahrhundert ist die Residenz von \"Monsieur de La Palice\". Es verfügt über in Europa einzigartige Kassettendecken, eine gotische Kapelle und einen Saal mit den Flaggen der Nationen."
    ],
    "en": [
      "Guided visit of the castle ; free visit of the park. \"Monsieur de La Palice\" house, the furnished castle (HM)of the 12th, 15th and 16th centuries offers coffered ceilings (the only in Europe), a flamboyant gothic chapel and a collection of national flags."
    ],
    "it": [
      "Visita guidata del castello, visita libera del parco. Residenza di \"Monsieur de La Palice\", questo castello arredato (MH) dei secoli XII, XV e XVI presenta soffitti a cassettoni unici in Europa, una cappella gotica e una sala delle bandiere delle nazioni."
    ],
    "fr": [
      "Visite guidée du château, visite libre du parc. Résidence de \"Monsieur de La Palice\", ce château meublé (MH) des XIIe, XVe, et XVIe siècles présente des plafonds à caissons uniques en Europe, une chapelle gothique et une salle des drapeaux des nations."
    ],
    "es": [
      "Visita guiada al castillo, visita libre al parque. Residencia del \"Monsieur de La Palice\", este castillo amueblado (MH) de los siglos XII, XV y XVI cuenta con artesonados únicos en Europa, una capilla gótica y una sala de las banderas de las naciones."
    ],
    "nl": [
      "Rondleiding door het kasteel, vrij bezoek aan het park. Residentie van \"Monsieur de La Palice\", dit gemeubileerde kasteel (MH) uit de 12e, 15e en 16e eeuw heeft cassetteplafonds die uniek zijn in Europa, een gotische kapel en een zaal met de vlaggen der naties."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Palice Castle"
    ],
    "fr": [
