  "rdfs:comment": {
    "de": [
      "Pizzas zum Mitnehmen, Getränke und gute Laune!\r\n\r\nLernen Sie uns kennen, entdecken Sie unsere Pizzen und wählen Sie Ihren Favoriten!\r\nUnsere Geschichte können auch Sie schreiben, indem Sie unsere Pizzen probieren und sie mit Ihrer Familie teilen."
    ],
    "en": [
      "Pizzas to go, drinks and good mood!\r\n\r\nCome and meet us, discover our pizzas and choose your favourite!\r\nOur history is also yours to write by coming to taste our pizzas and share them with your family."
    ],
    "it": [
      "Pizze da asporto, bevande e buon umore!\r\n\r\nVieni a conoscerci, scopri le nostre pizze e scegli la tua preferita!\r\nLa nostra storia la potete scrivere anche voi, venendo ad assaggiare le nostre pizze e condividendole con la vostra famiglia."
    ],
    "fr": [
      "Pizzas à emporter, boissons et bonne humeur !\r\n\r\nVenez nous rencontrer, découvrir nos pizzas et choisir votre préférée !\r\nNotre histoire, c’est aussi à vous de l’écrire en venant goûter nos pizzas et les partager en famille."
    ],
    "es": [
      "¡Pizzas para llevar, bebidas y buen humor!\r\n\r\nVenga a conocernos, descubra nuestras pizzas y elija su favorita\r\nNuestra historia también la puedes escribir tú al venir a probar nuestras pizzas y compartirlas con tu familia."
    ],
    "nl": [
      "Afhaalpizza's, drankjes en plezier!\r\n\r\nKom kennismaken, ontdek onze pizza's en kies je favoriet!\r\nHet is aan jou om ons verhaal te schrijven door langs te komen om onze pizza's te proeven en ze te delen met je familie."
    ]
  },
  "rdfs:label": {
    "en": [
      "MY PIZZA"
    ],
    "fr": [
      "Pizzas à emporter La Source à Pizza"
    ],
    "nl": [
      "La Source à Pizza afhaalpizza's"
    ]
  },
