  "rdfs:comment": {
    "de": [
      "Ausgehend von dem Bresse-Dorf St Trivier de Courtes mit seiner Backsteinarchitektur und den mittelalterlichen Überresten, unternehmen Sie einen Ausflug auf den Wegen der Bresse und treffen auf mehrere Bauernhöfe mit sarazenischen Kaminen."
    ],
    "en": [
      "Leaving from the Bresse village of St Trivier de Courtes, with its brick architecture and medieval remains, a trip along the Bresse paths to visit several farms with Saracen chimneys."
    ],
    "it": [
      "Partendo dal villaggio bresciano di St Trivier de Courtes, con la sua architettura in mattoni e le sue vestigia medievali, si percorrono i sentieri della Bresse per ammirare alcune fattorie con camini saraceni."
    ],
    "fr": [
      "Au départ du village bressan de St Trivier de Courtes, avec son architecture en briques et ses vestiges médiévaux, une escapade sur les chemins de Bresse à la rencontre de plusieurs fermes à cheminées sarrasines."
    ],
    "nl": [
      "Vertrek vanuit het Bresse-dorp St Trivier de Courtes, met zijn bakstenen architectuur en middeleeuwse overblijfselen, en volg de Bresse-paden om een aantal boerderijen met Saraceense schoorstenen te bekijken."
    ],
    "es": [
      "Saliendo del pueblo bresés de St Trivier de Courtes, con su arquitectura de ladrillo y sus vestigios medievales, recorra los senderos de Bresse para ver varias granjas con chimeneas sarracenas."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit n°19 (red) La Bresse de St Trivier"
    ],
    "fr": [
      "Circuit VTTAE n°19 (rouge) La Bresse de St Trivier"
    ]
  },
