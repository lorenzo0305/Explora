  "rdfs:comment": {
    "de": [
      "The GUILLET Sports - SPORT 2000 - Relais MONDEVELO shop offers DH and Enduro mountain bikes for hire, as well as a workshop service."
    ],
    "en": [
      "The GUILLET Sports - SPORT 2000 - Relais MONDEVELO shop offers DH and Enduro mountain bikes for hire, as well as a workshop service."
    ],
    "it": [
      "Novità 2025: uscite in mountain bike con la supervisione di istruttori!\r\nIl negozio GUILLET Sports - SPORT 2000 - Relais MONDEVELO offre il noleggio di mountain bike da DH e Enduro e un servizio di officina."
    ],
    "fr": [
      "Nouveauté 2025 : sorties VTT encadrées par des moniteurs !\r\nLe magasin GUILLET Sports - SPORT 2000 - Relais MONDEVELO vous propose la location de VTT DH et Enduro ainsi qu'un service d'atelier."
    ],
    "es": [
      "Novedad 2025: ¡salidas en bicicleta de montaña supervisadas por monitores!\r\nLa tienda GUILLET Sports - SPORT 2000 - Relais MONDEVELO ofrece bicicletas de montaña DH y Enduro en alquiler, así como un servicio de taller."
    ],
    "nl": [
      "Nieuw in 2025: mountainbike-uitstapjes onder begeleiding van instructeurs!\r\nIn de winkel van GUILLET Sports - SPORT 2000 - Relais MONDEVELO kun je DH- en Enduro-mountainbikes huren en kun je terecht voor een workshop."
    ]
  },
