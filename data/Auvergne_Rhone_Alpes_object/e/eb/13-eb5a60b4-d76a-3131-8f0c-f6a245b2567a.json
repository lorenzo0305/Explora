  "rdfs:comment": {
    "de": [
      "Le Colibri, Ihr Café Bistro in Morzine.\r\nEin echter Ort zum Leben, warm, familiär und festlich, der eine einfache, hausgemachte Küche aus frischen und saisonalen Produkten anbietet."
    ],
    "en": [
      "Le Colibri, your cafe bistro in Morzine, to get a coffee and many more things. \r\nWhether you are with friends or family, came and join us in our cosy restaurant to taste some delicious homemade food (with some gluten free meals option) and pastries."
    ],
    "it": [
      "Le Colibri, il vostro caffè bistrot a Morzine.\r\nUn vero e proprio luogo di vita, caldo, familiare e festoso, che offre una cucina semplice e casalinga, basata su prodotti freschi e di stagione."
    ],
    "fr": [
      "Le Colibri, votre café bistro à Morzine.\r\nUn véritable lieu de vie, chaleureux, familial et festif, qui propose une cuisine simple, faite maison, à base de produits frais et de saison."
    ],
    "nl": [
      "Le Colibri, uw café bistro in Morzine.\r\nHet is een echte place to be, met een warme, gezinsvriendelijke sfeer en een feestelijke ambiance, met eenvoudige, huisgemaakte gerechten op basis van verse, seizoensgebonden producten."
    ],
    "es": [
      "Le Colibri, su café bistró en Morzine.\r\nUn verdadero lugar de vida, cálido, familiar y festivo, que ofrece una cocina sencilla y casera, basada en productos frescos y de temporada."
    ]
  },
