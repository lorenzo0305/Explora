  "rdfs:comment": {
    "de": [
      "Dorf Chavaniac-Lafayette: Schloss aus dem 14. Jahrhundert, das im 20. Jahrhundert umgebaut wurde, mit Park und Rosengarten. Kapelle in Boisseuges. Botanisches Konservatorium. Ehemalige Flussspatminen."
    ],
    "en": [
      "Village of Chavaniac-Lafayette: 14th-century château, renovated in the 20th century, with park and rose garden. Chapel at Boisseuges. Botanical conservatory. Former fluorspar mines."
    ],
    "it": [
      "Villaggio di Chavaniac-Lafayette: castello del XIV secolo, ristrutturato nel XX secolo, con parco e roseto. Cappella di Boisseuges. Conservatorio botanico. Ex miniere di fluorite."
    ],
    "fr": [
      "Village de Chavaniac-Lafayette : Château du XIVe siècle remanié au XXe siècle avec parc et roseraie. Chapelle à Boisseuges. Conservatoire botanique. Anciennes mines de spath-fluor."
    ],
    "es": [
      "Pueblo de Chavaniac-Lafayette: castillo del siglo XIV, renovado en el siglo XX, con parque y rosaleda. Capilla de Boisseuges. Conservatorio botánico. Antiguas minas de fluorita."
    ],
    "nl": [
      "Dorp Chavaniac-Lafayette: 14e-eeuws kasteel, gerenoveerd in de 20e eeuw, met park en rozentuin. Kapel van Boisseuges. Botanisch conservatorium. Voormalige vloeispaatmijnen."
    ]
  },
