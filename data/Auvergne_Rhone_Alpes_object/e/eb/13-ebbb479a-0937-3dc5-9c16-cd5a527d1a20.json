  "rdfs:comment": {
    "de": [
      "Genießen Sie spielerische Momente mit der Familie oder mit Freunden in der Mediathek. Pro Nachmittag werden zwei Sitzungen organisiert.\r\n Anmeldung erforderlich, begrenzte Plätze."
    ],
    "en": [
      "Come and enjoy some fun times with family and friends at the multimedia library. Two sessions will be organized each afternoon.\r\n Registration required, places limited."
    ],
    "it": [
      "Venite a divertirvi con la famiglia o con gli amici alla biblioteca multimediale. Ogni pomeriggio saranno organizzate due sessioni.\r\n Iscrizione obbligatoria, posti limitati."
    ],
    "fr": [
      "Venez profiter de moments ludiques en famille ou entre amis à la médiathèque. Deux sessions seront organisées chaque après-midi.\r\n Inscription obligatoire, places limitées."
    ],
    "es": [
      "Ven a pasar un rato divertido con tu familia o amigos en la biblioteca multimedia. Se organizarán dos sesiones cada tarde.\r\n Inscripción obligatoria, plazas limitadas."
    ],
    "nl": [
      "Kom gezellig met familie en vrienden naar de mediatheek. Elke middag worden er twee sessies georganiseerd.\r\n Registratie verplicht, plaatsen beperkt."
