  "rdfs:comment": {
    "de": [
      "Anlässlich der Fête de la Musique 2026 haben sich Thé Cosi und Chez les coincoins zusammengetan, um die Gruppe Fool Puppets am Sonntag, den 21. Juni um 19 Uhr auf dem Square René-Bardet zu empfangen."
    ],
    "en": [
      "To celebrate the Fête de la Musique 2026, Thé Cosi and Chez les coincoins are joining forces to welcome the group Fool Puppets on Sunday June 21 at 7pm in Square René-Bardet."
    ],
    "it": [
      "In occasione della Fête de la Musique 2026, Thé Cosi e Chez les coincoins uniscono le forze per accogliere il gruppo Fool Puppets domenica 21 giugno alle 19.00 in piazza René-Bardet."
    ],
    "fr": [
      "À l'occasion de la Fête de la Musique 2026, Thé Cosi et Chez les coincoins s'associent pour accueillir le groupe Fool Puppets le dimanche 21 juin à 19h square René-Bardet."
    ],
    "nl": [
      "Ter gelegenheid van het Fête de la Musique 2026 verwelkomen Thé Cosi en Chez les coincoins samen de groep Fool Puppets op zondag 21 juni om 19 uur op het René-Bardetplein."
    ],
    "es": [
      "Con motivo de la Fiesta de la Música 2026, Thé Cosi y Chez les coincoins se unen para recibir al grupo Fool Puppets el domingo 21 de junio a las 19:00 en la plaza René-Bardet."
    ]
  },
  "rdfs:label": {
