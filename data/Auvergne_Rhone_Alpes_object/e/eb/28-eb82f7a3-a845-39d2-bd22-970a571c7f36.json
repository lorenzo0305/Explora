  "rdfs:comment": {
    "de": [
      "In 30 Hektar Wald, in einem wunderschönen Jagdhaus im normannischen Stil, entdecken Sie die Crêperie, Saladerie an der Grenze zwischen der D644 und der D1044 zwischen Cambrai und St. Quentin."
    ],
    "en": [
      "In 30 hectares of woods, in a magnificent hunting lodge, Norman style, discover the pancake house, salad bar located at the limit D644 and D1044 between Cambrai and St Quentin."
    ],
    "it": [
      "In 30 ettari di bosco, in un magnifico castello di caccia in stile normanno, scoprite la crêperie, insalateria situata al limite della D644 e della D1044 tra Cambrai e St Quentin."
    ],
    "fr": [
      "Dans 30 hectares de bois, dans un magnifique pavillon de chasse , style normand, découvrez la crêperie, saladerie située à la limite D644 et D1044 entre Cambrai et St Quentin."
    ],
    "nl": [
      "In 30 hectare bos, in een prachtig jachthuis, Normandische stijl, ontdek de crêperie, salade bar gelegen op de grens D644 en D1044 tussen Cambrai en St Quentin."
    ],
    "es": [
      "En 30 hectáreas de bosque, en un magnífico pabellón de caza de estilo normando, descubra la crêperie, bar de ensaladas situado en el límite de la D644 y la D1044 entre Cambrai y St Quentin."
    ]
  },
