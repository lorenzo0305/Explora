  "rdfs:comment": {
    "de": [
      "Norma Loops ist ein Schlitten auf Schienen. Einmal installiert und gesichert, geht es los auf eine 900 m lange Abfahrt zwischen den Bäumen des Waldes von La Norma mit 10 Kurven, 6 Stegen, um die Straße zu überqueren, und 3 kompletten 360°-Drehungen."
    ],
    "en": [
      "Norma Loops, sled on rails. Once installed and secured, let's go for a 900 m descent between the trees of La Norma forest with 10 turns, 6 footbridges to cross the road and 3 complete 360° spins."
    ],
    "it": [
      "Norma Loops è uno slittino su rotaie. Una volta installato e fissato, si parte per una discesa di 900 metri tra gli alberi della foresta di La Norma, con 10 curve, 6 passerelle per attraversare la strada e 3 giri completi a 360°."
    ],
    "fr": [
      "Norma Loops est une luge sur rails. Une fois installé et sécurisé, c’est parti pour une descente de 900 m entre les arbres de la forêt de La Norma avec 10 virages, 6 passerelles pour franchir la route et 3 vrilles complètes à 360°."
    ],
    "es": [
      "Norma Loops es un tobogán sobre raíles. Una vez instalado y asegurado, se inicia un descenso de 900 m entre los árboles del bosque de La Norma, con 10 curvas, 6 pasarelas para cruzar la carretera y 3 giros completos de 360°."
    ],
    "nl": [
      "De \"Norma Loops\", een slee op rails. Eenmaal geïnstalleerd en vastgezet, gaat het voor een afdaling van 900 m tussen de bomen van het bos van La Norma met 10 bochten, 6 loopbruggen om de weg over te steken en 3 volledige 360° spins."
    ]
  },
  "rdfs:label": {
    "en": [
      "4 seasons sled - Norma Loops"
    ],
    "fr": [
      "Luge 4 saisons - Norma Loops"
    ],
    "nl": [
      "4-seizoenen slee - Norma Loops"
    ]
  },
