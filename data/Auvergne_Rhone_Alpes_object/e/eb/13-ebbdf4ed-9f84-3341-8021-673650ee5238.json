  "rdfs:comment": {
    "de": [
      "In diesem benutzerfreundlichen Ort erhalten Sie in einer völlig neuen Szenografie die Schlüssel zum Verständnis der Chaîne des Puys - faille de Limagne.\r\nVor Ort finden Sie alle Dienstleistungen wie Kartenverkauf, Gastronomie, Touristeninformationen und einen Shop."
    ],
    "en": [
      "Get the keys to understanding the Chaîne des Puys - faille de Limagne through a brand new scenography.\r\nOn-site ticketing, catering, tourist information and a store."
    ],
    "it": [
      "Un luogo accogliente, per avere le chiavi di lettura della Chaîne des Puys - faglia di Limagne attraverso una scenografia inedita.\r\nSul posto, tutti i servizi di biglietteria, ristorazione, informazioni turistiche e un negozio."
    ],
    "fr": [
      "Lieu convivial, obtenez les clés de compréhension sur la Chaîne des Puys - faille de Limagne au travers une toute nouvelle scénographie.\r\nSur place, tous les services de billetterie, de restauration, d’informations touristiques ainsi qu'une boutique."
    ],
    "es": [
      "Un lugar acogedor, obtenga las claves para comprender la falla Chaîne des Puys - Limagne a través de una escenografía inédita.\r\nEn el lugar, todos los servicios de venta de entradas, restauración, información turística y una tienda."
    ],
    "nl": [
      "Een vriendelijke plaats, krijg de sleutels tot het begrijpen van de Chaîne des Puys - Limagne fout door middel van een gloednieuwe scenografie.\r\nTer plaatse, alle diensten van kaartverkoop, catering, toeristische informatie en een winkel."
    ]
  },
