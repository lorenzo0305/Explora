  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4be69297-3875-30cf-9e72-c6738da930b8",
      "dc:description": {
        "de": [
          "La Pizza de Nico stellt ihre Koffer in Soissons auf, damit Sie ihre köstlichen Pizzen mit hausgemachtem Teig und sorgfältig ausgewählten Zutaten, die sie noch leckerer machen, probieren können."
        ],
        "en": [
          "La Pizza de Nico has set up shop in Soissons to serve up delicious pizzas made with homemade dough and ingredients carefully selected to make them even more delicious."
        ],
        "it": [
          "La Pizza de Nico si è insediata a Soissons per servire deliziose pizze preparate con pasta fatta in casa e ingredienti accuratamente selezionati per renderle ancora più gustose."
        ],
        "fr": [
          "La Pizza de Nico pose ses valises à Soissons pour vous faire déguster ses délicieuses pizza avec une pâte faite maison et des ingrédients choisis avec soin pour la rendre encore plus délicieuse."
        ],
        "es": [
          "La Pizza de Nico se ha instalado en Soissons para servir deliciosas pizzas elaboradas con masa casera e ingredientes cuidadosamente seleccionados para hacerlas aún más sabrosas."
        ],
        "nl": [
          "La Pizza de Nico heeft zich in Soissons gevestigd om heerlijke pizza's te serveren, gemaakt van zelfgemaakt deeg en zorgvuldig geselecteerde ingrediënten om ze nog lekkerder te maken."
        ]
      },
