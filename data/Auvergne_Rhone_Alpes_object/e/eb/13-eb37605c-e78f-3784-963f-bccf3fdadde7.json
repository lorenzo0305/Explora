  "rdfs:comment": {
    "de": [
      "Der Salon du Geek kehrt für ein neues intergalaktisches Abenteuer zurück! Ob Sie nun ein angehender Jedi, ein Forscher am Rande der Galaxis oder ein Fan der Popkultur sind, diese Ausgabe verspricht ein totales Eintauchen zwischen Technologie, Fantasie und Geselligkeit."
    ],
    "en": [
      "The Salon du Geek returns for another intergalactic adventure! Whether you're a budding Jedi, an explorer of the far reaches of the galaxy or a fan of pop culture, this year's event promises total immersion in technology, imagination and conviviality."
    ],
    "it": [
      "Il Salon du Geek torna per un'altra avventura intergalattica! Che siate Jedi in erba, esploratori della galassia o appassionati di cultura pop, l'evento di quest'anno promette un'immersione totale nella tecnologia, nell'immaginazione e nella convivialità."
    ],
    "fr": [
      "Le Salon du Geek revient pour une nouvelle aventure intergalactique ! Que vous soyez un Jedi en herbe, un explorateur des confins de la galaxie ou fan de culture pop, cette édition promet une immersion totale entre technologie, imaginaire et convivialité."
    ],
    "es": [
      "El Salón del Friki vuelve para otra aventura intergaláctica Ya seas un Jedi en ciernes, un explorador de los confines de la galaxia o un fan de la cultura pop, el evento de este año promete una inmersión total en la tecnología, la imaginación y la convivencia."
    ],
    "nl": [
      "De Salon du Geek is terug voor een nieuw intergalactisch avontuur! Of je nu een Jedi in de dop, een ontdekkingsreiziger van de verre uithoeken van het sterrenstelsel of een fan van de popcultuur bent, het evenement van dit jaar belooft een totale onderdompeling in technologie, verbeelding en gezelligheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salon du Geek : les trolls de l'espace"
    ]
  },
