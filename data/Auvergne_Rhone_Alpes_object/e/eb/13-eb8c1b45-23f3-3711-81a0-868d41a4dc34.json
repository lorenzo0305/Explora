  "rdfs:comment": {
    "de": [
      "Dorf Berbezit : Ehemalige herrschaftliche Kapelle, die Anfang des 14. Jahrhunderts zur Pfarrkirche wurde. Glasmalereien von 1934, ausgeführt von Charles Borie. Ehemaliges Schloss der Herren von Berbezit (privat). Teich."
    ],
    "en": [
      "Village of Berbezit: Former seigniorial chapel became a parish church in the early 14th century. Stained glass windows from 1934 by Charles Borie. Former château of the Lords of Berbezit (private). Pond."
    ],
    "it": [
      "Villaggio di Berbezit : Antica cappella signorile divenuta chiesa parrocchiale all'inizio del XIV secolo. Vetrate del 1934 di Charles Borie. Ex castello dei signori di Berbezit (privato). Stagno."
    ],
    "fr": [
      "Village de Berbezit : Ancienne chapelle seigneuriale devenue église paroissiale au début du XIVe siècle. Vitraux de 1934 exécutés par Charles Borie. Ancien château des seigneurs de Berbezit (privé). Étang."
    ],
    "es": [
      "Pueblo de Berbezit : Antigua capilla señorial convertida en iglesia parroquial a principios del siglo XIV. Vidrieras de 1934, obra de Charles Borie. Antiguo castillo de los señores de Berbezit (privado). Estanque."
    ],
    "nl": [
      "Dorp Berbezit : Voormalige heerlijkheidskapel die begin 14e eeuw parochiekerk werd. Gebrandschilderde ramen uit 1934 door Charles Borie. Voormalig kasteel van de heren van Berbezit (privé). Vijver."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Berbezit"
    ]
  },
