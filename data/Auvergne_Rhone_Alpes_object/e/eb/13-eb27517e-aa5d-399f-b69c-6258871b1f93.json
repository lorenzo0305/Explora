  "rdfs:comment": {
    "de": [
      "In Les Glières herrscht eine herzliche und familiäre Atmosphäre. Traditionelle &amp; savoyische Hausmannskost, gemütliche &amp; komfortable Zimmer, Salon, Bar, Kaminterrassen &amp; Sauna. Vor den Toren der Vanoise und 100m vom Skigebiet Plagne Paradiski entfernt,"
    ],
    "en": [
      "The hotel restaurant Les Glieres is located near the cable car, La Plagne Paradiski® ski area, and Vanoise National park. Family atmosphere, traditional and Savoyard cuisine, and cosy, comfortable rooms. Living room, bar, fireplace, terraces and sauna"
    ],
    "it": [
      "A Les Glières, un'atmosfera calda e familiare. Cucina tradizionale savoiarda, camere accoglienti e confortevoli, salone, bar, camino, terrazze e sauna. Alle porte della Vanoise e a 100 m dal comprensorio sciistico Plagne Paradiski,"
    ],
    "fr": [
      "Aux Glières, une ambiance chaleureuse et familiale. Une cuisine maison traditionnelle & savoyarde, des chambres douillettes & confortables, un salon, bar, cheminée terrasses & sauna. Aux portes de la Vanoise et à 100m du domaine skiable Plagne Paradiski,"
    ],
    "nl": [
      "Het hotel restaurant les Glières ligt in de vallei van de Tarentaise, in het dorp Champagny en Vanoise, in de rustige buurt van Planchamp;  verbinding met het skidomein van la Plagne/Paradiski® en in de buurt van het Parc National de la Vanoise."
    ],
    "es": [
      "En Les Glières, un ambiente cálido y familiar. Cocina casera tradicional de Saboya, habitaciones acogedoras y confortables, salón, bar, chimenea, terrazas y sauna. A las puertas de la Vanoise y a 100 m del dominio esquiable de Plagne Paradiski,"
    ]
  },
