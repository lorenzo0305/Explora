  "rdfs:comment": {
    "de": [
      "Das Auditorium soll ein dynamisches Kulturprogramm beherbergen, das von der Mediathek und den Kulturvereinen der Gemeinde getragen wird: Darstellende Kunst, Musik, Ausstellungen..."
    ],
    "en": [
      "The auditorium is intended to host a dynamic cultural programme supported by the media library and the cultural associations of the town: live shows, music, exhibitions..."
    ],
    "it": [
      "L'auditorium è destinato a ospitare un programma culturale dinamico sostenuto dalla mediateca e dalle associazioni culturali della città: spettacoli dal vivo, musica, mostre, ecc."
    ],
    "fr": [
      "L'auditorium a vocation à accueillir une programmation culturelle dynamique portée par la médiathèque et les associations culturelles de la commune : spectacle vivant, musique, expositions..."
    ],
    "nl": [
      "Het is de bedoeling dat in het auditorium een dynamisch cultureel programma wordt georganiseerd dat wordt ondersteund door de mediatheek en de culturele verenigingen van de stad: live-optredens, muziek, tentoonstellingen, enz."
    ],
    "es": [
      "El auditorio está destinado a acoger una programación cultural dinámica apoyada por la mediateca y las asociaciones culturales de la ciudad: actuaciones en directo, música, exposiciones, etc."
    ]
  },
