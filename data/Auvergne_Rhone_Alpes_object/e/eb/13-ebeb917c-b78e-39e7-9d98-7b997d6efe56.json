  "rdfs:comment": {
    "de": [
      "Deko- und Modeboutique mit einer großen Auswahl an Artikeln, die aus tierischen Materialien hergestellt werden. Pelz, Leder, Pergament, aber auch Horn, Knochen, Wollfilz..."
    ],
    "en": [
      "Factory shop and showroom offering skins, leather goods and parchment produced on site. Made-to-measure cushions, bedspreads, restoration of parchment lampshades and production of writings on parchment."
    ],
    "it": [
      "Negozio di articoli decorativi e accessori moda che offre un'ampia scelta di articoli realizzati con materiali animali. Pelliccia, pelle, pergamena ma anche corno, osso, feltro di lana..."
    ],
    "fr": [
      "Boutique déco et accessoires mode proposant un large choix d'articles confectionnés à partir de matière animale. Fourrure, cuir, parchemin mais aussi corne, os, feutre de laine..."
    ],
    "nl": [
      "Winkel in decoratieve artikelen en modeaccessoires met een ruime keuze aan artikelen van dierlijke materialen. Bont, leer, perkament maar ook hoorn, been, wolvilt..."
    ],
    "es": [
      "Tienda de artículos de decoración y complementos de moda que ofrece una amplia selección de artículos fabricados con materiales de origen animal. Piel, cuero, pergamino, pero también cuerno, hueso, fieltro de lana..."
    ]
  },
