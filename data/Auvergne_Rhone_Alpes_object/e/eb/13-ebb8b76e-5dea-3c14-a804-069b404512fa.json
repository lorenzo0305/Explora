  "rdfs:comment": {
    "de": [
      "Der Canyon de l'Infernet, der im Herzen des Chartreuse-Massivs liegt, ist ein Muss für alle, die Nervenkitzel und spektakuläre Landschaften lieben."
    ],
    "en": [
      "The Infernet canyon, nestled in the heart of the Chartreuse massif, is a must-see for thrill-seekers and lovers of spectacular scenery."
    ],
    "it": [
      "Il canyon dell'Infernet, incastonato nel cuore del massiccio della Chartreuse, è una meta imperdibile per gli amanti del brivido e dei paesaggi spettacolari."
    ],
    "fr": [
      "Le canyon de l’Infernet, niché au cœur du massif de la Chartreuse, est un site incontournable pour les amateurs de sensations fortes et de paysages spectaculaires."
    ],
    "es": [
      "El cañón de Infernet, enclavado en el corazón del macizo de Chartreuse, es una visita obligada para los amantes de las emociones fuertes y los paisajes espectaculares."
    ],
    "nl": [
      "De canyon van Infernet, genesteld in het hart van het Chartreuse-massief, is een must voor sensatiezoekers en liefhebbers van spectaculaire landschappen."
    ]
  },
  "rdfs:label": {
