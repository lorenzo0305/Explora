  "rdfs:comment": {
    "de": [
      "Wenn Sie den ausgetretenen Pfaden entfliehen und eine zeitlose Wanderung zu Pferd unternehmen, ist dies eine einfache Art, sich in den Bergen zu vergnügen, unabhängig von Ihrem Niveau."
    ],
    "en": [
      "Getting off the beaten track for a timeless horseback ride is a simple way to enjoy the mountains, whatever your level."
    ],
    "it": [
      "Allontanarsi dai sentieri battuti per una passeggiata a cavallo senza tempo è un modo semplice per godersi la montagna, a prescindere dal proprio livello."
    ],
    "fr": [
      "S'évader des sentiers battus pour une randonnée hors du temps à cheval, c'est une façon simple de se faire plaisir en montagne quelque soit votre niveau."
    ],
    "nl": [
      "Weggaan van de gebaande paden voor een tijdloze rit te paard is een eenvoudige manier om van de bergen te genieten, ongeacht je niveau."
    ],
    "es": [
      "Alejarse de los caminos trillados para dar un paseo eterno a caballo es una forma sencilla de disfrutar de las montañas, sea cual sea su nivel."
    ]
  },
