  "rdfs:comment": {
    "de": [
      "Das Telezentrum des Pays de Mauriac ist ein Service, der Arbeitnehmern, Angestellten oder Selbstständigen angeboten wird und Einzelbüros und einen Coworking-Raum zur Verfügung stellt."
    ],
    "en": [
      "The Mauriac telecenter is a service offered to workers, salaried or self-employed, providing individual offices and a coworking space."
    ],
    "it": [
      "Il telecentro del Pays de Mauriac è un servizio offerto ai lavoratori, sia dipendenti che autonomi, che mette a disposizione uffici individuali e uno spazio di coworking."
    ],
    "fr": [
      "Le télécentre du Pays de Mauriac est un service proposé aux travailleurs, salariés ou indédendants, de mise à disposition de bureaux individuels et d'un espace de coworking."
    ],
    "nl": [
      "Het telecentrum Pays de Mauriac is een dienst die wordt aangeboden aan werknemers in loondienst of zelfstandigen en voorziet in individuele kantoren en een coworkingruimte."
    ],
    "es": [
      "El telecentro de Pays de Mauriac es un servicio ofrecido a los trabajadores, ya sean asalariados o autónomos, que ofrece oficinas individuales y un espacio de coworking."
    ]
  },
