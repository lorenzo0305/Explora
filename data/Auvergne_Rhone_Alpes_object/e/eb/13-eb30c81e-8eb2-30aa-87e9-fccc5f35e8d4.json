  "rdfs:comment": {
    "de": [
      "Restaurant, Traiteur, Mahlzeiten werden nach Hause geliefert und zum Mitnehmen verkauft.\r\nBestellung vor 09:00 Uhr per Mail oder Telefon, Lieferung zwischen 10:00 und 11:30 Uhr.\r\nBestellung vor 11.00 Uhr per Telefon, Abholung ab 12.00 Uhr"
    ],
    "en": [
