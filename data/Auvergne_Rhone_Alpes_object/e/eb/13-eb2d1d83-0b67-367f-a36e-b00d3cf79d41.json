  "rdfs:comment": {
    "de": [
      "Die Maisons de services au public sind polyvalente Anlaufstellen, die die Aufgabe haben, die Nutzer in ihren Beziehungen zu den Behörden und öffentlichen Einrichtungen zu empfangen, zu orientieren und zu unterstützen."
    ],
    "en": [
      "Maisons de services au public (public services centers) are multi-purpose reception desks responsible for welcoming, guiding and assisting users in their dealings with administrations and public bodies."
    ],
    "it": [
      "Le Maisons de services au public (centri di servizi al pubblico) sono sportelli di accoglienza polifunzionali incaricati di accogliere, orientare e aiutare gli utenti nei loro rapporti con le amministrazioni e gli enti pubblici."
    ],
    "fr": [
      "Les Maisons de services au public sont des guichets d'accueil polyvalent chargés d'accueillir, d'orienter et d'aider les usagers dans leurs relations avec les administrations et les organismes publics."
    ],
    "es": [
      "Las Maisons de services au public (centros de servicios al público) son mostradores de recepción polivalentes encargados de acoger, orientar y ayudar a los usuarios en sus relaciones con las administraciones y organismos públicos."
    ],
    "nl": [
      "De Maisons de services au public (openbare dienstencentra) zijn multifunctionele receptiebalies die verantwoordelijk zijn voor het verwelkomen, begeleiden en helpen van gebruikers bij hun contacten met overheden en overheidsinstanties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de services au pulbic du Bocage Bourbonnais"
    ]
  },
