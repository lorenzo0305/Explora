  "rdfs:comment": {
    "de": [
      "Wir sind eine Fluggesellschaft, die Rundflüge über die Alpen mit dem Flugzeug anbietet. Wir bieten verschiedene Touren an, rund um den Mont Blanc oder über den Lac du Bourget und den Lac d'Annecy."
    ],
    "en": [
      "We are an airline offering sightseeing flights in the Alps. We offer several tours, around Mont Blanc or on Lac du Bourget and Lac d'Annecy."
    ],
    "it": [
      "Siamo una compagnia aerea che offre voli turistici nelle Alpi. Offriamo diversi tour, intorno al Monte Bianco o sul Lac du Bourget e sul Lac d'Annecy."
    ],
    "fr": [
      "Nous sommes une compagnie aérienne proposant des vols touristiques sur les Alpes en avion. Nous proposons plusieurs circuits, autour du Mont Blanc ou sur les Lacs du Bourget et d'Annecy."
    ],
    "nl": [
      "Wij zijn een luchtvaartmaatschappij die rondvluchten in de Alpen aanbiedt. We bieden verschillende tours aan, rond de Mont Blanc of op Lac du Bourget en Lac d'Annecy."
    ],
    "es": [
      "Somos una compañía aérea que ofrece vuelos turísticos en los Alpes. Ofrecemos varios recorridos, alrededor del Mont Blanc o en el Lac du Bourget y el Lac d'Annecy."
    ]
  },
