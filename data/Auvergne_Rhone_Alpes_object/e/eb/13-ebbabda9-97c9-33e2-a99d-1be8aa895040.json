  "rdfs:comment": {
    "de": [
      "Pizzeria zum Mitnehmen im Herzen des Dorfes Hauterives, die mit frischen Produkten arbeitet.\r\nBurger und hausgemachte Pommes frites sowie eine Auswahl an Poke Bowls."
    ],
    "en": [
      "Artisanal takeaway pizzeria located in the heart of the village of hauterives working with fresh produce.\r\nHome-made burgers and fries, plus a range of poke bowls."
    ],
    "it": [
      "Pizzeria artigianale da asporto situata nel cuore del villaggio di hauterives che lavora con prodotti freschi.\r\nHamburger e patatine fritte, oltre a una gamma di poke bowls."
    ],
    "fr": [
      "Pizzeria artisanale à emporter situé au coeur du village de hauterives travaillant avec des produits frais .\r\nBurger et frites maison ainsi qu’une gamme de poke bowl."
    ],
    "es": [
      "Pizzería artesanal para llevar situada en el corazón del pueblo de hauterives que trabaja con productos frescos.\r\nHamburguesas y patatas fritas caseras, así como una gama de cuencos poke."
    ],
    "nl": [
      "Ambachtelijke afhaalpizzeria in het hart van het dorp hauterives die met verse producten werkt.\r\nHamburger en huisgemaakte frietjes en een assortiment poke bowls."
    ]
  },
  "rdfs:label": {
