  "rdfs:comment": {
    "de": [
      "Dominique Rozan arbeitet in der Tradition des vollständig \"handgenähten\" Leders. Kreationen, Reparaturen, Verwendung von exotischen Ledern und Häuten (Krokodil, Strauß, Hai...). Einführungs-, Fortgeschrittenen- und Lernkurse."
    ],
    "en": [
      "Dominique Rozan create its pieces in the best tradition of hand-stitched. Creations, reparations, leather and exotic skins using (crocodile, ostrich, shark...). Introduction, improvment and profesional training courses possible."
    ],
    "it": [
      "Dominique Rozan lavora nella tradizione della pelle interamente cucita a mano. Creazioni, riparazioni, utilizzo di pelli esotiche (coccodrillo, struzzo, squalo, ecc.). Corsi introduttivi, avanzati e di apprendistato."
    ],
    "fr": [
      "Dominique Rozan travaille dans la tradition du cuir entièrement \"cousu main\". Créations, réparations, utilisation de cuirs et peaux exotiques (crocodile, autruche, requin...). Stages d'initiation, perfectionnement et apprentissage."
    ],
    "nl": [
      "Dominique Rozan werkt in de traditie van volledig met de hand genaaid leer. Creaties, reparaties, gebruik van exotische leersoorten en huiden (krokodil, struisvogel, haai, enz.). Cursussen voor beginners, gevorderden en leerlingen."
    ],
    "es": [
      "Dominique Rozan trabaja según la tradición del cuero cosido totalmente a mano. Creaciones, reparaciones, utilización de cueros y pieles exóticas (cocodrilo, avestruz, tiburón, etc.). Cursos de iniciación, perfeccionamiento y aprendizaje."
    ]
  },
  "rdfs:label": {
    "en": [
      "Leather workshop"
    ],
    "fr": [
      "Atelier du cuir"
    ]
  },
