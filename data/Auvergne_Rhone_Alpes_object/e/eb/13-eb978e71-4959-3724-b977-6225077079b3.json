  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine private Wellness-Kabine, die aus einer Balneotherapie für zwei Personen und einem Hammam besteht.\r\nWir bieten Ihnen auch Tee an.\r\nGenießen Sie diesen Moment des Wohlbefindens zu zweit, mit der Familie oder mit Freunden,"
    ],
    "en": [
      "We offer you a private wellness cabin with balneotherapy for two and a hammam.\r\nWe also offer tea.\r\nCome and enjoy this moment of well-being as a couple, with family or friends,"
    ],
    "it": [
      "Vi offriamo una cabina benessere privata con balneoterapia per due persone e un hammam.\r\nOffriamo anche il tè.\r\nVenite a godervi questo momento di benessere in coppia, con la famiglia o con gli amici,"
    ],
    "fr": [
      "Nous vous proposons une cabine bien être privatif composée d'une balnéothérapie pour deux personnes et un hammam. \r\nNous vous offrons également le thé,.\r\nVenez profiter de se moment de bien être en couple, en famille ou entre amis,"
    ],
    "nl": [
      "We bieden je een privé wellnesscabine met balneotherapie voor twee personen en een hamam.\r\nWe bieden ook thee aan.\r\nKom en geniet van dit moment van welzijn met z'n tweeën, met familie of vrienden,"
    ],
    "es": [
      "Le ofrecemos una cabina de bienestar privada con balneoterapia para dos personas y un hammam.\r\nTambién ofrecemos té.\r\nVenga a disfrutar de este momento de bienestar en pareja, en familia o con amigos,"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dans ma bulle - Espace bien-être"
    ]
  },
