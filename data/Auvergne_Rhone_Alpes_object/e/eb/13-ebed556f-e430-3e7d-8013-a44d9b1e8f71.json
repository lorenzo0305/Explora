  "rdfs:comment": {
    "de": [
      "Gesang im Chor. Musikalische Komödie. Erwachsene.\r\n\r\nWenn Sie gerne französische Chansons singen, erwarten wir Sie zahlreich.\r\nMan muss nur gerne singen."
    ],
    "en": [
      "Choral singing. Musical comedy. Adults.\r\n\r\nIf you like singing French songs, we look forward to welcoming you.\r\nAll you need to do is love to sing."
    ],
    "it": [
      "Canto corale. Commedia musicale. Adulti.\r\n\r\nSe vi piace cantare canzoni francesi, non vediamo l'ora di vedervi\r\nDeve solo piacerti cantare."
    ],
    "fr": [
      "Chant choral. Comédie musicale. Adultes.\r\n\r\nVous qui aimez chanter des chansons françaises, nous vous attendons nombreux. \r\nIl faut juste aimer chanter."
    ],
    "nl": [
      "Koorzang. Muzikale komedie. Volwassenen.\r\n\r\nAls je graag Franse liedjes zingt, zien we je graag.\r\nJe hoeft alleen maar van zingen te houden."
    ],
    "es": [
      "Canto coral. Comedia musical. Los adultos.\r\n\r\nSi te gusta cantar canciones francesas, te esperamos\r\nSólo tiene que gustarte cantar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chorale \"Coeur en Fête\""
    ]
  },
