  "rdfs:comment": {
    "de": [
      "Wir bereiten die Dinge auf Bestellung vor und servieren am Tisch. Die Gerichte werden in letzter Minute zubereitet und sind hausgemacht!\r\n\r\nAsiatisches Spezialitätenrestaurant (chinesisch, thailändisch und vietnamesisch)"
    ],
    "en": [
      "We prepare things to order, serve at the table, prepare dishes at the last minute and make everything homemade!\r\n\r\nAsian specialty restaurant (Chinese, Thai and Vietnamese)"
    ],
    "it": [
      "Scoprite il nostro ristorante di specialità asiatiche (cinese, tailandese e vietnamita) con piatti fatti in casa preparati à la minute!\r\nÈ possibile mangiare all'interno o da asporto."
    ],
    "fr": [
      "Découvrez notre restaurant de spécialités asiatiques (chinoises, thaï et vietnamiennes) avec des plats maisons préparés à la minute !\r\nPossibilité de manger sur place ou à emporter."
    ],
    "nl": [
      "We bereiden dingen op bestelling en serveren ze aan tafel, met op het laatste moment bereide en zelfgemaakte gerechten!\r\n\r\nAziatisch specialiteitenrestaurant (Chinees, Thais en Vietnamees)"
    ],
    "es": [
      "Descubra nuestro restaurante de especialidades asiáticas (chinas, tailandesas y vietnamitas) con platos caseros preparados al momento\r\nSe puede comer en el restaurante o para llevar."
    ]
  },
