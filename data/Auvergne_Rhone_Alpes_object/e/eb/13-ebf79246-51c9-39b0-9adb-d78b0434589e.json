  "rdfs:comment": {
    "de": [
      "Julie entwirft einzigartige Schmuckstücke aus Harz und Wildblumen, die aus biobasiertem Harz und natürlichen Bestandteilen handgefertigt werden. Jede Blume stammt aus einer nachhaltigen Ernte. Ethische, zarte und von der Natur inspirierte Kreationen."
    ],
    "en": [
      "Julie creates unique resin and wildflower jewellery, handmade using biosourced resin and natural ingredients. Each flower is carefully picked. Ethical, delicate creations inspired by nature."
    ],
    "it": [
      "Julie crea gioielli unici in resina e fiori di campo, realizzati a mano utilizzando resina di origine biologica e ingredienti naturali. Ogni fiore viene raccolto con cura. Creazioni etiche e delicate ispirate alla natura."
    ],
    "fr": [
      "Julie crée des bijoux uniques en résine et fleurs sauvages, faits main avec une résine biosourcée et des composants naturels. Chaque fleur est issue d’une cueillette raisonnée. Des créations éthiques, délicates et inspirées par la nature."
    ],
    "nl": [
      "Julie maakt unieke hars- en wildebloemenjuwelen, handgemaakt met hars van biologische oorsprong en natuurlijke ingrediënten. Elke bloem wordt zorgvuldig geplukt. Ethische, delicate creaties geïnspireerd door de natuur."
    ],
    "es": [
      "Julie crea joyas únicas de resina y flores silvestres, hechas a mano con resina de origen biológico e ingredientes naturales. Cada flor se recoge cuidadosamente. Creaciones éticas y delicadas inspiradas en la naturaleza."
    ]
  },
