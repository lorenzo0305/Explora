  "rdfs:comment": {
    "de": [
      "Der Informationspunkt in der Postagentur der Gemeinde informiert Sie über die Aktivitäten und Dienstleistungen, die in Planfoy angeboten werden: vertikale Aktivitäten (Klettersteige, Bergparcours, Klettern), Wanderungen oder Mountainbiketouren, Reitzentrum..."
    ],
    "en": [
      "Located within the municipal postal agency, the information point provides information on the activities and services offered at Planfoy: vertical activity centre (vias ferratas, mountain trails, climbing), hiking or mountain biking, riding school..."
    ],
    "it": [
      "Situato presso l'ufficio postale locale, il punto informativo fornisce informazioni sulle attività e i servizi disponibili a Planfoy: attività verticali (vie ferrate, percorsi di montagna, arrampicata), escursioni a piedi o in mountain bike, equitazione..."
    ],
    "fr": [
      "Situé au sein de l'agence postale communale, le point d'information vous renseigne sur les activités et services proposés à Planfoy: pôle d'activités verticales (vias ferratas, parcours montagne, escalade), randonnée pédestre ou VTT, centre équestre..."
    ],
    "es": [
      "Situado en la agencia postal comunal, el punto de información proporciona información sobre las actividades y servicios que se ofrecen en Planfoy: actividades verticales (vias ferratas, rutas de montaña, escalada), senderismo o bicicleta de montaña, centro ecuestre..."
    ],
    "nl": [
      "Het informatiepunt is gevestigd in het gemeentelijke postkantoor en geeft informatie over de activiteiten en diensten die in Planfoy beschikbaar zijn: verticale activiteiten (vias ferratas, bergroutes, klimmen), wandelen of mountainbiken, paardrijden..."
    ]
  },
