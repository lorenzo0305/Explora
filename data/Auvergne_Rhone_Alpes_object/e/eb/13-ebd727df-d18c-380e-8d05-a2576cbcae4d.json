  "rdfs:comment": {
    "de": [
      "Renaissance-Wohnhaus aus dem 16. Jahrhundert, ein seltenes Zeugnis der italienischen Einflüsse auf die savoyische Architektur. Die freie oder geführte Besichtigung lädt dazu ein, die Geschichte dieses Ortes vom Mittelalter bis heute zu entdecken. Während des Sommers werden Aufführungen angeboten."
    ],
    "en": [
      "The only remaining example of Italian Renaissance architecture in Haute-Savoie, the chateau has been beautifully renovated and welcomes visitors to immerse themselves in its history."
    ],
    "it": [
      "Unica testimonianza del Rinascimento italiano in Alta Savoia, questo castello, perfettamente restaurato, è un invito a scoprire il passato."
    ],
    "fr": [
      "Demeure renaissance du 16e siècle, témoignage rare des influences italiennes sur l'architecture savoyarde. La visite, libre ou guidée, invite à découvrir l'histoire de ce site du Moyen-âge à nos jours. Des spectacles sont proposés durant l'été."
    ],
    "es": [
      "Residencia renacentista del siglo XVI, raro ejemplo de las influencias italianas en la arquitectura saboyana. La visita, libre o guiada, le invita a descubrir la historia de este lugar desde la Edad Media hasta nuestros días. Se ofrecen espectáculos durante el verano."
    ],
    "nl": [
      "Een renaissancewoning uit de 16e eeuw, een zeldzaam voorbeeld van Italiaanse invloeden op de Savoyaardse architectuur. Het bezoek, gratis of met gids, nodigt u uit om de geschiedenis van deze plek te ontdekken vanaf de middeleeuwen tot heden. In de zomer worden er voorstellingen gegeven."
    ]
  },
  "rdfs:label": {
    "en": [
