  "rdfs:comment": {
    "de": [
      "Der Velay-Express bringt Sie mit dem Dampfzug im Rhythmus vergangener Zeiten von Raucoules über Tence und Le Chambon-sur-Lignon nach St-Agrève. Entdecken Sie das Plateau du Velay, die Gorges du Lignon und ihre unberührten Landschaften auf einer authentischen Reise jenseits der Zeit."
    ],
    "en": [
      "Le Velay-Express takes you on an old-fashioned steam train journey from Raucoules to St-Agrève, via Tence and Le Chambon-sur-Lignon. Discover the Velay plateau, the Gorges du Lignon and their unspoilt landscapes on an authentic, timeless journey."
    ],
    "it": [
      "Le Velay-Express vi porta in un viaggio in treno a vapore al ritmo di un tempo da Raucoules a St-Agrève, passando per Tence e Le Chambon-sur-Lignon. Scoprite l'altopiano del Velay, le Gole del Lignon e i loro paesaggi incontaminati in un viaggio autentico e senza tempo."
    ],
    "fr": [
      "Le Velay-Express vous emmène en train à vapeur au rythme d'autrefois de Raucoules à St-Agrève, via Tence et Le Chambon-sur-Lignon. Découvrez le plateau du Velay, les Gorges du Lignon et leurs paysages préservés lors d'un voyage authentique hors du temps."
    ],
    "nl": [
      "Le Velay-Express neemt je mee op een stoomtreinreis in het tempo van weleer van Raucoules naar St-Agrève, via Tence en Le Chambon-sur-Lignon. Ontdek het plateau van Velay, de Gorges du Lignon en hun ongerepte landschappen tijdens een authentieke, tijdloze reis."
    ],
    "es": [
      "Le Velay-Express le lleva en un viaje en tren de vapor al ritmo de antaño desde Raucoules hasta St-Agrève, pasando por Tence y Le Chambon-sur-Lignon. Descubra la meseta del Velay, las gargantas del Lignon y sus paisajes vírgenes en un viaje auténtico y atemporal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Voyage en Chemin de Fer Historique - Train Touristique Velay Express"
    ]
  },
