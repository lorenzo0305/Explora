  "rdfs:comment": {
    "de": [
      "Anerkannter Gasthof \"Bienvenue à la ferme\" (Willkommen auf dem Bauernhof). Landestypische Menüs auf der Grundlage von Produkten vom Bauernhof. Spezialitäten: Coq au Vin - Brathähnchen - hausgemachte Wurstwaren"
    ],
    "en": [
      "Farm inn approved \"Bienvenue à la ferme\". Country-style menus based on farm products. Specialities: coq au vin - roast chicken - grated chicken - home-made charcuterie"
    ],
    "it": [
      "Locanda di campagna con accreditamento \"Bienvenue à la ferme\". Menù in stile rustico a base di prodotti della fattoria. Specialità: coq au vin - pollo arrosto - salumi di produzione propria"
    ],
    "fr": [
      "Ferme auberge agréée \"Bienvenue à la ferme\". Menus campagnards à base de produits fermiers. Spécialités : coq au vin - poulet rôti  - charcuterie maison"
    ],
    "es": [
      "Posada rural con acreditación \"Bienvenue à la ferme\". Menús campestres a base de productos de la granja. Especialidades: coq au vin - pollo asado - charcutería casera"
    ],
    "nl": [
      "Boerderijherberg met \"Bienvenue à la ferme\" erkenning. Landelijke menu's op basis van producten van de boerderij. Specialiteiten: coq au vin - gebraden kip - huisgemaakte vleeswaren"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme Auberge du Vernat"
    ]
  },
