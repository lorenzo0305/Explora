  "rdfs:comment": {
    "de": [
      "Séverine und Pierre-Francis Lantelme empfangen Sie für Ihre Mahlzeiten mit lokalen Produkten und einem qualitativ hochwertigen Service.\r\nMittags von Montag bis Freitag geöffnet.\r\nFreitag- und Samstagabend auf Reservierung."
    ],
    "en": [
      "Séverine and Pierre-Francis Lantelme welcome you for your meals with local products and quality service.\r\nOpen for lunch Monday to Friday.\r\nFriday and Saturday evenings by reservation."
    ],
    "it": [
      "Séverine e Pierre-Francis Lantelme vi accolgono per i vostri pasti con prodotti locali e un servizio di qualità.\r\nAperto a pranzo dal lunedì al venerdì.\r\nVenerdì e sabato sera su prenotazione."
    ],
    "fr": [
      "Séverine et Pierre-Francis Lantelme vous accueillent pour vos repas avec des produits locaux et un service de qualité.\r\nOuvert le midi du Lundi au Vendredi. \r\nVendredi et Samedi soir sur réservation."
    ],
    "es": [
      "Séverine y Pierre-Francis Lantelme le dan la bienvenida para sus comidas con productos locales y un servicio de calidad.\r\nAbierto para el almuerzo de lunes a viernes.\r\nViernes y sábados por la noche con reserva previa."
    ],
    "nl": [
      "Séverine en Pierre-Francis Lantelme heten u welkom voor uw maaltijden met lokale producten en kwaliteitsservice.\r\nGeopend voor lunch van maandag tot vrijdag.\r\nVrijdag- en zaterdagavond op afspraak."
    ]
  },
  "rdfs:label": {
