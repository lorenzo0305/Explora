  "rdfs:comment": {
    "de": [
      "Was haben das MoMa in New York, die Peggy-Guggenheim-Stiftung in Venedig und die Villa Medici in Rom gemeinsam? Das MAMC hat ihnen allen Werke ausgeliehen."
    ],
    "en": [
      "What do the MoMa in New York,  the Peggy-Guggenheim Collection in Venice and the Villa Medicis in Rome have in common? The MAMC has lent works to all of them."
    ],
    "it": [
      "Che cosa hanno in comune il MoMa di New York, la Fondazione Peggy-Guggenheim di Venezia e Villa Medici a Roma? Il MAMC ha prestato opere a tutti loro."
    ],
    "fr": [
      "Le point commun entre le MoMa de New York, la fondation Peggy-Guggenheim à Venise et la Villa Médicis à Rome ? Le MAMC leur a tous prêté des oeuvres."
    ],
    "es": [
      "¿Qué tienen en común el MoMa de Nueva York, la Fundación Peggy-Guggenheim de Venecia y la Villa Médicis de Roma? El MAMC ha prestado obras a todas ellas."
    ],
    "nl": [
      "Wat hebben het MoMa in New York, de Peggy-Guggenheim Foundation in Venetië en de Villa Medici in Rome met elkaar gemeen? Het MAMC heeft aan allemaal werken uitgeleend."
