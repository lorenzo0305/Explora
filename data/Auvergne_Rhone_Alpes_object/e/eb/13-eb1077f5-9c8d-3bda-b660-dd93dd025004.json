  "rdfs:comment": {
    "de": [
      "Familienbetrieb (7. Generation), der seit 30 Jahren biologisch wirtschaftet. Entdeckung des Weinbergs und des Kellers; Verkostung.\r\nAußergewöhnliche Umgebung gegenüber dem Mt Ventoux."
    ],
    "en": [
      "Family business (7th generation), organic for 30 years. Discovery of the vineyard and the cellar; tasting.\r\nExceptional setting facing the Mt Ventoux."
    ],
    "it": [
      "Azienda familiare (7a generazione), biologica da 30 anni. Scoperta del vigneto e della cantina; degustazione.\r\nAmbiente eccezionale di fronte al Monte Ventoux."
    ],
    "fr": [
      "Exploitation familiale (7ème génération) en bio depuis 30 ans. Découverte du vignoble et de la cave; dégustation.\r\nCadre exceptionnel face au Mt Ventoux."
    ],
    "es": [
      "Empresa familiar (7ª generación), ecológica desde hace 30 años. Descubrimiento del viñedo y de la bodega; degustación.\r\nEntorno excepcional frente al Monte Ventoux."
    ],
    "nl": [
      "Bezoek aan de wijngaard met gids die vertelt over de wijn en de biologische landbouw. Bezoek aan de wijnkelder en gratis proeverij. Minimaal 10 personen. Duur van het bezoek: een half uur. Op zondag geopend."
    ]
  },
