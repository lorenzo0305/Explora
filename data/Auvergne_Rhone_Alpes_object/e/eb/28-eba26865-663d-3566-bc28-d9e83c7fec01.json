  "rdfs:comment": {
    "de": [
      "Wir haben uns auf die Getreideproduktion in Flandern spezialisiert - als Spezialisten in der Müllerei verpflichten wir uns, unseren Kunden Produkte von hoher Qualität anzubieten. Herstellung von Trockennudeln aus auf dem Hof produziertem Halbvollkornmehl"
    ],
    "en": [
      "We are specialized in the production of cereals in Flanders - specialists in milling, we are committed to offering high quality products to our customers. Production of dry pasta made with semi wholemeal flour produced on the farm"
    ],
    "it": [
      "Siamo specializzati nella produzione di cereali nelle Fiandre - specialisti nella macinazione, ci impegniamo a offrire prodotti di alta qualità ai nostri clienti. Produzione di pasta secca con farina semi-integrale prodotta in azienda"
    ],
    "fr": [
      "Nous sommes spécialisés en production de céréales en Flandres -  spécialistes en meunerie, nous nous engageons à proposer des produits de grande qualité à nos clients. Production de pâtes sèches faites avec de la farine semi complète produite sur la ferme"
    ],
    "nl": [
      "Wij zijn gespecialiseerd in graanproductie in Vlaanderen - specialisten in het malen, wij zetten ons in om onze klanten producten van hoge kwaliteit aan te bieden. Productie van droge pasta met halfvolkorenmeel van de boerderij"
    ],
    "es": [
      "Estamos especializados en la producción de cereales en Flandes - especialistas en molinería, nos comprometemos a ofrecer productos de alta calidad a nuestros clientes. Producción de pasta seca elaborada con harina semiintegral producida en la granja"
    ]
  },
