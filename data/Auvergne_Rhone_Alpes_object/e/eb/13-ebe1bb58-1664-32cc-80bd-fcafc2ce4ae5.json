  "rdfs:comment": {
    "de": [
      "Hervé Reynaud bringt die Wärme und Schönheit des Holzes, das er liebt, in Ihr Zuhause und realisiert alle Ihre Projekte: Möbel, Küche, Badezimmer, Aufbewahrungsmöglichkeiten ..."
    ],
    "en": [
      "Hervé Reynaud craftsman brings the warmth and beauty of the wood he loves in your home by carrying out all your projects: furniture, kitchen, bathroom, storage ..."
    ],
    "it": [
      "Hervé Reynaud, artigiano, porta il calore e la bellezza del legno che ama nella vostra casa, realizzando tutti i vostri progetti: mobili, cucine, bagni, contenitori ..."
    ],
    "fr": [
      "Hervé Reynaud artisan apporte la chaleur et la beauté du bois qu'il affectionne dans votre maison en réalisant tous vos projets : meubles, cuisine, salle de bain, rangements ..."
    ],
    "es": [
      "Hervé Reynaud, artesano, lleva a su casa la calidez y la belleza de la madera que tanto le gusta, realizando todos sus proyectos: muebles, cocina, baño, almacenamiento..."
    ],
    "nl": [
      "Hervé Reynaud, ambachtsman, brengt de warmte en schoonheid van hout waar hij van houdt bij u thuis door al uw projecten uit te voeren: meubels, keuken, badkamer, opbergruimte ..."
    ]
  },
