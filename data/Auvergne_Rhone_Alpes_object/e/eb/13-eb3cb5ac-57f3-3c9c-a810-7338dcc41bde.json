  "rdfs:comment": {
    "de": [
      "Handwerkliche Konditorei - Coffee Shop - Restaurant.\r\nIn einem gemütlichen Art-Déco-Rahmen können Sie in unserem Wohnzimmer oder in unserem Garten am Wasser unsere hausgemachten süßen und herzhaften Spezialitäten genießen.\r\nDurchgehender Service vor Ort und zum Mitnehmen."
    ],
    "en": [
      "Artisanal pastry and coffee shop. In an idyllic art deco setting, come and enjoy our homemade specialities and delicacies on our patio or in our garden by the water. To take away or to taste on the spot."
    ],
    "it": [
      "Pasticceria artigianale - caffetteria - ristorante.\r\nIn un accogliente ambiente art déco, gustate le nostre specialità dolci e salate fatte in casa nel nostro salone o nel giardino sull'acqua.\r\nServizio continuo in loco e da asporto."
    ],
    "fr": [
      "Pâtisserie artisanale - coffee shop - restaurant. \r\nDans un cadre cosy art déco, dégustez dans notre salon ou notre jardin au bord de l'eau nos spécialités salées et sucrées faites maison. \r\nService continu sur place et à emporter."
    ],
    "es": [
      "Pastelería artesanal - cafetería - restaurante.\r\nEn un acogedor ambiente art déco, disfrute de nuestras especialidades caseras dulces y saladas en nuestro salón o en el jardín junto al agua.\r\nServicio continuo in situ y para llevar."
    ],
    "nl": [
      "Ambachtelijke patisserie - koffiebar - restaurant.\r\nGeniet in een gezellig art-deco decor van onze huisgemaakte zoete en hartige specialiteiten in onze lounge of tuin aan het water.\r\nContinue service ter plaatse en om mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Cèdre Doré"
    ]
  },
