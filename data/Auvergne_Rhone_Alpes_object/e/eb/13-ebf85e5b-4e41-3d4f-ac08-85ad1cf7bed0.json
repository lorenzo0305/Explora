  "rdfs:comment": {
    "de": [
      "Dieses kreative Kunsthandwerksatelier im Süden der Ardèche liegt am Rande der Cevennen in der Gemeinde Chassiers. Rich Art Créations entführt Sie mit seinen Werken in eine Welt voller Gelassenheit und Wohlbefinden. Lampen aus Kalebassen und Kokosnüssen, Schmuck, Vasen..."
    ],
    "en": [
      "Artisan-creative workshop in the southern Ardèche at the gateway to the Cévènnes in the commune of Chassiers. Rich Art Créations will take you into a world of serenity and well-being. Calabash and coconut lamps, jewellery, vases..."
    ],
    "it": [
      "Laboratorio artigianale-creativo nell'Ardèche meridionale, alle porte delle Cévènnes, nel comune di Chassiers. Rich Art Créations vi porterà in un mondo di serenità e benessere. Lampade in calabash e cocco, gioielli, vasi..."
    ],
    "fr": [
      "Atelier artisan créateur du Sud Ardèche situé aux portes des Cévènnes  sur la commune de Chassiers. Rich Art Créations vous emmènera par ses oeuvres dans un monde rempli de sérénité et de bien-être. Lampes en calebasse et noix de coco, bijoux, vases..."
    ],
    "es": [
      "Taller artesano-creativo en el sur de Ardèche, a las puertas de Cévènnes, en la comuna de Chassiers. Rich Art Créations le transportará a un mundo de serenidad y bienestar. Lámparas de calabaza y coco, joyas, jarrones..."
    ],
    "nl": [
      "Ambachtelijk-creatief atelier in de zuidelijke Ardèche aan de poort van de Cévènnes in de gemeente Chassiers. Rich Art Créations neemt je mee naar een wereld van rust en welzijn. Kalebas- en kokosnootlampen, sieraden, vazen..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rich Art Créations"
    ]
  },
