  "rdfs:comment": {
    "de": [
      "In einem einfachen und freundlichen Rahmen bietet Pause Sauna nach vorheriger Reservierung Gruppen- oder Privatsaunagänge an. Im Anschluss an diese Sitzungen kann eine ayurvedische Massage für Frauen und Transfrauen angeboten werden."
    ],
    "en": [
      "In a simple, friendly setting, Pause Sauna offers group or private sauna sessions on reservation. These sessions can be followed by an Ayurvedic massage for women and trans women."
    ],
    "it": [
      "In un ambiente semplice e accogliente, Pause Sauna offre sessioni di sauna di gruppo o private su prenotazione. Queste sedute possono essere seguite da un massaggio ayurvedico per donne e trans."
    ],
    "fr": [
      "Dans un cadre simple et convivial, Pause Sauna propose des séances collectives ou privatives de sauna sur réservation. Ces séances peuvent être suivies d'un massage ayurvédique pour les femmes et femmes trans."
    ],
    "nl": [
      "In een eenvoudige, vriendelijke omgeving biedt Pause Sauna op afspraak sauna-sessies voor groepen of privé-sessies. Deze sessies kunnen worden gevolgd door een Ayurvedische massage voor vrouwen en transvrouwen."
    ],
    "es": [
      "En un ambiente sencillo y acogedor, Pause Sauna ofrece sesiones de sauna en grupo o privadas previa concertación. Estas sesiones pueden ir seguidas de un masaje ayurvédico para mujeres y mujeres trans."
    ]
  },
