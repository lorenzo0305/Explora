  "rdfs:comment": {
    "de": [
      "Willkommen in der Pizzeria Chez Pedro\r\nFrische Produkte aus der Region, ein hausgemachter Teig, eine Pizza, die ganz einfach vor Ihren Augen auf Holzfeuer gebacken wird: Das ist das Motto der Pizzeria Chez Pedro."
    ],
    "en": [
      "Welcome to Chez Pedro Pizzeria \r\nFresh products selected from the region, home-made dough, a pizza made in front of you in all simplicity, cooking over a wood fire: this is the motto of the Pizzeria Chez Pedro."
    ],
    "it": [
      "Benvenuti alla Pizzeria Chez Pedro\r\nProdotti freschi selezionati dalla regione, impasto fatto in casa, una pizza fatta davanti a voi, cotta sul fuoco a legna: questo è il motto della Pizzeria Chez Pedro."
    ],
    "fr": [
      "Bienvenue à la Pizzeria Chez Pedro \r\nDes produits frais sélectionnés dans la région , une pâte faite maison, une pizza élaborée devant vous en toute simplicité  une cuisson au feu de bois : telle est la devise de la Pizzeria Chez Pedro ."
    ],
    "nl": [
      "Welkom bij Pizzeria Chez Pedro\r\nVerse producten uit de streek, zelfgemaakt deeg, een pizza voor je neus bereid op houtvuur: dat is het motto van Pizzeria Chez Pedro."
    ],
    "es": [
      "Bienvenido a la Pizzería Chez Pedro\r\nProductos frescos seleccionados de la región, masa casera, una pizza hecha delante de usted, cocinada al fuego de leña: éste es el lema de la Pizzeria Chez Pedro."
    ]
  },
