  "rdfs:comment": {
    "de": [
      "Entdecken Sie Green Paradise, Ihr Fachgeschäft für CBD. Blumen, Harze, Samen, Kräutertees, Öle, Süßigkeiten, Getränke, Tierprodukte... es gibt alles, was Sie wollen bei Green Paradise."
    ],
    "en": [
      "Discover Green Paradise, your CBD specialist store. Flowers, resins, seeds, herbal teas, oils, candies, drinks, pet products... you'll find it all at Green Paradise."
    ],
    "it": [
      "Scoprite Green Paradise, il vostro negozio specializzato in CBD. Fiori, resine, semi, tisane, oli, caramelle, bevande, prodotti per animali... da Green Paradise c'è tutto quello che desiderate"
    ],
    "fr": [
      "Découvrez Green paradise votre magasin spécialisé dans la CBD. Fleurs, résines, Graines, tisanes, huiles, Bonbons, boissons, produits animaliers.. il y a tout ce que vous voulez à Green Paradise"
    ],
    "nl": [
      "Ontdek Green Paradise, jouw CBD speciaalzaak. Bloemen, harsen, zaden, kruidenthee, oliën, snoep, drankjes, producten voor huisdieren... er is van alles te vinden bij Green Paradise."
    ],
    "es": [
      "Descubra Green Paradise, su tienda especializada en CBD. Flores, resinas, semillas, infusiones, aceites, caramelos, bebidas, productos para mascotas... en Green Paradise hay de todo"
    ]
  },
