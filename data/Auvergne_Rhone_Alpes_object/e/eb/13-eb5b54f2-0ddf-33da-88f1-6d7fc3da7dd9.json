  "rdfs:comment": {
    "de": [
      "Produkte direkt von Erzeugern aus der Region kaufen und dabei an einer solidarischen Initiative teilnehmen? Das ist das Prinzip der \"Paniers du Quartier\" in Romans-sur-Isère.\r\nDrei Tarife, um qualitativ hochwertige Lebensmittel für alle zugänglich zu machen."
    ],
    "en": [
      "Buying produce direct from local producers while taking part in a solidarity initiative? That's the principle behind Paniers du Quartier de Romans-sur-Isère.\r\nThree prices to make quality food accessible to all."
    ],
    "it": [
      "Acquistare prodotti direttamente dai produttori locali e partecipare a un'iniziativa comunitaria? Questo è il principio alla base dei Paniers du Quartier di Romans-sur-Isère.\r\nTre prezzi per rendere il cibo di qualità accessibile a tutti."
    ],
    "fr": [
      "Acheter des produits en direct des producteur.rice.s du territoire en participant à une initiative solidaire ? C'est le principe des Paniers du Quartier de Romans-sur-Isère.\r\nTrois tarifs pour rendre accessible une alimentation de qualité à tous et toutes."
    ],
    "es": [
      "¿Comprar productos directamente a los productores locales y participar en una iniciativa comunitaria? Ese es el principio de los Paniers du Quartier de Romans-sur-Isère.\r\nTres precios para que la comida de calidad esté al alcance de todos."
    ],
    "nl": [
      "Producten rechtstreeks van lokale producenten kopen en deelnemen aan een gemeenschapsinitiatief? Dat is het principe achter de Paniers du Quartier in Romans-sur-Isère.\r\nDrie prijzen om kwaliteitsvoeding voor iedereen toegankelijk te maken."
    ]
  },
