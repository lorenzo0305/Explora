  "rdfs:comment": {
    "de": [
      "Restaurant-Bar-Saloon im Herzen des Ortes, gemütlicher und geselliger Rahmen, Restaurantservice nonstop am Fuße der Pisten und des Sessellifts von Charmasson. Wir bieten Ihnen auch Konzerte und einen Billard- und Spielbereich."
    ],
    "en": [
      "Restaurant-Bar-Saloon in the heart of the resort, warm and friendly setting, non-stop catering service at the foot of the slopes and the Charmasson chairlift. We also offer live music and a billiards and games area."
    ],
    "it": [
      "Ristorante-Bar-Saloon nel cuore della località, un ambiente caldo e accogliente, servizio di ristorazione non-stop ai piedi delle piste e della seggiovia Charmasson. Offriamo anche musica dal vivo e un'area giochi e biliardo."
    ],
    "fr": [
      "Restaurant-Bar-Saloon au cœur de la station, cadre chaleureux et convivial, service de restauration non-stop au pied des pistes et du télésiège de Charmasson. Nous vous proposons également des concerts et un espace billard et jeux."
    ],
    "es": [
      "Restaurante-Bar-Salón en el corazón de la estación, un ambiente cálido y acogedor, servicio de restauración ininterrumpido a pie de pistas y del telesilla Charmasson. También ofrecemos música en directo y una zona de billar y juegos."
    ],
    "nl": [
      "Restaurant-Bar-Saloon in het hart van het resort, een warme en vriendelijke omgeving, non-stop restaurantservice aan de voet van de pistes en de Charmasson stoeltjeslift. We bieden ook livemuziek en een biljart- en spelletjesruimte."
    ]
  },
