  "rdfs:comment": {
    "de": [
      "Mit dem Verleih seiner mobilen Kletterwand bietet Ihnen REV'ASION Klettern in der Nähe, mit oder ohne Betreuung, für eine Veranstaltung, ein Freizeitvergnügen oder als pädagogische Unterstützung während eines Schulzyklus."
    ],
    "en": [
      "With the rental of its Mobile Climbing Wall, REV'ASION offers you local climbing, with or without supervision, for an event, a leisure activity or as a teaching aid for a school cycle."
    ],
    "it": [
      "Noleggiando la sua parete d'arrampicata mobile, REV'ASION può offrirvi un'arrampicata in loco, con o senza supervisione, per un evento, un'attività ricreativa o come supporto didattico per un ciclo scolastico."
    ],
    "fr": [
      "Avec la location de son Mur d'ecalade Mobile, REV'ASION vous propose une escalade de proximité, avec ou sans encadrement, pour une manifestation, un loisir ou pour un support pédagogique sur un cycle scolaire."
    ],
    "nl": [
      "Door het verhuren van de mobiele klimwand kan REV'ASION u lokaal klimmen aanbieden, met of zonder begeleiding, voor een evenement, een vrijetijdsbesteding of als leermiddel voor een schoolcyclus."
    ],
    "es": [
      "Alquilando su rocódromo móvil, REV'ASION puede ofrecerle escalada local, con o sin supervisión, para un evento, una actividad de ocio o como ayuda pedagógica para un ciclo escolar."
    ]
  },
