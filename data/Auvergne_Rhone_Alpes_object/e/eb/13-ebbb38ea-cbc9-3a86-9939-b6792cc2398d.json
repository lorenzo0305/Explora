  "rdfs:comment": {
    "de": [
      "Inmitten der majestätischen Berge gelegen, bietet der Basketballplatz des Ortes ein einzigartiges Erlebnis für Liebhaber dieser dynamischen Sportart. Ausrüstung kann im \"Comptoir des Activités\" ausgeliehen werden."
    ],
    "en": [
      "Set in the heart of the majestic mountains, the resort's basketball court offers a unique experience for fans of this dynamic sport. Equipment can be borrowed from the Activities Desk."
    ],
    "it": [
      "Nel cuore delle maestose montagne, il campo da basket del resort offre un'esperienza unica agli appassionati di questo sport dinamico. L'attrezzatura può essere presa in prestito dal Comptoir des Activités."
    ],
    "fr": [
      "Situé au cœur des majestueuses montagnes, le terrain de basket de la station offre une expérience unique aux amateurs de ce sport dynamique. Possibilité de prêt de matériel au Comptoir des Activités."
    ],
    "es": [
      "Situada en el corazón de las majestuosas montañas, la cancha de baloncesto de la estación ofrece una experiencia única a los aficionados a este dinámico deporte. El equipo se puede tomar prestado en el Comptoir des Activités."
    ],
    "nl": [
      "Het basketbalveld van het resort ligt midden in de majestueuze bergen en biedt een unieke ervaring voor fans van deze dynamische sport. Materiaal kan worden geleend bij het Activiteitencentrum."
    ]
  },
  "rdfs:label": {
    "en": [
      "Basketball court"
    ],
