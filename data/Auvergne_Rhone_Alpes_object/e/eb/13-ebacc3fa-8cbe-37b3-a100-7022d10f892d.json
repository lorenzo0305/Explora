  "rdfs:comment": {
    "de": [
      "Versteckt in den Herzen von vier Einrichtungen des Resorts befinden sich fünf majestätische Betonschornsteine, die von Marcel Breuer und seinem Team entworfen wurden."
    ],
    "en": [
      "Hidden in 4 of the resort's establishments are 5 majestic concrete chimneys designed by Marcel Breuer and his team."
    ],
    "it": [
      "Nel cuore di 4 stabilimenti del resort sono nascoste 5 maestose ciminiere in cemento progettate da Marcel Breuer e dal suo team."
    ],
    "fr": [
      "Cachée au cœur de 4 établissements de la station se trouvent 5 cheminées majestueuses en béton conçues par Marcel Breuer et son équipe."
    ],
    "nl": [
      "Verborgen in het hart van 4 van de vestigingen van het resort liggen 5 majestueuze betonnen schoorstenen, ontworpen door Marcel Breuer en zijn team."
    ],
    "es": [
      "Escondidas en el corazón de 4 de los establecimientos del complejo se encuentran 5 majestuosas chimeneas de hormigón diseñadas por Marcel Breuer y su equipo."
    ]
  },
