  "rdfs:comment": {
    "de": [
      "Beeinflusst von japanischer Keramik stelle ich Gebrauchsgegenstände aus Steinzeug her und versuche, in meiner Arbeit Sanftheit und Rustikalität zu vereinen, indem ich die raue Seite der Erde bewahre."
    ],
    "en": [
      "Influenced by Japanese ceramics, I make utilitarian objects in stoneware, and I try to combine softness and rusticity in my work, preserving the raw aspect of the clay."
    ],
    "it": [
      "Influenzata dalla ceramica giapponese, realizzo oggetti utilitari in gres e cerco di combinare morbidezza e rusticità nel mio lavoro, preservando l'aspetto grezzo dell'argilla."
    ],
    "fr": [
      "Influencée par la céramique japonaise, je réalise des objets utilitaires en grès, et j'essaye d'allier dans mon travail douceur et rusticité, en préservant le côté brut de la terre."
    ],
    "es": [
      "Influenciada por la cerámica japonesa, elaboro objetos utilitarios en gres, e intento combinar suavidad y rusticidad en mi trabajo, conservando el aspecto bruto de la arcilla."
    ],
    "nl": [
      "Beïnvloed door Japanse keramiek, maak ik gebruiksvoorwerpen van steengoed en probeer ik zachtheid en rustiekheid in mijn werk te combineren, terwijl ik het rauwe aspect van de klei behoud."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Wabi Sabine Céramique"
    ]
  },
