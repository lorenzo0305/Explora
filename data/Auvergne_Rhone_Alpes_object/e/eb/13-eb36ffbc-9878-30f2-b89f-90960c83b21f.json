  "rdfs:comment": {
    "de": [
      "Der Standort La Scia wird vom \"Comité départementale de vol libre\", den Gleitschirmschulen \"Les Gens d'Air\" und \"Volez\" sowie dem Verein \"Air Gus Vol libre\" verwaltet."
    ],
    "en": [
      "The site of Scia is managed by the departmental committee of free flight, the paragliding schools \"Les Gens d'Air\" and \"Volez\" as well as the club \"Air Gus Vol libre\"."
    ],
    "it": [
      "Il sito di Scia è gestito dal comitato dipartimentale di volo libero, dalle scuole di parapendio \"Les Gens d'Air\" e \"Volez\" e dal club \"Air Gus Vol libre\"."
    ],
    "fr": [
      "Le site de la Scia est géré par le comité départementale de vol libre, les écoles de parapentes \"Les Gens d'Air\" et \"Volez\" ainsi que le club \"Air Gus Vol libre\"."
    ],
    "nl": [
      "Het terrein van Scia wordt beheerd door het departementale comité voor vrije vluchten, de paragliding scholen \"Les Gens d'Air\" en \"Volez\" en de club \"Air Gus Vol libre\"."
    ],
    "es": [
      "El sitio de Scia está gestionado por el comité departamental de vuelo libre, las escuelas de parapente \"Les Gens d'Air\" y \"Volez\", así como el club \"Air Gus Vol libre\"."
    ]
  },
