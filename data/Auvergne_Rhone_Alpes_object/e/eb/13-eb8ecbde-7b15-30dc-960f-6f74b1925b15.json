  "rdfs:comment": {
    "de": [
      "Philippe Caverivière, der Komiker, der auf RTL bekannt ist, wo er jeden Morgen sein scharfes Auge auf die aktuellen Ereignisse richtet, wird im Mai 2026 in Saint Paul sein, wo er uns seine neue Show präsentieren wird."
    ],
    "en": [
      "Philippe Caverivière, the well-known humorist on RTL, where he puts his sharp eye on current affairs every morning, will be in Saint Paul in May 2026 to present his new show."
    ],
    "it": [
      "Philippe Caverivière, il noto comico di RTL che ogni mattina mette il suo sguardo acuto sull'attualità, sarà a Saint Paul nel maggio 2026 per presentare il suo nuovo spettacolo."
    ],
    "fr": [
      "Philippe Caverivière, l'humoriste bien connu sur RTL où il pose son œil aiguisé sur l'actualité chaque matin, sera à Saint Paul en mai 2026 où il nous présentera son nouveau spectacle."
    ],
    "es": [
      "Philippe Caverivière, el conocido humorista de RTL donde cada mañana pone su agudo ojo en la actualidad, estará en Saint Paul en mayo de 2026 para presentar su nuevo espectáculo."
    ],
    "nl": [
      "Philippe Caverivière, de bekende komiek op RTL waar hij elke ochtend zijn scherpe blik op de actualiteit richt, komt in mei 2026 naar Saint Paul om zijn nieuwe show te presenteren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Philippe Caverivière : Tu crois que c'est une bonne idée ?"
    ]
  },
