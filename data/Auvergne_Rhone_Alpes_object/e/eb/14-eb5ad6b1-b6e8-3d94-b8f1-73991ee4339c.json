      "dc:description": {
        "de": [
          "Tägliche Anlieferung von Obst und Gemüse Große Auswahl an Suppen Konfitüren, Kompotte und Coulis, Herstellung aus unseren frischen Produkten\nObstkörbe auf Bestellung."
        ],
        "en": [
          "Daily arrival of fruit and vegetables Large selection of soups Jams, compotes and coulis, made from our own fresh produce\nFruit baskets to order."
        ],
        "it": [
          "Fornitura giornaliera di frutta e verdura Ampia scelta di zuppe Marmellate, composte e coulis, preparate con i nostri prodotti freschi\nCesti di frutta su ordinazione."
        ],
        "fr": [
          "Arrivage journalier de fruit et légumes Grand choix de soupes Confitures, compotes et coulis, Fabrication issue de nos produits frais\nCorbeilles de fruits sur commande."
        ],
        "es": [
          "Suministro diario de frutas y verduras Amplia selección de sopas Mermeladas, compotas y coulis, elaborados con nuestros propios productos frescos\nCestas de fruta por encargo."
        ],
        "nl": [
          "Dagelijkse aanvoer van fruit en groenten Ruime keuze uit soepen Jams, compotes en coulis, gemaakt van onze eigen verse producten\nFruitmanden op bestelling."
        ]
      },
