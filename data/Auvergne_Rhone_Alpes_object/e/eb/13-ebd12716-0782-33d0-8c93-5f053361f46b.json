  "rdfs:comment": {
    "de": [
      "Die Ferme des Lacaunes bietet Ihnen 100% biologische Schafsprodukte zum Verkauf an: Naturjoghurt, aromatisierter Joghurt, Eierpudding, reifer Frischkäse, Blauschimmelkäse, Tome, Raclette, Brebichons, Nudeln, Mehl, Trockenwurst und Trockenwurst, Schafsterrine...."
    ],
    "en": [
      "La ferme des Lacaunes sells 100% organic ewe's milk products: plain and flavoured yoghurts, egg flans, ripened fresh cheeses, blue, tome, raclette, brebichons, pasta, flour, dry sausages and dry sausages, ewe's milk terrines..."
    ],
    "it": [
      "La ferme des Lacaunes vende prodotti di latte di pecora 100% biologici: yogurt semplici e aromatizzati, sformati all'uovo, formaggi freschi stagionati, erborinati, tome, raclette, brebichons, pasta, farina, salsicce e salumi secchi, terrine di latte di pecora..."
    ],
    "fr": [
      "La ferme des Lacaunes vous propose à la vente des produits 100% brebis bio : yaourts nature, aromatisés, flans aux œufs, fromages frais affinés, bleu; tome,raclette,brebichons,pâtes, farine, saucisses sèches et saucissons secs , terrines de brebis.."
    ],
    "nl": [
      "La ferme des Lacaunes verkoopt 100% biologische producten van schapenmelk: gewone en gearomatiseerde yoghurt, flensjes, gerijpte verse kazen, blauwe kaas, tome, raclette, brebichons, pasta, meel, droge worst en droge worst, terrines van schapenmelk..."
    ],
    "es": [
      "La ferme des Lacaunes vende productos 100% de leche de oveja ecológica: yogures naturales y aromatizados, flanes de huevo, quesos frescos madurados, azul, tome, raclette, brebichons, pasta, harina, embutidos secos y salchichas, terrinas de leche de oveja..."
    ]
  },
  "rdfs:label": {
