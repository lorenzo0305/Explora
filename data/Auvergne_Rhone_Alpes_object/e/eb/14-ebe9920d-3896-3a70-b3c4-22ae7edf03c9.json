      "dc:description": {
        "de": [
          "Produkte aus dem Bauernhof \"Ferme du Vinage\" in Roncq.\n\nFRÜCHTE\nRote Früchte Erdbeere\nRote Früchte\n\nFLEISCH\nFleisch Schweinefleisch\nFleisch\n\nEIER & MILCHPRODUKTE\nKäse von Kühen\nKäse"
        ],
        "en": [
          "Products from the Vinage farm in Roncq.\n\nFRUITS\nRed fruits Strawberry\nRed fruits\n\nMEATS\nMeat Pork\nMeat\n\nEGGS & DAIRY PRODUCTS\nCow's milk cheese\nCheeses"
        ],
        "it": [
          "Prodotti della fattoria Vinage di Roncq.\n\nFRUTTI\nFrutti rossi Fragola\nBacche rosse\n\nCARNE\nCarne di maiale\nCarne\n\nuOVA E PRODOTTI LATTIERO-CASEARI\nFormaggio di latte vaccino\nFormaggio"
        ],
        "fr": [
          "Produits issus de la ferme du Vinage à Roncq.\n\nFRUITS\nFruits rouges Fraise\nFruits rouges\n\nVIANDES\nViandes Porc\nViandes\n\nŒUFS & PRODUITS LAITIERS\nFromages de vache\nFromages"
        ],
        "es": [
          "Productos de la granja Vinage de Roncq.\n\nFRUTAS\nFrutos rojos Fresa\nBayas rojas\n\nCARNE\nCarne de cerdo\nCarne\n\nhUEVOS Y PRODUCTOS LÁCTEOS\nQueso de leche de vaca\nQueso"
        ],
        "nl": [
          "Producten van de Vinage boerderij in Roncq.\n\nFRUITEN\nRode vruchten Aardbei\nRode bessen\n\nVLEES\nVlees Varkensvlees\nVlees\n\neIEREN & ZUIVELPRODUCTEN\nKaas van koemelk\nKaas"
