  "rdfs:comment": {
    "de": [
      "Die Bienenstöcke von La Vence laden Sie ein, ihre Produkte aus der Bienenzucht zu entdecken, aber auch ihre Lavandin-Essenz und andere Produkte, die aus Propolis-Pollen gewonnen werden."
    ],
    "en": [
      "Les ruchers de la Vence invite you to discover their beekeeping products, as well as their lavandin essence and other by-products made from propolis and pollen."
    ],
    "it": [
      "Les ruchers de la Vence vi invitano a scoprire i loro prodotti apistici, ma anche l'essenza di lavandino e altri prodotti derivati dalla propoli e dal polline."
    ],
    "fr": [
      "Les ruchers de la Vence vous invite à découvrir leurs produits issu de l'apiculture, mais également leur essence de lavandin et autres produits dérivés issu de propolis pollen."
    ],
    "nl": [
      "Les ruchers de la Vence nodigt je uit om hun imkerijproducten te ontdekken, evenals hun lavandin essence en andere bijproducten gemaakt van propolis en stuifmeel."
    ],
    "es": [
      "Les ruchers de la Vence le invita a descubrir sus productos apícolas, pero también su esencia de lavandín y otros productos derivados del propóleo y el polen."
    ]
  },
  "rdfs:label": {
