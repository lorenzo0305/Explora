  "rdfs:comment": {
    "de": [
      "Der Drittort Vita'Mine ist ein Ort von und für die Bewohner. Er ist im Viertel Contamine angesiedelt und soll durch seine Veranstaltungen die Kultur, die Sozial- und Solidarwirtschaft, die Partnerschaft, die Digitalisierung und die Vereinsinitiativen fördern."
    ],
    "en": [
      "The Vita'Mine third-location center is a space by and for local residents. Located in the Contamine district, it aims to develop culture, the social economy, partnerships, digital technology and community initiatives."
    ],
    "it": [
      "Il centro terzo Vita'Mine è uno spazio realizzato da e per i residenti locali. Situato nel quartiere Contamine, mira a sviluppare la cultura, l'economia sociale, i partenariati, la tecnologia digitale e le iniziative comunitarie."
    ],
    "fr": [
      "Le tiers-lieu Vita'Mine est un espace par et pour les habitants. Implanté dans le quartier de la Contamine, il vise à développer par ses animations, la culture, l'économie sociale et solidaire, le partenariat, le numérique et les initiatives associatives."
    ],
    "nl": [
      "Het Vita'Mine third-party centrum is een ruimte door en voor buurtbewoners. Het ligt in de wijk Contamine en heeft als doel cultuur, sociale economie, partnerschappen, digitale technologie en gemeenschapsinitiatieven te ontwikkelen."
    ],
    "es": [
      "El centro para terceros Vita'Mine es un espacio por y para los residentes locales. Situado en el barrio de Contamine, su objetivo es desarrollar la cultura, la economía social, las asociaciones, la tecnología digital y las iniciativas comunitarias."
    ]
  },
  "rdfs:label": {
