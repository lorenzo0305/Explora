  "rdfs:comment": {
    "de": [
      "Ein Aufstieg mit der Gondelbahn und dem Sessellift bis zum Gipfel des Tougnète (2437 m).\nNehmen Sie sich die Zeit, das atemberaubende Panorama zu bewundern, bevor Sie den fast 1000 m langen Abstieg antreten"
    ],
    "en": [
      "Take the gondola and chairlift up to the summit of Tougnète (2437m). \r\nTake the time to admire the breathtaking panorama before starting the almost 1000m descent"
    ],
    "it": [
      "Salite con la gondola e poi con la seggiovia fino alla cima della Tougnète (2437 m).\nPrendetevi il tempo di ammirare il panorama mozzafiato prima di iniziare la discesa di quasi 1000 metri"
    ],
    "fr": [
      "Une montée en télécabine puis télésiège jusqu'au sommet de Tougnète (2437m). \nPrenez le temps d'admirer ce panorama à couper le souffle avant d'entamer les presque 1000m de descente"
    ],
    "es": [
      "Suba en telecabina y luego en telesilla hasta la cima de Tougnète (2437 m).\nTómese su tiempo para admirar el impresionante panorama antes de iniciar el descenso de casi 1.000 m"
    ],
    "nl": [
      "Neem de gondel en stoeltjeslift naar de top van Tougnète (2437m).\r\nNeem de tijd om het adembenemende panorama te bewonderen voordat u aan de bijna 1000m lange afdaling begint."
    ]
  },
  "rdfs:label": {
    "en": [
      "R6 - Descent of the Tougnète summit  From Méribel"
    ],
    "fr": [
      "Sentier piéton - R6 - Descente du sommet Tougnète  Départ Méribel"
    ],
    "nl": [
      "R6 - Afdaling van de Tougnète-top - Vertrek Méribel"
    ]
  },
