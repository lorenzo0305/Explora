  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen des Dorfes St-Michel de Maurienne in Savoyen. Es befindet sich auf dem Weg zu den großen Alpenpässen (Galibier, Madeleine, Croix de Fer), nach Italien, Orelle, Valloire und dem größten Skigebiet der Welt: Les 3 Vallées."
    ],
    "en": [
      "Located in the heart of the village of St-Michel de Maurienne in Savoie, on the route to the great Alpine passes (Galibier, Madeleine, Croix de Fer), Italy, Orelle, Valloire and the world's largest ski area: Les 3 Vallées."
    ],
    "it": [
      "L'albergo vi offre tutte le comodità del mondo moderno. Puo accogliervi in camere spaziose con capacita ognuna di 3 persone."
    ],
    "fr": [
      "Situé au cœur du village de St-Michel de Maurienne, en Savoie, situé sur la route des grands cols alpins (Galibier, Madeleine, Croix de Fer), de l'Italie, d'Orelle, Valloire et du plus grand domaine skiable du monde : Les 3 Vallées."
    ],
    "es": [
      "Situado en el corazón del pueblo de St-Michel de Maurienne, en Saboya, en el camino hacia los grandes puertos alpinos (Galibier, Madeleine, Croix de Fer), hacia Italia, Orelle, Valloire y el mayor dominio esquiable del mundo: Les 3 Vallées."
    ],
    "nl": [
      "Gelegen in het hart van het dorp St-Michel de Maurienne, in de Savoie, op de weg naar de grote Alpenpassen (Galibier, Madeleine, Croix de Fer), naar Italië, Orelle, Valloire en het grootste skigebied ter wereld: Les 3 Vallées."
    ]
  },
