  "rdfs:comment": {
    "de": [
      "Eine sonnige Terrasse mit Blick auf die Skipisten in einer gemütlichen und warmen Atmosphäre. Raffiniertes Brasserie-Menü zum Mittagessen mit Vorschlägen, abends lokale Spezialitäten. Après-Ski-Musikbar, Aperitifplatten für Momente der Entspannung.."
    ],
    "en": [
      "Open in the season, winter and summer.  The Ski Gliss café offers a warm welcome and a menu that highlights local specialities and traditional cuisine. Come and enjoy good times with friends and family at the bar."
    ],
    "it": [
      "Aperto in stagione in inverno e in estate. La caffetteria SKIGLISS vi invita a scoprire un menu in armonia con le specialità locali e la cucina tradizionale. Approfittate del bar per trascorrere un momento conviviale con gli amici o la famiglia."
    ],
    "fr": [
      "Ouvert en saison l'hiver et l'été. Le SKIGLISS café vous invite à découvrir une carte en harmonie avec les spécialités locales et une cuisine traditionnelle. Profitez du bar pour passer un moment convivial entre amis ou en famille."
    ],
    "nl": [
      "In het seizoen geopend in de winter en de zomer. Het SKIGLISS café nodigt u uit om een menu te ontdekken in harmonie met lokale specialiteiten en traditionele gerechten. Maak gebruik van de bar voor een gezellig moment met vrienden of familie."
    ],
    "es": [
      "Abierto en temporada en invierno y verano. La cafetería SKIGLISS le invita a descubrir una carta en armonía con las especialidades locales y la cocina tradicional. Aproveche el bar para pasar un momento de convivencia con los amigos o la familia."
    ]
  },
