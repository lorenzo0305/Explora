  "rdfs:comment": {
    "de": [
      "Frédéric, Produzent und Destillateur, bietet ätherische Öle, Kräutertees, Blütenwasser, Kosmetika, Spirituosen usw. an und weiht Sie in die Geheimnisse der Verarbeitung und Verwendung von Heilpflanzen ein. Zahlreiche Vorführungen und geführte Besichtigungen."
    ],
    "en": [
      "Frédéric, producer-distiller, offers essential oils, herbal teas, floral waters, cosmetics, alcohols... and reveals the secrets of processing and using medicinal plants. Numerous demonstrations and guided tours."
    ],
    "it": [
      "Frédéric, produttore-distillatore, propone oli essenziali, tisane, acque floreali, cosmetici, alcoli, ecc. e svela i segreti della lavorazione e dell'utilizzo delle piante medicinali. Numerose dimostrazioni e visite guidate."
    ],
    "fr": [
      "Frédéric, producteur-distillateur, propose des huiles essentielles, tisanes, eaux florales, cosmétiques, alcools… et vous dévoile les secrets de la transformation et des usages des plantes médicinales. De nombreuses démonstrations et visites commentées."
    ],
    "es": [
      "Frédéric, productor-destilador, ofrece aceites esenciales, tisanas, aguas florales, cosméticos, alcoholes, etc. y desvela los secretos de la transformación y utilización de las plantas medicinales. Numerosas demostraciones y visitas guiadas."
    ],
    "nl": [
      "Frédéric, producent-stoker, biedt essentiële oliën, kruidenthee, bloemenwaters, cosmetica, alcoholen, enz. aan en onthult de geheimen van de verwerking en het gebruik van geneeskrachtige planten. Talrijke demonstraties en rondleidingen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Distillerie du Bois de Païolive : Essential oils and more..."
    ],
    "fr": [
      "Distillerie du Bois de Païolive : Huiles essentielles et plus encore..."
    ]
  },
