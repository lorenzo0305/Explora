  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/931233a6-7bae-3507-a02f-d4e2b5c16b22",
      "dc:description": {
        "de": [
          "Freie Besichtigung (Broschüre erhältlich bei den BAT von Mers, Eu und Le Tréport) oder Führung entlang der Esplanade du Général Leclerc, wo die Villen der Site patrimonial remarquable Bow-Windows, kunstvolle Balkone, farbenfrohe Fassaden und Keramiken aufweisen, die den Charme der Belle Epoque bezeugen."
        ],
        "en": [
          "Self-guided tour (brochure available from the Mers, Eu and Le Tréport TAOs) or guided tour along the esplanade du Général Leclerc, where villas from the remarkable heritage site boast bow-windows, elaborate balconies, colorful facades and ceramics that bear witness to the charm of the Belle Epoque."
        ],
        "it": [
          "Visita autonoma (brochure disponibile presso gli UAT di Mers, Eu e Le Tréport) o visita guidata lungo l'esplanade du Général Leclerc, dove le ville del notevole patrimonio vantano bow-windows, balconi elaborati, facciate colorate e ceramiche che testimoniano il fascino della Belle Epoque."
        ],
        "fr": [
          "Visite libre (plaquette disponible au BAT de Mers, Eu et Le Tréport) ou guidée le long de l'esplanade du Général Leclerc où villas du site patrimonial remarquable arborent bow-windows, balcons ouvragés, façades colorées, céramiques qui témoignent du charme de la Belle Epoque."
        ],
        "nl": [
          "Zelf rondleiding (brochure verkrijgbaar bij de TAO's van Mers, Eu en Le Tréport) of rondleiding langs de esplanade du Général Leclerc, waar de villa's op deze opmerkelijke erfgoedsite bogen op boogramen, mooie balkons, kleurrijke gevels en keramiek die getuigen van de charme van de Belle Epoque."
        ],
        "es": [
          "Visita autoguiada (folleto disponible en las OAT de Mers, Eu y Le Tréport) o guiada a lo largo de la explanada del General Leclerc, donde las villas del notable conjunto patrimonial ostentan ventanas de arco, balcones elaborados, fachadas de colores y cerámicas que atestiguan el encanto de la Belle Epoque."
        ]
      },
      "@type": [
        "Description"
