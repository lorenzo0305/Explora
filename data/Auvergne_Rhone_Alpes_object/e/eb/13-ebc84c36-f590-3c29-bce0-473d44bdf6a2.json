  "rdfs:comment": {
    "de": [
      "Im historischen Zentrum von Brioude bietet Ihnen das Hôtel de la Dentelle: Kulturraum, Kreativwerkstatt, Ausbildungszentrum und Boutique.\r\nDauerausstellung: über 100 zeitgenössische Kreationen des HDLD in Cluny Polychrome de Brioude."
    ],
    "en": [
      "In the historical center of Brioude, the Hotel de la Dentelle offers you : cultural space, creation workshop, training center and store.\r\nPermanent exhibition: more than 100 contemporary creations of the HDLD in Cluny Polychrome of Brioude."
    ],
    "it": [
      "Nel centro storico di Brioude, l'Hôtel de la Dentelle offre uno spazio culturale, un laboratorio di creazione, un centro di formazione e un negozio.\r\nMostra permanente: più di 100 creazioni contemporanee dell'HDLD a Cluny Polychrome di Brioude."
    ],
    "fr": [
      "Dans le centre historique de Brioude, l'Hôtel de la Dentelle vous propose : espace culturel, atelier de création, centre de formation et boutique.\r\nExposition permanente : plus de 100 créations contemporaines de l'HDLD en Cluny Polychrome de Brioude."
    ],
    "nl": [
      "In het historische centrum van Brioude biedt Hôtel de la Dentelle u een culturele ruimte, een creatief atelier, een opleidingscentrum en een winkel.\r\nPermanente tentoonstelling: meer dan 100 hedendaagse creaties van de HDLD in Cluny Polychrome van Brioude."
    ],
    "es": [
      "En el centro histórico de Brioude, el Hôtel de la Dentelle le ofrece un espacio cultural, un taller de creación, un centro de formación y una tienda.\r\nExposición permanente: más de 100 creaciones contemporáneas del HDLD en Cluny Polychrome de Brioude."
    ]
  },
