  "rdfs:comment": {
    "de": [
      "Verkauf von Ziegenkäse aus biologischem Anbau auf dem Bauernhof, darunter Chevrotin AOP. Richtung Seythenex, folgen Sie dem Schild \"Bio Chèvre\"."
    ],
    "en": [
      "Le Bio Chevre, goat cheese from organic farming to purchase at the farm. Towards Seythenex, follow \"Le Bio Chèvre\" signs."
    ],
    "it": [
      "Vendita di formaggi di capra biologici in azienda, tra cui il chevrotin DOP. Direzione Seythenex, seguire l'indicazione \"Bio Chèvre\"."
    ],
    "fr": [
      "Vente à la ferme de fromages de chèvre issus de l'Agriculture Biologique dont le chevrotin AOP. Direction Seythenex, suivre le panneau \"Bio Chèvre\"."
    ],
    "nl": [
      "Verkoop van biologische geitenkaas op de boerderij, waaronder chevrotin BOB. Richting Seythenex, volg het bord \"Bio Chèvre\"."
    ],
    "es": [
      "Venta de queso de cabra ecológico en la explotación, incluido el chevrotin DOP. Dirección Seythenex, seguir la señal \"Bio Chèvre\"."
    ]
  },
