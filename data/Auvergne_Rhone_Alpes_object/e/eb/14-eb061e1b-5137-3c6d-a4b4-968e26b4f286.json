  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30ddb123-a490-3c9e-b501-48df4021983d",
      "dc:description": {
        "de": [
          "Éric Bompard bietet Ihnen Textilkollektionen, die aus Kaschmir hergestellt werden, und Accessoires für Frauen wie für Sie, meine Herren!\n\nTäglich von 10 bis 13 Uhr und von 14 bis 19 Uhr geöffnet, außer sonntags von 10 bis 19 Uhr."
        ],
        "en": [
          "Éric Bompard offers cashmere textile collections and accessories for women and men alike!\n\nOpen daily from 10am to 1pm and from 2pm to 7pm, except Sundays from 10am to 7pm."
        ],
        "it": [
          "Éric Bompard offre collezioni di tessuti in cashmere e accessori per donne e uomini!\n\nAperto tutti i giorni dalle 10.00 alle 13.00 e dalle 14.00 alle 19.00, tranne la domenica dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Éric Bompard vous propose des collections textiles fabriquées en cachemire et des accessoires féminins comme pour vous messieurs !\n\nOuvert tous les jours de 10hà 13h et de 14h à 19h sauf le dimanche de 10h à 19h."
        ],
        "es": [
          "Éric Bompard propone colecciones textiles y accesorios de cachemira para hombres y mujeres\n\nAbierto todos los días de 10.00 a 13.00 y de 14.00 a 19.00, excepto los domingos de 10.00 a 19.00."
        ],
        "nl": [
          "Éric Bompard biedt collecties kasjmiertextiel en accessoires voor zowel vrouwen als mannen!\n\nElke dag geopend van 10.00 tot 13.00 uur en van 14.00 tot 19.00 uur, behalve op zondag van 10.00 tot 19.00 uur."
        ]
      },
      "@type": [
        "Description"
