  "rdfs:comment": {
    "de": [
      "Trainieren Sie die Suche nach Lawinenopfern und üben Sie die richtigen Reflexe mit Ihrem LVS-Gerät.\r\nFreier Zugang am oberen Ende des Sessellifts von Bellecombe."
    ],
    "en": [
      "Train yourself to search for avalanche victims and adopt the right reflexes with your avalanche transceiver. Free access at the top of the Bellecombe chairlift."
    ],
    "it": [
      "Allenatevi a cercare le vittime di valanghe e adottate i giusti riflessi con il vostro apparecchio di ricerca in valanga. Accesso libero in cima alla seggiovia Bellecombe."
    ],
    "fr": [
      "Entraînez-vous à la recherche de victimes d'avalanche et adoptez les bons réflexes avec votre DVA. \r\nAccès libre en haut du télésiège de Bellecombe."
    ],
    "nl": [
      "Leer lawineslachtoffers te zoeken en de juiste reflexen aan te leren met je lawinepieper.\r\nGratis toegang bovenaan de Bellecombe stoeltjeslift."
    ],
    "es": [
      "Aprenda a buscar víctimas de avalanchas y a adoptar los reflejos adecuados con su transceptor de avalanchas.\r\nAcceso libre en la parte superior del telesilla de Bellecombe."
    ]
  },
