  "rdfs:comment": {
    "de": [
      "Nur einen Katzensprung von der Stadt entfernt erwartet Sie ein echter Ausflug in die Natur, um\r\nwandern Sie durch die umliegenden Berge und Täler."
    ],
    "en": [
      "Just a stone's throw from the town, a real nature outing awaits you to\r\nthe surrounding mountains and valleys."
    ],
    "it": [
      "A pochi passi dalla città, vi aspetta una vera e propria gita nella natura, sulle\r\nle montagne e le valli circostanti."
    ],
    "fr": [
      "À deux pas de la ville, une véritable sortie en pleine nature vous attend pour\r\narpenter les montagnes et vallons alentours."
    ],
    "nl": [
      "Op een steenworp afstand van de stad wacht je een echt natuuruitstapje naar\r\nde omliggende bergen en valleien."
    ],
    "es": [
      "A tiro de piedra de la ciudad, le espera una auténtica excursión por la naturaleza a\r\nlas montañas y valles de los alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trail 7 - Le 8 de Dieu-Grâce au Mont Rachas"
    ]
  },
