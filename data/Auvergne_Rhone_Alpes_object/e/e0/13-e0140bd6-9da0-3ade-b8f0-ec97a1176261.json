  "rdfs:comment": {
    "de": [
      "Mit diesem Modul kann man Fahrrad und Roller fahren, ohne in die Pedale zu treten, nur durch Pumpen dank der Bodenwellen. Länge 64 m."
    ],
    "en": [
      "This module lets you cycle and scooter without pedaling, just by pumping through the bumps. Length 64m."
    ],
    "it": [
      "Questo modulo consente di andare in bicicletta e in monopattino senza pedalare, semplicemente pompando grazie ai dossi. Lunghezza 64 m."
    ],
    "fr": [
      "Ce module permet de faire du vélo et de la trottinette sans pédaler, juste en pompant grâce aux bosses. Longueur de 64m."
    ],
    "nl": [
      "Met deze module kun je fietsen en steppen zonder te trappen, gewoon door te pompen dankzij de hobbels. 64 m lang."
    ],
    "es": [
      "Este módulo permite circular en bicicleta y scooter sin pedalear, simplemente bombeando gracias a los baches. 64 m de longitud."
    ]
  },
