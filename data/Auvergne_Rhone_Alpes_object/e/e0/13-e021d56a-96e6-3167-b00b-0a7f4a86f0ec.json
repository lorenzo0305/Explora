  "rdfs:comment": {
    "de": [
      "Gut gelagert im Zentrum des Dorfes, ist die Kirche der beiden Vaulnaveys jeden Tag geöffnet. Im Inneren erzählen erklärende Tafeln die Geschichte des Gebäudes."
    ],
    "en": [
      "Firmly planted in the middle of the village, the Church of the two Vaulnaveys is currently being restored. It has always been shared between the two parishes of Vaulnaveys-le-Haut and Vaulnaveys-le-Bas.\r\nIts 18th-century bell tower is a copy of the Saint-André Church bell tower in Grenoble."
    ],
    "it": [
      "Ben situata nel centro del villaggio, la chiesa dei due Vaulnaveys è aperta tutti i giorni. All'interno, pannelli esplicativi ripercorrono la storia dell'edificio."
    ],
    "fr": [
      "Bien campée au centre du village, l'église des deux Vaulnaveys est ouverte tous les jours. A l'intérieur des panneaux explicatifs retracent l'histoire de l'édifice."
    ],
    "es": [
      "Situada en el centro del pueblo, la iglesia de Les Deux Vaulnaveys está abierta todos los días. En su interior, paneles explicativos recorren la historia del edificio."
    ],
    "nl": [
      "Goed gelegen in het centrum van het dorp, is de kerk van de twee Vaulnaveys elke dag geopend. Binnen vertellen panelen met uitleg over de geschiedenis van het gebouw."
    ]
  },
