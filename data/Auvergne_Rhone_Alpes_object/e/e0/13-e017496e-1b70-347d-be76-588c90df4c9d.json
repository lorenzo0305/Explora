  "rdfs:comment": {
    "de": [
      "Themenhaus rund um die Viehzucht mit der geschützten Ursprungsbezeichnung Fin Gras du Mézenc: die typischen Merkmale der Viehzucht und der Flora des Gebietes auf den Hochebenen des Mézenc. Entdecken Sie seine Geschichte!"
    ],
    "en": [
      "Themed house around PDO Fin Gras du Mézenc breeding: the typicality of breeding and the flora of the Mézenc high plateaux. Come and discover its history!"
    ],
    "it": [
      "Casa a tema basata sull'allevamento Fin Gras du Mézenc DOP: la tipicità del bestiame e la flora degli altipiani del Mézenc. Venite a scoprire la sua storia!"
    ],
    "fr": [
      "Maison thématique autour de l'élevage AOP Fin Gras du Mézenc : la typicité de l'élevage et de la flore du territoire des hauts plateaux du Mézenc. Venez découvrir son histoire !"
    ],
    "nl": [
      "Themagebouw rond de veestapel Fin Gras du Mézenc BOB: de typische natuur van de veestapel en de flora van de hoogvlakten van Mézenc. Kom en ontdek zijn geschiedenis!"
    ],
    "es": [
      "Casa temática en torno a la ganadería Fin Gras du Mézenc DOP: la tipicidad de la ganadería y la flora de las altas mesetas de Mézenc. ¡Venga a descubrir su historia!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de l'AOP Fin Gras"
    ]
  },
