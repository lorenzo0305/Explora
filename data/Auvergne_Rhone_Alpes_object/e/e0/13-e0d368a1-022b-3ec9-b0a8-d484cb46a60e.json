  "rdfs:comment": {
    "de": [
      "Übernehmen Sie die Kontrolle in unserem professionellen Flugsimulator! Zweisitziger Flugsimulator Instruktor, 180°-Sicht - Eintauchen garantiert!\r\nStart vom Flughafen Clermont-Ferrand Auvergne."
    ],
    "en": [
      "Take control of our professional flight simulator! Instructor tandem flight simulator, 180° vision - Immersion guaranteed!\r\nTake-off from runway 08 at Clermont-Ferrand Auvergne airport."
    ],
    "it": [
      "Prendete i comandi del nostro simulatore di volo professionale! Simulatore di volo biposto con istruttore, visione a 180° - Immersione garantita!\r\nDecollate dall'aeroporto di Clermont-Ferrand Auvergne."
    ],
    "fr": [
      "Prenez les commandes de notre simulateur de vol professionnel ! Simulateur de vol biplace Instructeur, vision à 180° - Immersion Garantie !\r\nDécollage depuis l’Aéroport de Clermont-Ferrand Auvergne."
    ],
    "es": [
      "¡Tome los mandos de nuestro simulador de vuelo profesional! Simulador de vuelo biplaza con instructor, visión de 180° - ¡Inmersión garantizada!\r\nDespegue del aeropuerto de Clermont-Ferrand Auvergne."
    ],
    "nl": [
      "Neem het stuur over van onze professionele vluchtsimulator! Tweezits vluchtsimulator met instructeur, 180° zicht - Onderdompeling gegarandeerd!\r\nStijg op vanaf de luchthaven van Clermont-Ferrand Auvergne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Simu'Fly, simulateur de vol, prenez les commandes !"
    ]
  },
