  "rdfs:comment": {
    "de": [
      "Große Auswahl an Kebab, American Kebab, Hamburgern und Tacos, die in Form von Pauschalangeboten, vor Ort, zum Mitnehmen oder als Lieferservice (von 12 Uhr mittags bis Mitternacht) genossen werden können."
    ],
    "en": [
      "Wide choice of kebabs, American, hamburgers and tacos that can be eaten in formulas, on the spot, to take away or in delivery (from noon to midnight)."
    ],
    "it": [
      "Ampia scelta di kebab, americani, hamburger e tacos che possono essere gustati in formula, sul posto, da asporto o consegnati (da mezzogiorno a mezzanotte)."
    ],
    "fr": [
      "Large choix de kebabs, américains, hamburgers et tacos pouvant être déguster au sein de formules, sur place, à emporter ou en livraison (de midi à minuit)."
    ],
    "nl": [
      "Ruime keuze aan kebab, American, hamburgers en taco's die kunnen worden genuttigd in formules, ter plaatse, om mee te nemen of bezorgd (van 's middags tot middernacht)."
    ],
    "es": [
      "Amplia oferta de pinchos, americanas, hamburguesas y tacos que se pueden degustar en fórmulas, en el momento, para llevar o a domicilio (de mediodía a medianoche)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restauration rapide : Tacos'bells"
    ]
  },
