  "rdfs:comment": {
    "de": [
      "Nur Selbstgemachtes aus lokalen Produkten. Herzhaftes: Fladenbrot, Pizzas, Burger, Salate, Fleischgerichte, Kindermenü, Savoyer Spezialitäten, Poëlons... Süße Seite: Crêpes, Waffeln, Eis. Zum Mitnehmen: Pizzas, Burger."
    ],
    "en": [
      "All home-made with local produce. Savoury: galettes, pizzas, burgers, salads, meats, children's menu, Savoyard specialities, poëlons... Sweet: crêpes, waffles, ice creams. Takeaway: pizzas, burgers."
    ],
    "it": [
      "Tutto fatto in casa con prodotti locali. Salato: galette, pizze, hamburger, insalate, carni, menu per bambini, specialità savoiarde, poëlons... Dolce: crêpes, cialde, gelati. Da asporto: pizze, hamburger."
    ],
    "fr": [
      "Uniquement du fait-maison avec produits locaux. Côté salé : galettes, pizzas, burgers, salades, viandes, menu enfant, spécialités savoyardes, poëlons... Côté sucré : crêpes, gaufres, glaces. À emporter : pizzas, burgers."
    ],
    "es": [
      "Todo casero con productos locales. Salado: galettes, pizzas, hamburguesas, ensaladas, carnes, menú infantil, especialidades saboyanas, poëlons... Dulce: crepes, gofres, helados. Para llevar: pizzas, hamburguesas."
    ],
    "nl": [
      "Alles huisgemaakt met lokale producten. Hartig: galettes, pizza's, hamburgers, salades, vleeswaren, kindermenu, Savoyaardse specialiteiten, poëlons... Zoet: crêpes, wafels, ijsjes. Afhaalmaaltijden: pizza's, hamburgers."
    ]
  },
