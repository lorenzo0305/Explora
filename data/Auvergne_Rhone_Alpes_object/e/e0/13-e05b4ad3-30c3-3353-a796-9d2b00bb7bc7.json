  "rdfs:comment": {
    "de": [
      "Produzentin von aromatischen und medizinischen Pflanzen, die zu Kräutertee, Einzelpflanzen, Ölmazeraten und Cerat (Creme) verarbeitet werden. Die gesamte Produktion ist mit dem Label Nature et Progrès ausgezeichnet."
    ],
    "en": [
      "Producer of aromatic and medicinal plants transformed into herbal teas, simple plants, oily macerates and cerates (creams). All production is Nature et Progrès certified."
    ],
    "it": [
      "Produttore di piante aromatiche e medicinali trasformate in tisane, piante semplici, macerati oleosi e cerati (creme). Tutta la nostra produzione è certificata Nature et Progrès."
    ],
    "fr": [
      "Productrice de plantes aromatiques et médicinales transformées en tisane, plante simple, macérat huileux et cérat (crème). Toute la production est labélisée Nature et Progrès."
    ],
    "es": [
      "Productor de plantas aromáticas y medicinales transformadas en tisanas, plantas simples, macerados oleosos y ceratos (cremas). Toda nuestra producción está certificada Nature et Progrès."
    ],
    "nl": [
      "Producent van aromatische en geneeskrachtige planten die worden omgezet in kruidenthee, eenvoudige planten, oliehoudende maceraten en ceraten (crèmes). Al onze productie is Nature et Progrès gecertificeerd."
    ]
  },
