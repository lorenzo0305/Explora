  "rdfs:comment": {
    "de": [
      "Das 1973 eingeweihte Werk von Émile Gilioli ist ein Symbol der Hoffnung, das den Einsatz der Kämpfer von Les Glières zum Ausdruck bringt. 2020 wurde es in die Liste der historischen Denkmäler aufgenommen. Freie Besichtigung."
    ],
    "en": [
      "National Monument to the Resistance.\r\nAt the end of the 1960s, as plans for the commemoration of the 30th anniversary of the Maquis des Glières were being put forward, the idea developed amongst the survivors that it was becoming important"
    ],
    "it": [
      "Inaugurata nel 1973, l'opera di Émile Gilioli è un simbolo di speranza che esprime l'impegno dei combattenti di Glières ed è stata dichiarata monumento storico nel 2020. Ingresso libero."
    ],
    "fr": [
      "Inaugurée en 1973, l’œuvre d’Émile Gilioli est un symbole d’espérance exprimant l’engagement des combattants des Glières, inscrite au titre des monuments historiques en 2020. Visite libre."
    ],
    "es": [
      "Inaugurada en 1973, la obra de Emile Gilioli es un símbolo de esperanza que expresa el compromiso de los luchadores de Glières. Visita gratuita."
    ],
    "nl": [
      "Het werk van Émile Gilioli, ingehuldigd in 1973, is een symbool van hoop en geeft uitdrukking aan de inzet van de strijders van Glières. Het werd in 2020 op de lijst van historische monumenten geplaatst. Gratis toegang."
    ]
  },
  "rdfs:label": {
    "de": [
      "Nationales Denkmal für den Widerstand von Gilioli"
    ],
    "en": [
      "Monument national à la Résistance de Gilioli"
    ],
    "it": [
      "Gilioli Monumento Nazionale alla Resistenza"
    ],
    "fr": [
      "Monument national à la Résistance de Gilioli"
    ],
    "nl": [
      "Nationaal Verzetsmonument Gilioli"
    ]
  },
