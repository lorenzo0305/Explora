  "rdfs:comment": {
    "de": [
      "Geschäft auf den Pisten, 50 m von der ESF entfernt. Hier finden Sie eine große Auswahl an Mietmaterial und Zubehör.\r\nSkischließfächer für Sie, wenn Sie Ihre Ausrüstung in La Poudreuse mieten."
    ],
    "en": [
      "Store on the slopes, 50 m from the ESF. You'll find plenty of choice for your equipment rentals and accessories.\r\nSki lockers for those renting equipment at La Poudreuse."
    ],
    "it": [
      "Negozio sulle piste, a 50 m dall'ESF. Troverete un'ampia gamma di attrezzature e accessori a noleggio.\r\nArmadietti per gli sci, per chi noleggia l'attrezzatura a La Poudreuse."
    ],
    "fr": [
      "Magasin sur les pistes, à 50 m de l'ESF. Vous trouverez du choix dans la location de votre matériel ainsi que pour vos accessoires.\r\nConsignes à ski, pour vous qui louez votre matériel à La Poudreuse."
    ],
    "nl": [
      "Winkel op de piste, op 50 m van de ESF. Je vindt er een ruim assortiment materiaal en accessoires om te huren.\r\nSkilockers voor wie materiaal huurt bij La Poudreuse."
    ],
    "es": [
      "Tienda en las pistas, a 50 m del FSE. Encontrará una amplia gama de equipos y accesorios de alquiler.\r\nGuardaesquís para los que alquilen material en La Poudreuse."
    ]
  },
