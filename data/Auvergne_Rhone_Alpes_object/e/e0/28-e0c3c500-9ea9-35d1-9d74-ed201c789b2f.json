      "rdfs:comment": {
        "de": [
          "Eine Auswahl an Deko-Objekten, die vom Meer und der Natur inspiriert sind \"esprit Baie de Somme\".\nEin Duftuniversum, das dem Wohlbefinden und dem Haus gewidmet ist: Kosmetik, Bad, Seifen, Kerzen, Düfte."
        ],
        "en": [
          "A selection of decorative objects inspired by the sea and nature \"Baie de Somme spirit\".\nAn olfactory universe dedicated to well-being and the home: cosmetics, bath, soaps, candles, scents."
        ],
        "it": [
          "Una selezione di oggetti decorativi ispirati al mare e alla natura \"spirito Baie de Somme\".\nUn universo olfattivo dedicato al benessere e alla casa: cosmetici, bagni, saponi, candele, profumi."
        ],
        "fr": [
          "Une sélection d'objets déco d'inspiration bord de mer et nature \" esprit Baie de Somme\".\nUn univers olfactif dédié au bien être et à la maison : cosmétique, bain, savons, bougies, senteurs."
        ],
        "es": [
          "Una selección de objetos de decoración inspirados en el mar y la naturaleza \"Espíritu de la Bahía de Somme\".\nUn universo olfativo dedicado al bienestar y al hogar: cosméticos, baños, jabones, velas, aromas."
        ],
        "nl": [
          "Een selectie van decoratieve voorwerpen geïnspireerd door de zee en de natuur \"Baie de Somme spirit\".\nEen olfactorisch universum gewijd aan het welzijn en het huis: cosmetica, baden, zepen, kaarsen, geuren."
        ]
      },
