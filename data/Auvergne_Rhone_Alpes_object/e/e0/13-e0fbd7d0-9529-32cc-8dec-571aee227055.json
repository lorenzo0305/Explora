  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein originelles Abenteuerspiel, um Les Adrets, seine Kultur und sein Erbe zu erkunden! Ein verrückter Wissenschaftler droht damit, den Skiliften von Prapoutel den Strom abzuschalten... Ihre Aufgabe? Lösen Sie die Rätsel und halten Sie ihn davon ab."
    ],
    "en": [
      "Discover an original adventure game to explore Les Adrets, its culture and heritage! A mad scientist is threatening to cut the electricity supply to the Prapoutel ski lifts... Your mission? Solve the riddles and stop him."
    ],
    "it": [
      "Un gioco d'avventura originale per scoprire gli Adrets, la loro cultura e il loro patrimonio! Uno scienziato pazzo minaccia di togliere l'elettricità agli impianti di risalita di Prapoutel... La vostra missione? Risolvete gli enigmi e fermatelo."
    ],
    "fr": [
      "Découvrez un jeu d'aventure original pour partir à la découverte des Adrets, sa culture et son patrimoine ! Un scientifique fou menace de couper l'électricité des remontées mécaniques de Prapoutel...Votre mission ? Résoudre les énigmes et l'en empêcher."
    ],
    "es": [
      "¡Descubre un original juego de aventuras para descubrir los Adrets, su cultura y su patrimonio! Un científico loco amenaza con cortar la electricidad de los remontes de Prapoutel... ¿Tu misión? Resuelve los enigmas y detenlo."
    ],
    "nl": [
      "Ontdek in een origineel avonturenspel Les Adrets, de cultuur en het erfgoed! Een gekke wetenschapper dreigt de stroomtoevoer naar de skiliften van Prapoutel af te sluiten... Jouw missie? Los de raadsels op en stop hem."
    ]
  },
  "rdfs:label": {
    "en": [
      "Adventure game - Court Jus in Prapoutel"
    ],
    "fr": [
      "Jeu d'Aventure - Court Jus à Prapoutel"
    ],
    "nl": [
      "Avonturenspel - Court Jus in Prapoutel"
    ]
  },
