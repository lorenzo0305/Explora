  "rdfs:comment": {
    "de": [
      "Unser Reisebüro Selectour Valence Voyages begleitet Sie, um gemeinsam mit Ihnen Ihre nächste Reise zu planen. Aufenthalte, Rundreisen, Kreuzfahrten, Flüge, Hotels oder maßgeschneiderte Reisen werden Ihnen in unserem Reisebüro angeboten."
    ],
    "en": [
      "Our Selectour Valence Voyages agency will work with you to design your next trip. Stays, tours, cruises, flights, hotels or tailor-made trips are all on offer in our travel agency."
    ],
    "it": [
      "La nostra agenzia Selectour Valence Voyages lavorerà con voi per progettare il vostro prossimo viaggio.\r\nSoggiorni, tour, crociere, voli, hotel o viaggi su misura sono tutti offerti dalla nostra agenzia di viaggi."
    ],
    "fr": [
      "Notre agence Selectour Valence Voyages vous accompagne pour construire avec vous votre prochain voyage.\r\nSéjours, circuits, croisières, vols, hôtels ou voyages sur mesure vous seront proposés dans notre agence de voyages."
    ],
    "nl": [
      "Ons reisbureau Selectour Valence Voyages stelt samen met jou je volgende reis samen. Verblijven, rondreizen, cruises, vluchten, hotels of reizen op maat zijn allemaal mogelijk bij ons reisbureau."
    ],
    "es": [
      "Nuestra agencia Selectour Valence Voyages diseñará con usted su próximo viaje.\r\nEstancias, circuitos, cruceros, vuelos, hoteles o viajes a medida: todo es posible en nuestra agencia de viajes."
    ]
  },
