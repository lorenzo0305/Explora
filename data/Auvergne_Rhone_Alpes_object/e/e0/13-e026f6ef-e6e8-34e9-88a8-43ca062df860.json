  "rdfs:comment": {
    "de": [
      "Familienhotel in ruhiger Lage am Ortseingang von Morzine. Entspannte Atmosphäre. Schwimmbad im Sommer und kostenlose Pendelbusse im Sommer und Winter bis zum Fuß der Pisten."
    ],
    "en": [
      "Family-friendly hotel enjoying a peaceful setting at the entrance to Morzine. Relaxed atmosphere, summer pool and free shuttles summer and winter to the foot of the slopes."
    ],
    "it": [
      "Hotel a conduzione familiare situato in una zona tranquilla all'ingresso di Morzine. Atmosfera rilassata. Piscina in estate e bus navetta gratuito in estate e in inverno per i piedi delle piste."
    ],
    "fr": [
      "Hôtel familial situé au calme à l'entrée de Morzine. Ambiance décontractée. Piscine l'été et navettes gratuites été comme hiver jusqu'au pied des pistes."
    ],
    "es": [
      "Hotel familiar situado en una zona tranquila a la entrada de Morzine. Ambiente relajado. Piscina en verano y autobús gratuito en verano e invierno a pie de pistas."
    ],
    "nl": [
      "Familiaal hotel op een rustige locatie bij de ingang van Morzine. Ontspannen sfeer. Zwembad in de zomer en gratis pendelbusdienst in zomer en winter naar de voet van de pistes."
    ]
  },
