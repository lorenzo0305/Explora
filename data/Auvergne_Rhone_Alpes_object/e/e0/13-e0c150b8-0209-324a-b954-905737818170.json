  "rdfs:comment": {
    "de": [
      "Unser Paar mit kambodschanischen, vietnamesischen und indischen Wurzeln wird Ihnen abwechslungsreiche und drehbare Karten präsentieren, damit Sie unsere Liebe zur Küche entdecken können!"
    ],
    "en": [
      "Our couple, of Cambodian, Vietnamese and Indian origin, will present you with a variety of rotating menus to help you discover our love of cooking!"
    ],
    "it": [
      "La nostra coppia di origine cambogiana, vietnamita e indiana vi presenterà una varietà di menu a rotazione per farvi scoprire il nostro amore per la cucina!"
    ],
    "fr": [
      "Notre couple aux origines cambodgiennes, vietnamiennes et indiennes vous présentera des cartes variées et tournantes afin de vous faire découvrir notre amour pour la cuisine !"
    ],
    "nl": [
      "Ons koppel van Cambodjaanse, Vietnamese en Indiase afkomst zal je verschillende menu's voorschotelen om je onze liefde voor koken te laten ontdekken!"
    ],
    "es": [
      "Nuestra pareja de origen camboyano, vietnamita e indio le presentará una variedad de menús rotativos para que descubra nuestro amor por la cocina"
    ]
  },
