  "rdfs:comment": {
    "de": [
      "Les Façonnarts befindet sich im Zentrum von Vienne und heißt Sie in seiner Boutique mit Atelier herzlich willkommen. Wir bieten Ihnen die Kreationen unserer leidenschaftlichen und lokalen Kunsthandwerker sowie einen Atelierbereich."
    ],
    "en": [
      "Located in the heart of Vienne, Les Façonnarts welcome you to their boutique-atelier. We offer the creations of our passionate local craftsmen, as well as a workshop area."
    ],
    "it": [
      "Situato nel centro di Vienne, Les Façonnarts vi dà il benvenuto nella sua boutique-laboratorio. Offriamo le creazioni dei nostri appassionati artigiani locali e un'area laboratorio."
    ],
    "fr": [
      "Situé en plein centre de Vienne, Les Façonnarts vous accueillent au sein de leur boutique-atelier . Nous proposons les créations de nos artisans passionnés et locaux, ainsi qu'un espace atelier."
    ],
    "es": [
      "Situada en el centro de Vienne, Les Façonnarts le da la bienvenida a su boutique-taller. Le ofrecemos las creaciones de nuestros apasionados artesanos locales, así como un espacio taller."
    ],
    "nl": [
      "Les Façonnarts, gelegen in het centrum van Vienne, heet je welkom in zijn boetiek-atelier. Wij bieden de creaties van onze gepassioneerde lokale ambachtslieden, evenals een workshopruimte."
    ]
  },
