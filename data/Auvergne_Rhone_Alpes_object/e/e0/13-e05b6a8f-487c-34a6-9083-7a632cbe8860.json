  "rdfs:comment": {
    "de": [
      "In einer ländlichen Atmosphäre ist der Wasserwanderrastplatz Chassenard am Kanal von Roanne nach Digoin mit einer Säule zur Energieversorgung (Wasser und Strom) ausgestattet."
    ],
    "en": [
      "In a country atmosphere, the Chassenard nautical stopover, located on the canal from Roanne to Digoin, is equipped with an energy supply terminal (water and electricity)."
    ],
    "it": [
      "In un contesto rurale, la fermata di Chassenard, situata sul canale Roanne-Digoin, è dotata di un terminale di approvvigionamento energetico (acqua ed elettricità)."
    ],
    "fr": [
      "Dans une ambiance champêtre, la halte nautique de Chassenard, située sur le canal de Roanne à Digoin, est équipée d'une borne de fourniture d'énergie (eau et électricité)."
    ],
    "nl": [
      "In een landelijke omgeving is de aanlegplaats van Chassenard, gelegen aan het kanaal Roanne-Digoin, uitgerust met een energieterminal (water en elektriciteit)."
    ],
    "es": [
      "En un entorno rural, la parada de barcas de Chassenard, situada en el canal Roanne-Digoin, está equipada con una terminal de suministro de energía (agua y electricidad)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Halte nautique de Chassenard"
    ]
  },
