  "rdfs:comment": {
    "de": [
      "Im Herzen des Stadtzentrums von Vienne, im Garten von Cybèle, bietet das Théâtre François Ponsard von Oktober bis Mai eine multidisziplinäre Kultursaison in seinem wunderschönen, denkmalgeschützten Saal aus dem 18."
    ],
    "en": [
      "In the heart of Vienna's city centre, in the Cybèle Garden, the Vienna Theatre offers from September to May a multidisciplinary cultural season in its superb 18th century listed hall."
    ],
    "it": [
      "Nel cuore del centro di Vienne, nel giardino Cybèle, il Théâtre François Ponsard offre una stagione culturale multidisciplinare da ottobre a maggio nel suo splendido auditorium del XVIII secolo."
    ],
    "fr": [
      "En plein cœur du centre ville de Vienne, dans le jardin de Cybèle, le Théâtre François Ponsard propose d'octobre à mai une saison culturelle pluridisciplinaire dans sa superbe salle classée du XVIIIe siècle."
    ],
    "nl": [
      "In het hart van het centrum van Vienne, in de tuin van Cybèle, biedt het Théâtre François Ponsard van oktober tot mei een multidisciplinair cultureel seizoen in zijn prachtige 18e-eeuwse geklasseerde zaal."
    ],
    "es": [
      "En pleno centro de Vienne, en el jardín de Cybèle, el Théâtre François Ponsard ofrece de octubre a mayo una temporada cultural multidisciplinar en su magnífica sala catalogada del siglo XVIII."
    ]
  },
