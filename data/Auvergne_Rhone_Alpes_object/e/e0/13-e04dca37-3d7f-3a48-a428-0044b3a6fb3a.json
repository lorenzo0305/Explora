  "rdfs:comment": {
    "de": [
      "Traditionelle bretonische Crêperie, die durch das Pays de Dieulefit wandert."
    ],
    "en": [
      "Traditional Breton creperie roaming the Pays de Dieulefit."
    ],
    "it": [
      "Creperia tradizionale bretone in giro per la regione di Dieulefit.\r\nCrêpes salate (grano saraceno) e dolci (grano), kouign amann, torta bretone e altre prelibatezze bretoni"
    ],
    "fr": [
      "Crêperie bretonne traditionnelle vagabondant dans le pays de Dieulefit.\r\nCrêpes salées (sarrasin) et sucrées (froment), kouign amann, gâteau breton, et autres douceurs bretonnes"
    ],
    "nl": [
      "Traditionele Bretonse crêperie in het Pays de Dieulefit."
    ],
    "es": [
      "Crepería tradicional bretona que recorre la región de Dieulefit.\r\nCrepes salados (trigo sarraceno) y dulces (trigo), kouign amann, pastel bretón y otras delicias bretonas"
    ]
  },
