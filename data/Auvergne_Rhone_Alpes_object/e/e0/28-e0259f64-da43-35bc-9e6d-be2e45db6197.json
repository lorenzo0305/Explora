  "rdfs:comment": {
    "de": [
      "Das Museum entführt seine Besucher in die Welt der Kunst und des Handwerks, einer Kultur, die seit mehr als zwei Jahrhunderten unverzichtbar ist und als Motor für Technologie und Industrie gilt\nSie entdecken Modelle und Prototypen, die von Ingenieuren hergestellt wurden!"
    ],
    "en": [
      "The museum immerses its visitors in the world of Arts and Crafts, a culture that has been indispensable for more than two centuries, being the driving force behind technologies and industries\nYou will discover models and prototypes made by engineers!"
    ],
    "it": [
      "Il museo immerge i suoi visitatori nel mondo delle Arti e Mestieri, una cultura che è stata la forza trainante della tecnologia e dell'industria per oltre due secoli\nScoprirete modelli e prototipi realizzati da ingegneri!"
    ],
    "fr": [
      "Le musée imprègne son visiteur dans l'univers des Arts et Métiers, une culture indispensable depuis plus de deux siècles étant le moteur des technologies et des industries. \nVous découvrez maquettes et prototypes réalisés par des ingénieurs !"
    ],
    "nl": [
      "Het museum dompelt zijn bezoekers onder in de wereld van Arts and Crafts, een cultuur die meer dan twee eeuwen lang de drijvende kracht is geweest achter technologie en industrie\nU zult modellen en prototypes ontdekken die door ingenieurs zijn gemaakt!"
    ],
    "es": [
      "El museo sumerge a sus visitantes en el mundo de la artesanía, una cultura que ha sido el motor de la tecnología y la industria durante más de dos siglos\nDescubrirá modelos y prototipos realizados por ingenieros"
    ]
  },
