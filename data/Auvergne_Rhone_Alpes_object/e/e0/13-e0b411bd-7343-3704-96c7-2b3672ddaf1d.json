  "rdfs:comment": {
    "de": [
      "Dieses kleine, charmante Hotel liegt etwas abseits der Straße zum Col de la Madeleine in einer grünen Umgebung und bietet Ihnen Zimmer mit allem Komfort (einige Zimmer mit Balkon)."
    ],
    "en": [
      "Located just a little way off the road to the mountain pass Le col de la Madeleine, in a green setting, this charming little hotel has fully equipped comfortable bedrooms (with balcony for some bedrooms)."
    ],
    "it": [
      "Situato leggermente fuori dalla strada del Col de la Madeleine, in un ambiente verde, questo piccolo hotel di charme offre camere confortevoli (alcune con balcone)."
    ],
    "fr": [
      "Situé légèrement à l'écart de la route du col de la Madeleine, dans un cadre verdoyant, ce petit hôtel de charme vous propose des chambres tout confort (avec balcons pour certaines chambres)."
    ],
    "es": [
      "Situado ligeramente al lado de la carretera del Col de la Madeleine, en un entorno verde, este pequeño hotel con encanto ofrece cómodas habitaciones (algunas con balcón)."
    ],
    "nl": [
      "Dit kleine charmante hotel ligt iets buiten de Col de la Madeleine, in een groene omgeving, en biedt comfortabele kamers (sommige met balkon)."
    ]
  },
  "rdfs:label": {
