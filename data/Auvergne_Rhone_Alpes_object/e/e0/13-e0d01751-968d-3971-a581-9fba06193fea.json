  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf regionale Küche spezialisiert : hechtklöße"
    ],
    "en": [
      "Located on the shores of Lake Nantua with capacity for 80 diners, the Embarcadère Restaurant is a true gastronomic delight.  Chef Jean-Charles Guyot proposes a menu that is a fantastic mix of the traditional and the modern in perfect harmony."
    ],
    "it": [
      "Un'incantevole sosta bistrot. Vista panoramica sul lago di Nantua. Piatti gustosi e raffinati a base di prodotti di stagione. Hotel, Ristorante, Bar, Brunch."
    ],
    "fr": [
      "Etape bistronomique de charme. Vue panoramique sur le lac de Nantua. Mets savoureux et raffinés rythmés par les produits de saison. Hôtel, Restaurant, Bar, Brunch."
    ],
    "es": [
      "Encantadora parada de bistró. Vista panorámica sobre el lago de Nantua. Platos sabrosos y refinados a base de productos de temporada. Hotel, Restaurante, Bar, Brunch."
    ],
    "nl": [
      "Charmante bistro. Panoramisch uitzicht over het meer van Nantua. Smakelijke, verfijnde gerechten op basis van seizoensproducten. Hotel, Restaurant, Bar, Brunch."
    ]
  },
  "rdfs:label": {
