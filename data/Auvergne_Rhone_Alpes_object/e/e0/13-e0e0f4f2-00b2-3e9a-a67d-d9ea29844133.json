  "rdfs:comment": {
    "de": [
      "Do you speak English?\r\nBof, nicht mehr wirklich, weil nicht oft genug?\r\nAber Sie wollen wieder einsteigen oder Ihr Englisch perfektionieren, ohne sich den Kopf zu zerbrechen?"
    ],
    "en": [
      "Do you speak English ?\r\nWell, not really, because not often enough?\r\nBut you'd like to start again or improve your English, without having to worry about it?"
    ],
    "it": [
      "Parlate inglese?\r\nNon proprio, perché non lo parli abbastanza spesso?\r\nMa vi piacerebbe ricominciare o migliorare le vostre conoscenze linguistiche, senza dovervi preoccupare?"
    ],
    "fr": [
      "Do you speak English ? \r\nBof, plus vraiment car pas assez souvent…\r\nMais vous avez envie de reprendre ou de vous perfectionner, sans vous prendre la tête ?"
    ],
    "es": [
      "¿Habla usted inglés?\r\nBueno, en realidad no porque no lo hablas con la frecuencia suficiente?\r\nPero, ¿le gustaría empezar de nuevo o mejorar sus conocimientos lingüísticos, sin tener que preocuparse por ello?"
    ],
    "nl": [
      "Spreek je Engels?\r\nNou, niet echt omdat je het niet vaak genoeg spreekt?\r\nMaar wil je graag opnieuw beginnen of je taalvaardigheid verbeteren, zonder dat je er omkijken naar hebt?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Five o’clock Tish"
    ]
  },
