  "rdfs:comment": {
    "de": [
      "Innerhalb des Gebäudes le Môle (Ein 60 m² großer Ausstellungsraum, der den Aktivitäten der EDF im Drac-Tal gewidmet ist), am Ufer des Sees von Monteynard-Avignonet, informiert Sie diese Informationsstelle über den See und seine Umgebung."
    ],
    "en": [
      "In the Môle building (a 60 m² exhibition space dedicated to EDF's activities in the Drac valley), on the shores of Lake Monteynard-Avignonet, this information point provides information about the lake and its surroundings."
    ],
    "it": [
      "Nell'edificio Môle (uno spazio espositivo di 60 m² dedicato alle attività di EDF nella valle del Drac), sulle rive del lago di Monteynard-Avignonet, questo punto informativo fornisce informazioni sul lago e sui suoi dintorni."
    ],
    "fr": [
      "Dans l'enceinte du bâtiment le Môle (Un espace d'exposition de 60 m² consacré aux activités d'EDF sur la vallée du Drac.), au bord du lac de Monteynard-Avignonet, ce point d'information vous renseigne sur le lac et ses environs."
    ],
    "nl": [
      "In het Môle-gebouw (een tentoonstellingsruimte van 60 m² gewijd aan de activiteiten van EDF in de Drac-vallei), aan de oevers van het meer van Monteynard-Avignonet, geeft dit informatiepunt informatie over het meer en zijn omgeving."
    ],
    "es": [
      "En el edificio Môle (un espacio de exposición de 60 m² dedicado a las actividades de EDF en el valle del Drac), a orillas del lago de Monteynard-Avignonet, este punto de información ofrece información sobre el lago y sus alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Point d'information touristique du Môle (Lac de Monteynard-Avignonet)"
    ]
  },
