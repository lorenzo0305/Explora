  "rdfs:comment": {
    "de": [
      "Gemütliches Restaurant, das geschmackvoll in Trendfarben eingerichtet ist. Großzügige und leckere Küche."
    ],
    "en": [
      "Céline and Olivier have the pleasure of welcoming you to a new setting. Restaurant with trendy decoration, slow-cooked stews and homemade dessert. Friendly welcome, their mission: make sure their customers have a great time."
    ],
    "it": [
      "Accogliente ristorante arredato con gusto e con colori di tendenza. Cucina generosa e gourmet."
    ],
    "fr": [
      "Restaurant cosy décoré avec gout aux couleurs tendance. Cuisine généreuse et gourmande."
    ],
    "nl": [
      "Céline en Olivier nodigen u graag uit in een geheel nieuwe omgeving. Restaurant met trendy inrichting, langzaam gegaarde gerechten en huisgemaakte desserts. Vriendelijke ontvangst, hun doel: de gasten een prettige tijd bezorgen."
    ],
    "es": [
      "Acogedor restaurante decorado con gusto en colores de moda. Cocina generosa y gourmet."
    ]
  },
