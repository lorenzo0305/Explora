  "rdfs:comment": {
    "de": [
      "Ihr Sportgeschäft im Herzen des Dorfes - Magasin Sport 2000.\r\nIm Winter, Alle Gleitsportarten und Schneeschuhwandern im Winter.\r\nIm Sommer: Wandern, Trailrunning, Klettern, Lifestyle und Mountainbiking (Verleih und/oder begleitete Touren)."
    ],
    "en": [
      "Your sports shop located in the heart of the village - Magasin Sport 2000\r\nIn winter, all snow sports and snowshoeing.\r\nIn summer, hiking, trail running, climbing, lifestyle and mountain biking (hire and/or guided tours)"
    ],
    "it": [
      "Il vostro negozio di articoli sportivi nel cuore del villaggio - Magasin Sport 2000\r\nIn inverno, tutti gli sport invernali e le racchette da neve.\r\nIn estate, escursioni, trail running, arrampicata, lifestyle e mountain bike (noleggio e/o uscite guidate)"
    ],
    "fr": [
      "Votre magasin de sport situé au cœur du village - Magasin Sport 2000\r\nEn hiver, Tous les sports de glisse et la raquette en hiver.\r\nEn Eté, la randonnée, la pratique du trail, l'escalade, le lifestyle et le VTT (location et/ou sorties accompagnées)"
    ],
    "nl": [
      "Uw sportwinkel in het hart van het dorp - Magasin Sport 2000\r\nVoor wandelen, trailrunnen, klimmen, lifestyle en mountainbiken (verhuur en/of begeleide tochten) in de zomer\r\nen alle boardsporten en sneeuwschoenwandelen in de winter"
    ],
    "es": [
      "Su tienda de deportes en el corazón del pueblo - Magasin Sport 2000\r\nEn invierno, todos los deportes de invierno y raquetas de nieve.\r\nEn verano, senderismo, trail running, escalada, lifestyle y BTT (alquiler y/o salidas guiadas)"
    ]
  },
