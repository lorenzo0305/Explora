  "rdfs:comment": {
    "de": [
      "Überdachter und beheizter Petanque-Platz. Ausübung in der Freizeit (ohne Lizenz). Geöffnet:\n- donnerstag: von 13.30 bis 20 Uhr ohne Wettbewerb für alle offen\n- samstag: Freizeitwettbewerb in Doublette offen für alle\n- sonntag: Triplette-Wettbewerb für alle offen"
    ],
    "en": [
      "Covered and heated petanque ground. Leisure practice (without licence). Open to all:\n- thursday: from 1.30 pm to 8 pm without competition open to all\n- saturday : double leisure contest open to all\n- sunday : triplet contest open to all"
    ],
    "it": [
      "Campo da bocce coperto e riscaldato. Pratica nel tempo libero (senza licenza). Aperto il :\n- giovedì: dalle 13.30 alle 20.00 senza concorso aperto a tutti\n- sabato: gara di doppiette per il tempo libero aperta a tutti\n- domenica: gara di triplette aperta a tutti"
    ],
    "fr": [
      "Terrain de pétanque couvert et chauffé. Pratique en loisirs (sans licence). Ouvert  :\n- jeudi : de 13h30 à 20h sans concours ouvert à tous\n- samedi : concours loisirs en doublette ouvert à tous\n- dimanche : concours en triplette ouvert à tous"
    ],
    "es": [
      "Pista de petanca cubierta y climatizada. Ejercicio del ocio (sin licencia). Abierto el :\n- jueves: de 13:30 a 20:00 horas sin concurso abierto a todos\n- sábado: concurso de dobles de ocio abierto a todos\n- domingo: concurso de trillizos abierto a todos"
    ],
    "nl": [
      "Overdekte en verwarmde petanquebaan. Praktijk in de vrije tijd (zonder vergunning). Open op :\n- donderdag: van 13.30 tot 20.00 uur zonder wedstrijd open voor iedereen\n- zaterdag: vrijetijdsdoubletwedstrijd open voor iedereen\n- zondag: tripletwedstrijd open voor iedereen"
    ]
  },
  "rdfs:label": {
