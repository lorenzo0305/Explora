      "dc:description": {
        "de": [
          "Nehmen Sie an einem kommentierten Spaziergang durch den Staatswald von Hez-Froidmont teil, der vom Office National des Forêts begleitet wird. Anmeldung erforderlich julien.lefevre@onf.fr/ 06.21.50.79.69"
        ],
        "en": [
          "Join the Office National des Forêts for a guided tour of the Hez-Froidmont national forest. Registration required julien.lefevre@onf.fr/ 06.21.50.79.69"
        ],
        "it": [
          "Unitevi all'Office National des Forêts per un'escursione guidata nella foresta nazionale di Hez-Froidmont. Iscrizione obbligatoria julien.lefevre@onf.fr/ 06.21.50.79.69"
        ],
        "fr": [
          "Venez participer à une ballade commentée en forêt domaniale de Hez-Froidmont en compagnie de l'Office National des Forêts. Inscription obligatoire julien.lefevre@onf.fr/ 06.21.50.79.69"
        ],
        "es": [
          "Únase a la Office National des Forêts para un paseo guiado por el bosque nacional de Hez-Froidmont. Inscripción obligatoria julien.lefevre@onf.fr/ 06.21.50.79.69"
        ],
        "nl": [
          "Ga mee met het Office National des Forêts voor een begeleide wandeling door het nationale bos van Hez-Froidmont. Registratie verplicht julien.lefevre@onf.fr/ 06.21.50.79.69"
        ]
      },
