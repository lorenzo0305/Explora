  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee4fbc3e-2979-367c-b303-3a360fedbdd3",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Hallal-Fleisch\n\nTage der Öffnung:\n\nDienstag bis Sonntag von 9:00 bis 12:00 Uhr und von 15:00 bis 17:00 oder 18:00 Uhr\n\nBestellungen :\n\nTelefonische Bestellungen sind unter der Nummer 03 21 60 75 96 möglich\n\nLieferung :\n\nInnerhalb eines Radius von 10 km um den Laden, ohne Lieferkosten\n\nAbholung :\n\nZum Mitnehmen während der Öffnungszeiten des Ladens\n "
        ],
        "en": [
          "Information :\n\nProducts : Hallal meat\n\nOpening days:\n\nTuesday to Sunday from 9:00 to 12:00 and from 15:00 to 17:00 or 18:00\n\nOrders :\n\nOrder by phone 03 21 60 75 96\n\nDelivery :\n\nWithin a 10km radius of the store, no delivery charge\n\nCollection:\n\nTakeaway during store opening hours\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti : Carne Hallal\n\nGiorni di apertura:\n\nDa martedì a domenica dalle 9:00 alle 12:00 e dalle 15:00 alle 17:00 o 18:00\n\nOrdini :\n\nGli ordini possono essere effettuati per telefono al numero 03 21 60 75 96\n\nConsegna :\n\nEntro un raggio di 10 km dal negozio, nessun costo di consegna\n\nRitiro:\n\nDa asporto durante gli orari di apertura del negozio\n "
        ],
        "fr": [
          "Informations :\n\nProduits : viandes Hallal\n\nJours d'ouverture:\n\nDu mardi au dimanche de 9h00 à 12h00 et de 15h00 à 17h00 ou 18h00\n\nCommandes :\n\nPossibilité de commander par téléphone au  03 21 60 75 96\n\nLivraison :\n\nDans un rayon de 10km autour du magasin, sans frais de livraison\n\nRetrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten : Hallal vlees\n\nOpeningsdagen:\n\nDinsdag tot zondag van 9:00 tot 12:00 en van 15:00 tot 17:00 of 18:00\n\nBestellingen :\n\nBestellingen kunnen telefonisch geplaatst worden op 03 21 60 75 96\n\nLevering :\n\nBinnen een straal van 10km van de winkel, geen verzendingskosten\n\nOphalen:\n\nAfhalen tijdens openingstijden van de winkel\n "
        ],
        "es": [
          "Más información :\n\nProductos : Carne de hallal\n\nDías de apertura:\n\nDe martes a domingo de 9:00 a 12:00 y de 15:00 a 17:00 o 18:00\n\nPedidos :\n\nPuede hacer su pedido por teléfono llamando al 03 21 60 75 96\n\nEntrega :\n\nEn un radio de 10 km de la tienda, sin gastos de envío\n\nRecogida:\n\nPara llevar durante el horario de apertura de la tienda\n "
        ]
      },
