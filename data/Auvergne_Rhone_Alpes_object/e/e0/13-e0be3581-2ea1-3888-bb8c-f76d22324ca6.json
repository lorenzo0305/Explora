  "rdfs:comment": {
    "de": [
      "Der Departementsrat ist die beschlussfassende Versammlung eines Departements, die in allgemeinen Wahlen im Rahmen der Kantone gewählt wird."
    ],
    "en": [
      "The departmental council is the deliberative assembly of a department, elected by universal suffrage within the framework of the cantons."
    ],
    "it": [
      "Il Consiglio dipartimentale è l'assemblea deliberativa di un dipartimento, eletta a suffragio universale nell'ambito dei Cantoni."
    ],
    "fr": [
      "Le conseil départemental est l'assemblée délibérante d'un département, élue au suffrage universel dans le cadre des cantons."
    ],
    "es": [
      "El consejo departamental es la asamblea deliberante de un departamento, elegida por sufragio universal en el marco de los cantones."
    ],
    "nl": [
      "De departementale raad is de raadgevende vergadering van een departement, verkozen via algemene verkiezingen in het kader van de kantons."
    ]
  },
