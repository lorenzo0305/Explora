  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/49d98ce6-24b8-3116-a12f-c96501dca47a",
      "dc:description": {
        "de": [
          "12. Ludo Beach Tour\nGroße Woche des Strandvolleyballs.\nSamstag, 2. August \"Ludo Freizeit\" (2x2)\nSonntag, 3. August \"Sunday money\" (3x3)\n4. bis 8. August ab 14:30 Uhr Turniere mit Preisgeldern"
        ],
        "en": [
          "12th Ludo Beach Tour\nBeach Volleyball Week.\nSaturday August 2 \"Ludo loisir\" (2x2)\nSunday, August 3 \"Sunday money\" (3x3)\nAugust 4 to 8 from 2:30 p.m. Tournaments with prizes"
        ],
        "it": [
          "12° Ludo Beach Tour\nSettimana di beach volley.\nSabato 2 agosto \"Ludo loisir\" (2x2)\nDomenica 3 agosto \"Sunday money\" (3x3)\nDal 4 all'8 agosto dalle 14.30 tornei a premi"
        ],
        "fr": [
          "12ème Ludo Beach Tour\nGrande Semaine du volley de Plage.\nSamedi 2 août « Ludo loisir » (2x2)\nDimanche 3 août « Sunday money » (3x3)\nDu 4 au 8 août à partir de 14h30 tournois avec dotations"
        ],
        "nl": [
          "12e Ludo Strandtour\nWeek van het strandvolleybal.\nZaterdag 2 augustus \"Ludo loisir\" (2x2)\nZondag 3 augustus \"Sunday money\" (3x3)\nVan 4 tot 8 augustus vanaf 14u30 toernooien met prijzen"
        ],
        "es": [
          "12º Ludo Beach Tour\nSemana de voleibol de playa.\nSábado 2 de agosto \"Ludo loisir\" (2x2)\nDomingo 3 de agosto \"Ludo loisir\" (3x3)\nDel 4 al 8 de agosto a partir de las 14h30 torneos con premios"
        ]
      },
      "@type": [
        "Description"
      ],
