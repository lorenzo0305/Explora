  "rdfs:comment": {
    "de": [
      "Reflexologin und Aromatologin (Guerineau-Methode): Fuß-, Hand- und Gesichtsreflexzonenmassage. Beratung in Aromatherapie und Mikronährstoffen. Protokoll der traditionellen und energetischen Pflege aus Laos\r\n(für alle zugänglich). Workshops zum besseren Wohlbefinden. Boutique mit natürlichen Produkten."
    ],
    "en": [
      "Aromatic reflexologist (Guerineau method), plantar, palm and facial reflexology. Aromatherapy and olfactology advice. Energy balancing: Laos treatment (accessible to all). Well-being and spirituality workshops. Nomadic, lively boutique."
    ],
    "it": [
      "Riflessologa plantare, palmare e facciale e aromatologa (metodo Guerineau). Consigli di aromaterapia e micro-nutrizione. Trattamenti tradizionali ed energetici dal Laos\r\n(accessibili a tutti). Laboratori di benessere. Negozio di prodotti naturali."
    ],
    "fr": [
      "Réflexologue et aromatologue (méthode Guerineau) plantaire, palmaire, faciale. Conseils en aromathérapie et micro-nutrition. Protocole de soins traditionnels et énergétiques du Laos\r\n(accessible à tous). Ateliers Mieux-être. Boutique de produits naturels."
    ],
    "nl": [
      "Voet-, handpalm- en gezichtsreflexoloog en aromatoloog (Guerineau-methode). Aromatherapie en microvoedingsadvies. Traditionele en energetische behandelingen uit Laos\r\n(toegankelijk voor iedereen). Wellness workshops. Winkel met natuurlijke producten."
    ],
    "es": [
      "Reflexóloga podal, palmar y facial y aromatóloga (método Guerineau). Asesoramiento en aromaterapia y micronutrición. Tratamientos tradicionales y energéticos de Laos\r\n(accesibles a todos). Talleres de bienestar. Tienda de productos naturales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rainbows and Roses, réflexologue et aromatologue"
    ]
  },
