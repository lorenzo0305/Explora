  "rdfs:comment": {
    "de": [
      "Der permanente Orientierungsparcours der Wolfshöhle bietet Ihnen 2 Routen mit unterschiedlichen Schwierigkeitsgraden, die vom Maison du lac oder von der Kirche von Nances aus starten.\r\nKarte im Tourismusbüro erhältlich."
    ],
    "en": [
      "The orienteering circuit of the Grotte du Loup offers you 2 routes of different levels starting from the Maison du Lac or the church of Nances.\r\nMap available at the tourist office."
    ],
    "it": [
      "Il percorso permanente di orientamento alla grotte au loup offre 2 percorsi di diverso livello, con partenza dalla Maison du lac o dalla chiesa di Nances.\r\nMappa disponibile presso l'ufficio turistico."
    ],
    "fr": [
      "Le parcours permanent d'orientation de la grotte au loup vous propose 2 itinéraires de niveaux différents au départ de la Maison du lac ou depuis l'église de Nances.\r\nCarte disponible à l'office de tourisme."
    ],
    "nl": [
      "Het permanente oriëntatieparcours bij de grotte au loup biedt 2 routes van verschillende niveaus, met vertrek vanaf het Maison du lac of vanaf de kerk in Nances.\r\nKaart verkrijgbaar bij het toeristenbureau."
    ],
    "es": [
      "El sendero permanente de orientación de la grotte au loup ofrece 2 recorridos de diferentes niveles, con salida desde la Maison du lac o desde la iglesia de Nances.\r\nMapa disponible en la oficina de turismo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orienteering circuit of the Grotte du Loup"
    ],
    "fr": [
      "Parcours d'orientation de la Grotte du Loup"
    ]
  },
