  "rdfs:comment": {
    "de": [
      "La Cabane in Gannay-sur-Loire ist ein Restaurant mit traditioneller französischer Küche, die aus hochwertigen lokalen Produkten zubereitet wird, und einem herrlichen Blick auf den Loire-Kanal. Die abwechslungsreiche Speisekarte ist für jeden Geschmack und Appetit geeignet."
    ],
    "en": [
      "La Cabane in Gannay-sur-Loire is a restaurant offering traditional French cuisine prepared from quality local products, with a magnificent view of the Loire Canal. The varied menu suits all tastes and appetites."
    ],
    "it": [
      "La Cabane di Gannay-sur-Loire è un ristorante che offre una cucina tradizionale francese preparata con prodotti locali di qualità, con una magnifica vista sul Canale della Loira. Il menu, molto vario, soddisfa tutti i gusti e gli appetiti."
    ],
    "fr": [
      "La Cabane à Gannay-sur-Loire est un restaurant offrant une cuisine traditionnelle française préparée à partir de produits locaux de qualité, avec une vue magnifique sur le canal de la Loire. Le menu varié convient à tous les goûts et appétits."
    ],
    "es": [
      "La Cabane, en Gannay-sur-Loire, es un restaurante de cocina tradicional francesa elaborada con productos locales de calidad, con magníficas vistas al canal del Loira. La carta es variada y se adapta a todos los gustos y apetitos."
    ],
    "nl": [
      "La Cabane in Gannay-sur-Loire is een restaurant met een traditionele Franse keuken bereid met lokale kwaliteitsproducten, met een prachtig uitzicht op het Loire-kanaal. Het gevarieerde menu komt tegemoet aan alle smaken en voorkeuren."
    ]
  },
  "rdfs:label": {
