  "rdfs:comment": {
    "de": [
      "Filme mit großem Unterhaltungswert, Komödien, Jugendfilme\r\npublikum, Autorenfilme, französische Version oder\r\noriginalfilm, jeder findet hier sein Glück.\r\nQualitativ hochwertige Ausstattung: mit einem\r\ndigitalprojektor, 7 m Leinwand und Ton\r\ndolby 7.1. Animationen."
    ],
    "en": [
      "Films for the big screen, comedies\r\nauteur films, French or original versions\r\nthere's something for everyone.\r\nQuality equipment: equipped with a digital\r\nprojector, 7m screen and dolby\r\ndolby 7.1 sound. Entertainment."
    ],
    "it": [
      "Blockbuster, commedie, film per giovani\r\ne film d'essai, in francese o in originale\r\nce n'è per tutti i gusti.\r\nAttrezzature di qualità: dotate di proiettore digitale\r\nproiettore digitale, schermo da 7 m e audio dolby\r\ndolby 7.1. Intrattenimento dal vivo."
    ],
    "fr": [
      "Films grand spectacle, comédies, jeune\r\npublic, films d’auteur, version française ou\r\noriginale, chacun trouvera son bonheur.\r\nDes équipements de qualité : équipé d’un\r\nprojecteur numérique, écran de 7m et son\r\ndolby 7.1. Animations."
    ],
    "es": [
      "Éxitos de taquilla, comedias, películas para jóvenes\r\ny cine de autor, en francés u original\r\nhay para todos los gustos.\r\nEquipamiento de calidad: proyector\r\npantalla de 7 m y sonido dolby\r\nsonido dolby 7.1. Animación en directo."
    ],
    "nl": [
      "Kassuccessen, komedies, jeugdfilms\r\nen arthousefilms, in het Frans of origineel\r\ner is voor elk wat wils.\r\nKwaliteitsuitrusting: uitgerust met een digitale\r\nprojector, 7m scherm en dolby\r\ndolby 7.1 geluid. Live entertainment."
    ]
  },
