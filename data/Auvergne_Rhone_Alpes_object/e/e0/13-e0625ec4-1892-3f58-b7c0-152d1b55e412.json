  "rdfs:comment": {
    "de": [
      "Sie werden den Boden der Schönen Künste entdecken, der dem Landschaftsmaler Charles Beauverie (1839-1923) gewidmet ist. Viele Wechselausstellungen erwarten Sie."
    ],
    "en": [
      "You will discover the Fine Arts floor dedicated to the landscape painter Charles Beauverie (1839-1923). Many temporary exhibitions await you."
    ],
    "it": [
      "Il 1° piano del Musée de Feurs ripercorre la storia della città di Feurs dalla preistoria ai giorni nostri. Il secondo piano è dedicato all'artista Charles Beauverie, pittore di paesaggi della fine del XIX e dell'inizio del XX secolo."
    ],
    "fr": [
      "Le musée de Feurs retrace, au 1er étage, l’Histoire de la ville de Feurs de la période préhistorique jusqu’à nos jours. Le 2ème étage est consacré à l'artiste Charles Beauverie., peintre paysagiste de la fin du 19e début 20e siècle."
    ],
    "es": [
      "La 1ª planta del Museo de Feurs recorre la historia de la ciudad de Feurs desde la prehistoria hasta nuestros días. La 2ª planta está dedicada al artista Charles Beauverie, pintor paisajista de finales del siglo XIX y principios del XX."
    ],
    "nl": [
      "De 1e verdieping van het Musée de Feurs vertelt de geschiedenis van de stad Feurs van de prehistorie tot nu. De 2e verdieping is gewijd aan de kunstenaar Charles Beauverie, een landschapsschilder uit de late 19e en vroege 20e eeuw."
    ]
  },
