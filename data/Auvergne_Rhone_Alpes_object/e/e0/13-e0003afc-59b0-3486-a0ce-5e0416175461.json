  "rdfs:comment": {
    "de": [
      "Bar, Restaurant, Pizzeria mit Mahlzeiten aus frischen Zutaten und hausgemachten Desserts. Jeden Tag geöffnet. Vom 01/05 bis 30/09 mittags und abends geöffnet, vom 01/10 bis 31/04 nur mittags. Reservierung empfohlen."
    ],
    "en": [
      "Carte. Pizzeria. Brasserie and traditional cuisine. Booking advised. Wifi access."
    ],
    "it": [
      "Bar, ristorante, pizzeria che serve piatti cucinati con prodotti freschi e dolci fatti in casa. Aperto tutti i giorni. Ristorante aperto a pranzo e a cena dal 01/05 al 30/09 e solo a pranzo dal 01/10 al 31/04. Si consiglia la prenotazione."
    ],
    "fr": [
      "Bar, Restaurant, Pizzeria proposant des repas cuisinés à base de produits frais, desserts maison. Ouvert tous les jours. Restauration ouverte midi et soir du 01/05 au 30/09 et uniquement le midi du 01/10 au 31/04. Réservation recommandée."
    ],
    "es": [
      "Bar, restaurante, pizzería que sirve comidas cocinadas con productos frescos y postres caseros. Abierto todos los días. Restaurante abierto para el almuerzo y la cena del 01/05 al 30/09 y sólo para el almuerzo del 01/10 al 31/04. Se recomienda reservar."
    ],
    "nl": [
      "A la carte. Pizzeria. Brasserie en traditionele keuken. Reservering aanbevolen. Wifi verbinding."
    ]
  },
