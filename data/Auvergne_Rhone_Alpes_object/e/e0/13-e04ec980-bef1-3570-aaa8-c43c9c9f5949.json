  "rdfs:comment": {
    "de": [
      "Im Weiler La Diat beginnt eine Strecke mit 11 Markierungen, die sich ideal für den Einstieg in den Orientierungslauf eignet. Die Broschüre enthält zu jeder Markierung eine Frage oder ein kleines Quiz über das Kulturerbe von La Diat."
    ],
    "en": [
      "Starting from the hamlet of La Diat, an 11-marker route ideal for beginners in orienteering. Each marker is accompanied by a question or quiz on the heritage of La Diat."
    ],
    "it": [
      "Partendo dalla frazione di La Diat, questo percorso di 11 segnalini è il modo perfetto per iniziare a praticare l'orienteering. Ogni punto è accompagnato da una domanda o da un quiz sul patrimonio di La Diat."
    ],
    "fr": [
      "Au départ du hameau de La Diat, un parcours de 11 balises idéal pour débuter la course d’orientation. A chaque balise le dépliant est agrémenté d’une question ou d’un petit quizz sur le patrimoine de La Diat."
    ],
    "es": [
      "Empezando en la aldea de La Diat, esta ruta de 11 balizas es la manera perfecta de iniciarse en la orientación. Cada baliza va acompañada de una pregunta o un cuestionario sobre el patrimonio de La Diat."
    ],
    "nl": [
      "Deze route met 11 markeringen begint in het gehucht La Diat en is de perfecte manier om te beginnen met oriëntatielopen. Bij elke markering hoort een vraag of quiz over het erfgoed van La Diat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la découverte de la Diat - parcours d'orientation"
    ]
  },
