  "rdfs:comment": {
    "de": [
      "Traditionelles Speiseeis und Sorbets. Seit einer Reise nach Italien widmen sich die beiden Zwillingsbrüder Guillaume und Nicolas der Kreation von traditionell hergestellten Eissorten und Sorbets. Über 25 Sorten, im Salon oder zum Mitnehmen."
    ],
    "en": [
      "Craft ice-creams and sorbets. After a trip to Italy, twin brothers Guillaume and Nicolas set about creating refined, natural craft ice-cream. More than 25 flavours to taste at the exhibition/shop, or take away."
    ],
    "it": [
      "Cedete al piacere del gelato con Gemelli! Venite a gustare i nostri Gelati e Sorbetti naturali e gustosi, prodotti in Francia (in Provenza dove cantano le cicale) senza additivi né conservanti."
    ],
    "fr": [
      "Succombez au plaisir glacé avec Gemelli ! Venez déguster nos Gelati et Sorbetti naturels et savoureux mais surtout Made in France (en  Provence où chantent les cigales) sans additif et sans conservateur."
    ],
    "es": [
      "¡Ríndase al placer del helado con Gemelli! Venga a degustar nuestros Gelati y Sorbetti naturales y sabrosos, elaborados en Francia (en la Provenza donde cantan las cigarras) sin aditivos ni conservantes."
    ],
    "nl": [
      "IJs en sorbets. Na hun reis naar Italië gingen Guillaume en Nicolas, weelingbroers, aan de slag om verfijnd en natuurlijk ambachtelijk ijs te creëren. Meer dan 25 smaken om te proeven in de winkel of om mee te nemen."
    ]
  },
