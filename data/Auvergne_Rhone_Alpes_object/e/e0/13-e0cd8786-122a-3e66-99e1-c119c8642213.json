  "rdfs:comment": {
    "de": [
      "Reitzentrum, Ponyclub, Pension. Unser Team aus staatlich geprüften Lehrern bietet Ihnen zahlreiche Aktivitäten an: vom Baby-Pony (ab 3 Jahren) bis zu erwachsenen Reitern, von der Entdeckung bis zum Wettkampf in den drei olympischen Disziplinen."
    ],
    "en": [
      "Riding centre, pony club, bording horses. Our team of instructors offers you many activities: from baby pony (3+ years old) to adults rider, from discovery to competition in three olympic disciplines."
    ],
    "it": [
      "Centro ippico, pony club, pensione. Il nostro team di istruttori qualificati offre un'ampia gamma di attività: dai baby pony (a partire dai 3 anni) ai cavalieri adulti, dalla scoperta alla competizione nelle tre discipline olimpiche."
    ],
    "fr": [
      "Centre équestre, poney club, pension. Notre équipe d’enseignants diplômés d’État vous propose de nombreuses activités : du baby-poney (dès 3 ans) aux cavaliers adultes, de la découverte à la compétition dans les trois disciplines olympiques."
    ],
    "nl": [
      "Manege, ponyclub, pension. Ons team van staatsgediplomeerde leraren biedt een breed scala aan activiteiten: van baby pony's (vanaf 3 jaar) tot volwassen ruiters, van ontdekking tot competitie in de drie Olympische disciplines."
    ],
    "es": [
      "Centro ecuestre, club de ponis, pensión. Nuestro equipo de monitores cualificados por el Estado ofrece una amplia gama de actividades: desde bebés ponis (a partir de 3 años) hasta jinetes adultos, desde el descubrimiento hasta la competición en las tres disciplinas olímpicas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Riding lessons with Alba Équitation"
    ],
    "fr": [
      "Centre équestre \"Alba Équitation\""
    ]
  },
