  "rdfs:comment": {
    "de": [
      "Sie vereint alle, die die Briefmarke und alles, was sie umgibt, lieben: Sammlungen nach Ländern, Monographien, Postgeschichte, thematische Sammlungen, Marcophilie, Kartophilie, Numismatik, etc."
    ],
    "en": [
      "It brings together all those who love stamps and the things that surround them: collections by country, monographs, postal history, thematic collections, marcophily, cartophily, numismatics, etc..."
    ],
    "it": [
      "Riunisce tutti coloro che amano i francobolli e i loro dintorni: collezioni per paese, monografie, storia postale, collezioni tematiche, marcofilia, cartofilia, numismatica, ecc."
    ],
    "fr": [
      "Elle réunit tous ceux qui aiment le timbre et ce qui l'entoure : collections par pays, monographies, histoire postale, collections thématiques, marcophilie, cartophilie, numismatique, etc..."
    ],
    "es": [
      "Reúne a todos los amantes de los sellos y su entorno: colecciones por países, monografías, historia postal, colecciones temáticas, marcofilia, cartografía, numismática, etc."
    ],
    "nl": [
      "Het brengt iedereen samen die houdt van postzegels en de dingen die ze omringen: collecties per land, monografieën, postgeschiedenis, thematische collecties, marcofilie, cartofilie, numismatiek, enz."
    ]
  },
  "rdfs:label": {
