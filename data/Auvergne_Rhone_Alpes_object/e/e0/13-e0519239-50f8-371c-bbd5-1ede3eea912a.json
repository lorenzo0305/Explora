  "rdfs:comment": {
    "de": [
      "20. Ausgabe des Wein- und Gourmetfestivals im Gebiet des St-Pourçain. neun Tage lang wird im gesamten Gebiet des St-Pourçain gefeiert, um das Terroir, die Gastronomie und die Weine des St-Pourçain in den Vordergrund zu stellen."
    ],
    "en": [
      "20th edition of the St-Pourçain wine and food festival. 9 days of festivities across the St-Pourçain region, showcasing the terroir, gastronomy and wines of St-Pourçain."
    ],
    "it": [
      "20a edizione del Festival enogastronomico di St-Pourçain. 9 giorni di festeggiamenti in tutta la regione dello St-Pourçain per presentare il terroir, la gastronomia e i vini dello St-Pourçain."
    ],
    "fr": [
      "20ème édition du festival viticole et gourmand sur le territoire du St-Pourçain. 9 jours de fêtes a travers le territoire du St-Pourçain pour la mise en avant du terroir, de la gastronomie et des vins de St-Pourçain."
    ],
    "nl": [
      "20e editie van het wijn- en gastronomiefestival van St-Pourçain. 9 dagen lang festiviteiten in de hele regio St-Pourçain om het terroir, de gastronomie en de wijnen van St-Pourçain onder de aandacht te brengen."
    ],
    "es": [
      "20ª edición del festival enogastronómico de St-Pourçain. 9 días de fiesta por toda la región de St-Pourçain para dar a conocer el terruño, la gastronomía y los vinos de St-Pourçain."
    ]
  },
