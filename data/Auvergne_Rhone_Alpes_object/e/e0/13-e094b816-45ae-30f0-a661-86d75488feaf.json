  "rdfs:comment": {
    "de": [
      "Das Debussy-Quartett hat sich im Herzen von Lyon mit einem einzigartigen Raum niedergelassen, der sich der musikalischen Vermittlung und der kulturellen Öffnung widmet. Es lädt die Einwohner Lyons ein, die Kunst des Streichquartetts in kostenlosen Konzertreihen zu entdecken."
    ],
    "en": [
      "The Debussy Quartet has established itself in the heart of Lyon with a unique space dedicated to musical education and cultural openness. It invites the people of Lyon to discover the art of the string quartet in a series of free concerts."
    ],
    "it": [
      "Il Quatuor Debussy si è stabilito nel cuore di Lione con uno spazio unico dedicato alla trasmissione musicale e all'apertura culturale. Invita i lionesi a scoprire l'arte del quartetto d'archi in una serie di concerti gratuiti."
    ],
    "fr": [
      "Le Quatuor Debussy s’est implanté au cœur de Lyon avec un espace unique, voué à la transmission musicale et à l’ouverture culturelle. Il invite les Lyonnais à découvrir l’art du quatuor à cordes dans des séries de concerts gratuits."
    ],
    "nl": [
      "Het Quatuor Debussy heeft zich gevestigd in het hart van Lyon met een unieke ruimte gewijd aan muzikale overdracht en culturele openheid. Het nodigt de inwoners van Lyon uit om de kunst van het strijkkwartet te ontdekken in een reeks gratis concerten."
    ],
    "es": [
      "El Quatuor Debussy se ha instalado en el corazón de Lyon con un espacio único dedicado a la transmisión musical y la apertura cultural. Invita a los lioneses a descubrir el arte del cuarteto de cuerda en una serie de conciertos gratuitos."
    ]
  },
