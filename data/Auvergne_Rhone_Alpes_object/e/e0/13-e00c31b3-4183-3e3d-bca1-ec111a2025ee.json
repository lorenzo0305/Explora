  "rdfs:comment": {
    "de": [
      "Die Kirche von Saint-Martin-d'Hostun, die seit 1978 im Zusatzinventar der historischen Monumente aufgeführt ist, wurde an den ersten Ausläufern des Vercors am Fuße der Monts du Matin errichtet."
    ],
    "en": [
      "The church of Saint-Martin-d'Hostun, listed on the Supplementary Inventory of Historic Monuments since 1978, is built in the foothills of the Vercors, at the foot of the Monts du Matin."
    ],
    "it": [
      "La chiesa di Saint-Martin-d'Hostun, iscritta nell'inventario supplementare dei monumenti storici dal 1978, è costruita sulle prime propaggini del Vercors, ai piedi dei Monts du Matin."
    ],
    "fr": [
      "L'église de Saint-Martin-d'Hostun, inscrite sur l'inventaire supplémentaire des Monuments Historiques depuis 1978, est construite sur les premiers contreforts du Vercors, au pied des Monts du Matin."
    ],
    "es": [
      "La iglesia de Saint-Martin-d'Hostun, inscrita en el inventario suplementario de monumentos históricos desde 1978, está construida en las primeras estribaciones del Vercors, al pie de los Montes del Matin."
    ],
    "nl": [
      "De kerk Saint-Martin-d'Hostun, sinds 1978 opgenomen in de Aanvullende Inventaris van Monumenten, is gebouwd in de uitlopers van de Vercors, aan de voet van de Monts du Matin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise de Saint-Martin-d'Hostun"
    ]
  },
