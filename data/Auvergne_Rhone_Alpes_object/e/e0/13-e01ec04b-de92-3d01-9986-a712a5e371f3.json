  "rdfs:comment": {
    "de": [
      "Am Platz des Dorfes restaurierend."
    ],
    "en": [
      "Restaurant located on the main square of the village"
    ],
    "it": [
      "Ristorante sulla piazza del paese. Menu di montagna con specialità dello chef (ravioli gratinati ai funghi porcini e crostata di mirtilli). Creazioni di cocktail caldi e freddi. Crêpes, gelati e cialde."
    ],
    "fr": [
      "Restaurant sur la place du village. Formule montagne avec les spécialités du  chef ( gratin de ravioles aux cèpes et tarte aux myrtilles). Cocktail chaud et froid en création. Crêpes, glaces et gaufres."
    ],
    "es": [
      "Restaurante en la plaza del pueblo. Menú de montaña con especialidades del chef (gratinado de raviolis con setas porcini y tarta de arándanos). Creaciones de cócteles fríos y calientes. Crepes, helados y gofres."
    ],
    "nl": [
      "Restaurant op het dorpsplein. Bergmenu met specialiteiten van de chef (gegratineerde ravioli met eekhoorntjesbrood en bosbessentaart). Warme en koude cocktailcreaties. Crêpes, ijs en wafels."
    ]
  },
