  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Martial stammt aus dem 19. Jahrhundert. Sie ist die Nachfolgerin einer älteren Kirche, die einst demselben Heiligen geweiht war und nur wenige Straßen von ihr entfernt errichtet wurde."
    ],
    "en": [
      "The Église Saint-Martial dates from the 19th century.It replaced an older church that had been dedicated to the same saint, and erected a few streets away."
    ],
    "it": [
      "La chiesa di Saint-Martial risale al XIX secolo. È il successore di una chiesa precedente dedicata allo stesso santo, costruita a poche strade di distanza."
    ],
    "fr": [
      "L’église Saint-Martial date du 19e siècle. Elle succède à une église plus ancienne autrefois dédiée au même saint et érigée à quelques rues de celle-ci."
    ],
    "es": [
      "La iglesia Saint-Martial data del siglo XIX. Es la sucesora de una iglesia anterior dedicada al mismo santo, construida a pocas calles de distancia."
    ],
    "nl": [
      "De Saint-Martial kerk dateert uit de 19e eeuw. Het is de opvolger van een eerdere kerk gewijd aan dezelfde heilige, die een paar straten verderop werd gebouwd."
    ]
  },
