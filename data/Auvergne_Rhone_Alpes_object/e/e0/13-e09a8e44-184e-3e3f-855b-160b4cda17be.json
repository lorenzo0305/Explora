  "rdfs:comment": {
    "de": [
      "Intersport, der Spezialist für den Verkauf von Sportgeräten, bietet Ihnen den Kauf von Fahrrädern, E-Bikes, Mountainbikes und Zubehör, den Verleih und einen Reparaturservice."
    ],
    "en": [
      "Intersport, the specialist sports equipment retailer, offers you the chance to buy bikes, VAEs, mountain bikes and accessories, as well as hire and a repair service."
    ],
    "it": [
      "Intersport, specialista nella vendita di attrezzature sportive, vi offre la possibilità di acquistare biciclette, mountain bike e accessori, oltre al noleggio e al servizio di riparazione."
    ],
    "fr": [
      "Intersport, le spécialiste de la vente de matériel de sport vous propose l'achat de vélos, VAE, VTT et accessoires, de la location et un service de réparation."
    ],
    "es": [
      "Intersport, especialista en venta de material deportivo, le ofrece la posibilidad de comprar bicicletas, bicicletas de montaña y accesorios, así como alquiler y un servicio de reparación."
    ],
    "nl": [
      "Intersport, de specialist in de verkoop van sportartikelen, biedt u de mogelijkheid om fietsen, mountainbikes en accessoires te kopen, alsmede verhuur en een reparatieservice."
