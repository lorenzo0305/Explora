  "rdfs:comment": {
    "de": [
      "Ein Einführungsklettersteig, der speziell für Kinder konzipiert wurde\r\nfür Kinder ab 5-6 Jahren. Der Parcours (in 2 Teilen) verläuft direkt auf dem Fort Victor-Emmanuel. Sprossen, Stege... ideal, um mit dem Klettersteig zu beginnen!"
    ],
    "en": [
      "An introductory via ferrata specially designed for\r\nfor children aged 5-6 and over. The course (in 2 parts) takes place directly on Fort Victor-Emmanuel. Bars, footbridges... ideal for beginners!"
    ],
    "it": [
      "Corso appositamente progettato per i bambini tra i 8-10 m dal suolo proprio dietro il Forte Vittorio Emanuele.\r\nAltezza minima: 1,40 m"
    ],
    "fr": [
      "Une via ferrata d’initiation spécialement conçue pour\r\nles enfants à partir de 5-6 ans. Le parcours (en 2 parties) se fait directement sur le fort Victor-Emmanuel. Barreaux, passerelles... idéal pour débuter en via !"
    ],
    "es": [
      "Una vía ferrata de iniciación especialmente diseñada para\r\npara niños a partir de 5-6 años. El recorrido (en 2 partes) pasa directamente por encima del Fuerte Victor-Emmanuel. Con peldaños y pasarelas, ¡es la forma perfecta de iniciarse!"
    ],
    "nl": [
      "Een inleidende klettersteig speciaal ontworpen voor\r\nvoor kinderen vanaf 5-6 jaar. De route (in 2 delen) loopt direct over Fort Victor-Emmanuel. Met sporten en loopbruggen is het de perfecte manier om met een klettersteig te beginnen!"
    ]
  },
