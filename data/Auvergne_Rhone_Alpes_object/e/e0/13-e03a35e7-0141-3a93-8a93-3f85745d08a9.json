  "rdfs:comment": {
    "de": [
      "Ideal gelegen im Herzen der Gemeinde MARCILLAT-EN-COMBRAILLE, ist das Château du COURTIOUX mit seinen vielfältigen Möglichkeiten der ideale Ort, um Ihre Familien-, Geschäfts- oder sonstige Veranstaltung (Event/Kultur/Themenaufenthalt) zu organisieren."
    ],
    "en": [
      "Ideally located in the heart of the commune of MARCILLAT-EN-COMBRAILLE, the Château du COURTIOUX is the ideal venue, thanks to its multiple capacities, to organize your family, professional or other event (event/cultural/themed stay)."
    ],
    "it": [
      "Situato in una posizione ideale nel cuore del comune di MARCILLAT-EN-COMBRAILLE, lo Château du COURTIOUX è il luogo ideale, grazie alle sue numerose strutture, per organizzare il vostro evento familiare, aziendale o di altro tipo (evento speciale/culturale/spazio a tema)."
    ],
    "fr": [
      "Idéalement situé au cœur de la commune de MARCILLAT-EN-COMBRAILLE, le Château du COURTIOUX est le site idéal, par ses capacités multiples, pour organiser votre évènement familial, professionnel ou divers (événementiel/culturel/séjour à thème)."
    ],
    "es": [
      "Idealmente situado en el corazón de la comuna de MARCILLAT-EN-COMBRAILLE, el Château du COURTIOUX es el lugar ideal, gracias a sus numerosas instalaciones, para organizar su evento familiar, de negocios o de otro tipo (evento especial/escapada cultural/temática)."
    ],
    "nl": [
      "Het Château du COURTIOUX, ideaal gelegen in het hart van de gemeente MARCILLAT-EN-COMBRAILLE, is dankzij de vele faciliteiten de ideale locatie voor de organisatie van uw familie-, bedrijfs- of andere evenement (speciale gebeurtenis/culturele/thematische uitstap)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château du Courtioux - Location de salles"
    ]
  },
