  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Arbeit des Holzsägens in einem authentischen Sägewerk, das von den Mitgliedern des Vereins \"La Battante Morzinoise\" wieder in Stand gesetzt wurde! Im guten Geruch von Sägemehl, dem Schaufelrad, den Zahnrädern und der Klappsäge. Ein uraltes Erbe."
    ],
    "en": [
      "Discover the work of sawing wood in an authentic sawmill, restored by members of the \"La Battante Morzinoise\" association! The smell of sawdust, the paddle wheel, the cogs and the beating saw. An ancestral heritage."
    ],
    "it": [
      "Scoprite il lavoro di segatura del legno in un'autentica segheria, restaurata dai membri dell'associazione \"La Battante Morzinoise\"! Nel buon odore della segatura, della ruota a pale, degli ingranaggi e della sega che batte. Un'eredità ancestrale."
    ],
    "fr": [
      "Découvrez le travail du sciage du bois dans une authentique scierie, remise en état par les membres de l’association « La Battante Morzinoise » ! Dans la bonne odeur de sciure, la roue à aube, les rouages et la scie battante. Un patrimoine ancestral."
    ],
    "nl": [
      "Ontdek het zagen van hout in een authentieke zagerij, gerestaureerd door leden van de vereniging \"La Battante Morzinoise\"! De geur van zaagsel, het schoepenrad, de raderen en de kloppende zaag. Een voorouderlijk erfgoed."
    ],
    "es": [
      "Descubra el trabajo de aserrado de la madera en un auténtico aserradero, restaurado por los miembros de la asociación \"La Battante Morzinoise\" En el buen olor del serrín, la rueda de paletas, los engranajes y la sierra que late. Una herencia ancestral."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guided tours of La Battante Morzinoise"
    ],
    "fr": [
      "Visites commentées de la Battante Morzinoise"
    ],
    "nl": [
      "Rondleidingen door de Battante Morzinoise"
    ]
  },
