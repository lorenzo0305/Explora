  "rdfs:comment": {
    "de": [
      "Die Villa Saint-Lager empfängt auf Anfrage kleine Gruppen (bis zu 12 Personen) für intime Seminare, private Feiern, Ehrengäste und gesellige Momente in einem eleganten Rahmen im Herzen des Beaujolais."
    ],
    "en": [
      "Villa Saint-Lager welcomes small groups (up to 12 guests), on request, for intimate seminars, private receptions, welcome drinks, and convivial gatherings in an elegant setting in the heart of Beaujolais."
    ],
    "it": [
      "Villa Saint-Lager accoglie piccoli gruppi (fino a 12 persone), su richiesta, per seminari intimi, ricevimenti privati, ricevimenti vin d'honneur e altri momenti di convivialità in un ambiente elegante nel cuore della regione del Beaujolais."
    ],
    "fr": [
      "Villa Saint-Lager accueille vos petits groupes (jusqu’à 12 personnes), sur demande, pour séminaires intimistes, réceptions privées, vin d’honneur et moments de convivialité dans un cadre élégant au cœur du Beaujolais."
    ],
    "nl": [
      "Villa Saint-Lager verwelkomt kleine groepen (tot 12 personen), op aanvraag, voor intieme seminaries, privérecepties, vin d'honneur recepties en andere momenten van gezelligheid in een elegant kader in het hart van de Beaujolais streek."
    ],
    "es": [
      "Villa Saint-Lager acoge a pequeños grupos (hasta 12 personas), previa solicitud, para seminarios íntimos, recepciones privadas, recepciones vin d'honneur y otros momentos de convivencia en un marco elegante en el corazón de la región de Beaujolais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Réceptions et séminaires à la Villa Saint Lager"
    ]
  },
