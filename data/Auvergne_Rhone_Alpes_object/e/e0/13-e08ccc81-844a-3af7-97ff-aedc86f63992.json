  "rdfs:comment": {
    "de": [
      "Organisation von außergewöhnlichen Erlebnissen im Beaujolais. Wir nehmen Sie mit auf eine Entdeckungsreise durch das Beaujolais, unsere Adressen, unsere Sicht auf die Region und ihre Bewohner."
    ],
    "en": [
      "Organising extraordinary experiences in Beaujolais. We take you on a journey of discovery through Beaujolais, sharing our favourite places and our vision of the region and its inhabitants"
    ],
    "it": [
      "Organizzazione di esperienze straordinarie nel Beaujolais. Vi accompagneremo alla scoperta della regione del Beaujolais, con i nostri indirizzi e la nostra visione del territorio e della sua gente."
    ],
    "fr": [
      "Organisation d'expériences extra-ordinaires en Beaujolais. Nous vous emmenons à la découverte du Beaujolais, nos adresses, notre vision du territoire et de ses habitants."
    ],
    "es": [
      "Organización de experiencias extraordinarias en Beaujolais. Le llevaremos a descubrir la región de Beaujolais, con nuestras direcciones y nuestra visión de la zona y sus gentes."
    ],
    "nl": [
      "Organisatie van buitengewone ervaringen in de Beaujolais. We nemen je mee op een ontdekkingstocht door de Beaujolais, met onze adressen en onze visie op het gebied en de mensen."
    ]
  },
