  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie den Geschmack eines Teigs, der lange vor Ort geknetet wurde, in der Tradition der Familie. Ich garantiere Ihnen eine hausgemachte Zubereitung aus meinen Zutaten, wobei ich mich für Frische und Zufriedenheit einsetze."
    ],
    "en": [
      "Come and savour the real flavour of a homemade pizza dough made with love an lengthy kneading in the family tradition.\r\nHomemade pizzas, without gluten, lasagnes, and more."
    ],
    "it": [
      "Venite a riscoprire il sapore della pasta impastata a lungo sul posto, secondo la tradizione di famiglia. Garantisco che tutti i miei ingredienti sono fatti in casa, all'insegna della freschezza e della soddisfazione."
    ],
    "fr": [
      "Venez retrouver la saveur d'une pâte longuement pétrie sur place,dans la tradition familiale. Je vous garantie une préparation maison de mes ingrédients, dans un engagement de fraicheur et de satisfaction."
    ],
    "es": [
      "Venga a redescubrir el sabor de la masa amasada durante mucho tiempo al momento, según la tradición familiar. Le garantizo que mis ingredientes son caseros, con un compromiso de frescura y satisfacción."
    ],
    "nl": [
      "Kom en ontdek de smaak van deeg dat lang ter plekke is gekneed, volgens de familietraditie. Ik garandeer dat al mijn ingrediënten huisgemaakt zijn, met een streven naar versheid en tevredenheid."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les pizzas d'Amphion"
    ],
    "fr": [
      "Les pizzas d'Amphion"
    ],
    "nl": [
      "De pizza's van Amphion"
    ]
  },
