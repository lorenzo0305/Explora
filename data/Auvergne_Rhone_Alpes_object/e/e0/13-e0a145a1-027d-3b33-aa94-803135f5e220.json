  "rdfs:comment": {
    "de": [
      "Le Jardin de Greta befindet sich seit drei Jahren auf der Ferme de la Mhotte, einem dritten Ort, an dem sich Landwirtschaft, Kunst, Handwerk und Pädagogik treffen."
    ],
    "en": [
      "For the past 3 years, Le Jardin de Greta has been based at the Ferme de la Mhotte, a nurturing third place where agriculture, art, crafts and education meet, nestled in the heart of the Bourbonnais bocage in the commune of Saint Menoux."
    ],
    "it": [
      "Negli ultimi 3 anni, Le Jardin de Greta ha avuto sede presso la Ferme de la Mhotte, un terzo luogo fertile in cui si incontrano agricoltura, arte, artigianato e istruzione, immerso nel cuore del bocage di Bourbonnais, nel comune di Saint Menoux."
    ],
    "fr": [
      "Le Jardin de Greta est installée depuis 3 ans à la Ferme de la Mhotte, un tiers lieux nourricier ou se croisent agriculture, art, artisanat et pédagogie nichée au cœur du bocage bourbonnais sur la commune de Saint Menoux."
    ],
    "es": [
      "Desde hace 3 años, Le Jardin de Greta tiene su sede en la Ferme de la Mhotte, un tercer lugar de encuentro entre la agricultura, el arte, la artesanía y la educación, situado en el corazón del bocage de Bourbonnais, en el municipio de Saint Menoux."
    ],
    "nl": [
      "De afgelopen 3 jaar was Le Jardin de Greta gevestigd in de Ferme de la Mhotte, een verzorgende derde plek waar landbouw, kunst, ambachten en onderwijs samenkomen, genesteld in het hart van de Bourbonnais bocage in de gemeente Saint Menoux."
    ]
  },
  "rdfs:label": {
