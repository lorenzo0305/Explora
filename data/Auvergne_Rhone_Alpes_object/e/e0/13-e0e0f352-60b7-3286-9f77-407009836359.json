  "rdfs:comment": {
    "de": [
      "Besuchen Sie mein Atelier, wo Sie die wichtigsten Schritte zur Aufarbeitung von Sitzmöbeln sehen oder verstehen können, wie man Vorhänge und Gardinen herstellt."
    ],
    "en": [
      "Come and visit my workshop, where you can see the main stages in reupholstering seats, or learn how to make curtains and drapes."
    ],
    "it": [
      "Venite a visitare il mio laboratorio, dove potrete vedere le fasi principali del rivestimento delle sedute o imparare a realizzare tende e tendaggi."
    ],
    "fr": [
      "Venez visiter mon atelier, où vous pourrez voir les principales étapes de réfection des assises, ou encore comprendre comment confectionner des rideaux et tentures."
    ],
    "es": [
      "Venga a visitar mi taller, donde podrá ver las principales etapas del retapizado de asientos, o aprender a confeccionar cortinas y visillos."
    ],
    "nl": [
      "Kom langs in mijn atelier, waar je kunt zien hoe je stoelen herstoffeert of hoe je gordijnen en draperieën maakt."
    ]
  },
