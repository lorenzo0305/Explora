  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ee59503-f130-394b-98d2-a971840455fe",
      "dc:description": {
        "de": [
          "Die Asinerie de Saint Jans Cappel liegt am Fuße des Schwarzen Berges, im Herzen der Flämischen Berge. Hier können Sie mit Eseln, gesattelt oder vor kleine Karren gespannt, wandern und die flämische Landschaft vom Schwarzen Berg bis zum Katzenberg entdecken."
        ],
        "en": [
          "Situated at the foot of Mont Noir, in the heart of the Monts de Flandres, the Asinerie de Saint Jans Cappel offers you the chance to go hiking with donkeys, saddled or harnessed to small carts, to discover the Flemish countryside, from Mont Noir to Mont des Cats."
        ],
        "it": [
          "Situata ai piedi del Mont Noir, nel cuore dei Monts de Flandres, l'Asinerie de Saint Jans Cappel vi offre la possibilità di fare una passeggiata con gli asini, sellati o legati a piccoli carri, alla scoperta della campagna fiamminga, dal Mont Noir al Mont des Cats."
        ],
        "fr": [
          "Située au pied du Mont Noir, en plein cœur des Monts de Flandres, l'Asinerie de Saint Jans Cappel vous propose de partir en randonnée avec des ânes, sellés ou attelés à de petites charrettes, pour découvrir la camapagne Flamande, du Mont Noir au Mont des Cats."
        ],
        "es": [
          "Situada a los pies del Mont Noir, en el corazón de los Montes de Flandes, la Asinerie de Saint Jans Cappel le ofrece la posibilidad de pasear con burros, ensillados o enganchados a pequeños carros, para descubrir la campiña flamenca, desde el Mont Noir hasta el Mont des Cats."
        ],
        "nl": [
          "Gelegen aan de voet van de Mont Noir, in het hart van de Monts de Flandres, biedt de Asinerie de Saint Jans Cappel je de kans om een wandeling te maken met ezels, gezadeld of vastgemaakt aan kleine karren, om het Vlaamse platteland te ontdekken, van de Mont Noir tot de Mont des Cats."
        ]
      },
