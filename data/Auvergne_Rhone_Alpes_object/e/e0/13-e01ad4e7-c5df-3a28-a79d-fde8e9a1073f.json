  "rdfs:comment": {
    "de": [
      "Céline, Bérengère und Marc-Antoine Madeyre haben sich im Herzen von Livradois-Forez niedergelassen und produzieren Milchkühe der Rasse Prim'holstein... seit drei Generationen. Wir stellen handwerklich hergestelltes Eis her, das direkt aus der Milch des Hofes hergestellt wird."
    ],
    "en": [
      "Céline, Bérengère and Marc-Antoine Madeyre are settled in the heart of Livradois-Forez in production of dairy cows of Prim' holstein race... since 3 generations. We make artisanal ice creams directly from the milk of the farm."
    ],
    "it": [
      "Céline, Bérengère e Marc-Antoine Madeyre si sono stabiliti nel cuore della regione Livradois-Forez e producono vacche da latte Prim'holstein da 3 generazioni. Produciamo gelati artigianali direttamente dal latte della fattoria."
    ],
    "fr": [
      "Céline, Bérengère et Marc-Antoine Madeyre sommes installés au cœur du Livradois-Forez en production de vaches laitières de race Prim’holstein… depuis 3 générations. Nous réalisons des glaces artisanales réalisées directement à partir du lait de la ferme."
    ],
    "es": [
      "Céline, Bérengère y Marc-Antoine Madeyre están instalados en el corazón de la región de Livradois-Forez y producen vacas lecheras Prim?holstein? desde hace 3 generaciones. Elaboramos helados artesanales directamente con la leche de la granja."
    ],
    "nl": [
      "Céline, Bérengère en Marc-Antoine Madeyre zijn gevestigd in het hart van de regio Livradois-Forez en produceren al 3 generaties lang Prim'holstein melkkoeien. Wij maken ambachtelijk ijs rechtstreeks van de melk van de boerderij."
    ]
  },
