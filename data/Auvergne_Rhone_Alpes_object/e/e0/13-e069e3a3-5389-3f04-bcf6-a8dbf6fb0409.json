  "rdfs:comment": {
    "de": [
      "Isabelle, diplomierte Kosmetikerin und Shiatsu-Therapeutin, empfängt Sie und bietet Ihnen ästhetische und energetische Gesichts- und Körperbehandlungen an. In Frankreich hergestellte Natur- und Biokosmetik."
    ],
    "en": [
      "Isabelle, qualified beautician and shiatsu therapist welcomes you and offers you aesthetic and energetic face and body treatments."
    ],
    "it": [
      "Isabelle, estetista e terapista shiatsu qualificata, vi accoglie e vi offre trattamenti estetici ed energetici per il viso e il corpo. Cosmetici naturali e biologici prodotti in Francia."
    ],
    "fr": [
      "Isabelle, esthéticienne diplômée et thérapeute shiatsu vous accueille et vous propose des soins visage et corps esthétiques et énergétiques. Cosmétiques naturels et bio fabriqués en France."
    ],
    "nl": [
      "Isabelle, gediplomeerd schoonheidsspecialiste en shiatsutherapeute, ontvangt u en biedt u schoonheids- en energiebehandelingen voor gezicht en lichaam. Natuurlijke en biologische cosmetica gemaakt in Frankrijk."
    ],
    "es": [
      "Isabelle, esteticista cualificada y terapeuta de shiatsu, le da la bienvenida y le ofrece tratamientos de belleza y energía para el rostro y el cuerpo. Cosmética natural y ecológica fabricada en Francia."
    ]
  },
  "rdfs:label": {
    "en": [
      "Locie Zen - Beauty care center"
    ],
    "fr": [
      "Locie Zen - Centre de soin esthétique"
    ]
  },
