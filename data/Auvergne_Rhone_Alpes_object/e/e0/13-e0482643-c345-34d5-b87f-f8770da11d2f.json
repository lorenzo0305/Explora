  "rdfs:comment": {
    "de": [
      "Poppy Saker-Norrish arbeitet mit biologischen und saisonalen Produkten. Ein Teil des Gemüses wird im eigenen Garten angebaut, der Rest stammt von lokalen Gemüsebauern und Viehzüchtern und trägt so zu einer lebendigen und engagierten regionalen Küche bei."
    ],
    "en": [
      "Poppy Saker-Norrish works with organic, seasonal produce. Some of the vegetables are grown in the kitchen garden, with the rest sourced from local market gardeners and breeders, contributing to a lively and committed cuisine de terroir."
    ],
    "it": [
      "Poppy Saker-Norrish lavora con prodotti biologici e di stagione. Alcune delle verdure sono coltivate nell'orto, mentre le altre provengono da orticoltori e allevatori locali, contribuendo a una cucina locale vivace e impegnata."
    ],
    "fr": [
      "Poppy Saker-Norrish travaille à partir de produits biologiques et de saison. Une partie des légumes est cultivée au potager, le reste provenant de maraîchers et d’éleveurs locaux, contribuant à une cuisine de terroir vivante et engagée."
    ],
    "nl": [
      "Poppy Saker-Norrish werkt met biologische en seizoensgebonden producten. Een deel van de groenten wordt verbouwd in de moestuin, terwijl de rest afkomstig is van lokale tuinders en kwekers, wat bijdraagt aan een levendige en betrokken lokale keuken."
    ],
    "es": [
      "Poppy Saker-Norrish trabaja con productos ecológicos y de temporada. Algunas de las verduras se cultivan en el huerto, mientras que el resto proceden de horticultores y ganaderos locales, lo que contribuye a una cocina local viva y comprometida."
    ]
  },
