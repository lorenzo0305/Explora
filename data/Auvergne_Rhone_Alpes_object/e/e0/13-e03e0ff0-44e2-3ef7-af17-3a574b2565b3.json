  "rdfs:comment": {
    "de": [
      "In Châtel gibt es außerdem etwa 20 alte und neue Oratorien (lou perdons), die über Generationen hinweg gepflegt wurden."
    ],
    "en": [
      "There are also about twenty oratories in Châtel, called \"lou perdons\" in regional dialect."
    ],
    "it": [
      "Châtel possiede anche una ventina di oratori (lou perdons), vecchi e nuovi, mantenuti nel corso delle generazioni."
    ],
    "fr": [
      "Châtel compte également une vingtaine d'oratoires (lou perdons), anciens ou récents, entretenus au fil des générations."
    ],
    "nl": [
      "Châtel telt ook ongeveer twintig oratoria (lou perdons), oud of nieuw, gedurende generaties onderhouden."
    ],
    "es": [
      "Châtel cuenta también con una veintena de oratorios (lou perdons), antiguos y nuevos, mantenidos a lo largo de las generaciones."
    ]
  },
