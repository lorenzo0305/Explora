  "rdfs:comment": {
    "de": [
      "Die Mediathek befindet sich neben dem Espace Animation und bietet Ihnen in einer angenehmen Umgebung eine Vielzahl von Büchern, Aktivitäten, Ausstellungen und Workshops. Die Mediathek bietet Ihnen auch Zugang zum Internet und zur digitalen Bibliothek."
    ],
    "en": [
      "Located next to the village hall, the local library boasts a multitude of books, activities, exhibitions and workshops."
    ],
    "it": [
      "Situata accanto all'Espace Animation, la mediateca offre una moltitudine di libri, attività, mostre e laboratori in un ambiente piacevole. La mediateca offre anche l'accesso a Internet e una biblioteca digitale."
    ],
    "fr": [
      "Située à côté de l’Espace Animation, la médiathèque vous propose dans un environnement agréable une multitude d’ouvrages, d’activités, d’expositions et d’ateliers. La médiathèque vous propose également un accès internet et à la bibliothèque numérique."
    ],
    "es": [
      "Situada junto al Espacio de Animación, la mediateca le ofrece una multitud de libros, actividades, exposiciones y talleres en un entorno agradable. La mediateca también ofrece acceso a Internet y una biblioteca digital."
    ],
    "nl": [
      "De mediatheek ligt naast de Espace Animation en biedt u een groot aantal boeken, activiteiten, tentoonstellingen en workshops in een aangename omgeving. De mediatheek biedt ook internettoegang en een digitale bibliotheek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Local Library"
    ],
