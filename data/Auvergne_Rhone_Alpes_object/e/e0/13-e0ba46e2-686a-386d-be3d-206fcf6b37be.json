  "rdfs:comment": {
    "de": [
      "Als Winzer des Jahres 2023 im Guide Hachette besteht unser Weingut seit 1830 und 7 Generationen in der Gemeinde Jongieux im Departement Savoie, genauer gesagt im Savoyer Vorland, am linken Ufer der Rhône"
    ],
    "en": [
      "A winegrower since 1830 (and winegrower of the year 2023 in the Guide Hachette), our estate has endured for 6 generations in the commune of Jongieux, in the Savoie department and more precisely in the Savoyard foreland, on the left bank of the Rhône."
    ],
    "it": [
      "Vignaiolo dell'anno 2023 nella Guida Hachette, la nostra tenuta esiste dal 1830 e da 7 generazioni nel comune di Jongieux, nel dipartimento della Savoia e più precisamente nell'Avant-pays savoyard, sulla riva sinistra del Rodano."
    ],
    "fr": [
      "Vigneron de l'année 2023 dans le Guide Hachette, notre domaine perdure depuis 1830 et 7 générations sur la commune de Jongieux, dans le département de la Savoie et plus précisément dans l'Avant-pays savoyard, sur la rive gauche du Rhône"
    ],
    "es": [
      "Viticultor del Año 2023 en la Guía Hachette, nuestra propiedad existe desde 1830 y 7 generaciones en la comuna de Jongieux, en el departamento de Saboya y más concretamente en la Prelatura Saboyana, en la orilla izquierda del Ródano"
    ],
    "nl": [
      "Als wijnbouwer sinds 1830 (en wijnbouwer van het jaar 2023 in de Guide Hachette), bestaat ons domein al 6 generaties in de gemeente Jongieux, in het departement Savoie en meer bepaald in het Savoyaardse voorland, op de linkeroever van de Rhône."
    ]
  },
