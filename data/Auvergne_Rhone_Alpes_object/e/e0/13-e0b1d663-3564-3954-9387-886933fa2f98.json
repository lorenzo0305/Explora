  "rdfs:comment": {
    "de": [
      "Am Fuße der Aiguilles d'Arves beginnt 1200d - des Glücks. Zunächst über Almwiesen und dann durch den Wald, verspricht diese Route eine Fülle von Erlebnissen. Zwischen Geschwindigkeit und technischen Passagen verspricht diese Abfahrt unvergesslich zu werden."
    ],
    "en": [
      "At the foot of the Aiguilles d'Arves starts 1200d - of happiness. First in alpine pastures then in forest, this route promises to be rich in sensations. Between speed and more technical passages, this descent promises to be memorable."
    ],
    "it": [
      "Ai piedi delle Aiguilles d'Arves iniziano 1200 metri di divertimento. Prima negli alpeggi e poi nella foresta, questo percorso promette di essere pieno di emozioni. Tra velocità e tratti più tecnici, questa discesa promette di essere memorabile."
    ],
    "fr": [
      "Au pied des Aiguilles d'Arves commence 1200d - de bonheur. D'abord dans des alpages puis en forêt, cet itinéraire promet d'être riche en sensations. Entre vitesse et passages plus techniques cette descente promet d'être mémorable."
    ],
    "nl": [
      "Aan de voet van de Aiguilles d'Arves begint 1200d plezier. Eerst in de bergweiden en dan in het bos, belooft deze route vol sensatie te zijn. Tussen snelheid en meer technische secties belooft deze afdaling onvergetelijk te worden."
    ],
    "es": [
      "A los pies de las Aiguilles d'Arves comienzan 1200d de diversión. Primero en los pastos de montaña y luego en el bosque, esta ruta promete estar llena de emociones. Entre velocidad y tramos más técnicos, este descenso promete ser memorable."
    ]
  },
  "rdfs:label": {
