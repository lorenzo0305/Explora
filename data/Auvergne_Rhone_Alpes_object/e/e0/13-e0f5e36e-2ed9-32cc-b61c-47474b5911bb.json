  "rdfs:comment": {
    "de": [
      "Vertrauen Sie bei Ihren Seminaren in Lyon und Umgebung auf Takamaka, ein Team von Fachleuten, die seit über 30 Jahren auf Aktivitäten und Animationen für Unternehmen spezialisiert sind, im Sommer wie im Winter."
    ],
    "en": [
      "Trust Takamaka to organise all your outdoor sporting activities and seminars around Lyon all year round: A team of professionals specialised in outdoor activities and sporting events for over 30 years."
    ],
    "it": [
      "Affidatevi a Takamaka, un team di professionisti specializzati da oltre 30 anni in attività aziendali e di intrattenimento, sia in estate che in inverno, per i vostri seminari a Lione e dintorni."
    ],
    "fr": [
      "Faites confiance à Takamaka, une équipe de professionnels spécialistes des activités et animations d'entreprises depuis plus de 30 ans, été comme hiver, pour vos séminaires à Lyon et ses alentours."
    ],
    "nl": [
      "Vertrouw voor uw seminars in Lyon en omgeving op Takamaka, een team van professionals dat al meer dan 30 jaar gespecialiseerd is in bedrijfsactiviteiten en entertainment, zowel in de zomer als in de winter."
    ],
    "es": [
      "Confíe en Takamaka, un equipo de profesionales especializados desde hace más de 30 años en actividades y animaciones de empresa, tanto en verano como en invierno, para sus seminarios en Lyon y sus alrededores."
    ]
  },
