  "rdfs:comment": {
    "de": [
      "Familienunternehmen, das auf Busreisen spezialisiert ist! Reisebüro, das sowohl Tagesausflüge als auch mittlere und lange Busaufenthalte anbietet. Möglichkeit, ein 9-Sitzer-Fahrzeug zu mieten."
    ],
    "en": [
      "Family-run company specializing in coach travel! Travel agency offering day trips as well as medium and long stays by bus. Possibility of renting a 9-seater vehicle."
    ],
    "it": [
      "Azienda familiare specializzata in viaggi in pullman! Agenzia di viaggi che offre viaggi di un giorno e soggiorni di media e lunga durata in autobus. Possibilità di noleggiare un veicolo a 9 posti."
    ],
    "fr": [
      "Entreprise familiale spécialiste du voyage en autocar ! Agence de voyages proposant autant des sorties à la journée que des moyens ou longs séjours en bus. Possibilité de location de véhicule 9 places."
    ],
    "nl": [
      "Familiebedrijf gespecialiseerd in busreizen! Reisbureau dat zowel dagtochten als middellange en lange verblijven per bus aanbiedt. Mogelijkheid om een voertuig met 9 zitplaatsen te huren."
    ],
    "es": [
      "Empresa familiar especializada en viajes en autocar Agencia de viajes que ofrece viajes de un día y estancias medias y largas en autobús. Posibilidad de alquilar un vehículo de 9 plazas."
    ]
  },
