  "rdfs:comment": {
    "de": [
      "Hans Zimmer Live wird am 24. März 2026 im Rahmen seiner neuen Tournee \"The Next Level\" in der LDLC Arena in Lyon-Décines auftreten. Eine neue Vision, eine neue Reise, die Sie in eine magische Show eintauchen lässt, die der Welt des Komponisten eigen ist."
    ],
    "en": [
      "Hans Zimmer Live will be at the LDLC Arena in Lyon-Décines on 24 March 2026 as part of his new tour, ‘The Next Level’. A new vision, a new journey, which will immerse you in a magical show unique to the composer's universe."
    ],
    "it": [
      "Hans Zimmer Live sarà all'Arena LDLC di Lione-Décines il 24 marzo 2026 nell'ambito del suo nuovo tour \"The Next Level\". Una nuova visione, un nuovo viaggio, che vi farà immergere in uno spettacolo magico e unico nell'universo del compositore."
    ],
    "fr": [
      "Hans Zimmer Live sera à la LDLC Arena de Lyon-Décines le 24 mars 2026 dans le cadre de sa nouvelle tournée « The Next Level ». Une nouvelle vision, un nouveau voyage, qui vous plongera dans un spectacle magique propre à l’univers du compositeur."
    ],
    "nl": [
      "Hans Zimmer Live staat op 24 maart 2026 in de LDLC Arena in Lyon-Décines als onderdeel van zijn nieuwe \"The Next Level\" tournee. Een nieuwe visie, een nieuwe reis, die je zal onderdompelen in een magische show die uniek is voor het universum van de componist."
    ],
    "es": [
      "Hans Zimmer Live estará en el LDLC Arena de Lyon-Décines el 24 de marzo de 2026 en el marco de su nueva gira \"The Next Level\". Una nueva visión, un nuevo viaje, que le sumergirá en un espectáculo mágico único en el universo del compositor."
    ]
  },
