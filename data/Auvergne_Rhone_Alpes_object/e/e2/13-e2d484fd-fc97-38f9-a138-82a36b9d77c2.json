  "rdfs:comment": {
    "de": [
      "Bio, lokal und 100 % hausgemacht: Croq Champs verwöhnt Sie mit leckeren Crêpes, die aus frischen Produkten vom Bauernhof zubereitet werden. Authentisch, schmackhaft und engagiert, für einen echten Geschmack der Region bei jedem Bissen."
    ],
    "en": [
      "Organic, local and 100% homemade, Croq Champs treats you to gourmet crêpes made with fresh produce from the farm. Authentic, tasty and committed, for a true taste of terroir in every bite."
    ],
    "it": [
      "Biologico, locale e 100% fatto in casa, Croq Champs vi delizia con crêpes gourmet preparate con prodotti freschi della fattoria. Autentiche, gustose e impegnate, per un vero e proprio assaggio della terra in ogni boccone."
    ],
    "fr": [
      "Bio, local et 100 % fait maison, Croq Champs vous régale avec des crêpes gourmandes préparées à partir des produits frais de la ferme. Authentique, savoureux et engagé, pour un vrai goût du terroir à chaque bouchée."
    ],
    "es": [
      "Ecológico, local y 100% casero, Croq Champs le deleita con crepes gourmet elaborados con productos frescos de la granja. Auténticos, sabrosos y comprometidos, para saborear la tierra en cada bocado."
    ],
    "nl": [
      "Biologisch, lokaal en 100% huisgemaakt, Croq Champs verwent je met heerlijke crêpes gemaakt met verse producten van de boerderij. Authentiek, smakelijk en toegewijd, voor een echte smaak van het land in elke hap."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Crêperie Croq'Champs"
    ]
  },
