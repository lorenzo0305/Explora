  "rdfs:comment": {
    "de": [
      "Wanderung durch den Wald mit freier Aussicht, ausgehend vom Parkplatz La Sierre.\r\nGehen Sie um den Skilift Bachassons herum."
    ],
    "en": [
      "Hike through undergrowth with open views, starting from the Sierre parking lot.\r\nGo around the Bachassons ski lift."
    ],
    "it": [
      "Escursione nel sottobosco con vista aperta, partendo dal parcheggio di Sierre.\r\nPasseggiata intorno all'impianto di risalita di Bachassons."
    ],
    "fr": [
      "Randonnée en sous bois avec vues dégagées, au départ du parking de la Sierre.\r\nContourner le téléski des Bachassons."
    ],
    "nl": [
      "Wandeling door het kreupelhout met open uitzicht, vanaf de parkeerplaats Sierre.\r\nWandel rond de skilift van Bachassons."
    ],
    "es": [
      "Caminata por la maleza con vistas abiertas, partiendo del aparcamiento de Sierre.\r\nPaseo alrededor del remonte de Bachassons."
    ]
  },
