  "rdfs:comment": {
    "de": [
      "Die Pferdeställe von Optevoz empfangen Sie in einer ruhigen und angenehmen Umgebung auf 30 Hektar mit zahlreichen Ausreitmöglichkeiten. Kurse von Anfängern bis Fortgeschrittenen, Dressur CSO und CCE, Coaching, Praktika."
    ],
    "en": [
      "The Optevoz stables welcome you to a calm and pleasant setting on 30 hectares with numerous riding possibilities. Lessons from beginner to advanced, dressage CSO and CCE, coaching, training courses."
    ],
    "it": [
      "Il maneggio Optevoz vi accoglie in un ambiente tranquillo e piacevole su 30 ettari con numerose opportunità di equitazione. Lezioni da principiante ad avanzato, dressage CSO e CCE, coaching, corsi."
    ],
    "fr": [
      "Les écuries d'Optevoz vous accueillent dans un cadre calme et agréable sur 30 hectares avec de nombreuses possibilités de randonnées. Cours du débutant au confirmé, dressage CSO et CCE, coaching, stages."
    ],
    "es": [
      "Los establos Optevoz le dan la bienvenida en un entorno tranquilo y agradable en 30 hectáreas con un montón de oportunidades para montar a caballo. Clases desde principiantes hasta avanzados, doma CSO y CCE, coaching, cursos."
    ],
    "nl": [
      "De stallen van Optevoz verwelkomen je in een rustige en aangename omgeving op 30 hectare met volop rijmogelijkheden. Lessen van beginners tot gevorderden, dressuur CSO en CCE, coaching, cursussen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les écuries d'Optevoz"
    ]
  },
