  "rdfs:comment": {
    "de": [
      "Der Standort des Weilers Châteloy bietet einen herrlichen Ausblick auf das Val d'Aumance. Die Kirche Saint-Pierre aus dem 12. Jahrhundert wurde auf einem Felsvorsprung an der Flanke der Klippe errichtet."
    ],
    "en": [
      "The hamlet of Châteloy offers splendid views over the Val d'Aumance. The 12th-century Saint-Pierre church is built on a cliff-side promontory."
    ],
    "it": [
      "La frazione di Châteloy offre una splendida vista sulla Val d'Aumance. La chiesa di Saint-Pierre, risalente al XII secolo, è costruita su un promontorio a picco sul mare."
    ],
    "fr": [
      "Le site du hameau de Châteloy offre un splendide point de vue sur le Val d'Aumance. L'Église Saint-Pierre, du XIIe siècle, est construite sur un promontoire à flanc de falaise."
    ],
    "es": [
      "La aldea de Châteloy ofrece espléndidas vistas sobre el Val d'Aumance. La iglesia de Saint-Pierre, del siglo XII, está construida sobre un promontorio acantilado."
    ],
    "nl": [
      "Het gehucht Châteloy biedt een prachtig uitzicht over de Val d'Aumance. De 12e-eeuwse kerk Saint-Pierre is gebouwd op een klif."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site de l'Église de Châteloy"
    ]
  },
