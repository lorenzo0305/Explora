  "rdfs:comment": {
    "de": [
      "Das Festkomitee bietet eine Ausstellung von Oldtimern auf der Esplanade des Bahnhofs ab 9 Uhr mit Tauschbörse für Teile und Essen mit Reservierung um 12 Uhr"
    ],
    "en": [
      "The festival committee proposes an exhibition of old vehicles on the esplanade of the station from 9 am with exchange of parts and meal on reservation at 12 am"
    ],
    "it": [
      "Il comitato del festival propone un'esposizione di veicoli d'epoca sulla spianata della stazione a partire dalle 9.00 con scambio di pezzi e pasto su prenotazione alle 12.00"
    ],
    "fr": [
      "Le comité des fêtes propose une exposition de véhicules anciens sur l'esplanade de la gare à partir de 9h avec bourse d'échanges de pièces et repas sur réservation à 12h"
    ],
    "es": [
      "La comisión de fiestas propone una exposición de vehículos antiguos en la explanada de la estación a partir de las 9 h con intercambio de piezas y comida previa reserva a las 12 h"
    ],
    "nl": [
      "Het festivalcomité stelt een tentoonstelling van oude voertuigen voor op het voorplein van het station vanaf 9 uur met uitwisseling van onderdelen en een maaltijd op reservering om 12 uur"
    ]
  },
  "rdfs:label": {
    "fr": [
      "\"les Roues pètent\" : 6ème exposition de véhicules anciens et bourse d'échange de pièces"
    ]
