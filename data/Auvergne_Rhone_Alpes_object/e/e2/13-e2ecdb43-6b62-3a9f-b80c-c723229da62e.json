  "rdfs:comment": {
    "de": [
      "Die 1926 von Marcel Dumas gegründete und 2011 in das Verzeichnis der seltenen Kunsthandwerke aufgenommene Parcheminerie Dumas, eine der drei letzten in Frankreich, ist auch heute noch ein Familienunternehmen, das von Marcels Enkel Frédéric Dumas geleitet wird."
    ],
    "en": [
      "Experience a family business listed as a Rare Craft since 2011 and approved as a Living Heritage Business in 2013."
    ],
    "it": [
      "Creata nel 1926 da Marcel Dumas, iscritta all'inventario dei mestieri d'arte rara nel 2011, la Parcheminerie Dumas, una delle ultime tre in Francia, è ancora oggi un'azienda familiare, gestita da Frédéric Dumas, nipote di Marcel."
    ],
    "fr": [
      "Créée en 1926 par Marcel Dumas, inscrite à l'inventaire des Métiers d'Art Rare en 2011, la Parcheminerie Dumas, l'une des trois dernières de France, est aujourd'hui encore une entreprise familiale, gérée par Frédéric Dumas, le petit-fils de Marcel."
    ],
    "nl": [
      "De Parcheminerie Dumas, opgericht in 1926 door Marcel Dumas, ingeschreven in de inventaris van de Zeldzame Kunsthandel in 2011, een van de laatste drie in Frankrijk, is nog steeds een familiebedrijf, geleid door Frédéric Dumas, de kleinzoon van Marcel."
    ],
    "es": [
      "Creada en 1926 por Marcel Dumas, inscrita en el inventario de Oficios de Arte Raro en 2011, la Parcheminerie Dumas, una de las tres últimas de Francia, sigue siendo hoy una empresa familiar, dirigida por Frédéric Dumas, nieto de Marcel."
    ]
  },
  "rdfs:label": {
    "en": [
