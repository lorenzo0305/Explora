  "rdfs:comment": {
    "de": [
      "Medizinische und aromatische Pflanzen, Gemüse, in AB und mit tierischem Antrieb. Kräutertees, ätherische Öle, Hydrolate, Sirupe und Marmeladen... Verkauf ab Hof, Besuch eines botanischen Gartens mit Heilpflanzen und Entdeckung ihrer wohltuenden Wirkung."
    ],
    "en": [
      "Aromatic and medicinal plants, vegetables, organic farming and animal-drawn equipment. Herbal teas, essential oils, herbal distillates, syrups and jams… Farm-gate sales, tours of the botanical garden to discover the medicinal plants and learn about their benefits."
    ],
    "it": [
      "Piante medicinali e aromatiche, ortaggi, in AB e trazione animale. Tisane, oli essenziali, idrolati, sciroppi e marmellate... Vendita in fattoria, visita del giardino botanico delle piante medicinali e scoperta dei loro benefici."
    ],
    "fr": [
      "Plantes médicinales et aromatiques, légumes, en AB et en traction animale. Tisanes, huiles essentielles, hydrolats, sirops et confitures... Vente à la ferme, visite de jardin botanique des plantes médicinales et découverte de leurs bienfaits."
    ],
    "es": [
      "Plantas medicinales y aromáticas, verduras, en AB y tracción animal. Infusiones, aceites esenciales, hidrolatos, jarabes y mermeladas... Venta en la granja, visita del jardín botánico de plantas medicinales y descubrimiento de sus beneficios."
    ],
    "nl": [
      "Geneeskrachtige en aromatische planten, groentes, biologische landbouw en door dieren voortgetrokken machines. Kruidenthee, etherische oliën, hydrolaten, siroop en jam... Verkoop bij de boerderij, bezoek aan de botanische tuin met geneeskrachtige planten en ontdekking van hun heilzame werking."
    ]
  },
