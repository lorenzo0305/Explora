  "rdfs:comment": {
    "de": [
      "Ein schöner Rundweg zur Combe d'en Haut führt Sie zu den schönen Landschaften der Almen. Lassen Sie sich vom Klang der Klarinetten in den Schlaf wiegen."
    ],
    "en": [
      "A lovely looping route to the combe d'en Haut takes you through the beautiful alpine scenery. Let the sound of the clarines lull you to sleep."
    ],
    "it": [
      "Un bel percorso ad anello verso la Combe d'en Haut vi porterà attraverso lo splendido scenario degli alpeggi. Lasciatevi cullare dal suono delle chiarine."
    ],
    "fr": [
      "Un joli parcours en boucle vers la combe d'en Haut vous mènera jusqu'aux beaux paysages des alpages. Laissez-vous bercer par le son des clarines."
    ],
    "es": [
      "Una bonita ruta en bucle hasta la Combe d'en Haut le llevará a través del hermoso paisaje de los pastos de montaña. Déjate arrullar por el sonido de los clarines."
    ],
    "nl": [
      "Een mooie lusroute naar de Combe d'en Haut voert je door het prachtige landschap van de bergweiden. Laat je in slaap wiegen door het geluid van de klarines."
    ]
  },
  "rdfs:label": {
