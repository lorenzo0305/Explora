  "rdfs:comment": {
    "de": [
      "Hochzeiten, Gruppenpraktika, grüne Klassen, Familientreffen, Vereinstreffen, freundschaftliche Feste auf dem Land... Das Château de Saint Bonnet de Valclérieux ist ein idealer Ort für den Empfang von Gruppen in freier Verwaltung."
    ],
    "en": [
      "Weddings, group courses, school trips, family reunions, club meetings, friendly country celebrations... the Château de Saint Bonnet de Valclérieux is an ideal venue for self-catering groups."
    ],
    "it": [
      "Matrimoni, corsi di formazione di gruppo, gite scolastiche, riunioni di famiglia, incontri associativi, simpatiche feste di campagna... lo Château de Saint Bonnet de Valclérieux è il luogo ideale per accogliere gruppi in autogestione."
    ],
    "fr": [
      "Mariages, stages de groupes, classes vertes, réunions de famille, rencontres associatives, fêtes amicales à la campagne... le Château de Saint Bonnet de Valclérieux est un lieu idéal pour l’accueil de groupes en gestion libre."
    ],
    "nl": [
      "Bruiloften, groepscursussen, schoolreisjes, familiereünies, clubbijeenkomsten, gezellige plattelandsfeesten... het Château de Saint Bonnet de Valclérieux is een ideale locatie voor self-catering groepen."
    ],
    "es": [
      "Bodas, cursos de formación para grupos, viajes escolares, reuniones familiares, encuentros de asociaciones, fiestas campestres amistosas... el Château de Saint Bonnet de Valclérieux es un lugar ideal para acoger a grupos en régimen de autoservicio."
    ]
  },
