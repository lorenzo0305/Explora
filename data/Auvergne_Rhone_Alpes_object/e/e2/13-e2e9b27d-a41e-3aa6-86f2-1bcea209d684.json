  "rdfs:comment": {
    "de": [
      "Die 2012 gegründete handwerkliche Brauerei Ouroboros bietet charaktervolle Biere, Met, Limonade und Destillate an. Eine lokale, kreative und sich ständig weiterentwickelnde Produktion, die im Direktverkauf erhältlich ist."
    ],
    "en": [
      "A craft brewery founded in 2012, Ouroboros offers characterful beers, mead, lemonade and distillates. A local, creative and constantly evolving production, available for direct sale."
    ],
    "it": [
      "Birrificio artigianale fondato nel 2012, Ouroboros propone birre di carattere, idromele, limonate e distillati. Una produzione locale, creativa e in continua evoluzione, disponibile per la vendita diretta."
    ],
    "fr": [
      "Brasserie artisanale fondée en 2012, Ouroboros propose bières de caractère, hydromel, limonade et distillats. Une production locale, créative et en perpétuelle évolution, disponible en vente directe."
    ],
    "nl": [
      "Ouroboros, een ambachtelijke brouwerij opgericht in 2012, biedt karaktervolle bieren, honingdrank, limonade en distillaten. Een lokale, creatieve en voortdurend evoluerende productie, beschikbaar voor directe verkoop."
    ],
    "es": [
      "Cervecería artesanal fundada en 2012, Ouroboros ofrece cervezas con carácter, hidromiel, limonada y destilados. Una producción local, creativa y en constante evolución, disponible para la venta directa."
    ]
  },
