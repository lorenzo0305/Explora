  "rdfs:comment": {
    "de": [
      "Der Caveau des Anges ist eine Themenbar, ein Ort für Konzerte und eine Diskothek.\r\nEr befindet sich im Stadtzentrum in der Nähe der Universitäten."
    ],
    "en": [
      "The Caveau des Anges is a themed bar, concert venue, and nightclub.\r\nIt is located in the city center, near the universities."
    ],
    "it": [
      "Il Caveau des Anges è un bar a tema, un locale per concerti e una discoteca.\r\nSi trova nel centro della città, vicino alle università."
    ],
    "fr": [
      "Le Caveau des Anges est un bar à thèmes, lieu de concerts, discothèque.\r\nIl est situé dans le centre-ville, proche des universités."
    ],
    "es": [
      "El Caveau des Anges es un bar temático, sala de conciertos y discoteca.\r\nEstá situado en el centro de la ciudad, cerca de las universidades."
    ],
