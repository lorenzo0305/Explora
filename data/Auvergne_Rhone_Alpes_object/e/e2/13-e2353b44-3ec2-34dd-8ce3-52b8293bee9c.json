  "rdfs:comment": {
    "de": [
      "Tanken Sie gute Laune mit Vert et Blanc Organisation!\r\nMit der Familie, Freunden oder Arbeitskollegen, schließen Sie sich uns an für ein Abenteuer in luftiger Höhe. \r\nNervenkitzel garantiert!"
    ],
    "en": [
      "Come and have a good time with Vert et Blanc Organisation!\r\nWith family, friends or colleagues, join us for a treetop adventure.\r\n\r\nThrills guaranteed!"
    ],
    "it": [
      "Venite a divertirvi con Vert et Blanc Organisation!\r\nCon la famiglia, gli amici o i colleghi di lavoro, unitevi a noi per un'avventura tra gli alberi\r\n\r\nEmozioni garantite!"
    ],
    "fr": [
      "Venez faire le plein de bonne humeur avec Vert et Blanc Organisation !\r\nEn famille, entre amis ou collègues de travail, rejoignez-nous pour une aventure perchée dans les arbres\r\n\r\nSensations garanties !"
    ],
    "es": [
      "¡Ven a llenarte de buen humor con Vert et Blanc Organisation!\r\nCon la familia, los amigos o los compañeros de trabajo, únase a nosotros para vivir una aventura encaramado a los árboles\r\n\r\n¡Emociones garantizadas!"
    ],
    "nl": [
      "Kom en beleef een geweldige tijd met Vert et Blanc Organisation!\r\nMet familie, vrienden of collega's, ga mee op avontuur in de bomen\r\n\r\nSensatie gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accrobranche d'Autrans"
    ]
  },
