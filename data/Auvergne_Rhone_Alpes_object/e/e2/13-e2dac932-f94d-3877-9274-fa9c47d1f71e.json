  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek befindet sich hinter dem Rathausgebäude und empfängt Sie montags und freitags von 16:30 bis 18:30 Uhr."
    ],
    "en": [
      "Located behind the Town Hall building, the municipal library welcomes you on Mondays and Fridays from 4:30 to 6:30 pm."
    ],
