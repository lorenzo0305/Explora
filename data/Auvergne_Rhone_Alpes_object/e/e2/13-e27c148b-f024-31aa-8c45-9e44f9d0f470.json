  "rdfs:comment": {
    "de": [
      "Zwischen Annemasse und Cluses, im Herzen des Dorfes Saint-Jeoire, in der Nähe des Skigebiets Brasses, liegt dieses kleine, typische, gemütliche und frisch renovierte Hotel. Es bietet Ihnen eine gastronomische Etappe und eine ruhige, gemütliche Unterkunft."
    ],
    "en": [
      "Situated between Annemasse and Cluses, at heart oh Saint-Jeoire, near to Brasses resort, this little typically hotel welcoming and freshly renovated, propose a gastronomic stage and warm and calm accommodation."
    ],
    "it": [
      "Situato tra Annemasse e Cluses, nel cuore del villaggio di Saint-Jeoire, vicino alla stazione sciistica di Brasses, questo piccolo hotel accogliente e recentemente rinnovato offre una sosta gastronomica e una sistemazione tranquilla e calda."
    ],
    "fr": [
      "Situé entre Annemasse et Cluses, au cœur du village de Saint-Jeoire, à proximité de la station de ski des Brasses, ce petit hôtel typique, accueillant et fraîchement rénové, vous propose une étape gastronomique et un hébergement calme et chaleureux."
    ],
    "es": [
      "Situado entre Annemasse y Cluses, en el corazón del pueblo de Saint-Jeoire, cerca de la estación de esquí de Brasses, este pequeño y acogedor hotel, recientemente renovado, ofrece una parada gastronómica y un alojamiento tranquilo y cálido."
    ],
    "nl": [
      "Gelegen tussen Annemasse en Cluses, in het hart van het dorp Saint-Jeoire, dicht bij het skigebied van Brasses, biedt dit kleine, gastvrije en onlangs gerenoveerde hotel een gastronomische tussenstop en een rustig en warm verblijf."
    ]
  },
  "rdfs:label": {
    "en": [
