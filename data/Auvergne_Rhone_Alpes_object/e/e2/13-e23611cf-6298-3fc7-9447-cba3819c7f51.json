  "rdfs:comment": {
    "de": [
      "Früher Ort großer Viehmärkte, zu denen die Bauern kamen, um ihre Tiere zu wiegen und zu verkaufen."
    ],
    "en": [
      "In the past, it was the site of large livestock fairs where peasants came to weigh their animals and sell them."
    ],
    "it": [
      "In passato, era la sede di grandi fiere del bestiame in cui gli agricoltori venivano a pesare i loro animali e a venderli."
    ],
    "fr": [
      "Autrefois, lieu de grandes foires aux bestiaux où les paysans venaient peser leurs bêtes et les vendre."
    ],
    "nl": [
      "In het verleden waren hier grote veemarkten waar boeren hun dieren kwamen wegen en verkopen."
    ],
    "es": [
      "En el pasado, era el lugar donde se celebraban grandes ferias de ganado en las que los ganaderos acudían a pesar sus animales y venderlos."
    ]
  },
  "rdfs:label": {
    "fr": [
