  "rdfs:comment": {
    "de": [
      "Simon und Brice sind leidenschaftliche Gastronomen und beschließen, gemeinsam Poppa zu gründen, ein gemütliches Restaurant. Eine authentische Küche, die mit frischen und regionalen Produkten zubereitet wird, die je nach Jahreszeit verarbeitet werden."
    ],
    "en": [
      "Simon and Brice have a passion for food and decided to create Poppa, a convivial restaurant. Authentic cuisine, prepared with fresh, regional produce, in tune with the seasons."
    ],
    "it": [
      "Simon e Brice hanno una passione per la ristorazione e insieme hanno deciso di creare Poppa, un ristorante conviviale. La cucina è autentica, realizzata con prodotti freschi e regionali e preparata secondo le stagioni."
    ],
    "fr": [
      "Passionnés de restauration, Simon et Brice décident de créer ensemble Poppa, un restaurant convivial. Une cuisine authentique, élaborée avec des produits frais et régionaux, travaillés au fil des saisons."
    ],
    "es": [
      "Simon y Brice sienten pasión por la restauración y juntos decidieron crear Poppa, un restaurante acogedor. La cocina es auténtica, elaborada con productos frescos y regionales que cambian con las estaciones."
    ],
    "nl": [
      "Simon en Brice hebben een passie voor het restaurantwezen en samen besloten ze Poppa op te richten, een gezellig restaurant. De keuken is authentiek, gemaakt met verse, regionale producten en bereid volgens de seizoenen."
    ]
  },
  "rdfs:label": {
    "en": [
