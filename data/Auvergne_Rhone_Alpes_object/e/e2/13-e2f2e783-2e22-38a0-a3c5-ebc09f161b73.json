  "rdfs:comment": {
    "de": [
      "Auch in La Montagne kann man sich eine Leinwand ansehen!\r\nKinosaal mit 320 Plätzen.\r\nGenießen Sie die neuesten Filme mit Freunden oder der Familie!"
    ],
    "en": [
      "On the Mountain, too, we can make a canvas!\r\n320-seat cinema.\r\nCome and enjoy the latest movies, with friends or family!"
    ],
    "it": [
      "Potete anche divertirvi in montagna!\r\nUn cinema da 320 posti.\r\nVenite a godervi gli ultimi film, con gli amici o la famiglia!"
    ],
    "fr": [
      "A la Montagne aussi, on peut se faire une toile!\r\nSalle de cinéma de 320 places.\r\nVenez savourer les derniers films à l'affiche, entre amis ou en famille !"
    ],
    "es": [
      "¡También puedes pasar un buen rato en la Montaña!\r\nUn cine de 320 plazas.\r\nVenga a disfrutar de las últimas películas, con amigos o en familia"
    ],
    "nl": [
      "Je kunt je ook vermaken op de berg!\r\nEen bioscoop met 320 plaatsen.\r\nKom genieten van de nieuwste films, met vrienden of familie!"
    ]
  },
  "rdfs:label": {
