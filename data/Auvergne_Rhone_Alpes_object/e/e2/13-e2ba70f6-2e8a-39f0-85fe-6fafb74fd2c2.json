  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen einzigartigen Moment in der Bibliothek von Montgellafrey!\r\nBücher, zur Selbstbedienung vor Ort ...\r\nSie befindet sich oberhalb des Rathauses im Chef-lieu\r\nIdeal für Familien, kostenlos und für alle zugänglich."
    ],
    "en": [
      "Come and spend a unique moment in the Library of Montgellafrey! Books in self-service on site ...\r\nLocated over the town hall, in Montgellafrey Chef-lieu.\r\nIdeal for families, free and open to all."
    ],
    "it": [
      "Venite a trascorrere un momento unico nella Biblioteca di Montgellafrey!\r\nLibri, self-service sul posto ...\r\nSi trova sopra il municipio, nella Chef-lieu\r\nIdeale per le famiglie, gratuito e aperto a tutti."
    ],
    "fr": [
      "Venez passer un moment unique dans la Bibliothèque de Montgellafrey ! \r\nLivres, en libre-service sur place ...\r\nSitué au dessus de la mairie, au Chef-lieu. \r\nIdéal pour les familles, gratuit et ouvert à tous."
    ],
    "es": [
      "¡Venga a pasar un momento único en la Biblioteca Montgellafrey!\r\nLibros, autoservicio en el lugar ...\r\nSituado encima del ayuntamiento, en el Chef-lieu\r\nIdeal para las familias, es gratuito y está abierto a todos."
    ],
    "nl": [
      "Kom en breng een uniek moment door in de Montgellafrey Bibliotheek!\r\nBoeken, zelfbediening ter plaatse ...\r\nGelegen boven het stadhuis, in de Chef-lieu\r\nIdeaal voor gezinnen, gratis en voor iedereen toegankelijk."
    ]
  },
