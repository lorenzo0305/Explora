  "rdfs:comment": {
    "de": [
      "SG CUISINE & AGENCEMENT INTERIEUR BIETET IHNEN EINE KOMPLETTE BEGLEITUNG VON DER PLANUNG BIS ZUR AUSFÜHRUNG ALLER\r\nIHRE PROJEKTE ZUR INNENEINRICHTUNG: KÜCHE, BADEZIMMER, ANKLEIDEZIMMER UND ALLE ANDEREN ARBEITEN. SIE MÜSSEN SICH UM NICHTS KÜMMERN!"
    ],
    "en": [
      "SG CUISINE & AGENCEMENT INTERIEUR OFFERS YOU COMPLETE SUPPORT FROM DESIGN TO COMPLETION OF ALL YOUR\r\nYOUR KITCHEN, BATHROOM AND DRESSING ROOM RENOVATION PROJECTS. YOU'LL HAVE NOTHING TO WORRY ABOUT!"
    ],
    "it": [
      "SG CUISINE & AGENCEMENT INTERIEUR VI OFFRE UN'ASSISTENZA COMPLETA, DALLA PROGETTAZIONE ALLA REALIZZAZIONE, PER TUTTI I VOSTRI PROGETTI DI RISTRUTTURAZIONE DI INTERNI: CUCINA - BAGNO - SPOGLIATOIO E PER I LAVORI STESSI\r\nI VOSTRI PROGETTI DI RISTRUTTURAZIONE DI INTERNI: CUCINA - BAGNO - SPOGLIATOIO E I LAVORI STESSI. NON AVRETE NULLA DI CUI PREOCCUPARVI!"
    ],
    "fr": [
      "SG CUISINE & AGENCEMENT INTERIEUR VOUS PROPOSE UN ACCOMPAGNEMENT COMPLET DE LA CONCEPTION À LA RÉALISATION DE TOUS\r\nVOS PROJETS DE RÉNOVATION INTERIEUR: CUISINE - SALLE DE BAIN - DRESSING AINSI QUE LES TRAVAUX. VOUS N'AUREZ RIEN À GÉRER !"
    ],
    "es": [
      "SG CUISINE & AGENCEMENT INTERIEUR LE ACOMPAÑA DESDE LA CONCEPCIÓN HASTA LA REALIZACIÓN DE TODOS SUS PROYECTOS DE RENOVACIÓN INTERIOR: COCINA - CUARTO DE BAÑO - VESTIDOR ASÍ COMO LA OBRA MISMA\r\nSUS PROYECTOS DE RENOVACIÓN INTERIOR: COCINA - BAÑO - VESTIDOR, ASÍ COMO LA PROPIA OBRA. NO TENDRÁ DE QUÉ PREOCUPARSE"
    ],
    "nl": [
      "SG CUISINE & AGENCEMENT INTERIEUR BIEDT U EEN VOLLEDIGE BEGELEIDING VAN ONTWERP TOT OPLEVERING VOOR AL UW INTERIEURRENOVATIEPROJECTEN: KEUKEN - BADKAMER - DRESSING ALSOOK DE WERKEN ZELF\r\nUW INTERIEURRENOVATIEPROJECTEN: KEUKEN - BADKAMER - DRESSING ALSOOK DE WERKEN ZELF. U HOEFT ZICH NERGENS ZORGEN OVER TE MAKEN!"
    ]
  },
