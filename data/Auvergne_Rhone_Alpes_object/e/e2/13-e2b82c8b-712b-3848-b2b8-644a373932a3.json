  "rdfs:comment": {
    "de": [
      "Das C'CI Gourmand ist ein Restaurant in der CCI Nord Isère. Er ist ab 8:30 Uhr geöffnet und bietet Frühstück und Kaffee an, danach eine abwechslungsreiche Mittagskarte bis 15 Uhr"
    ],
    "en": [
      "C'CI Gourmand is a restaurant located within the CCI Nord Isère. Open from 8:30am, it offers breakfast and coffee, followed by a varied menu for lunch until 3pm"
    ],
    "it": [
      "Il C'CI Gourmand è un ristorante situato all'interno del CCI Nord Isère. Aperto dalle 8.30, offre colazione e caffè, seguiti da un menù vario per il pranzo fino alle 15.00"
    ],
    "fr": [
      "Le C'CI Gourmand est un espace de restauration situé au sein de la CCI Nord Isère. Ouvert dès 8h30, il propose petit déjeuner et café, puis une carte variée pour le déjeuner jusqu’à 15h"
    ],
    "nl": [
      "C'CI Gourmand is een restaurant in de CCI Nord Isère. Het is geopend vanaf 8.30 uur en biedt ontbijt en koffie, gevolgd door een gevarieerd lunchmenu tot 15.00 uur"
    ],
    "es": [
      "C'CI Gourmand es un restaurante situado dentro de la CCI Nord Isère. Abierto desde las 8.30 h, ofrece desayunos y cafés, seguidos de un menú variado para el almuerzo hasta las 15 h"
    ]
  },
