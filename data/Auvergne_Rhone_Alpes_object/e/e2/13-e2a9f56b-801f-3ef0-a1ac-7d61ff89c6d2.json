  "rdfs:comment": {
    "de": [
      "Darstellende Kunst für jedes Publikum, Schulklassen, junges Publikum, Reportagen, Vorträge, um sich zu bilden und anders zu reisen, Kino aller Art, Projekte mit Vereinen. Eine reiche Palette an künstlerischen Verabredungen, die in der Nähe stattfinden."
    ],
    "en": [
      "As a playhouse, art house cinema and artist residency centre, the Jean Carmet Culture Centre offers eclectic and original programmes all year round for the pleasure of young and old alike: concerts, shows, conferences..."
    ],
    "it": [
      "Spettacoli dal vivo per tutti i pubblici, scuole, giovani, reportage, conferenze per imparare e viaggiare in modo diverso, cinema di tutti i tipi, progetti con associazioni. Una ricca tavolozza di eventi artistici locali."
    ],
    "fr": [
      "Du spectacle vivant pour tout public, scolaire, jeune public, des reportages, des conférences pour s'instruire et voyager autrement, du cinéma en tout genre, des projets avec les associations. Une palette de rendez-vous artistiques riche et de proximité."
    ],
    "nl": [
      "Live voorstellingen voor alle doelgroepen, scholen, jongeren, reportages, conferenties om op een andere manier te leren en te reizen, allerlei soorten films, projecten met verenigingen. Een rijk palet aan lokale artistieke evenementen."
    ],
    "es": [
      "Actuaciones en directo para todos los públicos, colegios, jóvenes, reportajes, conferencias para aprender y viajar de forma diferente, cine de todo tipo, proyectos con asociaciones. Una rica paleta de eventos artísticos locales."
    ]
  },
