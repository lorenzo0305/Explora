  "rdfs:comment": {
    "de": [
      "Wir betreiben biologische und bäuerliche Landwirtschaft und produzieren unseren Weizen, unser Mehl, unseren Wein, unsere Eier, unser Gemüse und unser Obst.\r\nWir sind Mitglied des Netzwerks Paysans de nature (Naturbauern)."
    ],
    "en": [
      "We produce our own wheat, flour, wine, eggs, vegetables and fruit.\r\nWe are a member of the Paysans de nature network."
    ],
    "it": [
      "Produciamo in proprio grano, farina, vino, uova, verdura e frutta.\r\nSiamo membri della rete Paysans de Nature."
    ],
    "fr": [
      "Agriculture biologique et paysanne, nous produisons notre blé, notre farine, notre vin, nos œufs, nos légumes et nos fruits. \r\nNous sommes membre du réseau Paysans de nature."
    ],
    "nl": [
      "We produceren onze eigen tarwe, bloem, wijn, eieren, groenten en fruit.\r\nWe zijn lid van het Paysans de Nature netwerk."
    ],
    "es": [
      "Producimos nuestro propio trigo, harina, vino, huevos, verduras y frutas.\r\nSomos miembros de la red Paysans de Nature."
    ]
  },
