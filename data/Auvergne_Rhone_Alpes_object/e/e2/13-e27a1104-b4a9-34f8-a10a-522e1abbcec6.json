  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen ein Tagesmenü und eine Tagesempfehlung, die nach den Wünschen des Küchenchefs zusammengestellt werden.\r\nAuf der abwechslungsreichen Speisekarte finden Sie Black-Angus-Steaks, Ravioli, Salate und Souvenirs aus Italien."
    ],
    "en": [
      "The restaurant offers a menu of the day and the Chef's suggestion of the day.\r\nYou will also find a varied menu of black Angus rib steaks, ravioli, salads and souvenirs from Italy."
    ],
    "it": [
      "Il ristorante offre un menu del giorno e una proposta del giorno elaborata secondo i desideri dello chef.\r\nTroverete anche un menù vario con costine di Angus nero, ravioli, insalate e souvenir italiani."
    ],
    "fr": [
      "Le restaurant vous propose un menu du jour et une suggestion du jour concoctés selon les envies du Chef.\r\nVous retrouverez aussi une carte variée où se cotoient entrecôtes black Angus, ravioles, salades et souvenirs d’Italie."
    ],
    "nl": [
      "Het restaurant biedt een menu van de dag en een suggestie van de dag samengesteld volgens de wensen van de chef.\r\nU vindt er ook een gevarieerd menu met black Angus ribs, ravioli, salades en Italiaanse souvenirs."
    ],
    "es": [
      "El restaurante ofrece un menú del día y una sugerencia del día elaborada según los deseos del chef.\r\nTambién encontrará un menú variado con costillas black Angus, raviolis, ensaladas y recuerdos italianos."
    ]
  },
