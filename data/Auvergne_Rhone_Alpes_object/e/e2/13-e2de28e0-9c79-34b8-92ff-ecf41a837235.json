  "rdfs:comment": {
    "de": [
      "Mittelalterliches Dorf mit den Ruinen eines Bergfrieds – Tore und Befestigungsanlagen. Kirche des Heiligen Mauritius: umgestaltete romanische Kirche mit einem vollständig mit denkmalgeschützten Fresken aus dem XII. Jahrhundert verzierten Chor."
    ],
    "en": [
      "Medieval village with ruins of the dungeon – Gates and fortifications.\r\nSt Maurice Church: renovated Romanesque church with its chancel completely covered with listed 12th century frescoes."
    ],
    "it": [
      "Un vero e proprio balcone sul fiume: Lasciatevi sedurre dalle sue straordinarie vedute (oppidum celtico, chiesa, torrione, bastioni, affreschi, maniero rinascimentale)"
    ],
    "fr": [
      "Véritable balcon dominant le fleuve : Laissez-vous séduire par ses points de vue remarquables (oppidum celte, église, donjon, remparts, fresques, manoir renaissance)"
    ],
    "es": [
      "Un auténtico balcón sobre el río: Déjese seducir por sus extraordinarias vistas (oppidum celta, iglesia, torre del homenaje, murallas, frescos, casa solariega renacentista)"
    ],
    "nl": [
      "Een echt balkon met uitzicht op de rivier: Laat je verleiden door het opmerkelijke uitzicht (Keltisch oppidum, kerk, donjon, wallen, fresco's, Renaissance landhuis)"
    ]
  },
  "rdfs:label": {
