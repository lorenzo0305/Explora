  "rdfs:comment": {
    "de": [
      "Ideal gelegen zwischen Le Cheylard und Saint-Sauveur-de-Montagut, an der Grenze zwischen Natur und ungewöhnlichen Landschaften, entdecken Sie Le Relais du Pont, ein traditionelles Restaurant im Herzen des Eyrieux-Tals und in der Nähe der berühmten Dolce Via."
    ],
    "en": [
      "Ideally located between Le Cheylard and Saint-Sauveur-de-Montagut, on the border between nature and unusual landscapes, discover Le Relais du Pont, a traditional restaurant in the heart of the Eyrieux Valley and close to the famous Dolce Via."
    ],
    "it": [
      "In posizione ideale tra Le Cheylard e Saint-Sauveur-de-Montagut, al confine tra natura e paesaggi insoliti, scoprite Le Relais du Pont, un ristorante tradizionale nel cuore della Valle dell'Eyrieux e vicino alla famosa Dolce Via."
    ],
    "fr": [
      "Idéalement localisé entre Le Cheylard et Saint-Sauveur-de-Montagut, à la frontière entre nature et paysages insolites, découvrez Le Relais du Pont, restaurant traditionnel en plein cœur de la Vallée de l'Eyrieux et à proximité de la célèbre Dolce Via."
    ],
    "es": [
      "Idealmente situado entre Le Cheylard y Saint-Sauveur-de-Montagut, en la frontera entre naturaleza y paisajes insólitos, descubra Le Relais du Pont, un restaurante tradicional en el corazón del valle de Eyrieux y cerca de la famosa Dolce Via."
    ],
    "nl": [
      "Ideaal gelegen tussen Le Cheylard en Saint-Sauveur-de-Montagut, op de grens tussen natuur en ongewone landschappen, ontdek Le Relais du Pont, een traditioneel restaurant in het hart van de Eyrieux vallei en vlakbij de beroemde Dolce Via."
    ]
  },
