  "rdfs:comment": {
    "de": [
      "Das Kulturzentrum, eine Hochburg des Kulturerbes in der Tarentaise, beherbergt das Museum für Volkstraditionen, das Museum für Geschichte und Archäologie, eine Ausstellungsgalerie und bietet Führungen, monatliche Ausstellungen und kulturelle Veranstaltungen an"
    ],
    "en": [
      "The Cultural Centre, a major heritage site in Tarentaise, houses the Museum of Popular Traditions, the Museum of History and Archaeology, an exhibition gallery, and offers guided tours, monthly exhibitions, and cultural events."
    ],
    "it": [
      "Il Centro culturale, importante patrimonio della Tarentaise, ospita il Museo delle tradizioni popolari, il Museo di storia e archeologia, una galleria espositiva e offre visite guidate, mostre mensili ed eventi culturali"
    ],
    "fr": [
      "Le Centre culturel haut-lieu du patrimoine en Tarentaise, abrite le Musée des Traditions Populaires, le musée d'histoire et d'archéologie, une galerie d'exposition et propose des visites guidées, des expositions mensuelles et des animations culturelles"
    ],
    "es": [
      "La Casa de la Cultura, gran patrimonio de la Tarentaise, alberga el Museo de Tradiciones Populares, el Museo de Historia y Arqueología, una galería de exposiciones y ofrece visitas guiadas, exposiciones mensuales y actos culturales"
    ],
    "nl": [
      "Het Cultureel Centrum, een belangrijke erfgoedlocatie in de Tarentaise, huisvest het Museum van Volksgebruiken, het Museum voor Geschiedenis en Archeologie, een tentoonstellingsgalerij en biedt rondleidingen, maandelijkse tentoonstellingen en culturele evenementen"
    ]
  },
