  "rdfs:comment": {
    "de": [
      "Marvel Infinity Saga ist eine neue, dem Marvel-Filmuniversum gewidmete Veranstaltung, die die visuelle Kraft der 23 Filme der Saga mit der Emotionalität einer Live-Musik-Performance verbindet, um ein immersives Erlebnis im Herzen des Marvel-Epos zu schaffen."
    ],
    "en": [
      "Marvel Infinity Saga is a unique event dedicated to the Marvel cinematic universe, combining the visual power of the saga's 23 films with the emotion of a live musical performance, for an immersive experience at the heart of the Marvel epic."
    ],
    "it": [
      "Marvel Infinity Saga è un evento unico dedicato al Marvel Cinematic Universe, che combina la potenza visiva dei 23 film della saga con l'emozione di una performance musicale dal vivo, per un'esperienza coinvolgente nel cuore dell'epopea Marvel."
    ],
    "fr": [
      "Marvel Infinity Saga c'est l'événement inédit et dédié à l'univers cinématographique Marvel associant la puissance visuelle des 23 films de la saga à l'émotion d'une performance musicale en direct, pour une expérience immersive au cœur de l'épopée Marvel."
    ],
    "nl": [
      "Marvel Infinity Saga is een uniek evenement gewijd aan het Marvel Cinematic Universe, waarbij de visuele kracht van de 23 films uit de saga wordt gecombineerd met de emotie van een live muziekoptreden, voor een meeslepende ervaring in het hart van het Marvel-epos."
    ],
    "es": [
      "Marvel Infinity Saga es un evento único dedicado al Universo Cinematográfico Marvel, que combina el poder visual de las 23 películas de la saga con la emoción de una actuación musical en directo, para una experiencia inmersiva en el corazón de la epopeya Marvel."
    ]
  },
