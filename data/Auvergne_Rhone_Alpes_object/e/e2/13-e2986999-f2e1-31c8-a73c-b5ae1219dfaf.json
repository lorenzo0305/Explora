  "rdfs:comment": {
    "de": [
      "Am Fuße des Sessellifts Torchon in La Chèvrerie. La R'Mize, Bar, Snack, Crêperie empfängt Sie während der Wintersaison...Die kleine Ecke für den großen Hunger!Schnellrestaurants und Bar mit Terrasse."
    ],
    "en": [
      "At the foot of the Torchon chairlift in La Chèvrerie. La R'Mize, bar, snack bar, crêperie welcomes you during the winter season... The place to go if you're feeling peckish! Fast food and bar with terrace."
    ],
    "it": [
      "Ai piedi della seggiovia Torchon a La Chèvrerie. La R'Mize, bar, snack bar, crêperie vi accoglie durante la stagione invernale... Il posto giusto se avete un certo languorino! Fast food e bar con terrazza."
    ],
    "fr": [
      "Au pied du télésiège du Torchon à La Chèvrerie. La R'Mize, bar, snack,crêperie vous accueille durant la saison d'hiver...Le petit coin des grands creux !Restauration rapide et bar avec terrasse."
    ],
    "es": [
      "Al pie del telesilla Torchon, en La Chèvrerie. La R'Mize, bar, snack bar, crêperie le da la bienvenida durante la temporada de invierno... ¡El lugar al que acudir si tiene hambre! Comida rápida y bar con terraza."
    ],
    "nl": [
      "Aan de voet van de stoeltjeslift Torchon in La Chèvrerie. La R'Mize, bar, snackbar, crêperie verwelkomt je tijdens het winterseizoen... Dé plek om naartoe te gaan als je trek hebt! Fast food en bar met terras."
    ]
  },
  "rdfs:label": {
