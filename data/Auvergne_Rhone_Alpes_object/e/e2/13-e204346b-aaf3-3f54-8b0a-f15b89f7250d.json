  "rdfs:comment": {
    "de": [
      "Im historischen Zentrum von Brioude bietet Ihnen das Hôtel de la Dentelle bemerkenswerte Stücke aus dem 17., 18. und 19."
    ],
    "en": [
      "In Brioude's historic center, the Hôtel de la Dentelle offers you the chance to discover remarkable pieces dating from the 17th, 18th and 19th centuries."
    ],
    "it": [
      "Nel centro storico di Brioude, l'Hôtel de la Dentelle vi invita a scoprire alcuni pezzi notevoli risalenti al XVII, XVIII e XIX secolo."
    ],
    "fr": [
      "Dans le centre historique de Brioude, l'Hôtel de la Dentelle vous propose de découvrir des pièces remarquables datant du 17 -ème, 18 -ème et 19 -ème siècle."
    ],
    "nl": [
      "In het historische centrum van Brioude nodigt Hôtel de la Dentelle je uit om een aantal opmerkelijke stukken uit de 17e, 18e en 19e eeuw te ontdekken."
    ],
    "es": [
      "En el centro histórico de Brioude, el Hôtel de la Dentelle le invita a descubrir algunas piezas notables de los siglos XVII, XVIII y XIX."
    ]
  },
