  "rdfs:comment": {
    "de": [
      "Als Bergführer, Canyonführer und Schneespezialistentrainer an der ANENA stehe ich Ihnen zur Verfügung, um Ihre Ausflüge zum Klettern, Bergsteigen, Skitourengehen, Canyoning..  Im Vercors und anderswo."
    ],
    "en": [
      "Mountain guide, canyon guide, and snow specialist trainer at ANENA, I can organize and lead you on climbing, mountaineering, ski touring, canyoning, ... In the Vercors and anywhere."
    ],
    "it": [
      "Guida di alta montagna, guida di canyoning e formatore nivologo ANENA, sono qui per aiutarvi a organizzare e guidare le vostre uscite di arrampicata, alpinismo, scialpinismo e canyoning... Nel Vercors e altrove."
    ],
    "fr": [
      "Guide de haute montagne, guide de canyon, et formateur nivologue à l'ANENA, je suis à votre disposition pour organiser et guider vos sorties en escalade, alpinisme, ski de randonnée, canyon ... Dans le Vercors et ailleurs."
    ],
    "es": [
      "Como guía de alta montaña, guía de barrancos y formador nivologue ANENA, estoy aquí para ayudarte a organizar y guiar tus salidas de escalada, alpinismo, esquí de travesía y barrancos... En el Vercors y en otros lugares."
    ],
    "nl": [
      "Als gids in het hooggebergte, canyoninggids en ANENA nivologietrainer ben ik er om je te helpen bij het organiseren en begeleiden van je klim-, bergbeklim-, skitochten en canyoninguitstapjes... In de Vercors en elders."
    ]
  },
