  "rdfs:comment": {
    "de": [
      "Das prestigeträchtigste internationale Junioren-Etappenrennen im Radsport kehrt 2026 mit einem Männer- und einem Frauenrennen zu seiner 38. Auflage auf die malerischen Bergstraßen von Ain zurück."
    ],
    "en": [
      "The most prestigious international junior stage cycling race returns in 2026 to the beautiful mountain roads of Ain with a men's and a women's event for its 38th edition."
    ],
    "it": [
      "La più prestigiosa gara ciclistica internazionale a tappe per juniores torna sulle splendide strade delle montagne di Ain nel 2026 con una gara maschile e una femminile per la sua 38ª edizione."
    ],
    "fr": [
      "La plus prestigieuse course course cycliste juniors internationale par étape revient en 2026 sur les belles routes de la montagne de l'Ain avec une épreuve masculine et une épreuve féminine pour sa 38e édition."
    ],
    "es": [
      "La carrera ciclista por etapas junior internacional más prestigiosa regresa a las bellas carreteras de las montañas de Ain en 2026 con una carrera masculina y otra femenina en su 38ª edición."
    ],
    "nl": [
      "De meest prestigieuze internationale wielerronde voor junioren keert in 2026 terug naar de prachtige wegen van het Ain-gebergte met een mannen- en een vrouwenwedstrijd voor de 38e editie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ain Bugey Valromey Tour 2026 - 38th edition"
    ],
    "fr": [
      "Ain Bugey Valromey Tour 2026 - 38e édition"
    ]
  },
