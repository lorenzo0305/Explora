  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit unseren pädagogischen Workshops in die Natur ein: Eintauchen in die Welt der Bienen, Spaziergänge mit Eseln, Barfußpfade, Sinnesparcours im Zauberwald, Entdeckung von Honigblumen und -bäumen und Erforschung der Biodiversität."
    ],
    "en": [
      "Immerse yourself in the heart of nature with our educational workshops: immersion in the world of bees, donkey rides, barefoot trails, a sensory journey through the magic forest, discovering melliferous flowers and trees, and exploring biodiversity."
    ],
    "it": [
      "Immergetevi nel cuore della natura con i nostri laboratori didattici: immersione nel mondo delle api, passeggiate a dorso d'asino, percorsi a piedi nudi, viaggio sensoriale nel bosco magico, scoperta dei fiori e degli alberi che producono miele ed esplorazione della biodiversità"
    ],
    "fr": [
      "Plongez au cœur de la nature avec nos ateliers pédagogiques: immersion dans le monde des abeilles, balade avec les ânes, sentiers pieds nus, parcours sensoriel en forêt magique, découverte des fleurs et arbres mellifères, et exploration de la biodiversité"
    ],
    "es": [
      "Sumérjase en plena naturaleza con nuestros talleres educativos: inmersión en el mundo de las abejas, paseos en burro, senderos para caminar descalzo, un viaje sensorial por el bosque mágico, descubrimiento de flores y árboles productores de miel y exploración de la biodiversidad"
    ],
    "nl": [
      "Dompel jezelf onder in het hart van de natuur met onze educatieve workshops: onderdompeling in de wereld van de bijen, ezeltochten, blotevoetenpaden, een zintuiglijke reis door het magische bos, het ontdekken van honingproducerende bloemen en bomen en het verkennen van de biodiversiteit"
    ]
  },
