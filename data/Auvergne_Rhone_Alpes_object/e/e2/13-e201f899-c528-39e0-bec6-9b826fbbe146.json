  "rdfs:comment": {
    "de": [
      "Die Thai-Massage ist eine Tiefenmassage, bei der Druck und Dehnung kombiniert werden, um den ganzen Körper zu bearbeiten und uns zu ermutigen, uns zu öffnen und loszulassen."
    ],
    "en": [
      "Thai massage is a deep-tissue massage that combines pressure and stretching to work the whole body, encouraging us to open up and let go, releasing tension and blockages in our bodies."
    ],
    "it": [
      "Il massaggio thailandese è un massaggio dei tessuti profondi che combina pressione e allungamento per lavorare su tutto il corpo e incoraggiarci ad aprirci e a lasciarci andare; scioglie le tensioni e i blocchi nel nostro corpo."
    ],
    "fr": [
      "Le massage Thaï est un massage profond qui combine pressions et étirements pour travailler tout le corps et nous encourager ainsi à nous ouvrir et à lâcher prise; il permet de libérer les tensions et les blocages dans notre corps."
    ],
    "nl": [
      "Thaise massage is een diepe-weefselmassage die druk en strekking combineert om het hele lichaam te bewerken, ons aanmoedigt om ons te openen en los te laten; het laat spanningen en blokkades in het lichaam los."
    ],
    "es": [
      "El masaje tailandés es un masaje de tejido profundo que combina presión y estiramiento para trabajar todo el cuerpo y animarnos a abrirnos y soltarnos; libera la tensión y los bloqueos de nuestro cuerpo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Massage Thaï - Espace Barral"
    ]
  },
