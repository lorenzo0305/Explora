  "rdfs:comment": {
    "de": [
      "Fläche: 7 ha. Fische: Koi-Karpfen, Hechte, Zander, Forellen, Schleien, Karpfen und Rotaugen. Alle Fische über 3 kg müssen wieder zurückgesetzt werden."
    ],
    "en": [
      "Area: 7 hectares. Fish: koi carp, pike, zander, trout, tench, carp and roach. Any fish weighing more than 3 kg must be returned to the water."
    ],
    "it": [
      "Superficie: 7 ettari. Pesci: carpa Koi, luccio, lucioperca, trota, tinca, carpa e lasca. Tutti i pesci di peso superiore a 3 kg devono essere rimessi in acqua."
    ],
    "fr": [
      "Surface : 7 ha. Poissons : carpes Koï, brochets, sandres, truites, tanches, carpes et gardons. Tout poisson de plus de 3 kg doit être remis à l'eau."
    ],
    "es": [
      "Superficie: 7 ha. Pesca: carpas koi, lucios, luciopercas, truchas, tencas, carpas y cucarachas. Todos los peces de más de 3 kg deben devolverse al agua."
    ],
    "nl": [
      "Oppervlakte: 7 ha. Vis: Koikarper, snoek, snoekbaars, forel, zeelt, karper en voorn. Alle vissen van meer dan 3 kg moeten worden teruggezet in het water."
    ]
  },
