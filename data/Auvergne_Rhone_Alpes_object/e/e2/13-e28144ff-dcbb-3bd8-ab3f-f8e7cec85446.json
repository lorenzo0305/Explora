  "rdfs:comment": {
    "de": [
      "Agora ist mehr als eine einfache Bibliothek und wurde als Ort der Begegnung und des Austauschs konzipiert."
    ],
    "en": [
      "More than just a library, Agora was conceived as a place to meet and exchange ideas."
    ],
    "it": [
      "Più che una semplice biblioteca, Agora è stata concepita come un luogo di incontro e di scambio di idee."
    ],
    "fr": [
      "Plus qu'une simple bibliothèque, Agora a été imaginée comme un lieu de rencontre et d'échanges."
    ],
    "es": [
      "Más que una biblioteca, Ágora se ha concebido como un lugar de encuentro e intercambio de ideas."
    ],
    "nl": [
      "Agora is meer dan alleen een bibliotheek en is ontworpen als een plek om elkaar te ontmoeten en ideeën uit te wisselen."
    ]
