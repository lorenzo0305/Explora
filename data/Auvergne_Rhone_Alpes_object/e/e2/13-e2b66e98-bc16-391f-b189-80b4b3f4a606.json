  "rdfs:comment": {
    "de": [
      "Les Variétés bietet Ihnen ein vielfältiges Programm: Von Arthouse- bis hin zu allgemeinen Filmen in 3D werden alle wichtigen nationalen Kinostarts gezeigt!"
    ],
    "en": [
      "Les Variétés offers a diversified program: from arthouse to general movies in 3D, all the major national releases are shown!"
    ],
    "it": [
