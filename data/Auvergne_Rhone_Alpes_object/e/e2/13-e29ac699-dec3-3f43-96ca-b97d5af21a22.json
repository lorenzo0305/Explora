  "rdfs:comment": {
    "de": [
      "Inspiriert von Farben und der Natur, füge ich meiner Malerei Energetisches hinzu. Lebendige Kunstwerke, die mit den Chakren ausgerichtet sind, maßgeschneidert auf Personen oder Orte."
    ],
    "en": [
      "Inspired by colors and nature, I add energy to my painting. Vibrant works aligned with the chakras, tailored to people or places."
    ],
    "it": [
      "Ispirata dai colori e dalla natura, aggiungo un tocco energetico ai miei dipinti: opere viventi allineate con i chakra, fatte su misura per persone o luoghi."
    ],
    "fr": [
      "Inspirée par les couleurs et la nature, j'ajoute de l'énergétique à ma peinture. Œuvres vivantes alignées avec les chakras, sur mesure avec les personnes ou des lieux."
    ],
    "es": [
      "Inspirándome en los colores y la naturaleza, añado un toque energético a mis cuadros: obras vivas alineadas con los chakras, hechas a medida para personas o lugares."
    ],
    "nl": [
      "Geïnspireerd door kleuren en de natuur voeg ik energie toe aan mijn schilderijen. Levende werken uitgelijnd met de chakra's, op maat gemaakt met mensen of plaatsen."
    ]
  },
  "rdfs:label": {
