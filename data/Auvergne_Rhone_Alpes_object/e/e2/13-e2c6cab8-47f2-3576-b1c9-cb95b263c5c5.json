  "rdfs:comment": {
    "de": [
      "Der Handwerker formt Gebrauchsgegenstände aus Steingut (weiß, rotbraun), die mit Engoben und Glasuren verziert sind. Er bietet Einführungskurse für das Drehen an."
    ],
    "en": [
      "The artisan shapes functional stoneware pieces in white, russet, and black clay, adorned with slips and glazes. They craft decorative objects in earthenware and offer beginner pottery classes."
    ],
    "it": [
      "L'artigiano realizza pezzi utilitari in gres (bianco e rosso), decorati con ingobbi e smalti. Offre anche corsi di introduzione alla lavorazione."
    ],
    "fr": [
      "L'artisan façonne des pièces utilitaires en grès (blanc, roux), ornées d'engobes et d'émaux. Il propose des cours d'initiation au tournage."
    ],
    "es": [
      "El artesano fabrica piezas utilitarias en gres (blanco y rojo), decoradas con engobes y esmaltes. También ofrece cursos de iniciación al tiro."
    ],
    "nl": [
      "De ambachtsman vervaardigt functioneel aardewerk (wit, rood en zwart) versierd met slibs en glazuren. Hij creëert decoratieve objecten van faience en biedt beginnerslessen pottenbakken aan."
    ]
  },
