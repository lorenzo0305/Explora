  "rdfs:comment": {
    "de": [
      "Gérard Vialet präsentiert eine große Anzahl von Originalzeichnungen von Raymond Peynet und viele Objekte, an denen er gearbeitet hat, wie Medaillen, Tücher, Porzellan, Bücher, Taschen und Puppen."
    ],
    "en": [
      "Gérard Vialet presents a large number of original drawings by Raymond Peynet and many of the objects he worked on, such as medals, scarves, porcelain, books, pouches and dolls."
    ],
    "it": [
      "Gérard Vialet presenta un gran numero di disegni originali di Raymond Peynet e molti oggetti su cui ha lavorato, come medaglie, sciarpe, porcellane, libri, buste e bambole."
    ],
    "fr": [
      "Gérard Vialet présente un grand nombre de dessins originaux de Raymond Peynet et de nombreux objets sur lesquels il a travaillé, tels que médailles, foulards, porcelaines, livres, pochettes et poupées."
    ],
    "nl": [
      "Gérard Vialet presenteert een groot aantal originele tekeningen van Raymond Peynet en veel van de objecten waaraan hij werkte, zoals medailles, sjaals, porselein, boeken, buidels en poppen."
    ],
    "es": [
      "Gérard Vialet presenta un gran número de dibujos originales de Raymond Peynet y numerosos objetos en los que trabajó, como medallas, pañuelos, porcelanas, libros, bolsas y muñecas."
    ]
  },
