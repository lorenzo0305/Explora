  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Rundgang über die Geschichte des Kamms und der Kunststoffe im genialen Tal Haut-Bugey: Verwendungszwecke und Verarbeitungsverfahren, Kreativität bei der Herstellung von Kunststoffgegenständen, Alltagsartefakten bis hin zu Luxusstücken."
    ],
    "en": [
      "Come along and discover the history of plastics - their uses, how they are made and the creative side of producing plastic parts, from routine artefacts to luxury objects."
    ],
    "it": [
      "Venite a scoprire la storia del pettine e delle materie plastiche nell'ingegnosa valle dell'Haut-Bugey: usi e processi di trasformazione, creatività nella produzione di oggetti in plastica, da manufatti di uso quotidiano a oggetti di lusso."
    ],
    "fr": [
      "Venez découvrir le parcours sur l'histoire du peigne et des matières plastiques de la vallée ingénieuse du Haut-Bugey : usages et procédés de transformation, créativité des productions d'objets en plastique, artefacts du quotidien aux pièces de luxe."
    ],
    "es": [
      "Venga a descubrir la historia del peine y de los materiales plásticos en el ingenioso valle del Haut-Bugey: usos y procesos de transformación, creatividad en la producción de objetos de plástico, desde artefactos cotidianos hasta artículos de lujo."
    ],
    "nl": [
      "Kom en ontdek de geschiedenis van de kam en plastic materialen in de ingenieuze vallei van de Haut-Bugey: gebruik en transformatieprocessen, creativiteit in de productie van plastic voorwerpen, van alledaagse voorwerpen tot luxeartikelen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Museum des Kamms und der Kunststoffverarbeitung"
    ],
    "en": [
      "Museum of the comb and the plastics processing industry"
    ],
    "fr": [
      "Musée du Peigne et de la Plasturgie"
    ]
  },
