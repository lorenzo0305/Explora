  "rdfs:comment": {
    "de": [
      "Werkstatt für die Zerlegung und Verarbeitung von Fleisch aus lokalen Zuchtbetrieben. Direktverkauf von hausgemachtem Fleisch und Wurstwaren ohne Zusatz- und Konservierungsstoffe. Online-Bestellung möglich und Lieferung nach Hause in ganz Frankreich."
    ],
    "en": [
      "Workshop for cutting and processing meat from local farms. On-site shop: direct sales of homemade meat and charcuterie with no additives or preservatives, groceries. Online ordering and home delivery anywhere in France."
    ],
    "it": [
      "Laboratorio di taglio e lavorazione della carne proveniente da allevamenti locali. Negozio in loco: vendita diretta di carne e salumi fatti in casa senza additivi né conservanti, generi alimentari. Ordini online e consegna a domicilio in tutta la Francia."
    ],
    "fr": [
      "Atelier de découpe et transformation des viandes d'élevages locaux. Magasin sur place: vente directe viande et charcuterie maison sans additifs ni conservateurs, épicerie. Commande en ligne et livraison à domicile partout en France."
    ],
    "es": [
      "Taller de despiece y transformación de carne de granjas locales. Tienda in situ: venta directa de carne y charcutería caseras sin aditivos ni conservantes, comestibles. Pedidos en línea y entrega a domicilio en cualquier lugar de Francia."
    ],
    "nl": [
      "Atelier van het trancheren en bewerken van vlees van lokale veehouderijen. Het bedrijf biedt diensten aan landbouwproducenten via directe verkoop en verkoopt het vlees en de ambachtelijke vleeswaren in de winkel en in een netwerk van verschillende retailers."
    ]
  },
