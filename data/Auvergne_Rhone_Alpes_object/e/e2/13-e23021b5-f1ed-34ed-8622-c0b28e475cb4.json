  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Park des Anwesens und erfahren Sie mehr über die Geschichte des Schlosses.\r\nDas Schloss ist ein idealer geselliger Ort für Ihre Projekte und empfängt in seinem Park mit hundertjährigen Bäumen seit 10 Jahren Gruppen (Cousinaden, Sportveranstaltungen, Hochzeiten, Rallyes)."
    ],
    "en": [
      "Come and visit the grounds and discover the history of the château.\r\nA convivial venue ideal for your projects, the château has been welcoming groups (cousinades, sports events, weddings, rallies) to its park of century-old trees for 10 years."
    ],
    "it": [
      "Venite a visitare il parco e a scoprire la storia del castello.\r\nIl parco del castello, con i suoi alberi secolari, è stato il luogo ideale per i gruppi negli ultimi 10 anni (cuginate, eventi sportivi, matrimoni, raduni)."
    ],
    "fr": [
      "Venez visiter le parc de la propriété et découvrez l'histoire du château.\r\nLieu convivial idéal pour vos projets, le château accueille dans son parc aux arbres centenaires des groupes depuis 10 ans (cousinades, rendez-vous sportifs, mariages, rallyes)."
    ],
    "es": [
      "Visite el recinto y descubra la historia del castillo.\r\nEl parque del castillo, con sus árboles centenarios, ha sido el lugar ideal para grupos durante los últimos 10 años (cusinadas, eventos deportivos, bodas, rallies)."
    ],
    "nl": [
      "Bezoek het park en ontdek de geschiedenis van het kasteel.\r\nHet park van het kasteel, met zijn eeuwenoude bomen, is de afgelopen 10 jaar de ideale locatie geweest voor groepen (cousinades, sportevenementen, bruiloften, rally's)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de la Croix"
    ]
  },
