  "rdfs:comment": {
    "de": [
      "Seit 115 Jahren stellen wir die echten Glaçons de Megève® her, deren Rezept von Barthélémy Vigliengo erfunden wurde. Ich lade Sie ein, sie in unserer Boutique zu entdecken und zu verkosten."
    ],
    "en": [
      "For 115 years we have been making the “Glaçons de Megève” ®. The recipe, created by Barthélémy Vigliengo in 1909, is a delicate praline coated with a fine meringue. Come and discover our speciality for the delight of your taste buds!"
    ],
    "it": [
      "Da 115 anni, fabbrichiamo il vero Glaçon de Megève®, la cui ricetta fu inventata da Barthélémy Vigliengo. Vi invitiamo a scoprirlo e degustarlo nel nostro negozio."
    ],
    "fr": [
      "Depuis 115 ans, nous fabriquons les véritables Glaçons de Megève® dont la recette a été inventée par Barthélémy Vigliengo. Je vous invite à les découvrir et à les déguster dans notre boutique."
    ],
    "es": [
      "Desde hace 115 años, elaboramos los auténticos Glaçons de Megève®, cuya receta inventó Barthélémy Vigliengo. Le invito a descubrirlos y degustarlos en nuestra tienda."
    ],
    "nl": [
      "Al 115 jaar maken we echte Glaçons de Megève®, waarvan het recept werd uitgevonden door Barthélémy Vigliengo. Ik nodig je uit om ze te ontdekken en te proeven in onze winkel."
    ]
  },
