  "rdfs:comment": {
    "de": [
      "Auf der Suche nach einem besseren Wohlbefinden für Sie und unseren Planeten lade ich Sie ein, Konfektionen zu entdecken, die auf Ihr Wohlbefinden ausgerichtet sind, um Ihre Schmerzen und Emotionen zu lindern, Ihnen einen Moment der Entspannung zu schenken, eine Pause einzulegen."
    ],
    "en": [
      "In search of well-being for you and for the planet, I invite you to discover wellness-oriented confections for you, to soothe your pain, your emotions, to offer you a moment of relaxation, to put you on pause."
    ],
    "it": [
      "Nella mia ricerca di benessere per voi e per il pianeta, vi invito a scoprire una gamma di prodotti pensati per aiutarvi a sentirvi meglio, per lenire i vostri dolori e le vostre emozioni e per offrirvi un momento di relax."
    ],
    "fr": [
      "En quête de mieux-être pour vous et pour la planète, je vous invite à découvrir des confections orientées bien-être pour vous, pour apaiser vos douleurs, vos émotions, vous offrir un moment détente, une mise sur pause."
    ],
    "nl": [
      "In mijn zoektocht naar welzijn voor jou en voor de planeet, nodig ik je uit om een reeks producten te ontdekken die ontworpen zijn om je te helpen je beter te voelen, je pijn en emoties te verzachten en je een moment van ontspanning te bieden."
    ],
    "es": [
      "En mi búsqueda del bienestar para ti y para el planeta, te invito a descubrir una gama de productos diseñados para ayudarte a sentirte mejor, calmar tus dolores y emociones y ofrecerte un momento de relajación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Almetya - La couture bien-être"
    ]
  },
