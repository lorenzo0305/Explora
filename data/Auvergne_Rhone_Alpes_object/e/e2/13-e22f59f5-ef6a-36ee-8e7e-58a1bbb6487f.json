  "rdfs:comment": {
    "de": [
      "Les Flâneries d'Oingt ist eine Boutique, die Ihnen zwei Welten von zwei Ikonen anbietet: die Kreationen (Malerei und Keramik) von Noémie Labrosse und den kleinen Trödelmarkt von Anne."
    ],
    "en": [
      "Les Flâneries d'Oingt is a shop that offers you 2 worlds from 2 iconic women: the creations (painting and ceramics) of Noémie Labrosse and the small flea market of Anne."
    ],
    "it": [
      "Les Flâneries d'Oingt è una boutique che offre i due mondi di due icone: le creazioni di Noémie Labrosse (pittura e ceramica) e il piccolo negozio di seconda mano di Anne."
    ],
    "fr": [
      "Les Flâneries d'Oingt est une boutique qui vous propose 2 univers de 2 iconiennes : les créations (peinture et céramique) de Noémie Labrosse et la petite brocante d'Anne."
    ],
    "nl": [
      "Les Flâneries d'Oingt is een boetiek met 2 werelden van 2 iconiennes: de creaties van Noémie Labrosse (schilderkunst en keramiek) en het tweedehandswinkeltje van Anne."
    ],
    "es": [
      "Les Flâneries d'Oingt es una boutique que ofrece 2 mundos de 2 iconiennes: las creaciones de Noémie Labrosse (pintura y cerámica) y la pequeña tienda de segunda mano de Anne."
    ]
  },
