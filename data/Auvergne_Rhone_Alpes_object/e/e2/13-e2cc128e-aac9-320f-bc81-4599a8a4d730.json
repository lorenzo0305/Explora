  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Skitourengehen in Mont-Saxonnex! Genießen Sie eine angenehme Fahrt auf einer breiten, präparierten Piste bei der Abfahrt. Der Zugang ist während der Öffnungszeiten des Skigebiets gestattet. Vorsicht: Die Pistenraupen sind ab der Schließung aktiv!"
    ],
    "en": [
      "Discover ski touring at Mont-Saxonnex! Enjoy a pleasant run on a wide groomed piste. Access authorized when the ski area is open. Be careful: the snow groomers start working as soon as the resort closes!"
    ],
    "it": [
      "Scoprite lo sci alpinismo a Mont-Saxonnex! Godetevi una piacevole corsa su un'ampia pista battuta. Accesso autorizzato quando il comprensorio è aperto. Attenzione: i battipista iniziano a lavorare non appena il comprensorio chiude!"
    ],
    "fr": [
      "Découvrez le ski de rando au Mont-Saxonnex ! Profitez d'un parcours plaisant sur une large piste damée à la descente. Accès autorisé pendant l'ouverture du domaine. Prudence : les dameuses s'activent dès la fermeture !"
    ],
    "es": [
      "¡Descubre el esquí de travesía en Mont-Saxonnex! Disfrute de un agradable recorrido por una amplia pista acondicionada. Acceso autorizado cuando el dominio esquiable está abierto. Atención: ¡las máquinas pisanieves empiezan a trabajar en cuanto se cierra!"
    ],
    "nl": [
      "Ontdek toerskiën in Mont-Saxonnex! Geniet van een aangename afdaling op een brede geprepareerde piste. Toegang toegestaan wanneer het skigebied open is. Let op: de sneeuwfrezen beginnen te werken zodra het gebied sluit!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Montée de Morsullaz - Ski touring"
    ],
    "fr": [
      "Montée de Morsullaz - Ski de rando"
    ]
  },
