  "rdfs:comment": {
    "de": [
      "Das Hôtel des Princes***, ein 1806 erbautes Gebäude mit herrlichem Blick auf den Genfersee, empfängt Sie in familiärer Atmosphäre und einzigartiger Umgebung. Kommen Sie und übernachten Sie vor den Schweizer Ufern. Strand, Schwimmbad und privater Hafen machen diesen Ort zu einem privilegierten Ort."
    ],
    "en": [
      "The Hôtel des Princes***, a building built in 1806 offering an unobstructed view of Lake Geneva welcomes you in a family atmosphere with a unique setting. Come and stay in front of the Swiss shores. Beach, swimming pool and private harbour make this a privileged place."
    ],
    "it": [
      "L'Hôtel des Princes***, un edificio costruito nel 1806 con una vista mozzafiato sul Lago di Ginevra, vi accoglie in un'atmosfera familiare e in un ambiente unico. Venite a soggiornare di fronte alle rive svizzere. Spiaggia, piscina e porto privato."
    ],
    "fr": [
      "L'hôtel des Princes***, une bâtisse construite en 1806 offrant une vue imprenable sur le Lac Léman vous accueille dans une ambiance familiale avec un cadre unique. Venez séjourner en face des rives suisses. Plage, piscine et port privé."
    ],
    "nl": [
      "In Amphion, in een unieke omgeving, verwelkomt Hôtel des Princes je met de voeten in het water. Verfijnde en gulle keuken. Strand, zwembad en privéhaven maken dit tot een bijzondere plek. Nautische animatie ter plaatse."
    ],
    "es": [
      "El Hôtel des Princes***, un edificio construido en 1806 con impresionantes vistas sobre el lago Lemán, le da la bienvenida en un ambiente familiar y un entorno único. Venga a alojarse frente a las orillas suizas. Playa, piscina y puerto privado."
    ]
  },
