  "rdfs:comment": {
    "de": [
      "Spielerischer Klettersteig oberhalb von Lanslevillard, Schwierigkeitsgrad AD/PD, der mit Kindern über 1,20 m bewältigt werden kann. Der Teil AD mit einem steilen Einstieg und einer umgekehrten Leiter kann über einen Pfad auf der rechten Seite umgangen werden. Dauer der Wanderung ca. 2 Stunden."
    ],
    "en": [
      "Fun via ferrata above Lanslevillard, AD/PD difficulty, suitable for children over 1.20m. The AD section, with its steep start and inverted ladder, can be avoided by following a path to the right. Time approx. 2 hrs."
    ],
    "it": [
      "Divertente via ferrata sopra Lanslevillard, difficoltà AD/PD, adatta a bambini di altezza superiore a 1,20m. Il tratto AD comprende una partenza ripida e una scala rovesciata che può essere evitata prendendo un sentiero a destra. Tempo di percorrenza circa 2 ore."
    ],
    "fr": [
      "Via ferrata ludique au dessus de Lanslevillard, difficulté AD/PD réalisable avec des enfants de plus 1,20m. La partie AD comportant un départ raide et une échelle inversée peu être évitée par un sentier par la droite. Temps de parcours environ 2h."
    ],
    "nl": [
      "Leuke klettersteig boven Lanslevillard, moeilijkheidsgraad AD/PD, geschikt voor kinderen vanaf 1,20 m. Het AD-gedeelte bevat een steile start en een omgekeerde ladder die kan worden vermeden door een pad naar rechts te nemen. Wandeltijd ongeveer 2 uur."
    ],
    "es": [
      "Divertida vía ferrata por encima de Lanslevillard, dificultad AD/PD, apta para niños de más de 1,20 m. La sección AD incluye un comienzo empinado y una escalera invertida que puede evitarse tomando un camino a la derecha. Tiempo de marcha aprox. 2 horas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Via ferrata of Pichet"
    ],
    "fr": [
      "Via ferrata du Pichet"
    ],
    "nl": [
      "Klettersteig van Pichet"
    ]
  },
