        ],
        "en": [
          "Club Notre Temps organizes a tea dance\nThursday, September 18, Salle Francis Sagot, 2 to 7 pm\nRefreshments and catering on site"
        ],
        "it": [
          "Il Club Notre Temps organizza un tè danzante\nGiovedì 18 settembre presso la Salle Francis Sagot dalle 14.00 alle 19.00\nRinfreschi e spuntini sul posto"
        ],
        "fr": [
          "Le Club Notre Temps organise un thé dansant\nRendez-vous le jeudi 18 septembre à la Salle Francis Sagot de 14h à 19h\nBuvette et restauration sur place"
        ],
        "es": [
          "El Club Notre Temps organiza un baile del té\nJueves 18 de septiembre en la Salle Francis Sagot de 14h a 19h\nRefrescos y tentempiés in situ"
