  "rdfs:comment": {
    "de": [
      "Diese Klippe liegt unterhalb des gleichnamigen Forts und bietet Ihnen eine große Vielfalt an Routen in der einzigartigen Atmosphäre der Barriere von Esseillon."
    ],
    "en": [
      "Located below the Fort of the same name, this cliff will offer a variety of ways, in the unique atmosphere of the barrier Esseillon"
    ],
    "it": [
      "Situato sotto il Forte omonimo, questa rupe offrirà una varietà di modi, nell'atmosfera unica della barriera dell'Esseillon"
    ],
    "fr": [
      "Situé en dessous du Fort du même nom, cette falaise vous offrira une grande variété de voies, dans l'ambiance unique de la barrière de l'Esseillon."
    ],
    "es": [
      "Situado bajo el Fuerte del mismo nombre, este acantilado ofrece una gran variedad de recorridos en el marco incomparable de la barrera del Esseillon."
    ],
    "nl": [
      "Gelegen onder het gelijknamige fort, biedt deze klif u een breed scala aan routes, in de unieke sfeer van de barrière van Esseillon."
    ]
  },
