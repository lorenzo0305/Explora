  "rdfs:comment": {
    "de": [
      "Ich bin vom Kulturerbe der Auvergne begeistert und interessiere mich sehr für das Mittelalter. Ich nehme Sie mit auf eine Entdeckungsreise zu untypischen Dörfern und Orten, um mit Ihnen die Geschichte der Orte zu teilen und einige Anekdoten zu enthüllen, die die Besichtigungen würzen!"
    ],
    "en": [
      "Fascinated by Auvergne's heritage and very interested in the Middle Ages, I'll take you on a tour of unusual villages and sites to share their history with you and reveal a few anecdotes to spice up your visit!"
    ],
    "it": [
      "Affascinata dal patrimonio dell'Alvernia e molto interessata al Medioevo, vi condurrò in un tour di villaggi e siti insoliti per condividere con voi la loro storia e raccontarvi qualche aneddoto per rendere più vivace la vostra visita!"
    ],
    "fr": [
      "Animée par le patrimoine auvergnat et très intéressée par le Moyen Age, je vous emmène à la découverte de villages et sites atypiques afin de partager avec vous l'histoire des lieux et révéler quelques anecdotes qui pimentent les visites !"
    ],
    "nl": [
      "Gefascineerd door het erfgoed van de Auvergne en zeer geïnteresseerd in de Middeleeuwen, neem ik je mee op een tocht langs bijzondere dorpen en plaatsen om hun geschiedenis met je te delen en je een paar anekdotes te vertellen om je bezoek op te fleuren!"
    ],
    "es": [
      "Fascinada por el patrimonio de Auvernia y muy interesada por la Edad Media, le llevaré a recorrer pueblos y lugares insólitos para compartir con usted su historia y contarle algunas anécdotas que amenizarán su visita"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pascale Chappot - Guide conférencière"
    ]
  },
