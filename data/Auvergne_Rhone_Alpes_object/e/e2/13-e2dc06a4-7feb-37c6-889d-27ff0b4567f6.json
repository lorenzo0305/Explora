  "rdfs:comment": {
    "de": [
      "Die Korbflechterin Lauren Caritte fertigt Dekorations- und Gebrauchsgegenstände aus Weiden, Binsen und Seggen. Sie repariert Ihre verwitterten Körbe, polstert Ihre Stühle und Sessel neu...\r\nWorkshops für alle Altersgruppen, das ganze Jahr über."
    ],
    "en": [
      "Lauren Caritte, basket weaver, makes decorative objects and utilities from wicker, rush and sedge. She repairs your time-worn baskets, reupholster your chairs and armchairs...\r\nWorkshops open to all, all year round."
    ],
    "it": [
      "Lauren Caritte, intrecciatrice di cesti, realizza oggetti decorativi e di utilità in vimini, giunco e carice; ripara i vostri cesti usurati dal tempo, riveste le vostre sedie e poltrone...\r\nLaboratori per tutte le età."
    ],
    "fr": [
      "Lauren Caritte, vannière, réalise objets de décoration, utilitaires en osier, jonc et carex. elle répare vos paniers usés par le temps, rempaille vos chaises et fauteuils... \r\nAteliers tout public, tout au long de l'année."
    ],
    "es": [
      "Lauren Caritte, tejedora de cestas, fabrica objetos decorativos y utilitarios de mimbre, junco y juncia. Repara sus cestas desgastadas por el tiempo, retapiza sus sillas y sillones...\r\nTalleres para todas las edades."
    ],
    "nl": [
      "Lauren Caritte, mandenvlechtster, maakt decoratieve voorwerpen en gebruiksvoorwerpen van riet, biezen en riet. Ze repareert uw versleten manden, herstoffeert uw stoelen en fauteuils...\r\nWorkshops voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Saule qui peut - Atelier de vannerie"
    ]
  },
