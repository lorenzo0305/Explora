  "rdfs:comment": {
    "de": [
      "Magali ist Energetikerin, REIKI USUI-Meisterin und Führerin in der Waldtherapie. Sie begleitet Sie dabei, sich wieder mit der Natur und der universellen Lebensenergie zu verbinden. Sie macht Reiki Usui-Behandlungen, ressourcenstärkende Spaziergänge und Entspannungspausen."
    ],
    "en": [
      "Energetician, REIKI USUI master, Sylvotherapy guide.\r\nReconnection to nature and the Universal Energy of Life.\r\nReiki Usui treatments, revitalising walks, relaxing breaks."
    ],
    "it": [
      "Magali è terapeuta energetica, master REIKI USUI e guida di silvoterapia. Può aiutarvi a riconnettervi con la natura e l'energia universale della vita. Offre trattamenti Reiki Usui, passeggiate rigeneranti e pause rilassanti."
    ],
    "fr": [
      "Magali est énergéticienne, maître REIKI USUI et guide en sylvothérapie. Elle vous accompagne dans votre reconnexion à la nature et à l'énergie universelle de vie. Elle fait des traitements de Reiki Usui, des marches ressourçantes, des pauses relaxantes."
    ],
    "nl": [
      "Magali is energetisch therapeut, REIKI USUI master en sylvotherapie gids. Ze kan je helpen weer in contact te komen met de natuur en de universele levensenergie. Ze biedt Reiki Usui behandelingen, verjongende wandelingen en ontspannende pauzes."
    ],
    "es": [
      "Magali es terapeuta energética, maestra REIKI USUI y guía de silvoterapia. Puede ayudarte a reconectar con la naturaleza y la energía universal de la vida. Ofrece tratamientos de Reiki Usui, paseos rejuvenecedores y descansos relajantes."
    ]
  },
