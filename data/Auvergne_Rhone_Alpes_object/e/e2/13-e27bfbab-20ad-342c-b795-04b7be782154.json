  "rdfs:comment": {
    "de": [
      "Der im Herzen des Weinguts Château des Pertonnières gelegene Veranstaltungsraum ist ideal gelegen und eignet sich sowohl für Firmenveranstaltungen als auch für Familien- und Festveranstaltungen."
    ],
    "en": [
      "Situated in the heart of the Château des Pertonnières wine estate, the reception hall is ideally located and will suit corporate events as well as family and festive events."
    ],
    "it": [
      "Situata nel cuore della tenuta vinicola Château des Pertonnières, la sala ricevimenti è situata in una posizione ideale e si adatta a eventi aziendali, familiari e festivi."
    ],
    "fr": [
      "Installée au cœur du domaine viticole du Château des Pertonnières, la salle de réception est idéalement située et conviendra autant aux événements d'entreprises qu'aux événements familiaux et festifs."
    ],
    "es": [
      "Situado en el corazón de la finca vinícola del Château des Pertonnières, el salón de recepciones goza de una ubicación ideal y se adapta tanto a los eventos corporativos como a los familiares y festivos."
    ],
    "nl": [
      "De receptiezaal, gelegen in het hart van het wijndomein Château des Pertonnières, is ideaal gelegen en geschikt voor zowel bedrijfsevenementen als familie- en feestelijke evenementen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Reception hall \"Salle des Pertonnières\""
    ],
    "fr": [
      "Salle des Pertonnières"
    ]
  },
