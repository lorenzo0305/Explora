  "rdfs:comment": {
    "de": [
      "Marie und Phil gründeten die Distillerie du Bugey im Herzen von Saint-Martin-de-Bavel im Departement Ain, Maries Heimatdorf, in einem Gebäude mit starkem architektonischem Charakter\r\narchitektonischen Stil."
    ],
    "en": [
      "Marie and Phil created the Distillerie du Bugey in the heart of Saint-Martin-de-Bavel in the Ain, Marie's home village, in a building with a strong architectural character."
    ],
    "it": [
      "Marie e Phil hanno creato la Distillerie du Bugey nel cuore di Saint-Martin-de-Bavel nell'Ain, il villaggio natale di Marie, in un edificio dal forte carattere architettonico\r\ncarattere architettonico."
    ],
    "fr": [
      "Marie et Phil ont créé la Distillerie du Bugey au cœur de Saint-Martin-de-Bavel dans l’Ain, village natal de Marie, dans un bâtiment à fort cachet\r\narchitectural."
    ],
    "es": [
      "Marie y Phil crearon la Distillerie du Bugey en el corazón de Saint-Martin-de-Bavel, en el Ain, el pueblo natal de Marie, en un edificio con un fuerte carácter arquitectónico\r\ncarácter arquitectónico."
    ],
    "nl": [
      "Marie en Phil vestigden de Distillerie du Bugey in het hart van Saint-Martin-de-Bavel in de Ain, het geboortedorp van Marie, in een gebouw met een sterk architecturaal karakter\r\narchitectonisch karakter."
    ]
  },
