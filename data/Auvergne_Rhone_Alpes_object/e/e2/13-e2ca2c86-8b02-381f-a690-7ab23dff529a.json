  "rdfs:comment": {
    "de": [
      "Das Croix des Ages (1969 als historisches Monument klassifiziert) ist ein Kalvarienberg aus Kohlegranit, der auf einem alten Kammweg steht, der angeblich von Soldaten bei Manövern benutzt wurde."
    ],
    "en": [
      "La Croix des Ages (listed as a Historic Monument in 1969) is a calvary made of coal granite, located on an ancient ridge path used by soldiers on maneuvers."
    ],
    "it": [
      "La Croix des Ages (classificata come monumento storico nel 1969) è un calvario in granito di carbone situato su un vecchio sentiero di cresta che sarebbe stato utilizzato dai soldati durante le manovre."
    ],
    "fr": [
      "La Croix des Ages (classée Monument Historique en 1969) est un calvaire en granit houiller situé sur un ancien chemin de crête qui aurait été emprunté par les militaires en manœuvre."
    ],
    "es": [
      "La Croix des Ages (declarada Monumento Histórico en 1969) es un calvario de granito de hulla situado en un antiguo camino de cresta que habrían utilizado los soldados en maniobras."
    ],
    "nl": [
      "Het Croix des Ages (geklasseerd als Historisch Monument in 1969) is een calvaire van steenkoolgraniet die zich op een oud bergkampad bevindt dat gebruikt zou zijn door soldaten op manoeuvres."
    ]
  },
