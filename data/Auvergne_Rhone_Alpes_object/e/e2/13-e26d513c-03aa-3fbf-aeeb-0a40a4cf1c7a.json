  "rdfs:comment": {
    "de": [
      "Diese 1924 eingeweihten bemalten Werbewände wurden von Bellini gestaltet. Sie befinden sich in der Rue Vandel und der Rue Sonthonax und stellen verschiedene Werbungen alter Marken dar."
    ],
    "en": [
      "These painted advertising walls, inaugurated in 1924, were designed by Bellini. Located on rue Vandel and rue Sonthonax, they feature a variety of vintage brand advertisements."
    ],
    "it": [
      "Questi muri pubblicitari dipinti, inaugurati nel 1924, sono stati progettati da Bellini. Situati in rue Vandel e rue Sonthonax, raffigurano una serie di pubblicità di vecchi marchi."
    ],
    "fr": [
      "Ces murs peints publicitaires, inaugurés en 1924, ont été réalisés par Bellini. Situés rue Vandel et rue Sonthonax, ils représentent différentes publicités de marques anciennes."
    ],
    "es": [
      "Estos muros publicitarios pintados, inaugurados en 1924, fueron diseñados por Bellini. Situados en las calles Vandel y Sonthonax, representan diversos anuncios de marcas antiguas."
    ],
    "nl": [
      "Deze beschilderde reclamemuren, ingehuldigd in 1924, zijn ontworpen door Bellini. Ze bevinden zich in de rue Vandel en de rue Sonthonax en laten een verscheidenheid aan oude merkreclames zien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Publicités anciennes"
    ]
  },
