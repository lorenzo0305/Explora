  "rdfs:comment": {
    "de": [
      "Schönes Restaurant mit einer angenehmen Terrasse mit Blick auf den Stadtgarten für schöne Tage und einem gemütlichen Saal im Obergeschoss. Hausgemachte Küche mit frischen Produkten und Gemüse vom Markt. Themenabende."
    ],
    "en": [
      "Lovely restaurant with a pleasant terrace overlooking the Jardin de Ville on sunny days and a cosy dining room upstairs. Home cooking with fresh produce and market vegetables. Theme evenings."
    ],
    "it": [
      "Bel ristorante con una piacevole terrazza che si affaccia sul Jardin de Ville nelle giornate di sole e una sala accogliente al piano superiore. Cucina casalinga con prodotti freschi, verdure del mercato. Serate a tema."
    ],
    "fr": [
      "Joli restaurant disposant d'une agréable terrasse donnant sur le Jardin de Ville pour les beaux jours et d'une salle cosy à l'étage. Cuisine Maison avec des produits frais, légumes du marché. Soirées à Thèmes."
    ],
    "es": [
      "Precioso restaurante con una agradable terraza con vistas al Jardin de Ville cuando hace buen tiempo y un acogedor comedor en el piso de arriba. Cocina casera con productos frescos y verduras de mercado. Veladas temáticas."
    ],
    "nl": [
      "Leuk restaurant met een aangenaam terras met uitzicht op de Jardin de Ville op zonnige dagen en een gezellige zaal boven. Thuis koken met verse producten, groenten van de markt. Thema-avonden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Petit Jardin"
    ],
    "fr": [
      "Le Petit Jardin"
    ]
  },
