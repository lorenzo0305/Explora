  "rdfs:comment": {
    "de": [
      "Die Ludothek ist eine kulturelle Einrichtung, die vom Verein Ludosphère verwaltet wird.\r\n\r\nDie Ludothek stellt ihren Mitgliedern eine große Anzahl an Spielen und Spielsachen für alle Altersgruppen zur Verfügung: Vor Ort und/oder zum Ausleihen."
    ],
    "en": [
      "The toy library is a cultural facility managed by the Ludosphere association.\r\n\r\nThe toy library provides its members with a large number of games and toys for all ages: On site and/or for loan."
    ],
    "it": [
      "La ludoteca è una struttura culturale gestita dall'associazione Ludosfera.\r\n\r\nLa ludoteca mette a disposizione dei suoi membri un gran numero di giochi e giocattoli per tutte le età: in loco e/o in prestito."
    ],
    "fr": [
      "La ludothèque  est un équipement culturel géré par l’association Ludosphère.\r\n\r\nLa ludothèque met à disposition de ses adhérents un grand nombre de jeux et jouets pour tous les âges : Sur place et/ou pour le prêt."
    ],
    "es": [
      "La ludoteca es un equipamiento cultural gestionado por la asociación Ludosfera.\r\n\r\nLa ludoteca pone a disposición de sus socios un gran número de juegos y juguetes para todas las edades: in situ y/o en préstamo."
    ],
    "nl": [
      "De speelgoedbibliotheek is een culturele voorziening beheerd door de Ludosphere vereniging.\r\n\r\nDe speelgoedbibliotheek stelt haar leden een groot aantal spelletjes en speelgoed voor alle leeftijden ter beschikking: ter plaatse en/of om te lenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ludothèque La Ludosphère"
    ]
  },
