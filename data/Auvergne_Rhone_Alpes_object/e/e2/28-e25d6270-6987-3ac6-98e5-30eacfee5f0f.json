  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76789635-11a8-3def-b52e-49c6f0317f1f",
      "dc:description": {
        "de": [
          "Ikonische Kette von Schnellrestaurants. Wir bieten Ihnen eine breite Produktpalette, die hauptsächlich aus Burger-Menüs, McWrap™ (mit Rindfleisch, Huhn oder Fisch) oder Chicken McNuggets™ mit Beilagen und Getränken besteht. Außerdem gibt es frisch zubereitete Salatmenüs, Frühstücksangebote und zahlreiche eisgekühlte Desserts oder Gebäck."
        ],
        "en": [
          "Emblematic fast food chain. We offer a wide range of products, mainly comprising menus of Burgers, McWrap™ (with beef, chicken or fish) or Chicken McNuggets™ with side dishes and drinks. Freshly prepared salad menus, breakfast formulas and many frozen desserts or pastries."
        ],
        "it": [
          "Catena di fast food iconica. Offriamo un'ampia gamma di prodotti, principalmente costituita da hamburger, McWrap? (manzo, pollo o pesce) o Chicken McNuggets? con contorni e bevande. Menù di insalate preparate al momento, formule per la colazione e un'ampia gamma di dessert e dolci surgelati."
        ],
        "fr": [
          "Chaîne emblématique de restauration rapide. Nous vous proposons une large gamme de produits comportant principalement des menus de Burgers, McWrap™ (au bœuf, poulet ou poisson) ou Chicken McNuggets™ avec accompagnements et boissons. Des menus salades fraîchement préparées, des formules pour le petit-déjeuner et de nombreux desserts glacés ou pâtisseries."
        ],
        "es": [
          "Una cadena de comida rápida icónica. Ofrecemos una amplia gama de productos, que consisten principalmente en menús de hamburguesas, McWrap? (de ternera, pollo o pescado) o McNuggets? de pollo con guarniciones y bebidas. Menús de ensalada recién preparados, fórmulas de desayuno y una amplia gama de postres y pasteles congelados."
        ],
        "nl": [
          "Iconische fast food keten. Wij bieden een breed assortiment met voornamelijk menu's van Burgers, McWrap™ (met rundvlees, kip of vis) of Chicken McNuggets™ met bijgerechten en drankjes. Vers bereide salademenu's, ontbijtformules en vele ijsdesserts of gebak."
        ]
      },
