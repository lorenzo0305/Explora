  "rdfs:comment": {
    "de": [
      "Wir sind handwerkliche Röster und Hersteller von Mischungen aus Trockenfrüchten, Nüssen und edlen Nüssen: rösten, mit Honig karamellisieren, mit Schokolade überziehen, dragieren."
    ],
    "en": [
      "We are an artisan roaster and manufacturer of mixtures of dried fruits, nuts and noble nuts: roasting, honey caramelization, chocolate coating, sugaring."
    ],
    "it": [
      "Siamo un torrefattore artigianale e produttore di miscele di frutta secca, noci e nocciole: tostatura, caramellizzazione con miele, copertura con cioccolato, zuccheraggio."
    ],
    "fr": [
      "Nous sommes artisan torréfacteur et fabricant de mélanges de fruits secs, fruits à coque et noix nobles : torréfaction, caramélisation au miel, enrobage au chocolat, dragéification."
    ],
    "nl": [
      "Wij zijn een ambachtelijke brander en fabrikant van mixen van gedroogd fruit, noten en edele noten: roosteren, karameliseren met honing, coaten met chocolade, suikeren."
    ],
    "es": [
      "Somos tostadores artesanos y fabricantes de mezclas de frutos secos, nueces y frutos nobles: tostado, caramelización con miel, cobertura de chocolate, azucarado."
    ]
  },
  "rdfs:label": {
