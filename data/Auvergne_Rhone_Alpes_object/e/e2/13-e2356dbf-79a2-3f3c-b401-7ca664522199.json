  "rdfs:comment": {
    "de": [
      "La construction de l’église primitive date de la fin du XIIème siècle.\r\nLa particularité de cette église est qu'elle renferme une magnifique Vierge en majesté de la fin du XIIè ou début du XIIIè s."
    ],
    "en": [
      "The original church was built in the late 12th century.\nA special feature of this church is its magnificent Madonna in Majesty, dating from the late 12th or early 13th century."
    ],
    "it": [
      "La chiesa originale fu costruita alla fine del XII secolo.\r\nLa particolarità di questa chiesa è che contiene una magnifica Vergine in Maestà della fine del XII o dell'inizio del XIII secolo."
    ],
    "fr": [
      "La construction de l’église primitive date de la fin du XIIème siècle.\r\nLa particularité de cette église est qu'elle renferme une magnifique Vierge en majesté de la fin du XIIè ou début du XIIIè s."
    ],
    "es": [
      "La iglesia original se construyó a finales del siglo XII.\r\nLa particularidad de esta iglesia es que contiene una magnífica Virgen en Majestad de finales del siglo XII o principios del XIII."
    ],
    "nl": [
      "De oorspronkelijke kerk werd gebouwd aan het eind van de 12e eeuw.\r\nHet bijzondere van deze kerk is dat zij een prachtige Maagd in Majesteit bevat uit het einde van de 12e of het begin van de 13e eeuw."
    ]
  },
  "rdfs:label": {
