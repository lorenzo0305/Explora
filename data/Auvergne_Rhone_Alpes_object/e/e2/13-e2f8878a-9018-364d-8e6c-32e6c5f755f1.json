  "rdfs:comment": {
    "de": [
      "Die Auberge de Boisset bietet Ihnen eine raffinierte Küche, die mit frischen und saisonalen Produkten zubereitet wird. An schönen Tagen können Sie es genießen, auf der Terrasse in unserem Garten zu essen, der ruhig in einer grünen Oase liegt."
    ],
    "en": [
      "The Auberge de Boisset offers a refined cuisine, prepared with fresh seasonal products.  On sunny days, you can appreciate eating frogs legs on the terrace in the garden, in a calm bucolic setting."
    ],
    "it": [
      "L'Auberge de Boisset propone una cucina raffinata preparata con prodotti freschi di stagione. Quando il tempo è bello, potete gustare i vostri pasti sulla terrazza del nostro giardino, in un ambiente tranquillo e circondato dal verde."
    ],
    "fr": [
      "L'Auberge de Boisset vous propose une cuisine raffinée, préparée avec des produits frais et de saison. Aux beaux jours, vous pourrez apprécier de manger sur la terrasse dans notre jardin, au calme dans un écrin de verdure."
    ],
    "es": [
      "El Auberge de Boisset sirve una cocina refinada elaborada con productos frescos de temporada. Cuando hace buen tiempo, puede disfrutar de su comida en la terraza de nuestro jardín, en un entorno tranquilo rodeado de vegetación."
    ],
    "nl": [
      "De Auberge de Boisset serveert verfijnde gerechten bereid met verse seizoensproducten. Bij mooi weer kun je van je maaltijd genieten op het terras in onze tuin, in een vredige omgeving omringd door groen."
    ]
  },
