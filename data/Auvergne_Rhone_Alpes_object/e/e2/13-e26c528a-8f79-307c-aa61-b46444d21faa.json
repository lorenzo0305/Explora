  "rdfs:comment": {
    "de": [
      "Auf Initiative eines Kollektivs von Produzenten und Handwerkern aus dem Trièves bietet Le Raccourci lokale Lebensmittelprodukte AB/Nature et Progrès im Direktverkauf an: Gemüse, Brot, Käse, Eier, Obst, Honig, Kräutertee, Pilze, Wein, Bier, etc."
    ],
    "en": [
      "Le Raccourci is the brainchild of a group of producers and artisans from the Trièves region. It offers local AB/Nature et Progrès food products for direct sale: vegetables, bread, cheese, eggs, fruit, honey, herbal teas, mushrooms, wine, beer, etc..."
    ],
    "it": [
      "Creato da un gruppo di produttori e artigiani del Trièves, Le Raccourci offre prodotti alimentari locali AB/Nature et Progrès per la vendita diretta: verdure, pane, formaggio, uova, frutta, miele, tisane, funghi, vino, birra, ecc..."
    ],
    "fr": [
      "A l'initiative d'un collectif de producteur.ices et artisans du Trièves, Le Raccourci propose des produits alimentaires locaux  AB/Nature et Progrès en vente directe : légumes, pain, fromages, œufs, fruits, miel, tisanes, champignons, vin, bières, etc..."
    ],
    "nl": [
      "Le Raccourci, opgericht door een groep producenten en ambachtslieden uit de Trièves, biedt lokale AB/Nature et Progrès voedingsproducten voor directe verkoop: groenten, brood, kaas, eieren, fruit, honing, kruidenthee, paddenstoelen, wijn, bier, enz..."
    ],
    "es": [
      "Creado por un grupo de productores y artesanos de las Trièves, Le Raccourci ofrece productos alimentarios locales AB/Nature et Progrès en venta directa: verduras, pan, queso, huevos, fruta, miel, infusiones, setas, vino, cerveza, etc..."
    ]
  },
  "rdfs:label": {
