  "rdfs:comment": {
    "de": [
      "Skihotel in Méribel mit neuem Wellnesscenter, Innenpool, Whirlpool, Sauna, Hammam und Fitnessraum. Blick auf das Tal. Animierte 400m2-Terrasse, Bar & Lounge, Après-Ski, All Inclusive."
    ],
    "en": [
      "View over the valley, ski-in ski-out, in the center of Méribel Mottaret. All-Inclusive food and drinks, après ski entertainment, lively bar, restaurant and terrace where dining and après ski ambiance combine, brand new wellness center, indoor pool, hot tub, sauna, Turkish bath and gym."
    ],
    "it": [
      "Hotel ski in/ski out a Meribel con nuovo centro benessere, piscina coperta, idromassaggio, sauna, hammam e palestra. Vista sulla valle. Terrazza animata di 400 m2, bar & lounge, après ski, formula All Inclusive."
    ],
    "fr": [
      "Hôtel skis aux pieds à Méribel avec nouveau centre de bien-être, piscine intérieur, bain à remous, sauna, hammam et salle de sport. Vue sur la vallée. Terrasse animée de 400m2, bar & salon, après ski, formule All Inclusive."
    ],
    "nl": [
      "Ski in/ski out hotel in Meribel met nieuw wellnesscentrum, binnenzwembad, whirlpool, sauna, hammam en fitnessruimte. Uitzicht op de vallei. Geanimeerd terras van 400m2, bar & lounge, après ski, All Inclusive formule."
    ],
    "es": [
      "Hotel de entrada y salida de esquí en Meribel con nuevo centro de bienestar, piscina cubierta, jacuzzi, sauna, hammam y gimnasio. Vista sobre el valle. Terraza animada de 400m2, bar y salón, après ski, fórmula Todo Incluido."
    ]
  },
