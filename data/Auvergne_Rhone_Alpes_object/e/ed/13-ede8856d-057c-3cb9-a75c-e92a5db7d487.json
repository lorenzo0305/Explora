  "rdfs:comment": {
    "de": [
      "Die Kirche ist dem Heiligen Laurentius geweiht und befindet sich in Aiton le haut. Sie wurde im Jahr 1700 erbaut. Sie beherbergt die Gebeine eines berühmten Priors von Aiton, des Kardinals Jean de Segovia."
    ],
    "en": [
      "The church is dedicated to Saint Laurent and is located in Aiton le haut. It was built in 1700. It contains the bones of a famous prior of Aiton, Cardinal Jean de Ségovie."
    ],
    "it": [
      "La chiesa è dedicata a Saint Laurent e si trova ad Aiton le haut. Fu costruita nel 1700. Contiene le ossa di un famoso priore di Aiton, il cardinale Jean de Ségovie."
    ],
    "fr": [
      "L'église est dédiée à Saint Laurent et située à Aiton le haut. Elle a été construite en 1700. Elle conserve les ossements d’un célèbre prieur d’Aiton,  le cardinal Jean de Ségovie."
    ],
    "es": [
      "La iglesia está dedicada a San Lorenzo y se encuentra en Aiton le haut. Fue construida en 1700. Contiene los huesos de un famoso prior de Aiton, el cardenal Jean de Ségovie."
    ],
    "nl": [
      "De kerk is gewijd aan Saint Laurent en ligt in Aiton le haut. Het werd gebouwd in 1700. Het bevat het gebeente van een beroemde prior van Aiton, kardinaal Jean de Ségovie."
    ]
  },
