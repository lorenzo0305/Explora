  "rdfs:comment": {
    "de": [
      "Nutzen Sie mechanische Fahrräder in Selbstbedienung und fahren Sie ganz entspannt durch die Stadt: Mit einer Smartphone-App können Sie das Fahrrad reservieren/entsperren. Der Zugang ist rund um die Uhr möglich. Zehn Stationen sind rund um das Stadtzentrum verteilt."
    ],
    "en": [
      "Take advantage of self-service mechanical bicycles and ride around the city with complete peace of mind: a smartphone application lets you reserve/unlock the bike. 24-hour access. Ten stations are located around the city center."
    ],
    "it": [
      "Approfittate delle biciclette meccaniche self-service e girate per la città in tutta tranquillità: un'applicazione per smartphone vi permette di prenotare/sbloccare la bicicletta. Accesso 24 ore su 24. Ci sono dieci stazioni in tutto il centro città."
    ],
    "fr": [
      "Profitez de vélos mécaniques en libre-service et parcourez en toute sérénité la ville : une application smartphone permet de réserver/débloquer le vélo. Accès 24h/24. Dix stations sont réparties autour du centre-ville."
    ],
    "nl": [
      "Profiteer van zelfbedienings mechanische fietsen en rijd met een gerust hart door de stad: met een smartphone-applicatie kun je de fiets reserveren/deblokkeren. 24 uur per dag toegang. Er zijn tien stations in het stadscentrum."
    ],
    "es": [
      "Aproveche las bicicletas mecánicas de autoservicio y circule por la ciudad con total tranquilidad: una aplicación para smartphone le permite reservar/desbloquear la bicicleta. Acceso las 24 horas del día. Hay diez estaciones repartidas por el centro de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "APIlib' le vélo en libre service"
    ]
  },
