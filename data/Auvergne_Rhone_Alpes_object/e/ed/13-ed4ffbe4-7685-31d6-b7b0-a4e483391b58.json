  "rdfs:comment": {
    "de": [
      "Betrieb, der seit 20 Jahren biologisch bewirtschaftet wird.\r\nProduktion von Saisonobst: Erdbeeren, Äpfel, Walnüsse, Himbeeren und Apfelsaft...\r\nDirektverkauf ab Hof und auf Märkten nur in Grenoble."
    ],
    "en": [
      "Organic farming for 20 years.\r\nProduction of seasonal fruit: strawberries, apples, walnuts, raspberries and apple juice...\r\nDirect sales at the farm and at markets in Grenoble only."
    ],
    "it": [
      "Agricoltura biologica da 20 anni.\r\nProduzione di frutta di stagione: fragole, mele, noci, lamponi e succo di mela...\r\nVendita diretta in azienda e solo nei mercati di Grenoble."
    ],
    "fr": [
      "Exploitation en agriculture bio depuis 20 ans. \r\nProduction de fruits de saison : fraises, pommes, noix, framboises et jus de pomme...\r\nVente directe à la ferme et sur les marchés uniquement à Grenoble."
    ],
    "nl": [
      "Al 20 jaar biologische landbouw.\r\nProductie van seizoensfruit: aardbeien, appels, walnoten, frambozen en appelsap...\r\nDirecte verkoop op de boerderij en alleen op markten in Grenoble."
    ],
    "es": [
      "Agricultura ecológica desde hace 20 años.\r\nProducción de fruta de temporada: fresas, manzanas, nueces, frambuesas y zumo de manzana...\r\nVenta directa en la explotación y sólo en mercados de Grenoble."
    ]
  },
  "rdfs:label": {
