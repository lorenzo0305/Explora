  "rdfs:comment": {
    "de": [
      "200 Lehrer stehen Ihnen zur Verfügung, damit Sie die Freuden des Skifahrens entdecken können: Alpinski, Snowboard, Langlauf, Telemark, Skifahren abseits der Pisten, Slalomkurse, Freestyle-Kurse."
    ],
    "en": [
      "200 instructors at your service to show you the fun of skiing, snowboarding, cross-country skiing, telemark skiing, off-piste skiing, slalom and freestyle."
    ],
    "it": [
      "200 maestri al vostro servizio per farvi scoprire le gioie dello sci nelle Alpi, dello snowboard, dello sci di fondo, del telemark, del fuoripista, dei corsi di slalom e di freestyle."
    ],
    "fr": [
      "200 moniteurs à votre service pour vous faire découvrir les joies de la glisse en ski alpin, en snowboard, en ski de fond, le télémark, le ski hors-piste, les stages slalom, les stages freestyle."
    ],
    "es": [
      "200 monitores a su servicio para ayudarle a descubrir los placeres del esquí en los Alpes, el snowboard, el esquí de fondo, el esquí de telemark, el esquí fuera de pista, los cursos de eslalon y los cursos de estilo libre."
    ],
    "nl": [
      "200 instructeurs tot uw dienst om u de geneugten van het skiën in de Alpen te laten ontdekken, snowboarden, langlaufen, telemark skiën, off-piste skiën, slalom cursussen en freestyle cursussen."
    ]
  },
