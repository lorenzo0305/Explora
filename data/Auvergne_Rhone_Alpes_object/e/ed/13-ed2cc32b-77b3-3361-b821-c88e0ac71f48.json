  "rdfs:comment": {
    "de": [
      "Bei Basilico bietet Antonio Gonzalez einen Nahversorger vom Typ Lebensmittelgeschäft mit Grundnahrungsmitteln, losen, biologischen und lokalen Produkten direkt vom Bauernhof zum Verbraucher."
    ],
    "en": [
      "At Basilico, Antonio Gonzalez offers a local grocery store with basic food products, bulk, organic and local produce direct from farm to consumer."
    ],
    "it": [
      "A Basilico, Antonio Gonzalez gestisce una drogheria locale che vende generi alimentari di base, prodotti sfusi, biologici e locali direttamente dalla fattoria al consumatore."
    ],
    "fr": [
      "Chez Basilico, Antonio Gonzalez propose un commerce de proximité type épicerie avec des produits alimentaires de base, vrac, bio et produits locaux directement de la ferme au consommateur."
    ],
    "nl": [
      "In Basilico runt Antonio Gonzalez een plaatselijke kruidenierswinkel die basisvoedingsmiddelen, bulk, biologische en lokale producten rechtstreeks van de boerderij aan de consument verkoopt."
    ],
    "es": [
      "En Basilico, Antonio González regenta una tienda de comestibles que vende productos básicos, a granel, ecológicos y locales directamente de la granja al consumidor."
    ]
  },
