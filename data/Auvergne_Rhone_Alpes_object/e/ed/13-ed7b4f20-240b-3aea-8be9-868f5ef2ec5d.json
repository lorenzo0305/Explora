  "rdfs:comment": {
    "de": [
      "Rusty, das Eichhörnchen, hat seinen Samenvorrat verloren und bittet um Hilfe, um den Schuldigen zu finden! Spiel auf einem Waldpfad im Schatten. Heft zur Selbstbedienung am Eingang des Pfades, um den Parcours zu absolvieren."
    ],
    "en": [
      "Rusty the squirrel has lost his seed supply and is asking for help to find the culprit! Play on a shaded forest trail. Self-service booklet available at the trail entrance."
    ],
    "it": [
      "Lo scoiattolo Rusty ha perso la sua scorta di semi e chiede aiuto per trovare il colpevole! Gioco su un sentiero forestale all'ombra. Libretto self-service all'ingresso del sentiero per seguire il percorso."
    ],
    "fr": [
      "Rusty l’écureuil a perdu sa réserve de graine et demande de l’aide pour retrouver le coupable ! Jeu sur un sentier en forêt, à l'ombre. Livret en libre service à l'entrée du sentier pour faire le parcours."
    ],
    "nl": [
      "Rusty de eekhoorn is zijn zaadvoorraad kwijt en vraagt om hulp om de dader te vinden! Speel op een schaduwrijk bospad. Zelfbedieningsboekje beschikbaar bij de ingang van het pad om je wegwijs te maken."
    ],
    "es": [
      "La ardilla Rusty ha perdido su suministro de semillas y pide ayuda para encontrar al culpable Juego en un camino forestal a la sombra. Folleto de autoservicio a la entrada del sendero para seguir la ruta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse au Trésor - Le Mystère de la Noisette"
    ]
  },
