  "rdfs:comment": {
    "de": [
      "Der Künstler, der sich in einem kleinen Weiler in den Bergen, 15 Minuten von Albertville entfernt, niedergelassen hat, lädt Sie ein, die Arbeit des Töpfers durch die Formung der Erde und die Chemie der Glasuren zu entdecken."
    ],
    "en": [
      "Located in a small mountain hamlet, 15 minutes from Albertville, the artist invites you to discover the potter’s work through the shaping of the earth and the chemistry of enamels."
    ],
    "it": [
      "Situato in un piccolo borgo di montagna, a 15 minuti da Albertville, l'artista invita a scoprire il lavoro del vasaio attraverso la modellazione dell'argilla e la chimica degli smalti."
    ],
    "fr": [
      "Installé dans un petit hameau de montagne, à 15 min d'Albertville, l'artiste vous invite à découvrir le travail du potier à travers le façonnage de la terre et la chimie des émaux."
    ],
    "es": [
      "Situado en una pequeña aldea de montaña, a 15 minutos de Albertville, el artista le invita a descubrir el trabajo del alfarero a través del modelado de la arcilla y la química de los esmaltes."
    ],
    "nl": [
      "Gelegen in een klein berggehucht, op 15 minuten van Albertville, nodigt de kunstenaar u uit om het werk van de pottenbakker te ontdekken door het vormen van klei en de chemie van glazuren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Stoneware pottery - Poterie en grès"
    ],
    "fr": [
      "Poterie Artisanale en Grès"
    ]
  },
