  "rdfs:comment": {
    "de": [
      "Das Kino empfängt Sie im Winter wie im Sommer, um die Filme der Saison zu entdecken oder wiederzuentdecken!"
    ],
    "en": [
      "At Montchavin, there is a cinema seating 240 people.\r\n2 sessions (6.00pm and 9.00pm)."
    ],
    "it": [
      "Il cinema vi accoglie in inverno e in estate per scoprire o riscoprire i film della stagione!"
    ],
    "fr": [
      "Le cinéma vous accueille en hiver comme en été pour découvrir ou redécouvrir les films de la saison !"
    ],
    "es": [
      "El cine le acoge en invierno y en verano para descubrir o redescubrir las películas de la temporada"
    ],
    "nl": [
      "De biscoop verwelkomt U 's winters en 's zomers om de filmen van het seizoen te ontdekken of opnieuw te ontdekken."
    ]
  },
