  "rdfs:comment": {
    "de": [
      "1 km von der Ortschaft Orcival entfernt bietet die Ferme des Planchettes montags bis freitags (außer an Feiertagen) um 11 Uhr eine kostenlose Besichtigung der Herstellung von Saint-Nectaire an.\r\nVerkauf auf dem Bauernhof den ganzen Tag über, täglich von 9 bis 18 Uhr (einschließlich Sonntag)."
    ],
    "en": [
      "1 km from the village of Orcival, the Planchettes farm offers a free tour of Saint-Nectaire cheese-making, Monday to Friday (except public holidays), at 11am.\r\nFarm sales all day, every day from 9am to 6pm (including Sundays)."
    ],
    "it": [
      "A 1 km dal villaggio di Orcival, la fattoria Planchettes offre una visita gratuita alla fabbricazione del formaggio di Saint-Nectaire, dal lunedì al venerdì (eccetto i giorni festivi), alle 11.00.\r\nVendite in fattoria tutto il giorno, tutti i giorni dalle 9.00 alle 18.00 (domenica compresa)."
    ],
    "fr": [
      "A 1 km du bourg d'Orcival, la ferme des Planchettes propose une visite gratuite de la fabrication du Saint-Nectaire, du lundi au vendredi (sauf jours fériés), à 11h.\r\nVente à la ferme toute la journée, tous les jours, de 9h à 18h (dimanche compris)."
    ],
    "nl": [
      "Op 1 km van het dorp Orcival biedt de boerderij Planchettes van maandag tot vrijdag (behalve op feestdagen) om 11 uur 's ochtends een gratis rondleiding over hoe Saint-Nectaire kaas wordt gemaakt.\r\nBoerderijverkoop de hele dag, elke dag van 9 tot 18 uur (ook op zondag)."
    ],
    "es": [
      "A 1 km del pueblo de Orcival, la granja de Planchettes ofrece una visita gratuita a la fabricación del queso Saint-Nectaire, de lunes a viernes (excepto festivos), a las 11 h.\r\nVenta en la granja durante todo el día, todos los días de 9h a 18h (domingos incluidos)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme des Planchettes"
    ]
  },
