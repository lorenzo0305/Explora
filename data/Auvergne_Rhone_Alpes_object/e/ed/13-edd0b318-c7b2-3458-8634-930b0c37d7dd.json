  "rdfs:comment": {
    "de": [
      "Entdecken Sie Cluses einmal anders! Perfekt für Anfänger: Unsere grüne Strecke führt am Fluss entlang und bietet einen entspannenden Spaziergang ohne Höhenunterschiede. Ideal für einen Familienausflug oder einen gemütlichen Spaziergang durch die Stadt."
    ],
    "en": [
      "This loop allows you to run along the Arve river."
    ],
    "it": [
      "Scoprite Cluses in modo diverso! Perfetto per i principianti, il nostro percorso verde costeggia il fiume e offre una passeggiata rilassante senza variazioni di altitudine. Ideale per una gita in famiglia o per una piacevole passeggiata in città."
    ],
    "fr": [
      "Découvrez Cluses autrement ! Parfait pour les débutants, notre parcours vert longe la rivière, offrant une balade relaxante sans dénivelé. Idéal pour une sortie en famille ou une promenade tranquille en ville."
    ],
    "es": [
      "¡Descubra Cluses de otra manera! Perfecta para principiantes, nuestra ruta verde discurre junto al río, ofreciendo un paseo relajante sin cambios de altitud. Ideal para una excursión en familia o un paseo tranquilo por la ciudad."
    ],
    "nl": [
      "Ontdek Cluses op een andere manier! Onze groene route, perfect voor beginners, loopt langs de rivier en biedt een ontspannen wandeling zonder hoogteverschillen. Ideaal voor een gezinsuitstapje of een ontspannen wandeling door de stad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Running loop - green route"
    ],
    "fr": [
      "Boucle running - Parcours vert"
    ]
  },
