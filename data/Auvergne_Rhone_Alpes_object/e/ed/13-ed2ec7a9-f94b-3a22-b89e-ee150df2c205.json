  "rdfs:comment": {
    "de": [
      "Hier, in der lange Zeit stillen Dorfgaststätte, möchten wir einen Ort schaffen, an dem sich Essen, Trinken, Bistro, Lebensmittelgeschäft, Multi-Dienstleistungen und kulturelle Veranstaltungen fröhlich vermischen!"
    ],
    "en": [
      "It's here, in the long-silent village restaurant, that we want to create a lively mix of restaurants, bistros, grocery stores, multi-services and cultural events!"
    ],
    "it": [
      "È qui, nel ristorante del villaggio a lungo silenzioso, che speriamo di creare un vivace mix di ristoranti, bistrot, negozi di alimentari, multiservizi ed eventi culturali!"
    ],
    "fr": [
      "C'est ici, dans le restaurant du village resté longtemps silencieux, que nous souhaitons créer un lieu de vie mêlant joyeusement restauration, bistrot, épicerie, multi-services et évènements culturels !"
    ],
    "nl": [
      "Hier, in het lang stille dorpsrestaurant, hopen we een levendige mix van restaurants, bistro's, kruidenierswinkels, multiservices en culturele evenementen te creëren!"
    ],
    "es": [
      "Es aquí, en el restaurante del pueblo, durante mucho tiempo silencioso, donde esperamos crear una animada mezcla de restaurantes, bistrós, tiendas de comestibles, multiservicios y eventos culturales"
    ]
  },
  "rdfs:label": {
