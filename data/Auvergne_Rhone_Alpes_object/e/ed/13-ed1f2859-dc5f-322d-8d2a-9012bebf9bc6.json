  "rdfs:comment": {
    "de": [
      "Das Tipi-Dorf bedeutet: ein Tipi-Park (Aktivitäten in Eigenregie), betreute Aktivitäten (originelle und spielerische Aktivitäten) oder auch Verleih (Schneeschuhe, Trottiluge...). Aktivitäten in der Natur, in einem komfortablen Rahmen und gesicherte Abenteuer!"
    ],
    "en": [
      "The Village Tipi is: a Tipi Parc (self-guided activities), supervised activities (original and fun activities) or rental (snowshoes, trottiluge...). Nature activities, in a comfortable and safe environment!"
    ],
    "it": [
      "Il Village Tipi è: un Tipi Park (attività autoguidate), attività sorvegliate (attività originali e divertenti) o anche noleggio (racchette da neve, trottiluge...). Attività nella natura in un ambiente confortevole e sicuro!"
    ],
    "fr": [
      "Le Village Tipi c'est : un Tipi Parc (activités en autonomie), des activités encadrées (activités originales et ludiques) ou encore de la location (raquettes, trottiluge...). Des activités de nature, dans un cadre de confort et d’aventures sécurisées !"
    ],
    "es": [
      "El Village Tipi es: un Tipi Park (actividades autoguiadas), actividades supervisadas (actividades originales y divertidas) o incluso de alquiler (raquetas de nieve, trottiluge...). ¡Actividades en la naturaleza en un entorno cómodo y seguro!"
    ],
    "nl": [
      "De Tipi Village is: een Tipi Park (activiteiten op eigen houtje), activiteiten onder begeleiding (originele en leuke activiteiten) of zelfs verhuur (sneeuwschoenen, trottiluge...). Natuuractiviteiten in een comfortabele en veilige omgeving!"
    ]
  },
