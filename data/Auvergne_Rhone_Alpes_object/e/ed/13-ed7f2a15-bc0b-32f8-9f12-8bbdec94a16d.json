  "rdfs:comment": {
    "de": [
      "Erkunden Sie den Himmel mit Chantal Milliex, einer diplomierten Astronomie-Animateurin. Mit dem Astro Pass entdecken Sie in einer spielerischen Atmosphäre die Sternbilder und beobachten Sterne, Galaxien und Nebel. Chantal passt ihre Sitzungen an das Publikum und den Kontext an."
    ],
    "en": [
      "Explore the sky with Chantal Milliex, a qualified astronomy instructor. With Astro Pass, discover the constellations and observe stars, galaxies and nebulae in a fun atmosphere. Chantal adapts her sessions to suit the audience and the context."
    ],
    "it": [
      "Esplorate il cielo con Chantal Milliex, istruttrice qualificata di astronomia. Con Astro Pass, scoprite le costellazioni e osservate le stelle, le galassie e le nebulose in un'atmosfera divertente. Chantal adatta le sue sessioni al pubblico e al contesto."
    ],
    "fr": [
      "Explorez le ciel avec Chantal Milliex, animatrice diplômée en astronomie. Avec Astro Pass, dans une ambiance ludique découvrez les constellations et observez les étoiles, les galaxies et les nébuleuses. Chantal adapte ses séances au public et au contexte."
    ],
    "nl": [
      "Verken de hemel met Chantal Milliex, een gekwalificeerde astronomie-instructeur. Ontdek met Astro Pass de sterrenbeelden en observeer de sterren, sterrenstelsels en nevels in een leuke sfeer. Chantal past haar sessies aan het publiek en de context aan."
    ],
    "es": [
      "Explore el cielo con Chantal Milliex, instructora diplomada en astronomía. Con Astro Pass, descubra las constelaciones y observe las estrellas, galaxias y nebulosas en un ambiente lúdico. Chantal adapta sus sesiones al público y al contexto."
    ]
  },
