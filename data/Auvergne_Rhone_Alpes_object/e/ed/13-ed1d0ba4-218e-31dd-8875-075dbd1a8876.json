  "rdfs:comment": {
    "de": [
      "Traditionelle Küche und Feinschmeckerküche aus der Region. Wir arbeiten mit Spezialitäten aus Lyon, der Franche-Comté und lokalen Produkten.\r\nGrillspezialitäten, Froschschenkel, Fisch, Pommes frites und hausgemachte Desserts, begleitet von unseren Weinen und Käsesorten."
    ],
    "en": [
      "Authentic restaurant and shaded terrace. Traditional and gourmet cuisine based on specialities from Lyon.\r\nGrilled meat, Manthes trout, frogs' legs, chips and home-made desserts. Accompanied by our wines and cheeses."
    ],
    "it": [
      "Cucina gourmet tradizionale regionale. Lavoriamo con specialità di Lione, della regione Franche-Comté e con prodotti locali.\r\nCarni alla griglia, cosce di rana, pesce, patatine e dolci fatti in casa, accompagnati dai nostri vini e formaggi."
    ],
    "fr": [
      "Cuisine traditionnelle et gourmande de Région. Nous travaillons autour de spécialités lyonnaises, franc-comtoise et produits locaux.\r\nGrillades, Cuisses de grenouilles, Poissons, Frites et desserts maison, accompagné de nos vins et fromages."
    ],
    "es": [
      "Cocina gastronómica tradicional regional. Trabajamos con especialidades de Lyon, la región del Franco Condado y productos locales.\r\nCarnes a la brasa, ancas de rana, pescados, patatas fritas y postres caseros, acompañados de nuestros vinos y quesos."
    ],
    "nl": [
      "Authentiek restaurant en schaduwrijk terras. Traditionele en gastronomische keuken op basis van specialiteiten uit Lyon en de Dauphiné.\r\nGegrild vlees, Manthes forel, kikkerbilletjes, patat en huisgemaakte desserts. Vergezeld van onze wijnen en kazen."
    ]
  },
