  "rdfs:comment": {
    "de": [
      "Die Kirche ist ursprünglich romanisch und wurde im 15. Jahrhundert umgebaut. Jahrhundert umgebaut. Sie hat wie viele andere Kirchen des Landes einen Kammglockenturm und ein Kopfende mit abgeschrägten Kanten."
    ],
    "en": [
      "Originally Romanesque, the church was remodeled around the 15th century. Like many of the country's churches, it has a combed bell tower and a canted chevet."
    ],
    "it": [
      "Originariamente romanica, la chiesa è stata ristrutturata intorno al XV secolo. Come molte delle chiese del paese, presenta un campanile a pettine e un cornicione a sbalzo."
    ],
    "fr": [
      "D'origine romane, l'église a été remaniée vers le XVème siècle. Elle possède comme de nombreuses églises du pays un clocher peigne et un chevet à pans coupés."
    ],
    "es": [
      "Originalmente románica, la iglesia fue remodelada hacia el siglo XV. Como muchas de las iglesias del país, tiene un campanario peinado y una cabecera inclinada."
    ],
    "nl": [
      "De kerk was oorspronkelijk romaans, maar werd rond de 15e eeuw verbouwd. Zoals veel kerken in het land heeft de kerk een gekamde klokkentoren en een gekantelde koorafsluiting."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Bruno | St Vénérand"
    ]
  },
