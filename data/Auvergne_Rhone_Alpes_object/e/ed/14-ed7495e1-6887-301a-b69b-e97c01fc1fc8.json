  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b90a844e-3150-33bc-8648-34d57151d3dc",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Feingebäck und Konditoreiwaren\nSpezialität: Chouquette\n\nTage der Öffnung:\n\nDienstag bis Freitag von 7:00 bis 13:00 Uhr und von 16:00 bis 19:00 Uhr\nSamstag und Sonntag: 7:00 bis 12:30 Uhr\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nMöglichkeit der telefonischen Bestellung unter 03.21.23.54.09\n\n \n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries and cakes\nSpeciality: chouquette\n\nOpening days:\n\nTuesday to Friday, 7am to 1pm and 4pm to 7pm\nSaturday and Sunday 7am to 12:30pm\n \n Pick-up :\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by phone 03.21.23.54.09\n\n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria e dolci\nSpecialità: la chouquette\n\nGiorni di apertura:\n\nDa martedì a venerdì, dalle 7.00 alle 13.00 e dalle 16.00 alle 19.00\nSabato e domenica dalle 7.00 alle 12.30\n \n Raccolta :\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate telefonicamente allo 03.21.23.54.09\n\n \n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, viennoiseries et pâtisseries\nSpécialité: la chouquette\n\nJours d'ouverture:\n\nDu mardi au vendredi de 7h à 13h et de 16h à 19h\nLe samedi et le dimanche de 7h à 12h30\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au  03.21.23.54.09\n\n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak en taarten\nSpecialiteit: de chouquette\n\nOpeningsdagen:\n\nDinsdag tot vrijdag van 7 tot 13 uur en van 16 tot 19 uur\nZaterdag en zondag van 7u tot 12u30\n \n Afhalen :\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nBestellingen kunnen telefonisch geplaatst worden op 03.21.23.54.09\n\n \n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería\nEspecialidad: la chouquette\n\nDías de apertura:\n\nDe martes a viernes, de 7h a 13h y de 16h a 19h\nSábado y domingo de 7.00 a 12.30\n \n Recogida :\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nSe pueden hacer pedidos por teléfono llamando al 03.21.23.54.09\n\n \n\n "
        ]
      },
