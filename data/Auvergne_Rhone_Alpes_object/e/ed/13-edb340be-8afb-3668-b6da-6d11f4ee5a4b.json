  "rdfs:comment": {
    "de": [
      "Dieser 17 ha große See liegt im Herzen des Parc de la Tête d'Or in Lyon und ist ein beliebter Ort für Stadtangler. Er bietet zahlreiche Aktivitäten für die ganze Familie: Tierpark, Bootsfahrten und Tretboote, Restaurant..."
    ],
    "en": [
      "Located in the heart of Lyon's Parc de la Tête d'Or, this 17-hectare lake is a favorite fishing spot for urban anglers, with plenty of activities for the whole family: zoo, boat and pedalo rides, restaurant..."
    ],
    "it": [
      "Situato nel cuore del Parc de la Tête d'Or di Lione, questo lago di 17 ettari è uno dei luoghi preferiti dai pescatori urbani, con numerose attività per tutta la famiglia: zoo, gite in barca e pedalò, ristorante..."
    ],
    "fr": [
      "Situé en plein cœur du Parc de la Tête d'Or à Lyon, ce lac de 17 ha est un lieu de pêche privilégié pour les pêcheurs urbains avec de nombreuses d'activités pour toute la famille : parc zoologique, balade en barque et pédalo, restaurant..."
    ],
    "es": [
      "Situado en el corazón del Parque de la Tête d'Or de Lyon, este lago de 17 hectáreas es uno de los lugares preferidos de los pescadores urbanos, con numerosas actividades para toda la familia: zoo, paseos en barca y a pedales, restaurante..."
    ],
    "nl": [
      "Dit meer van 17 hectare ligt in het hart van het Parc de la Tête d'Or in Lyon en is een favoriete plek voor stadsvissers. Er zijn tal van activiteiten voor het hele gezin: dierentuin, boot- en waterfietsen, restaurant..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêcher au parc de la Tête d'Or"
    ]
  },
