  "rdfs:comment": {
    "de": [
      "Auf Skiern, mit Schneeschuhen, mit Steigeisen, Eispickeln oder am Seil? das Bureau des Guides de Morzine-Avoriaz sorgt für unvergessliche Tage!"
    ],
    "en": [
      "Skiing, snowshoeing, with crampons, ice axes, or at the end of a rope... the Morzine-Avoriaz Guide Office makes you experience unforgettable days!"
    ],
    "it": [
      "Con gli sci, con le racchette da neve, con i ramponi, con le piccozze o con la corda... l'Ufficio Guide di Morzine-Avoriaz vi regalerà giornate indimenticabili!"
    ],
    "fr": [
      "À ski, en raquettes, avec des crampons, des piolets ou au bout d’une corde… le Bureau des Guides de Morzine-Avoriaz vous fait vivre des journées inoubliables !"
    ],
    "es": [
      "Sobre esquís, raquetas de nieve, con crampones, piolet o al final de una cuerda... ¡la Oficina de Guías de Morzine-Avoriaz le regalará jornadas inolvidables!"
    ],
    "nl": [
      "Skiën, sneeuwschoenwandelen, met stijgijzers, ijsbijlen, of aan het einde van een touw... het Bureau des Guides in Morzine-Avoriaz bezorgt u onvergetelijke dagen!"
    ]
  },
