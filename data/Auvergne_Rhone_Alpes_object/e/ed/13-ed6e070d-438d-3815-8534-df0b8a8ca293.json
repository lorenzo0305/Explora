  "rdfs:comment": {
    "de": [
      "Familienbetrieb, der sich seit 2007 niedergelassen hat.\r\n\r\nWir halten eine Herde von 125 Ziegen. Sie werden auf dem Hof geboren und aufgezogen und mit Luzerne und Getreide aus der Umgebung des Hofes gefüttert, der seit 2021 Bio-Landwirtschaft betreibt."
    ],
    "en": [
      "Producers of organic goat's milk and cheese.\r\n\r\nEstablished since 2007, we raise a herd of 125 goats. Born and raised on the farm, they are fed with alfalfa and cereals grown around the farm in organic farming."
    ],
    "it": [
      "Azienda familiare fondata nel 2007.\r\n\r\nAlleviamo un gregge di 125 capre. Nate e allevate in azienda, sono nutrite con erba medica e cereali coltivati intorno alla fattoria, che è certificata biologica dal 2021."
    ],
    "fr": [
      "Exploitation familiale installée depuis 2007.\r\n\r\nNous élevons un troupeau de 125 chèvres. Nées et élevées sur l'exploitation, nourries avec la luzerne et les céréales produites autour de la Ferme en Agriculture Bio depuis 2021."
    ],
    "nl": [
      "Producenten van biologische geitenmelk en kaas.\r\n\r\nWe zijn opgericht in 2007 en houden een kudde van 125 geiten. Ze zijn geboren en gefokt op de boerderij en worden gevoed met biologische luzerne en granen die rond de boerderij worden verbouwd."
    ],
    "es": [
      "Empresa familiar fundada en 2007.\r\n\r\nMantenemos un rebaño de 125 cabras. Nacidas y criadas en la explotación, se alimentan de alfalfa y cereales cultivados en los alrededores de la explotación, certificada ecológica desde 2021."
    ]
  },
