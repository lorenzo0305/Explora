  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/030b3430-ca5e-31a9-ae9e-7176198281fe",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck, Konditoreiwaren und Sandwiches\n\nTage der Öffnung:\n\nMontag bis Freitag von 6.00 bis 19.30 Uhr und Samstag von 6.00 bis 19.00 Uhr\nSonntags geschlossen\n\nAbholung:\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\nTelefonische Bestellungen unter 03 21 51 82 81 möglich\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries and sandwiches\n\nOpening days:\n\nMonday to Friday 06:00 to 19:30 and Saturday 06:00 to 19:00\nClosed on Sunday\n\nPick-up :\nTakeaway during store opening hours\n\nOrdering:\nOrder by phone 03 21 51 82 81\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria e panini\n\nGiorni di apertura:\n\nDa lunedì a venerdì dalle 06:00 alle 19:30 e sabato dalle 06:00 alle 19:00\nChiuso la domenica\n\nRitiro :\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 51 82 81\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, viennoiseries, pâtisseries et sandwichs\n\nJours d'ouverture:\n\nDu lundi au vendredi de 06h00 à 19h30 et le samdei de 06h00 à 19h00\nFemeture le dimanche\n\nRetrait :\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\nPossibilité de commander par téléphone au  03 21 51 82 81\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak en sandwiches\n\nOpeningsdagen:\n\nMaandag t/m vrijdag van 06:00 tot 19:30 en zaterdag van 06:00 tot 19:00\nGesloten op zondag\n\nAfhalen :\nAfhalen tijdens openingstijden winkel\n\nBestellen :\nBestellingen kunnen telefonisch geplaatst worden op 03 21 51 82 81\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y bocadillos\n\nDías de apertura:\n\nDe lunes a viernes de 06:00 a 19:30 y sábados de 06:00 a 19:00\nDomingos cerrado\n\nRecogida :\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\nLos pedidos pueden hacerse por teléfono llamando al 03 21 51 82 81\n "
        ]
      },
