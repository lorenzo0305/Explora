  "rdfs:comment": {
    "de": [
      "Ein außergewöhnlicher 360°-Panoramablick auf die Schönheit der Alpen mit dem Mont-Blanc als Höhepunkt."
    ],
    "en": [
      "With an exceptional 360° panoramic view, the beauty of the Alps unfolds before your eyes in all its splendour, culminating in Mont Blanc."
    ],
    "it": [
      "Con un'eccezionale vista panoramica a 360°, la bellezza delle Alpi si dispiega davanti ai vostri occhi in tutto il suo splendore, culminando nel Monte Bianco."
    ],
    "fr": [
      "Vue panoramique exeptionnelle à 360°, la beauté des Alpes se déploie sous vos yeux dans toute sa splendeur. avec pour point d’orgue le Mont-Blanc."
    ],
    "nl": [
      "Met een uitzonderlijk 360° panoramisch uitzicht ontvouwt de schoonheid van de Alpen zich voor je ogen in al haar pracht, met als hoogtepunt de Mont Blanc."
    ],
    "es": [
      "Con una excepcional vista panorámica de 360°, la belleza de los Alpes se despliega ante sus ojos en todo su esplendor, culminando en el Mont Blanc."
