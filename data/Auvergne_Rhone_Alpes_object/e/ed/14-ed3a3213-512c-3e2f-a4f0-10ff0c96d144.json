  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a81d8e76-e715-3290-9ddd-018b2c8a0019",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Samstag von 9:00 bis 12:30 Uhr und von 14:30 bis 19:00 Uhr. Sonntag und Montag geschlossen.\n\nBestellungen:\n- Bestellungen können telefonisch unter 03 21 15 35 82 aufgegeben werden.\n\nOrganisation :\n- Die Bestellungen müssen im Laden abgeholt werden.\n- Nicht mehr als 6 Personen im Laden.\n \n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Saturday, 9am to 12:30pm and 2:30pm to 7pm. Closed on Sunday and Monday.\n\nOrdering :\n- Orders can be placed by telephone on 03 21 15 35 82.\n\nOrganization:\n- Orders are to be collected from the store.\n- No more than 6 people in the store.\n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a sabato, dalle 9.00 alle 12.30 e dalle 14.30 alle 19.00. Chiuso la domenica e il lunedì.\n\nOrdini :\n- Le ordinazioni possono essere effettuate per telefono al numero 03 21 15 35 82.\n\nOrganizzazione:\n- Gli ordini possono essere ritirati in negozio.\n- Non più di 6 persone nel negozio.\n \n\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu mardi au samedi de 9h à 12h30 et de 14h30 à 19h. Fermeture le dimanche et le lundi.\n\nCommandes :\n- Possibilité de passer commande par téléphone au 03 21 15 35 82.\n\nOrganisation :  \n- Les commandes sont à venir retirer au magasin.\n- Pas plus de 6 personnes au sein du magasin.\n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag t/m zaterdag van 9.00 tot 12.30 uur en van 14.30 tot 19.00 uur. Gesloten op zondag en maandag.\n\nBestellingen :\n- Bestellingen kunnen telefonisch worden doorgegeven op 03 21 15 35 82.\n\nOrganisatie:\n- Bestellingen kunnen afgehaald worden in de winkel.\n- Niet meer dan 6 personen in de winkel.\n \n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a sábado, de 9h a 12h30 y de 14h30 a 19h. Domingos y lunes cerrado.\n\nPedidos :\n- Los pedidos pueden hacerse por teléfono llamando al 03 21 15 35 82.\n\nOrganización:\n- Los pedidos pueden recogerse en la tienda.\n- No más de 6 personas en la tienda.\n \n\n "
        ]
      },
