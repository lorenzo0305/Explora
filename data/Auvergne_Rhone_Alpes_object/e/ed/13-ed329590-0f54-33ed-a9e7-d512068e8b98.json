  "rdfs:comment": {
    "de": [
      "In diesem privaten Veranstaltungsraum mit 40 Plätzen, der nur wenige Schritte vom Park Buisson-Rond entfernt liegt, werden zeitgenössische Amateur- und professionelle Aufführungen mit freier Beteiligung des Publikums (Hutgeld) gezeigt."
    ],
    "en": [
      "Just a stone's throw from the Buisson-Rond park, this 40-seat private auditorium hosts contemporary amateur and professional shows at a pay as you feel charge."
    ],
    "it": [
      "A due passi dal parco Buisson-Rond, questo auditorium privato da 40 posti ospita spettacoli contemporanei amatoriali e professionali a un costo a scelta dell'utente."
    ],
    "fr": [
      "À deux pas du parc de Buisson-Rond, cette salle de spectacle privée de 40 places accueille des spectacles contemporains amateurs ou professionnels avec une participation libre du public (au chapeau)."
    ],
    "nl": [
      "Op een steenworp afstand van het park Buisson-Rond biedt dit privé-auditorium met 40 zitplaatsen hedendaagse amateur- en professionele voorstellingen tegen een 'pay as you feel'-prijs."
    ],
    "es": [
      "A dos pasos del parque Buisson-Rond, este teatro privado de 40 plazas acoge espectáculos contemporáneos de aficionados y profesionales con participación gratuita del público (a golpe de sombrero)."
    ]
  },
