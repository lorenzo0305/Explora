  "rdfs:comment": {
    "de": [
      "Von Piaf bis Stromae, von France Gall bis Dalida, Angèle... Marvics kraftvolle Stimme nimmt uns mit auf eine rhythmische Reise durch das französische Chanson der letzten 60 Jahre. Unter freiem Himmel."
    ],
    "en": [
      "From Piaf to Stromae, France Gall to Dalida, Angèle... Marvic's powerful voice takes us on a rhythmic journey through the French chanson of the last 60 years. In the open air."
    ],
    "it": [
      "Da Piaf a Stromae, da France Gall a Dalida, Angèle... La potente voce di Marvic ci accompagna in un viaggio ritmico attraverso la chanson francese degli ultimi 60 anni. All'aria aperta."
    ],
    "fr": [
      "De Piaf à Stromae, de France Gall à Dalida, Angèle... la voix puissante de Marvic nous embarque dans un voyage rythmé à travers la chanson française des 60 dernières années. En plein air."
    ],
    "nl": [
      "Van Piaf tot Stromae, France Gall tot Dalida, Angèle... Marvic' krachtige stem neemt ons mee op een ritmische reis door het Franse chanson van de afgelopen 60 jaar. In de open lucht."
    ],
    "es": [
      "De Piaf a Stromae, de France Gall a Dalida, Angèle... La poderosa voz de Marvic nos lleva en un viaje rítmico por la chanson francesa de los últimos 60 años. Al aire libre."
    ]
  },
