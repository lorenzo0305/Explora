  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Laveissière, auf halbem Weg zwischen Murat und dem Skigebiet Le Lioran, 5 Minuten von den Skipisten entfernt, empfangen Sie Anne-Sophie und Gaëtan in ihrem Berghotel-Ferienhaus gegenüber dem Wasserspiegel."
    ],
    "en": [
      "In the heart of the village of Laveissière, halfway between Murat and the Lioran ski resort, 5 minutes from the ski slopes, Anne-Sophie and Gaëtan welcome you to their mountain gîte-hotel facing the lake."
    ],
    "it": [
      "Nel cuore del villaggio di Laveissière, a metà strada tra Murat e la località di Le Lioran, a 5 minuti dalle piste da sci, Anne-Sophie e Gaëtan vi accolgono nel loro gîte-hotel di montagna affacciato sul lago."
    ],
    "fr": [
      "Au cœur du village de Laveissière, à mi-chemin entre Murat et la station du Lioran, à 5 min des pistes de ski, Anne-Sophie et Gaëtan vous accueillent dans leur gîte-hôtel de montagne face au plan d'eau."
    ],
    "nl": [
      "In het hart van het dorp Laveissière, halverwege tussen Murat en het resort van Le Lioran, op 5 minuten van de skipistes, heten Anne-Sophie en Gaëtan je welkom in hun gîte-hotel in de bergen met uitzicht op het meer."
    ],
    "es": [
      "En el corazón del pueblo de Laveissière, a medio camino entre Murat y la estación de Le Lioran, a 5 minutos de las pistas de esquí, Anne-Sophie y Gaëtan le dan la bienvenida a su casa rural-hotel de montaña frente al lago."
    ]
  },
  "rdfs:label": {
