  "rdfs:comment": {
    "de": [
      "Die Gemeinde Suze la Rousse verfügt über eine Ladestation, an der zwei Elektrofahrzeuge gleichzeitig aufgeladen werden können: Im Jardin des Vignes sind zwei Plätze für diese Nutzung reserviert."
    ],
    "en": [
      "The commune of Suze la Rousse has a charging station for 2 electric vehicles: 2 spaces are reserved for this purpose at the Jardin des Vignes."
    ],
    "it": [
      "Il comune di Suze la Rousse dispone di un punto di ricarica per la ricarica simultanea di due veicoli elettrici: due spazi sono riservati a questo scopo nel Jardin des Vignes."
    ],
    "fr": [
      "La commune de Suze la Rousse dispose d'une borne pour recharger en simultané 2 véhicules électriques : 2 places sont réservées à cet usage au Jardin des Vignes."
    ],
    "es": [
      "El municipio de Suze la Rousse dispone de un punto de carga para la recarga simultánea de dos vehículos eléctricos: hay dos espacios reservados para ello en el Jardin des Vignes."
    ],
    "nl": [
      "De gemeente Suze la Rousse heeft een oplaadpunt voor het gelijktijdig opladen van 2 elektrische voertuigen: hiervoor zijn 2 plaatsen gereserveerd in de Jardin des Vignes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "eborn - borne de recharge pour véhicule électrique"
    ]
  },
