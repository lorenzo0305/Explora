  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e2398050-f703-3df2-badf-efeeba8a1350",
      "dc:description": {
        "de": [
          "Herstellung von handwerklich hergestellten Torten. Kuchen mit Papins, Obst und Erdbeeren in der Saison. Aber auch Quiches und Pizzas, Gebäck, ..... Finden Sie mich auf zahlreichen Märkten"
        ],
        "en": [
          "Homemade pies. Pies with butterflies, fruit and strawberries in season. But also, quiches and pizzas, viennoiseries, .... Meet me at many markets"
        ],
        "it": [
          "Torte fatte in casa. Torte con papini, frutta e fragole di stagione. Ma anche quiche e pizze, pasticcini viennesi, ..... Incontriamoci in molti mercati"
        ],
        "fr": [
          "Fabrication de tartes artisanales. Tartes aux papins, fruits et fraises en saison. Mais aussi, des quiches et pizzas, viennoiseries, .... Retrouvez moi sur de nombreux marchés"
        ],
        "es": [
          "Tartas caseras. Tartas con papines, frutas y fresas de temporada. Pero también quiches y pizzas, bollería, .... Nos vemos en muchos mercados"
        ],
        "nl": [
          "Huisgemaakte taarten. Taarten met paprika, fruit en aardbeien in het seizoen. Maar ook quiches en pizza's, Weens gebak, .... Ontmoet me op vele markten"
        ]
      },
