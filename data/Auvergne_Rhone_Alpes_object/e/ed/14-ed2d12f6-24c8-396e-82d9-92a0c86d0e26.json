  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/10aea368-0306-310b-b1dc-40383f8a3e24",
      "dc:description": {
        "de": [
          "Die Domaine du Bléquin ist der ideale Ort für einen entspannten Tag am Wasser. Ob Sie ein erfahrener Angler oder ein neugieriger Anfänger sind, unser friedlicher Teich verspricht Ihnen gute Fänge und Momente der Ruhe."
        ],
        "en": [
          "Domaine du Bléquin is the ideal place for a relaxing day at the water's edge. Whether you're a seasoned angler or a curious beginner, our peaceful pond promises great catches and moments of serenity."
        ],
        "it": [
          "Il Domaine du Bléquin è il luogo ideale per una giornata di relax in acqua. Che siate pescatori esperti o principianti curiosi, il nostro tranquillo laghetto promette grandi catture e momenti di serenità."
        ],
        "fr": [
          "Le Domaine du Bléquin est l'endroit idéal pour une journée de détente au bord de l'eau. Que vous soyez un pêcheur aguerri ou un débutant curieux, notre étang paisible vous promet de belles prises et des moments de sérénité."
        ],
        "es": [
          "El Domaine du Bléquin es el lugar ideal para pasar un día relajado en el agua. Tanto si es un pescador experimentado como un curioso principiante, nuestro tranquilo estanque promete grandes capturas y momentos de serenidad."
        ],
        "nl": [
          "Domaine du Bléquin is de ideale plek voor een ontspannen dagje op het water. Of je nu een doorgewinterde visser bent of een nieuwsgierige beginner, onze rustige vijver belooft geweldige vangsten en momenten van sereniteit."
        ]
      },
      "@type": [
        "Description"
      ],
