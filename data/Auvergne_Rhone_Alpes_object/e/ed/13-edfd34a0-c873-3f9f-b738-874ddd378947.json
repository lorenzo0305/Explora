  "rdfs:comment": {
    "de": [
      "Dieses atypische Festival, das 1988 gegründet wurde, wird von einem Team ehrenamtlicher, begeisterter Filmliebhaber geleitet und setzt sich mit Energie für ein unabhängiges und innovatives Autorenkino ein. Es gliedert sich in zwei Bereiche: Spielfilme und Kurzfilme."
    ],
    "en": [
      "Founded in 1988, this atypical festival, run by a team of enthusiastic film-loving volunteers, is an energetic advocate of innovative independent auteur cinema. It focuses on two main themes: feature films and shorts."
    ],
    "it": [
      "Creato nel 1988, questo festival atipico, guidato da un team di entusiasti volontari del cinema, difende con energia un cinema d'autore indipendente e innovativo. Il festival ha due focus principali: i lungometraggi e i cortometraggi."
    ],
    "fr": [
      "Créé en 1988, ce festival atypique mené par une équipe de bénévoles cinéphiles enthousiastes, défend avec énergie un cinéma d'auteur indépendant et novateur. Il s'articule autour de deux axes : les longs métrages et les courts métrages."
    ],
    "nl": [
      "Dit atypische festival werd opgericht in 1988 en wordt gerund door een team enthousiaste, filmliefhebbende vrijwilligers die zich energiek inzetten voor onafhankelijke, innovatieve auteurcinema. Het festival heeft twee hoofdonderdelen: speelfilms en korte films."
    ],
    "es": [
      "Creado en 1988, este atípico festival, dirigido por un equipo de entusiastas voluntarios del cine, defiende con energía un cine de autor independiente e innovador. El festival tiene dos enfoques principales: los largometrajes y los cortometrajes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival du Film"
    ]
  },
