  "rdfs:comment": {
    "de": [
      "Das Unternehmenshotel der Gemeinde \"La Passerelle\" ist ein kostengünstiger, eingerichteter Arbeitsplatz für lokale Unternehmer, die ihr Geschäft ausbauen möchten. Dieses Gebäude bietet noch Räume zur Miete an."
    ],
    "en": [
      "La Loco'Working in Bourgoin-Jallieu, a place optimized for work and a set of small, practical and indispensable services for the well-being of our loco'workers! Discover a different way of working!"
    ],
    "it": [
      "La Passerelle\", il centro commerciale della comunità, è un luogo di lavoro appositamente costruito e a basso costo per gli imprenditori locali che desiderano espandere la propria attività. L'edificio ha ancora spazi disponibili per l'affitto."
    ],
    "fr": [
      "L’hôtel d’entreprises de la commune « La Passerelle » est un lieu de travail aménagé, à petit prix, pour les entrepreneurs locaux qui souhaitent développer leur activité. Ce bâtiment propose encore des espaces à louer."
    ],
    "nl": [
      "La Passerelle\", het zakencentrum van de gemeenschap, is een speciaal gebouwde, goedkope werkplek voor lokale ondernemers die hun bedrijf willen uitbreiden. In het gebouw is nog ruimte te huur."
    ],
    "es": [
      "La Passerelle\", el centro de negocios de la comunidad, es un lugar de trabajo de bajo coste construido expresamente para los empresarios locales que deseen ampliar su negocio. El edificio aún dispone de locales en alquiler."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Passerelle Hôtel d'entreprises"
    ]
  },
