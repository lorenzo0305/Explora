  "rdfs:comment": {
    "de": [
      "Diese Route ist ideal für mittlere bis erfahrene Wanderer (recht schwierige Strecke) und kombiniert Waldpassagen, offene Almwiesen und ein Panorama-Finale auf dem Gipfel des Sessellifts von Grands Vans."
    ],
    "en": [
      "This route, ideal for intermediate to advanced ski tourers (fairly challenging), combines forested sections, open alpine meadows, and a panoramic finish at the top of the Grands Vans chairlift."
    ],
    "it": [
      "Questo percorso, ideale per escursionisti di livello intermedio-avanzato (abbastanza difficile), combina tratti di bosco, pascoli di montagna aperti e un finale panoramico in cima alla seggiovia Grands Vans."
    ],
    "fr": [
      "Ce parcours, idéal pour les randonneurs de niveau intermédiaire à confirmé (parcours assez difficile), combine des passages en forêt, des alpages dégagés et un final panoramique au sommet du télésiège des Grands Vans."
    ],
    "es": [
      "Esta ruta, ideal para excursionistas de nivel intermedio a avanzado (bastante difícil), combina tramos de bosque, pastos de montaña abiertos y un final panorámico en lo alto del telesilla de Grands Vans."
    ],
    "nl": [
      "Deze route, ideaal voor skitoeristen van gemiddeld tot gevorderd niveau (tamelijk uitdagend), combineert bosrijke secties, open alpine weiden en eindigt panoramisch bovenaan de Grands Vans‑stoeltjeslift."
    ]
  },
  "rdfs:label": {
    "en": [
      "Montée des Grands Vans ski touring itinerary"
    ],
    "fr": [
      "Itinéraire de ski de randonnée Montée des Grands Vans"
    ],
    "nl": [
      "Montée des Grands Vans toerskiroute"
    ]
  },
