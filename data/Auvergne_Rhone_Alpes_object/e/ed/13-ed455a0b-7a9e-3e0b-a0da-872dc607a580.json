  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein Ort der Begegnung und des Austauschs. Sie finden hier: einen Ort der Entspannung mit einem Bereich für Kinder und Kleinkinder, einen Jugend- und einen Erwachsenenbereich mit über 10.000 Medien, Büchern, CDs und DVDs."
    ],
    "en": [
      "The library is a place for people to meet and interact. Here you'll find a relaxing setting with an area set aside for children and toddlers, a youth section and an adult section, with a total of over 10,000 documentary items, books, CDs and DVDs at your disposal."
    ],
    "it": [
      "La biblioteca è un luogo di incontro e di scambio di idee, dove troverete: un luogo di relax con uno spazio dedicato ai bambini e ai ragazzi, ai giovani e agli adulti con più di 10.000 documenti, libri, CD e DVD disponibili."
    ],
    "fr": [
      "La bibliothèque est un lieu de rencontre et d'échange, vous y trouverez : un lieu propice à la détente offrant un espace dédié aux enfants et aux touts-petits, des secteurs jeunesse et adulte avec à disposition plus de 10000 documents, livres, CD et DVD."
    ],
    "es": [
      "La biblioteca es un lugar de encuentro e intercambio de ideas, donde encontrará: un lugar para relajarse con un espacio dedicado a los sectores infantil, juvenil y de adultos con más de 10.000 documentos, libros, CD y DVD disponibles."
    ],
    "nl": [
      "De bibliotheek is een plek om elkaar te ontmoeten en ideeën uit te wisselen. U vindt er: een plek om te ontspannen met een ruimte gewijd aan kinderen en peuters, jeugd en volwassenen met meer dan 10.000 documenten, boeken, cd's en dvd's beschikbaar."
    ]
  },
