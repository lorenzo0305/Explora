  "rdfs:comment": {
    "de": [
      "Auf dem Itinéraire Remarquable \"Maurienne, d'Aiton à la vallée des Villards\" zeichnet sich die Kirche Saint Jean Baptiste durch ihr Portal aus, das im Inventar der Historischen Monumente aufgeführt ist."
    ],
    "en": [
      "On the ‘Maurienne, d'Aiton à la vallée des Villards’ Remarkable Itinerary, the church of Saint Jean Baptiste stands out for its listed portal."
    ],
    "it": [
      "Sul notevole itinerario \"Maurienne, da Aiton alla valle del Villards\", la chiesa di Saint Jean Baptiste si distingue per il suo portale, classificato come monumento storico."
    ],
    "fr": [
      "Sur l’Itinéraire Remarquable « Maurienne, d’Aiton à la vallée des Villards », l’église Saint Jean Baptiste se distingue par son portail classé à l'inventaire des Monuments Historiques."
    ],
    "nl": [
      "Op de opmerkelijke route \"Maurienne, van Aiton naar de vallei van Villards\", onderscheidt de kerk van Saint Jean Baptiste zich door haar portaal dat op de monumentenlijst staat."
    ],
    "es": [
      "En el Itinerario Notable \"Maurienne, de Aiton al valle de Villards\", la iglesia de Saint Jean Baptiste se distingue por su pórtico que está catalogado como Monumento Histórico."
    ]
  },
