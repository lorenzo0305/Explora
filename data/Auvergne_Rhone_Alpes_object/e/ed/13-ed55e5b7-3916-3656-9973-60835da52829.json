  "rdfs:comment": {
    "de": [
      "Bei Les délices du loup glauben wir an einfache Dinge. Gute, lokale und frische Produkte werden zu einer Gourmetküche verarbeitet. Diese wird Feinschmecker und Naschkatzen gleichermaßen zufriedenstellen."
    ],
    "en": [
      "At Les délices du loup, we believe in simple things. Merging fresh, local produce to create gourmet delights. Our products are sure to satisfy gourmets and gourmands alike."
    ],
    "it": [
      "A Les délices du loup crediamo nelle cose semplici. Combinare prodotti buoni, freschi e locali per creare delizie gastronomiche. Questo soddisferà i buongustai e i golosi."
    ],
    "fr": [
      "Chez Les délices du loup, nous croyons en des choses simples. Fusionner de bons produits locaux et frais pour créer de la gourmandise. Celle ci saura satisfaire les gourmets, tout comme les gourmands."
    ],
    "es": [
      "En Les délices du loup creemos en las cosas sencillas. Combinar productos buenos, frescos y locales para crear delicias gourmet. Un placer para gourmets y sibaritas."
    ],
    "nl": [
      "Bij Les délices du loup geloven we in eenvoudige dingen. Goede, verse, lokale producten combineren tot gastronomische hoogstandjes. Een traktatie voor fijnproevers en lekkerbekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marques Avenue - Les Délices du Loup"
    ]
  },
