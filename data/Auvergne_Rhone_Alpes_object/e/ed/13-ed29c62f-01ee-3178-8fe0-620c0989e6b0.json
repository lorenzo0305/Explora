  "rdfs:comment": {
    "de": [
      "Dieses Ensemble, das von einer im 18. Jahrhundert vollendeten und seitdem erhaltenen Organisation des autarken Lebens zeugt, lässt sich in mehrere Phasen unterteilen."
    ],
    "en": [
      "This ensemble, which bears witness to an organisation of life in autarky, achieved in the 18th century and preserved since then, is divided into several parts."
    ],
    "it": [
      "Questo insieme, che testimonia uno stile di vita autosufficiente, completato nel XVIII secolo e conservato da allora, è suddiviso in diverse fasi."
    ],
    "fr": [
      "Cet ensemble, témoin d'une organisation de vie en autarcie, aboutie au XVIIIème et préservée depuis, se décline en plusieurs temps."
    ],
    "es": [
      "Este conjunto, testimonio de un modo de vida autosuficiente, terminado en el siglo XVIII y conservado desde entonces, se divide en varias fases."
    ],
    "nl": [
      "Dit ensemble, dat getuigt van een zelfvoorzienende manier van leven, voltooid in de 18e eeuw en sindsdien bewaard, is verdeeld in verschillende fasen."
    ]
  },
  "rdfs:label": {
