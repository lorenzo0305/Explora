  "rdfs:comment": {
    "de": [
      "Vom Erzeuger zum Verbraucher, das ist das Motto der sechs Teilhaber des GAEC du Monteil. Dieser Bauernhof produziert seine Limousin-Rinder, Freilandschweine, sein Geflügel und seine auf dem Hof geborenen Kälber direkt und verkauft sie auf dem Betrieb."
    ],
    "en": [
      "From producer to consumer: this is the motto of the 6 partners of the GAEC du Monteil. The farm produces its own Limousin beef, free-range pigs, poultry and calves and sells them on the farm."
    ],
    "it": [
      "Dal produttore al consumatore: questo è il motto dei 6 soci del GAEC du Monteil. Questa azienda agricola produce i propri bovini di razza Limousin, i suini all'aperto, il pollame e i vitelli nati in azienda e li vende in azienda."
    ],
    "fr": [
      "Du producteur au consommateur, voilà la devise des 6 associés du GAEC du Monteil. Cette ferme produit directement ses boeufs limousins, ses cochons plein air, ses volailles, ses veaux nés sur la ferme et les revend sur l'exploitation."
    ],
    "nl": [
      "Van producent naar consument: dat is het motto van de 6 partners in de GAEC du Monteil. Deze boerderij produceert haar eigen Limousin runderen, scharrelvarkens, pluimvee en kalveren geboren op de boerderij en verkoopt deze op de boerderij."
    ],
    "es": [
      "Del productor al consumidor: ése es el lema de los 6 socios del GAEC du Monteil. Esta explotación produce su propio ganado Limousin, cerdos de granja, aves de corral y terneros nacidos en la granja y los vende en la propia explotación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Du Monteil (GAEC)"
    ]
  },
