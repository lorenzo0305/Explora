  "rdfs:comment": {
    "de": [
      "Der Bouleplatz am Col du Mollard, der sich neben der Wasserfläche befindet, ist frei zugänglich.\r\nIm Winter wird der Platz beschneit."
    ],
    "en": [
      "The petanque court at Col du Mollard, next to the lake, is open to all.\r\nIn winter, the pitch is covered in snow."
    ],
    "it": [
      "Il campo da bocce del Col du Mollard, vicino al lago, è aperto a tutti.\r\nIn inverno, il campo è coperto di neve."
    ],
    "fr": [
      "Le terrain de pétanque du Col du Mollard, situé à côté du plan d'eau est en accès libre. \r\nEn hiver, le terrain est enneigé."
    ],
    "es": [
      "La pista de petanca del Col du Mollard, junto al lago, está abierta a todos.\r\nEn invierno, la pista está cubierta de nieve."
    ],
    "nl": [
      "De petanquebaan op Col du Mollard, naast het meer, is voor iedereen toegankelijk.\r\nIn de winter is het veld bedekt met sneeuw."
    ]
  },
