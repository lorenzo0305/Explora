  "rdfs:comment": {
    "de": [
      "In unseren Restaurants bieten wir jeden Tag die besten italienischen Produkte an, die sorgfältig zubereitet und mit guter Laune serviert werden, damit jede Mahlzeit zu einem Moment des Schlemmens und der Geselligkeit wird."
    ],
    "en": [
      "In our restaurants, we offer the finest Italian products, prepared with care and served with good humor, so that every meal is a moment of indulgence and conviviality."
    ],
    "it": [
      "Ogni giorno nei nostri ristoranti offriamo i migliori prodotti italiani, preparati con cura e serviti con buon umore, affinché ogni pasto sia un momento di piacere e convivialità."
    ],
    "fr": [
      "Dans nos restaurants, nous proposons chaque jour les meilleurs produits italiens, préparés avec soins et servis avec bonne humeur, pour que chaque repas soit un moment de gourmandise et de convivialité."
    ],
    "nl": [
      "Elke dag bieden we in onze restaurants de beste Italiaanse producten, met zorg bereid en met humor geserveerd, zodat elke maaltijd een moment van verwennerij en gezelligheid is."
    ],
    "es": [
      "Cada día, en nuestros restaurantes, ofrecemos los mejores productos italianos, preparados con esmero y servidos con buen humor, para que cada comida sea un momento de indulgencia y convivencia."
    ]
  },
