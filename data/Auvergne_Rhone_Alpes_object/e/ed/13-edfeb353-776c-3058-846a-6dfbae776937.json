  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné d'Herbey. Wir können Sie für ein Picknick empfangen: Picknicktisch, Anbindestange für Pferde, Unterstand, Wasser und Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné d'Herbey. We can accommodate you for a picnic: picnic table, horse tie-up bar, shelter, water and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné d'Herbey. Possiamo ospitarvi per un picnic: tavolo da picnic, barra per legare i cavalli, riparo, acqua e parcheggio sono a vostra disposizione."
    ],
    "fr": [
      "Bienvenue au Relais Cyné d'Herbey. Nous pouvons vous accueillir le temps d'un pique nique: table de pique-nique, barre d'attache pour chevaux, abri, eau et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné d'Herbey. U kunt bij ons picknicken: picknicktafel, tui voor paarden, schuilhok, water en parkeerplaats staan tot uw beschikking."
    ],
    "es": [
      "Bienvenido al Relais Cyné d'Herbey. Podemos acomodarle para un picnic: mesa de picnic, barra de amarre para caballos, refugio, agua y aparcamiento están a su disposición."
    ]
  },
