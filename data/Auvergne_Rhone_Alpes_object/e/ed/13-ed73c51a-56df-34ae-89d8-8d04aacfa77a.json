  "rdfs:comment": {
    "de": [
      "La Manufacture des Tilleuls in Tullins ist ein dynamisches Geschäftszentrum, das Coworking Spaces, private Büros und Tagungsräume bietet. Ideal gelegen, fördert es den beruflichen Austausch und die Innovation in einer inspirierenden Umgebung."
    ],
    "en": [
      "La Manufacture des Tilleuls in Tullins is a dynamic business center, offering coworking spaces, private offices and meeting rooms. Ideally located, it fosters professional exchanges and innovation in an inspiring setting."
    ],
    "it": [
      "La Manufacture des Tilleuls di Tullins è un business center dinamico che offre spazi di coworking, uffici privati e sale riunioni. Situato in una posizione ideale, incoraggia gli scambi professionali e l'innovazione in un ambiente stimolante."
    ],
    "fr": [
      "La Manufacture des Tilleuls à Tullins est un centre d'affaires dynamique, offrant espaces de coworking, bureaux privés et salles de réunion. Idéalement situé, il favorise les échanges professionnels et l'innovation dans un cadre inspirant."
    ],
    "es": [
      "La Manufacture des Tilleuls, en Tullins, es un dinámico centro de negocios que ofrece espacios de coworking, despachos privados y salas de reuniones. Con una ubicación ideal, fomenta los intercambios profesionales y la innovación en un entorno inspirador."
    ],
    "nl": [
      "La Manufacture des Tilleuls in Tullins is een dynamisch zakencentrum dat coworkingruimtes, privékantoren en vergaderzalen biedt. Het is ideaal gelegen en stimuleert professionele uitwisselingen en innovatie in een inspirerende omgeving."
    ]
  },
