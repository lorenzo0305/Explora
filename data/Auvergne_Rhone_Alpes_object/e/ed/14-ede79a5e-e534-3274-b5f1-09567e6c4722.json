      "dc:description": {
        "de": [
          "In der Nebensaison von Mittwoch bis Sonntag geöffnet.\nIn der Hochsaison von Dienstag bis Sonntag geöffnet.\n\nVon 12:00 bis 14:30 Uhr und von 19:00 bis 21:30 Uhr."
        ],
        "en": [
          "Open from Wednesday to Sunday in low season.\nOpen from Tuesday to Sunday in high season.\n\nFrom 12pm to 2:30pm and from 7pm to 9:30pm."
        ],
        "it": [
          "Aperto da mercoledì a domenica in bassa stagione.\nAperto da martedì a domenica in alta stagione.\n\nDalle 12.00 alle 14.30 e dalle 19.00 alle 21.30."
        ],
        "fr": [
          "Ouvert du mercredi au dimanche en basse saison.\nOuvert du mardi au dimanche en haute saison.\n\nDe 12h à 14h30 et de 19h à 21h30."
        ],
        "nl": [
          "Geopend van woensdag tot zondag in het laagseizoen.\nGeopend van dinsdag tot zondag in het hoogseizoen.\n\nVan 12 tot 14.30 uur en van 19 tot 21.30 uur."
        ],
        "es": [
          "Abierto de miércoles a domingo en temporada baja.\nAbierto de martes a domingo en temporada alta.\n\nDe 12:00 a 14:30 y de 19:00 a 21:30."
