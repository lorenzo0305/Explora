  "rdfs:comment": {
    "de": [
      "Zeitgenössische Kreationen von handgestickten Einzelstücken mit Nadel und Lunéville-Häkelnadel.\r\nSchnuppertag, Praktika und Kurse in Kunststickerei mit der Lunéviller Häkelnadel (auf Reservierung, das ganze Jahr über). Und andere..."
    ],
    "en": [
      "Contemporary creations of unique hand-embroidered pieces using Lunéville crochet and needlework.\r\nDiscovery days, workshops and courses in Lunéville crochet embroidery (by reservation, all year round)."
    ],
    "it": [
      "Creazioni contemporanee di pezzi unici ricamati a mano con ago e uncinetto Lunéville.\r\nGiornata di scoperta, laboratori e corsi di ricamo all'uncinetto Lunéville (su prenotazione, tutto l'anno). E altro ancora..."
    ],
    "fr": [
      "Créations contemporaines de pièces uniques brodées à la main à l'aiguille et au crochet de Lunéville.\r\nJournée découverte, stages et cours de Broderie d'Art au crochet de Lunéville (sur réservation, toute l'année). Et autres..."
    ],
    "nl": [
      "Hedendaagse creaties van unieke stukken met de hand geborduurd met naald en Lunéville haakwerk.\r\nOntdekkingsdag, workshops en cursussen Lunéville haakwerk borduren (reserveren verplicht, het hele jaar door). En meer..."
    ],
    "es": [
      "Creaciones contemporáneas de piezas únicas bordadas a mano con aguja y ganchillo Lunéville.\r\nJornada de descubrimiento, talleres y cursos de bordado a ganchillo Lunéville (previa reserva, todo el año). Y más..."
    ]
  },
