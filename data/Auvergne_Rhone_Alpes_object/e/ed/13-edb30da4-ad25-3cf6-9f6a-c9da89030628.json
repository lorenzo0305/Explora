  "rdfs:comment": {
    "de": [
      "Familienküche, hausgemacht, kurze Transportwege, die so weit wie möglich bevorzugt werden. Regionale und/oder saisonale Gerichte. Sie werden sich mit Ihrer Familie und/oder Ihren Freunden wie zu Hause fühlen."
    ],
    "en": [
      "Home-cooked, family-style cuisine, with emphasis on short circuits. Regional and/or seasonal dishes. You'll feel right at home with your family and/or friends."
    ],
    "it": [
      "Cucina casalinga, fatta in casa, con l'accento sui canali di distribuzione brevi. Piatti regionali e/o stagionali. Vi sentirete a casa con la vostra famiglia e/o i vostri amici."
    ],
    "fr": [
      "Cuisine familiale, fait maison, circuits courts privilégiés au maximum. Plats régionaux et/ou de saison. Vous vous sentirez comme à la maison avec votre famille et/ou vos amis."
    ],
    "nl": [
      "Thuis koken, huisgemaakt, met de nadruk op korte distributiekanalen. Regionale en/of seizoensgebonden gerechten. Je voelt je meteen thuis met je familie en/of vrienden."
    ],
    "es": [
      "Cocina casera, hecha en casa, con énfasis en los canales cortos de distribución. Platos regionales y/o de temporada. Se sentirá como en casa con su familia y/o amigos."
    ]
  },
  "rdfs:label": {
    "fr": [
