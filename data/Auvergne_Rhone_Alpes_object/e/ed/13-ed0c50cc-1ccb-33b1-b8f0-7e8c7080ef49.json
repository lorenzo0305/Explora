  "rdfs:comment": {
    "de": [
      "Destination Créations ist ein Laden, den sich mehrere Kunsthandwerker teilen, um ihre Kreationen sowie Souvenirs aus der Ardèche auszustellen und zu verkaufen.\r\nJeden Tag werden Sie von einem Handwerker begrüßt, der in unserem Verein mitarbeitet."
    ],
    "en": [
      "Destination Créations is a shop run by many local artisans, who exhibit and sell their creations, as well as souvenirs of Ardèche. Each day, you will meet a different artisan, a partner of our association."
    ],
    "it": [
      "Destination Créations è un negozio condiviso da diversi artigiani per esporre e vendere le loro creazioni e i souvenir dell'Ardèche.\r\nOgni giorno sarete accolti da un artigiano che collabora con la nostra associazione."
    ],
    "fr": [
      "Destination Créations est une boutique partagée entre plusieurs artisans afin d'exposer et de vendre leurs créations, ainsi que des souvenirs d'Ardèche.\r\nChaque jour, vous serez accueilli par un artisan collaborant à notre association."
    ],
    "nl": [
      "Destination Créations is een gezamenlijke winkel van verschillende ambachtslieden om hun creaties en souvenirs uit de Ardèche tentoon te stellen en te verkopen.\r\nElke dag wordt u verwelkomd door een ambachtsman die samenwerkt met onze vereniging."
    ],
    "es": [
      "Destination Créations es una tienda compartida por varios artesanos para exponer y vender sus creaciones, así como recuerdos de la Ardèche.\r\nCada día, le dará la bienvenida un artesano que trabaja con nuestra asociación."
    ]
  },
