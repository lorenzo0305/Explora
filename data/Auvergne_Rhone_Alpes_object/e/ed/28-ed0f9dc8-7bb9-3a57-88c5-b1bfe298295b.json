      "rdfs:comment": {
        "de": [
          "Laurence baut in Limé, in der Nähe von Soissons, Safran an und bereitet auch Safranprodukte zu: Marmelade, Honig und Sirup.\nEntdecken Sie das gesamte Sortiment auf der Website und geben Sie Ihre Bestellung auf!"
        ],
        "en": [
          "Laurence grows saffron in Limé, near Soissons, and also makes saffron products: jam, honey and syrup.\nDiscover the full range on the website and place your order!"
        ],
        "it": [
          "Laurence coltiva lo zafferano a Limé, vicino a Soissons, e produce anche prodotti a base di zafferano: marmellata, miele e sciroppo.\nScoprite l'intera gamma sul sito web e fate il vostro ordine!"
        ],
        "fr": [
          "Laurence cultive le safran à Limé, près de Soissons et prépare également des produits safranés : de la confiture, du miel et du sirop.\nDécouvrez la gamme complète sur le site internet et passez votre commande !"
        ],
        "nl": [
          "Laurence kweekt saffraan in Limé, vlakbij Soissons, en maakt ook saffraanproducten: jam, honing en siroop.\nOntdek het volledige assortiment op de website en plaats je bestelling!"
        ],
        "es": [
          "Laurence cultiva azafrán en Limé, cerca de Soissons, y también elabora productos a base de azafrán: mermelada, miel y sirope.\nDescubra toda la gama en el sitio web y ¡haga su pedido!"
        ]
      },
      "foaf:homepage": [
