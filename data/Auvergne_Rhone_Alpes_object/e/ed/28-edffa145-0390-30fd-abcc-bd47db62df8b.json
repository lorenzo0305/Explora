  "rdfs:comment": {
    "de": [
      "Bar Brasserie mit traditioneller Küche, attraktiven Tagesgerichten und einer großen Auswahl an frisch gezapften Bieren. Spezialitäten: Vollkorn-Welsh, Hähnchengeschnetzeltes mit altem Senf, geschmorter Schinken..."
    ],
    "en": [
      "Brewery bar offering traditional cuisine, attractive daily specials and a wide selection of draught beers. Specialties: wholemeal welsh, minced chicken with old-fashioned mustard, braised ham..."
    ],
    "it": [
      "Bar-birreria che offre una cucina tradizionale, interessanti specialità giornaliere e un'ampia selezione di birre alla spina. Specialità: welsh integrale, pollo macinato con senape all'antica, prosciutto brasato..."
    ],
    "fr": [
      "Bar brasserie proposant une cuisine traditionnelle, des plats du jour attrayants et un large choix de bières en pression. Les spécialités : welsh complet, émincé de poulet à la moutarde à l'ancienne, jambon braisé..."
    ],
    "es": [
      "Bar-cervecería que ofrece cocina tradicional, atractivos platos del día y una amplia selección de cervezas de barril. Especialidades: galés integral, pollo picado con mostaza a la antigua, jamón estofado..."
    ],
    "nl": [
      "Bar-brouwerij met een traditionele keuken, aantrekkelijke dagschotels en een ruime keuze aan tapbieren. Specialiteiten: volkoren welsh, kipgehakt met ouderwetse mosterd, gestoofde ham..."
    ]
