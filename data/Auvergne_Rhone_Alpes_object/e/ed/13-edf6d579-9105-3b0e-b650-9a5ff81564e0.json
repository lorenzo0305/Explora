  "rdfs:comment": {
    "de": [
      "Im Rahmen des Buchfests der Stadt werden mehrere ?uvres von drei Jugendbuchautoren im Maison de la truffe ausgestellt.\r\nIn Partnerschaft mit dem Sou des Écoles."
    ],
    "en": [
      "As part of the town's Fête du Livre, several works by three authors of children's books are on display at the Maison de la Truffe.\r\nIn partnership with the Sou des Écoles."
    ],
    "it": [
      "Nell'ambito della Festa del Libro della città, diverse opere di tre autori di libri per bambini sono esposte alla Maison de la truffe.\r\nIn collaborazione con la Sou des Écoles."
    ],
    "fr": [
      "Dans le cadre de la Fête du Livre de la ville, plusieurs œuvres de trois auteurs de livres jeunesse sont exposées à la Maison de la truffe.\r\nEn partenariat avec le Sou des Écoles."
    ],
    "nl": [
      "In het kader van het Boekenfestival van de stad worden in het Maison de la truffe verschillende werken van drie auteurs van kinderboeken tentoongesteld.\r\nIn samenwerking met de Sou des Écoles."
    ],
    "es": [
      "En el marco de la Fiesta del Libro de la ciudad, se exponen en la Maison de la truffe varias obras de tres autores de libros infantiles.\r\nEn colaboración con el Sou des Écoles."
    ]
  },
  "rdfs:label": {
