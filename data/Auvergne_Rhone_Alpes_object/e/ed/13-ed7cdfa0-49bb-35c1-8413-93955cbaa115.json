  "rdfs:comment": {
    "de": [
      "Eine große Auswahl an Büchern, die regelmäßig wechseln. Leserclub, offen für alle, am ersten Freitag des Monats (außer in Ausnahmefällen) von 17:30 bis 19:30 Uhr."
    ],
    "en": [
      "Large range of books. Readers club every first Friday of the month from 5:30 PM to 7:30 PM."
    ],
    "it": [
      "Un'ampia scelta di libri che cambiano regolarmente. Club dei lettori, aperto a tutti, il primo venerdì del mese (salvo circostanze eccezionali) dalle 17.30 alle 19.30."
    ],
    "fr": [
      "Un large choix de livres qui changent régulièrement. Club des lecteurs, ouvert à tous, le premier vendredi du mois (sauf exception) de 17h30 à 19h30."
    ],
    "es": [
      "Una amplia selección de libros que cambia regularmente. Club de lectura, abierto a todos, el primer viernes de cada mes (salvo circunstancias excepcionales) de 17.30 a 19.30 h."
    ],
    "nl": [
      "Een ruime keuze aan boeken die regelmatig veranderen. Lezersclub, open voor iedereen, op de eerste vrijdag van de maand (behalve in uitzonderlijke omstandigheden) van 17.30 tot 19.30 uur."
    ]
