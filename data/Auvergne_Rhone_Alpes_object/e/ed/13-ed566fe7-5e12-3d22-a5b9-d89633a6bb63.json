  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf grenouilledefrance.com die erste Froschzucht Frankreichs. Unser Team ist bestrebt, Ihnen ein außergewöhnliches Geschmackserlebnis zu bieten, indem es Frösche von hoher Qualität für den menschlichen Verzehr herstellt."
    ],
    "en": [
      "Discover France's leading frog farm at grenouilledefrance.com. Our team strives to offer you an exceptional taste experience by producing high-quality frogs for human consumption."
    ],
    "it": [
      "Scoprite l'allevamento di rane leader in Francia su grenouilledefrance.com. Il nostro team si impegna per offrirvi un'esperienza di gusto eccezionale, producendo rane di alta qualità per il consumo umano."
    ],
    "fr": [
      "Découvrez le premier élevage de grenouilles de France sur grenouilledefrance.com. Notre équipe s'efforce de vous offrir une expérience gustative exceptionnelle en produisant des grenouilles de grande qualité pour la consommation humaine."
    ],
    "nl": [
      "Ontdek de eerste kikkerboerderij in Frankrijk op grenouilledefrance.com. Ons team streeft ernaar om u een uitzonderlijke smaakervaring te bieden door hoogwaardige kikkers te produceren voor menselijke consumptie."
    ],
    "es": [
      "Descubra la primera granja de ranas de Francia en grenouilledefrance.com. Nuestro equipo se esfuerza por ofrecerle una experiencia gustativa excepcional mediante la producción de ranas de alta calidad para el consumo humano."
    ]
  },
  "rdfs:label": {
