  "rdfs:comment": {
    "de": [
      "Das für alle zugängliche Slalomstadion Desdames befindet sich am unteren Ende des Skigebiets Super-Besse und wird durch zahlreiche offizielle Wettkämpfe (FFS, UNSS) belebt."
    ],
    "en": [
      "Accessible to all, the Desdames slalom stadium is located at the bottom of the Super-Besse ski resort and is the venue for numerous official competitions (FFS, UNSS)."
    ],
    "it": [
      "Accessibile a tutti, lo stadio di slalom Desdames si trova in fondo alla stazione sciistica di Super-Besse e ospita numerose competizioni ufficiali (FFS, UNSS)."
    ],
    "fr": [
      "Accessible à tous, le stade de slalom Desdames est situé sur le bas de la station de ski de Super-Besse et animé par de nombreuses compétitions officielles (FFS, UNSS)."
    ],
    "nl": [
      "Het slalomstadion Desdames, dat toegankelijk is voor iedereen, ligt aan de voet van het skigebied Super-Besse en is gastheer van talrijke officiële wedstrijden (FFS, UNSS)."
    ],
    "es": [
      "Accesible a todos, el estadio de eslalon de Desdames está situado al pie de la estación de esquí de Super-Besse y acoge numerosas competiciones oficiales (FFS, UNSS)."
    ]
  },
  "rdfs:label": {
