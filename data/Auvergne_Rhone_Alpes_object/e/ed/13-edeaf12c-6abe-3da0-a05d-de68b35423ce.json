  "rdfs:comment": {
    "de": [
      "Besteht aus einem einzigen Kirchenschiff und einer gewölbten Apsis in polygonaler Form. Die Apsis steht über Berrichons, die man in der Drôme nur selten findet, mit dem Kirchenschiff in Verbindung."
    ],
    "en": [
      "Composed of a single nave and a polygonal vaulted apse. The apses communicate with the nave via Berrichons, rarely found in the Drôme."
    ],
    "it": [
      "Composta da un'unica navata e da un'abside a volta poligonale. Le absidi comunicano con la navata centrale attraverso dei berrichon, che si trovano raramente nella Drôme."
    ],
    "fr": [
      "Composé d'une nef unique et d'une abside voutée de forme polygonale. Les absidioles communiquent avec la nef par l'intermédiaire de Berrichons que l'on trouve rarement dans la Drôme."
    ],
    "es": [
      "Compuesta por una sola nave y un ábside con bóveda poligonal. Los ábsides se comunican con la nave a través de Berrichons, que raramente se encuentran en la Drôme."
    ],
    "nl": [
      "Bestaande uit een enkel schip en een veelhoekige gewelfde apsis. De absiden staan in verbinding met het schip via Berrichons, die zelden voorkomen in de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Marcel"
    ]
  },
