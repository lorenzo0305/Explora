  "rdfs:comment": {
    "de": [
      "An den bewaldeten, mediterran anmutenden Hängen des Mont St. Michel können Sie zu jeder Jahreszeit von dieser Einführung in den Orientierungslauf profitieren. Gehen Sie, laufen Sie, fordern Sie sich heraus, um die 13 Markierungen in Rekordzeit zu erreichen."
    ],
    "en": [
      "On the Mediterranean-style wooded slopes of Mont St Michel, enjoy this all-season introduction to orienteering. Walk, run, challenge yourself to reach the 13 markers in record time."
    ],
    "it": [
      "Sulle pendici boscose in stile mediterraneo di Mont St Michel, godetevi questa introduzione all'orienteering in tutte le stagioni. Camminate, correte, sfidate voi stessi a raggiungere i 13 punti di riferimento a tempo di record."
    ],
    "fr": [
      "Sur le versant boisé aux allures méditerranéennes du Mont St Michel, profitez en toute saison de cette initiation à la course d'orientation. Marchez, courez challengez vous pour rallier les 13 balises en un temps record."
    ],
    "nl": [
      "Geniet op de beboste hellingen van de Mont St Michel in mediterrane stijl van deze kennismaking met oriëntatielopen in alle seizoenen. Wandel, ren, daag jezelf uit om de 13 markeringen in een recordtijd te bereiken."
    ],
    "es": [
      "En las laderas arboladas de estilo mediterráneo del Mont St Michel, disfrute de esta iniciación a la orientación en todas las estaciones. Camina, corre, desafíate a ti mismo para alcanzar las 13 balizas en un tiempo récord."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation rando trail Challes-les -Eaux"
    ]
  },
