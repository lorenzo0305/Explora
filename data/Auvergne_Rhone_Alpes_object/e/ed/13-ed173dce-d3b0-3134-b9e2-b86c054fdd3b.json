  "rdfs:comment": {
    "de": [
      "Das 2008 als \"Bester Gästetisch Frankreichs\" ausgezeichnete Le Prieuré des Sources wird Ihren Gaumen vom Amuse bouche bis zum Kaffee begeistern! Jean-Jacques wird Ihnen feine Gerichte zaubern..."
    ],
    "en": [
      "\"Best Table d'Hôtes de France\" in 2008, the Prieuré des Sources will delight your taste buds from amuse bouche to coffee! Jean-Jacques will concoct fine dishes..."
    ],
    "it": [
      "\"Migliore Table d'Hôtes de France\" nel 2008, il Prieuré des Sources delizierà le vostre papille gustative dall'amuse bouche al caffè! Jean-Jacques preparerà per voi piatti raffinati..."
    ],
    "fr": [
      "\"Meilleure Table d'Hôtes de France\" en 2008, le Prieuré des Sources saura ravir vos papilles de l'amuse bouche au café ! Jean-Jacques vous concoctera des mets fins..."
    ],
    "es": [
      "\"El Prieuré des Sources, galardonado con el premio a la mejor mesa de huéspedes de Francia en 2008, hará las delicias de sus papilas gustativas, desde el aperitivo hasta el café Jean-Jacques le preparará platos finos..."
    ],
    "nl": [
      "Bekroond tot \"Beste Table d'Hôtes de France\" in 2008, zal de Prieuré des Sources je smaakpapillen verrukken van amuse tot koffie! Jean-Jacques bereidt voor jou de fijnste gerechten..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Prieuré des Sources"
    ]
  },
