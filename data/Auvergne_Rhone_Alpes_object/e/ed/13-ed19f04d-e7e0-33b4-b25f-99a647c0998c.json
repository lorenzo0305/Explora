  "rdfs:comment": {
    "de": [
      "Im Rahmen der nationalen Woche der frühen Kindheit wird ein Vortrag mit Diskussion von M. Forestier, Physiotherapeutin und Ausbilderin, zum Thema \"Vor und nach dem Laufen\" angeboten."
    ],
    "en": [
      "As part of National Early Childhood Week, M. Forestier, physiotherapist and trainer, will give a talk on the theme of before and after walking."
    ],
    "it": [
      "Nell'ambito della Settimana nazionale dell'infanzia, M. Forestier, fisioterapista e formatore, terrà una conferenza e un dibattito sul tema del prima e dopo la camminata."
    ],
    "fr": [
      "Dans le cadre de la semaine nationale de la petite enfance, une conférence-débat est proposée par M. Forestier, kinésithérapeute et formatrice, sur le thème de l'avant et après la marche."
    ],
    "es": [
      "En el marco de la Semana Nacional de la Puericultura, M. Forestier, fisioterapeuta y formadora, ofrecerá una charla y un debate sobre el tema de antes y después de caminar."
    ],
    "nl": [
      "Als onderdeel van de Nationale Week van de Kinderopvang geeft M. Forestier, fysiotherapeut en trainer, een lezing en debat over het onderwerp voor en na het wandelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence Du déséquilibre à l'équilibre - Semaine nationale de la petite enfance"
    ]
  },
