  "rdfs:comment": {
    "de": [
      "Restaurant und Bar Lounge Savoyard, eine raffinierte Küche, in einem warmen und einladenden Ort.\r\nEin tolles Lokal mit einer Dekoration, die es zu entdecken gilt, ein Ort, an dem man angenehme festliche oder sonstige Momente mit der Familie oder mit Freunden verbringen kann."
    ],
    "en": [
      "Savoyard restaurant and lounge bar, refined cuisine in a warm and welcoming setting.\r\nA superb establishment with décor worth discovering, a place to enjoy pleasant moments, festive or otherwise, with family or friends."
    ],
    "it": [
      "Ristorante e bar lounge in stile savoiardo, cucina raffinata, in un ambiente caldo e accogliente.\r\nUn locale fantastico con un arredamento tutto da scoprire, un posto dove trascorrere piacevoli momenti festivi o meno, in famiglia o con gli amici."
    ],
    "fr": [
      "Restaurant et Bar lounge savoyard , une cuisine raffinée , dans un endroit chaleureux et accueillant.\r\nUn super établissement avec une décoration à découvrir, un endroit où passer d’agréables moments festifs ou non, en famille ou entre amis."
    ],
    "es": [
      "Restaurante y lounge bar saboyano, cocina refinada en un marco cálido y acogedor.\r\nUn gran establecimiento con una decoración digna de descubrir, un lugar para pasar agradables momentos, festivos o no, en familia o entre amigos."
    ],
    "nl": [
      "Restaurant en lounge bar in Savoyaardse stijl, verfijnde keuken, in een gezellige en gastvrije omgeving.\r\nEen geweldige plek met een bijzondere inrichting, waar u met familie of vrienden kunt genieten van gezellige momenten, al dan niet feestelijk."
    ]
  },
