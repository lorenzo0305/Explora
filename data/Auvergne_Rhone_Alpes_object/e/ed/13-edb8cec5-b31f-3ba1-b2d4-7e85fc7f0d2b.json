  "rdfs:comment": {
    "de": [
      "La Table du Campagnard, das mit dem Gütesiegel Maître Restaurateur ausgezeichnet ist, empfängt Sie in einem außergewöhnlichen Rahmen mit einer großen Terrasse am Seeufer zu einer geselligen Gourmet-Pause."
    ],
    "en": [
      "Discover our Restaurant-Glacier-Bar Lounge, and in fine weather enjoy our terraces for a meal on your own, as a couple, with family or friends, savor an ice cream for a gourmet break or sip a cocktail on the shores of Lake Monteynard."
    ],
    "it": [
      "La Table du Campagnard, insignita del marchio Maître Restaurateur, vi accoglie in un ambiente eccezionale, con un'ampia terrazza sul lago, per una pausa gastronomica e conviviale."
    ],
    "fr": [
      "La Table du Campagnard, labellisée Maître Restaurateur, vous accueille dans un cadre d'exception avec une grande terrasse au bord du lac, pour une parenthèse gourmande et conviviale."
    ],
    "es": [
      "La Table du Campagnard, galardonada con el sello Maître Restaurateur, le acoge en un marco excepcional, con una gran terraza a orillas del lago, para una pausa gastronómica y de convivencia."
    ],
    "nl": [
      "La Table du Campagnard, bekroond met het label Maître Restaurateur, verwelkomt je in een uitzonderlijke omgeving, met een groot terras aan het meer, voor een gastronomische en gezellige pauze."
    ]
  },
