  "rdfs:comment": {
    "de": [
      "Entdecken Sie, warum die Vögel singen!\r\nBiplace-Flüge das ganze Jahr über in Chamonix mit diplomierten, professionellen und erfahrenen Fluglehrern, die über 30 Jahre Erfahrung verfügen.\r\nCertificate of Excellence Trip Advisor. 2013,14,15,16,17,19,20."
    ],
    "en": [
      "Discover why birds sing!\r\nTandem flights all year round in Chamonix with qualified, professional, experienced instructors, 30 years of experience.\r\nCertificate Excellence Trip Advisor. 2013,14,15,16,17,19,20."
    ],
    "it": [
      "Scoprite perché gli uccelli cantano!\r\nVoli tandem tutto l'anno a Chamonix con istruttori qualificati, professionali ed esperti con 30 anni di esperienza.\r\nCertificato di eccellenza Trip Advisor. 2013,14,15,16,17,19,20."
    ],
    "fr": [
      "Découvrir pourquoi les oiseaux chantent!\nVols Biplace toute l'année sur Chamonix avec moniteur diplômés, professionel, expérimentés, 30 ans d'experience.\nCertificate Excellence Trip Advisor. 2013,14,15,16,17,19,20."
    ],
    "es": [
      "¡Descubra por qué cantan los pájaros!\r\nVuelos en tándem todo el año en Chamonix con instructores cualificados, profesionales y con 30 años de experiencia.\r\nCertificado de Excelencia Trip Advisor. 2013,14,15,16,17,19,20."
    ],
    "nl": [
      "Ontdek waarom vogels zingen!\nTandemvluchten het hele jaar door in Chamonix met gekwalificeerde, professionele en ervaren instructeurs met 30 jaar ervaring.\nCertificaat van uitmuntendheid Trip Advisor. 2013,14,15,16,17,19,20."
    ]
  },
