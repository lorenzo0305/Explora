  "rdfs:comment": {
    "de": [
      "In der Nähe der Bergarbeitersiedlungen, ideal für Anfänger, Groß und Klein.\r\nDer Standort ist angenehm (ehemaliger Steinbruch) und ermöglicht das Klettern mit der ganzen Familie. Eine Plattform am Fuße der Routen ermöglicht ein Picknick."
    ],
    "en": [
      "A pretty spot (fromer quarrier) allowing to climb with family. You can have a picnic at the bottom of the routes."
    ],
    "it": [
      "Vivino alle città minieri, idela per i novici, piccoli o grandi.\r\nIl sito è piacevole (vecchia carriera) e permette un' arrampicata in famiglia. Una piattaforma al piede delle vie vi permette da pranzare tipo picnic."
    ],
    "fr": [
      "A proximité des cités minières, idéal pour les débutants, petits et grands. \r\nLe site est agréable (ancienne carrière) et permet une escalade en famille. Une plate-forme au pied des voies permet de pique-niquer."
    ],
    "nl": [
      "Een klimgebied in oude steenmijn. Een platvorm aan de voet van de klimwegen maakt u het mogelijk te picknicken ideel om te klimmen met de hele familie"
    ],
    "es": [
      "Cerca de las ciudades mineras, ideal para principiantes, jóvenes y mayores.\r\nEl emplazamiento es agradable (antigua cantera) y permite la escalada en familia. Una plataforma al pie de las rutas permite hacer un picnic."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing spot of Villaret"
    ],
    "it": [
      "Sito arrampicata del Villaret"
    ],
    "fr": [
      "Site d’escalade du Villaret"
    ],
    "nl": [
      "Sportklimgebied \"Villaret\""
    ]
  },
