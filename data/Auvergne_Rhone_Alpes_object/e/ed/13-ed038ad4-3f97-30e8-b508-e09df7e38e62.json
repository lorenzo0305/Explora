  "rdfs:comment": {
    "de": [
      "Für einen gelungenen Familienurlaub entdecken Sie unsere Spaziergänge mit dem Kinderwagen in Buis les Baronnies.\r\n2 mögliche Rundgänge: 1,8 km - 23 Minuten oder 1,3 km - 15 Minuten."
    ],
    "en": [
      "To enjoy your family vacation, discover our friendly walks with a stroller around Buis les Baronnies. \r\nThere are two short routes possible : 1,8km - 23 minutes or 1,3km - 15 minutes."
    ],
    "it": [
      "Per una vacanza in famiglia, scoprite le nostre passeggiate per passeggini a Buis les Baronnies.\r\n2 percorsi possibili: 1,8 km - 23 minuti o 1,3 km - 15 minuti."
    ],
    "fr": [
      "Pour des vacances en famille réussies, découvrez nos balades en poussette à Buis les Baronnies.\r\n2 circuits possibles : 1,8km - 23 minutes ou 1,3km - 15 minutes."
    ],
    "es": [
      "Para unas vacaciones en familia, descubra nuestros paseos en cochecito en Buis les Baronnies.\r\n2 recorridos posibles: 1,8 km - 23 minutos o 1,3 km - 15 minutos."
    ],
    "nl": [
      "Ontdek voor een geweldige gezinsvakantie onze kinderwagenwandelingen in Buis les Baronnies.\r\n2 mogelijke routes: 1,8 km - 23 minuten of 1,3 km - 15 minuten."
    ]
  },
  "rdfs:label": {
    "en": [
