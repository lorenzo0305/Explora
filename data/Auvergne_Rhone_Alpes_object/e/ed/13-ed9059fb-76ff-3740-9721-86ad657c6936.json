  "rdfs:comment": {
    "de": [
      "Unser Restaurant bietet traditionelle und regionale Küche in ruhiger Lage auf dem Land in einem Bauernhof. Um Ihre Mahlzeit angenehm abzurunden, bieten wir hausgemachte Backwaren an."
    ],
    "en": [
      "Our restaurant offers traditional and regional cuisine, in the quiet countryside of a farmhouse. To round off your meal, we offer home-made pastries."
    ],
    "it": [
      "Il nostro ristorante offre una cucina tradizionale e regionale, nella pace e nella tranquillità di una casa colonica in campagna. Per concludere il pasto, offriamo dolci fatti in casa."
    ],
    "fr": [
      "Notre restaurant propose une cuisine traditionnelle et régionale, au calme à la campagne dans une ferme. Pour achever agréablement votre repas, nous proposons des pâtisseries fabriquées maison."
    ],
    "nl": [
      "Ons restaurant biedt traditionele, regionale gerechten, in de rust van een boerderij op het platteland. Om je maaltijd af te ronden bieden we huisgemaakt gebak."
    ],
    "es": [
      "Nuestro restaurante ofrece cocina tradicional y regional, en la tranquilidad de una granja en el campo. Para redondear su comida, le ofrecemos repostería casera."
    ]
  },
