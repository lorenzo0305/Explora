      "@id": "https://data.datatourisme.fr/b912058c-514d-3401-983f-5c3cb149dc27",
      "dc:description": {
        "de": [
          "Wein-, Bier- und Spirituosenkeller, der auf Bio-, biodynamische und Naturweine spezialisiert ist.\n+ 300 Referenzen an Spirituosen\nVerkostungsworkshops, Afterworks"
        ],
        "en": [
          "Wine, beer and spirits cellar specializing in organic, biodynamic and natural wines.\n+ More than 300 references in spirits\nTasting workshops, afterworks"
        ],
        "it": [
          "Cantina di vini, birre e liquori specializzata in vini biologici, biodinamici e naturali.\n+ Oltre 300 referenze di liquori\nLaboratori di degustazione, afterworks"
        ],
        "fr": [
          "Cave à vins, bières et spiritueux spécialisé dans les vins bio, biodynamie et nature.\n+ de 300 références en spiritueux\nAtelier de dégustation, afterworks"
        ],
        "nl": [
          "Wijn-, bier- en distilleerkelder gespecialiseerd in biologische, biodynamische en natuurlijke wijnen.\n+ Meer dan 300 referenties in gedistilleerde dranken\nProeverij workshops, afterworks"
        ],
        "es": [
          "Bodega de vinos, cervezas y licores especializada en vinos ecológicos, biodinámicos y naturales.\n+ Más de 300 referencias en espirituosos\nTalleres de degustación, afterworks"
        ]
      },
