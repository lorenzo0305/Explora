  "rdfs:comment": {
    "de": [
      "In St-Jean-St-Maurice-sur-Loire braut sich etwas zusammen!\r\nJedes Jahr wird in dem Dorf ein Fest veranstaltet, bei dem viele Kunsthandwerker geehrt werden."
    ],
    "en": [
      "Something is going on in St-Jean-St-Maurice-sur-Loire!\r\nEach year in the village, a festival is organized, honoring many craftsmen."
    ],
    "it": [
      "A St-Jean-St-Maurice-sur-Loire sta succedendo qualcosa!\r\nOgni anno nel villaggio viene organizzato un festival che rende omaggio a numerosi artigiani d'arte."
    ],
    "fr": [
      "Quelque chose se prépare à St-Jean-St-Maurice-sur-Loire !\r\nChaque année dans le village, une fête est organisée, mettant à l'honneur de nombreux artisans d'art."
    ],
    "es": [
      "¡Algo pasa en St-Jean-St-Maurice-sur-Loire!\r\nTodos los años se organiza en el pueblo un festival en honor a numerosos artesanos."
    ],
    "nl": [
      "Er is iets gaande in St-Jean-St-Maurice-sur-Loire!\r\nElk jaar wordt in het dorp een festival georganiseerd ter ere van talrijke kunstambachtslieden."
    ]
  },
