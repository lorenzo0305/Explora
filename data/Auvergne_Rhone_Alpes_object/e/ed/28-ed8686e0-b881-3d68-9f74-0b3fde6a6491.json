  "rdfs:comment": {
    "de": [
      "Jules-François Lombart, ein Schokoladenfabrikant am Ende des 19. Jahrhunderts, der auch ein großer Kunstliebhaber war, ließ dieses Museum errichten, um das Andenken an seine aus Doullens stammenden Eltern zu ehren."
    ],
    "en": [
      "Jules-François Lombart, a chocolate industrialist at the end of the 19th century, but also a great lover of art, had this museum built to honour the memory of his parents who were born in Doullens."
    ],
    "it": [
      "Jules-François Lombart, industriale cioccolatiere alla fine del XIX secolo, ma anche grande appassionato d'arte, fece costruire questo museo per onorare la memoria dei suoi genitori nati a Doullens."
    ],
    "fr": [
      "Jules-François Lombart, industriel chocolatier à la fin du XIXe siècle, mais aussi grand amateur d’art, fit construire ce musée afin d'honorer la mémoire de ses parents natifs de Doullens."
    ],
    "es": [
      "Jules-François Lombart, industrial chocolatero de finales del siglo XIX, pero también gran amante del arte, hizo construir este museo para honrar la memoria de sus padres, nacidos en Doullens."
    ],
    "nl": [
      "Jules-François Lombart, een industriële chocolatier aan het eind van de 19e eeuw, maar ook een groot liefhebber van kunst, liet dit museum bouwen ter nagedachtenis aan zijn ouders die in Doullens waren geboren."
    ]
  },
