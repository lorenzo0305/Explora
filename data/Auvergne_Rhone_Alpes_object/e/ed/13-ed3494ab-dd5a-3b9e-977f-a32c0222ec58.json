  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen mehr als 4000 Bücher (Romane, Literaturpreise, Comics, Alben, Zeitschriften...). Sie kauft regelmäßig literarische Neuheiten und Anfragen von Lesern. Sie beherbergt regelmäßig temporäre Ausstellungen."
    ],
    "en": [
      "The library offers over 4,000 books (novels, literary prizes, comics, albums, magazines...). It regularly purchases new literary releases and reader requests. It regularly hosts temporary exhibitions."
    ],
    "it": [
      "Mediateca con oltre 900 DVD, CD audio e giochi. Connessioni informatiche a pagamento e stampa a pagamento. Wi-Fi e scansione gratuiti. Oltre 4.000 libri (romanzi, premi letterari, fumetti, album, riviste, ecc.). Mostre temporanee."
    ],
    "fr": [
      "La bibliothèque vous propose plus de 4000 livres (romans, prix littéraires, BD, albums, magazines...). Elle achète régulierement des nouveautés littéraires, et des demandes des lecteurs. Elle accueille régulièrement des expositions temporaires."
    ],
    "es": [
      "La biblioteca ofrece más de 4.000 libros (novelas, premios literarios, cómics, álbumes, revistas, etc.). Adquiere regularmente libros nuevos y libros solicitados por los lectores. Acoge regularmente exposiciones temporales."
    ],
    "nl": [
      "De bibliotheek biedt meer dan 4.000 boeken (romans, literaire prijzen, strips, albums, tijdschriften, enz.) Ze koopt regelmatig nieuwe boeken en boeken op verzoek van lezers. Er zijn regelmatig tijdelijke tentoonstellingen."
    ]
  },
