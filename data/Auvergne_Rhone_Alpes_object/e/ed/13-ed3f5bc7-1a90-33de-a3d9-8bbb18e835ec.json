  "rdfs:comment": {
    "de": [
      "Landry ist Lehrer für Klettern, Via Ferrata und Canyoning. Nach Absprache bringt er Sie an Orten, die sich für diese Aktivitäten eignen, in die Höhe: die Schluchten des Cher (Lignerolles-Saint-Genest), die Schluchten der Sioule, die Berge von Bourbonnaise..."
    ],
    "en": [
      "Landry is a climbing, via ferrata and canyoning instructor. By appointment, he will take you up to sites suitable for these activities: gorges du Cher (Lignerolles-Saint-Genest), gorges de la Sioule, montagne bourbonnaise..."
    ],
    "it": [
      "Landry è istruttore di arrampicata, via ferrata e canyoning. Su appuntamento, vi accompagnerà nei siti adatti a queste attività: le gole dello Cher (Lignerolles-Saint-Genest), le gole della Sioule, le montagne della Bourbonnaise, ecc."
    ],
    "fr": [
      "Landry est moniteur d'escalade, de via ferrata et de canyoning. Sur rendez-vous, il vous fera prendre de la hauteur sur des sites propices à ces activités : gorges du Cher (Lignerolles-Saint-Genest), gorges de la Sioule, montagne bourbonnaise..."
    ],
    "nl": [
      "Landry is een klim, via ferrata en canyoning instructeur. Op afspraak neemt hij u mee naar locaties die geschikt zijn voor deze activiteiten: de kloven van de Cher (Lignerolles-Saint-Genest), de kloven van Sioule, de bergen van Bourbonnaise, enz."
    ],
    "es": [
      "Landry es instructor de escalada, vía ferrata y barranquismo. Con cita previa, le llevará a sitios adecuados para estas actividades: las gargantas del Cher (Lignerolles-Saint-Genest), las gargantas de la Sioule, las montañas de la Bourbonnaise, etc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escale verticale : Moniteur d'escalade, via ferrata, canyoning"
    ]
  },
