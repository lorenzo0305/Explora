  "rdfs:comment": {
    "de": [
      "Renaud: Kunsthandwerker für Einrahmungen\r\nHandwerkliche Herstellung\r\nAuswahl von hochwertigem Holz\r\nAufwertung von alten Rahmen\r\nKonservierung im Mittelpunkt unseres Vorgehens\r\nNeutrale und nachhaltige Materialien\r\nGläser mit hohem Schutzfaktor\r\nAuf Stabilität ausgelegte Oberflächen"
    ],
    "en": [
      "Renaud : Artisan framer\r\nHandcrafted products\r\nSelection of quality wood\r\nUpgrading old frames\r\nConservation at the heart of our approach\r\nNeutral, durable materials\r\nHighly protective glass\r\nFinishes designed for stability"
    ],
    "it": [
      "Renaud : Artigiano corniciaio\r\nFabbricazione artigianale\r\nSelezione di legni di qualità\r\nRiqualificazione di vecchie cornici\r\nLa conservazione al centro del nostro approccio\r\nMateriali neutri e durevoli\r\nVetro ad alta protezione\r\nFiniture studiate per la stabilità"
    ],
    "fr": [
      "Renaud : Artisan encadreur\r\nFabrication artisanale\r\nSélection de bois de qualité\r\nValorisation d'anciens cadres\r\nLa conservation au coeur de notre démarche\r\nDes matériaux neutres et durables\r\nVerres de haute protection\r\nDes finitions pensées pour la stabilité"
    ],
    "es": [
      "Renaud : Artesano enmarcador\r\nFabricación artesanal\r\nSelección de madera de calidad\r\nModernización de marcos antiguos\r\nLa conservación en el centro de nuestro enfoque\r\nMateriales neutros y duraderos\r\nCristales de alta protección\r\nAcabados diseñados para la estabilidad"
    ],
    "nl": [
      "Renaud : Ambachtelijke lijstenmaker\r\nAmbachtelijke vervaardiging\r\nSelectie van kwaliteitshout\r\nOude lijsten opwaarderen\r\nBehoud in het hart van onze aanpak\r\nNeutrale en duurzame materialen\r\nHoog beschermend glas\r\nAfwerkingen ontworpen voor stabiliteit"
    ]
  },
