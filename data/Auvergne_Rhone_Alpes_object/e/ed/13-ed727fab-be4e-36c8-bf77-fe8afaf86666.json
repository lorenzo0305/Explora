  "rdfs:comment": {
    "de": [
      "Kutschfahrten (1h/2h) oder APERO'CALECHE oder Entdeckung des Gespanns und des Tierzugs.\r\nStart im Dorf Venterol. Uhrzeit und Treffpunkt werden gemeinsam vereinbart.\r\nKapazität: 4-5 Pers. (nur auf Reservierung / Haustiere erlaubt)."
    ],
    "en": [
      "Carriage rides (1h or 2h) harnessed to Brune, mare Comtoise, with Yann  (National Haras degree coach driver)\r\nMeeting point at Venterol town hall.\r\nCapacity: 4-5 people (only by reservation)."
    ],
    "it": [
      "Gite in carrozza (1h/2h) o APERO'CALECHE o Scoperta della carrozza a cavalli e della trazione animale.\r\nPartenza dal villaggio di Venterol. L'ora e il luogo dell'incontro devono essere concordati insieme\r\nCapacità: 4-5 persone (solo su prenotazione / si accettano animali)."
    ],
    "fr": [
      "Balades en calèche (1h/2h) ou APERO'CALECHE ou Découverte de l'attelage et traction animale.\r\nDépart du village Venterol. Horaires et lieu de RDV à convenir ensemble. \r\nCapacité : 4-5  pers (sur réservation uniquement / animaux acceptés)."
    ],
    "nl": [
      "Ritjes met paard en wagen  (1 tot 2 uur) ingespannen met het trekpaard Brune, gemend door Yann (diploma van Harras Nationaux). \r\nVertrek vanuit stadhuis\r\nCapaciteit: 4/5 personen (alleen met reservering)."
    ],
    "es": [
      "Paseos en coche de caballos (1h/2h) o APERO'CALECHE o Descubrimiento del coche de caballos y de la tracción animal.\r\nSalida del pueblo de Venterol. La hora y el lugar de la reunión se acordarán conjuntamente\r\nCapacidad: 4-5 personas (sólo con reserva / se aceptan animales)."
    ]
  },
