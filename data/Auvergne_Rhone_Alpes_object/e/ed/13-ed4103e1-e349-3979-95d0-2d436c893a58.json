  "rdfs:comment": {
    "de": [
      "Unternehmen, das sich auf die Sammlung von Getreide spezialisiert hat. Das Unternehmen bietet außerdem verschiedene Dienstleistungen wie landwirtschaftliche Versorgung sowie den Handel mit Pflanzenschutzmitteln und Fungiziden an."
    ],
    "en": [
      "Company specialized in cereal collection. The company also offers a range of services including agricultural supplies, as well as trading in crop protection products and fungicides."
    ],
    "it": [
      "Azienda specializzata nella raccolta di cereali. L'azienda offre anche una serie di altri servizi, tra cui forniture agricole e commercio di prodotti fitosanitari e fungicidi."
    ],
    "fr": [
      "Entreprise spécialisée dans le domaine de la collecte de céréales. La société propose également divers services tels que l'approvisionnement agricoles ainsi que le négoce de produits phytosanitaires et de fongicides."
    ],
    "es": [
      "Empresa especializada en la recolección de cereales. La empresa también ofrece otros servicios, como suministros agrícolas y comercio de productos fitosanitarios y fungicidas."
    ],
    "nl": [
      "Bedrijf gespecialiseerd in de inzameling van granen. Het bedrijf biedt ook een reeks andere diensten aan, waaronder landbouwbenodigdheden en handel in gewasbeschermingsmiddelen en fungiciden."
    ]
  },
