  "rdfs:comment": {
    "de": [
      "Der Wibit ist eine Wassersportart par excellence. Er ist ein schwimmender Hindernisparcours auf dem Wasser, der aus etwa 20 aufblasbaren Modulen besteht. Stürzen Sie sich auf Trampoline, Rutschen, Kletterwände, Balken und Brücken, die mit Schwimmwesten ausgestattet sind."
    ],
    "en": [
      "An aquatic activity par excellence, the Wibit is a floating obstacle course on water, made up of some twenty inflatable modules. Throw yourself onto the trampolines, slides, climbing wall, beams and bridges, equipped with life jackets."
    ],
    "it": [
      "Attività acquatica per eccellenza, il Wibit è un percorso a ostacoli galleggiante sull'acqua, composto da una ventina di moduli gonfiabili. Mettetevi alla prova su trampolini, scivoli, pareti da arrampicata, travi e ponti, tutti dotati di giubbotti di salvataggio."
    ],
    "fr": [
      "Activité aqualudique par excellence, le Wibit est un parcours d’obstacles flottants sur l’eau, composé d’une vingtaine de modules gonflables. Lancez-vous sur les trampolines, toboggans, mur d’escalade, poutres et ponts, équipés de gilets de sauvetage."
    ],
    "nl": [
      "De Wibit, een wateractiviteit bij uitstek, is een drijvende hindernisbaan op het water, bestaande uit ongeveer twintig opblaasbare modules. Probeer het op de trampolines, glijbanen, klimmuur, balken en bruggen, allemaal voorzien van zwemvesten."
    ],
    "es": [
      "Actividad acuática por excelencia, el Wibit es una carrera de obstáculos flotante sobre el agua, compuesta por una veintena de módulos hinchables. Pruebe suerte en los trampolines, toboganes, rocódromo, vigas y puentes, todos equipados con chalecos salvavidas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Wibit water park"
    ],
    "fr": [
      "Parc aquatique Wibit"
    ]
  },
