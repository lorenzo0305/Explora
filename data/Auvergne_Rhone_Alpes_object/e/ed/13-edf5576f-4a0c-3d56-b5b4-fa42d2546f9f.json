  "rdfs:comment": {
    "de": [
      "Gegründet im Jahre 1928 in dem Haus, in dem André-Marie Ampère (1775-1836) seine Jugend verbrachte. Es enthält Dokumente über sein Leben und das seiner Familie sowie eine bedeutsame Sammlung aller Objekte, die mit der Erfindung der Elektrizität und ihre Geschichte zusammenhängen."
    ],
    "en": [
      "French scientist André-Marie Ampère (1775-1836) spent his youth on his family's estate 10 miles northwest of Lyon. His mansion now houses the Museum of Electricity."
    ],
    "it": [
      "Il Museo fu creato nel 1928 nella casa in cui André-Marie Ampère (1775-1836) trascorse la giovinezza. Contiene documenti sulla sua vita e su quella della sua famiglia ed anche una vasta collezione di tutti gli oggetti collegati all'invenzione dell'elettricità e alla sua storia."
    ],
    "fr": [
      "Créé en 1928 dans la maison où André-Marie Ampère (1775-1836) passa sa jeunesse. Il regroupe des documents sur sa vie et celle de sa famille ainsi qu'une importante collection de tous objets ayant rapport à l'invention de l'électricité et son histoire."
    ],
    "nl": [
      "Opgericht in 1928 in het huis waar André-Marie Ampère (1775-1836) zijn jeugd doorbracht. Het bevat documenten over zijn leven en dat van zijn familie, alsmede een belangrijke verzameling voorwerpen met betrekking tot de uitvinding van de elektriciteit en de geschiedenis ervan."
    ],
    "es": [
      "Creada en 1928 en la casa donde André-Marie Ampère (1775-1836) pasó su juventud. Reúne documentos sobre su vida y la de su familia, así como una importante colección de todo tipo de objetos relacionados con la invención de la electricidad y su historia."
    ]
  },
  "rdfs:label": {
    "de": [
      "Maison d'Ampère - das Elektrizitätsmuseum"
    ],
    "en": [
