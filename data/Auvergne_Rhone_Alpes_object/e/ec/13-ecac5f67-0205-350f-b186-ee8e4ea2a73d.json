  "rdfs:comment": {
    "de": [
      "Verkauf von Produkten aus der Auvergne und von Käse: AOP Cantal, Salers, Bleu d'Auvergne, Saint-Nectaire. Wurstwaren: Schinken, Salami und Trockenwurst aus eigener Herstellung."
    ],
    "en": [
      "Sale of Auvergne products and cheeses: AOP Cantal, Salers, Bleu d'Auvergne, Saint-Nectaire. Charcuterie: home-produced ham, sausages and dry sausages."
    ],
    "it": [
      "Vendita di prodotti e formaggi d'Alvernia: AOP Cantal, Salers, Bleu d'Auvergne, Saint-Nectaire. Salumeria: prosciutto, salsicce e salami secchi di produzione propria."
    ],
    "fr": [
      "Vente de produits d'Auvergne et de fromages : AOP Cantal, Salers, bleu d'Auvergne,  Saint-Nectaire. Charcuterie : jambon, saucissons et saucisses sèches, en production maison."
    ],
    "nl": [
      "Verkoop van producten en kazen uit de Auvergne: AOP Cantal, Salers, Bleu d'Auvergne, Saint-Nectaire. Charcuterie: huisgemaakte ham, worst en droge worst."
    ],
    "es": [
      "Venta de productos y quesos de Auvernia: AOP Cantal, Salers, Bleu d'Auvergne, Saint-Nectaire. Charcutería: jamón, salchichas y embutidos secos de producción propia."
    ]
