  "rdfs:comment": {
    "de": [
      "Der Salle des Marinières bietet das ganze Jahr über ein reichhaltiges Kulturprogramm. Mit Konzerten, Aufführungen, Stand-Ups und anderen Veranstaltungen ist für jeden Geschmack etwas dabei!"
    ],
    "en": [
      "The Salle des Marinières offers a rich cultural program all year round. With concerts, shows, stand-ups and more, there's something for everyone!"
    ],
    "it": [
      "La Salle des Marinières offre un ricco programma culturale tutto l'anno. Con concerti, spettacoli, stand-up e altro ancora, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "La salle des Marinières propose toute l'année une programmation culturelle riche. Avec des concerts, spectacles, stands up et autres, il y en a pour tous les goûts !"
    ],
    "es": [
      "La Salle des Marinières ofrece un rico programa cultural durante todo el año. Con conciertos, espectáculos, stand-ups y mucho más, ¡hay para todos los gustos!"
    ],
    "nl": [
      "De Salle des Marinières biedt het hele jaar door een rijk cultureel programma. Met concerten, shows, stand-ups en meer is er voor elk wat wils!"
    ]
  },
