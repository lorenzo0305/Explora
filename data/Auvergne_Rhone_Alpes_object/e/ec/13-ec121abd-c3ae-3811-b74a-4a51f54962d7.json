  "rdfs:comment": {
    "de": [
      "In einer herzlichen Atmosphäre bieten Ihnen Sabine und Yannick eine schmackhafte Küche sowie Spezialitäten aus Savoyen."
    ],
    "en": [
      "Traditional and Savoyard-style cooking served in warm, welcoming atmosphere.\r\nBanquets, weddings, family meals."
    ],
    "it": [
      "In un'atmosfera accogliente, Sabine e Yannick vi faranno scoprire una cucina gustosa e le specialità savoiarde."
    ],
    "fr": [
      "Dans une ambiance chaleureuse, Sabine et Yannick vous font découvrir une cuisine savoureuse ainsi que des spécialités savoyardes."
    ],
    "nl": [
      "In een warme sfeer zullen Sabine en Yannick u een smakelijke keuken en Savoyaardse specialiteiten laten ontdekken."
    ],
