  "rdfs:comment": {
    "de": [
      "Ich bin Lederhandwerkerin in La-Roche-sur-le-Buis.\r\nIch entwerfe und fertige Taschen, Täschchen, Etuis für Boulespielkugeln und aller Art, aber auch Geldbörsen und Brieftaschen aus Leder und Häuten."
    ],
    "en": [
      "I'm an artisan leatherworker in La-Roche-sur-le-Buis.\r\nI design and manufacture bags, pouches, petanque ball cases and all kinds of cases, as well as wallets and purses in leather and skins."
    ],
    "it": [
      "Sono un pellettiere di La-Roche-sur-le-Buis.\r\nCreo e produco borse, sacchetti, custodie per palline da pétanque e ogni altro genere di cose, ma anche portafogli e portamonete in pelle e cuoio."
    ],
    "fr": [
      "Je suis artisane maroquinière à La-Roche-sur-le-Buis.\r\nJe crée et fabrique des sacs, pochettes, étuis à boules de pétanque et en tout genre, mais aussi portes monnaie et portefeuilles en cuir et peaux."
    ],
    "es": [
      "Soy marroquinero en La-Roche-sur-le-Buis.\r\nCreo y fabrico bolsos, bolsas, fundas para pelotas de petanca y todo tipo de cosas, pero también carteras y monederos de cuero y pieles."
    ],
    "nl": [
      "Ik ben een ambachtelijke leerbewerker in La-Roche-sur-le-Buis.\r\nIk ontwerp en maak tassen, buidels, etuis voor petanqueballen en allerlei andere dingen, maar ook portemonnees en portefeuilles van leer en huiden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Libres Cuirs"
    ]
  },
