  "rdfs:comment": {
    "de": [
      "Die Reitschule Peillonnex liegt in der Haute-Savoie und bietet Kurse für alle Altersstufen und Niveaus, Praktika und Pferdepensionen an. Leidenschaft und Natur stehen im Mittelpunkt unserer Aktivitäten, mit einem Team, das bereit ist, seine Leidenschaft weiterzugeben."
    ],
    "en": [
      "The Peillonnex Riding School, nestling in the Haute-Savoie, offers lessons for all ages and levels, courses and horse boarding. Passion and nature are at the heart of our activities, with a team ready to pass on their passion."
    ],
    "it": [
      "La Scuola di Equitazione Peillonnex, immersa nell'Alta Savoia, offre lezioni per tutte le età e tutti i livelli, corsi e pensione per cavalli. Passione e natura sono al centro delle nostre attività, con un team pronto a trasmettere la propria passione."
    ],
    "fr": [
      "L'École d'Équitation de Peillonnex, nichée en Haute-Savoie, propose des cours pour tous les âges et niveaux, des stages, ainsi que des pensions pour chevaux. Passion et nature sont au cœur de nos activités, avec une équipe prête à transmettre sa passion."
    ],
    "es": [
      "La Escuela de Equitación Peillonnex, situada en la Alta Saboya, ofrece clases para todas las edades y niveles, cursos y pupilaje de caballos. La pasión y la naturaleza están en el centro de nuestras actividades, con un equipo dispuesto a transmitir su pasión."
    ],
    "nl": [
      "De Peillonnex Manege, genesteld in de Haute-Savoie, biedt lessen voor alle leeftijden en niveaus, cursussen en paardenpension. Passie en natuur staan centraal in onze activiteiten, met een team dat klaar staat om hun passie door te geven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Peillonex Riding School"
    ],
    "fr": [
      "Ecole d'équitation de Peillonnex"
    ]
  },
