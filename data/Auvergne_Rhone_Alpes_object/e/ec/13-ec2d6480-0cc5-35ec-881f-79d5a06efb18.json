  "rdfs:comment": {
    "de": [
      "Der Stadtstrand liegt in einer außergewöhnlichen Umgebung inmitten von Pinien und einem 2,5 Hektar großen Blumenpark am Ufer des Genfersees und ist ein einzigartiger Ort für Sport, Entspannung und Freizeit."
    ],
    "en": [
      "Three heated swimming pools, including a 50-metre Olympic pool, supervised swimming on the lake over an area of 3.000 m2, diving boards, water slide, pool for young children, swimming school and play area are all there for your leisure and sports days."
    ],
    "it": [
      "Situata in un contesto eccezionale, circondata da pini e da un parco fiorito di 2,5 ettari sulle rive del Lago di Ginevra, la Plage Municipale è uno spazio unico per lo sport, il relax e il tempo libero."
    ],
    "fr": [
      "Située dans un cadre exceptionnel au milieu des pins et d'un parc fleuri de 2,5 hectares en bordure du Léman, la Plage Municipale est un espace unique de sport, de détente et de loisirs."
    ],
    "es": [
      "Situada en un marco excepcional, rodeada de pinos y un parque florido de 2,5 hectáreas a orillas del lago Lemán, la Plage Municipale es un espacio único para el deporte, la relajación y el ocio."
    ],
    "nl": [
      "Gelegen in een uitzonderlijke omgeving, omringd door pijnbomen en een bloemrijk park van 2,5 hectare aan de oevers van het meer van Genève, is het Plage Municipale een unieke ruimte voor sport, ontspanning en vrije tijd."
    ]
  },
  "rdfs:label": {
    "en": [
