  "rdfs:comment": {
    "de": [
      "Trans-Alpes bietet Ihnen einen Ausflug nach Italien an. Der Tag steht Ihnen zur freien Verfügung, um den typischen Markt, das historische Zentrum mit seinen Einkaufsstraßen oder die Museen zu genießen..."
    ],
    "en": [
      "Trans-Alpes offers you an excursion to Italy. Free day to enjoy the typical market, the historic centre and its shopping streets, or the museums...\r\nPlease register in advance at the Tourist Office. (Other Trans-Alpes destinations at www.trans-alpes.com)"
    ],
    "it": [
      "Trans-Alpes vi propone un'escursione in Italia. Giornata libera per godersi il mercato tipico, il centro storico e le sue vie dello shopping, o i musei..."
    ],
    "fr": [
      "Trans-Alpes vous propose une excursion en Italie. Journée libre pour profiter du marché typique, du centre historique et ses rues commerçantes, ou bien des musées..."
    ],
    "es": [
      "Trans-Alpes le propone una excursión a Italia. Día libre para disfrutar del mercado típico, del centro histórico y sus calles comerciales, o de los museos..."
    ],
    "nl": [
      "Trans-Alpes biedt je een excursie naar Italië. Vrije dag om te genieten van de typische markt, het historische centrum en de winkelstraten, of de musea..."
    ]
  },
  "rdfs:label": {
