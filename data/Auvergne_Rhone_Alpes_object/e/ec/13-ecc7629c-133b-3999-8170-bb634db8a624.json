  "rdfs:comment": {
    "de": [
      "Die Elternvereinigung (APE) Les Amis de l'école unterstützt die Schulen in La Chapelle-en-Vercors, indem sie Veranstaltungen organisiert, um Schulausflüge, Bildungsprojekte und außerschulische Aktivitäten für die Schüler des Dorfes zu finanzieren."
    ],
    "en": [
      "The Association des Parents d'Élèves (APE) Les Amis de l'école supports the schools of La Chapelle-en-Vercors by organizing events to finance school outings, educational projects and extracurricular activities for the village's pupils."
    ],
    "it": [
      "L'Associazione dei genitori (APE) Les Amis de l'école sostiene le scuole di La Chapelle-en-Vercors organizzando eventi per finanziare gite scolastiche, progetti educativi e attività extrascolastiche per gli alunni del villaggio."
    ],
    "fr": [
      "L'Association des Parents d'Élèves (APE) Les Amis de l'école soutient les écoles de La Chapelle-en-Vercors en organisant des événements pour financer des sorties scolaires, projets éducatifs et des activités extrascolaires pour les élèves du village."
    ],
    "es": [
      "La Asociación de Padres de Alumnos (APE) Les Amis de l'école apoya a las escuelas de La Chapelle-en-Vercors organizando actos para financiar salidas escolares, proyectos educativos y actividades extraescolares para los alumnos del pueblo."
    ],
    "nl": [
      "De oudervereniging (APE) Les Amis de l'école steunt de scholen in La Chapelle-en-Vercors door evenementen te organiseren om schoolreisjes, educatieve projecten en buitenschoolse activiteiten voor de leerlingen van het dorp te financieren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "APE Les Amis de l'école"
    ]
  },
