  "rdfs:comment": {
    "de": [
      "Au bonheur des animaux ist ein Erlebnisbauernhof in der Gemeinde La Garde-Adhémar, in der Nähe des Flugplatzes von Pierrelatte. Sie vereint über 350 Bauernhoftiere aus der ganzen Welt."
    ],
    "en": [
      "Au bonheur des animaux is a discovery farm located in the commune of La Garde-Adhémar, near the Pierrelatte airfield. It features over 350 farm animals from all over the world."
    ],
    "it": [
      "Au bonheur des animaux è una fattoria didattica situata nel comune di La Garde-Adhémar, vicino all'aeroporto di Pierrelatte. Vi sono all'incirca 250 animali da fattoria provenienti da tutto il mondo."
    ],
    "fr": [
      "Au bonheur des animaux est une ferme de découverte située sur la commune de La Garde-Adhémar, à proximité de l'aérodrome de Pierrelatte. Elle réunit plus de 350 animaux de la ferme dont la majorité est issue d'abandon ou de sauvetage."
    ],
    "nl": [
      "Au bonheur des animaux is een ontdekkingsboerderij in de gemeente La Garde-Adhémar, vlakbij het vliegveld van Pierrelatte. Er zijn meer dan 350 boerderijdieren van over de hele wereld."
    ],
    "es": [
      "Au bonheur des animaux es una granja pedagógica que se encuentra en el ayuntamiento de La Garde-Adhémar, cerca del aeródromo de Pierrelatte, y que aloja cerca de 300 animales de la granja provenientes del mundo entero."
    ]
  },
  "rdfs:label": {
