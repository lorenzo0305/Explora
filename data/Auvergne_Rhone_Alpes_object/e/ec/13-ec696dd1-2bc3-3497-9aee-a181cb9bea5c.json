  "rdfs:comment": {
    "de": [
      "Véronique, Etienne und Raphael bilden ein gutes Team, um Ihnen einen Fourme fermière de Montbrison AOP herzustellen! Die 55 Milchkühe werden mit Heu gefüttert, was dem Fourme de Montbrison den guten Geschmack verleiht."
    ],
    "en": [
      "Véronique, Etienne and Raphael are the names of the fabulous team here who make traditional fourme cheese under the Montbrison PDO! The 55-strong herd of dairy cows feed on hay, giving the Fourme de Montbrison cheese its delicious local flavour."
    ],
    "it": [
      "Véronique, Etienne e Raphael sono la squadra perfetta per farvi gustare una Fourme fermière de Montbrison DOP! La mandria di 55 vacche da latte è nutrita con fieno essiccato in stalla, che conferisce alla Fourme de Montbrison quel grande sapore locale."
    ],
    "fr": [
      "Véronique, Etienne et Raphael, voilà une belle équipe pour vous concocter une fourme fermière de Montbrison AOP ! Le troupeau de 55 vaches laitières, est nourri au foin de séchage en grange, ce qui apporte à la fourme de Montbrison ce bon goût du terroir."
    ],
    "es": [
      "¡Véronique, Etienne y Raphael son el equipo perfecto para hacerte una Fourme fermière de Montbrison DOP! El rebaño de 55 vacas lecheras se alimenta de heno secado en granero, lo que confiere a la Fourme de Montbrison ese gran sabor local."
    ],
    "nl": [
      "Véronique, Etienne en Raphael zijn het perfecte team om voor jou een Fourme fermière de Montbrison BOB te maken! De kudde van 55 melkkoeien wordt gevoed met in de schuur gedroogd hooi, wat de Fourme de Montbrison die geweldige lokale smaak geeft."
    ]
  },
