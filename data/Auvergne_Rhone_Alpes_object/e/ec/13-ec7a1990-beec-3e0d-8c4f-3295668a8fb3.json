  "rdfs:comment": {
    "de": [
      "Erleben Sie die Paralympischen Spiele dank der Übertragungen auf Großbildschirmen in voller Größe und probieren Sie die paralympischen Sportarten auf spielerische Weise aus."
    ],
    "en": [
      "Experience the Paralympic Games up close, thanks to giant screen broadcasts, and try your hand at Paralympic sports in a fun way."
    ],
    "it": [
      "Vivete i Giochi Paralimpici da vicino grazie alle trasmissioni su schermo gigante e provate a cimentarvi negli sport paralimpici in modo divertente."
    ],
    "fr": [
      "Vivez les Jeux Paralympiques en grand grâce aux retransmissions sur écrans géants et essayez-vous aux sports paralympiques de manière ludique."
    ],
    "es": [
      "Vive de cerca los Juegos Paralímpicos con las retransmisiones en pantalla gigante y prueba de forma divertida los deportes paralímpicos."
    ],
    "nl": [
      "Beleef de Paralympische Spelen van dichtbij met uitzendingen op reuzenschermen en probeer op een leuke manier Paralympische sporten uit."
    ]
  },
