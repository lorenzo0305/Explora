  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von den Klängen traditioneller Blaskapellen mitreißen, die eine warme Atmosphäre voller Freude schaffen. Das Festival wird von der Association le Bon Air organisiert."
    ],
    "en": [
      "Let yourself be carried away by the sounds of traditional brass bands, creating a warm and joyful atmosphere. Festival organized by the association Le Bon Air."
    ],
    "it": [
      "Lasciatevi trasportare dai suoni delle bande di ottoni tradizionali, creando un'atmosfera calda e piena di gioia. Festival organizzato dall'associazione le Bon Air."
    ],
    "fr": [
      "Laissez vous entrainer par les sons des fanfares traditionnelles, créant une ambiance chaleureuse et pleine de joie. Festival organisé par l'association le Bon Air."
    ],
    "nl": [
      "Laat je meeslepen door de klanken van traditionele brassbands, die een warme sfeer vol vreugde creëren. Festival georganiseerd door de vereniging le Bon Air."
    ],
    "es": [
      "Déjese llevar por los sonidos de las bandas de música tradicionales, que crean un ambiente cálido y lleno de alegría. Festival organizado por la asociación le Bon Air."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival de Bandas"
    ]
  },
