  "rdfs:comment": {
    "de": [
      "Willkommen bei Les Fils à Maman, dem Restaurant mit Bar am Fuße der Seilbahn von Solaise, perfekt nach einem Tag auf der Piste!\r\nWärmen Sie sich auf und genießen Sie unsere herzerwärmende Küche, die die Gerichte unserer Kindheit zelebriert."
    ],
    "en": [
      "Welcome to Les Fils à Maman, the restaurant-bar located at the base of the Solaise gondola – perfect after a day on the slopes!  \r\nWarm up and enjoy our comforting cuisine, inspired by the dishes of our childhood."
    ],
    "it": [
      "Benvenuti da Les Fils à Maman, il ristorante-bar situato ai piedi della cabinovia di Solaise, perfetto dopo una giornata sulle piste!  \r\nRiscaldatevi e gustate la nostra cucina confortante, ispirata ai piatti della nostra infanzia."
    ],
    "fr": [
      "Bienvenue chez les Fils à Maman, le restaurant-bar situé au pied de la télécabine de Solaise, parfait après une journée sur les pistes ! \r\nRéchauffez-vous et savourez notre cuisine réconfortante, célébrant les plats de notre enfance."
    ],
    "nl": [
      "Welkom bij Les Fils à Maman, het restaurant-bar aan de voet van de Solaise gondellift, perfect na een dag op de piste!\r\nWarm je op en geniet van ons comfort food, met gerechten uit onze kindertijd."
    ],
    "es": [
      "Bienvenido a Les Fils à Maman, el restaurante-bar situado a los pies del telecabina Solaise, perfecto después de un día en las pistas\r\nEntre en calor y disfrute de nuestra comida reconfortante, celebrando los platos de nuestra infancia."
    ]
  },
