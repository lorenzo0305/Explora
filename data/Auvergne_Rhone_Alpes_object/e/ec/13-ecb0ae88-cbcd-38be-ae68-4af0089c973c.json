  "rdfs:comment": {
    "de": [
      "Der SnowPark des Arcs wurde von unserem Team von 4 Shaper entworfen, die es täglich pflegen, um Freestyle auf einem Qualitätsplatz zu üben, egal ob Anfänger oder Experte."
    ],
    "en": [
      "The les Arcs snowpark was designed by our team of 4 shapers who maintain it every day, for freestyle riding in a quality spot whether you are a beginner or an expert."
    ],
    "it": [
      "Lo SnowPark di Les Arcs è stato progettato dal nostro team di 4 shaper che ne curano quotidianamente la manutenzione, per praticare il freestyle su uno spot di qualità, sia che siate principianti o esperti."
    ],
    "fr": [
      "Le SnowPark des Arcs a été pensé et conçu par notre équipe de 4 shapers qui l'entretiennent quotidiennement, pour pratiquer le freestyle sur un spot de qualité, que vous soyez débutant ou expert."
    ],
    "nl": [
      "Het SnowPark in Les Arcs is ontworpen door ons team van 4 shapers die het dagelijks onderhouden, om freestyle te oefenen op een kwaliteitsplek, of je nu beginner of expert bent."
    ],
    "es": [
      "El SnowPark de Les Arcs ha sido diseñado por nuestro equipo de 4 shapers que lo mantienen a diario, para practicar el freestyle en un spot de calidad, tanto si eres principiante como experto."
    ]
  },
