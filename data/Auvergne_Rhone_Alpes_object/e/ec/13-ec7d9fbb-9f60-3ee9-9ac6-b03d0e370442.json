  "rdfs:comment": {
    "de": [
      "Drucken und Reprografie. Verkabelter Internetzugang (kein WLAN), 3 PCs zur Verfügung, 4 Kopierer, die zum Drucken angeschlossen sind.\r\nEs ist wichtig, dass die Personen selbstständig sind. Jede Bitte um Unterstützung wird mit einem Euro pro Minute berechnet."
    ],
    "en": [
      "Wired internet access, workstation available, printing facilities. Please note that you must be self-sufficient; no assistance is available."
    ],
    "it": [
      "Stampa e reprografia. Accesso a Internet via cavo (no wifi), 3 PC a disposizione, 4 fotocopiatrici collegate per la stampa.\r\nÈ importante che le persone siano autosufficienti: qualsiasi richiesta di assistenza sarà fatturata a un euro al minuto."
    ],
    "fr": [
      "Impressions et reprographies. Accès filaire à internet (pas de wifi), 3 PC à disposition, 4 copieurs connectés pour l'impression. \r\nIl est important que les personnes soient autonomes, toute demande d'assistance sera facturée un euro par minute."
    ],
    "es": [
      "Impresión y reprografía. Acceso a Internet por cable (no hay wifi), 3 PC disponibles, 4 fotocopiadoras conectadas para imprimir.\r\nCualquier solicitud de asistencia se facturará a un euro por minuto."
    ],
    "nl": [
      "Afdrukken en reprografie. Bekabelde internettoegang (geen wifi), 3 pc's beschikbaar, 4 kopieermachines aangesloten om te printen.\r\nHet is belangrijk dat mensen zelfredzaam zijn. Elk verzoek om hulp wordt gefactureerd tegen een euro per minuut."
    ]
  },
