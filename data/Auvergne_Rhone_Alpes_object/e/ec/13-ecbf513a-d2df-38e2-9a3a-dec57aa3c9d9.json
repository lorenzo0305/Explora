  "rdfs:comment": {
    "de": [
      "Diese Nordic-Walking-Strecke ist magisch! Verpassen Sie nicht den empfohlenen Stopp am Fuße des Wasserfalls von Mélogne für einen Moment der Erfrischung!"
    ],
    "en": [
      "This Nordic walking course is magical! Don't miss the recommended stop at the foot of the Mélogne waterfall for a moment of freshness!"
    ],
    "it": [
      "Questo percorso di nordic walking è magico! Non perdetevi la sosta consigliata ai piedi della cascata Mélogne per un momento di freschezza!"
    ],
    "fr": [
      "Ce parcours de marche nordique est magique ! Ne loupez pas l'arrêt recommandé au pied de la cascade de Mélogne pour un moment de fraicheur !"
    ],
    "es": [
      "Esta ruta de marcha nórdica es mágica No se pierda la parada recomendada al pie de la cascada de Mélogne para disfrutar de un momento de frescor"
    ],
