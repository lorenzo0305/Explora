  "rdfs:comment": {
    "de": [
      "Makler für Versicherungen. Kfz-, Hausrat-, Motorrad-, Lebens-, Multirisk-Versicherungen... Versicherungen für BTP, Unternehmen und Handwerker. Vorsorge, Zusatzkrankenversicherung & Krankenversicherung auf Gegenseitigkeit."
    ],
    "en": [
      "Insurance brokers. Car, home, motorcycle, life, multi-risk insurance... Construction, business & artisan insurance. Provident, complementary health & mutual insurance."
    ],
    "it": [
      "Broker assicurativi. Assicurazione auto, casa, moto, vita, multirischi... Assicurazioni edili e di ingegneria civile, assicurazioni aziendali e assicurazioni per artigiani. Assicurazioni previdenziali, sanitarie complementari e mutualistiche."
    ],
    "fr": [
      "Courtiers en assurances. Assurances automobile, habitation, moto, vie, multirisque... Assurances BTP, d'entreprise & pour artisan. Prévoyance, complémentaire santé & mutuelle."
    ],
    "nl": [
      "Makelaars in verzekeringen. Autoverzekering, opstalverzekering, motorverzekering, levensverzekering, multirisicoverzekering... Bouw- en civieltechnische verzekeringen, bedrijfsverzekeringen & verzekeringen voor ambachtslieden. Voorzorgsverzekering, aanvullende ziektekostenverzekering & onderlinge verzekering."
    ],
    "es": [
      "Corredores de seguros. Seguros de coche, hogar, moto, vida, multirriesgo... Seguros de construcción e ingeniería civil, seguros de empresa y seguros para artesanos. Previsión, salud complementaria y mutuas."
