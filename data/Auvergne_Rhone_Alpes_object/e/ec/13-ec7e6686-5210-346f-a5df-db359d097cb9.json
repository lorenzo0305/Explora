  "rdfs:comment": {
    "de": [
      "La Grangerie empfängt Sie und bietet Ihnen \"All Inclusive\"-Leistungen mit Unterkunft in einer Ferienwohnung und Aufenthalten zum Wandern oder Schneeschuhwandern."
    ],
    "en": [
      "La Grangerie welcomes you and offers \"all-inclusive\" services with self-catering accommodation and hiking or snowshoeing holidays."
    ],
    "it": [
      "La Grangerie vi accoglie e offre servizi all-inclusive, tra cui alloggi con angolo cottura e vacanze a piedi e con le racchette da neve."
    ],
    "fr": [
      "La Grangerie vous accueille et vous propose des prestations \"all inclusive\" avec hébergement en gîte et séjours randonnées pédestres ou randonnées raquettes."
    ],
    "es": [
      "La Grangerie le da la bienvenida y le ofrece servicios todo incluido, como alojamiento con cocina y vacaciones de senderismo y raquetas de nieve."
    ],
    "nl": [
      "La Grangerie heet je van harte welkom en biedt all-inclusive diensten, waaronder self-catering accommodatie en wandel- en sneeuwschoenvakanties."
    ]
  },
