  "rdfs:comment": {
    "de": [
      "Privates Schloss, das kontinuierlich restauriert wird. Freier Zugang nur von außen über den Weg rechts neben dem großen Eingangstor, Aussichtspunkt auf die Ostfassade des Schlosses und die große Treppe. Arbeiten für die Eröffnung von Gästezimmern (2 Jahre)"
    ],
    "en": [
      "Private chateau undergoing ongoing restoration. Free access only from the outside via the path to the right of the large entrance gate, with views of the château's east facade and grand staircase. Work to open guest rooms (2 years)"
    ],
    "it": [
      "Castello privato in fase di restauro. Accesso libero solo dall'esterno attraverso il sentiero a destra del grande cancello d'ingresso, con vista sulla facciata est del castello e sullo scalone d'onore. Lavori di apertura delle camere degli ospiti (2 anni)"
    ],
    "fr": [
      "Château privé en restauration continue. Accès libre uniquement depuis l'extérieur par le chemin situé à droite du grand portail d'entrée, point de vue sur la façade Est du château et du grand escalier. Travaux pour l'ouverture de chambres d'hôtes (2 ans)"
    ],
    "nl": [
      "Privékasteel dat momenteel wordt gerestaureerd. Vrije toegang alleen van buitenaf via het pad rechts van de grote toegangspoort, met uitzicht op de oostgevel van het kasteel en de grote trap. Werkzaamheden om de gastenkamers te openen (2 jaar)"
    ],
    "es": [
      "Castillo privado en curso de restauración. Acceso libre sólo desde el exterior por el camino a la derecha de la gran puerta de entrada, con vistas a la fachada este del castillo y a la gran escalinata. Obras de apertura de las habitaciones de huéspedes (2 años)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Puy-Guillon"
    ]
  },
