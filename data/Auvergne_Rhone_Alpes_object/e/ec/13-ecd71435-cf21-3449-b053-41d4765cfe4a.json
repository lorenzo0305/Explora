  "rdfs:comment": {
    "de": [
      "Die Skilehrer der ESF Les Coches werden Ihnen ihre Leidenschaft und die besten Techniken des Skifahrens und Snowboardens näher bringen und mit Ihnen teilen."
    ],
    "en": [
      "Apart from passing on their infectious passion for the sport, the Les Coches ski school instructors will also teach you some awesome skiing and snowboarding techniques."
    ],
    "it": [
      "I maestri ESF di Les Coches vi faranno scoprire e condividere la loro passione e le migliori tecniche di sci e snowboard."
    ],
    "fr": [
      "Les moniteurs de l'ESF des Coches vous feront découvrir et partager leurs passions et les meilleures techniques du ski et du snowboard."
    ],
    "es": [
      "Los monitores de la ESF de Les Coches te ayudarán a descubrir y compartir su pasión y las mejores técnicas de esquí y snowboard."
    ],
    "nl": [
      "De skileraren van de EFS (Franse Skischool) van Coches zullen U het skiën leren ontdekken, hun passie met U delen en U de beste technieken aanleren van ski en snowboard."
    ]
  },
