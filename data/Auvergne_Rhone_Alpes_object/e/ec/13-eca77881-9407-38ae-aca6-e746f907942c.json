  "rdfs:comment": {
    "de": [
      "Jean-Claude Guillaumon ist ein autodidaktischer Künstler, der Happenings und alle Formen der ephemeren Kunst liebt und die Kunstszene in Lyon geprägt hat. Das macLYON zeigt die erste Retrospektive, die diesem unklassifizierbaren, von Witz und Ironie geprägten Künstler gewidmet ist."
    ],
    "en": [
      "A self-taught artist and devotee of happenings and all forms of ephemeral art, Jean-Claude Guillaumon left his mark on the Lyon art scene. The macLYON presents the first retrospective dedicated to this unclassifiable artist, known for his wit and irony."
    ],
    "it": [
      "Jean-Claude Guillaumon è un artista autodidatta che ha segnato la scena artistica lionese con la sua inclinazione per gli happening e tutte le forme di arte effimera. MacLYON presenta la prima retrospettiva dedicata a questo artista inclassificabile, intriso di sfaccettatura e ironia."
    ],
    "fr": [
      "Artiste autodidacte adepte du happening et de toutes les formes d’art éphémère, Jean-Claude Guillaumon a marqué la scène artistique lyonnaise. Le macLYON présente la première rétrospective dédiée à cet artiste inclassable, empreint de facétie et d’ironie."
    ],
    "nl": [
      "Jean-Claude Guillaumon is een autodidact die zijn stempel heeft gedrukt op de kunstscène van Lyon met zijn voorliefde voor happening en alle vormen van efemere kunst. MacLYON presenteert de eerste retrospectieve gewijd aan deze onclassificeerbare kunstenaar, doordrenkt van facetachtigheid en ironie."
    ],
    "es": [
      "Jean-Claude Guillaumon es un artista autodidacta que ha dejado su impronta en la escena artística de Lyon, con su inclinación por el happening y todas las formas de arte efímero. MacLYON presenta la primera retrospectiva dedicada a este artista inclasificable, impregnado de facetismo e ironía."
    ]
  },
  "rdfs:label": {
    "en": [
      "Him again! Jean-Claude Guillaumon"
    ],
    "fr": [
      "Exposition Encore lui ! Jean-Claude Guillaumon"
    ]
  },
