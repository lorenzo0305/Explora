  "rdfs:comment": {
    "de": [
      "Pizzeria-Restaurant, das Ihnen handgemachte Pizzen sowie Pasta, Gnocchi und Salate anbietet. Sie können auch einen leckeren Cocktail trinken, während Sie ein Brett genießen, das Sie mit Ihren Freunden teilen."
    ],
    "en": [
      "Pizzeria restaurant, offering artisanal pizzas as well as pasta, gnocchi and salads. You can also have a delicious cocktail while enjoying a board to share with friends."
    ],
    "it": [
      "Ristorante pizzeria che offre pizze fatte in casa, oltre a pasta, gnocchi e insalate. È inoltre possibile gustare un delizioso cocktail con una tavola da condividere con gli amici."
    ],
    "fr": [
      "Restaurant pizzeria, vous proposant des pizzas artisanales ainsi que des pâtes, gnocchi et salades. Vous pourrez aussi prendre un délicieux cocktail en dégustant une planche à partager entre amis."
    ],
    "es": [
      "Restaurante pizzería, que ofrece pizzas caseras, así como pasta, ñoquis y ensaladas. También podrá disfrutar de un delicioso cóctel con una tabla para compartir con los amigos."
    ],
    "nl": [
      "Pizzeria-restaurant met huisgemaakte pizza's, maar ook pasta, gnocchi en salades. U kunt ook genieten van een heerlijke cocktail met een bord om te delen met vrienden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Et Caetera Pizzeria"
    ]
  },
