  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dd2f6e77-7037-3eb1-a390-61367a9392eb",
      "dc:description": {
        "de": [
          "Die 10 Zimmer sind um einen Innenhof herum angeordnet und befinden sich alle im Erdgeschoss, darunter ein Zimmer für Behinderte. Jedes Zimmer ist mit LCD-TV, WIFI, Dusche und Nichtraucher-Toilette ausgestattet."
        ],
        "en": [
          "The 10 rooms are located around a patio, all on the first floor, including one PMR room. Each room is equipped with LCD TNT TV, WIFI, shower and non-smoking toilet."
        ],
        "it": [
          "Le 10 camere sono disposte intorno a un patio, tutte al piano terra, tra cui una per disabili. Ogni camera è dotata di TV LCD con schermo TNT, WIFI, doccia e servizi igienici per non fumatori."
        ],
        "fr": [
          "Les 10 Chambres se situent autour d'un patio, toutes en rez-de-chaussée dont une chambre PMR. Chaque chambre est équipée de TV Ecran LCD TNT, WIFI, Douche et Toilettes non fumeur."
        ],
        "es": [
          "Las 10 habitaciones están situadas alrededor de un patio, todas en la planta baja, incluida una para minusválidos. Cada habitación está equipada con TV de pantalla LCD TNT, WIFI, ducha y aseo para no fumadores."
        ],
        "nl": [
          "De 10 kamers liggen rond een patio, allemaal op de begane grond, waaronder één kamer voor mindervaliden. Elke kamer is uitgerust met lcd-tv met TNT-scherm, draadloos internet, douche en rookvrij toilet."
        ]
      },
      "@type": [
        "Description"
