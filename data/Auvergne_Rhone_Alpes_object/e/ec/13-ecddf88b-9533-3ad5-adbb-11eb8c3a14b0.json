  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese 23,7 km lange Gravel-Strecke von Courchevel aus. Die Strecke verläuft über 14,2 km Straßen und 9,5 km Waldwege. Die Gesamtsteigung beträgt über 720m."
    ],
    "ru": [
      "Откройте для себя 23,7 км гравийной трассы из Куршевеля. Маршрут включает в себя 14,2 км дорог и 9,5 км лесных троп. Общий подъем составляет более 720 м."
    ],
    "en": [
      "Discover this 23.7 km Gravel course from Courchevel. The route comprises 14.2 km of roads and 9.5 km of forest tracks. It has a total ascent of over 720m."
    ],
    "it": [
      "Scoprite questo percorso sterrato di 23,7 km da Courchevel. Il percorso comprende 14,2 km di strade e 9,5 km di sentieri forestali. L'ascesa totale è di oltre 720 metri."
    ],
    "fr": [
      "Découvrez ce parcours de Gravel de 23,7 km depuis Courchevel. Ce parcours emprunte 14,2 km de routes et 9,5 km de pistes forestières. Il présente une ascension cumulée de plus de 720m."
    ],
    "nl": [
      "Ontdek dit 23,7 km lange gravelparcours vanuit Courchevel. De route bestaat uit 14,2 km wegen en 9,5 km bospaden. De totale stijging bedraagt meer dan 720 m."
    ],
    "es": [
      "Descubra este recorrido de grava de 23,7 km desde Courchevel. El recorrido discurre por 14,2 km de carreteras y 9,5 km de pistas forestales. Tiene un ascenso total de más de 720 m."
    ]
  },
