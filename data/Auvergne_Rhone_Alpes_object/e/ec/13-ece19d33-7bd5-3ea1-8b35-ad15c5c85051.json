  "rdfs:comment": {
    "de": [
      "Dieses Solarboot bietet kleine Kreuzfahrten von 30 oder 45 Minuten entlang des Ufers von Evian. Mit dem Boot können Sie auch zu den Wassergärten Pré Curieux gelangen."
    ],
    "en": [
      "The solar boat \"l'Agrion\" offers cruises of 30 or 45 minutes to discover Evian lakeside. Using this boat, you could access to Evian Water Gardens \r\n\"Pré Curieux\"."
    ],
    "it": [
      "L'Agrion prende il nome da una piccola libellula. Questo battello elettrosolare offre crociere di 30 o 45 minuti al largo di Evian e porta i passeggeri anche ai giardini acquatici di Pré Curieux."
    ],
    "fr": [
      "L'Agrion porte le nom d'une petite libellule. Ce bateau électrosolaire propose des croisières de 30 ou de 45 minutes au large d'Evian, et permet également à ses passagers de se rendre aux jardins de l'eau de Pré Curieux."
    ],
    "es": [
      "El Agrion debe su nombre a una pequeña libélula. Esta embarcación electrosolar ofrece cruceros de 30 o 45 minutos frente a Evian, y también lleva a los pasajeros a los jardines acuáticos de Pré Curieux."
    ],
    "nl": [
      "De Agrion is vernoemd naar een kleine libel. Deze boot op zonne-energie biedt rondvaarten van 30 of 45 minuten in de buurt van Evian en neemt passagiers ook mee naar de watertuinen van Pré Curieux."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kreuzfahrt an Bord des Elektrosolarbootes \"Agrion\"."
    ],
    "en": [
      "Cruise aboard the electrosolar boat \"Agrion\""
    ],
    "it": [
      "Croisière à bord du bateau électrosolaire \"L'Agrion\""
    ],
    "fr": [
      "Croisière à bord du bateau électrosolaire \"L'Agrion\""
    ],
