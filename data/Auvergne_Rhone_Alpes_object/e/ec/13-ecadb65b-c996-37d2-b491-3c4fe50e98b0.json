  "rdfs:comment": {
    "de": [
      "Das Supernova in La Motte-Servolex bietet lokale Küche mit internationalen Inspirationen und Signature-Cocktails. Genießen Sie diese Köstlichkeiten auf seinem Rooftop mit Blick auf das Belledonne-Massiv oder in einem warmen und einladenden Innenraum."
    ],
    "en": [
      "Supernova in La Motte-Servolex offers internationally inspired local cuisine and signature cocktails. Savor these delights on its rooftop overlooking the Belledonne massif, or in its warm and welcoming interior."
    ],
    "it": [
      "Il Supernova di La Motte-Servolex offre una cucina locale di ispirazione internazionale e cocktail d'autore. Assaporate queste delizie sul suo tetto con vista sul massiccio di Belledonne o nei suoi interni caldi e accoglienti."
    ],
    "fr": [
      "Le Supernova à la Motte-Servolex offre une cuisine locale aux inspirations internationales et des cocktails signatures. Savourez ces délices sur son rooftop avec vue sur le massif de Belledonne, ou dans un intérieur chaleureux et accueillant."
    ],
    "es": [
      "El Supernova de La Motte-Servolex ofrece cocina local de inspiración internacional y cócteles de autor. Saboree estas delicias en su azotea con vistas al macizo de Belledonne, o en su interior cálido y acogedor."
    ],
    "nl": [
      "De Supernova in La Motte-Servolex serveert internationaal geïnspireerde lokale gerechten en kenmerkende cocktails. Geniet van deze lekkernijen op het dak met uitzicht op het Belledonne-massief of in het warme en gastvrije interieur."
    ]
  },
  "rdfs:label": {
