  "rdfs:comment": {
    "de": [
      "Handgefertigte Töpferwaren aus Steingut. JA! ist in erster Linie meine Initiale, aber auch \"JA! Ja, es ist möglich, ja, ich will es! Ich versuche, das Einfache, das Nützliche und das Schöne miteinander zu verbinden."
    ],
    "en": [
      "Hand-crafted stoneware pottery. JA! are first and foremost my initials, but they also stand for \"YES! Yes it's possible, Yes I want it! I seek to combine the simple, the useful and the beautiful."
    ],
    "it": [
      "Ceramiche in gres fatte a mano. JA! sono innanzitutto le mie iniziali, ma stanno anche per \"SI! Sì, è possibile, sì, lo voglio! Il mio obiettivo è combinare il semplice, l'utile e il bello."
    ],
    "fr": [
      "Poteries artisanales en grès. JA! ce sont d'abord mes initiales, c'est aussi \"OUI!\". Oui c'est possible, Oui je le veux! Je cherche à allier le simple, l'utile et le beau."
    ],
    "nl": [
      "Handgemaakt aardewerk van steengoed. JA! zijn in de eerste plaats mijn initialen, maar ze staan ook voor \"JA! Ja het is mogelijk, Ja ik wil het! Mijn doel is om het eenvoudige, het nuttige en het mooie te combineren."
    ],
    "es": [
      "Cerámica de gres hecha a mano. ¡JA! son en primer lugar mis iniciales, también es \"¡Si! Sí es posible, sí lo quiero Intento combinar lo sencillo, lo útil y lo bello."
    ]
  },
