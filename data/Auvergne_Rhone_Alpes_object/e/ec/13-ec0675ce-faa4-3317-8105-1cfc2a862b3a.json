  "rdfs:comment": {
    "de": [
      "Verkauf und Verkostung unserer AOP- und IGP-Weine und unseres Traubensafts im Weinkeller. Kostenlose erläuterte Besichtigung des Weinbergs und des Weinkellers nach Terminvereinbarung für Gruppen von mindestens 10 Erwachsenen möglich."
    ],
    "en": [
      "Sale in the cellar of our  wines and our grape juice.\r\nFree tour of the vineyard and winery possible by appointment for groups of 10 adults minimum."
    ],
    "it": [
      "Vendita e degustazione dei nostri vini IGP Coteaux de l'Ardèche e del succo d'uva in cantina.\r\nVisita guidata gratuita del vigneto e della cantina su prenotazione per gruppi di almeno 10 adulti."
    ],
    "fr": [
      "Vente et dégustation au caveau de nos vins IGP Coteaux de l'Ardèche et de notre jus de raisin.\r\nVisite expliquée de la vigne et de la cave gratuite possible sur rendez-vous pour des groupes de 10 adultes minimum."
    ],
    "nl": [
      "Verkoop van onze wijn en druivensap op het domein. Gratis begeleide bezoeken van het domein mogelijk op afspraak voor groepen vanaf minimum 10 personen."
    ],
    "es": [
      "Venta y degustación de nuestros vinos IGP Coteaux de l'Ardèche y zumo de uva en la bodega.\r\nVisita guiada gratuita del viñedo y la bodega con cita previa para grupos de al menos 10 adultos."
    ]
  },
