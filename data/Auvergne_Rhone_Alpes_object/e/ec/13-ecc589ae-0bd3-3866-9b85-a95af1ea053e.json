  "rdfs:comment": {
    "de": [
      "Mit dem Gleitschirm zu fliegen, ist ein Moment der Ewigkeit, die Zeit steht still. In Aussois gibt es 2 Startplätze (Angle Bellecôte; le Djoin) und 2 Landeplätze (la Charrière; la Croix)."
    ],
    "en": [
      "Flying a paraglider is a moment of eternity, time suspended. Aussois has 2 take-off zones (Angle Bellecôte; le Djoin) and 2 landing zones (la Charrière; la Croix)."
    ],
    "it": [
      "Volare in parapendio è un momento di eternità, un tempo sospeso. Aussois dispone di 2 zone di decollo (Angle Bellecôte; le Djoin) e 2 zone di atterraggio (la Charrière; la Croix)."
    ],
    "fr": [
      "Voler en parapente, c'est un moment d'éternité, le temps suspendu. A Aussois, 2 zones de décollage (Angle Bellecôte ; le Djoin) et 2 d'atterrissage (la Charrière ; la Croix)."
    ],
    "es": [
      "Volar en parapente es un momento de eternidad, un tiempo suspendido. Aussois cuenta con 2 zonas de despegue (Angle Bellecôte; le Djoin) y 2 de aterrizaje (la Charrière; la Croix)."
    ],
    "nl": [
      "Vliegen met een paraglider is een moment van eeuwigheid, de tijd stilgezet. Aussois heeft 2 opstijgzones (Angle Bellecôte; le Djoin) en 2 landingszones (la Charrière; la Croix)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Paragliding take off and drop zones in Aussois"
    ],
    "fr": [
      "Sites d'envol et d'atterissage de parapente à Aussois"
    ],
    "nl": [
      "Paragliding afvlieg- en landingssite van Aussois"
    ]
  },
