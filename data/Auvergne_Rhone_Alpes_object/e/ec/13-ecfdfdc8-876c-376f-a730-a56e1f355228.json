  "rdfs:comment": {
    "de": [
      "Unser Hotel MAXOTEL in Ytrac bei Aurillac empfängt Sie von Montag bis Sonntag mit seinen 10 Zimmern, die alle ausgestattet sind mit: eigenem Bad, Flachbildfernseher, kostenlosem & unbegrenztem WIFI-Zugang."
    ],
    "en": [
      "Located near Aurillac, in Ytrac, we welcome you from Monday to Sunday. We have 10 rooms all equiped : free and illimited wifi, television, private bathroom."
    ],
    "it": [
      "Il nostro hotel MAXOTEL, situato a Ytrac vicino ad Aurillac, vi accoglie dal lunedì alla domenica con le sue 10 camere tutte dotate di: bagno privato, TV a schermo piatto, accesso WIFI gratuito e illimitato."
    ],
    "fr": [
      "Notre hôtel MAXOTEL, situé à Ytrac près d'Aurillac, vous accueille du Lundi au dimanche avec ses 10 chambres toutes équipées de : salle de bain privative, télévision écran plat, accès WIFI gratuit & illimité."
    ],
    "nl": [
      "Ons MAXOTEL hotel, gelegen in Ytrac nabij Aurillac, verwelkomt u van maandag tot zondag met zijn 10 kamers allen uitgerust met: eigen badkamer, flatscreen televisie, gratis & onbeperkt WIFI toegang."
    ],
    "es": [
      "Nuestro hotel MAXOTEL, situado en Ytrac, cerca de Aurillac, le da la bienvenida de lunes a domingo con sus 10 habitaciones, todas ellas equipadas con: baño privado, TV de pantalla plana, acceso WIFI gratuito e ilimitado."
    ]
  },
