  "rdfs:comment": {
    "de": [
      "In der Bar und dem Restaurant The People Lyon werden Sie mit einem Lächeln in einer Nachbarschaftskantine im modernen Industrie-Look empfangen... Das Motto des Lokals? Das gute Leben und das gute Essen zu zelebrieren, 100% Lyon!"
    ],
    "en": [
      "At The People Lyon bar and restaurant, you'll be welcomed with a smile in a neighborhood canteen atmosphere with a modern industrial look. Our motto? Celebrating the good life and good food, 100% Lyonnais!"
    ],
    "it": [
      "Al bar-ristorante The People Lyon sarete accolti con un sorriso in una mensa di quartiere dall'aspetto industriale moderno... Il motto del ristorante? Celebrare il buon cibo e il buon vivere, 100% Lione!"
    ],
    "fr": [
      "Dans le bar restaurant The People Lyon, vous serez accueillis avec le sourire dans une ambiance cantine de quartier au look industriel moderne. \u2028Le moto de l'établissement ? Célébrer le bon vivre et le bon manger, du 100% lyonnais !"
    ],
    "es": [
      "En el bar-restaurante The People Lyon, le recibirán con una sonrisa en una cantina de barrio con un moderno aspecto industrial... ¿El lema del restaurante? Celebrar el buen comer y el buen vivir, ¡100% lioneses!"
    ],
    "nl": [
      "Bij bar-restaurant The People Lyon word je met een glimlach ontvangen in een buurtkantine met een moderne industriële look... Het motto van het restaurant? Lekker eten en goed leven vieren, 100% Lyon!"
    ]
  },
