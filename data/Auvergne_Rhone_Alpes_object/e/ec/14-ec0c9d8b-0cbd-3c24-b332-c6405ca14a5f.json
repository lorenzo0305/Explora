  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cbfe9090-3082-3eb9-9108-8288021a7122",
      "dc:description": {
        "de": [
          "Lassen Sie sich von unseren hausgemachten Spezialitäten verführen, die sorgfältig aus frischen und hochwertigen Zutaten zubereitet werden. Ein buntes und abwechslungsreiches Menü für jeden Geschmack"
        ],
        "en": [
          "Let yourself be tempted by our homemade specialties, carefully prepared with fresh, quality ingredients. A colorful and varied menu to suit all tastes"
        ],
        "it": [
          "Lasciatevi tentare dalle nostre specialità fatte in casa, preparate con cura e con ingredienti freschi e di qualità. Un menu colorato e vario per tutti i gusti"
        ],
        "fr": [
          "Laissez-vous tenter par nos spécialités maison, soigneusement préparées avec des ingrédients frais et de qualité. Un menu coloré et varié pour tous les goûts"
        ],
        "nl": [
          "Laat je verleiden door onze huisgemaakte specialiteiten, zorgvuldig bereid met verse ingrediënten van hoge kwaliteit. Een kleurrijk en gevarieerd menu naar ieders smaak"
        ],
        "es": [
          "Déjese tentar por nuestras especialidades caseras, cuidadosamente preparadas con ingredientes frescos y de calidad. Una carta colorida y variada para todos los gustos"
        ]
      },
