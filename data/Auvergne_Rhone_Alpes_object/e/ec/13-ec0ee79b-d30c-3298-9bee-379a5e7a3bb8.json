  "rdfs:comment": {
    "de": [
      "See von Usson-en-Forez : Angeln und Baden"
    ],
    "en": [
      "Waterbody for swimming fitted out and waterbody for fishing. \r\nPlayground for children and sports equipment for adults. \r\nPicnic tables, benches and boules court (pétanque)."
    ],
    "it": [
      "Area nuoto con attrezzature\r\nArea giochi per bambini (da utilizzare sotto la supervisione di un adulto) e strutture sportive per adulti.\r\nTavoli da picnic, panchine e bocce."
    ],
    "fr": [
      "Plan d'eau de baignade aménagé\r\nAire de jeux pour enfants (à utiliser sous la surveillance d'un adulte) et équipements sportifs pour adultes.\r\nTables de pique-nique, bancs et terrain de pétanque."
    ],
    "nl": [
      "Zwemgedeelte met faciliteiten\r\nSpeeltuin voor kinderen (te gebruiken onder toezicht van een volwassene) en sportfaciliteiten voor volwassenen.\r\nPicknicktafels, banken en jeu de boulesbaan."
    ],
    "es": [
      "Zona de baño con instalaciones\r\nZona de juegos para niños (a utilizar bajo la supervisión de un adulto) e instalaciones deportivas para adultos.\r\nMesas de picnic, bancos y zona de petanca."
    ]
  },
