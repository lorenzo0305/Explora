  "rdfs:comment": {
    "de": [
      "Sie werden unsere abwechslungsreiche traditionelle Küche und unsere Spezialitäten aus der Ardèche zu schätzen wissen. Auf unserer überdachten Terrasse können Sie Ihre Mahlzeiten in einem angenehmen Rahmen einnehmen."
    ],
    "en": [
      "We serve various traditional dishes and typical Ardèche food. You will enjoy your meals in a nice setting on a roofed terrace."
    ],
    "it": [
      "Apprezzerete la nostra variegata cucina tradizionale e le nostre specialità dell'Ardèche. La nostra terrazza coperta vi permetterà di consumare i vostri pasti in un ambiente piacevole."
    ],
    "fr": [
      "Vous apprécierez notre cuisine traditionnelle variée et nos spécialités ardéchoises. Notre terrasse couverte vous permettra de prendre vos repas dans un cadre agréable."
    ],
    "nl": [
      "U zult onze gevarieerde traditionele keuken en onze specialiteiten uit de Ardèche waarderen. Op ons overdekte terras kunt u in een aangenaam kader eten."
    ],
    "es": [
      "Apreciará nuestra variada cocina tradicional y nuestras especialidades de Ardèche. Nuestra terraza cubierta le permitirá tomar sus comidas en un entorno agradable."
    ]
  },
