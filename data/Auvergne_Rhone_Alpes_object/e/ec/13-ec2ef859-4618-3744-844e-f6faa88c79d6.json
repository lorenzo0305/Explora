  "rdfs:comment": {
    "de": [
      "Das Sofitel Lyon-Bellecour liegt im Herzen von Lyon und bietet einen Panoramablick auf die Stadt und die Rhône. Auf dem Programm Ihres 5*-Aufenthalts stehen Gaumenfreuden im Restaurant, Cocktails mit Blick auf Lyon und eine Wellness-Session im So FIT."
    ],
    "en": [
      "The Sofitel Lyon Bellecour, situated in the heart of Lyon, offers panoramic views over the city and the Rhône. The programme for your 5* stay includes gourmet delights in the restaurant, cocktails with a view over Lyon and a wellness session at the So FIT."
    ],
    "it": [
      "Nel cuore di Lione, il Sofitel Lyon-Bellecour offre una vista panoramica sulla città e sul Rodano."
    ],
    "fr": [
      "Au cœur de Lyon, le Sofitel Lyon-Bellecour offre une vue panoramique sur la ville et le Rhône. Au programme de votre séjour 5* : gourmandise dans son restaurant, cocktails avec vue sur Lyon et session bien-être au So FIT."
    ],
    "nl": [
      "In het hart van Lyon biedt het Sofitel Lyon-Bellecour een panoramisch uitzicht over de stad en de Rhône. Op het programma van je 5-sterrenverblijf: gastronomische hoogstandjes in het restaurant, cocktails met uitzicht over Lyon en een wellnesssessie bij So FIT."
    ],
    "es": [
      "En pleno centro de Lyon, el Sofitel Lyon-Bellecour ofrece vistas panorámicas de la ciudad y el Ródano."
    ]
  },
