  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Resto des Bulles in Morzine, gegenüber dem Lac des Mines d'Or. Gesellig und gemütlich bietet es Fondues, Raclettes und lokale Spezialitäten in einer zauberhaften Umgebung mit atemberaubendem Blick auf die Berge."
    ],
    "en": [
      "Discover Resto des Bulles in Morzine, by the Mines d’Or lake. Cozy and welcoming, it serves fondues, raclettes, and local specialties, all in a magical setting with breathtaking mountain views."
    ],
    "it": [
      "Scoprite il Resto des Bulles a Morzine, di fronte al lago Mines d'Or. Questo ristorante caldo e accogliente offre fondute, raclettes e specialità locali, il tutto in un ambiente incantevole con una vista mozzafiato sulle montagne."
    ],
    "fr": [
      "Découvrez le Resto des Bulles à Morzine, face au lac des Mines d’Or. Convivial et chaleureux, il propose fondues, raclettes et spécialités locales, le tout dans un cadre enchanteur avec vue imprenable sur les montagnes."
    ],
    "nl": [
      "Ontdek Resto des Bulles in Morzine, bij het Lac des Mines d’Or. Gezellig en gastvrij, met fondues, raclettes en lokale specialiteiten, allemaal in een betoverende omgeving met adembenemend uitzicht op de bergen."
    ],
    "es": [
      "Descubra el Resto des Bulles en Morzine, frente al lago de Mines d'Or. Este cálido y acogedor restaurante ofrece fondues, raclettes y especialidades locales, todo ello en un entorno encantador con unas vistas impresionantes de las montañas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Resto - Les bulles des Mines d'or"
    ],
    "fr": [
      "Le Resto - Les bulles des Mines d'or"
    ],
    "nl": [
      "Le Resto - Les bulles des Mines d'or"
    ]
  },
