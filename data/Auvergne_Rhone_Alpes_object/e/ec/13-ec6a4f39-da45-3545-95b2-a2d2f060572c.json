  "rdfs:comment": {
    "de": [
      "Spiel, das es auf Le Bessat zu entdecken gilt! GOUTTELETTE, ein kleiner Wassertropfen, der aus einer Wolke entwischt ist, lädt dich ein, das Dorf und seine Geheimnisse anhand von Rätseln zu entdecken, die im Spielheft vorgeschlagen werden.\r\nEmpfohlen für Kinder von 5 bis 11 Jahren."
    ],
    "en": [
      "Discover Le Bessat! It's GOUTTELETTE, a little drop of water that has escaped from a cloud, who invites you to discover the village and its secrets through riddles in the game book.\r\nRecommended for ages 5 to 11."
    ],
    "it": [
      "Scoprite Le Bessat! È GOUTTELETTE, una piccola goccia d'acqua scappata da una nuvola, che vi invita a scoprire il villaggio e i suoi segreti attraverso gli indovinelli del libro-gioco.\r\nConsigliato dai 5 agli 11 anni."
    ],
    "fr": [
      "Jeu à découvrir sur Le Bessat ! C’est GOUTTELETTE, petite goutte d’eau échappée d’un nuage, qui t'invite à la découverte du village et de ses secrets grâce à des énigmes proposées sur le carnet de jeux.\r\nJeu conseillé de 5 à 11 ans."
    ],
    "es": [
      "¡Descubre Le Bessat! Es GOUTTELETTE, una gotita de agua que se ha escapado de una nube, quien te invita a descubrir el pueblo y sus secretos a través de las adivinanzas del libro-juego.\r\nRecomendado para niños de 5 a 11 años."
    ],
    "nl": [
      "Ontdek Le Bessat! Het is GOUTTELETTE, een kleine waterdruppel die uit een wolk is ontsnapt, die je uitnodigt om het dorp en zijn geheimen te ontdekken aan de hand van de raadsels in het spelboek.\r\nAanbevolen voor 5 tot 11 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Livret jeu \"Gouttelette - Sur le chemin de l'eau\""
    ]
  },
