  "rdfs:comment": {
    "de": [
      "Eine traditionelle, hausgemachte Küche aus frischen und hochwertigen Produkten. Thierry B., Le Cuisinier En 'Chanteur, seit mehreren Jahren erfolgreicher Solist, organisiert am Samstagabend eine Musikshow."
    ],
    "en": [
      "Traditional, home-cooked cuisine using fresh produce from local suppliers wherever possible. 50-seat Brasserie open Monday to Friday, 8am to 3pm (1:45pm last order) and dinner and show on Saturday evenings."
    ],
    "it": [
      "Cucina tradizionale casalinga con prodotti freschi e il più possibile locali. Brasserie con 50 posti a sedere aperta dal lunedì al venerdì dalle 8.00 alle 15.00 (13.45 ultimo ordine) e cena e spettacolo il sabato sera."
    ],
    "fr": [
      "Une cuisine traditionnelle faite maison à partir de produits frais et le plus possible en circuits courts. Brasserie de 50 places ouvert  du lundi au vendredi de 8h à 15h (13h45 dernière commande) et dîner spectacle le samedi soir."
    ],
    "nl": [
      "Traditionele huisgemaakte keuken met verse producten en zoveel mogelijk lokale producten. Brasserie met 50 zitplaatsen geopend van maandag tot vrijdag van 8.00 tot 15.00 uur (13.45 uur laatste bestelling) en diner en show op zaterdagavond."
    ],
    "es": [
      "Cocina casera tradicional con productos frescos de primera calidad. Thierry B., Le Cuisinier En 'Chanteur, solista experimentado desde hace varios años, organiza un espectáculo musical los sábados por la noche."
    ]
  },
  "rdfs:label": {
