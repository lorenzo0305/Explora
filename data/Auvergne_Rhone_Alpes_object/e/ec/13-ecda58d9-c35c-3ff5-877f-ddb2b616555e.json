  "rdfs:comment": {
    "de": [
      "Erwachsene Männer und Frauen und Jugendliche ab 16 Jahren (oder 13 Jahren, wenn sie von einem Erwachsenen begleitet werden).\r\n\r\nFreizeit.\r\nPraxis ist frei: Jeder kommt und geht, wann er will."
    ],
    "en": [
      "Adults and young people aged 16 and over (or 13 if accompanied by an adult).\r\n\r\nRecreational.\r\nPractice is free: come and go as you please."
    ],
    "it": [
      "Adulti, uomini e donne, e giovani a partire dai 16 anni (o 13 se accompagnati da un adulto).\r\n\r\nPer il tempo libero.\r\nLa pratica è libera: si può entrare e uscire a piacimento."
    ],
    "fr": [
      "Adultes hommes et femmes et jeunes à partir de 16 ans (ou 13 ans si accompagné d'un adulte). \r\n\r\nLoisir.\r\nPratique est libre : chacun vient et repart quand il veut."
    ],
    "nl": [
      "Volwassenen, mannen en vrouwen, en jongeren van 16 jaar en ouder (of 13 jaar indien begeleid door een volwassene).\r\n\r\nVoor vrije tijd.\r\nOefenen is gratis: kom en ga wanneer je wilt."
    ],
    "es": [
      "Adultos, hombres y mujeres, y jóvenes a partir de 16 años (o 13 si van acompañados de un adulto).\r\n\r\nPor ocio.\r\nLa práctica es libre: entra y sal cuando quieras."
    ]
  },
