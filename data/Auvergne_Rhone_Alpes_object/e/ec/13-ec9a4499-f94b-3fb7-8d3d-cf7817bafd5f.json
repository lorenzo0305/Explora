  "rdfs:comment": {
    "de": [
      "Familienhaus mit authentischem Charme, seit drei Generationen eine subtile Mischung aus Raffinesse und Einfachheit. Hotel-Restaurant mit Pool, beheiztem Jacuzzi und Fasssauna, geräumigen und komfortablen Zimmern, hausgemachter Gourmetküche."
    ],
    "en": [
      "A family home with authentic charm, a subtle blend of refinement and simplicity for three generations. Hotel-Restaurant with swimming pool, heated jacuzzi and barrel sauna, spacious, comfortable rooms, gourmet, home-cooked cuisine."
    ],
    "it": [
      "Accoglienza cordiale nel tranquillo parco ombreggiato, davanti alla spiaggia. Cucina raffinata, camere fresche e ampie. Per il vostro benessere, piscina e terrazze al sole."
    ],
    "fr": [
      "Maison de Famille au charme authentique, subtil mélange de raffinement et de simplicité depuis trois générations. Hôtel-Restaurant avec piscine, jacuzzi chauffé et sauna tonneau, chambres spacieuses et confortables, cuisine gourmande et faite maison."
    ],
    "es": [
      "Una casa familiar con auténtico encanto, una sutil mezcla de refinamiento y sencillez desde hace tres generaciones. Hotel-Restaurante con piscina, jacuzzi climatizado y sauna de barril, habitaciones amplias y confortables, cocina casera gourmet."
    ],
    "nl": [
      "Hartelijk ontvangst in een groot beschut park, tegenover het strand. Met zorg bereidde gerechten, frisse en ruime kamers. Voor uw welzijn, een zonovergoten zwembad en terras."
    ]
  },
