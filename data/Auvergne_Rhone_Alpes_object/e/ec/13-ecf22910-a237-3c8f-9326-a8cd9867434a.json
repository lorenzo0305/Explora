  "rdfs:comment": {
    "de": [
      "5 Minuten von Roanne entfernt bietet der Poney Club de Champlong verschiedene Aktivitäten von der Einführung bis zur Perfektionierung an: Ausritte, Praktika, Wettbewerbe, Pensionen, Sportstudien."
    ],
    "en": [
      "Just 5 minutes from Roanne, the Champlong Pony Club offers a wide range of activities from beginners to advanced riders, including rides, courses, competitions, boarding and sport-study."
    ],
    "it": [
      "A soli 5 minuti da Roanne, il Pony Club di Champlong offre un'ampia gamma di attività per i principianti e i cavalieri più esperti, tra cui passeggiate, corsi, concorsi, pensione e sport studenteschi."
    ],
    "fr": [
      "À 5 min de Roanne, le Poney Club de Champlong propose des activités variées de l'initiation au perfectionnement : promenades, stages, concours, pensions, sport-études."
    ],
    "nl": [
      "Op slechts 5 minuten van Roanne biedt de Champlong Pony Club een breed scala aan activiteiten voor beginners tot gevorderde ruiters, waaronder ritten, cursussen, wedstrijden, pension en studentensport."
    ],
    "es": [
      "A sólo 5 minutos de Roanne, el Pony Club de Champlong ofrece una amplia gama de actividades para jinetes principiantes y avanzados, como paseos, cursos, competiciones, pupilaje y deportes para estudiantes."
    ]
  },
  "rdfs:label": {
    "fr": [
