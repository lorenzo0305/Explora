  "rdfs:comment": {
    "de": [
      "Das Ritz ist ein Restaurant, das speziell für Senioren eingerichtet wurde. Es werden auch verschiedene Animationen angeboten: Gedächtnisworkshops, Spiele, Bastelaktivitäten usw. Es ist ein idealer Ort, um Spaß zu haben und neue Leute kennenzulernen."
    ],
    "en": [
      "The Ritz is a restaurant dedicated to seniors. A variety of activities are also on offer, including memory workshops, games and crafts. It's a great place to have fun and meet new people."
    ],
    "it": [
      "Il Ritz è un ristorante dedicato agli anziani. Vengono inoltre proposte diverse attività, tra cui laboratori di memoria, giochi e artigianato. È un luogo ideale per divertirsi e conoscere nuove persone."
    ],
    "fr": [
      "Le Ritz est un lieu de restauration dédié aux seniors. Des animations variées sont également proposées : des ateliers mémoire, des jeux, des activités manuelles, etc. C'est un endroit idéal pour s'amuser et rencontrer de nouvelles personnes."
    ],
    "nl": [
      "The Ritz is een restaurant speciaal voor senioren. Er worden ook allerlei activiteiten aangeboden, zoals geheugenworkshops, spelletjes en knutselen. Het is een geweldige plek om plezier te hebben en nieuwe mensen te ontmoeten."
    ],
    "es": [
      "El Ritz es un restaurante dedicado a las personas mayores. También se ofrecen diversas actividades, como talleres de memoria, juegos y manualidades. Es un lugar estupendo para divertirse y conocer gente nueva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Ritz"
    ]
  },
