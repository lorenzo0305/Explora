  "rdfs:comment": {
    "de": [
      "Die Stätten der Erinnerung an den Bergbau werden zur Feier der Heiligen Barbara in Flammen aufgehen!\nVon den Caribous des terrils und der Stadt Loos-en-Gohelle"
    ],
    "en": [
      "High places of mining memory set ablaze to celebrate Sainte Barbe!\nBy the Caribous des terrils and the City of Loos-en-Gohelle"
    ],
    "it": [
      "I cimeli minerari saranno incendiati per celebrare Sainte Barbe!\nPresso il Caribous des terrils e la città di Loos-en-Gohelle"
    ],
    "fr": [
      "Les hauts lieux de la mémoire minière vont s’enflammer pour célébrer Sainte Barbe !\nPar les Caribous des terrils et la Ville de Loos-en-Gohelle"
    ],
    "es": [
