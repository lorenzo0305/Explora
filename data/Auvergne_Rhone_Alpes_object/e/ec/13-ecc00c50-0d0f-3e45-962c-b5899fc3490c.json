  "rdfs:comment": {
    "de": [
      "Les Fils d'Emilie ist ein Atelier für Textildesign, das sich auf Seidenmalerei und Weben spezialisiert hat. Modeaccessoires: Schals, Broschen und Deko-Objekte sind in der Boutique erhältlich.Workshops für Kinder und Erwachsene werden angeboten( Schulferien)"
    ],
    "en": [
      "Les Fils d'Emilie is a textile workshop specializing in silk painting and weaving. Fashion accessories: scarves, brooches and decorative items are on sale at the boutique. Workshops for children and adults are available (school vacations)"
    ],
    "it": [
      "Les Fils d'Emilie è uno studio di design tessile specializzato in pittura e tessitura della seta. Nel negozio sono in vendita accessori di moda: sciarpe, spille e oggetti decorativi. Sono disponibili laboratori per bambini e adulti (vacanze scolastiche)"
    ],
    "fr": [
      "Les Fils d'Emilie, atelier de création textile est spécialisé dans la peinture sur soie et le tissage. Accessoires de mode : foulards, broches et objets déco sont en vente à la boutique.des ateliers pour enfant ou adulte sont proposés( vacances scolaires)"
    ],
    "nl": [
      "Les Fils d'Emilie is een textielontwerpstudio gespecialiseerd in zijdeschilderen en weven. Modeaccessoires: sjaals, broches en decoratieve artikelen zijn te koop in de winkel. Er zijn workshops voor kinderen en volwassenen (schoolvakanties)"
    ],
    "es": [
      "Les Fils d'Emilie es un estudio de diseño textil especializado en pintura y tejido de seda. En la tienda se venden accesorios de moda: pañuelos, broches y artículos de decoración. Se imparten talleres para niños y adultos (vacaciones escolares)"
    ]
  },
