  "rdfs:comment": {
    "de": [
      "L'éloge, ein \"gemütliches\" Restaurant mit rustikalem Ambiente. Es ist der ideale Ort, um am Nachmittag bei Musik zu essen oder etwas zu trinken, bevor Sie in Ihr Hotel oder Appartement gehen. Es befindet sich am Fuße der Pisten, 200 m von der Seilbahn entfernt."
    ],
    "en": [
      "L'éloge, a cosy restaurant in a rustic setting. It's the ideal place for an afternoon meal or drink, with music, before heading back to your hotel or flat. Located at the bottom of the slopes, 200 metres from the start of the cable car."
    ],
    "it": [
      "L'éloge, un ristorante accogliente in un ambiente rustico. È il luogo ideale per un pasto o un drink pomeridiano, con musica, prima di tornare in albergo o in appartamento. Si trova in fondo alle piste, a 200 metri dalla partenza della funivia."
    ],
    "fr": [
      "L'éloge, un restaurant \"cosy\" au cadre rustique. C'est l'endroit idéal pour manger ou prendre un verre en après-midi, en musique, avant de rejoindre votre hôtel ou appartement. Situé le bas des pistes, à 200 mètres du départ du téléphérique."
    ],
    "es": [
      "L'éloge, un restaurante acogedor en un entorno rústico. Es el lugar ideal para comer o tomar una copa por la tarde, con música, antes de regresar a su hotel o apartamento. Situado al pie de las pistas, a 200 metros de la salida del teleférico."
    ],
    "nl": [
      "L'éloge, een gezellig restaurant in een rustieke omgeving. Het is de ideale plek voor een middagmaal of een drankje met muziek, voordat je terugkeert naar je hotel of appartement. Gelegen onderaan de piste, op 200 meter van het vertrekpunt van de kabelbaan."
    ]
  },
