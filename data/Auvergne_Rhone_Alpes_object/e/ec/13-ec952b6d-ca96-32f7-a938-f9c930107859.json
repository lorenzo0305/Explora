  "rdfs:comment": {
    "de": [
      "Restaurant, Teestube und Café, handgemachtes Eis.\r\n\r\n\"Um die Dinge richtig zu machen, muss man sie mit Liebe, Leidenschaft und immer ein bisschen Verrücktheit machen ...\"."
    ],
    "en": [
      "Restaurant, tea room, artisanal ice cream.\r\n\r\n'To do things properly, you have to do them with love, passion and a little touch of madness…'"
    ],
    "it": [
      "Ristorante, sala da tè e caffè, gelati fatti in casa.\r\n\r\n\"Per fare le cose bene, bisogna farle con amore, passione e sempre un po' di follia?"
    ],
    "fr": [
      "Restaurant, Salon de thé et café, glaces artisanales.\r\n\r\n«Pour faire les choses bien, il faut les faire avec amour, passion et toujours un peu de folie… »"
    ],
    "es": [
      "Restaurante, salón de té y café, helados caseros.\r\n\r\n\"Para hacer las cosas bien, hay que hacerlas con amor, pasión y siempre un poco de locura...\""
    ],
    "nl": [
      "Restaurant, thee- en koffiekamer, huisgemaakt ijs.\r\n\r\n\"Om dingen goed te doen, moet je ze met liefde, passie en altijd een beetje gek doen...\"."
    ]
  },
