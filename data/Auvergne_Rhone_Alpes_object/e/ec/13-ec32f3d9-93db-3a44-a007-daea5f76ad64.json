  "rdfs:comment": {
    "de": [
      "Gerne wird Ihnen einer von uns unsere schöne Weinpalette vorstellen: Beaujolais-Villages rouge, rosé und blanc, unseren Viognier, unsere Crus: Régnié, Chiroubles und Morgon sowie unsere originellen Cuvées..."
    ],
    "en": [
      "One of us will be delighted to help you discover our fine range of wines: red, rosé and white Beaujolais-Villages, our Viognier, our Régnié, Chiroubles and Morgon crus and our original cuvées..."
    ],
    "it": [
      "Sarà un piacere per uno di noi presentarvi la nostra bella gamma di vini: Beaujolais-Villages rosso, rosato e bianco, il nostro Viognier, i nostri crus: Régnié, Chiroubles e Morgon e le nostre cuvée originali..."
    ],
    "fr": [
      "C'est avec plaisir que l'un d'entre nous vous fera découvrir notre belle gamme de vins : Beaujolais-Villages rouge, rosé et blanc, notre Viognier, nos crus : Régnié, Chiroubles et Morgon et nos cuvées originales..."
    ],
    "es": [
      "Será un placer para uno de nosotros presentarle nuestra hermosa gama de vinos: Beaujolais-Villages tinto, rosado y blanco, nuestro Viognier, nuestros crus: Régnié, Chiroubles y Morgon y nuestras cuvées originales..."
    ],
    "nl": [
      "Het zal een genoegen zijn om u kennis te laten maken met ons prachtige assortiment wijnen: rode, rosé en witte Beaujolais-Villages, onze Viognier, onze crus: Régnié, Chiroubles en Morgon en onze originele cuvées..."
    ]
  },
