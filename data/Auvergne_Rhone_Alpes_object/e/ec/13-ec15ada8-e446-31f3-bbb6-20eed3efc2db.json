  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese Kunstausstellung mit den Arbeiten der Mitglieder des Ateliers unter den Werken von drei Künstlern:\r\n- Gwendoline Chanel Delhomme, Malerin, die sich auf Blattgold spezialisiert hat\r\n- Sandrine Laroche, Fotografin\r\n- Hervé Buldrini, Bildhauer."
    ],
    "en": [
      "Come and discover this art exhibition featuring the work of Atelier members, among works by three artists:\r\n- Gwendoline Chanel Delhomme, gold-leaf painter\r\n- Sandrine Laroche, photographer\r\n- Hervé Buldrini, sculptor."
    ],
    "it": [
      "Venite a scoprire questa mostra d'arte che presenta il lavoro dei membri dell'Atelier e le opere di tre artisti:\r\n- Gwendoline Chanel Delhomme, pittrice su foglia d'oro\r\n- Sandrine Laroche, fotografa\r\n- Hervé Buldrini, scultore."
    ],
    "fr": [
      "Venez découvrir cette exposition artistique avec les travaux des membres de l'Atelier parmi les œuvres de trois artistes : \r\n- Gwendoline Chanel Delhomme, peintre spécialiste de la feuille d'or\r\n- Sandrine Laroche, photographe\r\n- Hervé Buldrini, sculpteur."
    ],
    "es": [
      "Venga a descubrir esta exposición de arte con obras de los miembros del Atelier y obras de tres artistas:\r\n- Gwendoline Chanel Delhomme, pintora de pan de oro\r\n- Sandrine Laroche, fotógrafa\r\n- Hervé Buldrini, escultor."
    ],
    "nl": [
      "Kom en ontdek deze kunsttentoonstelling met het werk van leden van het Atelier en werken van drie kunstenaars:\r\n- Gwendoline Chanel Delhomme, schilder van bladgoud\r\n- Sandrine Laroche, fotografe\r\n- Hervé Buldrini, beeldhouwer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition Artistique"
    ]
  },
