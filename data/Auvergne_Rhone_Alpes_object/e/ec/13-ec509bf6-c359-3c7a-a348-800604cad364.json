  "rdfs:comment": {
    "de": [
      "Heute sind Sie Jean du Rhône! Die Widerstandskämpfer haben Sie mit einer gefährlichen Sabotageaktion beauftragt.\r\nIn diesem Spiel werden Ihre Intelligenz, Ihr Orientierungssinn und Ihre Diskretion auf die Probe gestellt, um Ihre Mission erfolgreich abzuschließen."
    ],
    "en": [
      "Today you're Jean du Rhône! The Resistance has entrusted you with a dangerous sabotage operation.\r\nYour intelligence, sense of direction and discretion will be put to the test as you carry out your mission."
    ],
    "it": [
      "Oggi sei Jean du Rhône! La Resistenza ti ha affidato una pericolosa operazione di sabotaggio.\r\nLa vostra intelligenza, il vostro senso dell'orientamento e la vostra discrezione saranno messi alla prova mentre portate a termine la vostra missione."
    ],
    "fr": [
      "Aujourd'hui vous êtes Jean du Rhône! Les résistants vous confient une opération périlleuse de sabotage.\r\nLors de cet enquête game votre l'intelligence, votre sens de l'orientation et votre discrétion seront mis à l'épreuve pour mener à bien votre mission."
    ],
    "nl": [
      "Vandaag ben jij Jean du Rhône! Het Verzet heeft je een gevaarlijke sabotageoperatie toevertrouwd.\r\nJe intelligentie, richtingsgevoel en discretie worden op de proef gesteld bij het uitvoeren van je missie."
    ],
    "es": [
      "Hoy eres Jean du Rhône La Resistencia te ha confiado una peligrosa operación de sabotaje.\r\nTu inteligencia, sentido de la orientación y discreción se pondrán a prueba en el cumplimiento de tu misión."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Enquête Game Jean du Rhône ou l'ombre de la Résistance"
    ]
  },
