  "rdfs:comment": {
    "de": [
      "Dieser touristische Rundgang mit etwa 15 Tafeln und Pulten führt den Besucher und hebt das bauliche und kulturelle Erbe von Cérilly hervor, das das Privileg hatte, mehrere berühmte Persönlichkeiten geboren zu haben."
    ],
    "en": [
      "This tourist trail of some fifteen plaques and desks guides the visitor and highlights the built and cultural heritage of Cérilly, which has had the privilege of being the birthplace of several famous personalities."
    ],
    "it": [
      "Questo percorso turistico, composto da una quindicina di targhe e pannelli, guida i visitatori e mette in evidenza il patrimonio edilizio e culturale di Cérilly, che ha avuto il privilegio di dare i natali a numerosi personaggi famosi."
    ],
    "fr": [
      "Ce parcours touristique d’une quinzaine de plaques et pupitres guide le visiteur et met en valeur le patrimoine bâti et culturel de Cérilly, qui a eu le privilège de voir naître plusieurs personnalités de renom."
    ],
    "es": [
      "Este recorrido turístico de una quincena de placas y paneles guía a los visitantes y pone de relieve el patrimonio edificado y cultural de Cérilly, que ha tenido el privilegio de ser la cuna de numerosas personalidades célebres."
    ],
    "nl": [
      "Dit toeristische parcours van een vijftiental borden en panelen begeleidt bezoekers en belicht het gebouwde en culturele erfgoed van Cérilly, dat het voorrecht had de geboorteplaats te zijn van een aantal beroemde persoonlijkheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Culturel de Cérilly"
    ]
  },
