  "rdfs:comment": {
    "de": [
      "Diese Biere werden im Herzen von Clermont-Ferrand selbst gebraut. Alle Biere werden mit lokalen Rohstoffen gebraut und sind mit dem Zertifikat für biologischen Landbau ausgezeichnet."
    ],
    "en": [
      "Beers brewed by us in the heart of Clermont-Ferrand. All our beers are brewed with local raw materials and are certified organic."
    ],
    "it": [
      "Birre prodotte da noi nel cuore di Clermont-Ferrand. Tutte le nostre birre sono prodotte con materie prime locali e sono certificate biologiche."
    ],
    "fr": [
      "Bières brassées au cœur de Clermont-Ferrand par nos soins. Toutes les bières sont brassées avec des matières premières locales et sont certifiées Agriculture biologique."
    ],
    "es": [
      "Cervezas elaboradas por nosotros en el corazón de Clermont-Ferrand. Todas nuestras cervezas se elaboran con materias primas locales y tienen certificación ecológica."
    ],
    "nl": [
      "Bieren door ons gebrouwen in het hart van Clermont-Ferrand. Al onze bieren worden gebrouwen met lokale grondstoffen en zijn biologisch gecertificeerd."
    ]
  },
