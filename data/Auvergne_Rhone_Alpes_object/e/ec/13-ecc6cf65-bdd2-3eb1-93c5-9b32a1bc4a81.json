  "rdfs:comment": {
    "de": [
      "Das mit zwei Sternen ausgezeichnete Hotel-Restaurant L'Eveil des Sens befindet sich im Herzen der Region Forez.Entdecken Sie seine 6 modernen und geräumigen Zimmer, von denen 3 für Personen mit eingeschränkter Mobilität zugänglich sind."
    ],
    "en": [
      "The two-star hotel and restaurant L'Eveil des Sens is located in the heart of the Forez. Come and discover its 6 modern and spacious rooms (3 with disabled access)."
    ],
    "it": [
      "Nel cuore dei vigneti della Côtes du Forez, nel villaggio di Trelins, a due passi dalla città di Boën, l'hotel L'éveil des sens offre sei camere moderne e spaziose. L'hotel ha un'atmosfera familiare e la cucina dello chef è da assaporare."
    ],
    "fr": [
      "Au coeur du vignoble des Côtes du Forez, dans le village de Trelins à deux pas de la ville de Boën, l'hôtel L'éveil des sens propose six chambres modernes et spacieuses. L'ambiance y est familiale et la cuisine du chef à savourer."
    ],
    "nl": [
      "In het hart van de wijngaarden van de Côtes du Forez, in het dorp Trelins, op een steenworp afstand van de stad Boën, biedt hotel L'éveil des sens zes moderne en ruime kamers. In het hotel heerst een familiaire sfeer en de keuken van de chef is om van te smullen."
    ],
    "es": [
      "En el corazón de los viñedos de Côtes du Forez, en el pueblo de Trelins, a un paso de la ciudad de Boën, el hotel L'éveil des sens ofrece seis habitaciones modernas y espaciosas. El hotel tiene un ambiente familiar y la cocina del chef es para saborear."
    ]
  },
