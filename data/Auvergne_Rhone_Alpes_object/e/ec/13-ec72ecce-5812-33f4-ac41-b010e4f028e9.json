  "rdfs:comment": {
    "de": [
      "Radio Royans ist ein allgemeiner Radiosender, der in Teilen von Royans Vercors, Sud Grésivaudan und dem Pays de Romans sendet. Der Sender ist eine der wenigen Nachrichtensendungen, die in den Regionen Drôme und Isère gemeinsam ausgestrahlt werden."
    ],
    "en": [
      "Radio Royans is a general-interest radio station broadcasting to parts of Royans Vercors, Sud Grésivaudan and the Pays de Romans. It is also one of the only news stations to cover both Drôme and Isère."
    ],
    "it": [
      "Radio Royans è una stazione radiofonica di interesse generale che trasmette in alcune zone di Royans Vercors, Sud Grésivaudan e nella regione di Romans. È anche una delle uniche stazioni di notizie che trasmette sia nella Drôme che nell'Isère."
    ],
    "fr": [
      "Radio Royans est une radio généraliste qui émet sur une partie du Royans Vercors, du Sud Grésivaudan et le Pays de Romans. Elle représente par ailleurs une des seule informations communes à la Drôme et à l’ Isère."
    ],
    "nl": [
      "Radio Royans is een radiostation van algemene aard dat uitzendt in delen van Royans Vercors, Sud Grésivaudan en de Romaanse regio. Het is ook een van de enige nieuwszenders die zowel in de Drôme als in de Isère uitzendt."
    ],
    "es": [
      "Radio Royans es una emisora de radio generalista que emite en algunas zonas de Royans Vercors, Sud Grésivaudan y la región de Romans. También es una de las únicas emisoras de información que emite en las regiones de Drôme e Isère."
    ]
  },
