  "rdfs:comment": {
    "de": [
      "Matilda Intérieur empfängt Sie in einer warmen und authentischen Atmosphäre für Innendekoration, handgemachtes Kunsthandwerk und die Renovierung von Möbeln, Sesseln und Tapeten, die Anfertigung von Heimtextilien und den Verkauf von handgefertigtem Schmuck."
    ],
    "en": [
      "Matilda Intérieur welcomes you in a warm and authentic atmosphere for interior decoration, handmade crafts and renovation of furniture, armchairs and upholstery, household linen making and sales of handcrafted jewelry."
    ],
    "it": [
      "Matilda Intérieur vi accoglie in un'atmosfera calda e autentica per la decorazione d'interni, l'artigianato e la ristrutturazione di mobili, poltrone e tappezzerie, la produzione di biancheria per la casa e la vendita di gioielli artigianali."
    ],
    "fr": [
      "Matilda Intérieur vous accueille dans une ambiance chaleureuse et authentique pour la décoration d'intérieur, l'artisanat fait main et la rénovation de meubles, fauteuils et tapisserie, confection de linge de maison et vente de bijoux artisanaux."
    ],
    "nl": [
      "Matilda Intérieur verwelkomt je in een warme en authentieke sfeer voor interieurdecoratie, handwerk en renovatie van meubels, fauteuils en stoffering, het maken van huishoudlinnen en de verkoop van handgemaakte sieraden."
    ],
    "es": [
      "Matilda Intérieur le acoge en un ambiente cálido y auténtico para la decoración de interiores, la artesanía y la renovación de muebles, sillones y tapicerías, la confección de ropa de hogar y la venta de joyas artesanales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Matilda Décoration"
    ]
  },
