  "rdfs:comment": {
    "de": [
      "Die Jardins de Pondron begrüßen Sie ab dem 4. April 2026 jeden Samstagmorgen von 10:00 bis 12:30 Uhr für einen Verkauf ab Hof.\nFinden Sie Ihr Gemüse wieder."
    ],
    "en": [
      "From April 4, 2026, Les Jardins de Pondron will welcome you every Saturday morning from 10am to 12:30pm for a farm sale.\nFind your vegetables."
    ],
    "it": [
      "Dal 4 aprile 2026, Les Jardins de Pondron organizzano una vendita di prodotti agricoli ogni sabato mattina dalle 10 alle 12.30.\nTrovate la vostra verdura."
    ],
    "fr": [
      "Les Jardins de Pondron vous accueillent à partir du 4 avril 2026 chaque samedi matin de 10H à 12H30 pour une vente à la ferme.\nRetrouvez vos légumes."
    ],
    "nl": [
      "Vanaf 4 april 2026 houdt Les Jardins de Pondron elke zaterdagochtend van 10.00 tot 12.30 uur een boerderijverkoop.\nVind uw groenten."
    ],
    "es": [
      "A partir del 4 de abril de 2026, Les Jardins de Pondron organizan una venta agrícola todos los sábados por la mañana, de 10.00 a 12.30 h.\nEncuentre sus verduras."
    ]
  },
