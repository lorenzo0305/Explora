  "rdfs:comment": {
    "de": [
      "Baby-Pony (2 bis 4 Jahre), Ponykurs (4 bis 8 Jahre) und Groß-Ponykurs (8 bis 10 Jahre).\r\nKurse für Anfänger, Fortgeschrittene und Erwachsene: Wettkampf und Freizeit.\r\nWanderungen für Jugendliche und Erwachsene.\r\nTages- oder mehrtägige Praktika."
    ],
    "en": [
      "Baby pony (2 to 4 years), pony course (4 to 8 years) and big pony course (8 to 10 years).\r\nBeginner, advanced and adult courses: competition and leisure.\r\nRides for teenagers and adults.\r\nFull-day or longer courses."
    ],
    "it": [
      "Baby pony (da 2 a 4 anni), corso pony (da 4 a 8 anni) e corso big pony (da 8 a 10 anni).\r\nCorsi per principianti, avanzati e adulti: competizione e tempo libero.\r\nCavalcate per adolescenti e adulti.\r\nCorsi per un giorno o più."
    ],
    "fr": [
      "Baby-poney (2 à 4 ans), cours poney (4 à 8 ans) et cours grand poney (8 à 10 ans). \r\nCours débutants, confirmés, adultes : compétition et loisir.\r\nRandonnées adolescents et adultes.\r\nStages à la journée ou plus."
    ],
    "es": [
      "Baby pony (de 2 a 4 años), curso para ponis (de 4 a 8 años) y curso para ponis grandes (de 8 a 10 años).\r\nCursos para principiantes, avanzados y adultos: competición y ocio.\r\nPaseos para adolescentes y adultos.\r\nCursos de un día o más."
    ],
    "nl": [
      "Baby pony (2 tot 4 jaar), pony cursus (4 tot 8 jaar) en grote pony cursus (8 tot 10 jaar).\r\nLessen voor beginners, gevorderden en volwassenen: wedstrijden en vrije tijd.\r\nRitten voor tieners en volwassenen.\r\nCursussen van één dag of langer."
    ]
  },
