  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c5a5500d-3639-32bc-8bb6-f540d2ae2691",
      "dc:description": {
        "de": [
          "Ein Ort für temporäre Ausstellungen, der sich auf dem Promenadendamm von Wimereux befindet.\nDieser Ausstellungsort ist ein Muss in Wimereux\nGalerie täglich von 11 bis 12.30 Uhr und von 14.30 bis 18 Uhr geöffnet"
        ],
        "en": [
          "A temporary exhibition space located on the Wimereux promenade.\nThis exhibition space is a must-see in Wimereux\nGallery open daily from 11am to 12:30pm and from 2:30pm to 6pm"
        ],
        "it": [
          "Uno spazio espositivo temporaneo situato sul lungomare di Wimereux.\nQuesto spazio espositivo è una tappa obbligata a Wimereux\nGalleria aperta tutti i giorni dalle 11.00 alle 12.30 e dalle 14.30 alle 18.00"
        ],
        "fr": [
          "Un lieu d'exposition temporaire situé sur la digue promenade de Wimereux.\nCe lieu d'exposition est un lieu incontournable à Wimereux \nGalerie ouverte tous les jours de 11h à 12h30 et de 14h30 à 18h"
        ],
        "es": [
          "Un espacio de exposición temporal situado en el paseo marítimo de Wimereux.\nEste espacio de exposición es una visita obligada en Wimereux\nGalería abierta todos los días de 11.00 a 12.30 h. y de 14.30 a 18.00 h"
        ],
        "nl": [
          "Een tijdelijke tentoonstellingsruimte op de promenade van Wimereux.\nDeze tentoonstellingsruimte is een must in Wimereux\nElke dag open van 11u tot 12u30 en van 14u30 tot 18u"
        ]
      },
