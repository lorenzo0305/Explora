  "rdfs:comment": {
    "de": [
      "Cartes Blanches ist ein Jubiläumstreffen, das als Ort des freundschaftlichen und komplizenhaften Wiedersehens zwischen mehreren Tänzern aus der Geschichte der Kompanie Käfig konzipiert ist."
    ],
    "en": [
      "Cartes Blanches is an anniversary event conceived as a friendly reunion between several of the dancers who have marked the history of Compagnie Käfig."
    ],
    "it": [
      "Cartes Blanches è un evento di anniversario pensato per riunire gli amici e i complici di alcuni danzatori che hanno segnato la storia della Compagnie Käfig."
    ],
    "fr": [
      "Cartes Blanches est un rendez-vous anniversaire conçu comme le lieu de retrouvailles amicales et complices entre plusieurs danseurs ayant jalonné l’histoire de la compagnie Käfig."
    ],
    "nl": [
      "Cartes Blanches is een jubileumevenement dat bedoeld is om de vrienden en handlangers samen te brengen van verschillende dansers die de geschiedenis van de Compagnie Käfig hebben getekend."
    ],
    "es": [
      "Cartes Blanches es un acto de aniversario concebido para reunir a los amigos y cómplices de varios bailarines que han marcado la historia de la Compagnie Käfig."
    ]
  },
