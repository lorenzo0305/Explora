  "rdfs:comment": {
    "de": [
      "Im Rahmen der von der Communauté de communes Loire Semène finanzierten Einrichtung des Natur- und Tourismusgebiets von La Séauve sur Semène wurden gerade neue Outdoor-Geräte am Wasserplan installiert."
    ],
    "en": [
      "As part of the development of the natural and tourist area of La Séauve sur Semène, financed by the Loire Semène community of municipalities, new outdoor equipment has just been installed at the lake."
    ],
    "it": [
      "Nell'ambito dello sviluppo dell'area naturale e turistica di La Séauve sur Semène, finanziato dalla comunità di comuni Loire Semène, sono state appena installate nuove attrezzature per l'outdoor al lago."
    ],
    "fr": [
      "Dans le cadre de l'aménagement de l'aire naturelle et touristique de la Séauve sur Semène financé par la communauté de communes Loire Semène, de nouveaux équipements d'extérieur viennent d'être installés au plan d'eau."
    ],
    "nl": [
      "In het kader van de ontwikkeling van het natuur- en toeristische gebied van La Séauve sur Semène, gefinancierd door de gemeente Loire Semène, zijn er onlangs nieuwe buitenuitrustingen geïnstalleerd bij het meer."
    ],
    "es": [
      "En el marco del desarrollo de la zona natural y turística de La Séauve sur Semène, financiado por la Mancomunidad de Municipios del Loira Semène, acaban de instalarse nuevos equipamientos exteriores en el lago."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace naturel de la Semène"
    ]
  },
