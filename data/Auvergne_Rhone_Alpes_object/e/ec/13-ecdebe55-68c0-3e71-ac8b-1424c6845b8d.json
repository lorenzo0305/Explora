  "rdfs:comment": {
    "de": [
      "Die vom Verein CACIAURA verwaltete Festung, die seit 1926 unter Denkmalschutz steht, wurde Anfang des 13. Jahrhunderts erbaut. Jahrhunderts errichtet. Sie besteht aus einem Burgkern mit neun Türmen (von denen drei teilweise zerstört sind), der von einer Ringmauer umgeben ist."
    ],
    "en": [
      "Guided tour. Built at the beginning of the 13th century on a limestone hillock, partially modified and completed in the 15th century, the castle is composed of a castral core of nine towers (three of which are partly destroyed), surrounded by a circular enclosure."
    ],
    "it": [
      "Gestita dall'associazione CACIAURA, la fortezza, classificata come monumento storico dal 1926, fu costruita all'inizio del XIII secolo. È costituita da un nucleo castrale di nove torri (tre delle quali parzialmente distrutte), circondato da un recinto."
    ],
    "fr": [
      "Gérée par l'association CACIAURA, la forteresse, classée monument historique depuis 1926, a été construite au début du XIIIe siècle. Elle se compose d'un noyau castral de neuf tours (dont trois sont en partie détruites), entourée d'une enceinte."
    ],
    "nl": [
      "Het fort wordt beheerd door de vereniging CACIAURA en staat sinds 1926 op de monumentenlijst. Het werd gebouwd in het begin van de 13e eeuw. Het bestaat uit een castrale kern van negen torens (waarvan er drie gedeeltelijk zijn verwoest), omringd door een ommuring."
    ],
    "es": [
      "Gestionada por la asociación CACIAURA, la fortaleza, catalogada como monumento histórico desde 1926, fue construida a principios del siglo XIII. Consta de un núcleo castral de nueve torres (tres de las cuales están parcialmente destruidas), rodeado de un recinto."
    ]
  },
  "rdfs:label": {
    "en": [
      "Medieval Fortress of Montaigu-le-Blin"
    ],
    "fr": [
      "La Forteresse Médiévale de Montaigu-le-Blin et ses symboles laisse place aux bénévoles"
    ]
  },
