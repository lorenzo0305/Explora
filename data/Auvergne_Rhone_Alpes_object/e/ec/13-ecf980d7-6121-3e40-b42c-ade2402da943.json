  "rdfs:comment": {
    "de": [
      "Wir bieten eine qualitativ hochwertige Küche, die mit frischen und lokalen Zutaten zubereitet wird. Unsere abwechslungsreiche Speisekarte bietet eine große Auswahl an Gerichten für jeden Geschmack, wobei das Budget und der Zeitplan eingehalten werden."
    ],
    "en": [
      "We offer top-quality cuisine prepared with fresh, local ingredients. Our varied menu offers a wide choice of dishes to suit all tastes, while respecting budgets and deadlines."
    ],
    "it": [
      "La nostra cucina è di altissima qualità, preparata con ingredienti freschi e locali. Il nostro variegato menu offre un'ampia scelta di piatti per tutti i gusti, nel rispetto del budget e delle scadenze."
    ],
    "fr": [
      "Nous proposons une cuisine de qualité supérieure, préparée avec des ingrédients frais et locaux. Notre menu varié offre un large choix de plats pour tous les goûts, tout en respectant les budgets et les délais."
    ],
    "nl": [
      "Onze keuken is van de hoogste kwaliteit, bereid met verse, lokale ingrediënten. Ons gevarieerde menu biedt een ruime keuze aan gerechten voor elke smaak, alles binnen het budget en op tijd."
    ],
    "es": [
      "Nuestra cocina es de la más alta calidad, elaborada con ingredientes frescos y locales. Nuestra variada carta ofrece una amplia selección de platos para todos los gustos, todo ello dentro del presupuesto y con puntualidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Guinguette du Lac"
    ]
  },
