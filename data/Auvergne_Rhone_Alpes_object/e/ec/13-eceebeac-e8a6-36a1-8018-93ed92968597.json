  "rdfs:comment": {
    "de": [
      "9.30 Uhr: Frühstück mit J-M Ghitti, Gelegenheit zum Austausch über seinen Vortrag vom Vortag und sein Buch \"La Terre confisquée. Critique de l'aménagement du territoire\" zu sprechen. Verzehr vor Ort zu bezahlen."
    ],
    "en": [
      "9:30am: Breakfast with J-M Ghitti, an opportunity to discuss his talk from the previous day and his book \"La Terre confisquée. Critique de l'aménagement du territoire\". Consumption to be paid for on site."
    ],
    "it": [
      "9.30: Colazione con J-M Ghitti, occasione per discutere del suo intervento del giorno precedente e del suo libro \"La Terre confisquée. Critique de l'aménagement du territoire\". Consumazione da pagare in loco."
    ],
    "fr": [
      "9h30 : Petit-déjeuner avec J-M Ghitti, l'occasion d'échanger sur son intervention de la veille et sur son ouvrage \"La Terre confisquée. Critique de l'aménagement du territoire\". Consommations à régler sur place."
    ],
    "nl": [
      "9.30 uur: Ontbijt met J-M Ghitti, gelegenheid om zijn toespraak van de vorige dag en zijn boek \"La Terre confisquée. Critique de l'aménagement du territoire\". Consumpties ter plaatse te betalen."
    ],
    "es": [
      "9.30 h: Desayuno con J-M Ghitti, ocasión para debatir sobre su discurso del día anterior y su libro \"La Terre confisquée. Critique de l'aménagement du territoire\". Consumición a pagar in situ."
    ]
  },
