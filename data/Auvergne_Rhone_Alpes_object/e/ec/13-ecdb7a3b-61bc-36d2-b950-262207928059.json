  "rdfs:comment": {
    "de": [
      "Traditioneller Lebensmittelladen, Fleisch (Schwein, Rind, Kaninchen), Käse, Wurstwaren von benachbarten Produzenten, Obst, Gemüse. Catering-Service traditionelle Küche und iranische Küche. Für Gruppen und Familienfeiern auf Reservierung."
    ],
    "en": [
      "Traditional grocery store, meat (pork, beef, rabbit), cheese, cold cuts from nearby producers, fruits, vegetables. Catering service for traditional and Iranian cuisine. For groups and family parties on reservation."
    ],
    "it": [
      "Alimentari tradizionali, carne (maiale, manzo, coniglio), formaggi, salumi di produttori vicini, frutta, verdura. Servizio di catering per la cucina tradizionale e iraniana. Per gruppi e famiglie su prenotazione."
    ],
    "fr": [
      "Épicerie traditionnelle, viande (porc, bœuf, lapin), fromage, charcuterie des producteurs voisins, fruits, légumes. Service traiteur cuisine traditionnelle et cuisine iranienne. Pour groupes et fêtes de famille sur réservation."
    ],
    "nl": [
      "Traditionele levensmiddelen, vlees (varkensvlees, rundvlees, konijn), kaas, vleeswaren van nabijgelegen producenten, fruit, groenten. Catering service voor traditionele en Iraanse gerechten. Voor groepen en familiefeesten op reservering."
    ],
    "es": [
      "Comestibles tradicionales, carne (cerdo, ternera, conejo), queso, embutidos de productores cercanos, fruta, verdura. Servicio de catering de cocina tradicional e iraní. Para grupos y fiestas familiares previa reserva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au bon panier"
    ]
  },
