  "rdfs:comment": {
    "de": [
      "Die Crew des Roi Louis (11m Segelboot mit 3 Kabinen) bietet Ihnen Ausflüge auf dem Genfersee mit Skipper, Tages- oder Halbtagestouren sowie Einführungs- und Segelkurse."
    ],
    "en": [
      "The crew of the Roi Louis (11m sailboat with 3 cabins) offers excursions on Lake Geneva with skipper, day or half day as well as introductory and advanced sailing courses."
    ],
    "it": [
      "L'equipaggio del Roi Louis (una barca a vela di 11 metri con 3 cabine) offre escursioni sul Lago di Ginevra con uno skipper, di un giorno o di mezza giornata, nonché corsi di vela introduttivi e avanzati."
    ],
    "fr": [
      "L'équipage du Roi Louis (voilier de 11m avec 3 cabines ) vous propose des excursions sur le lac Léman avec skipper,  à la journée ou à la demi-journée ainsi que des cours d'initiation et de perfectionnement à la voile."
    ],
    "es": [
      "La tripulación del Roi Louis (velero de 11 metros con 3 camarotes) ofrece excursiones por el lago Lemán con patrón, de un día o medio día, así como cursos de iniciación y perfeccionamiento a la vela."
    ],
    "nl": [
      "De bemanning van Roi Louis (een zeilboot van 11 meter met 3 hutten) biedt excursies op het meer van Genève met een schipper, per dag of halve dag, en ook introductie- en gevorderde zeilcursussen."
    ]
  },
