  "rdfs:comment": {
    "de": [
      "Boutique/Atelier für Kunst und Kunsthandwerk aus der Auvergne in Châtel-Guyon\r\nFast 30 Künstler und Kunsthandwerker stellen ihre Werke zum Verkauf aus, einige von ihnen bieten aber auch Workshops an."
    ],
    "en": [
      "Auvergne arts and crafts shop/workshop in Châtel-Guyon\r\nNearly 30 artists and craftspeople will be on hand to sell their wares, and some will be on hand to run introductory workshops."
    ],
    "it": [
      "Negozio/laboratorio di arti e mestieri dell'Alvernia a Châtel-Guyon\r\nQuasi 30 artisti e artigiani saranno presenti per vendere le loro opere e alcuni di loro offriranno laboratori introduttivi."
    ],
    "fr": [
      "Boutique/Atelier d'art et d'artisanat auvergnats à Châtel-Guyon\r\nPrés de 30 artistes et artisans seront exposés à la vente mais également pour certains viendront animer des ateliers d'initiation."
    ],
    "es": [
      "Tienda-taller de artesanía de Auvernia en Châtel-Guyon\r\nCerca de 30 artistas y artesanos estarán presentes para vender sus obras, y algunos de ellos ofrecerán talleres de iniciación."
    ],
    "nl": [
      "Kunstnijverheidswinkel/workshop in de Auvergne in Châtel-Guyon\r\nBijna 30 kunstenaars en ambachtslieden zullen aanwezig zijn om hun werk te verkopen en sommigen van hen zullen inleidende workshops aanbieden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique 2 curiosités"
    ]
  },
