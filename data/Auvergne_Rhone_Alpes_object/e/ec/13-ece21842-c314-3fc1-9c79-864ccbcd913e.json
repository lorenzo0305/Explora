  "rdfs:comment": {
    "de": [
      "Halten Sie vom Dorfzentrum aus die Augen offen nach einem großen Haus mit zwei Türmen auf einem Hügel. Es ist das Château de Rochefort, auch bekannt als Mandrins Schloss. Das Schloss befindet sich in Privatbesitz und kann nicht besichtigt werden. Bewundern Sie es von hier aus."
    ],
    "en": [
      "From the village center, open your eyes and look for a large house with two towers on the top of a hill. This is Château de Rochefort, otherwise known as Château de Mandrin. This privately-owned castle cannot be visited. Admire it from here."
    ],
    "it": [
      "Dal centro del villaggio, aprite gli occhi e cercate una grande casa con due torri in cima a una collina. Si tratta dello Château de Rochefort, altrimenti noto come Château de Mandrin. Questo castello è privato e non può essere visitato. Ammiratelo da qui."
    ],
    "fr": [
      "Depuis le centre du village, ouvrez les yeux, cherchez une grosse maison munies de deux tours sur les hauteurs d'une colline. C'est le Château de Rochefort, autrement appelé Château de Mandrin. Ce château, privé, n'est pas visitable. Admirez-le d'ici."
    ],
    "nl": [
      "Open je ogen vanuit het centrum van het dorp en kijk uit naar een groot huis met twee torens op de top van een heuvel. Dit is het Château de Rochefort, ook wel bekend als het Château de Mandrin. Dit kasteel is privé en kan niet worden bezocht. Bewonder het vanaf hier."
    ],
    "es": [
      "Desde el centro del pueblo, abra bien los ojos y busque una gran casa con dos torres en lo alto de una colina. Es el castillo de Rochefort, también conocido como castillo de Mandrin. Este castillo es privado y no se puede visitar. Admírelo desde aquí."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village de Rochefort et son château"
    ]
  },
