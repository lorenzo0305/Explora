  "rdfs:comment": {
    "de": [
      "Das Haus der Familie Lumière wurde zwischen 1899 und 1902 im Jugendstil erbaut. Dieses Haus beherbergt heute das Lumière-Museum, das der Erfindung des Kinos gewidmet ist."
    ],
    "en": [
      "House of the Lumière family built between 1899 and 1902 in Art Nouveau style. This house now houses the Lumière Museum dedicated to the invention of cinema."
    ],
    "it": [
      "Casa della famiglia Lumière costruita tra il 1899 e il 1902 in stile Art Nouveau. Questa casa ospita oggi il Museo Lumière, dedicato all'invenzione del cinema."
    ],
    "fr": [
      "Maison de la famille Lumière construite entre 1899 et 1902 dans le style Art nouveau. Cette maison abrite aujourd'hui le Musée Lumière dédié à l'invention du cinéma."
    ],
    "nl": [
      "Huis van de familie Lumière gebouwd tussen 1899 en 1902 in Art Nouveau stijl. In dit huis is nu het Lumière Museum gevestigd, gewijd aan de uitvinding van de cinema."
    ],
    "es": [
      "Casa de los Lumière construida entre 1899 y 1902 en estilo Art Nouveau. Esta casa alberga ahora el Museo Lumière, dedicado a la invención del cine."
    ]
  },
