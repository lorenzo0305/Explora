  "rdfs:comment": {
    "de": [
      "Das savoyische Restaurant Chez Augustine ist ein raffinierter und geselliger Bergtisch, an dem mit Präzision und Einfachheit regional und mit lokalen Produkten gekocht wird."
    ],
    "en": [
      "The Savoyard restaurant Chez Augustine is a refined and friendly mountain eatery, where local produce is cooked with precision and simplicity."
    ],
    "it": [
      "Il ristorante savoiardo Chez Augustine è un locale di montagna raffinato e accogliente, dove si cucinano prodotti locali con precisione e semplicità."
    ],
    "fr": [
      "Le restaurant savoyard Chez Augustine est une table de montagne raffinée et conviviale, où l’on cuisine le terroir et les produits locaux avec précision et simplicité."
    ],
    "nl": [
      "Het Savoyaardse restaurant Chez Augustine is een verfijnd en gezellig bergrestaurant, waar lokale producten met precisie en eenvoud worden bereid."
    ],
    "es": [
      "El restaurante saboyano Chez Augustine es un local de montaña refinado y acogedor, donde se cocinan productos locales con precisión y sencillez."
    ]
