  "rdfs:comment": {
    "de": [
      "Genießen Sie leckere Pizzen und erfrischen Sie sich mit einem Smoothie, einem lokalen Bier oder einem Eis - alles in einer angenehmen Umgebung am Ufer des Flusses Valserine."
    ],
    "en": [
      "Enjoy delicious pizzas and refresh yourself with a smoothie, local beer or ice cream, all in a pleasant setting on the banks of the Valserine."
    ],
    "it": [
      "Gustate deliziose pizze e rinfrescatevi con un frullato, una birra locale o un gelato, il tutto in un ambiente piacevole sulle rive della Valserina."
    ],
    "fr": [
      "Dégustez de délicieuses pizzas et rafraîchissez-vous avec un smoothie, une bière locale ou une glace, le tout dans un cadre agréable en bord de Valserine."
    ],
    "nl": [
      "Geniet van heerlijke pizza's en verfris jezelf met een smoothie, lokaal bier of ijs, allemaal in een aangename omgeving aan de oever van de Valserine."
    ],
    "es": [
      "Disfrute de deliciosas pizzas y refrésquese con un batido, una cerveza local o un helado, todo ello en un agradable entorno a orillas del Valserine."
    ]
  },
