  "rdfs:comment": {
    "de": [
      "Mit über 20 Jahren Erfahrung in der Fahrradbranche legt Didier großen Wert darauf, Ihnen den besten Service und das leistungsfähigste Mountainbike zu bieten!"
    ],
    "en": [
      "With more than 20 years of experience in the cycling industry, Didier makes it a point of honor to give you the best service and the best performing mountain bike possible!"
    ],
    "it": [
      "Con oltre 20 anni di esperienza nel settore ciclistico, Didier si fa un punto d'onore di darvi il miglior servizio e la migliore mountain bike possibile!"
    ],
    "fr": [
      "Avec plus de 20 ans d'expérience dans le milieu du cycle, Didier met un point d'honneur à vous rendre le meilleur service et le VTT le plus performant possible !"
    ],
    "nl": [
      "Met meer dan 20 jaar ervaring in de fietsindustrie maakt Didier er een erezaak van om u de beste service en de best presterende mountainbike te geven!"
    ],
