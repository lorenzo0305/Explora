  "rdfs:comment": {
    "de": [
      "Florie von La Clef de l'évasion bietet personalisierte Escape-Spiele bei Ihnen zu Hause für alle Arten von Veranstaltungen sowie einen spielerischen Spaziergang, bei dem Sie die Geheimnisse von Moulins entdecken können. Perfekt für alle, die Rätsel und Escape Games lieben."
    ],
    "en": [
      "Florie from La Clef de l'évasion offers personalized in-home escape games for all types of events, as well as a fun walk to discover the secrets of Moulins. Perfect for lovers of riddles and escape games."
    ],
    "it": [
      "Florie di La Clef de l'évasion propone giochi di fuga in casa personalizzati per ogni tipo di evento, oltre a una divertente passeggiata alla scoperta dei segreti di Moulins. Perfetto per gli amanti degli indovinelli e dei giochi di fuga."
    ],
    "fr": [
      "Florie de La Clef de l'évasion offre des jeux d'évasion personnalisés à domicile pour tous les types d'événements, ainsi qu'une balade ludique pour découvrir les secrets de Moulins. Parfait pour les amateurs d'énigmes et de jeux d'évasion."
    ],
    "nl": [
      "Florie van La Clef de l'évasion biedt gepersonaliseerde ontsnappingsspelletjes aan huis voor alle soorten evenementen, maar ook een ludieke wandeling om de geheimen van Moulins te ontdekken. Perfect voor liefhebbers van raadsels en ontsnappingsspelletjes."
    ],
    "es": [
      "Florie de La Clef de l'évasion ofrece juegos de escape a domicilio personalizados para todo tipo de eventos, así como un divertido paseo para descubrir los secretos de Moulins. Perfecto para los amantes de los enigmas y los juegos de escape."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La clef de l'évasion : Escape game"
    ]
  },
