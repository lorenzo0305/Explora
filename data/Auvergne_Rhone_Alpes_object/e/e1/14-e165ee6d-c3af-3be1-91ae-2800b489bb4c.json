  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/51d28cea-f7a1-3c0f-8158-227a7912aadb",
      "dc:description": {
        "de": [
          "Restaurant mit indischen Spezialitäten in einem schicken Rahmen und einer modernen, gemütlichen Atmosphäre\n\nBietet ein Kindermenü an\nNachhaltige Ansätze: \"Null Plastik\", \"Null Abfall\", \"Ökologischer Haushalt / 100% natürlich\", \"Nachhaltige Ernährung\", \"Anti-Verschwendung\""
        ],
        "en": [
          "Restaurant serving Indian specialities in a chic setting with a modern, cosy atmosphere\n\nChildren's menu\nSustainable approaches: \"zero plastic\", \"zero waste\", \"ecological / 100% natural cleaning\", \"sustainable food\", \"anti-gaspi\""
        ],
        "it": [
          "Ristorante che serve specialità indiane in un ambiente chic con un'atmosfera moderna e accogliente\n\nMenù per bambini disponibile\nApprocci sostenibili: \"zero plastica\", \"zero rifiuti\", \"pulizia ecologica / 100% naturale\", \"cibo sostenibile\", \"antigas\""
        ],
        "fr": [
          "Restaurant de spécialités indiennes dans un cadre chic et une ambiance moderne et cosy\n\nPropose un menu enfant\nDémarches durables : \"zéro plastique\", \"zéro déchet\", \"ménage écologique / 100% naturel\", \"alimentation durable\", \"anti-gaspi\""
        ],
        "es": [
          "Restaurante que sirve especialidades indias en un ambiente moderno y acogedor\n\nMenú infantil\nEnfoques sostenibles: \"plástico cero\", \"residuos cero\", \"limpieza ecológica / 100% natural\", \"alimentos sostenibles\", \"antigaspi\""
        ],
        "nl": [
          "Restaurant met Indiase specialiteiten in een chique omgeving met een moderne, gezellige sfeer\n\nKindermenu beschikbaar\nDuurzame aanpak: \"nul plastic\", \"nul afval\", \"ecologisch / 100% natuurlijk schoonmaken\", \"duurzaam eten\", \"anti-gaspi\""
        ]
      },
      "@type": [
        "Description"
      ],
