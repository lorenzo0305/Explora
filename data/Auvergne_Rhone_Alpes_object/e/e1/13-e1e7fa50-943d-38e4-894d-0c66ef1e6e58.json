  "rdfs:comment": {
    "de": [
      "Das Festival Chap?erlipopette, eine farbenfrohe Zirkuswoche!\r\nDieses Festival stellt aktuelle Kreationen vor, bei denen die Sensation und die Leistung im Dienste eines echten künstlerischen Anliegens stehen."
    ],
    "en": [
      "Festival Chap?erlipopette, a colorful circus week!\r\nThis festival showcases current creations where sensationalism and feats are at the service of a genuine artistic purpose."
    ],
    "it": [
      "Il festival Chap?erlipopette, una settimana di circo colorato!\r\nQuesto festival mette in mostra le ultime creazioni, dove il sensazionale e la prodezza sono al servizio di un autentico scopo artistico."
    ],
    "fr": [
      "Le festival Chap’erlipopette, une semaine circassienne haute en couleur ! \r\nCe festival met en valeur des créations actuelles où le sensationnel et l’exploit sont au service d’un véritable propos artistique."
    ],
    "nl": [
      "Het Chap?erlipopette festival, een kleurrijke circusweek!\r\nDit festival laat de nieuwste creaties zien, waarbij het sensationele en het huzarenstukje in dienst staan van een echt artistiek doel."
    ],
    "es": [
      "El festival Chap?erlipopette, ¡una colorida semana de circo!\r\nEste festival presenta las últimas creaciones, donde lo sensacional y la proeza están al servicio de un auténtico propósito artístico."
    ]
  },
