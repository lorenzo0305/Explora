  "rdfs:comment": {
    "de": [
      "Monts et Merveilles richtet sich im Gemeindegasthof La Cure ein, einem charmanten Ort im Herzen von Oz Village, um Ihnen eine kulinarische und fröhliche Auszeit zu bieten."
    ],
    "en": [
      "In our cozy restaurant or on our sunny terrace you can enjoy authentic and freshly prepared dishes"
    ],
    "it": [
      "Monts et Merveilles si insedia nell'incantevole Auberge La Cure, nel cuore di Oz Village, per offrirvi una gioiosa parentesi gastronomica."
    ],
    "fr": [
      "Monts et Merveilles s’installe dans l’auberge communale La Cure, un lieu plein de charme, au cœur d’Oz Village, pour vous offrir une parenthèse gourmande et joyeuse."
    ],
    "es": [
      "Monts et Merveilles se instala en el encantador Auberge La Cure, en el corazón de Oz Village, para ofrecerle un alegre interludio gastronómico."
    ],
