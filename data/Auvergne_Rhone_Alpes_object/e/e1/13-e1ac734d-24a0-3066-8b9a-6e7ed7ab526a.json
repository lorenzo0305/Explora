  "rdfs:comment": {
    "de": [
      "La Ferme Intégrale hat sich dafür entschieden, die Aquaponik in großem Maßstab zu entwickeln, um dazu beizutragen, in ihrem Gebiet Fisch, Gemüse und aromatische Pflanzen zu liefern. Das Unternehmen realisiert dies unter Beachtung eines nachhaltigen und verantwortungsbewussten Ansatzes."
    ],
    "en": [
      "La Ferme Intégrale has chosen to develop aquaponics on a large scale to help supply fish, vegetables and aromatic plants in its area. The company's approach is sustainable and responsible."
    ],
    "it": [
      "La Ferme Intégrale ha scelto di sviluppare l'acquaponica su larga scala per contribuire all'approvvigionamento di pesci, ortaggi e piante aromatiche nella sua zona. L'approccio dell'azienda è sostenibile e responsabile."
    ],
    "fr": [
      "La Ferme Intégrale a fait le choix de développer l’aquaponie à grande échelle pour contribuer à fournir sur son territoire poissons, légumes et plantes aromatiques. L’entreprise le réalise en respectant une approche durable et responsable."
    ],
    "nl": [
      "La Ferme Intégrale heeft ervoor gekozen om aquaponics op grote schaal te ontwikkelen om vis, groenten en aromatische planten in haar gebied te kunnen leveren. De aanpak van het bedrijf is duurzaam en verantwoord."
    ],
    "es": [
      "La Ferme Intégrale ha optado por desarrollar la acuaponía a gran escala para contribuir al abastecimiento de pescado, verduras y plantas aromáticas en su zona. El planteamiento de la empresa es sostenible y responsable."
    ]
  },
