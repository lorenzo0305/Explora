  "rdfs:comment": {
    "de": [
      "Der Waschsalon bietet leistungsstarke Waschmaschinen mit unterschiedlichen Kapazitäten an. Sie werden Studenten und Urlauber mit ihren 9-kg-Waschmaschinen glücklich machen, aber auch Haushalte und Einzelhändler mit ihren 13- und 18-kg-Geräten."
    ],
    "en": [
      "The Laundromat offers high-performance washing machines in a range of capacities. The 9 kg machines are ideal for students and holidaymakers, while the 13 and 18 kg machines are ideal for households and retailers."
    ],
    "it": [
      "La lavanderia offre lavatrici ad alte prestazioni con diverse capacità. Studenti e vacanzieri saranno soddisfatti delle lavatrici da 9 kg, mentre quelle da 13 e 18 kg sono ideali per le famiglie e le aziende."
    ],
    "fr": [
      "La laverie propose des machines à laver performantes, de différentes capacités. Elles feront le bonheur des étudiants, des vacanciers avec ses laveuses de 9 kg mais aussi des ménages et des commerçants avec ses équipements de 13 et 18 kg."
    ],
    "es": [
      "La lavandería ofrece lavadoras de alto rendimiento con distintas capacidades. Los estudiantes y los veraneantes estarán encantados con las máquinas de 9 kg, mientras que las de 13 y 18 kg son ideales para hogares y empresas."
    ],
    "nl": [
      "De wasserette biedt krachtige wasmachines in verschillende capaciteiten. Studenten en vakantiegangers zullen blij zijn met de 9 kg machines, terwijl 13 en 18 kg machines ideaal zijn voor huishoudens en bedrijven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Laverie Wash'N'Dry"
    ]
  },
