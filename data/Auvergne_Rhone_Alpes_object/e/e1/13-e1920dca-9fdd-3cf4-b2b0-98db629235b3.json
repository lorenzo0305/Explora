  "rdfs:comment": {
    "de": [
      "Hochwertiges Pizzeria-Restaurant mit frischen Zutaten und gutem Service!"
    ],
    "en": [
      "High-quality pizzeria restaurant with fresh ingredients and attentive service!"
    ],
    "it": [
      "Ristorante gastronomico che offre pizze con impasto fresco, cotte a legna, con ingredienti di qualità e ricette originali, nonché gratin e altri piatti gustosi e ben preparati, senza dimenticare i dolci."
    ],
    "fr": [
      "Restaurant gastronomique proposant des pizzas a base de pâte fraiche,cuites au feu de bois,avec des ingrédients de qualité et recettes originales,mais aussi des gratins,et d'autres plats savoureux et travaillés,sans oublier les desserts."
    ],
    "es": [
      "Restaurante gastronómico que ofrece pizzas elaboradas con masa fresca, cocinadas a la leña, con ingredientes de calidad y recetas originales, así como gratinados y otros platos sabrosos y bien preparados, sin olvidar los postres."
    ],
    "nl": [
      "Pizzeria-restaurant van hoge kwaliteit, verse ingrediënten en uitstekende service!"
    ]
  },
