  "rdfs:comment": {
    "de": [
      "Noëtika ist ein Ort des kreativen Schaffens und der Verbreitung, der das ganze Jahr über Aufführungen, Konzerte, Künstlerresidenzen und Workshops anbietet. Sie empfängt professionelle, aufstrebende und Amateurkünstler in ihrem Saal mit 120 Plätzen oder auf der Minibühne in der Nähe der Bar."
    ],
    "en": [
      "Noëtika is a creative and performance venue offering shows, concerts, artist residencies and workshops all year round. It welcomes professional, emerging and amateur artists in its 120-seat auditorium or on its mini-scene near the refreshment bar."
    ],
    "it": [
      "Noëtika è uno spazio creativo e performativo che offre spettacoli, concerti, residenze d'artista e workshop tutto l'anno. Accoglie artisti professionisti, emergenti e amatoriali nel suo auditorium da 120 posti o nella sua mini-scena vicino al bar."
    ],
    "fr": [
      "Noëtika est un lieu de création et de diffusion qui propose toute l’année spectacles, concerts, résidences d’artistes et ateliers. Elle accueille artistes pros, émergents ou amateurs, dans sa salle de 120 places ou sur sa mini-scène près de la buvette."
    ],
    "nl": [
      "Noëtika is een creatief en performancepodium dat het hele jaar door voorstellingen, concerten, kunstenaarsresidenties en workshops biedt. Het verwelkomt professionele, opkomende en amateurkunstenaars in het 120 zitplaatsen tellende auditorium of op de miniscène bij de bar."
    ],
    "es": [
      "Noëtika es un lugar de creación y representación que ofrece espectáculos, conciertos, residencias de artistas y talleres durante todo el año. Acoge a artistas profesionales, emergentes y aficionados en su auditorio de 120 plazas o en su miniescenario cerca del bar de refrescos."
    ]
  },
