  "rdfs:comment": {
    "de": [
      "Das Skiheim von Brugeron stellt seine Koffer am Col du Béal ab, da dort die ganze Saison über mehr Schnee liegt.\r\nVor Ort bietet Ihnen das Heim Abfahrten für Langlauf und Schneeschuhwanderungen, aber auch eine Rodelbahn."
    ],
    "en": [
      "The Foyer de ski du Brugeron has moved to the Col du Béal because the snow is more abundant throughout the season.\r\nThe center offers cross-country skiing and snowshoeing, as well as a toboggan run."
    ],
    "it": [
      "Il Foyer de ski du Brugeron si è spostato sul Col du Béal, dove c'è più neve per tutta la stagione.\r\nIl centro offre sci di fondo e racchette da neve, oltre a una pista per slittini."
    ],
    "fr": [
      "Le Foyer de ski du Brugeron dépose ses valises au Col du Béal car la neige est plus présente tout au long de la saison.\r\nSur place le foyer vous propose des départs en fond et raquettes mais aussi une piste de luges."
    ],
    "es": [
      "El Foyer de ski du Brugeron se ha trasladado al Col du Béal, donde hay más nieve durante toda la temporada.\r\nEl centro ofrece esquí de fondo y raquetas de nieve, así como una pista de trineo."
    ],
    "nl": [
      "De Foyer de ski du Brugeron is verhuisd naar de Col du Béal, waar het hele seizoen meer sneeuw ligt.\r\nHet centrum biedt langlaufen en sneeuwschoenwandelen, evenals een rodelbaan."
    ]
  },
  "rdfs:label": {
