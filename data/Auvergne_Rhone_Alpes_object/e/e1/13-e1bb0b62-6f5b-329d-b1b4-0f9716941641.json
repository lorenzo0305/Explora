  "rdfs:comment": {
    "de": [
      "Kommen Sie an Bord unserer alten Fahrzeuge und erleben Sie etwas ganz Neues!\r\nVermietung von Oldtimern (Renault Estafette und Mopeds) in verschiedenen Varianten, um das Kulturerbe der Haute-Loire aufzuwerten."
    ],
    "en": [
      "Come aboard our vintage vehicles for a unique experience!\r\nRental of vintage vehicles (Estafette Renault and mopeds) in a variety of packages to showcase the heritage of the Haute-Loire region."
    ],
    "it": [
      "Salite a bordo dei nostri veicoli d'epoca per un'esperienza unica!\r\nNoleggiate i veicoli d'epoca (Estafette Renault e ciclomotori) in una serie di pacchetti per far conoscere il patrimonio della Haute-Loire."
    ],
    "fr": [
      "Embarquez à bord de nos anciens véhicules et vivez une expérience inédite!\r\nLocation de véhicules anciens (Estafette Renault et mobylettes)  sous plusieurs formules pour valoriser le patrimoine de la Haute-Loire."
    ],
    "es": [
      "Suba a bordo de nuestros vehículos de época para vivir una experiencia única\r\nAlquile vehículos de época (Estafette Renault y ciclomotores) en diversas fórmulas para descubrir el patrimonio del Alto Loira."
    ],
    "nl": [
      "Stap aan boord van onze oldtimers voor een unieke ervaring!\r\nHuur oldtimervoertuigen (Estafette Renault en bromfietsen) in verschillende formules om het erfgoed van de Haute-Loire te laten zien."
    ]
  },
