  "rdfs:comment": {
    "de": [
      "Patronatsfest von Mazeyrat d'Allier, organisiert vom Comité des Fêtes. Samstag: 20 Uhr Nachtwanderung & Disco-Ball. Sonntag: 7 Uhr Flohmarkt, 11 Uhr Ausstellung & Taufe in einem 2CH, 14 Uhr Boule-Wettbewerb, Essen aus dem Dorfbackofen, 22 Uhr Lasershow und Musette-Ball"
    ],
    "en": [
      "Mazeyrat d'Allier Festival organized by the Comité des Fêtes. Saturday, 8pm night walk & disco ball. Sunday: 7am garage sale, 11am exhibition & 2CH baptism, 2pm pétanque competition, meal cooked in the village oven, 10pm laser show and musette ball"
    ],
    "it": [
      "Festival Mazeyrat d'Allier organizzato dal Comité des Fêtes. Sabato, ore 20:00 passeggiata notturna e ballo in discoteca. Domenica: ore 7 vendita di garage, ore 11 esposizione e battesimo 2CH, ore 14 gara di bocce, pasto cucinato nel forno del villaggio, ore 22 spettacolo laser e discoteca"
    ],
    "fr": [
      "Fête Patronale de Mazeyrat d'Allier organisée par le Comité des Fêtes. Samedi, 20h balade nocturne & Bal disco. Dimanche :7h vide-grenier, 11h expo & baptême en 2CH, 14h concours de pétanque, repas cuit au four du village, 22h show de laser et bal musette"
    ],
    "nl": [
      "Mazeyrat d'Allier Festival georganiseerd door het Comité des Fêtes. Zaterdag: 20.00 uur nachtwandeling & discobal. Zondag: 7u garageverkoop, 11u tentoonstelling & 2CH doop, 14u petanquewedstrijd, maaltijd gekookt in de dorpsoven, 22u lasershow en disco"
    ],
    "es": [
      "Festival de Mazeyrat d'Allier organizado por el Comité des Fêtes. Sábado: paseo nocturno y baile disco a las 20 h. Domingo: venta de garaje a las 7 h, exposición y bautismo a las 11 h, concurso de petanca a las 14 h, comida en el horno del pueblo, espectáculo de láser y discoteca a las 22 h"
    ]
  },
