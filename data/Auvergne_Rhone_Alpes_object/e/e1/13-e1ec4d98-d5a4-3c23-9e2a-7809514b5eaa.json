  "rdfs:comment": {
    "de": [
      "Die Abtei Saint-Marcellin wird im Jahr 936 gegründet.  Im Jahr 1137 wird das Kloster von der mächtigen Abtei La Chaise Dieu abhängig. Ende des 15. Jahrhunderts lässt der Abt Jacques de Sénecterre ein Wohnhaus, eine Kapelle und die Töpferei errichten."
    ],
    "en": [
      "Saint-Marcellin Abbey was founded in 936.  In 1137, the monastery became dependent on the powerful abbey of La Chaise Dieu. At the end of the 15th century, Abbot Jacques de Sénecterre built a dwelling, a chapel and the pottery."
    ],
    "it": [
      "L'abbazia di Saint-Marcellin fu fondata nel 936.  Nel 1137, il monastero divenne dipendente dalla potente abbazia di La Chaise Dieu. Alla fine del XV secolo, l'abate Jacques de Sénecterre fece costruire una casa, una cappella e una ceramica."
    ],
    "fr": [
      "L'abbaye Saint-Marcellin est fondée en 936.  En 1137 le monastère devient dépendant de la puissante abbaye de La Chaise Dieu. A la fin du XVème siècle, l'Abbé Jacques de Sénecterre fait ériger un logis, une chapelle et la poterie."
    ],
    "es": [
      "La abadía de Saint-Marcellin fue fundada en 936.  En 1137, el monasterio pasó a depender de la poderosa abadía de La Chaise Dieu. A finales del siglo XV, el abad Jacques de Sénecterre hizo construir una casa, una capilla y una alfarería."
    ],
    "nl": [
      "De abdij van Saint-Marcellin werd gesticht in 936.  In 1137 werd het klooster afhankelijk van de machtige abdij van La Chaise Dieu. Aan het einde van de 15e eeuw liet abt Jacques de Sénecterre een huis, kapel en pottenbakkerij bouwen."
    ]
  },
