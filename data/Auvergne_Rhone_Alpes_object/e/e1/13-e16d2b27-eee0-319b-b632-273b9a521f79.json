  "rdfs:comment": {
    "de": [
      "Beratung und Ausleihe von Kinder-, Jugend- und Erwachsenenbüchern.\r\nAusstellungen auf Zeit.\r\n La Bouquinerie : 30 Mitglieder,1300 ausgeliehene Bücher pro Jahr.\r\n- Schüler von St Christophe einmal pro Woche.\r\n- Ausleihe von Koffern, Büchern und Spielen für Schulen."
    ],
    "en": [
      "Consultation and loan of books for children, teenagers and adults.\r\nTemporary exhibitions.\r\n La Bouquinerie has: 30 members, 1300 books borrowed per year.\r\n- St Christophe schoolchildren once a week\r\n- Loans of trunks, books and games for schools."
    ],
    "it": [
      "Consultazione e prestito di libri per bambini, ragazzi e adulti\r\nMostre temporanee.\r\n La Bouquinerie conta 30 membri, 1300 libri presi in prestito all'anno.\r\n- Gli alunni di St. Christophe una volta alla settimana\r\n- Prestito di bauli, libri e giochi per le scuole."
    ],
    "fr": [
      "Consultation et prêt de livres enfants, ados et adultes. \r\nExpos temporaires.\r\n La Bouquinerie c'est : 30 adhérents,1300 livres empruntés par an.\r\n- Les élèves de St Christophe une fois par semaine\r\n- Prêts de malles, de livres et de jeux pour les écoles."
    ],
    "nl": [
      "Raadpleging en uitleen van boeken voor kinderen, tieners en volwassenen.\r\nTijdelijke tentoonstellingen.\r\n La Bouquinerie heeft 30 leden en leent 1.300 boeken per jaar uit.\r\n- Studenten van St Christophe één keer per week\r\n- Uitleen van koffers, boeken en spelletjes voor scholen."
    ],
    "es": [
      "Consulta y préstamo de libros para niños, adolescentes y adultos\r\nExposiciones temporales.\r\n La Bouquinerie cuenta con 30 miembros y 1300 libros prestados al año.\r\n- Los alumnos de St Christophe una vez a la semana\r\n- Préstamo de baúles, libros y juegos para las escuelas."
    ]
  },
