  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Bistronomierestaurant \"Le Hangar\" mit seiner von der Filmwelt inspirierten Industriedekoration. Der Küchenchef Anthony Monnet empfiehlt Ihnen eine große Auswahl an raffinierten und leckeren Gerichten, die mit frischen und saisonalen Produkten zubereitet werden."
    ],
    "en": [
      "Discover the bistronomic restaurant 'Le Hangar' with its industrial décor inspired by the history of cinema. Thechef Anthony Monnet suggests a wide range of refined gourmet dishes, prepared with fresh seasonal produce."
    ],
    "it": [
      "Scoprite il ristorante bistronomico \"Le Hangar\" e il suo arredamento industriale ispirato al mondo del cinema. Lo chef Anthony Monnet propone un'ampia scelta di piatti raffinati e gourmet, cucinati con prodotti freschi e di stagione."
    ],
    "fr": [
      "Découvrez le restaurant bistronomique \"Le Hangar\" et sa décoration industrielle inspirée par l'univers du cinéma. Le chef Anthony Monnet vous suggère un vaste choix de plats raffinés et gourmands, cuisinés autour de produits frais et de saison."
    ],
    "nl": [
      "Ontdek het bistronomische restaurant \"Le Hangar\" en zijn industriële decor geïnspireerd door de wereld van de cinema. Chef Anthony Monnet biedt een ruime keuze aan verfijnde, gastronomische gerechten, bereid met verse, seizoensgebonden producten."
    ],
    "es": [
      "Descubra el restaurante bistronómico \"Le Hangar\" y su decoración industrial inspirada en el mundo del cine. El chef Anthony Monnet le propone una amplia selección de platos refinados y gourmet, cocinados con productos frescos de temporada."
    ]
  },
