  "rdfs:comment": {
    "de": [
      "Restaurant Pizzeria eröffnet in der Winter- und Sommersaison am Fusse der Piste."
    ],
    "en": [
      "Bar restaurant pizzeria open in winter and summer at the foot of the slopes."
    ],
    "it": [
      "Pizzeria, bar, ristorante aperto in estate e in inverno, presso Le Balcon\r\nAperto tra le stagioni da mercoledì a domenica dalle 17.00 alle 21.30 per pizze e hamburger da asporto. Ordinare per telefono o direttamente online tramite il nostro sito web: www.letoileduvercors.fr"
    ],
    "fr": [
      "Pizzeria, bar, restaurant ouvert été comme hiver, au Balcon\r\nOuverture inter saison du mercredi au dimanche de 17h à 21h30 pour pizzas et burgers à emporter. Commande par téléphone ou directement en ligne via notre site internet : www.letoileduvercors.fr\""
    ],
    "nl": [
      "Pizzeria, bar, restaurant open zomer en winter, bij Le Balcon\r\nIn het tussenseizoen geopend van woensdag tot zondag van 17.00 tot 21.30 uur voor afhaalpizza's en hamburgers. Bestel telefonisch of direct online via onze website: www.letoileduvercors.fr"
    ],
    "es": [
      "Pizzería, bar, restaurante abierto verano e invierno, en Le Balcon\r\nAbierto entre temporada de miércoles a domingo de 17:00 a 21:30 para pizzas y hamburguesas para llevar. Haga su pedido por teléfono o directamente en línea a través de nuestra página web: www.letoileduvercors.fr"
    ]
  },
