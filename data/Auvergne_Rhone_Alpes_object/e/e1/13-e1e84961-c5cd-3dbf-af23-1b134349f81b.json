  "rdfs:comment": {
    "de": [
      "Traditionelle und familiäre Küche, das Restaurant bietet Ihnen ein Tagesmenü und seine Speisekarte.\r\nDas Restaurant liegt an der Dolce Via und verfügt über eine große Guinguette-Terrasse, die 50 Personen Platz bietet.\r\nThemenabende an Samstagabenden alle zwei Wochen."
    ],
    "en": [
      "Traditional and family cuisine, the restaurant offers a menu of the day and its à la carte.\r\nLocated on the Dolce Via, it has a large terrace guinguette that can accommodate 50 people.\r\nThemed evenings on Saturday nights every 2 weeks."
    ],
    "it": [
      "Cucina tradizionale familiare, il ristorante offre un menu del giorno e un menu à la carte.\r\nSituato sulla Dolce Via, dispone di un'ampia terrazza con 50 posti a sedere.\r\nSerate a tema il sabato sera ogni 2 settimane."
    ],
    "fr": [
      "Cuisine traditionnelle et familiale, le restaurant vous propose un menu du jour et sa carte.\r\nSitué sur la Dolce Via, il dispose d'une grande terrasse guinguette pouvant accueillir 50 personnes.\r\nSoirées à thème les samedis soirs toutes les 2 semaines."
    ],
    "nl": [
      "Het restaurant heeft een traditionele familiekeuken en biedt een dagmenu en een à-la-cartemenu.\r\nHet ligt aan de Dolce Via en heeft een groot terras met 50 zitplaatsen.\r\nElke 2 weken thema-avonden op zaterdagavond."
    ],
    "es": [
      "Cocina tradicional familiar, el restaurante ofrece un menú del día y un menú a la carta.\r\nSituado en la Dolce Via, dispone de una gran terraza con capacidad para 50 comensales.\r\nVeladas temáticas los sábados por la noche cada 2 semanas."
    ]
  },
