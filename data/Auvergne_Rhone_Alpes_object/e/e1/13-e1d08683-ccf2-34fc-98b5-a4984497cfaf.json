  "rdfs:comment": {
    "de": [
      "Das L?Espérance verkörpert Geselligkeit mit einer großzügigen und authentischen Küche, die eine Mischung aus traditioneller Brasserie und elegantem Bistro ist."
    ],
    "en": [
      "L'Espérance embodies conviviality with its generous, authentic cuisine, halfway between a traditional brasserie and an elegant bistro."
    ],
    "it": [
      "L'Espérance incarna la convivialità con la sua cucina generosa e autentica, a metà strada tra una brasserie tradizionale e un elegante bistrot."
    ],
    "fr": [
      "L’Espérance incarne la convivialité avec une cuisine généreuse et authentique, à mi-chemin entre brasserie traditionnelle et bistrot élégant."
    ],
    "es": [
      "L'Espérance encarna la convivencia con su cocina generosa y auténtica, a medio camino entre una brasserie tradicional y un elegante bistró."
