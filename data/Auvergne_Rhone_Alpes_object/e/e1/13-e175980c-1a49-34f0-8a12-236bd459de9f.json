  "rdfs:comment": {
    "de": [
      "Direkt gegenüber dem Bahnhof Perrache ist diese gemütliche Brasserie sehr einladend. Hier wird eine Bistroküche mit kanadischen Einflüssen serviert, die auf traditionelle Lyoner Art und Weise zubereitet wird."
    ],
    "en": [
      "Just opposite the Perrache station, this warm brasserie is very inviting. It serves bistro-style cuisine in a traditional Lyonnais style."
    ],
    "it": [
      "Di fronte alla stazione di Perrache, questa calda brasserie è molto invitante. Serve una cucina da bistrot in stile tradizionale lionese."
    ],
    "fr": [
      "Juste en face de la gare de Perrache, cette brasserie chaleureuse est bien engageante. On y sert une cuisine bistrotière et canaille, dans un registre traditionnel et lyonnais."
    ],
    "es": [
      "Justo enfrente de la estación de Perrache, esta cálida brasserie es muy acogedora. Sirve cocina de bistró al estilo tradicional lionés."
    ],
    "nl": [
      "Deze warme brasserie ligt tegenover het station van Perrache en is zeer uitnodigend. Het serveert bistrogerechten in traditionele Lyonnais-stijl."
    ]
  },
