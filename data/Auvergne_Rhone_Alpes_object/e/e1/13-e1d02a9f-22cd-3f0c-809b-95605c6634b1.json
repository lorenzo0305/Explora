  "rdfs:comment": {
    "de": [
      "Am Pistenschild Nr. 2 der Piste du Doron, beim Abstieg vom Rond Point des Pistes, Crêperie im Speisesaal oder auf der Südterrasse zum Mittagessen, eine Crêperie in Meribel reimt sich auf Feinschmecker!"
    ],
    "en": [
      "In the understated atmosphere of the dining room or on the south-facing terrace for lunch, a crêperie in Méribel for gourmets!"
    ],
    "it": [
      "Al cartello Piste du Doron n. 2, scendendo dal Rond Point des Pistes, una crêperie nella sala da pranzo o sulla terrazza esposta a sud per il pranzo, una crêperie a Meribel fa rima con gourmet!"
    ],
    "fr": [
      "Au Panneau de piste No2 de la Piste du Doron, en descendant du Rond Point des Pistes, crêperie dans  la salle à manger ou sur la terrasse plein sud pour déjeuner, une crêperie à Meribel rimant avec gourmand !"
    ],
    "es": [
      "En el cartel Piste du Doron nº 2, bajando del Rond Point des Pistes, una crêperie en el comedor o en la terraza orientada al sur para comer, ¡una crêperie en Meribel rima con gourmet!"
    ],
    "nl": [
      "Bij het bord Piste du Doron nr. 2, komende van het Rond Point des Pistes, een crêperie in de eetzaal of op het terras op het zuiden voor de lunch, een crêperie in Meribel rijmt op gourmet!"
    ]
  },
