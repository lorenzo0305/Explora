  "rdfs:comment": {
    "de": [
      "In ihrem Raum mitten im Zentrum von Chamonix gibt es jede Menge Tipps und Tricks zu entdecken, um sich selbst zu beschenken oder zu verschenken!"
    ],
    "en": [
      "The perfect place when choosing a special gift. A quality gift shop with alpine-style dishware, decoration, and cooking equipment for raclette, fondue & braserade. And also all the furniture equipment for apartments."
    ],
    "it": [
      "Nel suo spazio nel centro di Chamonix, da offrire o regalare, tanti consigli da scoprire!"
    ],
    "fr": [
      "Dans son espace en plein centre de Chamonix, pour s'offrir ou pour offrir, le plein d'astuces à découvrir!"
    ],
    "nl": [
      "In zijn ruimte in het centrum van Chamonix, om aan te bieden of cadeau te geven, veel tips om te ontdekken!"
    ],
