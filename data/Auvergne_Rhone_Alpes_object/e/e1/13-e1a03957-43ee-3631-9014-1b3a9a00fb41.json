  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Mediathek Gilbert Dalet in Crolles ist Teil des Bibliotheksnetzwerks Réseau des Bibliothèques du Grésivaudan.\nDer Eintritt ist frei und kostenlos. Ein Abonnement ist erforderlich, um aus den 430.000 Dokumenten (Bücher, DVDs, CDs) der 36 Bibliotheken des Netzwerks auszuleihen."
    ],
    "en": [
      "The Gilbert Dalet intercommunity multimedia library in Crolles is part of the Grésivaudan library network.\nAdmission is free. You need membership to borrow any of the 430,000 items (books, DVDs, CDs) in the network's 36 libraries."
    ],
    "it": [
      "La biblioteca multimediale intercomunitaria Gilbert Dalet di Crolles fa parte della Rete delle biblioteche di Grésivaudan.\nL'ingresso è gratuito. È necessario un abbonamento per prendere in prestito uno dei 430.000 articoli (libri, DVD, CD) presenti nelle 36 biblioteche della rete."
    ],
    "fr": [
      "La médiathèque intercommunale Gilbert Dalet à Crolles fait partie du Réseau des Bibliothèques du Grésivaudan.\nEntrée libre et gratuite. L'abonnement est nécessaire pour emprunter parmi les 430 000 documents (livre, DVD, CD) des 36 bibliothèques du réseau."
    ],
    "es": [
      "La biblioteca multimedia intercomunitaria Gilbert Dalet de Crolles forma parte de la Red de Bibliotecas Grésivaudan.\nLa entrada es gratuita. Para acceder a los 430.000 fondos (libros, DVD, CD) de las 36 bibliotecas de la red es necesario abonarse."
    ],
    "nl": [
      "De intercommunautaire mediatheek Gilbert Dalet in Crolles maakt deel uit van het Réseau des Bibliothèques du Grésivaudan.\nGratis vrij toegang Een abonnement is wel vereist om te kunnen lenen uit 430.000 documents (boek, DVD, CD) van de 36 bibliotheken van het netwerk."
    ]
  },
