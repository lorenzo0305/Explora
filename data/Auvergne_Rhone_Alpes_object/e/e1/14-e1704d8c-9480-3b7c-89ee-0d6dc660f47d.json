  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/feae520b-d61e-36cb-9939-5603dedea297",
      "dc:description": {
        "de": [
          "Dunes du Mont Saint-Frieux: Eine coole Nacht\n\nIm Rahmen dieser neuen Eulennacht treffen wir uns zu einem nächtlichen Ausflug, um die Arten des Departements zu entdecken.\n\nRDV um 20 Uhr auf dem Parkplatz des Standorts, rue de la mer D940E2 in Dannes.\nOnline-Anmeldung unter www.eden62, Rubrik \"Sorties nature\" (max. 20 Personen)"
        ],
        "en": [
          "Dunes du Mont Saint-Frieux: A lovely night\n\nAs part of this year's \"nuit de la chouette\" (night of the owl), let's get together for a nocturnal outing to discover the department's species.\n\nMeet at 8pm at the site parking lot, rue de la mer D940E2, Dannes.\nOnline registration at www.eden62, under \"Sorties nature\" (20 people max.)"
        ],
        "it": [
          "Dune del Mont Saint-Frieux: una notte incantevole\n\nNell'ambito di questa nuova notte dei gufi, organizziamo un'uscita notturna alla scoperta delle specie del dipartimento.\n\nAppuntamento alle 20:00 al parcheggio del sito, rue de la mer D940E2 a Dannes.\nIscrizione online su www.eden62, sezione \"Uscite in natura\" (20 persone al massimo)"
        ],
        "fr": [
          "Dunes du Mont Saint-Frieux : Une chouette nuit\n\nDans le cadre de cette nouvelle nuit de la chouette, retrouvons nous pour une sortie nocturne afin de découvrir les espèces du département.\n\nRDV à 20h sur le parking du site, rue de la mer D940E2 à Dannes.\nInscription en ligne sur www.eden62, rubrique «Sorties nature» (20 personnes max.)"
        ],
        "es": [
          "Dunas del Monte Saint-Frieux: una noche encantadora\n\nEn el marco de esta nueva noche de los búhos, reunámonos en una salida nocturna para descubrir las especies del departamento.\n\nCita a las 20 h en el aparcamiento del sitio, rue de la mer D940E2 en Dannes.\nInscripción en línea en www.eden62, sección \"Salidas en la naturaleza\" (20 personas máximo)"
        ],
        "nl": [
          "Duinen van de Mont Saint-Frieux: een heerlijke nacht\n\nLaten we in het kader van deze nieuwe uilennacht samenkomen voor een nachtelijk uitstapje om de soorten van het departement te ontdekken.\n\nAfspraak om 20u op de parking van de site, rue de la mer D940E2 in Dannes.\nOnline inschrijven op www.eden62, rubriek \"Natuuruitstappen\" (max. 20 personen)"
        ]
      },
