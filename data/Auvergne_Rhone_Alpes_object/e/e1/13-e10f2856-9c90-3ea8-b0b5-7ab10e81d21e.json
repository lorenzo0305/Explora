  "rdfs:comment": {
    "de": [
      "In diesem Restaurant können Sie Gaumenfreuden und Wintersport miteinander verbinden und den Abend mit einer fast 2,2 km langen Schlittenfahrt ausklingen lassen."
    ],
    "en": [
      "In this restaurant, you can combine table and slide fun by finishing the evening with a sledge run of nearly 2.2km."
    ],
    "it": [
      "In questo ristorante, godetevi il tavolo e lo slittino terminando la serata con una discesa in slitta per quasi 2,2 km."
    ],
    "fr": [
      "Dans ce restaurant, alliez plaisir de la table et de la glisse en terminant la soirée par une descente en luge sur près de 2.2km."
    ],
    "nl": [
      "In dit restaurant kunt u de geneugten van de tafel combineren met het plezier van het glijden door de avond af te sluiten met een rodelbaan van bijna 2,2 km."
    ],
    "es": [
      "En este restaurante, combine los placeres de la mesa con el placer de deslizarse terminando la velada con una carrera de trineos de casi 2,2 km."
    ]
  },
