  "rdfs:comment": {
    "de": [
      "Das Hôtel de La Poste ist ein regionales Haus mit Charme und Charakter im Herzen eines ruhigen Dorfes im Parc des Volcans d'Auvergne, Busparkplatz vor dem Hotel."
    ],
    "en": [
      "The Hôtel de La Poste is a regional house of charm and character, located in the heart of a quiet village in the Parc des Volcans d'Auvergne, bus parking in front of the hotel."
    ],
    "it": [
      "L'Hôtel de La Poste è una casa regionale di charme e carattere, situata nel cuore di un tranquillo villaggio nel Parc des Volcans d'Auvergne, con un parco autobus di fronte all'hotel."
    ],
    "fr": [
      "L'Hôtel de La Poste est une maison régionale de charme et de caractère, située au cœur d'un bourg tranquille dans le Parc des Volcans d'Auvergne, parking bus face à l'hôtel."
    ],
    "nl": [
      "Hôtel de La Poste is een regionaal huis met charme en karakter, gelegen in het hart van een rustig dorp in het Parc des Volcans d'Auvergne, met een busparkeerplaats tegenover het hotel."
    ],
    "es": [
      "El Hôtel de La Poste es una casa regional con encanto y carácter, situada en el corazón de un tranquilo pueblo del Parc des Volcans d'Auvergne, con un aparcamiento de autobuses frente al hotel."
    ]
  },
