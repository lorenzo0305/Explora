  "rdfs:comment": {
    "de": [
      "Gewässer in der Nähe des Campingplatzes. Aktivitäten vor Ort: Wandern, Angeln, Picknicks... Paddeln ist auf dem See nicht erlaubt.\r\n\r\nVORÜBERGEHEND GESCHLOSSEN – AUS GESUNDHEITLICHEN GRÜNDEN"
    ],
    "en": [
      "This body of water is located near the campsite. On-site activities: hiking, fishing. Paddles are not allowed on the water.\r\n\r\nTEMPORARILY CLOSED FOR HEALTH REASONS"
    ],
    "it": [
      "Lago vicino al campeggio. Attività in loco: escursioni, pesca, picnic, ecc. Non è consentito l'uso di pagaie sul lago.\r\n\r\nTEMPORANEAMENTE CHIUSO PER MOTIVI SANITARI"
    ],
    "fr": [
      "Plan d'eau situé à proximité du camping. Activités sur place: randonnée, pêche, pique-nique... Les paddles ne sont pas autorisés sur le plan d'eau.\r\n\r\nFERMÉE TEMPORAIREMENT - RAISON SANITAIRE"
    ],
    "nl": [
      "Meer in de buurt van de camping. Activiteiten ter plaatse: wandelen, vissen, picknicken, enz. Peddels zijn niet toegestaan op het meer.\r\n\r\nTIJDELIJK GESLOTEN OM GEZONDHEIDSREDENEN"
    ],
    "es": [
      "Lago cerca del camping. Actividades in situ: senderismo, pesca, picnic, etc. No está permitido remar en el lago.\r\n\r\nCERRADO TEMPORALMENTE POR MOTIVOS SANITARIOS"
    ]
  },
