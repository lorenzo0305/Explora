  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fe71d648-5369-3cce-9511-7b7f4fcf0119",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nZurzeit bietet Ihnen die SCEA Boutin Blarel Eier, Kartoffeln und Pilze im Direktverkauf an.\n\nWeitere Informationen :\n\nKontaktieren Sie den Erzeuger telefonisch unter 06 62 15 86 12\n\nOrganisation :\nDer Zugang zu den Produkten ist rund um die Uhr in Selbstbedienung möglich. Die Bezahlung erfolgt ausschließlich in bar oder per Scheck.\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nAt the moment, SCEA Boutin Blarel offers eggs, potatoes and mushrooms for direct sale.\n\nFor further information:\n\nContact the producer by phone 06 62 15 86 12\n\nOrganization:\nAccess to products is possible 24 hours a day, on a self-service basis. Payment is by cash or cheque only.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nAttualmente, SCEA Boutin Blarel offre uova, patate e funghi in vendita diretta.\n\nPer ulteriori informazioni:\n\nContattare il produttore al numero di telefono 06 62 15 86 12\n\nOrganizzazione:\nL'accesso ai prodotti è possibile 24 ore su 24, in modalità self-service. Il pagamento avviene solo in contanti o con assegni.\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nEn ce moment, la SCEA Boutin Blarel vous propose des oeufs, des pommes de terre et des champignons en vente directe.\n\nPour plus d'informations :\n\nContacter le producteur par téléphone au 06 62 15 86 12\n\nOrganisation :  \nL'accès aux produits est possible 24h/24, en libre service. Le paiement se fait uniquement en espèces ou en chèque.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nOp dit moment biedt SCEA Boutin Blarel eieren, aardappelen en champignons aan voor directe verkoop.\n\nVoor meer informatie:\n\nNeem telefonisch contact op met de producent op 06 62 15 86 12\n\nOrganisatie:\nToegang tot de producten is 24 uur per dag mogelijk, op basis van zelfbediening. Betaling uitsluitend contant of per cheque.\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nActualmente, SCEA Boutin Blarel ofrece huevos, patatas y setas para la venta directa.\n\nPara más información:\n\nPóngase en contacto con el productor en el teléfono 06 62 15 86 12\n\nOrganización:\nEl acceso a los productos es posible las 24 horas del día, en régimen de autoservicio. Sólo se puede pagar en efectivo o con cheque.\n\n "
        ]
      },
