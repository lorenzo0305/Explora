  "rdfs:comment": {
    "de": [
      "Das Casino Allevard-Les-Bains bietet Ihnen 60 Spielautomaten: Sie finden hier traditionelle Walzen, Videorollen der neuesten Generation, Videopoker, aber auch 13 Stationen für elektronisches englisches Roulette und elektronisches Black Jack."
    ],
    "en": [
      "The Allevard-Les-Bains casino offers 60 slot machines: you'll find traditional roller machines, latest-generation video roller machines and video poker machines, as well as 13 electronic English roulette machines and electronic blackjack."
    ],
    "it": [
      "Il Casinò d'Allevard-Les-Bains offre 60 slot machine: troverete rulli tradizionali, videolotterie di ultima generazione e videopoker, oltre a 13 roulette inglesi elettroniche e blackjack elettronico."
    ],
    "fr": [
      "Le Casino d'Allevard-Les-Bains vous propose 60 machines à sous : vous y trouverez des rouleaux traditionnels, des vidéo-rouleaux dernières génération, des vidéo-pokers mais aussi 13 postes de roulette anglaise électronique et le black jack électronique."
    ],
    "nl": [
      "Het casino Allevard-Les-Bains biedt 60 gokkasten: je vindt er traditionele roulette tafels videotafels van de nieuwste generatie en videopokers, maar ook 13 elektronische Engelse roulettemachines en elektronische blackjack."
    ],
    "es": [
