  "rdfs:comment": {
    "de": [
      "Crépol ist ein kleines Dorf im Südosten Frankreichs. Es liegt im Département Drôme in der Region Auvergne-Rhône-Alpes.\r\nDie Gemeinde Crépol gehört zum Kanton Drôme des Collines ."
    ],
    "en": [
      "Crépol is a small village in south-eastern France, in the Drôme département, in the Auvergne-Rhône-Alpes region.\r\nCrépol belongs to the Drôme des Collines canton."
    ],
    "it": [
      "Crépol è un piccolo villaggio del sud-est della Francia, nel dipartimento della Drôme, nella regione dell'Alvernia-Rodano-Alpi.\r\nCrépol appartiene al cantone Drôme des Collines."
    ],
    "fr": [
      "Crépol est un petit village du sud est de la France, il est situé dans le département de la Drôme, en région Auvergne-Rhône-Alpes.\r\nLa commune de Crépol appartient au canton de la Drôme des Collines ."
    ],
    "nl": [
      "Crépol is een klein dorp in het zuidoosten van Frankrijk, in het departement Drôme, in de regio Auvergne-Rhône-Alpes.\r\nCrépol behoort tot het kanton Drôme des Collines."
    ],
    "es": [
      "Crépol es un pequeño pueblo del sureste de Francia, en el departamento de Drôme, región de Auvernia-Ródano-Alpes.\r\nCrépol pertenece al cantón de Drôme des Collines."
    ]
  },
