  "rdfs:comment": {
    "de": [
      "Im Herzen des Avesnois, am Ufer eines wunderschönen 20 Hektar großen Teichs, lassen Sie sich von unserem herzlichen Empfang, unseren leckeren Gerichten und der Schönheit der Natur, die uns umgibt, verzaubern!"
    ],
    "en": [
      "In the heart of the Avesnois, on the edge of a magnificent pond of 20Ha, let us charm you with our warm welcome, our tasty dishes and the beauty of the nature which surrounds us!"
    ],
    "it": [
      "Nel cuore dell'Avesnois, ai bordi di un magnifico stagno di 20 ettari, lasciatevi incantare dalla nostra calda accoglienza, dai nostri piatti gustosi e dalla bellezza della natura circostante!"
    ],
    "fr": [
      "Au cœur de l'Avesnois, au bord d'un magnifique étang de 20Ha, laissez-nous vous charmer par notre accueil chaleureux, nos plats savoureux et la beauté de la nature qui nous entoure !"
    ],
    "nl": [
      "In het hart van de Avesnois, aan de rand van een prachtige vijver van 20 hectare, laten wij u charmeren door onze warme ontvangst, onze smakelijke gerechten en de schoonheid van de omringende natuur!"
    ],
    "es": [
      "En el corazón del Avesnois, al borde de un magnífico estanque de 20 hectáreas, ¡déjese seducir por nuestra cálida acogida, nuestros sabrosos platos y la belleza de la naturaleza que nos rodea!"
    ]
  },
  "rdfs:label": {
