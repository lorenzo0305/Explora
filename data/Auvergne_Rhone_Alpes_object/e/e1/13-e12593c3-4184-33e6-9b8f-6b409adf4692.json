  "rdfs:comment": {
    "de": [
      "MJo Peintures, ein Galerie-Atelier in Faverges-Seythenex, wird von der Malerin Marie-Jo geleitet, die 2025 Botschafterin des Fremdenverkehrsamts der Quellen des Sees von Annecy ist."
    ],
    "en": [
      "MJo Peintures, a studio/gallery in Faverges-Seythenex, is run by artist Marie-Jo, 2025 ambassador for the Office de Tourisme des Sources du Lac d?Annecy."
    ],
