  "rdfs:comment": {
    "de": [
      "Möchten Sie den Golfsport entdecken? Kommen Sie mit Ihrer Familie oder Ihren Freunden auf den Golfplatz von Avoriaz, um diesen wunderbaren Sport zu entdecken.\r\nSchnupperkurs von 1,5 Stunden. 25 ? / Person.\r\nReservierung unter 06 64 48 04 88"
    ],
    "en": [
      "Want to discover golf?\r\nCome with family or friends to the Avoriaz golf practice range and experience this wonderful sport.\r\nDiscovery session: 1h30 – €25 per person.\r\nBooking: +33 6 64 48 04 88"
    ],
    "it": [
      "Volete scoprire il golf? Venite con la famiglia o gli amici al campo pratica di Avoriaz e scoprite questo meraviglioso sport.\r\nSessione di scoperta 1h30. 25 a persona.\r\nPrenotare al numero 06 64 48 04 88"
    ],
    "fr": [
      "Vous souhaitez découvrir le golf ? Venez en famille ou entre amis sur le practice de golf d'Avoriaz afin de découvrir ce merveilleux sport. \r\nSéance découverte d'1h30. 25€ / personne. \r\nRéservation au 06 64 48 04 88"
    ],
    "es": [
      "¿Desea descubrir el golf? Venga con su familia o amigos al campo de prácticas de golf de Avoriaz y descubra este maravilloso deporte.\r\nSesión de descubrimiento de 1h30. 25 por persona.\r\nReserva en el 06 64 48 04 88"
    ],
    "nl": [
      "Zin om golf te ontdekken?\r\nKom met familie of vrienden naar de golfpractice van Avoriaz en maak kennis met deze prachtige sport.\r\nInitiatiesessie van 1u30 – €25 per persoon.\r\nReserveren: +33 6 64 48 04 88"
    ]
  },
