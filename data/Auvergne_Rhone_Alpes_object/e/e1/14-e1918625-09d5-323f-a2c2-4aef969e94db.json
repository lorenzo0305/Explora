  "rdfs:comment": {
    "de": [
      "Chez Marcel - handwerklich hergestellte Biere, Gerichte und Spiele aus der Region! Hier wird das handwerklich gebraute Bier gefeiert, begleitet von süßen und salzigen Leckereien \"Fait Maison\" in einer gemütlichen und warmen Atmosphäre."
    ],
    "en": [
      "Chez Marcel - craft beers, local dishes and games! Here we celebrate craft beer, accompanied by home-made sweet and savoury treats in a warm and cosy atmosphere."
    ],
    "it": [
      "Chez Marcel - birre artigianali, piatti locali e giochi! Qui si celebra la birra artigianale, accompagnata da specialità dolci e salate fatte in casa, in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Chez Marcel - bières artisanales, plats et jeux de terroir ! Ici on célèbre la bière artisanale, le tout accompagné de douceurs salées et sucrées \"Fait Maison\" dans une ambiance cosy et chaleureuse."
    ],
    "es": [
      "Chez Marcel: ¡cerveza artesanal, platos locales y juegos! Aquí celebramos la cerveza artesanal, acompañada de delicias dulces y saladas caseras en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Chez Marcel - ambachtelijke bieren, lokale gerechten en spelletjes! Hier vieren we ambachtelijk bier, vergezeld van zelfgemaakte zoete en hartige lekkernijen in een warme en gezellige sfeer."
    ]
  },
