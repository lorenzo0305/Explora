  "rdfs:comment": {
    "de": [
      "Willkommen in Marcolès, dem schönsten Dorf Frankreichs, das wir Ihnen auf zwei Familienschatzsuchen vorstellen, die ab 6 Jahren mit Hilfe von Erwachsenen durchgeführt werden können.\r\nDauer: ca. 1 Stunde."
    ],
    "en": [
      "We suggest you discover the village of Marcolès through two family treasure hunts accessible from 6 with the help of adults and lasting about 1 hour. Available only in French."
    ],
    "it": [
      "Benvenuti a Marcolès, il più bel villaggio della Francia, dove potrete scoprire due cacce al tesoro in famiglia per bambini dai 6 anni in su, con l'aiuto degli adulti.\r\nDurata: circa 1 ora."
    ],
    "fr": [
      "Bienvenue à Marcolès, Plus beau Village de France, que nous vous proposons de découvrir à travers deux chasses au trésor familiales accessibles dès 6 ans avec l’aide des adultes.\r\nDurée : environ 1h."
    ],
    "nl": [
      "Wij stellen u voor het dorp Marcolès te ontdekken door middel van twee familiespeurtochten, toegankelijk vanaf 6 jaar met hulp van volwassenen, die ongeveer 1 uur duren. Enkel beschikbaar in het Frans."
    ],
    "es": [
      "Bienvenido a Marcolès, el pueblo más bonito de Francia, donde podrá descubrir dos búsquedas del tesoro en familia para niños a partir de 6 años, con la ayuda de adultos.\r\nDuración: 1 hora aproximadamente."
    ]
  },
  "rdfs:label": {
    "en": [
      "Treasure hunts in Marcolès"
    ],
    "fr": [
      "Chasses au trésor à Marcolès"
    ],
    "nl": [
      "Schattenjacht in Marcolès"
    ]
  },
