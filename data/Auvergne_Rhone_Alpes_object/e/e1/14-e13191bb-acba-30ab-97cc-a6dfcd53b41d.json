  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab4893cb-b09c-39ba-bf7e-fcb298546ae1",
      "dc:description": {
        "de": [
          "Dauerausstellung : Die Paläontologie von Didier Guinchon im Argos-Museum in Le Portel\nAb dem 14. April 2025\nWorkshops für Kinder: während der Schulferien, montags und dienstags.\nFossiliensuche: Ein Samstag im Monat, nach Vereinbarung, an den Kaps Blanc-Nez und Gris-Nez. Die Aktivität wird von Luc, einem Paläontologen, geleitet.\nWorkshop für Erwachsene: montags von 14:00 bis 18:00 Uhr.\nWeitere Informationen erhalten Sie telefonisch."
        ],
        "en": [
          "Permanent exhibition: Paleontology by Didier Guinchon at the Argos Museum in Le Portel\nFrom April 14, 2025\nChildren's workshops: Mondays and Tuesdays during school vacations.\nFossil-hunting: one Saturday a month, by appointment, at Cap Blanc-Nez and Cap Gris-Nez, led by paleontologist Luc.\nWorkshop for adults: Mondays, 2 pm to 6 pm.\nInformation by telephone."
        ],
        "it": [
          "Mostra permanente: La paleontologia di Didier Guinchon al Museo Argos di Le Portel\nDal 14 aprile 2025\nLaboratori per bambini: durante le vacanze scolastiche, il lunedì e il martedì.\nCaccia ai fossili: un sabato al mese, su appuntamento, a Cap Blanc-Nez e Cap Gris-Nez. Attività guidata da Luc, paleontologo.\nLaboratorio per adulti: il lunedì dalle 14.00 alle 18.00.\nInformazioni telefoniche."
        ],
        "fr": [
          "Exposition permanente : La Paléontologie de Didier Guinchon au Musée Argos de Le Portel\nA partir du 14 avril 2025\nAteliers pour enfants: pendant les vacances scolaires, les lundis et mardis.\nRecherche de fossiles: un samedi par mois, sur rendez-vous, aux caps Blanc-Nez et Gris-Nez. activité animée par Luc, paléontologue.\nAtelier pour adultes : le lundi de 14h à 18h.\nRenseignements par téléphone."
        ],
        "nl": [
          "Permanente tentoonstelling: De paleontologie van Didier Guinchon in het Argos Museum in Le Portel\nVanaf 14 april 2025\nKinderworkshops: tijdens de schoolvakanties, op maandag en dinsdag.\nFossielenjacht: een zaterdag per maand, op afspraak, op Cap Blanc-Nez en Cap Gris-Nez. Activiteit onder leiding van Luc, paleontoloog.\nWorkshop voor volwassenen: maandag van 14 tot 18 uur.\nTelefonische informatie."
        ],
        "es": [
          "Exposición permanente: La paleontología de Didier Guinchon en el Museo Argos de Le Portel\nA partir del 14 de abril de 2025\nTalleres para niños: durante las vacaciones escolares, los lunes y martes.\nCaza de fósiles: un sábado al mes, con cita previa, en Cap Blanc-Nez y Cap Gris-Nez. Actividad dirigida por Luc, paleontólogo.\nTaller para adultos: los lunes de 14.00 a 18.00 h.\nInformación por teléfono."
        ]
      },
