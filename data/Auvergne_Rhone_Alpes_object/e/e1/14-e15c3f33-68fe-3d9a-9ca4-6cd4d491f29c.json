  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eb40c146-b55b-39a3-b98f-d627e8417785",
      "dc:description": {
        "de": [
          "2400m² großer Angelteich, der einen Ort der Entspannung für Angler und einen Ort zum Spazierengehen für Familien vereint.\nGrill und Picknicktische stehen zur Verfügung\nOrganisation von Wettbewerben"
        ],
        "en": [
          "A 2400m² fishing pond that combines a relaxing spot for anglers and a place for families to stroll.\nBarbecue and picnic tables available\nOrganization of competitions"
        ],
        "it": [
          "Un laghetto di pesca di 2400 m² che è sia un luogo di relax per i pescatori che un luogo di passeggio per le famiglie.\nSono disponibili barbecue e tavoli da picnic\nOrganizzazione di gare"
        ],
        "fr": [
          "Etang de pêche de 2400m² qui regroupe un lieu de détente pour les pêcheurs et un lieu de promenade pour les familles.\nBarbecue, tables de pique nique sont à disposition\nOrganisation de concours"
        ],
        "es": [
          "Un estanque de pesca de 2.400 m² que es a la vez un lugar de descanso para los pescadores y un lugar de paseo para las familias.\nBarbacoa y mesas de picnic disponibles\nOrganización de competiciones"
        ],
        "nl": [
          "Een visvijver van 2400 m² die zowel een plek is voor vissers om te ontspannen als een plek voor gezinnen om te wandelen.\nBarbecue en picknicktafels beschikbaar\nOrganisatie van wedstrijden"
        ]
      },
      "@type": [
        "Description"
