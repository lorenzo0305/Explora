  "rdfs:comment": {
    "de": [
      "Das Canyoning-Erlebnis in Hochsavoyen!\r\n\r\nMit der Familie oder mit Freunden, erleben Sie das Canyoning im Herzen der herrlichen Flüsse! \r\n\r\nErleben Sie den Nervenkitzel in Begleitung eines diplomierten Lehrers."
    ],
    "en": [
      "The canyoning experience in Haute-Savoie !\r\n\r\nWith family or friends, experience canyoning in the heart of the splendid Haute-Savoie rivers! \r\n\r\nOnly 30 minutes from Geneva and Chamonix, near to Annecy, with guides - an exhilarating experience!"
    ],
    "it": [
      "L'esperienza del canyoning in Alta-Savoia\r\n\r\nIn famiglia o con gli amici, vivete l'esperienza del canyoning tra gli splendidi fiumi dell'Alta Savoia!\r\nA soli 30 minuti da Ginevra e Chamonix, vicino ad Annecy, vivete emozioni forti con gli esperti."
    ],
    "fr": [
      "L'expérience canyoning en Haute-Savoie !\r\nEn famille ou entre amis, vivez l'expérience du canyoning au cœur des splendides rivières ! \r\nVivez des sensations fortes accompagnés d'un moniteur diplômé."
    ],
    "es": [
      "¡La experiencia del barranquismo en Alta Saboya!\r\nEn familia o entre amigos, viva el descenso de barrancos en el corazón de magníficos ríos\r\nViva la emoción del barranquismo con un monitor cualificado."
    ],
    "nl": [
      "De canyoning ervaring in de Haute-Savoie!\r\nBeleef met je gezin of met vrienden canyoning in het hart van prachtige rivieren!\r\nBeleef de sensatie van canyoning met een gekwalificeerde instructeur."
    ]
  },
