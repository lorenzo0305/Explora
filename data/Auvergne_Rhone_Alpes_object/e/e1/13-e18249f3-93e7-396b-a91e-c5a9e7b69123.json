  "rdfs:comment": {
    "de": [
      "Annie und Gilles Copéret freuen sich, Sie auf ihrem Weingut zu begrüßen und Ihnen ihre Weine und ihre Gästezimmer in einem separaten Teil ihres Hauses vorzustellen.\r\nZögern Sie nicht, sie in einem sympathischen Rahmen zu besuchen."
    ],
    "en": [
      "Annie and Gilles Coperet will have the pleasure to welcome you on their domain and to make you discover their wines and their guest room in an independent part of their house.\r\nDon't hesitate to visit them in a friendly setting."
    ],
    "it": [
      "Annie e Gilles Copéret saranno lieti di accogliervi nella loro tenuta e di mostrarvi i loro vini e il bed and breakfast in una parte separata della loro casa.\r\nNon esitate a far loro visita, in un'atmosfera amichevole."
    ],
    "fr": [
      "Annie et Gilles Copéret auront le plaisir de vous accueillir sur leur domaine et de vous faire découvrir leurs vins et leurs chambres d'hôtes dans une partie indépendante de leur maison.\r\nN'hésitez pas à leur rendre visite, dans un cadre sympathique."
    ],
    "es": [
      "Annie y Gilles Copéret estarán encantados de recibirle en su finca y mostrarle sus vinos y su alojamiento y desayuno en una parte separada de su casa.\r\nNo dude en hacerles una visita, en un ambiente acogedor."
    ],
    "nl": [
      "Annie en Gilles Copéret verwelkomen je graag op hun domein en laten je hun wijnen en bed & breakfast zien in een apart deel van hun huis.\r\nAarzel niet om hen te bezoeken, in een vriendelijke sfeer."
    ]
  },
