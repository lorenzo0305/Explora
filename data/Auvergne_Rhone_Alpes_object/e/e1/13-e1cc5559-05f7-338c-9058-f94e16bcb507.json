  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro steht Ihnen zur Verfügung, um Ihre Fragen zu beantworten und Ihnen die Gegend näher zu bringen... Zögern Sie nicht, unsere Tür aufzustoßen!"
    ],
    "en": [
      "Tourist Information is here to answer your questions and introduce you to the region...Be sure to visit us!"
    ],
    "it": [
      "L'Ufficio del Turismo è a vostra disposizione per rispondere alle vostre domande e aiutarvi a scoprire la zona... Non esitate a venirci a trovare!"
    ],
    "fr": [
      "L'office de tourisme est à votre disposition pour répondre à vos questions, vous faire découvrir le territoire... N'hésitez pas à pousser notre porte !"
    ],
    "es": [
      "La Oficina de Turismo está a su disposición para responder a sus preguntas y ayudarle a descubrir la zona... ¡No dude en venir a vernos!"
    ],
    "nl": [
      "Het VVV-kantoor staat tot uw beschikking om uw vragen te beantwoorden en u te helpen de omgeving te ontdekken... Aarzel niet om ons te bezoeken!"
    ]
  },
