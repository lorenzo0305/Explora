  "rdfs:comment": {
    "de": [
      "Als einzigartiger und bemerkenswerter Ort, der von der Anwesenheit von Soldaten während des Ersten Weltkriegs zeugt, sind die Steinbrüche von Montigny ein Muss für Ihren Aufenthalt im Departement Oise!"
    ],
    "en": [
      "A unique and remarkable site, testimony to the presence of soldiers during the First World War, the Carrières de Montigny are a must during your stay in the Oise!"
    ],
    "it": [
      "Sito unico e notevole, testimonianza della presenza di soldati durante la Prima Guerra Mondiale, le Cave di Montigny sono una tappa obbligata del vostro soggiorno nella regione dell'Oise!"
    ],
    "fr": [
      "Site unique et remarquable, témoignage de la présence de soldats durant la Première Guerre Mondiale, les Carrières de Montigny sont un incontournable de votre séjour dans l'Oise !"
    ],
    "es": [
      "Las canteras de Montigny, un lugar único y notable, testimonio de la presencia de soldados durante la Primera Guerra Mundial, son una visita obligada durante su estancia en la región de Oise"
    ],
    "nl": [
      "De steengroeven van Montigny, een unieke en opmerkelijke site die getuigt van de aanwezigheid van soldaten tijdens de Eerste Wereldoorlog, zijn een must tijdens uw verblijf in de Oise!"
    ]
  },
