      "dc:description": {
        "de": [
          "Verband, der mehrere Sportvereine aus Toulouse zusammenfasst.\nAnimation zwischen den Vereinen und Hilfe bei der Buchhaltung der Mitgliedsvereine."
        ],
        "en": [
          "Association bringing together several Touquet sports associations.\nInter-association activities and accounting support for member associations."
        ],
        "it": [
          "Associazione che riunisce diverse associazioni sportive del Touquet.\nAttività interassociative e supporto contabile per le associazioni aderenti."
        ],
        "fr": [
          "Association regroupant plusieurs associations sportives touquettoises.\nAnimation inter associations et aide à la comptabilité des associations adhérentes."
        ],
        "nl": [
          "Vereniging die een aantal sportverenigingen uit Touquet verenigt.\nVerenigingsactiviteiten en boekhoudkundige ondersteuning voor de aangesloten verenigingen."
        ],
        "es": [
          "Asociación que agrupa a varias asociaciones deportivas del Touquet.\nActividades interasociativas y apoyo contable a las asociaciones miembros."
        ]
      },
