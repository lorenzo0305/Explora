  "rdfs:comment": {
    "de": [
      "Künstlerin, die in den Bergen malt, Mitglied der SPM (Société des Peintres de Montagne) und Tiermalerin.\r\nAls Content Creator auf YouTube finden Sie über 300 Videos, die sich mit der Einführung in die Malerei und das Zeichnen befassen, sowie Interviews."
    ],
    "en": [
      "Mountain painter, member of the SPM (Société des Peintres de Montagne) and animal painter.\r\nA content creator on YouTube, you'll find over 300 videos on introductory painting and drawing, as well as interviews."
    ],
    "it": [
      "Pittore di montagna, membro della SPM (Société des Peintres de Montagne) e pittore di animali.\r\nCome creatore di contenuti su YouTube, troverete oltre 300 video di introduzione alla pittura e al disegno, oltre a interviste."
    ],
    "fr": [
      "Artiste peintre de Montagne membre de la SPM (Société des Peintres de Montagne) et peintre animalière. \r\nCréatrice de contenu sur YouTube, vous trouverez plus de 300 vidéos traitant de l'initiation à la peinture et au dessin ainsi que des interviews."
    ],
    "es": [
      "Pintor de montaña, miembro de la SPM (Société des Peintres de Montagne) y pintor de animales.\r\nComo creador de contenidos en YouTube, encontrarás más de 300 vídeos de iniciación a la pintura y el dibujo, así como entrevistas."
    ],
    "nl": [
      "Bergschilder, lid van de SPM (Société des Peintres de Montagne) en dierenschilder.\r\nAls content creator op YouTube vind je meer dan 300 video's over inleidend schilderen en tekenen, evenals interviews."
    ]
  },
