  "rdfs:comment": {
    "de": [
      "Die ESF von Oz 3300 und ihre 40 Skilehrer freuen sich darauf, Ihnen das Skigebiet zu zeigen!\r\nZahlreiche Leistungen werden Ihnen von der ESF angeboten, damit Sie einen unvergesslichen Aufenthalt im Gebiet von Oz en Oisans verbringen können."
    ],
    "en": [
      "The ESF in Oz 3300 and its 40 instructors are eager to help you discover the ski area!\r\nMany services will be offered by the ESF to spend an unforgettable stay in the territory of Oz en Oisans."
    ],
    "it": [
      "L'ESF Oz 3300 e i suoi 40 istruttori sono pronti a farvi scoprire il comprensorio sciistico!\r\nL'ESF offre un'ampia gamma di servizi per rendere indimenticabile il vostro soggiorno a Oz en Oisans."
    ],
    "fr": [
      "L'ESF d'Oz 3300 et ses 40 moniteurs ont hâte de vous faire découvrir le domaine skiable !\r\nDe nombreuses prestations vous seront proposées par l'ESF pour passer un séjour inoubliable sur le territoire d'Oz en Oisans."
    ],
    "es": [
      "El ESF Oz 3300 y sus 40 monitores están deseando ayudarte a descubrir el dominio esquiable\r\nEl FSE ofrece una amplia gama de servicios para que su estancia en Oz en Oisans sea inolvidable."
    ],
    "nl": [
      "De ESF Oz 3300 en zijn 40 instructeurs helpen je graag om het skigebied te ontdekken!\r\nDe ESF biedt een breed scala aan diensten om je verblijf in Oz en Oisans onvergetelijk te maken."
    ]
  },
  "rdfs:label": {
