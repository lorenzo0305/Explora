  "rdfs:comment": {
    "de": [
      "Gehen Sie mit Baludik auf Entdeckungsreise in Valence und Romans! Eine mobile Anwendung, mit der die ganze Familie das alte Zentrum der beiden Städte entdecken und dabei Spaß haben kann!"
    ],
    "en": [
      "Discover Valence and Romans with Baludik! A mobile app that's fun for the whole family to discover the old town centers of both cities!"
    ],
    "it": [
      "Scoprite Valence e i Romani con Baludik! Un'applicazione mobile per scoprire il centro storico di entrambe le città con la famiglia divertendosi!"
    ],
    "fr": [
      "Partez à la découverte de Valence et Romans avec Baludik ! Une application mobile pour découvrir en famille le centre ancien des deux villes tout en s’amusant !"
    ],
    "es": [
      "¡Descubra Valence y los romanos con Baludik! Una aplicación móvil para descubrir el casco antiguo de ambas ciudades con su familia mientras se divierte"
    ],
    "nl": [
      "Ontdek Valence en Rome met Baludik! Een mobiele applicatie die leuk is voor het hele gezin om de oude stadscentra van beide steden te verkennen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste numérique \"La malédiction de Léon\" avec Baludik"
    ]
  },
