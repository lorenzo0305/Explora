  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais mit einem spielerischen und kostenlosen Geocaching-Erlebnis! In Courzieu begeben Sie sich auf die Jagd nach Sooshi, einer Wasserexpertin. Sie und die anderen Gnolus werden Ihnen das Dorf und seine Umgebung zeigen."
    ],
    "en": [
      "Discover a fun experience of geocaching with your smarthphone and try to find Graal, a little personage from Gnolus family !"
    ],
    "it": [
      "Scoprite i Monts du Lyonnais con un'esperienza di geocaching divertente e gratuita! A Courzieu, andate a caccia di Sooshi, uno specialista dell'acqua. Lei e gli altri Gnolus vi aiuteranno a scoprire il villaggio e i dintorni."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais grâce à une expérience ludique et gratuite de géocaching ! A Courzieu, partez à la chasse de Sooshi, spécialiste de l'eau. Elle et les autres Gnolus vous feront découvrir le village et ses environs."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais met een leuke, gratis geocaching-ervaring! Ga in Courzieu op zoek naar Sooshi, een waterspecialist. Zij en de andere Gnolus helpen je het dorp en de omgeving te ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais con una divertida experiencia gratuita de geocaching En Courzieu, busca a Sooshi, una especialista del agua. Ella y los demás Gnolus te ayudarán a descubrir el pueblo y sus alrededores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Promène ta fraise !"
    ]
  },
