  "rdfs:comment": {
    "de": [
      "Lucienne Renaudin Vary ist eine Entdeckung der Victoires de la Musique Classique 2016 und spielt mit dem Orchestre d'Harmonie de Vichy ein Programm, in dem sich die Glut der Oper und der Glanz der Konzertmusik vermischen, zwischen Lyrik und orchestraler Festlichkeit."
    ],
    "en": [
      "Revelation of the Victoires de la Musique Classique 2016, Lucienne Renaudin Vary joins the Orchestre d?Harmonie de Vichy for a program combining the ardor of opera and the brilliance of concert music, between lyricism and orchestral celebration."
    ],
    "it": [
      "Rivelazione dei Victoires de la Musique Classique 2016, Lucienne Renaudin Vary si unisce all'Orchestre d'Harmonie de Vichy per un programma che unisce l'ardore dell'opera e la brillantezza della musica da concerto, tra lirismo e celebrazione orchestrale."
    ],
    "fr": [
      "Révélation des Victoires de la Musique Classique 2016, Lucienne Renaudin Vary rejoint l’Orchestre d’Harmonie de Vichy pour un programme où se mêlent l’ardeur de l’opéra et l’éclat de la musique de concert, entre lyrisme et fête orchestrale."
    ],
    "es": [
      "Revelación de las Victoires de la Musique Classique 2016, Lucienne Renaudin Vary se une a la Orchestre d'Harmonie de Vichy para un programa que combina el ardor de la ópera y la brillantez de la música de concierto, entre lirismo y celebración orquestal."
    ],
    "nl": [
      "Openbaring van de 2016 Victoires de la Musique Classique, Lucienne Renaudin Vary vervoegt het Orchestre d?Harmonie de Vichy voor een programma dat de vurigheid van opera en de schittering van concertmuziek combineert, tussen lyriek en orkestrale viering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Orchestre d'Harmonie de Vichy - Hummel · Verdi · Borodine"
    ]
  },
