  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der solidarischen Wanderung teil, die von der APAJH in Allègre organisiert wird! Es werden zwei Strecken angeboten (4 km oder 10 km) sowie Verpflegungsstände, ein Imbiss und eine Tombola."
    ],
    "en": [
      "Take part in the solidarity hike organized by APAJH in Allègre! Two routes are available (4 km or 10 km), as well as refreshments, a snack and a tombola."
    ],
    "it": [
      "Partecipate alla passeggiata di solidarietà organizzata dall'APAJH ad Allègre! Sono previsti due percorsi a scelta (4 km o 10 km), oltre a un rinfresco, una merenda e una tombola."
    ],
    "fr": [
      "Participez à la randonnée pédestre solidaire organisée par l’APAJH à Allègre ! Deux parcours sont proposés (4 km ou 10 km) ainsi que  ravitaillements, goûter et tombola."
    ],
    "es": [
      "Participa en la marcha solidaria organizada por la APAJH en Allègre Hay dos recorridos para elegir (4 km o 10 km), además de refrescos, un tentempié y una tómbola."
    ],
    "nl": [
      "Neem deel aan de solidariteitswandeling die APAJH in Allègre organiseert! Er zijn twee routes om uit te kiezen (4 km of 10 km), plus verfrissingen, een snack en een tombola."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée solidaire de la Merisaie à Allègre"
    ]
  },
