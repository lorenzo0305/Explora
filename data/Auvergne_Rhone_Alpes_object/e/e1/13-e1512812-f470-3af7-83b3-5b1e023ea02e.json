  "rdfs:comment": {
    "de": [
      "Eine großzügige und schmackhafte Mahlzeit auf 2000 m Höhe, ein überarbeitetes Selbstbedienungsrestaurant, das Ihnen eine leckere und gesellige Küche bietet: Willkommen in La Petite Cuisine de La Folie Douce Saint-Gervais Megève!"
    ],
    "en": [
      "Enjoy a generous and tasty meal on the slopes. Located at an altitude of 2,000 m, this self-service restaurant proposes gourmet family-friendly cuisine. Welcome to La Petite Cuisine at La Folie Douce, Saint-Gervais Megève!"
    ],
    "it": [
      "Un pasto abbondante e gustoso in movimento a 2.000 m di altitudine. ristorante self-service che offre una cucina gourmet e conviviale: Benvenuti a La Petite Cuisine de La Folie Douce Saint-Gervais Megève!"
    ],
    "fr": [
      "Un repas généreux et savoureux pris sur le pouce à 2000 m d’altitude, un self-service revisité qui vous proposera une cuisine gourmande et conviviale : bienvenue à La Petite Cuisine de La Folie Douce Saint-Gervais Megève !"
    ],
    "es": [
      "Una comida generosa y sabrosa sobre la marcha a 2.000 m de altitud, un autoservicio renovado que ofrece una cocina gastronómica y acogedora: ¡bienvenido a La Petite Cuisine de La Folie Douce Saint-Gervais Megève!"
    ],
    "nl": [
      "Een gulle, smakelijke maaltijd voor onderweg op 2.000 m hoogte, een vernieuwde zelfbediening met een gastronomische, vriendelijke keuken: welkom bij La Petite Cuisine in La Folie Douce Saint-Gervais Megève!"
    ]
  },
