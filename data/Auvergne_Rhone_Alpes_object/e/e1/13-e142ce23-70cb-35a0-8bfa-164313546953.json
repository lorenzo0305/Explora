  "rdfs:comment": {
    "de": [
      "La Ferme du Fornet bedeutet die Förderung einer lokalen Wirtschaft, die Aufwertung eines Know-hows, den Respekt vor Tieren und der Natur. Eine biologische Landwirtschaft unterstützen."
    ],
    "en": [
      "La Ferme du Fornet means encouraging a local economy, promoting know-how and respect for animals and nature. Supporting organic farming."
    ],
    "it": [
      "La Ferme du Fornet vuole incoraggiare l'economia locale, promuovere il know-how e rispettare gli animali e la natura. Sostenere l'agricoltura biologica."
    ],
    "fr": [
      "La Ferme du Fornet, c'est encourager une économie locale, la valorisation d'un savoir-faire, le respect de l'animal et de la nature. Soutenir une agriculture biologique."
    ],
    "nl": [
      "La Ferme du Fornet stimuleert de lokale economie, bevordert knowhow en respecteert dieren en de natuur. De biologische landbouw ondersteunen."
    ],
    "es": [
      "La Ferme du Fornet fomenta la economía local, el desarrollo del saber hacer y el respeto por los animales y la naturaleza. Apoya la agricultura ecológica."
    ]
  },
