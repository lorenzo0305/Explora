  "rdfs:comment": {
    "de": [
      "Hotel mit 13 komfortablen Zimmern am Col de Mézilhac, 15 km vom Gerbier des Joncs, 10 km vom Wasserfall Ray Pic entfernt.Privater Parkplatz, große Garage, Empfang von Gruppen, Motorrad-Relais.Traditionelle, hausgemachte Küche in einem jungen und dynamischen Rahmen."
    ],
    "en": [
      "Hotel with 13 comfortable rooms located on the Col de Mézilhac, 15 km from Gerbier des Joncs and 10 km from the Ray Pic waterfall. Private car park, large garage, group facilities, motorbike stopover. Traditional homemade cuisine in a young and dynamic setting."
    ],
    "it": [
      "Hotel con 13 camere confortevoli situato sul Col de Mézilhac, a 15 km dal Gerbier des Joncs, a 10 km dalla cascata del Ray Pic, parcheggio privato, ampio garage, strutture per gruppi, sosta per le moto. Cucina tradizionale casalinga in un ambiente giovane e dinamico."
    ],
    "fr": [
      "Hôtel de 13 chambres tout confort situé au Col de Mézilhac, à 15 km du Gerbier des Joncs, 10 km de la cascade du Ray Pic.Parking privé, grand garage, accueil de groupes, relais motards. Cuisine traditionnelle fait maison dans un cadre jeune et dynamique."
    ],
    "nl": [
      "Hotel met 13 kamers, van alle gemakken voorzien, gelegen op de Col de Mézilhac, op 15 km van Gerbier des Joncs en op 10 km van de waterval Ray Pic.Privéparkeerplaats, grote garage, groepsfaciliteiten, motorstop.Traditionele, huisgemaakte keuken in een jong, dynamisch kader."
    ],
    "es": [
      "Hotel de 13 confortables habitaciones situado en el Col de Mézilhac, a 15 km de Gerbier des Joncs, a 10 km de la cascada de Ray Pic, aparcamiento privado, amplio garaje, instalaciones para grupos, parada de motos. Cocina casera tradicional en un ambiente joven y dinámico."
    ]
  },
