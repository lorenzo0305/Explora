  "rdfs:comment": {
    "de": [
      "Teambuilding, Afterwork, EVG/EVJF :\r\nCalade WaterPark bietet schlüsselfertige, zugängliche und unvergessliche Erlebnisse in einer einzigartigen natürlichen Umgebung am Wasser. Alles ist so konzipiert, dass es sich an Ihre Gruppe, Ihre Energie und Ihr Ziel anpasst."
    ],
    "en": [
      "Team building, after-work events, stag/hen parties:\r\nCalade WaterPark offers accessible, memorable, turnkey experiences in a unique natural setting by the water. Everything is designed to suit your group, your energy levels and your objectives."
    ],
    "it": [
      "Team building, dopolavoro, EVG/EVJF :\r\nIl parco acquatico Calade offre esperienze \"chiavi in mano\" accessibili e memorabili, in un ambiente naturale unico in riva al mare. Tutto è progettato per soddisfare il vostro gruppo, la vostra energia e il vostro obiettivo."
    ],
    "fr": [
      "Team building, afterwork, EVG/EVJF :\r\nCalade WaterPark propose des expériences clés en main, accessibles et mémorables, dans un cadre naturel unique au bord de l’eau, tout est conçu pour s’adapter à votre groupe, votre énergie et votre objectif."
    ],
    "nl": [
      "Teambuilding, afterwork, EVG/EVJF :\r\nCalade WaterPark biedt kant-en-klare ervaringen die toegankelijk en gedenkwaardig zijn, in een unieke natuurlijke omgeving aan het water. Alles is afgestemd op uw groep, uw energie en uw doel."
    ],
    "es": [
      "Team building, afterwork, EVG/EVJF :\r\nCalade WaterPark ofrece experiencias llave en mano, accesibles y memorables, en un entorno natural único junto al agua. Todo está diseñado para adaptarse a su grupo, su energía y su objetivo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Calade Waterpark Team-Building"
    ],
    "fr": [
      "Calade Waterpark Team-Building"
    ]
  },
