  "rdfs:comment": {
    "de": [
      "Das Angeln in den Bergen hält oft schöne Überraschungen bereit. Kommen Sie mit einem professionellen und leidenschaftlichen Angelführer auf die Jagd nach Forellen und anderen Salmoniden in den Wasserläufen der gesamten Maurienne."
    ],
    "en": [
      "Fishing in the mountains is often full of surprises. Come and stalk trout & other salmonids in streams throughout the Maurienne, accompanied by a professional & passionate fishing guide."
    ],
    "it": [
      "La pesca in montagna è spesso piena di sorprese. Venite a scovare trote e altri salmonidi nei fiumi e nei torrenti di tutta la Maurienne, accompagnati da una guida di pesca professionale ed entusiasta."
    ],
    "fr": [
      "La pêche en montagne réserve souvent de belles surprises. Venez traquer truites & autres salmonidés des cours d'eau de toute la Maurienne, accompagné d'un guide de pêche professionnel & passionné."
    ],
    "nl": [
      "Vissen in de bergen zit vaak vol verrassingen. Ga onder begeleiding van een professionele en enthousiaste visgids op zoek naar forel en andere zalmachtigen in rivieren en beken in de Maurienne."
    ],
    "es": [
      "La pesca en montaña suele estar llena de sorpresas. Venga a rastrear truchas y otros salmónidos en ríos y arroyos de toda la Maurienne, acompañado por un guía de pesca profesional y entusiasta."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Moniteur guide de pêche - Augustin FELLER"
    ]
  },
