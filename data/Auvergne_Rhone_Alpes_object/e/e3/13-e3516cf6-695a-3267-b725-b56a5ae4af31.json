  "rdfs:comment": {
    "de": [
      "Entdecken Sie Altitude Intersport in Lanslevillard, das unumgängliche Geschäft für die Vermietung und den Kauf von Sportausrüstung, Sommer wie Winter. Alles, was Sie für Ihren Urlaub brauchen!"
    ],
    "en": [
      "Discover Altitude Intersport in Lanslevillard, the one-stop store for rental and purchase of sports equipment, summer and winter alike. Everything you need for your vacations!"
    ],
    "it": [
      "Scoprite Altitude Intersport a Lanslevillard, il negozio unico per il noleggio e l'acquisto di attrezzature sportive, sia estive che invernali. Tutto ciò di cui avete bisogno per le vostre vacanze!"
    ],
    "fr": [
      "Découvrez Altitude Intersport à Lanslevillard, le magasin incontournable pour la location et l'achat d'équipements de sport, été comme hiver. Tous ce dont vous avez besoin pour vos vacances !"
    ],
    "nl": [
      "Ontdek Altitude Intersport in Lanslevillard, de one-stop shop voor het huren en kopen van sportmateriaal, zowel in de zomer als in de winter. Alles wat je nodig hebt voor je vakantie!"
    ],
    "es": [
      "Descubra Altitude Intersport en Lanslevillard, la ventanilla única para alquilar y comprar material deportivo, tanto de verano como de invierno. Todo lo que necesitas para tus vacaciones"
    ]
  },
