  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/96f8d039-2493-398e-8e05-6dc04d645dec",
      "dc:description": {
        "de": [
          "Die Ducasse de Mencas findet ab 13.00 Uhr statt\n\nPreise:\n\n- Erwachsene: 17? (Getränke nicht inbegriffen),\n- Kinder: 12? (Getränke nicht inbegriffen).\n\nReservierung bis zum 24. August."
        ],
        "en": [
          "The Ducasse de Mencas will be held from 1:00 p.m\n\nPrice :\n\n- Adult: 17? (drinks not included),\n- Children: 12? (drinks not included).\n\nReservations by August 24."
        ],
        "it": [
          "La Ducasse de Mencas si terrà a partire dalle 13:00\n\nPrezzo :\n\n- Adulti: 17 € (bevande escluse),\n- Bambini: 12 € (bevande escluse).\n\nPrenotazione obbligatoria entro il 24 agosto."
        ],
        "fr": [
          "La Ducasse de Mencas se tiendra à partir de 13h00\n\nTarif : \n\n- Adulte : 17€ (boissons non comprises),\n- Enfant : 12€ (boissons non comprises).\n\nRéservation avant le 24 août."
        ],
        "es": [
          "El Ducasse de Mencas se celebrará a partir de las 13.00 horas\n\nPrecio :\n\n- Adultos: 17 euros (bebidas no incluidas),\n- Niños: 12 € (bebidas no incluidas).\n\nEs necesario reservar antes del 24 de agosto."
        ],
        "nl": [
          "De Ducasse de Mencas wordt gehouden vanaf 13:00 uur\n\nPrijs :\n\n- Volwassenen: €17 (drankjes niet inbegrepen),\n- Kinderen: €12 (exclusief drankjes).\n\nReserveren verplicht vóór 24 augustus."
        ]
      },
