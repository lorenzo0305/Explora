  "rdfs:comment": {
    "de": [
      "Ski- und Snowboardschule, Skilanglauf und Schneeschuhwandern.\r\nSki alpin, Langlauf. Wettkampfkurse, Snowboardkurse, Freestyle-Kurse.\r\nAusflüge mit Schneeschuhen.\r\nKurse für Handiski\r\nKindergarten ab 3 Jahren."
    ],
    "en": [
      "French ski school. Ski and snowboard, nordic skiing and snowshoeing. \r\nFreestyle, free ride and races. Handiski and kindergarden from 3 y.o."
    ],
    "it": [
      "Scuola di sci e snowboard, sci di fondo e racchette da neve.\r\nSci alpino e di fondo. Corsi di competizione, corsi di snowboard, corsi di freestyle.\r\nEscursioni con le racchette da neve.\r\nLezioni di sci a mano\r\nScuola materna a partire dai 3 anni."
    ],
    "fr": [
      "Ecole de ski et snowboard, ski de fond et raquettes.\r\nSki alpin, fond. Stages compétition, stages snowboard, stages freestyle.\r\nSorties raquettes.\r\nCours handiski\r\nJardin d'enfant à partir de 3 ans."
    ],
    "nl": [
      "Ski- en snowboardschool, langlaufen en sneeuwschoenwandelen.\r\nAlpineskiën en langlaufen. Wedstrijdlessen, snowboardlessen, freestyle lessen.\r\nUitstapjes op sneeuwschoenen.\r\nHandiski lessen\r\nKleuterschool vanaf 3 jaar."
    ],
    "es": [
      "Escuela de esquí y snowboard, esquí de fondo y raquetas de nieve.\r\nEsquí alpino y de fondo. Cursos de competición, cursos de snowboard, cursos de freestyle.\r\nSalidas con raquetas de nieve.\r\nClases de handiski\r\nJardín de infancia a partir de 3 años."
    ]
  },
