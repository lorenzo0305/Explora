  "rdfs:comment": {
    "de": [
      "Escape Game in freier Natur: Erkunden Sie das Kulturerbe der Gemeinde Ferrières Saint Mary und entdecken Sie die fabelhafte Geschichte des Einsiedlers Marius, der zu Saint Mary wurde..."
    ],
    "en": [
      "Nature Escape Game: explore the heritage of Ferrières Saint Mary and discover the fabulous story of the hermit Marius, who became Saint Mary..."
    ],
    "it": [
      "Gioco di fuga nel cuore della natura: esplorate il patrimonio di Ferrières Saint Mary e scoprite la favolosa storia dell'eremita Marius, divenuto Santa Maria..."
    ],
    "fr": [
      "Escape Game en plein nature : explorez le patrimoine de la commune de Ferrières Saint Mary en découvrant l'histoire fabuleuse de l'ermite Marius, devenu Saint Mary..."
    ],
    "nl": [
      "Ontsnappingsspel in het hart van de natuur: verken het erfgoed van Ferrières Saint-Marie en ontdek het fabelachtige verhaal van de kluizenaar Marius, die Saint-Marie werd..."
    ],
    "es": [
      "Juego de evasión en plena naturaleza: explore el patrimonio de Ferrières Saint Mary y descubra la fabulosa historia del ermitaño Marius, convertido en Santa María..."
    ]
  },
