  "rdfs:comment": {
    "de": [
      "Familiengeführtes Restaurant seit 1939. Traditionelle Küche mit frischen Produkten und hausgemachten Gerichten: Cabri aux morilles, Couscous, Paëlla, Chili con Carne, Frösche, Kalbskopf, Geflügelleberkuchen, Rinderzunge, Bouillabaisse, Cassoulet..."
    ],
    "en": [
      "Family restaurant since 1939. Traditional cuisine with fresh products and homemade dishes: cabri with morels, couscous, paella, chili con carne, frogs, calf's head, chicken liver cake, beef tongue, bouillabaisse, cassoulet..."
    ],
    "it": [
      "Ristorante a conduzione familiare dal 1939. Cucina tradizionale con prodotti freschi e piatti fatti in casa: cabri aux morilles, couscous, paella, chili con carne, rane, testa di vitello, torta di fegato di pollo, lingua di manzo, bouillabaisse, cassoulet..."
    ],
    "fr": [
      "Restaurant familial depuis 1939. Cuisine traditionnelle avec produits frais et plats faits maison : cabri aux morilles, couscous, paëlla, chili con carne, grenouilles, tête de veau, gâteau de foie de volaille, langue de boeuf, bouillabaisse, cassoulet..."
    ],
    "es": [
      "Restaurante familiar desde 1939. Cocina tradicional con productos frescos y platos caseros: cabri aux morilles, cuscús, paella, chili con carne, ranas, cabeza de ternera, pastel de hígado de pollo, lengua de vaca, bullabesa, cassoulet..."
    ],
    "nl": [
      "Familie restaurant sinds 1939. Traditionele keuken met verse producten en huisgemaakte gerechten: cabri aux morilles, couscous, paella, chili con carne, kikkers, kalfskop, kippenlevertaart, rundertong, bouillabaisse, cassoulet..."
    ]
  },
