  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Wüste von Platé (eines der größten Lapiazgebiete Europas). Romain und sein Team heißen Sie mittags willkommen, um einen Moment der Entspannung auf der Terrasse zu genießen. Mittags sind Speisen und Getränke vor Ort erhältlich, eine Reservierung ist nicht erforderlich."
    ],
    "en": [
      "Come and discover the Platé desert (one of the largest lapiaz in Europe), Romain and his team welcome you for lunch to enjoy a moment of relaxation on the terrace. At noon, catering and drinks on site, without reservation."
    ],
    "it": [
      "Venite a scoprire il deserto di Platé (uno dei più grandi lapiaz d'Europa). Romain e il suo team saranno lieti di accogliervi per un pranzo e un momento di relax sulla terrazza. A pranzo, cibo e bevande disponibili in loco, senza prenotazione."
    ],
    "fr": [
      "Venez découvrir le désert de Platé (l’un des plus vastes lapiaz d’Europe), Romain et son équipe vous accueillent le midi pour apprécier un moment de détente en terrasse. Le midi, restauration et boissons sur place, sans réservation."
    ],
    "es": [
      "Venga a descubrir el desierto de Platé (uno de los mayores lapiaz de Europa). Romain y su equipo estarán encantados de recibirle para almorzar y disfrutar de un momento de relax en la terraza. A la hora de comer, comida y bebida disponibles in situ, sin reserva previa."
    ],
    "nl": [
      "Kom en ontdek de Platé-woestijn (een van de grootste lapiaz-woestijnen van Europa). Romain en zijn team heten u welkom voor de lunch om te genieten van een moment van ontspanning op het terras. Tussen de middag catering en borrel ter plaatse, zonder reservering."
    ]
  },
  "rdfs:label": {
