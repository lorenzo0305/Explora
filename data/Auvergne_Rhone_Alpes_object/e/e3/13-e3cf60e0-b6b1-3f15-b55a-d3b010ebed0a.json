  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Méjeonnes ist ein Bistro, das authentische, gesellige und ehrliche Dinge liebt - eine Anspielung auf den milden Süden. Das Küchenteam lädt Sie ein, eine Küche mit den Aromen der Drôme Provençale zu entdecken."
    ],
    "en": [
      "With its bistro vibe, Les Méjeonnes keeps things authentic, friendly and sincere, in typical southern fashion. The kitchen team invites you to discover the flavoursome cuisine of the Drôme Provençale."
    ],
    "it": [
      "In un ambiente bistrot, il ristorante Méjeonnes è all'insegna dell'autenticità, della convivialità e della sincerità, un cenno al dolce sud. Il team di cucina vi invita a scoprire i sapori della Drôme Provençale."
    ],
    "fr": [
      "Dans un cadre bistro, le restaurant les Méjeonnes aime les choses authentiques, conviviales et sincères, un clin d’œil à la douceur du Sud. L'équipe de cuisine vous invite à découvrir une cuisine aux saveurs de la Drôme Provençale."
    ],
    "nl": [
      "In een bistrotachtige setting bij, \"Les Méjeonnes\" heerst een authentieke, gezellige en oprechte sfeer, een knipoog naar het goede leven in het zuiden. Christophe FLUCK en zijn team ontvangen u graag om u te laten kennismaken met de karakteristieke smaken uit de Drôme Provençale."
    ],
    "es": [
      "En un ambiente de bistró, el restaurante Méjeonnes es todo autenticidad, cordialidad y sinceridad, un guiño al suave sur. El equipo de cocina le invita a descubrir los sabores de la Drôme provenzal."
    ]
  },
