  "rdfs:comment": {
    "de": [
      "Das Restaurant O Capot bietet Ihnen eine Speisekarte mit saisonalen und qualitativ hochwertigen Menüs an, die für jeden eine Gaumenfreude sind. Sie können dort jedoch nicht nur essen, sondern auch Pétanque spielen."
    ],
    "en": [
      "The restaurant O Capot offers a seasonal menu, tiny but quality, enough to satisfy any palate. Besides catering service, you can practice the petanque."
    ],
    "it": [
      "Il ristorante O Capot vi propone un menù stagionale modesto, ma di qualità, che soddisfa qualsiasi esigenza. Oltre al servizio ristorazione, è anche possibile praticare il gioco delle bocce locali, la pétanque."
    ],
    "fr": [
      "Le restaurant O Capot vous propose une carte saisonnière menue mais de qualité, de quoi satisfaire tous les palais. Outre le service restauration, vous pourrez y pratiquer la pétanque."
    ],
    "nl": [
      "Het restaurant O Capot biedt een klein maar kwalitatief seizoensgebonden menu, genoeg om alle fijnproevers tevreden te stellen. Naast de restaurantservice kunt u petanque spelen."
    ],
    "es": [
      "El restaurante O Capot ofrece una carta de temporada, breve pero de calidad, para satisfacer todos los paladares. Además del servicio de restauración, en este establecimiento se puede practicar la petanca."
    ]
  },
