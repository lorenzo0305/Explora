  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant inmitten der Landschaft des Parc livradois Forez, wo sich eine hausgemachte Küche aus lokalen Produkten vermischt\r\nGeöffnet Montag und Dienstag mittags, Mittwoch bis Sonntag mittags und abends\r\nReservierung erwünscht"
    ],
    "en": [
      "This restaurant serves regional specialties next to the Cistercian Abbey of Montpeyroux. Open daily for lunch. Reservations required before 7 p.m. for dinner (closed Monday and Tuesday evenings)."
    ],
    "it": [
      "Ristorante tradizionale, in mezzo alla campagna del Parc livradois Forez, dove si mescola una cucina casalinga a base di prodotti locali\r\nAperto lunedì e martedì a pranzo, da mercoledì a domenica a pranzo e a cena\r\nPrenotazione obbligatoria"
    ],
    "fr": [
      "Restaurant traditionnel, au milieu de la campagne du Parc livradois Forez où se mélange une cuisine maison à base de produits locaux. \r\nOuvert Lundi et Mardi midi, Mercredi au Dimanche le midi et le soir\r\nRéservation souhaitée"
    ],
    "nl": [
      "Traditioneel restaurant, midden op het platteland van het Parc livradois Forez waar huisgemaakte gerechten op basis van lokale producten worden gemengd\r\nOpen maandag en dinsdag voor lunch, woensdag tot zondag voor lunch en diner\r\nReservering verplicht"
    ],
    "es": [
      "Restaurante tradicional, en pleno campo del Parc livradois Forez donde se mezcla la cocina casera a base de productos locales\r\nAbierto lunes y martes para el almuerzo, de miércoles a domingo para el almuerzo y la cena\r\nEs necesario reservar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de la Credogne"
    ]
  },
