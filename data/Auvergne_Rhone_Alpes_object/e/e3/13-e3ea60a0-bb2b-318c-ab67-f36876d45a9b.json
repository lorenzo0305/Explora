  "rdfs:comment": {
    "de": [
      "Die Villa Caroline liegt etwa 10 km vom Stadtzentrum von Annecy entfernt und genießt eine außergewöhnliche Umgebung. Zwischen See und Bergen gelegen, ist dieses charmante 4-Sterne-Hotel ideal, um sich eine beruhigende und zeitlose Auszeit zu gönnen."
    ],
    "en": [
      "Located around ten kilometres from Annecy town centre, Villa Caroline enjoys an exceptional setting. Set between the lake and the mountains, this charming 4-star hotel is ideal for a soothing, timeless break."
    ],
    "it": [
      "Situata a circa dieci chilometri dal centro di Annecy, Villa Caroline gode di un ambiente eccezionale. Situato tra il lago e le montagne, questo incantevole hotel a 4 stelle è ideale per una pausa rilassante e senza tempo."
    ],
    "fr": [
      "Situé à une dizaine de kilomètres du centre ville d’Annecy, la Villa Caroline jouit d’un cadre exceptionnel. Entre lac et montagne, ce charmant hôtel 4 étoiles est idéal pour s’offrir une parenthèse apaisante et hors du temps."
    ],
    "nl": [
      "Villa Caroline ligt op ongeveer tien kilometer van het centrum van Annecy en geniet van een uitzonderlijke omgeving. Dit charmante 4-sterrenhotel ligt tussen het meer en de bergen en is ideaal voor een rustgevende, tijdloze vakantie."
    ],
    "es": [
      "Situada a unos diez kilómetros del centro de Annecy, Villa Caroline goza de un marco excepcional. Situado entre el lago y las montañas, este encantador hotel de 4 estrellas es ideal para una escapada relajante y atemporal."
    ]
  },
