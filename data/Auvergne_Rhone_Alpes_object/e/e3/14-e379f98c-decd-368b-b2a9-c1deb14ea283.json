  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11d6492a-ecd2-344e-9c5f-55fafeda1210",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 9:00 bis 12:30 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:30 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\nZu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 9am to 12:30pm and 2pm to 7pm\nSaturday 9am to 12:30pm\n\nClosed on Sunday\n \n Collection:\n\nDuring pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 9.00 alle 12.30 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.30\n\nChiuso la domenica\n \n Ritiro:\n\nDurante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 9h à 12h30 et de 14h à 19h\nLe samedi de 9h à 12h30\n\nFermeture le dimanche\n \n Retrait :\n\nAux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 9u tot 12u30 en van 14u tot 19u\nZaterdag van 9u tot 12u30\n\nZondag gesloten\n \n Ophalen:\n\nTijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 9.00 a 12.30 h. y de 14.00 a 19.00 h\nSábado de 9h a 12h30\n\nDomingos cerrado\n \n Recogida:\n\nDurante el horario de apertura de la farmacia\n\n "
        ]
      },
