  "rdfs:comment": {
    "de": [
      "Die 2009 gegründete Ferme et Distillerie des Hautes Glaces kreiert regionale Whiskys, die die typischen und spezifischen Aromen der Getreidesorten hervorheben sollen, die in der Region Trièves nach den Grundsätzen der biologischen & regenerativen Landwirtschaft angebaut werden."
    ],
    "en": [
      "Founded in 2009, Ferme et Distillerie des Hautes Glaces creates terroir whiskies designed to sublimate the typicity and aromatic specificity of cereal varieties grown in the Trièves region according to the principles of organic & regenerative agriculture."
    ],
    "it": [
      "Fondata nel 2009, la Ferme et Distillerie des Hautes Glaces crea whisky di terroir progettati per sublimare la tipicità e la specificità aromatica delle varietà di cereali coltivate nel Trièves secondo i principi dell'agricoltura biologica e rigenerativa."
    ],
    "fr": [
      "Fondée en 2009, la Ferme et Distillerie des Hautes Glaces crée des whiskys de terroir visant à sublimer la typicité et la spécificité aromatique des variétés de céréales cultivées en Trièves selon les principes de l’agriculture biologique & régénérative."
    ],
    "es": [
      "Fundada en 2009, la Ferme et Distillerie des Hautes Glaces crea whiskies de terruño concebidos para sublimar la tipicidad y la especificidad aromática de las variedades de cereales cultivadas en las Trièves según los principios de la agricultura biológica y regenerativa."
    ],
    "nl": [
      "De Ferme et Distillerie des Hautes Glaces, opgericht in 2009, creëert terroirwhisky's die zijn ontworpen om de typische en aromatische specificiteit van de graanvariëteiten die in de Trièves worden verbouwd te sublimeren volgens de principes van biologische en regeneratieve landbouw."
    ]
  },
  "rdfs:label": {
