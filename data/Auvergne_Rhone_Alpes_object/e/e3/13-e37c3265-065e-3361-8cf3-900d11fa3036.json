  "rdfs:comment": {
    "de": [
      "Baronnies Bike ist eine Mountainbike-Schule, die aus staatlich geprüften Lehrern besteht und Begleitung, Fortbildung sowie Verleih anbietet."
    ],
    "en": [
      "Baronnies is a moutain bike school led by professional instructors who offer courses for beginners and intermediate, as well as renting."
    ],
    "it": [
      "Baronnies Bike è una scuola di mountain bike con istruttori qualificati che offrono coaching, miglioramento e noleggio."
    ],
    "fr": [
      "Baronnies Bike est une école de VTT composée de moniteurs diplômés d’état qui propose de l’accompagnement, du perfectionnement ainsi que de la location."
    ],
    "nl": [
      "Baronnies Bike is een mountainbikeschool die wordt gerund door gediplomeerde instructeurs en waar je terecht kunt voor coaching, gevorderde training en verhuur."
    ],
    "es": [
      "Baronnies Bike es una escuela de ciclismo de montaña con instructores cualificados que ofrecen entrenamiento, perfeccionamiento y alquiler."
    ]
  },
