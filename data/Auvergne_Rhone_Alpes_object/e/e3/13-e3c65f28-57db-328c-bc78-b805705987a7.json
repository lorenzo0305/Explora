  "rdfs:comment": {
    "de": [
      "Mehlherstellung: Mehrere Siebungen möglich (Weißmehl, Halbvollkornmehl, Vollkornmehl).\r\nMehrere Weizensorten (moderner Weizen, alter Weizen, Kraftweizen) Roggen.\r\nBuchweizen, Dinkel, Mais (Polenta und Maismehl)."
    ],
    "en": [
      "Flour production: several sifting options (white, semi-whole, wholemeal).\r\nSeveral types of wheat (modern, ancient, hard wheat) Rye.\r\nBuckwheat, spelt, corn (polenta and corn flour)."
    ],
    "it": [
      "Produzione di farina: diverse opzioni di setacciatura (farina bianca, semi-integrale e integrale).\r\nDiversi tipi di grano (moderno, antico, duro), segale.\r\nGrano saraceno, farro, mais (polenta e farina di mais)."
    ],
    "fr": [
      "Production de farine : plusieurs tamisages possibles (farine blanche, semi complète, complète). \r\nPlusieurs types de blés (blés modernes, anciens, blés de force) du seigle.\r\nSarrasin, grand épeautre, du maïs (polenta et farine de maïs)."
    ],
    "es": [
      "Producción de harina: varias opciones de cernido (harina blanca, semi integral e integral).\r\nVarios tipos de trigo (moderno, antiguo, duro) centeno.\r\nTrigo sarraceno, espelta, maíz (polenta y harina de maíz)."
    ],
    "nl": [
      "Meelproductie: verschillende zeefmogelijkheden (wit, halfvol en volkoren meel).\r\nVerschillende soorten tarwe (moderne, oude en harde tarwe), rogge.\r\nBoekweit, spelt, maïs (polenta en maïsmeel)."
    ]
  },
  "rdfs:label": {
