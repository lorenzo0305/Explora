  "rdfs:comment": {
    "de": [
      "Vercors Vertical bietet Canyoning, Klettern, Höhlenforschung und Klettersteige in den Vercors an. Entdecken Sie auch ungewöhnliche Übernachtungen im Portaledge oder im unterirdischen Biwak. Von passionierten Führern betreute Aktivitäten für einzigartige Momente inmitten der Natur."
    ],
    "en": [
      "Vercors Vertical offers canyoning, climbing, caving and via ferrata in the Vercors. Discover also unusual nights in portaledge or underground bivouac. Activities supervised by passionate guides, for unique moments in the heart of nature."
    ],
    "it": [
      "Vercors Vertical propone canyoning, arrampicata, speleologia e vie ferrate nel Vercors. È anche possibile trascorrere una notte insolita in un portaledge o in un bivacco sotterraneo. Attività seguite da guide appassionate, per momenti unici nel cuore della natura."
    ],
    "fr": [
      "Vercors Vertical propose canyoning, escalade, spéléologie et via ferrata dans le Vercors. Découvrez aussi des nuits insolites en portaledge ou bivouac souterrain. Activités encadrées par des guides passionnés, pour des moments uniques en pleine nature."
    ],
    "es": [
      "Vercors Vertical ofrece barranquismo, escalada, espeleología y vías ferratas en el Vercors. También puede pasar una noche insólita en un portaledge o vivac subterráneo. Actividades supervisadas por guías apasionados, para momentos únicos en plena naturaleza."
    ],
    "nl": [
      "Vercors Vertical biedt canyoning, klimmen, speleologie en klettersteigen in de Vercors. Je kunt ook een ongewone nacht doorbrengen in een portaledge of ondergronds bivak. Activiteiten onder begeleiding van gepassioneerde gidsen, voor unieke momenten in het hart van de natuur."
    ]
  },
