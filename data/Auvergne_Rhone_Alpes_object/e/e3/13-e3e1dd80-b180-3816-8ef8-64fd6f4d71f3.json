  "rdfs:comment": {
    "de": [
      "Ein Spaziergang mit der Familie oder mit Freunden auf einem früher verbotenen Gebiet: einer ehemaligen Eisenbahnstrecke! 2 Strecken von 5km (10km Hin- und Rückfahrt nach Gannat - 1h) oder 8km (16km Hin- und Rückfahrt nach Bayet - 1h30). Vélorails mit elektrischer Unterstützung und automatische Wender."
    ],
    "en": [
      "A walk with family or friends on a formerly forbidden area: an old railroad track! 3 circuits from 10 to 26 km for 1h15 to 3h15. The velorails are electrically assisted."
    ],
    "it": [
      "Una passeggiata in famiglia o con gli amici su un'area un tempo proibita: un vecchio binario ferroviario! 2 percorsi di 5 km (10 km di ritorno a Gannat - 1h) o 8 km (16 km di ritorno a Bayet - 1h30). Velocipedi a trazione elettrica e ritorno automatico."
    ],
    "fr": [
      "Une balade en famille ou entre amis sur un espace autrefois interdit : une ancienne voie ferrée ! 2 parcours de 5km (10km A/R vers Gannat - 1h) ou 8km (16km A/R vers Bayet - 1h30). Vélorails à assistance électrique et retourneurs automatiques."
    ],
    "es": [
      "Un paseo en familia o con amigos por una zona antaño prohibida: ¡una antigua vía de tren! 2 recorridos de 5 km (10 km ida y vuelta a Gannat - 1h) u 8 km (16 km ida y vuelta a Bayet - 1h30). Velocípedos eléctricos y retornos automáticos."
    ],
    "nl": [
      "Fietsspoorlijn"
    ]
  },
  "rdfs:label": {
