  "rdfs:comment": {
    "de": [
      "In einem modernen und farbenfrohen Rahmen genießen Sie eine \"Thekenküche\" für gemeinsame und gesellige Momente mit den Brettern für den Aperitif."
    ],
    "en": [
      "In a modern and colourful setting, come and enjoy a \"counter\" kitchen for moments of sharing and conviviality with the boards for the aperitif."
    ],
    "it": [
      "In un ambiente moderno e colorato, venite a gustare una cucina \"da banco\" per momenti di condivisione e convivialità con le tavole per l'aperitivo."
    ],
    "fr": [
      "Dans un cadre moderne et coloré venez déguster une cuisine \"de comptoir\" pour des moments de partage et de convivialité avec les planches pour l'apéritif."
    ],
    "nl": [
      "Kom in een modern en kleurrijk kader genieten van een \"counter\" keuken voor momenten van delen en gezelligheid met de borden voor het aperitief."
    ],
    "es": [
      "En un marco moderno y colorido, venga a disfrutar de una cocina de \"mostrador\" para los momentos de compartir y convivir con las tablas del aperitivo."
    ]
  },
