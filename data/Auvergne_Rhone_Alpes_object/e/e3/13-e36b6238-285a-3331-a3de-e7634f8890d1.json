  "rdfs:comment": {
    "de": [
      "☀️ La Terrasse - Aime 2000 ☀️\r\nIhr Gourmet- und Partyspot am Fuße der Pisten!\r\nSavoyische Küche , Cocktails und Après-Ski-Atmosphäre , direkt neben der Skischule und der Telemetro."
    ],
    "en": [
      "La Terrasse has a large dining area both inside and outside the restaurant, at Plagne Aime 2000"
    ],
    "it": [
      "?? La Terrasse? Aime 2000?\r\nIl vostro punto di ristoro e di festa ai piedi delle piste!\r\nCucina savoiarda, cocktail e atmosfera après-ski, proprio vicino alla scuola di sci e al Télémétro."
    ],
    "fr": [
      "☀️ La Terrasse – Aime 2000 ☀️\r\nVotre spot gourmand et festif au pied des pistes !\r\nCuisine savoyarde , cocktails  et ambiance après-ski , juste à côté de l’école de ski  et du Télémétro ."
    ],
    "nl": [
      "Het restaurant - bar la Terrasse beschikt over grote ruimte voor eetmalen in de eetzaal of buiten, te Plagne Aime 2000."
    ],
    "es": [
      "?? La Terrasse ? Aime 2000 ?\r\nSu lugar gastronómico y festivo a pie de pistas\r\nCocina saboyana, cócteles y ambiente après-ski, al lado de la escuela de esquí y de Télémétro."
    ]
  },
