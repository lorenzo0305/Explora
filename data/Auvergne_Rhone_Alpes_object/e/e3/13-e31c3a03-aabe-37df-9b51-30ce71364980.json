  "rdfs:comment": {
    "de": [
      "Rund 40 Handwerker demonstrieren ihr Können: Töpferei, Tischlerei, Wolle, Leder, Lammfellschuhe, Sirup, Kräutertees, aber auch Buchangebote und insbesondere die des lokalen Autors: Abbé Canard."
    ],
    "en": [
      "Some forty craftspeople demonstrate their skills: pottery, cabinetmaking, wool, leather, lambskin slippers, syrups, herbal teas, as well as books, especially those by local author Abbé Canard."
    ],
    "it": [
      "Una quarantina di artigiani mostreranno le loro abilità: ceramiche, ebanisteria, lana, cuoio, pantofole di pelle d'agnello, sciroppi, tisane, ma anche libri, in particolare quelli dell'autore locale l'Abbé Canard."
    ],
    "fr": [
      "Une quarantaine d'artisans font la démonstration de leur savoir-faire  : poterie, ébénisterie, lainage, cuir, chaussons en peau d'agneau, sirops, tisanes, mais aussi proposition de livres et en particulier ceux de l'auteur local : l'Abbé Canard."
    ],
    "es": [
      "Unos cuarenta artesanos expondrán sus oficios: alfarería, ebanistería, lana, cuero, zapatillas de piel de cordero, jarabes, infusiones, así como libros, en particular los del autor local l'Abbé Canard."
    ],
    "nl": [
      "Ongeveer veertig ambachtslieden zullen hun vaardigheden demonstreren: aardewerk, meubelmakerij, wol, leer, pantoffels van lamsvel, siropen, kruidenthee, maar ook boeken, vooral die van de plaatselijke auteur l'Abbé Canard."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Artisanat du Pays d'Urfé"
    ]
  },
