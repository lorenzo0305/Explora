  "rdfs:comment": {
    "de": [
      "Das Restaurant le Dahu bietet Ihnen eine Speisekarte mit Gerichten und großzügigen Gerichten aus lokalen Produkten oder Brettern, die Sie mit anderen teilen können. Gute Bierkarte\r\n\r\nReservierungen werden empfohlen."
    ],
    "en": [
      "The restaurant le Dahu welcomes you for lunch and dinner in a green and calm setting to nibble a plate and have a drink. Menu: 2 starters/2 courses/2 desserts, aperitif and tapas boards."
    ],
    "it": [
      "Il ristorante le Dahu offre un menu con piatti generosi a base di prodotti locali, o taglieri da condividere. Buona la lista delle birre\r\n\r\nSi consiglia la prenotazione."
    ],
    "fr": [
      "Le restaurant le Dahu vous propose une carte avec des plats et généreux à base de produits locaux, ou des planches à partager. Bonne carte de bières. \r\n\r\nRéservation conseillée."
    ],
    "nl": [
      "Het restaurant le Dahu biedt een menu met royale gerechten op basis van lokale producten, of borden om te delen. Goede bierlijst\r\n\r\nReserveren wordt aanbevolen."
    ],
    "es": [
      "El restaurante le Dahu ofrece un menú con platos generosos a base de productos locales, o tablas para compartir. Buena lista de cervezas\r\n\r\nSe recomienda reservar."
    ]
  },
  "rdfs:label": {
