  "rdfs:comment": {
    "de": [
      "Gewichtheben als Wettkampfsport, Aufspüren von Nachwuchstalenten. Olympische Sportart, die zahlreiche körperliche Qualitäten (Kraft, Entspannung, Flexibilität), Krafttraining mit personalisierten Programmen und Kardiotraining erfordert."
    ],
    "en": [
      "Competitive weightlifting, detection of young hopefuls. An Olympic sport requiring a wide range of physical qualities (strength, relaxation, flexibility), strength training with personalized programs and cardio-training."
    ],
    "it": [
      "Pratica del sollevamento pesi in gara, individuazione di giovani speranze. Uno sport olimpico che richiede molte qualità fisiche (forza, rilassamento, flessibilità), allenamento con i pesi con programmi personalizzati e cardio-training."
    ],
    "fr": [
      "Pratique de l'haltérophilie en compétition, détection de jeunes espoirs. Sport olympique qui requiert de nombreuses qualités physiques (force, détente, souplesse) de la musculation d'entretien avec des programmes personnalisés et du cardio-training."
    ],
    "es": [
      "Práctica de la halterofilia en competición, detección de jóvenes promesas. Un deporte olímpico que requiere muchas cualidades físicas (fuerza, relajación, flexibilidad), entrenamiento con pesas con programas personalizados y entrenamiento cardiovascular."
    ],
    "nl": [
      "Competitief gewichtheffen, detectie van jonge talenten. Een Olympische sport die een breed scala aan fysieke kwaliteiten vereist (kracht, ontspanning, flexibiliteit), krachttraining met gepersonaliseerde programma's en cardiotraining."
    ]
  },
