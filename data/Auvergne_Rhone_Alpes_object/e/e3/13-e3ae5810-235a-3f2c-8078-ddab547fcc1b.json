  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes gelegen, etabliert sich La Cure als neuer Kulturpol, der die Entdeckung des Kulturerbes der Gemeinde durch ein Ausstellungsprogramm, eine Bergbibliothek und als Ausgangspunkt für Kulturerbe-Routen anbietet."
    ],
    "en": [
      "Located in the heart of the village, La Cure is a new cultural hub, offering visitors the chance to discover the commune's heritage through a program of exhibitions, a mountain library and as a starting point for heritage itineraries."
    ],
    "it": [
      "Situato nel cuore del villaggio, La Cure è un nuovo centro culturale che offre ai visitatori la possibilità di scoprire il patrimonio locale attraverso un programma di mostre, una biblioteca di montagna e come punto di partenza per i sentieri del patrimonio."
    ],
    "fr": [
      "Au cœur du village, La Cure est le nouveau pôle culturel ! Venez découvrir le patrimoine de la commune à travers des expositions, une bibliothèque de montagne et une riche programmation.  Chaque année, une nouvelle exposition est visible."
    ],
    "nl": [
      "La Cure, gelegen in het hart van het dorp, is een nieuw cultureel centrum dat bezoekers de kans biedt om het lokale erfgoed te ontdekken via een tentoonstellingsprogramma, een bergbibliotheek en als startpunt voor erfgoedroutes."
    ],
    "es": [
      "En el corazón del pueblo, La Cure es el nuevo centro cultural Venga a descubrir el patrimonio del pueblo a través de exposiciones, una biblioteca de montaña y un rico programa de actos.  Cada año se presenta una nueva exposición."
    ]
  },
