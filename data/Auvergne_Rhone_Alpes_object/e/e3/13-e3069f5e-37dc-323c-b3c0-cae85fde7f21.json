  "rdfs:comment": {
    "de": [
      "Romanische Vorhalle und Glockenturm,\r\nSchwarze majestätische Madonna aus dem 12\r\nPiéta aus polychromem Holz aus dem 15\r\nSchatz: Renaissance-Prozessionskreuze und lithurgische Gegenstände\r\nSchrein des Heiligen Bénilde\r\nKapellen, die mit Fresken von Lucien Gires geschmückt sind..."
    ],
    "en": [
      "Romanesque porch and bell tower,\r\n12th-century black Madonna in Majesty\r\n15th-century polychrome wood Piéta\r\nTreasure: Renaissance processional crosses and lithurgical objects\r\nSaint Bénilde shrine\r\nChapels decorated with frescoes by Lucien Gires..."
    ],
    "it": [
      "Portico e campanile romanico,\r\nVergine Nera in Maestà del XII secolo\r\nPietà lignea policroma del XV secolo\r\nTesoro: croci processionali rinascimentali e oggetti liturgici\r\nSantuario di Santa Bénilde\r\nCappelle affrescate da Lucien Gires..."
    ],
    "fr": [
      "Porche et clocher roman, \r\nVierge noir en majesté du XIIe siècle\r\nPiéta en bois polychrome du XVe siècle\r\nTrésor : croix processionnelles Renaissance et objets lithurgiques\r\nChâsse de Saint Bénilde\r\nChapelles ornées de fresques réalisées par Lucien Gires..."
    ],
    "nl": [
      "Romaans portaal en klokkentoren,\r\nZwarte Maagd in Majesteit uit de 12e eeuw\r\n15e-eeuwse polychrome houten Piëta\r\nSchatkamer: renaissance processiekruisen en lithurgische voorwerpen\r\nHeiligdom van Sint Bénilde\r\nKapellen versierd met fresco's van Lucien Gires..."
    ],
    "es": [
      "Pórtico y campanario románicos,\r\nVirgen Negra en Majestad del siglo XII\r\nPiedad de madera policromada del siglo XV\r\nTesoro: cruces procesionales renacentistas y objetos litúrgicos\r\nSantuario de Santa Benilde\r\nCapillas decoradas con frescos de Lucien Gires..."
    ]
  },
