  "rdfs:comment": {
    "de": [
      "Der Wasserfall von Groissiat ist vom Parkplatz der Mehrzweckhalle aus leicht zu erreichen. Er ist der perfekte Ort, um sich in der Mittagspause zu entspannen oder einen kleinen Ausflug mit seinem hündischen Begleiter zu unternehmen."
    ],
    "en": [
      "Easily accessible from the salle polyvalente parking lot, the Groissiat waterfall is the perfect place to relax during a lunch break, or for a short excursion with your canine companion."
    ],
    "it": [
      "Facilmente raggiungibile dal parcheggio della Salle Polyvalente, la cascata di Groissiat è il luogo ideale per rilassarsi durante la pausa pranzo o per una breve escursione con il proprio compagno a quattro zampe."
    ],
    "fr": [
      "Facilement accessible depuis le parking de la salle polyvalente, la cascade de Groissiat est l'endroit parfait pour se détendre pendant la pause déjeuner ou pour une petite excursion avec son compagnon canin."
    ],
    "es": [
      "Fácilmente accesible desde el aparcamiento de la sala polivalente, la cascada de Groissiat es el lugar perfecto para relajarse durante la pausa del almuerzo o para una breve excursión con su compañero canino."
    ],
    "nl": [
      "De waterval van Groissiat, die gemakkelijk bereikbaar is vanaf de parkeerplaats van Salle Polyvalente, is de perfecte plek om te ontspannen tijdens je lunchpauze of voor een kort uitstapje met je hond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cascade de Groissiat"
    ]
  },
