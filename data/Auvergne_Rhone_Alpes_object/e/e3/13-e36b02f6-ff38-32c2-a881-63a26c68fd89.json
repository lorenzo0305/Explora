  "rdfs:comment": {
    "de": [
      "Restaurant, Eisdiele, Pizzeria, Pub.\r\nEmpfang von Gruppen, Geburtstagen, Hochzeiten, ..... Terrasse, Spielbereich für Kinder. Musikalische Unterhaltung am Freitag- und Samstagabend. Karaoke, Musik, Spiele, Gesang, Tänze, ...."
    ],
    "en": [
      "Restaurant, ice-cream parlour, pizzeria, pub. \r\nGroup functions, birthdays, weddings, etc.\r\nTerrace area, children's play area. Musical entertainment on Friday and Saturday evenings. Karaoke, music, games, singing, dancing, etc."
    ],
    "it": [
      "Ristorante, gelateria, pizzeria, pub.\r\nRicevimenti di gruppo, compleanni, matrimoni, .... Terrazza, area giochi per bambini. Intrattenimento musicale il venerdì e il sabato sera. Karaoke, musica, giochi, canto, ballo, ...."
    ],
    "fr": [
      "Restaurant, glacier, pizzeria, pub.\r\nRéception groupes, anniversaires, mariages, .... Terrasse, espace de jeux pour les enfants. Animations musicales le vendredi et samedi soir. Karaoké, musique, jeux, chants, danses, ...."
    ],
    "es": [
      "Restaurante, heladería, pizzería, pub.\r\nRecepciones de grupos, cumpleaños, bodas, .... Terraza, zona de juegos para niños. Animación musical los viernes y sábados por la noche. Karaoke, música, juegos, canto, baile, ...."
    ],
    "nl": [
      "Restaurant, ijssalon, pizzeria, café.\r\nGroepsrecepties, verjaardagen, bruiloften, .... Terras, kinderspeelplaats. Muzikaal entertainment op vrijdag- en zaterdagavond. Karaoke, muziek, spelletjes, zingen, dansen, ...."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Taverne de Saint-Germain"
    ],
