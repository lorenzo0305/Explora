      "@id": "https://data.datatourisme.fr/4ee9a997-9750-31db-b1a7-234710b202c1",
      "dc:description": {
        "de": [
          "Von 10:00 bis 17:30 Uhr auf dem Parkplatz Saint Jean 2.\nHüpfburg und pädagogische Animationen (Quiz und Sonnenspiel).\nFür alle zugängliche Animationen."
        ],
        "en": [
          "From 10am to 5:30pm in the Saint Jean 2 parking lot.\nBouncy castle and educational activities (quiz and sun game).\nActivities open to all."
        ],
        "it": [
          "Dalle 10.00 alle 17.30 nel parcheggio Saint Jean 2.\nCastello gonfiabile e attività didattiche (quiz e gioco del sole).\nAttività aperte a tutti."
        ],
        "fr": [
          "De 10h à 17h30 sur le parking Saint Jean 2.\nChâteau gonflable et animations pédagogiques (quizz et jeu du soleil).\nAnimations accessibles pour tous."
        ],
        "nl": [
          "Van 10u tot 17u30 op de parking Saint Jean 2.\nSpringkasteel en educatieve activiteiten (quiz en zonnespel).\nActiviteiten toegankelijk voor iedereen."
        ],
        "es": [
          "De 10.00 a 17.30 h en el aparcamiento Saint Jean 2.\nCastillo hinchable y actividades educativas (concurso y juego del sol).\nActividades abiertas a todos."
        ]
      },
