  "rdfs:comment": {
    "de": [
      "Kleiner Betrieb mit Milchkühen und Mutterkühen (Kreuzung Limousine X Charolais) im Herzen des Valromey. Verkauf von Fleischkisten mit Kalb-, Färsen- oder Ochsenfleisch.\r\nKalbswürstchen natur oder mit Kräutern"
    ],
    "en": [
      "Small dairy and suckler cow farm (Limousin X Charolais cross) in the heart of the Valromey region. Sale of boxes of veal, heifer or beef.\r\nVeal sausages, plain or with herbs"
    ],
    "it": [
      "Piccolo allevamento di vacche da latte e da latte (incrocio Limousin X Charolais) nel cuore della Valromey. Vendita di box di vitello, vitella o manzo.\r\nSalsicce di vitello, semplici o con erbe aromatiche"
    ],
    "fr": [
      "Petite exploitation de vaches laitières et vaches allaitantes (croisement limousine X charolais) au cœur du Valromey. Vente de caissettes de viande de veau, de génisse ou de bœuf.\r\nSaucisses de veau nature ou aux herbes"
    ],
    "es": [
      "Pequeña explotación de vacas lecheras y nodrizas (cruce Limousin X Charolais) en el corazón del Valromey. Venta de cajas de ternera, novilla o buey.\r\nSalchichas de ternera, al natural o con hierbas"
    ],
    "nl": [
      "Klein melkvee- en zoogkoeienbedrijf (Limousin X Charolais kruising) in het hart van de Valromey. Verkoop van dozen kalfsvlees, vaarzen of rundvlees.\r\nKalfsvleesworstjes, naturel of met kruiden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC VALVERT - Viande bovine"
    ]
  },
