  "rdfs:comment": {
    "de": [
      "Hinweis an alle Neugierigen. Kleine und große übrigens. In Saint-Galmier findet man überall architektonische Nuggets. Da trifft es sich gut, dass wir eine Schnitzeljagd für Kinder ab 4 Jahren anbieten."
    ],
    "en": [
      "Notice to all the curious. Young and old alike. In Saint-Galmier, you'll find architectural nuggets just about everywhere. Just the thing, we're offering a treasure hunt for children aged 4 and over."
    ],
    "it": [
      "Ai curiosi. Giovani e meno giovani. A Saint-Galmier si trovano pepite architettoniche un po' ovunque. Proprio per questo, proponiamo una caccia al tesoro per i bambini dai 4 anni in su."
    ],
    "fr": [
      "Avis à tous les curieux. Petits et grands d’ailleurs. Du côté de Saint-Galmier on trouve des pépites architecturales un peu partout. Ça tombe bien, on propose un jeu de piste jeune public dès 4 ans."
    ],
    "es": [
      "Por los curiosos. Para grandes y pequeños. En Saint-Galmier, encontrará pepitas de oro arquitectónicas por todas partes. Le proponemos una búsqueda del tesoro para niños a partir de 4 años."
    ],
    "nl": [
      "Op de nieuwsgierigen. Jong en oud. In Saint-Galmier vind je bijna overal architectonische goudklompjes. Voor kinderen vanaf 4 jaar bieden we een schattenjacht aan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste Graine d'Explorateur - Saint-Galmier"
    ]
  },
