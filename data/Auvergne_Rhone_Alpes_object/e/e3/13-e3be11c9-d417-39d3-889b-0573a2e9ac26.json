  "rdfs:comment": {
    "de": [
      "Le Poët-Laval, klassifiziert als \"Eines der schönsten Dörfer Frankreichs\" mit seinem Kulturerbe, und seinen Sehenswürdigkeiten: Schloss, Kapelle Saint-Jean-des-Commandeurs, Commanderie, Straßen und Gassen, Kunstzentrum Yvon Morin, Museum des Protestantismus Dauphinois, ..."
    ],
    "en": [
      "Le Poët-Laval : Listed as \"one of the most beautiful villages of France \" with its castle, the chapel of St Jean-des-Commandeurs, the Commandery, streets and alleys, the Callée, Centers Yvon Morin, Museum of the Dauphiné Protestantism, ..."
    ],
    "it": [
      "Le Poët-Laval, classificato come \"Uno dei più bei villaggi di Francia\", con il suo patrimonio e i suoi luoghi da visitare: il castello, la cappella Saint-Jean-des-Commandeurs, la Commanderie, le strade e i vicoli, il Centro d'arte Yvon Morin, il Museo del protestantesimo del Delfinato, ecc."
    ],
    "fr": [
      "Le Poët-Laval, classé \"Un des plus beaux villages de France\" avec son patrimoine, et ses lieux de visites : château, chapelle Saint-Jean-des-Commandeurs, Commanderie, rues et ruelles, Centre d'Art Yvon Morin,  Musée du Protestantisme Dauphinois, ..."
    ],
    "es": [
      "Le Poët-Laval, clasificado como \"Uno de los pueblos más bellos de Francia\" con su patrimonio y lugares para visitar: castillo, capilla de Saint-Jean-des-Commandeurs, Commanderie, calles y callejones, Centro de Arte Yvon Morin, Museo del Protestantismo del Delfín, etc."
    ],
    "nl": [
      "Le Poët-Laval : geklasseerd als \"un des plus beaux villages de France\" (een van de mooiste dorpen van Frankrijk), dankzij het kasteel, de St Jean-des-Commandeurs kapel, de Commanderie, straatjes en steegjes, de callée, het Yvon Morin centrum, het Musée du Protestantisme Dauphinois, ..."
    ]
  },
