  "rdfs:comment": {
    "de": [
      "Lassen Sie sich in die Steinbildhauerei einführen! Erstellen Sie Ihr dekoratives Objekt (Briefbeschwerer, Feder...) aus weichem Stein. Stein und Werkzeug werden bereitgestellt."
    ],
    "en": [
      "Come and try your hand at stone carving! Create your own decorative object (paperweight, feather...) in soft stone. Stone and tools supplied."
    ],
    "it": [
      "Venite a cimentarvi nell'intaglio della pietra! Create il vostro oggetto decorativo (fermacarte, piuma...) in pietra morbida. Pietra e strumenti forniti."
    ],
    "fr": [
      "Venez vous initier à la sculpture sur pierre ! Créez votre objet décoratif (presse-papier, plume...) en pierre tendre. Pierre et outillage fournis."
    ],
    "es": [
      "Pruebe a tallar la piedra Crea tu propio objeto decorativo (pisapapeles, pluma...) en piedra blanda. Piedra y herramientas incluidas."
    ],
    "nl": [
      "Kom zelf steenhouwen! Maak je eigen decoratieve object (presse-papier, veer...) in zachte steen. Steen en gereedschap aanwezig."
    ]
  },
