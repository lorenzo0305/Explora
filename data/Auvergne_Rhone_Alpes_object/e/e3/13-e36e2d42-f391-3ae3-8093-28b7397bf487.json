  "rdfs:comment": {
    "de": [
      "3 permanente Orientierungsläufe, die vom Weiler La Ragiaz aus starten.\r\n3 Niveaus: 1 grün, 1 blau, 1 rot\r\nKarten können beim Boost Center. und im Büro Hauteville des Fremdenverkehrsamts erworben werden."
    ],
    "en": [
      "3 permanent orienteering courses starting from the Hameau de la Ragiaz.\r\n3 levels: 1 green, 1 blue, 1 red\r\nMaps on sale at the Boost Center and at the Hauteville tourist office."
    ],
    "it": [
      "3 percorsi permanenti di orienteering con partenza dall'Hameau de la Ragiaz.\r\n3 livelli: 1 verde, 1 blu, 1 rosso\r\nMappe in vendita presso il Centro Boost e l'Ufficio del Turismo di Hauteville."
    ],
    "fr": [
      "3 parcours permanents d'orientation au départ du Hameau de la Ragiaz.\r\n3 niveaux : 1 vert, 1 bleu, 1 rouge\r\nCartes en vente auprès du centre de séjour Boost Center. et au bureau d'Hauteville de l'office de tourisme."
    ],
    "es": [
      "3 recorridos permanentes de orientación que parten del Hameau de la Ragiaz.\r\n3 niveles: 1 verde, 1 azul, 1 rojo\r\nMapas a la venta en el Boost Center y en la Oficina de Turismo de Hauteville."
    ],
    "nl": [
      "3 permanente oriëntatieparcoursen vanaf de Hameau de la Ragiaz.\r\n3 niveaus: 1 groen, 1 blauw, 1 rood\r\nKaarten te koop bij het Boost Center en bij het Office du Tourisme van Hauteville."
    ]
  },
  "rdfs:label": {
