  "rdfs:comment": {
    "de": [
      "Restaurant Pizzeria in Montagnat, Le Loft bar à pizza liegt 10 Minuten von Bourg-en-Bresse entfernt im Departement Ain. Eine hausgemachte Küche, die Sie an einem warmen und gemütlichen Ort genießen können.\r\n\r\n"
    ],
    "en": [
      "Restaurant pizzeria in Montagnat, Le Loft bar à pizza is located 10 minutes from Bourg-en-Bresse, in the Ain region. Enjoy homemade cuisine in a warm and friendly atmosphere."
    ],
    "it": [
      "Ristorante pizzeria a Montagnat, il bar pizzeria Le Loft si trova a 10 minuti da Bourg-en-Bresse, nell'Ain. Una cucina casalinga che potrete gustare in un luogo caldo e accogliente.\r\n\r\n?"
    ],
    "fr": [
      "Restaurant pizzeria à Montagnat, Le Loft bar à pizza est situé à 10 minutes de Bourg-en-Bresse, dans l'Ain. Une cuisine fait-maison que vous pourrez savourer dans un lieu chaleureux et convivial.\r\n\r\n​"
    ],
    "es": [
      "Restaurante pizzería en Montagnat, Le Loft pizza bar se encuentra a 10 minutos de Bourg-en-Bresse, en el Ain. Una cocina casera que podrá disfrutar en un lugar cálido y acogedor.\r\n\r\n?"
    ],
    "nl": [
      "Restaurant pizzeria in Montagnat, Le Loft pizza bar is gelegen op 10 minuten van Bourg-en-Bresse, in de Ain. Een huisgemaakte keuken waarvan u kunt genieten in een warme en vriendelijke omgeving.\r\n\r\n"
    ]
  },
