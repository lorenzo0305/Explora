  "rdfs:comment": {
    "de": [
      "Die städtische Mediathek von Aouste-sur-Sye umfasst 8000 Werke (Bücher, CDs). Die Mediathek ist durch ihre Veranstaltungen (Konzerte, Theater, Vorträge, Märchen...) und Ausstellungen auch ein kultureller Treffpunkt."
    ],
    "en": [
      "The Aouste-sur-Sye municipal media library houses 8,000 books and CDs. The library is also a venue for cultural events (concerts, theater, lectures, storytelling...) and exhibitions."
    ],
    "it": [
      "La mediateca comunale di Aouste-sur-Sye dispone di 8.000 libri e CD. La biblioteca è anche sede di eventi culturali (concerti, teatro, conferenze, narrazioni, ecc.) e mostre."
    ],
    "fr": [
      "La médiathèque municipale d'Aouste-sur-Sye rassemble 8 000 ouvrages (livres, CD). La médiathèque est aussi un lieu de rendez-vous culturel de par ses animations (concerts, théâtre, conférences, contes...) et expositions."
    ],
    "es": [
      "La mediateca municipal de Aouste-sur-Sye cuenta con 8.000 libros y CD. La biblioteca también acoge actos culturales (conciertos, teatro, conferencias, cuentacuentos, etc.) y exposiciones."
    ],
    "nl": [
      "De mediatheek van de gemeente Aouste-sur-Sye heeft 8000 boeken en cd's. De bibliotheek is ook een plek voor culturele evenementen (concerten, theater, lezingen, verhalen vertellen, enz.) en tentoonstellingen."
    ]
  },
  "rdfs:label": {
