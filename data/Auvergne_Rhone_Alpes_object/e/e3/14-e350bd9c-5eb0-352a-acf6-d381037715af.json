  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/27996fac-7406-398c-93f5-623fddbc88e0",
      "dc:description": {
        "de": [
          "Die Firma JC.David befindet sich im Hafengebiet von Capécure und stützt ihre gesamte Produktion seit 1922 auf das althergebrachte, völlig handwerkliche und natürliche Verfahren."
        ],
        "en": [
          "Located in the port area of Capécure, JC.David establishments have been basing all their production on the ancestral, totally artisanal and natural process since 1922."
        ],
        "it": [
          "Situati nella zona portuale di Capécure, gli stabilimenti JC.David basano tutta la loro produzione su un processo ancestrale, completamente tradizionale e naturale dal 1922."
        ],
        "fr": [
          "Situé dans la zone portuaire de Capécure, les établissements JC.David basent toute leur production sur le procédé ancestral, tout à fait artisanal et naturel depuis 1922."
        ],
        "es": [
          "Situados en la zona portuaria de Capécure, los establecimientos JC.David basan toda su producción en el proceso ancestral, totalmente tradicional y natural desde 1922."
        ],
        "nl": [
          "De etablissementen van JC.David, gelegen in het havengebied van Capécure, baseren al sinds 1922 al hun productie op het voorouderlijke, volledig traditionele en natuurlijke proces."
        ]
      },
