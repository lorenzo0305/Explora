  "rdfs:comment": {
    "de": [
      "Mieten Sie ein Fahrrad in aller Freiheit!\r\nFür einen Tag, eine Woche oder ein Jahr, wählen Sie die am besten geeignete Formel.\r\nErfordert die mobile Anwendung PBSC oder eine Anmeldung bei Citéa."
    ],
    "en": [
      "Rent a bike with complete freedom!\r\nBy the day, week or year, choose the formula that suits you best.\r\nRequires the PBSC mobile application or registration with Citéa."
    ],
    "it": [
      "Noleggiate una bicicletta in piena libertà!\r\nAl giorno, alla settimana o all'anno, scegliete la formula più adatta a voi.\r\nRichiede l'applicazione mobile PBSC o la registrazione a Citéa."
    ],
    "fr": [
      "Louez un vélo en toute liberté !\r\nÀ la journée, à la semaine ou à l’année, choisissez la formule la plus adaptée.\r\nNécessite l'application mobile PBSC ou une inscription auprès de Citéa."
    ],
    "es": [
      "¡Alquile una moto con total libertad!\r\nPor día, por semana o por año, elige la fórmula que más te convenga.\r\nRequiere la aplicación móvil PBSC o el registro en Citéa."
    ],
    "nl": [
      "Huur een fiets in alle vrijheid!\r\nPer dag, per week of per jaar, kies de formule die het best bij je past.\r\nVereist de PBSC mobiele applicatie of registratie bij Citéa."
    ]
  },
  "rdfs:label": {
