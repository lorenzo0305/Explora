  "rdfs:comment": {
    "de": [
      "Die Kirche von Aveize, deren schlanker Glockenturm den Himmel erobert und die Wolken zu durchbrechen scheint, ist ein schönes und elegantes Bauwerk, das wie ein Leuchtturm im Zentrum der Monts du Lyonnais steht!"
    ],
    "en": [
      "The church at Aveize, with its slender steeple reaching for the sky and seemingly piercing the clouds, is a beautiful, elegant monument, like a lighthouse in the center of the Monts du Lyonnais!"
    ],
    "it": [
      "La chiesa di Aveize, il cui slanciato campanile svetta nel cielo e sembra trapassare le nuvole, è un monumento bello ed elegante, come un faro al centro dei Monts du Lyonnais!"
    ],
    "fr": [
      "L’église d’Aveize, dont le clocher élancé part à la conquête du ciel, semblant transpercer les nuages, est un beau monument élégant, tel un phare au centre des Monts du Lyonnais !"
    ],
    "es": [
      "La iglesia de Aveize, cuyo esbelto campanario se eleva hacia el cielo y parece atravesar las nubes, es un monumento bello y elegante, como un faro en el centro de los Montes del Lyón"
    ],
    "nl": [
      "De kerk van Aveize, waarvan de slanke toren de hemel in steekt en door de wolken lijkt te steken, is een prachtig, elegant monument, als een vuurtoren in het midden van de Monts du Lyonnais!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Pierre"
    ]
  },
