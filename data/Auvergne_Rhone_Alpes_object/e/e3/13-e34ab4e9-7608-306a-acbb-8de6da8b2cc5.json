  "rdfs:comment": {
    "de": [
      "Ein Restaurant, eine Bar und ein \"Chalet-Snack\". Im Herzen der Pisten, traditionelle und familiäre Küche, die hauptsächlich auf frischen und lokalen Produkten basiert. Weine von Erzeugern. Hausgemachte Herstellung der servierten Gerichte und Desserts."
    ],
    "en": [
      "A restaurant, bar, \"snack chalet bar\". In the heart of the slopes, traditional and family cuisine based essentially on fresh and local products. Wines from producers. Homemade dishes and desserts for most of the meals served."
    ],
    "it": [
      "Ristorante, bar, \"chalet snack\". Nel cuore delle piste, una cucina tradizionale e casereccia, essenzialmente a base di prodotti freschi e locali. Vini dei produttori. Realizzazione casereccia della maggior parte dei piatti e dei dessert serviti."
    ],
    "fr": [
      "Un restaurant, un bar, un « chalet snack ». Au cœur des pistes, cuisine traditionnelle et familiale, basée essentiellement sur des produits frais et locaux. Vins de producteurs. Fabrication maison des plats et des desserts servis."
    ],
    "es": [
      "Un restaurante, un bar, un \"chalet snack\". En el corazón de las pistas, cocina tradicional y familiar, basada esencialmente en productos frescos y locales. Vinos de productores. Se sirven platos y postres caseros."
    ],
    "nl": [
      "Een restaurant, een bar, een \"chalet snack\". In het hart van de pistes, traditionele en familiale keuken, hoofdzakelijk gebaseerd op verse en lokale producten. Wijnen van producenten. Huisgemaakte gerechten en desserts worden geserveerd."
    ]
  },
