  "rdfs:comment": {
    "de": [
      "Angenehmes Haus mit zwei charakteristischen Räumen und einer hübschen, im Grünen eingebetteten Sommerterrasse. Genießen Sie die hausgemachte Küche der Saison."
    ],
    "ru": [
      "Приятный дом с двумя комнатами с характером и красивой летней террасой, окруженной зеленью. Наслаждайтесь домашней сезонной кухней."
    ],
    "en": [
      "The Hostellerie des Dombes is located in a charming Dombiste residence in the village of Bouligneux about 40 minutes from Lyon.  The restaurant has 2 dining rooms and a lovely terrace and specialises in frog’s legs and succulent free range chicken."
    ],
    "it": [
      "Casa piacevole con due camere di carattere e una graziosa terrazza estiva circondata dal verde. Godetevi la cucina casalinga di stagione."
    ],
    "fr": [
      "Agréable maison avec deux salles de caractère et une jolie terrasse d'été noyée dans la verdure. Dégustez une cuisine de saison fait maison."
    ],
    "zh": [
      "舒适的房屋有两间各具特色的房间和一个绿树环绕的漂亮夏日露台。您可在此享用家常时令菜肴。"
    ],
    "es": [
      "Agradable casa con dos habitaciones de carácter y una bonita terraza de verano rodeada de vegetación. Disfrute de la cocina casera de temporada."
    ],
    "nl": [
      "Aangenaam huis met twee karaktervolle kamers en een mooi zomerterras omgeven door groen. Geniet van huisgemaakte seizoensgerechten."
    ]
  },
