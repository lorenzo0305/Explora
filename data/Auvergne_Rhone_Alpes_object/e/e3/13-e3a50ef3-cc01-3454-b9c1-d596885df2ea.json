  "rdfs:comment": {
    "de": [
      "Das Restaurant La Grange empfängt Sie im Herzen des Dorfes Le Sappey.\r\nGenießen Sie eine Mahlzeit, die aus Produkten des kurzen Lebensweges, Fleisch und Milchprodukten aus Le Sappey hergestellt wird."
    ],
    "en": [
      "La Grange restaurant welcomes you to the heart of the village of Le Sappey.\r\nCome and enjoy a meal made with local produce, meat and dairy products from Le Sappey."
    ],
    "it": [
      "Il ristorante La Grange vi accoglie nel cuore del villaggio di Le Sappey.\r\nVenite a gustare un pasto a base di prodotti locali, carne e latticini di Le Sappey."
    ],
    "fr": [
      "Le restaurant La Grange vous accueille au cœur du village du Sappey.\r\nVenez déguster un repas fait à partir de produits en circuit court, de viande et produits laitiers du Sappey."
    ],
    "nl": [
      "Restaurant La Grange heet u welkom in het hart van het dorp Le Sappey.\r\nKom genieten van een maaltijd op basis van streekproducten, vlees en zuivelproducten uit Le Sappey."
    ],
    "es": [
      "El restaurante La Grange le da la bienvenida al corazón del pueblo de Le Sappey.\r\nVenga y disfrute de una comida elaborada con productos locales, carne y productos lácteos de Le Sappey."
    ]
  },
