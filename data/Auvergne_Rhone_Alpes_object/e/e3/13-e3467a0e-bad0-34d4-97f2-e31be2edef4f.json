  "rdfs:comment": {
    "de": [
      "Es ist das Ende der Weinlese in Chonas l'Amballan. Die Einwohner haben sich versammelt, um die Früchte ihrer Ernte zu feiern, aber Öpinell, ein kleiner, sehr geschickter Gnolu, hat beschlossen, an der Feier teilzunehmen?"
    ],
    "en": [
      "It's the end of the grape harvest in Chonas l'Amballan. The locals have gathered to celebrate the fruit of their harvest, but Öpinell, a clever little Gnolu, has decided to join in the fun?"
    ],
    "it": [
      "È la fine della vendemmia a Chonas l'Amballan. Gli abitanti si sono riuniti per festeggiare il frutto del loro raccolto, ma Öpinell, un piccolo Gnolu intelligente, ha deciso di unirsi al divertimento?"
    ],
    "fr": [
      "C'est la fin des vendanges à Chonas l’Amballan. Les habitants se sont réunis pour célébrer le fruit de leur récolte, mais Öpinell, un petit Gnolu très habile, a décidé de participer à la fête…"
    ],
    "nl": [
      "Het is het einde van de druivenoogst in Chonas l'Amballan. De inwoners zijn bijeengekomen om de vruchten van hun oogst te vieren, maar Öpinell, een slimme kleine Gnolu, heeft besloten om mee te doen aan de pret?"
    ],
    "es": [
      "Es el final de la vendimia en Chonas l'Amballan. Los habitantes se han reunido para celebrar el fruto de su cosecha, pero Öpinell, un pequeño e inteligente Gnolu, ha decidido unirse a la diversión.."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - L’art et la pranière"
    ]
  },
