  "rdfs:comment": {
    "de": [
      "Mit garantiertem Naturschnee dank des Gletschers auf 3600 m Höhe besitzt der Skiort Les 2 Alpes einen der höchsten Gipfel, die im Winter und im Sommer befahren werden können!"
    ],
    "en": [
      "This vibrant, sporty and fashionable international ski resort is among the biggest and most famous in the world in winter and in summer !"
    ],
    "it": [
      "Con neve naturale garantita grazie al ghiacciaio situato a 3600 m di altitudine, la stazione sciistica di Les 2 Alpes è una delle più alte cime sciabili d'inverno e d'estate!"
    ],
    "fr": [
      "Avec une neige naturelle garantie grâce au glacier situé à 3600m d'altitude, la station des 2 Alpes possède l'un des plus hauts sommets skiables en hiver et en été !"
    ],
    "nl": [
      "Het vakantieoord Les 2 Alpes is zowel 's zomers als 's winters 1 van de hoogste skidomeinen dankzij zijn gegarandeerd natuurlijke sneeuw op de gletsjer op 3600m hoogte !"
    ],
    "es": [
      "Con la nieve natural garantizada gracias al glaciar situado a 3.600 m, la estación de Les 2 Alpes cuenta con una de las cimas esquiables más altas en invierno y en verano"
    ]
  },
