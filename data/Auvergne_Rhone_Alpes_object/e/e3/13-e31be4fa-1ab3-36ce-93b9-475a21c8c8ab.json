  "rdfs:comment": {
    "de": [
      "Traditionelles Familienrestaurant mit schlichtem Rahmen im Haut-Forez, 3 km vom Charakter- und Künstlerdorf Marols entfernt.Der Chefkoch liebt die Improvisation und schlägt vor, Ihre Menüs nach Maß zu kreieren, um Sie zufrieden zu stellen:Mahlzeiten für Gruppen,Wanderer, nach Themen,..."
    ],
    "en": [
      "Traditional family restaurant in a refined setting in Haut-Forez, 3km from the village of character of Marols with its artists. \r\nThe chef likes improvisation and offers to create your own menus to satisfy you: Group meals, walkers, theme meals,..."
    ],
    "it": [
      "Ristorante tradizionale a conduzione familiare in un ambiente raffinato nell'Haut-Forez, a 3 km dal villaggio di Marols, un paese pieno di carattere e di artisti.  \r\nLo chef ama improvvisare e si offre di creare menu su misura per le vostre esigenze: pasti di gruppo, per escursionisti, a tema, ecc."
    ],
    "fr": [
      "Restaurant familial traditionnel au cadre épuré dans le Haut-Forez à 3km du village de caractère et d'artistes de Marols.  \r\nLe chef aime l'improvisation et propose de créer vos menus sur mesure pour vous satisfaire : Repas groupes, marcheurs, à thèmes,..."
    ],
    "nl": [
      "Traditioneel familierestaurant in een verfijnde omgeving in de Haut-Forez, op 3 km van het dorp Marols, een dorp vol karakter en kunstenaars.  \r\nDe chef houdt van improviseren en biedt aan om menu's op maat te maken: groepsmaaltijden, wandelaars, themamaaltijden, enz."
    ],
    "es": [
      "Restaurante familiar tradicional en un entorno refinado en el Haut-Forez, a 3 km del pueblo de Marols, un pueblo lleno de carácter y artistas.  \r\nAl chef le gusta improvisar y se ofrece a crear menús a medida para adaptarse a sus necesidades: comidas de grupo, caminantes, comidas temáticas, etc."
    ]
  },
