    "de": [
      "Die Tierarztpraxis nutzt keinen Online-Service zur Terminvereinbarung.\r\nFür weitere Informationen bitten wir Sie, sich telefonisch mit der Einrichtung in Verbindung zu setzen."
    ],
    "en": [
      "The veterinary practice does not use an online appointment service.\r\nFor further information, please contact us by telephone."
    ],
    "it": [
