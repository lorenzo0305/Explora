  "rdfs:comment": {
    "de": [
      "Das MJC Pop Corn in Bourg-en-Bresse ist ein Verein nach dem Gesetz von 1901. Es bietet wöchentlich künstlerische, kreative und sportliche Aktivitäten sowie ein vielfältiges und eklektisches Kulturprogramm!"
    ],
    "en": [
      "The MJC Pop Corn of Bourg-en-Bresse is an association under the law of 1901 which offers weekly artistic, creative and sports activities, as well as a varied and eclectic cultural program!"
    ],
    "it": [
      "L'MJC Pop Corn di Bourg-en-Bresse è un'associazione di diritto del 1901 che propone attività artistiche, creative e sportive settimanali, oltre a un programma culturale vario ed eclettico!"
    ],
    "fr": [
      "La MJC Pop Corn de Bourg-en-Bresse est une association de loi 1901 qui propose des activités artistiques, créatives, sportives hebdomadaires, ainsi qu'un programme culturel varié et éclectique !"
    ],
    "nl": [
      "Het MJC Pop Corn in Bourg-en-Bresse is een vereniging onder de wet van 1901 die wekelijks artistieke, creatieve en sportieve activiteiten aanbiedt, evenals een gevarieerd en eclectisch cultureel programma!"
    ],
    "es": [
      "El MJC Pop Corn de Bourg-en-Bresse es una asociación regida por la ley de 1901 que ofrece semanalmente actividades artísticas, creativas y deportivas, así como un programa cultural variado y ecléctico"
    ]
  },
