  "rdfs:comment": {
    "de": [
      "Das Hotel Alpen Ruitor bietet einen privilegierten Zugang zum größten Skigebiet der Welt und ist der perfekte Ort für einen Wintersporturlaub. Nach einem Tag auf der Piste können Sie die warme Atmosphäre unseres Hauses genießen"
    ],
    "en": [
      "Offering privileged access to the largest ski area of the world, the Alpen Ruitor hotel is the ideal place for a winter sports holiday. After a day on the slopes, come and enjoy the warm atmosphere of our Home!"
    ],
    "it": [
      "Con un accesso privilegiato alla più grande area sciistica del mondo, l'Alpen Ruitor Hotel è il luogo perfetto per una vacanza all'insegna degli sport invernali. Dopo una giornata sulle piste, venite a godervi la calda atmosfera della nostra casa!"
    ],
    "fr": [
      "Offrant un accès privilégié au plus grand domaine skiable du monde, l’hôtel Alpen Ruitor est le lieu rêvé pour un séjour aux sports d’hiver. Après une journée sur les pistes, venez profiter de l'ambiance chaleureuse de notre Maison!"
    ],
    "nl": [
      "Met bevoorrechte toegang tot het grootste skigebied ter wereld is Hotel Alpen Ruitor de perfecte plek voor een wintersportvakantie. Kom na een dag op de piste genieten van de warme sfeer van ons huis!"
    ],
    "es": [
      "Con acceso privilegiado al mayor dominio esquiable del mundo, el hotel Alpen Ruitor es el lugar perfecto para unas vacaciones de deportes de invierno. Después de un día en las pistas, ven a disfrutar del cálido ambiente de nuestra casa"
    ]
  },
