  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Lac d'Aiguebelette empfängt Sie im Maison du Lac, direkt am Wasser und in einem modernen und freundlichen Raum!"
    ],
    "en": [
      "The Lac d'Aiguebelette Tourist Information Office can be found right in the middle of the Maison du Lac, in a spanking space that is attractive and modern and offers a friendly welcome!"
    ],
    "it": [
      "L'Ufficio del Turismo del Lac d'Aiguebelette vi dà il benvenuto alla Maison du Lac, in riva al mare in un ambiente moderno e accogliente!"
    ],
    "fr": [
      "L'Office de Tourisme Lac d'Aiguebelette vous accueille au sein de la Maison du Lac, au bord de l'eau et dans un espace moderne et convivial !"
    ],
    "es": [
      "La Oficina de Turismo del Lac d'Aiguebelette le da la bienvenida a la Maison du Lac, a orillas del agua en un entorno moderno y acogedor"
    ],
    "nl": [
      "Het Office du Tourisme du Lac d'Aiguebelette heet u welkom in het Maison du Lac, aan het water in een moderne en gezellige omgeving!"
    ]
  },
