  "rdfs:comment": {
    "de": [
      "Die Einschulung von Kindern aus benachteiligten Verhältnissen, den Bau von Schulen, das Lernen und die persönliche Entwicklung fördern und LADAKH sowie seine Kultur bekannt machen."
    ],
    "en": [
      "Promoting schooling for children from disadvantaged backgrounds, building schools, learning, personal development and raising awareness of LADAKH and its culture."
    ],
    "it": [
      "Promuovere l'istruzione dei bambini provenienti da ambienti svantaggiati, la costruzione di scuole, l'apprendimento, lo sviluppo personale e far conoscere il LADAKH e la sua cultura."
    ],
    "fr": [
      "Promouvoir la scolarisation des enfants issus de milieux défavorisés, la construction d’écoles,  l’apprentissage,  l’épanouissement personnel et faire connaître le LADAKH, ainsi que sa culture."
    ],
    "es": [
      "Promover la educación de los niños de entornos desfavorecidos, la construcción de escuelas, el aprendizaje, el desarrollo personal y dar a conocer la LADAKH y su cultura."
    ],
    "nl": [
      "Het bevorderen van onderwijs voor kinderen uit kansarme milieus, het bouwen van scholen, leren, persoonlijke ontwikkeling en het vergroten van het bewustzijn van LADAKH en haar cultuur."
    ]
  },
  "rdfs:label": {
