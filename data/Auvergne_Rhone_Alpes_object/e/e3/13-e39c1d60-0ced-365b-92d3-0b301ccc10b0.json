  "rdfs:comment": {
    "de": [
      "Dekorations- und Einrichtungsmarke, die mehrere Welten / ein breites Möbelsortiment mit 2 Katalogen für Outdoor und Indoor sowie einen neuen Service Rhinov Online-Innenarchitekt mit 3D-Planvorschlag anbietet."
    ],
    "en": [
      "Decoration and furnishing sign proposing several universes / a wide range of furniture with 2 outdoor and indoor catalogues as well as a new service Rhinov interior decorator online with 3D plan proposal."
    ],
    "it": [
      "Un marchio di decorazione e arredamento che offre diversi universi / un'ampia gamma di mobili con 2 cataloghi per esterni e interni e un nuovo servizio, Rhinov, un decoratore di interni online con una proposta di progetto in 3D."
    ],
    "fr": [
      "Enseigne de décoration et d'ameublement proposant plusieurs univers / une large gamme de meuble avec 2 catalogues outdoor et indoor ainsi qu'un nouveau service Rhinov décorateur d'intérieur en ligne avec proposition de plan 3D."
    ],
    "es": [
      "Una marca de decoración y mobiliario que ofrece varios universos / una amplia gama de muebles con 2 catálogos de exterior e interior, así como un nuevo servicio, Rhinov, un decorador de interiores en línea con una propuesta de planos en 3D."
    ],
    "nl": [
      "Een decoratie- en inrichtingsmerk dat verschillende universums / een breed assortiment meubels aanbiedt met 2 buiten- en binnencatalogi, evenals een nieuwe dienst, Rhinov, een online binnenhuisarchitect met een 3D-planvoorstel."
    ]
  },
