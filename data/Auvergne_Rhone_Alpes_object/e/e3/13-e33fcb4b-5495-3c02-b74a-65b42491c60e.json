  "rdfs:comment": {
    "de": [
      "Das Priorat hat seine Tore für Kunstliebhaber geöffnet und lädt Sie ein zu einer Reise durch tausend Jahre Architekturgeschichte."
    ],
    "en": [
      "Possibility of themed, night and dramatised tours. An open door on the arts, the priory at Pommiers invites you on a journey across a thousand years of architecture."
    ],
    "it": [
      "Questo priorato cluniacense invita a un viaggio culturale attraverso i secoli: primitivo priorato, chiostro, refettorio, celle, saloni e travi di quercia del XV e XVIII secolo. Le travi del tetto sono accessibili solo con visita guidata, su prenotazione."
    ],
    "fr": [
      "Ce prieuré clunisien invite à un voyage culturel à travers les siècles : prieuré primitif, cloître, réfectoire, cellules, salons et charpentes en chêne des XVe et XVIIIe siècles. Charpentes accessibles uniquement en visite guidée, sur réservation."
    ],
    "es": [
      "Este priorato cluniacense le invita a un viaje cultural a través de los siglos: priorato primitivo, claustro, refectorio, celdas, salones y armazones de roble de los siglos XV y XVIII. Las vigas del tejado sólo son accesibles en visita guiada, previa concertación."
    ],
    "nl": [
      "Deze Cluniacus priorij nodigt je uit voor een culturele reis door de eeuwen heen: primitieve priorij, klooster, refter, cellen, salons en eiken raamwerken uit de 15e en 18e eeuw. De dakconstructies zijn alleen toegankelijk met een rondleiding, op afspraak."
    ]
  },
