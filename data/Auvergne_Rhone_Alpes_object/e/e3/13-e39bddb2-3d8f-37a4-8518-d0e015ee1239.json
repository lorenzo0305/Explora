  "rdfs:comment": {
    "de": [
      "Brauchen Sie ein einzigartiges und originelles Geschenk? Das Atelier La Poterie de M'Art'ine hat für Sie einen Ladenbereich reserviert, in dem Sie meine Stücke entdecken können. Es besteht die Möglichkeit, einen Kurs zu belegen, um die Kunst des Töpferns zu entdecken."
    ],
    "en": [
      "Need a unique and original gift? La Poterie de M'Art'ine has reserved a boutique where you can discover my pieces. Possibility of workshops to discover the art of pottery."
    ],
    "it": [
      "Cercate un regalo unico e originale? La Poterie de M'Art'ine ha riservato un negozio dove potrete venire a scoprire i miei pezzi. È anche possibile seguire un corso per scoprire l'arte della ceramica."
    ],
    "fr": [
      "Besoin d'un cadeau unique et original ? L'atelier La Poterie de M'Art'ine vous a réservé un espace boutique où vous pourrez venir découvrir mes pièces. Possibilité de stage pour découvrir l'art de la poterie."
    ],
    "es": [
      "¿Busca un regalo único y original? La Poterie de M'Art'ine ha reservado una tienda donde podrá venir a descubrir mis piezas. También puede hacer un curso para descubrir el arte de la alfarería."
    ],
    "nl": [
      "Op zoek naar een uniek en origineel cadeau? La Poterie de M'Art'ine heeft een winkel gereserveerd waar je mijn stukken kunt komen ontdekken. Je kunt ook een cursus volgen om de kunst van het pottenbakken te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La poterie M'Art'ine"
    ]
  },
