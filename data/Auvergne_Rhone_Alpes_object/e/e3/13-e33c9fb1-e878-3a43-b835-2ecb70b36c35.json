  "rdfs:comment": {
    "de": [
      "Das ist DIE große Neuheit des Jahres 2026 im Palais des Bonbons du Nougat et des Souvenirs!\r\nDer Standort gönnt sich einen Ausflug in die Lüfte mit einem Raum, der ganz der Patrouille de France gewidmet ist."
    ],
    "en": [
      "It's THE big news for 2026 at the Palais des Bonbons du Nougat et des Souvenirs!\r\nThe site is taking to the skies with an area entirely dedicated to the Patrouille de France."
    ],
    "it": [
      "Ecco la grande novità del 2026 al Palais des Bonbons du Nougat et des Souvenirs!\r\nIl sito si alza in volo con un'area interamente dedicata alla Patrouille de France."
    ],
    "fr": [
      "C’est LA grande nouveauté de cette année 2026 au Palais des Bonbons du Nougat et des Souvenirs ! \r\nLe site s'offre une incursion dans les airs avec un espace entièrement dédié à la Patrouille de France."
    ],
    "es": [
      "Esta es LA gran novedad de 2026 en el Palacio de Bombones del Turrón y los Recuerdos\r\nEl recinto se eleva a los cielos con un espacio enteramente dedicado a la Patrouille de France."
    ],
    "nl": [
      "Dit is HET grote nieuws voor 2026 in het Palais des Bonbons du Nougat et des Souvenirs!\r\nDe site gaat de lucht in met een ruimte die helemaal gewijd is aan de Patrouille de France."
    ]
  },
  "rdfs:label": {
