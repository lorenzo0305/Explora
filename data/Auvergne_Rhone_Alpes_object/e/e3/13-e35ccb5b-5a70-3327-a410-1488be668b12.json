  "rdfs:comment": {
    "de": [
      "Das Restaurant La Fabrik bietet eine einfache und reichhaltige Speisekarte, die im Speisesaal oder auf der Terrasse am Pool serviert wird. Ein wahrhaft entspannender Ort in einer gemütlichen und modernen Umgebung."
    ],
    "en": [
      "The restaurant offers simple, generous à la carte cuisine served in the dining room or on the terrace, alongside the swimming pool. A real relaxation rendez-vous, in a warm and contemporary decor."
    ],
    "it": [
      "Il ristorante La Fabrik propone un menù à la carte con piatti semplici e abbondanti, serviti in sala o sulla terrazza a bordo piscina. Un vero e proprio luogo di relax, in un ambiente accogliente e contemporaneo."
    ],
    "fr": [
      "Le restaurant La Fabrik propose à la carte une cuisine simple et généreuse, servie en salle ou en terrasse, au bord de la piscine. Un véritable rendez-vous détente, dans un cadre chaleureux et contemporain."
    ],
    "nl": [
      "Het restaurant La Fabrik biedt eenvoudige, royale à la carte gerechten, geserveerd in de eetzaal of op het terras bij het zwembad. Het is de perfecte plek om te ontspannen in een warme, moderne omgeving."
    ],
    "es": [
      "El restaurante La Fabrik ofrece una carta con platos sencillos y generosos, que se sirven en el comedor o en la terraza, junto a la piscina. Un auténtico lugar de relajación, en un ambiente acogedor y contemporáneo."
    ]
  },
