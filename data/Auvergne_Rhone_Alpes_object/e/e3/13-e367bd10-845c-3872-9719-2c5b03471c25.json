  "rdfs:comment": {
    "de": [
      "Héloïse Burtin, eine diplomierte Sporttrainerin, begleitet Urlauber aller Niveaus mit angepassten Pilates- und Stretching-Sitzungen sowie geführten Wanderungen. Wohlbefinden, Fitness und Entdeckung der Landschaften im Rhythmus jedes Einzelnen."
    ],
    "en": [
      "Héloïse Burtin, a qualified sports coach, accompanies holidaymakers of all levels with adapted pilates and stretching sessions, as well as guided hikes. Well-being, getting back into shape and discovering the countryside at your own pace."
    ],
    "it": [
      "Héloïse Burtin, allenatrice sportiva qualificata, accompagna i vacanzieri di tutti i livelli con sessioni di pilates e stretching adattate, oltre a passeggiate guidate. Benessere, rimessa in forma e scoperta della campagna al proprio ritmo."
    ],
    "fr": [
      "Héloïse Burtin, coach sportive diplômée, accompagne les vacanciers de tous niveaux avec des séances de pilates et de stretching adaptées, ainsi que des randonnées guidées. Bien-être, remise en forme et découverte des paysages au rythme de chacun."
    ],
    "nl": [
      "Héloïse Burtin, gediplomeerd sportcoach, begeleidt vakantiegangers van alle niveaus met aangepaste pilates- en rekoefeningen en begeleide wandelingen. Wellness, weer in vorm komen en het platteland ontdekken op je eigen tempo."
    ],
    "es": [
      "Héloïse Burtin, entrenadora deportiva titulada, acompaña a los veraneantes de todos los niveles con sesiones adaptadas de pilates y estiramientos, así como paseos guiados. Bienestar, recuperar la forma y descubrir el campo a su ritmo."
    ]
  },
