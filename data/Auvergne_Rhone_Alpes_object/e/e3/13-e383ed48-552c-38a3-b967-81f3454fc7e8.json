  "rdfs:comment": {
    "de": [
      "Wechsel des Eigentümers zum 4.12.23\r\nIdeal gelegene Einrichtung, am Anfang des Golfplatzes im Sommer und der nordischen Skipisten im Winter. Raffinierte Küche und gemütliches Ambiente. Tagesgerichte, Menüs à la carte, Weinbar, Goûter."
    ],
    "en": [
      "With golfing in summer and downhill skiing in winter, the restaurant is open every day from 9am to 6pm. The biggest appetites will be satisfied with a slow-cooked stew or menus à la carte. Traditional cooking."
    ],
    "it": [
      "Cambio di proprietario il 4/12/23\r\nSituato in posizione ideale all'inizio del campo da golf in estate e delle piste di sci nordico in inverno. Cucina raffinata e atmosfera accogliente. Specialità giornaliere, menu à la carte, wine bar, snack."
    ],
    "fr": [
      "Changement de propriétaire au 4/12/23\r\nEtablissement idéalement situé, au départ du Golf l'été et des pistes de ski nordique en hiver. Cuisine raffinée et ambiance chaleureuse. Plats du jour, menus à la carte, Bar à vins, gouter."
    ],
    "nl": [
      "Verandering van eigenaar op 4/12/23\r\nIdeaal gelegen aan het begin van de golfbaan in de zomer en de noordse skipistes in de winter. Verfijnde keuken en warme sfeer. Dagschotels, à la carte menu's, wijnbar, snacks."
    ],
    "es": [
      "Cambio de propietario el 4/12/23\r\nIdealmente situado al comienzo del campo de golf en verano y de las pistas de esquí nórdico en invierno. Cocina refinada y ambiente cálido. Especialidades del día, menús a la carta, bar de vinos, aperitivos."
    ]
  },
