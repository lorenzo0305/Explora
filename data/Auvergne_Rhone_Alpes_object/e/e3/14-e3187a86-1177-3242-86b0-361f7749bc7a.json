  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c0bb32e3-ad03-3185-ae40-ef7ee536ecb0",
      "dc:description": {
        "de": [
          "Weihnachtsmarkt im Kursaal von 10 bis 18 Uhr\nAnimationen, Geschenk-, Kunsthandwerk- und Deko-Stände, kleine Snacks (professionelle Aussteller und Vereine aus Berck)\nKostenloser Eintritt"
        ],
        "en": [
          "Christmas Market at the Kursaal from 10am to 6pm\nEntertainment, gift stalls, crafts, decorations, snacks (professional exhibitors and Berck associations)\nFree admission"
        ],
        "it": [
          "Mercatino di Natale al Kursaal dalle 10.00 alle 18.00\nIntrattenimento, bancarelle di articoli da regalo, artigianato, decorazioni, spuntini (espositori professionisti e associazioni di Berck)\nIngresso libero"
        ],
        "fr": [
          "Marché de Noël au Kursaal de 10h à 18h\nAnimations, stands cadeaux, artisanat, déco, petite restauration (exposants professionnels et associations berckoises)\nEntrée gratuite"
        ],
        "es": [
          "Mercado de Navidad en el Kursaal de 10.00 a 18.00 horas\nEntretenimiento, puestos de regalos, artesanía, decoración, aperitivos (expositores profesionales y asociaciones de Berck)\nEntrada gratuita"
        ],
        "nl": [
          "Kerstmarkt in het Kursaal van 10 tot 18 uur\nAmusement, cadeauwinkeltjes, handwerk, versieringen, hapjes (professionele standhouders en Berckse verenigingen)\nGratis toegang"
        ]
      },
