  "rdfs:comment": {
    "de": [
      "\"Les toquées\" ist ein Café/Bistro/Restaurant, das angenehm am Fluss \"la Cronce\" gelegen ist und eine große Auswahl an selbstgebrauten Bieren bietet.\r\nAuf Reservierung, indem man vor 12 Uhr mittags anruft, 24 Stunden im Voraus."
    ],
    "en": [
      "\"Les toquées\" is a café/bistro/restaurant, pleasantly located along the river \"la Cronce\" with a wide choice of craft beer.\r\nReservations required by calling before noon, 24 hours in advance."
    ],
    "it": [
      "\"Les toquées\" è un caffè/bistrot/ristorante, piacevolmente situato lungo il fiume \"la Cronce\", con un'ampia scelta di birre artigianali.\r\nLe prenotazioni devono essere effettuate con 24 ore di anticipo chiamando prima di mezzogiorno."
    ],
    "fr": [
      "\"Les toquées\" est un café/bistrot/restaurant, agréablement situé le long de la rivière \" la Cronce\"  avec un large choix de bière artisanale .\r\nSur réservation en appelant avant midi.,  24h à l'avance."
    ],
    "nl": [
      "\"Les toquées\" is een café/bistro/restaurant, aangenaam gelegen langs de rivier \"la Cronce\" met een ruime keuze aan ambachtelijk bier.\r\nReserveringen moeten 24 uur van tevoren worden gemaakt door vóór 12.00 uur te bellen."
    ],
    "es": [
      "\"Les toquées\" es un café/bistro/restaurante, agradablemente situado a orillas del río \"la Cronce\" con una amplia carta de cervezas artesanales.\r\nLas reservas deben hacerse con 24 horas de antelación llamando antes del mediodía."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot \"Les Toquées\""
    ]
  },
