  "rdfs:comment": {
    "de": [
      "Mit Inside Park erleben Sie nur wenige Minuten von Saint-Etienne entfernt ein einzigartiges Erlebnis! Wir bieten Ihnen die Möglichkeit, unseren über 4000 m² großen Komplex mit Indoor- & Outdoor-Freizeitspielen zu entdecken."
    ],
    "en": [
      "With Inside Park, enjoy a unique experience just minutes from Saint-Etienne!\r\nCome and discover our 4,000 m² indoor leisure complex."
    ],
    "it": [
      "Inside Park vi offre un'esperienza unica a pochi minuti da Saint-Etienne! Vi invitiamo a scoprire il nostro complesso di oltre 4.000 m² di attività ricreative al coperto e all'aperto."
    ],
    "fr": [
      "Avec Inside Park, vivez une expérience unique à quelques minutes de Saint-Etienne ! Nous vous proposons de découvrir notre complexe de plus de 4 000m² de jeux de loisirs indoor & outdoor."
    ],
    "es": [
      "Inside Park le ofrece una experiencia única a pocos minutos de Saint-Etienne Le invitamos a descubrir nuestro complejo de más de 4.000 m² de actividades de ocio cubiertas y al aire libre."
    ],
    "nl": [
      "Inside Park biedt je een unieke ervaring op slechts enkele minuten van Saint-Etienne! We nodigen je uit om ons complex van meer dan 4.000m² aan binnen- en buitenactiviteiten te ontdekken."
    ]
  },
