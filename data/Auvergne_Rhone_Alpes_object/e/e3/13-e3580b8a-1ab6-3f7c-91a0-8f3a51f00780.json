  "rdfs:comment": {
    "de": [
      "Nehmen Sie teil am 56? Raid pédestre Le Puy/Firminy: 69 km zwischen Stadt und Natur. Wanderversion Beaux/Firminy von 39 km. Nachtstart vom Stade Lafayette in Le Puy-en-Velay. Eine sportliche und gesellige Herausforderung."
    ],
    "en": [
      "Take part in the 56? Raid pédestre Le Puy/Firminy: 69 km between town and nature. 39 km Beaux/Firminy version. Night-time departure from Lafayette stadium in Le Puy-en-Velay. A sporting and friendly challenge."
    ],
    "it": [
      "Partecipare al 56? Raid pédestre Le Puy/Firminy: 69 km tra città e natura. 39 km in versione Beaux/Firminy. Partenza di notte dallo stadio Lafayette di Le Puy-en-Velay. Una sfida sportiva e amichevole."
    ],
    "fr": [
      "Participez au 56ᵉ Raid pédestre Le Puy/Firminy : 69 km entre ville et nature. Version rando Beaux/Firminy de 39 km. Départ nocturne du stade Lafayette au Puy-en-Velay. Un défi sportif et convivial."
    ],
    "es": [
      "Participe en el 56? Raid pédestre Le Puy/Firminy: 69 km entre ciudad y naturaleza. Versión Beaux/Firminy de 39 km. Salida nocturna desde el estadio Lafayette de Le Puy-en-Velay. Un desafío deportivo y amistoso."
    ],
    "nl": [
      "Doe je mee aan de 56? Raid pédestre Le Puy/Firminy: 69 km tussen stad en natuur. 39 km versie Beaux/Firminy. Vertrek 's nachts vanuit het Lafayette-stadion in Le Puy-en-Velay. Een sportieve en gezellige uitdaging."
    ]
  },
  "rdfs:label": {
    "fr": [
      "56ème Raid pédestre Le Puy - Firminy"
    ]
  },
