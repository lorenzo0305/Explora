  "rdfs:comment": {
    "de": [
      "Das Bihr Adventure liegt im Herzen des Cantal auf 1000m Höhe am Rande des Truyère-Tals und ist eines der ersten großen Treffen von Motorrädern, Quads und SSVs zu Beginn der Saison."
    ],
    "en": [
      "Located in the heart of the Cantal at 1000m altitude on the edge of the Truyère valley, the Bihr Adventure is one of the first big motorcycle, quad and SSV gatherings of the beginning of the season."
    ],
    "it": [
      "Situato nel cuore del Cantal, a 1000 metri di altitudine, ai margini della valle del Truyère, il Bihr Adventure è uno dei primi grandi raduni di moto, quad e SSV di inizio stagione."
    ],
    "fr": [
      "Située en plein cœur du Cantal à 1000m d’altitude au bord de la vallée de la Truyère, le Bihr Adventure est l’un des premiers grands rassemblements Moto, Quad et SSV de début de saison."
    ],
    "es": [
      "Situada en el corazón del Cantal, a 1.000 metros de altitud, al borde del valle del Truyère, la Bihr Adventure es una de las primeras grandes concentraciones de motos, quads y SSV de principios de temporada."
    ],
    "nl": [
      "Gelegen in het hart van de Cantal op 1000 m hoogte aan de rand van het Truyère-dal, is de Bihr Adventure een van de eerste grote motor-, quad- en SSV-bijeenkomsten van het begin van het seizoen."
    ]
  },
