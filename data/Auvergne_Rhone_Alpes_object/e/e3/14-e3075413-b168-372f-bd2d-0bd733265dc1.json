  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1004d663-f054-30ac-a699-6eceb1b06b53",
      "dc:description": {
        "de": [
          "Kommen Sie und entdecken Sie jeden Tag frische Burger! Milchshakes! Frische Wings ohne Semmelbrösel!\n\nÖffnungszeiten:\nMontag bis Samstag von 11:30 bis 14:00 Uhr und von 18:30 bis 22:00 Uhr, freitags und samstags um 23:00 Uhr geschlossen.\n "
        ],
        "en": [
          "Discover fresh burgers every day! Fresh milkshakes! Fresh wings without breadcrumbs!\n\nOpening hours:\nMonday to Saturday, 11.30am to 2pm and 6.30pm to 10pm, closing at 11pm on Fridays and Saturdays.\n "
        ],
        "it": [
          "Scoprite gli hamburger freschi ogni giorno! Frullati freschi! Ali fresche senza pangrattato!\n\nOrari di apertura:\nDal lunedì al sabato, dalle 11.30 alle 14.00 e dalle 18.30 alle 22.00. Venerdì e sabato chiude alle 23.00.\n "
        ],
        "fr": [
          "Venez découvrir des burgers frais chaque jour ! Des milkshakes ! Des wings frais sans chapelure !\n\nHoraires :\nDu lundi au samedi de 11h30 à 14h et de 18h30 à 22h, fermeture à 23h les vendredis et samedis.\n "
        ],
        "es": [
          "¡Descubra hamburguesas frescas todos los días! Batidos recién hechos ¡Alitas frescas sin pan rallado!\n\nHorario de apertura:\nDe lunes a sábado, de 11.30 a 14.00 y de 18.30 a 22.00. Los viernes y sábados cierra a las 23.00.\n "
        ],
        "nl": [
          "Ontdek elke dag verse hamburgers! Verse milkshakes! Verse vleugels zonder paneermeel!\n\nOpeningstijden:\nMaandag t/m zaterdag van 11.30 tot 14.00 en van 18.30 tot 22.00. Sluit om 23.00 op vrijdag en zaterdag.\n "
        ]
      },
      "@type": [
        "Description"
