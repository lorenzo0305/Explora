  "rdfs:comment": {
    "de": [
      "Die ESF ist in den meisten Skigebieten vertreten und bietet eine breite Palette an Kursen an, die für alle Altersgruppen und Niveaus geeignet sind."
    ],
    "en": [
      "Present in most ski resorts, the ESF offers a wide range of courses, adapted to all ages and levels."
    ],
    "it": [
      "Presente nella maggior parte delle stazioni sciistiche, l'ESF offre un'ampia gamma di lezioni, adatte a tutte le età e a tutti i livelli."
    ],
    "fr": [
      "Présente dans la majorité des stations de ski, l'ESF propose une large gamme de cours, adaptés à tous les âges et à tous les niveaux."
    ],
    "es": [
      "Presente en la mayoría de las estaciones de esquí, el FSE ofrece una amplia gama de clases, adecuadas para todas las edades y niveles."
    ],
    "nl": [
      "De ESF, die in de meeste skigebieden aanwezig is, biedt een breed scala aan lessen, geschikt voor alle leeftijden en niveaus."
    ]
  },
