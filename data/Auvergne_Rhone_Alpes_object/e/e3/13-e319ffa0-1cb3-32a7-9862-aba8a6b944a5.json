  "rdfs:comment": {
    "de": [
      "Das an einem See gelegene Restaurant Domaine du Balbuzard ermöglicht es Ihnen, auf der Terrasse oder am Kamin unsere hausgemachten Tagesgerichte zu probieren, während Sie die wunderschöne Natur genießen."
    ],
    "en": [
      "The Domaine du Balbuzard restaurant, located by a lake, allows you, on the terrace or by the fireplace, to taste our home-cooked daily specials, while enjoying the beautiful natural setting."
    ],
    "it": [
      "Il ristorante del Domaine du Balbuzard, situato sul bordo di un lago, vi permette, sulla terrazza o accanto al fuoco, di gustare i nostri piatti del giorno fatti in casa, approfittando della splendida cornice naturale."
    ],
    "fr": [
      "Le restaurant du Domaine du Balbuzard, situé au bord d'un lac, vous permet, en terrasse ou au coin du feu, de déguster nos plats du jour cuisinés maison, tout en profitant du joli cadre de nature."
    ],
    "nl": [
      "In het restaurant van het Domaine du Balbuzard, gelegen aan de rand van een meer, kunt u op het terras of bij het vuur genieten van onze huisgemaakte gerechten van de dag, terwijl u profiteert van de prachtige natuurlijke omgeving."
    ],
    "es": [
      "El restaurante del Domaine du Balbuzard, situado a orillas de un lago, le permite, en la terraza o junto al fuego, degustar nuestros platos caseros del día, aprovechando al mismo tiempo el bello entorno natural."
    ]
  },
