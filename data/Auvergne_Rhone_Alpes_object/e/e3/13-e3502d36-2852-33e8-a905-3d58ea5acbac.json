  "rdfs:comment": {
    "de": [
      "Zum ersten Mal wird in Méribel ein dreitägiges Event organisiert, das CrossFit, Hyrox und Trail miteinander verbindet. Drei Tage voller sportlicher Herausforderungen, Ausdauer und Austausch im Herzen der Berge für alle Sportbegeisterten."
    ],
    "en": [
      "For the first time in Méribel, a 3-day event combining CrossFit, Hyrox and Trail will be held. Three days of sporting challenges, endurance and sharing in the heart of the mountains for all enthusiasts."
    ],
    "it": [
      "Per la prima volta a Méribel si terrà un evento di 3 giorni che combina CrossFit, Hyrox e Trail. Tre giorni di sfide sportive, resistenza e condivisione nel cuore delle montagne per tutti gli appassionati."
    ],
    "fr": [
      "Pour la première fois à Méribel, un événement sur 3 jours mêlant CrossFit, Hyrox et Trail sera organisé. Trois jours de défis sportifs, d’endurance et de partage au cœur des montagnes pour tous les passionnés."
    ],
    "nl": [
      "Voor de eerste keer vindt in Méribel een 3-daags evenement plaats dat CrossFit, Hyrox en Trail combineert. Drie dagen van sportieve uitdagingen, uithoudingsvermogen en samen delen in het hart van de bergen voor alle liefhebbers."
    ],
    "es": [
      "Por primera vez en Méribel, se celebrará un evento de 3 días que combina CrossFit, Hyrox y Trail. Tres días de retos deportivos, resistencia y convivencia en plena montaña para todos los aficionados."
    ]
  },
