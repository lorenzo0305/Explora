  "rdfs:comment": {
    "de": [
      "Das 1934 gegründete Familienhotel liegt auf dem Land, 2 km von Monestier-de-Clermont entfernt, im Regionalen Naturpark von Vercors und Trièves. Heute wird das Hotel in der vierten Generation geführt, mit Julien MAURICE am Herd."
    ],
    "en": [
      "\"Au sans souci\" (\"No worries here\") has been created in 1934 by Léon and Julia MAURICE. \"Au Sans Souci\" has been pleased to welcome visitors and gourmets for 4 generations !"
    ],
    "it": [
      "Hotel a conduzione familiare creato nel 1934, situato in campagna a 2 km da Monestier-de-Clermont, nel Parco Naturale Regionale del Vercors e del Trièves. Oggi è la quarta generazione, con Julien MAURICE responsabile della cucina, a gestire il locale."
    ],
    "fr": [
      "Hôtel familial créé en 1934, situé à la campagne à 2 km de Monestier-de-Clermont, dans le Parc Naturel Régional du Vercors et du Trièves. C'est aujourd'hui la quatrième génération, avec Julien MAURICE aux fourneaux, qui s'occupe de l'établissement."
    ],
    "es": [
      "Hotel familiar creado en 1934, situado en el campo a 2 km de Monestier-de-Clermont, en el Parque Natural Regional de Vercors y Trièves. En la actualidad, es la cuarta generación, con Julien MAURICE al frente de la cocina, quien dirige el establecimiento."
    ],
    "nl": [
      "Familiehotel opgericht in 1934, gelegen op het platteland op 2 km van Monestier-de-Clermont, in het regionale natuurpark Vercors en Trièves. Vandaag is het de vierde generatie, met Julien MAURICE aan het hoofd van de keuken, die de zaak leidt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Sans Souci"
    ]
  },
