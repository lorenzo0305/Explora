  "rdfs:comment": {
    "de": [
      "Die Pizzen können Sie vor Ort essen oder mitnehmen, und Sie haben sogar die Möglichkeit, den Lastwagen für Feierlichkeiten zu reservieren. Alles wird vor Ort zubereitet und sogar Ravioli-Gratins werden Ihnen angeboten!"
    ],
    "en": [
      "Pizzas can be eaten in or taken away, and you can even reserve the truck for festivities. Everything is made on the spot, and even ravioli gratins are available!"
    ],
    "it": [
      "Le pizze possono essere consumate sul posto o portate via, e si può anche prenotare il camioncino per le occasioni di festa. Tutto viene preparato sul momento e si possono gustare anche i ravioli gratinati!"
    ],
    "fr": [
      "Les pizzas se dégustent sur place ou à emporter, et vous avez même la possibilité de réserver le camion pour les festivités. Tout est fait sur place et même des gratins de ravioles vous sont proposés !"
    ],
    "es": [
      "Las pizzas se pueden comer en el local o para llevar, e incluso se puede reservar el camión para ocasiones festivas. Todo se elabora al momento, ¡e incluso se pueden degustar raviolis gratinados!"
    ],
    "nl": [
      "De pizza's kunnen ter plekke worden gegeten of meegenomen, en je kunt zelfs de vrachtwagen reserveren voor feestelijke gelegenheden. Alles wordt ter plekke gemaakt en we serveren zelfs gegratineerde ravioli!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ho' Resto de Piz'"
    ]
  },
