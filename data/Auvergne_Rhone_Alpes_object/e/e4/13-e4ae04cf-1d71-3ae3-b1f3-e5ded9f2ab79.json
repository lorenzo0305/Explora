    "de": [
      "Willkommen bei ChamonixSki! \r\nUnsere Philosophie: We work and you ski. Wir kümmern uns um alles, Sie müssen nur noch gleiten!"
    ],
    "en": [
      "Welcome to ChamonixSki! \r\nOur philosophy : We work and you ski. We take care of everything, all you have to do is slide !"
    ],
    "it": [
      "Benvenuti a ChamonixSki! \r\nLa nostra filosofia: noi lavoriamo e voi sciate. Noi ci occupiamo di tutto, voi dovete solo scivolare!"
    ],
    "fr": [
      "Bienvenue chez ChamonixSki ! \r\nNotre philosophie : We work and you ski. On s’occupe de tout, vous n’avez plus qu’à glisser !"
    ],
