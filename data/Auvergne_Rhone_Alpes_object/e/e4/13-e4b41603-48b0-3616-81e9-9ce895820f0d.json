  "rdfs:comment": {
    "de": [
      "Der Hof vereint 3 Projekte: einen Müller-Bauern, eine Gemüsebäuerin und einen Obstbauern, um das ganze Jahr über saisonale Produkte aus biologischem Anbau anbieten zu können."
    ],
    "en": [
      "The farm brings together 3 projects: a farmer-miller, a market gardener and an arboriculturist to offer seasonal organic produce all year round."
    ],
    "it": [
      "La fattoria riunisce 4 progetti: un agricoltore-mugnaio, un ortolano, un arboricoltore e un coltivatore di sementi per offrire prodotti biologici stagionali durante tutto l'anno."
    ],
    "fr": [
      "La ferme regroupe 4 projets : un paysan-meunier, une maraîchère, un arboriculteur et une pepinieriste afin d’offrir des produits de saison en agriculture biologique tout au long de l’année."
    ],
    "es": [
      "La granja reúne 4 proyectos: un agricultor-molinero, un horticultor, un arboricultor y un cultivador de semillas para ofrecer productos ecológicos de temporada durante todo el año."
    ],
    "nl": [
      "De boerderij brengt 3 projecten samen: een boer-molenaar, een tuinder en een boomkweker om het hele jaar door seizoensgebonden biologische producten aan te bieden."
    ]
  },
  "rdfs:label": {
