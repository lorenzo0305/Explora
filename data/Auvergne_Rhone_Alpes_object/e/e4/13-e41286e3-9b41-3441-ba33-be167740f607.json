  "rdfs:comment": {
    "de": [
      "Familiäre Küche mit folgenden Spezialitäten: Steinpilzgratin, Wild während der Saison, Fleischgerichte mit Sauce, handwerklich hergestellte Wurstwaren, frisches, \"handverlesenes\" Gemüse. Hausgemachte Desserts. Vor dem Haus befinden sich Langlaufloipen, man kann Schneeschuh wandern oder einfach zu Fuß Wanderungen unternehmen."
    ],
    "en": [
      "A cuisine of family specialties: chalet gratin with cep, seasonal game, meat in sauce, artisanal charcuterie, fresh vegetables prepared by hand.\r\nHome-made desserts. At the departure point for cross-country skiing, snowshoeing and hiking."
    ],
    "it": [
      "Cucina di famiglia con le seguenti specialità: gratin du chalet aux cèpes, selvaggina di stagione, carne con salsa, affettati artigianali, verdura fresca selezionata. Dessert fatti in casa. Nei pressi delle piste di sci di fondo, racchette da neve ed escursioni a piedi."
    ],
    "fr": [
      "Cuisine familiale spécialités : gratin du chalet aux cèpes, gibier en saison, viandes en sauce, charcuterie artisanale,  légumes frais \"pluchés\" à la main. Desserts maison. Au départ pistes de ski de fond, raquettes à neige et randonnée pédestre."
    ],
    "nl": [
      "Familiale specialiteiten: gratin du chalet met eekhoorntjesbrood, wild in het seizoen, vlees in saus, artisanale vleeswaren, verse groentes die met de hand worden geschild. Zelfgemaakte nagerechten. Vertrekpunt voor langlaufen, met raketten lopen en trektochten."
    ],
    "es": [
      "Especialidades de la cocina familiar: gratin du chalet aux cèpes, caza de temporada, carnes en salsa, charcutería casera, verduras frescas \"arrancadas\" a mano. Postres caseros. Al inicio de las rutas de esquí de fondo, raquetas de nieve y senderismo."
    ]
  },
