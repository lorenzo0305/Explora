  "rdfs:comment": {
    "de": [
      "Aurélien, Metallhandwerker, bietet Maßanfertigungen (Tische, Möbel ...) aus Metall und Holz an, aber auch Schweißworkshops für die breite Öffentlichkeit."
    ],
    "en": [
      "Aurélien, metal craftsman, offers custom-made pieces (tables, furniture, etc.) in metal and wood, as well as welding workshops for the general public."
    ],
    "it": [
      "Aurélien, artigiano metalmeccanico, offre pezzi su misura (tavoli, mobili, ecc.) in metallo e legno, oltre a laboratori di saldatura per il pubblico."
    ],
    "fr": [
      "Aurélien, artisan métallier, propose des pièces sur-mesure (tables, mobiliers...) en métal et bois, mais également des ateliers de soudure grand public."
    ],
    "es": [
      "Aurélien, metalúrgico, ofrece piezas a medida (mesas, muebles, etc.) en metal y madera, así como talleres de soldadura para el público en general."
    ],
    "nl": [
      "Aurélien, een metaalbewerker, biedt op maat gemaakte stukken (tafels, meubels, enz.) in metaal en hout, evenals lasworkshops voor het grote publiek."
    ]
  },
