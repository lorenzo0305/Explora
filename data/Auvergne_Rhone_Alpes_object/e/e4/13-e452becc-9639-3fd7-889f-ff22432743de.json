  "rdfs:comment": {
    "de": [
      "Das Château de Laforest bietet je nach Jahreszeit zwei Veranstaltungsräume: den großen Festsaal mit Sternenhimmel oder den Weinkeller, alles inmitten eines ummauerten Parks.\r\nUnterkünfte vor Ort und weniger als 1 km vom Schloss entfernt."
    ],
    "en": [
      "Château de Laforest offers 2 reception areas, depending on the season: the large reception room with its starry sky, or the winery, all set in the heart of a walled park.\r\nAccommodation on site and less than a km from the château."
    ],
    "it": [
      "Lo Château de Laforest offre 2 spazi di accoglienza, a seconda della stagione: la grande sala di ricevimento con il suo cielo stellato o la sala dei tini, il tutto immerso in un parco recintato.\r\nAlloggio in loco e a meno di un chilometro dal castello."
    ],
    "fr": [
      "Le château de Laforest propose 2 espaces de réception en fonction de la saison, la grande salle de réception avec son ciel étoilé ou le cuvage, le tout au coeur d'un parc clos de murs. \r\nHébergements sur place et à moins d'un km du château."
    ],
    "es": [
      "El castillo de Laforest ofrece 2 espacios de recepción, según la temporada: la gran sala de recepción con su cielo estrellado o la sala de cubas, todo ello en el corazón de un parque amurallado.\r\nAlojamiento in situ y a menos de un kilómetro del castillo."
    ],
    "nl": [
      "Château de Laforest biedt 2 receptieruimtes, afhankelijk van het seizoen: de grote receptiezaal met sterrenhemel of de kuipzaal, allemaal in het hart van een ommuurd park.\r\nAccommodatie ter plaatse en op minder dan een kilometer van het kasteel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Laforest - 2 espaces de réception"
    ]
  },
