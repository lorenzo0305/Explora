  "rdfs:comment": {
    "de": [
      "Genießen Sie in diesem modernen Restaurant belgische Spezialitäten. Abwechslung garantiert mit den unumgänglichen frischen Moules frites,Frikadellen, Salaten, Carbonade mit Bier, Mexicanos... und belgischen Bieren."
    ],
    "en": [
      "\"Come and try this modern restaurant serving specialities from Belgium. \r\nA real change of scene with the inevitable mussels and freshly-fried chips, frikandel, carbonnade salads with beer, mexicanos and, of course, Belgian beer.\""
    ],
    "it": [
      "Venite a gustare le specialità belghe in questo moderno ristorante\r\nUn cambio di scenario è garantito con le immancabili cozze fresche fritte, le fricadelle, le insalate, gli hamburger, le carbonade con birra... e le birre belghe."
    ],
    "fr": [
      "Venez déguster dans ce restaurant moderne les spécialités belges. \r\nDépaysement assuré avec les incontournables moules frites fraîches, les fricadelles, les salades, les burgers, carbonade à la bière... et bières belges."
    ],
    "es": [
      "Venga a disfrutar de las especialidades belgas en este moderno restaurante\r\nEl cambio de aires está garantizado con los inevitables mejillones frescos fritos, fricadelas, ensaladas, hamburguesas, carbonada con cerveza... y cervezas belgas."
    ],
    "nl": [
      "Kom genieten van Belgische specialiteiten in dit moderne restaurant\r\nEen afwisseling is gegarandeerd met de onvermijdelijke vers gebakken mosselen, fricadellen, salades, hamburgers, carbonade met bier... en Belgische bieren."
    ]
  },
