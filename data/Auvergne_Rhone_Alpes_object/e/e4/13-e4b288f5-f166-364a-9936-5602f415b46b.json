  "rdfs:comment": {
    "de": [
      "Das Reitzentrum und der Poney Club Montmeyre bietet Reitkurse vom Baby-Pony bis zum Galop 7 (Ablegen von eidgenössischen Prüfungen, Wettbewerbe CSO, Dressur, CCE), aber auch Ausritte an."
    ],
    "en": [
      "The Equestrian center and poney club of Montmeyre offers horseback riding lessons from level baby poney to gallop 7 (Federal-provincial reviews, competitions, CSO,training horses, CCE, but also horseback riding."
    ],
    "it": [
      "Il centro di equitazione e pony club di Montmeyre offre lezioni di equitazione da baby pony a galop 7 (esami federali, CSO, dressage e concorsi CCE) e passeggiate a cavallo."
    ],
    "fr": [
      "Le centre équestre et poney club de Montmeyre propose des cours d’équitation du niveau baby poney au galop 7 (passage des examens fédéraux, concours CSO, dressage, CCE) mais également des balades à cheval."
    ],
    "es": [
      "El centro de equitación y el pony club de Montmeyre ofrecen clases de equitación desde el baby pony hasta el galop 7 (exámenes federales, CSO, doma y concursos CCE), así como de equitación."
    ],
    "nl": [
      "De manege en ponyclub van Montmeyre biedt naast paardrijlessen vanaf de baby pony tot galop 7 (federale examens, CSO, dressuur en CCE-wedstrijden)."
    ]
  },
