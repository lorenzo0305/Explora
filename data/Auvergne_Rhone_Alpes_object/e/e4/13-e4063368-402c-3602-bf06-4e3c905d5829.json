  "rdfs:comment": {
    "de": [
      "Hexe oder Zauberer, Muggel, seien Sie herzlich willkommen. Ich kreiere Zauberstäbe aus gedrechseltem Holz, die ich schnitze und forme, um sie zu echten Sammlerstücken zu machen.\r\nWeitere Kreationen finden Sie an der Grenze von realen und fantastischen Tieren."
    ],
    "en": [
      "Witch or Wizard, Muggle, welcome. I create magic wands, in turned wood, which I carve and shape to make real collector's items.\r\nOther creations to be found on the border of real and fantastic animals."
    ],
    "it": [
      "Strega o mago, babbano, benvenuto. Creo bacchette magiche in legno tornito, che intaglio e plasmo per farne veri e propri oggetti da collezione.\r\nAltre creazioni si trovano al confine tra animali reali e fantastici."
    ],
    "fr": [
      "Sorcière ou Sorcier, Moldu, soyez les bienvenus. Je créé des baguettes magiques, en bois tourné, que je sculpte et façonne afin d'en faire de véritables objets de collection.\r\nD'autres créations à retrouver à la frontière d'animaux réels et fantastiques."
    ],
    "nl": [
      "Heks of Tovenaar, Dreuzel, welkom. Ik maak toverstokjes van gedraaid hout, die ik snij en vorm tot echte verzamelobjecten.\r\nAndere creaties zijn te vinden op de grens van echte en fantastische dieren."
    ],
    "es": [
      "Bruja o mago, muggle, bienvenido. Creo varitas mágicas en madera torneada, que tallo y doy forma para hacer verdaderas piezas de colección.\r\nOtras creaciones se encuentran en la frontera de los animales reales y fantásticos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Baguettes Morgul"
    ]
  },
