  "rdfs:comment": {
    "de": [
      "Klettergebiet mit zwei Sektoren, der Muraillette und einem Einsteigersektor, geeignet für Kinder & Anfänger!\r\n\r\nEine Mischung aus harten Routen (linker Sektor) mit Platten und Überhängen und leichteren Routen (rechter Sektor) mit Wannen und Löchern."
    ],
    "en": [
      "Climbing site with two sectors, the Muraillette and an initiation sector, suitable for children & beginners!\r\n\r\nA mix of hard routes (left sector) with slabs and overhangs, and easier routes (right sector) with tubs and holes."
    ],
    "it": [
      "Sito di arrampicata con due settori, la Muraillette e un settore introduttivo, adatto a bambini e principianti!\r\n\r\nUn mix di vie difficili (settore sinistro) con placche e strapiombi e vie più facili (settore destro) con vasche e buchi."
    ],
    "fr": [
      "Site d'escalade avec deux secteurs, la Muraillette et un secteur d’initiation, adapté aux enfants & débutants ! \r\n\r\nMélange de voies dures (secteur de gauche) en dalles et dévers et de voies plus faciles (secteur de droite) avec baquets et trous."
    ],
    "es": [
      "Sitio de escalada con dos sectores, la Muraillette y un sector de iniciación, ¡apto para niños y principiantes!\r\n\r\nUna mezcla de vías duras (sector izquierdo) con losas y voladizos y vías más fáciles (sector derecho) con bañeras y agujeros."
    ],
    "nl": [
      "Klimlocatie met twee sectoren, de Muraillette en een inleidende sector, geschikt voor kinderen en beginners!\r\n\r\nEen mix van moeilijke routes (linkse sector) met platen en overhangen en gemakkelijkere routes (rechtse sector) met kuipen en gaten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brieux rock climbing site"
    ],
    "fr": [
      "Site d’escalade de Saint-Egrève - Les Brieux"
    ]
  },
