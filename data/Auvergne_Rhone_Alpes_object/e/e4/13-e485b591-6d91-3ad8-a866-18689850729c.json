  "rdfs:comment": {
    "de": [
      "Der Verein der Freunde von Saint-Jean-Saint-Maurice-sur-Loire hat sein Projekt \"Chemin des peintres\" (Malerweg) abgeschlossen.\r\nEntdecken Sie einen Weg mit 19 Etappen, die an berühmte Maler aus dem Roannais erinnern."
    ],
    "en": [
      "The Friends of Saint-Jean-Saint-Maurice-sur-Loire association has just finalized its project for a painters' trail.\r\nCome and discover a 19-stage itinerary evoking famous Roannais painters."
    ],
    "it": [
      "L'associazione Amici di Saint-Jean-Saint-Maurice-sur-Loire ha appena ultimato il progetto di un sentiero dei pittori.\r\nVenite a scoprire un percorso in 19 tappe che evoca famosi pittori della regione del Roannais."
    ],
    "fr": [
      "L'association des Amis de Saint-Jean-Saint-Maurice-sur-Loire vient de finaliser son projet de chemin des peintres. \r\nVenez découvrir un parcours en 19 étapes évoquant des peintres célèbres du Roannais."
    ],
    "es": [
      "La asociación Amigos de Saint-Jean-Saint-Maurice-sur-Loire acaba de finalizar su proyecto de sendero de los pintores.\r\nVenga a descubrir un recorrido de 19 etapas que evoca a pintores célebres de la región de Roannais."
    ],
    "nl": [
      "De vereniging Vrienden van Saint-Jean-Saint-Maurice-sur-Loire heeft zojuist haar project voor een schildersroute afgerond.\r\nOntdek een route van 19 etappes langs beroemde schilders uit de Roannais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Chemin des Peintres"
    ]
  },
