  "rdfs:comment": {
    "de": [
      "La Scala, ein Zwischenstopp, den Sie nicht verpassen sollten. Genießen Sie einen Moment des Genusses mit Martine und Serge, die Sie mit ihrer hausgemachten Küche aus frischen und hochwertigen Produkten verwöhnen werden."
    ],
    "en": [
      "La Scala is a must-see in order to share a good moment with Martine and Serge who will serve you with their home food."
    ],
    "it": [
      "La Scala, una tappa da non perdere, un momento di piacere con Martine e Serge che vi delizieranno con la loro cucina casalinga a base di prodotti freschi e di qualità."
    ],
    "fr": [
      "La Scala, une escale à ne pas manquer, un moment de plaisir avec Martine et Serge qui vous feront déguster leur cuisine maison aux produits frais et de qualité."
    ],
    "es": [
      "La Scala, una parada ineludible, un momento de placer con Martine y Serge que le deleitarán con su cocina casera a base de productos frescos y de calidad."
    ],
    "nl": [
      "La Scala, een stop die je niet mag missen, een moment van plezier met Martine en Serge die je zullen verrukken met hun thuiskeuken op basis van verse kwaliteitsproducten."
    ]
  },
  "rdfs:label": {
