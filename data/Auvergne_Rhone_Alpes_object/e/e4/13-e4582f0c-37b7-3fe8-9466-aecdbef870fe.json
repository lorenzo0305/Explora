  "rdfs:comment": {
    "de": [
      "In einem eleganten Rahmen wird französische Küche mit Aromen von gestern und heute serviert. In der schönen Jahreszeit Mittag- und Abendessen auf der Terrasse."
    ],
    "en": [
      "In a stylish ambiance, french cuisine with past and present flavours. Lunch and dîner on the terrace in the summer months. Menu with salads during the season."
    ],
    "it": [
      "In un ambiente elegante, cucina francese con sapori di ieri e di oggi. Pranzo e cena in terrazza nella bella stagione."
    ],
    "fr": [
      "Dans un cadre élégant, une cuisine française aux saveurs d'hier et d'aujourd'hui. Déjeuner et dîner en terrasse à la belle saison."
    ],
    "nl": [
      "In een elegant kader, Franse keuken met smaken van gisteren en vandaag. Lunch en diner op het terras in de zomer. Salades staan op het menu in het seizoen."
    ],
    "es": [
      "En un marco elegante, cocina francesa con sabores de ayer y de hoy. Comidas y cenas en la terraza cuando hace buen tiempo."
    ]
  },
