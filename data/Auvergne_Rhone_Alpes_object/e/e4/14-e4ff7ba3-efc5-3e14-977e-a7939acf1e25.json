      "dc:description": {
        "de": [
          "Ein anderer Verein, ein Ort des Lebens, mit einem Gütesiegel ausgezeichnet, Unterstützung von Schulsportabteilungen.\n\nEine Fußballschule für Jungen und Mädchen ab 5 Jahren."
        ],
        "en": [
          "A different club, a place of life, labelled, supporting school sports sections.\n\nA soccer school for boys and girls from 5 years old."
        ],
        "it": [
          "Un club diverso, un luogo di vita, accreditato, che supporta le sezioni sportive scolastiche.\n\nUna scuola calcio per bambini e bambine a partire dai 5 anni."
        ],
        "fr": [
          "Un club différent, lieu de vie, labellisé, support des sections sportives scolaires.\n\nUne école de football garçons et filles dès 5 ans."
        ],
        "es": [
          "Un club diferente, un lugar de vida, acreditado, que apoya a las secciones deportivas escolares.\n\nUna escuela de fútbol para niños y niñas a partir de 5 años."
        ],
        "nl": [
          "Een andere club, een plek van leven, gelabeld, ondersteuning van schoolsport secties.\n\nEen voetbalschool voor jongens en meisjes vanaf 5 jaar."
        ]
      },
