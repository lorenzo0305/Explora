  "rdfs:comment": {
    "de": [
      "Folk, Pop, Rock, Metal, Elektronik... Es sind schöne musikalische Begegnungen, die Ihnen Le Ciel bietet, immer mit dem Ziel, die spannendsten Künstler der internationalen Musikszene aus allen Bereichen zu entdecken."
    ],
    "en": [
      "Folk, pop, rock, metal, electronica... Le Ciel offers a wide range of musical events, always with the aim of discovering the most exciting artists on the international music scene, from all horizons."
    ],
    "it": [
      "Folk, pop, rock, metal, elettronica? Il Ciel offre un'ampia gamma di eventi musicali, sempre con l'obiettivo di scoprire gli artisti più interessanti della scena musicale internazionale, indipendentemente dal loro background."
    ],
    "fr": [
      "Folk, pop, rock, métal, électronique… Ce sont de beaux rendez-vous musicaux que vous propose le Ciel, avec toujours cette volonté de faire découvrir les artistes les plus passionnants de la scène musicale internationale, tous horizons confondus."
    ],
    "nl": [
      "Folk, pop, rock, metal, elektronisch? De Ciel biedt u een breed scala aan muzikale evenementen, altijd met als doel de meest opwindende artiesten van de internationale muziekscene te ontdekken, ongeacht hun achtergrond."
    ],
    "es": [
      "Folk, pop, rock, metal, electrónica... Le Ciel le ofrece una amplia gama de eventos musicales, siempre con el objetivo de presentarle a los artistas más apasionantes del panorama musical internacional, de todos los ámbitos."
    ]
  },
