  "rdfs:comment": {
    "de": [
      "Als Technikerin für Umwelt und nachhaltige Entwicklung bin ich Naturanimateurin in Savoyen und biete Animationen und Naturworkshops zum Thema Biodiversität an."
    ],
    "en": [
      "As an environmental and sustainable development technician, I work as a nature organizer in Savoie, offering activities and nature workshops on biodiversity."
    ],
    "it": [
      "Come tecnico dell'ambiente e dello sviluppo sostenibile, lavoro come facilitatore naturalistico in Savoia e propongo eventi e laboratori naturalistici sulla biodiversità."
    ],
    "fr": [
      "Technicienne en environnement et développement durable, je suis animatrice nature en Savoie et propose des animations et des ateliers nature sur la biodiversité."
    ],
    "es": [
      "Como técnico en medio ambiente y desarrollo sostenible, trabajo como animador de naturaleza en Saboya y ofrezco eventos y talleres de naturaleza sobre biodiversidad."
    ],
    "nl": [
      "Als technicus op het gebied van milieu en duurzame ontwikkeling werk ik als natuurbegeleider in de Savoie en bied ik evenementen en natuurworkshops aan over biodiversiteit."
    ]
  },
