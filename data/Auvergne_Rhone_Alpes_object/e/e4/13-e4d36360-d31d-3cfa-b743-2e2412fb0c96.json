  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen: Jungpflanzen von Sträuchern oder Obstbäumen, von winterharten Sorten, die im Freiland angebaut werden (mit nackten Wurzeln geliefert); Kräutertees und andere Zubereitungen aus Heil- und Gewürzpflanzen; und Kastanien."
    ],
    "en": [
      "We offer: young plants of hardy varieties of shrubs or fruit trees, grown in the ground (delivered bare-rooted); herbal teas and other preparations based on medicinal and aromatic plants; and chestnuts."
    ],
    "it": [
      "Offriamo: giovani piante di arbusti resistenti o alberi da frutto, coltivate in piena terra (consegnate a radice nuda); tisane e altri preparati a base di piante medicinali e aromatiche; castagne."
    ],
    "fr": [
      "Nous vous proposons : de jeunes plants d'arbustes ou d'arbres fruitiers, de variétés rustiques, cultivés en pleine terre (livrés à racines nues) ; des tisanes et autres préparations à base de plantes médicinales et aromatiques ; et des châtaignes."
    ],
    "nl": [
      "We bieden: jonge planten van winterharde struiken of fruitbomen, gekweekt in de grond (geleverd met blote wortel); kruidenthee en andere preparaten op basis van geneeskrachtige en aromatische planten; en kastanjes."
    ],
    "es": [
      "Ofrecemos: plantas jóvenes de arbustos resistentes o árboles frutales, cultivadas en el suelo (entregadas a raíz desnuda); infusiones y otros preparados a base de plantas medicinales y aromáticas; y castañas."
    ]
  },
