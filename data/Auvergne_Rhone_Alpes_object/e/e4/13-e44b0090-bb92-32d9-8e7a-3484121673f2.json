  "rdfs:comment": {
    "de": [
      "Mit Blick auf den Plomb du Cantal entdecken Sie dieses große Bar-Restaurant und seine herrliche Südterrasse am Fuße der Pisten. Hier ist alles von \"hausgemachter\" Qualität."
    ],
    "en": [
      "Facing the Plomb du Cantal, discover this large, fully-renovated bar-restaurant and its magnificent south-facing terrace at the foot of the slopes. Here, everything is \"home-made\" quality."
    ],
    "it": [
      "Di fronte alla Plomb du Cantal, scoprite questo grande bar-ristorante e la sua magnifica terrazza esposta a sud, ai piedi delle piste. Tutto è di qualità e fatto in casa."
    ],
    "fr": [
      "Face au Plomb du Cantal, découvrez ce grand bar restaurant et sa magnifique terrasse plein sud au pied des pistes. Ici tout est de qualité \"Fait maison\"."
    ],
    "nl": [
      "Ontdek dit geweldige bar-restaurant met uitzicht op de Plomb du Cantal en zijn prachtige terras op het zuiden aan de voet van de pistes. Alles is hier van huisgemaakte kwaliteit."
    ],
    "es": [
      "Frente al Plomb du Cantal, descubra este gran bar-restaurante y su magnífica terraza orientada al sur, a pie de pistas. Aquí todo es casero y de calidad."
    ]
  },
  "rdfs:label": {
