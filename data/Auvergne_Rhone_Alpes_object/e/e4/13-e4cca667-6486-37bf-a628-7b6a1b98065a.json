  "rdfs:comment": {
    "de": [
      "Verkauf von Produkten vom Bauernhof. Käse, Wurstwaren, Eier und biologische Produkte. Sie können den Hof besuchen und unsere köstlichen Produkte mittwochs von 16 bis 18 Uhr kaufen."
    ],
    "en": [
      "Sale of farm products, cheese, charcuterie, eggs and organic products. You can visit the farm and buy our delicious products on wednesday & saturday from 4pm to 6pm."
    ],
    "it": [
      "Vendita di prodotti agricoli. Formaggi, salumi, uova e prodotti biologici. È possibile visitare la fattoria e acquistare i nostri deliziosi prodotti il mercoledì e il sabato dalle 16.00 alle 18.00."
    ],
    "fr": [
      "Vente des produits de la ferme. Fromages, charcuteries, oeufs et produits biologiques. Vous pouvez venir visiter la ferme, et acheter nos délicieux produits le mercredi et le samedi de 16h à 18h."
    ],
    "nl": [
      "Verkoop van boerderijproducten. Kazen, charcuteries, eieren en biologische producten. Je kunt de boerderij bezoeken en onze heerlijke producten kopen op woensdag van 16.00 tot 18.00 uur."
    ],
    "es": [
      "Venta de productos agrícolas. Quesos, embutidos, huevos y productos ecológicos. Puede visitar la granja y comprar nuestros deliciosos productos los miércoles y sábados de 16:00 a 18:00."
    ]
  },
