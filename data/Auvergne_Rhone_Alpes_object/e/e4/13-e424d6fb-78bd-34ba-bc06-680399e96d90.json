  "rdfs:comment": {
    "de": [
      "Dorf Arlet: Kirche aus dem 12. Jahrhundert mit Kammglockenturm, romanischem Christus am Kreuz. Jahrhundert. Schönes Triptychon \"Le pardon d'Arlet\" aus dem 16. Observatorium für röhrende Hirsche gegenüber dem Dorf Arlet (Wald von Combeneyre mit seinen Hirschen)."
    ],
    "en": [
      "Village of Arlet: 12th-century church with combed bell tower, Romanesque Christ on the Cross. Beautiful 16th-century triptych \"Le pardon d'Arlet\". Deer bellowing observatory opposite the village of Arlet (Combeneyre forest with its deer)."
    ],
    "it": [
      "Villaggio di Arlet: chiesa del XII secolo con campanile a pettine, Cristo in croce romanico. Bellissimo trittico \"Le pardon d'Arlet\" del XVI secolo. Osservatorio del muggito dei cervi di fronte al villaggio di Arlet (foresta di Combeneyre con i suoi cervi)."
    ],
    "fr": [
      "Village d'Arlet : Église du XIIe siècle avec clocher peigne, Christ en croix roman. Beau triptyque « Le pardon d’Arlet » XVIe siècle. Observatoire du brame du cerf face au village d’Arlet (forêt de Combeneyre avec ses cervidés)."
    ],
    "es": [
      "Pueblo de Arlet: iglesia del siglo XII con campanario peinado, Cristo en la Cruz románico. Precioso tríptico \"Le pardon d'Arlet\" del siglo XVI. Observatorio de la berrea del ciervo frente al pueblo de Arlet (bosque de Combeneyre con sus ciervos)."
    ],
    "nl": [
      "Dorp Arlet: 12e-eeuwse kerk met gekamde klokkentoren, Romaanse Christus aan het Kruis. Prachtig drieluik \"Le pardon d'Arlet\" 16e eeuw. Waarnemingspost voor herten tegenover het dorp Arlet (bos van Combeneyre met zijn herten)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Arlet"
    ]
  },
