          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "letzte Abfahrt um 19:10 Uhr\r\nDienstag und Freitag ab 9:15 Uhr geöffnet.\r\n\r\nVom 7. Juli bis 16. August: Durchgehender Tag dienstags und freitags von 9.15 Uhr bis 19.10 Uhr.\r\n\r\nFeuerwerk am 14. Juli und 15. August: Verlängerte Öffnungszeiten von 19:30 bis 0:45 Uhr im Direktverkehr (kein Halt an den Zwischenbahnhöfen)."
            ],
            "en": [
              "last departure at 7.10pm\r\nOpen Tuesday and Friday from 9:15 am.\r\n\r\nFrom July 7 to August 16: all-day opening on Tuesdays and Fridays from 9:15 a.m. to 7:10 p.m.\r\n\r\nFireworks displays on July 14 and August 15: Extended opening from 7.30pm to 0.45am on direct routes (no stops at intermediate stations)."
            ],
            "it": [
              "ultima partenza alle 19.10\r\nAperto il martedì e il venerdì dalle 9.15.\r\n\r\nDal 7 luglio al 16 agosto: tutto il giorno il martedì e il venerdì dalle 9.15 alle 19.10.\r\n\r\nFuochi d'artificio il 14 luglio e il 15 agosto: apertura prolungata dalle 19.30 alle 0.45 sulle linee dirette (senza fermate nelle stazioni intermedie)."
            ],
            "fr": [
              "dernier départ à 19h10\r\nOuvert le mardi et vendredi dès 9h15.\r\n\r\nDu 7 juillet au 16 août : journée continue les mardis et vendredis de 9h15 à 19h10.\r\n\r\nFeux d'artifice du 14 juillet et du 15 août : Ouverture prolongée de 19h30 à 0h45 en trajet direct (pas d'arrêt sur les gares intermédiaires)."
            ],
            "nl": [
              "laatste vertrek om 19.10 uur\r\nDinsdag en vrijdag geopend vanaf 9.15 uur.\r\n\r\nVan 7 juli tot 16 augustus: dinsdag en vrijdag de hele dag van 9.15 tot 19.10 uur.\r\n\r\nVuurwerkshows op 14 juli en 15 augustus: verlengde opening van 19.30 tot 0.45 uur op rechtstreekse routes (geen stops op tussenliggende stations)."
            ],
            "es": [
              "última salida a las 19.10 h\r\nAbierto martes y viernes a partir de las 9.15 h.\r\n\r\nDel 7 de julio al 16 de agosto: martes y viernes todo el día de 9.15 a 19.10 h.\r\n\r\nEspectáculos pirotécnicos los días 14 de julio y 15 de agosto: apertura ampliada de 19.30 h a 0.45 h en las líneas directas (sin paradas en estaciones intermedias)."
            ]
          },
