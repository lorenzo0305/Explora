  "rdfs:comment": {
    "de": [
      "Entre Lacs et Collines, Ihre Feinschmeckerpause an den Toren der Grandes Alpes. Entre Lacs et Collines liegt nur wenige Schritte vom Lac d'Aiguebelette entfernt und auf dem Weg zu den großen Skistationen."
    ],
    "en": [
      "Just a stone’s throw from the lac d'Aiguebelette and on the road to the major ski resorts, Entre Lacs et Collines is the perfect stop for a warm and welcoming break before heading up to the peaks."
    ],
    "it": [
      "Entre Lacs et Collines, la vostra tappa gastronomica alle porte delle Grandes Alpes. A due passi dal Lac d'Aiguebelette e sulla strada per le principali stazioni sciistiche, Entre Lacs et Collines è il luogo ideale per una pausa calda prima di partire per le vette."
    ],
    "fr": [
      "Entre Lacs et Collines, votre halte gourmande aux portes des Grandes Alpes. À deux pas du lac d’Aiguebelette et sur la route des grandes stations de ski, Entre Lacs et Collines est l’étape idéale pour une pause chaleureuse avant de rejoindre les sommets."
    ],
    "nl": [
      "Entre Lacs et Collines, uw gastronomische tussenstop aan de poort van de Grandes Alpes. Op een steenworp afstand van het Lac d'Aiguebelette en op de weg naar de grote skigebieden is Entre Lacs et Collines de ideale plek voor een warme pauze voordat je naar de toppen gaat."
    ],
    "es": [
      "Entre Lacs et Collines, su parada gastronómica a las puertas de los Grandes Alpes. A dos pasos del lago de Aiguebelette y en la carretera que lleva a las principales estaciones de esquí, Entre Lacs et Collines es el lugar ideal para hacer una cálida pausa antes de dirigirse a las cumbres."
    ]
  },
