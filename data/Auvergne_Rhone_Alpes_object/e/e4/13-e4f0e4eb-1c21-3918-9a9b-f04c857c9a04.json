  "rdfs:comment": {
    "de": [
      "Archivmaterial und alte Bücher können vor Ort während der Öffnungszeiten oder nach Vereinbarung eingesehen werden. Es finden auch Vorträge, Poesie- und Literaturtreffen statt."
    ],
    "en": [
      "Archive documents and antiquarian books can be consulted on site during opening hours or by appointment. Conferences, poetry readings and literary events are also held here."
    ],
    "it": [
      "Documenti d'archivio e libri antichi possono essere consultati in loco durante gli orari di apertura o su appuntamento. Qui si tengono anche conferenze, letture di poesie ed eventi letterari."
    ],
    "fr": [
      "Les documents d’archives et les livres anciens sont consultables sur place aux horaires d’ouverture ou sur rendez-vous. Conférences, rencontres poétiques et littéraires s’y déroulent."
    ],
    "es": [
      "Los documentos de archivo y los libros antiguos pueden consultarse in situ en horario de apertura o con cita previa. También se organizan conferencias, recitales de poesía y actos literarios."
    ],
    "nl": [
      "Archiefstukken en oude boeken kunnen ter plekke worden geraadpleegd tijdens openingstijden of op afspraak. Er worden hier ook lezingen, poëzievoordrachten en literaire evenementen gehouden."
    ]
  },
