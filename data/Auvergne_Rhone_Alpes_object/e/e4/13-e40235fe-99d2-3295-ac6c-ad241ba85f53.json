  "rdfs:comment": {
    "de": [
      "Die Tour Auvergne Rhône Alpes wird dieses Jahr im Beaufortain Station machen. Die letzte Etappe startet in Beaufort und führt über den Anstieg von Bisanne zum Plateau de Solaison. Die Fahrer werden Les Saisies durchqueren."
    ],
    "en": [
      "This year's Tour Auvergne Rhône Alpes will stop off in the Beaufortain region. The final stage will start in Beaufort and take in the Plateau de Solaison via the Bisanne climb. The riders will cross Les Saisies."
    ],
    "it": [
      "Il Tour Auvergne Rhône Alpes farà tappa quest'anno a Beaufortain. L'ultima tappa partirà da Beaufort per raggiungere il Plateau de Solaison attraverso la salita di Bisanne. I corridori attraverseranno Les Saisies."
    ],
    "fr": [
      "Le Tour Auvergne Rhône Alpes fera étape cette année dans le Beaufortain. La dernière étape s'élancera de Beaufort pour rejoindre le Plateau de Solaison en empruntant la montée de Bisanne. Les coureurs traverseront les Saisies."
    ],
    "es": [
      "El Tour Auvergne Rhône Alpes hará escala este año en la región de Beaufortain. La última etapa comenzará en Beaufort y recorrerá el Plateau de Solaison por la subida de Bisanne. Los ciclistas atravesarán Les Saisies."
    ],
    "nl": [
      "De Tour Auvergne Rhône Alpes houdt dit jaar halt in Beaufortain. De laatste etappe start in Beaufort en gaat over het Plateau de Solaison via de beklimming van Bisanne. De renners doorkruisen Les Saisies."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Passage de la dernière étape du Tour Auvergne Rhône-Alpes"
    ]
  },
