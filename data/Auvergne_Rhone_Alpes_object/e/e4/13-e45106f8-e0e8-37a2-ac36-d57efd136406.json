  "rdfs:comment": {
    "de": [
      "Das Angeln in Valloire ist eine Einladung zum Entdecken, Entspannen und zum Respekt vor der Natur. Angeln kann man in der Valloirette, der Neuvachette und im Lac des Cerces."
    ],
    "en": [
      "Fishing in Valloire is an invitation to discover, relax and respect nature. You can fish in the Valloirette, Neuvachette and Cerces lakes."
    ],
    "it": [
      "La pesca in Valloire è un invito alla scoperta, al relax e al rispetto della natura. È possibile pescare nei laghi Valloirette, Neuvachette e Cerces."
    ],
    "fr": [
      "La pêche à Valloire est une invitation à la découverte, à la détente et au respect de la nature. Il est possible de pêcher dans la Valloirette, la Neuvachette et le lac des Cerces."
    ],
    "nl": [
      "Vissen in Valloire is een uitnodiging om de natuur te ontdekken, te ontspannen en te respecteren. Je kunt vissen in de meren van Valloirette, Neuvachette en Cerces."
    ],
    "es": [
      "Pescar en Valloire es una invitación a descubrir, relajarse y respetar la naturaleza. Puede pescar en los lagos de Valloirette, Neuvachette y Cerces."
    ]
  },
