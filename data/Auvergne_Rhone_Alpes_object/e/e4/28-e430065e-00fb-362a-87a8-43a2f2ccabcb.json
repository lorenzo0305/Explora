      "rdfs:comment": {
        "de": [
          "Lernen Sie die Ziegen von Nathalie kennen, die sich mit viel Herzblut um sie kümmert. Eine gute Gelegenheit, um den guten Ziegenkäse zu probieren.\nZugang nach Vereinbarung"
        ],
        "en": [
          "Come and meet Nathalie's goats, who takes good care of them, a great opportunity to come and taste the good goat cheese.\nAccess by appointment"
        ],
        "it": [
          "Venite a conoscere le capre di Nathalie, di cui si prende molta cura, e a degustare il buon formaggio di capra.\nAccesso su appuntamento"
        ],
        "fr": [
          "Venez à la rencontre des chèvres de Nathalie qui a cœur d'en prendre soin, une belle occasion de venir déguster les bons fromages de chèvres.\nAccès sur rendez-vous"
        ],
        "es": [
          "Venga a conocer a las cabras de Nathalie, a las que cuida mucho, y venga a degustar el buen queso de cabra.\nAcceso con cita previa"
        ],
        "nl": [
          "Kom kennismaken met de geiten van Nathalie, die zij met veel zorg verzorgt, en kom de lekkere geitenkaas proeven.\nToegang op afspraak"
        ]
      },
