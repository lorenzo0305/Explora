  "rdfs:comment": {
    "de": [
      "Das Maison du Salève ist ein lebendiger und geselliger Ort, an dem man die Geschichte und das Kulturerbe des Salève-Massivs im Rahmen von Ausstellungen, Workshops, Führungen, Entdeckungspfaden, Vorträgen und sogar Geburtstagsfeiern kennenlernen kann."
    ],
    "en": [
      "The Maison du Salève is a lively, friendly place where you can discover the history and heritage of the Salève massif through exhibitions, workshops, guided tours, discovery trails, conferences and even anniversaries."
    ],
    "it": [
      "La Maison du Salève è un luogo vivace e accogliente dove scoprire la storia e il patrimonio del massiccio della Salève attraverso mostre, laboratori, visite guidate, percorsi di scoperta, conferenze e persino anniversari."
    ],
    "fr": [
      "La Maison du Salève est un lieu vivant et convivial où l'on peut découvrir l'histoire et le patrimoine du massif du Salève à travers des expositions, des ateliers, des visites guidées, des parcours de découverte, des conférences et même des anniversaires."
    ],
    "es": [
      "La Maison du Salève es un lugar vivo y acogedor donde podrá descubrir la historia y el patrimonio del macizo del Salève a través de exposiciones, talleres, visitas guiadas, recorridos de descubrimiento, conferencias e incluso aniversarios."
    ],
    "nl": [
      "Het Maison du Salève is een levendige, gezellige plek waar je de geschiedenis en het erfgoed van het massief van de Salève kunt ontdekken via tentoonstellingen, workshops, rondleidingen, ontdekkingsroutes, conferenties en zelfs jubilea."
    ]
  },
