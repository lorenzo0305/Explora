  "rdfs:comment": {
    "de": [
      "Für Anfänger und fortgeschrittene Bogenschützen bei einem Spaziergang im Wald oder auf einem festen Stand. Ein Betreuer bringt Ihnen in geselliger Runde die Schießtechnik bei."
    ],
    "en": [
      "For beginner and experienced archers, whether you are walking in the forest or at a fixed shooting range. An instructor will teach you shooting techniques in a friendly atmosphere."
    ],
    "it": [
      "Per principianti e arcieri esperti, su una passeggiata nel bosco o su uno stand fisso. Un istruttore vi insegnerà le tecniche di tiro in un'atmosfera amichevole."
    ],
    "fr": [
      "Pour les archers débutants et confirmés en vous promenant en forêt ou sur un stand fixe. Un moniteur vous enseigne la technique de tir en toute convivialité."
    ],
    "nl": [
      "Voor zowel beginners als ervaren boogschutters, tijdens een boswandeling of op een vaste standaard. Een instructeur leert je schiettechnieken in een vriendelijke sfeer."
    ],
    "es": [
      "Tanto para principiantes como para arqueros experimentados, en un paseo por el bosque o en un puesto fijo. Un instructor te enseñará las técnicas de tiro en un ambiente agradable."
    ]
  },
