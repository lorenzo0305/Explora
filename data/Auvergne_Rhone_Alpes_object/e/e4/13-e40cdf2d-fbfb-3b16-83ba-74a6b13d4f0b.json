  "rdfs:comment": {
    "de": [
      "Kommen Sie die vom Maison Giraudet gefertigten Quenelles (Hechtklößchen) mit Flusskrebsen, Hecht, Trüffeln etc. aber auch die Suppen der Saison probieren."
    ],
    "en": [
      "Come along and tuck into the quenelles made by Maison Giraudet, with crayfish, with pike, with truffles, etc., Nantua, tomato or financière sauces and seasonal soups."
    ],
    "it": [
      "Vieni a degustare le quenelle realizzate dalla Maison Giraudet: ai gamberi, al luccio, ai tartufi... ed anche le zuppe di stagione."
    ],
    "fr": [
      "Spécialiste de la quenelle moulée à la cuillère, la Maison Giraudet c'est aussi des sauces et soupes fraîches, ainsi que des ravioles artisanales. Elle vous propose dans ses boutiques de découvrir tout son savoir faire, à déguster sur place ou à emporter."
    ],
    "nl": [
      "Maison Giraudet, gespecialiseerd in lepelvormige quenelles, produceert ook verse sauzen en soepen en huisgemaakte ravioli. In zijn winkels biedt hij u de mogelijkheid al zijn knowhow te ontdekken, ter plaatse te proeven of mee te nemen."
    ],
    "es": [
      "La Maison Giraudet elabora deliciosas quenelles de cangrejo, lucio, trufa, etc., así como sabrosas sopas de temporada."
    ]
  },
