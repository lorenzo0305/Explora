  "rdfs:comment": {
    "de": [
      "Eine schöne Aussicht auf das Dorf, ein Essen im Restaurant, Naturweine zum Probieren an der Bar, eine Partie Tischfußball auf der Terrasse, ein Frühstück wie auf dem Bauernhof, etc."
    ],
    "en": [
      "A beautiful view of the village, a meal in the restaurant, natural wines to taste in the bar, a game of table soccer on the terrace, a farm-style breakfast, and so on."
    ],
    "it": [
      "Una bella vista sul paese, un pasto al ristorante, vini naturali da degustare al bar, una partita a calcio balilla sulla terrazza, una colazione in stile agriturismo e così via."
    ],
    "fr": [
      "Une belle vue sur le village, un repas au restaurant, des vins natures à déguster au bar, une partie de baby foot en terrasse, un petit déjeuner comme à la ferme, etc."
    ],
    "es": [
      "Una hermosa vista del pueblo, una comida en el restaurante, vinos naturales para degustar en el bar, una partida de futbolín en la terraza, un desayuno al estilo de la granja, etc."
    ],
    "nl": [
      "Een prachtig uitzicht op het dorp, een maaltijd in het restaurant, natuurlijke wijnen om te proeven in de bar, een spelletje tafelvoetbal op het terras, een ontbijt op de boerderij, enzovoort."
    ]
  },
  "rdfs:label": {
