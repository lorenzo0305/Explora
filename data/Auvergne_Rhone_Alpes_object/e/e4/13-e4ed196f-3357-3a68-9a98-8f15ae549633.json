  "rdfs:comment": {
    "de": [
      "Arthouse-Kino mit 180 Plätzen, ausgestattet mit digitaler 2D- und 3D-Technik. Ein anspruchsvolles Programm in einem geselligen Rahmen für alle Liebhaber der siebten Kunst.\r\nProgramm verfügbar unter http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ],
    "en": [
      "180-seat arthouse cinema, equipped with 2D and 3D digital technology. Demanding programming in a friendly setting for all lovers of the 7th art.\r\nProgram available at http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ],
    "it": [
      "Cinema d'essai con 180 posti a sedere, dotato di tecnologia digitale 2D e 3D. Un programma impegnativo in un ambiente amichevole per tutti gli amanti della settima arte.\r\nProgramma disponibile su http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ],
    "fr": [
      "Cinéma Art et Essai de 180 places, équipé en numérique 2D et 3D. Une programmation exigeante dans un cadre convivial pour tous les amoureux du 7ème art.\r\nProgramme disponible sur http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ],
    "es": [
      "Cine de arte y ensayo con 180 butacas, equipado con tecnología digital 2D y 3D. Una programación exigente en un marco acogedor para todos los amantes del séptimo arte.\r\nPrograma disponible en http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ],
    "nl": [
      "Art house bioscoop met 180 zitplaatsen, uitgerust met 2D en 3D digitale technologie. Een veeleisend programma in een vriendelijke omgeving voor alle liefhebbers van de 7e kunst.\r\nProgramma beschikbaar op http://www.allocine.fr/seance/salle_gen_csalle=W0517.html"
    ]
  },
