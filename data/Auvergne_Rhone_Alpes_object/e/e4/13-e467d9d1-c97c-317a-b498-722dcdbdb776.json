  "rdfs:comment": {
    "de": [
      "Magische Momente, eine unvergessliche Erfahrung - ein Flug mit dem Gleitschirm oder dem Ultraleichtflugzeug über dem Cantal-Vulkangebirge."
    ],
    "en": [
      "A magical moment, an unforgettable experience : a baptismal flight in a paraglider or a microlight above the Cantal’s volcano. Baptismal flights for everyone"
    ],
    "it": [
      "Istruttori professionisti vi accompagneranno in tutta sicurezza per un'esperienza indimenticabile sopra i Monts du Cantal. Oltre 30 anni di esperienza nel parapendio. Siti eccezionali e sensazioni magiche garantite."
    ],
    "fr": [
      "Des moniteurs professionnels vous emmènent en toute sécurité pour une découverte inoubliable au-dessus des Monts du Cantal, un moment magique. Plus de 30 ans d'expérience dans le parapente. Sites exceptionnels et sensations magiques garantis."
    ],
    "nl": [
      "Professionele instructeurs nemen u in alle veiligheid mee voor een onvergetelijke ervaring boven de Monts du Cantal. Meer dan 30 jaar ervaring in paragliding. Uitzonderlijke plaatsen en magische sensaties gegarandeerd."
    ],
    "es": [
      "Instructores profesionales le llevarán con total seguridad a vivir una experiencia inolvidable por encima de los Montes del Cantal. Más de 30 años de experiencia en parapente. Lugares excepcionales y sensaciones mágicas garantizadas."
    ]
  },
