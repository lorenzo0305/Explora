  "rdfs:comment": {
    "de": [
      "Die Ludothek von Thonon-les-bains ist ein Ausleihservice für Spiele und Spielsachen. Die Ludothek steht allen offen, Kindern und Erwachsenen sowie Kindertagesstätten, Kinderkrippen und Schulen..."
    ],
    "en": [
      "The Ludothèque de Thonon-les-bains is a lending service for games and toys. The Ludotheque is open to all, children and adults, as well as day-care centers, nurseries and schools..."
    ],
    "it": [
      "La Ludoteca di Thonon-les-bains è un servizio di prestito di giochi e giocattoli. La ludoteca è aperta a tutti, bambini e adulti, nonché agli asili nido, alle scuole materne e alle scuole..."
    ],
    "fr": [
      "La Ludothèque de Thonon-les-bains est un service de prêt de jeux et de jouets. La Ludothèque est ouverte à tous, enfants et adultes, ainsi qu'aux garderies, créches et écoles..."
    ],
    "es": [
      "La Ludoteca de Thonon-les-bains es un servicio de préstamo de juegos y juguetes. La ludoteca está abierta a todos, niños y adultos, así como a guarderías, escuelas infantiles y colegios..."
    ],
    "nl": [
      "De Ludotheek van Thonon-les-bains is een uitleendienst voor spelletjes en speelgoed. De speelgoedbibliotheek staat open voor iedereen, kinderen en volwassenen, maar ook voor kinderdagverblijven, kleuterscholen en scholen..."
    ]
  },
