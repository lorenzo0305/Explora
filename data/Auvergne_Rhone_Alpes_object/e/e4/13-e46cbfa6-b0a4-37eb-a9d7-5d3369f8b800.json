  "rdfs:comment": {
    "de": [
      "Angeln am Lac du Bourget, dem größten natürlichen See Frankreichs 18 km lang und 4460 ha groß. 33 Fischarten, darunter Forelle, Saibling, Felchen, Barsch, Zander. See der 1. Kategorie, öffentlicher Bereich."
    ],
    "en": [
      "Fishing on the Lac du Bourget, the largest natural lake in France, 18 km long, with a surface area of 4,460 ha. and 33 fish species, including brown trout, whitefish, perch and pikeperch. This is a 1st category public domain lake."
    ],
    "it": [
      "Pesca al lago del Bourget, il più grande lago naturale della Francia: 18 km di lunghezza per 4460 ha. 33 specie di pesci come la trota, il salmerino alpino, il coregone, il pesce persico, il lucioperca. Lago di prima categoria, area pubblica."
    ],
    "fr": [
      "Pêche au lac du Bourget, le plus grand lac naturel de France 18 km de long sur 4460 ha. 33 espèces piscicoles dont la truite, l'omble chevalier, le corégone, la perche, le sandre. Lac de 1ère catégorie, domaine public."
    ],
    "nl": [
      "Vissen in Lac du Bourget, het grootste natuurlijke meer van Frankrijk, 18 km lang en 4.460 ha groot. 33 vissoorten, waaronder forel, riddervis, witvis, baars en snoekbaars. Meer van de 1e categorie, publiek domein."
    ],
    "es": [
      "Pesca en el Lac du Bourget, el mayor lago natural de Francia, con 18 km de largo y 4.460 ha. 33 especies de peces, entre ellas trucha, trucha alpina, pez blanco, perca y lucioperca. Lago de 1ª categoría, dominio público."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at Bourget lake"
    ],
    "it": [
      "Pesca sul lago del Bourget"
    ],
    "fr": [
      "Pêche au lac du Bourget"
    ],
    "nl": [
      "Vissen bij Lac du Bourget"
    ]
  },
