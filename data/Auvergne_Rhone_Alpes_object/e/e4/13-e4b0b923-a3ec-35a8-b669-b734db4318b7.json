  "rdfs:comment": {
    "de": [
      "Restaurant, Pizzeria, Holzofengrill, Panoramablick. Maryse bereitet vor den Augen ihrer Gäste köstliche Pizzas zu. Italienische und savoyardische Küche."
    ],
    "en": [
      "Restaurant, pizzeria, wood-fired grill, panoramic views. Maryse makes her own pizza dough, which she leaves to rise. Every day throughout the season, she prepares delicious pizzas in front of you - all part of the entertainment!"
    ],
    "it": [
      "Ristorante, pizzeria, griglia a legna, vista panoramica Ogni giorno della stagione, Maryse prepara le sue deliziose pizze davanti a voi. Cucina italiana e savoiarda."
    ],
    "fr": [
      "Restaurant, pizzeria, grill au feu de bois, vue panoramique.Chaque jour de la saison, Maryse prépare ses délicieuses pizzas devant vous. Cuisine italienne et savoyarde."
    ],
    "es": [
      "Restaurante, pizzería, parrilla de leña, vista panorámica Todos los días de la temporada, Maryse prepara sus deliciosas pizzas delante de usted. Cocina italiana y saboyana."
    ],
    "nl": [
      "Restaurant, pizzeria, houtgestookte grill, panoramisch uitzicht Elke dag van het seizoen bereidt Maryse haar heerlijke pizza's voor u. Italiaanse en Savoyaardse keuken."
    ]
