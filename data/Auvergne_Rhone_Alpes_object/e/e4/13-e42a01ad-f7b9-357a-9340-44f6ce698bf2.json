  "rdfs:comment": {
    "de": [
      "Chez Flo empfängt Sie auf seinen sonnigen Terrassen oder rund um seine festliche Rundbar. Entdecken Sie eine abwechslungsreiche Bergküche: Tartiflette, Fleischgerichte, Fisch, Pasta und Käsespezialitäten. Mit Skiern an den Füßen erreichbar! Abends geschlossen."
    ],
    "en": [
      "Chez Flo welcomes you on its sunny terraces or around its lively circular bar. Discover a varied mountain-style cuisine: tartiflettes, meat dishes, fish, pasta, and cheese specialties. Ski-in, ski-out access! Closed in the evening."
    ],
    "it": [
      "Chez Flo vi accoglie sulle sue terrazze soleggiate o intorno al suo festoso bar circolare. Scoprite la varietà della cucina di montagna: tartiflettes, piatti di carne, pesce, pasta e specialità di formaggio. Si entra e si esce con gli sci! Chiuso la sera."
    ],
    "fr": [
      "Chez Flo vous accueille sur ses terrasses ensoleillées ou autour de son bar circulaire festif. Découvrez une cuisine montagnarde variée : tartiflettes, plats de viande, poisson, pâtes et spécialités fromagères. Accessible skis aux pieds ! Fermé le soir."
    ],
    "nl": [
      "Chez Flo verwelkomt u op zijn zonnige terrassen of rond de feestelijke ronde bar. Ontdek een gevarieerde bergkeuken: tartiflettes, vleesgerechten, vis, pasta en kaasspecialiteiten. Direct bereikbaar op ski’s! ’s Avonds gesloten."
    ],
    "es": [
      "Chez Flo le da la bienvenida en sus soleadas terrazas o alrededor de su festivo bar circular. Descubra una variada cocina de montaña: tartiflettes, platos de carne, pescado, pasta y especialidades de queso. ¡Ski in, ski out! Cerrado por la noche."
    ]
  },
