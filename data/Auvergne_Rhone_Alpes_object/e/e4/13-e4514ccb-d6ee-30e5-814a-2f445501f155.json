  "rdfs:comment": {
    "de": [
      "Eine umweltfreundliche Entdeckung der Berge. Die Wanderungen zu Fuß oder mit Schneeschuhen erfolgen, ohne das Auto zu nehmen (mit den öffentlichen Verkehrsmitteln des Großraums Chambéry)."
    ],
    "en": [
      "An environmentally-friendly way to discover the mountains, hiking and snowshoeing can be done without taking the car (using public transport in the Chambéry area)."
    ],
    "it": [
      "Scoprite le montagne in modo ecologico, a piedi o con le racchette da neve, senza prendere l'auto (utilizzando i trasporti pubblici nella zona di Chambéry)."
    ],
    "fr": [
      "Une découverte de la montagne respectueuse de l'environnement, les randonnées à pied ou en raquettes se font sans prendre la voiture  (en utilisant les transports en commun de l'agglomération de Chambéry)."
    ],
    "nl": [
      "Ontdek de bergen op een milieuvriendelijke manier, te voet of met sneeuwschoenen, zonder de auto te nemen (met het openbaar vervoer in de omgeving van Chambéry)."
    ],
    "es": [
      "Descubra la montaña de forma respetuosa con el medio ambiente, a pie o con raquetas de nieve, sin coger el coche (utilizando el transporte público en la zona de Chambéry)."
    ]
  },
  "rdfs:label": {
