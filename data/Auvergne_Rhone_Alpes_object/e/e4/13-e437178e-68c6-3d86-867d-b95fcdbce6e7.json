  "rdfs:comment": {
    "de": [
      "Die Bresse ist ein Muss, ein Spaziergang zu den Bresse-Bauernhöfen mit ihren sarazenischen Schornsteinen, den Nuggets dieser Region und einzigartigen Denkmälern!"
    ],
    "en": [
      "The must-see of Bresse, a walk to discover the Bresse farms with Saracen chimneys, nuggets of this region and unique monuments!"
    ],
    "it": [
      "Gli imperdibili della Bresse, una passeggiata alla scoperta delle fattorie bresciane con i camini saraceni, le pepite di questa regione e monumenti unici!"
    ],
    "fr": [
      "L’incontournable de la Bresse, une balade à la rencontre des fermes bressanes à cheminées sarrasines, pépites de cette région et monuments uniques !"
    ],
    "es": [
      "La visita obligada de Bresse, ¡un paseo para descubrir las granjas de Bresse con chimeneas sarracenas, las pepitas de esta región y monumentos únicos!"
    ],
    "nl": [
      "De must-see van Bresse, een wandeling om de Bresseboerderijen met Saraceense schoorstenen, de klompjes van deze streek en unieke monumenten te ontdekken!"
    ]
  },
  "rdfs:label": {
