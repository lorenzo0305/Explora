  "rdfs:comment": {
    "de": [
      "Das familiengeführte Weingut liegt inmitten der Weinberge der Appellation Saint-Joseph. Die Produzenten Corentin und Richard sind leidenschaftliche Weinkenner, die Sie mit ihren Erklärungen und Verkostungen auf eine Reise in die Welt des Weins mitnehmen."
    ],
    "en": [
      "Family-run wine estate, located in the heart of the Saint-Joseph Appellation vineyards. The producers, Corentin and Richard, are passionate about what they do, and will take you on a journey into the world of wine through their explanations and tastings."
    ],
    "it": [
      "Un'azienda vinicola a conduzione familiare nel cuore dei vigneti della denominazione Saint-Joseph. I produttori, Corentin e Richard, sono appassionati del loro lavoro e vi accompagneranno in un viaggio nel mondo del vino attraverso le loro spiegazioni e degustazioni."
    ],
    "fr": [
      "Domaine viticole familial, situé en plein cœur des vignes de l'Appellation Saint-Joseph. Les producteurs, Corentin et Richard, passionnés par leur métier vous ferons voyager dans le milieu du vin par leur explications mais aussi par la dégustation."
    ],
    "es": [
      "Una explotación vinícola familiar en pleno corazón de los viñedos de la denominación Saint-Joseph. Los productores, Corentin y Richard, apasionados por su trabajo, le harán viajar por el mundo del vino a través de sus explicaciones y degustaciones."
    ],
    "nl": [
      "Een familiaal wijndomein in het hart van de wijngaarden van de Saint-Joseph Appellation. De producenten, Corentin en Richard, zijn gepassioneerd door hun werk en nemen je mee op een reis door de wereld van wijn door middel van hun uitleg en proeverijen."
    ]
  },
  "rdfs:label": {
