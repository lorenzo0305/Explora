  "rdfs:comment": {
    "de": [
      "Die Buchhandlung La Boîte à Soleils bietet Ihnen eine große Auswahl an Büchern, ein sehr umfassendes Sortiment an regionalen Ausgaben, sowie Gesellschaftsspiele und Spielzeug für Erstklässler, Postkarten, Fantasiepapiere und organisiert Veranstaltungen"
    ],
    "en": [
      "La Boîte à Soleils bookstore offers a wide choice of books, a very complete range of regional editions, as well as board games and first age toys, postcards, fancy stationery and organises events"
    ],
    "it": [
      "La libreria Boîte à Soleils offre un'ampia scelta di libri, una gamma molto completa di edizioni regionali, oltre a giochi da tavolo e giocattoli per bambini, cartoline, cartoleria di fantasia e organizza eventi"
    ],
    "fr": [
      "La librairie la Boîte à Soleils vous propose un large choix d'ouvrages, un assortiment très complet des éditions régionales, ainsi que des jeux de société et des jouets premier âge, des cartes postales, de la papeterie fantaisie et organise des animations"
    ],
    "es": [
      "La librería Boîte à Soleils ofrece una amplia selección de libros, una gama muy completa de ediciones regionales, así como juegos de mesa y juguetes para niños pequeños, postales, artículos de papelería de fantasía y organiza eventos"
    ],
    "nl": [
      "De boekhandel Boîte à Soleils biedt een ruime keuze aan boeken, een zeer compleet assortiment regionale uitgaven, maar ook gezelschapsspellen en speelgoed voor jonge kinderen, ansichtkaarten, mooie schrijfwaren en organiseert evenementen"
    ]
  },
