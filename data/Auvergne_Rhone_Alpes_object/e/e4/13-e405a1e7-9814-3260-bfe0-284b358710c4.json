  "rdfs:comment": {
    "de": [
      "Seit mehr als acht Jahren bin ich Gastronomin. Ich wage mich an die mobile Gastronomie, um Ihnen eine kreative Küche mit Produkten aus eigener Herstellung oder von lokalen Produzenten zuzubereiten. Meine Menüs passen sich den Jahreszeiten an."
    ],
    "en": [
      "I've been a restaurateur for over 8 years, and now I'm moving into mobile catering to prepare creative cuisine using products from our own production or from local producers. My menus adapt to the seasons."
    ],
    "it": [
      "Sono ristoratore da più di 8 anni e ora mi occupo di catering mobile per preparare una cucina creativa utilizzando prodotti di nostra produzione o di produttori locali. I miei menu si adattano alle stagioni."
    ],
    "fr": [
      "Restauratrice depuis plus de 8 ans je me lance dans la restauration mobile pour vous préparer une cuisine créative faite avec des produits issus de notre production ou de producteurs locaux. Mes menus s'adaptent au fil des saisons."
    ],
    "es": [
      "Soy restaurador desde hace más de 8 años y ahora trabajo en el sector de la restauración móvil para preparar una cocina creativa con productos de producción propia o de productores locales. Mis menús se adaptan a las estaciones."
    ],
    "nl": [
      "Ik ben al meer dan 8 jaar restauranthouder en nu ben ik begonnen met mobiele catering om je een creatieve keuken te bieden met producten uit eigen productie of van lokale producenten. Mijn menu's veranderen met de seizoenen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Dinette Mobile"
    ]
  },
