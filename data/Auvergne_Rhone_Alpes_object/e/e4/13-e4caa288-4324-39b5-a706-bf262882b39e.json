  "rdfs:comment": {
    "de": [
      "Massage Typ Amma: Intervention an Ihrem Urlaubsort, in der Firma, auf einer Veranstaltung. Amma ist eine bekleidete Sitzmassage. Amma bedeutet \"durch Berührung beruhigen\"."
    ],
    "en": [
      "Amma type massage: intervention on your vacation spot, in business and at an event. The Amma is a dressy seated massage. Amma means \"calm by touch\"."
    ],
    "it": [
      "Massaggio di tipo Amma: intervento nel luogo di vacanza, in compagnia, in occasione di un evento. L'Amma è un massaggio da seduti con i vestiti addosso. Amma significa \"calmare con il tocco\"."
    ],
    "fr": [
      "Massage type Amma : intervention sur votre lieu de vacances, en entreprise, sur un évènement. Le Amma est un massage assis habillé. Amma signifie \"calmer par le toucher\"."
    ],
    "es": [
      "Masaje tipo Amma: intervención en su destino de vacaciones, en su empresa, en un evento. Amma es un masaje sentado y con ropa. Amma significa \"calmar mediante el tacto\"."
    ],
    "nl": [
      "Amma type massage: intervention op uw vakantieplek, zakelijk en op een evenement. De Amma is een geklede zitmassage. Amma betekent \"kalm door aanraking\"."
    ]
  },
  "rdfs:label": {
    "en": [
      "Amma Sitting Massage"
    ],
    "fr": [
      "Massage Amma Assis"
    ],
    "nl": [
