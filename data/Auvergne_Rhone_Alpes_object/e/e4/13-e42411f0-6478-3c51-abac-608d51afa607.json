  "rdfs:comment": {
    "de": [
      "Es handelt sich um eine Reitschule für Freizeitreiter. Es ist möglich, das Reiten in spielerischer und pädagogischer Form in jedem Alter rund um das Pony und das Pferd zu entdecken und zu praktizieren."
    ],
    "en": [
      "These riding stables propose lessons for recreational riders. There are fun ways to learn to ride at any age as well as building your knowledge of the world of horses and ponies."
    ],
    "it": [
      "Scuola di equitazione per il tempo libero, per scoprire e praticare l'equitazione su pony e cavalli in modo divertente ed educativo per tutte le età (dal baby pony alle lezioni per adulti). Sono disponibili anche lezioni di equitazione a livello agonistico"
    ],
    "fr": [
      "Ecole d'équitation loisirs, pour découvrir et pratiquer l'équitation sous forme ludique et pédagogique à tout âge autour du poney et du cheval (du baby poney aux cours adultes). Il est aussi possible de pratiquer l'équitation en compétition -"
    ],
    "nl": [
      "Vrijetijdsmanege, voor het ontdekken en oefenen van pony- en paardrijden op een leuke en leerzame manier voor alle leeftijden (van babypony tot lessen voor volwassenen). Wedstrijdrijden is ook mogelijk"
    ],
    "es": [
      "Escuela de equitación de ocio, para descubrir y practicar la equitación y el poni de forma lúdica y pedagógica para todas las edades (desde el poni bebé hasta las clases para adultos). También se ofrece equitación de competición"
    ]
  },
