  "rdfs:comment": {
    "de": [
      "Am Fuße der Monts du Forez empfängt man Sie für Reitkurse und -praktika, Entdeckungsworkshops, Wanderungen und Ausritte, Reitunterricht und eine Pension für Ihr Pferd in einer überschaubaren Struktur."
    ],
    "en": [
      "At the foot of the Monts du Forez, we welcome you for riding lessons and training courses, discovery workshops, rides and horseback riding, equicoaching sessions, and a pension for your horse in a human-sized structure."
    ],
    "it": [
      "Ai piedi dei Monts du Forez, vi accogliamo per lezioni e corsi di equitazione, laboratori di scoperta, passeggiate a cavallo e cavalcate, sessioni di equoaching e una pensione per il vostro cavallo in una struttura a misura d'uomo."
    ],
    "fr": [
      "Au pied des Monts du Forez, on vous accueille pour des cours et stages d’équitation, ateliers découverte, randonnées et balades à cheval, séances d’équicoaching, et une pension pour votre cheval dans une structure à taille humaine."
    ],
    "es": [
      "Al pie de los Monts du Forez, le damos la bienvenida para clases y cursos de equitación, talleres de descubrimiento, paseos y excursiones a caballo, sesiones de equicoaching y una pensión para su caballo en una estructura de tamaño humano."
    ],
    "nl": [
      "Aan de voet van de Monts du Forez verwelkomen wij u voor paardrijlessen en -cursussen, ontdekkingsworkshops, paardrijden en ritten, equicoaching sessies, en een pension voor uw paard in een structuur op mensenmaat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Instant présent équitation et équicoaching"
    ]
  },
