  "rdfs:comment": {
    "de": [
      "Der Wald von Altiport, ein Paradies für Aktivitäten im Freien!\r\nDas Altiport-Viertel liegt auf über 1700 m Höhe und ist im Sommer wie im Winter Ausgangspunkt für zahlreiche Wanderungen."
    ],
    "en": [
      "The Altiport Forest: a paradise of outdoor activities!\r\nThe Altiport area, lying at over 1,700m altitude, is the start point for numerous hikes in summer and winter."
    ],
    "it": [
      "La foresta dell'Altiport, un paradiso per le attività all'aria aperta!\r\nIl comprensorio dell'Altiport, situato a oltre 1700 metri di altitudine, è il punto di partenza di numerose escursioni, sia in estate che in inverno."
    ],
    "fr": [
      "La forêt de l’Altiport, le paradis des activités de plein air !\r\nLe quartier de l’Altiport, situé à plus de 1700 mètres d’altitude, est le point de départ de nombreuses randonnées, été comme hiver."
    ],
    "nl": [
      "Het bos van Altiport, een paradijs voor buitenactiviteiten!\r\nDe wijk Altiport, gelegen op een hoogte van meer dan 1700 meter, is het vertrekpunt voor talrijke wandelingen, zowel in de zomer als in de winter."
    ],
    "es": [
      "El bosque de Altiport, ¡un paraíso para las actividades al aire libre!\r\nEl barrio de Altiport, situado a más de 1.700 metros de altitud, es el punto de partida de numerosas excursiones, tanto en verano como en invierno."
    ]
  },
