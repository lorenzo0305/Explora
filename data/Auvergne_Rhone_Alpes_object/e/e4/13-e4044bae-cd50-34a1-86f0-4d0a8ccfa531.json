  "rdfs:comment": {
    "de": [
      "Gegenüber den majestätischen Felsen der Chassezac-Schlucht, angenehme Umgebung, Feinschmecker- und Familienküche. Hüpfburg, Basketball, Fußball, Volleyball, Tischtennis, Schaukel, Boulespiel. Großbildschirm für Sportübertragungen. Zugang für Behinderte, kostenloses WLAN."
    ],
    "en": [
      "Facing the majestic cliffs of the Gorges du Chassezac, pleasant setting, gourmet family cuisine. Inflatable games, basketball, football, volleyball, table tennis, swings, petanque. Large screen for sports broadcasts. PRM access, free wifi."
    ],
    "it": [
      "Ristorante in un ambiente unico, tranquillo e familiare, a soli 5 minuti da Les Vans. Cucina sana, gustosa e preparata con cura. Prodotti dell'Ardèche, pizze fatte in casa, panini per hamburger fatti in casa e patatine fritte fresche."
    ],
    "fr": [
      "Restaurant dans un cadre unique, paisible, apaisant et familial, à seulement 5 minutes des Vans. Cuisine saine, soignée et savoureuse. Produits ardéchois, pizzas artisanales, pain burger maison et frites fraîches."
    ],
    "es": [
      "Restaurante en un entorno único, tranquilo y familiar, a 5 minutos de Les Vans. Cocina sana, sabrosa y cuidada. Productos de Ardèche, pizzas caseras, panecillos de hamburguesa caseros y patatas fritas frescas."
    ],
    "nl": [
      "Restaurant in een unieke, rustige, gezinsvriendelijke omgeving, op slechts 5 minuten van Les Vans. Gezonde, smakelijke en met zorg bereide keuken. Producten uit de Ardèche, huisgemaakte pizza's, zelfgemaakte broodjes hamburger en verse frietjes."
    ]
  },
