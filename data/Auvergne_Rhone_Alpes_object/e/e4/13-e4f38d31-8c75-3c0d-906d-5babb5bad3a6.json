  "rdfs:comment": {
    "de": [
      "Tuina stammt aus der traditionellen chinesischen Medizin und ist eine tiefgehende Massage, die den freien Fluss der Energie im Körper wiederherstellen soll. Ich biete Ihnen eine individuelle Massage an, die auf jedes Ihrer Bedürfnisse zugeschnitten ist."
    ],
    "en": [
      "Rooted in the Chinese medicine tradition, Tuina is a deep massage that restores free circulation of energy in your body. Each massage is tailored to your needs."
    ],
    "it": [
      "Il Tuina, medicina tradizionale cinese, è un massaggio profondo che mira a ripristinare il libero flusso di energia nel corpo. Vi offro un massaggio personalizzato, adattato a ogni vostra esigenza."
    ],
    "fr": [
      "Le Tuina, issu de la médecine traditionnelle chinoise, est un massage profond visant à rétablir la libre circulation de l'énergie dans le corps. Je vous propose un massage personnalisé, adapté à chacun de vos besoins."
    ],
    "nl": [
      "Tuina, afgeleid van de traditionele Chinese geneeskunde, is een diepe massage die ontworpen is om de vrije stroom van energie in het lichaam te herstellen. Ik bied een persoonlijke massage, aangepast aan al je behoeften."
    ],
    "es": [
      "El tuina, una medicina tradicional china, es un masaje profundo destinado a restablecer el libre flujo de energía en el cuerpo. Te ofrezco un masaje personalizado, adaptado a cada una de tus necesidades."
    ]
  },
  "rdfs:label": {
