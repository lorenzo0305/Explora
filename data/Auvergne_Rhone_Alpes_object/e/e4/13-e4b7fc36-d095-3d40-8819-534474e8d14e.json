  "rdfs:comment": {
    "de": [
      "Marc empfängt Sie in seinem sehr hellen, schön dekorierten Geschäft. Er lächelt Sie an und gibt Ihnen alle seine Ratschläge."
    ],
    "en": [
      "Marc and Sophie, former restaurateurs in Port, are now selling wine.  Their store is bright and beautifully decorated, and the wine merchant welcomes you with a smile and a wealth of advice."
    ],
    "it": [
      "Marc vi dà il benvenuto nella sua boutique luminosa e splendidamente decorata. È sempre sorridente e vi darà tutti i consigli di cui avete bisogno."
    ],
    "fr": [
      "Marc vous accueille dans sa boutique très lumineuse, joliment décorée. Le sourire est au rendez-vous et il vous livre tous ses conseils."
    ],
    "nl": [
      "Marc verwelkomt je in zijn helder verlichte, prachtig ingerichte boetiek. Hij lacht altijd en geeft je al het advies dat je nodig hebt."
    ],
    "es": [
      "Marc le da la bienvenida a su tienda, muy luminosa y decorada con gusto. Siempre sonriente, te dará todos los consejos que necesites."
    ]
  },
