  "rdfs:comment": {
    "de": [
      "Hier finden Sie eine große Auswahl an hausgemachten italienischen Spezialitäten sowie Käse, italienische Wurstwaren und vieles mehr. Vor Ort oder zum Mitnehmen, für Ihre Familien- oder Firmenveranstaltungen oder einfach nur zum Spaß!"
    ],
    "en": [
      "You'll find a wide range of homemade Italian specialties, as well as cheese, Italian charcuterie and much more. On the spot or to take away, for your family or corporate events, or just for fun!"
    ],
    "it": [
      "Troverete una vasta gamma di specialità italiane fatte in casa, oltre a formaggi, salumi italiani e molto altro. Sul posto o da asporto, per i vostri eventi familiari o aziendali, o semplicemente per divertirvi!"
    ],
    "fr": [
      "Retrouvez un grand nombre de spécialités italiennes faites maison ainsi que du fromage, de la charcuterie italienne et bien d'autres choses encore. Sur place ou à emporter, pour vos événements familiaux, d'entreprises ou juste pour le plaisir !"
    ],
    "nl": [
      "Je vindt er een breed scala aan huisgemaakte Italiaanse specialiteiten, maar ook kaas, Italiaanse vleeswaren en nog veel meer. Ter plekke of om mee te nemen, voor familie- of bedrijfsevenementen, of gewoon voor de gezelligheid!"
    ],
    "es": [
      "Encontrará una amplia gama de especialidades italianas caseras, así como quesos, embutidos italianos y mucho más. En el momento o para llevar, para sus eventos familiares o de empresa, ¡o simplemente para divertirse!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Catena Mani'N'Pasta - Traiteur italien"
    ]
  },
