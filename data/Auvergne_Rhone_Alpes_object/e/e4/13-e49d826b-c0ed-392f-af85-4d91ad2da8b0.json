  "rdfs:comment": {
    "de": [
      "Begib dich auf ein dreitägiges Mikroabenteuer in der Garrigue Ardéchoise. 3 Tage, um der Natur zu entfliehen und alle Themen anzusprechen, die du brauchst, um ein autonomer Trekker für deine zukünftigen Abenteuer zu werden"
    ],
    "en": [
      "Set off on a 3-day micro-adventure in the garrigue of the Ardèche. 3 days to get away from it all in the heart of nature, and learn all you need to know to become an autonomous trekker for your future adventures"
    ],
    "it": [
      "Partite per una micro-avventura di 3 giorni nella gariga dell'Ardèche. 3 giorni per staccare la spina nel cuore della natura e affrontare tutti i temi necessari per diventare un trekker autonomo per le vostre avventure future"
    ],
    "fr": [
      "Pars pour une micro-aventure de 3 jours dans la garrigue Ardéchoise. 3 jours pour s'évader en pleine nature et aborder toutes les thématiques dont tu as besoin pour devenir le trekkeur autonome pour tes futures aventures"
    ],
    "nl": [
      "Vertrek voor een 3-daags micro-avontuur in de garrigue van de Ardèche. 3 dagen om er even tussenuit te zijn in het hart van de natuur en alle thema's aan te pakken die je nodig hebt om een autonome trekker te worden voor je toekomstige avonturen"
    ],
    "es": [
      "Emprende una microaventura de 3 días en la garriga de Ardèche. 3 días para evadirse en plena naturaleza y abordar todos los temas necesarios para convertirse en un senderista autónomo para sus futuras aventuras"
    ]
  },
