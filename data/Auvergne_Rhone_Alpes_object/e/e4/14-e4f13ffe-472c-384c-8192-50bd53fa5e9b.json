  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ba7e848-5051-32a3-8a87-bcde2405a30f",
      "dc:description": {
        "de": [
          "Fotogalerie, Originalabzüge auf Kunstdruckpapier, auf Leinwand, auf Glas\nEinrahmung nach Maß.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-Haves der Boutique, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Photo gallery, original prints on art paper, canvas, glass\nCustom framing.\n\nWant to place an order?\nClick on the \"Reserve\" button to see all the store's must-haves"
        ],
        "it": [
          "Galleria fotografica, stampe originali su carta d'arte, tela e vetro\nIncorniciatura personalizzata.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per vedere tutti i must del negozio"
        ],
        "fr": [
          "Galerie photo, tirages originaux sur papier d'art, sur toile, sur verre\nEncadrement sur mesure.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "es": [
          "Galería fotográfica, impresiones originales en papel artístico, lienzo y cristal\nEnmarcado a medida.\n\n¿Quiere hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver todos los imprescindibles de la tienda"
        ],
        "nl": [
          "Fotogalerie, originele afdrukken op kunstpapier, canvas en glas\nInlijsten op maat.\n\nWil je een bestelling plaatsen?\nKlik op de knop \"Reserveren\" om alle musthaves van de winkel te bekijken"
        ]
      },
      "@type": [
        "Description"
      ],
