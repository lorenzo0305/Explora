  "rdfs:comment": {
    "de": [
      "Auf einem provenzalischen Platz in der Innenstadt bietet das Bistrot M Marktküche aus frischen, regionalen Produkten. Abend und Spezialitäten aus der Savoie im Winter. Leckere Tapas am Abend und Spezialitäten aus der Savoye im Winter."
    ],
    "en": [
      "Bistrot M is located on a Provençal square in the town centre and offers cuisine prepared with fresh local produce. In the evenings and specialities of the Alps \r\n(savoyardes) in winter. Gourmet plates in the evenings, and specialities of the Savoie region in winter."
    ],
    "it": [
      "Il Bistrot M, situato nel cuore del centro città, sull'autentica piazza di Pierrelatte, vi accoglie in un ambiente accogliente con una terrazza ideale per divertirsi."
    ],
    "fr": [
      "Le Bistrot M, situé au cœur du centre-ville, sur la place authentique de Pierrelatte, vous accueille dans un cadre convivial avec une terrasse idéale pour passer un bon moment."
    ],
    "nl": [
      "In het centrum van de stad, op een Provençaals plein, biedt Bistrot M een marktkeuken aan met verse, lokale producten. In de avond en Savoyaardse \r\n(Dép. in de Alpen) specialiteiten in de winter. ‘s Avonds gastronomische tapas en ‘s winters specialiteiten uit de Savoie."
    ],
    "es": [
      "El Bistrot M, situado en pleno centro de la ciudad, en la auténtica plaza de Pierrelatte, le da la bienvenida en un ambiente acogedor con una terraza ideal para pasar un buen rato."
    ]
  },
