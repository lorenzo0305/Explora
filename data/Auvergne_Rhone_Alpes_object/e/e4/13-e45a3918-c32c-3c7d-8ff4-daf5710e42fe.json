  "rdfs:comment": {
    "de": [
      "Nordische Skischule: Einzelunterricht in Skating und klassisch, vom Anfänger bis zum Fortgeschrittenen, Video und technisches Debriefing.\r\nNordische Präparierung zu Fuß bei Schneemangel.\r\nSki-Rad-Kurse im Sommer und Herbst."
    ],
    "en": [
      "Nordic ski school: private lessons in skating and classic, from beginners to advanced, video and technical debriefing.\r\nNordic training on foot in case of lack of snow.\r\nRoller skiing lessons in summer and autumn."
    ],
    "it": [
      "Scuola di sci nordico: lezioni private di skating e classico, da principiante ad avanzato, video e debriefing tecnico.\r\nPreparazione nordica a piedi in caso di mancanza di neve.\r\nLezioni di sci a rotelle in estate e in autunno."
    ],
    "fr": [
      "École de ski nordique : cours particuliers de skating et de classique, de l'initiation au perfectionnement, vidéo et débriefing technique.\r\nPréparation nordique à pied en cas de manque de neige.\r\nCours de ski-roues en été et automne."
    ],
    "nl": [
      "Noordse skischool: privélessen in skating en klassiek, van beginners tot gevorderden, video en technische nabespreking.\r\nNoordse voorbereiding te voet bij gebrek aan sneeuw.\r\nRolskiën lessen in de zomer en herfst."
    ],
    "es": [
      "Escuela de esquí nórdico: clases particulares de patinaje y clásico, de principiantes a avanzados, vídeo y repaso técnico.\r\nPreparación nórdica a pie en caso de falta de nieve.\r\nCursos de esquí nórdico a pie en verano y otoño."
    ]
  },
