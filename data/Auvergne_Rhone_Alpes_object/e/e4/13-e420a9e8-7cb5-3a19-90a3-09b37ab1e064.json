  "rdfs:comment": {
    "de": [
      "Hochmoderner Kinosaal (digitale 3D-Projektion, Dolby-Stereo-Sound). Dieser Saal in Form eines Amphitheaters mit geschwungenen Stufen bietet eine hervorragende Sicht, Kapazität: 192 Sitzplätze."
    ],
    "en": [
      "Ultra-modern movie theatre (3D digital projection equipment, digital Dolby stereo sound). The theatre shaped like a curved and terraced amphitheatre makes for excellent viewing, with seating for 192 people and 4 seats for the use of the disabled."
    ],
    "it": [
      "Cinema ultramoderno (proiezione digitale 3D, suono Dolby stereo). Questa sala ad anfiteatro con posti a sedere curvi offre una vista eccellente e può ospitare 192 persone."
    ],
    "fr": [
      "Salle de cinéma ultra moderne (projection numérique 3D, son Dolby stereo). Cette salle en forme d'amphithéâtre gradinée en courbe offre une vue excellente, capacité de 192 places assises."
    ],
    "nl": [
      "Ultra-moderne bioscoop (3D digitale projectie, Dolby stereogeluid). Deze amfitheatervormige zaal met gebogen stoelen biedt een uitstekend uitzicht en 192 zitplaatsen."
    ],
    "es": [
      "Cine ultramoderno (proyección digital 3D, sonido Dolby estéreo). Esta sala en forma de anfiteatro con asientos curvos ofrece una vista excelente y tiene capacidad para 192 espectadores."
    ]
  },
