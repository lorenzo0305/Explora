  "rdfs:comment": {
    "de": [
      "Öffnung im Rahmen der Entdeckungstage \"La Truffe du début à la faim\": Ein All-Inclusive-Tag mit der Geschichte des Betriebs, Erklärungen zum Leben des schwarzen Trüffels und einer Trüffelmahlzeit in unserer Ferme-Auberge."
    ],
    "en": [
      "Open as part of the \"Truffles from start to finish\" discovery days: an all-inclusive day with the history of the farm, explanations on the life of the black truffle and a truffle meal at our Ferme-Auberge."
    ],
    "it": [
      "Aperto nell'ambito delle giornate di scoperta \"Tartufi dall'inizio alla fine\": una giornata all-inclusive con la storia della fattoria, spiegazioni sulla vita del tartufo nero e un pasto a base di tartufo nella nostra Ferme-Auberge."
    ],
    "fr": [
      "Ouverture dans le cadre des journées découvertes \" La Truffe du début à la faim\" : Une journée tout compris avec  l'histoire de l'exploitation, explications sur la vie de la truffe noire et repas truffé à notre Ferme-Auberge."
    ],
    "nl": [
      "Geopend in het kader van de ontdekkingsdagen \"Truffels van begin tot eind\": een all-inclusive dag met de geschiedenis van de boerderij, uitleg over het leven van de zwarte truffel en een truffelmaaltijd in onze Ferme-Auberge."
    ],
    "es": [
      "Abierto en el marco de las jornadas de descubrimiento \"La trufa de principio a fin\": una jornada todo incluido con la historia de la explotación, explicaciones sobre la vida de la trufa negra y una comida a base de trufas en nuestro Ferme-Auberge."
    ]
  },
  "rdfs:label": {
