  "rdfs:comment": {
    "de": [
      "Schönes Chalet mit familiärer Atmosphäre, in dem Ihnen der beste Empfang bereitet wird. Hotel mit allem Komfort, begleitet von einer guten Gastronomie."
    ],
    "en": [
      "Beautiful chalet with family atmosphere where a warm welcome awaits you. All comfort included, alongside a tasteful gastronomy."
    ],
    "it": [
      "Bellissimo chalet con un'atmosfera familiare dove sarete accolti nel migliore dei modi. Hotel con tutti i comfort e una buona gastronomia."
    ],
    "fr": [
      "Beau chalet à l'ambiance familiale où le meilleur accueil vous sera réservé. Hôtel tout confort accompagné d'une bonne gastronomie."
    ],
    "es": [
      "Hermoso chalet con un ambiente familiar donde se le dará la mejor bienvenida. Hotel con todas las comodidades y buena gastronomía."
    ],
