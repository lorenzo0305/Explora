  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet Garets Gym Volontaire kostenlose Schnupperstunden an: Erhaltungsgymnastik, maximal 2 Kurse pro Person\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Garets Gym Volontaire offers free discovery sessions: Maintenance gymnastics, maximum 2 classes per person\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, la Garets Gym Volontaire offre sessioni introduttive gratuite di ginnastica di mantenimento, con un massimo di 2 lezioni a persona\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Garets Gym Volontaire propose des séances gratuites de découverte : Gymnastique d'entretien, 2 cours maximum par personne\r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het vitaliteitsprogramma van Vichy biedt Garets Gym Volontaire gratis kennismakingslessen onderhoudsgymnastiek aan, met een maximum van 2 lessen per persoon\r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, el Garets Gym Volontaire propone sesiones gratuitas de iniciación a la gimnasia de mantenimiento, con un máximo de 2 clases por persona\r\nInformación e inscripciones por teléfono."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gymnastique d'entretien - Vichy Vitalité"
    ]
  },
