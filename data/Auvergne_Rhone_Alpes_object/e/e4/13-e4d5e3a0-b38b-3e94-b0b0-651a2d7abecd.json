  "rdfs:comment": {
    "de": [
      "Verleih von Alpinskipaketen (Baby, Junior und Erwachsener) mit Skiern, Schuhen und Stöcken. Verleih von Schneeschuhen, Schlitten, nordischen Tourenski, alpinen Tourenski, Verleih von ARVA-Packs (Lawinenrettung, Arva, Schaufel, Sonde)."
    ],
    "en": [
      "Alpine ski pack rental (baby, junior and adult) including skis, boots and poles. Rental of snowshoes, toboggans, Nordic touring skis, alpine touring skis, ARVA pack rental (avalanche rescue, arva, shovel, probe)."
    ],
    "it": [
      "Noleggio di zaini da sci alpino (baby, junior e adulti) con sci, scarponi e bastoncini. Noleggio di racchette da neve, slittini, sci d'alpinismo, sci d'alpinismo e zaini per la ricerca di valanghe (apparecchio di ricerca in valanga, pala e sonda)."
    ],
    "fr": [
      "Location de pack ski alpin (baby, junior et adulte) comprenant skis, chaussures et bâtons. Location de raquettes, luge, ski de rando nordique, ski de rando alpin, location de pack ARVA (secours avalanche, arva, pelle, sonde)."
    ],
    "nl": [
      "Verhuur van alpineskipakketten (baby, junior en volwassene) met ski's, schoenen en stokken. Verhuur van sneeuwschoenen, tobogans, nordic toerski's, alpine toerski's en lawinepakketten (lawinepakket met lawinepieper, schep en sonde)."
    ],
    "es": [
      "Alquiler de packs de esquí alpino (baby, junior y adulto) que incluyen esquís, botas y bastones. Alquiler de raquetas de nieve, toboganes, esquís de travesía nórdica, esquís de travesía alpina y packs de transceptor de avalanchas (transceptor de avalanchas, pala y sonda)."
    ]
  },
