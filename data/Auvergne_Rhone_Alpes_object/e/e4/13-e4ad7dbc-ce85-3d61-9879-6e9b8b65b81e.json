  "rdfs:comment": {
    "de": [
      "Artisans du Monde ist eine Vereinsbewegung, die den fairen Handel praktiziert, um zur nachhaltigen Entwicklung beizutragen. Unsere Ziele basieren auf drei Säulen: Verkauf, Bildung und Anwaltschaft."
    ],
    "en": [
      "Artisans du Monde is an associative movement that practices fair trade to contribute to sustainable development. Our objectives are based on 3 pillars: sales, education and advocacy."
    ],
    "it": [
      "Artisans du Monde è un movimento associativo che pratica il commercio equo e solidale per contribuire allo sviluppo sostenibile. I nostri obiettivi si basano su 3 pilastri: vendite, formazione e advocacy."
    ],
    "fr": [
      "Artisans du Monde est un mouvement associatif qui pratique le commerce équitable pour contribuer au développement durable. Nos objectifs reposent sur 3 piliers : vente, éducation et plaidoyer."
    ],
    "nl": [
      "Artisans du Monde is een vereniging die eerlijke handel bedrijft om bij te dragen tot duurzame ontwikkeling. Onze doelstellingen zijn gebaseerd op 3 pijlers: verkoop, educatie en belangenbehartiging."
    ],
    "es": [
      "Artisans du Monde es un movimiento asociativo que practica el comercio justo para contribuir al desarrollo sostenible. Nuestros objetivos se basan en 3 pilares: ventas, educación y promoción."
    ]
  },
