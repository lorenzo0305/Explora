  "rdfs:comment": {
    "de": [
      "Auf der Speisekarte finden Sie eine Mischung aus Gerichten, die aus Rezepten stammen, die ich in Paris, der Schweiz und Dijon gelernt habe, sowie traditionelle Spezialitäten aus England, Savoyen und anderen Ländern."
    ],
    "en": [
      "You will find a mixture of dishes on the menu from recipes I have learned in Paris, Switzerland and Dijon, as well as traditional English, local Savoyard and other country specialties."
    ],
    "it": [
      "Nel menu troverete un mix di piatti basati su ricette che ho imparato a Parigi, in Svizzera e a Digione, oltre a specialità tradizionali provenienti dall'Inghilterra, dalla Savoia e da altri Paesi."
    ],
    "fr": [
      "Vous trouverez au menu un mélange de plats issus de recettes que j'ai apprises à Paris, en Suisse et à Dijon, ainsi que des spécialités traditionnelles anglaises, savoyardes et d'autres pays."
    ],
    "nl": [
      "Op het menu vindt u een mix van gerechten uit recepten die ik heb geleerd in Parijs, Zwitserland en Dijon, maar ook traditionele Engelse, lokale Savoyaardse en andere landelijke specialiteiten."
    ],
    "es": [
      "En el menú encontrará una mezcla de platos basados en recetas que aprendí en París, Suiza y Dijon, así como especialidades tradicionales de Inglaterra, Saboya y otros países."
    ]
  },
