  "rdfs:comment": {
    "de": [
      "Thematische Ausstellungen, semi-permanent. Sammlungen mit Verbindung zum Gebiet Tricastin, einige davon sind einmalig in Europa. Vorträge, Führungen, Ateliers und Nachbildungen in 3D."
    ],
    "en": [
      "The museum is closed for extension work, and is due to reopen at the end of 2025. \r\nThe Musée d'Archéologie Tricastine houses remarkable collections that tell the story of the region from prehistory to the Middle Ages."
    ],
    "it": [
      "Il Museo Archeologico di Tricastino conserva notevoli collezioni che raccontano la storia della zona dalla preistoria al Medioevo."
    ],
    "fr": [
      "Le musée d'archéologie tricastine conserve des collections remarquables qui racontent l'histoire du territoire de la Préhistoire jusqu'au Moyen Age."
    ],
    "nl": [
      "Semi-permanente en thematische exposities. Collecties die betrekking hebben op het Tricastingebied waarvan sommige uniek zijn in Europa. Bijeenkomsten, rondleidingen, workshops en 3D-reconstructie met de Oculus Rift bril."
    ],
    "es": [
      "El Museo Arqueológico Tricastino alberga notables colecciones que cuentan la historia de la zona desde la prehistoria hasta la Edad Media."
    ]
  },
