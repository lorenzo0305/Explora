  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, den Lac de Lavalette friedlich auf dem Wasser zu entdecken? Wir haben die Lösung: das Paddle! Mit unseren Paddles und Riesenpaddles können Sie den See in aller Ruhe genießen."
    ],
    "en": [
      "Want to discover peacefully the Lake of Lavalette on the water? We have the solution: the paddle! With our paddles and giant paddles, enjoy the lake quietly."
    ],
    "it": [
      "Volete scoprire il Lago di Lavalette in tutta tranquillità sull'acqua? Abbiamo la soluzione: la pagaia! Con le nostre pagaie e le nostre pagaie giganti, godetevi il lago in tutta tranquillità."
    ],
    "fr": [
      "Envie de découvrir paisiblement le Lac de Lavalette sur l'eau ? On a la solution : le paddle ! Avec nos paddles et paddles géants, profitez du lac tranquillement."
    ],
    "es": [
      "¿Quiere descubrir el lago de Lavalette tranquilamente sobre el agua? Tenemos la solución: ¡el remo! Con nuestros remos y palas gigantes, disfrute del lago tranquilamente."
    ],
    "nl": [
      "Wilt u het Lavalettemeer rustig op het water ontdekken? Wij hebben de oplossing: de peddel! Met onze peddels en reuzenpeddels geniet u in alle rust van het meer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location de paddles - Lavalette"
    ]
  },
