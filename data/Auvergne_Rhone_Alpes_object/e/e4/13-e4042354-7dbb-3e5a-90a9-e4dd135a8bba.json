  "rdfs:comment": {
    "de": [
      "Im Jahr 2026 wird das Europavox-Festival 20 Jahre alt!\r\nWenn man 20 Jahre alt ist, möchte man sich treffen, lieben, teilen und feiern!"
    ],
    "en": [
      "In 2026, the Europavox Festival will celebrate its 20th birthday!\r\nWhen you're 20, you want to get together, love, share? and party!"
    ],
    "it": [
      "Nel 2026, il Festival Europavox festeggerà il suo 20° compleanno!\r\nA 20 anni si vuole stare insieme, amare, condividere e fare festa!"
    ],
    "fr": [
      "En 2026, le Festival Europavox soufflera ses 20 bougies !\r\nQuand on a 20 ans, on a envie de se retrouver, d’aimer, de partager… et de faire la fête !"
    ],
    "nl": [
      "In 2026 bestaat het Europavox Festival 20 jaar!\r\nAls je 20 bent, wil je samenkomen, liefhebben, delen en feesten!"
    ],
    "es": [
      "En 2026, el Festival Europavox cumplirá 20 años\r\nA los 20 años, apetece reunirse, amar, compartir... ¡y festejar!"
    ]
  },
