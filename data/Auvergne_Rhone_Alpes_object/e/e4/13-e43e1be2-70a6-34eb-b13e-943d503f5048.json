  "rdfs:comment": {
    "de": [
      "Romance librairie café ist eine Buchhandlung, die sich auf Romance-Bücher spezialisiert hat, aber auch ein Café, ein Teesalon, wo Sie ein Getränk und ein Gebäck genießen können!"
    ],
    "en": [
      "Romance librairie café is a bookshop specializing in romance books, as well as a café and tea room where you can enjoy a drink and a pastry!"
    ],
    "it": [
      "Romance librairie café è una libreria specializzata in libri romantici, ma è anche un caffè e una sala da tè dove potrete gustare un drink e un pasticcino!"
    ],
    "fr": [
      "Romance librairie café est une librairie spécialisée en livre de romance mais également un café, salon de thé où vous pourrez venir déguster une boisson et une pâtisserie !"
    ],
    "nl": [
      "Romance librairie café is een boekwinkel die gespecialiseerd is in romantische boeken, maar het is ook een café en een theesalon waar je kunt genieten van een drankje en een gebakje!"
    ],
    "es": [
      "Romance librairie café es una librería especializada en libros románticos, pero también es una cafetería y salón de té donde podrá disfrutar de una bebida y un pastelito"
    ]
