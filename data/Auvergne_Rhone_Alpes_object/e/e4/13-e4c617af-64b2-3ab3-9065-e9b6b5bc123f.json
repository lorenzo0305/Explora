  "rdfs:comment": {
    "de": [
      "PARADiS ist ein Bergbistro hoch über der Haute-Tarentaise und bietet einen einzigartigen Blick auf die Alpen. Auf 2000m Höhe liegt es ideal an den Skipisten von La Rosière im Winter und dem Club-House des Golfplatzes von La Rosière im Sommer."
    ],
    "en": [
      "PARADIS is a mountain bistro, overlooking the High-Tarentaise valley and offering a unique view of the Alps. At an altitude of 2000m, it is ideally located on the La Rosière ski slopes in winter and La Rosière Golf Club-House in summer."
    ],
    "it": [
      "PARADiS è un bistrot di montagna che si affaccia sulla Haute-Tarentaise e offre una vista unica sulle Alpi. A 2000 m di altitudine, è situato in posizione ideale sulle piste da sci di La Rosière in inverno e sul Golf Club-House di La Rosière in estate."
    ],
    "fr": [
      "PARADiS est un bistrot de montagne, surplombant la Haute-Tarentaise et offrant une vue unique sur les Alpes. À 2000m d’altitude, il est idéalement situé sur les pistes de ski de La Rosière en hiver et le Club-House du Golf de La Rosière en été."
    ],
    "nl": [
      "PARADiS is een bistro in de bergen met uitzicht op de Haute-Tarentaise en een uniek uitzicht op de Alpen. Op een hoogte van 2000m is het ideaal gelegen aan de skipistes van La Rosière in de winter en het La Rosière Golf Club-House in de zomer."
    ],
    "es": [
      "PARADiS es un bistró de montaña que domina la Alta Tarentaise y ofrece una vista única de los Alpes. A 2.000 m de altitud, goza de una ubicación ideal en las pistas de esquí de La Rosière en invierno y en la casa-club de golf de La Rosière en verano."
    ]
  },
