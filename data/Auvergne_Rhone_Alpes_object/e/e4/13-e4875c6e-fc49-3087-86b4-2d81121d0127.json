  "rdfs:comment": {
    "de": [
      "Das Maison de la Mémoire et du Patrimoine, das seit dem 1. März 2011 in einem alten Gebäude im Herzen von Chamonix untergebracht ist, bewahrt die Fotoarchive der Region auf und bietet wechselnde Ausstellungen."
    ],
    "en": [
      "Housed in an old building in the heart of Chamonix since March 1, 2011, the Maison de la Mémoire et du Patrimoine preserves the region's photographic archives and offers temporary exhibitions."
    ],
    "it": [
      "Ospitata in un antico edificio nel cuore di Chamonix dal 1° marzo 2011, la Maison de la Mémoire et du Patrimoine conserva gli archivi fotografici della regione e propone mostre temporanee."
    ],
    "fr": [
      "Installée dans un bâtiment ancien au cœur de Chamonix depuis le 1er mars 2011, la Maison de la Mémoire et du Patrimoine conserve les archives photographiques du territoire et propose des expositions temporaires."
    ],
    "es": [
      "Instalada en un antiguo edificio del centro de Chamonix desde el 1 de marzo de 2011, la Maison de la Mémoire et du Patrimoine conserva los archivos fotográficos de la región y ofrece exposiciones temporales."
    ],
    "nl": [
      "Het Maison de la Mémoire et du Patrimoine is sinds 1 maart 2011 gevestigd in een oud gebouw in het hart van Chamonix. Het bewaart de fotoarchieven van de regio en biedt tijdelijke tentoonstellingen."
    ]
  },
