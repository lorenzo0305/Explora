  "rdfs:comment": {
    "de": [
      "Das Kriegsdenkmal in Péronne erinnert an die Gefallenen des Ersten und Zweiten Weltkriegs. Das 1926 errichtete Ensemble wird von Paul Aubans Statue mit dem Titel \"La Picardie maudissant la guerre\" (Die Picardie verflucht den Krieg) dominiert."
    ],
    "en": [
      "The Péronne war memorial commemorates the loss of soldiers in the First and Second World Wars. Erected in 1926, it is dominated by Paul Auban's statue entitled \"La Picardie maudissant la guerre\" (\"Picardy cursing war\")."
    ],
    "it": [
      "Il monumento ai caduti di Péronne commemora la perdita di soldati nella Prima e nella Seconda guerra mondiale. Costruito nel 1926, è dominato dalla statua di Paul Auban intitolata \"La Picardie maudissant la guerre\" (\"La Piccardia che maledice la guerra\")."
    ],
    "fr": [
      "Le monument aux morts de Péronne commémore la disparition des soldats de la Première et de la Seconde guerre mondiales. Érigé en 1926,  l'ensemble est dominé par la statue de Paul Auban intitulée \"La Picardie maudissant la guerre\"."
    ],
    "nl": [
      "Het oorlogsmonument van Péronne herdenkt het verlies van soldaten in de Eerste en Tweede Wereldoorlog. Het werd gebouwd in 1926 en wordt gedomineerd door het standbeeld van Paul Auban met de titel \"La Picardie maudissant la guerre\" (\"Picardië vervloekt de oorlog\")."
    ],
    "es": [
      "El memorial de guerra de Péronne conmemora la pérdida de soldados en la Primera y Segunda Guerras Mundiales. Construido en 1926, está dominado por la estatua de Paul Auban titulada \"La Picardie maudissant la guerre\" (\"La Picardía maldiciendo la guerra\")."
    ]
  },
