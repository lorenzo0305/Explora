  "rdfs:comment": {
    "de": [
      "Der Poney Club du Rosson befindet sich im Herzen der Monts du Lyonnais, inmitten einer grünen Oase. Der Ponyclub ist seit 20 Jahren in der Gemeinde Larajasse ansässig und empfängt Kinder ab 2 Jahren bis hin zu großen Teenagern."
    ],
    "en": [
      "The Poney Club du Rosson is located in the heart of the Monts du Lyonnais, in a veritable green setting. Established 20 years ago in the commune of Larajasse, the pony club welcomes children from the age of 2 up to teenagers."
    ],
    "it": [
      "Il Pony Club Rosson si trova nel cuore dei Monts du Lyonnais, in una vera e propria cornice verde. Fondato 20 anni fa nel comune di Larajasse, il pony club accoglie bambini dall'età di 2 anni fino agli adolescenti."
    ],
    "fr": [
      "Le Poney club du Rosson est situé au coeur des Monts du Lyonnais, dans un véritable écrin de verdure. Implanté depuis 20 ans sur la commune de Larajasse, le poney club accueille les enfants dès 2 ans et jusqu'au grands ados."
    ],
    "nl": [
      "Ponyclub Rosson ligt in het hart van de Monts du Lyonnais, in een echt groene omgeving. De ponyclub werd 20 jaar geleden opgericht in de gemeente Larajasse en verwelkomt kinderen vanaf 2 jaar tot tieners."
    ],
    "es": [
      "El Rosson Pony Club está situado en el corazón de los Montes del Lyonnais, en un auténtico paraje verde. Creado hace 20 años en el municipio de Larajasse, el pony club acoge a niños desde los 2 años hasta adolescentes."
    ]
  },
