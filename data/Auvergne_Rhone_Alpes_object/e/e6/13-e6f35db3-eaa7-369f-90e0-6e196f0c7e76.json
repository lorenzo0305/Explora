  "rdfs:comment": {
    "de": [
      "Begeben Sie sich an der Seite von Alice auf ein Abenteuer auf der Suche nach ihrem Vater. Lösen Sie mit Ihrer Familie oder mit Freunden verschiedene Rätsel (Puzzles, erweiterte Realität) und entdecken Sie dabei das Kulturerbe des Pays de Lapalisse."
    ],
    "en": [
      "See where the wind takes you with Alice, who is looking for her father. With your family or with friends, solve the riddles and discover Pays de Lapalisse cultural heritage."
    ],
    "it": [
      "Unisciti ad Alice in un'avventura alla ricerca di suo padre. In famiglia o con gli amici, risolvete vari enigmi (puzzle, realtà aumentata) e scoprite il patrimonio del Pays de Lapalisse."
    ],
    "fr": [
      "Partez à l'aventure aux côtés d'Alice à la recherche de son père. En famille ou entre amis, résolvez diverses énigmes (casse-têtes, réalité augmentée) en découvrant le patrimoine du Pays de Lapalisse."
    ],
    "nl": [
      "Ga samen met Alice op avontuur op zoek naar haar vader. Los als gezin of met vrienden verschillende raadsels op (puzzels, augmented reality) terwijl je het erfgoed van het Pays de Lapalisse ontdekt."
    ],
    "es": [
      "Acompaña a Alice en una aventura en busca de su padre. En familia o con amigos, resuelve varios enigmas (rompecabezas, realidad aumentada) mientras descubres el patrimonio del Pays de Lapalisse."
    ]
  },
  "rdfs:label": {
    "en": [
      "Game \"Alice and the other world\" - Meetings"
    ],
    "fr": [
      "Jeu \"Alice et l'autremonde\" - Épisode 1 : Rencontres"
    ]
  },
