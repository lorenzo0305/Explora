  "rdfs:comment": {
    "de": [
      "L'Atelier - Saal für aktuelle Musik - bietet Konzerte, Aufführungen für das junge Publikum und verfügt über ein Probestudio. L'Atelier ist ein städtischer Dienst der Stadt Cluses."
    ],
    "en": [
      "L’Atelier - current music hall - offers concerts, shows for young audiences, and has a rehearsal studio. The Workshop is a municipal service of the city of Cluses."
    ],
    "it": [
      "L'Atelier - uno spazio musicale moderno - offre concerti, spettacoli per un pubblico giovane e dispone di una sala prove. L'Atelier è un servizio comunale della città di Cluses."
    ],
    "fr": [
      "L’Atelier - salle de musiques actuelles - propose des concerts, des spectacles pour le jeune public, et dispose d'un studio de répétition. L'Atelier est un service municipal de la ville de Cluses."
    ],
    "es": [
      "L'Atelier, un moderno local de música, ofrece conciertos, espectáculos para el público joven y cuenta con un estudio de ensayo. L'Atelier es un servicio municipal de la ciudad de Cluses."
    ],
    "nl": [
      "L'Atelier - een modern muziekpodium - biedt concerten en voorstellingen voor een jong publiek en heeft een repetitiestudio. L'Atelier is een gemeentelijke dienst van de stad Cluses."
    ]
  },
