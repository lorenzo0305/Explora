  "rdfs:comment": {
    "de": [
      "Besuchen Sie die kleinen savoyischen Dolomiten: mineralische Atmosphäre inmitten großer Felsnadeln.\r\nAchten Sie zu Beginn der Saison auf Firn.\r\nParken Sie nicht zu lange am Fuß der Wände (Steinschlaggefahr)."
    ],
    "en": [
      "See the Savoie region’s very own little Dolomites: explore the mineral-rich environment between the tall needles of rock.\r\nWatch out for snow fields at the start of the season.\r\nDon’t leave your car for too long at the foot of the rock face (danger of rock falls)."
    ],
    "it": [
      "Visitate le piccole Dolomiti savoiarde: un'atmosfera minerale in mezzo a cime imponenti.\r\nAttenzione alla neve all'inizio della stagione.\r\nNon parcheggiate troppo a lungo ai piedi delle pareti (rischio di caduta massi)."
    ],
    "fr": [
      "Visitez les petites Dolomites savoyardes : ambiance minérale au milieu de grandes aiguilles.\r\nAttention aux névés en début de saison.\r\nNe pas stationner trop longtemps au pied des parois (risques de chutes de pierres)."
    ],
    "es": [
      "Visite los pequeños Dolomitas saboyanos: una atmósfera mineral en medio de altísimas cumbres.\r\nCuidado con la nieve al principio de la temporada.\r\nNo estacione demasiado tiempo al pie de las paredes (riesgo de desprendimientos de rocas)."
    ],
    "nl": [
      "Bezoek de kleine Savoyaardse Dolomieten: een minerale sfeer te midden van torenhoge bergtoppen.\r\nPas op voor sneeuw aan het begin van het seizoen.\r\nParkeer niet te lang aan de voet van de wanden (risico op steenslag)."
    ]
  },
