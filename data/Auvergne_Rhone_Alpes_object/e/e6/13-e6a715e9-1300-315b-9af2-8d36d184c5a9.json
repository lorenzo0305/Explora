  "rdfs:comment": {
    "de": [
      "Im Herzen eines zweitausend Jahre alten Weinbergs vor den Toren Lyons setzt Régis Descotes heute eine Familientradition fort, die 1689 in\r\nMillery. Zertifiziertes Weingut für biologischen Anbau."
    ],
    "en": [
      "In the heart of a vineyard that has existed on the very edge of Lyon for two thousand years, Régis Descotes perpetuates a family tradition that started back in 1689 in Millery. Organic estate."
    ],
    "it": [
      "Nel cuore di un vigneto vecchio di duemila anni, alle porte di Lione, Régis Descotes porta avanti una tradizione familiare iniziata nel 1689 in\r\nFilatoio. La tenuta è certificata biologica."
    ],
    "fr": [
      "Au coeur d'un vignoble deux fois millénaire, aux portes de Lyon, Régis Descotes perpétue aujourd'hui une tradition familiale née en 1689 à\r\nMillery. Domaine certifié en agriculture biologique."
    ],
    "nl": [
      "In het hart van een tweeduizend jaar oude wijngaard, aan de poorten van Lyon, zet Régis Descotes een familietraditie voort die in 1689 werd geboren in\r\nMillery. Het landgoed is biologisch gecertificeerd."
    ],
    "es": [
      "En el corazón de un viñedo bimilenario, a las puertas de Lyon, Régis Descotes continúa una tradición familiar nacida en 1689 en\r\nMillery. La finca está certificada como ecológica."
    ]
  },
  "rdfs:label": {
