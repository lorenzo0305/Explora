  "rdfs:comment": {
    "de": [
      "Bergbegleiter, Mountainbike-Lehrer, qualifiziert für chronische Krankheiten und Behinderung, Aktivitäten in der Natur, Erwachsene, Kinder, Familien.\r\nMultiaktivitäten, Biathlon-Challenge, personalisierte Aufenthalte (Auvergne, Frankreich, Ausland), Klettern, Kanu, Paddeln..."
    ],
    "en": [
      "Mountain leader, mountain bike instructor, qualified in sports for chronic illnesses and disabilities, outdoor activities for adults, children and families.\r\nMulti-activities, bi-athlon challenge, personalized stays (Auvergne, France, abroad), climbing, canoeing, paddle..."
    ],
    "it": [
      "Guida alpina, istruttore di mountain bike, qualificato in sport per malattie croniche e disabilità, attività all'aperto per adulti, bambini e famiglie.\r\nAttività multiple, sfide di biathlon, vacanze personalizzate (Alvernia, Francia, estero), arrampicata, canoa, paddle..."
    ],
    "fr": [
      "Accompagnateur montagne, Moniteur de VTT, qualifié sport maladies chroniques et handicap, activités pleine nature, adultes,enfants,familles.\r\nMulti-activités, challenge bi-athlon, séjours personnalisés (Auvergne,France,Etranger), Escalade, canoë, paddle..."
    ],
    "es": [
      "Monitor de montaña, monitor de BTT, titulado en deporte para enfermedades crónicas y discapacidades, actividades al aire libre para adultos, niños y familias.\r\nMultiactividades, desafío biatlón, vacaciones personalizadas (Auvernia, Francia, extranjero), escalada, piragüismo, paddle..."
    ],
    "nl": [
      "Bergleider, mountainbike-instructeur, gediplomeerd in sport voor chronische ziekten en handicaps, buitenactiviteiten voor volwassenen, kinderen en gezinnen.\r\nMulti-activiteiten, bi-atlon uitdaging, gepersonaliseerde vakanties (Auvergne, Frankrijk, buitenland), klimmen, kanoën, peddelen ..."
    ]
  },
  "rdfs:label": {
    "fr": [
