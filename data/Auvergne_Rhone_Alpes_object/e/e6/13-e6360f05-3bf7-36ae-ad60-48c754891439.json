  "rdfs:comment": {
    "de": [
      "Der Palast beherbergt das Netzwerk der G1MRA (Gauge One Model Railway Association) mit einem Großformat von 6 Metern Breite und 16 Metern Länge, in dem mehrere prestigeträchtige Züge ihren Dampf aus den Zylindern entlassen werden. Vorführungen und Workshops."
    ],
    "en": [
      "The palace is home to the G1MRA (Gauge One Model Railway Association) network, with a large 6-metre wide by 16-metre long display where several prestigious trains will be releasing their steam from the cylinders. Demonstrations and workshops."
    ],
    "it": [
      "Il palazzo ospita la rete G1MRA (Gauge One Model Railway Association), con una grande esposizione di 6 metri di larghezza per 16 metri di lunghezza, dove diversi treni prestigiosi sprigioneranno il loro vapore dai cilindri. Dimostrazioni e workshop."
    ],
    "fr": [
      "Le palais accueille le réseau de la G1MRA (Gauge One Model Railway Association) avec un grand format de 6 mètres de largeur sur 16 mètres de longueur où plusieurs trains prestigieux libéreront leur vapeur des cylindres. Démonstrations et ateliers."
    ],
    "nl": [
      "Het paleis is de thuisbasis van het G1MRA-netwerk (Gauge One Model Railway Association), met een groot scherm van 6 meter breed en 16 meter lang, waar een aantal prestigieuze treinen hun stoom uit de cilinders laten ontsnappen. Demonstraties en workshops."
    ],
    "es": [
      "El palacio alberga la red G1MRA (Gauge One Model Railway Association), con una gran exposición de 6 metros de ancho por 16 de largo, en la que varios trenes prestigiosos soltarán el vapor de los cilindros. Demostraciones y talleres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Live Steam Up Show 2026"
    ]
  },
