  "rdfs:comment": {
    "de": [
      "Seit über tausend Jahren steht die romanische Kirche Saint Symphorien du Moûtier, die einst dem Orden von Cluny angegliedert war. Sie wird restauriert und nachts beleuchtet."
    ],
    "en": [
      "The Romanesque church of Saint Symphorien du Moûtier has stood for more than a thousand years and was once affiliated to the Order of Cluny. It has been restored and lit up at night."
    ],
    "it": [
      "La chiesa romanica di Saint Symphorien du Moûtier, un tempo appartenente all'ordine di Cluny, è in piedi da oltre mille anni. È stato restaurato e illuminato di notte."
    ],
    "fr": [
      "Depuis plus de mille ans se dresse l’église romane Saint Symphorien du Moûtier autrefois affiliée à l’ordre de Cluny. Elle est restaurée et mise en lumière la nuit."
    ],
    "es": [
      "La iglesia románica de Saint Symphorien du Moûtier, que perteneció a la orden de Cluny, se mantiene en pie desde hace más de mil años. Se ha restaurado y se ha iluminado por la noche."
    ],
    "nl": [
      "De Romaanse kerk Saint Symphorien du Moûtier, die ooit verbonden was aan de Orde van Cluny, staat al meer dan duizend jaar. Het is gerestaureerd en 's nachts verlicht."
    ]
  },
