  "rdfs:comment": {
    "de": [
      "Terraventure ist auf die Betreuung von Aktivitäten in der freien Natur spezialisiert. Wandern, Schneeschuhwandern, Orientierungslauf, Biwakieren, Klettern. Wir bieten auch Praktika für Kinder an."
    ],
    "ru": [
      "Terraventure специализируется на организации активного отдыха. Походы, прогулки на снегоступах, ориентирование, бивуаки, скалолазание. Мы также предлагаем курсы для детей."
    ],
    "en": [
      "Terraventure specializes in supervising outdoor activities. Hiking, snowshoeing, orienteering, bivouac, climbing. We also offer courses for children."
    ],
    "it": [
      "Terraventure è specializzata nella supervisione di attività all'aperto. Escursioni, ciaspolate, orienteering, bivacco, arrampicata. Offriamo anche corsi per bambini."
    ],
    "fr": [
      "Terreaventure est spécialisée dans l'encadrement d'activités de pleine nature. Randonnée, raquette à neige, escalade, course d'orientation, bivouac. Nos proposons également des stages pour les enfants."
    ],
    "nl": [
      "Terraventure is gespecialiseerd in het begeleiden van outdooractiviteiten. Wandelen, sneeuwschoenwandelen, oriëntatielopen, bivak, klimmen. We bieden ook cursussen voor kinderen."
    ],
    "es": [
      "Terraventure está especializada en la supervisión de actividades al aire libre. Senderismo, raquetas de nieve, orientación, vivac, escalada. También ofrecemos cursos para niños."
    ],
    "zh": [
      "Terraventure 专门从事户外活动指导。徒步旅行、雪地健行、定向越野、露营、攀岩。我们还提供儿童课程。"
    ]
  },
  "rdfs:label": {
