  "rdfs:comment": {
    "de": [
      "Evolution 2 ist eine Ski- und Outdoor-Abenteuerschule.\r\nIn Val d'Isère empfängt Sie unsere Ski- und Outdoor-Abenteuerschule für Ski- und Snowboardkurse in kleinen Gruppen, die ein persönliches, schnelles und stressfreies Lernen garantieren."
    ],
    "en": [
      "Evolution 2 is an outdoor ski and adventure school. \r\nIn Val d'Isère, our ski and outdoor adventure school welcomes you for small group ski and snowboard lessons, guaranteeing personalised, fast and stress-free learning."
    ],
    "it": [
      "Evolution 2 è una scuola di sci e di avventura all'aperto. A Val d'Isère, la nostra scuola di sci e di avventura all'aperto vi accoglie per lezioni di sci e snowboard in gruppi ridotti, garantendo un apprendimento personalizzato, rapido e senza stress."
    ],
    "fr": [
      "Evolution 2 est une école de ski & d’aventure outdoor. \r\nÀ Val d’Isère, notre école de ski et d’aventures outdoor vous accueille pour des cours de ski et de snowboard en effectifs réduits, garantissant un apprentissage personnalisé, rapide et sans stress."
    ],
    "nl": [
      "Evolution 2 is een ski- en outdooravonturenschool.\r\nIn Val d'Isère verwelkomt onze ski- en outdoor-avonturenschool je voor ski- en snowboardlessen in kleine groepen, zodat je snel, stressvrij en gepersonaliseerd kunt leren."
    ],
    "es": [
      "Evolution 2 es una escuela de esquí y aventura al aire libre.\r\nEn Val d'Isère, nuestra escuela de esquí y aventura al aire libre le da la bienvenida para clases de esquí y snowboard en pequeños grupos, garantizando un aprendizaje rápido, sin estrés y personalizado."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski School - Evolution 2"
    ],
    "it": [
      "Scuola di sci - Evolution 2"
    ],
    "fr": [
      "École de ski - Evolution 2"
    ]
  },
