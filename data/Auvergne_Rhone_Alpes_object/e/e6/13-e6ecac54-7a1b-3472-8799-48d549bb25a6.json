  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine Führung durch unsere Mikrofarm an, auf der wir unser Wissen und unsere Vision einer alternativen Landwirtschaft weitergeben."
    ],
    "en": [
      "We offer a guided tour of our micro-farm, where we share our knowledge and our vision of alternative agriculture."
    ],
    "it": [
