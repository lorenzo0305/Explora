          "additionalInformation": {
            "de": [
              "Besichtigung der Mikrofarm und Workshops nur mit Reservierung online oder per Telefon.\r\nDirektverkauf ab Hof das ganze Jahr über nach Vereinbarung und donnerstags von 17-19 Uhr geöffnet."
            ],
            "en": [
              "Visits to the micro-farm and workshops by reservation only online or by telephone.\r\nDirect farm sales all year round by appointment and open Thursdays from 5pm to 7pm."
            ],
            "it": [
              "Visite alla microfattoria e ai laboratori solo su appuntamento online o telefonico.\r\nVendita diretta in azienda tutto l'anno su appuntamento e aperta il giovedì dalle 17.00 alle 19.00."
            ],
            "fr": [
              "Visite de la micro-ferme et ateliers sur réservation uniquement en ligne ou par téléphone.\r\nVente directe à la ferme toute l'année sur rendez-vous et ouvert le jeudi de 17h à 19h."
            ],
            "es": [
              "Visitas a la microgranja y talleres con cita previa en línea o por teléfono.\r\nVenta directa en la granja todo el año con cita previa y abierta los jueves de 17:00 a 19:00."
            ],
            "nl": [
              "Bezoek aan de microboerderij en workshops alleen op afspraak online of telefonisch.\r\nDirecte verkoop op de boerderij het hele jaar door op afspraak en geopend op donderdag van 17.00 tot 19.00 uur."
            ]
          },
