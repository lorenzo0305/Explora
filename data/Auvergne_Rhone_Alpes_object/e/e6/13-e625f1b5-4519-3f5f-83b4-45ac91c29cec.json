  "rdfs:comment": {
    "de": [
      "Coco Bresil lädt Sie ein, eine authentische, farbenfrohe und geschmackvolle brasilianische Küche in einer warmen und freundlichen Atmosphäre zu entdecken."
    ],
    "en": [
      "Coco Bresil invites you to discover authentic Brazilian cuisine, full of color and flavor, in a warm and friendly atmosphere."
    ],
    "it": [
      "Coco Bresil vi invita a scoprire l'autentica cucina brasiliana, ricca di colori e sapori, in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Coco Bresil vous invite à découvrir une cuisine brésilienne authentique, colorée et pleine de saveurs, dans une ambiance chaleureuse et conviviale."
    ],
    "nl": [
      "Coco Bresil nodigt u uit om de authentieke Braziliaanse keuken te ontdekken, vol kleur en smaak, in een warme en vriendelijke sfeer."
    ],
    "es": [
      "Coco Bresil le invita a descubrir la auténtica cocina brasileña, llena de color y sabor, en un ambiente cálido y acogedor."
    ]
