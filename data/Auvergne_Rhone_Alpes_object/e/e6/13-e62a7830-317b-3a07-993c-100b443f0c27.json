  "rdfs:comment": {
    "de": [
      "Verkauf von Pizzas, Tagesgerichten, Lasagne, Tartiflette, Eis, \"hausgemachten\" Desserts, Bier, Erfrischungsgetränken und Wein zum Mitnehmen\r\nTagesgericht von Dienstagmittag bis Freitagmittag (außer an Feiertagen).\r\nBurger des Küchenchefs von Dienstag bis Samstag mittags."
    ],
    "en": [
      "Takeaway pizzas, daily specials, lasagne, tartiflettes, ice creams, home-made desserts, beers, soft drinks and wines\r\nDaily specials from Tuesday lunchtime to Friday lunchtime (except public holidays).\r\nChef's burgers Tuesday to Saturday lunchtime."
    ],
    "it": [
      "Pizze da asporto, specialità del giorno, lasagne, tartiflettes, gelati, dolci fatti in casa, birre, bibite e vini\r\nSpecialità giornaliere dal martedì a pranzo al venerdì a pranzo (esclusi i giorni festivi).\r\nHamburger dello chef dal martedì al sabato a pranzo."
    ],
    "fr": [
      "Vente à emporter de pizzas, plats du jour, lasagnes, tartiflettes, glaces, desserts \"fait maison\", bières, boissons fraîches et vins\r\nPlat du jour du mardi midi au vendredi midi (sauf jours fériés). \r\nBurgers du chef du mardi au samedi le midi."
    ],
    "es": [
      "Pizzas para llevar, platos del día, lasaña, tartiflettes, helados, postres caseros, cervezas, refrescos y vinos\r\nOfertas del día de martes a mediodía a viernes (excepto festivos).\r\nHamburguesas del Chef de martes a sábado al mediodía."
    ],
    "nl": [
      "Afhaalpizza's, dagschotels, lasagne, tartiflettes, ijsjes, huisgemaakte desserts, bieren, frisdranken en wijnen\r\nDagelijkse specialiteiten van dinsdagmiddag tot vrijdagmiddag (behalve feestdagen).\r\nBurgers van de chef van dinsdag tot zaterdag lunchtijd."
    ]
  },
