  "rdfs:comment": {
    "de": [
      "CinéMargeride ist ein Verein, der dem ländlichen Wanderkinokreis der Haute-Loire (Cinévasion 43) angehört.\r\nBietet Ihnen Filmvorführungen im Espace Multimedia an."
    ],
    "en": [
      "CinéMargeride is a member of the Haute-Loire rural itinerant cinema circuit (Cinévasion 43).\r\nOffers film screenings at the Espace Multimédia."
    ],
    "it": [
      "Il CinéMargeride è membro del circuito di cinema rurale itinerante della Haute-Loire (Cinévasion 43).\r\nOffre proiezioni di film presso l'Espace Multimédia."
    ],
    "fr": [
      "CinéMargeride association adhérente au circuit de cinéma itinérant rural de Haute-Loire (Cinévasion 43).\r\nVous propose des séances de cinéma à l'Espace multimédia."
    ],
    "nl": [
      "CinéMargeride is lid van het circuit van rondtrekkende plattelandsbioscopen in de Haute-Loire (Cinévasion 43).\r\nBiedt filmvertoningen aan in de Espace Multimédia."
    ],
    "es": [
      "CinéMargeride es miembro del circuito de cine rural itinerante de Haute-Loire (Cinévasion 43).\r\nOfrece proyecciones de películas en el Espace Multimédia."
    ]
  },
