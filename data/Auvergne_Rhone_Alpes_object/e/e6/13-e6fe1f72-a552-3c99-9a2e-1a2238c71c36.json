  "rdfs:comment": {
    "de": [
      "Ziele:\r\n- Erhaltung, Wiederherstellung und Aufwertung der biologischen Vielfalt der Kanäle, Quellen und Feuchtgebiete in der Stadt.\r\n- Verbesserung des Lebensumfelds und Schutz der Landschaft.\r\n- Geführte Touren durch die Kanäle"
    ],
    "en": [
      "Objectives :\r\n- preserve, restore and enhance the biodiversity of the city's canals, springs and wetlands\r\n- improve the living environment and protect the landscape.\r\n- Guided tours of the canals"
    ],
    "it": [
      "Obiettivi :\r\n- conservazione, ripristino e valorizzazione della biodiversità dei canali, delle sorgenti e delle zone umide della città\r\n- miglioramento dell'ambiente di vita e protezione del paesaggio.\r\n- Visite guidate ai canali"
    ],
    "fr": [
      "Objectifs :\r\n- préservation, restauration et mise en valeur de la biodiversité des canaux, sources et zones humides de la ville\r\n- amélioration du cadre de vie et protection du paysage.\r\n- Visites guidées des canaux"
    ],
    "es": [
      "Objetivos :\r\n- preservación, restauración y mejora de la biodiversidad de los canales, manantiales y humedales de la ciudad\r\n- la mejora del entorno vital y la protección del paisaje.\r\n- Visitas guiadas a los canales"
    ],
    "nl": [
      "Doelstellingen :\r\n- de biodiversiteit van de kanalen, bronnen en wetlands van de stad behouden, herstellen en verbeteren\r\n- de levenskwaliteit verbeteren en het landschap beschermen.\r\n- Rondleidingen door de kanalen"
    ]
  },
