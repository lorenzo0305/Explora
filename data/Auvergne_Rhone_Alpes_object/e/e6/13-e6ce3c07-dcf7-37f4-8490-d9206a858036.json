  "rdfs:comment": {
    "de": [
      "Caviste & Restaurant in Valence, entdecken Sie eine Speisekarte mit lokalen und saisonalen Produkten, die mit Bedacht verarbeitet werden, um den Geschmack und die Aromen zu bewahren und zu sublimieren. Wir arbeiten mit überwiegend lokalen Produkten und Lieferanten."
    ],
    "en": [
      "Caviste & restaurant in Valence, France, discover a menu of local and seasonal products, carefully selected to preserve and enhance tastes and flavors. We work with mainly local products and suppliers."
    ],
    "it": [
      "Enoteca e ristorante a Valence, scoprite un menu composto da prodotti locali e di stagione, preparati con cura per preservare ed esaltare gusti e sapori. Lavoriamo con prodotti e fornitori prevalentemente locali."
    ],
    "fr": [
      "Caviste & restaurant à Valence, découvrez une carte composée de produits locaux et de saison, travaillés avec justesse pour préserver et sublimer les goûts et les saveurs. Nous travaillons avec des produits et des fournisseurs essentiellement locaux."
    ],
    "es": [
      "Tienda de vinos y restaurante en Valence, descubra una carta compuesta por productos locales y de temporada, cuidadosamente elaborados para preservar y realzar los gustos y sabores. Trabajamos principalmente con productos y proveedores locales."
    ],
    "nl": [
      "Een wijnwinkel en restaurant in Valence, ontdek een menu dat bestaat uit lokale en seizoensproducten, zorgvuldig bereid om smaken en aroma's te behouden en te versterken. We werken voornamelijk met lokale producten en leveranciers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ici et Là - Latour Maubourg"
    ]
  },
