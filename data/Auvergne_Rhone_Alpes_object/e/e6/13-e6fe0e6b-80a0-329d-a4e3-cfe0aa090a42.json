  "rdfs:comment": {
    "de": [
      "Der Legende nach tragen wir alle bei unserer Geburt auf der Mitte des Bauches eine kleine Schnur, die trocknet und sich wieder löst."
    ],
    "en": [
      "Legend has it that when we're born, we all carry a little cord in the middle of our bellies that dries out and falls off."
    ],
    "it": [
      "La leggenda narra che quando nasciamo, tutti noi portiamo un piccolo cordone al centro della pancia che si secca e cade."
    ],
    "fr": [
      "La légende dit qu'à notre naissance, nous portons tous sur le milieu du ventre un petit cordon qui sèche et se détache."
    ],
    "nl": [
      "Volgens de legende dragen we bij onze geboorte allemaal een koordje in het midden van onze buik dat uitdroogt en eraf valt."
    ],
    "es": [
      "Cuenta la leyenda que, cuando nacemos, todos llevamos un cordoncito en medio del vientre que se seca y se cae."
    ]
  },
  "rdfs:label": {
    "fr": [
