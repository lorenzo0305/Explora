  "rdfs:comment": {
    "de": [
      "1 km lange Strecke für erfahrene Angler mit angenehmen Angelbedingungen.\r\nNeuheit 2026: Der Fischereiaufseher der AAPPMA von Combronde ist für die Überwachung der Angelstrecke „La Morge au Pont de Montcel” zuständig."
    ],
    "en": [
      "1 km long course for experienced anglers, with pleasant fishing conditions.\r\nNew for 2026: Fishing warden assigned to the Combronde AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique - Approved Association for Fishing and Protection of the Aquatic Environment) and responsible for supervising the fishing course - La Morge at Pont de Montcel."
    ],
    "it": [
      "Percorso di 1 km, per pescatori esperti, in condizioni piacevoli.\r\nNovità 2026: guardiano della pesca assegnato alla Combronde AAPPMA e responsabile della supervisione del percorso di pesca - La Morge au Pont de Montcel"
    ],
    "fr": [
      "Parcours long d'1 km, pour pêcheurs confirmés, avec des conditions de pratique agréables.\r\nNouveauté 2026 : Garde de pêche affecté à l'AAPPMA de Combronde et en charge de la surveillance du parcours de pêche - La Morge au Pont de Montcel"
    ],
    "es": [
      "Recorrido de 1 km, para pescadores experimentados, con condiciones agradables.\r\nNovedad para 2026: vigilante de pesca asignado a la Combronde AAPPMA y encargado de supervisar el recorrido de pesca - La Morge au Pont de Montcel"
    ],
    "nl": [
      "1 km lang parcours, voor ervaren vissers, met aangename omstandigheden.\r\nNieuw in 2026: Vismeester toegewezen aan de Combronde AAPPMA en verantwoordelijk voor het toezicht op het visparcours - La Morge au Pont de Montcel"
    ]
  },
  "rdfs:label": {
