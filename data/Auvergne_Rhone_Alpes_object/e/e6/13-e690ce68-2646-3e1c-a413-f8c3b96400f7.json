  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! Begeben Sie sich auf die Jagd nach Opinell , einem Spezialisten für Know-how, in den Straßen der Stadt. Er und die anderen Gnolus werden Ihnen die Geschichte des Ortes näher bringen."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! Go on a hunt for Opinell, a specialist in know-how, in the streets of the city. He and the other Gnolus will make you discover the history of the place."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! Andate a caccia di Opinell, uno specialista del know-how, per le strade della città. Lui e gli altri Gnolus vi aiuteranno a scoprire la storia della zona."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! Partez à la chasse d'Opinell , spécialiste des savoir-faire, dans les rues de la ville. Lui et les autres Gnolus vous feront découvrir l'histoire du lieu."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga op jacht naar Opinell, een specialist in knowhow, in de straten van de stad. Hij en de andere Gnolus zullen je helpen de geschiedenis van het gebied te ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita Vaya a la caza de Opinell, un especialista en conocimientos técnicos, por las calles de la ciudad. Él y los otros Gnolus te ayudarán a descubrir la historia de la zona."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Les siphonés de l'Aqueduc"
    ]
  },
