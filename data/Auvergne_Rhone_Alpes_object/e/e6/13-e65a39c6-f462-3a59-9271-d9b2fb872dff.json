  "rdfs:comment": {
    "de": [
      "Das Château des Arènes ist ein außergewöhnlicher Ort 10 Minuten von Grenoble entfernt in einer grünen Umgebung mit Privatparkplatz. Eine charmante, gemütliche Mischung aus dem Charakter des Alten in den Salons und dem Modernen in den gewölbten Räumen des Restaurants und der Zimmer."
    ],
    "en": [
      "The Château des Arènes is an exceptional place 10 minutes from Grenoble in lush greenery with private parking. A charming, cozy mix between the character of the old in the lounges and the contemporary in the vaulted rooms of the restaurant and the bedrooms."
    ],
    "it": [
      "Lo Château des Arènes è un luogo eccezionale a 10 minuti da Grenoble, immerso nel verde e dotato di parcheggio privato. Un mix affascinante e accogliente tra il carattere delle antiche stanze e le contemporanee sale a volta del ristorante e delle camere."
    ],
    "fr": [
      "Le Château des Arènes est un lieu d’exception à 10 min de Grenoble dans un écrin de verdure avec parking privé. Un charmant mélange cosy entre le caractère de l’ancien dans les salons et le contemporain des salles voutées du restaurant et des chambres."
    ],
    "nl": [
      "Het Château des Arènes is een uitzonderlijke plek op 10 minuten van Grenoble in een groene omgeving met een eigen parkeerplaats. Een charmante en gezellige mix tussen het karakter van de oude kamers en de hedendaagse gewelfde ruimtes van het restaurant en de slaapkamers."
    ],
    "es": [
      "El Château des Arènes goza de una ubicación excepcional a 10 minutos de Grenoble, en un entorno verde con aparcamiento privado. Una encantadora y acogedora mezcla de carácter del viejo mundo en los salones y salas abovedadas contemporáneas en el restaurante y las habitaciones."
    ]
  },
