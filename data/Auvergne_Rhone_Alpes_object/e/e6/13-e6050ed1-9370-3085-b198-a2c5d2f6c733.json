  "rdfs:comment": {
    "de": [
      "Sind Sie ein Fan von Nervenkitzel? Lassen Sie sich auf den schönsten Pfaden der Region führen. Von der Einführung bis zur Perfektionierung, Jordan wird sich Ihrem Niveau und Ihren Wünschen anpassen, um Ihre Ziele zu erreichen!"
    ],
    "en": [
      "Looking for a thrill? Let us guide you along the region's most beautiful trails. From beginners to advanced, Jordan will adapt to your level and your desires to achieve your goals!"
    ],
    "it": [
      "Siete alla ricerca di un brivido? Lasciatevi guidare lungo i sentieri più belli della regione. Dai principianti ai più esperti, Jordan si adatterà al vostro livello e ai vostri desideri per aiutarvi a raggiungere i vostri obiettivi!"
    ],
    "fr": [
      "Adeptes de sensations fortes ? Laissez vous guider sur les plus beaux sentiers de la région. De l'initiation au perfectionnement, Jordan moniteur guide VTT saura s'adapter à votre niveau et vos envies afin d'atteindre vos objectifs !"
    ],
    "es": [
      "¿Busca emociones fuertes? Déjanos guiarte por los senderos más bellos de la región. Desde principiantes hasta avanzados, Jordan se adaptará a su nivel y a sus deseos para ayudarle a alcanzar sus objetivos"
    ],
    "nl": [
      "Op zoek naar sensatie? Laat ons je begeleiden over de mooiste trails in de regio. Van beginners tot gevorderden, Jordan past zich aan jouw niveau en wensen aan om je te helpen je doelen te bereiken!"
    ]
  },
  "rdfs:label": {
    "en": [
      "JO MTB GUIDE - Guided mountain bike outings"
    ],
    "fr": [
      "JO MTB GUIDE - Sorties VTT accompagnées"
    ]
  },
