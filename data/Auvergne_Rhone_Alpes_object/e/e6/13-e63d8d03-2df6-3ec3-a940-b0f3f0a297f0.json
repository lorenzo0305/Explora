  "rdfs:comment": {
    "de": [
      "Kletterhalle in einem ehemaligen Seidengebäude; 500m² Kletterwand mit einer Höhe von 17m, Platten, Vertikalen, einer 6m langen und 19m langen Überhangwand."
    ],
    "en": [
      "Climbing for all levels. High climbing hall in an old building for silk; 400m² of climbing wall, with a heigth of 17m."
    ],
    "it": [
      "Palestra d'arrampicata molto alta in un ex edificio del setificio; 500 m² di parete d'arrampicata, con un'altezza di 17 m, placche, verticali, uno strapiombo di 6 m e un'estensione di 19 m. Ampliamento di 450 m²!"
    ],
    "fr": [
      "Escalade pour tous niveaux.Trés haute salle d'escalade dans un ancien bâtiment de la soie; 500m² de mur à grimper, avec une hauteur de 17m, de la dalle, du vertical, un dévers de 6m d'avancée et 19m de développé. Agrandissement de 450 m² !"
    ],
    "nl": [
      "Klimmen op alle niveaus. Hoge klimzaal in een voormalig zijdegebouw; 400m² aan klimmuur met een hoogte van 17m."
    ],
    "es": [
      "Gimnasio de escalada de gran altura en un edificio de una antigua fábrica de seda; 500 m² de rocódromo, con una altura de 17 m, losas, verticales, un voladizo de 6 m y una extensión de 19 m. ¡Ampliación de 450 m²!"
    ]
  },
