      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/56090dd9-b486-35d6-b631-2936460ee2d2",
          "schema:validFrom": "2026-04-25T00:00:00",
          "schema:validThrough": "2026-09-20T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Die Bar ist täglich ab 8 Uhr geöffnet.\r\nDas Restaurant öffnet in der Hochsaison mittags und abends von Dienstagabend bis Sonntag (Montag- und Dienstagmittag geschlossen). In der Nebensaison ist das Restaurant an allen Wochenenden ab Freitagabend geöffnet, je nach Besucherzahl oder auf Anfrage einer Gruppe auch länger."
            ],
            "en": [
              "The bar is open every day from 8am.\r\nIn high season, the restaurant is open for lunch and dinner from Tuesday evening to Sunday (closed on Monday and Tuesday lunchtimes). In low season, we are open every weekend from Friday evening onwards, depending on the number of guests or group requests."
            ],
            "it": [
              "Il bar è aperto tutti i giorni dalle ore 8.00.\r\nIn alta stagione, il ristorante è aperto a pranzo e a cena dal martedì sera alla domenica (chiuso il lunedì e il martedì a pranzo). In bassa stagione, il ristorante è aperto tutti i fine settimana dal venerdì sera in poi, a seconda del numero di ospiti o delle richieste dei gruppi."
            ],
            "fr": [
              "Le bar est ouvert tous les jours dès 8h.\r\nLe restaurant ouvre en haute-saison midi et soir du mardi soir au dimanche (fermeture le lundi et mardi midi). En basse saison, ouverture tous les week-end dès le vendredi soir et plus selon l'affluence ou sur demande d'un groupe."
            ],
            "es": [
              "El bar abre todos los días a partir de las 8 de la mañana.\r\nEn temporada alta, el restaurante abre para almuerzos y cenas de martes por la noche a domingo (lunes y martes al mediodía cerrado). En temporada baja, el restaurante abre todos los fines de semana a partir del viernes por la noche, en función del número de comensales o de las peticiones de los grupos."
            ],
            "nl": [
              "De bar is elke dag geopend vanaf 8 uur.\r\nIn het hoogseizoen is het restaurant geopend voor lunch en diner van dinsdagavond tot zondag (gesloten op maandag- en dinsdagmiddag). In het laagseizoen is het restaurant elk weekend geopend vanaf vrijdagavond, afhankelijk van het aantal gasten of verzoeken van groepen."
            ]
          },
