  "rdfs:comment": {
    "de": [
      "Cécile, Vincent und ihr Team empfangen Sie auf ihrer großen Terrasse, die dem Gipfel des Jarjatte gegenüberliegt. Augen- und Gaumenfreuden sind garantiert. Tagesgerichte, Salate oder Pizza und köstliche Desserts, die mit Sorgfalt und Liebe zubereitet werden."
    ],
    "en": [
      "Open to all, Cécile, Vincent and their team welcome you to their large terrace facing the summit of La Jarjatte, a feast for the eyes and taste buds alike. Daily specials, salads or pizzas and delicious desserts, made with care and love."
    ],
    "it": [
      "Aperti a tutti, Cécile, Vincent e il loro team vi accolgono nella loro grande terrazza affacciata sulla cima della Jarjatte, una festa per gli occhi e per il palato. Specialità del giorno, insalate o pizze e deliziosi dessert, preparati con cura e amore."
    ],
    "fr": [
      "Ouvert à tous, Cécile, Vincent et leur équipe vous accueillent sur leur grande terrasse qui fait face au sommet de la Jarjatte, plaisir des yeux et des papilles garantis. Plats du jour, salades ou pizza et délicieux desserts, réalisés avec soin et amour."
    ],
    "nl": [
      "Cécile, Vincent en hun team heten je welkom op hun grote terras met uitzicht op de top van La Jarjatte, een lust voor het oog en de smaakpapillen. Dagelijkse specialiteiten, salades of pizza's en heerlijke desserts, met zorg en liefde gemaakt."
    ],
    "es": [
      "Abiertos a todos, Cécile, Vincent y su equipo le dan la bienvenida a su gran terraza frente a la cima de La Jarjatte, una fiesta para la vista y el paladar. Especialidades del día, ensaladas o pizzas y deliciosos postres, elaborados con mimo y cariño."
    ]
  },
  "rdfs:label": {
    "de": [
