  "rdfs:comment": {
    "de": [
      "Mehr als 5000 Schmetterlinge und Insekten der 5 Kontinente. Das einzige Museum dieser Art in Savoyen und Hoch-Savoyen. Insekten in Terrarien. Andenken, Geschenke und Postkarten."
    ],
    "en": [
      "Over 5000 butterflies and insects from the 5 continents. There are only 3 museum of this kind in France. Souvenirs, gifts and postcards."
    ],
    "it": [
      "Più di 4500 farfalle e insetti provenienti dai 5 continenti. L'unico museo di questo tipo nell'Alta Savoia. Fasmidi nel terrario. Souvenir, oggetti regalo e cartoline."
    ],
    "fr": [
      "Plus de 5000 papillons et insectes des 5 continents. Seulement 3 muséum de ce type en France, c'est le seul en Savoie et Haute-Savoie. Site recommandé par le Petit Futé.\r\nCadeaux et cartes postales, médailles souvenir."
    ],
    "nl": [
      "Meer dan 4500 vlinders en insecten uit 5 continenten. Enig museum in zijn soort in de Savoie et Haute-Savoie. Wandelende takken in een terrarium. Souvenirs, cadeaus en ansichtkaarten."
    ],
    "es": [
      "Más de 5000 mariposas e insectos de los 5 continentes. Sólo 3 museos de este tipo en Francia, es el único en Saboya y Alta Saboya. Sitio recomendado por el Petit Futé.\r\nRegalos y postales, medallas de recuerdo."
    ]
  },
