  "rdfs:comment": {
    "de": [
      "Das Kino von Les 2 Alpes erwartet Sie mit Vorpremieren, Filmen in OV und nicht zu vergessen Zeichentrickfilmen für Kinder.\r\nDAS GESAMTE PROGRAMM FINDEN SIE, WENN SIE AUF DEN LINK AUF DER WEBSITE KLICKEN."
    ],
    "en": [
      "The cinema of Les 2 Alpes offers previews, movies in V.O. without forgetting the cartoons for children."
    ],
    "it": [
      "Il cinema di Les 2 Alpes vi aspetta per le anteprime, i film in versione originale senza dimenticare i cartoni animati per bambini."
    ],
    "fr": [
      "Le cinéma des 2 Alpes vous attend pour des sorties en avant-première, des films en V.O. sans oublier les dessins animés pour les enfants.\r\nTOUT LE PROGRAMME DISPONIBLE EN CLIQUANT SUR LE LIEN DU SITE INTERNET."
    ],
    "es": [
      "El cine 2 Alpes le espera para los preestrenos, las películas en V.O. y sin olvidar los dibujos animados para niños.\r\nPUEDE CONSULTAR EL PROGRAMA COMPLETO HACIENDO CLIC EN EL ENLACE DE LA PÁGINA WEB."
    ],
    "nl": [
      "De 2 Alpes bioscoop wacht op je voor previews, films in V.O. en niet te vergeten tekenfilms voor kinderen.\r\nHET VOLLEDIGE PROGRAMMA IS BESCHIKBAAR DOOR OP DE LINK VAN DE WEBSITE TE KLIKKEN."
    ]
  },
