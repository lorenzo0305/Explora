  "rdfs:comment": {
    "de": [
      "Die IHK ist eine halböffentliche Einrichtung, die die Interessen der Unternehmen (Industrie, Handel, Dienstleister) gegenüber den Behörden vertritt."
    ],
    "en": [
      "The CCI is a semi-public institution in charge of representing the interests of companies (industrialists, traders, service providers) before the public authorities."
    ],
    "it": [
      "L'ICC è un'istituzione semipubblica incaricata di rappresentare gli interessi delle imprese (industriali, commercianti, fornitori di servizi) presso le autorità pubbliche."
    ],
    "fr": [
      "La CCI est un établissement semi-public chargé de représenter les intérêts des entreprises (industriels, commerçants, prestataires de services) auprès des pouvoirs publics."
    ],
    "es": [
      "La CCI es una institución semipública encargada de representar los intereses de las empresas (industriales, comerciantes, proveedores de servicios) ante los poderes públicos."
    ],
    "nl": [
      "De CCI is een semi-overheidsinstelling die de belangen van het bedrijfsleven (industriëlen, handelaren, dienstverleners) vertegenwoordigt bij de overheid."
    ]
  },
