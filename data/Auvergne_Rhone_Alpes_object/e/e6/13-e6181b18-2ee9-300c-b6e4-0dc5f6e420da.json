  "rdfs:comment": {
    "de": [
      "Wie wäre es, nach einem guten Kinobesuch oder einem Drink auf der Terrasse in die Rolle eines Musikers zu schlüpfen? Dann tanzen Sie jetzt!"
    ],
    "en": [
      "What if, after a film or a drink at a pavement café, you put yourself in a musician's shoes? Well, dance away!"
    ],
    "it": [
      "E se, dopo un buon film o un drink in terrazza, ci mettessimo nei panni di un musicista? Bene, ballate ora!"
    ],
    "fr": [
      "Et si après une bonne séance  de ciné ou un verre en terrasse on se mettait dans la peau d'un musicien ? Et bien dansez maintenant !"
    ],
    "es": [
      "¿Y si, tras una buena película o una copa en la terraza, nos ponemos en la piel de un músico? ¡Bueno, baila ahora!"
    ],
    "nl": [
      "Wat als we, na een goede film of een drankje op het terras, in de huid kruipen van een muzikant? Wel, dans nu!"
    ]
  },
