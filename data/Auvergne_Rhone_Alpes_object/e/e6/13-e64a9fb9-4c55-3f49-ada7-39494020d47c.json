  "rdfs:comment": {
    "de": [
      "Von September bis Mai bieten wir jeden Monat eine Humorshow mit drei Aufführungen an einem Wochenende an. Während des Schuljahres bieten wir Theater- und Improvisationsworkshops von 5 bis 105 Jahren an."
    ],
    "en": [
      "From September to May, we offer one comedy show a month, with 3 performances over a weekend. During the school year, we offer theater and improvisation workshops for ages 5 to 105."
    ],
    "it": [
      "Da settembre a maggio, offriamo uno spettacolo comico al mese, con 3 rappresentazioni durante il fine settimana. Durante l'anno scolastico, offriamo laboratori di teatro e improvvisazione per bambini dai 5 ai 105 anni."
    ],
    "fr": [
      "De septembre à mai, nous proposons un spectacle d'humour par mois avec 3 représentations sur un week-end. Durant l'année scolaire, nous proposons des ateliers théâtre et improvisation de 5 à 105 ans."
    ],
    "nl": [
      "Van september tot mei bieden we één comedyshow per maand, met 3 voorstellingen in een weekend. Tijdens het schooljaar bieden we drama- en improvisatieworkshops voor kinderen van 5 tot 105 jaar."
    ],
    "es": [
      "De septiembre a mayo, ofrecemos un espectáculo cómico al mes, con 3 representaciones durante un fin de semana. Durante el curso escolar, ofrecemos talleres de teatro e improvisación para niños de 5 a 105 años."
    ]
  },
