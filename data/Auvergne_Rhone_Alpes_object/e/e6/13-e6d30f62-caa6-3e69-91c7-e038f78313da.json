  "rdfs:comment": {
    "de": [
      "Als Angelführer im Puy-de-Dôme lade ich Sie ein, bei Cédric Au Fil de l'Eau Ihre Angeltechniken zu entdecken oder zu perfektionieren."
    ],
    "en": [
      "A fishing guide in the Puy-de-Dôme, I invite you to discover or perfect your fishing techniques at Cédric Au Fil de l'Eau."
    ],
    "it": [
      "Guida di pesca nel Puy-de-Dôme, vi invito a scoprire o a perfezionare le vostre tecniche di pesca presso Cédric Au Fil de l'Eau."
    ],
    "fr": [
      "Guide de pêche dans le Puy-de-Dôme, je vous invite à découvrir ou perfectionner vos techniques de pêche chez Cédric Au Fil de l’Eau."
    ],
