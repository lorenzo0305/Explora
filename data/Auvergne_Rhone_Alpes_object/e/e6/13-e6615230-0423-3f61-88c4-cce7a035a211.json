  "rdfs:comment": {
    "de": [
      "Das Weingut betreibt seit 1994 biologischen Landbau.Biologische Rot- und Weißweine der Côtes du Rhône. Olivenöl aus biologischem Anbau. Museum \"Mémoire Agricole\" Weinbau und Weinbau."
    ],
    "en": [
      "Organic vineyard since 1994. Organic Côtes du Rhône wine (red and white).\r\nOrganic olive oil.\r\n\"Agricultural Memories\" museum (wine-making and wine-growing)."
    ],
    "it": [
      "La tenuta è coltivata con metodo biologico dal 1994. vini biologici Côtes du Rhône rossi e bianchi. Olio d'oliva biologico. Museo \"Mémoire Agricole\" viticole et vinicole."
    ],
    "fr": [
      "Le domaine en agriculture biologique depuis 1994.Vins des côtes du Rhône rouge et blanc biologique. Huiles d'olives biologique. Musée \"Mémoire Agricole\" viticole et vinicole."
    ],
    "es": [
      "La finca se cultiva de forma ecológica desde 1994. Vinos tintos y blancos ecológicos de Côtes du Rhône. Aceite de oliva ecológico. Museo \"Mémoire Agricole\" viticole et vinicole."
    ],
    "nl": [
      "Er wordt biologische landbouw bedreven sinds 1994. Rode en witte biologische wijnen uit de Côtes du Rhône. Biologische olijfolie. Museum \"Mémoire Agricole\" over wijn en wijnbouw."
    ]
  },
