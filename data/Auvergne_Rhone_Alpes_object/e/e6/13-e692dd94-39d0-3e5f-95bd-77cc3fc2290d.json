  "rdfs:comment": {
    "de": [
      "Bar-Restaurant-Pizzeria am Rande der Pisten von Belle Plagne mit Sonnenterrasse. Pizzas zum Mitnehmen."
    ],
    "en": [
      "A bar/ restaurant/ pizzeria on the edge of the ski slopes in Belle Plagne with a sunny panoramic terrace. Open lunchtime and evening - Happy hour 4 - 6pm - Takeaway pizza service in the evening from 6pm."
    ],
    "it": [
      "Bar Ristorante Pizzeria situato sulle piste di Belle Plagne - Terrazza panoramica soleggiata. Aperto per pranzo e cena - Happy Hour dalle 16.00/18.00 - Pizze da asporto dalle 18.00."
    ],
    "fr": [
      "Bar Restaurant Pizzeria situé au bord des pistes de Belle Plagne - Terrasse panoramique ensoleillée. Ouvert Midi et soir - Happy Hour de 16H00/18H00 - Pizzas à emporter le soir à partir de 18H00."
    ],
    "nl": [
      "Bar restaurant pizzeria met zijn zonneterras, langs de skipistes van Belle Plagne gelegen.  Take-away pizza's."
    ],
