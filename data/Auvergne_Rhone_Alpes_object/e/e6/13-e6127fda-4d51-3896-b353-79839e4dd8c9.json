  "rdfs:comment": {
    "de": [
      "Festliche und tanzende Bar für Après-Ski und Abendveranstaltungen. \r\nSavoyische Restauration, Burger, Pizza, vor Ort oder zum Mitnehmen.\r\nRestaurant für Gruppen. \r\nParty-Bar von 16 Uhr bis 2 Uhr. \r\nTerrasse am Fuße der Pisten, am Fuße der Skilifte."
    ],
    "en": [
      "Festive bar and dance for après-ski and evenings.\r\nSavoyard food, burger, pizza, on the premises or to take away.\r\nRestaurant for groups.\r\nParty bar from 4pm to 2am.\r\nTerrace at the foot of the slopes, at the foot of the lifts."
    ],
    "it": [
      "Bar festoso con balli dopo lo sci e la sera.\r\nCucina savoiarda, hamburger, pizza, da mangiare o da portare via.\r\nRistorante per gruppi.\r\nParty bar dalle 16.00 alle 2.00.\r\nTerrazza ai piedi delle piste, ai piedi degli impianti di risalita."
    ],
    "fr": [
      "Bar festif et dansant en après-ski et soirée. \r\nRestauration savoyarde, burger, pizza, sur place ou à emporter.\r\nRestaurant pour les groupes. \r\nParty bar de 16h à 02h. \r\nTerrasse au pied des pistes, au pied des remontées mécaniques."
    ],
    "nl": [
      "Feestelijke bar met dansavonden na het skiën en 's avonds.\r\nSavoyaardse keuken, hamburger, pizza, om te eten of mee te nemen.\r\nRestaurant voor groepen.\r\nFeestbar van 16.00 tot 2.00 uur.\r\nTerras aan de voet van de pistes, aan de voet van de skiliften."
    ],
    "es": [
      "Bar festivo con baile después de esquiar y por la noche.\r\nComida saboyana, hamburguesa, pizza, para comer en el restaurante o para llevar.\r\nRestaurante para grupos.\r\nBar de fiesta de 16h a 2h.\r\nTerraza a pie de pistas, al pie de los remontes."
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Yeti-Höhle"
    ],
