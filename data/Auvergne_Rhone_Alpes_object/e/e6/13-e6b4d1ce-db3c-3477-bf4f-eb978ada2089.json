  "rdfs:comment": {
    "de": [
      "Wochenende der offenen Tür: Esel, Hinterhof, Olivenbäume, Erdbeerbäume, aromatische Pflanzen.\r\nLotto der Düfte\r\nAm Samstag von 12 bis 14 Uhr ist das PNR des Baronnies auf dem Hof, um ein regionales Ernährungsprojekt vorzustellen."
    ],
    "en": [
      "Open house weekend: donkeys, farmyard, olive trees, strawberry trees, aromatic plants.\r\nLoto des parfums\r\nOn Saturday from 12pm to 2pm, the PNR des Baronnies will be on the farm to present a local food project."
    ],
    "it": [
      "Weekend a porte aperte: asini, aia, ulivi, corbezzoli, piante aromatiche.\r\nLotteria dei profumi\r\nSabato, dalle 12 alle 14, il PNR des Baronnies sarà presente in fattoria per presentare un progetto alimentare locale."
    ],
    "fr": [
      "Week-end portes-ouvertes : ânes, basse cour, oliviers, fraisiers, plantes aromatiques.\r\nLoto des parfums\r\nLe samedi de 12h à 14h, le PNR des Baronnies sera sur la ferme pour présenter un projet alimentaire de territoire."
    ],
    "nl": [
      "Weekend open huis: ezels, boerderij, olijfbomen, aardbeibomen, aromatische planten.\r\nLoterij parfum\r\nOp zaterdag van 12u tot 14u is het PNR des Baronnies op de boerderij om een lokaal voedselproject te presenteren."
    ],
    "es": [
      "Fin de semana de puertas abiertas: burros, corral, olivos, madroños, plantas aromáticas.\r\nLotería de perfumes\r\nEl sábado de 12h a 14h, el PNR des Baronnies estará en la granja para presentar un proyecto alimentario local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "De ferme en ferme : ferme de Perdicus"
    ]
  },
