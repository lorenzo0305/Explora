  "rdfs:comment": {
    "de": [
      "Diese authentische Berghütte, die im Laufe der Generationen umgebaut wurde, hat sich zu einem 4**** Hotel entwickelt."
    ],
    "en": [
      "After first being a refuge and alpine farm in 1879, this authentic mountain chalet, transformed throughout different generations, has become a 4 **** hotel."
    ],
    "it": [
      "Nato come rifugio e fattoria nel 1879, questo autentico chalet di montagna è stato trasformato nel corso delle generazioni per diventare un hotel a 4 stelle****."
    ],
    "fr": [
      "D'abord refuge et ferme d'alpage en 1879, cet authentique chalet de montagne, transformé au cour des générations, a su devenir un hôtel 4****."
    ],
    "es": [
      "Este auténtico chalet de montaña, que en 1879 era un refugio y una granja alpina, se ha transformado a lo largo de las generaciones en un hotel de 4 estrellas."
    ],
    "nl": [
      "Dit authentieke bergchalet was oorspronkelijk een berghut en alpenboerderij in 1879 en is in de loop der generaties omgevormd tot een 4-sterrenhotel."
    ]
  },
