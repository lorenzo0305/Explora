  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1eec9571-f553-3805-90f6-f04205cb717b",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Samstag: 9.30-19.30 Uhr\nSonntag: 9.00-12.30 Uhr\n \n Bestellungen :\n\nBestellungen können über die Website www.prisedirect.ollca.com getätigt werden\n.\nAbholung :\n\nBestellung kann während der Öffnungszeiten des Geschäfts abgeholt werden\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Saturday: 9:30am-7:30pm\nSunday: 9:00 am - 12:30 pm\n \n Orders :\n\nOrders can be placed via the website: www.prisedirect.ollca.com\n.\nCollection:\n\nOrders can be collected during store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a sabato: dalle 9.30 alle 19.30\nDomenica dalle 9.00 alle 12.30\n \n Ordini :\n\nGli ordini possono essere effettuati sul sito web: www.prisedirect.ollca.com\n.\nCollezione:\n\nGli ordini possono essere ritirati durante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au samedi: 9h30-19h30\nLe dimanche de 9h00 à 12h30\n \n Commandes :\n\nLes commandes s'effectuent sur le site internet : www.prisedirect.ollca.com\n. \nRetrait :\n\nCommande à retirer aux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 9u30 tot 19u30\nZondag van 9.00 tot 12.30 uur\n \n Bestellingen :\n\nBestellingen kunnen worden geplaatst op de website: www.prisedirect.ollca.com\n.\nCollectie:\n\nBestellingen kunnen worden afgehaald tijdens openingstijden van de winkel\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a sábado de 9h30 a 19h30\nDomingo de 9h00 a 12h30\n \n Pedidos :\n\nLos pedidos pueden realizarse a través de la página web: www.prisedirect.ollca.com\n.\nColección:\n\nLos pedidos pueden recogerse durante el horario de apertura de la tienda\n\n "
        ]
      },
