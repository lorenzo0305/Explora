  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4191c74b-2b36-330e-b745-c446f4106d60",
      "dc:description": {
        "de": [
          "Jo und sein Team heißen Sie in der Welt von La Bodega herzlich willkommen! Sein Küchenchef bietet Ihnen eine Entdeckungstour durch die kulinarischen Spezialitäten des Südwestens mit einer großen Auswahl an frischen Produkten."
        ],
        "en": [
          "Jo and his team welcome you to the world of La Bodega! Our head chef will be delighted to introduce you to the culinary specialities of the South-West, with a wide choice of fresh produce."
        ],
        "it": [
          "Jo e il suo team vi danno il benvenuto nel mondo de La Bodega! Il nostro chef sarà lieto di farvi conoscere le specialità culinarie del sud-ovest, con un'ampia scelta di prodotti freschi."
        ],
        "fr": [
          "Jo et son équipe vous souhaite la bienvenue dans l'univers de la Bodega ! Son chef cuisinier vous propose une découverte de spécialités culinaires du sud-ouest avec un large choix de produits frais."
        ],
        "es": [
          "Jo y su equipo le dan la bienvenida al mundo de La Bodega Nuestro chef estará encantado de presentarle las especialidades culinarias del suroeste, con una amplia selección de productos frescos."
        ],
        "nl": [
          "Jo en zijn team heten je welkom in de wereld van La Bodega! Onze chef laat je graag kennismaken met de culinaire specialiteiten van het zuidwesten, met een ruime keuze aan verse producten."
        ]
      },
