  "rdfs:comment": {
    "de": [
      "Direktverkauf auf dem Bauernhof von grünen Bio-Linsen, Bio-Kartoffeln, geröstetem Bio-Rapsöl und Bio-Rohmilch. Kartoffeln. Milchkühe und Milchfärsen zur Erneuerung."
    ],
    "en": [
      "Direct farm sales of organic green lentils, organic potatoes, organic roasted rapeseed oil and organic raw milk. Potatoes. Dairy cows and replacement dairy heifers."
    ],
    "it": [
      "Vendita diretta in azienda di lenticchie verdi biologiche, patate biologiche, olio di colza biologico arrostito e latte crudo biologico. Patate. Vacche da latte e giovenche da latte sostitutive."
    ],
    "fr": [
      "Vente directe à la ferme de lentilles vertes Bio, pommes de terres Bio, huile de colza grillé Bio et lait cru Bio. Pommes de terre. Vaches laitières et génisses laitières de renouvellement."
    ],
    "es": [
      "Venta directa en la explotación de lentejas verdes ecológicas, patatas ecológicas, aceite de colza tostado ecológico y leche cruda ecológica. Patatas. Vacas lecheras y novillas lecheras de reposición."
    ],
    "nl": [
      "Directe boerderijverkoop van biologische groene linzen, biologische aardappelen, biologische geroosterde koolzaadolie en biologische rauwe melk. Aardappelen. Melkkoeien en vervangende melkvaarzen."
    ]
  },
