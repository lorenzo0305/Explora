  "rdfs:comment": {
    "de": [
      "Fernab der großen Zentren liegt die Auberge du midi auf den Anhöhen des Dorfes, in einer bukolischen Umgebung am Ende einer malerischen Straße, die ein herrliches Panorama bietet."
    ],
    "en": [
      "Far from the main centers, the Auberge du Midi is nestled on the heights of the village, in a bucolic setting at the end of a picturesque road offering superb panoramic views."
    ],
    "it": [
      "Lontano dai grandi centri, l'Auberge du Midi si trova sulle alture del villaggio, in un ambiente bucolico alla fine di una strada pittoresca che offre superbe viste panoramiche."
    ],
    "fr": [
      "Loin des grands centres, l'Auberge du midi est nichée sur les hauteurs du village, dans un cadre bucolique au bout d'une route pittoresque offrant un superbe panorama."
    ],
    "nl": [
      "Ver van de grote centra ligt de Auberge du Midi op de hoogten van het dorp, in een landelijke omgeving aan het einde van een pittoresk weggetje met prachtig panoramisch uitzicht."
    ],
    "es": [
      "Lejos de los grandes centros, el Auberge du Midi está enclavado en las alturas del pueblo, en un entorno bucólico al final de una pintoresca carretera que ofrece magníficas vistas panorámicas."
    ]
  },
