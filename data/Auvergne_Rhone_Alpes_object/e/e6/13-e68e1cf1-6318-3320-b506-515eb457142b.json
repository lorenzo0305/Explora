  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Les Pêcheurs\" empfängt Sie in einem freundlichen und angenehmen Rahmen am Ufer der Loire, in der Nähe eines Boulespiels."
    ],
    "en": [
      "The restaurant \"Les Pêcheurs\" welcomes you in a friendly and pleasant setting on the banks of the Loire, near a game of bowls."
    ],
    "it": [
      "Il ristorante \"Les Pêcheurs\" vi accoglie in un ambiente accogliente e piacevole sulle rive della Loira, vicino a un campo di bocce."
    ],
    "fr": [
      "Le restaurant \"Les Pêcheurs\" vous accueille dans un cadre convivial et agréable en bord de Loire, à proximité d'un jeu de boules."
    ],
    "nl": [
      "Het restaurant \"Les Pêcheurs\" ontvangt u in een vriendelijke en aangename omgeving aan de oevers van de Loire, in de buurt van een jeu de boules baan."
    ],
    "es": [
      "El restaurante \"Les Pêcheurs\" le da la bienvenida en un entorno acogedor y agradable a orillas del Loira, cerca de un juego de petanca."
    ]
  },
