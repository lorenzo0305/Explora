  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Monts du Lyonnais durch ein spielerisches und kostenloses Geocaching-Erlebnis! In Saint-Martin-en-Haut begeben Sie sich auf die Jagd nach Kloche, der in Sachen Märchen und Legenden unerschöpflich ist. Er und die anderen Gnolus werden Ihnen die Megalithen näher bringen."
    ],
    "en": [
      "Discover the Monts du Lyonnais through a fun and free geocaching experience! In Saint-Martin-en-Haut, go on a hunt for Kloche, who can learn about tales and legends. He and the other Gnolus will make you discover the megaliths."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais attraverso un'esperienza di geocaching divertente e gratuita! A Saint-Martin-en-Haut, andate a caccia di Kloche, che non conosce storie e leggende. Lui e gli altri Gnolus vi aiuteranno a scoprire i megaliti."
    ],
    "fr": [
      "Découvrez les Monts du Lyonnais à travers une expérience ludique et gratuite de géocaching ! A Saint-Martin-en-Haut, partez à la chasse de Kloche, incollable sur les contes et légendes. Lui et les autres Gnolus vous feront découvrir les mégalithes."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais via een leuke en gratis geocaching-ervaring! Ga in Saint-Martin-en-Haut op jacht naar Kloche, die niets weet van verhalen en legendes. Hij en de andere Gnolus zullen je helpen de megalieten te ontdekken."
    ],
    "es": [
      "Descubra los Montes del Lyonnais a través de una experiencia de geocaching divertida y gratuita En Saint-Martin-en-Haut, vaya a la caza de Kloche, que no sabe nada de cuentos y leyendas. Él y los otros Gnolus te ayudarán a descubrir los megalitos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus – Méga caillou, maxi galère"
    ]
  },
