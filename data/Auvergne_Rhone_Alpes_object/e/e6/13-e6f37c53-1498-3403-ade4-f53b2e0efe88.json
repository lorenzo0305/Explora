  "rdfs:comment": {
    "de": [
      "Das Haus des Kulturerbes wird zum Maison des Mémoires en Beaujolais mit einem durchgehenden Rundgang vom Erdgeschoss bis zur zweiten Etage. Eine Dauerausstellung wird im Dezember 2024 das Museum der Wehrpflichtigen ergänzen, das seinen Standort beibehält."
    ],
    "en": [
      "The Maison du Patrimoine will become the Maison des Mémoires en Beaujolais, with a continuous tour from the ground floor to the second floor. In December 2024, a permanent exhibition will be added to the museum of conscripts, which will remain in its current location."
    ],
    "it": [
      "La Maison du Patrimoine diventerà la Maison des Mémoires en Beaujolais, con un percorso continuo dal piano terra al secondo piano. Nel dicembre 2024, una mostra permanente sarà aggiunta al museo dei coscritti, che rimarrà nella sua sede attuale."
    ],
    "fr": [
      "La maison du patrimoine devient Maison des Mémoires en Beaujolais avec un parcours continu du rez-de-chaussée au deuxième étage. Une exposition permanente viendra compléter en décembre 2024 le musée des conscrits qui conserve son emplacement."
    ],
    "es": [
      "La Maison du Patrimoine se convertirá en la Maison des Mémoires en Beaujolais, con un recorrido continuo desde la planta baja hasta el segundo piso. En diciembre de 2024, se añadirá una exposición permanente al museo de reclutas, que permanecerá en su ubicación actual."
    ],
    "nl": [
      "Het Maison du Patrimoine wordt het Maison des Mémoires en Beaujolais, met een doorlopend parcours van de begane grond naar de tweede verdieping. In december 2024 wordt een permanente tentoonstelling toegevoegd aan het museum van de dienstplichtigen, dat op zijn huidige locatie blijft."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Heritage Building house"
    ],
    "fr": [
      "Maison des mémoires en Beaujolais"
    ]
  },
