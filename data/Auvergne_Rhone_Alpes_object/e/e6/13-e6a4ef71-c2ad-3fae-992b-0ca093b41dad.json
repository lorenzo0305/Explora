  "rdfs:comment": {
    "de": [
      "Ein Familienparcours zur Entdeckung des Kulturerbes, der am Rathaus beginnt und mit 14 Markierungen versehen ist, von denen sich 4 in den Gärten des Schlosses befinden (zugänglich während der Öffnungszeiten). Für jede Markierung müssen Sie eine Frage beantworten."
    ],
    "en": [
      "A family-friendly heritage trail starting from the town hall, punctuated by 14 markers, including 4 in the château gardens (accessible during opening hours). For each marker, you'll have to answer a question."
    ],
    "it": [
      "Un percorso per famiglie alla scoperta del patrimonio che parte dal municipio, con 14 segnalatori, di cui 4 nei giardini del castello (accessibili durante gli orari di apertura). Per ogni segnaletica dovrete rispondere a una domanda."
    ],
    "fr": [
      "Un parcours familial pour découvrir le patrimoine au départ de la mairie, ponctué de 14 balises, dont 4 dans les jardins du château (accessibles aux horaires d'ouverture). Pour chaque balise vous devrez répondre à une question."
    ],
    "es": [
      "Un recorrido familiar para descubrir el patrimonio a partir del ayuntamiento, con 14 marcadores, 4 de ellos en los jardines del castillo (accesibles durante las horas de apertura). Para cada marcador tendrás que responder a una pregunta."
    ],
    "nl": [
      "Een familiepad om het erfgoed te ontdekken vanaf het stadhuis, met 14 markers, waarvan 4 in de tuinen van het kasteel (toegankelijk tijdens de openingsuren). Bij elke markering moet u een vraag beantwoorden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Orientation trail in Val-de-Virieu"
    ],
    "fr": [
      "Parcours d'orientation – Val de Virieu"
    ]
  },
