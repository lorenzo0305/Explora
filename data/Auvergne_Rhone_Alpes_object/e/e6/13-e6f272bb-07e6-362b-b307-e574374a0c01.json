  "rdfs:comment": {
    "de": [
      "Im Herzen des Waldes auf einer Fläche von über 2 Hektar finden Angelfreunde ihr Glück. Besondere Vorschriften, Angelkarte des Departements und des Gewässers erforderlich."
    ],
    "en": [
      "A great spot for fans of fishing In a 2-hectare forest. Specific regulations, with departmental fishing licence and designated fishing areas."
    ],
    "it": [
      "Nel cuore della foresta, su oltre 2 ettari, gli appassionati di pesca troveranno la loro felicità. Sono richiesti regolamenti specifici, tessera di pesca dipartimentale e piano idrico."
    ],
    "fr": [
      "Au coeur de la forêt sur plus de 2 hectares, les amateurs de pêche trouveront leur bonheur. Réglementation spécifique, carte de pêche départementale et du plan d'eau obligatoire."
    ],
    "nl": [
      "In het hart van het bos op meer dan 2 hectare vinden visliefhebbers hun geluk. Specifieke voorschriften, departementale viskaart en waterplan vereist."
    ],
    "es": [
      "En el corazón del bosque, en más de 2 hectáreas, los aficionados a la pesca encontrarán su felicidad. Se requiere una normativa específica, una tarjeta de pesca departamental y un plan hidrológico."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etang du Breuil"
    ]
  },
