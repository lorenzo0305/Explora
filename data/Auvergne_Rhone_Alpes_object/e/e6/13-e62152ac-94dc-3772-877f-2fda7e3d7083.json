  "rdfs:comment": {
    "de": [
      "Willkommen in der Bar Les Seigneurs! Ein einladender und gemütlicher Ort, an dem man sich gerne trifft. Verbringen Sie entspannte und gesellige Momente bei unseren Gesellschaftsspielen, unserem Billardtisch oder unseren musikalischen Darbietungen."
    ],
    "en": [
      "Welcome to Les Seigneurs bar! A warm and welcoming place where it's nice to get together. Share moments of relaxation and conviviality around our board games, pool table, or musical entertainment."
    ],
    "it": [
      "Benvenuti al bar Les Seigneurs! Un luogo caldo e accogliente dove incontrarsi. Rilassatevi e godetevi i nostri giochi da tavolo, il tavolo da biliardo e la musica dal vivo."
    ],
    "fr": [
      "Bienvenue au bar les Seigneurs ! Un lieu accueillant et chaleureux où il fait bon se retrouver. Partagez des moments de détente et de convivialité autour de nos jeux de société, notre billard, ou encore nos animations musicales."
    ],
    "es": [
      "¡Bienvenido al bar Les Seigneurs! Un lugar de encuentro cálido y acogedor. Relájese y disfrute de nuestros juegos de mesa, mesa de billar y música en directo."
    ],
    "nl": [
      "Welkom in de bar van Les Seigneurs! Een warme en gezellige plek om elkaar te ontmoeten. Ontspan en geniet van onze gezelschapsspellen, pooltafel en livemuziek."
    ]
  },
