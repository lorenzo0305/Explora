  "rdfs:comment": {
    "de": [
      "Die Vieux Pont, auch \"römische Brücke\" genannt, ist Teil des baulichen Erbes von Thônes. Sie überspannt den Fluss Le Nom."
    ],
    "en": [
      "The Old Bridge, known as the \"Roman bridge\", is part of the built heritage of Thônes. It spans the river Name."
    ],
    "it": [
      "Il Ponte Vecchio, noto come \"Ponte Romano\", fa parte del patrimonio edilizio di Thônes. Attraversa il fiume Nom."
    ],
    "fr": [
      "Le Vieux Pont dit \"pont romain\" fait partie du patrimoine bâti de Thônes. Il enjambe la rivière le Nom."
    ],
    "es": [
      "El Puente Viejo, conocido como \"Puente Romano\", forma parte del patrimonio construido de Thônes. Atraviesa el río Nom."
    ],
    "nl": [
      "De Oude Brug, bekend als de \"Romeinse Brug\", maakt deel uit van het gebouwde erfgoed van Thônes. Het overspant de rivier de Nom."
    ]
