  "rdfs:comment": {
    "de": [
      "Die warme und freundliche Atmosphäre in diesem Restaurant sorgt dafür, dass sich die Besucher wohlfühlen und eine gute Zeit verbringen. Eine Speisekarte, die durch ihre frischen & lokalen Produkte (direkt von einigen Erzeugern) hervorgehoben wird."
    ],
    "en": [
      "The warm, friendly atmosphere of this restaurant makes customers feel good and have a good time. A menu highlighted by fresh and local produce (direct from some producers)."
    ],
    "it": [
      "L'atmosfera calda e accogliente di questo ristorante fa sì che i visitatori si sentano bene e si divertano. Un menu che si distingue per i suoi prodotti freschi e locali (direttamente da alcuni produttori)."
    ],
    "fr": [
      "L'atmosphère chaleureuse et conviviale de ce restaurant fait que les visiteurs se sentent bien et passent du bon temps. Une carte mise en valeur par ses produits frais & locaux (en direct avec certains producteurs)."
    ],
    "es": [
      "El ambiente cálido y acogedor de este restaurante hace que los visitantes se sientan bien y disfruten. Una carta que destaca por sus productos frescos y locales (directos de algunos productores)."
    ],
    "nl": [
      "De warme, vriendelijke sfeer van dit restaurant zorgt ervoor dat klanten zich goed voelen en het naar hun zin hebben. Een menu met verse en lokale producten (rechtstreeks van enkele producenten)."
    ]
  },
  "rdfs:label": {
