  "rdfs:comment": {
    "de": [
      "Rémi und Antoine begrüßen Sie in ihrer Bar mit gemütlicher Atmosphäre, die sich auf dem zentralen Platz des Ortes befindet. Genießen Sie hier köstliche Pizzen, die von Max, dem Pizzabäcker, hausgemacht werden!"
    ],
    "en": [
      "Rémi and Antoine welcome you to their friendly bar in the resort's central square. Come and enjoy delicious homemade pizzas made by Max, the pizza chef!"
    ],
    "it": [
      "Rémi e Antoine vi danno il benvenuto nel loro accogliente bar nella piazza centrale del resort. Venite a gustare le deliziose pizze fatte in casa da Max, il pizzaiolo!"
    ],
    "fr": [
      "Rémi et Antoine vous accueillent dans leur bar à l'ambiance chaleureuse, situé sur la place centrale de la station. Venez y déguster de délicieuses pizzas faites maison par Max, le pizzaolo !"
    ],
    "es": [
      "Rémi y Antoine te dan la bienvenida a su acogedor bar en la plaza central de la estación. Disfrute de las deliciosas pizzas caseras de Max, el pizzero"
    ],
    "nl": [
      "Rémi en Antoine heten je welkom in hun gezellige bar op het centrale plein van het resort. Kom genieten van de heerlijke zelfgemaakte pizza's gemaakt door Max, de pizzabakker!"
    ]
  },
  "rdfs:label": {
