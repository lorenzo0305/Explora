  "rdfs:comment": {
    "de": [
      "Zusammenschluss einer Musikschule, eines Theaters, eines Blasorchesters, einer Künstlergruppe \"Les Javeysans\" und mehrerer Musikgruppen.\r\nVeranstalter von Konzerten und Aufführungen im Rahmen der Kultursaison der Gemeinde Saint-Marcel."
    ],
    "en": [
      "Grouping together a music and theater school, a wind band, an artistic troupe \"Les Javeysans\" and several musical groups.\r\nOrganizers of concerts and shows as part of Saint-Marcel's cultural season."
    ],
    "it": [
      "Raggruppamento di una scuola di musica, una scuola di teatro, una banda di fiati, una troupe artistica \"Les Javeysans\" e diversi gruppi musicali.\r\nOrganizzatori di concerti e spettacoli, nell'ambito della stagione culturale della città di Saint-Marcel."
    ],
    "fr": [
      "Regroupement d'une école de musique, de théâtre, d'un orchestre d’harmonie, une troupe artistique « Les Javeysans » et plusieurs groupes musicaux.\r\nOrganisateurs de concerts et spectacle, dans le cadre de la saison culturelle de la commune de Saint-Marcel."
    ],
    "nl": [
      "Een muziek- en toneelschool, een harmonieorkest, een artistiek gezelschap \"Les Javeysans\" en verschillende muziekgroepen.\r\nOrganisatoren van concerten en voorstellingen in het kader van het culturele seizoen van Saint-Marcel."
    ],
    "es": [
      "Agrupación de una escuela de música, una escuela de teatro, una banda de viento, una compañía artística \"Les Javeysans\" y varios grupos musicales.\r\nOrganizadores de conciertos y espectáculos, en el marco de la temporada cultural de la ciudad de Saint-Marcel."
    ]
  },
  "rdfs:label": {
