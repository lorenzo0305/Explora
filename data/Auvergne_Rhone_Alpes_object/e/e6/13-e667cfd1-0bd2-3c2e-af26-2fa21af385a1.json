  "rdfs:comment": {
    "de": [
      "Dieses Cocooning-Spa verbindet alpine Ästhetik mit einem klaren Design und bietet 3 Massagekabinen, in denen Sie sich mit einer Auswahl an entspannenden Behandlungen und Ritualen auf der Basis von Mineralien und Pflanzen aus den Bergen verwöhnen können."
    ],
    "en": [
      "Combining Alpine aesthetics with a refined design, this cocooning spa offers 3 massage cabins to pamper yourself with a wide choice of treatments and relaxing rituals based on minerals and mountain plants."
    ],
    "it": [
      "Combinando l'estetica alpina con un design raffinato, questa spa cocooning offre 3 cabine massaggi per coccolarsi con un'ampia scelta di trattamenti e rituali rilassanti a base di minerali e piante di montagna."
    ],
    "fr": [
      "Mêlant l’esthétisme alpin à un design épuré, ce spa cocooning propose 3 cabines de massage pour prendre soin de soi grâce à un choix pointu de soins et rituels relaxants à base de minéraux et de plantes de montagne."
    ],
    "nl": [
      "Deze cocooning spa combineert alpine esthetiek met een verfijnd ontwerp en biedt 3 massagecabines waar je jezelf kunt verwennen met een selectie ontspannende behandelingen en rituelen op basis van mineralen en planten uit de bergen."
    ],
    "es": [
      "Combinando la estética alpina con un diseño refinado, este acogedor spa ofrece 3 cabinas de masaje donde podrá mimarse con una selección de relajantes tratamientos y rituales basados en minerales y plantas de montaña."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pure Altitude Spa"
    ],
    "it": [
      "Pure Altitude Spa"
    ],
    "fr": [
      "Spa Pure Altitude"
    ]
  },
