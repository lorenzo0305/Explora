  "rdfs:comment": {
    "de": [
      "In der Mediathek von Vic sur Cère können Sie das ganze Jahr über Bücher, CDs, DVDs, Spiele, Zeitschriften und IGN-Karten konsultieren und ausleihen. Kostenloser Multimedia-Bereich mit 3 Computerarbeitsplätzen. Die Mediathek bietet auch ein Animationsprogramm an."
    ],
    "en": [
      "The Vic sur Cère media library welcomes you all year round to consult and borrow books, CDs, DVDs, games, magazines and IGN maps. Free multimedia area, with 3 computer stations. The library also offers a program of events."
    ],
    "it": [
      "La biblioteca multimediale di Vic sur Cère vi accoglie tutto l'anno per consultare e prendere in prestito libri, CD, DVD, giochi, riviste e mappe IGN. Area multimediale gratuita, con 3 postazioni informatiche. La biblioteca offre anche un programma di eventi."
    ],
    "fr": [
      "La médiathèque de Vic sur Cère vous accueille toute l'année pour des consultations et prêts de livres, CD, DVD, jeux, revues, cartes IGN. Espace multimedia gratuit, avec 3 postes informatiques. La médiathèque propose également un programme d'animations."
    ],
    "es": [
      "La biblioteca multimedia de Vic sur Cère le acoge todo el año para consultar y tomar prestados libros, CD, DVD, juegos, revistas y mapas IGN. Espacio multimedia gratuito, con 3 puestos informáticos. La biblioteca también ofrece un programa de actos."
    ],
    "nl": [
      "In de mediatheek van Vic sur Cère kun je het hele jaar door boeken, cd's, dvd's, games, tijdschriften en IGN-kaarten raadplegen en lenen. Gratis multimediaruimte met 3 computerwerkplekken. De bibliotheek biedt ook een evenementenprogramma."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vic sur Cère Municipal Media Library"
    ],
    "fr": [
      "Médiathèque Municipale de Vic sur Cère"
    ],
