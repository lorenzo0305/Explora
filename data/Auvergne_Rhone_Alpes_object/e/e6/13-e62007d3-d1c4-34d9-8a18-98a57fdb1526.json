  "rdfs:comment": {
    "de": [
      "Dieses traditionelle und raffinierte Restaurant mit dem Gütesiegel \"Maître Restaurateur\" bietet vor Ort zubereitete Gerichte aus frischen und hochwertigen Produkten, die über kurze Wege eingekauft werden."
    ],
    "en": [
      "This traditional, refined restaurant, which has been awarded the Maître Restaurateur label, offers dishes cooked on the premises using fresh, quality produce purchased from local suppliers."
    ],
    "it": [
      "Questo ristorante tradizionale e raffinato, che ha ottenuto il marchio Maître Restaurateur, serve piatti cucinati in loco con prodotti freschi e di qualità acquistati da fornitori locali."
    ],
    "fr": [
      "Ce restaurant traditionnel et raffiné, labellisé Maître Restaurateur, propose des plats cuisinés sur place à base de produits frais et de qualité achetés en circuit court."
    ],
    "es": [
      "Este restaurante tradicional y refinado, galardonado con el sello Maître Restaurateur, sirve platos cocinados en el propio establecimiento con productos frescos y de calidad adquiridos a proveedores locales."
    ],
    "nl": [
      "Dit traditionele, verfijnde restaurant, dat het label Maître Restaurateur heeft gekregen, serveert gerechten die ter plekke worden bereid met verse kwaliteitsproducten van lokale leveranciers."
    ]
  },
