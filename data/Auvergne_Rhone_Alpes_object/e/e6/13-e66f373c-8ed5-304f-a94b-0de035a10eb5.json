  "rdfs:comment": {
    "de": [
      "Im Laufe der Jahreszeiten lädt Sie das Restaurant Les Jardins de Saulzet dazu ein, die Gerichte zu entdecken, aus denen sich seine Welt rund um die Produkte der Region und eine traditionelle Küche zusammensetzt."
    ],
    "en": [
      "As the seasons go by, Les Jardins de Saulzet invites you to discover the dishes that make up its universe, based on local produce and traditional cuisine."
    ],
    "it": [
      "Con il passare delle stagioni, Les Jardins de Saulzet vi invita a scoprire i piatti che compongono il suo mondo di prodotti locali e cucina tradizionale."
    ],
    "fr": [
      "Au fil des saisons, le restaurant Les Jardins de Saulzet vous invite à venir découvrir les plats qui composent son univers autour de produits issus du terroir et d’une cuisine traditionnelle."
    ],
    "nl": [
      "Naarmate de seizoenen verstrijken, nodigt Les Jardins de Saulzet je uit om de gerechten te komen ontdekken die deel uitmaken van zijn wereld van streekproducten en traditionele gerechten."
    ],
    "es": [
      "Con el paso de las estaciones, Les Jardins de Saulzet le invitan a descubrir los platos que componen su universo de productos locales y cocina tradicional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant les Jardins de Saulzet"
    ]
  },
