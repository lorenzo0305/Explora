  "rdfs:comment": {
    "de": [
      "Die Landschaft als Kulisse, eine authentische und großzügige Küche auf dem Teller mit der Spezialität, dass die Gerichte im Holzofen zubereitet werden."
    ],
    "en": [
      "Varied \"menu of the day\" made with local products. A pleasant and shady terrace in the summer for a drink or to enjoy a dish of fried fish or frogs legs. Free access to WiFi."
    ],
    "it": [
      "La campagna come sfondo, una cucina autentica e generosa nel piatto con come specialità piatti preparati nel forno a legna."
    ],
    "fr": [
      "La campagne comme décor, une cuisine authentique et généreuse dans l'assiette avec comme spécialité, des plats préparés au four à bois."
    ],
    "nl": [
      "Het platteland als decor, een authentieke en royale keuken op het bord met als specialiteit, gerechten bereid in een houtoven."
    ],
    "es": [
      "El campo como telón de fondo, una cocina auténtica y generosa en el plato con como especialidad, platos preparados en horno de leña."
    ]
  },
