  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Pierre befindet sich am Rande der Route Napoléon.\r\nIn der Nähe befindet sich das Rathaus, das in einem bemerkenswerten Gebäude untergebracht ist, bei dem es sich um das ehemalige Pfarrhaus handelt."
    ],
    "en": [
      "Saint-Pierre Church stands beside the Route Napoléon. Next to it, you can admire the Mairie housed in a remarkable building that is actually the former presbytery."
    ],
    "it": [
      "La chiesa di Saint-Pierre si trova sulla Route Napoléon.\r\nNelle vicinanze si trova il Municipio, ospitato in un notevole edificio che non è altro che l'antica chiesa parrocchiale."
    ],
    "fr": [
      "L’église Saint-Pierre se trouve au bord de la Route Napoléon.\r\nA proximité vous apercevrez la Mairie, installée dans un batiment remarquable qui n'est autre que l'ancienne cure."
    ],
    "es": [
      "La iglesia de Saint-Pierre se alza en la Route Napoléon.\r\nEn las inmediaciones se encuentra la Mairie (Ayuntamiento), que ocupa un notable edificio que fue la antigua vicaría."
    ],
    "nl": [
      "De kerk Saint-Pierre ligt aan de Route Napoléon.\r\nVlakbij ziet u het stadhuis, gevestigd in een opmerkelijk gebouw dat niemand minder is dan de oude parochiekerk."
    ]
  },
  "rdfs:label": {
