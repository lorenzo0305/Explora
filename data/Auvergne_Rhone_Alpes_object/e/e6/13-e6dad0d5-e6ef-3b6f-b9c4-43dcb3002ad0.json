  "rdfs:comment": {
    "de": [
      "Der Rocher des Deux Soeurs, der den Berg oberhalb des Dorfes Rochefort-Samson krönt, ist eine der wichtigsten Sehenswürdigkeiten der Monts du Matin. Er wird auch \"Die Mumie\" oder \"Der liegende Mann\" genannt. Wandermöglichkeiten."
    ],
    "en": [
      "The Rocher des Deux Soeurs, which crowns the mountain above the village of Rochefort-Samson, is a landmark of the Monts du Matin. It is also known as \"La momie\" or \"L'homme couché\". Hiking possibilities."
    ],
    "it": [
      "Il Rocher des Deux Soeurs, che corona la montagna sopra il villaggio di Rochefort-Samson, è un sito chiave dei Monts du Matin. È noto anche come \"La mummia\" o \"L'uomo sdraiato\". Possibilità di escursioni."
    ],
    "fr": [
      "Le Rocher des Deux Soeurs, qui couronne la montagne située au dessus du village de Rochefort-Samson, constitue un site phare des Monts du Matin. Il est aussi appelé \"La momie\" ou encore \"L'homme couché\". Possibilité de randonnées."
    ],
    "es": [
      "El Rocher des Deux Soeurs, que corona la montaña por encima del pueblo de Rochefort-Samson, es un lugar clave de los Monts du Matin. También se le conoce como \"La Momia\" o \"El Hombre Reclinado\". Posibilidades de practicar senderismo."
    ],
    "nl": [
      "De Rocher des Deux Soeurs, die de berg boven het dorp Rochefort-Samson bekroont, is een belangrijke plek in de Monts du Matin. Het staat ook bekend als \"De Mummie\" of \"De Liggende Man\". Wandelmogelijkheden."
    ]
  },
  "rdfs:label": {
