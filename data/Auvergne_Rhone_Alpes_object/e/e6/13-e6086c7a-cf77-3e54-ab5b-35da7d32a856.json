  "rdfs:comment": {
    "de": [
      "Der Verein D?Aurienchons setzt sich für die Aufwertung des Kulturerbes von Auris-en-Oisans, die Entwicklung der Weiler und die Erhaltung ihrer Umwelt und ihres Charmes ein.\r\nDer Verein bietet das ganze Jahr über Veranstaltungen an."
    ],
    "en": [
      "The D'Aurienchons association works to promote the heritage of Auris-en-Oisans, the development of the hamlets and the preservation of their environment and charm.\r\nIt organizes events throughout the year."
    ],
    "it": [
      "L'associazione D'Aurienchons lavora per promuovere il patrimonio di Auris-en-Oisans, lo sviluppo delle frazioni e la conservazione del loro ambiente e del loro fascino.\r\nOrganizza eventi durante tutto l'anno."
    ],
    "fr": [
      "L’association D’Aurienchons œuvre pour la valorisation du patrimoine d’Auris-en-Oisans, le développement des hameaux et la préservation de leur environnement et de leur charme.\r\nElle propose tout au long de l’année des évènements."
    ],
    "es": [
      "La asociación D'Aurienchons trabaja para promover el patrimonio de Auris-en-Oisans, el desarrollo de las aldeas y la conservación de su entorno y encanto.\r\nOrganiza actos durante todo el año."
    ],
    "nl": [
      "De vereniging D'Aurienchons zet zich in voor de promotie van het erfgoed van Auris-en-Oisans, de ontwikkeling van de gehuchten en het behoud van hun omgeving en charme.\r\nZe organiseert het hele jaar door evenementen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association d'Aurienchons"
    ]
  },
