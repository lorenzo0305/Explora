  "rdfs:comment": {
    "de": [
      "Spielen Sie Tennis in einer schönen natürlichen Umgebung. Der gepflegte Platz befindet sich im Herzen des Freizeitgebiets von Albiez-le-Jeune: Wasserfläche, Spielplatz, Picknicktische? Es besteht die Möglichkeit, sich für ein Jahr anzumelden oder gelegentlich zu spielen."
    ],
    "en": [
      "Come and play tennis in a beautiful natural setting. This well-maintained court is located in the heart of the Albiez-le-Jeune recreation area, with a lake, playground and picnic tables. You can sign up for the year or play occasionally."
    ],
    "it": [
      "Venite a giocare a tennis in una splendida cornice naturale. Questo campo ben curato si trova nel cuore dell'area ricreativa di Albiez-le-Jeune, con un lago, un parco giochi e tavoli da picnic È possibile iscriversi per tutto l'anno o giocare di tanto in tanto."
    ],
    "fr": [
      "Venez jouer eu tennis dans un beau cadre naturel. Ce court bien entretenu est situé au cœur de la zone de loisirs d'Albiez-le-Jeune : plan d'eau, aire de jeux, tables de pique-nique… Possibilité de s'inscrire à l'année ou bien de jouer ponctuellement."
    ],
    "es": [
      "Venga a jugar al tenis en un bello entorno natural. Esta pista en buen estado se encuentra en el corazón de la zona de ocio de Albiez-le-Jeune, con un lago, parque infantil y mesas de picnic Puede inscribirse para todo el año o jugar de vez en cuando."
    ],
    "nl": [
      "Kom tennissen in een prachtige natuurlijke omgeving. Deze goed onderhouden baan ligt in het hart van het recreatiegebied Albiez-le-Jeune, met een meer, speeltuin en picknicktafels Je kunt je voor het hele jaar inschrijven of af en toe spelen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tennis court"
    ],
    "fr": [
      "Terrain de tennis"
    ]
  },
