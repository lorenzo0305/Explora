  "rdfs:comment": {
    "de": [
      "Einmal im Monat treffen wir uns im Haus der kleinen Bären, wo es Reime, Geschichten und Fingerspiele gibt, denn Bücher sind gut für Babys Diese Veranstaltung steht allen Eltern und Nannys offen und ist eine besondere Zeit für die Kleinsten."
    ],
    "en": [
      "Once a month, meet up at the Little Bears' House for nursery rhymes, stories and fingerplays, because books \"are good for babies! Open to all, parents and nannies alike, this is a special time for little ones."
    ],
    "it": [
      "Una volta al mese, appuntamento alla Casa degli Orsetti per filastrocche, storie e giochi di dita, perché i libri \"fanno bene ai bambini\" Aperto a tutti, genitori e tate, questo è un momento speciale per i più piccoli."
    ],
    "fr": [
      "Une fois par mois, rendez-vous à la maison des petits ours, comptines, histoires et jeux de doigts, parce que les livres « c’est bon pour les bébés ! » Ouvert à tous, parents, nounous, un temps privilégié pour les tout-petits."
    ],
    "es": [
      "Una vez al mes, reúnase en la Casa de los Ositos para escuchar canciones infantiles, cuentos y juegos de dedos, porque los libros son \"buenos para los bebés\" Abierto a todos, padres y niñeras por igual, es un momento especial para los más pequeños."
    ],
    "nl": [
      "Eens per maand kun je in het Kleine Berenhuis terecht voor kinderliedjes, verhaaltjes en vingerspelletjes, want boeken zijn \"goed voor baby's\" Open voor iedereen, zowel ouders als kindermeisjes, dit is een speciaal moment voor de allerkleinsten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison des petits ours"
    ]
  },
