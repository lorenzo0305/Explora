  "rdfs:comment": {
    "de": [
      "Dieses Kino ist von Arc 1800 aus im Sommer über die Route des Espagnols in 15 Minuten und im Winter mit dem kostenlosen Pendelbus erreichbar und ist mit einem digitalen Projektionssystem ausgestattet.\r\nZusätzliche Vorführung bei schlechtem Wetter. Saal mit 150 Plätzen."
    ],
    "en": [
      "Accessible from Arc 1800 in 15 minutes by the Route des Espagnols in summer and by the free shuttle bus in winter, this cinema is equipped with a digital projection system.\r\nExtra showings in case of bad weather. Seats 150."
    ],
    "it": [
      "Raggiungibile da Arc 1800 in 15 minuti con la Route des Espagnols in estate e con il bus navetta gratuito in inverno, questo cinema è dotato di un sistema di proiezione digitale.\r\nProiezioni supplementari in caso di maltempo. Posti a sedere 150."
    ],
    "fr": [
      "Accessible depuis Arc 1800 en 15mn par la route des Espagnols l'été et par la navette gratuite l'hiver, ce cinéma est équipé d'un système de projection numérique.\r\nSéance supplémentaire en cas de mauvais temps. Salle de 150 places."
    ],
    "nl": [
      "Deze bioscoop is bereikbaar vanaf Arc 1800 in 15 minuten via de Route des Espagnols in de zomer en met de gratis pendelbus in de winter en is uitgerust met een digitaal projectiesysteem.\r\nExtra voorstellingen bij slecht weer. 150 zitplaatsen."
    ],
    "es": [
      "Accesible desde Arc 1800 en 15 minutos por la Route des Espagnols en verano y por el autobús lanzadera gratuito en invierno, este cine está equipado con un sistema de proyección digital.\r\nProyecciones suplementarias en caso de mal tiempo. 150 plazas."
    ]
  },
