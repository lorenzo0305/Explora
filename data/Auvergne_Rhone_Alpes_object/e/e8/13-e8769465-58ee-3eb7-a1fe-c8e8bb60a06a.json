  "rdfs:comment": {
    "de": [
      "Das Restaurant du Port de Tougues ist ein Lokal, das sich seit seiner Eröffnung dafür entschieden hat, Ihnen hauptsächlich Fische anzubieten, die im Genfer See gefangen wurden."
    ],
    "en": [
      "The Restaurant of the Port of Tougues is an establishment which chose from its opening to propose you mainly fishes fished in the Geneva Lake."
    ],
    "it": [
      "Il Restaurant du Port de Tougues è un locale che fin dalla sua apertura ha scelto di offrire soprattutto pesce pescato nel lago di Ginevra."
    ],
    "fr": [
      "Le Restaurant du Port de Tougues est un établissement qui a fait le choix dès son ouverture de vous proposer principalement des poissons pêchés dans le Lac Léman."
    ],
    "nl": [
      "Het Restaurant du Port de Tougues is een etablissement dat er sinds zijn opening voor heeft gekozen u voornamelijk vis aan te bieden die in het meer van Genève is gevangen."
    ],
    "es": [
      "El Restaurant du Port de Tougues es un establecimiento que ha optado desde su apertura por ofrecerle principalmente pescado capturado en el lago Lemán."
    ]
  },
