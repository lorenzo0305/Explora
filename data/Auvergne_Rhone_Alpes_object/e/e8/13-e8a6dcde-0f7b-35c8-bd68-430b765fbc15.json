  "rdfs:comment": {
    "de": [
      "Festsaal \"Maison des Associations\" am Ufer des Allier. Die zur Verfügung gestellten Räumlichkeiten umfassen: 37 Tische, 120 Stühle und 2 Garderobenständer. Ausgestattete Küche: Küchenklavier, Backofen, zwei Kühlschränke, ein Gefrierschrank. Kein Geschirr."
    ],
    "en": [
      "Salle des Fêtes \"Maison des Associations\" on the banks of the Allier. Facilities include: 37 tables, 120 chairs and 2 coat racks. Fully equipped kitchen: cooking piano, oven, two refrigerators, one freezer. No crockery."
    ],
    "it": [
      "Salle des Fêtes \"Maison des Associations\" sulle rive dell'Allier. I locali comprendono: 37 tavoli, 120 sedie e 2 appendiabiti. Cucina completamente attrezzata: piano cottura, forno, due frigoriferi e un congelatore. Non ci sono stoviglie."
    ],
    "fr": [
      "Salle des Fêtes \"Maison des Associations\" au bord de l'Allier. Les locaux mis à disposition comprennent : 37 Tables, 120 chaises et 2 porte-manteaux. Cuisine équipée : piano de cuisine, four, deux réfrigérateurs, un congélateur. Pas de vaisselle."
    ],
    "nl": [
      "Salle des Fêtes \"Maison des Associations\" aan de oevers van de Allier. De lokalen omvatten: 37 tafels, 120 stoelen en 2 kapstokken. Volledig uitgeruste keuken: kookpiano, oven, twee koelkasten en een vriezer. Geen serviesgoed."
    ],
    "es": [
      "Sala de Fiestas \"Maison des Associations\" a orillas del Allier. El local incluye: 37 mesas, 120 sillas y 2 percheros. Cocina totalmente equipada: piano de cocina, horno, dos frigoríficos y un congelador. No hay vajilla."
    ]
  },
  "rdfs:label": {
