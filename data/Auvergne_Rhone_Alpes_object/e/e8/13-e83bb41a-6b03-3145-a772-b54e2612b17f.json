  "rdfs:comment": {
    "de": [
      "Café-Restaurant und Feinkostladen in ruhiger Lage im Dorf Belmont d'Azergues, im Herzen der Pierres Dorées, mit außergewöhnlichem Blick auf das Tal. Traditionelle hausgemachte Küche, die sich mit den Jahreszeiten verändert."
    ],
    "en": [
      "A café-restaurant-catering quietly located in the village of Belmont d'Azergues, in the heart of Pierres Dorées, with an exceptional view over the valley.  Traditional home-made food,  evolving according to the seasons."
    ],
    "it": [
      "Caffè ristorante catering situato in una zona tranquilla nel villaggio di Belmont d'Azergues, nel cuore delle Pierres Dorées, con una vista eccezionale sulla valle. Cucina tradizionale casalinga, che si evolve con le stagioni."
    ],
    "fr": [
      "Café restaurant traiteur situé au calme, dans le village de Belmont d'Azergues, au coeur des Pierres Dorées, avec vue exceptionnelle sur la vallée. Cuisine traditionnelle maison, évoluant au fil des saisons."
    ],
    "es": [
      "Café-restaurante situado en una zona tranquila en el pueblo de Belmont d'Azergues, en el corazón de las Pierres Dorées, con una vista excepcional del valle. Cocina casera tradicional, que evoluciona con las estaciones."
    ],
    "nl": [
      "Café restaurant traiteur gelegen in een rustige omgeving in het dorp Belmont d'Azergues, in het hart van de Pierres Dorées, met een uitzonderlijk uitzicht op de vallei. Traditionele huisgemaakte keuken, evoluerend met de seizoenen."
    ]
  },
  "rdfs:label": {
