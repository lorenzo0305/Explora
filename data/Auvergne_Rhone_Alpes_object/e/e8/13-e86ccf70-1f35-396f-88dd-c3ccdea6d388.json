  "rdfs:comment": {
    "de": [
      "Jean-Claude Bétemps, Erfinder des Gleitschirmfliegens im Juni 1978, und sein Team, das sich auf den zweisitzigen Entdeckungsflug spezialisiert hat, werden sich freuen, Ihnen ihre Erfahrungen und ihre Leidenschaft mitzuteilen"
    ],
    "en": [
      "Jean-Claude Bétemps, inventor of paragliding in June 1978, and his team specializing in bi-place discovery flying, will be happy to share their experience and passion with you."
    ],
    "it": [
      "Jean-Claude Bétemps, che ha inventato il parapendio nel giugno 1978, e il suo team, specializzato in voli di scoperta per grandi e piccini, saranno lieti di condividere con voi la loro esperienza e passione. A partire da 100 euro (foto, video e gondola inclusi)."
    ],
    "fr": [
      "Jean-Claude Bétemps, inventeur du parapente en Juin 1978, et son équipe spécialiste du vol découverte pour petits et grands, seront heureux de vous faire partager leur expérience et leur passion. A partir de 100€ (photo, vidéo, télécabine offerts)."
    ],
    "nl": [
      "Jean-Claude Bétemps, uitvinder van het paragliden in juni 1978, en zijn team, gespecialiseerd in ontdekkingsvluchten voor jong en oud, delen graag hun ervaring en passie met je. Vanaf € 100 (inclusief foto, video en gondel)."
    ],
    "es": [
      "Jean-Claude Bétemps, inventor del parapente en junio de 1978, y su equipo, especializado en vuelos de descubrimiento para grandes y pequeños, estarán encantados de compartir con usted su experiencia y su pasión. A partir de 100 € (incluye foto, vídeo y góndola)."
    ]
  },
