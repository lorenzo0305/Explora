  "rdfs:comment": {
    "de": [
      "Wir haben La Ferme du Bourbouilloux mit einer klaren Vision gegründet: gesunde und schmackhafte Bio-Pilze zu produzieren und dabei die Umwelt zu schonen und nachhaltige Praktiken zu fördern."
    ],
    "en": [
      "We created La Ferme du Bourbouilloux with a clear vision: to produce healthy, tasty organic mushrooms, while respecting the environment and promoting sustainable practices."
    ],
    "it": [
      "Abbiamo creato La Ferme du Bourbouilloux con una visione chiara: produrre funghi biologici sani e gustosi, rispettando l'ambiente e promuovendo pratiche sostenibili."
    ],
    "fr": [
      "Nous avons créé La Ferme du Bourbouilloux avec une vision claire : produire des champignons bio, sains et savoureux, tout en respectant l'environnement et en favorisant des pratiques durables."
    ],
    "nl": [
      "We hebben La Ferme du Bourbouilloux opgericht met een duidelijke visie: gezonde, lekkere biologische champignons produceren, met respect voor het milieu en met aandacht voor duurzame praktijken."
    ],
    "es": [
      "Creamos La Ferme du Bourbouilloux con una visión clara: producir setas ecológicas sanas y sabrosas, respetando el medio ambiente y promoviendo prácticas sostenibles."
    ]
  },
  "rdfs:label": {
