  "rdfs:comment": {
    "de": [
      "Bukolischer Spaziergang, ideal für die Familie. Mountainbike oder Fahrrad empfohlen. Gemeinsame Nutzung durch Fußgänger (mit Hunden) und Radfahrer. Lineare Route mit verschiedenen Ausblicken: Ebene und Alpen auf dem Hinweg, Jura auf dem Rückweg."
    ],
    "en": [
      "A bucolic walk ideal for families. Mountain bikes recommended. Shared between pedestrians (with dogs) and cyclists. Linear route with varied views: plain and Alps on the way out, Jura on the way back."
    ],
    "it": [
      "Una passeggiata bucolica ideale per le famiglie. Si consigliano le mountain bike. Condivisa tra pedoni (con cani) e ciclisti. Percorso lineare con panorami variegati: pianura e Alpi all'andata, Giura al ritorno."
    ],
    "fr": [
      "Balade bucolique idéale en famille. VTT ou VTC conseillés. Partagée entre piétons (avec chiens) et cyclistes. Itinéraire linéaire aux vues variées : plaine et Alpes à l’aller, Jura au retour."
    ],
    "es": [
      "Un paseo bucólico ideal para familias. Se recomiendan las bicicletas de montaña. Recorrido compartido entre peatones (con perros) y ciclistas. Recorrido lineal con vistas variadas: llanura y Alpes a la ida, Jura a la vuelta."
    ],
    "nl": [
      "Een landelijke wandeling, ideaal voor gezinnen. Mountainbikes aanbevolen. Gedeeld tussen voetgangers (met honden) en fietsers. Rechtlijnige route met gevarieerde uitzichten: vlakte en Alpen op de heenweg, Jura op de terugweg."
    ]
  },
  "rdfs:label": {
    "de": [
      "Grüner Weg: Gex-Divonne, über die alte Eisenbahnstrecke"
    ],
    "en": [
      "Voie verte: Gex-Divonne, along the old railroad line"
    ],
    "fr": [
      "Voie verte : Gex-Divonne, par l'ancienne voie ferrée"
    ]
  },
