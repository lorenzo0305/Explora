  "rdfs:comment": {
    "de": [
      "In einem Raum mit traditionellem Gestell werden lokale Produkte in einer Küche verarbeitet, die für die Kundschaft sichtbar ist und in einer gemütlichen Atmosphäre genossen werden kann.\r\nCrêpes werden auf Bestellung hergestellt."
    ],
    "en": [
      "In a traditionally built room, local products are prepared in a kitchen visible to customers, and enjoyed in a warm atmosphere.\r\nPancakes made to order."
    ],
    "it": [
      "In un edificio tradizionale, i prodotti locali vengono lavorati in una cucina visibile alla clientela e degustati in un'atmosfera accogliente.\r\nPancake preparati su ordinazione."
    ],
    "fr": [
      "Dans une salle de bâti traditionnel, les produits locaux sont travaillés dans une cuisine visible de la clientèle, et à déguster dans une ambiance chaleureuse.\r\nCrêpes réalisées à la commande."
    ],
    "nl": [
      "In een traditionele bouwzaal worden in een voor de clientèle zichtbare keuken streekproducten bewerkt en in een warme sfeer geproefd.\r\nPannenkoeken op bestelling."
    ],
    "es": [
      "En una sala de construcción tradicional, los productos locales se trabajan en una cocina visible para la clientela, y se degustan en un ambiente cálido.\r\nTortitas por encargo."
    ]
  },
  "rdfs:label": {
    "en": [
      "Crêperie le Montel"
    ],
    "fr": [
      "Crêperie le Montel"
    ]
  },
