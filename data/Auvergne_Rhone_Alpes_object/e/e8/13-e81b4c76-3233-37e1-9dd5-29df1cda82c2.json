  "rdfs:comment": {
    "de": [
      "Ab dem Grand Port von Aix-les-Bains führt Sie dieser Weg am Ufer des größten natürlichen Sees Frankreichs entlang.\r\nEin Angebot, das für möglichst viele Menschen geeignet ist, insbesondere für Senioren und Familien mit Kinderwagen und Kleinkindern."
    ],
    "en": [
      "Starting from the Grand Port d'Aix les Bains, this walk will take you alongside France's largest natural lake.  The itinerary is suitable for all-comers, in particular the elderly and families with young children in buggies."
    ],
    "it": [
      "Partendo dal Grand Port di Aix-les-Bains, questo percorso si snoda lungo le rive del più grande lago naturale della Francia.\r\nÈ adatto a tutti, soprattutto agli anziani e alle famiglie con passeggini e bambini piccoli."
    ],
    "fr": [
      "À partir du Grand Port d'Aix-les-Bains, ce cheminement vous conduit en bordure du plus grand lac naturel de France.\r\nUne offre adaptée au plus grand nombre et en particulier aux séniors et familles avec poussettes enfants en bas âge."
    ],
    "nl": [
      "Dit pad begint bij de Grand Port in Aix-les-Bains en neemt je mee langs de oevers van het grootste natuurlijke meer van Frankrijk.\r\nHet is geschikt voor iedereen, vooral senioren en gezinnen met kinderwagens en kleine kinderen."
    ],
    "es": [
      "Con salida del Grand Port de Aix-les-Bains, este sendero recorre las orillas del mayor lago natural de Francia.\r\nEs apto para todo el mundo, especialmente para personas mayores y familias con carritos de bebé y niños pequeños."
    ]
  },
  "rdfs:label": {
    "en": [
      "Easy-going walk: On the water's edge"
    ],
    "fr": [
      "Promenade confort : Au fil de l'eau"
    ],
    "nl": [
      "Comfortabele wandeling: Langs het water"
    ]
  },
