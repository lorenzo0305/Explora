  "rdfs:comment": {
    "de": [
      "In den Monts d'Ardèche teilen sich drei Keramikerinnen ein kreatives Atelier und einen Ausstellungsraum: Michèle Novak, Maïa Ballot und Valérie Calvat.\r\nÖffnung nach Vereinbarung außerhalb der Öffnungszeiten möglich."
    ],
    "en": [
      "In the Monts d'Ardèche, three ceramists share a studio and exhibition space: Michèle Novak, Maïa Ballot and Valérie Calvat.\r\nOpen by appointment outside opening hours."
    ],
    "it": [
      "Nei Monts d'Ardèche, tre ceramiste condividono uno studio e uno spazio espositivo: Michèle Novak, Maïa Ballot e Valérie Calvat.\r\nAperto su appuntamento al di fuori degli orari di apertura."
    ],
    "fr": [
      "Dans les Monts d'Ardèche, trois céramistes partagent un atelier de création et un espace d'exposition : Michèle Novak, Maïa Ballot et Valérie Calvat.\r\nOuverture possible sur RDV en dehors des horaires d'ouverture."
    ],
    "nl": [
      "In de Monts d'Ardèche delen drie keramisten een atelier en expositieruimte: Michèle Novak, Maïa Ballot en Valérie Calvat.\r\nOpen op afspraak buiten openingstijden."
    ],
    "es": [
      "En los Monts d'Ardèche, tres ceramistas comparten estudio y espacio de exposición: Michèle Novak, Maïa Ballot y Valérie Calvat.\r\nAbierto con cita previa fuera del horario de apertura."
    ]
  },
