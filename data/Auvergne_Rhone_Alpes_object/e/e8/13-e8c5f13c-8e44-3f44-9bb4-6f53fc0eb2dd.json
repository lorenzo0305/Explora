  "rdfs:comment": {
    "de": [
      "Verkauf von Lang Yarns Wolle. Handgestrickte Artikel, kleines Kurzwarengeschäft und Gruppenkurse für Stricken und Häkeln. Die Kurse werden das ganze Jahr über angeboten und können im Laden gebucht werden. Es werden verschiedene Formeln für Kinder und Erwachsene angeboten."
    ],
    "en": [
      "Sale of Lang Yarns wool. Hand-knitted articles, small haberdashery and collective knitting and crochet courses. The courses are offered all year long with reservation at the store. Different formulas are proposed, children or adults."
    ],
    "it": [
      "Vendita di lana Lang Yarns. Articoli lavorati a mano, piccola merceria e corsi collettivi di maglia e uncinetto. I corsi sono offerti tutto l'anno e possono essere prenotati presso il negozio. Vengono proposte diverse formule, per bambini o adulti."
    ],
    "fr": [
      "Vente de laine Lang Yarns. Articles tricotés main, petite mercerie et stages collectifs tricot et crochet. Les stages sont proposés toute l'année avec réservation à la boutique. Différentes formules sont proposées, enfants ou adultes."
    ],
    "nl": [
      "Verkoop van Lang Yarns wol. Handgebreide artikelen, kleine fournituren en groepsbrei- en haakcursussen. De cursussen worden het hele jaar door aangeboden na reservering in de winkel. Er worden verschillende formules voorgesteld, kinderen of volwassenen."
    ],
    "es": [
      "Venta de lana de Lang Yarns. Artículos de punto a mano, pequeña mercería y cursos de punto y ganchillo en grupo. Los cursos se ofrecen durante todo el año con reserva en la tienda. Se proponen diferentes fórmulas, niños o adultos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Version laine"
    ]
  },
