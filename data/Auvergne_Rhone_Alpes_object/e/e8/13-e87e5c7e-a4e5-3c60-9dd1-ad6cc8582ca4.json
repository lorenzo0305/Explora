  "rdfs:comment": {
    "de": [
      "Oberhalb von Samoëns liegt dieses Bergchalet unterhalb der \"dents blanches\", dem höchsten Punkt der Gegend. Seine Terrasse ist ideal nach Westen ausgerichtet, so dass Sie einen Blick auf das Giffre-Tal haben und schöne Sonnenuntergänge genießen können."
    ],
    "en": [
      "Above Samoëns, this mountain chalet is located under the \"dents blanches\", the highest point in the area. Its terrace faces due west, offering a view over the Giffre valley and the opportunity to enjoy beautiful sunsets."
    ],
    "it": [
      "Sopra Samoëns, questo chalet di montagna si trova sotto i \"dents blanches\", il punto più alto della zona. La terrazza è posizionata in modo ideale verso ovest e offre una vista sulla valle di Giffre e la possibilità di godere di splendidi tramonti."
    ],
    "fr": [
      "Au dessus de Samoëns, ce chalet de montagne est situé sous les dents blanches, point culminant du secteur. Sa terrasse est idéalement orientée plein Ouest pour une une vue sur la vallée du Giffre et permet de profiter de jolis couchers de soleil."
    ],
    "es": [
      "Por encima de Samoëns, este chalet de montaña está situado bajo los \"dents blanches\", el punto más alto de la zona. La terraza está idealmente situada hacia el oeste, con vistas al valle de Giffre y la oportunidad de disfrutar de hermosas puestas de sol."
    ],
    "nl": [
      "Boven Samoëns ligt dit bergchalet onder de \"dents blanches\", het hoogste punt in de omgeving. Het terras is ideaal gelegen op het westen, met uitzicht over de Giffre vallei en de mogelijkheid om te genieten van prachtige zonsondergangen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bostan Refuge"
    ],
    "fr": [
