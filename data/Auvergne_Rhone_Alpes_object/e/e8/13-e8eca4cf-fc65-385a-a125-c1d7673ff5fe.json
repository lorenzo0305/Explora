  "rdfs:comment": {
    "de": [
      "Im Herzen des Ortes empfängt Sie das beheizte Freibad von Le Corbier während der Saison in einer einzigartigen Umgebung mit Blick auf die Berge."
    ],
    "en": [
      "In the heart of the resort, Le Corbier's heated outdoor pool welcomes you in season to a unique setting overlooking the mountains."
    ],
    "it": [
      "Nel cuore del resort, la piscina esterna riscaldata di Le Corbier vi accoglie in stagione in un ambiente unico con vista sulle montagne."
    ],
    "fr": [
      "Au cœur de la station, la piscine extérieure chauffée du Corbier vous accueille en saison dans un cadre unique face aux montagnes."
    ],
    "nl": [
      "In het hart van het resort verwelkomt het verwarmde buitenzwembad van Le Corbier je in het seizoen in een unieke omgeving met uitzicht op de bergen."
    ],
    "es": [
      "En el corazón de la estación, la piscina exterior climatizada de Le Corbier le da la bienvenida en temporada en un entorno único con vistas a las montañas."
    ]
  },
