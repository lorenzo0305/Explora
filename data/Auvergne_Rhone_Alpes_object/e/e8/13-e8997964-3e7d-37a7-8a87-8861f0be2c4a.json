  "rdfs:comment": {
    "de": [
      "Van-Taxi der gehobenen Klasse. Personen- und Paketbeförderung, zugelassener medizinischer Sitztransport, alle Entfernungen, Fahrzeug mit Anhängerkupplung und spezialisiertem Fahrer für Fahrten mit auch Ihrem Anhänger."
    ],
    "en": [
      "Top-of-the-range Taxi Van. Transport of people, parcels, approved seated medical transport, all distances, vehicle equipped with a trailer hitch and specialized driver for trips with your own trailer."
    ],
    "it": [
      "Taxi Mercedes Classe S 400 di alta gamma. Trasporto passeggeri, VIP, trasporto medico con sedile registrato, tutte le distanze, su prenotazione 24 ore su 24, 7 giorni su 7"
    ],
    "fr": [
      "Taxi Mercedes Classe S 400  haut de gamme. Transport de personnes, Vip, agréé transport médical assis,  toutes distances, sur réservation 24/7"
    ],
    "nl": [
      "Topklasse taxibus. Vervoer van personen, pakketten, goedgekeurd zittend medisch vervoer, alle afstanden, voertuig uitgerust met trekhaak en gespecialiseerde chauffeur voor ritten met eigen aanhangwagen."
    ],
    "es": [
      "Taxi de alta gama Mercedes Clase S 400. Transporte de pasajeros, VIP, transporte médico con asiento registrado, todas las distancias, con reserva 24/7"
    ]
  },
