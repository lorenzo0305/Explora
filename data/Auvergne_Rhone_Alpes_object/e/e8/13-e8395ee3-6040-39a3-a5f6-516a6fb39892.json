  "rdfs:comment": {
    "de": [
      "Le Mixologiste ist ein auf Cocktailservice spezialisiertes Unternehmen, das ein einzigartiges Mixologie-Erlebnis für alle Arten von geschäftlichen oder privaten Veranstaltungen bietet. Aber auch für Ihr Team Building während eines Cocktail-Workshops."
    ],
    "en": [
      "Le Mixologiste is a company specializing in cocktail service, offering a unique mixology experience for all types of professional or private events. But also for your Team Building cocktail workshops."
    ],
    "it": [
      "Le Mixologiste è un'azienda specializzata in servizi di cocktail, che offre un'esperienza di mixology unica per tutti i tipi di eventi professionali o privati. Possiamo anche organizzare laboratori di cocktail per i vostri eventi di team building."
    ],
    "fr": [
      "Le Mixologiste est une entreprise spécialisée dans le service de cocktails, offrant une expérience de mixologie unique pour tous types d'événements professionnels ou privés. Mais également pour vos Team Building lors d'atelier cocktails."
    ],
    "nl": [
      "Le Mixologiste is een bedrijf gespecialiseerd in cocktails en biedt een unieke mixologie-ervaring voor alle soorten professionele of privé-evenementen. We kunnen ook cocktailworkshops organiseren voor je teambuildingevenementen."
    ],
    "es": [
      "Le Mixologiste es una empresa especializada en servicios de coctelería que ofrece una experiencia mixológica única para todo tipo de eventos profesionales o privados. También podemos organizar talleres de coctelería para sus eventos de creación de equipos."
    ]
  },
