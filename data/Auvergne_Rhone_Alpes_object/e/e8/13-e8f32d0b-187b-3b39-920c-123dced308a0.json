  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser kleines Restaurant am Ufer des Allier, in dem nur frische und lokale Produkte verarbeitet werden! Unseren Käsesorten aus der Auvergne wird ein großer Platz eingeräumt."
    ],
    "en": [
      "Come and discover our little restaurant on the banks of the Allier, working exclusively with fresh, local produce! A special place for our Auvergne cheeses."
    ],
    "it": [
      "Venite a scoprire il nostro piccolo ristorante sulle rive del fiume Allier, che lavora esclusivamente con prodotti freschi e locali! I nostri formaggi d'Alvernia sono al primo posto."
    ],
    "fr": [
      "Venez découvrir notre petit restaurant au bord d'allier, travaillant uniquement des produits frais et locaux ! Grande place accordée à nos fromages d'Auvergne."
    ],
    "es": [
      "Venga a descubrir nuestro pequeño restaurante a orillas del río Allier, que trabaja exclusivamente con productos frescos y locales Nuestros quesos de Auvernia ocupan un lugar privilegiado."
    ],
    "nl": [
      "Kom en ontdek ons kleine restaurant aan de oevers van de Allier, dat uitsluitend werkt met verse, lokale producten! Onze kazen uit de Auvergne staan op de eerste plaats."
    ]
  },
