  "rdfs:comment": {
    "de": [
      "Strand mit großen Rasenflächen, teilweise schattig (schnell tiefes Wasser). Spielplatz für Kinder, Picknickplatz. Restaurant-Eisdiele vor Ort. Grillen, Paddle, Ball und Shisha verboten."
    ],
    "en": [
      "Beach with large grassy areas, some shaded (deep water quickly). Playground for children, picnic area. Ice cream restaurant on site. Barbecue, paddle, ball and shisha prohibited."
    ],
    "it": [
      "Ampia spiaggia con prato, alcune zone d'ombra (acque poco profonde). Area giochi per bambini e area picnic. Ristorante e gelateria in loco. Barbecue e sigarette vietati."
    ],
    "fr": [
      "Plage vaste avec pelouse, quelques zones ombragées  (eaux profondes rapidement). Aire de jeux pour enfants et espace pique-nique. Restaurant-glacier sur place. Barbecues et cigarettes interdits."
    ],
    "nl": [
      "Groot strand met grasveld, enkele schaduwrijke plekken (snel diep water). Kinderspeelplaats en picknickplaats. Restaurant en ijssalon ter plaatse. Barbecues en sigaretten verboden."
    ],
    "es": [
      "Amplia playa con césped, algunas zonas de sombra (aguas profundas rápidamente). Zona de juegos para niños y merendero. Restaurante y heladería in situ. Prohibidas las barbacoas y los cigarrillos."
    ]
  },
