  "rdfs:comment": {
    "de": [
      "Die Sprünge und Töpfe von Charmine, die von einem Wanderweg vom See aus sichtbar sind, werden Sie überraschen."
    ],
    "en": [
      "Classified site visible from a hiking trail starting from the lake, Charmine's jumps and kettles will surprise you."
    ],
