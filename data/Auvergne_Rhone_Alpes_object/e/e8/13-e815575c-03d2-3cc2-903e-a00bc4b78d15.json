  "rdfs:comment": {
    "de": [
      "La Table du Prieuré pflegt eine Küche, die sich vom Rhythmus der Jahreszeiten und dem Reichtum ihrer Region leiten lässt. Auf jedem Teller kommen außergewöhnliche Produkte zur Geltung, die sorgfältig bei engagierten Erzeugern ausgewählt werden."
    ],
    "en": [
      "Le Prieuré est une maison d’auteur, un écrin pour une cuisine sincère, vive, contemporaine, une table pour ceux qui aiment se laisser surprendre, toucher, émerveiller.\r\n\r\nFormule du midi de 24 à 29 €.\r\nFormule gastronomique le soir avec 3 menus : Menu le Voyage d'Hector, Menu l'escapade de Célestine et le menu Signature de la Côte Roannaise."
    ],
    "it": [
      "La Table du Prieuré coltiva una cucina guidata dal ritmo delle stagioni e dalla ricchezza del suo territorio. Ogni piatto presenta prodotti eccezionali, accuratamente selezionati da produttori impegnati."
    ],
    "fr": [
      "La Table du Prieuré cultive une cuisine guidée par le rythme des saisons et la richesse de son terroir. Chaque assiette met en lumière des produits d’exception, sélectionnés avec soin auprès de producteurs engagés."
    ],
    "nl": [
      "La Table du Prieuré cultiveert een keuken die geleid wordt door het ritme van de seizoenen en de rijkdom van het terroir. Elk gerecht laat uitzonderlijke producten zien, zorgvuldig geselecteerd bij toegewijde producenten."
    ],
    "es": [
      "La Table du Prieuré cultiva una cocina guiada por el ritmo de las estaciones y la riqueza de su terruño. Cada plato presenta productos excepcionales, cuidadosamente seleccionados entre productores comprometidos."
    ]
  },
