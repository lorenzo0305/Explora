  "rdfs:comment": {
    "de": [
      "Die Auberge de l'Allagnonette empfängt Sie in einem charaktervollen Gebäude\r\nDer Chefkoch zaubert Ihnen leckere Gerichte: Blutwurst-Millefeuille mit Gänseleber, Entenbrust mit roten Früchten... Regionale Gerichte: Cantal-Tarte, Pounti, Trüffel, Tripoux."
    ],
    "en": [
      "The Auberge de l'Allagnonette welcomes you to a building full of character.\r\nThe chef prepares delicious dishes: millefeuille of black pudding with foie gras, duck breast with red fruit, etc. Regional dishes: cantal tart, pounti, truffade, tripoux."
    ],
    "it": [
      "L'Auberge de l'Allagnonette vi accoglie in un edificio di carattere\r\nLo chef prepara piatti deliziosi: millefoglie di sanguinaccio con foie gras, petto d'anatra ai frutti rossi? Piatti regionali: torta cantal, pounti, truffade, tripoux."
    ],
    "fr": [
      "L’Auberge de l’Allagnonette vous accueille dans un bâtiment de caractère. \r\nLe chef vous mijote de bons petits plats : millefeuille de boudin au foie gras, magret de canard aux fruits rouges… Plats régionaux : tarte au cantal, pounti, truffade, tripoux."
    ],
    "es": [
      "El Auberge de l'Allagnonette le acoge en un edificio con carácter\r\nEl chef prepara deliciosos platos: milhojas de morcilla con foie gras, pechuga de pato con frutos rojos? Platos regionales: pastel de cantal, pounti, truffade, tripoux."
    ],
    "nl": [
      "De Auberge de l'Allagnonette ontvangt u in een gebouw met karakter\r\nDe chef bereidt heerlijke gerechten: millefeuille van bloedworst met foie gras, eendenborst met rode vruchten... Streekgerechten: cantal pie, pounti, truffade, tripoux."
    ]
  },
