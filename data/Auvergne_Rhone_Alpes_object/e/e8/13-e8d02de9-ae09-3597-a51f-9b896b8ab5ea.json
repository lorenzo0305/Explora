  "rdfs:comment": {
    "de": [
      "In Les Vergers d'Hysope geht es um die Leidenschaft für Obst aus biologischem Anbau. Es werden etwa 20 Apfel- und 8 Birnensorten angeboten. Äpfel zum Beißen, Kochen, Pressen... eine schwindelerregende Auswahl, bei der man fast umfällt!"
    ],
    "en": [
      "At Vergers d'Hysope, we're passionate about organic fruit. Twenty varieties of apples and eight varieties of pears are available. Apples to munch, bake or squeeze? a dizzying array that's almost enough to make you faint!"
    ],
    "it": [
      "Da Vergers d'Hysope troverete la passione per la frutta biologica. Venti varietà di mele e otto varietà di pere sono in offerta. Mele da sgranocchiare, cucinare e spremere? Una scelta vertiginosa che fa quasi svenire!"
    ],
    "fr": [
      "Aux Vergers d'Hysope,  c'est la passion des fruits en agriculture biologique. Une vingtaine variétés de pommes et huit de poires sont proposés. Des pommes à croquer, à cuire, à presser… un choix vertigineux qui ferait presque tomber dans les pommes !"
    ],
    "es": [
      "En Vergers d'Hysope, encontrará pasión por la fruta ecológica. Se ofrecen veinte variedades de manzanas y ocho de peras. Manzanas para masticar, cocinar y exprimir... ¡una oferta vertiginosa que casi le hará desfallecer!"
    ],
    "nl": [
      "Bij Vergers d'Hysope vind je een passie voor biologisch fruit. Er worden twintig soorten appels en acht soorten peren aangeboden. Appels om te knabbelen, te koken en te persen? Een duizelingwekkende keuze waar je bijna flauw van zou vallen!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Le verger de Michel"
    ],
    "fr": [
      "Les vergers d'Hysope"
    ]
  },
