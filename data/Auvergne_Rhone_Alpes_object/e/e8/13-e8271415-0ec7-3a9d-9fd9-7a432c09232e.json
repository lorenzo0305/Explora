  "rdfs:comment": {
    "de": [
      "Die Domaine de Découverte zeigt die Überreste der Abteikirche aus dem 11. Jahrhundert, das Klostergut und seine verschiedenen Teile sowie den restaurierten ehemaligen Bauernhof der Mönche, der heute auf 650m² Ausstellungsfläche ein Interpretationszentrum beherbergt."
    ],
    "en": [
      "A renovated former monastic farm housing an interpretation centre with 650m² of exhibition space: displays on the monks’ daily life; links between the Abbaye d’Aulps and the Savoie; the unexpected story of its final destruction; and medicinal plants"
    ],
    "it": [
      "Il Discovery Estate presenta i resti della chiesa abbaziale dell'XI secolo, la tenuta monastica e le sue varie sezioni, nonché l'ex fattoria dei monaci restaurata, che oggi ospita un centro di interpretazione con 650 m² di spazio espositivo."
    ],
    "fr": [
      "Le Domaine de Découverte présente les vestiges de l'abbatiale du 11ème siècle, le domaine monastique et ses différents parties, ainsi que l'ancienne ferme des moines, restaurée, qui accueille aujourd'hui un centre d'interprétation sur 650m² d'expositions."
    ],
    "nl": [
      "Het Ontdekkingslandgoed bevat de overblijfselen van de 11e-eeuwse abdijkerk, het kloosterlandgoed en de verschillende delen ervan, evenals de gerestaureerde voormalige monnikenboerderij, waar nu een interpretatiecentrum met 650 m² tentoonstellingsruimte is gevestigd."
    ],
    "es": [
      "El Domaine de Découverte presenta los restos de la iglesia abacial del siglo XI, la finca monástica y sus diversas partes, así como la antigua granja de los monjes, que ha sido restaurada y alberga ahora un centro de interpretación con 650 m² de exposiciones."
    ]
  },
  "rdfs:label": {
    "de": [
