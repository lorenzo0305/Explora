  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Ribes gelegen, ist La Cueille ein Ort mit mehreren Dienstleistungen. Restaurant, Bar, Lebensmittelgeschäft und Eisdiele sind von März bis Dezember und im Sommer 7 Tage die Woche geöffnet und bieten Ihnen eine saisonale Küche, die zu 100 % aus der Region stammt."
    ],
    "en": [
      "Located in the heart of Ribes, a small village in Ardèche, south east of France, “La Cueille” is a multi-services convenience store and a restaurant. Open year round, 7 days a week during summer, the grocery store, the bar, the restaurant and the ice-cream parlour is a place to enjoy delicious seasonal cuisine."
    ],
    "it": [
      "Situata nel cuore del villaggio di Ribes, La Cueille è un locale multiservizi. Il ristorante, il bar, il negozio di alimentari e la gelateria sono aperti da marzo a dicembre e 7/7 durante l'estate e offrono una cucina stagionale 100% locale."
    ],
    "fr": [
      "Située en plein cœur du village de Ribes, la Cueille est un lieu multi-services. Restaurant, bar, épicerie et glacier vous accueillent de mars à décembre, 7/7 pendant l’été et vous proposent une cuisine de saison 100% terroiriste."
    ],
    "es": [
      "Situado en el corazón del pueblo de Ribes, La Cueille es un local multiservicios. El restaurante, el bar, la tienda de ultramarinos y la heladería están abiertos de marzo a diciembre, y 7/7 durante el verano, y sirven cocina de temporada 100% local."
    ],
    "nl": [
      "La Cueille ligt in het hart van het dorp Ribes en biedt verschillende diensten. Het restaurant, de bar, de kruidenierswinkel en de ijssalon zijn geopend van maart tot december, en 7/7 tijdens de zomer, en serveren 100% lokale seizoensgerechten."
    ]
  },
