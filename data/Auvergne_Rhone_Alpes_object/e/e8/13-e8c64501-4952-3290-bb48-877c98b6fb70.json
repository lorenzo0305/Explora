  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Informationstafel. Die Gemeinde besitzt den einzigen verdrehten Kirchturm in der gesamten Auvergne. Die ursprüngliche Kirche (ISMH) wurde Ende des 12. Jahrhunderts im romanischen Stil erbaut."
    ],
    "en": [
      "Self-guided tour with information panel. The commune boasts the only listed \"clocher tors\" (twisted bell tower) in the entire Auvergne region. The original church (ISMH) was built at the end of the 12th century in the Romanesque style."
    ],
    "it": [
      "Visita gratuita con pannello informativo. Il comune possiede l'unico \"campanile contorto\" classificato in tutta la regione dell'Alvernia. La chiesa primitiva (ISMH), costruita alla fine del XII secolo, è in stile romanico."
    ],
    "fr": [
      "Visite libre avec panneau d'information. La commune possède le seul \"clocher tors\" répertorié de toute la région d'Auvergne. L'église primitive (ISMH) construite fin du XIIe, est de style roman."
    ],
    "es": [
      "Visita gratuita con panel informativo. El municipio cuenta con el único \"campanario torcido\" catalogado de toda la región de Auvernia. La iglesia primitiva (ISMH), construida a finales del siglo XII, es de estilo románico."
    ],
    "nl": [
      "Gratis bezoek met informatiepaneel. De gemeente heeft de enige geklasseerde \"gedraaide klokkentoren\" in de hele Auvergne. De primitieve kerk (ISMH), gebouwd aan het eind van de 12e eeuw, is in romaanse stijl."
    ]
  },
