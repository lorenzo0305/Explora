  "rdfs:comment": {
    "de": [
      "Traditionelle regionale Küche in einer warmen und gemütlichen Atmosphäre im Speisesaal oder auf der schattigen Terrasse. Spezialitäten: Rinderfilet rossini, Geflügelbraten, Bresse-Huhn mit Morcheln, Entenkeule aus den Dombes...und Pizzas."
    ],
    "en": [
      "Traditional local cuisine in a warm and cozy atmosphere in the dining room or on the shaded terrace. Specialties: beef filet rossini, poultry breasts, Bresse chicken with morels, duck leg from Dombes... and pizzas."
    ],
    "it": [
      "Cucina tradizionale locale in un'atmosfera calda e accogliente nella sala da pranzo o sulla terrazza ombreggiata. Specialità: rossini di filetto, petti di pollame, pollo di Bresse con spugnole, coscia di anatroccolo di Dombes... e pizze."
    ],
    "fr": [
      "Une cuisine traditionnelle du terroir dans une ambiance chaleureuse et cosy en salle ou en terrasse ombragée. Spécialités: le filet de bœuf rossini, les bréchets de volaille, le poulet de Bresse aux morilles, la cuisse de canette des Dombes...et pizzas."
    ],
    "nl": [
      "Traditionele gerechten in een warme en gezellige sfeer in de eetzaal of op het schaduwrijke terras. Specialiteiten: de Rossini ossenhaas, kip wishbones, Bresse kip met morilles...en pizza."
    ],
    "es": [
      "Cocina tradicional local en un ambiente cálido y acogedor en el comedor o en la terraza a la sombra. Especialidades: filete de ternera rossini, pechugas de ave, pollo de Bresse con colmenillas, pata de pato de Dombes... y pizzas."
    ]
  },
