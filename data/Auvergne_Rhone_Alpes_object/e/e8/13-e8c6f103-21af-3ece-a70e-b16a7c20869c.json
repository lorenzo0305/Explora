  "rdfs:comment": {
    "de": [
      "Sie kennen Toukie's - die selbstgemachten Cookies noch nicht. Dann müssen Sie sie probieren! Speziell für Naschkatzen! Zum Probieren: Die traditionellen Cookies, die mit Nutella gefüllten, die mit M&Ms, Lion, Snikers.... garnierten. Und viele mehr..."
    ],
    "en": [
      "You don't know Toukie's - homemade cookies. You've got to try them! Special for food lovers! Try them: Traditional cookies, Nutella-filled cookies, cookies with M&Ms, Lion cookies, Snikers cookies.... And many more..."
    ],
    "it": [
      "Non conoscete i Toukie's - biscotti fatti in casa. Dovete provarli! Speciale per gli amanti del cibo! Provateli: Biscotti tradizionali, biscotti ripieni di Nutella, biscotti con M&Ms, Lion, Snikers.... E molti altri..."
    ],
    "fr": [
      "Vous ne connaissez pas Toukie's - les Cookies faits-maison. Il vous faut les goûter ! Spécial pour les gourmands ! A déguster : Les cookies traditionnels, ceux fourrés au Nutella, garnis au M&Ms, Lion, Snikers.... Et bien d'autres..."
    ],
    "es": [
      "No conoces Toukie's - galletas caseras. ¡Tienes que probarlas! ¡Especial para amantes de la comida! Pruébalas: Galletas tradicionales, las rellenas de Nutella, coronadas con M&Ms, León, Snikers.... Y muchas más..."
    ],
    "nl": [
      "Je kent Toukie's niet - zelfgemaakte koekjes. Je moet ze proberen! Speciaal voor fijnproevers! Probeer ze eens: Traditionele koekjes, koekjes gevuld met Nutella, koekjes bedekt met M&M's, Lion, Snikers.... En nog veel meer..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Toukie's - Cookies Faits-Maison"
    ]
  },
