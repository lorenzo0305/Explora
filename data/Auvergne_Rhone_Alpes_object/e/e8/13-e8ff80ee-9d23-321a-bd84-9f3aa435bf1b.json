  "rdfs:comment": {
    "de": [
      "Valérie empfängt Sie mit Wohlwollen und Professionalität in einem außergewöhnlichen und warmen Rahmen im Zentrum des Ferienortes La Féclaz für einen Moment der puren Entspannung!\nGenießen Sie Entspannungs- oder Muskelmassagen, um Ihre Verspannungen zu lösen"
    ],
    "en": [
      "Valérie welcomes you with kindness and professionalism in an exceptional and warm setting, in the center of La Féclaz Resort, for a moment of pure relaxation!\nEnjoy a relaxing or muscular massage to relieve your tension"
    ],
    "it": [
      "Valérie vi accoglie con gentilezza e professionalità in un ambiente eccezionale e caloroso, nel centro della località di La Féclaz, per un momento di puro relax!\nGodetevi un massaggio rilassante o muscolare per sciogliere le tensioni"
    ],
    "fr": [
      "Valérie vous accueille avec bienveillance et professionnalisme dans un cadre exceptionnel et chaleureux, au centre de la Station La Féclaz, pour un moment de pure détente !\nProfitez des massages détentes ou  musculaires pour libérer vos tensions"
    ],
    "nl": [
      "Valérie verwelkomt je met vriendelijkheid en professionaliteit in een uitzonderlijke en warme omgeving, in het centrum van La Féclaz, voor een moment van pure ontspanning!\nGeniet van een ontspannende of spiermassage om je spanning los te laten"
    ],
    "es": [
      "Valérie le recibe con amabilidad y profesionalidad en un marco excepcional y cálido, en el centro de la estación de La Féclaz, ¡para un momento de pura relajación!\nDisfrute de un masaje relajante o muscular para liberar sus tensiones"
    ]
  },
