  "rdfs:comment": {
    "de": [
      "Englisch, Russisch, Spanisch, Japanisch... Genießen Sie einen geselligen Abend, an dem jeder seine Sprache hören lassen kann, indem er einen kurzen Text, ein Gedicht oder ein Lied vorliest... oder einfach nur zuhört!"
    ],
    "en": [
      "English, Russian, Spanish, Japanese... Come and enjoy a convivial evening where everyone can make their language heard through the reading of a short text, a poem, a song... or just listen!"
    ],
    "it": [
      "Inglese, russo, spagnolo, giapponese... Venite a godervi una serata conviviale in cui ognuno potrà far sentire la propria lingua leggendo un breve testo, una poesia, una canzone... o semplicemente ascoltando!"
    ],
    "fr": [
      "Anglais, russe, espagnol, japonais...Venez profiter d'une soirée conviviale où chacun pourra faire entendre sa langue à travers la lecture d'un court texte, d'une poésie, d'une chanson... ou juste écouter !"
    ],
    "es": [
      "Inglés, ruso, español, japonés... Venga a disfrutar de una velada amistosa en la que cada uno podrá hacer oír su idioma leyendo un texto breve, un poema, una canción... ¡o simplemente escuchando!"
    ],
    "nl": [
      "Engels, Russisch, Spaans, Japans... Kom genieten van een gezellige avond waarop iedereen zijn taal kan laten horen door een korte tekst, een gedicht, een lied... voor te lezen of gewoon te luisteren!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival - F(r)iction du réel : Les langues du Diois"
    ]
  },
