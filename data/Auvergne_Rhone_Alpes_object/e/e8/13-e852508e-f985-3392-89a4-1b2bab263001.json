  "rdfs:comment": {
    "de": [
      "Ein überschaubares Restaurant, das in einer kleinen Straße im historischen Zentrum von Clermont-Fd liegt. Dieser \"puy de saveur\" bietet Ihnen eine abwechslungsreiche Gourmetküche, die lokale und marktfrische Produkte hervorhebt."
    ],
    "en": [
      "Restaurant on a human scale nestled in a small street in the historic center of Clermont-Fd. This puy de saveur offers gourmet, varied cuisine, featuring local and market produce."
    ],
    "it": [
      "Un ristorante a misura d'uomo situato in una piccola via del centro storico di Clermont-Fd. Questo \"puy de saveur\" offre una cucina varia e gourmet che sfrutta al meglio i prodotti locali e del mercato."
    ],
    "fr": [
      "Restaurant à taille humaine niché dans une petite rue du cente historique de Clermont-Fd. Ce puy de saveur vous proposera une cuisine gourmande, variée, et qui met en valeur les produits locaux et de marché."
    ],
    "es": [
      "Un restaurante a escala humana situado en una pequeña calle del centro histórico de Clermont-Fd. Este \"puy de saveur\" ofrece una cocina gastronómica variada que aprovecha al máximo los productos locales y de mercado."
    ],
    "nl": [
      "Een restaurant op menselijke schaal genesteld in een klein straatje in het historische centrum van Clermont-Fd. Deze \"puy de saveur\" biedt een gastronomische keuken die gevarieerd is en optimaal gebruik maakt van lokale en marktproducten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table du Puy"
    ]
  },
