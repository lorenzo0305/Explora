  "rdfs:comment": {
    "de": [
      "Ein Lokal, das man in Morzine für einen Kaffee mit den Einheimischen oder einen Aperitif nicht verpassen sollte!\r\nDie Bar Robinson wurde 1926 gegründet und ist eine der ältesten Bars in Morzine. Sie ist seit jeher im Besitz der gleichen Familie."
    ],
    "en": [
      "Established in 1926, Bar Robinson is one of the oldest bar in Morzine. It has been run by the same family for the entire time it has been open."
    ],
    "it": [
      "Un must a Morzine per un caffè con la gente del posto o un aperitivo vivace!\r\nFondato nel 1926, il Bar Robinson è uno dei bar più antichi di Morzine. È sempre rimasto nella stessa famiglia."
    ],
    "fr": [
      "Etablissement incontournable de Morzine pour un café avec les locaux ou un apéro animé!\r\nFondé en 1926, le Bar Robinson est l'un des plus vieux bars à Morzine. Il est depuis toujours resté dans la même famille."
    ],
    "es": [
      "Una visita obligada en Morzine para tomar un café con los lugareños o un animado aperitivo\r\nFundado en 1926, el Bar Robinson es uno de los bares más antiguos de Morzine. Siempre ha permanecido en la misma familia."
    ],
    "nl": [
      "Een must in Morzine voor een kopje koffie met de lokale bevolking of een levendig aperitief!\r\nBar Robinson werd opgericht in 1926 en is een van de oudste bars in Morzine. Het is altijd in dezelfde familie gebleven."
    ]
  },
