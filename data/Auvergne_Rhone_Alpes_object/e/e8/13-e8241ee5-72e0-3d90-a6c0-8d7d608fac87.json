  "rdfs:comment": {
    "de": [
      "In einer angenehmen Atmosphäre können Sie hier leckere Salate und traditionelle Gerichte genießen oder einfach nur einen Kaffee trinken.\r\nAuch Tabakwaren."
    ],
    "en": [
      "Enjoy tasty salads and traditional dishes in a pleasant atmosphere, or simply have a coffee.\r\nTobacco also available."
    ],
    "it": [
      "Venite a gustare gustose insalate e piatti tradizionali in un'atmosfera piacevole, o semplicemente a prendere un caffè.\r\nDisponibile anche tabaccheria."
    ],
    "fr": [
      "Dans une ambiance agréable, venez déguster des salades savoureuses et des plats traditionnels ou simplement prendre un café.\r\nTabac également."
    ],
    "es": [
      "Venga a degustar sabrosas ensaladas y platos tradicionales en un ambiente agradable, o simplemente a tomar un café.\r\nTambién dispone de estanco."
    ],
    "nl": [
      "Kom genieten van smakelijke salades en traditionele gerechten in een aangename sfeer, of gewoon van een kopje koffie.\r\nEr is ook een tabakswinkel."
    ]
  },
