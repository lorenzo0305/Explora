  "rdfs:comment": {
    "de": [
      "La Machine ist eine genossenschaftliche Handwerksbrauerei, die es sich zur Aufgabe gemacht hat, qualitativ hochwertiges handwerklich gebrautes Bier anzubieten, das in Fässern abgefüllt und vor Ort lose verkauft wird."
    ],
    "en": [
      "A cooperative craft brewery, La Machine is a brewery whose vocation is to offer quality craft beer, in barrels and in bulk on the premises."
    ],
    "it": [
      "Birrificio artigianale cooperativo, La Machine è un birrificio la cui vocazione è quella di offrire birra artigianale di qualità, in fusti e sfusa sul posto."
    ],
    "fr": [
      "Brasserie artisanale coopérative, la Machine est une brasserie ayant pour vocation de proposer de la bière artisanale de qualité, en fûts, et en vrac sur place."
    ],
    "nl": [
      "La Machine is een coöperatieve ambachtelijke brouwerij met als roeping het aanbieden van ambachtelijk kwaliteitsbier, in vaten en in bulk ter plaatse."
    ],
    "es": [
      "Cervecería artesanal cooperativa, La Machine es una cervecería cuya vocación es ofrecer cerveza artesanal de calidad, en barriles y a granel en el propio local."
    ]
  },
