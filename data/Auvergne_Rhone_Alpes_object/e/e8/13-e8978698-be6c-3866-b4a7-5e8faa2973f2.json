  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Techni Trail Tiranges am 23. und 24. Mai 2026!\r\nAuf dem Programm stehen: 4 Trailruns von 15 bis 82 km, 1 Nordic Walking, Hüpfburg, Essen vor Ort und Animationen."
    ],
    "en": [
      "Come and discover the Techni Trail Tiranges on May 23 and 24, 2026!\r\nOn the program: 4 trail races from 15 to 82 km, 1 Nordic walk, bouncy castle, on-site lunch and entertainment."
    ],
    "it": [
      "Venite a scoprire il Techni Trail Tiranges il 23 e 24 maggio 2026!\r\nIn programma: 4 gare di trail da 15 a 82 km, 1 passeggiata nordica, struttura gonfiabile, pranzo in loco e animazione."
    ],
    "fr": [
      "Venez découvrir le Techni Trail Tiranges les 23 et 24 mai 2026  !\r\nAu programme : 4 courses trails de 15 à 82 km, 1 marche nordique, de structure gonflable, repas sur place et animations."
    ],
    "es": [
      "Ven a descubrir el Techni Trail Tiranges los días 23 y 24 de mayo de 2026\r\nEn el programa: 4 carreras de trail de 15 a 82 km, 1 marcha nórdica, estructura hinchable, almuerzo in situ y animación."
    ],
    "nl": [
      "Kom en ontdek de Techni Trail Tiranges op 23 en 24 mei 2026!\r\nOp het programma: 4 trailwedstrijden van 15 tot 82 km, 1 nordic walk, opblaasbare structuur, lunch ter plaatse en animatie."
