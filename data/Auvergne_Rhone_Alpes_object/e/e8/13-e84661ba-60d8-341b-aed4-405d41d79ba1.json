  "rdfs:comment": {
    "de": [
      "Die Porte Gothique, die sich nördlich der Rue André Malraux befindet, ist der einzige bedeutende Überrest der mittelalterlichen Burg der Grafen von Clermont. Das Tor wurde auf das Jahr 1350 datiert, als Johann der Gute, der älteste Sohn von Philipp VI. von Valois, regierte."
    ],
    "en": [
      "The Porte Gothique, to the north of rue André Malraux, is the only significant vestige of the medieval castle of the Counts of Clermont. It dates back to 1350, the reign of Jean le Bon, eldest son of Philippe VI de Valois."
    ],
    "it": [
      "La porta gotica, situata a nord di rue André Malraux, è l'unica vestigia importante del castello medievale dei conti di Clermont. È datata 1350, epoca in cui regnava Jean le Bon, figlio maggiore di Filippo VI di Valois."
    ],
    "fr": [
      "La Porte Gothique, située au nord de la rue André Malraux est le seul vestige, important du château médiéval des comtes de Clermont. Elle est datée de 1350, époque ou règne Jean le Bon, fils aîné de Philippe VI de Valois."
    ],
    "es": [
      "La Puerta Gótica, situada al norte de la calle André Malraux, es el único vestigio importante del castillo medieval de los Condes de Clermont. Está fechada en 1350, época en la que reinaba Jean le Bon, hijo mayor de Felipe VI de Valois."
    ],
    "nl": [
      "De gotische poort, ten noorden van de rue André Malraux, is het enige overblijfsel van het middeleeuwse kasteel van de graven van Clermont. Het dateert uit 1350, de regeerperiode van Jean le Bon, de oudste zoon van Philippe VI de Valois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Porte Gothique"
    ]
  },
