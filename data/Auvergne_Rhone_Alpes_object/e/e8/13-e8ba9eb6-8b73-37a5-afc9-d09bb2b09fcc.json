  "rdfs:comment": {
    "de": [
      "Gruppencoaching-Sitzungen (maximal 8 Personen). Coach für angepasste körperliche Aktivitäten und Gesundheit, der die Übungen an das Niveau jedes Einzelnen anpasst, aber auch an eventuelle Gesundheitssorgen."
    ],
    "en": [
      "Group coaching sessions (8 people maximum). A health and adapted physical activity coach who adapts the exercises to each individual's level, as well as to any health concerns."
    ],
    "it": [
      "Sessioni di coaching di gruppo (massimo 8 persone). Un allenatore di attività fisica adattata e salutare che adatta gli esercizi al livello di ogni persona, oltre che a eventuali problemi di salute."
    ],
    "fr": [
      "Séances de coaching collectif (8 personnes maximum). Coach en activités physiques adaptées et santé qui adapte les exercices au niveau de chacun mais également aux soucis de santé éventuels."
    ],
    "es": [
      "Sesiones de coaching en grupo (máximo 8 personas). Un entrenador de salud y actividad física adaptada que adapta los ejercicios al nivel de cada persona, así como a cualquier problema de salud que pueda tener."
    ],
    "nl": [
      "Groepscoaching (maximaal 8 personen). Een gezondheids- en aangepaste fysieke activiteitencoach die de oefeningen aanpast aan het niveau van elke persoon en aan eventuele gezondheidsproblemen."
    ]
  },
