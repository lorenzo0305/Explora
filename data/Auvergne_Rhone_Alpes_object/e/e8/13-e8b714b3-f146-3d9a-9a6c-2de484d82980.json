  "rdfs:comment": {
    "de": [
      "Mit Blick auf den Mont Blanc und den Salève bietet Ihnen das Reitzentrum Le Domino im Herzen des Plateaus der Bornes die Möglichkeit, dank einer großen Auswahl an Spaziergängen und Wanderungen zahlreiche wilde Ecken zu entdecken."
    ],
    "en": [
      "Facing Mont Blanc and the Salève, Le Domino equestrian center, in the heart of the Bornes plateau, offers a wide range of rides and hikes to discover the wilderness."
    ],
    "it": [
      "Di fronte al Monte Bianco e alla Salève, il centro ippico Domino, nel cuore dell'altopiano dei Bornes, vi offre la possibilità di scoprire molti luoghi selvaggi grazie a un'ampia scelta di cavalcate ed escursioni."
    ],
    "fr": [
      "Face au Mont Blanc et au Salève le centre équestre le Domino, au cœur du plateau des Bornes, vous propose de découvrir de multiples coins sauvages grâce à un grand choix de balades et de randonnées."
    ],
    "nl": [
      "Met uitzicht op de Mont Blanc en de Salève biedt de manege Domino, in het hart van het plateau van Bornes, u de mogelijkheid om vele wilde plekken te ontdekken dankzij een ruime keuze aan ritten en wandelingen."
    ],
    "es": [
      "Frente al Mont Blanc y la Salève, el centro hípico de Domino, en el corazón de la meseta de los Bornes, le ofrece la posibilidad de descubrir numerosos lugares salvajes gracias a una amplia oferta de paseos y excursiones."
    ]
  },
