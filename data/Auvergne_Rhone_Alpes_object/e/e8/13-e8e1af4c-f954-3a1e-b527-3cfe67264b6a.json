  "rdfs:comment": {
    "de": [
      "Das Novotel ist nur 3 Minuten vom Stadtzentrum entfernt und heißt Sie mit Ihrer Familie oder auf Geschäftsreise willkommen. Organisieren Sie Ihre Meetings, entspannen Sie sich in der Sauna, nutzen Sie den Fitnessraum und genießen Sie regionale Spezialitäten!"
    ],
    "en": [
      "Just 3 minutes from the city center, the Novotel welcomes families and business travelers alike. Organize your meetings, relax in the sauna, take advantage of the fitness room and enjoy regional specialties!"
    ],
    "it": [
      "A soli 3 minuti dal centro città, il Novotel vi accoglie in famiglia o in viaggio d'affari. Organizzate le vostre riunioni, rilassatevi nella sauna, godetevi la sala fitness e assaggiate le specialità regionali!"
    ],
    "fr": [
      "À 3 minutes du centre-ville, le Novotel vous accueille en famille ou en voyage d'affaires. Organisez vos réunions, détendez-vous dans le sauna, profitez de la salle de fitness et dégustez des spécialités régionales !"
    ],
    "nl": [
      "Het Novotel ligt op slechts 3 minuten van het stadscentrum en verwelkomt u als gezin of op zakenreis. Organiseer uw vergaderingen, ontspan in de sauna, maak gebruik van de fitnessruimte en geniet van regionale specialiteiten!"
    ],
    "es": [
      "A sólo 3 minutos del centro de la ciudad, el Novotel le da la bienvenida en familia o en viaje de negocios. Celebre sus reuniones, relájese en la sauna, disfrute de la sala de fitness y deguste especialidades regionales"
    ]
  },
