  "rdfs:comment": {
    "de": [
      "Das Centre des Arts du Récit, das seit September 2025 im Théâtre Prémol untergebracht ist, setzt sich für die Künste des gesprochenen Wortes ein, wobei es sowohl auf künstlerische Ansprüche als auch auf Volksbildung achtet."
    ],
    "en": [
      "Based at the Théâtre Prémol since September 2025, the Centre des Arts du Récit promotes the arts of the spoken word with a dual focus on artistic excellence and popular education."
    ],
    "it": [
      "Con sede al Théâtre Prémol dal settembre 2025, il Centre des Arts du Récit promuove la parola parlata con una duplice attenzione all'eccellenza artistica e all'educazione popolare."
    ],
    "fr": [
      "Installé au Théâtre Prémol depuis septembre 2025, le Centre des Arts du Récit défend les arts de la parole dans un double souci d’exigence artistique et d’éducation populaire."
    ],
    "nl": [
      "Het Centre des Arts du Récit is sinds september 2025 gevestigd in het Théâtre Prémol en promoot het gesproken woord met een dubbele focus op artistieke uitmuntendheid en populaire educatie."
    ],
    "es": [
      "Con sede en el Théâtre Prémol desde septiembre de 2025, el Centre des Arts du Récit promueve la palabra hablada con un doble enfoque: la excelencia artística y la educación popular."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre des Arts du Récit - Théâtre Prémol"
    ]
  },
