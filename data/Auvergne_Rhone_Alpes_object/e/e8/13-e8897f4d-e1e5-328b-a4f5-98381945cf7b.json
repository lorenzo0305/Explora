  "rdfs:comment": {
    "de": [
      "Silber-, Stahl- und Modeschmuck mit den folgenden Marken: Reminiscence Schmuck und Parfums, Nature, Clio Blue, Ciclon, Altesse, Zag, Chamilia, shabada, XC38. Ohr- und Nasenpiercing ohne Termin außer mittwochs."
    ],
    "en": [
      "Silver, steel and costume jewellery with the following brands: Reminiscence jewellery and perfumes, Nature, Clio Blue, Ciclon, Highness, Zag, Chamilia, shabada, XC38. Ear and nose piercing without appointment except Wednesday."
    ],
    "it": [
      "Argento, acciaio e bigiotteria con i seguenti marchi: Gioielli e profumi della memoria, Nature, Clio Blue, Ciclon, Altesse, Zag, Chamilia, shabada, XC38. Piercing all'orecchio e al naso senza appuntamento, tranne il mercoledì."
    ],
    "fr": [
      "Bijouterie argent, acier et fantaisie avec les marques suivantes : Reminiscence bijoux et parfums, Nature, Clio Blue, Ciclon, Altesse, Zag, Chamilia, shabada, XC38. Perçage oreille et nez sans rendez-vous sauf le mercredi."
    ],
    "nl": [
      "Zilveren, stalen en kostuumjuwelen met de volgende merken: Herinneringsjuwelen en parfums, Nature, Clio Blue, Ciclon, Altesse, Zag, Chamilia, shabada, XC38. Oor- en neuspiercing zonder afspraak, behalve op woensdag."
    ],
    "es": [
      "Plata, acero y bisutería con las siguientes marcas: Joyas y perfumes de recuerdo, Nature, Clio Blue, Ciclon, Altesse, Zag, Chamilia, shabada, XC38. Perforación de orejas y nariz sin cita previa, excepto los miércoles."
    ]
  },
