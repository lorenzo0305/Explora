  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8232421f-2e7e-328c-882a-0ec9c0a932b4",
      "dc:description": {
        "de": [
          "Sandstrand an der Grand Site de France des Deux-Caps. Die Bucht von Wissant ist bekannt für ihre Lage, 6 km von den Caps Blanc-Nez und Gris-Nez entfernt. Sie ist ein anerkannter Spot für Kite-Surfer."
        ],
        "en": [
          "Sandy beach on the Grand Site de France des Deux-Caps. Wissant Bay is famous for its location, 6 km from Caps Blanc-Nez and Gris-Nez. It's a well-known spot for kite-surfers."
        ],
        "it": [
          "Spiaggia di sabbia sul Grand Site de France des Deux-Caps. La Baie de Wissant è famosa per la sua posizione, a 6 km da Caps Blanc-Nez e Gris-Nez. È un luogo rinomato per gli amanti del kite-surf."
        ],
        "fr": [
          "Plage de sable sur le Grand Site de France des Deux-Caps. La Baie de Wissant est connue pour sa situation, à 6 km des Caps Blanc-Nez et Gris-Nez. C'est un spot reconnu pour les kite-surfers."
        ],
        "nl": [
          "Zandstrand op de Grand Site de France des Deux-Caps. De Baie de Wissant is beroemd om zijn ligging, op 6 km van Caps Blanc-Nez en Gris-Nez. Het is een bekende plek voor kitesurfers."
        ],
        "es": [
          "Playa de arena en el Grand Site de France des Deux-Caps. La bahía de Wissant es famosa por su ubicación, a 6 km de Caps Blanc-Nez y Gris-Nez. Es un lugar muy conocido por los kitesurfistas."
        ]
      },
