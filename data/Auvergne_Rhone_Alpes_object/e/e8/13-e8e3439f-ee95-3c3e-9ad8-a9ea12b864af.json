  "rdfs:comment": {
    "de": [
      "Osteo-Biokinergie: Wiederherstellung des physischen und emotionalen Gleichgewichts des Körpers (Masseurin und Physiotherapeutin, die nicht mehr zur Ausbildung zugelassen ist).\r\nStrategische Numerologie: ein mächtiges Werkzeug für die persönliche Entwicklung"
    ],
    "en": [
      "State-qualified in physiotherapy and trained in Osteo-Biokinergy for over 25 years.\r\nStrategic Numerology, a powerful personal development tool, helps you to give meaning to your life and define new goals."
    ],
    "it": [
      "Osteo-Biokinergy: riequilibrare il corpo fisicamente ed emotivamente (Masseur-kinésithérapeute déconventionnée de formation)\r\nNumerologia strategica: un potente strumento di sviluppo personale"
    ],
    "fr": [
      "Ostéo-Biokinergie : rééquilibration physique et émotionnelle du coprs (Masseur-kinésithérapeute déconventionnée de formation)\r\nLa Numérologie Stratégique :un outil puissant de développement personnel"
    ],
    "es": [
      "Osteo-Biokinergía: reequilibrar el cuerpo física y emocionalmente (Masseur-kinésithérapeute déconventionnée de formation)\r\nNumerología Estratégica: una poderosa herramienta para el desarrollo personal"
    ],
    "nl": [
      "Een gediplomeerd fysiotherapeut met meer dan 25 jaar training in osteo-biokinergie.\r\nStrategische numerologie, een krachtig hulpmiddel voor persoonlijke ontwikkeling, helpt je betekenis te geven aan je leven en nieuwe doelen te definiëren."
    ]
  },
