  "rdfs:comment": {
    "de": [
      "Unser Unternehmen steht Ihnen für alle Ihre Krankentransporte und Taxis zur Verfügung.\r\nUnser Team steht Ihnen für Ihre Verwaltungsformalitäten zur Verfügung und bietet einen telefonischen Bereitschaftsdienst rund um die Uhr an."
    ],
    "en": [
      "Our company is at your service for all your medical transport and cab needs.\r\nOur team is at your disposal for all your administrative formalities and is on call 24/7."
    ],
    "it": [
      "La nostra azienda è al vostro servizio per tutte le vostre esigenze di trasporto medico e taxi.\r\nIl nostro team è a vostra disposizione per tutte le formalità amministrative ed è reperibile 24 ore al giorno, 7 giorni alla settimana."
    ],
    "fr": [
      "Notre société est à votre service pour tous vos transports sanitaires et taxis.\r\nNotre équipe est à votre disposition pour vos démarches administratives et assure une permanence téléphonique 24h/24 et 7j/7."
    ],
    "nl": [
      "Ons bedrijf staat tot uw dienst voor al uw behoeften op het gebied van medisch vervoer en taxi's.\r\nOns team staat tot uw beschikking voor al uw administratieve formaliteiten en is 24 uur per dag, 7 dagen per week bereikbaar."
    ],
    "es": [
      "Nuestra empresa está a su servicio para todas sus necesidades de transporte médico y taxi.\r\nNuestro equipo está a su disposición para todas sus gestiones administrativas y está de guardia las 24 horas del día, los 7 días de la semana."
    ]
  },
