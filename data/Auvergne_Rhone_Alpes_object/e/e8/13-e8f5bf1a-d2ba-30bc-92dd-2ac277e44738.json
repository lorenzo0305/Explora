  "rdfs:comment": {
    "de": [
      "In einem modernen und gemütlichen Ambiente können Sie unsere hausgemachte Küche mit Produkten der Saison entdecken!\r\nEin kleiner Hunger am Tag? Das \"P'tit Comptoir d'Auguste\" bietet Ihnen: Paninis, Sandwiches, Waffeln, Crêpes und Eis."
    ],
    "en": [
      "In a modern and warm decor, come and discover our home cooking made with seasonal products!\r\nA little hungry during the day? The \"P'tit Comptoir d'Auguste\" offers you: paninis, sandwiches, waffles, pancakes and ice creams."
    ],
    "it": [
      "In un ambiente moderno e accogliente, venite a scoprire la nostra cucina casalinga a base di prodotti di stagione!\r\nUn po' di fame durante il giorno? Il \"P?tit Comptoir d'Auguste\" offre: panini, sandwich, waffle, pancake e gelati."
    ],
    "fr": [
      "Dans un décor moderne et chaleureux, venez découvrir notre cuisine maison faite à base de produits de saison !\r\nUn petit creux en journée? Le \"P’tit Comptoir d’Auguste\" vous propose: paninis, sandwichs, gaufres, crêpes et glaces."
    ],
    "nl": [
      "Kom in een modern en warm kader kennismaken met onze huiselijke keuken op basis van seizoensproducten!\r\nHeb je overdag trek? De \"P'tit Comptoir d'Auguste\" biedt u: panini's, sandwiches, wafels, pannenkoeken en ijs."
    ],
    "es": [
      "En un ambiente moderno y cálido, venga a descubrir nuestra cocina casera elaborada con productos de temporada\r\n¿Tienes un poco de hambre durante el día? El \"P?tit Comptoir d?Auguste\" le ofrece: paninis, sándwiches, gofres, crepes y helados."
    ]
  },
