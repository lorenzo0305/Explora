  "rdfs:comment": {
    "de": [
      "Das Höhenrestaurant Chalet Sauvage bietet eine Winterküche von Eric Frechon und einen festlichen Après-Ski-Club mit hedonistischem Flair mitten im Skigebiet, das über die Lifte Mont d'Arbois und Princesse erreichbar ist."
    ],
    "en": [
      "Chalet Sauvage is a mountain restaurant offering winter cuisine by Eric Frechon and a festive après-ski club with a hedonistic spirit in the heart of the ski area, accessible by the Mont d'Arbois and Princesse ski lifts."
    ],
    "it": [
      "Alter ego di La Ferme Saint-Amour sulle piste, lo Chalet Sauvage è un nuovo ristorante in quota e un festoso après-ski club dove ritroverete lo stesso spirito edonistico nel cuore del comprensorio sciistico ed accessibile  dagli impianti di risalita Mont d'Arbois e Princesse."
    ],
    "fr": [
      "Restaurant d'altitude, Chalet Sauvage propose une cuisine d'hiver signée Eric Frechon et un club après-ski festif à l'esprit hédoniste en plein coeur du domaine skiable et accessible par les remontées Mont d'Arbois et Princesse."
    ],
    "es": [
      "Restaurante de altura, el Chalet Sauvage ofrece cocina de invierno de Eric Frechon y un festivo club après-ski de espíritu hedonista, en pleno corazón del dominio esquiable y accesible por los remontes del Mont d'Arbois y Princesse."
    ],
    "nl": [
      "Chalet Sauvage, een restaurant op grote hoogte, biedt een winterse keuken van Eric Frechon en een feestelijke après-ski club met een hedonistische geest, midden in het skigebied en bereikbaar met de liften Mont d'Arbois en Princesse."
    ]
  },
