  "rdfs:comment": {
    "de": [
      "Das Restaurant des Heliopic Hotel &amp; Spa, das seit 2020 jedes Jahr vom Guide Michelin mit einem Bib Gourmand ausgezeichnet wird, lädt zu einer überraschenden Reise der Sinne in das Herz der Berggeschmäcker ein."
    ],
    "en": [
      "The Heliopic Hotel &amp; Spa restaurant, awarded a Bib Gourmand by the Michelin Guide every year since 2020, invites you on a surprising journey of the senses to the heart of mountain flavors."
    ],
    "it": [
      "Il ristorante dell'Heliopic Hotel &amp; Spa, premiato ogni anno con un Bib Gourmand dalla Guida Michelin dal 2020, vi invita a un sorprendente viaggio dei sensi nel cuore dei sapori di montagna."
    ],
    "fr": [
      "Le restaurant de l’Heliopic Hotel & Spa, récompensé d’un Bib Gourmand par le Guide Michelin chaque année depuis 2020, invite à un surprenant voyage des sens au cœur des saveurs de montagne."
    ],
    "nl": [
      "Het restaurant van Heliopic Hotel & Spa, sinds 2020 elk jaar bekroond met een Bib Gourmand door de Michelingids, nodigt je uit voor een verrassende zintuiglijke reis naar het hart van de bergsmaken."
    ],
    "es": [
      "El restaurante del Heliopic Hotel &amp; Spa, galardonado cada año con un Bib Gourmand de la Guía Michelin desde 2020, te invita a un sorprendente viaje de los sentidos al corazón de los sabores de montaña."
    ]
  },
