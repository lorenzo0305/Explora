  "rdfs:comment": {
    "de": [
      "Les cavaliers des Revoux in St-Martin-en-Vercors bietet Ausritte, Wanderungen und Pferdepensionen in einer außergewöhnlichen natürlichen Umgebung. Diese familiäre Struktur legt Wert auf den Respekt vor der Natur und das Reiten im Freien. Isa ist Ihre Begleiterin"
    ],
    "en": [
      "Les cavaliers des Revoux, in St-Martin-en-Vercors, offers rides, hikes and horse boarding in an exceptional natural setting. This family-run business promotes respect for nature and outdoor riding. Isa will be your guide"
    ],
    "it": [
      "Les cavaliers des Revoux, a St-Martin-en-Vercors, offre cavalcate, trekking e pensione per cavalli in un ambiente naturale eccezionale. Questa azienda a conduzione familiare promuove il rispetto per la natura e l'equitazione all'aria aperta. Isa sarà la vostra guida"
    ],
    "fr": [
      "Les cavaliers des Revoux, à St-Martin-en-Vercors, offre balades, randonnées et pension pour chevaux dans un cadre naturel exceptionnel. Cette structure familiale valorise le respect de la nature et l’équitation en plein air. Isa sera votre accompagnatrice"
    ],
    "nl": [
      "Les cavaliers des Revoux, in St-Martin-en-Vercors, biedt ritten, trektochten en paardenpension in een uitzonderlijke natuurlijke omgeving. Dit familiebedrijf promoot respect voor de natuur en paardrijden in de buitenlucht. Isa is je gids"
    ],
    "es": [
      "Les cavaliers des Revoux, en St-Martin-en-Vercors, ofrece paseos, excursiones y pupilaje de caballos en un entorno natural excepcional. Esta empresa familiar promueve el respeto por la naturaleza y la equitación al aire libre. Isa será su guía"
    ]
  },
