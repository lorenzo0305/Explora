  "rdfs:comment": {
    "de": [
      "Genießen Sie eine Küche aus frischen, lokalen und bäuerlichen Produkten im Speisesaal mit Bistro-Atmosphäre, auf der Veranda oder an schönen Tagen auf der Holzterrasse."
    ],
    "en": [
      "Enjoy our cuisine prepared with fresh, local and farm produce in our dining room with a bistro atmosphere, our veranda or on our wooden terrace on sunny days."
    ],
    "it": [
      "Venite a gustare una cucina a base di prodotti freschi, locali e di fattoria nel ristorante con atmosfera da bistrot, nella veranda o sulla terrazza in legno nella bella stagione."
    ],
    "fr": [
      "Venez déguster une cuisine à base de produits frais, locaux et fermiers dans la salle de restaurant à l'ambiance bistrot, la véranda ou sur la terrasse en bois aux beaux jours."
    ],
    "es": [
      "Venga a degustar una cocina basada en productos frescos, locales y de granja en el restaurante con ambiente de bistró, en el porche o en la terraza de madera cuando hace buen tiempo."
    ],
    "nl": [
      "Kom genieten van een keuken op basis van verse, lokale en boerderijproducten in het restaurant met bistrosfeer, de veranda of bij mooi weer op het houten terras."
    ]
  },
