  "rdfs:comment": {
    "de": [
      "Panoramarestaurant in der obersten Etage des Hotels Eliova le Chaix. Traditionelle Küche und Spezialitäten aus Savoyen (Fondue, Raclette, Tartiflette?). Tagesmenü und Speisekarte.\r\nReservierung empfohlen."
    ],
    "en": [
      "Panoramic restaurant located on the top floor of the Hotel Eliova le Chaix. Traditional cuisine and Savoyard specialities.\r\nDaily menu and menu.\r\nBooking is recommended."
    ],
    "it": [
      "Ristorante panoramico situato all'ultimo piano dell'Hotel Eliova le Chaix. Cucina tradizionale e specialità savoiarde (fonduta, raclette, tartiflette?). Menu del giorno e alla carta.\r\nSi consiglia la prenotazione."
    ],
    "fr": [
      "Restaurant panoramique situé au dernier étage de l’Hôtel Eliova le Chaix. Cuisine traditionnelle et spécialités savoyardes (fondue, raclette, tartiflette…). Menu du jour et carte.\r\nRéservation conseillée."
    ],
    "es": [
      "Restaurante panorámico situado en la última planta del hotel Eliova le Chaix. Cocina tradicional y especialidades saboyanas (fondue, raclette, tartiflette...). Menú del día y a la carta.\r\nSe recomienda reservar."
    ],
    "nl": [
      "Panoramisch restaurant op de bovenste verdieping van Hotel Eliova le Chaix. Traditionele keuken en Savoyaardse specialiteiten.\r\nDagmenu en menu.\r\nReserveren wordt aanbevolen."
    ]
  },
