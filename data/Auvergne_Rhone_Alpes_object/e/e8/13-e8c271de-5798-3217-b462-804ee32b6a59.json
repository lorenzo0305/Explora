  "rdfs:comment": {
    "de": [
      "Nachdem sie vier ausverkaufte Pariser Zeniths angekündigt hat, macht Théodora einen weiteren Schritt und enthüllt ihre Tournee, mit der sie ihr Publikum einlädt, in die glühende Welt von MEGA BBL einzutauchen."
    ],
    "en": [
      "After announcing four sold-out Parisian Zeniths, Théodora takes the next step and unveils her tour, inviting audiences to plunge into the incandescent world of MEGA BBL."
    ],
    "it": [
      "Dopo aver annunciato quattro Zeniths sold-out a Parigi, Théodora fa un ulteriore passo avanti e svela il suo tour, invitando il pubblico a immergersi nell'incandescente mondo di MEGA BBL."
    ],
    "fr": [
      "Après avoir annoncé quatre Zéniths parisiens complets, Théodora franchit une nouvelle étape et dévoile sa tournée, invitant son public à plonger dans l'univers incandescent de MEGA BBL."
    ],
    "es": [
      "Tras anunciar cuatro Zenith parisinas con todas las entradas agotadas, Théodora da un paso más y desvela su gira, invitando a su público a sumergirse en el mundo incandescente de MEGA BBL."
    ],
    "nl": [
      "Na de aankondiging van vier uitverkochte Zeniths in Parijs gaat Théodora nog een stapje verder en onthult ze haar tournee, waarbij ze haar publiek uitnodigt om een duik te nemen in de gloeiende wereld van MEGA BBL."
    ]
  },
