  "rdfs:comment": {
    "de": [
      "Entdecken Sie das erste bioklimatische Hotel-SPA in der Region Rhône-Alpes und das dritte in Frankreich. Das Hotel-SPA **** & Restaurant Logis befindet sich im Herzen des Grand Massif und überragt den Skiort Les Carroz. Genießen Sie auch den Mountain SPA & Wellness-Bereich und das Gourmetrestaurant"
    ],
    "en": [
      "Discover the 1st bioclimatic hotel-SPA in Rhône Alpes, 3rd in France. The hotel-SPA **** & restaurant Logis is located in the heart of the Grand Massif, overlooking the resort of Les Carroz. Also enjoy the Mountain SPA & Wellness area and gourmet restaurant"
    ],
    "it": [
      "Scoprite il 1° hotel-SPA bioclimatico del Rodano-Alpi, il 3° in Francia. L'hotel-SPA **** & ristorante Logis si trova nel cuore del Grand Massif, con vista sulla località di Les Carroz. Approfittate dell'area SPA & Wellness di montagna e del ristorante gastronomico"
    ],
    "fr": [
      "Découvrez le 1er hôtel-SPA bioclimatique en Rhône Alpes, 3ème en France. L'hôtel-SPA **** & restaurant Logis est situé au cœur du Grand Massif, surplombe la station des Carroz. Profitez aussi de l'espace Mountain SPA & Wellness et restaurant gastronomique"
    ],
    "nl": [
      "Ontdek het 1e bioklimatische hotel-SPA in Rhône Alpes, 3e in Frankrijk. Het hotel-SPA **** & restaurant Logis is gelegen in het hart van het Grand Massif, met uitzicht op de badplaats Les Carroz. Geniet ook van de Mountain SPA & Wellness en het gastronomische restaurant"
    ],
    "es": [
      "Descubra el primer hotel-spa bioclimático de Rhône Alpes, el tercero de Francia. El hotel-SPA **** & restaurant Logis está situado en el corazón del Grand Massif, con vistas a la estación de Les Carroz. Aproveche la zona de spa y bienestar de montaña y el restaurante gastronómico"
    ]
  },
  "rdfs:label": {
    "en": [
      "La Croix de Savoie Hotel Spa"
    ],
    "fr": [
      "Hôtel La Croix de Savoie et Spa"
    ],
    "nl": [
      "La Croix de Savoie Hotel Spa"
    ]
  },
