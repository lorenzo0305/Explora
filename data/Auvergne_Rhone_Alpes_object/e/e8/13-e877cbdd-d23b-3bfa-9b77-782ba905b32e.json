  "rdfs:comment": {
    "de": [
      "Lernen Sie die GAEC Ferme de La Lanche kennen, die Ihnen BIO-Kuhkäse, Rind-, Schweine- und Lammfleisch sowie andere bäuerliche, lokale und/oder BIO-Produkte anbietet. Besuchen Sie uns in unserer Verkaufsstelle und auf dem Markt in Abondance."
    ],
    "en": [
      "Come and meet the GAEC Ferme de La Lanche, which offers organic cow's milk cheese, beef, pork and lamb, as well as other farmhouse, local and/or organic products. Visit us at our sales outlet and at the Abondance market."
    ],
    "it": [
      "Venite a conoscere la GAEC Ferme de La Lanche, che vende formaggio di latte vaccino biologico, carne di manzo, maiale e agnello, oltre ad altri prodotti di fattoria, locali e/o biologici. Venite a trovarci nel nostro punto vendita e al mercato di Abondance."
    ],
    "fr": [
      "Venez à la rencontre du GAEC Ferme de La Lanche qui vous propose ses fromages de vache BIO, viande de bœuf, porc ou agneau, ainsi que d'autres produits fermiers, locaux et/ou BIO. Retrouvez nous dans notre point de vente et au marché d'Abondance."
    ],
    "es": [
      "Venga a conocer el GAEC Ferme de La Lanche, que ofrece quesos ecológicos de leche de vaca, ternera, cerdo y cordero, así como otros productos de granja, locales y/o ecológicos. Venga a vernos a nuestro punto de venta y al mercado de Abondance."
    ],
    "nl": [
      "Kom kennismaken met de GAEC Ferme de La Lanche, die biologische kaas van koemelk, rundvlees, varkensvlees en lamsvlees verkoopt, evenals andere boerderij-, lokale en/of biologische producten. Kom langs in ons verkooppunt en op de markt van Abondance."
    ]
  },
