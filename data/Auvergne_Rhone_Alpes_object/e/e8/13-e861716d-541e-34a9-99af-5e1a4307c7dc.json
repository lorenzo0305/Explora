  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt bietet: Informationsmaterial über die Region, Internetterminal, Fotokopien, Fax und Scannen von Dokumenten, Reservierungen und Kartenverkauf für Aktivitäten (Programm), Verkauf von Shuttle-Tickets: Brides - Moutiers (nur im Winter)"
    ],
    "en": [
      "Tourist office proposes: Information and local documentation, Internet Access Point, Photocopies, fax and scan of documents, Reservations and booking of the different activites listed in the what’s on guide, Sale of bus tickets: Brides – Moutiers  (winter only)"
    ],
    "it": [
      "L'Ufficio del Turismo offre: documentazione sulla regione, terminale internet, fotocopie, fax e scansioni di documenti, prenotazioni e biglietti per le attività (programma), vendita di biglietti per le navette: Spose ? Moutiers (solo in inverno)"
    ],
    "fr": [
      "L’Office de Tourisme propose : Documentation sur la région, borne internet, photocopies, fax et scan des documents, réservations et billetterie d’activités (programme), vente tickets navette : Brides – Moutiers (hiver uniquement)"
    ],
    "es": [
      "La Oficina de Turismo ofrece: documentación sobre la región, terminal de Internet, fotocopias, faxes y escaneos de documentos, reservas y entradas para actividades (programa), venta de billetes de transporte: Novias ? Moutiers (sólo en invierno)"
    ],
    "nl": [
      "Het VVV-kantoor biedt: documentatie over de regio, internetterminal, fotokopieën, faxen en scans van documenten, reserveringen en tickets voor activiteiten (programma), verkoop van pendeltickets: Brides - Moutiers (alleen in de winter)"
    ]
  },
