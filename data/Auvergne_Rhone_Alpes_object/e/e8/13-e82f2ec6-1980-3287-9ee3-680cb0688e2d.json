  "rdfs:comment": {
    "de": [
      "la ferme ist ein einzigartiger Mehrzweckort, der ein Café-Bistro-Boutique-Teesalon, einen Raum für gemeinsame Arbeit sowie kulturelle und pädagogische Räume vereint. \r\nDas Café-Bisto bietet eine lokale, saisonale, biologische, abwechslungsreiche und engagierte Küche an."
    ],
    "en": [
      "la ferme is a unique multi-purpose space combining a café-bistro-boutique-tea room, a shared workspace and cultural and educational facilities. \r\nThe café-bisto serves local, seasonal, organic, varied and committed cuisine."
    ],
    "it": [
      "la ferme è uno spazio polifunzionale unico che combina un caffè-bistrot, una sala da tè, uno spazio di lavoro condiviso e strutture culturali ed educative. Il caffè-bistrot serve una cucina locale, stagionale, biologica, varia e impegnata."
    ],
    "fr": [
      "la ferme est un lieu singulier multi-usages regroupant un café-bistro-boutique-salon de thé, un espace de travail partagé et des espaces culturels et pédagogiques. Le café-bistro propose une cuisine locale, de saison, bio, variée et engagée."
    ],
    "nl": [
      "la ferme is een unieke multifunctionele ruimte die een café-bistro-boutique-theeruimte, een gedeelde werkruimte en culturele en educatieve faciliteiten combineert. Het café-bistro serveert lokale, seizoensgebonden, biologische, gevarieerde en geëngageerde gerechten."
    ],
    "es": [
      "la ferme es un espacio polivalente único que combina un café-bistro-boutique-sala de té, un espacio de trabajo compartido e instalaciones culturales y educativas. El café-bistró sirve cocina local, de temporada, ecológica, variada y comprometida."
    ]
  },
