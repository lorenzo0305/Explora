  "rdfs:comment": {
    "de": [
      "Ihr Coffeeshop Good Bean Coffe in Valencia bietet Ihnen eine große Auswahl an Heißgetränken auf Kaffee- oder Schokoladenbasis sowie englisches Gebäck, Suppen, Bruschettas, Bagels..."
    ],
    "en": [
      "Your Good Bean Coffe coffee shop in Valence offers a wide choice of hot coffee and chocolate drinks, as well as English pastries, soups, bruschettas, bagels..."
    ],
    "it": [
      "La caffetteria \"Good Bean Coffee\" di Valence offre un'ampia scelta di caffè caldo e freddo, cioccolata, tè e bevande a base di frutta, oltre a pasticcini. Veloutés, ottime insalate e panini fatti in casa."
    ],
    "fr": [
      "Votre coffee shop \"Good Bean Coffee\" à Valence vous propose un large choix de boissons chaudes ou froides à base de café, de chocolat, de thés ou fruitées ainsi que des pâtisseries. Des veloutés, de belles salades ainsi que des sandwichs fait maison."
    ],
    "es": [
      "Su cafetería \"Good Bean Coffee\" de Valence le ofrece una amplia selección de café caliente y frío, chocolate, té y bebidas a base de frutas, así como bollería. Veloutés, estupendas ensaladas y sándwiches caseros."
    ],
    "nl": [
      "De Good Bean Coffe koffieshop in Valence biedt een breed scala aan warme koffie en chocoladedranken, maar ook Engels gebak, soepen, bruschetta's, bagels, enz."
    ]
  },
