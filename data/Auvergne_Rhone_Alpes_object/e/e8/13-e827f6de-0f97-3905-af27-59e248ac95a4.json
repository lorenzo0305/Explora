  "rdfs:comment": {
    "de": [
      "Le Coq Rouge empfängt Sie mit einer traditionellen Küche, die die Produkte der Region veredelt und von einem leidenschaftlichen Team in einem modernen und komfortablen Rahmen getragen wird."
    ],
    "en": [
      "Le Coq Rouge welcomes you with a traditional cuisine that sublimates local products, brought to life by a passionate team in a modern, comfortable setting."
    ],
    "it": [
      "Le Coq Rouge vi accoglie con una cucina tradizionale che sublima i prodotti locali, servita da un team appassionato in un ambiente moderno e confortevole."
    ],
    "fr": [
      "Le Coq Rouge vous accueille avec une cuisine traditionnelle qui sublime les produits du terroir, portée par une équipe passionnée, dans un cadre moderne et confortable."
    ],
    "nl": [
      "Le Coq Rouge verwelkomt je met een traditionele keuken die lokale producten sublimeert, geserveerd door een gepassioneerd team in een moderne en comfortabele omgeving."
    ],
    "es": [
      "Le Coq Rouge le recibe con una cocina tradicional que sublima los productos locales, servida por un equipo apasionado en un marco moderno y confortable."
    ]
  },
