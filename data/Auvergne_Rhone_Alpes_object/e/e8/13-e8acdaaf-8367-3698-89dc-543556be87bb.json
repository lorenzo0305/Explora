  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese schöne 1900 Brasserie, in der Lyoner, Touristen und Künstler sich seit mehr als 35 Jahren streifen. Profitieren Sie im Sommer von der Terrasse in der symbolischsten Fußgängerzone Lyons."
    ],
    "en": [
      "Discover this attractive 1900 brasserie which has been popular with local residents, tourists and artists for more than 35 years now. Don't miss the terrace, from where you can admire Lyon's most famous pedestrianized street."
    ],
    "it": [
      "Scopri questa bella brasserie del Novecento in cui Lionesi, turisti e artisti si incontrano da più di 35 anni. L'estate goditi i tavolini all'aperto nella via pedonale più nota di Lione."
    ],
    "fr": [
      "Découvrez cette belle brasserie 1900 où se côtoient Lyonnais, touristes et artistes depuis plus de 35 ans. L’été, profitez de la terrasse dans la plus emblématique rue piétonne de Lyon."
    ],
    "nl": [
      "Ontdek deze prachtige brasserie uit 1900 waar Lyonnais, toeristen en kunstenaars al meer dan 35 jaar met elkaar in contact komen. Geniet in de zomer van het terras in de meest emblematische voetgangersstraat van Lyon."
    ],
    "es": [
      "En esta bonita \"brasserie\" de 1900 se reúnen indistintamente lioneses, turistas y artistas desde hace más de 35 años. En verano, cuenta con una terraza en la calle peatonal más emblemática de Lyon"
    ]
  },
