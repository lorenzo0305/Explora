  "rdfs:comment": {
    "de": [
      "Förderung des traditionellen Jazz durch :\r\nPädagogische Konzerte für Schulklassen, Swing-Tanz- oder Vokal-Jazz-Workshops, Jazzfestival im März, Louisiana-Tag im November.\r\nReisen im Zusammenhang mit Jazz (Jazzroute) - Jazz-Kinovorstellungen."
    ],
    "en": [
      "The association promotes traditional jazz music by organizing concerts,\r\na festival in March.\r\na Louisiana day in november\r\ntrips: short ones to festivals in France or long ones abroad"
    ],
    "it": [
      "Promozione del jazz tradizionale attraverso :\r\nConcerti di jazz tradizionale, corsi di danza swing e di jazz vocale, Louisiana Day a novembre.\r\nViaggi di gruppo a festival jazz - Proiezioni di cinema jazz."
    ],
    "fr": [
      "Promotion du jazz traditionnel par le biais de : \r\nConcerts de jazz traditionnel, stages de danse swing ou de jazz vocal, journée louisianaise en novembre.\r\nEscapades collectives dans des festivals de jazz - Séances de cinéma jazz."
    ],
    "nl": [
      "Promotie van traditionele jazz door :\r\nEducatieve concerten voor schoolkinderen, cursussen swingdans en vocale jazz, jazzfestival in maart, Louisiana Day in november.\r\nJazzreizen (Route du Jazz) - Jazzbioscoopvoorstellingen."
    ],
    "es": [
      "Promoción del jazz tradicional a través de :\r\nConciertos de jazz tradicional, cursos de baile swing y jazz vocal, Día de Luisiana en noviembre.\r\nViajes en grupo a festivales de jazz - Proyecciones de cine de jazz."
    ]
  },
  "rdfs:label": {
