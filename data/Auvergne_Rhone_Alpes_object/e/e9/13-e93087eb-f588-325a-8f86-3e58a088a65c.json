  "rdfs:comment": {
    "de": [
      "Das Beste der italienischen Aromen erwartet Sie in La Rôtisserie! Auf der Speisekarte: Antipasti zum Teilen, Pasta al dente, gegrilltes Fleisch und Fisch sowie hausgemachte Pizzen."
    ],
    "en": [
      "The best of Italian flavours awaits you at La Rôtisserie! On the menu: antipasti to share, al dente pasta, grilled meat and fish and homemade pizzas."
    ],
    "it": [
      "Il meglio dei sapori italiani vi aspetta alla Rôtisserie! Nel menu: antipasti da condividere, pasta al dente, carne e pesce alla griglia e pizze fatte in casa."
    ],
    "fr": [
      "Le meilleur des saveurs italiennes vous attend à La Rôtisserie ! À la carte : antipastis à partager, pâtes al dente, viandes et poissons grillés et pizzas faites maison."
    ],
    "es": [
      "¡Lo mejor de los sabores italianos le espera en La Rôtisserie! En la carta: antipastis para compartir, pasta al dente, carnes y pescados a la parrilla y pizzas caseras."
    ],
    "nl": [
      "Het beste van de Italiaanse keuken wacht op u in La Rôtisserie! Op het menu: antipasti om te delen, al dente pasta, gegrild vlees en vis en huisgemaakte pizza's."
    ]
  },
