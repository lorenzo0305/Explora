  "rdfs:comment": {
    "de": [
      "Das 1885 unter Emile Loubet erbaute Stadttheater von Montélimar ist ein Wahrzeichen der Belle Epoque Montiliens und eine unumgängliche Sehenswürdigkeit der Stadt."
    ],
    "en": [
      "An emblem of Montélimar's Belle Epoque, built in 1885 under the mandate of Emile Loubet, Montélimar's municipal theater is one of the city's landmarks."
    ],
    "it": [
      "Emblema della Belle Epoque di Montélimar, costruito nel 1885 su mandato di Emile Loubet, il teatro municipale di Montélimar è una delle attrazioni imperdibili della città."
    ],
    "fr": [
      "Emblème de la Belle Epoque montilienne, construit en 1885 sous le mandat d'Emile Loubet, le théâtre municipal de Montélimar est un site incontournable de la ville."
    ],
    "nl": [
      "Het stadstheater van Montélimar, een embleem van de Belle Epoque van Montélimar en gebouwd in 1885 onder het mandaat van Emile Loubet, is een van de trekpleisters van de stad."
    ],
    "es": [
      "Emblema de la Belle Epoque de Montélimar, construido en 1885 bajo el mandato de Emile Loubet, el teatro municipal de Montélimar es una de las atracciones imprescindibles de la ciudad."
    ]
  },
  "rdfs:label": {
