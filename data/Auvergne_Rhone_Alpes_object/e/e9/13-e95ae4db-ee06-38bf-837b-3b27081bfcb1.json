  "rdfs:comment": {
    "de": [
      "In einem Tandemflug, begleitet von einem professionellen Lehrer, kannst du wunderschöne Momente in einer tollen Umgebung und Atmosphäre verbringen! Spirale Parapente empfängt dich im Stadtzentrum von Samoëns, auf dem Place du Gros Tilleul."
    ],
    "en": [
      "Fly with a professional instructor and have a great time enjoying beautiful landscapes in a fun atmosphere! Spirale Parapente welcomes you to Samoens in the main square, la Place du Gros Tilleul."
    ],
    "it": [
      "In tandem, accompagnati da un istruttore professionista, potrete divertirvi in un ambiente e in un'atmosfera fantastici! Lo Spirale Parapente vi accoglie nel centro di Samoëns, in Place du Gros Tilleul."
    ],
    "fr": [
      "En biplace, accompagné d'un moniteur professionnel, tu peux passer des moments magnifiques dans un environnement et une ambiance top! Spirale Parapente t'accueille en plein centre ville de Samoëns, sur la place du Gros Tilleul."
    ],
    "nl": [
      "In tandem , vergezeld van een professionele instructeur , kunt u genieten van rustige momenten in een omgeving en de sfeer geweldig!"
    ],
    "es": [
      "En tándem, acompañados por un instructor profesional, ¡podrán divertirse en un ambiente y una atmósfera estupendos! Spirale Parapente le da la bienvenida en el centro de Samoëns, en la Place du Gros Tilleul."
    ]
  },
