  "rdfs:comment": {
    "de": [
      "Der Lac de Fontaine befindet sich in der Gemeinde Vacheresse auf 1350 m Höhe. Er ist mit dem Auto erreichbar.\r\nFischbestand: Bachforellen, Regenbogenforellen, Elritzen."
    ],
    "en": [
      "Lac de Fontaine is located in the commune of Vacheresse at 1350m altitude. Accessible by car.\r\nFish population: fario trout, rainbow trout, minnows."
    ],
    "it": [
      "Il Lac de Fontaine si trova nel comune di Vacheresse, a 1350 m di altitudine. Accessibile in auto.\r\nPopolazione ittica: trota fario, trota iridea, pesciolini."
    ],
    "fr": [
      "Le lac de Fontaine se situe sur la commune de Vacheresse à 1350m d’altitude. Accessible en voiture. \r\nPeuplement piscicole : truites fario, truites arc-en-ciel, vairons."
    ],
    "nl": [
      "Lac de Fontaine ligt in de gemeente Vacheresse op een hoogte van 1350m. Bereikbaar met de auto.\r\nVispopulatie: beekforel, regenboogforel, minnows."
    ],
    "es": [
      "El lago de Fontaine se encuentra en el municipio de Vacheresse, a 1350 m de altitud. Accesible en coche.\r\nPoblación piscícola: trucha común, trucha arco iris, pececillos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at the Fontaine lake"
    ],
    "fr": [
      "Pêche au lac de Fontaine"
    ],
    "nl": [
      "Vissen bij het meer van Fontaine"
    ]
  },
