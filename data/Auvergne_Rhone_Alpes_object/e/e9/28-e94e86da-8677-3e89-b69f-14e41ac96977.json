      "rdfs:comment": {
        "de": [
          "François Dequidt in Merris produziert und verkauft Sommerhonig, der bernsteinfarben ist und einen viel stärkeren (süßeren) Geschmack hat als der Frühlingshonig. Er ist in den Partnergeschäften zu finden."
        ],
        "en": [
          "François Dequidt in Merris produces and sells amber-colored summer honey, with a much stronger (sweeter) taste than spring honey. Available in partner stores."
        ],
        "it": [
          "François Dequidt a Merris produce e vende miele estivo di colore ambrato con un sapore molto più forte (più dolce) del miele primaverile. Disponibile nei negozi partner."
        ],
        "fr": [
          "François Dequidt à Merris produit et vend du miel d'été, d'une couleur ambrée, au goût beaucoup plus prononcé (sucrée) que le miel de printemps. A retrouver dans les magasins partenaires."
        ],
        "es": [
          "François Dequidt, en Merris, produce y vende miel de verano de color ámbar y sabor mucho más fuerte (dulce) que la miel de primavera. Disponible en los comercios asociados."
        ],
        "nl": [
          "François Dequidt in Merris produceert en verkoopt amberkleurige zomerhoning met een veel sterkere (zoetere) smaak dan lentehoning. Verkrijgbaar in partnerwinkels."
        ]
      },
