  "rdfs:comment": {
    "de": [
      "Die Kapelle Sainte Anne stammt aus dem 12. Jahrhundert. Sie ist im romanisch-provenzalischen Stil erbaut und befindet sich auf dem Friedhof. Sie wurde auf einer alten römischen Stätte errichtet und hat deren Unterbauten beibehalten. Im Jahr 1992 wurde sie verlassen. Sie ist das letzte Überbleibsel des Klosters."
    ],
    "en": [
      "Chapelle Sainte Anne dates back to the 12th century. Built in the Romanesque Provencal style, it is located in the cemetery. Built on an ancient Roman site, it retains its original substructures. It was abandoned in 1992. It is the last vestige of the convent."
    ],
    "it": [
      "La cappella Sainte Anne risale al XII secolo. È romanica e si trova nel cimitero. Costruito su un antico sito romano, ha conservato le sue sottostrutture. Nel 1992 è stato abbandonato. È l'ultima vestigia del convento."
    ],
    "fr": [
      "La Chapelle Sainte Anne date du XIIe siècle. De style roman provençal, elle est située dans le cimetière. Construite sur un ancien site romain, elle en a gardé les substructures. En 1992, elle est abandonnée. Elle est le dernier vestige du couvent."
    ],
    "es": [
      "La capilla de Santa Ana data del siglo XII. Es de estilo románico y se encuentra en el cementerio. Construido sobre un antiguo emplazamiento romano, ha conservado sus subestructuras. En 1992 se abandonó. Es el último vestigio del convento."
    ],
    "nl": [
      "Chapelle Sainte Anne dateert uit de 12e eeuw. Ze is gebouwd in de Romaanse Provençaalse stijl en ligt op het kerkhof. Het is gebouwd op een oude Romeinse plek en heeft zijn oorspronkelijke structuur behouden. Het werd verlaten in 1992. Het is het laatste overblijfsel van het klooster."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Sainte Anne"
    ]
  },
