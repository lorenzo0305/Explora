  "rdfs:comment": {
    "de": [
      "Klettern Sie in den Ästen und besuchen Sie die hängenden Baumhäuser! 14 Baumhäuser, die in den Bäumen thronen, mit einem spielerischen Weg, einem Netzparcours, Rutschen und zwei riesigen Trampolinen!"
    ],
    "en": [
      "Climb into the branches and visit the hanging tree houses! 14 tree houses perched in the trees with a fun trail, a net course, slides and two giant trampolines!"
    ],
    "it": [
      "Venite ad arrampicarvi sui rami e a visitare le case sugli alberi sospese! 14 casette appese agli alberi con un percorso divertente, un percorso a rete, scivoli e due trampolini giganti!"
    ],
    "fr": [
      "Venez grimper dans les branches et visiter les cabanes suspendues ! 14 cabanes perchées dans les arbres avec un cheminement ludique, un parcours de filets, des toboggans, et deux trampolines géants !"
    ],
    "es": [
      "Venga a trepar por las ramas y a visitar las casas colgantes de los árboles 14 casas colgadas de los árboles con un divertido sendero, un circuito de redes, toboganes y dos camas elásticas gigantes"
    ],
    "nl": [
      "Kom in de takken klimmen en bezoek de hangende boomhutten! 14 boomhutten hoog in de bomen met een leuk parcours, een netparcours, glijbanen en twee reuzentrampolines!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Perched huts at the Trièves adventure park"
    ],
    "fr": [
      "Cabanes perchées au Parcours aventure Trièves"
    ]
  },
