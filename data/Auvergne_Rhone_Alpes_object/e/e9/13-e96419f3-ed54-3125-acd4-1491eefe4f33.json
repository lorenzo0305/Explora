  "rdfs:comment": {
    "de": [
      "Spielplatz im Parc des cèdres für Kinder von 2 bis 12 Jahren.\r\nHier gibt es verschiedene Kinderspielgeräte: Multispielgerät mit Rutsche und Schaukel. Kleine Hütte und Gleichgewichtsparcours. Sitzbank."
    ],
    "en": [
      "Cedar Park playground for children aged 2 to 12.\r\nVarious children's play equipment: multi-game structure with slide, swing. Small tree house and balance course. Bench."
    ],
    "it": [
      "Parco giochi Cedar Park per bambini dai 2 ai 12 anni.\r\nVari giochi per bambini: struttura multigioco con scivolo, altalena. Piccola casa sull'albero e percorso di equilibrio. Panchine disponibili."
    ],
    "fr": [
      "Aire de jeux du parc des cèdres pour les enfants de 2 à 12ans. \r\nPrésence de divers jeux pour enfants: structure multi-jeux avec toboggan, balançoire. Petite cabane et parcours d'équilibre. Présence de Banc."
    ],
    "es": [
      "Zona de juegos Cedar Park para niños de 2 a 12 años.\r\nVarios juegos infantiles: estructura multijuego con tobogán, columpio. Pequeña casa en el árbol y recorrido de equilibrio. Bancos disponibles."
    ],
    "nl": [
      "Cedar Park speeltuin voor kinderen van 2 tot 12 jaar.\r\nVerschillende kinderspelen: multispelstructuur met glijbaan, schommel. Kleine boomhut en evenwichtsparcours. Bankjes beschikbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux parc des cèdres"
    ]
  },
