  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Geschmack von süßen oder herzhaften Crêpes im Ch'ti Père, es sei denn, Sie sind eher für Bretter oder Snacks und verbringen Sie einen geselligen Moment mit Freunden oder der Familie."
    ],
    "en": [
      "Come and discover the taste of sweet or savory crepes to Ch'ti Père, unless you prefer boards and snacks, and spend a friendly moment with friends or family."
    ],
    "it": [
      "Venite a scoprire il gusto delle crêpes dolci o salate a Le Ch'ti Père, a meno che non siate più tipi da tavola o da snack, e trascorrete un momento di convivialità con gli amici o la famiglia."
    ],
    "fr": [
      "Venez découvrir le goût des crêpes sucrées ou salées au Ch'ti Père, à moins que vous ne soyez plutôt planches, snack et passez un moment de convivialité entre amis ou en famille."
    ],
    "es": [
      "Venga a descubrir el sabor de los crêpes dulces o salados en Le Ch'ti Père, a menos que sea más de tablas o bocadillos, y pase un momento de convivencia con los amigos o la familia."
    ],
    "nl": [
      "Kom en ontdek de smaak van zoete of hartige crêpes bij Le Ch'ti Père, tenzij je meer van een bord of snack houdt, en breng een gezellig moment door met vrienden of familie."
    ]
  },
