  "rdfs:comment": {
    "de": [
      "Der Sportbereich des städtischen Albert-Poncet-Zentrums umfasst drei differenzierte Bereiche, die frei zugänglich sind und sich sowohl an Kleinkinder als auch an Senioren, Anfänger und Profis richten."
    ],
    "en": [
      "The sports area at the Albert-Poncet municipal center comprises three differentiated areas, with free access for young children, seniors, beginners and professionals alike."
    ],
    "it": [
      "L'area sportiva del centro comunale Albert-Poncet è composta da tre diverse zone, con accesso libero per bambini, anziani, principianti e professionisti."
    ],
    "fr": [
      "L'aire sportive du centre municipal Albert-Poncet comprend trois espaces différenciés, en accès libre et s'adresse aussi bien aux jeunes enfants qu'aux séniors, aux débutants et aux professionnels."
    ],
    "es": [
      "La zona deportiva del centro municipal Albert-Poncet se compone de tres áreas diferentes, de libre acceso para niños pequeños, mayores, principiantes y profesionales."
    ],
    "nl": [
      "Het sportterrein van het gemeentecentrum Albert-Poncet bestaat uit drie verschillende zones, met gratis toegang voor jonge kinderen, senioren, beginners en professionals."
    ]
  },
