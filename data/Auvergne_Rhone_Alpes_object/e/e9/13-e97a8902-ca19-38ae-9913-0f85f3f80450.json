  "rdfs:comment": {
    "de": [
      "Le Spawn, Bar- und Snack-Restaurant.\r\nLe Spawn empfängt Sie in seiner Bar-Lounge vom Morgenkaffee bis zum Aperitif am Abend in einem hybriden Restaurantkonzept (zwischen Fastfood und Tischservice)."
    ],
    "en": [
      "Le Spawn, bar-snack restaurant.\r\nLe Spawn welcomes you to its lounge bar, from morning coffee to evening aperitifs, with a hybrid catering concept (between fast food and table service)."
    ],
    "it": [
      "Le Spawn, ristorante-bar-snack.\r\nLe Spawn vi accoglie nel suo lounge bar, dal caffè del mattino all'aperitivo serale, con un concetto di ristorante ibrido (a metà tra fast food e servizio al tavolo)."
    ],
    "fr": [
      "Le Spawn, restaurant Bar-snack.\r\nLe Spawn vous accueille dans son bar lounge du café du matin à l'apéritif du soir dans un concept de restauration hybride (entre la restauration rapide et le service à table)."
    ],
    "nl": [
      "Le Spawn, Bar-snack restaurant.\r\nLe Spawn verwelkomt je in zijn loungebar, van 's ochtends koffie tot 's avonds aperitief, met een hybride restaurantconcept (ergens tussen fastfood en bediening aan tafel)."
    ],
    "es": [
      "Le Spawn, Bar-restaurante.\r\nLe Spawn le da la bienvenida a su bar lounge, desde el café de la mañana hasta el aperitivo de la noche, con un concepto de restaurante híbrido (a medio camino entre la comida rápida y el servicio de mesa)."
    ]
  },
