  "rdfs:comment": {
    "de": [
      "Der Lac Servières ist ein Kratersee (Maar), der sich auf 1200 m Höhe befindet. Er entstand durch eine vulkanische Explosion. Er ist 26 Meter tief und hat eine Fläche von 15,5 Hektar."
    ],
    "en": [
      "The Servières lake is a crater lake (maar), located at 1200m altitude. It was born from a volcanic explosion. It is 26 meters deep and has a surface area of 15.5 hectares."
    ],
    "it": [
      "Il lago Servières è un lago craterico (maar), situato ad un'altitudine di 1200 metri. È stata creata da un'esplosione vulcanica. Ha una profondità di 26 metri e una superficie di 15,5 ettari."
    ],
    "fr": [
      "Le lac Servières est un lac de cratère (maar), situé à 1200m d’altitude. Il est né d’une explosion volcanique. Profond de 26 mètres, sa superficie est de 15,5 hectares."
    ],
    "nl": [
      "Het meer van Servières is een kratermeer (maar), gelegen op een hoogte van 1200m. Het is ontstaan door een vulkanische explosie. Het is 26 meter diep en heeft een oppervlakte van 15,5 hectare."
    ],
    "es": [
      "El lago de Servières es un lago de cráter (maar), situado a 1.200 m de altitud. Fue creado por una explosión volcánica. Tiene 26 metros de profundidad y una superficie de 15,5 hectáreas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche au lac Servières"
    ]
  },
