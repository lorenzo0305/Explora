  "rdfs:comment": {
    "de": [
      "Ein Nachmittag voller Geselligkeit und guter Laune! Versuchen Sie Ihr Glück und verbringen Sie einen angenehmen Moment mit der Familie oder mit Freunden, während Sie die Privatschule unterstützen.  Es gibt zahlreiche Preise zu gewinnen."
    ],
    "en": [
      "An afternoon of fun and good cheer! Come and try your luck and have a great time with family and friends, while supporting the private school.  Lots of prizes to be won."
    ],
    "it": [
      "Un pomeriggio all'insegna del divertimento e del buonumore! Venite a tentare la fortuna e a divertirvi con la famiglia e gli amici, sostenendo la scuola pubblica.  Ci sono molti premi in palio."
    ],
    "fr": [
      "Un après-midi de convivialité et de bonne humeur ! Venez tenter votre chance et passer un moment agréable en famille ou entre amis, tout en soutenant l'école privée.  De nombreux lots sont à gagner ."
    ],
    "es": [
      "¡Una tarde de diversión y buen humor! Ven a probar suerte y pásalo en grande con la familia y los amigos, al tiempo que apoyas a la escuela pública.  Hay muchos premios para ganar."
    ],
    "nl": [
      "Een middag vol plezier en humor! Kom je geluk beproeven en heb een geweldige tijd met familie en vrienden, terwijl je de openbare school steunt.  Er zijn veel prijzen te winnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Loto et tombola"
    ]
  },
