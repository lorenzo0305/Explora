  "rdfs:comment": {
    "de": [
      "Laurence Laporte und ihr Team empfangen Sie montags bis samstags von 10 Uhr bis 15.30 Uhr.\r\nAn den Wochenenden, auf Reservierung, für Ihre Feste, Geburtstage und Bankette."
    ],
    "en": [
      "Laurence Laporte and her team welcome you Monday to Saturday from 10am to 3.30pm.\r\nAt weekends, by reservation, for your parties, birthdays and banquets."
    ],
    "it": [
      "Laurence Laporte e il suo team vi accolgono dal lunedì al sabato dalle 10.00 alle 15.30.\r\nNei fine settimana, su prenotazione, per le vostre feste, compleanni e banchetti"
    ],
    "fr": [
      "Laurence Laporte et son équipe vous accueillent du lundi au samedi de 10h à 15h30.\r\nLe week-end, sur réservation, pour vos fêtes ,anniversaire et banquets"
    ],
    "es": [
      "Laurence Laporte y su equipo le reciben de lunes a sábado de 10.00 a 15.30 h.\r\nLos fines de semana, previa reserva, para sus fiestas, cumpleaños y banquetes"
    ],
    "nl": [
      "Laurence Laporte en haar team verwelkomen u van maandag tot zaterdag van 10 tot 15.30 uur.\r\nIn het weekend, op reservering, voor uw feesten, verjaardagen en banketten"
    ]
  },
