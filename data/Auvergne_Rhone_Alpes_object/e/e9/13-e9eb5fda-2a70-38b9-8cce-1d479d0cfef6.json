  "rdfs:comment": {
    "de": [
      "Strecke für Mountainbikes - BMX - Roller, Skates, Inlineskates... geschlossen mit einer Folge von runden Buckeln und Steilkurven! Es werden zwei Strecken angeboten - Helm und Protektoren sind Pflicht"
    ],
    "en": [
      "Closed course for mountain bikes - BMX - scooters, skates, rollerblades... with a succession of round bumps and sharp bends! Two courses are available - Helmet and protective gear compulsory"
    ],
    "it": [
      "Percorso chiuso per mountain bike - BMX - monopattini, pattini, rollerblade... con un susseguirsi di dossi e curve a gomito! Sono disponibili due percorsi - Casco e protezioni obbligatorie"
    ],
    "fr": [
      "Parcours pour VTT - BMX - trottinettes, skates, rollers... fermé avec une succession de bosses rondes et de virages relevés ! Deux parcours sont proposés - Casque et protections obligatoires"
    ],
    "es": [
      "Recorrido cerrado para bicicletas de montaña - BMX - patinetes, patines... ¡con una sucesión de baches redondos y curvas cerradas! Dos recorridos disponibles - Casco y protecciones obligatorias"
    ],
    "nl": [
      "Gesloten parcours voor mountainbikes - BMX - steps, skates, skeelers... met een opeenvolging van ronde bulten en scherpe bochten! Er zijn twee parcours beschikbaar - Helm en beschermende kleding verplicht"
    ]
  },
