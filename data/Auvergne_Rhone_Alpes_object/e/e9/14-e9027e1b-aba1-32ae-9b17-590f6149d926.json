      "dc:description": {
        "de": [
          "Ein uneheliches Paar, das in der Falle einer versehentlichen Explosion der Wohnung, in der es sich befindet, gefangen ist und auf die daraus resultierenden Kollateralschäden angewiesen ist."
        ],
        "en": [
          "An illegitimate couple trapped by an accidental explosion in their apartment? and the collateral damage that follows."
        ],
        "it": [
          "Una coppia illegittima intrappolata da un'esplosione accidentale nel proprio appartamento e i danni collaterali che ne conseguono."
        ],
        "fr": [
          "Un couple illégitime pris au piège de l’explosion accidentelle de l’appartement où il se trouve… et tributaire des dommages collatéraux qui s’en suivent."
        ],
        "es": [
          "Una pareja ilegítima atrapada por una explosión accidental en su piso... y los daños colaterales que se derivan."
        ],
        "nl": [
          "Een buitenechtelijk stel dat vast komt te zitten door een explosie in hun flat en de bijkomende schade die daarop volgt."
        ]
      },
