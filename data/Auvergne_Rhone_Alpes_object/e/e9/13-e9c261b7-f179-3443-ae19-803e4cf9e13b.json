  "rdfs:comment": {
    "de": [
      "Willkommen in meiner Welt ... Ich bin Designerin von Schmuck und energetischer Dekoration. Ich arbeite mit echten Steinperlen und alle Edelsteine, die ich anbiete, sind ebenfalls von hoher Qualität."
    ],
    "en": [
      "Welcome to my world... I'm a jewelry and energy decoration designer. I work with real pearls and stones, and all the gems I use are of the same high quality."
    ],
    "it": [
      "Benvenuti nel mio mondo... Creo gioielli e decorazioni energetiche. Lavoro con perle di pietra vera e tutte le gemme che utilizzo sono della stessa alta qualità."
    ],
    "fr": [
      "Bienvenue dans mon univers... Je suis créatrice de bijoux et de décoration énergétique. Je travaille avec de véritables perles en pierres et tous les gemmes que je propose sont également de qualités."
    ],
    "nl": [
      "Welkom in mijn wereld... Ik maak sieraden en energetische decoratie. Ik werk met echte stenen kralen en alle edelstenen die ik gebruik zijn van dezelfde hoge kwaliteit."
    ],
    "es": [
      "Bienvenido a mi mundo... Creo joyas y decoración energética. Trabajo con auténticas cuentas de piedra y todas las gemas que utilizo son de la misma alta calidad."
    ]
  },
  "rdfs:label": {
