  "rdfs:comment": {
    "de": [
      "L'écrin gourmand ist ein Ort, der Teesalon, Feinkostladen und Restaurants miteinander verbindet. Ein Ort, an dem Tradition und Gaumenfreuden aufeinandertreffen. Gericht der Woche je nach Marktlage."
    ],
    "en": [
      "L'écrin gourmand is a combination of tea room, delicatessen and restaurant. A place where tradition and gourmet delights meet."
    ],
    "it": [
      "L'écrin gourmand è un luogo che combina ristoranti e sale da tè, che produce e vende biscotti corsi. Un luogo dove tradizione e prelibatezze si incontrano."
    ],
    "fr": [
      "L'écrin gourmand est un lieu qui mêle  restauration et salon de thé, fabrication et vente de biscuits corses . Un espace où tradition et gourmandise se rencontrent."
    ],
    "nl": [
      "L'écrin gourmand is een mix van theesalon, delicatessenzaak en restaurant. Een plek waar traditie en gastronomische hoogstandjes elkaar ontmoeten. Wekelijkse marktspecialiteiten."
    ],
    "es": [
      "L'écrin gourmand es un lugar que combina restaurantes y salones de té, donde se elaboran y venden galletas corsas. Un lugar donde se dan cita la tradición y los manjares."
    ]
  },
