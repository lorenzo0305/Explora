  "rdfs:comment": {
    "de": [
      "Der Bikepark liegt am Ufer des Bonnant und richtet sich an Mountainbike-Fans, egal ob Anfänger oder Fortgeschrittene."
    ],
    "en": [
      "Located on the banks of the River Bonnant, the Bikepark is aimed at both novice and experienced mountain bikers."
    ],
    "it": [
      "Situato sulle rive del fiume Bonnant, il Bikepark si rivolge sia ai principianti che agli esperti di mountain bike."
    ],
    "fr": [
      "Situé au bord du Bonnant, le Bikepark s'adresse aux amateurs de VTT, qu'ils soient novices ou confirmés."
    ],
    "es": [
      "Situado a orillas del río Bonnant, el Bikepark está dirigido tanto a ciclistas de montaña noveles como experimentados."
    ],
    "nl": [
      "Het Bikepark ligt aan de oevers van de rivier de Bonnant en is bedoeld voor zowel beginnende als ervaren mountainbikers."
    ]
