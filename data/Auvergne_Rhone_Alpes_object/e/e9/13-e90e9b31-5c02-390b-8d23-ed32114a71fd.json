  "rdfs:comment": {
    "de": [
      "Mischtechnik, die Collage und Weben aus Leinenschnur, zerknittertem Papier und Samen vermischt. Harmonie von Linien, Volumen und Schatten, natürliche Farbtöne stehen nebeneinander und die allgegenwärtigen Kurven sorgen für eine deutliche Lebensbewegung."
    ],
    "en": [
      "Mixed media combining collage and weaving using linen twine, crumpled paper and seeds. Harmony of lines, volumes and shadows, natural hues are juxtaposed and the omnipresent curves bring an obvious vital movement."
    ],
    "it": [
      "Tecnica mista che combina collage e tessitura utilizzando spago di lino, carta accartocciata e semi. L'armonia delle linee, dei volumi e delle ombre, la giustapposizione dei colori naturali e l'onnipresenza delle curve conferiscono un evidente movimento vitale."
    ],
    "fr": [
      "Technique mixte mêlant collage et tissage à partir de ficelle de lin, papier froissé, graines. Harmonie des lignes, des volumes, des ombres, les teintes naturelles se juxtaposent et les courbes omniprésentes apportent un mouvement vital évident."
    ],
    "es": [
      "Técnica mixta que combina collage y tejido utilizando cuerda de lino, papel arrugado y semillas. Armonía de líneas, volúmenes y sombras, los colores naturales se yuxtaponen y las curvas omnipresentes aportan un evidente movimiento vital."
    ],
    "nl": [
      "Mixed media, een combinatie van collage en weven met behulp van linnen koord, verfrommeld papier en zaden. Harmonie van lijnen, volumes en schaduwen, natuurlijke kleuren contrasteren en de alomtegenwoordige rondingen brengen een duidelijke vitale beweging."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de Chantal Favier - Plasticienne"
    ]
  },
