  "rdfs:comment": {
    "de": [
      "DIE Spielpiste für die Familie und die Kinder! Himalaya-Trompeten, Gongs zum Klopfen, sprechende Tunnel: Staunen Sie in der magischen Welt unseres freundlichen Yetis Yooni!"
    ],
    "ru": [
      "Семейный парк - дети и сюрпризы. Трубы, гроты, туннели - Вы будете заворожены весь спуск!"
    ],
    "en": [
      "The fun slope for family fun! \r\nOn the slopes of Méribel-Mottaret, Yooni - our friendly blue yeti - awaits your arrival… Fun for small and big skiers alike!"
    ],
    "it": [
      "Il sentiero del divertimento per famiglie e bambini! Trombe dell'Himalaya, gong che picchiettano, tunnel parlanti: stupitevi del magico mondo del nostro simpatico Yeti, Yooni!"
    ],
    "fr": [
      "LA piste ludique pour la famille et les enfants ! Trompettes himalayennes, gongs à taper, tunnels parlants : émerveillez-vous dans le monde magique de notre gentil Yéti, Yooni !"
    ],
    "es": [
      "La ruta de la diversión para las familias y los niños Trompetas del Himalaya, gongs que golpean, túneles que hablan: ¡maravíllate con el mundo mágico de nuestro simpático Yeti, Yooni!"
    ],
    "nl": [
      "HET pretpad voor gezinnen en kinderen! Himalayatrompetten, tikkende gongs, pratende tunnels: bewonder de magische wereld van onze vriendelijke Yeti, Yooni!"
    ]
  },
  "rdfs:label": {
