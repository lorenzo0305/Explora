  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, sich von Spannungen zu befreien und Ihre Vitalität wiederzufinden?\r\nLassen Sie sich von der Energie des Magnetismus umhüllen und finden Sie ein dauerhaftes Wohlbefinden für Ihren Körper und Ihren Geist."
    ],
    "en": [
      "Want to free yourself from tension and regain your vitality?\r\nLet yourself be enveloped by the energy of magnetism and rediscover lasting well-being for your body and mind."
    ],
    "it": [
      "Volete liberarvi dalle tensioni e ritrovare la vostra vitalità?\r\nLasciatevi avvolgere dall'energia del magnetismo e ritrovate un benessere duraturo per il corpo e la mente."
    ],
    "fr": [
      "Envie de vous libérer de vos tensions et de retrouver votre vitalité ? \r\nLaissez vous envelopper par l'énergie du magnétisme et retrouvez un bien-être durable pour votre corps et votre esprit."
    ],
    "es": [
      "¿Desea liberarse de las tensiones y recuperar la vitalidad?\r\nDéjese envolver por la energía del magnetismo y redescubra un bienestar duradero para su cuerpo y su mente."
    ],
    "nl": [
      "Wil je jezelf bevrijden van spanning en weer vitaal worden?\r\nLaat je omhullen door de energie van magnetisme en herontdek blijvend welzijn voor je lichaam en geest."
    ]
  },
