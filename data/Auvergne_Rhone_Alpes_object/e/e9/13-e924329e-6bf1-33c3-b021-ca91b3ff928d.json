  "rdfs:comment": {
    "de": [
      "Betrieb, der seit 1983 biologisch bewirtschaftet wird. Wir freuen uns, unsere Gäste zu empfangen und sie an unserer Leidenschaft für die Bodenbearbeitung teilhaben zu lassen (Pflügen mit Pferd und Traktor)."
    ],
    "en": [
      "Organic exploitation since 1983. We take pleasure in welcoming our customers and sharing with them our passion for working the land (horse and tractor ploughing)."
    ],
    "it": [
      "Agricoltura biologica dal 1983. Abbiamo il piacere di accogliere i nostri clienti e di condividere con loro la nostra passione per la lavorazione della terra (aratura a cavallo e a trattore)."
    ],
    "fr": [
      "Exploitation en culture biologique depuis 1983. Nous prenons plaisir à recevoir nos clients et leur faire partager notre passion pour le travail de la terre (labour du cheval et tracteur)."
    ],
    "nl": [
      "Biologische landbouw sinds 1983. We ontvangen onze klanten graag en delen met hen onze passie voor het bewerken van het land (ploegen met paarden en tractoren)."
    ],
    "es": [
      "Agricultura ecológica desde 1983. Nos complace recibir a nuestros clientes y compartir con ellos nuestra pasión por el trabajo de la tierra (arado con caballo y tractor)."
    ]
  },
