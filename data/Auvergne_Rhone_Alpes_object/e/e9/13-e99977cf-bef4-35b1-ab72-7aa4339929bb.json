  "rdfs:comment": {
    "de": [
      "Kommen Sie und entfliehen Sie dem Alltag! Empfang und Verkauf von Straußenfleisch, Wurstwaren und Derivaten auf dem Bauernhof. Pädagogische Erklärungen. Empfang von autonomen Wohnmobilen."
    ],
    "en": [
      "Come and escape! Reception and sale of ostrich meat, cold meats and derivatives at the Farm. Educational explanations. Reception of autonomous motorhomes."
    ],
    "it": [
      "Vieni e scappa! Accoglienza e vendita di carne di struzzo, salumi e derivati presso la Fattoria. Spiegazioni didattiche. Accoglienza di camper autonomi."
    ],
    "fr": [
      "Venez vous évader ! Accueil et vente de viande d'autruche, charcuterie et dérivés à la Ferme. Explications pédagogiques. Accueil des camping-cars autonomes."
    ],
    "es": [
      "¡Ven y escápate! Recepción y venta de carne de avestruz, charcutería y derivados en la Granja. Explicaciones educativas. Recepción de autocaravanas autónomas."
    ],
    "nl": [
      "Even iets heel anders! Toegang en verkoop van struisvogelvlees, charcuterie en andere boerderijproducten. Pedagogische uitleg. Speciaal voor campers."
    ]
  },
