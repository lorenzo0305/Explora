  "rdfs:comment": {
    "de": [
      "Erkunden Sie den Espace Vignolis, der unsere regionalen Köstlichkeiten mit geschützter Ursprungsbezeichnung oder geschützter geografischer Angabe enthüllt - Weine, Olivenöle und Oliven aus Nyons. Kulinarischer Genuss begleitet von einem reichen Kulturerbe im Musée de l'Olivier. Ein unvergessliches Erlebnis erwartet Sie!"
    ],
    "en": [
      "In the Espace Vignolis you will be able to discover the tastes richness of our PDO (Protected Designation of Origin) or PGI (Protected Geographical Indication) terroir products, wines, olive oils and olives from Nyons. Within the Olive Tree Museum, you will also discover the heritage linked to it."
    ],
    "it": [
      "Esplorate l'Espace Vignolis, che presenta i nostri prodotti locali DOP e IGP - vini, oli d'oliva e olive di Nyons. Delizie culinarie accompagnate dal ricco patrimonio del Musée de l'Olivier. Un'esperienza memorabile vi aspetta!"
    ],
    "fr": [
      "Explorez l'Espace Vignolis, dévoilant nos délices du terroir en AOP ou IGP - vins, huiles d'olives, et olives de Nyons. Plaisir culinaire accompagné de la richesse patrimoniale au Musée de l'Olivier. Une expérience mémorable vous attend !"
    ],
    "nl": [
      "In Espace Vignolis kan u de rijkdom van de smaken van onze lokale producties in BOB of BGA, wijnen, olijfolie en olijven van Nyons ontdekken. U kan er het Museum van de Olijfboom bezoeken met het erfgoed omtrent de olijfcultuur."
    ],
    "es": [
      "Explore el Espace Vignolis, donde se exponen nuestros productos locales con DOP e IGP: vinos, aceites de oliva y aceitunas de Nyons. Delicias culinarias acompañadas del rico patrimonio del Musée de l'Olivier. Le espera una experiencia inolvidable"
    ]
  },
