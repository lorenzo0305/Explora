  "rdfs:comment": {
    "de": [
      "Ideal gegenüber dem Radweg gelegen, genießen Sie auf der Terrasse des Imbisses Gerichte, die mit lokalen Produkten zubereitet werden. Es erwartet Sie eine große Auswahl: Paninis, Fladenbrot, Burger, Bowl oder auch Tagesmenüs."
    ],
    "en": [
      "Ideally located in front of the bicycle path, take advantage of the snack bar's terrace to enjoy dishes made with local products. A large choice awaits you: paninis, patties, burgers, bowls, or daily menus."
    ],
    "it": [
      "Situato in posizione ideale di fronte alla pista ciclabile, approfittate della terrazza dello snack bar per gustare piatti a base di prodotti locali. Vi aspetta un'ampia scelta: panini, galette, hamburger, ciotole o menù del giorno."
    ],
    "fr": [
      "Idéalement situé en face de la piste cyclable, profitez de la terrasse du snack pour déguster des plats élaborés avec des produits locaux. Un large choix vous attend : paninis, galettes, burgers, bowl, ou encore menus du jour."
    ],
    "es": [
      "Idealmente situado frente al carril bici, disfrute de la terraza del snack bar para degustar platos elaborados con productos locales. Le espera una amplia selección: paninis, galettes, hamburguesas, bowls o menús del día."
    ],
    "nl": [
      "Ideaal gelegen tegenover het fietspad, kunt u op het terras van de snackbar genieten van gerechten op basis van lokale producten. Er staat u een ruime keuze te wachten: panini's, galetten, hamburgers, schalen of dagmenu's."
    ]
  },
