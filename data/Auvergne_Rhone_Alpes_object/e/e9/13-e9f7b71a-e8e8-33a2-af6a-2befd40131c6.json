  "rdfs:comment": {
    "de": [
      "¡Bienvenidos! Im Agave Restaurante bieten wir Ihnen eine französisch-mexikanische Fusionsküche, in der wir lokale und saisonale Produkte mit einem mexikanischen Touch vermischen."
    ],
    "en": [
      "¡Bienvenidos! At Agave Restaurante, we offer Franco-Mexican fusion cuisine, blending local and seasonal produce with a Mexican touch."
    ],
    "it": [
      "benvenuti! All'Agave Restaurante vi offriamo una cucina fusion franco-messicana, che combina prodotti locali e di stagione con un tocco messicano."
    ],
    "fr": [
      "¡Bienvenidos! Chez Agave Restaurante, nous vous proposons une cuisine fusion Franco-Mexicaine dans laquelle nous mêlons produits locaux et de saison avec une touche mexicaine."
    ],
    "nl": [
      "welkom! Bij Agave Restaurante bieden we je een Frans-Mexicaanse fusionkeuken, een combinatie van lokale en seizoensgebonden producten met een Mexicaans tintje."
    ],
    "es": [
      "¡Bienvenidos! En Agave Restaurante le ofrecemos una cocina de fusión franco-mexicana, combinando productos locales y de temporada con un toque mexicano."
    ]
