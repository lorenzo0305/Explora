  "rdfs:comment": {
    "de": [
      "Von seinem Schloss aus hat der Kriegsherr Dupuy-Montbrun eine Nachricht an seinen Schwiegersohn François des Massue im unteren Schloss überbringen lassen. Nun ist der Bote auf mysteriöse Weise verschwunden. Nur sein leerer, durchlöcherter Beutel wurde gefunden."
    ],
    "en": [
      "From his castle, warlord Dupuy-Montbrun has sent a message to his son-in-law, François des Massue, at the château below. But the messenger has mysteriously disappeared. Only his empty, pierced pouch has been found."
    ],
    "it": [
      "Dal suo castello, il signore della guerra Dupuy-Montbrun ha inviato un messaggio al genero, François des Massue, nel castello sottostante. Ma il messaggero è misteriosamente scomparso. È stata ritrovata solo la sua sacca vuota e bucata."
    ],
    "fr": [
      "Depuis son château, le chef de guerre Dupuy-Montbrun a fait porter un message à son gendre, François des Massue, au château du bas. Or le messager a mystérieusement disparu. Seule sa besace vide et percée a été retrouvée."
    ],
    "nl": [
      "Vanuit zijn kasteel heeft de krijgsheer Dupuy-Montbrun een boodschap gestuurd naar zijn schoonzoon, François des Massue, in het kasteel beneden. Maar de boodschapper is op mysterieuze wijze verdwenen. Alleen zijn lege, doorboorde buidel is gevonden."
    ],
    "es": [
      "Desde su castillo, el señor de la guerra Dupuy-Montbrun ha enviado un mensaje a su yerno, François des Massue, en el castillo de abajo. Pero el mensajero ha desaparecido misteriosamente. Sólo se ha encontrado su bolsa vacía y agujereada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite étonnante : Le messager des deux châteaux"
    ]
  },
