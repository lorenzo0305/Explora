  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle und authentische Küche in der gemütlichen Atmosphäre einer alten Brasserie. Das Bérénice ist seit 1967 geöffnet und befindet sich im Herzen von Annemasse, nur wenige Schritte von den Geschäften entfernt."
    ],
    "en": [
      "Discover traditional, authentic cuisine in the warm atmosphere of an old brasserie... Le Bérénice has been open since 1967 in the heart of Annemasse, just a stone's throw from the shops."
    ],
    "it": [
      "Scoprite la cucina tradizionale e autentica nella calda atmosfera di un'antica brasserie... Le Bérénice è aperto dal 1967 nel cuore di Annemasse, a pochi passi dai negozi."
    ],
    "fr": [
      "Le Bérénice à Annemasse propose une cuisine traditionnelle française, labellisée Maître Restaurateur. Tout est fait maison et cuisiné sur place, avec des produits locaux et de saison. Une table artisanale généreuse et savoureuse pour goût et authenticité."
    ],
    "nl": [
      "Le Bérénice in Annemasse biedt een traditionele Franse keuken met het label Maître Restaurateur. Alles is huisgemaakt en wordt ter plekke gekookt, met lokale, seizoensgebonden producten. Een royale en smakelijke huisgemaakte tafel voor smaak en authenticiteit."
    ],
    "es": [
      "Descubra la cocina tradicional y auténtica en el cálido ambiente de una antigua brasserie... Le Bérénice está abierto desde 1967 en el corazón de Annemasse, a dos pasos de las tiendas."
    ]
  },
  "rdfs:label": {
