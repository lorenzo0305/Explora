  "rdfs:comment": {
    "de": [
      "Das Atelier bietet Änderungsschneiderei, Reparatur und Restaurierung von Kleidung an. Das Nähen von Möbeln. Die Herstellung von maßgeschneiderten Kleidungsstücken für Männer und Frauen und die Wiederholung des Lieblingskleidungsstücks durch L'allure Fabule."
    ],
    "en": [
      "The workshop offers garment alteration, repair and restoration services. Upholstery sewing. L'allure Fabule creates made-to-measure men's and women's clothing and reiterates your favorite garment."
    ],
    "it": [
      "Il laboratorio offre servizi di modifica, riparazione e restauro degli indumenti. Cucitura di mobili. Creazione di abiti su misura da uomo e da donna e ripristino dei capi preferiti, a cura di L'allure Fabule."
    ],
    "fr": [
      "L'atelier propose les services de retouches, réparation, et restauration du vêtements. La couture d'ameublement. La création de vêtements homme femme sur-mesures et la réitération du vêtement favori, par L'allure Fabule."
    ],
    "es": [
      "El taller ofrece servicios de arreglo, reparación y restauración de prendas de vestir. Costura de muebles. Creación de ropa de hombre y mujer a medida y recreación de prendas favoritas, por L'allure Fabule."
    ],
    "nl": [
      "De werkplaats biedt kledingaanpassing, reparatie en restauratie. Meubelnaaien. De creatie van op maat gemaakte heren- en dameskleding en het reconditioneren van favoriete kledingstukken, door L'allure Fabule."
    ]
  },
  "rdfs:label": {
