  "rdfs:comment": {
    "de": [
      "Die heutige Kirche wurde zwischen 1866 und 18681 erbaut. Sie wurde nach den Plänen des Architekten Pompée im neugotischen Stil umgebaut."
    ],
    "en": [
      "The current church was built between 1866 and 18681. It was rebuilt in a neo-Gothic style according to the plans of the architect Pompey."
    ],
    "it": [
      "La chiesa attuale fu costruita tra il 1866 e il 18681. Fu ricostruita in stile neogotico su progetto dell'architetto Pompeo."
    ],
    "fr": [
      "L'église actuelle a été construite entre 1866 et 18681. Elle a été reconstruite dans un style néo-gothique selon les plans de l'architecte Pompée."
    ],
    "es": [
      "La iglesia actual se construyó entre 1866 y 18681. Fue reconstruida en estilo neogótico según los planos del arquitecto Pompeyo."
    ],
    "nl": [
      "De huidige kerk werd gebouwd tussen 1866 en 18681. Het werd herbouwd in neogotische stijl naar plannen van de architect Pompey."
    ]
