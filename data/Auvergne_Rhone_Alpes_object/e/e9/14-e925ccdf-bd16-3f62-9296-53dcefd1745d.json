  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ac247bc-a37c-36be-9a8a-906551ff4cea",
      "dc:description": {
        "de": [
          "Holzfeuerkamin und große grüne Terrasse an sonnigen Tagen.\nTraditionelle Küche, hausgemachte Foie gras, vom Chef geräucherter Lachs, regionale Küche. Frische und saisonale Produkte"
        ],
        "en": [
          "Wood-burning fireplace and large, leafy terrace in fine weather.\nTraditional cuisine, homemade foie gras, chef-smoked salmon, regional cuisine. Fresh seasonal produce"
        ],
        "it": [
          "Camino a legna e ampia terrazza verdeggiante nella bella stagione.\nCucina tradizionale, foie gras fatto in casa, salmone affumicato dallo chef, cucina regionale. Prodotti freschi di stagione"
        ],
        "fr": [
          "Cheminée de feu de bois et grande terrasse verdoyante aux beaux jours.\nCuisine traditionnelle, foie gras maison , saumon fumé par le chef , cuisine régionale. Produits frais et de saison"
        ],
        "nl": [
          "Houtgestookte open haard en groot lommerrijk terras bij mooi weer.\nTraditionele keuken, huisgemaakte foie gras, zalm gerookt door de chef, regionale keuken. Verse seizoensproducten"
        ],
        "es": [
          "Chimenea de leña y gran terraza frondosa cuando hace buen tiempo.\nCocina tradicional, foie gras casero, salmón ahumado por el chef, cocina regional. Productos frescos de temporada"
        ]
      },
      "@type": [
        "Description"
      ],
