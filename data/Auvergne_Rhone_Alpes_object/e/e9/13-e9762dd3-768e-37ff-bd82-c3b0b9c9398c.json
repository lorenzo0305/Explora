  "rdfs:comment": {
    "de": [
      "Die Brasserie Centrale empfängt Sie zu jeder Tageszeit: Frühstück, Brasseriekarte und Bergspezialitäten, Crêpes & Eis, Aperitife in der Sonne mit Blick auf die Aravis. Großes Bistro-Ambiente & Terrasse im Stadtzentrum."
    ],
    "en": [
      "Located in the heart of Saint-Gervais, opposite the free car park, La Brasserie Centrale proposes a brasserie-style menu and a selection of Savoyard specialities."
    ],
    "it": [
      "La Brasserie Centrale vi accoglie in ogni momento della giornata: colazioni, menù da brasserie e specialità di montagna, crêpes e gelati, aperitivi al sole di fronte ai monti Aravis. Grande atmosfera da bistrot e terrazza nel centro del paese."
    ],
    "fr": [
      "La brasserie Centrale vous accueille à tous les moments de la journée, petits-déjeuners, carte brasserie et spécialités de montagne, crêpes & glaces, apéritifs au soleil face aux Aravis. Ambiance grand bistrot & terrasse en centre ville."
    ],
    "es": [
      "La Brasserie Centrale le da la bienvenida a cualquier hora del día: desayunos, menú de brasserie y especialidades de montaña, crepes y helados, aperitivos al sol frente a los montes Aravis. Gran ambiente de bistró y terraza en el centro de la ciudad."
    ],
    "nl": [
      "De Brasserie Centrale verwelkomt je op elk moment van de dag: ontbijt, brasseriemenu en bergspecialiteiten, crêpes & ijsjes, aperitief in de zon met uitzicht op het Aravisgebergte. Grote bistrosfeer en terras in het stadscentrum."
    ]
  },
