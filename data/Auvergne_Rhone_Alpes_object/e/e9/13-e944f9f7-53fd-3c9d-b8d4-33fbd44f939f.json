  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich diesen Winter eine wohlverdiente Schönheitspause!\r\n- Nagelpflege (vsp, Gel, Nailart)\r\n- Gesichtspflege\r\n- Haarentfernung\r\n- Pflege der Augen\r\nHerzlicher Empfang, hochwertige Leistungen, französische & biologische Produkte, persönliche Beratung\r\nVereinbaren Sie einen Termin!"
    ],
    "en": [
      "This winter, treat yourself to a well-deserved beauty break!\r\n- Nail care (vsp, gel, nail art)\r\n- Facial care\r\n- Waxing\r\n- Eye care\r\nWarm welcome, quality services, French & organic products, personalized advice\r\nBook an appointment now!"
    ],
    "it": [
      "Quest'inverno concedetevi una meritata pausa di bellezza!\r\n- Cura delle unghie (vsp, gel, nail art)\r\n- Cura del viso\r\n- Depilazione\r\n- Cura degli occhi\r\nAccoglienza calorosa, servizi di qualità, prodotti francesi e biologici, consigli personalizzati\r\nFissate subito un appuntamento!"
    ],
    "fr": [
      "Cet hiver, offrez-vous une pause beauté bien méritée !\r\n- Onglerie (vsp, gel, nail art)\r\n- Soin visage\r\n- Epilations\r\n- Soin du regard\r\nAccueil chaleureux, prestations de qualité, produits français & bio, conseils personnalisés\r\nPrenez rendez-vous !"
    ],
    "nl": [
      "Gun jezelf deze winter een welverdiende schoonheidsvakantie!\r\n- Nagelverzorging (vsp, gel, nailart)\r\n- Gezichtsverzorging\r\n- Waxen\r\n- Oogverzorging\r\nWarm onthaal, kwaliteitsvolle diensten, Franse & biologische producten, persoonlijk advies\r\nMaak nu een afspraak!"
    ],
    "es": [
      "Este invierno, regálate una merecida pausa de belleza\r\n- Cuidado de las uñas (vsp, gel, nail art)\r\n- Cuidados faciales\r\n- Depilación\r\n- Cuidado de los ojos\r\nAcogida calurosa, servicios de calidad, productos franceses y biológicos, consejos personalizados\r\nPedir cita"
    ]
  },
