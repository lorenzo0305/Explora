  "rdfs:comment": {
    "de": [
      "Profitieren Sie von einer idealen Umgebung zum Angeln innerhalb des Naturparks Chambaran. 4 Teiche sind für Angler zugänglich. Die vorhandenen Fische sind Karpfen, Hechte, Plötzen, Barsche, Schleien..."
    ],
    "en": [
      "Make the most of this ideal fishing environment within the Chambaran Natural Park. Fishing enthusiasts will enjoy carp, pike, perch and whitebait fishing. 3 lakes available : Fond Coully, Fontrouge and Etang Neuf."
    ],
    "it": [
      "Approfittate di un ambiente di pesca ideale all'interno del Parco Naturale di Chambaran. 4 stagni sono accessibili ai pescatori. I pesci presenti sono carpe, lucci, lasche, persici e tinche."
    ],
    "fr": [
      "Bénéficiez d'un cadre de pêche idéal à l'intérieur du Parc Naturel de Chambaran. 4 étangs sont accessibles aux pêcheurs. Les poissons présents sont les carpes, les brochets, les gardons, les perches, les tanches.."
    ],
    "nl": [
      "Profiteer van een ideale visomgeving in het natuurpark Chambaran. 4 vijvers zijn toegankelijk voor vissers. De aanwezige vissen zijn karper, snoek, voorn, baars en zeelt."
    ],
    "es": [
      "Benefíciese de un entorno de pesca ideal dentro del Parque Natural de Chambarán. Los pescadores pueden acceder a 4 estanques. Los peces presentes son la carpa, el lucio, la cucaracha, la perca y la tenca."
    ]
  },
