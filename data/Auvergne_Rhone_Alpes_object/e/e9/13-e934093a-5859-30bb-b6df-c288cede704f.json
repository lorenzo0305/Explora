  "rdfs:comment": {
    "de": [
      "36. nationale Rallye und 5. VHC-Rallye Haut-Lignon. Freitag, 18. September: Technische und administrative Abnahme in Le Chambon/Lignon am Abend.\r\nSamstag, 19. September 10:30 Uhr: Wertungsprüfungen mit Zeitmessung in den Dörfern."
    ],
    "en": [
      "36th national rally and 5th Haut-Lignon VHC rally. Friday September 18: technical and administrative scrutineering at Le Chambon/Lignon in the evening.\r\nSaturday September 19 10:30 am: timed special stages in the villages."
    ],
    "it": [
      "36° rally nazionale e 5° rally VHC di Haut-Lignon. Venerdì 18 settembre: verifiche tecniche e amministrative a Le Chambon/Lignon in serata.\r\nSabato 19 settembre, ore 10.30: prove speciali cronometrate nei villaggi."
    ],
    "fr": [
      "36ème rallye national et 5ème rallye VHC du Haut-Lignon. Vendredi 18 septembre : vérifications techniques et administratives au Chambon/Lignon en soirée.\r\nSamedi 19 septembre 10h30 : spéciales chronométrées dans les villages."
    ],
    "nl": [
      "36e nationale rally en 5e VHC rally van Haut-Lignon. Vrijdag 18 september: 's avonds technische en administratieve controle in Le Chambon/Lignon.\r\nZaterdag 19 september 10.30 uur: getimede klassementsproeven in de dorpen."
    ],
    "es": [
      "36º rally nacional y 5º rally VHC de Haut-Lignon. Viernes 18 de septiembre: verificaciones técnicas y administrativas en Le Chambon/Lignon por la tarde.\r\nSábado 19 de septiembre 10.30 h: especiales cronometradas en los pueblos."
    ]
