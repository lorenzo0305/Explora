  "rdfs:comment": {
    "de": [
      "Im Bahnhof Landry befindet sich ein Café mit Imbiss, in dem Sie Speisen und Getränke zum Mitnehmen oder vor Ort genießen können. \r\nFreuen Sie sich auf einen herzlichen Empfang in Räumlichkeiten, die sich das Café mit einer Lederwerkstatt teilt."
    ],
    "en": [
      "A café-snack bar located at Landry train station offers dine-in or takeaway service for your journey. \r\nEnjoy a warm welcome in a space shared with a leather workshop."
    ],
    "it": [
      "Café-Snack situato alla stazione ferroviaria di Landry, offre un servizio da asporto o sul posto per il vostro viaggio.\r\nUn'accoglienza calorosa in uno spazio condiviso con un laboratorio di lavorazione del cuoio."
    ],
    "fr": [
      "Café-Snack situé à la gare ferroviaire de Landry vous proposant un service sur place ou à emporter pour votre trajet. \r\nAccueil chaleureux dans un espace partagé avec un atelier de travail du cuir."
    ],
    "es": [
      "Café-Snack situado en la estación de tren de Landry, que ofrece servicio de comida para llevar o in situ para su viaje.\r\nUna cálida acogida en un espacio compartido con un taller de marroquinería."
    ],
    "nl": [
      "Café-Snack in het station van Landry, met afhaalservice of service ter plaatse voor onderweg.\r\nEen warm welkom in een gedeelde ruimte met een leerwerkplaats."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kaffee-Snacks bei PO's"
    ],
    "en": [
      "Coffee-snacks at PO's"
    ],
    "fr": [
      "Café-snack chez PO"
    ]
  },
