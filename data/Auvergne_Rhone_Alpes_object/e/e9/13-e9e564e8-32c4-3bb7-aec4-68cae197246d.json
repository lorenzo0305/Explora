  "rdfs:comment": {
    "de": [
      "Entdecken Sie 100 Exemplare der schönsten Kristalle, die Raymond Thibault, ein leidenschaftlicher Mineraloge und Gemmologe, 50 Jahre lang gesammelt hat. Rhodochrosit, Wulfenit, Azurit ... Da ist für jeden Geschmack und jede Farbe etwas dabei!"
    ],
    "en": [
      "Discover a hundred of the finest crystals collected by Raymond Thibault, a passionate mineralogist and gemmologist, over 50 years. Rhodochrosite, Wulfenite, Azurite... There's something for every taste and color!"
    ],
    "it": [
      "Scoprite un centinaio dei più bei cristalli raccolti da Raymond Thibault, appassionato mineralogista e gemmologo, nell'arco di 50 anni. Rodocrosite, wulfenite, azzurrite... Ce n'è per tutti i gusti e per tutti i colori!"
    ],
    "fr": [
      "Découvrez une centaine de spécimens parmi les plus beaux cristaux collectés par Raymond Thibault, passionné de minéralogie et de gemmologie, pendant 50 ans. Rhodochrosite, Wulfénite, Azurite... Il y en a pour tous les goûts et toutes les couleurs !"
    ],
    "nl": [
      "Ontdek honderd van de mooiste kristallen die Raymond Thibault, een gepassioneerd mineraloog en gemmoloog, in 50 jaar heeft verzameld. Rhodochrosiet, Wulfeniet, Azuriet... Er is iets voor elke smaak en elke kleur!"
    ],
    "es": [
      "Descubra un centenar de los más bellos cristales recogidos por Raymond Thibault, mineralogista y gemólogo apasionado, a lo largo de 50 años. Rodocrosita, Wulfenita, Azurita... Para todos los gustos y todos los colores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Trésor minéral : la collection Raymond Thibault"
    ]
  },
