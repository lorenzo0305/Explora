  "rdfs:comment": {
    "de": [
      "Besuchen Sie uns zum Mittag- oder Abendessen im Zentrum von Annemasse, an der Grenze zwischen Frankreich und der Schweiz! In einem Raum mit zeitgenössischem Wohlfühl-Ambiente können Sie eine gesunde Küche genießen, die auf kurze Transportwege setzt."
    ],
    "en": [
      "Enjoy lunches and dinners in the centre of Annemasse, close to the border between France and Switzerland! In the soothing surroundings of the contemporary style eating area, enjoy a cuisine which favours local produce."
    ],
    "it": [
      "Per un pranzo o una cena, recatevi nel centro di Annemasse, al confine tra Francia e Svizzera! In un ambiente contemporaneo e rilassante, concedetevi una cucina sana con un'attenzione particolare ai prodotti locali."
    ],
    "fr": [
      "Pour le déjeuner comme pour le diner, rendez-vous en plein centre d’Annemasse, à la frontière de la France et de la Suisse ! Dans une salle au décor contemporain et apaisant, régalez-vous d’une cuisine saine mettant l’accent sur les circuits courts."
    ],
    "es": [
      "Para comer o cenar, diríjase al centro de Annemasse, en la frontera entre Francia y Suiza. En un ambiente contemporáneo y relajante, deléitese con una cocina sana que hace hincapié en los productos locales."
    ],
    "nl": [
      "Ga voor een lunch of diner naar het centrum van Annemasse, op de grens tussen Frankrijk en Zwitserland! In een modern en rustgevend kader trakteert u zichzelf op een gezonde keuken met de nadruk op lokale producten."
    ]
  },
