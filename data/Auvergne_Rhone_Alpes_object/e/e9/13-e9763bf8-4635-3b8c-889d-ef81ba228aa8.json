  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Bourg-Argental liegt die Pépinière PAUL CROIX, eine der ältesten Baumschulen Frankreichs. Sie wurde 1819 auf königliche Anordnung von Adrien Sénéclauze gegründet."
    ],
    "en": [
      "In the heart of the village of Bourg-Argental, the PAUL CROIX Nursery, one of the oldest in France, was created in 1819 by Adrien Sénéclauze under royal decree."
    ],
    "it": [
      "Nel cuore del villaggio di Bourg-Argental, il Vivaio PAUL CROIX, uno dei più antichi di Francia, fu creato nel 1819 su ordine reale di Adrien Sénéclauze."
    ],
    "fr": [
      "Au cœur  du village de Bourg-Argental, la Pépinière PAUL CROIX, une des plus anciennes de France, a été créée en 1819 sous ordonnance royale, par Adrien Sénéclauze."
    ],
    "nl": [
      "In het hart van het dorp Bourg-Argental is de kwekerij PAUL CROIX, een van de oudste van Frankrijk, in 1819 op koninklijk bevel opgericht door Adrien Sénéclauze."
    ],
    "es": [
      "En el corazón del pueblo de Bourg-Argental, el vivero PAUL CROIX, uno de los más antiguos de Francia, fue creado en 1819 por orden real de Adrien Sénéclauze."
    ]
  },
