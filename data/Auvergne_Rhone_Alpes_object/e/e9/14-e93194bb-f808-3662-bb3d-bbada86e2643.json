  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6a1da09-d6a3-3dd2-870d-ba6e402ce9c2",
      "dc:description": {
        "de": [
          "Handwerklicher Bäcker aus der Region Nord Pas de Calais. Handwerkliche Herstellung von Keksen und süßen oder salzigen Keksen, Croutons und Toast. OHNE KONSERVIERUNGSSTOFFE\nNur natürliche Zutaten.\n\nDer Laden ist montags bis freitags von 9:30 bis 18:30 Uhr nonstop geöffnet\nsamstags von 9:00 bis 12:30 Uhr und von 14:00 bis 18:30 Uhr"
        ],
        "en": [
          "Artisan Biscuit maker from Nord Pas de Calais. Artisanal production of sweet and savoury cookies and cakes, croutons and toast. PRESERVATIVE-FREE\nAll natural.\n\nThe store is open Monday to Friday, 9.30am to 6.30pm non-stop\nsaturday 9am to 12:30pm and 2pm to 6:30pm"
        ],
        "it": [
          "Produttore di biscotti artigianali del Nord Pas de Calais. Produzione artigianale di biscotti e torte dolci e salate, crostini e toast. SENZA CONSERVANTI\nTutto naturale.\n\nIl negozio è aperto dal lunedì al venerdì dalle 9.30 alle 18.30 ininterrottamente\nsabato dalle 9.00 alle 12.30 e dalle 14.00 alle 18.30"
        ],
        "fr": [
          "Artisan Biscuitier du Nord Pas de Calais. Fabrication artisanale de biscuits et gâteaux secs sucrés ou salés, de croûtons et toasts. SANS CONSERVATEUR\nQue du naturel. \n\nLa boutique est ouverte du lundi au vendredi de 9 h 30 à 18 h 30 non-stop\nle samedi de 9h à 12h30 et de 14h à 18h30"
        ],
        "es": [
          "Galletero artesano de Nord Pas de Calais. Producción artesanal de galletas y pasteles dulces y salados, picatostes y tostadas. SIN CONSERVANTES\nTodo natural.\n\nLa tienda está abierta de lunes a viernes de 9h30 a 18h30 sin interrupción\nsábado de 9h a 12h30 y de 14h a 18h30"
        ],
        "nl": [
          "Ambachtelijke koekjesfabrikant uit Nord Pas de Calais. Ambachtelijke productie van zoete en hartige koekjes en taarten, croutons en toast. GEEN BEWAARMIDDELEN\nHelemaal natuurlijk.\n\nDe winkel is open van maandag tot vrijdag van 9u30 tot 18u30 non-stop\nzaterdag van 9.00 tot 12.30 uur en van 14.00 tot 18.30 uur"
        ]
      },
      "@type": [
        "Description"
      ],
