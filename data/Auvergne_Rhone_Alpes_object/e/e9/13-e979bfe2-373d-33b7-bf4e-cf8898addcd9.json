  "rdfs:comment": {
    "de": [
      "La Trièvoise - Maison de Pays du Trièves: der Ort, um die Geschmäcker und das Know-how der Region zu entdecken!\r\nHier tauscht man sich mit denjenigen aus, die die Produkte herstellen. Mehr als ein Laden: eine Auszeit, in der man sich Zeit nimmt, um zu entdecken und zu teilen."
    ],
    "en": [
      "La Trièvoise - Maison de Pays du Trièves: the place to discover the region's flavours and know-how!\r\nHere, you can talk to the people who make the products. More than a store: a place where you can take the time to discover and share."
    ],
    "it": [
      "La Trièvoise - Maison de Pays du Trièves: il luogo dove scoprire i sapori e il know-how della regione!\r\nQui potrete parlare con le persone che producono i prodotti. Più di un negozio: un luogo in cui prendersi il tempo per scoprire e condividere."
    ],
    "fr": [
      "La Trièvoise  - Maison de Pays du Trièves : le lieu pour découvrir les saveurs et savoir-faire du territoire ! \r\nIci, on échange avec celles et ceux qui fabriquent. Plus qu’une boutique : une parenthèse où l’on prend le temps de découvrir et de partager."
    ],
    "nl": [
      "La Trièvoise - Maison de Pays du Trièves: de plek om de smaken en de knowhow van de streek te ontdekken!\r\nHier kun je praten met de mensen die de producten maken. Meer dan een winkel: een plek waar je de tijd kunt nemen om te ontdekken en te delen."
    ],
    "es": [
      "La Trièvoise - Maison de Pays du Trièves: ¡el lugar para descubrir los sabores y el saber hacer de la región!\r\nAquí podrá hablar con las personas que elaboran los productos. Más que una tienda: un lugar donde tomarse el tiempo de descubrir y compartir."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LA TRIÈVOISE - Maison de Pays du Trièves"
    ]
  },
