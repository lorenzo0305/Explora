  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen regelmäßige Kurse an, die gemischtgeschlechtlich und altersunabhängig sind.\r\nSitzungen für Senioren: Dienstag von 10:30 bis 11:30 Uhr.\r\nSitzungen für Erwachsene: Mittwoch von 20:30 bis 21:30 Uhr."
    ],
    "en": [
      "We offer regular classes for all ages.\r\nSenior sessions: Tuesdays, 10.30am to 11.30am.\r\nAdult classes: Wednesdays from 8:30 to 9:30 pm."
    ],
    "it": [
      "Offriamo regolarmente corsi misti senza limitazioni di età.\r\nSessioni per anziani: martedì dalle 10.30 alle 11.30.\r\nCorsi per adulti: mercoledì dalle 20.30 alle 21.30."
    ],
    "fr": [
      "Nous vous proposons des cours réguliers mixtes et sans conditions d'âge.\r\nSéances pour les séniors : mardi de 10h30 à 11h30.\r\nSéances adultes : mercredi de 20h30 à 21h30."
    ],
    "nl": [
      "We bieden regelmatig gemengde lessen zonder leeftijdsbeperkingen.\r\nSessies voor senioren: dinsdag van 10.30 tot 11.30 uur.\r\nLes voor volwassenen: woensdag van 20.30 tot 21.30 uur."
    ],
    "es": [
      "Ofrecemos clases regulares mixtas sin restricciones de edad.\r\nSesiones para mayores: martes de 10.30 a 11.30 h.\r\nClases para adultos: miércoles de 20.30 a 21.30 h."
    ]
  },
