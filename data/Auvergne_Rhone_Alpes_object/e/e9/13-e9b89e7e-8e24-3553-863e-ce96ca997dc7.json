  "rdfs:comment": {
    "de": [
      "ViaRhôna, von Jons nach Lyon.\r\nDiese Etappe der ViaRhôna spielt geschickt mit der urbanisierten Umgebung des Großraums Lyon, um die Parks und Wasserflächen des Ballungsraums, Le Grand Large und Miribel-Jonage, miteinander zu verbinden."
    ],
    "en": [
      "ViaRhôna, from Jons to Lyon.\r\nThis stage of ViaRhôna cleverly plays on the urban environment of Greater Lyon to link the city?s parks and lakes, Le Grand Large and Miribel-Jonage."
    ],
    "it": [
      "ViaRhôna, da Jons a Lione.\r\nQuesta tappa della ViaRhôna sfrutta sapientemente l'ambiente urbano della Grande Lione per collegare i parchi e i laghi della città, Le Grand Large e Miribel-Jonage."
    ],
    "fr": [
      "ViaRhôna, de Jons à Lyon.\r\nCette étape de ViaRhôna se joue astucieusement de l’environnement urbanisé du Grand Lyon pour relier les parcs et plans d’eaux de l’agglomération, Le Grand Large et Miribel-Jonage."
    ],
    "nl": [
      "ViaRhôna, van Jons naar Lyon.\r\nDit deel van de ViaRhôna maakt slim gebruik van de stedelijke omgeving van Groot-Lyon en verbindt de parken en meren van de stad, Le Grand Large en Miribel-Jonage."
    ],
    "es": [
      "ViaRhôna, de Jons a Lyon.\r\nEste tramo de la ViaRhôna aprovecha hábilmente el entorno urbano del Gran Lyon para unir los parques y lagos de la ciudad, Le Grand Large y Miribel-Jonage."
    ]
  },
  "rdfs:label": {
    "fr": [
      "ViaRhôna à vélo - Étape 09 - Jons > Lyon"
    ]
  },
