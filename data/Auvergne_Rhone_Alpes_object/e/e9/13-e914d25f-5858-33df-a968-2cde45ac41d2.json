  "rdfs:comment": {
    "de": [
      "Mille Feuilles ist ein Gemüsegarten, der biologisch und ohne Bodenbearbeitung bewirtschaftet wird.\r\nSie finden hier also Biogemüse der Saison, das mit Respekt vor dem Boden und der Biodiversität angebaut wird."
    ],
    "en": [
      "Mille Feuilles is a market garden, run organically and without tillage.\r\nYou will find there organic vegetables, in season, cultivated in the respect of the grounds and the biodiversity."
    ],
    "it": [
      "Mille Feuilles è un orto, gestito in modo biologico e senza lavorazione del terreno.\r\nTroverete verdure biologiche e di stagione, coltivate nel rispetto della terra e della biodiversità."
    ],
    "fr": [
      "Mille Feuilles est un jardin maraîcher, mené en agriculture biologique et sans travail du sol.\r\nVous y retrouverez donc des légumes bio, de saison, cultivés dans le respect des sols et de la biodiversité."
    ],
    "nl": [
      "Mille Feuilles is een tuinderij die biologisch en zonder grondbewerking wordt beheerd.\r\nU vindt er biologische, seizoensgebonden groenten, geteeld met respect voor de bodem en de biodiversiteit."
    ],
    "es": [
      "Mille Feuilles es una huerta, gestionada de forma ecológica y sin laboreo.\r\nEncontrará verduras ecológicas de temporada, cultivadas con respeto a la tierra y a la biodiversidad."
    ]
  },
