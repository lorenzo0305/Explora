  "rdfs:comment": {
    "de": [
      "Je nach ihren Inspirationen schafft Mechtild Skulpturen aus verschiedenen Arten von Sandstein, lässt die Erden roh oder spielt mit Mischungen und Überlagerungen von farbigen Wachsen."
    ],
    "en": [
      "Using different stonewares, Mechtild follows her inspiration to create sculptures, faces, characters and thoughts engraved in the clay."
    ],
    "it": [
      "A seconda delle sue ispirazioni, Mechtild crea sculture in diversi tipi di arenaria, lasciando l'argilla grezza o giocando con miscele e sovrapposizioni di cere colorate."
    ],
    "fr": [
      "Au gré de ses inspirations, Mechtild crée des sculptures dans différentes sortes de grés, laissant les terres brutes ou jouant avec des mélanges et superposition de cires de couleurs."
    ],
    "es": [
      "Según sus inspiraciones, Mechtild crea esculturas en diferentes tipos de arenisca, dejando la arcilla en bruto o jugando con mezclas y superposiciones de ceras de colores."
    ],
    "nl": [
      "Naargelang haar inspiratie creëert Mechtild beelden in verschillende soorten zandsteen, waarbij ze de klei onbewerkt laat of speelt met mengsels en superposities van gekleurde was."
    ]
  },
  "rdfs:label": {
