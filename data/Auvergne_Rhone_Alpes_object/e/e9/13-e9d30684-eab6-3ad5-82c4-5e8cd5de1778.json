  "rdfs:comment": {
    "de": [
      "Skifahren, Wandern und Mountainbiken zwischen Frankreich und der Schweiz. Von der Seilbahn in Charamillon aus geht es im Winter auf sonnige Pisten oder im Sommer auf Almwege. Fabelhafte Aussichtspunkte zu jeder Jahreszeit"
    ],
    "en": [
      "Skiing, hiking and mountain biking between France and Switzerland. From the Charamillon cable car, sunny slopes in winter or mountain pasture paths in summer. Fabulous views all year round"
    ],
    "it": [
      "Sci, escursioni e mountain bike tra Francia e Svizzera. Dalla gondola di Charamillon, piste soleggiate in inverno o sentieri d'alpeggio in estate. Panorami favolosi tutto l'anno"
    ],
    "fr": [
      "Ski, rando et vtt entre France et Suisse. Depuis la télécabine de Charamillon, des pistes ensoleillées en hiver ou des sentiers en alpage avec des points de vue fabuleux en toute saison."
    ],
    "nl": [
      "Skiën, wandelen en mountainbiken tussen Frankrijk en Zwitserland. Vanaf de kabelbaan van Charamillon, zonnige pistes in de winter of alpenweidenpaden met het hele jaar door fantastische uitzichten."
    ],
    "es": [
      "Esquí, senderismo y bicicleta de montaña entre Francia y Suiza. Desde el teleférico de Charamillon, pistas soleadas en invierno o senderos de pastos de montaña en verano. Fabulosas vistas todo el año"
    ]
  },
