  "rdfs:comment": {
    "de": [
      "Imker und Erntehelfer in Die.\r\n Verkauf von Honig und Honigspezialitäten.\r\nBesichtigung des Honigraums, Präsentation des Lebens in einem Bienenstock und der Honigernte auf Anfrage."
    ],
    "en": [
      "Beekeeper and picker in Die. Selling of honey and specialities with honey (gingerbread, nougat, candy…) make with our spring honey. Presentation of one hive's life and collect on demand."
    ],
    "it": [
      "Apicoltore-raccolta in Die.\r\n Vendita di miele e specialità a base di miele.\r\nVisite alla casa del miele, presentazione della vita di un alveare e della raccolta del miele su richiesta."
    ],
    "fr": [
      "Apiculteur-Récoltant à Die.\r\n Vente de miel et spécialités au miel.\r\nVisite de la miellerie, présentation de la vie d'une ruche et de la récolte du miel sur demande."
    ],
    "nl": [
      "Imker-oogst in Die.\r\n Verkoop van honing en honingspecialiteiten.\r\nBezoek aan het honinghuis, presentatie van het leven in een bijenkorf en het oogsten van honing op aanvraag."
    ],
    "es": [
      "Apicultor-Colección en Die.\r\n Venta de miel y especialidades de miel.\r\nVisitas a la mielera, presentación de la vida de una colmena y de la recolección de la miel previa petición."
    ]
  },
