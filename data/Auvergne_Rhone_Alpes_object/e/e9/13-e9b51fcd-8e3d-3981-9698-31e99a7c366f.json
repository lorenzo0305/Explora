  "rdfs:comment": {
    "de": [
      "Zehn Bahnen, um sich herauszufordern oder sich mit Freunden oder der Familie zu amüsieren. Auf Vorbestellung organisieren wir auch Ihre besonderen Veranstaltungen (Familien- oder Arbeitstreffen, Geburtstage...)."
    ],
    "en": [
      "Ten tracks to challenge yourself or have fun with friends and family. We can also organize special events (family reunions, work meetings, birthdays...)."
    ],
    "it": [
      "Dieci piste per sfidare se stessi o per divertirsi con amici e familiari. Possiamo anche organizzare i vostri eventi speciali (riunioni di famiglia o di lavoro, compleanni, ecc.) su prenotazione."
    ],
    "fr": [
      "Dix pistes pour vous challenger ou vous amuser entre amis ou en famille. Nous organisons aussi sur réservation vos événements spéciaux (réunions familiales ou de travail, anniversaires...)."
    ],
    "nl": [
      "Tien banen om jezelf uit te dagen of plezier te maken met vrienden en familie. Op afspraak kunnen we ook je speciale evenementen organiseren (familie- of bedrijfsbijeenkomsten, verjaardagen, enz.)."
    ],
    "es": [
      "Diez pistas para desafiarse a uno mismo o divertirse con los amigos y la familia. También podemos organizar sus eventos especiales (reuniones familiares o de negocios, cumpleaños, etc.) previo acuerdo."
    ]
  },
