  "rdfs:comment": {
    "de": [
      "Fabioli ist ein italienisches Restaurant, das traditionelle Gerichte aus frischen Zutaten anbietet. Sie können unsere Gerichte vor Ort in einer familiären und herzlichen Atmosphäre genießen oder zum Mitnehmen bestellen. Privatisierungen sind möglich."
    ],
    "en": [
      "The Italian restaurant Fabioli serves up traditional cuisine made using fresh ingredients. Our dishes are available to eat in, in a warm, family atmosphere, or to take away. The restaurant can be hired for private events."
    ],
    "it": [
      "Fabioli è un ristorante italiano che offre una cucina tradizionale a base di prodotti freschi. Potete gustare i nostri piatti sul posto, in una calda atmosfera familiare, o portarli via. La privatizzazione è possibile."
    ],
    "fr": [
      "Fabioli est un restaurant italien qui propose une cuisine traditionnelle réalisée à partir de produits frais. Vous pouvez déguster nos plats sur place dans une ambiance familiale et chaleureuse, ou à emporter. Privatisation possible."
    ],
    "nl": [
      "Fabioli is een Italiaans restaurant met een traditionele keuken op basis van verse producten. U kunt ter plaatse in een warme familiesfeer van onze gerechten genieten of ze meenemen. Privatisering mogelijk."
    ],
    "es": [
      "Fabioli es un restaurante italiano que ofrece cocina tradicional elaborada con productos frescos. Puede disfrutar de nuestros platos en el momento en un cálido ambiente familiar, o llevárselos. La privatización es posible."
    ]
  },
