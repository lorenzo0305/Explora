  "rdfs:comment": {
    "de": [
      "Marion Remy, Sophrologin und passionierte Massagepraktikerin,\r\nIntuitive Massage: eine Behandlung, unendlich viele Möglichkeiten.\r\nSophro-Massage, Schwangerschaftsmassage, Sophrologie-Sitzungen und Gruppen-Workshops, in der Praxis in Mens oder an Ihrem Urlaubsort."
    ],
    "en": [
      "Marion Remy, Sophrologist and passionate massage practitioner,\r\nIntuitive massage: one treatment, infinite possibilities.\r\nSophro -massage, prenatal massage, sophrology sessions and group workshops, at the practice in Mens or at your vacation destination."
    ],
    "it": [
      "Marion Remy, sofrologa e appassionata di massaggi,\r\nMassaggio intuitivo: un solo trattamento, infinite possibilità.\r\nSophro-massage, massaggio prenatale, sessioni di sofrologia e workshop di gruppo, presso lo studio di Mens o nella vostra destinazione di vacanza."
    ],
    "fr": [
      "Marion Remy, Sophrologue et praticienne en massage passionnée,\r\nMassage intuitif : un soin, une infinité de possibilités.\r\nSophro -massage, massage prénatal, séances de sophrologie et ateliers de groupe, au cabinet à Mens ou sur votre lieu de vacances."
    ],
    "nl": [
      "Marion Remy, sofrologist en gepassioneerd massagebeoefenaar,\r\nIntuïtieve massage: één behandeling, oneindig veel mogelijkheden.\r\nSophro-massage, prenatale massage, sophrologiesessies en groepsworkshops, in de praktijk in Mens of op je vakantiebestemming."
    ],
    "es": [
      "Marion Remy, sofróloga y masajista apasionada,\r\nMasaje intuitivo: un tratamiento, infinitas posibilidades.\r\nSofromasaje, masaje prenatal, sesiones de sofrología y talleres en grupo, en la consulta de Mens o en su destino de vacaciones."
    ]
  },
