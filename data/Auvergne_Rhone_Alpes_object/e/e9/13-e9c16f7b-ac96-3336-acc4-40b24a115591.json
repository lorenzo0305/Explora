  "rdfs:comment": {
    "de": [
      "Fahrradverleih: traditionelle Fahrräder (Erwachsene und Kinder) oder Fahrräder mit elektrischer Unterstützung (ab 12 Jahren). Geführte Ausflüge mit dem Elektrofahrrad ab Vals-les-Bains oder Vogüé."
    ],
    "en": [
      "Bike hire: traditional bikes (adults and children) or electric bikes (over 12s). Guided electric bike rides from Vals-les-Bains or Vogüé."
    ],
    "it": [
      "Noleggio biciclette: tradizionali (adulti e bambini) o elettriche (+12 anni). Gite guidate in bicicletta elettrica da Vals-les-Bains o Vogüé."
    ],
    "fr": [
      "Location de vélos: vélos traditionnels (adultes et enfants) ou à assistance électrique (+12 ans). Balades guidées en vélo électrique au départ de Vals-les-Bains ou Vogüé."
    ],
    "nl": [
      "Fietsverhuur: traditionele fietsen (volwassenen en kinderen) of elektrische fietsen (vanaf 12 jaar). Begeleide elektrische fietstochten vanuit Vals-les-Bains of Vogüé."
    ],
    "es": [
      "Alquiler de bicicletas: bicicletas tradicionales (adultos y niños) o eléctricas (+12 años). Paseos guiados en bicicleta eléctrica desde Vals-les-Bains o Vogüé."
    ]
