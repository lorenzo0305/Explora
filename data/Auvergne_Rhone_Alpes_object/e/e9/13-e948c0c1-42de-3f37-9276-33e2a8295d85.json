  "rdfs:comment": {
    "de": [
      "Überqueren Sie den 110 m langen, himalaya-ähnlichen Steg über die Loire, der das linke mit dem rechten Ufer verbindet, und genießen Sie einen sympathischen Ausblick auf die Stadt."
    ],
    "en": [
      "Cross the 110 m Himalayan-style footbridge over the Loire, linking the left bank to the right bank, and enjoy a delightful view of the city."
    ],
    "it": [
      "Attraversate la passerella di 110 metri in stile himalayano sulla Loira, che collega la riva sinistra alla riva destra, e godetevi una vista incantevole sulla città."
    ],
    "fr": [
      "Traversez la passerelle de 110 m de type himalayenne au-dessus de la Loire, reliant la rive gauche à la rive droite et bénéficiez d'un sympathique point de vue sur la ville."
    ],
    "nl": [
      "Steek de 110 meter lange voetgangersbrug in Himalayastijl over de Loire over, die de linkeroever met de rechteroever verbindt, en geniet van een prachtig uitzicht over de stad."
    ],
    "es": [
      "Atraviese la pasarela de estilo himalayo de 110 metros sobre el Loira, que une la orilla izquierda con la derecha, y disfrute de una deliciosa vista sobre la ciudad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aurec-sur-Loire Himalayan footbridge"
    ],
    "fr": [
      "Passerelle Himalayenne d'Aurec-sur-Loire"
    ]
  },
