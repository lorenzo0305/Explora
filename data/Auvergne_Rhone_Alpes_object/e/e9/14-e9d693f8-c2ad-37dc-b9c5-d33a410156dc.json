  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/165f580a-9097-36fa-9c3d-358e7ea01e64",
      "dc:description": {
        "de": [
          "Die Caisse D'epargne Hauts De France ist ein wichtiger Akteur im französischen Bankensektor, der seinen Kunden hochwertige Finanzdienstleistungen anbietet. Sie sind auf Geldautomaten spezialisiert, wobei sich die Automaten an praktischen und gut zugänglichen Standorten befinden."
        ],
        "en": [
          "Caisse D'epargne Hauts De France is a major player in the French banking sector, offering superior financial services to its customers. They specialize in automatic cash dispensing, with ATMs located in convenient, accessible locations."
        ],
        "it": [
          "La Caisse D'epargne Hauts De France è uno dei principali operatori del settore bancario francese e offre ai suoi clienti servizi finanziari di qualità superiore. È specializzata nell'erogazione di contanti, con sportelli automatici situati in luoghi comodi e accessibili."
        ],
        "fr": [
          "La Caisse D'epargne Hauts De France est un acteur majeur dans le secteur bancaire français, offrant des services financiers de qualité supérieure à ses clients. Ils sont spécialisés dans la distribution automatique de billets, avec des distributeurs situés dans des emplacements pratiques et accessibles."
        ],
        "nl": [
          "Caisse D'epargne Hauts De France is een belangrijke speler in de Franse banksector en biedt superieure financiële diensten aan haar klanten. Ze zijn gespecialiseerd in geldautomaten, met geldautomaten op handige en toegankelijke locaties."
        ],
        "es": [
          "Caisse D'epargne Hauts De France es uno de los principales actores del sector bancario francés, que ofrece servicios financieros superiores a sus clientes. Están especializados en el suministro de efectivo, con cajeros automáticos situados en lugares cómodos y accesibles."
        ]
      },
