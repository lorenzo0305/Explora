  "rdfs:comment": {
    "de": [
      "Wir bieten geführte Besichtigungen von Dörfern und bemerkenswerten Orten an, um Ihnen das bauliche Erbe, die Geschichte und Geschichten und das Know-how näher zu bringen. Das Ganze wird mit Anekdoten angereichert, die die Besichtigungen würzen!"
    ],
    "en": [
      "Guide speakers association, Auvergne heritage specialists. Our guides will lead you through listed medieval villages, exceptionnal volcanic sites, rich thermal heritage of the region."
    ],
    "it": [
      "Proponiamo visite guidate a villaggi e siti degni di nota per farvi scoprire il patrimonio edilizio, la storia e le storie, il know-how, il tutto condito da aneddoti per vivacizzare le visite!"
    ],
    "fr": [
      "Nous proposons des visites guidées de villages et de sites remarquables pour vous faire découvrir le patrimoine bâti, l'Histoire et les histoires, les savoir-faire, le tout agrémenté d'anecdotes qui pimentent les visites !"
    ],
    "nl": [
      "We bieden rondleidingen door dorpen en opmerkelijke sites om je te helpen het gebouwde erfgoed, de geschiedenis en verhalen, de knowhow te ontdekken, allemaal gekruid met anekdotes om de bezoeken pittiger te maken!"
    ],
    "es": [
      "Le proponemos visitas guiadas a pueblos y lugares notables para que descubra el patrimonio construido, la historia y las anécdotas, el saber hacer, ¡todo ello aderezado con anécdotas para animar las visitas!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Guide Tourisme Auvergne"
    ],
    "fr": [
      "Guides Tourisme Auvergne"
    ]
  },
