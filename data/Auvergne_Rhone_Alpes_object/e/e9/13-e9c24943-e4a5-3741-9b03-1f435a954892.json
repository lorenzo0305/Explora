  "rdfs:comment": {
    "de": [
      "Les Gens Heureux legen sich ins Zeug, ja sogar ins Zeug, um Ihre Erwartungen zu erfüllen, in einer freundlichen, herzlichen, bukolischen, coolen, supercoolen Atmosphäre. Bistronomische Küche, die vom Chefkoch Stéphane Subrin erfunden und vor Ort zubereitet wird."
    ],
    "en": [
      "Les Gens Heureux goes out of its way to meet your expectations, in a friendly, warm, bucolic, cool, super-cool atmosphere. Bistronomic cuisine invented and prepared on site by chef Stéphane Subrin."
    ],
    "it": [
      "Les Gens Heureux si impegna al massimo per soddisfare le vostre aspettative, in un'atmosfera amichevole, calda, bucolica, fresca e super cool. Cucina bistronomica inventata e preparata in loco dallo chef Stéphane Subrin."
    ],
    "fr": [
      "Les Gens Heureux se mettent en quatre, voire en six pour répondre à vos attentes, dans une ambiance conviviale, chaleureuse, bucolique, cool, super cool. Cuisine bistronomique inventée et préparée sur place par le chef Stéphane Subrin."
    ],
    "es": [
      "Les Gens Heureux se desvive por satisfacer sus expectativas, en un ambiente acogedor, cálido, bucólico, cool, super cool. Cocina bistronómica inventada y elaborada in situ por el chef Stéphane Subrin."
    ],
    "nl": [
      "Les Gens Heureux doet er alles aan om aan je verwachtingen te voldoen, in een vriendelijke, warme, bucolische, coole, supercoole sfeer. Bistronomische keuken ter plaatse bedacht en bereid door chef Stéphane Subrin."
    ]
  },
  "rdfs:label": {
