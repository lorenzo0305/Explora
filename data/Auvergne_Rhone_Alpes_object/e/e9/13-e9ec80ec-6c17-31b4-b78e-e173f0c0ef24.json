  "rdfs:comment": {
    "de": [
      "Le Coin Des Colibris ist ein kundenfreundliches Geschäft, in dem Sie alle Produkte des täglichen Bedarfs lokal, saisonal, verpackungsfrei und in der richtigen Menge konsumieren können!"
    ],
    "en": [
      "Le Coin Des Colibris is a friendly, local shop where you can buy all your everyday products locally, in season, without packaging and in the right quantities!"
    ],
    "it": [
      "Le Coin Des Colibris è un simpatico negozio locale dove è possibile acquistare prodotti locali e di stagione nelle giuste quantità, senza imballaggi!"
    ],
    "fr": [
      "Le Coin Des Colibris est un commerce de proximité, convivial pour consommer local, de saison, sans emballage et à juste quantité tous vos produits du quotidien !"
    ],
    "nl": [
      "Le Coin Des Colibris is een gezellige buurtwinkel waar je lokale, seizoensgebonden producten kunt kopen in de juiste hoeveelheden, zonder verpakking!"
    ],
    "es": [
      "Le Coin Des Colibris es una acogedora tienda local donde podrá comprar productos locales de temporada en las cantidades justas y sin envasar"
    ]
  },
