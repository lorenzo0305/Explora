  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Welt der indischen Geschmäcker und Gerüche!\r\nFernes Indien, vegetarisches Indien, Gourmet-Indien: Entdecken Sie die verschiedenen Facetten dieser Küche im Royal Tandoor in Romans."
    ],
    "en": [
      "Discover a world of Indian flavors and smells!\r\nFar-off India, vegetarian India, gourmet India: discover the different facets of this cuisine at the Royal Tandoor in Romans."
    ],
    "it": [
      "Scoprite un mondo di sapori e profumi indiani!\r\nIndia lontana, India vegetariana, India gourmet: scoprite le diverse sfaccettature di questa cucina al Royal Tandoor di Roma."
    ],
    "fr": [
      "Découvrez un monde de saveurs et d'odeurs indiennes !\r\nInde lointaine, Inde végétarienne, Inde gourmande : découvrez les différentes facettes de cette cuisine au Royal Tandoor à Romans."
    ],
    "es": [
      "¡Descubra un mundo de sabores y olores indios!\r\nIndia lejana, India vegetariana, India gourmet: descubra las diferentes facetas de esta cocina en el Royal Tandoor de Romans."
    ],
    "nl": [
      "Ontdek een wereld van Indiase smaken en geuren!\r\nVerre India, vegetarisch India, gastronomisch India: ontdek de verschillende facetten van deze keuken bij de Royal Tandoor in Rome."
    ]
  },
