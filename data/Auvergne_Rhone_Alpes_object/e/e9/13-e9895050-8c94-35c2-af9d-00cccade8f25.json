  "rdfs:comment": {
    "de": [
      "Diese Schweine- und Rinderzüchter betreiben biologische Landwirtschaft und tragen das Ishere-Siegel. Sie zerlegen und verarbeiten ihre Produkte dank eines Labors auf dem Hof selbst. Der Verkauf erfolgt direkt ab Hof und auf den Märkten in Grenoble."
    ],
    "en": [
      "We raise pigs and cattle organically and under the Ishere label. We cut and process our own products thanks to an on-farm laboratory. Direct sales on the farm and at markets in Grenoble."
    ],
    "it": [
      "Questi allevatori di suini e bovini biologici hanno la certificazione Ishere. Tagliano e trasformano i loro prodotti in un laboratorio all'interno della fattoria. Vendono direttamente dalla fattoria e nei mercati di Grenoble."
    ],
    "fr": [
      "Ces éleveurs de porcins et bovins en agriculture biologique sont labellisé Ishere. Ils découpent et transforment eux-mêmes leurs produits grâce à un laboratoire sur l’exploitation. La vente s’effectue en direct à la ferme et sur les marchés de Grenoble."
    ],
    "es": [
      "Estos ganaderos de porcino y vacuno ecológicos cuentan con la certificación Ishere. Cortan y transforman sus propios productos en un laboratorio de la granja. Venden directamente en la granja y en mercados de Grenoble."
    ],
    "nl": [
      "Deze biologische varkens- en rundveehouders zijn Ishere gecertificeerd. Ze snijden en verwerken hun eigen producten in een laboratorium op de boerderij. Ze verkopen direct vanaf de boerderij en op markten in Grenoble."
    ]
  },
