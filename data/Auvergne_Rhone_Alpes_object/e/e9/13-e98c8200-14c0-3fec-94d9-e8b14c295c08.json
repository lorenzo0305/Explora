  "rdfs:comment": {
    "de": [
      "Ein Gallier mit scharfem Humor, ist ein Autor, Komponist, Gitarrist und Humorist, dessen Motto einfach ist: zufrieden oder zufrieden!\r\nDiese Figur, die aus den Pariser Kabaretts nicht wegzudenken ist, verspricht Ihnen 1,5 Stunden voller Lachen und Chansons."
    ],
    "en": [
      "Un Gaulois is a writer, composer, guitarist and comedian whose motto is simple: satisfy or be satisfied!\r\nThis Parisian cabaret star promises 1h30 of laughter and song."
    ],
    "it": [
      "Un Gaulois è uno scrittore, compositore, chitarrista e comico il cui motto è semplice: soddisfare o essere soddisfatti!\r\nQuesta figura leggendaria dei cabaret parigini promette 1 ora di risate e canzoni."
    ],
    "fr": [
      "Un Gaulois à l’humour décapant, est un auteur, compositeur, guitariste et humoriste dont la devise est simple : satisfait ou satisfait !\r\nCe personnage incontournable des cabarets parisiens vous promet 1h30 de rires et de chansons."
    ],
    "nl": [
      "Un Gaulois is een schrijver, componist, gitarist en komiek wiens motto eenvoudig is: tevreden stellen of tevreden gesteld worden!\r\nDeze legendarische figuur uit de Parijse cabarets belooft 1 uur lachen en zingen."
    ],
    "es": [
      "Un Gaulois es un escritor, compositor, guitarrista y cómico cuyo lema es sencillo: ¡satisfacer o ser satisfecho!\r\nEsta figura legendaria de los cabarets parisinos promete una hora y media de risas y canciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Humour : Daniel Rabier dans \"Au dessous de la ceinture...\""
    ]
  },
