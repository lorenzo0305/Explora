  "rdfs:comment": {
    "de": [
      "Neben der Brauerei und dem Laden verbirgt sich ein TapRoom, in dem Sie Page 24 und andere Biere aus lokalen Aktivitäten probieren können."
    ],
    "en": [
      "Next to the brewery and store, there's a TapRoom where you can sample Page 24 beers and other beers produced locally."
    ],
    "it": [
      "Accanto al birrificio e al negozio si trova una TapRoom dove è possibile degustare le birre Page 24 e altre birre prodotte localmente."
    ],
    "fr": [
      "À côté de la brasserie et du magasin, se cache une TapRoom où il vous est possible de déguster les bières Page 24 et autres, issues de l'activité locale."
    ],
    "nl": [
      "Naast de brouwerij en winkel is een TapRoom waar je Page 24-bieren en andere lokaal geproduceerde bieren kunt proeven."
    ],
    "es": [
      "Junto a la cervecería y la tienda hay una TapRoom donde se pueden degustar las cervezas Page 24 y otras de producción local."
    ]
  },
