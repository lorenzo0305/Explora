  "rdfs:comment": {
    "de": [
      "Die 40 Züchter der Genossenschaft des Landes des Montblancs laden Sie der Obsthändlerin ein. Kommen Sie, unsere örtlichen Produkte wiederzufinden: Käse von Savoie, die vor Ort angefertigte Pächter hergestellt herbeigeführt sind(hergestellt sind) oder die durch unsere Versorgungen, das örtliche Fleisch, das handwerkliche Einpökeln ausgewählt sind..."
    ],
    "en": [
      "The 40 farmers of the Pays Mont-Blanc cooperative  welcome you to La Fruitière. Come and discover our local products: cheeses from Savoie, local farm products, local meat, home-made salt-cured charcuterie, and more."
    ],
    "it": [
      "I 40 allevatori della Coopérative du Pays du Mont-Blanc vi invitano alla Fruitière. Qui troverete i nostri prodotti locali: formaggi di Savoia, prodotti di fattoria realizzati sul posto o selezionati da noi, carne locale, salatura artigianale..."
    ],
    "fr": [
      "Les éleveurs de la Coopérative du Pays du Mont-Blanc vous invitent à la Fruitière. Venez retrouver nos produits du terroir : fromages de Savoie, produits fermiers fabriqués sur place ou sélectionnés par nos soins, viande locale, charcuterie artisanale..."
    ],
    "es": [
      "Los agricultores de la Cooperativa del Pays du Mont-Blanc le invitan a La Fruitière. Venga a descubrir nuestros productos locales: quesos de Saboya, productos de granja elaborados in situ o seleccionados por nosotros, carnes locales, charcutería tradicional..."
    ],
    "nl": [
      "De boeren van de coöperatie Pays du Mont-Blanc nodigen u uit in La Fruitière. Kom en ontdek onze streekproducten: kazen uit de Savoie, producten van de boerderij die ter plaatse worden gemaakt of door ons worden geselecteerd, lokaal vlees, traditionele vleeswaren..."
    ]
  },
