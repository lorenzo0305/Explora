  "rdfs:comment": {
    "de": [
      "Der Club Vichyparapente ist einer der ältesten Paragliding-Clubs der Region und wurde 1988 gegründet. Wir sind etwa 30 Lizenznehmer aller Altersgruppen und Niveaus, vom Anfänger bis zum Fortgeschrittenen."
    ],
    "ru": [
      "Клуб Vichyparapente - один из старейших парапланерных клубов в регионе, основанный в 1988 году. В нашем клубе около 30 членов всех возрастов и способностей, от новичков до очень опытных."
    ],
    "en": [
      "Club Vichyparapente is one of the oldest paragliding clubs in the region, founded in 1988. We have around 30 members of all ages and levels, from beginners to the very experienced."
    ],
    "it": [
      "Il Club Vichyparapente è uno dei più antichi club di parapendio della regione, fondato nel 1988. Abbiamo circa 30 membri di tutte le età e capacità, dai principianti ai più esperti."
    ],
    "fr": [
      "Le Club Vichyparapente est l'un des plus anciens clubs de parapente de la région, créé en 1988. Nous sommes environ 30 licenciés de tous âges et tous niveaux, du débutant jusqu'aux plus expérimentés."
    ],
    "zh": [
      "维希帕拉彭特俱乐部成立于 1988 年，是该地区历史最悠久的滑翔伞俱乐部之一。我们拥有约 30 名会员，从初学者到经验丰富者，年龄和能力各不相同。"
    ],
    "es": [
      "El Club Vichyparapente es uno de los clubes de parapente más antiguos de la región, fundado en 1988. Tenemos alrededor de 30 miembros de todas las edades y habilidades, desde principiantes hasta muy experimentados."
    ],
    "nl": [
      "Club Vichyparapente is een van de oudste paraglidingclubs in de regio, opgericht in 1988. We hebben ongeveer 30 leden van alle leeftijden en niveaus, van beginners tot zeer ervaren."
    ]
  },
