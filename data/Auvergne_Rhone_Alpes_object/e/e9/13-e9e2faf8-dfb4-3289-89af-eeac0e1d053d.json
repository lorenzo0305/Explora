  "rdfs:comment": {
    "de": [
      "Naturwanderungen mit Béa von L'échappée Belle.\r\nWanderungen und Naturveranstaltungen im Massif du Mézenc, Entdeckung von Fauna und Flora, Kulturerbe. Das ganze Jahr über auf Reservierung."
    ],
    "en": [
      "Nature walks with Béa from L'échappée Belle.\r\nNature hikes and activities on the Mezenc massif, discovery of flora and fauna, cultural heritage. Year-round by reservation."
    ],
    "it": [
      "Passeggiate nella natura con Béa de L'échappée Belle.\r\nEscursioni naturalistiche ed eventi sul massiccio del Mézenc, scoperta della flora e della fauna, patrimonio culturale. Tutto l'anno su prenotazione."
    ],
    "fr": [
      "Balades nature avec Béa de L'échappée Belle.\r\nRandonnées et animations natures sur le massif du Mézenc, découverte faune flore, patrimoine culturel. Toute l'année sur réservation."
    ],
    "es": [
      "Paseos por la naturaleza con Béa de L'échappée Belle.\r\nPaseos por la naturaleza y eventos en el macizo de Mézenc, descubrimiento de la flora y la fauna, patrimonio cultural. Todo el año con cita previa."
    ],
    "nl": [
      "Natuurwandelingen met Béa van L'échappée Belle.\r\nNatuurwandelingen en evenementen in het massief van Mézenc, ontdekking van flora en fauna, cultureel erfgoed. Het hele jaar door op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnées Avec L'Échappée Belle"
    ]
  },
