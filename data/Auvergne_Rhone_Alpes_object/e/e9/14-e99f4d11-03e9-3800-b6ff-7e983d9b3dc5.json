  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab06afcc-ef35-3d2f-a69a-95639c763765",
      "dc:description": {
        "de": [
          "Cabaïa erfindet Accessoires und Kleidung für Frauen, Männer und Kinder neu: Mützen, Taschen, Schals, Socken, Strandtücher.\n\nTäglich von 10:00 bis 19:00 Uhr geöffnet."
        ],
        "en": [
          "Cabaïa reinvents accessories and clothing for women, men and children: Hats, Bags, Scarves, Socks, Beach towels.\n\nOpen daily from 10:00 am to 7:00 pm."
        ],
        "it": [
          "Cabaïa reinventa accessori e abbigliamento per donne, uomini e bambini: Cappelli, borse, sciarpe, calze e teli da mare.\n\nAperto tutti i giorni dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Cabaïa réinvente les accessoires et vêtements pour les femmes, hommes et enfants : Bonnets, Sacs, Écharpes, Chaussettes, Serviettes de plage.\n\nOuvert tous les jours de 10h00 à 19h00."
        ],
        "nl": [
          "Cabaïa vindt accessoires en kleding voor vrouwen, mannen en kinderen opnieuw uit: Hoeden, tassen, sjaals, sokken en strandlakens.\n\nElke dag geopend van 10.00 tot 19.00 uur."
        ],
        "es": [
          "Cabaïa reinventa los accesorios y la ropa para mujeres, hombres y niños: Sombreros, bolsos, bufandas, calcetines y toallas de playa.\n\nAbierto todos los días de 10.00 a 19.00 h."
        ]
      },
