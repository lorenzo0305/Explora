  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/16f1be05-2bdc-3805-9d90-c297c9bfac5f",
      "dc:description": {
        "de": [
          "Wir sind ein Crêperie-Foodtruck namens La Galette Fleurine und bieten herzhafte bretonische Galettes aus Buchweizen und süße Crêpes zum Essen vor Ort oder zum Mitnehmen an.\n\n8.00-12.00 Uhr auf den Märkten\n18.30-20.30 Uhr am Abend"
        ],
        "en": [
          "We're a foodtruck crêperie called La Galette Fleurine, offering savory buckwheat pancakes and sweet crêpes to eat in or take away.\n\n8:00am-12:00pm on markets\n6:30-8:30 pm in the evening"
        ],
        "it": [
          "Siamo una foodtruck crêperie chiamata La Galette Fleurine che offre frittelle salate di grano saraceno della Bretagna e crêpes dolci da mangiare o da portare via.\n\n8.00-12.00 al mercato\n18.30-20.30 la sera"
        ],
        "fr": [
          "Nous sommes un foodtruck crêperie qui se nomme La Galette Fleurine et nous proposons des galettes bretonnes salées au sarrasin et des crêpes sucrées à manger sur place ou à emporter.\n\n8h00-12h00 sur les marchés\n18h30-20h30 le soir"
        ],
        "nl": [
          "We zijn een foodtruck crêperie genaamd La Galette Fleurine met hartige boekweitpannenkoeken uit Bretagne en zoete crêpes om te eten of mee te nemen.\n\n8u-12u op de markt\n18.30 - 20.30 uur 's avonds"
        ],
        "es": [
          "Somos una crepería foodtruck llamada La Galette Fleurine que ofrece crepes salados de trigo sarraceno de Bretaña y crepes dulces para comer en casa o para llevar.\n\n8h-12h en el mercado\nde 18.30 a 20.30 h por la tarde"
        ]
      },
      "@type": [
        "Description"
      ],
