  "rdfs:comment": {
    "de": [
      "Der Grand'Maison-Stausee liegt an der Grenze zwischen Savoyen und der Isere. Er beherbergt zahlreiche Fischarten, was für einen Bergsee eher untypisch ist. Man findet dort sehr schöne Forellen. A bon entendeur.."
    ],
    "en": [
      "The Grand'Maison reservoir is on the Savoie/Isère border. It hosts many fish species, which is unusual for a mountain lake. We find there very beautiful trouts. To hear you well.."
    ],
    "it": [
      "Il lago artificiale della Grand'Maison si trova al confine tra Savoia e Isère. Ospita molte specie di pesci, cosa insolita per un lago di montagna. Ci sono alcune trote molto belle. Sentiamo?"
    ],
    "fr": [
      "La retenue de Grand'Maison est en limite Savoie/Isère. Elle accueille de nombreuses espèces piscicoles, ce qui est peu courant pour un lac de montagne. On y trouve de très belles truites. A bon entendeur…"
    ],
    "nl": [
      "Het stuwmeer van Grand'Maison ligt op de grens van de Savoie/Isère. Er leven veel vissoorten, wat ongebruikelijk is voor een bergmeer. Er zijn enkele zeer mooie forellen. Laten we het horen?"
    ],
    "es": [
      "El embalse de la Grand'Maison se encuentra en la frontera entre Saboya e Isère. Alberga muchas especies de peces, algo inusual en un lago de montaña. Hay algunas truchas muy bonitas. ¿Lo oímos?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La retenue de Grand Maison"
    ]
  },
