  "rdfs:comment": {
    "de": [
      "Vorstellung des Weinbergs und des Marne-Tals, Besichtigung der Einrichtungen (Weinpresse, Cuverie,...), die mit einer kommentierten Verkostung der auf dem Weingut hergestellten Champagner endet."
    ],
    "en": [
      "Presentation of the vineyard and the Marne Valley, visit of the facilities (press, vat room,...) ending with a commented tasting of the champagnes produced on the property."
    ],
    "it": [
      "Presentazione del vigneto e della Valle della Marna, visita degli impianti (pressa, tinaia,...) per finire con una degustazione commentata degli champagne prodotti nella proprietà."
    ],
    "fr": [
      "Présentation du vignoble et de la Vallée de la Marne, visite des installations (pressoir, cuverie,...) se concluant par une dégustation commentée des champagnes produits à la propriété."
    ],
    "nl": [
      "Voorstelling van de wijngaard en de Marnevallei, bezoek aan de installaties (pers, kuiperij,...) eindigend met een becommentarieerde degustatie van de champagnes die op het domein worden geproduceerd."
    ],
    "es": [
      "Presentación del viñedo y del Valle del Marne, visita de las instalaciones (lagar, sala de cubas,...) finalizando con una cata comentada de los champagnes producidos en la propiedad."
    ]
  },
