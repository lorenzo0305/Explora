  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Betrieb, der auf die Produktion von Gemüse und Obst spezialisiert ist. Hier finden Sie eine große Auswahl an Produkten, die nach dem Verfahren \"Haute Valeur Environnementale\" oder aus biologischem Anbau stammen."
    ],
    "en": [
      "Farm specializing in vegetable and fruit production. You'll find a wide choice of products from the High Environmental Value or organic farming approaches."
    ],
    "it": [
      "Azienda agricola specializzata nella produzione di ortaggi e frutta. Troverete un'ampia scelta di prodotti che derivano dall'approccio ad alto valore ambientale o dall'agricoltura biologica."
    ],
    "fr": [
      "Exploitation agricole spécialisée dans la production de légumes et de fruits. Vous trouverez un large choix de produits issus de la démarche Haute Valeur Environnementale ou de l'agriculture biologique."
    ],
    "es": [
      "Granja especializada en la producción de hortalizas y frutas. Encontrará una amplia gama de productos procedentes de la agricultura ecológica o de alto valor medioambiental."
    ],
    "nl": [
      "Boerderij gespecialiseerd in de productie van groente en fruit. Je vindt hier een ruime keuze aan producten van de High Environmental Value-benadering of biologische landbouw."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les jardins de champagne"
    ]
  },
