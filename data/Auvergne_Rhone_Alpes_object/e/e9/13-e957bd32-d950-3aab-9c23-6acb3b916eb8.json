  "rdfs:comment": {
    "de": [
      "Das Bistro Bocuse Original Comptoir kommt direkt unter La Rotonde!\r\nMit einem außergewöhnlichen Blick auf den Lac d'Allier verspricht dieses brandneue Konzept von Bocuse Original Comptoir Ihr Lieblingsspot zu werden, an dem Sie zu jeder Tageszeit essen können."
    ],
    "en": [
      "The Bistrot Bocuse Original Comptoir lands just below La Rotonde!\r\nWith an exceptional view over Lac d'Allier, this brand new Bocuse Original Comptoir concept promises to become your favorite spot to dine at any time of day."
    ],
    "it": [
      "Il Bistrot Bocuse Original Comptoir è arrivato proprio sotto La Rotonde!\r\nCon una vista eccezionale sul Lac d'Allier, questo nuovo concetto di Bocuse Original Comptoir promette di diventare il vostro posto preferito per mangiare a qualsiasi ora del giorno."
    ],
    "fr": [
      "Le Bistrot Bocuse Original Comptoir débarque juste sous La Rotonde !\r\nAvec une vue exceptionnelle sur le lac d’Allier, ce tout nouveau concept signé Bocuse Original Comptoir promet de devenir votre spot préféré pour vous restaurer à toute heure."
    ],
    "es": [
      "El Bistrot Bocuse Original Comptoir ha llegado justo debajo de La Rotonde\r\nCon una vista excepcional sobre el lago de Allier, este nuevo concepto de Bocuse Original Comptoir promete convertirse en su lugar favorito para comer a cualquier hora del día."
    ],
    "nl": [
      "Bistrot Bocuse Original Comptoir is net onder La Rotonde!\r\nMet een uitzonderlijk uitzicht over het Lac d'Allier belooft dit gloednieuwe concept van Bocuse Original Comptoir je favoriete plek te worden om op elk moment van de dag te eten."
    ]
  },
