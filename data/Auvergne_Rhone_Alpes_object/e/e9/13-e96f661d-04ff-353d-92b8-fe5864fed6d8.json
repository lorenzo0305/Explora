  "rdfs:comment": {
    "de": [
      "Gegründet 1601 dank einer großzügigen Spende des Notars Jean Reynaud. Der Unterricht war auf Jungen beschränkt. Sie lernten Philosophie, Mathematik, Recht und Fechten."
    ],
    "en": [
      "Founded in 1601 thanks to a generous donation from notary Jean Reynaud. Education was reserved for boys. They learned philosophy, mathematics, law and fencing."
    ],
    "it": [
      "Fondata nel 1601 grazie alla generosa donazione del notaio Jean Reynaud. L'istruzione era riservata ai ragazzi. Hanno imparato la filosofia, la matematica, la legge e la scherma."
    ],
    "fr": [
      "Fondé en 1601 grâce à un généreux don de Jean Reynaud, notaire. L'enseignement était réservé aux garçons. Ils apprenaient la philosophie, les mathématiques, le droit et l'escrime."
    ],
    "nl": [
      "Opgericht in 1601 dankzij een gulle donatie van Jean Reynaud, een notaris. Het onderwijs was voorbehouden aan jongens. Ze leerden filosofie, wiskunde, rechten en schermen."
    ],
    "es": [
      "Fundada en 1601 gracias a una generosa donación de Jean Reynaud, notario. La educación estaba reservada a los varones. Aprendieron filosofía, matemáticas, derecho y esgrima."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ancien Collège"
    ]
  },
