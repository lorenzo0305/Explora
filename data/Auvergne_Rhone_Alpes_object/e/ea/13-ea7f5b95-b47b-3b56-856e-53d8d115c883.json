  "rdfs:comment": {
    "de": [
      "La Cabane, ein geselliger, spielerischer und kreativer Raum hoch oben im Museum. In diesem Frühjahr wird im zweiten Stock des Museums ein Raum zum Spielen, Lesen und Kreativsein eröffnet.\r\nWillkommen zu einem Ausflug in die Natur im Herzen des Museums!"
    ],
    "en": [
      "La Cabane, a friendly, playful, creative space perched atop the museum. This spring, a space for play, reading and creativity opens on the 2nd floor of the museum.\r\nWelcome to a nature getaway in the heart of the museum!"
    ],
    "it": [
      "La Cabane, uno spazio amichevole, ludico e creativo arroccato in cima al museo. Questa primavera, uno spazio per il gioco, la lettura e la creatività apre al 2° piano del museo.\r\nBenvenuti in un rifugio naturale nel cuore del museo!"
    ],
    "fr": [
      "La Cabane, un espace convivial, ludique, créatif perché au sommet du musée. Ce printemps, un espace de jeu, de lecture et de créativité ouvre au 2e étage du musée.\r\nBienvenue pour une escapade nature au cœur du musée !"
    ],
    "es": [
      "La Cabane, un espacio lúdico y creativo situado en lo alto del museo. Esta primavera se inaugura en la 2ª planta del museo un espacio para el juego, la lectura y la creatividad.\r\n¡Bienvenido a una escapada natural en el corazón del museo!"
    ],
    "nl": [
      "La Cabane, een vriendelijke, speelse, creatieve ruimte bovenin het museum. Dit voorjaar opent een ruimte voor spelen, lezen en creativiteit op de 2e verdieping van het museum.\r\nWelkom bij een natuurlijk uitje in het hart van het museum!"
    ]
  },
  "rdfs:label": {
