  "rdfs:comment": {
    "de": [
      "Restaurierung von Kunstgegenständen und archäologischen Objekten aus Keramik (Terrakotta, Steingut, Steinzeug, Porzellan, Biskuit) und Glas (Kristall, Glasmalerei, Emaille auf Kupfer...).\r\nRestauratorin von alten Puppen aus Porzellan oder Zelluloid."
    ],
    "en": [
      "Restoration of art and archaeological objects in ceramics (terracotta, earthenware, stoneware, porcelain, biscuit) and glass (crystal, stained glass, enamel on copper...).\r\nRestorer of antique porcelain or celluloid dolls."
    ],
    "it": [
      "Restauro di oggetti d'arte e archeologici in ceramica (terracotta, grès, porcellana, biscotto) e vetro (cristallo, vetro colorato, smalto su rame...).\r\nRestauratore di bambole antiche in porcellana o celluloide."
    ],
    "fr": [
      "Restauration d'objets d'art et d'archéologie en céramiques (terre cuite, faïence, grès, porcelaine, biscuit) et verre (cristal, vitrail, émail sur cuivre...).\r\nRestauratrice de poupées anciennes  en porcelaine ou celluloïd."
    ],
    "nl": [
      "Restauratie van kunst- en archeologische voorwerpen in keramiek (terracotta, aardewerk, steengoed, porselein, biscuit) en glas (kristal, glas in lood, email op koper...).\r\nRestaurateur van antieke poppen in porselein of celluloid."
    ],
    "es": [
      "Restauración de objetos de arte y arqueológicos en cerámica (terracota, loza, gres, porcelana, bizcocho) y vidrio (cristal, vidrieras, esmalte sobre cobre...).\r\nRestaurador de muñecas antiguas de porcelana o celuloide."
    ]
  },
  "rdfs:label": {
