  "rdfs:comment": {
    "de": [
      "Die Pfarrkirche wurde im 15. Jahrhundert unter der Äbtissin Marie de Langhac wiederaufgebaut, um den an die Abtei Saint-Pierre angrenzenden Marktflecken zu versorgen. Sie beherbergt eine majestätische Madonna aus polychromem Holz aus dem frühen 13."
    ],
    "en": [
      "The parish church was rebuilt in the 15th century under the abbatiat of Marie de Langhac to serve the village adjoining the Saint-Pierre abbey. It houses a polychrome wooden Virgin in Majesty from the early 13th century."
    ],
    "it": [
      "La chiesa parrocchiale fu ricostruita nel XV secolo sotto l'abbaziato di Marie de Langhac per servire il villaggio adiacente all'abbazia di Saint-Pierre. Ospita una Vergine in Maestà in legno policromo dell'inizio del XIII secolo."
    ],
    "fr": [
      "L'église paroissiale a été reconstruite au XVème siècle sous l'abbatiat de Marie de Langhac afin de desservir le bourg attenant à l'abbaye Saint-Pierre. Elle abrite une Vierge en majesté en bois polychrome du début du XIIIème siècle."
    ],
    "es": [
      "La iglesia parroquial fue reconstruida en el siglo XV bajo el abbacial de Marie de Langhac para dar servicio al pueblo contiguo a la abadía de Saint-Pierre. Alberga una Virgen en Majestad en madera policromada de principios del siglo XIII."
    ],
    "nl": [
      "De parochiekerk werd in de 15e eeuw herbouwd onder het abbataat van Marie de Langhac om het dorp naast de abdij van Saint-Pierre te dienen. Het herbergt een Maagd in Majesteit in polychroom hout uit het begin van de 13e eeuw."
    ]
  },
  "rdfs:label": {
