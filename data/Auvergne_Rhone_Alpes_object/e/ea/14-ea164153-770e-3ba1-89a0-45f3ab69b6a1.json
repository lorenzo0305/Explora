  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/955fe3e0-b137-3278-9abb-986fa4864e5a",
      "dc:description": {
        "de": [
          "Entdecken Sie einen Tag lang Kunsthandwerkerlehrlinge in Aktion im öffentlichen Garten von Liévin; sie zeigen Ihnen ihr Können und ihre Kreativität."
        ],
        "en": [
          "Come and see apprentice craftsmen in action at Liévin's public garden, and discover their skills and creativity."
        ],
        "it": [
          "Venite a vedere gli apprendisti artigiani in azione nei giardini pubblici di Liévin, dimostrando le loro abilità e la loro creatività."
        ],
        "fr": [
          "Sur une journée, venez découvrir des apprentis artisans d’art en action au jardin public de Liévin ; ils vous feront découvrir leur savoir-faire et leur créativité."
        ],
        "es": [
          "Venga a ver a los aprendices de artesanos en acción en los jardines públicos de Liévin, demostrando sus habilidades y creatividad."
        ],
        "nl": [
          "Kom de leerling-ambachtslieden aan het werk zien in de openbare tuinen van Liévin en demonstreer hun vaardigheden en creativiteit."
        ]
      },
