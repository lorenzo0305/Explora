  "rdfs:comment": {
    "de": [
      "LA FLORIA Immobilier ist eine seit 2010 in Chamonix Mont-Blanc ansässige Immobilienagentur. Sie bietet den Kauf und Verkauf von Studios, Wohnungen, Chalets, Grundstücken und Gewerbeimmobilien im gesamten Chamonix-Tal an."
    ],
    "en": [
      "As an estate agency established in Chamonix Mont-Blanc since 2010, LA FLORIA Immobilier provides a discreet service for both purchase and sale of studios, apartments, chalets, land and commercial properties covering the whole of the Chamonix valley."
    ],
    "it": [
      "Agenzia immobiliare di Chamonix Mont-Blanc dal 2010, LA FLORIA Immobilier vende e acquista monolocali, appartamenti, chalet, terreni e immobili commerciali in tutta la valle di Chamonix."
    ],
    "fr": [
      "Agence immobilière installée à Chamonix Mont-Blanc depuis 2010, LA FLORIA Immobilier propose l'achat et la vente de studios, appartements, chalets, terrains et biens commerciaux dans toute la vallée de Chamonix."
    ],
    "nl": [
      "LA FLORIA Immobilier is sinds 2010 een makelaarskantoor in Chamonix Mont-Blanc en verkoopt en koopt studio's, appartementen, chalets, grond en commercieel vastgoed in de hele vallei van Chamonix."
    ],
    "es": [
      "Agencia inmobiliaria de Chamonix Mont-Blanc desde 2010, LA FLORIA Immobilier vende y compra estudios, pisos, chalets, terrenos y locales comerciales en todo el valle de Chamonix."
    ]
  },
