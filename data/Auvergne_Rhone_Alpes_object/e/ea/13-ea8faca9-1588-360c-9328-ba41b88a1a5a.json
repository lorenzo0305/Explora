  "rdfs:comment": {
    "de": [
      "Festliche Spezialitäten aus regionalen Produkten, die auf Bauernhöfen und in Handwerksbetrieben hergestellt werden. Essen und trinken Sie das Beste aus unseren Bergen. Entdecken Sie den Geschmack der Küche unserer Großmütter wieder! Terrasse auf dem Land. Reservierung erwünscht."
    ],
    "en": [
      "Festive and meticulous cuisine based on famous local products. The taste and the naturalness are our trademark. Unique place with a farm-lounge terrace. Reservation is recommended."
    ],
    "it": [
      "Specialità festive a base di pepite regionali raccolte a mano. Venite a mangiare e bere il meglio delle nostre montagne. Riscoprite la cucina rassicurante delle nostre nonne! Atmosfera amichevole e terrazza ombreggiata."
    ],
    "fr": [
      "Spécialités festives mitonnées à partir de pépites régionales triées sur le volet . Venez boire et manger le meilleur de nos montagnes. Redécouvrez la cuisine réconfortante de nos grands-mères ! Ambiance conviviale.Terrasse ombragée Réservation souhaitée."
    ],
    "nl": [
      "Feestelijke keuken bereid met finesse. Streekgerechten met vertrouwelijk karakter. Smaakvolle en authentieke keuken zijn ons handelsmerk. Aparte omgeving met terras lounge-boerderij. Klasse onthaal. Reservatie is aangeraden."
    ],
    "es": [
      "Especialidades festivas elaboradas con pepitas regionales seleccionadas a mano. Venga a comer y beber lo mejor de nuestras montañas. Redescubra la reconfortante cocina de nuestras abuelas Ambiente acogedor y terraza a la sombra."
    ]
  },
