  "rdfs:comment": {
    "de": [
      "Dieses gemütliche Café-Theater liegt im historischen Herzen der Altstadt von Bourg-lès-Valence. Es ist ein wahrer Humortempel in der Drôme Ardèche und wird seit 1999 von Thierry Roudil geleitet. Die Fläche bietet Privatsphäre und Nähe."
    ],
    "en": [
      "Located in the historic heart of Old Bourg-lès-Valence, this cozy café-theater, a veritable temple to humor in Drôme Ardèche and run by Thierry Roudil since 1999, offers a space conducive to intimacy and proximity."
    ],
    "it": [
      "Situato nel cuore storico di Bourg-lès-Valence, questo caldo caffè-teatro, vero e proprio tempio dell'umorismo della Drôme Ardèche e diretto da Thierry Roudil dal 1999, offre uno spazio favorevole all'intimità e alla vicinanza."
    ],
    "fr": [
      "Situé au coeur historique du Vieux Bourg-lès-Valence, ce chaleureux café-théâtre, véritable temple de l'humour en Drôme Ardèche  et dirigé par Thierry Roudil depuis 1999, offre une surface propice à l’intimité et à la proximité."
    ],
    "es": [
      "Situado en el corazón histórico de Bourg-lès-Valence, este cálido café-teatro, auténtico templo del humor en la Drôme Ardèche y dirigido por Thierry Roudil desde 1999, ofrece un espacio propicio para la intimidad y la proximidad."
    ],
    "nl": [
      "Dit gezellige café-theater in het historische hart van Bourg-lès-Valence, een ware komedietempel in de Drôme Ardèche, wordt sinds 1999 gerund door Thierry Roudil."
    ]
  },
