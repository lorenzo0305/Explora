  "rdfs:comment": {
    "de": [
      "Genießen Sie die zauberhafte Umgebung dieses Parks, der ideal für Faulenzerpausen, Spaziergänge oder Familienausflüge ist! Es stehen Ihnen Picknicktische, ein Fitnessparcours und Kinderspiele zur Verfügung! Angeln bei der Association de l'Ovalie"
    ],
    "en": [
      "Park ideal for sport and walks. Health trail and fishing equipement."
    ],
    "it": [
      "Godetevi l'incantevole cornice di questo parco, ideale per pause rilassanti, passeggiate o gite in famiglia! Tavoli da picnic, un percorso fitness e giochi per bambini sono a vostra disposizione! Pesca con l'associazione Ovalie"
    ],
    "fr": [
      "Profitez du cadre enchanteur de ce parc, idéal pour les pauses farniente, les balades ou les sorties en famille ! Des tables de pique-nique, un parcours de santé et des jeux pour enfants sont à votre disposition ! Pêche auprès de l'association de l'Ovalie"
    ],
    "nl": [
      "Geniet van de betoverende omgeving van dit park, ideaal voor ontspannende pauzes, wandelingen of familie-uitstapjes! Picknicktafels, een trimparcours en kinderspelen staan tot uw beschikking! Vissen met de vereniging Ovalie"
    ],
    "es": [
      "Disfrute del encantador entorno de este parque, ideal para relajarse, pasear o ir en familia. Mesas de picnic, pista de fitness y juegos infantiles a su disposición. Pesca con la asociación Ovalie"
    ]
  },
