  "rdfs:comment": {
    "de": [
      "Dieser Workshop ist eine einzigartige Gelegenheit, Momente rund um die Lieder der Welt in einer freundlichen Atmosphäre zu erleben. Geleitet wird der Workshop von Silvia Ciliberto, einer auf Stimmtechnik spezialisierten Trainerin."
    ],
    "en": [
      "This workshop is a unique opportunity to experience world music in a convivial atmosphere. Led by Silvia Ciliberto, a trainer specialized in vocal technique."
    ],
    "it": [
      "Questo corso è un'occasione unica per sperimentare la world music in un'atmosfera amichevole. Condotto da Silvia Ciliberto, istruttrice specializzata in tecnica vocale."
    ],
    "fr": [
      "Ce stage est l'occasion unique de vivre des moments autour des chants du monde dans une ambiance conviviale. Stage animée par Silvia Ciliberto, formatrice spécialisée en technique vocale."
    ],
    "es": [
      "Este curso es una oportunidad única para experimentar las músicas del mundo en un ambiente agradable. Impartido por Silvia Ciliberto, profesora especializada en técnica vocal."
    ],
    "nl": [
      "Deze cursus is een unieke kans om wereldmuziek te ervaren in een gezellige sfeer. Onder leiding van Silvia Ciliberto, een docent gespecialiseerd in zangtechniek."
    ]
