  "rdfs:comment": {
    "de": [
      "Die Käserei Emma D ist ein freundlicher, einladender Laden mit einem Bereich, der den süßen und salzigen Kombinationen von Käse gewidmet ist.\r\nHier finden Sie eine große Auswahl an Produkten: Käse, Cremes oder auch Gerichte zum Mitnehmen."
    ],
    "en": [
      "La Fromagerie Emma D is a warm and friendly store, with a section dedicated to sweet and savoury cheese pairings.\r\nYou'll find a wide choice of products: cheeses, creams and takeaways."
    ],
    "it": [
      "Il Cheese Shop di Emma D è un negozio caldo e accogliente con una sezione dedicata alle combinazioni di formaggi dolci e salati.\r\nTroverete un'ampia gamma di prodotti: formaggi, creme e prodotti da asporto."
    ],
    "fr": [
      "La Fromagerie  Emma D c'est une boutique conviviale, chaleureuse avec une partie dédiée aux accords entre le fromage autant sucrés que salés.\r\nVous trouverez tout un large choix de produits : des fromages, crèmes ou encore des plats à emporter."
    ],
    "nl": [
      "Emma D's Cheese Shop is een warme en vriendelijke winkel met een afdeling gewijd aan zoete en hartige kaascombinaties.\r\nU vindt er een breed scala aan producten: kazen, crèmes en afhaalmaaltijden."
    ],
    "es": [
      "Emma D's Cheese Shop es una tienda cálida y acogedora con una sección dedicada a las combinaciones de quesos dulces y salados.\r\nEncontrará una amplia gama de productos: quesos, cremas y productos para llevar."
    ]
  },
  "rdfs:label": {
