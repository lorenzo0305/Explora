  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7394f5d7-93fa-33c9-931c-1d86c9036cdd",
      "dc:description": {
        "de": [
          "Handwerker und Schöpfer von Schokolade, Kuchen, Keksen, Süßwaren in Hubersent.\n\nZu finden unter:\n- freitags auf dem Markt in Etaples-sur-Mer von 8.00 bis 12.30 Uhr ;\n- freitags vor dem Herstellungsatelier in Hubersent von 16:00 bis 20:00 Uhr."
        ],
        "en": [
          "Artisan-creator of chocolates, cakes, cookies and confectionery in Hubersent.\n\nTo be found :\n- fridays at the Etaples-sur-Mer market from 8:00am to 12:30pm;\n- fridays in front of the Hubersent workshop from 4pm to 8pm."
        ],
        "it": [
          "Creatore artigianale di cioccolatini, torte, biscotti e dolciumi a Hubersent.\n\nDa trovare:\n- il venerdì al mercato di Etaples-sur-Mer dalle 8.00 alle 12.30;\n- il venerdì davanti al laboratorio di Hubersent dalle 16.00 alle 20.00."
        ],
        "fr": [
          "Artisan-créateur de chocolats, gâteaux, biscuits, confiseries à Hubersent. \n\nA retrouver :\n- le vendredi sur le marché d'Etaples-sur-Mer de 8h00 à 12h30 ;\n- le vendredi devant l'atelier de fabrication à Hubersent de 16h00 à 20h00."
        ],
        "es": [
          "Artesano-creador de chocolates, pasteles, galletas y confitería en Hubersent.\n\nSe puede encontrar :\n- los viernes en el mercado de Etaples-sur-Mer de 8.00 a 12.30 h;\n- los viernes delante del taller de Hubersent de 16.00 a 20.00 h."
        ],
        "nl": [
          "Ambachtelijke maker van bonbons, taarten, koekjes en snoepgoed in Hubersent.\n\nTe vinden :\n- vrijdag op de markt van Etaples-sur-Mer van 8.00 tot 12.30 uur;\n- vrijdag voor het atelier in Hubersent van 16.00 tot 20.00 uur."
        ]
      },
