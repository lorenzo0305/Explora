  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt Bugey Sud Grand Colombier übt seine Aufgaben im Bereich Empfang, Information, Kommunikation und Werbung in den 41 Gemeinden von Bugey Sud aus, von der ViaRhôna über den Grand Colombier bis hin zum Plateau de Retord."
    ],
    "en": [
      "The Bugey Sud Grand Colombier Tourist Office carries out its missions of reception, information, communication and promotion in the 41 communes of Bugey Sud, from the ViaRhôna to the Plateau de Retord, via the Grand Colombier."
    ],
    "it": [
      "L'Ufficio del Turismo di Bugey Sud Grand Colombier accoglie, informa, comunica e promuove i 41 comuni di Bugey Sud, dalla ViaRhôna al Plateau de Retord, passando per il Grand Colombier."
    ],
    "fr": [
      "L'Office de Tourisme Bugey Sud Grand Colombier exerce ses missions d'accueil, d'information, de communication, de promotion, sur les 41 communes de Bugey Sud, de la ViaRhôna au Plateau de Retord, en passant par le Grand Colombier."
    ],
    "es": [
      "La Oficina de Turismo de Bugey Sud Grand Colombier acoge, informa, comunica y promociona los 41 municipios de Bugey Sud, desde la ViaRhôna hasta el Plateau de Retord, pasando por el Grand Colombier."
    ],
    "nl": [
      "Het Office du Tourisme Bugey Sud Grand Colombier verwelkomt, informeert, communiceert en promoot de 41 gemeenten van Bugey Sud, van de ViaRhôna tot het Plateau de Retord, via de Grand Colombier."
    ]
  },
