    "de": [
      "Lorette Havond, \"Achthundert Gramm\", Töpferin, bietet Ihnen einen Workshop zur Entdeckung des Drehens und der Erde an!"
    ],
    "en": [
      "Lorette Havond, \"Huit cent grammes\" (Eight Hundred Grammes), potter, offers you a workshop to discover throwing and clay!"
    ],
    "it": [
      "Lorette Havond, \"Huit cent grammes\" (Ottocento grammi), ceramista, organizza un laboratorio per farvi scoprire l'arte del lancio e dell'argilla!"
    ],
    "fr": [
      "Lorette Havond, \"Huit cent grammes\", potière, vous propose un atelier de découverte du tournage et de la terre !"
    ],
    "es": [
