  "rdfs:comment": {
    "de": [
      "In einer ländlichen Umgebung im Herzen des Cher-Tals gelegen, ist das Hotel über die Autobahn A71 Ausfahrt Nr. 9 in 1,5 km Entfernung und über die N144 erreichbar. Jedes Zimmer ist mit Dusche/WC und WLAN ausgestattet."
    ],
    "en": [
      "In a country setting, in the heart of the Cher valley, the hotel is accessible by the A71 motorway exit n° 9 at 1.5 km and by the N144. Each room is equipped with shower/wc and wifi."
    ],
    "it": [
      "In un ambiente di campagna, nel cuore della valle del Cher, l'hotel è accessibile dall'autostrada A71, uscita 9, a 1,5 km, e dalla N144. Ogni camera è dotata di doccia/wc e wifi."
    ],
    "fr": [
      "Dans un cadre campagnard, au coeur de la vallée du Cher, l'hôtel est accessible par l'autoroute A71 sortie n° 9 à 1,5 km et par la N144. Chaque chambre est équipée de douche/wc et wifi."
    ],
    "nl": [
      "In een landelijke omgeving, in het hart van de vallei van de Cher, is het hotel bereikbaar vanaf de snelweg A71, afrit 9, op 1,5 km afstand, en vanaf de N144. Elke kamer is uitgerust met douche/wc en wifi."
    ],
    "es": [
      "En un entorno campestre, en el corazón del valle del Cher, el hotel es accesible desde la autopista A71, salida 9, a 1,5 km, y desde la N144. Cada habitación está equipada con ducha/wc y wifi."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel-Restaurant Le Lichou"
    ]
  },
