  "rdfs:comment": {
    "de": [
      "Genießen Sie die Küche von Dajmila im Herzen des Dorfes. Das Café-Restaurant Chez l'Hôte bereitet traditionelle französische Gerichte sowie orientalische Spezialitäten wie Couscous oder Kebab zu."
    ],
    "en": [
      "\"Come and enjoy Dajmila’s cuisine in the heart of the village.\r\nChez l’Hôte is a café and restaurant serving family dishes, traditional French cuisine, and eastern specialities such as couscous and kebab.\""
    ],
    "it": [
      "Venite a gustare la cucina di Djamila nel cuore del villaggio.\r\nIl ristorante-caffetteria Chez l'Hôte offre una cucina familiare con piatti tradizionali francesi a base di prodotti freschi locali."
    ],
    "fr": [
      "Venez apprécier la cuisine de Djamila au cœur du village.\r\nLe café restaurant Chez l'Hôte élabore une cuisine familiale avec des plats traditionnels français à base de produits frais et locaux."
    ],
    "es": [
      "Venga a disfrutar de la cocina de Djamila en el corazón del pueblo.\r\nEl café restaurante Chez l'Hôte ofrece una cocina familiar con platos tradicionales franceses elaborados con productos frescos de la zona."
    ],
    "nl": [
      "Kom genieten van de keuken van Djamila in het hart van het dorp.\r\nHet café-restaurant Chez l'Hôte biedt een familiekeuken met traditionele Franse gerechten op basis van verse streekproducten."
    ]
  },
