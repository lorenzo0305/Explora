  "rdfs:comment": {
    "de": [
      "Die Compagnie des Canotiers bietet vom Frühjahr bis zum Herbst zu regelmäßigen Terminen Fahrten mit einem Elektro-Solarboot auf der Rhône an, aber auch Privatisierungen für Gruppen."
    ],
    "en": [
      "The Compagnie des Canotiers offers electro-solar boat trips on the Rhône from spring to autumn on regular dates, as well as private tours for groups."
    ],
    "it": [
      "La Compagnie des Canotiers offre gite in barca elettrosolare sul Rodano dalla primavera all'autunno in date regolari, oltre a tour privati per gruppi."
    ],
    "fr": [
      "La Compagnie des Canotiers propose des promenades en bateau électro-solaire sur le Rhône du printemps à l'automne à des dates régulières mais aussi en privatisation pour les groupes."
    ],
    "es": [
      "La Compagnie des Canotiers ofrece paseos en barco eléctrico por el Ródano de primavera a otoño en fechas regulares, así como excursiones privadas para grupos."
    ],
    "nl": [
      "De Compagnie des Canotiers biedt van de lente tot de herfst op regelmatige data elektrische boottochten op de Rhône en privétochten voor groepen."
    ]
  },
