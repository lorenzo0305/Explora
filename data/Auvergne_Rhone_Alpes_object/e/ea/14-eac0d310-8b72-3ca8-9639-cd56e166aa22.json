  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1748943e-9cd2-3983-ad76-486ed6c2f433",
      "dc:description": {
        "de": [
          "Val-Opale-Car ist eine Firma, die Luxusautos sowie Motorräder zur Vermietung anbietet.\nSie bietet Tages-, Wochenend-, Wochen- oder sogar Monatsmieten an."
        ],
        "en": [
          "Val-Opale-Car is a company that rents luxury cars and motorcycles.\nWe offer daily, weekend, weekly and even monthly rentals."
        ],
        "it": [
          "Val-Opale-Car è una società che offre auto e moto di lusso a noleggio.\nOffre noleggi giornalieri, nel fine settimana, settimanali e persino mensili."
        ],
        "fr": [
          "Val-Opale-Car est une entreprise qui propose à la location des voitures de luxe ainsi que des motos.\nElle propose des locations à la journée, au week-end, à la semaine ou même au mois."
        ],
        "nl": [
          "Val-Opale-Car is een bedrijf dat luxe auto's en motoren te huur aanbiedt.\nJe kunt er dagelijks, in het weekend, wekelijks en zelfs maandelijks huren."
        ],
        "es": [
          "Val-Opale-Car es una empresa que ofrece coches y motos de lujo de alquiler.\nOfrece alquileres diarios, de fin de semana, semanales e incluso mensuales."
        ]
      },
