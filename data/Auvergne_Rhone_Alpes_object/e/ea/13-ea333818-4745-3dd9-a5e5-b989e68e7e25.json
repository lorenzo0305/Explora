  "rdfs:comment": {
    "de": [
      "Anspruchsvolle Skitourenroute, Ausgangspunkt Maison du Grand Veymont, mit einem gemeinsamen Aufstiegsbeginn mit Route 4 (Bois de la Bourelle) bis zum Sektor Pierre Blanche und einer anschließenden Abfahrt über rote Pisten."
    ],
    "en": [
      "Difficult itinerary of ski touring, departure from the Grand Veymont house, with a beginning of ascent common to the course 4 (Bois de la Bourelle) up to the Pierre Blanche sector then a descent by red slopes."
    ],
    "it": [
      "Un itinerario scialpinistico difficile, con partenza dalla casa Grand Veymont, con un inizio di salita comune all'itinerario 4 (Bois de la Bourelle) fino al settore Pierre Blanche e poi una discesa su piste rosse."
    ],
    "fr": [
      "Itinéraire difficile de ski de randonnée, départ maison du Grand Veymont, avec un début de montée commun au parcours 4 (Bois de la Bourelle) jusqu'au secteur de Pierre Blanche puis une descente par des pistes rouges."
    ],
    "es": [
      "Un itinerario de esquí de travesía difícil, partiendo de la casa Grand Veymont, con un inicio de ascenso común a la ruta 4 (Bois de la Bourelle) hasta el sector de Pierre Blanche y luego un descenso por pistas rojas."
    ],
    "nl": [
      "Een moeilijke skitocht, die begint bij het huis van Grand Veymont, met een begin van de gebruikelijke beklimming van route 4 (Bois de la Bourelle) tot aan de sector Pierre Blanche en vervolgens een afdaling op rode pistes."
    ]
  },
  "rdfs:label": {
