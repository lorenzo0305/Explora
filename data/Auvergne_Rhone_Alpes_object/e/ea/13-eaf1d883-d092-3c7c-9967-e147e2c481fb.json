  "rdfs:comment": {
    "de": [
      "Fördern Sie die Behindertensportler bei der Qualifikation für die französischen Meisterschaften im Behindertenschwimmen im großen Becken!"
    ],
    "en": [
      "Come and cheer on the disabled sportsmen and women as they qualify for the French national championships for disabled swimming in the deep end of the pool!"
    ],
    "it": [
      "Venite a fare il tifo per gli atleti disabili che si qualificano per i campionati francesi di nuoto per disabili nella parte profonda della piscina!"
    ],
    "fr": [
      "Venez encourager les handi-sportifs à l’occasion des qualifications pour les championnats de France natation handisport en grand bassin !"
    ],
    "es": [
      "Venga a animar a los atletas discapacitados que se clasifican para los Campeonatos de Francia de Natación para Discapacitados en la parte más profunda de la piscina"
    ],
    "nl": [
      "Kom de gehandicapte atleten aanmoedigen terwijl ze zich kwalificeren voor de Franse kampioenschappen zwemmen voor gehandicapten in het diepe gedeelte van het zwembad!"
    ]
  },
