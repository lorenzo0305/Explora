  "rdfs:comment": {
    "de": [
      "Der Lac Cornu ist ein Bergsee, der sich zwischen der Bergstation der Seilbahn Index und Planpraz befindet. Er liegt direkt neben den Lacs Noirs."
    ],
    "en": [
      "Lac Cornu is a mountain lake located between the summit of the Index chairlift and Planpraz. The neighbouring Lacs Noirs are just ten minutes away."
    ],
    "it": [
      "Il Lac Cornu è un lago di alta quota che si trova tra la cima della funivia dell'Index e Planpraz, vicino ai Lacs Noirs."
    ],
    "fr": [
      "Le Lac Cornu est un lac d’altitude située entre le Sommet du Télésiège de l’Index et Planpraz. Il est le voisin direct des Lacs Noirs."
    ],
    "nl": [
      "Lac Cornu is een hoog gelegen meer tussen de top van de Index stoeltjeslift en Planpraz. Het is de directe buur van de Lacs Noirs."
    ],
    "es": [
      "El Lac Cornu es un lago de montaña situado entre la cima del telesilla de Index y Planpraz, a poca distancia de los lagos Noirs."
    ]
  },
