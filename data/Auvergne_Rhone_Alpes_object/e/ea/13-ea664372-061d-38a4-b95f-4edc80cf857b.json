  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren mitten in der Stadt gegenüber der Markthalle von Saint-Etienne bietet Ihnen das Restaurant L'Escargot d'Or in einer gemütlichen Umgebung eine qualitativ hochwertige klassische Küche und angenehmen, freundlichen Service."
    ],
    "en": [
      "The Escargot d'Or (Golden Snail) restaurant, in the centre of town opposite Saint-Etienne's indoor market, offers high class traditional cuisine served with a smile, in a friendly, welcoming atmosphere."
    ],
    "it": [
      "L'Escargot d'Or è un ristorante di 37 anni situato nel cuore della città, di fronte al mercato coperto di Saint-Étienne, che offre una cucina tradizionale e di qualità, un servizio piacevole e cordiale e un'atmosfera accogliente."
    ],
    "fr": [
      "Depuis 37 ans, situé en plein centre-ville en face des halles de Saint-Étienne , le restaurant L'Escargot d'Or vous propose une cuisine traditionnelle de qualité, un service agréable et souriant dans un cadre chaleureux."
    ],
    "nl": [
      "L'Escargot d'Or is een 37 jaar oud restaurant in het hart van het stadscentrum, tegenover de overdekte markt van Saint-Étienne. Het biedt een traditionele keuken van hoge kwaliteit, een aangename, vriendelijke bediening en een warme sfeer."
    ],
    "es": [
      "L'Escargot d'Or es un restaurante de 37 años de antigüedad situado en pleno centro de la ciudad, frente al mercado cubierto de Saint-Étienne. Ofrece una cocina tradicional de calidad, un servicio agradable y cordial y un ambiente cálido."
    ]
  },
