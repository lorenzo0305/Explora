  "rdfs:comment": {
    "de": [
      "Ein authentisches Restaurant mit viel Charme.\r\nEntdecken Sie die traditionelle französische Küche im Chez Ghislaine neu. Sie werden Freude daran haben, die großen Klassiker zu genießen, denen wir unsere persönliche Note verleihen."
    ],
    "en": [
      "An authentic pretty restaurant.\r\nDiscover traditional french cooking. Enjoy the savour of french classic with the Ghislaine touch."
    ],
    "it": [
      "Un autentico ristorant con un charisma pazzo.\r\nRiscoprite la cucina tradizionale francese \"Chez Ghislaine\". Prendere piacere a gustare i grandi classichi a quali aggiunggiamo la nostra tosca personale."
    ],
    "fr": [
      "Un authentique restaurant au charme fou.\r\nRedécouvrez la cuisine traditionnelle française Chez Ghislaine. Vous prendrez plaisir à savourer les grands classiques auxquels nous ajoutons notre touche personnelle."
    ],
    "es": [
      "Un restaurante auténtico y encantador.\r\nRedescubra la cocina francesa tradicional en Chez Ghislaine. Disfrutará saboreando los grandes clásicos a los que añadimos nuestro toque personal."
    ],
    "nl": [
      "Een rustiek restaurant om de traditionele Franse keuken te ontdekken. Hier kan je genieten van de grote klassiekers met een persoonlijke nota van de chef."
    ]
  },
