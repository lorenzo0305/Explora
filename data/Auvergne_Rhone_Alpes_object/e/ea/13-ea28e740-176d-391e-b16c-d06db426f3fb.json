  "rdfs:comment": {
    "de": [
      "Saint-Arcons-d?Allier: Hoch gelegenes Dorf. Alte Mühle am Fluss Fioule. Kirche aus dem 14. bis 15. Jahrhundert. Ehemaliges Priorat, Turm aus dem 15. Jahrhundert, schmiedeeisernes Kreuz, Gärten und Terrassen."
    ],
    "en": [
      "Saint-Arcons-d?Allier : Perched village. Old mill on the Fioule. 14th-15th-century church. Former priory, 15th-century tower, wrought-iron cross, gardens and terraces."
    ],
    "it": [
      "Saint-Arcons-d'Allier: villaggio arroccato. Antico mulino sulla Fioule. Chiesa del XIV-XV secolo. Ex priorato, torre del XV secolo, croce in ferro battuto, giardini e terrazze."
    ],
    "fr": [
      "Saint-Arcons-d’Allier : Village perché. Vieux moulin sur la Fioule. Église des XIVe-XVe siècles. Ancien prieuré, tour du XVe siècle, croix en fer forgé, jardins et terrasses."
    ],
    "nl": [
      "Saint-Arcons-d?Allier : Hooggelegen dorp. Oude molen aan de Fioule. 14e-15e eeuwse kerk. Voormalige priorij, toren uit de 15e eeuw, smeedijzeren kruis, tuinen en terrassen."
    ],
    "es": [
      "Saint-Arcons-d'Allier : Pueblo encaramado. Antiguo molino en la Fioule. Iglesia de los siglos XIV-XV. Antiguo priorato, torre del siglo XV, cruz de hierro forjado, jardines y terrazas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Saint-Arcons-d'Allier"
    ]
  },
