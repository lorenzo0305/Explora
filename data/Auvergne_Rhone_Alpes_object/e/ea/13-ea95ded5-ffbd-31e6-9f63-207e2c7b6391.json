  "rdfs:comment": {
    "de": [
      "Charmanter Weinkeller für Weine, Spirituosen und Spirituosen aller Art. Sorgfältige Auswahl rund um Handwerker, die darauf bedacht sind, erstaunliche, einzigartige und umweltfreundliche Weine zusammenzustellen."
    ],
    "en": [
      "Charming cellar for wines, alcohols and spirits of all kinds. Carefully selected by artisans dedicated to concocting surprising, unique and environmentally-friendly wines."
    ],
    "it": [
      "Incantevole cantina di vini, liquori e distillati di ogni genere. Un'attenta selezione di artigiani che si occupano di creare vini sorprendenti, unici e rispettosi dell'ambiente."
    ],
    "fr": [
      "Charmante cave à vins, alcools et spiritueux en tout genre. Sélection minutieuse autour d'artisans soucieux de concocter des vins étonnants, uniques et respectueux de l'environnement."
    ],
    "es": [
      "Encantadora bodega de vinos, licores y todo tipo de bebidas alcohólicas. Una cuidadosa selección en torno a artesanos preocupados por elaborar vinos sorprendentes, únicos y respetuosos con el medio ambiente."
    ],
    "nl": [
      "Charmante wijnkelder. Zorgvuldig geselecteerd door ambachtslieden die zich inzetten om verrassende, unieke en milieuvriendelijke wijnen te maken."
    ]
  },
  "rdfs:label": {
    "de": [
