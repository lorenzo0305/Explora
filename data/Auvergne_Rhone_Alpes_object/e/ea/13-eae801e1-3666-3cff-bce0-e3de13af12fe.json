  "rdfs:comment": {
    "de": [
      "Choeur Adhémar ist ein vierstimmiger gemischter Chor mit 45 bis 50 Sängerinnen und Sängern, der ein überwiegend klassisches Repertoire a capella oder mit Begleitung von Orchestern oder Instrumentalisten singt."
    ],
    "en": [
      "Choeur Adhémar is a four-voice mixed choir of 45 to 50 singers, performing a mainly classical repertoire a capella or with the accompaniment of orchestras or instrumentalists."
    ],
    "it": [
      "Il Choeur Adhémar è un coro misto a quattro voci, composto da 45-50 cantanti, che esegue un repertorio prevalentemente classico a cappella o con l'accompagnamento di orchestre o strumentisti."
    ],
    "fr": [
      "Choeur Adhémar est un choeur mixte à quatre voix , de 45 à 50 choristes, qui aborde un répertoire essentiellement classique à capella ou avec l'accompagnement d'orchestres ou d'instrumentistes."
    ],
    "es": [
      "El Choeur Adhémar es un coro mixto a cuatro voces de 45 a 50 cantantes, que interpreta un repertorio principalmente clásico a capella o con acompañamiento de orquestas o instrumentistas."
    ],
    "nl": [
      "Choeur Adhémar is een vierstemmig gemengd koor van 45 tot 50 zangers, dat een voornamelijk klassiek repertoire a capella of met begeleiding van orkesten of instrumentalisten uitvoert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert du Choeur Adhémar : \"Grands choeurs d'opéra\""
    ]
  },
