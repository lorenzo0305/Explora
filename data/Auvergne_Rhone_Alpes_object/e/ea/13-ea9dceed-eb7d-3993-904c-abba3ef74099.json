  "rdfs:comment": {
    "de": [
      "François Dupeux, der in ganz Frankreich als Caterer bekannt ist, führt auch sein Restaurant, in dem Gruppen und Familien willkommen sind.\r\nEs besteht die Möglichkeit, vor Ort zu essen oder etwas mitzunehmen."
    ],
    "en": [
      "François Dupeux, whose reputation as a caterer throughout France is well established, also runs his restaurant, where groups and families are welcome.\r\nPossibility to eat in or take away."
    ],
    "it": [
      "François Dupeux, la cui reputazione di ristoratore in tutta la Francia è ben consolidata, gestisce anche il suo ristorante, dove gruppi e famiglie sono i benvenuti.\r\nPossibilità di mangiare in casa o da asporto."
    ],
    "fr": [
      "François Dupeux, dont la réputation comme traiteur partout en France n'est plus à faire, dirige aussi son restaurant, où les groupes et les familles sont les bienvenus.\r\nPossibilité de manger sur place ou à emporter."
    ],
    "nl": [
      "François Dupeux, wiens reputatie als cateraar in heel Frankrijk gevestigd is, runt ook zijn restaurant, waar groepen en families welkom zijn.\r\nMogelijkheid tot eten of afhalen."
    ],
    "es": [
      "François Dupeux, cuya reputación como restaurador en toda Francia está bien consolidada, también dirige su restaurante, donde los grupos y las familias son bienvenidos.\r\nPosibilidad de comer en casa o para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant du Traiteur"
    ]
  },
