  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek von La Souche wird von Freiwilligen betreut. Zögern Sie nicht, uns zu besuchen. Die Bibliothek richtet sich an alle Altersgruppen und bietet eine große Auswahl an Büchern und Medien für Erwachsene und Kinder."
    ],
    "en": [
      "The municipal library in La Souche is run by volunteers. Please feel free to visit us. It is open to everyone and offers a wide selection of books and materials for both adults and children."
    ],
    "it": [
      "La biblioteca comunale di La Souche è gestita da volontari. Saremo lieti di visitarla. È aperta al pubblico e offre un'ampia gamma di libri e media per adulti e bambini."
    ],
    "fr": [
      "La bibliothèque municipale de La Souche est animée par des bénévoles. N’hésitez pas à nous rendre visite. Elle s’adresse à tout public et propose un large choix d'ouvrages et du supports pour les adultes comme pour les enfants."
    ],
    "es": [
      "La biblioteca municipal de La Souche está gestionada por voluntarios. Esperamos su visita. Está abierta al público en general y ofrece una amplia gama de libros y medios de comunicación para adultos y niños."
    ],
    "nl": [
      "De gemeentelijke bibliotheek van La Souche wordt gerund door vrijwilligers. We kijken uit naar je bezoek. De bibliotheek is open voor het grote publiek en biedt een breed scala aan boeken en media voor zowel volwassenen als kinderen."
    ]
  },
