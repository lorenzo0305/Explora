  "rdfs:comment": {
    "de": [
      "Sehr luftige und sportliche Route, die auf allen Ebenen unvergessliche Ausblicke bietet.\r\nInformationen über die Eröffnung des Klettergebiets erhalten Sie beim Fremdenverkehrsamt von Valloire."
    ],
    "en": [
      "Very aerial and sporty course offering memorable points of view at all levels.\r\nInformation on the opening of the climbing site from the Valloire Tourist Office."
    ],
    "it": [
      "Un percorso molto aereo e sportivo che offre panorami memorabili da ogni angolazione.\r\nLe informazioni sull'apertura del sito di arrampicata sono disponibili presso l'Ufficio del Turismo di Valloire."
    ],
    "fr": [
      "Parcours très aérien et sportif offrant des points de vues mémorables à tous les plans.\r\nInformations sur l'ouverture du site d'escalade auprès de l'Office de Tourisme de Valloire."
    ],
    "es": [
      "Una ruta muy aérea y deportiva que ofrece vistas memorables desde todos los ángulos.\r\nEn la Oficina de Turismo de Valloire encontrará información sobre la apertura del rocódromo."
    ],
    "nl": [
      "Een zeer luchtige en sportieve route die vanuit elke hoek onvergetelijke uitzichten biedt.\r\nInformatie over de opening van het klimgebied is verkrijgbaar bij het VVV-kantoor van Valloire."
    ]
  },
