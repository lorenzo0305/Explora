  "rdfs:comment": {
    "de": [
      "Freie Besichtigung der Außenanlagen.\r\nChaugy ist ein Wohnhaus aus der Zeit Ludwigs XIII., das sich perfekt in die Landschaft einfügt und dessen Originalität in dem mächtigen Dach liegt, das sich über die Fassaden aus roten und schwarzen Backsteinen \"erstreckt\". Bemerkenswerter englischer Fluss."
    ],
    "en": [
      "Visit the exterior.\r\nChaugy is a Louis XIII-era dwelling in perfect intimacy with the landscape, whose originality lies in the powerful roof \"extending\" over its red and black brick facades. Remarkable English river."
    ],
    "it": [
      "Visita libera degli esterni.\r\nChaugy è una dimora del periodo Luigi XIII in perfetta armonia con il paesaggio, la cui originalità risiede nel potente tetto che si \"estende\" sulle facciate in mattoni rossi e neri. Notevole fiume inglese."
    ],
    "fr": [
      "Visite libre des extérieurs.\r\nChaugy est une habitation d'époque Louis XIII en parfaite intimité avec le paysage et dont l'originalité réside dans la puissante toiture \"qui s'étend\" sur ses façades de briques rouges et noires. Remarquable rivière anglaise."
    ],
    "nl": [
      "Vrij bezoek aan de buitenkant.\r\nChaugy is een woning uit de Lodewijk XIII-periode in perfecte harmonie met het landschap, waarvan de originaliteit ligt in het krachtige dak dat \"uitsteekt\" over de rode en zwarte bakstenen gevels. Opmerkelijke Engelse rivier."
    ],
    "es": [
      "Visita libre del exterior.\r\nChaugy es una vivienda de la época de Luis XIII en perfecta armonía con el paisaje, cuya originalidad reside en el poderoso tejado que se \"extiende\" sobre sus fachadas de ladrillo rojo y negro. Notable río inglés."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de Chaugy"
    ]
  },
