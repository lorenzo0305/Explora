  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8966c729-8067-3d09-ba12-c2fefd27e8f7",
      "dc:description": {
        "de": [
          "Sammeln Sie bei einem Spaziergang durch den Park Details über die beobachtete Landschaft und die Elemente, aus denen sie besteht.\nErstellen Sie mit Ihren Skizzen im Atelier eine imaginäre Landschaft!"
        ],
        "en": [
          "As you stroll through the park, glean details of the landscape you've observed and the elements that make it up.\nUsing your sketches, create an imaginary landscape in the workshop!"
        ],
        "it": [
          "Mentre passeggiate nel parco, raccogliete i dettagli del paesaggio che avete osservato e gli elementi che lo compongono.\nUtilizzando i vostri schizzi, ricreate un paesaggio immaginario in laboratorio!"
        ],
        "fr": [
          "A l'occasion d'une balade dans le parc, glanez des détails du paysage observé et des éléments qui le composent.\nRiche de vos croquis, recomposez un paysage imaginaire en atelier !"
        ],
        "nl": [
          "Wandel door het park en verzamel details over het landschap dat je hebt gezien en de elementen waaruit het bestaat.\nMaak met je schetsen een denkbeeldig landschap in de workshop!"
        ],
        "es": [
          "Pasea por el parque y recoge detalles del paisaje que has visto y de los elementos que lo componen.\nCon tus bocetos, recrea un paisaje imaginario en el taller"
        ]
      },
      "@type": [
