  "rdfs:comment": {
    "de": [
      "Das Projekt Rési?Danse kehrt für eine neue Ausgabe voller Energie und Kreativität ins Théâtre de Cusset zurück! Vom 9. bis 13. März 2026 werden Jugendliche des Albert-Londoner Gymnasiums und der Institution Saint-Joseph mit der Kompanie Arcosm zusammenarbeiten."
    ],
    "en": [
      "The Rési?Danse project returns to the Théâtre de Cusset for a new edition full of energy and creativity! From March 9 to 13, 2026, young people from the Lycée Albert-Londres and the Institution Saint-Joseph will be working with the Arcosm company."
    ],
    "it": [
      "Il progetto Rési?Danse torna al Théâtre de Cusset per una nuova edizione piena di energia e creatività! Dal 9 al 13 marzo 2026, i giovani del Lycée Albert-Londres e dell'Institution Saint-Joseph lavoreranno con la compagnia Arcosm."
    ],
    "fr": [
      "Le projet Rési’Danse revient au Théâtre de Cusset pour une nouvelle édition pleine d’énergie et de créativité ! Du 9 au 13 mars 2026, les jeunes du lycée Albert-Londres et de l’Institution Saint-Joseph travailleront avec la compagnie Arcosm."
    ],
    "nl": [
      "Het project Rési?Danse keert terug naar het Théâtre de Cusset voor een nieuwe editie vol energie en creativiteit! Van 9 tot 13 maart 2026 zullen jongeren van het Lycée Albert-Londres en het Institut Saint-Joseph samenwerken met het gezelschap Arcosm."
    ],
    "es": [
      "El proyecto Rési?Danse vuelve al Théâtre de Cusset para una nueva edición llena de energía y creatividad Del 9 al 13 de marzo de 2026, jóvenes del Lycée Albert-Londres y de la Institution Saint-Joseph trabajarán con la compañía Arcosm."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rési'Danse #7 • Restitution"
    ]
  },
