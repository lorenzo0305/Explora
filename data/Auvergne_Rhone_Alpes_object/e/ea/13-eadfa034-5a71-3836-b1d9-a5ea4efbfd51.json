  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen eine große Auswahl an Jugend- und Erwachsenenbüchern, englischsprachigen Büchern sowie zweisprachigen Büchern (Spanisch, Englisch, Portugiesisch, Russisch, Deutsch), Spielen, Zeitschriften, CDs, Romanen, lokalem Hintergrund?"
    ],
    "en": [
      "The library offers you a wide choice of children's and adult books, books in English as well as bilingual books (Spanish, English, Portuguese, Russian, German), games, magazines, CDs, read novels, local backgrounds, etc."
    ],
    "it": [
      "La biblioteca offre un'ampia gamma di libri per giovani e adulti, libri in inglese e bilingue (spagnolo, inglese, portoghese, russo, tedesco), giochi, riviste, CD, romanzi, risorse locali, ecc"
    ],
    "fr": [
      "La bibliothèque vous propose un large choix de livres jeunesse et adulte, livres en anglais ainsi que des livres bilingues (espagnol, anglais, portugais, russe, allemand), des jeux, magazines, CD, roman lu, fond local…"
    ],
    "es": [
      "La biblioteca ofrece una amplia gama de libros para jóvenes y adultos, libros en inglés y bilingües (español, inglés, portugués, ruso, alemán), juegos, revistas, CD, novelas, recursos locales, etc"
    ],
    "nl": [
      "De bibliotheek biedt een breed scala aan boeken voor jongeren en volwassenen, boeken in het Engels en tweetalige boeken (Spaans, Engels, Portugees, Russisch, Duits), spelletjes, tijdschriften, cd's, romans, lokale bronnen, enz."
    ]
  },
