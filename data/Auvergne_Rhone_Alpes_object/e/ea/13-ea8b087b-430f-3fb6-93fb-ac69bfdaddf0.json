  "rdfs:comment": {
    "de": [
      "Pierrot und Philippe von Fabrique Aventure sind Experten für Aktivitäten in der Natur. Wir sind da, um Ihnen maßgeschneiderte und sichere Routen zu erstellen, sei es für eine Privatperson oder eine Gruppe von Freunden, ganz nach Ihren Vorstellungen."
    ],
    "en": [
      "At Lioran for over 25 years, Philippe and Pierrot from Fabrique Aventure, mountain guides, meet you every day at the wooden hut near the Lioran tourist office and cable car."
    ],
    "it": [
      "Pierrot e Philippe di Fabrique Aventure, esperti di attività all'aria aperta. Saremo lieti di elaborare per voi itinerari sicuri e su misura, sia privatamente che con un gruppo di amici, a seconda delle vostre esigenze."
    ],
    "fr": [
      "Pierrot et Philippe de Fabrique Aventure, experts d’activités pleine nature. Nous sommes là pour vous élaborer des itinéraires sur mesure et en toute sécurité, que ce soit en privatif ou pour un groupe d’amis, suivant vos attentes."
    ],
    "es": [
      "Pierrot y Philippe de Fabrique Aventure, expertos en actividades al aire libre. Estaremos encantados de diseñar para ti itinerarios seguros y a medida, en privado o con un grupo de amigos, en función de tus necesidades."
    ],
    "nl": [
      "Pierrot en Philippe van Fabrique Aventure, experts in outdoor activiteiten. We stellen graag veilige routes op maat voor je samen, privé of met een groep vrienden, afhankelijk van je wensen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fabrique Aventures"
    ],
    "fr": [
      "Accompagnateurs en raquette de Fabrique Aventures"
    ]
  },
