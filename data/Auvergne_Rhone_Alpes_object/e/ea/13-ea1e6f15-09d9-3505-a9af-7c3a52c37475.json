  "rdfs:comment": {
    "de": [
      "Das City-Stadion wird von der Gemeinde verwaltet.\r\nEs ist für alle zugänglich.\r\nVorschriften werden vor Ort ausgehängt, wobei die Verwendung von Lederbällen verboten ist."
    ],
    "en": [
      "The city stadium is managed by the commune.\r\nIt is open to all.\r\nRules are posted on site, with a ban on the use of leather balls."
    ],
    "it": [
      "Lo stadio cittadino è gestito dal Comune.\r\nÈ aperto a tutti.\r\nLe regole sono affisse in loco e l'uso di palloni di cuoio è vietato."
    ],
    "fr": [
      "Le city stade est géré par la commune.\r\nIl est ouvert à tous.\r\nRéglementation affichée sur place, avec interdiction d'utiliser des ballons en cuir."
    ],
    "nl": [
      "Het stadsstadion wordt beheerd door de gemeente.\r\nHet is voor iedereen toegankelijk.\r\nDe regels staan ter plaatse aangegeven, met een verbod op het gebruik van leren ballen."
    ],
    "es": [
      "El estadio municipal está gestionado por el ayuntamiento.\r\nEstá abierto a todos.\r\nLas normas están expuestas in situ, y está prohibido el uso de balones de cuero."
    ]
  },
