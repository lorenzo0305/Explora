  "rdfs:comment": {
    "de": [
      "Wir bieten eine traditionelle und familiäre Küche in einer einfachen und freundlichen Umgebung wie zu Hause. Wir freuen uns, Sie auch zu einem Erfrischungsgetränk oder einem Eis begrüßen zu dürfen."
    ],
    "en": [
      "We offer traditional, family-style cuisine in a simple, friendly, and home-style setting. We would also be delighted to welcome you for a drink or an ice cream."
    ],
    "it": [
      "Proponiamo una cucina tradizionale e famigliale in un posto come a casa : semplice e piacevole. Saremo felici di accogliervi  anche per una bevuta o mangiare un gelato."
    ],
    "fr": [
      "Nous proposons une cuisine traditionnelle et familiale dans un cadre comme à la maison simple et convivial. Nous serons ravis de vous accueillir aussi pour vous désaltérer ou manger une glace."
    ],
    "nl": [
      "We bieden een traditionele, familiale keuken in een eenvoudige, vriendelijke omgeving. We verwelkomen je graag voor een drankje of een ijsje."
    ],
    "es": [
      "Ofrecemos una cocina tradicional y familiar en un ambiente sencillo y acogedor. Estaremos encantados de recibirle para tomar una copa o un helado."
    ]
  },
