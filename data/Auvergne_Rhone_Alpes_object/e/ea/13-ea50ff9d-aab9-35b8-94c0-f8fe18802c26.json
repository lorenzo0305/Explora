  "rdfs:comment": {
    "de": [
      "Café-Restaurant in einem Mittelgebirge, das als Genossenschaft organisiert ist.\r\nWir bevorzugen Direktvermarkter und unsere Küche ist hausgemacht, saisonal und zum Teil biologisch."
    ],
    "en": [
      "Mid-mountain café-restaurant organized as a cooperative.\r\nOur cuisine is homemade, seasonal and partly organic."
    ],
    "it": [
      "Caffè-ristorante di media montagna organizzato come cooperativa.\r\nPrivilegiamo il contatto diretto con i produttori e la nostra cucina è casalinga, stagionale e in parte biologica."
    ],
    "fr": [
      "Café-restaurant de moyenne montagne organisé en coopérative. \r\nNous privilégions le direct-producteurs et notre cuisine est faite maison, de saison et en partie Bio."
    ],
    "es": [
      "Café-restaurante de media montaña organizado como cooperativa.\r\nFavorecemos el contacto directo con los productores y nuestra cocina es casera, de temporada y en parte ecológica."
    ],
    "nl": [
      "Café-restaurant in het midden van de bergen, georganiseerd als coöperatie.\r\nWe geven de voorkeur aan direct contact met producenten en onze keuken is huisgemaakt, seizoensgebonden en deels biologisch."
    ]
  },
