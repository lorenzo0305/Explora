  "rdfs:comment": {
    "de": [
      "ESF Tignes Val Claret: Passionierte Lehrer, ein außergewöhnliches Skigebiet, Kurse für alle Niveaus, eine herzliche Atmosphäre und anerkanntes Know-how, um die Berge intensiv zu erleben."
    ],
    "en": [
      "The ESF ski school in TIGNES has 100 Instructors who are looking forward to welcome you this season. We offer a range of winter sports and fun activities for all the family."
    ],
    "it": [
      "ESF Tignes Val Claret: istruttori appassionati, un comprensorio sciistico eccezionale, lezioni adatte a tutti i livelli, un'atmosfera calorosa e un'esperienza riconosciuta per un'intensa esperienza in montagna."
    ],
    "fr": [
      "ESF Tignes Val Claret : des moniteurs passionnés, un domaine skiable d’exception, cours adaptés à tous niveaux, ambiance chaleureuse et savoir-faire reconnu pour vivre la montagne intensément."
    ],
    "es": [
      "ESF Tignes Val Claret: monitores apasionados, un dominio esquiable excepcional, clases adaptadas a todos los niveles, un ambiente cálido y una experiencia reconocida para vivir intensamente la montaña."
    ],
    "nl": [
      "ESF Tignes Val Claret: gepassioneerde instructeurs, een uitzonderlijk skigebied, lessen aangepast aan alle niveaus, een warme sfeer en erkende expertise voor een intense bergervaring."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Esf Tignes val Claret"
