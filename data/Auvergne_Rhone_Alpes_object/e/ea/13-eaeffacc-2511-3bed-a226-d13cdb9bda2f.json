  "rdfs:comment": {
    "de": [
      "Spannende Entdeckungen anhand von Dokumenten, historischen Kostümen und Gegenständen aus vergangenen Zeiten, die die Geschichte von Bellevaux von damals und heute erzählen."
    ],
    "en": [
      "Fascinating insight into the history of Bellevaux, from times past to the present day, with a collection of documents, period costumes and old objects."
    ],
    "it": [
      "Documenti, costumi d'epoca e oggetti antichi che raccontano la storia di Bellevaux."
    ],
    "fr": [
      "Des découvertes passionnantes à travers des documents, des costumes d'époque et objets d'autrefois qui relatent l'histoire de Bellevaux d'hier et d'aujourd'hui."
    ],
    "nl": [
      "Spannende ontdekkingen aan de hand van documenten, historische kostuums en voorwerpen van vroeger die het verhaal vertellen van het vroegere en huidige Bellevaux."
    ],
    "es": [
      "Emocionantes descubrimientos a través de documentos, trajes de época y objetos del pasado que cuentan la historia de Bellevaux ayer y hoy."
    ]
  },
