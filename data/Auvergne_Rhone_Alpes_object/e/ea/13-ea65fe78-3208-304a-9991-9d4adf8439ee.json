  "rdfs:comment": {
    "de": [
      "Im Dienste aller trägt der soziokulturelle Raum zur Organisation von Freizeit-, Sport- und Kulturaktivitäten für Kinder, Jugendliche, Erwachsene, Familien und Bewohner des Einzugsgebiets von Montalieu ? Vercieu."
    ],
    "en": [
      "At the service of all, the socio-cultural center helps organize leisure, sports and cultural activities for children, young people, adults, families and residents of the Montalieu? Vercieu area."
    ],
    "it": [
      "Al servizio di tutti, il centro socio-culturale aiuta a organizzare attività ricreative, sportive e culturali per bambini, giovani, adulti, famiglie e residenti del Montalieu? Vercieu."
    ],
    "fr": [
      "Au service de tous, l'espace socio-culturel contribue à l'organisation d'activités de loisirs, sportifs et culturels à destination des enfants, jeunes, adultes, familles, habitants du bassin de vie de Montalieu – Vercieu."
    ],
    "nl": [
      "Het sociaal-cultureel centrum staat ten dienste van iedereen en organiseert vrijetijds-, sportieve en culturele activiteiten voor kinderen, jongeren, volwassenen, gezinnen en bewoners van de Montalieu? Vercieu."
    ],
    "es": [
      "Al servicio de todos, el centro sociocultural contribuye a organizar actividades lúdicas, deportivas y culturales para niños, jóvenes, adultos, familias y residentes del Montalieu? Vercieu."
    ]
  },
