  "rdfs:comment": {
    "de": [
      "Die Grande Traversée du Jura gravel, das kleinste Glied in der langen Liste der Wandermöglichkeiten, ermöglicht es, das Juramassiv auf fast 400 km und in 3 Departements zu entdecken."
    ],
    "en": [
      "This gravel adventure invites you to discover the Jura Massif over nearly 400 km from North to South!"
    ],
    "it": [
      "La Grande Traversée du Jura, l'ultima di una lunga serie di opzioni di itinerario, copre quasi 400 km del Massiccio del Giura in 3 dipartimenti."
    ],
    "fr": [
      "La Grande Traversée du Jura gravel, petite dernière de la longue liste des possibilités d'itinérance permet de découvrir le Massif Jurassien sur près de 400 km et 3 départements."
    ],
    "es": [
      "La Grande Traversée du Jura, la última de una larga lista de itinerarios, recorre casi 400 km del macizo del Jura en 3 departamentos."
    ],
    "nl": [
      "De Grande Traversée du Jura grindroute, de laatste in een lange lijst van routeopties, beslaat bijna 400 km van het Jura Massief in 3 departementen."
    ]
  },
  "rdfs:label": {
