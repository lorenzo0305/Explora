  "rdfs:comment": {
    "de": [
      "Im Herzen von Voreppe bietet L'Arrosoir Geschäftsleuten flexible Räumlichkeiten für Meetings, Seminare und Firmenveranstaltungen in einem funktionellen und freundlichen Rahmen, der den Austausch und die Arbeit fördert."
    ],
    "en": [
      "In the heart of Voreppe, l'Arrosoir offers professionals modular spaces for meetings, seminars and corporate events, in a functional and convivial setting conducive to exchanges and work."
    ],
    "it": [
      "Nel cuore di Voreppe, l'Arrosoir offre ai professionisti spazi modulari per riunioni, seminari ed eventi aziendali, in un ambiente funzionale e accogliente che favorisce gli scambi e il lavoro."
    ],
    "fr": [
      "Au cœur de Voreppe, l’Arrosoir propose aux professionnels des espaces modulables pour réunions, séminaires et événements d’entreprise, dans un cadre fonctionnel et convivial, propice aux échanges et au travail."
    ],
    "nl": [
      "In het hart van Voreppe biedt l'Arrosoir professionals modulaire ruimtes voor vergaderingen, seminars en bedrijfsevenementen, in een functionele en vriendelijke omgeving die bevorderlijk is voor uitwisselingen en werk."
    ],
    "es": [
      "En el corazón de Voreppe, l'Arrosoir ofrece a los profesionales espacios modulables para reuniones, seminarios y actos de empresa, en un marco funcional y acogedor propicio para los intercambios y el trabajo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Arrosoir"
    ]
  },
