  "rdfs:comment": {
    "de": [
      "Dieses Interpretationszentrum zeigt Ihnen anhand seiner Szenografie alle Geheimnisse der Wasserkraft und ihrer Geschichte, die das Tal von Bozel geprägt haben."
    ],
    "en": [
      "This interpretation centre, with its scenography, lets you discover all the secrets of hydroelectricity and its history, which have left their mark on the Bozel valley."
    ],
    "it": [
      "Questo centro di interpretazione, con la sua scenografia, permette di scoprire tutti i segreti dell'energia idroelettrica e della sua storia, che hanno lasciato il segno nella valle di Bozel."
    ],
    "fr": [
      "Ce centre d'interprétation, à travers sa scénographie, vous fait découvrir tous les secrets de l’hydroélectricité et de son histoire, qui ont marqué la vallée de Bozel."
    ],
    "nl": [
      "In dit interpretatiecentrum met zijn scenografie kun je alle geheimen van de waterkracht en zijn geschiedenis ontdekken, die hun stempel hebben gedrukt op de Bozelvallei."
    ],
    "es": [
      "Este centro de interpretación, con su escenografía, permite descubrir todos los secretos de la hidroelectricidad y su historia, que han dejado su huella en el valle de Bozel."
    ]
  },
