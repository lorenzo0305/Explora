  "rdfs:comment": {
    "de": [
      "Seit mehr als 50 Jahren bietet Ihnen die Galerie Fert am Ende eines Gartens am malerischen Place des Arcades eine große Auswahl an Gemälden, Aquarellen, Zeichnungen, Drucken, Kunstgegenständen, Antiquitäten, alten Büchern und Autographenbriefen."
    ],
    "en": [
      "Fert's Gallery was created 50 years ago and ever since it welcomes you on Place des Arcades, in the back of a garden. You will find a large choice of paintings, art objects, antiquities, ancient books and autographs."
    ],
    "it": [
      "Da oltre 50 anni, in fondo a un giardino nella pittoresca Place des Arcades, la Galerie Fert offre un'ampia gamma di dipinti, acquerelli, disegni, incisioni, oggetti d'arte, oggetti d'antiquariato, libri antichi e lettere autografe."
    ],
    "fr": [
      "Depuis plus de 50 ans, au fond d'un jardin de la pittoresque place des Arcades, la Galerie Fert vous propose un vaste choix de tableaux, aquarelles, dessins, gravures, objets d'art, antiquités, livres anciens et lettres autographes."
    ],
    "nl": [
      "Sinds meer dan 50 jaar, op een originele lokatie, aan het eind van een tuin van het schilderachtige place des Arcades, de Galerie Fert biedt u ruime keus aan schilderijen, kunstobjecten en antiek, oude boeken en handgeschreven teksten."
    ],
    "es": [
      "Desde hace más de 50 años, en el fondo de un jardín de la pintoresca Place des Arcades, la Galerie Fert ofrece una amplia gama de pinturas, acuarelas, dibujos, grabados, objetos de arte, antigüedades, libros antiguos y cartas autógrafas."
    ]
  },
