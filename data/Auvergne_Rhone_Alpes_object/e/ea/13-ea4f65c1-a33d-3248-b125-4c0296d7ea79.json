  "rdfs:comment": {
    "de": [
      "Erstellung und Druck aller Dokumente auf allen Medien, von der Visitenkarte bis zum großformatigen Poster. Dankeskarten, Ankündigungen, Faltblätter, Broschüren, Mappen, Bücher, Poster, Plakate, Rollups, Schilder etc."
    ],
    "en": [
      "Creation and printing of all documents from business card to big size poster. Thank you note, flyer, leaflet, book, poster, rollup, boards etc..."
    ],
    "it": [
      "Creazione e stampa di tutti i documenti su tutti i supporti, dai biglietti da visita ai poster di grande formato. Biglietti di ringraziamento, annunci, opuscoli, cartelle, libri, poster, rollup, cartelli, ecc."
    ],
    "fr": [
      "Création et impression de tous documents sur tous supports, de la carte de visite au poster grand format. Carte de remerciement, faire-part, dépliant, brochure, dossier, livre, poster, affiche, rollup, panneau etc..."
    ],
    "es": [
      "Creación e impresión de todos los documentos en todos los soportes, desde tarjetas de visita hasta carteles de gran formato. Tarjetas de agradecimiento, anuncios, folletos, carpetas, libros, carteles, rollups, letreros, etc."
    ],
    "nl": [
      "Aanmaken en afdrukken van alle documenten op alle media, van visitekaartjes tot groot formaat posters. Bedankkaarten, aankondigingen, brochures, folders, boeken, posters, rollups, borden, enz."
    ]
