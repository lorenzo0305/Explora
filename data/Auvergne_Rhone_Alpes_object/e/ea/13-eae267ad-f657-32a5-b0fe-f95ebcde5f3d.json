  "rdfs:comment": {
    "de": [
      "Am Ufer des Lac Chambon empfängt Sie das Hotel und Restaurant Le Grillon im Massif du Sancy, im Herzen des Parc des Volcans d'Auvergne."
    ],
    "en": [
      "On the shores of the Lac Chambon, the hotel restaurant Le Grillon welcomes you in the Massif du Sancy, in the heart of the Parc des Volcans d'Auvergne."
    ],
    "it": [
      "Sulle rive del lago Chambon, l'hotel ristorante Le Grillon vi accoglie nel Massiccio del Sancy, nel cuore del Parc des Volcans d'Auvergne."
    ],
    "fr": [
      "Sur les bords du Lac Chambon, l'hôtel restaurant Le Grillon vous accueille dans le Massif du Sancy, au cœur du Parc des Volcans d'Auvergne."
    ],
    "nl": [
      "Aan de oevers van het meer van Chambon heet het hotel-restaurant Le Grillon u welkom in het Massif du Sancy, in het hart van het Parc des Volcans d'Auvergne."
    ],
    "es": [
      "A orillas del lago Chambon, el hotel restaurante Le Grillon le da la bienvenida en el Macizo del Sancy, en el corazón del Parque de los Volcanes de Auvernia."
