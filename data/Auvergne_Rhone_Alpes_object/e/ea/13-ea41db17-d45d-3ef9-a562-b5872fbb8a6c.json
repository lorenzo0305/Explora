  "rdfs:comment": {
    "de": [
      "Eine Oase in einer Schneewüste - das bietet Ihnen das legendäre Restaurant L'Oasis im Herzen unseres Ferienortes Les Arcs 1800. Entdecken und genießen Sie die authentischen Aromen der nordafrikanischen Küche!"
    ],
    "en": [
      "An oasis in a desert of snow—that’s what awaits you at the legendary restaurant L’Oasis, located in the heart of our Les Arcs 1800 resort. Come discover and savor the authentic flavors of Maghreb cuisine !"
    ],
    "it": [
      "Un'oasi nel deserto innevato è ciò che offre il leggendario ristorante L'Oasis nel cuore di Les Arcs 1800. Venite a scoprire i sapori autentici della cucina nordafricana!"
    ],
    "fr": [
      "Une Oasis dans un désert de neige, voici ce que vous propose le mythique restaurant L'Oasis situé au cœur de notre station les Arcs 1800, venez découvrir et déguster les saveurs authentiques de la cuisine du Maghreb !"
    ],
    "es": [
      "Un oasis en un desierto nevado es lo que ofrece el legendario restaurante L'Oasis, en el corazón de Les Arcs 1800. ¡Venga a descubrir los auténticos sabores de la cocina norteafricana!"
    ],
    "nl": [
      "Een oase in een besneeuwde woestijn, dat is wat het legendarische restaurant L'Oasis in het hart van Les Arcs 1800 te bieden heeft. Kom en ontdek de authentieke smaken van de Noord-Afrikaanse keuken!"
    ]
  },
