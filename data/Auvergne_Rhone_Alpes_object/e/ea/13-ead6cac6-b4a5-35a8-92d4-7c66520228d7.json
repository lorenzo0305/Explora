  "rdfs:comment": {
    "de": [
      "Im Herzen der seit über einem Jahrhundert bestehenden Bugiste-Tradition, gegenüber dem großen Brunnen von Terreaux, bietet die Brasserie-Restaurant des Terreaux, die seit 2019 das Label Maître-Restaurateur trägt, Bugiste-Spezialitäten aus lokalen Produkten und Weinen aus dem Bugey."
    ],
    "en": [
      "In the heart of the Bugist tradition for more than a century, facing the large Terreaux fountain, the Terreaux brasserie-restaurant, awarded the Maître-Restaurateur label in 2019, offers Bugist specialities based on local products and Bugey wines."
    ],
    "it": [
      "Nel cuore della tradizione buggiarda da più di un secolo, di fronte alla grande fontana di Terreaux, la brasserie-ristorante Terreaux, insignita del marchio Maître-Restaurateur nel 2019, offre specialità buggiane a base di prodotti locali e vini di Bugey."
    ],
    "fr": [
      "Au cœur de la tradition bugiste depuis plus d’un siècle, face à la grande fontaine des Terreaux, la brasserie-restaurant des Terreaux, labellisée Maître-Restaurateur depuis 2019, propose des spécialités bugistes à base de produits locaux et vins du Bugey."
    ],
    "nl": [
      "In het hart van de Bugistraditie sinds meer dan een eeuw, tegenover de grote fontein van Terreaux, biedt het brasserie-restaurant Terreaux, dat in 2019 het label Maître-Restaurateur kreeg, Bugist-specialiteiten op basis van streekproducten en Bugey-wijnen."
    ],
    "es": [
      "En el corazón de la tradición bugista desde hace más de un siglo, frente a la gran fuente de Terreaux, la brasserie-restaurante Terreaux, galardonada con el sello Maître-Restaurateur en 2019, ofrece especialidades bugistas a base de productos locales y vinos de Bugey."
    ]
  },
