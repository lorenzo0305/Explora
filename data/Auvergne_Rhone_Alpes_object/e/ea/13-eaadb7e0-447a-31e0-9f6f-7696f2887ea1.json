  "rdfs:comment": {
    "de": [
      "Möchten Sie die Haute Maurienne aus der Luft entdecken? Florian, ein staatlich geprüfter Paragliding-Lehrer, bietet Tandemflüge an, die für alle zugänglich sind."
    ],
    "en": [
      "Want to discover the Haute Maurienne from the air? Florian, a state-qualified paragliding instructor, offers tandem flights accessible to all, in complete safety, for a unique aerial experience based on pleasure and escape."
    ],
    "it": [
      "Volete scoprire la Haute Maurienne dall'alto? Florian, istruttore di parapendio diplomato, propone voli in tandem accessibili a tutti, in totale sicurezza, per un'esperienza aerea unica all'insegna del piacere e dell'evasione."
    ],
    "fr": [
      "Envie de découvrir la Haute Maurienne vue du ciel ? Florian, moniteur de parapente diplômé d’État, propose des vols biplace accessibles à tous, en toute sécurité, pour une expérience aérienne unique, placée sous le signe du plaisir et de l’évasion."
    ],
    "es": [
      "¿Quiere descubrir la Haute Maurienne desde el aire? Florian, instructor de parapente diplomado por el Estado, propone vuelos biplaza accesibles a todos, con total seguridad, para vivir una experiencia aérea única basada en el placer y la evasión."
    ],
    "nl": [
      "Zin om de Haute Maurienne vanuit de lucht te ontdekken? Florian, een gediplomeerd paragliding instructeur, biedt tandemvluchten aan die voor iedereen toegankelijk zijn, in alle veiligheid, voor een unieke ervaring in de lucht die in het teken staat van plezier en ontsnapping."
    ]
  },
  "rdfs:label": {
    "en": [
      "Florian Gohet - Paragliding Instructor"
    ],
    "fr": [
      "Florian Gohet - Moniteur de Parapente"
    ],
    "nl": [
      "Florian Gohet - Paragliding-instructeur"
    ]
  },
