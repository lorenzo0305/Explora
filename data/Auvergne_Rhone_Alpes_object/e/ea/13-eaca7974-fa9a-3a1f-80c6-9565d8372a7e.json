  "rdfs:comment": {
    "de": [
      "Gegenüber dem Château de Senaud, 50 m vom Clubhaus und Restaurant entfernt, werden Ihnen 30 Zimmer angeboten. Sehr komfortables-Hotel mit Badezimmern, Badewannen und separaten Duschen, separaten WCs, Fernseher, die meisten Zimmer mit Terrasse."
    ],
    "en": [
      "In front of Senaud Castel, 50 meters from the \"Club house\" and restaurant, 30 bedrooms. Very comfortable bedrooms with bathrooms, bathtubs and showers. Separated toilets, TV and some bedrooms with terraces."
    ],
    "it": [
      "Il Best Western Domaine du Golf d'Albon è un hotel di charme situato in una posizione tranquilla nel cuore di un campo da golf nella Drôme e dispone di 25 camere doppie confortevoli e spaziose e 5 camere familiari."
    ],
    "fr": [
      "Hôtel de charme situé dans la Drôme au calme au cœur d'un parcours de golf, le Best Western Domaine du Golf d'Albon dispose de 25 chambres doubles et de 5 chambres familiales, toutes confortables et spacieuses."
    ],
    "nl": [
      "Tegenover het Château de Senaud, op 50 m van het clubhuis en het restaurant, zijn 30 kamers beschikbaar. Zeer comfortabel hotel met badkamers, aparte baden en douches, aparte WC's, televisie, de meeste kamers met terras."
    ],
    "es": [
      "El Best Western Domaine du Golf d'Albon es un hotel con encanto situado en una zona tranquila, en el corazón de un campo de golf de la Drôme. Dispone de 25 habitaciones dobles cómodas y espaciosas y 5 habitaciones familiares."
    ]
  },
