  "rdfs:comment": {
    "de": [
      "Der Eurostar befindet sich gegenüber dem Bahnhof. Hier finden Sie eine traditionelle Brasserie mit ihren \"hausgemachten\" Spezialitäten. Man kommt zu jeder Tageszeit hierher, sei es für einen süßen oder salzigen Appetit, aber auch, um mit Freunden ein Bier zu trinken."
    ],
    "en": [
      "The Eurostar is located opposite the station. You'll find a traditional brasserie with home-made specialties. People come here at all hours, whether for a sweet or savory treat, or to enjoy a beer with friends."
    ],
    "it": [
      "L'Eurostar si trova di fronte alla stazione. Troverete una brasserie tradizionale con specialità fatte in casa. La gente viene qui a tutte le ore, sia per un dolce o un salato che per una birra con gli amici."
    ],
    "fr": [
      "L'Eurostar est situé face à la gare. Vous trouverez une brasserie traditionnelle avec ses spécialités \"maison\". On y vient à toute heure, que ce soit pour une envie sucrée ou salée, mais aussi pour boire une bière entre amis."
    ],
    "es": [
      "El Eurostar está situado frente a la estación. Encontrará una brasserie tradicional con especialidades caseras. La gente viene aquí a todas horas, ya sea para un capricho dulce o salado, o para disfrutar de una cerveza con los amigos."
    ],
    "nl": [
      "De Eurostar ligt tegenover het station. Je vindt er een traditionele brasserie met huisgemaakte specialiteiten. Mensen komen hier op elk uur van de dag, of het nu voor een zoete of hartige traktatie is, of om te genieten van een biertje met vrienden."
    ]
  },
