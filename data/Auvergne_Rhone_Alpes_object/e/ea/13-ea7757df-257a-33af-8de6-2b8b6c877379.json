  "rdfs:comment": {
    "de": [
      "Haben Sie ein defektes Gerät oder ein beschädigtes Kleidungsstück? Werfen Sie es nicht mehr weg, sondern reparieren Sie es mit uns!\r\nNach Anmeldung."
    ],
    "en": [
      "Do you have a broken appliance or damaged garment? Don't throw it away, repair it with us!\r\nRegistration required."
    ],
    "it": [
      "Avete un elettrodomestico rotto o un capo di abbigliamento danneggiato? Non buttatelo via, riparatelo con noi!\r\nRegistrazione obbligatoria."
    ],
    "fr": [
      "Vous avez un appareil en panne ou un vêtement abîmé ? Ne le jetez plus, réparez-le avec nous !\r\nSur inscription."
    ],
    "es": [
      "¿Tienes un electrodoméstico roto o una prenda de ropa estropeada? No la tires, ¡repárala con nosotros!\r\nInscripción obligatoria."
    ],
    "nl": [
      "Heb je een kapot apparaat of beschadigd kledingstuk? Gooi het niet weg, maar repareer het bij ons!\r\nRegistratie vereist."
    ]
  },
