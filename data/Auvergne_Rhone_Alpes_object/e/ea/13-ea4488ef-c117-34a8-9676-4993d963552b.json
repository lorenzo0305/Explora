  "rdfs:comment": {
    "de": [
      "Les Moulinettes ist ein Muss für alle Skifahrer in Sainte-Foy. Genießen Sie die einzigartige After-Ski-Atmosphäre im Freien mit knisternden Braséros und lokaler und internationaler Küche, perfekt zum Entspannen mit Freunden oder der Familie."
    ],
    "en": [
      "Les Moulinettes is a must for skiers in Sainte-Foy. Enjoy a unique outdoor after-ski atmosphere, with crackling braziers, and local and international cuisine, perfect for relaxing with friends or family."
    ],
    "it": [
      "Les Moulinettes è un must per gli sciatori di Sainte-Foy. Godetevi un'atmosfera unica dopo lo sci, con bracieri scoppiettanti e cucina locale e internazionale, perfetta per rilassarsi con gli amici o la famiglia."
    ],
    "fr": [
      "Les Moulinettes est un lieu incontournable pour les skieurs à Sainte-Foy. Profitez d’une ambiance after-ski unique en extérieur, avec des braséros crépitants, et une cuisine locale et internationale, parfaite pour se détendre entre amis ou en famille."
    ],
    "nl": [
      "Les Moulinettes is een must voor skiërs in Sainte-Foy. Geniet van een unieke buitensportsfeer na het skiën, met knetterende vuurkorven en lokale en internationale gerechten, perfect om te ontspannen met vrienden of familie."
    ],
    "es": [
      "Les Moulinettes es una visita obligada para los esquiadores en Sainte-Foy. Disfrute de un ambiente único al aire libre después de esquiar, con crepitantes braseros y cocina local e internacional, perfecto para relajarse con los amigos o la familia."
    ]
  },
