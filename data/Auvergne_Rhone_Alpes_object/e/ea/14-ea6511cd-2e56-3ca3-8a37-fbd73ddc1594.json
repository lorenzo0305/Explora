        "de": [
          "Biologischer Gemüseanbau, der seit zwei Generationen von der Familie betrieben wird. Obst und Gemüse der Saison und Verkauf ab Hof."
        ],
        "en": [
          "Family-run organic market gardening for two generations. Seasonal fruit and vegetables sold at the farm."
        ],
        "it": [
          "Orto biologico a conduzione familiare da due generazioni. Frutta e verdura di stagione vendute in azienda."
        ],
        "fr": [
          "Maraîchage biologique en famille depuis deux générations. Fruits et légumes de saison et vente à la ferme."
        ],
        "es": [
          "Horticultura ecológica familiar desde hace dos generaciones. Frutas y verduras de temporada vendidas en la granja."
        ],
        "nl": [
          "Al twee generaties lang biologisch tuinieren door een familiebedrijf. Seizoensfruit en -groenten worden op de boerderij verkocht."
        ]
