  "rdfs:comment": {
    "de": [
      "Im Méli-Mélo genießen Sie eine familiäre , herzhafte Küche\r\nFür Gruppen werden die Menüs je nach Budget, Jahreszeit und Wünschen zusammengestellt."
    ],
    "en": [
      "At Le Méli-Mélo, enjoy hearty, home-style cooking\r\nFor groups, menus tailored to budgets, seasons and desires."
    ],
    "it": [
      "A Le Méli-Mélo, venite a gustare un'abbondante cucina casalinga\r\nPer i gruppi, menù su misura per budget, stagioni e desideri."
    ],
    "fr": [
      "Au Méli-Mélo, venez savourer une cuisine familiale , copieuse\r\nPour les groupes, menus élaborés selon les budgets, les saisons et les désirs."
    ],
    "nl": [
      "Kom bij Le Méli-Mélo genieten van een stevige keuken\r\nVoor groepen, menu's op maat van budgetten, seizoenen en wensen."
    ],
    "es": [
      "En Le Méli-Mélo, venga a disfrutar de una cocina casera y abundante\r\nPara grupos, menús adaptados a presupuestos, temporadas y deseos."
    ]
  },
