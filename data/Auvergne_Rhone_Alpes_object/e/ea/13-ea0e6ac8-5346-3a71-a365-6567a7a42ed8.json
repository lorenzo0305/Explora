  "rdfs:comment": {
    "de": [
      "Das Hotel Le Caprice des Neiges in Crest-Voland am Fuß der Pisten des Skigebiets Espace Diamant steht seinen Gästen im Winter und im Sommer für einen außergewöhnliche Urlaub zur Verfügung."
    ],
    "en": [
      "Situated in Crest-Voland, at the bottom of the Espace Diamant ski slopes, the Hôtel Le Caprice des Neiges is open throughout both summer and winter, offering an exceptional holiday experience."
    ],
    "it": [
      "L'hotel Le Caprice des Neiges, situato in Crest-Voland ai piedi delle piste dell'Espace Diamant, vi accoglie in estate e in inverno per vacanze eccezionali."
    ],
    "fr": [
      "L’hôtel Le Caprice des Neiges, situé à Crest-Voland au pied des pistes de l’Espace Diamant, vous accueille été comme hiver pour des vacances d’exception."
    ],
    "nl": [
      "Het hotel Le Caprice des Neiges, gelegen in Crest-Voland aan de voet van de pistes van Espace Diamant, verwelkomt u in zomer en winter voor een uitzonderlijke vakantie."
    ],
    "es": [
      "El hotel Le Caprice des Neiges, situado en Crest-Voland al pie de las pistas del Espace Diamant, le acoge en verano y en invierno para unas vacaciones excepcionales."
    ]
  },
