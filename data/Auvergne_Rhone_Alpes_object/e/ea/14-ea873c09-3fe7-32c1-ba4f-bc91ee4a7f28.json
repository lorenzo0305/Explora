  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98496ea3-0663-3541-b18b-f791022f1340",
      "dc:description": {
        "de": [
          "Workshop Babygymnastik von Sportanim?\n9:30, 11:00, 15:30 und 17:00 Uhr - Salle Suzanne Lenglen.\n\nAlter: von 15 Monaten bis 5 Jahren\nDauer: 1 Stunde\nEinzeltarif: 8 ?\nDer Workshop wird von einem Sportpädagogen betreut, damit die Praxis in aller Sicherheit durchgeführt werden kann."
        ],
        "en": [
          "Baby gym workshop by Sportanim?\n9.30am, 11am, 3.30pm and 5pm - Salle Suzanne Lenglen.\n\nAge: 15 months to 5 years\nDuration: 1 hour\nPrice: 8?\nWorkshop supervised by a sports educator to ensure safe practice."
        ],
        "it": [
          "Laboratorio di baby gym a cura di Sportanim?\nore 9.30, 11.00, 15.30 e 17.00 - Salle Suzanne Lenglen.\n\nEtà: da 15 mesi a 5 anni\nDurata: 1 ora\nCosto una tantum: 8 euro\nQuesto laboratorio è supervisionato da un istruttore sportivo per garantire che tutte le attività si svolgano in totale sicurezza."
        ],
        "fr": [
          "Atelier baby gym par Sportanim’\n9h30, 11h, 15h30 et 17h - Salle Suzanne Lenglen.\n\nÂge : de 15 mois à 5 ans\nDurée : 1h\nTarif unique : 8 €\nAtelier encadré par un éducateur sportif pour que la pratique soit réalisée en toute sécurité."
        ],
        "es": [
          "Taller de gimnasia para bebés a cargo de Sportanim?\n9h30, 11h00, 15h30 y 17h00 - Salle Suzanne Lenglen.\n\nEdad: de 15 meses a 5 años\nDuración: 1 hora\nCoste único: 8\nEste taller está supervisado por un monitor deportivo para garantizar que todas las actividades se desarrollan con total seguridad."
        ],
        "nl": [
          "Baby gym workshop door Sportanim?\n9.30, 11.00, 15.30 en 17.00 uur - Salle Suzanne Lenglen.\n\nLeeftijd: 15 maanden tot 5 jaar\nDuur: 1 uur\nEenmalige kosten: €8\nDeze workshop wordt begeleid door een sportinstructeur om ervoor te zorgen dat alle activiteiten in alle veiligheid plaatsvinden."
        ]
      },
