  "rdfs:comment": {
    "de": [
      "Freedom Fitness bietet Ihnen rund um die Uhr unbegrenzten Zugang zu 10 Räumen mit einem Kardiobereich, einem Bereich für Krafttraining mit Anleitung und freien Gewichten, einem Bereich für Videokurse, einem Bereich für Cross-Training, Elektrostimulationskursen und einem neuen Kampfsportbereich"
    ],
    "en": [
      "Freedom Fitness offers unlimited access to 10 gyms 24/7, with a cardio area, guided weight training and free weights, a video class area, a cross-training area, electrostimulation classes and a new combat sports area"
    ],
    "it": [
      "Freedom Fitness offre accesso illimitato a 10 palestre 24 ore su 24, 7 giorni su 7, con un'area cardio, allenamento guidato con i pesi e pesi liberi, un'area per le video lezioni, un'area per il cross-training, lezioni di elettrostimolazione e una nuova area per gli sport da combattimento"
    ],
    "fr": [
      "Freedom Fitness c'est un accès à 10 salles en illimité 24h/24 7J/7 avec un espace cardio, un espace musculation guidé et poids libres, un espace cours vidéos, un espace cross training, des cours d'électrostimulation et un nouvel espace sport de combats"
    ],
    "es": [
      "Freedom Fitness ofrece acceso ilimitado a 10 gimnasios 24 horas al día, 7 días a la semana, con zona de cardio, musculación dirigida y pesas libres, zona de videoclases, zona de cross-training, clases de electroestimulación y una nueva zona de deportes de combate"
    ],
    "nl": [
      "Freedom Fitness biedt onbeperkte toegang tot 10 fitnesszalen, 24 uur per dag, 7 dagen per week, met een cardiogedeelte, begeleide krachttraining en vrije gewichten, een videolessengedeelte, een crosstrainingsgedeelte, elektrostimulatielessen en een nieuw vechtsportgedeelte"
    ]
  },
  "rdfs:label": {
