  "rdfs:comment": {
    "de": [
      "Le Tremplin ist auf aktuelle verstärkte Musik spezialisiert und bietet ein vielfältiges Programm, das sowohl jungen lokalen als auch nationalen und internationalen Künstlern eine Chance gibt."
    ],
    "en": [
      "Specializing in contemporary amplified music, Le Tremplin offers a varied program that gives a chance to young local artists as well as national and international artists."
    ],
    "it": [
      "Specializzato in musica contemporanea amplificata, Le Tremplin offre un programma vario che dà la possibilità a giovani artisti locali e ad artisti nazionali e internazionali."
    ],
    "fr": [
      "Spécialisée dans les musiques actuelles amplifiées, Le Tremplin propose une programmation variée qui donne sa chance à de jeunes artistes locaux ainsi qu’à des artistes nationaux et internationaux."
    ],
    "nl": [
      "Le Tremplin, gespecialiseerd in actuele versterkte muziek, biedt een gevarieerd programma dat zowel jonge lokale artiesten als nationale en internationale artiesten een kans geeft."
    ],
    "es": [
      "Especializado en música contemporánea amplificada, Le Tremplin ofrece un programa variado que da una oportunidad a los jóvenes artistas locales, así como a los nacionales e internacionales."
    ]
  },
