  "rdfs:comment": {
    "de": [
      "Besichtigung des Weinkellers, Erklärung der Weinherstellung, Entdeckung der biologischen Landwirtschaft, Möglichkeit zu Wanderungen in den Weinbergen und in Montpeyroux."
    ],
    "en": [
      "Visit the winery, learn about the wine-making process, discover organic farming and take a walk in the vineyards and Montpeyroux."
    ],
    "it": [
      "Visitate la cantina, imparate a conoscere il processo di vinificazione, scoprite l'agricoltura biologica e fate una passeggiata tra le vigne e Montpeyroux."
    ],
    "fr": [
      "Visite de la cave, explication de la vinification, découverte de l'agriculture biologique, possibilité de randonnée dans les vignes et dans Montpeyroux."
    ],
    "es": [
      "Visite la bodega, conozca el proceso de elaboración del vino, infórmese sobre la agricultura ecológica y dé un paseo por las viñas y Montpeyroux."
    ],
    "nl": [
      "Bezoek de kelder, leer meer over het wijnmaakproces, kom meer te weten over biologische landbouw en maak een wandeling door de wijngaarden en de Montpeyroux."
    ]
  },
