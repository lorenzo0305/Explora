  "rdfs:comment": {
    "de": [
      "Im Herzen der Weinberge des Beaujolais und 20 Minuten von Lyon entfernt empfängt Sie das Manoir de la Garde, ein charakteristisches architektonisches Ensemble aus goldenen Steinen, das als historisches Monument eingetragen ist, für Ihre Veranstaltungen."
    ],
    "en": [
      "In the heart of the Beaujolais vineyards and 20 minutes from Lyon, the Manoir de la Garde, an architectural ensemble of character made of golden stones and listed as a Historic Monument, welcomes you for your events."
    ],
    "it": [
      "Nel cuore dei vigneti del Beaujolais e a 20 minuti da Lione, il Manoir de la Garde, un complesso architettonico di carattere in pietra dorata classificato come monumento storico, vi accoglie per i vostri eventi."
    ],
    "fr": [
      "Au cœur des vignes du Beaujolais et à 20 minutes de Lyon, le Manoir de la Garde, ensemble architectural de caractère en pierres dorées inscrit Monument Historique, vous accueille pour vos évènements."
    ],
    "nl": [
      "In het hart van de wijngaarden van de Beaujolais en op 20 minuten van Lyon verwelkomt het Manoir de la Garde, een karaktervol architecturaal geheel in goudsteen dat op de monumentenlijst staat, u voor uw evenementen."
    ],
    "es": [
      "En el corazón de los viñedos del Beaujolais y a 20 minutos de Lyon, el Manoir de la Garde, un conjunto arquitectónico de carácter en piedra dorada catalogado como monumento histórico, le da la bienvenida para sus eventos."
    ]
  },
  "rdfs:label": {
