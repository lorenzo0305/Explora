  "rdfs:comment": {
    "de": [
      "Das 10.55 in Bourg-en-Bresse ist ein Freizeit- und Restaurantkomplex, der zahlreiche Freizeitaktivitäten vereint. Für jedes Alter und jeden Anlass bietet das 10.55 die Möglichkeit, einen geselligen Moment mit Freunden, der Familie oder Kollegen zu verbringen."
    ],
    "en": [
      "Le 10.55 in Bourg-en-Bresse is a leisure and catering complex offering a wide range of fun activities. For all ages and all occasions, 10.55 is the perfect place to spend a convivial moment with friends, family or colleagues."
    ],
    "it": [
      "Le 10.55 di Bourg-en-Bresse è un complesso ricreativo e di ristorazione che offre un'ampia gamma di attività divertenti. Adatto a tutte le età e a tutte le occasioni, il 10.55 è un luogo ideale per trascorrere del tempo con gli amici, la famiglia o i colleghi."
    ],
    "fr": [
      "Le 10.55 à Bourg-en-Bresse, c’est un complexe de loisirs et restauration qui réunit de nombreuses activités ludiques. Pour tous les âges et toutes les occasions, le 10.55 vous permet de passer un moment convivial entre amis, en famille ou entre collègues."
    ],
    "nl": [
      "Le 10.55 in Bourg-en-Bresse is een vrijetijds- en horecacomplex dat een breed scala aan leuke activiteiten biedt. Voor alle leeftijden en alle gelegenheden is 10.55 een geweldige plek om tijd door te brengen met vrienden, familie of collega's."
    ],
    "es": [
      "Le 10.55 de Bourg-en-Bresse es un complejo de ocio y restauración que ofrece una amplia gama de actividades divertidas. Para todas las edades y todas las ocasiones, el 10.55 es un lugar ideal para pasar tiempo con amigos, familiares o compañeros de trabajo."
    ]
  },
