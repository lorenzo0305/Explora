  "rdfs:comment": {
    "de": [
      "Gebäude im romanischen Stil.\r\nDer Heilige Eloy dominiert die Fassade mit einem Portal im klassischen Stil.\r\nHinter dem Altar im Chorraum befindet sich ein Altarbild im klassischen Stil."
    ],
    "en": [
      "Romanesque style building.\r\nSaint Eloy dominates the facade of a classical style porch.\r\nBehind the altar, in the choir, there is a classical style altarpiece."
    ],
    "it": [
      "Edificio romanico.\r\nSan Eloy domina la facciata con un portico classico.\r\nDietro l'altare nel coro si trova una pala d'altare classica."
    ],
    "fr": [
      "Édifice de style roman.\r\nSaint Eloy domine la façade d'un porche de style classique.\r\nDerrière l'autel, dans le chœur, se trouve un retable de style classique."
    ],
    "nl": [
      "Romaanse gebouw.\r\nSint Eloy domineert de gevel met een klassieke portiek.\r\nAchter het altaar in het koor staat een klassiek altaarstuk."
    ],
    "es": [
      "Edificio románico.\r\nSan Eloy domina la fachada con un pórtico clásico.\r\nDetrás del altar en el coro hay un retablo clásico."
    ]
  },
  "rdfs:label": {
