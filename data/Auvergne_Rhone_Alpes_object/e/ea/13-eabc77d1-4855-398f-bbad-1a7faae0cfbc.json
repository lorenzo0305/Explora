  "rdfs:comment": {
    "de": [
      "Eine Reise ins Herz des Mittelmeers erwartet Sie?\r\nDas Duo Yalil entführt Sie in das Griechenland der 10-30er Jahre, das Land der Exilanten, der Tavernen und der freien Seelen...\r\nEin zeitloser Abend zwischen Orient und Okzident."
    ],
    "en": [
      "A journey to the heart of the Mediterranean awaits you?\r\nDuo Yalil takes you back to the Greece of the 10-30s, the land of exiles, taverns and free souls...\r\nA timeless evening between East and West."
    ],
    "it": [
      "Un viaggio nel cuore del Mediterraneo vi aspetta?\r\nIl Duo Yalil vi riporterà nella Grecia degli anni '10-'30, terra di esuli, taverne e anime libere...\r\nUna serata senza tempo, tra Oriente e Occidente."
    ],
    "fr": [
      "Un voyage au cœur de la Méditerranée vous attend…\r\nLe Duo Yalil vous embarque dans la Grèce des années 10-30, celle des exilés, des tavernes et des âmes libres...\r\nUne soirée hors du temps, entre Orient et Occident."
    ],
    "nl": [
      "Wacht je een reis naar het hart van de Middellandse Zee?\r\nDuo Yalil neemt je mee terug naar Griekenland in de jaren 10-30, het land van ballingen, tavernes en vrije zielen...\r\nEen tijdloze avond, tussen Oost en West."
    ],
    "es": [
      "Le espera un viaje al corazón del Mediterráneo..\r\nEl dúo Yalil le transportará a la Grecia de los años 10-30, tierra de exiliados, tabernas y almas libres...\r\nUna velada atemporal, entre Oriente y Occidente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert du duo Yalil"
    ]
  },
