  "rdfs:comment": {
    "de": [
      "Restaurant, dessen Küche mit frischen Produkten zubereitet wird: Fleisch, Fisch, Gemüse & Obst der Saison. Schneller Service am Mittag.\r\nSpezialitäten im Winter: Sauerkraut, Andouillette, Foie Gras.\r\nIm Sommer: Salate, Tartar auf einer schönen, ruhigen Terrasse."
    ],
    "en": [
      "Local and fresh products : meat, fish, seasonal fruits and vegetables. Quick service at midday. Winter specialites : sauerkraut, andouillettes, foie gras. During summer : salads, tartares are served on an outside and peaceful terrace."
    ],
    "it": [
      "Ristorante con prodotti freschi: carne, pesce, verdure e frutta di stagione. Servizio rapido a pranzo.\r\nSpecialità invernali: crauti, andouillette, foie gras.\r\nD'estate: insalate, tartara su una bella e tranquilla terrazza."
    ],
    "fr": [
      "Restaurant dont la cuisine est élaborée avec des produits frais : viandes, poissons, légumes & fruits de saison. Service rapide le midi. \r\nSpécialités hiver : choucroute, andouillette, foie gras. \r\nEn été : salades, tartares sur une belle terrasse au calme."
    ],
    "es": [
      "Restaurante que sirve productos frescos: carne, pescado, verduras y fruta de temporada. Servicio rápido al mediodía.\r\nEspecialidades de invierno: chucrut, andouillette, foie gras.\r\nEn verano: ensaladas, tártaros en una agradable y tranquila terraza."
    ],
    "nl": [
      "Restaurant met verse producten: vlees, vis, groenten en seizoensfruit. Snelle service tijdens de lunch.\r\nWinterspecialiteiten: zuurkool, andouillette, foie gras.\r\nIn de zomer: salades, tartaar op een heerlijk, rustig terras."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brasserie du théâtre"
    ],
    "fr": [
      "Brasserie du théâtre"
    ]
  },
