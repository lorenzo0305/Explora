  "rdfs:comment": {
    "de": [
      "Nur 25 Minuten von Annecy und Albertville entfernt bietet Le Golf des Alpes in Giez zwei Golferlebnisse mit dem 18-Loch-Par-72-Cours du Chamois und dem 9-Loch-Par-33-Cours les Castors."
    ],
    "en": [
      "25 minutes from Annecy and Albertville, Le Golf des Alpes, in Giez, offers two golfing experiences with the Chamois course, an 18-hole par 72 course, and the Castors course, a 9-hole par 33 course."
    ],
    "it": [
      "A soli 25 minuti da Annecy e Albertville, Le Golf des Alpes a Giez offre due esperienze di golf: il campo a 18 buche par 72 Chamois e il campo a 9 buche par 33 Castors."
    ],
    "fr": [
      "À seulement 25 minutes d’Annecy et d’Albertville, Le Golf des Alpes, à Giez, propose deux expériences golfiques avec le parcours du Chamois 18 trous par 72 et les Castors, 9 trous par 33."
    ],
    "nl": [
      "Op slechts 25 minuten van Annecy en Albertville biedt Le Golf des Alpes in Giez twee golfervaringen: de 18-holes par 72 baan van Chamois en de 9-holes par 33 baan van Castors."
    ],
    "es": [
      "A sólo 25 minutos de Annecy y Albertville, Le Golf des Alpes en Giez ofrece dos experiencias de golf: el campo de 18 hoyos par 72 Chamois y el campo de 9 hoyos par 33 Castors."
    ]
  },
