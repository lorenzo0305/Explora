  "rdfs:comment": {
    "de": [
      "Das Central Park bietet eine abwechslungsreiche und leckere Küche, die von Burgern über Salate bis hin zu saisonalen Vorschlägen und Desserts reicht, alles hausgemacht. Eine Speisekarte, die jeden Appetit befriedigen wird, in einem freundlichen und entspannten Rahmen."
    ],
    "en": [
      "Central Park offers a varied and gourmet menu, from burgers and salads to seasonal suggestions and desserts, all homemade. A menu to satisfy every appetite, in a friendly, relaxed setting."
    ],
    "it": [
      "Il Central Park offre una vasta gamma di piatti gourmet, da hamburger e insalate a proposte stagionali e dessert fatti in casa. Un menu adatto a tutti gli appetiti, in un ambiente amichevole e rilassato."
    ],
    "fr": [
      "Le Central Park propose une cuisine variée et gourmande, allant des burgers aux salades en passant par des suggestions de saisons et des desserts, le tout maison. Une carte qui saura satisfaire tous les appétits, dans un cadre convivial et décontracté."
    ],
    "es": [
      "Central Park ofrece una amplia gama de cocina gourmet, desde hamburguesas y ensaladas hasta sugerencias de temporada y postres caseros. Un menú para todos los apetitos, en un ambiente agradable y relajado."
    ],
    "nl": [
      "Central Park biedt een breed scala aan gastronomische gerechten, van hamburgers en salades tot seizoensgebonden suggesties en huisgemaakte desserts. Een menu voor elk wat wils, in een vriendelijke, ontspannen omgeving."
    ]
  },
  "rdfs:label": {
