  "rdfs:comment": {
    "de": [
      "Unsere Gleitschirmschule Barbule in den Regionen Okzitanien und Auvergne Rhône Alpes Ardèche profitiert von einem sonnigen und milden Klima, das sich auch außerhalb der Sommersaison für Aktivitäten in der freien Natur eignet."
    ],
    "en": [
      "Our Barbule paragliding school, located in the Occitanie and Auvergne Rhône Alpes Ardèche regions, enjoys a mild, sunny climate ideal for outdoor activities outside the summer season."
    ],
    "it": [
      "La nostra scuola di parapendio di Barbule, situata nelle regioni Occitanie e Auvergne Rhône Alpes Ardèche, gode di un clima mite e soleggiato, ideale per le attività all'aperto al di fuori della stagione estiva."
    ],
    "fr": [
      "Notre école de parapente Barbule située en région Occitanie et Auvergne Rhône Alpes Ardèche, bénéficie d'un climat ensoleillé et doux propice aux activités de pleine nature en dehors de la saison estivale."
    ],
    "nl": [
      "Onze paragliding school in Barbule, gelegen in de regio's Occitanie en Auvergne Rhône Alpes Ardèche, geniet van een mild, zonnig klimaat dat ideaal is voor buitenactiviteiten buiten het zomerseizoen."
    ],
    "es": [
      "Nuestra escuela de parapente de Barbule, situada en las regiones de Occitanie y Auvergne Rhône Alpes Ardèche, goza de un clima suave y soleado, ideal para practicar actividades al aire libre fuera de la temporada estival."
    ]
  },
