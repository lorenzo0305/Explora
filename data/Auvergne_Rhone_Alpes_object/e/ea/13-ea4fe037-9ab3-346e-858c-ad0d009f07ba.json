  "rdfs:comment": {
    "de": [
      "Erfahren Sie, wie die ehemalige mechanische Spitzenfabrik Fontanille, die 1860 von Achille Proy gegründet wurde, im Jahr 2011 in Sozialwohnungen und Stadthäuser umgewandelt wurde."
    ],
    "en": [
      "Come and discover how the former mechanical lace factory Fontanille created in 1860 by Achille Proy was rehabilitated in 2011, in social housing and town houses."
    ],
    "it": [
      "Venite a scoprire come l'ex fabbrica di merletti meccanici Fontanille, creata nel 1860 da Achille Proy, sia stata riabilitata nel 2011, trasformandola in case popolari e case di città."
    ],
    "fr": [
      "Venez découvrir comment l’ancienne usine de dentelle mécanique Fontanille créée en 1860 par Achille Proy a été réhabilitée en 2011, en logements sociaux et maisons de ville."
    ],
    "es": [
      "Venga a descubrir cómo la antigua fábrica de encajes mecánicos Fontanille, creada en 1860 por Achille Proy, fue rehabilitada en 2011, convirtiéndose en viviendas sociales y casas urbanas."
    ],
    "nl": [
      "Kom ontdekken hoe de voormalige mechanische kantfabriek Fontanille, in 1860 opgericht door Achille Proy, in 2011 is gerenoveerd tot sociale woningen en stadswoningen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : L'écoquartier de Fontanille"
    ]
  },
