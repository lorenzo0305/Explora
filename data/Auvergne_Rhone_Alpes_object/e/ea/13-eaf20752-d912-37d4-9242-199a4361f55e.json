  "rdfs:comment": {
    "de": [
      "Geflügelzüchter mit 100 % biologischem Anbau.\r\nLebendes Geflügel, Fleisch und Eier.\r\nAlte Rassen und lange Aufzucht (mindestens 100 Tage) mit einer Endmastphase mit vollem Korn.\r\n100% biologisches Futter"
    ],
    "en": [
      "100% organic poultry farmer.\r\nLive poultry, meat & eggs.\r\nOlder breeds and long rearing (100 days minimum) with a whole-grain finishing period.\r\n100% organic feed"
    ],
    "it": [
      "Allevatore di pollame 100% biologico.\r\nPollame vivo, carne e uova.\r\nRazze antiche e lungo periodo di allevamento (minimo 100 giorni) con un periodo di finissaggio integrale.\r\nMangime 100% biologico"
    ],
    "fr": [
      "Éleveur de volailles 100 % bio.\r\nVolailles vivantes, viande & œufs.\r\nRaces anciennes et élevage long (100 jours minimum) avec une période de finition au grain entier.\r\nAlimentation 100% bio"
    ],
    "es": [
      "Avicultor 100% ecológico.\r\nAves vivas, carne y huevos.\r\nRazas antiguas y largo periodo de cría (100 días como mínimo) con un periodo de acabado integral.\r\nPienso 100% ecológico"
    ],
    "nl": [
      "100% biologische pluimveehouder.\r\nLevend pluimvee, vlees en eieren.\r\nOudere rassen en lange opfokperiode (minimaal 100 dagen) met een volkoren afmestperiode.\r\n100% biologisch voer"
    ]
  },
  "rdfs:label": {
