  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: das atemberaubende Gefühl der Geschwindigkeit bei einer Fahrt entlang der Sandstrände!"
    ],
    "en": [
      "You'll love: the breathtaking sensation of speed as you ride along the sandy beaches!"
    ],
    "it": [
      "Vi piacerà: la sensazione mozzafiato di velocità mentre pedalate lungo le spiagge sabbiose!"
    ],
    "fr": [
      "Vous aimerez : les sensations époustouflantes de vitesse lors d'une sortie le long des plages de sable !"
    ],
    "nl": [
      "U zult ervan houden: het adembenemende gevoel van snelheid terwijl u langs de zandstranden rijdt!"
    ],
    "es": [
      "Te encantará la emoción de conducir a toda velocidad por las playas de arena"
    ]
  },
