  "rdfs:comment": {
    "de": [
      "Das 200 m² große Deep Nature Spa im Herzen der Pierre & Vacances Premium Residenz L'Hévana***** verspricht Ihnen einen entspannenden und zugleich belebenden Moment in einem kostbaren Zen-Rahmen mit Pflegebereichen, die dem Wohlbefinden gewidmet sind."
    ],
    "en": [
      "In a precious and zen setting, the 200 m² Deep Nature Spa, located in the heart of the Pierre & Vacances premium L'Hévana***** residence, promises you a relaxing and invigorating experience in treatment rooms dedicated to your well-being."
    ],
    "it": [
      "In un ambiente prezioso e zen, la Deep Nature Spa di 200 m², situata nel cuore della residenza Pierre & Vacances premium L'Hévana*****, vi promette un momento di relax e rinvigorimento nelle aree di trattamento dedicate al benessere."
    ],
    "fr": [
      "Dans un cadre précieux et zen, le Spa Deep Nature de 200 m², situé au cœur de la résidence Pierre & Vacances premium L’Hévana***** vous promet un moment à la fois relaxant et tonifiant, au sein d’espaces de soins dédiés au bien-être."
    ],
    "nl": [
      "In een prachtige, zen-achtige omgeving belooft de 200 m² grote Deep Nature Spa, gelegen in het hart van het premium Pierre & Vacances-resort L'Hévana*****, u een ontspannend en verkwikkend moment in ruimtes die volledig zijn gewijd aan uw welzijn."
    ],
    "es": [
      "En un marco precioso y zen, el Spa Deep Nature de 200 m², situado en el corazón de la residencia premium Pierre & Vacances L'Hévana*****, le promete un momento relajante y tonificante en espacios de tratamientos dedicados al bienestar."
    ]
  },
