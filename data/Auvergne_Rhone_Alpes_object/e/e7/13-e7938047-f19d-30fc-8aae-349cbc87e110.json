  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek bietet Ihnen mit über 600 Titeln die Möglichkeit, Bücher aller Art auszuleihen: Romane, Krimis, Romane aus dem Leben, Science-Fiction, Comics, Alben für Jugendliche aller Altersgruppen, Märchen, Jugendromane, Dokumentarfilme für Jugendliche und Erwachsene"
    ],
    "en": [
      "The municipal library, with over 600 references, offers you a wide range of books on loan: novels, detective stories, real-life stories, science fiction, comics, albums for young people of all ages, storytelling, juvenile novels, documentaries for young people and adults.."
    ],
    "it": [
      "La biblioteca comunale dispone di oltre 600 articoli in prestito, tra cui romanzi, gialli, storie di vita reale, fantascienza, fumetti, libri per bambini di tutte le età, racconti, romanzi per ragazzi e documentari per giovani e adulti"
    ],
    "fr": [
      "La bibliothèque municipale, avec plus de 600 références, vous offre le prêt d'ouvrages en tous genres : romans, policiers, vécus, science-fiction, BD, albums jeunes de tous âges, contes, romans jeunes, documentaires jeunes et adultes"
    ],
    "es": [
      "La biblioteca municipal cuenta con más de 600 obras en préstamo, entre novelas, novelas policíacas, historias de la vida real, ciencia ficción, cómics, libros infantiles para todas las edades, cuentos, novelas juveniles y documentales para jóvenes y adultos"
    ],
    "nl": [
      "De stadsbibliotheek heeft meer dan 600 items te leen, waaronder romans, detectiveverhalen, waargebeurde verhalen, sciencefiction, stripboeken, kinderboeken voor alle leeftijden, verhalen, jeugdromans en documentaires voor jongeren en volwassenen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque municipale"
    ]
  },
