  "rdfs:comment": {
    "de": [
      "Bücher ausleihen kostenlos, in Kooperation mit Savoie Biblio (Erneuerung der Bestände einmal pro Monat, Möglichkeit besondere Titel zu bestellen). Verleih von CDs und DVDs. Mitgliedschaft kostenlos. Kaution erforderlich für saisonale und außerhalb des Dorfes. 50 €."
    ],
    "en": [
      "Free book loan, in partnership with Savoie Biblio (renewal once a month, you can also ask for specific books). CD/DVD loan. Free registration. Deposit required for seasonal and outside the village. 50 €."
    ],
    "it": [
      "Prestito gratuito di libri, in collaborazione con Savoia Biblio (rinnovo una volta al mese, possibilità di richiedere libri specifici). Deposito richiesto per i lavoratori stagionali e per chi viene da fuori. 50? Prestito di CD e DVD."
    ],
    "fr": [
      "Prêt de livres gratuit, en partenariat avec Savoie Biblio (renouvellement une fois par mois, possibilité de demander des ouvrages particuliers).Inscription gratuite. Caution demandée pour les saisonniers et extérieurs au village. 50€. Prêt de CD et DVD."
    ],
    "es": [
      "Préstamo gratuito de libros, en colaboración con Savoie Biblio (se renueva una vez al mes, posibilidad de solicitar libros específicos). Se requiere un depósito para los trabajadores de temporada y las personas de fuera del pueblo. 50? Préstamo de CD y DVD."
    ],
    "nl": [
      "Gratis uitlening van boeken, in samenwerking met Savoie Biblio (één keer per maand vernieuwd, mogelijkheid om specifieke boeken aan te vragen). Borg vereist voor seizoenarbeiders en mensen van buiten het dorp. 50€. Uitleen van CD's en DVD's."
    ]
  },
