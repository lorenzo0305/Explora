  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie die Flüsse und Seen von Combrailles mit Pablo Vernier, Monitor, Angelführer. Er wird seine Leidenschaft sowie sein Wissen über Angeltechniken und aquatische Umgebungen an Sie weitergeben."
    ],
    "en": [
      "Come and discover the rivers and lakes of Combrailles with Pablo Vernier, mentor and fishing guide. He will pass on his passion to you as well as his knowledge of fishing techniques and aquatic environments."
    ],
    "it": [
      "Venite a scoprire i fiumi e i laghi delle Combrailles con Pablo Vernier, istruttore e guida di pesca. Condividerà con voi la sua passione e la sua conoscenza delle tecniche di pesca e degli ambienti acquatici."
    ],
    "fr": [
      "Venez découvrir les rivières et lacs des Combrailles avec Pablo Vernier, moniteur, guide de pêche. Il vous transmettra sa passion ainsi que ses connaissances sur les techniques de pêche et les milieux aquatiques."
    ],
    "es": [
      "Venga a descubrir los ríos y lagos de las Combrailles con Pablo Vernier, monitor y guía de pesca. Compartirá con usted su pasión y sus conocimientos sobre las técnicas de pesca y los medios acuáticos."
    ],
    "nl": [
      "Kom de rivieren en meren van de Combrailles ontdekken met Pablo Vernier, instructeur en visgids. Hij zal zijn passie en kennis van vistechnieken en aquatische milieus met je delen."
    ]
  },
  "rdfs:label": {
    "de": [
