  "rdfs:comment": {
    "de": [
      "Mit Mélaine langweilt man sich nicht! Natur und Leckereien gehen bei dieser Naturbegleiterin, die auch eine Eisdiele ist, Hand in Hand Folgen Sie ihr, um die Schönheit der Landschaft im Tal der Quellen des Sees von Annecy zu entdecken, und genießen Sie ein kleines Eis."
    ],
    "en": [
      "You're never bored with Mélaine! Nature and delight go hand in hand for this nature guide who also works as... an ice-cream maker! Follow her to discover the beauty of the landscapes in the valley of les Sources du lac d'Annecy and taste a lovely ice-cream along the way."
    ],
    "it": [
      "Con Mélaine non ci si annoia mai! Natura e delizie gastronomiche vanno di pari passo per questa guida naturalistica che è anche gelataia! Seguitela per scoprire la bellezza dei paesaggi della valle delle Fonti del Lago di Annecy e per gustare un piccolo gelato."
    ],
    "fr": [
      "Avec Mélaine, on ne s'ennuie pas ! Nature et gourmandise vont de pair pour cette accompagnatrice nature qui est aussi... glacière ! Suivez-la pour découvrir la beauté des paysages de vallée des Sources du lac d'Annecy et dégustez une petite glace."
    ],
    "nl": [
      "Met Mélaine verveel je je nooit! Natuur en lekkernijen gaan hand in hand voor deze natuurgids die ook ijsmaker is! Volg haar om de schoonheid van de landschappen van de vallei van de bronnen van het meer van Annecy te ontdekken en te genieten van een ijsje."
    ],
    "es": [
      "Con Mélaine nunca hay un momento aburrido Naturaleza y delicias gastronómicas van de la mano para esta guía de la naturaleza que también es heladera Sígala para descubrir la belleza de los paisajes del valle de las Fuentes del lago de Annecy y disfrute de un helado."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mélaine Bourgeois - nature guide"
    ],
    "fr": [
      "Mélaine Bourgeois - accompagnatrice nature"
    ]
  },
