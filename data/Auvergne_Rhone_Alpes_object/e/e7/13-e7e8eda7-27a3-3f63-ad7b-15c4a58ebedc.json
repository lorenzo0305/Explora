  "rdfs:comment": {
    "de": [
      "Das gesamte Team von LA CURE GOURMANDE heißt Sie in diesem modern eingerichteten Restaurant, das im ehemaligen Pfarrhaus des Dorfes Coren untergebracht ist, herzlich willkommen."
    ],
    "en": [
      "The entire LA CURE GOURMANDE team warmly welcomes you to this modernly decorated restaurant, housed in the former presbytery in the village of Coren."
    ],
    "it": [
      "L'intero team de LA CURE GOURMANDE vi dà un caloroso benvenuto in questo moderno ristorante, ospitato nell'antica canonica del villaggio di Coren."
    ],
    "fr": [
      "Toute l'équipe de LA CURE GOURMANDE vous accueille chaleureusement dans ce restaurant à la décoration moderne, aménagé dans l’ancien presbytère du village de Coren."
    ],
    "es": [
      "Todo el equipo de LA CURE GOURMANDE le da una calurosa bienvenida a este moderno restaurante, ubicado en el antiguo presbiterio del pueblo de Coren."
    ],
    "nl": [
      "Het hele team van LA CURE GOURMANDE heet je van harte welkom in dit moderne restaurant, gevestigd in de oude pastorie in het dorp Coren."
    ]
  },
