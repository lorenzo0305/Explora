  "rdfs:comment": {
    "de": [
      "Virtual Room Clermont-Ferrand bietet originelle und für alle zugängliche Erlebnisse in Teams von 2 bis 4 Spielern.\r\nAn der Kreuzung zwischen Escape Game und Kino begeben Sie sich auf ein virtuelles Abenteuer."
    ],
    "en": [
      "Virtual Room Clermont-Ferrand offers original experiences accessible to all in teams of 2 to 4 players.\r\nAt the crossroads between the escape game and the cinema, embark on a virtual adventure."
    ],
    "it": [
      "Virtual Room Clermont-Ferrand offre esperienze originali accessibili a tutti in squadre da 2 a 4 giocatori.\r\nAll'incrocio tra l'escape game e il cinema, imbarcatevi in un'avventura virtuale."
    ],
    "fr": [
      "Virtual Room Clermont-Ferrand propose des expériences originales et accessibles à tous en équipe de 2 à 4 joueurs.\r\nÀ la croisée des chemins entre l'escape game et le cinéma, embarquez pour une aventure virtuelle."
    ],
    "es": [
      "Virtual Room Clermont-Ferrand ofrece experiencias originales accesibles para todos en equipos de 2 a 4 jugadores.\r\nEn la encrucijada entre el juego de escape y el cine, embárcate en una aventura virtual."
    ],
    "nl": [
      "Virtual Room Clermont-Ferrand biedt originele ervaringen die voor iedereen toegankelijk zijn in teams van 2 tot 4 spelers.\r\nOp het kruispunt tussen het ontsnappingsspel en de bioscoop gaat u op een virtueel avontuur."
    ]
  },
