      "dc:description": {
        "de": [
          "Die Agglo Hénin-Carvin und die Marcheurs de la Gohelle laden Sie zu einer 10 km langen Naturwanderung ein, bei der Sie den Wald entdecken können\nBois des Hautois in Oignies."
        ],
        "en": [
          "The Agglo Hénin-Carvin and the Marcheurs de la Gohelle invite you to a 10 km nature walk to discover the\nBois des Hautois in Oignies."
        ],
        "it": [
          "L'Agglo Hénin-Carvin e i Marcheurs de la Gohelle vi invitano a una passeggiata naturalistica di 10 km alla scoperta del\nBois des Hautois a Oignies."
        ],
        "fr": [
          "L'Agglo Hénin-Carvin et les Marcheurs de la Gohelle vous invitent à une rando nature de 10 kms pour partir à la découverte du\nBois des Hautois à Oignies."
        ],
        "es": [
          "El Agglo Hénin-Carvin y los Marcheurs de la Gohelle le invitan a un paseo natural de 10 km para descubrir el\nBois des Hautois en Oignies."
        ],
        "nl": [
          "De Agglo Hénin-Carvin en de Marcheurs de la Gohelle nodigen je uit voor een natuurwandeling van 10 km om het\nBois des Hautois in Oignies."
        ]
      },
