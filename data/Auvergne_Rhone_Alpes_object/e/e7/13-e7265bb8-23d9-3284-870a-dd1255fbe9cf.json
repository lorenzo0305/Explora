  "rdfs:comment": {
    "de": [
      "Dieses im Naturpark Pilat gelegene Restaurant hält viele geschmackliche Überraschungen für Sie bereit. Die Speisekarte wechselt regelmäßig, je nach Jahreszeit und Inspiration des Küchenchefs Mickaël."
    ],
    "en": [
      "Located in the Pilat Natural Park, this restaurant has plenty of surprises in store for you. The menu changes regularly according to the seasons and the inspiration of head chef Mickaël."
    ],
    "it": [
      "Situato nel Parco Naturale di Pilat, questo ristorante ha in serbo per voi tante gustose sorprese. Il menu cambia regolarmente in base alle stagioni e all'ispirazione di Mickaël, il capo chef."
    ],
    "fr": [
      "Situé dans le Parc naturel du Pilat, ce restaurant vous réserve bien des surprises gustatives. La carte change régulièrement au grès des saisons et de l’inspiration de Mickaël, le chef de cuisine."
    ],
    "es": [
      "Situado en el Parque Natural de Pilat, este restaurante le reserva sabrosas sorpresas. El menú cambia regularmente según las estaciones y la inspiración de Mickaël, el jefe de cocina."
    ],
    "nl": [
      "Dit restaurant ligt in het natuurpark Pilat en heeft heel wat smakelijke verrassingen voor je in petto. Het menu verandert regelmatig volgens de seizoenen en de inspiratie van Mickaël, de chef-kok."
    ]
  },
