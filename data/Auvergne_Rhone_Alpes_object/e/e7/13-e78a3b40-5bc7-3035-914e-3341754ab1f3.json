  "rdfs:comment": {
    "de": [
      "Cayrols wurde von dem in Le Rouget geborenen abstrakten Maler Jean Labellie geprägt, von dem einige seiner Werke in der Kirche Sainte-Anne zu sehen sind. Das charmante Dorf, das früher von einer stark befahrenen Straße durchzogen war, hat seine Ruhe wiedergefunden."
    ],
    "en": [
      "Cayrols is marked by the work of abstract painter Jean Labellie, a native of Le Rouget, some of whose works can be seen in the church of Sainte-Anne. Once criss-crossed by a busy road, this charming village has regained all its tranquillity."
    ],
    "it": [
      "Cayrols è segnata dall'opera del pittore astratto Jean Labellie, originario di Le Rouget, di cui si possono ammirare alcune opere nella chiesa di Sainte-Anne. Un tempo attraversato da una strada trafficata, questo incantevole villaggio ha ritrovato tutta la sua tranquillità."
    ],
    "fr": [
      "Cayrols est marqué par l'empreinte du peintre abstrait Jean Labellie, natif du Rouget, dont quelques-unes des œuvres se dévoilent dans l'église Sainte-Anne. Autrefois traversé par un axe routier fréquenté, le charmant village a retrouvé toute sa quiétude."
    ],
    "nl": [
      "Cayrols wordt gekenmerkt door het werk van de abstracte schilder Jean Labellie, een inwoner van Le Rouget, van wie enkele werken te zien zijn in de kerk Sainte-Anne. Dit charmante dorp werd ooit doorkruist door een drukke weg, maar heeft nu al zijn rust teruggekregen."
    ],
    "es": [
      "Cayrols está marcado por la obra del pintor abstracto Jean Labellie, natural de Le Rouget, algunas de cuyas obras pueden verse en la iglesia de Sainte-Anne. Antaño atravesado por una carretera muy transitada, este encantador pueblo ha recuperado toda su tranquilidad."
    ]
  },
