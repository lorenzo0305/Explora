  "rdfs:comment": {
    "de": [
      "Auf dieser Etappe verläuft die Fahrradroute Via Allier auf dem komfortablen Grünen Weg des Großraums Clermont, der Ende 2023 fertiggestellt wird."
    ],
    "en": [
      "On this leg, the Via Allier cycle route follows the comfortable Grand Clermont greenway, due to be completed by the end of 2023."
    ],
    "it": [
      "In questo tratto, la pista ciclabile Via Allier segue la comoda greenway Grand Clermont, che sarà completata alla fine del 2023."
    ],
    "fr": [
      "Sur cette étape la véloroute de la Via Allier emprunte la confortable voie verte du Grand Clermont, finalisée fin 2023."
    ],
    "nl": [
      "Op dit traject volgt de fietsroute Via Allier de comfortabele Grand Clermont greenway, die eind 2023 klaar moet zijn."
    ],
    "es": [
      "En este tramo, la vía ciclista Via Allier sigue la cómoda vía verde Grand Clermont, cuya finalización está prevista para finales de 2023."
    ]
  },
