  "rdfs:comment": {
    "de": [
      "Anlässlich des 400. Geburtstags der Marquise de Sévigné entdecken Sie \"L'Eau de Hongrie\" aus dem Hause Fragonard in Ihrer Parfümerie Brin d'Arômes in Grignan"
    ],
    "en": [
      "To celebrate the 400th anniversary of the Marquise de Sévigné, come and discover \"L'Eau de Hongrie\" by Maison Fragonard at your Brin d'Arômes perfumery in Grignan"
    ],
    "it": [
      "Per celebrare il 400° anniversario della Marchesa di Sévigné, venite a scoprire \"L'Eau de Hongrie\" della Maison Fragonard nella vostra profumeria Brin d'Arômes di Grignan"
    ],
    "fr": [
      "À l'occasion des 400 ans de la Marquise de Sévigné, venez découvrir \"L'Eau de Hongrie\" de la Maison Fragonard dans votre parfumerie Brin d'Arômes à Grignan"
    ],
    "es": [
      "Para celebrar el 400 aniversario de la Marquesa de Sévigné, venga a descubrir \"L'Eau de Hongrie\" de la Casa Fragonard en su perfumería Brin d'Arômes de Grignan"
    ],
    "nl": [
      "Kom ter gelegenheid van de 400e verjaardag van de markiezin van Sévigné \"L'Eau de Hongrie\" van het Huis Fragonard ontdekken in uw parfumerie Brin d'Arômes in Grignan"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Découverte de l'Eau de Hongrie de Fragonard à la Parfumerie Brin d'Arômes"
    ]
  },
