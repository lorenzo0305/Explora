  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen Wellnessbereiche, die jeweils aus einem Hammam, einer Sauna und einem Jacuzzi bestehen. Das Tragen von Badekleidung ist Pflicht. Handtücher und Sandalen werden zur Verfügung gestellt."
    ],
    "en": [
      "We offer wellness areas, each with a hammam, sauna and Jacuzzi. Bathing suit mandatory. Towels and sandals provided."
    ],
    "it": [
      "Offriamo aree benessere, ciascuna con hammam, sauna e jacuzzi. È necessario indossare il costume da bagno. Asciugamani e sandali sono forniti."
    ],
    "fr": [
      "Nous vous proposons des espaces bien-être composés chacun d’un hammam, un sauna et un jacuzzi. Port du maillot de bain obligatoire. Serviettes et sandales fournies."
    ],
    "nl": [
      "We bieden wellnessruimtes, elk met een hamam, sauna en jacuzzi. Het dragen van zwemkleding is verplicht. Handdoeken en sandalen aanwezig."
    ],
    "es": [
      "Disponemos de zonas de bienestar con hammam, sauna y jacuzzi. Es obligatorio llevar bañador. Se proporcionan toallas y sandalias."
    ]
  },
