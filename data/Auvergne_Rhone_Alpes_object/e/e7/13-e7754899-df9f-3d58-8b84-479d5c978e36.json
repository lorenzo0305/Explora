  "rdfs:comment": {
    "de": [
      "Pechaventure bietet Ihnen 100%ige Angelabenteuer: Forellenangeln, Angeln nach Gewicht, Direktverkauf, Verkostung, park'àpêch': ein Angelparcours für Kinder und Erwachsene."
    ],
    "en": [
      "Pechaventure offers you 100% adventure fishing formulas: trout fishing, weight fishing, direct sale, tasting, park 'àpêch': a fishing course for children and adults."
    ],
    "it": [
      "Pechaventure vi offre pacchetti di avventure di pesca al 100%: pesca alla trota, pesca a peso, vendita diretta, degustazione, park'àpêch': un corso di pesca per bambini e adulti."
    ],
    "fr": [
      "Pechaventure  vous propose des formules 100% pêch'aventure : pêche à la truite, pêche au poids, vente directe, dégustation, park'àpêch': un parcours de pêche pour enfants et adultes."
    ],
    "es": [
      "Pechaventure le propone paquetes 100% aventura de pesca: pesca de la trucha, pesca al peso, venta directa, degustación, park'àpêch': un curso de pesca para niños y adultos."
    ],
    "nl": [
      "Pechaventure biedt u 100% visavontuurpakketten: forelvissen, vissen op gewicht, directe verkoop, proeverij, park'àpêch': een viscursus voor kinderen en volwassenen."
    ]
  },
