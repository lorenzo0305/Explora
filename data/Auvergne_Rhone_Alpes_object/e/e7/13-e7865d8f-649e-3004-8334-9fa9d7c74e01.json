  "rdfs:comment": {
    "de": [
      "Das Phänomen aus dem Erfolgsfilm Flashdance kehrt für eine außergewöhnliche Tournee durch ganz Frankreich auf die Bühne zurück!\r\nEin Musical, das die größten Hits der 80er Jahre enthält."
    ],
    "en": [
      "The phenomenon from the hit film Flashdance returns to the stage for an exceptional tour of France!\r\nA musical comedy featuring the greatest hits of the 80s."
    ],
    "it": [
      "Il fenomeno del film di successo Flashdance torna in scena per un eccezionale tour in Francia!\r\nUn musical con i più grandi successi degli anni '80."
    ],
    "fr": [
      "Le phénomène du film à succès Flashdance revient sur scène pour une tournée exceptionnelle dans toute la France !\r\nUne comédie musicale qui comprend les plus grands hits des années 80."
    ],
    "nl": [
      "Het fenomeen uit de hitfilm Flashdance keert terug naar het podium voor een uitzonderlijke tournee door Frankrijk!\r\nEen musical met de grootste hits uit de jaren 80."
    ],
    "es": [
      "El fenómeno de la exitosa película Flashdance vuelve a los escenarios para una gira excepcional por Francia\r\nUn musical con los grandes éxitos de los años 80."
    ]
  },
