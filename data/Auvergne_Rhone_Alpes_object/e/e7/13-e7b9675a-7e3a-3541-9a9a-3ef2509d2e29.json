  "rdfs:comment": {
    "de": [
      "Der Espace Luge befindet sich auf dem Plateau de l'Alpette und steht Ihnen kostenlos zur Verfügung (ab Oz Station, Fußgängerticket oder Skipass für die Seilbahn von l'Alpette müssen mitgebracht werden). Genießen Sie das spielerische Gleiten in einer einzigartigen Umgebung!"
    ],
    "en": [
      "Situated on the Alpette plateau, the Sledding area is at your disposal free of charge (from Oz Station, preview a walker ticket or a skier pass for the Alpette cable car). Enjoy fun sledding in a unique setting!"
    ],
    "it": [
      "Situato sull'altopiano di Alpette, l'Espace Luge è a vostra disposizione gratuitamente (dalla stazione di Oz, biglietto pedonale o skipass per la funivia di Alpette). Godetevi il divertimento della slitta in un ambiente unico!"
    ],
    "fr": [
      "Située sur le plateau de l'Alpette, l'Espace Luge est à votre disposition gratuitement (au départ d'Oz Station, ticket piéton ou forfait à prévoir pour la télécabine de l’Alpette). Profitez de la glisse ludique dans un cadre unique !"
    ],
    "es": [
      "Situado en la meseta de Alpette, el Espace Luge está a su disposición de forma gratuita (desde la estación de Oz, con un billete para peatones o un pase para el teleférico de Alpette). Disfruta de la diversión del trineo en un entorno único"
    ],
    "nl": [
      "De Espace Luge, gelegen op het plateau van de Alpette, staat gratis tot uw beschikking (vanaf station Oz, voetgangerskaart of liftpas voor de Alpette-kabelbaan). Geniet van het plezier van sleeën in een unieke omgeving!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Sledding area - L'Alpette"
    ],
    "fr": [
      "Espace luge - L'Alpette"
    ],
    "nl": [
      "Tobogganing area - l'Alpette"
    ]
  },
