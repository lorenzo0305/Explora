  "rdfs:comment": {
    "de": [
      "Die SESAT, die das Skigebiet Hirmentaz seit 1963 betreibt, ist nach ISO 9001 (seit 2007) und ISO 14001 (im Jahr 2012) zertifiziert."
    ],
    "en": [
      "SESAT, which has been managing the Hirmentaz ski area since 1963, has obtained ISO 9001 (since 2007) and ISO 14001 (in 2012) certification."
    ],
