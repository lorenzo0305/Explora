  "rdfs:comment": {
    "de": [
      "S I G N É ▾ E X T R A I T ist gleichzeitig ein Café, eine Pâtisserie und eine Boutique, in der Sie sich mit E X T R A I T-Kaffee versorgen können.\r\nDas Café bietet den ganzen Tag über ein wechselndes Angebot, vor Ort oder zum Mitnehmen"
    ],
    "en": [
      "S I G N E ▾ E X T R A I T is both a Café, a Pastry Shop and a Boutique to stock up on E X T R A I T coffee.\r\nThe Café offers an evolving offer throughout the day, on site or to take away"
    ],
    "it": [
      "S I G N E ? E X T R A I T è un Caffè, una Pasticceria e una Boutique per acquistare il caffè E X T R A I T.\r\nIl Café offre una gamma di prodotti in continua evoluzione durante tutta la giornata, sul posto o da asporto"
    ],
    "fr": [
      "S I G N É ▾ E X T R A I T est à la fois un Café, une Pâtisserie et une Boutique pour s'approvisionner en café E X T R A I T.\r\nLe Café propose une offre évolutive tout au long de la journée, sur place ou à emporter"
    ],
    "nl": [
      "S I G N É ▾ E X T R A I T is een Café, een Patisserie en een Boutique om E X T R A I T koffie in te slaan.\r\nHet Café biedt de hele dag door een wisselend aanbod van producten, ter plaatse of om mee te nemen"
    ],
    "es": [
      "S I G N E ? E X T R A I T es una cafetería, una pastelería y una boutique para comprar café E X T R A I T.\r\nLa cafetería ofrece una gama cambiante de productos durante todo el día, en el momento o para llevar"
    ]
  },
