  "rdfs:comment": {
    "de": [
      "Sommerrestaurant, in ruhiger Lage im Dorf und mit einem atemberaubenden Blick auf den Fluss Criou. Die Speisekarte: eine schmackhafte Mischung aus Bistroküche und sommerlichen Fantasien, die sich je nach Inspiration des Küchenchefs mit lokalen und saisonalen Produkten weiterentwickelt."
    ],
    "en": [
      "Summer restaurant, in the quiet village with a breathtaking view of Le Criou. The menu: a delicious blend of bistro cuisine and summer fantasies that evolves according to the chef's inspiration, using local and seasonal produce."
    ],
    "it": [
      "Ristorante estivo in un tranquillo villaggio con vista mozzafiato sul Criou. Il menu: un delizioso mix di cucina da bistrot e fantasie estive che si evolve secondo l'ispirazione dello chef, utilizzando prodotti locali e di stagione."
    ],
    "fr": [
      "Restaurant d'été, au calme du village et avec une vue imprenable sur le Criou. La carte : un savoureux mélange de cuisine bistro et de fantaisies estivales qui évolue au fil des inspirations du chef, avec des produits locaux et de saison."
    ],
    "nl": [
      "Zomerrestaurant, rustig gelegen in het dorp en met een adembenemend uitzicht op de Criou. De kaart: een smakelijke mix van bistrokeuken en zomerse fantasieën die evolueert naargelang de inspiratie van de chef, met lokale en seizoensgebonden producten."
    ],
    "es": [
      "Restaurante de verano situado en un tranquilo pueblo con impresionantes vistas al Criou. El menú: una deliciosa mezcla de cocina de bistró y fantasías veraniegas que evoluciona según la inspiración del chef, utilizando productos locales de temporada."
    ]
  },
