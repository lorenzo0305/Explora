  "rdfs:comment": {
    "de": [
      "Der Interpretationsraum des Maison de l'habitat et du patrimoine in Saint-Flour bietet Schlüssel zum Verständnis der Region Est-Cantal, die das Label Pays d'Art & d'Histoire trägt. Zu sehen gibt es eine Dauerausstellung, ein digitales Modell und ein bemerkenswertes Gebäude."
    ],
    "en": [
      "The interpretation area at the Maison de l'habitat et du patrimoine in Saint-Flour, offers keys to understanding the East-Cantal region, which has been awarded the Pays d?Art & d?Histoire label. On view: a permanent exhibition, a digital model and a remarkable building."
    ],
    "it": [
      "Il centro di interpretazione della Maison de l'Habitat et du Patrimoine di Saint-Flour offre chiavi di lettura della regione dell'Est-Cantal, che ha ottenuto il marchio Pays d'Art & d'Histoire. Vi sono una mostra permanente, un modello digitale e un edificio notevole."
    ],
    "fr": [
      "L’espace d’interprétation de la Maison de l’habitat et du patrimoine à Saint-Flour, propose des clefs de lecture de l'Est-Cantal labellisé Pays d’Art & d’Histoire. A voir, une exposition permanente, une maquette numérique et un édifice remarquable."
    ],
    "nl": [
      "Het interpretatiecentrum in het Maison de l'Habitat et du Patrimoine in Saint-Flour biedt sleutels tot het begrijpen van de regio Oost-Cantal, die het label Pays d'Art & d'Histoire heeft gekregen. Er is een permanente tentoonstelling, een digitale maquette en een opmerkelijk gebouw."
    ],
    "es": [
      "El centro de interpretación de la Maison de l'Habitat et du Patrimoine de Saint-Flour ofrece claves para comprender la región del Cantal Oriental, galardonada con el sello Pays d'Art & d'Histoire. Cuenta con una exposición permanente, una maqueta digital y un edificio notable."
    ]
  },
  "rdfs:label": {
