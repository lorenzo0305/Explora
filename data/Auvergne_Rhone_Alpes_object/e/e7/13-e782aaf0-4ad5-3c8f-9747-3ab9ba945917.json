  "rdfs:comment": {
    "de": [
      "Der an der Rückseite der Kathedrale gelegene und am Fluss Thiou entlang führende Kai hat die Besonderheit, dass er einen kleinen, amphitheaterähnlichen Platz bietet."
    ],
    "en": [
      "Located behind the cathedral and running along the Thiou, the quay has the particularity of offering a small amphitheater square."
    ],
    "it": [
      "Situato dietro la cattedrale e costeggiando il Thiou, il molo ha la particolarità di offrire una piccola piazza ad anfiteatro."
    ],
    "fr": [
      "Situé à l'arrière de la cathédrale et longeant le Thiou, le quai a la particularité d'offrir une petite place en amphithéâtre."
    ],
    "es": [
      "Situado detrás de la catedral y bordeando el Thiou, el muelle tiene la particularidad de ofrecer una pequeña plaza en forma de anfiteatro."
    ],
    "nl": [
      "De kade ligt achter de kathedraal en loopt langs de Thiou en heeft de bijzonderheid een klein amfitheaterachtig plein te bieden."
    ]
  },
