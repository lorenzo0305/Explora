  "rdfs:comment": {
    "de": [
      "Familienrestaurant, in dem Geselligkeit herrscht. Eine schöne Dekoration, Blick auf den Serre de Barre, musikalische Untermalung, manchmal Konzerte, Themenabende, großzügige Küche, Aperitifbretter, Cocktails, guter Wein - alles ist vorhanden, damit Sie eine gute Zeit verbringen."
    ],
    "en": [
      "A family restaurant where conviviality reigns. A beautiful decor, views of the Serre de Barre, background music, sometimes concerts, themed evenings, generous cuisine, aperitif boards, cocktails, good wine, everything you need to have a good time."
    ],
    "it": [
      "Un ristorante familiare dove regna la convivialità. Un bell'arredamento, vista sulla Serre de Barre, musica di sottofondo, a volte concerti, serate a tema, cucina generosa, taglieri di aperitivi, cocktail, buon vino, tutto ciò che serve per divertirsi."
    ],
    "fr": [
      "Restaurant familial où règne la convivialité. Une belle déco, vue sur le Serre de Barre, fond musical, parfois concert, soirées à thème, cuisine généreuse, planches apéritives, cocktails, bon vin, tout est réuni pour que vous passiez un bon moment."
    ],
    "es": [
      "Un restaurante familiar donde reina la convivencia. Una bonita decoración, vistas a la Serre de Barre, música de fondo, a veces conciertos, veladas temáticas, cocina generosa, platos de aperitivo, cócteles, buen vino, todo lo necesario para pasar un buen rato."
    ],
    "nl": [
      "Een familierestaurant waar gezelligheid heerst. Een prachtig decor, uitzicht op de Serre de Barre, achtergrondmuziek, soms concerten, thema-avonden, een royale keuken, aperitiefschotels, cocktails, goede wijn, alles wat je nodig hebt om het naar je zin te hebben."
    ]
  },
