  "rdfs:comment": {
    "de": [
      "Glacenost ist ein wunderschöner Wasserfall, der im Winter völlig zugefroren ist. Er ist einer der schönsten in Frankreich und nur für sehr erfahrene Hochgebirgswanderer geeignet."
    ],
    "en": [
      "Glacenost is a magnificent waterfall, completely frozen in winter, one of the most beautiful in France, reserved for the very experienced in the high mountains."
    ],
    "it": [
      "Il Glacenost è una magnifica cascata, completamente ghiacciata in inverno, una delle più belle di Francia, riservata ai più esperti in alta montagna."
    ],
    "fr": [
      "Glacenost est une cascade magnifique, complètement gelée en hiver, une des plus belles de France, réservée aux très expérimentés de la haute montagne."
    ],
    "nl": [
      "Glacenost is een prachtige waterval, volledig bevroren in de winter, een van de mooiste van Frankrijk, voorbehouden aan de zeer ervaren in het hooggebergte."
    ],
    "es": [
      "Glacenost es una magnífica cascada, completamente helada en invierno, una de las más bellas de Francia, reservada a los muy expertos en alta montaña."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ice climbing in Val Cenis - Glacenost, the icy adventure"
    ],
    "fr": [
      "Cascade de glace à Val Cenis - Glacenost, l'aventure glacée"
    ],
    "nl": [
      "Ijsklimmen in Val Cenis - Glacenost, het ijzige avontuur"
    ]
  },
