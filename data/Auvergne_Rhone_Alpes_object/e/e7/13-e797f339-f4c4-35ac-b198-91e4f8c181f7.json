  "rdfs:comment": {
    "de": [
      "Verkostungskeller, in dem die verschiedenen Cuvées des roten, weißen und roséfarbenen Saint-Pourçain sowie die Schaumweine präsentiert werden. Boutique. Kostenlose Verkostung. Einzige Genossenschaft des Weinbaugebiets, die fast 40 genossenschaftliche Winzer vereint."
    ],
    "en": [
      "Tasting cellar featuring Saint-Pourçain reds, whites, rosés and sparkling wines. Gift store. Free tasting. The only cooperative in the vineyard, with nearly 40 cooperative winemakers."
    ],
    "it": [
      "Cantina di degustazione dove vengono presentati i diversi vini rossi, bianchi e rosati di Saint-Pourçain, nonché gli spumanti. Enoteca. Degustazione gratuita di vini. Unica cooperativa nel vigneto, con quasi 40 soci viticoltori."
    ],
    "fr": [
      "Caveau de dégustation où sont présentées les différentes cuvées de Saint-Pourçain rouges, blancs et rosés ainsi que les effervescents. Boutique. Dégustation gratuite. Seule coopérative du vignoble regroupant près de 40 vignerons coopérateurs."
    ],
    "nl": [
      "Proeflokaal waar de verschillende rode, witte en rosé wijnen worden gepresenteerd, als ook de traditioneel geproduceerde wijnen. Winkel. Gratis proeven. De enige coöperatie met 60 samenwerkende wijnbouwers."
    ],
    "es": [
      "Bodega de degustación de los diferentes vinos tintos, blancos y rosados de Saint-Pourçain, así como de los vinos espumosos. Tienda de vinos. Degustación gratuita. Única cooperativa del viñedo, con cerca de 40 viticultores socios."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cellar of the vinegrowers' Union."
    ],
    "fr": [
      "Cave de l'Union des Vignerons"
    ],
    "nl": [
      "Coöperatie van samenwerkende wijnbouwers"
    ]
  },
