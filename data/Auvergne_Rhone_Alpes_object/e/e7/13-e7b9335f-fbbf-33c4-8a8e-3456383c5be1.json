  "rdfs:comment": {
    "de": [
      "Das Office de Tourisme du Pays de Salers führt in seinen 27 Gemeinden das Geocaching ein. Werden Sie ein Geocacher! Entdecken oder wiederentdecken Sie das Pays de Salers in Form einer Schatzsuche für Groß und Klein!"
    ],
    "en": [
      "The Pays de Salers Tourist Office is launching Geocaching in its 27 communes. Become a geocacher! Discover or rediscover the Pays de Salers on a treasure hunt for young and old!"
    ],
    "it": [
      "L'Ufficio del Turismo del Pays de Salers lancia il Geocaching nei suoi 27 comuni. Diventate geocacher! Scoprite o riscoprite il Pays de Salers con una caccia al tesoro per grandi e piccini!"
    ],
    "fr": [
      "L’Office de Tourisme du Pays de Salers lance le Géocaching sur ses 27 communes. Devenez un géocacheur ! Découvrez ou redécouvrez le Pays de Salers sous la forme d'une chasse aux trésors pour les grands et les petits !"
    ],
    "es": [
      "La Oficina de Turismo del País de Salers lanza el Geocaching en sus 27 municipios. ¡Conviértase en geocacher! Descubra o redescubra el Pays de Salers en una búsqueda del tesoro para grandes y pequeños"
    ],
    "nl": [
      "Het Office du Tourisme du Pays de Salers lanceert geocaching in zijn 27 gemeenten. Word geocacher! Ontdek of herontdek het Pays de Salers tijdens een schattenjacht voor jong en oud!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Géocaching en Pays de Salers"
    ]
  },
