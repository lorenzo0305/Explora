  "rdfs:comment": {
    "de": [
      "Probieren Sie einen köstlichen Kebab, einen Hamburger, Tacos oder auch einen Salat. Sie werden von unserer Auswahl an Mahlzeiten vor Ort oder zum Mitnehmen begeistert sein."
    ],
    "en": [
      "Come taste a delicious Kebab, a burger, a tacos or also a salad, you'll be conquered by our choices of meal at table or take off."
    ],
    "it": [
      "Venite mangiare un deliozoso kebab, burger, tacos o ancore un'insalatta, sarete conquistati dei nostri scelti a tavola o da portare."
    ],
    "fr": [
      "Venez déguster un délicieux Kebab, un hamburger, un tacos ou encore une salade, vous serez conquis par nos choix de repas sur place ou à emporter."
    ],
    "es": [
      "Ven a disfrutar de un delicioso kebab, una hamburguesa, un taco o una ensalada. Te encantará nuestra selección de platos para comer en casa o para llevar."
    ],
    "nl": [
      "Kom en geniet van een heerlijke kebab, hamburger, taco of salade. Je zult verrukt zijn van onze keuze aan maaltijden om in te eten of mee te nemen."
    ]
  },
