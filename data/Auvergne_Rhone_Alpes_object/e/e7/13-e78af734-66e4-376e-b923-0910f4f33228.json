  "rdfs:comment": {
    "de": [
      "Jean-Marc bietet Ihnen Wander-, Fahrrad- und Schneeschuhwanderungen für Gruppen und Einzelpersonen an. Seine Spezialität sind Trekking-Touren in Oisans, um den Mont-Blanc, auf der Tour du Queyras, auf der Insel Réunion oder auch auf dem Baikalsee in Sibirien."
    ],
    "en": [
      "Ethiq'Aventure organises hiking, cycling and snowshoeing outings for both individuals and groups. Explore Oisans!"
    ],
    "it": [
      "Jean-Marc propone escursioni a piedi, in bicicletta e con le racchette da neve per gruppi e singoli. La sua specialità: trekking itinerante nell'Oisans, intorno al Monte Bianco, sul Tour du Queyras, sull'Isola della Riunione o sul Lago Baikal in Siberia."
    ],
    "fr": [
      "Jean-Marc vous propose des sorties randonnées, vélo, raquettes pour les groupes & individuels. Sa spécialité : le trekking itinérant en Oisans, autour du Mont-Blanc, sur le Tour du Queyras, sur l’Île de la Réunion, ou encore sur le Lac Baïkal en Sibérie."
    ],
    "nl": [
      "Ontdek Oisans ! \r\nEthiq'Aventure biedt verschillende wandel, -fiets, en sneeuwschoenuitstappen. Zowel individueel als voor groepen."
    ],
    "es": [
      "Jean-Marc ofrece excursiones de senderismo, cicloturismo y paseos con raquetas de nieve para grupos y particulares. Su especialidad: el senderismo itinerante en los Oisans, alrededor del Mont Blanc, en el Tour du Queyras, en la isla Reunión o en el lago Baikal, en Siberia."
    ]
  },
  "rdfs:label": {
