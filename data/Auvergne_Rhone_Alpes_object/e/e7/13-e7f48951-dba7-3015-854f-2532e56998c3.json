  "rdfs:comment": {
    "de": [
      "Illustrierte Plakate aus der Region, die in Morillon gezeichnet und in limitierter Auflage gedruckt wurden. Die schönsten Orte der Region in Form von schlichten, designorientierten Illustrationen. Als originelles Souvenir und zur Dekoration Ihrer Wände."
    ],
    "en": [
      "Illustrated posters of the region, designed in Morillon and printed in limited series. The most beautiful places in the region in pure, designer illustrations. For an original souvenir and to decorate your walls."
    ],
    "it": [
      "Poster illustrati della regione, disegnati a Morillon e stampati in serie limitata. I luoghi più belli della regione sotto forma di illustrazioni pure e di design. Per un souvenir originale e per decorare le vostre pareti."
    ],
    "fr": [
      "Affiches illustrées de la région, dessinées à Morillon et imprimées en série limitée. Les plus beaux lieux de la région sous forme d'illustrations épurées et design. Pour un souvenir original et pour décorer vos murs."
    ],
    "nl": [
      "Geïllustreerde posters van de regio, ontworpen in Morillon en gedrukt in beperkte oplage. De mooiste plekjes van de regio in de vorm van pure, designer illustraties. Voor een origineel souvenir en om je muren mee te versieren."
    ],
    "es": [
      "Carteles ilustrados de la región, diseñados en Morillon e impresos en series limitadas. Los lugares más bellos de la región en forma de ilustraciones puras y de diseño. Para un recuerdo original y para decorar sus paredes."
    ]
  },
  "rdfs:label": {
