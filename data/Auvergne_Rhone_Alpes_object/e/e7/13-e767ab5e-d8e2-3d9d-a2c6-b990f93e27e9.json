  "rdfs:comment": {
    "de": [
      "Fast zwei Millionen Jahre alte Lavaströme bilden den felsigen Aussichtspunkt, der die Schluchten der Loire und der Langougnole überblickt."
    ],
    "en": [
      "Lava flows nearly two million years old form the rocky belvedere overlooking the Loire and Langougnole gorges."
    ],
    "it": [
      "Colate laviche di quasi due milioni di anni formano il belvedere roccioso che domina le gole della Loira e di Langougnole."
    ],
    "fr": [
      "Des coulées de lave de près de deux millions d'années constituent le belvédère rocheux qui domine les gorges de la Loire et de la Langougnole."
    ],
    "nl": [
      "Lavastromen van bijna twee miljoen jaar oud vormen het rotsachtige uitkijkpunt dat uitkijkt over de kloven van de Loire en Langougnole."
    ],
    "es": [
      "Coladas de lava de casi dos millones de años forman el mirador rocoso que domina las gargantas del Loira y de Langougnole."
    ]
  },
