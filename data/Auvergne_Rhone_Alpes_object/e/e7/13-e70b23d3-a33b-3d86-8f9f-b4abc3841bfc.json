  "rdfs:comment": {
    "de": [
      "Das Restaurant genießt einen schönen Blick auf das Plateau von Solaison und die Pointe d'Andey und bietet Ihnen die Spezialitäten der Savoyen: Kartoffelkrapfen, Rabolais, Tartiflette, Fondue, Krustenbraten, Wurstwaren..."
    ],
    "en": [
      "Boasting an amazing view over the Plateau de Solaison and the Pointe d'Andey, the restaurant serves a range of Savoyard specialities: potato fritters, rabolais, tartiflette, fondue \"croûte\", charcuterie..."
    ],
    "it": [
      "Con una splendida vista sull'altopiano di Solaison e sulla Pointe d'Andey, il ristorante offre specialità savoiarde: frittelle di patate, rabolais, tartiflette, fonduta, croûte, salumi..."
    ],
    "fr": [
      "Bénéficiant d'une belle vue sur le plateau de Solaison et la pointe d'Andey, le restaurant vous propose les spécialités savoyardes : beignets de pommes de terre, rabolais, tartiflette, fondue, croûte, charcuterie..."
    ],
    "nl": [
      "Met een prachtig uitzicht op het plateau van Solaison en de Pointe d'Andey biedt het restaurant Savoyaardse specialiteiten: aardappelbeignets, rabolais, tartiflette, fondue, croûte, vleeswaren..."
    ],
    "es": [
      "Con una hermosa vista de la meseta de Solaison y de la Pointe d'Andey, el restaurante ofrece especialidades saboyanas: buñuelos de patata, rabolais, tartiflette, fondue, croûte, charcutería..."
    ]
  },
  "rdfs:label": {
