  "rdfs:comment": {
    "de": [
      "Auf Entdeckungsreise in vergangene Zeiten...\r\nDieser von der Vereinigung \"Les Godas\" vorgeschlagene Rundgang wechselt zwischen Naturansichten und dem Eintauchen in die Geschichte von Montceau.\r\nDurchstreifen Sie das Dorf auf der Suche nach den Stationen, die den Rundweg markieren."
    ],
    "en": [
      "Discovering the past...\r\nThis trail, proposed by the \"Les Godas\" association, alternates views of nature with an insight into Montceau's history.\r\nStroll through the village in search of the milestones along the way."
    ],
    "it": [
      "Alla scoperta del passato...\r\nQuesto percorso proposto dall'associazione \"Les Godas\" alterna scorci di natura a un'immersione nella storia di Montceau.\r\nPasseggiate nel villaggio alla ricerca delle pietre miliari lungo il percorso."
    ],
    "fr": [
      "A la découverte du temps passé...\r\nCe parcours proposé par l'association \"Les Godas\" alterne vues de nature et plongée dans l'histoire de Montceau.\r\nParcourez le village à la recherche des étapes qui jalonnent le circuit."
    ],
    "nl": [
      "Het verleden ontdekken...\r\nDit wandelpad, voorgesteld door de vereniging \"Les Godas\", wisselt uitzicht op de natuur af met een duik in de geschiedenis van Montceau.\r\nWandel door het dorp op zoek naar de mijlpalen onderweg."
    ],
    "es": [
      "Descubrir el pasado...\r\nEste sendero propuesto por la asociación \"Les Godas\" alterna vistas de la naturaleza con una inmersión en la historia de Montceau.\r\nPasee por el pueblo en busca de los hitos del camino."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit découverte du patrimoine local de Montceau"
    ]
  },
