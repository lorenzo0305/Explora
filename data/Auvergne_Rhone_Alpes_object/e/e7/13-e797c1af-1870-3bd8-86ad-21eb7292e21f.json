  "rdfs:comment": {
    "de": [
      "Vom Anfänger auf der Suche nach neuen Sensationen bis zum Experten auf der Suche nach sportlichen oder technischen Höchstleistungen: Entdecken Sie das elektrische (E-Bike) oder klassische Mountainbike in aller Sicherheit."
    ],
    "en": [
      "From beginners discovering new sensations to experts looking for sporting or technical feats, come and discover electric mountain biking (E-bike) or classic mountain biking in complete safety."
    ],
    "it": [
      "Dai principianti alla scoperta di nuove sensazioni agli esperti in cerca di imprese sportive o tecniche, venite a scoprire la mountain bike elettrica (E-bike) o la mountain bike classica in tutta sicurezza."
    ],
    "fr": [
      "Du débutant en découverte de nouvelles sensations à l’expert en recherche d’exploit sportif ou technique, venez découvrir le VTT électrique (E-bike) ou classique en toute sécurité."
    ],
    "nl": [
      "Van beginners die nieuwe sensaties ontdekken tot experts op zoek naar sportieve of technische hoogstandjes, kom en ontdek elektrisch mountainbiken (E-bike) of klassiek mountainbiken in alle veiligheid."
    ],
    "es": [
      "Desde principiantes que descubren nuevas sensaciones hasta expertos que buscan hazañas deportivas o técnicas, venga a descubrir la bicicleta de montaña eléctrica (E-bike) o la bicicleta de montaña clásica con total seguridad."
    ]
  },
