  "rdfs:comment": {
    "de": [
      "Schauen Sie sich in diesem charmanten Verkostungskeller um und entdecken Sie die von Claude Collomb hergestellten Bugey-Weine: Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse und Perlwein Méthode traditionnelle."
    ],
    "en": [
      "Take a tour of this charming tasting cellar and discover the Bugey wines produced by Claude Collomb: Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse and traditional method sparkling wine."
    ],
    "it": [
      "Fate un giro in questa affascinante cantina di degustazione e scoprite i vini Bugey prodotti dal Domaine Collomb: Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse e spumante metodo tradizionale."
    ],
    "fr": [
      "Faites un tour dans ce charmant caveau de dégustation et découvrez les vins du Bugey produits au Domaine Collomb : Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse et pétillant Méthode traditionnelle."
    ],
    "nl": [
      "Volg een rondleiding door deze charmante degustatiekelder en ontdek de Bugey-wijnen die op Domaine Collomb worden geproduceerd: Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse en mousserende wijn volgens de traditionele methode."
    ],
    "es": [
      "Haga un recorrido por esta encantadora bodega de degustación y descubra los vinos Bugey producidos en el Domaine Collomb: Chardonnay, Roussette du Bugey, Rosé, Pinot, Gamay, Mondeuse y vino espumoso de método tradicional."
    ]
  },
