  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dbf03890-9c9d-305a-8168-ec75c8233cd3",
      "dc:description": {
        "de": [
          "Forellenangelstrecke auf 4 Teichen. Kleine Ecke des Paradieses, ideal zum Angeln mit der Familie oder mit Freunden.\nVerkauf von kleinen Angelgeräten und Ködern."
        ],
        "en": [
          "Trout fishing on 4 ponds. A little corner of paradise, ideal for fishing with family and friends.\nSmall fishing tackle and bait for sale."
        ],
        "it": [
          "Pesca alla trota in 4 laghetti. Un piccolo angolo di paradiso, ideale per pescare con la famiglia o con gli amici.\nVendita di attrezzatura per la piccola pesca e di esche."
        ],
        "fr": [
          "Parcours de pêche à la truite sur 4 étangs. Petit coin de paradis idéal pour la pêche en famille ou entre amis.\nVente de petits matériels de pêche et d'appâts."
        ],
        "es": [
          "Pesca de truchas en 4 estanques. Un pequeño rincón del paraíso, ideal para pescar en familia o con amigos.\nVenta de pequeños aparejos de pesca y cebos."
        ],
        "nl": [
          "Forelvissen op 4 vijvers. Een klein stukje paradijs, ideaal om te vissen met familie of vrienden.\nKleine visuitrusting en aas te koop."
        ]
      },
