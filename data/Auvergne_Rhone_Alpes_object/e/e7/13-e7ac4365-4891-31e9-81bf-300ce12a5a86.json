  "rdfs:comment": {
    "de": [
      "David und Sandra empfangen Sie in einer familiären und herzlichen Atmosphäre, nur wenige Schritte vom Palais Idéal entfernt. Hausgemachte Küche aus frischen und lokalen Produkten, pochierte oder überbackene Ravioli, Salate, hausgemachte Pizzen, hausgemachte Burger, Desserts und Eis."
    ],
    "en": [
      "David and Sandra welcome you in a warm, family atmosphere, a stone's throw from the Ideal Palace. Home cooking made with fresh and local products, poached or gratin raviole, salads, homemade pizzas, homemade burgers, desserts and ice cream."
    ],
    "it": [
      "David e Sandra vi accolgono in una calda atmosfera familiare, a pochi passi dal Palais Idéal. Cucina casalinga preparata con prodotti freschi e locali, ravioles in camicia o gratinati, insalate, pizze fatte in casa, hamburger fatti in casa, dolci e gelati."
    ],
    "fr": [
      "David et Sandra vous accueillent dans une ambiance familiale et chaleureuse, à deux pas du Palais Idéal. Cuisine maison élaborée avec des produits frais et locaux, ravioles pochés ou gratinés, salades, pizzas maison, burgers maison, desserts et glaces."
    ],
    "es": [
      "David y Sandra le dan la bienvenida en un cálido ambiente familiar, a pocos pasos del Palais Idéal. Cocina casera elaborada con productos frescos y locales, ravioles escalfados o gratinados, ensaladas, pizzas caseras, hamburguesas caseras, postres y helados."
    ],
    "nl": [
      "David en Sandra verwelkomen je in een warme familiesfeer, op een steenworp van het Palais Idéal. Huisgemaakte gerechten met verse streekproducten, gepocheerde of gegratineerde ravioli, salades, zelfgemaakte pizza's, zelfgemaakte hamburgers, desserts en ijsjes."
    ]
  },
