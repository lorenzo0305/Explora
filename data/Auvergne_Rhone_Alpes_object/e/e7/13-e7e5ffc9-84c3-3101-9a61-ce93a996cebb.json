  "rdfs:comment": {
    "de": [
      "Der Festsaal ist ein wertvolles Instrument für Vereine, Organisationen, Verbände, Verwaltungen und Unternehmen.\r\nDer große Saal bietet Platz für bis zu 700 Personen im Stehen und 350 Personen in einer Essenskonfiguration."
    ],
    "en": [
      "The festival hall is a valuable tool for associations, organizations, federations, administrations and companies.\r\nThe large hall can accommodate up to 700 people standing, 350 people in meal configuration."
    ],
    "it": [
      "Il salone del festival è uno strumento prezioso per associazioni, organizzazioni, federazioni, amministrazioni e aziende.\r\nLa grande sala può ospitare fino a 700 persone in piedi e 350 persone per i pasti."
    ],
    "fr": [
      "La salle des fêtes est un outil précieux pour les associations, organismes, fédérations, administrations et entreprises.\r\nLa grande salle peut recevoir jusqu’à 700 personnes debout, 350 personnes en configuration repas."
    ],
    "es": [
      "La sala de fiestas es una valiosa herramienta para asociaciones, organizaciones, federaciones, administraciones y empresas.\r\nLa gran sala puede albergar hasta 700 personas de pie y 350 para las comidas."
    ],
    "nl": [
      "Het dorpshuis is een waardevol instrument voor verenigingen, organisaties, federaties, administraties en bedrijven.\r\nDe grote zaal biedt plaats aan maximaal 700 personen staand en 350 personen bij de maaltijd."
    ]
  },
