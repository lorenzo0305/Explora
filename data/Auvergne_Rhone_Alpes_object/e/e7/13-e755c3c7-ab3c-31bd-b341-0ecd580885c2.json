  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine reizvolle Mountainbike-Tour unterhalb des Dorfes im Schatten der Bäume auf den Spuren von Sorlinette, dem Maskottchen von Saint Sorlin."
    ],
    "en": [
      "Set off on a delightful mountain bike ride below the village, in the shade of the trees, in the footsteps of Sorlinette, Saint Sorlin's mascot."
    ],
    "it": [
      "Partite per un'incantevole passeggiata in mountain bike sotto il villaggio, all'ombra degli alberi, sulle orme di Sorlinette, la mascotte di Saint Sorlin."
    ],
    "fr": [
      "Partez pour une charmante balade VTT en contrebas du village, à l’ombre des arbres, sur les traces de Sorlinette, la mascotte de Saint Sorlin."
    ],
    "nl": [
      "Vertrek voor een heerlijke mountainbiketocht onder het dorp, in de schaduw van de bomen, in de voetsporen van Sorlinette, de mascotte van Saint Sorlin."
    ],
    "es": [
      "Emprenda un delicioso paseo en bicicleta de montaña por debajo del pueblo, a la sombra de los árboles, siguiendo los pasos de Sorlinette, la mascota de Saint Sorlin."
    ]
  },
  "rdfs:label": {
