  "rdfs:comment": {
    "de": [
      "Dieser Familienbetrieb produziert Fleisch aus der Ferkelaufzucht in Freilandhaltung. Weißer und getrockneter Schinken, Würste und Salami werden mit Salz, Pfeffer und Gewürzen zubereitet. Bei der Zubereitung werden keine Konservierungs- oder Farbstoffe verwendet."
    ],
    "en": [
      "This family-run business produces meat from free-range piglets. White and cured hams, sausages and salami are prepared with salt, pepper and spices. No preservatives or colorants are used in preparation."
    ],
    "it": [
      "Questa azienda a conduzione familiare produce carne da maiali allevati all'aperto. Prosciutti bianchi e stagionati, salsicce e salami sono preparati con sale, pepe e spezie. Nella loro preparazione non vengono utilizzati conservanti o coloranti."
    ],
    "fr": [
      "Cette exploitation familiale produit des viandes issues d'élevages de porcelets en plein air. Jambons blancs et secs, saucisses et saucissons sont préparés avec sel, poivre et épices. Aucun conservateur ni colorant n'est utilisé dans la préparation."
    ],
    "es": [
      "Esta empresa familiar produce carne de lechones criados en libertad. Los jamones blancos y curados, las salchichas y el salami se preparan con sal, pimienta y especias. En su elaboración no se utilizan conservantes ni colorantes."
    ],
    "nl": [
      "Dit familiebedrijf produceert vlees van scharrelvarkens. Witte en gerookte hammen, worsten en salami worden bereid met zout, peper en kruiden. Bij de bereiding worden geen conserveringsmiddelen of kleurstoffen gebruikt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "EARL Gigandon & fils"
    ]
  },
