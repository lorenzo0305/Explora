  "rdfs:comment": {
    "de": [
      "Betrieb mit biologischem Gemüseanbau. Mikrofarm mit 1 Hektar Fläche, die hauptsächlich mit MSV (maraîchage sur sol vivant) bewirtschaftet wird. 120 verschiedene Gemüsesorten werden angebaut und 100 Obstbäume gepflanzt."
    ],
    "en": [
      "Organic market gardening. This 1-hectare micro-farm uses MSV (maraîchage sur sol vivant - market gardening on living soil) as its main cultivation technique, growing over 120 different vegetables and planting around 100 fruit trees."
    ],
    "it": [
      "Orto biologico. Questa microfattoria di un ettaro utilizza l'MSV (orticoltura in terra viva) come tecnica di coltivazione principale, coltivando oltre 120 ortaggi diversi e piantando un centinaio di alberi da frutto."
    ],
    "fr": [
      "Exploitation en maraîchage biologique. Micro ferme d’1 hectare, la principale technique culturale utilisée est d’inspiration MSV (maraîchage sur sol vivant).Plus de 120 légumes divers et variés y sont cultivés et une centaine de fruitiers ont été plantés."
    ],
    "es": [
      "Horticultura ecológica. Esta microgranja de 1 hectárea utiliza la MSV (huerta de suelo vivo) como principal técnica de cultivo, cultiva más de 120 hortalizas diferentes y planta un centenar de árboles frutales."
    ],
    "nl": [
      "Biologisch tuinieren. Deze microboerderij van 1 hectare maakt gebruik van MSV (levende grond tuinieren) als belangrijkste teelttechniek, waarbij meer dan 120 verschillende groenten worden verbouwd en ongeveer honderd fruitbomen worden geplant."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de l'Oasis"
    ]
  },
