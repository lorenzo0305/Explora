  "rdfs:comment": {
    "de": [
      "15 Bahnen gegenüber dem Strand. Schnellrestaurants. Geburtstagsnachmittage können mittwochs, samstags und während der Schulferien täglich nach vorheriger Reservierung organisiert werden. Konzerte an Freitagabenden von Mai bis September."
    ],
    "en": [
      "15 tracks facing the beach. Fast food. Possibility to organize a birthday afternoon on Wednesdays, Saturdays, and every day during school holidays, by reservation. Concerts on Friday and Saturday evenings from May to September."
    ],
    "it": [
      "15 piste di fronte alla spiaggia. Cibi veloci. Possibilità di organizzare un pomeriggio di compleanno il mercoledì, il sabato e tutti i giorni durante le vacanze scolastiche, su prenotazione. Concerti il venerdì e il sabato sera da maggio a settembre."
    ],
    "fr": [
      "15 pistes face à la plage. Restauration rapide. Possibilité d'organiser un après-midi anniversaire les mercredis, samedis et tous les jours durant les vacances scolaires, sur réservation. Concerts les vendredis soirs de mai a septembre."
    ],
    "nl": [
      "15 pistes tegenover het strand. Fast-food restaurant. Mogelijkheid om een verjaardagsmiddag te organiseren op woensdag, zaterdag en elke dag tijdens de schoolvakanties, na reservering. Concerten op vrijdagavond van mei tot september."
    ],
    "es": [
      "15 pistas frente a la playa. Restaurante de comida rápida. Posibilidad de organizar una tarde de cumpleaños los miércoles, sábados y todos los días durante las vacaciones escolares, previa reserva. Conciertos los viernes por la noche de mayo a septiembre."
    ]
  },
