  "rdfs:comment": {
    "de": [
      "Im Herzen von Tournemire, das zu den schönsten Dörfern Frankreichs zählt, in der Nähe des Château d'Anjony. Eine erfinderische bistronomische Küche mit neu interpretierten regionalen Produkten, die Sie im Saal mit Panoramablick auf das Tal der Doire genießen können."
    ],
    "en": [
      "New : a gastropub in Tournemire."
    ],
    "it": [
      "Nel cuore di Tournemire, classificato come uno dei più bei villaggi di Francia, vicino allo Château d'Anjony. Una cucina bistronomica e inventiva a base di prodotti regionali rivisitati da gustare nella sala da pranzo con vista panoramica sulla valle della Doire."
    ],
    "fr": [
      "Au coeur de Tournemire classé parmi les Plus Beaux Villages de France, à proximité du château d’Anjony. Une cuisine bistronomique et inventive à base de produits régionaux revisités à déguster dans la salle avec vue panoramique sur la vallée de la Doire."
    ],
    "nl": [
      "In het hart van Tournemire, geklasseerd als één van de Mooiste Dorpen van Frankrijk, vlakbij het Château d'Anjony. Een bistronomische en inventieve keuken op basis van hergebruikte regionale producten om van te genieten in de eetzaal met een panoramisch uitzicht op de Doire-vallei."
    ],
    "es": [
      "En el corazón de Tournemire, clasificado como uno de los Pueblos más Bonitos de Francia, cerca del Château d'Anjony. Una cocina bistronómica e inventiva basada en productos regionales revisitados que se disfruta en el comedor con una vista panorámica del valle del Doire."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Petite Grange"
    ],
    "fr": [
      "La Petite Grange"
    ]
  },
