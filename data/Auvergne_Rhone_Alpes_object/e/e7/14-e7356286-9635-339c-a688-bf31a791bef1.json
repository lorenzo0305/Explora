  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b11212ae-a47a-3895-be6c-e093468434b1",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck und Konditoreiwaren\n\nÖffnungszeiten:\nMontag, Dienstag, Donnerstag, Freitag, Samstag und Sonntag: 7:00-12:45 Uhr\n\nMittwoch geschlossen\n\nBestellung:\nBestellung per Telefon unter 03.21.73.34.61 möglich\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\nTouren finden in der Region Sud Artois statt\n\nLieferung auf Tournee:\nDie Touren finden in den umliegenden Gemeinden statt\nErkundigen Sie sich telefonisch, welche Gemeinden beliefert werden\n\n "
        ],
        "en": [
          "Information :\n\nProducts: bread, pastries and cakes\n\nOpening days :\nMonday, Tuesday, Thursday, Friday, Saturday and Sunday: 7am-12.45pm\n\nClosed on Wednesday\n\nOrdering :\nOrder by phone 03.21.73.34.61\n\nCollection:\nTakeaway during bakery opening hours\nRounds take place in South Artois\n\nDelivery-tour:\nRounds take place in the surrounding communes\nCall for details of towns served\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria e dolci\n\nGiorni di apertura :\nLunedì, martedì, giovedì, venerdì, sabato e domenica: 7.00-12.45\n\nChiuso il mercoledì\n\nOrdini :\nGli ordini possono essere effettuati telefonicamente al numero 03.21.73.34.61\n\nRitiro:\nDa asporto durante gli orari di apertura della pasticceria\nLe visite si svolgono nella zona di South Artois\n\nGiro di consegna:\nI giri si svolgono nei comuni circostanti\nChiamare per conoscere i comuni serviti\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: pains, viennoiseries et pâtisseries\n\nJours d'ouverture : \nLe lundi, mardi, jeudi, vendredi, samedi et dimanche: 7h-12h45\n\nFermeture le mercredi\n\nCommande : \nPossibilité de commander par téléphone au 03.21.73.34.61\n\nRetrait :\nÀ emporter aux horaires d'ouverture de la boulangerie\nDes tournées ont lieu dans le Sud Artois\n\nLivraison-tournée:\nDes tournées ont lieu dans les communes aux alentours\nSe renseigner par téléphone pour connaître les communes desservies \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak en taarten\n\nOpeningsdagen :\nMaandag, dinsdag, donderdag, vrijdag, zaterdag en zondag: 7u-12u45\n\nGesloten op woensdag\n\nBestellen :\nBestellingen kunnen telefonisch geplaatst worden op 03.21.73.34.61\n\nAfhalen:\nAfhalen tijdens de openingsuren van de bakkerij\nRondleidingen vinden plaats in de regio Zuid Artois\n\nLeveringsronde:\nRondes in de omliggende gemeenten\nBel voor meer informatie over de steden die worden bediend\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería\n\nDías de apertura :\nLunes, martes, jueves, viernes, sábado y domingo: 7h-12h45\n\nMiércoles cerrado\n\nPedidos :\nLos pedidos pueden hacerse por teléfono llamando al 03.21.73.34.61\n\nRecogida:\nPara llevar durante el horario de apertura de la panadería\nLas visitas tienen lugar en la zona del sur de Artois\n\nRondas de reparto:\nLas rondas tienen lugar en los municipios de los alrededores\nLlame para conocer los municipios atendidos\n\n "
        ]
      },
