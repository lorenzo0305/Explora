  "rdfs:comment": {
    "de": [
      "Einmaliges Konzert um 16:30 Uhr! The Jeannettes & Orchestre EIM interpretieren die Klassiker (Bach, Fauré, Ravel...) mit aktuellen Klängen neu. Wenn Tradition und Moderne aufeinandertreffen, um 1,5 Stunden lang eine musikalische Reise zu unternehmen. Eintritt frei!"
    ],
    "en": [
      "One-off concert at 4.30pm! The Jeannettes & Orchestre EIM revisit the classics (Bach, Fauré, Ravel...) with contemporary sounds. Tradition meets modernity for a 1h30 musical voyage. Free admission!"
    ],
    "it": [
      "Concerto unico alle 16.30! Le Jeannettes e l'Orchestre EIM rivisitano i classici (Bach, Fauré, Ravel...) con un tocco contemporaneo. Tradizione e modernità si incontrano per un viaggio musicale di 1h30. Ingresso libero!"
    ],
    "fr": [
      "Concert unique à 16h30 ! The Jeannettes & Orchestre EIM revisitent les classiques (Bach, Fauré, Ravel...) avec des sonorités actuelles. Quand tradition et modernité se rencontrent pour 1h30 de voyage musical. Entrée libre !"
    ],
    "nl": [
      "Een eenmalig concert om 16.30 uur! De Jeannettes & Orchestre EIM hernemen de klassiekers (Bach, Fauré, Ravel...) met een hedendaagse twist. Traditie en moderniteit ontmoeten elkaar voor een muzikale reis van 1u30. Gratis toegang!"
    ],
    "es": [
      "Concierto único a las 16:30 h Las Jeannettes y la Orquesta EIM revisitan los clásicos (Bach, Fauré, Ravel...) con un toque contemporáneo. Tradición y modernidad se dan la mano en un viaje musical de 1h30. Entrada gratuita"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert The Jeannettes et l'orchestre de Pays EIM"
    ]
  },
