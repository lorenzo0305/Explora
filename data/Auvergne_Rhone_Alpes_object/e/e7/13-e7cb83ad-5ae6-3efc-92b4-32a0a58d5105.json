  "rdfs:comment": {
    "de": [
      "Restaurant mit traditionelle Küche der Savoyen in authentischem und strahlendem Dekor. Auf der großen Panoramaterrasse mit herrlicher Aussicht auf die Berggipfel werden Cocktails und Aperitif-Drinks am Kaminfeuer serviert."
    ],
    "en": [
      "Traditional Savoyard cuisine served in a tradional and bright setting.  The resturant has a large panoramic terrace with exceptional mountain views and offers cocktails and aperitifs by the log fire."
    ],
    "it": [
      "Cucina tradizionale savoiarda in un ambiente luminoso e autentico. Il ristorante dispone di un'ampia terrazza panoramica con una vista eccezionale sulle cime e offre cocktail e aperitivi accanto al fuoco."
    ],
    "fr": [
      "Cuisine traditionnelle savoyarde dans un décor authentique et lumineux. Le Restaurant dispose d’une grande terrasse panoramique avec une vue exceptionnelle sur les sommets et propose cocktails et apéritifs à prendre au coin d’un feu de cheminée."
    ],
    "nl": [
      "Restaurant met traditionele Savoyaardse keuken in een authentiek en zonnig decor. Het restaurant beschikt over een groot panoramisch terras met een prachtig uitzicht op de spitsen en biedt cocktails en borrels rond de open haard."
    ],
    "es": [
      "Cocina tradicional saboyana en un marco luminoso y auténtico. El restaurante dispone de una gran terraza panorámica con una vista excepcional de las cumbres y ofrece cócteles y aperitivos junto al fuego."
    ]
  },
