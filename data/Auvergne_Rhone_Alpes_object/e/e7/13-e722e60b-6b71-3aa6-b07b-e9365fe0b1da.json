  "rdfs:comment": {
    "de": [
      "Die Bibliothek ist ein Ort, der allen offen steht und auch für Menschen mit eingeschränkter Mobilität zugänglich ist, wo man vor Ort lesen (kostenlos) oder ausleihen (Abonnent) kann\r\nSie können dort ein Buch reservieren lassen oder den Kauf eines Buches vorschlagen."
    ],
    "en": [
      "The library is a place open to all, accessible to people with reduced mobility where you can read on site (free) or borrow (subscriber)\r\nYou can reserve a book or suggest a purchase."
    ],
    "it": [
      "La biblioteca è un luogo aperto a tutti, accessibile alle persone con mobilità ridotta, dove è possibile leggere sul posto (gratuitamente) o prendere in prestito (abbonati)\r\nÈ possibile prenotare un libro o suggerirne l'acquisto."
    ],
    "fr": [
      "La bibliothèque est un lieu ouvert à tous, accessible aux personnes à mobilité réduite où l’on peut lire sur place (gratuit) ou emprunter (abonné). \r\nVous pouvez y faire réserver un livre ou en suggérer l’achat ."
    ],
    "es": [
      "La biblioteca es un lugar abierto a todos, accesible a las personas con movilidad reducida, donde se puede leer in situ (gratis) o en préstamo (abonado)\r\nPuede reservar un libro o sugerir una compra."
    ],
    "nl": [
      "De bibliotheek is een voor iedereen toegankelijke plaats, toegankelijk voor personen met beperkte mobiliteit, waar u ter plaatse kunt lezen (gratis) of lenen (abonnee)\r\nU kunt een boek reserveren of een aankoop voorstellen."
    ]
  },
  "rdfs:label": {
