  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine authentische Familienmühle! Eingebettet am Ende einer Sackgasse wird Sie Ihre Neugierde dazu führen, die Mühle zu besichtigen und zu verstehen, warum die Tanche-Olive untrennbar mit Nyons verbunden ist. Besichtigung, Verkostung: Wir freuen uns darauf, einen geselligen Moment mit Ihnen zu teilen."
    ],
    "en": [
      "Come and discover an authentic family mill! Nestled at the end of a cul-de-sac, your curiosity will lead you to visit and understand why the Tanche olive is inseparable from Nyons. Visit, taste: we look forward to sharing a convivial moment with you."
    ],
    "it": [
      "Venite a scoprire un autentico frantoio familiare! Nascosto alla fine di un vicolo cieco, la vostra curiosità vi porterà a visitarlo e a capire perché l'oliva di Tanche è inseparabile da Nyons. Visita, assaggio: non vediamo l'ora di condividere con voi un momento di convivialità."
    ],
    "fr": [
      "Venez Découvrir un authentique moulin familial ! Niché au fond d'une impasse la curiosité vous mènera à visiter et comprendre pourquoi l'olive Tanche est indissociable de Nyons. Visite, dégustation : au plaisir de partager un moment convivial avec vous."
    ],
    "es": [
      "¡Venga a descubrir un auténtico molino familiar! Escondido al final de una calle sin salida, su curiosidad le llevará a visitarlo y a comprender por qué la aceituna Tanche es inseparable de Nyons. Visite, saboree: estamos deseando compartir con usted un momento de convivencia."
    ],
    "nl": [
      "Kom en ontdek een authentieke familiemolen! Verstopt aan het einde van een doodlopende weg, zal uw nieuwsgierigheid u leiden naar een bezoek en begrijpen waarom de Tanche olijf onlosmakelijk verbonden is met Nyons. Bezoek, proef: we kijken ernaar uit om een gezellig moment met u te delen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée du Moulin à Huile Ramade"
    ]
  },
