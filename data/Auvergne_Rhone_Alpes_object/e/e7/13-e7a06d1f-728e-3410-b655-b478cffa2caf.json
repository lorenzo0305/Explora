  "rdfs:comment": {
    "de": [
      "Der Sessellift Pointe de Nyon, der sich im Sektor Nyon befindet, ermöglicht den Zugang zum Pas de l'Aigle. Er ist im Winter für Skifahrer geöffnet und im Sommer nur für Fußgänger zugänglich."
    ],
    "en": [
      "The Pointe de Nyon chairlift, located in the Nyon sector, provides access to the Pas de l'Aigle. Open to skiers in winter, it is accessible to pedestrians only in summer."
    ],
    "it": [
      "La seggiovia Pointe de Nyon, situata nel settore di Nyon, consente di accedere al Pas de l'Aigle. Aperta agli sciatori in inverno, è accessibile solo ai pedoni in estate."
    ],
    "fr": [
      "Le télésiège de la Pointe de Nyon, situé sur le secteur de Nyon, permet d’accéder au Pas de l’Aigle. Ouvert aux skieurs en hiver, il est accessible aux piétons uniquement en été."
    ],
    "es": [
      "El telesilla Pointe de Nyon, situado en el sector de Nyon, da acceso al Pas de l'Aigle. Abierto a los esquiadores en invierno, solo es accesible a los peatones en verano."
    ],
    "nl": [
      "De Pointe de Nyon stoeltjeslift, gelegen in de sector Nyon, biedt toegang tot de Pas de l'Aigle. In de winter geopend voor skiërs, in de zomer alleen toegankelijk voor voetgangers."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pointe de Nyon Chairlift"
    ],
    "fr": [
      "Télésiège de la Pointe de Nyon"
    ],
    "nl": [
      "Pointe de Nyon stoeltjeslift"
    ]
  },
