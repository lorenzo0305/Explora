  "rdfs:comment": {
    "de": [
      "Eine außergewöhnliche Besichtigung! Lassen Sie sich die Geschichte eines erstaunlichen Industrieerbes erzählen: Der Fremdenführer lässt Sie in eine Zeit eintauchen, in der es noch keine Kühl- und Gefrierschränke gab, und würdigt die harte Arbeit der Angestellten in den Eisfabriken."
    ],
    "en": [
      "An exceptional visit! Let us tell you the story of an astonishing industrial heritage: the guide takes you back to a time when refrigerators and freezers didn't exist, and pays tribute to the hard work of ice-cream factory employees."
    ],
    "it": [
      "Una visita eccezionale! Lasciatevi raccontare la storia di un patrimonio industriale sorprendente: la guida vi riporterà indietro nel tempo, quando frigoriferi e congelatori non esistevano, e renderà omaggio al duro lavoro dei dipendenti delle gelaterie."
    ],
    "fr": [
      "Visite exceptionnelle ! Laissez-vous conter l'histoire d'un étonnant patrimoine industriel : le guide vous fait revivre un temps où les frigos et congélateurs n'existaient pas et rend hommage au dur labeur des employés des glacières."
    ],
    "es": [
      "Una visita excepcional Deje que el guía le transporte a una época en la que no existían los frigoríficos ni los congeladores, y rinda homenaje al duro trabajo de los empleados de las fábricas de helados."
    ],
    "nl": [
      "Een uitzonderlijk bezoek! Laat ons je het verhaal vertellen van een verbazingwekkend industrieel erfgoed: de gids neemt je mee terug naar een tijd waarin koelkasten en vriezers nog niet bestonden en brengt hulde aan het harde werk van de werknemers van de ijsfabriek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guided tour - Les Glacières de Sylans"
    ],
    "fr": [
      "Instants visites - Les Glacières de Sylans"
    ]
  },
