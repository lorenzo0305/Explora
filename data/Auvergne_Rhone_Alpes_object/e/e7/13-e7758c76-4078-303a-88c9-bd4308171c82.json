  "rdfs:comment": {
    "de": [
      "Der 10,8 km lange Fluss entspringt in der Gemeinde Rochefort Samson und mündet in Bourg de Péage in die Isère (am Fuße des Schlosses Favor), nachdem er u. a. den Bois des Naix durchquert hat."
    ],
    "en": [
      "10.8 km long, it rises in the commune of Rochefort Samson and joins the Isère (at the foot of the Château de Favor) in Bourg de Péage, after crossing the Bois des Naix."
    ],
    "it": [
      "Lungo 10,8 km, nasce nel comune di Rochefort Samson e si unisce all'Isère (ai piedi del Château de Favor) a Bourg de Péage dopo aver attraversato il Bois des Naix."
    ],
    "fr": [
      "Long de 10,8 km, il prend sa source sur la commune de Rochefort Samson et vient rejoindre l'Isère (au pied du Château de Favor) à Bourg de Péage après avoir notamment traversé le Bois des Naix."
    ],
    "nl": [
      "Deze 10,8 km lange rivier ontspringt in de gemeente Rochefort Samson en mondt uit in de Isère (aan de voet van het Château de Favor) in Bourg de Péage nadat hij door het Bois des Naix is getrokken."
    ],
    "es": [
      "Con 10,8 km de longitud, nace en el municipio de Rochefort Samson y se une al Isère (al pie del castillo de Favor) en Bourg de Péage tras atravesar el Bois des Naix."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rivière le Charlieu"
    ]
  },
