  "rdfs:comment": {
    "de": [
      "Ein beliebtes Reiseziel für Bergfreunde, Wanderer und Wintersportler. Unsere Familie und unser Team werden Sie in einer herzlichen und freundlichen Atmosphäre in aller Einfachheit empfangen."
    ],
    "en": [
      "A destination of choice for mountain, hiking and winter sports enthusiasts. Our family and our team will welcome you in a warm and friendly atmosphere."
    ],
    "it": [
      "Una destinazione d'elezione per gli amanti della montagna, gli escursionisti e gli appassionati di sport invernali. La nostra famiglia e il nostro team vi accoglieranno in un'atmosfera calda e amichevole."
    ],
    "fr": [
      "Une destination de choix pour les amateurs de montagne, de randonnées et sports d’hiver. Notre famille et notre équipe vous accueillera dans une ambiance chaleureuse et conviviale en toute simplicité."
    ],
    "es": [
      "Un destino de elección para los amantes de la montaña, el senderismo y los deportes de invierno. Nuestra familia y nuestro equipo le darán la bienvenida en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Een bestemming bij uitstek voor bergliefhebbers, wandelaars en wintersporters. Onze familie en ons team verwelkomen je in een warme en vriendelijke sfeer."
    ]
  },
