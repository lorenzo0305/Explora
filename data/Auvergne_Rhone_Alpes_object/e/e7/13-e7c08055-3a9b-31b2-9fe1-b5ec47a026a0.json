  "rdfs:comment": {
    "de": [
      "Karine verfügt über ein BEP Bijouterie und ein CAP Joaillerie, die sie durch eine Zusatzbezeichnung für Edelsteinbesatz an der Saumur-Schule in Belfort ergänzt hat. Danach arbeitete sie 27 Jahre lang in einem Atelier in Dijon."
    ],
    "en": [
      "Holder of a BEP jewelry diploma and a CAP jewelry diploma, supplemented by a complementary diploma in gem-setting from the Saumur school in Belfort, Karine then worked for 27 years in a Dijon workshop."
    ],
    "it": [
      "Karine ha conseguito un diploma BEP in gioielleria e un CAP in gioielleria, oltre a una qualifica aggiuntiva in incastonatura di gemme presso la scuola Saumur di Belfort. Ha poi lavorato per 27 anni in un laboratorio di Digione."
    ],
    "fr": [
      "Titulaire d'un BEP bijouterie et d'un CAP joaillerie, completés par une  mention complémentaire en sertie à l'école Saumur de Belfort, Karine a travaillé ensuite pendant 27 ans dans un atelier dijonnais."
    ],
    "es": [
      "Karine posee un BEP en joyería y un CAP en joyería, además de una cualificación adicional en engaste de gemas de la escuela Saumur de Belfort. Después trabajó durante 27 años en un taller de Dijon."
    ],
    "nl": [
      "Karine heeft een BEP in juwelenmaken en een CAP in juwelenmaken, plus een extra kwalificatie in edelsteenzetten van de Saumur-school in Belfort. Daarna werkte ze 27 jaar in een atelier in Dijon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier \" Kar & Or\""
    ]
  },
