  "rdfs:comment": {
    "de": [
      "Am Wasser, in Badekleidung über den Strand und zu Fuß oder mit dem Fahrrad über die Seepromenade erreichbar, schattige Terrasse, ruhig!"
    ],
    "en": [
      "By the water, access via the beach in a swimsuit and on foot or by bike along the lakeside promenade, shaded terrace, peaceful!"
    ],
    "it": [
      "Sull'acqua, accesso tramite la spiaggia in costume da bagno e a piedi o in bicicletta lungo la passeggiata lacustre, terrazza ombreggiata, tranquillo!"
    ],
    "fr": [
      "Au bord de l'eau, accès par la plage en maillot de bain et à pied ou en vélo par la promenade lacustre, terrasse ombragée, tranquille!"
    ],
    "nl": [
      "Aan het water, bereikbaar via het strand in zwemkleding en te voet of met de fiets langs de promenade langs het meer, schaduwrijk terras, rustig!"
    ],
    "es": [
      "A orillas del agua, accesible por la playa en bañador y a pie o en bicicleta por el paseo del lago, terraza sombreada, ¡tranquilidad!"
    ]
  },
