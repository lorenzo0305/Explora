  "rdfs:comment": {
    "de": [
      "Transportunternehmen mit Sitz in der Gemeinde Mollans sur Ouvèze. Wir stehen Ihnen 7 Tage die Woche zur Verfügung, um Sie zu Bahnhöfen, Flughäfen und Hotels in der Region zu befördern. Gruppentransporte: Wanderer, Abendveranstaltungen...\r\nFür medizinische Transporte zugelassen."
    ],
    "en": [
      "Transport company located in the surroundings of Buis-les-Baronnies. Available 7 days a week to ensure your business or private trips. Transfer to stations, airports and hotels. Agreed for the transport of seated patients."
    ],
    "it": [
      "Azienda di trasporti con sede a Mollans sur Ouvèze. Disponibile 7 giorni su 7 per accompagnarvi da e verso le stazioni, gli aeroporti e gli hotel della regione. Trasporto di gruppo: escursionisti, feste, ecc.\r\nOmologato per il trasporto medico."
    ],
    "fr": [
      "Société de transport implantée sur la commune de Mollans sur Ouvèze. Disponible 7j/7 afin d'assurer vos déplacements vers les gares, aéroports et hôtels de la régions. Transport groupe : randonneurs, soirées...\r\nConventionné pour le transport médical."
    ],
    "nl": [
      "Transportbedrijf in de gemeente Mollans sur Ouvèze. 7 dagen per week beschikbaar voor uw professionele of privé reizen. Transfer naar stations, luchthavens en hotels. Goedgekeurd door alle fondsen voor het vervoer van patiënten."
    ],
    "es": [
      "Empresa de transportes con sede en Mollans sur Ouvèze. Disponible los 7 días de la semana para llevarle y traerle de las estaciones, aeropuertos y hoteles de la región. Transporte de grupos: excursionistas, fiestas, etc.\r\nAutorizado para el transporte sanitario."
    ]
  },
