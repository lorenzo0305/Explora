  "rdfs:comment": {
    "de": [
      "Les Petites Cantines ist ein gemeinnütziges Netzwerk, in dem sich die Gäste durch nachhaltige Mahlzeiten zum Nulltarif willkommen heißen und begegnen, um gute Beziehungen aufzubauen und zum Aufbau einer auf Vertrauen basierenden Gesellschaft beizutragen."
    ],
    "en": [
      "Les Petites Cantines is a not-for-profit network where diners welcome each other and meet over sustainable, free-price meals, to forge quality relationships and help build a society based on trust."
    ],
    "it": [
      "Les Petites Cantines è una rete no-profit in cui le persone si incontrano e si salutano attraverso pasti sostenibili a prezzo libero, per costruire relazioni di qualità e contribuire alla costruzione di una società basata sulla fiducia."
    ],
    "fr": [
      "Les Petites Cantines est un réseau non lucratif où les convives s’accueillent et se rencontrent au travers de repas durables et à prix libre, pour tisser des relations de qualité et contribuer à la construction d’une société fondée sur la confiance."
    ],
    "nl": [
      "Les Petites Cantines is een netwerk zonder winstoogmerk waar mensen elkaar ontmoeten en begroeten via duurzame maaltijden tegen vrije prijzen, om zo kwaliteitsvolle relaties op te bouwen en bij te dragen tot de opbouw van een samenleving gebaseerd op vertrouwen."
    ],
    "es": [
      "Les Petites Cantines es una red sin ánimo de lucro en la que las personas se encuentran y se saludan a través de comidas sostenibles a precios libres, para construir relaciones de calidad y contribuir a la construcción de una sociedad basada en la confianza."
    ]
  },
