  "rdfs:comment": {
    "de": [
      "Dieser in einem ehemaligen Steinbruch gelegene Ort ist ideal für Anfänger. Es gibt 21 Kletterrouten, 2 bis 6b, Höhe: 15 Meter. Ein Mini-Klettersteig vervollständigt die Ausrüstung."
    ],
    "en": [
      "Located in a former quarry, this site is ideal for beginners, with 21 climb routes.  Height: 15 m."
    ],
    "it": [
      "Situato in un'ex cava, questo sito è ideale per i principianti, con 21 vie di arrampicata, da 2 a 6b, altezza: 15 metri. Una mini via ferrata completa l'offerta."
    ],
    "fr": [
      "Situé sur une ancienne carrière, ce site est idéal pour l'initiation, avec 21 voies d'escalade, 2 à 6b, hauteur : 15 mètres. Une mini via ferrata complète l'équipement."
    ],
    "es": [
      "Situado en una antigua cantera, este sitio es ideal para principiantes, con 21 vías de escalada, de 2 a 6b, altura: 15 metros. Una mini vía ferrata completa las instalaciones."
    ],
    "nl": [
      "Gelegen in een voormalige steengroeve is deze site ideaal voor beginners, met 21 klimroutes, 2 tot 6b, hoogte: 15 meter. Een miniklettersteig maakt de faciliteiten compleet."
    ]
  },
  "rdfs:label": {
    "en": [
      "Col du Banchet climbing site"
    ],
    "fr": [
      "Site d'escalade du col du Banchet"
    ]
  },
