  "rdfs:comment": {
    "de": [
      "Das an das Greet Hotel Massieux Lyon Nord angrenzende Restaurant Maison Germains bietet eine Küche, die ausschließlich mit saisonalen Produkten zubereitet wird, die bei den besten regionalen Züchtern und Erzeugern ausgewählt werden."
    ],
    "en": [
      "Adjacent to the Greet Hôtel Massieux Lyon Nord, the Maison Germains restaurant offers cuisine based solely on seasonal produce, selected from the best regional breeders and producers."
    ],
    "it": [
      "Annesso al Greet Hôtel Massieux Lyon Nord, il ristorante Maison Germains offre una cucina basata esclusivamente su prodotti di stagione, selezionati dai migliori allevatori e produttori della regione."
    ],
    "fr": [
      "Attenant au Greet Hôtel Massieux Lyon Nord, le restaurant Maison Germains propose une cuisine élaborée uniquement à base de produits de saison, sélectionnés chez les meilleurs éleveurs et producteurs régionaux."
    ],
    "nl": [
      "Het restaurant Maison Germains, dat grenst aan het Greet Hôtel Massieux Lyon Nord, biedt een keuken die uitsluitend gebaseerd is op seizoensproducten, geselecteerd bij de beste kwekers en producenten uit de regio."
    ],
    "es": [
      "Adosado al Greet Hôtel Massieux Lyon Nord, el restaurante Maison Germains ofrece una cocina basada exclusivamente en productos de temporada, seleccionados entre los mejores ganaderos y productores de la región."
    ]
  },
