  "rdfs:comment": {
    "de": [
      "Im Byblos entdecken Sie die Eleganz des libanesischen Streetfoods sowie hausgemachte Burger, die aus frischen Produkten zubereitet werden!\r\nLibanesische Sandwiches, Burger, libanesisches Catering auf Bestellung... Lassen Sie sich von unserer Karte zum Mitnehmen verführen!"
    ],
    "en": [
      "At Le Byblos, discover the elegance of Lebanese street food and homemade burgers made with fresh produce!\r\nLebanese sandwiches, burgers, made-to-order Lebanese catering... Let yourself be seduced by our take-away menu!"
    ],
    "it": [
      "A Le Byblos, scoprite l'eleganza dello street food libanese e degli hamburger fatti in casa con prodotti freschi!\r\nPanini libanesi, hamburger, catering libanese su ordinazione... Lasciatevi sedurre dal nostro menu da asporto!"
    ],
    "fr": [
      "Au Byblos, découvrez l'élégance de la street food libanaise ainsi que des burgers maisons élaborés à base de produits frais !\r\nSandwich libanais, burgers, traiteur libanais sur commande... Laissez vous séduire par notre carte à emporter !"
    ],
    "nl": [
      "Ontdek bij Le Byblos de elegantie van Libanees streetfood en huisgemaakte hamburgers met verse producten!\r\nLibanese broodjes, hamburgers, Libanese catering op bestelling... Laat u verleiden door ons afhaalmenu!"
    ],
    "es": [
      "En Le Byblos, descubra la elegancia de la comida callejera libanesa y las hamburguesas caseras elaboradas con productos frescos\r\nBocadillos libaneses, hamburguesas, catering libanés por encargo... Déjese seducir por nuestra carta de comida para llevar"
    ]
  },
  "rdfs:label": {
