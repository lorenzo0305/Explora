  "rdfs:comment": {
    "de": [
      "Unser pädagogischer Bauernhof kommt zu Ihnen nach Hause! Wir reisen mit etwa zwanzig Tieren (Ziegen, Schafe, Kaninchen, Hinterhof und Gast!) und ihren gesicherten Parks an.  In La Bicoque vermischt sich Bauernhof mit Pädagogik! Erinnerungen garantiert!"
    ],
    "en": [
      "Our educational farm comes to you! We come to you with around twenty animals (goats, sheep, rabbits, farmyard animals and guest!) and their secure pens.  At La Bicoque, farming meets education! Memories guaranteed!"
    ],
    "it": [
      "La nostra fattoria didattica viene da voi! Veniamo da voi con una ventina di animali (capre, pecore, conigli, zoo e ospiti!) e i loro recinti sicuri.  A La Bicoque, l'agricoltura incontra l'educazione! Ricordi garantiti!"
    ],
    "fr": [
      "Notre ferme pédagogique vient chez vous ! Nous nous déplaçons avec une vingtaine d'animaux (chèvres, moutons, lapins, basse cour and guest !) et leurs parcs sécurisés.  A la Bicoque, la paysannerie se mêle à la pédagogie ! Souvenirs garantis !"
    ],
    "es": [
      "¡Nuestra granja educativa viene a ti! Venimos a verte con una veintena de animales (cabras, ovejas, conejos, un zoo de mascotas e invitados) y sus corrales seguros.  En La Bicoque, la agricultura se une a la educación ¡Recuerdos garantizados!"
    ],
    "nl": [
      "Onze educatieve boerderij komt naar je toe! We komen naar je toe met een twintigtal dieren (geiten, schapen, konijnen, kinderboerderij en gasten!) en hun veilige hokken.  Bij La Bicoque ontmoeten landbouw en educatie elkaar! Herinneringen gegarandeerd!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Bicoque - Ferme pédagogique itinérante"
    ]
  },
