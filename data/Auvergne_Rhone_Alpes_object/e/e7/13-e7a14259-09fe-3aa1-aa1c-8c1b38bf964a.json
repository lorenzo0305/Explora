  "rdfs:comment": {
    "de": [
      "Créations d'Oana , handgefertigte, einzigartige, ethische und feminine Stücke, die Komfort und Engagement vereinen. Oana ist in der Ardèche ansässig und entwirft und fertigt Lingerie, textile Accessoires und Taschen, die einzigartig und individuell gestaltbar sind."
    ],
    "en": [
      "Créations d'Oana , unique, ethical and feminine handcrafted pieces, combining comfort and commitment. Based in the Ardèche region of France, Oana designs and manufactures unique and customizable lingerie, textile accessories and bags."
    ],
    "it": [
      "Créations d'Oana , pezzi unici, etici e femminili realizzati a mano, che uniscono comfort e impegno. Con sede nell'Ardèche, Créations d'Oana disegna e produce lingerie, accessori tessili e borse uniche e personalizzabili."
    ],
    "fr": [
      "Créations d'Oana , des pièces artisanales uniques, éthique et féminines, alliant confort et engagement. Installée en Ardèche, Créations d'Oana conçoit et fabrique de la lingerie, des accessoires textiles et sacs unique et personnalisable."
    ],
    "nl": [
      "Créations d'Oana , unieke, ethische en vrouwelijke handgemaakte stukken, die comfort en engagement combineren. Oana, gevestigd in de Ardèche, ontwerpt en vervaardigt unieke en aanpasbare lingerie, textielaccessoires en tassen."
    ],
    "es": [
      "Créations d'Oana , piezas artesanales únicas, éticas y femeninas, que combinan comodidad y compromiso. Con sede en Ardèche, Créations d'Oana diseña y fabrica lencería, accesorios textiles y bolsos únicos y personalizables."
    ]
  },
