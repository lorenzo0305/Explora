  "rdfs:comment": {
    "de": [
      "Le Crusoé ist eine historische Guinguette des Departements auf der Ile Roy in Collonges-au-Mont-d'Or. Sie wurde 1950 eröffnet und ist ein geselliger Ort mit einem Bootssteg und einer herrlichen Terrasse an der Saône mit Zugang per Boot."
    ],
    "en": [
      "Le Crusoé is a historic river-side restaurant. Opened in 1950 on the Ile Roy in Collonges-au-Mont-d'Or, it is a friendly place with a pontoon and a wonderful terrace on the Saône, with access by boat between the quai de Collonges and Ile Roy."
    ],
    "it": [
      "Le Crusoé è una guinguette storica del dipartimento sull'Ile Roy a Collonges-au-Mont-d'Or. Inaugurato nel 1950, è un luogo conviviale con un pontone e una splendida terrazza sulla Saona con accesso in barca."
    ],
    "fr": [
      "Le Crusoé, c'est une guinguette historique du département sur l’île Roy à Collonges-au-Mont-d'Or. Ouverte en 1950, c'est un lieu convivial avec un ponton et une splendide terrasse sur la Saône avec un accès en barque."
    ],
    "nl": [
      "Le Crusoé is een historische guinguette van het departement op het Ile Roy in Collonges-au-Mont-d'Or. Geopend in 1950, is het een gezellige plek met een ponton en een prachtig terras aan de Saône met toegang per boot."
    ],
    "es": [
      "Le Crusoé es una guinguette histórica del departamento en la Ile Roy en Collonges-au-Mont-d'Or. Inaugurado en 1950, es un lugar de convivencia con un pontón y una espléndida terraza en el Saona con acceso en barco."
    ]
  },
  "rdfs:label": {
