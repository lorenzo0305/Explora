  "rdfs:comment": {
    "de": [
      "Ein großes Bürgerhaus mit erhaltenem Charme, das sich zu einem großen Garten hin öffnet, gigantische Innenräume und eine Dekoration, die von dem inspirierenden Designer François Dumas entworfen wurde... Hier fühlen Sie sich wie zu Hause!"
    ],
    "en": [
      "A large bourgeois house that has retained all its charms and opens out onto a large garden, boasting huge internal volumes and interior decorating signed by the highly inspired designer François Dumas… This is home from home!"
    ],
    "it": [
      "Una grande casa borghese dal fascino conservato, aperta su un vasto giardino, con volumi interni giganteschi e una decorazione firmata dall'ispiratissimo designer François Dumas? Qui ci si sente a casa!"
    ],
    "fr": [
      "Une grande maison bourgeoise aux charmes préservés, ouverte sur un vaste jardin, des volumes intérieurs gargantuesques et une déco signée par le très inspiré designer François Dumas… Ici, vous êtes comme à la maison !"
    ],
    "es": [
      "¿Una gran casa burguesa con encantos conservados, que se abre a un vasto jardín, volúmenes interiores gigantescos y una decoración firmada por el inspiradísimo diseñador François Dumas? Aquí te sientes como en casa"
    ],
    "nl": [
      "Een groot burgerlijk huis met behouden charme, uitgevend op een grote tuin, reusachtige binnenvolumes en een decoratie getekend door de zeer geïnspireerde ontwerper François Dumas... Hier voelt u zich thuis!"
    ]
  },
