  "rdfs:comment": {
    "de": [
      "Das Benetton freut sich, Sie im Sommer und Winter mit Blick auf den Mont Blanc begrüßen zu dürfen.\r\nRestaurant-Bar-Snack. Terrasse/Kamin. Zugang im Winter auf Skiern oder zu Fuß (grüne Piste Les Blanchots) Zugang im Sommer mit dem Fahrrad, zu Fuß oder mit dem Pendelbus Colette (Route des crêtes)"
    ],
    "en": [
      "Restaurant bar - solarium, facing Mont-Blanc. Easy access on skis or on foot (groomed path) in winter and by car via a carriage road in summer."
    ],
    "it": [
      "Bar ristorante - solarium, di fronte al Monte Bianco. Facile accesso con gli sci oa piedi (sentiero battuto) in inverno e in auto tramite una strada carrozzabile in estate."
    ],
    "fr": [
      "Le Benetton est ravi de vous accueillir été comme hiver face au Mont Blanc.\r\nRestaurant-Bar-Snack. Terrasse/Cheminée. Accès en hiver à ski ou à pied (piste verte les Blanchots) Accès en été en vélo, à pied ou avec la navette Colette (route des crêtes)"
    ],
    "nl": [
      "Restaurantbar - solarium, met uitzicht op de Mont-Blanc. Gemakkelijke toegang op ski's of te voet (geprepareerd pad) in de winter en met de auto via een rijbaan in de zomer."
    ],
    "es": [
      "El Benetton está encantado de recibirle tanto en verano como en invierno, frente al Mont Blanc.\r\nRestaurante-Bar-Snack. Terraza/chimenea. Acceso en invierno esquiando o a pie (pistes verte les Blanchots) Acceso en verano en bicicleta, a pie o con la lanzadera Colette (route des crêtes)"
    ]
  },
