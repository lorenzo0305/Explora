  "rdfs:comment": {
    "de": [
      "Die Familie PIEGAY bietet auf ihrem Bauernhof schmackhaften Weiß- und Trockenkäse, Natur- und Fruchtjoghurt, Eis und Sorbets sowie Marmelade zum Verkauf an. Ein traditionelles Know-how im Dienste der Qualität und des Geschmacks?"
    ],
    "en": [
      "The Piegay family sells delicious curd cheese and hard cheeses, plain and fruit yoghurts, ice-creams and sorbets, minced beef, saucisson, jam and honey on their farm. Traditional know-how enhanced by quality and a strong focus on taste."
    ],
    "it": [
      "La famiglia PIEGAY vende in azienda deliziosi fromage frais e formaggi secchi, yogurt semplici e alla frutta, gelati e sorbetti e marmellate. Un know-how tradizionale, dedicato alla qualità e al gusto?"
    ],
    "fr": [
      "La famille PIEGAY propose la vente à le ferme de savoureux fromages blanc et secs, yaourts nature et aux fruits, des glaces et sorbets, confiture. Un savoir-faire traditionnel, mis au service de la qualité et du goût…"
    ],
    "es": [
      "La familia PIEGAY vende en la granja deliciosos quesos frescos y secos, yogures naturales y de frutas, helados y sorbetes, y mermeladas. Un saber hacer tradicional, dedicado a la calidad y al sabor.."
    ],
    "nl": [
      "De familie PIEGAY verkoopt op de boerderij heerlijke fromage frais en droge kazen, gewone en fruityoghurt, ijs en sorbets, en jam. Traditionele knowhow, toegewijd aan kwaliteit en smaak?"
    ]
  },
