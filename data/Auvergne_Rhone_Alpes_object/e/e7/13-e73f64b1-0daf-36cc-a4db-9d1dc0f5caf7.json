  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf einem Spaziergang die Verwendung von essbaren und medizinischen Pflanzen aus unseren Bergen durch die Erfahrung einer kräuterkundigen Bäuerin mit Kräuterzertifikat!"
    ],
    "en": [
      "Through the experience of a Paysanne Herboriste, certified Herbalist, discover the use of edible and medicinal plants from our mountains!"
    ],
    "it": [
      "Imparate a conoscere gli usi delle piante commestibili e medicinali delle nostre montagne da un erborista certificato!"
    ],
    "fr": [
      "À travers l'expérience d'une Paysanne Herboriste, certifiée Herbaliste, découvrez en balade l'usage des plantes comestibles et médicinales de nos montagnes !"
    ],
    "nl": [
      "Leer van een gediplomeerd kruidkundige over het gebruik van eetbare en geneeskrachtige planten in onze bergen!"
    ],
    "es": [
      "Conozca los usos de las plantas comestibles y medicinales de nuestras montañas de la mano de un herbolario titulado"
    ]
  },
