  "rdfs:comment": {
    "de": [
      "Archijeux ist ein gemeinnütziges Brettspielcafé mit über 800 Brettspielen. Außerdem bieten sie Spieleverleih, Spieleveranstaltungen, Schulungen und einen neuen Spieleladen namens „Archi-boutique“ an, der Beratung und Spiele verkauft!"
    ],
    "en": [
      "Archijeux is a non-profit board game café offering over 800 board games. They also offer game loans, game events, training sessions, and a new game shop \"Archi-boutique\" providing advice and selling games!"
    ],
    "it": [
      "Archijeux è una ludoteca che offre oltre 800 giochi da tavolo. Abbiamo anche un nuovo negozio di giochi: L'Archi-boutique, dove è possibile ricevere consigli e acquistare giochi!"
    ],
    "fr": [
      "Archijeux est un café jeux associatif qui propose plus de 800 jeux de société. Prêts de jeu, animations jeux, formations, ... et une nouvelle boutique de jeux : L'Archi-boutique, conseil et ventes de jeux !"
    ],
    "nl": [
      "Archijeux is een non-profit bordspelcafé met meer dan 800 bordspellen. Ze bieden ook spellen aan, organiseren spelevenementen, trainingen en hebben een nieuwe spellenwinkel, \"Archi-boutique\", waar je terecht kunt voor advies en spellen kunt kopen!"
    ],
    "es": [
      "Archijeux es un café de juegos con más de 800 juegos de mesa en oferta. También tenemos una nueva tienda de juegos: L'Archi-boutique, ¡donde podrás asesorarte y comprar juegos!"
    ]
  },
