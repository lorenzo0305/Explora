  "rdfs:comment": {
    "de": [
      "In den Bibliotheken finden Sie Bücher, Zeitschriften, CDs, DVDs, Lesegeräte und Tablets, die Sie vor Ort lesen oder ausleihen können, sowie weitere digitale Dienstleistungen. Die einheitliche Karte ermöglicht Ihnen den Zugang zu allen 16 Bibliotheken des Pays Mornantais."
    ],
    "en": [
      "Libraries offer books, magazines, CDs, DVDs, readers and shelves to consult on site or to borrow, as well as other digital services. The single card gives you access to the 16 libraries of the Pays Mornantais."
    ],
    "it": [
      "Le biblioteche offrono libri, riviste, CD, DVD, dispositivi di lettura e tablet da consultare in loco o da prendere in prestito, oltre ad altri servizi digitali. La tessera unica dà accesso alle 16 biblioteche del Pays Mornantais."
    ],
    "fr": [
      "Les bibliothèques vous proposent livres, magazines, CD, DVD, liseuses et tablettes à consulter sur place ou à emprunter, ainsi que d’autres services numériques. La carte unique vous permet d’accéder aux 16 bibliothèques du Pays Mornantais."
    ],
    "es": [
      "Las bibliotecas le ofrecen libros, revistas, CDs, DVDs, dispositivos de lectura y tabletas para consultar in situ o en préstamo, así como otros servicios digitales. El carné único le da acceso a las 16 bibliotecas del Pays Mornantais."
    ],
    "nl": [
      "De bibliotheken bieden u boeken, tijdschriften, cd's, dvd's, e-readers en tablets om ter plaatse te raadplegen of te lenen, evenals andere digitale diensten. De enkele kaart geeft u toegang tot de 16 bibliotheken van het Pays Mornantais."
    ]
  },
  "rdfs:label": {
