  "rdfs:comment": {
    "de": [
      "Der Minigolfplatz von Magneux liegt südlich von Roanne und bietet einen Parcours mit 18 Bahnen. Diese Anlage ist für Wettkämpfe zugelassen und steht allen Besuchern offen."
    ],
    "en": [
      "The mini-golf course at Magneux, south of Roanne, has 18 lanes. The site is approved for competitions and open to the general public."
    ],
    "it": [
      "Il campo da minigolf di Magneux, a sud di Roanne, dispone di 18 corsie. Il sito è approvato per le competizioni e aperto al pubblico."
    ],
    "fr": [
      "Le mini-golf de Magneux, situé au Sud de Roanne, propose un parcours de 18 pistes. Ce site est homologué pour les compétitions et ouvert à tout public."
    ],
    "es": [
      "El minigolf de Magneux, al sur de Roanne, cuenta con 18 pistas. El recinto está homologado para competiciones y abierto al público en general."
    ],
    "nl": [
      "De midgetgolfbaan in Magneux, ten zuiden van Roanne, heeft 18 banen. Het terrein is goedgekeurd voor wedstrijden en open voor het grote publiek."
    ]
  },
