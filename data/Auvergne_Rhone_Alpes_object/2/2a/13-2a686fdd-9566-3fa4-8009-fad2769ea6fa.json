  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Indoor-Sportzentrum und Kongresszentrum Tignespace : ein vielseitiger Komplex mit modernster Infrastruktur, der sowohl Spitzensportler, Gruppen und Seminare als auch die breite Öffentlichkeit empfängt."
    ],
    "en": [
      "Discover the Tignespace indoor sports center and congress center: a multipurpose complex with cutting-edge infrastructures that welcomes high-level athletes, groups and seminars as well as the general public."
    ],
    "it": [
      "Scoprite il centro sportivo e congressuale indoor di Tignespace: un complesso polifunzionale con strutture all'avanguardia che accoglie sportivi di alto livello, gruppi e seminari e il pubblico in generale."
    ],
    "fr": [
      "Découvrez le centre de sport indoor et centre de congrès Tignespace : un complexe polyvalent aux infrastructures de pointe qui accueille aussi bien les sportifs de hauts niveau, les groupes et séminaires que le grand public."
    ],
    "nl": [
      "Ontdek het indoor sport- en conferentiecentrum van Tignespace: een multifunctioneel complex met ultramoderne faciliteiten waar zowel topsporters, groepen en seminars als het grote publiek welkom zijn."
    ],
    "es": [
      "Descubra el centro deportivo y de congresos cubierto Tignespace: un complejo polivalente con instalaciones de última generación que acoge a deportistas de alto nivel, grupos y seminarios, así como al público en general."
    ]
  },
