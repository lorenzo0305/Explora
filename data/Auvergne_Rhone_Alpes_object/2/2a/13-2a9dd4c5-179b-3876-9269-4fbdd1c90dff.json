  "rdfs:comment": {
    "de": [
      "Ich betreibe seit Juni 2004 eine Viehzucht in der Gemeinde Montregard. Die Herde besteht aus etwa 80 Ziegen und 4 Zuchtböcken. Wir verarbeiten unsere Produktion auf der Grundlage von Rohmilch. Herstellung und Verkauf von Ziegenkäse."
    ],
    "en": [
      "I am installed in breeding on the commune of Montregard since June 2004, the herd consists of approximately 80 goats and 4 breeding bucks. We transform our production with raw milk. Manufacture and sale of goat's cheese."
    ],
    "it": [
      "Allevo nel comune di Montregard dal giugno 2004, il gregge è composto da circa 80 capre e 4 riproduttori. Lavoriamo la nostra produzione a partire dal latte crudo. Produzione e vendita di formaggio di capra."
    ],
    "fr": [
      "Je suis installée en élevage sur la commune de Montregard depuis juin 2004, le troupeau se compose d'environ 80 chèvres et 4 boucs reproducteur. Nous transformons notre production à base de lait cru. Fabrication et vente de fromage de chèvres."
    ],
    "nl": [
      "Ik boer sinds juni 2004 in de gemeente Montregard, de kudde bestaat uit ongeveer 80 geiten en 4 fokbokken. Wij verwerken onze productie van rauwe melk. Productie en verkoop van geitenkaas."
    ],
    "es": [
      "Desde junio de 2004, crío en la comuna de Montregard, el rebaño consta de unas 80 cabras y 4 machos reproductores. Procesamos nuestra producción a partir de leche cruda. Producción y venta de queso de cabra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Earl Chevrerie du Plateau"
    ]
  },
