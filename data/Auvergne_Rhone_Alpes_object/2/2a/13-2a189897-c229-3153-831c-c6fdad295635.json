  "rdfs:comment": {
    "de": [
      "Biodynamische Entspannung: Übungen aus den Kampfkünsten (Atemübungen, Dehnübungen, Erdung) zur Wiederverbindung mit Ihrer Energie.\r\nWorkshop zur Selbstfürsorge: Blockaden lösen, Prioritäten klären.\r\nBildende Kunst: Zeichnen & Malen (Aquarell, Tuschemalerei)"
    ],
    "en": [
      "Biodynamic relaxation: exercises inspired by martial arts (breathing, stretching, grounding) to reconnect with your energy.\r\nSelf-care workshop: releasing blockages, clarifying priorities.\r\nVisual art: drawing & painting (watercolor, sumi-e ink)"
    ],
    "it": [
      "Rilassamento biodinamico: esercizi ispirati alle arti marziali (respirazione, stretching, ancoraggio) per riconnettersi con la propria energia.\r\nLaboratorio Pour Soi: sciogliere i blocchi, chiarire le priorità.\r\nArte visiva: disegno e pittura (acquerello, inchiostro sumi-e)"
    ],
    "fr": [
      "Relaxation bio-dynamique : exercices inspirés des arts martiaux (respiration, étirement, ancrage) pour se reconnecter à son énergie.\r\nAtelier Pour Soi : libérer les blocages, clarifier ses priorités.\r\nArt visuel : dessin & peinture (aquarelle, encre sumi-e)"
    ],
    "es": [
      "Relajación biodinámica: ejercicios inspirados en las artes marciales (respiración, estiramientos, anclaje) para reconectar con su energía.\r\nTaller Pour Soi: liberar bloqueos, aclarar prioridades.\r\nArtes visuales: dibujo y pintura (acuarela, tinta sumi-e)"
    ],
    "nl": [
      "Bio-dynamische ontspanning: oefeningen geïnspireerd door de krijgskunst (ademhaling, stretching, verankering) om weer contact te maken met je energie.\r\nPour Soi workshop: blokkades loslaten, prioriteiten verduidelijken.\r\nBeeldende kunst: tekenen & schilderen (aquarel, sumi-inkt)"
    ]
  },
