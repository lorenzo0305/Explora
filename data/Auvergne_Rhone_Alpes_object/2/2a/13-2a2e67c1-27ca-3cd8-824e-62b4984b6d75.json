  "rdfs:comment": {
    "de": [
      "Ein Theaterabend im Zeichen des Vergnügens und des Teilens. Ein zugängliches Stück, das von der Energie der Schauspieler getragen wird und Lachen, Emotionen und Geselligkeit miteinander verbindet. Ein kultureller Moment, den Sie gemeinsam in einer herzlichen Atmosphäre genießen können."
    ],
    "en": [
      "An evening of theater for pleasure and sharing. An accessible play, driven by the energy of the actors, combining laughter, emotion and conviviality. A cultural moment to enjoy together, in a warm atmosphere."
    ],
    "it": [
      "Una serata di teatro all'insegna del divertimento e della condivisione. Uno spettacolo accessibile, guidato dall'energia degli attori, che unisce risate, emozioni e convivialità. Un momento culturale da vivere insieme, in una calda atmosfera."
    ],
    "fr": [
      "Une soirée théâtre placée sous le signe du plaisir et du partage. Une pièce accessible, portée par l’énergie des comédiens, mêlant rires, émotions et convivialité. Un moment culturel à savourer ensemble, dans une ambiance chaleureuse."
    ],
    "es": [
      "Una velada teatral para divertirse y compartir. Una obra accesible, impulsada por la energía de los actores, que combina risas, emoción y convivencia. Un momento cultural para disfrutar juntos, en un ambiente cálido."
    ],
    "nl": [
      "Een avond theater gebaseerd op plezier en delen. Een toegankelijk stuk, gedreven door de energie van de acteurs, dat lachen, ontroering en gezelligheid combineert. Een cultureel moment om samen van te genieten, in een warme sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : Week-end intime"
    ]
  },
