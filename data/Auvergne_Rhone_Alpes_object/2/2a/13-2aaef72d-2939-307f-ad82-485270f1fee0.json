  "rdfs:comment": {
    "de": [
      "Auf einem Felsvorsprung gelegen, überragen die Überreste der alten und mächtigen Festung aus rosa Sandstein der Herzöge von Bourbon eine Kurve des Flusses \"Aumance\"."
    ],
    "en": [
      "Situated on a rocky spur, the remains of the ancient and powerful pink sandstone fortress of the Dukes of Bourbon dominate a bend in the \"Aumance\" river."
    ],
    "it": [
      "Situati su uno sperone roccioso, i resti dell'antica e potente fortezza in arenaria rosa dei duchi di Borbone dominano un'ansa del fiume Aumance."
    ],
    "fr": [
      "Situés sur un éperon rocheux, les vestiges de l'ancienne et puissante forteresse en grès rose des Ducs de Bourbon dominent une courbe de la rivière \"Aumance\"."
    ],
    "es": [
      "Situados en un espolón rocoso, los restos de la antigua y poderosa fortaleza de arenisca rosa de los duques de Borbón dominan un recodo del río Aumance."
    ],
    "nl": [
      "Gelegen op een rotsachtige uitloper domineren de overblijfselen van het oude en machtige fort van roze zandsteen van de hertogen van Bourbon een bocht in de rivier de Aumance."
    ]
  },
