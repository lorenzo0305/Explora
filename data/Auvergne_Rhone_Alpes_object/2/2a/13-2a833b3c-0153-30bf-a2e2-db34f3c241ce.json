  "rdfs:comment": {
    "de": [
      "Die Klassen für lyrischen Gesang und die Klasse für Klavierbegleitung laden Sie ein, mit Auszügen aus Jacques Offenbachs erster Opera buffa zu kokettieren."
    ],
    "en": [
      "The lyric singing and piano accompaniment classes invite you to enjoy excerpts from Jacques Offenbach's first opéra-bouffe."
    ],
    "it": [
      "Le classi di canto lirico e di accompagnamento al pianoforte vi invitano a venire a godere di estratti della prima opéra-bouffe di Jacques Offenbach."
    ],
    "fr": [
      "Les classes de chant lyrique et la classe d'accompagnement piano vous invitent à venir vous encanailler avec des extraits du premier opéra-bouffe de Jacques Offenbach."
    ],
    "es": [
      "Las clases de canto lírico y acompañamiento de piano le invitan a venir y disfrutar de extractos de la primera opéra-bouffe de Jacques Offenbach."
    ],
    "nl": [
      "De lessen lyrische zang en pianobegeleiding nodigen je uit om te komen genieten van fragmenten uit de eerste opéra-bouffe van Jacques Offenbach."
    ]
  },
