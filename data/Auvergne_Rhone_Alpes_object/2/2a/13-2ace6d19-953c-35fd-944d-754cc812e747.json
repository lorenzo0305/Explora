  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich in einem Raum im Erdgeschoss des ehemaligen Schulgebäudes. Der Zugang erfolgt über das Tor auf der Straßenseite, das zum Rathaus hinunterführt."
    ],
    "en": [
      "The library occupies a room on the ground floor of the old school building. The access is through the gate on the street side that goes down to the town hall."
    ],
    "it": [
      "La biblioteca occupa una stanza al piano terra del vecchio edificio scolastico. L'accesso avviene attraverso il cancello sul lato della strada che conduce al municipio."
    ],
    "fr": [
      "La bibliothèque occupe une salle au rez de chaussée du bâtiment de l’ancienne école. L’accès se fait par le portillon côté rue qui descend à la mairie."
    ],
    "es": [
      "La biblioteca ocupa una sala en la planta baja del antiguo edificio de la escuela. El acceso se realiza a través de la puerta del lado de la calle que lleva al ayuntamiento."
    ],
    "nl": [
      "De bibliotheek beslaat een ruimte op de begane grond van het oude schoolgebouw. De toegang is via de poort aan de straatkant die naar het stadhuis leidt."
    ]
  },
  "rdfs:label": {
