  "rdfs:comment": {
    "de": [
      "Ein atemberaubender Blick auf diesen Strand, der für zahlreiche Aktivitäten eingerichtet wurde: Spiele für Kinder, Verleih von Tretbooten, Kanus und Booten ohne Führerschein. Das Baden wird im Juli und August überwacht."
    ],
    "en": [
      "Free-access beach located at the end of the Lac du Bourget. Toll parking."
    ],
    "it": [
      "Spiaggia gratuita in fondo al Lago del Bourget. Parcheggio a pagamento."
    ],
    "fr": [
      "Une vue époustouflante pour cette plage aménagée pour pratiquer de nombreuses activités : jeux pour enfants, location de pédalos, canoës et bateaux sans permis. La baignade est surveillée en juillet et août."
    ],
    "es": [
      "Una vista impresionante para esta playa equipada para practicar muchas actividades: juegos para niños, alquiler de botes a pedal, canoas y barcos sin licencia. La natación está supervisada en julio y agosto."
    ],
    "nl": [
      "Een adembenemend uitzicht voor dit strand uitgerust om vele activiteiten uit te oefenen: spelletjes voor kinderen, verhuur van waterfietsen, kano's en boten zonder vergunning. In juli en augustus wordt er onder toezicht gezwommen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chatillon Beach"
    ],
    "it": [
      "Spiaggia di Chatillon"
    ],
    "fr": [
      "Plage de Chatillon"
    ]
  },
