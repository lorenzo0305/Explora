  "rdfs:comment": {
    "de": [
      "Begeben Sie sich in luftige Höhen, um die Landschaft der Cher-Schlucht zu genießen. Der Klettersteig von Lignerolles ist ein sehr gut ausgestatteter Sportplatz, der sich für Entdeckungen oder für das Training der erfahrensten Kletterer eignet."
    ],
    "en": [
      "Take to the heights to make the most of the landscapes of the Cher gorges. The Lignerolles via ferrata is a well-equipped sports site, ideal for discovery or training for the more experienced climber."
    ],
    "it": [
      "Salite in quota per godere al massimo dei paesaggi delle gole dello Cher. La via ferrata di Lignerolles è un sito sportivo ben attrezzato, ideale per i principianti o per gli scalatori più esperti."
    ],
    "fr": [
      "Prenez de la hauteur pour profiter au mieux des paysages des gorges du Cher. La via ferrata de Lignerolles est un site sportif très bien aménagé propice à la découverte ou à l'entraînement pour les pratiquants les plus chevronnés."
    ],
    "es": [
      "Suba a las alturas para disfrutar de los paisajes de las gargantas del Cher. La vía ferrata de Lignerolles es un lugar deportivo bien equipado, ideal para principiantes o escaladores más experimentados."
    ],
    "nl": [
      "Ga de hoogte in en geniet van de landschappen van de kloven van de Cher. De via ferrata van Lignerolles is een goed uitgeruste sportplaats, ideaal voor beginners of voor meer ervaren klimmers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de Via Ferrata des Gorges du Cher"
    ]
  },
