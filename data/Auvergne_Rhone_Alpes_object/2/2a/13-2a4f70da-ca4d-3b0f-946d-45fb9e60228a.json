  "rdfs:comment": {
    "de": [
      "Unweit der Altstadt im Bereich Les Marquisats bietet die dem französischen Segelverband angegliederte SRV Annecy Kurse unter der Leitung von ausgebildeten Lehrern sowie den Verleih von Segelbooten und SUP-Ausrüstung an."
    ],
    "en": [
      "Located 2 steps from the old town on the Marquisats site, SRV Annecy, affiliated with the French Sailing Federation, offers courses supervised by qualified instructors and rental of sailing boats, stand-up paddles and canoes."
    ],
    "it": [
      "Situata a 2 passi dalla città vecchia sul sito des Marquisats, la SRV Annecy, affiliata alla Fédération Française de Voile, offre lezioni tenute da istruttori qualificati, nonché il noleggio di barche a vela e stand-up paddle."
    ],
    "fr": [
      "Située à 2 pas de la vieille ville sur le site des Marquisats, la SRV Annecy, affiliée à la Fédération Française de Voile, propose des cours encadrés par des moniteurs diplômés et de la location de bateaux à voile, stand-up paddle et de canoé kayak."
    ],
    "es": [
      "Situada a dos pasos del casco antiguo, en el recinto de los Marquisats, la SRV Annecy, afiliada a la Fédération Française de Voile, ofrece clases dirigidas por monitores cualificados y alquiler de veleros, remos y piraguas."
    ],
    "nl": [
      "De SRV Annecy, lid van de Fédération Française de Voile (Franse Zeilfederatie), ligt op 2 stappen van de oude stad, op de site van les Marquisats, en biedt lessen door gediplomeerde instructeurs en verhuurt zeilboten en stand up paddles."
    ]
  },
