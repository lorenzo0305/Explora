  "rdfs:comment": {
    "de": [
      "Bowling mit 8 Bahnen für Kinder von 5 bis 99 Jahren, Billard (Pools), Restaurant, Lasergame und 3 private Karaoke-Box-Räume, in denen Sie Ihre Seele baumeln lassen können (Natur, Pop Art, Las Vegas)."
    ],
    "en": [
      "8-lane bowling alley for ages 5 to 99, with child-friendly equipment, pool tables, restaurant, Lasergame, plus 3 private Karaoke Box rooms to let your hair down (nature, Pop Art, Las Vegas)."
    ],
    "it": [
      "Bowling 8 piste per bambini dai 5 ai 99 anni con attrezzature adatte ai bambini, biliardo (piscine), ristorante, Lasergame, oltre a 3 sale private Karaoke Box per scatenarsi nelle canzoni (natura, Pop Art, Las Vegas)."
    ],
    "fr": [
      "Bowling 8 pistes homologues de 5 à 99 ans avec équipements adaptés pour les enfants, billards (pools), restaurant, Lasergame, ainsi que 3 salles privatisées Karaoké Box pour vous lâcher en chanson (nature, Pop Art, Las Vegas)."
    ],
    "nl": [
      "Bowling met 8 banen voor kinderen van 5 tot 99 jaar met aangepast materiaal voor kinderen, biljart (zwembaden), restaurant, Lasergame, evenals 3 privé-karaokekamers om je uit te leven in zang (natuur, Pop Art, Las Vegas)."
    ],
    "es": [
      "Bowling 8 pistas de 5 a 99 años con equipamiento adaptado para niños, billares (piscinas), restaurante, Lasergame, así como 3 salas privadas Karaoke Box para soltarse a cantar (nature, Pop Art, Las Vegas)."
    ]
