  "rdfs:comment": {
    "de": [
      "Die MCF-Schule in Grenoble bietet Ihnen einen Fahrradverleih, einen Fahrradladen, eine Werkstatt und Einzel-/Gruppenunterricht, Praktika, maßgeschneidert nach Ihren Bedürfnissen."
    ],
    "en": [
      "Ecole MCF de Grenoble offers you bike rental, a shop for the purchase of your bikes, a workshop and private / group lessons, courses, tailor-made according to your needs."
    ],
    "it": [
      "La scuola MCF di Grenoble offre il noleggio, un negozio per l'acquisto della bicicletta, un'officina e lezioni private/gruppo, corsi, su misura per le vostre esigenze."
    ],
    "fr": [
      "Ecole MCF de Grenoble vous propose de la location, une boutique pour l'achat de vos vélo, un atelier et des cours particuliers / colectifs, stages, sur-mesure en fonction de vos besoins."
    ],
    "es": [
      "La escuela MCF de Grenoble le ofrece alquiler, una tienda para comprar su bicicleta, un taller y clases particulares/en grupo, cursos, adaptados a sus necesidades."
    ],
    "nl": [
      "De MCF school in Grenoble biedt verhuur, een winkel om je fiets te kopen, een workshop en privé/groepslessen, cursussen, op maat gemaakt."
    ]
  },
