  "rdfs:comment": {
    "de": [
      "Da Kinder vollwertige Besucher sind, haben sie ein Recht darauf, dass man sich für sie etwas Besonderes einfallen lässt!"
    ],
    "en": [
      "Because they're visitors in their own right, children are entitled to a little extra care and attention!"
    ],
    "it": [
      "Poiché sono visitatori a tutti gli effetti, i bambini hanno il diritto di essere trattati con un po' di attenzione in più!"
    ],
    "fr": [
      "Parce qu'ils sont des visiteurs à part entière, les enfants ont bien le droit à ce qu'on mette pour eux les petits plats dans les grands !"
    ],
    "es": [
      "Porque son visitantes por derecho propio, los niños tienen todo el derecho a ser tratados con un poco más de cuidado"
    ],
    "nl": [
      "Omdat ze bezoekers op zich zijn, hebben kinderen het recht om met wat extra zorg behandeld te worden!"
    ]
  },
