  "rdfs:comment": {
    "de": [
      "Arvernes Homes hat sich zum Ziel gesetzt, Eigentümern zu helfen, indem es ihnen die Sorgen der Kurzzeitvermietung abnimmt und ihnen gleichzeitig ein höheres Einkommen als bei der klassischen Vermietung sichert."
    ],
    "en": [
      "Arvernes Homes aims to help homeowners by taking the hassle out of short-term rentals, while ensuring a higher income than traditional rentals."
    ],
    "it": [
      "Arvernes Homes si propone di aiutare i proprietari di casa eliminando la seccatura dell'affitto a breve termine, fornendo al contempo un reddito più elevato rispetto all'affitto tradizionale."
    ],
    "fr": [
      "Arvernes Homes a pour objectif d’aider les propriétaires en leur allégeant les tracas de la location courte durée tout en leur assurant un revenu supérieur à la location classique."
    ],
    "es": [
      "El objetivo de Arvernes Homes es ayudar a los propietarios de viviendas quitándoles las molestias del alquiler a corto plazo, a la vez que les proporciona unos ingresos superiores a los del alquiler tradicional."
    ],
    "nl": [
      "Arvernes Homes wil verhuurders helpen door de rompslomp van kortetermijnverhuur weg te nemen en tegelijkertijd een hoger inkomen te bieden dan traditionele verhuur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Arvernes Homes - Conciergerie sur Vichy"
    ]
  },
