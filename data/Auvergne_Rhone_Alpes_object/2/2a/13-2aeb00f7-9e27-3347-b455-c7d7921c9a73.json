  "rdfs:comment": {
    "de": [
      "Im Herzen eines kleinen Bauerndorfes bietet Ihnen die Auberge Campagnarde Komfort und Ruhe für eine Etappe oder einen Aufenthalt auf dem Land."
    ],
    "en": [
      "The Auberge Campagnarde is a lovely, rustic 3 star hotel and restaurant located at an altitude of 750m in the quaint village of Evosages in the heart of the Bugey countryside."
    ],
    "it": [
      "Nel cuore di un piccolo villaggio agricolo, l'Auberge Campagnarde offre comfort e tranquillità per una sosta o un soggiorno in campagna."
    ],
    "fr": [
      "Au cœur d'un petit village paysan, l'Auberge Campagnarde vous offre confort et quiétude pour une étape ou un séjour à la campagne."
    ],
    "es": [
      "En el corazón de un pequeño pueblo agrícola, el Auberge Campagnarde ofrece comodidad y tranquilidad para una parada o una estancia en el campo."
    ],
    "nl": [
      "De Auberge Campagnarde ligt in het hart van een klein boerendorp en biedt comfort en rust voor een tussenstop of een verblijf op het platteland."
    ]
  },
  "rdfs:label": {
