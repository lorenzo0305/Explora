  "rdfs:comment": {
    "de": [
      "Die Collection de la Praye wurde von leidenschaftlichen Sammlern gegründet. Sie präsentiert und verkauft Werke moderner und zeitgenössischer Künstler, die alle Medien verwenden: Malerei, Skulptur, Gravur, Foto..."
    ],
    "en": [
      "Created by passionate collectors, the Collection de la Praye presents and sells works by modern and contemporary artists using all media: painting, sculpture, engraving, photography..."
    ],
    "it": [
      "Creata da collezionisti appassionati, la Collection de la Praye presenta e vende opere di artisti moderni e contemporanei che utilizzano tutti i media: pittura, scultura, incisione, fotografia, ecc."
    ],
    "fr": [
      "Créée par des collectionneurs passionnés, la Collection de la Praye présente et met en vente, les œuvres d'artistes modernes et contemporains utilisant tous supports  : peinture, sculpture, gravure, photo..."
    ],
    "nl": [
      "De Collection de la Praye, opgericht door gepassioneerde verzamelaars, presenteert en verkoopt werken van moderne en hedendaagse kunstenaars in alle media: schilderkunst, beeldhouwkunst, gravure, fotografie, enz."
    ],
    "es": [
      "Creada por coleccionistas apasionados, la Collection de la Praye presenta y vende obras de artistas modernos y contemporáneos en todos los soportes: pintura, escultura, grabado, fotografía, etc."
    ]
  },
