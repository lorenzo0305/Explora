  "rdfs:comment": {
    "de": [
      "Auf diesem grünen Pfad tauchen Sie in die Welt von Jacques, dem Holzfäller, ein. Zwischen Baumstämmen und Holzstatuen können Sie sich auf einem spielerischen und für Anfänger geeigneten Weg führen lassen."
    ],
    "en": [
      "This green trail plunges you into the world of Jacques le Bûcheron. Between trunks and wooden statues, let yourself be guided along a fun trail accessible to beginners."
    ],
    "it": [
      "Questo percorso verde vi immerge nel mondo di Jacques le Bûcheron. Tra tronchi e statue di legno, lasciatevi guidare lungo un percorso divertente e accessibile ai principianti."
    ],
    "fr": [
      "Cette piste verte vous plonge dans l’univers de Jacques le Bûcheron. Entre troncs et statues de bois, laissez-vous guider au fil d’un parcours ludique et accessible aux débutants."
    ],
    "es": [
      "Este sendero verde le sumerge en el mundo de Jacques le Bûcheron. Entre troncos y estatuas de madera, déjate guiar por un divertido sendero accesible para principiantes."
    ],
    "nl": [
      "Dit groene pad neemt je mee in de wereld van Jacques de houthakker. Laat je tussen boomstammen en houten beelden leiden langs een leuk pad dat toegankelijk is voor beginners."
    ]
  },
  "rdfs:label": {
    "en": [
      "Jacques le Bûcheron play trail"
    ],
    "fr": [
      "Piste ludique Jacques le Bûcheron"
    ],
    "nl": [
      "Het speelpad van Jacques de houthakker"
    ]
  },
