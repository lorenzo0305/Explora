            "de": [
              "Die nordischen Abendveranstaltungen am Donnerstagabend bis 21 Uhr werden je nach Wetter- und Schneeverhältnissen angeboten (Informationen auf der Website domainedechamchaude.fr und auf unserer Facebook-Seite)"
            ],
            "en": [
              "Nordic night skiing on Thursday evenings until 9pm, depending on weather and snow conditions (information on the domainedechamchaude.fr website and on our Facebook page)"
            ],
            "it": [
              "Le notti nordiche del giovedì sera fino alle 21.00 sono soggette alle condizioni meteorologiche e della neve (informazioni sul sito domainedechamchaude.fr e sulla nostra pagina Facebook)"
            ],
            "fr": [
              "Les nocturne nordiques du jeudi soir jusqu'à 21h sont proposées en fonction des conditions météo et d'enneigement (information sur le site domainedechamchaude.fr et sur note page Facebook)"
            ],
            "es": [
              "Las noches nórdicas de los jueves por la noche hasta las 21:00 están sujetas a las condiciones meteorológicas y de nieve (información en el sitio domainedechamchaude.fr y en nuestra página de Facebook)"
            ],
            "nl": [
              "De nordicavonden op donderdagavond tot 21u zijn afhankelijk van het weer en de sneeuwcondities (informatie op de website domainedechamchaude.fr en op onze Facebookpagina)"
            ]
          },
