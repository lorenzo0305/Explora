  "rdfs:comment": {
    "de": [
      "Das Maison de la Montagne von Grenoble-Alpes Métropole empfängt Sie am Col de Porte.\r\n\r\nEin Netzwerk von Sozioprofessionellen ist vor Ort und begleitet Sie bei der Ausübung von Multiaktivitäten vor Ort (Skikurse, Biathlon, Naturausflüge....)."
    ],
    "en": [
      "Grenoble-Alpes Métropole's Maison de la Montagne welcomes you to Col de Porte.\r\n\r\nA network of socio-professionals is on hand to help you enjoy a range of activities on the site (ski lessons, biathlon, nature outings....)."
    ],
    "it": [
      "La Maison de la Montagne di Grenoble-Alpes Métropole vi accoglie sul Col de Porte in inverno.\r\n\r\nUna rete di operatori socio-professionali è a disposizione per aiutarvi a praticare una serie di attività sul posto (lezioni di sci, biathlon, escursioni nella natura, ecc.)"
    ],
    "fr": [
      "La Maison de la Montagne de Grenoble-Alpes Métropole vous accueille au Col de Porte en hivers.\r\n\r\nUn réseau de socioprofessionnels est sur place et vous accompagne pour la pratique de multi activités sur le site (cours de ski, biathlon, sorties nature….)"
    ],
    "es": [
      "La Maison de la Montagne de Grenoble-Alpes Métropole le da la bienvenida al Col de Porte.\r\n\r\nUna red de socioprofesionales está a su disposición para ayudarle a disfrutar de diversas actividades en el lugar (clases de esquí, biatlón, salidas a la naturaleza....)."
    ],
    "nl": [
      "Het Maison de la Montagne van Grenoble-Alpes Métropole verwelkomt je in de winter op de Col de Porte.\r\n\r\nEen netwerk van socioprofessionals staat voor je klaar om je te laten genieten van verschillende activiteiten ter plaatse (skilessen, biatlon, natuuruitstapjes, enz.)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison de la Montagne du Col de Porte"
    ]
  },
