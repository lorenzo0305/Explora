  "rdfs:comment": {
    "de": [
      "Hotel und Restaurant im Zentrum des Dorfes. Sie werden von freundlichen Gastgebern in einfachen Zimmern mit allem Komfort empfangen. Mahlzeiten werden täglich außer montags serviert."
    ],
    "en": [
      "Hotel & Restaurant in the centre of the village. You'll be welcomed by the friendly owners and stay in a simple room with all the mod cons. Meals are served every day except on Monday."
    ],
    "it": [
      "Ristorante dell'hotel nel centro del paese. Sarete accolti da proprietari cordiali, in camere semplici e confortevoli. I pasti vengono serviti tutti i giorni tranne il lunedì."
    ],
    "fr": [
      "Hôtel restaurant au centre du village. Vous serez accueilli par des patrons sympathiques, dans des chambres simples et tout confort. Repas servis tous les jours sauf lundi."
    ],
    "es": [
      "Hotel restaurante en el centro del pueblo. Será recibido por los amables propietarios, en habitaciones sencillas y confortables. Las comidas se sirven todos los días excepto el lunes."
    ],
    "nl": [
      "Hotel restaurant in het centrum van het dorp. U wordt ontvangen door vriendelijke eigenaren, in eenvoudige en comfortabele kamers. De maaltijden worden elke dag geserveerd, behalve op maandag."
    ]
  },
