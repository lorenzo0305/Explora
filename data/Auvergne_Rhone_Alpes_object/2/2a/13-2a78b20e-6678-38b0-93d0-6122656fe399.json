  "rdfs:comment": {
    "de": [
      "Ausgabe des Megève Blues Festivals wird wieder international renommierte Künstler präsentieren, die Megève zum Kochen bringen werden! Ein Muss!"
    ],
    "en": [
      "Surrounded by the summer scenery of Megève, the 11th edition of the Megève Blues Festival will once again be presenting a line-up of internationally renowned artists who will be creating an electric atmosphere in Megève!\r\nUnmissable!"
    ],
    "it": [
      "La undicesimo edizione estiva del Megève Blues Festival presenta ancora una volta artisti di fama internazionale che infiammeranno Megève! Assolutamente da non perdere!"
    ],
    "fr": [
      "C’est dans le paysage estival mégevan que la 11e édition du Megève Blues Festival présentera une nouvelle fois des artistes de renommée internationale qui mettront le feu à Megève! Incontournable!"
    ],
    "es": [
      "La 11ª edición del Festival de Blues de Megève volverá a presentar a artistas de renombre internacional que encenderán Megève ¡No se lo pierda!"
    ],
    "nl": [
      "De 11e editie van het Megève Blues Festival zal opnieuw internationaal bekende artiesten presenteren die Megève in vuur en vlam zullen zetten! Niet te missen!"
    ]
  },
