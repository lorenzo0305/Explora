  "rdfs:comment": {
    "de": [
      "Handwerklich gefertigte Keramik und sorgfältig zusammengestellte Gourmetboxen, um die einfachen Dinge zu genießen und köstliches, lokales Kunsthandwerk zu entdecken."
    ],
    "en": [
      "Gourmet, original and eco-responsible gift boxes of local products and crafts from the Ain and neighbouring regions."
    ],
    "it": [
      "Ceramiche artigianali e scatole gastronomiche assemblate con cura, per assaporare le cose semplici della vita e scoprire l'artigianato locale e gastronomico."
    ],
    "fr": [
      "Céramique artisanale et coffrets gourmands composés avec soin, pour savourer les choses simples et découvrir un artisanat gourmand et local."
    ],
    "nl": [
      "Handgemaakt keramiek en gourmetdozen die met zorg zijn samengesteld, om te genieten van de eenvoudige dingen in het leven en om lokaal, gastronomisch vakmanschap te ontdekken."
    ],
    "es": [
      "Cerámicas artesanales y cajas gourmet elaboradas con esmero, para saborear las cosas sencillas y descubrir la artesanía local y gourmet."
    ]
  },
