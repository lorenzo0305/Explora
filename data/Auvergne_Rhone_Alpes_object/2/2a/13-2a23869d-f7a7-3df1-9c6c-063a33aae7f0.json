  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine traditionelle Bergküche, in der sich auf dem Teller, ein wenig wie in den vergangenen Jahrhunderten in den Staffeln, Italien, Savoyen und die Schweiz kreuzen. Küche des Alpenraums in einem eleganten und gemütlichen Ambiente im Herzen des Dorfes."
    ],
    "en": [
      "Discover a traditional mountain cuisine where Italy, Savoy and Switzerland meet, a bit like in the past centuries in the relays. Cuisine of the Alps in an elegant and cosy atmosphere in the heart of the village."
    ],
    "it": [
      "Scoprite una cucina tipica di montagna i cui piatti, proprio come nelle stazioni di posta nei secoli passati, presentano sapori dell’Italia, della Savoia e della Svizzera. Cucina dell'arco alpino in un’atmosfera intima ed elegante nel cuore del villaggio."
    ],
    "fr": [
      "Découvrez une cuisine de montagne traditionnelle où se croisent dans l'assiette, un peu comme aux siècles passés dans les relais, l'Italie, la Savoie et la Suisse. Cuisine de l'arc alpin dans une ambiance élégante et cosy au cœur du village."
    ],
    "nl": [
      "Ontdek een traditionele bergkeuken waar Italië, Savoie en Zwitserland elkaar ontmoeten in het bord, zoals in de voorbije eeuwen in de relais. Alpenkeuken in een elegante en gezellige sfeer in het hart van het dorp."
    ],
    "es": [
      "Descubra una cocina tradicional de montaña en la que Italia, Saboya y Suiza se encuentran en el plato, como en los siglos pasados en los relevos. Cocina alpina en un ambiente elegante y acogedor en el corazón del pueblo."
    ]
  },
