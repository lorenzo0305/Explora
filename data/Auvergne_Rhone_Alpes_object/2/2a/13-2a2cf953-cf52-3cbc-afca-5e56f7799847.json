  "rdfs:comment": {
    "de": [
      "Dieses interaktive, spielerische und pädagogische Museum nimmt Sie mit auf eine Reise ins Reich des Elements Wasser."
    ],
    "en": [
      "This museum, which is interactive, fun and educational, takes you on an aquatic journey to discover the element of water."
    ],
    "it": [
      "Interattivo, divertente ed educativo, il Musée de l'Eau vi invita a un viaggio acquatico alla scoperta dell'elemento fondamentale per la vita sulla Terra: l'ACQUA!"
    ],
    "fr": [
      "Interactif, ludique et pédagogique le Musée de l’Eau vous invite à un voyage aquatique à la découverte de l’élément fondamental à la vie sur Terre : L'EAU !"
    ],
    "es": [
      "Interactivo, lúdico y pedagógico, el Musée de l'Eau le invita a un viaje acuático para descubrir el elemento fundamental para la vida en la Tierra: ¡EL AGUA!"
    ],
    "nl": [
      "Interactief, leuk en educatief, het Musée de l'Eau nodigt je uit op een waterreis om het element te ontdekken dat fundamenteel is voor het leven op aarde: WATER!"
    ]
  },
