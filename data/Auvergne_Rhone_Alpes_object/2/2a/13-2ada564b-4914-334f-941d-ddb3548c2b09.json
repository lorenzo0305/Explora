  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte über das Plateau des Petites Roches, genießen Sie dabei das außergewöhnliche Panorama, das das Plateau über die Bergketten bietet, und entdecken Sie die Markierungen, die in der Nähe bemerkenswerter Orte angebracht wurden."
    ],
    "en": [
      "Using your map, navigate around Le Plateau des Petites Roches, taking in the exceptional panoramic views over the mountain ranges from the plateau and finding the markers that have been placed near notable sites."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, muovetevi sul Plateau des Petites Roches ammirando l'eccezionale panorama dell'altopiano sulle catene montuose e scoprite i fari installati in prossimità di siti notevoli."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous sur le Plateau des Petites Roches tout en profitant du panorama exceptionnel qu'offre le plateau sur les chaines de montagne et découvrez les balises qui ont été installées à proximité de sites remarquables."
    ],
    "nl": [
      "Wandel met behulp van je kaart over het Plateau des Petites Roches, geniet van het uitzonderlijke panoramische uitzicht op de bergketens en ontdek de markeringen die bij opmerkelijke plaatsen zijn aangebracht."
    ],
    "es": [
      "Con la ayuda de su mapa, desplácese por el Plateau des Petites Roches mientras disfruta del excepcional panorama de la meseta sobre las cadenas montañosas y descubra las balizas que se han instalado cerca de lugares notables."
    ]
  },
  "rdfs:label": {
    "en": [
      "Children's heritage orienteering trail"
    ],
    "fr": [
      "Parcours d'orientation patrimoine enfant"
    ],
    "nl": [
      "Erfgoed oriëntatieloop voor kinderen"
    ]
  },
