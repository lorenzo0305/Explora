  "rdfs:comment": {
    "de": [
      "Umrunden Sie das Massiv Crey du Quart und nutzen Sie dabei die Mountainbike-Strecken des Bike Parks. Auf dieser abwechslungsreichen Strecke mit einer Passage durch den Wald können Sie den Lac de la Vieille entdecken und herrliche Ausblicke auf die Massive genießen."
    ],
    "en": [
      "Ride around the Massif du Crey du Quart on the Bike Park's mountain bike trails. This varied route, with a passage through the forest, allows you to discover the Lac de la Vieille and enjoy magnificent views of the Massif."
    ],
    "it": [
      "Percorrete il Massiccio del Crey du Quart sui sentieri per mountain bike del Bike Park. Questo percorso vario, con un passaggio nella foresta, permette di scoprire il Lac de la Vieille e di godere di magnifiche viste sulle montagne."
    ],
    "fr": [
      "Faites le tour du Massif du Crey du Quart en profitant des pistes VTT du Bike Park. Ce parcours varié avec un passage en forêt vous permettra de découvrir le Lac de la Vieille et de profiter de magnifiques points de vue sur les massifs."
    ],
    "nl": [
      "Rijd rond het Massif du Crey du Quart op de mountainbikeroutes van het Bike Park. Deze gevarieerde route, met een doorgang door het bos, laat je het Lac de la Vieille ontdekken en genieten van prachtige uitzichten over de bergen."
    ],
    "es": [
      "Recorra el Macizo del Crey du Quart por los senderos para bicicletas de montaña del Bike Park. Este recorrido variado, con paso por el bosque, permite descubrir el Lac de la Vieille y disfrutar de magníficas vistas sobre las montañas."
    ]
  },
  "rdfs:label": {
    "de": [
      "2 - Lac de la Vieille - Mountainbike-/VTTAE-Route"
    ],
    "ru": [
      "2 - Лак де ла Вьель - маршрут для горных велосипедов"
    ],
    "en": [
