  "rdfs:comment": {
    "de": [
      "Das Noemys Valence Nord - ex Mona Lisa empfängt Sie in der Stadt Bourg-lès-Valence, nur 1,5 km von der Autobahn A7 entfernt.  Freuen Sie sich auf ein Restaurant, das traditionelle Küche serviert, die Sie auch auf der Terrasse genießen können."
    ],
    "en": [
      "Noemys Valence Nord - ex Mona Lisa is located in Bourg-lès-Valence, just 1.5 km from the A7 freeway.  There's also a restaurant serving traditional cuisine, which you can enjoy on the terrace."
    ],
    "it": [
      "Scoprite l'Hotel Noemys Valence Nord a Bourg les Valence. Servizi: ristorante, bar, giardino, parcheggio, camere familiari, accesso disabili, wifi, parcheggio custodito chiuso di notte. Accesso anche agli autobus."
    ],
    "fr": [
      "Découvrez l'Hôtel Noemys Valence Nord à Bourg les Valence. Services : restaurant, bar, jardin, parking, chambres familiales, accès handicapés, wifi, parking fermé la nuit et sécurisé. Accès pour les bus aussi."
    ],
    "nl": [
      "Het Noemys Valence Nord - ex Mona Lisa ligt in Bourg-lès-Valence, op slechts 1,5 km van de snelweg A7.  Er is ook een restaurant dat traditionele gerechten serveert, waarvan u kunt genieten op het terras."
    ],
    "es": [
      "Descubra el Hotel Noemys Valence Nord en Bourg les Valence. Servicios: restaurante, bar, jardín, parking, habitaciones familiares, acceso minusválidos, wifi, parking vigilado cerrado por la noche. También acceso en autobús."
    ]
  },
