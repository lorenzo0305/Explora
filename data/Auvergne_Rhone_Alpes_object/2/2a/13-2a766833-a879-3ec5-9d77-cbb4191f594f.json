  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse der natürlichen Farben. Workshops zum Thema Pflanzenfärben, Herstellung von Tinten und Kreativkurse rund um Pflanzen und Wolle. Animationen auf Messen und Festen fesseln Groß und Klein, Schulklassen und Neugierige."
    ],
    "en": [
      "Discover the secrets of natural colors. Vegetable dyeing workshops, ink making and creative workshops with plants and wool. Events at fairs and festivals captivate young and old, schoolchildren and the curious."
    ],
    "it": [
      "Scoprite i segreti dei colori naturali. Laboratori di tintura vegetale, creazione di inchiostri e corsi creativi basati su piante e lana. Gli eventi in occasione di fiere e festival affascinano grandi e piccini, scolari e curiosi."
    ],
    "fr": [
      "Découvrez les secrets des couleurs naturelles. Ateliers de teinture végétale, fabrication d’encres et stages créatifs autour des plantes et de la laine. Animations sur foires et fêtes, captivent petits et grands, scolaires et curieux."
    ],
    "nl": [
      "Ontdek de geheimen van natuurlijke kleuren. Workshops plantaardig verven, inkt maken en creatieve cursussen rond planten en wol. Evenementen op beurzen en festivals boeien jong en oud, schoolkinderen en nieuwsgierigen."
    ],
    "es": [
      "Descubra los secretos de los colores naturales. Talleres de tintes vegetales, fabricación de tintas y cursos creativos en torno a las plantas y la lana. Eventos en ferias y festivales cautivan a pequeños y mayores, escolares y curiosos."
    ]
  },
  "rdfs:label": {
