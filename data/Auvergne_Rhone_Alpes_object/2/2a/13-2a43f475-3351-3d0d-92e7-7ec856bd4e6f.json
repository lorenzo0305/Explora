  "rdfs:comment": {
    "de": [
      "Gitarrenfestival, bei dem die Abtei von Chanteuges vier Tage lang, von Mittwoch, dem 15.07. bis Samstag, dem 18.07.2026, weltberühmte Gitarristen und junge, aufstrebende Künstler beherbergt.\r\nDas Festival feiert in diesem Jahr sein 10-jähriges Bestehen."
    ],
    "en": [
      "For 4 days, from Wednesday 15/07 to Saturday 18/07/2026, Chanteuges Abbey welcomes world-renowned guitarists, as well as up-and-coming young artists.\r\nThe festival celebrates its 10th anniversary this year."
    ],
    "it": [
      "Un festival di chitarra in cui l'Abbazia di Chanteuges ospita per 4 giorni, da mercoledì 15/07 a sabato 18/07/2026, chitarristi di fama mondiale e giovani artisti emergenti.\r\nIl festival celebra quest'anno il suo 10° anniversario."
    ],
    "fr": [
      "Festival de guitares où l'abbaye de Chanteuges accueille durant 4 jours, du mercredi 15/07 au samedi 18/07/2026, des guitaristes à la renommée mondiale, ainsi que de jeunes artistes plein d'avenir.\r\nLe festival fête ses 10 ans cette année."
    ],
    "es": [
      "Festival de guitarra en el que la Abadía de Chanteuges acoge durante 4 días, del miércoles 15/07 al sábado 18/07/2026, a guitarristas de renombre mundial y a jóvenes promesas.\r\nEl festival celebra este año su 10º aniversario."
    ],
    "nl": [
      "Een gitaarfestival waar de Abdij van Chanteuges 4 dagen lang, van woensdag 15/07 tot zaterdag 18/07/2026, wereldberoemde gitaristen en opkomende jonge artiesten ontvangt.\r\nHet festival viert dit jaar zijn 10e verjaardag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival six cordes au fil de l'Allier"
    ]
  },
