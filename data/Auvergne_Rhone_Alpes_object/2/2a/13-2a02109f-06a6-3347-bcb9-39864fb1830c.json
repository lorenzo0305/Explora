  "rdfs:comment": {
    "de": [
      "Etang Neuf überspannt die Departements Creuse (Gemeinde Dontreix) und Puy-de-Dôme (Gemeinde Montel-de-Gelat). Es ist ein Teich mit einer Wasserfläche von 22 Hektar, der für das Karpfenangeln ohne Tötung bestimmt ist."
    ],
    "en": [
      "Etang Neuf straddles the departments of Creuse (municipality of Dontreix) and Puy-de-Dôme (municipality of Montel-de-Gelat). It is a pond with a surface area of ​​22 hectares of water intended for no-kill carp fishing."
    ],
    "it": [
      "L'Etang Neuf si trova al confine tra i dipartimenti di Creuse (comune di Dontreix) e Puy-de-Dôme (comune di Montel-de-Gelat). Si tratta di uno stagno con una superficie di 22 ettari in acqua per la pesca alla carpa in no-kill."
    ],
    "fr": [
      "L'étang Neuf est situé à cheval sur les départements de la Creuse (commune de Dontreix) et du Puy-de-Dôme (commune du Montel-de-Gelat). C'est un étang d'une surface de 22 hectares en eau à vocation de pêche à la carpe en no-kill."
    ],
    "nl": [
      "Het Etang Neuf ligt op de grens tussen de departementen Creuse (gemeente Dontreix) en Puy-de-Dôme (gemeente Montel-de-Gelat). Het is een vijver met een oppervlakte van 22 hectare water voor karpervissen in no-kill."
    ],
    "es": [
      "El Etang Neuf está situado en la frontera entre los departamentos de Creuse (municipio de Dontreix) y Puy-de-Dôme (municipio de Montel-de-Gelat). Se trata de un estanque con una superficie de 22 hectáreas de agua para la pesca de la carpa sin muerte."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Étang Neuf"
    ],
    "en": [
      "Fishing site - Étang Neuf"
    ],
    "fr": [
      "Site de pêche - Étang Neuf"
    ]
  },
