  "rdfs:comment": {
    "de": [
      "Die Cartoucherie in Bourg-lès-Valence ist ein alter architektonischer Industriekomplex, der zunächst als Textilfabrik und später als nationale Cartoucherie diente und heute verschiedene Unternehmen beherbergt, die sich mit Bildern, Film und Animation beschäftigen."
    ],
    "en": [
      "The Cartoucherie in Bourg-lès-Valence is a former industrial architectural plant first used as a textile factory, then a national cartridge factory and today is home to various companies involved with the image, cinema and animation industry."
    ],
    "it": [
      "La Cartoucherie de Bourg-lès-Valence è un ex complesso architettonico industriale, prima fabbrica tessile, poi cartoucherie nazionale, che oggi ospita diverse aziende dedicate all'industria dell'immagine, del cinema e dell'animazione."
    ],
    "fr": [
      "La Cartoucherie de Bourg-lès-Valence est un ancien ensemble architectural industriel, d’abord usine textile, puis cartoucherie nationale, qui abrite aujourd’hui diverses entreprises consacrées à l’image, au cinéma et à l’animation."
    ],
    "nl": [
      "La Cartoucherie in Bourg-lès-Valence is een oud architecturaal industriegebied, eerst een textielfabriek, toen een nationale munitiefabriek (cartoucherie), waarin tegenwoordig diverse bedrijven gehuisvest zijn die zich bezighouden aan beeld, cinema en animatie."
    ],
    "es": [
      "La Cartoucherie de Bourg-lès-Valence es un antiguo complejo arquitectónico industrial, primero fábrica textil y luego fábrica nacional de cartuchos, que hoy alberga varias empresas dedicadas a la industria de la imagen, el cine y la animación."
    ]
  },
