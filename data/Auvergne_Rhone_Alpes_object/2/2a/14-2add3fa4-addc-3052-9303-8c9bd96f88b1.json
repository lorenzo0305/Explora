  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4e6ed312-1ca0-3d09-8bbe-d836b024bc6b",
      "dc:description": {
        "de": [
          "SCEA Le Patis ist ein Handwerksbetrieb, der zahlreiche Milchprodukte anbietet: lokale Käsesorten wie Pavé de l'Aa und Tomme Bourthoise, Butter, Crème fraîche, Fromage Blanc, Joghurt vom Bauernhof, Mousse au Chocolat, ... und viele andere Produkte."
        ],
        "en": [
          "SCEA Le Patis is an artisanal company which offers many dairy products: local cheeses such as the pavé de l'Aa and the Tomme Bourthoise, butter, fresh cream, cottage cheese, farm yoghurts, chocolate mousse,... and many other products."
        ],
        "it": [
          "SCEA Le Patis è un'azienda artigianale che offre un'ampia gamma di prodotti lattiero-caseari: formaggi locali come il pavé de l'Aa e il Tomme Bourthoise, burro, panna, fromage blanc, yogurt di fattoria, mousse al cioccolato, ecc. e molti altri prodotti."
        ],
        "fr": [
          "SCEA Le Patis est une entreprise artisanale qui propose de nombreux produits laitiers : Fromages locaux tels que le pavé de l'Aa et la Tomme Bourthoise, Beurre, Crème fraiche, Fromage Blanc, Yaourts fermiers, Mousse au chocolat,... et bien d'autres produits."
        ],
        "nl": [
          "SCEA Le Patis is een ambachtelijk bedrijf dat een breed assortiment zuivelproducten aanbiedt: lokale kazen zoals Pavé de l'Aa en Tomme Bourthoise, boter, room, fromage blanc, boerenyoghurt, chocolademousse, enz. en vele andere producten."
        ],
        "es": [
          "SCEA Le Patis es una empresa artesanal que ofrece una amplia gama de productos lácteos: quesos locales como el pavé de l'Aa y la Tomme Bourthoise, mantequilla, nata, fromage blanc, yogures de granja, mousse de chocolate, etc. y muchos otros productos."
        ]
      },
      "@type": [
        "Description"
      ],
