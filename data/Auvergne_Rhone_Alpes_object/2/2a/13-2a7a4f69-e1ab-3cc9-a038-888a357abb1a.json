  "rdfs:comment": {
    "de": [
      "Ich biete Ihnen Lederkreationen, Einzelstücke, handgefertigt und mit schönen Absichten: Schmuck, Lederwaren, Bilder, Dekorationen...\r\nSie haben eine Idee für ein Lederstück? Wir entwerfen gemeinsam das Schnittmuster und ich erwecke Ihre Idee zum Leben."
    ],
    "en": [
      "I offer leather creations, unique pieces, handmade and with beautiful intentions: jewelry, leather goods, paintings, decorations...\r\nDo you have an idea for a leather piece? We design the pattern together and I bring your idea to life."
    ],
    "it": [
      "Offro creazioni in pelle, pezzi unici, fatti a mano con belle intenzioni: gioielli, pelletteria, dipinti, decorazioni...\r\nAvete un'idea per un pezzo in pelle? Disegneremo insieme il modello e darò vita alla vostra idea."
    ],
    "fr": [
      "Je vous propose des créations en cuir, pièces uniques, fait main et avec de belles intentions : bijoux, maroquinerie, tableaux, décorations... \r\nVous avez l'idée d'une pièce en cuir ? Nous concevons le patron ensemble et je donne vie à votre idée."
    ],
    "es": [
      "Ofrezco creaciones en cuero, piezas únicas, hechas a mano con bellas intenciones: joyas, marroquinería, cuadros, adornos...\r\n¿Tienes una idea para una pieza de cuero? Diseñaremos juntos el patrón y daré vida a tu idea."
    ],
    "nl": [
      "Ik bied leren creaties aan, unieke stukken, handgemaakt met mooie bedoelingen: juwelen, lederwaren, schilderijen, decoraties...\r\nHeb je een idee voor een stuk leer? We ontwerpen samen het patroon en ik breng je idee tot leven."
    ]
  },
  "rdfs:label": {
