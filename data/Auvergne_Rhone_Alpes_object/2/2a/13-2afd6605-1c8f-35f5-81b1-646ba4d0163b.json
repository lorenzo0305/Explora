  "rdfs:comment": {
    "de": [
      "Eine fröhliche Mischung aus Orientierungslauf und Escape Game im Freien, die Spaß macht und unter freiem Himmel stattfindet, lässt Sie als Team, Familie oder Freunde in ein einzigartiges Erlebnis eintauchen,\r\nMit einem zur Verfügung gestellten Touchscreen-Tablet ausgestattet, begeben Sie sich auf die Suche!"
    ],
    "en": [
      "A fun, open-air mix of an orienteering course and an outdoor Escape Game, this is a unique experience for teams, families and friends,\r\nEquipped with a touch-sensitive tablet, you're ready to embark on your quest!"
    ],
    "it": [
      "Un divertente mix di percorso di orientamento e gioco di fuga all'aperto, un'esperienza unica per squadre, famiglie e amici,\r\nArmati di un tablet sensibile al tocco, potrete partire per la vostra ricerca!"
    ],
    "fr": [
      "Ludique et en plein air, un joyeux mélange de parcours d’orientation et d’Escape Game en extérieur, vous plonge dans une expérience unique en équipe, en famille ou entre amis, \r\nMunis d’une tablette tactile mise à disposition, lancez-vous dans la quête !"
    ],
    "es": [
      "Una divertida mezcla de recorrido de orientación y juego de escape al aire libre, una experiencia única para equipos, familias y amigos,\r\nArmados con una tableta táctil, ¡emprenderéis la búsqueda!"
    ],
    "nl": [
      "Een leuke, openluchtmix van een oriëntatieloopbaan en een outdoor Escape Game, een unieke ervaring voor teams, families en vrienden,\r\nGewapend met een aanraakgevoelige tablet kun je aan je zoektocht beginnen!"
    ]
  },
