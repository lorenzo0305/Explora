      "@id": "https://data.datatourisme.fr/1d447d9b-2ec4-3f80-be29-11b2bf6d3612",
      "dc:description": {
        "de": [
          "Meerblick, entspannende Räume und eine köstliche Küche sorgen für unvergessliche Momente.\nGenießen Sie eine Gourmetpause auf unserer Terrasse!"
        ],
        "en": [
          "Sea views, relaxing spaces & tasty cuisine, for unforgettable moments.\nEnjoy a gourmet break on our terrace!"
        ],
        "it": [
          "Vista sul mare, spazi rilassanti e cucina gustosa, per momenti indimenticabili.\nVenite a godervi una pausa gourmet sulla nostra terrazza!"
        ],
        "fr": [
          "Vue mer, espaces relaxants & cuisine savoureuse, pour des moments inoubliables.\nVenez profiter d’une pause gourmande sur notre terrasse !"
        ],
        "es": [
          "Vistas al mar, espacios relajantes y sabrosa cocina, para momentos inolvidables.\n¡Venga a disfrutar de una pausa gastronómica en nuestra terraza!"
        ],
        "nl": [
          "Uitzicht op zee, ontspannende ruimtes & smakelijke gerechten, voor onvergetelijke momenten.\nKom en geniet van een gastronomische pauze op ons terras!"
        ]
      },
