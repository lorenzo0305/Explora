  "rdfs:comment": {
    "de": [
      "Steeve Colin, passionierter Angelführer mit über 20 Jahren Erfahrung und staatlichem Diplom, um die Techniken des Fliegenfischens oder des Angelns mit Naturködern in wilden und geschützten Angelgebieten zu erlernen oder zu verbessern."
    ],
    "en": [
      "Steeve Colin, a passionate fishing guide with over 20 years experience and a state certificate, to learn or improve fly fishing or natural bait fishing techniques in wild, unspoilt fishing areas."
    ],
    "it": [
      "Steeve Colin, appassionata guida di pesca con oltre 20 anni di esperienza e certificato statale, per imparare o migliorare le tecniche di pesca a mosca o con esche naturali in zone di pesca selvagge e incontaminate."
    ],
    "fr": [
      "Steeve Colin, moniteur guide de pêche passionné, de + de 20 ans d'expériences, diplômé d’un brevet d’état, pour apprendre ou progresser dans les techniques de la pêche à la mouche ou aux appâts naturels sur des secteurs de pêche sauvages et préservés."
    ],
    "es": [
      "Steeve Colin, un apasionado guía de pesca con más de 20 años de experiencia y certificado estatal, para aprender o perfeccionar técnicas de pesca a mosca o con cebo natural en zonas de pesca salvajes y vírgenes."
    ],
    "nl": [
      "Steeve Colin, een gepassioneerde visgids met meer dan 20 jaar ervaring en een staatsdiploma, om technieken voor vliegvissen of vissen met natuurlijk aas te leren of te verbeteren in wilde, ongerepte visgebieden."
    ]
  },
  "rdfs:label": {
