  "rdfs:comment": {
    "de": [
      "Mehr als 800 Fotos, zahlreiche Dokumente sowie ein 9,50 m langer historischer Fries enthüllen das lokale Kulturerbe (Kirchen...). Stricken mit der Gabel, Gedichte, Dialekt, Kulturerbe, mehr als 22 Jahrhunderte Geschichte von Naves, des Bourbonnais und Frankreichs."
    ],
    "en": [
      "More than 800 photos, numerous documents and a 9.50m-long historical frieze reveal the local heritage (churches, etc.). Fork-knitting, poetry, dialect, heritage - over 22 centuries of Naves, Bourbonnais and French history."
    ],
    "it": [
      "Più di 800 foto, numerosi documenti e un fregio storico lungo 9,50 m rivelano il patrimonio locale (chiese, ecc.). Maglia a forcella, poesia, dialetto, patrimonio: più di 22 secoli di storia di Naves, del Bourbonnais e della Francia."
    ],
    "fr": [
      "Plus de 800 photos, de nombreux documents ainsi qu'une frise historique de 9,50m dévoilent le patrimoine local (églises...). Tricot à la fourche, poésies, patois, patrimoine, plus de 22 siècles d'histoire de Naves, du Bourbonnais, de la France."
    ],
    "nl": [
      "Meer dan 800 foto's, talrijke documenten en een 9,50 m lange historische fries onthullen het lokale erfgoed (kerken, enz.). Vlechtwerk, poëzie, dialect, erfgoed - meer dan 22 eeuwen geschiedenis van Naves, de Bourbonnais en Frankrijk."
    ],
    "es": [
      "Más de 800 fotos, numerosos documentos y un friso histórico de 9,50 m de largo revelan el patrimonio local (iglesias, etc.). Tejido de horquilla, poesía, dialecto, patrimonio: más de 22 siglos de historia de Naves, del Bourbonnais y de Francia."
    ]
  },
