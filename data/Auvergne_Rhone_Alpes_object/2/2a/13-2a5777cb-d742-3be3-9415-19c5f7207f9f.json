  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Golfsport ganz entspannt in einer grünen Oase mit Blick auf den See, 2 Minuten vom Stadtzentrum entfernt. Technischer 9-Loch-Parcours (Par 35) und kompakter 6-Loch-Parcours. Große überdachte Driving Range. Einführungen nach Anmeldung. Zahlreiche Wettkämpfe."
    ],
    "en": [
      "Enjoy relaxed golfing in a green setting overlooking the lake, 2 minutes from the town center. 9-hole technical course (par 35) and 6-hole compact course. Large covered driving range. Introductory lessons on request. Numerous competitions."
    ],
    "it": [
      "Venite a scoprire il golf in un ambiente rilassato, con vista sul lago, a 2 minuti dal centro città. Percorso tecnico a 9 buche (par 35) e percorso compatto a 6 buche. Ampio campo pratica coperto. Iniziative al momento della registrazione. Numerosi concorsi."
    ],
    "fr": [
      "Venez découvrir le golf en toute décontraction dans un écrin de verdure, avec vue sur le lac à 2 minutes du centre-ville. Parcours 9 trous technique (par 35) et 6 trous compact. Grand practice couvert. Initiations sur inscription. Nombreuses compétitions."
    ],
    "es": [
      "Venga a descubrir el golf en un entorno relajado, con vistas al lago, a 2 minutos del centro de la ciudad. Campo técnico de 9 hoyos (par 35) y campo compacto de 6 hoyos. Amplio campo de prácticas cubierto. Iniciaciones en el registro. Numerosos concursos."
    ],
    "nl": [
      "Kom golf ontdekken in een ontspannen omgeving, met uitzicht op het meer, op 2 minuten van het stadscentrum. 9-holes technische baan (par 35) en 6-holes compacte baan. Grote overdekte driving range. Inwijdingen bij inschrijving. Talrijke wedstrijden."
    ]
  },
  "rdfs:label": {
