  "rdfs:comment": {
    "de": [
      "Diese charmante Adresse, die sich durch ihre freundliche Atmosphäre und das Flair eines großen Familienhauses auszeichnet, empfängt Sie für alle Ihre Firmenveranstaltungen: Seminare, Teambuilding und Afterwork."
    ],
    "en": [
      "This charming address, with its friendly atmosphere and family home feel, welcomes you for all your corporate events: seminars, team building and afterwork."
    ],
    "it": [
      "Questo indirizzo affascinante, con la sua atmosfera amichevole e familiare, vi accoglie per tutti i vostri eventi aziendali: seminari, team-building ed eventi post-lavoro."
    ],
    "fr": [
      "Cette charmante adresse, qui se différencie par son ambiance conviviale et ses airs de grande maison de famille, vous accueille pour tous vos événements d’entreprise : séminaires, Team building et Afterwork."
    ],
    "es": [
      "Esta encantadora dirección, con su ambiente acogedor y su sensación de hogar familiar, le da la bienvenida para todos sus eventos corporativos: seminarios, team-building y eventos after-work."
    ],
    "nl": [
      "Dit charmante adres, met zijn vriendelijke sfeer en huiselijke sfeer, verwelkomt u voor al uw bedrijfsevenementen: seminars, teambuilding en after-work events."
    ]
  },
