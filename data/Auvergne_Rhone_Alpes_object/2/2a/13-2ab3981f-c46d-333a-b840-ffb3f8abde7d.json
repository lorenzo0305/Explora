  "rdfs:comment": {
    "de": [
      "Um den Sommer einzuläuten, laden die Stadt Montélimar und Montélimar Agglomération Tourisme Sie ab 19.00 Uhr zu einem festlichen Abend auf der Plaine des Sports et des Loisirs ein! Gute Laune und Geselligkeit sind garantiert!"
    ],
    "en": [
      "To herald in summer, the town of Montélimar and Montélimar Agglomération Tourisme invite you to the Plaine des Sports et des Loisirs from 7pm for a festive evening! Fun and conviviality guaranteed!"
    ],
    "it": [
      "Per annunciare l'arrivo dell'estate, la città di Montélimar e Montélimar Agglomération Tourisme vi invitano alla Plaine des Sports et des Loisirs dalle 19:00 per una serata di festa! Buon umore e convivialità garantiti!"
    ],
    "fr": [
      "Pour annoncer l'été, la ville de Montélimar et Montélimar Agglomération Tourisme vous donnent rendez-vous à la Plaine des Sports et des Loisirs dès 19h00 pour une soirée festive ! Bonne humeur et convivialité garanties !"
    ],
    "es": [
      "Para dar la bienvenida al verano, la ciudad de Montélimar y Montélimar Agglomération Tourisme le invitan a una velada festiva en la Plaine des Sports et des Loisirs a partir de las 19.00 h Buen humor y buena convivencia garantizados"
    ],
    "nl": [
      "Om de zomer in te luiden nodigen de stad Montélimar en Montélimar Agglomération Tourisme je uit op de Plaine des Sports et des Loisirs vanaf 19 uur voor een feestelijke avond! Goed humeur en gezelligheid gegarandeerd!"
    ]
  },
