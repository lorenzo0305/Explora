  "rdfs:comment": {
    "de": [
      "25-Meter-Becken, Lernbecken, Spielplatz im Freien, städtische Schwimmschule, öffentlicher Empfang, Vereine?\r\nDas Schwimmbad ist während der Allerheiligenferien geschlossen.\r\n\r\nDas Schwimmbad ist vom 24/02 bis 9/03/2025 geschlossen"
    ],
    "en": [
      "25 m and learners' pools, outdoor play area, municipal swimming school, public and club access."
    ],
    "it": [
      "25 m e piscine didattiche, area giochi all'aperto, scuola di nuoto comunale, reception pubblica, club?\r\nLa piscina è chiusa durante le festività di Ognissanti.\r\n\r\nLa piscina resterà chiusa dal 24/02 al 9/03/2025"
    ],
    "fr": [
      "Bassins de 25 m et d'apprentissage, aire de jeux extérieure, école de natation municipale, accueil public, clubs…\r\nLa piscine est fermée durant les vacances de La Toussaint.\r\n\r\nLa piscine sera fermée du 24/02 au 9/03/2025"
    ],
    "es": [
      "Piscina de 25 m y de aprendizaje, zona de juegos al aire libre, escuela municipal de natación, recepción pública, clubes..\r\nLa piscina está cerrada durante las vacaciones de Todos los Santos.\r\n\r\nLa piscina permanecerá cerrada del 24/02 al 9/03/2025"
    ],
    "nl": [
      "25 m en leerbaden, buitenspeeltuin, gemeentelijke zwemschool, openbare receptie, clubs?\r\nHet zwembad is gesloten tijdens de Allerheiligen vakantie.\r\n\r\nHet zwembad zal gesloten zijn van 24/02 tot 9/03/2025"
    ]
  },
  "rdfs:label": {
