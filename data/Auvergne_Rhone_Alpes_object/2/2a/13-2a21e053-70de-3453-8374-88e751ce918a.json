  "rdfs:comment": {
    "de": [
      "Was ist Ardèche Outdoor Activités?\r\nSpezialist für Natursportarten wie Canyoning, Klettern, Via Ferrata, Höhlenforschung und Kanu-Kajak.\r\nZusammenschluss von unabhängigen Lehrern aus der Ardèche, um ein lokales und sicheres Abenteuer zu gewährleisten."
    ],
    "en": [
      "What is Ardèche Outdoor Activities?\r\nSpecializing in outdoor sports such as canyoning, climbing, Via Ferrata, caving and canoeing.\r\nA group of independent Ardèche instructors, to ensure a safe, local adventure."
    ],
    "it": [
      "Che cos'è Ardèche Outdoor Activities?\r\nSpecialisti in sport all'aria aperta come canyoning, arrampicata, via ferrata, speleologia e canoa.\r\nUn gruppo di istruttori indipendenti dell'Ardèche per garantire un'avventura sicura e locale."
    ],
    "fr": [
      "Ardèche Outdoor Activités c'est quoi ? \r\nSpécialiste de sport de pleine nature tel que le Canyoning, l'Escalade, la Via Ferrata, la Spéléo et le Canoë-Kayak.\r\nRegroupement de moniteurs indépendants Ardéchois, pour assurer une aventure locale et sécurisée."
    ],
    "es": [
      "¿Qué es Ardèche Outdoor Activities?\r\nEspecialistas en deportes al aire libre como barranquismo, escalada, vías ferratas, espeleología y piragüismo.\r\nUn grupo de monitores independientes de la Ardèche para garantizar una aventura segura y local."
    ],
    "nl": [
      "Wat is Ardèche Outdoor Activities?\r\nSpecialisten in buitensporten zoals canyoning, klimmen, Via Ferrata, speleologie en kanoën.\r\nEen groep onafhankelijke instructeurs uit de Ardèche voor een veilig, lokaal avontuur."
    ]
  },
