  "rdfs:comment": {
    "de": [
      "Der Espace Louis Nodon ist ein gemeinschaftlicher Kulturraum, der ein vielfältiges Kunst- und Kulturprogramm (Filmvorführungen, Konzerte, Theatervorstellungen und andere Aufführungen...) anbietet und Künstlerresidenzen beherbergt."
    ],
    "en": [
      "The Espace Louis Nodon is a community cultural space offering a varied programme of artistic and cultural events (cinema screenings, concerts, theatre and other performances...) and hosting artists' residencies."
    ],
    "it": [
      "L'Espace Louis Nodon è uno spazio culturale comunitario che offre un programma vario di eventi artistici e culturali (proiezioni di film, concerti, spettacoli teatrali e di altro tipo, ecc.) e ospita residenze d'artista."
    ],
    "fr": [
      "L’Espace Louis Nodon est un espace culturel communautaire qui propose une programmation artistique et culturelle variée (projections cinéma, concerts, représentations théâtrales et autres spectacles...) et qui accueille des résidences d'artistes."
    ],
    "es": [
      "El Espace Louis Nodon es un espacio cultural comunitario que ofrece una variada programación de actos artísticos y culturales (proyecciones de películas, conciertos, representaciones teatrales y de otro tipo, etc.) y acoge residencias de artistas."
    ],
    "nl": [
      "De Espace Louis Nodon is een culturele gemeenschapsruimte met een gevarieerd programma van artistieke en culturele evenementen (filmvoorstellingen, concerten, theater- en andere voorstellingen, enz."
    ]
