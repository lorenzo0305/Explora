  "rdfs:comment": {
    "de": [
      "Am Place des Arcades in 2 Alpes 1800 gelegen, in einer warmen, bergischen Atmosphäre, freuen sich François und sein Küchenchef darauf, Sie zu empfangen und zu verwöhnen."
    ],
    "en": [
      "Located on Place des Arcades in Les 2 Alpes 1800, in a warm and mountain-style atmosphere, François and his head chef will be delighted to welcome you and treat you to a delicious meal."
    ],
    "it": [
      "Situato in Place des Arcades a Les 2 Alpes 1800, in un’atmosfera calda e montana, François e il suo chef saranno felici di accogliervi e di deliziarvi con la loro cucina."
    ],
    "fr": [
      "Situé sur la place des Arcades à 2 Alpes 1800, dans une ambiance chaleureuse et montagnarde, François et son chef de cuisine seront heureux de vous accueillir et de vous régaler."
    ],
    "es": [
      "Situado en la Place des Arcades en 2 Alpes 1800, en un cálido ambiente de montaña, François y su chef estarán encantados de recibirle y deleitarle."
    ],
    "nl": [
      "Gelegen aan de Place des Arcades in 2 Alpes 1800, in een warme bergsfeer, zullen François en zijn chef-kok je met plezier verwelkomen en verwennen."
    ]
  },
