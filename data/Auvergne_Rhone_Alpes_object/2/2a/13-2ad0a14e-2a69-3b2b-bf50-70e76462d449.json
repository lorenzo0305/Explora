  "rdfs:comment": {
    "de": [
      "PR Zinc bietet Ihnen maßgeschneiderte Kreationen aus Zink und Kupfer: Deko-Objekte, Wetterfahnen, Schilder, Möbel, Innen- und Außenobjekte. Er führt auch Ihre Verzinkungs- und Dacharbeiten aus."
    ],
    "en": [
      "Made-to-measure decorative objects in zinc, copper or brass.  Everything is handmade.  Weather vanes, signs, furniture, indoor and outdoor items..."
    ],
    "it": [
      "PR Zinc vi offre creazioni su misura in zinco e rame: oggetti decorativi, banderuole, insegne, mobili, oggetti per interni ed esterni. Esegue anche lavori di zinco e coperture."
    ],
    "fr": [
      "PR Zinc vous propose des créations sur mesure en zinc et cuivre : objets déco, girouettes, enseignes, mobilier, objets intérieurs et extérieurs. Il réalise également vos travaux de zinguerie et toiture."
    ],
    "es": [
      "PR Zinc le ofrece creaciones a medida en zinc y cobre: objetos decorativos, veletas, señales, muebles, objetos de interior y exterior. También realiza sus trabajos de zincado y techado."
    ],
    "nl": [
      "PR Zinc biedt u maatwerk in zink en koper: decoratieve objecten, windwijzers, uithangborden, meubels, binnen- en buitenobjecten. Het voert ook uw zinkwerk en dakbedekking uit."
    ]
  },
