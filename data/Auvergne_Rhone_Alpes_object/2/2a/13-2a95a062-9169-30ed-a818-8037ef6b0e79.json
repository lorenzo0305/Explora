  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren bieten Sophie und Denis Neytard, Sommeliers Cavistes, eine große Auswahl an Weinen, Spirituosen, Feinkost, Accessoires usw. an.\r\nEine Abteilung mit Produkten aus dem \"Allier Bourbonnais\" wird besonders hervorgehoben."
    ],
    "en": [
      "For 30 years, Sophie and Denis Neytard, Sommeliers Cavistes, have been offering a wide choice of wines, spirits, delicatessen, accessories...\r\nThe \"Allier Bourbonnais\" department is particularly well represented."
    ],
    "it": [
      "Da 30 anni, Sophie e Denis Neytard, Sommeliers Cavistes, offrono un'ampia scelta di vini, liquori, specialità gastronomiche, accessori...\r\nIl reparto \"Allier Bourbonnais\" è particolarmente fornito."
    ],
    "fr": [
      "Depuis 30 ans, Sophie et Denis Neytard, Sommeliers Cavistes, offrent un large choix de vins, spiritueux, épicerie fine, accessoires...\r\nUn rayon produits \"Allier Bourbonnais\" est particulièrement mis en valeur."
    ],
    "nl": [
      "Sophie en Denis Neytard, sommeliers Cavistes, bieden al 30 jaar een ruime keuze aan wijnen, sterke dranken, delicatessen, accessoires...\r\nDe afdeling \"Allier Bourbonnais\" is bijzonder goed gevuld."
    ],
    "es": [
      "Desde hace 30 años, Sophie y Denis Neytard, Sumilleres Cavistes, ofrecen una amplia selección de vinos, licores, delicatessen, accesorios...\r\nLa sección \"Allier Bourbonnais\" está especialmente bien surtida."
    ]
  },
