  "rdfs:comment": {
    "de": [
      "Das Spa by PHYTOMER hält die Wohltaten seiner Einrichtungen, Produkte und Behandlungen für Sie bereit, wo Wohlbefinden und Entspannung zur Lebenskunst erhoben werden. Warten Sie nicht länger, um sich im Hotel L'Hélios verwöhnen zu lassen."
    ],
    "en": [
      "The Spa by PHYTOMER offers you the benefits of its equipment, products and treatments, where well-being and relaxation are the art of living. Don't wait any longer to pamper yourself at Hôtel L'Hélios."
    ],
    "it": [
      "La Spa di PHYTOMER vi offre i benefici delle sue attrezzature, dei suoi prodotti e dei suoi trattamenti, dove il benessere e il relax sono l'arte di vivere. Non aspettate oltre per coccolarvi all'Hôtel L'Hélios."
    ],
    "fr": [
      "Le Spa by PHYTOMER vous réserve les bienfaits de ses équipements, produits et soins, où le bien-être et la détente y sont érigés en art de vivre. N'attendez plus pour prendre soin de vous à l'Hôtel L'Hélios."
    ],
    "es": [
      "El Spa by PHYTOMER le ofrece los beneficios de sus equipos, productos y tratamientos, donde el bienestar y la relajación son el arte de vivir. No espere más para mimarse en el Hôtel L'Hélios."
    ],
    "nl": [
      "De Spa by PHYTOMER biedt je de voordelen van zijn uitrusting, producten en behandelingen, waar welzijn en ontspanning levenskunst zijn. Wacht niet langer om uzelf te verwennen in Hôtel L'Hélios."
    ]
  },
  "rdfs:label": {
    "en": [
      "Spa by PHYTOMER at Hôtel Hélios"
    ],
    "fr": [
      "Spa by PHYTOMER de l'Hôtel Hélios"
    ],
    "nl": [
      "Spa van PHYTOMER in hotel Hélios"
    ]
  },
