  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dc2d9a86-9679-3995-a430-17ac058c4d07",
      "dc:description": {
        "de": [
          "Le Canard Gourmand ist eine unumgängliche Adresse für Feinschmecker, die in Auchy-le-Château zu Besuch sind. Das im Herzen des Artois gelegene Restaurant lädt Sie dazu ein, eine raffinierte Küche zu entdecken, in der die Ente König ist, aber nicht nur."
        ],
        "en": [
          "Le Canard Gourmand is a must for gourmets visiting Auchy-le-Château. Located in the heart of the Artois region, this restaurant invites you to discover a refined cuisine, where duck is king, but not only."
        ],
        "it": [
          "Le Canard Gourmand è un must per i buongustai che visitano Auchy-le-Château. Situato nel cuore della regione dell'Artois, questo ristorante vi invita a scoprire una cucina raffinata, dove l'anatra è il re, ma non solo."
        ],
        "fr": [
          "Le Canard Gourmand est une adresse incontournable pour les gourmets de passage à Auchy-le-Château. Situé au cœur de l'Artois, ce restaurant vous invite à découvrir une cuisine raffinée, où le canard est roi, mais pas seulement."
        ],
        "nl": [
          "Le Canard Gourmand is een must voor fijnproevers die Auchy-le-Château bezoeken. Dit restaurant ligt in het hart van de Artois-streek en nodigt u uit om een verfijnde keuken te ontdekken, waar eend koning is, maar dat niet alleen."
        ],
        "es": [
          "Le Canard Gourmand es una visita obligada para los gourmets que visitan Auchy-le-Château. Situado en el corazón de la región de Artois, este restaurante le invita a descubrir una cocina refinada, donde el pato es el rey, pero no sólo eso."
        ]
      },
