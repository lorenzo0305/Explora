  "rdfs:comment": {
    "de": [
      "Seit über zwanzig Jahren zeichnet sich Electro Deluxe durch einen einzigartigen und originellen Sound aus, einen übervitaminierten Cocktail aus Soul und Funk mit einem hohen Wiedererkennungswert."
    ],
    "en": [
      "For over twenty years, Electro Deluxe has distinguished itself with a unique, original sound, a super-vitamin cocktail of soul and funk with a distinctive character."
    ],
    "it": [
      "Da oltre vent'anni gli Electro Deluxe costruiscono un sound unico e originale, un cocktail sovralimentato di soul e funk con un carattere distintivo."
    ],
    "fr": [
      "Depuis plus de vingt ans Electro Deluxe se distingue par un son unique et original, un cocktail sur-vitaminé de Soul et de Funk, au caractère reconnaissable entre tous."
    ],
    "es": [
      "Durante más de veinte años Electro Deluxe han estado construyendo un sonido único y original, un cóctel sobrealimentado de soul y funk con un carácter distintivo."
    ],
    "nl": [
      "Al meer dan twintig jaar bouwt Electro Deluxe aan een uniek en origineel geluid, een supercharged cocktail van soul en funk met een onderscheidend karakter."
    ]
  },
