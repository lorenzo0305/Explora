  "rdfs:comment": {
    "de": [
      "Willkommen in L'Ile d'Oz, einem wahren Stück Paradies auf über 2000 m Höhe im Herzen des Skigebiets Oz 3300. Stellen Sie sich vor, Sie schweben über den Wolken, umgeben von den majestätischen Bergen, in einer malerischen und komfortablen Umgebung."
    ],
    "en": [
      "Welcome to L'Ile d'Oz, a true piece of paradise perched at an altitude of over 2000 meters, in the heart of the Oz 3300 resort. Picture yourself above the clouds, surrounded by the majesty of the mountains, in a setting as picturesque as it is comfortable"
    ],
    "it": [
      "Benvenuti a L'Ile d'Oz, un vero e proprio angolo di paradiso arroccato a oltre 2000 metri di altitudine, nel cuore del resort Oz 3300. Immaginatevi in alto sopra le nuvole, circondati dalla maestosità delle montagne, in un ambiente tanto pittoresco quanto confortevole."
    ],
    "fr": [
      "Bienvenue à L'Ile d'Oz, un véritable coin de paradis perché à plus de 2000 mètres d'altitude, au cœur de la station Oz 3300. Imaginez-vous au-dessus des nuages, entouré par la majesté des montagnes, dans un cadre aussi pittoresque que confortable."
    ],
    "nl": [
      "Welkom op L'Ile d'Oz, een waar stukje paradijs hoog boven de 2000 meter, in het hart van het Oz 3300-resort. Stel je voor dat je boven de wolken bent, omringd door de majesteit van de bergen, in een omgeving zo schilderachtig als comfortabel."
    ],
    "es": [
      "Bienvenido a L'Ile d'Oz, un auténtico paraíso situado a más de 2.000 metros de altitud, en el corazón de la estación Oz 3300. Imagínese por encima de las nubes, rodeado de la majestuosidad de las montañas, en un entorno tan pintoresco como confortable."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant L'Île d'Oz"
    ],
    "fr": [
      "Restaurant L'Île d'Oz"
    ],
    "nl": [
      "Restaurant L'Île d'Oz"
    ]
  },
