  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Früchte unserer Obstgärten, die im Tal der Ouvèze angebaut werden. Unsere frischen Produkte: Kirschen, Aprikosen, Pflaumen, Oliven. Aber auch eine Reihe von verarbeiteten Produkten: Olivenöl, Nektar und Konfitüren."
    ],
    "en": [
      "Come and discover the fruits of our orchards produced in the Ouvèze Valley. Our fresh produce: cherries, apricots, plums, olives. But also a range of processed products: olive oil, nectars and jams."
    ],
    "it": [
      "Venite a scoprire i frutti dei nostri frutteti prodotti nella Valle dell'Ouvèze. I nostri prodotti freschi: ciliegie, albicocche, prugne, olive. Ma anche una serie di prodotti trasformati: olio d'oliva, nettari e marmellate."
    ],
    "fr": [
      "Venez découvrir les fruits de nos vergers produits dans la Vallée de l'Ouvèze. Nos produits frais : cerises, abricots, prunes, olives. Mais aussi une gamme de produits transformés : huile d'olive, nectars et confitures."
    ],
    "es": [
      "Venga a descubrir los frutos de nuestros huertos producidos en el Valle de Ouvèze. Nuestros productos frescos: cerezas, albaricoques, ciruelas, aceitunas. Pero también una gama de productos transformados: aceite de oliva, néctares y mermeladas."
    ],
    "nl": [
      "Kom en ontdek het fruit van onze boomgaarden in de Ouvèze-vallei. Onze verse producten: kersen, abrikozen, pruimen, olijven. Maar ook een reeks verwerkte producten: olijfolie, nectar en jam."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme d'Autamne"
    ]
  },
