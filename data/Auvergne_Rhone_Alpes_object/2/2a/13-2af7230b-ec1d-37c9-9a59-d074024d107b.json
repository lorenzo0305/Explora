  "rdfs:comment": {
    "de": [
      "Das Bota fogo ist das Restaurant, das Ihnen hausgemachte und qualitativ hochwertige Gerichte mit guten lokalen Produkten anbietet... Die Gerichte sind reichhaltig und wunderschön angerichtet. Sie werden es nicht bereuen, durch die Türen dieses sehr gut gelegenen Restaurants gegangen zu sein."
    ],
    "en": [
      "Le Bota fogo is the restaurant that offers home-cooked, quality dishes made with local produce. The dishes are hearty and beautifully presented, and you won't regret passing through the doors of this well-located restaurant."
    ],
    "it": [
      "Bota fogo è il ristorante che offre piatti fatti in casa e di qualità con buoni prodotti locali. I piatti sono abbondanti e splendidamente presentati, non vi pentirete di aver varcato le porte di questo ristorante molto ben posizionato."
    ],
    "fr": [
      "Le Bota fogo c'est le restaurant qui vous propose des plats maison et de qualité avec de bon produits locaux.. Les plats sont copieux et magnifiquement présentés, vous ne regretterez pas d'avoir passé les portes de ce restaurant très bien situé."
    ],
    "nl": [
      "Le Bota fogo is het restaurant dat huisgemaakte kwaliteitsgerechten serveert, gemaakt van goede lokale producten. De gerechten zijn hartig en mooi gepresenteerd, dus je zult er geen spijt van krijgen dat je naar dit zeer goed gelegen restaurant bent gegaan."
    ],
    "es": [
      "Bota fogo es el restaurante que te ofrece platos caseros y de calidad con buenos productos locales. Los platos son copiosos y bellamente presentados, no se arrepentirá de haber pasado por las puertas de este restaurante muy bien situado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Bota Fogo"
    ]
  },
