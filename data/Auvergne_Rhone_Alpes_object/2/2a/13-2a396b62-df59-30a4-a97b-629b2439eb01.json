  "rdfs:comment": {
    "de": [
      "Chez la Jo ist ein Ort, an dem man sich wohlfühlt, sowohl durch die Umgebung als auch durch die Momente, die man dort bei einem Gericht oder einer Süßigkeit teilt."
    ],
    "en": [
      "Chez la Jo is a place to feel good, as much for its setting as for the moments shared over a dish or a sweet treat."
    ],
    "it": [
      "Chez la Jo è un luogo in cui sentirsi bene, sia per l'ambiente che per i momenti condivisi durante un pasto o un dolce."
    ],
    "fr": [
      "Chez la Jo, c'est un lieu pour se sentir bien, autant par son cadre, que par les moments qu'on y partage autour d'un plat ou d'une douceur."
    ],
    "nl": [
      "Chez la Jo is een plek om je goed te voelen, zowel voor de omgeving als voor de momenten die je deelt tijdens een maaltijd of een zoete traktatie."
    ],
    "es": [
      "Chez la Jo es un lugar para sentirse bien, tanto por su entorno como por los momentos compartidos en torno a una comida o un dulce."
    ]
  },
