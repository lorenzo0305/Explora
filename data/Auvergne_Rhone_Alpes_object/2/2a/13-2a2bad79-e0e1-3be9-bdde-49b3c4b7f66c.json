  "rdfs:comment": {
    "de": [
      "Ein bäuerlicher, lokaler und geselliger Lebensmittelladen, in dem sich ein Vereinscafé befindet: Das ergibt einen Ort, der reich an Begegnungen und Austausch ist und Verbindungen in unserem Dorf Bésayes schafft."
    ],
    "en": [
      "A friendly, local, local grocery store and a café for local associations: the result is a place rich in encounters and exchanges that creates links in our village of Bésayes."
    ],
    "it": [
      "Un negozio di alimentari locale e accogliente con un caffè comunitario: è un luogo ideale per incontrare persone, scambiare idee e creare legami nel nostro villaggio di Bésayes."
    ],
    "fr": [
      "Une épicerie paysanne, locale et conviviale dans laquelle se trouve un café associatif : cela donne un lieu riche en rencontres, en échanges et qui crée des liens dans notre village de Bésayes."
    ],
    "es": [
      "Una tienda de comestibles local y acogedora con un café comunitario: es un lugar estupendo para conocer gente, intercambiar ideas y crear vínculos en nuestro pueblo de Bésayes."
    ],
    "nl": [
      "Een plaatselijke, gezellige kruidenierswinkel met een buurtcafé: een geweldige plek om mensen te ontmoeten, ideeën uit te wisselen en banden te smeden in ons dorp Bésayes."
    ]
  },
