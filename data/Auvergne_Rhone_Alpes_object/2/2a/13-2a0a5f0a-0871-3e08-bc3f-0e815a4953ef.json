  "rdfs:comment": {
    "de": [
      "Audacius wurde 1996 gegründet, um qualitativ hochwertige Skikurse in kleinen Gruppen mit dreisprachigen Skilehrern anzubieten, und ist seit jeher bestrebt, das Beste zu bieten."
    ],
    "en": [
      "With the creation of Audacius in 1996, our wish was to create a different method with small groups and instructors who speak multiple languages to guarantee the quality of all ski lessons."
    ],
    "it": [
      "Creata nel 1996 per proporre lezioni di sci di qualità in piccoli gruppi con istruttori trilingue, Audacius è animata da sempre dal desiderio di offrire il meglio."
    ],
    "fr": [
      "Créé en 1996 pour proposer des cours de ski de qualité en petit groupe avec des moniteurs trilingues, Audacius c’est depuis toujours le désir d’offrir le meilleur."
    ],
    "es": [
      "Creada en 1996 para ofrecer cursos de esquí de calidad en grupos pequeños con monitores trilingües, Audacius siempre ha deseado ofrecer lo mejor."
    ],
    "nl": [
      "Audacius werd in 1996 opgericht om uitstekende skilessen aan kleine groepen onder leiding van drietalige skileraars te verzorgen en zet zich in om het beste te bieden."
    ]
  },
