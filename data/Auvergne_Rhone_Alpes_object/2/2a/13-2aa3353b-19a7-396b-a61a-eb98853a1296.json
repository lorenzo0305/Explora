  "rdfs:comment": {
    "de": [
      "Zwischen Rhône-Tal und Galaure führt Sie diese lange Wanderung über die Hochebenen und begeistert Sie mit ihren herrlichen Panoramen auf die Rhône, die Ardèche und den Vercors. Zu finden auf unserer App  \"MHIKES\"."
    ],
    "en": [
      "Between the Rhône Valley and Galaure, this long hike will take you over the plateaus and delight you with its magnificent panoramas over the Rhône, the Ardèche and the Vercors. To be found on  \"MHIKES\" application."
    ],
    "it": [
      "Tra la Valle del Rodano e Galaure, questa lunga escursione vi porterà sugli altopiani e vi incanterà con i suoi magnifici panorami sul Rodano, l'Ardèche e il Vercors. Da trovare sull'applicazione \"MHIKES\"."
    ],
    "fr": [
      "Entre Vallée du Rhône et Galaure, cette longue randonnée vous emmènera sur les plateaux et vous ravira par ses ses magnifiques panoramas sur le Rhône, l’Ardèche et le Vercors. A retrouver sur l'application \"MHIKES\"."
    ],
    "nl": [
      "Tussen de Rhônevallei en Galaure brengt deze lange wandeling je over de hoogvlakten en verruk je met zijn prachtige panorama's over de Rhône, Ardèche en Vercors. Bekijk onze  \"MHIKES\" app."
    ],
    "es": [
      "Entre el valle del Ródano y Galaure, esta larga excursión le llevará por las mesetas y le deleitará con sus magníficos panoramas sobre el Ródano, Ardèche y Vercors. En la aplicación \"MHIKES\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les hauts du Rhône"
    ]
  },
