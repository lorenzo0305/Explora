  "rdfs:comment": {
    "de": [
      "Familiengeführtes Restaurant am Ufer der Saône. Terrasse am Ufer der Saône, privater Bootsanleger. Spezialitäten: Frösche, Friture, Pochouse, Zander, Huhn in Sahnesauce... Privater Hafen."
    ],
    "en": [
      "Family restaurant on the banks of Saône. Terrace on the banks of Saône, private pontoon. Specialities : frogs, fried fish, pochouse, zander, chicken in creamy sauce..."
    ],
    "it": [
      "Ristorante familiare sulle rive della Saona. Terrazza sulle rive della Saona, pontile privato. Specialità: rane, pesce fritto, pochouse, luccioperca, pollo in salsa di panna, ecc. Porto privato."
    ],
    "fr": [
      "Restaurant familial en bordure de Saône. Terrasse en bord de Saône, ponton privé. Spécialités : grenouilles, friture, pochouse, sandre, poulet à la crème... Port privé."
    ],
    "es": [
      "Restaurante familiar a orillas del Saona. Terraza a orillas del Saona, pontón privado. Especialidades: ranas, pescado frito, pochouse, lucioperca, pollo a la crema, etc. Puerto privado."
    ],
    "nl": [
      "Familierestaurant aan de oevers van de Saône. Terras aan de oever van de Saône, privé ponton. Specialiteiten: kikkers, gebakken vis, pochouse, snoekbaars, kip in roomsaus, enz. Privé haven."
    ]
  },
