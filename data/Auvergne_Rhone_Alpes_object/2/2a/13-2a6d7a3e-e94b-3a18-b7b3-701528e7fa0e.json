  "rdfs:comment": {
    "de": [
      "Keramiker, die mit Steingut arbeiten und handgefertigte Gebrauchs- und Ziertöpferwaren herstellen.\r\nAuch Porzellan, das mit chromolithografischen Motiven verziert ist, wird verarbeitet."
    ],
    "en": [
      "Ceramists working in stoneware and producing artisanal, utilitarian and decorative pottery.\r\nWe also work with porcelain to create a range of jewelry, adorned with chromolithographed motifs."
    ],
    "it": [
      "Ceramisti che lavorano in gres e producono ceramiche artigianali, utilitarie e decorative.\r\nLavorano anche in porcellana, con una gamma di gioielli con motivi cromolitografici."
    ],
    "fr": [
      "Céramistes travaillant le grès et fabriquant de la poterie artisanale, utilitaire et décorative.\r\nTravail également de la porcelaine déclinée à travers une gamme de bijoux, ornée de motifs chromolithographiés."
    ],
    "nl": [
      "Keramisten die in steengoed werken en handgemaakt, gebruiks- en decoratief aardewerk produceren.\r\nZe werken ook in porselein, met een reeks sieraden met chromolithografisch motief."
    ],
    "es": [
      "Ceramistas que trabajan el gres y producen cerámica artesanal, utilitaria y decorativa.\r\nTambién trabajan la porcelana, con una gama de joyas con motivos cromolitografiados."
    ]
  },
  "rdfs:label": {
