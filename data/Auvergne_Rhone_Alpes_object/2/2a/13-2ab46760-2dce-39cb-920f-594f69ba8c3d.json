  "rdfs:comment": {
    "de": [
      "Außergewöhnliche Umgebung rund um den 18-Loch-Platz, der zu den besten Plätzen Frankreichs zählt, Restaurant, Seminare, 3-Sterne-Hotel vor Ort mit Pool, Golfpass für 6 Plätze, Aufenthalt im Golfhotel-Paket."
    ],
    "en": [
      "In a wonderful Lakeland setting and sheltered by the Vercors and Chartreuse mountains, An ideal backdrop for renowned architect Jeremy Pern who has created a challenging test of golf, yet in perfect harmony with its natural environment."
    ],
    "it": [
      "Ambiente eccezionale intorno a questo campo a 18 buche classificato tra i migliori di Francia, ristorante, seminari, hotel 3 stelle in loco con piscina, pass per 6 percorsi, pacchetto golf hotel."
    ],
    "fr": [
      "Environnement exceptionnel autour de ce parcours 18 trous classé parmi les meilleurs parcours de France, restaurant, séminaires, hôtel 3 étoiles sur place avec piscine, golf pass 6 parcours, séjour en forfait golf hôtel."
    ],
    "nl": [
      "Uitzonderlijke omgeving rond deze 18-holes baan die tot de beste van Frankrijk behoort, restaurant, seminars, 3-sterrenhotel ter plaatse met zwembad, 6-gangen golfpas, golfhotelarrangement."
    ],
    "es": [
      "Entorno excepcional en torno a este campo de 18 hoyos clasificado entre los mejores de Francia, restaurante, seminarios, hotel de 3 estrellas in situ con piscina, pase de golf de 6 recorridos, paquete de hotel de golf."
    ]
  },
