  "rdfs:comment": {
    "de": [
      "Unter den Bäumen hinter dem Rathaus befindet sich der Parc Grangeon mit einem Spielplatz für die Allerkleinsten, Bouleplätzen, einer Wasserstelle, einem Picknicktisch, Abfallbehältern und einem großen Parkplatz."
    ],
    "en": [
      "Under the trees behind the town hall, Grangeon Park features a playground for the very young, petanque courts, a watering hole, a picnic table, litter garbage cans and ample parking."
    ],
    "it": [
      "Sotto gli alberi dietro il municipio, Grangeon Park dispone di un'area giochi per i più piccoli, campi da bocce, un abbeveratoio, un tavolo da picnic, cestini per i rifiuti e un ampio parcheggio."
    ],
    "fr": [
      "Sous les arbres, derrière l’hôtel de ville, le parc Grangeon est équipé d’une aire de jeux pour les tous petits, de terrains de pétanque, d'un point d’eau, d'une table de pique-nique, de poubelles et d’un grand parking."
    ],
    "nl": [
      "Onder de bomen achter het stadhuis heeft Grangeon Park een speeltuin voor de allerkleinsten, petanquebanen, een waterpoel, een picknicktafel, afvalbakken en een grote parkeerplaats."
    ],
    "es": [
      "Bajo los árboles situados detrás del ayuntamiento, el parque Grangeon cuenta con una zona de juegos para los más pequeños, pistas de petanca, un abrevadero, una mesa de picnic, papeleras y un amplio aparcamiento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc Grangeon"
    ]
  },
