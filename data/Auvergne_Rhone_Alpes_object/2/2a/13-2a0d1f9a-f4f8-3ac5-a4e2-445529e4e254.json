  "rdfs:comment": {
    "de": [
      "Saint François Longchamp lädt Sie ein, mit Ihrer Familie einen Moment in einer seiner 3 Bibliotheken / Mediatheken zu verbringen! Bücher, DVDs, Gesellschaftsspiele ... zur Selbstbedienung vor Ort."
    ],
    "en": [
      "Saint François Longchamp invites you to come and spend some time with your family in one of its 3 libraries! Books, board games, DVD... in self-service on site."
    ],
    "it": [
      "Saint François Longchamp vi invita a trascorrere del tempo in famiglia in una delle sue 3 biblioteche! Libri, DVD, giochi da tavolo... disponibili per il self-service in loco."
    ],
    "fr": [
      "Saint François Longchamp vous invite à venir passer un moment en famille dans l'une de ses 3 bibliothèques / Médiathèques ! Livres, DVD, jeux de société ... en libre-service sur place."
    ],
    "nl": [
      "Saint François Longchamp nodigt je uit om wat tijd met het gezin door te brengen in een van zijn 3 bibliotheken! Boeken, dvd's, gezelschapsspellen... beschikbaar voor zelfbediening ter plaatse."
    ],
    "es": [
      "Saint François Longchamp le invita a pasar un rato en familia en una de sus 3 bibliotecas Libros, DVD, juegos de mesa... disponibles en autoservicio in situ."
    ]
  },
