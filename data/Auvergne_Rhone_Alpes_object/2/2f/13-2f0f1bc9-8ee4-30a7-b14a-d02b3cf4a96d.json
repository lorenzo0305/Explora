  "rdfs:comment": {
    "de": [
      "Chalet-Hotel am Fuße des Puy de Sancy und der Pisten, 5 Minuten von Mont-Dore entfernt. Komfortable Zimmer mit Balkon, Entspannungsbereich (Schwimmbad, Sauna, Hammam), Massagen.\r\nRestaurant La Table de l'Ours, regionale Küche. Ideal für Ferien, Liebesaufenthalte..."
    ],
    "en": [
      "After the violent fire of November 2022, the work is completed, the reception areas, bar and restaurant have been redesigned and the rooms renovated.  We are happy to welcome you again to the Le Puy Ferrand hotel."
    ],
    "it": [
      "Chalet hotel ai piedi del Puy de Sancy e delle piste, a 5 minuti da Le Mont-Dore. Camere confortevoli con balcone, area relax (piscina, sauna, hammam), massaggi.\r\nRistorante La Table de l'Ours, cucina locale. Ideale per vacanze, soggiorni romantici..."
    ],
    "fr": [
      "Hôtel chalet au pied du Puy de Sancy et des pistes, à 5 min du Mont-Dore. Chambres confortables avec balcon, espace détente (piscine, sauna, hammam), massages.\r\nRestaurant La Table de l'Ours, cuisine de terroir. Idéal pour vacances, séjours amoureux..."
    ],
    "nl": [
      "Chalethotel aan de voet van Puy de Sancy en de pistes, op 5 minuten van Le Mont-Dore. Comfortabele kamers met balkon, ontspanningsruimte (zwembad, sauna, hammam), massages.\r\nRestaurant La Table de l'Ours, lokale keuken. Ideaal voor vakanties, romantische verblijven..."
    ],
    "es": [
      "Chalet hotel a los pies del Puy de Sancy y de las pistas, a 5 minutos de Le Mont-Dore. Habitaciones confortables con balcón, zona de relajación (piscina, sauna, hammam), masajes.\r\nRestaurante La Table de l'Ours, cocina local. Ideal para vacaciones, escapadas románticas..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Chalet Le Puy Ferrand"
    ]
