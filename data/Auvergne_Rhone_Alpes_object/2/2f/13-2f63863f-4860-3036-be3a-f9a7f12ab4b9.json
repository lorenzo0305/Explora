  "rdfs:comment": {
    "de": [
      "Schnellrestaurants am Fuße der Pisten!\r\nBar mit Atmosphäre \r\nSportübertragungen."
    ],
    "en": [
      "Cold beers, gourmet kebabs and disco hits at the foot of the ski slopes in a 70s style restaurant with a festive and friendly atmosphere.\r\nFast food and platters to share served from midday to 10pm. \r\nFestive bar."
    ],
    "it": [
      "Birre fresche, kebab gourmet e suoni da discoteca ai piedi delle piste in un ristorante anni '70 dall'atmosfera festosa e amichevole.\r\nFast food e cibo da condividere, servizio continuo dalle 12 alle 22 sul posto o da asporto.\r\nBar festivo."
    ],
    "fr": [
      "Bières fraîches, kebabs gourmands et sonorités disco au pied des pistes dans un restaurant 70s à l'ambiance festive et conviviale.\r\nRestauration rapide et à partager, en service continu 12h-22h sur place ou à emporter. \r\nBar festif."
    ],
    "nl": [
      "Verse bieren, kebab voor fijnproevers en discogeluiden aan de voet van de pistes in een restaurant uit de jaren 70 met een feestelijke, vriendelijke sfeer.\nFast food en eten om te delen, doorlopende service 12-10 uur ter plaatse of om mee te nemen.\nFeestelijke bar."
    ],
    "es": [
      "Cervezas frescas, kebabs gourmet y sonidos de discoteca a pie de pistas en un restaurante de los años 70 con un ambiente festivo y acogedor.\r\nComida rápida y para compartir, servicio continuo de 12 a 22 h in situ o para llevar.\r\nBar festivo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Weiße Soße Disco Club"
    ],
