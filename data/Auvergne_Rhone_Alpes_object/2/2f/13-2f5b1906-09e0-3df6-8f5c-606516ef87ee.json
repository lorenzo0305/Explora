  "rdfs:comment": {
    "de": [
      "Während der Februarferien organisiert das Fremdenverkehrsamt eine ganz neue Schnitzeljagd. Die Gelegenheit für Familien, die Stadt Sallanches zu entdecken und gemeinsam zu spielen."
    ],
    "en": [
      "During the February vacations, the tourist office is organizing a brand new treasure hunt. An opportunity for families to discover the town of Sallanches and play together."
    ],
    "it": [
      "Durante le vacanze di febbraio, l'Ufficio del Turismo organizza una nuovissima caccia al tesoro. Un'occasione per le famiglie di scoprire la città di Sallanches e giocare insieme."
    ],
    "fr": [
      "Pendant les vacances de février, l’office de tourisme organise un tout nouveau jeu de piste. L’occasion pour les familles de venir découvrir la ville de Sallanches et de jouer ensemble."
    ],
    "nl": [
      "Tijdens de februarivakantie organiseert het Office du Tourisme een gloednieuwe schattenjacht. Het is een gelegenheid voor gezinnen om de stad Sallanches te ontdekken en samen te spelen."
    ],
    "es": [
      "Durante las vacaciones de febrero, la Oficina de Turismo organiza una nueva búsqueda del tesoro. Es una oportunidad para que las familias descubran la ciudad de Sallanches y jueguen juntas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeu de piste des vacances de février"
    ]
  },
