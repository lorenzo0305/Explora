  "rdfs:comment": {
    "de": [
      "Im Herzen der galo-römischen Stadt Vienne entdecken Sie Le Coin du Bœuf, einen echten Fleischspezialisten. Ein Steakhaus, eine Brasserie und ein Café mit moderner und freundlicher Atmosphäre. Täglich von 10:00 bis 1:00 Uhr geöffnet (Sonntag: 9:00 bis 23:00 Uhr)."
    ],
    "en": [
      "In the heart of the Gallo-Roman city of Vienna, come and discover Le Coin du Bœuf, a real meat specialist. A steak house, brasserie-café with a modern and friendly atmosphere. Open every day from 10am to 1am (Sunday: from 9am to 11pm)."
    ],
    "it": [
      "Nel cuore della città romano-gallica di Vienna, venite a scoprire Le Coin du B?uf, un vero specialista della carne. Una steak house, brasserie e caffetteria dall'atmosfera moderna e accogliente. Aperto tutti i giorni dalle 10.00 all'1.00 (domenica: dalle 9.00 alle 23.00)."
    ],
    "fr": [
      "Au cœur de la ville galo-romaine de Vienne, venez découvrir Le Coin du Bœuf, véritable spécialiste de la viande. Un steak house, brasserie café à l'ambiance moderne et conviviale. Ouvert tous les jours de 10h à 1h (dimanche : de 9h à 23h)."
    ],
    "nl": [
      "Kom in het hart van de Galicisch-Romeinse stad Wenen Le Coin du Bœuf ontdekken, een echte vleesspecialist. Een steakhouse, brasserie en café met een moderne en vriendelijke sfeer. Dagelijks geopend van 10 tot 1 uur (zondag: 9 tot 11 uur)."
    ],
    "es": [
      "En el corazón de la ciudad romano-gala de Viena, venga a descubrir Le Coin du Bœuf, un auténtico especialista en carne. Un asador, brasserie y café con un ambiente moderno y acogedor. Abierto todos los días de 10 a 1 de la mañana (domingo: de 9 a 11 de la noche)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Coin du Boeuf"
    ]
  },
