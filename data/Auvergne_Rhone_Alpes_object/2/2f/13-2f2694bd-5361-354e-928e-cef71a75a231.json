  "rdfs:comment": {
    "de": [
      "Die Université pour tous bietet um 14:30 Uhr im Kulturzentrum Langeac einen Vortrag über \"Philippe et Dominique KAEPPELIN, tel père, tel fils\" von Anne MULLER, Historikerin und Referentin des Vereins \"L'art et la manière\", an."
    ],
    "en": [
      "Université pour tous offers a lecture on \"Philippe et Dominique KAEPPELIN, tel père, tel fils\" (Philippe and Dominique KAEPPELIN, like father, like son) by Anne MULLER, historian and lecturer from the association \"L?art et la manière\" at the Centre Culturel de Langeac at 2:30pm."
    ],
    "it": [
      "L'Université pour tous propone una conferenza su \"Philippe et Dominique KAEPPELIN, tel père, tel fils\" (Philippe e Dominique KAEPPELIN, tale padre tale figlio) tenuta da Anne MULLER, storica e docente dell'associazione \"L'art et la manière\", presso il Centro culturale di Langeac alle 14.30."
    ],
    "fr": [
      "Université pour tous propose une conférence sur« Philippe et Dominique KAEPPELIN, tel père, tel fils » par Anne MULLER, historienne conférencière de l’association « L’art et la manière » au Centre Culturel de Langeac à 14h30."
    ],
    "nl": [
      "Université pour tous biedt een lezing aan over \"Philippe et Dominique KAEPPELIN, tel père, tel fils\" (Philippe en Dominique KAEPPELIN, zo vader, zo zoon) door Anne MULLER, historica en docente van de vereniging \"L?art et la manière\" in het Cultureel Centrum Langeac om 14u30."
    ],
    "es": [
      "La Université pour tous propone una conferencia sobre \"Philippe et Dominique KAEPPELIN, tel père, tel fils\" (Philippe y Dominique KAEPPELIN, de tal padre, tal hijo) a cargo de Anne MULLER, historiadora y conferenciante de la asociación \"L'art et la manière\" en el Centro Cultural de Langeac a las 14.30 h."
    ]
  },
