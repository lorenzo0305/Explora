  "rdfs:comment": {
    "de": [
      "Das Restaurant liegt im Skigebiet Courchevel 1650 an der Ankunft der Gondelbahn und kann zu Fuß oder auf Skiern erreicht werden. Das gesamte Team freut sich, Sie auf der Südterrasse oder im Speisesaal mit großen Glasfenstern begrüßen zu dürfen"
    ],
    "en": [
      "Located in the Courchevel 1650 ski area at the arrival of the gondola lift, the restaurant can be reached on foot or on skis. The whole team will be delighted to welcome you on the south-facing terrace or in the dining room with its large picture windows."
    ],
    "it": [
      "Situato nel comprensorio sciistico di Courchevel 1650, all'arrivo della funivia, il ristorante è raggiungibile a piedi o con gli sci. L'intero team sarà lieto di accogliervi sulla terrazza esposta a sud o nella sala ristorante con le sue ampie vetrate"
    ],
    "fr": [
      "Situé sur le domaine skiable de Courchevel 1650 à l'arrivée de la télécabine, on peut rejoindre le restaurant à pied ou à ski. Toute l'équipe sera heureuse de vous accueillir sur la terrasse plein sud ou dans la salle de restaurant aux grandes baies vitré"
    ],
    "es": [
      "Situado en el dominio esquiable de Courchevel 1650, a la llegada del teleférico, se puede acceder al restaurante a pie o con esquís. Todo el equipo estará encantado de recibirle en la terraza orientada al sur o en la sala del restaurante con sus grandes ventanales"
    ],
    "nl": [
      "Het restaurant ligt in het skigebied van Courchevel 1650 bij de aankomst van de kabelbaan en kan te voet of op ski's worden bereikt. Het hele team verwelkomt je graag op het terras op het zuiden of in de restaurantzaal met grote ramen"
    ]
  },
