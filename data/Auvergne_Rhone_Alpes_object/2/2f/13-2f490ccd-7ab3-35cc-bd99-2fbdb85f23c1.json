  "rdfs:comment": {
    "de": [
      "Vor Ort oder zum Mitnehmen entdecken Sie unsere handwerklich hergestellten Burger, aber auch unsere Wraps, Salate, Schmorgerichte... Lieferung möglich."
    ],
    "en": [
      "On the spot or to take away, come and discover our homemade burgers, wraps, salads, stews... Delivery available."
    ],
    "it": [
      "Sul posto o da asporto, venite a scoprire i nostri hamburger fatti in casa e i nostri wraps, insalate, stufati... Possibilità di consegna."
    ],
    "fr": [
      "Sur place ou à emporter venez découvrir nos burger artisanaux mais aussi nos wraps, salades, plats mijotés... Livraison possible."
    ],
    "nl": [
      "Kom ter plekke of om mee te nemen onze huisgemaakte hamburgers ontdekken, evenals onze wraps, salades, stoofschotels... Levering mogelijk."
    ],
    "es": [
      "En el acto o para llevar, venga a descubrir nuestras hamburguesas caseras, así como nuestros wraps, ensaladas, guisos... Entrega a domicilio."
    ]
  },
