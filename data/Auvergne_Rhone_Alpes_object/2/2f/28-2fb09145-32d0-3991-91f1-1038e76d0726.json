  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/55c15c94-3f95-3461-a5db-90220bf26c84",
      "dc:description": {
        "de": [
          "Baumpark mit mehreren jahrhundertealten Baumarten: amerikanischer Fever, Zedern, Linden, Eschen, Eichen, Akazien.\n\nZahlreiche architektonische Elemente im Stil von Steingärten: Schlangenlinien, kleine Brücken, Pavillon, Grotten, Bänke usw."
        ],
        "en": [
          "The park is planted with several hundred-year-old species: honey locust, cedar, lime, ash, oak and acacia.\n\nNumerous architectural elements of the \"rock garden\" type: serpentine, small bridges, kiosk, caves, benches, etc."
        ],
        "it": [
          "Il parco è piantato con diverse specie centenarie: robinia, cedro, tiglio, frassino, quercia e acacia.\n\nNumerosi elementi architettonici del tipo \"giardino roccioso\": serpentine, ponticelli, chioschi, grotte, panchine, ecc."
        ],
        "fr": [
          "Parc arboré comprenant plusieurs espèces centenaires : féviers d’Amérique, cèdres, tilleuls, frênes, chênes, acacias.\n\nNombreux éléments architecturaux de type « rocailles » : serpentine, petits ponts, kiosque, grottes, bancs, etc."
        ],
        "nl": [
          "Het park is beplant met verschillende honderd jaar oude soorten: honingsprinkhaan, ceder, linde, es, eik en acacia.\n\nTalrijke architectonische elementen van het type \"rotstuin\": serpentine, bruggetjes, kiosk, grotten, banken, enz."
        ],
        "es": [
          "El parque está plantado con varias especies centenarias: algarrobo, cedro, tilo, fresno, roble y acacia.\n\nNumerosos elementos arquitectónicos de tipo \"jardín rocoso\": serpentina, pequeños puentes, quiosco, grutas, bancos, etc."
        ]
      },
      "@type": [
        "Description"
      ],
