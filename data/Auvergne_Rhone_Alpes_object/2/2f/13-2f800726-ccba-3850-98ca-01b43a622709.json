  "rdfs:comment": {
    "de": [
      "Machen Sie am Ufer des Sees von Montriond eine Schlemmerpause in der Auberge du Verdoyant: traditionelle Restauration, Landküche und savoyische Spezialitäten, die Sie auf der Speisekarte entdecken können. Große Terrasse mit einzigartigem Blick auf den See."
    ],
    "en": [
      "On the shores of Montriond Lake, take a moment to savour what's on offer at Auberge du Verdoyant: traditional cooking, locally inspired recipes and Savoyard specialities are just some of the dishes to try."
    ],
    "it": [
      "Sulle rive del lago di Montriond, concedetevi una pausa gourmet all'Auberge du Verdoyant: cibo tradizionale, cucina locale e specialità savoiarde da scoprire nel menu. Ampia terrazza con vista unica sul lago."
    ],
    "fr": [
      "Au bord du lac de Montriond, faites une pause gourmande à l'Auberge du Verdoyant : restauration traditionnelle, cuisine du pays et spécialités savoyardes à découvrir sur la carte. Grande terrasse avec une vue unique sur le lac."
    ],
    "nl": [
      "Aan de oevers van het meer van Montriond kunt u in de Auberge du Verdoyant genieten van een gastronomische pauze: traditionele gerechten, streekgerechten en Savoyaardse specialiteiten staan op het menu. Groot terras met een uniek uitzicht op het meer."
    ],
    "es": [
      "A orillas del lago de Montriond, haga una pausa gastronómica en el Auberge du Verdoyant: comida tradicional, cocina local y especialidades saboyanas para descubrir en el menú. Amplia terraza con una vista única del lago."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Auberge du Verdoyant"
    ],
    "fr": [
      "L'Auberge du Verdoyant"
    ]
  },
