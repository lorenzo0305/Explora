  "rdfs:comment": {
    "de": [
      "Der Pumptrack im Espace Nature et Loisirs du Collet ermöglicht mehrere Parcours mit unterschiedlichen Schwierigkeitsgraden.\r\nEr ist sowohl für Anfänger als auch für Experten geeignet und bietet die Möglichkeit, seine Tricks zu entdecken oder zu perfektionieren."
    ],
    "en": [
      "The pumptrack of the Espace Nature et Loisirs du Collet offers several courses at different levels.\r\nSuitable for beginners and experts alike, you can discover or perfect your tricks."
    ],
    "it": [
      "Il pumptrack dell'Espace Nature et Loisirs du Collet offre diversi corsi a vari livelli.\r\nAdatti sia ai principianti che ai più esperti, vi permetteranno di scoprire o perfezionare i vostri trucchi."
    ],
    "fr": [
      "Le pumptrack de l'Espace Nature et Loisirs du Collet permet plusieurs parcours de différents niveaux.\r\nAdapté aux débutants comme aux experts, il permet de découvrir ou de perfectionner ses figures."
    ],
    "es": [
      "El pumptrack del Espace Nature et Loisirs du Collet ofrece varios recorridos de diferentes niveles.\r\nAptos tanto para principiantes como para expertos, podrás descubrir o perfeccionar tus trucos."
    ],
    "nl": [
      "De pumptrack van het Espace Nature et Loisirs du Collet biedt verschillende parcours op verschillende niveaus.\r\nZowel beginners als gevorderden kunnen hier hun tricks ontdekken of perfectioneren."
    ]
  },
