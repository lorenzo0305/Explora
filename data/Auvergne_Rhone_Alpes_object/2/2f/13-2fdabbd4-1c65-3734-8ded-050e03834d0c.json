  "rdfs:comment": {
    "de": [
      "Céline und Laurent bieten Ihnen eine qualitativ hochwertige ambulante Verpflegung mit Produkten aus der Region.\r\nSie bevorzugen den Einkauf ihrer Produkte bei lokalen Erzeugern."
    ],
    "en": [
      "Céline and Laurent offer high-quality mobile catering made with local, regional products.\r\nThey prioritize sourcing their ingredients from local producers."
    ],
    "it": [
      "Céline e Laurent offrono un servizio di catering mobile di qualità con prodotti locali.\r\nPreferiscono rifornirsi di prodotti da produttori locali."
    ],
    "fr": [
      "Céline et Laurent vous propose une restauration ambulante de qualité avec des produits du terroir.\r\nIls privilégient l'approvisionnement de leur produits auprès des producteurs locaux."
    ],
    "es": [
      "Céline y Laurent ofrecen un servicio de catering móvil de calidad con productos locales.\r\nPrefieren abastecerse de productos de productores locales."
    ],
    "nl": [
      "Céline en Laurent bieden hoogwaardige mobiele catering met streekproducten.\r\nZij geven de voorkeur aan het inkopen van hun producten bij lokale producenten."
    ]
  },
