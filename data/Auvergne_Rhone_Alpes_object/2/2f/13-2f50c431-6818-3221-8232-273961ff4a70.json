  "rdfs:comment": {
    "de": [
      "Jean-Marc, AEM, bietet Wander- und Schneeschuhwanderungen an, um das Dévoluy, das Diois und das Vercors zu entdecken. Er hat seinen Sitz im klassifizierten Jarjatte-Tal und bietet Wandertouren und Sternwanderungen ab der komfortablen Gîte Valgabondage an."
    ],
    "en": [
      "Jean-Marc is a Mountain Guide who will take you on hikes and snowshoeing routes to discover le Dévoluy, Diois and Vercors. Based in the listed valley of la Jarjatte, he offers travelling trips and packaged holidays from the comfortable gîte of Valgabondage."
    ],
    "it": [
      "Jean-Marc, AMM, propone escursioni a piedi e con le racchette da neve per farvi scoprire le regioni del Dévoluy, del Diois e del Vercors a partire dalla valle Jarjatte, che è stata classificata, e organizza tour itineranti e soggiorni a stelle e strisce a partire dal confortevole gîte Valgabondage."
    ],
    "fr": [
      "Jean-Marc, AMM, propose de l’encadrement randonnée et raquettes pour découvrir le Dévoluy, le Diois et le Vercors au départ du vallon classé de la Jarjatte en itinérance et séjours en étoile à partir du confortable gîte Valgabondage."
    ],
    "nl": [
      "Jean-Marc, berggids, begeleidt wandel- en sneeuwschoentochten om de Dévoluy, de omgeving van Die en de Vercors te ontdekken. Vertrekpunt het beschermde dal van de Jarjatte: (rond)tochten vanaf het comfortabele vakantiehuis Valgabondage."
    ],
    "es": [
      "Jean-Marc, AMM, le propone excursiones a pie y con raquetas de nieve para descubrir las regiones de Dévoluy, Diois y Vercors desde el valle catalogado de Jarjatte. También organiza circuitos itinerantes y estancias con estrellas desde la confortable casa rural Valgabondage."
    ]
  },
