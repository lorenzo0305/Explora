  "rdfs:comment": {
    "de": [
      "Produzenten von Honig und Produkten auf Honigbasis.\r\nStéphane ist auf den Märkten von Le Puy-en-Velay am Samstagmorgen und in Coucouron (07) am Mittwochmorgen.\r\nVerkauf auf dem Bauernhof mittwochs von 14 bis 18 Uhr."
    ],
    "en": [
      "Producers of honeys and honey-based products.\r\nStéphane is on the market in Le Puy-en-Velay on Saturday mornings and in Coucouron (07) on Wednesday mornings.\r\nFarm sales on Wednesdays from 2pm to 6pm."
    ],
    "it": [
      "Produttori di mieli e prodotti a base di miele.\r\nStéphane è presente sul mercato a Le Puy-en-Velay il sabato mattina e a Coucouron (07) il mercoledì mattina.\r\nVendita in azienda il mercoledì dalle 14.00 alle 18.00."
    ],
    "fr": [
      "Producteurs de Miels et de produits à base de miels.\r\nStéphane est sur les marchés du Puy-en-Velay le samedi matin et à Coucouron (07) le mercredi matin. \r\nVente à la ferme le mercredi de 14h à 18h."
    ],
    "es": [
      "Productores de mieles y productos a base de miel.\r\nStéphane está en el mercado de Le Puy-en-Velay los sábados por la mañana y en Coucouron (07) los miércoles por la mañana.\r\nVenta en la granja los miércoles de 14.00 a 18.00 h."
    ],
    "nl": [
      "Producenten van honing en producten op basis van honing.\r\nStéphane staat op zaterdagochtend op de markt in Le Puy-en-Velay en op woensdagochtend in Coucouron (07).\r\nBoerderijverkoop op woensdag van 14.00 tot 18.00 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pays Stéphane | St Jean Lachalm"
    ]
  },
