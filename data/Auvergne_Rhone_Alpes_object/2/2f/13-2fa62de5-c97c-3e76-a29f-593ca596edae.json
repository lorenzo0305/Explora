    "de": [
      "Produzent von Ziegenkäse aus Picodon AOP Bio, Ziegenterrinen und Würsten aus ökologischem Landbau. Verkauf von lokalen Produkten: Honig, Walnussöl, Walnüsse und Linsen."
    ],
    "en": [
      "AOP labelled, organic Picodon goat cheese producer, organic goat meat pâtés and sausages. Local products sales : honey, walnut oil, walnuts and lentils."
    ],
    "it": [
      "Produttore di formaggio di capra biologico Picodon DOP, terrine di capra e salsicce. Vendita di prodotti locali: miele, olio di noce, noci e lenticchie."
    ],
    "fr": [
      "Producteur de fromages de chèvres de Picodon AOP Bio, terrines caprines et saucissons en agriculture biologique. Vente de produits locaux : miel, huile de noix, noix et lentilles."
    ],
    "es": [
      "Productor de queso de cabra ecológico con DOP, terrinas de cabra y embutidos. Venta de productos locales: miel, aceite de nuez, frutos secos y lentejas."
    ],
    "nl": [
      "Producent van AOP-geitenkaas, geitenterrines en worstjes. Verkoop lokale producten: honing, notenolie, noten en linzen."
