  "rdfs:comment": {
    "de": [
      "Das Hotel Edelweiss **** und sein Restaurant La Cordée bieten Ihnen eine Küche, die Bistronomie und Produkte aus Savoyen in einem schlichten Dekor vereint. Entdecken Sie die Signaturgerichte des Sternekochs Kunihisa Goto oder unser Abendmenü."
    ],
    "en": [
      "The Edelweiss **** hotel and its restaurant La Cordée offer you cuisine combining bistronomy and Savoy products in a refined decor. Discover the signature dishes of Star Chef Kunihisa Goto or our evening formula."
    ],
    "it": [
      "L'Hotel Edelweiss **** e il suo ristorante La Cordée offrono una cucina che combina la bistronomia e i prodotti della Savoia in un ambiente raffinato. Scoprite i piatti tipici dello chef stellato Kunihisa Goto o il nostro menu serale."
    ],
    "fr": [
      "L’hôtel Edelweiss **** et son restaurant La Cordée vous proposent une cuisine alliant Bistronomie et produits de Savoie dans un décor épuré. Découvrez les plats signatures du Chef Etoilé Kunihisa Goto ou notre formule du soir."
    ],
    "nl": [
      "Hotel Edelweiss **** en het restaurant La Cordée bieden een keuken die Bistronomie en producten uit de Savoie combineert in een verfijnde omgeving. Ontdek de signatuurgerechten van sterrenchef Kunihisa Goto of ons avondmenu."
    ],
    "es": [
      "El hotel Edelweiss **** y su restaurante La Cordée le ofrecen una cocina que combina bistronomía y productos de Saboya en una decoración refinada. Descubra los platos exclusivos del Star Chef Kunihisa Goto o nuestro menú de noche."
    ]
  },
