  "rdfs:comment": {
    "de": [
      "Le Chapka in Avoriaz ist Der Gourmet-Spot, der 7 Tage die Woche von 09:00 bis 00:00 Uhr geöffnet ist! Burger, leckere Gerichte und eine lebhafte Atmosphäre. Die unumgängliche Adresse für ein Getränk oder ein Essen in einer warmen und entspannten Atmosphäre, mitten im Herzen des Ortes."
    ],
    "en": [
      "Le Chapka, in Avoriaz, is the go-to food spot, open 7 days a week from 9:00 am to midnight. Burgers, tasty dishes and a lively atmosphere. A must-visit address to enjoy a drink or a meal in a warm and relaxed setting, right in the heart of the resort."
    ],
    "it": [
      "Le Chapka, ad Avoriaz, è il locale gourmet aperto 7 giorni su 7 dalle 09:00 alle 00:00! Hamburger, piatti gustosi e un'atmosfera vivace. Il posto giusto per un drink o un boccone in un'atmosfera calda e rilassata, proprio nel cuore della località."
    ],
    "fr": [
      "Le Chapka, à Avoriaz, est Le spot gourmand ouvert 7j/7 de 09h00 à 00h00 ! Burgers, plats savoureux et ambiance animée. L’adresse incontournable pour boire un verre ou manger dans une ambiance chaleureuse et décontractée, en plein cœur de la station."
    ],
    "es": [
      "Le Chapka, en Avoriaz, es el lugar gourmet abierto los 7 días de la semana de 09:00 a 00:00 Hamburguesas, platos sabrosos y un ambiente animado. El lugar ideal para tomar una copa o comer algo en un ambiente cálido y relajado, en pleno centro de la estación."
    ],
    "nl": [
      "Le Chapka in Avoriaz is dé culinaire hotspot, 7 dagen per week geopend van 09.00 tot 00.00 uur. Burgers, smaakvolle gerechten en een levendige sfeer. Het onmisbare adres om iets te drinken of te eten in een warme en ontspannen ambiance, midden in het hart van het skistation."
    ]
  },
