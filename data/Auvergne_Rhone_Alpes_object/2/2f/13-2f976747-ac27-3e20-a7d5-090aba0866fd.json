  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich in der Ortschaft Sauxillanges, einer Kluniazenserstätte, die durch ihr Kloster geprägt ist, dessen Überreste Sie im Maison du Patrimoine wiederfinden können. An das Restaurant angeschlossen: Café/Tabak und Brasserie."
    ],
    "en": [
      "The restaurant is located in the village of Sauxillanges, a Cluniac site marked by its monastery, the remains of which you will find in the heritage house. Adjacent to the restaurant: café/tabac and brasserie."
    ],
    "it": [
      "Il ristorante si trova nel villaggio di Sauxillanges, un sito cluniacense caratterizzato dal suo monastero, i cui resti si trovano nella casa del patrimonio. Adiacente al ristorante: caffè/tabacchi e brasserie."
    ],
    "fr": [
      "Le restaurant est situé dans le bourg de Sauxillanges, site clunisien marqué par son monastère dont vous retrouverez des vestiges à la maison du patrimoine. Attenant au restaurant : café/tabac et brasserie."
    ],
    "nl": [
      "Het restaurant is gelegen in het dorp Sauxillanges, een Cluniac site gemarkeerd door zijn klooster, waarvan u de overblijfselen vindt in het erfgoed huis. Aangrenzend aan het restaurant: café/tabac en brasserie."
    ],
    "es": [
      "El restaurante se encuentra en el pueblo de Sauxillanges, un lugar cluniacense marcado por su monasterio, cuyos restos se encuentran en la casa patrimonial. Junto al restaurante: cafetería/tabac y brasserie."
    ]
  },
