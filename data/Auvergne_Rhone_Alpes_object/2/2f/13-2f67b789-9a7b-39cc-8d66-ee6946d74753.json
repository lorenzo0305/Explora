  "rdfs:comment": {
    "de": [
      "Für Ihre Unterhaltung ! Sie finden hier zahlreiche Werke: Kinderbücher, Comics, Romane, Dokumentarfilme ...\r\nSie können maximal 3 Bücher für 3 Wochen (oder für die Dauer des Aufenthalts) leihen."
    ],
    "en": [
      "For your entertainment!  You will find all sorts of books here: children's books, cartoon strips, novels, documentaries...\r\nYou can borrow 3 books for 3 weeks (or for the duration of stay)."
    ],
    "it": [
      "Per il vostro divertimento! Troverete molti libri: libri per bambini, fumetti, romanzi, documentari? È possibile prendere in prestito 3 libri per 3 settimane (o per la durata del soggiorno)."
    ],
    "fr": [
      "Pour vous divertir ! Vous y trouverez de nombreux ouvrages : livres enfants, BD, romans, documentaires… Possibilité d'emprunter 3 livres pour 3 semaines (ou pour la durée du séjour)."
    ],
    "nl": [
      "Voor uw vermaak! U vindt er veel boeken: kinderboeken, strips, romans, documentaires... U kunt 3 boeken lenen voor 3 weken (of voor de duur van uw verblijf)."
    ],
    "es": [
      "Para su entretenimiento Encontrará muchos libros: libros infantiles, cómics, novelas, documentales.. Puedes tomar prestados 3 libros durante 3 semanas (o durante la duración de tu estancia)."
    ]
  },
