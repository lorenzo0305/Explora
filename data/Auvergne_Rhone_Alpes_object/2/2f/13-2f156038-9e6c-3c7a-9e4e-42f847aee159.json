  "rdfs:comment": {
    "de": [
      "Vom Bahnhof Boucieu-le-Roi aus können Sie die Gorges du Doux entdecken, indem Sie an Bord der Vélorail oder der Mastrou gehen, dem berühmten Dampfzug, der zwischen Tournon Saint Jean de Muzols und Lamastre verkehrt!"
    ],
    "en": [
      "From Boucieu-le-Roi station, discover the Gorges du Doux aboard the Vélorail or the Mastrou, the famous steam train running between Tournon Saint Jean de Muzols and Lamastre!"
    ],
    "it": [
      "Dalla stazione di Boucieu-le-Roi, esplorate le Gole del Doux a bordo del Vélorail o del Mastrou, il famoso treno a vapore che collega Tournon Saint Jean de Muzols a Lamastre!"
    ],
    "fr": [
      "De la gare de Boucieu-le-Roi, partez à la découverte des Gorges du Doux en montant à bord du Vélorail ou du Mastrou, le célèbre train à vapeur circulant entre  Tournon Saint Jean de Muzols et Lamastre !"
    ],
    "nl": [
      "Verken vanaf het station van Boucieu-le-Roi de Gorges du Doux aan boord van de Vélorail of de Mastrou, de beroemde stoomtrein tussen Tournon Saint Jean de Muzols en Lamastre!"
    ],
    "es": [
      "Desde la estación de Boucieu-le-Roi, explore las Gargantas del Doux a bordo del Vélorail o del Mastrou, el famoso tren de vapor que circula entre Tournon Saint Jean de Muzols y Lamastre"
    ]
  },
