  "rdfs:comment": {
    "de": [
      "In dem hübschen Dorf Corps bietet Ihnen das Le Napoléon seine Spezialitäten an: Caesar-Salat, Murçon, Pizza, Mousse au Chocolat und viele andere Gerichte, die Ihren Gaumen verzaubern werden."
    ],
    "en": [
      "In the pretty village of Corps, Le Napoléon offers its specialties: Caesar salad, murçon, pizza, chocolate mousse and many other dishes that will delight your taste buds."
    ],
    "it": [
      "Nel grazioso villaggio di Corps, Le Napoléon vi offre le sue specialità: insalata Caesar, murçon, pizza, mousse al cioccolato e molti altri piatti per deliziare il vostro palato."
    ],
    "fr": [
      "Dans le joli village de Corps, Le Napoléon vous propose ses spécialités : Salade César, murçon, pizza,  mousse au chocolat et bien d'autres mets qui enchanteront vos papilles."
    ],
    "nl": [
      "In het mooie dorpje Corps biedt Le Napoléon je zijn specialiteiten: Caesar salade, murçon, pizza, chocolademousse en vele andere gerechten om je smaakpapillen te verwennen."
    ],
    "es": [
      "En el bonito pueblo de Corps, Le Napoléon le ofrece sus especialidades: ensalada César, murçon, pizza, mousse de chocolate y muchos otros platos para deleitar su paladar."
    ]
  },
