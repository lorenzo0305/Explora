  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2262686c-a482-3539-9cf7-cf51f653b4da",
      "dc:description": {
        "de": [
          "Informationen :\n\nBestellungen :\n\nBestellung per Messenger oder E-Mail\n\n\nAbholung:\nNach Vereinbarung im Laden\nOder per Lieferung\n\nDie Lieferung erfolgt per Post:\nLiefermöglichkeit in einem Umkreis von 10 Kilometern um Arras\n\n "
        ],
        "en": [
          "Information :\n\nOrders :\n\nOrder by messenger or email\n\n\nCollection:\nBy appointment at the store\nOr by delivery\n\nFor delivery:\nDelivery possible within a 10-kilometer radius of Arras\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrdini :\n\nOrdini tramite corriere o e-mail\n\n\nRitiro:\nSu appuntamento in negozio\nO con consegna a domicilio\n\nConsegne:\nConsegna possibile entro un raggio di 10 chilometri da Arras\n\n "
        ],
        "fr": [
          "Informations :\n\nCommandes :\n\nCommande par messenger ou email  \n\n\nRetrait :\nSur rendez-vous au magasin\nOu en livraison\n\nLivraison:\nPossibilité de livraison dans un rayon de 10 kilomètres autour d'Arras\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nBestellingen :\n\nBestellen per koerier of e-mail\n\n\nAfhalen:\nOp afspraak in de winkel\nOf door bezorging\n\nLeveringen:\nLevering mogelijk binnen een straal van 10 kilometer rond Arras\n\n "
        ],
        "es": [
          "Más información :\n\nPedidos :\n\nPedidos por mensajero o correo electrónico\n\n\nRecogida:\nCon cita previa en la tienda\nO por entrega\n\nEntregas:\nEntrega posible en un radio de 10 kilómetros de Arras\n\n "
        ]
      },
