  "rdfs:comment": {
    "de": [
      "Rencontre Animation Culture richtet sich an alle Malatavernois sowie an alle, die sich für Musik, Malerei, Wissenschaft usw. interessieren, egal ob sie von hier oder von anderswo stammen."
    ],
    "en": [
      "Rencontre Animation Culture is open to all Malatavern residents and anyone interested in music, art, science and more, whether they're from here or abroad."
    ],
    "it": [
      "Rencontre Animation Culture è aperto a tutti gli abitanti di Malatavern e a tutti coloro che sono interessati alla musica, all'arte, alla scienza, ecc."
    ],
    "fr": [
      "Rencontre Animation Culture s’adresse à tous les Malatavernois comme à tous les férus de culture musicale, picturale, scientifique, etc, qu’ils soient d’ici ou d’ailleurs."
    ],
    "nl": [
      "Rencontre Animation Culture staat open voor alle inwoners van Malatavern en voor iedereen die geïnteresseerd is in muziek, kunst, wetenschap, etc., lokaal of van elders."
    ],
    "es": [
      "El Rencontre Animation Culture se dirige a todos los habitantes de Malatavern, así como a todos los interesados en la música, la pintura, la ciencia, etc., ya sean de aquí o de otros lugares."
    ]
