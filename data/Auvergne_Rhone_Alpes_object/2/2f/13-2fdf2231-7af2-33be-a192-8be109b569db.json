  "rdfs:comment": {
    "de": [
      "Brauchen Sie einen Rat? Zögern Sie nicht, uns unter der Nummer 04 79 00 08 08 zu kontaktieren.\r\nDas Tourismusbüro befindet sich im Zentrum des Ortes auf 2300 m Höhe im Herzen des Skigebiets 3 Vallées."
    ],
    "en": [
      "Need some advice? Don't hesitate to contact us on 04 79 00 08 08.\r\nThe Tourist Office is located in the centre of the resort at an altitude of 2300m, in the heart of the 3 Vallées ski area."
    ],
    "it": [
      "Avete bisogno di un consiglio? Non esitate a contattarci al numero 04 79 00 08 08.\r\nL'Ufficio del Turismo si trova nel centro della località, a 2300 m di altitudine, nel cuore del comprensorio sciistico delle 3 Vallées."
    ],
    "fr": [
      "Besoin d'un conseil ? N'hésitez pas à nous contacter au 04 79 00 08 08.\r\nL'Office de Tourisme est situé en centre station à 2300m d'altitude au cœur du domaine skiable des 3 Vallées."
    ],
    "es": [
      "¿Necesita consejo? No dude en ponerse en contacto con nosotros en el 04 79 00 08 08.\r\nLa Oficina de Turismo está situada en el centro de la estación, a 2300 m de altitud, en el corazón del dominio esquiable de los 3 Vallées."
    ],
    "nl": [
      "Heb je advies nodig? Aarzel niet om contact met ons op te nemen op 04 79 00 08 08.\r\nHet Office du Tourisme bevindt zich in het centrum van het skioord op 2300 m hoogte, in het hart van het skigebied van de 3 Vallées."
    ]
  },
