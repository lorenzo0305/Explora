  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4bd05d9d-a9c8-35c5-8cae-2ec97003abc1",
      "dc:description": {
        "de": [
          "Eine echte Brasserie mit traditioneller Küche in einem warmen und geselligen Rahmen.\n\nNachhaltige Ansätze :\nNull Plastik\nAnti-Gaspi\nNull Abfall\nKurzer Kreislauf"
        ],
        "en": [
          "A real brasserie with traditional cuisine in a warm and friendly setting.\n\nSustainable approaches :\nZero plastic\nAnti wastage\nZero waste\nShort circuit"
        ],
        "it": [
          "Una vera e propria brasserie con cucina tradizionale in un ambiente caldo e accogliente.\n\nApprocci sostenibili:\nZero plastica\nNessun rifiuto\nZero rifiuti\nCortocircuito"
        ],
        "fr": [
          "Une vraie brasserie à la cuisine traditionnelle dans un cadre chaleureux et convivial.\n\nDémarches durables : \nZéro plastique\nAnti gaspi\nZéro déchet\nCircuit court"
        ],
        "es": [
          "Una auténtica brasserie con cocina tradicional en un ambiente cálido y acogedor.\n\nEnfoques sostenibles :\nCero plástico\nSin residuos\nCero residuos\nCortocircuito"
        ],
        "nl": [
          "Een echte brasserie met traditionele gerechten in een warme en vriendelijke omgeving.\n\nDuurzame aanpak :\nNul plastic\nGeen afval\nGeen afval\nKortsluiting"
        ]
      },
