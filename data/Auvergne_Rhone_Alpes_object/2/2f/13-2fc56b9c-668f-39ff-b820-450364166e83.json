          "additionalInformation": {
            "de": [
              "Montag bis Freitag\r\n8:00-14:00 Uhr & 18:00-21:30 Uhr\r\nSamstag & Sonntag\r\n9h-14h & 18h-22h\r\n\r\nIn den Sommerferien und im Februar täglich geöffnet\r\nDienstag ab 14.00 Uhr und Mittwoch ganztägig geschlossen"
            ],
            "en": [
              "Monday to Friday\r\n8h-14h & 18h-21h30\r\nSaturday and Sunday\r\n9h-14h & 18h-22h\r\n\r\nOpen every day during the summer and February holidays\r\nClosed on Tuesdays from 2 pm and on Wednesdays all day long"
            ],
            "it": [
              "Da lunedì a venerdì\r\n8.00-14.00 e 18.00-21.30\r\nSabato e domenica\r\n9.00-14.00 e 18.00-22.00\r\n\r\nAperto tutti i giorni durante l'estate e le vacanze di febbraio\r\nChiuso il martedì dalle 14.00 e il mercoledì tutto il giorno"
            ],
            "fr": [
              "Lundi au Vendredi\r\n8h-14h & 18h-21h30\r\nSamedi et Dimanche\r\n9h-14h & 18h-22h\r\n\r\nOuvert tous les jours pendant les vacances d'été et de février\r\nFermeture le mardi dès 14h00 et le mercredi toute la journée"
            ],
            "nl": [
              "Maandag tot vrijdag\r\n8am-2pm & 6pm-9:30pm\r\nZaterdag en zondag\r\n9u-2u & 18u-10u\r\n\r\nElke dag geopend tijdens de zomer- en februarivakantie\r\nGesloten op dinsdag vanaf 14.00 uur en op woensdag de hele dag"
            ],
            "es": [
              "De lunes a viernes\r\n8:00-14:00 y 18:00-21:30\r\nSábado y domingo\r\nde 9 a 14 horas y de 18 a 22 horas\r\n\r\nAbierto todos los días durante el verano y las vacaciones de febrero\r\nCerrado los martes a partir de las 14 horas y los miércoles todo el día"
            ]
          },
