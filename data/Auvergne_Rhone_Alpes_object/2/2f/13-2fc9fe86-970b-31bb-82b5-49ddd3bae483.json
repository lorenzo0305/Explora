  "rdfs:comment": {
    "de": [
      "Das Globe empfängt Sie das ganze Jahr über. Sie können auf der (beheizten) Terrasse oder im Speisesaal zu Mittag oder zu Abend essen. Pizzas, Tapas oder traditionelle Küche stehen auf der Speisekarte. Für Ihre Tagungen steht Ihnen ein ausgestatteter Raum zur Verfügung."
    ],
    "en": [
      "Le Globe welcomes you all year round. You can have lunch or dinner on the terrace (heated) or in the dining room. Pizzas, tapas or traditional cuisine are on the menu. For your meetings, we have an equipped room."
    ],
    "it": [
      "Le Globe vi accoglie tutto l'anno. È possibile pranzare o cenare sulla terrazza (riscaldata) o all'interno. Il menu prevede pizze, tapas o cucina tradizionale. Per le vostre riunioni, disponiamo di una sala attrezzata."
    ],
    "fr": [
      "Le Globe vous accueille toute l'année. Vous pourrez déjeuner ou dîner en terrasse (chauffée) ou en salle. Pizzas, tapas ou cuisine traditionnelle sont au menu. Pour vos réunions, nous disposons d'une salle équipée."
    ],
    "nl": [
      "Le Globe verwelkomt u het hele jaar door. U kunt lunchen of dineren op het terras (verwarmd) of binnen. Pizza's, tapas of traditionele gerechten staan op het menu. Voor uw vergaderingen beschikken we over een uitgeruste zaal."
    ],
    "es": [
      "Le Globe le da la bienvenida todo el año. Se puede comer o cenar en la terraza (climatizada) o en el interior. El menú incluye pizzas, tapas o cocina tradicional. Para sus reuniones, disponemos de una sala equipada."
    ]
  },
  "rdfs:label": {
