      "dc:description": {
        "de": [
          "Heimwerkermarkt im Einkaufszentrum Auchan, RN42 in Saint Martin Boulogne.\nDer Laden ist von Montag bis Samstag von 10.00 bis 18.00 Uhr geöffnet"
        ],
        "en": [
          "DIY store in the Auchan shopping center, RN42 in Saint Martin Boulogne.\nThe store will be open from Monday to Saturday, from 10 a.m. to 6 p.m"
        ],
        "it": [
          "Negozio di bricolage nel centro commerciale Auchan, RN42 a Saint Martin Boulogne.\nIl negozio sarà aperto da lunedì a sabato, dalle 10.00 alle 18.00"
        ],
        "fr": [
          "Magasin de bricolage dans le centre commercial Auchan, RN42 à Saint Martin Boulogne.\nLe magasin sera ouvert du lundi au samedi, de 10 heures à 18 heures"
        ],
        "es": [
          "Tienda de bricolaje en el centro comercial Auchan, RN42 en Saint Martin Boulogne.\nLa tienda estará abierta de lunes a sábado, de 10.00 a 18.00 horas"
        ],
        "nl": [
          "Doe-het-zelfwinkel in het Auchan winkelcentrum, RN42 in Saint Martin Boulogne.\nDe winkel is geopend van maandag tot en met zaterdag, van 10.00 tot 18.00 uur"
        ]
      },
