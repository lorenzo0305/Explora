  "rdfs:comment": {
    "de": [
      "Die Mediathek La Turbine bietet eine freie Nutzung von Multimediasammlungen und verschiedenen Dienstleistungen. Sie ist in denselben Räumlichkeiten wie das Kulturzentrum La Turbines Sciences untergebracht und vermittelt wissenschaftliche Entdeckungen für alle Altersgruppen."
    ],
    "en": [
      "The La Turbine media library offers free access to multimedia collections and a wide range of services. Housed in the same premises as the La Turbines Sciences cultural center, it promotes scientific discoveries for all ages."
    ],
    "it": [
      "La biblioteca multimediale La Turbine offre accesso gratuito alle collezioni multimediali e un'ampia gamma di servizi. Ospitata negli stessi locali del centro culturale La Turbine Sciences, promuove le scoperte scientifiche per tutte le età."
    ],
    "fr": [
      "La médiathèque La Turbine propose une libre consultation de collections multimédias et de services variés. Aménagée dans les mêmes locaux que le centre culturel La Turbines Sciences, elle valorise les découvertes scientifiques pour tous les âges."
    ],
    "es": [
      "La biblioteca multimedia La Turbine ofrece acceso gratuito a colecciones multimedia y una amplia gama de servicios. Ubicada en los mismos locales que el centro cultural La Turbines Sciences, promueve los descubrimientos científicos para todas las edades."
    ],
    "nl": [
      "De mediatheek van La Turbine biedt gratis toegang tot multimediacollecties en een breed scala aan diensten. De bibliotheek is gevestigd in hetzelfde gebouw als het cultureel centrum La Turbines Sciences en bevordert wetenschappelijke ontdekkingen voor alle leeftijden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque La Turbine"
    ]
  },
