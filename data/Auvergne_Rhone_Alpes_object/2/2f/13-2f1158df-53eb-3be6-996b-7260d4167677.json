  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf einen rhythmischen Jazz-Tanzabend vor. Zwei Bands werden nacheinander die Bühne zum Glühen bringen und Sie die ganze Nacht im Rhythmus des Jazz tanzen lassen."
    ],
    "en": [
      "Get ready for a rhythmic evening of jazz dancing. Two bands will take to the stage in succession and keep you dancing all night long to the rhythm of jazz."
    ],
    "it": [
      "Preparatevi a una serata all'insegna del ritmo del jazz. Due band saliranno sul palco per infiammare la scena e farvi ballare tutta la notte al ritmo del jazz."
    ],
    "fr": [
      "Préparez-vous pour une soirée jazz dansante pleine de rythme. Deux groupes se succéderont pour enflammer la scène et vous faire danser toute la nuit au rythme du jazz."
    ],
    "es": [
      "Prepárese para una noche de baile al ritmo del jazz. Dos bandas subirán al escenario para incendiarlo y hacerte bailar toda la noche a ritmo de jazz."
    ],
    "nl": [
      "Bereid je voor op een avond ritmisch jazzdansen. Twee bands betreden het podium om het podium in vuur en vlam te zetten en je de hele avond te laten dansen op het ritme van jazz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Jazz"
    ]
  },
