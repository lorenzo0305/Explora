  "rdfs:comment": {
    "de": [
      "Idealer Fluss für Liebhaber des Forellenangelns, wo die Unterschiede in Größe und Profil die Möglichkeit bieten, mehrere Techniken anzuwenden.\r\nKursverwaltung: AAPPMA von Châteauneuf-les-Bains und AAPPMA von Saint-Eloy Les Gaules zusammen"
    ],
    "en": [
      "Ideal river for trout fishing enthusiasts, where the differences in size and profiles offer the possibility of using several techniques.\r\nCourse management: AAPPMA of Châteauneuf-les-Bains and AAPPMA of Saint-Eloy Les Gaules combined"
    ],
    "it": [
      "Fiume ideale per gli appassionati di pesca alla trota, dove le differenze di dimensioni e profilo offrono la possibilità di utilizzare diverse tecniche.\r\nGestione del corso: AAPPMA di Châteauneuf-les-Bains e AAPPMA di Saint-Eloy Les Gaules insieme"
    ],
    "fr": [
      "Rivière idéale pour les amateurs de pêche à la truite, où les différences de taille et de profils offrent la possibilité d'utiliser plusieurs techniques.\r\nGestion du parcours : AAPPMA de Châteauneuf-les-Bains et AAPPMA de Saint-Eloy Les Gaules réunies"
    ],
    "es": [
      "Río ideal para los aficionados a la pesca de la trucha, donde las diferencias de tamaño y perfil ofrecen la posibilidad de utilizar varias técnicas.\r\nGestión del curso: AAPPMA de Châteauneuf-les-Bains y AAPPMA de Saint-Eloy Les Gaules juntas"
    ],
    "nl": [
      "Ideale rivier voor liefhebbers van forelvissen, waar de verschillen in grootte en profiel de mogelijkheid bieden om verschillende technieken toe te passen.\r\nBeheer van de cursus: AAPPMA van Châteauneuf-les-Bains en AAPPMA van Saint-Eloy Les Gaules samen"
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelplatz - Fluss Sioule (untere Sioule)"
    ],
    "en": [
      "Fishing site - River Sioule (basse Sioule)"
    ],
    "fr": [
      "Site de pêche - Rivière la Sioule (basse Sioule)"
    ]
  },
