  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4f3ab5af-65df-35e2-b29b-660292150633",
      "dc:description": {
        "de": [
          "Tätowierung (neue Tätowierungen, Abdeckungen, Brustrekonstruktion, traditionelle oder Intimpiercings)\n\nGanzjährig geöffnet von Dienstag bis Freitag von 10:30 bis 18:30 Uhr und am Samstag von 10:30 bis 17:00 Uhr (außer an bestimmten Feiertagen)"
        ],
        "en": [
          "Tattooing (new, coverings, breast reconstruction, traditional or intimate piercings)\n\nOpen all year round, Tuesday to Friday, 10:30 am to 6:30 pm and Saturday, 10:30 am to 5:00 pm (except certain public holidays)"
        ],
        "it": [
          "Tatuaggio (nuovi tatuaggi, coperture, ricostruzione del seno, piercing tradizionali o intimi)\n\nAperto tutto l'anno, dal martedì al venerdì dalle 10.30 alle 18.30 e il sabato dalle 10.30 alle 17.00 (tranne alcuni giorni festivi)"
        ],
        "fr": [
          "Réalisation de tatouages ( nouveaux, recouvrements, reconstruction mammaire, piercings traditionnels ou intimes)\n\nOuvert toute l'année du mardi au vendredi de 10h30 à 18h30 et le samedi de 10h30 à 17h00 ( sauf certains jours fériés )"
        ],
        "es": [
          "Tatuajes (nuevos tatuajes, cubrimientos, reconstrucción mamaria, piercings tradicionales o íntimos)\n\nAbierto todo el año, de martes a viernes de 10.30 a 18.30 h y los sábados de 10.30 a 17 h (excepto algunos días festivos)"
        ],
        "nl": [
          "Tatoeëren (nieuwe tatoeages, bedekkingen, borstreconstructie, traditionele of intieme piercings)\n\nHet hele jaar geopend, dinsdag t/m vrijdag van 10.30 tot 18.30 uur en zaterdag van 10.30 tot 17.00 uur (behalve op bepaalde feestdagen)"
        ]
      },
