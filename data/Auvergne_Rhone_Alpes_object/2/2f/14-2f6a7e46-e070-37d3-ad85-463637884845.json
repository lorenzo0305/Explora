      "@id": "https://data.datatourisme.fr/179f3981-b95d-30af-8e97-96d16920daf2",
      "dc:description": {
        "de": [
          "Les Amis d'Ambricourt organisiert das Erntedankfest in Ambricourt\nTreffpunkt am Samstag, den 6. September ab 19.30 Uhr\nEssen für Erwachsene: 17? - Essen für Kinder: 7?\n\nReservierung erforderlich"
        ],
        "en": [
          "Les Amis d'Ambricourt organizes the Harvest Festival in Ambricourt\nRendezvous on Saturday, September 6 from 7:30 pm\nAdult meal: 17? - Children's meal: 7?\n\nOn reservation"
        ],
        "it": [
          "Gli Amici di Ambricourt organizzano la Festa della Vendemmia ad Ambricourt\nAppuntamento sabato 6 settembre dalle ore 19.30\nPasto per adulti: 17? - Pasto per bambini: 7?\n\nSolo su prenotazione"
        ],
        "fr": [
          "Les Amis d'Ambricourt organise la Fête de la Moisson à Ambricourt\nRendez-vous le samedi 6 septembre à partir de 19h30\nRepas adulte : 17€ - Repas enfant : 7€\n\nSur réservation"
        ],
        "es": [
          "Los Amigos de Ambricourt organizan la Fiesta de la Cosecha en Ambricourt\nCita el sábado 6 de septiembre a partir de las 19.30 horas\nComida de adultos: 17? - Comida para niños: 7?\n\nSólo con reserva"
        ],
        "nl": [
          "De Vrienden van Ambricourt organiseren het Oogstfeest in Ambricourt\nRendez-vous op zaterdag 6 september vanaf 19.30 uur\nMaaltijd volwassenen: 17? - Kindermaaltijd: 7?\n\nAlleen op reservering"
        ]
      },
