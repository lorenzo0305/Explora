  "rdfs:comment": {
    "de": [
      "Handwerksbrauerei seit 2014. Große Auswahl an Bieren mit einem klassischen Sortiment und einem kurzlebigen Sortiment. Originelle Brauereien, die zum Großteil aus biologischem Anbau stammen."
    ],
    "en": [
      "Craft brewery since 2014. Wide choice of beers with a classic range and an ephemeral range. Original brews, the vast majority of which are organic."
    ],
    "it": [
      "Birrificio artigianale dal 2014. Ampia scelta di birre con una gamma classica e una effimera. Birre originali, la maggior parte delle quali biologiche."
    ],
    "fr": [
      "Brasserie artisanale depuis 2014. Large choix de bières avec une gamme classique et une gamme éphémère. Des brassins originaux et en agriculture biologique pour la grande majorité."
    ],
    "es": [
      "Cervecería artesanal desde 2014. Amplia selección de cervezas con una gama clásica y otra efímera. Cervezas originales, la gran mayoría ecológicas."
    ],
    "nl": [
      "Ambachtelijke brouwerij sinds 2014. Ruime keuze aan bieren met een klassiek assortiment en een efemeer assortiment. Originele brouwsels, waarvan de overgrote meerderheid biologisch is."
    ]
  },
