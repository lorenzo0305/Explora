  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt und nur wenige Schritte vom Jachthafen entfernt werden Ihnen hier regionale Produkte angeboten (Bresse-Huhn, frische Frösche, Zander)."
    ],
    "en": [
      "In the heart of the town and a stone's throw from the marina, here you'll find local produce such as Bresse chicken, fresh frogs and pike-perch."
    ],
    "it": [
      "Nel cuore della città e a due passi dal porto turistico, qui troverete prodotti locali (pollo di Bresse, rane fresche, luccioperca)."
    ],
    "fr": [
      "Au coeur de la ville et à deux pas du port de plaisance, ici on vous propose les produits du terroir (poulet de Bresse, grenouilles fraiches, sandre)."
    ],
    "nl": [
      "In het hart van de stad en op een steenworp afstand van de jachthaven vind je lokale producten (Bressekip, verse kikkers, snoekbaars)."
    ],
    "es": [
      "En pleno centro de la ciudad y a dos pasos del puerto deportivo, aquí encontrará productos locales (pollo de Bresse, ranas frescas, lucioperca)."
    ]
  },
