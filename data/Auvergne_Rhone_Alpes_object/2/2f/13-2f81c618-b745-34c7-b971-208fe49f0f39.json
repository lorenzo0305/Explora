  "rdfs:comment": {
    "de": [
      "Der Place des Possibles ist ein Ort der Arbeit, des Lernens und der Entdeckungen dank der Synergien, die zwischen den Akteuren entwickelt werden, die möchten, dass dieser Raum des Austauschs und der Begegnungen ihre eigene Praxis bereichert."
    ],
    "en": [
      "Place des Possibles is a place to work, learn and discover, thanks to the synergy developed between the players who want this space for exchange and encounters to enrich their own practices."
    ],
    "it": [
      "Place des Possibles è un luogo di lavoro, di apprendimento e di scoperta, grazie alla sinergia sviluppata tra gli attori che vogliono che questo spazio di scambio e di incontro arricchisca le proprie pratiche."
    ],
    "fr": [
      "La Place des Possibles est un lieu de travail, d’apprentissage et de découvertes grâce à la synergie développée entre les acteurs qui souhaitent que cet espace d’échanges et de rencontres enrichissent leurs propres pratiques."
    ],
    "nl": [
      "Place des Possibles is een plek voor werk, leren en ontdekken, dankzij de synergie tussen de spelers die deze ruimte voor uitwisseling en ontmoetingen willen gebruiken om hun eigen praktijk te verrijken."
    ],
    "es": [
      "La Place des Possibles es un lugar de trabajo, aprendizaje y descubrimiento, gracias a la sinergia desarrollada entre los agentes que desean que este espacio de intercambio y encuentro enriquezca sus propias prácticas."
    ]
  },
  "rdfs:label": {
