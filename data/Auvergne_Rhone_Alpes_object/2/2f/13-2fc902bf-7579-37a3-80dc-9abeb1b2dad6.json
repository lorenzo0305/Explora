  "rdfs:comment": {
    "de": [
      "Brettsportfans können sich auf dem Wakeboard versuchen und sich auf einem 1925m² großen Parcours mit aufblasbaren Wasserspielen vergnügen. Zugangsbedingungen, Infos und Reservierungen auf unserer Webseite"
    ],
    "en": [
      "If you love winter sports, come and try wakeboarding and have fun on our 1925 m2 course with inflatable watersport toys! Access conditions, information and booking on our website"
    ],
    "it": [
      "Venite a scoprire il wakeboard nel cablepark e divertitevi sui nostri 1925 m² di giochi d'acqua gonfiabili! Condizioni di accesso, informazioni e prenotazioni sul nostro sito web"
    ],
    "fr": [
      "Fan de glisse, venez découvrir le wakeboard en cablepark et vous amusez sur notre parcoursde 1925m² de jeux gonflables aquatiques ! Conditions d'accès, infos et réservations sur notre site Internet"
    ],
    "es": [
      "Venga a descubrir el wakeboard en el cablepark y diviértase en nuestro recorrido de 1925 m² de juegos acuáticos hinchables. Condiciones de acceso, información y reservas en nuestro sitio web"
    ],
    "nl": [
      "Kom en ontdek het wakeboarden in het cablepark en vermaak je op onze 1925m² grote baan met opblaasbare waterspelen! Toegang voorwaarden, info en reserveringen op onze website"
    ]
  },
