  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ba7359b8-0588-3db9-bfbd-cf5bebc0b7a1",
      "dc:description": {
        "de": [
          "Ein Abend in völliger Entspannung, ziehen Sie sich bequeme Kleidung an und bringen Sie Ihr Kissen, Plaid, Kopfkissen, eventuell eine Bodenmatte und ... Ihre Kuscheldecke mit!"
        ],
        "en": [
          "For an evening of total relaxation, wear comfortable clothes and bring your own cushion, plaid, pillow, possibly a floor mat and ... your cuddly toy!"
        ],
        "it": [
          "Per una serata totalmente rilassante, indossate abiti comodi e portate con voi un cuscino, una coperta, un cuscino, un tappetino e... il vostro peluche!"
        ],
        "fr": [
          "Une soirée en totale détente, mettez une tenue confortable et apportez votre coussin, plaid, oreiller, éventuellement un tapis de sol et ... votre doudou !"
        ],
        "nl": [
          "Voor een volledig ontspannen avond, draag comfortabele kleding en neem je eigen kussen, deken, kussen, vloermat en ... je knuffel mee!"
        ],
        "es": [
          "Para disfrutar de una velada totalmente relajante, póngase ropa cómoda y traiga su propio cojín, manta, almohada, alfombrilla y... ¡su peluche!"
        ]
      },
