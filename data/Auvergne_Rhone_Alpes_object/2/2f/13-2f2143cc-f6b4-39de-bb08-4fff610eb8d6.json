  "rdfs:comment": {
    "de": [
      "Safran tours ist eine französische Incoming-Agentur, die sich auf Reisen in Freiheit spezialisiert hat. Wir bieten Wander-, Rad- und Trekkingreisen sowie Reisen in Begleitung eines Esels an. Wir kümmern uns um die gesamte Logistik mit einer Unterstützung an 7 Tagen pro Woche."
    ],
    "en": [
      "Safran tours is a French incoming agency specialized in self-guided tours. We offer biking tours, hiking tours or accompanied by a donkey. We take care of all the logistics with a 7 days a week assistance."
    ],
    "it": [
      "Safran tours è un'agenzia di incoming francese specializzata in viaggi gratuiti. Offriamo viaggi itineranti, in bicicletta, a piedi o accompagnati da un asino. Ci occupiamo di tutta la logistica con un'assistenza 7/7."
    ],
    "fr": [
      "Safran tours est une agence réceptive française spécialiste des séjours en liberté. Nous proposons des voyages en itinérance, à vélo, en randonnées pédestre ou accompagné d'un âne. Nous nous occupons l'ensemble de la logistique avec une assistance 7j/7."
    ],
    "nl": [
      "Safran tours is een Frans incoming agency gespecialiseerd in rondtrekkende vakanties. Wij bieden rondtrekkende tochten aan, per fiets, te voet of begeleid door een ezel. Wij zorgen voor alle logistiek, met 7/7 assistentie."
    ],
    "es": [
      "Safran tours es una agencia receptiva francesa especializada en viajes gratuitos. Ofrecemos viajes itinerantes, en bicicleta, a pie o acompañados por un burro. Nos encargamos de toda la logística con una asistencia 7/7."
    ]
  },
