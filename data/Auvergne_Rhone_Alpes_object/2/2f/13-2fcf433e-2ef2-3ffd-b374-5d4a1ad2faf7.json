  "rdfs:comment": {
    "de": [
      "Die Kirche von Onnion wurde zwischen 1824 und 1829 an der Stelle der alten Kirche auf der Grundlage der Pläne eines Architekten namens Amoudruz errichtet."
    ],
    "en": [
      "The Onnion church was built between 1824 and 1829, on the site of the old one, based on plans by an architect named Amoudruz."
    ],
    "it": [
      "La chiesa di Onnion fu costruita tra il 1824 e il 1829 sul sito della vecchia chiesa, su progetto di un architetto di nome Amoudruz."
    ],
    "fr": [
      "L'église d'Onnion a été édifiée entre 1824 et 1829, sur l'emplacement de l'ancienne, sur la base des plans d'un architecte nommé Amoudruz."
    ],
    "es": [
      "La iglesia de Onnion se construyó entre 1824 y 1829, en el lugar de la antigua, sobre la base de los planos de un arquitecto llamado Amoudruz."
    ],
    "nl": [
      "De kerk in Onnion werd tussen 1824 en 1829 gebouwd op de plek van de oude kerk, naar plannen van een architect genaamd Amoudruz."
    ]
  },
