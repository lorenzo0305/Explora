  "rdfs:comment": {
    "de": [
      "Willkommen im Lodge Park, Ihrem 5-Sterne-Hotel im Herzen von Megève. Dieses vertrauliche Refugium, das wie ein schicker Alpenclub auf dem Gipfel des Luxus konzipiert ist, erfindet die Kunst der Gastlichkeit in den Bergen neu."
    ],
    "en": [
      "Welcome to Lodge Park, your 5 star hotel in the heart of Megève. Conceived as a chic Alpine club at the height of luxury, this intimate retreat redefines the art of mountain hospitality."
    ],
    "it": [
      "Benvenuti al Lodge Park, il vostro hotel a 5 stelle nel cuore di Megève. Progettato come un club alpino chic all'apice del lusso, questo rifugio riservato reinventa l'arte del divertimento in montagna."
    ],
    "fr": [
      "Bienvenue au Lodge Park, votre hôtel 5 étoiles au cœur de Megève. Pensé comme un club alpin chic au summum du luxe, ce refuge confidentiel réinvente l’art de recevoir à la montagne."
    ],
    "nl": [
      "Welkom in Lodge Park, uw 5-sterrenhotel in het hart van Megève. Ontworpen als een chique alpine club op het toppunt van luxe, vindt dit vertrouwelijke toevluchtsoord de kunst van het entertainen in de bergen opnieuw uit."
    ],
    "es": [
      "Bienvenido al Lodge Park, su hotel de 5 estrellas en el corazón de Megève. Diseñado como un elegante club alpino a la altura del lujo, este refugio confidencial reinventa el arte del entretenimiento en la montaña."
    ]
  },
