  "rdfs:comment": {
    "de": [
      "17 Fresken, die Sie auf einem freien Rundgang entdecken können.\r\nSie lernen die Streetart in Bourgoin-Jallieu kennen und werden überrascht sein, wie sehr sich das Stadtmobiliar für überraschende Entdeckungen eignet!"
    ],
    "en": [
      "17 frescoes to discover on a self-guided tour.\r\nYou'll discover street art in Bourgoin-Jallieu, and be amazed at the extent to which street furniture lends itself to surprising discoveries!"
    ],
    "it": [
      "17 affreschi da scoprire in un tour autoguidato.\r\nScoprite l'arte di strada a Bourgoin-Jallieu e lasciatevi stupire da quante sorprendenti scoperte si possono fare utilizzando l'arredo urbano!"
    ],
    "fr": [
      "17 fresques à découvrir autour d'un parcours libre.\r\nVous découvrirez le street-art à Bourgoin-Jallieu et vous serez surpris de voir à quel point le mobilier urbain se prête à de surprenantes découvertes !"
    ],
    "es": [
      "17 frescos para descubrir en una visita autoguiada.\r\nDescubra el arte callejero en Bourgoin-Jallieu y sorpréndase de la cantidad de descubrimientos sorprendentes que se pueden hacer utilizando el mobiliario urbano"
    ],
    "nl": [
      "17 fresco's om te ontdekken tijdens een rondleiding op eigen houtje.\r\nOntdek de straatkunst in Bourgoin-Jallieu en verbaas je over hoeveel verrassende ontdekkingen je kunt doen aan de hand van straatmeubilair!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours Street Art de Bourgoin-Jallieu"
    ]
  },
