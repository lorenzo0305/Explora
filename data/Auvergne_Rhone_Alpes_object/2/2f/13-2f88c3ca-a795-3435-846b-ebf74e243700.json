  "rdfs:comment": {
    "de": [
      "Diese Kirche wurde zu Ehren des Heiligen Didier? errichtet, der hier am 23. Mai 608 ermordet wurde, und zu Beginn des 17."
    ],
    "en": [
      "Erected in honor of Saint -Didier? murdered here on May 23, 608 and rebuilt in the early 17th century, the brick pillars were replaced by Senozan stone columns in 1773."
    ],
    "it": [
      "Questa chiesa, costruita in onore di San Didier, assassinato qui il 23 maggio 608, fu ricostruita all'inizio del XVII secolo e nel 1773 i suoi pilastri in mattoni furono sostituiti da colonne in pietra di Senozan."
    ],
    "fr": [
      "Cette église, érigée en l’honneur de Saint -Didier? assassiné ici le 23 mai 608 et reconstruite au début du XVIIe siècle, vit ses piliers en briques remplacés en 1773 par des colonnes en pierre de Senozan."
    ],
    "es": [
      "Esta iglesia, construida en honor de San -Didier? que fue asesinado aquí el 23 de mayo de 608, fue reconstruida a principios del siglo XVII. En 1773, sus pilares de ladrillo fueron sustituidos por columnas de piedra de Senozan."
    ],
    "nl": [
      "Deze kerk, gebouwd ter ere van de heilige Didier die hier op 23 mei 608 werd vermoord, werd herbouwd aan het begin van de 17e eeuw. In 1773 werden de bakstenen pilaren vervangen door Senozan stenen zuilen."
    ]
  },
  "rdfs:label": {
