  "rdfs:comment": {
    "de": [
      "Das Bistrot de l'écailler lädt Sie zu einem außergewöhnlichen kulinarischen Erlebnis inmitten von Meeresdelikatessen ein. Für diejenigen mit weniger maritimen Geschmacksknospen wird Ihnen auch eine Landseite angeboten."
    ],
    "en": [
      "The Bistrot de l'écailler invites you to enjoy an exceptional culinary experience at the heart of marine delights, and for those with less seafaring taste buds, there's also a land-based option."
    ],
    "it": [
      "Il Bistrot de l'écailler vi invita a vivere un'esperienza culinaria eccezionale nel cuore delle delizie marine. Per chi ha gusti meno marini, c'è anche un'opzione di terra."
    ],
    "fr": [
      "Le Bistrot de l'écailler vous invite à une expérience culinaire exceptionnelle au cœur des délices marins ainsi que, pour les personnes aux papilles moins marines, un côté terre vous est proposé."
    ],
    "es": [
      "El Bistrot de l'écailler le invita a disfrutar de una experiencia culinaria excepcional en el corazón de las delicias marinas. Para los menos marineros, también hay una opción en tierra."
    ],
    "nl": [
      "De Bistrot de l'écailler nodigt je uit om te genieten van een uitzonderlijke culinaire ervaring in het hart van de zeevruchten. Voor degenen die minder van zee houden, is er ook een optie aan land."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistrot de l'Ecailler"
    ]
  },
