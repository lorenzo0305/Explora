  "rdfs:comment": {
    "de": [
      "Die Grotte du Yeti empfängt Sie in einer herzlichen und internationalen Atmosphäre beim Après-Ski mit einer Terrasse mit Blick auf den Skiort und am Abend! Interessante und degressive Preise mit der Yeticard!"
    ],
    "en": [
      "La Grotte du Yéti welcomes you with its warm and international atmosphere during the après-ski with a terrace overlooking the resort. It opens in the evening! Attractive, bulk discount prices with the Yeticard!"
    ],
    "it": [
      "La Grotte du Yéti vi accoglie nella sua calda atmosfera internazionale per l'après-ski, con una terrazza che si affaccia sul resort, e la sera! Prezzi eccezionali e sconti con la Yeticard!"
    ],
    "fr": [
      "La Grotte du Yéti vous accueille dans une ambiance chaleureuse et internationale lors de ses après-ski avec une terrasse surplombant la station et en soirée ! Prix intéressant et dégressif avec la Yeticard !"
    ],
    "es": [
      "La Grotte du Yéti le da la bienvenida a su cálido e internacional ambiente après-ski, con una terraza con vistas a la estación, ¡y por las noches! ¡Grandes precios y descuentos con el Yeticard!"
    ],
    "nl": [
      "La Grotte du Yéti heet je tot 01u30 's nachts welkom in een warme en internationale sfeer tijdens de après-ski, met een terras dat uitkijkt over het skioord! Je krijgt korting met de Yeticard!"
    ]
  },
