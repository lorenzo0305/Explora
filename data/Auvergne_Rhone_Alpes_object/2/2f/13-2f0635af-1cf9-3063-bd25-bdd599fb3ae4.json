  "rdfs:comment": {
    "de": [
      "Dieses kleine Dorf hat nicht mehr als 200 Einwohner, bietet aber zahlreiche Naturaktivitäten an."
    ],
    "en": [
      "Proudly enthroned on the heights of the Roannais in a mountainous area with a breathtaking view from the top of its 1000 meters of altitude on the dams; This small village does not have more than 200 inhabitants but its natural activities are numerous."
    ],
    "it": [
      "Situato sulle alture del Roannais, in piena zona montuosa, con una vista mozzafiato sulle dighe dall'alto dei suoi 1.000 metri di altitudine, questo piccolo villaggio conta non più di 200 abitanti ma offre un'ampia gamma di attività naturali."
    ],
    "fr": [
      "Trônant fièrement sur les hauteurs du Roannais en pleine zone montagneuse avec une vue imprenable du haut de ses 1000 mètres d’altitude sur les barrages; Ce petit village ne compte pas plus de 200 habitants mais ses activités natures y sont nombreuses."
    ],
    "es": [
      "Situado con orgullo en las alturas del Roannais, en medio de una zona montañosa con una impresionante vista de las presas desde lo alto de sus 1.000 metros de altitud, este pequeño pueblo no tiene más de 200 habitantes pero ofrece una amplia gama de actividades naturales."
    ],
    "nl": [
      "Dit kleine dorp, dat trots op de hoogten van de Roannais staat, midden in een berggebied met een adembenemend uitzicht op de dammen vanaf de top van zijn 1000 meter hoogte, telt niet meer dan 200 inwoners, maar de natuurlijke activiteiten zijn talrijk."
    ]
  },
  "rdfs:label": {
