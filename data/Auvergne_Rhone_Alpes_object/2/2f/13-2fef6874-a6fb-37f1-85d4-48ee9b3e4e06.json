  "rdfs:comment": {
    "de": [
      "Bio-Oliven und -Olivenöle, Bio-Trockenfrüchte. Verkauf in der Werkstatt täglich ab 15 Uhr in Buis, ch du Col d'Os. Bboutique atelier Biolive: 4, r. Grenette 05000 Gap. Märkte: dienstags in Vaison, mittwochs in Buis, freitags in Carpentras und samstags in Gap."
    ],
    "en": [
      "Organic olives and olive oils, organic dried fruit. Sales at the workshop every day from 3pm in Buis, ch du Col d'Os. Bboutique atelier Biolive : 4, r. Grenette 05000 Gap. Markets: Tuesday in Vaison, Wednesday in Buis, Friday in Carpentras and Saturday in Gap."
    ],
    "it": [
      "Olive e oli di oliva biologici, frutta secca biologica. Vendita presso l'atelier tutti i giorni dalle 15.00 a Buis, ch du Col d'Os. Officina Biolive: 4, r. Grenette 05000 Gap. Mercati: martedì a Vaison, mercoledì a Buis, venerdì a Carpentras e sabato a Gap."
    ],
    "fr": [
      "Olives et huiles d’olive Bio, fruits secs bio. Vente à l’atelier tous les jours à partir de 15h à Buis, ch du Col d'Os. Bboutique atelier Biolive : 4, r. Grenette 05000 Gap. Marchés : mardi à Vaison, mercredi à Buis, vendredi à Carpentras et samedi à Gap."
    ],
    "nl": [
      "Biologische olijven en olijfolie, biologisch gedroogd fruit. Verkoop in het atelier elke dag vanaf 15u in Buis, ch du Col d'Os. Biolive werkplaats winkel: 4, r. Grenette 05000 Gap. Markten: dinsdag in Vaison, woensdag in Buis, vrijdag in Carpentras en zaterdag in Gap."
    ],
    "es": [
      "Aceitunas y aceites de oliva ecológicos, frutos secos ecológicos. Venta en el taller todos los días a partir de las 15 horas en Buis, ch du Col d'Os. Taller Biolive: 4, r. Grenette 05000 Gap. Mercados: martes en Vaison, miércoles en Buis, viernes en Carpentras y sábado en Gap."
    ]
  },
