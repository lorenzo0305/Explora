  "rdfs:comment": {
    "de": [
      "Kurse Yoga, Klänge und Lebenskunst\r\nSynthese verschiedener Yogarichtungen (iranisch-ägyptischer Yoga/Hatha Yoga) und Yoga des Klangs.\r\nKunst der wohlwollenden Berührung\r\nRegeneration der Leber/Gallenblase\r\nNaturheilkunde"
    ],
    "en": [
      "Yoga, Sound and the Art of Living classes\r\nSynthesis of different currents of Yoga (Iranian-Egyptian Yoga/Hatha Yoga) and Yoga of sound\r\nThe art of gentle touch\r\nLiver and gallbladder regeneration\r\nNaturopathy"
    ],
    "it": [
      "Corso di Yoga, suono e arte di vivere\r\nSintesi di diverse correnti dello Yoga (Yoga iranico-egiziano/Hatha Yoga) e dello Yoga del Suono\r\nL'arte di toccare con amore\r\nRigenerazione del fegato e della cistifellea\r\nNaturopatia"
    ],
    "fr": [
      "Cours Yoga, Sons et Art de vivre\r\nSynthèse de différents courants de Yoga (Yoga irano-Egyptien/Hatha Yoga) et Yoga du son\r\nArt du toucher bienveillant\r\nRégénération du foie / vésicule biliaire\r\nNaturopathie"
    ],
    "nl": [
      "Yoga, klank en levenskunst lessen\r\nSynthese van verschillende stromingen in Yoga (Iraans-Egyptische Yoga/Hatha Yoga) en Yoga van geluid\r\nDe kunst van zachte aanraking\r\nRegeneratie van lever en galblaas\r\nNatuurgeneeskunde"
    ],
    "es": [
      "Curso de Yoga, Sonido y el Arte de Vivir\r\nSíntesis de diferentes corrientes de Yoga (Yoga Iraní-Egipcio/Hatha Yoga) y Yoga del Sonido\r\nEl arte del tacto amoroso\r\nRegeneración del hígado/vesícula biliar\r\nNaturopatía"
    ]
  },
