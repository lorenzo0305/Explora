  "rdfs:comment": {
    "de": [
      "Das Restaurant CASA NONNA bietet in einem Lifestyle-Rahmen mit einer Terrasse mit Mont-Blanc-Blick eine transalpine Küche, in der frische Saisonprodukte bevorzugt werden."
    ],
    "en": [
      "The CASA NONNA restaurant offers transalpine cuisine with a focus on fresh seasonal produce, in a lifestyle setting with a terrace overlooking Mont Blanc."
    ],
    "it": [
      "Il ristorante CASA NONNA offre una cucina transalpina a base di prodotti freschi di stagione in un ambiente lifestyle con una terrazza affacciata sul Monte Bianco."
    ],
    "fr": [
      "Le restaurant CASA NONNA propose, dans un cadre lifestyle avec une terrasse vue Mont-Blanc, une cuisine transalpine qui privilégie des produits frais de saison."
    ],
    "nl": [
      "Het restaurant CASA NONNA serveert transalpine gerechten met verse seizoensproducten in een lifestyle omgeving met een terras met uitzicht op de Mont Blanc."
    ],
    "es": [
      "El restaurante CASA NONNA ofrece cocina transalpina a base de productos frescos de temporada en un marco de estilo de vida con terraza con vistas al Mont Blanc."
    ]
  },
