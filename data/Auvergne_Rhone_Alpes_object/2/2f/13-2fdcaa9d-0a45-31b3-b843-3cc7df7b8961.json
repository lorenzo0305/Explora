  "rdfs:comment": {
    "de": [
      "Verkauf große Auswahl an Käse und Milchprodukten:\r\nComté, Morbier, Raclette, Rohrahm von Balanod und Herstellung von For-Käse\r\nFrischkäse mit Knoblauch und Kräutern, Ziegenkäse aus der Region, Formen von Quark und Herstellung von getrüffeltem Brie."
    ],
    "en": [
      "Sale of a wide range of cheeses and dairy products:\r\nComté, morbier, raclette, raw cream from Balanod and cheese making for\r\nFresh cheese with garlic and herbs, local goat cheese, cottage cheese and truffled brie."
    ],
    "it": [
      "Vendita di un'ampia gamma di formaggi e prodotti caseari:\r\nComté, morbier, raclette, panna cruda di Balanod e produzione di formaggio per\r\nFormaggio fresco con aglio ed erbe, formaggio di capra locale, ricotta e brie tartufato."
    ],
    "fr": [
      "Vente large choix de fromages et produits laitiers :\r\nComté, morbier, raclette, crème crue de Balanod et fabrication de fromage for\r\nFromage frais ail et fines herbes, fromages de chèvres locaux, moulage de fromage blanc et fabrication brie truffé."
    ],
    "nl": [
      "Verkoop van een breed assortiment kazen en zuivelproducten:\r\nComté, morbier, raclette, rauwe room van Balanod en kaasmaken voor\r\nVerse kaas met knoflook en kruiden, lokale geitenkaas, kwark en truffelbrie."
    ],
    "es": [
      "Venta de una amplia gama de quesos y productos lácteos:\r\nComté, morbier, raclette, crema cruda de Balanod y elaboración de quesos para\r\nQueso fresco con ajo y hierbas, queso de cabra local, requesón y brie trufado."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Boutique à Fromages"
    ],
    "fr": [
      "La Boutique à Fromages"
    ]
  },
