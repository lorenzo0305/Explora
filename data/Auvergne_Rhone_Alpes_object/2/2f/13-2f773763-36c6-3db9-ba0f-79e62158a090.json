  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren Lehmbauernhof gegenüber dem Vercors-Gebirge, in der Nähe des mittelalterlichen Dorfes Saint-Antoine-l'Abbaye, einem der schönsten Dörfer Frankreichs, vor den Toren des Chambaran-Parks. Eine atemberaubende ländliche Umgebung!"
    ],
    "en": [
      "Discover our adobe farmhouse facing the Vercors, near the medieval village of Saint-Antoine-l'Abbaye, one of France's most beautiful villages, at the gateway to the Chambaran Park. A breathtaking country setting!"
    ],
    "it": [
      "Scoprite il nostro casale in adobe, affacciato sul Vercors, vicino al villaggio medievale di Saint-Antoine-l'Abbaye, uno dei più bei villaggi di Francia, alle porte del Parco dello Chambaran. Un ambiente di campagna mozzafiato!"
    ],
    "fr": [
      "Découvrez notre ferme en pisé, face au Vercors, près du village médiéval de Saint-Antoine-l'Abbaye, un des plus beaux villages de France, aux portes du Parc des Chambaran. Un cadre campagnard époustouflant !"
    ],
    "nl": [
      "Ontdek onze adobe boerderij, tegenover de Vercors, vlakbij het middeleeuwse dorp Saint-Antoine-l'Abbaye, een van de mooiste dorpen van Frankrijk, aan de poort van het Chambaran Park. Een adembenemende landelijke omgeving!"
    ],
    "es": [
      "Descubra nuestra granja de adobe, frente al Vercors, cerca del pueblo medieval de Saint-Antoine-l'Abbaye, uno de los pueblos más bonitos de Francia, a las puertas del Parque de Chambaran. ¡Un entorno campestre impresionante!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La ferme de la Grange du Haut"
    ]
  },
