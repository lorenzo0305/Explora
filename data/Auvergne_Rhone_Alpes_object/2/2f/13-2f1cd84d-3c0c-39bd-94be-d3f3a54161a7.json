  "rdfs:comment": {
    "de": [
      "Käse von Kühen und Ziegen, die mit Heu gefüttert werden. Sie können unsere Produkte auf dem Markt in Chazelles sur Lyon am Dienstag- und Freitagmorgen oder auf dem Bauernhof finden."
    ],
    "en": [
      "Cheeses from cows and goats fed on hay. You can find our products on the market of Chazelles sur Lyon on Tuesday and Friday morning or at the farm."
    ],
    "it": [
      "Formaggi di mucche e capre alimentate a fieno. Potete trovare i nostri prodotti al mercato di Chazelles sur Lyon il martedì e il venerdì mattina o presso la fattoria."
    ],
    "fr": [
      "Fromages de vaches et chèvres nourries au foin. Vous pouvez trouver nos produits sur le marché de Chazelles sur Lyon le mardi et vendredi matin ou à la ferme."
    ],
    "es": [
      "Quesos de vacas y cabras alimentadas con heno. Puede encontrar nuestros productos en el mercado de Chazelles sur Lyon los martes y viernes por la mañana o en la granja."
    ],
    "nl": [
      "Kaas van koeien en geiten gevoed met hooi. U kunt onze producten vinden op de markt van Chazelles sur Lyon op dinsdag- en vrijdagochtend of op de boerderij."
    ]
  },
