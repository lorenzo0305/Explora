  "rdfs:comment": {
    "de": [
      "Frische, lokale und saisonale Küche! Das Restaurant bietet eine großzügige französische Küche mit regionalen Akzenten. Lassen Sie sich auf der schattigen, gemütlichen und einladenden Terrasse nieder. Vegetarische Gerichte erhältlich und Wi-Fi-Anschluss vor Ort."
    ],
    "en": [
      "Fresh, local and seasonal cuisine! The restaurant offers generous French cuisine with local accents. Relax on the shady, cosy and welcoming terrace. Vegetarian dishes available and Wi-Fi connection on site."
    ],
    "it": [
      "Cucina fresca, locale e di stagione! Il ristorante offre una generosa cucina francese con un accento locale. Rilassatevi sull'accogliente terrazza ombreggiata. Sono disponibili piatti vegetariani e connessione Wi-Fi in loco."
    ],
    "fr": [
      "Cuisine fraîche, locale et de saison ! Le restaurant propose une cuisine française généreuse aux accents du terroir. Installez-vous sur la terrasse ombragée, cosy et accueillante. Plats végétariens disponibles et connexion Wi-Fi sur place."
    ],
    "nl": [
      "Verse, lokale en seizoensgebonden gerechten! Het restaurant biedt een royale Franse keuken met een lokaal accent. Ontspan op het gezellige, schaduwrijke terras. Vegetarische gerechten beschikbaar en Wi-Fi-verbinding ter plaatse."
    ],
    "es": [
      "Cocina fresca, local y de temporada El restaurante ofrece una generosa cocina francesa con acento local. Relájese en la acogedora terraza a la sombra. Platos vegetarianos disponibles y conexión Wi-Fi in situ."
    ]
  },
