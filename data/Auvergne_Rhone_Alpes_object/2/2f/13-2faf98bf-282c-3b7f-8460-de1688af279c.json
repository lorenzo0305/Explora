  "rdfs:comment": {
    "de": [
      "Das Rubinschloss - Observatorium der Alpen bietet das ganze Jahr über eine moderne, spielerische und interaktive Ausstellung zum Thema \"Berge mit einem großen M\"."
    ],
    "en": [
      "After two years of massive works, the Château des Rubins has become the Observatoire des Alpes (Alps Observatory). All year round, a modern, fun and interactive exhibition is available for the whole family to visit on the theme of Mountains with a capital M."
    ],
    "it": [
      "Dopo due anni di lavori monumentali, Château des Rubins è diventato Observatoire des Alpes. Propone un'esposizione moderna, ludica e interattiva a tutta la famiglia, tutto l'anno, basata sul tema della montagna con un grande M."
    ],
    "fr": [
      "Le château des Rubins - Observatoire des Alpes propose toute l’année une exposition moderne, ludique et interactive sur le thème de la montagne avec un grand M."
    ],
    "nl": [
      "Het hele jaar door biedt het Château des Rubins - Observatoire des Alpes een moderne, leuke en interactieve tentoonstelling over het thema bergen met een hoofdletter M."
    ],
    "es": [
      "Durante todo el año, el Château des Rubins - Observatoire des Alpes ofrece una exposición moderna, lúdica e interactiva sobre el tema de la montaña con mayúsculas."
    ]
  },
