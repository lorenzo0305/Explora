  "rdfs:comment": {
    "de": [
      "Immensité Nature bietet Ihnen Ausflüge in die Höhlenforschung und zum Canyoning an, egal ob Sie diese Aktivitäten zum ersten Mal entdecken wollen oder ob Ihre erste Einführung schon lange hinter Ihnen liegt!"
    ],
    "en": [
      "Immensité Nature provides caving and canyoning trips whether you are discovering these activities for the first time, or your first initiation is already far behind you!"
    ],
    "it": [
      "Mi chiamo Jean-Baptiste e sono un istruttore qualificato di speleologia e canyoning. Vivo nel massiccio del Vercors e conduco escursioni di speleologia tutto l'anno e di canyoning tra aprile e ottobre, per tutti i livelli."
    ],
    "fr": [
      "Je suis Jean-Baptiste et suis moniteur diplômé d'état de Spéléo et de Canyoning. J'habite sur le massif du Vercors et j'encadre des sorties spéléo toute l'année et en canyoning entre avril et octobre, pour tous les niveaux."
    ],
    "nl": [
      "Mijn naam is Jean-Baptiste en ik ben een gediplomeerd speleologie- en canyoninginstructeur. Ik woon in het Vercors-massief en leid het hele jaar door speleologie-excursies en canyoning-excursies tussen april en oktober, voor alle niveaus."
    ],
    "es": [
      "Me llamo Jean-Baptiste y soy monitor titulado de espeleología y barranquismo. Vivo en el macizo del Vercors y organizo salidas de espeleología todo el año y de barranquismo entre abril y octubre, para todos los niveles."
    ]
  },
  "rdfs:label": {
    "de": [
