  "rdfs:comment": {
    "de": [
      "Außerhalb der Gottesdienste frei zugänglich. Überreste des Karmeliterklosters, das 1352 von Pierre I. de Bourbon gegründet wurde.\r\nISMH. Im Laufe der Jahrhunderte wurde es zahlreichen Umgestaltungen unterzogen."
    ],
    "en": [
      "Free access outside of services. Remains of the Carmelite convent founded in 1352 by Pierre I of Bourbon.\r\nISMH. It has undergone many changes over the centuries."
    ],
    "it": [
      "Accesso libero al di fuori dei servizi. Resti del convento carmelitano fondato nel 1352 da Pietro I di Borbone.\r\nISMH. Ha subito molti cambiamenti nel corso dei secoli."
    ],
    "fr": [
      "Accès libre en dehors des offices. Reste du couvent des Carmes fondé en 1352 par Pierre Ier de Bourbon. \r\nISMH. Elle subit nombre de réaménagements au fil des siècles."
    ],
    "nl": [
      "Vrije toegang buiten de diensten. Overblijfselen van het karmelietenklooster gesticht in 1352 door Peter I van Bourbon.\r\nISMH. Het heeft door de eeuwen heen veel veranderingen ondergaan."
    ],
    "es": [
      "Acceso libre fuera de los servicios. Restos del convento carmelita fundado en 1352 por Pedro I de Borbón.\r\nISMH. Ha sufrido muchos cambios a lo largo de los siglos."
    ]
  },
