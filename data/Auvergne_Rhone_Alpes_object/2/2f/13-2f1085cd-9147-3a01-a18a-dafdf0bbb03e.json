  "rdfs:comment": {
    "de": [
      "Der Lac des Cerces bietet Ihnen eine wunderschöne Aussicht und einen herrlichen Sonnenuntergang über den Aiguilles d'Arves, für ein recht technisches Angeln."
    ],
    "en": [
      "The lake of Cerces offers you a magnificent view and a splendid sunset on the Aiguilles d'Arves, for a rather technical fishing."
    ],
    "it": [
      "Il lago Cerces offre una magnifica vista e uno splendido tramonto sulle Aiguilles d'Arves, per una pesca piuttosto tecnica."
    ],
    "fr": [
      "Le lac des Cerces vous offre une magnifique vue et un splendide coucher de soleil sur les Aiguilles d'Arves, pour une pêche assez technique."
    ],
    "nl": [
      "Het meer van Cerces biedt een prachtig uitzicht en een schitterende zonsondergang op de Aiguilles d'Arves, voor een nogal technische visserij."
    ],
    "es": [
      "El lago de Cerces ofrece una magnífica vista y una espléndida puesta de sol sobre las Aiguilles d'Arves, para una pesca más bien técnica."
    ]
  },
