  "rdfs:comment": {
    "de": [
      "Im Herzen des Meygal-Massivs, mitten im Wald, sehr schöne, typische Auberge, ideal für Hochzeiten, Geburtstage, Feste usw. Gepflegte, authentische und delikate Küche; Produkte aus der Region."
    ],
    "en": [
      "In the heart of the Meygal Massif, in the middle of the forest, very beautiful typical inn, ideal for weddings, birthdays, parties etc... Careful, authentic and delicate cuisine; local products."
    ],
    "it": [
      "Nel cuore del massiccio del Meygal, in mezzo alla foresta, una bellissima locanda tipica, ideale per matrimoni, compleanni, feste ecc... Cucina curata, autentica e delicata; prodotti locali."
    ],
    "fr": [
      "Au coeur du massif du Meygal, en pleine forêt, très belle auberge typique, idéale pour mariages, anniversaires, fêtes etc...Cuisine soignée, authentique et délicate ; produits du terroir."
    ],
    "nl": [
      "In het hart van het Meygal-massief, midden in het bos, een zeer mooie typische herberg, ideaal voor bruiloften, verjaardagen, feesten enz... Zorgvuldige, authentieke en delicate keuken; lokale producten."
    ],
    "es": [
      "En el corazón del macizo de Meygal, en medio del bosque, una posada típica muy bonita, ideal para bodas, cumpleaños, fiestas, etc. Cocina cuidada, auténtica y delicada; productos locales."
    ]
  },
  "rdfs:label": {
