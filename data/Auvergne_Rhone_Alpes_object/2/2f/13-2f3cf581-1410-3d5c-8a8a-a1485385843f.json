  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant mit traditioneller Küche in 500 m Entfernung vom TGV-Bahnhof St Étienne Châteaucreux Vorspeisenbuffet und hausgemachte Desserts!  Tagesgerichte. In einem hell erleuchteten und klimatisierten Gastraum."
    ],
    "en": [
      "Come and discover our traditional cuisine, only 500 m from St Étienne Châteaucreux TGV train station. An all-you-can-eat buffet of hors d'oeuvres and homemade desserts awaits you, along with dishes of the day, in a bright and air-conditioned room."
    ],
    "it": [
      "A 500 m dalla stazione TGV St Etienne Châteaucreux, venite a scoprire la nostra cucina tradizionale. Buffet di antipasti e dolci fatti in casa a volontà! Piatti del giorno, il tutto in una sala luminosa e climatizzata."
    ],
    "fr": [
      "A 500 m de la gare TGV St Etienne Châteaucreux, venez découvrir notre cuisine traditionnelle. Buffet de hors d'oeuvre et de dessert maison à volonté ! Plats du jour, le tout dans une salle lumineuse et climatisée."
    ],
    "nl": [
      "Op 500 m van het TGV-station St Etienne Châteaucreux kunt u onze traditionele keuken ontdekken. Buffet van hors d'oeuvres en huisgemaakte desserts naar believen! Gerechten van de dag, allemaal in een lichte ruimte met airconditioning."
    ],
    "es": [
      "A 500 m de la estación de TGV St Etienne Châteaucreux, venga a descubrir nuestra cocina tradicional. Buffet de entremeses y postres caseros a voluntad Platos del día, todo ello en una sala luminosa y climatizada."
    ]
  },
