  "rdfs:comment": {
    "de": [
      "CrazySchool bietet kulturelle und sensorische Spielparcours für alle Altersgruppen: Familien, Freundesgruppen, Freizeitzentren, Schulen, Vereine, Unternehmen und besondere Anlässe: Junggesell*innenabschiede, Teambuilding, Seminare uvm."
    ],
    "en": [
      "CrazySchool offers cultural and sensory game trails suitable for all: families, groups of friends, leisure centres, schools, associations, companies and special events (hen/bachelor parties, team-building, conferences, etc.)"
    ],
    "it": [
      "CrazySchool offre giochi culturali e sensoriali per tutti i tipi di pubblico: famiglie, gruppi di amici, centri ricreativi, scuole, associazioni, aziende ed eventi speciali: EVJF, team-building, seminari, ecc."
    ],
    "fr": [
      "CrazySchool propose des parcours de jeux culturels et sensoriels destinés à tous les publics : familles, groupes d’ami(e)s, centres de loisirs, scolaires, associations, entreprises et événements spéciaux : EVJF, team-building, séminaire…"
    ],
    "es": [
