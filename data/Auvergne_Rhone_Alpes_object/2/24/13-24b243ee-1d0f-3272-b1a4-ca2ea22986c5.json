  "rdfs:comment": {
    "de": [
      "Genießen Sie eine große Auswahl an Fleisch vom Holzkohlegrill oder von der Plancha, dazu Gemüse und Pommes frites , leckere Tapas und hausgemachte Desserts.\r\nGroße Auswahl an Weinen und Bieren."
    ],
    "en": [
      "Enjoy a wide selection of wood-grilled or plancha-cooked meats, accompanied by vegetables and French fries, tasty tapas and homemade desserts.\r\nWide choice of wines and beers."
    ],
    "it": [
      "Gustate un'ampia selezione di carni alla griglia su fuoco di legna o cucinate a la plancha, accompagnate da verdure e patatine, gustose tapas e dolci fatti in casa.\r\nAmpia scelta di vini e birre."
    ],
    "fr": [
      "Dégustez une large sélection de viandes grillées au feu de bois ou cuites à la plancha, accompagnés de légumes et frites , des tapas savoureuses, et des desserts faits maison.\r\nLarge choix de vins et de bières."
    ],
    "nl": [
      "Geniet van een uitgebreide selectie vlees gegrild op houtvuur of bereid a la plancha, vergezeld van groenten en friet, smakelijke tapas en huisgemaakte desserts.\r\nRuime keuze aan wijnen en bieren."
    ],
    "es": [
      "Disfrute de una amplia selección de carnes a la brasa de leña o cocinadas a la plancha, acompañadas de verduras y patatas fritas, sabrosas tapas y postres caseros.\r\nAmplia selección de vinos y cervezas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Repère"
    ]
  },
