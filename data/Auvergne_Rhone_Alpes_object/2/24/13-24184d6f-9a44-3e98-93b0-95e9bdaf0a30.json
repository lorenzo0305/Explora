  "rdfs:comment": {
    "de": [
      "Dieses historische Gebäude ist ein Ort der Ausstellung, der Arbeit und der Begegnung...\r\nHier spielt sich das tägliche Leben des Künstlerkollektivs ab, die Tür steht der Öffentlichkeit weit offen."
    ],
    "en": [
      "This historic building is a place to exhibit, work and meet...\r\nThis is where the daily life of the artists' collective takes place, and the door is wide open to the public."
    ],
    "it": [
      "Questo edificio storico è un luogo di mostre, lavoro e incontri...\r\nQui si svolge la vita quotidiana del collettivo di artisti e la porta è spalancata al pubblico."
    ],
    "fr": [
      "Ce bâtiment historique est un lieu d'exposition, de travail et de rencontre...\r\nIci se déroule la vie quotidienne du collectif d’artistes, la porte est grande ouverte au public."
    ],
    "es": [
      "Este edificio histórico es un lugar de exposiciones, trabajo y reuniones...\r\nAquí se desarrolla la vida cotidiana del colectivo de artistas, y la puerta está abierta de par en par al público."
    ],
    "nl": [
      "Dit historische gebouw is een plek voor tentoonstellingen, werk en ontmoetingen...\r\nHier vindt het dagelijks leven van het kunstenaarscollectief plaats en de deur staat wijd open voor het publiek."
    ]
  },
