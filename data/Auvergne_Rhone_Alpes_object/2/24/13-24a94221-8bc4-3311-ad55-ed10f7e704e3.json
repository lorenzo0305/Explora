  "rdfs:comment": {
    "de": [
      "Der junge Küchenchef bietet Ihnen eine moderne und kreative Küche. Frische und saisonale Produkte sind bei einer monatlich wechselnden Speisekarte garantiert."
    ],
    "en": [
      "The young chef offers modern, creative cuisine. Fresh, seasonal produce is guaranteed, with a menu that changes every month."
    ],
    "it": [
      "Il giovane chef propone una cucina moderna e creativa. Prodotti freschi e di stagione sono garantiti con un menu che cambia ogni mese."
    ],
    "fr": [
      "Le jeune chef vous propose une cuisine moderne et créative. Produits frais et de saison sont garantis avec une carte qui change tous les mois."
    ],
    "es": [
      "El joven chef ofrece una cocina moderna y creativa. Los productos frescos y de temporada están garantizados con un menú que cambia cada mes."
    ],
    "nl": [
      "De jonge chef biedt een moderne, creatieve keuken. Verse, seizoensgebonden producten zijn gegarandeerd met een menu dat elke maand verandert."
    ]
  },
