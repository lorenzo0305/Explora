  "rdfs:comment": {
    "de": [
      "Chantournage und Drechseln auf Holz die Kunst oder die Kunst und die Art und Weise, ein einfaches Stück Holz zu verschönern. Kommen Sie in mein Atelier, um sich auszutauschen, zu teilen und sich selbst eine Freude zu machen! Einführungskurse in Holzdrechseln und Laubsägearbeiten sind möglich."
    ],
    "en": [
      "Fretwork and woodturning - the art of making a simple piece of wood beautiful. Come and share, exchange and enjoy. I can offer you woodturning and fretwork introductory classes."
    ],
    "it": [
      "Chantournage e tornitura - l'arte di abbellire un semplice pezzo di legno. Venite nel mio laboratorio per chiacchierare, condividere e divertirvi! Sono disponibili corsi introduttivi di tornitura e chantournage."
    ],
    "fr": [
      "Chantournage et tournage sur bois l'art ou l'art et la manière d'embellir un simple morceau de bois. Venez dans mon atelier pour échanger, partager et vous faire plaisir ! Cours d'initiation possibles au tournage sur bois et au chantournage."
    ],
    "es": [
      "Chantournage y torneado de madera - el arte de embellecer una simple pieza de madera. Venga a mi taller a charlar, compartir y disfrutar Se imparten cursos de iniciación al torneado de madera y al chantournage."
    ],
    "nl": [
      "Chantournage en houtdraaien - de kunst van het verfraaien van een eenvoudig stuk hout. Kom naar mijn werkplaats om te kletsen, te delen en te genieten! Inleidende cursussen houtdraaien en chantournage zijn beschikbaar."
    ]
  },
