  "rdfs:comment": {
    "de": [
      "Bei Pizza Bella werden unsere Nudeln hausgemacht und von Hand ausgerollt. Verwöhnen Sie Ihren Gaumen mit Pizzas, Salaten und Lasagne. Einfache Rezepte, die von Liebhabern der traditionellen Küche mit Liebe zubereitet werden."
    ],
    "en": [
      "At Pizza Bella our pasta is homemade and hand rolled. Come and treat your taste buds to pizzas, salads and lasagna. Simple recipes made with love by people who are passionate about traditional cooking."
    ],
    "it": [
      "Da Pizza Bella la nostra pasta è fatta in casa e stesa a mano. Venite a deliziare il vostro palato con pizze, insalate e lasagne. Ricette semplici realizzate con amore da persone appassionate di cucina tradizionale."
    ],
    "fr": [
      "Chez Pizza Bella nos pâtes sont faites maison et étalées à la main. Venez régaler vos papilles, avec des pizzas, des salades et des lasagnes. Des recettes simples et faites avec amour par des passionnés de la cuisine traditionnelle."
    ],
    "es": [
      "En Pizza Bella nuestra pasta es casera y se extiende a mano. Venga y deleite su paladar con pizzas, ensaladas y lasañas. Recetas sencillas hechas con amor por personas apasionadas por la cocina tradicional."
    ],
    "nl": [
      "Bij Pizza Bella wordt onze pasta zelfgemaakt en met de hand gesmeerd. Kom uw smaakpapillen verwennen met pizza's, salades en lasagne. Eenvoudige recepten met liefde gemaakt door mensen met een passie voor de traditionele keuken."
    ]
  },
