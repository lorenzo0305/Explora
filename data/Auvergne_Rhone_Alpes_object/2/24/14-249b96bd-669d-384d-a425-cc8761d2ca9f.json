  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7fb0f29d-2ac7-3fac-96b0-cb740e344857",
      "dc:description": {
        "de": [
          "Produkte des Bauernhofs aus der Entenzucht: Foie gras, Confits, Rillettes, Entenbrust und -schenkel sowie aus der Rind- und Schweinezucht: Fleisch in Kisten und Wurstwaren."
        ],
        "en": [
          "Farm products from duck breeding: foie gras, confits, rillettes, duck breasts and legs and beef and pork breeding: boxed meat and charcuterie."
        ],
        "it": [
          "Prodotti dell'allevamento di anatre: foie gras, confit, rillettes, petto e cosce d'anatra e dell'allevamento di bovini e suini: carne in scatola e salumi."
        ],
        "fr": [
          "Produits de la ferme issus de l'élevage de canards : foie gras, confits, rillettes, magrets et cuisses et l'élevage de boeuf et porc : viande en caissette et charcuterie."
        ],
        "es": [
          "Productos de la granja de patos: foie gras, confits, rillettes, pechuga y muslos de pato y de la granja de vacuno y cerdo: carne en cajas y charcutería."
        ],
        "nl": [
          "Producten van de eendenboerderij: foie gras, confits, rillettes, eendenborst en -bouten en de rund- en varkensboerderij: vlees in dozen en vleeswaren."
        ]
      },
