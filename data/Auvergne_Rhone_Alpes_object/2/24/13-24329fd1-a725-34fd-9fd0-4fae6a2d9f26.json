  "rdfs:comment": {
    "de": [
      "Das authentische Dorf Châtel liegt im Herzen der Portes du Soleil im wunderschönen Tal von Abondance und lädt Sie ein, das Hotel-Restaurant Macchi zu entdecken."
    ],
    "en": [
      "Located in the heart of Portes du Soleil, in the wonderful Abondance valley, Châtel, authentic village invites you to discover the MACCHI Hotel and Le Cerf Restaurant."
    ],
    "it": [
      "Situato nel cuore delle Portes du Soleil, nella magnifica Valle dell'Abondance, Châtel, un autentico villaggio, vi invita a scoprire l'Hotel-Restaurant Macchi."
    ],
    "fr": [
      "Situé au cœur des Portes du Soleil, dans la magnifique vallée d’Abondance, Châtel, village authentique vous invite à découvrir l’Hôtel-restaurant Macchi."
    ],
    "es": [
      "Situado en el corazón de Portes du Soleil, en el magnífico valle de Abondance, Châtel, un pueblo auténtico, le invita a descubrir el Hotel-Restaurante Macchi."
    ],
    "nl": [
      "In het hart van de Portes du Soleil, in de prachtige Abondance-vallei, nodigt Châtel, een authentiek dorp, u uit om Hôtel-restaurant Macchi te ontdekken."
    ]
  },
