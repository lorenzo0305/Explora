  "rdfs:comment": {
    "de": [
      "La Table du M Lodge bietet einzigartige Räume für Geselligkeit in Saint-Martin-de-Belleville rund um 4 Essensangebote, vom Frühstück über das Gourmet-Abendessen bis hin zu Snacks und einem raffinierten Tapas-Service."
    ],
    "en": [
      "La Table du M Lodge offers unique conviviality in Saint-Martin-de-Belleville, with 4 catering services, from breakfast to gourmet dinner, including snacks and a refined tapas service."
    ],
    "it": [
      "La Table du M Lodge offre un'esperienza culinaria unica a Saint-Martin-de-Belleville, con 4 servizi di ristorazione, dalla colazione alla cena gourmet, passando per il tè pomeridiano e un raffinato servizio di tapas."
    ],
    "fr": [
      "La Table du M Lodge offre des espaces de convivialité uniques à Saint-Martin-de-Belleville autour de 4 services de restauration, du petit-déjeuner au dîner gastronomique, en passant par le goûter et un service  de tapas raffinés."
    ],
    "es": [
      "La Table du M Lodge ofrece una experiencia gastronómica única en Saint-Martin-de-Belleville, con 4 servicios de restauración, desde el desayuno hasta la cena gourmet, pasando por el té de la tarde y un refinado servicio de tapas."
    ],
    "nl": [
      "La Table du M Lodge biedt een unieke dinerervaring in Saint-Martin-de-Belleville, met 4 restaurants, van ontbijt tot gastronomisch diner, inclusief afternoon tea en een verfijnde tapasservice."
    ]
  },
