  "rdfs:comment": {
    "de": [
      "Jh., Renaissance-Chor mit einem denkmalgeschützten Holzaltar aus dem 17. Jh., von CHABRY (1660-1727). Die Kirche wurde 2007 restauriert."
    ],
    "en": [
      "Nave dating from the 19th century, Renaissance choir with a 17th century listed wooden altarpiece by CHABRY (1660-1727). The church was restored in 2007 ."
    ],
    "it": [
      "La navata risale al XIX secolo, il coro al Rinascimento con una pala d'altare lignea del XVII secolo, opera di CHABRY (1660-1727). La chiesa è stata restaurata nel 2007."
    ],
    "fr": [
      "Nef datant du XIXe siècle, choeur renaissance avec un retable en bois classé du XVIIeme siècle., de CHABRY (1660-1727). L'église a été restaurée en 2007 ."
    ],
    "es": [
      "La nave data del siglo XIX, el coro del Renacimiento con un retablo de madera catalogado del siglo XVII de CHABRY (1660-1727). La iglesia fue restaurada en 2007."
    ],
    "nl": [
      "Het schip dateert uit de 19e eeuw, het koor uit de Renaissance met een beschermd houten altaarstuk uit de 17e eeuw van CHABRY (1660-1727). De kerk werd gerestaureerd in 2007."
    ]
  },
