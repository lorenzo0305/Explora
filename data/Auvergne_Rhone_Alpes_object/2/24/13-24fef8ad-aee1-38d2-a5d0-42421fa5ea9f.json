  "rdfs:comment": {
    "de": [
      "Am Rande der Dombes, an einem geselligen Ort, entdecken Sie eine marktfrische Küche im Wechsel der Jahreszeiten. Démarche saveurs de l'Ain.\r\nGroße schattige Terrasse mit Pflanzen, Privatparkplatz, ideal für Empfänge.\r\nBankette \"nach Maß\"."
    ],
    "en": [
      "French speciality. Terrace. Private car park."
    ],
    "it": [
      "Alle porte delle Dombes, in un ambiente accogliente, scoprite una cucina di mercato in sintonia con le stagioni. Marchio \"Saveurs de l'Ain\".\r\nGrande terrazza ombreggiata con piante, parcheggio privato, ideale per ricevimenti.\r\nBanchetti su misura."
    ],
    "fr": [
      "Aux portes de la Dombes, dans un lieu convivial, découvrez une cuisine du marché au fil des saisons. Démarche \"Saveurs de l'Ain\".\r\nGrande terrasse végétale ombragée, parking privé, idéal pour réception.\r\nBanquets \"sur mesure\"."
    ],
    "nl": [
      "Aan de poort van de Dombes, in een gezellig kader, ontdek de marktkeuken afgestemd op de seizoenen. Label \"Saveurs de l'Ain\".\r\nGroot schaduwrijk terras met planten, privéparking, ideaal voor recepties.\r\nBanketten op maat."
    ],
    "es": [
      "A las puertas de las Dombes, en un marco acogedor, descubra una cocina de mercado en sintonía con las estaciones. Etiqueta \"Saveurs de l'Ain\".\r\nGran terraza sombreada con plantas, aparcamiento privado, ideal para recepciones.\r\nBanquetes a medida."
    ]
  },
  "rdfs:label": {
    "de": [
      "Gasthaus von Thil"
    ],
    "en": [
      "Auberge de Thil"
    ],
