  "rdfs:comment": {
    "de": [
      "Restaurant mit Terrasse im Herzen von La Côte-St-André, nur wenige Schritte von der Kirche entfernt, in der typischen Umgebung einer ehemaligen Ölfabrik.\r\nPizzas aus dem Holzofen, traditionelle Küche à la carte und Mittagsmenüs."
    ],
    "en": [
      "This restaurant offers pizzas cooked on an open fire as well as traditional dishes - set menus or a la carte."
    ],
    "it": [
      "Ristorante con terrazza nel cuore di La Côte-St-André, a due passi dalla chiesa, nella tipica cornice di un vecchio oleificio.\r\nPizze cotte a legna, cucina tradizionale à la carte e menù a pranzo."
    ],
    "fr": [
      "Restaurant avec terrasse au cœur de la Côte-St-André, à deux pas de l'église, dans le cadre typique d'une ancienne fabrique d'huile.\r\nPizzas au feu de bois, cuisine traditionnelle à la carte et menus le midi."
    ],
    "es": [
      "Restaurante con terraza en el corazón de La Côte-St-André, a dos pasos de la iglesia, en el entorno típico de una antigua fábrica de aceite.\r\nPizzas al horno de leña, cocina tradicional a la carta y menús de mediodía."
    ],
    "nl": [
      "Restaurant met terras in het hart van Côte-St-André, op een steenworp afstand van de kerk, in het typische decor van een oude oliefabriek.\r\nHoutgestookte pizza's, traditionele keuken à la carte en lunchmenu's."
    ]
  },
