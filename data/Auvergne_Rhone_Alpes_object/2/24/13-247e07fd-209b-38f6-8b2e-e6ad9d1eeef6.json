  "rdfs:comment": {
    "de": [
      "Etwa 1500 Bücher (Romane, Sachbücher, Comics) und einige Zeitschriften (Geo, L'Ami des Jardins) stehen Ihnen ständig zur Verfügung.\r\nEs werden regelmäßig neue Bücher gekauft"
    ],
    "en": [
      "Around 1,500 books (novels, non-fiction, comics) and a number of magazines (Géo, L'Ami des Jardins) are permanently on offer.\r\nWe regularly purchase new books"
    ],
    "it": [
      "Circa 1.500 libri (romanzi, saggistica, fumetti) e alcune riviste (Géo, L'Ami des Jardins) sono in esposizione permanente.\r\nI libri recenti vengono acquistati regolarmente"
    ],
    "fr": [
      "Environ 1500 ouvrages (romans, documentaires, BD) ainsi que quelques revues (Géo, l’Ami des Jardins) vous sont proposés en permanence.\r\nDes achats réguliers d’ouvrages récents sont effectués"
    ],
    "es": [
      "Se exponen permanentemente unos 1.500 libros (novelas, no ficción, cómics) y varias revistas (Géo, L'Ami des Jardins).\r\nPeriódicamente se adquieren libros recientes"
    ],
    "nl": [
      "Ongeveer 1500 boeken (romans, non-fictie, strips) en een aantal tijdschriften (Géo, L'Ami des Jardins) worden permanent tentoongesteld.\r\nEr worden regelmatig recente boeken aangekocht"
    ]
  },
