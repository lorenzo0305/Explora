  "rdfs:comment": {
    "de": [
      "Erkunden Sie die Berge mit einem Elektro- oder Downhill-Mountainbike für Erwachsene, Jugendliche und Kinder; je nach Niveau oder Lust und unter fachkundiger Anleitung eines Lehrers!"
    ],
    "en": [
      "Explore the mountain on an electric mountain bike or downhill for adults, teens and children; according to his level or his desire by taking advantage of the technical contributions of an instructor!"
    ],
    "it": [
      "Esplora la montagna in mountain bike elettrica o downhill per adulti, ragazzi e bambini; secondo il suo livello o la sua voglia approfittando dei contributi tecnici di un istruttore!"
    ],
    "fr": [
      "Arpentez la montagne en VTT électrique ou de descente pour les adultes, ados et enfants ; selon son niveau ou son envie en profitant des apports techniques d'un moniteur !"
    ],
    "nl": [
      "Verken de berg op een elektrische mountainbike of downhill voor volwassenen, tieners en kinderen; volgens zijn niveau of zijn wens door gebruik te maken van de technische bijdragen van een instructeur!"
    ],
    "es": [
      "Explora las montañas en una bicicleta de montaña eléctrica o de descenso para adultos, adolescentes y niños, según tu nivel o tus ganas, ¡con el apoyo técnico de un instructor!"
    ]
  },
  "rdfs:label": {
