  "rdfs:comment": {
    "de": [
      "Wir bieten Origami-Workshops für Geburtstage in Privathaushalten, in öffentlichen Einrichtungen und bei öffentlichen Veranstaltungen an. Azacraft bietet auch Einführungen in die Programmierung mit der Programmiersprache Python an."
    ],
    "en": [
      "Origami workshops for private birthday parties, public establishments and public events. Azacraft also offers introductory courses in Python programming."
    ],
    "it": [
      "Azacraft organizza laboratori di origami per feste di compleanno in case private, in strutture aperte al pubblico e in occasione di eventi pubblici. Azacraft offre anche corsi di introduzione alla programmazione in Python."
    ],
    "fr": [
      "Animation d’atelier d’origami pour anniversaires chez des particuliers, et au sein des établissements accueillant du public ou encore des événements public. Azacraft propose également des initiations à la programmation en langage Python."
    ],
    "es": [
      "Azacraft imparte talleres de origami para fiestas de cumpleaños en domicilios particulares, en establecimientos abiertos al público y en actos públicos. Azacraft también ofrece cursos de iniciación a la programación en Python."
    ],
    "nl": [
      "Azacraft geeft origami-workshops voor verjaardagsfeestjes bij particulieren thuis, in openbare gelegenheden en op openbare evenementen. Azacraft biedt ook inleidende cursussen Python programmeren."
    ]
  },
