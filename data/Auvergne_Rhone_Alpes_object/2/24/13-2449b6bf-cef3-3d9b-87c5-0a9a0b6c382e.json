  "rdfs:comment": {
    "de": [
      "Berg-, Akazien-, Kastanien- & Tannenhonig.\r\nLebkuchen und Nougat mit Honig, Produkte auf Propolis-Basis.\r\nVerkauf auf dem Markt von Brioude und auf dem Bauernhof nach Vereinbarung."
    ],
    "en": [
      "Mountain, acacia, chestnut & fir honey.\r\nGingerbread and honey nougat, propolis-based products.\r\nSales at Brioude market, and at the farm by appointment."
    ],
    "it": [
      "Miele di montagna, acacia, castagno e abete.\r\nTorrone allo zenzero e al miele, prodotti a base di propoli.\r\nVenduto al mercato di Brioude e in fattoria su appuntamento."
    ],
    "fr": [
      "Miel de montagne, d'acacia, de châtaignier & de sapin.\r\nPains d'épices et nougat au miel, produits à base de propolis.\r\nVente sur le marché de Brioude, et à la ferme sur rdv."
    ],
    "es": [
      "Miel de montaña, acacia, castaño y abeto.\r\nPan de especias y turrón de miel, productos a base de propóleo.\r\nVenta en el mercado de Brioude y en la granja con cita previa."
    ],
    "nl": [
      "Berg-, acacia-, kastanje- en dennenhoning.\r\nPeperkoek en honingnougat, producten op basis van propolis.\r\nVerkocht op de markt in Brioude en op de boerderij op afspraak."
    ]
  },
  "rdfs:label": {
