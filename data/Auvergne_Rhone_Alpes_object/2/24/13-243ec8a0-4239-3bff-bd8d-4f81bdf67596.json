  "rdfs:comment": {
    "de": [
      "Geöffnet in der Sommer- und Wintersaison, 7 Tage die Woche 10-20 Uhr mit Sauna, Dampfbad, Whirlpool, Fitnessgeräten, Kräutertee und Handtuchverleih gegen Kaution."
    ],
    "en": [
      "Open during winter and summer seasons, 7/7, 10am-8pm with sauna, steam bath, whirlpool, fitness equipment, herbal tea provision and towel hire on payment of deposit."
    ],
    "it": [
      "Aperto in estate e in inverno, 7 giorni su 7 dalle 10 alle 20, con sauna, bagno turco, vasca idromassaggio, attrezzature per il fitness, tisaneria e prestito di asciugamani (è richiesta una cauzione)."
    ],
    "fr": [
      "Ouvert en saisons été et hiver, 7j/7 10h-20h avec sauna, hammam, bain bouillonnant, appareils de remise en forme, tisanerie et prêt de serviettes contre caution."
    ],
    "nl": [
      "Geopend in zomer- en winterseizoen, 7/7, 10.00-20 uur met sauna, stoombad, whirlpool, fitnessapparatuur, kruidenthee en handdoekverhuur tegen betaling van borg."
    ],
    "es": [
      "Abierto en verano e invierno, 7 días a la semana de 10.00 a 20.00 horas, con sauna, baño de vapor, bañera de hidromasaje, aparatos de fitness, salón de infusiones y préstamo de toallas (se requiere fianza)."
    ]
  },
