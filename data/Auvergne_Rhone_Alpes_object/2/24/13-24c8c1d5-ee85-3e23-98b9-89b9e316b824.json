  "rdfs:comment": {
    "de": [
      "Fotoshootings mit der Familie, um Ihre Urlaubserinnerungen mitzunehmen. Sei es in Ihrem Wohnort, um in einem kuscheligen Rahmen einen Teil Ihrer Geschichte zu erzählen, bei einem Spaziergang oder auf den Pisten, um Ihren Urlaub noch unvergesslicher zu machen."
    ],
    "en": [
      "Family photo sessions to take home your vacation memories. Whether at your home to tell part of your story in a cosy setting, on a walk or on the slopes to make your vacation even more unforgettable."
    ],
    "it": [
      "Servizi fotografici di famiglia per portare con sé i ricordi delle vacanze. A casa, per raccontare parte della vostra storia in un ambiente accogliente, durante una passeggiata o sulle piste da sci per rendere la vostra vacanza ancora più indimenticabile."
    ],
    "fr": [
      "Séances photo en famille pour emporter vos souvenirs de vacances. Que ce soit à votre résidence pour raconter une partie de votre histoire dans un cadre cocooning, en balade ou sur les pistes pour rendre vos vacances encore plus inoubliables."
    ],
    "es": [
      "Sesiones fotográficas familiares para llevarse el recuerdo de sus vacaciones. Ya sea en su casa para contar parte de su historia en un entorno acogedor, en un paseo o en las pistas para que sus vacaciones sean aún más inolvidables."
    ],
    "nl": [
      "Familiefotosessies om je vakantieherinneringen mee te nemen. Bij jou thuis om een deel van je verhaal te vertellen in een gezellige omgeving, tijdens een wandeling of op de piste om je vakantie nog onvergetelijker te maken."
    ]
  },
