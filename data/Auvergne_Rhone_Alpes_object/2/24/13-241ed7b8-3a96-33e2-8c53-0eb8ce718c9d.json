  "rdfs:comment": {
    "de": [
      "Die Bouleplätze befinden sich auf der Straße nach La Banne d'Ordanche, unterhalb des Campingplatzes Les Couderts und auf dem Parkplatz des Wasserspiels Le Pré Cohadon."
    ],
    "en": [
      "Petanque grounds : Route de la Banne d'Ordanche, under the campsite Les Couderts, and at the car park of the Plan d'eau."
    ],
    "it": [
      "I campi da bocce si trovano sulla strada Banne d'Ordanche, sotto il campeggio Couderts e al parcheggio del lago Pré Cohadon."
    ],
    "fr": [
      "Les terrains de pétanque se situent sur la route de la Banne d'Ordanche, sous le camping les Couderts et au parking du plan d'eau le Pré Cohadon."
    ],
    "es": [
      "Las pistas de petanca se encuentran en la carretera de Banne d'Ordanche, bajo el camping Couderts y en el aparcamiento del lago Pré Cohadon."
    ],
    "nl": [
      "De petanquebanen liggen aan de weg van Banne d'Ordanche, onder de camping van Couderts en op de parkeerplaats bij het meer van Pré Cohadon."
    ]
  },
  "rdfs:label": {
