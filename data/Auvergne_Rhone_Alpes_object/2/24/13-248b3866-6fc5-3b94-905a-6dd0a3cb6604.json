  "rdfs:comment": {
    "de": [
      "Laurent und Bérangère Neufcoeur, Imker und Confiseure, bieten Ihnen ihre Leckereien an: Bienenprodukte und vor Ort hergestellte Süßwaren in einem ganz neuen Geschäft in Rougemont - Aranc auf dem Plateau d'Hauteville."
    ],
    "en": [
      "Laurent and Bérangère Neufcoeur, beekeepers and confectioners, offer you their delicacies: products from the hive and confectionery made on site, in a brand-new store located in Rougemont - Aranc on the Plateau d'Hauteville."
    ],
    "it": [
      "Laurent e Bérangère Neufcoeur, apicoltori e pasticceri, vi offrono le loro prelibatezze: prodotti dell'alveare e dolciumi prodotti in loco, in un negozio situato a Rougemont - Aranc sul Plateau d'Hauteville."
    ],
    "fr": [
      "Laurent et Bérangère Neufcoeur, apiculteur et confiseure, vous proposent leurs gourmandises : produits de la ruche et confiseries confectionnées sur place, dans une boutique située à Rougemont - Aranc sur le Plateau d'Hauteville."
    ],
    "es": [
      "Laurent y Bérangère Neufcoeur, apicultores y pasteleros, le ofrecen sus delicias: productos de la colmena y pastelería elaborada en el propio establecimiento, en una tienda situada en Rougemont - Aranc, en la meseta de Hauteville."
    ],
    "nl": [
      "Laurent en Bérangère Neufcoeur, imkers en banketbakkers, bieden u hun lekkernijen aan: producten uit de bijenkorf en ter plaatse gemaakt gebak, in een winkel in Rougemont - Aranc op het Plateau d'Hauteville."
    ]
  },
  "rdfs:label": {
