  "rdfs:comment": {
    "de": [
      "Handwerklich hergestellte Pizzas zum Mitnehmen. Frische und lokale Zutaten.\r\nMenü für Kinder.\r\nGenießen Sie den Augenblick zu Hause.\r\nPreisträger 2023 des Netzwerks Initiative Grand Annecy."
    ],
    "en": [
      "Artisanal pizzas to take away. Fresh, local ingredients. \r\nChildren's menu.\r\nSavor the moment at home.\r\n2023 winner of the Grand Annecy Initiative Network."
    ],
    "it": [
      "Pizze fatte in casa da asporto. Ingredienti freschi e locali.\r\nMenu per bambini.\r\nGodetevi il momento a casa vostra.\r\nVincitore del Grand Annecy Initiative Network 2023."
    ],
    "fr": [
      "Pizzas artisanales à emporter. Ingrédients frais et locaux.\r\nMenu enfants.\r\nSavourez l'instant chez vous.\r\nLauréat 2023 du Réseau Initiative Grand Annecy."
    ],
    "nl": [
      "Zelfgemaakte pizza's om mee te nemen. Verse, lokale ingrediënten.\r\nKindermenu.\r\nGeniet thuis van het moment.\r\n2023 winnaar van het Grand Annecy Initiative Network."
    ],
    "es": [
      "Pizzas caseras para llevar. Ingredientes frescos y locales.\r\nMenú infantil.\r\nDisfrute del momento en casa.\r\nGanador 2023 de la Gran Red de Iniciativas de Annecy."
    ]
  },
