  "rdfs:comment": {
    "de": [
      "Als passionierter Angelführer biete ich maßgeschneiderte Leistungen für das Angeln von Forellen oder Raubfischen an. Erlernen der Techniken, Perfektionierung und Entdeckung ausgewählter Strecken. Rutenmontageservice nach Maß und Reparaturen."
    ],
    "en": [
      "A passionate fishing guide, I offer tailor-made services for trout and predator fishing. Learn techniques, improve your skills and discover selected courses. Custom rod-fitting and repair services."
    ],
    "it": [
      "Guida di pesca appassionata, offro servizi su misura per la pesca alla trota e ai predatori. Imparate le tecniche, migliorate le vostre abilità e scoprite i corsi selezionati. Servizio di montaggio e riparazione di canne su misura."
    ],
    "fr": [
      "Guide de pêche passionné, je propose des prestations sur mesure pour la pêche de la truite ou des carnassiers. Apprentissage des techniques, perfectionnement et découverte de parcours sélectionnés. Service de montage de cannes sur mesure et réparations."
    ],
    "es": [
      "Guía de pesca apasionado, ofrezco servicios a medida para la pesca de truchas y depredadores. Aprenda técnicas, mejore sus habilidades y descubra cursos seleccionados. Servicio de montaje y reparación de cañas a medida."
    ],
    "nl": [
      "Als gepassioneerde visgids bied ik diensten op maat voor het vissen op forel en roofvis. Leer technieken, verbeter je vaardigheden en ontdek geselecteerde cursussen. Maatwerk hengelmontage en reparatieservice."
    ]
  },
  "rdfs:label": {
