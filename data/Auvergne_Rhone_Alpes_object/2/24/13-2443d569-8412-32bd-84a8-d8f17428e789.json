  "rdfs:comment": {
    "de": [
      "Calibert en Scène ist ein Verein, der in seiner Satzung Folgendes dekliniert: \"Die kulturelle Förderung im ländlichen Raum...\"\r\nEine echte Baustelle öffnet sich vor uns."
    ],
    "en": [
      "Calibert en Scène is an association whose articles of association state that it aims to \"promote culture in rural areas...\"\r\nWe have a real challenge ahead of us."
    ],
    "it": [
      "Calibert en Scène è un'associazione il cui statuto recita: \"la promozione della cultura nelle zone rurali...\"\r\nAbbiamo una vera e propria sfida davanti a noi."
    ],
    "fr": [
      "Calibert en Scène est une association qui décline dans ses statuts : \" la promotion culturelle en milieu rural...\" \r\nUn véritable chantier s'ouvre à nous."
    ],
    "nl": [
      "Calibert en Scène is een vereniging waarvan de statuten luiden: \"de bevordering van cultuur op het platteland...\"\r\nWe staan voor een echte uitdaging."
    ],
    "es": [
      "Calibert en Scène es una asociación cuyos estatutos rezan: \"la promoción de la cultura en el medio rural...\"\r\nTenemos ante nosotros un auténtico reto."
    ]
  },
