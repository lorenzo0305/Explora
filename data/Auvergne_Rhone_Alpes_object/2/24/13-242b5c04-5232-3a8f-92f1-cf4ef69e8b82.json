  "rdfs:comment": {
    "de": [
      "Als Agentur für Reisen mit dem Elektrofahrrad bietet Ihnen Chemins ein Wandererlebnis, das neue Kräfte freisetzt und für Abwechslung sorgt, damit Sie die weiten Landschaften erkunden, außergewöhnliche Dörfer entdecken und die Bewohner treffen können, die das Land am Leben erhalten."
    ],
    "en": [
      "Chemins is a touring electric bike travel agency. \r\nExplore wide open spaces, visit outstanding villages and meet the locals in a refreshing and exotic touring holiday."
    ],
    "it": [
      "Chemins vi offre la possibilità di esplorare i grandi spazi aperti, di scoprire villaggi eccezionali e di incontrare le persone locali che danno vita alla regione."
    ],
    "fr": [
      "Chemins vous propose une expérience itinérante, ressourçante et dépaysante pour explorer les grands espaces, découvrir des villages d'exception et rencontrer les habitants qui font vivre le territoire."
    ],
    "es": [
      "Chemins le ofrece la oportunidad de explorar la naturaleza, descubrir pueblos excepcionales y conocer a la gente local que da vida a la región."
    ],
    "nl": [
      "Chemins is een reisbureau voor elektrische fietsen dat je een rondtrekkende ervaring biedt vol verjonging en verandering van omgeving, zodat je de natuur kunt verkennen, bijzondere dorpjes kunt ontdekken en de plaatselijke bevolking kunt ontmoeten die de regio tot leven brengt."
    ]
  },
