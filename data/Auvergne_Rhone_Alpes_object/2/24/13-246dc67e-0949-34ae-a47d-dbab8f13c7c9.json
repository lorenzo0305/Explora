  "rdfs:comment": {
    "de": [
      "L'Atelier Choral, ein Vokalensemble mit Sitz in Le Chambon-sur-Lignon, das von Elisabeth de Mestral geleitet wird.\r\nAktuelle Polyphonie, poetische Reise zwischen Europa und Amerika.\r\n\r\nAm Keyboard und an der Orgel: Hugues Laurent."
    ],
    "en": [
      "L'Atelier Choral, vocal ensemble based in Le Chambon-sur-Lignon, directed by Elisabeth de Mestral.\r\nContemporary polyphony, a poetic journey between Europe and America.\r\n\r\nOn keyboard and organ, Hugues Laurent."
    ],
    "it": [
      "L'Atelier Choral, ensemble vocale con sede a Le Chambon-sur-Lignon, diretto da Elisabeth de Mestral.\r\nPolifonia contemporanea, un viaggio poetico tra Europa e America.\r\n\r\nAlla tastiera e all'organo, Hugues Laurent."
    ],
    "fr": [
      "L’Atelier Choral, ensemble vocal basé au Chambon-sur-Lignon, dirigé par Elisabeth de Mestral.\r\nPolyphonies actuelles, voyage poétique entre Europe et Amérique.\r\n\r\nAu clavier et à l’orgue, Hugues Laurent."
    ],
    "nl": [
      "L'Atelier Choral, een vocaal ensemble gevestigd in Le Chambon-sur-Lignon, geleid door Elisabeth de Mestral.\r\nHedendaagse polyfonie, een poëtische reis tussen Europa en Amerika.\r\n\r\nOp klavier en orgel, Hugues Laurent."
    ],
    "es": [
      "L'Atelier Choral, conjunto vocal con sede en Le Chambon-sur-Lignon, dirigido por Elisabeth de Mestral.\r\nPolifonía contemporánea, un viaje poético entre Europa y América.\r\n\r\nAl teclado y al órgano, Hugues Laurent."
