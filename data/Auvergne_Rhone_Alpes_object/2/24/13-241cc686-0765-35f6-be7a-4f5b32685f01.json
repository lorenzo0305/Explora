  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf ein Abenteuer auf einer Aufstiegspiste, die dem Skitourengehen gewidmet ist und durch die wunderschönen Wälder von Courchevel Moriond führt. Eine ideale Strecke mit einem Höhenunterschied von 530 m auf 2,8 km. Auf die Skier!"
    ],
    "en": [
      "Embark on an adventure on a dedicated uphill trail for ski touring, crossing the beautiful forests of Courchevel Moriond. An ideal routewith a 530-meter vertical drop over 2.8 km. Ready, set, ski!"
    ],
    "it": [
      "Partite all'avventura su una pista in salita dedicata allo sci alpinismo, attraverso le magnifiche foreste di Courchevel Moriond. Una pista ideale di 2,8 km con 530 m di dislivello. Con gli sci ai piedi!"
    ],
    "fr": [
      "Partez à l'aventure sur une piste de montée dédiée au ski de randonnée, traversant les magnifiques forêts de Courchevel Moriond. Un parcours idéal de 530 m de dénivelé sur 2,8 km. À vos skis !"
    ],
    "nl": [
      "Ga op avontuur op een bergopwaartse piste gewijd aan toerskiën, door de prachtige bossen van Courchevel Moriond. Een ideale piste van 2,8 km met een hoogteverschil van 530 m. Op je ski's!"
    ],
    "es": [
      "Emprenda una aventura en una pista ascendente dedicada al esquí de travesía, a través de los magníficos bosques de Courchevel Moriond. Una pista ideal de 2,8 km y 530 m de desnivel. ¡Sobre sus esquís!"
    ]
  },
