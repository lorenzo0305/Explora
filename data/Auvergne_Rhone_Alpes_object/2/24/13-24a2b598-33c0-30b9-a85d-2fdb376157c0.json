  "rdfs:comment": {
    "de": [
      "Die Szenografie von Usson zeigt anhand von Filmprojektionen, Kartennotizen und einem Modell die Geschichte des Dorfes und der Festung, die sich auf der Anhöhe befand und Königin Margot beherbergte, die von 1585 bis 1605 in Usson im Exil war."
    ],
    "en": [
      "Presentation of the story of Usson, one of the Most Beautiful Villages in France and his emblematic character: Queen Margot."
    ],
    "it": [
      "La scenografia di Usson, basata su proiezioni cinematografiche, avvisi su etichette e un modello in scala, presenta la storia del villaggio e della fortezza che si trovava sulla collina e che ospitò la regina Margot in esilio a Usson dal 1585 al 1605."
    ],
    "fr": [
      "La scénographie d’Usson, en s’appuyant sur des projections de films, des notices sur cartels et une maquette, présente l’histoire du village et de la forteresse qui était située sur la butte et qui a hébergé la Reine Margot en exil à Usson de 1585 à 1605."
    ],
    "es": [
      "La escenografía de Usson, basada en proyecciones cinematográficas, rótulos y una maqueta, presenta la historia del pueblo y de la fortaleza que se encontraba en el altozano y que albergó a la reina Margot en su exilio en Usson de 1585 a 1605."
    ],
    "nl": [
      "De scenografie van Usson, gebaseerd op filmprojecties, mededelingen op etiketten en een maquette, presenteert de geschiedenis van het dorp en het fort dat op de heuvel lag en waar koningin Margot van 1585 tot 1605 in ballingschap in Usson verbleef."
    ]
  },
  "rdfs:label": {
    "en": [
      "Scenography on the village of Usson"
    ],
    "fr": [
      "Scénographie sur le village d'Usson"
    ]
  },
