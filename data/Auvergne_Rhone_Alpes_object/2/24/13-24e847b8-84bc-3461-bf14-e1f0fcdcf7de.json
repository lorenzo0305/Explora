  "rdfs:comment": {
    "de": [
      "Teich mit dem Gütesiegel \"parcours famille\".\r\nAngeln nur mit einer interföderalen Karte oder einer Angelkarte des Departements Allier (Major Départementale - découverte femme - mineure - journée - découverte - de 12 ans - hebdomadaire - timbre EHGO)."
    ],
    "en": [
      "Family-oriented lake.\r\nFishing only available with an inter-federal card or an Allier fishing card (departmental major - women's discovery - minor - day - discovery - 12 years - weekly - EHGO stamp)."
    ],
    "it": [
      "Stagno con etichetta del percorso famiglia.\r\nSi può pescare solo con la tessera interfederale o la tessera di pesca dell'Allier (dipartimentale maggiore - scoperta femminile - minore - giornaliera - scoperta - minori di 12 anni - settimanale - bollino EHGO)."
    ],
    "fr": [
      "Étang labellisé parcours famille.\r\nPêche uniquement accessible avec une carte interfédérale ou bien une carte de pêche de l'Allier (majeure départementale - découverte femme - mineure - journée - découverte - de 12 ans - hebdomadaire - timbre EHGO)."
    ],
    "nl": [
      "Vijver met label familiepad.\r\nVissen alleen mogelijk met een interfederale kaart of een viskaart van de Allier (departementaal major - vrouwen discovery - minor - day - discovery - under 12s - weekly - EHGO stempel)."
    ],
    "es": [
      "Estanque con etiqueta de sendero familiar.\r\nPesca disponible únicamente con tarjeta interfederal o tarjeta de pesca Allier (mayor departamental - descubrimiento femenino - menor - día - descubrimiento - menores de 12 años - semanal - sello EHGO)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Étang Le Pré Verne"
    ]
  },
