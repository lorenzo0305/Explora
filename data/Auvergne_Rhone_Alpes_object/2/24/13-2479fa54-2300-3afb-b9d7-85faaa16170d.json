  "rdfs:comment": {
    "de": [
      "La Rose des Sables, im Herzen des historischen Stadtzentrums von Thiers gelegen, ist ein gemütliches Restaurant, das eine schmackhafte Küche anbietet\r\ngroßzügige, aus hochwertigen Produkten zubereitete Speisen in einer freundlichen und einladenden Atmosphäre anbietet."
    ],
    "en": [
      "La Rose des Sables, located in the heart of Thiers' historic town center, is a warm and welcoming restaurant offering tasty, generous cuisine\r\nfrom quality produce, in a friendly, welcoming atmosphere."
    ],
    "it": [
      "La Rose des Sables, situata nel cuore del centro storico di Thiers, è un ristorante accogliente che offre una cucina gustosa e generosa a base di prodotti di qualità in un'atmosfera amichevole e accogliente\r\ncucina generosa a base di prodotti di qualità, in un'atmosfera amichevole e accogliente."
    ],
    "fr": [
      "La Rose des Sables, située au cœur du centre-ville historique de Thiers, est un restaurant chaleureux qui propose une cuisine savoureuse et\r\ngénéreuse, élaborée à partir de produits de qualité, dans une ambiance conviviale et accueillante."
    ],
    "es": [
      "La Rose des Sables, situado en pleno centro histórico de Thiers, es un restaurante acogedor que ofrece una cocina sabrosa y generosa elaborada con productos de calidad en un ambiente agradable y acogedor\r\ncocina generosa elaborada con productos de calidad, en un ambiente agradable y acogedor."
    ],
    "nl": [
      "La Rose des Sables, gelegen in het hart van het historische centrum van Thiers, is een gezellig restaurant met een smakelijke, gulle keuken op basis van kwaliteitsproducten in een vriendelijke, gastvrije sfeer\r\nsmakelijke, gulle gerechten op basis van kwaliteitsproducten, in een vriendelijke en gastvrije sfeer."
    ]
  },
