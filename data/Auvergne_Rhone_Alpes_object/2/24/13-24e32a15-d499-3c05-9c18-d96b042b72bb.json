  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné des Eparres. Wir können Sie für die Dauer eines Picknicks oder einer Etappe im Biwak empfangen. Picknicktisch, Anbindestange für Pferde, Unterstand, Wasser, Toilette und Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné des Eparres. We can accommodate you for a picnic or a bivouac. Picnic table, horse tie-up bar, shelter, water, toilet and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné des Eparres. Possiamo ospitarvi per un picnic o un bivacco. Disponiamo di un tavolo da picnic, di una corda per i cavalli, di un riparo, di acqua, di una toilette e di un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné des Eparres. Nous pouvons vous accueillir le temps d'un pique nique ou d'une étape en bivouac. Table de pique-nique, barre d'attache pour chevaux, abri, eau, toilette et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné des Eparres. Je kunt bij ons terecht voor een picknick of een bivak. We hebben een picknicktafel, een tui voor paarden, een schuilhut, water, een toilet en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné des Eparres. Podemos acogerle para un picnic o un vivac. Disponemos de una mesa de picnic, un ronzal para caballos, un refugio, agua, aseos y aparcamiento."
    ]
  },
