  "rdfs:comment": {
    "de": [
      "Das Restaurant La Halte des Bauges ist ein Bar-Restaurant, das unter der Woche ein Tagesmenü und sonntags eine kleine Karte anbietet."
    ],
    "en": [
      "Bar-restaurant offering mainly Savoyard specialties and in summer, salads, omelettes, daily specials, diots (local sausage cooked in a white wine sauce).\r\nPossibility of buffet and takeaway on order."
    ],
    "it": [
      "Il ristorante Halte des Bauges è un bar-ristorante che offre un menù giornaliero durante la settimana e un piccolo menù à la carte la domenica."
    ],
    "fr": [
      "Le restaurant de la Halte des Bauges est un bar-restaurant proposant un menu du jour en semaine et une petite carte les dimanches."
    ],
    "nl": [
      "Restaurant de la Halte is een bar-restaurant waar u voornamelijk van specialiteiten uit de Savoie kunt genieten"
    ],
    "es": [
      "El restaurante Halte des Bauges es un bar-restaurante que ofrece un menú diario durante la semana y un pequeño menú a la carta los domingos."
    ]
