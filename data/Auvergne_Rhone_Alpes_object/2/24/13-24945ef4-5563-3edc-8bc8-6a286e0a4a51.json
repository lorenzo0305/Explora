  "rdfs:comment": {
    "de": [
      "Für einen Aufenthalt, eine Übernachtung oder einen Moment des Essens empfängt Sie das Relais Saint-André in einem zur Natur hin offenen Speisesaal. Mit seinen acht Zimmern können Sie sich in einer grünen, ruhigen Umgebung entspannen."
    ],
    "en": [
      "For a stay, an overnight stay or a moment's refreshment, the Relais Saint-André welcomes you to its restaurant, which overlooks the countryside. With eight rooms, you can relax in a green and peaceful setting.\r\nEvening bookings only"
    ],
    "it": [
      "Per un soggiorno, un pernottamento o un momento di ristoro, il Relais Saint-André vi accoglie nel suo ristorante, affacciato sulla campagna. Con otto camere, potrete rilassarvi in un ambiente verde e tranquillo."
    ],
    "fr": [
      "Pour un séjour, une nuit, un instant de restauration, le relais Saint-André vous accueille dans une salle de restaurant ouverte sur le nature. Disposant de huit chambres, vous pourrez vous détendre dans un site verdoyant, au calme."
    ],
    "nl": [
      "Voor een verblijf, een overnachting of een moment van verfrissing heet Relais Saint-André je welkom in zijn restaurant, dat uitkijkt over het platteland. Met zijn acht kamers kunt u ontspannen in een groene en rustige omgeving."
    ],
    "es": [
      "Para una estancia, una noche o un momento de refresco, el Relais Saint-André le acoge en su restaurante con vistas al campo. Con ocho habitaciones, podrá relajarse en un entorno verde y tranquilo."
    ]
  },
