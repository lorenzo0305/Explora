  "rdfs:comment": {
    "de": [
      "La Ferme du Rolland freut sich, Sie in seinem authentischen Bauernhof-Gasthof mit Unterkunft und Verpflegung bei einem gemütlichen und herzlichen Essen begrüßen zu dürfen. Eine atemberaubende Aussicht. Entdecken Sie die Tiere des Bauernhofs."
    ],
    "en": [
      "La Ferme du Rolland is delighted to welcome you to its authentic farmhouse inn, where you can enjoy a warm, friendly meal in a family atmosphere. Breathtaking views. Discover the farm animals."
    ],
    "it": [
      "La Ferme du Rolland è lieta di accogliervi nella sua autentica locanda contadina, dove potrete gustare un pasto caldo e cordiale in un'atmosfera familiare. Panorami mozzafiato. Scoprite gli animali della fattoria."
    ],
    "fr": [
      "La Ferme du Rolland est heureuse de vous accueillir, dans un esprit familial, au sein de son authentique ferme-auberge offrant le gîte et\\ou le couvert, autour d'un repas convivial et chaleureux. Vue imprenable. Découverte des animaux de la ferme."
    ],
    "nl": [
      "La Ferme du Rolland verwelkomt je graag in zijn authentieke boerderijherberg, waar je kunt genieten van een warme, vriendelijke maaltijd in een familiale sfeer. Adembenemend uitzicht. Ontdek de boerderijdieren."
    ],
    "es": [
      "La Ferme du Rolland está encantada de recibirle en su auténtica granja-mesón, donde podrá disfrutar de una comida cálida y acogedora en un ambiente familiar. Unas vistas impresionantes. Descubra los animales de la granja."
    ]
  },
