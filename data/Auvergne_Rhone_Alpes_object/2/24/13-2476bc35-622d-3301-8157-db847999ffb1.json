  "rdfs:comment": {
    "de": [
      "Das Hotel***** & Spa Le Pavillon liegt in einer grünen Umgebung und empfängt Sie inmitten seines wunderschönen Landschaftsparks zu einem idyllischen Erlebnis. Mit seinem Spa bietet Ihnen dieser prächtige Komplex hochwertige Leistungen in der Nähe von Lyon."
    ],
    "en": [
      "Located in a green setting, the ***** Hotel & Spa Le Pavillon welcomes you to the heart of its beautiful landscaped park for an idyllic experience. With its spa, this luxurious resort offers high-end services just a short distance from Lyon."
    ],
    "it": [
      "Immerso in un ambiente verdeggiante, l'Hôtel ***** & Spa Le Pavillon vi accoglie nel cuore del suo magnifico parco paesaggistico per un'esperienza idilliaca. Con la sua spa, questo sontuoso complesso offre servizi di alta gamma vicino a Lione."
    ],
    "fr": [
      "Situé dans un environnement verdoyant, l'Hôtel***** & Spa Le Pavillon vous accueille au cœur de son magnifique parc paysager pour une expérience idyllique. Avec son spa, ce complexe somptueux vous offre des prestations haut de gamme à proximité de Lyon."
    ],
    "es": [
      "Situado en un entorno verde, el Hôtel ***** & Spa Le Pavillon le da la bienvenida en el corazón de sus magníficos jardines para que disfrute de una experiencia idílica. Con su spa, este suntuoso complejo ofrece servicios de alta gama cerca de Lyon."
    ],
    "nl": [
      "Hôtel ***** & Spa Le Pavillon ligt in een groene omgeving en verwelkomt je in het hart van het prachtige landschap voor een idyllische ervaring. Met zijn spa biedt dit luxueuze complex diensten van topklasse in de buurt van Lyon."
    ]
  },
