  "rdfs:comment": {
    "de": [
      "Im Garten der Feerailleuse gibt es wilde und essbare Pflanzen, Biodiversität, Hühner, Skulpturen...Und ein Lächeln, um Sie zu begrüßen :)"
    ],
    "en": [
      "In La Féerailleuse's garden, there are wild and edible plants, biodiversity, chickens, sculptures...And a smile to welcome you :)"
    ],
    "it": [
      "Nel giardino de La Féerailleuse ci sono piante selvatiche e commestibili, biodiversità, galline, sculture... e un sorriso per accogliervi :)"
    ],
    "fr": [
      "Dans le jardin de la Féerailleuse, il y a des plantes sauvages et comestibles, de la biodiversité, des poules, des sculptures...Et un sourire pour vous accueillir :)"
    ],
    "nl": [
      "In de tuin van La Féerailleuse vindt u wilde en eetbare planten, biodiversiteit, kippen, beelden... en een glimlach om u te verwelkomen :)"
    ],
    "es": [
      "En el jardín de La Féerailleuse, hay plantas silvestres y comestibles, biodiversidad, gallinas, esculturas... y una sonrisa para recibirle :)"
    ]
  },
