  "rdfs:comment": {
    "de": [
      "Benoit Court und seine Frau Patricia freuen sich, Sie in ihrem Hotel-Restaurant zu begrüßen und Ihnen eine gastronomische Küche anzubieten, die durch die Bezeichnung \"Restaurant de Qualité\" und das Label \"Maitre Restaurateur\" anerkannt ist."
    ],
    "en": [
      "Benoit Court and his wife Patricia will be delighted to welcome you to their hotel restaurant. You will enjoy gourmet cuisine approved by the \"Quality Restaurant\" and \"Master Restorer\" labels."
    ],
    "it": [
      "Benoit Court e sua moglie Patricia saranno lieti di accogliervi nel loro hotel-ristorante e di offrirvi una cucina gastronomica riconosciuta dai marchi \"Restaurant de Qualité\" e \"Maitre Restaurateur\"."
    ],
    "fr": [
      "Benoit Court et son épouse Patricia auront le plaisir de vous accueillir dans leur hôtel-restaurant et de vous proposer une cuisine gastronomique reconnue par l'appellation « Restaurant de Qualité » et le label « Maitre Restaurateur »."
    ],
    "es": [
      "Benoit Court y su esposa Patricia estarán encantados de recibirle en su hotel-restaurante y ofrecerle una cocina gastronómica reconocida con los sellos \"Restaurant de Qualité\" y \"Maitre Restaurateur\"."
    ],
    "nl": [
      "Benoit Court en zijn vrouw Patricia heten u van harte welkom in hun hotel-restaurant en bieden u een gastronomische keuken erkend door de labels \"Restaurant de Qualité\" en \"Maitre Restaurateur\"."
    ]
  },
