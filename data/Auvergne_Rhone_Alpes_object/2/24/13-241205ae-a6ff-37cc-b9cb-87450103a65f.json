  "rdfs:comment": {
    "de": [
      "Eine Stadt in der Stadt, das ist eine gute Idee. Das war die Idee von Le Corbusier, dem visionären Architekten, den wir heute nicht mehr kennen."
    ],
    "en": [
      "A city within a city, that's a good idea. It was the idea of Le Corbusier, the visionary architect who needs no introduction."
    ],
    "it": [
      "Una città nella città, è una buona idea. Era quella di Le Corbusier, l'architetto visionario che non ha bisogno di presentazioni."
    ],
    "fr": [
      "Une ville dans la ville, en voilà une bonne idée. C’était celle de Le Corbusier, cet architecte visionnaire qu’on ne présente plus."
    ],
    "es": [
      "Una ciudad dentro de una ciudad, es una buena idea. Fue la de Le Corbusier, el arquitecto visionario que no necesita presentación."
    ],
