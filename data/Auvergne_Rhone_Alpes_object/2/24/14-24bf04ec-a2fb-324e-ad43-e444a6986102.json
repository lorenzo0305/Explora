  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e81763f9-b49c-3690-96cd-f0f83e5b070e",
      "dc:description": {
        "de": [
          "MITTAG 10:00-12:00 Uhr Training, Einführung und Fortbildung\nNachmittags 14-17 Uhr Animationen/Turniere, freies Spiel, permanentes \"Rattaque\"-Feld,\nplatzvermietung\nVoraussetzung: ab 12 Jahren\n\nPreise:\n Vormittag (Training) 10?\n Nachmittag (Turniere/\"Rattaque\"-Feld 8?\n Tag 15?\n Alle 6 Tage 80?\n Vermietung von Spielfeldern und Bällen (nachmittags und nach Verfügbarkeit) 40?\nErmäßigung auf den Wochentarif = 10% Familie (Geschwister)"
        ],
        "en": [
          "MORNING 10am-12pm Training, introductory and advanced courses\nAfternoon 2pm-5pm Activities/tournaments, free play, permanent \"rattaque\" pitch,\npitch rental\nConditions: from 12 years old\n\nPrices :\n Morning (training) 10?\n Afternoon (tournaments/\"rattaque\" pitch) 8?\n Full day 15?\n 6 days 80?\n Field and ball hire (afternoon and subject to availability) 40?\nDiscount on weekly rate = 10% family (brothers and sisters)"
        ],
        "it": [
          "MATTINA 10.00-12.00 Allenamento, corsi introduttivi e di perfezionamento\nPomeriggio 14.00-17.00 Attività/tornei, gioco libero, campo permanente \"rattaque\",\nnoleggio del campo\nCondizioni: a partire da 12 anni\n\nPrezzi :\n Mattina (allenamento) 10?\n Pomeriggio (tornei / campo \"rattaque\") 8?\n Giornata intera 15?\n 6 giorni 80?\n Noleggio campo e palloni (pomeriggio e secondo disponibilità) 40?\nSconto sulla tariffa settimanale = 10% famiglia (fratelli e sorelle)"
        ],
        "fr": [
          "MATIN 10h-12h Entraînement, initiation et perfectionnement\nAprès-midi 14h-17h Animations/tournois, jeu libre, terrain permanent de « rattaque »,\nlocation de terrains\nCondition : à partir de 12 ans\n\nTarifs :\n Matinée (entraînement) 10€\n Après-midi (tournois/terrain de « rattaque »  8€\n Journée  15€\n Les 6 jours  80€\n Location de terrains et ballons (après-midi et selon disponibilités) 40€\nRéduction sur tarif semaine = 10% famille (frères et soeurs)"
        ],
        "nl": [
          "Ochtenden 10-12 uur Training, inleidende en gevorderde cursussen\nMiddag 14.00 - 17.00 uur Activiteiten/toernooien, vrij spel, permanent \"rattaque\"-veld,\nveld huren\nVoorwaarden: vanaf 12 jaar\n\nPrijzen :\n Ochtend (training) 10?\n Namiddag (toernooien/\"rattaque\" veld) 8?\n Hele dag 15?\n 6 dagen 80?\n Huur pitch en bal (namiddag en volgens beschikbaarheid) 40?\nKorting op weektarief = 10% familie (broers en zussen)"
        ],
        "es": [
          "MAÑANA 10.00-12.00 Formación, cursos de iniciación y perfeccionamiento\nTarde 14.00-17.00 Actividades/torneos, juego libre, campo de \"rattaque\" permanente,\nalquiler de terreno de juego\nCondiciones: a partir de 12 años\n\nPrecios :\n Mañana (entrenamiento) 10?\n Tarde (torneos/campo \"rattaque\") 8?\n Día completo 15?\n 6 días 80?\n Alquiler de campo y balón (tardes y según disponibilidad) 40?\nDescuento sobre tarifa semanal = 10% familia (hermanos y hermanas)"
        ]
      },
