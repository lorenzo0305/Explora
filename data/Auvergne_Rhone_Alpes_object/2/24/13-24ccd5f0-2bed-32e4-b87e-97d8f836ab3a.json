  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich in der alten Dorfschule hinter dem Rathaus. Das ehrenamtliche Team der Bibliothek empfängt Sie das ganze Jahr über, um eine Vielzahl von Büchern für alle Altersgruppen zu entdecken oder wiederzuentdecken."
    ],
    "en": [
      "Housed in the old village school, behind the town hall, the library's team of volunteers welcomes you all year round to discover or rediscover a wealth of books for all ages."
    ],
    "it": [
      "Situata nella vecchia scuola del villaggio, dietro il municipio, il team di volontari della biblioteca vi accoglie tutto l'anno per scoprire o riscoprire una moltitudine di libri per tutte le età."
    ],
    "fr": [
      "Installée dans l'ancienne école du village, derrière la mairie, l'équipe de bénévoles de la bibliothèque vous accueille toute l'année pour découvrir ou redécouvrir une multitude d'ouvrages à destination de tous les âges."
    ],
    "es": [
      "Situada en la antigua escuela del pueblo, detrás del ayuntamiento, el equipo de voluntarios de la biblioteca le da la bienvenida durante todo el año para descubrir o redescubrir una multitud de libros para todas las edades."
    ],
    "nl": [
      "In de oude dorpsschool, achter het gemeentehuis, verwelkomt het team van vrijwilligers van de bibliotheek u het hele jaar door om een groot aantal boeken voor alle leeftijden te ontdekken of te herontdekken."
    ]
  },
  "rdfs:label": {
