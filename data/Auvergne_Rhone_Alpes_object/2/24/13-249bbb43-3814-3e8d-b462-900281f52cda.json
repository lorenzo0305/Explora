    "de": [
      "Traditionelles, bistronomisches Restaurant mit einer Speisekarte, die nur aus rohen und frischen Produkten zusammengestellt wird, im Herzen des historischen Zentrums von Vienne!"
    ],
    "en": [
      "Traditional bistro-style restaurant with a menu made only from raw, fresh products in the heart of the historic centre of Vienne!"
    ],
    "it": [
      "Un ristorante bistronomico e semi-gastronomico con un menu basato esclusivamente su ingredienti freschi e crudi nel cuore del centro storico di Vienna!"
    ],
    "fr": [
      "Restaurant bistronomique, semi-gastronomique avec une carte élaborée uniquement à partir de produits bruts et frais au cœur du centre historique de Vienne !"
    ],
    "es": [
      "Un restaurante bistronómico y semigastronómico con un menú basado exclusivamente en ingredientes frescos y crudos en pleno centro histórico de Viena"
