  "rdfs:comment": {
    "de": [
      "Stellen Sie Ihre Koffer in dieser grünen Oase im Stadtzentrum von Ambert ab. Entspannen Sie sich und machen Sie eine Pause von der Zeit im regionalen Naturpark Livradois-Forez."
    ],
    "en": [
      "A“garden in the heart of the town”, come stay in one of our spacious and comfortable rooms. Buffet-style breakfast served nonstop all morning. Free Wi-Fi access. Free private, enclosed parking, or covered garage parking with fee. Group bookings welcome. In the restaurant : traditional cuisine, delicious food and generous portions. Open 7 days a week. Closed during Christmas holidays."
    ],
    "it": [
      "Lasciate le vostre valigie in questo ambiente verde nel centro di Ambert. Venite a rilassarvi e a fare una pausa senza tempo nel Parco Naturale Regionale Livradois-Forez."
    ],
    "fr": [
      "Déposez vos valises dans cet écrin de verdure en centre ville d'Ambert. Venez vous relaxer et faire une pause hors du temps dans le Parc naturel régional Livradois-Forez."
    ],
    "nl": [
      "Laat je koffers vallen in deze groene omgeving in het centrum van Ambert. Kom tot rust en neem een tijdloze pauze in het Regionaal Natuurpark Livradois-Forez."
    ],
    "es": [
      "Deje las maletas en este entorno verde del centro de Ambert. Venga a relajarse y a tomarse un descanso atemporal en el Parque Natural Regional de Livradois-Forez."
    ]
  },
  "rdfs:label": {
