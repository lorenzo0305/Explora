  "rdfs:comment": {
    "de": [
      "Das Überschreiten der Schwelle des Chalets-Hôtel de la Croix Fry in Manigod soll die Tür zu einem magischen Universum öffnen, in dem vier Generationen die Spuren ihrer Leidenschaft für ihr Familienhaus hinterlassen haben."
    ],
    "en": [
      "Crossing the threshold of the Chalets-Hôtel de la Croix Fry in Manigod is to open the door to a magical universe, where four generations have left the mark of their passion for their Family House."
    ],
    "it": [
      "Varcare la soglia dello Chalets-Hotel de la Croix Fry a Manigod significa aprire la porta di un mondo magico, dove quattro generazioni hanno lasciato il segno della loro passione per la casa di famiglia."
    ],
    "fr": [
      "Franchir le seuil des Chalets-Hôtel de la Croix Fry à Manigod, c'est ouvrir la porte d'un univers magique, où quatre générations ont laissé la marque de leur passion pour leur Maison de Famille."
    ],
    "nl": [
      "Over de drempel van de Chalets-Hotel de la Croix Fry in Manigod stappen is de deur openen naar een magische wereld, waar vier generaties de stempel van hun passie voor hun familiehuis hebben gedrukt."
    ],
    "es": [
      "Cruzar el umbral del Chalets-Hotel de la Croix Fry en Manigod es abrir la puerta a un mundo mágico, donde cuatro generaciones han dejado la huella de su pasión por su Casa Familiar."
    ]
  },
  "rdfs:label": {
