  "rdfs:comment": {
    "de": [
      "Sind Sie auf der Suche nach einer Route, die Wald und weite, sonnige Flächen miteinander verbindet? Von Les Chattrix aus führt Sie dieser schöne Aufstieg über das Plateau de la Croix nach Porcherey."
    ],
    "en": [
      "Looking for a route that combines forest and sunny open spaces? From Les Chattrix, this beautiful ascent takes you to Porcherey via the Plateau de la Croix."
    ],
    "it": [
      "Siete alla ricerca di un percorso che combini bosco e ampi spazi aperti e soleggiati? Da Les Chattrix, questa bella salita vi porta a Porcherey attraverso il Plateau de la Croix."
    ],
    "fr": [
      "À la recherche d’un itinéraire mêlant forêt et grands espaces ensoleillés ? Depuis les Chattrix, cette belle ascension vous mène à Porcherey en passant par le plateau de la Croix."
    ],
    "es": [
      "¿Busca una ruta que combine bosque y amplios y soleados espacios abiertos? Desde Les Chattrix, esta hermosa ascensión te lleva a Porcherey por el Plateau de la Croix."
    ],
    "nl": [
      "Op zoek naar een route die bos en weidse, zonnige open vlaktes combineert? Vanaf Les Chattrix voert deze prachtige klim je via het Plateau de la Croix naar Porcherey."
    ]
  },
