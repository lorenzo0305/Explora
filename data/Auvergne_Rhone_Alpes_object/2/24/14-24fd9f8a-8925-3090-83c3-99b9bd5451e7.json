      "dc:description": {
        "de": [
          "Kreditversicherung, Darlehen und Immobilienkredit, Kreditrückkauf\n\nÖffnungszeiten:\nMontag bis Freitag von 14.00 bis 18.00 Uhr.\nSamstags nach Vereinbarung"
        ],
        "en": [
          "Borrower's insurance, home loans and mortgages, credit repurchase\n\nOpening hours :\nMonday to Friday, 2:00 pm to 6:00 pm.\nSaturday by appointment"
        ],
        "it": [
          "Assicurazione prestiti, mutui e prestiti a domicilio, riacquisto di crediti\n\nOrari di apertura :\nDa lunedì a venerdì dalle 14:00 alle 18:00.\nSabato su appuntamento"
        ],
        "fr": [
          "Assurance emprunteur, prêt et crédit immobilier, rachat de crédits\n\nHoraires d’ouverture :\nDu lundi au vendredi de 14h00 à 18h00.\nLe Samedi sur rendez-vous"
        ],
        "es": [
          "Seguros de préstamos, préstamos hipotecarios y de vivienda, recompra de créditos\n\nHorario de apertura :\nDe lunes a viernes de 14:00 a 18:00.\nSábado con cita previa"
        ],
        "nl": [
          "Leningverzekering, woningkredieten en hypotheken, kredietterugkoop\n\nOpeningstijden :\nMaandag tot vrijdag van 14:00 tot 18:00.\nZaterdag op afspraak"
        ]
      },
