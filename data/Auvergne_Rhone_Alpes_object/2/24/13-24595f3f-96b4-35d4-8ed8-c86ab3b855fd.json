  "rdfs:comment": {
    "de": [
      "Spezialist für den Verkauf von Autoersatzteilen großer Marken zu kleinen Preisen. Qualität ist garantiert. Vielfältige Auswahl und garantierte Ersparnisse, damit Sie Ihr Fahrzeug vertrauensvoll warten oder reparieren können."
    ],
    "en": [
      "Specialist in the sale of car parts from major brands at low prices. Quality guaranteed. Varied choice and guaranteed savings to maintain or repair your vehicle with confidence."
    ],
    "it": [
      "Specialista nella vendita di ricambi auto delle principali marche a prezzi bassi. Qualità garantita. Un'ampia scelta e un risparmio garantito per mantenere o riparare il vostro veicolo in tutta tranquillità."
    ],
    "fr": [
      "Spécialiste en vente de pièces détachées automobiles de grandes marques à petits prix. Qualité garantie. Choix varié et économies assurées pour entretenir ou réparer votre véhicule en toute confiance."
    ],
    "nl": [
      "Specialist in de verkoop van auto-onderdelen van grote merken tegen lage prijzen. Kwaliteit gegarandeerd. Een ruime keuze en gegarandeerde besparingen om je auto met vertrouwen te onderhouden of repareren."
    ],
    "es": [
      "Especialista en la venta de recambios de coche de las principales marcas a precios bajos. Calidad garantizada. Una amplia elección y un ahorro garantizado para mantener o reparar su vehículo con confianza."
    ]
  },
