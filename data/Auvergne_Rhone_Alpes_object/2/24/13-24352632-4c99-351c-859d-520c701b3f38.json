  "rdfs:comment": {
    "de": [
      "In einem kleinen grünen Dorf in Illiat im Departement Ain zwischen Dombes, Bresse und Beaujolais können Sie die vom Chefkoch zubereiteten Spezialitäten genießen: frische Frösche nach Belieben, Bresse-Huhn AOC aus dem Dorf in Sahnesoße und hausgemachtes Eis mit natürlichen Aromen."
    ],
    "en": [
      "In Illiat, a small, leafy village in the Ain between the Dombes, Bresse and Beaujolais regions, come and enjoy the Chef's specialities: fresh frogs as much as you like, AOC Bresse chicken from the village in cream sauce and homemade ice creams with natural flavours."
    ],
    "it": [
      "A Illiat, un piccolo e verdeggiante villaggio nell'Ain tra le regioni di Dombes, Bresse e Beaujolais, venite a gustare le specialità dello chef: rane fresche a volontà, pollo AOC Bresse del villaggio in salsa di panna e gelati fatti in casa ai gusti naturali."
    ],
    "fr": [
      "Dans un petit village verdoyant de l’Ain à Illiat entre Dombes, Bresse et Beaujolais, venez déguster les spécialités cuisinées par le Chef : grenouilles fraîches à volonté, poulet de Bresse AOC du village à la crème et glaces maison aux parfums naturels."
    ],
    "nl": [
      "Kom in Illiat, een klein, lommerrijk dorpje in de Ain tussen de Dombes, Bresse en Beaujolais, genieten van de specialiteiten van de chef: verse kikkers zoveel je maar wilt, AOC Bresse-kip uit het dorp in roomsaus en huisgemaakt ijs met natuurlijke smaken."
    ],
    "es": [
      "En Illiat, pequeño y frondoso pueblo del Ain entre las regiones de Dombes, Bresse y Beaujolais, venga a degustar las especialidades del Chef: ranas frescas a voluntad, pollo de Bresse AOC del pueblo en salsa de nata y helados caseros con sabores naturales."
    ]
  },
