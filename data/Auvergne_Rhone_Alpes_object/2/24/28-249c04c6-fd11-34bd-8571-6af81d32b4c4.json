  "rdfs:comment": {
    "de": [
      "Vom traditionellen French Cancan bis hin zu moderner Musik? Erleben Sie eine Pariser Nacht voller Federn, Rüschen und Pailletten... entdecken Sie Paris By Night!"
    ],
    "en": [
      "From traditional French Cancan to modern music? Come and experience a Parisian night full of feathers, frills and sequins? come and discover Paris By Night!"
    ],
    "it": [
      "Dal tradizionale Cancan francese alla musica moderna? Venite a vivere una notte parigina piena di piume, fronzoli e lustrini? Venite a scoprire Paris By Night!"
    ],
    "fr": [
      "Du French Cancan traditionnel aux musiques modernes… Venez vivre une nuit parisienne pleine de plumes, de froufrous et de paillettes… venez découvrir Paris By Night !"
    ],
    "es": [
      "¿Del tradicional cancán francés a la música moderna? Venga a vivir una noche parisina llena de plumas, volantes y lentejuelas... ¡venga a descubrir Paris By Night!"
    ],
    "nl": [
      "Van traditionele Franse Cancan tot moderne muziek? Kom en beleef een Parijse nacht vol veren, franjes en lovertjes? Kom en ontdek Paris By Night!"
    ]
  },
