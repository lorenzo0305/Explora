  "rdfs:comment": {
    "de": [
      "Der Plan d'eau de Chavenan befindet sich in der Gemeinde Régny und ist Eigentum der Gemeinde.\r\nDer Angelverein AAPPMA \"Les Amis pêcheurs de Régny\" ist der Hauptnutzer."
    ],
    "en": [
      "The Chavenan lake is located in the commune of Régny, and is owned by the commune.\r\nThe main user is the fishing association AAPPMA \"Les Amis pêcheurs de Régny\"."
    ],
    "it": [
      "Il lago di Chavenan si trova nel comune di Régny ed è di proprietà del comune.\r\nL'associazione di pesca AAPPMA \"Les Amis pêcheurs de Régny\" è il principale utilizzatore."
    ],
    "fr": [
      "Le plan d'eau de Chavenan est situé sur la commune de Régny, propriété de la commune.\r\nL'association de Pêche AAPPMA \"Les Amis pêcheurs de Régny\" en est la principale utilisatrice."
    ],
    "nl": [
      "Het meer van Chavenan ligt in de gemeente Régny en is eigendom van de gemeente.\r\nDe visvereniging AAPPMA \"Les Amis pêcheurs de Régny\" is de belangrijkste gebruiker."
    ],
    "es": [
      "El lago de Chavenan está situado en el municipio de Régny y es propiedad del municipio.\r\nLa asociación de pescadores AAPPMA \"Les Amis pêcheurs de Régny\" es el principal usuario."
    ]
  },
  "rdfs:label": {
