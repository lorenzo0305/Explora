  "rdfs:comment": {
    "de": [
      "Café-Restaurant in einer authentischen Almhütte, die geschmackvoll renoviert wurde (Komfort und Authentizität). Hausgemachte, gesellige und raffinierte Küche. Freier Blick auf die Aravis-Kette. Große Terrasse."
    ],
    "en": [
      "Café-restaurant in an authentic alpine chalet renovated with taste (comfort and authenticity). Home-made, friendly and refined cuisine. Unobstructed view of the Aravis mountain range. Large terrace."
    ],
    "it": [
      "Caffè-ristorante in un autentico chalet alpino ristrutturato con gusto (comfort e autenticità). Cucina casalinga, amichevole e raffinata. Vista senza ostacoli sulla catena montuosa degli Aravis. Grande terrazza."
    ],
    "fr": [
      "Café-restaurant dans un authentique chalet d'alpage rénové avec goût (confort et authenticité). Cuisine maison, conviviale et raffinée. Vue dégagée sur la Chaîne des Aravis. Grande terrasse."
    ],
    "es": [
      "Café-restaurante en un auténtico chalet alpino renovado con gusto (confort y autenticidad). Cocina casera, amable y refinada. Vista sin obstáculos de la cordillera de Aravis. Amplia terraza."
    ],
    "nl": [
      "Café-restaurant in een authentiek chalet in de Alpen, gerenoveerd met smaak (comfort en authenticiteit). Huisgemaakte, vriendelijke en verfijnde keuken. Vrij uitzicht op het Aravis gebergte. Groot terras."
    ]
  },
