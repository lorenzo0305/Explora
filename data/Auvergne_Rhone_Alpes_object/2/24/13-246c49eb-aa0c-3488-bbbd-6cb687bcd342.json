  "rdfs:comment": {
    "de": [
      "Das White Moon ist eine Lounge-Bar in der 5-Sterne-Residenz CGH Le White Pearl Lodge &amp; Spa. Ihr freundlicher und gemütlicher Raum steht im Einklang mit dem wohlwollenden Barteam."
    ],
    "en": [
      "The White Moon is a lounge bar in 5* CGH residence the White Pearl Lodge & Spa. It has a warm, convivial atmosphere and a great team of bar staff."
    ],
    "it": [
      "Il White Moon è un lounge bar situato nella residenza 5 stelle CGH Le White Pearl Lodge & Spa. La sua atmosfera calda e accogliente è accompagnata dalla cordialità del team del bar."
    ],
    "fr": [
      "Le White Moon est un bar lounge situé au sein de la résidence 5 étoiles CGH Le White Pearl Lodge & Spa. Son espace convivial et chaleureux est en accord avec la bienveillance de l’équipe du bar."
    ],
    "nl": [
      "The White Moon is een loungebar gelegen in de 5-sterren CGH residentie Le White Pearl Lodge & Spa. De warme en gezellige ruimte past bij de vriendelijkheid van het barteam."
    ],
    "es": [
      "El White Moon es un lounge bar situado en la residencia de 5 estrellas CGH Le White Pearl Lodge & Spa. Su ambiente cálido y acogedor se corresponde con la amabilidad del equipo del bar."
    ]
  },
