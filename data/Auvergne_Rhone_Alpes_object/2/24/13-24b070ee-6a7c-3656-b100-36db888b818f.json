  "rdfs:comment": {
    "de": [
      "Küche aus der Nähe, die mit lokalen Produkten hergestellt wird. Es liegt uns am Herzen, mit lokalen Produzenten und Produkten aus der Region zusammenzuarbeiten. Wir wählen unsere Produzenten, die uns seit Beginn unseres Abenteuers begleiten, sorgfältig aus."
    ],
    "en": [
      "Local cuisine, made with local products. We are committed to working with local producers and local products. We carefully select our producers, who have been with us since the beginning of our adventure."
    ],
    "it": [
      "Cucina locale, fatta con prodotti locali. Ci impegniamo a lavorare con produttori e prodotti locali. Selezioniamo con cura i nostri produttori, che sono con noi fin dall'inizio della nostra avventura."
    ],
    "fr": [
      "Cuisine de proximité, réalisée avec des produits locaux. Nous avons à cœur de travailler avec des producteurs locaux, des produits du terroir. Nous sélectionnons avec soin nos producteurs qui nous accompagne depuis le début de notre aventure."
    ],
    "nl": [
      "Lokale gerechten, gemaakt met lokale producten. We werken graag met lokale producenten en lokale producten. We kiezen onze producenten, die al sinds het begin van ons avontuur bij ons zijn, zorgvuldig uit."
    ],
    "es": [
      "Cocina local, elaborada con productos locales. Nos comprometemos a trabajar con productores y productos locales. Seleccionamos cuidadosamente a nuestros productores, que llevan con nosotros desde el principio de nuestra aventura."
    ]
  },
  "rdfs:label": {
    "fr": [
