  "rdfs:comment": {
    "de": [
      "Rase mit dem Schienenschlitten die Piste hinunter und halte den Moment mit dem Photopoint fest - eine unvergessliche Erinnerung an deine adrenalinreiche Abfahrt!"
    ],
    "en": [
      "Take to the slopes on the rail sled and capture the moment with the Photopoint: an unforgettable souvenir of your adrenalin-filled descent!"
    ],
