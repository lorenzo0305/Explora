  "rdfs:comment": {
    "de": [
      "Ein Schwimmbad im Herzen der Universität, um zwischen zwei Hörsälen ein paar Bahnen zu ziehen. Zugänglich für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "A swimming-pool with an Olympic pool for good swimmers, but also accessible to people with reduced mobility. Students will enjoy swimming a few lengths between two lectures in the middle of the University Campus !"
    ],
    "it": [
      "Una piscina nel cuore dell'Università, per godersi qualche vasca tra due aule. Accessibile alle persone a mobilità ridotta."
    ],
    "fr": [
      "Une piscine au coeur de l'Université, pour apprécier faire quelques longueurs entre deux amphithéâtres. Accessible pour les personnes à mobilité réduite."
    ],
    "es": [
      "Una piscina en el corazón de la Universidad, para disfrutar de unos largos entre dos aulas. Accesible para personas con movilidad reducida."
    ],
    "nl": [
      "Een zwembad in het hart van de universiteit, om een paar baantjes te trekken tussen twee collegezalen. Toegankelijk voor mensen met beperkte mobiliteit."
    ]
  },
