  "rdfs:comment": {
    "de": [
      "Traditionelles Patronatsfest im Marktflecken, organisiert vom Festkomitee mit Boule-Wettbewerb um 14 Uhr, Schinken am Spieß um 19 Uhr, Tanz und Feuerwerk am Abend (Samstag) und der berühmten Fahrradtour um 7 Uhr am Sonntag mit Essen um 12 Uhr"
    ],
    "en": [
      "Traditional fête patronale in the village organized by the Comité des fêtes, with pétanque competition at 2pm, ham on the spit at 7pm, dance and fireworks in the evening (Saturday) and the famous cycle tour at 7am on Sunday, with lunch at 12pm"
    ],
    "it": [
      "Tradizionale festa patronale del villaggio organizzata dal Comité des fêtes con gara di bocce alle 14.00, prosciutto allo spiedo alle 19.00, ballo e fuochi d'artificio la sera (sabato) e il famoso giro in bicicletta alle 7.00 della domenica con pranzo alle 12.00"
    ],
    "fr": [
      "Traditionnelle fête patronale dans le bourg organisée par le Comité des fêtes avec concours de pétanque à 14h, jambon à la broche à 19h, bal et feux d'artifice en soirée (samedi) et la célèbre randonnée cyclotouristique à 7 h dimanche avec repas à 12h"
    ],
    "nl": [
      "Traditioneel patronaatsfeest in het dorp georganiseerd door het Comité des fêtes met petanquewedstrijd om 14.00 uur, ham aan het spit om 19.00 uur, dans en vuurwerk 's avonds (zaterdag) en de beroemde fietstocht om 7.00 uur op zondag met lunch om 12.00 uur"
    ],
    "es": [
      "Tradicional fiesta patronal del pueblo organizada por el Comité des fêtes con competición de petanca a las 14h, jamón al espeto a las 19h, baile y fuegos artificiales por la noche (sábado) y la famosa vuelta ciclista a las 7h el domingo con almuerzo a las 12h"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête patronale de Sembadel"
    ]
  },
