  "rdfs:comment": {
    "de": [
      "Wasserskilift mit Hin- und Rückfahrt auf einer Strecke von ca. 150 m mit Modulen, um Sprünge zu machen.\r\nSkifahren, Wakeboarding, Babyski und Schwimmreifen.\r\nVor Ort angebotene Snacks (Hotdogs, Pommes frites, Bier, Wasser, Softdrinks usw.)."
    ],
    "en": [
      "Round trip water-skiing over a distance of approx. 150 m with jumping modules.\r\nSkiing, wakeboarding and buoyancy.\r\nSnacks available on site (hot dogs, burgers, Ice cream, French fries, beer, water, soft drinks, etc.)."
    ],
    "it": [
      "Un impianto di risalita per lo sci nautico di circa 150 m con moduli di salto.\r\nSci, wakeboard e galleggiamento.\r\nSnack disponibili in loco (hot dog, hamburger, waffle, gelati, patatine fritte, birra, acqua, bibite, ecc.)"
    ],
    "fr": [
      "Téléski nautique en aller-retour sur une distance de 150m environ avec modules pour faire des sauts.\r\nPratique du ski, wakeboard et bouée.\r\nSnacks proposés sur place (hot dogs, burgers, gaufres, glaces, frites, bières, eaux, boissons gazeuses, etc...)"
    ],
    "es": [
      "Un telesquí acuático de ida y vuelta de unos 150 m con módulos de salto.\r\nEsquí, wakeboard y flotabilidad.\r\nSnacks disponibles in situ (perritos calientes, hamburguesas, gofres, helados, patatas fritas, cerveza, agua, refrescos, etc.)"
    ],
    "nl": [
      "Een waterskilift van ongeveer 150 m heen en terug met springmodules.\r\nSkiën, wakeboarden en drijfvermogen.\r\nSnacks ter plaatse verkrijgbaar (hotdogs, hamburgers, wafels, ijsjes, chips, bier, water, frisdrank, enz.)"
    ]
  },
