  "rdfs:comment": {
    "de": [
      "Schnellrestaurant und savoyische Spezialitäten. Hamburger aus eigener Herstellung.\r\nZugang über den Sessellift Pierre Longue in Pré La Joux.\r\nAuch für Fußgänger zugänglich.\r\nGeöffnet Winter - Sommer."
    ],
    "en": [
      "Quick service restaurant and savoyard speciality \r\nHome made hamburger \r\nAccess by chairlift \"Pierre Longue\" in Pré la Joux\r\nPedestrian accessible\r\nOpen winter and summer"
    ],
    "it": [
      "Fast food e specialità savoiarde. Hamburger fatto in casa.\r\nAccesso tramite la seggiovia Pierre Longue a Pré La Joux.\r\nAccessibile ai pedoni.\r\nAperta in inverno e in estate."
    ],
    "fr": [
      "Restauration rapide et spécialité savoyarde. Hamburger maison.\r\nAccès par le télésiège de Pierre Longue à Pré La Joux.\r\nAccessible aux piétons.\r\nOuvert hiver - été."
    ],
    "nl": [
      "Fast food en Savoyaardse specialiteiten. Huisgemaakte hamburger.\r\nToegang via de stoeltjeslift Pierre Longue bij Pré La Joux.\r\nToegankelijk voor voetgangers.\r\nWinter en zomer geopend."
    ],
    "es": [
      "Comida rápida y especialidades saboyanas. Hamburguesa casera.\r\nAcceso por el telesilla Pierre Longue de Pré La Joux.\r\nAccesible para los peatones.\r\nAbierto de invierno a verano."
    ]
  },
