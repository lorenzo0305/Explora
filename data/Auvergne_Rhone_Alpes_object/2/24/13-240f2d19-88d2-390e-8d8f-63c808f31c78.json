  "rdfs:comment": {
    "de": [
      "Der Plan d'eau de Coise, eine ehemalige Kiesgrube, die neu gestaltet wurde, bietet Ihnen die Möglichkeit, die Freuden des Angelns in der schönen Jahreszeit zu genießen.\r\nDas Angeln auf Karpfen erfolgt im No-Kill-Verfahren mit nur einem Haken ohne Widerhaken."
    ],
    "en": [
      "The lake of Coise will give you the opportunity to enjoy fishing during the summer."
    ],
    "it": [
      "Il lago Coise, ex cava di ghiaia, è stato riqualificato per farvi provare il piacere della pesca nei mesi estivi.\r\nLa pesca alla carpa è no-kill con un solo amo senza ardiglione."
    ],
    "fr": [
      "Le plan d'eau de Coise, ancienne gravière réaménagée, vous permettra de goûter aux plaisirs de la pêche à la belle saison.\r\nLa pêche à la carpe est en no-kill avec 1 seul hameçon sans ardillon."
    ],
    "nl": [
      "Het Coise-meer, een voormalige grindgroeve, is heringericht om je te laten proeven van het plezier van vissen in de zomermaanden.\r\nKarpervissen is no-kill met een enkele weerhaakloze haak."
    ],
    "es": [
      "El lago Coise, una antigua gravera, le permitirá disfrutar de la pesca en verano.\r\nLa pesca de la carpa es sin muerte con un solo anzuelo sin púas."
    ]
  },
  "rdfs:label": {
