  "rdfs:comment": {
    "de": [
      "Verkauf von Schweinefleisch und Wurstwaren, auf dem Hof und auf den Märkten: Retournac (Mittwochmorgen), Craponne (Samstagmorgen) und Vorey (Sonntagmorgen)."
    ],
    "en": [
      "Sale of pork and charcuterie at the farm and on the markets: Retournac (Wednesday morning), Craponne (Saturday morning) and Vorey (Sunday morning)."
    ],
    "it": [
      "Vendita di carne di maiale e salumi, in azienda e nei mercati: Retournac (mercoledì mattina), Craponne (sabato mattina) e Vorey (domenica mattina)."
    ],
    "fr": [
      "Vente de viande de porc et de charcuteries, à la ferme et sur les marchés : Retournac (mercredi matin), Craponne (samedi matin) et Vorey (dimanche matin)."
    ],
    "nl": [
      "Verkoop van varkensvlees en vleeswaren, op de boerderij en op de markten: Retournac (woensdagochtend), Craponne (zaterdagochtend) en Vorey (zondagochtend)."
    ],
    "es": [
      "Venta de carne de cerdo y embutidos, en la granja y en los mercados: Retournac (miércoles por la mañana), Craponne (sábado por la mañana) y Vorey (domingo por la mañana)."
    ]
  },
