  "rdfs:comment": {
    "de": [
      "Möchten Sie eine Partie Tennis spielen? Zögern Sie nicht, im Informationszentrum der Gemeinde nach Informationen zu fragen!\nEine Lizenz ist Pflicht (kann vor Ort erworben werden)."
    ],
    "en": [
      "Would you like to play a game of tennis? Don't hesitate to ask for more information at the local information point!\nA tennis license is required (available on site)."
    ],
    "it": [
      "Ti piacerebbe giocare a tennis? Non esitate a chiedere tutte le informazioni di cui avete bisogno al punto informativo in città!\nLa licenza è obbligatoria (può essere acquistata sul posto)."
    ],
    "fr": [
      "Vous souhaitez faire une partie de tennis? N'hésitez pas à demander tous les renseignements au point Information de la commune!\nLa licence est obligatoire (possibilité de souscrir sur place)."
    ],
    "es": [
      "¿Te gustaría jugar al tenis? No dude en pedir toda la información que necesite en el punto de información de la ciudad\nLa licencia es obligatoria (puede adquirirse in situ)."
    ],
    "nl": [
      "Wil je een partijtje tennis spelen? Aarzel niet om alle informatie te vragen die je nodig hebt bij het plaatselijke informatiepunt!\nEen licentie is verplicht (ter plaatse verkrijgbaar)."
    ]
  },
