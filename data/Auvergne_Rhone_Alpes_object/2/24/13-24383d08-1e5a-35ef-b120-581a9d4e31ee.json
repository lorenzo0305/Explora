  "rdfs:comment": {
    "de": [
      "A Table! bietet Ihnen eine einfache und schmackhafte Küche in einer zeitgemäßen und freundlichen Atmosphäre. Das Restaurant liegt an der Autobahnraststätte Mionnay (A46).\r\nMit A Table! nehmen Sie sich die Zeit für eine echte Pause, um sich zu entspannen und zu essen."
    ],
    "en": [
      "A Table ! offers you a simple and tasty cuisine in a contemporary and friendly atmosphere, located on the Mionnay highway (A46).\r\nWith A Table ! you can take the time to relax and eat."
    ],
    "it": [
      "A Table ! offre una cucina semplice e gustosa in un'atmosfera contemporanea e accogliente, situata nell'area di servizio autostradale di Mionnay (A46).\r\nCon A Table ! potete prendervi il tempo per rilassarvi e godervi una vera pausa."
    ],
    "fr": [
      "A Table ! vous propose une cuisine simple et savoureuse dans une atmosphère contemporaine et conviviale,  situé sur l'aire d'autoroute de Mionnay (A46).\r\nAvec A Table !, prenez le temps de faire une vraie pause pour vous relaxer et vous restaurer."
    ],
    "es": [
      "A Table ! ofrece una cocina sencilla y sabrosa en un ambiente contemporáneo y acogedor, situado en el área de servicio de la autopista de Mionnay (A46).\r\nCon A Table ! puede tomarse el tiempo para relajarse y disfrutar de un verdadero descanso."
    ],
    "nl": [
      "A Table ! biedt een eenvoudige en smakelijke keuken in een eigentijdse en vriendelijke sfeer, gelegen aan de verzorgingsplaats van de snelweg Mionnay (A46).\r\nMet A Table ! kunt u de tijd nemen om te ontspannen en te genieten van een echte pauze."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant A Table !"
    ]
  },
