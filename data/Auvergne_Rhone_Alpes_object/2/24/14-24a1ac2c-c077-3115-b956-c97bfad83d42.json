  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f28477ab-eebc-33d7-9736-34aecc1d0d59",
      "dc:description": {
        "de": [
          "Rotisserie auf den Märkten von Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nDas gesamte Geflügel wird in Steenbecque im Norden gezüchtet und zubereitet."
        ],
        "en": [
          "Rotisserie on the markets of Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nAll poultry is raised and prepared in Steenbecque in the Nord region of France."
        ],
        "it": [
          "Rosticceria sui mercati di Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nTutto il nostro pollame è allevato e preparato a Steenbecque, nel nord della Francia."
        ],
        "fr": [
          "Rôtisserie sur les marchés d'Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nToute la volaille est élevée, préparée à Steenbecque dans le Nord."
        ],
        "nl": [
          "Rotisserie op de markten van Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nAl ons gevogelte wordt gefokt en bereid in Steenbecque in het noorden van Frankrijk."
        ],
        "es": [
          "Asador en los mercados de Etaples, Berck, Cucq/Stella-plage, Rang-du-Fliers.\nTodas nuestras aves se crían y preparan en Steenbecque, en el norte de Francia."
        ]
      },
