  "rdfs:comment": {
    "de": [
      "Einführung und Entdeckung des Sportfallschirmspringens. Sprung von 50 Sekunden im freien Fall und 4 bis 8 Minuten unter dem Schirm. Es besteht die Möglichkeit, einen Tandemsprung durchzuführen, der mit einem Tandemfallschirm und einem staatlich geprüften Lehrer durchgeführt wird."
    ],
    "en": [
      "Discovery and beginners courses for skydiving, with 50 seconds free fall\r\njumps with 4 to 8 mins gliding. Possibility of tandem jumps with a qualified instructor"
    ],
    "it": [
      "Iniziazione e scoperta del paracadutismo sportivo. 50 secondi di salto in caduta libera e da 4 a 8 minuti sotto il baldacchino. Possibilità di effettuare un lancio in tandem con un paracadute biposto con un istruttore qualificato."
    ],
    "fr": [
      "Initiation et découverte du parachutisme sportif. Saut de 50 secondes en chute libre et 4 à 8 minutes sous voile. Possibilité d'exécuter un saut en tandem effectué en parachute biplace avec un moniteur diplômé d'état."
    ],
    "nl": [
      "Initiatie en ontdekking van sport parachutespringen. 50 seconden vrije val sprong en 4 tot 8 minuten onder baldakijn. Mogelijkheid tot het uitvoeren van een tandemsprong in een tweepersoons parachute met een staatsgediplomeerde instructeur."
    ],
    "es": [
      "Iniciación y descubrimiento del paracaidismo deportivo. 50 segundos de salto en caída libre y de 4 a 8 minutos bajo el dosel. Posibilidad de realizar un salto tándem en paracaídas biplaza con un instructor cualificado por el Estado."
    ]
  },
