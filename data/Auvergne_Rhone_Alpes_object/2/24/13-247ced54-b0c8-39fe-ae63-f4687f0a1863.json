  "rdfs:comment": {
    "de": [
      "Nutzen Sie anlässlich Ihrer Veranstaltungen die Exklusivität des \"Château de Féligonde\", um Ihren Gästen historische Authentizität und ein magisches Erlebnis zu bieten."
    ],
    "en": [
      "For your events, take advantage of the exclusivity of the \"Château de Féligonde\" to give your guests a historical authenticity and a magical experience."
    ],
    "it": [
      "Per i vostri eventi, approfittate dell'esclusività dello \"Château de Féligonde\" per regalare ai vostri ospiti un'autenticità storica e un'esperienza magica."
    ],
    "fr": [
      "À l'occasion de vos événements, profitez de l'exclusivité du \"Château de Féligonde\" pour faire vivre une authenticité historique et une expérience magique à vos invités."
    ],
    "nl": [
      "Profiteer voor uw evenementen van de exclusiviteit van het \"Château de Féligonde\" om uw gasten een historische authenticiteit en een magische ervaring te bieden."
    ],
    "es": [
      "Para sus eventos, aproveche la exclusividad del \"Château de Féligonde\" para ofrecer a sus invitados una autenticidad histórica y una experiencia mágica."
    ]
  },
