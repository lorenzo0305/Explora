  "rdfs:comment": {
    "de": [
      "Französischer Garten, hochstämmige Rosensträucher, französischer Gemüsegarten. Nur der Garten und die Außenseite des Denkmals können besichtigt werden. Landschaftspark am Ufer des Genfer Sees."
    ],
    "en": [
      "French garden, high-stemmed roses, French kitchen garden. Only the garden and exterior of the monument are open to visitors. Landscaped park on the shores of Lake Geneva."
    ],
    "it": [
      "Giardino alla francese, rose ad alto fusto, orto alla francese. Solo il giardino e l'esterno del monumento sono aperti ai visitatori. Parco paesaggistico sulle rive del lago di Ginevra."
    ],
    "fr": [
      "Jardin à la française, rosiers haute tige, potager à la française. Uniquement le jardin et l'extérieur du monument se visitent. Parc paysager au bord du Lac Léman."
    ],
    "nl": [
      "Tuin in Franse stijl, rozen met hoge stammen, moestuin in Franse stijl. Alleen de tuin en de buitenkant van het monument zijn toegankelijk voor bezoekers. Aangelegd park aan de oevers van het meer van Genève."
    ],
    "es": [
      "Jardín francés, rosas altas, huerto francés. Sólo se puede visitar el jardín y el exterior del monumento. Parque ajardinado a orillas del lago de Ginebra."
    ]
  },
  "rdfs:label": {
