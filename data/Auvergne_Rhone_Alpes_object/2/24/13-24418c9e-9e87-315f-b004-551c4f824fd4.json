  "rdfs:comment": {
    "de": [
      "Der Sierroz ist ein reißender, wilder Bach, der aus dem Massif des Bauges fließt und immer städtischer wird, je näher er seiner Mündung in den Lac du Bourget kommt."
    ],
    "en": [
      "The Sierroz is a torrential and wild stream flowing from the Bauges massif and becoming more and more urban as it approaches its mouth with the Bourget lake."
    ],
    "it": [
      "Il Sierroz è un torrente torrenziale e selvaggio che scorre dal massiccio dei Bauges e diventa sempre più urbano man mano che si avvicina alla sua foce con il Lac du Bourget."
    ],
    "fr": [
      "Le Sierroz est un ruisseau torrentueux et sauvage s'écoulant du massif des Bauges et devenant de plus en plus urbain en se rapprochant de son embouchure avec le lac du Bourget."
    ],
    "es": [
      "El Sierroz es un torrente torrencial y salvaje que fluye desde el macizo de Bauges y se va urbanizando a medida que se acerca a su desembocadura con el Lac du Bourget."
    ],
    "nl": [
      "De Sierroz is een onstuimige en wilde stroom die uit het Bauges-massief komt en steeds stedelijker wordt naarmate hij zijn monding met het Lac du Bourget nadert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sierroz"
    ]
  },
