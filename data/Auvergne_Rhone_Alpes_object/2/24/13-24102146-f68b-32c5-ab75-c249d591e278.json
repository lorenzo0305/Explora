  "rdfs:comment": {
    "de": [
      "Möchten Sie das Skitourengehen in Orelle, dem Tor zu den 3 Vallées, entdecken?\r\nLa Trace du Loup ist eine markierte und gesicherte Skitourenroute, die ideal ist, um in einer außergewöhnlichen natürlichen Umgebung zu trainieren oder zu lernen."
    ],
    "en": [
      "Looking to discover ski touring in Orelle, the gateway to Les 3 Vallées?\r\n\r\nLa Trace du Loup is a dedicated, marked and secured ski touring route — ideal for beginners or for training in an outstanding natural setting."
    ],
    "it": [
      "Vuoi scoprire lo sci alpinismo a Orelle, porta d’accesso alle 3 Vallées?\r\n\r\nLa Trace du Loup è un itinerario dedicato allo sci alpinismo, segnalato e sicuro, ideale per iniziare o allenarsi in un contesto naturale eccezionale."
    ],
    "fr": [
      "Envie de découvrir le ski de randonnée à Orelle, porte d’entrée des 3 Vallées ?\r\nLa Trace du Loup est un itinéraire dédié au ski de randonnée, balisé et sécurisé, idéal pour s’initier ou s’entraîner dans un cadre naturel exceptionnel."
    ],
    "es": [
      "¿Desea descubrir el esquí de travesía en Orelle, puerta de entrada a los 3 Valles?\r\nLa Trace du Loup es una ruta de esquí de travesía dedicada, señalizada y segura, ideal para esquiadores principiantes y avanzados en un entorno natural excepcional."
    ],
    "nl": [
      "Wil je het toerskiën ontdekken in Orelle, de toegangspoort tot de 3 Valleien?\r\nLa Trace du Loup is een speciale, bewegwijzerde en veilige toerskiroute, ideaal voor beginners en gevorderden in een uitzonderlijke natuurlijke omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ski Touring Route: La Trace du Loup – Orelle"
    ],
    "it": [
      "Itinerario di Sci Alpinismo: La Trace du Loup – Orelle"
    ],
    "fr": [
      "Itinéraire Ski de randonnée : La Trace du Loup"
    ]
  },
