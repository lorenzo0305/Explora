  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Musée Fantastique de La Bête du Gévaudan (Fantastisches Museum der Bestie von Gévaudan).\r\nDer Rundgang mit 22 Szenen erzählt Ihnen die Geschichte von La Bête, die von 1764 bis 1767 hundert Menschen tötete und verschlang..."
    ],
    "en": [
      "Come and discover the Musée Fantastique de La Bête du Gévaudan.\r\nThe 22-scene tour tells the story of La Bête, who killed and devoured hundreds of people between 1764 and 1767..."
    ],
    "it": [
      "Venite a scoprire il Musée Fantastique de La Bête du Gévaudan.\r\nIl percorso di 22 scene racconta la storia de La Bête, che uccise e divorò un centinaio di persone tra il 1764 e il 1767..."
    ],
    "fr": [
      "Venez découvrir Le Musée Fantastique de La Bête du Gévaudan.\r\nLe parcours de 22 scènes vous raconte l'histoire de La Bête qui, de 1764 à 1767,  tua et dévora une centaine personnes..."
    ],
    "es": [
      "Venga a descubrir el Musée Fantastique de La Bête du Gévaudan.\r\nEl recorrido de 22 escenas cuenta la historia de La Bête, que mató y devoró a un centenar de personas entre 1764 y 1767...."
    ],
    "nl": [
      "Kom en ontdek het Musée Fantastique de La Bête du Gévaudan.\r\nDe rondleiding met 22 scènes vertelt het verhaal van La Bête, die tussen 1764 en 1767 ongeveer honderd mensen doodde en verslond..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée Fantastique de la Bête du Gévaudan"
    ]
  },
