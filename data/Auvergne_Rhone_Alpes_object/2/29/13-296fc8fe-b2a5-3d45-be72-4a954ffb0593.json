  "rdfs:comment": {
    "de": [
      "Die Distillerie du Vercors liegt im Herzen des grünen Royans-Tals im Regionalen Naturpark Vercors, 30 Minuten von Valence und 1,5 Stunden von Lyon entfernt. Sie stellt die SEQUOIA Bio-Whiskys her, die vor Ort gebraut, destilliert, gelagert und abgefüllt werden."
    ],
    "en": [
      "Nestled in the heart of the green Royans valley, in the Vercors Regional Natural Park, the Vercors Distillery is located at 30 minutes from Valence and 1h30 from Lyon. It produces organic SEQUOIA whiskeys, brewed, distilled, aged and bottled on site. Come to visit us and discover the steps and secrets of creating our Whisky Single Malt."
    ],
    "it": [
      "Immersa nel cuore della verdeggiante valle di Royans, nel Parco Naturale Regionale del Vercors, la Distillerie du Vercors dista 30 minuti da Valence e 1 ora da Lione. Produce whisky biologici SEQUOIA, prodotti, distillati, maturati e imbottigliati in loco."
    ],
    "fr": [
      "Nichée au cœur de la verdoyante vallée du Royans, dans le Parc Naturel Régional du Vercors, la Distillerie du Vercors est à 30mn de Valence et 1h30 de Lyon. Elle produit les whiskies SEQUOIA  bio, brassés, distillés, élevés et mis en bouteilles sur place."
    ],
    "es": [
      "Enclavada en el corazón del verde valle de Royans, en el Parque Natural Regional de Vercors, la Distillerie du Vercors se encuentra a 30 minutos de Valence y a hora y media de Lyon. Produce los whiskies ecológicos SEQUOIA, elaborados, destilados, madurados y embotellados in situ."
    ],
    "nl": [
      "De Distillerie du Vercors ligt in het hart van de groene Royans-vallei, in het regionale natuurpark Vercors, op 30 minuten van Valence en 1 uur van Lyon. Het produceert SEQUOIA biologische whisky's die ter plekke worden gebrouwen, gedistilleerd, gerijpt en gebotteld."
    ]
  },
