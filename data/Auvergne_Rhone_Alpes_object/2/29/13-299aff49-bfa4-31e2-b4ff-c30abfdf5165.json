  "rdfs:comment": {
    "de": [
      "Die Symphonie der Wolken, eine zärtliche und lustige Aufführung, in der Musik, Tanz und riesige Marionetten Groß und Klein dazu einladen, gemeinsam zu träumen, zu lachen und zu staunen."
    ],
    "en": [
      "La Symphonie des nuées, a tender and funny show, where music, dance and giant puppets invite young and old to dream, laugh and marvel together."
    ],
    "it": [
      "La Symphonie des nuées, uno spettacolo tenero e divertente, dove musica, danza e pupazzi giganti invitano grandi e piccini a sognare, ridere e meravigliarsi insieme."
    ],
    "fr": [
      "La Symphonie des nuées, un spectacle tendre et drôle, où musique, danse et marionnettes géantes invitent petits et grands à rêver, à rire et à s'émerveiller ensemble."
    ],
    "es": [
      "La Symphonie des nuées, un espectáculo tierno y divertido, donde la música, la danza y las marionetas gigantes invitan a grandes y pequeños a soñar, reír y maravillarse juntos."
    ],
    "nl": [
      "La Symphonie des nuées, een tedere en grappige voorstelling, waarin muziek, dans en reuzenpoppen jong en oud uitnodigen om samen te dromen, te lachen en zich te verwonderen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle La Symphonie des nuées - Le Cirque Musical"
    ]
  },
