  "rdfs:comment": {
    "de": [
      "Der Verein Conteurs d'Art präsentiert Ihnen die vierte Ausgabe des Salons Arts du Fil en Auvergne. Diese Veranstaltung ermöglicht es dem Verein, die Fadenkunst (in all ihren Formen und Techniken) zu fördern und aufzuwerten."
    ],
    "en": [
      "The Conteurs d'Art association presents the edition of the Salon Arts du Fil en Auvergne. This event enables the association to promote and develop the arts of thread (in all its forms and techniques)."
    ],
    "it": [
      "L'associazione Conteurs d'Art presenta la quarta edizione del Salon Arts du Fil en Auvergne. Questo evento consente all'associazione di promuovere e sviluppare le arti del filo (in tutte le sue forme e tecniche)."
    ],
    "fr": [
      "L'association Conteurs d'Art vous présente la quatrième édition du Salon Arts du Fil en Auvergne. Cet événement permet à l'association de promouvoir et de valoriser les Arts du fil (sous toutes ses coutures, formes et multi techniques)."
    ],
    "es": [
      "La asociación Conteurs d'Art presenta la cuarta edición del Salon Arts du Fil en Auvergne. Este evento permite a la asociación promover y desarrollar las artes del hilo (en todas sus formas y técnicas)."
    ],
    "nl": [
      "De vereniging Conteurs d'Art presenteert de vierde editie van het Salon Arts du Fil en Auvergne. Dit evenement stelt de vereniging in staat om de kunst van het garen (in al zijn vormen en technieken) te promoten en te ontwikkelen."
    ]
  },
