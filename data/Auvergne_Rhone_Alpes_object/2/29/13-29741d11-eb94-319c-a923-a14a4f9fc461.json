  "rdfs:comment": {
    "de": [
      "Eine einfache, schmackhafte Küche, eine Küche, die schmeckt und Lust auf mehr macht. Amateurgastronomen, die aber von \"guten Dingen\" begeistert sind"
    ],
    "en": [
      "Simple,  delicious food that is full of flavour and tempting. Amateur gourmets who are passionate about ‘good things’."
    ],
    "it": [
      "Cibo semplice e gustoso, cibo che sa di buono e che fa venire voglia di mangiare. Gourmet dilettanti con la passione per le \"cose buone\""
    ],
    "fr": [
      "Une cuisine simple, savoureuse, une cuisine qui a du goût et qui donne envie. Des gastronomes amateurs mais passionnés de \"bonnes choses\""
    ],
    "nl": [
      "Een eenvoudige, smakelijke keuken, een keuken die smaakvol is en waar je zin in krijgt. Amateur-fijnproevers met een passie voor “lekkere dingen”"
    ],
    "es": [
      "Comida sencilla y sabrosa, comida que sabe bien y da ganas de comer. Gourmets aficionados con pasión por las \"cosas buenas\""
    ]
  },
