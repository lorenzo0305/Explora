    "de": [
      "Frühstück, Eis, Grill, Salate, Fisch, Pasta, Pizza ....\r\nDie Köche kochen verschiedene Gerichte aus frischen Produkten."
    ],
    "en": [
      "Breakfast, ice creams, grills, salads, fish, pasta, pizzas ....\r\nThe chefs cook different dishes from fresh produce."
    ],
    "it": [
      "Colazione, gelati, grigliate, insalate, pesce, pasta, pizze....\r\nGli chef cucinano diversi piatti, per lo più con prodotti freschi."
    ],
    "fr": [
      "Petit déjeuner, glaces, grillades, salades, poissons, pâtes, pizzas....\r\nLes chefs cuisinent des plats différents majoritairement à partir de produits frais."
