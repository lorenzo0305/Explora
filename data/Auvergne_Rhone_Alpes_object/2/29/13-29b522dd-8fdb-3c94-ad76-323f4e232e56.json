  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser Restaurant im Herzen der ehemaligen Kartause. Es ist das einzige Kartäuserkloster, aus der ein Dorf entstanden ist (in Frankreich einzigartig). Im Regionalen Naturpark Pilat gelegen, zählt dieses \"Village d'Amour\" (Dorf der Liebe) zu den schönsten Frankreichs."
    ],
    "en": [
      "Come and visit our restaurant in the heart of a former chartreuse monastery, the only one in France to be transformed into a village. The village of Amour is one of the most beautiful in France and is located in Pilat Regional Park."
    ],
    "it": [
      "Scoprite il ristorante Le prieuré, situato nel cuore di un'antica certosa. Unico in Francia, è la sola certosa ad essere stata trasformata in villaggio durante la Rivoluzione francese. Lo chef, un ottuagenario appassionato, vi delizierà con la sua cucina tradizionale."
    ],
    "fr": [
      "Découvrez le restaurant Le prieuré, situé au cœur d'une ancienne chartreuse. Unique en France, c'est la seule chartreuse qui a été transformée en village à la Révolution. Le chef, octogénaire passionné saura vous satisfaire par sa cuisine traditionnelle."
    ],
    "nl": [
      "Ontdek restaurant Le prieuré, gelegen in het hart van een voormalig kartuizerklooster. Uniek in Frankrijk, het is het enige kartuizerklooster dat tijdens de Franse Revolutie is omgetoverd tot een dorp. De chef, een gepassioneerde tachtigjarige, zal je verrukken met zijn traditionele keuken."
    ],
    "es": [
      "Descubra el restaurante Le prieuré, situado en el corazón de una antigua cartuja. Único en Francia, es la única cartuja transformada en pueblo durante la Revolución Francesa. El chef, un octogenario apasionado, le deleitará con su cocina tradicional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Prieuré"
    ]
  },
