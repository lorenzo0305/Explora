  "rdfs:comment": {
    "de": [
      "Als ehemaliger Spitzensportler und immer noch sportbegeistert, hat Patrick beschlossen, all seine sportlichen Erfahrungen zu teilen und weiterzugeben, damit Sie Ihr persönliches Ziel erreichen können."
    ],
    "en": [
      "A former top-level sportsman and still passionate about sport, Patrick has decided to share and pass on all his sporting experience to help you achieve your personal goals."
    ],
    "it": [
      "Ex sportivo di alto livello ancora appassionato di sport, Patrick ha deciso di condividere e trasmettere tutta la sua esperienza sportiva per aiutarvi a raggiungere i vostri obiettivi personali."
    ],
    "fr": [
      "Ancien sportif de haut niveau et toujours passionné par le sport, Patrick a décidé de partager et de transmettre toutes ses expériences sportives pour vous permettre de réaliser votre objectif personnel."
    ],
    "es": [
      "Antiguo deportista de alto nivel que sigue siendo un apasionado del deporte, Patrick ha decidido compartir y transmitir toda su experiencia deportiva para ayudarle a alcanzar sus objetivos personales."
    ],
    "nl": [
      "Als voormalig topsporter die nog steeds gepassioneerd is door sport, heeft Patrick besloten al zijn sportervaring te delen en door te geven om jou te helpen je persoonlijke doelen te bereiken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Before After Work - Coach Sportif"
    ]
  },
