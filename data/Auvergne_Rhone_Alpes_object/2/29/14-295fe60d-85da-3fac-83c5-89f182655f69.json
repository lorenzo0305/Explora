  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d602d89f-5107-3f67-a224-bc7f0ea18971",
      "dc:description": {
        "de": [
          "Wie jedes Jahr organisiert Lebiez seine Ducasse\nTreffpunkt am Samstag, den 12. Juli um 19:30 Uhr - Konzertmahlzeit\nPreis für Erwachsene: 20? - Preis für Kinder: 8?\nReservierung unter 06 86 57 77 91 bis zum 8. Juli"
        ],
        "en": [
          "As every year, Lebiez organizes its ducasse\nRendezvous on Saturday, July 12 at 7:30 pm - Concert meal\nAdult price: 20? - Children: 8?\nReservation on 06 86 57 77 91 before July 8"
        ],
        "it": [
          "Come ogni anno, Lebiez organizza la sua ducasse\nSabato 12 luglio alle 19.30 - Cena concerto\nPrezzo adulti: 20 euro - Bambini: 8?\nPrenotazione al numero 06 86 57 77 91 entro l'8 luglio"
        ],
        "fr": [
          "Comme chaque année, Lebiez organise sa ducasse\nRendez-vous le samedi 12 juillet à 19h30 - Repas concert\nTarif adulte : 20€ - Tarif enfant : 8€\nRéservation au 06 86 57 77 91 avant le 8 juillet"
        ],
        "nl": [
          "Zoals elk jaar organiseert Lebiez zijn ducasse\nZaterdag 12 juli om 19.30 uur - Concertmaaltijd\nPrijs volwassenen: €20 - Kinderen: 8?\nReserveren op 06 86 57 77 91 vóór 8 juli"
        ],
        "es": [
          "Como cada año, Lebiez organiza su ducasse\nSábado 12 de julio a las 19.30 h - Comida concierto\nPrecio adulto: 20? - Niños: 8?\nReserva en el 06 86 57 77 91 antes del 8 de julio"
        ]
      },
