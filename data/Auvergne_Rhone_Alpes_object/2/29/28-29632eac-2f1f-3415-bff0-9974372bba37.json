  "rdfs:comment": {
    "de": [
      "241 ha großes Ensemble mit einer abwechslungsreichen Topographie und sehr unterschiedlichen Waldbeständen. Freie Spaziergänge vor Ort. Parkplätze und Picknickplätze. Thematische Animationen für Erwachsene und Kinder je nach Jahreszeit. Erkundigen Sie sich beim Fremdenverkehrsamt."
    ],
    "en": [
      "An area of 241 ha with a varied topography and a wide variety of forest stands. Free on-site walks. Parking lots and picnic areas. Themed activities for adults and children depending on the season. Ask at the tourist office."
    ],
    "it": [
      "Un sito di 241 ettari con una topografia varia e un'ampia varietà di boschi. Passeggiate gratuite in loco. Parcheggi e aree picnic. Attività per adulti e bambini a seconda della stagione. Per maggiori informazioni, contattare l'ufficio turistico."
    ],
    "fr": [
      "Ensemble de 241 ha avec une topographie variée et des peuplements forestiers très divers. Promenades libres sur place. Parkings et aires de pique-nique. Animations thématiques adultes et enfants selon les périodes. Renseignez-vous auprès de l'office de tourisme."
    ],
    "es": [
      "Un paraje de 241 hectáreas con una topografía variada y una gran variedad de masas forestales. Paseos gratuitos in situ. Aparcamientos y merenderos. Actividades para adultos y niños según la temporada. Para más información, póngase en contacto con la oficina de turismo."
    ],
    "nl": [
      "Een terrein van 241 hectare met een gevarieerde topografie en een grote verscheidenheid aan bosopstanden. Gratis wandelingen op het terrein. Parkeerplaatsen en picknickplaatsen. Activiteiten voor volwassenen en kinderen afhankelijk van het seizoen. Neem voor meer informatie contact op met het toeristenbureau."
    ]
  },
