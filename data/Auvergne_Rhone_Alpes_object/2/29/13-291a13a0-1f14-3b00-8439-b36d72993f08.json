  "rdfs:comment": {
    "de": [
      "6 Schöpferinnen haben sich zusammengeschlossen und empfangen Sie in diesem hübschen Laden im Herzen des Dorfes.\r\nSchmuck, Keramik, Illustrationen, Textilkreationen für Kinder und Erwachsene, Kunstbesteck und anderes Kunsthandwerk"
    ],
    "en": [
      "6 Designers have joined forces and welcome you to this pretty boutique in the heart of the village\r\nJewelry, ceramics, illustrations, textile creations for children and adults, artistic cutlery and other crafts"
    ],
    "it": [
      "6 designer si sono uniti per darvi il benvenuto in questo grazioso negozio nel cuore del villaggio\r\nGioielli, ceramiche, illustrazioni, creazioni tessili per bambini e adulti, posate artistiche e altri oggetti di artigianato"
    ],
    "fr": [
      "6 Créatrices se sont associées et vous accueillent dans cette jolie boutique au coeur du village\r\nBijoux, céramiques, illustrations, créations textiles pour enfants et adultes, coutellerie d'art et autres artisanats"
    ],
    "nl": [
      "6 ontwerpers hebben hun krachten gebundeld om je te verwelkomen in deze mooie winkel in het hart van het dorp.\r\nSieraden, keramiek, illustraties, textielcreaties voor kinderen en volwassenen, artistiek bestek en andere ambachten."
    ],
    "es": [
      "6 diseñadores se han unido para darle la bienvenida a esta bonita tienda situada en el corazón del pueblo\r\nJoyería, cerámica, ilustraciones, creaciones textiles para niños y adultos, cuchillería artística y otras artesanías"
    ]
  },
  "rdfs:label": {
