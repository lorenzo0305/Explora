  "rdfs:comment": {
    "de": [
      "Als VR-Cyber-Café in Wien bietet VRtueux ein totales Eintauchen mit einem in Frankreich einzigartigen omnidirektionalen Teppich, ultra-realistische VR-Erlebnisse, Gaming der nächsten Generation und völlig neue Eindrücke."
    ],
    "en": [
      "A VR cyber café in Vienne, VRtueux offers total immersion with an omnidirectional carpet unique in France, ultra-realistic VR experiences, new-generation gaming and unprecedented sensations."
    ],
    "it": [
      "Cyber VR café di Vienne, VRtueux offre un'immersione totale con un tappeto omnidirezionale unico in Francia, esperienze VR ultra-realistiche, giochi di nuova generazione e sensazioni inedite."
    ],
    "fr": [
      "Cyber café VR à Vienne, VRtueux propose une immersion totale avec un tapis omnidirectionnel unique en France, des expériences VR ultra-réalistes, du gaming nouvelle génération et des sensations inédites."
    ],
    "nl": [
      "VRtueux, een cyber VR-café in Vienne, biedt een totale onderdompeling met een omnidirectioneel tapijt dat uniek is in Frankrijk, ultrarealistische VR-ervaringen, gaming van de nieuwe generatie en gloednieuwe sensaties."
    ],
    "es": [
      "Cibercafé de RV en Vienne, VRtueux ofrece una inmersión total con una alfombra omnidireccional única en Francia, experiencias de RV ultrarrealistas, juegos de nueva generación y sensaciones inéditas."
    ]
  },
