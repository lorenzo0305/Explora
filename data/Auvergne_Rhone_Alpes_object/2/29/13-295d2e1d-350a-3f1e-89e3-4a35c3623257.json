  "rdfs:comment": {
    "de": [
      "Die Oisans Trail Tour, das sind 5 Orte, die sich zusammengeschlossen haben, um eine neue Strecke zu schaffen und so die Läufer von ihren wilden Ecken profitieren zu lassen!"
    ],
    "en": [
      "The Oisans Trail Tour consists of 5 resorts that have joined forces to create a unique route to give runners the chance to enjoy their wild corners!"
    ],
    "it": [
      "L'Oisans Trail Tour è costituito da 5 località che hanno unito le forze per creare un percorso originale e permettere così ai corridori di approfittare dei loro luoghi selvaggi!"
    ],
    "fr": [
      "L’Oisans Trail Tour, c’est 5 stations qui se sont unies pour créer un parcours inédit et ainsi faire profiter de leurs coins sauvages à aux coureurs !"
    ],
    "es": [
      "El Oisans Trail Tour son 5 estaciones que se han unido para crear un recorrido original y permitir así a los corredores ¡aprovechar sus parajes salvajes!"
    ],
    "nl": [
      "De Oisans Trail Tour bestaat uit 5 vakantieoorden die hun krachten hebben gebundeld om een unieke route te creëren die hardlopers de kans geeft om van hun wilde hoekjes te genieten!"
    ]
  },
