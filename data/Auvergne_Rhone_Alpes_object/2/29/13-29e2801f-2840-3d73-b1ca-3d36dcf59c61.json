  "rdfs:comment": {
    "de": [
      "La Forestière ist ein UCI-Mountainbike-Rennen, Cyclo, Kids, Enduro. Es vereint mehr als 3500 Teilnehmer und sein Ruf zieht die besten Fahrer der Welt sowie Mountainbiker aus ganz Frankreich und dem Ausland an."
    ],
    "en": [
      "La Forestière is a UCI MTB, Cyclo, Kids and Enduro event. It attracts over 3,500 participants, and its reputation attracts the world's best riders as well as mountain bikers from all over France and abroad."
    ],
    "it": [
      "La Forestiere è un evento di mountain bike tra le regioni dell'Haut-Jura e dell'Haut-Bugey, aperto a tutti gli appassionati di mountain bike dai 2 ai 77 anni.\r\nMountain bike, gare UCI, campionati francesi, enduro, cross-country, La Forestière è una celebrazione della mountain bike in tutte le sue forme."
    ],
    "fr": [
      "La Forestiere est un évènement VTT entre le Haut-Jura et le Haut-Bugey ouvert à tous les VTTistes de 2 à 77 ans. \r\nRandos VTT, Courses UCI, championnat de France, enduro, Cross-Country, la Forestière est une belle fête du VTT sous toutes ses pratiques."
    ],
    "nl": [
      "La Forestière is een mountainbike-evenement tussen de Haut-Jura en de Haut-Bugey, dat openstaat voor alle mountainbikers van 2 tot 77 jaar.\r\nMountainbiken, UCI-races, Franse kampioenschappen, enduro, crosscountry, La Forestière is een viering van mountainbiken in al zijn vormen."
    ],
    "es": [
      "La Forestière es un evento de ciclismo de montaña entre las regiones de Haut-Jura y Haut-Bugey, abierto a todos los ciclistas de montaña de 2 a 77 años.\r\nBicicleta de montaña, carreras UCI, campeonatos de Francia, enduro, cross-country, La Forestière es una fiesta de la bicicleta de montaña en todas sus formas."
    ]
  },
