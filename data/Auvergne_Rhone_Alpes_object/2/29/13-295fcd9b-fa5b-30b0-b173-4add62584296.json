  "rdfs:comment": {
    "de": [
      "Jahrhunderts nach Vichy kamen, waren viele Protestanten, vor allem aus England, der Schweiz und dem Elsass."
    ],
    "en": [
      "The large number of foreign customers who flocked to Vichy from the mid-19th century onwards included many Protestants, notably from England, Switzerland and Alsace."
    ],
    "it": [
      "Il gran numero di clienti stranieri che affluirono a Vichy a partire dalla metà del XIX secolo comprendeva molti protestanti, in particolare inglesi, svizzeri e alsaziani."
    ],
    "fr": [
      "Au sein de l’importante clientèle étrangère qui afflue à Vichy à partir du milieu du XIXe siècle, figurent de nombreux protestants, notamment anglais, suisses et alsaciens."
    ],
    "nl": [
      "Onder de vele buitenlandse klanten die vanaf het midden van de 19e eeuw naar Vichy kwamen, waren veel protestanten, vooral uit Engeland, Zwitserland en de Elzas."
    ],
    "es": [
      "Entre los numerosos clientes extranjeros que acudieron a Vichy a partir de mediados del siglo XIX había muchos protestantes, sobre todo de Inglaterra, Suiza y Alsacia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Temple protestant"
    ]
  },
