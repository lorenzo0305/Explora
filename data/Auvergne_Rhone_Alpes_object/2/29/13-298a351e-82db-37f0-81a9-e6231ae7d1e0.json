  "rdfs:comment": {
    "de": [
      "Das Team der GAMES FACTORY - Restaurant le Striker empfängt Sie 6 Tage die Woche in einem freundlichen und modernen Freizeitkomplex, wo Sie eine große Auswahl an Speisen, Pizzas, Burgern, Salaten oder auch unsere Spezialitäten entdecken können."
    ],
    "en": [
      "The team at GAMES FACTORY - Restaurant le Striker welcomes you 6 days a week to a friendly, modern leisure complex where you can enjoy a wide range of food and drink, pizzas, burgers, salads and our specialities."
    ],
    "it": [
      "Il team di GAMES FACTORY - Restaurant le Striker vi accoglie 6 giorni su 7 in un complesso ricreativo moderno e accogliente per scoprire un'ampia gamma di ristoranti, pizze, hamburger, insalate e le nostre specialità."
    ],
    "fr": [
      "L’équipe du GAMES FACTORY - Restaurant le Striker vous accueille 6 jours sur 7 dans un complexe convivial et moderne de loisirs pour y découvrir une large gamme de restauration, pizzas, burgers, salades, ou encore nos spécialités."
    ],
    "nl": [
      "Het team van GAMES FACTORY - Restaurant le Striker heet je 6 dagen per week welkom in een gezellig, modern recreatiecomplex om een breed scala aan restaurants, pizza's, hamburgers, salades en onze specialiteiten te ontdekken."
    ],
    "es": [
      "El equipo de GAMES FACTORY - Restaurant le Striker le da la bienvenida 6 días a la semana a un complejo de ocio acogedor y moderno para descubrir una amplia gama de restaurantes, pizzas, hamburguesas, ensaladas y nuestras especialidades."
    ]
  },
