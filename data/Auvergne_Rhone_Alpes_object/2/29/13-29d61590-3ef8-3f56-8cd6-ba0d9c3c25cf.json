  "rdfs:comment": {
    "de": [
      "Caroline Marion bietet Ihnen eine Vielzahl von Gemüse im Direktverkauf an, direkt auf ihrem Hof am Mittwoch- und Freitagabend, am Samstagvormittag oder auf dem Markt in Romans sur Isère am Sonntagvormittag."
    ],
    "en": [
      "Caroline Marion offers a multitude of vegetables for direct sale, directly from her farm on Wednesday and Friday evenings, Saturday mornings or at the Romans sur Isère market on Sunday mornings."
    ],
    "it": [
      "Caroline Marion vende un'ampia gamma di verdure direttamente dalla sua azienda agricola il mercoledì e il venerdì sera, il sabato mattina e al mercato di Romans sur Isère la domenica mattina."
    ],
    "fr": [
      "Caroline Marion vous propose une multitude de légumes en vente directe, directement sur son exploitation le mercredi et vendredi soir, le samedi matin ou sur le marché de Romans sur Isère le dimanche matin."
    ],
    "nl": [
      "Caroline Marion verkoopt een breed assortiment groenten rechtstreeks van haar boerderij op woensdag- en vrijdagavond, zaterdagochtend en op de markt van Romans sur Isère op zondagochtend."
    ],
    "es": [
      "Caroline Marion vende una amplia gama de verduras directamente desde su granja los miércoles y viernes por la noche, los sábados por la mañana y los domingos por la mañana en el mercado de Romans sur Isère."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de Caroline Marion"
    ]
  },
