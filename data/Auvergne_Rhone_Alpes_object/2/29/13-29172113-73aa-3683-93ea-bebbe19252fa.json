  "rdfs:comment": {
    "de": [
      "Sie finden eine sehr interessante Auswahl an Romanen für Kinder und Erwachsene, Comics, Mangas, Alben für die Kleinen (und die Großen) sowie eine Auswahl an DVDs für jeden Geschmack."
    ],
    "en": [
      "You will find a very interesting choice of children's and adult novels, comic books, manga, albums for children (and adults) as well as a selection of DVDs for all tastes."
    ],
    "it": [
      "Troverete una scelta molto interessante di romanzi per bambini e adulti, fumetti, manga, album per bambini (e adulti) e una selezione di DVD per tutti i gusti."
    ],
    "fr": [
      "Vous trouverez un choix très intéressant de romans enfants ou adultes, bandes dessinées, mangas, albums pour les petits (et les grands) ainsi qu'une sélection de DVD pour tous les goûts."
    ],
    "nl": [
      "U vindt er een zeer interessante keuze aan romans voor kinderen en volwassenen, strips, manga, albums voor kinderen (en volwassenen) en een selectie dvd's voor alle smaken."
    ],
    "es": [
      "Encontrará una selección muy interesante de novelas para niños y adultos, cómics, manga, álbumes para niños (y adultos), así como una selección de DVDs para todos los gustos."
    ]
  },
