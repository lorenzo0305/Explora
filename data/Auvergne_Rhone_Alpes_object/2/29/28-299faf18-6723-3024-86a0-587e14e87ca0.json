      "rdfs:comment": {
        "de": [
          "Zwischen grünen und gelben Zucchini, Radieschen, Auberginen und und und ... Entdecken Sie gutes Obst und Gemüse auf dem Markt in Neuilly-Saint-Front (jeden Samstag von 7:00 bis 13:00 Uhr)"
        ],
        "en": [
          "Between green and yellow courgettes, radishes, aubergines and so on... Discover the good fruits and vegetables at the Neuilly-Saint-Front market (every Saturday from 7:00 to 13:00)"
        ],
        "it": [
          "Tra zucchine verdi e gialle, ravanelli, melanzane e così via... Scoprite la buona frutta e verdura al mercato di Neuilly-Saint-Front (ogni sabato dalle 7:00 alle 13:00)"
        ],
        "fr": [
          "Entre courgettes vertes et jaunes, les radis, les aubergines et j’en passe... Découvrez les bons fruits et légumes au marché de Neuilly-Saint-Front (tous les samedis de 7:00 à 13:00)"
        ],
        "nl": [
          "Tussen groene en gele courgettes, radijsjes, aubergines... Ontdek de goede groenten en fruit op de markt van Neuilly-Saint-Front (elke zaterdag van 7:00 tot 13:00 uur)"
        ],
        "es": [
          "Entre calabacines verdes y amarillos, rábanos, berenjenas... Descubra las buenas frutas y verduras en el mercado de Neuilly-Saint-Front (todos los sábados de 7:00 a 13:00)"
        ]
      },
