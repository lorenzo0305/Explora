          "additionalInformation": {
            "de": [
              "Öffnungszeiten außerhalb der Schulferien :\r\nMontag und Dienstag geschlossen.\r\nMittwoch: 14h/22h\r\nDonnerstag: 18h/23h\r\nFreitag: 18h/00h\r\nSamstag: 14h/00h\r\nSonntag: 14h/22h\r\nÖffnungszeiten Schulferien:\r\nMontag, Dienstag und Mittwoch: 14h/22h\r\nDonnerstag: 14h/23h\r\nFreitag und Samstag: 14h/00h\r\nSonntag: 14h/22h"
            ],
            "en": [
              "Opening hours outside school vacations:\r\nClosed Monday and Tuesday.\r\nWednesday: 14h/22h\r\nThursday: 18h/23h\r\nFriday: 18h/00h\r\nSaturday: 14h/00h\r\nSunday: 14h/22h\r\nSchool vacation opening hours:\r\nMonday, Tuesday and Wednesday: 14h/22h\r\nThursday: 14h/23h\r\nFriday and Saturday: 14h/00h\r\nSunday: 2pm/22pm"
            ],
            "it": [
