  "rdfs:comment": {
    "de": [
      "Treten Sie ein in eine postapokalyptische Welt und kämpfen Sie in einem Labyrinth von über 500m2!\r\nDas Laser Game in Saint-Savin empfängt Sie auf einer Fläche von 600m2, damit Sie eine tolle Zeit mit der Familie, mit Freunden oder Arbeitskollegen verbringen können."
    ],
    "en": [
      "Enter a post-apocalyptic universe and battle your way through a 500m2 maze!\r\nThe Saint-Savin Laser Game welcomes you to a 600m2 space, where you'll have a great time with family, friends or colleagues."
    ],
    "it": [
      "Entrate in un mondo post-apocalittico e fatevi strada in un labirinto di oltre 500 m2!\r\nIl Laser Game di Saint-Savin vi accoglie in un'area di 600 m2, dove potrete divertirvi con la famiglia, gli amici o i colleghi di lavoro."
    ],
    "fr": [
      "Entrez dans un univers post apocalyptique et affrontez-vous dans un labyrinthe de plus de 500m2 !\r\nLe Laser Game de Saint-Savin vous accueille dans un espace de 600m2 pour vous faire passer un excellent moment en famille, entre amis ou collègue de travail."
    ],
    "es": [
      "Entra en un mundo postapocalíptico y ábrete paso a través de un laberinto de más de 500 m2\r\nEl Juego Láser de Saint-Savin te da la bienvenida a un espacio de 600m2, donde podrás pasarlo en grande con tu familia, amigos o compañeros de trabajo."
    ],
    "nl": [
      "Betreed een post-apocalyptisch universum en vecht je een weg door een doolhof van meer dan 500m2!\r\nDe Saint-Savin Laser Game verwelkomt je op een oppervlakte van 600 m2, waar je je prima kunt vermaken met je familie, vrienden of collega's."
    ]
  },
