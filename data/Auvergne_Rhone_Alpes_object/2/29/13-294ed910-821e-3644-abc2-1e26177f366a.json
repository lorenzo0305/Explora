  "rdfs:comment": {
    "de": [
      "1 Schwimmbecken mit 25 Metern Länge und 6 Bahnen.\r\n1 Lehr-/Freizeitbecken von 150m².\r\n1 Planschbecken von 40m²\r\n1 Pentagliss 3 Bahnen innen,\r\n1 Splashpad im Freien,\r\n1 Außenterrasse mit Platz für einen Foodtruck,"
    ],
    "en": [
      "1 25-meter swimming pool with 6 lanes.\r\n1 150 m2 learning/leisure pool.\r\n1 40m² paddling pool\r\n1 indoor 3-lane pentagliss,\r\n1 outdoor splashpad,\r\n1 outdoor terrace with food-truck facilities,"
    ],
    "it": [
      "1 piscina di 25 metri con 6 corsie.\r\n1 piscina per l'apprendimento/tempo libero di 150 m2.\r\n1 piscina per bambini di 40 m²\r\n1 pentagono coperto a 3 corsie,\r\n1 splashpad esterno,\r\n1 terrazza esterna che può ospitare un food-truck,"
    ],
    "fr": [
      "1 bassin de natation de 25 mèrtres et 6 couloirs. \r\n1 bassin d'apprentissage/ loisirs de 150 m2. \r\n1 pataugeoire de 40m²\r\n1 pentagliss 3 piste intérieur,\r\n1 splashpad extérieur,\r\n1 terrasse extérieure pouvant accueillir un food-truck,"
    ],
    "nl": [
      "1 zwembad van 25 meter met 6 banen.\r\n1 leer-/recreatiebad van 150 m2.\r\n1 peuterbad van 40m²\r\n1 overdekt pentagliss met 3 banen,\r\n1 buiten splashpad,\r\n1 buitenterras dat plaats biedt aan een food-truck,"
    ],
    "es": [
      "1 piscina de 25 metros con 6 carriles.\r\n1 piscina de aprendizaje/ocio de 150 m2.\r\n1 piscina infantil de 40 m²\r\n1 pentagliss cubierta de 3 carriles,\r\n1 piscina de chapoteo exterior,\r\n1 terraza exterior con capacidad para un food-truck,"
