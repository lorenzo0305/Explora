  "rdfs:comment": {
    "de": [
      "Ein Kino mit dem Label \"Art et Essai\".\r\nEs nimmt an verschiedenen nationalen und departementalen pädagogischen Aktionen wie \"Collège au cinéma\", \"Ecole et cinéma\" und \"Lycéens au cinéma\" teil."
    ],
    "en": [
      "An \"Art et Essai\" cinema.\r\nIt participates in national and departmental educational initiatives such as \"Collège au cinéma\", \"Ecole et cinéma\" and \"Lycéens au cinéma\"."
    ],
    "it": [
      "Un cinema con l'etichetta \"Art et Essai\".\r\nPartecipa a diverse iniziative educative nazionali e dipartimentali come \"Collège au cinéma\", \"Ecole et cinéma\" e \"Lycéens au cinéma\"."
    ],
    "fr": [
      "Un cinéma labellisé « Art et Essai ».\r\nIl adhère aux différentes actions pédagogiques nationales et départementales telles que « Collège au cinéma », « Ecole et cinéma » et « Lycéens au cinéma »."
    ],
    "es": [
      "Un cine con la etiqueta \"Art et Essai\".\r\nParticipa en diversas iniciativas educativas nacionales y departamentales como \"Collège au cinéma\", \"Ecole et cinéma\" y \"Lycéens au cinéma\"."
    ],
    "nl": [
      "Een \"Art et Essai\" bioscoop.\r\nHet neemt deel aan verschillende nationale en departementale educatieve initiatieven zoals \"Collège au cinéma\", \"Ecole et cinéma\" en \"Lycéens au cinéma\"."
    ]
  },
