  "rdfs:comment": {
    "de": [
      "La Parenthèse öffnet jeden Mittag seine Türen für eine Schlemmerpause. Entdecken Sie jeden Tag eine andere Formel, Gerichte, die aus frischen und saisonalen Produkten zubereitet werden."
    ],
    "en": [
      "La Parenthèse opens its doors to you every lunchtime for a gourmet break. Discover a different menu every day, with dishes made from fresh, seasonal produce."
    ],
    "it": [
      "La Parenthèse vi apre le porte ogni ora di pranzo per una pausa gourmet. Scoprite ogni giorno una formula diversa, con piatti a base di prodotti freschi e di stagione."
    ],
    "fr": [
      "La Parenthèse vous ouvre ses portes tous les midis le temps d’une pause gourmande. Découvrez chaque jour une formule différente, des plats élaborés à base de produits frais et saisonniers."
    ],
    "nl": [
      "La Parenthèse opent elke middag zijn deuren voor een gastronomische pauze. Ontdek elke dag een ander menu met gerechten op basis van verse seizoensproducten."
    ],
    "es": [
      "La Parenthèse le abre sus puertas cada mediodía para una pausa gastronómica. Descubra una fórmula diferente cada día, con platos elaborados con productos frescos y de temporada."
    ]
  },
  "rdfs:label": {
