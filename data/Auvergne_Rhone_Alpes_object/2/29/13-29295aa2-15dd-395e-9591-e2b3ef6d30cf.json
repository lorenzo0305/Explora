  "rdfs:comment": {
    "de": [
      "Erleben Sie spektakuläre Vorführungen von vier professionellen BMX-Fahrern auf einer Funbox und zwei Freestyle-Quarters? Lassen Sie sich von diesen Fahrern in einer festlichen Atmosphäre einführen."
    ],
    "en": [
      "Watch spectacular demonstrations by 4 professional BMX riders on a funbox and two freestyle quarters. You'll also have the chance to take part in a series of introductory lessons led by these riders, all in a festive atmosphere."
    ],
    "it": [
      "Assistete a dimostrazioni spettacolari da parte di 4 piloti professionisti di BMX su un funbox e due quartieri di freestyle. Avrete anche la possibilità di partecipare a lezioni introduttive guidate da questi rider, il tutto in un'atmosfera di festa."
    ],
    "fr": [
      "Assistez à des démonstrations spectaculaires de 4 riders professionnels en BMX sur une funbox et deux quarters freestyle​. Laissez-vous tenter par les initiations encadrées par ces riders, le tout dans une ambiance festive."
    ],
    "nl": [
      "Bekijk spectaculaire demonstraties van 4 professionele BMX-rijders op een funbox en twee freestyle kwartieren. Je krijgt ook de kans om deel te nemen aan een introductiecursus onder leiding van deze rijders, en dat alles in een feestelijke sfeer."
    ],
    "es": [
      "Asista a las espectaculares demostraciones de 4 riders profesionales de BMX sobre un funbox y dos quarters de freestyle? También tendrás la oportunidad de participar en clases de iniciación dirigidas por estos riders, todo ello en un ambiente festivo."
    ]
  },
