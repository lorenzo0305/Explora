  "rdfs:comment": {
    "de": [
      "- Direktverkauf von Aberdeen Angus-Fleisch, 100 % Gras, Bio, in 5-kg-Paketen und im Einzelhandel Hacksteaks, Würste und Merguez, Wurstwaren (Terrinen, Salami, Trockenfleisch)\r\n- Verkauf von Bio-Eiern\r\nBestellung auf unserer Website fermedelenvol.de"
    ],
    "en": [
      "- Direct sales of Aberdeen Angus meat, 100% grass-fed, organic, in 5kg packs and retail minced steaks, sausages and merguez, charcuterie (terrines, sausages, dried meat)\r\n- Organic egg sales\r\nOrder on our website fermedelenvol.fr"
    ],
    "it": [
