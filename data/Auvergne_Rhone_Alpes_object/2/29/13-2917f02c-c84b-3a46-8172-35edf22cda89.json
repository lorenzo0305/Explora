  "rdfs:comment": {
    "de": [
      "Die Komödie des italienischen Dramatikers Carlo Goldoni, die 1748 in Venedig zum ersten Mal aufgeführt wurde, sorgt auch heute noch für Lacher und Überraschungen."
    ],
    "en": [
      "First performed in Venice in 1748, Italian playwright Carlo Goldoni's comedy continues to surprise and delight."
    ],
    "it": [
      "Rappresentata per la prima volta a Venezia nel 1748, la commedia del drammaturgo italiano Carlo Goldoni continua a sorprendere e deliziare."
    ],
    "fr": [
      "Jouée pour la première fois à Venise en 1748, la comédie du dramaturge italien Carlo Goldoni, continue de faire rire et de surprendre."
    ],
    "es": [
      "Estrenada en Venecia en 1748, la comedia del dramaturgo italiano Carlo Goldoni sigue sorprendiendo y deleitando."
    ],
    "nl": [
      "De komedie van de Italiaanse toneelschrijver Carlo Goldoni werd voor het eerst opgevoerd in Venetië in 1748 en blijft verrassen en verrukken."
    ]
