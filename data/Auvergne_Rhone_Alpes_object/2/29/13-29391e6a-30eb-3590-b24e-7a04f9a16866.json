  "rdfs:comment": {
    "de": [
      "Kirche zum Teil aus dem 12. Jahrhundert. Jahrhundert. Altar, Jungfrau, Kanzel. Alle Glasfenster wurden 2010 restauriert. Täglich von 9:00 bis 18:00 Uhr geöffnet."
    ],
    "en": [
      "Church partly from the 12th century. Altar, virgin, pulpit. All the stained glass windows were restored in 2010. Open every day from 9 am to 6 pm."
    ],
    "it": [
      "Chiesa in parte del XII secolo. Altare, vergine, pulpito. Tutte le finestre sono state restaurate nel 2010. Aperto tutti i giorni dalle 9.00 alle 18.00."
    ],
    "fr": [
      "Eglise en partie du XIIe siècle. Autel, vierge, chaire. Tous les vitraux ont été restaurés en 2010. Ouverte tous les jours de 9h à 18h."
    ],
    "nl": [
      "Kerk gedeeltelijk uit de 12e eeuw. Altaar, maagd, preekstoel. Alle ramen zijn in 2010 gerestaureerd. Dagelijks geopend van 9 tot 18 uur."
    ],
    "es": [
      "Iglesia en parte del siglo XII. Altar, virgen, púlpito. Todas las ventanas fueron restauradas en 2010. Abierto todos los días de 9 a 18 horas."
    ]
  },
