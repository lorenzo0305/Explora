  "rdfs:comment": {
    "de": [
      "Die Werkstatt-Boutique: ein unumgänglicher Besuch im Lyoner Kulturerbe! Soierie Saint-Georges liegt im Vieux-Lyon und bietet eine große Auswahl an Lyoner Seidenstoffen: Krawatten, Carrés, Tücher, Stolen, Musselin, Samt ..."
    ],
    "en": [
      "The workshop-store: an essential visit when discovering Lyon's heritage! Located in Vieux-Lyon, it offers a wide selection of Lyonnais silks: ties, scarves, stoles, muslins, velvets, etc."
    ],
    "it": [
      "Il laboratorio-boutique: una tappa obbligata nel patrimonio lionese! Situata nella Vieux-Lyon, la Soierie Saint-Georges propone un'ampia gamma di sete lionesi: cravatte, sciarpe, stole, mussole, velluti, ecc."
    ],
    "fr": [
      "L'atelier-boutique : une visite incontournable dans le patrimoine lyonnais ! Situé dans le Vieux-Lyon, Soierie Saint-Georges présente un grand choix de soieries lyonnaises : cravates, carrés, foulards, étoles, mousselines, velours ..."
    ],
    "es": [
      "El taller-boutique: ¡una visita obligada del patrimonio lionés! Situada en el Vieux-Lyon, la Soierie Saint-Georges ofrece una amplia gama de sedas lionesas: corbatas, pañuelos, estolas, muselinas, terciopelos, etc."
    ],
    "nl": [
      "De atelier-winkel: een must in het erfgoed van Lyon! Soierie Saint-Georges, gelegen in Vieux-Lyon, biedt een breed scala aan zijde uit Lyon: dassen, sjaals, stola's, muslins, fluweel, enz."
    ]
  },
