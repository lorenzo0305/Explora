  "rdfs:comment": {
    "de": [
      "Ein in Frankreich neuartiges Projekt, ein einzigartiger 9-Loch-Parcours für Footgolf und Disc Golf.\r\n2 Disziplinen auf demselben Parcours, entdecken Sie diese neuen Aktivitäten im Freien...\r\nLassen Sie sich von der Erfahrung verführen!"
    ],
    "en": [
      "Unique project in France, a unique course of 9 holes to practice Footgolf and Disc Golf.\r\n2 disciplines on the same course, come and discover these new outdoor activities...\r\nLet yourself be tempted by the experience!"
    ],
    "it": [
      "Un nuovo progetto in Francia, un campo unico a 9 buche per praticare Footgolf e Disc Golf.\r\n2 discipline sullo stesso percorso, venite a scoprire queste nuove attività all'aperto...\r\nLasciatevi tentare dall'esperienza!"
    ],
    "fr": [
      "Projet inédit en France, un parcours unique de 9 trous pour pratiquer le Footgolf et le Disc Golf.\r\n2 disciplines sur le même parcours, venez découvrir ces nouvelles activités de plein air...\r\nLaissez-vous tenter par l’Expérience !"
    ],
    "es": [
      "Un nuevo proyecto en Francia, un campo único de 9 hoyos para practicar Footgolf y Disc Golf.\r\n2 disciplinas en el mismo curso, venga a descubrir estas nuevas actividades al aire libre...\r\n¡Déjate tentar por la experiencia!"
    ],
    "nl": [
      "Een nieuw project in Frankrijk, een unieke 9-holes baan om Footgolf en Disc Golf te beoefenen.\r\n2 disciplines op hetzelfde parcours, kom deze nieuwe buitenactiviteiten ontdekken...\r\nLaat je verleiden door de ervaring!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Footgolf et Discgolf"
    ]
  },
