  "rdfs:comment": {
    "de": [
      "Lust auf Italien? La Golosita, ein italienischer Lebensmittelladen im Herzen des Stadtzentrums, bietet alle Produkte aus Italien, Wurstwaren, Käse, Antipasti, Gerichte zum Mitnehmen, Aperitif-/Dinatorplatten, Essen vor Ort. Nur wenige Schritte vom Fer à Cheval und der Oper entfernt."
    ],
    "en": [
      "In the mood for Italy? La Golosita, an Italian grocery in the heart of downtown, offers all Italian products, charcuterie, cheeses, antipasti takeaways, aperitif/dinner trays, on-site catering. Just a stone's throw from the Fer à Cheval and the Opera."
    ],
    "it": [
      "Avete voglia di Italia? La Golosita, negozio di alimentari italiani nel cuore del centro città, offre tutti i prodotti italiani, salumi, formaggi, antipasti da asporto, aperitivi/cene al piatto e catering in loco. A pochi passi dal Fer à Cheval e dall'Opera."
    ],
    "fr": [
      "Envie d'Italie ? La Golosita, épicerie italienne au cœur du centre-ville, propose tous les produits d'Italie, charcuterie, fromages, antipasti plats à emporter, plateaux apéritif/dinatoire, restauration sur place. À deux pas du Fer à Cheval et de l’Opéra."
    ],
    "es": [
      "¿Tienes ganas de Italia? La Golosita, una tienda de comestibles italianos en pleno centro de la ciudad, ofrece todos los productos de Italia, charcutería, quesos, antipasti para llevar, platos de aperitivo/cena y catering in situ. A dos pasos del Fer à Cheval y de la Ópera."
    ],
    "nl": [
      "Zin in Italië? La Golosita, een Italiaanse kruidenierswinkel in het hart van het stadscentrum, biedt alle producten van Italië, vleeswaren, kazen, antipasti-afhaalmaaltijden, aperitief/dinermaaltijden en catering ter plaatse. Op een steenworp afstand van de Fer à Cheval en de Opera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Golosita"
    ]
  },
