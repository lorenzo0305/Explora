  "rdfs:comment": {
    "de": [
      "Wir sind oft viel empfänglicher für die letzten Male als für die ersten Male. Dabei muss das letzte Mal nicht unbedingt das Ende sein."
    ],
    "en": [
      "We're often much more sensitive to last times than first times. But last times are not necessarily endings."
    ],
    "it": [
      "Spesso siamo molto più sensibili agli ultimi tempi che ai primi. Ma gli ultimi tempi non sono necessariamente la fine."
    ],
    "fr": [
      "Nous sommes souvent beaucoup plus sensibles aux dernières fois qu'aux premières fois. Pourtant, les dernières fois ne sont pas forcément des fins."
    ],
    "nl": [
      "We zijn vaak veel gevoeliger voor de laatste tijden dan voor de eerste tijden. Maar laatste keren zijn niet noodzakelijk het einde."
    ],
    "es": [
      "A menudo somos mucho más sensibles a los últimos tiempos que a los primeros. Pero los últimos tiempos no son necesariamente el final."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Nos dernières fois, défier la nostalgie"
    ]
  },
