  "rdfs:comment": {
    "de": [
      "Das Projekt Nest Games (4. Ausgabe) hat zum Ziel, eine Weltcup-Akrobatikrunde in St Hilaire du Touvet zu organisieren, bei der die 12 besten Piloten der Welt spektakuläre Kunststücke vorführen werden, um diese Runde zu gewinnen"
    ],
    "en": [
      "The aim of the Nest Games project (4th edition) is to organize a World Cup round of acrobatics on the St Hilaire du Touvet site, bringing together the world?s 12 best pilots who will perform spectacular tricks in order to win this round"
    ],
    "it": [
      "L'obiettivo del progetto Nest Games (4a edizione) è quello di organizzare una gara di Coppa del Mondo di acrobazia sul sito di St Hilaire du Touvet, riunendo i 12 migliori piloti del mondo che si esibiranno in una serie di numeri spettacolari per vincere la gara"
    ],
    "fr": [
      "Le projet Nest Games ( 4ème édition) a pour but d’organiser une manche de coupe du monde d’acrobatie sur le site de St Hilaire du Touvet réunissant les 12 meilleurs pilotes mondiaux qui vont enchaîner des figures spectaculaires afin de gagner cette manche"
    ],
    "nl": [
      "Het doel van het project Nest Games (4e editie) is het organiseren van een wereldbeker acrobatiek op de site van St Hilaire du Touvet, met de 12 beste piloten ter wereld die een reeks spectaculaire trucs zullen uitvoeren om de ronde te winnen"
    ],
    "es": [
      "El objetivo del proyecto Nest Games (4ª edición) es organizar una ronda de la Copa del Mundo de acrobacia en las instalaciones de St Hilaire du Touvet, reuniendo a los 12 mejores pilotos del mundo, que realizarán una serie de trucos espectaculares para ganar la ronda"
    ]
  },
  "rdfs:label": {
