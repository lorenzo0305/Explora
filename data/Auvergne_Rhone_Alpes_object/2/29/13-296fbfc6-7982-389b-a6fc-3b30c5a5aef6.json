  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant mit Spezialitäten aus der Auvergne: Rindfleisch aus der Reifekammer, Pounti, gefüllter Kohl, hausgemachte Trüffel. Organisation von Themenabenden."
    ],
    "en": [
      "Traditional restaurant serving Auvergne specialities: beef in maturing room, pounti, stuffed cabbage, homemade truffade. Organization of theme evenings."
    ],
    "it": [
      "Ristorante tradizionale che serve specialità dell'Alvernia: manzo in sala di frollatura, pounti, cavoli ripieni, truffade fatta in casa. Si organizzano serate a tema."
    ],
    "fr": [
      "Restaurant traditionnel proposant des spécialités auvergnates : viandes de boeuf en chambre de maturation, pounti, chou farci, truffade maison. Organisation de soirées à thème."
    ],
    "nl": [
      "Traditioneel restaurant met specialiteiten uit de Auvergne: rundvlees in rijpingskamer, pounti, gevulde kool, huisgemaakte truffel. Thema-avonden georganiseerd."
    ],
    "es": [
      "Restaurante tradicional que sirve especialidades de Auvernia: ternera en cuarto de maduración, pounti, col rellena, truffade casera. Se organizan veladas temáticas."
    ]
