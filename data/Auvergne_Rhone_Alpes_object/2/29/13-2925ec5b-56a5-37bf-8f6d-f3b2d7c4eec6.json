  "rdfs:comment": {
    "de": [
      "Entdecken Sie diese 23,3 km lange Gravel-Strecke in Courchevel. Die Strecke verläuft über 19,6 km Straßen und 2,5 km Waldwege. Der Gesamtanstieg beträgt über 800 m."
    ],
    "ru": [
      "Откройте для себя эту гравийную трассу в Куршевеле протяженностью 23,3 км. Трасса состоит из 19,6 км дорог и 2,5 км лесных троп. Общий подъем составляет более 800 м."
    ],
    "en": [
      "Discover this 23.3 km gravel course in Courchevel. The course comprises 19.6 km of roads and 2.5 km of forest tracks. It has a cumulative climb of over 800m."
    ],
    "it": [
      "Scoprite questo percorso sterrato di 23,3 km a Courchevel. Il percorso è composto da 19,6 km di strade e 2,5 km di sentieri forestali. L'ascesa totale è di oltre 800 metri."
    ],
    "fr": [
      "Découvrez ce parcours de gravel de 23,3 km à Courchevel. Ce parcours emprunte 19,6 km de routes et 2,5 km de pistes forestières. Il présente une ascension cumulée de plus de 800m."
    ],
    "nl": [
      "Ontdek dit 23,3 km lange gravelparcours in Courchevel. Het parcours bestaat uit 19,6 km wegen en 2,5 km bospaden. Het heeft een totale stijging van meer dan 800 meter."
    ],
    "es": [
      "Descubra este circuito de grava de 23,3 km en Courchevel. El recorrido se compone de 19,6 km de carreteras y 2,5 km de pistas forestales. Tiene un desnivel total de más de 800 m."
    ]
  },
  "rdfs:label": {
    "de": [
