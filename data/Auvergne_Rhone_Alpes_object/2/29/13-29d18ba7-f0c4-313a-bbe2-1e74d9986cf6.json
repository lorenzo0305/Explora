  "rdfs:comment": {
    "de": [
      "Ausleihe von Büchern, Zeitschriften und CDs, Internetnutzung und Bereitstellung von Office-Tools, Ausstellungen, monatliche Märchenstunde, Treffen mit Schriftstellern, Vorträge, Café-Ecke mit Tagespresse zur Einsichtnahme vor Ort."
    ],
    "en": [
      "Lending of books, magazines and CDs, Internet consultation and provision of office tools, exhibitions, monthly story hour, meetings with writers, conferences, coffee corner with daily press in consultation on site."
    ],
    "it": [
      "Prestito di libri, riviste e CD, accesso a Internet e strumenti per l'ufficio, esposizioni, ora del racconto mensile, incontri con scrittori, conferenze, angolo caffè con stampa quotidiana disponibile per la consultazione in loco."
    ],
    "fr": [
      "Prêt de livres, revues et CD, consultation d’Internet et mise à disposition d’outils bureautiques, expositions, heure du conte chaque mois, rencontres avec des écrivains, conférences, coin café avec presse quotidienne en consultation sur place."
    ],
    "nl": [
      "Uitleen van boeken, tijdschriften en cd's, raadpleging via internet en terbeschikkingstelling van kantoorbenodigdheden, tentoonstellingen, maandelijkse verteltijd, ontmoetingen met schrijvers, conferenties, koffiecorner met dagblad die ter plaatse kan worden geraadpleegd."
    ],
    "es": [
      "Préstamo de libros, revistas y CDs, acceso a Internet y herramientas de oficina, exposiciones, hora del cuento mensual, encuentros con escritores, conferencias, rincón del café con prensa diaria disponible para consulta in situ."
    ]
  },
