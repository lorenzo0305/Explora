  "rdfs:comment": {
    "de": [
      "Restaurantservice von Montag bis Freitag mit einem Tagesmenü, das ein Vorspeisenbuffet nach Wunsch, ein warmes Gericht, Käse und Dessert, ein Viertel Wein und Kaffee umfasst. Terrasse im Sommer. Gerichte zum Mitnehmen."
    ],
    "en": [
      "Catering service from Monday to Friday with a menu of the day, including an all-you-can-eat starter buffet, hot dish, cheese and dessert, quarter of wine and coffee. Terrace in summer. Takeaway service."
    ],
    "it": [
      "Servizio di catering dal lunedì al venerdì con un menu del giorno che comprende un buffet di antipasti, un piatto caldo, formaggio e dessert, un quarto di vino e caffè. Terrazza in estate. Servizio da asporto."
    ],
    "fr": [
      "Service de restauration du lundi au vendredi avec un menu du jour, comprenant un buffet d'entrées à volonté, un plat chaud, fromage et dessert, quart de vin et café. Terrasse en été. Plat à emporter."
    ],
    "es": [
      "Servicio de catering de lunes a viernes con menú del día, que incluye un buffet de entrantes, un plato caliente, queso y postre, un cuarto de vino y café. Terraza en verano. Servicio de comida para llevar."
    ],
    "nl": [
      "Cateringservice van maandag tot vrijdag met een dagmenu, inclusief een all-you-can-eat voorgerechtenbuffet, een warme schotel, kaas en dessert, een kwart wijn en koffie. Terras in de zomer. Afhaalmaaltijden verkrijgbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Michel Ange"
    ]
  },
