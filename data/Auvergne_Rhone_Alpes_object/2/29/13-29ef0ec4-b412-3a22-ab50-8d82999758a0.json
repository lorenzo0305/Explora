  "rdfs:comment": {
    "de": [
      "Mittagessen von Montag bis Freitag. Formel \"sans façon\" all inclusive oder verkürzte Formel. Traditionelle und lokale Restauration \"hausgemacht\".\r\nGerichte zum Mitnehmen. Griechischer Lebensmittelladen im Restaurant."
    ],
    "en": [
      "Lunch from Monday to Friday. All-inclusive \"no-frills\" formula or shortened formula. Traditional and local \"home-made\" catering.\r\nTakeaway meals. Greek grocery in restaurant."
    ],
    "it": [
      "Pranzo dal lunedì al venerdì. Formula all-inclusive \"senza fronzoli\" o formula abbreviata. Cibo tradizionale e locale fatto in casa.\r\nPasti da asporto. Negozio di alimentari greci nel ristorante."
    ],
    "fr": [
      "Repas le midi du lundi au vendredi. Formule \"sans façon\" tout compris ou formule raccourcie. Restauration traditionnelle et locale \"fait maison\".\r\nPlats à emporter. Épicerie grecque au sein du restaurant."
    ],
    "nl": [
      "Lunch van maandag tot vrijdag. All-inclusive \"no-frills\" formule of verkorte formule. Traditioneel en lokaal zelfgemaakt eten.\r\nMeeneemmaaltijden. Griekse kruidenierswinkel in het restaurant."
    ],
    "es": [
      "Almuerzo de lunes a viernes. Fórmula todo incluido \"sin lujos\" o fórmula reducida. Comida casera tradicional y local.\r\nComida para llevar. Tienda de comestibles griega en el restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Sans Façon"
    ]
  },
