  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Museum mit freiem Eintritt.\r\nDas Museum erzählt die Geschichte der 1789 gegründeten Kunstporzellanmanufaktur von Couleuvre. Sie werden zwei Säle entdecken, in denen außergewöhnliche Stücke ausgestellt sind!"
    ],
    "en": [
      "Free admission.\r\nThe museum traces the history of the Couleuvre porcelain factory, founded in 1789. You'll discover two rooms featuring exceptional pieces!"
    ],
    "it": [
      "Ingresso gratuito.\r\nIl museo ripercorre la storia della fabbrica di porcellana Couleuvre, fondata nel 1789. Scoprirete due sale in cui sono esposti pezzi eccezionali!"
    ],
    "fr": [
      "Visite libre.\r\nLe musée retrace l'histoire de la manufacture des porcelaines d'art de Couleuvre, fondée en 1789. Vous y découvrirez deux salles, où sont exposées des pièces d'exception !"
    ],
    "nl": [
      "Gratis toegang.\r\nHet museum vertelt de geschiedenis van de porseleinfabriek Couleuvre, opgericht in 1789. Je ontdekt twee zalen waar enkele uitzonderlijke stukken worden tentoongesteld!"
    ],
    "es": [
      "Entrada gratuita.\r\nEl museo recorre la historia de la fábrica de porcelana de Couleuvre, fundada en 1789. Descubrirá dos salas en las que se exponen piezas excepcionales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de la Porcelaine"
    ]
  },
