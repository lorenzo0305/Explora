  "rdfs:comment": {
    "de": [
      "Le Façonnier serviert Ihnen hausgemachte Küche mit frischen saisonalen Produkten, vorzugsweise von lokalen Erzeugern.\r\nIn einem schönen Raum mit 150 Plätzen erhalten Sie jeden Tag eine vielfältige Küche mit einer Auswahl von Vor-, Haupt- und Nachspeisen."
    ],
    "en": [
      "Le Façonnier serves home-made cuisine with fresh, seasonal ingredients and pride of place given to local supply sources.\r\nIn a pleasant dining room with a capacity for 150 people, come and explore varied cuisine, featuring a choice of starters, main dishes and desserts each day."
    ],
    "it": [
      "Lo chef propone una cucina casalinga a base di prodotti freschi e di stagione, con particolare attenzione ai produttori locali."
    ],
    "fr": [
      "Le façonnier vous propose une cuisine maison avec des produits frais, de saison, en favorisant les producteurs locaux."
    ],
    "es": [
      "El chef ofrece cocina casera con productos frescos de temporada, haciendo hincapié en los productores locales."
    ],
    "nl": [
      "De chef biedt een huiselijke keuken met verse, seizoensgebonden producten, met de nadruk op lokale producenten."
    ]
  },
