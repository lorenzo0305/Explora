  "rdfs:comment": {
    "de": [
      "In einem modernen und gemütlichen Ambiente wird Ihnen eine zeitgemäße Küche aus frischen und lokalen Produkten angeboten. Das Mittagsmenü und das Wochenendmenü sind bewusst kurz gehalten und ändern sich wöchentlich."
    ],
    "en": [
      "Contemporary cuisine using fresh local produce is served in a warm, modern setting. The lunch and weekend menus are deliberately short and change weekly."
    ],
    "it": [
      "Una cucina contemporanea, preparata con prodotti freschi e locali, viene offerta in un ambiente moderno e accogliente. Il menu del pranzo e quello del fine settimana sono volutamente brevi e cambiano ogni settimana."
    ],
    "fr": [
      "Une cuisine contemporaine, élaborée à partir de produits frais et locaux vous sera proposée dans un cadre moderne et chaleureux. Le menu déjeuner et le menu du week-end sont volontairement courts  et changent toutes les semaines."
    ],
    "es": [
      "Se ofrece una cocina contemporánea, elaborada con productos frescos y locales, en un ambiente moderno y cálido. El menú del mediodía y el del fin de semana son deliberadamente cortos y cambian cada semana."
    ],
    "nl": [
      "Een eigentijdse keuken, bereid met verse en lokale producten, wordt aangeboden in een modern en warm kader. Het lunchmenu en het weekendmenu zijn bewust kort en veranderen elke week."
    ]
  },
  "rdfs:label": {
