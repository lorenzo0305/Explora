  "rdfs:comment": {
    "de": [
      "Klassische französische Küche, großzügig und freundlich, mit französischen, saisonalen und möglichst lokalen Produkten zubereitet. Das Restaurant befindet sich im Herzen des Village de Caractère."
    ],
    "en": [
      "Classic French cuisine, generous and friendly, made with French, seasonal and local produce whenever possible. Restaurant located in the heart of the Village de Caractère."
    ],
    "it": [
      "Cucina classica francese, generosa e amichevole, realizzata con prodotti francesi, stagionali e locali quando possibile. Ristorante situato nel cuore del Village de Caractère."
    ],
    "fr": [
      "Cuisine classique française, généreuse et conviviale faite avec des produits français, de saison et locaux tant que faire se peut. Restaurant situé au cœur du Village de Caractère."
    ],
    "nl": [
      "Klassieke Franse keuken, gul en vriendelijk, waar mogelijk bereid met Franse, seizoensgebonden en lokale producten. Restaurant gelegen in het hart van Village de Caractère."
    ],
    "es": [
      "Cocina francesa clásica, generosa y acogedora, elaborada con productos franceses, de temporada y locales siempre que sea posible. Restaurante situado en el corazón del Village de Caractère."
    ]
  },
