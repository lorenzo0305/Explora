  "rdfs:comment": {
    "de": [
      "Auris-en-Oisans lädt Sie ein, seine sportlichen Aktivitäten in den Bergen zu entdecken! Golf, Bogenschießen, Schwimmen, Wandern und vieles mehr erwarten Sie in diesem Sommer. Das Büro ist den ganzen Sommer über für Informationen und Verkäufe geöffnet. Erleben Sie das Abenteuer!"
    ],
    "en": [
      "Auris-en-Oisans invites you to discover its mountain sports activities! Golf, archery, swimming, hiking and more await you this summer. Adapted welcome, office open all summer for information and sales. Come and live the adventure!"
    ],
    "it": [
      "Auris-en-Oisans vi invita a scoprire le sue attività sportive di montagna! Golf, tiro con l'arco, nuoto, escursioni e molto altro vi aspettano quest'estate. Reception adattata, ufficio aperto tutta l'estate per informazioni e vendite. Venite a vivere l'avventura!"
    ],
    "fr": [
      "Auris-en-Oisans vous invite à découvrir ses activités sportives en montagne! Golf, tir à l'arc, natation, randonnée et plus encore vous attendent cet été. Accueil adapté, bureau ouvert tout l’été pour informations et ventes. Venez vivre l'aventure!"
    ],
    "nl": [
      "Auris-en-Oisans nodigt je uit om zijn bergsportactiviteiten te ontdekken! Golf, boogschieten, zwemmen, wandelen en nog veel meer wachten op je deze zomer. Aangepaste receptie, kantoor de hele zomer open voor informatie en verkoop. Kom en beleef het avontuur!"
    ],
    "es": [
      "Auris-en-Oisans le invita a descubrir sus actividades deportivas de montaña Golf, tiro con arco, natación, senderismo y mucho más le esperan este verano. Recepción adaptada, oficina abierta todo el verano para información y venta. ¡Venga a vivir la aventura!"
    ]
  },
  "rdfs:label": {
