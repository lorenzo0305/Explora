  "rdfs:comment": {
    "de": [
      "Mein Name ist Stephen und ich organisiere Astrobivouacs. Das sind Ausflüge, bei denen ich Gruppen (normalerweise 8 Personen) in ein Biwak im Wald oder in niedrigen Bergen bringe, um den Himmel und die Planeten zu beobachten und zu verstehen."
    ],
    "en": [
      "My name is Stephen, and I organize astrobivouacs. These are outings where I take groups (usually 8 people) to a bivouac in the forest or low mountains to observe and understand the sky and planets."
    ],
    "it": [
      "Mi chiamo Stephen e organizzo astrobivacchi. Si tratta di uscite in cui porto gruppi (di solito 8 persone) in un bivacco nella foresta o in bassa montagna per osservare e capire il cielo e i pianeti."
    ],
    "fr": [
      "Je m'appelle Stephen, j'organise des astrobivouac. Ce sont des sorties où j'emmène des groupes (en général 8 personnes) en bivouac en forêt ou montagnes basses pour aller observer et comprendre le ciel et les planètes."
    ],
    "nl": [
      "Mijn naam is Stephen en ik organiseer astrobivakanties. Dit zijn uitstapjes waarbij ik groepen (meestal 8 personen) meeneem naar een bivak in het bos of laaggebergte om de hemel en de planeten te observeren en te begrijpen."
    ],
    "es": [
      "Me llamo Stephen y organizo astrovivacs. Son salidas en las que llevo a grupos (normalmente de 8 personas) a un vivac en el bosque o en montañas bajas para observar y comprender el cielo y los planetas."
    ]
  },
