  "rdfs:comment": {
    "de": [
      "Restaurant mit traditioneller Küche auf der Grundlage lokaler und saisonaler Produkte, wobei der kurze Weg so weit wie möglich gefördert wird (keine Menüs, Vorschläge auf der Schiefertafel)."
    ],
    "en": [
      "Restaurant offering traditional cuisine, using local and seasonal produce, with a strong emphasis on short circuits (no menus, proposals by the slate)."
    ],
    "it": [
      "Un ristorante che propone una cucina tradizionale a base di prodotti locali e stagionali, privilegiando il più possibile i canali di distribuzione brevi (niente menu, proposte sulla lavagna)."
    ],
    "fr": [
      "Restaurant de cuisine traditionnelle, à base de produits locaux et de saison, en favorisant au maximum le circuit court (pas de menus, propositions à l'ardoise)."
    ],
    "es": [
      "Restaurante de cocina tradicional basada en productos locales y de temporada, con el mayor énfasis posible en los canales cortos de distribución (sin menús, propuestas en la pizarra)."
    ],
    "nl": [
      "Een restaurant dat traditionele gerechten serveert op basis van lokale, seizoensgebonden producten, met zoveel mogelijk nadruk op korte distributiekanalen (geen menu's, voorstellen op de lei)."
    ]
  },
