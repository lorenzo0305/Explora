  "rdfs:comment": {
    "de": [
      "Mel'Evasion befördert Sie in einem Minibus mit 9 Plätzen - Abfahrt vom Tourismusbüro in Varennes-sur-Allier.\r\nKurs auf Chareil-Cintrat! (Schloss; Konservatorium der alten Rebsorten von St-Pourçain)"
    ],
    "en": [
      "Mel'Evasion transports you in a 9-seater mini-bus - Departure from Varennes-sur-Allier tourist office.\r\nOn to Chareil-Cintrat! (Chateau; Conservatoire des anciens cépages de St-Pourçain)"
    ],
    "it": [
      "Mel'Evasion vi trasporta in un minibus a 9 posti - Partenza dall'ufficio del turismo di Varennes-sur-Allier.\r\nPartenza per Chareil-Cintrat! (Castello; Conservatorio degli antichi vitigni di St-Pourçain)"
    ],
    "fr": [
      "Mel'Evasion vous transporte en mini-bus 9 places - Départ de l'office de tourisme de Varennes-sur-Allier.\r\nCap sur Chareil-Cintrat ! (Chateau ; Conservatoire des anciens cépages de St-Pourçain)"
    ],
    "nl": [
      "Mel'Evasion vervoert je in een minibus met 9 zitplaatsen - Vertrek vanaf het toeristenbureau van Varennes-sur-Allier.\r\nOp naar Chareil-Cintrat! (Kasteel; Conservatorium van oude St-Pourçain druivensoorten)"
    ],
    "es": [
      "Mel'Evasion le transporta en un minibús de 9 plazas - Salida de la oficina de turismo de Varennes-sur-Allier.\r\n¡Hacia Chareil-Cintrat! (Castillo; Conservatorio de variedades antiguas de uva St-Pourçain)"
    ]
  },
