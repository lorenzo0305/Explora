          "additionalInformation": {
            "de": [
              "Besichtigung des Bauernhofs: das ganze Jahr über, nur nach Vereinbarung.\r\nDirektverkaufsstelle auf dem Bauernhof: im Juli und August täglich von 17:00 bis 19:00 Uhr, außerhalb der Saison nach Vereinbarung."
            ],
            "en": [
              "Visit of the farm : all year long, by appointment only.\r\nDirect sales point at the farm : in July and August every day from 5 to 7 pm, and out of season by appointment."
            ],
            "it": [
              "Visita della fattoria: tutto l'anno, solo su appuntamento.\r\nPunto vendita diretta in azienda: in luglio e agosto tutti i giorni dalle 17.00 alle 19.00, fuori stagione su appuntamento."
            ],
            "fr": [
              "Visite de la ferme : toute l’année, sur rendez-vous uniquement.\r\nPoint de vente directe à la ferme : en juillet et août tous les jours de 17h à 19h, et hors saison sur rendez-vous."
            ],
            "es": [
              "Visita de la granja: todo el año, sólo con cita previa.\r\nPunto de venta directa en la granja: en julio y agosto todos los días de 17 a 19 horas, y fuera de temporada con cita previa."
            ],
            "nl": [
              "Bezoek aan de boerderij: het hele jaar door, alleen op afspraak.\r\nRechtstreeks verkooppunt op de boerderij: in juli en augustus elke dag van 17 tot 19 uur, buiten het seizoen op afspraak."
            ]
          },
