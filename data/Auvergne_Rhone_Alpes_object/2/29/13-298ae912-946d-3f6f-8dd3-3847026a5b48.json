  "rdfs:comment": {
    "de": [
      "Auf dem Bauernhof von Pierre Vieille, zwischen Alpen und Provence, begrüßen wir Sie, um unsere verschiedenen Bio-Produktionen in aromatischen Pflanzen und Gemüseanbau zu entdecken."
    ],
    "en": [
      "At our farm between Alpes and Provence, you can discover our organic products : apricots, aromatic plants, Haute-Provence einkorn wheat,..."
    ],
    "it": [
      "Alla fattoria Pierre Vieille, tra le Alpi e la Provenza, vi invitiamo a scoprire le nostre diverse produzioni biologiche di piante aromatiche e di orticoltura"
    ],
    "fr": [
      "A la ferme de Pierre Vieille, entre Alpes et Provence, nous vous accueillons pour découvrir nos diverses productions bio en plantes aromatiques et maraichage"
    ],
