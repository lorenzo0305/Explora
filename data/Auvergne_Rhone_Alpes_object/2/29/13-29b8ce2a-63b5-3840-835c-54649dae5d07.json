  "rdfs:comment": {
    "de": [
      "Ein Spaziergang, um das Dorf Saint-Genis-Pouilly anhand von Rätseln zu entdecken, die es in Begleitung von Gustave zu lösen gilt."
    ],
    "en": [
      "Take a stroll through the village of Saint-Genis-Pouilly, solving riddles in the company of Gustave."
    ],
    "it": [
      "Una passeggiata alla scoperta del villaggio di Saint-Genis-Pouilly attraverso indovinelli da risolvere in compagnia di Gustave."
    ],
    "fr": [
      "Une balade pour découvrir le village de Saint-Genis-Pouilly à travers des énigmes à résoudre en compagnie de Gustave."
    ],
    "es": [
      "Un paseo para descubrir el pueblo de Saint-Genis-Pouilly a través de enigmas a resolver en compañía de Gustave."
    ],
    "nl": [
      "Een wandeling om het dorp Saint-Genis-Pouilly te ontdekken aan de hand van raadsels die in gezelschap van Gustave moeten worden opgelost."
    ]
  },
