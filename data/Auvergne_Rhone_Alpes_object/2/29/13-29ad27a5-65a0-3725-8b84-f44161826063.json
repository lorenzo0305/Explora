          "additionalInformation": {
            "de": [
              "Besuche ohne Voranmeldung.\r\n1. Besuch: 14.45 Uhr - 2. Besuch: 16.15 Uhr\r\n\r\n\r\nDas Schloss wird am Wochenende der Europäischen Tage des Kulturerbes am 21. und 22. September 2024 für die Öffentlichkeit zugänglich sein."
            ],
            "en": [
              "Visits without appointment.\r\n1st visit: 2.45pm - 2nd visit: 4.15pm\r\n\r\n\r\nThe château will be open to the public on the European Heritage Days weekend of September 21 and 22, 2024."
            ],
            "it": [
              "Visite senza appuntamento.\r\n1a visita: 14.45 - 2a visita: 16.15\r\n\r\n\r\nIl castello sarà aperto al pubblico durante il fine settimana delle Giornate europee del patrimonio, il 21 e 22 settembre 2024."
            ],
            "fr": [
              "Visites sans rendez-vous.\r\n1ère visite : 14h45 - 2ème visite : 16h15\r\n\r\n\r\nLe château sera ouvert au public le week-end des Journées Européennes du Patrimoine les 21 et 22 septembre 2024."
            ],
            "es": [
              "Visitas sin cita previa.\r\n1ª visita: 14.45 h - 2ª visita: 16.15 h\r\n\r\n\r\nEl castillo estará abierto al público el fin de semana de las Jornadas Europeas del Patrimonio, los días 21 y 22 de septiembre de 2024."
            ],
            "nl": [
              "Bezoek zonder afspraak.\r\n1e bezoek: 14.45 uur - 2e bezoek: 16.15 uur\r\n\r\n\r\nHet kasteel zal open zijn voor het publiek tijdens het weekend van de Europese Erfgoeddagen op 21 en 22 september 2024."
            ]
          },
