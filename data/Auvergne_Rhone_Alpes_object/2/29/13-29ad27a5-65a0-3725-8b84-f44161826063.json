  "rdfs:comment": {
    "de": [
      "Die Festung Châteaugay ist ein Beispiel für die Verteidigungsarchitektur des Mittelalters und liegt in der Limagne-Ebene."
    ],
    "en": [
      "Standing watch over the Limagne plain, the Château-fort de Châteaugay is an example of defensive architecture from the Middle Ages."
    ],
    "it": [
      "A guardia della pianura della Limagne, il castello fortificato di Châteaugay è un ottimo esempio di architettura difensiva medievale."
    ],
    "fr": [
      "En vigie sur la plaine de Limagne, le château-fort de Châteaugay constituent un exemple d’architecture défensive du Moyen Âge."
    ],
    "es": [
      "Vigilando la llanura de Limagne, la fortaleza de Châteaugay es un bello ejemplo de arquitectura defensiva medieval."
    ],
    "nl": [
      "Het fort van Châteaugay, dat over de vlakte van de Limagne waakt, is een mooi voorbeeld van middeleeuwse verdedigingsarchitectuur."
    ]
