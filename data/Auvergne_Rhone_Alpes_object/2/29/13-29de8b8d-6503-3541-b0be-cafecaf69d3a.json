  "rdfs:comment": {
    "de": [
      "Fabien Saye Kanou ist Musiker, Komponist, Schlaginstrumentenbauer und energetischer Klangtherapeut.\r\nEr ist ein Handwerker, der sich auf die Herstellung japanischer Perkussionsinstrumente spezialisiert hat, insbesondere auf japanische Trommeln und deren Zubehör: die Taikos."
    ],
    "en": [
      "Fabien Saye Kanou is a musician-composer, percussion instrument maker and energy sound therapist.\r\nHe is a craftsman specializing in the manufacture of Japanese percussion instruments, in particular Japanese drums and their accessories: the Taïko."
    ],
    "it": [
      "Fabien Saye Kanou è musicista, compositore, costruttore di strumenti a percussione e terapeuta del suono energetico.\r\nÈ un artigiano specializzato nella fabbricazione di strumenti a percussione giapponesi, in particolare di tamburi giapponesi e dei loro accessori: il Taïko."
    ],
    "fr": [
      "Fabien Saye Kanou est musicien compositeur, facteur d'instruments à percussions et sono-thérapeute énergéticien.\r\nC'est un artisan spécialisé dans la fabrication de percussions japonaises et notamment de tambours japonais et leurs accessoires : les Taïko."
    ],
    "nl": [
      "Fabien Saye Kanou is musicus, componist, percussie-instrumentenbouwer en energetisch klanktherapeut.\r\nHij is een ambachtsman die gespecialiseerd is in het vervaardigen van Japanse percussie-instrumenten, in het bijzonder Japanse trommels en hun accessoires: de Taïko."
    ],
    "es": [
      "Fabien Saye Kanou es músico, compositor, fabricante de instrumentos de percusión y terapeuta sonoro energético.\r\nEs artesano especializado en la fabricación de instrumentos de percusión japoneses, en particular tambores japoneses y sus accesorios: el Taïko."
    ]
  },
