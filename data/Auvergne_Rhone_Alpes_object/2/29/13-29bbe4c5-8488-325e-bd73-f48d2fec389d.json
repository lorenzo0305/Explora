  "rdfs:comment": {
    "de": [
      "Die Distillerie des Aravis erfährt eine zweite Jugend!\r\nRomain und Sarah, Geschwister aus Arde?che und Kinder von Destillateuren, führen das Abenteuer der Destillerie fort und bewahren die Werte: Innovation, Handwerk und Familientradition."
    ],
    "en": [
      "The Distillerie des Aravis gets a second youth !\r\nBrother and sister, originally from Ardèche and children of distillers, Romain and Sarah continue the adventure of the distillery by keeping the values: innovation, craftsmanship and family tradition."
    ],
    "it": [
      "La Distillerie des Aravis prende nuova vita!\r\nFratello e sorella, originari di Arde?che e figli di distillatori, Romain e Sarah continuano l'avventura della distilleria preservandone i valori: innovazione, artigianalità e tradizione familiare."
    ],
    "fr": [
      "La Distillerie des Aravis s’offre une seconde jeunesse !\r\nFrère et sœur, originaires d’Ardèche et enfants de distillateurs, Romain et Sarah continuent l'aventure de la distillerie en conservant les valeurs : innovation, artisanat et tradition familiale."
    ],
    "es": [
      "¡La Distillerie des Aravis se renueva!\r\nHermano y hermana, originarios de Arde?che e hijos de destiladores, Romain y Sarah continúan la aventura de la destilería preservando sus valores: innovación, artesanía y tradición familiar."
    ],
    "nl": [
      "De Distillerie des Aravis krijgt een tweede jeugd !\r\nBroer en zus, afkomstig uit de Ardèche en kinderen van distillateurs, Romain en Sarah zetten het avontuur van de distilleerderij voort door de waarden te behouden: innovatie, vakmanschap en familietraditie."
    ]
  },
