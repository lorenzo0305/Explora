  "rdfs:comment": {
    "de": [
      "Das 102 bietet eine einfache, aber effektive Speisekarte mit Burgern, Pommes frites, Salaten, Wurstplatte, Tender, Grillfleisch, gebratenem Camembert und Desserts.  Vor Ort oder zum Mitnehmen mit ausgestatteter Terrasse und Speisesaal im Inneren."
    ],
    "en": [
      "Le 102 offers a simple but effective menu featuring burgers, fries, salads, charcuterie platters, tenders, grilled meats, roast Camembert and desserts.  On-site or takeaway, with terrace and indoor dining room."
    ],
    "it": [
      "Le 102 propone un menu semplice ma efficace, con hamburger, patatine, insalate, salumi, carne alla griglia, Camembert arrosto e dessert.  In loco o da asporto, con terrazza e sala interna."
    ],
    "fr": [
      "Le 102 propose une carte simple mais efficace, composée de burgers, frites, salades, assiette de charcuterie, tenders, viande à griller, camembert rôti et desserts.  Sur place ou à emporter avec terrasse aménagée et salle de restauration à l'intérieur."
    ],
    "es": [
      "Le 102 ofrece una carta sencilla pero eficaz con hamburguesas, patatas fritas, ensaladas, charcutería, carnes a la brasa, Camembert asado y postres.  En el mismo local o para llevar, con terraza y comedor interior."
    ],
    "nl": [
      "Le 102 biedt een eenvoudig maar doeltreffend menu met hamburgers, friet, salades, vleeswaren, tenders, gegrild vlees, gebraden Camembert en desserts.  Ter plekke of om mee te nemen, met een terras en een eetzaal binnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant | Le 102"
    ]
  },
