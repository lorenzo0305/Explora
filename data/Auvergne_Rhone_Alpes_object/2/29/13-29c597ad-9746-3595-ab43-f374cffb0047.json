  "rdfs:comment": {
    "de": [
      "Als Experte und leidenschaftlicher Bergsteiger lassen Sie sich von Michael auf Wander- und Trailpfaden führen. Egal, ob Sie Anfänger oder Fortgeschrittener sind, er wird Sie sicher begleiten."
    ],
    "en": [
      "Expert and passionate about the mountains, let Michael guide you along the hiking and trail paths. Whether you're a beginner or an experienced hiker, he'll be able to guide you in complete safety."
    ],
    "it": [
      "Esperto e appassionato di montagna, lasciate che Michael vi guidi lungo i sentieri e le escursioni. Che siate principianti o esperti, Michael saprà guidarvi in tutta sicurezza."
    ],
    "fr": [
      "Expert et passionné des montagnes, laissez vous guider par Michael sur les sentiers de randonnée et de trail. Que vous soyez débutant ou confirmé, il saura vous accompagner en toute sécurité."
    ],
    "nl": [
      "Michael is deskundig en gepassioneerd over de bergen. Hij leidt je langs de wandelpaden en trails. Of je nu een beginner of een ervaren wandelaar bent, hij kan je in alle veiligheid begeleiden."
    ],
    "es": [
      "Experto y apasionado de la montaña, deja que Michael te guíe por las rutas de senderismo y los senderos. Tanto si eres principiante como experto, él sabrá guiarte con seguridad."
    ]
  },
  "rdfs:label": {
