  "rdfs:comment": {
    "de": [
      "Kuh, Maultier, Schaf? Entdecke ihre Rolle im Leben in den Bergen und stelle sie in den Farben des Herbstes dar!"
    ],
    "en": [
      "Cows, mules, sheep... Discover their role in mountain life and represent them in autumn colours!"
    ],
    "it": [
      "Mucche, muli, pecore? Scoprite il loro ruolo nella vita di montagna e dipingetele con i colori dell'autunno!"
    ],
    "fr": [
      "Vache, mulet, mouton… Découvre leur rôle dans la vie en montagne et représente-les aux couleurs de l’automne !"
    ],
    "es": [
      "¿Vacas, mulas, ovejas? Descubre su papel en la vida de la montaña y píntalas con los colores del otoño"
    ],
