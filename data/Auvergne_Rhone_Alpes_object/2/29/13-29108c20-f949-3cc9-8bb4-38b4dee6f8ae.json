  "rdfs:comment": {
    "de": [
      "Fellaventure ist die Essenz des Abenteuers in der Auvergne: Von Familienausflügen bis hin zu adrenalingeladenen Aktivitäten – entdecken Sie die geheimen Ecken und Überraschungen der Region. Möchten Sie noch weiter gehen, in der Auvergne oder anderswo? Kontaktieren Sie uns!"
    ],
    "en": [
      "Fellaventure is the essence of adventure in Auvergne: from family outings to adrenaline-fueled activities, come and discover the region's hidden gems and surprises. Want to go further, in Auvergne or elsewhere? Contact us!"
    ],
    "it": [
      "Fellaventure è l'essenza dell'avventura in Alvernia: dalle gite in famiglia alle attività adrenaliniche, venite a scoprire gli angoli segreti e le sorprese della regione. Volete andare più lontano, in Alvernia o altrove? Contattateci!"
    ],
    "fr": [
      "Fellaventure, c’est l’essence de l’aventure en Auvergne : de la sortie familiale aux activités pleines d’adrénaline, venez découvrir les coins secrets et les surprises de la région. Envie d’aller plus loin, en Auvergne ou ailleurs ? Contactez-nous !"
    ],
    "nl": [
      "Fellaventure is de essentie van avontuur in de Auvergne: van gezinsuitstapjes tot adrenalineverhogende activiteiten, kom en ontdek de geheime hoekjes en verrassingen van de regio. Wil je verder weg, in de Auvergne of elders? Neem contact met ons op!"
    ],
    "es": [
      "Fellaventure es la esencia de la aventura en Auvernia: desde paseos en familia hasta actividades llenas de adrenalina, venga a descubrir los rincones secretos y las sorpresas de la región. ¿Quiere ir más lejos, en Auvernia o en otro lugar? Póngase en contacto con nosotros"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'aventure en Auvergne et Ailleurs"
    ]
  },
