  "rdfs:comment": {
    "de": [
      "Auf 1150 m Höhe wurde in der Umgebung von Les Biolles eine Rodelbahn eingerichtet. Öffentlich zugänglich, kostenlos, Kinder unter Aufsicht der Eltern."
    ],
    "en": [
      "A sledging slope has been created in the area of Les Biolles, at an altitude of 1150 m.  Open to the public, free of charge, children must be supervised by parents."
    ],
    "it": [
      "Nel settore di Biolles, ai piedi delle piste del villaggio a 1150 m, è stata allestita una pista per slittini. Accesso libero, sotto la supervisione dei genitori."
    ],
    "fr": [
      "Une piste de luge est aménagée sur le secteur des Biolles, pied des pistes du village à 1150m. En libre accès, sous la surveillance des parents."
    ],
    "nl": [
      "Er is een rodelbaan aangelegd in de sector Biolles, aan de voet van de dorpspiste op 1150m hoogte. Vrije toegang, onder toezicht van ouders."
    ],
    "es": [
      "En el sector de Biolles, al pie de las pistas del pueblo, a 1.150 m, se ha instalado una pista de trineo. Acceso libre, bajo la supervisión de los padres."
    ]
  },
  "rdfs:label": {
