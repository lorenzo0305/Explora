  "rdfs:comment": {
    "de": [
      "Reiseberichte, Filme in Originalfassung, Familienprogramm in den Schulferien..."
    ],
    "en": [
      "Monthly program available at the tourist office or online.\r\n\r\nA 145 seats cinema with the last technological developments (3D). Travel movies in their origial versions...\r\n\r\nAsk for the programm of the cultural season (Music, theater, opera...)"
    ],
    "it": [
      "Il Quai des Arts offre un programma di eventi per il pubblico in generale e per il pubblico delle case d'arte, oltre a mostre, conferenze, concerti, opere teatrali e trasmissioni d'opera."
    ],
    "fr": [
      "Le Quai des Arts vous fait partager une programmation tout public et \"art et essai\", ainsi que des expositions, conférences, concerts, pièces de théâtre, retransmissions d'opéras."
    ],
    "es": [
      "El Quai des Arts ofrece un programa de actos para el público en general y para el público de las casas de arte, así como exposiciones, conferencias, conciertos, obras de teatro y retransmisiones de ópera."
    ],
    "nl": [
      "De Quai des Arts biedt een programma van evenementen voor het grote publiek en kunsthuispubliek, evenals tentoonstellingen, lezingen, concerten, toneelstukken en operauitzendingen."
    ]
  },
  "rdfs:label": {
