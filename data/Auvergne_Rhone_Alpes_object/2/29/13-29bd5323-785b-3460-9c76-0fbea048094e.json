  "rdfs:comment": {
    "de": [
      "Wilfried und Amandine tragen das Bio-Label und werden das ganze Jahr über von Ecocert kontrolliert. Ihr saisonales Obst und Gemüse sowie eine Auswahl anderer lokaler Produkte sind im Laden, auf Bestellung und auf dem Markt in Morestel erhältlich."
    ],
    "en": [
      "Wilfried and Amandine are certified organic and controlled by Ecocert throughout the year. Their seasonal fruit and vegetables, along with a selection of other local produce, are on sale in the store, to order and at the Morestel market."
    ],
    "it": [
      "Wilfried e Amandine sono certificati biologici e controllati da Ecocert durante tutto l'anno. La loro frutta e verdura di stagione, insieme a una selezione di altri prodotti locali, sono in vendita nel negozio, su ordinazione e al mercato di Morestel."
    ],
    "fr": [
      "Wilfried et Amandine sont labélisés Bio et contrôlés par Ecocert tout au long de l'année. Leurs fruits et légumes de saison, avec une sélection d'autres produits locaux, sont en vente à la boutique, sur commande et sur le marché de Morestel."
    ],
    "es": [
      "Wilfried y Amandine tienen el certificado ecológico y son controlados por Ecocert durante todo el año. Sus frutas y verduras de temporada, junto con una selección de otros productos locales, están a la venta en la tienda, por encargo y en el mercado de Morestel."
    ],
    "nl": [
      "Wilfried en Amandine zijn biologisch gecertificeerd en worden het hele jaar door gecontroleerd door Ecocert. Hun seizoensfruit en -groenten, samen met een selectie van andere lokale producten, zijn te koop in de winkel, op bestelling en op de markt van Morestel."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Ferme des 4 saisons"
    ],
    "fr": [
      "La ferme des 4 saisons"
    ]
  },
