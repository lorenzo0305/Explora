  "rdfs:comment": {
    "de": [
      "Bergrestaurant auf 1767 m Höhe in N Dame de Bellecombe auf dem Gipfel des Mont-Rond. Terrasse mit 360-Grad-Aussicht, Liegebereich mit Blick auf den Col des Saisies. Im Sommer jeden Sonntag Brunch, Reservierung für den Abend möglich."
    ],
    "en": [
      "High altitude restaurant located at 1767 m on the heights of N Dame de Bellecombe at the top of Mont-Rond. Terrace with a 360 degree view, deckchair area overlooking the Col des Saisies. In summer, brunch every Sunday, possibility of reservation for the evening."
    ],
    "it": [
      "Ristorante d'alta quota situato a 1767 m sulle alture di Notre Dame de Bellecombe. Terrazza panoramica in cima al Mont Rond, zona con sedie a sdraio. Aperto in inverno e in estate (luglio e agosto)\r\nSi consiglia vivamente la prenotazione."
    ],
    "fr": [
      "Restaurant d’altitude situé à 1767m sur les hauteurs de Notre Dame de Bellecombe. Terrasse panoramique au sommet du Mont Rond, espace transat. Ouvert les saisons d’hiver ainsi que l’été (Juillet & Août)\r\nRéservation fortement conseillée."
    ],
    "es": [
      "Restaurante de altura situado a 1767 m en las alturas de Notre Dame de Bellecombe. Terraza panorámica en la cima del Mont Rond, zona de tumbonas. Abierto en invierno y verano (julio y agosto)\r\nSe recomienda encarecidamente reservar."
    ],
    "nl": [
      "Hooggelegen restaurant op 1767m op de hoogten van Notre Dame de Bellecombe. Panoramisch terras op de top van de Mont Rond, met ligstoelen. Geopend in de winter en de zomer (juli en augustus)\r\nReserveren sterk aanbevolen."
    ]
  },
