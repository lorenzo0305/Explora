  "rdfs:comment": {
    "de": [
      "Eine gute traditionelle Küche für Feinschmecker, die gute Produkte lieben. Ab dem Frühling sitzt man gerne im Schatten der großen Bäume, die die Hitze der Stadt fernhalten."
    ],
    "en": [
      "Great traditional cuisine for all those food lovers fond of good products. Starting in the spring, you can enjoy sitting in the shade of tall trees that shelter from the heat of the city."
    ],
    "it": [
      "Una buona cucina tradizionale per i buongustai che amano i buoni prodotti. Dalla primavera in poi, ci piace sederci all'ombra dei grandi alberi che tengono a bada il calore della città."
    ],
    "fr": [
      "Une bonne cuisine traditionnelle pour les gourmands qui aiment les bons produits. Dès le printemps, on aime s'installer à l'ombre des grands arbres qui éloignent la chaleur de la ville."
    ],
    "es": [
      "Una buena cocina tradicional para los gourmets amantes de los buenos productos. A partir de la primavera, nos gusta sentarnos a la sombra de los grandes árboles que mantienen a raya el calor de la ciudad."
    ],
    "nl": [
      "Goede traditionele gerechten voor fijnproevers die van goede producten houden. Vanaf de lente willen we ons nestelen in de schaduw van de hoge bomen die de hitte buiten de stad houden."
    ]
  },
