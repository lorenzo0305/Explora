  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Schnitzeljagd \"Le Fil du Rail\" in Vallorcine!\r\nDie Faltblätter zu den Schnitzeljagden erhalten Sie kostenlos am Empfang der Fremdenverkehrsbüros des Chamonix-Tals"
    ],
    "en": [
      "Come and discover the \"Fil du Rail\" treasure hunt in Vallorcine!\r\nLeaflets are available free of charge from the Chamonix Valley Tourist Offices."
    ],
    "it": [
      "Venite a scoprire la caccia al tesoro \"Fil du Rail\" a Vallorcine!\r\nGli opuscoli dei giochi del sentiero sono disponibili gratuitamente presso gli Uffici del Turismo della Valle di Chamonix."
    ],
    "fr": [
      "Venez découvrir le jeu de piste au Fil du Rail à Vallorcine !\r\nLes dépliants des jeux de piste sont disponibles gratuitement à l'accueil des Offices de Tourisme de la Vallée de Chamonix"
    ],
    "es": [
      "¡Venga a descubrir la caza del tesoro \"Fil du Rail\" en Vallorcine!\r\nLos folletos de los juegos de pistas están disponibles gratuitamente en las Oficinas de Turismo del Valle de Chamonix."
    ],
    "nl": [
      "Kom en ontdek de \"Fil du Rail\" schattenjacht in Vallorcine!\r\nDe folders voor de speurtochten zijn gratis verkrijgbaar bij de VVV-kantoren in de vallei van Chamonix"
    ]
  },
  "rdfs:label": {
    "en": [
      "Rail and Trail - Nature and heritage quiz in Vallorcine"
    ],
    "fr": [
      "Au Fil du Rail - Jeu de piste à Vallorcine"
    ]
  },
