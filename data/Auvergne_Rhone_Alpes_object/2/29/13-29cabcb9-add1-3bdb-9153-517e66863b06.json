  "rdfs:comment": {
    "de": [
      "Das im Polinno ansässige Atelier des Modestes vereint Tradition und Moderne, um einzigartige handgefertigte Korbwaren herzustellen. Entdecken Sie authentische und natürliche Kreationen und kreieren Sie in Einführungskursen mit Ihren eigenen Händen."
    ],
    "en": [
      "L'Atelier des Modestes, based at Polinno, combines tradition and modernity to create one-of-a-kind wickerwork pieces. Discover authentic, natural creations and create with your own hands thanks to introductory courses."
    ],
    "it": [
      "L'Atelier des Modestes, con sede a Polinno, unisce tradizione e modernità per creare pezzi unici di cesteria artigianale. Scoprite creazioni autentiche e naturali e create con le vostre mani grazie ai corsi introduttivi."
    ],
    "fr": [
      "L'Atelier des Modestes, résident au Polinno, allie tradition et modernité pour créer des pièces uniques en vannerie artisanale. Découvrez des créations authentiques et naturelles et créez de vos propres mains grâce à des stages d'initiation."
    ],
    "nl": [
      "L'Atelier des Modestes, gevestigd in Polinno, combineert traditie en moderniteit om unieke handgemaakte manden te maken. Ontdek authentieke, natuurlijke creaties en creëer met je eigen handen dankzij inleidende cursussen."
    ],
    "es": [
      "L'Atelier des Modestes, con sede en Polinno, combina tradición y modernidad para crear piezas únicas de cestería artesanal. Descubre creaciones auténticas y naturales y crea con tus propias manos gracias a los cursos de iniciación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'atelier des modestes - Vannerie"
    ]
  },
