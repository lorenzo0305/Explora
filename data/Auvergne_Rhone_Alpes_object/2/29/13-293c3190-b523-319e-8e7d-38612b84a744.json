  "rdfs:comment": {
    "de": [
      "Bäckerei-Konditorei mit einer Auswahl an speziellen Bio-Broten, die mit hausgemachtem Sauerteig zubereitet werden, sowie Konditoreiwaren und Feingebäck aus reiner Butter.\r\nEine Lebensmittelabteilung, Snacks und Gerichte zum Mitnehmen,"
    ],
    "en": [
      "Bakery-pastry shop with a range of special organic breads made with homemade sourdough, pastries and pure butter viennoiserie.\r\nGroceries, snacks and takeaways,"
    ],
    "it": [
      "Panificio-pasticceria con una gamma di pani speciali biologici prodotti con lievito madre fatto in casa, pasticcini e paste di puro burro.\r\nGeneri alimentari, snack e takeaway,"
    ],
    "fr": [
      "Boulangerie-pâtisserie avec une gamme de pains spéciaux bio préparés avec du levain fait maison, de la pâtisserie et de la viennoiserie pure beurre.\r\nUn rayon épicerie, du snacking et des plats à emporter,"
    ],
    "es": [
      "Panadería-pastelería con una gama de panes ecológicos especiales elaborados con masa madre casera, bollería y pastelería de mantequilla pura.\r\nComestibles, bocadillos y comida para llevar,"
    ],
    "nl": [
      "Bakkerij-banketbakkerij met een assortiment speciale biologische broden gemaakt met zelfgebakken zuurdesem, gebak en pure botergebakjes.\r\nBoodschappen, snacks en afhaalmaaltijden,"
    ]
  },
  "rdfs:label": {
