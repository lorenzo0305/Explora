  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Biathlon auf spielerische und zugängliche Weise. Zu Fuß, auf Skiern, auf Ski-Rädern, als Einführung, zur Perfektionierung oder auch in Form eines Escape Games! Ein einzigartiges Erlebnis in der Haut der Biathlon-Champions, betreut von Spezialisten."
    ],
    "en": [
      "The best way to discover biathlon, a shooting experience coached by top athletes, put yourself in champions' shoes. A unique activity, fun, accessible to all, without minimum sports level, with good mood and friendliness!"
    ],
    "it": [
      "Scoprite il biathlon in modo divertente e accessibile. A piedi, con gli sci, con le ruote, per principianti, avanzati o sotto forma di gioco di fuga! Un'esperienza unica nei panni dei campioni di biathlon, sotto la supervisione di specialisti."
    ],
    "fr": [
      "Découvrez le biathlon de manière ludique et accessible. A pied, à ski, à ski-roues, en initiation, en perfectionnement ou encore sous forme d'escape game ! Une expérience unique dans la peau des champions de biathlon, encadrée par des spécialistes."
    ],
    "nl": [
      "Ontdek biatlon op een leuke en toegankelijke manier. Te voet, op ski's, op skiwielen, voor beginners, gevorderden of in de vorm van een ontsnappingsspel! Een unieke ervaring in de schoenen van biatlonkampioenen, begeleid door specialisten."
    ],
    "es": [
      "Descubra el biatlón de forma divertida y accesible. A pie, sobre esquís, sobre ruedas de esquí, para principiantes, avanzados o en forma de juego de escape Una experiencia única en la piel de campeones de biatlón, supervisada por especialistas."
    ]
  },
