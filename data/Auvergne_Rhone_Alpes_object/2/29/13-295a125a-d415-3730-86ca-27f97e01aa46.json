  "rdfs:comment": {
    "de": [
      "Erkunden Sie Les Avenières Veyrins-Thuellin, im Südosten der Balcons du Dauphiné, einer Gemeinde, die an das nationale Naturschutzgebiet der französischen Haut-Rhône grenzt und einen der größten Freizeitparks Frankreichs beherbergt: Walibi Rhône-Alpes."
    ],
    "en": [
      "Explore Les Avenières Veyrins-Thuellin, in the south-east of the Balcons du Dauphiné, a commune bordered by the French Haut-Rhône National Nature Reserve, home to one of France's biggest theme parks: Walibi Rhône-Alpes."
    ],
    "it": [
      "Esplorate Les Avenières Veyrins-Thuellin, nel sud-est dei Balcons du Dauphiné, un comune confinante con la Riserva Naturale Nazionale dell'Haut-Rhône, che ospita uno dei più grandi parchi a tema della Francia: Walibi Rhône-Alpes."
    ],
    "fr": [
      "Explorez les Avenières Veyrins-Thuellin, au sud-est des Balcons du Dauphiné, commune bordée par la Réserve Naturelle Nationale du Haut-Rhône français, qui abrite un des plus importants parcs d'attraction de France : Walibi Rhône-Alpes."
    ],
    "nl": [
      "Ontdek Les Avenières Veyrins-Thuellin, in het zuidoosten van de Balcons du Dauphiné, een gemeente die grenst aan het Franse nationale natuurreservaat Haut-Rhône, waar een van de grootste themaparken van Frankrijk ligt: Walibi Rhône-Alpes."
    ],
    "es": [
      "Explore Les Avenières Veyrins-Thuellin, en el sureste de los Balcones del Dauphiné, municipio que limita con el Parque Natural Nacional del Alto Ródano francés, donde se encuentra uno de los mayores parques temáticos de Francia: Walibi Rhône-Alpes."
    ]
  },
