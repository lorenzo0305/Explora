  "rdfs:comment": {
    "de": [
      "Musherin, Führerin von Schlittenhunden, Cani-Balade.\r\nReferentin für Tiervermittlung durch Mushing bei Menschen mit Schwierigkeiten (Hyperaktivität, Verhaltensstörungen, psychische Störungen, leichte Behinderung, Selbstwertgefühl, Motivation zum Sport)."
    ],
    "en": [
      "Musher, sled dog driver, cani-walking.\r\nSpeaker in animal mediation through mushing with people in difficulty (hyperactivity, behavioral disorders, psychological disorders, mild impairment, self-esteem, motivation for sport)."
    ],
    "it": [
      "Musher, conduttore di cani da slitta, cani-balade.\r\nIstruttore di mediazione animale che utilizza il mushing con persone in difficoltà (iperattività, disturbi comportamentali, disturbi psicologici, disabilità lieve, autostima, motivazione allo sport)."
    ],
    "fr": [
      "Musher, conductrice de chiens de traineaux, cani-balade.\r\nIntervenante en médiation animale par le mushing auprès de public en difficulté (hyperactivité, troubles du comportement, troubles psychiques, déficience légère, estime de soi, motivation au sport)."
    ],
    "nl": [
      "Musher, sledehondendrijver, cani-balade.\r\nDocent dierbemiddeling met behulp van mushing bij mensen met problemen (hyperactiviteit, gedragsstoornissen, psychische stoornissen, lichte beperking, gevoel van eigenwaarde, motivatie voor sport)."
    ],
    "es": [
      "Musher, conductor de perros de trineo, cani-balade.\r\nInstructor en mediación animal utilizando el mushing con personas con dificultades (hiperactividad, trastornos del comportamiento, trastornos psicológicos, deficiencia leve, autoestima, motivación para el deporte)."
    ]
  },
  "rdfs:label": {
