  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Christophe-et-le-Laris liegt 9 km südlich von Grand-Serre (Hauptort des Kantons), 20 km nördlich von Romans-sur-Isère und 28 km nordöstlich von Tain-l'Hermitage."
    ],
    "en": [
      "Saint-Christophe-et-le-Laris is located 9 km south of Grand-Serre (county town), 20 km north of Romans-sur-Isère and 28 km northeast of Tain-l'Hermitage."
    ],
    "it": [
      "Saint-Christophe-et-le-Laris si trova a 9 km a sud di Grand-Serre (centro amministrativo del cantone), a 20 km a nord di Romans-sur-Isère e a 28 km a nord-est di Tain-l'Hermitage."
    ],
    "fr": [
      "La commune de Saint-Christophe-et-le-Laris est située à 9 km au sud du Grand-Serre (chef-lieu du canton), à 20 km au nord de Romans-sur-Isère et à 28 km au nord-est de Tain-l'Hermitage."
    ],
    "es": [
      "Saint-Christophe-et-le-Laris se encuentra a 9 km al sur de Grand-Serre (centro administrativo del cantón), a 20 km al norte de Romans-sur-Isère y a 28 km al noreste de Tain-l'Hermitage."
    ],
    "nl": [
      "Saint-Christophe-et-le-Laris ligt 9 km ten zuiden van Grand-Serre (het administratieve centrum van het kanton), 20 km ten noorden van Romans-sur-Isère en 28 km ten noordoosten van Tain-l'Hermitage."
    ]
  },
