  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Angeln von Forellen in Flüssen, das Ökosystem, in dem sie leben, und wie man die Wachsamkeit der wunderschönen wilden Bachforellen in unseren Flüssen täuschen kann."
    ],
    "en": [
      "Discover how to fish for trout in rivers, the ecosystem in which they live and how to deceive the vigilance of the magnificent wild brown trout in our rivers."
    ],
    "it": [
      "Scoprite come pescare le trote nei fiumi, l'ecosistema in cui vivono e come ingannare la vigilanza delle magnifiche trote fario selvatiche dei nostri fiumi."
    ],
    "fr": [
      "Découverte de la pêche de la truite en rivière, de l’écosystème dans lequel elles vivent et des façons de tromper la vigilance des magnifiques truites farios sauvages de nos rivières."
    ],
    "nl": [
      "Ontdek hoe je in rivieren op forel kunt vissen, het ecosysteem waarin ze leven en hoe je de waakzaamheid van de prachtige wilde beekforel in onze rivieren kunt misleiden."
    ],
    "es": [
      "Descubra cómo pescar truchas en los ríos, el ecosistema en el que viven y cómo engañar la vigilancia de las magníficas truchas marrones salvajes de nuestros ríos."
    ]
  },
  "rdfs:label": {
