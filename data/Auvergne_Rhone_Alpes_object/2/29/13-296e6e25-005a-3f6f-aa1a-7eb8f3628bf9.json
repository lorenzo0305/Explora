  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bietet Ihnen das Bureau des Guides d'Aussois Bergsportaktivitäten für Anfänger oder Fortgeschrittene, in Gruppen oder mit privatem Engagement."
    ],
    "en": [
      "Throughout the year, the Bureau des Guides offers mountain activities for beginners or advanced training; in collectives or private engagement."
    ],
    "it": [
      "Durante tutto l'anno, il Bureau des Guides d'Aussois offre attività di introduzione alla montagna e di perfezionamento, in gruppo o su base privata."
    ],
    "fr": [
      "Tout au long de l'année, le Bureau des Guides d'Aussois vous propose des activités de montagne en initiation ou perfectionnement, en collectif ou à l'engagement privé."
    ],
    "nl": [
      "Het Bureau des Guides biedt het hele jaar door bergactiviteiten voor beginners of gevorderden; in collectieven of privébetrokkenheid."
    ],
    "es": [
      "Durante todo el año, el Bureau des Guides d'Aussois ofrece actividades de montaña de iniciación y perfeccionamiento, en grupo o a título particular."
    ]
  },
