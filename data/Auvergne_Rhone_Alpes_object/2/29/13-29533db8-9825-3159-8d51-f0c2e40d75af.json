  "rdfs:comment": {
    "de": [
      "Fahrradtourismus-Club, der der FFCT angehört.\nWöchentliche Straßenfahrten am Dienstag und Sonntag ab Grignan, am Donnerstag ab Taulignan.\n VAE (Vélo à Assistance Électrique) akzeptiert."
    ],
    "en": [
      "Organisation of bike rambles."
    ],
    "it": [
      "Club di cicloturismo, affiliato alla FFCT.\nUscite settimanali su strada il martedì e la domenica da Grignan e il giovedì da Taulignan.\n Sono accettati i VAE (Vélo à Assistance Électrique)."
    ],
    "fr": [
      "Club de cyclotourisme, affilié à la FFCT.\nSorties Route hebdomadaires le mardi  et dimanche au départ de Grignan, le jeudi au départ de Taulignan.\n VAE accepté (Vélo à Assistance Électrique)."
    ],
    "nl": [
      "Fietstoerclub, aangesloten bij de FFCT.\nWekelijkse uitstapjes op de weg op dinsdag en zondag vanuit Grignan en op donderdag vanuit Taulignan.\n VAE (Vélo à Assistance Électrique) wordt geaccepteerd."
    ],
    "es": [
      "Club de cicloturismo afiliado a la FFCT.\nSalidas semanales por carretera los martes y domingos desde Grignan, y los jueves desde Taulignan.\n Se acepta VAE (Vélo à Assistance Électrique)."
    ]
  },
