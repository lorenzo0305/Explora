  "rdfs:comment": {
    "de": [
      "Mein Name ist Emmanuelle und ich bin Bergbegleiterin und Spielentwicklerin.\r\nIch begleite Kindergruppen bei Ausflügen in die Natur, im Winter beim Schneeschuhwandern, im Frühling, Sommer und Herbst beim Wandern."
    ],
    "en": [
      "My name is Emmanuelle and I'm a mountain guide and games designer.\r\nI accompany groups of children on nature outings, snowshoeing in winter, hiking in spring, summer and autumn."
    ],
    "it": [
      "Mi chiamo Emmanuelle e sono un'animatrice di montagna e un'ideatrice di giochi.\r\nAccompagno gruppi di bambini in gite nella natura, ciaspolate in inverno ed escursioni in primavera, estate e autunno."
    ],
    "fr": [
      "Je m'appelle Emmanuelle et suis accompagnatrice en montagne et créatrice de jeux. \r\nJ'accompagne les groupes d'enfants lors de sorties de pleine nature, l'hiver en raquettes, le printemps, l'été et l'automne, pour des randonnées pédestres."
    ],
    "nl": [
      "Mijn naam is Emmanuelle en ik ben bergleider en spelontwerper.\r\nIk begeleid groepen kinderen op natuurexcursies, sneeuwschoenwandelen in de winter en wandelen in de lente, zomer en herfst."
    ],
    "es": [
      "Me llamo Emmanuelle y soy monitora de montaña y diseñadora de juegos.\r\nAcompaño a grupos de niños en salidas a la naturaleza, con raquetas de nieve en invierno y haciendo senderismo en primavera, verano y otoño."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Montagne de jeux"
    ]
  },
