  "rdfs:comment": {
    "de": [
      "Boardercross mit roter Klassifizierung. Steilwandkurven, eine schöne Länge und ein ausreichender Höhenunterschied machen ihn zu einem Spielplatz, auf dem sich Groß und Klein in aller Sicherheit austoben können."
    ],
    "en": [
      "Red-rated boarder cross. With its banked turns, great length and sufficient gradient, this is a fun area where young and old alike can have fun in complete safety."
    ],
    "it": [
      "Boarder cross di colore rosso. Con le sue curve a sponde, la grande lunghezza e la pendenza sufficiente, è un'area divertente dove grandi e piccini possono divertirsi in tutta sicurezza."
    ],
    "fr": [
      "Boarder cross classé rouge. Des virages relevés, une belle longueur et du dénivelé suffisant en feront un espace ludique où petits et grands s'éclateront en toute sécurité."
    ],
    "nl": [
      "Grensoverschrijding geclassificeerd als rood. Met scherpe bochten, een goede lengte en voldoende hoogteverschil is dit een leuk terrein waar jong en oud zich in alle veiligheid kunnen vermaken."
    ],
    "es": [
      "Cruce de tablas con clasificación roja. Con sus curvas peraltadas, gran longitud y pendiente suficiente, es una zona de diversión donde pequeños y mayores pueden divertirse con total seguridad."
    ]
  },
