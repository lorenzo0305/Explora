  "rdfs:comment": {
    "de": [
      "ART A VIE ist ein einzigartiger Concept-Store rund um die Welt des Hauses mit lokalen und französischen Designern.\r\nDie Boutique bietet eine Auswahl an einzigartigen Objekten in einer kokonartigen und herzlichen Atmosphäre!!!\r\nDas Hotel liegt 15 Minuten von Annecy entfernt."
    ],
    "en": [
      "ART A VIE is a unique concept store dedicated to the world of the home, featuring local and French designers.\r\nThe boutique offers a selection of unique objects in a warm, cocooning atmosphere!\r\nLocated 15 minutes from Annecy."
    ],
    "it": [
      "ART A VIE è un concept store unico basato sul mondo della casa e caratterizzato da designer locali e francesi.\r\nIl negozio offre una selezione di oggetti unici in un'atmosfera calda e avvolgente!\r\nSituato a 15 minuti da Annecy."
    ],
    "fr": [
      "ART A VIE est un concept-store unique autour de l'univers de la maison avec des créateurs locaux et Français.\r\nLa boutique offre une sélection d'objets uniques dans une ambiance cocooning et chaleureuse !!!\r\nSitué à 15 minutes d'Annecy."
    ],
    "nl": [
      "ART A VIE is een unieke conceptwinkel rond de wereld van het huis met lokale en Franse ontwerpers.\r\nDe winkel biedt een selectie unieke voorwerpen in een warme, gezellige sfeer!\r\nOp 15 minuten van Annecy."
    ],
    "es": [
      "ART A VIE es un concepto de tienda único que gira en torno al mundo del hogar y presenta diseñadores locales y franceses.\r\nLa tienda ofrece una selección de objetos únicos en un ambiente cálido y acogedor\r\nSituada a 15 minutos de Annecy."
    ]
  },
