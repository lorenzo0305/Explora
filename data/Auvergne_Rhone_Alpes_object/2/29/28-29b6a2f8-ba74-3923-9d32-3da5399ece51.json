  "rdfs:comment": {
    "de": [
      "Nehmen Sie sich Zeit, lassen Sie los und erholen Sie sich bei einer Spazierfahrt. Nutzen Sie die fachkundigen Kommentare unseres Matrosen, um die Oise zu entdecken."
    ],
    "en": [
      "Take your time, let go, and relax during a cruise. Take advantage of our sailor's comments to discover the Oise."
    ],
    "it": [
      "Prendetevi il vostro tempo, lasciatevi andare e fate il pieno di energia durante una crociera. Approfittate dei nostri commenti da marinaio per scoprire l'Oise."
    ],
    "fr": [
      "Prenez votre temps, lâchez prise, et ressourcez-vous pendant une croisière promenade. Bénéficiez des commentaires avisés de notre matelot pour découvrir l’Oise."
    ],
    "es": [
      "Tómese su tiempo, déjese llevar y recargue las pilas durante un crucero. Aprovecha nuestros comentarios marineros para descubrir el Oise."
    ],
    "nl": [
      "Neem de tijd, laat u gaan en doe nieuwe energie op tijdens een cruise. Profiteer van onze opmerkingen van zeilers om de Oise te ontdekken."
    ]
  },
