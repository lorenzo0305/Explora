  "rdfs:comment": {
    "de": [
      "Beste Käsespezialitäten der Region vom traditionellen,\r\nsavoyischen Fondue mit Tomate, Lauch bis zum gefüllten\r\nReblochon."
    ],
    "en": [
      "The best cheese specialities of the region make a traditional\r\nSavoy fondue with tomato, leek, and stuffed Reblochon\r\ncheese."
    ],
    "it": [
      "Questo piccolo e accogliente ristorante serve solo prodotti freschi.\r\nSpecialità savoiarde: fonduta, raclette, tartiflette, reblochon ripieno, tomme arrosto, ecc.\r\nAnche cucina francese: ragù, bourguignon, testa di vitello, ecc"
    ],
    "fr": [
      "Petit restaurant convivial, on y mange que des produits frais.\r\nSpécialité savoyarde : fondue, raclette, tartiflette, reblochon farci, tomme rôtie etc...\r\nÉgalement cuisine française : ragout, bourguignon, tête de veau"
    ],
    "es": [
      "Este pequeño y acogedor restaurante sólo sirve productos frescos.\r\nEspecialidades saboyanas: fondue, raclette, tartiflette, reblochon relleno, tomme asado, etc.\r\nTambién cocina francesa: ragú, bourguignon, cabeza de ternera, etc"
    ],
    "nl": [
      "Dit kleine, vriendelijke restaurant serveert alleen verse producten.\r\nSavoyaardse specialiteiten: fondue, raclette, tartiflette, gevulde reblochon, gebraden tomme, enz.\r\nOok Franse keuken: ragout, bourguignon, kalfskop, enz"
    ]
  },
