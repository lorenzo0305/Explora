  "rdfs:comment": {
    "de": [
      "Familienbauernhof seit 1960, biologisch seit 2007: In Portes les Valence im Departement Drôme gelegen, produziert, verarbeitet und verkauft unser Familienbauernhof seit vier Generationen Eier, Mehl, Nudeln und Öle aus biologischem Anbau."
    ],
    "en": [
      "Family farm since 1960, organic since 2007: located in Portes les Valence in the Drôme, our 4-generation family farm produces, processes and sells organic eggs, flour, pasta and oils."
    ],
    "it": [
      "Azienda agricola a conduzione familiare dal 1960, biologica dal 2007: situata a Portes-lès-Valence, nella Drôme, la nostra azienda agricola familiare di 4 generazioni produce, trasforma e vende uova, farina, pasta e oli biologici."
    ],
    "fr": [
      "Ferme familiale depuis 1960, en bio depuis 2007 : située à Portes-lès-Valence dans la Drôme, notre ferme familiale depuis 4 générations, produit, transforme et vend œufs, farines, pâtes et huiles issues de l'agriculture biologique."
    ],
    "es": [
      "Granja familiar desde 1960, ecológica desde 2007: situada en Portes-lès-Valence, en la Drôme, nuestra granja familiar de 4 generaciones produce, transforma y comercializa huevos, harina, pasta y aceites ecológicos."
    ],
    "nl": [
      "Familieboerderij sinds 1960, biologisch sinds 2007: gelegen in Portes les Valence in de Drôme, produceert, verwerkt en verkoopt onze familieboerderij van 4 generaties biologische eieren, meel, pasta en olie."
    ]
  },
