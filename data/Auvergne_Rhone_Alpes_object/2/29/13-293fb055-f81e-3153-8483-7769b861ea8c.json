  "rdfs:comment": {
    "de": [
      "Betreute Ausflüge mit einem staatlich geprüften Lehrer: Klettersteig, Klettern und Canyoning für Einzelpersonen und Gruppen. Die Ausrüstung wird zur Verfügung gestellt. Auf Reservierung mindestens 48 Stunden im Voraus."
    ],
    "en": [
      "Supervised outings with a state-certified instructor: via ferrata, climbing and canyoning for individuals and groups. All equipment provided. Reservations required at least 48 hours in advance."
    ],
    "it": [
      "Uscite supervisionate con un istruttore qualificato: via ferrata, arrampicata e canyoning per singoli e gruppi. Attrezzatura fornita. Le prenotazioni devono essere effettuate con almeno 48 ore di anticipo."
    ],
    "fr": [
      "Sorties encadrées avec un moniteur brevet d'état : via ferrata, escalade et canyoning pour les individuels et les groupes. Le matériel est fourni. Sur réservation au minimum 48 h à l'avance."
    ],
    "nl": [
      "Uitstapjes onder begeleiding van een gekwalificeerde instructeur: klettersteigen, klimmen en canyoning voor individuen en groepen. Uitrusting aanwezig. Reserveringen moeten ten minste 48 uur van tevoren worden gemaakt."
    ],
    "es": [
      "Salidas supervisadas con un instructor cualificado: vía ferrata, escalada y barranquismo para particulares y grupos. Material proporcionado. Las reservas deben realizarse con un mínimo de 48 horas de antelación."
    ]
  },
