  "rdfs:comment": {
    "de": [
      "Dorf Chazelles: Kleines Dorf, das auf einer Felsplattform erbaut wurde und das Tal der Desges überblickt. Ruinen des Schlosses Montpeyroux aus dem 12. bis 14. Jahrhundert. Staudamm mit Fischtreppe in Nadelform."
    ],
    "en": [
      "Village of Chazelles: Small village built on a rocky platform overlooking the Desges Valley. Ruins of the 12th-14th-century château de Montpeyroux. Dam with fish ladder."
    ],
    "it": [
      "Villaggio di Chazelles: piccolo villaggio costruito su una piattaforma rocciosa che domina la Valle di Desges. Rovine del castello di Montpeyroux del XII-XIV secolo. Diga con scala per pesci."
    ],
    "fr": [
      "Village de Chazelles : Petit village construit sur une plate-forme rocheuse qui domine la Vallée de la Desges. Ruines du château de Montpeyroux des XIIe-XIVe siècles. Barrage avec échelle à poissons en épingle."
    ],
    "es": [
      "Pueblo de Chazelles: Pequeño pueblo construido sobre una plataforma rocosa que domina el valle de Desges. Ruinas del castillo de Montpeyroux, siglos XII-XIV. Presa con escalera para peces."
    ],
    "nl": [
      "Dorp Chazelles: Klein dorp gebouwd op een rotsplateau met uitzicht op de Desges-vallei. Ruïnes van het kasteel van Montpeyroux uit de 12e-14e eeuw. Dam met vistrap."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Chazelles"
    ]
  },
