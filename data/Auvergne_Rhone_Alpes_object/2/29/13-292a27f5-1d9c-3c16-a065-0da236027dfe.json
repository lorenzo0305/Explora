  "rdfs:comment": {
    "de": [
      "Norwegisches Bad, traditionelle Sauna und Reflexzonenmassage erwarten Sie auf dem Plateau de Retord!\r\nGenießen Sie einen Moment der Entspannung im Herzen des Ortes Les Plans d'Hotonnes im Wellnessbereich von Ain'sTemps loisirs!"
    ],
    "en": [
      "Norwegian baths, traditional saunas and reflexology await you at Plateau de Retord!\r\nEnjoy a moment of relaxation in the heart of the Plans d'Hotonnes resort, in the Ain'sTemps loisirs wellness centre!"
    ],
    "it": [
      "Bagno norvegese, sauna tradizionale e riflessologia vi aspettano sul Plateau de Retord!\r\nGodetevi un momento di relax nel cuore della località di Les Plans d'Hotonnes, nel centro benessere Ain'sTemps loisirs!"
    ],
    "fr": [
      "Bain norvégien, sauna traditionnel et réflexologie vous attendent sur le Plateau de Retord ! \r\nProfitez d'un moment de détente en plein cœur de la station des Plans d'Hotonnes, dans l'espace bien-être d'Ain'sTemps loisirs !"
    ],
    "nl": [
      "Noors bad, traditionele sauna en reflexologie wachten op u op het Plateau de Retord!\r\nGeniet van een moment van ontspanning in het hart van het resort Les Plans d'Hotonnes, in het wellnesscentrum Ain'sTemps loisirs!"
    ],
    "es": [
      "Baño noruego, sauna tradicional y reflexología le esperan en el Plateau de Retord\r\nDisfrute de un momento de relajación en el corazón de la estación de Les Plans d'Hotonnes, en el centro de bienestar Ain'sTemps loisirs"
    ]
  },
  "rdfs:label": {
    "en": [
      "Hot tub and sauna in Les Plans d'Hotonnes"
    ],
    "fr": [
      "Ain's Temps Loisirs : espace bien-être"
    ]
  },
