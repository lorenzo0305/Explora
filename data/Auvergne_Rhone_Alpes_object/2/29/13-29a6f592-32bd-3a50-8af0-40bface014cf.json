  "rdfs:comment": {
    "de": [
      "Der Picknickplatz \"Rond de la cave\" befindet sich mitten im Wald. Er ist daher sehr schattig."
    ],
    "en": [
      "The rond de la cave picnic area is located in the middle of the forest. It is therefore very shaded."
    ],
    "it": [
      "L'area picnic del Rond de la Cave si trova in mezzo alla foresta. È quindi molto ombreggiata."
    ],
    "fr": [
      "L'aire de pique-nique du rond de la cave se situe en pleine forêt. Elle est donc très ombragée."
    ],
    "es": [
      "El merendero de Rond de la Cave se encuentra en pleno bosque. Por lo tanto, tiene mucha sombra."
    ],
    "nl": [
      "De picknickplaats bij Rond de la Cave ligt midden in het bos. Het is daarom erg schaduwrijk."
    ]
  },
  "rdfs:label": {
