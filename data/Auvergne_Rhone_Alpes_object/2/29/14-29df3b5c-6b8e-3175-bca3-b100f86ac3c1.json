  "rdfs:comment": {
    "de": [
      "Acht Freunde treffen sich zu einer langen, belebenden Diskussion, die von Hip-Hop-Performances unterbrochen wird und bei der sie nach Seitenwegen suchen, um den Stereotypen der Hyper-Maskulinität zu entkommen."
    ],
    "en": [
      "Eight friends get together for a long, lively discussion, interspersed with hip-hop performances, during which they look for ways to escape the stereotypes of hyper-masculinity."
    ],
    "it": [
      "Otto amici si riuniscono per una lunga e vivace discussione, intervallata da esibizioni hip-hop, durante la quale cercano un modo per sfuggire agli stereotipi dell'iper-mascolinità."
    ],
    "fr": [
      "Huit amis se retrouvent pour une longue discussion vivifiante, entrecoupée de performances hip-hop, durant laquelle ils cherchent des chemins de traverse pour échapper aux stéréotypes de l’hyper-masculinité."
    ],
    "es": [
      "Ocho amigos se reúnen en una larga y animada discusión, intercalada con actuaciones de hip-hop, durante la cual buscan formas de escapar de los estereotipos de la hipermasculinidad."
    ],
    "nl": [
      "Acht vrienden komen samen voor een lange, levendige discussie, afgewisseld met hiphopoptredens, waarin ze op zoek gaan naar manieren om te ontsnappen aan de stereotypen van hypermannelijkheid."
    ]
  },
