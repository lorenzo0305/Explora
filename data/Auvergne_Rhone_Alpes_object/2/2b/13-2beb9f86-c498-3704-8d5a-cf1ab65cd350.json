  "rdfs:comment": {
    "de": [
      "Als Holzdrechsler empfängt Philippe Sie (ohne Termin) in seinem Atelier und bietet Ihnen auch Drechselworkshops an (nach Voranmeldung)."
    ],
    "en": [
      "A woodturner, Philippe welcomes you to his workshop (no appointment necessary), and also offers woodturning workshops (by prior arrangement)."
    ],
    "it": [
      "Philippe è un tornitore che vi accoglie nel suo laboratorio (senza appuntamento) e offre anche laboratori di tornitura (su prenotazione)."
    ],
    "fr": [
      "Tourneur sur bois, Philippe vous accueille (sans rendez-vous) dans son atelier, et vous propose également des ateliers de tournage (sur réservation)."
    ],
    "nl": [
      "Philippe is een houtdraaier die je welkom heet in zijn werkplaats (geen afspraak nodig), en hij biedt ook workshops houtdraaien aan (reserveren verplicht)."
    ],
    "es": [
      "Philippe es tornero y le recibe en su taller (sin cita previa). También ofrece talleres de torneado de madera (previa reserva)."
    ]
