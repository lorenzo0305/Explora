  "rdfs:comment": {
    "de": [
      "Val de Saône Centre, eine Gemeinschaft mit 15 Gemeinden, liegt am linken Ufer des Saône-Tals, an der Kreuzung von Dombes und Beaujolais, der Bresse und dem südlichen Burgund."
    ],
    "en": [
      "The Val de Saône Centre, a community of 15 municipalities, is located on the left bank of the Val de Saône, at the crossroads of Dombes and Beaujolais, Bresse and southern Burgundy."
    ],
    "it": [
      "Il Centro Val de Saône, una comunità di 15 comuni, si trova sulla riva sinistra della Val de Saône, all'incrocio tra le regioni di Dombes e Beaujolais, la Bresse e la Borgogna meridionale."
    ],
    "fr": [
      "Le Val de Saône Centre, communauté regroupant 15 communes, est situé sur la rive gauche du Val de Saône, au carrefour de la Dombes et du Beaujolais, de la Bresse et du sud de la Bourgogne."
    ],
    "nl": [
      "Val de Saône Centre, een gemeenschap van 15 gemeenten, ligt op de linkeroever van de Val de Saône, op het kruispunt van de regio's Dombes en Beaujolais, de Bresse en het zuiden van Bourgondië."
    ],
    "es": [
      "El Val de Saône Centre, comunidad de 15 municipios, está situado en la orilla izquierda del Val de Saône, en la encrucijada de las regiones de Dombes y Beaujolais, la Bresse y el sur de Borgoña."
    ]
  },
