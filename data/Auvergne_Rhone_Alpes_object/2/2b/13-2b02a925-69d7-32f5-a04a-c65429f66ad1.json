  "rdfs:comment": {
    "de": [
      "Verleih und Verkauf von Ausrüstung für Erwachsene und Kinder: Alpinski, Schuhe, Stöcke, Helme, Schneeschuhe, Snowboard, Snowblade, Kinderwagenschlitten. Verkauf von Schneezubehör: Handschuhe, Mütze, Brille, Socken und Prêt-à-porter-Berge."
    ],
    "en": [
      "Rental and sale of equipment for adults and children: downhill skis, boots, poles, helmets, snowshoes, snowboards, snowblades, and sledges. Sale of snow accessories: gloves, hats, goggles, socks, and mountain clothing."
    ],
    "it": [
      "Noleggio e vendita di attrezzature per adulti e bambini: sci alpino, scarponi, bastoncini, caschi, racchette da neve, snowboard, snowblade, slittini. Vendita di accessori da neve: guanti, berretti, occhiali, calze e abbigliamento da montagna."
    ],
    "fr": [
      "Location et vente de matériel pour adulte et enfant : ski alpin, chaussures, bâtons, casques, raquettes à neige, snowboard, snowblade, luge poussette. Vente d'accessoires neige : gant, bonnet, lunette, chaussette et prêt-à-porter montagne."
    ],
    "nl": [
      "Verhuur en verkoop van uitrusting voor volwassenen en kinderen: ski's, schoenen, stokken, helmen, sneeuwschoenen, snowboards, snowblades, toboggans en kinderwagens. Verkoop van sneeuwaccessoires: handschoenen, mutsen, brillen, sokken en confectiekleding voor in de bergen."
    ],
    "es": [
      "Alquiler y venta de material para adultos y niños: esquís alpinos, botas, bastones, cascos, raquetas de nieve, snowboards, palas de nieve, toboganes y cochecitos. Venta de accesorios para la nieve: guantes, gorros, gafas, calcetines y ropa de montaña lista para llevar."
    ]
  },
