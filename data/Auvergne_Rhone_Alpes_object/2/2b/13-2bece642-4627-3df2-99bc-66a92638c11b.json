  "rdfs:comment": {
    "de": [
      "Restaurant GIOIA, in dem jede Mahlzeit ein Erlebnis raffinierter Geschmäcker in einer warmen und entspannten Atmosphäre ist.\r\nMöglichkeit, vor Ort zu essen oder mitzunehmen!"
    ],
    "en": [
      "Restaurant GIOIA where every meal is an experience of refined flavors in a warm, relaxed atmosphere.\r\nEat in or take away!"
    ],
    "it": [
      "Ristorante GIOIA dove ogni pasto è un'esperienza di sapori raffinati in un'atmosfera calda e rilassata.\r\nSi può mangiare in casa o da asporto!"
    ],
    "fr": [
      "Restaurant GIOIA où chaque repas est une expérience de saveurs raffinées dans une ambiance chaleureuse et décontractée.\r\nPossibilité de manger sur place ou à emporter !"
    ],
    "es": [
      "Restaurante GIOIA, donde cada comida es una experiencia de sabores refinados en un ambiente cálido y relajado.\r\nSe puede comer en el restaurante o para llevar"
    ],
    "nl": [
      "Restaurant GIOIA waar elke maaltijd een ervaring is van verfijnde smaken in een warme, ontspannen sfeer.\r\nJe kunt hier eten of afhalen!"
