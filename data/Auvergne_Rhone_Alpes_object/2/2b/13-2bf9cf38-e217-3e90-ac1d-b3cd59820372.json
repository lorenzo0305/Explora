  "rdfs:comment": {
    "de": [
      "GTR Mountain (Bergbasis von GTR Performance, Spezialist für Motorsport) bietet Wanderungen und Entdeckungsreisen mit dem Schneemobil in einer wunderschönen und privilegierten Umgebung im Herzen des Belledonne-Massivs."
    ],
    "en": [
      "GTR Mountain (mountain base of GTR Performance, specialist in motor sports) offers snowmobile tours and discoveries in a magnificent, privileged setting in the heart of the Belledonne massif."
    ],
    "it": [
      "GTR Mountain (la base di montagna di GTR Performance, specialista in sport motoristici) offre escursioni e scoperte in motoslitta in un ambiente magnifico e privilegiato nel cuore del massiccio di Belledonne."
    ],
    "fr": [
      "GTR Mountain (base montagne de GTR Performance, spécialiste des sports mécaniques) propose des randonnées et découvertes en motoneige dans un cadre magnifique et privilégié, au coeur du massif de Belledonne."
    ],
    "es": [
      "GTR Mountain (la base de montaña de GTR Performance, especialista en deportes de motor) ofrece recorridos y descubrimientos en moto de nieve en un entorno magnífico y privilegiado, en el corazón del macizo de Belledonne."
    ],
    "nl": [
      "GTR Mountain (de bergbasis van GTR Performance, een specialist in motorsport) biedt sneeuwscootertochten en ontdekkingen in een prachtige, bevoorrechte omgeving in het hart van het Belledonne-massief."
    ]
  },
