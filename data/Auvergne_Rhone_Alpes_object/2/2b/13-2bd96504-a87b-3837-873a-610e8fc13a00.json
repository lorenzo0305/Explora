  "rdfs:comment": {
    "de": [
      "Besuchen Sie uns auf eigene Faust. Im historischen Zentrum von Souvigny öffnet dieser originelle und einladende Ort, der von einer Gruppe von Künstlern und Handwerkern belebt wird, seine Gärten, Ateliers und Ausstellungsräume für Sie."
    ],
    "en": [
      "Open house. In the historic centre of Souvigny, this original and welcoming place, animated by a group of artists and craftsmen, opens its gardens, workshops and showrooms to you."
    ],
    "it": [
      "Visita autoguidata. Nel centro storico di Souvigny, questo luogo originale e accogliente, gestito da un gruppo di artisti e artigiani, vi apre i suoi giardini, i laboratori e le sale espositive."
    ],
    "fr": [
      "Visite libre. Dans le centre historique de Souvigny, ce lieu original et accueillant animé par un groupe d'artistes et d'artisans, vous ouvre ses jardins, ateliers et salles d'exposition."
    ],
    "es": [
      "Visita autoguiada. En el centro histórico de Souvigny, este lugar original y acogedor, dirigido por un grupo de artistas y artesanos, le abre sus jardines, talleres y salas de exposición."
    ],
    "nl": [
      "Rondleiding met gids. In het historische centrum van Souvigny stelt deze originele en gastvrije plek, gerund door een groep kunstenaars en ambachtslieden, zijn tuinen, ateliers en expositieruimtes voor je open."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ateliers du Chapeau Rouge - Pôle de rencontres artistiques"
    ]
  },
