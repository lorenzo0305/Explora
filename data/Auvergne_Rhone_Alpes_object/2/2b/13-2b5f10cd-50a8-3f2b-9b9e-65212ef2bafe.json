  "rdfs:comment": {
    "de": [
      "50m vom Strand gegenüber dem Mont-Blanc mit schattiger Terrasse. Snack, Verkauf zum Mitnehmen: Paninis, Pommes frites, Salate, Crêpes... Eis nach italienischer Art. Themenabende im Sommer."
    ],
    "en": [
      "50m from the beach facing Mont Blanc, with shaded terrace. Snack bar, takeaway: paninis, French fries, salads, crêpes... Italian-style ice cream. Theme evenings in summer."
    ],
    "it": [
      "A 50 m dalla spiaggia di fronte al Monte Bianco, con terrazza ombreggiata. Snack bar, take away: panini, patatine, insalate, crêpes... Gelato all'italiana. Serate a tema in estate."
    ],
    "fr": [
      "A 50m de la plage face au Mont-Blanc avec terrasse ombragée. Snack, vente à emporter : paninis, frites, salades, crêpes... Glaces à l'italienne. Soirées à thème en été."
    ],
    "es": [
      "A 50 m de la playa, frente al Mont Blanc, con terraza a la sombra. Snack bar, comida para llevar: paninis, patatas fritas, ensaladas, crepes... Helados a la italiana. Veladas temáticas en verano."
    ],
    "nl": [
      "50m van het strand met uitzicht op de Mont Blanc, met schaduwrijk terras. Snackbar, afhaalmaaltijden: panini's, friet, salades, pannenkoeken... Ijs op Italiaanse wijze. Thema-avonden in de zomer."
    ]
  },
  "rdfs:label": {
