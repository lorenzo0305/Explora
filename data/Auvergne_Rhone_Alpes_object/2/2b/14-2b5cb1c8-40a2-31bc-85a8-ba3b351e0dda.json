  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a2097fe7-68da-30e0-a092-ed60efdcaae4",
      "dc:description": {
        "de": [
          "Aquaterra lädt Sie zu einem Workshop ein, bei dem Sie mit verschiedenen Werkzeugen arbeiten, um Schritt für Schritt ein Vogelhaus für Ihr Zuhause zu bauen. Die Vögel werden es Ihnen danken!"
        ],
        "en": [
          "Aquaterra invites you to take part in a workshop where you'll get to work with all kinds of tools to assemble, step by step, a birdhouse for your home. The birds will thank you!"
        ],
        "it": [
          "Aquaterra vi invita a partecipare a un workshop in cui potrete utilizzare tutti i tipi di strumenti per assemblare passo dopo passo una casetta per uccelli per la vostra casa. Gli uccelli vi ringrazieranno!"
        ],
        "fr": [
          "Aquaterra vous invite à participer à un atelier où vous manierez toute sorte d’outils pour assembler étape par étape, un nichoir à oiseau à installer chez vous. Les oiseaux vous remercient !"
        ],
        "es": [
          "Aquaterra te invita a participar en un taller en el que podrás utilizar todo tipo de herramientas para montar paso a paso una pajarera para tu propia casa. ¡Los pájaros te lo agradecerán!"
        ],
        "nl": [
          "Aquaterra nodigt je uit om deel te nemen aan een workshop waar je met allerlei gereedschap stap voor stap een vogelhuisje voor thuis in elkaar kunt zetten. De vogels zullen je dankbaar zijn!"
        ]
      },
