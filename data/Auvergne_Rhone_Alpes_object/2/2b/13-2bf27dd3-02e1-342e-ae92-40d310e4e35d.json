  "rdfs:comment": {
    "de": [
      "Es ist ein Ort, an dem Kinder von 0 bis 4 Jahren in Begleitung ihrer Eltern oder derjenigen, die sich normalerweise um sie kümmern und zu denen sie Vertrauen haben, zum Spielen kommen."
    ],
    "en": [
      "It's a place where children aged 0 to 4 come to play, accompanied by their parents or other caregivers with whom they feel comfortable."
    ],
    "it": [
      "È un luogo dove i bambini da 0 a 4 anni vengono a giocare accompagnati dai genitori o da chi si occupa abitualmente di loro e con cui si sentono sicuri."
    ],
    "fr": [
      "C'est un lieu d'accueil où les enfants de 0 à 4 ans viennent jouer accompagnés par leurs parents ou par ceux qui s'en occupent habituellement et avec lesquels ils se sentent en confiance."
    ],
    "nl": [
      "Het is een plek waar kinderen van 0 tot 4 jaar komen spelen, begeleid door hun ouders of andere verzorgers bij wie ze zich op hun gemak voelen."
    ],
    "es": [
      "Es un lugar donde los niños de 0 a 4 años acuden a jugar acompañados de sus padres o de quienes les cuidan habitualmente y con los que se sienten en confianza."
    ]
  },
