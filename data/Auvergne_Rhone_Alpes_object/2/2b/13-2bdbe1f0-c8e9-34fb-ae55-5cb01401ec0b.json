  "rdfs:comment": {
    "de": [
      "Zugang über den Pfad 1, leichter Aufstieg über die Vire de l'Ours 4, etwas steiler und luftiger über die Barme au Corbès 5, dann über die Dalle des Paresseux 6. Der Ausstieg erfolgt nach links 6b, um auf den Rückweg 12 und 13 zu gelangen."
    ],
    "en": [
      "Acces via 1, easy progress on the « Vire de l’Ours » 4, slightly steeper and more aerial crossing of the « Barme au Corbès » 5, then the « Dalle des Paresseux » 6. Exit to the left 6b to join the return path12 then 13."
    ],
    "it": [
      "Accesso tramite il sentiero 1, facile progressione sulla Vire de l'Ours 4, traversata un po' più ripida e aerea della Barme au Corbès 5, quindi della Dalle des Paresseux 6. Uscita a sinistra 6b per raggiungere il sentiero di ritorno 12 e poi 13."
    ],
    "fr": [
      "Accès par le sentier 1, progression facile sur la Vire de l’Ours 4, franchissement un peu plus raide et aérien de la Barme au Corbès 5, puis de la Dalle des Paresseux 6. La sortie s’effectue à gauche 6b pour rejoindre le sentier du retour 12 puis 13."
    ],
    "nl": [
      "Toegang via pad 1, gemakkelijke voortgang op de Vire de l'Ours 4, iets steilere en meer luchtige oversteek van de Barme au Corbès 5, vervolgens de Dalle des Paresseux 6. Afslag naar links 6b om de terugweg 12 en 13 te volgen."
    ],
    "es": [
      "Acceso por el sendero 1, progresión fácil por la Vire de l'Ours 4, travesía un poco más empinada y aérea de la Barme au Corbès 5, luego la Dalle des Paresseux 6. Salida a la izquierda 6b para incorporarse al sendero de vuelta 12 y luego 13."
    ]
  },
  "rdfs:label": {
    "en": [
      "Via Ferrata du Mont : La traversée des Paresseux"
    ],
    "fr": [
      "Via Ferrata du Mont : La traversée des Paresseux"
    ]
  },
