  "rdfs:comment": {
    "de": [
      "Traditionelle und familiäre Küche aus frischen und vorwiegend lokalen Produkten. Savoyische Spezialitäten in neuem Gewand, traditionelle Gerichte, hausgemachte Desserts. Einfache und gesellige Atmosphäre."
    ],
    "en": [
      "Almost a family restaurant-bar atmosphere with straightforward traditional cooking and regional specialities such as diots and crozets, tartiflette and croziflette... Great value for money, a simple and convivial atmosphere.\r\nWine by the glass."
    ],
    "it": [
      "Cucina tradizionale e familiare, basata su prodotti freschi ed essenzialmente locali. Specialità savoiarde rivisitate, piatti tradizionali, dolci fatti in casa. Atmosfera semplice e amichevole."
    ],
    "fr": [
      "Cuisine traditionnelle et familiale, à base de produits frais et essentiellement locaux. Spécialités savoyardes revisitées, Plats traditionnels, desserts maison. Ambiance simple et conviviale."
    ],
    "nl": [
      "Traditionele en familiale keuken, gebaseerd op verse en hoofdzakelijk lokale producten. Savoyaardse specialiteiten herleven, traditionele gerechten, huisgemaakte desserts. Eenvoudige en vriendelijke sfeer."
    ],
    "es": [
      "Cocina tradicional y familiar, basada en productos frescos y esencialmente locales. Especialidades saboyanas revisitadas, platos tradicionales, postres caseros. Ambiente sencillo y acogedor."
    ]
  },
