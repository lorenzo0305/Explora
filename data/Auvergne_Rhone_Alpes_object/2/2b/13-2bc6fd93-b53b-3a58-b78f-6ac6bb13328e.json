  "rdfs:comment": {
    "de": [
      "Die Strecke liegt in einer grünen Umgebung und ist mit zwei großen Parkplätzen sehr leicht zu erreichen. Der Start erfolgt an der Ampel und die Zeitmessung wird auf einem Fernsehbildschirm angezeigt, um den Wettbewerbsgeist zu erhalten."
    ],
    "en": [
      "The track is located in a green setting, very easy to access with two large car parks. Start at the traffic lights and timing displayed on TV screen to keep the spirit of competition."
    ],
    "it": [
      "La pista si trova in un contesto verde, molto facile da raggiungere con due ampi parcheggi. Partenza al semaforo e cronometraggio visualizzato su uno schermo televisivo per mantenere lo spirito della competizione."
    ],
    "fr": [
      "La piste se situe dans un cadre de verdure, très facile d'accès avec deux grands parkings. Départ aux feux tricolores et chronométrage affiché sur écran de télévision pour garder l'esprit de compétition."
    ],
    "es": [
      "La pista está situada en un entorno verde, de muy fácil acceso y con dos grandes aparcamientos. Salida en los semáforos y cronometraje mostrado en una pantalla de televisión para mantener el espíritu de la competición."
    ],
    "nl": [
      "De baan ligt in een groene omgeving, zeer goed bereikbaar met twee grote parkeerplaatsen. Start bij verkeerslichten en timing weergegeven op een tv-scherm om de competitiegeest te behouden."
    ]
  },
  "rdfs:label": {
