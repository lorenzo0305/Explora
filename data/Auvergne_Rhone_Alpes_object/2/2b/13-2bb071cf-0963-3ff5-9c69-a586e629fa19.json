  "rdfs:comment": {
    "de": [
      "\"Monsieur Choufleuri restera chez lui le ...\", eine Operette von J. Offenbach.\r\nMit Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, am Klavier begleitet von Clémence Chabrand. Regie und Bearbeitung: Guillaume Beaujolais."
    ],
    "en": [
      "\"Monsieur Choufleuri restera chez lui le ...\", an operetta by J. Offenbach.\r\nWith Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, accompanied on piano by Clémence Chabrand. Directed and adapted by Guillaume Beaujolais."
    ],
    "it": [
      "\"Monsieur Choufleuri restera chez lui le ...\", operetta di J. Offenbach.\r\nCon Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, accompagnati al pianoforte da Clémence Chabrand. Regia e adattamento di Guillaume Beaujolais."
    ],
    "fr": [
      "\"Monsieur Choufleuri restera chez lui le ...\", une opérette de J. Offenbach.\r\nAvec Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, accompagné au piano par Clémence Chabrand. Mise en scène et adaptation: Guillaume Beaujolais."
    ],
    "es": [
      "\"Monsieur Choufleuri restera chez lui le ...\", opereta de J. Offenbach.\r\nCon Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, acompañados al piano por Clémence Chabrand. Dirección y adaptación de Guillaume Beaujolais."
    ],
    "nl": [
      "\"Monsieur Choufleuri restera chez lui le ...\", een operette van J. Offenbach.\r\nMet Philippe Hermelier, Fleur Mino, Juan-Carlos Echeverry, Guillaume Beaujolais, op de piano begeleid door Clémence Chabrand. Regie en bewerking door Guillaume Beaujolais."
    ]
  },
