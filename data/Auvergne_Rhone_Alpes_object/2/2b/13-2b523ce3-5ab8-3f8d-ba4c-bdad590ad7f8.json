  "rdfs:comment": {
    "de": [
      "Familiengerichte und schöne Fleischstücke stehen auf der Speisekarte des neuen Restaurants \"à table\"! Cyrille und Laetitia empfangen Sie mittags und abends von Donnerstag bis Montag im historischen Zentrum von Thiers."
    ],
    "en": [
      "Family-style dishes and fine cuts of meat are on the menu at the new \"à table\" restaurant! Cyrille and Laetitia welcome you for lunch and dinner from Thursday to Monday in the historic center of Thiers."
    ],
    "it": [
      "Piatti familiari e tagli di carne pregiati sono nel menu del nuovo ristorante \"à table\"! Cyrille e Laetitia vi accolgono a pranzo e a cena da giovedì a lunedì nel centro storico di Thiers."
    ],
    "fr": [
      "Plats familiaux et belles pièces de viande sont à la carte du nouveau restaurant \"à table\" ! Cyrille et Laetitia vous accueillent midi et soir du jeudi au lundi dans le centre historique de Thiers."
    ],
    "es": [
      "Platos familiares y excelentes cortes de carne en el menú del nuevo restaurante \"à table\" Cyrille y Laetitia le reciben para almorzar y cenar de jueves a lunes en el centro histórico de Thiers."
    ],
    "nl": [
      "Familiegerechten en fijne stukken vlees staan op het menu in het nieuwe restaurant \"à table\"! Cyrille en Laetitia verwelkomen je voor lunch en diner van donderdag tot maandag in het historische centrum van Thiers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "À table !"
    ]
  },
