  "rdfs:comment": {
    "de": [
      "Praxis für Kurztherapien und persönliche Entwicklung.\r\nPraxis für Sophrologie - Gesichtsreflexzonenmassage\r\nGönnen Sie sich eine Zeit für sich: einen Moment der tiefen Entspannung, Regeneration, des Wohlbefindens und der Pflege."
    ],
    "en": [
      "Cabinet de thérapies brèves et développement personnel\r\nSophrology practice - Facial reflexology\r\nTreat yourself to a moment of deep relaxation, regeneration, well-being and pampering."
    ],
    "it": [
      "Gabinetto di terapie brevi e sviluppo personale\r\nPratica sofrologica - Riflessologia facciale\r\nConcedetevi un momento di profondo relax, rigenerazione, benessere e cura."
    ],
    "fr": [
      "Cabinet de thérapies brèves et développement personnel\r\nCabinet de Sophrologie - Réflexologie du visage\r\nOffrez-vous un temps pour vous : un moment de profonde relaxation, régénération, de mieux être et de soins."
    ],
    "nl": [
