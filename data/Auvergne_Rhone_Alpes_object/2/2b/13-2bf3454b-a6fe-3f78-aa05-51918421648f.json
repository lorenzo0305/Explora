  "rdfs:comment": {
    "de": [
      "Verleih von Muskel-Mountainbikes, Mountainbikes oder Mountainbikes mit Elektrounterstützung und Rennrädern.\r\nHelm und Reparaturset werden gestellt, Karte auf Anfrage.\r\nWeitere Angebote: Verkauf und Reparatur von Mountainbikes und VTCs, Rennrädern, Motorrollern, Motorrädern und Quads."
    ],
    "en": [
      "Hire classic mountain bikes, electric hybrid or mountain bikes, and road bikes.\r\nHelmet and repair kit provided, and map on request.\r\nOther services offered:  mountain, hybrid and road bikes, scooters, motorcycles and quads for sale and repair."
    ],
    "it": [
      "Noleggio di muscle bike, mountain bike o bici a pedalata assistita e bici da strada.\r\nCasco e kit di riparazione forniti e mappa su richiesta.\r\nAltri servizi includono: vendita e riparazione di mountain bike, bici da strada, scooter, moto e quad."
    ],
    "fr": [
      "Location de VTT musculaires, de VTC ou VTT à assistance électrique, et de vélos de route. \r\nCasque et kit de réparation fournis, et carte sur demande.\r\nAutres services proposés : vente et réparation de VTT et VTC, vélos de route, scooters, motos et quads."
    ],
    "nl": [
      "Verhuur van musclebikes, mountainbikes of elektrisch ondersteunde fietsen, en racefietsen.\r\nHelm en reparatieset aanwezig, en kaart op aanvraag.\r\nAndere diensten: verkoop en reparatie van mountainbikes, racefietsen, scooters, motoren en quads."
    ],
    "es": [
      "Alquiler de muscle bikes, bicicletas de montaña o asistidas eléctricamente, y bicicletas de carretera.\r\nSe suministra casco y kit de reparación, y mapa previa petición.\r\nOtros servicios: venta y reparación de bicicletas de montaña, de carretera, scooters, motos y quads."
    ]
  },
