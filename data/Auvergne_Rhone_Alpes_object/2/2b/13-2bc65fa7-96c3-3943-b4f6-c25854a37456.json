  "rdfs:comment": {
    "de": [
      "Behördengänge im Zusammenhang mit der Steuersituation, Gesundheit, Familie, Rente oder Beschäftigung... Die Servicebereiche von France Services bieten den Nutzern Zugang zu einem Strauß von Dienstleistungen für den Alltag."
    ],
    "en": [
      "Administrative procedures relating to tax, health, family, retirement or employment... The France services areas give users access to a range of day-to-day services."
    ],
    "it": [
      "Procedure amministrative relative a fisco, salute, famiglia, pensione o lavoro? Le aree dei Servizi Francia consentono agli utenti di accedere a una serie di servizi quotidiani."
    ],
    "fr": [
      "Démarches administratives liées à la situation fiscale, la santé, la famille, la retraite ou l’emploi… Les espaces France services permettent aux usagers d’accéder à un bouquet de services du quotidien."
    ],
    "es": [
      "¿Trámites administrativos relacionados con los impuestos, la salud, la familia, la jubilación o el empleo? Los espacios France Services permiten a los usuarios acceder a una serie de servicios cotidianos."
    ],
    "nl": [
      "Administratieve procedures met betrekking tot belastingen, gezondheid, gezin, pensioen of werk... De centra van France Services geven gebruikers toegang tot een reeks dagelijkse diensten."
    ]
  },
