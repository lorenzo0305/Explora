  "rdfs:comment": {
    "de": [
      "Familienbetrieb vom Vater zum Sohn aus Liebe zu einem bestimmten Terroir. Nach zahlreichen Praktika in Biologie und ?nologie lässt sich Jean-Claude 1989 mit seinem Vater André auf dem Familienbetrieb nieder."
    ],
    "en": [
      "A family-run estate where the love for the land has been passed down through the generations.\r\nAfter gaining extensive work experience in biology and oenology, Jean-Claude joined his father André on the family estate in 1989."
    ],
    "it": [
      "Un'azienda familiare tramandata di padre in figlio per amore di un terroir. Dopo numerosi corsi di formazione in biologia e tecnologia, Jean-Claude ha avviato l'azienda di famiglia con il padre André nel 1989."
    ],
    "fr": [
      "Exploitation familiale de père en fils pour l’amour d’un terroir. Après de nombreux stages en biologie et œnologie, Jean-Claude s’installe avec son père André en 1989, dans l’exploitation familiale."
    ],
    "es": [
      "Una empresa familiar transmitida de padres a hijos por amor al terruño. Tras numerosos cursos de formación en biología y nología, Jean-Claude creó la empresa familiar con su padre André en 1989."
    ],
    "nl": [
      "Een familiebedrijf dat van vader op zoon wordt doorgegeven uit liefde voor een terroir. Na talrijke opleidingen in biologie en ?nologie richtte Jean-Claude in 1989 samen met zijn vader André het familiebedrijf op."
    ]
  },
