  "rdfs:comment": {
    "de": [
      "Restaurant Snack & Brunch: süße und salzige Leckereien vor Ort und zum Mitnehmen\r\nVerwöhnen Sie sich mit Veloutés, Wraps, Crumble Tartelettes, Brook?in u.v.m\r\nFrische, saisonale und lokale Produkte stehen im Vordergrund."
    ],
    "en": [
      "Snack & Brunch Restaurant: savoury and sweet treats to eat in or take away.\r\nTreat yourself to soups, wraps, crumble tarts, brook'in, etc.\r\nFresh, seasonal and local produce takes centre stage."
    ],
    "it": [
      "Ristorante Snack e Brunch: delizie dolci e salate da mangiare o da portare via\r\nConcedetevi vellutate, involucri, crostate, crumble, brook?in e molto altro ancora!\r\nPuntiamo su prodotti freschi, stagionali e locali."
    ],
    "fr": [
      "Restaurant Snack & Brunch : gourmandises salées & sucrées sur place et à emporter\r\nFaites-vous plaisir avec des veloutés, wraps, tartelettes crumbles, brook’in et bien d'autres\r\nProduits frais, de saison et locaux sont mis à l’honneur."
    ],
    "es": [
      "Restaurante Snack & Brunch: delicias dulces y saladas para comer en casa o para llevar\r\nDeléitese con veloutés, wraps, tartas, crumbles, brook?in y mucho más\r\nNos centramos en los productos frescos, de temporada y locales."
    ],
    "nl": [
      "Restaurant Snack & Brunch: zoete en hartige lekkernijen om te eten of mee te nemen\r\nVerwen jezelf met veloutés, wraps, taartjes, crumbles, brookin en nog veel meer!\r\nWe richten ons op verse, seizoensgebonden en lokale producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Just'In Time"
    ]
  },
