  "rdfs:comment": {
    "de": [
      "Moderner Neubau im Grünen fünf Minuten vom Zentrum. Qualitätsvolle, gepflegte Küche mit örtlichen Erzeugnissen. Themenabende; in der Saison Animation."
    ],
    "en": [
      "5 minutes walk from the city centre, in a warm & green environment, in a new-build with a contemporary feel."
    ],
    "it": [
      "A 5 minuti a piedi dal centro città, in un ambiente caldo e verdeggiante, potrete gustare aperitivi, tapas, pizze, insalate, gelati e hamburger sul posto o da asporto."
    ],
    "fr": [
      "A 5 min à pied du centre ville, dans un cadre chaleureux et verdoyant,  il vous sera proposé : apéro, tapas, pizzas, salades, glaces, burgers sur place ou à emporter."
    ],
    "nl": [
      "Op 5 minuten lopen van het centrum, in een gastvrije en natuurlijke omgeving. Nieuw restaurant in eigentijdse kleuren en materialen. \r\nOntvangst van kwaliteit en verzorgde traditionele keuken met specialiteiten uit de streek. Thema-avonden en entertainment in het hoogseizoen."
    ],
    "es": [
      "A 5 minutos a pie del centro de la ciudad, en un entorno cálido y frondoso, podrá disfrutar de aperitivos, tapas, pizzas, ensaladas, helados y hamburguesas en el mismo local o para llevar."
    ]
  },
