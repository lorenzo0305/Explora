  "rdfs:comment": {
    "de": [
      "Anbau von Weinreben auf Terrassen, den sogenannten Palhàs.\r\nDie Weinberge bestehen aus den Rebsorten Pinot Noir, Syrah, Gamay und Chardonnay, Pinot Gris und Altesse für die Herstellung von Rot- und Weißwein."
    ],
    "en": [
      "Terraced vineyards known as Palhàs.\r\nThe vineyards are planted with pinot noir, syrah, gamay and chardonnay, pinot gris and altesse grapes, for the production of red and white wines."
    ],
    "it": [
      "Vigneti terrazzati noti come Palhàs.\r\nI vigneti sono coltivati con varietà di Pinot Nero, Syrah, Gamay, Chardonnay, Pinot Grigio e Altesse, per la produzione di vini rossi e bianchi."
    ],
    "fr": [
      "Culture de vignes en terrasses, appelées Palhàs. \r\nLe vignoble est composé de cépages pinot noir, syrah, gamay et chardonnay, pinot gris, altesse,  pour la production de vin rouge et blanc."
    ],
    "es": [
      "Viñedos en terrazas conocidos como Palhàs.\r\nLos viñedos están plantados con las variedades Pinot Noir, Syrah, Gamay, Chardonnay, Pinot Gris y Altesse, para la producción de vinos tintos y blancos."
    ],
    "nl": [
      "Terrasvormige wijngaarden die bekend staan als Palhàs.\r\nDe wijngaarden zijn beplant met Pinot Noir, Syrah, Gamay, Chardonnay, Pinot Gris en Altesse-variëteiten, voor de productie van rode en witte wijnen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Domaine Le Chlo d'Auzit"
    ],
    "fr": [
      "Domaine Le Chlo d'Auzit"
    ]
  },
