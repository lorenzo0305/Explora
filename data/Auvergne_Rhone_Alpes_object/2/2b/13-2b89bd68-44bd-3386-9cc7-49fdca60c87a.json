  "rdfs:comment": {
    "de": [
      "Der Chaise, der in seinem savoyischen Teil ein Flachlandfluss ist, bietet eine große Vielfalt an Lebensräumen und Angelplätzen, wobei sich Löcher und fließende Bereiche abwechseln."
    ],
    "en": [
      "The Chaise is a flat river in its Savoyard part, offering a great diversity of habitats and fishing spots, alternating between holes and running areas."
    ],
    "it": [
      "Fiume piatto nella sua parte savoiarda, la Chaise offre una grande diversità di habitat e di luoghi di pesca, alternando buche e zone di scorrimento."
    ],
    "fr": [
      "Rivière de plaine dans sa partie savoyarde, la Chaise offre une grande diversité d'habitats et de postes de pêche, en alternant entre trous et zones courantes."
    ],
    "es": [
      "Río llano en su parte saboyana, la Chaise ofrece una gran diversidad de hábitats y lugares de pesca, alternando hoyos y zonas de carrera."
    ],
    "nl": [
      "De Chaise, een vlakke rivier in het Savoyaardse deel, biedt een grote verscheidenheid aan habitats en visstekken, afwisselend met kuilen en loopgebieden."
    ]
  },
  "rdfs:label": {
