  "rdfs:comment": {
    "de": [
      "Genießen Sie die schönen sonnigen Tage bei einem Mittag- oder Abendessen am Ufer der Saône und warum nicht das Essen mit einer Partie Minigolf für die ganze Familie verlängern? Zahlreiche Animationen werden Ihnen angeboten!"
    ],
    "en": [
      "Why don't you come for a meal or refreshments on the banks of the Saône river? Catering available : bar, snacks, barbecue grill, drinks, ice-creams, games, birthday celebrations.  Extend your day playing mini-golf !"
    ],
    "it": [
      "Approfittate delle giornate di sole per un pranzo o una cena sulle rive della Saona, e perché non prolungare il pasto con una partita di Minigolf per tutta la famiglia? Il divertimento è assicurato!"
    ],
    "fr": [
      "Venez profiter des belles journées ensoleillées pour un déjeuner ou un dîner en bord de Saône et pourquoi pas prolonger le repas par une partie de Minigolf en famille ! De nombreuses animations vous sont proposées !"
    ],
    "nl": [
      "Kom en geniet van de zonnige dagen voor een lunch of diner aan de oevers van de Saône, en waarom breidt u de maaltijd niet uit met een partijtje Minigolf voor het hele gezin! Er is genoeg te beleven!"
    ],
    "es": [
      "Aproveche los días soleados para comer o cenar a orillas del Saona y prolongue la comida con una partida de minigolf para toda la familia La diversión está asegurada"
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant Bar Le Golf"
    ],
