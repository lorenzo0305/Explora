  "rdfs:comment": {
    "de": [
      "Inmitten einer 10 Hektar großen Grünanlage bietet der Bois des Lutins eine Reihe von Empfangslösungen für große Gruppen (100 bis 1000 Personen). Unsere Ambitionen? Ein unvergessliches Erlebnis für Ihre Mitarbeiter zu schaffen!"
    ],
    "en": [
      "In the heart of a 10-hectare green setting, Le Bois des Lutins offers a range of solutions for large-scale events (100 to 1,000 people). Our ambition? To create a memorable experience for your employees!"
    ],
    "it": [
      "Nel cuore di un ambiente verde di 10 ettari, il Bois des Lutins offre una gamma di soluzioni ricettive per grandi gruppi (da 100 a 1000 persone). La nostra ambizione? Creare un'esperienza memorabile per i vostri collaboratori!"
    ],
    "fr": [
      "Au cœur d’un écrin de verdure de 10 hectares, le Bois des Lutins offre un ensemble de solutions réceptives pour les grands effectifs ( 100 à 1000 personnes). Notre ambition ? Créer une expérience mémorable pour vos collaborateurs !"
    ],
    "nl": [
      "In het hart van een groene omgeving van 10 hectare biedt het Bois des Lutins een waaier aan receptieve oplossingen voor grote groepen (100 tot 1000 personen). Onze ambitie? Een onvergetelijke ervaring creëren voor uw personeel!"
    ],
    "es": [
      "En el corazón de un entorno verde de 10 hectáreas, el Bois des Lutins ofrece un abanico de soluciones receptivas para grandes grupos (de 100 a 1000 personas). ¿Nuestra ambición? Crear una experiencia memorable para sus colaboradores"
    ]
  },
