  "rdfs:comment": {
    "de": [
      "Der Rundgang \"sur les pas des Maubourg\" wurde von der Vereinigung \"Les Amis du Domaine de Maubourg\" entworfen und die Schilder von der Stadtverwaltung von Saint-Maurice-de-Lignon aufgestellt..."
    ],
    "en": [
      "The \"In the footsteps of the Maubourgs\" trail was designed by the association Les Amis du Domaine de Maubourg, and the signs installed by the Mairie de Saint-Maurice-de-Lignon..."
    ],
    "it": [
      "Il percorso \"Sulle orme dei Maubourg\" è stato progettato dall'associazione Les Amis du Domaine de Maubourg e la segnaletica è stata installata dal Comune di Saint-Maurice-de-Lignon..."
    ],
    "fr": [
      "Le parcours \"sur les pas des Maubourg\" a été conçu par l'association les Amis du Domaine de Maubourg et les panneaux installés par la Mairie de Saint-Maurice-de-Lignon..."
    ],
    "es": [
      "El sendero \"Tras las huellas de los Maubourgs\" fue diseñado por la asociación Les Amis du Domaine de Maubourg y la señalización instalada por el Ayuntamiento de Saint-Maurice-de-Lignon..."
    ],
    "nl": [
      "De route \"In de voetsporen van de Maubourgs\" is ontworpen door de vereniging Les Amis du Domaine de Maubourg en de borden zijn geplaatst door het stadhuis van Saint-Maurice-de-Lignon..."
    ]
  },
  "rdfs:label": {
