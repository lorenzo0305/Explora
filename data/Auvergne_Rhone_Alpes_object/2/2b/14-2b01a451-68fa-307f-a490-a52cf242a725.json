  "rdfs:comment": {
    "de": [
      "Als echter Tierpark mit über 85 verschiedenen Tierarten, darunter Wallabys, Lamas, Rehe und Pfauen, macht er Kinder glücklich, die die zahlreichen Spiele, die ihnen zur Verfügung stehen, voll ausnutzen können."
    ],
    "en": [
      "A real animal park with more than 85 different species, including wallabies, llamas, deer and peacocks, it is a delight for children who can take full advantage of the many games available to them."
    ],
    "it": [
      "Un vero e proprio parco di animali con oltre 85 specie diverse, tra cui wallaby, lama, cervi e pavoni, è una delizia per i bambini che possono approfittare dei numerosi giochi a loro disposizione."
    ],
    "fr": [
      "Véritable parc animalier avec plus de 85 espèces différentes, parmi lesquelles des wallabies, des lamas, des chevreuils, des paons, il fait le bonheur des enfants qui peuvent profiter pleinement des nombreux jeux mis à leur disposition."
    ],
    "es": [
      "Un auténtico parque de animales con más de 85 especies diferentes, entre ellas wallabies, llamas, ciervos y pavos reales, es una delicia para los niños, que pueden aprovechar al máximo los numerosos juegos de que disponen."
    ],
    "nl": [
      "Een echt dierenpark met meer dan 85 verschillende diersoorten, waaronder wallaby's, lama's, herten en pauwen, is een genot voor kinderen die volop kunnen profiteren van de vele spelletjes."
    ]
  },
