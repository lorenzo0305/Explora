  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Hotel*** Spa & Restaurant Ô Pervenches in Chambéry. Service: Restaurant, Spa, Kostenlose Parkplätze, Ladestationen für Elektrofahrzeuge.  Kostenloses WiFi, Familienzimmer. Perfekt für Urlaub oder Geschäftsreisen."
    ],
    "en": [
      "A charming little hotel in the heart of the Charmettes valley...\r\nIn peace and quiet, and a natural environment, come and recharge your batteries at the Ô Pervenches hotel. 300 m from Jean-Jacques Rousseau’s house and only 1 km from Chambéry town centre."
    ],
    "it": [
      "Scoprite l'Hotel*** Spa & Restaurant Ô Pervenches a Chambéry. Servizi: Ristorante, Spa, Parcheggio gratuito, Punto di ricarica per veicoli elettrici.  WiFi gratuito, Camere familiari. Perfetto per vacanze o viaggi d'affari."
    ],
    "fr": [
      "Découvrez l'Hôtel*** Spa & Restaurant Ô Pervenches à Chambéry. Services : Restaurant, Spa, Parking Gratuit, Bornes de recharge pour véhicule électrique.  WiFi gratuit, Chambres familiales. Parfait pour les vacances ou les voyages d'affaires."
    ],
    "nl": [
      "Ontdek Hotel*** Spa & Restaurant Ô Pervenches in Chambéry. Diensten: Restaurant, Spa, Gratis parkeren, Oplaadpunt voor elektrische voertuigen.  Gratis WiFi, Familiekamers. Perfect voor vakanties of zakenreizen."
    ],
    "es": [
      "Descubra el Hotel*** Spa & Restaurant Ô Pervenches en Chambéry. Servicios: Restaurante, Spa, Aparcamiento gratuito, Punto de recarga de vehículos eléctricos.  WiFi gratuito, Habitaciones familiares. Ideal para vacaciones o viajes de negocios."
    ]
  },
