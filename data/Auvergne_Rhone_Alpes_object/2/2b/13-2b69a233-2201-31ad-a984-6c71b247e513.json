  "rdfs:comment": {
    "de": [
      "Produktion von Getreide aus biologischem Anbau: Landweizen, Dinkel, Roggen. Das Getreide wird auf dem Hof gemahlen und in der Backstube zu Brot, Brioches, Wiener Brot, Keksen, Tartelettes und Nudeln verarbeitet."
    ],
    "en": [
      "Organic cereal production: local wheat, spelt and rye. Cereals are milled on the farm and transformed in the bakery into bread, brioches, Viennese bread, cookies, tarts and pasta."
    ],
    "it": [
      "Produzione biologica di cereali: grano, farro e segale locali. I cereali vengono macinati in azienda e trasformati nel forno in pane, brioches, pane viennese, biscotti, crostate e pasta."
    ],
    "fr": [
      "Production de céréales en agriculture biologique : blés de pays, grand épeautre, seigle. Les céréales sont moulues à la ferme et transformées au fournil en pains, brioches, pain viennois, biscuits, tartelettes et pâtes."
    ],
    "es": [
      "Producción ecológica de cereales: trigo, espelta y centeno locales. Los cereales se muelen en la granja y se transforman en la panadería en pan, brioches, pan vienés, galletas, tartas y pasta."
    ],
    "nl": [
      "Biologische graanproductie: lokale tarwe, spelt en rogge. De granen worden op de boerderij gemalen en in de bakkerij verwerkt tot brood, brioches, Weens brood, koekjes, taarten en pasta."
    ]
  },
  "rdfs:label": {
