  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine ungewöhnliche Fahrt auf der Eisenbahnstrecke in einer unberührten Natur!  Klettern Sie an Bord eines Velorails von Ambert und entdecken Sie das Tal der Dore. 3 mögliche Strecken, 8 km, 14 und 18 km hin und zurück."
    ],
    "en": [
      "Discover our tours with Rail biking. The effort is moderate and can be shared by the whole family. Special offer with the touristic train. With reservation."
    ],
    "it": [
      "Partite per un viaggio insolito lungo la linea ferroviaria attraverso una campagna incontaminata!  Salite a bordo di un velorail Ambert per scoprire la valle del Dore. 3 percorsi possibili, 8 km, 14 e 18 km andata e ritorno."
    ],
    "fr": [
      "Embarquez pour une balade insolite sur la voie ferrée dans une nature préservée !  Grimpez à bord d'un vélorail d’Ambert pour découvrir la vallée de la Dore. 3 parcours possibles, 8 km, 14 et 18 kms aller-retour."
    ],
    "nl": [
      "Maak een bijzondere rit langs de spoorlijn door het ongerepte platteland!  Stap aan boord van een Ambert velorail en ontdek de vallei van de Dore. 3 mogelijke routes, 8 km, 14 en 18 km heen en terug."
    ],
    "es": [
      "Embárquese en un viaje insólito por la vía férrea a través de paisajes vírgenes  Suba a bordo de un velocarril Ambert para descubrir el valle del Dore. 3 recorridos posibles, 8 km, 14 y 18 km ida y vuelta."
    ]
  },
