      "dc:description": {
        "de": [
          "Herbstausstellung, organisiert vom Verein Les Amis d?Hom'Arts\n\nFreier Ausdruck: Fotos, Malerei, Skulpturen, Gedichte ...\n\nFreier Eintritt."
        ],
        "en": [
          "Autumn exhibition organized by the association Les Amis d?Hom'Arts\n\nFree expression: photos, paintings, sculptures, poetry...\n\nFree admission."
        ],
        "it": [
          "Mostra autunnale organizzata dall'associazione Les Amis d'Hom'Arts\n\nLibera espressione: foto, dipinti, sculture, poesie ...\n\nIngresso libero."
        ],
        "fr": [
          "Exposition d'automne organisée par l'association Les Amis d’Hom'Arts\n\nExpression libre : photos, peinture, sculptures, poésies ...\n\nEntrée libre."
        ],
        "nl": [
          "Herfsttentoonstelling georganiseerd door de vereniging Les Amis d'Hom'Arts\n\nVrije expressie: foto's, schilderijen, beeldhouwwerken, poëzie ...\n\nGratis toegang."
        ],
        "es": [
          "Exposición de otoño organizada por la asociación Les Amis d'Hom'Arts\n\nExpresión libre: fotos, pinturas, esculturas, poesía ...\n\nEntrada gratuita."
        ]
      },
