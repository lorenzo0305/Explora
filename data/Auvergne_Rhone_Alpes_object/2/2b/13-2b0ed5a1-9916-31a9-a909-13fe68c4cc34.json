  "rdfs:comment": {
    "de": [
      "Multiplex mit 9 Sälen, ausgestattet mit der neuesten Technologie, Laserprojektion, 4K, HFR und einem 4D- Emotionssaal (während der Projektionen Luft- und Wasserstrahlen, Sesselvibrationen, Duftverbreitung, ...).\r\nKostenlose Parkplätze."
    ],
    "en": [
      "Multiplex of 9 theatres equipped with the latest technology, laser projection, 4K, HFR and a 4D- Emotion room (during the projections, air and water jets, chair vibrations, diffusion of smells,...)\r\nFree parking."
    ],
    "it": [
      "Multisala con 9 sale, dotate delle più moderne tecnologie, proiezione laser, 4K, HFR e un cinema 4D- Emotion (durante le proiezioni, getti d'aria e d'acqua, vibrazioni dei sedili, diffusione di profumi, ecc.)\r\nParcheggio gratuito."
    ],
    "fr": [
      "Multiplexe de 9 salles de cinémas, équipé des toutes dernières technologies, projection laser, 4K, HFR et une salle 4D- Emotion (durant les projections, des jets d’air et des jets d’eau, vibrations de fauteuil, diffusion d’odeurs, etc.)\r\nParking Gratuit."
    ],
    "nl": [
      "Multiplex met 9 bioscopen, uitgerust met de nieuwste technologie, laserprojectie, 4K, HFR en een 4D- Emotion bioscoop (tijdens vertoningen lucht- en waterstralen, trillingen van stoelen, geurverspreiding, enz.)\r\nGratis parkeren."
    ],
    "es": [
      "Multicines con 9 salas, equipadas con la última tecnología, proyección láser, 4K, HFR y un cine 4D- Emotion (durante las proyecciones, chorros de aire y agua, vibraciones en los asientos, difusión de aromas, etc.)\r\nAparcamiento gratuito."
    ]
  },
