  "rdfs:comment": {
    "de": [
      "Die Gaule du Royans ist ein zugelassener Verein für Fischerei und den Schutz der aquatischen Umwelt. Die Mitgliedschaft im Verein gibt das Recht, in den vom Verein verwalteten Losen nach einer speziellen Regelung zu fischen."
    ],
    "en": [
      "La Gaule du Royans is an approved association for fishing and the protection of aquatic environments. Membership of the association entitles you to fish in the lots managed by the association according to specific regulations."
    ],
    "it": [
      "La Gaule du Royans è un'associazione autorizzata per la pesca e la protezione degli ambienti acquatici. L'adesione all'associazione dà diritto a pescare nei lotti gestiti dall'associazione secondo un regolamento specifico."
    ],
    "fr": [
      "La Gaule du Royans est une association agréée de pêche et de protection des milieux aquatiques. L'adhésion à l'association donne le droit de pêcher dans les lots gérées par l'association selon une réglementation spécifique."
    ],
    "nl": [
      "La Gaule du Royans is een erkende vereniging voor de visserij en de bescherming van het aquatische milieu. Lidmaatschap van de vereniging geeft je het recht om te vissen in de percelen die door de vereniging worden beheerd volgens een specifiek reglement."
    ],
    "es": [
      "La Gaule du Royans es una asociación autorizada para la pesca y la protección de los medios acuáticos. La pertenencia a la asociación da derecho a pescar en los lotes gestionados por la asociación de acuerdo con una normativa específica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "AAPPMA La Gaule du Royans"
    ]
  },
