  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3a084261-744b-3b78-a3fd-dd0782e9b06e",
      "dc:description": {
        "de": [
          "Donnerstag, 26. Februar\n--------------------------------------\nAktivität Karnevalsumzug + Schminkstand im Forum, angeboten vom CCAS\nAuf dem Minigolfplatz, von 15:00 bis 17:00 Uhr\nKostenlos und offen für alle\n\nSie können sich beim Service Animation im Office de Tourisme de Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Thursday, February 26\n--------------------------------------\nCarnival Parade + Make-up Stand at the Forum proposed by the CCAS\nAt the mini golf course, from 3pm to 5pm\nFree and open to all\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Giovedì 26 febbraio\n--------------------------------------\nSfilata di Carnevale + stand di truccabimbi al Forum organizzato dalla CCAS\nPresso il campo da minigolf, dalle 15.00 alle 17.00\nGratuito e aperto a tutti\n\nÈ possibile iscriversi presso il Servizio Eventi dell'Ufficio del Turismo di Merlimont: 70 Avenue du Centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Jeudi 26 Février \n--------------------------------------\nActivité Défilé de Carnaval + Stand de Maquillage au Forum proposée par le CCAS\nAu mini golf, de 15h à 17h\nGratuit et ouvert à tous\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "es": [
          "Jueves 26 de febrero\n--------------------------------------\nDesfile de Carnaval + Stand de maquillaje en el Foro organizado por la CCAS\nEn el campo de minigolf, de 15.00 a 17.00 horas\nGratuito y abierto a todos\n\nPuede inscribirse en el Departamento de Eventos de la Oficina de Turismo de Merlimont: 70 Avenue du Centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nFOTOGRAFÍA: Freepik.com"
        ],
        "nl": [
          "Donderdag 26 februari\n--------------------------------------\nCarnavalsoptocht + schminkstand op het Forum georganiseerd door CCAS\nBij de minigolfbaan, van 15.00 tot 17.00 uur\nGratis en open voor iedereen\n\nU kunt zich inschrijven bij de Dienst Evenementen in de Dienst voor Toerisme van Merlimont: 70 Avenue du Centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ]
      },
