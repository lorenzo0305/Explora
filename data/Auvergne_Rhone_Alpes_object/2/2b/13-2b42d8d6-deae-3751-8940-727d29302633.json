  "rdfs:comment": {
    "de": [
      "Trinken, essen und spielen Sie mit Ihren Freunden, Ihrer Familie oder Fremden an einem warmen und gemütlichen Ort - das können Sie bei Pile ou Face!"
    ],
    "en": [
      "Drink, eat and play with friends, family or strangers in a warm and friendly atmosphere - that's Pile ou Face!"
    ],
    "it": [
      "Bere, mangiare e giocare con amici, familiari o sconosciuti in un'atmosfera calda e amichevole: questo è Pile ou Face!"
    ],
    "fr": [
      "Boire, manger et jouer avec ses ami•e•s, en famille, ou entre inconnu•e•s dans un lieu chaleureux et convivial, c'est chez Pile ou Face !"
    ],
    "nl": [
      "Drinken, eten en spelen met vrienden, familie of vreemden in een warme en gezellige sfeer - dat is Pile ou Face!"
    ],
