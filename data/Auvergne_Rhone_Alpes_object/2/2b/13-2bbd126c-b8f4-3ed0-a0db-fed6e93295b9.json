  "rdfs:comment": {
    "de": [
      "Hören Sie auf Burger zu futtern, essen Sie Hamburger! Zum hier essen oder zum Mitnehmen, Big Fernand bietet Ihnen an ein neues Kapitel anzufangen und einen wirklichen Hamburger nach französischer Art mit hausgemachten oder von typisch französischen Handwerkern zubereiteten Bestandteilen zu kosten."
    ],
    "en": [
      "Don't eat Burgers, eat Hamburgers! Whether you're eating in or taking away, Big Fernand suggests you forget ordinary burgers and enjoy a real Hamburger à la français instead, made with homemade and local froggy produce."
    ],
    "it": [
      "Smetti di ingozzarti di Hamburger, mangia degli Hamburgés! Sul posto o a portar via, Big Fernand ti propone di voltare la pagina dell'hamburger per gustare un vero \"Hamburgé\" alla francese composto di ingredienti fatti in casa o da artigiani francesi."
    ],
    "fr": [
      "Arrêtez de bouffer des Burgers, mangez des Hamburgés ! Sur place ou à emporter, Big Fernand vous propose de tourner la page du burger pour déguster un véritable \"Hamburgé\" à la française composé d'ingrédients faits \"maison\" ou d'artisans franchouillards."
    ],
    "es": [
      "¡Deja de engullir hamburguesas corrientes y molientes y ven a probar una hamburguesa de verdad! En Big Fernand preparamos auténticas \"hamburguesas\" al estilo francés hechas con ingredientes caseros o de artesanos de la tierra."
    ],
    "nl": [
      "Stop met het eten van Burgers, eet Hamburgers! Ter plaatse of om mee te nemen, Big Fernand biedt u de mogelijkheid om de bladzijde van de hamburger om te slaan en te genieten van een echte \"Hamburgé\" in Franse stijl, gemaakt met \"zelfgemaakte\" ingrediënten of van Franse ambachtslieden."
    ]
  },
