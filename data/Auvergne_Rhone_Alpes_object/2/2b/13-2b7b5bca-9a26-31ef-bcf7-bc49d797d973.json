  "rdfs:comment": {
    "de": [
      "Um sich zu unterhalten oder weiterzubilden, erwarten Sie 3000 Bücher für Groß und Klein in den Regalen: Krimis, Romane, Comics, Manga, ...\r\nJede Woche werden Ihnen von der Bibliothekarin Evelyne und dem ehrenamtlichen Team neue Bücher vorgeschlagen."
    ],
    "en": [
      "To entertain or educate you, 3,000 books for young and old await you on the shelves: detective stories, novels, comics, manga, etc.\r\nEvery week, Evelyne, the librarian, and the team of volunteers bring you new titles."
    ],
    "it": [
      "Per divertirvi o istruirvi, 3000 libri per grandi e piccini vi aspettano sugli scaffali: gialli, romanzi, fumetti, manga, ecc.\r\nOgni settimana Evelyne, la bibliotecaria, e il team di volontari vi portano nuovi libri."
    ],
    "fr": [
      "Pour vous divertir ou vous cultiver, 3000 livres pour petits et grands vous attendent sur les étagères : policiers, romans, BD, manga, ...\r\nChaque semaine, des nouveautés vous sont proposées par Evelyne, bibliothécaire, et l'équipe de bénévoles."
    ],
    "es": [
      "Para entretenerte o instruirte, en las estanterías te esperan 3.000 libros para grandes y pequeños: novelas policíacas, novelas, cómics, manga, etc.\r\nCada semana, Evelyne, la bibliotecaria, y el equipo de voluntarios te traen libros nuevos."
    ],
    "nl": [
      "Om je te vermaken of te onderwijzen staan er 3000 boeken voor jong en oud op de planken: detectiveverhalen, romans, strips, manga, enz.\r\nElke week brengen Evelyne, de bibliothecaresse, en het team van vrijwilligers nieuwe boeken."
    ]
  },
