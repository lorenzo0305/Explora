  "rdfs:comment": {
    "de": [
      "9 Uhr: Vorführung des Dokumentarfilms von Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\" (Paul Ricoeur, Philosoph aller Dialoge). G\r\n9.30 Uhr: \"A chacun son écobiographie\": Wanderung und Schreibworkshop mit dem Philosophen J.P. Pierron. Wanderzeit 1 Stunde, Notizbuch und Stift mitbringen. 15?"
    ],
    "en": [
      "9am: Screening of Caroline Reussner's documentary \"Paul Ricoeur, philosophe de tous les dialogues\". G\r\n9:30 am: \"To each his own ecobiography\": hike-writing workshop with philosopher J.P. Pierron. Walking time 1h, bring notebook and pen. 15?"
    ],
    "it": [
      "ore 9: proiezione del documentario di Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G\r\n9.30: \"A ciascuno la sua ecobiografia\": passeggiata e laboratorio di scrittura con J.P. Pierron, filosofo. Durata della passeggiata: 1 ora. Portare taccuino e penna. 15?"
    ],
    "fr": [
      "9h : Projection du documentaire de Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G\r\n9h30 : \"A chacun son écobiographie\" : randonnée-atelier d'écriture avec J.P. Pierron, philosophe. Temps de marche 1h, prévoir carnet, stylo. 15€"
    ],
    "nl": [
      "9u: Vertoning van de documentaire \"Paul Ricoeur, philosophe de tous les dialogues\" van Caroline Reussner. G\r\n9u30: \"Ieder zijn ecobiografie\": wandeling en schrijfworkshop met J.P. Pierron, filosoof. Duur van de wandeling: 1 uur. Notitieboekje en pen meenemen. 15?"
    ],
    "es": [
      "9.00 h: Proyección del documental de Caroline Reussner \"Paul Ricoeur, philosophe de tous les dialogues\". G\r\n9.30 h: \"A cada cual su ecobiografía\": paseo y taller de escritura con J.P. Pierron, filósofo. Tiempo de paseo: 1 hora. Traer cuaderno y bolígrafo. 15?"
    ]
  },
