  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Écluses liegt in der Nähe von Athanor und ist ein Selbstbedienungsrestaurant, das einen guten Ruf genießt, denn die Treue der Kunden zeigt, dass das Verhältnis von Qualität, Auswahl und Preis nach wie vor unschlagbar ist."
    ],
    "en": [
      "Located close to Athanor, Les Écluses is a self-service restaurant with an established reputation, as the loyalty of its clientele shows that the quality/choice/price ratio remains unbeatable."
    ],
    "it": [
      "Situato vicino ad Athanor, Les Écluses è un ristorante self-service con una reputazione consolidata, poiché la fedeltà dei suoi clienti dimostra che il rapporto qualità/scelta/prezzo rimane imbattibile."
    ],
    "fr": [
      "Situé à proximité d’Athanor, le restaurant les Écluses est un self dont la réputation n’est plus à faire, car la fidélité de la clientèle montre que le rapport qualité/choix/ prix reste imbattable."
    ],
    "es": [
      "Situado cerca del Athanor, Les Écluses es un autoservicio con una reputación consolidada, ya que la fidelidad de sus clientes demuestra que la relación calidad/elección/precio sigue siendo inmejorable."
    ],
    "nl": [
      "Les Écluses, dicht bij Athanor, is een zelfbedieningsrestaurant met een gevestigde reputatie, want de loyaliteit van de klanten laat zien dat de kwaliteit/keuze/prijsverhouding onverslaanbaar blijft."
    ]
  },
  "rdfs:label": {
