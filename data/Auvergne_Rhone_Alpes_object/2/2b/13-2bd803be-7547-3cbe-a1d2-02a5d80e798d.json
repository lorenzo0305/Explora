  "rdfs:comment": {
    "de": [
      "Seit 2018 empfängt Sie das Le Bouchon des Artistes im Herzen des Lyoner Stadtteils Part-Dieu, nur wenige Schritte von der Veranstaltungshalle La Bourse du Travail entfernt. Es interpretiert die Gerichte der kulinarischen Tradition Lyons neu und bringt dabei seine Einzigartigkeit und Kreativität ein."
    ],
    "en": [
      "Since 2018, Le Bouchon des Artistes has been welcoming guests in the heart of Lyon's Part-Dieu district, just a stone's throw from La Bourse du Travail theatre. It revisits traditional Lyonnais dishes, adding its own unique touch and creativity."
    ],
    "it": [
      "Dal 2018, Le Bouchon des Artistes vi accoglie nel cuore del quartiere Lyon Part-Dieu, a due passi dal teatro Bourse du Travail. Rivisita i piatti della tradizione lionese, aggiungendo il proprio tocco unico e la propria creatività."
    ],
    "fr": [
      "Depuis 2018, Le Bouchon des Artistes vous accueille au coeur du quartier de Lyon Part-Dieu, à deux pas de la salle de spectacle La Bourse du Travail. Il revisite les plats de la tradition culinaire lyonnaise, en apportant sa singularité et sa créativité."
    ],
    "nl": [
      "Sinds 2018 verwelkomt Le Bouchon des Artistes je in het hart van de wijk Lyon Part-Dieu, op een steenworp afstand van de Bourse du Travail. Het herleeft traditionele Lyonnaise gerechten en voegt er zijn eigen unieke flair en creativiteit aan toe."
    ],
    "es": [
      "Desde 2018, Le Bouchon des Artistes le da la bienvenida en el corazón del barrio de Lyon Part-Dieu, a dos pasos del teatro Bourse du Travail. Revive los platos tradicionales lioneses, añadiendo su toque único y su creatividad."
    ]
  },
