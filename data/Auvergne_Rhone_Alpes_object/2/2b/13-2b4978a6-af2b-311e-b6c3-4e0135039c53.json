  "rdfs:comment": {
    "de": [
      "Flacher Strand mit Gras-, Sand- und kleinen Kieselsteinflächen, ideal zum Entspannen und Schwimmen mit der Familie. Seichten Gewässern. Den ganzen Tag voller Sonnenschein. Spielplatz. Rauchen und Grillen am Strand verboten."
    ],
    "en": [
      "Flat beach combining areas of grass, sand and small pebbles, ideal for relaxation and swimming with the family. Shallow waters. Full sunshine all day. Playground. No smoking and no barbecue on the beach."
    ],
    "it": [
      "Una spiaggia piatta che combina zone di erba, sabbia e piccoli ciottoli, ideale per rilassarsi e nuotare. Acque poco profonde. Sole pieno tutto il giorno. Area giochi. È vietato fumare o fare barbecue in spiaggia."
    ],
    "fr": [
      "Plage plate alliant des zones d'herbe, de sable et de petits galets, idéale pour la détente et la baignade. Eaux peu profondes. Plein ensoleillement toute la journée. Aire de jeux. Interdiction de fumer et de faire un barbecue sur la plage."
    ],
    "es": [
      "Playa llana que combina zonas de hierba, arena y pequeños guijarros, ideal para relajarse y bañarse. Aguas poco profundas. Sol todo el día. Zona de juegos. Prohibido fumar y hacer barbacoas en la playa."
    ],
    "nl": [
      "Een vlak strand met gras, zand en kleine kiezels, ideaal om te ontspannen en te zwemmen. Ondiep water. De hele dag zon. Speeltuin. Verboden te roken of te barbecueën op het strand."
    ]
  },
