  "rdfs:comment": {
    "de": [
      "Dieser reißende Fluss, der von der RD1090 aus leicht zu erreichen ist, verbirgt in seinem Inneren Farios von beachtlicher Größe... Werden Sie es schaffen, sie anzulocken?"
    ],
    "en": [
      "Along the  road D1090 this torrential stream reveals large sized brownies.Will you be able to lure them?"
    ],
    "it": [
      "Facilmente accessibile dalla RD1090, questo fiume torrentizio nasconde nel suo seno alcuni fari di buone dimensioni? Riuscirete ad attirarli?"
    ],
    "fr": [
      "Facilement accessible en bord de la RD1090, cette rivière torrentueuse cache en son sein des farios de belle taille… Arriverez-vous à les leurrer ?"
    ],
    "nl": [
      "Gemakkelijk bereikbaar vanaf de RD1090, verbergt deze rivier in haar boezem enkele mooie farios? Lukt het je om ze te lokken?"
    ],
    "es": [
      "Fácilmente accesible desde la RD1090, este río torrencial esconde en su seno unos farios de buen tamaño? ¿Conseguirás atraerlos?"
    ]
  },
  "rdfs:label": {
