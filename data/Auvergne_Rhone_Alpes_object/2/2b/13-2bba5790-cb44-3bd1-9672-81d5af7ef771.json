  "rdfs:comment": {
    "de": [
      "Das Cinéma Lumière Terreaux zeigt Filme mit nationalem Kinostart in vier komplett neu gestalteten, behindertengerechten Sälen mit 113, 61, 43 und 40 Sitzen, in denen täglich 16 Vorstellungen stattfinden werden."
    ],
    "en": [
      "The Cinéma Lumière Terreaux offers films for national release in four completely refurbished theatres accessible to people with reduced mobility, with 113, 61, 43 and 40 seats, which will host 16 screenings a day."
    ],
    "it": [
      "Il Cinéma Lumière Terreaux offre film in uscita nazionale in quattro sale completamente rinnovate, accessibili alle persone a mobilità ridotta, con 113, 61, 43 e 40 posti, che ospiteranno 16 proiezioni al giorno."
    ],
    "fr": [
      "Le Cinéma Lumière Terreaux propose des films en sortie nationale, dans quatre salles totalement refaites et accessibles aux personnes à mobilité réduite, de 113, 61, 43 et 40 fauteuils, qui accueilleront 16 séances par jour."
    ],
    "es": [
      "El Cinéma Lumière Terreaux ofrece películas de estreno nacional en cuatro salas completamente renovadas y accesibles para personas con movilidad reducida, con 113, 61, 43 y 40 butacas, que acogerán 16 proyecciones al día."
    ],
    "nl": [
      "De Cinéma Lumière Terreaux biedt films voor nationale release in vier volledig gerenoveerde bioscopen, toegankelijk voor personen met beperkte mobiliteit, met 113, 61, 43 en 40 plaatsen, die 16 voorstellingen per dag zullen herbergen."
    ]
  },
