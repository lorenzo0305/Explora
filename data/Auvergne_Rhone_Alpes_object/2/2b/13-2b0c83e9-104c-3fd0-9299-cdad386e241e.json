  "rdfs:comment": {
    "de": [
      "Kein Materialverleih, keine Begleitung."
    ],
    "en": [
      "Rocky bar in balcony, facing the summit of Pierre sur Haute, the highest point in the Loire department.\r\nNo loan of equipment, no support structure."
    ],
    "it": [
      "Un balcone roccioso affacciato sulla cima di Pierre sur Haute, il punto più alto del dipartimento della Loira.\r\nNessun prestito di attrezzature, nessuna struttura di supporto."
    ],
    "fr": [
      "Barre rocheuse en balcon, face au sommet de Pierre sur Haute, point culminant du département de la Loire.\r\nAucun prêt de matériel pas de structure d'accompagnement."
    ],
    "es": [
      "Un balcón rocoso frente a la cumbre de Pierre sur Haute, el punto más alto del departamento del Loira.\r\nNo hay préstamo de equipos, ni estructura de apoyo."
    ],
    "nl": [
      "Een rotsachtig balkon met uitzicht op de top van Pierre sur Haute, het hoogste punt van het departement Loire.\r\nGeen lening van apparatuur, geen ondersteunende structuur."
    ]
  },
