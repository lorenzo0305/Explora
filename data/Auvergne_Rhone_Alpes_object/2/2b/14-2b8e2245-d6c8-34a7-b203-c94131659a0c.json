        ],
        "en": [
          "Walking, \"oil\" painting, \"watercolour\" painting, board games, card games, embroidery, knitting, models (boats)."
        ],
        "it": [
          "Passeggiate, pittura a olio, pittura ad acquerello, giochi da tavolo, giochi di carte, ricamo, lavoro a maglia, modellini di barche."
        ],
        "fr": [
          "Marche, peinture \"huile\", peinture \"aquarelle\", jeux de société, jeu de cartes, broderie, tricot, maquettes (bateaux)."
        ],
        "nl": [
          "Wandelen, olieverfschilderen, aquarelleren, bordspellen, kaartspellen, borduren, breien, modelboten."
        ],
        "es": [
