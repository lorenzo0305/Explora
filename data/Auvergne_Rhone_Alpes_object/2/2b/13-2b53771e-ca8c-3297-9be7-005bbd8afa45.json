  "rdfs:comment": {
    "de": [
      "Idealer Ort, um eine Auszeit zu nehmen und neue Energie zu tanken. Genießen Sie die Ruhe des Forêt des Colettes. Die Auberge besteht aus drei Zimmern, von denen eines für Personen mit eingeschränkter Mobilität geeignet ist."
    ],
    "en": [
      "The ideal place to take a break and recharge your batteries. Come and enjoy the tranquility of the Forêt des Colettes. The Auberge has three rooms, one of which is suitable for people with reduced mobility."
    ],
    "it": [
      "Il luogo ideale per fare una pausa e ricaricare le batterie. Venite a godere della tranquillità della Forêt des Colettes. L'Auberge dispone di tre camere, di cui una adatta a persone con mobilità ridotta."
    ],
    "fr": [
      "Lieu idéal pour faire un break et se ressourcer. Venez profiter de la tranquillité de la Forêt des Colettes. L'Auberge se compose de trois chambres, dont une adaptée aux personnes à mobilité réduite."
    ],
    "es": [
      "El lugar ideal para descansar y reponer fuerzas. Venga a disfrutar de la tranquilidad de la Forêt des Colettes. El Auberge dispone de tres habitaciones, una de ellas adaptada para personas con movilidad reducida."
    ],
    "nl": [
      "De ideale plek om er even tussenuit te gaan en nieuwe energie op te doen. Kom genieten van de rust van het Forêt des Colettes. De Auberge heeft drie kamers, waarvan er één geschikt is voor mindervaliden."
    ]
  },
  "rdfs:label": {
