  "rdfs:comment": {
    "de": [
      "Der Waffelwagen, seit 1960 ein unumgänglicher Treffpunkt für die Feinschmecker der Bucht, erwartet Sie in Saint Valery sur Somme vor dem Bahnhof des kleinen Zuges zur Zeit des Snacks. Private Veranstaltungen auf Anfrage.\nUnsere aktuellen Öffnungszeiten finden Sie auf unseren sozialen Netzwerken oder unserem Google-Eintrag."
    ],
    "en": [
      "The waffle truck, a must for Bay Area gourmets since 1960, awaits you in Saint Valery sur Somme at snack time, in front of the little train station. Private events on request.\nOur current opening times can be viewed on our social networks or Google page."
    ],
    "it": [
      "Il camioncino dei waffle, un must per gli amanti del cibo nella Baia dal 1960, vi aspetta a Saint Valery sur Somme all'ora della merenda, di fronte alla piccola stazione ferroviaria. Eventi privati su richiesta.\nGli orari di apertura attuali sono consultabili sui nostri social network o sulla nostra pagina Google."
    ],
    "fr": [
      "Le camion de gaufres, rendez-vous incontournable des gourmands de la Baie depuis 1960, vous attend à Saint Valery sur Somme à l’heure du goûter, devant la gare du petit train. Événements privés sur demande. \nNos horaires à jour sont consultables sur nos réseaux sociaux ou notre fiche Google."
    ],
    "es": [
      "El camión de los gofres, cita ineludible de los gastrónomos de la Bahía desde 1960, le espera en Saint Valery sur Somme a la hora de la merienda, frente a la pequeña estación de tren. Eventos privados a petición.\nPuede consultar nuestros horarios de apertura actuales en nuestras redes sociales o en nuestra página de Google."
    ],
    "nl": [
      "De wafeltruck, sinds 1960 een must voor fijnproevers in de baai, wacht op je in Saint Valery sur Somme tijdens de snacktijd, voor het stationnetje. Privé-evenementen op aanvraag.\nOnze actuele openingstijden kunt u bekijken op onze sociale netwerken of onze Google-pagina."
    ]
  },
  "rdfs:label": {
