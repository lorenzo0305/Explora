  "rdfs:comment": {
    "de": [
      "Bar mit musikalischer Atmosphäre und einer überdachten Außenterrasse, die sich zu einer bepflanzten Fußgängerzone hin öffnet.\r\nCoktails, Weine, Alkohol, Softdrinks.\r\nAperitifbretter"
    ],
    "en": [
      "Bar with a musical ambience, featuring a covered outdoor terrace opening onto a pedestrian, leafy street.\r\nCoktails, wines, spirits, soft drinks.\r\nAperitif platters"
    ],
    "it": [
      "Un bar con un'atmosfera musicale e una terrazza esterna coperta che si affaccia su una strada pedonale verdeggiante.\r\nCocktail, vini, liquori, bevande analcoliche.\r\nAperitivi al piatto"
    ],
    "fr": [
      "Bar à ambiance musicale doté d’une terrasse extérieure couverte et ouverte sur une rue piétonne et végétalisée.\r\nCoktails, vins, alcool, softs. \r\nPlanches apéritives"
    ],
    "nl": [
      "Een bar met een muzikale sfeer en een overdekt buitenterras met uitzicht op een lommerrijke voetgangersstraat.\r\nCoktails, wijnen, sterke dranken, frisdranken.\r\nAperitiefschotels"
    ],
    "es": [
      "Bar con ambiente musical y terraza exterior cubierta con vistas a una frondosa calle peatonal.\r\nCócteles, vinos, licores, refrescos.\r\nPlatos de aperitivo"
    ]
  },
