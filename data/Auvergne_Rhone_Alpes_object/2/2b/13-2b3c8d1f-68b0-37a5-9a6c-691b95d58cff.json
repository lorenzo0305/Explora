  "rdfs:comment": {
    "de": [
      "16. Buchmesse in Prades, organisiert von Le Rocher d'écriture mit Autorentreffen und Signierstunden im Festzelt (40 Autoren, Gleichberechtigung zwischen Schriftstellerinnen und Schriftstellern), Konferenz über den Dialekt, Konzert der Viole de Gambe & Fotoausstellung und Gemälde."
    ],
    "en": [
      "16th Book Fair in Prades, organized by Le Rocher d'écriture with author meetings & signings under the big top (40 authors, equity between writers), conference on patois, Viole de Gambe concert & photo and painting exhibition."
    ],
    "it": [
      "16a Fiera del Libro di Prades, organizzata da Le Rocher d'écriture, con incontri con gli autori e firma di libri sotto il tendone (40 autori, fiera tra scrittori), conferenza sul patois, concerto di Viole de Gambe e mostra fotografica e di pittura."
    ],
    "fr": [
      "16 ème Salon du livre à Prades, organisé par Le Rocher d'écriture avec des rencontres d'auteurs & dédicaces sous chapiteau (40 auteurs, équité entre écrivaines et écrivains), conférence sur le patois, concert de Viole de Gambe & expo photos et peintures."
    ],
    "nl": [
      "16e boekenbeurs in Prades, georganiseerd door Le Rocher d'écriture, met ontmoetingen met auteurs en signeersessies onder de big top (40 auteurs, beurs tussen schrijvers), conferentie over patois, concert van Viole de Gambe en foto- en schilderijententoonstelling."
    ],
    "es": [
      "16ª Feria del Libro de Prades, organizada por Le Rocher d'écriture, con encuentros con autores y firmas de libros bajo la carpa (40 autores, feria entre escritores), conferencia sobre el patois, concierto de Viole de Gambe y exposición de fotografía y pintura."
    ]
  },
