  "rdfs:comment": {
    "de": [
      "Finden Sie mithilfe Ihrer Karte die Markierungen, die im Herzen des Freizeitzentrums Faramans installiert wurden, um dort bemerkenswerte Orte zu entdecken."
    ],
    "en": [
      "With the help of your map, find the beacons installed in the heart of the leisure center of Faramans, to discover remarkable sites."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, trovate i segnalatori installati nel cuore del centro ricreativo di Faramans per scoprire siti notevoli."
    ],
    "fr": [
      "A l'aide de votre carte, trouvez les balises installées au cœur de la base de loisirs de Faramans, pour y découvrir des sites remarquables."
    ],
    "nl": [
      "Zoek met behulp van uw kaart de markeringen die in het hart van het recreatiecentrum Faramans zijn aangebracht om opmerkelijke sites te ontdekken."
    ],
    "es": [
      "Con la ayuda de su mapa, encuentre los marcadores instalados en el corazón del centro de ocio de Faramans para descubrir sitios notables."
    ]
  },
