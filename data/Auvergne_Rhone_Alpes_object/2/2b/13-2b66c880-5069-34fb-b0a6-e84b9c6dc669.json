  "rdfs:comment": {
    "de": [
      "Dieses monumentale Wandgemälde wurde am 11. November 2010 eingeweiht und von Cité Création realisiert. Es illustriert das Leben und die Taten von René Nicod."
    ],
    "en": [
      "Inaugurated on November 11, 2010 and created by Cité Création, this monumental fresco illustrates the life and work of René Nicod."
    ],
    "it": [
      "Inaugurato l'11 novembre 2010 e prodotto da Cité Création, questo affresco monumentale illustra la vita e l'opera di René Nicod."
    ],
    "fr": [
      "Inaugurée le 11 novembre 2010 et réalisée par Cité Création, cette fresque monumentale illustre la vie et les actions de René Nicod."
    ],
    "es": [
      "Inaugurado el 11 de noviembre de 2010 y realizado por Cité Création, este fresco monumental ilustra la vida y la obra de René Nicod."
    ],
    "nl": [
      "Dit monumentale fresco, ingehuldigd op 11 november 2010 en geproduceerd door Cité Création, illustreert het leven en werk van René Nicod."
    ]
  },
