  "rdfs:comment": {
    "de": [
      "Besuchen Sie ein märchenhaftes Museum in Lans-en-Vercors! Eine Stunde lang werden auf 1500m² 350 Figuren in wunderbaren Inszenierungen zum Leben erweckt. Die Kinder sind verzaubert und die Erwachsenen fallen in ihre Kindheit zurück!"
    ],
    "en": [
      "Visit a magical museum in Lans-en-Vercors! 350 characters come to life in wonderful settings for one hour over 1,500m². The children will love it and the adults will feel like children again!"
    ],
    "it": [
      "Un imperdibile museo delle fiabe in Isère! In un'area di 1500 m², godetevi una parentesi incantata e giocosa tra 350 automi: i più piccoli rimarranno a bocca aperta e gli adulti riscopriranno il loro spirito infantile!"
    ],
    "fr": [
      "Un musée féerique incontournable en Isère ! Sur 1500m², vivez une parenthèse enchantée et ludique parmi 350 automates : les plus jeunes sont émerveillés et les adultes retrouvent leur âme d'enfant !"
    ],
    "es": [
      "¡Un museo de cuento imprescindible en Isère! En una superficie de 1.500 m², disfrute de un interludio encantado y lúdico entre 350 autómatas: ¡los más pequeños quedarán maravillados y los adultos redescubrirán su espíritu infantil!"
    ],
    "nl": [
      "Een niet te missen sprookjesmuseum in Isère! Op een oppervlakte van 1.500 m² kunt u genieten van een betoverend en speels intermezzo tussen 350 automaten: jongeren zullen versteld staan en volwassenen zullen hun kinderlijke geest hervinden!"
    ]
  },
  "rdfs:label": {
