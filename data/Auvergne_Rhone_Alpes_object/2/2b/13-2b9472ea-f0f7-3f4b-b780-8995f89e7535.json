  "rdfs:comment": {
    "de": [
      "Organisieren Sie Ihr Treffen in einem außergewöhnlichen Rahmen mit einer futuristischen Cyberpunk-Dekoration.\r\nSie brauchen sich um nichts zu kümmern, wir kümmern uns um alles: Meeting, Catering und sogar Teambuilding-Aktivitäten."
    ],
    "en": [
      "Organize your meeting in a unique setting with futuristic cyberpunk decor.\r\nDon't worry about a thing, we'll take care of everything: meetings, catering and even team building activities."
    ],
    "it": [
      "Organizzate la vostra riunione in un ambiente straordinario con un arredamento cyberpunk futuristico.\r\nNon preoccupatevi di nulla, penseremo a tutto noi: alla riunione, al catering e persino alle attività di team building."
    ],
    "fr": [
      "Organisez votre réunion dans un cadre hors du commun avec une déco cyberpunk futuriste.\r\nNe vous préoccupez de rien, on s'occupe de tout, réunion, traiteur et même activité team building."
    ],
    "nl": [
      "Organiseer je vergadering in een unieke omgeving met een futuristisch cyberpunk decor.\r\nMaak je geen zorgen, wij regelen alles: de vergadering, de catering en zelfs de teambuildingactiviteiten."
    ],
    "es": [
      "Organice su reunión en un entorno único con una decoración ciberpunk futurista.\r\nNo te preocupes por nada, nosotros nos encargamos de todo: la reunión, el catering e incluso las actividades de team-building."
    ]
  },
