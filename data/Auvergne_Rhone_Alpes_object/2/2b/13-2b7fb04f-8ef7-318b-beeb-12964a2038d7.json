  "rdfs:comment": {
    "de": [
      "Familienhotel am Fuße der Pisten von Morzine-Les Gets im Winter und am Rande der Wiesen im Sommer.\r\nSemi-gastronomisches Restaurant, das regionale Spezialitäten und Kreationen verbindet."
    ],
    "en": [
      "Family hotel at the foot of the Morzine-Les Gets slopes in winter and in the edge of meadows in summer.\r\nSemi-gastronomic restaurant combining regional speciality and creation."
    ],
    "it": [
      "Hotel a conduzione familiare ai piedi delle piste di Morzine-Les Gets in inverno e ai margini dei prati in estate.\r\nRistorante semi-gastronomico che combina specialità regionali e cucina creativa."
    ],
    "fr": [
      "Hôtel familial au pied des pistes de Morzine-Les Gets en hiver et en bordure des prés l'été.\r\nRestaurant semi-gastronomique alliant spécialité de la région et création."
    ],
    "es": [
      "Hotel familiar al pie de las pistas de Morzine-Les Gets en invierno y al borde de los prados en verano.\r\nRestaurante semigastronómico que combina especialidades regionales y cocina creativa."
    ],
    "nl": [
      "Familiehotel aan de voet van de pistes van Morzine-Les Gets in de winter en aan de rand van de weiden in de zomer.\r\nSemi-gastronomisch restaurant met een combinatie van regionale specialiteiten en creatieve gerechten."
    ]
  },
