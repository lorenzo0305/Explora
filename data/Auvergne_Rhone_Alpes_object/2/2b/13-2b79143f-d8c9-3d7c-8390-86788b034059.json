  "rdfs:comment": {
    "de": [
      "Eine Showmahlzeit, die ebenso überraschend wie überwältigend ist. Eine Gourmetküche in einem warmen und atypischen Rahmen. Eine moderne und dynamische Show, die die Traditionen der Music-Hall mit den aktuellen Trends verbindet."
    ],
    "en": [
      "A meal-show as surprising as it is dazzling. Gourmet cuisine in a warm, atypical setting. A modern, dynamic show combining the traditions of Music-Hall with the latest trends."
    ],
    "it": [
      "Uno spettacolo culinario tanto sorprendente quanto abbagliante. Cucina gourmet in un ambiente caldo e atipico. Uno spettacolo moderno e dinamico che mescola le tradizioni del Music-Hall con quelle delle tendenze attuali."
    ],
    "fr": [
      "Un repas-spectacle aussi surprenant qu'éblouissant. Une cuisine gourmande dans un cadre chaleureux et atypique. Un spectacle moderne et dynamique mêlant les traditions du Music-Hall avec celles des tendances actuelles."
    ],
    "es": [
      "Un espectáculo gastronómico tan sorprendente como deslumbrante. Cocina gourmet en un entorno cálido y atípico. Un espectáculo moderno y dinámico que mezcla las tradiciones del Music-Hall con las tendencias actuales."
    ],
    "nl": [
      "Een even verrassende als verbluffende maaltijdshow. Keuken voor fijnproevers in een warme en ongewone omgeving. Een moderne, dynamische show die de tradities van Music Hall combineert met de nieuwste trends."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Repas-spectacle du Cabaret Le Bongo"
    ]
  },
