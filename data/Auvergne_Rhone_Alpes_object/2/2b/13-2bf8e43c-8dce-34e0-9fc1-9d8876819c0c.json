  "rdfs:comment": {
    "de": [
      "Geöffnet von Dienstag bis Sonntag, nur mittags und abends und nur mit Reservierung.\r\n \r\nTagesgericht für 16 Euro nur mittags von Dienstag bis Freitag.\r\nAbends, am Wochenende und an Feiertagen à la carte."
    ],
    "en": [
      "Open Tuesday to Sunday, lunch and dinner only and by reservation only.\r\n \r\nDish of the day at 16? lunchtime only, Tuesday to Friday.\r\nEvenings, weekends and public holidays, à la carte."
    ],
    "it": [
      "Aperto da martedì a domenica, solo a pranzo e a cena e su prenotazione.\r\n \r\nPiatto del giorno alle 16? solo a pranzo dal martedì al venerdì.\r\nLa sera, il fine settimana e i giorni festivi, à la carte."
    ],
    "fr": [
      "Ouvert du mardi au dimanche,  midi et soir uniquement  et uniquement  sur réservation.\r\n \r\nPlat du jour à 16€ uniquement les midis du mardi au vendredi. \r\nLes soirs, le week-end et les jours fériés, à la carte."
    ],
    "nl": [
      "Geopend van dinsdag tot zondag, alleen lunch en diner en alleen op reservering.\r\n \r\nDagschotel om 16? alleen voor lunch van dinsdag tot vrijdag.\r\nS Avonds, in het weekend en op feestdagen à la carte."
    ],
    "es": [
      "Abierto de martes a domingo, sólo para almuerzos y cenas y previa reserva.\r\n \r\nPlato del día a 16? sólo para el almuerzo de martes a viernes.\r\nNoches, fines de semana y festivos, a la carta."
    ]
  },
