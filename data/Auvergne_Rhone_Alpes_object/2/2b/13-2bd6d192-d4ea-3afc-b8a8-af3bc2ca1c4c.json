          "additionalInformation": {
            "de": [
              "Samstag, 20. September: Durchgehende Öffnung von 9 bis 18 Uhr anlässlich des 30-jährigen Bestehens des Regionalen Naturparks Massif des Bauges.\r\nSchließung am Abend des 27. September 2025 für den Winter."
            ],
            "en": [
              "Saturday September 20: continuous opening from 9am to 6pm to celebrate the 30th anniversary of the Parc naturel régional du Massif des Bauges.\r\nClosing for winter on September 27, 2025."
            ],
            "it": [
              "Sabato 20 settembre: apertura non-stop dalle 9.00 alle 18.00 per celebrare il 30° anniversario del Parco Naturale Regionale del Massiccio dei Bauges.\r\nChiusura invernale la sera del 27 settembre 2025."
            ],
            "fr": [
              "Samedi 20 septembre : ouverture en continu de 9h à 18h à l'occasion des 30 ans du Parc naturel régional du Massif des Bauges.\r\nFermeture le 27 septembre 2025 au soir pour l'hiver."
            ],
            "nl": [
              "Zaterdag 20 september: non-stop geopend van 9.00 tot 18.00 uur om de 30e verjaardag van het Regionaal Natuurpark Massif des Bauges te vieren.\r\nSluiting op 27 september 's avonds 2025 voor de winter."
            ],
            "es": [
              "Sábado 20 de septiembre: abierto ininterrumpidamente de 9.00 a 18.00 h para celebrar el 30º aniversario del Parque Natural Regional del Macizo de las Bauges.\r\nCierre en la tarde del 27 de septiembre de 2025 para el invierno."
            ]
          },
