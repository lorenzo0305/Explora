  "rdfs:comment": {
    "de": [
      "Im Herzen des Regionalen Naturparks Massif des Bauges empfängt Sie der Empfang von Grand Chambéry Alpes Tourisme in Le Châtelard, um Sie bei Ihrer Entdeckung des Gebiets zu begleiten."
    ],
    "en": [
      "In the heart of the Bauges Natural Park, the reception of Greater Chambéry Alps Tourism at Le Châtelard welcomes you and guide you in your discovery of the territory."
    ],
    "it": [
      "Nel cuore del Parco Naturale dei Bauges, l'accoglienza di Grande Chambery Alpi Turismo in Le Châtelard vi dà il benvenuto per accompagnarvi nella vostra scoperta del territorio."
    ],
    "fr": [
      "En plein cœur du Parc Naturel Régional du Massif des Bauges, l'accueil de Grand Chambéry Alpes Tourisme au Châtelard vous reçoit pour vous accompagner dans votre découverte du territoire."
    ],
    "nl": [
      "Midden in het regionale natuurpark van het Baugesmassief bevindt zich het kantoor van Grand Chambéry Alpes Tourisme in Châtelard. Het hele jaar kunt u hier terecht voor informatie."
    ],
    "es": [
      "En el corazón del Parque Natural Regional del Macizo de Bauges, la recepción de Grand Chambéry Alpes Tourisme en Le Châtelard le da la bienvenida para ayudarle a descubrir la zona."
    ]
  },
