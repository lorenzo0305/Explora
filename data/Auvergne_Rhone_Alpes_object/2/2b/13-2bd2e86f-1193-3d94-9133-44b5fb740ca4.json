  "rdfs:comment": {
    "de": [
      "Ein echtes Indianerdorf mit Tipis, Aktivitäten und einer Schminkwerkstatt ist ein kleines Paradies für Kinder, in dem Skifahren Spaß macht."
    ],
    "en": [
      "A true Indian village with teepees, activities and face painting, it is a paradise for children to learn to ski."
    ],
    "it": [
      "Un vero e proprio villaggio indiano con teepee, attività e un laboratorio di trucco, è un piccolo paradiso per i bambini che possono sciare e divertirsi allo stesso tempo."
    ],
    "fr": [
      "Véritable village d'indiens avec ses tipis, ses activités et son atelier de maquillage, c' est un petit paradis pour les enfants pour pratiquer le ski tout en s'amusant."
    ],
    "es": [
      "Un auténtico poblado indio con tipis, actividades y un taller de maquillaje, es un pequeño paraíso para que los niños disfruten esquiando y se diviertan al mismo tiempo."
    ],
    "nl": [
      "Een echt Indianen dorp met tipi's, activiteiten en schminken, het is een paradijs voor kinderen om te leren skiën."
    ]
  },
