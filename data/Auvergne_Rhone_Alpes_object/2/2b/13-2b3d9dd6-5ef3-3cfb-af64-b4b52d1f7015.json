  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine \"Bistro\"-Karte mit unseren Mahlzeitsalaten, Burgern, Tartars, Ribs, Entrecôtes... Lust auf ein Eis, einen Cocktail oder ein Brett zum Teilen? Wir erwarten Sie auf unserer Terrasse."
    ],
    "en": [
      "We offer a \"bistro\" menu, with our meal salads, burgers, tartars, ribs, entrecôtes... If you fancy an ice cream, a cocktail or a board to share, we look forward to welcoming you on our terrace."
    ],
    "it": [
      "Proponiamo un menu \"bistrot\", con insalate, hamburger, tartara, costine, entrecôte... Se avete voglia di un gelato, di un cocktail o di una tavola da condividere, saremo lieti di accogliervi sulla nostra terrazza."
    ],
    "fr": [
      "Nous vous proposons une carte \"bistrot\", avec nos salades repas, nos burgers, tartares, ribs, entrecôtes... Envie d'une glace, d'un cocktail ou d'une planche à partager, nous vous attendons sur notre terrasse."
    ],
    "nl": [
      "We bieden een \"bistro\" menu, met onze salades, hamburgers, tartaar, spareribs, entrecôtes... Als je zin hebt in een ijsje, een cocktail of een bord om te delen, verwelkomen we je graag op ons terras."
    ],
    "es": [
      "Le proponemos una carta \"bistrot\", con nuestras ensaladas, hamburguesas, tártaros, costillas, entrecôtes... Si le apetece un helado, un cóctel o una tabla para compartir, le esperamos en nuestra terraza."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Le Welcome"
    ],
    "fr": [
      "Restaurant Le Welcome"
    ]
  },
