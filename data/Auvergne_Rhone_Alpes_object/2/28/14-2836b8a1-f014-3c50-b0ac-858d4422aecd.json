  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/31766ec0-2675-3289-852b-5c7ba16132ec",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten:\nMontag, Dienstag, Mittwoch, Freitag und Samstag: 7:00-12:45 Uhr / 15:00-19:00 Uhr\nSonntag: 7.15-12.45 Uhr\n\nDonnerstag geschlossen\n \n Bestellung :\nTelefonische Bestellung unter 03 21 48 88 98 möglich\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\nMonday, Tuesday, Wednesday, Friday and Saturday: 7am-12.45pm / 3pm-7pm\nSunday: 7h15-12h45\n\nClosed on Thursday\n \n Ordering :\nOrder by phone 03 21 48 88 98\n\nCollection:\nTakeaway during bakery opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\nLunedì, martedì, mercoledì, venerdì e sabato: 7.00-12.45 / 15.00-19.00\nDomenica: 7.15-12.45\n\nChiuso il giovedì\n \n Ordini :\nGli ordini possono essere effettuati per telefono al numero 03 21 48 88 98\n\nRitiro:\nDa asporto durante gli orari di apertura della panetteria\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \nLe lundi, mardi, mercredi, vendredi et samedi: 7h-12h45 / 15h-19h\nLe dimanche: 7h15-12h45\n\nFermeture le jeudi\n \n Commande : \nPossibilité de commander par téléphone au 03 21 48 88 98\n\nRetrait :\nÀ emporter aux horaires d'ouverture de la boulangerie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\nMaandag, dinsdag, woensdag, vrijdag en zaterdag: 7u-12.45u / 15u-19u\nZondag: 7u15-12u45\n\nGesloten op donderdag\n \n Bestellen :\nBestellingen kunnen telefonisch geplaatst worden op 03 21 48 88 98\n\nAfhalen:\nAfhalen tijdens openingstijden bakkerij\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\nLunes, martes, miércoles, viernes y sábado: 7h-12h45 / 15h-19h\nDomingo: 7.15 h-12.45 h\n\nJueves cerrado\n \n Pedidos :\nLos pedidos pueden realizarse por teléfono llamando al 03 21 48 88 98\n\nRecogida:\nPara llevar durante el horario de apertura de la panadería\n\n "
        ]
      },
