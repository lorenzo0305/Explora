  "rdfs:comment": {
    "de": [
      "Die Künstlerin Anne Henry empfängt Sie in ihrer farbenfrohen Welt. Entdecken Sie ihre Porträts und Fresken, die Gelegenheit bieten, in imaginäre Lebensgeschichten einzutauchen."
    ],
    "en": [
      "Artist Anne Henry welcomes you to her colorful world. Come and discover her portraits and frescoes, an opportunity to plunge into imaginary life stories."
    ],
    "it": [
      "L'artista Anne Henry vi accoglie nel suo mondo colorato. Venite a scoprire i suoi ritratti e affreschi, un'occasione per immergervi in storie di vita immaginarie."
    ],
    "fr": [
      "L'artiste Anne Henry vous accueille dans son univers coloré. Venez découvrir ses portraits et ses fresques qui sont l'occasion de plonger dans des histoires de vie imaginaires."
    ],
    "es": [
      "La artista Anne Henry le da la bienvenida a su colorido mundo. Venga a descubrir sus retratos y frescos, una oportunidad para sumergirse en historias de vida imaginarias."
    ],
    "nl": [
      "Kunstenares Anne Henry heet je welkom in haar kleurrijke wereld. Kom en ontdek haar portretten en fresco's, een kans om je onder te dompelen in denkbeeldige levensverhalen."
    ]
  },
  "rdfs:label": {
