  "rdfs:comment": {
    "de": [
      "Die Brasserie Le Sud ist eine der 5 Brasserien von Paul Bocuse. Nur einen Katzenprung vom Place Bellecour entfernt, bietet sie eine sonnige Küche mit mediterranen Akzenten an. Profitieren Sie an schönen Tagen von der angenehmen Terrasse."
    ],
    "en": [
      "The Brasserie Le Sud, one of the five brasseries created by Paul Bocuse, proposes a bright, sunny cuisine with a Mediterranean touch, just a stone's throw from Place Bellecour. The terrace is particularly attractive when the sun is out."
    ],
    "it": [
      "La Brasserie Le Sud, una delle cinque brasserie firmate Paul Bocuse, propone una cucina del sole dagli accenti mediterranei a due passi dalla place Bellecour. Una piacevole terrazza con tavoli all'aperto nelle belle giornate"
    ],
    "fr": [
      "La Brasserie Le Sud, une des cinq brasseries signées Paul Bocuse, propose une cuisine du soleil aux accents méditerranéens, à deux pas de la place Bellecour. Agréable terrasse aux beaux jours."
    ],
    "es": [
      "La Brasserie Le Sud, uno de las 5 brasseries de Paul Bocuse, propone una cocina soleada de estilo mediterráneo, a escasos metros de la Place Bellecour. Agradable terraza en el buen tiempo."
    ],
    "nl": [
      "De Brasserie Le Sud, een van de vijf door Paul Bocuse ontworpen brasseries, biedt een zonnige keuken met mediterrane accenten, op een steenworp afstand van het Place Bellecour. Aangenaam terras bij mooi weer."
    ]
  },
