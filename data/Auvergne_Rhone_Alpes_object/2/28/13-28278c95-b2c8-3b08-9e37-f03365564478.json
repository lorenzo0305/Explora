  "rdfs:comment": {
    "de": [
      "Kennen Sie die Geheimnisse des Henri-Vinay-Gartens, der sich im Stadtzentrum von Le Puy-en-Velay befindet? Entdecken Sie die Geschichte dieses Parks auf einem informativen und unterhaltsamen Spaziergang, indem Sie dem spielerischen Orientierungsparcours folgen."
    ],
    "en": [
      "Do you know the secrets of the Henri Vinay garden in the center of Le Puy-en-Velay? Discover the history of this park on a fun and instructive stroll along the fun orientation trail."
    ],
    "it": [
      "Conoscete i segreti del giardino Henri Vinay nel centro di Le Puy-en-Velay? Scoprite la storia di questo parco con una passeggiata divertente e istruttiva lungo il percorso di orientamento."
    ],
    "fr": [
      "Connaissez-vous les secrets du jardin Henri Vinay situé en plein centre ville du Puy-en-Velay? Découvrez l'histoire de ce parc par une balade instructive et amusante en suivant le parcours d'orientation ludique."
    ],
    "es": [
      "¿Conoce los secretos del jardín Henri Vinay, en el centro de Le Puy-en-Velay? Descubra la historia de este parque en un paseo lúdico e informativo por el divertido sendero de orientación."
    ],
    "nl": [
      "Ken jij de geheimen van de Henri Vinay tuin in het centrum van Le Puy-en-Velay? Ontdek de geschiedenis van dit park tijdens een leuke en informatieve wandeling over het leuke oriëntatieparcours."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation ludique au Jardin Henri Vinay"
    ]
  },
