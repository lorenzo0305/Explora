  "rdfs:comment": {
    "de": [
      "Fahrradverleih auf dem grünen Weg \"Via Ardèche\" (ehemalige Eisenbahnstrecke) zwischen Vogué und Grospierres (25 km). Entdecken Sie unsere ultra-komfortablen Beach Cruiser, mit denen Sie sanft die wunderschönen Landschaften entdecken können, oder unsere Elektrofahrräder."
    ],
    "en": [
      "Bike hire on the \"Via Ardèche\" greenway (former railway line), between Vogué and Grospierres (25 km). Discover our ultra-comfortable beach cruiser bikes, for a gentle ride through magnificent landscapes, or our electric bikes."
    ],
    "it": [
      "Noleggio di biciclette sulla greenway \"Via Ardèche\" (ex linea ferroviaria), tra Vogué e Grospierres (25 km). Scoprite le nostre comodissime biciclette da spiaggia, per pedalare dolcemente attraverso paesaggi magnifici, o le nostre biciclette elettriche."
    ],
    "fr": [
      "Location de vélos sur la voie verte « Via Ardèche » (ancienne voie ferrée) , entre Vogué et Grospierres 25 km, découvrez nos vélos beach cruiser ultra confortables, pour découvrir en douceur de magnifiques paysages,ou, nos vélos électriques."
    ],
    "nl": [
      "Verhuur van fietsen op het fietspad \"Via Ardèche\" (de oude spoorweg), tussen Grospierres en Vogüé (25km). Kom het fietspad met zijn mooie landschappen ontdekken op een rustige manier."
    ],
    "es": [
      "Alquiler de bicicletas en la vía verde \"Via Ardèche\" (antigua línea de ferrocarril), entre Vogué y Grospierres (25 km). Descubra nuestras bicicletas beach cruiser ultracómodas, para un paseo suave a través de magníficos paisajes, o nuestras bicicletas eléctricas."
    ]
  },
  "rdfs:label": {
