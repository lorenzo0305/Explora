  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses internationale Treffen, das der Keramik als universelle Sprache zwischen den Kulturen gewidmet ist. Denn die Keramik gehört zu allen Gebieten. Und wenn sie geteilt wird, wird sie zu einer Sprache ohne Grenzen."
    ],
    "en": [
      "Come and discover this international event dedicated to ceramics as a universal language between cultures. Because ceramics belong to every land. And when it's shared, it becomes a language without borders."
    ],
    "it": [
      "Venite a scoprire questo evento internazionale dedicato alla ceramica come linguaggio universale tra le culture. Perché la ceramica appartiene a tutte le terre. E quando è condivisa, diventa un linguaggio senza confini."
    ],
    "fr": [
      "Venez découvrir ce rendez-vous international dédié à la céramique en tant que langage universel entre les cultures. Parce que la céramique appartient à tous les territoires. Et lorsqu'elle est partagée, elle devient un langage sans frontières."
    ],
    "es": [
      "Venga a descubrir este acontecimiento internacional dedicado a la cerámica como lenguaje universal entre culturas. Porque la cerámica pertenece a todas las tierras. Y cuando se comparte, se convierte en un lenguaje sin fronteras."
    ],
    "nl": [
      "Kom en ontdek dit internationale evenement gewijd aan keramiek als een universele taal tussen culturen. Want keramiek hoort bij elk land. En als het wordt gedeeld, wordt het een taal zonder grenzen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Céramique du monde"
    ]
  },
