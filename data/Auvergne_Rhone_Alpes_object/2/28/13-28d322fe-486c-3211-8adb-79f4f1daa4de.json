  "rdfs:comment": {
    "de": [
      "Produzent von Ziegen- und Schafskäse, ätherischen Ölen aus Lavendel und Lavandin, Walnüssen, Walnussöl, Konfitüren, Sirupen, Desserts und Keksen, Gerichten zum Mitnehmen, Gemüse, Seifen.\r\nFerme-Auberge und Catering-Service (auf Vorbestellung)."
    ],
    "en": [
      "Producers of goat and sheep cheese, lavender and lavendin essential oils, walnut, walnut oil, jams, syrups, desserts and biscuits, ready meals, vegetables and soaps.\r\nFerme-Auberge and catering service (by booking)."
    ],
    "it": [
      "Produttore di formaggi di capra e di pecora, oli essenziali di lavanda e lavandino, noci, olio di noci, marmellate, sciroppi, dolci e biscotti, cibo da asporto, verdure, sapone.\r\nAgriturismo e servizio di ristorazione (su prenotazione)."
    ],
    "fr": [
      "Producteur de fromages de chèvre et de brebis, huiles essentielles de lavande et lavandin, noix, huile de noix, confitures, sirops, desserts et biscuits, plats à emporter, légumes, savons.\r\nFerme-Auberge et service traiteur (sur réservation)."
    ],
    "es": [
      "Productor de queso de cabra y oveja, aceites esenciales de lavanda y lavandín, nueces, aceite de nuez, mermeladas, siropes, postres y galletas, comida para llevar, verduras, jabones.\r\nAgroturismo y servicio de catering (previa reserva)."
    ],
    "nl": [
      "Maker van geiten- en schapenkaas, etherische lavandin- en lavendelolie, walnoten, walnotenolie, jams, limonadesiroop, toetjes en koekjes, meeneemgerechten, groenten, zeep.\r\nFerme-auberge en traiteur (op reservering)."
    ]
  },
