  "rdfs:comment": {
    "de": [
      "Treffen Sie sich mit uns in einem außergewöhnlichen Rahmen, um eine aus regionalen Produkten zubereitete Küche zu genießen und von unserer Terrasse mit Panoramablick zu profitieren."
    ],
    "en": [
      "Come and meet us in an exceptional setting to share a cuisine made from local products and enjoy our terrace with a panoramic view."
    ],
    "it": [
      "Venite a trovarci in un ambiente eccezionale per condividere una cucina a base di prodotti locali e godere della nostra terrazza con vista panoramica."
    ],
    "fr": [
      "Venez nous retrouver dans un cadre exceptionnel pour partager une cuisine élaborée à partir de produits du terroir et profiter de notre terrasse avec vue panoramique."
    ],
    "es": [
      "Venga a conocernos en un marco excepcional para compartir una cocina elaborada con productos locales y disfrutar de nuestra terraza con vistas panorámicas."
    ],
    "nl": [
      "Kom ons ontmoeten in een uitzonderlijke omgeving om een keuken op basis van streekproducten te delen en te genieten van ons terras met een panoramisch uitzicht."
    ]
  },
