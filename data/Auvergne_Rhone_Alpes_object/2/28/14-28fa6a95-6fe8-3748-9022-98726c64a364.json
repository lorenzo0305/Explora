  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ec9a8c67-cb79-32fb-8829-c9cdf405ae66",
      "dc:description": {
        "de": [
          "Rendez-vous aux jardins am 7. und 8. Juni 2025 in Partnerschaft mit dem Preis für Exilliteratur Des racines et des mots (Wurzeln und Worte)\n\nAuf dem Programm stehen:\n- Begegnung und Lesungen an der Colonne de la Grande Armée\n- Literarische Workshops in der Confiserie"
        ],
        "en": [
          "Rendez-vous aux jardins on June 7 and 8, 2025 in partnership with the Des racines et des mots exile literature prize\n\nProgram:\n- Meetings and readings at the Colonne de la Grande Armée\n- Literary workshops at the Confiserie"
        ],
        "it": [
          "Appuntamento nei giardini il 7 e 8 giugno 2025 in collaborazione con il premio di letteratura dell'esilio Des racines et des mots\n\nIn programma:\n- Incontri e letture presso la Colonne de la Grande Armée\n- Laboratori letterari alla Confiserie"
        ],
        "fr": [
          "Rendez-vous aux jardins le 7 et 8 juin 2025 en partenariat avec le Prix de littérature de l'exil Des racines et des mots\n\nAu programme : \n- Rencontre et lectures à la Colonne de la Grande Armée\n- Ateliers littéraires à la Confiserie"
        ],
        "nl": [
          "Rendez-vous in de tuinen op 7 en 8 juni 2025 in samenwerking met de Des racines et des mots literatuurprijs in ballingschap\n\nOp het programma:\n- Ontmoetingen en lezingen in de Colonne de la Grande Armée\n- Literaire workshops in de Confiserie"
        ],
        "es": [
          "Cita en los jardines los días 7 y 8 de junio de 2025 en colaboración con el premio de literatura del exilio Des racines et des mots\n\nEn el programa:\n- Encuentros y lecturas en la Colonne de la Grande Armée\n- Talleres literarios en la Confiserie"
        ]
      },
