  "rdfs:comment": {
    "de": [
      "Das Hotel liegt inmitten eines großen Anwesens in der Nähe der Berge und empfängt Sie sowohl für Geschäftstreffen als auch für einen Aufenthalt mit der Familie. Dank der idealen Lage können Sie zu jeder Jahreszeit den Charme der Berge genießen und die frische Luft einatmen."
    ],
    "en": [
      "In the heart of a vast estate, close to the mountains, the hotel welcomes you for both business meetings and family holidays. Ideally located, you can enjoy the charms of the mountains and the fresh air, whatever the season."
    ],
    "it": [
      "Nel cuore di una vasta tenuta, vicino alle montagne, l'hotel vi accoglie sia per incontri di lavoro che per vacanze in famiglia. In una posizione ideale, potrete godere del fascino delle montagne e dell'aria fresca tutto l'anno."
    ],
    "fr": [
      "Au cœur d'un vaste domaine, à proximité des montagnes, l'hôtel vous accueille aussi bien pour des réunions d'affaires qu'un séjour en famille. Idéalement situé, vous pourrez profiter, en toute saison, des charmes de la montagne et respirer le grand air."
    ],
    "nl": [
      "In het hart van een uitgestrekt landgoed, dicht bij de bergen, verwelkomt het hotel je voor zowel zakelijke bijeenkomsten als familievakanties. Dankzij de ideale ligging kun je het hele jaar door genieten van de charmes van de bergen en de frisse lucht."
    ],
    "es": [
      "En el corazón de una vasta finca, cerca de las montañas, el hotel le da la bienvenida tanto para reuniones de negocios como para vacaciones en familia. Idealmente situado, podrá disfrutar de los encantos de la montaña y del aire puro durante todo el año."
    ]
  },
