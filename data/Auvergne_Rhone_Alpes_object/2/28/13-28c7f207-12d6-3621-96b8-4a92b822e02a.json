  "rdfs:comment": {
    "de": [
      "Das Reitzentrum bietet Ihnen eine Pension für Ihre Pferde (Boxen mit oder ohne Terrasse, automatische Führanlage...), sowie Reitunterricht, Praktika, Wettbewerbe und einen Pony Club."
    ],
    "en": [
      "The equestrian center offers a pension for your horses (box with or without terrace, automatic walker...), as well as riding lessons, courses, competitions and a pony Club."
    ],
    "it": [
      "Il centro ippico offre una pensione per i vostri cavalli (box con o senza terrazza, passeggiatore automatico...), oltre a lezioni di equitazione, corsi di addestramento, gare e un pony club."
    ],
    "fr": [
      "Le centre équestre vous propose une pension pour vos chevaux (box avec ou sans terrasse, marcheur automatique...), ainsi que des cours d'équitation, des stages, des compétitions et un poney Club."
    ],
    "es": [
      "El centro ecuestre ofrece alojamiento para sus caballos (box con o sin terraza, andador automático...), así como clases de equitación, cursos de formación, concursos y un pony club."
    ],
    "nl": [
      "De manege biedt stalling voor uw paarden (box met of zonder terras, automatische stapmolen...), maar ook paardrijlessen, trainingen, wedstrijden en een ponyclub."
    ]
  },
