  "rdfs:comment": {
    "de": [
      "9h-9h30 (Neun Uhr ? neuneinhalb Stunden) ? Coworking / Bürogemeinschaft im Zentrum von Dieulefit: ergonomische Arbeitsplätze, sehr schnelles Internet, gemeinsam genutzter Drucker, Küche, Terrasse und Sanitäranlagen. Autonomer Zugang 7/24."
    ],
    "en": [
      "9h-9h30 (Nine to nine and a half hours) ? Coworking / shared offices in the center of Dieulefit: ergonomic workstations, high-speed Internet, shared printer, kitchen, terrace and sanitary facilities. Independent access 7/24."
    ],
    "it": [
      "9.00-9.30 (Nove? Nove e mezza)? Coworking / uffici condivisi nel centro di Dieulefit: postazioni di lavoro ergonomiche, internet ad alta velocità, stampante condivisa, cucina, terrazza e servizi igienici. Accesso indipendente 7/24."
    ],
    "fr": [
      "9h-9h30 (Neuf heures – neuf heures et demie) – Coworking / bureaux partagés au centre de Dieulefit : postes de travail ergonomiques, Internet très haut débit, imprimante mutualisée, cuisine, terrasse et sanitaires. Accès autonome 7/24."
    ],
    "nl": [
      "9u-9u30 (Negen ? Halfnegen) ? Coworking / gedeelde kantoren in het centrum van Dieulefit: ergonomische werkplekken, snel internet, gedeelde printer, keuken, terras en toiletten. Onafhankelijke toegang 7/24."
    ],
    "es": [
      "9h-9h30 (Nueve ? Nueve y media) ? Coworking / oficinas compartidas en el centro de Dieulefit: puestos de trabajo ergonómicos, Internet de alta velocidad, impresora compartida, cocina, terraza y aseos. Acceso independiente 7/24."
    ]
