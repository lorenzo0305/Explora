  "rdfs:comment": {
    "de": [
      "Dylan bietet Halbtages-, Ganztages- und Kurzaufenthalte mit pädagogischen und spielerischen Zielen an und führt Sie in die umliegenden Berge. Tauchen Sie ein in ein regenerierendes Eintauchen in die Natur, das Ihre fünf Sinne vibrieren lässt."
    ],
    "en": [
      "Dylan offers 1/2-day, full-day and short-stay outings, with an educational and fun focus, and takes you on an encounter with the surrounding mountains. Immerse yourself in a rejuvenating outdoor experience that will stimulate all five senses."
    ],
    "it": [
      "Dylan offre gite di mezza giornata, di un'intera giornata e di breve durata che sono sia educative che divertenti e che vi porteranno a esplorare le montagne circostanti. Immergetevi in un'esperienza rigenerante all'aria aperta che stimolerà tutti i cinque sensi."
    ],
    "fr": [
      "Dylan propose des sorties en 1/2 journée, journée ou des courts séjours, à but pédagogique et ludique et vous emmène à la rencontre des montagnes environnantes. Plongez dans une immersion pleine nature régénératrice, qui fera vibrer vos cinq sens."
    ],
    "es": [
      "Dylan ofrece excursiones de medio día, de día completo y de corta duración que son a la vez educativas y divertidas, y le llevan a explorar las montañas circundantes. Sumérjase en una experiencia rejuvenecedora al aire libre que estimulará los cinco sentidos."
    ],
    "nl": [
      "Dylan biedt uitstapjes van een halve of een hele dag of een kort verblijf die zowel leerzaam als leuk zijn en je meenemen op een verkenningstocht door de omliggende bergen. Dompel jezelf onder in een verjongende buitenervaring die alle vijf zintuigen stimuleert."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dylan Fournier - Acc. Immersion Montagne nature"
    ]
  },
