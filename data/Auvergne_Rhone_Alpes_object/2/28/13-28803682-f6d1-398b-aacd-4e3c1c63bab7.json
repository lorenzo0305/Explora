  "rdfs:comment": {
    "de": [
      "\"Das Kino Le Paris empfängt Sie in seinen zwei Sälen (266 und 96 Plätze), die dank eines Aufzugs auch für Personen mit eingeschränkter Mobilität zugänglich sind."
    ],
    "en": [
      "\"The Paris cinema welcomes you to its two auditoriums (266 and 96 seats) accessible to PRM thanks to the installation of an elevator."
    ],
    "it": [
      "\"Il cinema di Parigi ha due sale (266 e 96 posti) accessibili alle PRM grazie a un ascensore."
    ],
    "fr": [
      "« Le cinéma le Paris vous accueille dans ses deux salles (266 et 96 places) accessibles aux PMR grâce à l’implantation d’un ascenseur."
    ],
    "nl": [
      "\"De Parijse bioscoop heeft twee zalen (266 en 96 stoelen) die toegankelijk zijn voor PBM dankzij een lift."
    ],
    "es": [
      "\" El cine París dispone de dos salas (266 y 96 butacas) accesibles a las PMR gracias a un ascensor."
    ]
