  "rdfs:comment": {
    "de": [
      "Ateliers de Danse Libre et Intuitive sind Workshops für alle Altersgruppen, die spielerisch, leicht zugänglich und kreativ sind. Fantasie, Wahrnehmung und Bewegung verschmelzen zu einer Einheit!"
    ],
    "en": [
      "Ateliers de Danse Libre et Intuitive are fun, accessible and creative workshops for all ages. Imagination, perception and movement come together as one!"
    ],
    "it": [
      "Gli Ateliers de Danse Libre et Intuitive sono laboratori divertenti, accessibili e creativi per tutti. Immaginazione, percezione e movimento si fondono insieme!"
    ],
    "fr": [
      "Ateliers de Danse Libre et Intuitive sont des ateliers tout public, ludiques, faciles d'accès et créatifs. L'imagination, la perception, et le mouvement se mêlent pour ne faire qu'un !"
    ],
    "es": [
      "Los Ateliers de Danse Libre et Intuitive son talleres lúdicos, accesibles y creativos para todos. Imaginación, percepción y movimiento se unen en uno"
    ],
    "nl": [
      "Ateliers de Danse Libre et Intuitive zijn leuke, toegankelijke en creatieve workshops voor iedereen. Verbeelding, perceptie en beweging komen samen als één!"
