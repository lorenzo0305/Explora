      "dc:description": {
        "de": [
          "Le Bras De Brosne ist eine 33 km lange Strecke für Radwanderer.\nHöhenunterschied: 10 bis 170 m | Schwierigkeitsgrad: hoch | 2h45"
        ],
        "en": [
          "The Bras De Brosne is a 33km trail for cycling enthusiasts.\nVertical drop: 10 to 170m | Difficulty: high | 2h45"
        ],
        "it": [
          "Il Bras De Brosne è un percorso di 33 km per gli appassionati di ciclismo.\nDislivello: da 10 a 170 m | Difficoltà: elevata | 2h45"
        ],
        "fr": [
          "Le Bras De Brosne est un parcours de 33km pour les amateurs de Cyclotourisme.\nDénivelé : 10 à 170m | Difficulté : élevée | 2h45"
        ],
        "es": [
          "El Bras De Brosne es una ruta de 33 km para los amantes del ciclismo.\nDesnivel: de 10 a 170 m | Dificultad: alta | 2h45"
        ],
        "nl": [
          "De Bras De Brosne is een 33 km lange route voor fietsliefhebbers.\nHoogteverschil: 10 tot 170m | Moeilijkheidsgraad: hoog | 2u45"
