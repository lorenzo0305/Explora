  "rdfs:comment": {
    "de": [
      "Probieren Sie auf der Terrasse: Schiefertafel des Wanderers, Bauernsalat, Teller vom Bauernhof, Aperitif-Brett...\r\nUnd dazu: lokale Fruchtsäfte, Bier aus dem Mont-Blanc oder auch Gläser mit Milch vom Bauernhof!"
    ],
    "en": [
      "Come and enjoy our terrace with delicious options like the Hiker’s Slate, Farmer’s Salad, Farm Platter, or Apéritif Board.\r\nTo accompany your meal, we offer local fruit juices, Mont-Blanc beer, or glasses of fresh farm milk!"
    ],
    "it": [
      "Venite a gustare sulla terrazza: Ardoise du randonneur, Salade paysanne, Assiette de la ferme, Planche apéro...\r\nE per accompagnare il tutto: succhi di frutta locali, birra del Monte Bianco o bicchieri di latte della fattoria!"
    ],
    "fr": [
      "Venez déguster en terrasse : Ardoise du randonneur, Salade paysanne, Assiette de la ferme, Planche apéro...\r\nEt pour accompagner cela : des jus de fruits locaux, de la bière du Mont-Blanc ou encore des verres de lait de la ferme !"
    ],
    "es": [
      "Venga a degustar en la terraza: Ardoise du randonneur, Salade paysanne, Assiette de la ferme, Planche apéro...\r\nY para acompañarlo todo: ¡zumos de frutas locales, cerveza Mont-Blanc o vasos de leche de la granja!"
    ],
    "nl": [
      "Kom genieten op ons terras met heerlijke opties zoals de Wandelaarsleien, Boerensalade, Boerderijplank of Borrelplank.\r\nOm dit te begeleiden serveren we lokale vruchtensappen, Mont-Blanc bier of glazen verse boerderijmelk!"
    ]
  },
  "rdfs:label": {
    "en": [
      "The Restaurant of the Seraussaix Farm"
    ],
    "fr": [
      "Le Restaurant de la Ferme de Seraussaix"
    ],
    "nl": [
      "Het restaurant van de Seraussaix-boerderij"
    ]
  },
