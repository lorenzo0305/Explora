  "rdfs:comment": {
    "de": [
      "Lust auf Thailand? 2 verschiedene Menüs pro Woche, die mit frischen (außer Garnelen) und gesunden Produkten zubereitet werden, die jeden Morgen frisch eingekauft werden.  Nur zum Mitnehmen."
    ],
    "en": [
      "Fancy a trip to Thailand? Two different menus each week, cooked with fresh (except prawns) and healthy ingredients, bought every morning. Takeaway only!"
    ],
    "it": [
      "Voglia di un viaggio in Thailandia? 2 menu diversi ogni settimana cucinati con prodotti freschi (tranne i gamberi) e sani, acquistati ogni mattina.  Solo da asporto."
    ],
    "fr": [
      "Envie de partir en Thaïlande? 2 menus différents chaque semaine cuisinés avec des produits frais (sauf crevettes) et sains, achetés chaque matin.  A emporter uniquement."
    ],
    "es": [
      "¿Te apetece un viaje a Tailandia? 2 menús diferentes cada semana cocinados con productos frescos (excepto gambas) y sanos, comprados cada mañana.  Sólo para llevar."
    ],
    "nl": [
      "Zin in een reis naar Thailand? Elke week 2 verschillende menu's bereid met verse (behalve garnalen) en gezonde producten, elke ochtend ingekocht.  Alleen afhaalmaaltijden."
    ]
  },
