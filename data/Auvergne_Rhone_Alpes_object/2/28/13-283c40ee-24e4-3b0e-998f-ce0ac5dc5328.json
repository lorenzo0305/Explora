  "rdfs:comment": {
    "de": [
      "1909 Escape Game bietet Ihnen 5 Räume für ein Escape Game im Stadtzentrum von Saint-Etienne. Sie werden in Gruppen von 3 bis 6 Personen in einem Raum eingesperrt und müssen Rätsel lösen, um zu entkommen Werden Sie die Herausforderung annehmen können?"
    ],
    "en": [
      "1909 Escape Game is a life-size escape game. Locked into a room in a group of 3 to 6 people, your goal will be solve the puzzles so that you can get out of the room in a given time."
    ],
    "it": [
      "1909 Escape Game offre 5 sale di fuga nel centro di Saint-Etienne. Rinchiusi in una stanza in gruppi da 3 a 6 persone, il vostro obiettivo sarà quello di risolvere gli enigmi per fuggire! Riuscirete a vincere la sfida?"
    ],
    "fr": [
      "1909 Escape Game vous propose 5 salles d'Escape Game en centre-ville de Saint-Etienne. Enfermés dans une pièce par groupe de 3 à 6 personnes, votre objectif sera de résoudre des énigmes afin de vous échapper ! Saurez vous relever le défi ?"
    ],
    "es": [
      "1909 Escape Game ofrece 5 salas de Escape Game en el centro de Saint-Etienne. Encerrados en una habitación en grupos de 3 a 6 personas, su objetivo será resolver los enigmas para poder escapar ¿Podrá superar el reto?"
    ],
    "nl": [
      "1909 Escape Game biedt 5 Escape Game kamers in het centrum van Saint-Etienne. Opgesloten in een kamer in groepen van 3 tot 6 personen, is jullie doel de raadsels op te lossen om te ontsnappen! Kunnen jullie de uitdaging aan?"
    ]
  },
