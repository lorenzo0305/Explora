  "rdfs:comment": {
    "de": [
      "Das Freti wurde 1974 gegründet und ist ein Käsespezialitätenrestaurant.\r\nFondues, Raclettes, Käsegerichte, Verkostung von lokalen, französischen und vielen anderen Käsesorten.\r\nEine gastronomische Reise ins Herz des Käses."
    ],
    "en": [
      "Created in 1974, Freti is a restaurant specialising in cheese.\r\nFondues, raclettes, cheese dishes, tastings of local and French cheeses and much more.\r\nA gastronomic journey to the heart of cheese."
    ],
    "it": [
      "Creato nel 1974, Freti è un ristorante specializzato in formaggi.\r\nFondute, raclettes, piatti a base di formaggio, degustazione di formaggi locali e francesi e molto altro ancora.\r\nUn viaggio gastronomico nel cuore del formaggio."
    ],
    "fr": [
      "Créé en 1974, le Freti est un restaurant de spécialités fromagères.\r\nFondues, raclettes, plats fromagers, dégustation de fromages affinés.\r\nUn voyage gastronomique au cœur du fromage."
    ],
    "nl": [
      "Freti, opgericht in 1974, is een restaurant dat gespecialiseerd is in kaas.\r\nFondues, raclettes, kaasgerechten en proeverijen van gerijpte kazen.\r\nEen gastronomische reis naar het hart van de kaas."
    ],
    "es": [
      "Creado en 1974, Freti es un restaurante especializado en quesos.\r\nFondues, raclettes, platos de queso y degustaciones de quesos curados.\r\nUn viaje gastronómico al corazón del queso."
    ]
  },
