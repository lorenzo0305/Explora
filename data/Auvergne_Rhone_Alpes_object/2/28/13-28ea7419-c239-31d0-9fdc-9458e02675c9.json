  "rdfs:comment": {
    "de": [
      "Konditorei, Viennoiserie und Wiener Brot auf Bestellung, je nach Saison und Lust und Laune.\r\nTeestube und kleine Snacks auf der Terrasse, wenn das Wetter es zulässt."
    ],
    "en": [
      "Patisserie, Viennese pastries and bread to order, depending on the season and your tastes.\r\nTearoom and snack bar on the terrace, weather permitting."
    ],
    "it": [
      "Pasticceria, dolci viennesi e pane su ordinazione, a seconda della stagione e dei vostri gusti.\r\nSala da tè e snack bar sulla terrazza, tempo permettendo."
    ],
    "fr": [
      "Pâtisserie, viennoiserie et pain viennois sur commande, au gré des saisons et de vos envies.\r\nSalon de thé et petite restauration en terrasse, si la météo le permet."
    ],
    "nl": [
      "Patisserie, Weens gebak en brood op bestelling, afhankelijk van het seizoen en je smaak.\r\nTearoom en snackbar op het terras, als het weer het toelaat."
    ],
    "es": [
      "Pastelería, bollería y pan por encargo, según la temporada y sus gustos.\r\nSalón de té y snack bar en la terraza, si el tiempo lo permite."
    ]
  },
