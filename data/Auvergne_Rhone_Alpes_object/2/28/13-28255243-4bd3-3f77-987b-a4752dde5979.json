  "rdfs:comment": {
    "de": [
      "Le Petit Refuge und La Cabane du Refuge liegen im Herzen der Pisten und bieten jeweils ein geselliges Gourmet-Erlebnis in den Bergen."
    ],
    "en": [
      "Located at the heart of the slopes, Le Petit Refuge and La Cabane du Refuge each offer a gourmet and convivial experience in the mountains."
    ],
    "it": [
      "Situati nel cuore delle piste, Le Petit Refuge e La Cabane du Refuge offrono entrambi un'esperienza gastronomica e conviviale in montagna."
    ],
    "fr": [
      "Situés au cœur des pistes, Le Petit Refuge et La Cabane du Refuge offrent chacun une expérience gourmande et conviviale en montagne."
    ],
    "es": [
      "Situados en el corazón de las pistas, Le Petit Refuge y La Cabane du Refuge ofrecen una experiencia gastronómica y acogedora en la montaña."
    ],
