  "rdfs:comment": {
    "de": [
      "100 % hausgemachte Gourmetküche mit frischen Produkten aus der Region. Träger des Labels „Maître Restaurateur”, im Sommer und Winter geöffnet, um unsere Gäste zu verwöhnen. Das gewisse Extra: Panoramablick auf die Berge vom Innenbereich und von der Terrasse aus."
    ],
    "en": [
      "100% homemade gourmet cuisine made with fresh, local produce. Holder of the ‘Maitre Restaurateur’ label, open summer and winter to delight our customers. Added bonus: panoramic views of the mountains from inside and from the terrace."
    ],
    "it": [
      "Cucina gourmet 100% casalinga con prodotti freschi e locali. Titolare del marchio \"Maitre Restaurateur\", aperto estate e inverno per deliziare i nostri clienti. Un piccolo extra: una vista panoramica sulle montagne dall'interno e dalla terrazza."
    ],
    "fr": [
      "Cuisine gastronomique 100% faite maison à base de produits frais & locaux. Titulaire du label de \"Maitre Restaurateur\", ouvert été & hiver afin de ravir notre clientèle. Petit plus: une vue panoramique sur les montagnes de l'intérieur et de la Terrasse."
    ],
    "es": [
      "Cocina gastronómica 100% casera elaborada con productos frescos y locales. Poseedor de la etiqueta \"Maitre Restaurateur\", abierto verano e invierno para deleitar a nuestros clientes. Un pequeño extra: una vista panorámica de las montañas desde el interior y desde la terraza."
    ],
    "nl": [
      "100% huisgemaakte gastronomische keuken met verse, lokale producten. Houder van het label \"Maitre Restaurateur\", zomer en winter geopend om onze klanten te verwennen. Een extraatje: een panoramisch uitzicht op de bergen van binnen en vanaf het terras."
    ]
  },
