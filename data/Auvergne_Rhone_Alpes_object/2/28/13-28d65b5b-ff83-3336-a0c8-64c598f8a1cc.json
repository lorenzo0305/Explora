  "rdfs:comment": {
    "de": [
      "Feine Schokoladen, Tafeln aus reiner Herkunft, Eiscreme. Alle unsere Produkte werden hausgemacht und aus biologischen Zutaten hergestellt. Süßes und salziges Mürbegebäck, Brioches, Marmeladen, Fladenbrot."
    ],
    "en": [
      "Fine chocolates, pure-origin bars, ice creams. All our products are home-made with organic ingredients. Sweet and savoury shortbreads, brioches, jams, galettes."
    ],
    "it": [
      "Cioccolatini pregiati, barrette di pura origine, gelati. Tutti i nostri prodotti sono fatti in casa con ingredienti biologici. Frollini dolci e salati, brioches, marmellate, galettes."
    ],
    "fr": [
      "Chocolats fins, tablettes pures origines, glaces. Tous nos produits sont fabriqués maison à base de produits biologiques. Sablés salés, sucrés, brioches, confitures, galettes."
    ],
    "nl": [
      "Fijne chocolaatjes, repen van pure herkomst, ijsjes. Al onze producten zijn huisgemaakt met biologische ingrediënten. Zoet en hartig zandkoekjes, brioches, jam, galettes."
    ],
    "es": [
      "Chocolates finos, barras de origen puro, helados. Todos nuestros productos son caseros y se elaboran con ingredientes ecológicos. Galletas dulces y saladas, brioches, mermeladas, galettes."
    ]
  },
