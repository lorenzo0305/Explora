  "rdfs:comment": {
    "de": [
      "Vom Anfänger bis zum Fortgeschrittenen und unabhängig von Ihrem Alter bietet Ihnen die ESF Val Cenis Termignon eine große Auswahl an Disziplinen, damit Sie den richtigen Kurs für sich finden."
    ],
    "en": [
      "From beginner to advanced, whatever your age, ESF Val Cenis Termignon offers you a wide choice of disciplines to find the lesson that's right for you."
    ],
    "it": [
      "Dal principiante all'avanzato, qualunque sia la vostra età, ESF Val Cenis Termignon vi offre un'ampia scelta di discipline per trovare la lezione più adatta a voi."
    ],
    "fr": [
      "De débutant à confirmé, quel que soit votre âge, l'ESF Val Cenis Termignon vous propose un large choix de disciplines pour trouver le cours qui vous correspond."
    ],
    "nl": [
      "Van beginner tot gevorderde, wat je leeftijd ook is, ESF Val Cenis Termignon biedt je een ruime keuze aan disciplines om de les te vinden die bij je past."
    ],
    "es": [
      "De principiante a avanzado, sea cual sea tu edad, ESF Val Cenis Termignon te ofrece una amplia selección de disciplinas para que encuentres la clase que mejor se adapta a ti."
    ]
  },
