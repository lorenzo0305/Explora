  "rdfs:comment": {
    "de": [
      "Im Herzen von Annecy bietet Ihnen Kanlaya traditionelle thailändische Massagen an. Öl-, Fuß- und Rückenmassage sowie die traditionelle Bo Rarn-Massage des Wat Po. Allein oder im Duo. Online-Reservierung. Im Einklang mit der uralten Tradition. Absolventinnen des Wat Po."
    ],
    "en": [
      "In the heart of Annecy, Kanlaya offers you traditional Thai massages. Oil massage, feet, back and traditional Bo Rarn of Wat Po. Alone or in Duo. Online booking. In the respect of the ancestral tradition. Graduates of Wat Po."
    ],
    "it": [
      "Scoprite l'arte del massaggio tradizionale tailandese nel cuore di Annecy. Al Kanlaya, immergetevi in un'esperienza autentica con i nostri massaggi tradizionali thailandesi. Da soli o in coppia, regalatevi un momento di relax e benessere."
    ],
    "fr": [
      "Découvrez l’art du massage thaïlandais traditionnel au cœur d’Annecy. Chez Kanlaya, plongez dans une expérience authentique avec nos massages traditionnels thaïlandais . En solo ou en duo, offrez-vous un moment de détente et de bien-être."
    ],
    "nl": [
      "Ontdek de kunst van traditionele Thaise massage in het hart van Annecy. Bij Kanlaya kun je jezelf onderdompelen in een authentieke ervaring met onze traditionele Thaise massages. Alleen of met een partner, trakteer jezelf op een moment van ontspanning en welzijn."
    ],
    "es": [
      "Descubra el arte del masaje tradicional tailandés en el corazón de Annecy. En Kanlaya, sumérjase en una experiencia auténtica con nuestros masajes tradicionales tailandeses. Solo o en pareja, regálese un momento de relajación y bienestar."
    ]
  },
