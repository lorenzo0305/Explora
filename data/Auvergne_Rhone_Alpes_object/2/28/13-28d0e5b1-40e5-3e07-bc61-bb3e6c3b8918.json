  "rdfs:comment": {
    "de": [
      "Nur 15 Minuten vom Dorf Saint-Jean-de-Belleville in der Tarentaise entfernt liegt das Refuge Plan Lombardie auf 1764 m Höhe im Herzen eines unberührten und wilden Tals am Fuße des majestätischen Cheval Noir."
    ],
    "en": [
      "Only 15 minutes from the village of Saint-Jean-de-Belleville, Refuge Plan Lombardy is perched at 1 764 m high in the heart of a valley still virgin and wild, at the foot of the majestic Black Horse.\r\nWe welcome you to experience the night in a refuge, take a meal break or organize an event (birthday, family meal etc ..)."
    ],
    "it": [
      "A soli 15 minuti dal villaggio di Saint-Jean-de-Belleville, nella regione della Tarentaise, il Rifugio Plan Lombardie si trova a 1.764 m di altitudine, nel cuore di una valle selvaggia e incontaminata, ai piedi del maestoso Cheval Noir."
    ],
    "fr": [
      "A seulement 15 minutes du village de Saint-Jean-de-Belleville en Tarentaise, le Refuge Plan Lombardie est perché à 1 764 m d’altitude au cœur d’un vallon encore vierge et sauvage, au pied du majestueux Cheval Noir."
    ],
    "nl": [
      "Op slechts 15 minuten van het dorp Saint-Jean-de-Belleville in de Tarentaise ligt de Refuge Plan Lombardie op een hoogte van 1.764 m in het hart van een wilde, ongerepte vallei aan de voet van de majestueuze Cheval Noir."
    ],
    "es": [
      "A sólo 15 minutos del pueblo de Saint-Jean-de-Belleville, en la región de Tarentaise, el refugio de Plan Lombardie se alza a 1.764 m de altitud en el corazón de un valle salvaje y virgen, a los pies del majestuoso Cheval Noir."
    ]
  },
  "rdfs:label": {
