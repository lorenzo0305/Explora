  "rdfs:comment": {
    "de": [
      "Im Herzen von Valence gelegen, empfängt Sie das Café Victor Hugo zu einem Drink oder Abendessen in einem herrlichen, typischen Art-Déco-Ambiente... und genießen Sie an sonnigen Tagen ein bisschen Sonne auf den beiden Außenterrassen..."
    ],
    "en": [
      "Located in the heart of Valence, the Victor Hugo café welcomes you for a drink or dinner in a superb, typically Art Deco setting... and enjoy a bit of sunshine on the two outdoor terraces on sunny days..."
    ],
    "it": [
      "Il Café Victor Hugo, emblematica brasserie di Valence, vi accoglie in un'atmosfera amichevole che unisce tradizione ed eleganza. Il luogo ideale per un pranzo, un aperitivo con gli amici o una cena rilassata."
    ],
    "fr": [
      "Le Café Victor Hugo, brasserie emblématique à Valence, vous accueille dans une ambiance conviviale alliant tradition et élégance. Lieu idéal pour un déjeuner, un apéritif entre amis ou un dîner détendu."
    ],
    "es": [
      "El Café Victor Hugo, brasserie emblemática de Valence, le da la bienvenida en un ambiente acogedor que combina tradición y elegancia. El lugar ideal para el almuerzo, un aperitivo con amigos o una cena relajada."
    ],
    "nl": [
      "Café Victor Hugo ligt in het hart van Valence en verwelkomt u voor een drankje of diner in een prachtig, typisch Art Deco decor ... en op zonnige dagen kunt u genieten van een plekje in de zon op de twee buitenterrassen ..."
    ]
  },
