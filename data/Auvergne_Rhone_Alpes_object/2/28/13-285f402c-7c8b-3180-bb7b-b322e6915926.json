  "rdfs:comment": {
    "de": [
      "In Presles betreibt Igor auf 4000 m² Bio-Gemüseanbau. Direktverkauf ab Hof: Gemüse, Eier und verarbeitete Produkte."
    ],
    "en": [
      "In Presles, Igor cultivates 4,000 m² of organic market garden. Direct farm sales: vegetables, eggs and processed products."
    ],
    "it": [
      "A Presles, Igor coltiva prodotti biologici da orto su 4.000 m². Vendita diretta in azienda: verdure, uova e prodotti trasformati."
    ],
    "fr": [
      "À Presles, Igor cultive en maraîchage bio sur 4 000 m². Vente directe à la ferme : légumes, œufs et produits transformés."
    ],
