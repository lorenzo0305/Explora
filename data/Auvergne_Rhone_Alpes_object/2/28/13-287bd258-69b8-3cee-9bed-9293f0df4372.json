  "rdfs:comment": {
    "de": [
      "Roselyne hat ein Diplom in Bildender Kunst; sie leitet Kurse und Praktika für Kinder und Erwachsene im Rahmen des Vereins \"Atelier d'Ar\", der sich die Förderung von Kunst und Kultur in ländlichen Gebieten zum Ziel gesetzt hat."
    ],
    "en": [
      "Roselyne has a degree in plastic arts; she runs courses and workshops for children and adults in the framework of the association \"Atelier d'Ar\" which aims to promote art and culture in rural areas."
    ],
    "it": [
      "Roselyne è diplomata in arti plastiche; tiene corsi e laboratori per bambini e adulti nell'ambito dell'associazione \"Atelier d'Ar\", che mira a promuovere l'arte e la cultura nelle zone rurali."
    ],
    "fr": [
      "Roselyne est diplômée en arts plastiques ; elle anime des cours et stages pour enfants et adultes dans le cadre de l'association \"Atelier d'Ar\" qui a pour but la promotion de l'art et de la culture en milieu rural."
    ],
    "nl": [
      "Roselyne heeft een diploma plastische kunsten; zij geeft cursussen en workshops voor kinderen en volwassenen in het kader van de vereniging \"Atelier d'Ar\" die tot doel heeft kunst en cultuur op het platteland te bevorderen."
    ],
    "es": [
      "Roselyne es diplomada en artes plásticas; dirige cursos y talleres para niños y adultos en el marco de la asociación \"Atelier d'Ar\", cuyo objetivo es promover el arte y la cultura en las zonas rurales."
    ]
  },
  "rdfs:label": {
