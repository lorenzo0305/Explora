  "rdfs:comment": {
    "de": [
      "Fossilea ist das neue Interpretationszentrum des Geoparks Beaujolais. Es soll das Naturerbe der Region aufwerten, indem es einen pädagogischen und leidenschaftlichen Blick auf die Geologie, Archäologie, Paläontologie und Botanik bietet."
    ],
    "en": [
      "Fossilea is the Beaujolais Geopark's new interpretation centre. It aims to promote the region's natural heritage by offering an educational and enthusiastic look at geology, archaeology, palaeontology and botany."
    ],
    "it": [
      "Fossilea è il nuovo centro di interpretazione del Beaujolais Geopark. Il suo obiettivo è quello di promuovere il patrimonio naturale della regione offrendo uno sguardo educativo ed entusiasta sulla geologia, l'archeologia, la paleontologia e la botanica."
    ],
    "fr": [
      "Fossilea est le nouveau centre d'interprétation du Géoparc Beaujolais. Il vise à valoriser le patrimoine naturel du territoire en offrant un regard pédagogique et passionné sur la géologie, l’archéologie, la paléontologie et la botanique."
    ],
    "nl": [
      "Fossilea is het nieuwe interpretatiecentrum van het Beaujolais Geopark. Het doel is om het natuurlijke erfgoed van de regio te promoten door een educatieve en enthousiaste kijk te bieden op geologie, archeologie, paleontologie en plantkunde."
    ],
    "es": [
      "Fossilea es el nuevo centro de interpretación del Geoparque del Beaujolais. Su objetivo es promover el patrimonio natural de la región ofreciendo una mirada pedagógica y entusiasta sobre la geología, la arqueología, la paleontología y la botánica."
    ]
  },
