  "rdfs:comment": {
    "de": [
      "Die Bergführer führen Sie im Winter und Sommer in Skitouren, Tiefschneefahren, Eisklettern, Splitboarding, Klettern, Klettersteige, Bergsteigen und Canyoning in den französischen und schweizerischen Alpen ein und betreuen Sie."
    ],
    "en": [
      "Our mountain guides offer winter and summer instruction in ski touring, off-piste skiing, ice climbing, splitboarding, climbing, via ferrata, mountaineering and canyoning in the French and Swiss Alps."
    ],
    "it": [
      "Le nostre guide alpine d'alta quota offrono corsi invernali ed estivi di sci alpinismo, sci fuori pista, arrampicata su ghiaccio e splitboard, nonché di arrampicata, via ferrata, alpinismo e canyoning nelle Alpi francesi e svizzere."
    ],
    "fr": [
      "Les guides de haute-montagne vous initient et vous encadrent en hiver et en été: ski de randonnée, ski hors-piste, cascade de glace, splitboard ainsi qu'escalade, via ferrata, alpinisme et canyoning dans les Alpes Françaises et Suisses."
    ],
    "nl": [
      "Onze berggidsen op grote hoogte bieden winter- en zomercursussen in toerskiën, off-piste skiën, ijsklimmen en splitboarden, maar ook klimmen, via ferrata, alpinisme en canyoning in de Franse en Zwitserse Alpen."
    ],
    "es": [
      "Nuestros guías de alta montaña ofrecen cursos de invierno y verano de esquí de travesía, esquí fuera de pista, escalada en hielo y splitboard, así como escalada, vías ferratas, alpinismo y barranquismo en los Alpes franceses y suizos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guide Bureau - Châtel - Val d'Abondance"
    ],
    "fr": [
      "Bureau des Guides - Châtel - Val d'Abondance"
    ],
    "nl": [
      "Berggidsen bureau - Châtel Abondance Vallei"
    ]
  },
