  "rdfs:comment": {
    "de": [
      "Meine Aufgabe wird es sein, Sie bei Ihren Projekten zum Kauf und Verkauf von Immobilien in der Gegend von Nyonsais und seinem Hinterland zu begleiten."
    ],
    "en": [
      "My mission will be to accompany you in your real estate purchase or sale projects in the area of Nyons and its hinterland."
    ],
    "it": [
      "La mia missione sarà quella di accompagnarvi nei vostri progetti di compravendita immobiliare nel territorio nionese e nel suo hinterland."
    ],
    "fr": [
      "Ma mission sera de vous accompagner dans vos projets d'achat-vente immobiliers sur le secteur du Nyonsais et de son arrière pays."
    ],
    "nl": [
      "Mijn missie is om je te helpen met je projecten voor de aankoop en verkoop van onroerend goed in de omgeving van Nyonsais en het achterland."
    ],
