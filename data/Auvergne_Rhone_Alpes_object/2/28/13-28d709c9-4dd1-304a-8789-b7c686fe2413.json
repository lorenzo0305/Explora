  "rdfs:comment": {
    "de": [
      "Entdecken Sie im Wald, im Herzen der Cheire de Tournebise, die ehemaligen Käsekeller von Saint-Pierre-le-Chastel, wo fast ein Jahrhundert lang der Blauschimmelkäse „Bleu de Laqueuille“ gereift ist. Ein Wanderweg verbindet diesen Ort mit dem ehemaligen Weiler Les Chazaloux."
    ],
    "en": [
      "In the forest, in the heart of the Tournebise valley, discover the site of the old cheese cellars of Saint-Pierre-le-Chastel, where Laqueuille blue cheese was matured for nearly a century. A footpath connects the site to the old hamlet of Les Chazaloux."
    ],
    "it": [
      "Nella foresta, nel cuore della Tournebise cheire, scoprite il sito delle antiche cantine di Saint-Pierre-le-Chastel, dove il formaggio Bleu de Laqueuille è stato stagionato per quasi un secolo. Un sentiero pedonale collega il sito all'antico borgo di Chazaloux."
    ],
    "fr": [
      "En forêt, au cœur de la cheire de Tournebise, découvrez le site des anciennes caves à fromage de Saint-Pierre-le-Chastel où pendant près d’un siècle, on affinait du bleu de Laqueuille. Un sentier pédestre relie l'endroit à l'ancien hameau des Chazaloux."
    ],
    "nl": [
      "Ontdek in het bos, in het hart van de Tournebise cheire, de oude kaaskelders van Saint-Pierre-le-Chastel, waar de Bleu de Laqueuille bijna een eeuw lang gerijpt werd. Een wandelpad verbindt de site met het vroegere gehucht Chazaloux."
    ],
    "es": [
      "En el bosque, en el corazón de la Tournebise cheire, descubra el emplazamiento de las antiguas queserías de Saint-Pierre-le-Chastel, donde se maduró el queso Bleu de Laqueuille durante casi un siglo. Un sendero une el lugar con la antigua aldea de Chazaloux."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Anciennes caves d'affinage du bleu de Laqueuille"
    ]
  },
