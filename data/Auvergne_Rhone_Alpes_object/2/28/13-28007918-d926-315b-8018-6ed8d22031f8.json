  "rdfs:comment": {
    "de": [
      "Ihr neues Bar-Restaurant Le Royal empfängt Sie nur wenige Schritte von der Präfektur entfernt und bietet Ihnen eine einfache Speisekarte, die aus frischen Produkten zusammengestellt wird.\r\nEine qualitativ hochwertige Küche mit Gerichten der französisch-armenischen Küche, die vollständig hausgemacht sind."
    ],
    "en": [
      "Your new bar-restaurant, Le Royal, just a stone's throw from the prefecture, offers a simple menu based on fresh produce.\r\nQuality cuisine, with French-Armenian dishes made entirely in-house."
    ],
    "it": [
      "Il vostro nuovo bar-ristorante, Le Royal, si trova a due passi dalla prefettura e propone un menu semplice a base di prodotti freschi.\r\nUna cucina di qualità, con piatti franco-armeni realizzati interamente in casa."
    ],
    "fr": [
      "Votre nouveau bar-restaurant le Royal vous accueille à deux pas de la préfecture et vous propose une carte simple confectionnée à base de produits frais.\r\nUne cuisine de qualité, avec des plats de cuisine franco-arménienne, entièrement réalisés maison."
    ],
    "es": [
      "Su nuevo bar-restaurante, Le Royal, está a dos pasos de la prefectura y ofrece una carta sencilla basada en productos frescos.\r\nCocina de calidad, con platos franco-armenios elaborados íntegramente en casa."
    ],
    "nl": [
      "Je nieuwe bar-restaurant Le Royal ligt op een steenworp afstand van de prefectuur en biedt een eenvoudig menu op basis van verse producten.\r\nEen kwaliteitskeuken, met Frans-Armeense gerechten die volledig in huis worden bereid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar-Restaurant Le Royal"
    ]
  },
