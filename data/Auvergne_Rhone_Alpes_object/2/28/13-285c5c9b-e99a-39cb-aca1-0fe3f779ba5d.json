  "rdfs:comment": {
    "de": [
      "Anthony und Quentin, langjährige Freunde, begrüßen Sie auf ihrem kleinen Weingut, das aus den besten Lagen des Weinbaugebiets Saint-Pourçain stammt, wo die Weine zwischen Eleganz, Modernität und Finesse schwanken."
    ],
    "en": [
      "Anthony and Quentin, long-time friends, welcome you to their small Domaine, made from the best terroirs of the Saint-Pourçain vineyards, where their wines vacillate between elegance, modernity and finesse."
    ],
    "it": [
      "Anthony e Quentin, amici da molti anni, vi danno il benvenuto nella loro piccola tenuta, ricavata dai migliori terroir dei vigneti di Saint-Pourçain, dove i vini oscillano tra eleganza, modernità e finezza."
    ],
    "fr": [
      "Anthony et Quentin, amis de longue date, vous accueillent sur leur petit Domaine issu des meilleurs terroirs du vignoble de Saint-Pourçain où les vins vacillent entre élégance, modernité et finesse."
    ],
    "es": [
      "Anthony y Quentin, amigos desde hace muchos años, le dan la bienvenida a su pequeña propiedad, elaborada a partir de los mejores terruños de los viñedos de Saint-Pourçain, donde los vinos oscilan entre la elegancia, la modernidad y la finura."
    ],
    "nl": [
      "Anthony en Quentin, die al vele jaren bevriend zijn, heten je welkom op hun kleine domein, gemaakt van de beste terroirs in de wijngaarden van Saint-Pourçain, waar de wijnen schommelen tussen elegantie, moderniteit en finesse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Billaud-Chambon"
    ]
  },
