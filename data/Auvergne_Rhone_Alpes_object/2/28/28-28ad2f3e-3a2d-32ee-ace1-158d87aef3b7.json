  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6138f28-8d05-3c6e-914a-a7e3d8501c75",
      "dc:description": {
        "de": [
          "Kommen Sie zu einer 20-minütigen Lufttaufe an Bord eines Ultraleichtflugzeugs, einem 30-minütigen Schnupperflug und einem 1-stündigen Einführungsflug (Möglichkeit, das Steuer zu übernehmen)."
        ],
        "en": [
          "Come for a 20-minute first flight aboard a microlight, a 30-minute discovery flight and a one-hour introductory flight (possibility of taking the controls)."
        ],
        "it": [
          "Venite a fare il vostro primo volo di 20 minuti a bordo di un ultraleggero, un volo di scoperta di 30 minuti e un volo di iniziazione di un'ora (possibilità di prendere i comandi)."
        ],
        "fr": [
          "Venez faire votre baptême de l'air de 20 minutes à bord d'un ULM, vol découverte de 30 minutes et vol d'initiation d'une heure (possibilité de prendre les commandes)."
        ],
        "es": [
          "Ven a realizar tu primer vuelo de 20 minutos a bordo de un ultraligero, un vuelo de descubrimiento de 30 minutos y un vuelo de iniciación de una hora (posibilidad de tomar los mandos)."
        ],
        "nl": [
          "Kom en maak een eerste vlucht van 20 minuten aan boord van een microlight, een ontdekkingsvlucht van 30 minuten en een initiatievlucht van een uur (mogelijkheid om de besturing over te nemen)."
        ]
      },
