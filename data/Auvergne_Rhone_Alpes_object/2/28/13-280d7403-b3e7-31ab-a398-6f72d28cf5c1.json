  "rdfs:comment": {
    "de": [
      "Einer der wenigen Pumptracks mit einer Jumpline! Auf 180 m Länge gibt es 6 Steilkurven und 27 Buckel, ergänzt durch eine 70 m lange Jumpline mit Abschussvorrichtung und zwei Sprüngen: eine einzigartige Einrichtung in Faverges."
    ],
    "en": [
      "One of the few pumptracks with a jumpline! Over 180 m, enjoy 6 banked turns and 27 bumps, complemented by a 70 m jumpline with launcher and two jumps: a unique feature in Faverges."
    ],
    "it": [
      "Una delle poche piste con jumpline! Su 180 m, godetevi 6 curve a gomito e 27 dossi, completati da una jumpline di 70 m con lanciatore e due salti: un impianto unico a Faverges."
    ],
    "fr": [
      "L’un des rares pumptracks doté d’une jumpline ! Sur 180 m, profitez de 6 virages relevés et 27 bosses, complétés par une jumpline de 70 m avec lanceur et deux sauts : un aménagement unique à Faverges."
    ],
    "es": [
      "Uno de los pocos pumptracks con jumpline A lo largo de 180 m, disfrute de 6 curvas peraltadas y 27 bumps, complementados por una jumpline de 70 m con lanzadera y dos saltos: una instalación única en Faverges."
    ],
    "nl": [
      "Een van de weinige pumptracks met een jumpline! Geniet over 180 m van 6 schuine bochten en 27 bulten, aangevuld met een jumpline van 70 m met lanceerinrichting en twee sprongen: een unieke faciliteit in Faverges."
    ]
  },
