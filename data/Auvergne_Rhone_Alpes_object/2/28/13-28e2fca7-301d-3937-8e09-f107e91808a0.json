  "rdfs:comment": {
    "de": [
      "Das 2022 renovierte Hotel liegt 5 km vom Stadtzentrum von Grenoble entfernt, in der Nähe von Inovallée und weniger als 50 km von den wichtigsten Sehenswürdigkeiten und Bergstationen."
    ],
    "en": [
      "Hotel renovated in 2022, located 5 km from the center of the city of Grenoble, near Inovallée and less than 50 km from the main tourist sites and mountain resorts, you are welcomed in modern, spacious and comfortable rooms."
    ],
    "it": [
      "Hotel ristrutturato nel 2017, situato a 5 chilometri dal centro città di Grenoble, vicino a Inovallée e a meno di 50 chilometri dalle principali attrazioni turistiche e stazioni di montagna, Lei è accolta in camere moderne, spaziose, e molto confortevoli."
    ],
    "fr": [
      "Hôtel rénové en 2022, situé à 5 km du centre de la ville de Grenoble, proche d' Inovallée et à moins de 50 km des principaux sites touristiques et stations de montagne, vous êtes accueillis dans des chambres modernes, spacieuses, et de grand confort."
    ],
    "es": [
      "Hotel renovado en 2022, situado a 5 km del centro de Grenoble, cerca de Inovallée y a menos de 50 km de los principales lugares turísticos y estaciones de montaña, le acoge en habitaciones modernas, espaciosas y confortables."
    ],
    "nl": [
      "Hotel gerenoveerd in 2022, gelegen op 5 km van het centrum van Grenoble, dicht bij Inovallée en op minder dan 50 km van de belangrijkste toeristische bezienswaardigheden en berggebieden, wordt u verwelkomd in moderne, ruime en comfortabele kamers."
    ]
  },
