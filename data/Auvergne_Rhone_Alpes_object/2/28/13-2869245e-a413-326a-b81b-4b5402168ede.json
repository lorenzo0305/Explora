  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum von Issoire, in einem eleganten Rahmen, entdecken Sie unsere abwechslungsreiche und schmackhafte Speisekarte und lassen Sie sich für die Dauer einer Mahlzeit von hochwertigen traditionellen Gerichten verführen."
    ],
    "en": [
      "In the centre of Issoire, in an elegant setting, come and discover our varied and tasty menu and let yourself be seduced for a meal by quality traditional dishes."
    ],
    "it": [
      "Nel centro di Issoire, in un ambiente elegante, venite a scoprire il nostro menu vario e gustoso e lasciatevi sedurre da piatti tradizionali di qualità."
    ],
    "fr": [
      "En centre-ville d'Issoire, dans un cadre élégant, venez découvrir notre carte variée et savoureuse et laissez-vous séduire le temps d'un repas par des plats traditionnels de qualité."
    ],
    "nl": [
      "Kom in het centrum van Issoire, in een elegant kader, onze gevarieerde en smakelijke kaart ontdekken en laat u verleiden tot een maaltijd met traditionele kwaliteitsgerechten."
    ],
    "es": [
      "En el centro de Issoire, en un entorno elegante, venga a descubrir nuestra variada y sabrosa carta y déjese seducir por una comida de calidad tradicional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Le Français"
    ]
  },
