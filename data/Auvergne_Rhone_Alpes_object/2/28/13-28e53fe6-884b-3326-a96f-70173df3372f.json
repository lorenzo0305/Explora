  "rdfs:comment": {
    "de": [
      "Autowaschanlage mit Selbstbedienung 7 Tage die Woche, Hochdruckspuren, darunter eine spezielle Spur für Wohnmobile, Walzen, Staubsauger, Aufblasgerät.\r\nAutomatische Wäscherei, 10-kg- und 18-kg-Waschmaschinen, Trockner."
    ],
    "en": [
      "Carwash and coin laundry. Open 24/7."
    ],
    "it": [
      "Autolavaggio self-service 7 giorni su 7, corsie ad alta pressione, compresa una corsia speciale per camper, rulli, aspirapolvere, pompa d'aria.\r\nLavanderia automatica, lavatrici da 10 e 18 kg, asciugatrice."
    ],
    "fr": [
      "Lavage auto en libre service 7j/7, pistes haute pression, dont une piste spéciale camping-car, rouleaux, aspirateurs, gonfleur. \r\nLaverie de linge automatique, machines à laver de 10 kg et 18 kg, séchoir."
    ],
    "nl": [
      "Zelfbedieningsautowasstraat 7 dagen per week, hogedrukstraten, inclusief een speciale camperstraat, rollers, stofzuigers, luchtpomp.\r\nAutomatische wasserij, 10 kg en 18 kg wasmachines, droger."
    ],
    "es": [
      "Autoservicio de lavado 7 días a la semana, carriles de alta presión, incluido un carril especial para autocaravanas, rodillos, aspiradoras, bomba de aire.\r\nLavandería automática, lavadoras de 10 kg y 18 kg, secadora."
    ]
  },
  "rdfs:label": {
