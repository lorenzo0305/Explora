  "rdfs:comment": {
    "de": [
      "Mitten im Stadtzentrum von Monistrol sur Loire empfängt Sie Planet Pizz@, um seine Pizzas und Paninis zu probieren. Vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "In the heart of the city centre of Monistrol sur Loire, Planet Pizz@ welcomes you to come and taste its pizzas and paninis. On the spot or to take away."
    ],
    "it": [
      "Nel cuore del centro città di Monistrol sur Loire, Planet Pizz@ vi accoglie per farvi assaggiare le sue pizze e i suoi panini. Sul posto o da portare via."
    ],
    "fr": [
      "En plein cœur du centre ville de Monistrol sur Loire, Planet Pizz@ vous accueille pour venir déguster ses pizzas et paninis. Sur place ou à emporter."
    ],
    "nl": [
      "In het hart van het stadscentrum van Monistrol sur Loire heet Planet Pizz@ u welkom om zijn pizza's en panini's te komen proeven. Ter plaatse of om mee te nemen."
    ],
    "es": [
      "En el corazón del centro de la ciudad de Monistrol sur Loire, Planet Pizz@ le da la bienvenida para que venga a degustar sus pizzas y paninis. En el acto o para llevar."
    ]
  },
