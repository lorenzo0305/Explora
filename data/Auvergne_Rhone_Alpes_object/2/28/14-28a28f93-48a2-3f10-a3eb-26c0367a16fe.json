      "dc:description": {
        "de": [
          "Eisdorf, Illuminationen, Zauberwald, pyromelodisches und traditionelles Märchen, Weihnachtsmarkt.\nWeihnachtsmarkt, Theaterplatz\nDas Dorf des Weihnachtsmanns, Place d'armes"
        ],
        "en": [
          "Ice village, illuminations, magic forest, fireworks and traditional tale, Christmas market.\nChristmas market, Place du théâtre\nSanta Claus village, Place d'armes"
        ],
        "it": [
          "Villaggio dei gelati, luminarie, bosco magico, fuochi d'artificio e racconto tradizionale, mercatino di Natale.\nMercatino di Natale, Piazza del Teatro\nVillaggio di Babbo Natale, Place d'armes"
        ],
        "fr": [
          "Village des glaces, illuminations, forêt magique, conte pyromélodique et traditionnel, marché de Noël.\nMarché de Noël, Place du théâtre \nLe village du Père Noël, Place d'armes"
        ],
        "es": [
          "Pueblo helado, iluminaciones, bosque mágico, fuegos artificiales y cuentacuentos tradicionales, mercado navideño.\nMercado de Navidad, Plaza del Teatro\nPueblo de Papá Noel, Place d'armes"
        ],
        "nl": [
          "IJsdorp, verlichting, toverbos, vuurwerk en traditionele vertelling, kerstmarkt.\nKerstmarkt, Theaterplein\nKerstmannen dorp, Place d'armes"
        ]
      },
