  "rdfs:comment": {
    "de": [
      "Im Inventar der historischen Denkmäler aufgeführt sind die Büsten von Barnave und Maurice Faure, der mit dem Stadtwappen geschmückte Sessel des Bürgermeisters, 2 Wandgemälde von Paul Audra (1899) über den Wein- und Pfirsichanbau in der Römerzeit"
    ],
    "en": [
      "Listed as a Monument Historique, it features busts of Barnave and Maurice Faure, the mayor's chair adorned with the town's coat of arms, and 2 murals by Paul Audra (1899) depicting the cultivation of vines and peaches in Roman times."
    ],
    "it": [
      "Classificato come Monumento Storico, presenta i busti di Barnave e Maurice Faure, la sedia del sindaco decorata con lo stemma della città, due murales di Paul Audra (1899) sulla coltivazione della vite e delle pesche in epoca romana"
    ],
    "fr": [
      "Inscrite à l'inventaire des Monuments historiques, on peut y voir les bustes de Barnave et Maurice Faure, le fauteuil du maire orné du blason de la ville, 2 peintures murales de Paul Audra (1899) sur la culture de la vigne et des pêches à l'époque romaine"
    ],
    "nl": [
      "Op de monumentenlijst staan bustes van Barnave en Maurice Faure, de burgemeestersstoel met het stadswapen en 2 muurschilderingen van Paul Audra (1899) die de wijnbouw en perzikteelt in de Romeinse tijd uitbeelden."
    ],
    "es": [
      "Declarado Monumento Histórico, cuenta con bustos de Barnave y Maurice Faure, la silla del alcalde decorada con el escudo de la ciudad, dos murales de Paul Audra (1899) sobre el cultivo de la vid y el melocotón en la época romana"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle du conseil municipal"
    ]
  },
