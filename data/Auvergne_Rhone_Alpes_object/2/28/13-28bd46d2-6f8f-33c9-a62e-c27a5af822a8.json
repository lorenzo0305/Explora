  "rdfs:comment": {
    "de": [
      "Der Tennisplatz befindet sich im Freizeitzentrum Etang Philippe. In der Nähe von anderen Freizeitaktivitäten: Angeln, Schwimmen, Minigolfplatz, Pétanque-Platz, Spiele für Kinder. Campingplatz und Freizeitchalet."
    ],
    "en": [
      "The tennis court is located in the leisure center of the Étang Philippe. Close to other leisure activities: fishing, swimming, mini-golf course, petanque, games for children. Camping and leisure chalet."
    ],
    "it": [
      "Il campo da tennis si trova nel centro ricreativo dell'Étang Philippe. Altre attività per il tempo libero nelle vicinanze: pesca, nuoto, minigolf, campo da bocce, giochi per bambini. Chalet per il campeggio e il tempo libero."
    ],
    "fr": [
      "Le terrain de tennis se trouve dans la base de loisirs de l'Étang Philippe. À proximité d'autres loisirs : pêche, baignade, parcours de mini-golf, terrain de pétanque, jeux pour enfants. Camping et chalet loisirs."
    ],
    "es": [
      "La pista de tenis se encuentra en el centro de ocio del Étang Philippe. Otras actividades de ocio cercanas: pesca, natación, campo de minigolf, campo de petanca, juegos infantiles. Camping y chalet de ocio."
    ],
    "nl": [
      "De tennisbaan bevindt zich in het recreatiecentrum van het Étang Philippe. Andere recreatiemogelijkheden in de buurt: vissen, zwemmen, midgetgolfbaan, petanquebaan, kinderspelen. Camping en recreatie chalet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Court de tennis de Saint-Gervais-d'Auvergne"
    ]
  },
