  "rdfs:comment": {
    "de": [
      "Les Aînés Ruraux de Vassieux ist eine lokale Organisation in der Ortschaft Vassieux-en-Vercors in Frankreich. Ihr Ziel ist es, die älteren Menschen in der ländlichen Gemeinde zusammenzubringen, um ihr Wohlbefinden zu fördern und der Isolation entgegenzuwirken."
    ],
    "en": [
      "Les Aînés Ruraux de Vassieux is a local organization based in the village of Vassieux-en-Vercors, France. It aims to bring together the elderly of the rural community to promote their well-being and combat isolation."
    ],
    "it": [
      "Les Aînés Ruraux de Vassieux è un'organizzazione locale con sede nel villaggio di Vassieux-en-Vercors, in Francia. Il suo obiettivo è riunire gli anziani della comunità rurale per promuovere il loro benessere e combattere l'isolamento."
    ],
    "fr": [
      "Les Aînés Ruraux de Vassieux est une organisation locale située dans le village de Vassieux-en-Vercors, en France. Elle vise à rassembler les personnes âgées de la communauté rurale pour favoriser leur bien-être et lutter contre l'isolement."
    ],
    "nl": [
      "Les Aînés Ruraux de Vassieux is een lokale organisatie gevestigd in het dorp Vassieux-en-Vercors, Frankrijk. Het doel is om ouderen uit de plattelandsgemeenschap samen te brengen om hun welzijn te bevorderen en isolement tegen te gaan."
    ],
    "es": [
      "Les Aînés Ruraux de Vassieux es una organización local con sede en el pueblo de Vassieux-en-Vercors (Francia). Su objetivo es reunir a las personas mayores de la comunidad rural para promover su bienestar y combatir el aislamiento."
    ]
  },
