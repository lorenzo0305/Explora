  "rdfs:comment": {
    "de": [
      "Basis mit dem FFCT-Label für Mountainbikes.\r\n38 markierte Strecken in allen Schwierigkeitsgraden: grün (leicht), blau (mittel), rot (schwer) und schwarz (sehr schwer)."
    ],
    "en": [
      "FFCT mountain-bike-approved base.\r\n38 marked trails of all difficulty levels: green (easy), blue (medium), red (difficult) and black (very difficult)."
    ],
    "it": [
      "Base omologata FFCT per mountain bike.\r\n38 sentieri segnalati di tutti i livelli di difficoltà: verde (facile), blu (medio), rosso (difficile) e nero (molto difficile)."
    ],
    "fr": [
      "Base labellisée VTT FFCT.\r\n38 circuits balisés et de tous niveaux de difficulté : vert (facile), bleu (moyen), rouge (difficile) et noir (très difficile)."
    ],
    "nl": [
      "FFCT mountainbike goedgekeurde basis.\r\n38 bewegwijzerde paden van alle moeilijkheidsgraden: groen (gemakkelijk), blauw (gemiddeld), rood (moeilijk) en zwart (zeer moeilijk)."
    ],
    "es": [
      "Base homologada para bicicletas de montaña de la FFCT.\r\n38 senderos señalizados de todos los niveles de dificultad: verde (fácil), azul (medio), rojo (difícil) y negro (muy difícil)."
    ]
  },
  "rdfs:label": {
