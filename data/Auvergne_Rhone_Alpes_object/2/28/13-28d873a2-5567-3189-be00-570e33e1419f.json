  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Zeichnen und Malen mit der Dozentin Claire Moulas in einer ca. 1,5-stündigen Sitzung im MJC Robert Martin.\r\nErste Sitzung am Samstag, den 27. September, dann 2 Sitzungen pro Monat, je nach Kalender."
    ],
    "en": [
      "Come and discover drawing and painting with Claire Moulas during a 1h30 session at MJC Robert Martin.\r\nFirst session on Saturday September 27, then 2 sessions a month depending on the calendar."
    ],
    "it": [
      "Venite a scoprire il disegno e la pittura con Claire Moulas durante una sessione di 1h30 al MJC Robert Martin.\r\nPrima sessione sabato 27 settembre, poi 2 sessioni al mese a seconda del calendario."
    ],
    "fr": [
      "Venez découvrir le dessin et la peinture avec l'intervenante Claire Moulas lors d'une séance de 1h30 environ à la MJC Robert Martin.\r\nPremière séance le samedi 27 Septembre puis 2 séances par mois selon calendrier."
    ],
    "es": [
      "Venga a descubrir el dibujo y la pintura con Claire Moulas durante una sesión de 1h30 en el MJC Robert Martin.\r\nPrimera sesión el sábado 27 de septiembre, luego 2 sesiones al mes según el calendario."
    ],
    "nl": [
      "Kom tekenen en schilderen ontdekken met Claire Moulas tijdens een sessie van 1u30 in het MJC Robert Martin.\r\nEerste sessie op zaterdag 27 september, daarna 2 sessies per maand afhankelijk van de kalender."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers dessins-peinture (enfants/adultes) avec Claire MOULAS"
    ]
  },
