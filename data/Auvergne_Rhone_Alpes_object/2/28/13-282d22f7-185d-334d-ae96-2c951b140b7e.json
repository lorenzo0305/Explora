  "rdfs:comment": {
    "de": [
      "Indoor-/Outdoor-Militärlager (mit Armee-LKWs, Granattrichtern, Tunneln usw.), um eine tolle Zeit zu verbringen. Junggesellen- und Junggesellinnenabschiede, Kindergeburtstage, Freizeitzentren, Seminare? Möglichkeit von Nachtveranstaltungen."
    ],
    "en": [
      "Indoor/outdoor military camp (with army trucks, shell craters, tunnels, etc.) for a great time. Bachelor and bachelorette parties, children's birthdays, leisure centers, seminars? Possibility of evening events."
    ],
    "it": [
      "Campo militare interno/esterno (con camion dell'esercito, crateri di granate, tunnel, ecc.) per divertirsi. Feste di addio al celibato e al nubilato, compleanni di bambini, centri ricreativi, seminari, ecc Possibilità di eventi serali."
    ],
    "fr": [
      "Camp militaire indoor/outdoor (avec camions de l'armée, cratères d'obus, tunnel…) pour passer d'agréables moments. Enterrements de vie de garçons et de jeunes filles, anniversaires enfants, centres de loisirs, séminaires… Possibilité de nocturnes."
    ],
    "nl": [
      "Indoor/outdoor militair kamp (met legervoertuigen, granaatkraters, tunnels, enz.) voor een geweldige tijd. Stag- en vrijgezellenfeesten, kinderverjaardagen, vrijetijdscentra, seminars, enz Avondevenementen mogelijk."
    ],
    "es": [
      "Campamento militar cubierto/al aire libre (con camiones del ejército, cráteres de proyectiles, túneles, etc.) para pasarlo en grande. Despedidas de soltero, cumpleaños infantiles, centros de ocio, seminarios, etc Eventos nocturnos disponibles."
    ]
  },
  "rdfs:label": {
