  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2053e5a1-9deb-3555-b027-96d0639ae835",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr\nSamstags von 9:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr\n\nSonntag geschlossen\n \n Abholung :\n\n Zu den Öffnungszeiten der Apotheke\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 9am to 12pm and 2pm to 7pm\nSaturday 9am to 12pm and 2pm to 5pm\n\nClosed on Sunday\n \n Pick-up :\n\n During pharmacy opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 19.00\nSabato dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00\n\nChiuso la domenica\n \n Ritiro:\n\n Durante gli orari di apertura della farmacia\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 9h à 12h et de 14h à 19h\nLe samedi de 9h à 12h et de 14h00 à 17h00\n\nFermeture le dimanche\n \n Retrait :\n\n Aux horaires d'ouverture de la pharmacie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag, 9u tot 12u en 14u tot 19u\nZaterdag van 9u tot 12u en van 14u tot 17u\n\nZondag gesloten\n \n Ophalen:\n\n Tijdens openingsuren van de apotheek\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 9.00 a 12.00 h. y de 14.00 a 19.00 h\nSábado de 9h a 12h y de 14h a 17h\n\nDomingos cerrado\n \n Recogida:\n\n Durante el horario de apertura de la farmacia\n\n "
        ]
      },
