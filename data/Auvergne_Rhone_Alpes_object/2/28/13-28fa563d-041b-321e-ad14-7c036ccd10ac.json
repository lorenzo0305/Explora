  "rdfs:comment": {
    "de": [
      "Verleih von Vintage-Elektrofahrrädern, um die Umgebung von Vallon Pont d'Arc zu genießen.\r\n3 Arten von Fahrrädern verfügbar:\r\nSodas: ab 7 Jahren oder 150cm.\r\nOutsider: Motorrad-Stil\r\nVacay Lady: weiblicher Look"
    ],
    "en": [
      "Rent vintage electric bikes to enjoy the Vallon Pont d'Arc area.\r\n3 types of bikes available:\r\nSodas: from age 7 or 150cm\r\nOutsider: motorcycle style\r\nVacay Lady: feminine look"
    ],
    "it": [
      "Noleggiate biciclette elettriche d'epoca per godervi l'area intorno a Vallon Pont d'Arc.\r\nsono disponibili 3 tipi di bici:\r\nSoda: a partire da 7 anni o 150cm\r\nOutsider: stile motociclistico\r\nVacay Lady: look femminile"
    ],
    "fr": [
      "Location de vélos électriques vintage pour profiter des alentours de Vallon Pont d'Arc.\r\n3 types de vélos disponibles : \r\nSodas : à partir de 7 ans ou 150cm\r\nOutsider : style moto\r\nVacay Lady : look féminin"
    ],
    "nl": [
      "Huur vintage elektrische fietsen om te genieten van het gebied rond Vallon Pont d'Arc.\r\n3 soorten fietsen beschikbaar:\r\nSoda: vanaf 7 jaar of 150 cm\r\nOutsider: motor stijl\r\nVacay Lady: vrouwelijke look"
    ],
    "es": [
      "Alquile bicicletas eléctricas de época para disfrutar de los alrededores de Vallon Pont d'Arc.\r\n3 tipos de bicicleta disponibles:\r\nSodas: a partir de 7 años o 150cm\r\nOutsider: estilo moto\r\nVacay Lady: look femenino"
    ]
  },
