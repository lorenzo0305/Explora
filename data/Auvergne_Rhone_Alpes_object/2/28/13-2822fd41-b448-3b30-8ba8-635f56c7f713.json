  "rdfs:comment": {
    "de": [
      "Ideal in der Nähe eines Waldes gelegen und leicht vom Stadtzentrum aus erreichbar, bietet das Reitzentrum von Thônes eine Vielzahl von Reitaktivitäten.\r\nDas ganze Jahr über empfängt Sie das Team mit Professionalität und Freundlichkeit.\r\nFamiliäre Atmosphäre garantiert."
    ],
    "en": [
      "Ideally located near a forest and within easy reach of the town center, the Thônes riding center offers a multitude of equestrian activities.\r\nAll year round, the team welcomes you with professionalism and friendliness.\r\nFamily atmosphere guaranteed."
    ],
    "it": [
      "Situato in una posizione ideale, vicino a una foresta e a breve distanza dal centro città, il centro di equitazione di Thônes offre una moltitudine di attività equestri.\r\nTutto l'anno, il team vi accoglie con professionalità e cordialità.\r\nAtmosfera familiare garantita."
    ],
    "fr": [
      "Idéalement situé près d'une forêt et aisément accessible du centre-ville, le centre équestre de Thônes offre une multitude d'activités équestres.\r\nToute l'année, l'équipe vous accueille avec professionnalisme et convivialité.\r\nAmbiance familiale garantie."
    ],
    "es": [
      "Idealmente situado cerca de un bosque y a poca distancia del centro de la ciudad, el centro ecuestre de Thônes ofrece multitud de actividades ecuestres.\r\nDurante todo el año, el equipo le acoge con profesionalidad y amabilidad.\r\nAmbiente familiar garantizado."
    ],
    "nl": [
      "De manege van Thônes, ideaal gelegen in de buurt van een bos en op korte afstand van het stadscentrum, biedt een groot aantal ruiteractiviteiten.\r\nHet hele jaar door verwelkomt het team je met professionaliteit en vriendelijkheid.\r\nFamiliale sfeer gegarandeerd."
    ]
  },
  "rdfs:label": {
    "en": [
