  "rdfs:comment": {
    "de": [
      "Die Freizeitanlage des Lac des Chavants ist ein Muss in Les Houches und bietet Ihnen eine Vielzahl an Aktivitäten: Wanderungen, Klettergarten, Kinderspiele und Wasserspiele, Entdeckungspfade, Bouleplatz, Imbissbude, Tennisplätze..."
    ],
    "en": [
      "A not-to-be-missed spot in Les Houches, the Lac des Chavants leisure park offers a multitude of activities: hiking, climbing, children's games and water jets, discovery trails, pétanque court, refreshment bar, tennis courts..."
    ],
    "it": [
      "Luogo imperdibile di Les Houches, il centro ricreativo Lac des Chavants offre una moltitudine di attività: passeggiate, arrampicate, giochi per bambini e getti d'acqua, percorsi di scoperta, campo da pétanque, area di ristoro, campi da tennis..."
    ],
    "fr": [
      "Lieu incontournable des Houches, la base de loisirs du lac des Chavants vous offre une multitudes d'activités : balade pédestre, site d'escalade, jeux pour enfants et jets d'eau, sentiers découvertes, terrain de pétanque, buvette, courts de tennis..."
    ],
    "es": [
      "Lugar ineludible de Les Houches, el centro de ocio Lac des Chavants ofrece multitud de actividades: paseos, escalada, juegos infantiles y chorros de agua, senderos de descubrimiento, zona de petanca, bar de refrescos, pistas de tenis..."
    ],
    "nl": [
      "Een niet te missen plek in Les Houches, het recreatiecentrum Lac des Chavants biedt tal van activiteiten: wandelingen, klimmen, kinderspelen en waterstralen, ontdekkingspaden, petanqueterrein, verfrissingsruimte, tennisbanen..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Base de Loisirs des Chavants"
    ]
  },
