  "rdfs:comment": {
    "de": [
      "Die Gemeinde La Guillermie ist ein altes Grundherrschaftsgebiet, das im 15. Jahrhundert der Familie de Bourbon gehörte und bis zur Revolution mehrmals den Besitzer wechselte."
    ],
    "en": [
      "The commune of La Guillermie is an ancient seigneury which in the 15th century belonged to the de Bourbon family, it changed owners several times until the revolution."
    ],
    "it": [
      "Il comune di La Guillermie è un'antica signoria che nel XV secolo apparteneva alla famiglia Bourbon e che cambiò più volte proprietà fino alla rivoluzione."
    ],
    "fr": [
      "La commune de La Guillermie est une ancienne seigneurie qui au XVe siècle  appartenait à la famille de Bourbon, elle changea plusieurs fois de propriétaire jusqu’à la révolution."
    ],
    "es": [
      "El municipio de La Guillermie es un antiguo señorío que en el siglo XV pertenecía a la familia de los Borbones y que cambió de propietario varias veces hasta la revolución."
    ],
    "nl": [
      "De gemeente La Guillermie is een oude heerlijkheid die in de 15e eeuw toebehoorde aan de familie Bourbon, en die tot de revolutie meermaals van eigenaar veranderde."
    ]
  },
