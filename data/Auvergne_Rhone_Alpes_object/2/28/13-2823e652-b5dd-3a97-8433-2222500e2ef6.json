  "rdfs:comment": {
    "de": [
      "Hier finden Sie alle touristischen Informationen über die Combrailles sowie unseren Shop-Bereich."
    ],
    "en": [
      "Find all the tourist information on the Combrailles, as well as our shop area."
    ],
    "it": [
      "Trovate l'accoglienza turistica alle porte delle Gole della Sioule! Oltre a tutte le informazioni turistiche necessarie per il vostro soggiorno nelle Combrailles, e al nostro negozio."
    ],
    "fr": [
      "Retrouvez l’accueil touristique aux portes des Gorges de la Sioule ! Ainsi que toutes les informations touristiques nécessaires pour votre séjour sur les Combrailles, et notre espace boutique."
    ],
    "nl": [
      "Vind de toeristische receptie aan de poort van de Gorges de la Sioule! Evenals alle toeristische informatie die je nodig hebt voor je verblijf in de Combrailles, en onze winkelruimte."
    ],
