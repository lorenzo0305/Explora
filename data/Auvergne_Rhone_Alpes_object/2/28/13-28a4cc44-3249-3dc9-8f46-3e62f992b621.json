  "rdfs:comment": {
    "de": [
      "Das Ausbildungsrestaurant ist während der Schulzeit nach einem festgelegten Zeitplan geöffnet. Die Schülerinnen und Schüler des Lycée du Bréda bereiten Ihnen leckere Gerichte zu und Sie nehmen so an ihrer Ausbildung in Service und Küche teil."
    ],
    "en": [
      "The training restaurant is open during the school term on a fixed schedule. Students from the Lycée du Bréda will prepare delicious dishes for you, and you'll be taking part in their training in service and cooking."
    ],
    "it": [
      "Il ristorante di formazione è aperto durante il periodo scolastico a orari fissi: gli studenti del Lycée du Bréda prepareranno per voi piatti deliziosi e voi contribuirete a formarli al servizio e alla cucina."
    ],
    "fr": [
      "Le restaurant d'application est ouvert pendant la période scolaire sur un calendrier défini, les élèves du Lycée du Bréda vous concocteront de bons plats et vous participerez ainsi à leur formation en service et cuisine."
    ],
    "es": [
      "El restaurante escuela está abierto durante el curso escolar en un horario fijo. Los alumnos del Lycée du Bréda le prepararán deliciosos platos y usted contribuirá a formarlos en el servicio y la cocina."
    ],
    "nl": [
      "De cateringservice is tijdens het schooljaar geopend volgens een vast rooster. Studenten van het Lycée du Bréda zullen smakelijke gerechten voor je bereiden en jij neemt deel aan hun training in service en koken."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Fourchette et La Plume, training restaurant"
    ],
    "fr": [
      "La Fourchette et La Plume, restaurant d'application"
    ],
    "nl": [
      "La Fourchette et La Plume, opleidingsrestaurant"
    ]
  },
