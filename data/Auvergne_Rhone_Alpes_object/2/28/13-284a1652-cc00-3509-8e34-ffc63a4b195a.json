  "rdfs:comment": {
    "de": [
      "Geneviève Haroche-Bouzinac ist die Autorin der Biografie Madame de Sévigné, die 2024 mit dem Prix Goncourt de la Biographie ausgezeichnet wurde. Darin schildert sie das Leben und die Welt der berühmten Briefschreiberin."
    ],
    "en": [
      "Geneviève Haroche-Bouzinac is the author of the biography Madame de Sévigné, which won the Prix Goncourt de la Biographie in 2024. In it, she portrays the life and world of the famous letter writer."
    ],
    "it": [
      "Geneviève Haroche-Bouzinac è l'autrice della biografia Madame de Sévigné, che ha vinto il Prix Goncourt de la Biographie nel 2024. In essa ritrae la vita e il mondo della famosa scrittrice di lettere."
    ],
    "fr": [
      "Geneviève Haroche-Bouzinac est l'auteure de la biographie Madame de Sévigné, qui a reçu le prix Goncourt de la Biographie en 2024. Elle y dépeint la vie et l'univers de la célèbre épistolière."
    ],
    "nl": [
      "Geneviève Haroche-Bouzinac is de auteur van de biografie Madame de Sévigné, die in 2024 de Prix Goncourt de la Biographie won. Hierin portretteert ze het leven en de wereld van de beroemde briefschrijfster."
    ],
    "es": [
      "Geneviève Haroche-Bouzinac es autora de la biografía Madame de Sévigné, galardonada con el Premio Goncourt de Biografía en 2024. En ella retrata la vida y el mundo de la célebre escritora de cartas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence-lecture : Madame de Sévigné  et son monde"
    ]
  },
