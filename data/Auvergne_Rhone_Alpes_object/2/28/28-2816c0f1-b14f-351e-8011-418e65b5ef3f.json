  "rdfs:comment": {
    "de": [
      "Lernen Sie Chôlage kennen, ein traditionelles und festliches Kugelspiel! Spielen Sie und genießen Sie einen Aperitif oder eine Kostprobe der lokalen Geschmäcker des Valenciennois."
    ],
    "en": [
      "Try your hand at chôlage, a traditional and festive game of boules! Play and enjoy an aperitif or taste the local flavours of the Valenciennois."
    ],
    "it": [
      "Cimentatevi nello chôlage, il tradizionale e festoso gioco delle bocce! Giocate e godetevi un aperitivo o assaggiate i sapori locali del Valenciennois."
    ],
    "fr": [
      "Initiez-vous au chôlage, un jeu de boules traditionnel et festif ! Jouez et profitez d’un apéritif ou goûter aux saveurs locales du Valenciennois."
    ],
    "es": [
      "Pruebe el chôlage, un juego de petanca tradicional y festivo Juegue y disfrute de un aperitivo o pruebe los sabores locales del Valenciennois."
    ],
    "nl": [
      "Probeer chôlage, een traditioneel en feestelijk jeu de boules spel! Speel en geniet van een aperitief of proef de lokale smaken van de Valenciennois."
    ]
  },
  "rdfs:label": {
