  "rdfs:comment": {
    "de": [
      "Dieses Museum befindet sich am Place Cohendy gegenüber dem Portal der Kirche Saint-Léger und erinnert an die Geschichte von Royat und insbesondere an die Zeit der mondänen Thermalbäder."
    ],
    "en": [
      "Situated on the Place Cohendy, opposite the portal of the Saint-Léger church, this museum evokes the history of Royat, and more particularly the era of worldly thermalism."
    ],
    "it": [
      "Situato in Place Cohendy, di fronte alla porta della chiesa di Saint-Léger, questo museo evoca la storia di Royat, in particolare l'epoca del termalismo alla moda."
    ],
    "fr": [
      "Situé place Cohendy, en face du portail de l'église Saint-Léger, ce musée évoque l'histoire de Royat et plus particulièrement l'époque du thermalisme mondain."
    ],
    "es": [
      "Situado en la plaza Cohendy, frente a la puerta de la iglesia de Saint-Léger, este museo evoca la historia de Royat, y más concretamente la época del termalismo de moda."
    ],
    "nl": [
      "Dit museum ligt op de Place Cohendy, tegenover de toegangspoort tot de kerk Saint-Léger en roept de geschiedenis van Royat op, en meer in het bijzonder het tijdperk van het modieuze thermalisme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de Royat  (Les amis de Royat)"
    ]
  },
