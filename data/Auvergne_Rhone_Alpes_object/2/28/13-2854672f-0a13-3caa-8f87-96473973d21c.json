  "rdfs:comment": {
    "de": [
      "Probieren Sie das Vergnügen des Wassers! Genießen Sie einen auf 30°C beheizten Pool mit einer atemberaubenden Aussicht auf die umliegenden Bergmassive."
    ],
    "en": [
      "Taste the pleasure of water! Enjoy a swimming pool heated to 30 ° C and a fully equipped wellness area with a breathtaking view of the surrounding mountains and maximum sunshine."
    ],
    "it": [
      "Assaporate il piacere dell'acqua! Godetevi una piscina riscaldata a 30°C con una vista mozzafiato sulle montagne circostanti."
    ],
    "fr": [
      "Goûtez au plaisir de l'eau ! Profitez d'une piscine chauffée à 30°C avec une vue imprenable sur les massifs environnants."
    ],
    "es": [
      "¡Saboree el placer del agua! Disfrute de una piscina climatizada a 30 °C con una vista impresionante de las montañas circundantes."
    ],
    "nl": [
      "Proef het plezier van water! Geniet van een zwembad verwarmd tot 30 ° C en een volledig uitgeruste wellnessruimte met een adembenemend uitzicht op de omliggende bergen en maximale zonneschijn."
    ]
  },
  "rdfs:label": {
