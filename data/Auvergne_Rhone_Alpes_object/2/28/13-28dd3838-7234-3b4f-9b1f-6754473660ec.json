  "rdfs:comment": {
    "de": [
      "Diese 37 km lange Gravel-Runde mit 816 m+ führt über schöne kleine Straßen, aber auch über leicht zu fahrende Schotterpisten sowie über einen ausgebauten grünen Weg, die Dolce Via. Ein Eintauchen rund um ein Hochplateau auf über 1000 m Höhe!"
    ],
    "en": [
      "This 37 km, 816 m+ gravel loop takes in beautiful back roads, easy dirt tracks and the Dolce Via greenway. Immerse yourself in a high-altitude plateau over 1000 m above sea level!"
    ],
    "it": [
      "Questo anello sterrato di 37 km e 816 m di dislivello si snoda tra bellissime strade secondarie, facili sentieri sterrati e la Dolce Via, un percorso verde paesaggistico. Un giro coinvolgente su un altopiano a oltre 1000 m di altitudine!"
    ],
    "fr": [
      "Cette boucle gravel de 37 km et 816 m+ emprunte des belles petites routes, mais aussi des pistes en terre faciles à rouler, ainsi qu'une voie verte aménagée, la Dolce Via. Une immersion autour d'un plateau d'altitude à plus de 1000 m d'altitude !"
    ],
    "es": [
      "Este bucle de grava de 37 km y más de 816 m recorre hermosas carreteras secundarias, fáciles pistas de tierra y la Dolce Via, una vía verde ajardinada. Un recorrido envolvente por un altiplano a más de 1.000 m de altitud"
    ],
    "nl": [
      "Deze 37 km lange, meer dan 816 m lange gravellus voert langs mooie achterafweggetjes, gemakkelijke onverharde paden en de Dolce Via, een aangelegde groene weg. Een meeslepende rit over een hoogplateau op meer dan 1000 m hoogte!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boucle Gravel de Saint-Agrève"
    ]
  },
