  "rdfs:comment": {
    "de": [
      "500m² großer Indoor-Skatepark! Skateboard, Inlineskates, Scooter, BMX - Sie sind herzlich willkommen! Es gibt freie Slots, Slots für verschiedene Disziplinen und Slots \"speziell für Mädchen\"!\r\nEin geselliger Ort für Anfänger und Fortgeschrittene."
    ],
    "en": [
      "500m² indoor skate park! Skateboarding, rollerblading, scootering, BMX, you're welcome, with free slots, slots by discipline, and \"special girls\" slots!\r\nA friendly place for beginners and experts alike."
    ],
    "it": [
      "Skate park coperto di 500 m²! Skateboard, rollerblade, monopattino, BMX, tutti sono i benvenuti, con slot gratuiti, slot per discipline specifiche, ecc\nUn luogo accogliente per principianti ed esperti."
    ],
    "fr": [
      "Skate park indoor de 500m² ! Skateboard, roller, trottinette, BMX, vous êtes les bienvenus, avec des créneaux libres, des créneaux par disciplines \nLieu convivial pour débutants et confirmés."
    ],
    "nl": [
      "indoor skatepark van 500 m²! Skateboarden, skeeleren, steppen, BMX, jullie zijn allemaal welkom, met gratis slots, slots per discipline en \"special girls\"-slots!\r\nEen vriendelijke plek voor beginners en gevorderden."
    ],
    "es": [
      "Parque de patinaje cubierto de 500 m² Skate, patines, patinetes, BMX, todos son bienvenidos, con plazas libres, plazas para disciplinas específicas, etc\nUn lugar acogedor para principiantes y expertos."
    ]
  },
