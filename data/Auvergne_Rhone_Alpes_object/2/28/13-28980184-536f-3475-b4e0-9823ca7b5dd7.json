  "rdfs:comment": {
    "de": [
      "In der Nähe des Elefantenbrunnens empfängt Sie die Cafétéria des Éléphants in einer angenehmen und gepflegten Umgebung. Wir bieten Ihnen eine abwechslungsreiche traditionelle Küche, die für jedes Budget geeignet ist."
    ],
    "en": [
      "Close to the Elephant fountain, the Cafétéria des Eléphants welcomes you in a pleasant and elegant interior and offers a wide choice of traditional dishes for every budget."
    ],
    "it": [
      "Vicino alla Fontana dell'Elefante, la Caffetteria dell'Elefante vi accoglie in un ambiente piacevole e curato. Offre una varietà di piatti tradizionali per tutte le tasche."
    ],
    "fr": [
      "À proximité de la Fontaine des Éléphants, la Cafétéria des Éléphants vous accueille dans un cadre agréable et soigné. Elle vous proposons une cuisine traditionnelle variée et adaptée à tous les budgets."
    ],
    "nl": [
      "In de buurt van de Olifantenfontein ontvangt de Elephant Cafetaria u in een aangename en nette omgeving. Het biedt een verscheidenheid aan traditionele gerechten voor alle budgetten."
    ],
    "es": [
      "Cerca de la Fuente de los Elefantes, la Cafetería Elefante le da la bienvenida en un entorno agradable y cuidado. Ofrece una variedad de cocina tradicional que se adapta a todos los presupuestos."
    ]
  },
