  "rdfs:comment": {
    "de": [
      "Das Kongresszentrum befindet sich im Zentrum von La Bourboule. Diese im Sancy-Massiv einzigartige Struktur bietet eine Einheit des Ortes, die von den Organisatoren sehr geschätzt wird."
    ],
    "en": [
      "The congress centre is located in the centre of La Bourboule. This unique structure in the Massif du Sancy, offers a unity of place much appreciated by the organizers."
    ],
    "it": [
      "Il centro congressi si trova nel centro di La Bourboule. Questa struttura unica nel Massiccio del Sancy offre un'unità di luogo molto apprezzata dagli organizzatori."
    ],
    "fr": [
      "Le centre des congrès est situé au centre de La Bourboule. Cette structure unique dans le Massif du Sancy, offre une unité de lieu très appréciée par les organisateurs."
    ],
    "nl": [
      "Het congrescentrum ligt in het centrum van La Bourboule. Deze unieke structuur in het Massif du Sancy biedt een eenheid van plaats die door de organisatoren zeer op prijs wordt gesteld."
    ],
    "es": [
      "El centro de congresos está situado en el centro de La Bourboule. Esta estructura única en el Macizo del Sancy, ofrece una unidad de lugar muy apreciada por los organizadores."
    ]
