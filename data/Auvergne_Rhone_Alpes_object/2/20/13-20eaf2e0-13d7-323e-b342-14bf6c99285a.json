  "rdfs:comment": {
    "de": [
      "In einer ländlichen Umgebung auf 850 m Höhe heißen Christine und Pascal Sie herzlich willkommen. Pascal wird Sie in seine Küche einführen."
    ],
    "en": [
      "Christine and Pascal welcome you in a rural setting, at an altitude of 850 m. Pascal will make you discover his cooking."
    ],
    "it": [
      "Christine e Pascal vi accolgono in un ambiente rurale a 850 m di altitudine. Pascal vi farà conoscere la sua cucina."
    ],
    "fr": [
      "C'est dans un décor champêtre, à 850 m d'altitude, que Christine et Pascal vous accueillent. Pascal vous fera découvrir sa cuisine."
    ],
    "es": [
      "Christine y Pascal le dan la bienvenida en un entorno rural a 850 m de altitud. Pascal le presentará su cocina."
    ],
    "nl": [
