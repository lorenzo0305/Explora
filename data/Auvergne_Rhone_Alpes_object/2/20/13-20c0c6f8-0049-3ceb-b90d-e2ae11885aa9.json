  "rdfs:comment": {
    "de": [
      "Montricher-Albanne besteht aus sechs Weilern und ist die Trägergemeinde des Skiortes Les Karellis, der 1975 von der Gemeinde, seinen Einwohnern und Pierre Lainé auf der Grundlage des Ideals einer sozialen und solidarischen Wirtschaft und eines Vereinstourismus gegründet wurde."
    ],
    "en": [
      "Montricher-Albanne, made up of 6 hamlets, is the municipality that supports the Les Karellis resort, founded in 1975 by the municipality, its residents and Pierre Lainé, based on an ideal of social economy and associative tourism."
    ],
    "it": [
      "Montricher-Albanne, composta da 6 frazioni, è la comunità di supporto del resort Les Karellis, fondato nel 1975 dal comune, dai suoi abitanti e da Pierre Lainé, sulla base di un ideale di economia sociale e turismo associativo."
    ],
    "fr": [
      "Montricher-Albanne, composée de 6 hameaux, est la commune support de la station des Karellis fondée en 1975 par la municipalité, ses habitants et Pierre Lainé sur un idéal d’économie sociale et solidaire et un tourisme associatif."
    ],
    "es": [
      "Montricher-Albanne, formado por 6 aldeas, es el municipio de apoyo de la estación de Les Karellis, fundada en 1975 por el municipio, sus habitantes y Pierre Lainé sobre la base de un ideal de economía social y solidaria y de turismo asociativo."
    ],
    "nl": [
      "Montricher-Albanne, dat uit 6 gehuchten bestaat, is de ondersteunende gemeente van het vakantieoord Les Karellis, dat in 1975 werd opgericht door de gemeente, de inwoners en Pierre Lainé, op basis van een ideaal van sociale economie en associatief toerisme."
    ]
  },
