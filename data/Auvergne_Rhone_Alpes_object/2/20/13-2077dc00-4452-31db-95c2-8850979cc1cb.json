  "rdfs:comment": {
    "de": [
      "Die Überreste des Schlosses von Rochefort aus dem Mittelalter befinden sich auf dem Hügel am Eingang des Dorfes. Sie sind von der Ebene aus gut sichtbar und über einen Fußweg erreichbar.\r\nEin Orientierungstisch ermöglicht es, ein weites Panorama zu entdecken."
    ],
    "en": [
      "The remains of the Château de Rochefort, dating from the Middle Ages, are located on the hill at the entrance to the village. Clearly visible from the plain, they are accessible via a footpath.\r\nAn orientation table offers a panoramic view."
    ],
    "it": [
      "I resti del castello di Rochefort, risalenti al Medioevo, si trovano sulla collina all'ingresso del villaggio. Ben visibili dalla pianura, sono accessibili tramite un sentiero.\r\nUna tavola di orientamento permette di scoprire un vasto panorama."
    ],
    "fr": [
      "Les vestiges du Château de Rochefort, datant du Moyen-Age, sont situés sur la colline à l'entrée du Village. Bien visibles de la plaine, ils sont accessibles par un sentier pédestre. \r\nUne table d'orientation permet de découvrir un vaste panorama."
    ],
    "es": [
      "Los restos del castillo de Rochefort, que datan de la Edad Media, se encuentran en la colina a la entrada del pueblo. Bien visibles desde la llanura, son accesibles por un sendero.\r\nUna mesa de orientación permite descubrir un vasto panorama."
    ],
    "nl": [
      "De overblijfselen van het kasteel van Rochefort, daterend uit de Middeleeuwen, liggen op de heuvel bij de ingang van het dorp. Ze zijn duidelijk zichtbaar vanaf de vlakte en toegankelijk via een wandelpad.\r\nEen oriëntatietafel biedt een panoramisch uitzicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ruines du Château de Rochefort"
    ]
  },
