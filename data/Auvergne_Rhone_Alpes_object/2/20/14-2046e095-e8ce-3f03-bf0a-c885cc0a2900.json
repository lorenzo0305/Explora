  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2bb2e8c0-4686-3899-ba41-50ff3e8debf3",
      "dc:description": {
        "de": [
          "Ein erstklassiger Service für gelassene Eigentümer und begeisterte Reisende.\nEmpfang nach Maß.\nThemenpakete, orchestriert in einer herzlichen Atmosphäre, für einen unvergesslichen Aufenthalt."
        ],
        "en": [
          "Top-of-the-range service for serene owners and delighted travelers.\nCustomized welcome.\nThemed packages, orchestrated in a warm atmosphere, for unforgettable stays."
        ],
        "it": [
          "Un servizio di alta gamma per proprietari senza preoccupazioni e viaggiatori soddisfatti.\nAccoglienza su misura.\nPacchetti a tema, orchestrati in un'atmosfera calorosa, per soggiorni indimenticabili."
        ],
        "fr": [
          "Un service haut de gamme pour des propriétaires sereins et des voyageurs enchantés.\nAccueil sur mesure.\nDes packs thématiques, orchestrés dans une ambiance chaleureuse, pour des séjours inoubliables."
        ],
        "es": [
          "Un servicio de alta gama para propietarios despreocupados y viajeros encantados.\nAcogida a medida.\nPaquetes temáticos, orquestados en un ambiente cálido, para estancias inolvidables."
        ],
        "nl": [
          "Een eersteklas service voor zorgeloze eigenaars en tevreden reizigers.\nOnthaal op maat.\nThemapakketten, georkestreerd in een warme sfeer, voor een onvergetelijk verblijf."
        ]
      },
      "@type": [
        "Description"
