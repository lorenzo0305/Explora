  "rdfs:comment": {
    "de": [
      "Der 1998 angelegte Garten Le Clos Fleuri richtet sich an alle Naturliebhaber, mit Blumen, dem Rauschen des Wassers und dem Gesang der Vögel im Hintergrund...\r\nBesichtigung nur nach vorheriger Anmeldung. Dauer: 45 Min."
    ],
    "en": [
      "Created in 1998, the Le Clos Fleuri garden is for all nature lovers, with flowers, the sound of water and birdsong in the background...\r\nVisits by appointment only. Duration: 45 min."
    ],
    "it": [
      "Creato nel 1998, il giardino del Clos Fleuri è per tutti gli amanti della natura, con i fiori, il suono dell'acqua e il canto degli uccelli come sottofondo...\r\nVisita solo su appuntamento. Durata: 45 minuti."
    ],
    "fr": [
      "Créé en 1998, le jardin Le Clos Fleuri s’adresse à tous les amoureux de la nature, avec des fleurs, le bruit de l’eau et le chant des oiseaux en toile de fond...\r\nVisite sur rendez-vous uniquement. Durée : 45 min."
    ],
    "nl": [
      "De in 1998 aangelegde tuin Le Clos Fleuri is voor alle natuurliefhebbers, met bloemen, het geluid van water en vogelgezang op de achtergrond...\r\nBezoek alleen op afspraak. Duur: 45 minuten."
    ],
    "es": [
      "Creado en 1998, el jardín de Clos Fleuri es para todos los amantes de la naturaleza, con flores, el sonido del agua y el canto de los pájaros de fondo...\r\nVisita con cita previa. Duración: 45 minutos."
    ]
  },
  "rdfs:label": {
