  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich oder entspannen Sie sich dank einer großen Auswahl an Aktivitäten. Unser qualifiziertes Personal freut sich darauf, Sie bei Ihren Aktivitäten allein, mit der Familie oder mit Freunden in einer freundlichen Atmosphäre zu begleiten!"
    ],
    "en": [
      "Come and work out or relax with a wide choice of activities. Our qualified staff will be delighted to accompany you in your activities, whether solo, with family or friends, in a friendly atmosphere!"
    ],
    "it": [
      "Venite ad allenarvi o a rilassarvi con un'ampia scelta di attività. Il nostro personale qualificato sarà lieto di aiutarvi a svolgere le vostre attività, da soli, in famiglia o con gli amici, in un'atmosfera amichevole!"
    ],
    "fr": [
      "Venez vous dépenser ou vous détendre grâce à un large choix d'activité. Notre personnel qualifié se fera un plaisir de vous accompagner dans vos activités en solo, famille ou entre amis, dans une ambiance conviviale !"
    ],
    "es": [
      "Venga a hacer ejercicio o a relajarse con una amplia selección de actividades. Nuestro personal cualificado estará encantado de ayudarle con sus actividades, ya sea solo, en familia o con amigos, ¡en un ambiente agradable!"
    ],
    "nl": [
      "Kom trainen of ontspannen met een ruime keuze aan activiteiten. Ons gekwalificeerd personeel helpt je graag bij je activiteiten, alleen, met het gezin of met vrienden, in een gezellige sfeer!"
    ]
  },
  "rdfs:label": {
