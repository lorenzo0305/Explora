  "rdfs:comment": {
    "de": [
      "Die Batterien von Quichat auf dem Mont Rachais und von Néron wurden Ende des 19."
    ],
    "en": [
      "Part of Grenoble's defensive system, the Quichat batteries on Mont Rachais and the Néron batteries were built at the end of the 19th century."
    ],
    "it": [
      "Integrate nel sistema difensivo di Grenoble, le batterie di Quichat sul monte Rachais e le batterie di Néron furono costruite alla fine del XIX secolo."
    ],
    "fr": [
      "Intégrées au dispositif défensif de Grenoble, les batteries du Quichat, sur le mont Rachais, et celles du Néron ont été aménagées à la fin du XIXe."
    ],
    "es": [
      "Parte del sistema defensivo de Grenoble, las baterías de Quichat, en el monte Rachais, y las de Néron se construyeron a finales del siglo XIX."
    ],
    "nl": [
      "De batterijen van Quichat op de berg Rachais en de batterijen van Néron werden aan het eind van de 19de eeuw in het verdedigingssysteem van Grenoble geïntegreerd."
    ]
  },
