  "rdfs:comment": {
    "de": [
      "Der Chefkoch Joël Paquelet bietet Ihnen gute Gerichte aus frischen und hochwertigen Produkten: schöne Fleischstücke, gegrilltes Gemüse, leckere Pizzen, aber nicht nur! Tagesgerichte mittags unter der Woche, After Work am Donnerstagabend."
    ],
    "en": [
      "Chef Joël Paquelet serves up tasty dishes made with fresh, quality produce: fine cuts of meat, grilled vegetables, tasty pizzas and more! Daily specials at lunchtime on weekdays, after work on Thursday evenings."
    ],
    "it": [
      "Lo chef Joël Paquelet propone piatti gustosi a base di prodotti freschi e di qualità, tra cui tagli di carne pregiati, verdure alla griglia e gustose pizze, ma non solo! Specialità giornaliere a pranzo durante la settimana, dopo il lavoro il giovedì sera."
    ],
    "fr": [
      "Le chef Joël Paquelet vous propose de bons petits plats élaborés à partir de produits frais et de qualité : belles pièces de viande, légumes grillés, pizzas savoureuses mais pas que ! Plats du jour les midis en semaine, after work le jeudi soir."
    ],
    "es": [
      "El Chef Joël Paquelet sirve sabrosos platos elaborados con productos frescos y de calidad, como finos cortes de carne, verduras a la parrilla y sabrosas pizzas, ¡pero eso no es todo! Especialidades diarias al mediodía durante la semana y los jueves por la noche después del trabajo."
    ],
    "nl": [
      "Chef-kok Joël Paquelet serveert smakelijke gerechten op basis van verse kwaliteitsproducten, waaronder fijne stukken vlees, gegrilde groenten en smakelijke pizza's, maar dat is nog niet alles! Dagelijkse specials tijdens lunchtijd doordeweeks, na het werk op donderdagavond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Braz & Co"
    ]
  },
