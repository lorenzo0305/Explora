  "rdfs:comment": {
    "de": [
      "Der Weiler Villemartin (1100 m) besitzt wie die anderen Weiler der Gemeinde Bozel ein tief verwurzeltes Erbe mit seiner Geschichte und seinen Schönheiten."
    ],
    "en": [
      "The hamlet of Villemartin (1100 m height) has got a real history well settle down with its beauty and its heritage, like the other villages of Bozel."
    ],
    "it": [
      "La frazione di Villemartin (1100 m), come le altre frazioni del comune di Bozel, ha un patrimonio radicato, con una storia e una bellezza proprie."
    ],
    "fr": [
      "Le hameau de Villemartin (1100 m), comme les autres hameaux de la commune de Bozel, possède une un patrimoine ancré, avec son histoire et ses beautés."
    ],
    "es": [
      "La aldea de Villemartin (1100 m), al igual que las demás aldeas del municipio de Bozel, posee un patrimonio muy arraigado, con su propia historia y belleza."
    ],
    "nl": [
      "Het gehucht Villemartin (1100 m) heeft, net als de andere gehuchten in de gemeente Bozel, een diepgeworteld erfgoed, met een eigen geschiedenis en schoonheid."
    ]
  },
