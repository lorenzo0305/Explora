  "rdfs:comment": {
    "de": [
      "Saisonales Gemüse, das mit Leidenschaft angebaut wird, wobei der Boden und die umliegende Natur respektiert werden. Die gesamte Produktion ist als biologischer Landbau zertifiziert und wird lokal ab Hof verkauft."
    ],
    "en": [
      "Seasonal vegetables, grown with passion and respect for the soil and surrounding nature. All produce is certified organic and sold locally from the farm."
    ],
    "it": [
      "Ortaggi di stagione, coltivati con passione e rispetto per la terra e la natura circostante. Tutti i prodotti sono certificati biologici e venduti localmente dalla fattoria."
    ],
    "fr": [
      "Des légumes de saison, cultivés avec passion tout en respectant le sol et la nature environnante. Toute la production est certifiée Agriculture Biologique et vendue localement depuis la ferme."
    ],
    "es": [
      "Verduras de temporada, cultivadas con pasión y respeto por la tierra y la naturaleza que las rodea. Todos los productos son ecológicos certificados y se venden localmente desde la granja."
    ],
    "nl": [
      "Seizoensgroenten, geteeld met passie en respect voor de grond en de omringende natuur. Alle producten zijn biologisch gecertificeerd en worden lokaal van de boerderij verkocht."
    ]
  },
