  "rdfs:comment": {
    "de": [
      "Diese Strecke ist eine Möglichkeit, diesen Pass der Bruderschaft auf eine neue Art und Weise inmitten der Natur mit einer Folge von kleinen Straßen und rollenden Pisten zu entdecken."
    ],
    "en": [
      "This route is an original way of discovering the Brotherhood Pass in the heart of nature, with a succession of small roads and rolling tracks."
    ],
    "it": [
      "Questo percorso è un modo per scoprire il passo della confraternita in modo nuovo, in mezzo alla natura, con un susseguirsi di stradine e sentieri ondulati."
    ],
    "fr": [
      "Ce parcours est une manière de découvrir ce col de la confrérie de manière inédite en pleine nature avec une succession de petites routes et pistes roulantes."
    ],
    "es": [
      "Esta ruta es una forma de descubrir el paso de la cofradía de una manera nueva en plena naturaleza con una sucesión de pequeños caminos y pistas onduladas."
    ],
    "nl": [
      "Deze route is een manier om de pas van de broederschap op een nieuwe manier te ontdekken, midden in de natuur met een opeenvolging van kleine wegen en glooiende paden."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ascent to Col de la Confrérie"
    ],
    "fr": [
      "Montée au Col de la Confrérie"
    ]
  },
