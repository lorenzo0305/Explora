  "rdfs:comment": {
    "de": [
      "Die Choristen der Dante Interpreter werden ein Repertoire aus traditionellen Liedern aus verschiedenen Regionen Italiens vortragen, die die religiösen und weltlichen Feste des Kalenders begleiten: Lieder der Kollekte und der Pastoral, des Karnevals, der Osterzeit und der Weihnachtszeit."
    ],
    "en": [
      "The Dante Interpretive Choristers will perform a repertoire of traditional songs from various regions of Italy, to accompany both religious and secular feasts of the calendar: quest and pastoral songs, carnival, Easter and Christmas."
    ],
    "it": [
      "I coristi della Dante eseguiranno un repertorio di canti tradizionali provenienti da varie regioni d'Italia per accompagnare le festività del calendario, sia religiose che laiche: canti di ricerca e pastorali, di carnevale, di Pasqua e di Natale."
    ],
    "fr": [
      "Les choristes de la Dante Interprèteront un répertoire composé de chants traditionnels de diverses régions d'Italie qui accompagnent les fêtes du calendrier, tant religieuses que profanes : chants de quête et pastorale, carnaval, de Pâques, et de Noël."
    ],
    "es": [
      "Los coristas de Dante interpretarán un repertorio de canciones tradicionales de diversas regiones de Italia para acompañar las festividades del calendario, tanto religiosas como profanas: canciones de búsqueda y pastorales, de carnaval, de Pascua y de Navidad."
    ],
    "nl": [
      "De Dante koorleden zullen een repertoire van traditionele liederen uit verschillende regio's van Italië ten gehore brengen ter begeleiding van de festiviteiten van de kalender, zowel religieus als wereldlijk: liederen van zoektocht en pastorale, carnaval, Pasen en Kerstmis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Récital de la chorale AnDante"
    ]
  },
