  "rdfs:comment": {
    "de": [
      "Die beiden schrägen und sehr lustigen Schauspielerinnen haben Flauberts Meisterwerk gründlich und ohne die geringste Langeweile entstaubt - ein Genuss."
    ],
    "en": [
      "Performed by two quirky and very funny actresses, this thorough and never boring dusting of Flaubert's masterpiece is a delight."
    ],
    "it": [
      "Interpretata da due attrici stravaganti e molto divertenti, questa accurata e mai noiosa rivisitazione del capolavoro di Flaubert è una delizia."
    ],
    "fr": [
      "Porté par deux comédiennes décalées et très drôles, ce dépoussiérage en règle et sans le moindre ennui du chef-d’œuvre de Flaubert est un régal."
    ],
    "nl": [
      "Uitgevoerd door twee eigenzinnige en erg grappige actrices is dit grondige en nooit saaie afstoffen van Flauberts meesterwerk een genot."
    ],
    "es": [
      "Interpretada por dos actrices extravagantes y muy divertidas, esta minuciosa y nunca aburrida revisión de la obra maestra de Flaubert es una delicia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Madame Bovary en plus drôle et moins long"
    ]
  },
