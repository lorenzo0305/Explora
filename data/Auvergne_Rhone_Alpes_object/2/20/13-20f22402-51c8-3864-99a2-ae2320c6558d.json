  "rdfs:comment": {
    "de": [
      "Sie können verschiedene Vorspeisen, Hauptgerichte und Desserts probieren, die von unserem Chefkoch und seinem Team hausgemacht sind, sowie Pizzas, deren Teig täglich von unseren Pizzabäckern geknetet wird."
    ],
    "en": [
      "You'll be able to sample a range of starters, main courses and desserts, all homemade by our chef and his team, as well as pizzas whose dough is kneaded daily by our pizza-makers."
    ],
    "it": [
      "Potrete assaggiare diversi antipasti, piatti e dessert preparati dal nostro chef e dal suo team, oltre a pizze il cui impasto viene lavorato ogni giorno dai nostri pizzaioli."
    ],
    "fr": [
      "Vous pourrez déguster différentes entrées, des plats, des desserts faits maison par notre chef et toute son équipe, ainsi que des pizzas dont la pâte est pétrie tous les jours par nos pizzaïolos."
    ],
    "es": [
      "Podrá degustar diferentes entrantes, platos y postres elaborados por nuestro chef y su equipo, así como pizzas cuya masa es amasada cada día por nuestros pizzeros."
    ],
    "nl": [
      "Je kunt genieten van een reeks voorgerechten, hoofdgerechten en desserts die onze chef-kok en zijn team zelf maken, evenals pizza's van deeg dat dagelijks door onze pizzabakkers wordt gekneed."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Loft"
    ]
  },
