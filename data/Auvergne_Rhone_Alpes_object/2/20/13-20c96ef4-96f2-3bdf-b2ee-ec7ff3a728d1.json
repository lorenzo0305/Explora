  "rdfs:comment": {
    "de": [
      "Das Relais Gourmand ist ein Ort der Ruhe, der an die warme Umgebung eines familiären Esszimmers erinnert. Genießen Sie auf der Terrasse am Ufer des Canal de Savières eine traditionelle Küche mit lokalen Produkten."
    ],
    "en": [
      "The Relais Gourmand is a peaceful setting reminiscent of a family dining room. Enjoy traditional cuisine using local produce on the terrace beside Savières canal."
    ],
    "it": [
      "Le Relais Gourmand è un luogo tranquillo che ricorda l'ambiente caloroso di una sala da pranzo. Approfittate della terrazza in riva al canal de Savière."
    ],
    "fr": [
      "Le Relais Gourmand est un espace de tranquillité qui rappelle le cadre chaleureux d'une salle à manger familiale. Dégustez une cuisine traditionnelle avec des produits locaux sur la terrasse située au bord du Canal de Savières."
    ],
    "nl": [
      "Het Relais Gourmand is een rustige plek die doet denken aan de warmte van een familiale eetkamer. Geniet van traditionele gerechten met lokale producten op het terras gelegen aan de oevers van het Canal de Savières."
    ],
    "es": [
      "El Relais Gourmand es un espacio tranquilo que recuerda a un cálido comedor familiar. Disfrute de la cocina tradicional con productos locales en la terraza situada a orillas del Canal de Savières."
    ]
  },
