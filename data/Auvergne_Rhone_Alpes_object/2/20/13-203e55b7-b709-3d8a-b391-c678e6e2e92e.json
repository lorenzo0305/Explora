  "rdfs:comment": {
    "de": [
      "Um ein gutes, savoyisches Fondue oder andere regionale\r\nSpezialitäten zu genießen ist L’Etable du Savoyard genau\r\nder richtige Ort."
    ],
    "en": [
      "To taste a delicious Savoy fondue or other regional specialities,\r\nL’Étable du Savoyard is the place for you."
    ],
    "it": [
      "L'Etable du Savoyard vi propone specialità locali in un'antica fattoria dall'ambiente tipicamente savoiardo."
    ],
    "fr": [
      "Pour déguster une bonne fondue savoyarde ou d'autres spécialités de la région, l'Etable du Savoyard est l'endroit qu'il vous faut. Quelques pièces de vaisselles en poterie faites par Mr et Mme. Ouvert du jeudi au dimanche midi et soir."
    ],
    "es": [
      "L'Etable du Savoyard es el lugar indicado para degustar una buena fondue saboyana u otras especialidades de la región. Abierto de jueves a domingo para almorzar y cenar."
    ],
    "nl": [
      "Bij L'Etable du Savoyard kun je terecht voor een goede Savoyaardse fondue of andere specialiteiten uit de streek. Geopend van donderdag tot zondag voor lunch en diner."
    ]
  },
