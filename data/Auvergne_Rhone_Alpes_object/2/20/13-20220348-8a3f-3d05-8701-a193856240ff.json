          "additionalInformation": {
            "de": [
              "Außerhalb der Sommersaison samstags auf Vorbestellung (ab 6 Personen).\r\nAn ungeraden Freitagen Schließung um 15.00 Uhr.\r\nDurchgehender Service bis 15:00 Uhr im Winter und 16:00 Uhr an sonnigen Tagen."
            ],
            "en": [
              "Saturdays outside summer season by reservation (minimum 6 people).\r\nOdd-numbered Fridays close at 3:00 pm.\r\nContinuous service until 3:00 pm in winter and 4:00 pm in summer."
            ],
            "it": [
              "Sabato fuori stagione su prenotazione (minimo 6 persone).\r\nI venerdì dispari chiudono alle 15:00.\r\nServizio continuo fino alle 15:00 in inverno e alle 16:00 con il bel tempo."
            ],
            "fr": [
              "Hors saisons estivales, les samedis sur réservation (à partir de 6 personnes).\r\nLes vendredis impairs fermeture à 15h00.\r\nService continu jusqu'à 15h00 en hiver et 16h00 aux beaux jours."
            ],
            "nl": [
              "Zaterdag buiten het seizoen op afspraak (minimaal 6 personen).\r\nOp oneven vrijdagen sluiten we om 15.00 uur.\r\nDoorlopende service tot 15.00 uur in de winter en 16.00 uur bij mooi weer."
            ],
            "es": [
              "Sábados fuera de temporada previo acuerdo (mínimo 6 personas).\r\nLos viernes impares cierran a las 15 h.\r\nServicio continuo hasta las 15 h en invierno y hasta las 16 h con buen tiempo."
            ]
          },
