  "rdfs:comment": {
    "de": [
      "Restaurant, Teestube im Herzen der Fußgängerzone im historischen Zentrum von Tournon sur Rhône. Ein gemütlicher, einfacher, authentischer Ort für ein gutes, hausgemachtes Essen. Durchgehender Service bis 15.00 Uhr im Winter und 16.00 Uhr an schönen Tagen."
    ],
    "en": [
      "Restaurant and tea room in the heart of the pedestrian street in the historic center of Tournon sur Rhône. A warm, simple and authentic place to enjoy a good home-cooked meal. Continuous service until 3:00 pm in winter and 4:00 pm in summer."
    ],
    "it": [
      "Ristorante e sala da tè nel cuore della via pedonale del centro storico di Tournon sur Rhône. Un luogo caldo, semplice e autentico dove gustare un buon pasto fatto in casa."
    ],
    "fr": [
      "Restaurant, salon de thé au cœur de la rue piétonne dans le centre historique de Tournon sur Rhône. Un lieu chaleureux, simple, authentique autour d'un bon repas fait maison."
    ],
    "es": [
      "Restaurante y salón de té en plena calle peatonal del centro histórico de Tournon sur Rhône. Un lugar cálido, sencillo y auténtico para disfrutar de una buena comida casera."
    ],
    "nl": [
      "Restaurant en tearoom in het hart van de autovrije straat in het historische centrum van Tournon sur Rhône. Een warme, eenvoudige, authentieke plek om te genieten van een goede huisgemaakte maaltijd. Doorlopende bediening tot 15.00 uur in de winter en tot 16.00 uur op zonnige dagen."
    ]
  },
