  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Premiumauswahl für Ihre Winterabenteuer! Hochwertige Pull-in-Unterhosen, Thermobekleidung und UYN-Skisocken, Skihelme, Skibrillen und trendige Kleidung."
    ],
    "en": [
      "Discover premium Pull-in boxer shorts, UYN thermal wear and socks, ski helmets, goggles, and stylish clothing—all your essentials for comfort and adventure in one stop. Perfect additions to your ski wardrobe or as gifts!"
    ],
    "it": [
      "Scoprite una selezione di prima qualità per le vostre avventure invernali! Pantaloncini Pull-in di alta qualità, abbigliamento termico e calze da sci UYN, caschi da sci, maschere da sci e abbigliamento di tendenza."
    ],
    "fr": [
      "Découvrez une sélection premium pour vos aventures hivernales ! Caleçons de haute qualité Pull-in, vêtements thermiques et chaussettes de ski UYN, casques de ski, lunettes de ski et vêtements tendances."
    ],
    "nl": [
      "Ontdek een eersteklas selectie voor je winteravonturen! Pull-in shorts van hoge kwaliteit, thermokleding en UYN skisokken, skihelmen, skibrillen en trendy kleding."
    ],
    "es": [
      "Descubre una selección de primera calidad para tus aventuras invernales Pantalones cortos Pull-in de alta calidad, ropa térmica y calcetines de esquí UYN, cascos de esquí, gafas de esquí y ropa de moda."
    ]
  },
