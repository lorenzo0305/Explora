  "rdfs:comment": {
    "de": [
      "Eine gemütliche Einrichtung und ein herzlicher Empfang für eine kleine Gourmetpause. Hausgemachte Küche mit frischen Produkten zum Verzehr vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "A decor and a warm welcome for a little gourmet break. Homemade cuisine based on fresh products to eat on the spot or to take away."
    ],
    "it": [
      "Un arredamento e un caloroso benvenuto per una pausa gourmet. Cucina casalinga a base di prodotti freschi da consumare sul posto o da portare via."
    ],
    "fr": [
      "Un décor et un accueil chaleureux pour une petit pause Gourmande. Cuisine maison à base de produits frais à consommer sur place ou à emporter."
    ],
    "es": [
      "Una cálida bienvenida y una decoración para un pequeño descanso gourmet. Cocina casera con productos frescos para comer en casa o para llevar."
    ],
    "nl": [
      "Een decor en een warm welkom voor een kleine gastronomische vakantie. Zelfgemaakte gerechten op basis van verse producten om ter plekke te eten of mee te nemen."
