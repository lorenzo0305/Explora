  "rdfs:comment": {
    "de": [
      "Im Rahmen der landesweiten Veranstaltung \"Fête du court métrage\" organisiert die Couveuse am Samstag, den 21.03. Vorführungen für Kinder und Jugendliche. Das Ziel dieses Festes: den Zugang zu großen Kurzfilmen zu erleichtern, um die Entdeckung des Kurzfilms zu fördern."
    ],
    "en": [
      "As part of the national short film festival, La Couveuse is organizing screenings for children and teenagers on Saturday, March 21. The aim of this festival is to facilitate access to great short films and help people discover short films."
    ],
    "it": [
      "Nell'ambito del festival nazionale del cortometraggio, sabato 21/03 La Couveuse organizza proiezioni per bambini e ragazzi. L'obiettivo del festival è quello di facilitare la scoperta dei cortometraggi da parte di bambini e ragazzi."
    ],
    "fr": [
      "Dans le cadre de l'événement national, la Fête du court métrage, la Couveuse organise des projections pour les enfants et ados le samedi 21/03. L'objectif de cette fête : faciliter l'accès à de grands films courts pour faire découvrir le court métrage."
    ],
    "nl": [
      "In het kader van het nationale kortfilmfestival organiseert La Couveuse op zaterdag 21/03 voorstellingen voor kinderen en tieners. Het doel van het festival is om het voor kinderen en tieners makkelijker te maken om korte films te ontdekken."
    ],
    "es": [
      "En el marco del festival nacional de cortometrajes, La Couveuse organiza el sábado 21/03 proyecciones para niños y adolescentes. El objetivo del festival es facilitar el descubrimiento del cortometraje a niños y adolescentes."
    ]
  },
  "rdfs:label": {
