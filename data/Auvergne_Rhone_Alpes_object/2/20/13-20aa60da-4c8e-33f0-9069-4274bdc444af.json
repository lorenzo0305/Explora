  "rdfs:comment": {
    "de": [
      "Chakâm bedeutet \"Gedicht in literarischem Persisch\". Drei Musikerinnen enthüllen eine Sprache, in der die Saiten in einen Dialog treten, sich erheben und sich in einem manchmal mächtigen, manchmal beruhigten Atem wiederfinden."
    ],
    "en": [
      "Chakâm, meaning \"poem in literary Persian\", is a language of three musicians, in which strings converse, exalt each other and find each other in a breath that is sometimes powerful, sometimes soothing."
    ],
    "it": [
      "Chakâm, che significa \"poema in persiano letterario\", è un gruppo di tre musicisti che rivelano un linguaggio in cui le corde dialogano, si esaltano a vicenda e si uniscono in un respiro a volte potente, a volte rilassante."
    ],
    "fr": [
      "Chakâm, signifiant « poème en persan littéraire », c’est trois musiciennes qui dévoilent un langage où les cordes dialoguent, s’exaltent et se retrouvent dans un souffle tantôt puissant, tantôt apaisé."
    ],
    "nl": [
      "Chakâm, wat \"gedicht in literair Perzisch\" betekent, is een groep van drie muzikanten die een taal onthullen waarin de snaren converseren, elkaar verheffen en samenkomen in een adem die soms krachtig, soms rustgevend is."
    ],
    "es": [
      "Chakâm, que significa \"poema en persa literario\", es un grupo de tres músicos que revelan un lenguaje en el que las cuerdas conversan, se exaltan y se unen en un aliento a veces poderoso, a veces tranquilizador."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ensemble Chakâm"
    ]
  },
