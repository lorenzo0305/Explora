  "rdfs:comment": {
    "de": [
      "Bereiten Sie Ihre Geschmacksknospen und Ihre Neugierde vor!\r\nEin Wochenende lang laden wir Sie ein, den Wein und die Menschen, die ihn leben lassen, zu feiern."
    ],
    "en": [
      "Get your taste buds and your curiosity ready!\r\nFor one weekend, we invite you to celebrate wine and those who bring it to life."
    ],
    "it": [
      "Preparate le vostre papille gustative e la vostra curiosità!\r\nNel corso di un fine settimana, vi invitiamo a celebrare il vino e coloro che lo fanno vivere."
    ],
    "fr": [
      "Préparez vos papilles et votre curiosité !\r\nLe temps d'une week-end, nous vous invitons à célébrer le vin et ceux qui le font vivre."
    ],
    "es": [
      "¡Prepare sus papilas gustativas y su curiosidad!\r\nA lo largo de un fin de semana, le invitamos a celebrar el vino y a quienes le dan vida."
    ],
    "nl": [
      "Maak je smaakpapillen en je nieuwsgierigheid klaar!\r\nGedurende een weekend nodigen we je uit om wijn te vieren en degenen die het tot leven brengen."
    ]
  },
