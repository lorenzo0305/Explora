  "rdfs:comment": {
    "de": [
      "Das Restaurant Le P'tit Bouchon in der Galerie l'Everest in Plagne Centre empfängt Sie jeden Tag mittags und abends. \r\nAußer am Dienstagabend und am Mittwochmittag und -abend.\r\nJeden Mittag bietet das Restaurant ein Tagesmenü an."
    ],
    "en": [
      "Le P'tit Bouchon restaurant, located in the Everest gallery in Plagne Centre, welcomes you every day for lunch and dinner. \r\nExcept Tuesday evening and Wednesday lunchtime and evening.\r\nEvery lunchtime, the restaurant offers a menu of the dayday"
    ],
    "it": [
      "Il ristorante Le P'tit Bouchon, situato nella galleria Everest a Plagne Centre, vi accoglie tutti i giorni per pranzo e cena.\r\nTranne martedì sera e mercoledì a pranzo e sera\r\nOgni giorno a pranzo, il ristorante propone un menù del giorno"
    ],
    "fr": [
      "Le restaurant Le P'tit Bouchon, situé dans la galerie l'Everest à Plagne Centre, vous accueille tous les jours, midi et soir. \r\nSauf le mardi soir et le mercredi midi et soir\r\nTous les midis, le restaurant propose un menu du jour"
    ],
    "nl": [
      "Restaurant Le P'tit Bouchon, gelegen in de Everest galerij in Plagne Centre, verwelkomt je elke dag voor lunch en diner. \r\nBehalve op dinsdagavond en woensdag 's middags en 's avonds.\r\nElke middag biedt het restaurant een menu van de dag aan"
    ],
    "es": [
      "El restaurante Le P'tit Bouchon, situado en la galería Everest de Plagne Centre, le da la bienvenida todos los días para el almuerzo y la cena.\r\nExcepto los martes por la noche y los miércoles a mediodía y por la noche\r\nCada mediodía, el restaurante propone un menú del día"
    ]
  },
