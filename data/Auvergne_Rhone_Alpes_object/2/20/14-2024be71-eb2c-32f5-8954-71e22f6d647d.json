      "@id": "https://data.datatourisme.fr/a977e1c0-7111-38f0-a742-82274ba8e4c0",
      "dc:description": {
        "de": [
          "Kommen Sie mit Ihrer Familie, Ihren Freunden oder Kollegen. Finden Sie Gesellschaftsspiele, Outdoor-Spiele, alte Spiele... und sogar DIY-Kits (Do It Yourself)."
        ],
        "en": [
          "Come with family, friends or colleagues. Find board games, outdoor games, vintage games... and even DIY (Do It Yourself) kits."
        ],
        "it": [
          "Venite con la famiglia, gli amici o i colleghi. Trovate giochi da tavolo, giochi all'aperto, giochi vintage... e persino kit per il fai da te."
        ],
        "fr": [
          "Venez en famille, entre amis ou entre collègues. Retrouver des jeux de société, d'extérieur, anciens... et même des kits DIY (Do It Yourself)."
        ],
        "es": [
          "Venga con su familia, amigos o compañeros de trabajo. Encuentra juegos de mesa, juegos de exterior, juegos vintage... e incluso kits DIY (Do It Yourself)."
        ],
        "nl": [
          "Kom langs met je familie, vrienden of collega's. Vind bordspellen, buitenspellen, vintage spellen... en zelfs doe-het-zelfpakketten."
        ]
      },
