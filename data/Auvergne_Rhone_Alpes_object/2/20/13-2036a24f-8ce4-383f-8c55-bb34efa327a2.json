  "rdfs:comment": {
    "de": [
      "Willkommen in der schelmischen Welt von Claude Ponti?\r\nDie Ateliers des Arts laden Sie ein, Blaise et le château von Anne Hiversère zu entdecken, ein farbenfrohes und poetisches musikalisches Märchen."
    ],
    "en": [
      "Welcome to the mischievous world of Claude Ponti!\r\nLes Ateliers des Arts invites you to discover Blaise et le château by Anne Hiversère, a colorful and poetic musical tale."
    ],
    "it": [
      "Benvenuti nel mondo birichino di Claude Ponti!\r\nLes Ateliers des Arts vi invitano a scoprire Blaise et le château di Anne Hiversère, un racconto musicale colorato e poetico."
    ],
    "fr": [
      "Bienvenue dans l’univers malicieux de Claude Ponti !\r\nLes Ateliers des Arts vous invitent à découvrir Blaise et le château d’Anne Hiversère, un conte musical coloré et poétique."
    ],
    "es": [
      "¡Bienvenido al mundo travieso de Claude Ponti!\r\nLes Ateliers des Arts le invitan a descubrir Blaise et le château de Anne Hiversère, un cuento musical colorista y poético."
    ],
    "nl": [
      "Welkom in de ondeugende wereld van Claude Ponti!\r\nLes Ateliers des Arts nodigen je uit om Blaise et le château van Anne Hiversère te ontdekken, een kleurrijk en poëtisch muzikaal verhaal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conte musical jeune public : Blaise et le château d'Anne Hiversère"
    ]
  },
