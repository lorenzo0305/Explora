  "rdfs:comment": {
    "de": [
      "Unsere Taxis befördern Sie schnell und sicher, egal wohin Sie wollen, auch wenn Sie die Region erkunden möchten. Wir bieten medizinische Transporte mit unseren Taxis an, die von allen Krankenkassen anerkannt sind."
    ],
    "en": [
      "Our cabs will transport you quickly and safely, whatever your destination, even if you're exploring the region. We provide medical transport with our cabs approved by all health insurance funds."
    ],
    "it": [
      "I nostri taxi vi trasportano in modo rapido e sicuro, qualunque sia la vostra destinazione, anche alla scoperta della regione. Forniamo il vostro trasporto medico con i nostri taxi approvati da tutte le compagnie di assicurazione sanitaria."
    ],
    "fr": [
      "Nos taxis vous transportent rapidement et en toute sécurité, quelle que soit votre destination y compris pour la découverte de la région. Nous assurons vos transports médicaux avec nos taxis conventionnées toutes caisses d'assurance maladie."
    ],
    "nl": [
      "Onze taxi's vervoeren je snel en veilig, ongeacht je bestemming, ook om de regio te ontdekken. We bieden medisch vervoer en onze taxi's zijn goedgekeurd door alle ziekenfondsen."
    ],
    "es": [
      "Nuestros taxis le transportan de forma rápida y segura, sea cual sea su destino, incluso para descubrir la región. Le proporcionamos su transporte médico con nuestros taxis homologados por todas las compañías de seguros médicos."
    ]
  },
