  "rdfs:comment": {
    "de": [
      "Genießen Sie unsere köstlichen Kebabs, die mit frischen und hochwertigen Zutaten zubereitet werden. Zum Mitnehmen für eine schnelle Mahlzeit oder zum Verzehr vor Ort."
    ],
    "en": [
      "Come and enjoy our delicious kebabs, prepared with fresh, quality ingredients. Take away for a quick meal, or enjoy them on site."
    ],
    "it": [
      "Venite a gustare i nostri deliziosi kebab, preparati con ingredienti freschi e di qualità. Da portare via per un pasto veloce o da gustare sul posto."
    ],
    "fr": [
      "Venez savourer nos délicieux kebabs, préparés avec des ingrédients frais et de qualité. À emporter pour un repas rapide ou à déguster sur place."
    ],
    "es": [
      "Venga y disfrute de nuestros deliciosos kebabs, preparados con ingredientes frescos y de calidad. Para llevar para una comida rápida o para disfrutar en el momento."
    ],
    "nl": [
      "Kom genieten van onze heerlijke kebabs, bereid met verse kwaliteitsingrediënten. Om mee te nemen voor een snelle maaltijd of om ter plekke van te genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
