  "rdfs:comment": {
    "de": [
      "SOMMER-AKTIVITÄT\r\nFliegen Sie auf der Höhenseilrutsche!\r\nDie Seilrutsche ist vom Sessellift Lac de la Vieille aus erreichbar und führt Sie über den See"
    ],
    "en": [
      "At an altitude of 2,300m fly away on a zip wire!\r\nAccess by the Lac de la Vieille chairlift. Fly over the lake for an unforgettable experience!"
    ],
    "it": [
      "Decollate sulla teleferica in alta quota!\r\nRaggiungibile dalla seggiovia del Lac de la Vieille, sorvolate il lago per fare il pieno di sensazioni!"
    ],
    "fr": [
      "ACTIVITE D'ETE\r\nEnvolez-vous sur la tyrolienne d’altitude !\r\nAccessible depuis le télésiège du Lac de la Vieille, survolez le lac pour un max de sensations !"
    ],
    "nl": [
      "ZOMERACTIVITEIT\r\nGa de lucht in met de tokkelbaan!\r\nDeze is toegankelijk vanaf de Lac de la Vieille stoeltjeslift en vliegt over het meer voor maximale sensatie!"
    ],
    "es": [
      "ACTIVIDAD DE VERANO\r\n¡Surque los cielos en la tirolina de altura!\r\nAccesible desde el telesilla del lago de la Vieille, sobrevuele el lago para vivir emociones fuertes"
    ]
  },
