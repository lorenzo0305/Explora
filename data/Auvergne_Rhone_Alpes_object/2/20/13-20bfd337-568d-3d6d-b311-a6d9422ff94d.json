  "rdfs:comment": {
    "de": [
      "Als Kräuterbäuerin pflücke ich an unberührten Orten, wähle sorgfältig aus und baue sorgfältig etwa 30 aromatische und medizinische Pflanzen in Bioqualität an."
    ],
    "en": [
      "As a herbalist, I pick on preserved spots and carefully grow through organic methods 30 aromatic and medicinal plants.\r\nAfter harvest, I place them into a dryer in order to create tasty herbal teas and herbs that enhance your dishes."
    ],
    "it": [
      "Come agricoltore-erborista, raccolgo e seleziono con cura una trentina di piante aromatiche e medicinali biologiche provenienti da aree incontaminate."
    ],
    "fr": [
      "Paysanne herboriste, je cueille dans des lieux préservés, choisis avec minutie et cultive soigneusement une trentaine de plantes aromatiques et médicinales en bio."
    ],
    "es": [
      "Como agricultor-herborista, recolecto y selecciono cuidadosamente una treintena de plantas aromáticas y medicinales ecológicas de zonas vírgenes."
    ],
    "nl": [
      "Als kruidendokter kies ik op bewaarde plekken en groei ik zorgvuldig door organische methoden 30 aromatische en medicinale planten.\r\nNa de oogst plaats ik ze in een droger om smakelijke kruidenthee en kruiden te creëren die je gerechten verbeteren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sem'Arôme - Artisan herbalist"
    ],
    "fr": [
      "Sem'Arôme - Paysanne herboristerie"
    ],
    "nl": [
      "Sem'Arôme - Ambachtelijke kruidkundige"
    ]
  },
