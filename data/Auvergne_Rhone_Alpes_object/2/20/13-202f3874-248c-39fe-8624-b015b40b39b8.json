  "rdfs:comment": {
    "de": [
      "Beaujolais Wine Experiences ist eine kleine französische Tourismusagentur, die sich auf die Organisation von privaten Touren rund um Wein und Gastronomie spezialisiert hat, hauptsächlich im Beaujolais, in französischer und englischer Sprache"
    ],
    "en": [
      "Beaujolais Wine Experiences is a small French tourist agency specializing in organizing private wine and gastronomy tours, mainly in the Beaujolais region, in French and English"
    ],
    "it": [
      "Beaujolais Wine Experiences è una piccola agenzia turistica francese specializzata nell'organizzazione di tour privati del vino e della gastronomia, principalmente nella regione del Beaujolais, in francese e in inglese"
    ],
    "fr": [
      "Beaujolais Wine Experiences est une petite agence touristique française spécialisée dans l'organisation de circuits privés autour du vin et de la gastronomie, principalement dans le Beaujolais, en français et en anglais"
    ],
    "nl": [
      "Beaujolais Wine Experiences is een klein Frans toeristenbureau gespecialiseerd in het organiseren van privé wijn- en gastronomietours, voornamelijk in de Beaujolais, in het Frans en Engels"
    ],
    "es": [
      "Beaujolais Wine Experiences es una pequeña agencia turística francesa especializada en la organización de viajes privados enogastronómicos, principalmente en la región de Beaujolais, en francés e inglés"
