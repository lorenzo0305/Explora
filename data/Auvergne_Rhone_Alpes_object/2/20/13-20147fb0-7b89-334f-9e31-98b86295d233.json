  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein Freilichtmuseum, das von den Ereignissen des Widerstands während des Zweiten Weltkriegs berichtet. Diese Autotour bietet Etappen, um die Ereignisse des Widerstands in Saint-Jean-en-Val, Saint-Etienne-sur-Usson und Chaméane zu entdecken."
    ],
    "en": [
      "Discover an open-air museum of resistance events during the Second World War. This self-guided tour includes stops to discover resistance events in Saint-Jean-en-Val, Saint-Etienne-sur-Usson and Chaméane."
    ],
    "it": [
      "Scoprite un museo all'aperto che racconta gli eventi della Resistenza durante la Seconda Guerra Mondiale. Questo tour in auto prevede soste per scoprire gli eventi della Resistenza a Saint-Jean-en-Val, Saint-Etienne-sur-Usson e Chaméane."
    ],
    "fr": [
      "Partez à la découverte d’un musée à ciel ouvert relatant des faits de résistance durant la seconde Guerre Mondiale. Ce circuit auto propose des étapes pour découvrir des événements de résistance à Saint-Jean-en-Val, Saint-Etienne-sur-Usson et Chaméane."
    ],
    "nl": [
      "Ontdek een openluchtmuseum dat de gebeurtenissen van het verzet tijdens de Tweede Wereldoorlog vertelt. Deze selfdrive-tour omvat stops om de verzetsgebeurtenissen in Saint-Jean-en-Val, Saint-Etienne-sur-Usson en Chaméane te ontdekken."
    ],
    "es": [
      "Descubra un museo al aire libre que narra los acontecimientos de la Resistencia durante la Segunda Guerra Mundial. Este viaje en coche incluye paradas para descubrir los acontecimientos de la resistencia en Saint-Jean-en-Val, Saint-Etienne-sur-Usson y Chaméane."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit \"Chemin de la résistance\""
    ]
  },
