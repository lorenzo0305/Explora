  "rdfs:comment": {
    "de": [
      "Die Kirche von Copponex ist dem Heiligen Andreas gewidmet. Sie wurde auf einem alten heidnischen Tempel errichtet, der der Jagdgöttin Diana gewidmet war."
    ],
    "en": [
      "The church in Copponex is dedicated to Saint-André, and was built on an ancient pagan temple dedicated to the huntress goddess Diana."
    ],
    "it": [
      "La chiesa di Copponex è dedicata a Saint-André e fu costruita sul sito di un antico tempio pagano dedicato alla dea cacciatrice Diana."
    ],
    "fr": [
      "L'église de Copponex  est dédiée à Saint -André, elle fut bâtie sur un ancien temple païen dédié à la déesse chasseresse Diane."
    ],
    "es": [
      "La iglesia de Copponex está dedicada a Saint-André y se construyó en el emplazamiento de un antiguo templo pagano dedicado a la diosa Diana."
    ],
    "nl": [
      "De kerk van Copponex is gewijd aan Sint-Andreas en is gebouwd op een oude heidense tempel gewijd aan de godin Diana."
    ]
  },
