  "rdfs:comment": {
    "de": [
      "Modal im Herzen, Improvisator in der Seele, Akademiker im Geiste, Azeri durch seine Wurzeln: Eine kulturelle Alchemie durchdringt die Fingerspitzen von Shahin Novrasli jedes Mal, wenn er spielt."
    ],
    "en": [
      "Modal at heart, improvisational at heart, academic at heart, Azeri at heart: a cultural alchemy runs through Shahin Novrasli's fingertips every time he plays."
    ],
    "it": [
      "Modale nel cuore, improvvisativo nel cuore, accademico nel cuore, azero nel cuore: un'alchimia culturale scorre tra le dita di Shahin Novrasli ogni volta che suona."
    ],
    "fr": [
      "Modal de cœur, improvisateur d’âme, académique d’esprit, Azéri par ses racines : une alchimie culturelle traverse le bout des doigts de Shahin Novrasli chaque fois qu’il joue."
    ],
    "es": [
      "Modalista de corazón, improvisador de corazón, académico de corazón, azerí de corazón: una alquimia cultural recorre las yemas de los dedos de Shahin Novrasli cada vez que toca."
    ],
    "nl": [
      "Modaal in hart en nieren, improviserend in hart en nieren, academisch in hart en nieren, Azerisch in hart en nieren: elke keer als Shahin Novrasli speelt, stroomt er een culturele alchemie door zijn vingertoppen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert jazz - Shahin Novrasli"
    ]
  },
