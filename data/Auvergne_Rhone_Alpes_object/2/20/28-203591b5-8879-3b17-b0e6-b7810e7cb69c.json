  "rdfs:comment": {
    "de": [
      "Die Kirche Saint Martin de Montigny wurde von den Herren von Halluin an der Stelle einer alten Kirche erbaut und am 15.8.1919 als historisches Monument klassifiziert."
    ],
    "en": [
      "Listed as a historic monument on 15/08/1919, the church of Saint Martin de Montigny was built by the Lords of Halluin on the site of an earlier church."
    ],
    "it": [
      "Classificata come monumento storico il 15/08/1919, la chiesa di Saint Martin de Montigny fu costruita dai signori di Halluin sul sito di una chiesa precedente."
    ],
    "fr": [
      "Edifice religieux classé au titre des monuments historiques le 15/08/1919, l’église saint Martin de Montigny a été construite par les seigneurs d’Halluin sur l'emplacement d'une ancienne église."
    ],
    "es": [
      "Declarada monumento histórico el 15/08/1919, la iglesia de Saint Martin de Montigny fue construida por los señores de Halluin en el emplazamiento de una iglesia anterior."
    ],
    "nl": [
      "De kerk Saint Martin de Montigny, die op 15/08/1919 op de lijst van historische monumenten werd geplaatst, werd gebouwd door de Heren van Halluin op de plaats van een eerdere kerk."
    ]
  },
