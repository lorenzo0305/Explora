  "rdfs:comment": {
    "de": [
      "Die Empfindungen des Körpers genießen, ihn atmen spüren, den Geist beruhigen, seinen Gefühlen vertrauen, sich mit seiner Freude verbinden."
    ],
    "en": [
      "Taste your body's sensations, feel it breathe, calm your mind, trust your feelings, connect with your joy."
    ],
    "it": [
      "Assaporate le sensazioni del vostro corpo, sentitelo respirare, calmate la mente, fidatevi dei vostri sentimenti e connettetevi con la vostra gioia."
    ],
    "fr": [
      "Gouter aux sensations du corps, le sentir respirer, apaiser son mental, faire confiance à ses ressentis, se connecter à sa joie."
    ],
    "es": [
      "Saborea las sensaciones de tu cuerpo, siéntelo respirar, calma tu mente, confía en tus sentimientos y conecta con tu alegría."
    ],
    "nl": [
      "Proef de sensaties van je lichaam, voel het ademen, kalmeer je geest, vertrouw op je gevoelens en maak contact met je vreugde."
    ]
  },
