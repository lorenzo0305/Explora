  "rdfs:comment": {
    "de": [
      "Hoch gelegenes Dorf Tailhac: Kirche aus dem 15. Jahrhundert. Aussichtspunkt mit Blick auf die Monts d'Auvergne. In der Nähe: Dolmen der \"Thuile aux Fées\"."
    ],
    "en": [
      "Perched village of Tailhac: 15th-century church. View of the Auvergne mountains. Nearby, the \"Thuile aux Fées\" dolmen."
    ],
    "it": [
      "Villaggio arroccato di Tailhac: chiesa del XV secolo. Vista sulle montagne dell'Alvernia. Nelle vicinanze, il dolmen \"Thuile aux Fées\"."
    ],
    "fr": [
      "Village perché de Tailhac : Église du XVe siècle. Point de vue sur les monts d’Auvergne. À proximité, dolmen de la « Thuile aux Fées »."
    ],
    "es": [
      "Pueblo encaramado de Tailhac: iglesia del siglo XV. Vista de las montañas de Auvernia. Cerca, el dolmen \"Thuile aux Fées\"."
    ],
    "nl": [
      "Hooggelegen dorp Tailhac: kerk uit de 15e eeuw. Uitzicht op de bergen van de Auvergne. Vlakbij, de dolmen \"Thuile aux Fées\"."
    ]
  },
