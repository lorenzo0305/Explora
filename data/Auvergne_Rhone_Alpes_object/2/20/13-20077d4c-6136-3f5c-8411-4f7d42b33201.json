  "rdfs:comment": {
    "de": [
      "Seit 30 Jahren zieht die Eishöhle von Alpe d'Huez, die auf 2700 m Höhe künstlich angelegt wurde, auf 120 m Galerie und Iglu ihre schönsten Kleider an, um dem Publikum ein weißes Spektakel voller Magie und Verzückung zu bieten."
    ],
    "en": [
      "For the past 30 years, the Alpe d'Huez ice grotto, artificially created at an altitude of 2,700 meters, has been putting on its finest show with 120 meters of gallery and igloo, offering the public a white spectacle of magic and delight."
    ],
    "it": [
      "Da 30 anni, la grotta di ghiaccio dell'Alpe d'Huez, creata artificialmente a 2.700 metri di altitudine, offre il suo spettacolo più bello in una galleria e in un igloo di 120 metri, offrendo al pubblico uno spettacolo bianco di magia e delizia."
    ],
    "fr": [
      "Depuis 30 ans, la grotte de glace de l’Alpe d’Huez, créée de manière artificielle à 2700 mètres d’altitude, revêt ses plus beaux atouts sur 120 mètres de galerie et igloo pour offrir au public un spectacle blanc tout en magie et en ravissement."
    ],
    "nl": [
      "Sinds 30 jaar toont de ijsgrot van Alpe d'Huez, kunstmatig gecreëerd op 2700 meter hoogte, haar mooiste troeven in 120 meter galerij en iglo, en biedt het publiek een wit spektakel van magie en verrukking."
    ],
    "es": [
      "Desde hace 30 años, la cueva de hielo de Alpe d'Huez, creada artificialmente a 2.700 metros de altitud, ofrece su mejor espectáculo en una galería e iglú de 120 metros, ofreciendo al público un espectáculo blanco de magia y deleite."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ice Cave with Sculptures"
    ],
    "fr": [
      "Grotte de Glace"
    ],
    "nl": [
      "IJsgrot met sculpturen"
    ]
  },
