  "rdfs:comment": {
    "de": [
      "Kurse für Trial-Motorräder. Trial ist eine Disziplin, bei der es darum geht, leichte Motorräder auf technischen Strecken mit natürlichen oder künstlichen Hindernissen zu beherrschen, wobei Gleichgewicht, Kontrolle und Präzision gefördert werden."
    ],
    "en": [
      "Motorcycle trials courses. Trials is a discipline that involves mastering lightweight motorcycles on technical courses with natural or artificial obstacles, promoting balance, control and precision."
    ],
    "it": [
      "Lezioni di motociclismo. Il trial è una disciplina che prevede la padronanza di moto leggere su percorsi tecnici con ostacoli naturali o artificiali, promuovendo equilibrio, controllo e precisione."
    ],
    "fr": [
      "Cours de moto trial. Le trial est une discipline qui consiste à maîtriser des motos légères sur des parcours techniques avec des obstacles naturels ou artificiels, favorisant équilibre, contrôle et précision."
    ],
    "nl": [
      "Motorrijlessen. Trials is een discipline waarbij het gaat om het beheersen van lichtgewicht motoren op technische parcoursen met natuurlijke of kunstmatige hindernissen, waarbij balans, controle en precisie worden gestimuleerd."
    ],
    "es": [
      "Clases de trial en moto. El trial es una disciplina que consiste en dominar motos ligeras en recorridos técnicos con obstáculos naturales o artificiales, fomentando el equilibrio, el control y la precisión."
    ]
  },
  "rdfs:label": {
