  "rdfs:comment": {
    "de": [
      "Seit dem Frühjahr 2000 bieten wir Ihnen die Möglichkeit, Ihre Erdbeeren und Ihr Gemüse auf unseren Feldern zu pflücken."
    ],
    "en": [
      "Since spring 2000, we've been offering you the chance to pick your own strawberries and vegetables in our fields."
    ],
    "it": [
      "Dalla primavera del 2000, vi offriamo la possibilità di raccogliere le vostre fragole e verdure nei nostri campi."
    ],
    "fr": [
      "Depuis le printemps 2000, nous vous proposons de venir cueillir vos fraises et vos légumes dans nos champs."
    ],
    "nl": [
      "Sinds het voorjaar van 2000 bieden we je de kans om je eigen aardbeien en groenten te plukken op onze velden."
    ],
    "es": [
      "Desde la primavera de 2000, le ofrecemos la posibilidad de recoger sus propias fresas y verduras en nuestros campos."
    ]
  },
