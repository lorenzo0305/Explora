  "rdfs:comment": {
    "de": [
      "Verleih und Verkauf von Wintersportausrüstung, Spezialist für Nordic Skiing, Skateboarding, Klassik, Nordic Touring, Alpinski, Schneeschuhe, Schlitten, Radski, Sportbekleidung und Zubehör, im Herzen des Skigebiets Plans d'Hotonnes auf dem Plateau de Retord"
    ],
    "en": [
      "Hire and sale of winter sports equipment, Nordic and Alpine skis, snowshoes, sledges, wheel skis, sportswear and accessories, in the heart of the Plans d'Hotonnes resort."
    ],
    "it": [
      "Noleggio e vendita di attrezzature per gli sport invernali, specializzate in sci nordico, skateboard, classico, nordic walking, sci alpino, racchette da neve, slitte, sci a rotelle, abbigliamento sportivo e accessori, nel cuore della località di Les Plans d'Hotonnes sull'altopiano di Retord"
    ],
    "fr": [
      "Location et vente de matériel de sport d'hiver, spécialiste du ski nordique, skate, classique, rando nordique, ski alpin, raquettes, luges, skis roue, vêtements de sports et accessoires, au cœur de la station des Plans d'Hotonnes sur le Plateau de Retord"
    ],
    "nl": [
      "Verhuur en verkoop van wintersportartikelen, gespecialiseerd in nordic skiën, skateboarden, klassiek, nordic walking, alpineskiën, sneeuwschoenen, sleeën, rolski's, sportkleding en accessoires, in het hart van de wintersportplaats Les Plans d'Hotonnes op het plateau van Retord"
    ],
    "es": [
      "Alquiler y venta de material de deportes de invierno, especializado en esquí nórdico, skate, clásico, marcha nórdica, esquí alpino, raquetas de nieve, trineos, esquís de ruedas, ropa deportiva y accesorios, en el corazón de la estación de Les Plans d'Hotonnes, en la meseta de Retord"
    ]
  },
