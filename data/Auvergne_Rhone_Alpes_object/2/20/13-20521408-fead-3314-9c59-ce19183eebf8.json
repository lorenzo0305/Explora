  "rdfs:comment": {
    "de": [
      "Suchen Sie den besten Schnee des Skigebiets? Kommen Sie auf diese Pisten, die ganz im Norden liegen und nur aus Naturschnee bestehen. Ein Vergnügen nur für Kenner."
    ],
    "en": [
      "Looking for the best snow in the area? Head to these north-facing slopes, covered only with natural snow. A true delight reserved for connoisseurs."
    ],
    "it": [
      "Cercate la migliore neve della zona? Allora venite a godervi queste piste esposte a nord, che hanno solo neve naturale. Un piacere riservato agli intenditori."
    ],
    "fr": [
      "Vous cherchez la meilleure neige du domaine ? Venez sur ces pistes situées plein nord et uniquement en neige naturelle. Un plaisir réservé aux connaisseurs."
    ],
    "es": [
      "¿Busca la mejor nieve de la zona? Entonces venga a disfrutar de estas pistas orientadas al norte, que sólo tienen nieve natural. Un placer reservado a los entendidos."
    ],
    "nl": [
      "Op zoek naar de beste sneeuw van het gebied? Ga naar deze noordgerichte pistes, die uitsluitend met natuurlijke sneeuw bedekt zijn. Een waar genot voor de kenners."
    ]
  },
  "rdfs:label": {
