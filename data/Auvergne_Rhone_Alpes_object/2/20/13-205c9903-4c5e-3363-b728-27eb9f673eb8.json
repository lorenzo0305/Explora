  "rdfs:comment": {
    "de": [
      "Tiergestütztes Wohlbefinden und angepasste körperliche Aktivität für alle. Blandine bietet Tiergestützte Mediation und A.P.A.S.-Sitzungen für alle Personen an, die Probleme überwinden wollen, eine Pathologie, eine Krankheit oder eine Behinderung haben."
    ],
    "en": [
      "Well-being through animals and adapted physical activity for all. Blandine offers animal mediation and A.P.A.S. sessions for people with pathologies, illnesses or disabilities."
    ],
    "it": [
      "Benessere attraverso gli animali e attività fisica adattata per tutti. Blandine offre sessioni di mediazione animale e A.P.A.S. per chiunque abbia una patologia, una malattia o una disabilità e voglia superare i problemi."
    ],
    "fr": [
      "Le bien-être par l'animal et l'activité physique adaptée pour tous. Blandine propose des séances de médiation par l'animal et d' A.P.A.S pour toute personne souhaitant surmonter des problèmes, présentant une pathologie, une maladie ou un handicap."
    ],
    "nl": [
      "Welzijn door dieren en aangepaste lichaamsbeweging voor iedereen. Blandine biedt dierbemiddeling en A.P.A.S.-sessies voor iedereen met een ziekte, aandoening of beperking die problemen wil overwinnen."
    ],
    "es": [
      "Bienestar a través de los animales y la actividad física adaptada para todos. Blandine ofrece sesiones de mediación animal y A.P.A.S. para cualquier persona con una patología, enfermedad o discapacidad que quiera superar problemas."
    ]
  },
  "rdfs:label": {
