  "rdfs:comment": {
    "de": [
      "In einem zauberhaften, restaurierten Alm-Chalet auf der Anhöhe des Ortes Chinaillon gelegen bieten wir Ihnen eine regionaltypische Küche mit den Spezialitäten aus Savoyen an."
    ],
    "en": [
      "In a charming alpine chalet, at the upper end of Chinaillon, our cuisine features local tastes and flavors, where Savoyard specialties are in the spotlight."
    ],
    "it": [
      "In uno chalet di montagna restaurato e pieno di fascino, sulle alture di Chinaillon, vi proponiamo una cucina che profuma di terra, dove le specialità savoiarde sono onorate."
    ],
    "fr": [
      "Dans un chalet d'alpage restauré plein de charme, sur les hauteurs du Chinaillon, nous proposons une cuisine aux senteurs du terroir, où les spécialités savoyardes sont à l'honneur."
    ],
    "nl": [
      "In een gerestaureerd bergchalet vol charme, op de hoogten van Chinaillon, bieden wij een keuken met de geur van de grond, waar Savoyaardse specialiteiten in ere worden gehouden."
    ],
    "es": [
      "En un chalet de montaña restaurado y lleno de encanto, en las alturas de Chinaillon, ofrecemos una cocina con aroma a tierra, donde se honran las especialidades saboyanas."
    ]
  },
  "rdfs:label": {
