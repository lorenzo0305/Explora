  "rdfs:comment": {
    "de": [
      "Die katholische Kirche von Sainte-Euphémie-sur-Ouvèze befindet sich im mittelalterlichen Dorf gegenüber einem charmanten kleinen Platz."
    ],
    "en": [
      "The Catholic church of Sainte-Euphémie-sur-Ouvèze is located in the medieval village, opposite a charming little square."
    ],
    "it": [
      "La chiesa cattolica di Sainte-Euphémie-sur-Ouvèze si trova nel borgo medievale, di fronte a un'incantevole piazza."
    ],
    "fr": [
      "L'église catholique de Sainte-Euphémie-sur-Ouvèze se trouve dans le village médiéval, face à une charmante placette."
    ],
    "es": [
      "La iglesia católica de Sainte-Euphémie-sur-Ouvèze se encuentra en el pueblo medieval, frente a una encantadora plaza."
    ],
    "nl": [
      "De katholieke kerk van Sainte-Euphémie-sur-Ouvèze ligt in het middeleeuwse dorp, tegenover een charmant pleintje."
    ]
