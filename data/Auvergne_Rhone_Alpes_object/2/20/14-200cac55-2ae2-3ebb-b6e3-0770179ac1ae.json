  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/337b5ba6-d498-33ff-af44-b605263120c6",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag von 8:45 bis 12:30 Uhr und von 13:45 bis 19:30 Uhr\n\nSamstags von 8:45 bis 12:30 Uhr\n\nSonntag geschlossen\n\nAbholung :\n\n Zu den Öffnungszeiten der Apotheke\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday, 8.45am to 12.30pm and 1.45pm to 7.30pm\n\nSaturday from 8.45am to 12.30pm\n\nClosed on Sunday\n\nCollection:\n\n During pharmacy opening hours\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDal lunedì al venerdì, dalle 8.45 alle 12.30 e dalle 13.45 alle 19.30\n\nSabato dalle 8.45 alle 12.30\n\nChiuso la domenica\n\nRitiro:\n\n Durante gli orari di apertura della farmacia\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi de 8h45 à 12h30 et de 13h45 à 19h30\n\nLe samedi de 8h45 à 12h30\n\nFermeture le dimanche\n\nRetrait :\n\n Aux horaires d'ouverture de la pharmacie\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag van 8.45 tot 12.30 uur en van 13.45 tot 19.30 uur\n\nZaterdag van 8.45 tot 12.30 uur\n\nZondag gesloten\n\nOphalen:\n\n Tijdens openingsuren van de apotheek\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes, de 8.45 a 12.30 h. y de 13.45 a 19.30 h\n\nSábados de 8.45 a 12.30 horas\n\nDomingo cerrado\n\nRecogida:\n\n Durante el horario de apertura de la farmacia\n "
        ]
      },
