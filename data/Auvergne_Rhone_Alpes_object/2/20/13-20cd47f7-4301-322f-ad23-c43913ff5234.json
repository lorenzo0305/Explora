  "rdfs:comment": {
    "de": [
      "Bei Chez Maxime können Sie die Authentizität einer Familiengastronomie zu günstigen Preisen genießen. Wir sind auf Gerichte zum Mitnehmen und Partyservice spezialisiert und bringen Geselligkeit und Geschmack auf Ihre Tische und Veranstaltungen. Probieren Sie den Unterschied!"
    ],
    "en": [
      "At Maxime, savor the authenticity of family catering at affordable prices. Specializing in takeaways and catering services, we bring conviviality and taste to your tables and events. Taste the difference!"
    ],
    "it": [
      "Da Maxime, godetevi l'autenticità del catering familiare a prezzi accessibili. Specializzati in pasti da asporto e servizi di catering, portiamo convivialità e gusto sulle vostre tavole e ai vostri eventi. Assaggiate la differenza!"
    ],
    "fr": [
      "Chez Maxime, savourez l'authenticité d'une restauration familiale à prix doux. Spécialistes des plats à emporter et services traiteur, nous apportons convivialité et goût à vos tables et événements. Dégustez la différence !"
    ],
    "nl": [
      "Geniet bij Maxime van de authenticiteit van familiecatering tegen betaalbare prijzen. Als specialisten in afhaalmaaltijden en traiteurdiensten brengen wij gezelligheid en smaak aan uw tafels en evenementen. Proef het verschil!"
    ],
    "es": [
      "En Maxime, disfrute de la autenticidad de la restauración familiar a precios asequibles. Como especialistas en comidas para llevar y servicios de catering, llevamos la cordialidad y el sabor a sus mesas y eventos. ¡Pruebe la diferencia!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Chez Maxime"
    ]
  },
