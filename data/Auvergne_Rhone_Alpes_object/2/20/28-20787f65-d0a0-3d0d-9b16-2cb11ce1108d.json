  "rdfs:comment": {
    "de": [
      "Hotel - Restaurant - Traditionelle Küche - 60 Gedecke und 20 Gedecke auf der Terrasse.\n\nRestaurant geöffnet von Montag bis Donnerstag Abend: 19h bis 21h\nAkzeptierte Gruppen von 10 bis 60 Personen\n\nBuslinien - 31 Haltestelle \"Hem voisinage\".\n "
    ],
    "en": [
      "Hotel - Restaurant - Traditional cuisine - 60 covers and 20 covers on the terrace.\n\nRestaurant open Monday to Thursday evenings: 7pm to 9pm\nGroups accepted from 10 to 60 people\n\nBus lines - 31 stop \"Hem voisinage\".\n "
    ],
    "it": [
      "Hotel - Ristorante - Cucina tradizionale - 60 coperti e 20 coperti in terrazza.\n\nRistorante aperto dal lunedì al giovedì sera: dalle 19.00 alle 21.00\nSi accettano gruppi da 10 a 60 persone\n\nLinee di autobus - 31 fermata \"Hem voisinage\".\n "
    ],
    "fr": [
      "Hôtel - Restaurant - Cuisine traditionnelle - 60 couverts et 20 couverts en terrasse.\n\nRestaurant ouvert du Lundi au jeudi soir : 19h à 21h\nGroupes acceptés de 10 à 60 personnes \n\nBus lignes - 31 arrêt \"Hem voisinage\".\n "
    ],
    "es": [
      "Hotel - Restaurante - Cocina tradicional - 60 cubiertos y 20 cubiertos en la terraza.\n\nRestaurante abierto de lunes a jueves por la tarde: de 19:00 a 21:00 h\nSe aceptan grupos de 10 a 60 personas\n\nLíneas de autobús - 31 parada \"Hem voisinage\".\n "
    ],
    "nl": [
      "Hotel - Restaurant - Traditionele keuken - 60 couverts en 20 couverts op het terras.\n\nRestaurant geopend van maandag tot donderdag 's avonds van 19.00 tot 21.00 uur\nGroepen van 10 tot 60 personen\n\nBuslijnen - 31 halte \"Hem voisinage\".\n "
    ]
  },
