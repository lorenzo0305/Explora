  "rdfs:comment": {
    "de": [
      "La fleur des Champs ist ein Bio-Lebensmittelgeschäft, das eine ganze Reihe von Produkten aus der Region anbietet. Sie bietet monatliche Do it yourself-Workshops mit verschiedenen Themen an, die zwischen Koch-, Kosmetik- und Haushaltsworkshops wechseln."
    ],
    "en": [
      "La fleur des Champs is an organic grocery store that offers an assortment of local products, it offers monthly do it yourself workshops with various themes alternating between cooking workshops, cosmetic workshops and household products workshops."
    ],
    "it": [
      "La fleur des Champs è un negozio di alimentari biologici che offre un'ampia gamma di prodotti locali e propone laboratori mensili di fai da te con temi diversi che si alternano tra laboratori di cucina, laboratori di cosmetica e laboratori di prodotti per la casa."
    ],
    "fr": [
      "La fleur des Champs est une épicerie bio  qui propose tout un assortiment de produits du terroir, elle propose des ateliers  do it yourself mensuels avec des thèmes variés en alternance entre ateliers cuisine, ateliers cosmétiques et ateliers produits  ménagers."
    ],
    "nl": [
      "La fleur des Champs is een biologische kruidenierswinkel met een breed assortiment streekproducten. Het biedt maandelijkse doe-het-zelf workshops met verschillende thema's, afwisselend kookworkshops, cosmeticaworkshops en workshops over huishoudelijke producten."
    ],
    "es": [
      "La fleur des Champs es una tienda de comestibles ecológicos que ofrece una amplia gama de productos locales. Ofrece talleres mensuales de bricolaje con temáticas variadas que alternan talleres de cocina, de cosmética y de productos para el hogar."
    ]
  },
