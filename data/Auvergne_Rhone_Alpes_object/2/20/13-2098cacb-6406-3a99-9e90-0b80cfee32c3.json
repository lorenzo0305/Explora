  "rdfs:comment": {
    "de": [
      "Restaurant-Pizzeria in einer ruhigen Gasse gelegen, mit Terrasse.\r\nGroße Auswahl an Salaten, Pizzas, Pasta, Fleisch und hausgemachten Desserts.\r\nSpezialitäten mit weißen Trüffeln aus Alba (Italien)."
    ],
    "en": [
      "Pizzeria restaurant located in a quiet alley, with terrace.\r\nLarge choice of salads, pizzas, pasta, meats, homemade desserts. Specialities based on white truffles from Alba (Italy)."
    ],
    "it": [
      "Ristorante pizzeria situato in un vicolo tranquillo, con terrazza.\r\nAmpia scelta di insalate, pizze, pasta, carni, dolci fatti in casa. Specialità a base di tartufo bianco di Alba (Italia)."
    ],
    "fr": [
      "Restaurant-pizzeria situé dans une ruelle calme, avec terrasse.\r\nLarge choix de salades, pizzas, pâtes, viandes et desserts faits maison.\r\nSpécialités à base de truffes blanches d'Alba (Italie)."
    ],
    "es": [
      "Restaurante-pizzería situado en una calle tranquila, con terraza.\r\nAmplia carta de ensaladas, pizzas, pasta, carnes y postres caseros.\r\nEspecialidades a base de trufas blancas de Alba (Italia)."
    ],
    "nl": [
      "Restaurant-pizzeria gelegen in een rustige laan, met terras.\r\nRuime keuze aan salades, pizza's, pasta's, vleeswaren en huisgemaakte desserts.\r\nSpecialiteiten op basis van witte truffels uit Alba (Italië)."
    ]
  },
