      "rdfs:comment": {
        "de": [
          "La Ferme du Veld\nBoutique für Innendekoration\nMöbel , Leuchten , Dekorationsgegenstände ,\n\ndie Kollektionen entwickeln sich weiter, um Ihnen eine persönliche und harmonische Inneneinrichtung zu schaffen."
        ],
        "en": [
          "La Ferme du Veld\nInterior decoration store\nFurniture, lighting and decorative objects,\n\nthe collections evolve to create a personalized and harmonious interior."
        ],
        "it": [
          "La Ferme du Veld\nNegozio di decorazione d'interni\nMobili, illuminazione, oggetti decorativi,\n\nle collezioni si evolvono per creare un interno personalizzato e armonioso."
        ],
        "fr": [
          "La Ferme du Veld\nBoutique de Décoration d'intérieur\nMobiliers , luminaires , objets de décoration , \n\nles collections évoluent   pour vous créer un intérieur personnalisé et harmonieux  ."
        ],
        "nl": [
          "La Ferme du Veld\nWoonwinkel\nMeubels, verlichting, decoratieve objecten,\n\nde collecties evolueren om een gepersonaliseerd en harmonieus interieur te creëren."
        ],
        "es": [
          "La Ferme du Veld\nTienda de decoración de interiores\nMuebles, iluminación, objetos de decoración,\n\nlas colecciones evolucionan para crear un interior personalizado y armonioso."
        ]
      },
