  "rdfs:comment": {
    "de": [
      "Das Restaurant La Détente im Herzen des Dorfes Raucoules lädt Sie dazu ein, eine traditionelle Küche mit einem täglich frisch zubereiteten Gericht zu genießen. Genießen Sie einen geselligen und leckeren Moment in einer herzlichen Atmosphäre"
    ],
    "en": [
      "The restaurant La Détente, located in the heart of the village of Raucoules, invites you to enjoy traditional cuisine with a unique dish prepared daily. Come and enjoy a convivial and gourmet moment in a warm atmosphere"
    ],
    "it": [
      "Il ristorante La Détente, situato nel cuore del villaggio di Raucoules, vi invita a gustare la cucina tradizionale con un piatto unico preparato ogni giorno. Venite a gustare un pasto amichevole e gourmet in un'atmosfera calorosa"
    ],
    "fr": [
      "Le restaurant La Détente, situé au cœur du bourg de Raucoules, vous invite à savourer une cuisine traditionnelle avec un plat unique préparé chaque jour. Venez profiter d’un moment convivial et gourmand dans une ambiance chaleureuse"
    ],
    "nl": [
      "Het restaurant La Détente, gelegen in het hart van het dorp Raucoules, nodigt je uit om te genieten van een traditionele keuken met elke dag een uniek gerecht. Kom en geniet van een vriendelijke, gastronomische maaltijd in een warme sfeer"
    ],
    "es": [
      "El restaurante La Détente, situado en el corazón del pueblo de Raucoules, le invita a disfrutar de la cocina tradicional con un plato único preparado cada día. Venga a disfrutar de una comida agradable y gastronómica en un ambiente cálido"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Détente"
    ]
  },
