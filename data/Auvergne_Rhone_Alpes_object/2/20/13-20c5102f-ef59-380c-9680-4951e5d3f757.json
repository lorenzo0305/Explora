  "rdfs:comment": {
    "de": [
      "Das Restaurant du Château liegt inmitten des historischen Anwesens des Château de Petit Bois und lädt Sie zu einem einzigartigen kulinarischen Erlebnis ein, bei dem Eleganz und Authentizität Hand in Hand gehen.\r\n\r\nJede Mahlzeit wird zu einem Gourmet-Ausflug."
    ],
    "en": [
      "An exceptional setting Nestled within the historic Château de Petit Bois estate, the Restaurant du Château invites you to a unique culinary experience where elegance rhymes with authenticity.\r\n\r\nEvery meal becomes a gourmet escapade."
    ],
    "it": [
      "In un ambiente eccezionale, immerso nella storica tenuta dello Château de Petit Bois, il Restaurant du Château vi invita a vivere un'esperienza culinaria unica, dove l'eleganza incontra l'autenticità.\r\n\r\nOgni pasto diventa un'evasione gastronomica."
    ],
    "fr": [
      "Un cadre d’exception niché au sein du domaine historique du Château de Petit Bois, le Restaurant du Château vous invite à une expérience culinaire unique où élégance rime avec authenticité.\r\n\r\nChaque repas devient une escapade gourmande."
    ],
    "es": [
      "Situado en un marco excepcional, en la histórica finca del Château de Petit Bois, el Restaurant du Château le invita a disfrutar de una experiencia culinaria única en la que la elegancia se une a la autenticidad.\r\n\r\nCada comida se convierte en una escapada gastronómica."
    ],
    "nl": [
      "In een uitzonderlijke omgeving, genesteld op het historische landgoed van het Château de Petit Bois, nodigt het Restaurant du Château je uit om te genieten van een unieke culinaire ervaring waar elegantie en authenticiteit elkaar ontmoeten.\r\n\r\nElke maaltijd wordt een gastronomische escapade."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant du Château de Petit Bois"
    ]
  },
