  "rdfs:comment": {
    "de": [
      "Intuitiver Wellness-Massagepraktiker. Eigenes Spa mit Balneo. Massage allein oder zu zweit. Pauschalangebot für Spa und Massage. Angebot für Premiumkunden. Karte für ein Geschenk. Massage in Unternehmen (sitzende Amma). Massage mit heißen Steinen."
    ],
    "en": [
      "Intuitive wellness masseur. Private whirlpool spa. Solo or duo massage. Spa and massage package. Premium offer. Gift cards. Corporate massage (seated amma). Massage for pregnant women. 1-day introductory massage course: 7 hours of instruction."
    ],
    "it": [
      "Massaggiatore intuitivo per il benessere. Idromassaggio privato. Massaggio individuale o in coppia. Pacchetto spa e massaggio. Offerta premium. Carte regalo. Massaggio aziendale (amma seduto). Massaggio con pietre calde."
    ],
    "fr": [
      "Praticien masseur bien être intuitif. Spa balnéo privatif. Massage en solo ou en duo. Forfait spa et massage. Offre prémium. Carte cadeau. Massage en entreprise (amma assis). Massage aux pierres chaudes."
    ],
    "es": [
      "Masajista de bienestar intuitivo. Spa de hidromasaje privado. Masaje en solitario o en dúo. Paquete de spa y masaje. Oferta Premium. Tarjetas regalo. Masaje de empresa (amma sentado). Masaje con piedras calientes."
    ],
    "nl": [
      "Intuïtieve welzijnsmasseur. Privé whirlpool spa. Solo of duomassage. Spa- en massagepakket. Premium aanbieding. Cadeaubonnen. Bedrijfsmassage (zittende amma). Hot stone massage."
    ]
  },
