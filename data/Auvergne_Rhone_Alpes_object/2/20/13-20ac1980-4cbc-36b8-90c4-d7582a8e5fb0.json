  "rdfs:comment": {
    "de": [
      "Das Skigebiet Crest-Voland Cohennoz erreicht mit der Eröffnung der Gondelbahn von La Logère im Dezember 2025 einen neuen Meilenstein. Diese Investition markiert eine ehrgeizige Modernisierung für das Skigebiet, indem sie den Sessellift von La Logère ersetzt."
    ],
    "en": [
      "The Crest-Voland Cohennoz ski area is taking another major step forward with the arrival of the Logère gondola lift, which will open to the public in December 2025. This investment marks an ambitious modernization for the resort, replacing the current Logère chairlift, which has been in operation since 1986."
    ],
    "it": [
      "Il comprensorio sciistico Crest-Voland Cohennoz entra in una nuova fase con l'apertura della cabinovia Logère nel dicembre 2025. Questo investimento segna un'ambiziosa modernizzazione del comprensorio, sostituendo la seggiovia Logère."
    ],
    "fr": [
      "Le domaine skiable de Crest-Voland Cohennoz franchit une nouvelle étape avec l'ouverture de la télécabine de la Logère, en décembre 2025. Cet investissement marque une modernisation ambitieuse pour la station, en remplaçant le télésiège de la Logère."
    ],
    "nl": [
      "Het skigebied Crest-Voland Cohennoz gaat een nieuwe fase in met de opening van de gondellift Logère in december 2025. Deze investering markeert een ambitieuze modernisering van het skigebied en vervangt de stoeltjeslift Logère."
    ],
    "es": [
      "El dominio esquiable de Crest-Voland Cohennoz entra en una nueva fase con la apertura del telecabina Logère en diciembre de 2025. Esta inversión supone una ambiciosa modernización de la estación y sustituye al telesilla Logère."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Logère gondola"
    ],
    "fr": [
      "Télécabine de la Logère"
    ]
  },
