  "rdfs:comment": {
    "de": [
      "Mit 1300m2 Veranstaltungsfläche und einem erfahrenen Team bietet das Maison MINATEC alle Einrichtungen, um Sie inmitten einer hochtechnologischen Umgebung zu empfangen."
    ],
    "en": [
      "In a high-tech environnement, MINATEC offers you an ideal venue for your conference with 1300m2 rooms dedicated to your event and provides you the support of an experienced team."
    ],
    "it": [
      "Con 1300 m2 di spazio per eventi e un team esperto, la MINATEC House offre tutte le strutture per accogliervi nel cuore di un ambiente high-tech."
    ],
    "fr": [
      "Avec 1300m2 d'espaces dédiés aux événements et une équipe expérimentée, la Maison MINATEC offre toutes les facilités pour vous accueillir au coeur d'un environnement de haute technologie."
    ],
    "nl": [
      "Met 1300 m2 aan evenementenruimte en een ervaren team biedt het MINATEC House alle faciliteiten om u te ontvangen in het hart van een hightech omgeving."
    ],
    "es": [
      "Con 1300m2 de espacio para eventos y un equipo experimentado, la Casa MINATEC ofrece todas las facilidades para acogerle en el corazón de un entorno de alta tecnología."
    ]
  },
