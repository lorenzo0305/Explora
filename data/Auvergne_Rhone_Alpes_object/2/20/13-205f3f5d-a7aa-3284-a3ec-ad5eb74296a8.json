  "rdfs:comment": {
    "de": [
      "Eric Geoffroy ist gelernter Fleischer und Metzger und hat sich in einigen Häusern in Moulinoises seine Sporen verdient."
    ],
    "en": [
      "Éric Geoffroy trained as a butcher and pork butcher, and cut his teeth in a number of Moulin establishments. After a few years working on his own in the restaurant business, he set up as a caterer in 2000."
    ],
    "it": [
      "Éric Geoffroy si è formato come macellaio e norcino e si è fatto le ossa in diversi locali del Moulin. Dopo aver lavorato per conto proprio per diversi anni nel settore della ristorazione, nel 2000 ha intrapreso l'attività di ristoratore."
    ],
    "fr": [
      "Éric Geoffroy est issu d’une formation boucher charcutier, il a fait ses armes parmi quelques maisons Moulinoises ; après quelques années à son compte dans le milieu de la restauration il s’est implanté en tant que traiteur en 2000."
    ],
    "es": [
      "Éric Geoffroy se formó como carnicero y charcutero, y se curtió en varios establecimientos del Moulin. Tras trabajar varios años por su cuenta en la restauración, se estableció como restaurador en 2000."
    ],
    "nl": [
      "Éric Geoffroy is opgeleid als slager en varkensslager en heeft zijn tanden gezet in een aantal etablissementen in de Moulin. Nadat hij een aantal jaren voor zichzelf had gewerkt in het restaurantwezen, begon hij in 2000 als traiteur."
    ]
  },
  "rdfs:label": {
