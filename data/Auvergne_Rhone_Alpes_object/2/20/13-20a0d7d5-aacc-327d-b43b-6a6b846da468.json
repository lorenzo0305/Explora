  "rdfs:comment": {
    "de": [
      "\"Au Restau\" ist der brandneue Feinschmeckerort in Bourg-lès-Valence, wo traditionelle französische Küche auf handwerkliches Pizza-Know-how trifft."
    ],
    "en": [
      "\"Au Restau\" is the brand-new gourmet spot in Bourg-lès-Valence where traditional French cuisine meets artisanal pizza know-how."
    ],
    "it": [
      "\"Au Restau\" è un nuovissimo locale gourmet a Bourg-lès-Valence dove la cucina tradizionale francese incontra la pizza artigianale."
    ],
    "fr": [
      "\"Au Restau\", c’est le tout nouveau lieu gourmand à Bourg-lès-Valence où la cuisine française traditionnelle rencontre le savoir-faire de la pizza artisanale."
    ],
    "nl": [
      "\"Au Restau is een gloednieuwe gastronomische locatie in Bourg-lès-Valence waar traditionele Franse gerechten en ambachtelijke pizzabereidingen samenkomen."
    ],
    "es": [
      "\"Au Restau es un nuevo local gastronómico de Bourg-lès-Valence donde la cocina tradicional francesa se combina con la elaboración artesanal de pizzas."
    ]
  },
  "rdfs:label": {
