  "rdfs:comment": {
    "de": [
      "Nachdem Liévin bereits vier Weltcups, Europameisterschaften, drei französische Meisterschaften und drei französische Pokale organisiert hat, wagt sich die Stadt nun an die Organisation dieser ersten Weltmeisterschaften."
    ],
    "en": [
      "Having already organized 4 World Cups, European Championships, 3 French Championships and 3 French Cups, Liévin is embarking on the organization of its first World Championships."
    ],
    "it": [
      "Dopo aver organizzato 4 coppe del mondo, campionati europei, 3 campionati francesi e 3 coppe di Francia, Liévin si lancia nell'organizzazione di questi primi campionati mondiali."
    ],
    "fr": [
      "Après avoir organisé 4 coupes du monde, des championnats d’Europe, 3 championnats de France et 3 coupes de France, Liévin se lance dans l’organisation de ces premiers championnats du monde."
    ],
    "es": [
      "Tras organizar 4 copas del mundo, campeonatos de Europa, 3 campeonatos de Francia y 3 copas de Francia, Liévin se lanza a la organización de estos primeros campeonatos del mundo."
    ],
    "nl": [
      "Na het organiseren van 4 wereldbekers, Europese kampioenschappen, 3 Franse kampioenschappen en 3 Franse bekers, gaat Liévin van start met de organisatie van deze eerste wereldkampioenschappen."
    ]
  },
  "rdfs:label": {
