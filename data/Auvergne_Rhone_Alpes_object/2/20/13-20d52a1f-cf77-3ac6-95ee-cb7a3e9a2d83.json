  "rdfs:comment": {
    "de": [
      "Das Ypga- & Wellness-Zentrum Yoga Shivaya ist ein Ort, der für alle geschaffen wurde, die sich um ihren Körper und ihren Geist kümmern möchten. Getragen wird es von Yulia, einer dynamischen und leidenschaftlichen Yogalehrerin."
    ],
    "en": [
      "The Yoga Shivaya ypga & wellness center is a place created for all those who wish to take care of their body and mind. Run by Yulia, a dynamic and passionate yoga teacher."
    ],
    "it": [
      "Lo Shivaya Yoga Ypga & Wellness Centre è un luogo creato per tutti coloro che vogliono prendersi cura del proprio corpo e della propria mente. È gestito da Yulia, un'insegnante di yoga dinamica e appassionata."
    ],
    "fr": [
      "Le Centre de ypga & bien-être Yoga Shivaya est un lieu créé pour tous ceux qui souhaitent prendre soin de leur corps et de leur esprit. Porté par Yulia, professeure de yoga dynamique et passionnée."
    ],
    "nl": [
      "Het Shivaya Yoga Ypga & Wellness Centre is een plek voor iedereen die goed voor zijn lichaam en geest wil zorgen. Het wordt gerund door Yulia, een dynamische en gepassioneerde yogalerares."
    ],
    "es": [
      "El Shivaya Yoga Ypga & Wellness Centre es un lugar creado para todos aquellos que quieran cuidar su cuerpo y su mente. Está dirigido por Yulia, una profesora de yoga dinámica y apasionada."
    ]
  },
  "rdfs:label": {
