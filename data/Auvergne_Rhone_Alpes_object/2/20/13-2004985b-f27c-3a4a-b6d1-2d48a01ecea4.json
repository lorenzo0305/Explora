  "rdfs:comment": {
    "de": [
      "Hier gibt es keine Pizzen, sondern eine Entdeckung der italienischen Gastronomie. Das Restaurant La Maison de Franca, bereitet Ihnen köstliche italienische Gourmetgerichte für Ihren Gaumen zu."
    ],
    "en": [
      "Here no pizzas but a discovery of Italian gastronomy. The restaurant La Maison de Franca, prepares succulent Italian gastronomic dishes for your taste buds."
    ],
    "it": [
      "Niente pizze, ma una scoperta della gastronomia italiana. Il ristorante La Maison de Franca prepara succulenti piatti della gastronomia italiana per il vostro palato."
    ],
    "fr": [
      "Ici pas de pizzas mais une découverte de la gastronomie italienne. Le restaurant La Maison de Franca, vous prépare de succulents plats gastronomiques italiens pour vos papilles."
    ],
    "nl": [
      "Geen pizza's hier, maar een ontdekking van de Italiaanse gastronomie. Het restaurant La Maison de Franca, bereidt sappige Italiaanse gastronomische gerechten voor uw smaakpapillen."
    ],
    "es": [
      "Aquí no hay pizzas, sino un descubrimiento de la gastronomía italiana. El restaurante La Maison de Franca, prepara suculentos platos gastronómicos italianos para su paladar."
    ]
  },
