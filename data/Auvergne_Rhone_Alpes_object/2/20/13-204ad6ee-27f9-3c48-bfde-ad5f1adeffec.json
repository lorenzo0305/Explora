  "rdfs:comment": {
    "de": [
      "Die Snackbar des Campingplatzes bietet Ihnen Tagesgerichte, Pizzas, Paninis, kalte Getränke und Eis. Profitieren Sie auch von Themenabenden in einer festlichen und sommerlichen Atmosphäre."
    ],
    "en": [
      "The snack bar of the campsite offers you daily specials, pizzas, paninis, cold drinks and ice creams. You can also enjoy theme evenings in a festive and summery atmosphere."
    ],
    "it": [
      "Lo snack bar del campeggio offre specialità giornaliere, pizze, panini, bevande fredde e gelati. È inoltre possibile partecipare a serate a tema in un'atmosfera festosa ed estiva."
    ],
    "fr": [
      "Le snack du camping vous propose plat du jour, pizzas, paninis, boissons fraiches et glaces. Profitez également de soirées à thème dans une ambiance festive et estivale."
    ],
    "es": [
      "El snack bar del camping ofrece especialidades del día, pizzas, paninis, bebidas frías y helados. También podrá disfrutar de veladas temáticas en un ambiente festivo y veraniego."
    ],
    "nl": [
      "De snackbar van de camping biedt dagschotels, pizza's, panini's, koude dranken en ijs. U kunt ook genieten van thema-avonden in een feestelijke, zomerse sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant-Snack du camping"
    ]
  },
