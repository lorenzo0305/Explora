  "rdfs:comment": {
    "de": [
      "Angeln in Bathelane: ein Hobby, eine Entspannung für alle. Familienangeln, Angeln oder Fliegenfischen am Ufer des Lignon am Ortsausgang von Tence in Richtung Chenereilles.\r\nStädtischer Platz, der von der Angelgesellschaft von Tence verwaltet wird"
    ],
    "en": [
      "Fishing at Bathelane: a leisure activity for all. Family fishing, with jigging or fly-fishing, on the banks of the Lignon just outside Tence in the direction of Chenereilles.\r\nMunicipal area managed by the Tence fishing club"
    ],
    "it": [
      "La pesca a Bathelane: un'attività ricreativa per tutti. Pesca in famiglia, da riva o a mosca, sulle rive del Lignon appena fuori Tence in direzione di Chenereilles.\r\nArea comunale gestita dal club di pesca di Tence"
    ],
    "fr": [
      "La pêche à Bathelane : un loisir, une détente pour tous. Pêche familiale, au coup ou à la mouche, au bord du Lignon à la sortie de Tence direction  Chenereilles.\r\nEspace municipal géré par la société de pêche de Tence"
    ],
    "nl": [
      "Vissen in Bathelane: een vrijetijdsbesteding voor iedereen. Vissen met het gezin, vissen vanaf de kant of vliegvissen, aan de oevers van de Lignon net buiten Tence in de richting van Chenereilles.\r\nGemeentelijk gebied beheerd door de visclub van Tence"
    ],
    "es": [
      "Pesca en Bathelane: una actividad de ocio para todos. Pesca familiar, pesca de orilla o pesca con mosca, a orillas del Lignon a las afueras de Tence en dirección a Chenereilles.\r\nZona municipal gestionada por el club de pesca de Tence"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plan d'Eau de Bathelane"
    ]
  },
