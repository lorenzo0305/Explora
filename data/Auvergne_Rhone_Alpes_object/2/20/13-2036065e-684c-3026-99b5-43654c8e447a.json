  "rdfs:comment": {
    "de": [
      "Pimprenelle ist ein Ort mit tausend Facetten: seine Möbel, seine Farben, Helligkeit und Kontraste. Pimprenelle ist der Mittagstisch mit warmen und kalten Brotaufstrichen oder leckeren Suppen und vielen anderen Leckereien."
    ],
    "en": [
      "Pimprenelle has an eclectic style, reflected in its furniture, range of colours, and bright décor full of contrasts. At lunchtime, Pimprenelle offers hot and cold open sandwiches, tasty soups and numerous other delights."
    ],
    "it": [
      "Pimprenelle è un luogo dalle mille sfaccettature: l'arredamento, i colori, la luminosità e i contrasti. Pimprenelle è il momento del pranzo con panini caldi e freddi o gustose zuppe e molte altre prelibatezze."
    ],
    "fr": [
      "Pimprenelle est un lieu à mille facettes : son mobilier, ses couleurs, luminosité et contrastes. Pimprenelle c'est l'instant du midi avec tartines chaudes et froides ou de savoureuses soupes et nombreuses autres gourmandises."
    ],
    "nl": [
      "Pimprenelle is een plek met duizend facetten: de meubels, de kleuren, de helderheid en de contrasten. Pimprenelle is het lunchmoment met warme en koude broodjes of lekkere soepen en vele andere lekkernijen."
    ],
    "es": [
      "Pimprenelle es un lugar con mil facetas: su mobiliario, sus colores, su brillo y sus contrastes. Pimprenelle es el momento del almuerzo con sándwiches calientes y fríos o sabrosas sopas y muchas otras delicias."
    ]
  },
