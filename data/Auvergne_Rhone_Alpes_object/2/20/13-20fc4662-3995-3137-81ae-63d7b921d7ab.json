  "rdfs:comment": {
    "de": [
      "Vom Eingang an der denkmalgeschützten Fassade des Rathauses kommt man über einen ersten Hof mit zahlreichen Säulen in den Park. Dahinter lädt der Park einen Augenblick lang zum Entspannen oder zum Spielen mit der Familie mitten in der Stadt ein."
    ],
    "en": [
      "Going through the entrance by the listed façade of the Hôtel de Ville, you enter the park through an initial courtyard made up of numerous columns. Behind, the park encourages a moment of relaxation or games with the family in the centre of town."
    ],
    "it": [
      "Superato l'ingresso dalla facciata dell'Hôtel de Ville, si entra nel parco attraverso un primo cortile caratterizzato da numerose colonne. Dietro di esso, il parco invita a rilassarsi o a giocare con la famiglia nel cuore della città."
    ],
    "fr": [
      "En passant par l'entrée située vers la façade classée de l'Hôtel de Ville, on entre dans le parc par une première cour composée de nombreuses colonnes. Derrière, le parc invite a un instant de détente ou de jeux en famille au coeur de la ville."
    ],
    "nl": [
      "Via de ingang aan de geklasseerde gevel van het Hôtel de Ville kom je het park binnen via een eerste binnenplaats met talrijke zuilen. Daarachter nodigt het park je uit om te ontspannen of te spelen met je gezin in het hart van de stad."
    ],
    "es": [
      "Atravesando la entrada por la fachada catalogada del Hôtel de Ville, se accede al parque por un primer patio con numerosas columnas. Tras él, el parque invita a relajarse o a jugar en familia en pleno centro de la ciudad."
    ]
  },
