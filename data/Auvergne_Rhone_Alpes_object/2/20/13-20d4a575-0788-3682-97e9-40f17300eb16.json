  "rdfs:comment": {
    "de": [
      "Das charmante Dorf Cléon d'Andran ist das erste in der Drôme Provençale, 15 km östlich von Montélimar. Der Siedlungsteil hat sich in konzentrischen Kreisen entwickelt."
    ],
    "en": [
      "The charming village of Cléon d'Andran is the first in Drôme provençale, 15 km east of Montélimar. The built-up area has evolved in concentric circles."
    ],
    "it": [
      "L'incantevole villaggio di Cléon d'Andran è il primo della Drôme provenzale, a 15 km a est di Montélimar. L'area edificata si è evoluta in cerchi concentrici."
    ],
    "fr": [
      "Le charmant village de Cléon d’Andran est le premier de la Drôme provençale, à 15 km à l’est de Montélimar. La partie agglomérée a évolué en cercles concentriques."
    ],
    "nl": [
      "Het charmante dorpje Cléon d'Andran is het eerste in de Drôme provençale, 15 km ten oosten van Montélimar. De bebouwde kom heeft zich in concentrische cirkels ontwikkeld."
    ],
    "es": [
      "El encantador pueblo de Cléon d'Andran es el primero de la Drôme provenzal, a 15 km al este de Montélimar. La zona edificada ha evolucionado en círculos concéntricos."
    ]
  },
