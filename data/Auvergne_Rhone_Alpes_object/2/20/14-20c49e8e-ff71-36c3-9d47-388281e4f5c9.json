  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3e871cf5-8da7-3cd0-bdc7-c27d6a7d0969",
      "dc:description": {
        "de": [
          "Programm des Tages :\num 10 Uhr > Besuch \"Spurensuche\" (kostenlos)\nvon 14:00 bis 18:00 Uhr > Stempel-Workshop mit Amélie Boquet (kostenlos)\nvon 15:00 bis 17:00 Uhr > Im Garten der Töpfer (5?)\n16:30 Uhr > Workshop \"Landschaft aus Papier\" (3? pro Kind, kostenlos für die Begleitperson)\n16:30 Uhr > Führung durch die Ausstellung (kostenlos)\n18 Uhr > Musikalischer Vortrag \"Quantenphysik\" von Etienne Klein und Olivier Mellano (10?)"
        ],
        "en": [
          "Program for the day :\n10 a.m. > \"Trace\" tour (free)\n2pm to 6pm > Stamp workshop with Amélie Boquet (free)\n3pm to 5pm > Jardin des Potiniers (5?)\n4.30pm > \"Paper Landscape\" workshop (3? per child, free for accompanying adult)\n4:30pm > Guided tour of the exhibition (free)\n6pm > \"Quantum Physics\" musical lecture by Etienne Klein and Olivier Mellano (10?)"
        ],
        "it": [
          "Programma della giornata:\n10.00 > Visita guidata \"Trace\" (gratuita)\ndalle 14.00 alle 18.00 > Laboratorio di timbratura con Amélie Boquet (gratuito)\ndalle 15.00 alle 17.00 > Jardin des Potiniers (5?)\nore 16.30 > Laboratorio \"Paesaggio di carta\" (3 euro a bambino, gratuito per l'accompagnatore)\nore 16.30 > Visita guidata alla mostra (gratuita)\n18.00 > Conferenza musicale \"Fisica quantistica\" di Etienne Klein e Olivier Mellano (10?)"
        ],
        "fr": [
          "Programme de la journée :  \nà 10h > Visite « Trace » (gratuit) \nde 14h à 18h > Atelier tampons avec Amélie Boquet (gratuit) \nde 15h à 17h > Au Jardin des Potiniers (5€) \nà 16h30 > Atelier « Paysage de papier » (3€ par enfant, gratuit pour l’accompagnant) \nà 16h30 > Visite guidée de l’exposition (gratuit) \nà 18h > Conférence musicale « La Physique Quantique » par Etienne Klein et Olivier Mellano (10€)"
        ],
        "nl": [
          "Programma voor de dag:\n10u > Rondleiding \"Trace\" (gratis)\n14u tot 18u > Postzegelworkshop met Amélie Boquet (gratis)\nvan 15u tot 17u > Jardin des Potiniers (5?)\n16u30 > Workshop \"Papierlandschap\" (€3 per kind, gratis voor begeleidende volwassene)\n16u30 > Rondleiding door de tentoonstelling (gratis)\n18u > Muzikale lezing \"Kwantumfysica\" door Etienne Klein en Olivier Mellano (10?)"
        ],
        "es": [
          "Programa del día:\n10.00 h > Visita \"Huellas\" (gratuita)\nde 14.00 a 18.00 h > Taller de sellos con Amélie Boquet (gratuito)\nde 15.00 a 17.00 h > Jardin des Potiniers (5?)\n16.30 h > Taller \"Paisaje de papel\" (3 euros por niño, gratuito para el acompañante)\n16.30 h > Visita guiada a la exposición (gratuita)\n18.00 h > Conferencia musical \"Física cuántica\" a cargo de Etienne Klein y Olivier Mellano (10.00 h)"
        ]
      },
