      "@id": "https://data.datatourisme.fr/5ae76a59-5562-3054-8d77-90f288d43745",
      "dc:description": {
        "de": [
          "Gemütliches Lokal, herzliche Atmosphäre, hausgemachte Küche mit frischen Produkten.\nJeden Monat neue Speisekarte und unsere Tagesvorschläge."
        ],
        "en": [
          "Cosy establishment, warm atmosphere, home-made cooking with fresh products.\nNew menu every month and our daily suggestions."
        ],
        "it": [
          "Locale accogliente, atmosfera calda, cucina casalinga con prodotti freschi.\nUn nuovo menu ogni mese e le nostre proposte quotidiane."
        ],
        "fr": [
          "Etablissement cosy, ambiance chaleureuse, cuisine fait maison avec des produits frais.\nNouvelle carte tous les mois et nos suggestions du jour."
        ],
        "nl": [
          "Gezellig etablissement, warme sfeer, huisgemaakte keuken met verse producten.\nElke maand een nieuw menu en onze dagelijkse suggesties."
        ],
        "es": [
          "Establecimiento acogedor, ambiente cálido, cocina casera con productos frescos.\nNuevo menú cada mes y nuestras sugerencias diarias."
        ]
      },
