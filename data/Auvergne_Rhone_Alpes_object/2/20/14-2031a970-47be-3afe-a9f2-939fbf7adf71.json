  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/15d8ac4e-c659-37bc-b9ca-13d03b7b2e59",
      "dc:description": {
        "de": [
          "Installation, Verlegung, Arbeiten, Reparatur, Wartung in Humbert (62650) und von der Entastung, dem Heckenschnitt, der Dachentmoosung, den Zäunen, der Entbuschung, dem Fällen von Bäumen, der Gartenpflege, dem Anlegen von Terrassen oder Gärten, der Schaffung von Grünflächen usw. bis hin zum Ausschneiden von Hecken und Bäumen"
        ],
        "en": [
          "Installation, installation, work, repair, maintenance in Humbert (62650) and ranging from pruning, hedge trimming, roof de-mossing, fencing, undergrowth clearance, tree felling, garden maintenance, terrace or garden design, creation of green spaces, etc"
        ],
        "it": [
          "Installazione, montaggio, lavori, riparazione e manutenzione a Humbert (62650), tra cui potatura, taglio delle siepi, rimozione del sottobosco del tetto, recinzione, eliminazione del sottobosco, abbattimento degli alberi, manutenzione del giardino, progettazione di terrazze e giardini, creazione di spazi verdi, ecc"
        ],
        "fr": [
          "Installation, pose, travaux, réparation, entretien à Humbert (62650) et allant de l’élagage, la taille de haie, le démoussage de toiture, les clôtures, le débroussaillage, l’abattage d’arbre, l’entretien des jardins, l’aménagement de terrasse ou de jardin, la création d’espace vert, etc"
        ],
        "nl": [
          "Installatie, plaatsing, werkzaamheden, reparatie en onderhoud in Humbert (62650), inclusief snoeien, heggen snoeien, dakbegroeiing verwijderen, schuttingen, onderbegroeiing opruimen, bomen kappen, tuinonderhoud, terras- en tuinontwerp, groenvoorziening aanleggen, enz"
        ],
        "es": [
          "Instalación, acondicionamiento, trabajos, reparación y mantenimiento en Humbert (62650), incluyendo poda, recorte de setos, eliminación de maleza en tejados, vallado, limpieza de maleza, tala de árboles, mantenimiento de jardines, diseño de terrazas y jardines, creación de espacios verdes, etc"
        ]
      },
