      "@id": "https://data.datatourisme.fr/9a3ada7c-ca8e-3538-ba00-925e4bea04ff",
      "dc:description": {
        "de": [
          "Samstag, 2. Oktober 2021\n\nAusstellung von Oldtimern, darunter hauptsächlich 2cvs und Citroëns.\nUnd andere Animationen, die es am Boulevard de la Plage zu entdecken gibt."
        ],
        "en": [
          "Saturday, October 2, 2021\n\nExhibition of old cars, mainly 2CVs and Citroens.\nAnd other animations to discover boulevard de la plage."
        ],
        "it": [
          "Sabato 2 ottobre 2021\n\nEsposizione di auto d'epoca, principalmente 2CV e Citroen.\nE altre attività da scoprire sul boulevard de la plage."
        ],
        "fr": [
          "Samedi 2 octobre 2021\n\nExposition de voitures anciennes dont principalement des 2cv et des citroëns.\nEt d'autres animations à découvrir boulevard de la plage."
        ],
        "nl": [
          "Zaterdag 2 oktober 2021\n\nTentoonstelling van oude auto's, voornamelijk 2CV's en Citroens.\nEn andere activiteiten om te ontdekken op de boulevard de la plage."
        ],
        "es": [
          "Sábado 2 de octubre de 2021\n\nExposición de coches antiguos, principalmente 2CV y Citroën.\nY otras actividades para descubrir en el boulevard de la plage."
        ]
      },
