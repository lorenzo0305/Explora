  "rdfs:comment": {
    "de": [
      "In Freydefont, in der Gemeinde Saint-Nectaire, gelegen, entdecken Sie unsere Ziegen- und Milchkuhzucht (Melken, Fütterung, Käseherstellung), unsere mit Medaillen ausgezeichneten Käse und unseren Saint Nectaire, der vor Ort verkauft wird."
    ],
    "en": [
      "Located in Freydefont on the commune of Saint Nectaire. Come and discover the milking of goats and the making of Saint Nectaire cheese \r\nFree visit and commented by the farmer."
    ],
    "it": [
      "A Freydefont, nel comune di Saint-Nectaire, venite a scoprire la nostra fattoria di capre e mucche da latte (mungitura, alimentazione, caseificazione), i nostri formaggi premiati con medaglie e il nostro formaggio Saint-Nectaire in vendita sul posto."
    ],
    "fr": [
      "Situé à Freydefont, sur la commune de Saint-Nectaire, venez découvrir notre élevage de chèvres et de vaches laitières (traite, alimentation, fabrication des fromages), nos fromages médaillés et notre saint nectaire en vente sur place."
    ],
    "es": [
      "Situada en Freydefont, en la comuna de Saint-Nectaire, venga a descubrir nuestra granja de cabras y vacas lecheras (ordeño, alimentación, quesería), nuestros quesos premiados y nuestro queso Saint-Nectaire a la venta in situ."
    ],
    "nl": [
      "Kom in Freydefont, in de gemeente Saint-Nectaire, onze geiten- en melkkoeienboerderij ontdekken (melken, voederen, kaasmaken), onze bekroonde kazen en onze Saint-Nectaire-kaas die ter plaatse te koop is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de l'Or Blanc"
    ]
  },
