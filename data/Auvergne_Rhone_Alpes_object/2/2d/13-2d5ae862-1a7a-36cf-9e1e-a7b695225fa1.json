  "rdfs:comment": {
    "de": [
      "Entdecken Sie in Begleitung der Esel auf dem Bauernhof von Perdicus eine geschützte Natur und ein althergebrachtes landwirtschaftliches Erbe."
    ],
    "en": [
      "In the company of the farm's donkeys, discover a preserved nature and an ancestral agricultural heritage."
    ],
    "it": [
      "In compagnia degli asini della fattoria Perdicus, scoprite una natura preservata e un patrimonio agricolo ancestrale."
    ],
    "fr": [
      "En compagnie des ânes de la ferme de Perdicus, partez à la découverte d'une nature préservée et d'un patrimoine agricole ancestral."
    ],
    "nl": [
      "Ontdek in gezelschap van de ezels van de Perdicus-boerderij een ongerepte natuur en een voorouderlijk agrarisch erfgoed."
    ],
    "es": [
      "En compañía de los burros de la granja Perdicus, descubra una naturaleza preservada y un patrimonio agrícola ancestral."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Séjours et sorties avec les ânes"
    ],
    "nl": [
      "Verblijven en wandelingen met ezels"
    ]
