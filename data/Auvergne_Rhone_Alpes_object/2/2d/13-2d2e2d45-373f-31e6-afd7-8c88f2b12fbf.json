  "rdfs:comment": {
    "de": [
      "Restaurant und Feinkostgeschäft. Raffinierte Küche, Inspirationen aus aller Welt, vegetarische Menüvorschläge.\r\nAlle unsere Gerichte sind hausgemacht und werden so oft wie möglich mit lokalen Produkten zubereitet.\r\nBrunch an bestimmten Sonntagen erhältlich."
    ],
    "en": [
      "Restaurant and caterer. Refined cuisine, inspired by the world, vegetarian menu proposals. \r\nAll our dishes are homemade using local produce wherever possible."
    ],
    "it": [
      "Ristorante e catering. Cucina raffinata, ispirata al mondo, menù vegetariani.\r\nTutti i nostri piatti sono fatti in casa utilizzando, ove possibile, prodotti locali.\r\nBrunch disponibile in alcune domeniche."
    ],
    "fr": [
      "Restaurant et traiteur. Cuisine raffinée, inspirations du monde, propositions de menus végétariens. \r\nTous nos plats sont faits maison avec des produits locaux autant que possible.\r\nBrunch disponible certains dimanches."
    ],
    "es": [
      "Restaurante y servicio de catering. Cocina refinada, inspirada en el mundo, menús vegetarianos.\r\nTodos nuestros platos son caseros y se elaboran con productos locales.\r\nBrunch disponible algunos domingos."
    ],
    "nl": [
      "Restaurant en traiteur. Verfijnde keuken, geïnspireerd door de wereld, vegetarische menu's.\r\nAl onze gerechten zijn huisgemaakt en waar mogelijk worden lokale producten gebruikt.\r\nBrunch beschikbaar op bepaalde zondagen."
    ]
  },
