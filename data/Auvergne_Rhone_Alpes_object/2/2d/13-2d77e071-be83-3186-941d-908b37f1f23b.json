  "rdfs:comment": {
    "de": [
      "Lifestyle-Fotograf für Hochzeit und Familie. Lifestyle bedeutet \"Momente des Lebens\". Ich fotografiere sanft und authentisch die wichtigsten Momente Ihres Lebens (Hochzeit, Schwangerschaft, Geburt oder Momente mit der Familie)."
    ],
    "en": [
      "Lifestyle wedding and family photographer. Lifestyle means \"moments in life\". I photograph with gentleness and authenticity the most important moments of your life (weddings, pregnancies, births or family moments)."
    ],
    "it": [
      "Fotografo di matrimonio e famiglia Lifestyle. Lifestyle significa \"momenti di vita\". Fotografo i momenti più importanti della vostra vita (matrimoni, gravidanze, nascite o momenti familiari) con dolcezza e autenticità."
    ],
    "fr": [
      "Photographe Lifestyle mariage et famille. Le Lifestyle signifie \"moments de vie\". Je photographie avec douceur et authenticité les moments les plus importants de votre vie (Mariage, grossesse, naissance ou moments en famille)."
    ],
    "nl": [
      "Lifestyle trouw- en familiefotograaf. Lifestyle betekent \"momenten in het leven\". Ik fotografeer de belangrijkste momenten van jullie leven (bruiloften, zwangerschappen, geboortes of familiemomenten) met zachtheid en authenticiteit."
    ],
    "es": [
      "Fotógrafo de bodas y familia de estilo de vida. Estilo de vida significa \"momentos en la vida\". Fotografío los momentos más importantes de tu vida (bodas, embarazos, nacimientos o momentos familiares) con delicadeza y autenticidad."
    ]
  },
  "rdfs:label": {
