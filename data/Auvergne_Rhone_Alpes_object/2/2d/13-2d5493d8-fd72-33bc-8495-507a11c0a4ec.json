  "rdfs:comment": {
    "de": [
      "Zwischen Vercors und Provence, in einer wilden und geschützten Naturkulisse unter dem majestätischen Felsen von Combeau, werden Sie Sylvie, die Eigentümerin, und ihr Team den Komfort ihres Hauses und die Aromen der Küche ihrer Heimat entdecken lassen."
    ],
    "en": [
      "Between Vercors and Provence, in a preserved environment, under the majestic Combeau Rock, Sylvie and her staff will welcome you in their comfortable house, and invite you to taste the flavours of her local cuisine."
    ],
    "it": [
      "Tra il Vercors e la Provenza, in una natura selvaggia e incontaminata sotto la maestosa roccia di Combeau, Sylvie, la proprietaria, e il suo team vi introdurranno al comfort della loro casa e ai sapori della loro cucina locale."
    ],
    "fr": [
      "Entre Vercors et Provence, dans un décor naturel sauvage et préservé, sous le majestueux rocher de Combeau, Sylvie, la propriétaire, et son équipe vous feront découvrir le confort de leur maison et les saveurs de la cuisine de leur terroir."
    ],
    "nl": [
      "Sylvie en haar staff laten je - tussen Vercors en Provence, in een ongerepte, beschermde natuurlijke omgeving in de schaduw van de vorstelijke Combeau - kennismaken met haar comfortabele hotel en een verrassende streekkeuken."
    ],
    "es": [
      "Entre el Vercors y la Provenza, en un entorno natural salvaje y virgen bajo la majestuosa roca de Combeau, Sylvie, la propietaria, y su equipo le harán descubrir el confort de su casa y los sabores de su cocina local."
    ]
  },
