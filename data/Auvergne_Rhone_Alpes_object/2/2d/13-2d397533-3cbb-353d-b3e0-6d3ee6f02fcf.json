  "rdfs:comment": {
    "de": [
      "Museum für Landwirtschaft und alte Berufe mit dem Ziel, alte Geräte zu erhalten und zu restaurieren, um die Erinnerung an alte Berufe, Maschinen, Traktoren und verschiedene Werkzeuge zu bewahren."
    ],
    "en": [
      "Discover the old trades which allowed our ancestors to work the ground (tractors, various machines etc) : you will come close to our know-how and old tradition."
    ],
    "it": [
      "Museo agricolo e degli antichi mestieri, la cui vocazione è quella di salvaguardare e restaurare vecchie attrezzature per conservare la memoria di antichi mestieri, macchine, trattori e utensili vari."
    ],
    "fr": [
      "Musée agricole et vieux métiers, ayant pour vocation la sauvegarde et la restauration de matériel ancien afin de préserver la mémoire des vieux métiers, des machines, tracteurs et outils divers."
    ],
    "es": [
      "Museo agrícola y de oficios antiguos, cuya vocación es salvaguardar y restaurar equipos antiguos para preservar la memoria de oficios antiguos, máquinas, tractores y herramientas diversas."
    ],
    "nl": [
      "Landbouwmuseum en oude ambachten, met als roeping het veiligstellen en restaureren van oude apparatuur om de herinnering aan oude ambachten, machines, tractoren en diverse gereedschappen te bewaren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Heritage centre : Les vieux Clous"
    ],
    "fr": [
      "Ecomusée les Vieux Clous"
    ]
  },
