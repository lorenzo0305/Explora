  "rdfs:comment": {
    "de": [
      "Im Herzen des Marais de Pré Lombard können Sie zu jeder Jahreszeit von dieser Einführung in den Orientierungslauf profitieren und die Biodiversität dieses Feuchtgebiets entdecken. Zu Fuß oder mit dem Fahrrad, an die Karten, bereit für ein spannendes Abenteuer!"
    ],
    "en": [
      "In the heart of the Marais de Pré lombard, take advantage of this all-season orienteering course to discover the biodiversity of this wetland. On foot or by bike, grab your maps and get ready for an exciting adventure!"
    ],
    "it": [
      "Nel cuore del Marais de Pré Lombard, godetevi questa introduzione all'orienteering in tutte le stagioni, per scoprire la biodiversità di questa zona umida. A piedi o in bicicletta, prendete le vostre mappe e preparatevi a vivere un'avventura emozionante!"
    ],
    "fr": [
      "Au cœur du Marais de Pré lombard, profitez en toute saison de cette initiation à la course d'orientation, prétexte  à la découverte de la biodiversité de cette zone humide. A pied ou à vélo, à vos cartes, prêt pour une aventure passionnante !"
    ],
    "nl": [
      "Geniet in het hart van het Marais de Pré Lombard van deze kennismaking met oriëntatielopen in alle seizoenen om de biodiversiteit van dit waterrijke gebied te ontdekken. Te voet of op de fiets, pak je kaarten en maak je klaar voor een spannend avontuur!"
    ],
    "es": [
      "En el corazón del Marais de Pré Lombard, disfrute de esta iniciación a la orientación en todas las estaciones, como forma de descubrir la biodiversidad de este humedal. A pie o en bicicleta, ¡coge tus mapas y prepárate para una aventura apasionante!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation A la découverte du Marais"
    ]
  },
