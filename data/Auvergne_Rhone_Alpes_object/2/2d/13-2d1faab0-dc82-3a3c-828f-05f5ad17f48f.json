  "rdfs:comment": {
    "de": [
      "Pizza zum Mitnehmen. Lieferung innerhalb der Station."
    ],
    "en": [
      "A cheerful pizzeria serving generous, tasty thin-crust pizzas, homemade with quality produce, fresh vegetables and local cheeses, served to take away or delivered to your door anywhere in the valley, depending on the number of pizzas."
    ],
    "it": [
      "Un'allegra pizzeria che serve generose e gustose pizze a crosta sottile, fatte in casa con prodotti di qualità, verdure fresche e formaggi locali, servite da asporto o consegnate a domicilio in tutta la valle, a seconda del numero di pizze."
    ],
    "fr": [
      "Joyeuse pizzeria, aux pizzas pâte fine goûteuses et généreuses, faites maison avec produits de qualité, légumes frais et fromages locaux, servies à l’emporter ou chez vous en livraison dans toute la vallée selon nombre de pizzas."
    ],
    "es": [
      "Alegre pizzería que sirve generosas y sabrosas pizzas de masa fina, hechas en casa con productos de calidad, verduras frescas y quesos locales, servidas para llevar o entregadas a domicilio en cualquier lugar del valle, según el número de pizzas."
    ],
    "nl": [
      "Afhaalpizza's. Levering in het skioord"
    ]
  },
