  "rdfs:comment": {
    "de": [
      "La ferme de l'épinette ist ein Bauernhof mit Gemüseanbau, Bäckereibauern, Schnittblumen und Eiern. Sie stellen Brot und Backwaren aus 100% Natursauerteig her, dank Mehl aus ihrem Getreide."
    ],
    "en": [
      "La Ferme de l'Épinette is a farm that grows vegetables, produces bread, cut flowers and eggs. They produce bread and baked goods using 100% natural sourdough, thanks to flour made from their own grains."
    ],
    "it": [
      "La ferme de l'épinette è un'azienda agricola che si occupa di giardinaggio, panetteria contadina, fiori recisi e uova. Produce pane e prodotti da forno a lievitazione naturale al 100%, utilizzando farine di cereali di propria produzione."
    ],
    "fr": [
      "La ferme de l'épinette est une ferme en maraîchage, paysan boulanger, fleurs à couper  et oeufs. Ils produisent des pains et produits de boulangerie 100% levain naturel, grâce à des farines issues de leurs céréales."
    ],
    "nl": [
      "La ferme de l'épinette is een tuinderij, een boerenbakkerij, snijbloemen en eieren. Ze produceren 100% natuurlijk gezuurd brood en bakkerijproducten, met meel van hun eigen graan."
    ],
    "es": [
      "La ferme de l'épinette es una granja de horticultura, panadería, flores cortadas y huevos. Producen pan y productos de panadería con levadura 100% natural, utilizando harinas procedentes de sus propios cereales."
    ]
  },
  "rdfs:label": {
