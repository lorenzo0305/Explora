      "dc:description": {
        "de": [
          "Hier können Sie französische und portugiesische Gerichte in einer warmen und freundlichen Umgebung genießen.\nWir bieten Ihnen eine saisonale Speisekarte mit hochwertigen Produkten."
        ],
        "en": [
          "Enjoy French and Portuguese dishes in a warm and friendly atmosphere.\nWe offer a seasonal menu with quality products."
        ],
        "it": [
          "Gustate i piatti francesi e portoghesi in un'atmosfera calda e accogliente.\nOffriamo un menu stagionale con prodotti di qualità."
        ],
        "fr": [
          "Vous pourrez déguster des plats français et portugais dans un cadre chaleureux et amical.\nNous vous proposons une carte de saison avec des produits de qualité."
        ],
        "nl": [
          "Geniet van Franse en Portugese gerechten in een warme en vriendelijke sfeer.\nWe bieden een seizoensgebonden menu met kwaliteitsproducten."
        ],
        "es": [
          "Disfrute de platos franceses y portugueses en un ambiente cálido y acogedor.\nOfrecemos un menú de temporada con productos de calidad."
        ]
