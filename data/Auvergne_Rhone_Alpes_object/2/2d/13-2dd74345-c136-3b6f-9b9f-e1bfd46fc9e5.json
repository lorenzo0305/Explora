  "rdfs:comment": {
    "de": [
      "Kommen Sie in den Genuss des neuen Fitnessstudios in La Motte Chalancon, um sich wieder in Form zu bringen oder zu halten!\r\nAuf der Speisekarte:\r\n- Krafttraining\r\n- Gruppenkurse\r\n- Kid's-Kurse"
    ],
    "en": [
      "Come and take advantage of La Motte Chalancon's new gym to get back into shape or stay in shape!\r\nOn the menu:\r\n- Body-building platform\r\n- Group classes\r\n- Kids' classes"
    ],
    "it": [
      "Venite ad approfittare della nuova palestra di La Motte Chalancon per rimettervi o mantenervi in forma!\r\nNel menu:\r\n- Piattaforma di body-building\r\n- Corsi di gruppo\r\n- Corsi per bambini"
    ],
    "fr": [
      "Venez profiter de la nouvelle salle de sport de La Motte Chalancon pour vous remettre ou vous maintenir en forme ! \r\nAu menu: \r\n- Plateau musculation\r\n- Cours collectifs\r\n- Cours kid's"
    ],
    "es": [
      "Venga y aproveche el nuevo gimnasio de La Motte Chalancon para recuperar la forma o mantenerse en forma\r\nEn el menú:\r\n- Plataforma de musculación\r\n- Clases colectivas\r\n- Clases para niños"
    ],
    "nl": [
      "Kom profiteren van de nieuwe fitnessruimte in La Motte Chalancon om weer in vorm te komen of fit te blijven!\r\nOp het menu:\r\n- Bodybuilding platform\r\n- Groepslessen\r\n- Lessen voor kinderen"
    ]
  },
