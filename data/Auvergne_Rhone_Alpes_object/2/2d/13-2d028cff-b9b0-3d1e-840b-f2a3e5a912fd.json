          "additionalInformation": {
            "de": [
              "Die Strecke ist das ganze Jahr über geöffnet:\r\nJuli/August: 7/7 von 9:30 bis 19:30 Uhr\r\nAußerhalb der Saison an Wochenenden und unter der Woche nach vorheriger Anmeldung geöffnet. Auch in den Schulferien geöffnet."
            ],
            "en": [
              "Circuit open all year round:\r\nJuly/August: 7/7 from 9:30 am to 7:30 pm\r\nOut of season, open weekends and weekdays by reservation. Also open for all school vacations."
            ],
            "it": [
              "Circuito aperto tutto l'anno:\r\nLuglio/Agosto: 7/7 dalle 9.30 alle 19.30\r\nFuori stagione, aperto nei fine settimana e nei giorni feriali su prenotazione. Aperto anche per tutte le vacanze scolastiche."
            ],
            "fr": [
              "Circuit ouvert à l'année:\r\nJuillet/Aout: 7/7 de 9h30 à 19h30\r\nHors saison, ouvert les week-ends et en semaine sur réservation. Également ouvert pour toutes les vacances scolaires."
            ],
            "es": [
              "Circuito abierto todo el año\r\nJulio/agosto: 7/7 de 9h30 a 19h30\r\nFuera de temporada, abierto fines de semana y días laborables con cita previa. Abierto también durante todas las vacaciones escolares."
            ],
            "nl": [
              "Circuit het hele jaar geopend:\r\nJuli/augustus: 7/7 van 9u30 tot 19u30\r\nBuiten het seizoen: weekenden en weekdagen op afspraak. Ook open tijdens alle schoolvakanties."
            ]
          },
