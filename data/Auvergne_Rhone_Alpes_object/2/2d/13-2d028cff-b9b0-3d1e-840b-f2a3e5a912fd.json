  "rdfs:comment": {
    "de": [
      "MP Karting befindet sich neben dem Flugplatz Aubenas-Lanas. Eine von der FFSA zugelassene Rennstrecke erwartet Sie, Anfänger oder Fortgeschrittene, um Go-Karts zu mieten und Veranstaltungen zu organisieren.\r\nKlimatisierte Bar, Panoramaterrasse mit Nebelmaschine."
    ],
    "en": [
      "MP karting welcomes you at the aerodrome supervised by a statemonitor \"BP JEPS\". A modular karting track awaits you for rental karting and event operations.\r\nAir conditioned bar, panoramic terrace, track for children from 3 years."
    ],
    "it": [
      "MP Karting, situato accanto all'aerodromo di Aubenas-Lanas. Un circuito omologato FFSA vi aspetta, che siate principianti o esperti, per il noleggio di kart ed eventi.\r\nBar climatizzato, terrazza panoramica con impianto di nebulizzazione."
    ],
    "fr": [
      "MP Karting , situé à côté de l'aérodrome Aubenas-Lanas. Un circuit homologué FFSA vous attend, débutant(e)s ou confirmé(e)s pour de la location karting et opérations événementielles.\r\nBar climatisé, terrasse panoramique avec brumisateur."
    ],
    "es": [
      "MP Karting, situado junto al aeródromo de Aubenas-Lanas. Un circuito homologado por la FFSA le espera, ya sea principiante o piloto experimentado, para el alquiler de karts y la organización de eventos.\r\nBar climatizado, terraza panorámica con sistema de nebulización."
    ],
    "nl": [
      "MP Karting, gelegen naast het vliegveld van Aubenas-Lanas. Een door de FFSA goedgekeurd circuit wacht op je, of je nu een beginner of een ervaren coureur bent, voor kartingverhuur en evenementen.\r\nBar met airconditioning, panoramisch terras met mistsysteem."
    ]
  },
