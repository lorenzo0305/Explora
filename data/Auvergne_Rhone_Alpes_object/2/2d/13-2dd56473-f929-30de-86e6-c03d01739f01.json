  "rdfs:comment": {
    "de": [
      "Das Gemeindewaschhaus wurde dank der Spende von Xavier Sylvestre, einem Einwohner von Chamaret, der sein Vermögen der Gemeinde vermachte, errichtet."
    ],
    "en": [
      "The communal washhouse was built thanks to a donation from Xavier Sylvestre, a resident of Chamaret who bequeathed his fortune to the commune."
    ],
    "it": [
      "Il lavatoio comunale è stato costruito grazie alla donazione di Xavier Sylvestre, un abitante di Chamaret che ha lasciato in eredità al comune la sua fortuna."
    ],
    "fr": [
      "Le lavoir communal a été construit grâce au don de Xavier Sylvestre, habitant de Chamaret qui légua sa fortune à la commune."
    ],
    "nl": [
      "Het gemeenschappelijke washuis werd gebouwd dankzij een schenking van Xavier Sylvestre, een inwoner van Chamaret die zijn fortuin aan de gemeente naliet."
    ],
    "es": [
      "El lavadero comunal se construyó gracias a una donación de Xavier Sylvestre, vecino de Chamaret que legó su fortuna al municipio."
    ]
  },
  "rdfs:label": {
