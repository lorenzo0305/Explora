  "rdfs:comment": {
    "de": [
      "Sie können die Fleischprodukte der Farm probieren, die an dem in den Speisesaal integrierten Foodtruck serviert werden.  Spezialitäten aus Fleisch von Black Angus-Rindern, die vor Ort gezüchtet werden. Hausgemachtes Bubble Waffle-Dessert. Für das Catering Reservierung per SMS."
    ],
    "en": [
      "You can sample the farm's meat products served at the Foodtruck integrated into the dining room.  Specialties based on Black Angus beef raised on site. Homemade bubble waffle dessert. For catering, reservation by sms."
    ],
    "it": [
      "È possibile assaggiare i prodotti a base di carne della fattoria serviti al Foodtruck nella sala da pranzo.  Specialità a base di manzo Black Angus allevato in loco. Dessert a base di cialde di bolle di sapone fatte in casa. Per prenotazioni di catering via SMS."
    ],
    "fr": [
      "Vous pourrez déguster les produits carnés de la ferme servis au  Foodtruck intégré dans la salle de restauration.  Spécialités à base de viande de boeuf Black Angus élevés sur place. Dessert bubble waffle maison. Pour la restauration réservation par sms."
    ],
    "es": [
      "Puede degustar los productos cárnicos de la granja servidos en el Foodtruck del comedor.  Especialidades a base de ternera Black Angus criada in situ. Postre casero de gofres con burbujas. Para reservas de catering por mensaje de texto."
    ],
    "nl": [
      "Je kunt de vleesproducten van de boerderij proeven die worden geserveerd in de Foodtruck in de eetzaal.  Specialiteiten op basis van ter plekke gefokt Black Angus rundvlees. Huisgemaakt bubbelwafeldessert. Voor catering boekingen per sms."
    ]
  },
  "rdfs:label": {
    "fr": [
      "West Angus Saloon"
    ]
  },
