  "rdfs:comment": {
    "de": [
      "Willkommen bei No?Limits, dem originellen Streetfood, das von der Leidenschaft des Küchenchefs getragen wird. Hausgemachte Rezepte, lokale Produkte, ein modernes kulinarisches Erlebnis. Eine freundliche und warme Atmosphäre, in der man nicht nur gut essen, sondern auch eine gute Zeit verbringen will"
    ],
    "en": [
      "Welcome to No?Limits, the original street-food restaurant driven by the chef's passion. Homemade recipes, local produce, a modern culinary experience. A warm, friendly atmosphere where you come to eat well and have a good time"
    ],
    "it": [
      "Benvenuti al No?Limits, l'originale ristorante di street-food guidato dalla passione dello chef. Ricette fatte in casa, prodotti locali, un'esperienza culinaria moderna. Un'atmosfera calda e accogliente, dove si viene per mangiare bene e divertirsi"
    ],
    "fr": [
      "Bienvenue chez No’Limits le street-food original porté par la passion du chef. Recettes maison, des produits locaux, une expérience culinaire moderne. Atmosphère conviviale et chaleureuse où l’on vient autant pour bien manger que pour passer un bon moment"
    ],
    "nl": [
      "Welkom bij No Limits, het originele streetfoodrestaurant gedreven door de passie van de chef. Huisgemaakte recepten, lokale producten, een moderne culinaire ervaring. Een warme en vriendelijke sfeer, waar mensen komen om lekker te eten en een goede tijd te hebben"
    ],
    "es": [
      "Bienvenido a No Limits, el restaurante original de comida callejera impulsado por la pasión del chef. Recetas caseras, productos locales, una experiencia culinaria moderna. Un ambiente cálido y acogedor, donde la gente viene a comer bien y a pasarlo bien"
    ]
  },
  "rdfs:label": {
    "fr": [
      "No'Limits Street Food"
    ]
  },
