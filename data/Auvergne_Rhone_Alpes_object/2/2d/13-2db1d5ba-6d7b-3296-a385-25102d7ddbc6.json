  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais Vert durch ein spielerisches und kostenloses Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nIn Ranchal begeben Sie sich auf die Jagd nach Yookâ, der in der Natur unerschöpflich ist."
    ],
    "en": [
      "Discover the Beaujolais Vert through a fun and free geocaching experience: a treasure hunt to be enjoyed by the whole family!\r\nIn Ranchal, go on a hunt for Yookâ, who knows everything about nature."
    ],
    "it": [
      "Scoprite il Beaujolais Vert attraverso un'esperienza di geocaching divertente e gratuita: una caccia al tesoro per tutta la famiglia!\r\nA Ranchal, andate a caccia di Yookâ, che sa tutto sulla natura."
    ],
    "fr": [
      "Découvrez le Beaujolais Vert à travers une expérience ludique et gratuite de géocaching : une chasse aux trésors à vivre en famille !\r\nÀ Ranchal, partez à la chasse de Yookâ, incollable sur la nature."
    ],
    "nl": [
      "Ontdek de Beaujolais Vert via een leuke en gratis geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nGa in Ranchal op jacht naar Yookâ, die alles weet over de natuur."
    ],
    "es": [
      "Descubra el Beaujolais Vert a través de una experiencia de geocaching divertida y gratuita: ¡una búsqueda del tesoro para toda la familia!\r\nEn Ranchal, vaya a la caza de Yookâ, que lo sabe todo sobre la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Saint-Bernard, m'entendez-vous"
    ]
  },
