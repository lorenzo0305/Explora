  "rdfs:comment": {
    "de": [
      "Die Natur, ihre Farben, ihre Bewegungen, das ist es, was ich auf meinen Leinwänden und in meinen Skulpturen zum Ausdruck bringen möchte."
    ],
    "en": [
      "Nature, its colours, its movements, that's what I want to express in my paintings and sculptures."
    ],
    "it": [
      "La natura, i suoi colori, i suoi movimenti, è ciò che voglio esprimere nei miei dipinti e nelle mie sculture."
    ],
    "fr": [
      "La nature, ses couleurs, ses mouvements, c'est ce qui me tient à cœur d'exprimer sur mes toiles et mes sculptures."
    ],
    "es": [
      "La naturaleza, sus colores, sus movimientos, eso es lo que quiero expresar en mis cuadros y esculturas."
    ],
    "nl": [
      "De natuur, haar kleuren, haar bewegingen, dat is wat ik wil uitdrukken in mijn schilderijen en beelden."
    ]
  },
