  "rdfs:comment": {
    "de": [
      "\"Aux p'tits oignons\" enthüllt Ihnen seine traditionellen Gerichte mit einem Hauch von Inspiration aus der Weltküche. In einer herzlichen und entspannten Atmosphäre genießen Sie eine saisonale und qualitativ hochwertige Küche."
    ],
    "en": [
      "\"Aux p'tits oignons\" offers traditional dishes with a hint of world cuisine. In a warm and relaxed atmosphere, enjoy quality seasonal cuisine."
    ],
    "it": [
      "\"Aux p'tits oignons\" serve piatti tradizionali con un pizzico di cucina mondiale. In un'atmosfera calda e rilassata, potrete gustare una cucina stagionale di qualità."
    ],
    "fr": [
      "\"Aux p'tits oignons\" vous dévoile ses plats traditionnels, avec une pointe d'inspiration de cuisine du monde. Dans une ambiance chaleureuse et détendue, profitez d'une cuisine de saison et de qualité."
    ],
    "es": [
      "\"Aux p'tits oignons\" sirve platos tradicionales con un toque de cocina del mundo. En un ambiente cálido y relajado, disfrute de una cocina de temporada de calidad."
    ],
    "nl": [
      "\"Aux p'tits oignons serveert traditionele gerechten met een vleugje wereldkeuken. Geniet in een warme en ontspannen sfeer van seizoensgebonden kwaliteitsgerechten."
    ]
  },
