      "dc:description": {
        "de": [
          "Nathalie empfängt Sie das ganze Jahr über mit dem gleichen Wunsch, Sie zu einer Frau zu machen, die mit sich selbst im Einklang ist."
        ],
        "en": [
          "Nathalie welcomes you all year round with the same desire to make you, ladies, a woman in harmony with herself."
        ],
        "it": [
          "Nathalie vi accoglie tutto l'anno con lo stesso desiderio di fare di voi, signore, una donna in armonia con se stessa."
        ],
        "fr": [
          "Nathalie vous accueille toute l’année avec toujours la même envie de faire vous mesdames une femme en harmonie avec elle-même."
        ],
        "nl": [
          "Nathalie verwelkomt jullie het hele jaar door met hetzelfde verlangen om van jullie, dames, een vrouw in harmonie met zichzelf te maken."
        ],
        "es": [
          "Nathalie les acoge todo el año con el mismo deseo de hacer de ustedes, señoras, una mujer en armonía consigo misma."
        ]
      },
