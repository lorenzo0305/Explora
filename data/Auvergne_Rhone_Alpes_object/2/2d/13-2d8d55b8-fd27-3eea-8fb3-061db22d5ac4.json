  "rdfs:comment": {
    "de": [
      "Dieser Raum befindet sich in der Eishalle (im Erdgeschoss) und verfügt über 5 Kardiogeräte, verschiedene Kraftgeräte und kleine Geräte für die Propriozeption."
    ],
    "en": [
      "Located in ice rink building (ground floor), the fitness room is equipped with 5 cardio machines, a wide variety of weight machines, and proprioception exercise equipment."
    ],
    "it": [
      "Integrata nella pista di pattinaggio (al piano terra), questa sala dispone di 5 macchine cardio, varie macchine per l'allenamento con i pesi e piccole attrezzature propriocettive."
    ],
    "fr": [
      "Intégrée dans l’enceinte de la patinoire (au rez-de-chaussée), Cette salle dispose de 5 appareils cardios, d’appareils de musculation variés et de petits matériels de proprioception."
    ],
    "es": [
      "Integrada en el recinto de la pista de hielo (en la planta baja), esta sala cuenta con cinco máquinas de cardio, varias máquinas de pesas y pequeños equipos de propiocepción."
    ],
    "nl": [
      "Deze ruimte is geïntegreerd in de ijsbaan (op de begane grond) en beschikt over 5 cardiotoestellen, diverse krachttrainingstoestellen en kleine proprioceptietoestellen."
    ]
  },
