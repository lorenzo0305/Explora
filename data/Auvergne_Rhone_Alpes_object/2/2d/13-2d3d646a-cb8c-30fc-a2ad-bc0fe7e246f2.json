  "rdfs:comment": {
    "de": [
      "Dorf Vals-le-Chastel: Alte Kirche, deren herrschaftliche Kapelle Wandmalereien aus dem 15. Jahrhundert enthält. Jahrhundert. Herrschaftsturm aus dem 12. und 13. Jahrhundert (privat)."
    ],
    "en": [
      "Village of Vals-le-Chastel: ancient church whose seigniorial chapel contains 15th-century wall paintings. Seigniorial tower from the 12th and 13th centuries (private)."
    ],
    "it": [
      "Villaggio di Vals-le-Chastel: antica chiesa la cui cappella signorile contiene dipinti murali del XV secolo. Torre signorile del XII e XIII secolo (privata)."
    ],
    "fr": [
      "Village de Vals-le-Chastel : Église ancienne dont la chapelle seigneuriale contient des peintures murales du XVe siècle. Tour seigneuriale des XIIe et XIIIe siècles (privé)."
    ],
    "es": [
      "Pueblo de Vals-le-Chastel: antigua iglesia cuya capilla señorial contiene pinturas murales del siglo XV. Torre señorial de los siglos XII y XIII (privada)."
    ],
    "nl": [
      "Dorp Vals-le-Chastel: Oude kerk waarvan de heerlijkheidskapel 15e-eeuwse muurschilderingen bevat. 12e en 13e eeuwse heerlijkheidstoren (privé)."
    ]
  },
  "rdfs:label": {
