  "rdfs:comment": {
    "de": [
      "Mein Name ist Patricia, ich bin Bergbegleiterin und begeisterte Bergsteigerin.\r\nJede Wanderung ist ein Eintauchen in die Natur, eine Öffnung zu neuen Erkenntnissen, eine Auszeit zum Auftanken, ein Raum zum Teilen!"
    ],
    "en": [
      "I'm Patricia, a mountain leader with a passion for the mountains.\r\nEach hike is an immersion in nature, an opening onto new knowledge, a moment of rejuvenation, a space for sharing!"
    ],
    "it": [
      "Sono Patricia, una guida alpina con la passione per la montagna.\r\nOgni escursione è un'immersione nella natura, un'apertura a nuove conoscenze, un'occasione per ricaricarsi e un luogo di condivisione!"
    ],
    "fr": [
      "Je m'appelle Patricia, accompagnatrice en montagne, passionnée de montagne.\r\nChaque randonnée est une immersion dans la nature, une ouverture vers de nouvelles connaissances, une parenthèse de ressourcement, un espace de partage !"
    ],
    "es": [
      "Soy Patricia, una guía de montaña apasionada por la montaña.\r\nCada excursión es una inmersión en la naturaleza, una apertura a nuevos conocimientos, una oportunidad para recargar las pilas y ¡un lugar para compartir!"
    ],
    "nl": [
      "Ik ben Patricia, een bergleidster met een passie voor de bergen.\r\nElke wandeling is een onderdompeling in de natuur, een opening naar nieuwe kennis, een kans om nieuwe energie op te doen en een plek om te delen!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Montagnes Sentiers Sérénité - Mountain leader"
    ],
    "fr": [
      "Montagnes Sentiers Sérénité - Accompagnatrice en montagne"
    ]
  },
