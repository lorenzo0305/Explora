  "rdfs:comment": {
    "de": [
      "Seit 1974 bietet das Restaurant einen angenehmen Aufenthalt in einem echten neapolitanischen Haus mit gemütlicher Atmosphäre.\r\n Hier können Sie neapolitanische Pizzas probieren, die in einem vor 45 Jahren von einem Team aus Neapel entworfenen Ofen auf Holzfeuer gebacken werden."
    ],
    "en": [
      "Since 1974, the restaurant has been offering a pleasant moment in a real Neapolitan house with a warm atmosphere.\r\n You'll enjoy wood-fired Neapolitan pizzas baked in an oven designed 45 years ago by a team from Naples."
    ],
    "it": [
      "Dal 1974, il ristorante offre un momento piacevole in una vera casa napoletana con una calda atmosfera.\r\n Potrete gustare pizze napoletane cotte a legna in un forno progettato 45 anni fa da un team di Napoli."
    ],
    "fr": [
      "Depuis 1974, le restaurant offre un agréable moment dans une véritable maison Napolitaine à l'ambiance chaleureuse.\r\n Vous y dégusterez Pizzas Napolitaines cuites au feu de bois dans un four conçu il y a 45 ans par une équipe venue de Naples."
    ],
    "nl": [
      "Sinds 1974 biedt het restaurant een aangenaam moment in een echt Napolitaans huis met een warme sfeer.\r\n U zult genieten van Napolitaanse pizza's die op houtvuur worden bereid in een oven die 45 jaar geleden is ontworpen door een team uit Napels."
    ],
    "es": [
      "Desde 1974, el restaurante ofrece un momento agradable en una auténtica casa napolitana con un ambiente cálido.\r\n Disfrute de pizzas napolitanas cocinadas a la leña en un horno diseñado hace 45 años por un equipo de Nápoles."
    ]
  },
  "rdfs:label": {
    "en": [
      "La tavola calda"
    ],
    "fr": [
      "La Tavola Calda"
    ]
  },
