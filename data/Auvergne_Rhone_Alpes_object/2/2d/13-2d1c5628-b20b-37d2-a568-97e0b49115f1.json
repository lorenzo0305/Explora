  "rdfs:comment": {
    "de": [
      "Sie haben Lust auf eine beruhigende Auszeit am Ufer der Rhône? Dann heißen wir Sie im Bellevue willkommen! Sie wohnen in einem unserer 14 Zimmer, von denen 11 einen Blick auf die Weinberge, die Rhône und den Yachthafen bieten."
    ],
    "en": [
      "Charming hotel of 16 bedrooms including 11 with view over the vineyards and the marina of les Roches de Condrieu. Attached, an air-conditioned restaurant, a seminar room, a lounge and a lift."
    ],
    "it": [
      "Siete alla ricerca di una fuga rilassante sulle rive del Rodano? Allora benvenuti al Bellevue! Soggiornerete in una delle nostre 14 camere, 11 delle quali con vista sui vigneti, sul Rodano e sulla marina."
    ],
    "fr": [
      "Vous avez envie d'une escapade apaisante au bord du Rhône ? Alors bienvenue au Bellevue ! Vous séjournerez dans l'une de nos 14 chambres dont 11 avec vue sur les vignobles, le Rhône et le port de plaisance."
    ],
    "es": [
      "¿Busca una escapada de relax a orillas del Ródano? ¡Entonces bienvenido al Bellevue! Se alojará en una de nuestras 14 habitaciones, 11 de las cuales tienen vistas a los viñedos, al Ródano y al puerto deportivo."
    ],
    "nl": [
      "Bent u op zoek naar een ontspannende vakantie aan de oevers van de Rhône? Dan welkom in het Bellevue! U verblijft in een van onze 14 kamers, waarvan 11 met uitzicht op de wijngaarden, de Rhône en de jachthaven."
    ]
  },
