  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich am Jachthafen und bietet eine außergewöhnliche Lage mit einer Terrasse auf Stelzen. A la carte: Tataki (Thunfisch und Rindfleisch), Sushi, Maki, Tatar (Lachs und Rindfleisch), Frühlingsrollen, Poke Bols, Woks, Desserts, eine Auswahl an Weinen und Cocktails."
    ],
    "en": [
      "Situated on the marina, the restaurant offers an exceptional location with a terrace on stilts. A la carte: Tataki (tuna and beef), sushi, maki, tartare (salmon and beef), nems, poke bol, woks, desserts, wine selection and cocktails."
    ],
    "it": [
      "Situato sul porto turistico, il ristorante vanta una posizione eccezionale e una terrazza su palafitte. Nel menu: fonduta asiatica, sushi, maki, tartara, tataki, involtini primavera, poké bowls, ramen, oltre a una selezione di vini e cocktail."
    ],
    "fr": [
      "Situé sur le port de plaisance, le restaurant bénéficie d’un emplacement exceptionnel et d’une terrasse sur pilotis. À la carte : fondue asiatique, sushis, makis, tartares, tatakis, nems, poké bowls, ramens, ainsi qu’une sélection de vins et cocktails."
    ],
    "es": [
      "Situado en el puerto deportivo, el restaurante goza de una ubicación excepcional y una terraza sobre pilotes. En el menú: fondue asiática, sushi, maki, tartar, tataki, rollitos de huevo, poké bowls, ramen, así como una selección de vinos y cócteles."
    ],
    "nl": [
      "Het restaurant ligt aan de jachthaven en heeft een uitzonderlijke locatie en een terras op palen. Op het menu: Aziatische fondue, sushi, maki, tartaar, tataki, loempia's, poké bowls, ramen, evenals een selectie wijnen en cocktails."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cabane du Général"
    ]
  },
