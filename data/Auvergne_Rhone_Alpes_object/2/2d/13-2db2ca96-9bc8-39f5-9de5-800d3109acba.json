  "rdfs:comment": {
    "de": [
      "be Bike ist eine Mountainbike-Schule, die Ausflüge mit Mountainbikes und elektrisch unterstützten Mountainbikes, Downhill-Mountainbiking und wöchentliche Trainings für Kinder und Jugendliche anbietet."
    ],
    "en": [
      "Be Bike has a closed and equipped mountain bike area. The company\r\norganises mountain bike and BMX courses for children and teenagers."
    ],
    "it": [
      "be Bike è una scuola di mountain bike che offre uscite in mountain bike e mountain bike a pedalata assistita, downhill e allenamenti settimanali per bambini e ragazzi."
    ],
    "fr": [
      "be Bike est une école de VTT qui propose des sorties en VTT et VTT à assistance électrique, du VTT de descente et des entrainements hebdomadaires pour enfants et ados."
    ],
    "nl": [
      "be Bike is een mountainbikeschool die mountainbike- en elektrisch ondersteunde mountainbike-uitstapjes, downhill mountainbiken en wekelijkse trainingssessies voor kinderen en tieners aanbiedt."
    ],
    "es": [
      "be Bike es una escuela de bicicleta de montaña que ofrece salidas en bicicleta de montaña y bicicleta de montaña con asistencia eléctrica, descenso en bicicleta de montaña y sesiones semanales de entrenamiento para niños y adolescentes."
    ]
  },
