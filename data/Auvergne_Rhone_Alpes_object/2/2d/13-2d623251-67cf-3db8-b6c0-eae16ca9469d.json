  "rdfs:comment": {
    "de": [
      "Die Fahrradroute Via Allier führt weiter durch das ehemalige Bergbaugebiet und betritt in Sainte-Florine die Haute-Loire."
    ],
    "en": [
      "The Via Allier cycle route continues to cross the former mining basin and enters the Haute-Loire at Sainte-Florine."
    ],
    "it": [
      "L'itinerario ciclabile Via Allier continua ad attraversare l'ex bacino carbonifero ed entra nella Haute-Loire a Sainte-Florine."
    ],
    "fr": [
      "L'itinéraire vélo de la Via Allier poursuit sa traversée de l'ancien bassin minier et pénètre en Haute-Loire à Sainte-Florine."
    ],
    "es": [
      "La ruta ciclista Via Allier continúa atravesando la antigua cuenca minera y se adentra en el Alto Loira a la altura de Sainte-Florine."
    ],
    "nl": [
      "De fietsroute Via Allier gaat verder door het voormalige steenkoolgebied en komt de Haute-Loire binnen bij Sainte-Florine."
    ]
  },
