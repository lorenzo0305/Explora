  "rdfs:comment": {
    "de": [
      "Verkauf und Förderung regionaler Produkte: ätherisches Bio-Lavendel- und Lavandinöl, Walnussöl, Honig, Lavendelsträuße, Lindenblüten, Thymian... Entdeckung der althergebrachten Destillation (Lavendel, Lavandin), der ätherischen Öle...Kostenlose Besichtigung."
    ],
    "en": [
      "Selling of essential oils and regional product : walnut oil, wild flower and lavender honey, lavender bunches, lime, thyme… Discovery of the ancestral distillation (lavender and lavendin), find out about the difference between these two species, essential oils... Free visit."
    ],
    "it": [
      "Vendita e promozione di prodotti locali: olio essenziale biologico di lavanda e lavandino, olio di noci, miele, bouquet di lavanda, tiglio, timo... Scoperta della distillazione ancestrale (lavanda, lavandina), oli essenziali... Visita gratuita."
    ],
    "fr": [
      "Vente et promotion des produits du terroir : huile essentielle bio de lavande et lavandin, huile de noix, miel, bouquets de lavande, tilleul, thym... Découverte de la distillation ancestrale (lavande, lavandin), des huiles essentielles...Visite gratuite."
    ],
    "nl": [
      "Verkoop en promotie van streekproducten: notenolie, lavendelhoning en bloemenhoning, lavendelbouquets, linde, tijm... Introductie van de prototypische destillatie (lavendel, lavandin), etherische oliën... Bezoeken is gratis."
    ],
    "es": [
      "Venta y promoción de productos locales: aceite esencial ecológico de lavanda y lavandín, aceite de nuez, miel, ramos de lavanda, tilo, tomillo... Descubrimiento de la destilación ancestral (lavanda, lavandín), aceites esenciales... Visita gratuita."
    ]
  },
  "rdfs:label": {
