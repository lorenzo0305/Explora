  "rdfs:comment": {
    "de": [
      "Ein Weinkeller mit über 400 verschiedenen Biersorten in Flaschen, Fässern, Kästen und Bierzapfanlagen und eine Bar, in der das Bier Königin ist! Regelmäßige Themenabende und Animationen."
    ],
    "en": [
      "A cellar with over 400 references of bottled beers, kegs, boxes and beer taps, and a bar where beer is king! Theme evenings and regular entertainment."
    ],
    "it": [
      "Una cantina con più di 400 referenze di birre in bottiglia, botti, cassette e spillatori di birra e un bar dove la birra è regina! Serate a tema e intrattenimento regolari."
    ],
    "fr": [
      "Une cave de plus de 400 références de bières bouteilles, fûts, coffrets et tireuses à bière et un bar où la bière est reine ! Soirées à thème et animations régulières."
    ],
    "es": [
      "Una bodega con más de 400 referencias de cervezas embotelladas, barriles, cajas y grifos de cerveza y un bar donde la cerveza es el rey Veladas temáticas regulares y entretenimiento."
    ],
    "nl": [
      "Een kelder met meer dan 400 referenties aan flessenbieren, vaten, dozen en biertaps, en een bar waar bier koning is! Regelmatige thema-avonden en entertainment."
    ]
  },
