  "rdfs:comment": {
    "de": [
      "Dieses Restaurant bietet traditionelle und einheimische Küche: Schweinsfüße überbacken mit Fourme, Kalbskopf, Foie Gras, Bries, Schnecken, Frösche, Braten."
    ],
    "en": [
      "This restaurant offers traditional and traditional local cuisine: pig's feet au gratin with fourme, calf's head, foie gras, sweetbreads, snails, frogs, frying."
    ],
    "it": [
      "Questo ristorante offre una cucina locale tradizionale e casalinga: zampone di maiale gratinato con formaggio fourme, testina di vitello gribiche, foie gras, sfoglia di animelle, lumache, rane (su prenotazione), insalate, gelati e dolci fatti in casa."
    ],
    "fr": [
      "Ce restaurant propose une cuisine de terroir traditionnelle & artisanale : pieds de cochon gratinés à la fourme, tête de veau gribiche, foie gras, feuilleté de ris de veau, escargots, grenouilles (sur réservation), salades, glaces et desserts maison."
    ],
    "es": [
      "Este restaurante ofrece una cocina local tradicional y casera: manitas de cerdo gratinadas con queso fourme, cabeza de ternera gribiche, foie gras, hojaldre de mollejas, caracoles, ranas (bajo reserva), ensaladas, helados y postres caseros."
    ],
    "nl": [
      "Dit restaurant biedt traditionele en huisgemaakte streekgerechten: gegratineerde varkenspootjes met fourme kaas, gribiche kalfskop, foie gras, zwezerik bladerdeeg, slakken, kikkers (op reservering), salades, ijs en huisgemaakte desserts."
    ]
  },
