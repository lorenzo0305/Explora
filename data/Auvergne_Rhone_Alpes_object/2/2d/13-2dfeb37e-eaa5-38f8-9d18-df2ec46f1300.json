  "rdfs:comment": {
    "de": [
      "Atelier für handwerkliche Töpferei.\nGebrauchskreationen aus Steinzeug mit klaren und feinen Formen: Schalen, Tassen, Salatschüsseln... aber auch Lampen, Kerzenhalter und Pflanzentöpfe. Große geschnitzte Vasen und Amphoren.\nKeine Praktika."
    ],
    "en": [
      "Artisanal pottery workshop.\nUtilitarian creations in stoneware with pure, fine shapes: bowls, cups, salad bowls... but also lamps, candleholders and plant pots. Large sculpted vases and amphoras.\nNo workshops."
    ],
    "it": [
      "Laboratorio artigianale di ceramica.\r\nCreazioni utilitarie in gres dalle forme pure e raffinate: ciotole, tazze, insalatiere... ma anche lampade, portacandele e vasi per piante. Grandi vasi e anfore scolpite.\r\nNon ci sono corsi."
    ],
    "fr": [
      "Atelier de poterie artisanale. \r\nCréations utilitaires en grès avec des formes épurées et fines : des bols, des tasses, des saladiers... mais aussi des lampes, des bougeoirs et des pots de plantes. Grande vases et amphores sculptés.\r\nPas de stages."
    ],
    "es": [
      "Taller de alfarería artesanal.\r\nCreaciones utilitarias en gres de formas puras y finas: cuencos, tazas, ensaladeras... pero también lámparas, candelabros y macetas. Grandes jarrones esculpidos y ánforas.\r\nSin cursos."
    ],
    "nl": [
      "Ambachtelijk aardewerkatelier.\nUtilitaire creaties in steengoed met pure, fijne vormen: kommen, kopjes, saladeschalen... maar ook lampen, kandelaars en plantenpotten. Grote gebeeldhouwde vazen en amforen.\nGeen cursussen."
    ]
  },
