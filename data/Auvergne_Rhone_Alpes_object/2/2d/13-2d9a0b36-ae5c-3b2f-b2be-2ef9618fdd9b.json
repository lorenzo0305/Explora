  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf ein außergewöhnliches Sporterlebnis vor, ein Triathlon-Event, das Sie nicht verpassen sollten. Der Trivert verbindet sportliche Herausforderung mit der Entdeckung einer Gegend, die reich an Geschichte und Schönheit ist, und verspricht unvergessliche Erinnerungen für alle Teilnehmer."
    ],
    "en": [
      "Get ready for an extraordinary sporting experience, an unmissable triathlon event. Combining a sporting challenge with the discovery of an area rich in history and beauty, the Trivert promises memorable moments for all participants."
    ],
    "it": [
      "Preparatevi a un'esperienza sportiva straordinaria, un evento di triathlon da non perdere. Combinando una sfida sportiva con la scoperta di un territorio ricco di storia e bellezza, il Trivert promette momenti memorabili per tutti i partecipanti."
    ],
    "fr": [
      "Préparez-vous à vivre une expérience sportive hors du commun, un événement triathlon incontournable. Alliant défi sportif et découverte d’un territoire riche en histoire et en beauté, le Trivert promet des souvenirs mémorables pour tous les participants."
    ],
    "es": [
      "Prepárese para una experiencia deportiva extraordinaria, un evento de triatlón que no se puede perder. Combinando un reto deportivo con el descubrimiento de una zona rica en historia y belleza, el Trivert promete momentos memorables para todos los participantes."
    ],
    "nl": [
      "Bereid je voor op een buitengewone sportieve ervaring, een triatlonevenement dat je niet mag missen. De Trivert combineert een sportieve uitdaging met de ontdekking van een gebied dat rijk is aan geschiedenis en schoonheid en belooft onvergetelijke momenten voor alle deelnemers."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trivert : cross triathlon nature"
    ]
  },
