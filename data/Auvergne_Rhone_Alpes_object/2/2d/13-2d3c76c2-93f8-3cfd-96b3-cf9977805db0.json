  "rdfs:comment": {
    "de": [
      "Yllar Montagne ist eine Agentur, die spielerische Aktivitäten für Gruppen in den Alpen organisiert. Von 16 bis 200 Personen entwerfen wir lustige und kollaborative Spiele, die Sie als Team spielen lassen. Murder-Party, Koh-Lanta, Rallyes, Olympiaden."
    ],
    "en": [
      "Yllar Montagne is an agency that organizes fun activities for groups in the Alps. From 16 to 200 people, we design fun, collaborative games to get you playing as a team. Murder-Party, Koh-Lanta, Rallies, Olympiads."
    ],
    "it": [
      "Yllar Montagne è un'agenzia che organizza attività divertenti per gruppi nelle Alpi. Da 16 a 200 persone, progettiamo giochi divertenti e collaborativi da fare in squadra. Murder-Party, Koh-Lanta, raduni, olimpiadi."
    ],
    "fr": [
      "Yllar Montagne est une agence qui organise des activités ludiques pour les groupes, dans les Alpes. De 16 à 200 personnes, nous concevons des jeux drôles et collaboratifs pour vous faire jouer en équipe. Murder-Party, Koh-Lanta, Rallyes, Olympiades."
    ],
    "nl": [
      "Yllar Montagne is een agentschap dat leuke activiteiten organiseert voor groepen in de Alpen. Van 16 tot 200 personen ontwerpen we leuke en samenwerkende spellen om als team te spelen. Murder-Party, Koh-Lanta, Rallies, Olympiades."
    ],
    "es": [
      "Yllar Montagne es una agencia que organiza actividades lúdicas para grupos en los Alpes. De 16 a 200 personas, diseñamos juegos divertidos y colaborativos para jugar en equipo. Murder-Party, Koh-Lanta, Rallies, Olimpiadas."
    ]
  },
