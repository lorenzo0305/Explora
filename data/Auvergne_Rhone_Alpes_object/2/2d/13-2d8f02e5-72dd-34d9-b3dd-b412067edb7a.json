  "rdfs:comment": {
    "de": [
      "Unser gastronomisches Credo ist einfach und ein Versprechen für kulinarische Exzellenz: Wir wollen Ihnen ein einzigartiges und dennoch typisches Geschmackserlebnis bieten, das aus Produkten der Region und der Saison besteht."
    ],
    "en": [
      "Our gastronomic credo is simple, in the form of a promise of culinary excellence: to offer you a unique yet typical tasting experience, based on local, seasonal produce."
    ],
    "it": [
      "Il nostro credo gastronomico è semplice, sotto forma di promessa di eccellenza culinaria: offrirvi un'esperienza di degustazione unica e tipica, a base di prodotti locali e di stagione."
    ],
    "fr": [
      "Notre crédo gastronomique se veut simple, en forme de promesse d’excellence culinaire : vous proposer une expérience de dégustation unique et néanmoins typique, faite de produits de terroirs et de saison."
    ],
    "nl": [
      "Ons gastronomisch credo is eenvoudig, in de vorm van een belofte van culinaire uitmuntendheid: je een unieke maar typische proefervaring bieden, gemaakt van lokale, seizoensgebonden producten."
    ],
    "es": [
      "Nuestro credo gastronómico es sencillo, en forma de promesa de excelencia culinaria: ofrecerle una experiencia de degustación única y al mismo tiempo típica, elaborada con productos locales de temporada."
    ]
  },
