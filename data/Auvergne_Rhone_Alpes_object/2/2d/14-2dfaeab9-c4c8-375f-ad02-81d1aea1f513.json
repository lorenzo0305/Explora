  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98186bb1-9c78-3ce2-bf9e-8f1b8dd137e2",
      "dc:description": {
        "de": [
          "Ihre Bank ist Ihr täglicher Finanzpartner. Wir bieten Ihnen eine umfassende Palette an Dienstleistungen, die auf Ihre Bedürfnisse zugeschnitten sind: Kontoeröffnung, Verwaltung Ihres Geldes, Kredite zur Verwirklichung Ihrer Projekte, Anlageberatung"
        ],
        "en": [
          "Your bank is your day-to-day financial partner. We offer you a full range of services tailored to your needs: account opening, money management, project loans, investment advice, etc"
        ],
        "it": [
          "La vostra banca è il vostro partner finanziario quotidiano. Vi offriamo una gamma completa di servizi su misura per le vostre esigenze: apertura di conti, gestione del vostro denaro, prestiti per aiutarvi a realizzare i vostri progetti, consulenza sugli investimenti, ecc"
        ],
        "fr": [
          "Votre banque est votre partenaire financier au quotidien. Nous vous proposons une gamme complète de services adaptés à vos besoins : ouverture de comptes, gestion de votre argent, crédits pour réaliser vos projets, conseils en investissement"
        ],
        "es": [
          "Su banco es su socio financiero cotidiano. Le ofrecemos una gama completa de servicios adaptados a sus necesidades: apertura de cuentas, gestión de su dinero, préstamos para ayudarle a realizar sus proyectos, asesoramiento en inversiones, etc"
        ],
        "nl": [
          "Je bank is je dagelijkse financiële partner. We bieden je een volledig gamma diensten op maat van jouw behoeften: rekeningen openen, je geld beheren, leningen om je te helpen je projecten te realiseren, beleggingsadvies, enz"
        ]
      },
      "@type": [
        "Description"
      ],
