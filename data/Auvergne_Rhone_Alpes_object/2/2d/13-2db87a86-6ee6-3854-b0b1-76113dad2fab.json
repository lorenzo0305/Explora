  "rdfs:comment": {
    "de": [
      "Als richtige Lyoner Institution mit internationalem Bekanntheitsgrad, findet das Haus von Eugénie Brazier dank Mathieu Viannay seinen rechten Platz in der gastronomischen Ruhmeshalle wieder."
    ],
    "en": [
      "The Maison Eugénie Brazier, a genuine, internationally renowned institution of Lyon has regained its rightful place in the gastronomic hall of fame thanks to chef Mathieu Viannay."
    ],
    "it": [
      "Una vera e propria istituzione lionese con una fama internazionale, la Maison di Eugénie Brazier ha ritrovato il posto che le spetta nel piccolo mondo delle eccellenze gastronomiche grazie a Mathieu Viannay."
    ],
    "fr": [
      "Véritable institution lyonnaise à la notoriété internationale, la maison d’Eugénie Brazier retrouve grâce à Mathieu Viannay la place qu’elle mérite dans le landernau des références gastronomiques."
    ],
    "es": [
      "La maison de Eugénie Brazier, auténtica institución lionesa con prestigio internacional, ha vuelto a encontrar, gracias a Mathieu Viannay, el lugar que merece en la escena gastronómica."
    ],
    "nl": [
      "Het huis van Eugénie Brazier, een echt instituut in Lyon met een internationale reputatie, heeft dankzij Mathieu Viannay zijn rechtmatige plaats in het land van de gastronomische referenties heroverd."
    ]
  },
