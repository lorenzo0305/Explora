  "rdfs:comment": {
    "de": [
      "Archijeux ist ein assoziatives Spielcafé. Wir bieten über 800 Gesellschaftsspiele, einen Bereich für die Kleinsten sowie eine Bar mit selbstgemachten Fruchtsäften. Unsere Aktivitäten: Spieleverleih, Spielanimationen, Schulungen und neu ein Escape Game!"
    ],
    "en": [
      "Archijeux is a welcoming, community-run board game café offering over 800 board games. We offer game loans, game events, workshops, and more... plus a new game shop: L'Archi-boutique, where you can find advice and buy games! Come play solo or with friends!"
    ],
    "it": [
      "Archijeux è un'accogliente ludoteca che offre oltre 800 giochi da tavolo. Abbiamo anche un nuovo negozio di giochi: L'Archi-boutique, dove è possibile ricevere consigli e acquistare giochi! Venite a giocare con i vostri amici o la vostra famiglia!"
    ],
    "fr": [
      "Archijeux est un café jeux associatif accueillant qui propose plus de 800 jeux de société. Prêts de jeu, animations jeux, formations, ... et une nouvelle boutique de jeux : L'Archi-boutique, conseil et ventes de jeux ! Venez jouer en solo ou en tribu !"
    ],
    "nl": [
      "Archijeux is een gemeenschappelijk spellencafé. We bieden meer dan 800 bordspellen, een ruimte voor de kleintjes en een bar met zelfgemaakte vruchtensappen. Onze activiteiten: speluitleen, spelevenementen, cursussen en nu ook een Escape Game!"
    ],
    "es": [
      "Archijeux es un agradable café de juegos que ofrece más de 800 juegos de mesa. También tenemos una nueva tienda de juegos: L'Archi-boutique, ¡donde podrás asesorarte y comprar juegos! Ven a jugar con tus amigos o tu familia"
    ]
  },
