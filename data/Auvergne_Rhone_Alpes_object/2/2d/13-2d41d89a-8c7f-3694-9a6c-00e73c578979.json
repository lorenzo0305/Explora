  "rdfs:comment": {
    "de": [
      "Auf der Route Napoléon machen Sie in Brié et Angonnes Halt wie Napoléon, der am 7. März 1815 von der Insel Elba zurückkehrte..."
    ],
    "en": [
      "Place on the Route Napoléon, this restaurant suggests a traditional cooking and pizzas on the spot or to take-away."
    ],
    "it": [
      "Sulla Route Napoleon, fate tappa a Brié et Angonnes come Napoleone al ritorno dall'Elba il 7 marzo 1815..."
    ],
    "fr": [
      "Sur la Route Napoléon, faîtes une halte à Brié et Angonnes comme Napoléon de retour de l'Ile d'Elbe le 7 mars 1815..."
    ],
    "nl": [
      "Op de Napoleonroute, stop in Brié et Angonnes zoals Napoleon bij zijn terugkeer van Elba op 7 maart 1815..."
    ],
