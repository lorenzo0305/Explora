  "rdfs:comment": {
    "de": [
      "Das Schloss von Bésignan, genannt \"Colombières\", das heute eine Ruine ist, war während der Revolutionszeit wohlbekannt, da es den letzten Schlossherrn, den Marquis Pierre Charles Joseph Duclaux de Bésignan, beherbergte."
    ],
    "en": [
      "The Château de Bésignan, known as the \"Colombières\", now in ruins, is well known from the revolutionary period for having welcomed the last lord of the château, the Marquis Pierre Charles Joseph Duclaux de Bésignan."
    ],
    "it": [
      "Il castello di Bésignan, detto \"Colombières\", oggi in rovina, è noto durante il periodo rivoluzionario per aver accolto l'ultimo signore del castello, il marchese Pierre Charles Joseph Duclaux de Bésignan."
    ],
    "fr": [
      "Le château de Bésignan dit de la \"Colombières\", aujourd'hui en ruines, est bien connu à la période révolutionnaire pour avoir accueilli le dernier seigneur du château, le marquis Pierre Charles Joseph Duclaux de Bésignan."
    ],
    "nl": [
      "Het kasteel van Bésignan, bekend als de \"Colombières\", dat nu een ruïne is, is bekend uit de revolutionaire periode omdat het de thuisbasis was van de laatste kasteelheer, markies Pierre Charles Joseph Duclaux de Bésignan."
    ],
    "es": [
      "El castillo de Bésignan, conocido como \"Colombières\", actualmente en ruinas, es muy conocido durante el periodo revolucionario por haber acogido al último señor del castillo, el marqués Pierre Charles Joseph Duclaux de Bésignan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château de la Colombières"
    ]
  },
