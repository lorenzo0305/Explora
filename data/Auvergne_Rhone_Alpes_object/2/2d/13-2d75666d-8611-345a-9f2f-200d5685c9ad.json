  "rdfs:comment": {
    "de": [
      "Willkommen im Teich von Riotord- Flussangelkarte AAPPMA auf Gegenseitigkeit erforderlich. Eine Oase der Ruhe für passionierte Angler, unter Einhaltung der ausgehängten Regeln. Kommen Sie und necken Sie die Fische in einer außergewöhnlichen natürlichen Umgebung!"
    ],
    "en": [
      "Welcome to Riotord Pond - Reciprocal AAPPMA river fishing card required. A haven of peace for fishing enthusiasts, in compliance with the posted regulations. Come and tease the fish in an exceptional natural setting!"
    ],
    "it": [
      "Benvenuti al laghetto Riotord - È richiesta la licenza di pesca fluviale AAPPMA reciproca. Un'oasi di pace per gli appassionati di pesca, nel rispetto del regolamento affisso. Venite a stuzzicare i pesci in un ambiente naturale eccezionale!"
    ],
    "fr": [
      "Bienvenue à l'étang de Riotord- Carte de pêche rivière AAPPMA réciprocitaire requise. Un havre de paix pour les passionnés, dans le respect du règlement affiché. Venez taquiner le poisson dans un cadre naturel exceptionnel !."
    ],
    "nl": [
      "Welkom bij de Riotord vijver - Wederkerige AAPPMA riviervisvergunning verplicht. Een oase van rust voor visliefhebbers, in overeenstemming met het aangegeven reglement. Kom vissen in een uitzonderlijke natuurlijke omgeving!"
    ],
    "es": [
      "Bienvenido al estanque de Riotord - Se requiere licencia recíproca de pesca fluvial AAPPMA. Un remanso de paz para los aficionados a la pesca, respetando la reglamentación anunciada. Venga a molestar a los peces en un marco natural excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etang de pêche et parcours éducatif découverte"
    ]
  },
