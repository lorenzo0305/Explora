  "rdfs:comment": {
    "de": [
      "Schöne E-Mountainbike-Runde mit mittlerem Schwierigkeitsgrad, die es ermöglicht, das Tal von Chevenne vom Dorfzentrum aus zu entdecken, eine Passage über La Batelle und eine Rückkehr über La Côte und Le Rys."
    ],
    "en": [
      "A beautiful electric mountain bike loop of medium difficulty, allowing you to discover the Chevenne valley from the village center, passing through La Batelle and returning via La Côte and Le Rys."
    ],
    "it": [
      "Un bellissimo anello elettrico per mountain bike di difficoltà moderata, che attraversa la valle di Chevenne dal centro del paese, passando per La Batelle e ritornando attraverso La Côte e Le Rys."
    ],
    "fr": [
      "Belle boucle VTT électrique de difficulté moyenne permettant de découvrir le vallon de Chevenne au départ du centre du village, un passage par la Batelle et un retour par la Côte et le Rys."
    ],
    "es": [
      "Un hermoso bucle de bicicleta de montaña eléctrica de dificultad moderada, que recorre el valle de Chevenne desde el centro del pueblo, pasando por La Batelle y regresando por La Côte y Le Rys."
    ],
    "nl": [
      "Een prachtige elektrische mountainbikeroute van middelmatige moeilijkheidsgraad door de Chevennevallei vanuit het dorpscentrum, door La Batelle en terug via La Côte en Le Rys."
    ]
  },
  "rdfs:label": {
    "en": [
      "Electric mountain bike course 40 - La Chapelle d'Abondance"
    ],
    "fr": [
      "VTT électrique parcours 40 - La Chapelle d'Abondance"
    ],
    "nl": [
      "Elektrische mountainbikeparcours 40 - La Chapelle d'Abondance"
    ]
  },
