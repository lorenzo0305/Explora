  "rdfs:comment": {
    "de": [
      "Entdecken Sie die 34. Ausgabe des Internationalen Eisskulpturenwettbewerbs in Valloire! Bewundern Sie die 20 talentierten Künstler, die das Eis schnitzen.\r\nSie werden Ihnen ihre unveröffentlichten und märchenhaften künstlerischen Kreationen präsentieren."
    ],
    "en": [
      "Discover the 34th International Ice Sculpture Competition in Valloire! Come and admire the 20 talented ice sculptors.\r\nYou'll discover their unique and enchanting artistic creations."
    ],
    "it": [
      "Scoprite il 34° Concorso internazionale di sculture di ghiaccio a Valloire! Venite ad ammirare i 20 artisti di talento che scolpiscono il ghiaccio.\r\nMostreranno le loro creazioni artistiche uniche e incantevoli."
    ],
    "fr": [
      "Découvrez la 34e édition du Concours International de Sculptures sur Glace à Valloire ! Venez admirer les 20 artistes talentueux sculpter la glace.\r\nIls vous feront découvrir leurs créations artistiques inédites et féeriques."
    ],
    "nl": [
      "Ontdek de 34e Internationale IJssculptuurwedstrijd in Valloire! Kom en bewonder de 20 getalenteerde kunstenaars die het ijs beeldhouwen.\r\nZe laten je hun unieke en betoverende artistieke creaties zien."
    ],
    "es": [
      "Descubra el 34º Concurso Internacional de Escultura de Hielo de Valloire Venga a admirar a los 20 talentosos artistas que esculpen el hielo.\r\nLe mostrarán sus creaciones artísticas únicas y encantadoras."
    ]
  },
