  "rdfs:comment": {
    "de": [
      "Ruhiges Hotel mit Sommeraußenpool und großem schattigen Park. Sauna + Multijet-Dusche.\r\nAm Anfang der Wanderungen. Voll ausgestatteter Seminarraum, der vom Hotel unabhängig ist. Empfang von Gruppen, Seminaren und Einzelpersonen"
    ],
    "en": [
      "Quiet hotel with outdoor summer swimming pool and large shady park. Sauna and multi-jet shower. Departure points for hikes. Fully-equipped seminar room, separate from the hotel. Groups, seminars and individuals welcome."
    ],
    "it": [
      "Hotel tranquillo con piscina estiva all'aperto e ampio parco ombreggiato.\r\nAll'inizio delle escursioni. Sala seminari completamente attrezzata e indipendente dall'hotel. Accoglienza di gruppi, seminari, singoli."
    ],
    "fr": [
      "Hôtel calme avec piscine  d'été extérieur et grand parc ombragé.Sauna + Douche multijet.\r\nAu départ des randonnées. Salle de séminaire entièrement équipée et indépendante de l’hôtel. Accueil de groupes,séminaire, individuels."
    ],
    "nl": [
      "Rustig hotel met buitenzwembad in de zomer en groot schaduwrijk park.\r\nAan het begin van de wandelingen. Seminariezaal volledig uitgerust en onafhankelijk van het hotel. Groepen, seminars en individuen zijn welkom."
    ],
    "es": [
      "Hotel tranquilo con piscina de verano al aire libre y un gran parque sombreado.\r\nAl inicio de las caminatas. Sala de seminarios totalmente equipada e independiente del hotel. Recepción de grupos, seminarios, particulares."
    ]
  },
  "rdfs:label": {
