  "rdfs:comment": {
    "de": [
      "Bäckerei mit den \"Cottancinettes\" als Spezialität. Verwendung von biologischem Mehl, Natursauerteig, Handkneten, Backen mit Holz. Brote mit AB-Zertifikat.\r\nAb-Hof-Verkauf nach Vereinbarung, Bestellung am Vortag. Lieferung möglich."
    ],
    "en": [
      "Bakery specializing in \"Cottancinettes\" (small, flatbread-like loaves). Made with organic flours, natural sourdough starter, hand-kneaded dough, and wood-fired oven. Certified organic (AB label). On-site sales by appointment; orders must be placed the day before. Delivery available."
    ],
    "it": [
      "Panificio specializzato in \"Cottancinettes\". Utilizzo di farine biologiche, lievitazione naturale, impasto manuale, cottura a legna. Pane certificato AB.\r\nVendita in loco su appuntamento, ordine il giorno prima. Possibilità di consegna."
    ],
    "fr": [
      "Boulangerie avec pour spécialités les \"Cottancinettes\". Utilisation de farines biologiques, levain naturel, pétrissage manuel, cuisson au bois. Pains certifiés AB.\r\nVente à la propriété sur rendez-vous, commande la veille. Livraison possible."
    ],
    "es": [
      "Panadería especializada en \"Cottancinettes\". Utilización de harinas biológicas, levadura natural, amasado manual, cocción en horno de leña. Pan con certificado AB.\r\nVenta in situ con cita previa, pedido la víspera. Posibilidad de entrega a domicilio."
    ],
    "nl": [
      "Bakkerij gespecialiseerd in \"Cottancinettes\". Gebruik van biologisch meel, natuurlijke gisting, handmatig kneden, houtgestookt bakken. AB-gecertificeerd brood.\r\nVerkoop ter plaatse op afspraak, bestelling de dag ervoor. Levering mogelijk."
    ]
  },
