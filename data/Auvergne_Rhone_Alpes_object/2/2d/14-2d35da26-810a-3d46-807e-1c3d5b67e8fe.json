  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6364263a-259e-32ae-957c-cf0aceb07088",
      "dc:description": {
        "de": [
          "Brauerei - Bierbar\n\nZum Mitnehmen oder vor Ort - Terrasse. Brasserie und Laden von Montag bis Samstag geöffnet. Bar von Mittwoch bis Samstag geöffnet\nFührung durch die Brauerei und Verkostung jeden 1. Samstag im Monat um 11.00 Uhr"
        ],
        "en": [
          "Brewery - Beer bar\n\nTakeaway or on site - terrace. Brasserie and store open Monday to Saturday. Bar open Wednesday to Saturday\nGuided tour of the brewery and tasting every 1st Saturday of the month at 11:00 am"
        ],
        "it": [
          "Birreria - Bar della birra\n\nDa asporto o in loco - terrazza. Brasserie e negozio aperti dal lunedì al sabato. Bar aperto da mercoledì a sabato\nVisita guidata del birrificio e degustazione ogni 1° sabato del mese alle ore 11.00"
        ],
        "fr": [
          "Brasserie - Bar à bières\n\nA emporter ou sur place - terrasse. Brasserie et boutique ouvertes du lundi au samedi. Bar ouvert du mercredi au samedi     \nVisite guidée de la brasserie et dégustation chaque 1er samedi du mois à 11h00"
        ],
        "es": [
          "Cervecería - Bar de cerveza\n\nComida para llevar o in situ - terraza. Brasserie y tienda abiertas de lunes a sábado. Bar abierto de miércoles a sábado\nVisita guiada de la cervecería y degustación el primer sábado de cada mes a las 11.00 h"
        ],
        "nl": [
          "Brouwerij - Bierbar\n\nAfhaalmaaltijden of ter plaatse - terras. Brasserie en winkel open van maandag tot zaterdag. Bar open van woensdag tot zaterdag\nRondleiding door de brouwerij en proeverij elke 1e zaterdag van de maand om 11.00 uur"
        ]
      },
      "@type": [
        "Description"
      ],
