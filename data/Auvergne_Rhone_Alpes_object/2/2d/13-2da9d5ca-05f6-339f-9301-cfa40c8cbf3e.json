  "rdfs:comment": {
    "de": [
      "Traditionelle und savoyardische Küche - Außenterrasse - im Herzen des Ortes und der 3 Vallées gegenüber dem Mont Vallon, ideal gelegen am Fuße der Pisten. Alle Einkaufsmöglichkeiten in der Nähe"
    ],
    "en": [
      "Traditional and Savoyard restaurant - outdoor terrace - in the heart of the resort and the 3 Valleys facing Mont Vallon ideally located at the foot of the slopes. All shops nearby"
    ],
    "it": [
      "Ristorante tradizionale savoiardo - terrazza all'aperto - nel cuore della stazione e delle 3 Valli di fronte al Mont Vallon, in posizione ideale ai piedi delle piste. Tutti i negozi nelle vicinanze"
    ],
    "fr": [
      "Restauration traditionnelle et savoyarde - terrasse extérieur - au cœur de la station et des 3 Vallées face au Mont Vallon idéalement situé aux pieds des pistes. Tous commerces à proximité"
    ],
    "nl": [
      "Traditioneel Savoyaards restaurant - buitenterras - in het hart van het skioord en de 3 valleien tegenover de Mont Vallon, ideaal gelegen aan de voet van de pistes. Alle winkels in de buurt"
    ],
    "es": [
      "Restaurante tradicional saboyano - terraza exterior - en el corazón de la estación y de los 3 Valles frente al Mont Vallon, idealmente situado a pie de pistas. Todos los comercios cercanos"
    ]
  },
