  "rdfs:comment": {
    "de": [
      "Von den hiesigen Erzeugern inspirierte Küche, je nach Jahreszeit, frische Produkte, hausgemacht. Wein von Winzern... der Geschmack des Wesentlichen!"
    ],
    "en": [
      "Cuisine inspired by local producers, fresh produce, homemade. Winegrowers' wines... a taste for the essential!"
    ],
    "it": [
      "Cucina ispirata ai produttori locali, secondo le stagioni, prodotti freschi e fatti in casa. I vini dei viticoltori... il gusto dell'essenziale!"
    ],
    "fr": [
      "Cuisine inspirée par les producteurs d'ici, au fil des saisons, produits frais, fait maison. Vin de vignerons... le goût de l'essentiel !"
    ],
    "nl": [
      "Keuken geïnspireerd door lokale producenten, volgens de seizoenen, verse producten, huisgemaakt. Wijnbouwerswijnen... een smaak voor het essentiële!"
    ],
    "es": [
      "Cocina inspirada en los productores locales, según las estaciones, productos frescos y caseros. Vinos de viticultores... ¡un gusto por lo esencial!"
    ]
  },
