  "rdfs:comment": {
    "de": [
      "Marguerite ist der Wunsch, allen Menschen einen warmen, einfachen und untypischen Ort zu bieten, sei es für einen Kaffee oder einen Aperitif, ein Geschäfts- oder Familienessen oder besondere Anlässe."
    ],
    "en": [
      "Marguerite is the desire to offer a warm, simple and atypical place for everyone, whether for a coffee or an aperitif, a business or family lunch, or a special occasion."
    ],
    "it": [
      "Marguerite si propone di offrire un luogo caldo, semplice e insolito per tutti, sia per un caffè o un aperitivo, che per un pranzo di lavoro o di famiglia o per un'occasione speciale."
    ],
    "fr": [
      "Marguerite c’est l’envie de proposer, pour tous, un lieu chaleureux, simple et atypique que cela soit pour un café ou un apéro, un déjeuner professionnel ou familial, des occasions particulières."
    ],
    "es": [
      "En Marguerite se trata de ofrecer un lugar cálido, sencillo e insólito para todos, ya sea para tomar un café o un aperitivo, una comida de negocios o familiar o una ocasión especial."
    ],
    "nl": [
      "Bij Marguerite draait alles om het bieden van een warme, eenvoudige en ongewone plek voor iedereen, of het nu voor een kopje koffie of een aperitief is, een zaken- of familielunch of een speciale gelegenheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Marguerite"
    ]
  },
