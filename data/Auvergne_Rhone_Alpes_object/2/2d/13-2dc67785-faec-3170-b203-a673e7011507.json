  "rdfs:comment": {
    "de": [
      "Große Terrasse am Fuß der Skihänge des Dorfs und in der Nähe mehrerer Wanderwege.\r\nSpezialitäten aus Savoyen oder dem französischen Südwesten.\r\nMittags: Tagesgerichte und Tagesmenü, schnelle Küche von der Karte. Abends: savoyardische Spezialitäten, Menüs und à la carte (Fleisch, Fisch, Lachs und Gänseleber). \r\nBar."
    ],
    "en": [
      "Large terrace, at the bottom of the ski slopes or the hiking trails.\r\nSavoyard specialities and from the South West.\r\nLunchtime: daily specials, quick bites.\r\nEvening: Savoyard specialities, specials and à la carte menu (meat, fish, salmon and foie gras).\r\nBar."
    ],
    "it": [
      "Ampia terrazza ai piedi delle piste da sci o dei sentieri escursionistici. Pranzo: piatto e menu del giorno, menu veloce. Sera: Specialità savoiarde, menu e à la carte.\r\nEnoteca."
    ],
    "fr": [
      "Grande terrasse, au pied des pistes de ski ou des sentiers de randonnée. Midi : Plat et menu du jour, carte rapide. Soir : Spécialités savoyardes, menus et carte.\r\nBar à vin."
    ],
    "nl": [
      "Groot terras aan de voet van de skipistes of wandelpaden. Lunch: dagschotel en dagmenu, snelmenu. S Avonds: Savoyaardse specialiteiten, menu's en à la carte.\r\nWijnbar."
    ],
    "es": [
      "Amplia terraza al pie de las pistas de esquí o de las rutas de senderismo. Almuerzo: Plato y menú del día, menú rápido. Por la noche: Especialidades saboyanas, menús y a la carta.\r\nBar de vinos."
    ]
  },
