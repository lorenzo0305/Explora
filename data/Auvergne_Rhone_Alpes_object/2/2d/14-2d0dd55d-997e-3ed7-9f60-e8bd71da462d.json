  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48efc4e7-a22f-3ac4-b282-14b4074b2549",
      "dc:description": {
        "de": [
          "Fahrten mit dem Dreirad durch den Ort, die für Personen mit eingeschränkter Mobilität geeignet sind.\nWöchentlich von 9:00 bis 12:30 Uhr und von 13:30 bis 17:30 Uhr, nach Kostenvoranschlag!\nFür weitere Informationen, Kontakte und Leistungen; besuchen Sie https://www.alphatransports.fr/index.html"
        ],
        "en": [
          "Scooter rides around the resort adapted for people with reduced mobility.\nWeekdays from 9am to 12:30pm and from 1:30pm to 5:30pm, on request!\nFor more information, contacts and services, visit https://www.alphatransports.fr/index.html"
        ],
        "it": [
          "Gite in scooter per il resort adattate alle persone a mobilità ridotta.\nNei giorni feriali dalle 9.00 alle 12.30 e dalle 13.30 alle 17.30, su richiesta!\nPer maggiori informazioni, contatti e servizi, visitate il sito https://www.alphatransports.fr/index.html"
        ],
        "fr": [
          "Balades en triporteur sur la station adaptées aux Personnes à Mobilité Réduite.\nLa semaine de 9h à 12h30 et de 13h30 à 17h30, sur devis !\nPour plus d'informations, contacts et prestations ; rendez-vous sur https://www.alphatransports.fr/index.html"
        ],
        "es": [
          "Paseos en scooter por la estación adaptados para personas con movilidad reducida.\nEntre semana, de 9:00 a 12:30 y de 13:30 a 17:30, previa solicitud\nPara más información, contactos y servicios, visite https://www.alphatransports.fr/index.html"
        ],
        "nl": [
          "Aangepaste scootertochten door het resort voor mensen met beperkte mobiliteit.\nWeekdagen van 9.00 tot 12.30 uur en van 13.30 tot 17.30 uur, op aanvraag!\nGa voor meer informatie, contactpersonen en diensten naar https://www.alphatransports.fr/index.html"
        ]
      },
      "@type": [
        "Description"
