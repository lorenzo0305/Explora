  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von den Klängen auf eine einzigartige Tour durch Valencia führen: eine Geschichte der darstellenden Künste im Rhythmus der Stadt.\r\n\r\nIn Partnerschaft mit LADAPT Drôme Ardèche. Kostenlose Besichtigung ? zugänglich für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "Let the sounds guide you on a unique tour of Valence: a history of the performing arts to the rhythm of the city.\r\n\r\nIn partnership with LADAPT Drôme Ardèche. Free tour ? accessible for wheelchair users."
    ],
    "it": [
      "Lasciate che i suoni vi guidino in un tour unico di Valencia: una storia delle arti dello spettacolo al ritmo della città.\r\n\r\nIn collaborazione con LADAPT Drôme Ardèche. Visita gratuita, accessibile alle persone con mobilità ridotta."
    ],
    "fr": [
      "Laissez les sons vous guider pour une visite unique de Valence : une histoire des arts du spectacle au rythme de la ville.\r\n\r\nEn partenariat avec LADAPT Drôme Ardèche. Visite gratuite – accessible PMR."
    ],
    "nl": [
      "Laat de klanken je leiden op een unieke tour door Valencia: een geschiedenis van de podiumkunsten op het ritme van de stad.\r\n\r\nIn samenwerking met LADAPT Drôme Ardèche. Gratis bezoek ? toegankelijk voor PRM."
    ],
    "es": [
      "Déjese guiar por los sonidos en un recorrido único por Valencia: una historia de las artes escénicas al ritmo de la ciudad.\r\n\r\nEn colaboración con LADAPT Drôme Ardèche. Visita gratuita ? accesible para PMR."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Bruits de coulisses"
    ]
  },
