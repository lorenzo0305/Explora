  "rdfs:comment": {
    "de": [
      "Lara bietet Ihnen Yoga- und Pilateskurse im Herzen der Berge an, um Sanftheit, Vitalität und Freude zu kultivieren.  Ein Moment des Wohlbefindens und der guten Laune in einer wohlwollenden und erholsamen Atmosphäre."
    ],
    "en": [
      "Lara offers yoga and Pilates classes in the heart of the mountains, helping you cultivate gentleness, vitality and joy.  A moment of wellbeing and good humour, in a caring and rejuvenating atmosphere."
    ],
    "it": [
      "Lara propone corsi di yoga e pilates nel cuore delle montagne, per coltivare morbidezza, vitalità e gioia.  Un momento di benessere e di buon umore, in un'atmosfera attenta e rigenerante."
    ],
    "fr": [
      "Lara vous propose des cours de yoga et pilâtes, au cœur de la montagne, pour cultiver douceur, vitalité et joie.  Un moment de bien-être et de bonne humeur, dans une ambiance bienveillante et ressourçante."
    ],
    "es": [
      "Lara ofrece clases de yoga y pilates en plena montaña, para cultivar la suavidad, la vitalidad y la alegría.  Un momento de bienestar y buen humor, en un ambiente cuidado y rejuvenecedor."
    ],
    "nl": [
      "Lara biedt yoga- en pilateslessen in het hart van de bergen om zachtheid, vitaliteit en vreugde te cultiveren.  Een moment van welzijn en goed humeur, in een zorgzame en verjongende sfeer."
    ]
  },
  "rdfs:label": {
    "de": [
      "Yogalehrerin - Lara Parise"
    ],
    "en": [
      "Yoga Teacher - Lara Parise"
    ],
    "fr": [
      "Professeur de Yoga - Lara Parise"
    ]
  },
