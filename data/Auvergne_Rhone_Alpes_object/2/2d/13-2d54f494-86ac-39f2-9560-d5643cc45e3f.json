  "rdfs:comment": {
    "de": [
      "Dieser pyramidenförmige Wächter thront, gut individualisiert, über den Tälern von Lovenex und der Au de Tanay. Die Besteigung der Westwand ist entgegen allen Anscheins recht einfach und angenehm. Die Gegend ist wild und die Aussicht vom Gipfel herrlich."
    ],
    "en": [
      "This pyramid-shaped sentinel towers high above the Lovenex and Au de Tanay valleys. The climb up the west face is, to all appearances, quite easy and pleasant. The area is wild and the view from the summit magnificent."
    ],
    "it": [
      "Questa sentinella a forma di piramide sovrasta le valli di Lovenex e Au de Tanay. La salita sulla parete ovest è, a quanto pare, abbastanza facile e piacevole. La zona è selvaggia e la vista dalla cima è magnifica."
    ],
    "fr": [
      "Cette sentinelle pyramidale trône, bien individualisée, au-dessus des vallons de Lovenex et de l'Au de Tanay. L'escalade de la face ouest est contre toute apparence assez facile et agréable. La région est sauvage et la vue du sommet magnifique."
    ],
    "es": [
      "Este centinela piramidal se eleva por encima de los valles de Lovenex y Au de Tanay. La ascensión por la cara oeste es, en apariencia, fácil y agradable. La zona es salvaje y la vista desde la cumbre magnífica."
    ],
    "nl": [
      "Deze piramidevormige wacht torent hoog uit boven de valleien van Lovenex en Au de Tanay. De beklimming van de westwand is op het eerste gezicht vrij gemakkelijk en aangenaam. De omgeving is woest en het uitzicht vanaf de top magnifiek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing site - Mont Gardy from Novel"
    ],
    "fr": [
      "Site d'escalade - Mont Gardy depuis Novel"
    ],
    "nl": [
      "Klimlocatie - Mont Gardy van Novel"
    ]
  },
