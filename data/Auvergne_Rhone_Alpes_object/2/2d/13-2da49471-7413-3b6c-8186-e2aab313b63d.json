  "rdfs:comment": {
    "de": [
      "Der Festsaal oder Mehrzweckraum von Hauterive ist ein öffentlicher Ort, der Einwohnern und Nicht-Einwohnern zur Verfügung gestellt wird, um eine festliche Veranstaltung oder ein anderes Ereignis abzuhalten."
    ],
    "en": [
      "The village hall or multi-purpose hall of Hauterive is a public place that is available to residents and non-residents to hold a festive event or any other event."
    ],
    "it": [
      "La sala del villaggio o sala polivalente di Hauterive è un luogo pubblico a disposizione dei residenti e dei non residenti per organizzare una festa o qualsiasi altro evento."
    ],
    "fr": [
      "La salle des fêtes ou salle polyvalente de Hauterive est un lieu public qui est mis à la disposition des habitants et des non-résidents pour tenir un évènement festif ou tout autre événement."
    ],
    "es": [
      "La sala de fiestas o sala polivalente de Hauterive es un lugar público que está a disposición de los residentes y no residentes para celebrar un acto festivo o cualquier otro evento."
    ],
    "nl": [
      "Het dorpshuis of de polyvalente zaal van Hauterive is een openbare plaats die beschikbaar is voor inwoners en niet-inwoners om een feestelijke of andere gebeurtenis te houden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle des Fêtes"
    ]
  },
