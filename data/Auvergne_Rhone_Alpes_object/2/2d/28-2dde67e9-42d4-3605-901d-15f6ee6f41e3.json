      "dc:description": {
        "de": [
          "Restaurant-Metzgerei mit 1 Reifekeller.\nAußergewöhnliche Fleischrassen vor Ort/zum Mitnehmen.\n Verkauf zum Mitnehmen im Metzgereibereich während der Öffnungszeiten"
        ],
        "en": [
          "Restaurant-butchery with 1 maturing cellar.\nExceptional breeds of meat on the premises/takeaway.\n Takeaway sales in the butcher?s shop during opening hours"
        ],
        "it": [
          "Ristorante-macelleria con 1 cantina di stagionatura.\nRazze eccezionali di carne da consumare o da portare via.\n Vendita da asporto nella macelleria durante gli orari di apertura"
        ],
        "fr": [
          "Restaurant-Boucherie avec 1 cave de maturation.\nDes races à viandes d'exception sur place/à emporter.\n Vente à emporter dans l’espace boucherie pendant les horaires d’ouverture"
        ],
        "es": [
          "Restaurante-carnicería con 1 bodega de maduración.\nRazas excepcionales de carne para comer en el restaurante o para llevar.\n Venta para llevar en la carnicería en horario de apertura"
        ],
        "nl": [
          "Restaurant-slagerij met 1 rijpingskelder.\nUitzonderlijke vleesrassen om te eten of mee te nemen.\n Afhaalverkoop in de slagerij tijdens openingsuren"
        ]
      },
