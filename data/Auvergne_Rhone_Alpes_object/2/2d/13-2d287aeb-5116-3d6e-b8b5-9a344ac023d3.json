  "rdfs:comment": {
    "de": [
      "L.Beauté, girly und cocooning Institut in Hauterives, bietet Haarentfernung, Gesichts- und Körperpflege, Massagen, Head Spa und Lymphdrainage... Personalisierte Pflege mit biologischen und veganen Produkten."
    ],
    "en": [
      "L.Beauté, a girly, cocooning institute in Hauterives, offers waxing, face and body treatments, massages, head spa and lymphatic drainage... Personalized treatments with organic and vegan products."
    ],
    "it": [
      "L.Beauté, un salone di bellezza femminile e accogliente a Hauterives, offre cerette, trattamenti per il viso e per il corpo, massaggi, trattamenti per la testa e linfodrenaggio... Trattamenti personalizzati con prodotti biologici e vegani."
    ],
    "fr": [
      "L.Beauté, institut girly et cocooning à Hauterives, propose épilations, soins visage et corps, massages, head spa et drainage lymphatique... Soins personnalisés avec produits bio et vegan."
    ],
    "es": [
      "L.Beauté, un salón de belleza femenino y acogedor en Hauterives, ofrece depilación, tratamientos faciales y corporales, masajes, spas craneales y drenaje linfático... Tratamientos personalizados con productos ecológicos y veganos."
    ],
    "nl": [
      "L.Beauté, een meisjesachtig schoonheidssalon in Hauterives, biedt harsen, gezichts- en lichaamsbehandelingen, massages, hoofdspa's en lymfedrainage... Gepersonaliseerde behandelingen met biologische en veganistische producten."
    ]
  },
