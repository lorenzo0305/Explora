  "rdfs:comment": {
    "de": [
      "Ein etwa 2 Hektar großer Altarm des Allier, der in zwei Teile geteilt ist und mit dem Fluss in Verbindung steht.\r\nEr besteht aus hohen und tiefen Gewässern, in denen Zander, Karpfen, Rotaugen, aber auch Blackbass und Hechte leben."
    ],
    "en": [
      "Former branch of the Allier, approx. 2 hectares in size, split in two and communicating with the river.\r\nComposed of high and deep bottoms where pike-perch, carp, roach as well as black-bass and pike cohabit."
    ],
    "it": [
      "Ex ramo dell'Allier, di circa 2 ettari, diviso in due e comunicante con il fiume.\r\nÈ costituito da acque alte e profonde dove convivono luccioperca, carpa, lasca, black-bass e luccio."
    ],
    "fr": [
      "Ancien bras de l’Allier de 2 hectares environ scindé en deux, communicant avec la rivière.\r\nComposée de hauts et de profonds fonds où cohabitent sandres, carpes, gardons mais aussi black-bass et brochets."
    ],
    "nl": [
      "Een voormalige zijtak van de Allier, ongeveer 2 hectare groot, in tweeën gesplitst en in verbinding met de rivier.\r\nBestaat uit hoog en diep water waar snoekbaars, karper, voorn, black-bass en snoek naast elkaar leven."
    ],
    "es": [
      "Antiguo brazo del Allier, de unas 2 hectáreas, dividido en dos y comunicado con el río.\r\nFormado por aguas altas y profundas donde conviven luciopercas, carpas, cucarachas, black-bass y lucios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boire de Vermillère"
    ]
  },
