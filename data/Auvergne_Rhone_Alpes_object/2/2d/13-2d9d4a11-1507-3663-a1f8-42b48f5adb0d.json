  "rdfs:comment": {
    "de": [
      "Destillerie Louis Couderc - Handwerkliche Liquoristen aus dem Cantal seit 1908\r\n\r\nSeit über einem Jahrhundert bewahrt die Distillerie Louis Couderc ein einzigartiges Know-how: die Herstellung von Likören aus wilden Pflanzen aus dem Cantal."
    ],
    "en": [
      "Distillerie Louis Couderc - Artisan Liquoriste du Cantal since 1908\r\n\r\nFor over a century, Distillerie Louis Couderc has been perpetuating a unique savoir-faire: the production of liqueurs made from wild Cantal plants."
    ],
    "it": [
      "Distillerie Louis Couderc - Produttore artigianale di liquori nel Cantal dal 1908\r\n\r\nDa oltre un secolo, la Distillerie Louis Couderc perpetua un know-how unico: la produzione di liquori a base di piante selvatiche del Cantal."
    ],
    "fr": [
      "Distillerie Louis Couderc - Artisan Liquoriste du Cantal depuis 1908 \r\n\r\nDepuis plus d’un siècle, la Distillerie Louis Couderc perpétue un savoir-faire unique : la fabrication de liqueurs à base de plantes sauvages du Cantal."
    ],
    "es": [
      "Distillerie Louis Couderc - Fabricante artesanal de licores del Cantal desde 1908\r\n\r\nDesde hace más de un siglo, la Destilería Louis Couderc perpetúa un saber hacer único: la elaboración de licores a partir de plantas silvestres del Cantal."
    ],
    "nl": [
      "Distilleerderij Louis Couderc - Ambachtelijke likeurproducent in de Cantal sinds 1908\r\n\r\nAl meer dan een eeuw houdt de Distillerie Louis Couderc een unieke knowhow in stand: de productie van likeuren op basis van wilde planten uit de Cantal."
    ]
  },
