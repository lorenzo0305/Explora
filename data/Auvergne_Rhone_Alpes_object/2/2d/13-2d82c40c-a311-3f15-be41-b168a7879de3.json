  "rdfs:comment": {
    "de": [
      "Ihr Escape Game in Ruoms lässt Sie in zwei verschiedene Spielräume eintauchen. Ob mit der Familie oder mit Freunden, das Escape Game ist für alle Altersgruppen geöffnet und ist auch ein Snack/Spielbar. Ein Veranstalter von Shows, Teambuilding und animierten Abenden (Ardeche-games.fr)."
    ],
    "en": [
      "Your Escape Game in Ruoms immerses you in 2 different game rooms. Open to families and friends of all ages, the Escape Game is also a Snack/Game Bar. An organizer of shows, teambuilding and evening events (Ardeche-games.fr)."
    ],
    "it": [
      "Il vostro Escape Game a Ruoms vi immerge in 2 diverse sale da gioco. In famiglia o con gli amici, aperto a tutte le età, l'Escape Game è anche uno Snack/Games Bar. Un organizzatore di spettacoli, teambuilding e intrattenimento serale (Ardeche-games.fr)."
    ],
    "fr": [
      "Votre Escape game à Ruoms vous immerge dans 2 salles de jeux différentes. En famille ou entre amis ouvert pour tous les âges, l’Escape Game est aussi un Snack/Bar à jeux. Un organisateur de spectacles, teambuilding et soirées animées (Ardeche-games.fr)."
    ],
    "es": [
      "Tu Escape Game en Ruoms te sumerge en 2 salas de juego diferentes. En familia o con amigos, abierto a todas las edades, el Escape Game es también un Snack/Bar de juegos. Organizador de espectáculos, teambuilding y animaciones nocturnas (Ardeche-games.fr)."
    ],
    "nl": [
      "Je Escape Game in Ruoms dompelt je onder in 2 verschillende spelkamers. Met familie of vrienden, open voor alle leeftijden, de Escape Game is ook een Snack/Games Bar. Organisator van shows, teambuilding en avondentertainment (Ardeche-games.fr)."
    ]
  },
