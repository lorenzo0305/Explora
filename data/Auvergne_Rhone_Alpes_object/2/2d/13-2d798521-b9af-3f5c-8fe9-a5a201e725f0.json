  "rdfs:comment": {
    "de": [
      "Hervé ist seit 1987 auf dem Familienbauernhof ansässig und freut sich, Sie begrüßen zu dürfen, um seine Leidenschaft mit Ihnen zu teilen. Der landwirtschaftliche Betrieb produziert Mandeln.\r\nWährend des Besuchs werden Ihnen einige Texte vorgelesen."
    ],
    "en": [
      "Hervé has been running the family farm since 1987 and is delighted to welcome you to share his passion. The farm produces almonds.\r\nA poet in his own right, you'll be invited to read some of his poems during your visit."
    ],
    "it": [
      "Hervé gestisce l'azienda agricola di famiglia dal 1987 ed è lieto di accogliervi per condividere la sua passione. L'azienda produce mandorle.\r\nPoeta a pieno titolo, durante la visita sarete invitati a leggere alcune delle sue poesie."
    ],
    "fr": [
      "Installé depuis 1987 sur la ferme familiale, Hervé est ravi de vous accueillir pour partager sa passion. Exploitation agricole produisant des amandes.\r\nPoète à ses heures, au cours la visite, il vous sera proposé quelques lectures de textes."
    ],
    "nl": [
      "Hervé runt de familieboerderij sinds 1987 en verwelkomt je graag om zijn passie te delen. De boerderij produceert amandelen.\r\nHij is dichter in hart en nieren en tijdens je bezoek word je uitgenodigd om enkele van zijn gedichten voor te lezen."
    ],
    "es": [
      "Hervé dirige la explotación familiar desde 1987 y está encantado de recibirle para compartir su pasión. La explotación produce almendras.\r\nPoeta por derecho propio, le invitarán a leer algunos de sus poemas durante su visita."
    ]
  },
