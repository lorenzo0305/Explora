  "rdfs:comment": {
    "de": [
      "Originelles Konzept, Outdoor-Whirlpool inmitten der Natur, aus Holz gebaut und mit einem Holzofen beheizt: russische Banja, nordisches Bad, Kaltwasserbrunnen, Entspannungsbereich unter einer echten mongolischen Jurte. Auch kalifornische Massagen.\r\nDenken Sie an eine Reservierung."
    ],
    "en": [
      "Original concept, outdoor balneo, in the middle of nature, made of wood and heated with a wood stove: Russian banya, Nordic bath, cold water fountain, relaxation area under a real Mongolian yurt. Also Californian massages.\r\nRemember to make a reservation."
    ],
    "it": [
      "Concetto originale, balneo all'aperto, in mezzo alla natura, realizzato in legno e riscaldato con una stufa a legna: banya russa, bagno nordico, fontana di acqua fredda, zona relax sotto una vera yurta mongola. Anche massaggi californiani.\r\nSi prega di prenotare."
    ],
    "fr": [
      "Concept original, balnéo d’extérieur, en pleine nature, conçue en bois et chauffée au poêle à bois: banya russe, bain nordique, fontaine d’eau froide, espace de détente sous une véritable yourte mongole. Également massages californiens.\r\nPensez à réserver."
    ],
    "nl": [
      "Origineel concept, outdoor balneo, midden in de natuur, gemaakt van hout en verwarmd met een houtkachel: Russische banya, Scandinavisch bad, koudwaterfontein, ontspanningsruimte onder een echte Mongoolse yurt. Ook Californische massages.\r\nGelieve te reserveren."
    ],
    "es": [
      "Concepto original, balneo al aire libre, en plena naturaleza, de madera y calentado con estufa de leña: banya rusa, baño nórdico, fuente de agua fría, zona de relajación bajo una auténtica yurta mongola. También masajes californianos.\r\nSe ruega reservar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balnéo'bois"
    ]
  },
