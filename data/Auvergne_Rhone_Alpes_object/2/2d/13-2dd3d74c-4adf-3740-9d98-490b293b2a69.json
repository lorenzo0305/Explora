  "rdfs:comment": {
    "de": [
      "Erleben Sie eine erstaunliche Erfahrung! Entdecken Sie den Besichtigungsparcours der Abtei La Chaise-Dieu und tauchen Sie dank einer immersiven Szenografie mit Ihrem Audioguide oder in Begleitung eines Fremdenführers in 1000 Jahre Geschichte ein"
    ],
    "en": [
      "Come and enjoy an astonishing experience! Discover La Chaise-Dieu Abbey and immerse yourself in 1,000 years of history thanks to an immersive scenography, with your audio-guide or accompanied by a guide"
    ],
    "it": [
      "Venite a vivere un'esperienza straordinaria! Scoprite la visita dell'Abbazia di La Chaise-Dieu e immergetevi in 1000 anni di storia grazie a una scenografia coinvolgente con la vostra audioguida o accompagnati da una guida"
    ],
    "fr": [
      "Venez vivre une expérience étonnante ! Découvrez le parcours de visite de l'Abbaye de La Chaise-Dieu et plongez dans 1000 ans d'histoire grâce à une scénographie immersive avec votre audio-guide ou accompagné d'un guide"
    ],
    "es": [
      "¡Venga y disfrute de una experiencia increíble! Descubra la visita de la Abadía de La Chaise-Dieu y sumérjase en 1000 años de historia gracias a una escenografía inmersiva con su audioguía o acompañado por un guía"
    ],
    "nl": [
      "Kom en geniet van een verbazingwekkende ervaring! Ontdek het bezoek aan de abdij van La Chaise-Dieu en dompel je onder in 1000 jaar geschiedenis dankzij een meeslepende scenografie met je audiogids of onder begeleiding van een gids"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours muséographique de l'Abbaye de La Chaise-Dieu"
    ]
  },
