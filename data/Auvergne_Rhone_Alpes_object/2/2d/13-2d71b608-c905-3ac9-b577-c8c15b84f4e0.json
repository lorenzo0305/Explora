  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie im Land der Pierres Dorées, um unsere Leidenschaft für Wein mit Ihnen zu teilen. Familienbetrieb in BIO-Qualität.\r\nBoutique, Direktverkauf auf dem Weingut von Beaujolais, Coteaux Bourguignons, Crémant de Bourgogne. Besichtigungen und Verkostungen..."
    ],
    "en": [
      "We welcome you to the land of Pierres Dorées (Golden Stones), to share our passion for wine with you. Organic family-run estate. \r\nDirect sale of Beaujolais, Coteaux Bourguignons, Crémant de Bourgogne, and also sparkling rosé. Tours and tastings available."
    ],
    "it": [
      "Vi diamo il benvenuto nella regione di Pierres Dorées per condividere la nostra passione per il vino. Azienda biologica a conduzione familiare.\r\nNegozio, vendita diretta di vini Beaujolais, Coteaux Bourguignons e Crémant de Bourgogne. Visite e degustazioni..."
    ],
    "fr": [
      "Nous vous accueillons au pays des Pierres Dorées, afin de vous faire partager notre passion du vin. Domaine familial BIO.\r\nBoutique, Vente directe au Domaine de Beaujolais, Coteaux Bourguignons, Crémant de Bourgogne. Visites et dégustations..."
    ],
    "nl": [
      "Wij heten u welkom in de regio Pierres Dorées om onze passie voor wijn te delen. Biologisch familiedomein.\r\nWinkel, rechtstreekse verkoop van Beaujolais, Coteaux Bourguignons en Crémant de Bourgogne wijnen. Bezoeken en proeverijen..."
    ],
    "es": [
      "Le damos la bienvenida a la región de Pierres Dorées para compartir nuestra pasión por el vino. Finca familiar ecológica.\r\nTienda, venta directa de vinos Beaujolais, Coteaux Bourguignons y Crémant de Bourgogne. Visitas y degustaciones..."
    ]
  },
