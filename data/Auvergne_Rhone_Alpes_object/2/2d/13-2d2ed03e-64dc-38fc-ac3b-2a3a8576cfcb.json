  "rdfs:comment": {
    "de": [
      "Der brandneue Bike Park in Saint-Just-Malmont ist für alle offen, ein Spot aus 100 % Natur, der für Mountainbike-Fans gedacht ist, die Nervenkitzel und gute Laune suchen.\r\nMit Pisten für Anfänger, technischen Modulen, Steilkurven und Fun-Abfahrten."
    ],
    "en": [
      "The brand-new Saint-Just-Malmont Bike Park is open to all, a 100% natural spot designed for mountain bikers, thrill-seekers and fun-lovers.\r\nWith trails for beginners, technical modules, steep bends and fun descents."
    ],
    "it": [
      "Il nuovissimo Saint-Just-Malmont Bike Park è aperto a tutti, un luogo naturale al 100% pensato per gli amanti della mountain bike, del brivido e del divertimento.\r\nCon percorsi per principianti, moduli tecnici, curve ripide e discese divertenti."
    ],
    "fr": [
      "Le tout nouveau Bike Park du Saint-Just-Malmont est ouvert à tous, un spot 100 % nature pensé pour les amateurs de VTT, de sensations et de bonne humeur.\r\nAvec pistes pour débutants, modules techniques, virages relevés et descentes fun."
    ],
    "nl": [
      "Het gloednieuwe Saint-Just-Malmont Bike Park is open voor iedereen, een 100% natuurlijke plek ontworpen voor mountainbikers, sensatiezoekers en fun-lovers.\r\nMet paden voor beginners, technische modules, steile bochten en leuke afdalingen."
    ],
    "es": [
      "El flamante Bike Park de Saint-Just-Malmont está abierto a todos, un paraje 100% natural diseñado para ciclistas de montaña, buscadores de emociones fuertes y amantes de la diversión.\r\nCon senderos para principiantes, módulos técnicos, curvas pronunciadas y descensos divertidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bike park  du Sambalou"
    ]
  },
