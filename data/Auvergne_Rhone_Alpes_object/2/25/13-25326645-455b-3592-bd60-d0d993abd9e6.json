  "rdfs:comment": {
    "de": [
      "Vor den Toren von Chamonix empfängt Sie das Hôtel Saint Antoine in einer Cocooning-Atmosphäre, die wir uns als familiär, einfach und effizient gewünscht haben."
    ],
    "en": [
      "At the gates of Chamonix, the Hotel Saint Antoine welcomes you in a cocooning atmosphere that we wanted to be family oriented, simple and efficient."
    ],
    "it": [
      "Alle porte di Chamonix, l'Hotel Saint Antoine vi accoglie in un'atmosfera accogliente che abbiamo voluto familiare, semplice ed efficiente."
    ],
    "fr": [
      "Aux portes de Chamonix  l’Hôtel Saint Antoine vous accueille dans une ambiance cocooning que nous avons souhaitée familiale, simple et efficace."
    ],
    "nl": [
      "Aan de poorten van Chamonix verwelkomt Hotel Saint Antoine u in een cocooning sfeer die we gezinsvriendelijk, eenvoudig en efficiënt wilden houden."
    ],
    "es": [
      "A las puertas de Chamonix, el Hotel Saint Antoine le acoge en un ambiente acogedor que hemos querido que sea familiar, sencillo y eficaz."
    ]
  },
