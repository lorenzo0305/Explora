  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek von Chirols ist in den Pausenhof der alten Schule gezogen. Dort finden Sie Romane, Comics, Dokumentarfilme für Erwachsene und Kinder sowie einige Hörbücher. Dieser Service ist kostenlos."
    ],
    "en": [
      "Public library."
    ],
    "it": [
      "La biblioteca comunale di Chirols si è trasferita nel cortile della vecchia scuola. Vi si trovano romanzi, fumetti, documentari per adulti e bambini, oltre ad alcuni audiolibri. Il servizio è gratuito."
    ],
    "fr": [
      "La bibliothèque municipale de Chirols a emménagé dans le préau de l'ancienne école. Vous pourrez y trouver des romans, des BD, des documentaires pour adultes et enfants ainsi que quelques livres audio. Ce service est gratuit."
    ],
    "es": [
      "La biblioteca municipal de Chirols se ha trasladado al patio de la antigua escuela. Encontrará novelas, cómics, documentales para adultos y niños, así como algunos audiolibros. Este servicio es gratuito."
    ],
    "nl": [
      "De gemeentelijke bibliotheek van Chirols is verhuisd naar de binnenplaats van de oude school. Je vindt er romans, stripboeken, documentaires voor volwassenen en kinderen, en ook een paar luisterboeken. Deze service is gratis."
    ]
  },
