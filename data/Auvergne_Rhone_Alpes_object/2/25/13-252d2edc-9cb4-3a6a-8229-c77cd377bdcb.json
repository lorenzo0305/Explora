  "rdfs:comment": {
    "de": [
      "Fertiggerichte, Salate, Sandwiches, Schnellimbiss-Service den ganzen Tag über. Au Chardon Bleu Espace Gourmet ist auch ein Teesalon, eine Konditorei, eine Bäckerei und eine Chocolaterie."
    ],
    "en": [
      "Ready meals, salads, sandwiches, fast food service all day. At Chardon Bleu Espace Gourmet it is also a tea room, pastry shop, bakery and chocolate shop."
    ],
    "it": [
      "Piatti cucinati, insalate, panini, servizio di fast food tutto il giorno. Au Chardon Bleu Espace Gourmet è anche sala da tè, pasticceria, panetteria e cioccolateria."
    ],
    "fr": [
      "Plats cuisinés, salades, sandwichs, service de restauration rapide toute la journée. Au Chardon Bleu Espace Gourmet c’est aussi un salon de thé, pâtisserie, boulangerie et chocolaterie."
    ],
    "es": [
      "Platos preparados, ensaladas, bocadillos, servicio de comida rápida durante todo el día. Au Chardon Bleu Espace Gourmet es también salón de té, pastelería, panadería y chocolatería."
    ],
    "nl": [
      "Gekookte gerechten, salades, sandwiches, fast food service de hele dag door. Au Chardon Bleu Espace Gourmet is ook een theesalon, patisserie, bakkerij en chocoladewinkel."
    ]
  },
