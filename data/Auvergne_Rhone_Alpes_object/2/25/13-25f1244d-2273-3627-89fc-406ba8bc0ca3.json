  "rdfs:comment": {
    "de": [
      "Werkzeuge, Späne und die Magie des Duftes sind bei dem besten Arbeiter Frankreichs für Holzschnitzerei zu entdecken... Besuche des Ateliers und seiner Ausstellung + Vorführung (Gruppen und Einzelpersonen). Praktika und \"Abendkurse\"."
    ],
    "en": [
      "Tools, shavings and the magic of smell are to be discovered at the best woodcarving worker in France... Visit of the workshop and its exhibition + demonstration. Internships offered throughout the year as well as \"evening classes\"."
    ],
    "it": [
      "Attrezzi, trucioli e la magia dell'olfatto sono da scoprire nella casa del miglior intagliatore di Francia... Visite al laboratorio e alla sua esposizione + dimostrazione (gruppi e singoli). Corsi di formazione e corsi serali."
    ],
    "fr": [
      "Outils, copeaux et magie de l'odeur sont à découvrir chez le meilleur ouvrier de France de sculpture sur bois... Visites de l'atelier et de son exposition + démonstration  (groupes et individuels). Stages et \"cours du soir\"."
    ],
    "nl": [
      "houtsculptuuratelier."
    ],
    "es": [
      "Herramientas, virutas y la magia del olfato se descubren en casa del mejor escultor de madera de Francia... Visitas al taller y a su exposición + demostración (grupos e individuales). Cursos de formación y clases nocturnas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Art on Wood"
    ],
    "fr": [
      "Art sur Bois"
    ],
    "nl": [
      "Art on Wood"
    ]
  },
