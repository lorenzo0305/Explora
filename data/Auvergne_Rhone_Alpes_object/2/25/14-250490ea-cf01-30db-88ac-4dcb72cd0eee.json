      "dc:description": {
        "de": [
          "Anlässlich des chinesischen Neujahrsfests bietet die Mediathek in Noyelles-sous-Lens einen Workshop zur Herstellung einer chinesischen Laterne an."
        ],
        "en": [
          "To mark Chinese New Year, the Noyelles-sous-Lens media library is offering a Chinese lantern workshop."
        ],
        "it": [
          "In occasione del Capodanno cinese, la biblioteca multimediale di Noyelles-sous-Lens propone un laboratorio di creazione di lanterne cinesi."
        ],
        "fr": [
          "A l'occasion du nouvel an chinois, la médiathèque de Noyelles-sous-Lens propose un atelier de création de lanterne chinoise."
        ],
        "nl": [
          "Ter gelegenheid van het Chinese Nieuwjaar biedt de mediatheek van Noyelles-sous-Lens een workshop Chinese lantaarns maken aan."
        ],
        "es": [
          "Con motivo del Año Nuevo chino, la biblioteca multimedia de Noyelles-sous-Lens propone un taller de fabricación de linternas chinas."
        ]
