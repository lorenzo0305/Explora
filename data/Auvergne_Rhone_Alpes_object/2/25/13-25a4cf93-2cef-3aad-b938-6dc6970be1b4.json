  "rdfs:comment": {
    "de": [
      "Die Baludik-Rundgänge ermöglichen es dem Familienpublikum, das bauliche Erbe der Stadt Gannat durch thematische, inszenierte, interaktive und spielerische Führungen zu entdecken, die kostenlos per Handy-App verfügbar sind."
    ],
    "en": [
      "The Baludik itineraries enable families to discover the built heritage of Gannat, through themed, interactive and fun tours, available free of charge on a mobile application."
    ],
    "it": [
      "I tour Baludik permettono alle famiglie di scoprire il patrimonio edilizio della città di Gannat attraverso tour tematici, interattivi e divertenti, disponibili gratuitamente su un'applicazione mobile."
    ],
    "fr": [
      "Les parcours Baludik permettent au public familial de découvrir le patrimoine bâti de la ville de Gannat, à travers des visites thématiques, scénarisées, interactives et ludiques, disponibles gratuitement sur application mobile."
    ],
    "nl": [
      "Met de Baludik-rondleidingen kunnen gezinnen het gebouwde erfgoed van de stad Gannat ontdekken via thematische, interactieve en ludieke rondleidingen, die gratis beschikbaar zijn via een mobiele applicatie."
    ],
    "es": [
      "Las visitas Baludik permiten a las familias descubrir el patrimonio construido de la ciudad de Gannat a través de recorridos temáticos, interactivos y divertidos, disponibles gratuitamente en una aplicación móvil."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours découverte Baludik"
    ]
  },
