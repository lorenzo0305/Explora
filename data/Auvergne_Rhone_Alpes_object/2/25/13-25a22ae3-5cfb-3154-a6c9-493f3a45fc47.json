  "rdfs:comment": {
    "de": [
      "Sylvie Alline, Öko-Dolmetscherin, bietet zahlreiche Naturausflüge an, die es in ganz West-Lyon zu entdecken gilt. Alle diese Aktivitäten können angepasst und Einzelpersonen, Schulklassen oder anderen Gruppen angeboten werden."
    ],
    "en": [
      "Sylvie Alline, eco-interpreter, offers a wide range of nature outings in the west of Lyon. All these activities can be adapted and offered to individuals, schools or other groups."
    ],
    "it": [
      "Sylvie Alline, eco-interprete, propone un'ampia gamma di escursioni naturalistiche in tutta la zona ovest di Lione. Tutte queste attività possono essere adattate e proposte a singoli, scuole o altri gruppi."
    ],
    "fr": [
      "Sylvie Alline, éco interprète, propose de nombreuses sorties nature à découvrir dans tout l'ouest lyonnais. Toutes ces activités peuvent être adaptées et proposées à des individuels, des scolaires ou d'autres groupes."
    ],
    "nl": [
      "Sylvie Alline, eco-interpreter, biedt een breed scala aan natuurexcursies in het westen van Lyon. Al deze activiteiten kunnen worden aangepast en aangeboden aan individuen, scholen of andere groepen."
    ],
    "es": [
      "Sylvie Alline, eco-intérprete, propone un amplio abanico de salidas a la naturaleza por todo el oeste de Lyon. Todas estas actividades pueden adaptarse y ofrecerse a particulares, escuelas u otros grupos."
    ]
  },
