  "rdfs:comment": {
    "de": [
      "Der Hof liegt am Fuße des Mont Aiguille, ganz in der Nähe der südlichen Hochebenen des Vercors. Unsere Pferde leben das ganze Jahr über friedlich im Park."
    ],
    "en": [
      "The farm is located at the foot of Mont Aiguille, close to the southern highlands of the Vercors. Here you'll find natural horsemanship: no stalls, our horses live a peaceful life in the park all year round."
    ],
    "it": [
      "La fattoria si trova ai piedi del Mont Aiguille, vicino agli altipiani meridionali del Vercors. Qui troverete l'equitazione naturale: senza box, i nostri cavalli vivono una vita tranquilla nel parco tutto l'anno."
    ],
    "fr": [
      "La ferme est située au pied du Mont Aiguille tout près des hauts plateaux sud du Vercors. Vous trouverez ici l’enseignement d’une équitation naturelle:  pas de box, nos chevaux mènent une vie paisible au parc toute l’année."
    ],
    "es": [
      "La granja está situada al pie del Monte Aiguille, cerca de las tierras altas del sur del Vercors. Aquí encontrará una equitación natural: sin boxes, nuestros caballos viven una vida tranquila en el parque durante todo el año."
    ],
    "nl": [
      "De boerderij ligt aan de voet van de Mont Aiguille bij de zuidelijke hooglanden van de Vercors. Hier vindt u de leer van de natuurlijke rijkunst: geen boxen, onze paarden leven het hele jaar door een rustig leven in het park."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ferme équestre des 4 chemins"
    ],
    "fr": [
      "La Ferme équestre des 4 chemins"
    ]
  },
