  "rdfs:comment": {
    "de": [
      "\"Überschaubarer Getreidebetrieb mit 58 Hektar, der sich seit 1999 dem ökologischen Landbau verschrieben hat. Wir bauen hauptsächlich Weizen, Roggen, Sonnenblumen und Soja an."
    ],
    "en": [
      "\"A 58-hectare cereal farm on a human scale, committed to organic farming since 1999. We grow mainly wheat, rye, sunflower and soya."
    ],
    "it": [
      "\"Un'azienda cerealicola di 58 ettari a misura d'uomo, impegnata nell'agricoltura biologica dal 1999. Coltiviamo principalmente grano, segale, girasole e soia."
    ],
    "fr": [
      "\"Exploitation céréalière à taille humaine de 58 hectares engagée en agriculture biologique depuis 1999. Nous cultivons principalement du blé, seigle, tournesol et soja."
    ],
    "es": [
      "\"Una explotación cerealista de 58 hectáreas a escala humana, comprometida con la agricultura ecológica desde 1999. Cultivamos principalmente trigo, centeno, girasol y soja."
    ],
    "nl": [
      "\"Een graanboerderij van 58 hectare op menselijke schaal, toegewijd aan biologische landbouw sinds 1999. We telen voornamelijk tarwe, rogge, zonnebloem en soja."
    ]
  },
  "rdfs:label": {
