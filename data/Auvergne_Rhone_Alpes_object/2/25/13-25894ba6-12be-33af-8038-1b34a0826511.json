  "rdfs:comment": {
    "de": [
      "Séverine und ihr Chefkoch heißen Sie im Lie Vain Lou willkommen, einem Restaurant mit einem erstaunlichen Namen, der auf Vornamen von Kindern basiert. Hier genießen Sie frische, vor Ort zubereitete Produkte und eine große Auswahl an Weinen in einer modernen und gemütlichen Einrichtung."
    ],
    "en": [
      "Séverine and her chef welcome you to the Lie Vain Lou, a restaurant with a surprising name based on children names. You can taste fresh products cooked on site, with a wide selection of wines. And all this in a warm and modern decor."
    ],
    "it": [
      "Séverine e il suo chef vi danno il benvenuto al Lie Vain Lou, un ristorante dal nome sorprendente basato sui nomi dei bambini. Qui potrete gustare prodotti freschi cucinati in loco, con un'ampia selezione di vini, in un ambiente caldo e moderno."
    ],
    "fr": [
      "Séverine et son chef vous accueillent au Lie Vain Lou, restaurant au nom étonnant basé sur des prénoms d'enfants. Vous y dégustez des produits frais cuisinés sur place, avec une large sélection de vins dans un décor moderne et chaleureux."
    ],
    "es": [
      "Séverine y su chef le dan la bienvenida a Lie Vain Lou, un restaurante con un nombre sorprendente basado en los nombres de pila de los niños. Aquí podrá degustar productos frescos cocinados en el propio local, con una amplia selección de vinos, en un ambiente cálido y moderno."
    ],
    "nl": [
      "Séverine en haar chef heten u welkom in Lie Vain Lou, een restaurant met een verrassende naam gebaseerd op de voornamen van kinderen. Hier kun je genieten van verse producten die ter plekke worden bereid, met een ruime keuze aan wijnen, in een warm, modern kader."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Lie Vain Lou Restaurant"
    ],
    "fr": [
      "Restaurant Le Lie Vain Lou"
    ]
  },
