  "rdfs:comment": {
    "de": [
      "Schmackhafte und gepflegte Saisonküche aus lokalen Produkten. Entdecken Sie das Vergnügen, die emblematischen Spezialitäten der Auvergne zu probieren!"
    ],
    "en": [
      "Tasty, carefully prepared seasonal cuisine based on local produce. Come and discover the pleasure of tasting the emblematic Auvergne specialities!"
    ],
    "it": [
      "Una cucina stagionale gustosa e curata, basata sui prodotti locali. Venite a scoprire il piacere di gustare le emblematiche specialità dell'Alvernia!"
    ],
    "fr": [
      "Cuisine de saison savoureuse et soignée à base de produits locaux. Venez découvrir le plaisir de déguster les spécialités auvergnates emblématiques !"
    ],
    "nl": [
      "Smakelijke, zorgvuldig bereide seizoensgebonden gerechten op basis van lokale producten. Kom en ontdek het plezier van het proeven van de emblematische specialiteiten uit de Auvergne!"
    ],
    "es": [
      "Sabrosa cocina de temporada elaborada con esmero a base de productos locales. Venga y descubra el placer de degustar las emblemáticas especialidades de Auvernia"
    ]
  },
