  "rdfs:comment": {
    "de": [
      "Treffen Sie sich zu einem schönen Wandertag durch unsere herrlichen Landschaften! Es erwarten Sie Strecken für alle, leckere Verpflegungsstationen und eine gesellige Atmosphäre. Unveröffentlicht: Wanderung Trail Off."
    ],
    "en": [
      "Join us for a great day's walking through our beautiful countryside! There's something for everyone, with gourmet refreshments and a friendly atmosphere. New: Trail Off walk."
    ],
    "it": [
      "Unitevi a noi per una grande giornata di passeggiate nella nostra magnifica campagna! C'è qualcosa per tutti, un sacco di ristoro e un'atmosfera amichevole. Novità: passeggiata Trail Off."
    ],
    "fr": [
      "Rendez-vous pour une belle journée de marche à travers nos magnifiques paysages ! Des parcours pour tous, des ravitaillements gourmands et une ambiance conviviale vous attendent. Inédit : marche Trail Off."
    ],
    "es": [
      "Únase a nosotros para disfrutar de un magnífico día de senderismo por nuestros magníficos paisajes Habrá algo para todos los gustos, muchos refrigerios y un ambiente agradable. Nuevo: Paseo Trail Off."
    ],
    "nl": [
      "Ga met ons mee voor een geweldige wandeldag door onze prachtige natuur! Er is voor elk wat wils, voldoende versnaperingen en een gezellige sfeer. Nieuw: Trail Off wandeling."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Marche des 3 Vallées"
    ]
  },
