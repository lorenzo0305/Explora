  "rdfs:comment": {
    "de": [
      "Das Le National empfängt Sie im Zentrum des Dorfes Saint Jean d'Aulps und bietet Ihnen seine köstlichen Pizzas, Nachos, Salate, Snacks und Getränke aus aller Welt an. Herrlicher Blick auf die umliegenden Berge von unserer neuen Terrasse."
    ],
    "en": [
      "Bar, restaurant and terrace in the centre of St Jean d'Aulps village. We offer excellent pizzas, nachos, salads and sides with a selection of drinks from round the world. Our new sun soaked tarrace has magnificent views."
    ],
    "it": [
      "Le National vi accoglie nel centro del villaggio di Saint Jean d'Aulps e vi offre deliziose pizze, nachos, insalate, snack e bevande da tutto il mondo. Magnifica vista sulle montagne circostanti dalla nostra nuova terrazza."
    ],
    "fr": [
      "Le National vous accueille au centre du village de Saint Jean d'Aulps et vous propose ses délicieuses pizzas, nachos, salades, snacks et boissons du monde. Vue magnifique sur les montagnes environnantes depuis notre nouvelle terrasse."
    ],
    "nl": [
      "Le National verwelkomt u in het centrum van het dorp Saint Jean d'Aulps en biedt u heerlijke pizza's, nacho's, salades, snacks en drankjes uit de hele wereld. Prachtig uitzicht op de omliggende bergen vanaf ons nieuwe terras."
    ],
    "es": [
      "Le National le da la bienvenida en el centro del pueblo de Saint Jean d'Aulps y le ofrece deliciosas pizzas, nachos, ensaladas, aperitivos y bebidas de todo el mundo. Magníficas vistas de las montañas circundantes desde nuestra nueva terraza."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bar Le National"
    ],
    "fr": [
      "Bar Le National"
    ]
  },
