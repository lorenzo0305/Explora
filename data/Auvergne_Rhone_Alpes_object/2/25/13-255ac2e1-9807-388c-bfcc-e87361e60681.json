  "rdfs:comment": {
    "de": [
      "Die Ausstellung Portraits de Lyon inszeniert eine synthetische Erzählung der Geschichte Lyons, indem sie historische und geografische Daten, symbolische und Sammlungsobjekte, fiktive Zeugenfiguren, immersive oder animierte Filme und ein interaktives Modell miteinander verbindet."
    ],
    "en": [
      "\"Portraits of Lyon\" is an overview of Lyon's history that combines historical and geographical data, symbolic and collector's items, fictitious testimonials, films and interactive models."
    ],
    "it": [
      "La mostra Ritratti di Lione presenta un resoconto sintetico della storia di Lione, combinando dati storici e geografici, oggetti simbolici e da collezione, personaggi-testimoni, filmati immersivi o di animazione e modelli interattivi."
    ],
    "fr": [
      "L'exposition Portraits de Lyon met en scène un récit synthétique de l’histoire de Lyon en mêlant données historiques et géographiques, objets symboliques et de collection, personnages-témoins fictifs, films immersif ou d’animation, maquette interactive."
    ],
    "es": [
      "La exposición Retratos de Lyon presenta un relato conciso de la historia de Lyon, combinando datos históricos y geográficos, objetos simbólicos y de colección, personajes-testigos de ficción, películas inmersivas o animadas y maquetas interactivas."
    ],
    "nl": [
      "De tentoonstelling Portraits of Lyon geeft een beknopt overzicht van de geschiedenis van Lyon door historische en geografische gegevens, symbolische en verzamelobjecten, fictieve personage-getuigen, immersieve of geanimeerde films en interactieve modellen te combineren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Portraits of Lyon"
    ],
    "fr": [
      "Portraits de Lyon - Se repérer dans la ville"
    ]
  },
