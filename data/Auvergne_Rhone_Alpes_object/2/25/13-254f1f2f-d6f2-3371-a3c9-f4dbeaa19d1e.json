  "rdfs:comment": {
    "de": [
      "Das Restaurant-Bar La Voûte befindet sich im Herzen des Dorfes Saint Martin und bietet eine traditionelle Feinschmeckerküche, Spezialitäten aus den Savoyen sowie eine große Auswahl an Pizzaspezialitäten, die Sie vor Ort zu sich nehmen oder auch mitnehmen können. Sonnenterrasse."
    ],
    "en": [
      "Located in the village of Saint Martin , La Voute offers traditional cuisine, local specialties and a wide selection of pizzas to eat in or take away. Sunny terrace."
    ],
    "it": [
      "Situato nel cuore del villaggio di Saint Martin, il ristorante e bar La Voûte offre una cucina gourmet tradizionale, specialità savoiarde e un'ampia scelta di pizze da mangiare o da portare via. Terrazza soleggiata."
    ],
    "fr": [
      "Situé au coeur du village de Saint Martin, le restaurant bar La Voûte propose une cuisine traditionnelle gourmande, des spécialités savoyardes, ainsi qu'un large choix de pizzas à consommer sur place ou à emporter. Terrasse ensoleillée."
    ],
    "es": [
      "Situado en el corazón del pueblo de Saint Martin, el restaurante-bar La Voûte sirve cocina gastronómica tradicional, especialidades saboyanas y una amplia selección de pizzas para comer en el restaurante o para llevar. Terraza soleada."
    ],
    "nl": [
      "Het bar-restaurant La Voûte is gelegen in het hart van het dorp van Saint Martin en biedt smaakvolle traditionele gerechten, Savoyaardse streekspecialiteiten en een uitgebreide keuze (afhaal)pizza's. Zonovergoten terras."
    ]
  },
