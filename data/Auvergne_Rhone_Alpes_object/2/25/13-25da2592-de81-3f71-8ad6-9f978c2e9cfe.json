  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine große Auswahl an schnellen und erschwinglichen Gerichten.\r\nProbieren Sie auf unserer Terrasse unsere Burger, Bagels, Fish'n'Chips, etc.\r\nZugang für Fußgänger und Skifahrer."
    ],
    "en": [
      "We offer many choices of fast and affordable dishes.\r\nCome and taste our burgers, bagels, fish'n'chips, etc. on our terrace.\r\nPedestrian and skier access."
    ],
    "it": [
      "Offriamo una vasta gamma di piatti veloci e convenienti.\r\nVenite a gustare i nostri hamburger, bagel, fish'n'chips, ecc. sulla nostra terrazza.\r\nAccesso pedonale e per sciatori."
    ],
    "fr": [
      "Nous vous proposons de nombreux choix de plats rapides et abordables.\r\nVenez dégustez  sur notre terrasse nos burgers, bagels, fish'n'chips, etc...\r\nAccès piétons et skieurs."
    ],
    "nl": [
      "Wij bieden veel keuze aan snelle en betaalbare gerechten.\r\nKom onze hamburgers, bagels, fish'n'chips etc. proeven op ons terras.\r\nToegang voor voetgangers en skiërs."
    ],
    "es": [
      "Ofrecemos una amplia gama de platos rápidos y asequibles.\r\nVenga a disfrutar de nuestras hamburguesas, bagels, fish'n'chips, etc. en nuestra terraza.\r\nAcceso para peatones y esquiadores."
    ]
  },
