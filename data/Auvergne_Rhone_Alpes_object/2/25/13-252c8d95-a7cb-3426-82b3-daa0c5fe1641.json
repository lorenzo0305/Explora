  "rdfs:comment": {
    "de": [
      "Im Rahmen des Kultursommers der DRAC Auvergne-Rhône-Alpes, der diesen Sommer in der ADAPEI Langeac stattfand, nahmen die Bewohner gemeinsam mit Pierre und Sidonie an künstlerischen Workshops teil."
    ],
    "en": [
      "As part of the DRAC Auvergne-Rhône-Alpes cultural summer organized this summer at ADAPEI Langeac, residents took part in creative art workshops with Pierre and Sidonie."
    ],
    "it": [
      "Nell'ambito dell'estate culturale DRAC Auvergne-Rhône-Alpes, organizzata quest'estate presso l'ADAPEI Langeac, i residenti hanno partecipato a laboratori di arti creative con Pierre e Sidonie."
    ],
    "fr": [
      "Dans le cadre de l'été culturel de la DRAC Auvergne-Rhône-Alpes, organisé cet été à l'ADAPEI de Langeac, les résidents ont participé à des ateliers de création artistiques, en compagnie de Pierre et Sidonie."
    ],
    "nl": [
      "In het kader van de culturele zomer die DRAC Auvergne-Rhône-Alpes deze zomer organiseerde in ADAPEI Langeac, namen bewoners deel aan creatieve kunstworkshops met Pierre en Sidonie."
    ],
    "es": [
      "En el marco del verano cultural DRAC Auvergne-Rhône-Alpes, organizado este verano en ADAPEI Langeac, los residentes participaron en talleres de creación artística con Pierre y Sidonie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition des résidents de l'ADAPEI de Langeac."
    ]
  },
