  "rdfs:comment": {
    "de": [
      "Entdecken Sie GIARDINO by Cavallo, Ihr unverzichtbares italienisches Restaurant und Pizzeria im The Village Outlet, das Sie sofort in die bezaubernde Atmosphäre der Amalfiküste versetzt."
    ],
    "en": [
      "Discover GIARDINO by Cavallo, your must-visit Italian restaurant and pizzeria in The Village Outlet, which immediately transports you to the enchanting atmosphere of the Amalfi Coast."
    ],
    "it": [
      "Scoprite GIARDINO by Cavallo, il vostro imperdibile ristorante e pizzeria italiano al The Village Outlet, che vi trasporterà immediatamente nell'incantevole atmosfera della Costiera Amalfitana."
    ],
    "fr": [
      "Découvrez GIARDINO by Cavallo, votre restaurant et pizzeria italienne incontournable situé à The Village Outlet, qui vous transporte immédiatement dans l’ambiance envoûtante de la Côte Amalfitaine."
    ],
    "nl": [
      "Ontdek GIARDINO by Cavallo, je must-visit Italiaanse restaurant en pizzeria in The Village Outlet, die je meteen in de betoverende sfeer van de Amalfikust brengt."
    ],
    "es": [
      "Descubra GIARDINO by Cavallo, su restaurante y pizzería italiana de visita obligada en The Village Outlet, que le transportará de inmediato al encantador ambiente de la Costa Amalfitana."
    ]
  },
