  "rdfs:comment": {
    "de": [
      "Spielbar, Verkauf von Gesellschaftsspielen, TCG (Spielkarten), Vermietung von Versammlungs-/Seminarräumen\r\n\r\nEntdecken Sie die Kombination aus einer Bar mit lokalen Produkten und Räumen, in denen Sie Ihre Gesellschaftsspiele ausprobieren können.\r\nSpiele zum Verkauf."
    ],
    "en": [
      "Fun bar, sale of board games, TCG (playing cards), meeting/seminar room rental\r\n\r\nDiscover the combination of a bar offering local products and a space for testing your board games.\r\nGames available for sale."
    ],
    "it": [
      "Bar, vendita di giochi da tavolo, TCG (carte da gioco), noleggio di sale per riunioni/seminari\r\n\r\nScoprite la combinazione di un bar che offre prodotti locali e spazi per provare i vostri giochi da tavolo.\r\nGiochi disponibili per la vendita."
    ],
    "fr": [
      "Bar ludique, vente de jeux de société, TCG (cartes à jouer), location salle de réunion/ séminaire\r\n\r\nDécouvrez l'alliance d'un bar proposant des produits locaux et d'espaces pour tester vos jeux de société.\r\nJeux disponibles à la vente."
    ],
    "nl": [
      "Fun bar, verkoop van bordspellen, TCG (speelkaarten), verhuur van vergader-/seminarruimtes\r\n\r\nOntdek de combinatie van een bar met lokale producten en ruimtes om je bordspellen uit te proberen.\r\nSpellen te koop."
    ],
    "es": [
      "Bar de diversión, venta de juegos de mesa, TCG (naipes), alquiler de salas para reuniones/seminarios\r\n\r\nDescubra la combinación de un bar que ofrece productos locales y zonas para probar sus juegos de mesa.\r\nJuegos a la venta."
    ]
  },
  "rdfs:label": {
