  "rdfs:comment": {
    "de": [
      "Restaurant Les Voûtes in Lanas. Restaurant und Sommerterrasse im Süden der Ardèche. Französische Küche von hoher Qualität. Gut gefüllte Teller, die dem Auge und dem Gaumen schmeicheln. Menü und à la carte: Salate, Feinschmeckerbretter, Filet, hausgemachte Burger, Muscheln mit Pommes ."
    ],
    "ru": [
      "Ресторан Les Voûtes в Ланасе. Ресторан и летняя терраса в южном Ардеше. Качественная французская кухня. Хорошо сервированные тарелки, радующие как глаз, так и вкус. Меню: Салаты, тарелки для гурманов, филе, домашний бургер, мидии и чипсы..."
    ],
    "en": [
      "Les Voûtes restaurant in Lanas. Restaurant and summer terrace in southern Ardèche. Quality French cuisine. Well-stocked plates, pleasing to the eye as well as to the palate. Menu & Menu : Salads, Gourmet platters, Faux filet, Home-made burger, Mussels and chips..."
    ],
    "it": [
      "Ristorante Les Voûtes a Lanas. Ristorante e terrazza estiva nel sud dell'Ardèche. Cucina francese di qualità. Piatti ben forniti, piacevoli sia alla vista che al palato. Menu & Menu : Insalate, Taglieri gourmet, Finto filetto, Hamburger della casa, Cozze e patatine..."
    ],
    "fr": [
      "Les Voûtes à Lanas : restaurant & pizzeria en sud Ardèche. Terrasse d’été, cuisine française généreuse, burgers maison, faux-filet, salades, planches, moules-frites et pizzas artisanales. Saveurs authentiques qui donnent envie de réserver !"
    ],
    "zh": [
      "拉纳斯的 Les Voûtes 餐厅。餐厅和夏季露台位于阿尔代什南部。优质法国美食。菜品丰富，色香味俱全。菜单和菜谱：沙拉、美食拼盘、法式菲力牛排、自制汉堡、贻贝和薯条......"
    ],
    "es": [
      "Restaurante Les Voûtes en Lanas. Restaurante y terraza de verano en el sur de Ardèche. Cocina francesa de calidad. Platos bien surtidos, agradables tanto a la vista como al paladar. Menú & Carta : Ensaladas, Platos gastronómicos, Faux filet, Hamburguesa casera, Mejillones con patatas fritas..."
    ],
    "nl": [
      "Restaurant Les Voûtes in Lanas. Restaurant en zomerterras in het zuiden van de Ardèche. Franse kwaliteitskeuken. Goed gevulde borden, zowel een streling voor het oog als voor het gehemelte. Menu & kaart : Salades, Gourmetschotels, Faux filet, Huisgemaakte hamburger, Mosselen met friet..."
    ]
  },
