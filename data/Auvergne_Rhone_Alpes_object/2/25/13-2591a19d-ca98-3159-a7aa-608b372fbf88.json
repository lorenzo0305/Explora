      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/caf7b2dc-3e3c-3f34-aeb8-8134d62dd599",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Freier Zugang das ganze Jahr über (vom 1. April bis zum 15. August ist der Zugang zu den Streiks und den Inseln verboten, um die Tierwelt während der Fortpflanzungszeit nicht zu stören).\r\nZugang für Fahrzeuge geregelt (Parkplatz am Ende des Chemin des Jeandeaux), ein Pfad führt dann zum Herzen des Reservats."
            ],
            "en": [
              "Free access all year round (from April 1 to August 15, access is prohibited on the shores and islands to avoid disturbing wildlife during the breeding season).\r\nRegulated vehicle access (parking lot at the end of chemin des Jeandeaux), then a footpath leads to the heart of the Reserve."
            ],
            "it": [
              "Accesso libero tutto l'anno (dal 1° aprile al 15 agosto, l'accesso è vietato sulle rive e sulle isole per non disturbare la fauna durante la stagione riproduttiva).\r\nAccesso regolamentato per i veicoli (parcheggio alla fine dello Chemin des Jeandeaux). Un sentiero pedonale conduce al cuore della Riserva."
            ],
            "fr": [
              "Accès libre toute l'année (du 1er avril au 15 août accès interdit sur les grèves et les îles pour ne pas perturber la faune en période de reproduction).\r\nAccès véhicules réglementé (parking au bout du chemin des Jeandeaux), un sentier permet ensuite d'accéder au cœur de la Réserve."
            ],
            "nl": [
              "Het hele jaar vrij toegankelijk (van 1 april tot 15 augustus verboden toegang op de oevers en de eilanden om de wilde dieren niet te storen tijdens het broedseizoen).\r\nGereguleerde toegang voor voertuigen (parkeerplaats aan het einde van de Chemin des Jeandeaux). Een wandelpad leidt naar het hart van het reservaat."
            ],
            "es": [
              "Acceso libre todo el año (del 1 de abril al 15 de agosto, el acceso está prohibido en las orillas y las islas para no molestar a la fauna durante la época de reproducción).\r\nAcceso regulado para vehículos (aparcamiento al final del Chemin des Jeandeaux). Un sendero conduce al corazón de la Reserva."
            ]
          },
