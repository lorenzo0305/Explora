  "rdfs:comment": {
    "de": [
      "Naturschutzgebiet am Ufer der Loire mit einem außergewöhnlichen Naturerbe, das den Ursprung dieses noch jungen Naturschutzgebiets bildet, das zweite für das Departement Allier."
    ],
    "en": [
      "A nature reserve on the banks of the Loire, with an exceptional natural heritage that has led to the creation of this young nature reserve, the second in the Allier department."
    ],
    "it": [
      "Una riserva naturale sulle rive della Loira, con un patrimonio naturale eccezionale che ha portato alla creazione di questa giovanissima riserva naturale, la seconda del dipartimento dell'Allier."
    ],
    "fr": [
      "Réserve naturelle en bord de Loire avec un patrimoine naturel exceptionnel à l'origine de cette toute jeune réserve naturelle, la deuxième pour le département de l'Allier."
    ],
    "es": [
      "Una reserva natural a orillas del Loira, con un patrimonio natural excepcional que ha propiciado la creación de esta jovencísima reserva natural, la segunda del departamento de Allier."
    ],
    "nl": [
      "Een natuurreservaat aan de oevers van de Loire, met een uitzonderlijk natuurlijk erfgoed dat heeft geleid tot de oprichting van dit zeer jonge natuurreservaat, het tweede in het departement Allier."
    ]
  },
