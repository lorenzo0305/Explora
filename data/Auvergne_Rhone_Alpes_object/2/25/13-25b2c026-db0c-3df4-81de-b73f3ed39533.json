  "rdfs:comment": {
    "de": [
      "Die Domaine Christophe Semaska in der Nähe von Schloss Montlys am Fuß eines terrassenförmigen Hangs betreibt 8 ha Côte-Rôtie sowie Condrieu, Saint-Joseph, Coteaux de Vienne und Crus aus dem Rhonetal."
    ],
    "en": [
      "The Domaine Christophe Semaska is near the Château de Montlys, at the foot of a terraced hillside. producing 8 hectares of Côte-Rôtie wines, as well as Condrieu, St Joseph, Coteaux de Vienne and other Rhone Valley wines."
    ],
    "it": [
      "Il Domaine Christophe Semaska, situato vicino a Château de Montlys ai piedi di una collina terrazzata, produce 8 ettari di Côte-Rôtie, oltre a Condrieu, Saint-Joseph, Coteaux de Vienne e crus della Valle del Rodano, per una produzione totale di 15 ettari."
    ],
    "fr": [
      "Le Domaine Christophe Semaska situé à proximité du Château de Montlys, au pied d’un coteau en terrasse, produit 8 ha en Côte-Rôtie mais aussi Condrieu, Saint-Joseph, Coteaux de Vienne et crus de la vallée du Rhône pour un total de production de 15ha."
    ],
    "es": [
      "El Domaine Christophe Semaska, situado cerca del Château de Montlys, al pie de una ladera en terrazas, produce 8 hectáreas de Côte-Rôtie, así como Condrieu, Saint-Joseph, Coteaux de Vienne y crus del valle del Ródano, para una producción total de 15 hectáreas."
    ],
    "nl": [
      "Domaine Christophe Semaska, gelegen in de buurt van Château de Montlys aan de voet van een terrasvormige heuvel, produceert 8 hectare Côte-Rôtie, evenals Condrieu, Saint-Joseph, Coteaux de Vienne en Rhône Valley crus, voor een totale productie van 15 hectare."
    ]
  },
