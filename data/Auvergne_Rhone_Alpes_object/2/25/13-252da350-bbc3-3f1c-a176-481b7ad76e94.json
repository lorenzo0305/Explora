  "rdfs:comment": {
    "de": [
      "Sie finden \"Au Bon Accueil\", eine gemütliche, aber schnörkellose Atmosphäre und eine raffinierte traditionelle Küche mit frischen und regionalen Produkten."
    ],
    "en": [
      "You will find \"Au Bon Accueil\", a cozy but unfussy atmosphere and refined traditional cuisine made with fresh, local products."
    ],
    "it": [
      "Troverete \"Au Bon Accueil\", un'atmosfera accogliente ma non leziosa e una raffinata cucina tradizionale a base di prodotti freschi e locali."
    ],
    "fr": [
      "Vous trouverez \"Au Bon Accueil\", une ambiance cosy mais sans chichi et une cuisine traditionnelle raffinée composée de produits frais et locaux."
    ],
    "nl": [
      "U vindt er \"Au Bon Accueil\", een gezellige maar niet pietluttige sfeer en een verfijnde traditionele keuken op basis van verse en lokale producten."
    ],
    "es": [
      "Encontrará \"Au Bon Accueil\", un ambiente acogedor pero no recargado y una refinada cocina tradicional elaborada con productos frescos y locales."
    ]
  },
