  "rdfs:comment": {
    "de": [
      "Das Cinéma Atmosphère ist ein Komplex mit drei Sälen mit 248, 148 und 80 Sitzen. Alle drei Säle sind für Personen mit eingeschränkter Mobilität zugänglich."
    ],
    "en": [
      "The Cinéma Atmosphère is a three-screen complex with 248, 148 and 80 seats. All three are accessible to people with reduced mobility."
    ],
    "it": [
      "Il Cinéma Atmosphère è un complesso che comprende tre cinema da 248, 148 e 80 posti. Tutti e tre i cinema sono accessibili alle persone con mobilità ridotta."
    ],
