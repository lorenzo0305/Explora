  "rdfs:comment": {
    "de": [
      "Les Jardins du Salençon ist ein Bauernhof mit biologischem Gemüseanbau, der 2025 von Anne-Sophie und Baptiste DAUJAT gegründet wurde. Wir verkaufen unser Gemüse im Direktverkauf auf dem Markt in Bourg am Mittwochmorgen (Markthalle) und auf dem Bauernhof am Freitag von 16 bis 19 Uhr."
    ],
    "en": [
      "Les Jardins du Salençon is an organic market-gardening farm created in 2025 by Anne-Sophie and Baptiste DAUJAT. We sell our vegetables direct at the Bourg market on Wednesday mornings (covered market) and at the farm on Fridays from 4pm to 7pm."
    ],
    "it": [
      "Les Jardins du Salençon è un'azienda agricola biologica nata nel 2025 da Anne-Sophie e Baptiste DAUJAT. Vendiamo i nostri ortaggi direttamente al mercato di Bourg il mercoledì mattina (mercato coperto) e in fattoria il venerdì dalle 16.00 alle 19.00."
    ],
    "fr": [
      "Les Jardins du Salençon sont une ferme en maraîchage biologique créée en 2025 par Anne-Sophie et Baptiste DAUJAT, nous vendons nos légumes en vente directe au marché de Bourg le mercredi matin (marché couvert) et à la ferme le vendredi de 16h à 19h."
    ],
    "nl": [
      "Les Jardins du Salençon is een biologische tuinderij die in 2025 is opgericht door Anne-Sophie en Baptiste DAUJAT. We verkopen onze groenten rechtstreeks op de markt van Bourg op woensdagochtend (overdekte markt) en op de boerderij op vrijdag van 16.00 tot 19.00 uur."
    ],
    "es": [
      "Les Jardins du Salençon es una granja de horticultura ecológica creada en 2025 por Anne-Sophie y Baptiste DAUJAT. Vendemos nuestras verduras directamente en el mercado de Bourg los miércoles por la mañana (mercado cubierto) y en la granja los viernes de 16:00 a 19:00."
    ]
  },
