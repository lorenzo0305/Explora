  "rdfs:comment": {
    "de": [
      "Anfänger, Skifahrer aller Niveaus, auf der Suche nach Technik, Off-Piste oder schönen Skitouren, wir werden uns Ihren Wünschen anpassen."
    ],
    "en": [
      "Beginners, skiers of all levels, looking for technique, off-piste or beautiful ski touring outings, we will be able to adapt to your desires."
    ],
    "it": [
      "Principianti, sciatori di tutti i livelli, in cerca di tecnica, di fuoripista o di belle sciate, sapremo adattarci ai vostri desideri."
    ],
    "fr": [
      "Débutants, skieurs de tout niveau, à la recherche de technique, de hors-piste ou de belles balades en ski de randonnée, nous saurons nous adapter à vos envies."
    ],
    "es": [
      "Principiantes, esquiadores de todos los niveles, en busca de técnica, fuera de pista o de un bonito esquí de travesía, podremos adaptarnos a sus deseos."
    ],
    "nl": [
      "Of je nu een beginner bent of een skiër van elk niveau, of je nu op zoek bent naar techniek, off-piste skiën of geweldige toerskiën, wij kunnen ons aanpassen aan jouw wensen."
    ]
  },
