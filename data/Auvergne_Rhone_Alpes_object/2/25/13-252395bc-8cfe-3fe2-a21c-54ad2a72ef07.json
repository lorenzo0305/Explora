  "rdfs:comment": {
    "de": [
      "Gegenüber dem Schloss von Tournoël, wo das Volvic-Wasser fließt, am Fuße der Vulkane, in der Nähe von Vulcania, genießen Sie einen Crêpe oder eine Galette in der Auberge oder auf unserer Terrasse mit Panoramablick auf die Ebene von Limagne und die Berge von Livradois Forez."
    ],
    "en": [
      "Opposite Tournoël castle, where Volvic water flows, at the foot of the volcanoes, near Vulcania, come and enjoy a crêpe or a galette in the inn or on our terrace with panoramic views over the Limagne plain and the Livradois Forez mountains."
    ],
    "it": [
      "Di fronte al castello di Tournoël, dove sgorga l'acqua Volvic, ai piedi dei vulcani, vicino a Vulcania, venite a gustare una crêpe o una galette nella locanda o sulla nostra terrazza con vista panoramica sulla pianura della Limagne e sulle montagne del Livradois Forez."
    ],
    "fr": [
      "Face au château de Tournoël, là où coule l'eau de Volvic, au pied des volcans, près de Vulcania, venez déguster une crêpe ou une galette dans l'auberge ou sur notre terrasse avec vue panoramique sur la plaine de Limagne et les monts du Livradois Forez."
    ],
    "nl": [
      "Tegenover het kasteel van Tournoël, waar het water van Volvic stroomt, aan de voet van de vulkanen, vlakbij Vulcania, kom genieten van een crêpe of een galette in de herberg of op ons terras met een panoramisch uitzicht over de vlakte van de Limagne en de bergen van Livradois Forez."
    ],
    "es": [
      "Frente al castillo de Tournoël, donde fluye el agua del Volvic, al pie de los volcanes, cerca de Vulcania, venga a saborear una crêpe o una galette en el mesón o en nuestra terraza con vista panorámica sobre la llanura de Limagne y los montes Livradois Forez."
    ]
  },
  "rdfs:label": {
    "de": [
