  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b0341be6-c0f3-3791-9076-f948f2debed7",
      "dc:description": {
        "de": [
          "Bar de quartier- Gegenüber der Kathedrale de la Treille gelegen\n\nAbwechslungsreiche Hintergrundmusik Jazz, Soul, Funk\n\nDienstag bis Samstag von 10.00 bis 00.00 Uhr geöffnet\nSonntag von 11.00 bis 20.00 Uhr\n\nAkzeptiert Gruppen von 10 bis 30 Personen in einem Raum im Obergeschoss mit Blick auf die Kathedrale\n\n "
        ],
        "en": [
          "Neighborhood bar - Located in front of the Cathedral de la Treille\n\nJazz, Soul, Funk background music\n\nOpen Tuesday to Saturday from 10H00 to 00H00\nSunday 11am to 8pm\n\nGroups from 10 to 30 people in an upstairs room overlooking the cathedral\n\n "
        ],
        "it": [
          "Bar locale - Situato di fronte alla Cattedrale della Treille\n\nMusica di sottofondo variegata Jazz, Soul, Funk\n\nAperto da martedì a sabato dalle 10H00 alle 00H00\nDomenica dalle 11H00 alle 20H00\n\nGruppi da 10 a 30 persone accolti in una sala al piano superiore con vista sulla cattedrale\n\n "
        ],
        "fr": [
          "Bar de quartier- Situé en face la cathédrale de la Treille \n\nMusiques d'ambiance variées Jazz, Soul, Funk\n\nOuvert du Mardi au Samedi de 10H00 à 00H00\nLe Dimanche de 11H00 à 20H00\n\nAccepte les groupes de 10 à 30 personnes dans une salle à l'étage avec vue sur la cathédrale\n\n "
        ],
        "nl": [
          "Lokale bar - Gelegen tegenover de Kathedraal de la Treille\n\nGevarieerde achtergrondmuziek Jazz, Soul, Funk\n\nOpen dinsdag tot zaterdag van 10H00 tot 00H00\nZondag van 11H00 tot 20H00\n\nGroepen van 10 tot 30 personen welkom in een bovenzaal met uitzicht op de kathedraal\n\n "
        ],
        "es": [
          "Bar local - Situado frente a la Catedral de la Treille\n\nMúsica de fondo variada Jazz, Soul, Funk\n\nAbierto de martes a sábado de 10H00 a 00H00\nDomingo de 11H00 a 20H00\n\nAcogida de grupos de 10 a 30 personas en una sala superior con vistas a la catedral\n\n "
        ]
      },
