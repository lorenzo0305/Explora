  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8aea3385-d119-34c1-8101-23ac50962d7f",
      "dc:description": {
        "de": [
          "Entdecken Sie in Begleitung einer Färberin aus der Region die Geheimnisse des Färbens mit Pflanzen und nehmen Sie ein Kleidungsstück oder eine Tote Bag in den Farben der Natur mit nach Hause!"
        ],
        "en": [
          "In the company of a local dyer, discover the secrets of plant-based dyeing and leave with a garment or tote bag in nature?s colors!"
        ],
        "it": [
          "In compagnia di un tintore locale, scoprite i segreti della tintura a base vegetale e partite con un capo o una tote bag dai colori della natura!"
        ],
        "fr": [
          "En compagnie d’une teinturière du territoire,  découvrez les secrets de la teinture à base de  plantes et repartez avec un vêtement ou un  tote bag aux couleurs de la nature !"
        ],
        "nl": [
          "Ontdek in het gezelschap van een plaatselijke verver de geheimen van het verven op plantaardige basis en vertrek met een kledingstuk of draagtas in de kleuren van de natuur!"
        ],
        "es": [
          "En compañía de un tintorero local, descubra los secretos del teñido a base de plantas y váyase con una prenda o un bolso con los colores de la naturaleza"
        ]
      },
