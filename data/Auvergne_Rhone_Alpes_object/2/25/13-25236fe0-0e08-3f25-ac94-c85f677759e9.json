  "rdfs:comment": {
    "de": [
      "Bäuerliche Konditorei in der Ardèche Verte, ich produziere und verarbeite Bio-Obst zu Süßwaren wie Fruchtpaste, Konfitüren, Sirup, Nougat, Weihnachtsschokolade. . ."
    ],
    "en": [
      "\"Farmer confectioner\" in Ardèche Verte, I produce and transform organic fruit into confectionery such as fruit paste, jams, syrups, nougats, Christmas chocolates ..."
    ],
    "it": [
      "Come agricoltore e pasticcere dell'Ardèche Verte, produco e trasformo la frutta biologica in prodotti dolciari: pasta di frutta, marmellate, sciroppi, torroni, cioccolatini natalizi..."
    ],
    "fr": [
      "Paysan confiseur en Ardèche Verte, je produis et transforme des fruits bio en confiserie :  pâte de fruits, confitures, sirops, nougats, chocolats de noël..."
    ],
    "es": [
      "Como agricultor y confitero de Ardèche Verte, produzco y transformo fruta ecológica en confitería: pasta de fruta, mermeladas, siropes, turrones, bombones de Navidad..."
    ],
    "nl": [
      "Als boer en banketbakker in de Ardèche Verte produceer en verwerk ik biologisch fruit in snoepgoed zoals vruchtenpasta, jam, siroop, nougats, kerstchocolade..."
    ]
