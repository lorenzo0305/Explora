  "rdfs:comment": {
    "de": [
      "Traditionelle und schmackhafte Küche aus Marokko. Dekor wie aus Tausendundeiner Nacht. Hausgemachte Spezialitäten. Verschiedene Couscous, Tajines, Spieße mit Gewürzdüften. Gebäck."
    ],
    "en": [
      "Traditional and tasty Moroccan cuisine. Decoration of the thousand and one nights. Home-made specialties. Various couscous, tajines, skewers with spicy flavors. Pastries."
    ],
    "it": [
      "Cucina marocchina tradizionale e gustosa. Decoro delle mille e una notte. Specialità fatte in casa. Couscous vari, tajine, spiedini piccanti. Pasticceria."
    ],
    "fr": [
      "Cuisine traditionnelle et savoureuse du Maroc. Décor des mille et une nuits. Spécialités faites maison. Divers couscous, tajines, brochettes aux parfums d’épices. Pâtisseries."
    ],
    "nl": [
      "Traditionele en smakelijke Marokkaanse keuken. Decor van de duizend en één nacht. Huisgemaakte specialiteiten. Diverse couscous, tajines, pittige brochettes. Gebakjes."
    ],
    "es": [
      "Cocina marroquí tradicional y sabrosa. Decoración de las mil y una noches. Especialidades caseras. Cuscús variado, tajines, brochetas picantes. Pastelería."
    ]
  },
  "rdfs:label": {
