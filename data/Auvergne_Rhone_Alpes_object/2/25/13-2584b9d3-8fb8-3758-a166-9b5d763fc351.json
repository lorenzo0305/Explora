  "rdfs:comment": {
    "de": [
      "Der Handwerker Sylvain Fournier ist Konditor, Eiskonditor, Chocolatier und Confiseur und seit November 2011 im La Cave à Chocolat und seit Dezember 2019 im La Grande Cave à Chocolat selbstständig."
    ],
    "en": [
      "A pastry chef, ice-cream maker, chocolate maker and confectioner, Sylvain Fournier has been self-employed since November 2011 at La Cave à Chocolat and since December 2019 at La Grande Cave à Chocolat."
    ],
    "it": [
      "Pasticciere artigianale, gelatiere, cioccolatiere e pasticcere, Sylvain Fournier lavora in proprio dal novembre 2011 presso La Cave à Chocolat e dal dicembre 2019 presso La Grande Cave à Chocolat."
    ],
    "fr": [
      "Artisan pâtissier, glacier, chocolatier et confiseur, Sylvain Fournier est à son compte depuis novembre 2011 à la cave à chocolat et depuis décembre 2019 à La Grande Cave à chocolat."
    ],
    "es": [
      "Pastelero artesano, heladero, chocolatero y confitero, Sylvain Fournier trabaja por cuenta propia desde noviembre de 2011 en La Cave à Chocolat y desde diciembre de 2019 en La Grande Cave à Chocolat."
    ],
    "nl": [
      "Artisanaal patissier, ijsmaker, chocolatier en banketbakker, Sylvain Fournier is sinds november 2011 zelfstandig ondernemer bij La Cave à Chocolat en sinds december 2019 bij La Grande Cave à Chocolat."
    ]
  },
