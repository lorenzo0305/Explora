  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit Familie oder Freunden in ein lustiges Abenteuer mit unserer Escape Box Apéro ein: Kooperieren Sie, lösen Sie die Rätsel und befreien Sie gemeinsam Ihren köstlichen Apéro aus Savoyen!"
    ],
    "en": [
      "Take your family or friends on a fun-filled adventure with our Escape Box apéro: work together, solve the riddles and release your delicious Savoyard apéro together!"
    ],
    "it": [
      "Portate la vostra famiglia o i vostri amici in un'avventura divertente con il nostro apéro Escape Box: lavorate insieme, risolvete gli enigmi e liberate insieme il vostro delizioso apéro savoiardo!"
    ],
    "fr": [
      "Plongez en famille ou entre amis dans une aventure amusante avec notre Escape Box apéro : coopérez, résolvez les énigmes et libérez ensemble votre délicieux apéro savoyard !"
    ],
    "nl": [
      "Neem je familie of vrienden mee op een leuk avontuur met onze Escape Box apéro: werk samen, los de raadsels op en laat samen je heerlijke Savoyaardse apéro los!"
    ],
    "es": [
      "Lleve a su familia o amigos a una aventura llena de diversión con nuestro Escape Box apéro: ¡trabajen juntos, resuelvan los enigmas y liberen juntos su delicioso apéro Savoyard!"
    ]
  },
