  "rdfs:comment": {
    "de": [
      "Der Bargoin-Park, der nach dem Vorbild eines englischen Gartens angelegt wurde, ist mit malerischen Elementen durchsetzt. In seiner Mitte dominiert ein Pavillon aus dem 18. Jahrhundert, der einst das Landhaus des ehemaligen Besitzers des Anwesens war."
    ],
    "en": [
      "Bargoin park was designed based on an English-style garden, featuring picturesque elements. In its centre sits an 18th century building, formerly the country house of the previous owner of the estate."
    ],
    "it": [
      "Il parco di Bargoin, modellato su un giardino all'inglese, è costellato di elementi pittoreschi. Al centro si trova un padiglione del XVIII secolo, un tempo dimora di campagna dell'ex proprietario della tenuta."
    ],
    "fr": [
      "Le parc Bargoin, conçu sur le modèle d’un jardin à l’anglaise, est ponctué d’éléments pittoresques. En son centre, domine un pavillon du 18e siècle, autrefois maison de campagne de l’ancien propriétaire du domaine."
    ],
    "nl": [
      "Het park van Bargoin, gemodelleerd naar een Engelse tuin, is bezaaid met pittoreske elementen. In het midden staat een 18e-eeuws paviljoen, ooit het landhuis van de voormalige eigenaar van het landgoed."
    ],
    "es": [
      "El parque de Bargoin, inspirado en un jardín inglés, está salpicado de elementos pintorescos. En su centro se alza un pabellón del siglo XVIII, que fue la casa de campo del antiguo propietario de la finca."
    ]
  },
  "rdfs:label": {
