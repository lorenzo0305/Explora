  "rdfs:comment": {
    "de": [
      "Möchten Sie natürlicher Produkte, Urlaubssouvenirs oder Geschenke kaufen? Dann besuchen Sie \"L'Essentiel\", unsere Boutique. Ätherisches Lavendelöle, Sirupe, Seifen, hausgemachte Marmeladen, Diffusoren für ätherische Öle."
    ],
    "en": [
      "Want to buy natural products, take a souvenir back with you, offer a gift? Come to l’Essentiel farm shop. Hybrid lavender essence, cordials, soaps, homemade jams and essence diffusers."
    ],
    "it": [
      "Volete acquistare prodotti naturali, portare con voi un souvenir o fare un regalo. Scoprite L'essentiel, il nostro negozio in fattoria. Olio essenziale di lavanda biologico, olio d'oliva, sciroppi, saponi, marmellate fatte in casa, diffusori di oli essenziali."
    ],
    "fr": [
      "Vous souhaitez acheter des produits naturels, ramener un souvenir, offrir un cadeau. Découvrez L'essentiel, boutique à la ferme. Huile essentielle de lavandin bio, huile d'olive, sirops, savons, confitures maison, des diffuseurs d'huiles essentielles."
    ],
    "nl": [
      "U wilt natuurlijke producten kopen, een souvenir mee terugbrengen, een cadeau geven. Ontdek L'essentiel, een boerderijwinkel. Biologische etherische olie van lavendel, olijfolie, siropen, zepen, zelfgemaakte jam."
    ],
    "es": [
      "Quiere comprar productos naturales, traerse un recuerdo o hacer un regalo. Descubra L'essentiel, la tienda de nuestra granja. Aceite esencial de lavanda ecológica, aceite de oliva, siropes, jabones, mermeladas caseras, difusores de aceites esenciales."
    ]
  },
