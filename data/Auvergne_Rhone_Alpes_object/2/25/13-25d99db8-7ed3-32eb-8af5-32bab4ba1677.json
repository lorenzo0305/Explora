  "rdfs:comment": {
    "de": [
      "3 Sterne-Hotel vor den Toren von Genf. Unsere 45 geräumigen Zimmer verfügen über modernste Einrichtungen. Ob für ein Wochenende mit der Familie, einen romantischen Ausflug oder eine Geschäftsreise, Sie werden über unsere angenehmen Tarife überrascht sein."
    ],
    "en": [
      "3-star hotel at the entrance to Geneva. 45 spacious bedrooms featuring the latest modern facilities. For a family weekend, a romantic getaway or for a business trip, you will be surprised by our affordable prices."
    ],
    "it": [
      "Le 47 camere e il ristorante sono caratterizzati da un'atmosfera da chalet savoiardo. Autenticità e cordialità conferiscono a questo hotel un carattere davvero accattivante."
    ],
    "fr": [
      "Une ambiance de chalet savoyard que l’on retrouve dans les 47 chambres et le restaurant. L’authenticité et la convivialité donnent à cet hôtel un caractère réellement attachant"
    ],
    "es": [
      "Hotel 3 estrellas a las puertas de Ginebra. Nuestras 45 espaciosas habitaciones cuentan con las instalaciones más modernas. Le sorprenderán nuestros precios para un fin de semana en familia, una estancia en pareja o de negocios."
    ],
    "nl": [
      "De 47 kamers en het restaurant ademen de sfeer van een Savoyaards chalet. Authenticiteit en gezelligheid geven dit hotel een echt vertederend karakter"
    ]
  },
