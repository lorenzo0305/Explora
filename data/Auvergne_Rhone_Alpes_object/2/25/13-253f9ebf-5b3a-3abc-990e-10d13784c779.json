  "rdfs:comment": {
    "de": [
      "L'Arche de Julie ist ein Tierheim und ein Erlebnisbauernhof, der Tiere aus Rettungsaktionen aufnimmt und Besuche in kleinen Gruppen, Sensibilisierung und Vermittlung durch Tiere für Familien, aber auch für Menschen mit Behinderungen anbietet."
    ],
    "en": [
      "A refuge and educational farm, L'Arche de Julie takes in rescued animals and offers small group visits, awareness-raising and animal-assisted therapy for families and people with disabilities."
    ],
    "it": [
      "Rifugio e fattoria didattica, L'Arche de Julie accoglie animali salvati e offre visite a piccoli gruppi, educazione sugli animali e mediazione per le famiglie e per le persone con disabilità."
    ],
    "fr": [
      "Refuge et ferme d’animation, L’Arche de Julie accueille des animaux issus de sauvetages et propose visites en petits groupes, sensibilisation et médiation par l’animal pour les familles mais aussi auprès de publics en situation de handicap."
    ],
    "es": [
      "Refugio y granja de actividades, El Arca de Julie acoge animales rescatados y ofrece visitas en grupos reducidos, educación animal y mediación para familias, así como para personas con discapacidad."
    ],
    "nl": [
      "L'Arche de Julie, een opvang- en activiteitenboerderij, vangt geredde dieren op en biedt bezoeken in kleine groepen, diereneducatie en bemiddeling voor gezinnen en mensen met een handicap."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Arche de Julie: farm offering activities and animal-assisted therapy"
    ],
    "fr": [
      "L'Arche de Julie : ferme d’animation et de médiation par l’animal"
    ]
  },
