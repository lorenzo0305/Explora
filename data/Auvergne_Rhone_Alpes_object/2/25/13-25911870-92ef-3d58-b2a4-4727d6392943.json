  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise auf dem grünen Parcours der Base de Lavalette: 600 m sehr leichte Orientierung, ideal für Anfänger. Erkunden Sie in 30 Minuten 9 Markierungen in einer beruhigenden natürlichen Umgebung, die perfekt für einen spielerischen Spaziergang an der frischen Luft ist."
    ],
    "en": [
      "Discover the green trail at Base de Lavalette: 600 m of very easy orienteering, ideal for beginners. In 30 minutes, explore 9 markers in a soothing natural setting, perfect for a fun outdoor stroll."
    ],
    "it": [
      "Scoprite il percorso verde della Base de Lavalette: 600 m di orienteering molto facile, ideale per i principianti. In 30 minuti, esplorate 9 marcatori in un ambiente naturale rilassante, perfetto per una divertente passeggiata all'aperto."
    ],
    "fr": [
      "Partez à la découverte du parcours vert de la Base de Lavalette : 600 m d’orientation très facile, idéal pour les débutants. En 30 minutes, explorez 9 balises dans un cadre naturel apaisant, parfait pour une balade ludique en plein air."
    ],
    "nl": [
      "Ontdek het groene parcours bij de Base de Lavalette: 600 m zeer gemakkelijke oriëntatieloop, ideaal voor beginners. Verken in 30 minuten 9 markeringen in een rustgevende natuurlijke omgeving, perfect voor een leuke wandeling in de buitenlucht."
    ],
    "es": [
      "Descubra la pista verde de la Base de Lavalette: 600 m de orientación muy fácil, ideal para principiantes. En 30 minutos, explore 9 balizas en un apacible entorno natural, perfecto para un divertido paseo al aire libre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours vert d'orientation de Lavalette"
    ]
  },
