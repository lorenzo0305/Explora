  "rdfs:comment": {
    "de": [
      "Am Stadtrand in der Nähe der Hauptverkehrsachsen gelegen. Ein Hotel mit origineller und angenehmer Architektur mit grünem Anstrich im Kolonialstil. Zimmer für 1,2 oder 3 Personen, besonders günstig ab51 €."
    ],
    "en": [
      "This eye-catching green hotel with a colonial look stands on the outskirts near the main roads. Rooms sleeping 1, 2 or 3 guests. Cheap and cheerful from 51 €."
    ],
    "it": [
      "In periferia, ma vicino alle strade principali, un hotel dall'architettura originale e piacevole, dal colore verde e il \"look\" coloniale. Camere per 1, 2 o 3 persone, particolarmente economiche a partire da 35 €."
    ],
    "fr": [
      "En périphérie, près des grands axes, un hôtel à l'architecture originale et agréable avec son \"look\" colonial. Des chambres pour 1, 2 ou 3 pers, particulièrement économiques à partir de 51€."
    ],
    "es": [
      "En las afueras, cerca de las carreteras principales, un hotel con una arquitectura original y agradable de aspecto colonial. Habitaciones para 1, 2 ó 3 personas, especialmente económicas a partir de 51?"
    ],
    "nl": [
      "Aan de randweg, vlakbij de grote verbindingswegen, een hotel met een originele bouwstijl, en aangenaam met zijn groene koloniale look. Bijzonder voordelige kamers voor 1, 2 of 3 pers: al vanaf €35."
    ]
  },
