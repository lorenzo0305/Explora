  "rdfs:comment": {
    "de": [
      "Gemütliches und intimes Restaurant, das eine raffinierte Küche anbietet, in der Sie die Geschmäcker und Produkte Italiens wiederfinden, für die seine Gastronomie berühmt ist."
    ],
    "en": [
      "A cosy, intimate restaurant serving refined cuisine, for a taste of the flavours and products of Italy that make its gastronomy so famous."
    ],
    "it": [
      "Ristorante intimo e accogliente che offre una cucina raffinata per riscoprire i sapori e i prodotti dell'Italia per cui la sua gastronomia è rinomata."
    ],
    "fr": [
      "Restaurant cosy et intimiste proposant une cuisine raffinée pour retrouver les saveurs et les produits d’Italie qui font la renommée de sa gastronomie."
    ],
    "es": [
      "Restaurante acogedor e íntimo que ofrece una cocina refinada para redescubrir los sabores y productos de Italia que hacen famosa su gastronomía."
    ],
    "nl": [
      "Gezellig en intiem restaurant met een verfijnde keuken om de smaken en producten van Italië te herontdekken die de gastronomie beroemd maken."
    ]
  },
