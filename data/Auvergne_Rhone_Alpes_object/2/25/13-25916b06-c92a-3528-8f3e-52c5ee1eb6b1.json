  "rdfs:comment": {
    "de": [
      "Sammler, Amateure, Familien oder Freunde: Entdecken, teilen und tauschen Sie sich in aller Gemütlichkeit rund um diese Ausstellung mit Spielzeug von 1920 bis heute aus!"
    ],
    "en": [
      "Collectors, enthusiasts, families or friends: come and discover, share and exchange ideas in a friendly atmosphere at this exhibition of toys from 1920 to the present day!"
    ],
    "it": [
      "Collezionisti, appassionati, famiglie o amici: venite a scoprire, condividere e scambiare idee in un'atmosfera amichevole in questa mostra di giocattoli dal 1920 ai giorni nostri!"
    ],
    "fr": [
      "Collectionneurs, amateurs, familles ou amis : venez découvrir, partager et échanger en toute convivialité autour de cette exposition de jouets de 1920 à nos jours !"
    ],
    "nl": [
      "Verzamelaars, liefhebbers, families of vrienden: kom en ontdek, deel en wissel ideeën uit in een gezellige sfeer op deze tentoonstelling van speelgoed van 1920 tot nu!"
    ],
    "es": [
      "Coleccionistas, aficionados, familias o amigos: vengan a descubrir, compartir e intercambiar ideas en un ambiente agradable en esta exposición de juguetes desde 1920 hasta nuestros días"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition permanente : La Caverne du Jouet"
    ]
  },
