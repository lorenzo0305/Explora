  "rdfs:comment": {
    "de": [
      "Entdecken Sie die \"Escale des Tribus\" in Les Estables, ein Restaurant und eine Ferienwohnung. Qualitativ hochwertige Verpflegung in einer freundlichen Atmosphäre. Der herzliche Empfang und das Bar-Restaurant heißen alle Besucher willkommen!"
    ],
    "en": [
      "Discover l'Escale des Tribus in Les Estables, a restaurant and gite. Quality catering in a friendly atmosphere. A warm welcome and bar-restaurant await all visitors!"
    ],
    "it": [
      "Scoprite l'Escale des Tribus a Les Estables, ristorante e gite. Cibo di qualità in un'atmosfera amichevole. Un'accoglienza calorosa e un bar-ristorante per tutti i visitatori!"
    ],
    "fr": [
      "Découvrez l'Escale des Tribus aux Estables, un restaurant et un gite. Restauration de qualité dans une ambiance conviviale. L'accueil chaleureux et le bar-restaurant accueillent tous les visiteurs !"
    ],
    "nl": [
      "Ontdek l'Escale des Tribus in Les Estables, een restaurant en gite. Kwaliteitseten in een vriendelijke sfeer. Een warm welkom en bar-restaurant voor alle bezoekers!"
    ],
    "es": [
      "Descubra l'Escale des Tribus en Les Estables, restaurante y casa rural. Comida de calidad en un ambiente acogedor. ¡Una cálida bienvenida y bar-restaurante para todos los visitantes!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant L'Escale des tribus"
    ]
