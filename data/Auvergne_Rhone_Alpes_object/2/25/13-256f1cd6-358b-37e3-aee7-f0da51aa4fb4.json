  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit dem Naturfilmfestival in das Herz des Lebens ein! Auf dem Programm stehen ein Dokumentarfilmwettbewerb, Expertenvorträge, Feldausflüge und Workshops zum Staunen, Teilen und Schützen der biologischen Vielfalt."
    ],
    "en": [
      "Immerse yourself in the heart of nature with the Nature Film Festival! On the program: a documentary competition, expert conferences, field trips, and workshops to marvel at, share, and protect biodiversity."
    ],
    "it": [
      "Immergetevi nel cuore della vita con il Festival del cinema naturalistico! In programma: un concorso di documentari, conferenze di esperti, escursioni sul campo e laboratori per ammirare, condividere e proteggere la biodiversità."
    ],
    "fr": [
      "Plongez au cœur du vivant avec le Festival du film nature ! Au programme : une compétition de documentaires, des conférences d'experts, des sorties terrain et des ateliers pour s'émerveiller, partager et protéger la biodiversité."
    ],
    "es": [
      "Sumérjase en el corazón de la vida con el Festival de Cine de la Naturaleza En el programa: un concurso de documentales, charlas de expertos, salidas al campo y talleres para maravillarse, compartir y proteger la biodiversidad."
    ],
    "nl": [
      "Duik in het hart van het leven met het Natuurfilmfestival! Op het programma: een documentairewedstrijd, lezingen van experts, excursies en workshops om de biodiversiteit te bewonderen, te delen en te beschermen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Nature Film Festival"
    ],
