  "rdfs:comment": {
    "de": [
      "\"Nach zwei ausverkauften Shows, über 200 Vorstellungen und Tausenden von Zuschauern ist D?jal mit einer neuen Show zurück, die noch verrücktere Figuren und noch verrücktere Situationen vereint!"
    ],
    "en": [
      "\"After two sold-out shows, more than 200 performances and thousands of spectators, D?jal is back with a new show combining even crazier characters and even crazier situations!"
    ],
    "it": [
      "\"Dopo due spettacoli sold-out, oltre 200 rappresentazioni e migliaia di spettatori, D?jal torna con un nuovo spettacolo che combina personaggi ancora più folli e situazioni ancora più folli!"
    ],
    "fr": [
      "« Après deux shows à guichets fermés, plus de 200 représentations et des milliers de spectateurs, D’jal est de retour avec un nouveau spectacle mêlant personnages toujours plus dingues et situations encore plus folles !"
    ],
    "es": [
      "\"Tras dos funciones con entradas agotadas, más de 200 representaciones y miles de espectadores, D?jal vuelve con un nuevo espectáculo que combina personajes aún más locos y situaciones aún más disparatadas"
    ],
    "nl": [
      "\"Na twee uitverkochte shows, meer dan 200 voorstellingen en duizenden toeschouwers is D?jal terug met een nieuwe show met nog gekkere personages en nog gekkere situaties!"
    ]
  },
  "rdfs:label": {
    "fr": [
