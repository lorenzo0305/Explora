  "rdfs:comment": {
    "de": [
      "Im Herzen unseres schönen Dorfes gelegen, finden Sie hier Kleidung für Männer, Frauen und Kinder, Möbel, Gegenstände, Geschirr, aber auch Accessoires und kleinen Schmuck."
    ],
    "en": [
      "Nestled in the heart of our beautiful village, you'll find ready-to-wear for men, women and children, as well as furniture, objects, crockery, accessories and small items of jewelry."
    ],
    "it": [
      "Nel cuore del nostro bellissimo villaggio, troverete capi d'abbigliamento per uomo, donna e bambino, oltre a mobili, oggetti, stoviglie, accessori e piccoli gioielli."
    ],
    "fr": [
      "Niché au cœur de notre beau village, vous y trouverez du prêt à porter pour hommes, femmes et enfants , des meubles, des objets,  de la vaisselle, mais également des accessoires et petits bijoux."
    ],
    "nl": [
      "Genesteld in het hart van ons mooie dorp, vind je confectiekleding voor mannen, vrouwen en kinderen, maar ook meubels, voorwerpen, serviesgoed, accessoires en kleine sieraden."
    ],
    "es": [
      "En el corazón de nuestro hermoso pueblo, encontrará prêt-à-porter para hombre, mujer y niño, así como muebles, objetos, vajillas, accesorios y pequeñas joyas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique La Chouette"
    ]
  },
