  "rdfs:comment": {
    "de": [
      "Der Orientierungstisch von Rochefort-Samson befindet sich in der Nähe der Ruinen des Schlosses von Rochefort auf dem Berg über dem Dorf."
    ],
    "en": [
      "The Rochefort-Samson orientation table is located near the ruins of Rochefort castle, on the mountain overlooking the village."
    ],
    "it": [
      "Il tavolo di orientamento di Rochefort-Samson si trova vicino alle rovine del castello di Rochefort, sulla montagna che domina il villaggio."
    ],
    "fr": [
      "La table d'orientation de Rochefort-Samson se situe près des ruines du château de Rochefort, sur la montagne qui surplombe le village."
    ],
    "es": [
      "La mesa de orientación de Rochefort-Samson se encuentra cerca de las ruinas del castillo de Rochefort, en la montaña que domina el pueblo."
    ],
    "nl": [
      "De oriëntatietafel van Rochefort-Samson bevindt zich bij de ruïnes van het kasteel van Rochefort, op de berg die over het dorp uitkijkt."
    ]
