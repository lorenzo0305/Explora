  "rdfs:comment": {
    "de": [
      "Restaurant mit herzlicher Atmosphäre und einer einfachen und leckeren Küche, die aus guten Produkten von nicht allzu weit her besteht. Für eine entspannte und gesellige Essenspause."
    ],
    "en": [
      "A restaurant with a warm atmosphere, serving simple, gourmet cuisine made with good, local produce. For a relaxed and convivial meal."
    ],
    "it": [
      "Un ristorante dall'atmosfera accogliente, che propone una cucina semplice e gourmet a base di buoni prodotti locali. Per un pasto rilassato e conviviale."
    ],
    "fr": [
      "Restaurant à l'humeur chaleureuse, avec une cuisine simple et gourmande, composée de bons petits produits de pas très loin. Pour une pause repas détendue et conviviale."
    ],
    "es": [
      "Restaurante de ambiente cálido, cocina sencilla y gastronómica elaborada con productos locales de calidad. Para una comida relajada y distendida."
    ],
    "nl": [
      "Een restaurant met een warme sfeer, waar eenvoudige, gastronomische gerechten worden geserveerd, bereid met goede, lokale producten. Voor een ontspannen en gezellige maaltijd."
    ]
  },
