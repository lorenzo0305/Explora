  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Roch in Montrond-les-Bains ist im romanischen Stil erbaut. Es handelt sich um die ehemalige Schlosskapelle, die im 12. und 15. Jahrhundert erbaut wurde."
    ],
    "en": [
      "The Roman style Saint Roch church in Montrond-les-Bains was formerly the Château’s chapel and was built in the 12th and 15th centuries."
    ],
    "it": [
      "La chiesa di Saint-Roch a Montrond-les-Bains è romanica. Si tratta dell'antica cappella del castello, costruita tra il XII e il XV secolo."
    ],
    "fr": [
      "L'église Saint-Roch de Montrond-les-Bains est de style roman. Il s'agit de l'ancienne chapelle du Château, construite aux XIIème et XVème siècles."
    ],
    "es": [
      "La iglesia de Saint-Roch en Montrond-les-Bains es románica. Es la antigua capilla del castillo, construida en los siglos XII y XV."
    ],
    "nl": [
      "De kerk Saint-Roch in Montrond-les-Bains is Romaans. Het is de voormalige kapel van het kasteel, gebouwd in de 12e en 15e eeuw."
    ]
