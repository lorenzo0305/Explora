  "rdfs:comment": {
    "de": [
      "Plic ploc, splash, plouf! Regentropfen fallen, der Fluss fließt und die Wellen brechen sich an der Küste. Folgen wir dem Lauf des Wassers auf einer Wasserreise!"
    ],
    "en": [
      "Plic ploc, splash, plouf! The raindrops fall, the river flows, the waves break on the shore. Let's follow the course of the water for an aquatic journey!"
    ],
    "it": [
      "Plic ploc, splash, plouf! Le gocce di pioggia cadono, il fiume scorre, le onde si infrangono sulla riva. Seguiamo il corso dell'acqua per un viaggio acquatico!"
    ],
    "fr": [
      "Plic ploc, splash, plouf ! Les gouttes de pluie tombent, la rivière coule, les vagues se brisent sur la côte. Suivons le cours de l’eau pour un voyage aquatique !"
    ],
    "es": [
      "¡Plic ploc, splash, plouf! Las gotas de lluvia caen, el río fluye, las olas rompen en la orilla. ¡Sigamos el curso del agua en un viaje acuático!"
    ],
    "nl": [
      "Plic ploc, splash, plouf! De regendruppels vallen, de rivier stroomt, de golven breken op de kust. Laten we de loop van het water volgen voor een waterreis!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier \"bébé au musée\" : Au fil de l'eau"
    ]
  },
