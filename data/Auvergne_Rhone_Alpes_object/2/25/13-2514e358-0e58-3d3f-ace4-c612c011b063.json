  "rdfs:comment": {
    "de": [
      "Azérat: Ehemaliges Priorat aus dem 12. Jahrhundert mit Wandmalereien. Mineralwasserquelle in Clémensat. Kapelle Sainte Bonnette in Allevier. Bannofen in Lindes und Allevier. Brunnen - Abreuvoirs in Rigoux, Chausse und Allevier."
    ],
    "en": [
      "Azérat: Former 12th-century priory. 12th-century church with murals. Mineral spring at Clémensat. Sainte Bonnette chapel in Allevier. Communal oven in Lindes and Allevier. Fountains and drinking troughs at Rigoux, Chausse and Allevier."
    ],
    "it": [
      "Azérat: ex priorato del XII secolo. Chiesa del XII secolo con dipinti murali. Sorgente minerale di Clémensat. Cappella di Sainte Bonnette ad Allevier. Forno comune a Lindes e Allevier. Fontane e abbeveratoi a Rigoux, Chausse e Allevier."
    ],
    "fr": [
      "Azérat : Ancien prieuré du XIIe siècle. Église du XIIe siècle avec peintures murales. Source d’eau minérale à Clémensat. Chapelle Sainte Bonnette à Allevier. Four banal à Lindes et Allevier. Fontaines - abreuvoirs à Rigoux, à Chausse et à Allevier."
    ],
    "nl": [
      "Azérat: Voormalige priorij uit de 12e eeuw. Kerk uit de 12e eeuw met muurschilderingen. Minerale bron in Clémensat. Sainte Bonnette kapel in Allevier. Gemeenschappelijke oven in Lindes en Allevier. Fonteinen en drinkbakken in Rigoux, Chausse en Allevier."
    ],
    "es": [
      "Azérat: Antiguo priorato del siglo XII. Iglesia del siglo XII con pinturas murales. Manantial de Clémensat. Capilla Sainte Bonnette en Allevier. Hornos comunales en Lindes y Allevier. Fuentes y abrevaderos de Rigoux, Chausse y Allevier."
    ]
  },
  "rdfs:label": {
