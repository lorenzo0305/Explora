  "rdfs:comment": {
    "de": [
      "Die Teiche des Sägewerks stehen Campern zur Verfügung, aber auch Familien, Gruppen, Vereinen und Betriebsräten, die sich einen entspannenden Tag gönnen möchten."
    ],
    "en": [
      "The sawmill ponds are available not only to campers, but also to families, groups, associations and works councils looking for a relaxing day out."
    ],
    "it": [
      "I laghetti della segheria sono a disposizione di campeggiatori, famiglie, gruppi, associazioni e comitati aziendali in cerca di una giornata di relax."
    ],
    "fr": [
      "Les étangs de la scierie sont à la disposition des campeurs mais également aux familles, groupes, associations, comités d'entreprises désireux de s'offrir une journée de détente."
    ],
    "es": [
      "Los estanques del aserradero están a disposición de los campistas, así como de familias, grupos, asociaciones y comités de empresa que busquen pasar un día relajado."
    ],
    "nl": [
      "De zagerijvijvers zijn beschikbaar voor kampeerders en gezinnen, groepen, verenigingen en ondernemingsraden die op zoek zijn naar een ontspannen dagje uit."
    ]
  },
