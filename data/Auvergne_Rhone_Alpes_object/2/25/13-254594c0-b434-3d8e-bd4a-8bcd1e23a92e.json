  "rdfs:comment": {
    "de": [
      "Unser Kollektiv hat sich zum Ziel gesetzt, das lokale Kunsthandwerk zu fördern. Sie finden uns in der Rue Mathieu-de-la-Drôme 7 in einem Geschäft, das aus einem Stoff- und Kurzwarenbereich und einem Designerbereich besteht. Wir bieten auch kreative Workshops an."
    ],
    "en": [
      "The aim of our collective is to promote local craftsmanship. You can find us at 7 Rue Mathieu-de-la-Drôme in a shop that consists of a fabric and haberdashery section and a designers' section. We also offer creative workshops."
    ],
    "it": [
      "L'obiettivo del nostro collettivo è quello di promuovere l'artigianato locale. Ci trovate al numero 7 di rue Mathieu-de-la-Drôme in un negozio che comprende un'area tessuti e merceria e un'area designer. Offriamo anche laboratori creativi."
    ],
    "fr": [
      "Notre Collectif à pour but de promouvoir l'artisanat local. Vous pouvez nous retrouver au 7 rue Mathieu-de-la-Drôme dans une boutique qui se compose d'un espace tissus et mercerie, et d'un espace créateurs. Nous proposons également des ateliers créatifs."
    ],
    "nl": [
      "Het doel van ons collectief is het promoten van lokale ambachten. Je kunt ons vinden op 7 rue Mathieu-de-la-Drôme in een winkel met een stoffen- en fourniturenafdeling en een ontwerpafdeling. We bieden ook creatieve workshops aan."
    ],
    "es": [
      "El objetivo de nuestro colectivo es promover la artesanía local. Nos encontrará en el número 7 de la calle Mathieu-de-la-Drôme, en una tienda que incluye una zona de tejidos y mercería, y otra de diseño. También ofrecemos talleres creativos."
    ]
  },
