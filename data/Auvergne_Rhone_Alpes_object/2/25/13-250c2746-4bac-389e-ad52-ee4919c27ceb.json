  "rdfs:comment": {
    "de": [
      "Noël Martin ist seit 1968 Winzer und produziert die Landweine IGP Isère Balmes Dauphinoises.\r\nDie Qualität und Authentizität seiner Produktion hat ihm mehrere Auszeichnungen eingebracht, wie den Concours Général Agricole de Paris und Effervescents du Monde."
    ],
    "en": [
      "A winegrower since 1968, Noël Martin produces vins de pays IGP Isère Balmes Dauphinoises.\r\nThe quality and authenticity of his production have won him a number of awards, including the Concours Général Agricole de Paris and Effervescents du Monde."
    ],
    "it": [
      "Viticoltore dal 1968, Noël Martin produce vins de pays IGP Isère Balmes Dauphinoises.\r\nLa qualità e l'autenticità della sua produzione gli sono valse diversi riconoscimenti, tra cui il Concours Général Agricole de Paris e l'Effervescents du Monde."
    ],
    "fr": [
      "Viticulteur depuis 1968, Noël Martin produit des vins de pays IGP Isère Balmes Dauphinoises.\r\nLa qualité et l’authenticité de sa production lui valent plusieurs récompenses, tels que les concours Général Agricole de Paris et Effervescents du Monde."
    ],
    "es": [
      "Viticultor desde 1968, Noël Martin produce vins de pays IGP Isère Balmes Dauphinoises.\r\nLa calidad y autenticidad de su producción le han valido varios premios, entre ellos el Concours Général Agricole de Paris y Effervescents du Monde."
    ],
    "nl": [
      "Noël Martin is wijnbouwer sinds 1968 en produceert IGP Isère Balmes Dauphinoises vins de pays.\r\nDe kwaliteit en authenticiteit van zijn productie hebben hem verschillende prijzen opgeleverd, waaronder het Concours Général Agricole de Paris en Effervescents du Monde."
    ]
  },
