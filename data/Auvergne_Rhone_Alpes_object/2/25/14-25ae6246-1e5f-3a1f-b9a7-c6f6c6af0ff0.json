  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d8c86a30-a68e-3883-ad57-bd7e4ad9a48c",
      "dc:description": {
        "de": [
          "Von den Barsiers Portelois von 9 bis 12 Uhr und von 14 bis 17 Uhr\nHochseefischen an Bord eines Flobarts, eines typischen Bootes der Côte d'Opale\nPreis: 15 ? für den 1/2 Tag\nAnmeldungen unter 03 91 90 14 00"
        ],
        "en": [
          "By Les Barsiers Portelois 9am to 12pm and 2pm to 5pm\nSea fishing aboard a flobart, a typical Opal Coast boat\nPrice: 15? for 1/2 day\nTo register, call 03 91 90 14 00"
        ],
        "it": [
          "Presso i Barsiers Portelois dalle 9.00 alle 12.00 e dalle 14.00 alle 17.00\nPesca in mare a bordo di un flobart, tipica imbarcazione della Costa d'Opale\nPrezzo: 15? per 1/2 giornata\nPer iscriversi, chiamare il numero 03 91 90 14 00"
        ],
        "fr": [
          "Par les Barsiers Portelois de 9h à 12h et de 14h à 17h\nPêche en mer à bord d'un flobart, bateau typique de la Côte d'Opale\nTarif : 15 € la 1/2 journée\nInscriptions au 03 91 90 14 00"
        ],
        "es": [
          "Por los Barsiers Portelois de 9h a 12h y de 14h a 17h\nPesca en el mar a bordo de un flobart, barco típico de la Costa de Ópalo\nPrecio: 15? por 1/2 día\nPara inscribirse, llame al 03 91 90 14 00"
        ],
        "nl": [
          "Door de Portelois Barsiers van 9u tot 12u en van 14u tot 17u\nZeevissen aan boord van een flobart, een typische boot van de Opaalkust\nPrijs: 15? voor 1/2 dag\nOm in te schrijven, bel 03 91 90 14 00"
        ]
      },
      "@type": [
        "Description"
      ],
