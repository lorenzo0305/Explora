  "rdfs:comment": {
    "de": [
      "Küche von Chefköchen in einer Mühle mit funktionierendem Rad und Terrasse am Ufer des Garon. Traditionelle Gerichte oder neue Küche, unsere Speisekarte wird mit saisonalen Produkten angeboten."
    ],
    "en": [
      "Fine dining in a mill with working wheel and terrace on the banks of the Garon."
    ],
    "it": [
      "Cucina da chef in un mulino con ruota funzionante e terrazza sulle rive del Garon. Piatti tradizionali o nuova cucina, il nostro menu si basa sui prodotti di stagione."
    ],
    "fr": [
      "Cuisine de chefs dans un moulin avec sa roue en activité et sa terrasse au bord du Garon. Plats traditionnels ou nouvelle cuisine, notre carte est proposée avec les produits de saison."
    ],
    "es": [
      "Cocina de chefs en un molino con rueda en funcionamiento y terraza a orillas del Garón. Platos tradicionales o nueva cocina, nuestra carta se basa en productos de temporada."
    ],
    "nl": [
      "Chef-kokskeuken in een molen met draaiend rad en terras aan de oever van de Garon. Traditionele gerechten of een nieuwe keuken, onze kaart is gebaseerd op seizoensproducten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Petit Meunier"
    ],
