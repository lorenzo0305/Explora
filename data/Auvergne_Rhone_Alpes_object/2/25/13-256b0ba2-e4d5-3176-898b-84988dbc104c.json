  "rdfs:comment": {
    "de": [
      "Routengebiet mit einer interessanten Länge für seine Routen von 6a bis 6c, von 7a bis 7c und ab 8a.\r\nOrientierung(en) : W Höhe am Fuß der Routen : 900 m\r\nAnmarsch: 1 Minute auf ebenem Gelände."
    ],
    "en": [
      "An interesting route site with routes from 6a to 6c, from 7a to 7c and from 8a upwards.\r\nFacing: W Altitude at foot of routes: 900 m\r\nApproach walk: 1 min on flat ground."
    ],
    "it": [
      "Un sito con vie di lunghezza interessante, dal 6a al 6c, dal 7a al 7c e dall'8a in su.\r\nEsposizione: W Altitudine ai piedi delle vie: 900 m\r\nCammino di avvicinamento: 1 min su terreno pianeggiante."
    ],
    "fr": [
      "Site de voies d'une longueur intéressant pour ses voies du 6a au 6c, du 7a au 7c et à partir du 8a .\r\nOrientation(s) : W     Altitude au pied des voies : 900 m\r\nMarche d'approche : 1 min sur du plat."
    ],
    "es": [
      "Un sitio con rutas de una longitud interesante, de 6a a 6c, de 7a a 7c y de 8a en adelante.\r\nOrientación: W Altitud al pie de las vías: 900 m\r\nPaseo de aproximación: 1 min en terreno llano."
    ],
    "nl": [
      "Een site met routes van een interessante lengte, van 6a tot 6c, 7a tot 7c en vanaf 8a.\r\nGeometrie: W Hoogte aan de voet van de routes: 900 m\r\nAanloop: 1 min. op vlak terrein."
    ]
