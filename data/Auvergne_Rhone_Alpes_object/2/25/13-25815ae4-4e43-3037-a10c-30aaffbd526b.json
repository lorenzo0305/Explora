  "rdfs:comment": {
    "de": [
      "Knecht Ruprecht, Väterchen Frost, Nussknacker und Weihnachtsfrau öffnen Ihnen die Tore des Großen Weihnachtsparks. Besuche und Begegnungen mit den Figuren und garantierter Spaß mit der Öko-Eisbahn und dem größten Baumlabyrinth."
    ],
    "en": [
      "Père Fouettard, Père Gourmand, the Nutcracker and Mother Christmas open the gates to the Grand Parc de Noël. Visits and encounters with the characters and guaranteed fun with the ecological ice rink and the biggest tree maze."
    ],
    "it": [
      "Père Fouettard, Père Gourmand, lo Schiaccianoci e Mamma Natale aprono le porte del Grande Parco di Natale. Visitate e incontrate i personaggi, godetevi la pista di ghiaccio ecologica e il più grande labirinto di alberi."
    ],
    "fr": [
      "Père Fouettard, Père Gourmand, Casse-noisettes et Mère Noël vous ouvrent les portes du Grand Parc de Noël. Visites et rencontres avec les personnages et amusement garanti avec la patinoire écologique et le plus grand labyrinthe dans les arbres."
    ],
    "es": [
      "Père Fouettard, Père Gourmand, el Cascanueces y Mamá Noel abren las puertas del Gran Parque de Navidad. Visite y conozca a los personajes, y disfrute de la pista de hielo ecológica y del mayor laberinto de árboles."
    ],
    "nl": [
      "Père Fouettard, Père Gourmand, de Notenkraker en Moeder Kerstmis openen de poorten van het Grote Kerstpark. Bezoek en ontmoet de personages en geniet van de ecologische ijsbaan en het grootste boomdoolhof."
    ]
  },
