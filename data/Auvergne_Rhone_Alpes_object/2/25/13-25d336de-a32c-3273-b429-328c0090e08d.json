  "rdfs:comment": {
    "de": [
      "Ein Geschäft in Tauves, in dem 70 Kunsthandwerker aus der Region ausstellen.\r\nSie bieten kunsthandwerkliche Gegenstände an, die das Ergebnis ihrer Arbeit sind und aus edlen Materialien hergestellt wurden: Holz, Glas, Pappe, Leder, Textilien, Metall, Wolle, Lava..."
    ],
    "en": [
      "A boutique in Tauves, where 70 local artisans exhibit their work.\r\nThey offer handcrafted objects, the fruits of their labor, made from noble materials: wood, glass, cardboard, leather, textiles, metal, wool, lava..."
    ],
    "it": [
      "Un negozio a Tauves, dove 70 artigiani della regione espongono i loro lavori.\r\nPropongono oggetti artigianali, frutto del loro lavoro, realizzati con materiali nobili: legno, vetro, cartone, cuoio, tessuti, metallo, lana, lava..."
    ],
    "fr": [
      "Une boutique à Tauves, dans laquelle 70 artisans de la région exposent.\r\nIls proposent des objets artisanaux, fruits de leur travail, réalisés avec des matières nobles : bois, verre, carton, cuir, textile, métal,  laine, lave..."
    ],
    "es": [
      "Una tienda en Tauves, donde 70 artesanos de la región exponen su trabajo.\r\nOfrecen objetos artesanales, fruto de su trabajo, elaborados con materiales nobles: madera, vidrio, cartón, cuero, tejidos, metal, lana, lava..."
    ],
    "nl": [
      "Een winkel in Tauves waar 70 ambachtslieden uit de regio hun werk tentoonstellen.\r\nZe bieden handgemaakte voorwerpen, de vruchten van hun arbeid, gemaakt van edele materialen: hout, glas, karton, leer, textiel, metaal, wol, lava..."
    ]
  },
