  "rdfs:comment": {
    "de": [
      "200m2 großes Wellnesszentrum mit privatem Spa und japanischer Sauna.\r\nIndividuelle Massagen, Rituale und Schönheitsbehandlungen werden von einem Team aus sieben qualifizierten Fachkräften durchgeführt, die auf Ihre Bedürfnisse eingehen. Eine kokonartige Auszeit"
    ],
    "en": [
      "A space of relaxation and esthetics where a team of qualified professionals listens and advises to you among a multitude of care. Take advantage of a moment of relaxation in good hands..."
    ],
    "it": [
      "Centro benessere di 200 m2 con spa privata e sauna giapponese.\r\nMassaggi personalizzati, rituali e trattamenti di bellezza eseguiti da un team di 7 professionisti qualificati, attenti alle vostre esigenze. Una parentesi di benessere"
    ],
    "fr": [
      "Centre de Bien être de 200m2 , avec spa privatisé et sauna japonais .\r\nDes massages personnalisés, des rituels  et soins esthétiques réalisés par une équipe de 7 professionnelles qualifiées, à l'écoute de vos besoins. Une  parenthèse cocooning"
    ],
    "nl": [
      "Wellnesscentrum van 200 m2 met privéspa en Japanse sauna.\r\nPersoonlijke massages, rituelen en schoonheidsbehandelingen uitgevoerd door een team van 7 gekwalificeerde professionals, met aandacht voor jouw behoeften. Een cocooning intermezzo"
    ],
    "es": [
      "Centro de bienestar de 200 m2 con spa privado y sauna japonesa.\r\nMasajes personalizados, rituales y tratamientos de belleza realizados por un equipo de 7 profesionales cualificados, atentos a sus necesidades. Un paréntesis relajante"
    ]
  },
