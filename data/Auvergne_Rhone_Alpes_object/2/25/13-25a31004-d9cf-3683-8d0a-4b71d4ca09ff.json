  "rdfs:comment": {
    "de": [
      "Ein Tag voller Herausforderungen, Natur, Kurzatmigkeit und einem breiten Lächeln.\r\nDie BAD?IN TOUR feiert ihr 10-jähriges Bestehen ? und das wird mit Bewegung gefeiert! Auf dem Programm stehen Wanderungen, Mountainbiketouren oder Trails."
    ],
    "en": [
      "A day of challenges, nature, shortness of breath? and broad smiles.\r\nThe BAD?IN TOUR is celebrating its 10th anniversary? and it's all about movement! On the program: hiking, mountain biking or trail running."
    ],
    "it": [
      "Una giornata di sfide, natura, fiato corto e grandi sorrisi.\r\nIl BAD?IN TOUR festeggia il suo 10° anniversario e lo fa in movimento! In programma: escursioni, mountain bike o trail running."
    ],
    "fr": [
      "Une journée de défis, de nature, de souffle court… et de sourires larges.\r\nLe BAD’IN TOUR fête ses 10 ans – et ça se célèbre en mouvement! Au programme: rando, VTT ou trail."
    ],
    "es": [
      "Un día de desafíos, naturaleza, respiración entrecortada... y amplias sonrisas.\r\nEl BAD?IN TOUR celebra su 10º aniversario... ¡y lo celebra en movimiento! En el programa: senderismo, bicicleta de montaña o trail running."
    ],
    "nl": [
      "Een dag vol uitdagingen, natuur, kortademigheid? en brede glimlachen.\r\nDe BAD?IN TOUR viert zijn 10e verjaardag? en viert feest in beweging! Op het programma: wandelen, mountainbiken of trailrunning."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bad in tour : randonnée pédestre et VTT, trail"
    ]
  },
