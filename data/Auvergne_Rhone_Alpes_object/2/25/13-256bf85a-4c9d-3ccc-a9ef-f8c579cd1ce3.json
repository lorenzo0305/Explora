  "rdfs:comment": {
    "de": [
      "Entdecken Sie das La Maison du Portail Rouge, ein gemütliches und geselliges Restaurant. Unser Küchenteam hat alle Gerichte mit dem Ziel zusammengestellt, Ihnen frische Produkte mit einem Hauch von Modernität zu präsentieren."
    ],
    "en": [
      "Come and discover La Maison du Portail Rouge, a warm and friendly restaurant. Our kitchen team has created all our dishes with the aim of introducing you to fresh produce with a modern touch."
    ],
    "it": [
      "Venite a scoprire La Maison du Portail Rouge, un ristorante caldo e accogliente. Il nostro team di cucina ha creato tutti i piatti con l'obiettivo di farvi conoscere prodotti freschi con un tocco moderno."
    ],
    "fr": [
      "Venez découvrir La Maison du Portail Rouge, un restaurant chaleureux et convivial. Notre équipe en cuisine a élaboré l’ensemble des plats avec l’envie de vous faire découvrir des produits frais avec une touche de modernité."
    ],
    "es": [
      "Venga a descubrir La Maison du Portail Rouge, un restaurante cálido y acogedor. Nuestro equipo de cocina ha creado todos los platos con el objetivo de presentarle productos frescos con un toque moderno."
    ],
    "nl": [
      "Kom La Maison du Portail Rouge ontdekken, een warm en gezellig restaurant. Ons keukenteam heeft alle gerechten gecreëerd met als doel u kennis te laten maken met verse producten met een moderne touch."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Maison du Portail Rouge"
    ]
  },
