  "rdfs:comment": {
    "de": [
      "Das Museum, das auf 250 Jahre Geschichte zurückblickt, zeigt eine Sammlung von Materialien, Kleidung, Helmen und Fahrzeugen, die von den Feuerwehrleuten der Rhône und Frankreichs (aber nicht nur!) verwendet wurden, und bietet jährlich wechselnde Sonderausstellungen."
    ],
    "en": [
      "Tracing 250 years of history, the museum presents a collection of equipment, clothing, helmets and vehicles used by firefighters in the Rhône region and France (but not only!), and offers temporary exhibitions that are renewed every year."
    ],
    "it": [
      "Ripercorrendo 250 anni di storia, il museo presenta una collezione di attrezzature, abiti, elmetti e veicoli utilizzati dai vigili del fuoco del Rodano e della Francia (ma non solo!) e propone mostre temporanee che vengono rinnovate ogni anno."
    ],
    "fr": [
      "Retraçant 250 ans d’histoire, le musée présente une collection de matériels, habillements, casques, véhicules utilisés par les sapeurs-pompiers du Rhône et de France (mais pas seulement !) et propose des expositions temporaires renouvelées tous les ans."
    ],
    "nl": [
      "Het museum volgt 250 jaar geschiedenis en presenteert een collectie van uitrusting, kleding, helmen en voertuigen die gebruikt werden door de brandweer van de Rhône en Frankrijk (maar niet alleen!) en biedt tijdelijke tentoonstellingen die elk jaar worden vernieuwd."
    ],
    "es": [
      "A lo largo de 250 años de historia, el museo presenta una colección de equipos, indumentaria, cascos y vehículos utilizados por los cuerpos de bomberos del Ródano y de Francia (¡pero no sólo!) y ofrece exposiciones temporales que se renuevan cada año."
    ]
  },
  "rdfs:label": {
    "de": [
      "Feuerwehr Museum von Lyon Rhône"
    ],
    "en": [
      "Museum of firefighters of Lyon Rhône"
    ],
    "fr": [
      "Musée des Sapeurs Pompiers Lyon Rhône"
    ]
  },
