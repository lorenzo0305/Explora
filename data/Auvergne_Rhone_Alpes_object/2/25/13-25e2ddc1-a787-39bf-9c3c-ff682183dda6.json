  "rdfs:comment": {
    "de": [
      "La Passerelle ist sowohl ein Veranstaltungssaal als auch ein multimodaler Raum und beherbergt das ganze Jahr über die Kultursaison von Saint-Just Saint-Rambert sowie Veranstaltungen von Unternehmen und Vereinen."
    ],
    "en": [
      "Both a performance venue and multimodal space, La Passerelle hosts Saint-Just Saint-Rambert?s cultural season, as well as professional and associative events throughout the year."
    ],
    "it": [
      "Luogo di spettacolo e spazio multimodale, La Passerelle ospita la stagione culturale di Saint-Just Saint-Rambert ed eventi professionali e comunitari durante tutto l'anno."
    ],
    "fr": [
      "À la fois salle de spectacle et espace multimodal, La Passerelle accueille la saison culturelle de Saint-Just Saint-Rambert ainsi que des événements professionnels et associatifs tout au long de l’année."
    ],
    "nl": [
      "La Passerelle is zowel een podium als een multimodale ruimte waar het culturele seizoen van Saint-Just Saint-Rambert plaatsvindt en waar het hele jaar door professionele en gemeenschapsevenementen plaatsvinden."
    ],
    "es": [
      "A la vez lugar de espectáculos y espacio multimodal, La Passerelle acoge la temporada cultural de Saint-Just Saint-Rambert, así como actos profesionales y comunitarios a lo largo de todo el año."
    ]
  },
