  "rdfs:comment": {
    "de": [
      "Kleines charmantes 3-Sterne-Hotel-Restaurant mit Terrasse im Herzen des alten Dorfes Gresse-en-Vercors.\r\nIm Sommer Ausgangspunkt für zahlreiche Wanderungen und im Winter sehr gut gelegen, um von der alpinen und nordischen Skistation zu profitieren."
    ],
    "en": [
      "Charming 3-star hotel-bistro-grocery in the heart of the old village of Gresse-en-Vercors.\r\nStarting point for numerous hikes in summer, and ideally placed to take advantage of the Alpine and Nordic ski resorts in winter."
    ],
    "it": [
      "Incantevole hotel-ristorante a 3 stelle con terrazza nel cuore dell'antico villaggio di Gresse-en-Vercors.\r\nÈ il punto di partenza per numerose escursioni in estate e ben posizionato per approfittare delle stazioni sciistiche alpine e nordiche in inverno."
    ],
    "fr": [
      "Petit hôtel-restaurant de charme 3 étoiles avec terrasse en plein cœur du vieux village de Gresse-en-Vercors.\r\nPoint de départ de nombreuses randonnées l'été et très bien placé pour profiter de la station de skis alpins et nordiques l'hiver."
    ],
    "es": [
      "Encantador hotel-restaurante de 3 estrellas con terraza en el corazón del antiguo pueblo de Gresse-en-Vercors.\r\nEs el punto de partida de numerosas excursiones en verano y está bien situado para aprovechar las estaciones de esquí alpino y nórdico en invierno."
    ],
    "nl": [
      "Charmant 3-sterrenhotel-restaurant met terras in het hart van het oude dorp Gresse-en-Vercors.\r\nHet is het startpunt voor talrijke wandelingen in de zomer en goed gelegen om te profiteren van de Alpine en Nordic skigebieden in de winter."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge Buissonnière"
    ]
  },
