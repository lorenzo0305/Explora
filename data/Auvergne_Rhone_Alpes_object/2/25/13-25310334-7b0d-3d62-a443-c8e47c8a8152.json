  "rdfs:comment": {
    "de": [
      "Erleben Sie die Freuden des Wassers in einer geselligen Umgebung und nutzen Sie die verschiedenen Bereiche. Das Schwimmbad in Voiron bietet ein Innenbecken und einen Wasserspaßbereich im Freien, der aus einem Spielplatz mit 12 Modulen besteht und allen Spaß macht."
    ],
    "en": [
      "Come experience the joys of water in a friendly environment, enjoying the various spaces. The Voiron swimming pool offers an indoor pool and an outdoor water play area with a 12-module play area, for everyone's enjoyment."
    ],
    "it": [
      "Venite a godere dei piaceri dell'acqua in un ambiente amichevole, approfittando delle diverse aree. La piscina Voiron dispone di una vasca interna e di un'area acquatica esterna con un parco giochi di 12 moduli per il divertimento di tutti."
    ],
    "fr": [
      "Venez goûter aux plaisirs de l'eau dans un environnement convivial, en profitant des différents espaces. La piscine de Voiron offre un bassin intérieur et un espace aqualudique extérieur composé d'une aire de jeux de 12 modules, pour le plaisir de tous."
    ],
    "es": [
      "Venga a disfrutar de los placeres del agua en un entorno agradable, aprovechando las diferentes zonas. La piscina de Voiron cuenta con una piscina cubierta y una zona acuática exterior con un parque infantil de 12 módulos para disfrute de todos."
    ],
    "nl": [
      "Kom genieten van de geneugten van water in een vriendelijke omgeving en maak gebruik van de verschillende zones. Het zwembad van Voiron heeft een binnenzwembad en een buitenzwembad met een speeltuin met 12 modules waar iedereen van kan genieten."
    ]
  },
