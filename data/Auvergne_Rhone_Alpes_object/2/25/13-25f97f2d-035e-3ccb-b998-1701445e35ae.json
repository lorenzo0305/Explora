  "rdfs:comment": {
    "de": [
      "Lyon-Dégustation ist eine önologische Eventagentur. Sie richtet sich sowohl an Unternehmen als auch an Privatpersonen, die sich in die Freuden der Weinprobe einführen lassen oder ihre önologischen Kenntnisse perfektionieren möchten."
    ],
    "en": [
      "Lyon-Dégustation is an oenological event agency. It is aimed at both companies and individuals who wish to learn about the pleasures of wine tasting or to perfect their oenological knowledge."
    ],
    "it": [
      "Lyon-Dégustation è un'agenzia di eventi tecnologici. Si rivolge sia alle aziende che ai privati che desiderano conoscere i piaceri della degustazione o migliorare la propria conoscenza del vino."
    ],
    "fr": [
      "Lyon-Dégustation est une agence événementielle œnologique. Elle s'adresse autant aux entreprises qu'aux particuliers qui désirent s'initier aux plaisirs de la dégustation ou perfectionner leurs connaissances œnologiques."
    ],
    "nl": [
      "Lyon-Dégustation is een agentschap voor wijnevenementen. Het is bedoeld voor zowel bedrijven als particulieren die het plezier van wijnproeven willen leren kennen of hun kennis over wijn willen verbeteren."
    ],
    "es": [
      "Lyon-Dégustation es una agencia de eventos tecnológicos. Está dirigido tanto a empresas como a particulares que deseen conocer los placeres de la cata de vinos o mejorar sus conocimientos sobre el vino."
    ]
  },
