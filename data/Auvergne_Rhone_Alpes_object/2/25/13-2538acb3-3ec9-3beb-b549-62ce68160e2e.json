  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Restaurant AVANTI, einen einzigartigen Ort, an dem sich italienische Lebensart mit französischen kulinarischen Traditionen vermischt. Ob für ein festliches Essen oder eine geschäftliche Veranstaltung, genießen Sie eine echte Reise ins Herz der Alpen! Offen für alle."
    ],
    "en": [
      "Discover Avanti, a unique venue at the hotel Le Saint Gervais, where Italian art de vivre meets French culinary tradition."
    ],
    "it": [
      "Scoprite il ristorante AVANTI, un luogo unico dove l'arte di vivere italiana si fonde con le tradizioni culinarie francesi. Per un pasto festivo o un evento di lavoro, venite a godervi un vero e proprio viaggio nel cuore delle Alpi! Aperto a tutti."
    ],
    "fr": [
      "Découvrez le restaurant AVANTI, un lieu unique où l’art de vivre italien se mêle aux traditions culinaires françaises. Pour un repas festif ou un évènement professionnel, venez profiter d’un véritable voyage au cœur des Alpes ! Ouvert à tous."
    ],
    "nl": [
      "Ontdek restaurant AVANTI, een unieke plek waar de Italiaanse levenskunst zich vermengt met Franse culinaire tradities. Voor een feestelijke maaltijd of een zakelijk evenement, kom en geniet van een echte reis naar het hart van de Alpen! Voor iedereen toegankelijk."
    ],
    "es": [
      "Descubra el restaurante AVANTI, un lugar único donde el arte de vivir italiano se funde con las tradiciones culinarias francesas. Para una comida festiva o un evento de negocios, ¡venga a disfrutar de un auténtico viaje al corazón de los Alpes! Abierto a todos."
    ]
  },
