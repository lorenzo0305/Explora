      "dc:description": {
        "de": [
          "Verbringen Sie einen Abend, an dem Sie zu polnischer Musik das Tanzbein schwingen und eine schöne Atmosphäre genießen können."
        ],
        "en": [
          "Come and spend an evening swaying to Polish music and enjoying the great atmosphere."
        ],
        "it": [
          "Venite a trascorrere una serata ondeggiando al ritmo della musica polacca e godendovi la grande atmosfera."
        ],
        "fr": [
          "Venez passer une soirée à vous déhancher sur des musiques polonaises tout en profitant d'une belle ambiance."
        ],
        "es": [
          "Ven a pasar una velada al ritmo de la música polaca y disfruta del buen ambiente."
        ],
        "nl": [
          "Kom een avondje zwieren op Poolse muziek en geniet van de geweldige sfeer."
        ]
