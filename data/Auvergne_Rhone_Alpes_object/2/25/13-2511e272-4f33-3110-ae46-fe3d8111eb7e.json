  "rdfs:comment": {
    "de": [
      "Traditionelle, savoyische Küche, die von uns mit frischen, saisonalen Produkten zubereitet wird. Ein Panorama-Speisesaal und eine Sonnenterrasse erwarten Sie."
    ],
    "en": [
      "Traditional and savoyard cuisine made by ourselve with fresh and seasonal ingredients. A south facing terrace expects you on sunny days."
    ],
    "it": [
      "Cucina tradizionale e savoiarda, preparata da noi con prodotti freschi e di stagione. Vi attendono una sala da pranzo panoramica e una terrazza soleggiata."
    ],
    "fr": [
      "Cuisine traditionnelle et savoyarde, confectionnée par nos soins avec des produits frais et de saison. Une salle à manger panoramique et une terrasse au soleil vous attendent."
    ],
    "nl": [
      "Traditionele en Savoyaardse keuken, door ons bereid met verse en seizoensgebonden producten. Een panoramische eetkamer en een zonnig terras wachten op u."
    ],
    "es": [
      "Cocina tradicional y saboyana, preparada por nosotros con productos frescos y de temporada. Le esperan un comedor panorámico y una soleada terraza."
    ]
  },
