  "rdfs:comment": {
    "de": [
      "Spaziergänge, Besichtigungen und Wanderungen, begleitet und kommentiert von Anne Fimbel, Fremdenführerin für das grüne Beaujolais, Mitglied des Vereins Amis Guides en Terre Beaujolaise und Vermittlerin des Geoparks Beaujolais."
    ],
    "en": [
      "Visits, strolls or hikes for groups of 6 or more, with Anne Fimbel, guide of green Beaujolais."
    ],
    "it": [
      "Passeggiate guidate, tour ed escursioni con commento di Anne Fimbel, guida locale della regione del Beaujolais Vert, membro dell'Association des Amis Guides en Terre Beaujolaise e mediatrice del Beaujolais Geopark."
    ],
    "fr": [
      "Balades, visites et randonnées accompagnées et commentées par Anne Fimbel, guide de pays du Beaujolais vert, membre de l’association des Amis Guides en Terre Beaujolaise et médiatrice du Géoparc Beaujolais."
    ],
    "es": [
      "Paseos guiados, visitas y excursiones comentadas por Anne Fimbel, guía local de la región de Beaujolais Vert, miembro de la Association des Amis Guides en Terre Beaujolaise y mediadora del Geoparque de Beaujolais."
    ],
    "nl": [
      "Begeleide wandelingen, tochten en trektochten met commentaar door Anne Fimbel, een lokale gids in de Beaujolais Vert regio, lid van de Association des Amis Guides en Terre Beaujolaise en bemiddelaar voor het Beaujolais Geopark."
    ]
  },
  "rdfs:label": {
