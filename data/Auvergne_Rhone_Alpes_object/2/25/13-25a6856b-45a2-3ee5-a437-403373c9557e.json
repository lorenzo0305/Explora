  "rdfs:comment": {
    "de": [
      "Machen Sie sich bereit für Quizz Game Valence, das erste Quizspiel in Valence, bei dem Sie wirklich buzzern können, wie in einer Fernsehshow!\r\nUnsere Quizräume bieten Platz für 4 bis 12 Spieler pro Sitzung."
    ],
    "en": [
      "Get ready for Quizz Game Valence, the first quiz game in Valence where you can buzz for real, just like on a TV set!\r\nOur quiz rooms can accommodate from 4 to 12 players per session."
    ],
    "it": [
      "Preparatevi a Quizz Game Valence, il primo gioco a quiz di Valence dove si può giocare davvero, proprio come in TV!\r\nLe nostre sale quiz possono ospitare da 4 a 12 giocatori per sessione."
    ],
    "fr": [
      "Préparez-vous pour Quizz Game Valence, le premier quizz game à Valence où vous pourrez buzzer pour de vrai comme sur un plateau télé !\r\nNos salles de quiz peuvent accueillir de 4 à 12 joueurs par session."
    ],
    "es": [
      "Prepárese para Quizz Game Valence, el primer juego de preguntas y respuestas de Valence en el que podrá zumbar de verdad, ¡como en un plató de televisión!\r\nNuestras salas de quiz pueden acoger de 4 a 12 jugadores por sesión."
    ],
    "nl": [
      "Maak je klaar voor Quizz Game Valence, het eerste quizspel in Valence waar je echt kunt quizzen, net als op tv!\r\nOnze quizzalen zijn geschikt voor 4 tot 12 spelers per sessie."
    ]
  },
