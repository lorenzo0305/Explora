  "rdfs:comment": {
    "de": [
      "Sie befindet sich am Col du Jaillet und markierte zu Beginn unserer Zeitrechnung die Grenze zwischen den Ceutronen und den Viennois (Allobroger). Auf 1723 m Höhe symbolisiert sie die Provinzgrenze des Römischen Reiches. Sie wurde 1966 unter Denkmalschutz gestellt"
    ],
    "en": [
      "Situated on the Col du Jaillet, it marked the border between the Ceutrons and the Viennois (Allobroges) at the beginning of our era. At an altitude of 1723 m, it symbolizes the provincial boundary of the Roman Empire. It was listed in 1966"
    ],
    "it": [
      "Situato sul Col du Jaillet, segnava il confine tra i Ceutrons e i Viennois (Allobroges) all'inizio della nostra era. A 1723 m di altitudine, simboleggia il confine provinciale dell'Impero romano. È stato classificato nel 1966"
    ],
    "fr": [
      "Située au col du Jaillet, elle marquait au début de notre ère la frontière entre les Ceutrons et les Viennois (Allobroges). A 1723 m d'altitude, elle symbolise la limite de province de l'empire romain. Elle a été classée en 1966"
    ],
    "es": [
      "Situado en el puerto de Jaillet, marcaba la frontera entre los Ceutrones y los Viennois (Allobroges) a principios de nuestra era. A 1723 m de altitud, simboliza el límite de la provincia del Imperio Romano. Fue clasificado en 1966"
    ],
    "nl": [
      "Gelegen op de Col du Jaillet, markeerde het de grens tussen de Ceutrons en de Viennois (Allobroges) aan het begin van onze jaartelling. Op een hoogte van 1723 m symboliseert het de provinciegrens van het Romeinse Rijk. Het werd geklasseerd in 1966"
    ]
  },
  "rdfs:label": {
    "de": [
      "Der römische Grenzstein am Col du Jaillet und andere klassifizierte in Cordon"
    ],
    "en": [
      "The Roman milestone at Col du Jaillet and other classified monuments in Cordon"
    ],
    "it": [
      "La pietra miliare romana sul Col du Jaillet e altri monumenti classificati a Cordon"
    ],
    "fr": [
      "La borne romaine du Col du Jaillet et autres classées de Cordon"
    ],
    "es": [
      "La borne romaine du Col du Jaillet"
    ],
    "nl": [
      "De Romeinse mijlpaal op de Col du Jaillet en andere geclassificeerde monumenten in Cordon"
    ]
  },
