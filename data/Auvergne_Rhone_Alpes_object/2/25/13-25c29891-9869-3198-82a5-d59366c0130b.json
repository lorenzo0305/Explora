  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf ein Abenteuer im Herzen der Weinberge von Ayze mit einem Escape Game auf dem Fahrrad, das Rätsel, Natur und Weinproben miteinander verbindet. Ein spielerisches und sensorisches Erlebnis, das Sie nicht verpassen sollten!"
    ],
    "en": [
      "Set off on an adventure in the heart of the Ayze vineyards with an escape game on bike, combining enigmas, nature and wine tasting. A fun and sensory experience not to be missed!"
    ],
    "it": [
      "Partite per un'avventura nel cuore dei vigneti di Ayze con un gioco di fuga in bicicletta che combina enigmi, natura e degustazione di vini. Un'esperienza divertente e sensoriale da non perdere!"
    ],
    "fr": [
      "Partez à l’aventure au cœur des vignes d’Ayze avec un escape game à vélo mêlant énigmes, nature et dégustation. Une expérience ludique et sensorielle à ne pas manquer !"
    ],
    "nl": [
      "Ga op avontuur in het hart van de wijngaarden van Ayze met een ontsnappingsspel op de fiets dat puzzels, natuur en wijnproeven combineert. Een leuke en zintuiglijke ervaring die je niet mag missen!"
    ],
    "es": [
      "Emprenda una aventura en el corazón de los viñedos de Ayze con un juego de escape en bicicleta que combina rompecabezas, naturaleza y degustación de vinos. Una experiencia lúdica y sensorial que no te puedes perder"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game & Vélo-Vignes"
    ]
  },
