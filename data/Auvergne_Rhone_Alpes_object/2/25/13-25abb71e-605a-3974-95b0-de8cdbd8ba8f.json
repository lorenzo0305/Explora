  "rdfs:comment": {
    "de": [
      "Diese Etappe der La Belle Via wechselt zwischen Naturgebieten und atemberaubenden Ausblicken auf die umliegenden Bergmassive, bevor sie in Grenoble, der Hauptstadt der Alpen, eintritt."
    ],
    "en": [
      "This stage of La Belle Via alternates between natural areas and breathtaking views of the surrounding massifs before entering Grenoble, the capital of the Alps."
    ],
    "it": [
      "Questa tappa della Belle Via alterna aree naturali e viste mozzafiato sulle montagne circostanti prima di entrare a Grenoble, la capitale delle Alpi."
    ],
    "fr": [
      "Cette étape de La Belle Via alterne entre espaces naturels et vues imprenables sur les massifs environnants avant d'entrer dans Grenoble, la capitale des Alpes."
    ],
    "es": [
      "Esta etapa de la Belle Via alterna zonas naturales y vistas impresionantes de las montañas circundantes antes de entrar en Grenoble, la capital de los Alpes."
    ],
    "nl": [
      "Deze etappe van de Belle Via voert afwisselend door natuurgebieden en adembenemende uitzichten op de omliggende bergen voordat Grenoble, de hoofdstad van de Alpen, wordt aangedaan."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cycling itinerary: La Belle Via - Stage 5 - La Terrasse > Grenoble"
    ],
    "fr": [
      "Itinéraire vélo : La Belle Via - Étape 5 - La Terrasse > Grenoble"
    ]
  },
