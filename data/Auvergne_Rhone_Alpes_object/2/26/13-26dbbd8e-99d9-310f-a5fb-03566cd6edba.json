  "rdfs:comment": {
    "de": [
      "Casebook? Was ist das denn?! Praktisch und clever sind vernetzte Gepäckräume, die sich im Stadtzentrum von Valence am Boulevard Félix Faure in der Nähe des Busbahnhofs und des monumentalen Brunnens befinden."
    ],
    "en": [
      "Casebook? What's Casebook? Practical and smart, Casebook is a connected luggage store located in downtown Valence, on boulevard Félix Faure, near the bus hub and the monumental fountain."
    ],
    "it": [
      "Casistica? Ma che cos'è? Casebook è un negozio di valigie intelligente, pratico e connesso, situato nel centro di Valence, in boulevard Félix Faure, vicino alla stazione degli autobus e alla fontana monumentale."
    ],
    "fr": [
      "Casebook ? Mais qu’est-ce que c’est ?! Pratique et futé se sont des bagageries connectées situées en centre-ville de Valence, boulevard Félix Faure à proximité du pôle bus et de la fontaine monumentale."
    ],
    "es": [
      "¿Casebook? Pero, ¿qué es? Casebook es una consigna inteligente, práctica y conectada, situada en el centro de Valence, en el bulevar Félix Faure, cerca de la estación de autobuses y de la fuente monumental."
    ],
    "nl": [
      "Casebook? Wat is Casebook? Casebook is een slimme, praktische, aangesloten bagagewinkel in het centrum van Valence, op de boulevard Félix Faure, vlakbij het busknooppunt en de monumentale fontein."
    ]
  },
  "rdfs:label": {
