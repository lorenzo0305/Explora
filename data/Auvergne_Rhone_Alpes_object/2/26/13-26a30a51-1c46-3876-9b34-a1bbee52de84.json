  "rdfs:comment": {
    "de": [
      "Diese Brücke (1752-1758 / ISMH) wurde über den Andan gebaut und als Umleitung des antiken Weges der römischen Brücke errichtet."
    ],
    "en": [
      "This bridge (1752-1758) was built on the river Andan to welcome the roman road diversion."
    ],
    "it": [
      "Questo ponte (1752-1758 / ISMH) fu costruito sul fiume Andan e stabilito come deviazione dall'antico percorso del ponte romano."
    ],
    "fr": [
      "Ce pont (1752-1758 / ISMH) a été construit sur l'Andan et établi en déviation de la voie antique du pont romain."
    ],
    "es": [
      "Este puente (1752-1758 / ISMH) se construyó sobre el río Andán y se estableció como una desviación de la ruta del antiguo puente romano."
    ],
    "nl": [
      "Deze brug (1752-1758 / ISMH) werd gebouwd over de rivier de Andan en aangelegd als afwijking van de oude Romeinse bruggenroute."
    ]
  },
