  "rdfs:comment": {
    "de": [
      "Étang d'Omps (1. Kategorie = Forellen und Weißfische), verwaltet von der AAPPMA de Laroquebrou.\r\nAngelschein erforderlich, Preise und Verkauf unter www.cartedepeche.fr oder :"
    ],
    "en": [
      "Fishing activity (1st category = trout & whitefish). Fishing license required: Daily (€14), weekly (€36.50) or yearly permits (€87) on sale at www.cartedepeche.fr or from the above stockists."
    ],
    "it": [
      "Étang d'Omps (1a categoria = trota e coregone), gestito dall'AAPPMA di Laroquebrou.\r\nLicenza di pesca obbligatoria, prezzi e vendita su www.cartedepeche.fr o :"
    ],
    "fr": [
      "Étang d'Omps (1e catégorie = truites et poissons blancs), géré par l'AAPPMA de Laroquebrou.\r\nPermis de pêche nécessaire, tarifs et vente sur www.cartedepeche.fr ou :"
    ],
    "es": [
      "Étang d'Omps (1ª categoría = trucha y pescado blanco), gestionado por la AAPPMA de Laroquebrou.\r\nLicencia de pesca obligatoria, precios y venta en www.cartedepeche.fr o :"
    ],
    "nl": [
      "Visserijactiviteit (1ste categorie = forel & witvis). Visvergunning vereist: Dagelijkse (€ 14), wekelijkse (€ 36,50) of jaarlijkse pas (€ 87) verkrijgbaar op www.cartedepeche.fr of bij de bovenstande verkooppunten."
    ]
  },
