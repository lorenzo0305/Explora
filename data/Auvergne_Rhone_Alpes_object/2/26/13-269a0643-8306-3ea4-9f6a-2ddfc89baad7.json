  "rdfs:comment": {
    "de": [
      "Er wird Parc Bazin oder Parc des Acacias genannt. Herr Bazin war ein berühmter Historiker aus Montchat, der 1980 verstarb. Auf 21.156 m² befinden sich Kinderspielplätze, eine Rutsche, Schaukelpferde, ein Boulodrome und große Rasenflächen."
    ],
    "en": [
      "It is called the Parc Bazin or Parc des Acacias. Mr. Bazin was a famous historian from Montchat who died in 1980. It covers 21,156m² and includes a children’s play area, slide, rocking horses, bowling area, vast lawns, etc."
    ],
    "it": [
      "Si chiama Parc Bazin o Parc des Acacias. Bazin era un famoso storico di Montchat, morto nel 1980. Su 21.156 m², ci sono giochi per bambini, uno scivolo, cavalli a dondolo, una pista da bowling e grandi prati."
    ],
    "fr": [
      "On l'appelle Parc Bazin ou Parc des Acacias. M. Bazin est un célèbre historien de Montchat décédé en 1980. Sur 21 156 m², se trouvent des jeux pour enfants, un toboggan, des chevaux de bascule, un boulodrome, de vastes pelouses."
    ],
    "es": [
      "Se llama Parc Bazin o Parc des Acacias. El Sr. Bazin fue un famoso historiador de Montchat que murió en 1980. En 21.156 m², hay juegos para niños, un tobogán, caballitos de balancín, una bolera y amplias zonas de césped."
    ],
    "nl": [
      "Het heet Parc Bazin of Parc des Acacias. Mr. Bazin was een beroemd historicus van het Montchat die in 1980 overleed. Op 21.156 m² zijn er spelletjes voor kinderen, een glijbaan, hobbelpaarden, een bowlingbaan en grote grasvelden."
    ]
  },
