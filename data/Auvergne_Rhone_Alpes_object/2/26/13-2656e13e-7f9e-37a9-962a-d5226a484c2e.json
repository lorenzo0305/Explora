  "rdfs:comment": {
    "de": [
      "Diese Kirche wurde außerhalb der Befestigungsanlagen der Burg und der Oberstadt errichtet und weist ein recht zusammengesetztes Ensemble auf."
    ],
    "en": [
      "from the12th and 16th centuries"
    ],
    "it": [
      "Questa chiesa fu costruita al di fuori delle fortificazioni del castello e della città alta e presenta un insieme piuttosto composito."
    ],
    "fr": [
      "Cette église fut construite en dehors des fortifications du château et celles de la ville haute et présente un ensemble assez composite."
    ],
    "es": [
      "Esta iglesia fue construida fuera de las fortificaciones del castillo y de las de la ciudad alta y presenta un conjunto bastante compuesto."
    ],
    "nl": [
      "Deze kerk werd gebouwd buiten de kasteelversterkingen en die van de bovenstad en vertoont een nogal samengesteld geheel."
    ]
