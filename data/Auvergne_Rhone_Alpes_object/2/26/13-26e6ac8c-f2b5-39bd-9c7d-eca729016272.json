  "rdfs:comment": {
    "de": [
      "Gemüsebauer in Familienbesitz seit 60 Jahren. Vom Großvater zum Schwiegersohn und dann zur Tochter: Biogemüse ist unsere Nische! Wir bewirtschaften unser Land seit 1964 mit Respekt für die Umwelt."
    ],
    "en": [
      "Family market gardener for 60 years. From grandfather to son-in-law to daughter: organic vegetables are our niche! We've been cultivating our land since 1964 with respect for the environment."
    ],
    "it": [
      "Orticoltore a conduzione familiare da 60 anni. Dal nonno al genero alla figlia: gli ortaggi biologici sono la nostra nicchia! Dal 1964 coltiviamo la nostra terra nel rispetto dell'ambiente."
    ],
    "fr": [
      "Maraîcher familial depuis 60 ans. De grand père, à beau-fils, puis en fille : les légumes biologiques sont notre créneau ! Nous cultivons nos terres depuis 1964 dans le respect de l'environnement."
    ],
    "es": [
      "Horticultor familiar desde hace 60 años. De abuelo a yerno e hija: ¡las verduras ecológicas son nuestro nicho! Cultivamos nuestra tierra desde 1964 respetando el medio ambiente."
    ],
    "nl": [
      "Al 60 jaar familietuinder. Van grootvader op schoonzoon op dochter: biologische groenten zijn onze niche! Sinds 1964 bewerken we ons land met respect voor het milieu."
    ]
  },
  "rdfs:label": {
