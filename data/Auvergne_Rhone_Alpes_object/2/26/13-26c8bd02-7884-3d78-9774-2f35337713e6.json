  "rdfs:comment": {
    "de": [
      "Verleih von Tretbooten, Kanus, Kajaks, Paddles und Riesenpaddles.\r\nWassersportaktivitäten am See Chambon (Strand neben dem Dorf Chambon). Haustiere sind nicht erlaubt."
    ],
    "en": [
      "Renting of pedal boats, canoes, kayaks, paddles and giant paddles.\r\nWater activities at the Chambon lake, (beach near Chambon village).\r\nInflatable water games."
    ],
    "it": [
      "Noleggio di pedalò, canoe, kayak, pagaie e pagaie giganti.\r\nAttività sportive acquatiche al Lago di Chambon (spiaggia vicino al villaggio di Chambon). Animali non ammessi."
    ],
    "fr": [
      "Locations de pédal'eau, canoës, kayaks, paddles et paddles géants.\r\nActivités nautiques au lac Chambon (plage coté Chambon village). Animaux non admis."
    ],
    "nl": [
      "Verhuur van waterfietsen, kano's, kajaks, peddels en reuzenpeddels.\r\nWatersportactiviteiten bij het meer van Chambon (strand naast het dorp Chambon). Huisdieren niet toegestaan."
    ],
    "es": [
      "Alquiler de pedales, canoas, kayaks, remos y palas gigantes.\r\nActividades náuticas en el lago de Chambon (playa junto al pueblo de Chambon). No se admiten animales."
    ]
  },
