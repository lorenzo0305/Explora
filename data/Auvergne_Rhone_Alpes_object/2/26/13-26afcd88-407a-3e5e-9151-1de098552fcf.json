  "rdfs:comment": {
    "de": [
      "Teesalon - Dekorationsboutique, herzhaftes Mittagessen, süße Leckereien, Tee, Kaffee, heiße Schokolade und andere Getränke zum Entdecken, handwerklich hergestelltes Eis."
    ],
    "en": [
      "Tearoom - boutique decoration, savoury lunch, sweet treats, tea, coffee, hot chocolate and other beverages to discover, artisanal ice creams."
    ],
    "it": [
      "Sala da tè - decorazione boutique, pranzo salato dalle 12.00 alle 14.30, torte fatte in casa, tè, caffè, cioccolate calde, matcha latte, Chaï latte e altre bevande da scoprire, gelati fatti in casa."
    ],
    "fr": [
      "Salon de thé - boutique décoration, déjeuner salé de 12h à 14h30, gâteaux faits maison , thés , cafés , chocolats chaud , matcha latte , Chaï latte et autres boissons à découvrir, glaces artisanales."
    ],
    "es": [
      "Tearoom - decoración boutique, almuerzo salado de 12h a 14h30, tartas caseras, tés, cafés, chocolates calientes, matcha latte, Chaï latte y otras bebidas por descubrir, helados caseros."
    ],
    "nl": [
      "Tearoom - boetiekdecoratie, hartige lunch, zoete lekkernijen, thee, koffie, warme chocolademelk en andere drankjes om te ontdekken, zelfgemaakt ijs."
    ]
