      "dc:description": {
        "de": [
          "Von 15:00 bis 18:00 Uhr, Südstrand Thalasso.\nWettbewerb für Lizenzinhaber am Strand (Thalassoseite).\nEtwa 80 Personen werden erwartet."
        ],
        "en": [
          "3 pm to 6 pm, Thalasso South beach.\nCompetition open to members on the beach (Thalasso side).\nAround 80 people expected."
        ],
        "it": [
          "Dalle 15.00 alle 18.00, spiaggia Sud Thalasso.\nConcorso aperto ai titolari di licenza sulla spiaggia (lato Thalasso).\nSono attese circa 80 persone."
        ],
        "fr": [
          "De 15h à 18h, plage Sud Thalasso.\nConcours ouvert aux licenciés sur la plage (côté Thalasso).\nEnviron 80 personnes attendues."
        ],
        "nl": [
          "Van 15.00 tot 18.00 uur, Thalassostrand Sud.\nWedstrijd open voor licentiehouders op het strand (Thalasso-kant).\nEr worden ongeveer 80 mensen verwacht."
        ],
        "es": [
          "De 15.00 a 18.00 horas, playa de la Talasoterapia Sur.\nConcurso abierto a los titulares de licencia en la playa (lado Thalasso).\nSe esperan unas 80 personas."
        ]
      },
