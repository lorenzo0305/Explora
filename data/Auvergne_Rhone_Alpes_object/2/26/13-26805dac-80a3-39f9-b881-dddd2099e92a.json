  "rdfs:comment": {
    "de": [
      "Bauernhof mit gemischter Landwirtschaft und Viehzucht in einer schönen Ecke des Cantal. Ich halte einige Kühe der Rasse Highland Cattle und Schweine in Freilandhaltung. Ich verarbeite alles, was auf dem Hof produziert wird und verkaufe es im Direktverkauf. Der Hof wird biologisch bewirtschaftet."
    ],
    "en": [
      "Mixed-crop farm in a pretty corner of the Cantal. I raise a few Highland Cattle cows and free-range pigs. I process everything produced on the farm and sell it directly. The farm is organic."
    ],
    "it": [
      "Azienda agricola in policoltura in un grazioso angolo del Cantal. Allevo all'aperto alcuni bovini e maiali di razza Highland. Trasformo tutto ciò che viene prodotto in azienda e lo vendo direttamente. L'azienda si occupa di agricoltura biologica."
    ],
    "fr": [
      "Ferme en polyculture élevage dans un joli coin du Cantal. J'élève quelques vaches de race Highland Cattle et des cochons en plein air. Je transforme tout ce qui est produit sur la ferme et le vend en vente directe. La ferme est en agriculture biologique."
    ],
    "es": [
      "Granja en policultivo en un bonito rincón de Cantal. Crío unas cuantas vacas de raza Highland y cerdos al aire libre. Elaboro todo lo que se produce en la granja y lo vendo directamente. La granja se dedica a la agricultura ecológica."
    ],
    "nl": [
      "Boerderij in polycultuur fokkerij in een mooie hoek van de Cantal. Ik fok een paar Highland koeien en varkens in de open lucht. Ik verwerk alles wat op de boerderij wordt geproduceerd en verkoop het direct. De boerderij doet aan biologische landbouw."
    ]
  },
  "rdfs:label": {
    "en": [
      "Farm at Vernet bridge"
    ],
    "fr": [
      "Ferme au pont du Vernet"
    ]
  },
