  "rdfs:comment": {
    "de": [
      "Der Legends ist ein Konzentrat aus Technologie und Komfort dank seiner temperaturgeregelten, blasenförmigen und ultraschnellen 6-Sitzer. Erleben Sie die Legende mit den auf die Sitze gestickten Namen der großen Ski-Champions, die die Geschichte von Méribel geprägt haben."
    ],
    "en": [
      "The Legends combines latest technology and comfort thanks to its thermo-regulated seats and weather shield. The seats commemorate the Alpine ski champions who have earned their place in Méribel’s history"
    ],
    "it": [
      "Il Legends è un concentrato di tecnologia e comfort grazie ai suoi sedili a 6 posti termoregolati, a bolla e ultraveloci. Rivivete la leggenda con i nomi dei grandi campioni di sci che hanno segnato la storia di Meribel, ricamati sui sedili."
    ],
    "fr": [
      "Le Legends est un concentré de technologie et de confort grâce à ses sièges 6 places thermo-régulés, à bulle et ultra rapides. Reviviez la légende avec les noms de grandes championnes de ski qui ont marqué l’histoire de Méribel, brodés sur les sièges."
    ],
    "es": [
      "El Legends es un concentrado de tecnología y confort gracias a sus asientos termorregulados, de burbuja y ultrarrápidos de 6 plazas. Reviva la leyenda con los nombres de los grandes campeones de esquí que han marcado la historia de Meribel, bordados en los asientos."
    ],
    "nl": [
      "De Legends is een concentraat van technologie en comfort dankzij zijn 6-persoons thermo-geregelde, bubbel- en ultrasnelle zetels. Herleef de legende met de namen van grote skikampioenen die de geschiedenis van Meribel hebben getekend, geborduurd op de zetels."
    ]
  },
  "rdfs:label": {
    "en": [
      "Legends Chairlift"
    ],
