  "rdfs:comment": {
    "de": [
      "Restaurant, Tapas-Weinbar, regionale Produkte.\r\nSpezialität: das Savoyer Fondue. Außergewöhnliche Produkte, die Sie bei einem Glas in einer schicken Franchouillarde-Atmosphäre genießen können. Essen Sie vor Ort\r\nvor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Restaurant, wine bar, tapas bar. Enjoy regional dishes such as the delicious savoyard fondue. Exceptional products to enjoy over a drink in a chic French atmosphere."
    ],
    "it": [
      "Ristorante, enoteca di tapas, prodotti regionali.\r\nSpecialità: Fondue Savoyarde. Prodotti eccezionali da gustare con un drink in un'atmosfera chic da franchouillarde. Mangiare in\r\no da asporto."
    ],
    "fr": [
      "Restaurant, bar à vins tapas, produits régionaux. \r\nSpécialité : la Fondue Savoyarde. Des produits d’exception à déguster autour d’un verre dans une ambiance franchouillarde chic. Mangez sur\r\nplace ou à emporter."
    ],
    "es": [
      "Restaurante, bar de vinos y tapas, productos regionales.\r\nEspecialidad: Fondue Savoyarde. Productos excepcionales para degustar con una copa en un ambiente chic franchouillarde. Para comer\r\no para llevar."
    ],
    "nl": [
      "Restaurant, tapas wijnbar, regionale producten. Specialiteit: de \r\nSavoyaardse fondue. Uitzonderlijke producten om van te genieten met een drankje in een chique franchouillarde sfeer. Eten\r\nof om mee te nemen."
    ]
  },
