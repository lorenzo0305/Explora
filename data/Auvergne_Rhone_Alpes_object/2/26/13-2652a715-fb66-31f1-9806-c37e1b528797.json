  "rdfs:comment": {
    "de": [
      "Die Schülerinnen und Schüler des zeitgenössischen Tanzes führen choreografische Improvisationen zu einem eklektischen Repertoire auf, das von den Schülerinnen und Schülern der Orgelklasse interpretiert wird.\r\nEine originelle künstlerische Begegnung an einem historischen Ort in der Stadt Valence."
    ],
    "en": [
      "Contemporary dance students perform choreographic improvisations to an eclectic repertoire interpreted by students from the organ class.\r\nAn original artistic encounter in a historic Valence venue."
    ],
    "it": [
      "Gli studenti di danza contemporanea eseguono improvvisazioni coreografiche su un repertorio eclettico interpretato dalla classe di organo.\r\nUn incontro artistico originale in un luogo storico della città di Valence."
    ],
    "fr": [
      "Les élèves de danse contemporaine se livrent à des improvisations chorégraphiques sur un répertoire éclectique interprété par les élèves de la classe d’orgue.\r\nUne rencontre artistique originale dans un lieu historique de la ville de Valence."
    ],
    "es": [
      "Los alumnos de danza contemporánea realizan improvisaciones coreográficas sobre un repertorio ecléctico interpretado por la clase de órgano.\r\nUn encuentro artístico original en un lugar histórico de la ciudad de Valence."
    ],
    "nl": [
      "De studenten hedendaagse dans voeren choreografische improvisaties uit op een eclectisch repertoire geïnterpreteerd door de orgelklas.\r\nEen originele artistieke ontmoeting op een historische locatie in de stad Valence."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Danse organistique"
    ]
  },
