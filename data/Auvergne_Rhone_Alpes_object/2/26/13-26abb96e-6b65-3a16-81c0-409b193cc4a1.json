  "rdfs:comment": {
    "de": [
      "Atelier Boutique für nützliche und dekorative Gegenstände. Technik der glasierten Erde. Mit Platten gedrehte oder modellierte Stücke aus roter Fayence, aber auch Möbel aus Holz und Keramik, Bilder und Möbel."
    ],
    "en": [
      "Workshop shop of useful and decorative objects. Technique of glazed clay. Pieces turned with plates or modelled in red earthenware but also wooden and ceramic furniture, paintings and furniture."
    ],
    "it": [
      "Acquista oggetti utili e decorativi. Tecnica dell'argilla smaltata. Pezzi torniti su piatti o modellati in terracotta rossa, ma anche mobili in legno e ceramica, dipinti e arredi."
    ],
    "fr": [
      "Atelier boutique d'objets utiles et décoratifs. Technique de la terre vernissée. Pièces tournées à la plaques ou modelées en faïence rouge mais aussi meubles en bois et céramiques, tableaux et mobilier."
    ],
    "nl": [
      "Winkel voor nuttige en decoratieve voorwerpen. Geglazuurde klei techniek. Stukken gedraaid op borden of geboetseerd in rood aardewerk, maar ook houten en keramische meubels, schilderijen en meubilair."
    ],
    "es": [
      "Compre objetos útiles y decorativos. Técnica de arcilla vidriada. Piezas torneadas en platos o modeladas en loza roja, pero también muebles de madera y cerámica, cuadros y mobiliario."
    ]
  },
