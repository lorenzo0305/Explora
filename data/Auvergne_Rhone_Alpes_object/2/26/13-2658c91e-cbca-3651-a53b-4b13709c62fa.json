  "rdfs:comment": {
    "de": [
      "Wenn Sie Lust haben, die Berge auf traditionelle und herzliche Weise zu erleben, dann führen Sie alle Wege zum Hotel Le Sherpa."
    ],
    "en": [
      "If you want to experience mountain life in a welcoming, traditional way, make your way to Hotel Le Sherpa."
    ],
    "it": [
      "Se desiderate vivere la montagna in modo tradizionale e accogliente, allora tutte le piste vi condurranno all'hotel Le Sherpa."
    ],
    "fr": [
      "Si vous avez envie de vivre la montagne de façon traditionnelle et chaleureuse, alors toutes les pistes vous mèneront à l’hôtel Le Sherpa."
    ],
    "es": [
      "Si desea vivir la montaña de una forma tradicional y acogedora, todas las pistas le llevarán al hotel Le Sherpa."
    ],
