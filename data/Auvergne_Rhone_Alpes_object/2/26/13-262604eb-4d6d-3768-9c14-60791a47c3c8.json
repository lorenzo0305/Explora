  "rdfs:comment": {
    "de": [
      "Erzeuger, der Kalbfleisch und Angus-Rinder züchtet\r\nProduzent von Walnüssen AOP de Grenoble und Derivaten (Nüsse, Öl..), Direktverkauf auf dem Hof oder über die Website\r\ninternet www.fermeles13fontaines.com\r\nMilchviehbetrieb mit Melkrobotern."
    ],
    "en": [
      "Producer of veal and Angus beef\r\nProducer of Noix AOP de Grenoble and by-products (walnuts, oil..), Direct sale at the farm or on the website\r\nwww.fermeles13fontaines.com\r\nDairy farm with milking robots."
    ],
    "it": [
      "Produttore di carne di vitello e di manzo Angus\r\nProduttore di noci Grenoble DOP e derivati (noci, olio, ecc.), vendita diretta in azienda o sul sito web\r\nwww.fermeles13fontaines.com\r\nAzienda lattiero-casearia con robot di mungitura."
    ],
    "fr": [
      "Producteur éleveur viande de veau et bœuf Angus\r\nProducteur de Noix AOP de Grenoble et dérivés (noix, huile..), Vente directe à la ferme ou sur le site\r\ninternet www.fermeles13fontaines.com\r\nExploitation laitière avec robots de traite."
    ],
    "es": [
      "Productor de carne de ternera y de buey Angus\r\nProductor de nueces de Grenoble DOP y subproductos (nueces, aceite, etc.), venta directa en la explotación o en el sitio web\r\nwww.fermeles13fontaines.com\r\nExplotación lechera con robots de ordeño."
    ],
    "nl": [
      "Producent van kalfsvlees en Angus rundvlees\r\nProducent van walnoten met de BOB Grenoble en bijproducten (walnoten, olie, enz.), rechtstreekse verkoop op de boerderij of via de website\r\nwww.fermeles13fontaines.com\r\nMelkveebedrijf met melkrobots."
    ]
  },
