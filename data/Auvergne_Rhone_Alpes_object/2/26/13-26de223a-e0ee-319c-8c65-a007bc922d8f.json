  "rdfs:comment": {
    "de": [
      "Grafikdesign, Logo-Design, Druck auf allen Oberflächen, Schilder, Fahrzeugwerbung, Textildrucke und Werbeobjekte. Seit 2002 ein reaktionsfreudiges und flexibles Familienunternehmen, das sich Ihren \r\nWünschen anpasst."
    ],
    "en": [
      "Graphic design, creation of logos, all-media printing, signage, vehicle marking, printing on fabric and promotional objects. This family business founded in 2002 is quick to respond and flexible, and therefore adapts to your needs."
    ],
    "it": [
      "Tutte le vostre esigenze di comunicazione visiva! Da 22 anni creiamo e produciamo tutti i tipi di media."
    ],
    "fr": [
      "Toute la communication visuelle ! Création et réalisation sur tous les supports depuis 22 ans."
    ],
    "es": [
      "Todas sus necesidades de comunicación visual Llevamos 22 años creando y produciendo todo tipo de soportes."
    ],
