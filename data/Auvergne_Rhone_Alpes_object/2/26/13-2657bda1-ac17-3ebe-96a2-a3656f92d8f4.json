  "rdfs:comment": {
    "de": [
      "Milchprodukte aus der Ardèche: Frisch- und UHT-Milch, Joghurt, Käse in Felleinlage und trocken, Bio-Milchprodukte. Keine Besichtigung, kein Laden vor Ort, aber unsere Produkte sind in vielen Geschäften der Region erhältlich!\r\nProbieren Sie die Ardèche®."
    ],
    "en": [
      "Ardèche dairy products: fresh and UHT milk, yoghurt, faisselle and dry cheeses, organic dairy products. No visits, no shop on site, but our products are on sale in many local shops!\r\nTaste the Ardèche®."
    ],
    "it": [
      "Prodotti caseari dell'Ardèche: latte fresco e UHT, yogurt, faisselle e formaggi secchi, prodotti caseari biologici. Nessuna visita, nessun negozio in loco, ma i nostri prodotti sono in vendita in molti negozi locali!\r\nEtichettati Goûtez l'Ardèche®."
    ],
    "fr": [
      "Produits laitiers de l'Ardèche : lait frais et UHT, yaourt, fromage en faisselle et sec, produits laitiers bio. Pas de visite, pas de boutique sur place mais nos produits sont en vente dans de nombreux commerces de la région !\r\nLabellisé Goûtez l'Ardèche®."
    ],
    "nl": [
      "Zuivelproducten uit de Ardèche: verse melk en UHT-melk, yoghurt, faisselle en droge kazen, biologische zuivelproducten. Geen bezoek, geen winkel ter plaatse, maar onze producten zijn in veel plaatselijke winkels te koop !\r\nProef de Ardèche®."
    ],
    "es": [
      "Productos lácteos de Ardèche: leche fresca y UHT, yogur, quesos faisselle y secos, productos lácteos ecológicos. No hay visitas ni tienda in situ, pero nuestros productos están a la venta en muchos comercios locales\r\nCon la etiqueta Goûtez l'Ardèche®."
    ]
  },
