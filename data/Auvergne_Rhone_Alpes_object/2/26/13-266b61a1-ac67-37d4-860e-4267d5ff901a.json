  "rdfs:comment": {
    "de": [
      "Freier Zugang zu den Außenanlagen mit Informationstafel. Dieser Bau aus dem 17. Jahrhundert aus polychromen Ziegeln besitzt Türme mit Laternen, die sich anmutig von den umgebenden Parkbäumen abheben."
    ],
    "en": [
      "Free access from outside with information panel. This 17th century building made of polychrome bricks has lantern towers that stand out gracefully against the surrounding park trees."
    ],
    "it": [
      "Accesso libero all'esterno con pannello informativo. Questo edificio in mattoni policromi del XVII secolo ha torri a lanterna che si stagliano con grazia sugli alberi del parco circostante."
    ],
    "fr": [
      "Accès libre des extérieurs avec panneau d'information. Cette construction du XVIIe siècle en briques polychromes possède des tours à lanternons qui se détachent gracieusement sur les arbres du parc qui l'entourent."
    ],
    "nl": [
      "Vrije toegang tot de buitenkant met informatiepaneel. Dit polychrome bakstenen gebouw uit de 17e eeuw heeft lantaarntorens die sierlijk afsteken tegen de omringende parkbomen."
    ],
    "es": [
      "Acceso gratuito al exterior con panel informativo. Este edificio de ladrillo policromado del siglo XVII tiene torres con linternas que destacan con gracia sobre los árboles del parque que lo rodean."
    ]
  },
