  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/73c68c73-3726-3492-9461-bcd5c15dbadc",
      "dc:description": {
        "de": [
          "Trendiges, schickes Restaurant, das auf hausgemachte Muscheln und Rindfleisch spezialisiert ist.\n\nIn der Nebensaison von Donnerstag bis Montag geöffnet.\nIn der Hochsaison täglich geöffnet.\nVon 11:30 bis 14 Uhr und von 18:45 bis 22 Uhr."
        ],
        "en": [
          "Chic and trendy restaurant specialising in home-made mussels and beef.\n\nOpen from Thursday to Monday in low season.\nOpen every day in high season.\nFrom 11:30 am to 2 pm and from 6:45 pm to 10 pm."
        ],
        "it": [
          "Ristorante chic e di tendenza, specializzato in cozze e manzo fatti in casa.\n\nAperto da giovedì a lunedì in bassa stagione.\nAperto tutti i giorni in alta stagione.\nDalle 11.30 alle 14.00 e dalle 18.45 alle 22.00."
        ],
        "fr": [
          "Restaurant chic tendance spécialiste du fait maison moules et boeuf.\n\nOuvert du jeudi au lundi en basse saison.\nOuvert tous les jours en haute saison.\nDe 11h30 à 14 et de 18h45 à 22h."
        ],
        "nl": [
          "Trendy chic restaurant gespecialiseerd in huisgemaakte mosselen en rundvlees.\n\nGeopend van donderdag tot maandag in het laagseizoen.\nIn het hoogseizoen elke dag geopend.\nVan 11.30 tot 14.00 uur en van 18.45 tot 22.00 uur."
        ],
        "es": [
          "Restaurante elegante y de moda, especializado en mejillones caseros y ternera.\n\nAbierto de jueves a lunes en temporada baja.\nAbierto todos los días en temporada alta.\nDe 11.30 a 14.00 y de 18.45 a 22.00."
        ]
      },
