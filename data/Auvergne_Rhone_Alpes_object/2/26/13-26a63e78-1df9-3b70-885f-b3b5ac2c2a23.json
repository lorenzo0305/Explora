  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch den Ortskern von Laval, um die Markierungen zu entdecken, die in der Nähe historischer Orte angebracht wurden."
    ],
    "en": [
      "Using your map, navigate through the heart of the village of Laval to find the markers that have been installed near historic sites."
    ],
    "it": [
      "Utilizzando la vostra mappa, spostatevi nel cuore di Laval per scoprire i segnalatori installati vicino ai siti storici."
    ],
    "fr": [
      "À l'aide de votre carte, déplacez-vous au coeur du village de Laval pour découvrir les balises qui ont été installées à proximité des lieux historiques."
    ],
    "es": [
      "Utilizando su mapa, desplácese por el centro de Laval para descubrir los marcadores que se han instalado cerca de los lugares históricos."
    ],
    "nl": [
      "Baan je met behulp van je kaart een weg door het hart van het dorp Laval om de markeringen te ontdekken die in de buurt van historische plekken zijn aangebracht."
    ]
  },
  "rdfs:label": {
