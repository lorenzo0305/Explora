    "de": [
      "St Thyrse, dessen Ursprünge bis ins 12. Jahrhundert zurückreichen (Chor aus dem 15. Jahrhundert); der Glockenturm stammt aus dem 15. und das Pfarrhaus aus dem 18."
    ],
    "en": [
      "St Thyrse, whose origins date back to the 12th century (choir from the 15th); the campanile dates from the 15th and the presbytery from the 18th century."
    ],
    "it": [
      "St Thyrse, le cui origini risalgono al XII secolo (coro del XV secolo); il campanile risale al XV secolo e il presbiterio al XVIII secolo."
    ],
    "fr": [
      "St Thyrse, dont les origines remontent au 12ème siècle (choeur du 15ème) ; le campanile date du 15ème et le presbytère du 18ème siècle."
    ],
    "nl": [
      "St Thyrse, waarvan de oorsprong teruggaat tot de 12e eeuw (koor uit de 15e eeuw); de klokkentoren dateert uit de 15e eeuw en het priesterkoor uit de 18e eeuw."
    ],
    "es": [
      "St Thyrse, cuyos orígenes se remontan al siglo XII (coro del siglo XV); el campanario data del siglo XV y el presbiterio del siglo XVIII."
