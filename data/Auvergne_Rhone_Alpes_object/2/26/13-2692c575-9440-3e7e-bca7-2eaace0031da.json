  "rdfs:comment": {
    "de": [
      "Die Traverse ist vollständig ausgeschildert und gesichert, für nicht motorisierte Fahrzeuge reserviert und mit einem glatten, vollständig rollbaren Belag versehen. Sie bietet Ihnen die Möglichkeit, zu Fuß, mit dem Fahrrad, mit Inline-Skates oder mit dem Roller spazieren zu gehen oder Sport zu treiben."
    ],
    "en": [
      "Fully signposted and safe, reserved for non-motorized vehicles, and covered with a smooth, fully-rolling surface, La Traverse offers you the chance to walk or do sport on foot, bike, rollerblade or scooter."
    ],
    "it": [
      "Completamente segnalata e sicura, riservata ai veicoli non motorizzati e coperta da una superficie liscia e completamente scorrevole, La Traverse offre la possibilità di camminare o fare sport a piedi, in bicicletta, rollerblade o scooter."
    ],
    "fr": [
      "Entièrement balisée et sécurisée, réservée aux véhicules non motorisés, et recouverte d’un revêtement lisse entièrement roulant, La Traverse offre la possibilité de vous promener ou de faire du sport à pied, à vélo, en roller ou en trottinette."
    ],
    "es": [
      "Totalmente señalizada y segura, reservada a los vehículos no motorizados y cubierta con una superficie lisa y totalmente rodante, La Traverse le ofrece la posibilidad de pasear o hacer deporte a pie, en bicicleta, patines o scooter."
    ],
    "nl": [
      "La Traverse is volledig bewegwijzerd en veilig, gereserveerd voor niet-gemotoriseerde voertuigen en bedekt met een glad, volledig rollend oppervlak. Het geeft je de kans om te wandelen of te sporten te voet, op de fiets, op een skeeler of op een step."
    ]
  },
