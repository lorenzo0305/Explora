  "rdfs:comment": {
    "de": [
      "Odile Touillier, eine im Maison des Artistes eingetragene Malerin, leitet diesen echten Lebensraum, in dem das ganze Jahr über zahlreiche Aktivitäten angeboten werden: Malkurse und -praktika, Empfang von Künstlern und verschiedene Animationen, Lesungen..."
    ],
    "en": [
      "Odile Touillier, artist member of 'La Maison des Artistes', manages this art centre at the heart of the town of Die."
    ],
    "it": [
      "Odile Touillier, pittrice iscritta alla Maison des Artistes, offre una vasta gamma di attività durante tutto l'anno, tra cui mostre temporanee, corsi e laboratori di pittura, visite d'artista e vari eventi, letture, ecc."
    ],
    "fr": [
      "Odile Touillier, artiste peintre inscrite à la Maison des Artistes, propose tout au long de l'année de nombreuses activités : expositions temporaires, stages et cours de peinture, accueil d'artistes et animations diverses, lectures..."
    ],
    "nl": [
      "Schilderes Odile Touillier is de drijvende kracht in een culturele ontmoetingsplaats in het centrum van Die. Zij staat ingeschreven als kunstschilderes bij het kunstenaarshuis Maison des Artistes."
    ],
    "es": [
      "Odile Touillier, pintora inscrita en la Maison des Artistes, ofrece un amplio abanico de actividades a lo largo del año, como exposiciones temporales, cursos y talleres de pintura, visitas de artistas y diversos actos, lecturas, etc."
    ]
  },
  "rdfs:label": {
