  "rdfs:comment": {
    "de": [
      "Les Couteaux de la Berchère ist eine Messerschmiede, die von Julien Maniglier aus Saint-Sigismond gegründet wurde. Er stellt völlig originelle Messer her und verkauft sie."
    ],
    "en": [
      "Les Couteaux de la Berchère is a cutlery workshop created by Julien Maniglier, a native of Saint-Sigismond. He makes and sells totally original knives."
    ],
    "it": [
      "Les Couteaux de la Berchère è un laboratorio di coltelleria creato da Julien Maniglier, originario di Saint-Sigismond. Realizza e vende coltelli assolutamente originali."
    ],
    "fr": [
      "Les Couteaux de la Berchère est un atelier de coutellerie créé par Julien Maniglier, originaire de Saint-Sigismond. Il fabrique et vend des couteaux totalement originaux."
    ],
    "nl": [
      "Les Couteaux de la Berchère is een bestekatelier dat is opgericht door Julien Maniglier, een inwoner van Saint-Sigismond. Hij maakt en verkoopt volledig originele messen."
    ],
    "es": [
      "Les Couteaux de la Berchère es un taller de cuchillería creado por Julien Maniglier, natural de Saint-Sigismond. Hace y vende cuchillos totalmente originales."
    ]
  },
