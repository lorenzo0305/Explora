  "rdfs:comment": {
    "de": [
      "Diese Strecke bietet Ihnen das Angeln in einem Gebirgsbach in der Nähe des Ferienortes Les Ménuires. Da der Wildbach ein starkes Gefälle hat, erfordert er ein eher technisches Angeln."
    ],
    "en": [
      "This course proposes you a fishing in mountain stream near the resort of Les Ménuires. The torrent having a strong slope, it will require a rather technical fishing."
    ],
    "it": [
      "Questo corso offre la possibilità di pescare in un torrente di montagna vicino alla località di Les Ménuires. Il torrente ha una forte pendenza e richiede una pesca piuttosto tecnica."
    ],
    "fr": [
      "Ce parcours vous propose une pêche en torrent de montagne à deux pas de la station des Ménuires. Le torrent ayant une forte pente, il nécessitera une pêche plutôt technique."
    ],
    "es": [
      "Este campo ofrece pesca en un arroyo de montaña cercano a la estación de Les Ménuires. El torrente tiene una pendiente pronunciada y requerirá una pesca bastante técnica."
    ],
    "nl": [
      "Dit parcours biedt vissen in een bergbeek in de buurt van de badplaats Les Ménuires. De torrent heeft een steile helling en vereist een nogal technische visserij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche « 1 poisson » sur le Doron de Belleville en amont des Ménuires"
    ]
  },
