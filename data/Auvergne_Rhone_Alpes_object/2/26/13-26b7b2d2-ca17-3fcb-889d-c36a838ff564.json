  "rdfs:comment": {
    "de": [
      "Wir haben den Pôle Hippique de l'étoile mit einem Ziel gegründet: unseren Schülerinnen und Schülern die beste und lohnendste Lernerfahrung im Wohlergehen der Pferde zu bieten."
    ],
    "en": [
      "We founded the Pôle Hippique de l'étoile with one goal in mind: to offer our students the best and most rewarding learning experience in the well-being of horses."
    ],
    "it": [
      "Abbiamo fondato il Pôle Hippique de l'étoile con un unico obiettivo: offrire ai nostri studenti la migliore e più gratificante esperienza di apprendimento del benessere del cavallo."
    ],
    "fr": [
      "Nous avons fondé le Pôle Hippique de l'étoile avec un objectif : offrir à nos élèves la meilleure et la plus gratifiante des expériences d'apprentissage dans le bien être des chevaux."
    ],
    "nl": [
      "We hebben de Pôle Hippique de l'étoile opgericht met één doel voor ogen: onze studenten de beste en meest lonende leerervaring bieden in het welzijn van paarden."
    ],
    "es": [
      "Fundamos el Pôle Hippique de l'étoile con un objetivo en mente: ofrecer a nuestros alumnos la mejor y más gratificante experiencia de aprendizaje en el bienestar de los caballos."
    ]
  },
