  "rdfs:comment": {
    "de": [
      "Die Käserei wurde 1976 von den Eltern von Stéphane und Jérôme Roseleur gegründet und ist heute eine der letzten fünf, die sich auf die Herstellung von Maroilles fermier (Bauernkäse) aus Rohmilch spezialisiert haben."
    ],
    "en": [
      "Founded in 1976 by Stéphane and Jérôme Roseleur?s parents, the cheese dairy is now one of the last 5 specializing in the production of farmhouse Maroilles made with raw milk."
    ],
    "it": [
      "Fondato nel 1976 dai genitori di Stéphane e Jérôme Roseleur, il caseificio è oggi uno dei soli 5 rimasti specializzati nella produzione di Maroilles di fattoria a latte crudo."
    ],
    "fr": [
      "Créée en 1976 par les parents de Stéphane et Jérôme Roseleur, la fromagerie est aujourd’hui l’une des 5 dernières spécialisées dans la fabrication de Maroilles fermier au lait cru."
    ],
    "es": [
      "Fundada en 1976 por los padres de Stéphane y Jérôme Roseleur, la quesería es hoy una de las 5 que quedan especializadas en la producción de Maroilles de granja a partir de leche cruda."
    ],
    "nl": [
      "De kaasmakerij werd in 1976 opgericht door de ouders van Stéphane en Jérôme Roseleur en is nu een van de slechts 5 overgebleven kaasmakerijen die gespecialiseerd zijn in de productie van boerenmaroilles van rauwe melk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Château Courbet"
    ]
  },
