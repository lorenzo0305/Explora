  "rdfs:comment": {
    "de": [
      "Eine große Auswahl an Pizzen steht Ihnen zur Verfügung. Pizzen auch zum Mitnehmen\r\nRaum mit Klimaanlage. Bestellung der Pizzen morgens ab 10 Uhr und abends ab 17 Uhr."
    ],
    "en": [
      "A wide choice of pizzas on offer. Pizzas can also be taken away. \r\nAir-conditioned dining room. Pizzas can be ordered from 10am in the morning and from 5pm in the evening."
    ],
    "it": [
      "È disponibile una vasta gamma di pizze. Le pizze possono anche essere portate via\r\nCamera climatizzata. Le pizze possono essere ordinate dalle 10 del mattino e dalle 17 della sera."
    ],
    "fr": [
      "Tout un large choix de pizzas s'offre à vous. Pizzas également à emporter. \r\nSalle climatisée. Commande des pizzas à partir de 10h le matin et à partir de 17h le soir."
    ],
    "es": [
      "Se ofrece una amplia gama de pizzas. Las pizzas también se pueden llevar\r\nHabitación con aire acondicionado. Las pizzas pueden pedirse a partir de las 10 de la mañana y de las 5 de la tarde."
    ],
    "nl": [
      "Er is een breed scala aan pizza's beschikbaar. Pizza's kunnen ook worden meegenomen\r\nKamer met airconditioning. Pizza's kunnen worden besteld vanaf 10 uur 's ochtends en vanaf 17 uur 's avonds."
    ]
  },
