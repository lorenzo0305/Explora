  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6ca80d4-b997-38d3-bd15-3ef82e9f92c3",
      "dc:description": {
        "de": [
          "Kommen Sie und verbringen Sie eine gesellige Zeit rund um die Karten!\n\nEin Preis pro Teilnehmer.\n1. Preis: 100? pro Team\n2. Preis: 80? pro Team\n3. Preis: 60? pro Team\n\nEine entspannte Atmosphäre, tolle Preise und gute Laune sind garantiert!"
        ],
        "en": [
          "Come and enjoy a friendly game of cards!\n\nOne prize per participant.\n1st prize: 100? per team\n2nd prize: 80? per team\n3rd prize: 60? per team\n\nA relaxed atmosphere, prizes to be won and good spirits guaranteed!"
        ],
        "it": [
          "Venite a divertirvi giocando a carte!\n\nUn premio per ogni partecipante.\n1° premio: 100€ per squadra\n2° premio: 80? per squadra\n3° premio: 60? per squadra\n\nAtmosfera rilassata, premi in palio e buonumore assicurato!"
        ],
        "fr": [
          "Venez passer un bon moment de convivialité autour des cartes ! \n\nUn lot par participant.\n1er lot: 100€ par équipe\n2ème lot: 80€ par équipe\n3ème lot: 60€ par équipe\n\nAmbiance détendue, lots à gagner et bonne humeur assurée !"
        ],
        "es": [
          "¡Ven a pasártelo en grande jugando a las cartas!\n\nUn premio por participante.\n1er premio: 100 euros por equipo\n2º premio: 80? por equipo\n3er premio: 60? por equipo\n\nAmbiente distendido, premios para ganar y ¡buen humor garantizado!"
        ],
        "nl": [
          "Kom gezellig kaarten!\n\nEén prijs per deelnemer.\n1e prijs: €100 per team\n2e prijs: 80? per team\n3e prijs: 60? per team\n\nEen ontspannen sfeer, prijzen te winnen en goed humeur gegarandeerd!"
        ]
      },
      "@type": [
