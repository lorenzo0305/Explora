  "rdfs:comment": {
    "de": [
      "Die Guinguette Champêtre ist ein temporäres Lokal, das sich im Herzen der wunderschönen Wasserfläche von Les Ozières befindet. Dieser einzigartige Ort verbindet den zeitlosen Charme der Guinguettes von einst mit einer ländlichen Atmosphäre und bietet eine ideale Auszeit von der Hektik der Stadt."
    ],
    "en": [
      "La Guinguette Champêtre is an ephemeral establishment nestled in the heart of the magnificent Ozières lake. This unique venue combines the timeless charm of the guinguettes of yesteryear with a country atmosphere, offering an ideal getaway from the urban hustle and bustle."
    ],
    "it": [
      "La Guinguette Champêtre è una struttura effimera immersa nel cuore del magnifico lago di Ozières. Questo locale unico combina il fascino senza tempo delle guinguette di un tempo con un'atmosfera di campagna, offrendo una fuga ideale dalla frenesia della città."
    ],
    "fr": [
      "La Guinguette Champêtre est un établissement éphémère niché au cœur du magnifique plan d'eau des Ozières. Ce lieu unique combine le charme intemporel des guinguettes d'antan avec une ambiance champêtre, offrant une escapade idéale loin du tumulte urbain."
    ],
    "nl": [
      "La Guinguette Champêtre is een kortstondig etablissement genesteld in het hart van het prachtige meer van Ozières. Deze unieke locatie combineert de tijdloze charme van de guinguettes van weleer met een landelijke sfeer en biedt een ideale ontsnapping aan de drukte van de stad."
    ],
    "es": [
      "La Guinguette Champêtre es un establecimiento efímero enclavado en el corazón del magnífico lago de Ozières. Este lugar único combina el encanto intemporal de las guinguettes de antaño con un ambiente campestre, ofreciendo una escapada ideal del bullicio de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Guinguette des Ozières"
    ]
  },
