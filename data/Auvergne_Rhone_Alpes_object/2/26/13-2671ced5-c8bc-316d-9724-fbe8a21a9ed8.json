  "rdfs:comment": {
    "de": [
      "L'Ecluse lädt Sie zu einem gastronomischen Abenteuer ein, das Tradition und Raffinesse miteinander verbindet. Es ist ein Ort, an dem die Leidenschaft für gutes Essen auf eine außergewöhnliche Gastfreundschaft trifft. Genießen Sie kulinarische Exzellenz in einem gemütlichen Rahmen."
    ],
    "en": [
      "Restaurant located on the banks of the Rhone, near the Via Rhona. Shaded terrace."
    ],
    "it": [
      "L'Ecluse vi invita a vivere un'avventura gastronomica che unisce tradizione e raffinatezza. È un luogo dove la passione per la buona cucina incontra un'ospitalità eccezionale. Venite a gustare l'eccellenza culinaria in un ambiente accogliente."
    ],
    "fr": [
      "L'Ecluse vous invite à une aventure gastronomique alliant tradition et raffinement. C'est un lieu où la passion de bien manger rencontre une hospitalité exceptionnelle. Venez savourer l'excellence culinaire dans un cadre chaleureux."
    ],
    "nl": [
      "L'Ecluse nodigt je uit op een gastronomisch avontuur dat traditie en verfijning combineert. Het is een plek waar passie voor lekker eten samenkomt met uitzonderlijke gastvrijheid. Kom culinair genieten in een warme omgeving."
    ],
    "es": [
      "L'Ecluse le invita a una aventura gastronómica que combina tradición y refinamiento. Es un lugar donde la pasión por la buena comida se une a una hospitalidad excepcional. Venga a saborear la excelencia culinaria en un entorno cálido."
    ]
  },
