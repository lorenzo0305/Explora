  "rdfs:comment": {
    "de": [
      "Der Espace Nordique du Grand Coin liegt zwischen Montaimont und Montpascal, charmanten kleinen Dörfern im Herzen der Maurienne auf einer durchschnittlichen Höhe von 1300 m. Er empfängt Sie zum Langlaufen, Rodeln und Schneeschuhwandern."
    ],
    "en": [
      "The Espace Nordique du Grand Coin, located between Montaimont and Montpascal, charming little villages located in the heart of the Maurienne region at an average altitude of 1300 meters, will welcome you for cross-country skiing, sledding and snowshoeing."
    ],
    "it": [
      "L'Espace Nordique du Grand Coin, situato tra Montaimont e Montpascal, due incantevoli paesini nel cuore della Maurienne a un'altitudine media di 1300 metri, è il luogo ideale per praticare lo sci di fondo, lo slittino e le racchette da neve."
    ],
    "fr": [
      "L’Espace Nordique du Grand Coin, situé entre Montaimont et Montpascal, de charmants petits villages situés au coeur de la Maurienne à une altitude moyenne de 1300 mètres, saura vous accueillir pour le ski de fond, la luge et les balades en raquettes."
    ],
    "nl": [
      "Het Espace Nordique du Grand Coin, gelegen tussen Montaimont en Montpascal, twee charmante dorpjes in het hart van de Maurienne op een gemiddelde hoogte van 1300 meter, is de perfecte plek voor langlaufen, rodelen en sneeuwschoenwandelen."
    ],
    "es": [
      "El Espace Nordique du Grand Coin, situado entre Montaimont y Montpascal, dos encantadores pueblecitos en el corazón de la Maurienne a una altitud media de 1.300 metros, es el lugar perfecto para practicar esquí de fondo, trineo y raquetas de nieve."
    ]
  },
