  "rdfs:comment": {
    "de": [
      "In der Region Auvergne-Rhône-Alpes... im Departement Allier 18km von Digoin und 8km von Donjon entfernt finden Sie uns in einem Gebäude aus dem späten 19. Jahrhundert, auf dem Land, wo Frieden herrscht."
    ],
    "en": [
      "In the region of Auvergne-Rhône-Alpes... in the department of Allier, 18km from Digoin and 8km from Donjon, you will find us in a building from the end of the 19th century, in the countryside where peace reigns."
    ],
    "it": [
      "Nella regione dell'Alvernia-Rodano-Alpi, nel dipartimento di Allier, a 18 km da Digoin e a 8 km da Donjon, ci troverete in un edificio della fine del XIX secolo, in una campagna dove regna la pace."
    ],
    "fr": [
      "Dans la région Auvergne-Rhône-Alpes… dans le département de l’Allier à 18km de Digoin et 8km de Donjon vous nous trouverez dans un bâtiment de la fin du XIXème siècle, dans la campagne où règne la paix."
    ],
    "nl": [
      "In de regio Auvergne-Rhône-Alpes... in het departement Allier, op 18 km van Digoin en 8 km van Donjon, vindt u ons in een gebouw uit het einde van de 19e eeuw, op het platteland waar rust heerst."
    ],
    "es": [
      "En la región de Auvergne-Rhône-Alpes... en el departamento de Allier, a 18 km de Digoin y a 8 km de Donjon, nos encontrará en un edificio de finales del siglo XIX, en el campo donde reina la paz."
    ]
  },
