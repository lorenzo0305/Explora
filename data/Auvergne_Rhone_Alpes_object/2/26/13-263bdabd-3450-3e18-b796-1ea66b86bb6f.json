  "rdfs:comment": {
    "de": [
      "Unabhängige Boutique, die sich auf den Markt für die Schätzung, den Kauf und den Wiederverkauf von Sammlerprodukten der Popkultur, Buchhandlungen, Gesellschafts- und Rollenspielen spezialisiert hat. Referenzshop in Drôme/Ardèche auf dem sehr spezialisierten Markt für RetroGaming."
    ],
    "en": [
      "Independent store specializing in the appraisal, purchase and resale of Pop Culture collectibles, books, board games and role-playing games. Reference store in Drôme/Ardèche on the highly specialized RetroGaming market."
    ],
    "it": [
      "Negozio indipendente specializzato nella valutazione, nell'acquisto e nella rivendita di oggetti da collezione della cultura pop, libri, giochi da tavolo e giochi di ruolo. Negozio di riferimento in Drôme/Ardèche sul mercato altamente specializzato del RetroGaming."
    ],
    "fr": [
      "Boutique indépendante spécialisée dans le marché de l'estimation, l'achat et la revente de produits de collection Pop Culture, librairie, jeux de société et jeux de rôles. Boutique référence en Drôme/Ardèche sur le marché très spécialisé du RetroGaming."
    ],
    "es": [
      "Tienda independiente especializada en la valoración, compra y reventa de objetos de colección de la cultura pop, libros, juegos de mesa y juegos de rol. Tienda de referencia en Drôme/Ardèche en el mercado altamente especializado de RetroGaming."
    ],
    "nl": [
      "Onafhankelijke winkel gespecialiseerd in de taxatie, aankoop en doorverkoop van popcultuurverzamelobjecten, boeken, bordspellen en rollenspellen. Referentiewinkel in Drôme/Ardèche op de zeer gespecialiseerde RetroGaming-markt."
    ]
  },
