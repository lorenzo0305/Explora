  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0a3e093c-f7fd-302b-9f2a-e792753bd27b",
      "dc:description": {
        "de": [
          "Bereiten Sie Ihre Turnschuhe für den Trail Rose de Dourges vor!\nWährend des Rosentages findet ein Gesundheitsforum im Salle Briquet statt\nLassen Sie sich nicht vom Krebs einholen, laufen Sie schneller als er!"
        ],
        "en": [
          "Get your sneakers ready for the Trail Rose de Dourges!\nDuring the Pink Day, a Health Forum will be held in the Salle Briquet\nDon't let cancer catch you, run faster than it!"
        ],
        "it": [
          "Preparate le scarpe da ginnastica per il Trail Rose de Dourges!\nUn forum sulla salute si terrà nella Salle Briquet durante la Giornata Rosa\nNon lasciatevi prendere dal cancro, correte più veloci di lui!"
        ],
        "fr": [
          "Préparez vos baskets pour le Trail Rose de Dourges ! \nDurant cette journée Rose un Forum Santé se tiendra salle Briquet \nNe laissez pas le cancer vous rattraper, courez plus vite que lui !"
        ],
        "es": [
          "¡Prepare sus zapatillas para el Trail Rose de Dourges!\nEl Día Rosa se celebrará un Foro de la Salud en la Salle Briquet\nNo dejes que el cáncer te atrape, ¡corre más rápido que él!"
        ],
        "nl": [
          "Maak je sportschoenen klaar voor de Trail Rose de Dourges!\nOp Roze Dag wordt er een Gezondheidsforum gehouden in de Salle Briquet\nLaat je niet vangen door kanker, ren sneller dan de kanker!"
        ]
      },
