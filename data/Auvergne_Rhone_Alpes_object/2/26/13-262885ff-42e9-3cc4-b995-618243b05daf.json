  "rdfs:comment": {
    "de": [
      "Die gemütlichen, warmen und modernen Zimmer des Hotels sind ideal, um sich nach einem Tag auf der Skipiste oder beim Wandern zu entspannen. Die Zimmer sind geräumig und verfügen teilweise sogar über einen Balkon mit Aussicht."
    ],
    "en": [
      "Cosy, warm and modern, the hotel's rooms are perfect for relaxing after a day of skiing. They are spacious and some even have a balcony with a view."
    ],
    "it": [
      "Accoglienti, calde e moderne, le camere dell'hotel sono perfette per rilassarsi dopo una giornata di sci o di escursioni. Alcune sono spaziose e dispongono anche di un balcone con vista."
    ],
    "fr": [
      "Cosy, chaleureuses et modernes, les chambres de l'hôtel seront parfaites pour vous détendre après une journée de ski ou de randonnée. Spacieuses, certaines disposent même d'un balcon avec vue."
    ],
    "nl": [
      "De gezellige, warme en moderne kamers van het hotel zijn perfect om te ontspannen na een dag skiën. Ze zijn ruim en sommige hebben zelfs een balkon met uitzicht."
    ],
    "es": [
      "Acogedoras, cálidas y modernas, las habitaciones del hotel son perfectas para relajarse tras un día de esquí o senderismo. Algunas son espaciosas e incluso tienen balcón con vistas."
    ]
  },
