  "rdfs:comment": {
    "de": [
      "Während der Sommermonate Verkauf von Aprikosen, Pfirsichen, Weinbergpfirsichen, Nektarinen, Kirschen, Feigen, Äpfeln, Birnen, Fruchtsäften. Im Winter Verkauf von Äpfeln, Bio-Äpfeln, Birnen, Kürbissen, Kartoffeln, Kastanien, Kiwis, Fruchtsäften, Marmeladen...!"
    ],
    "en": [
      "Sale of apricots, peaches, pêche de vigne, nectarines, cherries, figs, apples, pears, chestnuts, kiwis, fruit juices."
    ],
    "it": [
      "Scoprite lo Chalet des Délices di Tante Line, un produttore locale di Châteauneuf sur Isère.\r\nIn estate, albicocche, pesche, nettarine, ciliegie e prugne.\r\nIn inverno, mele biologiche, pere biologiche, castagne biologiche, kiwi biologici e succhi di frutta biologici!"
    ],
    "fr": [
      "Découvrez le Chalet des Délices de Tante Line, producteur local à Châteauneuf sur Isère.\r\nEn période estivale, vente d'abricots, pêches, nectarines, cerises et prunes.\r\nDurant l'hiver, vente de pommes bio, poires bio, châtaignes bio, kiwis bio et jus bio !"
    ],
    "nl": [
      "Verkoop abrikozen, perziken, wijngaardperziken, nectarines, kersen, vijgen, appels, peren, kastanjes, kiwi's, vruchtensap."
    ],
    "es": [
      "Descubra el Chalet des Délices de Tante Line, un productor local de Châteauneuf sur Isère.\r\nEn verano, albaricoques, melocotones, nectarinas, cerezas y ciruelas.\r\nEn invierno, manzanas ecológicas, peras ecológicas, castañas ecológicas, kiwis ecológicos y zumos ecológicos"
    ]
  },
