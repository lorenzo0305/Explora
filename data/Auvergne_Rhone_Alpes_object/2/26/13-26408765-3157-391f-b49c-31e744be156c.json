  "rdfs:comment": {
    "de": [
      "Mathieu & Roldan ist eine traditionelle, bürgernahe Agentur, die völlig unabhängig ist. Profitieren Sie von der Erfahrung echter Immobilienprofis, die den lokalen Markt genau kennen und Sie bei allen Schritten begleiten werden."
    ],
    "en": [
      "Mathieu & Roldan is a traditional, local and totally independent real estate agency. You'll benefit from the experience of real estate professionals who know the local market inside out, and who'll guide you through every step of the process."
    ],
    "it": [
      "Mathieu & Roldan è un'agenzia tradizionale, locale e totalmente indipendente. Potete beneficiare dell'esperienza di professionisti del settore immobiliare che conoscono a fondo il mercato locale e possono aiutarvi in ogni fase del processo."
    ],
    "fr": [
      "Mathieu & Roldan est une agence traditionnelle de proximité, totalement indépendante. Bénéficiez de l'expérience de véritables professionnels de l'immobilier, connaissant parfaitement le marché local et qui vous accompagneront pour toutes les démarches."
    ],
    "nl": [
      "Mathieu & Roldan is een traditioneel, lokaal en volledig onafhankelijk makelaarskantoor. Je profiteert van de ervaring van vastgoedprofessionals die de lokale markt door en door kennen en je bij elke stap kunnen helpen."
    ],
    "es": [
      "Mathieu & Roldan es una agencia tradicional, local y totalmente independiente. Usted se beneficia de la experiencia de profesionales inmobiliarios que conocen a fondo el mercado local y pueden ayudarle en cada paso del camino."
    ]
  },
