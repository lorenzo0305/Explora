  "rdfs:comment": {
    "de": [
      "Bevor Sie zur Arbeit gehen oder um einen Abend mit Freunden zu verbringen, empfängt Sie die Bar der Auberge du Basilico in ihrem warmen und geselligen Bergambiente."
    ],
    "en": [
      "Before you go to work or for an evening with friends, the bar at the Auberge du basilico welcomes you to its warm and friendly mountain setting"
    ],
    "it": [
      "Prima di andare al lavoro o per condividere una serata con gli amici, il bar della Locanda Basilico vi accoglie nella sua calda e accogliente cornice di montagna"
    ],
    "fr": [
      "Avant d'aller travailler ou pour partager une soirée entre amis, le Bar de l'auberge du basilico vous accueille dans son cadre montagnard chaleureux et convivial"
    ],
    "es": [
      "Antes de ir a trabajar o para compartir una velada con los amigos, el Bar de la Posada Basilico le da la bienvenida en su cálido y acogedor entorno de montaña"
    ],
    "nl": [
      "Alvorens te gaan werken of om een avond door te brengen met vrienden... de bar du replat verwelkomt U in zijn warm en gezellig bergkader."
    ]
  },
