  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ebd28552-f603-399b-a32f-2f1e5ebfb387",
      "dc:description": {
        "de": [
          "Schlendern Sie am Fuße der Stadtmauer aus dem 13. Jahrhundert oder auf dem Rundweg, der die befestigte Stadt Boulogne-sur-Mer umgibt. Dieser bietet Ihnen verschiedene Aussichtspunkte auf die Stadt, das Meer, den Hafen..."
        ],
        "en": [
          "Stroll along the foot of the 13th-century ramparts or the walkway surrounding the fortified town of Boulogne-sur-Mer. The latter offers different views of the town, the sea, the port..."
        ],
        "it": [
          "Passeggiate ai piedi dei bastioni del XIII secolo o sulla passerella che circonda la città fortificata di Boulogne-sur-Mer. La passerella offre diverse vedute della città, del mare, del porto..."
        ],
        "fr": [
          "Flânez au pied des remparts datant du 13è siècle ou sur le chemin de ronde entourant la ville fortifiée de Boulogne-sur-Mer. Ce dernier vous offre différents points de vue sur la ville, la mer, le port..."
        ],
        "nl": [
          "Wandel langs de voet van de 13e-eeuwse vestingmuren of het wandelpad rond de versterkte stad Boulogne-sur-Mer. De loopbrug biedt verschillende uitzichten op de stad, de zee, de haven..."
        ],
        "es": [
          "Pasee al pie de las murallas del siglo XIII o por el paseo que rodea la ciudad fortificada de Boulogne-sur-Mer. El paseo ofrece diferentes vistas de la ciudad, el mar, el puerto..."
        ]
      },
