  "rdfs:comment": {
    "de": [
      "Ihre Crêperie \"Histoire de...\" ist ein bretonischer Zwischenstopp im Herzen der Monts du Lyonnais.\r\nEine große Auswahl an Galettes, Crêpes und Cidre aus eigener Herstellung verwöhnen Ihren Gaumen entweder im Restaurant in Brindas oder bei Ihnen zu Hause mit unserem Food Truck als Catering-Service."
    ],
    "en": [
      "Your Crêperie \"Histoire de...\" is a Breton stopover in the heart of the Monts du Lyonnais.\r\nA wide choice of home-made Galettes, Crêpes and Cidres will delight your taste buds either at the restaurant in Brindas, or at home with our catering version of the Food Truck."
    ],
    "it": [
      "La vostra Crêperie \"Histoire de...\" è una tappa bretone nel cuore dei Monts du Lyonnais.\r\nUn'ampia scelta di Galettes, Crêpes e Cidres fatte in casa delizierà le vostre papille gustative sia al ristorante di Brindas che a casa vostra con la nostra versione catering del Food Truck."
    ],
    "fr": [
      "Votre Crêperie \"Histoire de...\" c'est une escale Bretonne au cœur des Monts du Lyonnais.\r\nUn large choix de Galettes, Crêpes et Cidres artisanaux régaleront vos papilles soit au restaurant à Brindas, soit chez vous avec notre Food Truck version Traiteur."
    ],
    "nl": [
      "Uw Crêperie \"Histoire de...\" is een Bretonse tussenstop in het hart van de Monts du Lyonnais.\r\nEen ruime keuze aan huisgemaakte Galettes, Crêpes en Cidres zal uw smaakpapillen verrukken, hetzij in het restaurant in Brindas of thuis met onze catering versie van de Food Truck."
    ],
    "es": [
      "Su Crêperie \"Histoire de...\" es una parada bretona en el corazón de los Montes del Lyonnais.\r\nUna amplia selección de Galettes, Crêpes y Cidres caseros deleitarán su paladar, ya sea en el restaurante de Brindas o en casa con nuestra versión de catering del Food Truck."
    ]
  },
  "rdfs:label": {
