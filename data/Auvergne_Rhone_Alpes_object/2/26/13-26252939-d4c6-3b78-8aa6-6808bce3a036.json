  "rdfs:comment": {
    "de": [
      "Handwerker zu sein bedeutet, ein wenig gegen den Strom zu schwimmen. Unsere Welt ist schnelllebig und nutzt immer ausgefeiltere Techniken."
    ],
    "en": [
      "Being a craftsman means going against the tide. Our world moves fast and uses increasingly sophisticated techniques."
    ],
    "it": [
      "Essere un artigiano significa andare controcorrente. Il nostro mondo si muove velocemente e utilizza tecniche sempre più sofisticate."
    ],
    "fr": [
      "Être artisan c’est un peu aller à contre-courant. Notre monde va vite et utilise des techniques de plus en plus sophistiquées."
    ],
    "nl": [
      "Vakman zijn betekent tegen de stroom ingaan. Onze wereld beweegt snel en maakt gebruik van steeds geavanceerdere technieken."
    ],
    "es": [
      "Ser artesano significa ir contracorriente. Nuestro mundo avanza deprisa y utiliza técnicas cada vez más sofisticadas."
    ]
