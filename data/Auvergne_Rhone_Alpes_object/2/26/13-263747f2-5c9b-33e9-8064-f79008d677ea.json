  "rdfs:comment": {
    "de": [
      "Gemütlicher Gasthof mit Panoramablick auf den Puy de Dôme, die Puys-Kette, das Sioule-Tal, den Pariou. Sehr schönes kleines Dorf zu entdecken. Arbeitermenü von Montag bis Freitag und ein einfaches und effektives Menü am Freitag- und Samstagabend."
    ],
    "en": [
      "Warm inn with a panoramic view of the Puy de Dôme, the Puys chain, the Sioule valley, the Pariou. Very beautiful little village to discover. Working class menu from Monday to Friday and a simple and effective menu on Friday and Saturday evening."
    ],
    "it": [
      "Accogliente locanda con vista panoramica sul Puy de Dôme, la Chaîne des Puys, la valle della Sioule e Le Pariou. Un bel paesino da scoprire. Menu operaio dal lunedì al venerdì e un piccolo menu semplice ed efficiente dal venerdì sera."
    ],
    "fr": [
      "Auberge chaleureuse avec vue panoramique sur le Puy de Dôme, la chaîne des Puys, la vallée de la Sioule, le Pariou. Très beau petit village à découvrir. Menu ouvrier du lundi au vendredi et petite carte simple et efficace à partir du vendredi soir."
    ],
    "nl": [
      "Gezellige herberg met panoramisch uitzicht op de Puy de Dôme, de Chaîne des Puys, de vallei van Sioule en Le Pariou. Een prachtig dorpje om te ontdekken. Werkmenu van maandag tot vrijdag en een klein, eenvoudig en efficiënt menu vanaf vrijdagavond."
    ],
    "es": [
      "Acogedora posada con vistas panorámicas al Puy de Dôme, la Chaîne des Puys, el valle de Sioule y Le Pariou. Un precioso pueblecito por descubrir. Menú obrero de lunes a viernes y un pequeño menú sencillo y eficaz a partir del viernes por la noche."
    ]
  },
  "rdfs:label": {
    "de": [
      "Auberge Chez Agathe"
    ],
    "en": [
      "Auberge Chez Agathe"
    ],
    "fr": [
      "Auberge Chez Agathe"
    ]
  },
