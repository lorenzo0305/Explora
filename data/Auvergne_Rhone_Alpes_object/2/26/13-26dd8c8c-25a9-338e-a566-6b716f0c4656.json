  "rdfs:comment": {
    "de": [
      "Ein Eintauchen mit allen Sinnen in die Geheimnisse der Wälder der provenzalischen Baronnies.\r\nDas Unsichtbare, das, was sich unserem Blick entzieht, aber unseren Sinnen zuflüstert, steht im Mittelpunkt dieser neuen Ausstellung: La Forêt invisible (Der unsichtbare Wald)."
    ],
    "en": [
      "A sensory immersion into the secrets of the forests of the Baronnies provençales.\r\nThe invisible, that which escapes our gaze but whispers to our senses, is at the heart of this new exhibition: The Invisible Forest."
    ],
    "it": [
      "Un'immersione sensoriale nei segreti delle foreste delle Baronnies provençales.\r\nL'invisibile, ciò che sfugge al nostro sguardo ma sussurra ai nostri sensi, è al centro di questa nuova mostra: La foresta invisibile."
    ],
    "fr": [
      "Une immersion sensorielle dans les secrets des forêts des Baronnies provençales.\r\nL’invisible, ce qui échappe à notre regard mais murmure à nos sens, est au cœur de cette nouvelle exposition  : La Forêt invisible."
    ],
    "es": [
      "Una inmersión sensorial en los secretos de los bosques de las Baronnies provençales.\r\nLo invisible, lo que escapa a nuestra mirada pero susurra a nuestros sentidos, está en el corazón de esta nueva exposición: El bosque invisible."
    ],
    "nl": [
      "Een zintuiglijke onderdompeling in de geheimen van de bossen van de Baronnies provençales.\r\nHet onzichtbare, dat wat aan onze blik ontsnapt maar fluistert naar onze zintuigen, staat centraal in deze nieuwe tentoonstelling: Het onzichtbare bos."
    ]
  },
  "rdfs:label": {
    "de": [
      "Der unsichtbare Wald"
    ],
    "en": [
      "The invisible forest"
    ],
    "fr": [
      "La forêt invisible"
    ],
    "nl": [
      "Het onzichtbare bos"
    ]
  },
