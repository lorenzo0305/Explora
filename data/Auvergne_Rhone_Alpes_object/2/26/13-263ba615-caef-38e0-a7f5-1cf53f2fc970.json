  "rdfs:comment": {
    "de": [
      "Valérie, Solange und Camille pflegen den Geschmack einer traditionellen, familiären und einfallsreichen Küche in einem originellen und angenehmen Rahmen. Von Mai bis September kann die Verkostung auf der Sonnenterrasse stattfinden."
    ],
    "en": [
      "Valérie, Solange and Camille cultivate the taste of a traditional family and inventive cuisine in an original and pleasant setting. From May to September, the tasting can be done on the sunny terrace."
    ],
    "it": [
      "Valérie, Solange e Camille coltivano il gusto di una cucina familiare tradizionale e inventiva in un ambiente originale e piacevole. Da maggio a settembre, potrete gustare i vostri pasti sulla terrazza soleggiata."
    ],
    "fr": [
      "Valérie, Solange et Camille cultivent le goût d’une cuisine traditionnelle familiale et inventive dans un cadre original et agréable. De mai à septembre, la dégustation pourra se faire sur la terrasse ensoleillée."
    ],
    "es": [
      "Valérie, Solange y Camille cultivan el sabor de una cocina familiar tradicional e inventiva en un entorno original y agradable. De mayo a septiembre, puede disfrutar de su comida en la soleada terraza."
    ],
    "nl": [
      "Valérie, Solange en Camille cultiveren de smaak van een traditionele en inventieve familiekeuken in een origineel en aangenaam kader. Van mei tot september kunt u van uw maaltijd genieten op het zonnige terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cuisine de Valérie"
    ]
  },
