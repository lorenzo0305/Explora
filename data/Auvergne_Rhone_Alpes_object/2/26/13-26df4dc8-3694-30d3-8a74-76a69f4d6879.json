  "rdfs:comment": {
    "de": [
      "Willkommen in der Auberge La Péniche, einer Oase der Gastfreundschaft und Authentizität zwischen Allier und Loire, dem Tor zur Region Auvergne-Rhône-Alpes."
    ],
    "en": [
      "Welcome to Auberge La Péniche, a haven of conviviality and authenticity nestled between Allier and Loire, the gateway to the Auvergne-Rhône-Alpes region."
    ],
    "it": [
      "Benvenuti all'Auberge La Péniche, un'oasi di convivialità e autenticità situata tra l'Allier e la Loira, alle porte della regione Auvergne-Rhône-Alpes."
    ],
    "fr": [
      "Bienvenue à l’Auberge La Péniche, un havre de convivialité et d’authenticité niché entre Allier et Loire, la porte de l’Auvergne-Rhône-Alpes."
    ],
    "nl": [
      "Welkom in Auberge La Péniche, een oase van gezelligheid en authenticiteit tussen de Allier en de Loire, de toegangspoort tot de regio Auvergne-Rhône-Alpes."
    ],
    "es": [
      "Bienvenido al Auberge La Péniche, un remanso de cordialidad y autenticidad situado entre el Allier y el Loira, a las puertas de la región de Auvernia-Ródano-Alpes."
    ]
  },
