  "rdfs:comment": {
    "de": [
      "Die Ferme des Colibris züchtet ihre Tiere auf traditionelle Weise, unter Einhaltung der Charta für biologischen Landbau und des Tierschutzes. Direktverkauf: Rindfleisch, Kalbfleisch, Schweinefleisch, Wurstwaren. Vermietung eines Ferienhauses für 6 Personen."
    ],
    "en": [
      "La Ferme des Colibris breeds its animals in the traditional way, respecting the charter of organic farming and animal welfare. Direct sales: beef, veal, pork, cold meats.\r\nRental of a gite for 6 people."
    ],
    "it": [
      "La Ferme des Colibris alleva i suoi animali in modo tradizionale, rispettando la carta dell'agricoltura biologica e del benessere animale. Vendita diretta: manzo, vitello, maiale, salumi. Affitto di un gîte per 6 persone."
    ],
    "fr": [
      "La Ferme des Colibris élève ses animaux de façon traditionnelle, dans le respect de la charte de l'Agriculture Biologique et du bien-être animal. Vente directe : bœuf, veau, porc, charcuterie. Location de gîte 6 personnes."
    ],
    "nl": [
      "La Ferme des Colibris fokt haar dieren op traditionele wijze, met inachtneming van het handvest van de biologische landbouw en het dierenwelzijn. Rechtstreekse verkoop: rundvlees, kalfsvlees, varkensvlees, vleeswaren. Verhuur van een gîte voor 6 personen."
    ],
    "es": [
      "La Ferme des Colibris cría sus animales de forma tradicional, respetando la carta de la agricultura ecológica y el bienestar animal. Venta directa: carne de vacuno, cerdo y charcutería. Alquiler de una casa rural para 6 personas."
    ]
  },
