  "rdfs:comment": {
    "de": [
      "Die Basis und der Freizeitpark bieten während der Sommerferien einen Snackservice à la carte rund um lokale Produkte aus 100% Diois an."
    ],
    "en": [
      "The base and leisure park offers an à la carte snacking service based on 100% Diois local produce during the summer vacations."
    ],
    "it": [
      "Il centro ricreativo offre un percorso avventura sugli alberi, noleggio di canoe, attrezzature per via ferrata e canyoning, canyoning, arrampicata, via ferrata, corsi di arrampicata su roccia e un servizio di snack bar in estate."
    ],
    "fr": [
      "La base de loisirs propose : parcours aventure dans les arbres, location de canoë, de matériel de via ferrata et de canyoning, l'encadrement canyoning, escalade, via ferrata, parcours rochassiers, escalade et un service de snacking en été."
    ],
    "nl": [
      "Het basis- en vrijetijdspark biedt tijdens de zomervakantie een à la carte snackservice op basis van 100% Diois streekproducten."
    ],
    "es": [
      "El centro de ocio ofrece un recorrido de aventura en los árboles, alquiler de canoas, material de vía ferrata y barranquismo, cursos de barranquismo, escalada, vía ferrata, escalada en roca y un servicio de cafetería en verano."
    ]
  },
