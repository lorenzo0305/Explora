  "rdfs:comment": {
    "de": [
      "Am Rande der Balkone des Livradois kann man Sauxillanges nicht erwähnen, ohne die große Abtei von Cluny zu erwähnen, von der das im 10. Jahrhundert gegründete Kloster abhing. Entdecken Sie es vor Ort mithilfe von Tablets, die mit der Clunypédia-App ausgestattet sind."
    ],
    "en": [
      "This small active town with several good restaurants has maintained the souvenir of the former monastery."
    ],
    "it": [
      "Ai margini dei balconi del Livradois, Sauxillanges non può essere menzionata senza parlare della grande abbazia di Cluny, da cui dipendeva il monastero fondato nel X secolo. Potete scoprire tutto sul posto utilizzando i tablet dotati dell'applicazione clunypédia."
    ],
    "fr": [
      "En bordure des balcons du Livradois, on ne peut évoquer Sauxillanges sans parler de la grande abbaye de Cluny dont dépendait le monastère fondé au 10ème siècle. A découvrir sur place grâce aux tablettes équipées de l'application clunypédia."
    ],
    "nl": [
      "In deze dorpskern met een actieve commerce en goede restaurants i de geschiedenis van het belangrijke klooster nog duidelijk aanwezig. Buitenzwembad in juli en augustus."
    ],
    "es": [
      "Al borde de los balcones de Livradois, no se puede hablar de Sauxillanges sin mencionar la gran abadía de Cluny, de la que dependía el monasterio fundado en el siglo X. Podrá descubrirlo todo in situ gracias a las tabletas equipadas con la aplicación clunypédia."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Village Of Sauxillanges - Clunisian Site"
    ],
    "fr": [
      "Sauxillanges, site Clunisien"
    ]
  },
