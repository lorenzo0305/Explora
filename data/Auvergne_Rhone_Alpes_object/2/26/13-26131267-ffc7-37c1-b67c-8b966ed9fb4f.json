  "rdfs:comment": {
    "de": [
      "Die Leitmotive der handwerklichen Seifenherstellung :\r\nRespekt vor den Rohstoffen, Bio, wann immer möglich.\r\nHandwerkliche Herstellung, alles von Hand, in meinem Labor in Valence.\r\nRespekt vor der Umwelt und Null-Abfall."
    ],
    "en": [
      "The key words of the artisan soap factory:\r\nRespect for raw materials, organic whenever possible.\r\nArtisanal production, all by hand, in my laboratory in Valence.\r\nRespect for the environment and zero waste."
    ],
    "it": [
      "Scoprite la Savonnerie Kolibri a Valence. Saponificio artigianale nel cuore della città, produce saponi originali e cosmetici solidi con ingredienti di qualità che rispettano il pianeta."
    ],
    "fr": [
      "Découvrez la Savonnerie Kolibri à Valence. Artisane savonnière en plein cœur de la ville, fabriquant des savons originaux et cosmétiques solides avec des ingrédients de qualité, respectueux de la planète."
    ],
    "es": [
      "Descubra Savonnerie Kolibri en Valence. Jabonería artesanal en el corazón de la ciudad, que fabrica jabones originales y cosméticos sólidos con ingredientes de calidad respetuosos con el planeta."
    ],
    "nl": [
      "De sleutelwoorden van de ambachtelijke zeepfabriek:\r\nRespect voor grondstoffen, biologisch waar mogelijk.\r\nAmbachtelijke productie, alles met de hand, in mijn laboratorium in Valence.\r\nRespect voor het milieu en nul afval."
    ]
  },
  "rdfs:label": {
