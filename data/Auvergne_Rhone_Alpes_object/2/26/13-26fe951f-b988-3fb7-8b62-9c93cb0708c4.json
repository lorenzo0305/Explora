  "rdfs:comment": {
    "de": [
      "Der Félix-Jourdan-Saal befindet sich über dem Tourismusbüro und verfügt über Tische und Stühle.\r\nDer Saal kann über das Rathaus gemietet werden."
    ],
    "en": [
      "Salle Félix Jourdan, located above the Tourist Office, with tables and chairs available.\r\nThe room can be rented from the town hall."
    ],
    "it": [
      "La Salle Félix Jourdan si trova sopra l'Ufficio del Turismo e dispone di tavoli e sedie.\r\nLa sala può essere noleggiata presso il Municipio."
    ],
    "fr": [
      "Salle Félix Jourdan se situant au dessus de l'office de Tourisme, ayant des tables et des chaises à disposition. \r\nLa location de la salle se fait auprès de la mairie."
    ],
    "es": [
      "La Sala Félix Jourdan está situada encima de la Oficina de Turismo y dispone de mesas y sillas.\r\nLa sala se puede alquilar en el Ayuntamiento."
    ],
    "nl": [
      "De Salle Félix Jourdan bevindt zich boven het VVV-kantoor en heeft tafels en stoelen beschikbaar.\r\nDe zaal kan worden gehuurd bij het stadhuis."
    ]
  },
