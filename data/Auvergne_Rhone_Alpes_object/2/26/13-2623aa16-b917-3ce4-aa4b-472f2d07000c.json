  "rdfs:comment": {
    "de": [
      "Im Herzen der Berge gelegen, entdecken Sie diese außergewöhnliche Einrichtung und genießen Sie das Glück der Berge zu jeder Jahreszeit, in voller Freiheit..."
    ],
    "en": [
      "In the heart of the mountain, come and discover this exceptional establishment and taste the happiness of the mountain in any season, in total freedom..."
    ],
    "it": [
      "Nel cuore delle montagne, venite a scoprire questa struttura eccezionale e godetevi i piaceri della montagna in tutte le stagioni, in piena libertà..."
    ],
    "fr": [
      "Au cœur de la montagne, venez découvrir cet établissement d’exception et goûter au bonheur de la montagne en toute saison, en toute liberté…"
    ],
    "nl": [
      "Kom in het hart van de bergen dit uitzonderlijke etablissement ontdekken en geniet van de geneugten van de bergen in alle seizoenen, in alle vrijheid.."
    ],
    "es": [
      "En el corazón de la montaña, venga a descubrir este establecimiento excepcional y disfrute de los placeres de la montaña en todas las estaciones, con total libertad..."
    ]
  },
