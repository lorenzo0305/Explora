  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Martin-du-Fresne ist mit zwei Picknickplätzen ausgestattet, dieser befindet sich auf der Route de Chamoise am Ortsausgang von Saint Martin du Fresne."
    ],
    "en": [
      "The commune of Saint-Martin-du-Fresne is equipped with two picnic areas, this one on route de Chamoise, just outside the village of Saint Martin du Fresne."
    ],
    "it": [
      "Il comune di Saint-Martin-du-Fresne dispone di due aree picnic, una delle quali si trova sulla strada Chamoise, alla periferia di Saint Martin du Fresne."
    ],
    "fr": [
      "La commune de Saint-Martin-du-Fresne est équipée de deux aires de pique-nique, celle-ci se trouve route de Chamoise à la sortie du bourg de Saint Martin du Fresne."
    ],
    "es": [
      "El municipio de Saint-Martin-du-Fresne cuenta con dos merenderos, uno de ellos situado en la carretera de Chamoise, a las afueras de Saint Martin du Fresne."
    ],
    "nl": [
      "De gemeente Saint-Martin-du-Fresne heeft twee picknickplaatsen, waarvan er een aan de weg van Chamoise aan de rand van Saint Martin du Fresne ligt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique de Saint-Martin-du-Fresne"
    ]
  },
