  "rdfs:comment": {
    "de": [
      "Bei einem Familienurlaub, einem Ausflug zu zweit, einer Sightseeing-Tour in Gruppen oder einer Abendveranstaltung werden Sie den zeitgemäßen Komfort Ihres Zimmers unter den 20 Zimmern des Hotels zu schätzen wissen."
    ],
    "en": [
      "Whether you're on a family vacation, a romantic getaway, a group sightseeing tour or an evening stopover, you'll appreciate the contemporary comfort of one of the hotel's 20 rooms."
    ],
    "it": [
      "Che si tratti di una vacanza in famiglia, di una fuga romantica, di un giro turistico di gruppo o di una sosta serale, apprezzerete il comfort contemporaneo di una delle 20 camere dell'hotel."
    ],
    "fr": [
      "Lors de vacances en famille, d'une escapade en amoureux, d'un circuit touristique en groupes ou d'une soirée-étape, vous apprécierez le confort contemporain de votre chambre parmi les 20 que compte l'hôtel."
    ],
    "es": [
      "Tanto si está de vacaciones en familia, como en una escapada romántica, una visita turística en grupo o una escala nocturna, apreciará la comodidad contemporánea de una de las 20 habitaciones del hotel."
    ],
    "nl": [
      "Het Hotel Bellevue biedt u comfortabele kamers, een verwarmd zwembad, 2 spa's (optioneel), restaurant met traditionele keuken en specialiteiten uit de Ardèche, privéparking voor auto's en touringcars die 's nachts gesloten zijn, tussenstop voor moto's en een fietsenstalling."
    ]
  },
