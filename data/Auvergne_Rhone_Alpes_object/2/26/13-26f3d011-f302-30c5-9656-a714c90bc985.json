  "rdfs:comment": {
    "de": [
      "Kommen Sie zu Lorraine ins Reitzentrum Les Poneys de Penol, sie wird Sie bei Kursen, Ausritten in Wettbewerben oder in der Freizeit begleiten, von 7 bis 99 Jahren. Gruppen von maximal 6 Reitern."
    ],
    "en": [
      "Come and join Lorraine in the equestrian center Les Poneys de Penol. She will accompany you in courses and walks in competition or leisure. For everyone from 2 to 99 years old.\r\nGroups of 6 riders maximum."
    ],
    "it": [
      "Raggiungete Lorraine al centro ippico Les Poneys de Penol, dove vi accompagnerà in lezioni, cavalcate da competizione o per il tempo libero, dai 7 ai 99 anni. Gruppi di massimo 6 cavalieri."
    ],
    "fr": [
      "Venez rejoindre Lorraine au centre équestre les Poneys de Penol, elle vous accompagnera dans des cours, balades en compétition ou en loisirs, de 7 à 99 ans. Groupe de 6 cavaliers maximum."
    ],
    "es": [
      "Venga a unirse a Lorraine en el centro ecuestre Les Poneys de Penol, donde le acompañará en clases, paseos de competición o paseos de ocio, de 7 a 99 años. Grupos de 6 jinetes como máximo."
    ],
    "nl": [
      "Kom naar Lorraine op manege Les Poneys de Penol, waar ze je begeleidt tijdens lessen, wedstrijdritten of vrijetijdsritten, van 7 tot 99 jaar. Groepen van maximaal 6 ruiters."
    ]
  },
