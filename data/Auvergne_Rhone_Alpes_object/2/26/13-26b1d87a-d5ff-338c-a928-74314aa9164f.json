  "rdfs:comment": {
    "de": [
      "Der Bahnhof von Vichy spielte eine zentrale Rolle bei der Entwicklung der Stadt. Jahrhundert erlebten die Thermalbäder in Europa einen großen Aufschwung."
    ],
    "en": [
      "Vichy's railway station played a central role in the town's development. In the 19th century, the spa industry took off in Europe."
    ],
    "it": [
      "La stazione ferroviaria di Vichy ha avuto un ruolo centrale nello sviluppo della città. Nel XIX secolo, l'industria termale decolla in Europa."
    ],
    "fr": [
      "La gare de Vichy a joué un rôle central dans le développement de la ville. Au XIXe siècle, le thermalisme connaît un essor important en Europe."
    ],
    "es": [
      "La estación de ferrocarril de Vichy desempeñó un papel fundamental en el desarrollo de la ciudad. En el siglo XIX, la industria termal despega en Europa."
    ],
    "nl": [
      "Het treinstation van Vichy speelde een centrale rol in de ontwikkeling van de stad. In de 19e eeuw nam de kuurindustrie in Europa een grote vlucht."
    ]
  },
