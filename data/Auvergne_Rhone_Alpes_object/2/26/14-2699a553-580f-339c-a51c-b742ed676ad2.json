  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/20c3d646-9937-3505-af98-70e40cf5c058",
      "dc:description": {
        "de": [
          "Machen Sie sich auf den Weg, um Benifontaine zu entdecken. Mit den Stöcken in der Hand führt Sie die Anstrengung von landwirtschaftlichen Landschaften zu den Überresten des Bergbaus und nicht zuletzt zu unserer Brauereitradition!"
        ],
        "en": [
          "Set off with determination to discover Bénifontaine. Sticks in hand, the effort will take you from agricultural landscapes to mining relics, not forgetting our brewing tradition!"
        ],
        "it": [
          "Partite con determinazione alla scoperta della Bénifontaine. Con i bastoncini in mano, lo sforzo vi porterà dai paesaggi agricoli ai resti minerari, senza dimenticare la nostra tradizione birraria!"
        ],
        "fr": [
          "Partez d’un pas décidé à la découverte de Bénifontaine. Bâtons en main, l’effort vous conduira de paysages agricoles en vestiges miniers, sans oublier notre tradition brassicole !"
        ],
        "nl": [
          "Vertrek vastberaden om Bénifontaine te ontdekken. Met stokken in de hand brengt de tocht je van agrarische landschappen tot overblijfselen uit de mijnbouw en niet te vergeten onze brouwerstraditie!"
        ],
        "es": [
          "Salga con determinación a descubrir Bénifontaine. Bastón en mano, el esfuerzo le llevará de los paisajes agrícolas a los vestigios mineros, ¡sin olvidar nuestra tradición cervecera!"
        ]
      },
      "@type": [
        "Description"
