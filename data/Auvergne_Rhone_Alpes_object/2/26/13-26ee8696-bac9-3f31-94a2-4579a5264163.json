  "rdfs:comment": {
    "de": [
      "Betreten Sie den Entspannungsbereich von Cristal des Alpes: Hammam mit blauem Mosaik, Jacuzzi, Sauna mit Eisbrunnen, Zeit für eine Pause. Gehen Sie zurück zu den Wurzeln und entdecken Sie einen Ort, der dem Wohlbefinden gewidmet ist, vertraulich und raffiniert in Arêches -Beaufort!"
    ],
    "en": [
      "Access to the relaxation area of Cristal des Alpes: blue mosaic hammam, jacuzzi, sauna with its ice fountain, for a break. a place dedicated to well-being, confidential and refined in Arêches -Beaufort!"
    ],
    "it": [
      "Fate una pausa nell'area relax Cristal des Alpes: hammam a mosaico blu, jacuzzi e sauna con fontana di ghiaccio. Tornate alle origini e scoprite un luogo dedicato al benessere, riservato e raffinato ad Arêches-Beaufort!"
    ],
    "fr": [
      "Accédez à l'espace détente de Cristal des Alpes : hammam de mosaïque bleue, jacuzzi, sauna avec sa fontaine de glace, le temps d’une pause. Retour aux sources à la découverte d’un lieu dédié au bien-être, confidentiel et raffiné à Arêches -Beaufort !"
    ],
    "nl": [
      "Toegang tot de ontspanningsruimte van Cristal des Alpes: blauwe mozaïek hamam, jacuzzi, sauna met ijsfontein, voor een pauze. Een plek gewijd aan welzijn, vertrouwelijk en verfijnd in Arêches -Beaufort!"
    ],
    "es": [
      "Tómese un respiro en la zona de relajación Cristal des Alpes: hammam de mosaico azul, jacuzzi y sauna con fuente de hielo. ¡Vuelva a lo esencial y descubra un lugar dedicado al bienestar, confidencial y refinado en Arêches-Beaufort!"
    ]
  },
