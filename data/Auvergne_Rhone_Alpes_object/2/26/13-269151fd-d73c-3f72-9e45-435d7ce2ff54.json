      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/81928696-50b3-3493-8d9f-c9140d98c55c",
          "schema:validFrom": "2026-10-16T00:00:00",
          "schema:validThrough": "2026-10-16T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Montags geschlossen.\r\n\r\ndienstag, Mittwoch, Donnerstag: von 7:30 bis 14:00 Uhr und von 17:00 bis 21:00 Uhr\r\n\r\nfreitag und Samstag: 07:30 bis 14:00 Uhr und 17:00 bis 00:00 Uhr, wenn es Gäste gibt, wird die Öffnungszeit bis 02:00 Uhr verlängert.\r\n\r\nSonntag von 07:30 bis 14:00 Uhr\r\n\r\nDie Öffnungszeiten am Wochenende hängen von den Gästen ab , wenn wir Buchungen bis Mitternacht oder 02:00 Uhr haben"
            ],
            "en": [
              "Closed on Mondays.\r\n\r\ntuesday, Wednesday, Thursday: 07:30 to 14:00 and 17:00 to 21:00\r\n\r\nfriday and saturday from 07h30 to 14h and from 17h to 00h if there are customers it will be extended until 02h00.\r\n\r\nSunday from 07h30 to 14h00\r\n\r\nWeekend opening times depend on customers, if we have bookings until midnight or 02:00 a.m"
            ],
            "it": [
              "Chiuso il lunedì.\r\n\r\nmartedì, mercoledì e giovedì: dalle 7.30 alle 14.00 e dalle 17.00 alle 21.00\r\n\r\nvenerdì e sabato dalle 07:30 alle 14:00 e dalle 17:00 alle 00:00 se ci sono clienti sarà prolungato fino alle 02:00.\r\n\r\nDomenica dalle 07h30 alle 14h00\r\n\r\nGli orari di apertura del fine settimana dipendono dai clienti, se abbiamo prenotazioni fino a mezzanotte o alle 02:00"
            ],
            "fr": [
              "Fermé le lundi.\r\n\r\nmardi, mercredi, jeudi:  de 07h30 à 14h et de 17h à 21h\r\n\r\nvendredi et samedi de 07h30 à 14h et de 17h à 00h s'il y a des clients il sera prolongé jusqu'à 02h00.\r\n\r\nDimanche de 07h30 à 14h00 \r\n\r\nLes horaires de week-end dépendent des clients , si nous avons des réservations jusqu’à minuit ou 02 h du matin"
            ],
            "nl": [
              "Gesloten op maandag.\r\n\r\ndinsdag, woensdag, donderdag: 7.30 tot 14.00 uur en 17.00 tot 21.00 uur\r\n\r\nvrijdag en zaterdag van 07.30 tot 14.00 uur en van 17.00 tot 00.00 uur als er klanten zijn wordt het verlengd tot 02.00 uur.\r\n\r\nZondag van 07.30 tot 14.00 uur\r\n\r\nWeekend openingstijden zijn afhankelijk van klanten, als we boekingen hebben tot middernacht of 02:00 uur"
            ],
            "es": [
              "Cerrado los lunes.\r\n\r\nmartes, miércoles y jueves: de 7.30 a 14.00 h. y de 17.00 a 21.00 h\r\n\r\nviernes y sábado de 07h30 a 14h y de 17h a 00h si hay clientes se ampliará hasta las 02h00.\r\n\r\nDomingo de 07h30 a 14h00\r\n\r\nLos horarios de fin de semana dependen de los clientes, si tenemos reservas hasta medianoche o hasta las 02h00"
            ]
          },
