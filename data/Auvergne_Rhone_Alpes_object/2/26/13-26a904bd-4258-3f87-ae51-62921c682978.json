  "rdfs:comment": {
    "de": [
      "Saal mit 312 Plätzen, digitale und 3D-Ausstattung, 2 bis 3 Filme täglich, etwa 15 verschiedene Filme pro Woche mit Vorpremieren, nationalen Kinostarts und den besten Filmen des Augenblicks."
    ],
    "en": [
      "334 seats, 3D and digital equipment, 2 to 4 films a day, a dozen different films every week, including screenings, national releases and the best current films."
    ],
    "it": [
      "Cinema da 334 posti, attrezzature digitali e 3D, da 2 a 4 film al giorno, una quindicina ilm diversi ogni settimana con anteprime, uscite nazionali e i migliori film del momento."
    ],
    "fr": [
      "Salle de 312 places, équipement numérique et 3D, 2 à 3 films chaque jour, une quinzaine de films différents chaque semaine avec des avant-premières, des sorties nationales et les meilleurs films du moment."
    ],
    "nl": [
      "Zaal met 334 zitplaatsen, numeriek en 3D materiaal, 2 à 4 films per dag, zo'n vijftien verschillende films per week met premières, nationale lancering en de beste films op dat moment."
    ],
    "es": [
      "Auditorio de 312 plazas, equipos digitales y 3D, de 2 a 3 películas cada día, unas 15 películas diferentes cada semana con preestrenos, estrenos nacionales y las mejores películas del momento."
    ]
  },
