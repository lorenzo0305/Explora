  "rdfs:comment": {
    "de": [
      "La Boutique Ethique gibt es seit 14 Jahren. Von Anfang an hat sich die Boutique dafür entschieden, lokale Marken wie die emblematischen Schuhe Made In Romans, Durance oder ZAO Kosmetik aufzuwerten und Kleidung aus französischer Herstellung anzubieten."
    ],
    "en": [
      "Boutique Ethique has been in business for 14 years. From the outset, the boutique has chosen to promote local brands, such as the emblematic Made In Romans shoes, Durance or ZAO cosmetics, and to offer French-made clothing."
    ],
    "it": [
      "Boutique Ethique è in attività da 14 anni. Fin dall'inizio, il negozio ha scelto di promuovere i marchi locali, come le emblematiche scarpe Made In Romans, i cosmetici Durance e ZAO, e di offrire abbigliamento di produzione francese."
    ],
    "fr": [
      "La Boutique Ethique existe depuis 14 ans. Dès ses débuts, la boutique a choisi de valoriser des marques locales, telles que les emblématiques chaussures Made In Romans, Durance ou ZAO cosmétique, et de proposer des vêtements de fabrication française."
    ],
    "es": [
      "Boutique Ethique lleva 14 años en el mercado. Desde el principio, la tienda ha optado por promover las marcas locales, como los emblemáticos zapatos Made In Romans, los cosméticos Durance y ZAO, y ofrecer ropa de fabricación francesa."
    ],
    "nl": [
      "Boutique Ethique bestaat al 14 jaar. Vanaf het begin heeft de winkel ervoor gekozen om lokale merken te promoten, zoals de emblematische Made In Romans schoenen, Durance en ZAO cosmetica, en om Franse kleding aan te bieden."
    ]
  },
