  "rdfs:comment": {
    "de": [
      "Die Identität der Brauerei entstand aus der Liebe der Besitzer zu Rockmusik und Bier. Diese Brauer haben versucht, sich sowohl durch den Geschmack ihrer Biere als auch durch ihre Namen von der Masse abzuheben."
    ],
    "en": [
      "The brewery's identity stems from the owners' love of rock and beer. These brewers have tried to set themselves apart both in the taste of their beers and in their names."
    ],
    "it": [
      "L'identità del birrificio deriva dall'amore dei proprietari per il rock e la birra. Questi birrai hanno cercato di distinguersi sia per il gusto delle loro birre che per i loro nomi."
    ],
    "fr": [
      "L'identité de la brasserie est issue de l'amour des propriétaires pour le rock et la bière. Ces brasseurs ont essayé de se démarquer tant au niveau des goûts de leur bières qu'au niveau de leur noms."
    ],
    "es": [
      "La identidad de la cervecería nace del amor de sus propietarios por el rock y la cerveza. Estos cerveceros han intentado destacar tanto por el sabor de sus cervezas como por sus nombres."
    ],
    "nl": [
      "De identiteit van de brouwerij komt voort uit de liefde van de eigenaars voor rock en bier. Deze brouwers hebben geprobeerd zich te onderscheiden, zowel in de smaak van hun bieren als in hun namen."
    ]
  },
  "rdfs:label": {
