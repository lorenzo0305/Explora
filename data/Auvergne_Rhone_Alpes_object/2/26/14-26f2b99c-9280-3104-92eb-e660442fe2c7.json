      "@id": "https://data.datatourisme.fr/97503270-9c60-3c36-a45e-c484399e9f7e",
      "dc:description": {
        "de": [
          "Friseursalon mit Sitz in Montreuil-sur-Mer.\nRecycling von abgeschnittenen Haaren.\n\nÖffnungszeiten:\nmontag: 09:00 - 18:00\ndienstag: 09:00 - 19:00\nmittwoch: 09:00 - 19:00\ndonnerstag: 09:00 - 19:00\nfreitag: 09:00 - 19:00\nsamstag: 09:00 - 18:00"
        ],
        "en": [
          "Hair salon located in Montreuil-sur-Mer.\nRecycling of cut hair.\n\nOpening hours :\nmonday: 09:00 - 18:00\ntuesday: 09:00 - 19:00\nwednesday: 09:00 - 19:00\nthursday: 09:00 - 19:00\nfriday: 09:00 - 19:00\nsaturday: 09:00 - 18:00"
        ],
        "it": [
          "Salone di parrucchieri situato a Montreuil-sur-Mer.\nRiciclaggio dei capelli tagliati.\n\nOrari di apertura :\nlunedì: 09:00 - 18:00\nmartedì: 09:00 - 19:00\nmercoledì: 09:00 - 19:00\ngiovedì: 09:00 - 19:00\nvenerdì: 09:00 - 19:00\nsabato: 09:00 - 18:00"
        ],
        "fr": [
          "Salon de coiffure situé à Montreuil-sur-Mer. \nRecyclage des cheveux coupés. \n\nHoraires : \nlundi: 09:00 - 18:00\nmardi: 09:00 - 19:00\nmercredi: 09:00 - 19:00\njeudi: 09:00 - 19:00\nvendredi: 09:00 - 19:00\nsamedi: 09:00 - 18:00"
        ],
        "es": [
          "Salón de peluquería situado en Montreuil-sur-Mer.\nReciclaje del cabello cortado.\n\nHorario de apertura :\nlunes: 09:00 - 18:00\nmartes: 09:00 - 19:00\nmiércoles: 09:00 - 19:00\njueves: 09:00 - 19:00\nviernes: 09:00 - 19:00\nsábado: 09:00 - 18:00"
        ],
        "nl": [
          "Kapsalon gevestigd in Montreuil-sur-Mer.\nRecycling van geknipt haar.\n\nOpeningstijden :\nmaandag: 09:00 - 18:00\ndinsdag: 09:00 - 19:00\nwoensdag: 09:00 - 19:00\ndonderdag: 09:00 - 19:00\nvrijdag: 09:00 - 19:00\nzaterdag: 09:00 - 18:00"
        ]
      },
