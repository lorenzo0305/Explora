  "rdfs:comment": {
    "de": [
      "Das Casino von Néris-les-Bains lädt Sie ein, seine Aktivitäten und Freizeitangebote zu entdecken: Spielautomaten, Blackjack-Tische, elektronisches Roulette und Blackjack, Restaurant und Bar mit Ambiente.\r\nEin gültiger Personalausweis ist erforderlich. Volljährig sein."
    ],
    "en": [
      "The Casino de Néris-les-Bains invites you to discover its activities and leisure facilities: slot machines, blackjack tables, electronic roulette and blackjack, restaurant and bar.\r\nValid ID required. Must be of legal age."
    ],
    "it": [
      "Il Casinò di Néris-les-Bains vi invita a scoprire le sue attività e strutture per il tempo libero: slot machine, tavoli da blackjack, roulette e blackjack elettronici, ristorante e bar.\r\nDocumento d'identità valido. Età minima per accedere al casinò."
    ],
    "fr": [
      "Le Casino de Néris-les-Bains vous invite à découvrir ses activités et ses loisirs: machines à sous, tables de Blackjack, roulette et Blackjack électroniques, restaurant et bar d'ambiance.\r\nPièce d’identité en cours de validité. Etre majeur."
    ],
    "nl": [
      "Het Casino de Néris-les-Bains nodigt je uit om zijn activiteiten en vrijetijdsvoorzieningen te ontdekken: speelautomaten, blackjacktafels, elektronische roulette en blackjack, restaurant en bar.\r\nGeldig identiteitsbewijs. Je moet meerderjarig zijn."
    ],
    "es": [
      "El Casino de Néris-les-Bains le invita a descubrir sus actividades e instalaciones de ocio: máquinas tragaperras, mesas de blackjack, ruleta y blackjack electrónicos, restaurante y bar.\r\nDocumento de identidad válido. Ser mayor de edad."
    ]
  },
