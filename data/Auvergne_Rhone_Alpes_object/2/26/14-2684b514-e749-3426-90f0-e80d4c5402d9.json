  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a212a23e-c803-34a5-8024-5b94eaca2179",
      "dc:description": {
        "de": [
          "Restaurant-Bar.\nJeden Freitagabend Pizza vor Ort oder zum Mitnehmen.\nEin einfaches und gemütliches Restaurant am Straßenrand, das abwechslungsreiche lokale Gerichte anbietet."
        ],
        "en": [
          "Restaurant-Bar.\nPizza on site or to take away every Friday evening.\nA simple, friendly roadside restaurant offering a variety of local dishes."
        ],
        "it": [
          "Ristorante-bar.\nPizza sul posto o da asporto ogni venerdì sera.\nUn ristorante di strada semplice e accogliente che offre una varietà di piatti locali."
        ],
        "fr": [
          "Restaurant-Bar. \nPizza sur place ou à emporter tous les vendredis soirs. \nUn restaurant simple et convivial en bord de route, offrant des plats locaux variés."
        ],
        "es": [
          "Restaurante-Bar.\nPizza en el local o para llevar todos los viernes por la noche.\nRestaurante de carretera sencillo y acogedor que ofrece una gran variedad de platos locales."
        ],
        "nl": [
          "Restaurant-Bar.\nPizza ter plekke of om mee te nemen, elke vrijdagavond.\nEen eenvoudig, vriendelijk wegrestaurant met een verscheidenheid aan lokale gerechten."
        ]
      },
