  "rdfs:comment": {
    "de": [
      "Animation Vacances Loisirs ist ein Verein, der Ferienlager für Kinder und Jugendliche von 6 bis 17 Jahren anbietet.\r\nDer Verein hat sich dafür entschieden, die Anzahl der Aufenthalte zu begrenzen und so der Qualität der angebotenen kulturellen und sportlichen Aktivitäten den Vorzug zu geben."
    ],
    "en": [
      "Animation Vacances Loisirs is an association offering summer camps for children and young people aged 6 to 17.\r\nThe association has chosen to limit the number of stays, giving priority to the quality of the cultural and sporting activities on offer."
    ],
    "it": [
      "Animation Vacances Loisirs è un'associazione che propone campi estivi per bambini e ragazzi dai 6 ai 17 anni.\r\nL'associazione ha scelto di limitare il numero di soggiorni, privilegiando la qualità delle attività culturali e sportive proposte."
    ],
    "fr": [
      "Animation Vacances Loisirs est une association proposant des colos pour les enfants et les jeunes de 6 à 17 ans.\r\nL'association a choisi de limiter le nombre de séjours privilégiant ainsi la qualité des activités culturelles et sportives proposées."
    ],
    "nl": [
      "Animation Vacances Loisirs is een vereniging die zomerkampen aanbiedt voor kinderen en jongeren van 6 tot 17 jaar.\r\nDe vereniging heeft ervoor gekozen om het aantal verblijven te beperken, waarbij de kwaliteit van de aangeboden culturele en sportieve activiteiten voorop staat."
    ],
    "es": [
      "Animation Vacances Loisirs es una asociación que ofrece campamentos de verano para niños y jóvenes de 6 a 17 años.\r\nLa asociación ha optado por limitar el número de estancias, dando prioridad a la calidad de las actividades culturales y deportivas propuestas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Loisirs Animation Vacances Vassieux"
    ]
  },
