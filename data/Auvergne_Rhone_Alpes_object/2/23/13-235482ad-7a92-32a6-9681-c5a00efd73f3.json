  "rdfs:comment": {
    "de": [
      "Schlendern Sie durch die Straßen der mittelalterlichen Stadt und entdecken Sie die schönsten Gebäude und ihre Geschichte.\r\nNur mit vorheriger Reservierung. Start der Tour mit mindestens 4 Personen."
    ],
    "en": [
      "Stroll through the streets of the medieval town, discovering its most beautiful buildings and their history.\r\nReservations required. Tours depart with a minimum of 4 people."
    ],
    "it": [
      "Passeggiate per le vie della città medievale e scoprite i suoi edifici più belli e la loro storia.\r\nPrenotazione obbligatoria. I tour partono con un minimo di 4 persone."
    ],
    "fr": [
      "Sillonnez les rues de la cité médiévale à la découverte des plus beaux édifices et de leur histoire.\r\nSur réservation. Départ de la visite avec 4 personnes minimum."
    ],
    "nl": [
      "Wandel door de straten van de middeleeuwse stad en ontdek de mooiste gebouwen en hun geschiedenis.\r\nReserveren verplicht. Rondleidingen beginnen bij een minimum van 4 personen."
    ],
    "es": [
      "Pasee por las calles de la ciudad medieval y descubra sus edificios más bellos y su historia.\r\nReserva obligatoria. Las visitas comienzan con un mínimo de 4 personas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Il était une fois la cité médiévale de Montluçon"
    ]
  },
