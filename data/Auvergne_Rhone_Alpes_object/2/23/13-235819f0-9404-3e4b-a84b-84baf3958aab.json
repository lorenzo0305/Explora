  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere schöne Auswahl an Fliegen, Schals und Tüchern aus Seide. Die Tücher werden in Lyon oder in einem Umkreis von 50 km hergestellt. Produkte made in France garantiert!"
    ],
    "en": [
      "Come and discover a beautiful selection of silk bow ties, scarves and headscarves. The fabrics are all made within 50 km of Lyon. They are guaranteed Made in France!"
    ],
    "it": [
      "Venite a scoprire la nostra splendida selezione di nodi a farfalla, sciarpe e foulard di seta. I tessuti sono prodotti a Lione o nel raggio di 50 km. Prodotti made in France garantiti!"
    ],
    "fr": [
      "Venez découvrir notre belle sélection de nœuds papillon, d’écharpes et de foulards en soie. Les tissus sont fabriqués à Lyon ou dans un rayon de 50 km. Produits made in France garantis !"
    ],
    "es": [
      "Venga a descubrir nuestra hermosa selección de nudos de mariposa, pañuelos y bufandas de seda. Los tejidos se fabrican en Lyon o en un radio de 50 km. Productos fabricados en Francia garantizados"
    ],
    "nl": [
      "Kom en ontdek onze prachtige selectie van vlinderdassen, sjaals en zijden sjaals. De stoffen worden gemaakt in Lyon of binnen een straal van 50 km. Producten gemaakt in Frankrijk gegarandeerd!"
    ]
  },
