      "rdfs:comment": {
        "de": [
          "Finden Sie die schönen Erdbeeren von Mai bis Oktober, um daraus köstliche Desserts zu machen, aber auch Obst und Gemüse, Marmeladen in den Schließfächern unserer ländlichen Gegenden, die täglich von 8 bis 20 Uhr geöffnet sind."
        ],
        "en": [
          "Find the beautiful strawberries from May to October to make delicious desserts but also fruits and vegetables, jams in the racks of our countryside open every day from 8am to 8pm."
        ],
        "it": [
          "Trovate le splendide fragole da maggio a ottobre per preparare deliziosi dessert, ma anche frutta e verdura, marmellate negli scaffali della nostra campagna aperti tutti i giorni dalle 8.00 alle 20.00."
        ],
        "fr": [
          "Retrouvez les belles fraises de mai à octobre pour en faire de délicieux desserts mais aussi les fruits et légumes, confitures aux casiers de nos campagnes ouvert tous les jours de 8h à 20h."
        ],
        "nl": [
          "Vind de prachtige aardbeien van mei tot oktober om heerlijke desserts te maken maar ook fruit en groenten, jam in de rekken van ons platteland elke dag geopend van 8 tot 20 uur."
        ],
        "es": [
          "Encuentre las hermosas fresas de mayo a octubre para hacer deliciosos postres, pero también frutas y verduras, mermeladas en los estantes de nuestro campo abierto todos los días de 8 a 20 horas."
        ]
      },
