  "rdfs:comment": {
    "de": [
      "Das Wood Café ist ein Coffeeshop im Zentrum des Dorfes, der in einem warmen und gemütlichen Rahmen Frühstück, Brunch, Gebäck und Gerichte zum Teilen anbietet."
    ],
    "en": [
      "The Wood Café is a coffee shop located in the center of the village which offers, in a warm and friendly setting, breakfasts, brunches, pastries and dishes to share."
    ],
    "it": [
      "Il Wood Café è una caffetteria nel centro del paese che offre colazioni, brunch, dolci e piatti da condividere in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Le Wood  Café est un coffee shop installé en plein centre du village qui propose dans un cadre chaleureux et convivial, petits déjeuners, brunchs, pâtisseries et plats à partager."
    ],
    "nl": [
      "Het Wood Café is een coffeeshop in het centrum van het dorp die in een warme en vriendelijke omgeving ontbijt, brunch, gebak en gerechten biedt om te delen."
    ],
    "es": [
      "El Wood Café es una cafetería situada en el centro del pueblo que ofrece desayunos, brunches, pasteles y platos para compartir en un ambiente cálido y acogedor."
    ]
  },
