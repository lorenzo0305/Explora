  "rdfs:comment": {
    "de": [
      "Nehmen Sie diesen Samstag, den 14. Juni, ab 11 Uhr am Familienfest teil.\r\nWir treffen uns mit Ihnen im Kurpark, wo Sie den ganzen Tag über an Aktivitäten allein und zu zweit sowie an spielerischen und kreativen Momenten für die ganze Familie teilnehmen können."
    ],
    "en": [
      "Join us for the Fête des Familles on Saturday June 14th from 11am.\r\nWe look forward to seeing you in the spa park, where you can take part in solo and duo activities, as well as family fun and creative activities throughout the day."
    ],
    "it": [
      "Sabato 14 giugno, a partire dalle 11.00, venite a divertirvi in famiglia.\r\nVi aspettiamo nel parco termale, dove potrete partecipare ad attività individuali e di gruppo, oltre a divertenti e creative attività per famiglie durante tutta la giornata."
    ],
    "fr": [
      "Participez à la fête des familles ce samedi 14 juin à partir de 11h.\r\nNous vous donnons rendez-vous dans le parc thermal pour participer à des activités seul et en duo ainsi qu'à des moments ludiques et créatifs en famille tout au long de la journée."
    ],
    "es": [
      "Ven a divertirte en familia este sábado 14 de junio a partir de las 11 de la mañana.\r\nTe esperamos en el parque del balneario, donde podrás participar en actividades individuales y de grupo, así como en divertidas y creativas actividades familiares durante todo el día."
    ],
    "nl": [
      "Kom zaterdag 14 juni vanaf 11.00 uur naar het familiepretpark.\r\nWe zien je graag in het kuurpark, waar je de hele dag kunt deelnemen aan individuele en groepsactiviteiten en leuke en creatieve gezinsactiviteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête des Familles - Samedi 14 juin de 11h00 à 15h30"
    ]
  },
