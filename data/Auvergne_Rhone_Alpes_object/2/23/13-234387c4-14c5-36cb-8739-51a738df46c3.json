  "rdfs:comment": {
    "de": [
      "Eine sehr schöne Enduro-Route, die sich an bereits erfahrene Fahrer richtet. Es ist einer der wenigen Wege, die von Alpe d'Huez nach Bourg-d'Oisans hinunterführen."
    ],
    "en": [
      "This great enduro route is perfect for experienced bikers. It’s one of the rare tracks that leads down to Bourg-d’Oisans from Alpe d’Huez."
    ],
    "it": [
      "Si tratta di un ottimo percorso di enduro, rivolto a corridori che hanno già una certa esperienza. È uno dei pochi percorsi che dall'Alpe d'Huez portano a Bourg-d'Oisans."
    ],
    "fr": [
      "Très bel itinéraire typé enduro, destiné à des pratiquants déjà débrouillés. C’est l’un des rares sentiers qui permet de descendre sur Bourg-d’Oisans depuis l’Alpe d’Huez."
    ],
    "es": [
      "Se trata de una gran ruta de enduro, dirigida a pilotos que ya tienen cierta experiencia. Es uno de los pocos senderos que bajan a Bourg-d'Oisans desde Alpe d'Huez."
    ],
    "nl": [
      "Heel mooi parcours type Enduro, bestemd voor ervaren fietsers.  Dit is één van de zeldzame paden die het mogelijk maakt om vanuit Alpe d'Huez af te dalen tot in Bourg d'Oisans."
    ]
  },
  "rdfs:label": {
    "en": [
      "Forêt de l'Ours via the Combe du Bras"
    ],
    "fr": [
      "La forêt de l'Ours par la Combe du Bras"
    ],
    "nl": [
      "La forêt de l'ours via la combe du Bras"
    ]
  },
