  "rdfs:comment": {
    "de": [
      "Das Spa Océane bietet eine vielfältige Pflegekarte: verschiedene Arten von Massagen (entspannend, heiße Steine, Sport, Fußreflexzonenmassage), Algotherm-Gesichtsbehandlungen (30min, 55min oder 1h25) sowie Körperbehandlungen (Peelings, Schlankheitspflege)."
    ],
    "en": [
      "The Océane Spa offers a varied treatment card: different types of massages (relaxing, hot stones, sports, foot reflexology), Algotherm facials (30min, 55 min or 1h25) as well as body treatments (scrubs, slimming treatments )."
    ],
    "it": [
      "La spa Océane offre un'ampia gamma di trattamenti: diversi tipi di massaggi (rilassante, con pietre calde, sportivo, riflessologia plantare), trattamenti viso Algotherm (30 minuti, 55 minuti o 1h25) e trattamenti corpo (scrub, trattamenti dimagranti)."
    ],
    "fr": [
      "Le spa Océane propose une carte de soins variés : différents types de massages (relaxant, pierres chaudes, sportif, réflexologie plantaire), des soins du visage Algotherm (30min, 55 min ou 1h25) ainsi que des soins du corps (gommages, soins minceur)."
    ],
    "es": [
      "El spa Océane ofrece una amplia gama de tratamientos: diferentes tipos de masajes (relajantes, con piedras calientes, deportivos, reflexología podal), tratamientos faciales Algotherm (30min, 55 min o 1h25) así como tratamientos corporales (exfoliantes, tratamientos adelgazantes)."
    ],
    "nl": [
      "De Spa Océane biedt diverse wellnessbehandelingen: allerlei massages (ontspannende massage, met hete keien, sportmassage, voetreflexologie), Algotherm gezichtsbehandelingen (30 min, 55 min of 1u25), maar ook lichaamsbehandelingen (scrubs, afslank behandelingen)."
    ]
  },
