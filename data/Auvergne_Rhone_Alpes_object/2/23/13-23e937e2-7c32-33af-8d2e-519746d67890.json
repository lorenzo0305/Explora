  "rdfs:comment": {
    "de": [
      "Erleben Sie einen geselligen und genussvollen Moment bei unseren Besichtigungen und Verkostungen von unserer Ölmühle bis zu unserer handwerklichen Destillerie. Zwischen Tradition und Leidenschaft lädt Sie unser Familiengut nach vorheriger Anmeldung ein, sein Know-how zu entdecken."
    ],
    "en": [
      "Come and enjoy a convivial, gourmet experience with tours and tastings from our oil mill to our artisanal distillery. Our family-run estate is steeped in tradition and passion, and invites you to discover its expertise by reservation only."
    ],
    "it": [
      "Venite a vivere un'esperienza conviviale e gastronomica con visite e degustazioni al nostro frantoio e alla nostra distilleria tradizionale. La nostra azienda a conduzione familiare, ricca di tradizione e passione, vi invita a scoprire le sue competenze su prenotazione."
    ],
    "fr": [
      "Venez vivre un moment convivial et gourmand à travers nos visites et dégustations de notre moulin à huile à notre distillerie artisanale. Entre tradition et passion, notre domaine familial vous invite à découvrir son savoir-faire sur réservation."
    ],
    "nl": [
      "Kom en geniet van een vriendelijke, gastronomische ervaring met rondleidingen en proeverijen in onze oliemolen en traditionele distilleerderij. Ons familiebedrijf is doordrenkt van traditie en passie en nodigt je uit om op afspraak zijn expertise te ontdekken."
    ],
    "es": [
      "Disfrute de una experiencia gastronómica agradable con visitas y degustaciones de nuestra almazara y destilería tradicional. Nuestra explotación familiar, impregnada de tradición y pasión, le invita a descubrir su saber hacer con cita previa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Nicoleau"
    ]
  },
