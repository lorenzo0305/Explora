  "rdfs:comment": {
    "de": [
      "Fördern Sie die zukünftigen Champions! Seit ihrer Gründung hat die Scara viele derjenigen gesehen, die die Geschichte des Skisports geprägt haben. Auch heute noch treten hier die besten jungen Skifahrer aus Frankreich und anderen Ländern im Alter von 12 bis 15 Jahren in Val d'Isère mit Leidenschaft gegeneinander an."
    ],
    "en": [
      "Come and cheer on the champions of tomorrow! Since its creation, the Scara has seen many of the greatest names in skiing rise through its ranks. Today, the best young skiers from France and abroad, aged 12 to 15, continue to race with passion in Val d’Isère."
    ],
    "it": [
      "Vieni a tifare i campioni di domani! Fin dalla sua creazione, la Scara ha visto passare alcuni dei più grandi nomi dello sci. Ancora oggi, i migliori giovani sciatori francesi e stranieri, dai 12 ai 15 anni, si sfidano con passione a Val d’Isère."
    ],
    "fr": [
      "Venez encourager les futurs champions ! Depuis sa création, la Scara a vu passer ceux qui ont marqué l’histoire du ski. Aujourd’hui encore, les meilleurs jeunes skieurs français et étrangers, de 12 à 15 ans, s’y affrontent avec passion à Val d’Isère."
    ],
    "es": [
      "¡Ven a animar a los futuros campeones! Desde su fundación, el Scara ha visto pasar por sus puertas a algunos de los más grandes nombres de la historia del esquí. Aún hoy, los mejores jóvenes esquiadores de Francia y del extranjero, de entre 12 y 15 años, compiten con pasión en Val d'Isère."
    ],
    "nl": [
      "Kom de toekomstige kampioenen aanmoedigen! Sinds de oprichting heeft de Scara enkele van de grootste namen uit de skigeschiedenis zien passeren. Tot op de dag van vandaag strijden de beste jonge skiërs uit Frankrijk en het buitenland, in de leeftijd van 12 tot 15 jaar, met passie in Val d'Isère."
    ]
  },
