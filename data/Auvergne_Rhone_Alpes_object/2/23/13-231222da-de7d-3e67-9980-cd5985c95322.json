  "rdfs:comment": {
    "de": [
      "Familienküche mit einem Hauch von Finesse und Leichtigkeit. Arbeitermenü von Montag bis Freitag mittags. Samstagmittag gibt es ein Imbissmenü!"
    ],
    "en": [
      "Traditionnal meals with a touch of finess and delicacy.\r\nCountry inn the weekdays (calf's head, pork trotter, pâté...) and restaurant for the week end."
    ],
    "it": [
      "Cucina familiare con un tocco di finezza e leggerezza. Menu del lavoratore dal lunedì al venerdì a pranzo. Il sabato a pranzo c'è la merenda!"
    ],
    "fr": [
      "Cuisine familiale avec une touche de finesse et de légèreté. Menu ouvrier du lundi au vendredi midi. Samedi midi c'est menu casse-croûte !"
    ],
    "nl": [
      "Familiekeuken met een vleugje finesse en lichtheid. Werknemersmenu van maandag tot vrijdagmiddag. Zaterdagmiddag is er een snackmenu!"
    ],
    "es": [
      "Cocina familiar con un toque de delicadeza y ligereza. Menú obrero de lunes a viernes al mediodía. Los sábados al mediodía, menú de picoteo"
    ]
  },
