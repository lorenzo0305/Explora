  "rdfs:comment": {
    "de": [
      "Tabletterie Desfonds: vom Baumstamm bis zum Löffel, Entwicklung der Tischkultur seit 1924\r\nAlle Schritte der Herstellung eines Tischutensils. Live-Herstellung eines Löffels, Techniken und Materialien aus den 50er Jahren."
    ],
    "en": [
      "Tabletterie Desfonds: from trunk to spoon, the evolution of cookware since 1924. All steps in the manufacture of a kitchen utensil. See a spoon being manufactured using techniques and equipment dating back to the 50s."
    ],
    "it": [
      "Tabletterie Desfonds: dal tronco al cucchiaio, evoluzione dell'arte della tavola dal 1924\r\nTutte le fasi di produzione di un utensile da tavola. Realizzare un cucchiaio dal vivo, tecniche e materiali degli anni Cinquanta."
    ],
    "fr": [
      "Tabletterie Desfonds : du tronc à la cuillère, évolution de l'art de la table depuis 1924. \r\nToutes les étapes de la fabrication d'un ustensile de la table. Réalisation d'une cuillère en direct, techniques et matériels datant des années 50."
    ],
    "nl": [
      "Tabletterie Desfonds: van de stam tot de lepel, evolutie van de tafelkunst sinds 1924. Alle fases van de vervaardiging van tafelgerei. Vervaardiging ter plaatse van een lepeltje, oude technieken en materiaal uit de jaren 50."
    ],
    "es": [
      "Tabletterie Desfonds: del baúl a la cuchara, evolución del arte de la mesa desde 1924\r\nTodas las etapas de la fabricación de un utensilio de mesa. Hacer una cuchara en vivo, técnicas y materiales de los años 50."
    ]
  },
