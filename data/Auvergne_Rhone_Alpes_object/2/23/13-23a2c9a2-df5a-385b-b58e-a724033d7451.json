  "rdfs:comment": {
    "de": [
      "Die Brasserie de Cruas empfängt Sie in ihren renovierten Räumlichkeiten mit einer gemütlichen Atmosphäre. Genießen Sie eine Küche mit frischen Produkten und lassen Sie sich am Wochenende unsere Cocktails und Tapas schmecken. Ein geselliger Moment mit Freunden oder der Familie wartet auf Sie!"
    ],
    "en": [
      "La Brasserie de Cruas welcomes you to its renovated premises, with a warm atmosphere. Come and savor our freshly prepared cuisine, and enjoy our cocktails and tapas at weekends. A convivial moment with friends or family awaits you!"
    ],
    "it": [
      "La Brasserie de Cruas vi accoglie nei suoi locali rinnovati, con un'atmosfera accogliente. Venite ad assaporare la nostra cucina a base di prodotti freschi e a gustare i nostri cocktail e le nostre tapas durante il fine settimana. Vi aspetta un momento di convivialità con gli amici o la famiglia!"
    ],
    "fr": [
      "La Brasserie de Cruas vous accueille dans ses locaux rénovés, avec une ambiance chaleureuse. Venez savourer une cuisine de produits frais et profitez de nos cocktails et tapas le week-end. Un moment convivial entre amis ou en famille vous attend !"
    ],
    "es": [
      "La Brasserie de Cruas le da la bienvenida en su local renovado, con un ambiente cálido. Venga a saborear nuestra cocina basada en productos frescos, y disfrute de nuestros cócteles y tapas los fines de semana. Le espera un momento agradable entre amigos o en familia"
    ],
    "nl": [
      "De Brasserie de Cruas heet u welkom in zijn gerenoveerde pand, met een warme sfeer. Kom genieten van onze keuken op basis van verse producten en geniet in het weekend van onze cocktails en tapas. Er wacht u een gezellig moment met vrienden of familie!"
    ]
  },
