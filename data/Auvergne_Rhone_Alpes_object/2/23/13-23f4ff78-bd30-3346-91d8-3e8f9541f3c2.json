  "rdfs:comment": {
    "de": [
      "Guillaume, der aus einer sechsten Generation von Bäckern stammt, wurde schon früh mit der Bäckerei vertraut und half seinem Vater. Heute ist er selbst der Nachfolger."
    ],
    "en": [
      "Born into a 6-generation line of bakers, Guillaume was immersed in the business from an early age, helping his father. Today, it's his turn to take over."
    ],
    "it": [
      "Nato da una stirpe di 6 generazioni di panettieri, Guillaume si è immerso nel mondo della panificazione fin da piccolo, aiutando il padre. Ora è il suo turno di prendere il comando."
    ],
    "fr": [
      "Issue d’une lignée de 6 générations de boulangers, Guillaume a très tôt baigné dans ce milieu en aidant son père. Aujourd’hui, il assure à son tour la relève."
    ],
    "es": [
      "Nacido en el seno de una estirpe de 6 generaciones de panaderos, Guillaume se sumergió en el mundo de la panadería desde muy pequeño, ayudando a su padre. Ahora le toca a él tomar el relevo."
    ],
    "nl": [
      "Guillaume werd geboren in een lijn van 6 generaties bakkers en werd al op jonge leeftijd ondergedompeld in de wereld van het bakken door zijn vader te helpen. Nu is het zijn beurt om het over te nemen."
    ]
  },
  "rdfs:label": {
