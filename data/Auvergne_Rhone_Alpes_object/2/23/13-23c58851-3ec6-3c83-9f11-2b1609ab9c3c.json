  "rdfs:comment": {
    "de": [
      "Der landwirtschaftliche Betrieb Valentin père et fils, der seit 20 Jahren Weizen und aromatische Pflanzen anbaut, verarbeitet seine Kulturen zu :\r\n- Mehl durch seine Mühle mit Steinmahlwerk.\r\n- Ätherische Öle über eine lokale Destillerie"
    ],
    "en": [
      "Growers of wheat and aromatic plants for 20 years, Valentin père et fils transforms their crops into :\r\n- Flour from its stone mill\r\n- Essential oils through a local distillery"
    ],
    "it": [
      "Produttore di grano e piante aromatiche da 20 anni, Valentin père et fils trasforma i suoi raccolti in :\r\n- Farina dal suo mulino a pietra\r\n- Oli essenziali da una distilleria locale"
    ],
    "fr": [
      "Producteur depuis 20 ans de blé et de plantes aromatiques, l'exploitation agricole Valentin père et fils transforme ses cultures en :\r\n- Farines par le biais de son moulin à la meule de pierre\r\n- Huiles essentielles par le biais d'une distillerie locale"
    ],
    "es": [
      "Productor de trigo y plantas aromáticas desde hace 20 años, Valentin père et fils transforma sus cosechas en :\r\n- Harina de su molino de piedra\r\n- Aceites esenciales de una destilería local"
    ],
    "nl": [
      "Als producent van tarwe en aromatische planten sinds 20 jaar, transformeert Valentin père et fils zijn gewassen in :\r\n- Meel uit zijn stenen molen\r\n- Essentiële oliën uit een plaatselijke distilleerderij"
    ]
  },
