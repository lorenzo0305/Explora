  "rdfs:comment": {
    "de": [
      "Auf der Sonnenterrasse oder drinnen in einem Designerdekor kannst du Lyoner Spezialitäten genießen, dir eine Maxi-Gourmet-Pause gönnen oder einen der besten Cocktails der Stadt probieren!"
    ],
    "en": [
      "On the sunny terrace or inside in a designer setting, you can savor Lyonnaise specialties, treat yourself to a super gourmet break or even enjoy one of the best cocktails in town!"
    ],
    "it": [
      "Sulla terrazza soleggiata o all'interno, in un ambiente di design, potrete gustare le specialità lionesi, fare una pausa gourmet o assaggiare uno dei migliori cocktail della città!"
    ],
    "fr": [
      "Sur la terrasse ensoleillée ou à l'intérieur dans un décor design, tu peux savourer des spécialités lyonnaise, t'accorder une pause maxi gourmande ou encore déguster un des meilleurs cocktails de la ville !"
    ],
    "nl": [
      "Op het zonnige terras of binnen in een designdecor kun je genieten van de specialiteiten van Lyon, een gastronomische pauze inlassen of een van de beste cocktails van de stad proeven!"
    ],
    "es": [
      "En la soleada terraza o en el interior, con una decoración de diseño, podrá saborear las especialidades lionesas, hacer una pausa gastronómica o degustar uno de los mejores cócteles de la ciudad"
    ]
  },
