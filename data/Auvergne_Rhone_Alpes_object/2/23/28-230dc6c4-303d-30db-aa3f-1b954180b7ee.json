      "rdfs:comment": {
        "de": [
          "Die Bäckerei L'Ami du Pain bietet Ihnen alle Arten von Brot, Sandwiches, Getränken, Gebäck usw. sowie einen neuen Online-Bestellservice und Expressabholung."
        ],
        "en": [
          "L'Ami du Pain bakery offers all kinds of breads, sandwiches, drinks, pastries... as well as a new online ordering and express pick-up service."
        ],
        "it": [
          "La panetteria L'Ami du Pain offre un'ampia gamma di pane, panini, bevande e dolci, oltre a un nuovo servizio di ordinazione online e di ritiro espresso."
        ],
        "fr": [
          "La boulangerie L'Ami du Pain vous propose toutes sortes de pains, sandwichs, boissons, pâtisseries… ainsi qu'un nouveau service de commande en ligne et de retrait express."
        ],
        "es": [
          "La panadería L'Ami du Pain ofrece una amplia gama de panes, bocadillos, bebidas y bollería, así como un nuevo servicio de pedidos en línea y recogida exprés."
        ],
        "nl": [
          "De bakkerij L'Ami du Pain biedt een breed assortiment brood, broodjes, drankjes en gebak, maar ook een nieuwe online bestelservice en express afhaalservice."
        ]
      },
