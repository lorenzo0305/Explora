  "rdfs:comment": {
    "de": [
      "Chloé Dabert befasst sich diesmal mit den letzten Tagen der Königin Maria Stuart durch eine zeitgenössische Inszenierung der historischen Tragödie von Friedrich von Schiller."
    ],
    "en": [
      "Chloé Dabert's contemporary staging of Friedrich von Schiller's historical tragedy focuses on the last days of Queen Mary Stuart."
    ],
    "it": [
      "La produzione contemporanea di Chloé Dabert della tragedia storica di Friedrich von Schiller si concentra sugli ultimi giorni della regina Maria Stuarda."
    ],
    "fr": [
      "Chloé Dabert s'intéresse cette fois aux derniers jours de la reine Marie Stuart à travers une mise en scène contemporaine de la tragédie historique de Friedrich von Schiller."
    ],
    "es": [
      "La producción contemporánea de Chloé Dabert de la tragedia histórica de Friedrich von Schiller se centra en los últimos días de la reina María Estuardo."
    ],
    "nl": [
      "Chloé Daberts eigentijdse productie van Friedrich von Schillers historische tragedie richt zich op de laatste dagen van koningin Mary Stuart."
    ]
  },
