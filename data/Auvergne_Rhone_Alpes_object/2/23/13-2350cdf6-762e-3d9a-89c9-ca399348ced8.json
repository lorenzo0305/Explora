  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen Abend zwischen guter Laune und Lachen im Smart Cabaret in Brives-Charensac am 30. Mai um 20 Uhr mit der Show \"On ne s?emmerde plus!\" von Philippe Souverville, zwischen Anekdoten, Selbstironie und einem schelmischen Blick auf den Alltag."
    ],
    "en": [
      "Come and spend an evening of good humor and laughter at the Smart Cabaret in Brives-Charensac on May 30 at 8pm with Philippe Souverville's show \"On ne s?emmerde plus!\", a mix of anecdotes, self-mockery and a mischievous look at everyday life."
    ],
    "it": [
      "Il 30 maggio alle 20.00, allo Smart Cabaret di Brives-Charensac, vi aspetta una serata all'insegna del buonumore e delle risate con lo spettacolo di Philippe Souverville \"On ne s?emmerde plus!\", un mix di aneddoti, autoironia e uno sguardo malizioso sulla vita quotidiana."
    ],
    "fr": [
      "Venez passer une soirée entre bonne humeur et rire au Smart Cabaret de Brives-Charensac le 30 mai à 20h avec le spectacle \"On ne s’emmerde plus !\" de Philippe Souverville, entre anecdotes, autodérision et regard malicieusement porté sur le quotidien."
    ],
    "nl": [
      "Kom op 30 mei om 20.00 uur naar het Smart Cabaret in Brives-Charensac voor een avond vol humor en gelach met de show \"On ne s'emmerde plus!\" van Philippe Souverville, een mix van anekdotes, zelfspot en een ondeugende kijk op het dagelijks leven."
    ],
    "es": [
      "Disfrute de una velada de buen humor y risas en el Smart Cabaret de Brives-Charensac el 30 de mayo a las 20:00 h con el espectáculo de Philippe Souverville \"On ne s?emmerde plus!\", una mezcla de anécdotas, autoburla y mirada pícara sobre la vida cotidiana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : On ne s'emmerde plus !"
    ]
  },
