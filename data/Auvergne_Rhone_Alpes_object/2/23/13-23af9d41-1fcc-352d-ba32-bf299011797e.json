  "rdfs:comment": {
    "de": [
      "Eine Gastronomie im Einklang mit der Eleganz des Ortes, ein Erlebnis das die \r\nSinne weckt. Themenmenüs: Trüffel."
    ],
    "en": [
      "Cuisine in harmony with the elegant setting offering senses- based experiences. Themed menus around the truffle."
    ],
    "it": [
      "Il ristorante gourmet Le Colombier, nel cuore del Domaine du Colombier a Malataverne, offre una cucina stagionale basata sui quattro elementi. Johan Thyriot ha sviluppato un approccio creativo ispirato ai quattro elementi"
    ],
    "fr": [
      "Le restaurant gastronomique Le Colombier, situé au cœur du Domaine du Colombier à Malataverne, propose une cuisine de saison structurée autour des quatre éléments. Johan Thyriot y développe une approche créative inspirée des quatre éléments"
    ],
    "nl": [
      "Gastronomie in harmonie met de elegante omgeving, een rijke ervaring en \r\nzinnenstrelend. Themamenu’s: Truffels"
    ],
    "es": [
      "El restaurante gastronómico Le Colombier, en el corazón del Domaine du Colombier en Malataverne, ofrece una cocina de temporada basada en los cuatro elementos. Johan Thyriot ha desarrollado un enfoque creativo inspirado en los cuatro elementos"
    ]
  },
