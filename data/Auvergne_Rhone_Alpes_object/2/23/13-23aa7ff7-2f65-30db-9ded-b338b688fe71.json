  "rdfs:comment": {
    "de": [
      "Verkauf von handwerklich hergestellten, im Holzofen gebackenen Pizzas zum Mitnehmen, lokale und italienische Produkte.\r\nAutomat neben der Pizzeria, 7 Tage pro Woche geöffnet, der die handwerklich hergestellten Pizzen der Pizzeria vertreibt."
    ],
    "en": [
      "Take-away sale of pizzas cooked over a wood fire."
    ],
    "it": [
      "Pizza d'asporto fatta in casa con forno a legna, prodotti locali e italiani.\r\nDistributore automatico accanto alla pizzeria, aperto 7 giorni su 7, che distribuisce le pizze fatte in casa della pizzeria."
    ],
    "fr": [
      "Vente à emporter de pizzas artisanales cuites au feu de bois, produits locaux et italiens.\r\nDistributeur à côté de la pizzeria, ouvert 7/7j, qui distribue les pizzas artisanales de la pizzeria."
    ],
    "es": [
      "Comida para llevar de pizzas caseras cocinadas en horno de leña, productos locales e italianos.\r\nMáquina expendedora junto a la pizzería, abierta los 7 días de la semana, que distribuye las pizzas caseras de la pizzería."
    ],
    "nl": [
      "Afhaling van huisgemaakte pizza's uit een houtoven, lokale en Italiaanse producten.\r\nVerkoopautomaat naast de pizzeria, 7 dagen per week geopend, die de zelfgemaakte pizza's van de pizzeria verdeelt."
    ]
  },
