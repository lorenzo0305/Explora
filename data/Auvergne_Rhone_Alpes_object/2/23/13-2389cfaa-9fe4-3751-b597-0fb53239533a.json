  "rdfs:comment": {
    "de": [
      "Les Hydropathes ist vor allem eine Geisteshaltung, die wir mit Ihnen teilen möchten, die Arbeit mit frischen, lokalen und handgemachten Produkten.\r\nDie Kunst, gut zu essen und gut zu trinken."
    ],
    "en": [
      "Les Hydropathes is above all a state of mind that we want to share with you, working with fresh, local, handmade products.\r\nThe art of eating and drinking well."
    ],
    "it": [
      "Les Hydropathes è soprattutto uno stato d'animo che vogliamo condividere con voi, lavorando con prodotti freschi, locali e artigianali.\r\nL'arte di mangiare e bere bene."
    ],
    "fr": [
      "Les Hydropathes c’est avant tout un état d’esprit que nous voulons vous faire partager, le travail des produits frais, locaux et faits main.\r\nL’Art de bien manger et bien boire."
    ],
    "nl": [
      "Les Hydropathes is vooral een gemoedstoestand die we met je willen delen, door te werken met verse, lokale, handgemaakte producten.\r\nDe kunst van goed eten en drinken."
    ],
    "es": [
      "Les Hydropathes es ante todo un estado de ánimo que queremos compartir con usted, trabajando con productos frescos, locales y artesanales.\r\nEl arte de comer y beber bien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Les Hydropathes"
    ]
  },
