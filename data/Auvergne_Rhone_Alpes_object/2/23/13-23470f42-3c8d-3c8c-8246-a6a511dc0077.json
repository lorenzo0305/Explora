  "rdfs:comment": {
    "de": [
      "Das idyllisch am Ende des Sees von Montriond gelegene Le Bout du Lac, Maître Restaurateur, lädt Sie dazu ein, die Aromen unserer Region bei köstlichen Gerichten zu entdecken, die aus den besten Produkten der Region zubereitet werden."
    ],
    "en": [
      "In a fairytale setting, as its name suggests, this restaurant \"Maïtre Restaurateur\" at the far end of Montriond Lake invites you to discover the flavours of the region through deliciously cooked dishes using the finest local ingredients."
    ],
    "it": [
      "Situato all'estremità del lago di Montriond, in un ambiente idilliaco, Le Bout du Lac, Maître Restaurateur, vi invita a scoprire i sapori della nostra regione, con piatti deliziosamente preparati con i migliori prodotti locali."
    ],
    "fr": [
      "Situé au bout du lac de Montriond, dans un cadre idyllique, le Bout du Lac, Maître Restaurateur, vous invite à découvrir les saveurs de notre terroir autour de plats délicieusement cuisinés à partir des meilleurs produits de la région."
    ],
    "es": [
      "Situado al final del lago Montriond, en un entorno idílico, Le Bout du Lac, Maître Restaurateur, le invita a descubrir los sabores de nuestra región, con platos deliciosamente elaborados con los mejores productos locales."
    ],
    "nl": [
      "Gelegen aan het einde van het meer van Montriond, in een idyllische omgeving, nodigt Le Bout du Lac, Maître Restaurateur, je uit om de smaken van onze regio te ontdekken, met gerechten die heerlijk bereid zijn met de beste lokale producten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Bout du Lac"
    ],
    "fr": [
      "Auberge du Bout du Lac"
    ]
  },
