  "rdfs:comment": {
    "de": [
      "M'Ski - Myrtille Camus, staatlich geprüfte, unabhängige Alpinskilehrerin, teilt mit Ihnen ihre Leidenschaft für die Berge beim Alpinskifahren, Snowboarden, Skitourengehen und Schneeschuhwandern.\r\nVom Anfänger bis zum fortgeschrittenen Skifahrer, in Gruppenkursen oder Privatstunden."
    ],
    "en": [
      "M'Ski - Myrtille Camus, state-certified independent alpine ski instructor, shares with you her passion for the mountains in alpine skiing, snowboarding, ski touring and snowshoeing. From beginner to advanced skier, in group lessons or private lessons."
    ],
    "it": [
      "M'Ski - Myrtille Camus, maestra di sci alpino diplomata, condivide con voi la sua passione per la montagna con lo sci alpino, lo snowboard, lo sci alpinismo e le racchette da neve.\r\nDai principianti agli avanzati, con lezioni di gruppo o private."
    ],
    "fr": [
      "M'Ski - Myrtille Camus, monitrice de ski alpin indépendante diplômée d'état, partage avec vous sa passion de la montagne en ski alpin, snowboard, ski de randonnée et raquettes. \r\nDu skieur débutant au confirmé, en cours collectifs ou leçons particulières."
    ],
    "es": [
      "M'Ski - Myrtille Camus, monitora de esquí alpino autónoma titulada por el Estado, comparte con usted su pasión por la montaña en esquí alpino, snowboard, esquí de travesía y raquetas de nieve.\r\nDesde principiantes hasta esquiadores avanzados, en clases en grupo o particulares."
    ],
    "nl": [
      "M'Ski - Myrtille Camus, door de staat gecertificeerde onafhankelijke alpineski-instructeur, deelt met u haar passie voor de bergen in alpine skiën, snowboarden, skitochten en sneeuwschoenwandelen. Van beginner tot gevorderde skiër, in groepslessen of privélessen."
    ]
  },
