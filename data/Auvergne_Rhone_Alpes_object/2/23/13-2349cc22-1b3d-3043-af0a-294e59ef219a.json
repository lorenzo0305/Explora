  "rdfs:comment": {
    "de": [
      "Snack zum Mitnehmen, mit Pizza, Tender, Burger, Pommes frites, Kebab und Tacos.\r\nLIEFERUNG, CLICK&COLLECT: Dank unserer Website können Sie Ihre Bestellungen bestellen und entgegennehmen, ohne sich von zu Hause aus bewegen zu müssen.\r\nLink zur Website: https://larlequin.foxorders.fr/"
    ],
    "en": [
      "Snack takeaway, with pizzas, tenders, burgers, fries, kebabs and tacos.\r\nDELIVERY, CLICK&COLLECT: thanks to our website, you can order and receive your orders from the comfort of your home.\r\nWebsite link: https://larlequin.foxorders.fr/"
    ],
    "it": [
      "Snack d'asporto, con pizze, tender, hamburger, patatine, kebab e tacos.\r\nCONSEGNA, CLICK&COLLECT: grazie al nostro sito web, potete ordinare e ricevere i vostri ordini comodamente da casa.\r\nLink al sito web: https://larlequin.foxorders.fr/"
    ],
    "fr": [
      "Snack à emporter, avec pizzas, tenders, burgers, frites, kebab et tacos. \r\nLIVRAISON, CLICK&COLLECT : grâce à notre site internet, vous pouvez commander et réceptionner vos commandes sans bouger de chez vous.\r\nLien du site : https://larlequin.foxorders.fr/"
    ],
    "nl": [
      "Snack takeaway, met pizza's, tenders, hamburgers, friet, kebab en taco's.\r\nLEVERING, KLIK & COLLECT: dankzij onze website kun je je bestellingen thuis bestellen en ontvangen.\r\nWebsite link: https://larlequin.foxorders.fr/"
    ],
    "es": [
      "Snack para llevar, con pizzas, tenders, hamburguesas, patatas fritas, kebabs y tacos.\r\nDELIVERY, CLICK&COLLECT: gracias a nuestra página web, puedes pedir y recibir tus pedidos desde la comodidad de tu casa.\r\nEnlace web: https://larlequin.foxorders.fr/"
    ]
