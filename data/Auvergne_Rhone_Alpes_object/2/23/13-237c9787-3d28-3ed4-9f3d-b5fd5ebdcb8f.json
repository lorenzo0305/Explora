  "rdfs:comment": {
    "de": [
      "Nonstop-Service den ganzen Tag über. Große Auswahl an Crêpes und bretonischen Galettes. Austern und Sushi. Jeden Abend ab 19.00 Uhr Fondues und Raclettes."
    ],
    "en": [
      "Non-stop catering service. A vast choice of bretonne pancakes and cakes. Oysters and sushi.\r\nEvery evening, from 7.00pm, fondues and raclettes."
    ],
    "it": [
      "Servizio non-stop tutto il giorno. Ampia scelta di frittelle e galette bretoni. Ostriche e sushi. Ogni sera, dalle 19:00, fondute e raclettes."
    ],
    "fr": [
      "Service non-stop toute la journée. Grand choix de crêpes et galettes bretonnes. Huîtres et sushis. Tous les soirs, dès 19h00, fondues et raclettes."
    ],
    "es": [
      "Servicio ininterrumpido durante todo el día. Gran variedad de crepes y galletas bretonas. Ostras y sushi. Todas las noches, a partir de las 19 horas, fondues y raclettes."
    ],
    "nl": [
      "Non-stop service de hele dag. Ruime keuze aan Bretonse pannenkoeken en galetten. Oesters en sushi. Elke avond, vanaf 19 uur, fondues en raclettes."
    ]
