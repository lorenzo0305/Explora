  "rdfs:comment": {
    "de": [
      "LADYBUG ist Street-Artist geworden, nachdem sie 10 Jahre lang als freiberufliche Grafikdesignerin zwischen Nantes und Paris gearbeitet hat. Sie gab diesen zu \"computerlastigen\" Beruf auf, um \"mit der Hand\" zu arbeiten, weit weg von Bildschirmen. Sie kam 2024 nach Nantua."
    ],
    "en": [
      "LADYBUG became a street artist after spending 10 years as a freelance graphic designer between Nantes and Paris. She abandoned this overly \"computer\" profession to work \"by hand\", away from screens. She came to Nantua in 2024."
    ],
    "it": [
      "LADYBUG è diventata una street artist dopo aver trascorso 10 anni come grafica freelance tra Nantes e Parigi. Ha abbandonato questa professione troppo \"informatica\" per lavorare \"a mano\", lontano dagli schermi. È arrivata a Nantua nel 2024."
    ],
    "fr": [
      "LADYBUG est devenue street-artiste après avoir passé 10 ans en tant que graphiste freelance entre Nantes et Paris. Elle délaisse ce métier trop « informatique » pour travailler « à la main », loin des écrans. Elle est venue à Nantua en 2024."
    ],
    "nl": [
      "LADYBUG werd straatartiest nadat ze 10 jaar als freelance grafisch ontwerper had gewerkt tussen Nantes en Parijs. Ze gaf dit overdreven \"computer\"-beroep op om \"met de hand\" te werken, weg van de schermen. Ze kwam naar Nantua in 2024."
    ],
    "es": [
      "LADYBUG se convirtió en artista callejera tras pasar 10 años como diseñadora gráfica freelance entre Nantes y París. Abandonó esta profesión demasiado \"informática\" para trabajar \"a mano\", lejos de las pantallas. Llegó a Nantua en 2024."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Les portraits de Lady Bug"
    ]
  },
