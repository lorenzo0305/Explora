  "rdfs:comment": {
    "de": [
      "Holen Sie Ihre Karte im Tourismusbüro von Albiez-Montrond ab, gehen Sie zum Rathaus von Albiez-le-Jeune und beginnen Sie den Parcours, 5 Markierungen sind zu finden!"
    ],
    "en": [
      "Pick up your map at the Albiez-Montrond tourist office, go to the Albiez-le-Jeune town hall and start the trail, with 5 markers to find!"
    ],
    "it": [
      "Prendete la vostra mappa all'ufficio turistico di Albiez-Montrond, recatevi al municipio di Albiez-le-Jeune e iniziate il percorso. Ci sono 5 cartelli da trovare!"
    ],
    "fr": [
      "Récupérez votre carte à l'office de tourisme d'Albiez-Montrond, allez à la mairie d'Albiez-le-Jeune et commencez le parcours, 5 balises sont à retrouver !"
    ],
    "es": [
      "Recoja su mapa en la oficina de turismo de Albiez-Montrond, diríjase al ayuntamiento de Albiez-le-Jeune y comience la ruta. ¡Hay 5 señales que encontrar!"
    ],
    "nl": [
      "Haal je kaart op bij het toeristenbureau in Albiez-Montrond, ga naar het gemeentehuis in Albiez-le-Jeune en start de route. Er zijn 5 wegwijzers te vinden!"
    ]
  },
