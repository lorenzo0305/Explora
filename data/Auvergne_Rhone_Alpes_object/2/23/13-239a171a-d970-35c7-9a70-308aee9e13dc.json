  "rdfs:comment": {
    "de": [
      "Roof Events: \"Neues Angebot für Ihre beruflichen und privaten Veranstaltungen\".\r\nAm Stadtrand von Clermont-Fd, im Herzen des Geschäftsviertels Brézet, heißen wir Sie das ganze Jahr über täglich willkommen, um Ihre Seminare und Arbeitstreffen zu veredeln."
    ],
    "en": [
      "Roof Events: \"A new offer for your business and private events.\r\nAt the entrance to Clermont-Fd, in the heart of the Brézet business district, we welcome you every day, all year round, to enhance your seminars and business meetings."
    ],
    "it": [
      "Eventi sul tetto: \"Una nuova offerta per i vostri eventi aziendali e privati\".\r\nAll'ingresso di Clermont-Fd, nel cuore del quartiere degli affari di Brézet, vi accogliamo tutti i giorni, tutto l'anno, per il successo dei vostri seminari e incontri d'affari."
    ],
    "fr": [
      "Roof Events : « Nouvelle offre pour vos événements » professionnels et privés.\r\nÀ l’entrée de Clermont-Fd, au cœur du quartier d’affaires du Brézet, nous vous accueillons tous les jours, toute l’année, pour sublimer vos séminaires et réunions de travail."
    ],
    "es": [
      "Roof Events: \"Una nueva oferta para sus eventos profesionales y privados.\r\nA la entrada de Clermont-Fd, en el corazón del barrio de negocios de Brézet, le damos la bienvenida todos los días, todo el año, para que sus seminarios y reuniones de negocios sean un éxito."
    ],
    "nl": [
      "Roof Events: \"Een nieuw aanbod voor uw zakelijke en privé evenementen.\r\nBij de ingang van Clermont-Fd, in het hart van de zakenwijk Brézet, verwelkomen wij u elke dag, het hele jaar door, om uw seminars en zakelijke bijeenkomsten tot een succes te maken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roof Events B&B Clermont Centre"
    ]
  },
