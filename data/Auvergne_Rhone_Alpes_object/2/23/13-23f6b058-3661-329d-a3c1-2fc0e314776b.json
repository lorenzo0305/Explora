  "rdfs:comment": {
    "de": [
      "Restaurant, das mittags und abends traditionelle und/oder vegane Gerichte anbietet, wobei Sie immer die Wahl zwischen beiden Optionen haben. Vegane und glutenfreie Desserts."
    ],
    "en": [
      "This restaurant offers both vegan and meat/fish dishes : you will always have the choice. Desserts are vegan and gluten-free."
    ],
    "it": [
      "Ristorante che offre piatti tradizionali e/o vegani a pranzo e a cena, sempre con possibilità di scelta tra le due opzioni. Dessert vegani e senza glutine."
    ],
    "fr": [
      "Restaurant proposant des plats traditionnels et/ou végétaliens, midi et soir, avec toujours le choix entre les 2 options. Desserts végétaliens et sans gluten."
    ],
    "es": [
      "Restaurante que ofrece platos tradicionales y/o veganos para el almuerzo y la cena, siempre a elegir entre las 2 opciones. Postres veganos y sin gluten."
    ],
    "nl": [
      "Restaurant met traditionele en/of veganistische gerechten voor lunch en diner, altijd met keuze tussen de 2 opties. Veganistische en glutenvrije desserts."
    ]
  },
