  "rdfs:comment": {
    "de": [
      "Collagen von Eulen. Die Idee dahinter ist, die Menschen dazu zu bringen, über den Platz von Tieren in der Gesellschaft nachzudenken."
    ],
    "en": [
      "Collages of owls. The idea is to get people thinking about the place of animals in society."
    ],
    "it": [
      "Collage di gufi. L'idea è quella di far riflettere sul ruolo degli animali nella società."
    ],
    "fr": [
      "Collages de hiboux. L'idée étant d'amener les gens à réfléchir à la place des animaux dans la société."
    ],
    "nl": [
      "Collages van uilen. Het idee is om mensen aan het denken te zetten over de plaats van dieren in de samenleving."
    ],
    "es": [
      "Collages de búhos. La idea es que la gente reflexione sobre el lugar de los animales en la sociedad."
    ]
  },
