  "rdfs:comment": {
    "de": [
      "Der Cotatay, ein Nebenfluss der Ondaine und damit ein Nebenfluss der Loire, entspringt an der Font Ria in Saint-Genest-Malifaux."
    ],
    "en": [
      "The Cotatay, a tributary of the Ondaine and therefore a sub-tributary of the Loire, rises at Font Ria in Saint-Genest-Malifaux."
    ],
    "it": [
      "Il Cotatay, affluente dell'Ondaine e quindi subaffluente della Loira, nasce a Font Ria a Saint-Genest-Malifaux."
    ],
    "fr": [
      "Le Cotatay, rivière affluent de l'Ondaine et donc sous-affluent de la Loire prend sa source à la Font Ria à Saint-Genest-Malifaux."
    ],
    "es": [
      "El Cotatay, afluente del Ondaine y por tanto subfluvial del Loira, nace en Font Ria, en Saint-Genest-Malifaux."
    ],
    "nl": [
      "De Cotatay, een zijrivier van de Ondaine en dus een zijrivier van de Loire, ontspringt bij Font Ria in Saint-Genest-Malifaux."
    ]
