  "rdfs:comment": {
    "de": [
      "Als Erzeuger aus biologischem Anbau bieten wir je nach Jahreszeit: Setzlinge (Gemüse, Kräuter und Blumen), Gemüse und frische oder verarbeitete Kastanien.\r\nDirektverkauf auf dem Bauernhof nach Vereinbarung."
    ],
    "en": [
      "As organic farmers, we offer a seasonal range of plants (vegetables, herbs and flowers), vegetables and fresh or processed chestnuts.\r\nDirect farm sales by appointment."
    ],
    "it": [
      "Come agricoltori biologici, offriamo una gamma stagionale di piante (ortaggi, erbe e fiori), verdure e castagne fresche o lavorate.\r\nVendita diretta in azienda su appuntamento."
    ],
    "fr": [
      "Producteurs en agriculture biologique, nous proposons selon les saisons : des plants (légumes,  plantes aromatiques et fleurs), des légumes, et des châtaignes fraîches ou transformées.\r\nVente directe à la ferme sur rendez-vous."
    ],
    "es": [
      "Como agricultores ecológicos, ofrecemos una gama estacional de plantas (hortalizas, hierbas y flores), verduras y castañas frescas o transformadas.\r\nVenta directa en la granja con cita previa."
    ],
    "nl": [
      "Als biologische boeren bieden we een seizoensgebonden assortiment planten (groenten, kruiden en bloemen), groenten en verse of verwerkte kastanjes.\r\nDirecte boerderijverkoop op afspraak."
    ]
  },
  "rdfs:label": {
