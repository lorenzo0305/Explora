  "rdfs:comment": {
    "de": [
      "Charmantes Restaurant in St Remèze, ganz in der Nähe der Ardèche-Schlucht. Herzlicher Empfang, traditionelle Küche und Spezialitäten der Ardèche: Caillette, hausgemachte Terrine, Kastanienfondant, hausgemachte Desserts und Erdbeeren (April bis Juni)."
    ],
    "en": [
      "Charming restaurant in St Remèze, near the Ardèche Gorges. Warm welcome, traditional cuisine and Ardèche specialities: caillette, homemade terrine, chestnut fondant, homemade desserts and strawberries (April to June)."
    ],
    "it": [
      "Ristorante di charme a St Remèze, vicino alle Gole dell'Ardèche. Accoglienza calorosa, cucina tradizionale e specialità dell'Ardèche: caillette, terrina fatta in casa, fondente di castagne, dolci fatti in casa e fragole (da aprile a giugno)."
    ],
    "fr": [
      "Restaurant de charme à St Remèze, tout près des Gorges de l’Ardèche. Accueil chaleureux, cuisine traditionnelle et spécialités ardéchoises : caillette, terrine maison, fondant à la châtaigne, desserts maison et fraisier (avril à juin)."
    ],
    "es": [
      "Restaurante con encanto en St Remèze, cerca de las gargantas del Ardèche. Cálida acogida, cocina tradicional y especialidades de Ardèche: caillette, terrina casera, fondant de castañas, postres caseros y fresas (de abril a junio)."
    ],
    "nl": [
      "Charmant restaurant in St Remèze, vlakbij de Gorges de l'Ardèche. Warm onthaal, traditionele keuken en specialiteiten uit de Ardèche: caillette, huisgemaakte terrine, kastanjefondant, huisgemaakte desserts en aardbeien (april tot juni)."
    ]
  },
