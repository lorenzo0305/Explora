  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich darauf vor, von unserer köstlichen Auswahl an französischer Küche gefesselt zu werden. Entdecken Sie eine großartige hausgemachte Küche mit lokalen Produkten aus unseren Regionen."
    ],
    "en": [
      "Prepare to be captivated by our delicious selection of French cuisine. Discover superb home-cooked meals based on local and regional products."
    ],
    "it": [
      "Preparatevi a lasciarvi conquistare dalla nostra deliziosa selezione di piatti della cucina francese, scoprendo una superba cucina casalinga a base di prodotti locali e regionali."
    ],
    "fr": [
      "Préparez vous à être captivé par notre délicieuse sélection de cuisine française. découvrez une superbe cuisine faite maison à base de produits locaux et de nos régions."
    ],
    "es": [
      "Prepárese para dejarse cautivar por nuestra deliciosa selección de cocina francesa. Descubra una magnífica cocina casera elaborada con productos locales y regionales."
    ],
    "nl": [
      "Laat je betoveren door onze heerlijke selectie Franse gerechten. Ontdek de voortreffelijke zelfgemaakte keuken met lokale en regionale producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le QG"
    ]
  },
