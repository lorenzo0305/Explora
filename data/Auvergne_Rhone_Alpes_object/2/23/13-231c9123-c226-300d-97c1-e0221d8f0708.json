    "de": [
      "Sehr angenehmes Restaurant am Seeufer mit Blick auf den Puy-Mary, im Herzen des Regionalen Naturparks Volcans d'Auvergne, das Ihnen traditionelle und regionale Küche bietet"
    ],
    "en": [
      "Very pleasant lakeside restaurant overlooking the Puy-Mary, in the heart of the Parc Naturel Régional des Volcans d'Auvergne, offering traditional regional cuisine"
    ],
    "it": [
      "Piacevole ristorante sul lago con vista sul Puy-Mary, nel cuore del Parc Naturel Régional des Volcans d'Auvergne, che propone una cucina regionale tradizionale"
    ],
    "fr": [
      "Très agréable restaurant en bordure de lac avec vue sur le Puy-Mary, au coeur du Parc Naturel Régional des Volcans d'Auvergne, qui vous propose une cuisine traditionnelle  et régionale"
    ],
    "nl": [
      "Zeer aangenaam restaurant aan het meer met uitzicht op de Puy-Mary, in het hart van het Parc Naturel Régional des Volcans d'Auvergne, waar traditionele regionale gerechten worden geserveerd"
    ],
    "es": [
      "Restaurante muy agradable a orillas del lago con vistas al Puy-Mary, en el corazón del Parc Naturel Régional des Volcans d'Auvergne, que sirve cocina regional tradicional"
    ]
