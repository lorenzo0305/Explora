  "rdfs:comment": {
    "de": [
      "Seit 1996 eine beliebte Adresse bei den Einwohnern von Aurillac. Die bistronomische Küche schwankt zwischen Einfachheit und Innovation, ist aber immer schmackhaft."
    ],
    "en": [
      "Open since 1996, the Arsène sur Cour is a favourite address among locals and vistors alike, serving tasty bistronomic cuisine on a menu offering both simple and innovative dishes."
    ],
    "it": [
      "Indirizzo popolare ad Aurillac dal 1996, la cucina bistronomica oscilla tra semplicità e innovazione, ma è sempre gustosa."
    ],
    "fr": [
      "Adresse appréciée des Aurillacois depuis 1996, la cuisine bistronomique oscille entre simplicité et innovation, mais toujours savoureuse."
    ],
    "nl": [
      "Een populair adres in Aurillac sinds 1996. De bistronomische keuken schommelt tussen eenvoud en vernieuwing, maar is altijd lekker."
    ],
    "es": [
      "Dirección popular en Aurillac desde 1996, la cocina bistronómica oscila entre la sencillez y la innovación, pero siempre es sabrosa."
    ]
  },
