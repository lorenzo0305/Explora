  "rdfs:comment": {
    "de": [
      "Bio-Fleisch, -Wurstwaren und -Käse aus einem kleinen Familienbetrieb! Engagiert für die Umwelt, knüpft sie an althergebrachte Praktiken an. Genießen Sie die Authentizität! Bestellen Sie auch über den Online-Shop."
    ],
    "en": [
      "Organic meats, charcuterie and cheeses from a small family-run farm! Committed to the environment, the farm has returned to traditional farming practices. Come and savour the authenticity! You can also order from our online shop."
    ],
    "it": [
      "Carne, salumi e formaggi biologici da una piccola azienda agricola a conduzione familiare! Impegnata nel rispetto dell'ambiente, la fattoria sta facendo rivivere pratiche ancestrali. Venite ad assaporare l'autenticità! Potete anche ordinare nel nostro negozio online."
    ],
    "fr": [
      "Viandes, charcuteries et fromages bios issus d'une petite exploitation familiale ! Engagée pour l'environnement, elle renoue avec les pratiques ancestrales. Venez savourer l'authenticité ! Commandez aussi par la boutique en ligne."
    ],
    "es": [
      "Carne, charcutería y queso ecológicos de una pequeña granja familiar Comprometida con el medio ambiente, la granja recupera prácticas ancestrales. ¡Venga a saborear la autenticidad! También puede hacer su pedido en nuestra tienda en línea."
    ],
    "nl": [
      "Biologisch vlees, vleeswaren en kaas van een kleine familieboerderij! De boerderij zet zich in voor het milieu en laat voorouderlijke gebruiken herleven. Kom en proef de authenticiteit! Je kunt ook bestellen in onze online winkel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ho'Rocher bio"
    ]
  },
