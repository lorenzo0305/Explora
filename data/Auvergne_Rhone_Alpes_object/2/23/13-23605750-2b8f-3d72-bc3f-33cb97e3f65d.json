  "rdfs:comment": {
    "de": [
      "Diese beiden Statuen waren dazu bestimmt, nebeneinander zu stehen. Ein Mann und eine Frau verabreden sich am Fuße des Museums von Valencia, Kunst und Archäologie."
    ],
    "en": [
      "These two statues were intended to stand side by side. A man and a woman meet at the foot of the Musée de Valence, art et archéologie."
    ],
    "it": [
      "Queste due statue erano destinate a stare l'una accanto all'altra. Un uomo e una donna si incontrano ai piedi del Museo d'Arte e Archeologia di Valence."
    ],
    "fr": [
      "Ces deux statues étaient destinées à figurer côte à côte. Un homme, une femme, se donnent rendez-vous au pied du Musée de Valence, art et archéologie."
    ],
    "es": [
      "Estas dos estatuas estaban pensadas para estar una al lado de la otra. Un hombre y una mujer se encuentran al pie del Museo de Arte y Arqueología de Valence."
    ],
    "nl": [
      "Deze twee beelden waren bedoeld om naast elkaar te staan. Een man en een vrouw ontmoeten elkaar aan de voet van het Musée de Valence, kunst en archeologie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sculpture \"Le Rendez-vous\" de Toros"
    ]
  },
