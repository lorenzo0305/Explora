  "rdfs:comment": {
    "de": [
      "Naturdenkmal 3 km vom Dorf entfernt, das über einen Pfad oder die D546 erreichbar ist. Idealer Ort für ein Picknick, zum Entspannen am Wasser und zum Klettern auf den zahlreichen eingerichteten Routen. Fußgängerweg, Parkplatz und Trockentoilette ."
    ],
    "en": [
      "Natural site located at 3kms from Buis-les-Baronnies by the main road or a hiking trail. Picnic area, climbing site, pedestrian path, parking lot and dry toilet."
    ],
    "it": [
      "Un sito naturale classificato a 3 km dal villaggio, accessibile tramite un sentiero o la D546. Luogo ideale per picnic, relax in riva al mare e arrampicate sulle numerose vie. Sentiero, parcheggio e servizi igienici a secco."
    ],
    "fr": [
      "Site naturel classé à 3km du village, accessible par un sentier ou par la D546. Lieu idéal pour pique-niquer, se détendre au bord de l'eau et pratiquer l'escalade sur les nombreuses voies aménagées. Cheminement piéton, parking et toilettes sèches ."
    ],
    "es": [
      "Sitio natural catalogado a 3 km del pueblo, accesible por sendero o por la D546. Lugar ideal para hacer picnics, relajarse junto al agua y escalar en las numerosas rutas. Sendero, aparcamiento y aseos secos."
    ],
    "nl": [
      "Een geklasseerd natuurgebied op 3 km van het dorp, toegankelijk via een wandelpad of de D546. Een ideale plek om te picknicken, te ontspannen aan het water en te rotsklimmen op de vele geprepareerde routes. Voetpad, parkeerplaats en droge toiletten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gorges d'Ubrieux"
    ]
  },
