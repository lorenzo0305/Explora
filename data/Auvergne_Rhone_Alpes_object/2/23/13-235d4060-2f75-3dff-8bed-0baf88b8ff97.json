  "rdfs:comment": {
    "de": [
      "Erleben Sie eine ungewöhnliche Erfahrung und 100% Natur: Bushcraft! Meine Leidenschaft verwandelt sich in eine Einführung in die Techniken des Überlebens: Erstellen eines Lagers, Entdecken der lokalen Flora und Fauna, Feuer und Wasser ..."
    ],
    "en": [
      "Come and enjoy an unusual, 100% natural experience: bushcraft! My passion is transformed into an introduction to survival techniques: setting up a camp, discovering local flora and fauna, fire and water ..."
    ],
    "it": [
      "Venite a vivere un'esperienza insolita e 100% naturale: il bushcraft! La mia passione si trasforma in un'introduzione alle tecniche di sopravvivenza: allestimento di un campo, scoperta della flora e della fauna locali, fuoco e acqua ..."
    ],
    "fr": [
      "Venez vivre une expérience insolite et 100% nature : le bushcraft ! Ma passion se transforme en une initiation aux techniques de survie : création d'un camp, découverte de la faune et de la flore locales, du feu et de l'eau ..."
    ],
    "es": [
      "Ven a disfrutar de una experiencia insólita y 100% natural: ¡el bushcraft! Mi pasión se transforma en una introducción a las técnicas de supervivencia: montar un campamento, descubrir la flora y la fauna locales, el fuego y el agua..."
    ],
    "nl": [
      "Kom genieten van een ongewone en 100% natuurlijke ervaring: bushcraft! Mijn passie wordt omgezet in een introductie tot overlevingstechnieken: kamp opzetten, lokale flora en fauna ontdekken, vuur en water ..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Arverne Bushcraft : l'art de vivre en forêt"
    ]
  },
