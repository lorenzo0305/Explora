  "rdfs:comment": {
    "de": [
      "Das Bistrot de Serine serviert raffinierte regionale Gerichte aus sorgfältig verarbeiteten Produkten. Die ausgewogenen Geschmackskombinationen sind dabei perfekt auf die guten regionalen Weine von der Karte abgestimmt."
    ],
    "en": [
      "The Bistrot à Vin de Serine is a restaurant, wine bar and cellar serving local dishes with original flavours. There are over 400 wines to choose from on the wine menu, and you can get tips about food and wine matches."
    ],
    "it": [
      "Il Bistrot de Serine offre una raffinata cucina locale, basata su prodotti finemente lavorati. L'equilibrio dei sapori è preservato in modo impeccabile e si sposa perfettamente con l'interessante carta dei vini regionali."
    ],
    "fr": [
      "Le Bistrot de Serine vous propose une cuisine de terroir raffinée, à base de produits travaillés avec finesse. L'équilibre des saveurs est impeccablement respecté pour s’associer parfaitement à la jolie carte des vins régionaux."
    ],
    "es": [
      "El Bistrot de Serine ofrece una cocina local refinada, basada en productos finamente elaborados. El equilibrio de sabores se conserva impecablemente para complementar a la perfección la atractiva carta de vinos regionales."
    ],
    "nl": [
      "De Bistrot de Serine biedt een verfijnde lokale keuken op basis van verfijnde producten. De smaakbalans is onberispelijk bewaard gebleven en vormt een perfecte aanvulling op de aantrekkelijke regionale wijnkaart."
    ]
  },
