  "rdfs:comment": {
    "de": [
      "Dorf Saint-Didier-sur-Doulon: Umgebaute alte Kirche. Château de Servières aus dem 15. Jahrhundert (privat). Château de Maisonneuve (privat). Kapelle in Cenat. Torfmoor in Moissac-Bas. Basaltorgeln in Chalus."
    ],
    "en": [
      "Village of Saint-Didier-sur-Doulon: ancient church. 15th-century Château de Servières (private). Château de Maisonneuve (private). Chapel at Cenat. Peat bog at Moissac-Bas. Basalt organs at Chalus."
    ],
    "it": [
      "Villaggio di Saint-Didier-sur-Doulon: antica chiesa con modifiche. Castello di Servières del XV secolo (privato). Castello di Maisonneuve (privato). Cappella di Cenat. Torbiera di Moissac-Bas. Organi di basalto a Chalus."
    ],
    "fr": [
      "Village de Saint-Didier-sur-Doulon : Église ancienne remaniée. Château de Servières du XVe siècle (privé). Château de Maisonneuve (privé). Chapelle à Cenat. Tourbière à Moissac-Bas. Orgues basaltiques à Chalus."
    ],
    "es": [
      "Pueblo de Saint-Didier-sur-Doulon: iglesia antigua con reformas. Castillo de Servières (privado), siglo XV. Castillo de Maisonneuve (privado). Capilla de Cenat. Turbera de Moissac-Bas. Órganos basálticos de Chalus."
    ],
    "nl": [
      "Dorp Saint-Didier-sur-Doulon: Oude kerk met verbouwingen. 15e-eeuws kasteel van Servières (privé). Château de Maisonneuve (privé). Kapel in Cenat. Veen in Moissac-Bas. Basaltorgels in Chalus."
    ]
  },
  "rdfs:label": {
