  "rdfs:comment": {
    "de": [
      "In einer herrlichen Bergkulisse im Herzen des Naturparks Vanoise bietet diese Route relativ einfaches Angeln in einem ruhigen Bach. Hier ist die Bachforelle die unangefochtene Nummer eins."
    ],
    "en": [
      "In a magnificent mountain setting in the heart of the Vanoise Natural Park, this route offers relatively simple fishing in a calm stream. Here, the brown trout reigns supreme."
    ],
    "it": [
      "In uno splendido scenario montano nel cuore del Parco Naturale della Vanoise, questo itinerario offre una pesca relativamente semplice in un ruscello calmo. Qui, la trota fario regna sovrana."
    ],
    "fr": [
      "Dans un magnifique cadre montagnard au cœur du Parc Naturel de la Vanoise, ce parcours vous propose une pêche relativement simple en torrent calme. Ici, la truite fario est reine."
    ],
    "nl": [
      "In een prachtige bergachtige omgeving, midden in het natuurpark Vanoise, biedt deze route relatief eenvoudige vismogelijkheden in een kalme beek. Hier regeert de forel."
    ],
    "es": [
      "En un magnífico entorno de montaña, en el corazón del Parque Natural de la Vanoise, este recorrido ofrece una pesca relativamente sencilla en un arroyo tranquilo. La trucha fario es aquí la reina."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelpfad „Passion“ vom Bach St. Benoit nach Aussois"
    ],
    "en": [
      "\"Passion\" Fishing Trail from the St Benoit stream to Aussois"
    ],
    "it": [
      "Sentiero di pesca \"Passion\" dal torrente St Benoit ad Aussois"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" du ruisseau de St Benoit au Fond d'Aussois"
    ],
    "nl": [
      "Visroute \"Passie\" van de St Benoit-beek naar Aussois"
    ]
  },
