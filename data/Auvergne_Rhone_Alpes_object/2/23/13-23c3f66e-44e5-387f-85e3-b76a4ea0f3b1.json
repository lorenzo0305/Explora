  "rdfs:comment": {
    "de": [
      "Seit dem Ende des 19. Jahrhunderts zieht Vichy dank des Rufs seiner Thermalquellen eine kosmopolitische und multireligiöse Bevölkerung an."
    ],
    "en": [
      "Since the end of the 19th century, Vichy has attracted a cosmopolitan, multi-religious population thanks to the fame of its thermal springs."
    ],
    "it": [
      "Dalla fine del XIX secolo, Vichy ha attirato una popolazione cosmopolita e multireligiosa grazie alla fama delle sue sorgenti termali."
    ],
    "fr": [
      "Depuis la fin du XIXe siècle, Vichy attire, grâce à la renommée de ses sources thermales, une population cosmopolite et multireligieuse."
    ],
    "nl": [
      "Sinds het einde van de 19e eeuw trekt Vichy een kosmopolitische en multireligieuze bevolking aan dankzij de faam van de thermale bronnen."
    ],
    "es": [
      "Desde finales del siglo XIX, Vichy atrae a una población cosmopolita y multirreligiosa gracias a la fama de sus fuentes termales."
    ]
