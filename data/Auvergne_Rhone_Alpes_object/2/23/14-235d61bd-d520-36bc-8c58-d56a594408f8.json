      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck\n\nTage der Öffnung:\n\nMontag bis Samstag: 7h-19h\nSonntag: 7-13 Uhr\n\nMittwoch geschlossen\n \n Abholung :\nZu den Öffnungszeiten des Geschäfts\n\n \n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, pastries\n\nOpening days:\n\nMonday to Saturday: 7am-7pm\nSunday: 7am-1pm\n\nClosed on Wednesday\n \n Pick-up :\nDuring store opening hours\n\n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria\n\nGiorni di apertura:\n\nDa lunedì a sabato: 7-19\nDomenica: 7.00-13.00\n\nChiuso il mercoledì\n \n Ritiro :\nDurante gli orari di apertura del negozio\n\n \n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, pâtisseries\n\nJours d'ouverture:\n\nDu lundi au samedi: 7h-19h\nLe dimanche: 7h-13h\n\nFermeture le mercredi\n \n Retrait :\nAux horaires d'ouverture du magasin\n\n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, gebak\n\nOpeningsdagen:\n\nMaandag tot zaterdag: 7u-19u\nZondag: 7u-1u\n\nWoensdag gesloten\n \n Afhalen :\nTijdens winkelopeningstijden\n\n \n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería\n\nDías de apertura:\n\nDe lunes a sábado: de 7.00 a 19.00\nDomingo: 7h-13h\n\nMiércoles cerrado\n \n Recogida :\nDurante el horario de apertura de la tienda\n\n \n\n "
        ]
      },
