  "rdfs:comment": {
    "de": [
      "Eine Schnitzeljagd auf dem Cuvy-Plateau! Animation zwischen einer Schnitzeljagd, einer Schatzsuche und einem lebensgroßen Escape Game. Zugang über den Grand-Mont-Sessellift oder die Bois-Gondelbahn."
    ],
    "en": [
      "A treasure hunt on the set of Cuvy! Animation halfway between a treasure hunt and a life-size escape game. Access by the Grand-Mont chairlift or the Bois cable car."
    ],
    "it": [
      "Una caccia al tesoro sul Plateau du Cuvy! A metà strada tra una caccia al tesoro e un gioco di fuga a grandezza naturale. Accesso tramite la seggiovia Grand-Mont o la gondola Bois."
    ],
    "fr": [
      "Un jeu de pistes sur le Plateau du Cuvy ! Animation à mi-chemin entre un jeu de piste, une chasse au trésor et un escape game grandeur nature. Accès par le télésiège du Grand-Mont ou la télécabine du Bois."
    ],
    "es": [
      "¡Una búsqueda del tesoro en el Plateau du Cuvy! A medio camino entre una búsqueda del tesoro y un juego de escape a tamaño real. Acceso por el telesilla Grand-Mont o la telecabina Bois."
    ],
    "nl": [
      "Een speurtocht op de set van Cuvy! Animatie halverwege tussen een speurtocht en een levensgroot ontsnappingsspel. Toegang via de Grand-Mont stoeltjeslift of de Bois kabelbaan."
    ]
  },
  "rdfs:label": {
    "en": [
      "Treasure under White Gold Part 2"
    ],
    "fr": [
      "Trésor sous l'Or Blanc Episode II"
    ],
    "nl": [
      "Schat onder de White Gold Episode II"
    ]
  },
