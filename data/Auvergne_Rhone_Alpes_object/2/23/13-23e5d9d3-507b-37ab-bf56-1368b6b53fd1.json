  "rdfs:comment": {
    "de": [
      "Das Atelier Castle ist ein Ort, an dem einzigartige Kunstwerke kreiert und hergestellt werden.  Designermöbel nach Maß, Intarsienarbeiten, Spiegel, Holzdrechselarbeiten, Skulpturen, Einrahmungen, Gemälde, Dekoartikel, Postkarten usw."
    ],
    "en": [
      "Atelier Castle is a creative workshop you can visit and meet the artists and discover their work.  A selection of unique wooden furniture, marquetry, mirrors, wood turning, sculpture and art paintings on display."
    ],
    "it": [
      "Il Castello Atelier è un luogo dove vengono create e prodotte opere d'arte uniche.  Mobili di design su misura, intarsi, specchi, tornitura del legno, scultura, cornici, dipinti, oggetti decorativi, cartoline, ecc."
    ],
    "fr": [
      "L’Atelier Castle est un lieu de création et de fabrication d'œuvres uniques.  Meubles design sur mesure, marqueterie, miroirs, tournage sur bois, sculpture, encadrement, peintures, objets décoratifs, cartes postales, etc."
    ],
    "nl": [
      "Het Kasteel Atelier is een plek waar unieke kunstwerken worden gecreëerd en geproduceerd.  Op maat gemaakte designmeubelen, inlegwerk, spiegels, houtdraaien, beeldhouwwerk, inlijsten, schilderijen, decoratieve objecten, ansichtkaarten, enz."
    ],
    "es": [
      "El Castillo Atelier es un lugar donde se crean y producen obras de arte únicas.  Muebles de diseño hechos a medida, marquetería, espejos, torneado de madera, escultura, enmarcación, cuadros, objetos decorativos, postales, etc."
    ]
  },
