  "rdfs:comment": {
    "de": [
      "Unter der majestätischen Lindenallee,entdecken Sie die hundertjährige Hainbuche, den Kastanienbaum als Kronleuchter, den Obstgarten, den Gemüsegarten, den Rosengarten und das Staudenbeet."
    ],
    "en": [
      "Under the majestic avenue of lime trees, discover the century-old charm, the candelabra chestnut tree, the orchard, the vegetable garden, the rose garden and the perennial patch."
    ],
    "it": [
      "Sotto il maestoso viale di tigli, scoprite il fascino secolare, il castagno candelabro, il frutteto, l'orto, il roseto e la macchia perenne."
    ],
    "fr": [
      "Sous la majestueuse allée de tilleuls,découvrez le charme centenaire, le marronnier en chandelier, le verger, le potager, la roseraie et le carré des vivaces."
    ],
    "nl": [
      "Ontdek onder de majestueuze lindenlaan de eeuwenoude charme, de kandelaberkastanjeboom, de boomgaard, de moestuin, de rozentuin en de vaste planten."
    ],
    "es": [
      "Bajo la majestuosa avenida de tilos, descubra el encanto centenario, el castaño candelabro, el huerto, la huerta, la rosaleda y la huerta perenne."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc de l'abbaye de Vaucelles"
