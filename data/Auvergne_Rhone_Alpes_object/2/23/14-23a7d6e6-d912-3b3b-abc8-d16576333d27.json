      "@id": "https://data.datatourisme.fr/e1835c8e-877b-33d4-9442-3663fe28b995",
      "dc:description": {
        "de": [
          "Bar Tabac, ideal gelegen in der Nähe des Marktes und des Strandes.\nGroße Terrasse, auf der Sie die Sonne genießen können.\nKleine Restauration vor Ort."
        ],
        "en": [
          "Bar Tabac, ideally located near the Market and the Beach.\nLarge terrace to enjoy the sun.\nSmall restaurant on site."
        ],
        "it": [
          "Bar e tabacchi, in posizione ideale vicino al mercato e alla spiaggia.\nAmpia terrazza per godersi il sole.\nPiccolo ristorante in loco."
        ],
        "fr": [
          "Bar Tabac, idéalement situé près du Marché et de la Plage.\nGrande terrasse pour profiter du soleil.\nPetite restauration sur place."
        ],
        "es": [
          "Bar y estanco, idealmente situado cerca del mercado y de la playa.\nAmplia terraza para disfrutar del sol.\nPequeño restaurante in situ."
        ],
        "nl": [
          "Bar en tabakswinkel, ideaal gelegen bij de markt en het strand.\nGroot terras om van de zon te genieten.\nKlein restaurant ter plaatse."
        ]
      },
