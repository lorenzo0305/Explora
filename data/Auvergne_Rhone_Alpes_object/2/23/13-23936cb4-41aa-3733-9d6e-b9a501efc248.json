  "rdfs:comment": {
    "de": [
      "Dieser Garten schmiegt sich an den Waldrand von Autrans und lässt Sie dem Alltag für die Dauer einer Wellness-Massage entfliehen!\r\nEin exklusiver Moment nur für Sie, in einer außergewöhnlichen Umgebung, die sich zur Natur hin öffnet .... Abwechslung garantiert!"
    ],
    "en": [
      "Nestled on the edge of the forest in Autrans, escape for a well-being massage!\r\nAn exclusive moment just for you, in an exceptional setting, open to nature... A change of scenery guaranteed!"
    ],
    "it": [
      "Ai margini della foresta di Autrans, evadete per un massaggio di benessere!\r\nUn momento esclusivo solo per voi, in un ambiente unico con vista sulla natura?"
    ],
    "fr": [
      "Blotti en lisière de forêt à Autrans, évadez-vous le temps d’un massage bien-être !\r\nUn moment exclusif rien que pour vous, dans un cadre unique, ouvert sur la nature …."
    ],
    "nl": [
      "Genesteld aan de rand van het bos in Autrans, ontsnap voor een welzijnsmassage!\r\nEen exclusief moment alleen voor jou, in een unieke omgeving met uitzicht op de natuur?"
    ],
    "es": [
      "Al borde del bosque de Autrans, ¡escápese para disfrutar de un masaje de bienestar!\r\nUn momento exclusivo sólo para usted, en un entorno único con vistas a la naturaleza..."
    ]
  },
  "rdfs:label": {
