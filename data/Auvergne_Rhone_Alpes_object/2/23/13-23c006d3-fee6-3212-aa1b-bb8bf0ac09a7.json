  "rdfs:comment": {
    "de": [
      "Am Samstag, den 28. März 2026, werden mehr als 300 junge Judoka im Sporthaus von Cusset erwartet, um an einer Judoveranstaltung des Departements teilzunehmen, die den Mini-Küken, Küken und dem Benjamins-Turnier gewidmet ist."
    ],
    "en": [
      "On Saturday March 28, 2026, over 300 young judokas are expected at the Maison des Sports in Cusset, for a departmental judo event, dedicated to mini-poussins, poussins and the benjamins tournament."
    ],
    "it": [
      "Sabato 28 marzo 2026, più di 300 giovani judoka sono attesi alla Maison des Sports di Cusset, per un evento di judo dipartimentale dedicato ai mini-poussins, ai poussins e al torneo di benjamins."
    ],
    "fr": [
      "Le samedi 28 mars 2026, plus de 300 jeunes judokas sont attendus à la Maison des sports de Cusset, à l’occasion d’une animation départementale de judo, dédiée aux mini-poussins, poussins et au tournoi benjamins."
    ],
    "nl": [
      "Op zaterdag 28 maart 2026 worden meer dan 300 jonge judoka's verwacht in het Maison des Sports in Cusset, voor een departementaal judo-evenement gewijd aan mini-poussins, poussins en het benjamins-toernooi."
    ],
    "es": [
      "El sábado 28 de marzo de 2026, se espera a más de 300 jóvenes judokas en la Maison des Sports de Cusset, para un evento departamental de judo dedicado a los mini-poussins, los poussins y el torneo de benjamines."
    ]
  },
