  "rdfs:comment": {
    "de": [
      "Unsere Wanderagentur mit Sitz in Die, am Fuße des Vercors, bietet geführte Wanderungen, Wandertouren oder Sternwanderungen, Wanderungen in Freiheit, mit der Familie, mit Eseln, mit Schneeschuhen... im Vercors, in den Alpen und in einigen weiter entfernten Massiven."
    ],
    "en": [
      "Based in Die, at the foot of the Vercors, our hiking agency offers guided, itinerant or star-led hikes, as well as family hikes, donkey hikes, snowshoe hikes... in the Vercors, the Alps and a few more remote massifs."
    ],
    "it": [
      "Con sede a Die, ai piedi del Vercors, la nostra agenzia escursionistica propone escursioni guidate, escursioni itineranti o trekking stellati, escursioni libere, escursioni in famiglia, escursioni con gli asini, escursioni con le racchette da neve... nel Vercors, nelle Alpi e in alcuni massicci più lontani."
    ],
    "fr": [
      "Basée à Die, au pied du Vercors, notre agence de randonnée  propose des randonnées accompagnées, itinérantes ou en étoile, des randos liberté, en famille, avec des ânes, en raquettes... dans le Vercors, les Alpes et quelques massifs plus lointains."
    ],
    "nl": [
      "Ons wandelbureau is gevestigd in Die, aan de voet van de Vercors, en biedt begeleide wandeltochten, rondtrekkende wandeltochten of stertochten, vrije wandeltochten, familiewandelingen, wandelingen met ezels, sneeuwschoenwandelingen... in de Vercors, de Alpen en enkele bergmassieven verder weg."
    ],
    "es": [
      "Con sede en Die, a los pies del Vercors, nuestra agencia de senderismo propone excursiones guiadas, itinerantes o en estrella, libres, en familia, con burros, con raquetas de nieve... en el Vercors, los Alpes y algunos macizos más alejados."
    ]
  },
