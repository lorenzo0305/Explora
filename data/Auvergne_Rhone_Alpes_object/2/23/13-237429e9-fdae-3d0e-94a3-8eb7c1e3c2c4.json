  "rdfs:comment": {
    "de": [
      "Mehr als je zuvor tanken Sie Energie mit einem außergewöhnlichen Nahrungsmittel: Spirulina! 100% bäuerlich und französisch, von Natur aus reich an Eisen, Proteinen und Vitaminen: Spirulina ist ein wertvoller Verbündeter für unsere Gesundheit! Versand auf Anfrage möglich."
    ],
    "en": [
      "More than ever, fill up on energy with an exceptional food: Spirulina! 100% local & French, naturally rich in iron, proteins and vitamins: spirulina is a precious ally for our health! Possibility of shipping on request."
    ],
    "it": [
      "Oggi più che mai, fate il pieno di energia con un alimento eccezionale: la Spirulina! 100% tradizionale e francese, fonte naturale di ricchezza e vitalità: la spirulina è un alleato prezioso per la nostra salute! Spedizione disponibile su richiesta!"
    ],
    "fr": [
      "Plus que jamais faites le plein d’énergie avec un aliment d’exception : La Spiruline ! 100% artisanale & française, source naturelle de richesse et de vitalité : la spiruline est une alliée précieuse pour notre santé ! Possibilité expédition sur demande !"
    ],
    "nl": [
      "Tank nu meer dan ooit energie met een uitzonderlijk voedingsmiddel: spirulina! 100% traditioneel & Frans, een natuurlijke bron van rijkdom en vitaliteit: spirulina is een kostbare bondgenoot voor onze gezondheid! Verzending op aanvraag!"
    ],
    "es": [
      "Ahora más que nunca, llénese de energía con un alimento excepcional: ¡la espirulina! 100% tradicional y francesa, fuente natural de riqueza y vitalidad: ¡la espirulina es un aliado precioso para nuestra salud! ¡Envío disponible a petición!"
    ]
  },
