  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt empfängt Sie und informiert Sie über Unterbringungs- und Verpflegungsmöglichkeiten, Sehenswürdigkeiten, Aktivitäten und Freizeitangebote auf seinem Gebiet. Eine reichhaltige Dokumentation steht Ihnen zur Verfügung."
    ],
    "en": [
      "The Tourist Information Office welcomes you and informs you about accommodation, restaurants, tourist sites, activities and leisure activities on its territory. A rich documentation is at your disposal."
    ],
    "it": [
      "L'Ufficio informazioni turistiche vi accoglie e vi informa su alloggi, ristoranti, siti turistici, attività e svaghi della zona. È disponibile una ricca documentazione."
    ],
    "fr": [
      "Le Bureau d'information touristique vous accueille et vous informe sur les possibilités d'hébergement, de restauration, sur les sites touristiques, les activités et loisirs présents sur son territoire. Une riche documentation est à votre disposition."
    ],
    "es": [
      "La Oficina de Turismo le da la bienvenida y le informa sobre alojamiento, restaurantes, lugares turísticos, actividades y ocio de la zona. Dispone de abundante documentación."
    ],
    "nl": [
      "De VVV heet u welkom en informeert u over accommodatie, restaurants, toeristische bezienswaardigheden, activiteiten en vrijetijdsbesteding in de omgeving. Er is een schat aan documentatie beschikbaar."
    ]
  },
