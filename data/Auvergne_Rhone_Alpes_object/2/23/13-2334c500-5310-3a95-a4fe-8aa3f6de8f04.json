  "rdfs:comment": {
    "de": [
      "Als professionelle Fotografin hält Céline Ihre wertvollen Momente und Ereignisse authentisch fest und wertet das Image von Unternehmen auf. Hochzeiten, Porträts, Reportagen: natürliche und elegante Bilder im Dienste Ihrer Geschichte und Ihrer Identität."
    ],
    "en": [
      "Professional photographer, I authentically capture your precious moments, events, and enhance the image of businesses. Weddings, portraits, reports: natural and elegant images that showcase your story and identity."
    ],
    "it": [
      "In qualità di fotografa professionista, Céline cattura con autenticità i vostri momenti ed eventi preziosi e valorizza l'immagine della vostra azienda. Matrimoni, ritratti, reportage: immagini naturali ed eleganti al servizio della vostra storia e della vostra identità."
    ],
    "fr": [
      "Photographe professionnelle, Céline capture avec authenticité vos moments précieux, événements et valorise l’image des entreprises. Mariages, portraits, reportages : des images naturelles et élégantes, au service de votre histoire et de votre identité."
    ],
    "es": [
      "Como fotógrafa profesional, Céline capta sus momentos y eventos más preciados con autenticidad, y realza la imagen de su empresa. Bodas, retratos, reportajes: imágenes naturales y elegantes al servicio de su historia y su identidad."
    ],
    "nl": [
      "Als professioneel fotograaf legt Céline uw kostbare momenten en gebeurtenissen op authentieke wijze vast en versterkt ze het imago van uw bedrijf. Bruiloften, portretten, reportages: natuurlijke, elegante beelden die in dienst staan van uw verhaal en uw identiteit."
    ]
  },
