  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant im Herzen der Altstadt von Murat, in unmittelbarer Nähe der Markthallen. Zwei schattige Terrassen. Catering-Service: Taufe, Hochzeit, Familienessen..."
    ],
    "en": [
      "Traditional restaurant in the heart of Old Murat, right next to the covered market. Two shaded terraces. Catering service: christenings, weddings, family meals..."
    ],
    "it": [
      "Ristorante tradizionale nel cuore della vecchia Murat, vicino alla sala del mercato. Due terrazze ombreggiate. Servizio di catering: battesimi, matrimoni, pranzi di famiglia..."
    ],
    "fr": [
      "Restaurant traditionnel au cœur du Vieux Murat, à proximité immédiate des halles. Deux terrasses ombragées. Service traiteur : baptême, mariage, repas de famille..."
    ],
    "nl": [
      "Traditioneel restaurant in het hart van het oude Murat, direct naast de overdekte markt. Twee schaduwrijke terrassen. Catering service: doopfeesten, bruiloften, familie maaltijden..."
    ],
    "es": [
      "Restaurante tradicional en el corazón del Viejo Murat, cerca del mercado. Dos terrazas sombreadas. Servicio de catering: bautizos, bodas, comidas familiares..."
    ]
