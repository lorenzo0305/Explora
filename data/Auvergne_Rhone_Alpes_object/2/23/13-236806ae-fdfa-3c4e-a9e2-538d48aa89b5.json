  "rdfs:comment": {
    "de": [
      "Sympathische Brasserie, Bar, Eisdiele mit großer schattiger Terrasse 10 Minuten von Vizille und in unmittelbarer Nähe des Parc d'Uriage."
    ],
    "en": [
      "Friendly brasserie, bar and ice cream parlour with a large shaded terrace in a green setting. Located close to the Parc d'Uriage, you can sit back and enjoy a coffee or a drink on the terrace, or sample traditional cuisine."
    ],
    "it": [
      "Brasserie, bar e gelateria accogliente con un'ampia terrazza ombreggiata in un ambiente verde. Situato vicino al parco di Uriage, potrete sedervi e gustare un caffè o un drink sulla terrazza, oppure assaggiare la cucina tradizionale."
    ],
    "fr": [
      "Brasserie conviviale, bar et glacier avec une grande terrasse ombragée dans un écrin de verdure. Situé à proximité du parc d'Uriage, vous pourrez vous installer pour profiter d'un café ou d'un verre en terrasse ou bien déguster une cuisine traditionnelle."
    ],
    "nl": [
      "Gezellige brasserie, bar en ijssalon met een groot schaduwrijk terras in een groene omgeving. In de buurt van het Uriage-park kun je genieten van een kopje koffie of een drankje op het terras, of de traditionele keuken proeven."
    ],
    "es": [
      "Agradable Brasserie, Bar, Heladería con gran terraza sombreada a 10 minutos de Vizille y muy cerca del Parc d'Uriage."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie L'Avenue"
    ]
  },
