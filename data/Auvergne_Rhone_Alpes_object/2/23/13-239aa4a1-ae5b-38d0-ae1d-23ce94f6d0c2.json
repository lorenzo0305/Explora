  "rdfs:comment": {
    "de": [
      "Nächtliche Führung mit Laternen durch dieses hübsche, hochgelegene Dorf, das einen außergewöhnlichen Blick auf die Ebene von Valdaine bietet."
    ],
    "en": [
      "Guided night-time lantern-lit tour of this pretty perched village, offering exceptional views over the Valdaine plain."
    ],
    "it": [
      "Visita guidata di questo grazioso villaggio collinare che offre una vista eccezionale sulla pianura valdostana."
    ],
    "fr": [
      "Visite guidée de ce joli village perché offrant une vue exceptionnelle sur la plaine de la Valdaine."
    ],
    "es": [
      "Visita guiada de este bonito pueblo situado en lo alto de una colina que ofrece unas vistas excepcionales de la llanura valdanesa."
    ],
    "nl": [
      "Nachtelijke rondleiding met lantaarns door dit mooie dorp op een heuvel met een prachtig uitzicht over de Valdaine vlakte."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée de Puygiron"
    ]
  },
