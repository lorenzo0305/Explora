  "rdfs:comment": {
    "de": [
      "Bierfest in Bourg de Péage, St. Patrick's Day, Sturmbio, Importeur von belgischen und deutschen Bieren, spezialisiert auf glutenfreie Bio- und Bio-Biere, Bio-Weine.\r\nVermietung von Bierzapfanlagen, personalisierte ökologisch verantwortliche Becher."
    ],
    "en": [
      "Beer festival in July in Bourg de Péage, St Patrick's Day, Sturmbio, importer of Belgian and German beers, specializing in organic and gluten-free beers, organic wines.\r\nBeer taps for hire, customized eco-friendly cups."
    ],
    "it": [
      "Festa della birra a Bourg de Péage, San Patrizio, Sturmbio, importatore di birre belghe e tedesche, specializzato in birre biologiche e senza glutine, vini biologici.\r\nNoleggio di rubinetti per birra, bicchieri ecologici personalizzati."
    ],
    "fr": [
      "Fête de la Bière à bourg de Péage, Fête de la St Patrick, Sturmbio, importateur de bières belges et allemandes, spécialisé dans les bières bio et bio sans gluten, vins bio.\r\nLocation tireuses à bière, gobelets personnalisés éco responsables."
    ],
    "es": [
      "Fiesta de la cerveza en Bourg de Péage, Día de San Patricio, Sturmbio, importador de cervezas belgas y alemanas, especializado en cervezas ecológicas y sin gluten, vinos ecológicos.\r\nAlquiler de grifos de cerveza, vasos ecológicos personalizados."
    ],
    "nl": [
      "Bierfestival in Bourg de Péage, St Patrick's Day festival, Sturmbio, importeur van Belgische en Duitse bieren, gespecialiseerd in biologische en glutenvrije bieren, biologische wijnen.\r\nVerhuur van biertaps, gepersonaliseerde milieuvriendelijke bekers."
    ]
  },
