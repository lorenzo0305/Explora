  "rdfs:comment": {
    "de": [
      "Direktverkauf der Produkte unserer Bauernhöfe.\r\nVon Donnerstag bis Samstag empfangen Sie die Erzeuger im Laden und verkaufen ihre Produkte. Bauernhofprodukte, Bioprodukte, wir bieten Qualitätsprodukte zu fairen Preisen an."
    ],
    "en": [
      "Direct sales of products from our farms.\r\nFrom Thursday to Saturday, producers welcome you to the store and sell their products. From farm products to organic produce, we offer quality products at fair prices."
    ],
    "it": [
      "Vendita diretta dei prodotti delle nostre aziende agricole.\r\nDa giovedì a sabato, i produttori vi accolgono in negozio e vendono i loro prodotti. Prodotti di fattoria, prodotti biologici, offriamo prodotti di qualità a prezzi equi."
    ],
    "fr": [
      "Vente directe des produits de nos fermes. \r\nDu jeudi au samedi, les producteurs vous accueillent au magasin et vendent leurs produits. Produits fermiers, produits bio, nous proposons des produits de qualité, à des prix justes."
    ],
    "es": [
      "Venta directa de productos de nuestras granjas.\r\nDe jueves a sábado, los productores le dan la bienvenida a la tienda y venden sus productos. Productos de granja, productos ecológicos, ofrecemos productos de calidad a precios justos."
    ],
    "nl": [
      "Directe verkoop van producten van onze boerderijen.\r\nVan donderdag tot zaterdag verwelkomen producenten je in de winkel en verkopen ze hun producten. Producten van de boerderij, biologische producten, wij bieden kwaliteitsproducten tegen eerlijke prijzen."
    ]
  },
