  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/beeb1246-914d-3bad-af1e-a7e27a8344bb",
      "dc:description": {
        "de": [
          "Einführung in das Longe côte ab 9:30 Uhr mit dem Club Bouger les pieds dans l'eau. Treffpunkt vor Ort am Chemin des Bateaux um 9:15 Uhr (hinter der Rettungsstation). Anmeldung beim Fremdenverkehrsamt erforderlich. Preis: 15 Euro."
        ],
        "en": [
          "Introduction to longe côte from 9.30 am with Club Bouger les pieds dans l'eau. Meet at Chemin des Bateaux at 9:15 am (behind the lifeguard station). Registration essential at the Tourist Office. Price: 15 euros."
        ],
        "it": [
          "Introduzione alla longe côte dalle 9.30 con il Club Bouger les pieds dans l'eau. Ritrovo al Chemin des Bateaux alle 9.15 (dietro la stazione dei bagnini). Iscrizione obbligatoria presso l'Ufficio del Turismo. Prezzo: 15 euro."
        ],
        "fr": [
          "Initiation au longe côte dès 9h30 avec le Club Bouger les pieds dans l'eau. Rendez-vous sur place au Chemin des Bateaux à 9h15 (derrière le poste de secours). Inscription indispensable à l'Office de Tourisme. Tarif : 15 euros."
        ],
        "nl": [
          "Kennismaking met longe côte vanaf 9.30 uur met de Club Bouger les pieds dans l'eau. Verzamelen bij Chemin des Bateaux om 9.15 uur (achter de reddingspost). Inschrijven is noodzakelijk bij het toeristenbureau. Prijs: 15 euro."
        ],
        "es": [
          "Iniciación a la longe côte a partir de las 9.30 h con el Club Bouger les pieds dans l'eau. Cita en el Chemin des Bateaux a las 9h15 (detrás del puesto de socorro). Imprescindible inscribirse en la Oficina de Turismo. Precio: 15 euros."
        ]
      },
