  "rdfs:comment": {
    "de": [
      "In einer grünen Umgebung \"auf dem Land\", 15 Minuten vom Meer und der Baie de Somme und der Cote d'Opale mit ihren feinen Sandstränden entfernt."
    ],
    "en": [
      "In a green setting \"in the countryside\", 15 minutes from the sea and the Bay of Somme and Cote d'Opale and fine sandy beaches."
    ],
    "it": [
      "In un ambiente verde \"in campagna\", a 15 minuti dal mare e dalla Baie de Somme e dalla Cote d'Opale e dalle spiagge di sabbia fine."
    ],
    "fr": [
      "Dans un cadre de verdure \"à la campagne\", à 15 mn de la mer et de la Baie de Somme et Cote d'Opale et plages de sables fin."
    ],
    "nl": [
      "In een groene omgeving \"op het platteland\", op 15 minuten van de zee en de Baie de Somme en Cote d'Opale en fijne zandstranden."
    ],
    "es": [
      "En un entorno verde \"en el campo\", a 15 minutos del mar y de la Baie de Somme y la Cote d'Opale y playas de arena fina."
    ]
  },
