  "rdfs:comment": {
    "de": [
      "Kevin Sermoz ist ein Fan der Serie Ninja Turtles und bietet Ihnen Qualitätsprodukte an, die er mit Hilfe von traditionellem Know-how, wie dem Kneten und Formen des Teigs von Hand, herstellt. Pizzas sind nur zum Mitnehmen erhältlich, Bestellungen vor Ort oder per Telefon."
    ],
    "en": [
      "Passionate about pizza and lover of the Ninja Turtles series, Kevin Sermoz offers you quality products and uses ancestral know-how of kneading and shaping the dough by hand."
    ],
    "it": [
      "Fan della serie delle Tartarughe Ninja, Kevin Sermoz vi offre prodotti di qualità grazie al suo sapere ancestrale di impastare e modellare la pasta a mano. Pizze solo da asporto, da ordinare sul posto o per telefono."
    ],
    "fr": [
      "Amateur de la série des Tortues Ninja, Kevin Sermoz vous propose des produits de qualité grâce à un savoir-faire ancestral de pétrissage et façonnage de la pâte à la main. Pizzas à emporter uniquement .Commande sur place ou par téléphone."
    ],
    "es": [
      "Fan de la serie de las Tortugas Ninja, Kevin Sermoz le ofrece productos de calidad gracias a su saber hacer ancestral de amasar y dar forma a la masa a mano. Pizzas solo para llevar, pedido in situ o por teléfono."
    ],
    "nl": [
      "Als fan van de serie Ninja Turtles biedt Kevin Sermoz u kwaliteitsproducten dankzij zijn voorouderlijke knowhow van het kneden en vormen van het deeg met de hand. Alleen pizza's om mee te nemen, ter plaatse of telefonisch te bestellen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Piz'a Donatello"
    ],
    "fr": [
      "Piz'a Donatello"
    ]
  },
