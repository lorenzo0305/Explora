  "rdfs:comment": {
    "de": [
      "Hausgemachte Küche aus frischen und lokalen Produkten für ein authentisches Erlebnis inmitten eines außergewöhnlichen Ortes. Wir begrüßen Sie in einem atypischen Rahmen am Eingang des geschützten Naturreservats."
    ],
    "en": [
      "Home-cooked cuisine, using fresh local produce, for an authentic experience in the heart of an exceptional site. We welcome you to an atypical setting, at the entrance to the protected nature reserve."
    ],
    "it": [
      "Cucina casalinga con prodotti freschi locali, per un'esperienza autentica nel cuore di un sito eccezionale. Vi diamo il benvenuto in un ambiente insolito, all'ingresso della riserva naturale protetta."
    ],
    "fr": [
      "Cuisine maison, élaborée à partir de produits frais et locaux, pour une expérience authentique au cœur d’un site d’exception. Nous vous accueillons dans un cadre atypique, à l’entrée de la réserve naturelle protégée."
    ],
    "nl": [
      "Thuis koken met verse streekproducten, voor een authentieke ervaring in het hart van een uitzonderlijke site. We verwelkomen je in een ongewone omgeving, aan de ingang van het beschermde natuurgebied."
    ],
    "es": [
      "Cocina casera con productos locales frescos, para vivir una experiencia auténtica en el corazón de un paraje excepcional. Le damos la bienvenida en un marco insólito, a la entrada de la reserva natural protegida."
    ]
  },
