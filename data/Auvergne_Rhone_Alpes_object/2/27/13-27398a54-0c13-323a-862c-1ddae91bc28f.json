  "rdfs:comment": {
    "de": [
      "Diese Route, die im Zentrum von Châtel beginnt, bietet Ihnen einen Rundweg über die Almen mit zahlreichen Aussichtspunkten. Sie ist anspruchsvoll und für erfahrene Mountainbiker geeignet."
    ],
    "en": [
      "Leaving from the centre of Châtel, this route takes you on a loop through the mountain pastures, with numerous viewpoints. This challenging route is aimed at experienced mountain bikers."
    ],
    "it": [
      "Partendo dal centro di Châtel, questo percorso si snoda ad anello attraverso gli alpeggi, con numerosi punti panoramici. Difficile da percorrere, è adatto a ciclisti esperti."
    ],
    "fr": [
      "Cet itinéraire au départ du centre de Châtel vous propose une boucle dans les alpages, avec de nombreux points de vue. D'un niveau difficile, il s'adresse à des vététistes expérimentés."
    ],
    "es": [
      "Partiendo del centro de Châtel, esta ruta le llevará por un bucle a través de los pastos de montaña, con numerosos miradores. Difícil de completar, es apta para ciclistas de montaña experimentados."
    ],
    "nl": [
      "Deze route vertrekt vanuit het centrum van Châtel en neemt u mee op een lus door de bergweiden, met talrijke uitkijkpunten. Deze uitdagende route is bedoeld voor ervaren mountainbikers."
    ]
  },
  "rdfs:label": {
    "en": [
      "E-Bike route - Châtel (N°19)"
    ],
    "fr": [
      "Itinéraire E-Bike - Châtel (N°19)"
    ],
    "nl": [
      "E-bike route - Châtel (N°19)"
    ]
  },
