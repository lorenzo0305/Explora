  "rdfs:comment": {
    "de": [
      "Asiatischer Geschmack im Herzen von Taninges.\r\nReisen Sie mit einem Bissen, Indonesien kommt an Ihren Tisch!\r\nAsiatische Küche und Streetfood."
    ],
    "en": [
      "Asian flavors in the heart of Taninges.\r\nTravel to Indonesia in one bite!\r\nAsian cuisine and street food."
    ],
    "it": [
      "Sapori asiatici nel cuore di Taninges.\r\nFate un viaggio in un solo boccone, l'Indonesia si invita alla vostra tavola!\r\nCucina asiatica e street food."
    ],
    "fr": [
      "Saveurs d'Asie au cœur de Taninges.\r\nVoyagez en une bouchée, l'Indonésie s'invite à votre table !\r\nCuisine et street food asiatique."
    ],
    "es": [
      "Sabores asiáticos en el corazón de Taninges.\r\nViaje de un bocado: ¡Indonesia se invita a su mesa!\r\nCocina asiática y comida callejera."
    ],
    "nl": [
      "Aziatische smaken in het hart van Taninges.\r\nMaak een reis in één hap, Indonesië nodigt zichzelf uit aan je tafel!\r\nAziatische keuken en streetfood."
    ]
  },
