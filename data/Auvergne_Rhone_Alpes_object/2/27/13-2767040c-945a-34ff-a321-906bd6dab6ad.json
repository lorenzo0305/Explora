  "rdfs:comment": {
    "de": [
      "Aude empfängt Sie von Donnerstag bis Samstag mit einem Lächeln und bietet Ihnen ihre köstlichen handgemachten Pizzas zum Mitnehmen sowie ihre hausgemachten Desserts an."
    ],
    "en": [
      "Aude welcomes you with a smile from Thursday to Saturday where she has delicious authentic pizzas on offer and some delecious home made desserts"
    ],
    "it": [
      "Aude vi accoglie con un sorriso dal giovedì al sabato per offrirvi le sue deliziose pizze fatte in casa da asporto e i suoi dolci fatti in casa."
    ],
    "fr": [
      "Aude vous accueille avec le sourire du jeudi au samedi pour vous proposer ses délicieuses pizzas artisanales à emporter ainsi que ses desserts maison."
    ],
    "es": [
      "Aude te recibe con una sonrisa de jueves a sábado para ofrecerte sus deliciosas pizzas caseras para llevar, así como sus postres caseros."
    ],
    "nl": [
      "Aude ontvangt u met een glimlach van donderdag tot zaterdag om u haar heerlijke zelfgemaakte pizza's om mee te nemen en haar zelfgemaakte desserts aan te bieden."
    ]
  },
  "rdfs:label": {
    "en": [
