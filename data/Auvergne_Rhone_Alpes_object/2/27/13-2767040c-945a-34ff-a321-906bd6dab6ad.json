            "en": [
              "Open every day during school vacations (except December 24, 25 and 31).\r\nAdvance orders recommended to avoid overcrowding.\r\nAUTUMN CLOSURE: October 21 to November 13, 2024."
            ],
            "it": [
              "Aperto tutti i giorni durante le vacanze scolastiche (tranne il 24, 25 e 31 dicembre).\r\nSi consiglia di ordinare in anticipo per evitare il sovraffollamento.\r\nCHIUSURA AUTUNNALE: dal 21 ottobre al 13 novembre 2024."
            ],
            "fr": [
              "Ouverture tous les jours pendant les vacances scolaires (sauf 24, 25 et 31 décembre).\r\nConseillé de passer commande à l'avance pour éviter l'affluence.\r\nFERMETURE AUTOMNE : du 21 octobre au 13 novembre 2024."
            ],
            "nl": [
              "Elke dag geopend tijdens schoolvakanties (behalve 24, 25 en 31 december).\r\nHet is aan te raden van tevoren te bestellen om overbevolking te voorkomen.\r\nAUTUMN CLOSURE: van 21 oktober tot 13 november 2024."
            ],
            "es": [
              "Abierto todos los días durante las vacaciones escolares (excepto el 24, 25 y 31 de diciembre).\r\nSe aconseja pedir con antelación para evitar aglomeraciones.\r\nCIERRE DE OTOÑO: del 21 de octubre al 13 de noviembre de 2024."
            ]
          },
