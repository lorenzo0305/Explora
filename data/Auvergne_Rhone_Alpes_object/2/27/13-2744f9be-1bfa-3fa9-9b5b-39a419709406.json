  "rdfs:comment": {
    "de": [
      "Originelle und gemütliche Modeboutique, die hochwertige Kleidung und Accessoires zu günstigen Preisen anbietet. Ein freundlicher Empfang, persönliche Beratung und eine trendige Auswahl sorgen für einen angenehmen Einkaufsbummel im Herzen von Hauterives."
    ],
    "en": [
      "Original, friendly fashion boutique offering quality clothing and accessories at affordable prices. A smiling welcome, personalized advice and a trendy selection make for a pleasant shopping experience in the heart of Hauterives."
    ],
    "it": [
      "Una boutique di moda accogliente e originale che offre abbigliamento e accessori di qualità a prezzi accessibili. Accoglienza cordiale, consigli personalizzati e una selezione delle ultime novità di moda rendono piacevole lo shopping nel cuore di Hauterives."
    ],
    "fr": [
      "Boutique de mode originale et chaleureuse, proposant vêtements et accessoires de qualité à prix doux. Accueil souriant, conseils personnalisés et sélection tendance pour un moment shopping agréable au cœur d’Hauterives."
    ],
    "es": [
      "Una tienda de moda cálida y original que ofrece ropa y accesorios de calidad a precios asequibles. Acogida cordial, consejos personalizados y una selección a la última para una agradable experiencia de compra en el corazón de Hauterives."
    ],
    "nl": [
      "Een warme en originele modeboetiek met kwaliteitskleding en accessoires tegen betaalbare prijzen. Een vriendelijk onthaal, persoonlijk advies en een trendy selectie zorgen voor een aangename winkelervaring in het hart van Hauterives."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Armoire de Rosalie"
    ]
  },
