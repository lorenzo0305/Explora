  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/137321b8-0d56-3c65-880d-026a9b4c4853",
      "dc:description": {
        "de": [
          "Mittwoch, 18. Februar\n--------------------------------------\nAktivität \"Baby Gym\", die vom Animationsdienst des Rathauses von Merlimont angeboten wird\nIn der Mehrzweckhalle von Merlimont am Bahnhofsplatz, von 9:30 bis 10:15 Uhr\nTARIF: 3? pro Person\n\nSie können sich beim Service Animation im Fremdenverkehrsamt von Merlimont anmelden: 70 Avenue du centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Rathaus von Merlimont"
        ],
        "en": [
          "Wednesday, February 18th\n--------------------------------------\nBaby Gym\" activity organized by the Merlimont Town Council's Activities Department\nAt the Merlimont multi-purpose hall in place de la gare, from 9.30am to 10.15am\nRATE: 3? per person\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Mairie de Merlimont"
        ],
        "it": [
          "Mercoledì 18 febbraio\n--------------------------------------\nAttività \"Baby Gym\" a cura dell'Ufficio Eventi del Comune di Merlimont\nPresso la sala polivalente Merlimont in place de la gare, dalle 9.30 alle 10.15\nTARIFFA : 3? a persona\n\nÈ possibile iscriversi presso il Servizio Animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Comune di Merlimont"
        ],
        "fr": [
          "Mercredi 18 Février \n--------------------------------------\nActivité \"Baby Gym\" proposée par le Service Animation de la Mairie de Merlimont\nA la salle polyvalente de Merlimont à la place de la gare, de 9h30 à 10h15\nTARIF : 3€ par personne\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Mairie de Merlimont"
        ],
        "nl": [
          "Woensdag 18 februari\n--------------------------------------\nBaby Gym\" activiteit georganiseerd door de dienst evenementen van het stadhuis van Merlimont\nIn de polyvalente zaal van Merlimont op de Place de la Gare, van 9u30 tot 10u15\nTarief : 3? per persoon\n\nJe kunt je inschrijven bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Stadhuis van Merlimont"
        ],
        "es": [
          "Miércoles 18 de febrero\n--------------------------------------\nActividad \"Baby Gym\" organizada por el Departamento de Eventos del Ayuntamiento de Merlimont\nEn la sala polivalente de Merlimont, en la place de la gare, de 9.30 h a 10.15 h\nTARIFA : 3? por persona\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9.00 a 12.00 h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Ayuntamiento de Merlimont"
        ]
      },
