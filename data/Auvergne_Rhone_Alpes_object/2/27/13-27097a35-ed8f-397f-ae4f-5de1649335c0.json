  "rdfs:comment": {
    "de": [
      "Klettern Sie in der Kletterhalle der Routen in der Region Chambérienne!\r\nRouten bis zu 14 m Höhe! Eine Halle zum Anfangen, Üben, Trainieren und Spaß haben in Chambéry, neben dem Lac du Bourget."
    ],
    "en": [
      "Climb-up Chambéry is one of biggest indoor climbing areas in France for beginners and experienced climbers. Families welcome for tips on starting out. Lessons on request."
    ],
    "it": [
      "Arrampicatevi nella palestra di roccia della regione di Chambéry!\r\nPercorsi fino a 14 metri di altezza! Una palestra di arrampicata per imparare, esercitarsi, allenarsi e divertirsi a Chambéry, vicino al Lac du Bourget."
    ],
    "fr": [
      "Grimpez dans la salle d'escalade de voies de la région Chambérienne !\r\nDes voies jusqu’à 14 mètres de haut ! Une salle pour s’initier, pratiquer, s’entraîner et s’amuser à Chambéry, à côté du lac du Bourget."
    ],
    "nl": [
      "Klimmen in de klimzaal van de regio Chambéry!\r\nRoutes tot 14 meter hoog! Een klimzaal om te leren, oefenen, trainen en plezier te maken in Chambéry, naast het Lac du Bourget."
    ],
    "es": [
      "Escala en el rocódromo de la región de Chambéry\r\n¡Rutas de hasta 14 metros de altura! Un gimnasio de escalada para aprender, practicar, entrenar y divertirse en Chambéry, junto al lago del Bourget."
    ]
  },
