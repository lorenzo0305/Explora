  "rdfs:comment": {
    "de": [
      "Union der Künstler und Handwerker von Saoû"
    ],
    "en": [
      "Union of artists and craftsmen of Saoû"
    ],
    "it": [
      "Siamo un'associazione di artisti e artigiani con sede a Saoû, nella Valle della Drôme. I nostri laboratori propongono creazioni di tornitori del legno, gioiellieri, ceramisti, artisti visivi, pittori, modiste e artisti dell'immagine."
    ],
    "fr": [
      "Nous sommes une association d’artistes et artisans d’art installés à Saoû, dans la Vallée de la Drôme. Nos ateliers proposent les créations de tourneur sur bois, bijoutier, potier, plasticien, peintre, modiste et artisan de l’image."
    ],
    "nl": [
      "Unie van kunstenaars en ambachtslieden van Saoû"
    ],
    "es": [
      "Somos una asociación de artistas y artesanos con sede en Saoû, en el valle del Drôme. Nuestros talleres ofrecen creaciones de torneros de madera, joyeros, alfareros, artistas plásticos, pintores, sombrereros y artistas de la imagen."
    ]
