  "rdfs:comment": {
    "de": [
      "\"Bar à Vin\" - \"Table à Vin\" im Herzen des Pré Carré in Annecy bietet eine Weinkarte mit +700 Referenzen, darunter 200 Champagner, sowie Bretter und Teller, die Sie je nach Saison teilen können."
    ],
    "en": [
      "The \"Bar à Vin\" - \"Table à Vin\" in the heart of Annecy's Pré Carré offers a wine list of over 700 wines, including 200 from Champagne, as well as seasonal platters and plates to share."
    ],
    "it": [
      "il \"Bar à Vin\" e la \"Table à Vin\" nel cuore del Pré Carré offrono una carta dei vini di oltre 900 etichette, di cui 200 della regione dello Champagne, oltre a piatti stagionali e da condividere."
    ],
    "fr": [
      "\"Bar à Vin\", \"Table à Vin\" en plein cœur du Pré Carré offre une carte des vins de +900 références dont 200 en Champagne ainsi que des planches et assiettes à partager au fil des saisons."
    ],
    "es": [
      "el \"Bar à Vin\" y la \"Table à Vin\", en el corazón del Pré Carré, ofrecen una carta de más de 900 vinos, 200 de ellos de la región de Champaña, así como platos de temporada y para compartir."
    ],
    "nl": [
      "de \"Bar à Vin\" en \"Table à Vin\" in het hart van Pré Carré biedt een wijnkaart met meer dan 900 wijnen, waaronder 200 uit de Champagnestreek, evenals seizoensgebonden schotels en gedeelde gerechten."
    ]
  },
