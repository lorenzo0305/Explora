  "rdfs:comment": {
    "de": [
      "Arcade Café ist ein dritter Ort im Dienste der lokalen Bevölkerung, der die Öffentlichkeit und Vereine empfängt, um den sozialen Zusammenhalt zu fördern. Das Arcade Café beherbergt auch die Stadtbibliothek und ist ein Vereinscafé, das zahlreiche Workshops anbietet."
    ],
    "en": [
      "Arcade Café is a third place serving the local population, welcoming the public and associations to encourage social interaction. Arcade Café is also home to the municipal library and a café for associations offering a wide range of workshops."
    ],
    "it": [
      "L'Arcade Café è un terzo luogo al servizio della popolazione locale, che accoglie il pubblico e le associazioni per favorire l'interazione sociale. L'Arcade Café ospita anche la biblioteca locale ed è un caffè per le associazioni che offrono un'ampia gamma di laboratori."
    ],
    "fr": [
      "Arcade Café est un tiers lieu au service de la population locale accueillant public et associations pour favoriser le lien social. Arcade Café accueille également la bibliothèque municipale et c'est aussi un café associatif proposant de nombreux ateliers."
    ],
    "nl": [
      "Arcade Café is een derde ontmoetingsplaats voor de lokale bevolking, waar het publiek en verenigingen terecht kunnen voor sociale interactie. Arcade Café biedt ook onderdak aan de plaatselijke bibliotheek en is een verenigingscafé waar tal van workshops worden georganiseerd."
    ],
    "es": [
      "Arcade Café es un tercer lugar al servicio de la población local, que acoge al público y a las asociaciones para fomentar la interacción social. Arcade Café también alberga la biblioteca local y es un café para asociaciones que ofrece una amplia gama de talleres."
    ]
  },
  "rdfs:label": {
