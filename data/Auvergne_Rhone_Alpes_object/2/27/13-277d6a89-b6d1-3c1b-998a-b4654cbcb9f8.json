  "rdfs:comment": {
    "de": [
      "Kommen Sie und teilen Sie einen geselligen Moment in guter Stimmung rund um ein Festmahl: die Paketfüße! Für diejenigen, die sie nicht mögen, gibt es eine Schweinefleischpfanne mit Oliven.\r\nNach dem Essen geht der Abend weiter mit Gesellschaftsspielen, Karten."
    ],
    "en": [
      "Come and share a convivial moment in good spirits around a feast: package feet! For those who don't like them, you'll be treated to a pork sauté with olives.\r\nAfter the meal, the evening continues with board games and cards."
    ],
    "it": [
      "Venite a condividere un momento di convivialità e di buon umore davanti a un banchetto: i pieds paquets! Per coloro che non li amano, vi sarà offerto un sauté di maiale con olive.\r\nDopo il pasto, la serata prosegue con giochi da tavolo e carte."
    ],
    "fr": [
      "Venez partager un moment convivial dans la bonne humeur autour d'un festin : les pieds paquets ! Pour celles et ceux qui ne les aiment pas, vous aurez droit à un sauté de porc aux olives.\r\nAprès le repas, la soirée continue avec des jeux de société, carte."
    ],
    "es": [
      "Venga a compartir un momento de buena convivencia en torno a un festín: ¡los pieds paquets! Para los que no les gusten, se les obsequiará con un salteado de cerdo con aceitunas.\r\nTras la comida, la velada continúa con juegos de mesa y cartas."
    ],
    "nl": [
      "Kom gezellig samenzijn bij een feestmaal: pieds paquets! Wie daar niet van houdt, wordt getrakteerd op een sauté van varkensvlees met olijven.\r\nNa de maaltijd gaat de avond verder met gezelschapsspelen en kaarten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Veillée d'antan :  pieds et paquets"
    ]
  },
