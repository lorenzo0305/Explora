  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen von Dienstag bis Freitag mittags ein Tagesmenü mit Vorspeisen nach Wahl, immer ein Fleisch oder Fisch, Käse oder Dessert und einen Kaffee um 17?"
    ],
    "en": [
      "From Tuesday to Friday lunchtime we offer a menu of the day with a choice of starters, meat or fish, cheese or dessert and coffee at €16.50."
    ],
    "it": [
      "Dal martedì al venerdì a pranzo offriamo un menu del giorno con una scelta di antipasti, carne o pesce, formaggio o dessert e caffè a 17?"
    ],
    "fr": [
      "Nous vous proposons du mardi au vendredi midi un menu du jour avec entrées au choix, toujours une viande ou un poisson, fromage ou dessert et un café à 17 €."
    ],
    "nl": [
      "Van dinsdag tot vrijdag bieden we 's middags een dagmenu met keuze uit voorgerechten, vlees of vis, kaas of dessert en koffie voor 17?"
    ],
    "es": [
      "De martes a viernes al mediodía ofrecemos un menú del día a elegir entre entrantes, carne o pescado, queso o postre y café a 17?"
    ]
  },
