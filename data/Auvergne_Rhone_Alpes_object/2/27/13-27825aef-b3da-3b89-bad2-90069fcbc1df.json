  "rdfs:comment": {
    "de": [
      "Dieses Stadthaus wurde 1898 von Ernest Mizard erbaut. Wie der Name schon sagt, bezieht sich das Stadthaus auf die flämische Renaissance; insbesondere die Backsteinwände sind mit zahlreichen Skulpturen verziert"
    ],
    "en": [
      "This mansion was built by Ernest Mizard in 1898. As its name suggests, the mansion refers to the Flemish Renaissance; the brick walls are decorated with numerous sculptures"
    ],
    "it": [
      "Questo palazzo fu costruito da Ernest Mizard nel 1898. Come suggerisce il nome, la dimora si rifà al Rinascimento fiammingo; le pareti in mattoni sono decorate con numerose sculture"
    ],
    "fr": [
      "Cet hôtel particulier a été édifié par Ernest Mizard en 1898. Comme son nom l'indique, l'hôtel particulier fait référence à la Renaissance flamande ; les murs de briques sont notamment décorés de nombreuses sculptures"
    ],
    "es": [
      "Esta mansión fue construida por Ernest Mizard en 1898. Como su nombre indica, la mansión hace referencia al Renacimiento flamenco; las paredes de ladrillo están decoradas con numerosas esculturas"
    ],
    "nl": [
      "Dit herenhuis werd gebouwd door Ernest Mizard in 1898. Zoals de naam doet vermoeden, verwijst het herenhuis naar de Vlaamse Renaissance; de bakstenen muren zijn versierd met talrijke beelden"
    ]
  },
