      "dc:description": {
        "de": [
          "Künstlerische Veranstaltung\nSamstag, 1. und Sonntag, 2. November\nVon 10 bis 12.30 Uhr und von 14 bis 18 Uhr\n-----------------------------\nOrganisiert von der Association Palette Attinoise\nMit Beteiligung regionaler Künstler\n\nOrt: Salle Polyvalente d'Attin - Freier Eintritt\nKontakt: 06 66 46 34 37 oder 06 20 80 65 34\n\nKredit: La Palette Attinoise"
        ],
        "en": [
          "Artistic event\nSaturday November 1 and Sunday November 2\n10 am to 12:30 pm and 2 pm to 6 pm\n-----------------------------\nOrganized by the Palette Attinoise association\nWith the participation of regional artists\n\nVenue: Salle Polyvalente d?Attin - Free admission\nContact: 06 66 46 34 37 or 06 20 80 65 34\n\nCredit : La Palette Attinoise"
        ],
        "it": [
          "Evento artistico\nSabato 1 e domenica 2 novembre\nDalle 10.00 alle 12.30 e dalle 14.00 alle 18.00\n-----------------------------\nA cura dell'associazione Palette Attinoise\nCon la partecipazione di artisti regionali\n\nSede: Salle Polyvalente d'Attin - Ingresso gratuito\nContatto: 06 66 46 34 37 o 06 20 80 65 34\n\nCredito: La Palette Attinoise"
        ],
        "fr": [
          "Manifestation artistique\nSamedi 1 et dimanche 2 novembre \nDe 10h à 12h30 et de 14h à 18h\n-----------------------------\nOrganisé par l’association Palette Attinoise\nAvec la participation d’artistes régionaux\n\nLieu : Salle Polyvalente d’Attin - Entrée gratuite\nContact : 06 66 46 34 37 ou 06 20 80 65 34\n\nCrédit : La Palette Attinoise"
        ],
        "es": [
          "Evento artístico\nSábado 1 y domingo 2 de noviembre\nDe 10.00 a 12.30 h. y de 14.00 a 18.00 h\n-----------------------------\nOrganizado por la asociación Palette Attinoise\nCon la participación de artistas regionales\n\nLugar: Salle Polyvalente d'Attin - Entrada gratuita\nContacto: 06 66 46 34 37 o 06 20 80 65 34\n\nCrédito: La Palette Attinoise"
        ],
        "nl": [
          "Artistiek evenement\nZaterdag 1 en zondag 2 november\n10.00 tot 12.30 uur en 14.00 tot 18.00 uur\n-----------------------------\nGeorganiseerd door de vereniging Palette Attinoise\nMet deelname van regionale kunstenaars\n\nLocatie: Salle Polyvalente d'Attin - Gratis toegang\nContact: 06 66 46 34 37 of 06 20 80 65 34\n\nKrediet: La Palette Attinoise"
        ]
