  "rdfs:comment": {
    "de": [
      "Die Paragliding-Schule im Süden der Ardèche liegt im Herzen des Regionalparks Monts d'Ardèche. Die Schule bietet verschiedene Taufen, Ausbildungskurse und den Verkauf von Material an. Für alle Altersgruppen und ohne Altersbeschränkung. Mindestgewicht: 20 kg / Höchstgewicht: 100 kg."
    ],
    "en": [
      "South Ardèche paragliding school based in the heart of the Monts d'Ardèche regional park. The school offers a variety of first flights, training courses and equipment sales. For all ages. Minimum weight: 20 kg / Maximum weight: 100 kg."
    ],
    "it": [
      "Scuola di parapendio dell'Ardèche meridionale con sede nel cuore del parco regionale dei Monts d'Ardèche. La scuola offre una gamma di primi voli, corsi di formazione e vendita di attrezzature. Per tutte le età. Peso minimo: 20 kg / Peso massimo: 100 kg."
    ],
    "fr": [
      "Ecole de Parapente du Sud Ardèche basée au cœur du parc régional des Monts d'Ardèche. L'école propose différents baptêmes, des stages de formation et la vente de matériel. Pour tout public et sans limite d'âge. Poids min : 20 kg / Poids max : 100 kg."
    ],
    "nl": [
      "Zuid-Ardèche paragliding school gevestigd in het hart van de Monts d'Ardèche regionaal park. De school biedt een scala aan eerste vluchten, cursussen en verkoop van materiaal. Voor alle leeftijden. Minimum gewicht: 20 kg / Maximum gewicht: 100 kg."
    ],
    "es": [
      "Escuela de parapente del sur de Ardèche situada en el corazón del parque regional de los Montes de Ardèche. La escuela ofrece una gama de primeros vuelos, cursos de formación y venta de equipos. Para todas las edades. Peso mínimo: 20 kg / Peso máximo: 100 kg."
    ]
  },
  "rdfs:label": {
