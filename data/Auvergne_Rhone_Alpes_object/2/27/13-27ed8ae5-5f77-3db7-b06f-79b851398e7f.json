  "rdfs:comment": {
    "de": [
      "Im Herzen der Kluniazenserstadt wurde die Domaine de la Porterie von der Familie Fleury vollständig restauriert, wobei die denkmalgeschützte Anlage respektiert wurde."
    ],
    "en": [
      "In the heart of the Cluniac city, the Domaine de la Porterie has been entirely restored by the Fleury family, respecting the site's Monuments Historiques status."
    ],
    "it": [
      "Nel cuore della città cluniacense, la tenuta Porterie è stata interamente restaurata dalla famiglia Fleury, nel rispetto del sito protetto."
    ],
    "fr": [
      "Au cœur de la cité clunisienne, le domaine de la Porterie a été entièrement restauré par la famille Fleury dans le respect du lieu classé Monuments Historiques."
    ],
    "nl": [
      "In het hart van de Cluniac-stad is het landgoed Porterie volledig gerestaureerd door de familie Fleury, met respect voor de geklasseerde site."
    ],
    "es": [
      "En el corazón de la ciudad cluniacense, la finca de la Porterie ha sido totalmente restaurada por la familia Fleury, respetando el conjunto catalogado."
    ]
  },
