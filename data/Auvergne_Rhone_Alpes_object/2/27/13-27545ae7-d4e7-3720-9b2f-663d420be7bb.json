  "rdfs:comment": {
    "de": [
      "Ein Boutique-Hotel mit entspanntem Luxus mitten in der Fußgängerzone des Dorfes Megève, nur wenige Schritte von der Place de l'Eglise und den Skiliften entfernt."
    ],
    "en": [
      "A boutique hotel offering relaxed luxury, located in the pedestrian center of the village of Megève, a stone's throw from the church square and the ski lifts."
    ],
    "it": [
      "Le Cœur de Megève è un'istituzione locale con una posizione unica a Megève, a pochi passi dalla piazza della chiesa. Completamente rinnovato, l'hotel rivisita lo spirito dello chalet combinando toni freschi e contemporanei."
    ],
    "fr": [
      "Un boutique hôtel au luxe décontracté situé en plein centre piéton du village de Megève, à deux pas de la place de l'église et des remontées mécaniques."
    ],
    "es": [
      "Un relajado hotel boutique de lujo situado en el centro peatonal del pueblo de Megève, a tiro de piedra de la plaza de la iglesia y de los remontes."
    ],
    "nl": [
      "Een ontspannen luxe boetiekhotel in het autovrije centrum van het dorp Megève, op een steenworp afstand van het kerkplein en de skiliften."
    ]
  },
