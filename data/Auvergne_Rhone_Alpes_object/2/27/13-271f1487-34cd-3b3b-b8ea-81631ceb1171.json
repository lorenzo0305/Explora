  "rdfs:comment": {
    "de": [
      "Die schwarze, korridortypische Piste, um sich in Sicherheit herauszufordern!\r\n650m lang, 24° durchschnittliche Steigung, 290m Höhenunterschied und 33° maximale Steigung: das große Skifahren in Méribel!\r\nZu entdecken am Gipfel des Sessellifts Bouquetin / 3 Marches."
    ],
    "en": [
      "The black run is a typical couloir to challenge yourself in safety! \r\n650m long, 24° average slope, 290m vertical drop and 33° maximum slope: only for good skiers, even better with powder! \r\nTo discover at the top of the Bouquetin chairlift / 3 Marches summit."
    ],
    "it": [
      "La pista nera in stile couloir per una sfida sicura!\r\n650 m di lunghezza, 24° di pendenza media, 290 m di dislivello e 33° di pendenza massima: il grande sci a Méribel!\r\nScopritela in cima alla seggiovia Bouquetin / 3 Marche."
    ],
    "fr": [
      "La piste noire typée couloir pour se challenger en sécurité ! \r\n650m de long, 24° de pente moyenne, 290m de dénivelés et 33° de pente maxi : le grand ski à Méribel ! \r\nÀ découvrir au sommet du télésiège de Bouquetin / 3 Marches."
    ],
    "es": [
      "¡La pista negra estilo couloir para un desafío seguro!\r\n650 m de longitud, 24° de pendiente media, 290 m de desnivel y 33° de pendiente máxima: ¡esquí fantástico en Méribel!\r\nDescúbrala en lo alto del telesilla Bouquetin / 3 Marches."
    ],
    "nl": [
      "The black run is a typical couloir to challenge yourself in safety! \r\n650m long, 24° average slope, 290m vertical drop and 33° maximum slope: only for good skiers, even better with powder! \r\nTo discover at the top of the Bouquetin chairlift / 3 Marches summit."
    ]
  },
  "rdfs:label": {
