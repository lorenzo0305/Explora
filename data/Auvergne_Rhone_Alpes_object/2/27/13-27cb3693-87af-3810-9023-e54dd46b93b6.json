  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Rhodos ist das ganze Jahr über in Betrieb. Unsere Köche sind erfahren, talentiert und kennen die besten Lieferanten für lokale Produkte. Wir haben 3 Dienste pro Tag, die Frühstück, Mittag- und Abendessen umfassen."
    ],
    "en": [
      "The Rhodos restaurant operates throughout the year. Our chefs are experienced, talented and know the best suppliers of the local produce. We have 3 services per day including breakfast, lunch and dinner."
    ],
    "it": [
      "Les Rhodos è aperto tutto l'anno. I nostri chef hanno esperienza, talento e conoscono i migliori fornitori di prodotti locali. Abbiamo 3 servizi al giorno che comprendono colazione, pranzo e cena."
    ],
    "fr": [
      "Le restaurant Les Rhodos fonctionne toute l'année. Nos chefs sont expérimentés, talentueux et connaissent les meilleurs fournisseurs de produits locaux. Nous avons 3 services par jour comprenant le petit-déjeuner, le déjeuner et le dîner."
    ],
    "nl": [
      "Les Rhodos is het hele jaar door geopend. Onze koks zijn ervaren, getalenteerd en kennen de beste leveranciers van lokale producten. We hebben 3 diensten per dag, waaronder ontbijt, lunch en diner."
    ],
    "es": [
      "Les Rhodos está abierto todo el año. Nuestros chefs tienen experiencia, talento y conocen a los mejores proveedores de productos locales. Disponemos de 3 servicios al día que incluyen el desayuno, la comida y la cena."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Les Rhodos"
    ],
    "fr": [
      "Les Rhodos"
    ]
  },
