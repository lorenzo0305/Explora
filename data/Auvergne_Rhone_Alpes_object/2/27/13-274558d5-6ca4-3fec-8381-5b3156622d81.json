  "rdfs:comment": {
    "de": [
      "Zum Mittag- oder Abendessen laden der Chefkoch und sein Team Sie ein, eine raffinierte Karte mit Vorschlägen zu genießen, die mit saisonalen Produkten zubereitet werden."
    ],
    "en": [
      "For lunch or dinner, our Chef and his team invite you to enjoy a refined menu of suggestions made with seasonal products."
    ],
    "it": [
      "Per il pranzo o la cena, lo chef e il suo team vi invitano a gustare un raffinato menu di proposte con prodotti di stagione."
    ],
    "fr": [
      "Au déjeuner ou au dîner, le Chef et  son équipe vous invitent à apprécier une carte raffinée de suggestions élaborés avec des produits de saison."
    ],
    "nl": [
      "Voor lunch of diner nodigen de chef en zijn team je uit om te genieten van een verfijnd menu met suggesties op basis van seizoensproducten."
    ],
    "es": [
      "Para el almuerzo o la cena, el Chef y su equipo les invitan a disfrutar de un refinado menú de sugerencias hechas con productos de temporada."
    ]
  },
