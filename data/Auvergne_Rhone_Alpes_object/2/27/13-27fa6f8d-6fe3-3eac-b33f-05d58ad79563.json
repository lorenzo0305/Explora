  "rdfs:comment": {
    "de": [
      "Tretboot, Stand up Paddle, Kajak, Windsurfing, führerscheinfreies Boot und Fischerboot: Stundenweise Vermietung oder Kurse mit einem diplomierten Lehrer - Sie entscheiden, wie Sie den See genießen möchten!"
    ],
    "en": [
      "Pedalos, stand-up paddles, kayaks, windsurfing boards, boats without a licence and fishing boats: hire by the hour or take a course with a qualified instructor - you choose how you enjoy the lake!"
    ],
    "it": [
      "Pedalò, stand-up paddle, kayak, tavole da windsurf, barche senza patente e barche da pesca: noleggiate a ore o seguite un corso con un istruttore qualificato - scegliete voi come godervi il lago!"
    ],
    "fr": [
      "Pédalo, stand up paddle, kayak, planche à voile, bateau sans permis et barque de pêche : location à l'heure ou cours avec un moniteur diplômé, c'est vous qui choisissez votre manière de profiter du lac !"
    ],
    "nl": [
      "Waterfietsen, stand-up paddles, kajaks, windsurfplanken, boten zonder vaarbewijs en visboten: huur per uur of volg een cursus met een gekwalificeerde instructeur - jij kiest hoe je van het meer geniet!"
    ],
    "es": [
      "Pedales, stand-up paddles, kayaks, tablas de windsurf, embarcaciones sin licencia y barcos de pesca: alquile por horas o realice un curso con un instructor cualificado... ¡usted elige cómo disfrutar del lago!"
    ]
  },
