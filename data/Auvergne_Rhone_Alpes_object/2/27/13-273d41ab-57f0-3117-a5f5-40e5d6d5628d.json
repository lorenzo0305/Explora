  "rdfs:comment": {
    "de": [
      "Seit 1993 niedergelassen, nachdem der Weinberg für die erste Pflanzung der AOP Condrieu 1988 und 1990 für die AOP Saint Joseph rouge (Rebsorte Syrah) angelegt wurde."
    ],
    "en": [
      "Installed since 1993 following the creation of the vineyard for the first planting of Condrieu PDO in 1988 and in 1990 for the red Saint Joseph PDO (Syrah grape variety)."
    ],
    "it": [
      "Installato dal 1993 dopo la creazione del vigneto per la prima piantagione dell'AOP Condrieu nel 1988 e nel 1990 per l'AOP Saint Joseph rosso (vitigno Syrah)."
    ],
    "fr": [
      "Installé depuis 1993 suite à la création du vignoble pour la première plantation en AOP Condrieu en 1988 et en 1990 pour l'AOP Saint Joseph rouge (Cépage Syrah)."
    ],
    "es": [
      "Instalado desde 1993 tras la creación del viñedo para la primera plantación de la AOP Condrieu en 1988 y en 1990 para la AOP Saint Joseph roja (variedad de uva Syrah)."
    ],
