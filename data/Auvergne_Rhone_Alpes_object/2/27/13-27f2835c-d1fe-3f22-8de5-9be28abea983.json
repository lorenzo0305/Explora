  "rdfs:comment": {
    "de": [
      "Italienischer Foodtruck und Caterer, der besonders für seine Holzofenpizza zum Mitnehmen bekannt ist. Je nach Anlass gibt es italienische Spezialitäten wie Focaccias, Pastas, Aperitivo-Buffets oder Alpenspezialitäten."
    ],
    "en": [
      "Italian food truck and caterer, particularly known for its wood-fired pizzas to take away. Depending on the occasion, Italian specialities are available: focaccias, pastas, aperitivo buffets and Alpine specialities."
    ],
    "it": [
      "Foodtruck e catering italiano, noto soprattutto per le sue pizze da asporto cotte a legna. A seconda dell'occasione, si può scegliere tra una gamma di specialità italiane: focacce, paste, buffet di aperitivi o specialità alpine."
    ],
    "fr": [
      "Foodtruck et traiteur italien, particulièrement connu pour ses pizzas au feu de bois à emporter. Selon les occasions, les spécialités italiennes se déclinent : focaccias, pastas, buffet d’aperitivo ou encore spécialités des Alpes."
    ],
    "nl": [
      "Italiaanse foodtruck en traiteur, vooral bekend om zijn afhaalpizza's op houtoven. Afhankelijk van de gelegenheid kun je kiezen uit een reeks Italiaanse specialiteiten, waaronder focaccia, pasta's, aperitivobuffetten en Alpenspecialiteiten."
    ],
    "es": [
      "Food truck y catering italiano, especialmente conocido por sus pizzas al horno de leña para llevar. Según la ocasión, se ofrecen diferentes especialidades italianas: focaccias, pastas, bufé de aperitivos o especialidades de los Alpes."
    ]
  },
  "rdfs:label": {
