  "rdfs:comment": {
    "de": [
      "Vif ist eine lebendige Adresse in der Altstadt von Annecy, die für alle gedacht ist, die den Augenblick bei guten Tellern, guten Weinen und einer sich im Laufe des Abends verändernden Atmosphäre genießen möchten!"
    ],
    "en": [
      "Vif is a lively address nestling in Annecy's old town, designed for those who like to savour the moment over fine food and wine and an atmosphere that changes with the evening!"
    ],
    "it": [
      "Il Vif è un indirizzo vivace nel centro storico di Annecy, pensato per chi ama assaporare il momento con cibo e vino pregiati e un'atmosfera che cambia a seconda della serata!"
    ],
    "fr": [
      "Vif, c’est l’adresse vivante nichée dans la vieille ville d’Annecy, imaginée pour celles et ceux qui aiment savourer l’instant autour de belles assiettes, de bons vins et d’une ambiance qui évolue au fil de la soirée !"
    ],
    "nl": [
      "Vif is een levendig adres genesteld in de oude stad van Annecy, ontworpen voor diegenen die willen genieten van het moment met lekker eten en wijn en een sfeer die verandert met de avond!"
    ],
    "es": [
      "Vif es un lugar animado, situado en el casco antiguo de Annecy, pensado para aquellos a quienes les gusta saborear el momento con buena comida y buen vino, y en un ambiente que cambia con la noche"
    ]
  },
