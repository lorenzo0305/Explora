  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/abe5e390-8274-341b-943e-a399e9c70cfc",
      "dc:description": {
        "de": [
          "Gartencenter, Tierhandlung, Blumen, Dekoration. 10.000 m² Fläche zum Spazierengehen für die ganze Familie.\nAngelabteilung\n\nEin Treuepunkt für Kunden, die sich dafür entscheiden, ihre Arrangements nicht zu verpacken"
        ],
        "en": [
          "Garden center, pet shop, flowers, decoration. Places for the whole family to stroll over 10,000m².\nFishing section\n\nA loyalty point is offered to customers who decide not to pack their arrangements"
        ],
        "it": [
          "Centro giardinaggio, negozio di animali, fiori, decorazioni. Oltre 10.000 m² di superficie per passeggiare con tutta la famiglia.\nSezione pesca\n\nUn punto fedeltà offerto ai clienti che decidono di non mettere in valigia le loro composizioni"
        ],
        "fr": [
          "Jardinerie, animalerie, fleurs, décoration. Lieux de promenade pour toute la famille sur 10 000m².\nRayon pêche\n\nUn point de fidélité offert aux clients qui décident de ne pas emballer leurs compositions"
        ],
        "nl": [
          "Tuincentrum, dierenwinkel, bloemen, decoratie. Plekken voor het hele gezin om te wandelen op meer dan 10.000m².\nVisafdeling\n\nEen loyaliteitspunt voor klanten die besluiten hun composities niet in te pakken"
        ],
        "es": [
          "Centro de jardinería, tienda de animales, flores, decoración. Lugares de paseo para toda la familia en más de 10.000 m².\nSección de pesca\n\nUn punto de fidelidad ofrecido a los clientes que deciden no empaquetar sus composiciones"
        ]
      },
