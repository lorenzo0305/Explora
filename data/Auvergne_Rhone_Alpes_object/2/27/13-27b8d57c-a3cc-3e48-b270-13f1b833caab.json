  "rdfs:comment": {
    "de": [
      "Wanderung über die Almen: Croisette, Perravasse, Chênex, Petit-Pommier, Chavannes."
    ],
    "en": [
      "This red cross-country ski trail takes you through the charm of the Salève mountain pastures via Croisette, Perravasse, Chênex, Petit-Pommier and Chavannes."
    ],
    "it": [
      "Questa pista rossa per lo sci di fondo vi porta attraverso il fascino degli alpeggi della Salève passando per Croisette, Perravasse, Chênex, Petit-Pommier e Chavannes."
    ],
    "fr": [
      "Cette piste rouge de ski de fond vous emmène aux travers du charme des alpages du Salève par Croisette, Perravasse, Chênex, Petit-Pommier et Chavannes."
    ],
    "es": [
      "Esta pista roja de esquí de fondo le llevará a través del encanto de los pastos de montaña de Salève, pasando por Croisette, Perravasse, Chênex, Petit-Pommier y Chavannes."
    ],
    "nl": [
      "Deze rode loipe voert u door de charme van de bergweiden van de Salève via Croisette, Perravasse, Chênex, Petit-Pommier en Chavannes."
    ]
  },
