  "rdfs:comment": {
    "de": [
      "Der Strand von Bergogne ist der Zugang von Süden zum großen See von Laffrey. Er befindet sich neben einer Wassersportbasis."
    ],
    "en": [
      "La Bergogne beach is situated at the south of Laffrey's lake, next to the nautical base."
    ],
    "it": [
      "Plage de la Bergogne è l'accesso meridionale al grande lago di Laffrey. Si trova vicino a un centro di sport acquatici."
    ],
    "fr": [
      "La plage de la Bergogne est l'accès par le Sud au grand lac de Laffrey. Elle est située à côté d'une base nautique."
    ],
    "es": [
      "Plage de la Bergogne es el acceso sur al gran Lac de Laffrey. Se encuentra junto a un centro de deportes acuáticos."
    ],
    "nl": [
      "Het strand van \"Bergogne\" is toegangkelijk langs de zuidzijde van het meer van Laffrey. Naast een kleine zeil en plezier haven.\r\nOpenbare toiletten"
