  "rdfs:comment": {
    "de": [
      "Hier befinden Sie sich auf einer wunderschönen, spielerischen und abwechslungsreichen Strecke, die auf dem wichtigsten grünen Weg der Tarentaise entlang der Isère verläuft.\r\nHalten Sie auf halber Strecke an der Freizeitanlage Les Versants d'Aime an."
    ],
    "en": [
      "A fabulous route that is fun and varied on the Tarentaise valley's main cycle path that runs alongside the river Isère.\r\nAlong the way, you can stop off at the lake at the Versants d'Aime leisure park."
    ],
    "it": [
      "Ecco un percorso magnifico, divertente e vario, lungo la principale via verde della Tarentaise, lungo il fiume Isère.\r\nA metà percorso, sosta al centro ricreativo delle piste di Aime."
    ],
    "fr": [
      "Vous voici sur un magnifique parcours, ludique et varié, cheminant sur la principale voie verte de Tarentaise, le long de l'Isère.\r\nA mi parcours, arrêtez-vous à la base de loisirs des versants d'Aime."
    ],
    "es": [
      "Se trata de un recorrido magnífico, divertido y variado, por la principal vía verde de la Tarentaise, a lo largo del río Isère.\r\nA mitad de la ruta, parada en el centro de ocio de las pistas de Aime."
    ],
    "nl": [
      "Hier volgt u een prachtige, leuke en gevarieerde route, langs de belangrijkste groene route van de Tarentaise, langs de Isère.\r\nHalverwege de route stopt u bij het recreatiecentrum Aime slopes."
    ]
  },
  "rdfs:label": {
    "de": [
      "Mountainbike-Route E : Entlang der Isère zwischen Wäldern und charaktervollen Dörfern"
    ],
    "en": [
      "E-bike circuit: Along the river Isère through forest and traditional villages"
    ],
    "fr": [
      "Circuit VTT-E : Au fil de l'Isère entre forêt et villages de caractère"
    ],
    "nl": [
      "MTB-E Circuit: Langs de Isère tussen bossen en karaktervolle dorpen"
    ]
  },
