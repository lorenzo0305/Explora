  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Pralognan-la-Vanoise befindet sich im Herzen des Dorfes. Es empfängt Sie und tut alles, um Ihnen einen gelungenen Aufenthalt zu garantieren."
    ],
    "en": [
      "Located in the village center, the Pralognan-la-Vanoise Tourist Office does everything possible to ensure that you enjoy a great stay."
    ],
    "it": [
      "Situato nel cuore del villaggio, l'Ufficio del Turismo di Pralognan-la-Vanoise vi accoglie e fa tutto il possibile per garantire il successo del vostro soggiorno."
    ],
    "fr": [
      "Situé au cœur du village, l’Office de Tourisme de Pralognan-la-Vanoise vous accueille et met tout en œuvre pour vous garantir un séjour réussi."
    ],
    "es": [
      "Situada en el corazón del pueblo, la Oficina de Turismo de Pralognan-la-Vanoise espera tu llegada y hace todo lo posible para que pases una estancia satisfactoria."
    ],
    "nl": [
      "Het VVV-kantoor van Pralognan-la-Vanoise ligt in het hart van het dorp en heet je van harte welkom en doet er alles aan om je verblijf tot een succes te maken."
    ]
  },
  "rdfs:label": {
    "en": [
