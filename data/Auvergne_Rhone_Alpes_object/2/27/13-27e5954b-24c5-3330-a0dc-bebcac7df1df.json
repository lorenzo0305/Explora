  "rdfs:comment": {
    "de": [
      "Diese Kirche im neugotischen Stil ist das Werk des Architekten John Gottret. Diesem Bauwerk ging eine Kirche aus dem 15. Jahrhundert voraus, die im Zuge der Reformation ab 1603 in ein evangelisches Gotteshaus verwandelt wurde."
    ],
    "en": [
      "This neo-Gothic church is the work of the architect John Gottret. Before this building, there had been a fifteenth century church which became a Protestant temple in 1603, during the Reformation."
    ],
    "it": [
      "Questa chiesa neogotica è stata progettata dall'architetto John Gottret. Prima di questo edificio, esisteva una chiesa del XV secolo che la Riforma trasformò in un tempio protestante nel 1603."
    ],
    "fr": [
      "Cette église de style néo-gothique est l’œuvre de l’architecte John Gottret. Avant cet édifice il existait une église du XVème siècle que la réforme avait transformé en temple protestant à partir de 1603."
    ],
    "es": [
      "Esta iglesia neogótica fue diseñada por el arquitecto John Gottret. Antes de este edificio, había una iglesia del siglo XV que la Reforma transformó en templo protestante en 1603."
    ],
    "nl": [
      "Deze neogotische kerk is het werk van de architect John Gottret. Voor dit gebouw stond er een kerk uit de 15e eeuw, die in 1603 werd omgebouwd tot een protestantse kerk."
    ]
  },
