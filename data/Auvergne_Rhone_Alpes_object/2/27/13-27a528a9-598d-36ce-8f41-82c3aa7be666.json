  "rdfs:comment": {
    "de": [
      "Genießen Sie Pizzen und gegrilltes Fleisch am Flussufer."
    ],
    "en": [
      "Just 10 km from Les Vans, you can hear the wood fire crackling, look at the menu of pizzas and grilled meats and enjoy a good time at the C4."
    ],
    "it": [
      "A soli 10 km da Les Vans, il crepitio del fuoco a legna accompagna il menu di pizze e carni alla griglia. Non resta che gustare un pasto delizioso e divertirsi al C4."
    ],
    "fr": [
      "À 10 km des Vans, le crépitement du feu de bois accompagne la lecture de la carte des pizzas et des viandes grillées. Il ne reste plus qu’à se régaler et à savourer un excellent moment au C4."
    ],
    "nl": [
      "Op slechts 10 km van Les Vans begeleidt het geknetter van het houtvuur het menu van pizza's en gegrild vlees. Je hoeft alleen nog maar te genieten van een heerlijke maaltijd en een geweldige tijd bij de C4."
    ],
    "es": [
      "A sólo 10 km de Les Vans, el crepitar del fuego de leña acompaña el menú de pizzas y carnes a la brasa. Sólo queda disfrutar de una deliciosa comida y de un rato agradable en el C4."
    ]
  },
