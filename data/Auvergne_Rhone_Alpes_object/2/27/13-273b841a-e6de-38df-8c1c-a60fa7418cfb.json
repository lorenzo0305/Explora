  "rdfs:comment": {
    "de": [
      "Am Fuße des letzten schlafenden Vulkans der Vivarais. Die Wanderwege sind das ganze Jahr über geöffnet, um den Vulkan, den Libellenteich und das lokale Erbe zu besuchen. Das Park Center heißt Besucher im Sommer willkommen."
    ],
    "en": [
      "At the foot of the Vivarais' last dormant volcano. Footpaths open all year to visit the volcano, dragonfly pond and local heritage. The Park Centre welcomes visitors in summer."
    ],
    "it": [
      "Ai piedi dell'ultimo vulcano spento del Vivarais. I sentieri escursionistici sono aperti tutto l'anno per scoprire il vulcano, lo stagno delle libellule e il patrimonio locale. In estate, è possibile visitare la Maison du Parc."
    ],
    "fr": [
      "Au pied du dernier volcan éteint du Vivarais. Des sentiers de balades sont ouverts toute l'année pour découvrir le volcan, la mare aux libellules et le petit patrimoine. Au sein de ce domaine, vous serez accueillis à la Maison du Parc en saison estivale."
    ],
    "es": [
      "Al pie del último volcán extinguido del Vivarais. Las rutas de senderismo están abiertas todo el año para descubrir el volcán, el estanque de las libélulas y el patrimonio local. En verano, puede visitar la Maison du Parc."
    ],
    "nl": [
      "Aan de voet van de laatste uitgedoofde vulkaan in de Vivarais. Het hele jaar door zijn er wandelpaden om de vulkaan, de libellenvijver en het plaatselijke erfgoed te ontdekken. In de zomer kun je het Maison du Parc bezoeken."
    ]
  },
