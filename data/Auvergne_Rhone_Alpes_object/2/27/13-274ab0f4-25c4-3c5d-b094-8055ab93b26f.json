  "rdfs:comment": {
    "de": [
      "Im Freien können Sie das Gartencafé des Centre d'Art Contemporain de Lacoux nutzen. Hier finden Sie lokale Getränke wie Kräutertee, Sirup und Bier (und Kaffee)."
    ],
    "en": [
      "Outside, enjoy the garden-cafe of the Contemporary Art Center of Lacoux. You will find local herbal teas, syrups and beers (and coffee)."
    ],
    "it": [
      "All'esterno, godetevi il caffè-giardino del Centre d'Art Contemporain de Lacoux. Troverete bevande locali come tisane, sciroppi e birra (e caffè)."
    ],
    "fr": [
      "En extérieur, profitez du jardin-café du Centre d'Art Contemporain de Lacoux. Vous y trouverez des boissons locales tisanes, sirop et bières (et café)."
    ],
    "nl": [
      "Geniet buiten van het tuincafé van het Centre d'Art Contemporain de Lacoux. U vindt er lokale dranken zoals kruidenthee, siroop en bier (en koffie)."
    ],
    "es": [
      "En el exterior, disfrute de la cafetería-jardín del Centre d'Art Contemporain de Lacoux. Encontrarás bebidas locales como infusiones, sirope y cerveza (y café)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar associatif - Le jardin café"
    ]
  },
