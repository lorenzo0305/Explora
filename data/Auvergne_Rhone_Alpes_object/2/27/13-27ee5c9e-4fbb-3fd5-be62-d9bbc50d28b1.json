  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Velanne. Wir können Sie für die Dauer eines Picknicks oder einer Etappe im Biwak empfangen.\r\nPicknicktisch, Anbindestange für Pferde, Unterstand und Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné de Velanne. We can accommodate you for a picnic or a bivouac.\r\nPicnic tables, horse tie-downs, shelter and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné a Velanne. Possiamo ospitarvi per un picnic o un bivacco.\r\nAbbiamo un tavolo da picnic, una barra per i cavalli, un riparo e un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Velanne. Nous pouvons vous accueillir le temps d'un pique nique ou d'une étape en bivouac. \r\nTable de pique-nique, barre d'attache pour chevaux, abri et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné in Velanne. Je kunt bij ons terecht voor een picknick of een bivak.\r\nWe hebben een picknicktafel, een tui voor paarden, een schuilhut en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné en Velanne. Podemos acogerle para un picnic o un vivac.\r\nTenemos una mesa de picnic, una barra de sujeción para caballos, un refugio y un aparcamiento."
    ]
  },
