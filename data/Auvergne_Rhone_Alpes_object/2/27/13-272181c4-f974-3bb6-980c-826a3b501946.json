  "rdfs:comment": {
    "de": [
      "Sehr gutes Restaurant zwischen Terrasse und Schwimmbad in schönem Ambiente."
    ],
    "en": [
      "Quality restaurant in a nice setting between the terrace and the pool"
    ],
    "it": [
      "Ristorante di qualità in un ambiente accogliente tra la terrazza e la piscina. Piatti alla carta. Menù giornaliero a pranzo, tranne nei giorni festivi e nei fine settimana. Cucina semi-gastronomica di qualità. Disponibilità di pizze."
    ],
    "fr": [
      "Restaurant de qualité dans un cadre sympathique entre la terrasse et la piscine. Plats à la carte. Menu du jour à midi sauf jours fériés et week-end. Cuisine de qualité, semi gastronomique. Pizzas."
    ],
    "es": [
      "Restaurante de calidad en un entorno agradable entre la terraza y la piscina. Platos a la carta. Menú diario al mediodía, excepto festivos y fines de semana. Cocina semigastronómica de calidad. Pizzas disponibles."
    ],
    "nl": [
      "Kwaliteitsrestaurant in een vriendelijke omgeving tussen het terras en het zwembad. A la carte gerechten. Dagelijks menu tijdens lunchtijd, behalve op feestdagen en in het weekend. Semi-gastronomische kwaliteitskeuken. Pizza's beschikbaar."
    ]
  },
