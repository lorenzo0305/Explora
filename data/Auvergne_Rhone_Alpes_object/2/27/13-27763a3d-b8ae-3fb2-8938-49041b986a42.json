  "rdfs:comment": {
    "de": [
      "Dekorationsarbeiten an: Sofas und Sesseln, Wandbehängen, Kissen, Bettgestellen, Matratzen. Anfertigung und Neuanfertigung von: Sitzmöbeln aller Stilrichtungen, Lattenrosten, Matratzen, Vorhängen, Wandbehängen, Posen, Stangen. Lederarbeiten - Zuschneiden von Schaumstoff."
    ],
    "en": [
      "Decorative work on: sofas and armchairs, wall hangings, cushions, bed bases, mattresses. Manufacture and repair: all styles of seating, bed bases, mattresses, curtains, wall hangings, fixtures, rods. Leather work - Cutting foam."
    ],
    "it": [
      "Lavori di decorazione su: divani e poltrone, tappezzerie, cuscini, reti, materassi. Fabbricazione e riparazione di: sedili di tutti i tipi, reti, materassi, tende, tende da parati, appendiabiti, aste. Lavorazione del cuoio - Taglio della schiuma."
    ],
    "fr": [
      "Travaux de décoration sur : canapés et fauteuils, tentures murales, coussins, sommiers, matelas. Confection et réfection : sièges tous style, sommiers, matelas, rideaux, tentures murales, poses, tringles. Travaux sur cuir -Mousse à la découpe."
    ],
    "es": [
      "Trabajos de decoración en: sofás y sillones, tapices, cojines, somieres, colchones. Fabricación y reparación de: todos los estilos de asientos, somieres, colchones, cortinas, colgantes, barras. Trabajo en cuero - Corte de espuma."
    ],
    "nl": [
      "Decoratiewerkzaamheden aan: banken en fauteuils, wandbekleding, kussens, onderstellen, matrassen. Fabricage en reparatie: alle stijlen zitmeubelen, onderstellen, matrassen, gordijnen, wandkleden, bevestigingen, roedes. Werken op leer - Snijden van schuim."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tapissier Garnisseur"
    ]
  },
