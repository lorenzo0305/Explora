  "rdfs:comment": {
    "de": [
      "Küche, Berge und Lebenskunst.\r\nIn einer bergigen Umgebung und in einem gemütlichen Ambiente bietet Ihnen La Porte d'à Côté eine Küche mit frischen Produkten, Fleisch von verschiedenen Rassen, lokalen Käsesorten und Wurstwaren."
    ],
    "en": [
      "Cuisine, mountains and art of living.\r\nIn a mountain setting and in a warm atmosphere, La Porte d'A Côté offers you a cuisine based on fresh products, meat from local breeds, cheese and charcuterie."
    ],
    "it": [
      "Cucina, montagna e arte di vivere.\r\nIn una cornice di montagna e in un'atmosfera calorosa, La Porte d'A Côté vi propone una cucina basata su prodotti freschi, carni di razze locali, formaggi e salumi."
    ],
    "fr": [
      "Cuisine, montagne et art de vivre.\r\nDans un cadre montagnard et dans une ambiance chaleureuse La Porte d'à Côté vous propose une cuisine à base de produits frais, de viande de races, de fromages et charcuteries locaux."
    ],
    "nl": [
      "Keuken, bergen en levenskunst.\r\nLa Porte d'à Côté biedt een warm en gastvrij kader in de bergen, met een keuken gebaseerd op verse producten, vlees van eigen bodem en lokale kazen en vleeswaren."
    ],
    "es": [
      "Cocina, montaña y arte de vivir.\r\nLa Porte d'à Côté ofrece un entorno de montaña cálido y acogedor, con una cocina basada en productos frescos, carnes de raza y quesos y embutidos locales."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant La Porte d'A Côté"
    ],
    "it": [
      "Ristorante La Porte d'A Côté"
    ],
    "fr": [
      "Restaurant La Porte d'à Côté."
    ]
  },
