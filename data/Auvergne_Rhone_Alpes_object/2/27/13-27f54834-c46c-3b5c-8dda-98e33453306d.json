  "rdfs:comment": {
    "de": [
      "Das 1789 ist bekannt für seine am Kamin gegrillten Fleischgerichte und seine savoyischen Spezialitäten.\r\nDas Ambiente und die Küche sind großzügig, genau wie die Chefs!"
    ],
    "en": [
      "The 1789 is renowned for its grilled meats cooked in the fireplace and its Savoyard specialties. \r\nThe atmosphere and the cuisine are generous, just like the owner!"
    ],
    "it": [
      "Il 1789 è famoso per le sue carni alla griglia cotte nel camino e per le sue specialità savoiarde. \r\nL'atmosfera e la cucina sono generose, proprio come il proprietario!"
    ],
    "fr": [
      "Le 1789 est réputé pour ses grillades cuites à la cheminée et ses spécialités savoyardes. \r\nL’ambiance et la cuisine sont généreuses, à l’image des patrons !"
    ],
    "nl": [
      "Le 1789 staat bekend om zijn barbecues boven open vuur en Savoyaardse specialiteiten.\r\nDe sfeer en de keuken zijn royaal, net als de eigenaren!"
    ],
    "es": [
      "Le 1789 es famoso por sus barbacoas a la brasa y sus especialidades saboyanas.\r\nEl ambiente y la cocina son generosos, ¡como sus dueños!"
    ]
  },
