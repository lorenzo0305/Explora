  "rdfs:comment": {
    "de": [
      "Ean-Paul empfängt Sie in seinem Restaurant mit einer abwechslungsreichen Speisekarte, die aus hausgemachten Gerichten besteht, die der traditionellen Küche entsprechen und in einer herzlichen und freundlichen Atmosphäre serviert werden."
    ],
    "en": [
      "Ean-Paul welcomes you to his restaurant with a varied menu featuring home-cooked dishes in a warm, friendly atmosphere."
    ],
    "it": [
      "Ean-Paul vi dà il benvenuto nel suo ristorante, dove potrete gustare un variegato menu di piatti fatti in casa in un'atmosfera calda e accogliente."
    ],
    "fr": [
      "Ean-Paul vous accueille dans son restaurant à la carte variée, composée de plats faits maison dans le respect de la cuisine traditionnelle le tout dans une ambiance chaleureuse et conviviale."
    ],
    "es": [
      "Ean-Paul le da la bienvenida a su restaurante, donde podrá disfrutar de una variada carta de platos caseros en un ambiente cálido y acogedor."
    ],
    "nl": [
      "Ean-Paul heet je welkom in zijn restaurant, waar je kunt genieten van een gevarieerd menu met huisgemaakte gerechten in een warme en vriendelijke sfeer."
    ]
  },
