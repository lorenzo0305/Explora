  "rdfs:comment": {
    "de": [
      "Dieses Theater im italienischen Stil ist ein unumgänglicher Kulturort und bietet das ganze Jahr über Aufführungen, Konzerte, Konferenzen, literarische Treffen, Workshops, Ausstellungen? Seien Sie neugierig!"
    ],
    "en": [
      "An emblematic and essential cultural venue, this Italian-style theater offers shows, concerts, conferences, literary events, workshops, exhibitions? all year round Get curious!"
    ],
    "it": [
      "Luogo culturale emblematico da non perdere, questo teatro all'italiana propone tutto l'anno spettacoli, concerti, conferenze, eventi letterari, laboratori, mostre e altro ancora Siate curiosi!"
    ],
    "fr": [
      "Lieu culturel emblématique et incontournable, ce théâtre à l’italienne propose toute l’année : spectacles, concerts, conférences, rendez-vous littéraires, ateliers, expositions… Soyez curieux !"
    ],
    "es": [
      "Emblemático espacio cultural que no debe perderse, este teatro a la italiana ofrece espectáculos, conciertos, conferencias, eventos literarios, talleres, exposiciones y mucho más durante todo el año ¡Sienta curiosidad!"
    ],
    "nl": [
      "Een emblematische culturele locatie die je niet mag missen. In dit theater in Italiaanse stijl worden het hele jaar door shows, concerten, lezingen, literaire evenementen, workshops, tentoonstellingen en nog veel meer georganiseerd Word nieuwsgierig!"
    ]
  },
