  "rdfs:comment": {
    "de": [
      "Necken Sie Bachforellen und Regenbogenforellen im oberen Teil des Arc! An den Ufern dieses wunderschönen Flusses können Sie die Ruhe dieses Ortes genießen: Sie werden angesichts der majestätischen Berge der Haute Maurienne sicherlich einen anderen Eindruck bekommen."
    ],
    "en": [
      "Catch fario trout and rainbow trout on the upstream section of the Arc! On the banks of this magnificent river, enjoy the peacefulness of the setting: you're sure to get a change of scenery from the majestic Haute Maurienne mountains."
    ],
    "it": [
      "Stuzzicate le trote fario e le iridee nella parte superiore dell'arco! Sulle rive di questo magnifico fiume, godetevi la pace e la tranquillità di questo luogo: sarete sicuramente disorientati dalle maestose montagne della Haute Maurienne."
    ],
    "fr": [
      "Taquinez la truite fario et l'arc-en-ciel sur la partie amont de l'Arc ! Sur les abords de cette magnifique rivière, profitez de la quiétude de ce lieu : vous serez certainement dépaysé face aux majestueuses montagnes de Haute Maurienne."
    ],
    "es": [
      "¡Provoca a la trucha fario y a la arco iris en la parte superior del Arco! A orillas de este magnífico río, disfrute de la tranquilidad de este lugar: sin duda le desorientarán las majestuosas montañas de Haute Maurienne."
    ],
    "nl": [
      "Vang fario forel en regenbogen op het stroomopwaartse deel van de Arc! Aan de oevers van deze prachtige rivier kun je genieten van de rust en stilte van de omgeving: de majestueuze bergen van de Haute Maurienne zullen je zeker in vervoering brengen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Upstream Arc"
    ],
    "fr": [
      "L'Arc amont"
    ],
    "nl": [
      "Boog stroomopwaarts"
    ]
  },
