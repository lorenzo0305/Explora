  "rdfs:comment": {
    "de": [
      "Vom Place Saint Léger aus bringt Sie der kleine Zug dazu, den diskreten und bezaubernden Charme der alten Stadt zu entdecken, die ein einzigartiges architektonisches und mittelalterliches Erbe bewahrt hat."
    ],
    "en": [
      "The little train leaves from Place Saint Léger and takes you on a trip to discover the discreet and bewitching charm of the old town, where a unique architectural and medieval heritage has been preserved intact."
    ],
    "it": [
      "Il trenino parte da Place Saint Léger e vi porta alla scoperta del fascino discreto e ammaliante della città vecchia, dove si è conservato intatto un patrimonio architettonico e medievale unico."
    ],
    "fr": [
      "Au départ de la place Saint Léger, le petit train vous emmènera découvrir le charme discret et envoûtant de la ville ancienne qui a gardé un patrimoine architectural et médiéval unique."
    ],
    "es": [
      "Partiendo de la plaza Saint Léger, el trenecito le llevará a descubrir el discreto y hechizante encanto del casco antiguo, que conserva un patrimonio arquitectónico y medieval único."
    ],
    "nl": [
      "Het treintje vertrekt vanaf de Place Saint Léger en neemt u mee op ontdekkingstocht naar de discrete en betoverende charme van de oude stad, waar een uniek architecturaal en middeleeuws erfgoed intact is gebleven."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chambéry trackless train"
    ],
    "it": [
      "Il trenino di Chambéry"
    ],
    "fr": [
      "Le petit train de Chambéry"
    ],
    "nl": [
      "Het wegtreintje van Chambéry"
    ]
  },
