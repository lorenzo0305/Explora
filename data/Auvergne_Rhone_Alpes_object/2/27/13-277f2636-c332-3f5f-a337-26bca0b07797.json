  "rdfs:comment": {
    "de": [
      "Der Strand von Messery ist der ideale Ort, um zu baden und eine schöne Zeit mit der Familie zu verbringen."
    ],
    "en": [
      "Sun-drenched and fully grassed over, this beach on the shores of Petit Lac is perfect for sunbathing. Don your sarong and flipflops and meet at the rental point (stand-up paddle, kayaks and pedalos) to get going many quiet hours also lie on the horizon"
    ],
    "it": [
      "La spiaggia di Messery è il luogo ideale per nuotare e trascorrere momenti di qualità con la famiglia."
    ],
    "fr": [
      "La plage de Messery est l'endroit idéal pour se baigner et passer un bon moment en famille."
    ],
    "es": [
      "La playa de Messery es el lugar ideal para nadar y pasar un rato agradable en familia."
    ],
    "nl": [
      "Het strand van Messery is de ideale plek om te zwemmen en wat tijd door te brengen met het gezin."
    ]
