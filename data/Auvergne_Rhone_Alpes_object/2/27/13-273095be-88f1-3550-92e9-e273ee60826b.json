  "rdfs:comment": {
    "de": [
      "Zwischen Mollans-sur-Ouvèze und Buis-les-Baronnies erhebt sich im Tal der Ouvèze der unverkennbare Felsvorsprung von Pierrelongue. Das Dorf liegt an der Departementale 5 und ist an dem 25 m hohen Felsen zu erkennen, dem es seinen Namen verdankt."
    ],
    "en": [
      "Between Mollans-sur-Ouvèze and Buis-les-Baronnies, in the Ouvèze valley, stands the rocky peak of Pierrelongue. The village is located on departmental road 5, and is recognizable by the 25m-high rock from which it takes its name."
    ],
    "it": [
      "Tra Mollans-sur-Ouvèze e Buis-les-Baronnies, il picco roccioso di Pierrelongue si erge nella valle dell'Ouvèze. Il villaggio si trova sulla strada dipartimentale 5 ed è riconoscibile per la roccia alta 25 metri, a cui deve il suo nome."
    ],
    "fr": [
      "Entre Mollans-sur-Ouvèze et Buis-les-Baronnies, s‘élève dans la vallée de l’Ouvèze l’incontournable piton rocheux de Pierrelongue. Le village se situe sur la départementale 5 et il est reconnaissable à cette roche haute de 25m, à laquelle il doit son nom."
    ],
    "nl": [
      "Tussen Mollans-sur-Ouvèze en Buis-les-Baronnies, in de Ouvèze vallei, staat de rotsachtige top van Pierrelongue. Het dorp ligt aan de departementale weg 5 en is te herkennen aan de 25 meter hoge rots waaraan het zijn naam ontleent."
    ],
    "es": [
      "Entre Mollans-sur-Ouvèze y Buis-les-Baronnies, el pico rocoso de Pierrelongue se alza en el valle de Ouvèze. El pueblo está situado en la carretera departamental 5 y es reconocible por esta roca de 25 m de altura, a la que debe su nombre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pierrelongue"
    ]
  },
