  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a39ace1c-7e2f-3d00-9853-da11a3f5f2e1",
      "dc:description": {
        "de": [
          "Wallace ist verliebt, sowohl in Rasiert (Shaun das Schaf hat seinen ersten Auftritt) als auch in Ein ganz schöner Schlamassel (noch nie im Kino gesehen), und sein Enthusiasmus wird das Duo in wilde Abenteuer stürzen, die an einen Krimi erinnern!"
        ],
        "en": [
          "Wallace is in love, both in Clean Shaven (the first appearance of Shaun the Sheep) and in A Hell of a Mess (never seen in theaters), and his enthusiasm is going to send the duo into crazy adventures with a whodunit feel!"
        ],
        "it": [
          "Wallace è innamorato, sia in Clean Shaven (la prima apparizione di Shaun the Sheep) che in Un sacré pétrin (mai visto prima al cinema), e il suo entusiasmo spingerà il duo in un'avventura selvaggia con un tocco di mistero!"
        ],
        "fr": [
          "Wallace est amoureux, dans Rasé de près (première apparition de Shaun le mouton) comme dans Un sacré pétrin (inédit au cinéma) et son enthousiasme va précipiter le duo dans de folles aventures aux allures de polar !"
        ],
        "nl": [
          "Wallace is verliefd, zowel in Clean Shaven (Shaun het Schaap's eerste verschijning) als in Un sacré pétrin (nog nooit eerder in de bioscoop gezien), en zijn enthousiasme zal het duo op een wild avontuur sturen met een whodunit gevoel!"
        ],
        "es": [
          "Wallace está enamorado, tanto en Clean Shaven (la primera aparición de la oveja Shaun) como en Un sacré pétrin (nunca antes visto en el cine), y su entusiasmo va a lanzar al dúo a una salvaje aventura con tintes de ¡whodunit!"
        ]
      },
      "@type": [
        "Description"
      ],
