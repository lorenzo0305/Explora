  "rdfs:comment": {
    "de": [
      "Zoomo bietet Ihnen Fahrräder, die Sie für einen Tag oder eine Woche mieten können. Die Fahrräder sind zugänglich, sehr komfortabel und verfügen über eine Reichweite von 8 Stunden oder 80 Kilometern, um die Stadt Lyon zu erkunden."
    ],
    "en": [
      "Zoomo offers bikes for hire by the day or by the week. The bikes are affordable, very comfortable and have a range of 8 hours or 80 kilometres to explore the city of Lyon."
    ],
    "it": [
      "Zoomo offre biciclette a noleggio a giornata o a settimana. Le biciclette sono economiche, molto confortevoli e hanno un'autonomia di 8 ore o 80 chilometri per esplorare la città di Lione."
    ],
    "fr": [
      "Zoomo vous propose des vélos en location à la journée ou à la semaine. Les vélos sont accessibles, très confortables et disposent d'une autonomie de 8 heures ou 80 kilomètres pour explorer la ville de Lyon."
    ],
    "nl": [
      "Zoomo verhuurt fietsen per dag of per week. De fietsen zijn betaalbaar, zeer comfortabel en hebben een actieradius van 8 uur of 80 kilometer om de stad Lyon te verkennen."
    ],
    "es": [
      "Zoomo ofrece bicicletas de alquiler por días o semanas. Las bicicletas son asequibles, muy cómodas y tienen una autonomía de 8 horas u 80 kilómetros para explorar la ciudad de Lyon."
    ]
  },
