  "rdfs:comment": {
    "de": [
      "Der Park Valérien Perrin bietet mehrere verschiedene Stimmungen. Ein sehr schöner Park, wenn Sie einen ruhigen Ort mitten in der Stadt suchen, um eine Pause zu machen oder einfach nur den hohlen Garten und die Staudenbeete zu bewundern."
    ],
    "en": [
      "The Valérien Perrin park offers several different atmospheres. A beautiful park if you're looking for a quiet spot in the middle of town to take a break or simply admire the sunken garden and its perennial flowerbeds."
    ],
    "it": [
      "Il parco Valérien Perrin offre diverse atmosfere. È un bellissimo parco se cercate un posto tranquillo in mezzo alla città per fare una pausa o semplicemente per ammirare il giardino sommerso e le sue aiuole perenni."
    ],
    "fr": [
      "Le parc Valérien Perrin offre plusieurs ambiances différentes. Très beau parc si vous cherchez un endroit calme en pleine ville pour faire une pause ou simplement admirer le jardin creux et ces plates bandes de vivaces."
    ],
    "nl": [
      "Het park Valérien Perrin biedt verschillende sferen. Het is een prachtig park als u op zoek bent naar een rustige plek midden in de stad om even uit te rusten of gewoon om de verzonken tuin en de vaste planten te bewonderen."
    ],
    "es": [
      "El parque Valérien Perrin ofrece varios ambientes diferentes. Un parque precioso si busca un lugar tranquilo en medio de la ciudad para hacer una pausa o simplemente admirar el jardín hundido y sus parterres de flores perennes."
    ]
  },
