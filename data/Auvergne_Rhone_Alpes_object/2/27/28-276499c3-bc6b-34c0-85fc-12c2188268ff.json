  "rdfs:comment": {
    "de": [
      "Das Golfrestaurant liegt im Bois des Forts in Coudekerque-Village und nur wenige Schritte von den Festungsanlagen von Bergues entfernt. Es bietet Ihnen regionale Spezialitäten in Bistro-Atmosphäre mit einem herrlichen Blick auf den 27-Loch-Golfplatz."
    ],
    "en": [
      "Located in the Bois des Forts in Coudekerque-Village and close to the fortifications of Bergues, the golf restaurant offers regional specialties in a bistro atmosphere with a breathtaking view of the 27-hole golf course."
    ],
    "it": [
      "Situato nel Bois des Forts a Coudekerque-Village e a pochi passi dalle fortificazioni di Bergues, il ristorante del golf offre specialità regionali in un'atmosfera da bistrot con una vista mozzafiato sul campo da golf a 27 buche."
    ],
    "fr": [
      "Situé dans le Bois des Forts à Coudekerque-Village et à deux pas des fortifications de Bergues, le restaurant du golf vous propose des spécialités régionales dans une ambiance bistrot avec une vue imprenable sur le golf de 27 trous."
    ],
    "es": [
      "Situado en el Bois des Forts en Coudekerque-Village y a dos pasos de las fortificaciones de Bergues, el restaurante del golf ofrece especialidades regionales en un ambiente de bistró con una vista impresionante sobre el campo de golf de 27 hoyos."
    ],
    "nl": [
      "Gelegen in het Bois des Forts in Coudekerque-Village en op een steenworp afstand van de vestingwerken van Bergues, biedt het golfrestaurant regionale specialiteiten in een bistrosfeer met een adembenemend uitzicht op de 27-holes golfbaan."
    ]
  },
