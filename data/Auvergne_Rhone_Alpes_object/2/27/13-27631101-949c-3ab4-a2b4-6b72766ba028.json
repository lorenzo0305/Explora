  "rdfs:comment": {
    "de": [
      "Das Sugny-Kreuz stammt aus dem Jahr 1625. Es ist als historisches Monument klassifiziert und trägt das Wappen der Familie Sugny. Neben dem Sockel befindet sich eine Viehtränke, die mit Wasser versorgt wird\r\nsie wurde von einer Quelle aus dem oberen Teil des Dorfes mit Wasser versorgt."
    ],
    "en": [
      "The Sugny Cross dates from 1625. Listed as a Historic Monument, it bears the Sugny family coat of arms. A cattle trough adjoins its base, supplied with water\r\nwater from a spring at the top of the village."
    ],
    "it": [
      "La croce di Sugny risale al 1625. Iscritta nell'elenco dei monumenti storici, reca lo stemma della famiglia Sugny. Alla sua base è annesso un abbeveratoio per il bestiame, alimentato con acqua\r\nda una sorgente in cima al villaggio."
    ],
    "fr": [
      "La Croix de Sugny date de 1625. Classée Monument Historique, elle porte les armes de la famille Sugny. Un abreuvoir à bestiaux jouxte son socle, alimenté en\r\neau par une source venant du haut du village."
    ],
    "es": [
      "La Cruz de Sugny data de 1625. Declarada Monumento Histórico, lleva las armas de la familia Sugny. Junto a su base hay un abrevadero para el ganado, abastecido con agua\r\nagua de un manantial situado en la parte alta del pueblo."
    ],
    "nl": [
      "Het Sugny-kruis dateert uit 1625. Het staat op de lijst van historische monumenten en draagt het wapen van de familie Sugny. Aan de voet ervan staat een trog voor vee, die van water wordt voorzien\r\nwater uit een bron boven in het dorp."
    ]
  },
