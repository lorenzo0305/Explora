  "rdfs:comment": {
    "de": [
      "Raum für Verkostungen, Einzel- und Großhandel mit einer großen Auswahl an Kaffeebohnen, Tees und Kräutertees. Im Laden oder auf einer schattigen Terrasse: Genießen Sie diesen angenehmen Zwischenstopp."
    ],
    "en": [
      "Tasting area, retail and wholsale of a large range of grain coffees, teas, infusions. Delicatessen (local products, artisanal specialties…). In the shop, on the shady terrace: enjoy this moment."
    ],
    "it": [
      "Un luogo di degustazione, vendita al dettaglio e all'ingrosso di un'ampia selezione di caffè in grani, tè e infusi. Nel negozio, sulla terrazza ombreggiata: godetevi questa piacevole sosta."
    ],
    "fr": [
      "Espace de dégustation, de vente au détail et en gros d'une large sélection de cafés en grains, de thés, d'infusions. En boutique, en terrasse ombragée : profitez de cette agréable escale."
    ],
    "es": [
      "Un lugar de degustación, venta al por menor y al por mayor de una amplia selección de café en grano, tés e infusiones. En la tienda, en la terraza a la sombra: disfrute de esta agradable parada."
    ],
    "nl": [
      "Een plek om te proeven, te verkopen en groothandel te drijven in een breed assortiment koffiebonen, thee en infusies. In de winkel, op het schaduwrijke terras: geniet van deze aangename tussenstop."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tkfé - Mille saveurs"
    ],
    "fr": [
      "Tkfé - Mille saveurs"
    ]
  },
