  "rdfs:comment": {
    "de": [
      "Kommen Sie und lernen über die Welt der Trüffel auf der Domaine Cordis Grignan in der Drôme\r\nVerkauf von frischen Trüffeln und Trüffeleichen Reservierung."
    ],
    "en": [
      "Guided tour of the property. Activities to know all about truffles.\r\nTasting, sales of fresh truffles and oak tree truffles."
    ],
    "it": [
      "Venite a conoscere il mondo del tartufo al Domaine de Cordis a Grignan, nella Drôme Provençale. Vendita di tartufi freschi e querce da tartufo su prenotazione."
    ],
    "fr": [
      "Venez vous initier au monde de la truffe au Domaine de Cordis à Grignan en Drôme provençale Vente de truffes fraîches et de chênes truffiers sur réservation."
    ],
    "es": [
      "Venga a conocer el mundo de la trufa en el Domaine de Cordis, en Grignan, en la Drôme provenzal. Venta de trufas frescas y robles trufados bajo reserva."
    ],
    "nl": [
      "Introductie van de truffelcultuur, bezoek aan het domein, kelder, proeverij...\r\nVerkoop verse truffel en truffeleiken."
    ]
  },
