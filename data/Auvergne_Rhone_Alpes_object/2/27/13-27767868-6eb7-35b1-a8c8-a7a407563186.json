  "rdfs:comment": {
    "de": [
      "Seit 1982 ist dies ein Klassiker in Courchevel! Geselliger Lauf mit Zeitmessung: Start am Col de Chanrossa bis zur Schneefront von Courchevel Moriond, d.h. 800 Meter Höhenunterschied!"
    ],
    "en": [
      "A Courchevel classic since 1982! A friendly timed race: from the Col de Chanrossa to the Courchevel Moriond snow front, 800 metres of ascent and descent!"
    ],
    "it": [
      "È un classico di Courchevel dal 1982! Una gara amichevole con percorso cronometrato: partenza dal Col de Chanrossa e arrivo sul fronte di neve di Courchevel Moriond, con un'ascesa di 800 metri!"
    ],
    "fr": [
      "C’est un grand classique de Courchevel depuis 1982 ! Course conviviale chronométrée: départ au Col de Chanrossa jusqu'au front de neige de Courchevel Moriond soit 800 mètres de dénivelé!"
    ],
    "es": [
      "Un clásico de Courchevel desde 1982 Una carrera amistosa con un recorrido cronometrado: salida en el Col de Chanrossa y llegada en el frente de nieve de Courchevel Moriond, ¡con una subida de 800 metros!"
    ],
    "nl": [
      "Het is al sinds 1982 een klassieker in Courchevel! Een vriendschappelijke race met een getimede run: start op de Col de Chanrossa en finish op het sneeuwfront van Courchevel Moriond, met een klim van 800 meter!"
    ]
  },
  "rdfs:label": {
