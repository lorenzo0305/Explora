  "rdfs:comment": {
    "de": [
      "Das Hotel L'Eden des Cimes*** befindet sich im Herzen des Skigebiets Paradiski. In einem Rahmen mit savoyischem Charme und einer Cocooning-Atmosphäre können Sie Ihren Körper nach einem anstrengenden Tag auf der Piste erholen und gleichzeitig Ihre Abende genießen!"
    ],
    "en": [
      "The Hotel Eden des Cimes*** is located in the heart of the Paradiski area. In a charming and cosy Savoyard setting, you will be able to really relax after a great day on the slopes, before enjoying a fun evening!"
    ],
    "it": [
      "L'hotel Eden des Cimes*** si trova nel cuore del comprensorio Paradiski. In un ambiente dal fascino savoiardo e dall'atmosfera avvolgente, potrete rilassare il vostro corpo dopo una bella giornata sulle piste e godervi le vostre serate!"
    ],
    "fr": [
      "L’hôtel L'Eden des Cimes*** est situé au cœur du domaine Paradiski. Dans un cadre aux charmes savoyards et à l'ambiance cocooning, vous pourrez reposer votre corps après une bonne journée sur les pistes tout en profitant de vos soirées !"
    ],
    "nl": [
      "Hotel Eden des Cimes*** ligt midden in het skigebied Paradiski. In een typische stijl van de Savoie en een knusse sfeer profiteert u hier van rust na een heerlijke dag op de pistes!"
    ],
    "es": [
      "El hotel Eden des Cimes*** está situado en el corazón de la zona de Paradiski. ¡En un marco con encanto saboyano y un ambiente envolvente, podrá relajar su cuerpo después de un buen día en las pistas mientras disfruta de sus veladas!"
    ]
  },
  "rdfs:label": {
