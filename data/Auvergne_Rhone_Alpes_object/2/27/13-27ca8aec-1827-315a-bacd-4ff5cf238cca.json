  "rdfs:comment": {
    "de": [
      "Zwischen See und Wald erwarten 2 diplomierte Reitlehrer Anfänger und Fortgeschrittene für Reitunterricht, Ausritte und Reitwanderungen. Ponyreiten für die Kleinen, geführte Spazierritte, Kurse für Kinder/Jugendliche/Erwachsene, im Freien oder in der Halle."
    ],
    "en": [
      "Set between a lake and forests, there are two qualified instructors for beginners and confirmed riders. Horse-back rides on the lead, ponies for the very young. Children, teenagers and adults riding lessons, indoor and oudoor. Rides and treks."
    ],
    "it": [
      "Pony trekking ed equitazione per tutti i livelli. Offriamo anche lezioni, corsi e passeggiate."
    ],
    "fr": [
      "Randonnées et promenades à poney ou à cheval, tous niveaux. Nous vous proposons également des cours, des stages, des randonnées itinérantes."
    ],
    "nl": [
      "Ponyrijden en paardrijden voor alle niveaus. We bieden ook lessen, cursussen en buitenritten."
    ],
    "es": [
      "Paseos en poni y a caballo para todos los niveles. También ofrecemos clases, cursos y paseos por senderos."
    ]
  },
