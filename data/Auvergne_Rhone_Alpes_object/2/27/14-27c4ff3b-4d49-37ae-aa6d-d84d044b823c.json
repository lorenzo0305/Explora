  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f1b96e18-901a-3f42-854f-bdc289f744e3",
      "dc:description": {
        "de": [
          "Nachdem du den Weg von Jean-Marie, dem kleinen Bergmann aus 9-9bis, von seiner Bergbausiedlung bis zu seinem Abstieg in den Schacht verfolgt hast, nimm an der Erstellung eines Ziehharmonika-Buches teil, das die Geschichte dieses kleinen Bergmanns in Bildern nachzeichnet."
        ],
        "en": [
          "After following the story of Jean-Marie, the little miner from 9-9bis, from his mining town to his descent into the mineshaft, take part in the creation of an accordion book that tells the story of this little miner in pictures."
        ],
        "it": [
          "Dopo aver seguito la storia di Jean-Marie, il piccolo minatore di 9-9bis, dalla sua città mineraria alla sua discesa nel pozzo, partecipate alla creazione di un libro a fisarmonica che racconta per immagini la storia di questo piccolo minatore."
        ],
        "fr": [
          "Après avoir suivi le parcours de Jean-Marie le petit mineur du 9-9bis, depuis sa cité minière jusqu’à sa descente dans le puits, participe à la création d’un livre accordéon qui retrace l’histoire de ce petit mineur en image."
        ],
        "nl": [
          "Volg het verhaal van Jean-Marie, de kleine mijnwerker uit 9-9bis, van zijn mijnstad tot zijn afdaling in de mijnschacht en neem deel aan de creatie van een accordeonboek dat het verhaal van deze kleine mijnwerker in beelden vertelt."
        ],
        "es": [
          "Después de seguir la historia de Jean-Marie, el pequeño minero de 9-9bis, desde su pueblo minero hasta su descenso al pozo, participa en la creación de un libro acordeón que cuenta la historia de este pequeño minero en imágenes."
        ]
      },
      "@type": [
        "Description"
      ],
