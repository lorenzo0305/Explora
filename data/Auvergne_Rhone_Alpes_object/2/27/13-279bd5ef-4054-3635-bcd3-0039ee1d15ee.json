  "rdfs:comment": {
    "de": [
      "Die Aire Respirando d?Aurec-sur-Loire liegt in einer außergewöhnlichen Umgebung von 10 Hektar Wasser und Grün, die als NATURA 2000 eingestuft wurde, und bietet eine breite Palette an Wasser- und Landaktivitäten."
    ],
    "en": [
      "Located in an exceptional environment of 10 hectares of water and greenery classified NATURA 2000, the Aire Respirando of Aurec-sur-Loire offers a wide range of water and land activities."
    ],
    "it": [
      "Situato in un ambiente eccezionale di 10 ettari di acqua e verde classificato NATURA 2000, l'Aire Respirando di Aurec-sur-Loire offre un'ampia gamma di attività acquatiche e terrestri."
    ],
    "fr": [
      "Située dans un environnement exceptionnel de 10 hectares d’eau et de verdure classé NATURA 2000, l'Aire Respirando d’Aurec-sur-Loire offre un large éventail d’activités nautiques et terrestres."
    ],
    "es": [
      "Situado en un entorno excepcional de 10 hectáreas de agua y vegetación clasificado NATURA 2000, el Aire Respirando de Aurec-sur-Loire ofrece una amplia gama de actividades acuáticas y terrestres."
    ],
    "nl": [
      "De Aire Respirando van Aurec-sur-Loire, gelegen in een uitzonderlijke omgeving van 10 hectare water en groen met de classificatie NATURA 2000, biedt een breed scala aan water- en landactiviteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire Respirando - Base de loisirs des Gorges de la Loire"
    ]
  },
