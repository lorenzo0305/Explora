  "rdfs:comment": {
    "de": [
      "Das historische Zentrum der Welt der Feuerwehr, das von der gemeinnützigen Vereinigung E.F.M.A (European Firefighters Muséum Association) verwaltet wird, freut sich, Sie begrüßen zu dürfen, um die Sammlungen der Welt der Feuerwehr aus allen Epochen zu bewundern."
    ],
    "en": [
      "The historical centre of the firefighter world, managed by the E.F.M.A. (European Firefighters Museum Association), an association of general interest, is pleased to welcome you to admire the collections of the firefighter world from all eras."
    ],
    "it": [
      "Il centro storico del mondo dei vigili del fuoco, gestito dall'E.F.M.A. (European Firefighters Museum Association), un'associazione di interesse generale, è lieto di accogliervi per ammirare le collezioni del mondo dei vigili del fuoco di tutte le epoche."
    ],
    "fr": [
      "Le centre historique du monde sapeur-pompier, géré par l'association E.F.M.A (Européan Firefighters Muséum Association), association d'intérêt général, est heureux de vous accueillir pour admirer les collections du monde sapeur pompier de toutes époques."
    ],
    "nl": [
      "Het historisch centrum van de brandweerwereld, beheerd door de E.F.M.A. (European Firefighters Museum Association), een vereniging van algemeen belang, verwelkomt u graag om de collecties van de brandweerwereld uit alle tijdperken te bewonderen."
    ],
    "es": [
      "El centro histórico del mundo de la lucha contra el fuego, gestionado por la E.F.M.A. (Asociación Europea de Bomberos), una asociación de interés general, se complace en recibirle para que admire las colecciones del mundo de la lucha contra el fuego de todas las épocas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre Historique du Monde Sapeur-Pompier / EFMA"
    ]
  },
