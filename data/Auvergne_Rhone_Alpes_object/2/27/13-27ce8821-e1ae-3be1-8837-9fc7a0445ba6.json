  "rdfs:comment": {
    "de": [
      "Aktuelles Informationsmaterial, unsere persönlichen Ratschläge zur Organisation Ihres Aufenthalts, zur Wahl Ihrer Unterkunft und Ihres Restaurants, Vorschläge für Ausflüge, um eine schöne Zeit zu verbringen: Wir stehen Ihnen zur Verfügung, um Ihnen das Leben leichter zu machen!"
    ],
    "en": [
      "Up-to-date documentation, personalized advice on how to organize your stay, choose your accommodation and restaurant, and suggestions for a great time out: we're here to make your life easier!"
    ],
    "it": [
      "Documentazione aggiornata, consigli personalizzati sull'organizzazione del soggiorno, sulla scelta dell'alloggio e del ristorante, suggerimenti per le gite che vi aiuteranno a divertirvi: siamo qui per semplificarvi la vita!"
    ],
    "fr": [
      "Une documentation actualisée, nos conseils personnalisés pour organiser votre séjour, choisir votre hébergement et votre restaurant, des suggestions de sorties pour passer un bon moment : nous sommes à votre disposition pour vous faciliter la vie !"
    ],
    "nl": [
      "Up-to-date documentatie, persoonlijk advies over het organiseren van je verblijf, het kiezen van je accommodatie en restaurant, suggesties voor uitjes om het je naar de zin te maken: wij zijn er om je het leven gemakkelijker te maken!"
    ],
    "es": [
      "Documentación actualizada, consejos personalizados para organizar su estancia, elegir alojamiento y restaurante, sugerencias de salidas para que se divierta: ¡estamos aquí para hacerle la vida más fácil!"
    ]
  },
  "rdfs:label": {
