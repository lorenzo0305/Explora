      "dc:description": {
        "de": [
          "Institution in Berck seit 1934.\nHandwerkliche Eisdiele und Brauerei.\n\nAnsatz \"Null Plastik\", \"Null Abfall\", \"Anti-gaspi'\""
        ],
        "en": [
          "Berck institution since 1934.\nArtisan ice-cream maker and brewery.\n\nZero plastic\", \"Zero waste\", \"Anti-gaspi'\" approach"
        ],
        "it": [
          "Un'istituzione di Berck dal 1934.\nGelateria artigianale e brasserie.\n\nApproccio \"Zero plastica\", \"Zero rifiuti\", \"Anti-gaspi'\""
        ],
        "fr": [
          "Institution Berckoise depuis 1934. \nArtisan glacier et brasserie.\n\nDémarche \"Zéro plastique\", \"Zéro déchet\", \"Anti-gaspi'"
        ],
        "es": [
          "Una institución en Berck desde 1934.\nHeladería artesanal y brasserie.\n\nPlástico cero\", \"Residuos cero\", \"Antigaspi'\""
        ],
        "nl": [
          "Een instituut in Berck sinds 1934.\nAmbachtelijke ijsmaker en brasserie.\n\nZero plastic\", \"Zero waste\", \"Anti-gaspi\" aanpak"
        ]
