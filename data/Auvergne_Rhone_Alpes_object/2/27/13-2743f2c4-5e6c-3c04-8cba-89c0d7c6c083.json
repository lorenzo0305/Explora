  "rdfs:comment": {
    "de": [
      "Kirche oder ziviles Gebäude?\r\nDieses Gebäude mit dem Namen Notre Dame de la Collégiale oder Halle aux Bleds (Weizenhalle) ist zweifellos ein Blickfang.\r\nEine außergewöhnliche Geschichte und eine bemerkenswerte Restaurierung machen es zu einem symbolträchtigen Gebäude im historischen Zentrum."
    ],
    "en": [
      "Church or civil building?\r\nThe building known as Notre Dame de la Collégiale or Halle aux Bleds (Blés) is undoubtedly a landmark.\r\nIts extraordinary history and remarkable restoration make it an emblematic building in the historic center."
    ],
    "it": [
      "Chiesa o edificio civile?\r\nL'edificio noto come Notre Dame de la Collégiale o Halle aux Bleds (mercato del grano) è senza dubbio un punto di riferimento.\r\nLa sua straordinaria storia e il suo notevole restauro ne hanno fatto un edificio simbolo del centro storico."
    ],
    "fr": [
      "Eglise ou bâtiment civil ? \r\nIncontestablement, cet édifice dénommé Notre Dame de la Collégiale ou Halle aux Bleds (Blés) interpelle.\r\nUne histoire hors du commun et une restauration remarquable en font un bâtiment emblématique du centre historique."
    ],
    "es": [
      "¿Iglesia o edificio civil?\r\nEl edificio conocido como Notre Dame de la Collégiale o Halle aux Bleds (mercado del trigo) es sin duda un lugar emblemático.\r\nSu extraordinaria historia y su notable restauración lo han convertido en un edificio emblemático del centro histórico."
    ],
    "nl": [
      "Kerk of burgerlijk gebouw?\r\nHet gebouw dat bekend staat als Notre Dame de la Collégiale of Halle aux Bleds (korenmarkt) is ongetwijfeld een bezienswaardigheid.\r\nDoor zijn buitengewone geschiedenis en opmerkelijke restauratie is het een bezienswaardigheid in het historische centrum."
    ]
  },
