  "rdfs:comment": {
    "de": [
      "Eine lange Reise, die sich lohnt. Von Balbigny zum Schloss La Bâtie d'Urfé, über Nervieux (und das Schloss Sugny), Cleppé und seinen Turm, Poncins und Montverdun."
    ],
    "en": [
      "A long and worthwhile journey. From Balbigny to Château de la Bâtie d'Urfé, via Nervieux (and Château de Sugny), Cleppé and its tower, Poncins and Montverdun."
    ],
    "it": [
      "Un lungo viaggio che ne vale la pena. Da Balbigny al Castello della Bâtie d'Urfé, passando per Nervieux (e il Castello di Sugny), Cleppé e la sua torre, Poncins e Montverdun."
    ],
    "fr": [
      "Un long périple qui en vaut la peine. De Balbigny au Château de la Bâtie d'Urfé, en passant par Nervieux (et le château de Sugny), Cleppé et sa tour, Poncins et Montverdun."
    ],
    "es": [
      "Un largo viaje que merece la pena. De Balbigny al castillo de la Bâtie d'Urfé, pasando por Nervieux (y el castillo de Sugny), Cleppé y su torre, Poncins y Montverdun."
    ],
    "nl": [
      "Een lange reis die de moeite waard is. Van Balbigny naar het Château de la Bâtie d'Urfé, via Nervieux (en het Château de Sugny), Cleppé en zijn toren, Poncins en Montverdun."
    ]
  },
