  "rdfs:comment": {
    "de": [
      "Picknickplätze am Flussufer (1 Tisch). Tennisplatz, Sportkomplex und Wohnmobilstellplatz in der Nähe. Wanderweg und Balade d'Histoire & d'histoires in der Nähe"
    ],
    "en": [
      "Picnic areas along the river (1 table). Tennis court, sports complex and camper van area nearby. Hiking trail and History & Stories walk nearby"
    ],
    "it": [
      "Aree picnic vicino al fiume (1 tavolo). Campo da tennis, complesso sportivo e area camper nelle vicinanze. Sentiero escursionistico e passeggiata Storia e storie nelle vicinanze"
    ],
    "fr": [
      "Aires de pique-nique en bordure de rivière (1 table). Terrain de tennis, complexe sportif et aire de camping-cars à proximité. Chemin de randonnée et Balade d'Histoire & d'histoires à proximité"
    ],
    "es": [
      "Áreas de picnic junto al río (1 mesa). Pista de tenis, complejo deportivo y área de autocaravanas en las cercanías. Ruta de senderismo y paseo de Historia e Historias en las cercanías"
    ],
    "nl": [
      "Picknickplaatsen bij de rivier (1 tafel). Tennisbaan, sportcomplex en camperterrein in de buurt. Wandelpad en Geschiedenis & Verhalen wandeling in de buurt"
    ]
