  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in Parmilieu; wir können Sie für ein Picknick oder einen Biwak empfangen. Ein Picknicktisch, eine Anbindestange für Pferde und ein Parkplatz stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to the Relais Cyné in Parmilieu where you can come for a picnic or to bivouack overnight. For further details about our Relais Cyné facilities, please don't hesitate to contact us."
    ],
    "it": [
      "Benvenuti al Relais Cyné de Parmilieu; possiamo ospitarvi per un picnic o un bivacco. Abbiamo un tavolo da picnic, una barra per legare i cavalli e un parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de Parmilieu; nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac. Table de pique-nique, barre d'attache pour chevaux et parking sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné de Parmilieu; we kunnen je ontvangen voor een picknick of een bivak. We hebben een picknicktafel, een bar voor paarden en een parkeerplaats."
    ],
    "es": [
      "Bienvenido al Relais Cyné de Parmilieu; podemos acogerle para un picnic o un vivac. Disponemos de una mesa de picnic, un bar de amarre para caballos y un aparcamiento."
    ]
  },
  "rdfs:label": {
