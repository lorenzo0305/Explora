  "rdfs:comment": {
    "de": [
      "Ein Familienunternehmen, das von Marc Goguet gegründet wurde und heute von seiner Tochter Isabelle geführt wird. Hier finden Sie Inbrunst, Enthusiasmus, das Streben nach Perfektion und schließlich eine zeitgemäße Vision des Weins (Übernachtungsmöglichkeit in den Gîtes des Weinguts)."
    ],
    "en": [
      "A family business founded by Marc Goguet and now run by his daughter Isabelle, where you'll find fervor, enthusiasm, a quest for perfection and, last but not least, a contemporary vision of wine (possibility of staying in the estate's gîtes)."
    ],
    "it": [
      "Un'azienda familiare fondata da Marc Goguet e gestita oggi dalla figlia Isabelle, dove troverete fervore, entusiasmo, ricerca della perfezione e una visione contemporanea del vino (possibilità di soggiornare nelle gîtes della tenuta)."
    ],
    "fr": [
      "Entreprise familiale fondée par Marc Goguet et gérée aujourd’hui par sa fille Isabelle où vous retrouverez ferveur, enthousiasme, recherche de la perfection, enfin, une vision contemporaine du vin (possibilité de séjourner dans les gîtes du domaine)."
    ],
    "es": [
      "Una empresa familiar fundada por Marc Goguet y dirigida hoy por su hija Isabelle, donde encontrará fervor, entusiasmo, búsqueda de la perfección y una visión contemporánea del vino (posibilidad de alojarse en las casas rurales de la finca)."
    ],
    "nl": [
      "Een familiebedrijf opgericht door Marc Goguet en tegenwoordig geleid door zijn dochter Isabelle, waar u hartstocht, enthousiasme, een streven naar perfectie en ten slotte een eigentijdse visie op wijn vindt (mogelijkheid tot verblijf in de gîtes van het domein)."
    ]
  },
