  "rdfs:comment": {
    "de": [
      "Ein Restaurant mit hausgemachten Produkten im Herzen eines Einkaufszentrums? Ja, das ist möglich... Gute Laune, die Qualität der Produkte und Geselligkeit sind die Schlüsselwörter des gesamten Teams von Les Agapes."
    ],
    "en": [
      "A restaurant with homemade products in the heart of a shopping mall? yes it's possible... The good mood, the quality of the products and the conviviality are the key words of the whole team at Les Agapes."
    ],
    "it": [
      "Un ristorante con prodotti fatti in casa nel cuore di un centro commerciale? Sì, è possibile... Buon umore, prodotti di qualità e convivialità sono le parole d'ordine di tutto il team Agapes."
    ],
    "fr": [
      "Un restaurant avec des produits maison au cœur d’une galerie marchande? oui c’est possible... La bonne humeur, la qualité des produits et la convivialité sont les maîtres mots de toute l’équipe des Agapes."
    ],
    "es": [
      "¿Un restaurante con productos caseros en el corazón de un centro comercial? Sí, es posible... El buen humor, los productos de calidad y la convivencia son las consignas de todo el equipo de Agapes."
    ],
    "nl": [
      "Een restaurant met huisgemaakte producten in het hart van een winkelcentrum? Ja, het is mogelijk... Goed humeur, kwaliteitsproducten en gezelligheid zijn de sleutelwoorden van het hele Agapes-team."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie les Agapes"
    ]
  },
