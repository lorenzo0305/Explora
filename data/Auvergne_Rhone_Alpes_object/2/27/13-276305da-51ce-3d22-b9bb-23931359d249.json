  "rdfs:comment": {
    "de": [
      "Unter den zahlreichen zeitgenössischen Kirchen in der Region sticht die neoklassisch inspirierte Kirche von Saint-Quentin-Fallavier durch ihre hochwertige lokale Architektur hervor. Sie verfügt über zahlreiche restaurierte Glasfenster und Statuen."
    ],
    "en": [
      "Among the many contemporary churches in the region, the church of Saint-Quentin-Fallavier, of neo-classical inspiration, stands out for its quality local architecture. It features many restored stained glass windows and statues."
    ],
    "it": [
      "Tra le numerose chiese contemporanee della regione, la chiesa di Saint-Quentin-Fallavier, di ispirazione neoclassica, spicca per la qualità dell'architettura locale. Presenta numerose vetrate e statue restaurate."
    ],
    "fr": [
      "Parmi les nombreuses églises contemporaines de la région, l'église de Saint-Quentin-Fallavier, d'inspiration néo-classique, se distingue pour son architecture locale de qualité. Elle comporte de nombreux vitraux et statues restaurées."
    ],
    "nl": [
      "Onder de vele hedendaagse kerken in de regio valt de kerk Saint-Quentin-Fallavier, van neoklassieke inspiratie, op door de kwaliteit van de plaatselijke architectuur. Het heeft veel gebrandschilderde ramen en gerestaureerde beelden."
    ],
    "es": [
      "Entre las numerosas iglesias contemporáneas de la región, la iglesia de Saint-Quentin-Fallavier, de inspiración neoclásica, destaca por la calidad de su arquitectura local. Tiene muchas vidrieras y estatuas restauradas."
    ]
  },
