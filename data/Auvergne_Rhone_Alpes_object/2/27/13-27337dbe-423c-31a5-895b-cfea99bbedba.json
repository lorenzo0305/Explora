  "rdfs:comment": {
    "de": [
      "Gehobenes Restaurant, traditionelle und innovative Küche. Wir sind mit den Qualitätssiegeln „Maître Restaurateur“ (Meisterwirt) und „Qualité Tourisme“ ausgezeichnet. Moderner Rahmen, gelassenes Ambiente, angenehme Terrasse im Sommer, Park mit Bäumen, Privatparkplatz."
    ],
    "en": [
      "A high quality restaurant, traditional and innovative cuisine. We hold the \"Master Restaurateur\" and \"Qualité Tourisme\" labels. Contemporary décor, a relaxed and friendly atmosphere, terrace in summer, wooded grounds, private car park."
    ],
    "it": [
      "Ristorante di qualità, cucina tradizionale e inventiva. Siamo maestri restauratori certificati e turismo di qualità. Ambiente contemporaneo, atmosfera rilassata e cortese, terrazza in estate, parco alberato, parcheggio privato."
    ],
    "fr": [
      "Restaurant de qualité, cuisine traditionnelle et inventive. Nous sommes labellisés maître restaurateur et qualité tourisme. Cadre contemporain, ambiance détendue et courtoise terrasse en été, parc arboré, parking privé."
    ],
    "es": [
      "Restaurante de calidad, cocina tradicional e inventiva. Somos maestros restauradores certificados y turismo de calidad. Entorno contemporáneo, ambiente relajado y cortés, terraza en verano, parque con árboles, aparcamiento privado."
    ],
    "nl": [
      "Kwaliteitsrestaurant, traditionele en inventieve keuken. Wij zijn gecertificeerd meester restaurateur en kwaliteitstoerist. Eigentijdse omgeving, ontspannen en hoffelijke sfeer, terras in de zomer, park met bomen, eigen parkeerplaats."
    ]
  },
