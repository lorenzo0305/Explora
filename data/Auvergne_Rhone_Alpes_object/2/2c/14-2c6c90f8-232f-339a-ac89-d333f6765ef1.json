  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #12.\nEs schweift ab, es hüpft, es lacht. Eine Ode an die Freiheit der Phantasie, die man ohne Mäßigung ausprobieren kann!"
    ],
    "en": [
      "Programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #12.\nIt rambles, it bounces, it laughs. An ode to the freedom of the imagination, to be experienced without moderation!"
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\nDivaga, rimbalza, ride. Un'ode alla libertà dell'immaginazione, da vivere senza moderazione!"
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #12.\nÇa divague, ça rebondit, ça rigole. Une ode à la liberté de l'imagination, à expérimenter sans modération !"
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #12.\nDivaga, rebota, ríe. Una oda a la libertad de la imaginación, para vivirla sin moderación"
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #12.\nHet zwerft, het stuitert, het lacht. Een ode aan de vrijheid van de verbeelding, om zonder mate te beleven!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Qu'est-ce qu'on fabrique en famille ? - Pourquoi un arbre est une poule ?"
    ]
  },
