  "rdfs:comment": {
    "de": [
      "Besser bekannt als \"Bibliobus\" und in der Part-Dieu angesiedelt, stärkt und ergänzt der mobile Pol das Bibliotheksnetz in den neun Arrondissements von Lyon."
    ],
    "en": [
      "Better known under the name of \"bibliobus\" and located in Part-Dieu, the Mobile Pole reinforces and completes the network of libraries in the 9 districts of Lyon."
    ],
    "it": [
      "Meglio conosciuto come \"bibliobus\" e situato a Part-Dieu, il Polo mobile rafforza e completa la rete bibliotecaria nei 9 distretti di Lione."
    ],
    "fr": [
      "Plus connu sous le nom de \"bibliobus\" et localisé à la Part-Dieu, le Pôle mobile renforce et complète le réseau des bibliothèques sur les 9 arrondissements de Lyon."
    ],
    "es": [
      "Más conocido como \"bibliobús\" y situado en la Part-Dieu, el Polo Móvil refuerza y completa la red de bibliotecas en los 9 distritos de Lyon."
    ],
    "nl": [
      "Beter bekend als de \"bibliobus\" en gevestigd in Part-Dieu, versterkt en vervolledigt de Mobiele Pool het bibliotheeknetwerk in de 9 wijken van Lyon."
    ]
  },
