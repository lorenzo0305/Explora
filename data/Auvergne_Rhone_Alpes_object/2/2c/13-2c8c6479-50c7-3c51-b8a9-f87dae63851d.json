  "rdfs:comment": {
    "de": [
      "Entdecken Sie am Ufer der Saône das Restaurant Tibone & Dorade unter der Leitung von Chefkoch William Louvel, der jeden Tag ein schmackhaftes Menü mit im Josper®-Ofen gegrillten Fleisch- und Fischspezialitäten unter Verwendung von Saisonprodukten zusammenstellt."
    ],
    "en": [
      "Along the banks of the Saône, discover the Tibone & Dorade restaurant, orchestrated by Chef William Louvel, who creates a tasty menu every day with meat and fish specialities grilled in the Josper® oven."
    ],
    "it": [
      "Lungo le rive della Saona, scoprite il ristorante Tibone & Dorade, orchestrato dallo chef William Louvel, che ogni giorno crea un gustoso menu con specialità di carne e pesce alla griglia nel forno Josper®."
    ],
    "fr": [
      "Le long des berges de la Saône, découvrez le restaurant Tibone & Dorade orchestré par le Chef William Louvel, qui élabore chaque jour une carte savoureuse avec des spécialités de viandes et poissons grillés au four Josper®."
    ],
    "nl": [
      "Ontdek langs de oevers van de Saône het restaurant Tibone & Dorade van chef-kok William Louvel, die elke dag een smakelijk menu bereidt met specialiteiten van vlees en vis gegrild in de Josper®-oven."
    ],
    "es": [
      "A lo largo de las orillas del Saona, descubra el restaurante Tibone & Dorade, orquestado por el chef William Louvel, que crea cada día un sabroso menú con especialidades de carne y pescado a la parrilla del horno Josper®."
    ]
  },
