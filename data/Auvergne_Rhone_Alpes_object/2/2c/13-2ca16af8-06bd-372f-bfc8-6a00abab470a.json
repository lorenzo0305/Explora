  "rdfs:comment": {
    "de": [
      "Landwirtschaftliche Betrieb: 50 Bio-Gemüse und Obst auf dem Bauernhof angebaut, aber auch die Produkte von lokalen Bio-Farmen (Sommerfrüchte, Pilze, Nüsse, Trauben, Käse...)\r\nMöglichkeit Produkte am Stand zu kaufen"
    ],
    "en": [
      "Market gardening farm: 50 organic vegetables and fruits grown on the farm but also organic and local farm products (summer fruits, mushrooms, nuts, grapes, cheeses...)\r\nPossibility to buy the products at the stand"
    ],
    "it": [
      "Fattoria-orto: 50 ortaggi e frutta biologici coltivati in azienda, oltre a prodotti provenienti da aziende agricole biologiche e locali (frutta estiva, funghi, noci, uva, formaggi, ecc.)\r\nÈ possibile acquistare i prodotti presso lo stand"
    ],
    "fr": [
      "Exploitation agricole maraichère : 50 légumes et fruits bios cultivés à la ferme mais aussi les produits de fermes bios et locales (fruits d'été, champignons, noix, raisins, fromages...)\r\nPossibilité d'acheter les produits au stand"
    ],
    "nl": [
      "Tuinboerderij: 50 biologische groenten en fruit geteeld op de boerderij maar ook biologische en lokale landbouwproducten (zomerfruit, champignons, noten, druiven, kazen ...)\r\nMogelijkheid om de producten op de stand te kopen"
    ],
    "es": [
      "Huerta de la granja: 50 verduras y frutas ecológicas cultivadas en la granja, así como productos de granjas ecológicas y locales (fruta de verano, setas, frutos secos, uvas, quesos, etc.)\r\nPuede comprar productos en el puesto"
    ]
  },
