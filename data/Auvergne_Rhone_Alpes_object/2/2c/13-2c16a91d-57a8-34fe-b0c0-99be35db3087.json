  "rdfs:comment": {
    "de": [
      "Ein Kokon des Wohlbefindens für einen Moment absoluter Entspannung. Gönnen Sie sich eine Auszeit der sinnlichen Entspannung. Das Spa des Château de Chapeau Cornu ist sowohl für Hotelgäste als auch für \"Externe\" geöffnet.  Schönheits- und Wellnessbehandlungen sowie Nagelpflege."
    ],
    "en": [
      "A cocoon of well-being for a moment of absolute relaxation, offering you a break from sensory relaxation in a soothing atmosphere. Hammam, sauna, sensory shower, rest area with a wall of Himalayan salt and a herbal tea relaxation area."
    ],
    "it": [
      "Un bozzolo di benessere per un relax assoluto. Concedetevi un momento di relax sensoriale. La Spa dello Château de Chapeau Cornu è aperta sia agli ospiti dell'hotel che agli \"esterni\".  Trattamenti di bellezza, benessere e cura delle unghie."
    ],
    "fr": [
      "Un cocon de bien-être pour un moment de détente absolu. Offrez-vous une parenthèse de relaxation sensorielle. Le Spa du Château de Chapeau Cornu est ouvert aussi bien aux clients de l'hôtel qu'aux \"extérieurs\".  Soins esthétiques, bien-être et onglerie."
    ],
    "es": [
      "Un capullo de bienestar para una relajación absoluta. Regálese un momento de relajación sensorial. El Spa del Château de Chapeau Cornu está abierto tanto a los huéspedes del hotel como a los \"forasteros\".  Tratamientos de belleza, bienestar y cuidado de las uñas."
    ],
    "nl": [
      "Een cocon van welzijn voor absolute ontspanning. Gun uzelf een moment van zintuiglijke ontspanning. De Spa van het Château de Chapeau Cornu is toegankelijk voor zowel hotelgasten als \"buitenstaanders\".  Schoonheidsbehandelingen, welzijn en nagelverzorging."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spa du Château"
    ]
  },
