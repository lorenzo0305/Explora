  "rdfs:comment": {
    "de": [
      "Ô Chalet ist ein Burger-Restaurant, das 2014 in Morzine gegründet wurde. Seit Dezember 2023 haben wir uns in Les Gets niedergelassen. Indem wir Sie an unseren Tisch einladen, möchte unser Team Sie in unsere Street-Food-Welt einführen."
    ],
    "en": [
      "Ô Chalet is a burger restaurant created in Morzine in 2014 and since December 2023 we've been based in Les Gets. By inviting you to our table, our team would like you to discover our Street Food universe."
    ],
    "it": [
      "Ô Chalet è un ristorante di hamburger nato a Morzine nel 2014 e dal dicembre 2023 con sede a Les Gets. Invitandovi alla nostra tavola, il nostro team desidera farvi scoprire il nostro universo Street Food."
    ],
    "fr": [
      "Ô Chalet est un restaurant de Burgers créé à Morzine en 2014 et depuis Décembre 2023 nous sommes installés aux Gets. En vous conviant à notre table, notre équipe souhaite vous faire découvrir notre univers Street Food."
    ],
    "nl": [
      "Ô Chalet is een hamburgerrestaurant dat in 2014 is opgericht in Morzine en sinds december 2023 is gevestigd in Les Gets. Door u uit te nodigen aan onze tafel, wil ons team u ons Street Food universum laten ontdekken."
    ],
    "es": [
      "Ô Chalet es una hamburguesería creada en Morzine en 2014 y desde diciembre de 2023 estamos instalados en Les Gets. Al invitarle a nuestra mesa, nuestro equipo desea que descubra nuestro universo Street Food."
    ]
  },
