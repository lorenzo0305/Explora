  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b05c2b9f-0589-3394-8b54-428107869c02",
      "dc:description": {
        "de": [
          "Sign?Com schließt sich der Birdie Group an.\nSchilder, Klebstoffe, Fahrzeugbeschriftungen, Personalisierung von Textilien/Tassen, Druck auf allen Materialien, Grafikdesign...\n\nGeöffnet von Montag bis Freitag von 8:30 bis 12:30 und von 13:30 bis 17:30 (16:30 am Freitag)"
        ],
        "en": [
          "Sign?Com joins the Birdie Group.\nSigns, adhesives, vehicle markings, textile/mug customization, all-media printing, graphic design...\n\nOpen Monday to Friday, 8:30 a.m. to 12:30 p.m. and 1:30 p.m. to 5:30 p.m. (4:30 p.m. on Fridays)"
        ],
        "it": [
          "Sign?Com entra a far parte del gruppo Birdie.\nInsegne, adesivi, segnaletica per veicoli, tessuti/tazze personalizzate, stampa su tutti i supporti, design grafico...\n\nAperto dal lunedì al venerdì, dalle 8.30 alle 12.30 e dalle 13.30 alle 17.30 (16.30 il venerdì)"
        ],
        "fr": [
          "Sign’Com rejoint le groupe Birdie.\nPanneaux, adhésifs, marquages de véhicules, personnalisations de textiles/mugs, impressions tout supports, création graphique..\n\nOuvert du lundi au vendredi de 8h30 à 12h30 et de 13h30 à 17h30 (16h30 le vendredi)"
        ],
        "nl": [
          "Sign?Com sluit zich aan bij de Birdie-groep.\nBorden, kleefstoffen, voertuigmarkeringen, textiel/mokken op maat, drukwerk op alle media, grafisch ontwerp...\n\nGeopend van maandag tot vrijdag van 8.30 tot 12.30 en van 13.30 tot 17.30 (16.30 op vrijdag)"
        ],
        "es": [
          "Sign Com se une al grupo Birdie.\nRótulos, adhesivos, rotulación de vehículos, textiles/tazas personalizados, impresión en todos los soportes, diseño gráfico...\n\nAbierto de lunes a viernes, de 8.30 a 12.30 y de 13.30 a 17.30 (16.30 los viernes)"
        ]
      },
      "@type": [
