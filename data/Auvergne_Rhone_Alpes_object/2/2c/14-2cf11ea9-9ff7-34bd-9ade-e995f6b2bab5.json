      "dc:description": {
        "de": [
          "Bar des Holiday Inn Resort Hotels.\nUnsere Einrichtung ist wegen Renovierungsarbeiten geschlossen. Wir freuen uns darauf, Sie ab der Sommersaison 2026 wieder begrüßen zu dürfen."
        ],
        "en": [
          "Holiday Inn Resort Bar.\nOur establishment is closed for renovation, and we look forward to welcoming you back in the 2026 summer season."
        ],
        "it": [
          "Holiday Inn Resort Bar.\nIl nostro stabilimento è chiuso per ristrutturazione e vi aspettiamo nell'estate del 2026."
        ],
        "fr": [
          "Bar de l'hôtel Holiday Inn Resort.\nNotre établissement est fermé pour rénovation, nous avons hâte de vous retrouver dès la saison estivale 2026."
        ],
        "nl": [
          "Holiday Inn Resort Bar.\nOns etablissement is gesloten voor renovatie en we kijken ernaar uit om je in de zomer van 2026 weer te zien."
        ],
        "es": [
          "Holiday Inn Resort Bar.\nNuestro establecimiento está cerrado por reformas, y esperamos volver a verle en el verano de 2026."
        ]
      },
