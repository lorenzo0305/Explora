  "rdfs:comment": {
    "de": [
      "Entdecken Sie ASANA Sport und Wellness, in der Nähe von Les Vans! Erkunden Sie die Ardèche einmal anders... und passen Sie auf sich auf... Natursport- und Wellness-Aktivitäten für alle, das ganze Jahr über."
    ],
    "en": [
      "A company specializing in sports and well-being.\r\nOur aim is to give everyone the practical tools they need to take charge of their own well-being."
    ],
    "it": [
      "Scoprite ASANA Sport et Bien-être, vicino a Les Vans! Esplorate l'Ardèche in modo diverso... e prendetevi cura di voi stessi... Sport naturali e attività di benessere per tutti, tutto l'anno."
    ],
    "fr": [
      "Découvrez ASANA Sport et Bien-être, près des Vans ! Explorez l'Ardèche autrement... et prenez soin de vous... Des activités Sport Nature et Bien-être pour tous, toute l'année."
    ],
    "es": [
      "¡Descubra ASANA Sport et Bien-être, cerca de Les Vans! Explore la Ardèche de otra manera... y cuídese... Actividades deportivas y de bienestar naturales para todos, todo el año."
    ],
    "nl": [
      "Ontdek ASANA Sport et Bien-être, vlakbij Les Vans! Ontdek de Ardèche op een andere manier... en zorg goed voor uzelf... Natuurlijke sport- en welzijnsactiviteiten voor iedereen, het hele jaar door."
    ]
  },
