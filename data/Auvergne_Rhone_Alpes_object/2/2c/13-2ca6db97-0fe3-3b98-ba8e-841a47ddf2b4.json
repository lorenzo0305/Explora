  "rdfs:comment": {
    "de": [
      "Der Motor des Sessellifts wurde gestohlen! Aber wer steckt hinter diesem Manöver und was hat er damit vor?\r\nHolen Sie sich das Kartenspiel, das Sie am Empfang des Fremdenverkehrsamtes erhalten."
    ],
    "en": [
      "The chairlift motor has been stolen! But who's behind it, and what are they planning to do with it?\r\nPick up the card game at the Tourist Office reception desk."
    ],
    "it": [
      "Il motore della seggiovia è stato rubato! Ma chi c'è dietro e cosa ha intenzione di fare?\r\nVenite a ritirare il mazzo di carte disponibile alla reception dell'Ufficio del Turismo."
    ],
    "fr": [
      "Le moteur du télésiège a été volé ! Mais qui se cache derrière cette manœuvre et que compte-t-il en faire ?\r\nVenez récupérer le jeu de carte disponible à l'accueil de l'office de tourisme."
    ],
    "es": [
      "Han robado el motor del telesilla Pero, ¿quién está detrás y qué piensa hacer con él?\r\nVen a recoger la baraja disponible en la recepción de la Oficina de Turismo."
    ],
    "nl": [
      "De motor van de stoeltjeslift is gestolen! Maar wie zit erachter en wat zijn ze ermee van plan?\r\nKom de kaarten ophalen bij de receptie van het toeristenbureau."
    ]
  },
  "rdfs:label": {
    "en": [
      "Investigation: The Mystery of the Gold Medal"
    ],
    "fr": [
      "Enquête : l'énigme de la médaille d'or"
    ],
    "nl": [
      "Enquête: het raadsel van de gouden medaille"
    ]
  },
