  "rdfs:comment": {
    "de": [
      "D'air et d'eau ist ein Ort der Entspannung, der auf das Wohlbefinden des Körpers und den Frieden des Geistes ausgerichtet ist: Spa, Hammam, Entspannung, Pflege, Schönheitspflege."
    ],
    "en": [
      "D'air et d'eau is a place dedicated to relaxation, designed to the well-being of the body and the peace of the mind: hammam, relaxation, cares, beauty treatments."
    ],
    "it": [
      "D'air et d'eau è un luogo di relax, pensato per il benessere del corpo e la pace della mente: spa, hammam, relax, trattamenti, estetica."
    ],
    "fr": [
      "D'air et d'eau est un lieu de relaxation, imaginé pour le bien-être du corps et la paix de l'esprit: spa, hammam, relaxation, soins,  esthétique."
    ],
    "nl": [
      "D'air et d'eau is een plek van ontspanning, ontworpen voor het welzijn van het lichaam en gemoedsrust: spa, hammam, ontspanning, behandelingen, esthetiek."
    ],
    "es": [
      "D'air et d'eau es un lugar de relajación, pensado para el bienestar del cuerpo y la tranquilidad del espíritu: spa, hammam, relajación, tratamientos, cuidados de belleza."
    ]
