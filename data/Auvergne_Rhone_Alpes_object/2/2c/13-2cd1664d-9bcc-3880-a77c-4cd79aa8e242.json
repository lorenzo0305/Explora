  "rdfs:comment": {
    "de": [
      "Saint-Pierre ist eine ehemalige Burgkirche. Ihr Schiff mit drei Spannweiten und die regelmäßigen Bögen machen sie zu einem typischen Bauwerk aus dem späten 11. Jahrhunderts. Im Inneren der Kirche ist ein Volutenkapitell zu sehen, das als Weihwasserbecken verwendet wurde."
    ],
    "en": [
      "Saint-Pierre is a former castle church. With its 3-bay nave and regular arches, it is typical of the late 11th century. Inside, a scrolled capital has been reused as a font."
    ],
    "it": [
      "Saint-Pierre è un'antica chiesa del castello. La navata a tre campate e gli archi regolari ne fanno un edificio tipico della fine dell'XI secolo. L'interno è caratterizzato da un'acquasantiera con capitello a volute."
    ],
    "fr": [
      "Saint-Pierre est une ancienne église castrale. Sa nef de 3 travées, ses arcs réguliers en font un édifice typique de la fin du XI ème siècle. On notera à l'intérieur le remploi en bénitier d'un chapiteau à volutes."
    ],
    "nl": [
      "Saint-Pierre is een voormalige kasteelkerk. Met zijn schip met 3 traveeën en regelmatige bogen is het typisch voor de late 11e eeuw. Binnen is een gekruld kapiteel hergebruikt als doopvont."
    ],
    "es": [
      "Saint-Pierre es una antigua iglesia de un castillo. Su nave de tres tramos y sus arcos regulares lo convierten en un edificio típico de finales del siglo XI. El interior presenta un estuche con un capitel con volutas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Pierre"
    ]
  },
