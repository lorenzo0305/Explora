  "rdfs:comment": {
    "de": [
      "Museum für die Geschichte von St. Vallier, von vor 2 Millionen Jahren bis heute. Verschiedene Sonderausstellungen: Die Bombardierung des Champ de Mars im Jahr 1944; Archäologie; Der Große Krieg und Diane de Poitiers. Täglich Führungen durch die Stadt auf Anfrage."
    ],
    "en": [
      "History of Saint-Vallier going back 2 million years and  including various temporary exhibitions. Guided tours of the town during summer."
    ],
    "it": [
      "Museo della storia di St Vallier, da 2 milioni di anni fa a oggi. Varie mostre temporanee: il bombardamento del Campo di Marte nel 1944, l'archeologia, la Grande Guerra e Diane de Poitiers. Visite guidate della città ogni giorno su richiesta."
    ],
    "fr": [
      "Musée histoire de St Vallier, de 2 millions d'années à nos jours. Diverses expositions temporaires: le bombardement du Champ de Mars en 1944; archéologie; La Grande Guerre et Diane de Poitiers. Visites commentées de la ville tous les jours sur demande."
    ],
    "nl": [
      "Museum over de geschiedenis van St Vallier, van 2 miljoen jaar geleden tot nu. Verschillende tijdelijke tentoonstellingen: het bombardement op de Champ de Mars in 1944; archeologie; de Grote Oorlog en Diane de Poitiers. Dagelijks rondleidingen door de stad op aanvraag."
    ],
    "es": [
      "Museo de la historia de St Vallier, desde hace 2 millones de años hasta la actualidad. Varias exposiciones temporales: el bombardeo del Campo de Marte en 1944; arqueología; la Gran Guerra y Diane de Poitiers. Visitas guiadas a la ciudad todos los días bajo petición."
    ]
  },
