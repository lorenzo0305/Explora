  "rdfs:comment": {
    "de": [
      "Testen Sie diese Route von Le Mollard aus! Da sie technisch weniger anspruchsvoll ist als die schwarze Route des Rivalen, können Sie trotzdem von Le Mollard aus starten. Es handelt sich um einen Single Monotrace, der speziell für Mountainbiker ausgelegt ist."
    ],
    "en": [
      "Come and test this route from Le Mollard! Its lower technical level than the rival black route means you can still set off from Le Mollard. It's a single-track route specially designed for mountain biking."
    ],
    "it": [
      "Venite a provare questo percorso da Le Mollard! È meno impegnativo dal punto di vista tecnico rispetto al percorso nero rivale, quindi potete sempre partire da Le Mollard. Si tratta di un percorso single-track appositamente studiato per la mountain bike."
    ],
    "fr": [
      "Venez tester cet itinéraire au départ du Mollard ! Son niveau technique moins élevé que la noire du rival vous permettra de partir du Mollard quand même. C'est un single monotrace spécialement tracé pour le VTT."
    ],
    "es": [
      "Ven a probar esta ruta desde Le Mollard Es menos exigente técnicamente que la ruta negra rival, por lo que puedes salir desde Le Mollard. Es un recorrido de una sola pista especialmente diseñado para la bicicleta de montaña."
    ],
    "nl": [
      "Kom deze route proberen vanuit Le Mollard! De route is technisch minder zwaar dan de zwarte route, dus je kunt nog steeds vertrekken vanuit Le Mollard. Het is een single-track route speciaal ontworpen voor mountainbiken."
    ]
  },
