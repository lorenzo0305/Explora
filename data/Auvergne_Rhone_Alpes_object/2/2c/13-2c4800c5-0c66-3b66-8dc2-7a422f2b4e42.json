  "rdfs:comment": {
    "de": [
      "Vom alten Dorf Allan aus erkundet diese große Trailrunde den Wald von Allan und seine Hochebenen, wobei sie sich mit den benachbarten Wäldern verbindet: eine schöne Erkundungstour im Herzen der südlichen Vegetation."
    ],
    "en": [
      "Starting from the old village of Allan, this long trail loop explores the Allan forest and its plateaus, joining the neighboring forests: a beautiful exploration in the heart of southern vegetation."
    ],
    "it": [
      "Partendo dall'antico villaggio di Allan, questo lungo percorso ad anello esplora la foresta di Allan e i suoi altipiani, unendosi alle foreste vicine: una meravigliosa esplorazione del cuore della vegetazione meridionale."
    ],
    "fr": [
      "Au départ du vieux village d'Allan, cette grande boucle de trail explore la forêt d'Allan et ses plateaux, en rejoignant les forêts voisines : une belle exploration au cœur de la végétation méridionale."
    ],
    "es": [
      "Partiendo del antiguo pueblo de Allan, este largo sendero en bucle explora el bosque de Allan y sus mesetas, uniéndose a los bosques vecinos: una maravillosa exploración del corazón de la vegetación meridional."
    ],
    "nl": [
      "Deze lange lusroute begint bij het oude dorp Allan en verkent het bos van Allan en zijn plateaus, waarbij de aangrenzende bossen worden samengevoegd: een prachtige verkenning van het hart van de zuidelijke vegetatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tour des plateaux de la forêt d'Allan"
    ]
  },
