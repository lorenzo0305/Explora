  "rdfs:comment": {
    "de": [
      "Valence en Gastronomie wurde am 10. Juni 2015 gegründet und ist der Verein zur Förderung von Talenten und zur Vorplanung der Cité de la Gastronomie in Valence (Antrag auf Verleihung des Gütesiegels läuft).\r\nOrganisation des Festivals Valence en Gastronomie im September."
    ],
    "en": [
      "Valence en Gastronomie born on June 10, 2015 is the association for the promotion of talents and the prefiguration of the Cité de la Gastronomie de Valence (label application in progress).\r\nOrganization of the Valence en Gastronomie Festival in September."
    ],
    "it": [
      "Creata il 10 giugno 2015, l'associazione organizza il Festival Valence en Gastronomie a settembre, in collaborazione con Valcom."
    ],
    "fr": [
      "Née le 10 juin 2015, l’association organise le Festival Valence en Gastronomie en septembre, en partenariat avec la société Valcom."
    ],
    "nl": [
      "Valence en Gastronomie werd op 10 juni 2015 opgericht als vereniging om talent te promoten en de weg te bereiden voor de Cité de la Gastronomie in Valence (aanvraag voor certificering aan de gang).\r\nOrganisatie van het Festival Valence en Gastronomie in september."
    ],
    "es": [
      "Creada el 10 de junio de 2015, la asociación organiza en septiembre el Festival Valence en Gastronomie, en colaboración con Valcom."
    ]
  },
