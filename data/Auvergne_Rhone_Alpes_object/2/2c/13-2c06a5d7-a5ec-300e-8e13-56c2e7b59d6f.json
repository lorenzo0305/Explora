  "rdfs:comment": {
    "de": [
      "Willkommen zu Hause in unserem Restaurant. Auf der Speisekarte steht eine Reise für Gourmets und Feinschmecker vereint. Subtil, raffiniert, erfinderisch und großzügig, die Gourmetküche sublimiert das Terroir mit Aromen von hier und anderswo.\r\nGerichte zum Mitnehmen."
    ],
    "en": [
      "Welcome home, in our (3 cocottes logis) restaurant, the chef will propose you a gourmet break, with delicacy cooking in memory of our grand mother. Let's go for both a gourmet and gourmand menu."
    ],
    "it": [
      "Benvenuti nel nostro ristorante, nel menu, un viaggio per buongustai e gourmet insieme. Sottile, raffinata, inventiva e generosa, la nostra cucina gourmet sublima il territorio locale con sapori di qui e di altrove.\r\nPiatti da asporto."
    ],
    "fr": [
      "Bienvenue chez vous dans notre restaurant,  au menu, voyage pour les gourmets et les gourmands réunis. Subtile, raffinée, inventive et généreuse, la  cuisine gourmande sublime le terroir avec des saveurs d’ici et d’ailleurs.\r\nPlats à emporter."
    ],
    "nl": [
      "Welkom thuis in ons restaurant, op het menu, een reis voor fijnproevers en fijnproevers verzameld. Subtiel, verfijnd, inventief en genereus, de gastronomische keuken sublimeert het terroir met smaken van hier en elders.\r\nAfhaalmaaltijden."
    ],
    "es": [
      "Bienvenido a nuestro restaurante, en el menú, un viaje para gourmets y sibaritas juntos. Sutil, refinada, inventiva y generosa, nuestra cocina gourmet sublima la zona local con sabores de aquí y de otros lugares.\r\nPlatos para llevar."
    ]
  },
  "rdfs:label": {
