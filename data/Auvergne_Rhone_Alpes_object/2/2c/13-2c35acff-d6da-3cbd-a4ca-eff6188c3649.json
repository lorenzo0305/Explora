  "rdfs:comment": {
    "de": [
      "Ein Ort der Entdeckung, Erforschung und des Experimentierens. Belvedere mit Panoramablick auf die Stadt Issoire und die Umgebung (Massif du Sancy, Livradois-Forez). Wechselnde Ausstellungen, Konferenzen, Filmvorführungen und Workshops zu verschiedenen Themen."
    ],
    "en": [
      "A place for discovery, exploration and experimentation. Belvedere with panoramic views over Issoire and the surrounding area (Massif du Sancy, Livradois-Forez). Temporary exhibitions, lectures, screenings and workshops on a variety of themes."
    ],
    "it": [
      "Un luogo di scoperta, esplorazione e sperimentazione. Belvedere che offre una vista panoramica sulla città di Issoire e sui dintorni (Massiccio del Sancy, Livradois-Forez). Mostre temporanee, conferenze, proiezioni e workshop su diversi temi."
    ],
    "fr": [
      "Un lieu de découverte, d'exploration et d'expérimentation. Belvédère offrant un panorama sur la ville d'Issoire et les alentours (Massif du Sancy, Livradois-Forez). Expositions temporaires, conférences, projections et ateliers sur diverses thématiques."
    ],
    "es": [
      "Un lugar para descubrir, explorar y experimentar. Belvedere que ofrece una vista panorámica de la ciudad de Issoire y sus alrededores (Massif du Sancy, Livradois-Forez). Exposiciones temporales, conferencias, proyecciones y talleres sobre temas variados."
    ],
    "nl": [
      "Een plek voor ontdekking, verkenning en experiment. Belvedère met panoramisch uitzicht over de stad Issoire en de omgeving (Massif du Sancy, Livradois-Forez). Tijdelijke tentoonstellingen, conferenties, filmvertoningen en workshops over verschillende thema's."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tour de l'horloge (Clock Tower)"
    ],
    "fr": [
      "Tour de l'Horloge"
    ]
  },
