  "rdfs:comment": {
    "de": [
      "Was gibt es Schöneres, als sich an der frischen Luft sportlich zu betätigen? Die AirFit Station ist die ideale Ausrüstung, um sich auf einem hochwertigen Multifunktionsgerät auszupowern."
    ],
    "en": [
      "What could be better than exercising in the great outdoors? Station AirFit is the ideal way to work out on a high-quality, multi-function machine."
    ],
    "it": [
      "Cosa c'è di meglio che fare esercizio all'aria aperta? La AirFit Station è l'attrezzatura ideale per allenarsi su una macchina di alta qualità e multifunzionale."
    ],
    "fr": [
      "Quoi de mieux que de faire du sport en pleine air ? La Station AirFit est l'équipement idéal pour vous dépenser sur une machine de haute qualité et multifonction."
    ],
    "es": [
      "¿Qué puede ser mejor que hacer ejercicio al aire libre? La estación AirFit es el equipo ideal para hacer ejercicio en una máquina de alta calidad y multifuncional."
    ],
    "nl": [
      "Wat is er beter dan sporten in de buitenlucht? Het AirFit Station is de ideale manier om te trainen op een multifunctioneel toestel van hoge kwaliteit."
    ]
  },
