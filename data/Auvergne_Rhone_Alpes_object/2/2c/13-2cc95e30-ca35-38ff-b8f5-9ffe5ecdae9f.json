  "rdfs:comment": {
    "de": [
      "Bar, Restaurant, Pizzeria, Snack, Gasdepot im Herzen des Dorfes. Anabele empfängt Sie und bietet Ihnen in einem warmen, authentischen Rahmen eine traditionelle Küche mit lokalen Produkten an.\r\nPicknickkörbe sind auf Anfrage erhältlich."
    ],
    "en": [
      "Bar, restaurant, pizzeria, snack bar, deli and gas depot in the village centre. Anabele serve classic dishes and set menus with local produce in a welcoming setting.\r\nPicnic baskets available on request."
    ],
    "it": [
      "Bar, ristorante, pizzeria, snack bar, deposito di gas nel cuore del paese. L'Anabele vi accoglie e offre una cucina tradizionale in un ambiente caldo e autentico, utilizzando prodotti locali.\r\nCestini da picnic disponibili su richiesta."
    ],
    "fr": [
      "Bar, restaurant, pizzeria, snack, dépôt de gaz au cœur du village. Anabele vous accueille et propose dans un cadre chaleureux, authentique une cuisine traditionnelle et formule avec produits locaux.\r\nPaniers pique-nique disponibles sur demande."
    ],
    "es": [
      "Bar, restaurante, pizzería, snack bar, gasolinera en el corazón del pueblo. Anabele le da la bienvenida y le ofrece una cocina tradicional en un ambiente cálido y auténtico, con productos locales.\r\nCestas de picnic disponibles previa petición."
    ],
    "nl": [
      "Bar, restaurant, pizzeria, snackbar, benzinedepot in het hart van het dorp. Anabele heet je welkom en biedt een traditionele keuken in een warme, authentieke omgeving, met lokale producten.\r\nPicknickmanden beschikbaar op aanvraag."
    ]
  },
