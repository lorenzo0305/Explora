  "rdfs:comment": {
    "de": [
      "Woods ist Ihr neues Restaurant in Bourgoin-Jallieu, das sich im Einkaufszentrum Leclerc befindet. Es ist von Montag bis Samstag geöffnet, um etwas zu trinken, einen Kaffee zu trinken, zu Mittag oder zu Abend zu essen."
    ],
    "en": [
      "Woods is your new restaurant in Bourgoin-Jallieu, located in the Leclerc shopping centre. Open from Monday to Saturday for a drink, coffee, lunch or dinner."
    ],
    "it": [
      "Woods è il vostro nuovo ristorante a Bourgoin-Jallieu, situato nel centro commerciale Leclerc. Aperto dal lunedì al sabato per un drink, un caffè, un pranzo o una cena."
    ],
    "fr": [
      "Woods est votre nouveau restaurant à Bourgoin-Jallieu, situé dans le centre commercial Leclerc. Ouvert du lundi au samedi pour prendre un verre, boire un café, déjeuner ou dîner."
    ],
    "nl": [
      "Woods is uw nieuwe restaurant in Bourgoin-Jallieu, gelegen in het Leclerc winkelcentrum. Open van maandag tot zaterdag voor een drankje, koffie, lunch of diner."
    ],
    "es": [
      "Woods es su nuevo restaurante en Bourgoin-Jallieu, situado en el centro comercial Leclerc. Abierto de lunes a sábado para tomar una copa, un café, comer o cenar."
    ]
  },
