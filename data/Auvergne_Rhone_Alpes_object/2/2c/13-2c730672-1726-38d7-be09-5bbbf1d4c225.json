  "rdfs:comment": {
    "de": [
      "Es wird geschält, geschmort und gebraten... denn hier wird zu 100 % hausgemacht gekocht!\r\nUnsere Rezepte richten sich nach den Jahreszeiten und wir bevorzugen kurze Transportwege."
    ],
    "en": [
      "We peel, we simmer, we brown... because here, the cuisine is 100% homemade!\r\nOur recipes follow the seasons and we make short circuits our first choice."
    ],
    "it": [
      "Peliamo, cuociamo a fuoco lento, friggiamo... perché qui la cucina è al 100% fatta in casa!\r\nLe nostre ricette seguono le stagioni e privilegiamo i canali di distribuzione brevi."
    ],
    "fr": [
      "On épluche, on mijote, on rissole... car ici, la cuisine est 100% fait maison !\r\nNos recettes suivent les saisons et nous privilégions les circuits courts."
    ],
    "nl": [
      "We schillen, we stoven, we bakken... want hier is koken 100% zelfgemaakt!\r\nOnze recepten volgen de seizoenen en we geven de voorkeur aan korte distributiekanalen."
    ],
    "es": [
      "Pelamos, cocinamos a fuego lento, freímos... porque aquí, ¡la cocina es 100% casera!\r\nNuestras recetas siguen las estaciones y favorecemos los canales cortos de distribución."
    ]
  },
