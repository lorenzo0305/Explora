  "rdfs:comment": {
    "de": [
      "Die Tiere des Skigebiets haben ein Problem. Pfeif das Murmeltier, das Maskottchen des Skigebiets ist diesen Winter nicht aufgewacht, um über das Skigebiet zu wachen!"
    ],
    "en": [
      "The resort's animals have a problem. The resort's mascot, Sifflote the marmot, has not woken up this winter to keep an eye on the resort!"
    ],
    "it": [
      "Gli animali del resort hanno un problema. Fischia la marmotta, la mascotte del resort, non si è svegliata quest'inverno per prendersi cura del resort!"
    ],
    "fr": [
      "Les animaux de la station ont un problème. Sifflote la marmotte, la mascotte de la station ne s'est pas réveillée cet hiver pour veiller sur la station !"
    ],
    "es": [
      "Los animales de la estación tienen un problema. La mascota de la estación, la marmota Whistles, no se ha despertado este invierno para cuidar de la estación"
    ],
    "nl": [
      "De dieren van het skioord hebben een probleem. Sliflotte de marmot, de mascotte van het skioord, is niet wakker geworden uit zijn winterslaap om het skioord te bewaken!"
    ]
  },
