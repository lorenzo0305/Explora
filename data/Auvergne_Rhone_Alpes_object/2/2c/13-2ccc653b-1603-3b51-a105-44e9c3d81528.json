  "rdfs:comment": {
    "de": [
      "Past'a Lina, Foodtruck mit frischen, hausgemachten Nudeln in Maurienne!\r\nEntdecken Sie schmackhafte Nudeln, die mit 100 % hausgemachten, cremigen Soßen zubereitet werden und sofort verzehrfertig sind. Alles wird mit Leidenschaft zubereitet, um ein Gourmet-Erlebnis zu bieten."
    ],
    "en": [
      "Past'a Lina, fresh homemade pasta foodtruck in Maurienne!\r\nCome and discover tasty pasta prepared with creamy 100% homemade sauces, ready to eat. Everything is prepared with passion for a gourmet experience."
    ],
    "it": [
      "Past'a Lina, un foodtruck di pasta fresca fatta in casa nella Maurienne!\r\nVenite a scoprire la gustosa pasta preparata con cremosi sughi 100% fatti in casa, pronti da mangiare. Tutto è preparato con passione per un'esperienza gourmet."
    ],
    "fr": [
      "Past'a Lina, foodtruck de pâtes fraiches maison en Maurienne !\r\nVenez découvrir des pâtes savoureuses préparées avec des sauces onctueuses 100 % faites maison, prêtes à consommer. Tout est préparé avec passion pour proposer une expérience gourmande."
    ],
    "nl": [
      "Past'a Lina, een verse huisgemaakte pasta foodtruck in de Maurienne!\r\nKom en ontdek lekkere pasta bereid met romige 100% huisgemaakte sauzen, klaar om op te eten. Alles wordt met passie bereid voor een gastronomische ervaring."
    ],
    "es": [
      "Past'a Lina, ¡un foodtruck de pasta fresca casera en la Maurienne!\r\nVenga a descubrir sabrosas pastas preparadas con cremosas salsas 100% caseras, listas para comer. Todo se prepara con pasión para una experiencia gourmet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PAST'A LINA FOOD TRUCK"
    ]
  },
