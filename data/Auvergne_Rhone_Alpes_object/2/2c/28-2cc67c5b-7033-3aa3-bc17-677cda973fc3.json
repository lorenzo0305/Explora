  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6c19ccf7-50e6-349d-a5fb-18bb8eaadc39",
      "dc:description": {
        "de": [
          "Beef Corner, ein traditionelles Restaurant im Einkaufszentrum Val Halatte, bietet Ihnen eine abwechslungsreiche Speisekarte mit Grillspezialitäten, Burgern, Salaten und Tagesgerichten. Unser Team steht Ihnen gerne zur Verfügung und freut sich, Sie begrüßen zu dürfen."
        ],
        "en": [
          "Beef Corner, a traditional restaurant located in the Val Halatte shopping center, offers a varied menu of grilled meats, burgers, salads and daily specials. Industrial style, spacious and bright, our team is at your service and we look forward to welcoming you."
        ],
        "it": [
          "Il Beef Corner, ristorante tradizionale situato nel centro commerciale Val Halatte, offre un menu vario di grigliate, hamburger, insalate e specialità del giorno. In stile industriale, spazioso e luminoso, il nostro team sarà lieto di accogliervi."
        ],
        "fr": [
          "Beef Corner,restaurant traditionnel,  situé au Centre Commercial de Val Halatte, vous propose une carte variée, grillades, burgers, salades, plats du jour.. Style Industriel, espace spacieux, lumineux, notre équipe à votre écoute et nous aurons le plaisir de vous accueillir."
        ],
        "es": [
          "Beef Corner, restaurante tradicional situado en el centro comercial Val Halatte, ofrece una carta variada de parrilladas, hamburguesas, ensaladas y platos del día. De estilo industrial, amplio y luminoso, nuestro equipo estará encantado de recibirle."
        ],
        "nl": [
          "Beef Corner, een traditioneel restaurant in het winkelcentrum Val Halatte, biedt een gevarieerd menu van grillgerechten, hamburgers, salades en dagschotels. In industriële stijl, ruim en licht, zal ons team u met plezier verwelkomen."
        ]
      },
      "@type": [
        "Description"
      ],
