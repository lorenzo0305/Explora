  "rdfs:comment": {
    "de": [
      "Solange ist ein Feinschmeckerbistro, in dem es gemütlich zugeht. Die Küche ist großzügig und kreativ rund um lokale Produkte, wobei das Menü jede Woche wechselt."
    ],
    "en": [
      "Solange is a friendly, gourmet bistro. The cuisine is generous and creative, based on local produce, with a new menu every week."
    ],
    "it": [
      "Solange è un bistrot gourmet e accogliente. La cucina è generosa e creativa, basata su prodotti locali, con un menu nuovo ogni settimana."
    ],
    "fr": [
      "Solange est un bistrot gourmand et convivial. La cuisine se veut généreuse et créative autour de produits locaux, avec un changement de menu toutes les semaines."
    ],
    "nl": [
      "Solange is een vriendelijke bistro voor fijnproevers. De keuken is royaal en creatief, gebaseerd op lokale producten, met elke week een nieuw menu."
    ],
    "es": [
      "Solange es un bistró gastronómico acogedor. La cocina es generosa y creativa, basada en productos locales, con un menú nuevo cada semana."
    ]
