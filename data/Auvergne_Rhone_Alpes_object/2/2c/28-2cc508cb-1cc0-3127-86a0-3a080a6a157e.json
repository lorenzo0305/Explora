  "rdfs:comment": {
    "de": [
      "Picknickplatz mit zwei Tischen in einer bukolischen Umgebung, auf einer grasbewachsenen und schattigen Fläche, in der Nähe der Kapelle Dieu de Pitié, an der Kreuzung von 7 Wegen. Petanque-Platz."
    ],
    "en": [
      "Picnic area with two tables in a bucolic setting, on a grassy and shaded area, near the Chapel of the God of Pity, at the crossroads of 7 paths. Ground of game of bowls."
    ],
    "it": [
      "Area picnic con due tavoli in un ambiente bucolico, su un'area erbosa e ombreggiata, vicino alla Chapelle du Dieu de Pitié, all'incrocio di 7 sentieri. Campo da petanque."
    ],
    "fr": [
      "Aire de pique-nique aménagée de deux tables dans un cadre bucolique, sur un espace enherbé et ombragé, à proximité de la Chapelle du Dieu de Pitié, au carrefour de 7 chemins. Terrain de pétanque."
    ],
    "es": [
      "Área de picnic con dos mesas en un entorno bucólico, en una zona de hierba y sombra, cerca de la Chapelle du Dieu de Pitié, en el cruce de 7 caminos. Campo de petanca."
    ],
    "nl": [
      "Picknickplaats met twee tafels in een bucolische omgeving, op een grasveld en in de schaduw, vlakbij de Chapelle du Dieu de Pitié, op het kruispunt van 7 paden. Petanque veld."
    ]
  },
  "rdfs:label": {
