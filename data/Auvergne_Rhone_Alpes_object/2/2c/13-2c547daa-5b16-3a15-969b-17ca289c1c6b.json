  "rdfs:comment": {
    "de": [
      "Hoch oben auf dem Plateau von Beauregard gelegen, bietet das Le Grizzly ein außergewöhnliches Panorama und eine große Sonnenterrasse, die im Winter wie im Sommer Sonne spendet.\r\nFrische und lokale Produkte, zubereitet von Küchenchef Édouard Loubet und seinem Team."
    ],
    "en": [
      "Perched on the Beauregard plateau, the Grizzly offers an exceptional panorama and a large sunny terrace, in winter as in summer.\r\nFresh and local products, cooked by chef Édouard Loubet and his team."
    ],
    "it": [
      "Arroccato sull'altopiano di Beauregard, Le Grizzly offre una vista panoramica eccezionale e un'ampia terrazza soleggiata, sia in inverno che in estate.\r\nProdotti freschi e locali cucinati dallo chef Édouard Loubet e dal suo team."
    ],
    "fr": [
      "Perché sur le plateau de Beauregard, le Grizzly offre un panorama exceptionnel et une grande terrasse ensoleillée, l'hiver comme l'été.\r\nProduits frais et locaux, cuisinés par le chef Édouard Loubet et son équipe."
    ],
    "nl": [
      "Le Grizzly ligt op het plateau van Beauregard en biedt een uitzonderlijk panoramisch uitzicht en een groot zonneterras, zowel in de winter als in de zomer.\r\nVerse, lokale producten bereid door chef-kok Édouard Loubet en zijn team."
    ],
    "es": [
      "Encaramado en la meseta de Beauregard, Le Grizzly ofrece unas vistas panorámicas excepcionales y una gran terraza soleada, tanto en invierno como en verano.\r\nProductos frescos y locales cocinados por el chef Édouard Loubet y su equipo."
    ]
  },
