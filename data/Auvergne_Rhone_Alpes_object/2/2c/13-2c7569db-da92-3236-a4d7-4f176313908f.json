  "rdfs:comment": {
    "de": [
      "Der Port de l'Épervière ist einer der wichtigsten Flussmarinas in Frankreich. Von diesem Ort aus können Sie in die Geschichte der Rhône, der Schifffahrt, der Häfen und Brücken von Valence eintauchen."
    ],
    "en": [
      "The Port de l'Épervière is one of the most important river marinas in France. Immerse yourself in the history of the Rhône, navigation and Valence?s ports and bridges."
    ],
    "it": [
      "Il Port de l'Épervière è uno dei più grandi porti turistici fluviali della Francia. Da questa destinazione turistica, potrete immergervi nella storia del Rodano, della navigazione e dei porti e ponti di Valence."
    ],
    "fr": [
      "Le port de l’Épervière est un des ports de plaisance fluviaux les plus importants de France. Depuis ce lieu de villégiature, plongez dans l’histoire du Rhône, de la navigation, des ports et ponts de Valence."
    ],
    "es": [
      "El Port de l'Épervière es uno de los puertos fluviales más grandes de Francia. Desde este destino de vacaciones, podrá sumergirse en la historia del Ródano, la navegación y los puertos y puentes de Valence."
    ],
    "nl": [
      "De Port de l'Épervière is een van de grootste rivierhavens van Frankrijk. Vanuit deze vakantiebestemming kun je je verdiepen in de geschiedenis van de Rhône, de scheepvaart en de havens en bruggen van Valence."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Le port de l'Epervière"
    ]
  },
