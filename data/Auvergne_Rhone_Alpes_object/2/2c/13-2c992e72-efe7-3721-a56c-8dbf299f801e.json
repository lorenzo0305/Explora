  "rdfs:comment": {
    "de": [
      "Ehemaliger Wohnsitz der Herren von Bongain, deren Familienwappen einst auf den Fenstern der Kirche Saint-Gervais zu sehen gewesen sein soll, was von ihrer lokalen Macht zeugt."
    ],
    "en": [
      "Former home of the Lords of Bongain, whose family's coat of arms once appeared in the stained glass windows of the church of Saint-Gervais, attesting to its local power."
    ],
    "it": [
      "Antica dimora dei Signori di Bongain, il cui stemma di famiglia compariva un tempo nelle vetrate della chiesa di Saint-Gervais, a testimonianza del suo potere locale."
    ],
    "fr": [
      "Ancienne demeure des seigneurs de Bongain, dont les armes de la famille auraient figuré autrefois sur les vitraux de l'église de Saint-Gervais attestant de sa puissance locale."
    ],
    "nl": [
      "Voormalig huis van de Heren van Bongain, wiens familiewapen ooit in de gebrandschilderde ramen van de kerk van Saint-Gervais prijkte, wat getuigt van de plaatselijke macht."
    ],
    "es": [
      "Antigua residencia de los señores de Bongain, cuyo escudo familiar figuraba en las vidrieras de la iglesia de Saint-Gervais, testimonio de su poder local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ruines de la Tour de Bongain"
    ]
  },
