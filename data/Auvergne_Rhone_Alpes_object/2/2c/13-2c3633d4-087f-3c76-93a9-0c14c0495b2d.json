  "rdfs:comment": {
    "de": [
      "Comics, Mangas, Dokumente, Romane für Erwachsene und Jugendliche.\r\nAnmeldung gültig für ein Jahr, von Datum zu Datum, unabhängig von Ihrer Wohngemeinde. Ausleihe von bis zu 5 Büchern gegen Vorlage der Karte, für 4 Wochen (Verlängerung möglich)."
    ],
    "en": [
      "Comics, manga, documents, novels for adults and young people\r\nRegistration valid for one year, from date to date, whatever your commune of residence. Borrow up to 5 books on presentation of the card, for 4 weeks (extension possible)."
    ],
    "it": [
      "Fumetti, manga, documenti, romanzi per adulti e giovani.\r\nIscrizione valida per un anno, da data a data, indipendentemente dal luogo di residenza. Prestito di un massimo di 5 libri su presentazione della tessera, per 4 settimane (possibilità di proroga)."
    ],
    "fr": [
      "BD, mangas, documents, romans pour adultes et jeunes. \r\nInscription valable un an, de date à date, quelle que soit votre commune de résidence. Emprunt jusqu'à 5 livres sur présentation de la carte, pour 4 semaines (prolongation possible)."
    ],
    "nl": [
      "Strips, manga's, documenten, romans voor volwassenen en jongeren.\r\nRegistratie geldig voor een jaar, van datum tot datum, ongeacht waar je woont. Leen tot 5 boeken op vertoon van de kaart, voor 4 weken (verlenging mogelijk)."
    ],
    "es": [
      "Cómics, mangas, documentos, novelas para adultos y jóvenes.\r\nInscripción válida durante un año, de fecha a fecha, independientemente del lugar de residencia. Préstamo de hasta 5 libros previa presentación del carné, durante 4 semanas (posibilidad de prórroga)."
    ]
  },
