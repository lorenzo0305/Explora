  "rdfs:comment": {
    "de": [
      "Eklo bietet Ihnen eine 100% hausgemachte Saisonkarte, Pizzas, Salate und nicht zu vergessen die Wurst- und Käseplatten aus der Auvergne, die Sie mit anderen teilen können.\r\nEine gemütliche Designadresse für die Einwohner von Clermont-Ferrand, aber auch für die Gäste des Hotels."
    ],
    "en": [
      "Eklo offers a 100% homemade seasonal menu, including pizzas, salads and delicious desserts.\r\nA warm, designer address for Clermont-Ferrand residents and hotel guests alike."
    ],
    "it": [
      "Eklo offre un menu stagionale 100% casalingo, pizze e insalate, senza dimenticare i taglieri di salumi e formaggi d'Alvernia da condividere.\r\nÈ un luogo caldo ed elegante per i residenti di Clermont-Ferrand e per gli ospiti dell'hotel."
    ],
    "fr": [
      "Eklo vous propose une carte de saison 100% maison, pizzas, salades sans oublier les planches de charcuteries et fromages d'Auvergne à partager.\r\nUne adresse design et chaleureuse pour les habitants de Clermont-Ferrand mais aussi les clients de l’hôtel."
    ],
    "es": [
      "Eklo ofrece una carta de temporada 100% casera, pizzas y ensaladas, sin olvidar las tablas de embutidos y quesos de Auvernia para compartir.\r\nUn lugar cálido y elegante para los habitantes de Clermont-Ferrand y los clientes del hotel."
    ],
    "nl": [
      "Eklo biedt een 100% huisgemaakt seizoensmenu, pizza's en salades, en niet te vergeten schalen met vleeswaren en kazen uit de Auvergne om te delen.\r\nHet is een warme, stijlvolle plek voor zowel inwoners van Clermont-Ferrand als hotelgasten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Eklo Clermont-Ferrand"
    ]
  },
