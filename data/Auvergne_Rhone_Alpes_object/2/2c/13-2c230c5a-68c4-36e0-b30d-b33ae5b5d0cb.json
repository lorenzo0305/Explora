  "rdfs:comment": {
    "de": [
      "Das MJC ist ein Ort, der für alle von 3 bis 99 Jahren offen ist, wo jeder seinen Platz finden und sein kollektives oder individuelles Projekt aufbauen kann."
    ],
    "en": [
      "The MJC is a place open to all, from 3 to 99 years old, where everyone can find their place and build their own collective or individual project."
    ],
    "it": [
      "Il MJC è un luogo aperto a tutti, dai 3 ai 99 anni, dove ognuno può trovare il proprio posto e costruire il proprio progetto collettivo o individuale."
    ],
    "fr": [
      "La MJC est un lieu ouvert à tous de 3 à 99 ans où chacun peut trouver sa place et construire son projet collectif ou individuel."
    ],
    "nl": [
      "Het MJC is een plek die openstaat voor iedereen, van 3 tot 99 jaar, waar iedereen zijn plek kan vinden en kan bouwen aan zijn eigen collectieve of individuele project."
    ],
    "es": [
      "El MJC es un lugar abierto a todos, de 3 a 99 años, donde cada uno puede encontrar su lugar y construir su propio proyecto colectivo o individual."
    ]
  },
