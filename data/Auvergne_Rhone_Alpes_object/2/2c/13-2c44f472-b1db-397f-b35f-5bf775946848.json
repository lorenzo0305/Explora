  "rdfs:comment": {
    "de": [
      "Die Bibliothek steht allen Bürgern von Biviérois und Personen, die nicht in der Gemeinde wohnen, offen. Es gibt eine große Auswahl an 12000 Büchern: Romane, Kriminalromane, Comics und Mangas für Erwachsene und Kinder."
    ],
    "en": [
      "The library is open to all residents of Biviers and to people who do not live in the commune. A wide choice of 12,000 books is on offer: novels, detective stories, comics and manga for adults and children."
    ],
    "it": [
      "La biblioteca è aperta a tutti i residenti di Biviers e alle persone che non vivono nel comune. La biblioteca offre un'ampia scelta di 12.000 libri, tra cui romanzi, gialli, fumetti e manga per adulti e bambini."
    ],
    "fr": [
      "La bibliothèque est ouverte à tous les Biviérois et aux personnes qui ne résident pas sur la commune. Un large choix de 12000 livres, vous est proposé : romans, romans policiers, bandes-dessinées et mangas pour adultes et enfants."
    ],
    "es": [
      "La biblioteca está abierta a todos los habitantes de Biviers y a las personas que no viven en el municipio. Dispone de una amplia selección de 12.000 libros, entre novelas, novelas policíacas, cómics y manga para adultos y niños."
    ],
    "nl": [
      "De bibliotheek is toegankelijk voor alle inwoners van Biviers en voor mensen die niet in de gemeente wonen. Er is een ruime keuze uit 12.000 boeken, waaronder romans, detectiveverhalen, strips en manga voor volwassenen en kinderen."
    ]
  },
