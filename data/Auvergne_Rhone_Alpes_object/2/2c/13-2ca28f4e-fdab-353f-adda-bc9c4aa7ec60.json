  "rdfs:comment": {
    "de": [
      "Der kleine Saal des Louis ist ein magischer, intimer und gemütlicher Ort. Er befindet sich im Gewölbekeller eines alten Hauses in der Impasse du Louis XI mit geschichtsträchtiger Vergangenheit und beherbergt eine Saison von Aufführungen."
    ],
    "en": [
      "A magical, intimate and warm venue, the small Salle du Louis is housed in the vaulted cellar of an old house in the historic Impasse du Louis XI, and hosts a season of shows."
    ],
    "it": [
      "Luogo magico, intimo e caldo, la piccola sala Louis è ospitata nella cantina a volta di un'antica casa situata nell'impasse della Louis XI, ricca di storia, e ospita una stagione di spettacoli."
    ],
    "fr": [
      "Lieu magique, intimiste et chaleureux, la petite salle du Louis est aménagée dans la cave voûtée d'une vieille maison située dans l'impasse du Louis XI au passé chargé d'histoire, elle accueille une saison de spectacles."
    ],
    "es": [
      "Lugar mágico, íntimo y cálido, la pequeña sala Louis se encuentra en el sótano abovedado de una antigua casa situada en el callejón sin salida de Louis XI, cargada de historia, y acoge una temporada de espectáculos."
    ],
    "nl": [
      "De kleine Salle du Louis is een magische, intieme en warme locatie, gehuisvest in de gewelfde kelder van een oud huis in de historische Impasse du Louis XI, waar een seizoen lang voorstellingen worden gegeven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Louis XI"
    ]
  },
