  "rdfs:comment": {
    "de": [
      "Nur wenige hundert Meter von La Neylière entfernt liegt das Schloss Pluvy, das südlichste Schloss des Gemeindegebiets an der Grenze zu Saint-Symphorien-sur-Coise."
    ],
    "en": [
      "Just a few hundred meters from La Neylière is Château de Pluvy, the southernmost castle in the commune, on the Saint-Symphorien-sur-Coise border."
    ],
    "it": [
      "A poche centinaia di metri da La Neylière si trova Château de Pluvy, il castello più meridionale del comune, ai confini con Saint-Symphorien-sur-Coise."
    ],
    "fr": [
      "A quelques centaines de mètres seulement de la Neylière se trouve le château de Pluvy, le plus au Sud du territoire communal, sur les limites de Saint-Symphorien-sur-Coise."
    ],
    "nl": [
      "Op een paar honderd meter van La Neylière ligt Château de Pluvy, het meest zuidelijke kasteel van de gemeente, aan de rand van Saint-Symphorien-sur-Coise."
    ],
    "es": [
      "A unos cientos de metros de La Neylière se encuentra el castillo de Pluvy, el más meridional del municipio, en los límites con Saint-Symphorien-sur-Coise."
    ]
  },
