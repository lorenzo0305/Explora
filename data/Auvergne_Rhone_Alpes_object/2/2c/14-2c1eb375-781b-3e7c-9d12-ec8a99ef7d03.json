  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6cd45bb1-248e-3b9e-85f2-55c0277313dd",
      "dc:description": {
        "de": [
          "Informationen :\n\nBestellungen:\nMöglichkeit, über die Website zu bestellen\nBezahlung von Bestellungen über die Website\n\nAbholung:\nBei Lieferung\n\nLieferung:\nMöglichkeit der Hauslieferung in Bapaume und Umgebung und kostenloser Postversand in andere Departements.\n\nFür weitere Informationen kontaktieren Sie bitte den Laden über facebook als private Nachricht.\n\n "
        ],
        "en": [
          "Information :\n\nOrdering:\nPossibility to order on the website\nPayment of orders via the website\n\nCollection :\nOn delivery\n\nDelivery:\nHome delivery available in Bapaume and surrounding areas, and free postal delivery for other departments.\n\nFor further information, please contact the store via facebook in private message.\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nOrdini:\nGli ordini possono essere effettuati tramite il sito web\nPagamento degli ordini tramite il sito web\n\nRitiro :\nAlla consegna\n\nConsegne:\nConsegna a domicilio disponibile a Bapaume e dintorni e consegna postale gratuita per gli altri dipartimenti.\n\nPer ulteriori informazioni, contattare il negozio via facebook in messaggio privato.\n\n "
        ],
        "fr": [
          "Informations :\n\nCommandes:\nPossibilité de commander sur le site internet\nPaiement des commandes via le site internet\n\nRetrait :\nEn livraison\n\nLivraison: \nPossibilité de livrer à domicile sur Bapaume et ses alentours et envois postaux gratuits pour les autres départements.\n\nPour toute information complémentaire, veuillez contacter le magasin via facebook en message privé.\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nBestellen:\nBestellen kan via de website\nBetaling van bestellingen via de website\n\nAfhalen :\nBij levering\n\nLeveringen:\nThuisbezorging mogelijk in Bapaume en omgeving en gratis postbezorging voor andere departementen.\n\nNeem voor meer informatie contact op met de winkel via facebook in een privébericht.\n\n "
        ],
        "es": [
          "Más información :\n\nPedidos:\nLos pedidos pueden realizarse a través del sitio web\nPago de pedidos a través del sitio web\n\nRecogida :\nA la entrega\n\nServicio de entrega:\nEntrega a domicilio disponible en Bapaume y alrededores y entrega postal gratuita para otros departamentos.\n\nPara más información, póngase en contacto con la tienda a través de facebook en mensaje privado.\n\n "
        ]
      },
