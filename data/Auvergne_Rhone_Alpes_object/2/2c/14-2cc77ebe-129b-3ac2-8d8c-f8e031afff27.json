      "@id": "https://data.datatourisme.fr/72da88ff-befc-35df-8267-0a76937e9296",
      "dc:description": {
        "de": [
          "Der Cyclo-Bulle bietet mit seinen riesigen Seifenblasen, die Groß und Klein in Staunen versetzen, einen Moment der Flucht aus dem Alltag im Museumspark."
        ],
        "en": [
          "The Cyclo-bulle offers a moment of escape in the museum park, with its giant bubbles that will amaze young and old alike."
        ],
        "it": [
          "Il Cyclo-bulle offre un momento di evasione nel parco del museo con le sue bolle giganti che stupiranno grandi e piccini."
        ],
        "fr": [
          "Le Cyclo-bulle propose un moment d’évasion dans le parc du musée avec ses bulles géantes qui émerveilleront petits et grands."
        ],
        "es": [
          "El Cyclo-bulle ofrece un momento de evasión en el recinto del museo con sus burbujas gigantes que asombrarán a grandes y pequeños."
        ],
        "nl": [
          "De Cyclo-bulle biedt een moment van ontsnapping op het museumterrein met zijn gigantische bellen die jong en oud zullen verbazen."
        ]
      },
