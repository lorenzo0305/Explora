  "rdfs:comment": {
    "de": [
      "Das ebenerdige Hotel bietet funktionale Zimmer, die sich zur Landschaft oder zum Garten hin öffnen. Traditionelle, aktualisierte Küche, die in einem modernen Dekor serviert wird."
    ],
    "en": [
      "The single-storey hotel offers functional rooms open onto the countryside or the garden. Updated traditional cuisine served in a modern decor."
    ],
    "it": [
      "L'hotel a un piano offre camere funzionali con vista sulla campagna o sul giardino. Cucina tradizionale aggiornata servita in un ambiente moderno."
    ],
    "fr": [
      "L'hôtel de plain-pied propose des chambres fonctionnelles ouvertes sur la campagne ou le jardin. Cuisine traditionnelle actualisée servie dans un décor moderne."
    ],
    "nl": [
      "Het gelijkvloerse hotel biedt functionele kamers met uitzicht op het platteland of de tuin. Bijgewerkte traditionele keuken geserveerd in een moderne omgeving."
    ],
    "es": [
      "Este hotel de una sola planta ofrece habitaciones funcionales con vistas al campo o al jardín. Cocina tradicional actualizada servida en un entorno moderno."
    ]
  },
