  "rdfs:comment": {
    "de": [
      "Unsere Region vor den Toren der Sonne. Der von seinen mediterranen Kindheitserinnerungen geprägte Küchenchef Clement Lorente bietet eine moderne, einfallsreiche und gastronomische Küche."
    ],
    "en": [
      "Our terroir at the gateway to the sun, chef Clement Lorente, imbued with his childhood memories of the Mediterranean, offers a modern, inventive and gastronomic cuisine."
    ],
    "it": [
      "La nostra terra alle porte del sole, lo chef Clement Lorente, impregnato dei suoi ricordi d'infanzia del Mediterraneo, propone una cucina moderna, inventiva e gastronomica."
    ],
    "fr": [
      "Notre terroir aux portes du soleil, le chef Clement Lorente empreint de ses souvenirs d'enfance méditerranéens propose une cuisine moderne, inventive et gastronomique."
    ],
    "nl": [
      "Ons land aan de poorten van de zon, de chef-kok Clement Lorente, doordrongen van zijn jeugdherinneringen aan de Middellandse Zee, biedt een moderne, inventieve en gastronomische keuken."
    ],
    "es": [
      "Nuestra tierra a las puertas del sol, el chef Clement Lorente, imbuido de sus recuerdos de infancia en el Mediterráneo, ofrece una cocina moderna, inventiva y gastronómica."
    ]
  },
  "rdfs:label": {
