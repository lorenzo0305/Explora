  "rdfs:comment": {
    "de": [
      "Ich lebe seit 20 Jahren im Herzen des Naturparks Vercors und lade Sie ein, dieses außergewöhnliche Gebiet mit seiner unberührten Natur und seiner faszinierenden Geschichte zu entdecken."
    ],
    "en": [
      "Settled in the heart of the Vercors Natural Park for 20 years, I invite you to discover this exceptional territory, its unspoilt nature and fascinating history."
    ],
    "it": [
      "Avendo vissuto per 20 anni nel cuore del Parco Naturale del Vercors, vi invito a scoprire questa regione eccezionale, la sua natura incontaminata e la sua storia affascinante."
    ],
    "fr": [
      "Installé depuis 20 ans au cœur du Parc naturel du Vercors, je vous invite à découvrir ce territoire d’exception, sa nature préservée et son histoire fascinante."
    ],
    "es": [
      "Tras 20 años viviendo en el corazón del Parque Natural de Vercors, le invito a descubrir esta región excepcional, su naturaleza intacta y su fascinante historia."
    ],
    "nl": [
      "Ik heb 20 jaar in het hart van het natuurpark van de Vercors gewoond en nodig je uit om deze uitzonderlijke streek, zijn ongerepte natuur en fascinerende geschiedenis te ontdekken."
    ]
  },
  "rdfs:label": {
