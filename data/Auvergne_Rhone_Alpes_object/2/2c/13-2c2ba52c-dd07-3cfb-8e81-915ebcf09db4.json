  "rdfs:comment": {
    "de": [
      "Auswahl an offenen Weinen und lokalen Bieren, mehr als 400 Referenzen von Weinen zu Weinhandelspreisen, schöne Terrasse an sonnigen Tagen! Privatisierung für Veranstaltungen möglich. We speak English!"
    ],
    "en": [
      "Selection of wines and local beers by the glass, plus 400 wine products at vineyard prices, and a lovely terrace for lovely days! Cellar available for private functions. We speak English!"
    ],
    "it": [
      "Ô Vins seleziona le migliori tenute e viticoltori di tutta la Francia e della Corsica, in particolare i vini di Grignan-les-Adhémar, oltre a prodotti locali e artigianali per i vostri pasti."
    ],
    "fr": [
      "Ô Vins sélectionne pour vous les meilleurs domaines et viticulteurs de toute la France et de Corse, en particulier les vins de Grignan-les-Adhémar ainsi que des produits locaux et artisanaux pour vous restaurer."
    ],
    "es": [
      "Ô Vins selecciona las mejores fincas y viticultores de toda Francia y Córcega, en particular los vinos de Grignan-les-Adhémar, así como productos locales y artesanales para sus comidas."
    ],
    "nl": [
      "Selectie van wijnen (per glas) en lokale bieren, meer dan 400 referenties aangeboden voor wijnwinkelprijzen, heerlijk terras bij mooi weer! Mogelijkheid om de kelder te huren voor uw evenementen. Wij spreken Engels!"
    ]
  },
