  "rdfs:comment": {
    "de": [
      "Kommen Sie zu Mamie Bigoude und probieren Sie unsere Buchweizengaletten und süßen Crêpes, oder stellen Sie sie sich selbst zusammen! Das Ganze in einem untypischen Rahmen mit schräger Dekoration, mitten in der mittelalterlichen Stadt Montluçon."
    ],
    "en": [
      "Come to Mamie Bigoude and enjoy our buckwheat pancakes and sweet crepes, or make your own! All in an unusual, offbeat setting right in the heart of the medieval town of Montluçon."
    ],
    "it": [
      "Venite da Mamie Bigoude e provate le nostre frittelle di grano saraceno e le nostre crêpes dolci, o preparatele voi stessi! Il tutto in un ambiente insolito con un arredamento eccentrico, proprio nel cuore della città medievale di Montluçon."
    ],
    "fr": [
      "Venez chez Mamie Bigoude déguster nos galettes au sarrasin et nos crêpes sucrées, ou bien composez-les vous-mêmes ! le tout dans un cadre atypique à la décoration décalée, en plain cœur de la cité médiévale de Montluçon."
    ],
    "es": [
      "Venga a Mamie Bigoude y pruebe nuestras tortitas de trigo sarraceno y crêpes dulces, ¡o prepárese las suyas propias! Todo ello en un marco insólito y con una decoración estrafalaria, en pleno corazón de la ciudad medieval de Montluçon."
    ],
    "nl": [
      "Kom naar Mamie Bigoude en probeer onze boekweitpannenkoeken en zoete crêpes, of maak je eigen crêpes! Dit alles in een ongewone omgeving met een eigenzinnig decor, in het hart van de middeleeuwse stad Montluçon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le comptoir de Mamie Bigoude"
    ]
  },
