  "rdfs:comment": {
    "de": [
      "Mc Donald's Restaurant mit einem schönen klimatisierten Saal, einer Salatbar, einem McCafé, WLAN, einer großen Terrasse mit Blick auf den Vercors, einem riesigen Spielplatz mit Doppelrutsche und Mc Drive (Bedienung am Steuer)."
    ],
    "en": [
      "Mc Donald's restaurant offers a nice air conditioned room with modern and colorful decoration, a large terrace with a nice view of the Vercors, a playground with double slide and the Mc Drive."
    ],
    "it": [
      "Ristorante Mc Donald's con una bella sala climatizzata, un Salad Bar, un McCafé, accesso Wifi, una grande terrazza con vista sul Vercors, un parco giochi gigante con doppio scivolo e il Mc Drive (servizio drive-through)."
    ],
    "fr": [
      "Restaurant Mc Donald's disposant d'une belle salle climatisée, d’un Salad Bar, d'un McCafé, d’un accès Wifi,  d'une grande terrasse avec vue sur le Vercors, d'une aire de jeu géante avec double toboggan, et du Mc Drive (service au volant)."
    ],
    "es": [
      "Restaurante Mc Donald's con una bonita sala climatizada, un Salad Bar, un McCafé, acceso Wifi, una gran terraza con vistas al Vercors, un parque infantil gigante con tobogán doble y el Mc Drive (servicio de drive-through)."
    ],
    "nl": [
      "Mc Donald's restaurant met een mooie eetzaal met airconditioning, een saladebar, een McCafé, wifi-toegang, een groot terras met uitzicht op de Vercors, een gigantische speelruimte met een dubbele glijbaan en Mc Drive (drive-through service)."
    ]
  },
