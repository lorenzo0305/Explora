  "rdfs:comment": {
    "de": [
      "Nach Vereinbarung können Sie meine Werkstatt besuchen, in der ich Figuren als Einzelstücke herstelle: in verschiedenen Größen, aus Raku-Brand, sie sind für den Innenbereich gedacht!"
    ],
    "en": [
      "By appointment, you can visit my workshop where I create one-of-a-kind characters: in different sizes, in Raku firing, they are designed for indoor use!"
    ],
    "it": [
      "Su appuntamento, è possibile visitare il mio laboratorio dove creo figure uniche: di diverse dimensioni, cotte in Raku, sono pensate per gli interni!"
    ],
    "fr": [
      "Sur rendez-vous, vous pourrez visiter mon atelier de création de personnages en pièce unique : de différentes tailles, en cuisson Raku, ils sont conçus pour l'intérieur !"
    ],
    "nl": [
      "Op afspraak kunt u mijn atelier bezoeken waar ik one-of-a-kind figuren maak: in verschillende maten, gebakken in Raku, ze zijn ontworpen voor het interieur!"
    ],
    "es": [
      "Con cita previa, puede visitar mi taller donde creo figuras únicas: en diferentes tamaños, cocidas en Raku, ¡están diseñadas para el interior!"
    ]
  },
