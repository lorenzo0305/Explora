  "rdfs:comment": {
    "de": [
      "Die Helden treffen sich am 6. und 7. Juni in Grenoble zur Episode 8 des HeroFestivals: zwei Tage, die den Comics, Mangas, Comics, Serien, Filmen, Videospielen, Cosplay, Musik... gewidmet sind."
    ],
    "en": [
      "Heroes meet up in Grenoble on June 6th & 7th for episode 8 of the HeroFestival: 2 days dedicated to comics, Mangas, Comics, Series, Movies, Video Games, Cosplay, Music... ."
    ],
    "it": [
      "Gli eroi arriveranno a Grenoble il 6 e 7 giugno per l'ottavo episodio dell'HeroFestival: 2 giorni dedicati a fumetti, manga, comics, serie, cinema, videogiochi, cosplay, musica, ecc."
    ],
    "fr": [
      "Les Héros vous donnent rendez-vous à Grenoble les 6 & 7 juin prochains pour l’épisode 8 du HeroFestival : 2 jours dédiés aux BD, Mangas, Comics, Séries, Cinéma, Jeux Vidéo, Cosplay, Musique.. ."
    ],
    "es": [
      "Los héroes llegan a Grenoble los días 6 y 7 de junio para el episodio 8 del HeroFestival: 2 días dedicados al cómic, manga, tebeos, series, cine, videojuegos, cosplay, música, etc."
    ],
    "nl": [
