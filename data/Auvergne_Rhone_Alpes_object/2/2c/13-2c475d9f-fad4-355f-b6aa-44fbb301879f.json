  "rdfs:comment": {
    "de": [
      "In Saint-Victor-sur-Loire gibt es einen Ort, an dem es richtig zur Sache geht: das Restaurant-Ginguette Victor. Hier oben, mit Blick auf die Loire-Schlucht, ist das Panorama, das Ihnen direkt Lust auf eine Auszeit macht."
    ],
    "en": [
      "À Saint-Victor-sur-Loire, il y a un spot qui envoie du lourd : le Restaurant-guinguette Victor. Là-haut, avec vue plongeante sur les Gorges de la Loire, c'est le panorama qui vous donne direct des envies d’évasion."
    ],
    "it": [
      "A Saint-Victor-sur-Loire, c'è un luogo che sicuramente vi farà scatenare: il Restaurant-guinguette Victor. Lassù, con una vista a volo d'uccello sulle Gorges de la Loire, è un panorama che vi farà venire voglia di staccare la spina."
    ],
    "fr": [
      "À Saint-Victor-sur-Loire, il y a un spot qui envoie du lourd : le Restaurant-guinguette Victor. Là-haut, avec vue plongeante sur les Gorges de la Loire, c'est le panorama qui vous donne direct des envies d’évasion."
    ],
    "nl": [
      "In Saint-Victor-sur-Loire is er één plek die je zeker in beweging brengt: het Restaurant-guinguette Victor. Daarboven, met uitzicht in vogelvlucht op de Gorges de la Loire, is het een panorama waar je helemaal weg van wilt zijn."
    ],
    "es": [
      "En Saint-Victor-sur-Loire, hay un lugar que le entusiasmará: el Restaurante-guinguette Victor. En lo alto, a vista de pájaro, las Gargantas del Loira ofrecen un panorama que te hará querer evadirte de todo."
    ]
  },
  "rdfs:label": {
