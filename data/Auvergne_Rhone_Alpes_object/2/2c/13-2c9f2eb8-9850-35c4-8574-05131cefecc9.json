  "rdfs:comment": {
    "de": [
      "Lla street-food 100 % hausgemacht! Hausgemachte Burger, Tartar, Wurst- und Käsebretter, saisonale und vegetarische Gerichte, hausgemachte Desserts und frische Pommes frites. Fleisch aus Aubrac, lokale Produkte, handwerklich hergestellte Biere. Privatisieren Sie uns für Ihre Veranstaltungen!"
    ],
    "en": [
      "100% homemade street-food! Homemade burgers, tartars, charcuterie and cheese boards, seasonal and vegetarian dishes, homemade desserts and fresh French fries. Aubrac meats, local produce, craft beers. Book us for your events!"
    ],
    "it": [
      "Cibo di strada 100% fatto in casa! Hamburger fatti in casa, tartara, taglieri di salumi e formaggi, piatti stagionali e vegetariani, dolci fatti in casa e patatine fritte fresche. Carni di Aubrac, prodotti locali, birre artigianali. Prenotateci per i vostri eventi!"
    ],
    "fr": [
      "La street-food 100 % maison ! Burgers maison, tartares, planches de charcuterie et fromages, plats de saison, végétariens, desserts maison et frites fraîches. Viandes d’Aubrac, produits locaux, bières artisanales. Privatisez-nous pour vos événements !"
    ],
    "es": [
      "¡Comida callejera 100% casera! Hamburguesas caseras, tartares, tablas de embutidos y quesos, platos de temporada y vegetarianos, postres caseros y patatas fritas frescas. Carnes de Aubrac, productos locales, cervezas artesanas. ¡Resérvanos para tus eventos!"
    ],
    "nl": [
      "100% huisgemaakt streetfood! Huisgemaakte hamburgers, tartaars, charcuterie en kaasplankjes, seizoensgebonden en vegetarische gerechten, huisgemaakte desserts en verse friet. Aubrac vlees, lokale producten, ambachtelijke bieren. Boek ons voor uw evenementen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "O' Daily Truck"
    ]
  },
