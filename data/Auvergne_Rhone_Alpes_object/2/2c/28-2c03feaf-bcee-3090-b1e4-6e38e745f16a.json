      "rdfs:comment": {
        "de": [
          "Entdeckung des Melkens in Vignacourt.\nBesichtigung des Unternehmens, Demonstration der verschiedenen Herstellungsschritte.\nBildhauerei. Ausstellung.\nGeschichte des Unternehmens mit Fotos der Arbeit und Material aus der damaligen Zeit."
        ],
        "en": [
          "Discovery of the Vignacourt trade.\nVisit of the company, demonstration of the different stages of production.\nSculpture. Exhibition.\nHistory of the company with photos of the work and period equipment."
        ],
        "it": [
          "Scoperta dell'impianto di mungitura di Vignacourt.\nVisita dell'azienda, dimostrazione delle diverse fasi di produzione.\nScultura. Mostra.\nStoria dell'azienda con foto dei lavori e delle attrezzature d'epoca."
        ],
        "fr": [
          "Découverte de la traite de Vignacourt.\nVisite de l'entreprise, démonstration des différentes étapes de fabrication.\nSculpture. Exposition.\nHistorique de l'entreprise avec photos du travail et matériel d'époque."
        ],
        "nl": [
          "Ontdekking van de melkfabriek van Vignacourt.\nBezoek aan het bedrijf, demonstratie van de verschillende productiestadia.\nSculptuur. Tentoonstelling.\nGeschiedenis van het bedrijf met foto's van het werk en de apparatuur uit die tijd."
        ],
        "es": [
          "Descubrimiento de la planta de ordeño de Vignacourt.\nVisita a la empresa, demostración de las diferentes etapas de producción.\nEscultura. Exposición.\nHistoria de la empresa con fotos de la obra y del equipamiento de la época."
        ]
      },
