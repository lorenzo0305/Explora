  "rdfs:comment": {
    "de": [
      "Geschenkboutique, darunter Schmuck, Lederwaren, Accessoires, Kleidung, Kerzen, Täschchen. Ein Bereich für Geburtsgeschenke und Spiele.\r\nHerstellung von Schmuck und Dekorationen aus Origami. Einzelunterricht oder Workshops für die ganze Familie rund um Origami."
    ],
    "en": [
      "Boutique selling decorative  gifts for various occasions.  Origami jewellery creations."
    ],
    "it": [
      "Negozio di articoli da regalo che comprende gioielli, pelletteria, accessori, vestiti, candele, borse. Area giochi e regali per bambini.\r\nGioielli e decorazioni di origami. Corsi individuali o laboratori per famiglie sugli origami."
    ],
    "fr": [
      "Boutique cadeaux dont bijoux, maroquinerie, accessoires, vêtements, bougies, pochettes. Un espace cadeaux naissance et jeux. \r\nCréation de bijoux et de décorations en Origami. Cours individuels ou ateliers en famille autour de l'Origami."
    ],
    "es": [
      "Tienda de regalos que incluye joyería, marroquinería, accesorios, ropa, velas y estuches. Zona de regalos y juegos para bebés.\r\nJoyas y adornos de papiroflexia. Cursos individuales o talleres familiares de papiroflexia."
    ],
    "nl": [
      "Cadeauwinkel met onder andere sieraden, lederwaren, accessoires, kleding, kaarsen en etuis. Een afdeling voor babycadeaus en spelletjes.\r\nOrigami-juwelen en -decoraties. Individuele cursussen of familieworkshops Origami."
    ]
  },
