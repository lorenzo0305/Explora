  "rdfs:comment": {
    "de": [
      "Theater und Clown: Ein einsamer Dramatiker versucht verzweifelt, ein Stück zu schreiben. Als er plötzlich ... Jemand an die Tür klopft. Ist das seine erste Inspiration? Oder einfach nur die Intervention eines ENEDIS-Technikers?"
    ],
    "en": [
      "Theater and clowning: A lonely playwright is desperately trying to write a play. When suddenly... A knock on the door. His first inspiration? Or simply the intervention of an ENEDIS technician?"
    ],
    "it": [
      "Teatro e clownerie: un drammaturgo solitario sta cercando disperatamente di scrivere un'opera. Quando all'improvviso... Bussano alla porta. La sua prima ispirazione? O semplicemente l'intervento di un tecnico ENEDIS?"
    ],
    "fr": [
      "Théâtre et clown : Un dramaturge solitaire tente désespérément d’écrire une pièce. Quand tout à coup... On frappe à la porte. Sa première inspiration ? Ou simplement l’intervention d’un technicien ENEDIS ?"
    ],
    "nl": [
      "Theater en clownerie: Een eenzame toneelschrijver probeert wanhopig een toneelstuk te schrijven. Wanneer plotseling... Er op de deur wordt geklopt. Zijn eerste inspiratie? Of gewoon de tussenkomst van een ENEDIS-technicus?"
    ],
    "es": [
      "Teatro y clown: Un dramaturgo solitario intenta desesperadamente escribir una obra. Cuando de repente... Llaman a la puerta. ¿Su primera inspiración? ¿O simplemente la intervención de un técnico de ENEDIS?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : SPAM dans ta tête"
    ]
  },
