  "rdfs:comment": {
    "de": [
      "Le Canotier, eine Lounge-Bar, bietet Cocktails, Tapas und lokale Produkte in einer gemütlichen Atmosphäre am Wasser. Kulturelle und private Veranstaltungen, modulierbare Räume und Einrichtungen (Billard, Pétanque). Ganzjährig geöffnet, Preise von 7 bis 30 Euro."
    ],
    "en": [
      "Le Canotier lounge bar offers cocktails, tapas and local produce in a friendly waterside atmosphere. Cultural and private events, flexible rooms and facilities (billiards, pétanque). Open year-round, prices from 7 to 30 euros."
    ],
    "it": [
      "Il lounge bar Le Canotier offre cocktail, tapas e prodotti locali in un'atmosfera accogliente in riva al mare. Eventi culturali e privati, sale e strutture flessibili (biliardo, pétanque). Aperto tutto l'anno, prezzi da 7 a 30 euro."
    ],
    "fr": [
      "Le Canotier, bar lounge, propose cocktails, tapas et produits locaux dans une ambiance conviviale au bord de l’eau. Événements culturels et privés, salles modulables et installations (billard, pétanque). Ouvert toute l'année, tarifs de 7 à 30 euros."
    ],
    "es": [
      "Le Canotier lounge bar ofrece cócteles, tapas y productos locales en un ambiente agradable a orillas del agua. Eventos culturales y privados, salas e instalaciones flexibles (billar, petanca). Abierto todo el año, precios de 7 a 30 euros."
    ],
    "nl": [
      "De loungebar Le Canotier biedt cocktails, tapas en lokale producten in een gezellige sfeer aan het water. Culturele en privé-evenementen, flexibele zalen en faciliteiten (biljart, jeu de boules). Het hele jaar geopend, prijzen van €7 tot €30."
    ]
  },
  "rdfs:label": {
