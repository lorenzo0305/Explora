  "rdfs:comment": {
    "de": [
      "Nachdem Thomas Marty mit seiner ersten One-Man-Show das Publikum erobert hat, kehrt er mit einer neuen Show zurück, die noch witziger, persönlicher und authentischer ist."
    ],
    "en": [
      "After winning over audiences with his first one-man-show, Thomas Marty returns with a new show that's even funnier, more personal and more authentic."
    ],
    "it": [
      "Dopo aver conquistato il pubblico con il suo primo one-man show, Thomas Marty torna con un nuovo spettacolo ancora più divertente, personale e autentico."
    ],
    "fr": [
      "Après avoir conquis le public avec son premier one-man-show, Thomas Marty revient avec un nouveau spectacle encore plus drôle, plus personnel et plus authentique."
    ],
    "es": [
      "Tras conquistar al público con su primer unipersonal, Thomas Marty vuelve con un nuevo espectáculo aún más divertido, personal y auténtico."
    ],
    "nl": [
      "Nadat hij het publiek veroverde met zijn eerste one-man show, is Thomas Marty terug met een nieuwe show die nog grappiger, persoonlijker en authentieker is."
    ]
