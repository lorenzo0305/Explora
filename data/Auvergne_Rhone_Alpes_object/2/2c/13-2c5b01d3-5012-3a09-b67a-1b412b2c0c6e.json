  "rdfs:comment": {
    "de": [
      "Gegenüber der berühmten \"Fresque des Lyonnais\" (Freskogemälde), bietet Ihnen Le Potager des Halles eine moderne Marktküche rund um qualitative Produkte an. Hier finden Sie Geschmack, Würze und Geselligkeit."
    ],
    "en": [
      "Opposite the fresco of Lyon's most famous inhabitants, le Chef offers modern market cuisine made with top-quality products. Rediscover tastes, flavours and conviviality."
    ],
    "it": [
      "Di fronte all'affresco dei Grandi Lionesi, Le Potager des Halles propone una cucina a base di prodotti freschi, di origine locale e di ottima qualità. Ritrova i sapori e il gusto di stare a tavola."
    ],
    "fr": [
      "En face de la fresque des Lyonnais célèbres, le Chef vous propose une cuisine du marché moderne autour de produits de qualité. Retrouvez goûts, saveurs et convivialité."
    ],
    "nl": [
      "Tegenover het fresco van de beroemde Lyonnais biedt de chef u een moderne marktkeuken op basis van kwaliteitsproducten. Zoek naar smaken en gezelligheid."
    ],
    "es": [
      "Frente al Fresco de los Lioneses, Le Potager des Halles propone una cocina de mercado moderna elaborada con productos de calidad.  Aquí reinan el sabor y el buen ambiente."
    ]
  },
