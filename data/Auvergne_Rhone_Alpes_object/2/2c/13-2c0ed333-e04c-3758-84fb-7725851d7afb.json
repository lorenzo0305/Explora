  "rdfs:comment": {
    "de": [
      "Der Ernest Foodtruck bietet ein mobiles kulinarisches Erlebnis mit köstlichen Burgern, Sandwiches, Pommes frites und Süßigkeiten, die mit lokalen Produkten zubereitet und selbst gemacht werden, mit einer Produktion von 500 Burgern in 4 Stunden."
    ],
    "en": [
      "The Ernest foodtruck offers a mobile culinary experience with delicious burgers, sandwiches, chips and sweets, prepared with local and homemade products, producing 500 burgers in 4 hours."
    ],
    "it": [
      "Il foodtruck Ernest offre un'esperienza culinaria mobile con deliziosi hamburger, panini, patatine e dolci, preparati con prodotti locali e fatti in casa, producendo 500 hamburger in 4 ore."
    ],
    "fr": [
      "Le foodtruck Ernest offre une expérience culinaire mobile avec de délicieux burgers, sandwichs, frites et sucreries, préparés avec des produits locaux et faits maison avec une production de 500 burgers en 4 heures."
    ],
    "es": [
      "El Ernest foodtruck ofrece una experiencia culinaria móvil con deliciosas hamburguesas, sándwiches, patatas fritas y dulces, preparados con productos locales y caseros, produciendo 500 hamburguesas en 4 horas."
    ],
    "nl": [
      "De Ernest foodtruck biedt een mobiele culinaire ervaring met heerlijke hamburgers, sandwiches, friet en zoetigheden, bereid met lokale en zelfgemaakte producten en produceert 500 hamburgers in 4 uur."
    ]
  },
