  "rdfs:comment": {
    "de": [
      "30 Minuten von Lyon entfernt, im Herzen des Dorfes Chaponnay, empfängt Sie der Espace socio-culturel Jean Gabin für Ihre Aufführungen, Versammlungen, Cocktails, Geschäftstreffen, aber auch Hochzeiten und alle anderen privaten Veranstaltungen in einer außergewöhnlichen Umgebung."
    ],
    "en": [
      "30 minutes from Lyon, in the heart of the village of Chaponnay, the Jean Gabin Socio-cultural Space welcomes you for your shows, meetings, cocktails, business meetings but also weddings and any other private event in an exceptional environment."
    ],
    "it": [
      "A 30 minuti da Lione, nel cuore del villaggio di Chaponnay, l'Espace socio-culturel Jean Gabin vi accoglie per i vostri spettacoli, riunioni, cocktail, incontri d'affari ma anche matrimoni e qualsiasi altro evento privato in un ambiente eccezionale."
    ],
    "fr": [
      "A 30 minutes de Lyon, au cœur du village de Chaponnay, l’Espace socio-culturel Jean Gabin vous accueille pour vos spectacles, réunions, cocktails, rencontres d’affaires mais aussi mariage et tout autre évènement privé dans un environnement d’exception."
    ],
    "nl": [
      "Op 30 minuten van Lyon, in het hart van het dorp Chaponnay, ontvangt de sociaal-culturele Espace Jean Gabin u voor uw voorstellingen, vergaderingen, cocktails, zakelijke bijeenkomsten maar ook bruiloften en alle andere privé evenementen in een uitzonderlijke omgeving."
    ],
    "es": [
      "A 30 minutos de Lyon, en el corazón del pueblo de Chaponnay, el Espace socio-culturel Jean Gabin le acoge para sus espectáculos, reuniones, cócteles, encuentros de negocios pero también bodas y cualquier otro evento privado en un entorno excepcional."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Complexe socio-culturel Jean Gabin"
    ]
  },
