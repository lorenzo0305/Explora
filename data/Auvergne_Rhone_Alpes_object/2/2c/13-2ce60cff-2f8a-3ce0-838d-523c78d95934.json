  "rdfs:comment": {
    "de": [
      "Jh. gegründeter Adelssitz mit einem von vier quadratischen Türmen flankierten Wohnhaus, der im 19. und 20. Jahrhundert umgebaut. Es befindet sich an einem bemerkenswerten Ort mit Landschaftspark und Nebengebäuden am Ufer der Rhône."
    ],
    "en": [
      "This noble residence, founded in the 17th and 18th centuries, with a dwelling flanked by 4 square towers, was refurbished in the 19th and 20th centuries. It occupies a remarkable site with landscaped parklands and outbuildings on the banks of the Rhône."
    ],
    "it": [
      "Questa residenza nobiliare, fondata nel XVII e XVIII secolo, con una dimora fiancheggiata da 4 torri quadrate, è stata ristrutturata nel XIX e XX secolo. Occupa un sito notevole con parchi paesaggistici e annessi sulle rive del Rodano."
    ],
    "fr": [
      "Cette noble demeure fondée aux XVIIe/XVIII' s. avec logis flanqué de 4 tours carrées, a été réaménagée aux XIXe/XXe s. Elle occupe un site remarquable avec parc paysager et dépendances en bord de Rhône."
    ],
    "es": [
      "Esta noble residencia, fundada en los siglos XVII y XVIII, con una vivienda flanqueada por 4 torres cuadradas, fue reformada en los siglos XIX y XX. Ocupa un notable emplazamiento con parques ajardinados y dependencias a orillas del Ródano."
    ],
    "nl": [
      "Deze adellijke residentie, gesticht in de 17e en 18e eeuw, met een woning geflankeerd door 4 vierkante torens, werd gerenoveerd in de 19e en 20e eeuw. Het ligt op een opmerkelijke site met aangelegde parken en bijgebouwen aan de oevers van de Rhône."
    ]
  },
  "rdfs:label": {
