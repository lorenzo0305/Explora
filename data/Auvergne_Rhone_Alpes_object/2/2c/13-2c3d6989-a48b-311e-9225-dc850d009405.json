  "rdfs:comment": {
    "de": [
      "Das Fest der \"Olivades\" ist ein Höhepunkt im Leben von Nyons und der lokalen Olivenwelt. Es feiert die schwarze Olive von Nyons und wird von der Bruderschaft der \"Chevaliers de l'Olivier\" initiiert."
    ],
    "en": [
      "A high point in the life of Nyons and the local olive-growing world, the \"Olivades\" festival celebrates the Olive Noire de Nyons and is initiated by the Confrérie des Chevaliers de l?Olivier."
    ],
    "it": [
      "Momento culminante della vita di Nyons e del mondo olivicolo locale, la festa delle Olivades celebra l'Olive Noire de Nyons ed è promossa dalla Confrérie des Chevaliers de l'Olivier."
    ],
    "fr": [
      "Moment fort de la vie nyonsaise et du monde oléicole local, la fête des \"Olivades\" célèbre l'Olive Noire de Nyons et est initiée par la Confrérie des Chevaliers de l’Olivier."
    ],
    "es": [
      "Punto culminante de la vida de Nyons y del mundo olivarero local, la fiesta de las Olivades celebra la Olive Noire de Nyons y está iniciada por la Confrérie des Chevaliers de l'Olivier."
    ],
    "nl": [
      "Het Olivades-festival, een hoogtepunt in het leven van Nyons en de plaatselijke olijventeelt, viert de Olive Noire de Nyons en wordt georganiseerd door de Confrérie des Chevaliers de l'Olivier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Olivades"
    ]
  },
