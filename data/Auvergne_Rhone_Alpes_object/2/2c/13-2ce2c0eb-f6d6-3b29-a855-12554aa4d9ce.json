  "rdfs:comment": {
    "de": [
      "Vorführung des Dokumentarfilms \"Goliath, Germaine et moi\" um 21 Uhr in Anwesenheit der Regisseurin Gwladys Morinière in Partnerschaft mit der feministischen Kollektive des Café Grenouille, Dokumentarfilm des Widerstands, generationenübergreifend...Auberge espagnole um 19.30 Uhr."
    ],
    "en": [
      "Screening at 9pm of the documentary \"Goliath, Germaine et moi\" in the presence of director Gwladys Morinière, in partnership with the Feminist Collective of Café Grenouille, an intergenerational documentary of resistance...Spanish meal at 7:30pm."
    ],
    "it": [
      "Proiezione alle 21 del documentario \"Goliath, Germaine et moi\" alla presenza della regista Gwladys Morinière, in collaborazione con il Collettivo femminista del Café Grenouille, un documentario sulla resistenza e l'intergenerazionalità... Cena spagnola alle 19.30."
    ],
    "fr": [
      "Projection à 21h du documentaire \"Goliath, Germaine et moi\" en présence de la réalisatrice Gwladys Morinière en partenariat avec la Collective féministe du café Grenouille, documentaire de résistance, intergénérationnelle...Auberge espagnole à 19h30."
    ],
    "nl": [
      "Vertoning om 21u van de documentaire \"Goliath, Germaine et moi\" in aanwezigheid van de regisseuse Gwladys Morinière, in samenwerking met het feministisch collectief van café Grenouille, een documentaire over verzet en intergeneratie... Spaanse maaltijd om 19u30."
    ],
    "es": [
      "Proyección a las 21:00 h del documental \"Goliath, Germaine et moi\" en presencia de la directora Gwladys Morinière, en colaboración con el Colectivo feminista del café Grenouille, un documental sobre la resistencia y la intergeneración... Comida española a las 19:30 h."
    ]
