  "rdfs:comment": {
    "de": [
      "Für einen entspannten Tag mit der Familie in einer außergewöhnlichen natürlichen Umgebung, 10min von Clermont-Ferrand entfernt. Der Parc Mirabel ist ein familienfreundlicher Freizeitpark für Kinder, aber auch für die Eltern."
    ],
    "en": [
      "For a relaxing day with your family in an exceptional natural setting 10min from Clermont-Ferrand. Parc Mirabel is a family leisure park for children, but also for parents."
    ],
    "it": [
      "Per una giornata rilassante con la famiglia in un ambiente naturale eccezionale a 10 minuti da Clermont-Ferrand. Il Mirabel Park è un parco ricreativo per famiglie, per bambini ma anche per genitori."
    ],
    "fr": [
      "Pour une journée de détente en famille dans un cadre naturel exceptionnel à 10min de Clermont-Ferrand. Le Parc Mirabel est un parc de loisirs familial pour les enfants, mais aussi pour les parents."
    ],
    "nl": [
      "Voor een ontspannend dagje uit met het gezin in een uitzonderlijke natuurlijke omgeving op 10 minuten van Clermont-Ferrand. Het Mirabelpark is een familiepark voor kinderen, maar ook voor ouders."
    ],
    "es": [
      "Para pasar un día de relax en familia en un entorno natural excepcional a 10 minutos de Clermont-Ferrand. El Parque Mirabel es un parque de ocio familiar para niños, pero también para padres."
    ]
  },
  "rdfs:label": {
