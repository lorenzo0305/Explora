  "rdfs:comment": {
    "de": [
      "Schloss von Salles ? Eine außergewöhnliche Übernachtung im Herzen des Cantal!\r\n10 Minuten von Aurillac entfernt öffnet das Château de Salles die Türen zu seinen charmanten Zimmern und Suiten, die in einem Anwesen aus dem 15."
    ],
    "en": [
      "Château de Salles ? An exceptional overnight stay in the heart of Cantal!\r\nJust 10 minutes from Aurillac, Château de Salles opens the doors to its charming rooms and suites, nestled in a 15th-century estate surrounded by 8 hectares of parkland."
    ],
    "it": [
      "Castello di Salles? Un pernottamento eccezionale nel cuore del Cantal!\r\nA soli 10 minuti da Aurillac, lo Château de Salles apre le porte delle sue incantevoli camere e suite, immerse in una tenuta del XV secolo circondata da 8 ettari di parco."
    ],
    "fr": [
      "Château de Salles – Nuitée d’exception au cœur du Cantal!\r\nÀ 10 minutes d’Aurillac, le Château de Salles vous ouvre les portes de ses chambres et suites de charme, nichées dans un domaine du XVe siècle entouré d’un parc de 8 hectares."
    ],
    "nl": [
      "Château de Salles ? Een uitzonderlijke overnachting in het hart van de Cantal!\r\nOp slechts 10 minuten van Aurillac opent Château de Salles de deuren van zijn charmante kamers en suites, genesteld in een 15e-eeuws landgoed omringd door 8 hectare park."
    ],
    "es": [
      "Castillo de Salles ? Una estancia excepcional en el corazón del Cantal\r\nA sólo 10 minutos de Aurillac, el Château de Salles le abre las puertas de sus encantadoras habitaciones y suites, enclavadas en una finca del siglo XV rodeada de 8 hectáreas de parque."
    ]
  },
  "rdfs:label": {
    "en": [
      "Castle of Salles"
    ],
    "fr": [
      "Château de Salles"
    ]
  },
