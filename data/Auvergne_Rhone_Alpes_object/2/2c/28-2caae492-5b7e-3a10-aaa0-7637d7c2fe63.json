  "rdfs:comment": {
    "de": [
      "Massagen oder Behandlungen zu zweit, ein privates Spa mit Hammam, Sauna und Whirlpool? Im Instant d'Or in Douai lädt alles dazu ein, sich zu entschleunigen und sich wieder zu vernetzen."
    ],
    "en": [
      "Massages or duo treatments, private spa with hammam, sauna and whirlpool bath? At l?Instant d?Or in Douai, everything invites you to slow down and reconnect."
    ],
    "it": [
      "Massaggi o trattamenti duo, spa privata con hammam, sauna e vasca idromassaggio? All'Instant d'Or di Douai, tutto invita a rallentare e a riconnettersi."
    ],
    "fr": [
      "Massages ou soins en duo, spa privatif avec hammam, sauna et bain bouillonnant… À l’Instant d’Or à Douai, tout invite à ralentir et à se reconnecter."
    ],
    "nl": [
      "Massages of duo behandelingen, privé spa met hammam, sauna en bubbelbad? Bij l'Instant d'Or in Douai nodigt alles je uit om te onthaasten en opnieuw contact te maken."
    ],
    "es": [
      "Masajes o tratamientos a dúo, spa privado con hammam, sauna y bañera de hidromasaje? En l'Instant d'Or de Douai, todo invita a ralentizar el ritmo y a reconectar."
    ]
  },
