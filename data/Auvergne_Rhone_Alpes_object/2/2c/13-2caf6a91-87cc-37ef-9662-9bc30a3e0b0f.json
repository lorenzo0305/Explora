  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Benannt nach Louis Neillot, einem Maler aus Bourbonnais 1898-1973, wurde dieser Garten 1946 mit Hilfe deutscher Gefangener fertiggestellt, das Becken im folgenden Jahr. Die Fläche beträgt 13.000 m²."
    ],
    "en": [
      "Free access. Named after Louis Neillot, a Bourbonnais painter from 1898-1973, this garden was completed in 1946 with the help of German prisoners, and the pond the following year. The total surface area is 13,000 m²."
    ],
    "it": [
      "Accesso libero. Intitolato a Louis Neillot, pittore di Bourbonnais (1898-1973), questo giardino è stato completato nel 1946 con l'aiuto di prigionieri tedeschi e il laghetto l'anno successivo. Si estende su una superficie di 13.000 m²."
    ],
    "fr": [
      "Accès libre. Du nom de Louis Neillot, artiste peintre bourbonnais 1898-1973, ce jardin sera terminé en 1946 avec l'aide de prisonniers allemands et le bassin l'année suivante. La surface est de 13 000 m²."
    ],
    "nl": [
      "Gratis toegang. Genoemd naar Louis Neillot, een schilder uit Bourbonnais (1898-1973), werd deze tuin in 1946 voltooid met de hulp van Duitse gevangenen en de vijver het jaar daarop. Hij heeft een oppervlakte van 13.000 m²."
    ],
    "es": [
      "Acceso libre. Bautizado con el nombre de Louis Neillot, pintor de Bourbonnais (1898-1973), este jardín se terminó en 1946 con la ayuda de prisioneros alemanes, y el estanque al año siguiente. Ocupa una superficie de 13.000 m²."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jardin Louis Neillot"
    ]
  },
