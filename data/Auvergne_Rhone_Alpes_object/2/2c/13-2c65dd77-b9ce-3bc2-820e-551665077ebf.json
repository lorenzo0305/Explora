  "rdfs:comment": {
    "de": [
      "Verkauf von Tagesgerichten und Vorspeisen ohne Reservierung.\r\nFür die anderen Gerichte auf der Karte müssen Sie zwei Stunden im Voraus bestellen.\r\nKleiner Lebensmittelladen mit thailändischen und asiatischen Produkten."
    ],
    "en": [
      "Daily specials and starters available without reservation.\r\nFor other dishes on the menu, order two hours in advance.\r\nSmall grocery store selling Thai and Asian products."
    ],
    "it": [
      "Specialità del giorno e antipasti disponibili senza prenotazione.\r\nPer gli altri piatti del menu, ordinare con due ore di anticipo.\r\nPiccolo negozio di prodotti thailandesi e asiatici."
    ],
    "fr": [
      "Vente plats du jours et entrées sans réservation.\r\nPour les autres plats de la carte, commande deux heures à l'avance.\r\nPetite épicerie de produits thaïlandais et asiatiques."
    ],
    "es": [
      "Especialidades del día y entrantes disponibles sin reserva.\r\nPara otros platos de la carta, pedir con dos horas de antelación.\r\nPequeña tienda de productos tailandeses y asiáticos."
    ],
    "nl": [
      "Dagschotels en voorgerechten zonder reservering verkrijgbaar.\r\nVoor andere gerechten op het menu moet u twee uur van tevoren bestellen.\r\nKleine winkel met Thaise en Aziatische producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nam Thai food"
    ]
  },
