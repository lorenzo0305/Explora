  "rdfs:comment": {
    "de": [
      "Christophe Maé kehrt für eine außergewöhnliche Tournee auf die Bühne zurück, die in jedem Moment Emotionen und Energie verspricht. Zwischen seinen unumgänglichen Hits und seinen neuen Stücken können Sie sich darauf vorbereiten, im Rhythmus seiner einzigartigen Musik zu singen, zu tanzen und zu vibrieren."
    ],
    "en": [
      "Christophe Maé returns to the stage for an exceptional tour that promises emotion and energy at every turn. From his classic hits to his new songs, get ready to sing, dance and vibrate to the rhythm of his unique music."
    ],
    "it": [
      "Christophe Maé torna sul palco per un tour eccezionale che promette emozioni ed energia in ogni momento. Dai suoi più grandi successi alle nuove canzoni, preparatevi a cantare, ballare e muovervi al ritmo della sua musica unica."
    ],
    "fr": [
      "Christophe Maé revient sur scène pour une tournée exceptionnelle qui promet émotions et énergie à chaque instant. Entre ses tubes incontournables et ses nouveaux morceaux, préparez-vous à chanter, danser et vibrer au rythme de sa musique unique."
    ],
    "es": [
      "Christophe Maé vuelve a los escenarios para una gira excepcional que promete emoción y energía en todo momento. Desde sus grandes éxitos hasta sus nuevas canciones, prepárate para cantar, bailar y moverte al ritmo de su música única."
    ],
    "nl": [
      "Christophe Maé keert terug op het podium voor een uitzonderlijke tournee die op elk moment emotie en energie belooft. Van zijn grootste hits tot zijn nieuwe nummers, maak je klaar om te zingen, dansen en bewegen op het ritme van zijn unieke muziek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Excursion - Christophe Maé concert"
    ],
    "fr": [
      "Excursion - Concert de Christophe Maé"
    ]
  },
