  "rdfs:comment": {
    "de": [
      "Allgemeine Lebensmittel, Obst und Gemüse, regionale und lokale Produkte, vor Ort gebackenes Brot, Souvenirs, Gas, Pickup- und Poiscaille-Relaispunkt, Cash-Commerce, Française des Jeux. Lieferung nach Hause (Auskunft im Geschäft über die Bedingungen)."
    ],
    "en": [
      "General food, fruit and vegetables, regional and local produce, bread baked on site, souvenirs, gas, Pickup and Poiscaille Relay Points, cash-and-carry, Française des jeux. Home delivery (see store for conditions)."
    ],
    "it": [
      "Alimenti generici, frutta e verdura, prodotti regionali e locali, pane cotto in loco, souvenir, gas, punti di collegamento Pickup e Poiscaille, cash-and-carry, Française des jeux. Consegna a domicilio (consultare il negozio per i termini e le condizioni)."
    ],
    "fr": [
      "Alimentation générale, fruits et légumes, produits régionaux et locaux, pain cuit sur place, souvenirs, gaz, Point Relais Pickup et Poiscaille, cash-commerçant, Française des jeux. Livraison à domicile (renseignement en magasin sur les conditions)."
    ],
    "es": [
      "Alimentación general, frutas y verduras, productos regionales y locales, pan horneado en el establecimiento, recuerdos, gas, puntos de relevo Pickup y Poiscaille, cash-and-carry, Française des jeux. Entrega a domicilio (consulte las condiciones en la tienda)."
    ],
    "nl": [
      "Algemene levensmiddelen, groenten en fruit, regionale en lokale producten, ter plekke gebakken brood, souvenirs, gas, afhaalpunten Pickup en Poiscaille, zelfbediening, Française des Jeux. Thuisbezorging (zie winkel voor voorwaarden)."
    ]
  },
