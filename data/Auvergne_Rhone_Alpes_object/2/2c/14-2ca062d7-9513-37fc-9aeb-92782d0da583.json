  "rdfs:comment": {
    "de": [
      "Treffen Sie Jean-Marie Minot und tauschen Sie sich mit diesem Experten des Bassin Minier aus, der zusammen mit seinem Partner Didier Vivien mehrere schöne Bücher über das Bergbauepos verfasst hat, die im Verlag Editions de l'Escaut erschienen sind."
    ],
    "en": [
      "Come and meet Jean-Marie Minot, an expert on the mining basin and author, with his partner Didier Vivien, of several fine books on the mining epic, published by Editions de l'Escaut."
    ],
    "it": [
      "Venite a conoscere Jean-Marie Minot, esperto del bacino carbonifero e autore, con il suo socio Didier Vivien, di diversi bei libri sull'epopea mineraria, pubblicati dalle Editions de l'Escaut."
    ],
    "fr": [
      "Venez rencontrer Jean-Marie Minot et échanger avec cet expert du Bassin minier, auteur, avec son complice Didier Vivien, de plusieurs beaux livres sur l’épopée minière, publiés aux éditions de l’Escaut."
    ],
    "es": [
      "Venga a conocer a Jean-Marie Minot, experto en la cuenca minera y autor, junto con su socio Didier Vivien, de varios libros de gran calidad sobre la epopeya minera, publicados por Editions de l'Escaut."
    ],
    "nl": [
      "Kom kennismaken met Jean-Marie Minot, expert op het gebied van steenkool en auteur, samen met zijn partner Didier Vivien, van verschillende prachtige boeken over het mijnbouwepos, uitgegeven door Editions de l'Escaut."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café rencontre et séance de dédicaces avec Jean Marie Minot"
    ]
  },
