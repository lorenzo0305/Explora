  "rdfs:comment": {
    "de": [
      "Didier GIRARD hat beschlossen, zu seinen Wurzeln zurückzukehren und sich in Le Bourg-d'Oisans niederzulassen. Er züchtet Lämmer und Amerikanische Bisons (kanadischer Herkunft) wegen ihres Fleisches und um dieses mythische Tier zu entdecken."
    ],
    "en": [
      "Didier GIRARD decided to return to his roots and settle in Bourg-d'Oisans. He raises lambs and American Bison (of Canadian origin) for their meat and to introduce visitors to this mythical animal."
    ],
    "it": [
      "Didier GIRARD ha deciso di tornare alle sue radici e si è stabilito a Le Bourg-d'Oisans, dove alleva agnelli e bisonti americani (di origine canadese) per la loro carne e per far conoscere ai visitatori questo animale mitico."
    ],
    "fr": [
      "Didier GIRARD a décidé de revenir aux sources et s’installer au Bourg-d’Oisans, Il élève des agneaux et des Bisons d’Amérique (d’origine canadienne) pour leur viande et pour faire découvrir cet animal mythique."
    ],
    "es": [
      "Didier GIRARD decidió volver a sus raíces e instalarse en Le Bourg-d'Oisans. Cría corderos y bisontes americanos (de origen canadiense) por su carne y para dar a conocer a los visitantes este mítico animal."
    ],
    "nl": [
      "Didier GIRARD besloot terug te keren naar zijn roots en vestigde zich in Le Bourg-d'Oisans. Hij fokt lammeren en Amerikaanse bizons (van Canadese oorsprong) voor hun vlees en om mensen kennis te laten maken met dit mythische dier."
    ]
  },
  "rdfs:label": {
