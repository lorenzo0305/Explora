  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f2d8629f-efe7-331a-8d58-9339ec62369d",
      "dc:description": {
        "de": [
          "Die Kirche Saint-Martin ist eine wunderschöne Kirche aus weißem Stein und voller Überreste aus der Vergangenheit, die aus mehreren Jahrhunderten stammen. Sie können hier unter anderem Grabsteine, wunderschöne Gemälde oder auch Skulpturen finden, die über die Kirche wachen."
        ],
        "en": [
          "A beautiful white stone church, Saint-Martin is brimming with relics of the past dating back several centuries. You'll find tumulus stones, magnificent paintings and sculptures that watch over the church."
        ],
        "it": [
          "Splendida chiesa in pietra bianca, Saint-Martin è ricca di reliquie del passato risalenti a diversi secoli fa. Troverete tumuli, magnifici dipinti e sculture che vegliano sulla chiesa."
        ],
        "fr": [
          "Belle église de pierre blanche, l'église de Saint-Martin regorge de vestiges du passé datant de plusieurs siècles. Vous pourrez notamment y trouver des pierres tumulaires, des tableaux magnifiques ou encore des sculptures qui veillent sur l'église."
        ],
        "nl": [
          "Saint-Martin is een prachtige kerk van witte steen vol overblijfselen uit het verleden die meerdere eeuwen teruggaan. Je vindt er tumuli, prachtige schilderijen en beeldhouwwerken die over de kerk waken."
        ],
        "es": [
          "Preciosa iglesia de piedra blanca, Saint-Martin está repleta de reliquias del pasado que datan de varios siglos. Encontrarás túmulos, magníficas pinturas y esculturas que vigilan la iglesia."
        ]
      },
