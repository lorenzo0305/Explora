  "rdfs:comment": {
    "de": [
      "Sie sehen Gemälde und Zeichnungen von Valérie Masson, einer Schweizer Künstlerin und Preisträgerin der Guignard-Stiftung, die eine originelle, intensive und ausdauernde künstlerische Arbeit würdigt und belohnt."
    ],
    "en": [
      "You'll see paintings and drawings by Valérie Masson, a Swiss artist and winner of the Fondation Guignard, which recognizes and rewards original, intense and persevering artistic work."
    ],
    "it": [
      "Vedrete dipinti e disegni di Valérie Masson, artista svizzera vincitrice della Fondation Guignard, che riconosce e premia il lavoro artistico originale, intenso e perseverante."
    ],
    "fr": [
      "Vous verrez des peintures et dessins de Valérie Masson, artiste suisse lauréate de la fondation Guignard qui salue et récompense un travail artistique original, intense et persévérant."
    ],
    "es": [
      "Verá pinturas y dibujos de Valérie Masson, artista suiza galardonada con la Fundación Guignard, que reconoce y recompensa el trabajo artístico original, intenso y perseverante."
    ],
    "nl": [
      "Je ziet schilderijen en tekeningen van Valérie Masson, een Zwitserse kunstenares en winnares van de Fondation Guignard, die origineel, intens en volhardend artistiek werk erkent en beloont."
    ]
  },
  "rdfs:label": {
    "fr": [
