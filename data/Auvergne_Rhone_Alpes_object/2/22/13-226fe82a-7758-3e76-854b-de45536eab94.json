  "rdfs:comment": {
    "de": [
      "Sie haben die Nase voll von Stand-up-Performances mit Mikrofonen in der Hand, die einen Witz nach dem anderen über Handyprobleme, Babys, die nicht genug schlafen, oder kommunitaristischen Humor zum Besten geben?"
    ],
    "en": [
      "Have you had enough of Stands-upers, microphones in hand, spouting joke after joke about cell phones, babies who don't get enough sleep or communitarian humour?"
    ],
    "it": [
      "Ne avete abbastanza di spettacoli in piedi, con i microfoni in mano, che sputano battute su battute sui telefoni cellulari, sui bambini che non dormono abbastanza o sull'umorismo comunitario?"
    ],
    "fr": [
      "Vous en avez assez des spectacles de Stands-upers, micros à la main débitant vannes sur vannes sur les problèmes de portables, de bébés qui ne dorment pas assez ou d’humour communautariste ?"
    ],
    "es": [
      "¿Ya está harto de los espectáculos de pie, micrófono en mano, soltando chiste tras chiste sobre teléfonos móviles, bebés que no duermen lo suficiente o humor comunitario?"
    ],
    "nl": [
      "Heb je genoeg van standee shows, microfoons in de hand, die grap na grap spuien over mobiele telefoons, baby's die niet genoeg slaap krijgen of communitaire humor?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Humour : Manuel Pratt dans \"Hors-champs\""
    ]
  },
