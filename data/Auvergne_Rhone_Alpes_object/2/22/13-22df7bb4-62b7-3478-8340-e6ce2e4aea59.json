  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné du Percy. Wir können Sie für die Dauer eines Picknicks empfangen.\r\nPicknicktisch und Anbindestange für die Pferde stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné du Percy. We can welcome you for a picnic.\r\nA picnic table and a tethering bar for horses are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné du Percy. Possiamo accogliervi per un picnic.\r\nUn tavolo da picnic e una barra per legare i cavalli sono a vostra disposizione."
    ],
    "fr": [
      "Bienvenue au Relais Cyné du Percy. Nous pouvons vous accueillir le temps d'un pique nique.\r\nTable de pique-nique et barre d'attache pour les chevaux sont mis à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné du Percy. U bent van harte welkom voor een picknick.\r\nEen picknicktafel en een tui voor paarden staan tot je beschikking."
    ],
    "es": [
      "Bienvenido al Relais Cyné du Percy. Podemos acogerle para un picnic.\r\nUna mesa de picnic y una barra de amarre para caballos están a su disposición."
    ]
  },
