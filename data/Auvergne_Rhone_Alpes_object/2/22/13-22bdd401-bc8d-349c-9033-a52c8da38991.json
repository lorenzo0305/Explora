  "rdfs:comment": {
    "de": [
      "Anlässlich des Printemps des Poètes organisiert die Bibliothek von Clérieux einen Abend, an dem Gedichte und Lieder zum Thema \"Freiheit, lebendige, entfaltete Kraft\" gelesen werden. Kommen Sie zahlreich!"
    ],
    "en": [
      "To mark Printemps des Poètes, the Clérieux library is organizing an evening of poetry and song readings on the theme of freedom, a living, unfolding force. Come one, come all!"
    ],
    "it": [
      "In occasione del Printemps des Poètes, la biblioteca Clérieux organizza una serata di letture di poesie e canzoni sul tema della libertà, forza viva e in divenire. Venite tutti!"
    ],
    "fr": [
      "À l'occasion du Printemps des Poètes, la bibliothèques de Clérieux organise une soirée lecture de poèmes et chansons sur le thème de la liberté, force vive, déployée. Venez nombreux !"
    ],
    "nl": [
      "Ter gelegenheid van Printemps des Poètes organiseert bibliotheek Clérieux een avond met poëzievoordrachten en liederen over het thema vrijheid, een levende, ontvouwende kracht. Komt allen!"
    ],
    "es": [
      "Con motivo del Printemps des Poètes, la biblioteca Clérieux organiza una velada de lectura de poemas y canciones sobre el tema de la libertad, una fuerza viva que se despliega. Vengan todos"
    ]
  },
