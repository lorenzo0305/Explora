  "rdfs:comment": {
    "de": [
      "Als Bergbegleiterin, Yogalehrerin und Beraterin für Phytotherapie wird Clémence ihre Leidenschaft für die Berge, die Natur und das Yoga mit Ihnen teilen."
    ],
    "en": [
      "As a mountain leader, yoga teacher and phytotherapy consultant, Clémence will share her passion for the mountains, nature and yoga with you."
    ],
    "it": [
      "Come guida alpina, insegnante di yoga e consulente di fitoterapia, Clémence condividerà con voi la sua passione per la montagna, la natura e lo yoga."
    ],
    "fr": [
      "Accompagnatrice en montagne, professeure de yoga et conseillère en phytothérapie, Clémence saura vous faire partager sa passion pour la montagne, la nature et le yoga."
    ],
    "es": [
      "Como guía de montaña, profesora de yoga y asesora fitoterapéutica, Clémence compartirá con usted su pasión por la montaña, la naturaleza y el yoga."
    ],
    "nl": [
      "Als bergleidster, yogalerares en fytotherapieconsulente zal Clémence haar passie voor de bergen, de natuur en yoga met je delen."
    ]
