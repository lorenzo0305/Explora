  "rdfs:comment": {
    "de": [
      "Ich schaffe Schmuckstücke aus Weinranken, natürliche Holzspiralen mit\r\nHalbsteinen und wertvollen Holzperlen, sowie Glas. Ich realisiere auch\r\nandere Schöpfungen."
    ],
    "en": [
      "I create jewellery with vine tendrils, natural wooden spirals, and beads of semi-precious stones, glass, wood, ceramic. Natural materials for unique creations."
    ],
    "it": [
      "Creo gioielli utilizzando viticci e spirali di legno naturale, impreziositi da perline di pietre semipreziose, vetro, legno o ceramica. Materiali naturali per pezzi unici."
    ],
    "fr": [
      "Je crée des bijoux en vrilles de vigne, des spirales naturelles en bois, embellis de perles en pierres semi-précieuses, en verre, en bois ou en céramique. Des matières naturelles pour des pièces uniques."
    ],
    "nl": [
      "Ik maak sieraden van wijnranken, natuurlijke spiralen van hout met\r\nhalf-edelstenen en houten parels en glas. Ik maak aparte creaties."
    ],
    "es": [
      "Creo joyas con zarcillos de vid y espirales de madera natural, adornadas con cuentas de piedras semipreciosas, vidrio, madera o cerámica. Materiales naturales para piezas únicas."
    ]
  },
