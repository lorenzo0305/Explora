  "rdfs:comment": {
    "de": [
      "Neu!\r\nEntdecken Sie das Maison du Mouton, eines der ältesten Wohnhäuser von Romans, das heute Maison du patrimoine\" heißt!\r\nEin kostenloser Raum, der allen offen steht und Sie dazu einlädt, das Kulturerbe Vallée de l'Isère und Drôme des collines zu entdecken."
    ],
    "en": [
      "New!\r\nCome and discover the Maison du Mouton, one of the oldest residences in Romans, now a Maison du patrimoine!\r\nA free space open to all, inviting you to discover the heritage of the Isère Valley and the Drôme des Collines."
    ],
    "it": [
      "Novità!\r\nVenite a scoprire la Maison du Mouton, una delle più antiche residenze romane, oggi centro del patrimonio!\r\nÈ uno spazio gratuito aperto a tutti, che invita a scoprire il patrimonio della Valle dell'Isère e della Drôme des Collines."
    ],
    "fr": [
      "Nouveau ! \r\nVenez découvrir la Maison du Mouton, l'une des plus anciennes demeures de Romans devenue aujourd'hui Maison du patrimoine !\r\nUn espace gratuit ouvert à tous qui vous invite à découvrir le patrimoine Vallée de l’Isère et Drôme des collines."
    ],
    "es": [
      "Novedad\r\nVenga a descubrir la Maison du Mouton, una de las residencias romanas más antiguas, hoy convertida en centro del patrimonio\r\nEs un espacio gratuito y abierto a todos, que le invita a descubrir el patrimonio del valle del Isère y de la Drôme des Collines."
    ],
    "nl": [
      "Nieuw!\r\nKom en ontdek het Maison du Mouton, een van de oudste residenties in Rome, nu een Erfgoedcentrum!\r\nHet is een gratis toegankelijke ruimte die je uitnodigt om het erfgoed van de Isère-vallei en de Drôme des Collines te ontdekken."
    ]
  },
  "rdfs:label": {
    "de": [
      "Das Haus des Kulturerbes - Maison du Mouton (Haus des Schafes)"
    ],
    "en": [
      "Sheep house - Maison du Mouton"
    ],
    "fr": [
      "La Maison du Mouton"
    ],
    "nl": [
