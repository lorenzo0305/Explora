  "rdfs:comment": {
    "de": [
      "Das Festival Chasseurs d'Orages lässt das Publikum in extreme Wetterphänomene eintauchen, mit einem immersiven Erlebnis, das Wissenschaft, Bilder und Unterhaltung miteinander verbindet. Eine einzigartige Veranstaltung in Europa."
    ],
    "en": [
      "The Chasseurs d?Orages Festival immerses the public in extreme weather phenomena, with an immersive experience combining science, images and spectacle. A unique event in Europe."
    ],
    "it": [
      "Il Festival Chasseurs d'Orages immerge il pubblico nei fenomeni meteorologici estremi, con un'esperienza coinvolgente che unisce scienza, immagini e spettacolo. Un evento unico in Europa."
    ],
    "fr": [
      "Le Festival Chasseurs d’Orages plonge le public dans les phénomènes météo extrêmes, avec une expérience immersive qui mêle science, images et spectacle. Un rendez-vous unique en Europe."
    ],
    "nl": [
      "Het Chasseurs d'Orages Festival dompelt het publiek onder in extreme weersverschijnselen, met een meeslepende ervaring die wetenschap, beelden en spektakel combineert. Een uniek evenement in Europa."
    ],
    "es": [
      "El Festival Chasseurs d'Orages sumerge al público en los fenómenos meteorológicos extremos, con una experiencia envolvente que combina ciencia, imágenes y espectáculo. Un acontecimiento único en Europa."
    ]
  },
