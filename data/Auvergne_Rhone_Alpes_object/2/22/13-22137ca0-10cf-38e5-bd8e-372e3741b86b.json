  "rdfs:comment": {
    "de": [
      "Unter ihrem 32 Meter hohen Schlussstein beherbergt diese majestätische Kuppel eine der beeindruckendsten Bars der Welt: den Dom, dessen Name eine direkte Hommage an den Ort ist, der von Jacques-Germain Soufflot entworfen und von Jean-Philippe Nuel dekoriert wurde."
    ],
    "en": [
      "Under its keystone of 32 meters, this majestic dome hosts one of the most impressive bars in the world: Le Dôme, whose name directly pays tribute to the place, signed Jacques-Germain Soufflot and designed by Jean-Philippe Nuel."
    ],
    "it": [
      "Sotto la sua chiave di volta alta 32 metri, questa maestosa cupola ospita uno dei bar più imponenti del mondo: il Dome, il cui nome è un diretto omaggio al locale, firmato da Jacques-Germain Soufflot e decorato da Jean-Philippe Nuel."
    ],
    "fr": [
      "Sous sa clef de voûte de 32 mètres, cette majestueuse coupole accueille l’un des plus impressionnants bars au monde : le Dôme, dont le nom rend directement hommage au lieu, signé Jacques-Germain Soufflot et décoré par Jean-Philippe Nuel."
    ],
    "nl": [
      "Onder de 32 meter hoge sluitsteen herbergt deze majestueuze koepel een van de meest indrukwekkende bars ter wereld: de Koepel, waarvan de naam een direct eerbetoon is aan de plek, getekend door Jacques-Germain Soufflot en gedecoreerd door Jean-Philippe Nuel."
    ],
    "es": [
      "Bajo su clave de 32 metros de altura, esta majestuosa cúpula alberga uno de los bares más impresionantes del mundo: la Cúpula, cuyo nombre rinde homenaje directo al lugar, firmado por Jacques-Germain Soufflot y decorado por Jean-Philippe Nuel."
    ]
  },
