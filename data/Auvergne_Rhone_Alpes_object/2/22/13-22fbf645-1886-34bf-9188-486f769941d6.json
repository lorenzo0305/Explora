  "rdfs:comment": {
    "de": [
      "Traditionelle Crêperie: Wir bieten mittags und abends zu den Mahlzeiten Buchweizenpfannkuchen sowie den ganzen Tag über süße Crêpes und hausgemachtes Eis an."
    ],
    "en": [
      "Traditional creperie: we offer buckwheat pancakes at lunchtime and in the evening, as well as sweet crepes and homemade ice creams all day long."
    ],
    "it": [
      "Creperia tradizionale: serviamo frittelle di grano saraceno a pranzo e alla sera, oltre a crepes dolci e gelati fatti in casa per tutto il giorno."
    ],
    "fr": [
      "Crêperie traditionnelle : nous proposons des Galettes de Sarrasin le midi et le soir aux heures des repas ainsi que des Crêpes sucrées et des glaces artisanales toute la journée ."
    ],
    "nl": [
      "Traditionele crêperie: we serveren 's middags en 's avonds boekweitpannenkoeken en de hele dag door zoete crêpes en zelfgemaakt ijs."
    ],
    "es": [
      "Crepería tradicional: servimos tortitas de trigo sarraceno al mediodía y por la noche, así como crepes dulces y helados caseros durante todo el día."
    ]
  },
