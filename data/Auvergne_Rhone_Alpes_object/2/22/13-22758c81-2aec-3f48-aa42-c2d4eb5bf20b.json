  "rdfs:comment": {
    "de": [
      "Der Tunnel de la Collonge in Ambierle im Departement Loire ist ein alter Eisenbahntunnel, den das Haus Mons in einen außergewöhnlichen Ort verwandelt hat, der der Reifung unserer Lagerkäse gewidmet ist."
    ],
    "en": [
      "In Ambierle, in the Loire, the Tunnel de la Collonge is a former railway tunnel that Maison Mons has transformed into an exceptional place, dedicated to the maturing of our aged cheeses."
    ],
    "it": [
      "Ad Ambierle, nella Loira, il Tunnel de la Collonge è un ex tunnel ferroviario che la Maison Mons ha trasformato in un luogo eccezionale dedicato alla stagionatura dei nostri formaggi a lunga conservazione."
    ],
    "fr": [
      "À Ambierle, dans la Loire, le Tunnel de la Collonge est un ancien tunnel ferroviaire que la Maison Mons a métamorphosé en un lieu d’exception, dédié à l’affinage de nos fromages de garde."
    ],
    "nl": [
      "In Ambierle, in de Loire, is de Tunnel de la Collonge een voormalige spoorwegtunnel die Maison Mons heeft omgetoverd tot een uitzonderlijke plek om onze lang houdbare kazen te laten rijpen."
    ],
    "es": [
      "En Ambierle, en el Loira, el Tunnel de la Collonge es un antiguo túnel ferroviario que la Maison Mons ha transformado en un lugar excepcional dedicado a la maduración de nuestros quesos de larga conservación."
    ]
  },
  "rdfs:label": {
