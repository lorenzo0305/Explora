  "rdfs:comment": {
    "de": [
      "Die Burgers Monin treffen Sie jeden Mittwochabend gegenüber der Schulgruppe. Foodtruck Selbstgemachte Burger, vor Ort gehacktes Fleisch. 4 verschiedene Brote, die von einem Bäcker hergestellt werden.\r\nFür mehr Geschmack kommt das Gemüse von Erzeugern."
    ],
    "en": [
      "Les Burgers Monin welcomes you on Wednesday evenings in front of the school. Foodtruck homemade burgers, ground meat on site. 4 different breads made by a baker.\r\nFor added flavor, vegetables are sourced from local growers."
    ],
    "it": [
      "Les Burgers Monin è aperto ogni mercoledì sera davanti alla scuola. Foodtruck di hamburger fatti in casa, carne macinata sul posto. 4 diversi tipi di pane preparati da un panettiere.\r\nPer dare un tocco di sapore in più, le verdure provengono da produttori locali."
    ],
    "fr": [
      "Les Burgers Monin vous donnent rendez-vous le mercredi soir en face du groupe scolaire. Foodtruck burgers faits maison, viande hachée sur place. 4 pains différents confectionnés par un boulanger. \r\nPour plus de saveur les légumes viennent de producteurs."
    ],
    "nl": [
      "Les Burgers Monin is elke woensdagavond geopend voor de school. Foodtruck zelfgemaakte hamburgers, gehakt ter plekke. 4 verschillende broden gemaakt door een bakker.\r\nVoor extra smaak komen de groenten van lokale producenten."
    ],
    "es": [
      "Les Burgers Monin abre todos los miércoles por la noche frente a la escuela. Foodtruck de hamburguesas caseras, carne picada al momento. 4 panes diferentes elaborados por un panadero.\r\nPara darle más sabor, las verduras proceden de productores locales."
    ]
  },
  "rdfs:label": {
