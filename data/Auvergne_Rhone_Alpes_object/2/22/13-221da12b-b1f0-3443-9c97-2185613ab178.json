  "rdfs:comment": {
    "de": [
      "Fahrradverleih: traditionelle Fahrräder (Erwachsene und Kinder) oder Fahrräder mit elektrischer Unterstützung (ab 12 Jahren). Geführte Ausflüge mit dem Elektrofahrrad ab Vogüé."
    ],
    "en": [
      "Bike hire: traditional bikes (adults and children) or electric bikes (over 12s). Guided electric bike rides depart from Vogüé."
    ],
    "it": [
      "Noleggio biciclette: tradizionali (adulti e bambini) o elettriche (sopra i 12 anni). Le escursioni guidate in bicicletta elettrica partono da Vogüé."
    ],
    "fr": [
      "Location de vélos: vélos traditionnels (adultes et enfants) ou à assistance électrique (+12 ans). Balades guidées en vélo électrique au départ de Vogüé."
    ],
    "nl": [
      "Fietsverhuur: traditionele fietsen (volwassenen en kinderen) of elektrische fietsen (vanaf 12 jaar). Begeleide elektrische fietstochten vertrekken vanuit Vogüé."
    ],
    "es": [
      "Alquiler de bicicletas: tradicionales (adultos y niños) o eléctricas (mayores de 12 años). Los paseos guiados en bicicleta eléctrica salen de Vogüé."
    ]
  },
