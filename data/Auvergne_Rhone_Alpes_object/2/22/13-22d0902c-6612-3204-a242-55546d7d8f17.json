  "rdfs:comment": {
    "de": [
      "Besuch des Ateliers, Ausstellung und Verkauf vor Ort in Livron, einem hochgelegenen Dorf. Ständige Verkaufsausstellungen in der Galerie, 1 grande rue in Mirmande. Kurse und Praktika in Modellieren und Drehen für alle Altersgruppen das ganze Jahr über oder auf Anfrage. Kunsttherapie-Workshops."
    ],
    "en": [
      ". Expo-sale permanently at the Gallery. Modeling courses and courses, filming for all ages all year round or on request. Art therapy workshops."
    ],
    "it": [
      "Esposizione permanente e vendita presso la Galleria. Corsi e workshop di modellazione e lancio per il pubblico tutto l'anno o su richiesta. Laboratori di arteterapia."
    ],
    "fr": [
      "Expo-vente  en permanence à la Galerie. Cours et stages modelage, tournage tout public toute l'année ou à la demande. Ateliers art-thérapie."
    ],
    "es": [
      "Exposición permanente y venta en la Galería. Cursos y talleres de modelado y lanzamiento para el público en general durante todo el año o previa solicitud. Talleres de arteterapia."
    ],
    "nl": [
      "Bezoek aan het atelier, tentoonstelling en verkoop in Livron, een hooggelegen dorp. Permanente tentoonstelling en verkoop in de Galerie, 1 grande rue in Mirmande. Cursussen en workshops boetseren en gooien voor het grote publiek het hele jaar door of op aanvraag. Workshops kunstzinnige therapie."
    ]
  },
