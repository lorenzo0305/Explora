  "rdfs:comment": {
    "de": [
      "Lufttaufe, Einführungsflug in einem ULM-Flugzeug.\r\nErleben Sie ein unvergessliches Erlebnis in einem ULM-Mehrsitzer! Fliegen Sie mit einem Piloten als Fluglehrer über grandiose Landschaften. Neues, gut ausgestattetes französisches Flugzeug, Rettungsfallschirm.\r\nBuchen Sie schnell Ihr Abenteuer!"
    ],
    "en": [
      "Baptism of the air, introductory flight in a microlight aircraft.\r\nEnjoy an unforgettable experience in a multiaxis ultralight! Fly over grandiose landscapes with an instructor pilot. Recent, well-equipped French aircraft, emergency parachute.\r\nBook your adventure now!"
    ],
    "it": [
      "Battesimo dell'aria, volo introduttivo in un aereo ultraleggero.\r\nGodetevi un'esperienza indimenticabile in un aereo multiasse ultraleggero! Sorvolate paesaggi magnifici con un pilota istruttore. Velivolo francese recente e ben equipaggiato, paracadute d'emergenza.\r\nPrenotate subito la vostra avventura!"
    ],
    "fr": [
      "Baptême de l'air, vol d'initiation en avion ULM. \r\nVivez une expérience inoubliable en multiaxe ULM ! Survolez des paysages grandioses avec un pilote instructeur. Avion français récent, bien équipé, parachute de secours. \r\nRéservez vite votre aventure !"
    ],
    "nl": [
      "Luchtdoop, kennismakingsvlucht in een microlight vliegtuig.\r\nGeniet van een onvergetelijke ervaring in een meerassig microlightvliegtuig! Vlieg over prachtige landschappen met een instructeur-piloot. Recent, goed uitgerust Frans vliegtuig, noodparachute.\r\nBoek nu je avontuur!"
    ],
    "es": [
      "Bautismo del aire, vuelo de iniciación en ultraligero.\r\nDisfrute de una experiencia inolvidable en un ultraligero multieje Sobrevuele magníficos paisajes con un piloto instructor. Avión francés reciente y bien equipado, paracaídas de emergencia.\r\n¡Reserve ya su aventura!"
    ]
  },
