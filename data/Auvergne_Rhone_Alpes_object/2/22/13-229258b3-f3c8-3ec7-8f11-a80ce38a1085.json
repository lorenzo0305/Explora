  "rdfs:comment": {
    "de": [
      "Willkommen in l'alpette bei Passoud.  Dieses Bergrestaurant bietet Ihnen ein außergewöhnliches Erlebnis mit Blick auf den wunderschönen Lac Carrelet.An der Ankunft der Gondelbahn von l'alpette und der Seilbahn von vaujany ideal für Fußgänger und Langläufer"
    ],
    "en": [
      "Welcome to L'Alpette Chez Passoud. This mountain restaurant embodies the essence of traditional and family cuisine, offering an exceptional experience facing the magnificent Lac Carrelet."
    ],
    "it": [
      "Benvenuti a l'alpette chez Passoud.  Questo ristorante d'alta quota vi offre un'esperienza eccezionale con vista sul magnifico Lac Carrelet, al punto di arrivo della funivia dell'Alpette e della funivia del Vaujany, ideale per i pedoni e gli sciatori di fondo"
    ],
    "fr": [
      "Bienvenue à l'alpette chez Passoud.  Ce restaurant d'altitude vous offre une expérience exceptionnelle face au magnifique Lac Carrelet.à l'arrivée du télécabine de l'alpette et du téléphérique de vaujany idéal pour les piétons et les fondeurs"
    ],
    "nl": [
      "Welkom bij L'Alpette Chez Passoud. Dit bergrestaurant belichaamt de essentie van traditionele en familiale keuken en biedt een uitzonderlijke ervaring met uitzicht op het prachtige Lac Carrelet."
    ],
    "es": [
      "Bienvenido a l'alpette chez Passoud.  Este restaurante de altura le ofrece una experiencia excepcional con vistas al magnífico lago Carrelet.En el punto de llegada del teleférico de l'alpette y del teleférico de vaujany, ideal para peatones y esquiadores de fondo"
    ]
  },
