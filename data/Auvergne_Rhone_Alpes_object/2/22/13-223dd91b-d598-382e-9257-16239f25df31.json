  "rdfs:comment": {
    "de": [
      "Vassieux RécréationS ist ein Verein mit dem Ziel, die sozialen Beziehungen in der Region durch verschiedene und vielfältige Aufführungen zu fördern, die mindestens einmal im Jahr organisiert werden."
    ],
    "en": [
      "Vassieux RécréationS is an association whose aim is to promote social cohesion in the region through a variety of shows organized at least once a year."
    ],
    "it": [
      "Vassieux RécréationS è un'associazione che ha l'obiettivo di promuovere la coesione sociale nella zona organizzando una serie di spettacoli almeno una volta all'anno."
    ],
    "fr": [
      "Vassieux RécréationS est une association ayant pour objectif de favoriser le lien social sur le territoire  grâce à des spectacles divers et variés organisés au moins une fois par an."
    ],
    "nl": [
      "Vassieux RécréationS is een vereniging die tot doel heeft de sociale cohesie in de buurt te bevorderen door minstens één keer per jaar verschillende voorstellingen te organiseren."
    ],
    "es": [
      "Vassieux RécréationS es una asociación cuyo objetivo es fomentar la cohesión social de la zona organizando diversos espectáculos al menos una vez al año."
    ]
  },
