  "rdfs:comment": {
    "de": [
      "Die neue Communauté de communes des Baronnies en Drôme Provençale entstand am 1. Januar 2017 durch die Fusion der 4 Communautés de communes des Baronnies (CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d'Eygues, CC des Hautes Baronnies)."
    ],
    "en": [
      "The new Communauté de communes des Baronnies en Drôme Provençale was born on January 1, 2017 from the merger of the 4 Communautés de communes des Baronnies: CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d'Eygues, CC des Hautes Baronnies)."
    ],
    "it": [
      "La nuova Comunità dei Comuni delle Baronnies della Drôme Provençale è stata creata il 1° gennaio 2017 dalla fusione delle 4 Comunità dei Comuni delle Baronnies: CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d'Eygues, CC des Hautes Baronnies)."
    ],
    "fr": [
      "La nouvelle Communauté de communes des Baronnies en Drôme Provençale est née le 1er janvier 2017 de la fusion des 4 Communautés de communes des Baronnies : CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d’Eygues, CC des Hautes Baronnies)."
    ],
    "es": [
      "La nueva Mancomunidad de Municipios de las Baronías en Drôme Provençale se creó el 1 de enero de 2017 a partir de la fusión de las 4 Mancomunidades de Municipios de las Baronías: CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d'Eygues, CC des Hautes Baronnies)."
    ],
    "nl": [
      "De nieuwe Communauté de communes des Baronnies en Drôme Provençale (Gemeentelijke Gemeenschap van de Baronnies in Drôme Provençale) is op 1 januari 2017 ontstaan uit de fusie van de 4 Gemeentelijke Gemeenschappen in de Baronnies: CC du Pays de Buis, CC du Pays de Rémuzat, CC du Val d'Eygues, CC des Hautes Baronnies)."
    ]
  },
