  "rdfs:comment": {
    "de": [
      "Wir haben seit 2000 das Gütesiegel für biologischen Landbau und bauen auf unserem 30 Hektar großen Bauernhof saisonales Gemüse und Eier an"
    ],
    "en": [
      "Certified organic since 2000, we grow seasonal vegetables on our 30-hectare farm, as well as eggs"
    ],
