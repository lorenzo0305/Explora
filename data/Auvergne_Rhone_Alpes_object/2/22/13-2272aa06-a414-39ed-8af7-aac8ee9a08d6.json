  "rdfs:comment": {
    "de": [
      "Die Skischule von Chartreuse bietet Ihnen Kurse für alle Niveaus und alle Wünsche: Alpinski, Snowboard, Coaching, Skitouren, aber auch Langlauf, Biathlon und Nordic Walking. Die Aktivitäten werden an verschiedenen Standorten angeboten."
    ],
    "en": [
      "The Chartreuse Ski School offers lessons for all levels and all desires on different sites: alpine skiing, snowboarding, coaching, ski touring but also cross-country skiing, biathlon and Nordic hiking."
    ],
    "it": [
      "La Scuola di sci Chartreuse offre corsi per tutti i livelli e per tutti i gusti: sci alpino, snowboard, coaching, sci alpinismo, ma anche sci di fondo, biathlon e nordic walking. Le attività vengono proposte in diversi siti."
    ],
    "fr": [
      "L'École de ski de Chartreuse vous propose des cours pour tous les niveaux et toutes les envies : ski alpin, snowboard, coaching, ski de randonnée mais également ski de fond, biathlon et randonnée nordique. Activités proposées sur différents sites."
    ],
    "es": [
      "La Escuela de Esquí de Chartreuse ofrece cursos para todos los niveles y todos los gustos: esquí alpino, snowboard, coaching, esquí de travesía, pero también esquí de fondo, biatlón y marcha nórdica. Se ofrecen actividades en distintos lugares."
    ],
    "nl": [
      "De Skischool Chartreuse biedt cursussen voor alle niveaus en alle smaken: skiën, snowboarden, coaching, skitouren, maar ook langlaufen, biatlon en nordic walking. Op verschillende locaties worden activiteiten aangeboden."
    ]
  },
  "rdfs:label": {
