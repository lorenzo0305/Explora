  "rdfs:comment": {
    "de": [
      "Auf der Straße zum Col de Toutes Aures, 4 km vom Dorf Roybon entfernt, bietet Ihnen dieser Teich einen ruhigen Platz in den Wäldern von Chambaran, der für alle Angelfreunde angenehm ist."
    ],
    "en": [
      "Located on the road leading to the Toutes Aures col, 4 km away from the village of Roybon, this lake is a quiet spot within the Chambaran woodland popular with by all fishing enthusiasts."
    ],
    "it": [
      "Sulla strada per il Col de Toutes Aures, a 4 km dal villaggio di Roybon, questo stagno offre uno spazio tranquillo nei boschi di Chambaran, piacevole per tutti gli appassionati di pesca."
    ],
    "fr": [
      "Sur la route du col de Toutes Aures, à 4 km du village de Roybon, cet étang vous propose un espace au calme dans les bois de chambaran, agréable pour tous les amateurs de pêche."
    ],
    "nl": [
      "Op de weg naar de Col de Toutes Aures, op 4 km van het dorp Roybon, biedt deze vijver u een rustige ruimte in de bossen van Chambaran, aangenaam voor alle visliefhebbers."
    ],
    "es": [
      "En la carretera del Col de Toutes Aures, a 4 km del pueblo de Roybon, este estanque le ofrece un espacio tranquilo en el bosque de Chambaran, agradable para todos los aficionados a la pesca."
    ]
  },
