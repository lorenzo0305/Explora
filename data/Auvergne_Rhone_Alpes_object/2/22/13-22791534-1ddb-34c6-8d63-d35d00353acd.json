  "rdfs:comment": {
    "de": [
      "Die Domaine des Rutissons liegt am Fuße der Ausläufer der Chartreuse und produziert auf 7 Hektar Weinbergen, davon 1,5 Hektar alte Rebstöcke, Weine mit der g.g.A. Isère Coteaux du Grésivaudan, aus biologischem Anbau und Naturweine."
    ],
    "en": [
      "Located at the foot of the Chartreuse foothills, Domaine des Rutissons produces IGP Isère Coteaux du Grésivaudan, organic and natural wines from around 7 hectares of vines, including 1.5 hectares of old vines."
    ],
    "it": [
      "Il Domaine des Rutissons, situato ai piedi delle colline della Chartreuse, produce vini IGP Isère Coteaux du Grésivaudan, biologici e naturali, da circa 7 ettari di vigneto, di cui 1,5 ettari di vecchie viti."
    ],
    "fr": [
      "Le domaine des Rutissons situé au pied des contreforts de la Chartreuse, produit sur 7 hectares de vignes environs, dont 1,5 hectare de vieilles vignes, des vins en IGP Isère Coteaux du Grésivaudan, issus de l'Agriculture biologique et vins naturels."
    ],
    "nl": [
      "Het Domaine des Rutissons, gelegen aan de voet van de uitlopers van de Chartreuse, produceert IGP Isère Coteaux du Grésivaudan, biologische en natuurlijke wijnen van ongeveer 7 hectare wijngaarden, waarvan 1,5 hectare oude wijnstokken."
    ],
    "es": [
      "El Domaine des Rutissons, situado a los pies de las estribaciones del Chartreuse, produce vinos IGP Isère Coteaux du Grésivaudan, ecológicos y naturales, a partir de unas 7 hectáreas de viñedo, de las cuales 1,5 hectáreas son de viñas viejas."
    ]
  },
