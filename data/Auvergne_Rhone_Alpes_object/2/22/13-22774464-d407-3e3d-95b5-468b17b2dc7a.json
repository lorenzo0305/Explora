  "rdfs:comment": {
    "de": [
      "Auβergewöhnliche 360° Panoramaaussicht.  Einzigartiger Ausblick über die Alpen mit dem Mont Blanc als Höhepunkt.\r\nDank der neuen blauen Piste können sich alle Skifahrer vor der Abfahrt mit 1000 m Höhenunterschied einen Entspannungsmoment gönnen."
    ],
    "en": [
      "An incredible 360° panorama.  A unique view of the Alps with the Mont Blanc as highlight.\r\nThanks to the new blue piste, skiers of all levels can enjoy a relaxing moment before skiing down the 1000 m of vertical height fall."
    ],
    "it": [
      "Eccezionale vista panoramica a 360°.  Un panorama unico sulle Alpi, che culmina nel Monte Bianco.\r\nGrazie alla nuova pista blu, gli sciatori di ogni livello possono godersi un momento di relax prima di affrontare 1.000 metri di salita."
    ],
    "fr": [
      "Vue panoramique exeptionnelle à 360°.  Panorama unique sur les Alpes avec pour point d’orgue le Mont-Blanc.\r\nGrâce à sa nouvelle piste bleue, les skieurs de tous niveaux peuvent s’offrir un moment de détente avant d’avaler 1 000 m de dénivelé."
    ],
    "es": [
      "Vista panorámica excepcional de 360°.  Un panorama único de los Alpes que culmina en el Mont Blanc.\r\nGracias a su nueva pista azul, los esquiadores de todos los niveles pueden disfrutar de un momento de relajación antes de afrontar los 1.000 metros de ascenso."
    ],
    "nl": [
      "Uitzonderlijk 360° panoramisch uitzicht.  Een uniek panorama van de Alpen met als hoogtepunt de Mont Blanc.\r\nDankzij de nieuwe blauwe piste kunnen skiërs van alle niveaus genieten van een moment van ontspanning voordat ze een klim van 1.000 meter aangaan."
    ]
  },
  "rdfs:label": {
    "en": [
      "Point of view - Pointe de la Masse"
    ],
    "fr": [
      "Point de vue - Pointe de la Masse"
    ]
  },
