  "rdfs:comment": {
    "de": [
      "Ein Wellnessbereich, der Pflege und Entspannung gewidmet ist, am Ufer des Lac de Monteynard in Herbelon\r\nAusgestattet mit einem Infinity-Jacuzzi, einer finnischen Trockendampfsauna, einem Hammam mit Aromatherapie und Farbtherapie."
    ],
    "en": [
      "A wellness area dedicated to treatments and relaxation on the shores of Lake Monteynard in Herbelon.\r\nEquipped with an overflow Jacuzzi, a Finnish dry-steam sauna and a Hammam with aromatherapy and chromotherapy."
    ],
    "it": [
      "Un'area benessere dedicata ai trattamenti e al relax sulle rive del lago di Monteynard a Herbelon\r\nDotato di una vasca idromassaggio traboccante, una sauna finlandese a vapore secco e un bagno di vapore con aromaterapia e cromoterapia."
    ],
    "fr": [
      "Un espace bien-être dédié aux soins et à la relaxation au bord du Lac de Monteynard à Herbelon\r\nÉquipé d’un Jacuzzi à débordement, d’un Sauna Finlandais à vapeur sèche, d’un Hammam avec aromathérapie et chromothérapie."
    ],
    "es": [
      "Un espacio de bienestar dedicado a los tratamientos y la relajación a orillas del lago Monteynard, en Herbelon\r\nEquipado con un jacuzzi desbordante, una sauna finlandesa de vapor seco y una sala de vapor con aromaterapia y cromoterapia."
    ],
    "nl": [
      "Een wellnessruimte gewijd aan behandelingen en ontspanning aan de oevers van het meer van Monteynard in Herbelon\r\nUitgerust met een overvolle jacuzzi, een Finse droge-stoomsauna en een stoombad met aromatherapie en chromotherapie."
    ]
  },
  "rdfs:label": {
    "en": [
      "Summer Spa Espace Bien-être d'Herbelon"
    ],
    "fr": [
      "Summer Spa Espace Bien-être d'Herbelon"
    ]
  },
