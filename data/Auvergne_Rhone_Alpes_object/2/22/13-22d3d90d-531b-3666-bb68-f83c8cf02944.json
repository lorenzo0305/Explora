  "rdfs:comment": {
    "de": [
      "Ein Muss für jeden Feinschmecker, der etwas auf sich hält und Lust hat, das berühmte Rinderfilet Salers zu probieren. Herzlicher Empfang in einem gemütlichen Lokal."
    ],
    "en": [
      "For any self-respecting gourmet who wants to sample the famous Salers beef fillet, this restaurant is a must! In a peaceful atmosphere with all modern comforts."
    ],
    "it": [
      "Una tappa obbligata per tutti i buongustai che vogliono provare il famoso filetto di manzo di Salers. Un'accoglienza calorosa in un ambiente confortevole."
    ],
    "fr": [
      "Passage obligé de tout gourmand qui se respecte et qui a envie de déguster le fameux filet de boeuf Salers. Accueil chaleureux dans un lieu confortable."
    ],
    "es": [
      "Una visita obligada para todos los gourmets que se precien y quieran probar el famoso filete de ternera de Salers. Una cálida bienvenida en un ambiente confortable."
    ],
    "nl": [
      "Een must voor alle zichzelf respecterende fijnproevers die de beroemde Salers runderfilet willen proberen. Een warm onthaal in een comfortabele omgeving."
    ]
  },
