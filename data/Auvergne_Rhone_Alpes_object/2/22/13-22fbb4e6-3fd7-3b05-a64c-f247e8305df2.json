  "rdfs:comment": {
    "de": [
      "Im Herzen von Vieux-Lyon gelegen, bietet Ihnen dieses Restaurant die traditionelle Lyoner Küche an. Profitieren Sie im Sommer von einer angenehmen Terrasse."
    ],
    "en": [
      "Located in a very popular tourist area of Old Lyon, this restaurant proposes traditional Lyonnais cooking at its best. Don't miss the delightful terrace in summertime."
    ],
    "it": [
      "Collocato nel cuore della Lione Vecchia, questo ristorante ti propone la cucina tradizionale lionese. D'estate potrai approfittare dei tavoli all'aperto."
    ],
    "fr": [
      "Situé au cœur du Vieux-Lyon, ce restaurant vous propose la traditionnelle cuisine lyonnaise. L’été, profitez d’une agréable terrasse."
    ],
    "es": [
      "Situado en pleno barrio de Vieux-Lyon, este restaurante propone una cocina tradicional lionesa y en verano dispone de una agradable terraza."
    ],
    "nl": [
      "Dit restaurant ligt in het hart van het oude Lyon en biedt traditionele Lyonnaise gerechten. In de zomer kunt u genieten van het aangename terras."
    ]
  },
