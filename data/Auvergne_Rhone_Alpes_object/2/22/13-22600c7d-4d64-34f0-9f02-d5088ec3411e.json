  "rdfs:comment": {
    "de": [
      "Cristelle und Nicolas heißen Sie in ihrem Hotel wie zu Hause willkommen. Das Hotel befindet sich auf der Achse Lyon-Paris und in der Nähe der Sehenswürdigkeiten von Roanne. 41 renovierte und klimatisierte Zimmer mit kostenlosem WLAN, geschlossener Parkplatz."
    ],
    "en": [
      "Cristelle and Nicolas give you a home-from-home welcome to their hotel. It is situated on the main Lyon to Paris axis and is near the tourists'spots of Roanne. 41 air-conditioned renovated bedrooms with free wifi. Closed car park."
    ],
    "it": [
      "Cristelle e Nicolas vi accolgono nel loro hotel come se foste a casa vostra. L'hotel si trova sulla rotta Lione-Parigi e vicino alle attrazioni turistiche di Roanne. 41 camere rinnovate e climatizzate con wifi gratuito, parcheggio chiuso."
    ],
    "fr": [
      "Cristelle et Nicolas vous accueillent dans leur hôtel comme à la maison. L'hôtel est situé sur l'axe Lyon-Paris et à proximité des lieux touristiques de Roanne. 41 chambres rénovées et climatisées avec wifi gratuit, parking fermé."
    ],
    "es": [
      "Cristelle y Nicolas le dan la bienvenida a su hotel como si estuviera en casa. El hotel está en la ruta Lyon-París y cerca de las atracciones turísticas de Roanne. 41 habitaciones renovadas y climatizadas con wifi gratuito, aparcamiento cerrado."
    ],
    "nl": [
      "Cristelle en Nicolas heten je welkom in hun hotel alsof je thuis bent. Het hotel ligt op de route Lyon-Parijs en dicht bij de toeristische attracties van Roanne. 41 gerenoveerde kamers met airconditioning en gratis wifi, afgesloten parkeerplaats."
    ]
  },
