  "rdfs:comment": {
    "de": [
      "Mit Leidenschaft und dem Blick auf die Umwelt werden die Käse nach alter Tradition hergestellt. Sie können die Arbeit vom Herstellungslabor bis zum Melken vom Laden oder vom Ziegenstall aus verfolgen und miterleben."
    ],
    "en": [
      "Passionate about the environment, our cheeses are made with respect for tradition. You can follow and share in the work, from the production laboratory to milking, from the store or the goat barn."
    ],
    "it": [
      "Appassionati di ambiente, i nostri formaggi sono prodotti in modo tradizionale. Potete seguire e condividere il lavoro, dal laboratorio di produzione alla mungitura, dal negozio o dalla capraia."
    ],
    "fr": [
      "Passionnés et tournés vers le respect de l'environnement, les fromages sont fabriqués dans le respect des traditions. Vous pourrez suivre et partager le travail, du laboratoire de fabrication à la traite, depuis le magasin ou depuis la chèvrerie."
    ],
    "nl": [
      "Gepassioneerd door het milieu, worden onze kazen op traditionele wijze gemaakt. Je kunt het werk volgen en eraan deelnemen, van het productielaboratorium tot het melken, vanuit de winkel of het geitenhuis."
    ],
    "es": [
      "Apasionados por el medio ambiente, nuestros quesos se elaboran de forma tradicional. Puede seguir y compartir el trabajo, desde el laboratorio de producción hasta el ordeño, desde la tienda o la cabrería."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chèvrerie du Charava"
    ]
  },
