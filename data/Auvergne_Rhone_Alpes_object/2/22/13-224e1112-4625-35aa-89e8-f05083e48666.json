  "rdfs:comment": {
    "de": [
      "Familienweinberg von 15 ha. AOC-Weine Côte Roannaise rot, rosé. Weiße und süße Vins de Pays d'Urfé und Roséweine. Weiße und roséfarbene Perlweine aus Frankreich.\r\nLieferung auf Anfrage."
    ],
    "en": [
      "Family vineyard of 15 ha. AOC Côte Roannaise reds and rosés. Pays d'Urfé white and sweet rosé wines. Sparkling white and rosé vins de France.\r\nDelivery on request."
    ],
    "it": [
      "Vigneto familiare di 15 ettari. Vini rossi e rosati AOC Côte Roannaise. Vini bianchi e rosati dolci del Pays d'Urfé. Vins de France bianchi e rosati frizzanti.\r\nConsegna su richiesta."
    ],
    "fr": [
      "Vignoble familial de 15 ha. Vins AOC Côte Roannaise rouges, rosés. Vins de Pays d'Urfé blancs et rosés doux. Pétillants blancs et rosés en vins de France.\r\nLivraison à la demande."
    ],
    "es": [
      "Viñedo familiar de 15 ha. Vinos tintos y rosados AOC Côte Roannaise. Vinos blancos y rosados dulces del Pays d'Urfé. Vinos espumosos blancos y rosados de Francia.\r\nEntrega por encargo."
    ],
    "nl": [
      "Familiewijngaard van 15 ha. AOC Côte Roannaise rode en rosé wijnen. Pays d'Urfé witte en zoete roséwijnen. Mousserende witte en rosé vins de France.\r\nLevering op aanvraag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vignoble de Champagny - Frédéric Villeneuve"
    ]
  },
