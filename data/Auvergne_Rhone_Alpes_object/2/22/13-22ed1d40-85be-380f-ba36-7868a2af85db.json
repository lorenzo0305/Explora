  "rdfs:comment": {
    "de": [
      "Auf dieser für Familien geeigneten Strecke können Sie schöne Aussichtspunkte über die Weinberge und die Teiche des Biterne-Reservats entdecken."
    ],
    "en": [
      "This family-friendly trail offers lovely views over the vineyards and ponds of the Biterne reserve."
    ],
    "it": [
      "Questo percorso adatto alle famiglie offre una bella vista sui vigneti e sugli stagni della riserva di Biterne."
    ],
    "fr": [
      "Ce parcours accessible aux familles vous permet de découvrir de jolis points de vue sur la vigne et les étangs de la réserve de Biterne."
    ],
    "es": [
      "Este sendero familiar ofrece hermosas vistas de los viñedos y estanques de la reserva de Biterne."
    ],
    "nl": [
      "Dit gezinsvriendelijke pad biedt prachtige uitzichten over de wijngaarden en vijvers van het Biterne-reservaat."
    ]
  },
