  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/af1d21f3-3f2f-3992-98d6-3fb47ef9f929",
      "dc:description": {
        "de": [
          "Die Xtrem Riders laden Sie zu einem verrückten Abend ein.\n\n2.500 ? an Preisen zu gewinnen\nIn Zusammenarbeit mit Phil Déco\n\nGetränke und Speisen vor Ort\n\nVerbringen Sie eine tolle Zeit mit Freunden oder der Familie, die Stimmung ist garantiert!"
        ],
        "en": [
          "The Xtrem Riders are looking forward to a wild evening.\n\n2,500 ? prizes to be won\nIn collaboration with Phil Déco\n\nRefreshments and catering on site\n\nCome and have a great time with friends or family, atmosphere guaranteed!"
        ],
        "it": [
          "Gli Xtrem Riders si aspettano una serata selvaggia.\n\n2.500 premi in palio\nIn collaborazione con Phil Déco\n\nRinfresco e cibo sul posto\n\nVenite a divertirvi con gli amici o la famiglia, l'atmosfera è garantita!"
        ],
        "fr": [
          "Les Xtrem Riders vous donnent rendez-vous pour une soirée de folie. \n\n2 500 € de lots à gagner\nEn collaboration avec Phil Déco\n\nBuvette et restauration sur place\n\nVenez passer un super moment entre amis ou en famille, ambiance garantie !"
        ],
        "nl": [
          "De Xtrem Riders kijken uit naar een wilde avond.\n\n2.500 prijzen te winnen\nIn samenwerking met Phil Déco\n\nVersnaperingen en eten ter plaatse\n\nKom en heb een geweldige tijd met vrienden of familie, sfeer gegarandeerd!"
        ],
        "es": [
          "A los Xtrem Riders les espera una noche salvaje.\n\n2.500 € en premios\nEn colaboración con Phil Déco\n\nRefrescos y comida in situ\n\nVen a pasarlo en grande con amigos o en familia, ¡el ambiente está garantizado!"
        ]
      },
      "@type": [
        "Description"
      ],
