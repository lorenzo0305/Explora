      "@id": "https://data.datatourisme.fr/81a38819-89a0-3204-89ae-7b93a343d954",
      "dc:description": {
        "de": [
          "Treffpunkt: 9:00 Uhr auf dem Parkplatz La Cachaine.\nEntdeckungswanderung von 7 km (2 Stunden) über die Geschichte und die Architektur von Saint-Etienne-au-Mont\nNach Anmeldung"
        ],
        "en": [
          "Meet at 9:00 am at the Cachaine parking lot.\n7 km (2-hour) discovery walk on the history and architecture of Saint-Etienne-au-Mont\nRegistration required"
        ],
        "it": [
          "Ritrovo alle 9.00 al parcheggio della Cachaine.\nPasseggiata di 7 km (2 ore) sulla storia e l'architettura di Saint-Etienne-au-Mont\nIscrizione obbligatoria"
        ],
        "fr": [
          "Rendez-vous à 9h00 au du parking de la Cachaine.\nRandonnée découverte de 7 km (2 heures) sur l'histoire et l'architecture de Saint-Etienne-au-Mont\nSur inscription"
        ],
        "nl": [
          "Verzamelen om 9.00 uur op de parkeerplaats van Cachaine.\nWandeling van 7 km (2 uur) over de geschiedenis en architectuur van Saint-Etienne-au-Mont\nRegistratie verplicht"
        ],
        "es": [
          "Encuentro a las 9.00 h en el aparcamiento de la Cachaine.\nPaseo de 7 km (2 horas) sobre la historia y la arquitectura de Saint-Etienne-au-Mont\nInscripción obligatoria"
        ]
      },
