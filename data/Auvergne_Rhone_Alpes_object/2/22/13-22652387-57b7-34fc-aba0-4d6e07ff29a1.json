  "rdfs:comment": {
    "de": [
      "Nehmen Sie Platz im Gentiane-Express, eine unvergessliche Reise in den Regionalen Naturpark der Volcans d’Auvergne erwartet Sie, von Riom-ès-Montagnes bis nach Lugarde auf dem Hochplateau des Cézallier.\r\nVoranmeldung empfohlen."
    ],
    "en": [
      "Get aboard the Gentaine Express for an unforgettable commented tour in the heart of the Pays Gentiane ! Departing from the train station in Riom-ès-Montagnes, our tourist train will lead you to the vast horizons of the Cezallier Plateau."
    ],
    "it": [
      "Da Riom-ès-Montagnes a Lugarde, viaggiate su una delle più belle ferrovie di montagna della Francia, che ha ormai un secolo di vita."
    ],
    "fr": [
      "De Riom-ès-Montagnes à Lugarde, voyagez sur une des plus belles lignes de chemin de fer de montagne en France, aujourd'hui centenaire."
    ],
    "nl": [
      "Reis van Riom-ès-Montagnes naar Lugarde over een van de mooiste bergspoorwegen van Frankrijk, nu een eeuw oud."
    ],
    "es": [
      "De Riom-ès-Montagnes a Lugarde, viaje en uno de los ferrocarriles de montaña más bellos de Francia, ahora centenario."
    ]
  },
