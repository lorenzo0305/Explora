  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, Ideen zum Nähen oder Stricken auszutauschen? Lust, etwas zu lernen? Oder einfach nur einen geselligen Moment zu verbringen? Treffpunkt jeden zweiten Samstag im Monat von 15:00 bis 17:00 Uhr in der Bar Le 102."
    ],
    "en": [
      "Want to share sewing or knitting ideas? Want to learn? Or simply to spend a convivial moment... Meet up every 2nd Saturday of the month, from 3pm to 5pm at Bar Le 102."
    ],
    "it": [
      "Volete condividere idee di cucito o di lavoro a maglia? Volete imparare? O semplicemente volete passare un po' di tempo insieme... Ci incontriamo ogni 2° sabato del mese, dalle 15.00 alle 17.00, presso il Bar Le 102."
    ],
    "fr": [
      "Envie de partager des idées de couture ou de tricot ? Envie d'apprendre ? Ou simplement de passer un moment convivial... RDV chaque 2e samedi du mois, de 15h à 17h au Bar Le 102."
    ],
    "es": [
      "¿Quieres compartir ideas de costura o punto? ¿Quieres aprender? O simplemente pasar un rato juntos... Nos reunimos el segundo sábado de cada mes, de 15.00 a 17.00 horas, en el Bar Le 102."
    ],
    "nl": [
      "Wil je naai- of brei-ideeën delen? Wil je het leren? Of wil je gewoon wat tijd met elkaar doorbrengen... Ontmoet elkaar elke 2e zaterdag van de maand, van 15.00 tot 17.00 uur in Bar Le 102."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café couture"
    ]
  },
