  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist eine Familiengeschichte der Geschmäcker und des Teilens, in der natürlichen Umgebung des Grand Large! Entdecken Sie ein tägliches Buffet und syrische Spezialitäten."
    ],
    "en": [
      "This restaurant is a family affair, a story of taste and sharing, in the natural setting of the Grand Large! Discover a daily buffet and Syrian specialties."
    ],
    "it": [
      "Questo ristorante è un affare di famiglia, fatto di sapori e condivisione, nella cornice naturale di Grand Large! Scoprite un buffet giornaliero e le specialità siriane."
    ],
    "fr": [
      "Ce restaurant est une histoire familiale, de goûts et de partage, dans le cadre naturel du Grand Large ! Découvrez un buffet quotidien et des spécialités syriennes."
    ],
    "es": [
      "Este restaurante es un asunto de familia, de sabores y de compartir, ¡en el marco natural de Grand Large! Descubra un bufé diario y especialidades sirias."
    ],
    "nl": [
      "Dit restaurant is een familieaangelegenheid, over smaken en delen, in de natuurlijke omgeving van Grand Large! Ontdek het dagelijkse buffet en de Syrische specialiteiten."
    ]
  },
