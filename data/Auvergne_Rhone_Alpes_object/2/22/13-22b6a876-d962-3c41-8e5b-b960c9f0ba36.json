      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/2b5f90de-d764-347d-af7b-576f16c66d59",
          "schema:validFrom": "2026-06-15T00:00:00",
          "schema:validThrough": "2026-03-15T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Von Mitte März bis Mitte Juni verbietet ein Erlass den Zugang zum Gelände. Wanderfalken bauen in dieser Zeit dort ihre Nester und füttern ihre Jungen nicht mehr, wenn sie sich auf den Wegen aufhalten."
            ],
            "en": [
              "From mid-March to mid-June a decree forbids access to the site. The peregrine falcon establishes its nest during this period and no longer feeds its young in case of presence on the tracks."
            ],
            "it": [
              "Da metà marzo a metà giugno un decreto vieta l'accesso al sito. Il falco pellegrino stabilisce il suo nido in questo periodo e non nutre più i suoi piccoli se è presente sulle piste."
            ],
            "fr": [
              "De mi-mars à mi-juin un arrêté interdit l'accès au site. Le faucon pélerin y établit son nid à cette période et n'alimente plus ses petits en cas de présence sur les voies."
            ],
            "nl": [
              "Van half maart tot half juni verbiedt een decreet de toegang tot het terrein. De slechtvalk vestigt dan zijn nest en voedt zijn jongen niet meer als hij op de sporen aanwezig is."
            ],
            "es": [
              "Desde mediados de marzo hasta mediados de junio, un decreto prohíbe el acceso al lugar. El halcón peregrino establece su nido en este momento y ya no alimenta a sus crías si está presente en las pistas."
            ]
          },
