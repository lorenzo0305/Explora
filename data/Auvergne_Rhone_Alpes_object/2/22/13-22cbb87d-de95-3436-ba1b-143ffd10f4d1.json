  "rdfs:comment": {
    "de": [
      "Erleben Sie die Magie des Kultfilms Flashdance im Rampenlicht! Das Musical beleuchtet die Odyssee von Alex, die tagsüber Stahlarbeiterin und nachts Tänzerin ist und davon träumt, ein Star zu werden."
    ],
    "en": [
      "Relive the magic of the cult film Flashdance under the spotlight! This vibrant musical follows the odyssey of Alex, steelworker by day, dancer by night, dreaming of becoming a star."
    ],
    "it": [
      "Rivivete la magia del film cult Flashdance sotto i riflettori! Questo vivace musical segue l'odissea di Alex, operaio d'acciaio di giorno e ballerino di notte, che sogna di diventare una star."
    ],
    "fr": [
      "Revivez la magie du film culte Flashdance sous les feux de la scène ! Cette comédie musicale vibrante met en lumière l’odyssée d’Alex, ouvrière en aciérie le jour, danseuse la nuit, rêvant de devenir une star."
    ],
    "es": [
      "¡Revive la magia de la película de culto Flashdance bajo los focos! Este vibrante musical sigue la odisea de Alex, un obrero siderúrgico de día y bailarín de noche, que sueña con convertirse en una estrella."
    ],
    "nl": [
      "Herbeleef de magie van de cultfilm Flashdance onder de schijnwerpers! Deze levendige musical volgt de odyssee van Alex, overdag een staalarbeider en 's nachts een danser, die ervan droomt een ster te worden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Flashdance, le musical tour 2027"
    ]
  },
