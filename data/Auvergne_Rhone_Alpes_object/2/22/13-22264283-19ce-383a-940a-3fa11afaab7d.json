  "rdfs:comment": {
    "de": [
      "Sylvianne Giriat - Handwerker für Innendekoration\r\nHerstellung von verschiedenen Gegenständen aus Holz, Kork, Korbwaren und Flechtwerk\r\nSeit über 30 Jahren entwirft und vertreibt Jardin des lutins qualitativ hochwertige Dekorationsartikel zu erschwinglichen Preisen."
    ],
    "en": [
      "Sylvianne Giriat - Artisans de la décoration Intérieure\r\nManufacture of various objects in wood, cork, wickerwork and straw\r\nFor more than 30 years, Jardin des lutins has been creating and selling high-quality home decor items at affordable prices."
    ],
    "it": [
      "Sylvianne Giriat - Artigiani della decorazione d'interni\r\nProduzione di vari oggetti in legno, sughero, vimini e spartito\r\nDa oltre 30 anni, Jardin des lutins crea e vende oggetti decorativi di alta qualità a prezzi accessibili."
    ],
    "fr": [
      "Sylvianne Giriat - Artisans de la décoration Intérieure\r\nFabrication d'objets divers en bois, liège, vannerie et sparterie\r\nDepuis plus de 30 ans, Jardin des lutins crée et commercialise des articles de décoration de haute qualité à des prix abordables."
    ],
    "es": [
      "Sylvianne Giriat - Artesanos de la decoración de interiores\r\nFabricación de objetos diversos en madera, corcho, mimbre y esparto\r\nDesde hace más de 30 años, Jardin des lutins crea y vende objetos de decoración de gran calidad a precios asequibles."
    ],
    "nl": [
      "Sylvianne Giriat - Ambachtelijke interieurdecorateurs\r\nVervaardiging van diverse objecten van hout, kurk, vlechtwerk en espartowerk\r\nJardin des lutins creëert en verkoopt al meer dan 30 jaar decoratieve voorwerpen van hoge kwaliteit tegen betaalbare prijzen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin des lutins"
    ]
  },
