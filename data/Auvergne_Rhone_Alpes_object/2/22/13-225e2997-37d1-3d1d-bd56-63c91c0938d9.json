  "rdfs:comment": {
    "de": [
      "Willkommen in Howard's Pub, der unumgänglichen Adresse in Val Cenis, um gut zu essen, sich zu entspannen und zu jeder Jahreszeit eine gemütliche Atmosphäre zu genießen. Hausgemachte Burger aus frischen Zutaten!"
    ],
    "en": [
      "Welcome to Howard's Pub, the place to eat, relax and enjoy Val Cenis in all seasons. Homemade burgers made with fresh produce!"
    ],
    "it": [
      "Benvenuti all'Howard's Pub, il posto giusto in Val Cenis per mangiare bene, rilassarsi e godere di un'atmosfera accogliente tutto l'anno. Hamburger fatti in casa con prodotti freschi!"
    ],
    "fr": [
      "Bienvenue à Howard's Pub, l'adresse incontournable de Val Cenis pour bien manger, se détendre et profiter d'une ambiance chaleureuse en toute saison. Burgers faits maison avec des produits frais !"
    ],
    "nl": [
      "Welkom bij Howard's Pub, de place to be in Val Cenis als u het hele jaar door lekker wilt eten, ontspannen en genieten van een warme sfeer. Huisgemaakte hamburgers met verse producten!"
    ],
    "es": [
      "Bienvenido a Howard's Pub, el lugar donde hay que estar en Val Cenis si quieres comer bien, relajarte y disfrutar de un ambiente cálido durante todo el año. ¡Hamburguesas caseras elaboradas con productos frescos!"
    ]
  },
