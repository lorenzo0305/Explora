  "rdfs:comment": {
    "de": [
      "Ein Andenken an Ihre Jugend! Eine Fahrt mit Ihrem Moped, die Sie an die Ausflüge mit Freunden erinnern wird. Lassen Sie Ihr 2-Rad nicht länger verstauben und bringen Sie es zum Rollen."
    ],
    "en": [
      "Memories of youth! A ride on your moped that will remind you of outings with friends. Don't let your 2-wheeler gather dust, let it roll."
    ],
    "it": [
      "Ricordi di gioventù! Un giro in motorino che vi ricorderà le uscite con gli amici. Non lasciate che la vostra 2 ruote prenda polvere: fatela girare!"
    ],
    "fr": [
      "Souvenir de jeunesse ! Une virée avec votre mob qui vous rappellera les sorties entre copains. Ne laissez plus votre 2 roues prendre  la poussière et faites le rouler."
    ],
    "es": [
      "Recuerdos de tu juventud Un paseo en tu ciclomotor que te recordará las salidas con los amigos. No dejes que tu 2 ruedas acumule polvo, ¡ponla a rodar!"
    ],
    "nl": [
      "Herinneringen aan je jeugd! Een ritje op je brommer dat je zal herinneren aan uitstapjes met vrienden. Laat je tweewieler geen stof verzamelen - laat hem rijden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sortie Mobylettes"
    ]
  },
