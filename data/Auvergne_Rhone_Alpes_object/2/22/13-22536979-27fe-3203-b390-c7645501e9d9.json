  "rdfs:comment": {
    "de": [
      "Nathalie, Frédéric und ihr gesamtes Team heißen Sie in einem gemütlichen Rahmen willkommen. Entdecken Sie eine traditionelle \"hausgemachte\" Küche mit frischen Produkten. Spezialität: Froschschenkel das ganze Jahr über."
    ],
    "en": [
      "In completely renovated rooms, come and discover a traditional homemade cooking based on local fresh products. Our speciality : frogs’ legs"
    ],
    "it": [
      "Nathalie, Frédéric e il loro team vi accolgono in un'atmosfera calorosa. Venite a scoprire la cucina tradizionale casalinga a base di prodotti freschi. Specialità: cosce di rana tutto l'anno."
    ],
    "fr": [
      "Nathalie, Frédéric et toute son équipe vous accueillent dans un cadre chaleureux. Venez découvrir une cuisine traditionnelle \"fait maison\" avec des produits frais. Spécialité : cuisses de grenouilles toute l'année."
    ],
    "es": [
      "Nathalie, Frédéric y su equipo le dan la bienvenida en un ambiente acogedor. Venga a descubrir la cocina casera tradicional elaborada con productos frescos. Especialidad: ancas de rana todo el año."
    ],
    "nl": [
      "Nathalie, Frédéric en hun team heten je welkom in een warme sfeer. Kom en ontdek de traditionele huisgemaakte keuken met verse producten. Specialiteit: kikkerbilletjes het hele jaar door."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ma Chaumière"
    ]
  },
