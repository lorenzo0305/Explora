  "rdfs:comment": {
    "de": [
      "Meilleur Ouvrier de France in Gravur.\r\nSchöpfer von zwei Messern: Allanche und Cézallier.\r\nSchöpfer von Schmuckstücken.\r\nVerkauf von Schmuck und Messern, die aus seiner Schöpfung hervorgegangen sind."
    ],
    "en": [
      "Meilleur Ouvrier de France in engraving.\r\nCreator of two knives: the Allanche and the Cézallier.\r\nJewelry designer.\r\nSale of jewelry and knives created by him."
    ],
    "it": [
      "Meilleur Ouvrier de France in incisione.\r\nCreatore di due coltelli: l'Allanche e il Cézallier.\r\nDisegnatore di gioielli.\r\nVendita di gioielli e coltelli da lui creati."
    ],
    "fr": [
      "Meilleur Ouvrier de France en gravure. \r\nCréateur de deux couteaux : l'Allanche et le Cézallier. \r\nCréateur de bijoux.\r\nVente de bijoux et couteaux issus de sa création."
    ],
    "nl": [
      "Meilleur Ouvrier de France in gravure.\r\nOntwerper van twee messen: de Allanche en de Cézallier.\r\nOntwerper van juwelen.\r\nVerkoop van door hem ontworpen sieraden en messen."
    ],
    "es": [
      "Meilleur Ouvrier de France en grabado.\r\nCreador de dos cuchillos: el Allanche y el Cézallier.\r\nDiseñador de joyas.\r\nVenta de joyas y cuchillos creados por él."
    ]
  },
  "rdfs:label": {
