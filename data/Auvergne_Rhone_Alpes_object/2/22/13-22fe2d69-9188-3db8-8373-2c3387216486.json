  "rdfs:comment": {
    "de": [
      "Dieses Bar-Restaurant im Herzen von Vorey/Arzon bietet Ihnen eine Snack-Küche, Pizza, das Tagesmenü am Mittag und Menüs am Abend\r\nBei schönem Wetter können Sie die Terrasse nutzen."
    ],
    "en": [
      "This bar-restaurant, located in the heart of Vorey/Arzon, offers you a snack kitchen, pizzas, the daily menu at lunchtime and menus in the evening\r\nWhen the weather is nice, you can enjoy the terrace."
    ],
    "it": [
      "Questo bar-ristorante, situato nel cuore di Vorey/Arzon, offre spuntini, pizze, il menù del pranzo giornaliero e i menù serali\r\nCon il bel tempo si può godere della terrazza."
    ],
    "fr": [
      "Ce bar restaurant, situé au coeur de Vorey/Arzon, vous propose une cuisine snack, des pizzas, le menu du jour à midi et des menus le soir. \r\nPar beau temps, vous pourrez profiter de la terrasse."
    ],
    "es": [
      "Este bar-restaurante, situado en el corazón de Vorey/Arzón, ofrece comida para picar, pizzas, el menú del día y menús de noche\r\nCuando hace buen tiempo, se puede disfrutar de la terraza."
    ],
    "nl": [
      "Dit bar-restaurant, gelegen in het hart van Vorey/Arzon, biedt snacks, pizza's, het dagelijkse lunchmenu en avondmenu's\r\nBij mooi weer kunt u genieten van het terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hotel-Restaurant les Voyageurs"
    ]
  },
