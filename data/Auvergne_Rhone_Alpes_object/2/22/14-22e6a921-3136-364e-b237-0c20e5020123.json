  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2696d64b-521c-385e-9c2d-cf1e4c6854a3",
      "dc:description": {
        "de": [
          "15 KM LANGER MOUNTAINBIKE-TRAIL - 1,5 STUNDEN\nSTART HINTER DEM KERAMIKMUSEUM\n BRAUNE MARKIERUNG MIT DER ZAHL 1\n\nFinden Sie den Verlauf der Strecke in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "15 KM MOUNTAIN BIKE TRAIL - 1 H 30\nSTART BEHIND THE CERAMICS MUSEUM\n BROWN MARKINGS WITH THE NUMBER 1\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "15 KM DI PERCORSO IN MOUNTAIN BIKE - 1 H 30\nINIZIA DIETRO IL MUSEO DELLA CERAMICA\n CONTRASSEGNATO IN MARRONE CON IL NUMERO 1\n\nPotete trovare il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER  VTT  DE 15 KM - 1 H 30\nDEPART DERRIERE LE MUSEE DE LA CERAMIQUE\n BALISAGE EN MARRON AVEC LE CHIFFRE 1\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA EN BICICLETA DE MONTAÑA DE 15 KM - 1 H 30\nCOMIENZA DETRÁS DEL MUSEO DE CERÁMICA\n SEÑALIZADO EN MARRÓN CON EL NÚMERO 1\n\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "15 KM MOUNTAINBIKEROUTE - 1 H 30\nSTART ACHTER HET KERAMIEKMUSEUM\n GEMARKEERD IN BRUIN MET HET NUMMER 1\n\nJe kunt de route vinden op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
      "@type": [
        "Description"
      ],
