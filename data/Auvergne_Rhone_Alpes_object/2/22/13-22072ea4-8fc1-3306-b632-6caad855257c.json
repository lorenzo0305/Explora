  "rdfs:comment": {
    "de": [
      "Erleben Sie die Euphorie der Ferien im Herzen der berühmten Nationalstraße 7. Die Ferienstraße reimt sich auf Charles Trenet, Staus und Nougat?"
    ],
    "en": [
      "Come and relive the euphoria of the vacations, in the heart of the famous Nationale 7. The road to vacation rhymes with Charles Trenet, traffic jams, nougats?"
    ],
    "it": [
      "Venite a rivivere l'euforia delle vacanze, nel cuore della celebre Nationale 7. Il percorso delle vacanze fa rima con Charles Trenet, ingorghi, torroni?"
    ],
    "fr": [
      "Venez revivre, l'euphorie des vacances, au cœur de la célèbre Nationale 7. La route des vacances rime avec Charles Trenet, les bouchons, les nougats…."
    ],
    "es": [
      "Venga a revivir la euforia de las fiestas, en el corazón de la famosa Nationale 7. La ruta de las vacaciones rima con Charles Trenet, atascos, turrones..."
    ],
    "nl": [
      "Kom en herbeleef de euforie van de feestdagen, in het hart van de beroemde Nationale 7. De vakantieroute rijmt op Charles Trenet, files, nougats?"
    ]
  },
  "rdfs:label": {
