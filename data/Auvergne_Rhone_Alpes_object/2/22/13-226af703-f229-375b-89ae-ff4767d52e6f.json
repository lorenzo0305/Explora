  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet die Möglichkeit, Romane, Comics, Dokumentarfilme, Alben, Krimis und Zeitschriften im Erwachsenen- und Jugendbereich vor Ort zu konsultieren oder auszuleihen. Für die regelmäßige Ausleihe von Dokumenten ist eine individuelle Anmeldung erforderlich."
    ],
    "en": [
      "The library offers on-site consultation or borrowing of novels, comics, documentaries, albums, detective stories and magazines in the adult and children's sections. Individual registration is required for regular borrowing."
    ],
    "it": [
      "La biblioteca offre la possibilità di consultare o prendere in prestito romanzi, fumetti, documentari, album, gialli e riviste nelle sezioni per adulti e per bambini. Per il prestito regolare di documenti è necessaria una registrazione individuale."
    ],
    "fr": [
      "La Bibliothèque propose la consultation sur place ou l’emprunt de romans, bandes dessinées, documentaires, albums, policiers et magazines dans l’espace adulte et jeunesse. Pour l’emprunt régulier de documents, une inscription individuelle est obligatoire."
    ],
    "es": [
      "La biblioteca ofrece la posibilidad de consultar o tomar en préstamo novelas, cómics, documentales, álbumes, novelas policíacas y revistas en las secciones de adultos y niños. Para el préstamo regular de documentos, se requiere un registro individual."
    ],
    "nl": [
      "De bibliotheek biedt de mogelijkheid om ter plekke romans, strips, documentaires, albums, detectiveverhalen en tijdschriften te raadplegen of te lenen in de afdelingen voor volwassenen en kinderen. Personen moeten zich registreren om regelmatig documenten te kunnen lenen."
    ]
  },
