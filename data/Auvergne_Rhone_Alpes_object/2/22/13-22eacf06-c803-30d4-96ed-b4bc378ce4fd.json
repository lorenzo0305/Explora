  "rdfs:comment": {
    "de": [
      "Die Kirche von Pusignan befindet sich am Place de la Mairie, gleich rechts neben dem Rathaus.\r\nSie ist Notre-Dame de l'Assomption geweiht."
    ],
    "en": [
      "The church of Pusignan is located on the Place de la Mairie, just to the right of the town hall.\r\nIt is dedicated to Our Lady of the Assumption."
    ],
    "it": [
      "La chiesa di Pusignan si trova in Place de la Mairie, a destra del municipio.\r\nÈ dedicata a Nostra Signora dell'Assunzione."
    ],
    "fr": [
      "L'église de Pusignan est située place de la Mairie, juste à droite de la mairie.\r\nElle est dédiée à Notre-Dame de l'Assomption."
    ],
    "es": [
      "La iglesia de Pusignan se encuentra en la plaza de la Mairie, justo a la derecha del ayuntamiento.\r\nEstá dedicada a Nuestra Señora de la Asunción."
    ],
    "nl": [
      "De kerk van Pusignan staat op de Place de la Mairie, net rechts van het stadhuis.\r\nHet is gewijd aan Onze Lieve Vrouw van de Assumptie."
    ]
