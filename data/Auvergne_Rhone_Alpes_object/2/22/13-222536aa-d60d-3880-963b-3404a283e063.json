  "rdfs:comment": {
    "de": [
      "Das Empfangsteam steht Ihnen zur Verfügung, um Ihnen bei der Vorbereitung Ihres Aufenthalts zu helfen und Sie über die Animationen, Aktivitäten, Spaziergänge und alle im Dorf vorhandenen Dienstleistungen zu informieren, damit Sie einen unvergesslichen Urlaub in Bessans verbringen können."
    ],
    "en": [
      "The reception team is at your disposal to help you prepare your stay and to inform you about the activities, the walks and all the services available in the village so that you spend unforgettable holidays in Bessans."
    ],
    "it": [
      "Lo staff della reception è a vostra disposizione per aiutarvi a preparare il vostro soggiorno e per informarvi sulle attività, le passeggiate e tutti i servizi disponibili nel villaggio affinché possiate trascorrere delle vacanze indimenticabili a Bessans."
    ],
    "fr": [
      "L'équipe d'accueil est à votre disposition pour vous aider à préparer votre séjour  et vous informer sur les animations, les activités, les balades et tous les services présents sur le village afin que vous passiez d'inoubliables vacances à Bessans."
    ],
    "nl": [
      "Het receptieteam staat tot uw beschikking om u te helpen uw verblijf voor te bereiden en u te informeren over de activiteiten, de wandelingen en alle diensten die in het dorp beschikbaar zijn, zodat u een onvergetelijke vakantie in Bessans zult doorbrengen."
    ],
    "es": [
      "El equipo de recepción está a su disposición para ayudarle a preparar su estancia e informarle sobre las actividades, los paseos y todos los servicios disponibles en el pueblo para que pase unas vacaciones inolvidables en Bessans."
    ]
  },
  "rdfs:label": {
