  "rdfs:comment": {
    "de": [
      "Das Club-Resort MMV Les 2 domaines**** liegt am Fuße der Pisten und vereint Komfort und Wohlbefinden. Seine hellen Appartements mit Balkon oder Terrasse veredeln Ihren Aufenthalt, während sein SPA, das auch externen Gästen offen steht, Pflegebehandlungen und Massagen auf Reservierung anbietet."
    ],
    "en": [
      "After your ski day or as a relaxing break during a day off from skiing, Le Spa by MMV is the perfect place to recharge your batteries."
    ],
    "it": [
      "Dopo lo sci o per una pausa rilassante senza sci, la Spa by MMV è il luogo ideale per ricaricare le batterie."
    ],
    "fr": [
      "Après le ski ou pour une pause détente sans chausser les skis, le Spa by MMV est l’endroit idéal pour se ressourcer."
    ],
    "nl": [
      "Na het skiën of voor een ontspannende pauze zonder ski's aan, is de Spa by MMV de ideale plek om nieuwe energie op te doen."
    ],
    "es": [
      "Después de esquiar o para un descanso relajante sin esquís, el Spa by MMV es el lugar ideal para recargar las pilas."
    ]
  },
