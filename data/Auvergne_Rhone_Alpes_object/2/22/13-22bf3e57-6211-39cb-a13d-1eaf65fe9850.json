  "rdfs:comment": {
    "de": [
      "Makondo Accessoires bietet eine Reihe von Accessoires aus gebrauchten Textilien und bestickten Schmuckstücken. Die handgefertigten Stücke in limitierter Auflage vereinen verschiedene Fertigkeiten in einem zeitgenössischen Stil."
    ],
    "en": [
      "Makondo Accessoires offers a range of accessories created from single-use textiles and embroidered jewelry. Hand-crafted in limited series, these pieces combine different skills in a contemporary style."
    ],
    "it": [
      "Makondo Accessoires propone una gamma di accessori creati con tessuti inutilizzati e gioielli ricamati. Realizzati a mano in serie limitata, questi pezzi combinano diverse abilità in uno stile contemporaneo."
    ],
    "fr": [
      "Makondo Accessoires propose une gamme d'accessoires créés à partir de textiles unitilisés et de bijoux brodés. Des pièces fabriqués à la main en séries limitée qui allient différents savoir-faire dans un style contemporain ."
    ],
    "es": [
      "Makondo Accessoires ofrece una gama de accesorios creados a partir de tejidos en desuso y joyas bordadas. Fabricadas a mano en series limitadas, estas piezas combinan distintas habilidades en un estilo contemporáneo."
    ],
    "nl": [
      "Makondo Accessoires biedt een assortiment accessoires gemaakt van ongebruikt textiel en geborduurde sieraden. Deze stukken worden in beperkte series met de hand gemaakt en combineren verschillende vaardigheden in een eigentijdse stijl."
    ]
  },
