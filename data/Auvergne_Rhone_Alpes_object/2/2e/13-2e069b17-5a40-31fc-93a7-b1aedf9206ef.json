  "rdfs:comment": {
    "de": [
      "Das Chasal Lento ist Museum und Café zugleich und ein echter Ort des Lebens, des Teilens, der Begegnung und der Entdeckung des lokalen Erbes. Es liegt im Herzen des Dorfes Mont de Lans."
    ],
    "en": [
      "Both a museum and a café, the Chasal Lento is a real place to live, share, meet and discover the local heritage located in the heart of the village of Mont de Lans."
    ],
    "it": [
      "Al tempo stesso museo e caffè, il Chasal Lento è un vero e proprio luogo di vita, di condivisione, di incontro e di scoperta del patrimonio locale situato nel cuore del villaggio di Mont de Lans."
    ],
    "fr": [
      "A la fois musée et café, le Chasal Lento est un véritable lieu de vie, de partage, de rencontre et de découverte du patrimoine local situé au cœur du village du Mont de Lans."
    ],
    "nl": [
      "De Chasal Lento is zowel een museum als een café en is een echte plek om te leven, te delen, te ontmoeten en het lokale erfgoed te ontdekken in het hart van het dorp Mont de Lans."
    ],
    "es": [
      "A la vez museo y café, el Chasal Lento es un verdadero lugar para vivir, compartir, conocer y descubrir el patrimonio local situado en el corazón del pueblo de Mont de Lans."
    ]
  },
  "rdfs:label": {
    "en": [
