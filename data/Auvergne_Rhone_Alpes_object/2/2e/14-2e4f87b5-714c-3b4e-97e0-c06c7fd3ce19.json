      "dc:description": {
        "de": [
          "Besuchen Sie den Betrieb \"Les Fraises de Coupelle\" (Erdbeeren von Coupelle)\nTreffpunkt am Dienstag, den 19. August um 14.00 Uhr in Coupelle-Vieille"
        ],
        "en": [
          "Come and visit the Fraises de Coupelle farm\nMeet us on Tuesday, August 19 at 2:00 pm at Coupelle-Vieille"
        ],
        "it": [
          "Venite a visitare la fattoria Fraises de Coupelle\nAppuntamento martedì 19 agosto alle 14.00 a Coupelle-Vieille"
        ],
        "fr": [
          "Venez visiter l'exploitation des Fraises de Coupelle\nRendez-vous le mardi 19 août à 14h00 à Coupelle-Vieille"
        ],
        "es": [
          "Venga a visitar la granja Fraises de Coupelle\nNos vemos el martes 19 de agosto a las 14:00 en Coupelle-Vieille"
        ],
        "nl": [
          "Kom en bezoek de boerderij Fraises de Coupelle\nOntmoet ons op dinsdag 19 augustus om 14.00 uur in Coupelle-Vieille"
        ]
