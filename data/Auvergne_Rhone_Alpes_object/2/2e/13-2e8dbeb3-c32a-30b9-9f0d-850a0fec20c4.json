  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine authentische Küche mit diesen regionalen Produkten im Herzen der Dombes.\r\nTagesmenüs unter der Woche und mittags, dombistische Küche abends und am Wochenende."
    ],
    "en": [
      "Come and discover real authentic dombiste cuisine such as carp or chicken à la crème in the heart of the Dombes & Saône Lakes.  The Comptoir des Dombes is an establishment of real old world charm with rustic decor and an old fashioned fireplace."
    ],
    "it": [
      "Venite a scoprire una cucina autentica con prodotti regionali nel cuore delle Dombes.\r\nMenù giornaliero durante la settimana e a pranzo, cucina Dombes la sera e nei fine settimana."
    ],
    "fr": [
      "Venez découvrir une cuisine authentique avec ces produits régionaux au coeur de la Dombes.\r\nMenus du jour en semaine et à midi, cuisine dombiste les soirs et week-ends."
    ],
    "es": [
      "Venga a descubrir una auténtica cocina con productos regionales en el corazón de las Dombes.\r\nMenús del día entre semana y a la hora de comer, cocina de Dombes por la noche y los fines de semana."
    ],
    "nl": [
      "Kom en ontdek een authentieke keuken met regionale producten in het hart van de Dombes.\r\nDagmenu's tijdens de week en tussen de middag, Dombes-keuken 's avonds en in het weekend."
    ]
  },
