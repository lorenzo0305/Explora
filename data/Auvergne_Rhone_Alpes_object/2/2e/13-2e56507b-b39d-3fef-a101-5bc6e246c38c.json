  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Tanzgala der AJDN: Association Just Dance Nathalie, die unter dem Motto \"80er Jahre und Musicals\" steht! Genießen Sie aufeinanderfolgende Bilder, die Gruppentanz und Paartanz miteinander vermischen."
    ],
    "en": [
      "Come and enjoy the dance gala of AJDN: Association Just Dance Nathalie, on the theme of the 80s and musicals! Enjoy a series of tableaux combining group and couple dancing."
    ],
    "it": [
      "Venite a vedere il gala di danza AJDN (Association Just Dance Nathalie) sul tema degli anni '80 e dei musical! Godetevi una serie di tableaux che combinano balli di gruppo e di coppia."
    ],
    "fr": [
      "Venez assister au gala de danse de l'AJDN : Association Just Dance Nathalie,  sur le thème des années 80 et comédies musicales ! Profitez de tableaux enchaînés mêlant danse en groupe et danse en couple."
    ],
    "es": [
      "Ven a ver la gala de baile de la AJDN (Asociación Just Dance Nathalie) sobre el tema de los años 80 y los musicales Disfrute de una serie de cuadros que combinan el baile en grupo y en pareja."
    ],
    "nl": [
      "Kom kijken naar het dansgala van AJDN (Association Just Dance Nathalie) met als thema de jaren 80 en musicals! Geniet van een reeks tableaus waarin groeps- en partnerdansen worden gecombineerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gala de l'association Just Dance Nathalie"
    ]
  },
