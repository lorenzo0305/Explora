  "rdfs:comment": {
    "de": [
      "Regionales Zentrum Vélo Assistance Électrique.\r\nDas Förderband der Dolce Via, fahren Sie die Dolce Via hinunter und mit dem Minibus wieder hinauf.\r\nRegionalzentrum Fahrrad mit Elektrounterstützung: Haibike, BH, SUNN, SPECIALIZED"
    ],
    "en": [
      "Regional Electrically Assisted Bicycle Centre.\r\nThe Dolce Via conveyor: ride down the Dolce Via and back up by minibus.\r\nRegional Electrically Assisted Bicycle Centre: Haibike, BH, SUNN, SPECIALIZED"
    ],
    "it": [
      "Centro regionale di biciclette a pedalata assistita.\r\nIl trasportatore Dolce Via, scendere lungo la Dolce Via e risalire con il minibus.\r\nCentro regionale di biciclette elettriche a pedalata assistita: Haibike, BH, SUNN, SPECIALIZED"
    ],
    "fr": [
      "Centre régional Vélo Assistance Électrique.\r\nLe convoyeur de la Dolce Via, descendez la Dolce Via et remontez en minibus.\r\nCentre régional Vélo à Assistance Électrique : Haibike, BH, SUNN, SPECIALIZED"
    ],
    "nl": [
      "Regionaal centrum voor elektrisch ondersteunde fietsen.\r\nDe Dolce Via-band, ga naar beneden via de Dolce Via en kom terug met een minibus.\r\nRegionaal centrum voor elektrisch ondersteunde fietsen: Haibike, BH, SUNN, SPECIALIZED"
    ],
    "es": [
      "Centro regional de bicicletas con asistencia eléctrica.\r\nTransportador de la Dolce Via, bajar por la Dolce Via y volver a subir en minibús.\r\nCentro Regional de Bicicletas Eléctricamente Asistidas: Haibike, BH, SUNN, SPECIALIZED"
    ]
  },
  "rdfs:label": {
