  "rdfs:comment": {
    "de": [
      "Auf dieser Eisenbahnstrecke können Groß und Klein das Vergnügen entdecken, rittlings auf Gartenzügen zu reisen. Jeder kann seine Kinderseele wiederfinden..."
    ],
    "en": [
      "Miniature garden railway capable of transporting young and old alike, riding astride trucks pulled along by thermal, electric or steam engines. We'll explain how 1-5 and 1-11 scale garden trains work."
    ],
    "it": [
      "Questo circuito ferroviario permette a grandi e piccini di scoprire il piacere di viaggiare a bordo di treni da giardino. Tutti possono riscoprire il loro spirito infantile..."
    ],
    "fr": [
      "Ce circuit ferroviaire permet aux petits comme aux grands de découvrir le plaisir de voyager à califourchon sur des trains de jardin. Chacun peut retrouver son âme d'enfant..."
    ],
    "es": [
      "Este circuito ferroviario permite a grandes y pequeños descubrir el placer de viajar a horcajadas en trenes de jardín. Todos pueden redescubrir su espíritu infantil..."
    ],
    "nl": [
      "Dit spoorwegcircuit laat jong en oud het plezier ontdekken van reizen op een tuintrein. Iedereen kan zijn kinderlijke geest herontdekken..."
    ]
  },
  "rdfs:label": {
    "en": [
