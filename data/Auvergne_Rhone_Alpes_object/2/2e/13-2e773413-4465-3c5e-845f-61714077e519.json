  "rdfs:comment": {
    "de": [
      "Ein 1,8-Hektar großer Teich bei La Tuilerie. Picknickplatz und Kinderspielbereich. Angelscheine sind im PMU in Panissières erhältlich. Ein Steg ist für Menschen mit Behinderungen. Überdachter Unterstand mit Strom, nur nach Reservierung verfügbar. zugänglich."
    ],
    "en": [
      "A 1.8-hectare pond located at La Tuilerie. Picnic area and children’s playground. Permits on sale at the PMU in Panissières, tabac presse Duperray in Panissières et Bertholon-Grange in Panissières. . A dock is available for people with disabilities. Shelter with electricity available upon reservation."
    ],
    "it": [
      "Area picnic e giochi per bambini. Carte in vendita presso il PMU di Panissières, il tabac presse Duperray di Panissières e Bertholon-Grange di Panissières. Pontile per disabili. Cortile con elettricità su prenotazione."
    ],
    "fr": [
      "Coin pique-nique et jeux d'enfants. Cartes en vente au PMU de Panissières, tabac presse Duperray à Panissières et Bertholon-Grange à Panissières. Ponton pour les personnes en situation de handicap. Préau avec électricité sur réservation."
    ],
    "es": [
      "Zona de picnic y juegos infantiles. Venta de tarjetas en el PMU de Panissières, tabac presse Duperray de Panissières y Bertholon-Grange de Panissières. Pontón para minusválidos. Patio con electricidad previa reserva."
    ],
    "nl": [
      "Picknickplaats en spelletjes voor kinderen. Kaarten te koop bij de PMU in Panissières, tabac presse Duperray in Panissières en Bertholon-Grange in Panissières. Ponton voor gehandicapten. Binnenplaats met elektriciteit op reservering."
    ]
  },
