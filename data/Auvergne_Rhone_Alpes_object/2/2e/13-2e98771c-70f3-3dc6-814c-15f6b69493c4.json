  "rdfs:comment": {
    "de": [
      "Genießen Sie das von Tannen eingerahmte städtische Schwimmbad in Saint Victor (+ Grasfeld) mit beaufsichtigtem Badebetrieb. Freitags von 20:00 bis 22:00 Uhr Nachtzeiten mit Themenabenden. (2€). Wassergymnastik donnerstags von 19h bis 20h (5€) mit Reservierung."
    ],
    "en": [
      "Come and enjoy the Saint Victor municipal swimming pool surrounded by fir trees (+ grassy area) with supervised swimming. Nocturnes on Fridays from 8pm to 10pm with themed evenings. (2€). Aquagym on Thursdays from 7pm to 8pm (5€) on reservation."
    ],
    "it": [
      "Venite a godervi la piscina comunale di Saint Victor circondata da abeti (+ area erbosa) con nuoto sorvegliato."
    ],
    "fr": [
      "Venez profiter de la piscine municipale de Saint Victor encadrée par les sapins, (+ terrain en herbe ) avec baignade surveillée."
    ],
    "es": [
      "Venga a disfrutar de la piscina municipal Saint Victor rodeada de abetos (+ zona de césped) con baño vigilado."
    ],
    "nl": [
      "Kom genieten van het gemeentelijk zwembad Saint Victor omringd door dennenbomen (+ grasveld) met zwemmen onder toezicht. Nocturnes op vrijdag van 20u tot 22u met thema-avonden. (2€). Aquagym op donderdag van 19u tot 20u (5€) op reservering."
    ]
  },
  "rdfs:label": {
