  "rdfs:comment": {
    "de": [
      "In diesem alten Bauernhof aus dem Jahr 1852 empfängt Sie das Restaurant Le Vieux Four in einem authentischen Rahmen, um Sie mit kleinen savoyischen Gerichten oder einer aktuelleren Küche zu verwöhnen."
    ],
    "en": [
      "In this former farmhouse dating back to 1852, the restaurant Le Vieux Four welcomes you in an authentic setting to enjoy Savoyard dishes or more contemporary cuisine."
    ],
    "it": [
      "In questa antica fattoria del 1852, il ristorante Le Vieux Four vi accoglie in un ambiente autentico per gustare piatti savoiardi o una cucina più contemporanea."
    ],
    "fr": [
      "Dans cette ancienne ferme datant de 1852, le restaurant Le Vieux Four vous accueille dans un cadre authentique pour vous régaler de petits plats savoyards ou d'une cuisine plus actuelle."
    ],
    "nl": [
      "In deze voormalige boerderij uit 1852 verwelkomt het restaurant Le Vieux Four u in een authentieke omgeving om te genieten van Savoyaardse gerechten of meer eigentijdse gerechten."
    ],
    "es": [
      "En esta antigua granja de 1852, el restaurante Le Vieux Four le acoge en un marco auténtico para degustar platos saboyanos o cocina más contemporánea."
    ]
  },
