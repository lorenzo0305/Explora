  "rdfs:comment": {
    "de": [
      "Ehemalige Mühle zwischen Teich und Fluss gelegen. Restaurant mit Terrasse in einer ruhigen und grünen Umgebung.\r\nHausgemachte Küche mit dem Bib Michelin. Versicherung für lokale und saisonale Produkte\r\nWohnmobilstellplatz; Möglichkeit zum Angeln am Teich"
    ],
    "en": [
      "Former mill located between pond and river. Restaurant with terrace in a quiet, leafy setting.\r\nMichelin-starred, home-cooked cuisine. Assurance of local and seasonal products.\r\nCamper park; fishing on the pond possible."
    ],
    "it": [
      "Ex mulino situato tra lo stagno e il fiume. Ristorante con terrazza in un ambiente tranquillo e verdeggiante.\r\nCucina casalinga stellata Michelin. Garanzia di prodotti locali e di stagione\r\nParcheggio per roulotte; possibilità di pesca sul lago"
    ],
    "fr": [
      "Ancien moulin situé entre étang et rivière. Restaurant avec terrasse dans un cadre calme et verdoyant. \r\nCuisine tout fait maison ayant le Bib Michelin. Assurance de produits locaux et de saison\r\nAire de camping-car; possibilité de pêche sur l'étang"
    ],
    "nl": [
      "Voormalige molen gelegen tussen vijver en rivier. Restaurant met terras in een rustige, groene omgeving.\r\nHuisgemaakte keuken met Michelin-ster. Zekerheid van lokale en seizoensproducten\r\nCaravanpark; vissen mogelijk op het meer"
    ],
    "es": [
      "Antiguo molino situado entre el estanque y el río. Restaurante con terraza en un entorno tranquilo y frondoso.\r\nCocina casera con estrella Michelin. Garantía de productos locales y de temporada\r\nParque de caravanas; posibilidad de pescar en el lago"
    ]
  },
  "rdfs:label": {
    "en": [
      "The Santoire mill"
    ],
    "fr": [
      "Le moulin de la Santoire"
    ]
  },
