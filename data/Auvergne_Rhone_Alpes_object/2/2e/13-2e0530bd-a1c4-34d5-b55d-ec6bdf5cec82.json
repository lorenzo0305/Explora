  "rdfs:comment": {
    "de": [
      "Auf den wunderschönen Place de la Baleine hinausgehend, beherbergt die Rue des 3 Maries das authentische Bouchon Lyonnais, Bezugspunkt von Aragon und Eluard."
    ],
    "en": [
      "Looking out onto the superb Place de la Baleine, Rue des 3 Maries is home to an authentic Lyonnais bouchon, once frequented by Aragon and Eluard."
    ],
    "it": [
      "Aperta sulla magnifica piazza della Baleine, la rue des Trois Maries ospita un genuino bouchon di Lione, frequentato da poeti come Aragon ed Eluard."
    ],
    "fr": [
      "S’ouvrant sur la superbe place de la Baleine, la rue des 3 Maries abrite en son sein un authentique bouchon de Lyon, repère d’Aragon et d’Eluard."
    ],
    "es": [
      "La Rue des 3 Maries, que desemboca en la magnífica Place de la Baleine, alberga un auténtico \"bouchon\" lionés, lugar de referencia de los poetas Aragon y Eluard."
    ],
    "nl": [
      "In de Rue des 3 Maries, die uitkomt op het prachtige Place de la Baleine, bevindt zich een authentieke bouchon uit Lyon, waar Aragon en Eluard hebben gewoond."
    ]
  },
