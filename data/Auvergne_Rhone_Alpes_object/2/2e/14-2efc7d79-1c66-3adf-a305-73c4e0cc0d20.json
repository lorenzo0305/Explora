  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/77aecc42-75a6-399d-bd0e-f9255b2e398f",
      "dc:description": {
        "de": [
          "Für den Étang du Brochet haben sich die Städte Harnes und Noyelles-sous-Lens zusammengeschlossen, um Ihnen eine auf das Wasser projizierte Kreation zu präsentieren, eine für das Video Mapping Festival völlig neue Einrichtung!"
        ],
        "en": [
          "For the Étang du Brochet, the towns of Harnes and Noyelles-sous-Lens have joined forces to bring you a creation projected onto the water - a first for the Video Mapping Festival!"
        ],
        "it": [
          "Per l'Étang du Brochet, le città di Harnes e Noyelles-sous-Lens hanno unito le forze per proporvi una creazione proiettata sull'acqua, una novità assoluta per il Video Mapping Festival!"
        ],
        "fr": [
          "Pour l’Étang du Brochet, les villes de Harnes et de Noyelles-sous-Lens se sont associées pour vous faire découvrir une création projetée sur l’eau, un dispositif inédit pour le Video Mapping Festival !"
        ],
        "nl": [
          "Voor het Étang du Brochet hebben de steden Harnes en Noyelles-sous-Lens hun krachten gebundeld om je een creatie te brengen die op het water wordt geprojecteerd, een primeur voor het Video Mapping Festival!"
        ],
        "es": [
          "Para el Étang du Brochet, las ciudades de Harnes y Noyelles-sous-Lens han unido sus fuerzas para ofrecerle una creación proyectada sobre el agua, ¡una primicia en el Festival de Video Mapping!"
        ]
      },
