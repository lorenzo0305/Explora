  "rdfs:comment": {
    "de": [
      "Ehemaliger Gasthof aus dem Jahr 1640 im Zentrum von Belleville, an den Toren des Beaujolais. Der Besitzer und Küchenchef, Daniel Hutin, bietet Ihnen seine großzügige regionale Küche und lokale Spezialitäten an"
    ],
    "en": [
      "Establishment dating from 1640, located in the centre of Belleville, at the gateway of Beaujolais area. The owner and chef as well proposes a varied cuisine ranging from local specialities to home specialities."
    ],
    "it": [
      "Antica locanda del 1640, situata nel centro di Belleville, alle porte del Beaujolais. Il proprietario e chef, Daniel Hutin, vi offre la sua generosa cucina locale e le sue specialità"
    ],
    "fr": [
      "Ancienne auberge datant de 1640, située dans le centre de Belleville, aux portes du Beaujolais. Le propriétaire et chef de cuisine, Daniel Hutin, vous propose sa cuisine généreuse du terroir et ses spécialités locales"
    ],
    "nl": [
      "Oude herberg uit 1640, gelegen in het centrum van Belleville, aan de poort van de Beaujolais. De eigenaar en chef-kok, Daniel Hutin, biedt u zijn royale lokale keuken en specialiteiten aan"
    ],
    "es": [
      "Antigua posada de 1640, situada en el centro de Belleville, a las puertas del Beaujolais. El propietario y chef, Daniel Hutin, le ofrece su generosa cocina local y sus especialidades"
    ]
  },
  "rdfs:label": {
