  "rdfs:comment": {
    "de": [
      "Willkommen in der Ferme-Auberge du Jardin des Escargots zu einem authentischen gastronomischen Abenteuer mit Gaumenfreuden. Lassen Sie sich verführen, Sie werden von der Großzügigkeit der Küche und der Ruhe des Ortes verzaubert sein!"
    ],
    "en": [
      "Welcome to the Ferme-Auberge du Jardin des Escargots for an authentic and gourmet gastronomic adventure. Let yourself be tempted, you will be charmed by the generosity of the cuisine and the tranquility of the place!"
    ],
    "it": [
      "Benvenuti al Ferme-Auberge du Jardin des Escargots per un'avventura gastronomica autentica e gourmet. Lasciatevi tentare, rimarrete affascinati dalla generosità della cucina e dalla tranquillità del luogo!"
    ],
    "fr": [
      "Bienvenue à la Ferme-Auberge du Jardin des Escargots pour une aventure gastronomique authentique et gourmande. Laissez-vous tenter, vous serez charmé par la générosité de la cuisine et la tranquillité du lieu !"
    ],
    "nl": [
      "Welkom in de Ferme-Auberge du Jardin des Escargots voor een authentiek en gastronomisch avontuur. Laat u verleiden, u zult gecharmeerd zijn van de gulheid van de keuken en de rust van de plaats!"
    ],
    "es": [
      "Bienvenido al Ferme-Auberge du Jardin des Escargots para una aventura gastronómica auténtica y gourmet. Déjese tentar, quedará encantado por la generosidad de la cocina y la tranquilidad del lugar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme-Auberge : Le Jardin aux Escargots"
    ]
  },
