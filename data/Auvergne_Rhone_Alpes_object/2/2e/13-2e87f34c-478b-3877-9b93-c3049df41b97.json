  "rdfs:comment": {
    "de": [
      "Restaurant 2 Schritte von Lapalisse entfernt, an der historischen Nationalstraße Nationale 7. Gesellige Momente und Gaumenfreuden sind garantiert! Eine traditionelle und raffinierte Küche wird Ihnen in einem \"Vintage\"-Ambiente angeboten, das Sie an den Charme der vergangenen Jahre erinnern wird."
    ],
    "en": [
      "Situated near Lapalisse town center, on the Road N7. Frindeliness and love of good food garanteed ! Tarditional and refined cooking in a vintage atmosphere."
    ],
    "it": [
      "Ristorante situato a 2 minuti da Lapalisse, sulla storica Nationale 7. Un'esperienza conviviale e gustosa garantita! Una cucina tradizionale e raffinata in un'atmosfera vintage che vi ricorderà il fascino degli anni passati."
    ],
    "fr": [
      "Restaurant situé à 2 pas de Lapalisse, sur la Nationale 7 Historique. Moment de convivialité et de gourmandise assuré ! Une cuisine traditionnelle et raffinée vous sera proposée dans une ambiance« vintage »qui vous rappellera le charme des années passées."
    ],
    "es": [
      "Restaurante situado a 2 minutos de Lapalisse, en la histórica Nationale 7. Le garantizamos una experiencia agradable y sabrosa Cocina tradicional y refinada en un ambiente vintage que le recordará el encanto de antaño."
    ],
    "nl": [
      "Restaurant gelegen op 2 minuten van Lapalisse, op de historische Nationale 7. Het wordt gegarandeerd een gezellige en smakelijke ervaring! Traditionele, verfijnde gerechten in een vintage sfeer die je doet denken aan de charme van vervlogen jaren."
    ]
  },
  "rdfs:label": {
    "en": [
      "Etape Bleue"
    ],
    "fr": [
      "L’Étape Bleue"
    ]
  },
