  "rdfs:comment": {
    "de": [
      "EIN SEMINAR AUF CHAMONIX?\r\nDAS IST MIT TAKAMAKA SPORT NATURE MÖGLICH.\r\nWir organisieren Ihre schlüsselfertigen Seminare oder Veranstaltungen in der Gegend von CHAMONIX und pays du Mont-Blanc mit halbtägigem Workshop, Mittagessen und Aktivitäten."
    ],
    "en": [
      "A SEMINAR IN CHAMONIX ?\r\nIT IS POSSIBLE WITH TAKAMAKA SPORT NATURE.\r\nWe organize your turnkey seminars or events in the area of CHAMONIX and the Mont-Blanc country with half a day of study, lunch and activity."
    ],
    "it": [
      "UN SEMINARIO A CHAMONIX?\r\nÈ POSSIBILE CON TAKAMAKA SPORT NATURE.\r\nOrganizziamo i vostri seminari o eventi chiavi in mano nell'area di CHAMONIX e del Monte Bianco con una mezza giornata di studio, pranzo e attività."
    ],
    "fr": [
      "UN SÉMINAIRE SUR CHAMONIX ?\nC'EST POSSIBLE AVEC TAKAMAKA SPORT NATURE.\nNous organisons vos séminaires clé en main ou événements dans le secteur de CHAMONIX et pays du Mont-Blanc avec demi-journée d'étude, déjeuner et activité."
    ],
    "es": [
      "¿UN SEMINARIO EN CHAMONIX?\r\nES POSIBLE CON TAKAMAKA SPORT NATURE.\r\nOrganizamos sus seminarios o eventos \"llave en mano\" en la zona de CHAMONIX y el Mont-Blanc con una media jornada de estudio, almuerzo y actividades."
    ],
    "nl": [
      "EEN SEMINAR IN CHAMONIX?\nHET IS MOGELIJK MET TAKAMAKA SPORT NATUUR.\nWij organiseren uw seminars of evenementen in CHAMONIX en Mont-Blanc met een halve dag studie, lunch en activiteiten."
    ]
  },
