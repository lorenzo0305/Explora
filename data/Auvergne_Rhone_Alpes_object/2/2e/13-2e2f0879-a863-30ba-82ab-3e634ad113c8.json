  "rdfs:comment": {
    "de": [
      "Das Centre Équestre des Bauges ist eine Einrichtung mit dem Gütesiegel \"Centre de Tourisme Équestre\" und \"Ecole Française d'équitation chevaux et poneys\" (Französische Reitschule für Pferde und Ponys), die von Jeunesse et sport anerkannt ist."
    ],
    "en": [
      "Horse riding, pony trekking or multi-day tours: there are so many ways to discover all the wonders of riding in Les Bauges. Certified horse and pony riding school with a range of high-quality horses"
    ],
    "it": [
      "Il Centre Equestre des Bauges è un centro di turismo equestre certificato e una scuola di equitazione francese per cavalli e pony, con accreditamento Gioventù e Sport."
    ],
    "fr": [
      "﻿Le centre Équestre des Bauges est un établissement labellisé centre de Tourisme Équestre et Ecole Française d'équitation chevaux et poneys, agrée Jeunesse et sport."
    ],
    "es": [
      "El Centre Equestre des Bauges es un Centro de Turismo Ecuestre certificado y una Escuela Francesa de Equitación para caballos y ponis, con acreditación Juventud y Deporte."
    ],
    "nl": [
      "Centre Équestre des Bauges is een manege met een Tourisme Équestre- en École Française d'équitation chevaux & poneys-keurmerk en is erkend door het ministerie voor Jeugdzorg. De manege ligt op het Baugesmassief."
    ]
  },
