  "rdfs:comment": {
    "de": [
      "Charakteristisches Herrenhaus umgeben von großen Gärten auf halbem Weg zwischen dem Vulkanpark und dem Zentrum von Clermont-Ferrand. Traditionelles Essen, vorzugsweise auf Reservierung."
    ],
    "en": [
      "Charming residence surrounded by large gardens, halfway between Parc des Volcans and the center of Clermont-Ferrand. Traditional cuisine, by reservation only."
    ],
    "it": [
      "Una casa di carattere circondata da ampi giardini a metà strada tra il Parc des Volcans e il centro di Clermont-Ferrand. Cucina tradizionale, preferibilmente su prenotazione."
    ],
    "fr": [
      "Demeure de caractère entourée de grands jardins à mi-chemin du parc des volcans et du centre de Clermont-Ferrand. Table traditionnelle, sur réservation de préférence."
    ],
    "es": [
      "Una casa con carácter rodeada de grandes jardines a medio camino entre el Parc des Volcans y el centro de Clermont-Ferrand. Cocina tradicional, preferiblemente con reserva."
    ],
    "nl": [
      "Een karaktervol huis omgeven door grote tuinen halverwege tussen het Parc des Volcans en het centrum van Clermont-Ferrand. Traditionele keuken, bij voorkeur op reservering."
    ]
  },
