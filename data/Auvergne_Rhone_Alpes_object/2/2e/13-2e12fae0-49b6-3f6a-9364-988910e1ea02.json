  "rdfs:comment": {
    "de": [
      "Ein Miniaturdorf\r\n\r\nLes Chalets du Thorens ist ein kleines Dorf am Rande der Pisten, in dem man von morgens bis abends zu empfangen, zu leben und zu feiern versteht."
    ],
    "en": [
      "A small village\r\n\r\nLes Chalets du Thorens is a small village on the edge of the slopes, where people know how to welcome, live and party, from morning till night."
    ],
    "it": [
      "Un piccolo villaggio\r\n\r\nLes Chalets du Thorens è un piccolo villaggio ai margini delle piste, dove la gente sa come accogliere, vivere e festeggiare, dalla mattina alla sera."
    ],
    "fr": [
      "Un village miniature\r\n\r\nLes Chalets du Thorens, c’est un petit village au bord des pistes, où l’on sait recevoir, vivre et faire la fête, du matin jusqu’au soir."
    ],
    "es": [
      "Un pequeño pueblo\r\n\r\nLes Chalets du Thorens es un pequeño pueblo al borde de las pistas, donde la gente sabe acoger, vivir y festejar, de la mañana a la noche."
    ],
    "nl": [
      "Een klein dorp\r\n\r\nLes Chalets du Thorens is een klein dorp aan de rand van de piste, waar mensen weten hoe ze moeten verwelkomen, leven en feesten, van 's ochtends vroeg tot 's avonds laat."
    ]
  },
