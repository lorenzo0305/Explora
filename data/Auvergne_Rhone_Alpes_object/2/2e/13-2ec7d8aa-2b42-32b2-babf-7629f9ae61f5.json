  "rdfs:comment": {
    "de": [
      "Das Consort ist eine neue Generation französischer Barockensembles und stellt Bach und Vivaldi, der ihn so sehr inspiriert hat, einander gegenüber."
    ],
    "en": [
      "The jewel in the crown of the new generation of French Baroque ensembles, the Consort brings together Bach and the man who inspired him so much, Vivaldi."
    ],
    "it": [
      "Fiore all'occhiello della nuova generazione di ensemble barocchi francesi, il Consort riunisce Bach e l'uomo che lo ha tanto ispirato, Vivaldi."
    ],
    "fr": [
      "Fleuron de la nouvelle génération d’ensembles baroques français, le Consort met en regard Bach et celui qui l’a tant inspiré, Vivaldi."
    ],
    "es": [
      "La joya de la corona de la nueva generación de conjuntos barrocos franceses, el Consort reúne a Bach y al hombre que tanto le inspiró, Vivaldi."
    ],
    "nl": [
      "Als parel aan de kroon van de nieuwe generatie Franse barokensembles brengt het Consort Bach samen met de man die hem zo inspireerde, Vivaldi."
    ]
  },
