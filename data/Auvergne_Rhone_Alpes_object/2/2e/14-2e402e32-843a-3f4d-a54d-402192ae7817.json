  "rdfs:comment": {
    "de": [
      "Es ist DIE musikalische Veranstaltung des Sommers. Die 2016 eingeführte Aktion Kiosque?estival zieht ein treues Publikum an, das sich am Sonntagnachmittag im Rhythmus des Jazz entspannen möchte."
    ],
    "en": [
      "It?s THE musical event of the summer. Introduced in 2016, the Kiosque?estival operation attracts a loyal audience eager to relax to the rhythm of jazz on Sunday afternoons."
    ],
    "it": [
      "È l'evento musicale dell'estate. Introdotta nel 2016, l'operazione Kiosque?estival attira un pubblico fedele desideroso di rilassarsi al ritmo del jazz la domenica pomeriggio."
    ],
    "fr": [
      "C’est LE rendez-vous musical de l’été. Mis en place en 2016, l’opération Kiosque’estival capte un public fidèle et désireux de se détendre au rythme du jazz le dimanche après-midi."
    ],
    "nl": [
      "Het is hét zomerse muziekevenement. De in 2016 geïntroduceerde Kiosque-estivals trekken een trouw publiek dat staat te popelen om te ontspannen op het ritme van jazz op zondagmiddag."
    ],
    "es": [
      "Es EL acontecimiento musical del verano. Introducido en 2016, el funcionamiento Kiosque?estival atrae a un público fiel deseoso de relajarse al ritmo del jazz los domingos por la tarde."
    ]
  },
