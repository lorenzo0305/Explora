  "rdfs:comment": {
    "de": [
      "Boulderhalle, die in freien Zeitfenstern oder für Kinder und Jugendliche in Kursen betrieben wird.\r\nDer Verein verwaltet auch die Tennisplätze, die neben der Halle liegen."
    ],
    "en": [
      "A bouldering room that can be used for free, or for children and teenagers in lessons.\r\nThe association also runs the tennis courts next door."
    ],
    "it": [
      "La sala boulder è disponibile gratuitamente o per i bambini e gli adolescenti durante le lezioni.\r\nL'associazione gestisce anche i campi da tennis adiacenti."
    ],
    "fr": [
      "Salle de blocs qui fonctionne en créneaux libres, ou pour les enfants et ados en cours.\r\nL'association gère aussi les cours de tennis qui jouxte la salle."
    ],
    "es": [
      "La sala de búlder está disponible de forma gratuita o para niños y adolescentes con clases.\r\nLa asociación también gestiona las pistas de tenis de al lado."
    ],
    "nl": [
      "De boulderzaal is gratis beschikbaar of voor kinderen en tieners op les.\r\nDe vereniging beheert ook de tennisbanen ernaast."
    ]
  },
