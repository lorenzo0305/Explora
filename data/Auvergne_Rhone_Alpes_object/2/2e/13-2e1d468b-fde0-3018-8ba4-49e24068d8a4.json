  "rdfs:comment": {
    "de": [
      "Die alten Geschäfte erwachen zu neuem Leben und in ihren Schaufenstern sind Fotos des Dorfes und der Dorfbewohner zu sehen, die vor über 100 Jahren aufgenommen wurden."
    ],
    "en": [
      "The old shops are coming back to life and their windows are decorated with photos of the village and the villagers taken more than 100 years ago."
    ],
    "it": [
      "I vecchi negozi stanno tornando in vita e le loro vetrine sono decorate con foto del villaggio e degli abitanti scattate più di 100 anni fa."
    ],
    "fr": [
      "Les anciens commerces reprennent vie et voient leurs vitrines arborer des photos du village et des villageois prises il y a plus de 100 ans."
    ],
    "es": [
      "Las viejas tiendas vuelven a la vida y sus escaparates están decorados con fotos del pueblo y de sus habitantes tomadas hace más de 100 años."
    ],
    "nl": [
      "De oude winkels komen weer tot leven en hun ramen zijn versierd met foto's van het dorp en de dorpelingen die meer dan 100 jaar geleden zijn genomen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition permanente : \"Déambulation au gré du temps\""
    ]
  },
