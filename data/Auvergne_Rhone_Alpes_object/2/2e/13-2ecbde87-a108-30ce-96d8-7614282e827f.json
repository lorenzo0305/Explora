  "rdfs:comment": {
    "de": [
      "Das International wurde 1903 vom Architekten Paul Martin auf Initiative von Léon Soalhat errichtet, der seinen Kunden alle Komfort- und Hygieneinnovationen bieten wollte, die sie verlangen konnten, einschließlich einer Zentralheizung für die Wintersaison."
    ],
    "en": [
      "The International was built by architect Paul Martin in 1903, on the initiative of Léon Soalhat, who wanted to offer his customers all the innovations in comfort and hygiene they could possibly require, including central heating for the winter season."
    ],
    "it": [
      "L'International fu costruito dall'architetto Paul Martin nel 1903, su iniziativa di Léon Soalhat, che voleva offrire ai suoi clienti tutte le innovazioni in termini di comfort e igiene che potessero richiedere, compreso il riscaldamento centralizzato per la stagione invernale."
    ],
    "fr": [
      "L’International édifié par l’architecte Paul Martin en 1903, à l’initiative de Léon Soalhat qui souhaitait offrir à sa clientèle toutes les innovations de confort et d’hygiène qu’elle pouvait exiger, y compris le chauffage central pour la saison d’hiver."
    ],
    "nl": [
      "The International werd in 1903 gebouwd door architect Paul Martin op initiatief van Léon Soalhat, die zijn klanten alle mogelijke innovaties op het gebied van comfort en hygiëne wilde bieden, inclusief centrale verwarming voor het winterseizoen."
    ],
    "es": [
      "El International fue construido por el arquitecto Paul Martin en 1903, por iniciativa de Léon Soalhat, que quería ofrecer a sus clientes todas las innovaciones en confort e higiene que pudieran necesitar, incluida la calefacción central para la temporada de invierno."
    ]
  },
