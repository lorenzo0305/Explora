  "rdfs:comment": {
    "de": [
      "A petits Points ist die Herstellenseite von Lederaccessoires die sich in\r\neinem früheren Sägewerk befindet. Besuch des Workshops und\r\nKennenlernen der allen Etappen der Herstellung."
    ],
    "en": [
      "A petits points is a manufacture workshop of leather accessories in a former sawmill. Visit us and discover all the manufacturing steps."
    ],
    "it": [
      "Un petits point è un laboratorio Nétrablais per la realizzazione di accessori in pelle. Creata nel 2013 da Elisabeth Volk-Léonovitch & David Loft, questa attività si è svolta in una vecchia segheria ristrutturata per l'occasione."
    ],
    "fr": [
      "A petits point est un atelier Nétrablais de fabrication d'accessoires en cuir. Créée en 2013, par Elisabeth Volk-Léonovitch & David Loft, cette activité a pris place dans une ancienne scierie rénovée à cette occasion."
    ],
    "es": [
      "Un petits point es un taller de Nétrablais para fabricar accesorios de cuero. Creada en 2013 por Elisabeth Volk-Léonovitch & David Loft, esta actividad tuvo lugar en un antiguo aserradero renovado para la ocasión."
    ],
    "nl": [
      "Een petits point is een Nétrablais atelier voor het maken van lederen accessoires. Opgericht in 2013 door Elisabeth Volk-Léonovitch & David Loft, vond deze activiteit plaats in een voor de gelegenheid gerenoveerde oude zagerij."
    ]
  },
