  "rdfs:comment": {
    "de": [
      "Das Restaurant L'Equipe befindet sich im Herzen von ND de Bellecombe. Sie werden die von William zubereiteten Gerichte probieren: Savoyardische Spezialitäten, Fleisch, Pommes Frites und hausgemachte Mehlspeisen, Gartensalat (im Sommer), Pfannkuchen, Eiscreme.\r\nPetit futé 2018, Michelin-Führer Vert."
    ],
    "en": [
      "L’Equipe restaurant is located in the middle of ND de Bellecombe.  You will enjoy dishes prepared by William : Savoyard specialities, meats, fries and home-made cakes, home-grown salads (summer), crêpes, ice-creams.\r\nPetit futé 2018, Michelin Guide Vert."
    ],
    "it": [
      "Il ristorante L'Equipe si trova nel cuore di ND de Bellecombe. Potrete gustare i piatti preparati da William: specialità savoiarde, carni, patatine fritte e dolci, crêpes, gelati. Accoglienza familiare."
    ],
    "fr": [
      "Le Restaurant L'Equipe est situé au cœur de ND de Bellecombe. Vous dégusterez les plats élaborés par William : spécialités savoyardes, viandes, frites maison et pâtisseries, crêpes, glaces. Accueil familial."
    ],
    "nl": [
      "Restaurant L'Equipe ligt in het hart van ND de Bellecombe. U zult genieten van gerechten bereid door William: Savoyaardse specialiteiten, vleeswaren, huisgemaakte frietjes en gebak, crêpes, ijsjes. Welkom voor het hele gezin."
    ],
    "es": [
      "El Restaurante L'Equipe está situado en el corazón de ND de Bellecombe. Disfrutará de platos preparados por William: especialidades de Saboya, carnes, patatas fritas caseras y repostería, crepes, helados. Acogida familiar."
    ]
  },
