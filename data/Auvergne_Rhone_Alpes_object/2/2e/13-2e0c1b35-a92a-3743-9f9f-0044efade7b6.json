  "rdfs:comment": {
    "de": [
      "Bibliothek der Gemeinde.\r\nWährend der Weihnachtsferien nur am Mittwoch, den 21. und 28. Dezember 2016, von 10:00 bis 12:00 Uhr geöffnet.\r\nSamstag, den 24. und 31. Dezember 2016 geschlossen.\r\nSchöne Feiertage für alle."
    ],
    "en": [
      "Public library.\r\nDuring the Christmas vacations, open only on Wednesdays December 21 and 28, 2016 from 10am to 12pm.\r\nClosed on Saturday December 24 and 31, 2016.\r\nHappy holidays to all."
    ],
    "it": [
      "Biblioteca comunitaria.\r\nDurante le vacanze di Natale, aperto solo mercoledì 21 e 28 dicembre 2016 dalle 10 alle 12\r\nChiuso sabato 24 e 31 dicembre 2016.\r\nBuone vacanze a tutti."
    ],
    "fr": [
      "Bibliothèque communale.\r\nPendant les vacances de Noël, ouvert uniquement les mercredis 21 et 28 décembre 2016 de 10h à 12h. \r\nFermé samedis 24 et 31 décembre 2016.\r\nBonnes fêtes à tous."
    ],
    "nl": [
      "Plaatselijke bibliotheek.\r\nTijdens de kerstvakantie alleen geopend op woensdag 21 en 28 december 2016 van 10.00 tot 12.00 uur.\r\nGesloten op zaterdag 24 en 31 december 2016.\r\nWe wensen jullie allemaal fijne kerstdagen en een gelukkig nieuwjaar."
    ],
    "es": [
      "Biblioteca comunitaria.\r\nDurante las vacaciones de Navidad, abierto solo los miércoles 21 y 28 de diciembre de 2016 de 10 a 12 horas\r\nCerrado los sábados 24 y 31 de diciembre de 2016.\r\nFelices fiestas a todos."
    ]
  },
