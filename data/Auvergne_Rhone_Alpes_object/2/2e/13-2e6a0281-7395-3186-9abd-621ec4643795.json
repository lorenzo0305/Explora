  "rdfs:comment": {
    "de": [
      "Erleben Sie den Weg des evian®-Tropfens\r\nEntdecken Sie die Geheimnisse des natürlichen Mineralwassers evian auf einer geführten Tour und erfahren Sie alles über seine Herkunft, seine Geschichte, seinen Industriestandort und sein Engagement für den Planeten."
    ],
    "en": [
      "Experience the journey of the evian® drop\r\nDiscover the secrets of evian® natural mineral water on a guided tour, and learn all about its origin, history, industrial site and commitment to the planet."
    ],
    "it": [
      "Scoprite il viaggio della goccia evian\r\nScoprite i segreti dell'acqua minerale naturale evian con una visita guidata e imparate tutto sulla sua origine, la sua storia, il suo sito industriale e il suo impegno per il pianeta."
    ],
    "fr": [
      "Vivez le parcours de la goutte evian®\r\nPartez à la découverte des secrets de l’eau minérale naturelle evian à travers une visite guidée et apprenez tout sur son origine, son histoire, son site industriel ou encore ses engagements en faveur de la planète."
    ],
    "es": [
      "Vive el viaje de la gota evian\r\nDescubra los secretos del agua mineral natural evian en una visita guiada y aprenda todo sobre su origen, historia, emplazamiento industrial y compromiso con el planeta."
    ],
    "nl": [
      "Beleef de reis van de evian® druppel\r\nOntdek de geheimen van het natuurlijke mineraalwater van evian tijdens een rondleiding en leer alles over de oorsprong, geschiedenis, industriële locatie en betrokkenheid bij de planeet."
    ]
  },
  "rdfs:label": {
    "en": [
