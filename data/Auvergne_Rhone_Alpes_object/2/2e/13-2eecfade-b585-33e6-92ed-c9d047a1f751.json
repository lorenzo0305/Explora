  "rdfs:comment": {
    "de": [
      "Dieser Ort lädt ein die Geheimnisse der französischen Empfangskunst zu entdecken, so wie diese im Institut Paul Bocuse in einem Dekor von Pierre-Yves Rochon, international renommierter Innenarchitekt, gelehrt werden."
    ],
    "en": [
      "This establishement invites guests to discover the secrets of the French art of hospitality, such as those taught at Institut Paul Bocuse, with an interior decor created by Pierre-Yves Rochon, internationally renowned interior architect."
    ],
    "it": [
      "Questo locale invita a scoprire i segreti dell'arte di ricevere alla francese come sono insegnati nell'Istituto Paul Bocuse in una decorazione firmata da Pierre-Yves Rochon, architetto di interni di fama internazionale."
    ],
    "fr": [
      "Ce lieu invite à la découverte des secrets de l'art de recevoir à la française, tels qu'ils sont enseignés à l'Institut =-Lyfe (ex Institut Paul Bocuse) dans un décor signé Pierre-Yves Rochon, architecte d'intérieur de renommée internationale."
    ],
    "es": [
      "Este lugar invita a descubrir los secretos del arte de recibir a la francesa, tal como se enseñan en el Instituto Paul Bocuse, en un entorno decorado por Pierre-Yves Rochon, arquitecto interiorista de prestigio internacional."
    ],
    "nl": [
      "Dit is een uitnodiging om de geheimen van de Franse kunst van het entertainen te ontdekken, zoals onderwezen in het Institut =-Lyfe (voorheen het Institut Paul Bocuse), in een omgeving ontworpen door de internationaal bekende interieurarchitect Pierre-Yves Rochon."
    ]
  },
