  "rdfs:comment": {
    "de": [
      "Ob mit der Familie oder für ein Seminar, die Auberge de la Petite Ferme empfängt Sie in einer außergewöhnlichen Umgebung, mitten in der Natur, 800 m von der mittelalterlichen Stadt Besse und 3 km vom schönsten See der Auvergne, dem Lac Pavin, entfernt."
    ],
    "en": [
      "For families or seminars, the Auberge de la Petite Ferme welcomes you in an exceptional environment, in the middle of nature, 800 m from the medieval town of Besse, and 3 km from the most beautiful lake of Auvergne, the Lac Pavin."
    ],
    "it": [
      "Per famiglie o seminari, l'Auberge de la Petite Ferme vi accoglie in un ambiente eccezionale, in mezzo alla natura, a 800 m dalla città medievale di Besse e a 3 km dal più bel lago dell'Alvernia, il Lago Pavin."
    ],
    "fr": [
      "En famille ou en séminaire, l'Auberge de la Petite Ferme vous accueille dans un environnement exceptionnel, au milieu de la nature, à 800 m de la cité médiévale de Besse, et à 3 km du plus beau lac d'Auvergne, le Lac Pavin."
    ],
    "nl": [
      "Voor gezinnen of seminars, de Auberge de la Petite Ferme ontvangt u in een uitzonderlijke omgeving, midden in de natuur, op 800 m van de middeleeuwse stad Besse, en op 3 km van het mooiste meer van de Auvergne, het meer van Pavin."
    ],
    "es": [
      "Para familias o seminarios, el Auberge de la Petite Ferme le acoge en un entorno excepcional, en plena naturaleza, a 800 m de la ciudad medieval de Besse y a 3 km del lago más bello de Auvernia, el lago Pavin."
    ]
  },
  "rdfs:label": {
