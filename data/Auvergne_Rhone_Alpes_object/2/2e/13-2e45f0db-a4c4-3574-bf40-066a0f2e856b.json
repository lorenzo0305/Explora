  "rdfs:comment": {
    "de": [
      "Genießen Sie die herrliche Landschaft, die sich Ihrem Blick bietet, den Mont-Cenis-See, die umliegenden Gipfel und dieses kleine Plateau inmitten der Gipfel, das dem Petit-Mont-Cenis-Pass vorausgeht."
    ],
    "en": [
      "Enjoy the beautiful scenery, the Mont-Cenis lake, the surrounding peaks, and the small plateau in the middle of the peaks that precedes the Petit Mont-Cenis pass."
    ],
    "it": [
      "Godetevi il bellissimo paesaggio, il lago di Mont-Cenis, le cime circostanti e il piccolo altopiano in mezzo alle cime prima del passo del Petit Mont-Cenis."
    ],
    "fr": [
      "Profitez des superbes paysages qui s'offrent à votre regard, la lac du Mont-Cenis, les sommets environnants, et ce petit plateau au milieu des sommets qui précède le col du Petit Mont-Cenis."
    ],
    "nl": [
      "Geniet van het prachtige landschap, het meer van Mont-Cenis, de omringende bergtoppen en het kleine plateau in het midden van de bergtoppen vóór de Petit Mont-Cenis pas."
    ],
    "es": [
      "Disfrute del hermoso paisaje, el lago Mont-Cenis, los picos circundantes y la pequeña meseta en medio de los picos antes del paso del Petit Mont-Cenis."
    ]
  },
  "rdfs:label": {
    "en": [
      "Enduro MTB: La Crosta Brava via the Mont-Cenis pass"
    ],
    "it": [
      "Enduro MTB: La Crosta Brava attraverso il passo del Mont-Cenis"
    ],
    "fr": [
      "VTT Enduro : La Crosta Brava par le col du Mont-Cenis"
    ],
    "nl": [
      "Enduro MTB: La Crosta Brava via de Mont-Cenis pas"
    ]
  },
