  "rdfs:comment": {
    "de": [
      "Entdecken Sie das VAE im Herzen des Chartreuse-Massivs. Diese Strecke von 13 km und 225D+ ist für alle zugänglich und führt durch die zahlreichen Weiler der Gemeinde Saint-Pierre-de-Chartreuse, mit einer herrlichen Aussicht auf den Grand Som!"
    ],
    "en": [
      "An e-bike tour in the heart of the Chartreuse mountains. This 13 km itinerary covers a 225-metres elevation gain. It is suitable for all riding levels and crosses some of the many hamlets of Saint-Pierre-de-Chartreuse, with a splendid view on the Grand Som summit!"
    ],
    "it": [
      "Scoprite la mountain bike nel cuore del massiccio della Chartreuse. Questo percorso di 13 km, 225D+, è accessibile a tutti e vi porterà attraverso le numerose frazioni di Saint-Pierre-de-Chartreuse, con una magnifica vista sul Grand Som!"
    ],
    "fr": [
      "Découvrez le VAE au cœur du massif de Chartreuse. Ce parcours de 13 km et 225D+ est accessible à tous et permet de traverser les nombreux hameaux de la commune de Saint-Pierre-de-Chartreuse, avec une vue magnifique sur le Grand Som !"
    ],
    "nl": [
      "Ontdek mountainbiken in het hart van het Chartreuse-massief. Deze route van 13 km, 225D+, is toegankelijk voor iedereen en voert je door de vele gehuchten van Saint-Pierre-de-Chartreuse, met een prachtig uitzicht op de Grand Som!"
    ],
    "es": [
      "Descubra la bicicleta de montaña en el corazón del macizo de Chartreuse. Esta ruta de 13 km, 225D+, es accesible para todos y le llevará a través de las numerosas aldeas de Saint-Pierre-de-Chartreuse, ¡con una magnífica vista del Grand Som!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Easy Trip Green in Saint-Pierre de Chartreuse"
    ],
    "fr": [
      "VTTAE - Easy Trip Vert à Saint-Pierre de Chartreuse"
    ]
  },
