  "rdfs:comment": {
    "de": [
      "Der Laden der Fruitière bietet den Direktverkauf von Savoie-Käse: Reblochon fruitier, Tomme und Abondance, die von unseren Käsern hergestellt werden, sowie eine große Auswahl an regionalen Produkten: Wurstwaren, Honig, Marmeladen, Savoyer Weine, ..."
    ],
    "en": [
      "The dairy shop sells Savoy cheeses such as Reblochon fruitier, Tomme and Abondance, made by our cheesemakers, as well as a wide range of local produce including charcuterie, honeys, jams and Savoy wines."
    ],
    "it": [
      "La latteria vende formaggi savoiardi come il Reblochon fruitier, la Tomme e l'Abondance, prodotti dai nostri casari, oltre a un'ampia gamma di prodotti locali: salumi, mieli, marmellate, vini savoiardi, ecc."
    ],
    "fr": [
      "Le magasin de la fruitière propose la vente directe de  fromages de Savoie : Reblochon fruitier, Tomme et Abondance fabriqués par nos fromagers ainsi qu'un large choix de produits du terroir : charcuteries, miels, confitures, vins de Savoie, ..."
    ],
    "es": [
      "La lechería vende quesos de Saboya como el Reblochon fruitier, el Tomme y el Abondance, elaborados por nuestros queseros, así como una amplia gama de productos locales: embutidos, mieles, mermeladas, vinos de Saboya, etc."
    ],
    "nl": [
      "De zuivelwinkel verkoopt Savoyse kazen zoals Reblochon fruitier, Tomme en Abondance, gemaakt door onze kaasmakers, evenals een breed scala aan lokale producten: vleeswaren, honing, jam, Savoyse wijnen, enz."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cheese dairy of Hauts-Fleury"
    ],
    "fr": [
      "Fruitière des Hauts-Fleury"
    ],
    "nl": [
      "Fruitière des Hauts-Fleury - Kaasmakerij"
    ]
  },
