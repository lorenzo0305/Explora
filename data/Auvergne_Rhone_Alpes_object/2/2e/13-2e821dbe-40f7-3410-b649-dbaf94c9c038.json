  "rdfs:comment": {
    "de": [
      "Hier finden Sie köstlichen weißen Spargel, der ausschließlich von lokalen Arbeitskräften geerntet wird, sowie köstliche Veloutés!\r\nDirektverkauf."
    ],
    "en": [
      "You'll find delicious white asparagus harvested exclusively by local workers, as well as delicious veloutés!"
    ],
    "it": [
      "Troverete deliziosi asparagi bianchi raccolti esclusivamente da lavoratori locali e deliziose vellutate!\r\nVendita diretta."
    ],
    "fr": [
      "Vous retrouvez de délicieuses asperges blanches récoltées par une main d’œuvre exclusivement locale, ainsi que de délicieux véloutés ! \r\nVente en directe."
    ],
    "nl": [
      "Je vindt er heerlijke witte asperges die uitsluitend door lokale arbeiders worden geoogst, en ook heerlijke veloutés!\r\nDirecte verkoop."
    ],
    "es": [
      "Encontrará deliciosos espárragos blancos cosechados exclusivamente por trabajadores locales, ¡así como deliciosas veloutés!\r\nVenta directa."
    ]
  },
