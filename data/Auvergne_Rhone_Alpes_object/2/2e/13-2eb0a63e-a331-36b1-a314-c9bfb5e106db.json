  "rdfs:comment": {
    "de": [
      "Unser Team von Beauty-Coaches freut sich, Sie zu einer entspannenden Auszeit begrüßen zu dürfen. Profitieren Sie von zahlreichen Tipps und angebotenen Dienstleistungen (Make-up, Hautdiagnose, Handmassage."
    ],
    "en": [
      "Our team of Beauty Coaches is happy to welcome you for a relaxing interlude. Take advantage of our wide range of advice and services (make-up, skin diagnosis, hand massage...)."
    ],
    "it": [
      "Il nostro team di Beauty Coaches è lieto di accogliervi per una parentesi di relax. Approfittate dell'ampia gamma di consigli e servizi offerti (trucco, diagnosi della pelle, massaggio alle mani, ecc.)."
    ],
    "fr": [
      "Notre équipe de Coachs Beauté est heureuse de vous accueillir pour une parenthèse de relaxation. Bénéficiez de nombreux conseils et services offerts (maquillage, diagnostic de peau, massage des mains."
    ],
    "nl": [
      "Ons team van Beauty Coaches verwelkomt je graag voor een ontspannend intermezzo. Profiteer van het ruime aanbod aan advies en diensten (make-up, huiddiagnose, handmassage, enz.)."
    ],
    "es": [
      "Nuestro equipo de esteticistas estará encantado de recibirle para un momento de relax. Aproveche la amplia gama de consejos y servicios que le ofrecemos (maquillaje, diagnóstico de la piel, masaje de manos, etc.)."
    ]
  },
