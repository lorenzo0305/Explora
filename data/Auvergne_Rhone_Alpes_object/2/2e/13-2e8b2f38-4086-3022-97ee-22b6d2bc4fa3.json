  "rdfs:comment": {
    "de": [
      "Das Ende der Saison verpflichtet. Dies ist die Gelegenheit für Diana, Gesangslehrerin in Valence und Châteauneuf-sur-Isère, uns ihre Schüler vorzustellen. Eine ausgeklügelte Vorbereitung, die fröhlich Rock, französische Chansons und Belcanto für zwei festliche Sets mischt."
    ],
    "en": [
      "The end of the season is upon us. Diana, who teaches singing in Valence and Châteauneuf-sur-Isère, takes this opportunity to introduce us to her students. An elaborate mix of rock, chanson française and bel canto, for two festive sets."
    ],
    "it": [
      "È la fine della stagione. Diana, che insegna canto a Valence e a Châteauneuf-sur-Isère, coglie l'occasione per presentarci i suoi studenti. Una preparazione elaborata, che mescola gioiosamente rock, chanson francese e bel canto, per due set festivi."
    ],
    "fr": [
      "Fin de saison oblige. C'est l'occasion pour Diana, professeur de chant à Valence et Châteauneuf-sur-Isère, de nous présenter ses élèves. Une préparation élaborée, qui mixe joyeusement rock, chanson française et bel canto, pour deux sets festifs."
    ],
    "nl": [
      "Het is het einde van het seizoen. Diana, die zangles geeft in Valence en Châteauneuf-sur-Isère, maakt van de gelegenheid gebruik om ons aan haar studenten voor te stellen. Een uitgebreide voorbereiding, een vrolijke mix van rock, Frans chanson en bel canto, voor twee feestelijke sets."
    ],
    "es": [
      "Es el final de la temporada. Diana, profesora de canto en Valence y Châteauneuf-sur-Isère, aprovecha la ocasión para presentarnos a sus alumnos. Una preparación elaborada, mezclando alegremente rock, chanson francesa y bel canto, para dos conjuntos festivos."
    ]
  },
  "rdfs:label": {
    "fr": [
