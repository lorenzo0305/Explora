  "rdfs:comment": {
    "de": [
      "Shohela, internationale Künstlerin, Diplom und Professorin der Schönen Künste, Gewinnerin mehrerer internationaler Preise bietet :\r\n- malkurse (Aquarelle und alle Techniken)\r\n- kurse in Modellieren/Skulpturieren/Töpfern (Fayence, Engobe und Raku)"
    ],
    "en": [
      "Shohela, international artist, graduate and teacher of fine arts, winner of several international awards offers :\r\n- painting courses (watercolors and all techniques)\r\n- modeling/sculpting/pottery classes (earthenware, engobe and raku)"
    ],
    "it": [
      "Shohela, artista internazionale, laureata e insegnante di belle arti, vincitrice di numerosi premi internazionali offre :\r\n- corsi di pittura (acquerelli e tutte le tecniche)\r\n- corsi di modellazione/scultura/ceramica (terracotta, ingobbio e raku)"
    ],
    "fr": [
      "Shohela, Artiste internationale, diplômée et professeur des beaux-arts, gagnante de plusieurs prix internationaux propose  :\r\n- des cours de peinture (aquarelles et toutes techniques) \r\n- des cours de modelage/sculpture/ poterie (faïence, engobe et raku)"
    ],
    "nl": [
      "Shohela, internationaal kunstenaar, afgestudeerd en docent beeldende kunst, winnaar van verschillende internationale prijzen biedt :\r\n- schilderlessen (aquarel en alle technieken)\r\n- boetseer-/beeldhouw-/pottenbakkerslessen (aardewerk, engobe en raku)"
    ],
    "es": [
      "Shohela, artista internacional, licenciada y profesora de bellas artes, ganadora de varios premios internacionales ofrece :\r\n- clases de pintura (acuarela y todas las técnicas)\r\n- clases de modelado/escultura/cerámica (barro, engobe y raku)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Atelier de Shohela"
    ]
  },
