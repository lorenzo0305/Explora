  "rdfs:comment": {
    "de": [
      "In einem warmen und geselligen Rahmen, saisonale Küche aus frischen und lokalen Produkten! Knusprig mit Reblochon ... Gebratenes Ei ... Pulled Pork... Vegetarischer Teller... Etc... Marktmenü am Mittag"
    ],
    "en": [
      "In a warm and friendly bistro atmosphere, creative cuisine based on local, seasonal ingredients. A beautiful selection of wines."
    ],
    "it": [
      "In un ambiente caldo e accogliente, cucina stagionale a base di prodotti freschi e locali! Formaggio Reblochon croccante... Uovo fritto... Maiale tirato... Piatto vegetariano... Ecc. Menu del mercato a pranzo"
    ],
    "fr": [
      "Dans un cadre chaleureux et convivial, cuisine de saison à base de produits frais et locaux ! Croustillant au reblochon... Œuf frit... Pulled Pork.. Assiette végétarienne... Etc.. Menu du marché le midi"
    ],
    "nl": [
      "In een warm en vriendelijk kader, seizoensgebonden gerechten op basis van verse en lokale producten! Krokante Reblochon kaas... Gebakken ei... Pulled pork... Vegetarisch bord... Enz. Marktmenu tijdens de lunch"
    ],
    "es": [
      "En un ambiente cálido y acogedor, cocina de temporada basada en productos frescos y locales Queso Reblochon crujiente... Huevo frito... Cerdo tirado... Plato vegetariano... Etc. Menú del mercado a la hora de comer"
    ]
  },
  "rdfs:label": {
    "en": [
      "Les P'tites Canailles (the Little Rascals)"
    ],
    "fr": [
      "Les P'tites Canailles"
    ]
  },
