  "rdfs:comment": {
    "de": [
      "Empfangsbüro und Touristeninformation über die Monts du Lyonnais und die Umgebung. Informationen und Shop, die der Geschichte und dem Kulturerbe von Saint-Symphorien-sur-Coise gewidmet sind, einem der 100 Plus Beaux Détours de France (Schönste Orte Frankreichs)."
    ],
    "en": [
      "Reception and tourist information office on the Monts du Lyonnais and surroundings. Information and shop dedicated to the history and heritage of Saint-Symphorien-sur-Coise, one of the 100 Most Beautiful Detours in France."
    ],
    "it": [
      "Ufficio di accoglienza e informazioni turistiche per i Monts du Lyonnais e dintorni. Informazioni e negozio dedicati alla storia e al patrimonio di Saint-Symphorien-sur-Coise, uno dei 100 luoghi più belli di Francia."
    ],
    "fr": [
      "Bureau d'accueil et d'informations touristiques sur les Monts du Lyonnais et alentours. Informations et boutique dédiées à l'histoire et au patrimoine de Saint-Symphorien-sur-Coise, un des 100 Plus Beaux Détours de France."
    ],
    "nl": [
      "Receptie en toeristisch informatiekantoor voor de Monts du Lyonnais en omgeving. Informatie en winkel gewijd aan de geschiedenis en het erfgoed van Saint-Symphorien-sur-Coise, een van de 100 mooiste plaatsen in Frankrijk."
    ],
    "es": [
      "Recepción y oficina de información turística de los Montes del Lyón y sus alrededores. Información y tienda dedicada a la historia y el patrimonio de Saint-Symphorien-sur-Coise, uno de los 100 lugares más bellos de Francia."
    ]
  },
