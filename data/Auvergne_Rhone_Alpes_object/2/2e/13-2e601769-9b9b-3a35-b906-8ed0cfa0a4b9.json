  "rdfs:comment": {
    "de": [
      "Infinity Trail ist eine Backyard-Ultra-Strecke, die aus 12 Etappen besteht, die an symbolträchtigen Orten in ganz Frankreich veranstaltet werden. Im März findet die Etappe \"Terre Volcanique\" der Backyard am Volcan de Lemptégy statt!"
    ],
    "en": [
      "Infinity Trail is a Backyards Ultra circuit made up of 12 stages organized in emblematic locations across France. In March, the \"Terre Volcanique\" stage of the Backyard will take place at the Volcan de Lemptégy!"
    ],
    "it": [
      "Infinity Trail è un circuito Ultra Backyard composto da 12 tappe che si svolgono in luoghi iconici di tutta la Francia. A marzo, la tappa \"Terre Volcanique\" del Backyard si svolgerà sul Volcan de Lemptégy!"
    ],
    "fr": [
      "Infinity Trail est un circuit de Backyards Ultra composé de 12 étapes organisées dans des lieux emblématiques à travers la France. En mars l'étape \"Terre Volcanique\" de la Backyard aura lieu au Volcan de Lemptégy !"
    ],
    "nl": [
      "Infinity Trail is een Ultra Backyard-circuit dat bestaat uit 12 etappes op iconische locaties in heel Frankrijk. In maart vindt de \"Terre Volcanique\" etappe van de Backyard plaats op de Vulkaan van Lemptégy!"
    ],
    "es": [
      "Infinity Trail es un circuito Ultra Backyard compuesto por 12 etapas celebradas en lugares emblemáticos de toda Francia. ¡En marzo, la etapa \"Terre Volcanique\" del Backyard tendrá lugar en el Volcán de Lemptégy!"
    ]
  },
  "rdfs:label": {
    "fr": [
