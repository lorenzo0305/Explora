  "rdfs:comment": {
    "de": [
      "La Verrière ist ein elegantes und gemütliches Restaurant im Herzen des Dorfes La Garde-Adhémar, das ein Gourmet-Erlebnis in einem authentischen und herzlichen Rahmen bietet."
    ],
    "en": [
      "La Verrière is an elegant, friendly restaurant in the heart of the village of La Garde-Adhémar, offering a gourmet experience in a warm, authentic setting."
    ],
    "it": [
      "La Verrière è un ristorante elegante e accogliente nel cuore del villaggio di La Garde-Adhémar, che offre un'esperienza gastronomica in un ambiente caldo e autentico."
    ],
    "fr": [
      "La Verrière est un restaurant élégant et convivial situé au cœur du village de la Garde-Adhémar offrant une expérience gourmande dans un cadre authentique et chaleureux."
    ],
    "nl": [
      "La Verrière is een elegant, vriendelijk restaurant in het hart van het dorp La Garde-Adhémar, dat een gastronomische ervaring biedt in een warme, authentieke omgeving."
    ],
    "es": [
      "La Verrière es un restaurante elegante y acogedor situado en el corazón del pueblo de La Garde-Adhémar, que ofrece una experiencia gastronómica en un ambiente cálido y auténtico."
    ]
  },
  "rdfs:label": {
