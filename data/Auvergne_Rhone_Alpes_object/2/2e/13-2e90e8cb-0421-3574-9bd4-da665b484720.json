  "rdfs:comment": {
    "de": [
      "Café-Bar-Restaurant im Herzen des Dorfes Agnin.\r\nTraditionelle Restauration in einem modernen und angenehmen Rahmen, in dem Ihnen frische Produkte angeboten werden\r\nUnsere Spezialität: Fleisch."
    ],
    "en": [
      "Café-bar-restaurant in the heart of the village of Agnin.\r\nTraditional restoration in a modern and pleasant setting where fresh products are offered to you\r\nOur speciality: meat."
    ],
    "it": [
      "Caffè-bar-ristorante nel cuore del villaggio di Agnin.\r\nRistorazione tradizionale in un ambiente moderno e piacevole dove vengono offerti prodotti freschi\r\nLa nostra specialità: la carne."
    ],
    "fr": [
      "Café-bar-restaurant au cœur du village d'Agnin.\r\nRestauration traditionnelle dans un cadre moderne et agréable où vous sont proposés des produits frais. \r\nNotre spécialité : la viande."
    ],
    "es": [
      "Café-bar-restaurante en el corazón del pueblo de Agnin.\r\nRestauración tradicional en un entorno moderno y agradable donde se ofrecen productos frescos\r\nNuestra especialidad: la carne."
    ],
    "nl": [
      "Café-bar-restaurant in het hart van het dorp Agnin.\r\nTraditionele catering in een modern en aangenaam kader waar verse producten worden aangeboden\r\nOnze specialiteit: vlees."
    ]
  },
