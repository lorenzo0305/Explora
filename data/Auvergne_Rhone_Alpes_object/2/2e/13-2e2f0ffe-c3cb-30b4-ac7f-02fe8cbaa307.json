  "rdfs:comment": {
    "de": [
      "Geselliger Ort für Dinnershows: Jazz, Chansons, Weltmusik, Kreationen, Café-Theater.  Möglichkeit, an Konzert-/Showabenden zu Abend zu essen. Die \"hausgemachten\" Gerichte werden vor Ort aus Gemüse der Saison zubereitet."
    ],
    "en": [
      "Friendly place for dinner shows: jazz, songs, world music, creations, café-theater. Possibility to dine on concert / show evenings. The \"homemade\" dishes are prepared on site from seasonal vegetables."
    ],
    "it": [
      "Un luogo accogliente per cene e spettacoli: jazz, canzoni, world music, creazioni, caffè-teatro.  Possibilità di cena nelle serate di concerti/spettacoli. I piatti \"fatti in casa\" sono preparati sul posto con verdure di stagione."
    ],
    "fr": [
      "Lieu convivial de dîners spectacles : jazz, chansons, musiques du monde, créations, café-théâtre.  Possibilité de diner les soirs de concert/spectacle. Les plats \"faits maison\" sont élaborés sur place à partir  des légumes de saison."
    ],
    "es": [
      "Lugar de convivencia para cenar y disfrutar de un espectáculo: jazz, chanson, músicas del mundo, creaciones, café-théâtre.  Cena disponible las noches de concierto/espectáculo. Platos caseros elaborados in situ con verduras de temporada."
    ],
    "nl": [
      "Een gezellige plek voor diner en voorstellingen: jazz, liedjes, wereldmuziek, creaties, café-theater.  Mogelijkheid tot diner op concert/show avonden. De \"huisgemaakte\" gerechten worden ter plaatse bereid met groenten van het seizoen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Café des Arts"
    ],
    "fr": [
      "Le Café des Arts"
    ]
  },
