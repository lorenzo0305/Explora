  "rdfs:comment": {
    "de": [
      "In der Mitte Frankreichs, vor den Toren des Parc Régional des Volcans d'Auvergne, in der Nähe von Clermont-Ferrand, Riom und Volvic, bietet das Café Arthé regelmäßig Konzerte, Shows und zahlreiche kulturelle und künstlerische Veranstaltungen."
    ],
    "en": [
      "In the center of France, at the gates of the Parc Régional des Volcans d'Auvergne, near Clermont-Ferrand, Riom and Volvic, the Arthé Café regularly offers concerts, shows and numerous cultural and artistic events."
    ],
    "it": [
      "Nel centro della Francia, alle porte del Parc Régional des Volcans d'Auvergne, vicino a Clermont-Ferrand, Riom e Volvic, l'Arthé Café propone regolarmente concerti, spettacoli e numerosi eventi culturali e artistici."
    ],
    "fr": [
      "Au centre de la France, aux portes du Parc Régional des Volcans d'Auvergne, à proximité de Clermont-Ferrand, Riom et Volvic, l'Arthé Café propose régulièrement des concerts, spectacles et nombreuses animations culturelles et artistiques."
    ],
    "nl": [
      "In het centrum van Frankrijk, aan de poort van het Parc Régional des Volcans d'Auvergne, in de buurt van Clermont-Ferrand, Riom en Volvic, biedt het Arthé Café regelmatig concerten, voorstellingen en talrijke culturele en artistieke evenementen."
    ],
    "es": [
      "En el centro de Francia, a las puertas del Parque Regional de los Volcanes de Auvernia, cerca de Clermont-Ferrand, Riom y Volvic, el Arthé Café ofrece regularmente conciertos, espectáculos y numerosos eventos culturales y artísticos."
    ]
  },
  "rdfs:label": {
