  "rdfs:comment": {
    "de": [
      "Wir laden Sie im Juli und August mittwochs von 18.00 bis 20.00 Uhr zu kostenlosen Führungen durch den Weinkeller in Begleitung von Franck und Emmanuel Monge und Rémi Granon ein. Im Anschluss an die Führung wird eine Weinprobe angeboten."
    ],
    "en": [
      "Join us on Wednesdays in July and August, from 6 to 8 pm, for free guided tours of the winery with Franck and Emmanuel Monge and Rémi Granon. A wine tasting session is offered at the end of the tour."
    ],
    "it": [
      "Vi aspettiamo i mercoledì di luglio e agosto, dalle 18.00 alle 20.00, per le visite guidate gratuite della Grotta con Franck ed Emmanuel Monge e Rémi Granon. Al termine della visita è prevista una degustazione di vini."
    ],
    "fr": [
      "Nous vous donnons rendez-vous les mercredis en juillet et août, de 18h à 20h, pour des visites guidées gratuites de la Cave en compagnie de Franck et Emmanuel Monge et Rémi Granon. Une dégustation des vins est proposée à l'issue de la visite."
    ],
    "nl": [
      "We zien je graag op woensdagen in juli en augustus, van 18.00 tot 20.00 uur, voor een gratis rondleiding door de Cave met Franck en Emmanuel Monge en Rémi Granon. Een wijnproeverij wordt aangeboden aan het einde van de rondleiding."
    ],
    "es": [
      "Le esperamos los miércoles de julio y agosto, de 18:00 a 20:00 horas, para realizar visitas guiadas gratuitas a la Cueva con Franck y Emmanuel Monge y Rémi Granon. Al final de la visita se ofrecerá una degustación de vinos."
    ]
  },
