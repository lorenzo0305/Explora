      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nDienstag bis Samstag von 10.00 bis 19.00 Uhr\n \n Bestellungen:\n\nKontaktieren Sie den Laden unter 09 71 16 12 35 oder per E-Mail theplacetocapearras@gmail.com oder per privater Facebook-Nachricht\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nTuesday to Saturday, 10:00 am to 7:00 pm\n \n Orders :\n\nContact the store on 09 71 16 12 35 or by e-mail theplacetocapearras@gmail.com or Facebook private message\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDa martedì a sabato, dalle 10 alle 19\n \n Ordini :\n\nContattare il negozio al numero 09 71 16 12 35 o per e-mail theplacetocapearras@gmail.com o per messaggio privato su Facebook\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu mardi au samedi de 10h00 à 19h00 \n \n Commandes :\n\nContacter le magasin au 09 71 16 12 35 ou par mail theplacetocapearras@gmail.com ou par message privée Facebook\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nDinsdag tot zaterdag, 10u tot 19u\n \n Bestellingen :\n\nNeem contact op met de winkel op 09 71 16 12 35 of via e-mail theplacetocapearras@gmail.com of Facebook privébericht\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe martes a sábado, de 10.00 a 19.00 h\n \n Pedidos :\n\nPóngase en contacto con la tienda en el 09 71 16 12 35 o por correo electrónico theplacetocapearras@gmail.com o mensaje privado de Facebook\n\n "
        ]
