  "rdfs:comment": {
    "de": [
      "Das Café-Restaurant im Herzen des Dorfes Boffres bietet lokale, traditionelle und familiäre Küche sowie eine sorgfältig zusammengestellte Weinkarte. Die Panoramaterrasse bietet einen atemberaubenden Blick auf das Muans-Treibhaus."
    ],
    "en": [
      "Situated in the heart of the village of Boffres, the café-restaurant offers traditional, local, family-style cuisine, as well as a carefully-crafted wine list. The panoramic terrace overlooks the Muans greenhouse."
    ],
    "it": [
      "Situato nel cuore del villaggio di Boffres, il caffè-ristorante serve una cucina locale, tradizionale e familiare, oltre a una carta dei vini accuratamente preparata. La terrazza panoramica offre una splendida vista sulla serra di Muans."
    ],
    "fr": [
      "Situé au cœur du village de Boffres, le café-restaurant propose une cuisine locale, traditionnelle et familiale, ainsi qu'un carte de vins raisonnés élaborée avec soin. La terrasse panoramique offre une vue imprenable sur le serre du Muans."
    ],
    "es": [
      "Situado en el corazón del pueblo de Boffres, el café-restaurante sirve cocina local, tradicional y familiar, así como una cuidada carta de vinos. La terraza panorámica ofrece unas vistas impresionantes del invernadero de Muans."
    ],
    "nl": [
      "Het café-restaurant ligt in het hart van het dorp Boffres en serveert lokale, traditionele gerechten in familiestijl en een zorgvuldig samengestelde wijnkaart. Het panoramische terras biedt een prachtig uitzicht op de Muanskas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café restaurant Les Fontaines"
    ]
  },
