  "rdfs:comment": {
    "de": [
      "Kletterfelsen mit 134 Routen.\r\nSchwierigkeitsgrad von 3 bis 7a.\r\nmaximale Höhe 50 m.\r\nVorkommen des Kolkraben von Januar bis Juni.\r\nFels mit Mikrogranit.\r\nParkplatz, Toiletten und Picknicktische in der Nähe."
    ],
    "en": [
      "Climbing rock with 134 routes.\r\nDifficulty levels from 3 to 7a.\r\nmaximum height 50m.\r\nPresence of ravens from January to June.\r\nMicrogranite rock.\r\nParking lot, toilets and picnic tables nearby."
    ],
    "it": [
      "Arrampicata su roccia con 134 vie.\r\nLivelli di difficoltà dal 3 al 7a.\r\naltezza massima 50 m.\r\nIl grande corvo è presente da gennaio a giugno.\r\nRoccia di microgranito.\r\nParcheggio, servizi igienici e tavoli da picnic nelle vicinanze."
    ],
    "fr": [
      "Rocher d'escalade de 134 voies. \r\nNiveau de difficulté de 3 à 7a.\r\n50m de hauteur maximum. \r\nPrésence du grand corbeau de janvier à juin. \r\nRoche microgranite. \r\nParking, toilettes et tables de pique-nique à proximité."
    ],
    "nl": [
      "Klimrots met 134 routes.\r\nMoeilijkheidsgraden van 3 tot 7a.\r\nmaximale hoogte 50m.\r\nDe grote raaf is aanwezig van januari tot juni.\r\nMicrogranietrots.\r\nParkeerplaats, toiletten en picknicktafels in de buurt."
    ],
    "es": [
      "Escalada en roca con 134 vías.\r\nNiveles de dificultad de 3 a 7a.\r\naltura máxima 50 m.\r\nEl gran cuervo está presente de enero a junio.\r\nRoca microgranítica.\r\nAparcamiento, aseos y mesas de picnic en las inmediaciones."
    ]
  },
