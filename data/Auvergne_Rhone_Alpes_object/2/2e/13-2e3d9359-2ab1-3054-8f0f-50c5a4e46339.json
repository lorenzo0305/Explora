  "rdfs:comment": {
    "de": [
      "Die das alte Dorf dominierende Notre Dame de Viale war eine Bruderschaftskapelle. Ihre Ursprünge gehen auf die gotische Epoche zurück, wie die Behandlung der Vorhalle beweist. An den Gewölben und Wänden sind Spuren von Fresken zu erkennen."
    ],
    "en": [
      "The Notre Dame de Viale chapel overlooks the village. Its origins goes back to the Gothic period as witness the porch. Remains of frescoes can be seen on the vaults and the walls."
    ],
    "it": [
      "Dominando il vecchio villaggio, Notre Dame de Viale era una cappella della confraternita. Le sue origini risalgono al periodo gotico, come si evince dal trattamento del portico. Tracce di affreschi sono visibili sulle volte e sulle pareti."
    ],
    "fr": [
      "Dominant le vieux village, Notre Dame de Viale était une chapelle de confrérie. Ses origines remontent à l'époque gothique comme en témoigne le traitement du porche. On peut observer sur les voûtes et les murs, des traces de fresques."
    ],
    "nl": [
      "Notre Dame de Viale keek uit over het oude dorp en was een kapel van de broederschap. De oorsprong gaat terug tot de gotische periode, zoals te zien is aan de bewerking van het portaal. Sporen van fresco's zijn te zien op de gewelven en muren."
    ],
    "es": [
      "Dominando el antiguo pueblo, Notre Dame de Viale era una capilla de la hermandad. Sus orígenes se remontan a la época gótica, como se desprende del tratamiento del pórtico. En las bóvedas y los muros se pueden ver restos de frescos."
    ]
  },
