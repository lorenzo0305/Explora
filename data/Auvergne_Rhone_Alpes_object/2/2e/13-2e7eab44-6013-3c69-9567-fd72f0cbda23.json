  "rdfs:comment": {
    "de": [
      "La Maison des Enfants sind 4 Einrichtungen, in denen Ihre Kinder während Ihres Aufenthalts betreut werden. In Val Cenis Lanslebourg: Les Sablons und Plan des Champs. In Val Cenis Lanslevillard: Colombaz und Val Cenis le Haut.\r\n3 Monate-12 Jahre im Winter, 3 Monate-15 Jahre im Sommer."
    ],
    "en": [
      "The Maison des Enfants childcare centre is 4 structures for your children during your holidays. In Val Cenis Lanslebourg : Les Sablons and Plan des Champs. In Val Cenis Lanslevillard: Colombaz and Val Cenis le Haut. \r\n3 months-12 years in winter, 3 months-15 years in summer."
    ],
    "it": [
      "La Maison des Enfants dispone di 4 strutture per i vostri bambini durante il vostro soggiorno. In Val Cenis Lanslebourg : Les Sablons e Plan des Champs. In Val Cenis Lanslevillard : Colombaz e Val Cenis le Haut.\r\n3 mesi-12 anni in inverno, 3 mesi-15 anni in estate."
    ],
    "fr": [
      "La Maison des Enfants c'est 4 structures d'accueil pour vos enfants durant votre séjour. A Val Cenis Lanslebourg : Les Sablons et Plan des Champs. A Val Cenis Lanslevillard : Colombaz et Val Cenis le Haut. \r\n3 mois-12 ans en hiver, 3 mois-15 ans en été."
    ],
    "es": [
      "La Maison des Enfants dispone de 4 instalaciones para sus hijos durante su estancia. En Val Cenis Lanslebourg : Les Sablons y Plan des Champs. En Val Cenis Lanslevillard : Colombaz y Val Cenis le Haut.\r\n3 meses-12 años en invierno, 3 meses-15 años en verano."
    ],
    "nl": [
      "Het kinderdagverblijf Maison des Enfants bestaat uit 4 structuren voor uw kinderen tijdens uw vakantie. In Val Cenis Lanslebourg: Les Sablons en Plan des Champs. IN Val Cenis Lanslevillard: Colombaz en Val Cenis le Haut.\r\n3 maanden-12 jaar in de winter, 3 maanden-15 jaar in de zomer."
    ]
  },
