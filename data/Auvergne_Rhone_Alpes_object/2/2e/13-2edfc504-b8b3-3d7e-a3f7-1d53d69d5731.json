  "rdfs:comment": {
    "de": [
      "Sie lieben Tennis und möchten während Ihres Aufenthalts \"den Ball schlagen\"? In der fabelhaften Umgebung des Parc des Dérêches können Sie das Clubhaus von Morzine entdecken."
    ],
    "en": [
      "You love tennis and fancy a game during your holiday? Come and discover the Clubhouse in the beautiful setting of the Parc des Dérêches in Morzine."
    ],
    "it": [
      "Amate il tennis e volete \"colpire la palla\" durante il vostro soggiorno? Venite a scoprire la Club House di Morzine nella favolosa cornice del Parc des Dérêches."
    ],
    "fr": [
      "Vous aimez le Tennis et souhaitez « taper la balle » pendant votre séjour ? Dans la cadre fabuleux du Parc des Dérêches, venez découvrir le Club House de Morzine."
    ],
    "es": [
      "¿Le gusta el tenis y quiere \"pegarle a la pelota\" durante su estancia? Venga a descubrir el Morzine Club House en el fabuloso marco del Parc des Dérêches."
    ],
    "nl": [
      "Hou je van tennis en wil je een balletje slaan tijdens je verblijf? Kom en ontdek het Morzine Club House in de prachtige omgeving van het Parc des Dérêches."
    ]
  },
