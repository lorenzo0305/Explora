  "rdfs:comment": {
    "de": [
      "Das Sherpa empfängt Sie in seinem gemütlichen Rahmen und auf seiner Südterrasse im Herzen des Skigebiets."
    ],
    "en": [
      "Le Sherpa welcomes you to its inviting setting and south facing terrace at the heart of the resort."
    ],
    "it": [
      "Il Sherpa vi accoglie nel suo ambiente caloroso e la sua terrazza esposta a sud al cuore della stazione."
    ],
    "fr": [
      "Le Sherpa vous accueille dans son cadre chaleureux et sa terrasse plein sud au cœur de la station."
    ],
    "nl": [
      "Le Sherpa verwelkomt je in zijn warme omgeving en terras op het zuiden in het hart van het resort."
    ],
    "es": [
