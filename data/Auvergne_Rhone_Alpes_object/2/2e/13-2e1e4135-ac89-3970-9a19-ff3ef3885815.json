  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet Garets Gym Volontaire maximal zwei Schnupperkurse pro Person an: Fitness.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Garets Gym Volontaire offers a maximum of two discovery classes per person: Fitness.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, la Garets Gym Volontaire offre un massimo di due lezioni di scoperta del fitness a persona.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Garets Gym Volontaire propose deux cours maximum par personne de découverte : Fitness.\r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het vitaliteitsprogramma van Vichy biedt Garets Gym Volontaire maximaal twee fitnessontdekkingslessen per persoon aan.\r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, Garets Gym Volontaire ofrece un máximo de dos clases de descubrimiento del fitness por persona.\r\nInformación e inscripciones por teléfono."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fitness - Vichy Vitalité"
    ]
  },
