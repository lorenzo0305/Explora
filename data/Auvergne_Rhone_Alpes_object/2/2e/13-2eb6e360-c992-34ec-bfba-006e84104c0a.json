  "rdfs:comment": {
    "de": [
      "Das Kino l'Arverne ist ein moderner Saal, der fast 100 Personen Platz bietet. Es ist als Art & Essai-Kino eingestuft und bietet daher Filme für jeden Geschmack: in OV, in VF, Mainstream, Komödie, Action, Romantik, Thriller..."
    ],
    "en": [
      "The cinéma l'Arverne is a modern cinema with a capacity of almost 100 people. It is classified as an Art & Essai cinema, offering films to suit all tastes: VO, VF, mainstream, comedy, action, romance, thrillers..."
    ],
    "it": [
      "Il cinema di Arverne è un cinema moderno con una capacità di quasi 100 persone. È classificato Art & Essai e propone film adatti a tutti i gusti: in francese o in inglese, mainstream, commedia, azione, romantico, thriller..."
    ],
    "fr": [
      "Le cinéma l’Arverne est une salle moderne pouvant accueillir près de 100 personnes. Il est classé Art & Essai, et vous propose ainsi des films adaptés pour tous les goûts : en VO, en VF, des films grand public, comiques, d’action, romantiques, thriller..."
    ],
    "es": [
      "El cine Arverne es un cine moderno con capacidad para casi 100 personas. Está clasificado como Art & Essai, y ofrece películas adaptadas a todos los gustos: en francés o en inglés, mainstream, comedia, acción, romance, thriller..."
    ],
    "nl": [
      "De bioscoop van Arverne is een moderne bioscoop met een capaciteit van bijna 100 personen. Het is geclassificeerd Art & Essai, en biedt films aangepast aan alle smaken: in het Frans of Engels, mainstream, komedie, actie, romantiek, thriller..."
    ]
  },
