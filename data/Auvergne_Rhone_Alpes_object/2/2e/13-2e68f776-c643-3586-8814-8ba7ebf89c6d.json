  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Faltblatt. Das heutige Gebäude stammt aus dem 12. Jahrhundert und besteht aus drei Jochen und einem Glockenturm mit Kamm, der im 19. Im 15. Jahrhundert wurden ein weiteres Joch und ein gotischer Chor errichtet."
    ],
    "en": [
      "Self-guided tour with leaflet. The current building dates back to the 12th century, with three bays and a comb bell tower replaced in the 19th century. In the 15th century, an additional bay and a Gothic choir were added."
    ],
    "it": [
      "Visita autoguidata con opuscolo. L'edificio attuale risale al XII secolo, con tre campate e un campanile a pettine sostituito nel XIX secolo. Un'ulteriore campata e un coro gotico furono aggiunti nel XV secolo."
    ],
    "fr": [
      "Visite libre avec dépliant. L'édifice actuel date du XIIe siècle pour trois travées et un clocher à peigne remplacé au XIXe siècle. Au XVe siècle, une travée supplémentaire et un chœur gothique ont été construits."
    ],
    "es": [
      "Visita autoguiada con folleto. El edificio actual data del siglo XII, con tres naves y un campanario en peine que fue sustituido en el siglo XIX. En el siglo XV se añadieron una nave más y un coro gótico."
    ],
    "nl": [
      "Rondleiding met gids. Het huidige gebouw dateert uit de 12e eeuw, met drie traveeën en een kamklokkentoren die in de 19e eeuw werd vervangen. Een extra travee en een gotisch koor werden toegevoegd in de 15e eeuw."
    ]
  },
  "rdfs:label": {
