  "rdfs:comment": {
    "de": [
      "Der Doron de Bozel ist ein französischer Fluss, ein linksseitiger Nebenfluss der Isère und damit ein Nebenfluss der Rhône. Er fließt in der Region Rhône-Alpes im Département Savoie."
    ],
    "en": [
      "The Doron de Bozel is a French river, a left-bank tributary of the Isère and therefore a sub-tributary of the Rhône, which flows through the Rhône-Alpes region in the Savoie department."
    ],
    "it": [
      "Il Doron de Bozel è un fiume francese, affluente di sinistra dell'Isère e quindi sottoinsieme del Rodano, che scorre nella regione Rodano-Alpi, nel dipartimento della Savoia."
    ],
    "fr": [
      "Le Doron de Bozel est une rivière française, affluent de la rive gauche de l'Isère, et donc sous-affluent du Rhône, qui coule en région Rhône-Alpes, dans le département de la Savoie."
    ],
    "es": [
      "El Doron de Bozel es un río francés, afluente por la margen izquierda del Isère y, por tanto, subfluente del Ródano, que discurre por la región de Ródano-Alpes, en el departamento de Saboya."
    ],
    "nl": [
      "De Doron de Bozel is een Franse rivier, een zijrivier aan de linkeroever van de Isère en daardoor een zijrivier van de Rhône, die stroomt door de regio Rhône-Alpes in het departement Savoie."
    ]
  },
