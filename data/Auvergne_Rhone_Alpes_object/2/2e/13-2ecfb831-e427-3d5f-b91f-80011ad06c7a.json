  "rdfs:comment": {
    "de": [
      "Ein Zoo von 6 Hektar. Spektakeln von raptoren und Papageihen in der saison, Aufblazberer Spielplatz und Kleine farm (Tierpfleger)."
    ],
    "en": [
      "6 ha zoological park with more than 700 animals. Educational activities and snacks in season (from April to October), inflatable games, picnic. A fun and educational family visit in Drôme. Animal feeding and courses from February."
    ],
    "it": [
      "Lo Zoo vi invita a scoprire oltre 800 animali di 180 specie diverse. Dai coloratissimi pappagalli e dai maestosi rapaci agli aggraziati serval, ai curiosi suricati, alle tartarughe e ai lemuri, la gioia di tutta la famiglia è assicurata!"
    ],
    "fr": [
      "Le Zoo vous invite à découvrir plus de 800 animaux issus de 180 espèces différentes. Des perroquets colorés aux majestueux rapaces, des servals gracieux aux suricates curieux, en passant par les tortues et lémuriens, ils sauront envouter toute la famille!"
    ],
    "nl": [
      "Zes hectare weelderig groen en meer dan 1000 dieren van alle continenten. Gedurende het seizoen shows met roofvogels en papegaaien,\r\nspeeltuin met opblaastoestellen, en een kinder boerderij. Shows alleen in de middag (inbegrepen in de toegangsprijs)"
    ],
    "es": [
      "El Zoológico de Upie, que alberga más de 215 especies en un parque de 6 hectáreas, es un centro de cría y conservación de especies en peligro de extinción."
    ]
  },
  "rdfs:label": {
    "de": [
      "Zoo d'Upie - Le Jardin aux Oiseaux"
    ],
    "en": [
      "Upie Zoo"
    ],
    "fr": [
      "Le Zoo d'Upie"
    ],
    "es": [
      "Zoologico de Upie - El Jardin de los Pajaros"
    ],
    "nl": [
      "De tuin vogels"
    ]
  },
