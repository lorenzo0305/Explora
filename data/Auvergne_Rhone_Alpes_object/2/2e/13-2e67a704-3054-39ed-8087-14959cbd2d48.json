  "rdfs:comment": {
    "de": [
      "Die Boutique von VER A SOIE, dem Museum und Handwerksbetrieb in Lagorce, bietet Ihnen einen Kokon voller Wunder, der zu 100 % aus origineller Seide besteht!\r\nKissenbezüge, Kosmetika, Schmuck und Schals... Hier lässt sich jede Kreation von der Königin der Fasern inspirieren. Produktionen aus Frankreich."
    ],
    "en": [
      "The VER A SOIE boutique, a museum-magnanerie in Lagorce, offers you a cocoon of wonder 100% SILK and original!\r\nPillowcases, cosmetics, jewelry and scarves... Here, every creation is inspired by the Queen of Fibers. Productions France."
    ],
    "it": [
      "L'area boutique del museo vivente del baco da seta vi offre un bozzolo di meraviglie originali basate sulla seta!\r\nFedere, sciarpe, scialli, gioielli e cosmetici... Qui ogni creazione è ispirata alla regina delle fibre. Produzioni Francia."
    ],
    "fr": [
      "L'espace boutique du musée vivant du ver à soie, vous offre un cocon d'émerveillements originaux autour de la Soie !\r\nTaies d'oreillers, foulard, châles, bijoux et cosmétiques...Ici, chaque création s'inspire de la Reine des fibres. Productions France."
    ],
    "es": [
      "El espacio boutique del museo del gusano de seda viviente le ofrece un capullo de originales maravillas en torno a la seda\r\nFundas de almohada, bufandas, chales, joyas y cosméticos... Aquí, cada creación se inspira en la reina de las fibras. Producciones Francia."
    ],
    "nl": [
      "De winkel VER A SOIE, in het museum en de zijdemolen van Lagorce, biedt je een cocon van verwondering, 100% ZIJDE en origineel!\r\nKussenslopen, cosmetica, sieraden en sjaals... Hier is elke creatie geïnspireerd op de koningin van de vezels. Geproduceerd in Frankrijk."
    ]
  },
