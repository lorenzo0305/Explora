  "rdfs:comment": {
    "de": [
      "In der Auvergne, im Herzen des historischen Royat, entdecken Sie den Komfort und die einzigartige Eleganz der 43 Zimmer und der Suite des 5-Sterne-Hotels Princesse Flore in Royat in der Nähe von Clermont -Ferrand."
    ],
    "en": [
      "In Auvergne, in the heart of historic Royat, discover the unique comfort and elegance of the 43 rooms and suites of the 5-star Princesse Flore hotel in Royat near Clermont-Ferrand."
    ],
    "it": [
      "Nel cuore del centro storico di Royat, scoprite il comfort e l'eleganza unici delle 43 camere e suite dell'hotel 5 stelle Princesse Flore di Royat, vicino a Clermont-Ferrand."
    ],
    "fr": [
      "En Auvergne, découvrez au cœur du Royat historique, le confort et l'élégance unique des 43 chambres et suite de l'hôtel 5 étoiles Princesse Flore à Royat proche de Clermont -Ferrand."
    ],
    "nl": [
      "Ontdek in de Auvergne het unieke comfort en de elegantie van de 43 kamers en suites van het 5-sterrenhotel Princesse Flore in Royat bij Clermont-Ferrand."
    ],
    "es": [
      "En el corazón de la histórica Royat, descubra el confort y la elegancia únicos de las 43 habitaciones y suites del hotel de 5 estrellas Princesse Flore en Royat, cerca de Clermont-Ferrand."
    ]
  },
  "rdfs:label": {
