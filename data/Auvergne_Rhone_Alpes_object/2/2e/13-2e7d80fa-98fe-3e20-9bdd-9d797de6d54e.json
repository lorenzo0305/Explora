  "rdfs:comment": {
    "de": [
      "Eine Wanderung im Herzen des Tals, zwischen Bergdörfern, spektakulären Schluchten und Alpenpanoramen, mit einem atemberaubenden Blick auf den Mont Blanc am Col de Joux Plane.\r\n\r\n 170 km ? ca. 4,5 Stunden Fahrt"
    ],
    "en": [
      "A walk in the heart of the valley, between mountain villages, spectacular gorges and Alpine panoramas, with a breathtaking view of Mont Blanc from the Col de Joux Plane.\r\n\r\n 170 km ? approx. 4h30 drive"
    ],
    "it": [
      "Una passeggiata nel cuore della valle, tra villaggi di montagna, gole spettacolari e panorami alpini, con una vista mozzafiato sul Monte Bianco dal Col de Joux Plane.\r\n\r\n 170 km ? circa 4h30 di auto"
    ],
    "fr": [
      "Une balade au cœur de la vallée, entre villages de montagne, gorges spectaculaires et panoramas alpins, avec une vue imprenable sur le Mont Blanc au col de Joux Plane.\r\n\r\n 170 km – environ 4h30 de route"
    ],
    "es": [
      "Un paseo por el corazón del valle, entre pueblos de montaña, gargantas espectaculares y panoramas alpinos, con una vista impresionante del Mont Blanc desde el Col de Joux Plane.\r\n\r\n 170 km ? aprox. 4h30 en coche"
    ],
    "nl": [
      "Een wandeling door het hart van de vallei, tussen bergdorpjes, spectaculaire kloven en Alpenpanorama's, met een adembenemend uitzicht op de Mont Blanc vanaf de Col de Joux Plane.\r\n\r\n 170 km ? ongeveer 4u30 rijden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Itinéraire à moto / Balade du Luthier depuis Morzine"
    ]
  },
