  "rdfs:comment": {
    "de": [
      "La pizzeria des Cim' ist eine Pizzeria zum Mitnehmen in Bessans. Handwerklich hergestellte Pizzas aus frischen und lokalen Produkten. Verkauf von Getränken zum Mitnehmen (Biere & Weine aus Savoyen, Limonaden, Wasser...). Im Sommer profitieren Sie von einer Sonnenterrasse, auf der Sie Ihre Speisen vor Ort genießen können."
    ],
    "en": [
      "La pizzeria des Cim' is a takeaway pizzeria in Bessans. Homemade pizzas made with fresh local produce. Takeaway drinks (Savoy beers & wines, soft drinks, water...). In summer, enjoy a sunny terrace for on-the-spot tasting."
    ],
    "it": [
      "La pizzeria des Cim' è una pizzeria da asporto a Bessans. Pizze fatte in casa con prodotti freschi locali. Vendita di bevande da asporto (birre e vini della Savoia, bibite, acqua, ecc.). In estate, approfittate di una terrazza soleggiata per gustare il vostro pasto sul posto."
    ],
    "fr": [
      "La pizzeria des Cim' est une pizzeria à emporter sur Bessans. Pizzas artisanales à base de produits frais et locaux. Vente de boissons à emporter (bières & vins de Savoie, sodas, eau...). L'été, profitez d'une terrasse ensoleillée pour déguster sur place."
    ],
    "nl": [
      "La pizzeria des Cim' is een afhaalpizzeria in Bessans. Huisgemaakte pizza's met verse streekproducten. Verkoop van dranken om mee te nemen (Savoyse bieren en wijnen, frisdranken, water, enz.) Profiteer in de zomer van het zonnige terras om ter plekke van je maaltijd te genieten."
    ],
    "es": [
      "La pizzeria des Cim' es una pizzería para llevar situada en Bessans. Pizzas caseras elaboradas con productos locales frescos. Venta de bebidas para llevar (cervezas y vinos de Saboya, refrescos, agua, etc.). En verano, disfrute de una terraza soleada para saborear su comida in situ."
    ]
  },
