  "rdfs:comment": {
    "de": [
      "City-Stadion (Fußball und Futsal) und Sportflächen für mehrere Aktivitäten (Tennisplatz, Boulodrome, Pétanque und Jeu Provençal). Kinderspielplatz (Basketballfeld und Rutschen), wenig schattig. Einkaufsmöglichkeiten in der Nähe."
    ],
    "en": [
      "City stadium (soccer and futsal) and multi-activity sports areas (tennis court, boules pitch, pétanque and jeu provençal). Children's play area (basketball court and slides), with little shade. Shops nearby."
    ],
    "it": [
      "Stadio cittadino (calcio e futsal) e aree sportive multiattività (campo da tennis, campo da bocce, pétanque e jeu provençal). Area giochi per bambini (campo da basket e scivoli), con poca ombra. Negozi nelle vicinanze."
    ],
    "fr": [
      "City stade (football et futsal) et espaces de sport multi activités (court de tennis, boulodrome, pétanque et jeu provençal). Espace de jeux pour enfants (terrain de basket et toboggans), peu ombragé. Commerces à proximité."
    ],
    "nl": [
      "Stadion (voetbal en futsal) en sportterreinen met meerdere activiteiten (tennisbaan, jeu de boulesbaan, petanque en jeu de provençal). Speeltuin voor kinderen (basketbalveld en glijbanen), met weinig schaduw. Winkels in de buurt."
    ],
    "es": [
      "Estadio municipal (fútbol y fútbol sala) y zonas deportivas multiactividad (pista de tenis, campo de petanca, petanca y jeu provençal). Zona de juegos infantiles (cancha de baloncesto y toboganes), con poca sombra. Comercios cercanos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de loisirs de Vinezac"
    ]
  },
