  "rdfs:comment": {
    "de": [
      "Die Domaine Walbaum befindet sich seit dem 19. Jahrhundert in Familienbesitz und liegt im Herzen der südlichen Ardèche, nur wenige Kilometer von Pont d'Arc, den Gorges de l'Ardèche (Grand Site de France) und der Grotte Chauvet (UNESCO-Welterbe) entfernt."
    ],
    "en": [
      "Share an authentic experience at the heart of a family property for 7 generations, conducted with respect for biodiversity."
    ],
    "it": [
      "Proprietà di famiglia dal XIX secolo, il Domaine Walbaum si trova nel cuore dell'Ardèche meridionale, a pochi chilometri dal Pont d'Arc, dalle Gorges de l'Ardèche (Grand Site de France) e dalla Grotte Chauvet (patrimonio mondiale dell'UNESCO)."
    ],
    "fr": [
      "Propriété familiale depuis le XIXème siècle, le Domaine Walbaum se situe au cœur de l’Ardèche méridionale, à quelques kilomètres du Pont d’Arc, des Gorges de l’Ardèche (Grand Site de France) et de la Grotte Chauvet (Patrimoine Mondial UNESCO)."
    ],
    "es": [
      "Propiedad familiar desde el siglo XIX, el Domaine Walbaum está situado en el corazón del sur de Ardèche, a pocos kilómetros del Pont d'Arc, de las Gargantas de l'Ardèche (Grand Site de France) y de la Gruta Chauvet (Patrimonio Mundial de la UNESCO)."
    ],
    "nl": [
      "Een familiaal wijndomein sinds de 19e eeuw. Domaine de Colombier is gelegen in het hartje van zuid-Ardèche, naast Vallon Pont d'Arc."
    ]
  },
