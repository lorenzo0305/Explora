  "rdfs:comment": {
    "de": [
      "Petite note sur l'authenticité: depuis plus de 200 ans la véritable pastille de Vichy célèbre pour ses propriétés digestives est liée à l'eau minérale de la ville, est un symbole unique de Vichy."
    ],
    "en": [
      "Gourmandise and terroir: sweet and savoury pralines, legendary Vichy flavours, exceptional fruit jellies, Auvergne liqueurs and, of course, the genuine Vichy pastille, the unique symbol of Vichy."
    ],
    "it": [
      "Delizie gastronomiche e prodotti locali: praline dolci e salate, i leggendari sapori di Vichy, eccezionali gelatine di frutta, liquori d'Alvernia e, naturalmente, l'autentica pastille di Vichy, simbolo unico di Vichy."
    ],
    "fr": [
      "Gourmandise et terroir: pralines salées ou sucrées, saveurs Vichy mythiques, pâtes de fruits d'exception, liqueurs Auvergnates et bien sûr la véritable pastille de Vichy source symbole unique de Vichy."
    ],
    "nl": [
      "Lekkernijen en streekproducten: zoete en hartige pralines, legendarische smaken uit Vichy, uitzonderlijke vruchtengeleien, likeuren uit de Auvergne en natuurlijk de echte pastille uit Vichy, het unieke symbool van Vichy."
    ],
    "es": [
      "Delicias gastronómicas y productos locales: pralinés dulces y salados, sabores legendarios de Vichy, jaleas de frutas excepcionales, licores de Auvernia y, por supuesto, la auténtica pastilla de Vichy, símbolo único de Vichy."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pralines et Caramels"
    ]
  },
