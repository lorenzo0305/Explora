  "rdfs:comment": {
    "de": [
      "An Bord eines echten Dampfzuges können Sie eine ganz besondere Eierjagd erleben. Die Eier sind zwischen Bäumen und Sträuchern versteckt und werden gegen köstliche Schokolade eingetauscht."
    ],
    "en": [
      "Aboard an authentic steam train, experience an egg hunt like no other. Head for the wilderness to find the eggs hidden among the trees and thickets, which will then be exchanged for delicious chocolates."
    ],
    "it": [
      "A bordo di un autentico treno a vapore, vivete una caccia alle uova senza precedenti. Andate in campagna per trovare le uova nascoste tra gli alberi e i boschetti, che verranno poi scambiate con deliziosi cioccolatini."
    ],
    "fr": [
      "À bord d’un authentique train à vapeur, vivez une chasse aux œufs pas comme les autres. Direction la pleine nature pour dénicher les œufs, dissimulés entre les arbres et les fourrés, qui seront ensuite échangés contre de délicieux chocolats."
    ],
    "nl": [
      "Beleef aan boord van een authentieke stoomtrein een eierspeurtocht als geen ander. Trek het platteland in op zoek naar de eieren, verstopt tussen de bomen en het struikgewas, die vervolgens worden ingewisseld voor heerlijke chocolaatjes."
    ],
    "es": [
      "A bordo de un auténtico tren de vapor, viva una búsqueda de huevos sin igual. Adéntrese en el campo para encontrar los huevos, escondidos entre los árboles y matorrales, que luego serán canjeados por deliciosos bombones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le train des oeufs"
    ]
  },
