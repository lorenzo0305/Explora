  "rdfs:comment": {
    "de": [
      "Das Weinbaugebiet am Tor zur Maurienne\r\nAiton liegt am Zusammenfluss von Arc und Isère und signalisiert den Eingang zum Maurienne-Tal von der Combe de Savoie aus."
    ],
    "en": [
      "The vineyard at the gateway to the Maurienne\r\nSituated at the confluence of the Arc and Isère rivers, Aiton marks the entrance to the Maurienne valley from the Combe de Savoie."
    ],
    "it": [
      "Il vigneto alle porte della Maurienne\r\nSituato alla confluenza dei fiumi Arc e Isère, Aiton segna l'ingresso della valle della Maurienne dalla Combe de Savoie."
    ],
    "fr": [
      "Le vignoble à la porte de la Maurienne\r\nSitué à la confluence de l'Arc et de l'Isère, Aiton signe l'entrée dans la vallée de la Maurienne depuis la Combe de Savoie."
    ],
    "es": [
      "El viñedo a las puertas de la Maurienne\r\nSituado en la confluencia de los ríos Arc e Isère, Aiton marca la entrada al valle de Maurienne desde la Combe de Savoie."
    ],
    "nl": [
      "De wijngaard aan de poort van de Maurienne\r\nAiton, gelegen aan de samenvloeiing van de Arc en de Isère, markeert de toegang tot de Maurienne-vallei vanaf de Combe de Savoie."
    ]
  },
