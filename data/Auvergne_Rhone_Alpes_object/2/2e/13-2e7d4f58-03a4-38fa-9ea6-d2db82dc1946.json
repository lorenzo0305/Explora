  "rdfs:comment": {
    "de": [
      "Lernen Sie \"Emilie and the Cool Kids\" und ihr Team kennen, die nach dem Vorbild der Marke Süßes und Salziges zu 100% hausgemacht kochen!"
    ],
    "en": [
      "Come and meet \"Emilie and the Cool Kids\" and her team, just like the brand, who cook sweet and savoury 100% homemade!"
    ],
