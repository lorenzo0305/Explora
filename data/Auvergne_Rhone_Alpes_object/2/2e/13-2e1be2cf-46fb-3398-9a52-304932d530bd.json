  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte von Montbrun les Bains, einem Dorf, das zu den schönsten Dörfern Frankreichs zählt, seiner Kirche, des mächtigen, aber schrecklichen Herrschers Charles Dupuy Montbrun sowie des Thermalwesens"
    ],
    "en": [
      "Discover the history of Montbrun les Bains, a village listed as one of the most beautiful in France, its church, the powerful but terrible lord Charles Dupuy Montbrun and the spa industry"
    ],
    "it": [
      "Venite a scoprire la storia di Montbrun les Bains, un villaggio classificato come uno dei più belli di Francia, la sua chiesa, il potente ma terribile signore Charles Dupuy Montbrun e l'industria termale"
    ],
    "fr": [
      "Venez découvrir l'histoire de Montbrun les Bains, village classé parmi les plus beaux villages de France, de son église, du puissant mais terrible seigneur Charles Dupuy Montbrun ainsi que du thermalisme"
    ],
    "es": [
      "Venga a descubrir la historia de Montbrun les Bains, un pueblo catalogado como uno de los más bellos de Francia, su iglesia, el poderoso pero terrible señor Charles Dupuy Montbrun y la industria termal"
    ],
    "nl": [
      "Kom en ontdek de geschiedenis van Montbrun les Bains, een dorp dat op de lijst van de mooiste dorpen van Frankrijk staat, de kerk, de machtige maar verschrikkelijke heer Charles Dupuy Montbrun en de kuurindustrie"
    ]
  },
