  "rdfs:comment": {
    "de": [
      "Entdecken Sie die ältesten Olivenölmühlen von Nyons (XVIII. und XIX. Jahrhundert) und die historische Seifenfabrik aus dem XVIII. Jahrhundert, die bis heute einzigartig in Frankreich ist, sowie eine alte Küche aus der Haute-Provence. Die Besichtigung wird vom Enkel der Mühlenbesitzer kommentiert."
    ],
    "en": [
      "Discover the oldest oil mills of Nyons (XVIII and XIX centuries) and the historic soap factory of the XVIII century unique in France to this day, as well as an old kitchen of Haute-Provence. Visit commented by the grandson of the Mouliniers."
    ],
    "it": [
      "Scoprite i più antichi frantoi di Nyons (XVIII e XIX secolo) e la fabbrica di sapone del XVIII secolo, unica in Francia, nonché un'antica cucina dell'Alta Provenza. Visita guidata dal nipote dei mugnai."
    ],
    "fr": [
      "Découvrez les plus vieux Moulins à Huile d'olive de Nyons (XVIII et XIX siècles) et la Savonnerie du XVIII siècle, ensemble unique en France à ce jour, ainsi qu'une cuisine ancienne de Haute-Provence. Visite commentée par le petit fils des Mouliniers ."
    ],
    "nl": [
      "Dit familie erfgoed is verspreid over een oppervlakte van 350 m². U vindt hier 2 olijfmolens uit de 18e en de 19e eeuw, een zeepmakerij uit de 18e eeuw (vandaag de dag uniek in Frankrijk) en tevens een keuken van vroeger uit de Haute-Provence."
    ],
    "es": [
      "Descubra los molinos de aceite de oliva más antiguos de Nyons (siglos XVIII y XIX) y la fábrica de jabón del siglo XVIII, única en Francia, así como una antigua cocina de Alta Provenza. Visita guiada por el nieto de los molineros."
    ]
  },
