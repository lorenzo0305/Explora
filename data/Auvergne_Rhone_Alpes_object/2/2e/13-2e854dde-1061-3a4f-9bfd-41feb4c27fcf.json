  "rdfs:comment": {
    "de": [
      "Das Relais & Châteaux Le Flocons de Sel in Megève, ein 5-Sterne-Spa-Hotel und ein 3-Sterne-Gourmet-Restaurant im Guide Michelin, wird am 6. Dezember 2025 in Megève wiedereröffnet."
    ],
    "en": [
      "Relais & Châteaux Le Flocons de Sel in Megève, a 5-star spa hotel and Michelin 3-star gourmet restaurant, will reopen its doors on December 6 2025 in Megève."
    ],
    "it": [
      "Il Relais & Châteaux Le Flocons de Sel a Megève, hotel spa a 5 stelle e ristorante gastronomico con 3 stelle Michelin, riaprirà i battenti il prossimo 6 dicembre 2025 a Megève."
    ],
    "fr": [
      "Le Relais & Châteaux Le Flocons de Sel à Megève, hôtel spa 5 étoiles et restaurant gastronomique 3 étoiles au Guide Michelin, rouvre ses portes le 6 décembre 2025 à Megève."
    ],
    "nl": [
      "Het Relais & Châteaux Le Flocons de Sel in Megève, een 5-sterren kuurhotel en 3-sterren gastronomisch restaurant met Michelin Gids, heropent zijn deuren op 6 december 2025 in Megève."
    ],
    "es": [
      "El Relais & Châteaux Le Flocons de Sel de Megève, hotel balneario de 5 estrellas y restaurante gastronómico de 3 estrellas de la Guía Michelin, reabre sus puertas el 6 de diciembre de 2025 en Megève."
    ]
