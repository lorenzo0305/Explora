  "rdfs:comment": {
    "de": [
      "Einwohnerzahl: 892 (2017)\r\nFläche: 9,04 km2\r\nEingebettet zwischen den Hängen von Baret, die die Ebene von Valence abschließen, und Les Monts du matin, den ersten Ausläufern des Vercors, ist Jaillans eine neue, aber dennoch geschichtsträchtige Gemeinde."
    ],
    "en": [
      "Population: 892 (2017)\r\nSurface area: 9.04 km2\r\nNestled between the Baret hills that end the Valence plain and Les Monts du matin, the first foothills of the Vercors, Jaillans is a recent commune that is nonetheless steeped in history."
    ],
    "it": [
      "Popolazione: 999 (2023)\r\nSuperficie: 9,04 km2\r\nIncastonata tra le pendici del Baret, alla fine della pianura di Valence, e i Monts du Matin, ai piedi del Vercors, Jaillans è una comunità recente ma ricca di storia."
    ],
    "fr": [
      "Nombre d'habitants : 999 (2023)\r\nSuperficie : 9,04 km2\r\nBlottie entre les coteaux de Baret qui terminent la plaine de Valence et Les Monts du matin, premiers contreforts du Vercors, Jaillans est une commune récente mais pourtant chargée d’histoire."
    ],
    "es": [
      "Población: 999 (2023)\r\nSuperficie: 9,04 km2\r\nEnclavado entre las laderas del Baret, al final de la llanura de Valence, y los Montes del Matin, estribaciones del Vercors, Jaillans es un municipio reciente, pero cargado de historia."
    ],
    "nl": [
      "Bevolking: 892 (2017)\r\nOppervlakte: 9,04 km2\r\nTussen de hellingen van Baret, aan het einde van de vlakte van Valence, en de Monts du Matin, de uitlopers van de Vercors, ligt Jaillans, een recente gemeente met een rijke geschiedenis."
    ]
  },
