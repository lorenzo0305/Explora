  "rdfs:comment": {
    "de": [
      "Kommen Sie den Gipfeln auf diesem einzigartigen Klettersteig, der etwa eine Stunde dauert, ganz nah. Zauberhafte Aussicht auf den See von Annecy und das Mont-Blanc-Massiv. Holen Sie diesen Klettersteig nach einer 2-stündigen Wanderung mit 730 m Höhenunterschied wieder ab."
    ],
    "en": [
      "Get close to the mountain tops with this unique via ferrata! Magical view of lake Annecy and Mont-Blanc on this circuit accessible to all."
    ],
    "it": [
      "Avvicinatevi a questa via ferrata unica nel suo genere, della durata di circa 1 ora. Una vista magica sul lago di Annecy e sul massiccio del Monte Bianco. Riprendete questa via ferrata dopo un'escursione di 2 ore e un'ascesa di 730 metri."
    ],
    "fr": [
      "Côtoyez de plus près les cimes avec cette via ferrata unique, d'une durée d'environ 1h. Vue magique sur le lac d'Annecy et le Massif du Mont-Blanc. Récupérez cette Via ferrata après une randonnée de 2h et 730 m de dénivelé."
    ],
    "nl": [
      "Deze unieke klettersteig duurt ongeveer 1 uur en is van heel dichtbij te bewonderen. Een magisch uitzicht op het meer van Annecy en het Mont Blanc-massief. Pak deze klettersteig na een wandeling van 2 uur en een klim van 730 m."
    ],
    "es": [
      "Acérquese a esta vía ferrata única, de aproximadamente 1 hora de duración. Una vista mágica del lago de Annecy y del macizo del Mont Blanc. Recoja esta vía ferrata tras 2 horas de caminata y 730 m de ascenso."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Sambuy via ferrata and rock climbing"
    ],
    "fr": [
      "Via ferrata et escalade à la Sambuy"
    ]
  },
