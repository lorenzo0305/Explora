  "rdfs:comment": {
    "de": [
      "Die Brasserie du Centre befindet sich im Einkaufszentrum Super U in Ruoms und empfängt Sie in einer herzlichen Atmosphäre. Genießen Sie eine gepflegte hausgemachte Küche aus frischen Produkten und einen schnellen Service für eine gesellige Gourmetpause."
    ],
    "en": [
      "Located in the Super U shopping center in Ruoms, the Brasserie du Centre welcomes you in a warm atmosphere. Enjoy home-cooked meals, made with fresh produce, and quick service for a convivial gourmet break."
    ],
    "it": [
      "Situata nel centro commerciale Super U di Ruoms, la Brasserie du Centre offre un'accoglienza calorosa. Godetevi la cucina casalinga, i prodotti freschi e il servizio veloce per una pausa conviviale e gastronomica."
    ],
    "fr": [
      "Située dans le centre commercial Super U à Ruoms, la Brasserie du Centre vous accueille dans une ambiance chaleureuse. Profitez d’une cuisine maison soignée, à base de produits frais, et d’un service rapide pour une pause gourmande et conviviale."
    ],
    "es": [
      "Situada en el centro comercial Super U de Ruoms, la Brasserie du Centre le ofrece una cálida bienvenida. Disfrute de una comida casera elaborada con productos frescos y un servicio rápido para una pausa agradable y gastronómica."
    ],
    "nl": [
      "Gelegen in het Super U winkelcentrum in Ruoms, biedt de Brasserie du Centre een warm welkom. Geniet van huisbereid eten met verse producten en snelle service voor een gezellige, gastronomische pauze."
    ]
  },
