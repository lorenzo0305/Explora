  "rdfs:comment": {
    "de": [
      "Le bistro c'est: eine hausgemachte, lokale und saisonale Küche mit frischen Produkten, die hauptsächlich aus bäuerlicher und biologischer Landwirtschaft stammen; Bier vom Fass und verschiedene handwerkliche und lokale Getränke; Konzert- oder Unterhaltungsabende das ganze Jahr über."
    ],
    "en": [
      "The bistro offers home-made, local, seasonal cuisine based on fresh produce, mainly from local and organic farms; draught beers and a variety of local craft beverages; concert and entertainment evenings all year round."
    ],
    "it": [
      "Il bistrot offre una cucina casalinga, locale e stagionale a base di prodotti freschi, provenienti principalmente da aziende agricole locali e biologiche; birre alla spina e una gamma di bevande artigianali locali; musica dal vivo e intrattenimento tutto l'anno."
    ],
    "fr": [
      "Le bistro c’est : une cuisine maison, locale et de saison à base de produits frais principalement issus de l’agriculture paysanne et bio ; des bières pressions, et divers boissons artisanales et locales ; des soirées concert ou animées toute l’année."
    ],
    "es": [
      "El bistró ofrece cocina casera, local y de temporada basada en productos frescos, principalmente de granjas locales y ecológicas; cervezas de barril y una gama de bebidas artesanales locales; y música y entretenimiento en directo durante todo el año."
    ],
    "nl": [
      "De bistro biedt huisgemaakte, lokale, seizoensgebonden gerechten op basis van verse producten, voornamelijk van lokale en biologische boerderijen; bieren van het vat en een reeks lokale ambachtelijke dranken; en het hele jaar door livemuziek en entertainment."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistro Le Cheval Blanc"
    ]
  },
