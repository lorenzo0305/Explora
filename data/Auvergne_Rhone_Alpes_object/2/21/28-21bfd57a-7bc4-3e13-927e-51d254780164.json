      "rdfs:comment": {
        "de": [
          "Ihre Lieblingsbrauerei in Etinehem-Méricourt!\nProbieren Sie unsere Biere vom Fass, Cocktails, Aperitifbretter und auch unsere Speisekarte."
        ],
        "en": [
          "Your favorite brewery in Etinehem-Méricourt!\nCome and sample our draught beers, cocktails, aperitif platters and our catering menu."
        ],
        "it": [
          "La vostra birreria preferita a Etinehem-Méricourt!\nVenite a provare le nostre birre alla spina, i cocktail, gli aperitivi e il nostro menu."
        ],
        "fr": [
          "Votre brasserie préférée installée à Etinehem-Méricourt !\nVenez déguster nos bières en pression, cocktails, nos planches apéritives et également notre carte restauration."
        ],
        "es": [
          "¡Su cervecería favorita en Etinehem-Méricourt!\nVenga a probar nuestras cervezas de barril, cócteles, platos de aperitivo y nuestra carta."
        ],
        "nl": [
          "Uw favoriete brouwerij in Etinehem-Méricourt!\nKom onze bieren van het vat, cocktails, aperitiefschotels en onze kaart proeven."
        ]
      },
