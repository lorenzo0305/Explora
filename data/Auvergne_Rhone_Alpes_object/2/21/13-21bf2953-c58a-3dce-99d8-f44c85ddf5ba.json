  "rdfs:comment": {
    "de": [
      "Anlässlich der Durchfahrt der Ardéchoise schmückt sich das Dorf mit zahlreichen Farben. Animationen, Musik, Tanz, Spiele und Mahlzeiten."
    ],
    "en": [
      "As the Ardéchoise passes through, the village is decked out in color. Entertainment, music, dance, games and meals."
    ],
    "it": [
      "Al passaggio dell'Ardéchoise, il villaggio si veste di tutti i colori. Intrattenimento, musica, balli, giochi e pasti."
    ],
    "fr": [
      "A l'occasion du passage de l'Ardéchoise, le village se pare de multiples couleurs. Animations, musique, danse, jeux et repas."
    ],
    "nl": [
      "Als de Ardéchoise passeert, wordt het dorp in allerlei kleuren gehuld. Amusement, muziek, dans, spelletjes en maaltijden."
    ],
    "es": [
      "Al paso de la Ardéchoise, el pueblo se engalana con todo tipo de colores. Animaciones, música, bailes, juegos y comidas."
    ]
