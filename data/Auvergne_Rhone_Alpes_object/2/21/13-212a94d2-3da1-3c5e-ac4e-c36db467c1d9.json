  "rdfs:comment": {
    "de": [
      "In einem fruchtbaren Dialog zwischen den Sammlungen des Fonds régional d'art contemporain und des Museums zeigt diese Ausstellung Werke und Volumeninstallationen, die aufzeigen, wie Künstler aus dem Rahmen und den traditionellen Codes der Kunst ausbrechen."
    ],
    "en": [
      "A fruitful dialogue between the collections of the Fonds régional d'art contemporain and the museum, this exhibition presents works and installations in volume, revealing the ways in which artists break out of the framework and traditional codes of art."
    ],
    "it": [
      "Un dialogo fruttuoso tra le collezioni del Fonds régional d'art contemporain e il museo, questa mostra presenta opere e installazioni in volume, rivelando i modi in cui gli artisti escono dal quadro e dai codici tradizionali dell'arte."
    ],
    "fr": [
      "Dialogue fructueux entre les collections du Fonds régional d'art contemporain et du musée, cette exposition présente des œuvres et des installations en volume révélant la manière dont les artistes sortent du cadre, des codes traditionnels de l'art."
    ],
    "es": [
      "Fructífero diálogo entre las colecciones del Fonds régional d'art contemporain y el museo, esta exposición presenta obras e instalaciones en volumen, revelando las maneras en que los artistas se salen del marco y de los códigos tradicionales del arte."
    ],
    "nl": [
      "Deze tentoonstelling, een vruchtbare dialoog tussen de collecties van het Fonds régional d'art contemporain en het museum, presenteert werken en installaties in volume en onthult de manieren waarop kunstenaars het kader en de traditionele codes van de kunst doorbreken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition : Hors-cadre, œuvres du FRAC Auvergne"
    ]
  },
