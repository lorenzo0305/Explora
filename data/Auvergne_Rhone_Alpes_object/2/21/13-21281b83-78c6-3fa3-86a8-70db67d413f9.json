  "rdfs:comment": {
    "de": [
      "L'Inattendu ist die Entdeckung durch echte Produkte. Teilen Sie traditionelle Gerichte, die so zubereitet werden, dass sie Ihnen eine ganz neue Emotion vermitteln. Entdecken Sie die überraschende Mischung aus authentischen Produkten und einer jungen, ambitionierten Küche."
    ],
    "en": [
      "Unexpected is the discovery through real products. Share traditional cooked dishes to bring you a new emotion. Discover the surprising mix of authentic products and a young and ambitious cuisine"
    ],
    "it": [
      "L'Inattendu è la scoperta di prodotti reali. Condividete i piatti tradizionali cucinati per regalarvi una nuova emozione. Scoprite il sorprendente mix di prodotti autentici e una cucina giovane e ambiziosa"
    ],
    "fr": [
      "L’Inattendu, c’est la découverte au travers de vrais produits. Partagez des plats traditionnels cuisinés pour vous apporter une émotion inédite. Découvrez le mélange surprenant des produits authentiques  et d’une cuisine jeune et ambitieuse"
    ],
    "nl": [
      "L'Inattendu gaat over het ontdekken van echte producten. Deel traditionele gerechten gekookt om u een nieuwe emotie te brengen. Ontdek de verrassende mix van authentieke producten en een jonge, ambitieuze keuken"
    ],
    "es": [
      "L'Inattendu es todo descubrimiento a través de productos reales. Comparta platos tradicionales cocinados para ofrecerle una nueva emoción. Descubra la sorprendente combinación de productos auténticos y una cocina joven y ambiciosa."
    ]
  },
