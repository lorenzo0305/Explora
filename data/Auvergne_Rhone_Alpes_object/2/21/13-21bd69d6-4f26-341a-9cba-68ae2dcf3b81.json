  "rdfs:comment": {
    "de": [
      "Im Bahnhof Tournon Saint Jean bietet der Buffet-/Buvettenbereich Getränke (warm und kalt) und Gourmetfreuden (süß und salzig), um die Geschmacksnerven zu erfreuen! Kontinuierliche Öffnung in der Hochsaison."
    ],
    "en": [
      "At Tournon Saint Jean station, the buffet / refreshment area offers drinks (hot and cold) and gourmet pleasures (sweet and savory) to delight the taste buds! Continuous opening in high season."
    ],
    "it": [
      "Alla stazione di Tournon Saint Jean de Muzols, l'area buffet-buffet offre bevande (calde e fredde) e specialità gastronomiche (dolci e salate) per stuzzicare il palato!"
    ],
    "fr": [
      "En gare de Tournon Saint Jean de Muzols, l’espace buffet-buvette propose boissons (chaudes et fraîches) et plaisirs gourmands (sucrés et salés) pour régaler les papilles !"
    ],
    "nl": [
      "In het station van Tournon Saint Jean de Muzols biedt het buffetgedeelte drankjes (warm en koud) en lekkernijen (zoet en hartig) om de smaakpapillen te prikkelen!"
    ],
    "es": [
      "En la estación de Tournon Saint Jean de Muzols, la zona de buffet-buffet ofrece bebidas (frías y calientes) y golosinas (dulces y saladas) para deleitar el paladar"
    ]
  },
