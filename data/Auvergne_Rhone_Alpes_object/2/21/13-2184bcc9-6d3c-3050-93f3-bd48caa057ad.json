  "rdfs:comment": {
    "de": [
      "Lili-Clémence stellt Kopfschmuck aus stabilisierten und getrockneten Blumen und botanische Skulpturen her\r\nzeitgenössischen Blumen. Dabei verwendet sie die alte Technik der Blumenmontagen, die ihr eine große kreative Freiheit ermöglicht."
    ],
    "en": [
      "Lili-Clémence makes head ornaments from stabilized, dried flowers and contemporary botanical sculptures\r\nsculptures. To do so, she uses the ancient technique of mounting flowers, which gives her great creative freedom."
    ],
    "it": [
      "Lili-Clémence realizza ornamenti per la testa con fiori stabilizzati ed essiccati e sculture botaniche contemporanee\r\nsculture. Utilizza l'antica tecnica di montaggio dei fiori, che le consente una grande libertà creativa."
    ],
    "fr": [
      "Lili-Clémence fabrique des ornements de têtes en fleurs stabilisées et séchées et des sculptures botaniques \r\ncontemporaines. Pour ce faire, elle utilise la technique ancienne de montages des fleurs qui lui permet une grande liberté de création."
    ],
    "nl": [
      "Lili-Clémence maakt hoofdsieraden van gestabiliseerde, gedroogde bloemen en hedendaagse botanische sculpturen\r\nbeelden. Ze gebruikt de eeuwenoude techniek van het inbedden van bloemen, wat haar een grote creatieve vrijheid geeft."
    ],
    "es": [
      "Lili-Clémence fabrica adornos para la cabeza a partir de flores secas estabilizadas y esculturas botánicas contemporáneas\r\nesculturas. Utiliza la antigua técnica del montaje de flores, que le da una gran libertad creativa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Lili-Clémence Bethemont"
    ]
  },
