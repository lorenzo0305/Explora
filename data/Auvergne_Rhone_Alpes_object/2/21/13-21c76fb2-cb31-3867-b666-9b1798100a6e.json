  "rdfs:comment": {
    "de": [
      "Donzère?Ein Abschnitt, den Madame de Sévigné nie vergessen wird?Begeben Sie sich auf ein d-Abenteuer, um das faszinierende Geheimnis von Donzère zu lüften und der Marquise de Sévigné über die Jahrhunderte hinweg zu helfen.\r\nEin Spiel von Planète Guides, auf Anfrage und nach Voranmeldung."
    ],
    "en": [
      "Donzère... A passage that Madame de Sévigné will never forget... Go on an adventure to discover the fascinating mystery of Donzère and help the Marquise de Sévigné beyond the centuries. \r\nA Planet Guides game, on request by reservation."
    ],
    "it": [
      "Donzère... Un passaggio che Madame de Sévigné non dimenticherà mai... Partite all'avventura per scoprire l'affascinante mistero di Donzère e aiutate la Marchesa de Sévigné ad attraversare i secoli.\r\nUn gioco delle Guide Planète, disponibile su richiesta."
    ],
    "fr": [
      "Donzère…Un passage que madame de Sévigné n’oubliera jamais…Partez à l’aventure d pour découvrir le fascinant mystère de Donzère et aider la marquise de Sévigné par-delà les siècles. \r\nUn jeu Planète Guides, à la demande sur réservation."
    ],
    "es": [
      "Donzère... Un pasaje que Madame de Sévigné nunca olvidará... Embárcate en una aventura para descubrir el fascinante misterio de Donzère y ayudar a la marquesa de Sévigné a través de los siglos.\r\nUn juego de Planète Guides, disponible a petición."
    ],
    "nl": [
      "Donzère... Een passage die Madame de Sévigné nooit zal vergeten... Ga op avontuur om het fascinerende mysterie van Donzère te ontdekken en help de markiezin van Sévigné door de eeuwen heen.\r\nEen spel van Planète Guides, verkrijgbaar op aanvraag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Année 2026 : Madame de Sévigné et le mystère de Donzère"
    ]
  },
