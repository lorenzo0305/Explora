  "rdfs:comment": {
    "de": [
      "Hören Sie den Petits Chanteurs de Valence, dem Kinderchor der Kathedrale, von 8 bis 15 Jahren, bei einer 30-minütigen musikalischen Pause zu.\r\nGesang, Orgel, unter den Gewölben der wunderschönen Kirche."
    ],
    "en": [
      "Come and listen to the Petits Chanteurs de Valence, a cathedral choir for children aged 8 to 15, for a 30-minute musical break.\r\nSinging, organ, under the vaults of the magnificent church."
    ],
    "it": [
      "Venite ad ascoltare i Petits Chanteurs de Valence, un coro di bambini della cattedrale, dagli 8 ai 15 anni, per una pausa musicale di 30 minuti.\r\nCanto, organo, sotto le volte della magnifica chiesa."
    ],
    "fr": [
      "Venez écouter les Petits Chanteurs de Valence, chœur d’enfants de la cathédrale, de 8 à 15 ans, pour une pause musicale de 30 minutes.\r\nChants, orgue, sous les voûtes de la magnifique église."
    ],
    "es": [
      "Venga a escuchar a los Petits Chanteurs de Valence, un coro de niños de la catedral, de entre 8 y 15 años, durante una pausa musical de 30 minutos.\r\nCanto, órgano, bajo las bóvedas de la magnífica iglesia."
    ],
    "nl": [
      "Kom luisteren naar de Petits Chanteurs de Valence, een kinderkoor uit de kathedraal van 8 tot 15 jaar, voor een muzikale pauze van 30 minuten.\r\nZingen, orgel, onder de gewelven van de prachtige kerk."
    ]
  },
  "rdfs:label": {
