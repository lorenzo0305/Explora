  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a8ddaf25-f34c-3ba5-9132-3f45558f52d6",
      "dc:description": {
        "de": [
          "Familiengeführte, handwerklich arbeitende Keksfabrik in Hardelot Plage. Hausgemachte Herstellung von süßen Keksen, Mürbeteiggebäck und weichen Keksen sowie von Salzgebäck.\nWenn Sie Glück haben, können Sie auch bei der Herstellung der kleinen Kekse zuschauen und die guten Gerüche beim Backen riechen!"
        ],
        "en": [
          "Family-run, artisanal cookie factory in Hardelot Plage. Home-made sweet, shortbread and soft cookies, as well as savory cookies.\nIf you're lucky, you'll also be able to watch the cookies being baked, and smell the delicious aroma!"
        ],
        "it": [
          "Biscottificio tradizionale a conduzione familiare a Hardelot Plage. Biscotti dolci, frollini, morbidi e salati fatti in casa.\nSe siete fortunati, potrete anche assistere alla cottura dei biscotti e sentirne il delizioso aroma!"
        ],
        "fr": [
          "Biscuiterie familiale et artisanale à Hardelot Plage. Fabrication maison de biscuits sucrés, sablés et moelleux, et de biscuits salés.\nSi vous avez de la chance, vous pourrez également assister à la fabrication de ces petits biscuits et humer les bonnes odeurs de cuissons !"
        ],
        "es": [
          "Fábrica familiar de galletas tradicionales en Hardelot Plage. Galletas caseras dulces, de mantequilla, blandas y saladas.\nSi tiene suerte, podrá ver cómo se hornean las galletas y oler su delicioso aroma"
        ],
        "nl": [
          "Ambachtelijke koekjesfabriek in familiebeheer in Hardelot Plage. Huisgemaakte zoete, zandkoekjes, zachte en hartige koekjes.\nAls je geluk hebt, kun je ook zien hoe de koekjes worden gebakken en het heerlijke aroma ruiken!"
        ]
      },
      "@type": [
        "Description"
      ],
