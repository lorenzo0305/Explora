  "rdfs:comment": {
    "de": [
      "Hotel mit klimatisierten Zimmern und eigenen Bädern. Restaurant mit traditioneller Küche, kostenloser Privatparkplatz, der nachts geschlossen ist. Ladestation für Elektroautos. Das Hotel liegt an der Ausfahrt der Autobahn A6 (Ausfahrt 31.2)"
    ],
    "en": [
      "Hotel with air-conditioned rooms and private bathroom. Restaurant offering traditional cuisine, free private parking and closed at night. Charging station for electric cars. Located at the exit of the A6 motorway. (Exit 31.2)"
    ],
    "it": [
      "Hotel con camere climatizzate e bagno privato. Ristorante con cucina tradizionale, parcheggio privato gratuito chiuso di notte. Punto di ricarica per auto elettriche. Situato appena fuori dall'autostrada A6 (uscita 31.2)"
    ],
    "fr": [
      "Hôtel avec chambres climatisées et salles de bains privatives. Restaurant proposant une cuisine traditionnelle, parking privé gratuit et fermé la nuit. Borne de recharge pour voitures électriques. Situé à la sortie de l'autoroute A6. (sortie 31.2)"
    ],
    "nl": [
      "Hotel met kamers met airconditioning en eigen badkamer. Restaurant met traditionele keuken, gratis privéparkeerplaats 's nachts gesloten. Oplaadpunt voor elektrische auto. Gelegen vlak bij de snelweg A6 (afslag 31.2)"
    ],
    "es": [
      "Hotel con habitaciones con aire acondicionado y baño privado. Restaurante de cocina tradicional, aparcamiento privado gratuito cerrado por la noche. Punto de recarga para coches eléctricos. Situado junto a la autopista A6 (salida 31.2)"
    ]
  },
