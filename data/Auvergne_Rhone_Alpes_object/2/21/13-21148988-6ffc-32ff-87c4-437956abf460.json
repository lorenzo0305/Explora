  "rdfs:comment": {
    "de": [
      "Diese Wanderung entlang des Flusses Galaure und dann auf die umliegenden Hügel bietet schöne Panoramen."
    ],
    "en": [
      "This hike along the Galaure river and on the surrounding hills offers beautiful panoramas."
    ],
    "it": [
      "Questa escursione lungo il fiume Galaure e sulle colline circostanti offre incantevoli viste panoramiche.\r\nScopritela sull'applicazione \"MHIKES\"."
    ],
    "fr": [
      "Cette randonnée le long de la Galaure puis sur les collines environnantes offre de jolis panoramas. \r\nA découvrir dans l'application les \"MHIKES\"."
    ],
    "es": [
      "Esta excursión a lo largo del río Galaure y por las colinas circundantes ofrece hermosas vistas panorámicas.\r\nDescúbrela en la aplicación \"MHIKES\"."
    ],
    "nl": [
      "Deze wandeling langs de rivier de Galaure en over de omringende heuvels biedt een aantal mooie panoramische uitzichten."
    ]
  },
  "rdfs:label": {
