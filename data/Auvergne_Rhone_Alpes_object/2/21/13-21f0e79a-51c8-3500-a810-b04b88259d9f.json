  "rdfs:comment": {
    "de": [
      "Bamavi ist ein Open-Air-Pub-Restaurant mit einer Auswahl an frisch gezapften Bieren und handwerklich hergestellten, frischen und \"hausgemachten\" Speisen.\r\nSpezialität: Flammekueche, die über dem Holzfeuer gebacken wird. Atypischer, angenehmer und entspannter Ort. Privatisierung möglich."
    ],
    "en": [
      "Bamavi is an open-air restaurant-pub offering a selection of draught beers and fresh, homemade food.\r\nSpeciality: wood-fired Flammekueche. Atypical, pleasant and relaxed place. Privatization possible."
    ],
    "it": [
      "Bamavi è un ristorante-pub all'aperto che offre una selezione di birre alla spina e piatti freschi e fatti in casa.\r\nSpecialità: Flammekueche cotte sul fuoco a legna. Luogo atipico, piacevole e rilassato. Possibilità di privatizzazione."
    ],
    "fr": [
      "Bamavi est un restaurant-pub en open-air avec une sélection de bières à la pression et une restauration artisanale, fraîche et \"fait maison\".\r\nSpécialité : Flammekueche cuite au feu de bois. Lieu atypique, agréable et décontracté. Privatisation possible."
    ],
    "nl": [
      "Bamavi is een openluchtrestaurant-pub met een selectie tapbieren en verse, huisgemaakte gerechten.\r\nSpecialiteit: Flammekueche bereid boven een houtvuur. Atypische, aangename en ontspannen plek. Privatisering mogelijk."
    ],
    "es": [
      "Bamavi es un restaurante-pub al aire libre que ofrece una selección de cervezas de barril y comida fresca y casera.\r\nEspecialidad: Flammekueche cocinada al fuego de leña. Lugar atípico, agradable y relajado. Posibilidad de privatización."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bamavi Bar-Pub-Restaurant"
    ]
  },
