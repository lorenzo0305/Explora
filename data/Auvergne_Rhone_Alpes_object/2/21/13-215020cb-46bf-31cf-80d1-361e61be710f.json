  "rdfs:comment": {
    "de": [
      "Essbar (Galettes und Crêpes): Samstag und Sonntag von 17:00 bis 23:00 Uhr\r\nTrinkbar: Freitag bis Sonntag von 10 bis 15 Uhr und von 17 bis 23 Uhr, dann sonntags und dienstags von 10 bis 15 Uhr."
    ],
    "en": [
      "Bar à manger (galettes et crêpes): Saturday and Sunday, 5pm to 11pm\r\nDrinks bar: Friday to Sunday, 10 a.m. to 3 p.m. and 5 p.m. to 11 p.m.; Sunday and Tuesday, 10 a.m. to 3 p.m."
    ],
    "it": [
      "Food bar (galettes e crêpes): sabato e domenica dalle 17.00 alle 23.00\r\nDrink bar: da venerdì a domenica dalle 10.00 alle 15.00 e dalle 17.00 alle 23.00, poi domenica e martedì dalle 10.00 alle 15.00."
    ],
    "fr": [
      "Bar à manger (galettes et crêpes)  : samedi et dimanche de 17h à 23h\r\nBar à boire : du vendredi au dimanche de 10h à 15h et de 17h à 23h puis le dimanche et mardi de 10h à 15h."
    ],
    "nl": [
      "Eetbar (galettes en crêpes): zaterdag en zondag van 17.00 tot 23.00 uur\r\nDrankbar: vrijdag tot zondag van 10 tot 15 uur en van 17 tot 23 uur, daarna op zondag en dinsdag van 10 tot 15 uur."
    ],
    "es": [
      "Bar de comidas (galettes y crêpes): sábado y domingo de 17.00 a 23.00 h\r\nBar de copas: de viernes a domingo de 10:00 a 15:00 y de 17:00 a 23:00, y el domingo y el martes de 10:00 a 15:00."
    ]
