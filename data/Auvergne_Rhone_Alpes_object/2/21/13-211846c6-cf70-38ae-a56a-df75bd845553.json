  "rdfs:comment": {
    "de": [
      "Nichts hat sich geändert, außer der Adresse. Nelly und Régis LEBRUN heißen Sie in ihren neuen Räumen/Rahmen mit Charme und nüchternem, elegantem Dekor herzlich willkommen, um einen angenehmen, geselligen und leckeren Moment zu verbringen."
    ],
    "en": [
      "Nothing has changed, except the address, Nelly and Régis LEBRUN welcome you in their new restaurant, a charming place with a sober and elegant decoration. Come and spend a pleasant, convivial and gourmand moment."
    ],
    "it": [
      "Nulla è cambiato, tranne l'indirizzo: Nelly e Régis LEBRUN vi danno il benvenuto nel loro nuovo ambiente affascinante ed elegante per trascorrere un momento piacevole, conviviale e gastronomico."
    ],
    "fr": [
      "Rien n'a changé, sauf l'adresse, Nelly et Régis LEBRUN vous accueillent dans leur nouvel espaces/cadre au charme et au décor sobre et élégant pour passer un moment agréable, convivial et gourmand."
    ],
    "es": [
      "¡No ha cambiado nada, excepto la dirección! Nelly y Régis LEBRUN te dan la bienvenida en su nuevo restaurante, un entorno encantador con una decoración sobria y elegante. Ven a disfrutar de un momento agradable, alegre y gourmet."
    ],
    "nl": [
      "Niets is veranderd, behalve het adres, Nelly en Régis LEBRUN heten u welkom in hun nieuwe charmante en elegante omgeving om een aangenaam, gezellig en gastronomisch moment door te brengen."
    ]
  },
  "rdfs:label": {
