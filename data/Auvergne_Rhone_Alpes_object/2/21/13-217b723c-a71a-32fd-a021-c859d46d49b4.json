  "rdfs:comment": {
    "de": [
      "Gegenüber der Seilbahn Aiguille du Midi, dem Ausgangspunkt in die große Höhe und nicht weit von verschiedenen Skigebieten und Wanderwegen entfernt, verspricht das Heliopic Hotel &amp; Spa einen unvergesslichen Aufenthalt in den Alpen."
    ],
    "en": [
      "Opposite the Aiguille du Midi cable car, the starting point for high-altitude skiing and hiking, the Heliopic Hotel &amp; Spa promises an unforgettable stay in the Alps."
    ],
    "it": [
      "Di fronte alla funivia dell'Aiguille du Midi, punto di partenza per l'alta quota e non lontano dai vari comprensori sciistici e dai sentieri escursionistici, l'Heliopic Hotel &amp; Spa promette un soggiorno indimenticabile nelle Alpi."
    ],
    "fr": [
      "Face au téléphérique de l'Aiguille du Midi, point de départ vers la haute altitude et non loin des différents domaines skiables et sentiers de randonnées, l'Heliopic Hotel & Spa promet un séjour inoubliable dans les Alpes."
    ],
    "nl": [
      "Het Heliopic Hotel & Spa ligt tegenover de kabelbaan Aiguille du Midi, het vertrekpunt voor de hoogte en niet ver van de verschillende skigebieden en wandelpaden, en belooft een onvergetelijk verblijf in de Alpen."
    ],
    "es": [
      "Frente al teleférico de la Aiguille du Midi, punto de partida hacia la alta montaña y no lejos de las diversas zonas de esquí y rutas de senderismo, el Heliopic Hotel &amp; Spa promete una estancia inolvidable en los Alpes."
    ]
  },
