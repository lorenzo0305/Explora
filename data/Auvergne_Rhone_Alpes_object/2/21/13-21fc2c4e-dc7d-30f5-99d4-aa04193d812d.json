  "rdfs:comment": {
    "de": [
      "Le 9\", das Restaurant des Golfplatzes, ist für alle (Golfer und Nicht-Golfer) geöffnet und empfängt Sie in einer freundlichen Atmosphäre mit einer \"hausgemachten\" Küche, bei der die Aromen im Vordergrund stehen."
    ],
    "en": [
      "New owner!\r\nSumptuous setting, simple cuisine: salads, omelettes, pasta, selection of meat cuts, homemade desserts."
    ],
    "it": [
      "Il \"9\", il ristorante del golf, è aperto a tutti (golfisti e non) e vi accoglie in un'atmosfera amichevole attorno a una cucina \"casalinga\" che privilegia i sapori."
    ],
    "fr": [
      "Le \"9\", le restaurant du golf est ouvert à tous (golfeurs et non golfeurs) et vous accueille dans une ambiance conviviale autour d'une cuisine \"faite Maison\" qui privilégie les saveurs."
    ],
    "nl": [
      "Nieuwe eigenaar!\r\nWeelderige omgeving, eenvoudige keuken: salades, omeletten, pasta, stukje vlees, huisgemaakte desserts."
    ],
    "es": [
      "El \"9\", el restaurante del golf, está abierto a todos (golfistas y no golfistas) y le acoge en un ambiente agradable en torno a una cocina \"casera\" que privilegia los sabores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant du golf :\" Le 9\""
    ]
  },
