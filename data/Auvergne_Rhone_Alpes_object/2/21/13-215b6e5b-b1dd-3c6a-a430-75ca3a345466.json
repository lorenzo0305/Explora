  "rdfs:comment": {
    "de": [
      "Seit 1884 bietet Ihnen das Restaurant des Hôtel des Voyageurs in der Nähe von Aurillac eine schmackhafte und moderne regionale Küche, die je nach Jahreszeit frische und lokale Produkte bevorzugt."
    ],
    "en": [
      "Since 1884, the restaurant of the Hôtel des Voyageurs has been serving tasty, modern local cuisine just a stone's throw from Aurillac, using fresh, local produce according to the seasons."
    ],
    "it": [
      "Dal 1884, il ristorante dell'Hôtel des Voyageurs serve una cucina locale gustosa e moderna a due passi da Aurillac, utilizzando prodotti freschi e locali a seconda delle stagioni."
    ],
    "fr": [
      "Depuis 1884, le restaurant de l'Hôtel des Voyageurs vous fait découvrir une cuisine de terroir savoureuse et moderne à deux pas d'Aurillac, privilégiant des produits frais et locaux au gré des saisons."
    ],
    "nl": [
      "Sinds 1884 serveert het restaurant van het Hôtel des Voyageurs op een steenworp afstand van Aurillac smakelijke en moderne streekgerechten met verse streekproducten naargelang de seizoenen."
    ],
    "es": [
      "Desde 1884, el restaurante del Hôtel des Voyageurs sirve una cocina local sabrosa y moderna a dos pasos de Aurillac, con productos frescos y locales según las estaciones."
    ]
  },
