      "@id": "https://data.datatourisme.fr/e8d1e864-e429-35c7-91ef-20a8ae5933fc",
      "dc:description": {
        "de": [
          "Entdecken Sie mit den Freiwilligen des Vereins \"Des Racines & des Hommes\" diese ehemalige Trocknungsanlage für Chicorée.\n\nAuf Reservierung"
        ],
        "en": [
          "Join volunteers from the \"Des Racines & des Hommes\" association to discover this former chicory drying plant.\n\nReservations required"
        ],
        "it": [
          "Unitevi ai volontari dell'associazione \"Des Racines & des Hommes\" per scoprire questo antico impianto di essiccazione della cicoria.\n\nSolo su prenotazione"
        ],
        "fr": [
          "Avec les bénévoles de l'association \"Des Racines & des Hommes\", venez découvrir cette ancienne sécherie à chicorée.\n\nSur réservation"
        ],
        "es": [
          "Únase a los voluntarios de la asociación \"Des Racines & des Hommes\" para descubrir este antiguo secadero de achicoria.\n\nSólo con reserva"
        ],
        "nl": [
          "Ontdek samen met vrijwilligers van de vereniging \"Des Racines & des Hommes\" deze voormalige cichoreidrogerij.\n\nAlleen op reservering"
        ]
      },
