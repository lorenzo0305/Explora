  "rdfs:comment": {
    "de": [
      "Ein multisensorischer Park inmitten der Natur, am Ufer des Flusses Drôme, der interaktive Spiele, Kunst, Natur und Geschichten miteinander verbindet. Erleben Sie hier mit der Familie oder mit Freunden etwas ganz Neues. Schattiger Bereich, Snackbar."
    ],
    "en": [
      "A multi-sensory park surrounded by nature, on the banks of the Drôme river, combining interactive games, art, nature, stories... Come and live a unique experience, with family or friends. Shaded area, snack bar."
    ],
    "it": [
      "Un parco multisensoriale nel cuore della natura, sulle rive del fiume Drôme, che unisce giochi interattivi, arte, natura e storie... Venite a vivere un'esperienza unica con la vostra famiglia o i vostri amici. Area ombreggiata, snack bar."
    ],
    "fr": [
      "Un parc multi sensoriel en pleine nature, en bord de rivière Drôme, alliant jeux interactifs, art, nature, histoires... Venez y vivre une expérience inédite, en famille ou entre amis. Espace ombragé, snack bar."
    ],
    "es": [
      "Un parque multisensorial en plena naturaleza, a orillas del río Drôme, que combina juegos interactivos, arte, naturaleza e historias... Venga a disfrutar de una experiencia única en familia o con amigos. Zona de sombra, snack bar."
    ],
    "nl": [
      "Een multisensorisch park in het hart van de natuur, aan de oever van de rivier de Drôme, met een combinatie van interactieve spelletjes, kunst, natuur en verhalen... Kom genieten van een unieke ervaring met het gezin of met vrienden. Schaduwrijke plek, snackbar."
    ]
  },
