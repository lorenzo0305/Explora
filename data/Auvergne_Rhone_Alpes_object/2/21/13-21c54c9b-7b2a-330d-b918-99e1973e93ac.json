  "rdfs:comment": {
    "de": [
      "Das Ziel von Le Bancal besteht darin, das lokale Leben zu fördern, soziale Bindungen auf lokaler Ebene aufrechtzuerhalten und Maßnahmen zugunsten kurzer Konsumwege zu fördern, einzurichten und zu entwickeln."
    ],
    "en": [
      "Le Bancal's objective is to promote local life, maintain social ties at the local level, and promote, set up and develop actions in favor of short consumption channels."
    ],
    "it": [
      "L'obiettivo di Le Bancal è promuovere la vita locale, mantenere un legame sociale con il territorio e incoraggiare, creare e sviluppare iniziative per promuovere le filiere corte."
    ],
    "fr": [
      "Le Bancal a pour objectif est de promouvoir la vie locale, de maintenir un lien social au niveau local, et de favoriser, mettre en place et développer des actions en faveur des filières courtes de consommation."
    ],
    "nl": [
      "Het doel van Le Bancal is om het lokale leven te bevorderen, een lokale sociale band te onderhouden en initiatieven aan te moedigen, op te zetten en te ontwikkelen om korte toeleveringsketens te bevorderen."
    ],
    "es": [
      "El objetivo de Le Bancal es promover la vida local, mantener un vínculo social local y fomentar, crear y desarrollar iniciativas para promover cadenas de suministro cortas."
    ]
  },
  "rdfs:label": {
