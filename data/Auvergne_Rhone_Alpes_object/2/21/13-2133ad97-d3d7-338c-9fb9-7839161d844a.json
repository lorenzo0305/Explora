  "rdfs:comment": {
    "de": [
      "JM'S ist 2 Atmosphären! Restaurant im Brasserie-Stil zum Mittagessen während der Woche mit Burgern, Salaten. . . Am Abend ist es ein Themenabend. DJ-Abend am Freitag, Live-Konzert am Samstag, freier Eintritt das ganze Jahr über. Verfolgen Sie unsere Neuigkeiten auf unserer Facebook-Seite!"
    ],
    "en": [
      "JM'S is 2 atmospheres! Brasserie-style restaurant for lunch during the week with burgers, salads. . . In the evening, it's a theme night. DJ evening on Fridays, live concert on Saturdays, free entrance all year round. Follow our news on our Facebook page !"
    ],
    "it": [
      "JM'S ha due atmosfere! A pranzo, durante la settimana, un ristorante in stile brasserie con hamburger, insalate... La sera è una serata a tema.\r\nSerata DJ il venerdì, concerto dal vivo il sabato, ingresso gratuito tutto l'anno.\r\nSeguite le nostre notizie sulla nostra pagina Facebook!"
    ],
    "fr": [
      "Le JM'S c'est 2 ambiances ! Restaurant type brasserie le midi en semaine avec burgers, salades... Le soir, c'est soirée à thème.\r\nSoirée DJ le venrdredi, concert live le samedi, entrée gratuite toute l'année.\r\nSuivez notre actu sur notre page Facebook !"
    ],
    "es": [
      "¡JM'S tiene 2 ambientes! Restaurante tipo brasserie al mediodía durante la semana con hamburguesas, ensaladas... Por la noche, es una noche temática.\r\nNoche de DJ el viernes, concierto en vivo el sábado, entrada gratuita todo el año.\r\nSiga nuestras noticias en nuestra página de Facebook"
    ],
    "nl": [
      "JM'S heeft 2 sferen! Een restaurant in brasseriestijl tijdens de lunch tijdens de week met hamburgers, salades... S Avonds is het een thema-avond.\r\nDJ-avond op vrijdag, live concert op zaterdag, het hele jaar door gratis toegang.\r\nVolg ons nieuws op onze Facebook pagina!"
    ]
  },
