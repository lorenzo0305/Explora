  "rdfs:comment": {
    "de": [
      "Ein schöner Spaziergang durch zahlreiche Viertel mit einem Dreirad, um die Spezialitäten von Valence zu entdecken. Valence Coeur gourmand.\r\nAbfahrt von Ihrem Hotel oder Ihrer Wohnung."
    ],
    "en": [
      "Take a scooter ride through many neighborhoods to discover Valence's specialties. Valence Coeur gourmand.\r\nDeparture from your hotel or home."
    ],
    "it": [
      "Un ottimo modo per scoprire le specialità di Valence con un giro in scooter attraverso molti quartieri della città. Valence Coeur gourmand.\r\nPartenza dal vostro hotel o da casa."
    ],
    "fr": [
      "Une belle balade dans de nombreux quartiers en triporteur pour découvrir les spécialités de Valence. Valence Coeur gourmand.\r\nDépart de votre hôtel ou de votre domicile."
    ],
    "es": [
      "Una buena manera de descubrir las especialidades de Valence en un paseo en scooter por muchos de los barrios de la ciudad. Valence Coeur gourmand.\r\nSalida desde su hotel o domicilio."
    ],
    "nl": [
      "Een geweldige manier om de specialiteiten van Valence te ontdekken tijdens een scootertocht door de vele wijken van de stad. Valence Coeur gourmand.\r\nVertrek vanaf je hotel of thuis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gastronomic Tour en triporteur Cyclo Team"
    ]
  },
