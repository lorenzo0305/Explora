  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b2683bbd-e55b-30ce-91c2-3ed993de08e6",
      "dc:description": {
        "de": [
          "Entdecken Sie Frühlings-, Sommer-, Linden- und Waldhonig sowie Pollen, die von einem diplomierten Imker aus der Region geerntet wurden.\nDer Verkauf erfolgt vor Ort und nur auf Vorbestellung."
        ],
        "en": [
          "Discover spring, summer, lime, forest and pollen honey harvested by a qualified local beekeeper.\nOn-site sales by prior arrangement only."
        ],
        "it": [
          "Scoprite il miele primaverile, estivo, di tiglio e di bosco e il polline raccolto da un apicoltore qualificato della regione.\nLa vendita avviene in loco e su prenotazione."
        ],
        "fr": [
          "Découvrez le miel de printemps, d'été, de tilleul, de forêt et le pollen récoltés par un apiculteur diplômé de la région. \nLa vente se fait sur place et uniquement sur réservation."
        ],
        "nl": [
          "Ontdek lente-, zomer-, linde- en boshoning en stuifmeel, geoogst door een gediplomeerde imker uit de regio.\nVerkoop ter plaatse en alleen op reservering."
        ],
        "es": [
          "Descubra la miel y el polen de primavera, verano, tilo y bosque recolectados por un apicultor cualificado de la región.\nLa venta es in situ y solo con reserva previa."
        ]
      },
