  "rdfs:comment": {
    "de": [
      "In einem einzigartigen Rahmen genießt die Pur Bar & Food einen Panoramablick und bietet eine Küche, in der man sich austauschen kann. Als Spezialist für Pizzen und Burger erweitert sich die Speisekarte um Käsespezialitäten, Salate, vegetarische Gerichte und Rindertartar."
    ],
    "en": [
      "In a unique setting, Pur Bar & Food boasts a panoramic view and offers sharing cuisine. Specializing in pizzas and burgers, the menu includes cheese specialties, salads, vegetarian dishes and beef tartars."
    ],
    "it": [
      "In un ambiente unico, il Pur Bar & Food gode di una vista panoramica e offre una cucina da condividere. Specializzato in pizze e hamburger, il menu comprende anche specialità a base di formaggio, insalate, piatti vegetariani e tartare di manzo."
    ],
    "fr": [
      "Dans un cadre unique, le Pur Bar & Food profite d'une vue panoramique et propose une cuisine de partage. Spécialiste des pizzas et burgers, la carte s'étoffe de spécialités fromagères, de salades, plats végétariens et tartares de boeuf."
    ],
    "nl": [
      "In een unieke omgeving biedt Pur Bar & Food een panoramisch uitzicht en een keuken om te delen. Het menu is gespecialiseerd in pizza's en hamburgers, maar bevat ook kaasspecialiteiten, salades, vegetarische gerechten en rundertartaar."
    ],
    "es": [
      "En un entorno único, el Pur Bar & Food disfruta de una vista panorámica y ofrece una cocina para compartir. Especializado en pizzas y hamburguesas, el menú también incluye especialidades de queso, ensaladas, platos vegetarianos y tartares de ternera."
    ]
  },
