  "rdfs:comment": {
    "de": [
      "Snack - Bar am Anfang der Pisten, oberhalb von Chevaly gelegen, zu Fuß, auf Skiern und mit dem Auto (kostenloser Parkplatz) erreichbar, mit atemberaubendem Blick auf den Mont-Blanc."
    ],
    "en": [
      "Snack bar at the start of the slopes, at the top of Chevaly, accessible on foot, on skis and by car (free parking), with breathtaking views of Mont Blanc."
    ],
    "it": [
      "Snack bar e bar alla partenza delle piste, situato in cima a Chevaly, accessibile a piedi, con gli sci e in auto (parcheggio gratuito), con vista mozzafiato sul Monte Bianco."
    ],
    "fr": [
      "Snack - bar au départ des pistes, situé en haut de Chevaly, accessible à pied, en ski et en véhicule (parking gratuit) avec vue imprenable sur le Mont-Blanc."
    ],
    "nl": [
      "Snackbar en bar aan het begin van de piste, gelegen op de top van Chevaly, bereikbaar te voet, op ski's en met de auto (gratis parkeren), met een adembenemend uitzicht op de Mont Blanc."
    ],
    "es": [
      "Snack bar y bar al inicio de las pistas, situado en la cima de Chevaly, accesible a pie, con esquís y en coche (aparcamiento gratuito), con impresionantes vistas del Mont Blanc."
    ]
  },
