  "rdfs:comment": {
    "de": [
      "Die Kulturabteilung beteiligt sich an der Festlegung und Umsetzung der\r\ndie Kulturpolitik der Stadt. Sie pflegt die Beziehungen zur lokalen Kultur- und Kunstszene sowie zu institutionellen Partnern."
    ],
    "en": [
      "The cultural department helps define and implement the town's\r\nthe town's cultural policy. It maintains relations with the local cultural and artistic milieu, and with institutional partners."
    ],
    "it": [
      "Il servizio culturale partecipa alla definizione e all'attuazione del programma di\r\nla politica culturale della Città. Intrattiene rapporti con l'ambiente culturale e artistico locale e con i partner istituzionali."
    ],
    "fr": [
      "Le service culturel participe à la définition et à la mise en oeuvre de\r\nla politique culturelle de la Ville. Il entretient les relations avec le milieu culturel et artistique local, et avec les partenaires institutionnels."
    ],
    "es": [
      "El servicio cultural participa en la definición y aplicación del\r\nla política cultural de la ciudad. Mantiene relaciones con el medio cultural y artístico local y con socios institucionales."
    ],
    "nl": [
      "De culturele afdeling helpt bij het bepalen en uitvoeren van het\r\nhet cultuurbeleid van de stad. Ze onderhoudt de relaties met de lokale culturele en artistieke gemeenschap en met institutionele partners."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Service Culturel Municipal"
    ]
  },
