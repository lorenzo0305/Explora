      "rdfs:comment": {
        "de": [
          "Katie, Damien und Thomas DESCHODT produzieren saftige Erdbeeren (vom 15. Mai bis zum 30. Juni und vom 15. August bis zum 30. September.), die sie vor Ort von Montag bis Samstag von 15:00 bis 19:00 Uhr verkaufen."
        ],
        "en": [
          "Katie, Damien and Thomas DESCHODT produce succulent strawberries (May 15 to June 30 and August 15 to September 30), which they sell on site Monday to Saturday, 3pm to 7pm."
        ],
        "it": [
          "Katie, Damien e Thomas DESCHODT coltivano fragole succulente (dal 15 maggio al 30 giugno e dal 15 agosto al 30 settembre), che vendono in loco dal lunedì al sabato dalle 15.00 alle 19.00."
        ],
        "fr": [
          "Katie, Damien et Thomas DESCHODT produisent des fraises succulentes (du 15 mai au 30 juin et du 15 août au 30 septembre.), qu'ils vendent sur place du lundi au samedi de 15h à 19h."
        ],
        "es": [
          "Katie, Damien y Thomas DESCHODT cultivan suculentas fresas (del 15 de mayo al 30 de junio y del 15 de agosto al 30 de septiembre), que venden in situ de lunes a sábado de 15.00 a 19.00 horas."
        ],
        "nl": [
          "Katie, Damien en Thomas DESCHODT telen sappige aardbeien (van 15 mei tot 30 juni en van 15 augustus tot 30 september), die ze ter plaatse verkopen van maandag tot zaterdag van 15 tot 19 uur."
        ]
      },
