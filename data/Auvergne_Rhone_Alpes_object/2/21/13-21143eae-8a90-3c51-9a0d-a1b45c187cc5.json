  "rdfs:comment": {
    "de": [
      "Der Canal de Savière schlängelt sich über fast 4 km von Portout nach Chanaz, wo eine in Savoyen einzigartige Schleuse die Schifffahrt auf der Haut-Rhône ermöglicht; ein romantischer Rahmen par excellence mit gedämpfter Atmosphäre."
    ],
    "en": [
      "The Canal de Savière winds its way along 2.5 miles from Portout to Chanaz, where the only lock in Savoie provides a gateway to the Rhône River. This romantic setting is popular with sailors and strollers who enjoy its quiet and luxuriant environment."
    ],
    "it": [
      "Il canale della Savière si snoda per quasi 4 km da Portout a Chanaz, dove una chiusa unica in Savoia permette la navigazione sull'Alto Rodano; un ambiente romantico per eccellenza con un'atmosfera silenziosa."
    ],
    "fr": [
      "Le canal de Savière serpente sur près de 4 km de portout à Chanaz où une écluse unique en Savoie permet la navigation sur le Haut-Rhône ; cadre romantique par excellence à l'ambiance feutrée."
    ],
    "nl": [
      "Het kanaal Savière slingert zich over bijna 4 km van Portout naar Chanaz, waar een voor de Savoie unieke sluis de scheepvaart op de Boven-Rhône mogelijk maakt; een romantische omgeving bij uitstek met een verstilde sfeer."
    ],
    "es": [
      "El canal de la Savière serpentea a lo largo de casi 4 km desde Portout hasta Chanaz, donde una esclusa única en la Saboya permite la navegación por el Alto Ródano; un entorno romántico por excelencia con una atmósfera silenciosa."
    ]
  },
