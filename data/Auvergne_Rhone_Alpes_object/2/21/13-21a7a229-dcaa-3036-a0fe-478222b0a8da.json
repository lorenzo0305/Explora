  "rdfs:comment": {
    "de": [
      "Die Isère im Herzen von Savoyen ist die Hauptverkehrsader des Departements\r\nBeim Angeln in diesem breiten, reißenden Fluss können Sie Forellen, Äschen und Döbel fangen."
    ],
    "en": [
      "Isère in the heart of Savoy is the main axis of the department\r\nFishing in this wide torrential river will allow you to catch trout, common grayling and chub."
    ],
    "it": [
      "L'Isère, nel cuore della Savoia, è il fiume principale del dipartimento.\r\nLa pesca in questo fiume ampio e torrentizio vi permetterà di catturare trote, temoli e cavedani."
    ],
    "fr": [
      "L’Isère en Cœur de Savoie est l'axe principal du département. \r\nLa pêche dans cette large rivière torrentueuse vous permettra de capturer truites, ombres communs et chevesnes."
    ],
    "es": [
      "El Isère, en el corazón de Saboya, es el principal río del departamento.\r\nLa pesca en este río ancho y torrentoso le permitirá capturar truchas, tímalos y cacho."
    ],
    "nl": [
      "De Isère in het hart van de Savoie is de belangrijkste rivier van het departement.\r\nBij het vissen in deze brede en stromende rivier kunt u forel, vlagzalm en kopvoorn vangen."
    ]
  },
