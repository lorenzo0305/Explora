  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/61970c77-1f81-387b-957a-a16769d99a43",
      "dc:description": {
        "de": [
          "Picknickplatz, der sich in der charmanten Gemeinde Lalandelle befindet. Verschiedene Ausstattungen: Picknicktisch, Spielplatz, Parkplatz, Spielplatz, Wasserstelle und Mülleimer.\n\nFür Wohnmobile zugänglich."
        ],
        "en": [
          "Picnic area located in the charming commune of Lalandelle. Various equipment: picnic table, playground, car park, playground, water point and dustbins.\n\nAccessible to the camper van."
        ],
        "it": [
          "Area picnic situata nell'incantevole villaggio di Lalandelle. Varie strutture: tavolo da picnic, parco giochi, parcheggio, parco giochi, punto d'acqua e cestini per i rifiuti.\n\nAccessibile ai camper."
        ],
        "fr": [
          "Aire de pique-nique se situant dans la charmante commune de Lalandelle. Divers équipement : table de pique-nique, aire de jeux, parking, aire de jeux, point d'eau et poubelles.\n\nAccessible au camping-car."
        ],
        "es": [
          "Área de picnic situada en el encantador pueblo de Lalandelle. Diversas instalaciones: mesa de picnic, parque infantil, aparcamiento, zona de juegos, punto de agua y papeleras.\n\nAccesible a las autocaravanas."
        ],
        "nl": [
          "Picknickplaats gelegen in het charmante dorpje Lalandelle. Diverse voorzieningen: picknicktafel, speeltuin, parkeerplaats, speeltuin, watertappunt en afvalbakken.\n\nToegankelijk voor campers."
        ]
      },
