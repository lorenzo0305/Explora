  "rdfs:comment": {
    "de": [
      "Ein kleiner Moment für sich selbst, teilen und loslassen - Heutzutage sehnen wir uns alle danach, uns Zeit für uns selbst zu nehmen. Wellness-Massage, energetische Massage und Magnetismus, nur nach Vereinbarung."
    ],
    "en": [
      "A little time to yourself, sharing and letting go - These days, we're all looking for a little time to ourselves. Wellness massage, energy massage and magnetism, by appointment only."
    ],
    "it": [
      "Un po' di tempo per se stessi, per condividere e lasciarsi andare - Al giorno d'oggi, tutti vogliamo prenderci del tempo per noi stessi. Massaggio benessere, massaggio energetico e magnetismo, solo su appuntamento."
    ],
    "fr": [
      "Un petit moment à soi, partage et lâcher prise - De nos jours, nous recherchons tous à prendre du temps pour soi. Massage bien-être, massage énergétique et magnétisme, uniquement sur rendez-vous."
    ],
    "es": [
      "Un poco de tiempo para uno mismo, compartir y dejarse llevar - En estos días, todos buscamos tomarnos un tiempo para nosotros mismos. Masaje de bienestar, masaje energético y magnetismo, con cita previa."
    ],
    "nl": [
      "Een beetje tijd voor jezelf, delen en loslaten - Tegenwoordig willen we allemaal wat tijd voor onszelf. Wellnessmassage, energiemassage en magnetisme, alleen op afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bellina massage"
    ]
  },
