  "rdfs:comment": {
    "de": [
      "Les LoKaux ist ein Bar-Restaurant mit einem einfachen Konzept: Unsere \"lokal''-Produkte in den Vordergrund zu stellen und von Montagmittag bis Samstagmittag zu verzehren. Dank unserer Partnerschaft mit Auvergne BoKalm können wir Ihnen auch abends warme Gerichte anbieten."
    ],
    "en": [
      "Les LoKaux is a restaurant bar with a simple concept: to showcase our \"lokaux\" products in catering from Monday noon to Saturday noon. Thanks to our partnership with Auvergne BoKalm, we can also offer you hot meals in the evening."
    ],
    "it": [
      "Les LoKaux è un bar-ristorante con un concetto semplice: valorizzare i nostri prodotti \"lokaux\" nel ristorante dal lunedì a pranzo al sabato a pranzo. Grazie alla collaborazione con Auvergne BoKalm, possiamo offrirvi anche piatti caldi la sera."
    ],
    "fr": [
      "Les LoKaux est un bar restaurant avec un concept simple : mettre à l'honneur nos produits \"lokaux'\" en restauration du lundi midi au samedi midi. Grâce à notre partenariat avec Auvergne BoKalm nous pouvons vous proposer également des plats chaud le soir."
    ],
    "nl": [
      "Les LoKaux is een bar-restaurant met een eenvoudig concept: van maandagmiddag tot zaterdagmiddag in het restaurant onze \"lokaux\"-producten onder de aandacht brengen. Dankzij onze samenwerking met Auvergne BoKalm kunnen wij u ook 's avonds warme gerechten aanbieden."
    ],
    "es": [
      "Les LoKaux es un bar-restaurante con un concepto sencillo: poner de relieve nuestros productos \"lokaux\" en el restaurante de lunes a mediodía a sábado a mediodía. Gracias a nuestra colaboración con Auvergne BoKalm, también podemos ofrecerle platos calientes por la noche."
    ]
  },
  "rdfs:label": {
