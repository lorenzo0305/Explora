  "rdfs:comment": {
    "de": [
      "Sophie Dode lässt den Geist der Berge und der Landschaft in ihr Werk einfließen. Die Gemälde umarmen die Gipfel, fließen die Bäche hinab, steigen die verschneiten Täler hinauf und wärmen sich an der Sanftheit der Chalets."
    ],
    "en": [
      "Sophie Dode infuses the spirit of the mountains and the landscape into her work.\r\nHer canvases embrace the peaks, follow the torrents, sometimes descend all the way to the sea, climb back up snowy valleys, and warm themselves in the gentle glow of mountain chalets."
    ],
    "it": [
      "Sophie Dode infonde lo spirito della montagna e del paesaggio nelle sue opere.\r\nLe sue tele abbracciano le vette, seguono i torrenti, scendono talvolta fino al mare, risalgono le valli innevate e si scaldano nella dolcezza degli chalet."
    ],
    "fr": [
      "Sophie Dode infuse l'esprit de la montagne et du paysage dans son oeuvre. Les toiles embrassent les sommets, descendent les torrents, remontent les vallées enneigées et se réchauffent à la douceur des chalets."
    ],
    "es": [
      "Sophie Dode impregna su obra del espíritu de las montañas y el paisaje. Los lienzos abrazan las cumbres, fluyen por los torrentes, serpentean por los valles nevados y se calientan en la acogedora intimidad de los chalés."
    ],
    "nl": [
      "Sophie Dode brengt de geest van de bergen en het landschap in haar werk. De doeken omarmen de bergtoppen, stromen langs de bergstromen, kronkelen door de besneeuwde valleien en warmen op in de gezelligheid van de chalets."
    ]
  },
  "rdfs:label": {
