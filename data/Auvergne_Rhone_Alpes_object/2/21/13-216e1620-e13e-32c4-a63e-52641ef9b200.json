  "rdfs:comment": {
    "de": [
      "Freilandhühner vom Bauernhof, die in BIO aufgezogen wurden. Verkauf im Erzeugerladen Au Petit Bonheur des Champs - 70 route neuve in Brindas\r\nVor Ort bietet der Verein Plumes et Graines Besichtigungen und pädagogische Workshops nach Voranmeldung an."
    ],
    "en": [
      "Free-range organic chickens. Sale at the producer's shop Au Petit Bonheur des Champs - 70 route neuve in Brindas\r\nOn the spot the association Plumes et Graines proposes visits and educational workshops on reservation."
    ],
    "it": [
      "Polli biologici ruspanti. Vendita presso il negozio del produttore Au Petit Bonheur des Champs - 70 route neuve a Brindas\r\nSul posto, l'associazione Plumes et Graines propone visite e laboratori didattici su prenotazione."
    ],
    "fr": [
      "Poulets fermiers élevés en plein air en BIO. Vente au magasin de producteurs Au Petit Bonheur des Champs - 70 route neuve à Brindas. \r\nSur place l’association Plumes et Graines propose visites et ateliers pédagogiques sur réservation."
    ],
    "es": [
      "Pollos ecológicos criados en libertad. Venta en la tienda del productor Au Petit Bonheur des Champs - 70 route neuve en Brindas\r\nEn el lugar, la asociación Plumes et Graines ofrece visitas y talleres educativos sobre la reserva."
    ],
    "nl": [
      "Biologische kippen met vrije uitloop. Verkoop in de winkel van de producent Au Petit Bonheur des Champs - 70 route neuve in Brindas\r\nTer plaatse biedt de vereniging Plumes et Graines op reservering bezoeken en educatieve workshops aan."
    ]
  },
