  "rdfs:comment": {
    "de": [
      "Neuer Ort, neue Atmosphäre. Wir freuen uns, Sie in unserem Brew Pub begrüßen zu dürfen. Handwerkliche BIO-Brauerei, musikalische Unterhaltung, hausgemachte Küche mit lokalen Produkten, Burger und originelle kleine Gerichte, die rund um das Thema Bier kreiert werden."
    ],
    "en": [
      "New place, new atmosphere. We are delighted to welcome you into our Brew Pub. Organic craft brewery, concerts, homemade food with local produce, burgers and original dishes created around our beers."
    ],
    "it": [
      "Nuovo posto, nuova atmosfera. Siamo lieti di darvi il benvenuto nel nostro Brew Pub. Birrificio artigianale biologico, intrattenimento musicale, cibo fatto in casa con prodotti locali, hamburger e piccoli piatti originali creati intorno al tema della birra."
    ],
    "fr": [
      "Nouveau lieu, nouvelle ambiance. Nous sommes ravis de vous accueillir dans notre Brew Pub. Brasserie artisanale BIO, animations musicales, cuisine fait maison avec des produits locaux, burgers et petits plats originaux créés autour du thème de la bière."
    ],
    "es": [
      "Nuevo lugar, nuevo ambiente. Estamos encantados de darle la bienvenida a nuestro Brew Pub. Cervecería artesanal ecológica, animación musical, comida casera con productos locales, hamburguesas y pequeños platos originales creados en torno al tema de la cerveza."
    ],
    "nl": [
      "Nieuwe plek, nieuwe sfeer. Wij heten u van harte welkom in onze Brew Pub. Biologische ambachtelijke brouwerij, muzikaal entertainment, huisgemaakt eten met lokale producten, hamburgers en kleine originele gerechten gemaakt rond het thema bier."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brewpub La Rochoise"
    ],
    "fr": [
      "Brewpub La Rochoise"
    ]
  },
