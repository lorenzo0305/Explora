  "rdfs:comment": {
    "de": [
      "Backen zu Hause: Kurse & Schulungen. Teilen Sie einen leckeren Moment mit der Familie oder perfektionieren Sie Ihre Technik! Individuelle Kurse für Erwachsene und Kinder in Villefranche-sur-Saône und Umgebung. Lernen, kreieren und probieren Sie zu Hause."
    ],
    "en": [
      "Home baking: Classes & Training. Share a gourmet moment with your family or perfect your technique! Personalised classes for adults and children in Villefranche-sur-Saône and the surrounding area. Learn, create and enjoy at home."
    ],
    "it": [
      "Pasticceria a domicilio: corsi e formazione. Condividete un momento delizioso con la famiglia o perfezionate la vostra tecnica! Corsi personalizzati per adulti e bambini a Villefranche-sur-Saône e dintorni. Imparate, create e gustate a casa vostra."
    ],
    "fr": [
      "Pâtisserie à domicile : Cours & Formations. Partagez un moment gourmand en famille ou perfectionnez votre technique ! Cours personnalisés pour adultes et enfants à Villefranche-sur-Saône et environs. Apprenez, créez et dégustez chez vous."
    ],
    "nl": [
      "Patisserie thuis: Cursussen & opleidingen. Deel een heerlijk moment met het gezin of perfectioneer je techniek! Cursussen op maat voor volwassenen en kinderen in Villefranche-sur-Saône en omgeving. Leer, creëer en geniet thuis."
    ],
    "es": [
      "Pastelería en casa: Cursos y formación. Comparta un delicioso momento en familia o perfeccione su técnica Cursos personalizados para adultos y niños en Villefranche-sur-Saône y alrededores. Aprenda, cree y disfrute en casa."
    ]
  },
