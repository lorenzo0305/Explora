  "rdfs:comment": {
    "de": [
      "Schnecken lebend, tiefgefroren und in Konserven. Direktverkauf vorzugsweise nach Vereinbarung. Verkaufspermanenzen in der zweiten Dezemberhälfte. Mitglied des lokalen Netzwerks von Viennois bis Chambaran."
    ],
    "en": [
      "Live, frozen and canned snails. Direct sales preferably by appointment. Sales open during the 2nd half of December. Member of local network from Viennois to Chambaran."
    ],
    "it": [
      "Lumache vive, congelate e in scatola. Vendita diretta, preferibilmente su appuntamento. Apertura delle vendite nella seconda metà di dicembre. Membro della rete locale da Viennois a Chambaran."
    ],
    "fr": [
      "Escargots vifs, surgelés et en conserves. Vente directe de préférence sur rendez-vous. Permanences de ventes la 2ème quinzaine de décembre. Membre du réseau local du Viennois au Chambaran."
    ],
    "nl": [
      "Levende, diepgevroren en ingeblikte slakken. Directe verkoop bij voorkeur op afspraak. Verkoop geopend in de 2e helft van december. Lid van het lokale netwerk van Viennois tot Chambaran."
    ],
    "es": [
      "Caracoles vivos, congelados y en conserva. Venta directa preferentemente con cita previa. Ventas abiertas durante la 2ª quincena de diciembre. Miembro de la red local de Viennois a Chambaran."
    ]
  },
