  "rdfs:comment": {
    "de": [
      "Im Zentrum des Dorfes Abondance gelegen, empfangen Sie Liliane und Jean-Luc Léonardi in dieser typischen und gemütlichen Residenz, die geschmackvoll renoviert wurde.\r\nFamilienbetrieb in der 3. Generation, gemütliche Umgebung, Restaurant, Parkplatz, Terrasse, schattiger Garten."
    ],
    "en": [
      "Les Touristes is an hotel situated in the center of an old Savoyard estate, perched at an altitude of 1000 meters. There we have cultivated the art of good receiving since three generations. Liliane and Jean-Luc Léonardi will share with you their passion for hospitality and gastronomy in this typical and warm residence, tastefully renovated situated in the town center."
    ],
    "it": [
      "Nel centro del villaggio di Abondance, Liliane e Jean-Luc Léonardi vi danno il benvenuto in questa residenza tipica, calda e ristrutturata con gusto.\r\nCasa di famiglia di terza generazione, ambiente accogliente, ristorante, parcheggio, terrazza, giardino ombreggiato."
    ],
    "fr": [
      "Situé au centre du village d'Abondance, Liliane et Jean-Luc Léonardi vous accueillent dans cette résidence typique et chaleureuse, rénovée avec goût.\r\nAccueil familial de 3éme génération, cadre chaleureux, restaurant, parking, terrasse, jardin ombragé."
    ],
    "es": [
      "Situada en el centro del pueblo de Abondance, Liliane y Jean-Luc Léonardi le dan la bienvenida a esta residencia típica, cálida y renovada con gusto.\r\nCasa familiar de 3ª generación, ambiente cálido, restaurante, aparcamiento, terraza, jardín sombreado."
    ],
    "nl": [
      "Liliane en Jean-Luc Léonardi verwelkomen je in het centrum van het dorp Abondance in deze typische, warme en smaakvol gerenoveerde woning.\r\nEen familiehuis van de 3e generatie, warm kader, restaurant, parking, terras, schaduwrijke tuin."
    ]
  },
