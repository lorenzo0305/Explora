  "rdfs:comment": {
    "de": [
      "Restaurant am Ufer der Saône mit atemberaubender Aussicht, nur \"hausgemacht\" mit unseren Spezialitäten Grenouilles und Fritures de Saône."
    ],
    "en": [
      "Restaurant located on the banks of the Saône with a breathtaking view, home-made specialities such as frogs and fried fish from the Saône."
    ],
    "it": [
      "Ristorante situato sulle rive della Saona con una vista mozzafiato, specialità fatte in casa come rane e pesce fritto della Saona."
    ],
    "fr": [
      "Restaurant situé en bord de Saône vue imprenable,  que du fait \"maison\" avec nos spécialités grenouilles et fritures de Saône."
    ],
    "es": [
      "Restaurante situado a orillas del Saona con unas vistas impresionantes, especialidades caseras como las ranas y el pescado frito del Saona."
    ],
    "nl": [
      "Restaurant gelegen aan de oevers van de Saône met een adembenemend uitzicht, huisgemaakte specialiteiten zoals kikkers en gebakken vis uit de Saône."
