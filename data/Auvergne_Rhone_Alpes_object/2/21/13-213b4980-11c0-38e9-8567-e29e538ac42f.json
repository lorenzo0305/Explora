  "rdfs:comment": {
    "de": [
      "Die Brasserie Central Café bietet eine Feinschmeckerküche in einer ruhigen und angenehmen Umgebung im Stadtzentrum in unmittelbarer Nähe des Parkhauses Michelet."
    ],
    "en": [
      "The Central Café brasserie offers gourmet cuisine in a quiet, pleasant setting right in the center of town, close to the Michelet parking lot."
    ],
    "it": [
      "La brasserie Central Café offre una cucina gourmet in un ambiente tranquillo e piacevole nel centro della città, proprio accanto al parcheggio Michelet."
    ],
    "fr": [
      "La brasserie Central Café propose une cuisine gourmande dans un cadre calme et agréable en plein centre ville à proximité immédiate du parking Michelet."
    ],
    "es": [
      "La brasserie Central Café ofrece cocina gourmet en un entorno tranquilo y agradable en el centro de la ciudad, justo al lado del aparcamiento Michelet."
