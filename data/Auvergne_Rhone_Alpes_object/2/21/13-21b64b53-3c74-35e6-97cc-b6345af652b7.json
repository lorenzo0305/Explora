  "rdfs:comment": {
    "de": [
      "Ein Bélvédère, der oberhalb der Staumauer eingerichtet wurde und für Personen mit eingeschränkter Mobilität zugänglich ist, ermöglicht es, die Anlage, ihre Funktionsweise und das Gebiet zu entdecken. Der Staudamm kann aufgrund des Plans Vigie-Pirate nicht besichtigt werden."
    ],
    "en": [
      "A belvedere above the dam, accessible to people with reduced mobility, allows visitors to discover the site, its operation and the surrounding area. The dam cannot be visited due to the Vigie-Pirate plan."
    ],
    "it": [
      "Una piattaforma panoramica sopra la diga, accessibile alle persone a mobilità ridotta, permette ai visitatori di scoprire il sito, il suo funzionamento e la zona. La diga non può essere visitata a causa del piano Vigie-Pirate."
    ],
    "fr": [
      "Un bélvédère aménagé au dessus du barrage, et accessible aux personnes à mobilité réduite, permet de découvrir le site, son fonctionnement, et le territoire. Le barrage n'est pas visitable en raison du plan Vigie-Pirate."
    ],
    "es": [
      "Un mirador sobre la presa, accesible para personas con movilidad reducida, permite a los visitantes descubrir el lugar, su funcionamiento y la zona. La presa no se puede visitar debido al plan Vigie-Pirate."
    ],
    "nl": [
      "Een belvedère boven de dam, toegankelijk voor personen met beperkte mobiliteit, stelt de bezoekers in staat de site, de werking ervan en de omgeving te ontdekken. De dam kan niet bezocht worden vanwege het Vigie-Pirate plan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Barrage du Monteynard"
    ]
  },
