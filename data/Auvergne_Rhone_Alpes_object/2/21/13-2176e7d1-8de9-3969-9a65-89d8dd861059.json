    "de": [
      "Feu! Chatterton und Terrenoir werden am Sonntag, den 24. Mai 2026 ab 18 Uhr im Rahmen des Festivals Paroles & Musques auf der Bühne des Zénith in Saint-Etienne stehen!"
    ],
    "en": [
      "Feu! Chatterton and Terrenoir will be on stage at the Zénith in Saint-Etienne on Sunday, May 24, 2026 from 6pm, as part of the Festival Paroles & Musques!"
    ],
    "it": [
      "Feu Chatterton e Terrenoir saranno in scena allo Zénith di Saint-Etienne domenica 24 maggio 2026 dalle ore 18.00, nell'ambito del Festival Paroles & Musques!"
    ],
    "fr": [
      "Feu! Chatterton et Terrenoir seront sur la scène du Zénith de Saint-Etienne le dimanche 24 mai 2026 à partir de 18h, dans le cadre du Festival Paroles & Musques !"
