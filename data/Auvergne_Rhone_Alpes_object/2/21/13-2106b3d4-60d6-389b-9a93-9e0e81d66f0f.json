  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen geselligen Moment bei einem Familienessen! Jeder ist willkommen, auch Kinder, die nach dem Essen ab 13 Uhr an einem Schreibworkshop (ab 8 Jahren) teilnehmen können!"
    ],
    "en": [
      "Come and enjoy a convivial family meal! Everyone is welcome, including children, who can take part in a writing workshop (from age 8) after the meal from 1pm!"
    ],
    "it": [
      "Venite a gustare un pasto conviviale in famiglia! Tutti sono i benvenuti, compresi i bambini, che potranno partecipare a un laboratorio di scrittura (a partire dagli 8 anni) dopo il pasto, a partire dalle 13.00!"
    ],
    "fr": [
      "Venez passer un moment de convivialité autour d'un repas familial ! Tout le monde est bienvenu y compris les enfants qui pourront participer à un atelier d'écriture (dès 8 ans) après le repas dès 13h !"
    ],
    "es": [
      "Venga a disfrutar de una comida en familia Todo el mundo es bienvenido, incluidos los niños, que podrán participar en un taller de escritura (a partir de 8 años) después de la comida, a partir de las 13.00 horas"
    ],
    "nl": [
      "Kom genieten van een gezellige gezinsmaaltijd! Iedereen is welkom, ook kinderen, die na de maaltijd vanaf 13.00 uur kunnen deelnemen aan een schrijfworkshop (vanaf 8 jaar)!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les cantines de l'Elabo de Paulette"
    ]
  },
