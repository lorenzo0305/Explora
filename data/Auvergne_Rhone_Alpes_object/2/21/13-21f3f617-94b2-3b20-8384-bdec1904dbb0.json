  "rdfs:comment": {
    "de": [
      "Am Ufer der Saône in ruhiger Lage gelegen. Köstliche Küche, die je nach Jahreszeit sorgfältig zubereitet wird. Sommerformeln Bords de Saône (Frische Frösche und Frittierfett, Huhn vom Bauernhof)"
    ],
    "en": [
      "Quiet location on the banks of the Saône. Delicious cuisine carefully prepared according to the seasons. Bords de Saône summer menus (fresh frogs and fried fish, free-range chicken)"
    ],
    "it": [
      "Posizione tranquilla sulle rive della Saona. Cucina deliziosa preparata con cura in base alle stagioni. Menù estivi Bords de Saône (rane fresche e patatine, pollo ruspante)"
    ],
    "fr": [
      "Situé en bord de Saône au calme. Cuisine délicieuse soigneusement préparée au gré des saisons. Formules d'été Bords de Saône (Grenouilles et friture fraîches, poulet fermier.)"
    ],
    "es": [
      "Situación tranquila a orillas del Saona. Deliciosa cocina elaborada con esmero según las estaciones. Menús de verano Bords de Saône (ranas frescas y patatas fritas, pollo de corral)"
    ],
    "nl": [
      "Rustig gelegen aan de oevers van de Saône. Heerlijke keuken met zorg bereid volgens de seizoenen. Bords de Saône zomermenu's (verse kikkers en frieten, scharrelkip)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La Brasserie des 2 ponts"
    ]
  },
