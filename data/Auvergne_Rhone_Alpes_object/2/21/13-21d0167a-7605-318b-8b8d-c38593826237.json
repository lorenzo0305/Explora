  "rdfs:comment": {
    "de": [
      "Unser belgisches Know-how kommt nach Valence! Entdecken Sie die Authentizität unserer Biere vom Fass und die Köstlichkeit unserer Lütticher Bouletten: ein echter Ausflug nach Belgien, für die Dauer einer Mahlzeit."
    ],
    "en": [
      "Our Belgian know-how comes to Valence! Discover the authenticity of our draught beers and the delicacy of our boulets liégeois: a true escapade in Belgium, for the time of a meal."
    ],
    "it": [
      "La nostra esperienza belga arriva a Valence! Scoprite l'autenticità delle nostre birre alla spina e l'indulgenza dei nostri boulets liégeois: una vera e propria fuga in Belgio, solo per il tempo del vostro pasto."
    ],
    "fr": [
      "Notre savoir-faire belge s’installe à Valence ! Découvrez l’authenticité de nos bières pression et la gourmandise de nos boulets liégeois : une véritable escapade en Belgique, le temps d’un repas."
    ],
    "es": [
      "¡Nuestro saber hacer belga llega a Valence! Descubra la autenticidad de nuestras cervezas de barril y la indulgencia de nuestros boulets liégeois: una auténtica escapada a Bélgica, sólo para el momento de su comida."
    ],
    "nl": [
      "Onze Belgische expertise komt naar Valence! Ontdek de authenticiteit van onze bieren van het vat en de verwennerij van onze boulets liégeois: een echte ontsnapping naar België, alleen voor de tijd van uw maaltijd."
    ]
  },
  "rdfs:label": {
