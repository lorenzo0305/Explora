  "rdfs:comment": {
    "de": [
      "Die Maisons du Bonheur empfangen Sie in einer freundlichen Atmosphäre im Herzen des Beaujolais, damit Sie in Frieden und Gelassenheit arbeiten können."
    ],
    "en": [
      "Les Maisons du Bonheur welcome you in a friendly atmosphere in the heart of the Beaujolais to work in peace and serenity."
    ],
    "it": [
      "Les Maisons du Bonheur vi accoglie in un'atmosfera amichevole nel cuore del Beaujolais per lavorare in pace e serenità."
    ],
    "fr": [
      "Les Maisons du Bonheur vous accueillent dans une ambiance conviviale au coeur du Beaujolais pour travailler dans la paix et la sérénité."
    ],
    "nl": [
      "Les Maisons du Bonheur ontvangt u in een vriendelijke sfeer in het hart van de Beaujolais om in alle rust en sereniteit te werken."
    ],
    "es": [
      "Les Maisons du Bonheur le acoge en un ambiente acogedor en el corazón del Beaujolais para trabajar en paz y serenidad."
    ]
