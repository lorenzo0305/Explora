  "rdfs:comment": {
    "de": [
      "Kommen Sie nach Le Bois Joli, genießen Sie die raffinierte und lokale Küche, die im Restaurant La Table d'Oche angeboten wird, genießen Sie den Panoramablick, entspannen Sie sich im Wellnessbereich... Ob zu zweit, mit der Familie oder mit Freunden, Le Bois Joli ist zu jeder Jahreszeit ideal."
    ],
    "en": [
      "Come and stay at Le Bois Joli, savour the refined, local cuisine served in the Table d'Oche restaurant, enjoy the panoramic view, relax in the wellness area... Whether you're a couple, a family or a group of friends, Le Bois Joli is ideal for all seasons."
    ],
    "it": [
      "Venite a soggiornare a Le Bois Joli, assaporate la raffinata cucina locale offerta dal ristorante Table d'Oche, godetevi la vista panoramica, rilassatevi nell'area benessere?  Che siate una coppia, una famiglia o un gruppo di amici, Le Bois Joli è ideale tutto l'anno"
    ],
    "fr": [
      "Venez séjourner au Bois Joli, savourez la cuisine raffinée et locale proposée au restaurant la Table d’Oche, profitez de la vue panoramique, détendez-vous à l’espace bien-être…  En couple, en famille ou entre amis, Le Bois Joli est idéal en toute saison"
    ],
    "es": [
      "Venga a alojarse en Le Bois Joli, saboree la refinada cocina local que le ofrece el restaurante Table d'Oche, disfrute de las vistas panorámicas, relájese en el espacio de bienestar?  En pareja, en familia o con amigos, Le Bois Joli es ideal durante todo el año"
    ],
    "nl": [
      "Kom logeren in Le Bois Joli, geniet van de verfijnde lokale keuken in het restaurant Table d'Oche, geniet van het panoramische uitzicht, ontspan in de wellnessruimte... Of je nu met z'n tweeën, met het gezin of met vrienden bent, Le Bois Joli is ideaal voor alle seizoenen."
    ]
  },
