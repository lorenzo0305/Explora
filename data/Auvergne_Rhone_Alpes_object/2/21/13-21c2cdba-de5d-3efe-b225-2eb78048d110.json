  "rdfs:comment": {
    "de": [
      "Besichtigung der Außenanlagen.\r\nUrsprünglich eine mittelalterliche Festungsanlage, die von Wassergräben umgeben war, wurde das Schloss Anfang des 17. Jahrhunderts im Stil der Bourbonen mit vielfarbigen Ziegelsteinen und Steinen wiederaufgebaut."
    ],
    "en": [
      "Visit the exterior.\r\nOriginally a medieval fortified complex surrounded by a moat, the château was rebuilt in the early 17th century in the Bourbonnais style, using polychrome brick and stone."
    ],
    "it": [
      "Visita degli esterni.\r\nOriginariamente un complesso fortificato medievale circondato da un fossato, il castello fu ricostruito all'inizio del XVII secolo in stile Bourbonnais, utilizzando mattoni policromi e pietra."
    ],
    "fr": [
      "Visite des extérieurs. \r\nInitialement un ensemble fortifié médiéval entouré par des douves en eau, le château fut reconstruit au début du XVIIe siècle, à la manière bourbonnaise, en briques polychromes et pierres."
    ],
    "es": [
      "Visita el exterior.\r\nOriginalmente un complejo medieval fortificado rodeado por un foso, el castillo fue reconstruido a principios del siglo XVII en estilo Bourbonnais, utilizando ladrillo policromado y piedra."
    ],
    "nl": [
      "Bezoek de buitenkant.\r\nHet kasteel was oorspronkelijk een versterkt middeleeuws complex omringd door een gracht, maar werd aan het begin van de 17e eeuw herbouwd in de Bourbonnais-stijl, met polychrome bakstenen en stenen."
    ]
  },
