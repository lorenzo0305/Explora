  "rdfs:comment": {
    "de": [
      "Die präventive Archäologie enthüllt die Schichten der Stadtorganisation. Diese archäologischen Ausgrabungen zeichnen ein Bild von Valencia zur Zeit der Römer."
    ],
    "en": [
      "Preventive archaeology operations reveal the layers of the city?s organization. These archaeological digs paint a portrait of Valence in Roman times."
    ],
    "it": [
      "Le operazioni di archeologia preventiva stanno rivelando gli strati dell'organizzazione della città. Questi scavi archeologici dipingono un ritratto di Valencia in epoca romana."
    ],
    "fr": [
      "Les opérations d’archéologie préventive révèlent les strates de l’organisation de la ville. Ces fouilles archéologiques dressent un portrait de Valence à l'époque Romaine."
    ],
    "nl": [
      "Preventieve archeologische opgravingen onthullen de lagen in de organisatie van de stad. Deze archeologische opgravingen schetsen een beeld van Valencia in de Romeinse tijd."
    ],
    "es": [
      "Las operaciones de arqueología preventiva están desvelando las capas de la organización de la ciudad. Estas excavaciones arqueológicas dibujan un retrato de la Valencia de la época romana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Valence au temps des romains - Journées européennes de l'archéologie"
    ]
  },
