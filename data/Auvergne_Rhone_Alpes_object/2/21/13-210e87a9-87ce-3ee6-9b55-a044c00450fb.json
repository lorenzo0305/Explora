  "rdfs:comment": {
    "de": [
      "Erkunden Sie die Mountainbike-Strecken oder die Via Ardèche mit unseren Leih-Elektrofahrrädern! Kommen Sie während eines Ausflugs, nach Ihrer Rückkehr oder am Abend, um sich zu stärken (Bretter, Crêpes, Eis...) und die vor Ort gebrauten Biere zu probieren."
    ],
    "en": [
      "Take on the mountain bike trails or the Via Ardèche with our electric bikes for hire! Come along on a ride, on your return or in the evening for a bite to eat (boards, crêpes, ice creams...) and taste the beers brewed on site."
    ],
    "it": [
      "Affrontate i percorsi di mountain bike o la Via Ardèche con le nostre biciclette elettriche a noleggio! Venite a fare un giro, al ritorno o la sera per mangiare qualcosa (taglieri, crêpes, gelati, ecc.) e assaggiare le birre prodotte in loco."
    ],
    "fr": [
      "Partez à l'assaut des chemins VTT ou la Via Ardèche grâce à nos vélos électriques en location! Venez au cours d'une balade, à votre retour ou en soirée pour vous restaurer (planches, crêpes, glaces...) et déguster les bières brassées sur place."
    ],
    "es": [
      "Recorra los senderos de BTT o la Via Ardèche con nuestras bicicletas eléctricas de alquiler Acompáñenos durante el recorrido, a la vuelta o por la noche para comer algo (tablas, crêpes, helados, etc.) y degustar las cervezas fabricadas in situ."
    ],
    "nl": [
      "Neem de mountainbikeroutes of de Via Ardèche met onze elektrische huurfietsen! Kom langs voor de rit, op de terugweg of 's avonds voor een hapje eten (planken, crêpes, ijsjes, enz.) en proef de bieren die ter plaatse worden gebrouwen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hop on Bar"
    ]
  },
