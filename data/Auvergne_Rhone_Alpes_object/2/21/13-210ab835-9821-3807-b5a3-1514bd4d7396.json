  "rdfs:comment": {
    "de": [
      "Konzert der international bekannten Cellistin Myroslava Tsybka.\r\nVortrag von Gilles Antonowicz über die Ukraine in Vergangenheit und Gegenwart.\r\nAperitif und anschließend ukrainisches Abendessen.\r\nDie Plätze sind begrenzt, denken Sie an eine Reservierung."
    ],
    "en": [
      "Concert by internationally renowned cellist Myroslava Tsybka.\r\nLecture by Gilles Antonowicz on Ukraine past and present.\r\nAperitif followed by Ukrainian dinner.\r\nPlaces are limited, so book early."
    ],
    "it": [
      "Concerto della violoncellista di fama internazionale Myroslava Tsybka.\r\nConferenza di Gilles Antonowicz sull'Ucraina del passato e del presente.\r\nAperitivo seguito da cena ucraina.\r\nI posti sono limitati, quindi prenotate per tempo."
    ],
    "fr": [
      "Concert de la violoncelliste de renommée internationale Myroslava Tsybka.\r\nConférence de Gilles Antonowicz sur l'Ukraine d'hier et aujourd'hui.\r\nApéritif puis diner ukrainien.\r\nLes places sont limitées, pensez à réserver."
    ],
    "es": [
      "Concierto de la violonchelista de fama internacional Myroslava Tsybka.\r\nConferencia de Gilles Antonowicz sobre el pasado y el presente de Ucrania.\r\nAperitivo seguido de una cena ucraniana.\r\nLas plazas son limitadas, así que reserve con antelación."
    ],
    "nl": [
      "Concert door de internationaal bekende celliste Myroslava Tsybka.\r\nLezing door Gilles Antonowicz over Oekraïne vroeger en nu.\r\nAperitief gevolgd door Oekraïens diner.\r\nPlaatsen zijn beperkt, dus reserveer vroeg."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dîner concert solidaire de violon  - Au chœur de l'Ukraine"
    ]
  },
