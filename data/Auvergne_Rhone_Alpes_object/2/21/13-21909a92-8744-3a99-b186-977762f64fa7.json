  "rdfs:comment": {
    "de": [
      "Das 101 EXPRESS bietet Ihnen eine abwechslungsreiche Speisekarte mit à la minute zubereiteten Gerichten, die Sie in einem modernen und raffinierten Rahmen genießen können."
    ],
    "en": [
      "Located in VAULX-MILIEU on the D 1006, 101 EXPRESS welcomes you from Monday to Friday from 11:30 am to 2:00 pm, for your lunch break, on site or to take away."
    ],
    "it": [
      "Il 101 EXPRESS offre un menù vario di piatti preparati al momento che potrete gustare in un ambiente moderno e raffinato."
    ],
    "fr": [
      "Le 101 EXPRESS vous propose une carte variée de plats cuisinés à la minute que vous pourrez apprécier dans un cadre moderne et raffiné."
    ],
    "es": [
      "El 101 EXPRESS ofrece una variada carta de platos recién preparados que podrá degustar en un ambiente moderno y refinado."
    ],
    "nl": [
      "De 101 EXPRESS biedt een gevarieerd menu met vers bereide gerechten waarvan u kunt genieten in een moderne en verfijnde omgeving."
    ]
  },
