  "rdfs:comment": {
    "de": [
      "\"Le cocon\" ist eine kleine Pizzeria im Stadtzentrum, die hausgemachte Gerichte und eine große Auswahl an Pizzen, Salaten und Desserts das ganze Jahr über am Abend anbietet."
    ],
    "en": [
      "\"Le cocon\" is a small pizzeria in the center of town offering homemade dishes and a wide choice of pizzas, salads and desserts all year round in the evenings."
    ],
    "it": [
      "\"Le Cocon\" è una piccola pizzeria nel centro della città che offre piatti fatti in casa e un'ampia scelta di pizze, insalate e dessert tutto l'anno la sera."
    ],
    "fr": [
      "\"Le cocon\" est une petite pizzeria en centre ville qui propose des plats faits maison et un large choix de pizzas, salades et desserts toute l'année en soirée."
    ],
    "es": [
      "\"Le Cocon\" es una pequeña pizzería en el centro de la ciudad que ofrece platos caseros y una amplia selección de pizzas, ensaladas y postres durante todo el año por las tardes."
    ],
    "nl": [
      "\"Le Cocon is een kleine pizzeria in het stadscentrum die het hele jaar door 's avonds huisgemaakte gerechten en een ruime keuze aan pizza's, salades en desserts biedt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria \"Le cocon\""
    ]
  },
