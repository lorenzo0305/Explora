  "rdfs:comment": {
    "de": [
      "Die Straußenfarm \"Les Autruches de la Tortue\", bietet Ihnen eine Entdeckungsreise durch diese atypischen Tiere, die sowohl das Auge als auch den Gaumen erfreuen."
    ],
    "en": [
      "The breeding of the Ostriches of the Tortoise, proposes to you a discovery of these atypical animals, for the pleasure of the eyes and the palate."
    ],
    "it": [
      "La fattoria degli struzzi della Tortue vi propone di scoprire questi animali atipici, per il piacere degli occhi e del palato."
    ],
    "fr": [
      "L'élevage des Autruches de la Tortue, vous propose une découverte de ces animaux atypiques, pour le plaisir des yeux et du palais."
    ],
    "es": [
      "La granja de Avestruces de la Tortue le ofrece un descubrimiento de estos animales atípicos, para el placer de los ojos y del paladar."
    ],
    "nl": [
      "De Struisvogelboerderij van la Tortue biedt u een ontdekking van deze atypische dieren, voor het plezier van de ogen en het gehemelte."
    ]
  },
