  "rdfs:comment": {
    "de": [
      "Bogenschießlehrer; in den Fußstapfen der Jäger und Sammler lade ich Sie ein, das Bogenschießen während eines Waldparcours zu entdecken."
    ],
    "en": [
      "In the footsteps of hunter-gatherers, I invite you to discover archery on a forest trail."
    ],
    "it": [
      "Sulle orme dei cacciatori-raccoglitori, vi invito a scoprire il tiro con l'arco su un sentiero forestale."
    ],
    "fr": [
      "Moniteur de Tir à l'arc; dans les pas des chasseurs cueilleurs je vous invite à découvrir le tir à l'arc lors d'un parcours forestier."
    ],
    "es": [
      "Siguiendo las huellas de los cazadores-recolectores, le invito a descubrir el tiro con arco en una pista forestal."
    ],
    "nl": [
      "In de voetsporen van de jager-verzamelaars nodig ik je uit om het boogschieten op een bospad te ontdekken."
    ]
  },
