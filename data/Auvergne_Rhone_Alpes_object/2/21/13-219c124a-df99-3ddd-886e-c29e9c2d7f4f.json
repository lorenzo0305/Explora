  "rdfs:comment": {
    "de": [
      "La Ferme de mon Pe?re bietet eine Feinschmeckerküche, eine sanfte Mischung aus Authentizität und savoyardisch inspirierten Kreationen, die die Prinzipien der Einfachheit aufgreift, die Zannier Le Chalet auszeichnen."
    ],
    "en": [
      "La Ferme de mon Père offers gourmet cuisine, a delightful blend of authenticity and Savoyard-inspired creativity that reflects the principles of simplicity that characterize Zannier Le Chalet."
    ],
    "it": [
      "La Ferme de mon Père propone una cucina gourmet, una dolce miscela di autenticità e creatività di ispirazione savoiarda che riflette i principi di semplicità che caratterizzano gli Zannier Hotels - Le Chalet."
    ],
    "fr": [
      "La Ferme de mon Père propose une cuisine gourmande, un doux mélange d’authenticité et de création d'inspiration savoyarde qui reprend les principes de simplicité qui caractérisent Zannier Le Chalet ."
    ],
    "es": [
      "La Ferme de mon Pe?re ofrece una cocina gastronómica, una suave mezcla de autenticidad y creatividad de inspiración saboyana que abraza los principios de sencillez que caracterizan a Zannier Le Chalet ."
    ],
    "nl": [
      "La Ferme de mon Pe?re biedt een gastronomische keuken, een zachte mix van authenticiteit en Savoyaards geïnspireerde creativiteit die de principes van eenvoud omarmt die Zannier Le Chalet kenmerken."
    ]
  },
