      "@id": "https://data.datatourisme.fr/2db92a12-6c83-35c1-b445-f2b508f1ef90",
      "dc:description": {
        "de": [
          "Italienisches Lebensmittelgeschäft\nTypisch italienische Produkte\nFrische Nudeln, Fertiggerichte, Kekse, Kuchen\nHausgemacht\n\nAnsatz \"Null Abfall\"\nAnsatz \"Null Plastik\"\nAnsatz \"Nachhaltige Ernährung\"\nAnsatz \"Anti-Verbraucher\""
        ],
        "en": [
          "Italian grocery\nTypical Italian products\nFresh pasta, ready meals, cookies, cakes\nHome-made\n\nZero waste\" approach\nZero plastic\" approach\nSustainable food\" approach\nAnti-gaspi\" approach"
        ],
        "it": [
          "Drogheria italiana\nProdotti tipicamente italiani\nPasta fresca, piatti pronti, biscotti, torte\nProdotti fatti in casa\n\nApproccio \"zero rifiuti\nApproccio \"Zero plastica\nApproccio \"cibo sostenibile\nApproccio \"anti-gaspi"
        ],
        "fr": [
          "Epicerie Italienne\nProduits typiquement italiens\nPâtes fraiches, plats cuisinés, biscuits, gâteaux\nFait maison\n\nDémarche \"Zéro déchet\"\nDémarche \"Zéro plastique\"\nDémarche \"Alimentation durable\"\nDémarche \"Anti-gaspi\""
        ],
        "nl": [
          "Italiaanse kruidenierswinkel\nTypisch Italiaanse producten\nVerse pasta, kant-en-klaarmaaltijden, koekjes, gebak\nZelfgemaakte producten\n\nZero waste\" benadering\nZero plastic\" benadering\nAanpak \"duurzame voeding\nAnti-gaspi\" benadering"
        ],
        "es": [
          "Alimentación italiana\nProductos típicamente italianos\nPasta fresca, platos preparados, galletas, pasteles\nProductos caseros\n\nCero residuos\nPlástico cero\nEnfoque \"Alimentos sostenibles\nEnfoque \"antigaspi"
        ]
      },
