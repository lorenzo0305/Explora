  "rdfs:comment": {
    "de": [
      "Das Rathaus ist ein Gebäude aus Stein, wie es für die Bauten vom Beginn des 20. Jahrhunderts typisch ist. Es beherbergt die Stadtverwaltung und den Sitzungsraum des Stadtrats"
    ],
    "en": [
      "The Town Hall is a stone building, typical of early XX century architecture. It houses all the municipal services and the meeting room for the village council."
    ],
    "it": [
      "Il municipio è un edificio in pietra, tipico dell'inizio del XX secolo. Ospita i servizi comunali e la sala riunioni del consiglio comunale."
    ],
    "fr": [
      "La mairie est un bâtiment en pierre, typique du début du XXe siècle. Elle regroupe les services municipaux et la salle de réunion du conseil municipal."
    ],
    "nl": [
      "Het stadhuis is een stenen gebouw, typisch voor het begin van de 20e eeuw. Het herbergt de gemeentelijke diensten en de vergaderzaal van de gemeenteraad."
    ],
    "es": [
      "El ayuntamiento es un edificio de piedra, típico de principios del siglo XX. Alberga los servicios municipales y la sala de reuniones del ayuntamiento."
    ]
  },
