  "rdfs:comment": {
    "de": [
      "Offener Betrieb in einem kleinen Dorf in der Auvergne. 2010 komplett neu eingerichtet, mit einer Kapazität von 50 Gedecken im Saal und allen modernen Annehmlichkeiten"
    ],
    "en": [
      "Valérie and Frédéric welcome you in a chic, low-key setting, the chef serves a 100% homemade traditional and refined cuisine.\r\nOff-season: closed from Friday evening and Sunday evening. On season: closed Sunday evenings."
    ],
    "it": [
      "Stabilimento aperto in un piccolo villaggio dell'Alvernia. Interamente creato nel 2010, con una capacità di 50 coperti nella sala da pranzo con tutti i comfort moderni"
    ],
    "fr": [
      "Établissement ouvert dans un petit village Auvergant. Entièrement créé en 2010, d'une capacité de 50 couverts en salle avec tout le confort moderne"
    ],
    "nl": [
      "Vestiging geopend in een klein dorpje in de Auvergne. Volledig gecreëerd in 2010, met een capaciteit van 50 couverts in de eetzaal met al het moderne comfort"
    ],
    "es": [
      "Establecimiento abierto en un pequeño pueblo de Auvernia. Creado íntegramente en 2010, con una capacidad de 50 cubiertos en el comedor con todo el confort moderno"
    ]
  },
