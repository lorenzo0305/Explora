  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/70c7a367-6721-34a7-8585-07bb1806275e",
      "dc:description": {
        "de": [
          "Ab 17.00 Uhr\nRockiger Flohmarkt mit vielen Ausstellern (weitere Infos folgen)\n\n18.00 - 19.00 Uhr\nKonzert von ALTER EGO\nTribute 100% J.L Aubert & Téléphone 100% Live\n\n19.15 - 20.15 Uhr\nKonzert von CONSERVATOIRE DE MUSIQUE\nDas CM der Stadt Vendin bietet Ihnen seinen Rockworkshop an, 100% Coverversionen der großen Hits\n\n20.30 bis 21.30 Uhr\nKonzert von TWILIGHT\ngruppe von 4 Musikern aus Douais, die auf der Bühne die größten Hits von U2 covern\n\n21:45 bis 23:45 Uhr\nKonzert von ''BLASTHARD''\nDie Geschichte des Hard Rock & Heavy Metal im Konzert (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ],
        "en": [
          "From 5:00 pm\nBrocante rock with numerous exhibitors (more info to come)\n\n6:00 pm - 7:00 pm\nConcert by ALTER EGO\nTribute 100% J.L Aubert & Téléphone 100% Live\n\n7:15pm - 8:15pm\nConcert by CONSERVATOIRE DE MUSIQUE\nThe CM de la Ville de Vendin will present its rock workshop, 100% covers of the greatest hits\n\n8:30 pm to 9:30 pm\nConcert by TWILIGHT\na group of 4 musicians from Douais, France, performing covers of U2's greatest hits\n\n9:45pm to 11:45pm\nBLASTHARD'' concert\nThe history of hard rock & heavy metal in concert (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ],
        "it": [
          "Dalle 17.00\nBrocante rock con numerosi espositori (ulteriori informazioni in arrivo)\n\ndalle 18.00 alle 19.00\nConcerto di ALTER EGO\nOmaggio 100% J.L Aubert & Téléphone 100% Live\n\n19.15 - 20.15\nConcerto del CONSERVATOIRE DE MUSIQUE\nIl CM de la Ville de Vendin proporrà il suo laboratorio rock, 100% cover dei più grandi successi\n\n20.30 - 21.30\nConcerto di TWILIGHT\nun gruppo di 4 musicisti di Douai che eseguono cover dei più grandi successi degli U2\n\ndalle 21.45 alle 23.45\nConcerto \"BLASTHARD\nLa storia dell'hard rock e dell'heavy metal in concerto (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ],
        "fr": [
          "A partir de 17h00\nBrocante rock avec de nombreux exposants (plus d'infos à venir)\n\n18h00 - 19h00\nConcert de ALTER EGO\nTribute 100% J.L Aubert & Téléphone 100% Live\n\n19h15 à 20h15\nConcert de CONSERVATOIRE DE MUSIQUE\nLe CM de la Ville de Vendin vous proposera son atelier rock, 100% reprises des grands tubes\n\n20h30 à 21h30\nConcert de TWILIGHT\ngroupe de 4 musiciens douaisiens reprenant sur scène les plus grands tubes de U2\n\n21h45 à 23h45\nConcert de ''BLASTHARD''\nL'histoire du hard rock & du heavy metal en concert (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ],
        "nl": [
          "Vanaf 17.00 uur\nBrocante rock met talrijke exposanten (meer info volgt)\n\n18u - 19u\nConcert door ALTER EGO\nHommage 100% J.L Aubert & Téléphone 100% Live\n\n19.15 - 20.15\nConcert door CONSERVATOIRE DE MUSIQUE\nHet CM de la Ville de Vendin biedt zijn rockworkshop aan, 100% covers van de grootste hits\n\n20.30 - 21.30 uur\nConcert door TWILIGHT\neen groep van 4 muzikanten uit Douai die covers spelen van de grootste hits van U2\n\n21.45 tot 23.45 uur\nBLASTHARD'' concert\nDe geschiedenis van hardrock & heavy metal in concert (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ],
        "es": [
          "A partir de las 17.00 h\nBrocante rock con numerosos expositores (más información próximamente)\n\nde 18:00 a 19:00\nConcierto de ALTER EGO\nHomenaje 100% J.L Aubert & Téléphone 100% Live\n\n19h15 - 20h15\nConcierto del CONSERVATOIRE DE MUSIQUE\nEl CM de la Ville de Vendin ofrecerá su taller de rock, 100% versiones de los grandes éxitos\n\n20.30 h a 21.30 h\nConcierto de TWILIGHT\ngrupo de 4 músicos de Douai que interpretan versiones de los grandes éxitos de U2\n\n21.45 h a 23.45 h\nConcierto \"BLASTHARD\nLa historia del hard rock & heavy metal en concierto (Led Zeppelin, Deep Purple, ACDC, Iron Maiden, Metallica, Gun's N Roses, Rammstein...)"
        ]
      },
