  "rdfs:comment": {
    "de": [
      "Entdecken Sie Estanco Bistronomie Ausfahrt 17 Bassens (73000) und genießen Sie hausgemachte Gerichte mit lokalen Produkten in einer Atmosphäre der Region. Service: Restaurant, Gerichte zum Mitnehmen, Abendunterhaltung."
    ],
    "en": [
      "Discover Estanco Bistronomie Sortie 17 Bassens (73000) to enjoy homemade dishes made with local produce in a local atmosphere. Services: catering, takeaway, evening entertainment."
    ],
    "it": [
      "Scoprite Estanco Bistronomie Sortie 17 Bassens (73000) per gustare piatti fatti in casa con prodotti locali in un'atmosfera locale. Servizi: ristorante, takeaway, intrattenimento serale."
    ],
    "fr": [
      "Découvrez Estanco Bistronomie Sortie 17 Bassens (73000) pour déguster des plats faits maison avec des produits locaux dans une ambiance du terroir. Services : restauration, plats à emporter, animations de soirées."
    ],
    "nl": [
      "Ontdek Estanco Bistronomie Sortie 17 Bassens (73000) om te genieten van huisgemaakte gerechten met lokale producten in een lokale sfeer. Diensten: restaurant, afhaalmaaltijden, avondentertainment."
    ],
    "es": [
      "Descubra Estanco Bistronomie Sortie 17 Bassens (73000) para degustar platos caseros elaborados con productos de la tierra en un ambiente local. Servicios: restaurante, comida para llevar, animación nocturna."
    ]
  },
