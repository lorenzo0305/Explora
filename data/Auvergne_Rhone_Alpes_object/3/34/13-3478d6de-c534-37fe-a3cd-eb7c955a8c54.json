  "rdfs:comment": {
    "de": [
      "Unternehmer, Selbstständige, Telearbeiter oder Projektträger - Ecowork Chartreuse bietet Ihnen einen ausgestatteten, komfortablen und hellen Gemeinschaftsarbeitsraum, Besprechungsräume für 2 bis 100 Personen und gesellige Bereiche."
    ],
    "en": [
      "Entrepreneurs, freelancers, remote workers or project leaders, Ecowork Chartreuse offers you a fully equipped, comfortable and bright shared workspace, meeting rooms that can accommodate 2 to 100 people, and convivial spaces."
    ],
    "it": [
      "Imprenditori, freelance, telelavoratori o capi progetto, Ecowork Chartreuse vi offre uno spazio di lavoro condiviso luminoso, confortevole e completamente attrezzato, sale riunioni da 2 a 100 persone e spazi conviviali."
    ],
    "fr": [
      "Entrepreneurs, indépendants, télétravailleurs ou porteurs de projets, Ecowork Chartreuse vous offre un espace de travail partagé équipé, confortable et lumineux, des salles de réunion pouvant accueillir de 2 à 100 personnes et des espaces conviviaux."
    ],
    "nl": [
      "Ondernemers, freelancers, telewerkers of projectleiders, Ecowork Chartreuse biedt u een lichte, comfortabele, volledig uitgeruste gedeelde werkruimte, vergaderzalen voor 2 tot 100 personen en gezellige ruimtes."
    ],
    "es": [
      "Empresarios, autónomos, teletrabajadores o jefes de proyecto, Ecowork Chartreuse le ofrece un espacio de trabajo compartido luminoso, cómodo y totalmente equipado, salas de reuniones de 2 a 100 personas y espacios de convivencia."
    ]
  },
