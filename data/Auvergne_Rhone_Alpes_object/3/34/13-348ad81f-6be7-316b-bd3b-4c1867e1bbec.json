  "rdfs:comment": {
    "de": [
      "Die Drôme und die Ardèche, wie Sie sie noch nie gesehen haben. Schwingen Sie sich auf Ihren Geländeroller und folgen Sie Ihrem Führer in ein spielerisches und für alle zugängliches Abenteuer unter freiem Himmel!"
    ],
    "en": [
      "The Drôme and Ardèche like you've never seen them before. Get on your all-terrain scooter and follow your guide on a fun, open-air adventure for all!"
    ],
    "it": [
      "La Drôme e l'Ardèche come non le avete mai viste prima. Salite sul vostro scooter fuoristrada e seguite la vostra guida in una divertente avventura all'aria aperta accessibile a tutti!"
    ],
    "fr": [
      "La Drôme et l'Ardèche comme vous ne les avez jamais vus. Enfourchez votre trottinette tout terrain et suivez votre guide dans une aventure ludique et accessible à tous en plein air !"
    ],
    "es": [
      "La Drôme y la Ardèche como nunca antes las habías visto. Súbete a tu scooter todoterreno y sigue a tu guía en una divertida aventura al aire libre y accesible para todos"
    ],
    "nl": [
      "De Drôme en Ardèche zoals je ze nog nooit hebt gezien. Stap op je all-terrain scooter en volg je gids op een leuk avontuur in de open lucht dat voor iedereen toegankelijk is!"
    ]
  },
  "rdfs:label": {
