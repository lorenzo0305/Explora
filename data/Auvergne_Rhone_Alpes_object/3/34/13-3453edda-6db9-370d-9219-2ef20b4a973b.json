  "rdfs:comment": {
    "de": [
      "Historischer Halt rund um die Gallier und den Wein nach der Méthode Nature, biologischem Anbau und biodynamischer und esoterischer Praxis...\r\nKostenlose Besichtigung und Verkostung."
    ],
    "en": [
      "Historical stop around the Gauls and the wine in natural method, organic culture and biodynamic practice..."
    ],
    "it": [
      "Una tappa storica incentrata sui Galli e sul vino prodotto con metodo naturale, agricoltura biologica e pratiche biodinamiche ed esoteriche...\r\nVisita e degustazione gratuita."
    ],
    "fr": [
      "Halte historique autour des gaulois et du vin en méthode nature, culture biologique et pratique biodynamique et ésotérique...\r\nVisite et dégustation gratuite."
    ],
    "es": [
      "Una escala histórica centrada en los galos y en el vino elaborado según el método natural, la agricultura ecológica y las prácticas biodinámicas y esotéricas...\r\nVisita y degustación gratuitas."
    ],
    "nl": [
      "Een historische halteplaats met aandacht voor de Galliërs en wijn gemaakt volgens de natuurlijke methode, biologische landbouw en biodynamische en esoterische praktijken...\r\nGratis bezoek en proeverij."
    ]
  },
