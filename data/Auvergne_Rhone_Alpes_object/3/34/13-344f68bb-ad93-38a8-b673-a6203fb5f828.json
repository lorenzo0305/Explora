  "rdfs:comment": {
    "de": [
      "Hallo an dich! Oh, du bist ein Musikliebhaber, ein leidenschaftlicher Verfechter des guten Tons: Jeden Dienstag ist die Bühne für dich da! Also komm und genieße es, deine Talente mit anderen zu teilen, als Solist, mit deiner Band oder einfach unter Freunden!"
    ],
    "en": [
      "Hi there! Oh music lover, fervent defender of good sound: every Tuesday the stage is for you! So come and enjoy and share your talents, solo, with your band or just with friends!"
    ],
    "it": [
      "Ciao a tutti! Oh amanti della musica, ferventi difensori del buon suono: ogni martedì il palco è per voi! Quindi venite a divertirvi e a condividere il vostro talento, da soli, con la vostra band o semplicemente con gli amici!"
    ],
    "fr": [
      "Salut à toi! Oh amoureux de la musique, fervent défenseur du bon son : tous les mardis la scène est pour toi !! Alors viens te régaler et faire partager tes talents, en solo, avec ton groupe ou simplement entre amis!"
    ],
    "es": [
      "¡Hola a todos! Oh melómanos, fervientes defensores del buen sonido: ¡todos los martes el escenario es para vosotros! Así que venid a divertiros y a compartir vuestro talento, en solitario, con vuestra banda o simplemente con amigos"
    ],
    "nl": [
      "Hallo daar! Oh muziekliefhebbers, fervente verdedigers van goed geluid: elke dinsdag is het podium voor jullie! Dus kom genieten en deel je talenten, solo, met je band of gewoon met vrienden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Scène ouverte"
    ]
  },
