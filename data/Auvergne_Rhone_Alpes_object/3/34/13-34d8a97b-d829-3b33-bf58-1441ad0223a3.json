  "rdfs:comment": {
    "de": [
      "In einem Konzert und einer Konferenz ohne Superkräfte, aber mit einer tollen Atmosphäre, werden sie durch die Entwicklung der Musik, die sie begleitet hat, wiederentdeckt."
    ],
    "en": [
      "Through the prism of the evolution of the music that accompanied them, we invite you to rediscover them in a concert-lecture without superpowers, but with a great atmosphere."
    ],
    "it": [
      "Vi invitiamo a riscoprirli attraverso il prisma dell'evoluzione della musica che li ha accompagnati, in un concerto e una conferenza senza superpoteri, ma con una grande atmosfera."
    ],
    "fr": [
      "C’est par le prisme de l’évolution des musiques qui les ont accompagnées que nous vous proposons de les redécouvrir lors d’un concert - conférence sans super pouvoir, mais dans une super ambiance."
    ],
    "nl": [
      "We nodigen je uit om ze te herontdekken door het prisma van de evolutie van de muziek die hen begeleidde, in een concert en conferentie zonder superkrachten, maar met een geweldige sfeer."
    ],
    "es": [
      "Le invitamos a redescubrirlos a través del prisma de la evolución de la música que los acompañó, en un concierto y una conferencia sin superpoderes, pero con un gran ambiente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Super héros ! L'univers musical Marvel / DC Comics"
    ]
  },
