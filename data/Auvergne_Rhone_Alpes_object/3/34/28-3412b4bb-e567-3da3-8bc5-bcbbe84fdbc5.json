      "rdfs:comment": {
        "de": [
          "Cashewnüsse und daraus hergestellte Produkte\nAfrikanische Lebensmittel: schwarze Seife, Bissap, Karité, Affenbrotbaum.\nDirektverkauf nach Vereinbarung, Verkostungen auf Anfrage möglich."
        ],
        "en": [
          "Cashew nuts and cashew-based products\nAfrican groceries: black soap, bissap, shea, baobab.\nDirect sales by appointment, tastings available on request."
        ],
        "it": [
          "Anacardi e prodotti a base di anacardi\nDrogheria africana: sapone nero, bissap, karité, baobab.\nVendita diretta su appuntamento, degustazioni su richiesta."
        ],
        "fr": [
          "Noix de cajou et produits dérivés à base de cajou. \nÉpicerie africaine : savon noir, bissap, karité, baobab.\nVente en direct sur rendez-vous, dégustations possibles sur demande."
        ],
        "nl": [
          "Cashewnoten en producten op basis van cashewnoten\nAfrikaanse boodschappen: zwarte zeep, bissap, shea, baobab.\nDirecte verkoop op afspraak, proeverijen op aanvraag."
        ],
        "es": [
          "Anacardos y productos a base de anacardos\nComestibles africanos: jabón negro, bissap, karité, baobab.\nVenta directa con cita previa, degustaciones a petición."
        ]
