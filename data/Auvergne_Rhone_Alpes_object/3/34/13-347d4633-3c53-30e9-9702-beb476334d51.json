  "rdfs:comment": {
    "de": [
      "Eines der letzten \"epochalen\" Café-Restaurants in Romans!\r\n\r\nDer Chefkoch bietet Ihnen von der Vorspeise bis zum Dessert eine \"hausgemachte\" Küche mit einer Karte, die mit saisonalen Produkten aktualisiert wird."
    ],
    "en": [
      "One of the last \"period\" cafés-restaurants in Romans!\r\n\r\nFrom starters to desserts, the chef offers home-cooked cuisine, with a menu updated with seasonal produce."
    ],
    "it": [
      "Uno degli ultimi caffè-ristoranti \"d'epoca\" di Roma!\r\n\r\nLo chef vi propone dall'antipasto al dolce una cucina casalinga con un menu aggiornato con prodotti di stagione."
    ],
    "fr": [
      "L'un des derniers cafés-restaurants \"d'époque\" de Romans !\r\n\r\nLe Chef vous propose de l’entrée au dessert une cuisine faites « Maison » avec une carte mise à jour avec les produits de saison."
    ],
    "es": [
      "Uno de los últimos cafés-restaurante \"de época\" de Roma\r\n\r\nEl Chef le ofrece desde el entrante hasta el postre una cocina casera con una carta actualizada con productos de temporada."
    ],
    "nl": [
      "Een van de laatste café-restaurants uit die tijd in Rome!\r\n\r\nVan voorgerechten tot desserts, de chef serveert huisgemaakte gerechten van een menu dat wordt bijgewerkt met seizoensproducten."
    ]
  },
