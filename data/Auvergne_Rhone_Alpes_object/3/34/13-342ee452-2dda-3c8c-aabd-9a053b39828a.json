  "rdfs:comment": {
    "de": [
      "Unser Team aus 300 Betreuern stellt sein Fachwissen in Ihren Dienst, um Ihnen unabhängig von Ihrem Alter oder Ihrem Niveau ein passendes Angebot zu unterbreiten."
    ],
    "en": [
      "Our team of 300 ski instructors puts its expertise at your service to offer you the right package whatever your age or level."
    ],
    "it": [
      "Il nostro team di 300 maestri di sci mette la sua esperienza al vostro servizio per offrirvi il pacchetto giusto, indipendentemente dalla vostra età o dal vostro livello."
    ],
    "fr": [
      "Notre équipe de 300 moniteurs met son expertise à votre service pour vous proposer une offre adaptée quel que soit votre âge ou votre niveau."
    ],
    "nl": [
      "Ons team van 300 skileraren stelt zijn expertise tot uw dienst om u het juiste pakket aan te bieden, ongeacht uw leeftijd of niveau."
    ],
    "es": [
      "Nuestro equipo de 300 monitores de esquí pone su experiencia a tu servicio para ofrecerte el paquete adecuado sea cual sea tu edad o nivel."
    ]
  },
