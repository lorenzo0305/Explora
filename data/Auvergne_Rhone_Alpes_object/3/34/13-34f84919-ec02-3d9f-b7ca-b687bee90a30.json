  "rdfs:comment": {
    "de": [
      "Flash-Tour ? in Ihrer Eintrittskarte enthalten\r\nLassen Sie sich von einem Guide in 20 Minuten durch das aufregende Leben des berühmtesten aller Star-Tänzer, Rudolf Nurejew, führen oder wiederentdecken."
    ],
    "en": [
      "Flash tour ? included in your admission ticket\r\nLet a guide take you on a 20-minute tour to discover or rediscover the exciting life of the world's most famous dancing star, Rudolf Nureyev."
    ],
    "it": [
      "Visita Flash? inclusa nel biglietto d'ingresso\r\nLasciate che una guida vi accompagni in un tour di 20 minuti per scoprire o riscoprire l'emozionante vita del più famoso dei ballerini-star, Rudolf Nureyev."
    ],
    "fr": [
      "Visite Flash – inclus dans votre billet d’entrée\r\nLaissez-vous entrainer par un guide en 20 minutes pour découvrir ou redécouvrir la vie palpitante du plus célèbre des danseurs étoiles, Rudolf Noureev."
    ],
    "es": [
      "Visita flash incluida en la entrada\r\nDeje que un guía le lleve en un recorrido de 20 minutos para descubrir o redescubrir la apasionante vida del más famoso de todos los bailarines estrella, Rudolf Nureyev."
    ],
    "nl": [
      "Flash? bezoek inbegrepen in je toegangsticket\r\nLaat je door een gids meenemen op een rondleiding van 20 minuten om het spannende leven van de beroemdste sterdanser aller tijden, Rudolf Nureyev, te (her)ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite flash « Noureev »"
    ]
  },
