  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Espace Aquatique de Flaine, einen Ort für Groß und Klein, an dem die ganze Familie gemeinsam entspannen kann. Zwischen Spielbecken, Wasserspielen und Entspannungsbereichen findet hier jeder sein Vergnügen."
    ],
    "en": [
      "Discover Flaine’s Aquatic Center, a place designed for both children and adults to enjoy relaxing family moments together. With playful pools, water games, and relaxing areas, there’s something for everyone to enjoy."
    ],
    "it": [
      "Scoprite l'Espace Aquatique de Flaine, un luogo pensato per grandi e piccini per condividere momenti di relax in famiglia. Con piscine divertenti, giochi d'acqua e aree relax, ce n'è per tutti i gusti."
    ],
    "fr": [
      "Découvrez l’Espace Aquatique de Flaine, un lieu pensé pour petits et grands où partager des moments de détente en famille. Entre bassins ludiques, jeux d’eau et espaces relaxants, chacun y trouve son plaisir."
    ],
    "nl": [
      "Ontdek het Aquatisch Centrum van Flaine, een plek voor kinderen en volwassenen om samen ontspannen familietijd door te brengen. Met speelse zwembaden, waterspellen en ontspanningsruimtes is er voor ieder wat wils."
    ],
    "es": [
      "Descubra el Espace Aquatique de Flaine, un lugar pensado para que grandes y pequeños compartan momentos de relax en familia. Con divertidas piscinas, juegos acuáticos y zonas de relax, hay para todos los gustos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aquatic centre"
    ],
