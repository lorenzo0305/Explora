  "rdfs:comment": {
    "de": [
      "Acrobois Romans ist ein Mehrzweck-Freizeitpark für Jung und Alt mit Baumklettern. \r\n14 Parcours auf 5 Hektar. \r\nPicknickplatz oder Snack im Freien."
    ],
    "en": [
      "Acrobois Romans is an outdoor recreation park for young and old with tree climbing. \r\n14 courses on 5 hectares. \r\nPicnic and snack area."
    ],
    "it": [
      "Acrobois Romans è un parco di accrobranche all'aperto per grandi e piccini.\r\n14 percorsi su 5 ettari. Area picnic e snack bar. Il Village des Elfes è aperto ai bambini a partire dai 2 anni."
    ],
    "fr": [
      "Acrobois Romans est un parc accrobranche en plein air pour petits et grands. \r\n14 parcours sur 5 hectares. Aire de pique-nique et snack. Village des Elfes est accessible dès 2 ans."
    ],
    "nl": [
      "Acrobois Romans is een multifunctioneel openlucht recreatiepark voor jong en oud met boomklimmen.\r\n14 gangen op 5 hectare.\r\nPicknick- of snackgebied."
    ],
    "es": [
      "Acrobois Romans es un parque de acrobacias al aire libre para grandes y pequeños.\r\n14 pistas en 5 hectáreas. Zona de picnic y cafetería. Village des Elfes está abierto a niños a partir de 2 años."
    ]
  },
