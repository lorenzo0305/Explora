  "rdfs:comment": {
    "de": [
      "Freie Besichtigung auf Anfrage des Kirchenschlüssels im Rathaus. Die romanische, einschiffige Kirche Saint-Paul stammt aus dem 12. JAHRHUNDERT UND IST ISMH. Ihr hölzerner Glockenturm stammt aus dem 16. Jahrhundert und die Glocke aus dem Jahr 1527."
    ],
    "en": [
      "Free visit on request of the keys of the church in Town Hall. The Romanesque church of Saint-Paul, with a single nave, dates from the 12th century. ISMH. Its wooden bell tower is from the 16th century and the bell from 1527."
    ],
    "it": [
      "Visita gratuita su richiesta delle chiavi della chiesa presso il Municipio. La chiesa romanica di Saint-Paul, a navata unica, risale al XII secolo. ISMH. Il suo campanile in legno risale al XVI secolo e la campana al 1527."
    ],
    "fr": [
      "Visite libre sur demande des clés de l'église en Mairie. L'église romane Saint-Paul, à nef unique, date du XIIe siècle. ISMH. Son clocher de bois est du XVIe et la cloche de 1527."
    ],
    "es": [
      "Visita gratuita previa solicitud de las llaves de la iglesia en el Ayuntamiento. La iglesia románica de Saint-Paul, de una sola nave, data del siglo XII. ISMH. Su campanario de madera data del siglo XVI y la campana de 1527."
    ],
    "nl": [
      "Gratis bezoek op aanvraag van de sleutels van de kerk op het stadhuis. De Romaanse kerk Saint-Paul, met één schip, dateert uit de 12e eeuw. ISMH. De houten klokkentoren dateert uit de 16e eeuw en de klok uit 1527."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Paul"
    ]
  },
