  "rdfs:comment": {
    "de": [
      "A l'étable du Mézenc, Kuhkäse, Fleisch AOP Fin Gras du Mézenc, Fertiggerichte und Bauernhofprodukte: ein Bauernhof mit biologischem Anbau, der sich für eine lokale und verantwortungsbewusste Produktion einsetzt. Folgen Sie ihrer Facebook-Seite für den Verkauf auf dem Bauernhof."
    ],
    "en": [
      "A l'étable du Mézenc, cow's milk cheeses, PDO Fin Gras du Mézenc meat, ready-made meals and farm products: an organic farm committed to local, responsible production. Follow their Facebook page for farm sales."
    ],
    "it": [
      "A l'étable du Mézenc, formaggio di latte vaccino, carne DOP Fin Gras du Mézenc, piatti pronti e prodotti della fattoria: un'azienda agricola biologica impegnata in una produzione locale e responsabile. Seguite la loro pagina Facebook per le vendite in fattoria."
    ],
    "fr": [
      "A l'étable du Mézenc, fromages de vache, viande AOP Fin Gras du Mézenc, plats cuisinés et produits fermiers : une ferme en agriculture biologique engagée dans une production locale et responsable. Suivez leur page Facebook pour la vente à la ferme."
    ],
    "es": [
      "A l'étable du Mézenc, quesos de leche de vaca, carne DOP Fin Gras du Mézenc, platos preparados y productos de granja: una granja ecológica comprometida con la producción local y responsable. Sigue su página de Facebook para conocer las ventas de la granja."
    ],
    "nl": [
      "A l'étable du Mézenc, kaas van koemelk, vlees met BOB Fin Gras du Mézenc, kant-en-klaarmaaltijden en boerderijproducten: een biologische boerderij die zich inzet voor lokale, verantwoorde productie. Volg hun Facebookpagina voor de boerderijverkoop."
    ]
  },
