  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30f51477-ad02-3190-a6ad-38bb0da92839",
      "dc:description": {
        "de": [
          "Parade durch die Straßen der Stadt, mit Start am Maison de l'enfant (Haus des Kindes). Groß und Klein sind eingeladen, an der Parade teilzunehmen."
        ],
        "en": [
          "Parade through the streets of the town, starting at the Maison de l?enfant, where young and old are invited to join in."
        ],
        "it": [
          "Una sfilata per le vie della città, con partenza dalla Maison de l'Enfant, dove grandi e piccini sono invitati a partecipare."
        ],
        "fr": [
          "Parade dans les rues de la ville, avec un départ depuis la Maison de l’enfant, petits et grands sont invités à venir défiler."
        ],
        "es": [
          "Un desfile por las calles de la ciudad, que comienza en la Maison de l'Enfant, donde pequeños y mayores están invitados a participar."
        ],
        "nl": [
          "Een optocht door de straten van de stad, die begint bij het Maison de l'Enfant, waar jong en oud worden uitgenodigd om mee te doen."
        ]
      },
