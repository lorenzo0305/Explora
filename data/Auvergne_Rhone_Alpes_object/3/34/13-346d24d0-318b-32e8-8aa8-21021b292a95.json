  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais mit Geocaching: eine Schatzsuche für die ganze Familie!\r\nIn Chazay-d?Azergues verfolgen Sie den Gnolu Kloche, indem Sie dem Faden der lokalen Legende des Baboin folgen!"
    ],
    "en": [
      "Discover Beaujolais with geocaching: a treasure hunt for all the family!\r\nIn Chazay-d?Azergues, follow the thread of the local Baboin legend as you follow the Gnolu Kloche!"
    ],
    "it": [
      "Scoprite la regione del Beaujolais con il geocaching: una caccia al tesoro per tutta la famiglia!\r\nA Chazay-d'Azergues, seguite il filo della leggenda locale di Baboin seguendo la Gnolu Kloche!"
    ],
    "fr": [
      "Découvrez le Beaujolais avec le géocaching : une chasse aux trésors à vivre en famille ! \r\nÀ Chazay-d’Azergues poursuivez le Gnolu Kloche en suivant le fil de la légende locale du Baboin !"
    ],
    "nl": [
      "Ontdek de Beaujolais met geocaching: een schattenjacht voor het hele gezin!\r\nVolg in Chazay-d?Azergues de draad van de plaatselijke Baboin-legende en volg de Gnolu Kloche!"
    ],
    "es": [
      "Descubra la región del Beaujolais con el geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn Chazay-d'Azergues, siga el hilo de la leyenda local de Baboin siguiendo el Gnolu Kloche"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Sautefort ! Sautefort ! Le Baboin !"
    ]
  },
