  "rdfs:comment": {
    "de": [
      "Ehemaliges Schloss aus dem 18. Jahrhundert, Unterkunft in anderen Gebäuden aus dem 20.\r\nIn der Nähe des Naturschutzgebietes \"Ramières du Val de Drôme\", auf den Mountainbike-Strecken 26, \"Les Chemins du Soleil\" und \"La Grande Traversée des Préalpes Valence-Gap\"."
    ],
    "en": [
      "A 18th-century castle with accommodation, catering, and meeting rooms for groups and individuals."
    ],
    "it": [
      "Castello del XVIII secolo con alloggi, ristorante e sale riunioni per gruppi e singoli."
    ],
    "fr": [
      "Château du 18ème siècle avec hébergement, restauration et salles de réunion pour groupes et particuliers."
    ],
    "nl": [
      "Voormalig kasteel uit de 18e eeuw, accommodatie in andere gebouwen uit de 20e eeuw.\r\nVlakbij het Réserve Naturelle des Ramières du Val de Drôme, op mountainbikeroutes 26, \"Les Chemins du Soleil\" en \"La Grande Traversée des Préalpes Valence-Gap\"."
    ],
    "es": [
      "Castillo del siglo XVIII con alojamiento, restaurante y salas de reuniones para grupos y particulares."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accueil Saint Joseph, salles à louer"
    ]
  },
