  "rdfs:comment": {
    "de": [
      "Wie läuft eine Sitzung ab?  Alles ist darauf ausgerichtet, Sie auf intime und herzliche Weise zu empfangen. Sie werden es sich auf einem Stuhl vor mir bequem machen."
    ],
    "en": [
      "What's a session like?  Everything is done to give you a warm and intimate welcome. You'll sit comfortably in a chair opposite me."
    ],
    "it": [
      "Come funziona una sessione?  Tutto è fatto per darvi un'accoglienza calda e intima. Vi siederete comodamente su una sedia di fronte a me."
    ],
    "fr": [
      "Comment se passe une séance ?  Tout est fait pour vous accueillir de manière intimiste et chaleureuse. Vous allez vous installer confortablement sur chaise en face de moi."
    ],
    "es": [
      "¿Cómo funciona una sesión?  Todo se hace para darle una bienvenida cálida e íntima. Se sentará cómodamente en una silla frente a mí."
    ],
    "nl": [
      "Hoe werkt een sessie?  Alles wordt in het werk gesteld om je een warm en intiem welkom te geven. Je zit comfortabel op een stoel tegenover me."
    ]
  },
