  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, das mit frischen und saisonalen Produkten arbeitet. Raffinierte Küche mit Respekt vor der Kunst der Bistronomie. Sehr gutes Preis-Leistungs-Verhältnis.\r\nReservierung empfohlen."
    ],
    "en": [
      "Traditional restaurant working with seasonal fresh produce. Sophisticated cuisine in keeping with the finest arts of bistronomy. Very good value for money. Booking is advised."
    ],
    "it": [
      "Ristorante che propone una cucina francese ispirata a ricette provenienti da tutto il mondo, utilizzando prodotti freschi di stagione. Una cucina raffinata in linea con l'arte della bistronomia. Ottimo rapporto qualità-prezzo. Si consiglia la prenotazione."
    ],
    "fr": [
      "Restaurant de cuisine française inspirée des recettes du monde entier et travaillant avec des produits frais et de saison. Cuisine raffinée dans le respect de l'art de la bistronomie. Très bon rapport qualité prix. Réservation conseillée."
    ],
    "nl": [
      "Traditioneel restaurant dat alleen met verse producten werkt. Met het keurmerk kwaliteitsrestaurant uitgereikt door het culinaire college. Verfijnde keuken met respect voor de kunst van gastronomie. Goede prijskwaliteitverhouding."
    ],
    "es": [
      "Restaurante de cocina francesa inspirada en recetas de todo el mundo y elaborada con productos frescos de temporada. Cocina refinada que sigue el arte de la bistronomía. Excelente relación calidad-precio. Se recomienda reservar."
    ]
  },
