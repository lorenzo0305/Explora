  "rdfs:comment": {
    "de": [
      "Nach Süden ausgerichtetes Kalksteingebiet im Gemeindewald von Sancellemoz, das vom Office National des Forêts verwaltet wird. Hier wird hauptsächlich an Platten, Verwachsungen und Regletten geklettert. Einige Schwarten sind mit Plättchen und Schnellgliedern ausgestattet."
    ],
    "en": [
      "A south-facing limestone site in the Sancellemoz communal forest, managed by the Office National des Forêts, where the climbing is mainly on slabs, adherences and rulers. Some bolts are equipped with quickdraws."
    ],
    "it": [
      "Sito calcareo esposto a sud nella foresta comunale di Sancellemoz, gestito dall'Office National des Forêts, dove l'arrampicata si svolge principalmente su placche, prese e righelli. Alcuni spit sono attrezzati con protezioni e maglie rapide."
    ],
    "fr": [
      "Site en calcaire, orienté plein sud en forêt communale de Sancellemoz, sous gestion de l’Office national des forêts, où l’escalade est essentiellement en dalle, à adhérences et réglettes. Certaines couennes sont équipées de plaquettes et maillons rapides."
    ],
    "es": [
      "Un sitio calcáreo orientado al sur en el bosque comunal de Sancellemoz, gestionado por la Office National des Forêts, donde la escalada se realiza principalmente en placas, agarres y reglas. Algunos bolts están equipados con placas y eslabones rápidos."
    ],
    "nl": [
      "Een op het zuiden gelegen kalksteenterrein in het gemeentebos van Sancellemoz, beheerd door het Office National des Forêts, waar voornamelijk op platen, grepen en linialen wordt geklommen. Sommige bouten zijn uitgerust met pads en snelkoppelingen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kletterblöcke auf dem Plateau d'Assy"
    ],
    "en": [
      "Plateau d'Assy climbing boulders"
    ],
    "fr": [
      "Blocs d'escalade du Plateau d'Assy"
    ]
  },
