  "rdfs:comment": {
    "de": [
      "Das historische Anwesen zwischen dem Mont-Blanc und dem See von Annecy empfängt Sie in seinen bewaldeten Scheunen und Gärten für alle Ihre privaten oder geschäftlichen Veranstaltungen bis zu 600 Personen."
    ],
    "en": [
      "A historical homestead located between Mont Blanc and Annecy, Gy Farm hosts private and professional events, indoors and out, in one of the barns or its gardens. Capacity: up to 600 people."
    ],
    "it": [
      "Residenza storica, situata tra il Monte Bianco e il Lago di Annecy, la fattoria Gy vi accoglie nei suoi fienili e giardini alberati, per tutti i vostri eventi privati o professionali fino a 600 persone."
    ],
    "fr": [
      "Demeure historique, située entre le Mont-Blanc et le lac d'Annecy, la ferme de Gy vous accueille dans ses granges boisées et ses jardins, pour tous vos évènements privés ou professionnels jusqu'à 600 personnes."
    ],
    "es": [
      "Residencia histórica, situada entre el Mont Blanc y el lago de Annecy, la granja Gy le acoge en sus graneros y jardines arbolados, para todos sus eventos privados o profesionales de hasta 600 personas."
    ],
    "nl": [
      "De boerderij van Gy, een historisch verblijf, gelegen tussen de Mont Blanc en het meer van Annecy, verwelkomt u in haar beboste schuren en tuinen, voor al uw particuliere of professionele evenementen tot 600 personen."
    ]
  },
