  "rdfs:comment": {
    "de": [
      "Permafrost, ein dauerhaft gefrorener Boden, hat lange Zeit zur Stabilisierung der Hänge in den Alpen beigetragen, indem er den Boden \"zementiert\" hat."
    ],
    "en": [
      "Permafrost - permanently frozen ground - has long helped to stabilize slopes in the Alps by \"cementing\" the soil."
    ],
    "it": [
      "Il permafrost, il terreno permanentemente ghiacciato, ha da tempo contribuito a stabilizzare i pendii delle Alpi \"cementando\" il suolo."
    ],
    "fr": [
      "Le permafrost, sol gelé de façon pérenne, a longtemps contribué à la stabilisation des pentes dans les Alpes en \"cimentant\" le sol."
    ],
    "nl": [
      "Permafrost, permanent bevroren grond, heeft lang geholpen om hellingen in de Alpen te stabiliseren door de grond te \"cementeren\"."
    ],
    "es": [
      "El permafrost, suelo permanentemente helado, ha ayudado durante mucho tiempo a estabilizar las laderas de los Alpes al \"cementar\" el suelo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence - Dégradation du permafrost : Quelles conséquences en montagne ?"
    ]
  },
