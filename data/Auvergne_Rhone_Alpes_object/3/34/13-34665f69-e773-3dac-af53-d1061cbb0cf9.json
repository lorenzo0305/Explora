  "rdfs:comment": {
    "de": [
      "Willkommen bei Chichicarton: Iza, eine Designerin aus allen Bereichen, für eine individuelle Dekoration? Aber auch Lederwaren, Schmuck und die Herstellung von Krippen: Jedes Stück ist einzigartig"
    ],
    "en": [
      "Welcome to Chichicarton: Iza, a designer from all horizons, for personalised decoration ... But also leather goods, jewellery, and the creation of cots: each piece is unique."
    ],
    "it": [
      "Benvenuti a Chichicarton: Iza, designer di tutti gli orizzonti, per decorazioni personalizzate? Ma anche pelletteria, gioielli e creazione di culle: ogni pezzo è unico"
    ],
    "fr": [
      "Bienvenue chez Chichicarton : Iza, une créatrice tous horizons, pour une décoration personnalisée … Mais aussi de la maroquinerie, des bijoux, et la réalisations de crèches : chaque pièce est unique"
    ],
    "nl": [
      "Welkom in Chichicarton: Iza, een ontwerpster van alle horizonten, voor gepersonaliseerde decoratie? Maar ook lederwaren, sieraden en de creatie van kinderbedjes: elk stuk is uniek"
    ],
    "es": [
      "Bienvenido a Chichicarton: Iza, un diseñador de todos los horizontes, para la decoración personalizada? Pero también marroquinería, joyería y creación de cunas: cada pieza es única"
    ]
