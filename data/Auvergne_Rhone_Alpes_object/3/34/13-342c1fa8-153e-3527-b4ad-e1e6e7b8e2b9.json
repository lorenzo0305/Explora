  "rdfs:comment": {
    "de": [
      "Eine familiäre und gesellige Einrichtung, in der gute Laune herrscht, die Sie das ganze Jahr über willkommen heißt! Animationen auf Ponys, Zeit, um die Ponys des Poney Club de l'Etang kennen zu lernen."
    ],
    "en": [
      "A friendly, family-run facility that welcomes you all year round! Pony activities, time to get to know the ponies of the Pony Club de l'Etang."
    ],
    "it": [
      "Una struttura amichevole e familiare, dove il buon umore la fa da padrone, che vi accoglie tutto l'anno! Attività con i pony, tempo per conoscere i pony del Poney Club de l'Etang."
    ],
    "fr": [
      "Une structure familiale et conviviale, où la bonne humeur est reine qui vous accueille toute l'année ! Des animations à poney, du temps pour faire connaissance avec les poneys du poney club de l'Etang."
    ],
    "es": [
      "Un establecimiento familiar y acogedor, donde reina el buen humor, que le da la bienvenida durante todo el año Actividades con ponis, tiempo para conocer a los ponis del Etang Pony Club."
    ],
    "nl": [
      "Een gezellige familiecamping met een goed humeur, waar je het hele jaar door welkom bent! Ponyactiviteiten, tijd om de pony's van de Poney Club de l'Etang te leren kennen."
    ]
  },
