  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/09a8c854-e85b-354c-8b0e-b093f1b0670b",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nMontag bis Freitag: 8h - 12h / 14h-18h\nSamstag: 9h - 12h / 16h -18h\n\nSonntag geschlossen\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\nBestellungen:\n\nKann auf der Website gemietet werden\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nMonday to Friday: 8h - 12h / 14h-18h\nSaturday: 9h - 12h / 16h -18h\n\nClosed on Sunday\n\nCollection:\n\nDuring store opening hours\n\nOrdering :\n\nPossibility of renting on the website\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa lunedì a venerdì: 8.00-12.00 / 14.00-18.00\nSabato: 9.00-12.00 / 16.00-18.00\n\nChiuso la domenica\n\nRitiro:\n\nDurante gli orari di apertura del negozio\n\nOrdini :\n\nPossibilità di noleggio sul sito web\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu lundi au vendredi : 8h - 12h / 14h-18h\nSamedi : 9h - 12h / 16h -18h\n\nFermeture le dimanche\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de louer sur le site internet \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nMaandag tot vrijdag: 8u - 12u / 14u - 18u\nZaterdag: 9u - 12u / 16u - 18u\n\nGesloten op zondag\n\nOphalen:\n\nTijdens winkelopeningstijden\n\nBestellen :\n\nMogelijkheid tot huren op de website\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe lunes a viernes: de 8.00 h. a 12.00 h. / de 14.00 h. a 18.00 h\nSábado: 9.00 h - 12.00 h / 16.00 h - 18.00 h\n\nDomingos cerrado\n\nRecogida:\n\nDurante el horario de apertura de la tienda\n\nPedidos :\n\nPosibilidad de alquiler en el sitio web\n\n "
        ]
      },
