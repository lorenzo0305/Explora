  "rdfs:comment": {
    "de": [
      "Restaurant - Bar - Rumfabrik\r\nVerpflegung vor Ort oder zum Mitnehmen.\r\nTraditionelle französische, südländische und internationale Küche.\r\nKlimatisierter Saal, Restaurant mit Terrasse.\r\nEinfaches Parken (großer Parkplatz vor dem Restaurant)."
    ],
    "en": [
      "Restaurant - Bar - Rum shop\r\nOn-site or takeaway catering.\r\nTraditional French, southern and world cuisine.\r\nAir-conditioned dining room, restaurant with terrace.\r\nEasy parking (large lot in front)."
    ],
    "it": [
      "Ristorante - Bar - Negozio di rum\r\nRistorazione in loco o da asporto.\r\nCucina tradizionale francese, meridionale e mondiale.\r\nSala da pranzo climatizzata, ristorante con terrazza.\r\nParcheggio facile (ampio parcheggio antistante)."
    ],
    "fr": [
      "Restaurant - Bar - Rhumerie\r\nRestauration sur place ou à emporter. \r\nCuisine traditionnel française, méridionale, du monde.\r\nSalle climatisée, restaurant doté d'une terrasse.\r\nFacilité de stationnement (grand parking devant)."
    ],
    "es": [
      "Restaurante - Bar - Tienda de ron\r\nRestauración in situ o para llevar.\r\nCocina tradicional francesa, del sur y del mundo.\r\nComedor climatizado, restaurante con terraza.\r\nFácil aparcamiento (gran aparcamiento delante)."
    ],
    "nl": [
      "Restaurant - Bar - Rumwinkel\r\nCatering ter plaatse of om mee te nemen.\r\nTraditionele Franse, zuiderse en wereldkeuken.\r\nEetzaal met airconditioning, restaurant met terras.\r\nGemakkelijk parkeren (grote parkeerplaats voor de deur)."
    ]
  },
