  "rdfs:comment": {
    "de": [
      "Kirche, die von 1855 bis 1859 im neugotischen Stil an der Stelle des alten Gebäudes aus dem 16. Jahrhundert errichtet wurde. Die Kirche wurde am 6. Oktober 1878 von Kardinal CAVEROT geweiht."
    ],
    "en": [
      "Church built from 1855 to 1859 in neo-Gothic style on the site of the former 16th-century building. The church was consecrated by Cardinal CAVEROT on October 6, 1878."
    ],
    "it": [
      "Chiesa costruita tra il 1855 e il 1859 in stile neogotico sul sito del precedente edificio del XVI secolo. La chiesa fu consacrata dal cardinale CAVEROT il 6 ottobre 1878."
    ],
    "fr": [
      "Église construite de 1855 à 1859 dans le style néo-Gothique sur l'emplacement de l'ancien édifice datant du XVIe siècle. L'église fut consacrée par le cardinal CAVEROT le 6 octobre 1878."
    ],
    "nl": [
      "Kerk gebouwd tussen 1855 en 1859 in neogotische stijl op de plaats van het voormalige 16e-eeuwse gebouw. De kerk werd op 6 oktober 1878 ingewijd door kardinaal CAVEROT."
    ],
    "es": [
      "Iglesia construida entre 1855 y 1859 en estilo neogótico en el emplazamiento del antiguo edificio del siglo XVI. Fue consagrada por el cardenal CAVEROT el 6 de octubre de 1878."
    ]
  },
  "rdfs:label": {
