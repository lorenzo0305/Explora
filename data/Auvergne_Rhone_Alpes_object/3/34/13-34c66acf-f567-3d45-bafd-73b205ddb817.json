  "rdfs:comment": {
    "de": [
      "Anlässlich des 50-jährigen Bestehens der freiwilligen Blutspender in Cusset lädt der Verein die Theatergruppe \"les trois roues\" zu einem Theaterabend mit der Komödie von Jean-Yves Chatelain \"Et ma promo?\" am Samstag, den 18. April 2026 um 20 Uhr ein."
    ],
    "en": [
      "To mark the 50th anniversary of Cusset's volunteer blood donors, the association is inviting the \"les trois roues\" company to perform Jean-Yves Chatelain's comedy \"Et ma promo?\" on Saturday, April 18, 2026 at 8pm."
    ],
    "it": [
      "In occasione del 50° anniversario dei donatori volontari di sangue di Cusset, l'associazione invita la compagnia \"les trois roues\" a rappresentare una serata di teatro con la commedia \"Et ma promo?\" di Jean-Yves Chatelain, sabato 18 aprile 2026 alle ore 20.00."
    ],
    "fr": [
      "À l'occasion des 50 ans des donneurs de sang bénévoles de Cusset, l'association invite la compagnie \"les trois roues\" pour une soirée théâtrale avec la comédie de Jean-Yves Chatelain, « Et ma promo ? » le samedi 18 avril 2026 à 20h."
    ],
    "nl": [
      "Ter gelegenheid van de 50e verjaardag van de vrijwillige bloeddonoren van Cusset nodigt de vereniging het gezelschap \"les trois roues\" uit voor een theateravond met de komedie \"Et ma promo?\" van Jean-Yves Chatelain op zaterdag 18 april 2026 om 20 uur."
    ],
    "es": [
      "Con motivo del 50 aniversario de los donantes voluntarios de sangre de Cusset, la asociación invita a la compañía \"les trois roues\" a representar una velada teatral con la comedia \"Et ma promo?\", de Jean-Yves Chatelain, el sábado 18 de abril de 2026 a las 20.00 horas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre | \"Et ma promo ?\" • Cie les 3 roues"
    ]
  },
