  "rdfs:comment": {
    "de": [
      "BROCANTE das ganze Jahr über geöffnet, Ideen für die Dekoration Ihrer Häuser. Ein Kauf im Trödelmarkt bedeutet Recycling, indem Sie Einkäufe tätigen, die Ihnen Freude bereiten."
    ],
    "en": [
      "BROCANTE open all year round, ideas for decorating your home. Buying at a flea market means recycling and making purchases that will give you pleasure."
    ],
    "it": [
      "BROCANTE aperto tutto l'anno, idee per decorare la vostra casa. Acquistare in un mercatino dell'usato significa riciclare e fare acquisti che vi daranno piacere."
    ],
    "fr": [
      "BROCANTE ouverte toute l'année, des idées pour la déco de vos maisons. Acheter en brocante, c'est recycler en faisant des achats qui vous feront plaisir."
    ],
    "nl": [
      "BROCANTE het hele jaar geopend, ideeën om je huis te versieren. Kopen op een rommelmarkt betekent recyclen en aankopen doen waar je plezier aan beleeft."
    ],
    "es": [
      "BROCANTE abierto todo el año, ideas para decorar tu casa. Comprar en un mercadillo significa reciclar y hacer compras que te darán placer."
    ]
