  "rdfs:comment": {
    "de": [
      "Haus aus dem 16. Jahrhundert, das seit seiner Gründung im Besitz derselben Familie ist, schattige Terrasse unter Glyzinien. Küche nach dem Geschmack des Tages auf der Grundlage frischer Produkte. Gourmet-Restaurant und bistronomischer Salon 1534 im Inneren des Restaurants"
    ],
    "en": [
      "XVIth century house belonging to the owners since its creation. Shady terrace under a wisteria. Style of the day cooking based on fresh and regional produce. Specialities : charolais meat and fish."
    ],
    "it": [
      "Casa del XVI secolo di proprietà della stessa famiglia fin dalla sua fondazione, terrazza ombreggiata sotto il glicine. Cucina contemporanea con prodotti freschi. Ristorante gourmet e bistrot lounge 1534 all'interno del ristorante"
    ],
    "fr": [
      "Maison du XVIe siècle appartenant à la même famille depuis sa création, terrasse ombragée sous les glycines. Cuisine au goût du jour à base de produits frais. Restaurant gastronomique et salon 1534 bistronomique à l'intérieur du restaurant"
    ],
    "es": [
      "Casa del siglo XVI propiedad de la misma familia desde su fundación, terraza sombreada bajo las glicinas. Cocina contemporánea con productos frescos. Restaurante gastronómico y bistro lounge 1534 en el interior del restaurante"
    ],
    "nl": [
      "16e-eeuws huis dat sinds de oprichting in handen is van dezelfde familie, schaduwrijk terras onder de blauwe regen. Eigentijdse keuken met verse producten. Gastronomisch restaurant en bistrolounge 1534 in het restaurant"
    ]
  },
