  "rdfs:comment": {
    "de": [
      "Wenn Sie ins Le Cèdre kommen, werden Sie einen Moment der Geselligkeit und des Teilens finden!\r\nIch arbeite täglich daran, Ihnen Gerichte mit Geschmack und besonderen Aromen anzubieten.\r\nAlles ist hausgemacht, wir respektieren die Jahreszeiten."
    ],
    "en": [
      "When you come to Le Cèdre, you'll find that it's all about sharing and conviviality!\r\nI work hard every day to offer you dishes that are full of taste and special flavours.\r\nEverything is homemade, and we respect the seasons."
    ],
    "it": [
      "Quando verrete a Le Cèdre, scoprirete che si tratta di condivisione e convivialità!\r\nMi impegno ogni giorno per offrirvi piatti ricchi di gusto e sapori speciali.\r\nTutto è fatto in casa e rispettiamo le stagioni."
    ],
    "fr": [
      "En venant au Cèdre vous trouverez un moment de convivialité et de partage !\r\nJe travaille au quotidien pour vous proposer des plats qui ont du goût, des saveurs particulières.\r\nTout fait maison, on respecte les saisons."
    ],
    "es": [
      "Cuando venga a Le Cèdre, descubrirá que se trata de compartir y convivir\r\nTrabajo duro cada día para ofrecerle platos llenos de sabor y sabores especiales.\r\nTodo es casero y respetamos las estaciones."
    ],
    "nl": [
      "Als je naar Le Cèdre komt, zul je merken dat het allemaal draait om delen en gezelligheid!\r\nIk werk elke dag hard om je gerechten te bieden die vol smaak en speciale smaken zijn.\r\nAlles is huisgemaakt en we respecteren de seizoenen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cèdre restaurant"
    ],
    "fr": [
      "Le Cèdre"
    ]
  },
