  "rdfs:comment": {
    "de": [
      "Heben Sie ab vom Alltag! Begeben Sie sich an Bord unserer Ballons in einer herzlichen und entspannten Atmosphäre auf ein 3- bis 4-stündiges Abenteuer über die Erhebungen und Täler von Annonay. Flüge im kleinen Kreis in Ballons mit 5 bis maximal 8 Passagieren."
    ],
    "en": [
      "Get away from it all! Climb aboard our balloons in a warm and relaxed atmosphere for a 3 to 4 hour adventure over the hills and valleys of Annonay. Small group flights in balloons with 5 to 8 passengers maximum."
    ],
    "it": [
      "Staccate dalla vita quotidiana! Salite a bordo delle nostre mongolfiere in un'atmosfera calda e rilassata per un'avventura di 3-4 ore sopra le colline e le valli di Annonay. Voli in piccoli gruppi in mongolfiera da 5 a 8 passeggeri al massimo."
    ],
    "fr": [
      "Décollez du quotidien ! Embarquez à bord de nos ballons dans une ambiance chaleureuse et détendue pour une aventure de 3 à 4h au dessus des reliefs et des vallées d'Annonay. Vols en petit comité dans des ballons de 5 à 8 passagers maximum."
    ],
    "es": [
      "¡Despegue de la vida cotidiana! Suba a nuestros globos en un ambiente cálido y relajado para una aventura de 3 a 4 horas sobre las colinas y valles de Annonay. Vuelos en pequeños grupos en globos de 5 a 8 pasajeros como máximo."
    ],
    "nl": [
      "Neem afstand van het dagelijkse leven! Stap in een warme en ontspannen sfeer aan boord van onze ballonnen voor een 3 tot 4 uur durend avontuur over de heuvels en valleien van Annonay. Vluchten in kleine groepen in ballonnen van 5 tot maximaal 8 passagiers."
    ]
  },
