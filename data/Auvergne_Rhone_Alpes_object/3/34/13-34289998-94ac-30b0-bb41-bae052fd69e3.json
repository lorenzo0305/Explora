  "rdfs:comment": {
    "de": [
      "Das Reitzentrum Vieux Moulin befindet sich in der Gemeinde Loire sur Rhône: eine überdachte Reithalle, ein Außenreitplatz, 25 ha Wiesen, 38 Boxen für die Pensionen."
    ],
    "en": [
      "The Vieux Moulin equestrian centre is located in the commune of Loire sur Rhône: a covered arena, an outdoor arena, 25 hectares of meadows, 38 boxes for boarding."
    ],
    "it": [
      "Il centro ippico Vieux Moulin si trova nel comune di Loire sur Rhône: un maneggio coperto, un'arena all'aperto, 25 ettari di prati, 38 box per le pensioni."
    ],
    "fr": [
      "Le centre équestre du Vieux Moulin se trouve sur la commune de Loire sur Rhône: un manège couvert, une carrière extérieure, 25 ha de prés, 38 box pour les pensions."
    ],
    "es": [
      "El centro ecuestre Vieux Moulin está situado en la comuna de Loire sur Rhône: una escuela de equitación cubierta, un picadero exterior, 25 hectáreas de praderas, 38 boxes para pensiones."
    ],
    "nl": [
      "De manege Vieux Moulin ligt in de gemeente Loire sur Rhône: een overdekte manege, een buitenbak, 25 hectare weiland, 38 boxen voor pensioenen."
    ]
  },
