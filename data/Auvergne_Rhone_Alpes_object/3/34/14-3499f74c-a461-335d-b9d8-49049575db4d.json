  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0141a4e7-4b9d-3c3d-bd7c-8d1f010694cc",
      "dc:description": {
        "de": [
          "Sie wurde 1877 von dem hesdinischen Architekten Clovis Normand erbaut. Die Kirche mit Kreuzrippengewölbe, die von einem Turm und einer steinernen Turmspitze gekrönt wird, ist im neogotischen Stil erbaut."
        ],
        "en": [
          "It was built in 1877 by the Hessian architect Clovis Normand. This church, with its ribbed vaulting, topped by a stone tower and spire, is in neo-gothic style."
        ],
        "it": [
          "Fu costruito nel 1877 dall'architetto di Hesden Clovis Normand. Questa chiesa a volta a crociera, sormontata da una torre e da una guglia in pietra, è in stile neogotico."
        ],
        "fr": [
          "Elle est construite en 1877 par l'architecte hesdinois Clovis Normand. Cette église voûtée d'ogives surmontée d'une tour et d'une flèche de pierre, est de style néogothique."
        ],
        "nl": [
          "Het werd in 1877 gebouwd door de Hesdense architect Clovis Normand. Deze kerk met ribgewelven, bekroond door een toren en een stenen spits, is in neogotische stijl."
        ],
        "es": [
          "Fue construido en 1877 por el arquitecto hesdenés Clovis Normand. Esta iglesia con bóveda de crucería, coronada por una torre y una aguja de piedra, es de estilo neogótico."
        ]
      },
      "@type": [
        "Description"
