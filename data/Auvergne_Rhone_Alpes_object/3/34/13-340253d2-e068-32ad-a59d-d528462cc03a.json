  "rdfs:comment": {
    "de": [
      "Am 20. März 2026, von 18:30 bis 19:30 Uhr, lädt Sie die Bibliothek im ersten Stock zu einem Abend im Zeichen der Poesie und des Austauschs anlässlich des Printemps des Poètes 2026 ein."
    ],
    "en": [
      "On March 20, 2026, from 6:30 to 7:30 pm, the library invites you to join us on the 1st floor for an evening of poetry and sharing to celebrate the Printemps des Poètes 2026."
    ],
    "it": [
      "Il 20 marzo 2026, dalle 18.30 alle 19.30, la biblioteca ospiterà al 1° piano una serata di poesia e condivisione in occasione del Printemps des Poètes 2026."
    ],
    "fr": [
      "Le 20 mars 2026, de 18h30 à 19h30, la bibliothèque vous donne rendez-vous au 1er étage pour une soirée placée sous le signe de la poésie et du partage à l’occasion du Printemps des Poètes 2026."
    ],
    "nl": [
      "Op 20 maart 2026, van 18.30 tot 19.30 uur, organiseert de bibliotheek een avond vol poëzie en uitwisseling op de 1e verdieping ter gelegenheid van de Printemps des Poètes 2026."
    ],
    "es": [
      "El 20 de marzo de 2026, de 18.30 a 19.30 h, la biblioteca acogerá en la 1ª planta una velada poética y de intercambio con motivo del Printemps des Poètes 2026."
    ]
  },
  "rdfs:label": {
    "fr": [
      "« Libres paroles », une scène ouverte poétique"
    ]
  },
