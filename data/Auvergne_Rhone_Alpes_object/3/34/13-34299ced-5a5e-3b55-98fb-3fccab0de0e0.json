  "rdfs:comment": {
    "de": [
      "Restaurant, das frische und lokale Produkte aus der Region in den Vordergrund stellt. Cheeseburger, Falafel... Waffeln und handgemachtes Eis am Nachmittag. Am Wasser des Plan des Marins."
    ],
    "en": [
      "Restaurant showcasing fresh local produce. Cheeseburger, homemade chips, falafel, local meat... Waffles and homemade ice creams in the afternoon. At the water's edge of the Plan des Marins."
    ],
    "it": [
      "Un ristorante che presenta prodotti freschi locali. Cheeseburger, patatine fritte, falafel, carni locali? Waffles e gelati artigianali nel pomeriggio. Sulle rive del Plan des Marins."
    ],
    "fr": [
      "Restaurant mettant en avant les produits frais et locaux du territoire. Cheeseburger, frites maison, falafel, viandes locales… Gaufres et glaces artisanales l'après-midi. Au bord de l'eau du plan des Marins."
    ],
    "es": [
      "Un restaurante con productos locales frescos. Hamburguesa con queso, patatas fritas caseras, falafel, carnes locales.. Gofres y helados caseros por la tarde. A orillas del Plan des Marins."
    ],
    "nl": [
      "Een restaurant met verse lokale producten. Cheeseburger, frietjes, falafel, lokale vleeswaren? Wafels en zelfgemaakt ijs in de namiddag. Aan de waterkant van het Plan des Marins."
    ]
  },
  "rdfs:label": {
