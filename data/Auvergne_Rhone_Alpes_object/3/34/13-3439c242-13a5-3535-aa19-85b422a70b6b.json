  "rdfs:comment": {
    "de": [
      "Die Winzer Laura und Camille bewirtschaften 6 ha Weinberge in Valvignères. Umstellung auf biologische Landwirtschaft. Natürliche Weine. Bei uns führt die Traube den Tanz an, und wir begleiten sie."
    ],
    "en": [
      "Laura and Camille, winegrowers, cultivate 6 ha of vines in Valvignères. Conversion to organic farming. Natural wines. With us, it's the grapes that lead the dance, and we go with them."
    ],
    "it": [
      "Laura e Camille, viticoltrici, coltivano 6 ettari di vigneto a Valvignères. Conversione all'agricoltura biologica. Vini naturali. Da noi è l'uva a fare da padrona e noi la seguiamo."
    ],
    "fr": [
      "Laura et Camille, vignerons cultivent  6 ha de vignes à Valvignères. Conversion vers l'agriculture bio. Vins naturels. Chez nous, c’est le raisin qui mène la danse, et nous, on l’accompagne."
    ],
    "es": [
      "Laura y Camille, viticultoras, cultivan 6 ha de viñedo en Valvignères. Reconversión a la agricultura ecológica. Vinos naturales. Con nosotros, son las uvas las que marcan el camino, y nosotros vamos con ellas."
    ],
    "nl": [
      "Laura en Camille, wijnbouwers, cultiveren 6 ha wijngaarden in Valvignères. Omschakeling naar biologische landbouw. Natuurlijke wijnen. Bij ons zijn het de druiven die de weg wijzen en wij gaan met hen mee."
    ]
  },
