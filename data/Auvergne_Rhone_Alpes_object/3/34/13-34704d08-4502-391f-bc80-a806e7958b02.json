  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Natur und das historische Erbe mit unserer Mountainbike-Runde durch die Weinberge und Obstgärten von der Rhône bis zum Plateau der Ardèche.\r\nZu entdecken in der App MHIKES."
    ],
    "en": [
      "Discover nature and historical heritage with our mountain bike loop through vineyards and orchards from the Rhône to the Ardèche plateau.\r\nDiscover it on the MHIKES app."
    ],
    "it": [
      "Scoprite la natura e il patrimonio storico con il nostro itinerario in mountain bike attraverso vigneti e frutteti dal Rodano all'altopiano dell'Ardèche.\r\nScopritelo sull'app MHIKES."
    ],
    "fr": [
      "Partez à la découverte de la nature et du patrimoine historique avec notre boucle VTT à travers les vignobles et vergers du Rhône au plateau ardéchois. \r\nA découvrir dans l'application MHIKES."
    ],
    "nl": [
      "Ontdek de natuur en het historische erfgoed met onze mountainbikeroute door wijngaarden en boomgaarden van de Rhône tot het plateau van de Ardèche.\r\nOntdek het op de MHIKES app."
    ],
    "es": [
      "Descubra la naturaleza y el patrimonio histórico con nuestro bucle en bicicleta de montaña a través de viñedos y huertos desde el Ródano hasta la meseta de Ardèche.\r\nDescúbrelo en la aplicación MHIKES."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Du Rhône aux coteaux du saint joseph"
    ]
  },
