  "rdfs:comment": {
    "de": [
      "Vor Ort gibt es einen kleinen Markt, auf dem Sie Biogemüse der Saison sowie Setzlinge von Bäumen, Blumen und Gemüse je nach Jahreszeit kaufen können."
    ],
    "en": [
      "A small market is open on the spot to propose you the organic vegetables of season as well as plants of trees, flowers, vegetables according to the seasons."
    ],
    "it": [
      "Un piccolo mercato è aperto sul posto per offrirvi verdure biologiche di stagione e piante arboree, fiori e ortaggi a seconda delle stagioni."
    ],
    "fr": [
      "Un petit marché est ouvert sur place pour vous proposer les légumes bio de saison ainsi que des plants d'arbres, fleurs, légumes en fonction des saisons."
    ],
    "es": [
      "Un pequeño mercado está abierto en el lugar para ofrecerle verduras orgánicas de temporada, así como plantas de árboles, flores y verduras según las estaciones."
    ],
    "nl": [
      "Ter plaatse is een kleine markt geopend om u biologische groenten in het seizoen aan te bieden, evenals boomplanten, bloemen, groenten volgens de seizoenen."
    ]
  },
