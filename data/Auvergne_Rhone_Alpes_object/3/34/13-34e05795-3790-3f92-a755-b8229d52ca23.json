  "rdfs:comment": {
    "de": [
      "Freizeitverein für alleinstehende Personen. Sich zusammenschließen, um an festlichen (Kino, Tanzessen, Diskothek...), sportlichen (Wandern, Walking, Radfahren...) oder kulturellen (Konferenz, Theater, Besichtigungen...) Ausflügen teilzunehmen."
    ],
    "en": [
      "Leisure association for single people. Get together to take part in festive outings (cinema, dinner dance, disco...), sports (walking, hiking, cycling...) or cultural outings (conference, theater, visits...)."
    ],
    "it": [
      "Associazione per il tempo libero per persone sole. Riunione per partecipare a uscite festive (cinema, cena danzante, discoteca...), sportive (passeggiate, escursioni, ciclismo...) o culturali (conferenze, teatro, visite...)."
    ],
    "fr": [
      "Association de loisirs pour personnes seules. Se regrouper pour participer à des sorties festives (cinéma, repas dansant, discothèque...), sportives (marche, rando, vélo...) ou culturelles (conférence, théâtre, visites...)."
    ],
    "nl": [
      "Vrijetijdsvereniging voor alleenstaanden. Kom samen om deel te nemen aan feestelijke uitjes (bioscoop, diners, disco's, enz.), sportieve activiteiten (wandelen, hiken, fietsen, enz.) of culturele evenementen (conferenties, theater, bezoeken, enz.)."
    ],
    "es": [
      "Asociación de ocio para solteros. Reunirse para participar en salidas festivas (cine, cena-baile, discoteca...), deportivas (paseo, senderismo, bicicleta...) o culturales (conferencia, teatro, visitas...)."
    ]
  },
  "rdfs:label": {
