  "rdfs:comment": {
    "de": [
      "Alle Techniken des Zeichnens und Malens, Modellieren von Statuen, Porträts. Anfänger, Fortgeschrittene und auch kreative Praktika, Vorbereitung auf die Kunsthochschule ab 15 Jahren (15 Erfolge in 20 Jahren). Ort der Aktivität: Raum 102 - Espace Rabelais."
    ],
    "en": [
      "All drawing and painting techniques, statuary modeling, portraiture. Introductory, advanced and creative courses, preparation for the Beaux Arts from age 15 (15 successes in 20 years). Location: room 102 - Espace Rabelais."
    ],
    "it": [
      "Tutte le tecniche di disegno e pittura, modellazione statuaria, ritrattistica. Corsi di iniziazione, perfezionamento e anche creazione, preparazione alle belle arti a partire dai 15 anni (15 successi noti in 20 anni). Ubicazione: sala 102 - Espace Rabelais."
    ],
    "fr": [
      "Toutes techniques de dessin et peinture, modelage statuaire, portrait. Initiation,  perfectionnement et aussi des stages de création, préparation aux beaux arts à partir de 15 ans (15 succès connus en 20 ans). Lieu d'activité: salle 102 - Espace Rabelais."
    ],
    "es": [
      "Todas las técnicas de dibujo y pintura, modelado de estatuas, retrato. Cursos de iniciación, perfeccionamiento y también de creación, preparación a las bellas artes a partir de los 15 años (15 éxitos conocidos en 20 años). Ubicación: sala 102 - Espace Rabelais."
    ],
    "nl": [
      "Alle teken- en schildertechnieken, beeldboetseren, portretschilderen. Inleidende en gevorderde cursussen, evenals creatieve workshops en voorbereiding op de Beaux Arts vanaf 15 jaar (15 successen in 20 jaar). Plaats van de activiteit: zaal 102 - Espace Rabelais."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier peinture et nature"
    ]
  },
