  "rdfs:comment": {
    "de": [
      "Jahrhundert im gotischen Stil Burgunds errichtet. Das Vorchor, das Kirchenschiff und die Seitenschiffe wurden zwischen dem 14. und 16. Das mehrfarbige geschnitzte Holzgestühl aus dem 15. Jahrhundert ist ein Hauptwerk, das Heilige und Apostel darstellt."
    ],
    "en": [
      "Built in the 13th century in Burgundian Gothic style. The forechoir, nave and aisles were built between the 14th and 16th centuries. The 15th-century polychrome carved wooden stalls are a major work of art, featuring saints and apostles."
    ],
    "it": [
      "Costruita nel XIII secolo in stile gotico borgognone. L'avancorpo, la navata centrale e le navate laterali furono costruite tra il XIV e il XVI secolo. Gli stalli del coro in legno intagliato policromo, risalenti al XV secolo, sono un'importante opera d'arte con santi e apostoli."
    ],
    "fr": [
      "Edifiée au XIIIème dans un style gothique bourguignon. L'avant-chœur, la nef et les bas-côtés furent bâtis du XIVe au XVIe siècle. Les stalles en bois sculptées polychromes du XVème sont une œuvre majeure présentant saints et apôtres."
    ],
    "nl": [
      "Gebouwd in de 13e eeuw in Bourgondische gotische stijl. Het voorportaal, het schip en de zijbeuken werden gebouwd tussen de 14e en 16e eeuw. Het polychroom bewerkte houten koorgestoelte uit de 15e eeuw is een belangrijk kunstwerk met heiligen en apostelen."
    ],
    "es": [
      "Construida en el siglo XIII en estilo gótico borgoñón. El coro, la nave y las naves laterales se construyeron entre los siglos XIV y XVI. La sillería del coro, de madera tallada y policromada, data del siglo XV y es una importante obra de arte en la que aparecen santos y apóstoles."
    ]
  },
