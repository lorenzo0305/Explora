  "rdfs:comment": {
    "de": [
      "Willkommen bei La Table du Brasseur, unserer traditionellen und unabhängigen Brauerei. Wir lassen den Geist und das Know-how authentischer und handwerklich arbeitender Brauereien wieder aufleben."
    ],
    "en": [
      "Welcome to the Table du Brasseur, our traditional, independent brasserie. We have revived the spirit and know-how of the authentic French brasserie."
    ],
    "it": [
      "Benvenuti a La Table du Brasseur, la nostra birreria tradizionale e indipendente. Riportiamo in vita lo spirito e il know-how dei birrifici autentici e artigianali."
    ],
    "fr": [
      "Bienvenue à la Table du Brasseur, notre brasserie traditionnelle et indépendante. Nous faisons revivre l'esprit et le savoir-faire des brasseries authentiques et artisanales."
    ],
    "nl": [
      "Welkom bij La Table du Brasseur, onze ambachtelijke en onafhankelijke brouwerij. Wij brengen de geest en de knowhow van de authentieke en ambachtelijke brouwerijen weer tot leven."
    ],
    "es": [
      "Bienvenido a La Table du Brasseur, nuestra cervecería tradicional e independiente. Resucitamos el espíritu y el saber hacer de las cervecerías auténticas y artesanales."
    ]
  },
