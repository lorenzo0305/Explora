  "rdfs:comment": {
    "de": [
      "Produktion von Rot-, Weiß- und Roséwein aus biologischem Anbau. Zögern Sie nicht, die prächtige Umgebung der Weinberge des Trièves zu genießen.  Der Empfang im Weinkeller von Prébois ist nur auf Reservierung möglich."
    ],
    "en": [
      "Organic production of red, white and rosé wines. Don't hesitate to come and enjoy the sumptuous setting of the vineyards via the \"boucle des vignes\" trail in the Carto guide du Trièves. Reception at the Prébois winery by reservation only."
    ],
    "it": [
      "Produzione di vini biologici rossi, bianchi e rosati. Venite a godervi la sontuosa cornice dei vigneti di Trièves.  Ricevimento presso la cantina Prébois su prenotazione."
    ],
    "fr": [
      "Production de vin rouge, blanc et rosé en agriculture biologique. N’hésitez pas à venir profiter du cadre somptueux des vignes du Trièves.  Accueil à la cave de Prébois sur réservation uniquement."
    ],
    "nl": [
      "Productie van rode, witte en rosé biologische wijnen. Kom genieten van de weelderige omgeving van de wijngaarden van Trièves.  Ontvangst in de Prébois-kelder alleen op reservering."
    ],
    "es": [
      "Producción de vinos ecológicos tintos, blancos y rosados. Venga a disfrutar del suntuoso marco de los viñedos de Trièves.  Recepción en la bodega de Prébois con reserva previa."
    ]
  },
  "rdfs:label": {
