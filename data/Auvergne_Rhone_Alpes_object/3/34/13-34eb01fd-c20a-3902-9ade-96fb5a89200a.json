  "rdfs:comment": {
    "de": [
      "Jahrhundert charakteristisches Stadthotel der Renaissance. Seine Straßenfassade ist wegen ihrer Anspielungen auf die antike Architektur als historisches Denkmal eingestuft."
    ],
    "en": [
      "Built in the 16th century in a Renaissance style. The facade is registered as Historic Monument due to its Antiquity architecture style."
    ],
    "it": [
      "Casa di città del XVI secolo, tipica del periodo rinascimentale, la sua facciata su strada è classificata come monumento storico per i suoi riferimenti all'architettura antica."
    ],
    "fr": [
      "Hôtel urbain du XVIe siècle caractéristique de la Renaissance, il présente une façade sur rue classée à l'inventaire des monuments historiques pour ses références à l'architecture antique."
    ],
    "nl": [
      "Het is een 16e-eeuws herenhuis dat typisch is voor de renaissanceperiode. De straatgevel staat op de monumentenlijst vanwege de verwijzingen naar oude architectuur."
    ],
    "es": [
      "Casa urbana del siglo XVI típica de la época renacentista, su fachada callejera está catalogada como monumento histórico por sus referencias a la arquitectura antigua."
    ]
  },
