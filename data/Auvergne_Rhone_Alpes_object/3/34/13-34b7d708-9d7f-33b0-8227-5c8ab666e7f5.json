  "rdfs:comment": {
    "de": [
      "St-Thibaud sowie St-Côme und St-Damien geweiht. Es gibt etwa 120 Kapitelle und Basen (die Schnitzerei der Basen ist eine lokale Besonderheit) mit Laubwerk, zoomorphem und anthropomorphem Dekor."
    ],
    "en": [
      "from the 11th and 12th centuries."
    ],
    "it": [
      "Dedicati a St-Thibaud, St-Côme e St-Damien, sono circa 120 tra capitelli e basi (l'intaglio delle basi è una caratteristica locale) con decorazioni a fogliame, zoomorfe e antropomorfe."
    ],
    "fr": [
      "Dédiée à St-Thibaud ainsi qu'à St-Côme et St-Damien, on compte environ 120 chapiteaux et bases (sculpture des bases étant une particularité locale) avec feuillages, décors zoomorphiques et anthropomorphiques."
    ],
    "nl": [
      "Gewijd aan St-Thibaud en St-Côme en St-Damien, zijn er ongeveer 120 kapitelen en basementen (het snijwerk van de basementen is een lokaal kenmerk) met lofwerk, zoömorfe en antropomorfe versieringen."
    ],
    "es": [
      "Dedicados a St-Thibaud, así como a St-Côme y St-Damien, hay unos 120 capiteles y basas (la talla de las basas es una característica local) con decoraciones foliadas, zoomorfas y antropomorfas."
    ]
  },
  "rdfs:label": {
    "en": [
      "St Thibaud’s church"
    ],
    "fr": [
