  "rdfs:comment": {
    "de": [
      "Das Museum, das in einem befestigten Haus aus dem 15. Jahrhundert untergebracht ist (im Inventar der historischen Monumente aufgeführt), ermöglicht es, den Alltag der Familie Durand nachzuempfinden, die nach der Aufhebung des Edikts von Nantes (1685) für die Gewissensfreiheit kämpfte."
    ],
    "en": [
      "The museum, housed in a 15th-century fortified house (classified as a Historic Monument), lets visitors relive the daily life of the Durand family as they fought for freedom of conscience after the revocation of the Edict of Nantes (1685)."
    ],
    "it": [
      "Il museo, ospitato in una casa fortificata del XV secolo (classificata come Monumento Storico), permette ai visitatori di rivivere la vita quotidiana della famiglia Durand che lottava per la libertà di coscienza dopo la revoca dell'Editto di Nantes (1685)."
    ],
    "fr": [
      "Le musée, aménagé dans une maison fortifiée du XVe siècle (classée à l'Inventaire des Monuments Historiques), permet de revivre le quotidien de la famille Durand luttant pour la liberté de conscience après la révocation de l'Édit de Nantes (1685)."
    ],
    "nl": [
      "Het museum is gevestigd in een 15e-eeuws versterkt huis (geklasseerd als Historisch Monument) en laat bezoekers het dagelijkse leven van de familie Durand herbeleven toen ze vochten voor gewetensvrijheid na de herroeping van het Edict van Nantes (1685)."
    ],
    "es": [
      "El museo, instalado en una casa fortificada del siglo XV (declarada Monumento Histórico), permite revivir la vida cotidiana de la familia Durand en su lucha por la libertad de conciencia tras la revocación del Edicto de Nantes (1685)."
    ]
  },
