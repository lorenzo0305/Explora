  "rdfs:comment": {
    "de": [
      "Einfallsreiche, saisonale und traditionsbewusste Küche mit savoyischen Spezialitäten im Bergambiente mit einem großen zentralen Kamin aus Kupfer und weißem Holz."
    ],
    "en": [
      "A white wood chalet with a large central copper fireplace, open every day from 19:00.\r\nOn the menu: a choice of seasonal dishes and regional specialties."
    ],
    "it": [
      "cucina creativa, stagionale e rispettosa delle tradizioni con specialità savoiarde, in un’atmosfera di montagna con un grande camino centrale in rame e legno bianco."
    ],
    "fr": [
      "Cuisine inventive, de saison et respectant les traditions avec ses spécialités savoyardes, dans l'ambiance de montagne avec une grande cheminée centrale de cuivre et de bois blanc."
    ],
    "nl": [
      "Inventieve, seizoensgebonden en traditionele keuken met Savoyaardse specialiteiten, in een bergsfeer met een grote centrale koperen en wit houten open haard."
    ],
    "es": [
      "Cocina inventiva, de temporada y tradicional con especialidades de Saboya, en un ambiente de montaña con una gran chimenea central de cobre y madera blanca."
    ]
  },
