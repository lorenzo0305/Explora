  "rdfs:comment": {
    "de": [
      "Martine und David sind Bio-Gemüsebauern. Sie bieten pflanzliche Küche in Dosen und frisch zubereitet an.\r\nWährend der Sommersaison (Juni bis September) entdecken Sie die Aperitif-Dinner am Freitagabend im Gewächshaus."
    ],
    "en": [
      "Martine and David are organic market gardeners. They offer fresh and canned vegetable dishes.\r\nDuring the summer season (June to September), enjoy Friday evening aperitif dinners in the greenhouse."
    ],
    "it": [
      "Martine e David sono ortolani biologici. Offrono piatti a base di verdure fresche e conservate.\r\nDurante la stagione estiva (da giugno a settembre), provate le cene-aperitivo del venerdì sera nella serra."
    ],
    "fr": [
      "Martine et David sont maraichers bio. Ils proposent de la cuisine végétale en conserve et en frais.\r\nPendant la saison estivale (juin à septembre), découvrez les apéritifs dînatoires du vendredi soir sous la serre."
    ],
    "es": [
      "Martine y David son horticultores ecológicos. Ofrecen platos de verduras frescas y en conserva.\r\nDurante la temporada de verano (de junio a septiembre), pruebe sus cenas de aperitivo los viernes por la noche en el invernadero."
    ],
    "nl": [
      "Martine en David zijn biologische tuinders. Ze bieden verse en ingemaakte groentegerechten.\r\nProbeer tijdens het zomerseizoen (juni tot september) hun aperitiefdiners op vrijdagavond in de serre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les petits pois sont rouges"
    ]
  },
