  "rdfs:comment": {
    "de": [
      "Entspannungs- und Wellness-Salon, der sich der Entspannung widmet, in Avesnes-le-Comte. Ambiance Détente empfängt Sie in seinem Schönheits- und Entspannungsbereich Spa und bietet Ihnen Hammam, Jacuzzi und Modellage der Welt."
    ],
    "en": [
      "Relaxation and well-being salon in Avesnes-le-Comte. Ambiance Détente welcomes you to its beauty and relaxation spa and offers hammam, jacuzzi and world massage."
    ],
    "it": [
      "Salone dedicato al relax e al benessere ad Avesnes-le-Comte. Ambiance Détente vi accoglie nella sua spa di bellezza e relax e offre hammam, jacuzzi e modellazione mondiale."
    ],
    "fr": [
      "Salon de détente et de bien-être dédié à la relaxation à Avesnes-le-Comte. Ambiance Détente vous accueille dans son espace espace beauté et détente spa et vous propose hammam, jacuzzi et modelage du monde."
    ],
    "es": [
      "Salón de relajación y bienestar dedicado al descanso en Avesnes-le-Comte. Ambiance Détente le da la bienvenida a su spa de belleza y relajación y ofrece hammam, jacuzzi y modelado mundo."
    ],
    "nl": [
      "Ontspannings- en welzijnssalon gewijd aan ontspanning in Avesnes-le-Comte. Ambiance Détente verwelkomt je in zijn schoonheids- en ontspanningsspa en biedt hammam, jacuzzi en wereldmodellering."
    ]
  },
