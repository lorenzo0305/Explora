  "rdfs:comment": {
    "de": [
      "Besuchen Sie die letzte Festung des Avant Pays Savoyard, ein wahres Festungsmuseum! Schlendern Sie mit Ihrer Familie durch die möblierten Räume und entdecken Sie die beeindruckenden Sammlungen von Militärarchäologie, Velozipeden, Paläontologie und Keramik"
    ],
    "en": [
      "The Château de Montfleury which architecture was modified a couple of times through centuries, is the last fortified place in the Avant-Pays Savoyard - foreland of Savoie."
    ],
    "it": [
      "Il castello di Montfleury, molto rimaneggiato nel corso dei secoli, è l'ultima piazzaforte della zona pedemontana savoiarda. Fa parte della rete di siti che consente di visitare dei luoghi culturali a tariffe preferenziali sin dalla seconda visita."
    ],
    "fr": [
      "Visitez la dernière place forte de l'Avant Pays Savoyard, véritable musée-forteresse ! En famille, déambulez dans ses pièces meublées à la découverte des collections impressionnantes d'archéologie militaire, de vélocipèdes, de paléontologie, de céramique"
    ],
    "es": [
      "Visite el último baluarte de la región de Avant Pays Savoyard, ¡un auténtico museo-fortaleza! Pasee con toda la familia por sus salas amuebladas y descubra sus impresionantes colecciones de arqueología militar, velocípedos, paleontología, cerámica, etc"
    ],
    "nl": [
      "Een kasteel gered van zijn ondergang - Het kasteel van Montfleury heeft de aanvallen van de oorlog en de tijd doorstaan. Het oudste gedeelte, de Saraceense toren, dateert uit de XIIIe eeuw. Het kasteel werd door de eeuwen heen verbouwd en vergroot. Het kasteel deed vervolgens dienst als zomerkamp en verkeerde in zeer slechte staat toen Marc Prière en zijn echtgenote het in 1972 ontdekten en besloten het te restaureren."
    ]
  },
