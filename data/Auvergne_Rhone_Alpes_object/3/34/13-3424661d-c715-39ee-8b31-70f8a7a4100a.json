  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses Bergrestaurant im Herzen des Skigebiets mit einer sehr großen Terrasse und einer außergewöhnlichen Aussicht. Leichter Zugang vom Sessellift Lune Bleue zu Fuß oder auf Skiern."
    ],
    "en": [
      "Discover our mountain restaurant, located in the heart of the ski area , with a very large terrace and exceptional scenery. Easy access from the Lune Bleue chairlift pedestrian or skis."
    ],
    "it": [
      "Scoprite questo ristorante d'alta quota, situato nel cuore del comprensorio sciistico, con una terrazza molto ampia e una vista eccezionale. Facile accesso dalla seggiovia Lune Bleue a piedi o con gli sci."
    ],
    "fr": [
      "Découvrez ce restaurant d'altitude, situé au cœur du domaine skiable, avec une très grande terrasse et une vue exceptionnelle. Accès facile du télésiège Lune Bleue en piéton ou à skis."
    ],
    "nl": [
      "Ontdek dit restaurant in de bergen, gelegen in het hartje van het skigebied, met een zeer groot terras en een uitzonderlijk mooi uitzicht. Gemakkelijk te bereiken, als voetganger of met uw ski’s, vanaf de stoeltjeslift Lune Bleue."
    ],
    "es": [
      "Descubra este restaurante de altura, situado en el corazón de la zona de esquí, con una amplísima terraza y una vista excepcional. Fácil acceso desde el telesilla Lune Bleue a pie o con esquís."
    ]
  },
