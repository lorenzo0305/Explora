  "rdfs:comment": {
    "de": [
      "Das moderne interkommunale Schwimmbad Balcons du Dauphiné in der Nähe des Stadtzentrums von Morestel umfasst ein Becken mit verstellbarer Höhe und ein Planschbecken."
    ],
    "en": [
      "The Balcons du Dauphiné intercommunal swimming pool is a modern facility located close to Morestel town centre, with an adjustable-height pool and a paddling pool."
    ],
    "it": [
      "La piscina intercomunale Balcons du Dauphiné è un impianto moderno situato vicino al centro di Morestel, con una vasca ad altezza regolabile e una vasca per bambini."
    ],
    "fr": [
      "La piscine intercommunale des Balcons du Dauphiné, moderne et située à proximité du centre-ville de Morestel, comprend un bassin à hauteur modulable et une pataugeoire."
    ],
    "es": [
      "La piscina intermunicipal Balcons du Dauphiné es una instalación moderna situada cerca del centro de Morestel, con una piscina de altura regulable y una piscina infantil."
    ],
    "nl": [
      "Het intercommunale zwembad van de Balcons du Dauphiné is een modern gebouw in de buurt van het centrum van Morestel, met een zwembad met regelbare hoogte en een peuterbad."
    ]
  },
  "rdfs:label": {
    "en": [
