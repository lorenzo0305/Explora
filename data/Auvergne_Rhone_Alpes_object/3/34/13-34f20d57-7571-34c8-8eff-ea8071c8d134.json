  "rdfs:comment": {
    "de": [
      "Das Reitzentrum Longchamp wird von einem jungen Paar, Yohanna und Jean Philippe Aillaud, geleitet und bietet eine ganze Reihe von Aktivitäten, die vom Unterricht über Dressur, Hindernisreiten und Baumklettern bis hin zu Ausritten reichen."
    ],
    "en": [
      "Held by a young couple of state-certified instructors, Yohanna and Jean Philippe Aillaud, the equestrian center of Longchamp, offers a whole range of activities ranging from teaching to strolling through dressage, obstacle and the accrobatie."
    ],
    "it": [
      "Gestito da una giovane coppia di istruttori qualificati, Yohanna e Jean Philippe Aillaud, il centro equestre di Longchamp offre un'ampia gamma di attività, dall'insegnamento al trail riding, passando per dressage, salto e accrobatie."
    ],
    "fr": [
      "Tenu par un jeune de couple de moniteurs diplômés d'état, Yohanna et Jean Philippe Aillaud, le centre équestre de Longchamp, propose tout un éventail d'activités allant de l'enseignement à la balade en passant par le dressage, l'obstacle et l'accrobatie."
    ],
    "es": [
      "Dirigido por una joven pareja de monitores titulados por el Estado, Yohanna y Jean Philippe Aillaud, el centro ecuestre de Longchamp ofrece toda una gama de actividades, desde la enseñanza a la equitación de pista, pasando por la doma clásica, los saltos y las acrobacias."
    ],
    "nl": [
      "De manege in Longchamp wordt gerund door een jong stel gediplomeerde instructeurs, Yohanna en Jean Philippe Aillaud, en biedt een heel scala aan activiteiten, van lesgeven tot trail riding, waaronder dressuur, springen en accrobatie."
    ]
  },
  "rdfs:label": {
