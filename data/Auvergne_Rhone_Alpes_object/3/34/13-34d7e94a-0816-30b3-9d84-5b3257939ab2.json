  "rdfs:comment": {
    "de": [
      "Vertige ist ein Höhenrestaurant, in dem wir eine bistronomische und lokale Küche anbieten. Hier finden Sie eine herzliche und gesellige Atmosphäre. Treffen Sie sich mit Freunden oder der Familie nach einem Tag auf den Pisten. Die Fortsetzung...macht schwindelig."
    ],
    "en": [
      "Vertige is a high-altitude restaurant serving bistronomic and local cuisine. The atmosphere is warm and friendly. Get together with friends or family after a day on the slopes. The rest...makes you dizzy."
    ],
    "it": [
      "Il Vertige è un ristorante d'alta quota che serve cucina bistronomica e locale. L'atmosfera è calda e accogliente. Riunitevi con gli amici o la famiglia dopo una giornata sulle piste. Il resto... dà le vertigini."
    ],
    "fr": [
      "Vertige est un restaurant d’altitude où nous proposons une cuisine bistronomique et locale. Vous y retrouverez une ambiance chaleureuse et conviviale. Retrouvez-vous entre amis, en famille, après une journée sur les pistes. La suite...donne le vertige."
    ],
    "nl": [
      "Vertige is een hooggelegen restaurant dat bistronomische en lokale gerechten serveert. De sfeer is warm en vriendelijk. Kom samen met vrienden of familie na een dag op de piste. De rest... maakt je duizelig."
    ],
    "es": [
      "Vertige es un restaurante de altura que sirve cocina bistronómica y local. El ambiente es cálido y acogedor. Reúnase con los amigos o la familia después de un día en las pistas. El resto... da vértigo."
    ]
  },
