  "rdfs:comment": {
    "de": [
      "La Buiscyclette ist mehr als ein Verleih und bietet Ihnen schlüsselfertige Touren, um die Baronnies mit Elektro- oder klassischen Fahrrädern zu entdecken."
    ],
    "en": [
      "Bike rental"
    ],
    "it": [
      "Più che un negozio di biciclette, La Buiscyclette offre tour \"chiavi in mano\" delle Baronnies su biciclette elettriche e classiche."
    ],
    "fr": [
      "Plus qu'un  magasin de vélo, La Buiscyclette vous propose des circuits clés en main pour découvrir les Baronnies en vélo électrique et classique."
    ],
    "es": [
      "Más que una tienda de bicicletas, La Buiscyclette ofrece recorridos llave en mano por las Baronnies en bicicletas eléctricas y clásicas."
    ],
    "nl": [
      "La Buiscyclette is meer dan enkel een verhuurdienst en biedt u kant-en-klare tochten om de Baronnieste ontdekken, per elektrische of klassieke fiets."
    ]
  },
