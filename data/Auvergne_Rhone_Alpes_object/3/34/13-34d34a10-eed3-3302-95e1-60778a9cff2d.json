  "rdfs:comment": {
    "de": [
      "Das Musée Lumière ist dem Kinematographen und der Geschichte der Familie Lumière gewidmet. Es befasst sich mit den verschiedenen technischen Kreationen von Louis und Auguste Lumière. Die Besucher können einzigartige Objekte wie den allerersten Cinématographen entdecken!"
    ],
    "en": [
      "Dedicated to the Cinématographe and the history of the Lumière family, the Musée Lumière looks back at the various technical creations of Louis and Auguste Lumière. Visitors can discover unique objects such as the very first Cinématographe!"
    ],
    "it": [
      "Dedicato al Cinématographe e alla storia della famiglia Lumière, il Musée Lumière ripercorre le varie creazioni tecniche di Louis e Auguste Lumière. I visitatori possono scoprire oggetti unici come il primo Cinématographe!"
    ],
    "fr": [
      "Dédié au Cinématographe et à l’histoire de la famille Lumière, le Musée Lumière revient sur les différentes créations techniques de Louis et Auguste Lumière. Les visiteurs peuvent découvrir des objets uniques tels que le tout premier Cinématographe !"
    ],
    "nl": [
      "Het Musée Lumière is gewijd aan de Cinématographe en de geschiedenis van de familie Lumière en blikt terug op de verschillende technische creaties van Louis en Auguste Lumière. Bezoekers kunnen unieke voorwerpen ontdekken zoals de allereerste Cinématographe!"
    ],
    "es": [
      "Dedicado al Cinematógrafo y a la historia de la familia Lumière, el Museo Lumière repasa las distintas creaciones técnicas de Louis y Auguste Lumière. Los visitantes podrán descubrir objetos únicos, como el primer Cinematógrafo"
    ]
  },
