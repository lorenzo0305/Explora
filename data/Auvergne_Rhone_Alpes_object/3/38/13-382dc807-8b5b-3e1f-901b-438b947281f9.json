  "rdfs:comment": {
    "de": [
      "Squash & Bloc eine Halle, die dem Indoor-Sport gewidmet ist, im Herzen des Skigebiets. \r\nSquashschläger und -bälle können direkt vor Ort gemietet werden."
    ],
    "en": [
      "Squash & Bloc is a room dedicated to indoor sports in the heart of the resort. \r\nRackets & squash balls are available for rent directly on site."
    ],
    "it": [
      "Squash & Bloc è un palazzetto dello sport al coperto nel cuore del resort.\r\nÈ possibile noleggiare racchette e palline da squash direttamente in loco."
    ],
    "fr": [
      "Squash & Bloc une salle dédiée aux sports Indoor en plein cœur de la station. \r\nPossibilité de location de raquettes & balles de squash directement sur place."
    ],
    "es": [
      "Squash & Bloc, una sala de deportes cubierta en el corazón de la estación.\r\nPuede alquilar raquetas y pelotas de squash directamente in situ."
    ],
    "nl": [
      "Squash & Bloc is een zaal gewijd aan indoorsporten in het hart van het resort. \r\nMogelijkheid tot het huren van sneeuwschoenen en squashballen direct op het terrein."
    ]
  },
