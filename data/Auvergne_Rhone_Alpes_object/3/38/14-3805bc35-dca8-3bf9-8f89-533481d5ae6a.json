      "dc:description": {
        "de": [
          "Entdecken oder wiederentdecken Sie diese gesellige Strecke rund um den Espace François Mitterrand, über den Lac du bord des eaux bis hin zur Umgebung der Halde Pommiers!"
        ],
        "en": [
          "Come and discover or rediscover this friendly trail around the Espace François Mitterrand, passing by the waterside lake to the edge of the Pommiers slag heap!"
        ],
        "it": [
          "Venite a scoprire o a riscoprire questo simpatico percorso intorno all'Espace François Mitterrand, con il lago d'acqua e il cumulo di scorie di Pommiers!"
        ],
        "fr": [
          "Venez découvrir ou redécouvrir ce parcours convivial autour de l’Espace François Mitterrand, en passant par le lac du bord des eaux jusqu’aux abords du terril des Pommiers !"
        ],
        "es": [
          "Venga a descubrir o redescubrir este agradable sendero alrededor del Espacio François Mitterrand, pasando por el lago y el escorial de Pommiers"
        ],
        "nl": [
          "Kom en ontdek of herontdek dit gezellige parcours rond het Espace François Mitterrand, langs het meer aan het water en de terril van Pommiers!"
        ]
      },
