  "rdfs:comment": {
    "de": [
      "Ob Anfänger oder Experte, entdecken Sie den Snowpark der Spiele!\r\nVom Family Park, der aus einigen Boxen und Woops besteht, bis zum XXL-Expertenpark können Sie sich auf Ihrem Niveau in einem Park vergnügen, der morgens und abends von unseren Teams perfekt gepflegt wird!"
    ],
    "en": [
      "Discover our Snowpark zones! Strong sensations guaranteed!"
    ],
    "it": [
      "Che siate principianti o esperti, venite a scoprire lo Snowpark des Jeux!\r\nDal parco per famiglie con qualche box e woops al parco per esperti XXL, godetevi il parco al vostro livello, perfettamente curato dai nostri team ogni mattina e sera!"
    ],
    "fr": [
      "Débutants ou experts, venez découvrir le Snowpark des Jeux !\r\nDu family Park composé de quelques box et woops au park expert XXL, régalez vous à votre niveau sur un park parfaitement entretenu par nos équipes matins et soirs!"
    ],
    "es": [
      "Ya seas principiante o experto, ¡ven a descubrir el Snowpark des Jeux!\r\nDesde el parque familiar con algunos cajones y woops hasta el parque XXL para expertos, disfrute del parque a su nivel, perfectamente mantenido por nuestros equipos cada mañana y cada tarde"
    ],
    "nl": [
      "Ontdek onze Snowpark-zones! Sterke sensaties gegarandeerd!"
    ]
  },
