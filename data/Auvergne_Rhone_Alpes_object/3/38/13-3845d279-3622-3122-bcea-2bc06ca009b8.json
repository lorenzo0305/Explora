  "rdfs:comment": {
    "de": [
      "Aufzucht und Herstellung von Ziegenkäse. Sie können unsere Produkte auf verschiedenen Märkten und auch jeden Abend von 18 bis 19 Uhr auf dem Bauernhof finden. Besichtigung des Ziegenhofs donnerstags abends um 18 Uhr während der Schulferien nach vorheriger Anmeldung."
    ],
    "en": [
      "Goat breeding and cheese production. You can find our products at various markets and also at the farm every evening from 6pm to 7pm. Visits to the goat farm on Thursday evenings at 6pm during school vacations by prior arrangement."
    ],
    "it": [
      "Allevamento e produzione di formaggi di capra. Potete trovare i nostri prodotti in vari mercati e anche in fattoria ogni sera dalle 18.00 alle 19.00. Visite all'allevamento di capre il giovedì sera alle 18.00 durante le vacanze scolastiche, su prenotazione."
    ],
    "fr": [
      "Élevage et production de fromages de chèvres. Vous pouvez retrouver nos produits sur différents marchés et également à la ferme tous les soirs de 18 h à 19 h. Visite de la chèvrerie les jeudis soirs à 18h pendant les vacances scolaires sur réservation."
    ],
    "nl": [
      "Fokken en productie van geitenkaas. Je vindt onze producten op verschillende markten en ook op de boerderij, elke avond van 18.00 tot 19.00 uur. Bezoek aan de geitenboerderij op donderdagavond om 18.00 uur tijdens de schoolvakanties, op afspraak."
    ],
    "es": [
      "Cría y producción de queso de cabra. Podrá encontrar nuestros productos en diversos mercados y también en la granja todas las tardes de 18.00 a 19.00 horas. Visitas a la granja de cabras los jueves por la tarde a las 18:00 durante las vacaciones escolares, previa concertación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Biquettes de Saussac"
    ]
  },
