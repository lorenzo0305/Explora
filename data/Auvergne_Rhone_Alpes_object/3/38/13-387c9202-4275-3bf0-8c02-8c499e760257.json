  "rdfs:comment": {
    "de": [
      "Mit einem atemberaubenden Blick auf Giraffen und Breitmaulnashörner schlafen Sie inmitten der afrikanischen Savanne. Ein einzigartiges Erlebnis, das Sie mit Ihrer Familie teilen können."
    ],
    "en": [
      "With a breathtaking view of giraffes and rhinoceroses, sleep in the middle of the African savanna. A unique experience to share with your family."
    ],
    "it": [
      "Con una vista mozzafiato su giraffe e rinoceronti bianchi, dormite nel mezzo della savana africana. Un'esperienza unica da condividere con la famiglia."
    ],
    "fr": [
      "Avec une vue imprenable sur les girafes et les rhinocéros blancs, dormez au milieu de la savane africaine. Une expérience unique à partager en famille."
    ],
    "nl": [
      "Met een adembenemend uitzicht op giraffen en witte neushoorns slaapt u midden op de Afrikaanse savanne. Een unieke ervaring om te delen met je familie."
    ],
    "es": [
      "Con una impresionante vista de jirafas y rinocerontes blancos, duerma en medio de la sabana africana. Una experiencia única para compartir con su familia."
    ]
  },
