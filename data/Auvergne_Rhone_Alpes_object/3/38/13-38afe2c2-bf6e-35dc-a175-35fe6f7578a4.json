  "rdfs:comment": {
    "de": [
      "Schloss, das unter Denkmalschutz steht.\r\nDie Besitzer zeigen Ihnen ihr schönes Haus im Herzen der Landschaft von Chappe.\r\nInnen- und Außenbesichtigung"
    ],
    "en": [
      "Listed castle.\r\nThe owners will show you around their beautiful home in the heart of the Chappois countryside.\r\nVisit inside and out"
    ],
    "it": [
      "Castello classificato.\r\nI proprietari saranno lieti di mostrarvi la loro bella casa nel cuore della campagna di Chappois.\r\nVisita all'interno e all'esterno"
    ],
    "fr": [
      "Château classé aux monuments historiques.\r\nLes propriétaires vous font visiter leur belle demeure au cœur de la campagne chappoise.\r\nVisite intérieur et extérieur"
    ],
    "nl": [
      "Kasteel op de lijst.\r\nDe eigenaars zullen je met plezier rondleiden door hun prachtige huis in het hart van het platteland van Chappois.\r\nBezoek binnen en buiten"
    ],
    "es": [
      "Castillo catalogado.\r\nLos propietarios estarán encantados de mostrarle su hermosa casa en el corazón de la campiña de Chappois.\r\nVisita interior y exterior"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Château du Grand Coudray du XVéme et XVIIéme"
    ]
  },
