  "rdfs:comment": {
    "de": [
      "Dieser Saal liegt in der Nähe des Hafens von Roanne und verfügt über einen großen Innenhof. Er ist ideal für alle Arten von Veranstaltungen. Familienfeiern, Bankette, Mahlzeiten, Empfänge, Tanztees, Weihnachtsbäume...."
    ],
    "en": [
      "Located near the port of Roanne, with a large inner courtyard, this hall is ideal for all types of events. Family celebrations, banquets, meals, receptions, tea dances, Christmas trees...."
    ],
    "it": [
      "Situata vicino al porto di Roanne, con un ampio cortile interno, questa sala è ideale per ogni tipo di evento. Feste di famiglia, banchetti, pasti, ricevimenti, balli da tè, alberi di Natale...."
    ],
    "fr": [
      "Située à proximité du port de Roanne, dotée d'une grande cour intérieure, cette salle est idéale pour tout type d'évènements. Fêtes familiales, banquets, repas, réceptions, thés dansants, arbres de Noël...."
    ],
    "nl": [
      "Vlakbij de haven van Roanne, met een grote binnenplaats, is deze zaal ideaal voor alle soorten evenementen. Familiefeesten, banketten, maaltijden, recepties, theedansen, kerstbomen ...."
    ],
    "es": [
      "Situado cerca del puerto de Roanne, con un gran patio interior, este salón es ideal para todo tipo de eventos. Celebraciones familiares, banquetes, comidas, recepciones, bailes de té, árboles de Navidad...."
    ]
  },
