  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b66b2668-d28b-3c77-b82d-a55cd02a8a5f",
      "dc:description": {
        "de": [
          "Arbeitet mit lokalen Produzenten zusammen.\nFleisch aus der Region und aus Familienbetrieben.\nNachhaltiger Ansatz: Einkauf von Rohstoffen, kurze Wege, Züchter aus der Region"
        ],
        "en": [
          "Working with local producers.\nLocal, family-style meats.\nSustainable approach: Purchase of raw materials, short supply chain, local breeders"
        ],
        "it": [
          "Lavorare con i produttori locali.\nCarni locali e familiari.\nApproccio sostenibile: acquisto di materie prime, filiera corta, allevatori locali, ecc"
        ],
        "fr": [
          "Travaillant avec des producteurs locaux.\nViandes locales et familiales. \nDémarche durable : Achat de matières premières, circuit court, éleveurs de la région"
        ],
        "nl": [
          "Werken met lokale producenten.\nLokaal en familiair vlees.\nDuurzame aanpak: aankoop van grondstoffen, korte toeleveringsketen, lokale fokkers, enz"
        ],
        "es": [
          "Trabajar con productores locales.\nCarnes locales y familiares.\nEnfoque sostenible: Compra de materias primas, cadena de suministro corta, criadores locales, etc"
        ]
      },
      "@type": [
        "Description"
