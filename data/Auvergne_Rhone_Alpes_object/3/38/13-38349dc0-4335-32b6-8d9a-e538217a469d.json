  "rdfs:comment": {
    "de": [
      "Entdecken Sie Spirulina du Dauphiné, eine Mikroalge mit zahlreichen Vorteilen, bei einem Besuch des Betriebs. Vorstellung der Ursprünge dieser Alge, ihrer Produktionsweise und ihres Nährstoffreichtums. Verkostung und Direktverkauf. Verkauf von getrockneten Früchten."
    ],
    "en": [
      "You can discover the production site of the Dauphine's own spirulina. You will learn about the origin, production and the  nutritional values of this micro-algae as well as enjoy a tasting and have the opportunity to buy some of this wonder food."
    ],
    "it": [
      "Venite a scoprire la spirulina del Delfinato, una microalga dai molti benefici, visitando la fattoria. Presentazione delle origini di quest'alga, del suo metodo di produzione e del suo valore nutrizionale. Degustazione e vendita diretta. Vendita di frutta secca."
    ],
    "fr": [
      "Venez découvrir la spiruline du Dauphiné, micro-algue aux nombreux bienfaits, en visitant l'exploitation. Présentation des origines de cette algue, son mode de production et sa richesse nutritionnelle. Dégustation et vente directe. Vente de fruits séchés."
    ],
    "es": [
      "Venga a descubrir la espirulina del Dauphiné, una microalga con muchos beneficios, visitando la granja. Presentación de los orígenes de esta alga, su método de producción y su valor nutricional. Degustación y venta directa. Venta de frutos secos."
    ],
    "nl": [
      "Kom en ontdek spirulina uit de Dauphiné, een micro-alg met vele voordelen, tijdens een bezoek aan de boerderij. Presentatie van de oorsprong van deze alg, de productiemethode en de voedingswaarde ervan. Proeverij en directe verkoop. Verkoop van gedroogde vruchten."
    ]
  },
