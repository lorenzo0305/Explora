  "rdfs:comment": {
    "de": [
      "Armegyn und Antoine bieten Ihnen eine raffinierte Küche, die lokale Produkte hervorhebt. Hier ist alles hausgemacht, auch das Brot und der Blätterteig. Schöne schattige Terrasse im Sommer. Gemütlicher Saal mit Holzofen im Winter."
    ],
    "en": [
      "Armegyn and Antoine offer refined cuisine, featuring local produce. Everything is homemade, including the bread and puff pastry. Lovely shaded terrace in summer. Warm dining room with wood-burning stove in winter."
    ],
    "it": [
      "Armegyn e Antoine propongono una cucina raffinata che valorizza i prodotti locali. Tutto è fatto in casa, anche il pane e la pasta sfoglia. Bella terrazza ombreggiata in estate. Calda sala da pranzo con stufa a legna in inverno."
    ],
    "fr": [
      "Armegyn et Antoine vous propose une cuisine raffinée, qui met en valeur les produits locaux. Ici tout est fait maison, y compris le pain et feuilletage. Belle terrasse ombragée l'été. Salle chaleureuse avec poêle à bois l'hiver."
    ],
    "es": [
      "Armegyn y Antoine le ofrecen una cocina refinada que aprovecha al máximo los productos locales. Todo es casero, incluido el pan y el hojaldre. Agradable terraza a la sombra en verano. Cálido comedor con estufa de leña en invierno."
    ],
    "nl": [
      "Armegyn en Antoine bieden je een verfijnde keuken die optimaal gebruikmaakt van lokale producten. Alles is hier huisgemaakt, inclusief het brood en het bladerdeeg. Heerlijk schaduwrijk terras in de zomer. Warme eetkamer met houtkachel in de winter."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant La Grange aux Fleurs"
    ],
    "fr": [
      "Restaurant La Grange aux Fleurs"
    ]
  },
