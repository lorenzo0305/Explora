  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05f1b215-6c0f-3aa2-9ed0-59b6cf7b0d57",
      "dc:description": {
        "de": [
          "Neu auf dem Parkplatz der Sporthallen.\nEinweihung des 3×3-Basketballplatzes in Anwesenheit von Vincent FAUCHÉ, einem professionellen Basketballspieler\nes wird den ganzen Tag über am 2. Oktober sportliche Animationen geben"
        ],
        "en": [
          "New in the sports hall parking lot.\nInauguration of the 3×3 basketball court in the presence of Vincent FAUCHÉ, professional basketball player\nall day on october 2, there will be sporting events"
        ],
        "it": [
          "Novità nel parcheggio del palazzetto dello sport.\nInaugurazione del campo da basket 3×3 alla presenza di Vincent FAUCHÉ, giocatore professionista di basket\nil 2 ottobre, per tutta la giornata, si terranno eventi sportivi"
        ],
        "fr": [
          "Nouveau sur le parking des salles de sports.\nInauguration du terrain de basket 3×3 en présence de Vincent FAUCHÉ, joueur de basket professionnel\nil y aura toute la journée du 2 octobre des animations sportives"
        ],
        "es": [
          "Novedad en el aparcamiento del pabellón de deportes.\nInauguración de la cancha de baloncesto 3×3 en presencia de Vincent FAUCHÉ, jugador profesional de baloncesto\ndurante todo el día del 2 de octubre, habrá eventos deportivos"
        ],
        "nl": [
          "Nieuw op de parkeerplaats van de sporthal.\nInhuldiging van het 3×3 basketbalveld in aanwezigheid van Vincent FAUCHÉ, professioneel basketbalspeler\nop 2 oktober zijn er de hele dag sportevenementen"
        ]
      },
      "@type": [
        "Description"
