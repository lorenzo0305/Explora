      "rdfs:comment": {
        "de": [
          "Samaris ist die Kosmetikmarke. Sie bietet Produkte mit dem Extrakt der Salicornia aus der Bucht von Somme an. Ein originelles Geschenk, um die Haut Ihrer Lieben zu pflegen."
        ],
        "en": [
          "Samaris is a cosmetics brand. It offers products made with samphire extract from the Baie de Somme. An original gift to care for the skin of your loved ones."
        ],
        "it": [
          "Samaris è un marchio di cosmetici. Offre prodotti a base di estratto di zaffiro proveniente dalla baia della Somme. Un regalo originale per prendersi cura della pelle dei propri cari."
        ],
        "fr": [
          "Samaris est la marque cosmétique. Elle propose des produits à l’extrait de salicorne de la baie de Somme. Un cadeau original pour prendre soin de la peau de vos proches."
        ],
        "nl": [
          "Samaris is een cosmeticamerk. Het biedt producten op basis van zeekraal-extract uit de Baai van de Somme. Een origineel cadeau om de huid van je geliefden te verzorgen."
        ],
        "es": [
          "Samaris es una marca de cosméticos. Ofrece productos elaborados con extracto de hinojo marino de la Bahía de Somme. Un regalo original para cuidar la piel de sus seres queridos."
        ]
      },
