      "@id": "https://data.datatourisme.fr/71568b51-cb1d-39a9-ae6f-f10747ab474f",
      "dc:description": {
        "de": [
          "Auf dem Programm stehen Straßentheater, Konzerte, Mitmach-Workshops, Kinderanimation und Kunstinstallationen. Diese Vielfalt schafft eine freundliche und für alle offene Atmosphäre."
        ],
        "en": [
          "The program includes street performances, concerts, participatory workshops, children's activities and art installations. This diversity creates a convivial atmosphere open to all."
        ],
        "it": [
          "Il programma comprende spettacoli di strada, concerti, laboratori partecipativi, attività per bambini e installazioni artistiche. Questa diversità crea un'atmosfera amichevole aperta a tutti."
        ],
        "fr": [
          "Au programme : spectacles de rue, concerts, ateliers participatifs, animations pour enfants et installations artistiques. Cette diversité crée une ambiance conviviale et ouverte à tous."
        ],
        "nl": [
          "Op het programma staan straatoptredens, concerten, participatieve workshops, kinderactiviteiten en kunstinstallaties. Deze diversiteit zorgt voor een gezellige sfeer die voor iedereen toegankelijk is."
        ],
        "es": [
          "El programa incluye espectáculos callejeros, conciertos, talleres participativos, actividades infantiles e instalaciones artísticas. Esta diversidad crea un ambiente acogedor abierto a todos."
        ]
      },
