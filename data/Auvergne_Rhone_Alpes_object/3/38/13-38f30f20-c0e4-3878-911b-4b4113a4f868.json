  "rdfs:comment": {
    "de": [
      "Die ehemalige gallo-römische Hauptstadt liegt im Herzen des Departements am Ufer der Loire und setzt mit zahlreichen Einrichtungen auf Sport: Schwimmbad, überdachte Boulodrome, Tennisplätze und die Pferderennbahn mit mehreren Treffen das ganze Jahr über."
    ],
    "en": [
      "Situated in the heart of the department, on the banks of the Loire, this former Gallo-Roman capital plays the sports card with many facilities: swimming pool, covered bowling alley, tennis and the racecourse with several meetings throughout the year."
    ],
    "it": [
      "Situata nel cuore del dipartimento, sulle rive della Loira, questa antica capitale gallo-romana gioca la carta dello sport con numerose strutture: piscina, bowling coperto, campo da tennis e l'ippodromo con diversi incontri durante l'anno."
    ],
    "fr": [
      "Située au cœur du département, au bord de la Loire, cette ancienne capitale gallo-romaine, joue la carte du sport avec de nombreux équipements : piscine, boulodrome couvert, tennis et l'hippodrome avec plusieurs réunions tout au long de l'année."
    ],
    "es": [
      "Situada en el corazón del departamento, a orillas del Loira, esta antigua capital galo-romana juega la carta del deporte con numerosas instalaciones: piscina, bolera cubierta, pista de tenis y el hipódromo con varios encuentros a lo largo del año."
    ],
    "nl": [
      "Gelegen in het hart van het departement, aan de oevers van de Loire, speelt deze oude Gallo-Romeinse hoofdstad de sportkaart met tal van faciliteiten: zwembad, overdekte bowlingbaan, tennisbaan en de renbaan met verschillende bijeenkomsten gedurende het hele jaar."
    ]
  },
  "rdfs:label": {
