  "rdfs:comment": {
    "de": [
      "Wanderungen und Biwaks in den Bergmassiven rund um Grenoble. Sommer und Winter, auf ins Abenteuer!\r\nGrenoble Camp de Base ist eine Gruppe von Bergführern (AeM D.E.), die Tagesausflüge, Biwaks und thematische Ausflüge anbieten"
    ],
    "en": [
      "Hiking and bivouacking in the mountains around Grenoble. All year round, our english speaking team is happy to welcome you!"
    ],
    "it": [
      "Escursioni e bivacchi nelle montagne intorno a Grenoble. Due membri del nostro team parlano itiliano e sarà felice di accompagnarvi in montagna."
    ],
    "fr": [
      "Randonnées et bivouac dans les massifs autour de Grenoble. Été comme hiver, partons à l'aventure !\r\nGrenoble Camp de Base est un collectif d'accompagnateur en montagne (AeM D.E.) proposant des sorties journées, bivouac, sorties thématiques"
    ],
    "nl": [
      "Wandelen en bivakkeren in de bergen rond Grenoble. Zomer of winter, laten we op avontuur gaan!\r\nGrenoble Camp de Base is een groep berggidsen (AeM D.E.) die dagtochten, bivaks en thematische uitstapjes aanbiedt"
    ],
    "es": [
      "Senderismo y vivac en las montañas de los alrededores de Grenoble. En verano o en invierno, ¡a la aventura!\r\nGrenoble Camp de Base es un grupo de guías de montaña (AeM D.E.) que ofrece excursiones de un día, vivacs y salidas temáticas"
    ]
  },
