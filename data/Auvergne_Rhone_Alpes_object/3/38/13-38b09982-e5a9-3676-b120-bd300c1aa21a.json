  "rdfs:comment": {
    "de": [
      "Studio Brussels Snowcase ist vom 14. bis 20. März wieder da! Nach einem Tag voller Abenteuer auf der Piste, lassen Sie sich von einem unvergesslichen Après-Ski mitreißen. Sind Sie bereit, eine Woche zu erleben, in der Schnee und Feiern zu unvergesslichen Momenten verschmelzen?"
    ],
    "en": [
      "Studio Brussels Snowcase is back from the 14th to 20th of March! After a day full of adventures on the slopes, let yourself be swept away by a memorable après-ski. Ready to experience a week where snow and festivities come together for unforgettable moments?"
    ],
    "it": [
      "Studio Brussels Snowcase è di nuovo disponibile dall'14 al 20marzo! Dopo una giornata piena di avventure sulle piste, lasciati trasportare da un après-ski indimenticabile. Sei pronto a vivere una settimana in cui neve e festività si mescolano per momenti indimenticabili?"
    ],
    "fr": [
      "Studio Brussels Snowcase est de retour du 14 au 20 mars ! Après une journée pleine d’aventures sur les pistes, laissez-vous emporter par un après-ski mémorable. Prêt à vivre une semaine où neige et festivités se mêlent pour des moments inoubliables ?"
    ],
    "es": [
      "Studio Brussels Snowcase vuelve del 14 al 20 de marzo Después de un día de aventuras en las pistas, déjese llevar por un après-ski memorable. ¿Está preparado para una semana de momentos inolvidables en los que la nieve y la fiesta se dan la mano?"
    ],
    "nl": [
      "Studio Brussel Snowcase is terug van 14 tot 20 maart! Laat je na een avontuurlijke dag op de piste meevoeren door een onvergetelijke après-ski. Ben jij klaar voor een week vol onvergetelijke momenten waarin sneeuw en feest samenkomen?"
    ]
  },
