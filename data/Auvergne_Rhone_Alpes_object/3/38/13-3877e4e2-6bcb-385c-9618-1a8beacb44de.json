  "rdfs:comment": {
    "de": [
      "Das Restaurant Chez Antonin ist seit 1906 der Spezialist für Meeresfrüchte in Les Halles de Lyon Paul Bocuse. Entdecken Sie an ihren Ständen frische Muscheln, Krustentiere und Fische, genießen Sie sie im Restaurant oder im Stehen."
    ],
    "en": [
      "Seafood specialists since 1906, we are located in the Halles de Lyon-Paul Bocuse indoor food market. Pop in to discover their stalls of fresh fish and shellfish, and taste them, either sitting down in the restaurant or standing at the bar."
    ],
    "it": [
      "Chez Antonin è lo specialista dei frutti di mare a Les Halles de Lyon Paul Bocuse dal 1906. Scoprite i molluschi, i crostacei e i pesci freschi sui loro banchi e gustateli al ristorante o in piedi."
    ],
    "fr": [
      "Le restaurant Chez Antonin est le spécialiste des produits de la mer aux Halles de Lyon Paul Bocuse depuis 1906. Découvrez sur leurs étals des coquillages, des crustacés et des poissons frais, dégustez-les au restaurant ou debout."
    ],
    "nl": [
      "Chez Antonin is de zeevruchtenspecialist van Les Halles de Lyon Paul Bocuse sinds 1906. Ontdek verse schelpdieren, schaaldieren en vis op hun kraampjes en geniet ervan in het restaurant of staand."
    ],
    "es": [
      "Chez Antonin es el especialista en marisco de Les Halles de Lyon Paul Bocuse desde 1906. Descubra mariscos, crustáceos y pescados frescos en sus puestos, y degústelos en el restaurante o de pie."
    ]
  },
