  "rdfs:comment": {
    "de": [
      "Wazoo, der Folk aus der Auvergne, der seit über 20 Jahren zum Mitsingen einlädt! Und um den Abend zu verlängern, kommt DJ Matafan mit seinem Elektro mit Bergklängen. Online-Ticketverkauf!"
    ],
    "en": [
      "Rendezvous with Wazoo, the folk from Auvergne who's been making people sing for over 20 years! And to prolong the evening, DJ Matafan will be on hand with his mountain-tinged electro. Tickets now available online!"
    ],
    "it": [
      "Wazoo, i folk di Auvergne che fanno cantare la gente da oltre 20 anni! E per prolungare la serata, DJ Matafan sarà a disposizione con la sua electro dai toni montani. Biglietti disponibili online!"
    ],
    "fr": [
      "Rendez-vous avec Wazoo, le folk auvergnat qui fait chanter depuis plus de 20 ans ! Et pour prolonger la soiréé, DJ Matafan débarque avec son électro aux sonorités montagnardes. Billetterie en ligne !"
    ],
    "es": [
      "Wazoo, el folk de Auvernia que lleva más de 20 años haciendo cantar a la gente Y para prolongar la velada, DJ Matafan estará presente con su electro con tintes montañeses. Las entradas ya están disponibles en línea"
    ],
    "nl": [
      "Wazoo, de mensen uit de Auvergne die al meer dan 20 jaar mensen aan het zingen krijgen! En om de avond te verlengen zal DJ Matafan aanwezig zijn met zijn electro in de bergen. Tickets nu online verkrijgbaar!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "CONCERT WAZOO & DJ MATAFAN"
    ]
  },
