  "rdfs:comment": {
    "de": [
      "Pony-Club, Organisation von Reitkursen und Praktikumstagen während der Schulferien.\r\nEltern haben die Möglichkeit, ein Pony zu buchen, um mit ihrem Kind einen Ausritt an der Hand zu machen."
    ],
    "en": [
      "Pony club, organisation of riding lessons and special courses during the school holidays.\r\nParents, you can reserve a pony to take your child for a ride."
    ],
    "it": [
      "Pony club, organizzazione di lezioni di equitazione e giornate di allenamento durante le vacanze scolastiche.\r\nI genitori hanno la possibilità di prenotare un pony per un giro con il proprio figlio."
    ],
    "fr": [
      "Poney club, organisation de cours d'équitation et de journée de stage pendant les vacances scolaire.\r\nParents, vous avez la possibilité de réserver un poney pour faire une balade en main avec votre enfant."
    ],
    "nl": [
      "Ponyclub, organisatie van paardrijlessen en trainingsdagen tijdens de schoolvakanties.\r\nOuders, u heeft de mogelijkheid om een pony te reserveren voor een ritje met uw kind."
    ],
    "es": [
      "Pony club, organización de clases de equitación y jornadas de entrenamiento durante las vacaciones escolares.\r\nPadres, tienen la posibilidad de reservar un poni para dar un paseo con su hijo."
    ]
  },
