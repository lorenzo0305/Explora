  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Mediathek von Morestel! 300 m² Innenbereich mit Zeitschriften, Romanen, Dokumentarfilmen, DVDs, Lesetexten, CD-Büchern, Alben, Comics... für alle Zielgruppen. ein digitaler Bereich mit kostenlosem Wi-Fi-Zugang, Workshops, Schulungen."
    ],
    "en": [
      "Visit the new multimedia library in Morestel! This 300 m² facility proposes magazines, novels, documentary material, DVDs, audiobooks, CD-books, comics and comic books, etc. for all publics."
    ],
    "it": [
      "Scoprite la mediateca Morestel! Uno spazio interno di 300 m² con riviste, romanzi, documentari, DVD, letture, CD, album, fumetti... per tutti i tipi di pubblico. Uno spazio digitale con accesso Wi-Fi gratuito, workshop, formazione."
    ],
    "fr": [
      "Découvrez la médiathèque de Morestel ! Espace intérieur de 300 m² avec des revues, romans, documentaires, dvd, textes lus, livres-cd, albums, bande dessinées... pour tous les publics. un espace numérique avec accès Wi-Fi gratuit, ateliers, formation."
    ],
    "nl": [
      "Ontdek de mediatheek van Morestel! Een overdekte ruimte van 300 m² met tijdschriften, romans, documentaires, dvd's, lezingen, cd's, albums, strips... voor alle doelgroepen. Een digitale ruimte met gratis wifi, workshops, opleidingen."
    ],
    "es": [
      "Descubra la mediateca de Morestel Un espacio interior de 300 m² con revistas, novelas, documentales, DVDs, lecturas, CDs, álbumes, cómics... para todos los públicos. Un espacio digital con acceso Wi-Fi gratuito, talleres, formación."
    ]
  },
