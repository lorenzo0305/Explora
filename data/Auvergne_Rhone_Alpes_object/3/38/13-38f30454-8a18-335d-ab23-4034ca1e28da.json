  "rdfs:comment": {
    "de": [
      "Der Square Jean Chamey vor dem Rathaus von Meythet ist ein Ort der Entspannung für die Einwohner. Hier finden das ganze Jahr über Konzerte und Feiern statt, die insbesondere von der MJC Victor Hugo organisiert werden."
    ],
    "en": [
      "The square Jean Chamey, located in front of Meythet town hall, is a place for local residents to relax. Throughout the year, it hosts concerts and festivities, notably organized by the MJC Victor Hugo."
    ],
    "it": [
      "La piazza Jean Chamey, situata di fronte al municipio di Meythet, è un luogo di relax per gli abitanti della zona. Durante l'anno, ospita concerti e feste, in particolare organizzati dal MJC Victor Hugo."
    ],
    "fr": [
      "Le square Jean Chamey, situé devant l'hôtel de ville de Meythet, est un espace de détente pour les habitants. Il accueille tout au long de l'année des concerts et des festivités, notamment organisés par la MJC Victor Hugo."
    ],
    "es": [
      "La plaza Jean Chamey, situada frente al ayuntamiento de Meythet, es un lugar de esparcimiento para los vecinos. A lo largo del año, acoge conciertos y fiestas, en particular las organizadas por el MJC Victor Hugo."
    ],
    "nl": [
      "Het Jean Chamey plein, gelegen tegenover het gemeentehuis van Meythet, is een plek waar de plaatselijke bewoners zich kunnen ontspannen. Het hele jaar door vinden er concerten en festiviteiten plaats, met name georganiseerd door het MJC Victor Hugo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Square Jean Chamey"
    ]
  },
