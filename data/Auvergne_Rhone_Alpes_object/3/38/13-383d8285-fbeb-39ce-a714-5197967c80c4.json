  "rdfs:comment": {
    "de": [
      "Auf den Anhöhen von St Paul-en-Jarez im Regionalen Naturpark Pilat, 15 km von St Etienne entfernt, empfangen Sie Anne Laure und Oliver im Herzen ihres Bauernhofs mit Milchkühen aus biologischem Anbau."
    ],
    "en": [
      "On the heights of St Paul-en-Jarez in the Parc Naturel Régional du Pilat, 15 km from St Etienne, Anne Laure and Oliver welcome you to the heart of their organic dairy farm."
    ],
    "it": [
      "Sulle alture di St Paul-en-Jarez, nel Parc Naturel Régional du Pilat, a 15 km da St Etienne, Anne Laure e Oliver vi accolgono nel cuore della loro fattoria biologica."
    ],
    "fr": [
      "Sur les hauteurs de St Paul-en-Jarez dans le Parc Naturel Régional du Pilat, à 15 km de St Etienne, Anne Laure et Oliver vous accueillent au cœur de leur ferme de vaches laitières en agriculture biologique."
    ],
    "nl": [
      "Op de hoogten van St Paul-en-Jarez in het Parc Naturel Régional du Pilat, op 15 km van St Etienne, heten Anne Laure en Oliver je welkom in het hart van hun biologische melkveebedrijf."
    ],
    "es": [
      "En las alturas de St Paul-en-Jarez, en el Parque Natural Regional del Pilat, a 15 km de St Etienne, Anne Laure y Oliver le dan la bienvenida al corazón de su granja lechera ecológica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme pédagogique - La ferme au son des cloches"
    ]
  },
