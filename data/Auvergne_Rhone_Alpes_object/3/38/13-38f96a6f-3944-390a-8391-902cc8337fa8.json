  "rdfs:comment": {
    "de": [
      "Als sesshafter Bio-Imker in St Pierre d'Entremont biete ich alle Produkte aus dem Bienenstock mit Bio-Zertifizierung an. Sesshafte Bienenvölker in den Bergen und Bio-Zertifizierung garantieren Ihnen Produkte von bemerkenswerter Qualität."
    ],
    "en": [
      "As a sedentary organic beekeeper in St Pierre d'Entremont, I offer all bee products with organic certification. Sedentary mountain colonies and organic certification guarantee you products of outstanding quality."
    ],
    "it": [
      "In qualità di apicoltore biologico sedentario di St Pierre d'Entremont, offro tutti i prodotti biologici certificati dell'alveare. Le colonie sedentarie di montagna e la certificazione biologica vi garantiscono prodotti di notevole qualità."
    ],
    "fr": [
      "Apiculteur sédentaire bio à St Pierre d'Entremont, je propose tous les produits de la ruche en certification biologique. Colonies sédentaires de montagne et certification biologique vous garantissent des produits d'une qualité remarquable."
    ],
    "es": [
      "Como apicultor ecológico sedentario de St Pierre d'Entremont, le ofrezco todos los productos ecológicos certificados de la colmena. Las colonias sedentarias de montaña y la certificación ecológica le garantizan productos de notable calidad."
    ],
    "nl": [
      "Als sedentaire biologische imker in St Pierre d'Entremont bied ik alle gecertificeerde biologische producten uit de bijenkorf aan. De sedentaire bijenkolonies in de bergen en de biologische certificering garanderen u producten van opmerkelijke kwaliteit."
    ]
  },
