  "rdfs:comment": {
    "de": [
      "Gästehaus in einem kleinen, typischen Weiler mit Reetdachhäusern, solides Steingebäude, das mit Schiefer gedeckt ist. Die Terrasse bietet einen Panoramablick auf den Westen und die Monts du Velay. Empfang von Radfahrern und Mountainbikern (Garage) und Reitern."
    ],
    "en": [
      "Guest house situated in a small typical hamlet of thatched cottages, solid stone building covered with lauzes. The terrace offers a panoramic view on the west and the Velay mountains. Cyclists and mountain bikes (garage) and riders are welcome."
    ],
    "it": [
      "Casa per gli ospiti situata in un piccolo borgo di cottage con tetto di paglia, un solido edificio in pietra ricoperto di ardesia. La terrazza offre una vista panoramica sull'ovest e sulle montagne del Velay. I ciclisti e le mountain bike sono i benvenuti (garage) e i cavalieri."
    ],
    "fr": [
      "Maison d'hôtes située dans un petit hameau typique de chaumières, solide bâtisse en pierres couverte de lauzes. La terrasse offre une vue panoramique sur l'ouest et les monts du Velay. Accueil cyclos et VTT (garage) et cavaliers."
    ],
    "nl": [
      "Gastenverblijf gelegen in een klein gehucht van typische rietgedekte huisjes, massief stenen gebouw bedekt met leisteen. Het terras biedt een panoramisch uitzicht op het westen en de bergen van de Velay. Fietsers en mountainbikers zijn welkom (garage) en ruiters."
    ],
    "es": [
      "Casa de huéspedes situada en una pequeña aldea de casas de campo con techo de paja, un sólido edificio de piedra cubierto de pizarra. La terraza ofrece una vista panorámica del oeste y de las montañas de Velay. Los ciclistas y los ciclistas de montaña son bienvenidos (garaje) y los jinetes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge L'Herminette"
    ]
  },
