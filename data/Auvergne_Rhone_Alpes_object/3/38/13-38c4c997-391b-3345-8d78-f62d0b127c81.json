  "rdfs:comment": {
    "de": [
      "Im Herzen von Morestel vereinen 8 lokale Designerinnen ihr Know-how in einer Boutique für Kunsthandwerk: Schmuck, Keramik, Schneiderei, Leder, Möbel, süße Leckereien? Einzigartige, handgefertigte, lokale und zu 100 % handwerkliche Kreationen!"
    ],
    "en": [
      "In the heart of Morestel, eight local female artisans combine their talents in a craft boutique offering jewellery, ceramics, sewing, leatherwork, furniture, and sweet treats. Unique, handmade creations – local and 100% artisanal !"
    ],
    "it": [
      "Nel cuore di Morestel, 8 designer locali uniscono le loro competenze in una boutique di artigianato artistico: gioielli, ceramiche, cucito, cuoio, mobili, dolciumi? Creazioni uniche, fatte a mano, locali e 100% artigianali!"
    ],
    "fr": [
      "Au cœur de Morestel, 8 créatrices locales unissent leurs savoir-faire dans une boutique d’artisanat d’art : bijoux, céramique, couture, cuir, mobilier, douceurs sucrées… Des créations uniques, faites main, locales et 100 % artisanales !"
    ],
    "nl": [
      "In het hart van Morestel combineren 8 lokale ontwerpers hun vaardigheden in een kunstnijverheidsboetiek: juwelen, keramiek, naaien, leer, meubels, zoete lekkernijen? Unieke, handgemaakte, lokale en 100% ambachtelijke creaties!"
    ],
    "es": [
      "En el corazón de Morestel, 8 diseñadores locales combinan sus habilidades en una boutique de artesanía: joyería, cerámica, costura, cuero, muebles, dulces.. Creaciones únicas, hechas a mano, locales y 100% artesanales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cocon Bleu : boutique de créateurs"
    ]
  },
