  "rdfs:comment": {
    "de": [
      "Abwechslungsreiche Buffets rund um eine familiäre und traditionelle Küche, die Menüs wechseln je nach Jahreszeit. Das Restaurant ist für die Bewohner des Hotels, aber auch für externe Gäste geöffnet. Möglichkeit von Pizzas und Fast Food."
    ],
    "en": [
      "Varied buffet around a traditional and family cuisine, menus are changing with the season. The restaurant is open for the hotel clients and all the other clients that come."
    ],
    "it": [
      "Vari buffet basati sulla cucina tradizionale familiare, i menu cambiano in base alle stagioni. Il ristorante è aperto ai residenti dell'hotel ma anche agli esterni. Possibilità di pizze e fast food."
    ],
    "fr": [
      "Buffets variés autour d'une cuisine familiale et traditionnelle, les menus changent en fonction des saisons. Restaurant ouvert pour les résidents de l'hôtel mais également aux personnes extérieures. Possibilité de pizzas et restauration rapide."
    ],
    "es": [
      "El restaurante del hotel Campanile les ofrece diversos menús interesantes al gusto de cada uno. Dispone de dos buffet (uno de entrantes y otro de postres) entre los cuales podrá escoger y degustar aquello que usted prefiera."
    ],
    "nl": [
      "Diverse buffetten op basis van de traditionele familiekeuken, de menu's veranderen naargelang de seizoenen. Het restaurant staat open voor hotelbewoners maar ook voor buitenstaanders. Mogelijkheid van pizza's en fast food."
    ]
  },
