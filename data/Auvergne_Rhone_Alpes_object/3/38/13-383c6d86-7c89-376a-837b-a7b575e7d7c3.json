  "rdfs:comment": {
    "de": [
      "Entdecken Sie das La Tart?in in Vichy, ein gemütliches Restaurant mit leckeren Tartines und abwechslungsreichen Gerichten aus frischen, regionalen Produkten und ausgewählten Weinen. Genießen Sie die ruhige Terrasse und den freundlichen Service."
    ],
    "en": [
      "Discover La Tart?in in Vichy, a friendly restaurant offering gourmet tartines and a variety of dishes based on fresh regional produce and selected wines. Enjoy a peaceful terrace and friendly service."
    ],
    "it": [
      "Scoprite La Tart?in di Vichy, un ristorante accogliente che offre panini gourmet e una varietà di piatti a base di prodotti regionali freschi e vini selezionati. Godetevi una tranquilla terrazza e un servizio cordiale."
    ],
    "fr": [
      "Découvrez La Tart’in à Vichy, un restaurant convivial aux tartines gourmandes, et suggestions de plats variés à base de produits frais, régionaux et de vins sélectionnés. Profitez d’une terrasse paisible et d’un service chaleureux."
    ],
    "nl": [
      "Ontdek La Tart?in in Vichy, een vriendelijk restaurant met broodjes voor fijnproevers en een verscheidenheid aan gerechten op basis van verse regionale producten en geselecteerde wijnen. Geniet van een rustig terras en vriendelijke bediening."
    ],
    "es": [
      "Descubra La Tart?in en Vichy, un restaurante acogedor que ofrece bocadillos gourmet y una gran variedad de platos a base de productos frescos de la región y vinos seleccionados. Disfrute de una tranquila terraza y de un servicio amable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Tart'in"
    ]
  },
