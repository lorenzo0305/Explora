  "rdfs:comment": {
    "de": [
      "Für Geschmacksentdeckungen, savoyische Spezialitäten und vegetarische Gerichte sind Sie im Walhalla der Liebhaber guten Fleisches richtig. Hier kann man 6 vor Ort gebraute Biere oder Cocktailkreationen mit Gabins Bergpflanzen probieren."
    ],
    "en": [
      "For taste discoveries, Savoyard specialties and vegetarian dishes, you are at the Valhalla of food lovers. You can taste 6 beers brewed on site or cocktails created with mountain plants from Gabin."
    ],
    "it": [
      "Per le scoperte gustative, le specialità savoiarde e i piatti vegetariani, siete nel Valhalla degli amanti della buona carne. Potrete degustare 6 birre prodotte sul posto o cocktail creati con le piante di montagna di Gabin."
    ],
    "fr": [
      "Pour les découvertes gustatives, les spécialités savoyardes et les plats végétariens, vous êtes au Valhalla des amateurs de bonne chair. On peut y déguster 6 bières brassées sur place ou cocktails créations aux plantes montagnardes de Gabin."
    ],
    "es": [
      "Para descubrimientos gustativos, especialidades saboyanas y platos vegetarianos, está en el Valhalla de los amantes de la buena carne. Podrá degustar 6 cervezas elaboradas in situ o cócteles creados con las plantas de montaña de Gabin."
    ],
    "nl": [
      "Als je op zoek bent naar nieuwe smaken, Savoyaardse specialiteiten en vegetarische gerechten, dan ben je in het Walhalla van de fijnproevers. Je kunt genieten van 6 ter plekke gebrouwen bieren of cocktails gemaakt met de bergplanten van Gabin."
    ]
  },
  "rdfs:label": {
