  "rdfs:comment": {
    "de": [
      "Der Lac d'Aydat ist einer der beliebtesten Badespots im Sommer: eine einzigartige bewaldete und vulkanische Umgebung mit einem Badebereich, der im Juli und August von 13:30 bis 18:30 Uhr beaufsichtigt wird."
    ],
    "en": [
      "Lac d'Aydat is one of the most popular spots for summer bathing: a unique wooded and volcanic setting, with a supervised swimming area in July and August, from 1:30 pm to 6:30 pm."
    ],
    "it": [
      "Il Lac d'Aydat è uno dei luoghi più frequentati per fare il bagno in estate: un ambiente unico, boscoso e vulcanico, con un'area di balneazione sorvegliata in luglio e agosto, dalle 13.30 alle 18.30."
    ],
    "fr": [
      "Le lac d’Aydat est l’un des spots les plus prisés pour la baignade en été : un cadre boisé et volcanique unique, avec une zone de baignade surveillée en juillet et août, de 13h30 à 18h30."
    ],
    "nl": [
      "Lac d'Aydat is een van de populairste plekken om te zwemmen in de zomer: een unieke bosrijke en vulkanische omgeving, met een zwemzone onder toezicht in juli en augustus, van 13.30 tot 18.30 uur."
    ],
    "es": [
      "El Lac d'Aydat es uno de los lugares más populares para bañarse en verano: un entorno boscoso y volcánico único, con una zona de baño vigilada en julio y agosto, de 13:30 a 18:30."
    ]
  },
  "rdfs:label": {
    "en": [
      "Plage du lac d'Aydat - Swimming"
    ],
    "fr": [
      "Plage du lac d’Aydat – Baignade"
    ]
  },
