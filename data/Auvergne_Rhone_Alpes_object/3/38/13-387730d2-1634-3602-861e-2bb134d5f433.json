  "rdfs:comment": {
    "de": [
      "D?JAL ? Mit vollem Bewusstsein\r\n\"Nach zwei ausverkauften Shows, über 200 Aufführungen und Tausenden von Zuschauern ist D?jal mit einer neuen Show zurück, die immer verrücktere Figuren und noch verrücktere Situationen vereint!"
    ],
    "en": [
      "D'JAL - In full consciousness\r\n\"After two sold-out shows, more than 200 performances and thousands of spectators, D'jal is back with a new show combining ever crazier characters and even crazier situations!"
    ],
    "it": [
      "D?JAL? In piena coscienza\r\n\"Dopo due spettacoli sold-out, oltre 200 repliche e migliaia di spettatori, D?jal è tornato con un nuovo spettacolo che combina personaggi sempre più folli e situazioni ancora più folli!"
    ],
    "fr": [
      "D’JAL – En plein conscience\r\n« Après deux shows à guichets fermés, plus de 200 représentations et des milliers de spectateurs, D’jal est de retour avec un nouveau spectacle mêlant personnages toujours plus dingues et situations encore plus folles !"
    ],
    "es": [
      "¿D?JAL? En plena conciencia\r\n\"Después de dos funciones con todas las entradas agotadas, más de 200 representaciones y miles de espectadores, D?jal vuelve con un nuevo espectáculo que combina personajes cada vez más locos y situaciones aún más disparatadas"
    ],
    "nl": [
      "D?JAL? Bij volle bewustzijn\r\n\"Na twee uitverkochte shows, meer dan 200 voorstellingen en duizenden toeschouwers is D?jal terug met een nieuwe show met steeds gekkere personages en nog gekkere situaties!"
    ]
  },
