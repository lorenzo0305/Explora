  "rdfs:comment": {
    "de": [
      "Genießen Sie unseren authentischen Rahmen mit traditioneller Küche. Unsere Speisekarte wird jeden Monat je nach Saison und Kreativität des Küchenchefs neu zusammengestellt."
    ],
    "en": [
      "Come and enjoy our authentic setting and traditional cuisine. Our menu is renewed every month according to the season and the chef's creativity."
    ],
    "it": [
      "Venite a godervi il nostro ambiente autentico e la nostra cucina tradizionale. Il nostro menu viene rinnovato ogni mese in base alla stagione e alla creatività dello chef."
    ],
    "fr": [
      "Venez profiter de notre cadre authentique avec une cuisine traditionnelle, notre carte est renouvelé tous les mois en fonction de la saison et de la créativité du chef."
    ],
    "es": [
      "Venga a disfrutar de nuestro ambiente auténtico y nuestra cocina tradicional. Nuestra carta se renueva cada mes según la temporada y la creatividad del chef."
    ],
    "nl": [
      "Kom genieten van onze authentieke omgeving en traditionele keuken. Ons menu wordt elke maand vernieuwd op basis van het seizoen en de creativiteit van de chef."
    ]
  },
  "rdfs:label": {
