  "rdfs:comment": {
    "de": [
      "Genießen Sie den Blick auf den Mont-Blanc während des größten Fluges der 3 Vallées.\r\nEntdecken Sie atemberaubende Panoramen und ein einzigartiges Erlebnis mit diesem Team von Freunden, die begeistert sind, Ihnen diese magische Aktivität näher zu bringen."
    ],
    "en": [
      "Enjoy the view of Mont-Blanc during the longest and greatest flight in the 3 Valleys. Come and discover breathtaking panoramas and a unique experience with this team of friends who are passionate about helping people discover this magical activity."
    ],
    "it": [
      "Godetevi la vista del Monte Bianco durante il più grande volo delle 3 Vallées.\r\nVenite a scoprire panorami mozzafiato e un'esperienza unica con questo team di amici che saranno lieti di farvi scoprire questa magica attività."
    ],
    "fr": [
      "Profitez de la vue sur le Mont-Blanc durant le plus plus grand vol des 3 Vallées. \r\nVenez découvrir des panoramas à couper le souffle et une expérience unique avec cette équipe de copains enchantés de vous faire découvrir cette activité magique."
    ],
    "nl": [
      "Geniet van het uitzicht op de Mont-Blanc tijdens de langste en mooiste vlucht van Les 3 Vallées. Kom en ontdek adembenemende panorama's en een unieke ervaring met dit team van vrienden die gepassioneerd zijn om mensen te helpen deze magische activiteit te"
    ],
    "es": [
      "Disfrute de la vista del Mont Blanc durante el mayor vuelo de los 3 Vallées.\r\nVenga a descubrir panoramas impresionantes y una experiencia única con este equipo de amigos encantados de hacerle descubrir esta actividad mágica."
    ]
  },
