  "rdfs:comment": {
    "de": [
      "Romanische Kirche mit flachem Kopfende aus dem 11. und 12. Jahrhundert, die im 15. Jahrhundert für die Kapelle der Jungfrau Maria umgebaut wurde (ISMH)\r\nDie Kirche von Saint-Aignan liegt auf dem Weg nach Vézelay.\r\nNächtliche Besichtigung bei Kerzenlicht während der Tage des Kulturerbes."
    ],
    "en": [
      "Romanesque church with flat chevet from the 11th, 12th centuries modified in the 15th century for the Chapel of the Virgin (ISMH)\r\nThe church of Saint-Aignan is located on the road to Vézelay.\r\nNight visit by candlelight during the Heritage Days."
    ],
    "it": [
      "Chiesa romanica con chevet piatto dell'XI e XII secolo, modificata nel XV secolo per la Cappella della Vergine (ISMH)\r\nLa chiesa di Saint-Aignan si trova sulla strada per Vézelay.\r\nVisita notturna a lume di candela durante le Giornate del Patrimonio."
    ],
    "fr": [
      "Église romane à chevet plat du XIe, XIIe siècles modifiée au XVe pour la Chapelle de la Vierge (ISMH). \r\nL'église de Saint-Aignan est située sur la voie de Vézelay.\r\nVisite nocturne aux chandelles lors des Journées du Patrimoine."
    ],
    "nl": [
      "Romaanse kerk met platte chevet uit de 11e en 12e eeuw, in de 15e eeuw gewijzigd voor de Mariakapel (ISMH)\r\nDe kerk van Saint-Aignan ligt op de weg naar Vézelay.\r\nNachtelijk bezoek bij kaarslicht tijdens de Open Monumentendagen."
    ],
    "es": [
      "Iglesia románica con cabecera plana de los siglos XI y XII, modificada en el siglo XV para la capilla de la Virgen (ISMH)\r\nLa iglesia de Saint-Aignan se encuentra en la carretera de Vézelay.\r\nVisita nocturna con velas durante las Jornadas del Patrimonio."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Aignan"
    ]
  },
