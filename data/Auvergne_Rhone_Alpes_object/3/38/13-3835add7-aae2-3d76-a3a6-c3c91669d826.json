  "rdfs:comment": {
    "de": [
      "Lassen Sie Ihre Kinder mit Les Savants Fous in ein unglaubliches wissenschaftliches Abenteuer im Herzen von Valence eintauchen! Spektakuläre Experimente, Lachen und Entdeckungen sind in unserem interaktiven Labor garantiert."
    ],
    "en": [
      "Immerse your children in an incredible scientific adventure in the heart of Valence with Les Savants Fous! Spectacular experiments, laughter and discoveries guaranteed in our interactive laboratory."
    ],
    "it": [
      "Portate i vostri bambini in un'incredibile avventura scientifica nel cuore di Valence con Les Savants Fous! Esperimenti spettacolari, risate e scoperte garantite nel nostro laboratorio interattivo."
    ],
    "fr": [
      "Plongez vos enfants dans une incroyable aventure scientifique au cœur de Valence avec Les Savants Fous ! Expériences spectaculaires, rires et découvertes garantis dans notre laboratoire interactif."
    ],
    "es": [
      "¡Lleve a sus hijos a una increíble aventura científica en el corazón de Valence con Les Savants Fous! Experimentos espectaculares, risas y descubrimientos garantizados en nuestro laboratorio interactivo."
    ],
    "nl": [
      "Neem je kinderen mee op een ongelooflijk wetenschappelijk avontuur in het hart van Valence met Les Savants Fous! Spectaculaire experimenten, gelach en ontdekkingen gegarandeerd in ons interactieve laboratorium."
    ]
  },
