  "rdfs:comment": {
    "de": [
      "Dieses vom Konservatorium Montélimar initiierte Konzert vereint die Maîtrise und die Workshops für traditionelle Musik um ein Repertoire von Liedern aus der arabischen Welt, die in einen Dialog mit westlichen Praktiken und Sensibilitäten gestellt werden."
    ],
    "en": [
      "Initiated by the Montélimar Conservatoire, this concert brings together the Maîtrise and the traditional music workshops around a repertoire of songs from the Arab world, set in dialogue with Western practices and sensibilities."
    ],
    "it": [
      "Promosso dal Conservatorio di Montélimar, questo concerto riunisce il coro e i laboratori di musica tradizionale per eseguire un repertorio di canzoni del mondo arabo, in dialogo con le pratiche e le sensibilità occidentali."
    ],
    "fr": [
      "Initié par le Conservatoire de Montélimar, ce concert réunit la Maîtrise et les ateliers de musiques traditionnelles autour d’un répertoire de chansons du monde arabe, mises en dialogue avec des pratiques et des sensibilités occidentales."
    ],
    "es": [
      "Iniciado por el Conservatorio Montélimar, este concierto reúne al coro y a los talleres de música tradicional para interpretar un repertorio de canciones del mundo árabe, en diálogo con las prácticas y sensibilidades occidentales."
    ],
    "nl": [
      "Dit concert, een initiatief van het Conservatorium van Montélimar, brengt het koor en de traditionele muziekworkshops samen om een repertoire van liederen uit de Arabische wereld uit te voeren, in dialoog met westerse praktijken en gevoeligheden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Au fil des voix"
    ]
  },
