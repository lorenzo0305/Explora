  "rdfs:comment": {
    "de": [
      "Verein nach dem Gesetz von 1901, in dem Trüffelbauern, Gastronomen, Ausbildungseinrichtungen, das Syndikat der schwarzen Trüffel des Tricastin, des Pays de Grignan - Enclave des Papes sowie lokal ansässige Unternehmen zusammengeschlossen sind."
    ],
    "en": [
      "Association under the law of 1901, bringing together truffle growers, restaurateurs, training organizations, the Tricastin and Pays de Grignan - Enclave des Papes black truffle syndicates and locally-based companies."
    ],
    "it": [
      "Un'associazione di diritto del 1901 che riunisce tartufai, ristoratori, enti di formazione, i consorzi del tartufo nero di Tricastin e del Pays de Grignan - Enclave des Papes e aziende locali."
    ],
    "fr": [
      "Association loi 1901 regroupant des trufficulteurs, des restaurateurs, des organismes de formation, le syndicat de la truffe noire du Tricastin, du Pays de Grignan - Enclave des Papes ainsi que des entreprises basées localement."
    ],
    "nl": [
      "Een vereniging onder de wet van 1901 die truffeltelers, restauranthouders, opleidingsorganisaties, de syndicaten voor zwarte truffels van Tricastin en Pays de Grignan - Enclave des Papes en lokale bedrijven verenigt."
    ],
    "es": [
      "Asociación creada en virtud de la ley de 1901 que agrupa a truficultores, restauradores, organismos de formación, sindicatos de la trufa negra de Tricastin y del Pays de Grignan - Enclave des Papes y empresas locales."
    ]
  },
  "rdfs:label": {
