  "rdfs:comment": {
    "de": [
      "Das Cinema Le Fellini verfügt über 4 klimatisierte, geräumige und komfortable Säle mit 95 bis 217 Plätzen. Außerdem wurden alle 4 Säle renoviert, um Ihnen noch mehr Komfort zu bieten!\r\nDas Fellini-Kino bietet 400 Filme und 3800 Vorstellungen."
    ],
    "en": [
      "The Fellini Cinema has 4 air-conditioned, spacious and comfortable theatres with 95 to 217 seats. Moreover, the 4 rooms have been renovated, for even more comfort!\r\nThe Fellini cinema has 400 films and 3800 screenings."
    ],
    "it": [
      "Il Cinéma Le Fellini dispone di 4 sale climatizzate, spaziose e confortevoli, da 95 a 217 posti. Inoltre, tutti e 4 gli schermi sono stati rinnovati per un comfort ancora maggiore!\r\nIl cinema Fellini conta 400 film e 3.800 proiezioni."
    ],
    "fr": [
      "Le Cinéma Le Fellini possède 4 salles climatisées, spacieuses et confortables de 95 à 217 places. De plus, les 4 salles ont été rénovées, pour encore plus de confort !\r\nLe cinéma Fellini c'est 400 films et 3800 séances."
    ],
    "nl": [
      "Cinéma Le Fellini heeft 4 ruime en comfortabele zalen met airconditioning en 95 tot 217 zitplaatsen. Bovendien zijn alle 4 de zalen gerenoveerd voor nog meer comfort!\r\nDe Fellini bioscoop heeft 400 films en 3.800 voorstellingen."
    ],
    "es": [
      "Cinéma Le Fellini dispone de 4 salas climatizadas, espaciosas y confortables, con 95 a 217 butacas. Además, las 4 salas han sido renovadas para aumentar aún más su comodidad\r\nEl cine Fellini cuenta con 400 películas y 3.800 proyecciones."
    ]
  },
