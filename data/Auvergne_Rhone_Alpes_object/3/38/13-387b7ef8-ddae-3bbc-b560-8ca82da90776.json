  "rdfs:comment": {
    "de": [
      "Vermietung für Empfänge, Hochzeiten, Seminare, Animationen, Konferenzen, Ausstellungen, Fotoshootings etc Sie werden einen magischen Moment erleben, damit Ihre Hochzeit oder ein anderer Empfang als unvergesslicher Moment in Erinnerung bleibt."
    ],
    "en": [
      "Rental for receptions, weddings, seminars, events, conferences, exhibitions, photo shoots, etc... You'll experience a magical moment that will make your wedding, or any other reception, unforgettable."
    ],
    "it": [
      "Noleggio per ricevimenti, matrimoni, seminari, eventi, conferenze, mostre, servizi fotografici, ecc? Vivrete un momento magico che renderà il vostro matrimonio, o qualsiasi altro ricevimento, indimenticabile."
    ],
    "fr": [
      "Location pour réceptions, mariages, séminaires, animations, conférences, expositions, séances photos, etc… Vous vivrez un instant magique pour que votre mariage, ou toute autre réception reste gravée comme un moment inoubliable."
    ],
    "es": [
      "¿Contratar para recepciones, bodas, seminarios, eventos, conferencias, exposiciones, sesiones fotográficas, etc.? Vivirá un momento mágico que hará que su boda, o cualquier otra recepción, sea inolvidable."
    ],
    "nl": [
      "Huren voor recepties, bruiloften, seminars, evenementen, conferenties, tentoonstellingen, fotoshoots, enzovoort? Je beleeft een magisch moment dat je bruiloft, of welke receptie dan ook, onvergetelijk maakt."
    ]
  },
