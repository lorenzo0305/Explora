  "rdfs:comment": {
    "de": [
      "Der Lesepunkt von Saint Bueil bietet Ihnen eine Sprechstunde in den Räumlichkeiten des Rathauses an. Sie können sich im Netzwerk der Bibliotheken des Pays en Voironnais anmelden, Reservierungen abholen oder Ihre Bücher, CDs, DVDs... abgeben."
    ],
    "en": [
      "The Saint Bueil reading center is open to you at the town hall. You can register with the Pays en Voironnais library network, pick up book reservations or drop off your books, CDs, DVDs..."
    ],
    "it": [
      "Il centro di lettura di Saint Bueil è aperto tutto il giorno presso il municipio. È possibile iscriversi alla rete delle biblioteche del Voironnais, prenotare libri o consegnare libri, CD, DVD, ecc."
    ],
    "fr": [
      "Le point lecture de Saint Bueil, vous propose une permanence dans les locaux de la mairie. Vous pouvez vous inscrire au réseau des Bibliothèques du Pays en Voironnais, retirer des réservations ou déposer vos livres, CD, DVD..."
    ],
    "nl": [
      "Het leescentrum van Saint-Bueil is de hele dag geopend in het gemeentehuis. Je kunt je er inschrijven bij het Voironnais netwerk van bibliotheken, boeken reserveren of boeken, cd's, dvd's, etc. afgeven."
    ],
    "es": [
      "El centro de lectura de Saint Bueil está abierto todo el día en el ayuntamiento. Puede inscribirse en la red de bibliotecas de Voironnais, recoger reservas de libros o dejar sus libros, CD, DVD, etc."
    ]
  },
  "rdfs:label": {
