  "rdfs:comment": {
    "de": [
      "Ein unvergesslicher Spaziergang auf den Anhöhen von Brides. Sehen Sie sich die neue Fußgängerbrücke an und genießen Sie die Aussicht auf das Tal."
    ],
    "en": [
      "An unforgettable walk on the heights of Brides. Come and see the new footbridge and enjoy the views over the valley."
    ],
    "it": [
      "Una passeggiata indimenticabile sulle alture di Brides. Venite a vedere la nuova passerella e godetevi la vista sulla valle."
    ],
    "fr": [
      "Une balade inoubliable sur les hauteurs de Brides. Venez voir la nouvelle passerelle et profitez des vues sur la vallée."
    ],
    "es": [
      "Un paseo inolvidable por las alturas de Brides. Ven a ver la nueva pasarela y disfruta de las vistas sobre el valle."
    ],
    "nl": [
      "Een onvergetelijke wandeling op de hoogten van Brides. Kom de nieuwe loopbrug bekijken en geniet van het uitzicht over de vallei."
    ]
  },
