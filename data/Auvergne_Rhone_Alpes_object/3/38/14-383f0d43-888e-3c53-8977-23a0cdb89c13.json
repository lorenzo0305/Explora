  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/039e564a-0cdb-305b-80c2-52b88325526b",
      "dc:description": {
        "de": [
          "Das Festkomitee und die Stadtverwaltung von Ruisseauville organisieren die Ducasse.\n\nDas Essen wird von Richard Watson moderiert und beginnt um 12:30 Uhr.\n15? pro Erwachsener und 8? pro Kind.\n\nReservierung für den Flohmarkt und das Essen"
        ],
        "en": [
          "The Comité des Fêtes and the Municipality of Ruisseauville organize the Ducasse.\n\nMeal hosted by Richard Watson from 12.30 pm.\n15? per adult and 8? per child.\n\nReservations for flea market and meal"
        ],
        "it": [
          "Il Comité des Fêtes e il Comune di Ruisseauville organizzano la Ducasse.\n\nPasto offerto da Richard Watson a partire dalle 12.30.\n15? per adulto e 8? per bambino.\n\nPrenotazioni per il mercato delle pulci e il pranzo"
        ],
        "fr": [
          "Le Comité des Fêtes et la Municipalité de Ruisseauville organise la Ducasse.\n\nRepas animé par Richard Watson à partir de 12h30.\n15€ par adultes et 8€ par enfants.\n\nRéservation pour la brocante et le repas"
        ],
        "nl": [
          "Het Comité des Fêtes en de gemeente Ruisseauville organiseren de Ducasse.\n\nMaaltijd verzorgd door Richard Watson vanaf 12.30 uur.\n15 euro per volwassene en 8 euro per kind.\n\nReserveringen voor de rommelmarkt en de maaltijd"
        ],
        "es": [
          "El Comité des Fêtes y el Ayuntamiento de Ruisseauville organizan el Ducasse.\n\nComida ofrecida por Richard Watson a partir de las 12h30.\n15? por adulto y 8? por niño.\n\nReservas para el mercadillo y la comida"
        ]
      },
      "@type": [
        "Description"
      ],
