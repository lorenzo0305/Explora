      "dc:description": {
        "de": [
          "Vorführung des Dokufiction-Films \"Ukraine, une terre\nmit anschließendem Gespräch mit dem Regisseur\nJacky Lebas. Um 20 Uhr im CINOS.\nEinheitspreis von 10?"
        ],
        "en": [
          "Screening of the docu-fiction film \"Ukraine, a forgotten land\nfollowed by a discussion with director\nJacky Lebas. At 8pm at CINOS.\nPrice: 10?"
        ],
        "it": [
          "Proiezione del film-documentario \"Ucraina, una terra dimenticata\nseguita da un dibattito con il regista\nJacky Lebas. Alle ore 20.00 al CINOS.\nPrezzo del biglietto singolo: 10?"
        ],
        "fr": [
          "Projection du film docufiction « Ukraine, une terre \noubliée » suivi d’un échange avec le réalisateur \nJacky Lebas. A 20h au CINOS. \nTarif unique de 10€"
        ],
        "nl": [
          "Vertoning van de docufictiefilm \"Oekraïne, een vergeten land\ngevolgd door een discussie met de regisseur\nJacky Lebas. 20.00 uur in CINOS.\nPrijs enkeltje: 10?"
        ],
        "es": [
          "Proyección de la película de docu-ficción \"Ucrania, una tierra olvidada\nseguida de un debate con la directora\nJacky Lebas. A las 20.00 horas en CINOS.\nPrecio de la entrada: 10?"
        ]
      },
