  "rdfs:comment": {
    "de": [
      "Das Bistrot de la Place bietet Ihnen eine traditionelle Küche und nachmittägliche Schlemmerpausen. Eine einfache, großzügige und gesellige Atmosphäre im Herzen des Platzes. Ein seriöses und lächelndes Team!"
    ],
    "en": [
      "Le Bistrot de la Place offers traditional cuisine and afternoon gourmet breaks. A simple, generous and friendly atmosphere, in the heart of the square. A serious, smiling team!"
    ],
    "it": [
      "Il Bistrot de la Place offre una cucina tradizionale e pause gourmet pomeridiane. Un'atmosfera semplice, generosa e amichevole nel cuore della piazza. Un team serio e sorridente!"
    ],
    "fr": [
      "Le Bistrot de la Place vous propose une cuisine traditionnelle, des pauses gourmandes l’après-midi. Une ambiance simple, généreuse et conviviale, au cœur de la place. Une équipe sérieuse et souriante !"
    ],
    "es": [
      "El Bistrot de la Place ofrece cocina tradicional y pausas gastronómicas por la tarde. Un ambiente sencillo, generoso y acogedor en el corazón de la plaza. Un equipo serio y sonriente"
    ],
    "nl": [
      "De Bistrot de la Place biedt traditionele gerechten en gastronomische middagpauzes. Een eenvoudige, gulle en vriendelijke sfeer in het hart van het plein. Een serieus en glimlachend team!"
    ]
  },
