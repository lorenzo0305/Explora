  "rdfs:comment": {
    "de": [
      "Herstellung von Weizen- und Roggenmehl in 5kg- und 25kg-Säcken, ideal zum Backen, Kochen und Brotbacken. Tiefgefrorene Hacksteaks in Paketen und Kalb- oder Rindfleisch in Kisten. Mit dem Bio-Label ausgezeichnet. Verkauf ab Hof auf Bestellung. Vorbestellungen sind auf der Website möglich."
    ],
    "en": [
      "Production of wheat and rye flour in 5kg and 25kg bags, ideal for baking, cooking and bread. Frozen minced steaks in packages and veal or beef in boxes. Organic label. Farm sales by order. Pre-orders available on the website."
    ],
    "it": [
      "Produzione di farina di grano e di segale in sacchi da 5 kg e 25 kg, ideali per pasticceria, cucina e pane. Bistecche macinate surgelate in pacchi e carne di vitello o manzo in scatole. Etichetta biologica. Vendite in fattoria su ordinazione. Preordini disponibili sul sito web."
    ],
    "fr": [
      "Production de farine de blé et de seigle en sac de 5kg et 25kg idéale pour la pâtisserie, cuisine et pain. Steaks hachés surgelés en colis et viande de veau ou bœuf en caissette. Label bio. Vente à la ferme sur commande. Précommande possible sur le site."
    ],
    "nl": [
      "Productie van tarwe- en roggemeel in zakken van 5 kg en 25 kg, ideaal voor gebak, koken en brood. Diepgevroren gehakt in pakketten en kalfs- of rundvlees in dozen. Biologisch label. Boerderijverkoop op bestelling. Pre-orders beschikbaar op de website."
    ],
    "es": [
      "Producción de harina de trigo y centeno en sacos de 5 kg y 25 kg, ideal para repostería, cocina y pan. Filetes picados congelados en paquetes y carne de ternera o buey en cajas. Etiqueta ecológica. Venta en la granja por encargo. Pedidos por adelantado disponibles en el sitio web."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme du Tilleul"
    ]
  },
