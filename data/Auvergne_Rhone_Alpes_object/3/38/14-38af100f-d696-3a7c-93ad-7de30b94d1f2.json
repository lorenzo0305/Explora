  "rdfs:comment": {
    "de": [
      "Die Brasserie Le Vert Dragon in Auchy-au-Bois ist ein freundliches und gemütliches Lokal, das traditionelle und schmackhafte Gerichte anbietet. Ob Sie nun auf der Durchreise sind oder in der Umgebung wohnen, diese Brasserie ist der ideale Ort, um eine angenehme Zeit zu verbringen und gutes Essen zu genießen."
    ],
    "en": [
      "Brasserie Le Vert Dragon, located in Auchy-au-Bois, is a warm and friendly establishment offering traditional, tasty cuisine. Whether you're just passing through the region or live nearby, this brasserie is the ideal place to spend a pleasant moment and enjoy good food."
    ],
    "it": [
      "La Brasserie Le Vert Dragon, situata ad Auchy-au-Bois, è un locale accogliente che serve una gustosa cucina tradizionale. Sia che siate di passaggio nella regione o che abitiate nelle vicinanze, questa brasserie è il luogo ideale per trascorrere un momento piacevole e gustare del buon cibo."
    ],
    "fr": [
      "La Brasserie Le Vert Dragon, située à Auchy-au-Bois, est un établissement convivial et chaleureux qui propose une cuisine traditionnelle et savoureuse. Que vous soyez de passage dans la région ou que vous habitiez aux alentours, cette brasserie est l'endroit idéal pour passer un moment agréable et déguster de bons plats."
    ],
    "es": [
      "La Brasserie Le Vert Dragon, situada en Auchy-au-Bois, es un establecimiento cálido y acogedor que sirve sabrosa cocina tradicional. Tanto si está de paso por la región como si vive cerca, esta brasserie es el lugar ideal para pasar un momento agradable y disfrutar de una buena comida."
    ],
    "nl": [
      "Brasserie Le Vert Dragon, gelegen in Auchy-au-Bois, is een warm en vriendelijk etablissement dat smakelijke traditionele gerechten serveert. Of je nu op doorreis bent of in de buurt woont, deze brasserie is de ideale plek om een aangenaam moment door te brengen en te genieten van lekker eten."
    ]
  },
