  "rdfs:comment": {
    "de": [
      "Violay gehört zu den 10 Startorten des neu geschaffenen Trail Forez-Est in der Region. Erkunden Sie diese 4 Strecken von 9, 16, 25,5 und 43 km, die vom Place Fouillat am Ortseingang (von Balbigny kommend) aus starten."
    ],
    "en": [
      "Violay is one of the 10 starting points for the newly-created Trail Forez-Est area. Come and explore these 4 trails of 9, 16, 25.5 and 43 km starting from Place Fouillat at the entrance to the village (coming from Balbigny)."
    ],
    "it": [
      "Violay è uno dei 10 punti di partenza del nuovo sentiero Forez-Est. Venite a scoprire questi 4 sentieri di 9, 16, 25,5 e 43 km partendo dalla Place Fouillat all'ingresso del villaggio (provenendo da Balbigny)."
    ],
    "fr": [
      "Violay fait partie des 10 sites de départs de l'espace Trail Forez-Est nouvellement créé sur le territoire.. Venez explorer ces 4 parcours de 9, 16, 25,5 et 43 km au départ de la place Fouillat à l'entrée de la commune (en venant de Balbigny)."
    ],
    "nl": [
      "Violay is een van de 10 startpunten van de nieuwe Trail Forez-Est. Kom en verken deze 4 routes van 9, 16, 25,5 en 43 km vanaf de Place Fouillat bij de ingang van het dorp (komend vanuit Balbigny)."
    ],
    "es": [
      "Violay es uno de los 10 puntos de partida del recién creado Trail Forez-Est. Venga a descubrir estos 4 senderos de 9, 16, 25,5 y 43 km que parten de la plaza Fouillat, a la entrada del pueblo (viniendo de Balbigny)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace trail Violay"
    ]
  },
