  "rdfs:comment": {
    "de": [
      "Vom Mont Vallon aus können Sie diese schwarze, hügelige Piste in einem wilden Gebiet befahren. Sie wird oft wenig begangen und ist ein wahres verstecktes Juwel!"
    ],
    "en": [
      "From the top of Mont Vallon gondola, take this black undulate run in a wild a wild environnement. Little used, it's a hidden pearl of the Méribel ski area !"
    ],
    "it": [
      "Partendo da Mont Vallon, percorrete questo sentiero nero e ondulato attraverso un'area selvaggia. Spesso poco utilizzato, è un vero gioiello nascosto!"
    ],
    "fr": [
      "Au départ du Mont Vallon, empruntez cette piste noire vallonnée dans un secteur sauvage. Souvent peu fréquentée, c'est un vrai joyau caché !"
    ],
    "nl": [
      "Vertrek vanaf Mont Vallon en neem deze heuvelachtige zwarte piste in een ongerept gebied. Deze piste wordt vaak weinig gebruikt en is een echte verborgen parel!"
    ],
    "es": [
      "Partiendo de Mont Vallon, tome este sendero negro y ondulado a través de una zona salvaje. A menudo poco frecuentado, ¡es una auténtica joya escondida!"
    ]
  },
  "rdfs:label": {
