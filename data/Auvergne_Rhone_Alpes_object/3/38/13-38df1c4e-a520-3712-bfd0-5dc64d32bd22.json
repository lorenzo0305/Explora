  "rdfs:comment": {
    "de": [
      "Wir das Orchester\r\n1h30\r\n\r\nVorführung in Anwesenheit des Regisseurs Philippe Béziat und anschließendem Gespräch.\r\nIn Partnerschaft mit dem Verein Les Écrans de la Drôme und dem Konservatorium von Montélimar.\r\n\r\nRegie: Philippe Béziat\r\nFrankreich / Dokumentarfilm"
    ],
    "en": [
      "We the orchestra\r\n1h30\r\n\r\nScreening in the presence of director Philippe Béziat, followed by a discussion.\r\nIn partnership with Les Écrans de la Drôme and the Montélimar Conservatory.\r\n\r\nDirected by Philippe Béziat\r\nFrance / documentary"
    ],
    "it": [
      "Noi l'orchestra\r\n1h30\r\n\r\nProiezione con il regista Philippe Béziat, seguita da un dibattito.\r\nIn collaborazione con Les Écrans de la Drôme e il Conservatorio di Montélimar.\r\n\r\nDiretto da Philippe Béziat\r\nFrancia / documentario"
    ],
    "fr": [
      "Nous l’orchestre\r\n1h30\r\n\r\nProjection en présence du réalisateur, Philippe Béziat, et suivie d’un échange.\r\nEn partenariat avec l’association Les Écrans de la Drôme et le Conservatoire de Montélimar.\r\n\r\nRéalisé par Philippe Béziat\r\nFrance / documentaire"
    ],
    "nl": [
      "Wij het orkest\r\n1h30\r\n\r\nVertoning met regisseur Philippe Béziat, gevolgd door een discussie.\r\nIn samenwerking met Les Écrans de la Drôme en het Conservatorium van Montélimar.\r\n\r\nRegie: Philippe Béziat\r\nFrankrijk / documentaire"
    ],
    "es": [
      "Nosotros la orquesta\r\n1h30\r\n\r\nProyección con el director Philippe Béziat, seguida de coloquio.\r\nEn colaboración con Les Écrans de la Drôme y el Conservatorio de Montélimar.\r\n\r\nDirigida por Philippe Béziat\r\nFrancia / documental"
    ]
