  "rdfs:comment": {
    "de": [
      "Japanisches Restaurant, das japanische und chinesische Gerichte anbietet, mit einem Sushi-Angebot, das Sie vor Ort genießen oder mitnehmen können. Aber auch chinesische Fertiggerichte für diejenigen, die keinen rohen Fisch mögen."
    ],
    "en": [
      "Japanese restaurant offering Japanese and Chinese dishes, with sushi to eat in or take away. But also Chinese ready-made dishes for those who don't like raw fish."
    ],
    "it": [
      "Ristorante giapponese che serve piatti giapponesi e cinesi, con sushi da mangiare o da portare via. Sono disponibili anche piatti cinesi già pronti per chi non ama il pesce crudo."
    ],
    "fr": [
      "Restaurant japonnais qui propose des plats nippon et chinois avec une offre de sushis à déguster sur place ou à emporter. Mais aussi des plats cuisinés chinois pour les personnes qui n'aiment pas le poisson cru."
    ],
    "es": [
      "Restaurante japonés que sirve platos japoneses y chinos, con sushi para comer en el local o para llevar. También hay platos chinos preparados para los que no les guste el pescado crudo."
    ],
    "nl": [
      "Japans restaurant dat Japanse en Chinese gerechten serveert, met sushi om te eten of om mee te nemen. Er zijn ook kant-en-klare Chinese gerechten voor wie niet van rauwe vis houdt."
    ]
  },
