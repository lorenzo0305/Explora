  "rdfs:comment": {
    "de": [
      "Kommen Sie eine frische und hausgemachte Gastronomie in einem einzigartgen Rahmen am Rande des Wassers mit seinen Panoramaterrassen und seinem Privatparkplatz entdecken."
    ],
    "en": [
      "Discover fresh homemade food in a unique setting, on the water's edge with its own panoramic terrace and private car park."
    ],
    "it": [
      "Vieni a scoprire una ristorazione fresca e casareccia in una cornice unica in riva al fiume, con una terrazza panoramica e un parcheggio privato. Ti accogliamo anche per i tuoi seminari, riunioni, cocktail, matrimoni ed eventi personalizzati."
    ],
    "fr": [
      "Venez découvrir une restauration fraîche faite maison dans un cadre unique au bord de l’eau avec sa terrasse panoramique et son parking privatif."
    ],
    "es": [
      "Ofrecemos platos frescos y caseros en un marco único, junto al agua, con terraza panorámica y aparcamiento privado."
    ],
    "nl": [
      "Kom en ontdek verse huisgemaakte gerechten in een unieke omgeving aan het water met een panoramisch terras en een eigen parkeerplaats."
    ]
  },
