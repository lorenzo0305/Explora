  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d3c3449f-b616-3fdc-8808-507cf9363772",
      "dc:description": {
        "de": [
          "Entdecken Sie mit dem Kajak oder der Piroge eine der schönsten Buchten der Welt, ihre Fauna, Flora und Robben: die Baie de Somme!\nVa'a en baie de Somme bietet Ihnen seine Aktivitäten in der freien Natur und Wanderungen mit begeisterten Führern an."
        ],
        "en": [
          "By kayak or pirogue, discover one of the most beautiful bays in the world, its fauna, its flora, its seals: the Bay of the Somme!\nVa'a en baie de Somme offers you its outdoor activities and hikes with passionate guides."
        ],
        "it": [
          "In kayak o in canoa, scoprite una delle baie più belle del mondo, la sua fauna, la sua flora, le sue foche: la Baie de Somme!\nVa'a en baie de Somme vi offre le sue attività all'aperto e le sue escursioni con guide appassionate."
        ],
        "fr": [
          "En kayak ou pirogue , partez à la découverte de l'une des plus belles baies du monde, de sa faune, sa flore, ses phoques : la Baie de Somme !\nVa'a en baie de Somme vous propose ses activités de pleine nature et de randonnées avec des guides passionnés."
        ],
        "nl": [
          "Ontdek per kajak of kano een van de mooiste baaien ter wereld, zijn fauna, zijn flora, zijn zeehonden: de Baie de Somme!\nVa'a en baie de Somme biedt u zijn outdoor activiteiten en wandelingen met gepassioneerde gidsen."
        ],
        "es": [
          "En kayak o canoa, descubra una de las bahías más bellas del mundo, su fauna, su flora, sus focas: ¡la Bahía de Somme!\nVa'a en baie de Somme le ofrece sus actividades al aire libre y excursiones con guías apasionados."
        ]
      },
      "@type": [
        "Description"
      ],
