  "rdfs:comment": {
    "de": [
      "Im Herzen eines mittelalterlichen Dorfes mit alten Befestigungsmauern (Wehrgang, Panorama auf den Lac du Sautet): Geburtshaus von Maximin Giraud, Zeuge der Marienerscheinung Notre-Dame de La Salette 1846 zusammen mit Mélanie Calvat, Alambic aus 1860. 200 m weiter: Haus von Mélanie (Museum). Auf der Route Napoléon."
    ],
    "en": [
      "Medieval fortified village with ancient ramparts (battlements, views over Lac du Sautet), birthplace of Maximin Giraud (witness with Mélanie Calvat to the apparition of Notre-Dame de La Salette in 1846), century-old 1860 alambic still in use. 200 m away: Mélanie’s birthplace (museum with ex-votos). On the Route Napoléon."
    ],
    "it": [
      "Villaggio medievale fortificato con antiche mura (porte, cammino di ronda, viste sul lago del Sautet), casa natale di Maximin Giraud (testimone con Mélanie Calvat dell’apparizione di Notre-Dame de La Salette 1846), alambicco del 1860. A 200 m: casa di Mélanie (museo). Sulla Route Napoléon."
    ],
    "fr": [
      "Village médiéval fortifié aux remparts, maison natale Maximin Giraud (apparition Notre-Dame de La Salette 1846 avec Mélanie Calvat), alambic 1860. À 200 m : maison Mélanie (musée). Route Napoléon."
    ],
    "es": [
      "Pueblo medieval fortificado con murallas, lugar de nacimiento de Maximin Giraud (aparición Notre-Dame de La Salette 1846 con Mélanie Calvat), todavía 1860. A 200 m: Maison Mélanie (museo). Route Napoléon."
    ],
    "nl": [
      "Middeleeuws versterkt dorp met oude wallen, geboortehuis van Maximin Giraud (getuige van de verschijning Notre-Dame de La Salette 1846 met Mélanie Calvat), alambiek uit 1860. Op 200 m: huis van Mélanie (museum). Route Napoléon."
    ]
  },
  "rdfs:label": {
    "en": [
      "Distillery La Salettina"
    ],
    "fr": [
      "Maison Salettina Distillerie"
    ]
  },
