  "rdfs:comment": {
    "de": [
      "Atelier - Boutique für handgefertigte Kerzen.\r\nVerschiedene Kreationen je nach Jahreszeit.\r\nAber auch Raumdiffusoren, Schrankkiesel, Autodiffusoren...\r\nEine ganze Palette an Düften, um Ihr Zuhause gesund zu parfümieren!"
    ],
    "en": [
      "Workshop - boutique for handmade candles.\r\nDifferent creations depending on the season.\r\nBut also room diffusers, wardrobe pebbles, car diffusers...\r\nA whole range of scents to perfume your home healthily!"
    ],
    "it": [
      "Laboratorio - boutique di candele fatte a mano.\r\nCreazioni diverse a seconda della stagione.\r\nMa anche diffusori per ambienti, ciottoli per armadi, diffusori per auto...\r\nUn'intera gamma di profumi per profumare la vostra casa in modo sano!"
    ],
    "fr": [
      "Atelier - boutique de bougies artisanales.\r\nDifférentes créations selon les saisons.\r\nMais également diffuseurs d'ambiance, galets d'armoire, diffuseurs de voiture...\r\nToute une gamme de senteurs pour parfumer votre intérieur sainement !"
    ],
    "nl": [
      "Workshop - boetiek voor handgemaakte kaarsen.\r\nVerschillende creaties afhankelijk van het seizoen.\r\nMaar ook ruimteverspreiders, garderobekorrels, autodiffusors...\r\nEen hele reeks geuren om je huis gezond te parfumeren!"
    ],
    "es": [
      "Taller - boutique de velas artesanales.\r\nDiferentes creaciones según la temporada.\r\nPero también difusores de ambiente, guijarros de armario, difusores de coche...\r\nToda una gama de aromas para perfumar su hogar de forma saludable"
    ]
  },
  "rdfs:label": {
