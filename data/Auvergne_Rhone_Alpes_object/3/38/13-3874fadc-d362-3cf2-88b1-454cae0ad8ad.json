  "rdfs:comment": {
    "de": [
      "Das im Espace Loisirs gelegene Wassersportzentrum bietet Ihnen: Wellenbad, Rutschen, Planschbecken, Innen- und Außenbecken, Ballonabwurf.\r\n Entdecken Sie einen ganz neuen Plan der Wasseraktivitäten."
    ],
    "en": [
      "Located in the Espace Loisirs, the aquatic center offers you: wave pool, slides, paddling pools, indoor and outdoor pools, balloon release.\r\nDiscover a brand new schedule of aquatic activities."
    ],
    "it": [
      "Nell'Espace Loisirs, il centro acquatico offre: piscina a onde, scivoli, piscina per bambini, piscina coperta, lancio di palloncini. Scoprite di più sulle nostre attività acquatiche e sui corsi di aquafitness."
    ],
    "fr": [
      "Dans l'Espace Loisirs, le centre aquatique offre : piscine à vagues, toboggans, pataugeoires, bassin intérieur, lâché de ballons. Découvrez notre planning d'activités aquatiques, cours d'aquafitness."
    ],
    "nl": [
      "In het Espace Loisirs biedt het aquacentrum: golfslagbad, glijbanen, peuterbad, overdekt zwembad, ballonoplaten. Kom meer te weten over onze wateractiviteiten en aquafitnesslessen."
    ],
    "es": [
      "En el Espace Loisirs, el centro acuático ofrece: piscina de olas, toboganes, piscina infantil, piscina cubierta, suelta de globos. Infórmese sobre nuestras actividades acuáticas y clases de aquafitness."
    ]
  },
