  "rdfs:comment": {
    "de": [
      "Les Garidelles ist ein Weingut, das am Fuße des Waldes von Païolive und des Hügels des Dorfes Banne liegt. Anne-Laure und Sebastien heißen Sie herzlich willkommen, um ihre Bio-Weine zu probieren, ihre Weinbereitungsmethoden kennenzulernen und sich bei einem Glas auszutauschen."
    ],
    "en": [
      "Les Garidelles is a winery nestling at the foot of the Bois de Païolive and the hillside village of Banne. Anne-Laure and Sebastien welcome you to taste their organic wines, discover their winemaking methods and chat over a glass of wine."
    ],
    "it": [
      "Les Garidelles è un'azienda vinicola situata ai piedi del Bois de Païolive e del villaggio collinare di Banne. Anne-Laure e Sebastien vi danno il benvenuto per degustare i loro vini biologici, scoprire i loro metodi di vinificazione e chiacchierare davanti a un bicchiere."
    ],
    "fr": [
      "Les Garidelles est un domaine vinicole niché au pied du bois de Païolive et de la colline du village de Banne. Anne-Laure et Sebastien vous y accueillent pour déguster leurs vins bio, découvrir leurs méthodes de vinification et échanger autour d'un verre."
    ],
    "nl": [
      "Les Garidelles is een wijnhuis genesteld aan de voet van het Bois de Païolive en het heuveldorp Banne. Anne-Laure en Sebastien heten je welkom om hun biologische wijnen te proeven, hun vinificatiemethoden te ontdekken en een praatje te maken onder het genot van een glas."
    ],
    "es": [
      "Les Garidelles es una bodega situada al pie del Bois de Païolive y del pueblo de Banne. Anne-Laure y Sébastien te dan la bienvenida para que pruebes sus vinos ecológicos, descubras sus métodos de elaboración y charles con una copa."
    ]
  },
