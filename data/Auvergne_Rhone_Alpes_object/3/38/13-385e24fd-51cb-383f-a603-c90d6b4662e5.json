  "rdfs:comment": {
    "de": [
      "Foodtruck mit süßen Crêpes und Buchweizenpfannkuchen.\r\nWährend der Schulzeit im Lycée des Catalins (Haupteingang).\r\nAuf Anfrage auf Veranstaltungen in der Region und bei Privatpersonen."
    ],
    "en": [
      "Food truck serving sweet crêpes and buckwheat pancakes.\r\nSchool season at Lycée des Catalins (main entrance)\r\nOn request at local events and private homes."
    ],
    "it": [
      "Food truck con frittelle dolci e frittelle di grano saraceno.\r\nPeriodo scolastico al Lycée des Catalins (ingresso principale)\r\nSu richiesta, in occasione di eventi locali e in case private."
    ],
    "fr": [
      "Food truck de crêpes sucrées et galettes sarrasin.\r\nPériode scolaire au lycée des Catalins (entrée principale)\r\nA la demande sur les événements du territoire et chez les particuliers."
    ],
    "nl": [
      "Foodtruck met zoete crêpes en boekweitpannenkoeken.\r\nSchoolperiode in het Lycée des Catalins (hoofdingang)\r\nOp aanvraag bij lokale evenementen en privéwoningen."
    ],
    "es": [
      "Food truck con tortitas dulces y de trigo sarraceno.\r\nPeriodo escolar en el Liceo de los Catalinos (entrada principal)\r\nA petición en eventos locales y en domicilios particulares."
    ]
  },
