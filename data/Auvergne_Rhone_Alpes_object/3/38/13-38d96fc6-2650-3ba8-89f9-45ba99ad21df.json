  "rdfs:comment": {
    "de": [
      "Der Tier ist ein hübscher Bach, der sich durch die Wiesen schlängelt und Ihnen märchenhafte Momente beschert, in denen das Forellenangeln für Sie nie subtiler sein wird."
    ],
    "en": [
      "A beautiful stream winding through the meadows, the Tier will offer you enchanting moments where trout fishing will never have been so subtle for you."
    ],
    "it": [
      "Un bellissimo torrente che serpeggia tra i prati, il Tier vi offrirà momenti incantevoli in cui la pesca alla trota non sarà mai stata così sottile per voi."
    ],
    "fr": [
      "Joli ruisseau serpentant à travers les prés, le Tier vous offrira des moments féeriques ou la pêche de la truite n'aura jamais été aussi subtile pour vous."
    ],
    "es": [
      "Hermoso arroyo que serpentea por los prados, el Tier le ofrecerá momentos encantadores en los que la pesca de la trucha nunca le habrá resultado tan sutil."
    ],
    "nl": [
      "Een prachtige beek die door de weilanden kronkelt, de Tier zal u betoverende momenten bieden waarbij het vissen op forel nog nooit zo subtiel voor u is geweest."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tier"
    ]
  },
