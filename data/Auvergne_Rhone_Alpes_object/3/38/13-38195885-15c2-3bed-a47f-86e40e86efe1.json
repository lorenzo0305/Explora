  "rdfs:comment": {
    "de": [
      "Eine Anlage aus der Zeit vor 1831. Die mit einer großen Schleuse verbundene Mühle Pont du Fraysse besteht aus zwei rechtwinklig zueinander stehenden, einstöckigen Gebäuden. Ihr Dach aus heimischem Schiefer und ihre renovierten Fassaden zeigen das Interesse der Eigentümer."
    ],
    "en": [
      "A site dating from before 1831. Associated with a large lock, the Pont du Fraysse mill consists of two perpendicular, single-storey buildings. Its local lauze roof and renovated facades demonstrate the interest shown by the owners."
    ],
    "it": [
      "Sito risalente a prima del 1831. Associato a una grande chiusa, il mulino Pont du Fraysse è costituito da due edifici perpendicolari a un piano. Il tetto in lauze locali e le facciate rinnovate dimostrano l'interesse dei proprietari."
    ],
    "fr": [
      "Un site datant d'avant 1831. Associé à une grande écluse, le moulin du Pont du Fraysse est composé de deux bâtiments perpendiculaires à étage. Sa toiture en lauze du pays et ses façades rénovées montrent l’intérêt que portent les propriétaires."
    ],
    "es": [
      "Un emplazamiento anterior a 1831. Asociado a una gran esclusa, el molino de Pont du Fraysse consta de dos edificios perpendiculares de una sola planta. Su tejado de lauz local y sus fachadas renovadas demuestran el interés de los propietarios."
    ],
    "nl": [
      "Een site die dateert van voor 1831. De molen van Pont du Fraysse is verbonden met een grote sluis en bestaat uit twee loodrecht op elkaar staande gebouwen van één verdieping. Het plaatselijke dak met gaas en de gerenoveerde gevels tonen de interesse van de eigenaars."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Moulin du Pont de Fraysse"
    ]
  },
