  "rdfs:comment": {
    "de": [
      "Unsere Brasserie liegt im Herzen des Dorfes und bietet einen warmen und einladenden Rahmen, um sich mit Freunden, der Familie oder Kollegen zu treffen."
    ],
    "en": [
      "Located in the heart of the village, our brasserie offers a warm and welcoming setting for getting together with friends, family or colleagues."
    ],
    "it": [
      "Situata nel cuore del villaggio, la nostra brasserie offre un ambiente caldo e accogliente per riunirsi con amici, familiari o colleghi."
    ],
    "fr": [
      "Située en plein cœur du village, notre brasserie offre un cadre chaleureux et accueillant pour se retrouver entre amis, en famille ou entre collègues."
    ],
    "es": [
      "Situada en el corazón del pueblo, nuestra brasserie ofrece un ambiente cálido y acogedor para reunirse con amigos, familiares o compañeros de trabajo."
    ],
    "nl": [
      "Onze brasserie ligt in het hart van het dorp en biedt een warme en uitnodigende omgeving om samen te komen met vrienden, familie of collega's."
    ]
  },
