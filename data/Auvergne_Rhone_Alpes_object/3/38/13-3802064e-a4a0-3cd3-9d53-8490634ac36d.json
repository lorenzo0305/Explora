  "rdfs:comment": {
    "de": [
      "Der Elternverein von Barbières, Les Barbillons, organisiert für die Schule von Barbières ein Lotto, bei dem Sie vielleicht viele Preise gewinnen können! Kommen Sie zahlreich!"
    ],
    "en": [
      "Les Barbillons, the Barbières parents' association, is organizing a bingo for the Barbières school, with a chance to win lots of prizes! Come one, come all!"
    ],
    "it": [
      "Les Barbillons, l'associazione dei genitori di Barbières, organizza una tombola per la scuola di Barbières, con la possibilità di vincere tanti premi! Non mancate!"
    ],
    "fr": [
      "L'association des parents d'élèves de Barbières, les Barbillons, organise pour l'école de Barbières, un loto au cours duquel vous pourrez peut-être remporter de nombreux lots ! Venez nombreux !"
    ],
    "es": [
      "Les Barbillons, la asociación de padres de Barbières, organiza un bingo para la escuela de Barbières, ¡con la posibilidad de ganar muchos premios! ¡Anímate a participar!"
    ],
    "nl": [
      "Les Barbillons, de oudervereniging van Barbières, organiseert een bingo voor de school van Barbières, met kans op heel veel prijzen! Kom in groten getale langs!"
    ]
  },
  "rdfs:label": {
