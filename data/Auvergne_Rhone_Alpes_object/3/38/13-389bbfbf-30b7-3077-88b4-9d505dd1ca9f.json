  "rdfs:comment": {
    "de": [
      "Kleine oder große Abenteurer, Sie werden es lieben, sich zu verlieren! Löse das Rätsel der Farm der Genüsse!"
    ],
    "en": [
      "Little or big adventurers, you will love to lose yourself! Come solve the riddle of the farm of delights!"
    ],
    "it": [
      "Divertitevi nel nostro campo di grano trasformato in un labirinto gigante. Usate il cervello per risolvere un indovinello che cambia ogni anno! Il delizioso gelato come ricompensa delizierà ogni palato! Per tutta l'estate, non è necessaria la prenotazione."
    ],
    "fr": [
      "Amusez-vous dans notre champs de maïs transformé en labyrinthe géant. Faites marcher vos méninges pour résoudre une énigme qui change chaque année! La délicieuse glace en récompense ravira toutes les papilles ! Tout l'été, sans réservation."
    ],
    "nl": [
      "Leef je uit in ons maïsveld dat is omgetoverd tot een gigantisch doolhof. Gebruik je hersenen om een raadsel op te lossen dat elk jaar verandert! Het heerlijke ijs als beloning zal elke smaakpapil bekoren! De hele zomer door, reserveren niet nodig."
    ],
    "es": [
      "Diviértete en nuestro maizal transformado en un laberinto gigante. Usa tu cerebro para resolver un acertijo que cambia cada año ¡El delicioso helado como recompensa hará las delicias de todas las papilas gustativas! Todo el verano, sin necesidad de reserva."
    ]
  },
