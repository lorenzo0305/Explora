  "rdfs:comment": {
    "de": [
      "Die Tomaselli Collection bietet die Möglichkeit, in eine einzigartige Kunstsammlung einzutauchen, die ganz dem kreativen Schaffen in Lyon gewidmet ist, und ist gleichzeitig ein außergewöhnlicher Ort für die Organisation Ihrer Veranstaltungen."
    ],
    "en": [
      "The Tomaselli Collection offers immersion in a unique art collection, entirely devoted to Lyon's creativity, as well as being an exceptional venue for your events."
    ],
    "it": [
      "La Collezione Tomaselli offre l'opportunità di immergersi in una collezione d'arte unica, interamente dedicata al talento creativo lionese, oltre a essere un luogo eccezionale per l'organizzazione di eventi."
    ],
    "fr": [
      "La Tomaselli Collection offre une immersion dans une collection d'art unique, entièrement consacrée à la création lyonnaise, tout en étant un lieu d'exception pour l'organisation de vos événements."
    ],
    "es": [
      "La Colección Tomaselli le ofrece la oportunidad de sumergirse en una colección de arte única, enteramente dedicada al talento creativo lionés, además de ser un lugar excepcional para organizar sus eventos."
    ],
    "nl": [
      "De Tomaselli Collection biedt de mogelijkheid om je onder te dompelen in een unieke kunstcollectie, volledig gewijd aan het creatieve talent van Lyon, en is bovendien een uitzonderlijke locatie voor het organiseren van je evenementen."
    ]
  },
