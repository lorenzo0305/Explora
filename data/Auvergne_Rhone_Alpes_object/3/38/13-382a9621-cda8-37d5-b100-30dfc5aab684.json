  "rdfs:comment": {
    "de": [
      "Können Sie sich von Albiez-le-Jeune aus orientieren und alle Markierungen finden? Holen Sie Ihre Karte im Tourismusbüro von Albiez-Montrond ab und wählen Sie Ihre Strecke nach Schwierigkeitsgrad aus."
    ],
    "en": [
      "Starting from Albiez-le-Jeune, will you be able to find your way around and find all the markers? Pick up your map at the Albiez-Montrond Tourist Office and choose your route according to difficulty."
    ],
    "it": [
      "Partendo da Albiez-le-Jeune, riuscirete a orientarvi e a trovare tutte le indicazioni? Ritirate la vostra mappa all'Ufficio del Turismo di Albiez-Montrond e scegliete il vostro percorso in base alla difficoltà."
    ],
    "fr": [
      "Au départ d'Albiez-le-Jeune, saurez-vous vous orienter et trouver toutes les balises ? Récupérez votre carte à l'Office de tourisme d'Albiez-Montrond et choisissez votre parcours selon sa difficulté."
    ],
    "nl": [
      "Kun je vanuit Albiez-le-Jeune de weg vinden en alle wegwijzers vinden? Haal je kaart op bij het Office du Tourisme van Albiez-Montrond en kies je route op basis van de moeilijkheidsgraad."
    ],
    "es": [
      "Desde Albiez-le-Jeune, ¿será capaz de orientarse y encontrar todos los hitos? Recoja su mapa en la Oficina de Turismo de Albiez-Montrond y elija su itinerario en función de su dificultad."
    ]
  },
  "rdfs:label": {
    "de": [
      "Permanenter Orientierungslauf - Blaues und rotes Niveau"
    ],
    "en": [
      "Permanent Orienteering Course - Blue and red levels"
    ],
    "it": [
      "Percorso permanente di orienteering - Livelli blu e rosso"
    ],
    "fr": [
      "Parcours Permanent d’Orientation - Niveau bleu et rouge"
    ],
    "nl": [
      "Permanente oriëntatieloop - Blauwe en rode niveaus"
    ]
  },
