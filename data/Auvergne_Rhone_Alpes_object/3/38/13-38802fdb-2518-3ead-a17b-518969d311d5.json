  "rdfs:comment": {
    "de": [
      "(Wieder-)Entdecken Sie die Klippen des Château du Roy! In der Nähe der Domaine de Vizille können Sie unter den Überresten des Château du Roi klettern."
    ],
    "en": [
      "(Re)Discover the Falaise du Château du Roy! Close to the Domaine de Vizille, come and climb beneath the remains of the Château du Roi."
    ],
    "it": [
      "(Ri)Scoprite la rupe del Château du Roy! Vicino al Domaine de Vizille, venite ad arrampicarvi sotto i resti del Château du Roi."
    ],
    "fr": [
      "(Re)Découvrez la Falaise du château du Roy ! A proximité du Domaine de Vizille, venez grimper sous les vestiges du Château du Roi."
    ],
    "es": [
      "¡(Re)descubra el acantilado del Château du Roy! Cerca del Domaine de Vizille, ven a escalar bajo los restos del Château du Roi."
    ],
    "nl": [
      "(Her)ontdek de klif van het Château du Roy! Kom in de buurt van het Domaine de Vizille onder de overblijfselen van het Château du Roi klimmen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Site d'escalade du Château du Roy"
    ]
  },
