  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/68d90c41-e00b-3c8b-b74c-97b4f8bdc189",
      "dc:description": {
        "de": [
          "Suchen Sie ein gutes Restaurant (mit Zimmern) zwischen Reims und Laon, auf dem Weg zum Chemin des Dames? Le Relais de Fleurette heißt Sie in seinem Restaurant in Pontavert herzlich willkommen. Entdecken Sie eine einfallsreiche, traditionelle und regionale Küche!"
        ],
        "en": [
          "Looking for a good restaurant (with rooms) between Reims and Laon, on the Chemin des Dames route? Le Relais de Fleurette welcomes you to its restaurant in Pontavert. Discover inventive, traditional and regional cuisine!"
        ],
        "it": [
          "Cercate un buon ristorante (con camere) tra Reims e Laon, sul percorso Chemin des Dames? Il Relais de Fleurette vi dà il benvenuto nel suo ristorante a Pontavert. Scoprite una cucina inventiva, tradizionale e regionale!"
        ],
        "fr": [
          "Vous cherchez un bon Restaurant (avec chambres) entre Reims et Laon, sur la route du Chemin des Dames ? Le Relais de Fleurette vous accueille dans son restaurant de Pontavert. Découvrez une cuisine inventive, traditionnelle et régionale !"
        ],
        "es": [
          "¿Busca un buen restaurante (con habitaciones) entre Reims y Laon, en la ruta del Chemin des Dames? Le Relais de Fleurette le da la bienvenida a su restaurante de Pontavert. Descubra una cocina inventiva, tradicional y regional"
        ],
        "nl": [
          "Op zoek naar een goed restaurant (met kamers) tussen Reims en Laon, op de Chemin des Dames route? Le Relais de Fleurette heet je welkom in zijn restaurant in Pontavert. Ontdek de inventieve, traditionele en regionale keuken!"
        ]
      },
      "@type": [
        "Description"
      ],
