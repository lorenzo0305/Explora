  "rdfs:comment": {
    "de": [
      "Das Montagut-Museum bietet einen erzählenden, illustrierten und dokumentierten Rundgang, der die Industriegeschichte des Dorfes Saint-Sauveur-de-Montagut und seiner Umgebung beleuchtet, insbesondere die Geschichte der Seidenmühlenfabriken."
    ],
    "en": [
      "The Montagut Museum offers a narrative, illustrated and documented tour that highlights the industrial history of the village of Saint-Sauveur-de-Montagut and its surroundings, particularly the history of silk-throwing mills."
    ],
    "it": [
      "Il museo di Montagut offre un percorso narrativo, illustrato e documentato che mette in luce la storia industriale del villaggio di Saint-Sauveur-de-Montagut e della zona circostante, in particolare la storia dei mulini da seta."
    ],
    "fr": [
      "Le musée Montagut propose un parcours narratif, illustré et documenté, qui met en lumière l’histoire industrielle du village de Saint-Sauveur-de-Montagut et de ses environs, notamment l'histoire des fabriques de moulinage de soie."
    ],
    "nl": [
      "Het Montagut museum biedt een verhalende, geïllustreerde en gedocumenteerde rondleiding die de industriële geschiedenis van het dorp Saint-Sauveur-de-Montagut en de omgeving belicht, in het bijzonder de geschiedenis van de zijdefabrieken."
    ],
    "es": [
      "El museo de Montagut ofrece un recorrido narrativo, ilustrado y documentado que pone de relieve la historia industrial del pueblo de Saint-Sauveur-de-Montagut y sus alrededores, en particular la historia de las fábricas de seda."
    ]
  },
