  "rdfs:comment": {
    "de": [
      "Globe Trotters Boutique: alles für die Wanderung, Verleih von Elektrofahrrädern VTT-VTC.\r\nWandern, Radfahren, Schuhe, Sportswear.  Hausschuhe, Besteck, Picknick. Große Auswahl an Outdoor-Accessoires und -Geschenken."
    ],
    "en": [
      "Globe Trotters store: everything for hiking, mountain bike rentals.\r\nHiking, cycling, shoes, sportswear.  Slippers, cutlery, picnics. Wide range of outdoor accessories and gifts."
    ],
    "it": [
      "Globe Trotters shop: tutto per l'escursionismo, noleggio di mountain bike.\r\nEscursioni, ciclismo, scarpe, abbigliamento sportivo.  Pantofole, posate, picnic. Ampia gamma di accessori e regali per l'outdoor."
    ],
    "fr": [
      "Boutique Globe Trotters : tout pour la rando, location vélos électriques VTT-VTC.\r\nRando, vélo, chaussures, sportswear.  Pantoufles, coutellerie, pique-nique. Grand choix d'accessoires et cadeaux outdoor."
    ],
    "es": [
      "Tienda Globe Trotters: todo para el senderismo, alquiler de bicicletas de montaña.\r\nSenderismo, ciclismo, calzado, ropa deportiva.  Zapatillas, cubiertos, picnics. Amplia gama de accesorios y regalos para actividades al aire libre."
    ],
    "nl": [
      "Globe Trotters winkel: alles voor wandelen, mountainbikeverhuur.\r\nWandelen, fietsen, schoenen, sportkleding.  Slippers, bestek, picknicks. Ruime keuze aan outdooraccessoires en cadeaus."
    ]
  },
