  "rdfs:comment": {
    "de": [
      "Herstellung einer Kerze aus Pflanzenwachs und eines dekorativen Elements. Parallel dazu Atelier Manuel. (Zeit, in der das Wachs gefriert). Für Kinder im Alter von 7/11 Jahren. Material wird zur Verfügung gestellt."
    ],
    "en": [
      "Production of a vegetable wax candle and decorative element. Manual workshop in parallel. (time for the wax to set). For 7/11 year-olds. Materials supplied."
    ],
    "it": [
      "Realizzazione di una candela in cera vegetale e di un elemento decorativo. Laboratorio manuale in parallelo. (fino all'indurimento della cera). Per bambini di 7/11 anni. Materiale fornito."
    ],
    "fr": [
      "Fabrication d’une bougie en cire végétale et élément décoratif. Atelier Manuel en parallèle. (le temps que la cire fige). Pour les 7/11 ans. Matériel Fourni."
    ],
    "es": [
      "Elaboración de una vela de cera vegetal y elemento decorativo. Taller manual en paralelo. (hasta que la cera haya fraguado). Para niños de 7/11 años. Materiales proporcionados."
    ],
    "nl": [
      "Een plantaardige kaars en decoratief element maken. Handmatige workshop parallel. (totdat de was is uitgehard). Voor kinderen van 7/11 jaar. Meegeleverde materialen."
    ]
  },
