  "rdfs:comment": {
    "de": [
      "In einem warmen und freundlichen Rahmen bieten Ihnen der Chefkoch und sein Team gepflegte und abwechslungsreiche Menüs, eine Speisekarte und Spezialitäten. Überdachte Terrasse."
    ],
    "en": [
      "In a warm and friendly setting, the Chef and his team offer you a varied and carefully prepared menu, a menu and specialities. Covered terrace."
    ],
    "it": [
      "In un ambiente caldo e accogliente, lo chef e il suo team vi propongono un menu vario e ben studiato, una carta e delle specialità. Terrazza coperta."
    ],
    "fr": [
      "Dans un cadre chaleureux et convivial le Chef  et son équipe vous proposent des menus soignés et variés, une carte et des spécialités. Terrasse couverte."
    ],
    "nl": [
      "In een warm en vriendelijk kader bieden de chef en zijn team u een gevarieerde en doordachte kaart, een menu en specialiteiten. Overdekt terras."
    ],
    "es": [
      "En un ambiente cálido y acogedor, el Chef y su equipo le ofrecen un menú variado y bien pensado, una carta y especialidades. Terraza cubierta."
    ]
  },
