  "rdfs:comment": {
    "de": [
      "Cédric betreut Sie beim Klettern oder auf Klettersteigen - Anfänger oder Fortgeschrittene. Er bietet Ihnen die Möglichkeit, Neues zu entdecken, selbstständig zu werden, höher zu steigen und Fortschritte zu machen."
    ],
    "en": [
      "Cédric is your guide for climbing or via ferrata sessions - beginners or advanced. He will help you discover, become autonomous, go higher, progress."
    ],
    "it": [
      "Cédric vi accompagnerà in sessioni di arrampicata o di via ferrata - principianti o avanzati. Vi aiuterà a scoprire, a diventare autonomi, ad andare più in alto e a progredire."
    ],
    "fr": [
      "Cédric vous encadre lors de sessions d'escalade ou de via ferrata - initiation ou perfectionnement. IL fera découvrir, devenir autonome, aller plus haute, progresser."
    ],
    "es": [
      "Cédric te acompañará en sesiones de escalada o vía ferrata, para principiantes o avanzados. Te ayudará a descubrir, a ser autónomo, a llegar más alto y a progresar."
    ],
    "nl": [
      "Cédric neemt je mee op klim- of klettersteigsessies - beginners of gevorderden. Hij helpt je ontdekken, autonoom worden, hogerop komen en vooruitgang boeken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cédric Boissy - Moniteur escalade et Via Ferrata"
    ]
  },
