  "rdfs:comment": {
    "de": [
      "Um das Ende des Jahres zu feiern, erleuchten die Lichter von Saint-Gervais wieder die Stadt. Sobald die Nacht hereinbricht, wird Saint-Gervais in Licht gehüllt und enthüllt besinnliche und klangvolle Installationen, die Sie nicht gleichgültig lassen werden."
    ],
    "en": [
      "To celebrate the end of the year, the Lumières de Saint-Gervais lights festival returns to illuminate the town. As night falls, Saint-Gervais is bathed in light, revealing contemplative light and sound installations that are sure to impress."
    ],
    "it": [
      "Per festeggiare la fine dell'anno, le Luci di Saint-Gervais tornano a illuminare la città. Al calar della notte, Saint-Gervais si veste di luce e svela installazioni contemplative e sonore che non vi lasceranno indifferenti."
    ],
    "fr": [
      "Pour fêter la fin de l'année, les Lumières de Saint-Gervais reviennent illuminer la ville. Dès la nuit tombée, Saint-Gervais s’habille de lumière et dévoile des installations contemplatives et sonores qui ne vous laisseront pas indifférents."
    ],
    "es": [
      "Para celebrar el fin de año, las Lumières de Saint-Gervais vuelven a iluminar la ciudad. En cuanto caiga la noche, Saint-Gervais se engalanará de luces y desvelará instalaciones contemplativas y sonoras que le dejarán sin aliento."
    ],
    "nl": [
      "Om het einde van het jaar te vieren, zijn de Lumières de Saint-Gervais terug om de stad te verlichten. Zodra de avond valt, wordt Saint-Gervais gehuld in lichtjes en onthullen ze beschouwende en geluidsinstallaties die je ademloos zullen achterlaten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Gervais Mont-Blanc Festival of Lights"
    ],
    "it": [
      "Festival delle luci di Saint-Gervais Mont-Blanc"
    ],
    "fr": [
      "Lumières Saint-Gervais Mont-Blanc"
    ]
  },
