  "rdfs:comment": {
    "de": [
      "Das charmante mittelalterliche Dorf L'Hôpital-sous-Rochefort wurde auf einem Felsmassiv errichtet und überragt die Ufer des Anzon (Nebenfluss des Lignon). Das Dorf liegt an einer alten gallischen und später gallo-römischen Straße."
    ],
    "en": [
      "Built on a rocky massif, the charming medieval village of L'Hôpital-sous-Rochefort dominates the banks of the Anzon (a tributary of the Lignon). The village is on an ancient Gallic and then Gallo-Roman road."
    ],
    "it": [
      "Costruito su un massiccio roccioso, l'affascinante villaggio medievale di L'Hôpital-sous-Rochefort domina le rive dell'Anzon (affluente del Lignon). Il villaggio si trova su un'antica strada gallica e gallo-romana."
    ],
    "fr": [
      "Edifié sur un massif rocheux, le charmant village médiéval de L'Hôpital-sous-Rochefort domine les rives de l'Anzon (affluent du Lignon). Le village se trouve sur une ancienne route gauloise puis gallo-romaine."
    ],
    "nl": [
      "Het charmante middeleeuwse dorp L'Hôpital-sous-Rochefort, gebouwd op een rotsmassief, domineert de oevers van de Anzon (zijrivier van de Lignon). Het dorp ligt aan een oude Gallische en Gallo-Romeinse weg."
    ],
    "es": [
      "Construido sobre un macizo rocoso, el encantador pueblo medieval de L'Hôpital-sous-Rochefort domina las orillas del Anzón (afluente del Lignon). El pueblo está situado en una antigua vía gala y galo-romana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village pittoresque de l'Hôpital-sous-Rochefort"
    ]
  },
