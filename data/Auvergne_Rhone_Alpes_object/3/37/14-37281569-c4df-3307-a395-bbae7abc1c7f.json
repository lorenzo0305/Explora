      "@id": "https://data.datatourisme.fr/9c3a32c0-e73e-30f9-a59e-0db83f1136fa",
      "dc:description": {
        "de": [
          "Bistro / Resto - Hier finden Sie traditionelle Küche und Gerichte, die typisch für unsere Region sind.\nGanzjährig geöffnet außer montags und dienstags abends"
        ],
        "en": [
          "Bistro / Resto - Traditional cuisine and dishes typical of our region.\nOpen all year except Monday and Tuesday evenings"
        ],
        "it": [
          "Bistro / Resto - Cucina tradizionale e piatti tipici della nostra regione.\nAperto tutto l'anno, tranne il lunedì e il martedì sera"
        ],
        "fr": [
          "Bistro / Resto - Vous y trouverez de la cuisine traditionnelle et des plats typiquement de notre région.\nOuvert toute l'année sauf le lundi et le mardi soir"
        ],
        "nl": [
          "Bistro / Resto - Traditionele keuken en typische gerechten uit onze streek.\nHet hele jaar door geopend, behalve op maandag- en dinsdagavond"
        ],
        "es": [
          "Bistro / Resto - Cocina tradicional y platos típicos de nuestra región.\nAbierto todo el año excepto los lunes y martes por la noche"
        ]
      },
