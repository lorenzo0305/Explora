  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Freude am gemeinsamen Gärtnern im Gemeinschaftsgarten des Quartier de l'Aube am Montag- und Donnerstagvormittag. Haben Sie Lust, ein Stück Land auf biologische Weise zu bewirtschaften? Entdecken Sie die Kleingärten von Perrier und des Quartier de l'Aube."
    ],
    "en": [
      "Come and discover the pleasure of gardening together at the shared garden in the Aube district on Monday and Thursday mornings. Would you like to cultivate a plot of land organically? Discover the allotment gardens at Le Perrier and in the Aube district."
    ],
    "it": [
      "Venite a scoprire il piacere di fare giardinaggio insieme nell'orto condiviso nel quartiere dell'Aube il lunedì e il giovedì mattina. Volete coltivare un terreno in modo biologico? Scoprite gli orti di Le Perrier e il distretto dell'Aube."
    ],
    "fr": [
      "Venez découvrir le plaisir de jardiner ensemble au jardin partagé du quartier de l'Aube les lundis et jeudis matin. Envie de cultiver un lopin de terre de manière biologique ? Découvrez les jardins familiaux du Perrier et du quartier de l'Aube."
    ],
    "es": [
      "Venga a descubrir el placer de la jardinería juntos en el jardín compartido del barrio de Aube los lunes y jueves por la mañana. ¿Le gustaría cultivar un terreno de forma ecológica? Descubra los huertos de Le Perrier y el barrio del Aube."
    ],
    "nl": [
      "Kom op maandag- en donderdagochtend het plezier van samen tuinieren ontdekken in de gemeenschappelijke tuin in de wijk Aube. Wilt u een stuk grond biologisch bewerken? Ontdek de volkstuinen van Le Perrier en in de wijk Aube."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jardin familiaux de Die - Jardin partagés"
    ]
  },
