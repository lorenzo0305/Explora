  "rdfs:comment": {
    "de": [
      "Julie und Lucas laden Sie zu einer Geschmacksreise durch die Aromen der Region ein. Ihre kreative Küche veredelt lokale Produkte auf farbenfrohen und kühnen Tellern. Jedes Gericht erzählt eine Geschichte, jeder Bissen ist eine Entdeckung."
    ],
    "en": [
      "Julie and Lucas invite you on a gustatory journey to the heart of local flavors. Their creative cuisine sublimates local produce in bold, colorful dishes. Each dish tells a story, each bite a discovery."
    ],
    "it": [
      "Julie e Lucas vi invitano a un viaggio gustativo nel cuore dei sapori locali. La loro cucina creativa mette in mostra i prodotti locali in piatti audaci e colorati. Ogni piatto racconta una storia, ogni boccone una scoperta."
    ],
    "fr": [
      "Julie et Lucas vous invitent à un voyage gustatif au cœur des saveurs du terroir. Leur cuisine créative sublime les produits locaux dans des assiettes colorées et audacieuses. Chaque plat raconte une histoire, chaque bouchée est une découverte."
    ],
    "es": [
      "Julie y Lucas le invitan a un viaje gustativo al corazón de los sabores locales. Su cocina creativa muestra los productos locales en platos atrevidos y coloridos. Cada plato cuenta una historia, cada bocado un descubrimiento."
    ],
    "nl": [
      "Julie en Lucas nodigen je uit voor een culinaire reis naar het hart van de lokale smaken. Hun creatieve keuken laat lokale producten zien in gedurfde, kleurrijke gerechten. Elk gerecht vertelt een verhaal, elke hap is een ontdekking."
    ]
  },
  "rdfs:label": {
    "fr": [
      "l'Acte 2"
    ]
  },
