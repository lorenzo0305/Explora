  "rdfs:comment": {
    "de": [
      "L‘atelier de la gourmande organisiert verschiedenste Backkurse, die die jeweiligen Produkte der Saison und die Feste des Jahres zum Thema haben."
    ],
    "en": [
      "L'Atelier de la Gourmande organises cake-making workshops in all shapes and sizes, according to the season's ingredients and the festive calendar."
    ],
    "it": [
      "L'Atelier de la Gourmande offre sessioni di laboratorio di pasticceria divertenti e amichevoli, offrendo un'esperienza coinvolgente in cui i partecipanti possono imparare divertendosi."
    ],
    "fr": [
      "L'Atelier de la Gourmande propose des sessions d'ateliers de pâtisseries conviviaux et ludiques, offrant une expérience engageante où les participants peuvent apprendre tout en passant un bon moment."
    ],
    "es": [
      "L'Atelier de la Gourmande ofrece sesiones de talleres de pastelería divertidas y amistosas, proporcionando una experiencia atractiva en la que los participantes pueden aprender mientras se divierten."
    ],
    "nl": [
      "L'Atelier de la Gourmande biedt leuke en gezellige patisserie-workshopsessies, een boeiende ervaring waar deelnemers kunnen leren terwijl ze een leuke tijd hebben."
    ]
  },
