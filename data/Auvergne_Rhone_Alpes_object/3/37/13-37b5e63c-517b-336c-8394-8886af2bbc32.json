  "rdfs:comment": {
    "de": [
      "Theater aus Holz mit einem familienfreundlichen Programm\r\nAufführungen von: Theater, Musiktheater, Tanz, Marionetten, zügellose Leseshow, illustrierte Gedichte, improvisiertes Theater, Clown, neu interpretierte Klassiker.."
    ],
    "en": [
      "Wooden theatre, with family programming\r\nShows of: theatre, musical theatre, dance, puppets, unbridled reading and performance, illustrated poems, improvised theatre, clown, classics revisited.."
    ],
    "it": [
      "Teatro in legno, con programma per famiglie\r\nSpettacoli di: teatro, teatro musicale, danza, burattini, letture sfrenate, poesie illustrate, improvvisazioni teatrali, clown, classici rivisitati?"
    ],
    "fr": [
      "Théâtre en bois, avec une programmation familiale. \r\nSpectacles de : théâtre, théâtre musical, danse, marionnettes, lecture spectacle débridée, poèmes illustrés, théâtre improvisé, clown, classiques revisités…"
    ],
    "es": [
      "Teatro de madera, con un programa familiar\r\nEspectáculos de: teatro, teatro musical, danza, marionetas, lecturas desenfrenadas, poemas ilustrados, teatro improvisado, payasos, clásicos revisitados.."
    ],
    "nl": [
