  "rdfs:comment": {
    "de": [
      "Entdecken Sie die wilde Flora und die Naturräume des Zentralmassivs in den Gärten des Nationalen Botanischen Konservatoriums! Seit 1998 inventarisiert diese öffentliche Einrichtung die wilde Flora und Vegetation des Gebiets und trägt zu ihrer Erhaltung bei."
    ],
    "en": [
      "Come and discover the wild flora and natural spaces of the Massif Central in the gardens of the Conservatoire botanique national! Since 1998, this public establishment has been inventorying and helping to preserve the region's wild flora and vegetation."
    ],
    "it": [
      "Venite a scoprire la flora selvatica e le aree naturali del Massiccio Centrale nei giardini del Conservatorio Botanico Nazionale! Dal 1998, questa istituzione pubblica cataloga e contribuisce alla conservazione della flora e della vegetazione selvatica della regione."
    ],
    "fr": [
      "Venez découvrir la flore sauvage et les espaces naturels du Massif central dans les jardins du Conservatoire botanique national ! Depuis 1998, cet établissement public inventorie et contribue à préserver la flore et les végétations sauvages du territoire."
    ],
    "es": [
      "Venga a descubrir la flora salvaje y los espacios naturales del Macizo Central en los jardines del Conservatorio Botánico Nacional Desde 1998, esta institución pública cataloga y contribuye a preservar la flora y la vegetación salvajes de la región."
    ],
    "nl": [
      "Kom en ontdek de wilde flora en natuurgebieden van het Centraal Massief in de tuinen van het Nationaal botanisch conservatorium! Sinds 1998 heeft deze openbare instelling de wilde flora en vegetatie van de regio gecatalogiseerd en helpen behouden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conservatoire botanique national du Massif-Central"
    ]
  },
