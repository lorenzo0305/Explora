  "rdfs:comment": {
    "de": [
      "Bei der Begegnung mit Tieren, dem Zauberwald und den Spielen, die den Weg säumen, begeben Sie sich auf die Entdeckung eines einzigartigen und bezaubernden Ortes, der Sie wieder mit Ihrer Kinderseele verbinden wird."
    ],
    "en": [
      "Meet the animals, the magical forest and the games along the way, and discover a unique and enchanting place that will reconnect you with your childlike soul."
    ],
    "it": [
      "Incontrate gli animali, il bosco magico e i giochi lungo il percorso, e scoprite un luogo unico e incantevole che vi riconnetterà con la vostra anima infantile."
    ],
    "fr": [
      "À la rencontre des animaux, de la forêt magique et des jeux qui parsèment le chemin, partez à la découverte d'un lieu unique et enchanteur qui vous reconnectera à votre âme d'enfant."
    ],
    "nl": [
      "Maak onderweg kennis met de dieren, het magische bos en de spelletjes, en ontdek een unieke en betoverende plek die je weer in contact brengt met je kinderziel."
    ],
    "es": [
      "Conozca a los animales, el bosque mágico y los juegos del camino, y descubra un lugar único y encantador que le reconectará con el alma de su infancia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme culturelle et pédagogique l'Attrape-Rêves - Animaux, Jeux, Émerveillement"
    ]
  },
