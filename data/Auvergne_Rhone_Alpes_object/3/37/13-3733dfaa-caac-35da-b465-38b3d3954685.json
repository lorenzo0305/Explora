  "rdfs:comment": {
    "de": [
      "Abende mit erzählter Astronomie, begleitet von einer Kulturvermittlerin und Amateurastronomin, die sich für die Vermittlung der Freude an der Betrachtung des Sternenhimmels interessiert, einem Kultur- und Naturerbe der Menschheit, das es zu entdecken oder wiederzuentdecken gilt."
    ],
    "en": [
      "Astronomy evenings accompanied by a cultural mediator and amateur astronomer, keen to pass on the pleasure of contemplating the starry sky, a cultural and natural heritage of humanity to be discovered or rediscovered."
    ],
    "it": [
      "Serate di astronomia narrativa accompagnate da un mediatore culturale e astronomo dilettante, desideroso di trasmettere il piacere di contemplare il cielo stellato, patrimonio culturale e naturale dell'umanità da scoprire o riscoprire."
    ],
    "fr": [
      "Soirées d'astronomie contée accompagnées par une médiatrice culturelle et astronome amatrice, sensible à la transmission du plaisir de la contemplation du ciel étoilé, un patrimoine culturel et naturel de l’humanité à découvrir ou redécouvrir."
    ],
    "es": [
      "Veladas de astronomía contada acompañadas por un mediador cultural y astrónomo aficionado, deseoso de transmitir el placer de contemplar el cielo estrellado, patrimonio cultural y natural de la humanidad por descubrir o redescubrir."
    ],
    "nl": [
      "Avonden met astronomische verhalen onder begeleiding van een culturele bemiddelaar en amateur-astronoom, die graag het plezier van het bekijken van de sterrenhemel doorgeeft, een cultureel en natuurlijk erfgoed van de mensheid dat ontdekt of herontdekt moet worden."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Great Bear's Celestial walks"
    ],
    "fr": [
      "Les Balades Célestes de la Grande ourse"
    ]
  },
