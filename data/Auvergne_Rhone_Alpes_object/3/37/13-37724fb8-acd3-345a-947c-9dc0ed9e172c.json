  "rdfs:comment": {
    "de": [
      "Im Aux Hurle Vents erwarten Sie kleine Gerichte mit verschiedenen Geschmacksrichtungen, die mit Sorgfalt zubereitet werden. Sie werden eine hausgemachte Küche mit Produkten der Saison und aus der Region genießen. Pizzas und vegetarische Gerichte werden angeboten (auf Vorbestellung)."
    ],
    "en": [
      "Les Hurle Vents serves a variety of small dishes made with love. The homemade dishes use seasonal and local produce. Pizzas. Vegetarian dishes available to book. Mentioned by Michelin Vert, Bistrot de Pays. Traiteur."
    ],
    "it": [
      "Al Les Hurle Vents troverete piatti preparati con cura e con una grande varietà di sapori. Potrete gustare una cucina casalinga che utilizza prodotti di stagione e locali. Sono disponibili anche pizze e piatti vegetariani (su prenotazione)."
    ],
    "fr": [
      "Aux Hurle Vents, des petits plats aux saveurs variées confectionnés avec soin vous attendent. Vous dégusterez une cuisine maison avec des produits de saison et de terroir. Pizzas et cuisine végétarienne sont proposées (sur réservation)."
    ],
    "es": [
      "En Les Hurle Vents encontrará platos elaborados con esmero y variedad de sabores. Disfrutará de una cocina casera elaborada con productos locales y de temporada. También hay pizzas y platos vegetarianos (previa reserva)."
    ],
    "nl": [
      "Bij Les Hurle Vents vind je zorgvuldig bereide gerechten met verschillende smaken. Je zult genieten van huisgemaakte gerechten met seizoensgebonden en lokale producten. Pizza's en vegetarische gerechten zijn ook beschikbaar (reserveren verplicht)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Hurle Vents"
    ],
    "fr": [
      "Les Hurle-Vents"
    ]
  },
