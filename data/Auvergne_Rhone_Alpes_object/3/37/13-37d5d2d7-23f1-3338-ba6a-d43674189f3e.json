  "rdfs:comment": {
    "de": [
      "100m vom Bahnhof Le Signal entfernt, für Skifahrer und Nicht-Skifahrer zugänglich.\r\nGroße Panoramaterrasse mit atemberaubender Aussicht.\r\nSandwiches, Paninis, Suppen, warme Gerichte, Crêpes.\r\nHeiße und kalte Getränke."
    ],
    "en": [
      "100m from Signal station, accessible to skiers and non-skiers.\r\nLarge panoramic terrace with breathtaking views.\r\nSandwiches, paninis, soups, hot dishes, crêpes.\r\nHot and cold drinks."
    ],
    "it": [
      "a 100m dalla stazione del Signal, accessibile a sciatori e pedoni.  Grande terrazza panoramica con vista a 360°. \r\nSandwich, panini, minestre, piatti caldi, crêpe. Bevande calde e fredde.                          \r\nDa consumare in loco o da asporto"
    ],
    "fr": [
      "A 100m de la gare du Signal, accessible aux skieurs et non skieurs.\r\nGrande terrasse panoramique vue imprenable.\r\nSandwichs, paninis, soupes, plats chauds, crêpes.\r\nBoissons chaudes et froides."
    ],
    "es": [
      "A 100 m de la estación de Le Signal, accesible para esquiadores y no esquiadores.\r\nGran terraza panorámica con vistas impresionantes.\r\nBocadillos, paninis, sopas, platos calientes, crepes.\r\nBebidas frías y calientes."
    ],
    "nl": [
      "100m van het station Le Signal, toegankelijk voor skiërs en niet-skiërs.\r\nGroot panoramisch terras met adembenemend uitzicht.\r\nSandwiches, panini's, soepen, warme gerechten, crêpes.\r\nWarme en koude dranken."
    ]
  },
