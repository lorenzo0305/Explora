  "rdfs:comment": {
    "de": [
      "Im Herzen der mittelalterlichen Stadt Crémieu befindet sich das Maison Poloni, ein Boutique-Labor, das sich der handwerklichen Parfümerie und dem Wohlbefinden widmet. Aurélien, ein handwerklicher Parfümeur, kreiert hier natürliche Parfums nach Maß durch persönliche Betreuung."
    ],
    "en": [
      "In the heart of the medieval town of Crémieu, Maison Poloni is a boutique-laboratory dedicated to artisanal perfumery and well-being. Aurélien, an artisan perfumer, creates bespoke natural fragrances through personalised consultations."
    ],
    "it": [
      "Nel cuore della città medievale di Crémieu, la Maison Poloni è una boutique-laboratorio dedicata alla profumeria artigianale e al benessere. Aurélien, profumiere artigianale, crea fragranze naturali su misura attraverso un accompagnamento personalizzato."
    ],
    "fr": [
      "Au cœur de la cité médiévale de Crémieu, la Maison Poloni est une boutique-laboratoire dédiée à la parfumerie artisanale et au bien-être. Aurélien, artisan parfumeur, y crée des parfums naturels sur mesure à travers des accompagnements personnalisés."
    ],
    "nl": [
      "In het hart van de middeleeuwse stad Crémieu is Maison Poloni een boetiek-laboratorium gewijd aan ambachtelijke parfumerie en welzijn. Aurélien, een ambachtelijke parfumeur, creëert natuurlijke geuren op maat door middel van persoonlijke begeleiding."
    ],
    "es": [
      "En el corazón de la ciudad medieval de Crémieu, la Maison Poloni es una boutique-laboratorio dedicada a la perfumería artesanal y al bienestar. Aurélien, perfumista artesano, crea fragancias naturales a medida mediante un acompañamiento personalizado."
    ]
  },
