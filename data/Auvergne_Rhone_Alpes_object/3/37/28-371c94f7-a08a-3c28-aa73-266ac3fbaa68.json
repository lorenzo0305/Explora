  "rdfs:comment": {
    "de": [
      "Nutzen Sie die Basis Chabaud Latour: Leihen Sie sich ein Fahrrad, laden Sie Ihre Akkus auf, picknicken Sie und genießen Sie die Aussicht auf diesen fahrradfreundlichen Ort."
    ],
    "en": [
      "Take advantage of the Chabaud Latour base: rent a bike, recharge your batteries, have a picnic and enjoy the view from this cyclist-friendly site."
    ],
    "it": [
      "Approfittate della base di Chabaud Latour: noleggiate una bicicletta, fate il pieno di energia, fate un picnic e godetevi il panorama da questo sito adatto ai ciclisti."
    ],
    "fr": [
      "Profitez de la base Chabaud Latour : louez un vélo, rechargez vos batteries, pique-niquez et découvrez la vue sur ce site accueillant pour cyclistes."
    ],
    "nl": [
      "Profiteer optimaal van de vertrekhaven van Chabaud Latour: huur een fiets, laad je batterijen op, picknick en geniet van het uitzicht vanaf deze fietsvriendelijke plek."
    ],
    "es": [
      "Aproveche la base de Chabaud Latour: alquile una bicicleta, recargue las pilas, haga un picnic y disfrute de las vistas desde este lugar apto para ciclistas."
    ]
  },
