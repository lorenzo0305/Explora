  "rdfs:comment": {
    "de": [
      "Ein spielerischer und familienfreundlicher Parcours, um die Reichtümer des Parks der Domaine de Vizille zu entdecken. . Als Bonus können Sie mit der letzten Markierung, die sich auf einem Balkon im 3. Stock des Schlosses befindet, durch das Labyrinth des Revolutionsmuseums schlendern!"
    ],
    "en": [
      "A fun, family-friendly trail to discover the treasures of the Domaine de Vizille park . As a bonus, the last beacon, located on a balcony on the 3rd floor of the château, allows you to wander through the maze of the Musée de la Révolution!"
    ],
    "it": [
      "Un divertente percorso per famiglie alla scoperta dei tesori del parco del Domaine de Vizille. Come bonus, l'ultimo indicatore, situato su un balcone al 3° piano del castello, vi permetterà di passeggiare nel labirinto del Musée de la Révolution!"
    ],
    "fr": [
      "Parcours ludique et familial pour découvrir les richesses du parc  du Domaine de Vizille. . En bonus, la dernière balise, située sur un balcon au 3ème étage du château, vous permettra de déambuler dans le dédale du musée de la Révolution !"
    ],
    "es": [
      "Un divertido recorrido familiar para descubrir los tesoros del parque del Domaine de Vizille . Como extra, el último marcador, situado en un balcón de la 3ª planta del castillo, le permitirá pasear por el laberinto del Musée de la Révolution."
    ],
    "nl": [
      "Een leuk familiepad om de schatten van het park van het Domaine de Vizille te ontdekken. Als bonus kun je bij de laatste markering, op een balkon op de 3e verdieping van het kasteel, door het doolhof van het Musée de la Révolution dwalen!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Erbe Kind"
    ],
    "en": [
      "Children's heritage orientation course"
    ],
    "fr": [
      "Parcours d'orientation patrimoine enfant"
    ],
    "es": [
      "Curso de orientación sobre patrimonio infantil"
    ]
  },
