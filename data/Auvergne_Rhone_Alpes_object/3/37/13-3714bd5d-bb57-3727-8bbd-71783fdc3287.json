  "rdfs:comment": {
    "de": [
      "Entdecken oder wiederentdecken Sie die Freuden einer Schneeschuhwanderung mit Ihrem örtlichen Reiseleiter Julien.\r\n\r\nIn Bozel, Courchevel und Champagny wählen Sie Ihre Szenerie, um eine angenehme Zeit inmitten der Natur zu verbringen."
    ],
    "en": [
      "Discover or rediscover the joys of snowshoeing with your local guide Julien. \r\n\r\nIn Bozel, Courchevel and Champagny, choose your setting to spend a pleasant moment in the heart of nature."
    ],
    "it": [
      "Scoprite o riscoprite le gioie delle racchette da neve con la vostra guida locale Julien.\r\n\r\nA Bozel, Courchevel e Champagny, scegliete il vostro ambiente per trascorrere un momento piacevole nel cuore della natura."
    ],
    "fr": [
      "Découvrez ou redécouvrez les joies d’une balade en raquettes à neige avec votre guide local Julien. \r\n\r\nA Bozel, Courchevel et Champagny choisissez votre décor pour passer un agréable moment en pleine nature."
    ],
    "nl": [
      "Ontdek of herontdek het plezier van sneeuwschoenwandelen met je plaatselijke gids Julien.\r\n\r\nKies in Bozel, Courchevel en Champagny je omgeving om een aangenaam moment door te brengen in het hart van de natuur."
    ],
    "es": [
      "Descubra o redescubra los placeres de las raquetas de nieve con su guía local Julien.\r\n\r\nEn Bozel, Courchevel y Champagny, elija su entorno para pasar un momento agradable en plena naturaleza."
    ]
  },
  "rdfs:label": {
    "en": [
      "Brouilly Julien - Snowshoes"
    ],
    "fr": [
      "Brouilly Julien - Raquettes à neige"
    ]
  },
