      "@id": "https://data.datatourisme.fr/6e4c61f0-88f9-3966-b8ee-3d50f0887ffb",
      "dc:description": {
        "de": [
          "Entdecken Sie den Zauber des Weihnachtsmarktes, zwischen lokalem Kunsthandwerk, Leckereien und einer märchenhaften Atmosphäre für die ganze Familie."
        ],
        "en": [
          "Come and discover the magic of the Christmas market, with local crafts, delicacies and a magical atmosphere for the whole family."
        ],
        "it": [
          "Venite a scoprire la magia del mercatino di Natale, con artigianato locale, prelibatezze e un'atmosfera magica per tutta la famiglia."
        ],
        "fr": [
          "Venez découvrir la magie du marché de Noel, entre artisanat local, gourmandises et ambiance féérique pour toute la famille."
        ],
        "es": [
          "Venga a descubrir la magia del mercado navideño, con artesanía local, delicias y un ambiente mágico para toda la familia."
        ],
        "nl": [
          "Kom en ontdek de magie van de kerstmarkt, met lokale ambachten, lekkernijen en een magische sfeer voor het hele gezin."
        ]
      },
