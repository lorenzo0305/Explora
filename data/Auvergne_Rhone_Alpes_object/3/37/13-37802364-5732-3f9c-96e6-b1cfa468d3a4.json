  "rdfs:comment": {
    "de": [
      "Auf einer Fläche von 3.700 m² bietet er Spaziergängern einen Fußweg am Rande einer großen Wiese, einen Kinderspielplatz und begrünte Flächen."
    ],
    "en": [
      "This 3700 m² park offers walking routes along the edge of a large prairie, a children’s play area and planted areas."
    ],
    "it": [
      "Con una superficie di 3.700 m², offre agli escursionisti un percorso pedonale lungo il bordo di un grande prato, un parco giochi per bambini e aree piantumate."
    ],
    "fr": [
      "D'une superficie de 3 700 m², il offre aux promeneurs un cheminement piétonnier en bordure d'une grande prairie, une aire de jeux pour enfants et des espaces végétalisés."
    ],
    "nl": [
      "Met een oppervlakte van 3.700 m² biedt het wandelaars een wandelpad langs de rand van een grote weide, een kinderspeelplaats en beplante zones."
    ],
    "es": [
      "Con una superficie de 3.700 m², ofrece a los paseantes un camino peatonal a lo largo del borde de una gran pradera, un parque infantil y zonas plantadas."
    ]
  },
