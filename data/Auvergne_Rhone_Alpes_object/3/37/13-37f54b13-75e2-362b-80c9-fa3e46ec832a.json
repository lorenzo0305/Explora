  "rdfs:comment": {
    "de": [
      "Im Herzen des Tronçais-Waldes, \"dem schönsten Eichenwald Europas\", umfasst der Teich 45 Hektar und beherbergt eine familienfreundliche Freizeitanlage:"
    ],
    "en": [
      "In the heart of the Tronçais forest, \"the most beautiful oak forest in Europe\", the pond covers 45 hectares and is home to a family leisure center:"
    ],
    "it": [
      "Nel cuore della foresta di Tronçais, \"la più bella foresta di querce d'Europa\", lo stagno si estende per 45 ettari e ospita un centro ricreativo per famiglie:"
    ],
    "fr": [
      "Au coeur de la forêt de Tronçais, \"la plus belle chênaie d'Europe\", l'étang couvre 45 hectares et accueille une base de loisirs familiale:"
    ],
    "nl": [
      "In het hart van het bos van Tronçais, \"het mooiste eikenbos van Europa\", strekt de vijver zich uit over 45 hectare en is er een recreatiecentrum voor het hele gezin:"
    ],
    "es": [
      "En el corazón del bosque de Tronçais, \"el robledal más bello de Europa\", el estanque ocupa 45 hectáreas y alberga un centro de ocio familiar:"
    ]
  },
  "rdfs:label": {
