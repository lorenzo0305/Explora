  "rdfs:comment": {
    "de": [
      "Eine Ausstellung zur Feier des 140-jährigen Bestehens der Ets Fert im Dienste der Olive und des Scourtin.  Seit 2013 zeichnet das Museum fünf Generationen Familienabenteuer und die Geschichte des Scourtin nach ... und bereiten Sie auf den Besuch der Werkstatt im ersten Stock vor."
    ],
    "en": [
      "A unique exposition spot to celebrate 140 years of Scourtinerie Fert in the context of the olive and the fabrication of scourtins. Heritage of Provence. 5 generations of family adventure explained in memorial pictures and videos will prepare you to go upstairs and see a demonstration of scourtin fabrication on 1st floor."
    ],
    "it": [
      "Una mostra per celebrare i 140 anni di Ets Fert al servizio dell'oliva e dello scourtin.  Dal 2013, il museo ripercorre 5 generazioni di avventure familiari e la storia dello scourtin... e vi prepara alla visita del laboratorio al 1° piano."
    ],
    "fr": [
      "Une exposition pour fêter les 140 ans des Ets Fert au service de l'olive et du scourtin.  Depuis 2013 Le musée retrace 5 générations d'aventure familiale et d'histoire du scourtin ... et vous préparent à la visite de l'atelier au 1er étage."
    ],
    "es": [
      "Una exposición para celebrar los 140 años de Ets Fert al servicio de la aceituna y el scourtin.  Desde 2013, el museo recorre 5 generaciones de aventuras familiares y la historia del scourtin... y le prepara para la visita al taller de la 1ª planta."
    ],
    "nl": [
      "Een unieke plaats voor een expositie voor het vieren van 140 jaar Scourtinerie Fert in het kader van de olijf en mattenvlechterij. Cultureel erfgoed van de Provence. Geopend op 20 juli."
    ]
  },
