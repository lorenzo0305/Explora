  "rdfs:comment": {
    "de": [
      "Sophie und Bruno empfangen Sie in ihrem Restaurant in Bogève.\r\nGenießen Sie traditionelle und savoyische Küche in einer freundlichen und herzlichen Atmosphäre. Genießen Sie die Terrasse mit Blick auf das Tal."
    ],
    "en": [
      "Sophie and Bruno welcome you in their traditional restaurant in Bogève. Come and taste local dishes in a cozy place. Enjoy the patio for the view over the charming valley."
    ],
    "it": [
      "Sophie e Bruno vi danno il benvenuto nel loro ristorante a Bogève.\r\nGustate la cucina tradizionale savoiarda in un'atmosfera calda e accogliente. Godetevi la terrazza con vista sulla valle."
    ],
    "fr": [
      "Sophie et Bruno vous reçoivent dans leur restaurant à Bogève.\r\nDégustez une cuisine traditionnelle et savoyarde dans une ambiance conviviale et chaleureuse. Profitez de la terrasse avec vue sur la vallée."
    ],
    "es": [
      "Sophie y Bruno le dan la bienvenida a su restaurante en Bogève.\r\nDisfrute de la cocina tradicional de Saboya en un ambiente cálido y acogedor. Disfruta de la terraza con vistas al valle."
    ],
    "nl": [
      "Sophie en Bruno heten u welkom in hun restaurant in Bogève.\r\nGeniet van de traditionele Savoyaardse keuken in een warme en vriendelijke sfeer. Geniet van het terras met uitzicht op de vallei."
    ]
  },
