  "rdfs:comment": {
    "de": [
      "Der FFC-Mountainbike-Bereich umfasst 35 Strecken, die sich auf 11 \"Spots\" mit jeweils 1 bis 5 Strecken verteilen. Diese Strecken, die vom regionalen Naturpark Pilat markiert wurden, wurden so konzipiert, dass sie allen Profilen entsprechen."
    ],
    "en": [
      "The FFC mountain biking area features 35 circuits spread over 11 \"spots\", each with 1 to 5 itineraries. These routes, marked out by the Parc naturel régional du Pilat, have been designed to suit all profiles."
    ],
    "it": [
      "L'area FFC per la mountain bike conta 35 circuiti distribuiti in 11 \"spot\", ognuno dei quali presenta da 1 a 5 itinerari. Questi percorsi, tracciati dal Parco Naturale Regionale del Pilat, sono stati progettati per soddisfare tutte le abilità."
    ],
    "fr": [
      "L'espace VTT FFC, c'est 35 circuits répartis sur 11 \"spots\" de 1 à 5 itinéraires chacun. Ces parcours, balisés par le Parc naturel régional du Pilat, ont été réfléchis pour correspondre à tous les profils."
    ],
    "es": [
      "La zona BTT de la FFC cuenta con 35 circuitos repartidos en 11 \"spots\", cada uno de ellos con 1 a 5 itinerarios. Estas rutas, señalizadas por el Parque Natural Regional del Pilat, han sido diseñadas para adaptarse a todos los niveles."
    ],
    "nl": [
      "Het mountainbikegebied FFC telt 35 circuits verdeeld over 11 \"spots\", elk met 1 tot 5 routes. Deze routes, uitgezet door het Parc Naturel Régional du Pilat, zijn geschikt voor alle niveaus."
    ]
  },
  "rdfs:label": {
