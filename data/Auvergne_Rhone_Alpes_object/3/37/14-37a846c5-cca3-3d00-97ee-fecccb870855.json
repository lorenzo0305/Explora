      "dc:description": {
        "de": [
          "Caviste mit einer großen Auswahl an Bieren, Weinen, Whiskys, Rum... mit der Möglichkeit, vor Ort zu konsumieren, drinnen auf der Sonnenterrasse"
        ],
        "en": [
          "Cellar with a wide selection of beers, wines, whiskies, rum... with the possibility of drinking on site, indoors on a sunny terrace"
        ],
        "it": [
          "Cantina con un'ampia selezione di birre, vini, whisky, rum... con possibilità di bere sul posto, all'interno della terrazza soleggiata"
        ],
        "fr": [
          "Caviste avec un grand choix en bières, vins, whiskys, rhum... avec la possibilité de consommer sur place, à l'intérieur en terrasse ensoleillée"
        ],
        "nl": [
          "Kelder met een ruime keuze aan bieren, wijnen, whisky's, rum... met de mogelijkheid om ter plaatse te drinken, binnen op het zonnige terras"
        ],
        "es": [
          "Bodega con una amplia selección de cervezas, vinos, whiskies, ron... con la posibilidad de beber en el local, en el interior, en la soleada terraza"
