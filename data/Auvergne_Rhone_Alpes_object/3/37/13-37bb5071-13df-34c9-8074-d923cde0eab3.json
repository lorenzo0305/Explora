  "rdfs:comment": {
    "de": [
      "Restaurant mit japanischen Spezialitäten und Getränken vor Ort oder zum Mitnehmen (Sushi, Maki, Aperitifplatten, japanische Sandwiches, asiatische frittierte Ravioli).\r\nGesunde Küche, die zu 100 % hausgemacht ist und aus hochwertigen Zutaten besteht."
    ],
    "en": [
      "Restaurant serving Japanese specialities and drinks to eat in or take away (sushi, maki, aperitif platters, Japanese sandwiches, Asian fried ravioli)\r\nHealthy, 100% homemade food made with quality ingredients."
    ],
    "it": [
      "Ristorante che serve specialità giapponesi e bevande da mangiare o da portare via (sushi, maki, aperitivi, panini giapponesi, ravioli fritti asiatici).\r\nCibo sano e 100% casalingo con ingredienti di qualità."
    ],
    "fr": [
      "Restaurant de spécialités et boissons Japonaises sur place ou à emporter (Sushi, maki, plateaux apéritifs, Sandwichs Japonais, raviolis frits asiatiques).\r\nCuisine saine 100% faite Maison avec des ingrédients de qualité."
    ],
    "es": [
      "Restaurante de especialidades japonesas y bebidas para comer o llevar (sushi, maki, platos de aperitivo, bocadillos japoneses, raviolis fritos asiáticos).\r\nComida sana y 100% casera con ingredientes de calidad."
    ],
    "nl": [
      "Restaurant met Japanse specialiteiten en drankjes om te eten of mee te nemen (Sushi, maki, aperitiefschotels, Japanse broodjes, Aziatische gebakken ravioli).\r\nGezond 100% huisgemaakt eten met kwaliteitsingrediënten."
    ]
  },
