  "rdfs:comment": {
    "de": [
      "Im Herzen des belebten Dorfplatzes von La Moutade (Gemeinde Chambaron-sur-Morge) heißen Sie Manuella und Tony willkommen, um gute, traditionelle, hausgemachte Gerichte zu genießen."
    ],
    "en": [
      "In the heart of the square in the lively village of La Moutade (Commune de Chambaron-sur-Morge), Manuella and Tony welcome you to enjoy traditional homemade dishes."
    ],
    "it": [
      "Nel cuore della piazza del vivace villaggio di La Moutade (Comune di Chambaron-sur-Morge), Manuella e Tony vi accolgono per farvi gustare i piatti tradizionali fatti in casa."
    ],
    "fr": [
      "Au cœur de la place du village animé de La Moutade (Commune de Chambaron-sur-Morge), Manuella et Tony vous accueillent pour déguster de bons petits plats traditionnels faits maison."
    ],
    "nl": [
      "In het hart van het plein in het levendige dorp La Moutade (gemeente Chambaron-sur-Morge) heten Manuella en Tony je welkom om te genieten van traditionele huisgemaakte gerechten."
    ],
    "es": [
      "En el corazón de la plaza del animado pueblo de La Moutade (Comuna de Chambaron-sur-Morge), Manuella y Tony le dan la bienvenida para degustar platos caseros tradicionales."
    ]
  },
