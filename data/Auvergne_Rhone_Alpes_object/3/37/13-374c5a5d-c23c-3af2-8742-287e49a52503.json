  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Burg, die den Ursprung des Kurortes Montrond-les-Bains darstellt. Sie liegt auf einem runden Basalthügel und hatte die Aufgabe, die Furt der Loire zu verteidigen, die ein wichtiges Durchgangsgebiet war."
    ],
    "en": [
      "Explore the fortress which inspired the Montrond-les-Bains spa resort. It protected the major thoroughfare that was the Loire ford from the top of its round basalt hill."
    ],
    "it": [
      "Lasciatevi stupire dalla fortezza di Montrond-les-Bains. Da 0 a 99 anni, sarete immersi nell'epoca dei cavalieri, quando il forte, situato su una montagna rotonda, aveva il compito di difendere il guado sulla Loira."
    ],
    "fr": [
      "Laissez vous émerveiller par le château fort de Montrond-les-Bains. De 0 à 99 ans, on s’immerge au temps des chevaliers, où le fort, posté sur un mont rond, avait pour mission de défendre le gué sur la Loire."
    ],
    "nl": [
      "Laat u verrassen door het fort van Montrond-les-Bains. Van 0 tot 99 jaar oud wordt u ondergedompeld in de tijd van de ridders, toen het fort, gelegen op een ronde berg, tot taak had de doorgang over de Loire te verdedigen."
    ],
    "es": [
      "Déjese maravillar por la fortaleza de Montrond-les-Bains. De 0 a 99 años, se sumergirá en la época de los caballeros, cuando el fuerte, situado en una montaña redonda, tenía la misión de defender el vado sobre el Loira."
    ]
  },
