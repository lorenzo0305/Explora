  "rdfs:comment": {
    "de": [
      "Die in Le Chambon ansässige Klinik SSR du Chambon liegt 60 km von Saint-Etienne, 30 km von Yssingeaux und 45 km von Le Puy-en-Velay entfernt und bietet ein hochwertiges Umfeld."
    ],
    "en": [
      "Located 60 kilometers from Saint-Etienne, 30 kilometers from Yssingeaux and 45 kilometers from Le Puy-en-Velay, the SSR clinic in Le Chambon offers a quality environment."
    ],
    "it": [
      "Situata a 60 chilometri da Saint-Etienne, a 30 chilometri da Yssingeaux e a 45 chilometri da Le Puy-en-Velay, la clinica SSR du Chambon di Le Chambon offre un ambiente di qualità."
    ],
    "fr": [
      "Située à 60 kilomètres de Saint-Etienne et 30 kilomètres d'Yssingeaux et 45 kilomètres du Puy-en-Velay, la clinique SSR du Chambon, installée au Chambon, offre un environnement de qualité."
    ],
    "es": [
      "Situada a 60 kilómetros de Saint-Etienne, a 30 kilómetros de Yssingeaux y a 45 kilómetros de Le Puy-en-Velay, la clínica SSR du Chambon de Le Chambon ofrece un entorno de calidad."
    ],
    "nl": [
      "Gelegen op 60 kilometer van Saint-Etienne, 30 kilometer van Yssingeaux en 45 kilometer van Le Puy-en-Velay, biedt de kliniek SSR du Chambon in Le Chambon een kwaliteitsomgeving."
    ]
  },
