  "rdfs:comment": {
    "de": [
      "Buffalo Grill, ein Familienrestaurant, empfängt Sie in einer entspannten und herzlichen Atmosphäre. Mahlzeiten zu erschwinglichen Preisen in einer exotischen und geselligen Umgebung."
    ],
    "en": [
      "Buffalo Grill, a family restaurant, welcomes you in a relaxed and warm atmosphere. Meals at affordable prices in a friendly and exotic setting."
    ],
    "it": [
      "Il Buffalo Grill, ristorante a conduzione familiare, vi accoglie in un'atmosfera rilassata e calorosa. Pasti a prezzi accessibili in un ambiente rilassato e amichevole."
    ],
    "fr": [
      "Buffalo Grill, restaurant familial, vous accueille dans une atmosphère décontractée et chaleureuse. Repas à des prix accessibles dans un cadre dépaysant et convivial."
    ],
    "es": [
      "Buffalo Grill, un restaurante familiar, le da la bienvenida en un ambiente relajado y cálido. Comidas a precios asequibles en un ambiente relajado y agradable."
    ],
    "nl": [
      "Buffalo Grill, een familierestaurant, verwelkomt u in een ontspannen en warme sfeer. Maaltijden tegen betaalbare prijzen in een ontspannen en vriendelijke omgeving."
    ]
  },
