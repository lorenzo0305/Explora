  "rdfs:comment": {
    "de": [
      "Inmitten einer grünen Oase, am Rande eines Sees, entdecken Sie etwa 40 kleine Miniaturgärten, die die Landschaften des Hochsavoyischen Vorlandes in originellen und sehr blumigen Formen darstellen."
    ],
    "en": [
      "In the heart of an area of greenery on the shores of a lake, come and explore around forty miniature gardens representing the landscapes of the Haute-Savoie foreland in original, highly floral creations."
    ],
    "it": [
      "Nel cuore di una cornice verde, ai bordi di un lago, venite a scoprire una quarantina di piccoli giardini in miniatura che rappresentano i paesaggi dell'Alta Savoia in forme originali e molto floreali."
    ],
    "fr": [
      "Au cœur d'un écrin de verdure, aux abords d'un lac, venez découvrir une quarantaine de petits jardins miniatures représentant les paysages de l'avant pays haut savoyard sous des formes originales et très florales."
    ],
    "nl": [
      "Kom in het hart van een groene omgeving, aan de rand van een meer, een veertigtal kleine miniatuurtuinen ontdekken die de landschappen van het voorland van de Haute Savoie weergeven in originele en zeer bloemrijke vormen."
    ],
    "es": [
      "En el corazón de un entorno verde, al borde de un lago, venga a descubrir unos cuarenta pequeños jardines en miniatura que representan los paisajes de la Alta Saboya en formas originales y muy florales."
    ]
  },
