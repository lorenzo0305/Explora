  "rdfs:comment": {
    "de": [
      "Lassen Sie sich im Museum Joseph Déchelette zurückversetzen in das Roanne der galloromanischen Zeit.\r\nund entdecken Sie außerdem eine der reichhaltigsten traditionellen Keramiksammlungen der Provinz."
    ],
    "en": [
      "The Joseph Déchelette Museum enables you to discover daily life in Roanne in Gallo-Roman times.\r\nDiscover also the collection of ancient ceramics which is one of the finest provincial collections."
    ],
    "it": [
      "Una dimora privata ricca di storia. Punto di riferimento nel cuore di Roanne, il Museo Joseph Déchelette invita a compiere un viaggio nel tempo e nella cultura, dalla preistoria ai giorni nostri, dai primitivi fiamminghi ai ceramisti contemporanei."
    ],
    "fr": [
      "Un hôtel particulier chargé d'histoire. Lieu emblématique au cœur de Roanne, le musée Joseph Déchelette invite à un voyage à travers les époques et les cultures de la Préhistoire à nos jours, des primitifs flamands aux céramistes contemporains."
    ],
    "es": [
      "Una mansión privada cargada de historia. Punto de referencia en el corazón de Roanne, el Museo Joseph Déchelette le invita a realizar un viaje en el tiempo y la cultura, desde la prehistoria hasta nuestros días, desde los primitivos flamencos hasta los ceramistas contemporáneos."
    ],
    "nl": [
      "Een privé herenhuis met een rijke geschiedenis. Het Joseph Déchelette Museum, een bezienswaardigheid in het hart van Roanne, nodigt je uit voor een reis door de tijd en cultuur, van de prehistorie tot nu, van Vlaamse primitieven tot hedendaagse keramisten."
    ]
  },
