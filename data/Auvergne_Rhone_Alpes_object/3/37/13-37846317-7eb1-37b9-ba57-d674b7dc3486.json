  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Guérin in Verchaix ist eine katholische Kirche in Frankreich. Die Kirche steht unter dem Patronat von Guérin, einem heilenden Heiligen und Beschützer von kranken Tieren und Herden."
    ],
    "en": [
      "The French Catholic church of Saint Guerin in Verchaix is named after the saint who healed sick animals and protected the herds."
    ],
    "it": [
      "La chiesa di Saint-Guérin a Verchaix è una chiesa cattolica francese. La chiesa è posta sotto il patronato di Guérin, un santo che guariva e proteggeva gli animali e le mandrie malate."
    ],
    "fr": [
      "L'église Saint-Guérin de Verchaix est une église catholique française. L'église est placée sous la patronage de Guérin, saint guérisseur et protecteur des bêtes malades et des troupeaux."
    ],
    "es": [
      "La iglesia de Saint-Guérin en Verchaix es una iglesia católica francesa. La iglesia se encuentra bajo la advocación de Guérin, un santo que curaba y protegía a los animales y rebaños enfermos."
    ],
    "nl": [
      "De kerk Saint-Guérin in Verchaix is een Franse katholieke kerk. De kerk staat onder het beschermheerschap van Guérin, een heilige die zieke dieren en kuddes genas en beschermde."
    ]
  },
  "rdfs:label": {
