  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen wunderbaren Tag mit der ganzen Familie und kommen Sie in Kontakt mit den Tieren. Treten Sie ein, nähern Sie sich, streicheln Sie, kuscheln Sie, entdecken Sie die fabelhafte Welt der Tiere auf dem Bauernhof!\r\nGenießen Sie unseren großen Spielplatz zwischen dem Streicheln der Tiere und den Animationen."
    ],
    "en": [
      "Come and spend a wonderful day with your family, in contact with animals. \r\nEnter, approach, caress, cuddle, discover the fabulous world of farm animals !\r\nCome and enjoy our large playground between 2 animal caresses and entertainment."
    ],
    "it": [
      "Venite a trascorrere una splendida giornata con la vostra famiglia, a contatto con gli animali. Entrare, avvicinarsi, accarezzare, coccolare, scoprire il favoloso mondo degli animali della fattoria!\r\nVenite a godervi la nostra grande area giochi tra gli animali e le attività."
    ],
    "fr": [
      "Venez passer une journée merveilleuse en famille, au contact des animaux. Entrez, approchez, caressez, câlinez, découvrez le monde fabuleux des animaux de la ferme !\r\nVenez profiter de notre grande aire de jeux entre 2 caresses aux animaux et animations."
    ],
    "es": [
      "Venga a pasar un día maravilloso con su familia, en contacto con los animales. Entre, acérquese, acaricie, abrace, descubra el fabuloso mundo de los animales de granja\r\nVenga a disfrutar de nuestra amplia zona de juegos entre las caricias a los animales y las actividades."
    ],
    "nl": [
      "Kom een heerlijke dag doorbrengen met je gezin, in contact met de dieren. Kom binnen, benader, aai, knuffel en ontdek de fantastische wereld van boerderijdieren!\r\nKom en geniet van onze grote speeltuin tussen het aaien van de dieren en het bekijken van de shows door."
    ]
  },
