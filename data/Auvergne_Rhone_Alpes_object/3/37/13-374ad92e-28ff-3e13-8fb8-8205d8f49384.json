  "rdfs:comment": {
    "de": [
      "Ghislaine, Patrick und Antoine sind echte, leidenschaftliche Winzerhandwerker, die Sie mit ihrer gewohnt guten Laune an einem netten Tisch in einem traditionellen Weinkeller empfangen."
    ],
    "en": [
      "Ghislaine, Patrick and Antoine are passionate artisan winemakers who will welcome you with their usual good humour around a friendly table in a traditional cellar."
    ],
    "it": [
      "Ghislaine, Patrick e Antoine sono vignaioli artigiani appassionati che vi accoglieranno con il consueto buonumore attorno a un tavolo accogliente in una cantina tradizionale."
    ],
    "fr": [
      "Ghislaine, Patrick et Antoine sont de vrais artisans vignerons passionnés qui vous accueillent avec leur bonne humeur habituelle autour d'une table sympathique dans une cave traditionnelle."
    ],
    "es": [
      "Ghislaine, Patrick y Antoine son apasionados viticultores artesanos que le recibirán con su habitual buen humor en torno a una mesa acogedora en una bodega tradicional."
    ],
    "nl": [
      "Ghislaine, Patrick en Antoine zijn gepassioneerde ambachtelijke wijnmakers die je met hun gebruikelijke goede humeur verwelkomen rond een gezellige tafel in een traditionele kelder."
    ]
  },
