  "rdfs:comment": {
    "de": [
      "Verzehren Sie vor Ort oder nehmen Sie regionale Produkte und Sandwiches, herzhafte oder süße Kuchen, Eis, traditionelle Konditoreiwaren mit. Spezialitäten des Hauses: traditionelles Brot (1. Preis für das beste Baguette Drômoise 2013) und Hefeteig, Fougasse."
    ],
    "en": [
      "Eat on the premises or take away regional products and sandwiches, savoury and sweet tarts, ice cream, traditional patisserie. Specialities of the house: traditional bread (1st prize in the Drome best baguette competition in 2013), sourdough bread and fougasses."
    ],
    "it": [
      "Si mangiano o si portano via prodotti regionali e panini, crostate salate o dolci, gelati, pasticceria tradizionale. Specialità della casa: pane tradizionale (1° premio per la migliore baguette della Drôme nel 2013) e lievito madre, focaccia."
    ],
    "fr": [
      "Consommez sur place ou emportez des produits régionaux et sandwichs, tartes salées ou sucrées, glace, pâtisserie traditionnelle. Spécialités de la maison : pain tradition (1er prix de la meilleure baguette Drômoise 2013) et levains, fougasses."
    ],
    "nl": [
      "Proef ter plaatse of neem de regionale producten en sandwiches, hartige of zoete taarten, ijs, traditionele gebakjes mee. Specialiteiten van het huis: pain tradition (1e prijs van de beste baguette uit de Drôme 2013) en zuurdesem, haardkoek."
    ],
    "es": [
      "Comer o llevar productos regionales y bocadillos, tartas saladas o dulces, helados, bollería tradicional. Especialidades de la casa: pan tradicional (1er premio a la mejor baguette de Drôme en 2013) y masa madre, focaccia."
    ]
  },
