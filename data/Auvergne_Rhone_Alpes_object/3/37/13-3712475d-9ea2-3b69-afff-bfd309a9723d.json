  "rdfs:comment": {
    "de": [
      "Véronique Rident, Gründerin des Unternehmens Hanaya Bijoux, entwirft und fertigt in ihrem Atelier in Valence in Handarbeit verschiedene Modelle von Schmuckstücken, die Edelsteine oder Kristallperlen auf Silber oder gold filled tragen."
    ],
    "en": [
      "Véronique Rident, creator of Hanaya Bijoux, designs and hand-makes a variety of jewelry models featuring gemstones or crystal pearls on silver or gold filled, in her workshop in Valence."
    ],
    "it": [
      "Véronique Rident, creatrice di Hanaya Bijoux, disegna e realizza a mano nel suo laboratorio di Valence una varietà di modelli di gioielli con gemme o perle di cristallo su argento o oro."
    ],
    "fr": [
      "Véronique Rident, créatrice de la société Hanaya Bijoux, conçoit et réalise à la main des modèles variés de bijoux montant pierres gemmes ou perles de cristal sur argent ou gold filled, dans son atelier, à Valence."
    ],
    "nl": [
      "Véronique Rident, de ontwerpster van Hanaya Bijoux, ontwerpt en maakt met de hand verschillende juwelenmodellen met edelstenen of kristallen parels op zilver of goud gevuld, in haar atelier in Valence."
    ],
    "es": [
      "Véronique Rident, creadora de Hanaya Bijoux, diseña y fabrica a mano en su taller de Valence diversos modelos de joyas con piedras preciosas o perlas de cristal sobre plata o baño de oro."
    ]
  },
