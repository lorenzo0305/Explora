  "rdfs:comment": {
    "de": [
      "Die Kirche der Heiligen Katharina wurde nach dem Konkordat von 1801 als eigenständige Pfarrei errichtet. Die heutige Kirche wurde 1859 fertiggestellt und am 20. November geweiht."
    ],
    "en": [
      "The church of Sainte-Catherine was established as an independent parish after the Concordat of 1801. The current church was completed in 1859 and blessed on November 20."
    ],
    "it": [
      "La chiesa di Sainte-Catherine fu istituita come parrocchia indipendente dopo il Concordato del 1801. La chiesa attuale fu completata nel 1859 e benedetta il 20 novembre."
    ],
    "fr": [
      "L'église de Sainte-Catherine a été érigée en paroisse indépendante après le concordat de 1801. L'église actuelle a été achevé en 1859 et bénite le 20 novembre."
    ],
    "es": [
      "La iglesia de Sainte-Catherine se constituyó como parroquia independiente tras el Concordato de 1801. La iglesia actual se terminó de construir en 1859 y se bendijo el 20 de noviembre."
    ],
    "nl": [
      "De kerk van Sainte-Catherine werd opgericht als onafhankelijke parochie na het concordaat van 1801. De huidige kerk werd voltooid in 1859 en ingezegend op 20 november."
    ]
  },
