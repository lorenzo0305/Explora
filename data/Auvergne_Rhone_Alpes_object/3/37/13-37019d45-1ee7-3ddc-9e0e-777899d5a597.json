  "rdfs:comment": {
    "de": [
      "Zwischen Valence und Montélimar - Livron öffnet das Tor zum Drôme-Tal - Eine Stadt auf dem Land, umgeben von zahlreichen Obstgärten - Kostprobe: Ein seltener Wein: der Brézème! Der Zusammenfluss von Rhône und Drôme ist als Natura-2000-Gebiet eingestuft."
    ],
    "en": [
      "Between Valence and Montélimar - Livron opens the door to the Drôme Valley - A town in the countryside surrounded by orchards - To taste: a rare wine: Brézème! The Rhône/Drôme confluence is classified as a Natura 2000 area."
    ],
    "it": [
      "Tra Valence e Montélimar - Livron apre le porte della Valle della Drôme - Un paese immerso nella campagna e circondato da numerosi frutteti - Da degustare: Un vino raro: il Brézème! La confluenza Rodano/Drôme è classificata come area Natura 2000."
    ],
    "fr": [
      "Entre Valence et Montélimar - Livron ouvre la porte de la Vallée de la Drôme - Une ville à la campagne environnée de multiples vergers - A goûter : Un vin rare : Le Brézème ! La confluence Rhône/Drôme est classée Zone Natura 2000."
    ],
    "nl": [
      "Tussen Valence en Montélimar - Livron opent de deur naar de Drôme vallei - Een stadje op het platteland omringd door boomgaarden - Om te proeven: een zeldzame wijn: Brézème! De samenvloeiing van de Rhône en de Drôme is geklasseerd als Natura 2000-gebied."
    ],
    "es": [
      "Entre Valence y Montélimar - Livron le abre las puertas del Valle de la Drôme - Una ciudad en el campo rodeada de numerosos huertos - Para degustar: Un vino raro: ¡Brezème! La confluencia Ródano/Dródano está clasificada como zona Natura 2000."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Office de Tourisme de la Vallée de la Drôme - Bureau d'informations touristiques de Livron-sur-Drôme"
    ]
  },
