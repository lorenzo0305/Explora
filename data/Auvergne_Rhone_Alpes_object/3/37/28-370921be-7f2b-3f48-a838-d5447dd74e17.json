  "rdfs:comment": {
    "de": [
      "Der Botanische Garten von Tourcoing ist eine wahre Naturinsel im Herzen der Stadt, das grüne Juwel von Tourcoing. Schlendern Sie durch die Alleen seines traditionellen französischen Gartens, unter hundertjährigen Glyzinien?"
    ],
    "en": [
      "He Jardin Botanique de Tourcoing is a veritable island of nature in the heart of the city, Tourcoing's green jewel. Stroll through the paths of its traditional French garden, beneath century-old wisteria?"
    ],
    "it": [
      "L Giardino Botanico di Tourcoing è una vera e propria isola di natura nel cuore della città, il gioiello verde di Tourcoing. Passeggiate tra i sentieri del suo tradizionale giardino alla francese, sotto i glicini secolari?"
    ],
    "fr": [
      "E Jardin botanique de Tourcoing constitue un véritable îlot de nature au cœur de la ville, le joyau vert de Tourcoing. Promenez-vous à travers les allées de son jardin traditionnel à la française, sous les glycines centenaires…"
    ],
    "es": [
      "L Jardín Botánico de Tourcoing es una auténtica isla de naturaleza en el corazón de la ciudad, la joya verde de Tourcoing. Pasee por los senderos de su jardín tradicional de estilo francés, bajo glicinas centenarias.."
    ],
    "nl": [
      "De Plantentuin van Tourcoing is een echt natuureiland in het hart van de stad, het groene juweel van Tourcoing. Maak een wandeling over de paden van de traditionele Franse tuin, onder eeuwenoude blauwe regen?"
    ]
  },
