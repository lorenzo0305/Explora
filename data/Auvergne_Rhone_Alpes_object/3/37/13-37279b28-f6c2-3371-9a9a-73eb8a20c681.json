  "rdfs:comment": {
    "de": [
      "Handel mit feinen Weinen, Spirituosen, handwerklich gebrauten Bieren, Mineralwasser. Karten für Geschenke. Geschenkkarte Geburtstag 12 Weine\r\nBereitstellung von professionellen Bierzapfanlagen 30, 20 und 6 Liter (Perfect Draft).\r\nVerkostungsraum, Versammlungsraum."
    ],
    "en": [
      "Trade in fine wines, spirits, craft beers, mineral water. Gift cards. Birthday gift card 12 wines\r\nProfessional 30, 20 and 6-liter beer taps (Perfect Draft).\r\nTasting room, meeting room."
    ],
    "it": [
      "Vini pregiati, liquori, birre artigianali, acqua minerale. Carte regalo. Carta regalo di compleanno 12 vini\r\nDisponibilità di spine di birra professionali da 30, 20 e 6 litri (Perfect Draft).\r\nSala degustazione, sala riunioni."
    ],
    "fr": [
      "Commerce de vins fins, spiritueux, bières artisanales, eaux minérales. Cartes cadeaux. Carte cadeau anniversaire 12 vins \r\nMise à disposition de tireuses à bière professionnelles 30, 20 et 6 litres (Perfect Draft). \r\nSalle de dégustation, salle de réunion."
    ],
    "es": [
      "Vinos finos, licores, cervezas artesanales, agua mineral. Tarjetas regalo. Tarjeta regalo cumpleaños 12 vinos\r\nGrifos de cerveza profesionales de 30, 20 y 6 litros (Perfect Draft).\r\nSala de degustación, sala de reuniones."
    ],
    "nl": [
      "Fijne wijnen, sterke dranken, ambachtelijke bieren, mineraalwater. Cadeaubonnen. Verjaardagscadeaukaart 12 wijnen\r\nProfessionele biertaps van 30, 20 en 6 liter (Perfect Draft).\r\nProefruimte, vergaderzaal."
    ]
  },
