  "rdfs:comment": {
    "de": [
      "Zwischen Montélimar und der berühmten Ferienstraße gibt es eine Geschichte, die seit über 50 Jahren andauert! Eine glorreiche Vergangenheit, die es bei dieser Führung zu entdecken gilt."
    ],
    "en": [
      "The story of Montélimar and the famous vacation route goes back over 50 years! A glorious past to discover on this guided tour."
    ],
    "it": [
      "Montélimar e il famoso percorso di vacanza hanno una storia che risale a più di 50 anni fa! Un passato glorioso da scoprire in questa visita guidata."
    ],
    "fr": [
      "Entre Montélimar et la fameuse route des vacances c'est une histoire qui dure depuis plus de 50 ans ! Un glorieux passé à découvrir lors de cette visite guidée."
    ],
    "es": [
      "Montélimar y su famosa ruta de vacaciones tienen más de 50 años de historia Un pasado glorioso que podrá descubrir en esta visita guiada."
    ],
    "nl": [
      "Montélimar en de beroemde vakantieroute hebben een geschiedenis die meer dan 50 jaar teruggaat! Een roemrijk verleden om te ontdekken tijdens deze rondleiding."
    ]
  },
  "rdfs:label": {
