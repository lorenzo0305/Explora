  "rdfs:comment": {
    "de": [
      "Echtes historisches Erbe des Beaujolais: Das Château de La Chaize ist seit 350 Jahren ein familiengeführtes Weingut, das als historisches Monument klassifiziert ist, mit seinen Gärten, dem Weinkeller und dem 108 Meter langen Weinkeller!"
    ],
    "en": [
      "A true Beaujolais historical heritage: Château de La Chaize has been a family-run wine estate for 350 years and is listed as a Monument Historique, with its gardens, vat room and 108-metre-long cellar!"
    ],
    "it": [
      "Una vera e propria parte del patrimonio del Beaujolais: lo Château de La Chaize è un'azienda vinicola a conduzione familiare da 350 anni ed è classificato come Monumento Storico, con i suoi giardini, la sala tini e la cantina lunga 108 metri!"
    ],
    "fr": [
      "Véritable patrimoine historique du Beaujolais : Le Château de La Chaize est un domaine viticole familial depuis 350 ans, classé Monument Historique, avec ses jardins, son cuvage et sa cave de 108 mètres de long !"
    ],
    "es": [
      "Verdadero patrimonio de Beaujolais: el Château de La Chaize es una explotación vinícola familiar desde hace 350 años, declarada Monumento Histórico, con sus jardines, su sala de cubas y su bodega de 108 metros de largo"
    ],
    "nl": [
      "Een echt deel van het erfgoed van de Beaujolais: Château de La Chaize is al 350 jaar een familiedomein en staat op de lijst van historische monumenten, met zijn tuinen, kuipkamer en 108 meter lange kelder!"
    ]
  },
