  "rdfs:comment": {
    "de": [
      "Mein Ziel ist es, meine Fähigkeiten einzusetzen, um meinen Patienten zu ermöglichen, ihr Gleichgewicht wiederzufinden und gleichzeitig die Schmerzen zu verringern, wenn sie über verschiedene manuelle Techniken vorhanden sind."
    ],
    "en": [
      "My goal is to use my skills to help patients to find their equilibrium while reducing pains via various manual technics."
    ],
    "it": [
      "Il mio obiettivo è usare le mie competenze per permettere ai patienti di ritrovare il loro equilibrio mentre scendendo i dolori se sono presenti via delle tecniche manuali varie."
    ],
    "fr": [
      "Mon objectif est d'utiliser mes compétences pour permettre à mes patients de retrouver leur équilibre tout en diminuant les douleurs si elles sont présentes via des techniques manuelles variées."
    ],
    "nl": [
      "Mijn doel is om mijn vaardigheden te gebruiken om mijn patiënten te helpen hun evenwicht te hervinden en de pijn die ze ervaren te verminderen, door gebruik te maken van verschillende manuele technieken."
    ],
    "es": [
      "Mi objetivo es utilizar mis habilidades para ayudar a mis pacientes a recuperar el equilibrio al tiempo que se reduce el dolor que puedan estar experimentando, utilizando una variedad de técnicas manuales."
    ]
  },
  "rdfs:label": {
