  "rdfs:comment": {
    "de": [
      "Besichtigung mit Audioguide (Erwachsene). Kostenloses Carnet-Jeux für Kinder ab 6 Jahren.\r\nNach der Entdeckung der Grotte des Fées im 19. Jahrhundert und ihrer Besiedlung vor mindestens 42 000 Jahren macht Châtelperron das Allier zu einem berühmten prähistorischen Gebiet."
    ],
    "en": [
      "Visit with audioguide. Following the discovery of the cave of the Fairies in the 19th century and the men of Neanderthal who lived there 42,000 years ago, Châtelperron makes of the Allier a prehistoric territory renowned."
    ],
    "it": [
      "Visita con audioguida (adulti). Giochi gratuiti per i bambini a partire dai 6 anni.\r\nDopo la scoperta della Grotte des Fées nel XIX secolo e la sua occupazione almeno 42.000 anni fa, Châtelperron è diventato un rinomato sito preistorico dell'Allier."
    ],
    "fr": [
      "Visite avec audioguide (adultes). Carnet-Jeux gratuit enfant à partir de 6 ans.\r\nSuite à la découverte de la Grotte des Fées au XIXe siècle et de son occupation il y a au moins 42 000 ans, Châtelperron fait de l'Allier un territoire préhistorique renommé."
    ],
    "es": [
      "Visita con audioguía (adultos). Juegos gratuitos para niños a partir de 6 años.\r\nTras el descubrimiento de la Grotte des Fées en el siglo XIX y su ocupación hace al menos 42.000 años, Châtelperron se ha convertido en un yacimiento prehistórico de renombre en el Allier."
    ],
    "nl": [
      "Bezoek met audiogids (volwassenen). Gratis spelletjes voor kinderen vanaf 6 jaar.\r\nNa de ontdekking van de Grotte des Fées in de 19e eeuw en de bewoning van minstens 42.000 jaar geleden, is Châtelperron een bekende prehistorische vindplaats in de Allier geworden."
    ]
  },
