  "rdfs:comment": {
    "de": [
      "Wenn Sie auf der Viarhôna unterwegs sind, machen Sie einen Zwischenstopp in diesem Restaurant mit Bar 5 km von St Genix les Villages entfernt, das im Stil der 50er Jahre eingerichtet ist. Hier finden Sie eine traditionelle Küche mit Tagesmenüs und eine Terrasse, auf der Sie sich tagsüber erfrischen können."
    ],
    "en": [
      "If you're on the Viarhôna, stop off at this restaurant-bar 5 km from St Genix les Villages, decorated in the style of the 50s. You'll find traditional cuisine on daily menus, and a terrace for daytime refreshment."
    ],
    "it": [
      "Se state viaggiando lungo la Viarhôna, perché non fermarvi in questo ristorante-bar, a 5 km da St Genix les Villages, arredato in stile anni '50. Troverete una cucina tradizionale con menù giornalieri e una terrazza per un drink rinfrescante durante il giorno."
    ],
    "fr": [
      "De passage sur la Viarhôna, faites étape dans ce restaurant-bar à 5 kilomètres de St Genix les Villages, à la décoration années 50. Vous y trouverez une cuisine traditionnelle déclinée en menus du jour et une terrasse pour vous rafraichir dans la journée."
    ],
    "es": [
      "Si viaja por el Viarhôna, haga una parada en este bar-restaurante, a 5 kilómetros de St Genix les Villages, decorado al estilo de los años cincuenta. Encontrará cocina tradicional con menús diarios y una terraza para tomar una bebida refrescante durante el día."
    ],
    "nl": [
      "Als je langs de Viarhôna reist, stop dan even bij dit restaurant-bar, 5 kilometer van St Genix les Villages, ingericht in de stijl van de jaren 50. Je vindt hier een traditionele keuken met dagmenu's en een terras voor een verfrissend drankje overdag."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Guinguette de Champagneux"
    ]
  },
