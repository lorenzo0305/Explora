  "rdfs:comment": {
    "de": [
      "Das Cottance Café ist ein geselliger Ort, an dem Sie Ihren Durst löschen oder eine Delikatesse genießen können. Traditionelle und schmackhafte Küche mit frischen und hausgemachten Produkten. Multiservice mit Lebensmittelgeschäft und Brotverkauf."
    ],
    "en": [
      "Le Cottance Café is a friendly place where you can come to quench your thirst or enjoy a gourmet meal. Traditional, tasty cuisine based on fresh, homemade products. Multi-services with grocery store and bread depot."
    ],
    "it": [
      "Il Cottance Café è un luogo accogliente dove potrete dissetarvi o gustare un pasto gourmet. Cucina tradizionale e gustosa a base di prodotti freschi e fatti in casa. Multiservizi con negozio di alimentari e deposito di pane."
    ],
    "fr": [
      "Le Cottance Café est un lieu convivial où vous pouvez venir vous désaltérer ou déguster un mets gourmand. Cuisine traditionnelle et savoureuse à base de produits frais et fait maison. Multi-services avec épicerie et dépôt de pain."
    ],
    "nl": [
      "Het Cottance Café is een gezellige plek waar je terecht kunt om je dorst te lessen of te genieten van een gastronomische maaltijd. Traditionele, smakelijke keuken op basis van verse, zelfgemaakte producten. Multiservice met kruidenierswinkel en brooddepot."
    ],
    "es": [
      "El Cottance Café es un lugar acogedor donde puede venir a saciar su sed o disfrutar de una comida gourmet. Cocina tradicional y sabrosa a base de productos frescos y caseros. Multiservicios con tienda de comestibles y panadería."
    ]
  },
