  "rdfs:comment": {
    "de": [
      "La Boutique du Gourmand, Verkäufer von Leckereien, bietet Ihnen eine große Auswahl an Schokolade, Fruchtsäften, Weinen, Spirituosen und Likören. Lassen Sie sich von ihren Gourmetkörben, Ballotins oder Schatullen verführen."
    ],
    "en": [
      "La Boutique du Gourmand, a gourmet shop, offers you a wide choice of chocolates, fruit juices, wines, alcohols and liqueurs. Let yourself be tempted by their gourmet baskets, boxes or boxes."
    ],
    "it": [
      "La Boutique du Gourmand, un negozio per buongustai, offre un'ampia gamma di cioccolatini, succhi di frutta, vini, alcolici e liquori. Lasciatevi tentare dai loro cestini, ballotin o scatole gourmet."
    ],
    "fr": [
      "La Boutique du Gourmand, vendeur de gourmandises vous propose un large choix de chocolats, jus de fruits, vins, alcools et liqueurs. Laissez-vous tenter par leurs paniers gourmands, ballotins ou coffrets."
    ],
    "es": [
      "La Boutique du Gourmand, una tienda gourmet, ofrece una amplia gama de chocolates, zumos de frutas, vinos, bebidas alcohólicas y licores. Déjate tentar por sus cestas, papeletas o cajas gourmet."
    ],
    "nl": [
      "La Boutique du Gourmand, een winkel voor fijnproevers, biedt een breed scala aan bonbons, vruchtensappen, wijnen, sterke dranken en likeuren. Laat u verleiden door hun gourmetmanden, ballotins of dozen."
    ]
  },
  "rdfs:label": {
