  "rdfs:comment": {
    "de": [
      "Kommen Sie am Sonntag, dem 26. April, ab 8.30 Uhr in den Salle des Sucs in Pertuis zu unserer traditionellen Wanderung, Trail Off, Mountainbike zur Unterstützung von Lola, die am Little-Syndrom leidet."
    ],
    "en": [
      "Come and join us on Sunday April 26 from 8.30am at the Salle des Sucs in Le Pertuis for our traditional walk, trail off and mountain bike in support of Lola, who suffers from Little's syndrome."
    ],
    "it": [
      "Domenica 26 aprile, a partire dalle 8.30, presso la Salle des Suces di Le Pertuis, ci uniremo a noi per la tradizionale passeggiata, il trail off e la corsa in mountain bike a sostegno di Lola, affetta dalla sindrome di Little."
    ],
    "fr": [
      "Venez nous retrouvez le dimanche 26 Avril à partir de 8h30 à la salle des sucs du Pertuis pour notre traditionnel marche, trail off, VTT en soutien à Lola, atteinte du syndrome de Little."
    ],
    "nl": [
      "Kom op zondag 26 april vanaf 8.30 uur naar de Salle des Sucs in Le Pertuis voor onze traditionele wandeling, trail off en mountainbiketocht ter ondersteuning van Lola, die lijdt aan het syndroom van Little."
    ],
    "es": [
      "Acompáñanos el domingo 26 de abril a partir de las 8.30 h en la Salle des Suces de Le Pertuis para nuestra tradicional marcha, trail off y paseo en bicicleta de montaña en apoyo de Lola, que padece el síndrome de Little."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée marche, VTT & trail off pour Lola"
    ]
  },
