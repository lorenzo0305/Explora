  "rdfs:comment": {
    "de": [
      "Nur für Hotelgäste am Etappenabend reserviert. Sie werden eine regionale Küche genießen, die sich aus Produkten des Marktes zusammensetzt.\r\nsavoyische Spezialitäten auf Anfrage."
    ],
    "en": [
      "Come and enjoy our traditonal cuisine based on fresh ingredients bought at the market.  Savoyard specialities available only on request."
    ],
    "it": [
      "Riservato solo agli ospiti dell'hotel durante la serata. Potrete apprezzare una cucina locale a base di prodotti del mercato.\r\nle specialità savoiarde sono disponibili su richiesta."
    ],
    "fr": [
      "Réservé uniquement pour les clients de l'hôtel en soirée étape. Vous apprécierez une cuisine du terroir composée des produits du marché.\r\nles spécialités savoyardes se font sur demande."
    ],
    "es": [
      "Reservado sólo para los huéspedes del hotel durante la noche. Podrá apreciar una cocina local elaborada con productos de mercado.\r\nlas especialidades de Saboya están disponibles bajo petición."
    ],
    "nl": [
      "Alleen gereserveerd voor hotelgasten gedurende de avond. U zult genieten van een lokale keuken gemaakt van marktproducten.\r\nsavoyaardse specialiteiten zijn beschikbaar op aanvraag."
    ]
  },
