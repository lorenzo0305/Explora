  "rdfs:comment": {
    "de": [
      "3 Hektar großer See der ersten Kategorie mit klarem Wasser und einer hohen Dichte an Bachforellen und Regenbogenforellen. Verwaltung von Sportfischen. Der Kauf von Angelkarten ist obligatorisch und kann ab 7.00 Uhr in der Buvette de Tuèda getätigt werden."
    ],
    "en": [
      "3 hectare first category lake, with clear water and a high density of fario & rainbow trout. Fishing cards mandatory. Fishing cards are on sale at the\r\nrestaurant of Tueda."
    ],
    "it": [
      "Lago di prima categoria di 3 ettari con acque limpide e un'alta densità di trote fario e iridee. Gestione della pesca sportiva. Le tessere di pesca devono essere acquistate a partire dalle 7 del mattino presso il punto di ristoro di Tuèda."
    ],
    "fr": [
      "Lac de première catégorie de 3 hectares aux eaux claires d’une forte densité de truites farios et arcs en ciel. Gestion de pêches sportives. L'achat des cartes de pêche est obligatoire et peut être effectué dès 7h00 à la Buvette de Tuèda."
    ],
    "nl": [
      "Meer van de eerste categorie van 3 hectare met helder water en een hoge dichtheid aan bruine en regenboogforel. Beheer van de sportvisserij. De aankoop van viskaarten is verplicht en kan vanaf 7.00 uur in het restaurant in Tueda."
    ],
    "es": [
      "Lago de primera categoría, de 3 hectareas, de aguas claras, con una gran densidad de trucha comun y arco iris. Gestión de pesca deportiva. El permiso de pesca es obligatorio, y se puede adquirir en el restaurante de Tueda a partir de las 7h00."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at lake Tueda"
    ],
    "fr": [
      "Pêche au lac de Tuèda"
    ],
    "nl": [
      "Vissen bij het Tuedameer"
    ],
    "es": [
      "Pesca en el lago de Tueda"
    ]
  },
