  "rdfs:comment": {
    "de": [
      "Die der Heiligen Magdalena geweihte Kapelle liegt auf einem natürlichen Hügel in 441 m Höhe und bietet einen Zwischenstopp in der Geschichte der ehemaligen Abtei von Cusset und in der romanischen Kunst."
    ],
    "en": [
      "Situated on a natural hillock at 441 m of altitude, the chapel dedicated to Sainte-Madeleine offers a stop in the history of the old abbey of Cusset and in the Romanesque art."
    ],
    "it": [
      "Situata su una collinetta naturale a 441 m di altitudine, la cappella dedicata a Sainte-Madeleine offre una tappa nella storia dell'antica abbazia di Cusset e nell'arte romanica."
    ],
    "fr": [
      "Située sur une butte naturelle à 441 m d'altitude, la chapelle dédiée à Sainte-Madeleine offre une halte dans l'histoire de l'ancienne abbaye de Cusset et dans l'art roman."
    ],
    "es": [
      "Situada en un montículo natural a 441 m de altitud, la capilla dedicada a Sainte-Madeleine ofrece una parada en la historia de la antigua abadía de Cusset y en el arte románico."
    ],
    "nl": [
      "Gelegen op een natuurlijke heuvel op een hoogte van 441 m, biedt de kapel gewijd aan Sainte-Madeleine een tussenstop in de geschiedenis van de voormalige abdij van Cusset en in de Romaanse kunst."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Sainte-Madeleine"
    ]
  },
