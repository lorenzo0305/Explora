  "rdfs:comment": {
    "de": [
      "6 km von Tence entfernt, auf der Straße nach Devesset, historische Informationen über die Aufnahme jüdischer Kinder während des Zweiten Weltkriegs und über die \"École des Prophètes\"."
    ],
    "en": [
      "6 km from Tence, on the road to Devesset, the history of the reception of Jewish children during the 2nd World War, and the School of the Prophets."
    ],
    "it": [
      "A 6 km da Tence, sulla strada per Devesset, la storia dell'accoglienza dei bambini ebrei durante la Seconda Guerra Mondiale e la Scuola dei Profeti."
    ],
    "fr": [
      "A 6 km de Tence, sur la route de Devesset, l'historique sur l'accueil des enfants juifs pendant la 2è Guerre Mondiale, et sur l'École des Prophètes."
    ],
    "es": [
      "A 6 km de Tence, en la carretera de Devesset, la historia de la acogida de niños judíos durante la Segunda Guerra Mundial, y la Escuela de los Profetas."
    ],
    "nl": [
      "6 km van Tence, op de weg naar Devesset, de geschiedenis van de opvang van Joodse kinderen tijdens de Tweede Wereldoorlog, en de School van de Profeten."
    ]
  },
