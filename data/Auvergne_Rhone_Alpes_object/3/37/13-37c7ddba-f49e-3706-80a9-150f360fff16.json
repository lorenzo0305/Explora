  "rdfs:comment": {
    "de": [
      "Wir kommen direkt aus Italien und bieten Ihnen frische und authentische Produkte sowie köstliche, mit Liebe und Leidenschaft hausgemachte Zubereitungen vor Ort oder zum Mitnehmen im Herzen des Zentrums der antiken Stadt!"
    ],
    "en": [
      "Directly from Italy, we offer you fresh, authentic products, as well as delicious homemade preparations made with love and passion on the spot or to take away in the heart of the ancient city center!"
    ],
    "it": [
      "Direttamente dall'Italia, offriamo prodotti freschi e autentici e deliziosi piatti fatti in casa con amore e passione sul posto o da asporto nel cuore del centro storico!"
    ],
    "fr": [
      "En provenance directe d’Italie, nous vous proposons des produits frais et authentiques, ainsi que de délicieuses préparations faites maison  avec amour et passion sur place ou à emporter au coeur du centre de la cité antique !"
    ],
    "nl": [
      "Rechtstreeks uit Italië bieden we verse, authentieke producten en heerlijke huisgemaakte gerechten die met liefde en passie ter plekke worden gemaakt of om mee te nemen in het hart van het oude stadscentrum!"
    ],
    "es": [
      "Directamente desde Italia, ofrecemos productos frescos y auténticos y deliciosos platos caseros elaborados con amor y pasión al momento o para llevar en pleno centro histórico"
    ]
  },
  "rdfs:label": {
