  "rdfs:comment": {
    "de": [
      "Wir sind seit 20 Jahren Metzger, Fleischer und Feinkosthändler und haben uns auf das Garen am Spieß über Holzfeuer spezialisiert, wobei die Nachfrage seit etwa 15 Jahren blüht."
    ],
    "en": [
      "Butchers, charcutiers and caterers for 20 years, we've specialized in wood-fired spit-roasting for the past 15 years."
    ],
    "it": [
      "Macellai, norcini e ristoratori da 20 anni, da quindici ci siamo specializzati nella cottura allo spiedo a legna."
    ],
    "fr": [
      "Boucher, charcutier, traiteur depuis 20 ans, nous nous sommes spécialisés dans la cuisson à la broche au feu de bois avec une demande florissante depuis une quinzaine d’années."
    ],
    "nl": [
      "We zijn al 20 jaar slagers, vleeshouwers en cateraars en hebben ons gespecialiseerd in houtgestookte spit-roosters. De vraag hiernaar is de afgelopen vijftien jaar enorm toegenomen."
    ],
    "es": [
      "Carniceros, charcuteros y restauradores desde hace 20 años, nos hemos especializado en el asado al horno de leña desde hace quince."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Broche d'Autrefois"
    ]
  },
