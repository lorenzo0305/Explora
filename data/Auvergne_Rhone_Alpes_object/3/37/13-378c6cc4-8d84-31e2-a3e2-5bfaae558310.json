  "rdfs:comment": {
    "de": [
      "Buffetrestaurant mit traditioneller Küche, die vollständig hausgemacht ist. Seien Sie Herr über Ihre Zeit und Ihren Teller, indem Sie sich Ihr Menü selbst zusammenstellen. Wir empfangen Sie mittags von Montag bis Freitag und an Feiertagen."
    ],
    "en": [
      "Buffet restaurant offering traditional, homemade cuisine. Take control of your time and your plate by creating your own buffet menu. We welcome you for lunch from Monday to Friday and on public holidays."
    ],
    "it": [
      "Ristorante a buffet con cucina tradizionale casalinga. Prendete il controllo del vostro tempo e del vostro piatto creando il vostro menu a buffet. Vi diamo il benvenuto a pranzo dal lunedì al venerdì e nei giorni festivi."
    ],
    "fr": [
      "Restaurant buffet proposant une cuisine traditionnelle entièrement faite Maison. Soyez maître de votre temps et de votre assiette en composant vous même votre menu autour des buffets. Nous vous accueillons les midis du Lundi au vendredi et jours fériès."
    ],
    "es": [
      "Restaurante buffet que sirve cocina casera tradicional. Controle su tiempo y su plato creando su propio menú de bufé. Le damos la bienvenida para el almuerzo de lunes a viernes y los días festivos."
    ],
    "nl": [
      "Buffetrestaurant met traditionele huisgemaakte gerechten. Neem de controle over je tijd en je bord door je eigen buffetmenu samen te stellen. Je bent van harte welkom voor de lunch van maandag tot en met vrijdag en op feestdagen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Buffet Les Bruyères"
    ]
  },
