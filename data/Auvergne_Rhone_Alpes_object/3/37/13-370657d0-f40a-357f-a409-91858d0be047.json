  "rdfs:comment": {
    "de": [
      "Ein komfortabler Raum von 315 m2 erwartet Sie für die Konsultation vor Ort oder die Ausleihe von Dokumenten. Hier finden Sie eine große Auswahl an Jugend- und Erwachsenenliteratur: Romane, Comics, Mangas, Dokumentarfilme, Reiseführer, Bergbücher, Zeitschriften, DVDs..."
    ],
    "en": [
      "A comfortable 315 m2 space awaits you for on-site consultation or borrowing documents. A vast selection of books for young people and adults is available: novels, comics, mangas, documentaries, guidebooks, mountain books, magazines, DVDs..."
    ],
    "it": [
      "Un comodo spazio di 315 m2 vi attende per la consultazione in loco o per il prestito di documenti. È disponibile un'ampia gamma di libri per giovani e adulti: romanzi, fumetti, manga, documentari, guide, libri di montagna, riviste, DVD, ecc."
    ],
    "fr": [
      "Un espace confortable de 315 m2 vous attend pour la consultation sur place ou l'emprunt de documents . Un vaste choix d'ouvrages jeunesse et adulte vous est proposé  : romans, BD, mangas, documentaires, guides, livres de montagne, magazines, DVD..."
    ],
    "es": [
      "Un cómodo espacio de 315 m2 le espera para consultar in situ o tomar prestados documentos. Dispone de una amplia gama de libros para jóvenes y adultos: novelas, cómics, mangas, documentales, guías, libros de montaña, revistas, DVD, etc."
    ],
    "nl": [
      "Een comfortabele ruimte van 315 m2 wacht op je voor raadpleging ter plaatse of om documenten te lenen. Er is een breed assortiment boeken voor jongeren en volwassenen beschikbaar: romans, strips, manga's, documentaires, reisgidsen, bergboeken, tijdschriften, dvd's, enz."
    ]
  },
