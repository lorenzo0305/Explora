  "rdfs:comment": {
    "de": [
      "Auf der Terrasse von L'en'K im Zentrum von Merdassier können Sie unsere Pizzen mit frischen Zutaten sowie unsere süßen und salzigen Waffeln während Ihrer Gourmetpause genießen."
    ],
    "en": [
      "On the terrace of L'en'K, in the centre of Merdassier, come and enjoy our pizzas made with fresh products as well as our savoury waffles during your gourmet break."
    ],
    "it": [
      "Godetevi una pausa gourmet sulla terrazza del L?en?K, nel centro di Merdassier, con le nostre pizze appena sfornate e i waffle dolci."
    ],
    "fr": [
      "Sur la terrasse de L’en’K, dans le centre de Merdassier, venez déguster nos pizzas composées de produits frais ainsi que nos waffles sucrées lors de votre pause gourmande."
    ],
    "nl": [
      "Geniet van een gastronomische pauze op het terras van L?en?K, in het centrum van Merdassier, met onze versgebakken pizza's en zoete wafels."
