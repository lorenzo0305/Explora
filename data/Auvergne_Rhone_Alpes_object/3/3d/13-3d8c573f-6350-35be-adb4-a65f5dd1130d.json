  "rdfs:comment": {
    "de": [
      "Atypisch, freundlich, komfortabel und lebendig, greet hotel Bourg en Bresse Sud ist bewusst sozialen und ökologischen Werten verpflichtet. Es liegt uns am Herzen, alles zu tun, damit Sie einen wunderbaren Aufenthalt in unserem Hotel verbringen können."
    ],
    "en": [
      "Atypical, friendly, comfortable and lively, greet hotel Bourg en Bresse Sud is deliberately committed to social and environmental values, and we do everything in our power to ensure that you have a wonderful stay in our hotel."
    ],
    "it": [
      "Atipico, amichevole, confortevole e vivace, il greet hotel Bourg en Bresse Sud è volontariamente legato ai valori sociali e ambientali, abbiamo a cuore di fare tutto per assicurarvi un meraviglioso soggiorno nel nostro hotel."
    ],
    "fr": [
      "Atypique, convivial, confortable et vivant, greet hotel Bourg en Bresse Sud est volontairement attaché aux valeurs sociales et environnementales, nous avons à cœur de tout mettre en œuvre pour que vous passiez un merveilleux séjour dans notre hôtel."
    ],
    "nl": [
      "Atypisch, vriendelijk, comfortabel en levendig, greet hotel Bourg en Bresse Sud is vrijwillig gehecht aan sociale en ecologische waarden, wij hebben er alles voor over om u een heerlijk verblijf in ons hotel te bezorgen."
    ],
    "es": [
      "Atípico, acogedor, confortable y animado, el greet hotel Bourg en Bresse Sud se adhiere voluntariamente a los valores sociales y medioambientales, tenemos en el corazón hacer todo lo posible para que tenga una estancia maravillosa en nuestro hotel."
    ]
  },
