  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek Lamartine im Herzen des Stadtzentrums von Aix-les-Bains ist ein freundlicher, freier und kostenloser Ort für alle. Hier können Sie ohne Anmeldung verweilen!"
    ],
    "en": [
      "Located in the heart of downtown Aix-les-Bains, the Lamartine municipal library is a welcoming space that is free and open to all. You can come and spend some time there without having to register!"
    ],
    "it": [
      "Nel cuore del centro di Aix-les-Bains, la biblioteca comunale Lamartine è uno spazio accogliente, libero e gratuito per tutti. Potete venire a trascorrervi un po' di tempo senza bisogno di iscrivervi!"
    ],
    "fr": [
      "Au cœur du centre-ville d'Aix-les-Bains, la bibliothèque municipale Lamartine est un espace convivial, libre et gratuit pour tous. Vous pouvez venir y passer un moment sans obligation d'inscription !"
    ],
    "nl": [
      "In het hart van het stadscentrum van Aix-les-Bains is de gemeentelijke bibliotheek van Lamartine een gezellige, gratis ruimte voor iedereen. Je bent welkom om er wat tijd door te brengen, zonder verplichting om je in te schrijven!"
    ],
    "es": [
      "En pleno centro de Aix-les-Bains, la biblioteca municipal Lamartine es un espacio acogedor y gratuito para todos. Le invitamos a pasar un rato en ella sin obligación de inscribirse"
    ]
  },
