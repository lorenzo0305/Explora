  "rdfs:comment": {
    "de": [
      "Die Hütte befindet sich am Col de la Golèse mitten auf der Alm und bietet ein außergewöhnliches Panorama auf das Giffre-Tal (Samoëns) auf der Südseite und das Manche-Tal (Morzine) auf der Nordseite."
    ],
    "en": [
      "Located on the Col de la Golèse in the heart of the mountain pastures, the refuge offers an exceptional panorama of the Giffre (Samoëns) valley on the south side and the Manche (Morzine) on the north side."
    ],
    "it": [
      "Il rifugio si trova al Col de la Golèse, nel cuore dell'alpeggio, e offre un panorama eccezionale sulla valle di Giffre (Samoëns) a sud e sulla Manche (Morzine) a nord."
    ],
    "fr": [
      "Le refuge est situé au col de la Golèse en plein cœur de l’alpage, offrant un panorama exceptionnel sur la vallée du Giffre (Samoëns), côté sud et de la Manche (Morzine), côté nord."
    ],
    "es": [
      "El refugio está situado en el Col de la Golèse, en el corazón de los pastos de montaña, y ofrece un panorama excepcional del valle del Giffre (Samoëns) en el lado sur y de la Mancha (Morzine) en el lado norte."
    ],
    "nl": [
      "De refuge ligt op de Col de la Golèse in het hart van de bergweiden en biedt een uitzonderlijk panorama op de vallei van de Giffre (Samoëns) aan de zuidkant en de Manche (Morzine) aan de noordkant."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant at the Refuge de la Golèse"
    ],
    "fr": [
      "Restaurant du Refuge de la Golèse"
    ],
    "nl": [
      "Restaurant in de Refuge de la Golèse"
    ]
  },
