  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen die Möglichkeit, einzigartige handwerkliche und künstlerische Eskapaden zu erleben: Praktische Praktika zur Einführung in ein bestimmtes Know-how im Regionalen Naturpark Pilat und in einem Geist des geselligen Austauschs."
    ],
    "en": [
      "We offer you the opportunity to experience unique Artistic and Artistic Escapades: practical courses of initiation to a know-how in the Regional Natural Park of Pilat and in a spirit of friendly exchange."
    ],
    "it": [
      "Vi offriamo l'opportunità di vivere escapades artistiche e artistiche uniche: corsi pratici di iniziazione a un know-how nel Parco Naturale Regionale di Pilat e in uno spirito di scambio conviviale."
    ],
    "fr": [
      "Nous vous proposons de vivre des Escapades Artisanales et Artistiques uniques : des stages pratiques d'initiation à un savoir-faire dans le Parc Naturel Régional du Pilat et dans un esprit d'échange convivial."
    ],
    "nl": [
      "Wij bieden u de mogelijkheid om unieke Artistieke en Artistieke Escapades te beleven: praktische initiatiecursussen in een knowhow in het Regionaal Natuurpark Pilat en in een geest van vriendschappelijke uitwisseling."
    ],
    "es": [
      "Te ofrecemos la oportunidad de vivir Escapadas Artísticas y Artísticas únicas: cursos prácticos de iniciación a un saber hacer en el Parque Natural Regional del Pilat y en un espíritu de intercambio convivencial."
    ]
  },
