  "rdfs:comment": {
    "de": [
      "Als Familienbetrieb finden Sie bei uns je nach Jahreszeit die Produkte des Bauernhofs.\r\nZögern Sie nicht, uns für weitere Informationen zu kontaktieren. Es besteht die Möglichkeit, die Produkte per Post zu versenden, zuzüglich Portokosten, je nach Gewicht."
    ],
    "en": [
      "As a family-run business, you'll be able to buy farm produce from us, according to the season.\r\nPlease do not hesitate to contact us for further information. Products can be sent by post, but postage is extra, depending on weight."
    ],
    "it": [
      "Azienda a conduzione familiare, qui troverete i prodotti della fattoria, a seconda delle stagioni.\r\nNon esitate a contattarci per qualsiasi informazione. Possibilità di inviare i prodotti per posta, con costi di spedizione aggiuntivi a seconda del peso."
    ],
    "fr": [
      "Exploitation familiale, vous trouverez chez nous les produits de la ferme, en fonction des saisons.\r\nN'hésitez pas à nous contacter pour tout renseignement. Possibilité d'envoyer les produits par la poste, frais de port en sus, selon le poids."
    ],
    "es": [
      "Empresa familiar, aquí encontrará los productos de la granja, según las estaciones.\r\nNo dude en ponerse en contacto con nosotros para cualquier información. Posibilidad de enviar los productos por correo, los gastos de envío son adicionales, dependiendo del peso."
    ],
    "nl": [
      "Als familiebedrijf kun je bij ons, afhankelijk van het seizoen, producten van de boerderij kopen.\r\nAarzel niet om contact met ons op te nemen voor meer informatie. Producten kunnen per post worden verzonden, maar de verzendkosten zijn afhankelijk van het gewicht."
    ]
  },
  "rdfs:label": {
    "fr": [
      "EARL de Montlahuc"
    ]
  },
