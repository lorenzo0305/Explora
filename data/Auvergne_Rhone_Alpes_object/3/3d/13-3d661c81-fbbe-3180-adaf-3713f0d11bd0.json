  "rdfs:comment": {
    "de": [
      "Diese Kirche Notre-Dame, die ursprünglich unter dem Namen Saint-Marcellin bekannt war, ist ein schönes Beispiel für die spätromanische Kunst des mittleren Rhônetals."
    ],
    "en": [
      "This Notre-Dame church, originally known as Saint Marcellin, is a fine example of late Romanesque art in the mid-Rhône valley."
    ],
    "it": [
      "La chiesa di Notre-Dame, originariamente nota come Saint-Marcellin, è un bell'esempio di arte tardo-romanica nella media valle del Rodano."
    ],
    "fr": [
      "Cette église Notre-Dame, originellement connue sous le vocable de Saint-Marcellin, est un bel exemple de l’art roman tardif de la moyenne Vallée du Rhône."
    ],
    "es": [
      "Esta iglesia de Notre-Dame, originalmente conocida como Saint-Marcellin, es un bello ejemplo del arte románico tardío en el valle medio del Ródano."
    ],
    "nl": [
      "Deze kerk Notre-Dame, die oorspronkelijk Saint Marcellin heette, is een mooi voorbeeld van laatromaanse kunst in het midden van de Rhône-vallei."
    ]
  },
