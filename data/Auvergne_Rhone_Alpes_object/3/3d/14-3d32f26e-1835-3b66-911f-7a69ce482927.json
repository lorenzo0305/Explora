  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c23b543d-f995-3693-935b-853dd41e4957",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage :\n\nMontag bis Freitag von 9:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr\n\nSamstags von 9.00 bis 12.00 Uhr\n \nAbholung im Geschäft\n\nLieferung in einem Umkreis von 15 km um das Geschäft\n\n\n "
        ],
        "en": [
          "Information :\n\nOpening days :\n\nMonday to Friday, 9:00 am to 12:00 pm and 2:00 pm to 6:00 pm\n\nSaturday from 9h00 to 12h00\n \nIn-store collection\n\nDelivery within a 15km radius of the store\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura :\n\nDal lunedì al venerdì, dalle 9.00 alle 12.00 e dalle 14.00 alle 18.00\n\nSabato dalle 9.00 alle 12.00\n \nRaccolta in negozio\n\nConsegna nel raggio di 15 km dal negozio\n\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : \n\nDu lundi au vendredi de 9h00 à 12h00 et de 14h00 à 18h00\n\nLe samedi de 9h00 à 12h00\n \nRetrait en magasin\n\nLivraison dans un rayon de 15km autour du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen :\n\nMaandag tot vrijdag van 9u tot 12u en van 14u tot 18u\n\nZaterdag van 9.00 tot 12.00 uur\n \nOphalen in de winkel\n\nLevering binnen een straal van 15 km van de winkel\n\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura :\n\nDe lunes a viernes, de 9.00 a 12.00 h. y de 14.00 a 18.00 h\n\nSábados de 9h a 12h\n \nRecogida en tienda\n\nEntrega en un radio de 15 km de la tienda\n\n\n "
        ]
      },
