  "rdfs:comment": {
    "de": [
      "Ein städtisches Arthouse-Kino für alle! Mon Ciné besitzt die Labels Jeune Public (Junges Publikum) und Europa Cinémas - Recherche et Découverte (Europa-Kinos - Forschung und Entdeckung). Sein Saal ist klimatisiert und für Personen mit eingeschränkter Mobilität zugänglich."
    ],
    "en": [
      "A municipal arthouse cinema for all! Mon Ciné holds the Jeune Public and Europa Cinémas - Recherche et Découverte labels. The cinema is air-conditioned and accessible to people with reduced mobility."
    ],
    "it": [
      "Un cinema d'essai comunale per tutti! Mon Ciné ha i marchi Young Audience e Europa Cinemas - Research and Discovery. Il suo cinema è climatizzato e accessibile alle persone con mobilità ridotta."
    ],
    "fr": [
      "Un cinéma d'art et essai municipal pour tous ! Mon Ciné détient les labels Jeune Public et Europa Cinémas - Recherche et Découverte. Sa salle est climatisée et accessible aux personnes à mobilité réduite."
    ],
    "es": [
      "Un cine de arte y ensayo municipal para todos Mon Ciné ha obtenido los sellos Público Joven y Europa Cinémas - Recherche et Découverte. La sala está climatizada y es accesible para personas con movilidad reducida."
    ],
    "nl": [
      "Een gemeentelijke arthouse bioscoop voor iedereen! Mon Ciné heeft de labels Young Audience en Europa Cinemas - Research and Discovery. De bioscoop is voorzien van airconditioning en toegankelijk voor personen met beperkte mobiliteit."
    ]
  },
  "rdfs:label": {
