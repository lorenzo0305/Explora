  "rdfs:comment": {
    "de": [
      "Die Gemeinde verfügt über einen Veranstaltungssaal mit einer Kapazität von 450 bis 2000 Personen (modulierbare Tribüne) und einer 220 m² großen Bühne.\r\nDer Saal verfügt über eine umfangreiche Ton- und Lichttechnik der neuesten Generation."
    ],
    "en": [
      "The municipality has an auditorium with a modular seating capacity of 450 to 2,000 people (modular tiers) and a 220m² stage.\r\nIt is equipped with state-of-the-art sound and lighting systems."
    ],
    "it": [
      "La città dispone di un auditorium con una capacità modulare da 450 a 2.000 persone (posti a sedere modulari) e un palco di 220 m².\r\nÈ dotato di sistemi audio e luci all'avanguardia."
    ],
    "fr": [
      "La commune possède une salle de spectacle d’une capacité d’accueil modulable de 450 à 2000 personnes (gradin modulable) et d’une scène de 220m². \r\nElle est dotée d’un équipement son et lumières très complet et de dernière génération."
    ],
    "es": [
      "Dispone de un auditorio con capacidad para entre 450 y 2.000 personas (asientos modulares) y un escenario de 220 m².\r\nEstá equipado con sistemas de sonido e iluminación de última generación."
    ],
    "nl": [
      "De stad heeft een auditorium met een modulaire capaciteit van 450 tot 2000 mensen (modulaire zitplaatsen) en een podium van 220 m².\r\nHet is uitgerust met ultramoderne geluids- en lichtsystemen."
    ]
  },
  "rdfs:label": {
