  "rdfs:comment": {
    "de": [
      "Ein neues Teamspiel aus Australien, das mit Bögen und Pfeilen mit Schaumstoffspitzen gespielt wird. Das Ziel ist es, möglichst viele Punkte zu erzielen und nicht getroffen zu werden."
    ],
    "en": [
      "A new team game direct from Australia, played with bows and arrows fitted with foam tips. The aim is to score as many points as possible without getting hit."
    ],
    "it": [
      "Un nuovo gioco di squadra direttamente dall'Australia, giocato con archi e frecce dotati di punte di schiuma. L'obiettivo è fare più punti possibile e non farsi colpire."
    ],
    "fr": [
      "Un nouveau jeu par équipe qui nous arrive directement d’Australie, et qui se pratique avec des arcs et des flèches dotées d’embouts en mousse. L’objectif étant de marquer un maximum de points et de ne pas se faire toucher."
    ],
    "es": [
      "Un nuevo juego de equipo directamente desde Australia, que se juega con arcos y flechas provistos de puntas de espuma. El objetivo es conseguir el mayor número de puntos posible sin ser alcanzado."
    ],
    "nl": [
      "Een nieuw teamspel rechtstreeks uit Australië, gespeeld met pijl en boog voorzien van schuimpunten. Het doel is om zoveel mogelijk punten te scoren en niet geraakt te worden."
    ]
  },
