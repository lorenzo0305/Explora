  "rdfs:comment": {
    "de": [
      "Das La Fleur de Thym ist ein traditionelles Restaurant, in dem frische und lokale Produkte im Vordergrund stehen. Es befindet sich in der Altstadt und wird Sie mit seinem authentischen Charme begeistern."
    ],
    "en": [
      "La Fleur de Thym is a traditional restaurant where fresh, local produce takes pride of place. Located in the old town, you'll be seduced by its authentic charm."
    ],
    "it": [
      "La Fleur de Thym è un ristorante tradizionale dove i prodotti freschi e locali sono al primo posto. Situato nel centro storico, vi piacerà per il suo fascino autentico."
    ],
    "fr": [
      "La Fleur de Thym est un restaurant traditionnel où les produits frais et locaux sont à l'honneur. Situé dans la vieille ville, vous serez séduit par son charme authentique."
    ],
    "nl": [
      "La Fleur de Thym is een traditioneel restaurant waar verse, lokale producten de hoofdrol spelen. Gelegen in de oude stad, zult u genieten van de authentieke charme."
    ],
    "es": [
      "La Fleur de Thym es un restaurante tradicional en el que priman los productos frescos y locales. Situado en el casco antiguo, le encantará su encanto auténtico."
    ]
  },
