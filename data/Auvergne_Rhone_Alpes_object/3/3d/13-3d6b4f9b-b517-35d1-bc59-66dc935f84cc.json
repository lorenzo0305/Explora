  "rdfs:comment": {
    "de": [
      "Am Rande der Montagne Bourbonnaise, in einer grünen und familiären Umgebung, entdecken Sie die Domaine du Castel. Reitunterricht ab 2 Jahren (Einzel- und Gruppenunterricht), Praktika, Ausritte an der Hand, Geburtstage und Besuche auf dem Bauernhof."
    ],
    "en": [
      "At the gates of Montagne Bourbonnaise, in a green and family setting, discover the Domaine du Castel. Horse-rding school from 2 years old (individual or collective courses), trainings, rides, birthdays a,d farm visits."
    ],
    "it": [
      "Alle porte della Montagne Bourbonnaise, in un ambiente verde e familiare, scoprite il Domaine du Castel. Lezioni di equitazione per bambini dai 2 anni in su (lezioni individuali e di gruppo), corsi, passeggiate, feste di compleanno e visite alla fattoria."
    ],
    "fr": [
      "Aux portes de la Montagne Bourbonnaise, dans un cadre verdoyant et familial, découvrez le Domaine du Castel. Enseignement de l'équitation à partir de 2 ans (cours individuels et collectifs), stages, balades en main, anniversaires et visites de la ferme."
    ],
    "nl": [
      "Aan de poort van de Montagne Bourbonnaise, in een groene en gezinsvriendelijke omgeving, ontdek het Domaine du Castel. Paardrijlessen voor kinderen vanaf 2 jaar (individuele lessen en groepslessen), cursussen, buitenritten, verjaardagsfeestjes en boerderijbezoeken."
    ],
    "es": [
      "A las puertas de la Montaña Bourbonnaise, en un entorno verde y familiar, descubra el Domaine du Castel. Clases de equitación para niños a partir de 2 años (individuales y en grupo), cursos, paseos, fiestas de cumpleaños y visitas a la granja."
    ]
  },
  "rdfs:label": {
