  "rdfs:comment": {
    "de": [
      "Daniel JOUX ist ein surrealistischer Maler, der seit über 30 Jahren mit Ölfarben arbeitet. Sein künstlerischer Ansatz hat ihn dazu gebracht, Gemälde nach drei verschiedenen Konzeptionen zu schaffen."
    ],
    "en": [
      "Daniel Joux is a surrealist painter since 30 years. His paintaings are made with oil."
    ],
    "it": [
      "Daniel JOUX è un pittore surrealista che lavora ad olio da oltre 30 anni. Il suo approccio artistico lo ha portato a produrre dipinti secondo 3 diverse concezioni."
    ],
    "fr": [
      "Daniel JOUX peintre surréaliste travaille l'huile depuis plus de 30 ans, sa démarche artistique l'a conduit à réaliser des toiles suivant 3 conceptions  différentes."
    ],
    "nl": [
      "Daniel JOUX is een surrealistische schilder die al meer dan 30 jaar met olieverf werkt. Zijn artistieke benadering heeft hem ertoe gebracht doeken te produceren volgens 3 verschillende concepten."
    ],
    "es": [
      "Daniel JOUX es un pintor surrealista que trabaja al óleo desde hace más de 30 años. Su enfoque artístico le ha llevado a producir cuadros siguiendo 3 concepciones diferentes."
    ]
  },
  "rdfs:label": {
