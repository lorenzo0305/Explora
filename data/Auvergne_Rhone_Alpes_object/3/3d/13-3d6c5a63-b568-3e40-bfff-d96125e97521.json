  "rdfs:comment": {
    "de": [
      "Fotoausstellung mit dem Ehrengast Lubin Godin, Gewinner des internationalen Wettbewerbs des Naturhistorischen Museums London \"Wildlife Photographer of the Year\", \"European Widlife Photographer of the Year\" Kategorie unter 14 Jahren."
    ],
    "en": [
      "Photography exhibition featuring Lubin Godin, winner of the London Natural History Museum?s international \"Wildlife Photographer of the Year\" and \"European Widlife Photographer of the Year\" competitions in the under-14 category."
    ],
    "it": [
      "Una mostra fotografica con Lubin Godin, vincitore dei concorsi internazionali \"Wildlife Photographer of the Year\" e \"European Widlife Photographer of the Year\" del Museo di Storia Naturale di Londra nella categoria dei minori di 14 anni."
    ],
    "fr": [
      "Exposition de photographies dont l'invité d’honneur est Lubin Godin, Lauréat du concours international du Musée d’Histoire Naturelle de Londres «Wildlife Photographer of the Year», «European Widlife Photographer of the Year» catégorie moins de 14 ans."
    ],
    "es": [
      "Exposición fotográfica de Lubin Godin, ganador de los concursos internacionales \"Wildlife Photographer of the Year\" y \"European Widlife Photographer of the Year\" del Museo de Historia Natural de Londres en la categoría de menores de 14 años."
    ],
    "nl": [
      "Een fototentoonstelling met Lubin Godin, winnaar van de internationale wedstrijden \"Wildlife Photographer of the Year\" en \"European Widlife Photographer of the Year\" van het London Natural History Museum in de categorie onder de 14 jaar."
    ]
  },
