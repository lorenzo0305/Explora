  "rdfs:comment": {
    "de": [
      "Pisten, die mit einem Skilift snooc erreichbar sind!\r\nDen ganzen Tag über können Nicht-Skifahrer auf den nahegelegenen Abfahrtspisten dank des Gaboureaux-Sessellifts die Freuden des Schnees erleben, ohne die Ausrüstung hochziehen zu müssen."
    ],
    "en": [
      "Snooc slopes with one lift!\r\nAll day long, on the nearby downhill ski slopes, non-skiers can try out the joys of the snow without having to bring their equipment up, thanks to the Gaboureaux chairlift."
    ],
    "it": [
      "Piste accessibili in snooc con un ascensore!\r\nPer tutto il giorno, sulle vicine piste da discesa, i non sciatori possono cimentarsi con le gioie della neve senza dover portare su l'attrezzatura, grazie alla seggiovia Gaboureaux."
    ],
    "fr": [
      "Des pistes accessibles en snooc avec une remontée mécanique !\r\nToute la journée, sur les pistes de ski alpin à proximité, les non-skieurs vont pouvoir s'initier aux joies de la neige et sans remonter le matériel grâce au télésiège des Gaboureaux."
    ],
    "es": [
      "¡Pistas accesibles en snooc con telesilla!\r\nDurante todo el día, en las pistas de esquí alpino cercanas, los no esquiadores pueden probar los placeres de la nieve sin tener que subir su equipo, gracias al telesilla de Gaboureaux."
    ],
    "nl": [
      "Pistes toegankelijk via snooc met lift!\r\nOp de nabijgelegen skipistes kunnen niet-skiërs de hele dag de geneugten van de sneeuw uitproberen zonder hun materiaal mee naar boven te hoeven nemen, dankzij de stoeltjeslift van Gaboureaux."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rodelpark - Schneeschlitten (snooc)"
    ],
    "en": [
      "Sledging Park - Snow luge (snooc)"
    ],
    "fr": [
      "Luge Park - Snow luge (snooc)"
    ]
  },
