  "rdfs:comment": {
    "de": [
      "Willkommen im Relais Cyné in St Sorlin. Wir können Sie für die Dauer eines Picknicks oder für eine Etappe in einem Biwak empfangen.\r\nPicknicktisch, Anbindestange für Pferde, Unterstand, Wasser und Parkplatz stehen zu Ihrer Verfügung."
    ],
    "en": [
      "Welcome to Relais Cyné in St Sorlin. We can welcome you for a picnic or a bivouac.\r\nPicnic table, horse tie-up bar, shelter, water and parking are at your disposal."
    ],
    "it": [
      "Benvenuti al Relais Cyné a St Sorlin. Possiamo ospitarvi per un picnic o un bivacco.\r\nSono disponibili tavoli da picnic, stecche per cavalli, riparo, acqua e parcheggio."
    ],
    "fr": [
      "Bienvenue au Relais Cyné de St Sorlin. Nous pouvons vous accueillir le temps d'un pique nique ou pour une étape en bivouac. \r\nTable de pique-nique, barre d'attache pour chevaux, abri, eau et parking sont à votre disposition."
    ],
    "nl": [
      "Welkom bij Relais Cyné in St Sorlin. Je kunt bij ons terecht voor een picknick of een bivak.\r\nPicknicktafels, paardenbanden, beschutting, water en parkeergelegenheid zijn allemaal beschikbaar."
    ],
    "es": [
      "Bienvenido al Relais Cyné en St Sorlin. Podemos acogerle para un picnic o un vivac.\r\nMesas de picnic, amarres para caballos, refugio, agua y aparcamiento a su disposición."
    ]
  },
  "rdfs:label": {
