  "rdfs:comment": {
    "de": [
      "Im Rhythmus der Jahreszeiten wird die Speisekarte des Restaurants immer wieder erneuert, um stets Qualität und Frische zu bieten!\r\nJeden Tag werden Tagesvorschläge gemacht, ohne die Vorspeisen- und Dessertbuffets zu vergessen."
    ],
    "en": [
      "The restaurant's menu changes with the seasons to always bring quality and freshness!\r\nEvery day, the suggestions of the day are proposed, without forgetting the hors d'oeuvre and dessert buffets."
    ],
    "it": [
      "Il menu del ristorante cambia con le stagioni, garantendo sempre qualità e freschezza!\r\nOgni giorno vengono proposte le proposte del giorno, senza dimenticare i buffet di antipasti e dolci."
    ],
    "fr": [
      "Au rythme des saisons, la carte du restaurant se renouvelle pour toujours apporter qualité et fraîcheur !\r\nChaque jour, sont proposées les suggestions du jour, sans oublier les buffets de hors d'oeuvre et de desserts."
    ],
    "nl": [
      "Het menu van het restaurant verandert met de seizoenen en biedt altijd kwaliteit en versheid!\r\nElke dag worden de suggesties van de dag voorgesteld, zonder de buffetten van hors d'oeuvres en desserts te vergeten."
    ],
    "es": [
      "El menú del restaurante cambia con las estaciones, ofreciendo siempre calidad y frescura\r\nCada día se proponen las sugerencias del día, sin olvidar los buffets de entremeses y postres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le restaurant du Campanile"
    ]
  },
