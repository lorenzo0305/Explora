  "rdfs:comment": {
    "de": [
      "Das Plateau von Gergovia in der Nähe von Clermont-Ferrand ist ein symbolträchtiger Ort der gallischen Geschichte, insbesondere wegen des berühmten Sieges von Vercingetorix über Julius Cäsar im Jahr 52 v. Chr.."
    ],
    "en": [
      "The Gergovie plateau, near Clermont-Ferrand, is an emblematic site in Gallic history, notably for Vercingetorix's famous victory over Julius Caesar in 52 BC."
    ],
    "it": [
      "L'altopiano di Gergovie, vicino a Clermont-Ferrand, è un luogo simbolo della storia della Gallia, in particolare per la famosa vittoria di Vercingetorige su Giulio Cesare nel 52 a.C.."
    ],
    "fr": [
      "Le plateau de Gergovie, situé près de Clermont-Ferrand, est un site emblématique de l'histoire gauloise, notamment pour la célèbre victoire de Vercingétorix sur Jules César en 52 av. J.-C."
    ],
    "es": [
      "La meseta de Gergovie, cerca de Clermont-Ferrand, es un lugar emblemático de la historia gala, sobre todo por la famosa victoria de Vercingetórix sobre Julio César en el año 52 a.C."
    ],
    "nl": [
      "Het plateau van Gergovie, vlakbij Clermont-Ferrand, is een iconische plek in de Gallische geschiedenis, vooral vanwege de beroemde overwinning van Vercingetorix op Julius Caesar in 52 voor Christus."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Gergovie plateau, a historic site"
    ],
    "fr": [
      "Le plateau de Gergovie, site historique"
    ]
