  "rdfs:comment": {
    "de": [
      "Atelier und Boutique von Adrien Ville, Keramikkünstler. Mitten auf dem Land entdecken Sie einen gemütlichen Ort, der der Keramik gewidmet ist. Handgefertigte Stücke, Laden vor Ort und Kurse für alle Altersgruppen – in einer warmen und einladenden !"
    ],
    "en": [
      "Adrien Ville’s pottery studio and boutique. Nestled in the countryside, discover an intimate space dedicated to ceramics. Handcrafted pieces, on-site shop, and classes for all ages — in a warm, friendly, and inspiring atmosphere!"
    ],
    "it": [
      "Lo studio-boutique del ceramista Adrien Ville. Nel cuore della campagna, scoprite uno spazio intimo dedicato alla ceramica. Pezzi artigianali, negozio in loco e corsi per tutte le età, in un'atmosfera calda, amichevole e stimolante!"
    ],
    "fr": [
      "Atelier-boutique d’Adrien Ville, céramiste. En pleine campagne, découvrez un lieu intimiste dédié à la céramique. Pièces artisanales, boutique sur place et cours pour tous les âges, dans une ambiance chaleureuse, conviviale et inspirante !"
    ],
    "es": [
      "El estudio-boutique del ceramista Adrien Ville. En plena naturaleza, descubra un espacio íntimo dedicado a la cerámica. Piezas artesanales, tienda in situ y cursos para todas las edades, en un ambiente cálido, acogedor e inspirador"
    ],
    "nl": [
      "De studio-boutique van keramist Adrien Ville. Ontdek in het hart van het platteland een intieme ruimte gewijd aan keramiek. Handgemaakte stukken, winkel ter plaatse en cursussen voor alle leeftijden, in een warme, vriendelijke en inspirerende sfeer!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Atelier Igné Ceramics"
    ],
