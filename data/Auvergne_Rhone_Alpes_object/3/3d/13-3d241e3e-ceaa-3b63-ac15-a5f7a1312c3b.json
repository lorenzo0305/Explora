  "rdfs:comment": {
    "de": [
      "Restaurant Au petit Rendez-vous. Regionale Küche, Spezialitäten aus dem Gebirge. Lassen Sie sich die traditionellen Gerichte schmecken, in gemütlichem Dekor und auf der Südterrasse am Rande der Pisten, und kosten Sie die Spezialitäten aus dem Gebirge."
    ],
    "en": [
      "Restaurant Au petit Rendez-vous. In a cosy atmosphere or on the south facing terrace on the edge of the piste, come and discover the mountain specialities, enjoy our home-made traditional cuisine."
    ],
    "it": [
      "Ristorante di cucina locale. Venite a scoprire le nostre specialità di montagna e a gustare la tradizionale cucina casalinga sulla nostra terrazza esposta a sud sulla pista."
    ],
    "fr": [
      "Restaurant proposant une cuisine de terroir. Dans un décor chaleureux et sur la terrasse plein sud bord de piste, venez découvrir les spécialités de montagne, vous régaler d'une cuisine traditionnelle maison."
    ],
    "es": [
      "Restaurante de cocina local. Venga a descubrir nuestras especialidades de montaña y disfrute de la cocina casera tradicional en nuestra terraza orientada al sur junto a la pista."
    ],
    "nl": [
      "Restaurant Au petit Rendez-vous. Streekkeuken, bergspecialiteiten. Ontdek de sfeervolle en warme inrichting en het terras op het zuiden langs de piste. Proef onze bergspecialiteiten en geniet van traditionele huisbereide gerechten."
    ]
  },
