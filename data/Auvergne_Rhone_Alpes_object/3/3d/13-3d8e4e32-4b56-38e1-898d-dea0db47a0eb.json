  "rdfs:comment": {
    "de": [
      "Der See von La Cassière, 25 Minuten von Clermont-Ferrand entfernt, ist ein ruhiger Ort auf dem Land, der nur zum Angeln geöffnet ist...\r\nMöglichkeit zum Angeln von Forellen, Hechten, Zandern und Karpfen."
    ],
    "en": [
      "The lake of La Cassière, located 25 minutes from Clermont-Ferrand, a quiet place in the countryside, open only for fishing ...\r\nPossibility to fish for trout, pike, pikeperch and carp."
    ],
    "it": [
      "Il lago di La Cassière, situato a 25 minuti da Clermont-Ferrand, è un luogo tranquillo in campagna, aperto solo alla pesca...\r\nPossibilità di pescare trote, lucci, luccioperca e carpe."
    ],
    "fr": [
      "Le lac de La Cassière, situé à 25 minutes de Clermont-Ferrand, un endroit calme, à la campagne, ouvert uniquement à la pêche...\r\nPossibilité de pêcher truites, brochets, sandres et carpes."
    ],
    "nl": [
      "Het meer van La Cassière, gelegen op 25 minuten van Clermont-Ferrand, een rustige plek op het platteland, alleen open voor...\r\nMogelijkheid om te vissen op forel, snoek, snoekbaars en karper."
    ],
    "es": [
      "El lago de La Cassière, situado a 25 minutos de Clermont-Ferrand, un lugar tranquilo en el campo, abierto sólo a la pesca...\r\nPosibilidad de pescar truchas, lucios, luciopercas y carpas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at La Cassière lake"
    ],
    "fr": [
      "Pêche au lac de La Cassière"
    ]
  },
