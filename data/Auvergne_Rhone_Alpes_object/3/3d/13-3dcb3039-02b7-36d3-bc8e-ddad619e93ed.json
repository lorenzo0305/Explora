  "rdfs:comment": {
    "de": [
      "Die Fête des Beaux Jours findet im Refuge de P'tit âne in Berbezit statt und soll ein festlicher und geselliger Moment des Teilens sein, mit Animationen, botanischen Spaziergängen, traditionellem Tanz & Essen/Bar den ganzen Tag."
    ],
    "en": [
      "The Fête des Beaux Jours takes place at the Refuge de P'tit âne in Berbezit, and is a festive, convivial event featuring entertainment, botanical walks, a traditional dance and an all-day restaurant/bar."
    ],
    "it": [
      "La Fête des Beaux Jours si svolge presso il Refuge de P'tit âne a Berbezit ed è concepita come un'occasione di festa e convivialità, con intrattenimento, passeggiate botaniche, una danza tradizionale e un ristorante/bar aperto tutto il giorno."
    ],
    "fr": [
      "La Fête des Beaux Jours a lieu au Refuge de P'tit âne à Berbezit et se veut un moment de partage festif et convivial avec animations, balades botaniques, bal traditionnel & restauration/bar toute la journée."
    ],
    "es": [
      "La Fête des Beaux Jours tiene lugar en el Refugio de P'tit âne, en Berbezit, y está concebida como una ocasión festiva y de convivencia para compartir, con espectáculos, paseos botánicos, un baile tradicional y un restaurante-bar abierto todo el día."
    ],
    "nl": [
      "Het Fête des Beaux Jours vindt plaats in de Refuge de P'tit âne in Berbezit en is bedoeld als een feestelijke en gezellige gelegenheid om te delen, met entertainment, botanische wandelingen, een traditionele dans en een restaurant/bar die de hele dag open is."
    ]
  },
