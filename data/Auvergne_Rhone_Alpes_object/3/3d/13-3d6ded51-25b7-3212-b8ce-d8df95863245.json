  "rdfs:comment": {
    "de": [
      "Entdecken Sie vom 4. April bis zum 1. November 2026 den Besichtigungsparcours der Abtei La Chaise-Dieu und tauchen Sie ein in die Architektur und Geschichte dieses prestigeträchtigen Ortes in einer immersiven Szenografie für Groß und Klein"
    ],
    "en": [
      "From April 4 to November 1, 2026, come and discover the tour of La Chaise-Dieu Abbey, and immerse yourself in the architecture and history of this prestigious site in an immersive scenography for young and old"
    ],
    "it": [
      "Dal 4 aprile al 1° novembre 2026, venite a scoprire il tour dell'Abbazia di La Chaise-Dieu e immergetevi nell'architettura e nella storia di questo prestigioso sito in una scenografia coinvolgente per grandi e piccini"
    ],
    "fr": [
      "Du 4 avril au 1er novembre 2026, venez découvrir le parcours de visite de l'Abbaye de La Chaise-Dieu et vous imprégner de l'architecture et de l'histoire de ce lieu de prestige au sein d'une scénographie immersive pour petits et grands"
    ],
    "nl": [
      "Kom van 4 april tot 1 november 2026 de rondleiding door de abdij van La Chaise-Dieu ontdekken en laat je onderdompelen in de architectuur en de geschiedenis van deze prestigieuze plek in een meeslepende scenografie voor groot en klein"
    ],
    "es": [
      "Del 4 de abril al 1 de noviembre de 2026, venga a descubrir el recorrido de la abadía de La Chaise-Dieu y sumérjase en la arquitectura y la historia de este prestigioso lugar en una escenografía envolvente para grandes y pequeños"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de visite de l'abbaye de La Chaise-Dieu"
    ]
  },
