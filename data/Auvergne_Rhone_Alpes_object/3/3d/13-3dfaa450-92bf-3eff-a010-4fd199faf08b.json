  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der Challenge Carpe Féminin (Karpfen-Challenge für Frauen) in den Planes d'eau des Ozières in Yzeure teil! Eine sportliche und gesellige Veranstaltung, die den weiblichen Anglern gewidmet ist. Eine Angelkarte ist erforderlich. maximal 10 Teams, zu zweit oder allein."
    ],
    "en": [
      "Take part in the Challenge Carpe Féminin at the Ozières lakes in Yzeure! A friendly sporting event dedicated to women anglers. Fishing card required. 10 teams maximum, in pairs or solo."
    ],
    "it": [
      "Partecipate al Challenge Carpe Féminin sui laghi di Ozières a Yzeure! Un evento sportivo amichevole dedicato alle donne pescatrici. È richiesta la licenza di pesca. massimo 10 squadre, a coppie o in solitaria."
    ],
    "fr": [
      "Participez au Challenge Carpe Féminin aux plans d’eau des Ozières à Yzeure ! Un événement sportif et convivial dédié aux pêcheuses. Carte de pêche obligatoire. 10 équipes maximum, en binôme ou en solo."
    ],
    "es": [
      "Participe en el Challenge Carpe Féminin en los lagos de Ozières, en Yzeure Un evento deportivo amistoso dedicado a las mujeres pescadoras. Se requiere licencia de pesca. 10 equipos como máximo, por parejas o en solitario."
    ],
    "nl": [
      "Doe mee aan de Challenge Carpe Féminin op de meren van Ozières in Yzeure! Een gezellig sportevenement gewijd aan vrouwelijke vissers. Visvergunning verplicht. maximaal 10 teams, in paren of solo."
    ]
  },
  "rdfs:label": {
