      "@id": "https://data.datatourisme.fr/fa263089-32ba-3714-8ac3-de12ccd77b24",
      "dc:description": {
        "de": [
          "Stundenplan: Montag bis Freitag von 8:00 bis 17:50 Uhr\nTarife: System mit regelmäßigen und gelegentlichen Verträgen\nNehmen Sie direkt mit der Kindertagesstätte Kontakt auf\nAlter: Kinder von 2 1/2 Monaten bis zum vollendeten 5"
        ],
        "en": [
          "Hours: Monday to Friday, 8am to 5:50pm\nRates: regular and occasional contracts\nContact the nursery directly\nAge: children from 2 1/2 months to 5 years old"
        ],
        "it": [
          "Orario: dal lunedì al venerdì, dalle 8.00 alle 17.50\nTariffe: sistema di contratti regolari e occasionali\nContattare direttamente l'asilo nido\nEtà: bambini da 2 mesi e mezzo a 5 anni"
        ],
        "fr": [
          "Horaires : du lundi au vendredi de 8h à 17h50\nTarifs : système de contrats réguliers et occasionnels\nPrendre contact avec la garderie directement\nAge : enfants de 2 mois 1/2 à 5 ans révolus"
        ],
        "nl": [
          "Uren: maandag tot vrijdag, 8u tot 17u50\nTarieven: system of regular and occasional contracts\nNeem rechtstreeks contact op met de crèche\nLeeftijd: kinderen van 2 1/2 maand tot 5 jaar"
        ],
        "es": [
          "Horario: de lunes a viernes, de 8.00 a 17.50 horas\nTarifas: sistema de contratos regulares y ocasionales\nContactar directamente con la guardería\nEdad: niños de 2 meses y medio a 5 años"
        ]
      },
