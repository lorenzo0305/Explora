  "rdfs:comment": {
    "de": [
      "Workshop zur künstlerischen Erkundung von Erde und Altmaterialien. Er steht allen das ganze Jahr über offen. Es ist ein Ort des gemeinsamen Erlebens, des Experimentierens, des Auftankens und des kreativen Schaffens."
    ],
    "en": [
      "Artistic workshop for exploring earth and recycled materials. It’s open to all, all year round and it's a place for sharing, experimentation, revitalisation and creation."
    ],
    "it": [
      "Laboratorio di esplorazione artistica in argilla e materiali riciclati. È aperto a tutti, tutto l'anno. È un luogo di condivisione, sperimentazione, ricarica e creazione."
    ],
    "fr": [
      "Atelier d’Exploration artistique en Terre et Matériaux de récupération. Il est ouvert à tous, toute l’année. C’est un lieu de partage, d’expérimentation, de ressourcement et de création."
    ],
    "es": [
      "Taller de exploración artística en arcilla y materiales reciclados. Está abierto a todos, durante todo el año. Es un lugar para compartir, experimentar, recargar y crear."
    ],
    "nl": [
      "Artistieke verkenningsworkshop in klei en gerecyclede materialen. Het is open voor iedereen, het hele jaar door. Het is een plek om te delen, te experimenteren, op te laden en te creëren."
    ]
  },
  "rdfs:label": {
