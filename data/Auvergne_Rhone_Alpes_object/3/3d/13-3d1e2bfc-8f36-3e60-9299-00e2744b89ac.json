  "rdfs:comment": {
    "de": [
      "Supermarkt und Drive. Tankstelle. Es ist auch eine Paketstation und ein Pick-up-Punkt. Hier kann man seine Schlüssel nachmachen, Fotos entwickeln, den Drive nutzen oder sich die Ware nach Hause liefern lassen."
    ],
    "en": [
      "Supermarket and drive. Service station. It is also a Relais Colis and Pick up point. You can reproduce your keys, develop your photos, use the Drive or have them delivered to your home."
    ],
    "it": [
      "Supermercato e auto. Stazione di servizio. È anche un Relais Colis e un punto di ritiro. È possibile riprodurre le chiavi, sviluppare le foto, utilizzare il Drive o farsele consegnare a casa."
    ],
    "fr": [
      "Supermarché et drive. Station service. Il est aussi Relais Colis et point Pick up. On peut y reproduire ses clés, développer ses photos, utiliser le Drive ou se faire livrer à domicile."
    ],
    "es": [
      "Supermercado y drive. Estación de servicio. También es un Relais Colis y punto de recogida. Podrá reproducir sus llaves, revelar sus fotos, utilizar el Drive o pedir que se lo lleven a casa."
    ],
    "nl": [
      "Supermarkt en rijden. Tankstation. Het is ook een Relais Colis en Pick up point. Je kunt je sleutels reproduceren, je foto's ontwikkelen, de Drive gebruiken of thuis laten bezorgen."
    ]
  },
  "rdfs:label": {
