  "rdfs:comment": {
    "de": [
      "Das Spa des Hotels Alparena**** ist ein wahrer Tempel des Wohlbefindens. Entspannen Sie sich bei einer unserer umfassenden Behandlungen von Thalgo, einer französischen Marke, die seit 1964 Pionierarbeit in der Meereskosmetik leistet."
    ],
    "en": [
      "The spa at the Alparena**** Hotel is a true temple of well-being. Relax with one of our comprehensive treatments by Thalgo, a French brand that has been a pioneer in marine cosmetology since 1964."
    ],
    "it": [
      "La spa dell'Hotel Alparena**** è un vero e proprio tempio del benessere. Rilassatevi con uno dei nostri trattamenti completi firmati Thalgo, marchio francese pioniere nella cosmetologia marina dal 1964."
    ],
    "fr": [
      "Le spa de l'Hôtel Alparena**** est un véritable temple du bien-être. Relaxez vous avec l'un de nos soins complets signés Thalgo, une marque française pionnière en cosmétologie marine depuis 1964."
    ],
    "es": [
      "El spa del Hôtel Alparena**** es un auténtico templo del bienestar. Relájese con uno de nuestros completos tratamientos de Thalgo, marca francesa pionera en cosmetología marina desde 1964."
    ],
    "nl": [
      "De spa van Hôtel Alparena**** is een ware tempel van welzijn. Ontspan met een van onze complete behandelingen van Thalgo, een Frans merk dat al sinds 1964 pioniert op het gebied van mariene cosmetologie."
    ]
  },
