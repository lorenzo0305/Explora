  "rdfs:comment": {
    "de": [
      "Wir lieben es, Villeneuve in Aufruhr, in Wahnsinn, in Feststimmung zu sehen!\r\nUmzug durch das Stadtzentrum mit Wagen und verkleideten Menschen!"
    ],
    "en": [
      "We love seeing Villeneuve en Ébullition, en Folie, en Fête!\r\nA parade of floats and people in fancy dress!"
    ],
    "it": [
      "Ci piace vedere Villeneuve en Ébullition, en Folie, en Fête!\r\nCarri allegorici e persone in maschera sfilano nel centro della città!"
    ],
    "fr": [
      "On adore voir Villeneuve en Ébullition, en Folie, en Fête !\r\nDéambulation en centre ville de chars et de personnes déguisées !"
    ],
    "es": [
      "¡Nos encanta ver Villeneuve en Ébullition, en Folie, en Fête!\r\nCarrozas y disfraces desfilan por el centro de la ciudad"
    ],
    "nl": [
      "Villeneuve en Ébullition, en Folie, en Fête zien we graag!\r\nPraalwagens en verklede mensen paraderen door het stadscentrum!"
    ]
  },
