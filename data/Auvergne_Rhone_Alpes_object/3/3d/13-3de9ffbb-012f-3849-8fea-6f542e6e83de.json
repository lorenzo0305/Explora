  "rdfs:comment": {
    "de": [
      "Erbaut 1859 von dem Ingenieur Achille Tracol und dem Architekten Pierre Bossan, dessen Nachfolger Joannis Rev (ausgebildet von Pierre Bossan) wurde.\r\nDie Glasfenster wurden von der Werkstatt Thomas angefertigt, die seit 1875 als Glasmeister in Valence tätig ist."
    ],
    "en": [
      "Built in 1859 by engineer Achille TRACOL and architect Pierre BOSSAN, succeeded by Joannis REV (trained by Pierre BOSSAN). \r\nThe stained glass windows were created by the THOMAS workshop, a master glassmaker in Valence since 1875."
    ],
    "it": [
      "Costruita nel 1859 dall'ingegnere Achille Tracol e dall'architetto Pierre Bossan, a cui successe Joannis Rev (formato da Pierre Bossan).\r\nLe vetrate sono state realizzate dal laboratorio Thomas, maestro vetraio a Valence dal 1875."
    ],
    "fr": [
      "Construite en 1859 par l'ingénieur Achille Tracol et l'architecte Pierre Bossan, à qui succèdera Joannis Rev (formé par Pierre Bossan).\r\nLes vitraux ont été réalisés par l'atelier Thomas, maitre-verrier à Valence depuis 1875."
    ],
    "nl": [
      "Gebouwd in 1859 door de ingenieur Achille TRACOL en de architect Pierre BOSSAN, die werd opgevolgd door Joannis REV (opgeleid door Pierre BOSSAN). \r\nDe glas-in-loodramen zijn gemaakt door het atelier THOMAS, een meester-glasblazer in Valence sinds 1875."
    ],
    "es": [
      "Construido en 1859 por el ingeniero Achille Tracol y el arquitecto Pierre Bossan, a quien sucedió Joannis Rev (formado por Pierre Bossan).\r\nLas vidrieras fueron realizadas por el taller Thomas, maestro vidriero de Valence desde 1875."
    ]
  },
  "rdfs:label": {
