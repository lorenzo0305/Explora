  "rdfs:comment": {
    "de": [
      "Das COSEC ist im Wesentlichen den Sportvereinen und den Schulkindern von Bellerivois vorbehalten und empfängt die Vereine in Räumen, die für jede Sportart geeignet sind: Gymnastik, Tomba, Mannschaftssportarten in der Halle und Tennis."
    ],
    "en": [
      "Essentially reserved for sports clubs and schoolchildren in Bellerivois, the COSEC receives associations in rooms adapted to each sport: gymnastics, tomba, indoor team sports and tennis."
    ],
    "it": [
      "Riservato essenzialmente alle società sportive e agli studenti di Bellerivo, il COSEC dispone di sale adatte a ogni sport: ginnastica, tomba, sport di squadra indoor e tennis."
    ],
    "fr": [
      "Essentiellement réservé aux clubs sportifs et aux scolaires bellerivois, le COSEC reçoit les associations dans des salles adaptées à chaque sport : gymnastique, tomba, sports collectifs en salle et tennis."
    ],
    "es": [
      "Reservado esencialmente a los clubes deportivos y a los escolares de Bellerivo, el COSEC dispone de salas adaptadas a cada deporte: gimnasia, tomba, deportes de equipo en sala y tenis."
    ],
    "nl": [
      "Het COSEC is hoofdzakelijk gereserveerd voor de sportverenigingen van Bellerivo en schoolkinderen en beschikt over zalen die zijn aangepast aan elke sport: gymnastiek, tomba, zaalsporten en tennis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "COSEC (Complexe OmniSports Évolutif Couvert)"
    ]
  },
