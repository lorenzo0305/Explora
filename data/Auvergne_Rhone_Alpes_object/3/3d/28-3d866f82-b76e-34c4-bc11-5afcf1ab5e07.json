  "rdfs:comment": {
    "de": [
      "La Pommeraie de Chaussoy-Épagny bietet Ihnen den Verkauf von Äpfeln aus einem neuen Obstgarten mit elf Bio-Apfelsorten in Chaussoy-Épagny direkt ab Hof an"
    ],
    "en": [
      "La Pommeraie de Chaussoy-Épagny sells apples from a new orchard of eleven varieties of organic apples in Chaussoy-Épagny directly from the farm"
    ],
    "it": [
      "La Pommeraie de Chaussoy-Épagny vende direttamente dalla fattoria le mele di un nuovo frutteto di undici varietà di mele biologiche a Chaussoy-Épagny"
    ],
    "fr": [
      "La Pommeraie de Chaussoy-Épagny vous propose la vente de pommes provenant d'un nouveau verger de onze variétés de pommes bio à Chaussoy-Épagny directement à la ferme"
    ],
    "nl": [
      "La Pommeraie de Chaussoy-Épagny verkoopt appels uit een nieuwe boomgaard met elf soorten biologische appels in Chaussoy-Épagny, rechtstreeks van de boerderij"
    ],
    "es": [
      "La Pommeraie de Chaussoy-Épagny vende manzanas de un nuevo huerto de once variedades de manzanas ecológicas en Chaussoy-Épagny directamente de la explotación"
    ]
  },
