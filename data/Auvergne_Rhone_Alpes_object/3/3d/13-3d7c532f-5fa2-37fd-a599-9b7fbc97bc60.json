  "rdfs:comment": {
    "de": [
      "Dieses denkmalgeschützte Herrenhaus aus dem 16. Jahrhundert ist ein Fotozentrum, das zum Diagonal-Netzwerk gehört. Es bietet 4 bis 5 Originalausstellungen pro Jahr. Es trägt auch die jährliche Fotoresidenz der Stadt."
    ],
    "en": [
      "This listed 16th-century mansion is a photographic center owned by the city of Clermont-Ferrand. It offers 4 to 5 original exhibitions a year. It also hosts the city's annual photography residency."
    ],
    "it": [
      "Questa casa di città del XVI secolo, sottoposta a vincolo, è un centro fotografico di proprietà della città di Clermont-Ferrand. Vi si tengono 4 o 5 mostre originali all'anno. Ospita inoltre la residenza fotografica annuale della città."
    ],
    "fr": [
      "Cet hôtel particulier du XVIe siècle, classé monument historique, est un centre photographique appartenant à la ville de Clermont-Ferrand. Il propose 4 à 5 expositions originales par an. Il porte également la résidence photographique annuelle de la Ville."
    ],
    "es": [
      "Esta casa urbana catalogada del siglo XVI es un centro fotográfico perteneciente a la red Diagonal. Acoge 4 ó 5 exposiciones originales al año. También acoge la residencia fotográfica anual de la ciudad."
    ],
    "nl": [
      "Dit geklasseerde 16e-eeuwse herenhuis is een fotografisch centrum dat deel uitmaakt van het Diagonaal-netwerk. Er worden 4 of 5 originele tentoonstellingen per jaar gehouden. Er is ook een jaarlijkse fotografische residentie van de stad."
    ]
  },
