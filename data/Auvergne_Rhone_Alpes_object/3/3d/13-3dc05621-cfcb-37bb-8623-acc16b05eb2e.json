  "rdfs:comment": {
    "de": [
      "Italienische Spezialitäten: Pizza aus dem Holzofen vor Ort oder zum Mitnehmen, Pasta und Piadina. Hausgemachte Desserts (lokale Produkte + italienische Produkte). Kapazität: 30 Gedecke. Frühstücksschecks werden akzeptiert."
    ],
    "en": [
      "Italian specialties: pizza wood fire on or off the premises, Pasta and Piadina. Homemade desserts (Italian products + local products).\nCapacity: 30 Flatware. \nLuncheon voucher accepted."
    ],
    "it": [
      "Specialità italiane: pizza cotta a legna sul posto o da asporto, pasta e piadina. Dolci fatti in casa (prodotti locali + prodotti italiani). Capacità: 30 coperti. Si accettano buoni pasto."
    ],
    "fr": [
      "Spécialités Italiennes : Pizza au feu de bois sur place ou à emporter, Pasta et Piadina. Desserts faits maison (produits locaux + produits italiens). Capacité : 30 couverts. Chèque déjeuner acceptés."
    ],
    "nl": [
      "Italiaanse specialiteiten: Houtovenpizza om te eten of om mee te nemen, Pasta en Piadina. Huisgemaakte desserts (lokale producten + Italiaanse producten). Capaciteit: 30 couverts. Luncheon vouchers worden geaccepteerd."
    ],
    "es": [
      "Especialidades italianas: Pizza al horno de leña al momento o para llevar, Pasta y Piadina. Postres caseros (productos locales + productos italianos). Capacidad: 30 cubiertos. Se aceptan vales de comida."
    ]
  },
  "rdfs:label": {
