  "rdfs:comment": {
    "de": [
      "Ein schönes Hotel inmitten des regionalen Naturparks Livradois-Forez.\r\n7 geräumige und angenehme Zimmer. Ideal für Wanderer und Angler. In der Nähe der Berge und des Forellenflusses.\r\nRestaurant vor Ort für Ihr Geschmackserlebnis."
    ],
    "en": [
      "A beautiful hotel in the middle of the Livradois-Forez Regional Natural Park.\r\n7 spacious and pleasant rooms. Ideal for hikers, fishermen. Close to the mountain and trout river.\r\nRestaurant on the spot for your gustatory pleasure."
    ],
    "it": [
      "Un bellissimo hotel nel cuore del Parco Naturale Regionale Livradois-Forez.\r\n7 camere spaziose e piacevoli. Ideale per escursionisti e pescatori. Vicino alla montagna e al fiume delle trote.\r\nRistorante in loco per il vostro piacere gustativo."
    ],
    "fr": [
      "Un bel hôtel au milieu du Parc naturel régional Livradois-Forez.\r\n7 chambres spacieuses et agréables. Idéal pour les randonneurs, pêcheurs. À proximité de la montagne et de rivière à truite.\r\nRestaurant sur place pour votre plaisir gustatif."
    ],
    "es": [
      "Un bonito hotel en pleno Parque Natural Regional de Livradois-Forez.\r\n7 habitaciones espaciosas y agradables. Ideal para excursionistas, pescadores. Cerca de la montaña y del río de truchas.\r\nRestaurante in situ para su placer gustativo."
    ],
    "nl": [
      "Een prachtig hotel midden in het regionale natuurpark Livradois-Forez.\r\n7 ruime en aangename kamers. Ideaal voor wandelaars, vissers. Dicht bij de berg en de forellenrivier.\r\nRestaurant ter plaatse voor uw smaakpapillen."
    ]
  },
