  "rdfs:comment": {
    "de": [
      "Willkommen im Restaurant Le Ruisseau Gourmand, das in Tencin im Herzen des Grésivaudan-Tals liegt. Unser Lokal bietet Ihnen eine traditionelle französische Küche mit hausgemachten Gerichten, die Ihren Gaumen erfreuen werden."
    ],
    "en": [
      "Welcome to the Ruisseau Gourmand restaurant in Tencin, in the heart of the Grésivaudan valley. Our establishment offers traditional French cuisine, with homemade dishes that will delight your taste buds."
    ],
    "it": [
      "Benvenuti al ristorante Ruisseau Gourmand di Tencin, nel cuore della valle del Grésivaudan. Il nostro ristorante offre una cucina tradizionale francese, con piatti fatti in casa che delizieranno il vostro palato."
    ],
    "fr": [
      "Bienvenue au restaurant  le Ruisseau Gourmand, situé à Tencin, en plein cœur de la vallée du Grésivaudan. Notre établissement vous propose une cuisine traditionnelle française, avec des plats faits maison qui raviront vos papilles."
    ],
    "nl": [
      "Welkom bij restaurant Ruisseau Gourmand in Tencin, in het hart van de Grésivaudan-vallei. Ons restaurant biedt een traditionele Franse keuken, met huisgemaakte gerechten die uw smaakpapillen zullen verrukken."
    ],
    "es": [
      "Bienvenido al restaurante Ruisseau Gourmand de Tencin, en el corazón del valle de Grésivaudan. Nuestro restaurante ofrece cocina tradicional francesa, con platos caseros que harán las delicias de su paladar."
    ]
  },
  "rdfs:label": {
