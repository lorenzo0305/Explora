  "rdfs:comment": {
    "de": [
      "Schneckenproduzenten mit Bio-Label, die im Norden des Departements Allier angesiedelt sind. Verkauf von gekochten Produkten auf der Grundlage von Bauernhofschnecken.\r\nVerkauf von Produkten des Bauernhofs das ganze Jahr über.\r\nEmpfang von Wohnmobilen das ganze Jahr über."
    ],
    "en": [
      "Organic snail producers located in the north of the Allier department. Sale of prepared farm snail products.\r\nSale of farm products all year round.\r\nCamper service all year round."
    ],
    "it": [
      "Allevatori di lumache biologiche nel nord del dipartimento dell'Allier. Vendita di prodotti a base di lumache cotte.\r\nVendita di prodotti agricoli tutto l'anno.\r\nI camper sono benvenuti tutto l'anno."
    ],
    "fr": [
      "Producteurs d'escargots labellisés en agriculture biologique situés dans le nord du département de l'Allier. Vente de produits cuisinés à base d'escargots fermiers.\r\nVente des produits de la ferme toute l'année.\r\nAccueil de camping-cars toute l'année."
    ],
    "es": [
      "Caracoleros ecológicos del norte del departamento de Allier. Venta de productos de caracol de granja cocidos.\r\nVenta de productos de granja todo el año.\r\nAcogida de autocaravanas todo el año."
    ],
    "nl": [
      "Biologische slakkenkwekers in het noorden van het departement Allier. Verkoop van gekookte slakken van de boerderij.\r\nVerkoop van producten van de boerderij het hele jaar door.\r\nCampers het hele jaar welkom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les escargots des Julien"
    ]
  },
