  "rdfs:comment": {
    "de": [
      "Seit September 2024 sind zwei Manga-Koffer im öffentlichen Lesenetzwerk unterwegs. Sie reisen das ganze Jahr über und bleiben zwei Monate lang in jeder Bibliothek."
    ],
    "en": [
      "Since September 2024, two manga suitcases have been circulating in the public reading network. They travel throughout the year, staying for two months in each library."
    ],
    "it": [
      "Dal settembre 2024, due valigie di manga circolano nella rete di lettura pubblica. Viaggiano durante l'anno e trascorrono due mesi in ogni biblioteca."
    ],
    "fr": [
      "Depuis septembre 2024, deux valises mangas circulent dans le réseau de lecture publique. Elles voyagent toute l'année et séjournent pendant deux mois dans chaque bibliothèque."
    ],
    "nl": [
      "Sinds september 2024 circuleren er twee mangakoffers in het openbare leesnetwerk. Ze reizen het hele jaar door en brengen twee maanden door in elke bibliotheek."
    ],
    "es": [
      "Desde septiembre de 2024, dos maletas manga circulan por la red de lectura pública. Viajan durante todo el año y pasan dos meses en cada biblioteca."
    ]
  },
