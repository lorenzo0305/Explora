  "rdfs:comment": {
    "de": [
      "Xtrême Glisses ist ein leidenschaftliches Sportgeschäft, das sich auf den Verleih, den Verkauf und die Reparatur von Skiern und Fahrrädern in Samoëns spezialisiert hat."
    ],
    "en": [
      "Xtrême Glisses is an enthusiastic sports store specializing in ski and bike rental, sales and repair in Samoëns."
    ],
    "it": [
      "Xtrême Glisses è un negozio di articoli sportivi specializzato nel noleggio, nella vendita e nella riparazione di sci e biciclette a Samoëns."
    ],
    "fr": [
      "Xtrême Glisses est un magasin de sport passionné et spécialisé dans la location, vente et réparation de ski et de vélo à Samoëns."
    ],
    "nl": [
      "Xtrême Glisses is een gepassioneerde sportwinkel gespecialiseerd in de verhuur, verkoop en reparatie van ski's en fietsen in Samoëns."
    ],
    "es": [
      "Xtrême Glisses es una apasionada tienda de deportes especializada en el alquiler, la venta y la reparación de esquís y bicicletas en Samoëns."
    ]
