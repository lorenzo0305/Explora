  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, die Drôme des collines mit einem Elektrofahrrad zu erkunden? Die Fahrräder von Ferdinand sind ideal für die ganze Familie!"
    ],
    "en": [
      "Do you want to discover the Drôme des Collines by electric bike? For all the family, you will find what you are looking for at Ferdinand's bike!"
    ],
    "it": [
      "Volete esplorare la Drôme des collines in bicicletta elettrica? A Les vélos de Ferdinand ce n'è per tutta la famiglia! È disponibile anche una piccola sala giochi!"
    ],
    "fr": [
      "Envie de vous balader et de découvrir la Drôme des collines en vélo électrique? Pour toute la famille, vous trouverez votre bonheur aux vélos de Ferdinand ! Et petite salle de jeux à votre disposition !"
    ],
    "es": [
      "¿Quieres explorar la Drôme des collines en bicicleta eléctrica? En Les vélos de Ferdinand hay actividades para toda la familia También hay una pequeña sala de juegos"
    ],
    "nl": [
      "De Drôme des collines verkennen op een elektrische fiets? Er is iets voor het hele gezin bij Ferdinand's fietsen!"
    ]
  },
