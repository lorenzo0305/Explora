  "rdfs:comment": {
    "de": [
      "In der Nähe von Valence gelegen, bereitet Ihnen der Chefkoch eine traditionelle Küche aus frischen und saisonalen Produkten zu. Er ist auf Fisch spezialisiert und präsentiert Ihnen auch Fleisch aus Frankreich."
    ],
    "en": [
      "The chef makes traditional dishes using fresh seasonal produce in this restaurant near Valence. The fish specialist also serves up French meat."
    ],
    "it": [
      "Situato vicino a Valence, lo chef prepara una cucina tradizionale utilizzando prodotti freschi e di stagione. È uno specialista del pesce e serve anche carni francesi."
    ],
    "fr": [
      "Situé à proximité de Valence, le chef vous prépare une cuisine traditionnelle à base de produits frais et de saison. Spécialiste du poisson, il vous présente également des viandes d'origine française."
    ],
    "es": [
      "Situado cerca de Valence, el chef prepara una cocina tradicional basada en productos frescos y de temporada. Es especialista en pescado y también sirve carnes francesas."
    ],
    "nl": [
      "In de buurt van Valence bereidt de chef een traditionele keuken met verse, seizoensgebonden producten. Hij is een visspecialist en serveert ook Franse vleeswaren."
    ]
  },
