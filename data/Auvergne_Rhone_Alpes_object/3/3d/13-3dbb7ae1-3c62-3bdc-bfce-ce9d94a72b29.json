  "rdfs:comment": {
    "de": [
      "Die Pédagothèque funktioniert nach dem Modell der Ludotheken und Mediatheken: Sie stellt Privatpersonen pädagogisches Material zur Verfügung, um das Lernen von Kindern im Alter von 6 Monaten bis 12 Jahren zu unterstützen."
    ],
    "en": [
      "The Pédagothèque operates along the same lines as toy and media libraries: it provides private individuals with educational materials to support the learning of children aged 6 months to 12 years."
    ],
    "it": [
      "La Pédagothèque opera sul modello delle ludoteche e delle mediateche: mette a disposizione dei privati materiale didattico per sostenere l'apprendimento dei bambini dai 6 mesi ai 12 anni."
    ],
    "fr": [
      "La Pédagothèque fonctionne sur le modèle des ludothèques et des médiathèques : elle met à disposition des particuliers du matériel pédagogique pour soutenir les apprentissages des enfants de 6 mois à 12 ans."
    ],
    "es": [
      "La Pédagothèque funciona según el modelo de las ludotecas y mediatecas: pone a disposición de los particulares material educativo para apoyar el aprendizaje de los niños de 6 meses a 12 años."
    ],
    "nl": [
      "De Pédagothèque werkt volgens hetzelfde model als speelgoed- en mediatheken: het voorziet particulieren van educatief materiaal om het leren van kinderen van 6 maanden tot 12 jaar te ondersteunen."
    ]
  },
  "rdfs:label": {
