  "rdfs:comment": {
    "de": [
      "Le Verre Toqué ? Restaurant des Hotels Ibis Styles in Neuville-en-Ferrain\n\nHausgemachte Küche, die mit frischen, lokalen und saisonalen Produkten zubereitet wird. Neben der Speisekarte wird ein wöchentlich wechselndes Marktmenü angeboten sowie die täglich wechselnde Formule \"du Toqué\" nur mittags.\n\nEin gemütlicher Ort, um mittags und abends zu schlemmen."
    ],
    "en": [
      "Le Verre Toqué ? Restaurant at the Ibis Styles hotel in Neuville-en-Ferrain\n\nHome-cooked cuisine using fresh, local, seasonal produce. In addition to the à la carte menu, we offer a weekly market menu and a different \"Toqué\" formula every day at lunchtime only.\n\nA warm place to enjoy lunch and dinner."
    ],
    "it": [
      "Le Verre Toqué? Ristorante dell'hotel Ibis Styles di Neuville-en-Ferrain\n\nCucina casalinga, con prodotti freschi, locali e di stagione. Oltre al menu à la carte, viene offerto un menu di mercato che cambia ogni settimana e una formula \"Toqué\" diversa ogni giorno solo a pranzo.\n\nUn luogo accogliente dove gustare pranzi e cene."
    ],
    "fr": [
      "Le Verre Toqué – Restaurant de l’hôtel Ibis Styles à Neuville-en-Ferrain\n\nCuisine maison, élaborée avec des produits frais, locaux et de saison. En plus de la Carte, un Menu du Marché  est proposé et renouvelé chaque semaine ainsi que la Formule \"du Toqué\" différente chaque jour le midi uniquement.\n\nUn lieu chaleureux pour se régaler midi et soir."
    ],
    "es": [
      "Le Verre Toqué ? Restaurante del hotel Ibis Styles de Neuville-en-Ferrain\n\nCocina casera, con productos frescos, locales y de temporada. Además del menú a la carta, se ofrece un Menú de Mercado que cambia cada semana, así como una fórmula \"Toqué\" diferente cada día sólo a la hora del almuerzo.\n\nUn lugar cálido para disfrutar del almuerzo y la cena."
    ],
    "nl": [
      "Le Verre Toqué ? Restaurant in het Ibis Styles hotel in Neuville-en-Ferrain\n\nHuiselijke keuken met verse, lokale en seizoensgebonden producten. Naast het à la carte menu is er een wekelijks wisselend marktmenu en elke dag een andere \"Toqué\"-formule, alleen 's middags.\n\nEen warme plek om te genieten van lunch en diner."
    ]
  },
