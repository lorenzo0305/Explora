  "rdfs:comment": {
    "de": [
      "Kommen Sie und genießen Sie es, mit Ihren Kindern in der Natur Spaß zu haben, neue Erfahrungen zu machen und neue Bekanntschaften zu machen!"
    ],
    "en": [
      "Come and have fun with your children in the great outdoors, try out new experiences and meet new people!"
    ],
    "it": [
      "Venite a divertirvi con i vostri bambini all'aria aperta, a provare nuove cose e a conoscere nuove persone!"
    ],
    "fr": [
      "Venez prendre du plaisir, le temps de vous amuser avec votre (vos) enfants dans la nature, tentez de nouvelles expériences, faire de nouvelles rencontres!"
    ],
    "es": [
      "Venga a divertirse con sus hijos al aire libre, a probar cosas nuevas y a conocer gente nueva"
    ],
    "nl": [
      "Kom plezier maken met je kinderen in de buitenlucht, probeer nieuwe dingen uit en ontmoet nieuwe mensen!"
    ]
