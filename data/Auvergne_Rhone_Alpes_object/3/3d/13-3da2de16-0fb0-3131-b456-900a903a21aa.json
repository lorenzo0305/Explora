  "rdfs:comment": {
    "de": [
      "Dorf Costaros: Kirche aus dem 19. Jahrhundert. Jh. Das friedliche Maar du Péchay: Ein Wasserreservoir in einem ehemaligen Explosionskrater (Lesetisch über die Tiere, die den Ort besiedeln)."
    ],
    "en": [
      "Village of Costaros: 19th-century church. Peaceful site of the Péchay maar: water reservoir in an old explosion crater (reading table on the animals occupying the site)."
    ],
    "it": [
      "Villaggio di Costaros: chiesa del XIX secolo. Sito tranquillo del maar di Péchay: serbatoio d'acqua in un vecchio cratere esplosivo (tavola di lettura sugli animali che occupano il sito)."
    ],
    "fr": [
      "Village de Costaros : Église du XIXe siècle. Site paisible du maar du Péchay : retenue d’eau dans un ancien cratère d’explosion (table de lecture sur les animaux occupant le site)."
    ],
    "es": [
      "Pueblo de Costaros: iglesia del siglo XIX. Sitio tranquilo del maar de Péchay: depósito de agua en un antiguo cráter de explosión (tabla de lectura sobre los animales que ocupan el sitio)."
    ],
    "nl": [
      "Dorp Costaros: kerk uit de 19e eeuw. Rustige plek van de maar van Péchay: waterreservoir in een oude explosiekrater (leestafel over de dieren die de plek bewonen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Village | Costaros"
    ]
  },
