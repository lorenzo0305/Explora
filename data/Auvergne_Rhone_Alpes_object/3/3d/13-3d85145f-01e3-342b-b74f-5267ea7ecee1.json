  "rdfs:comment": {
    "de": [
      "Die Stadt Grenoble, die von den Bergmassiven Belledonne, Chartreuse, Oisans und Vercors umgeben ist, bietet einen angenehmen Lebensraum und die Möglichkeit, bei gutem Wetter verrückte Ausflüge zu unternehmen."
    ],
    "en": [
      "Surrounded by the Belledonne, Chartreuse, Oisans and Vercors mountain ranges, Grenoble offers a pleasant living environment and plenty of opportunities to get away from it all when the weather's right."
    ],
    "it": [
      "Circondata dalle catene montuose della Belledonne, della Chartreuse, dell'Oisans e del Vercors, Grenoble offre un ambiente di vita piacevole e molte opportunità per staccare la spina quando il tempo lo consente."
    ],
    "fr": [
      "Ceinte des massifs de Belledonne, Chartreuse, l'Oisans et du Vercors, la ville de Grenoble propose un agréable cadre de vie et de quoi nourrir de folles envies d’escapades dès que le temps s’y prête."
    ],
    "es": [
      "Rodeada por los macizos montañosos de Belledonne, Chartreuse, Oisans y Vercors, Grenoble ofrece un entorno agradable para vivir y muchas oportunidades para evadirse cuando el tiempo acompaña."
    ],
    "nl": [
      "Grenoble wordt omringd door de bergketens Belledonne, Chartreuse, Oisans en Vercors en biedt een aangename leefomgeving en volop mogelijkheden om er even tussenuit te gaan als het weer het toelaat."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cycling itinerary: La Belle Via - Stage 6 - Grenoble > Vinay"
    ],
    "fr": [
      "Itinéraire vélo : La Belle Via - Étape 6 - Grenoble > Vinay"
    ]
  },
