  "rdfs:comment": {
    "de": [
      "Dieser Saal mit 93 Plätzen ist mit einem 7.1-Sound ausgestattet und bietet Ihnen eine intime Atmosphäre.\r\nIn der Saison erwarten Sie jeden Tag zwei bis drei Vorstellungen am Nachmittag und Abend, so viele Gelegenheiten, einen guten Film und nationale Kinostarts zu genießen!"
    ],
    "en": [
      "This 93-seat cinema equipped with 7.1 sound, offers an intimate atmosphere. In summer and winter seasons, every day, two or three screenings await you late afternoon and evening, so many opportunities to enjoy a good film and national releases!"
    ],
    "it": [
      "Questo cinema da 93 posti ha un audio 7.1 e un'atmosfera intima.\r\nIn stagione, vengono organizzate due o tre proiezioni pomeridiane e serali al giorno, che vi daranno la possibilità di godervi un buon film e le uscite nazionali!"
    ],
    "fr": [
      "Cette salle de 93 places, équipée avec un son en 7.1, vous offre une ambiance intimiste.\r\nEn saison, chaque jour deux à trois séances vous attendent en après-midi et soirée, autant d'occasions de profiter d'un bon film et de sorties nationales !"
    ],
    "es": [
      "Este cine de 93 butacas cuenta con sonido 7.1 y un ambiente íntimo.\r\nEn temporada, hay dos o tres proyecciones diarias por la tarde y por la noche, ¡lo que le permitirá disfrutar de una buena película y de estrenos nacionales!"
    ],
    "nl": [
      "Deze bioscoop met 93 zitplaatsen,uitgerust met 7.1-geluid, biedt een intieme sfeer. Tijdens het zomer- en winterseizoen zijn er 's middags en 's avonds twee of drie filmvoorstellingen per dag, zodat u kunt genieten van een goede film en nationale releases!"
    ]
  },
  "rdfs:label": {
