  "rdfs:comment": {
    "de": [
      "Kaddour Hadadi ist ein wunderbarer Erzähler, der auf der Bühne von Claire Bernardot mit Akkordeon und Gesang begleitet wird. Er bietet uns eine bewusste und aufgeklärte, aber auch verbindende und poetische Show."
    ],
    "en": [
      "An outstanding storyteller, accompanied on stage by Claire Bernardot on accordion and vocals, Kaddour Hadadi offers us a show that is both aware and enlightened, as well as unifying and poetic."
    ],
    "it": [
      "Formidabile narratore, accompagnato sul palco da Claire Bernardot alla fisarmonica e alla voce, Kaddour Hadadi ci propone uno spettacolo tanto consapevole e illuminato quanto unificante e poetico."
    ],
    "fr": [
      "Formidable conteur, accompagné sur scène par Claire Bernardot à l’accordéon et au chant, Kaddour Hadadi nous propose un spectacle conscient et éclairé, tout autant que fédérateur et poétique."
    ],
    "nl": [
      "Kaddour Hadadi is een formidabele verteller, die op het podium wordt begeleid door Claire Bernardot op accordeon en zang. Hij brengt ons een show die even bewust en verlicht als verenigend en poëtisch is."
    ],
    "es": [
      "Formidable narrador, acompañado en el escenario por Claire Bernardot al acordeón y la voz, Kaddour Hadadi nos brinda un espectáculo tan consciente e ilustrado como unificador y poético."
    ]
  },
  "rdfs:label": {
    "fr": [
      "HK - Poète en cavale"
    ]
  },
