  "rdfs:comment": {
    "de": [
      "Arson hat ein poppiges, farbenfrohes und engagiertes Universum zwischen Sinnlichkeit, Humor und Reflexion geschaffen. Seine Werke spielen mit den Codes unserer Zeit, um sie besser verschieben zu können, mit einer direkten, lesbaren und bewusst ikonoklastischen Ästhetik."
    ],
    "en": [
      "Arson has created a pop universe, colorful and engaging, between sensuality, humor and reflection. Her works play with the codes of our time, the better to displace them, with a direct, readable and deliberately iconoclastic aesthetic."
    ],
    "it": [
      "Arson ha creato un universo pop colorato e impegnato, che unisce sensualità, umorismo e riflessione. Le sue opere giocano con i codici del nostro tempo, per meglio spiazzarli, con un'estetica diretta, leggibile e volutamente iconoclasta."
    ],
    "fr": [
      "Arson a créé un univers pop, coloré et engagé, entre sensualité, humour et réflexion. Ses œuvres jouent avec les codes de notre époque pour mieux les déplacer, avec une esthétique directe, lisible et volontairement iconoclaste."
    ],
    "nl": [
      "Arson heeft een popuniversum gecreëerd dat zowel kleurrijk als geëngageerd is en sensualiteit, humor en reflectie combineert. Zijn werken spelen met de codes van onze tijd, om ze beter te kunnen verplaatsen, met een esthetiek die direct, leesbaar en opzettelijk iconoclastisch is."
    ],
    "es": [
      "Arson ha creado un universo pop a la vez colorista y comprometido, que combina sensualidad, humor y reflexión. Sus obras juegan con los códigos de nuestro tiempo, para desplazarlos mejor, con una estética directa, legible y deliberadamente iconoclasta."
    ]
  },
  "rdfs:label": {
