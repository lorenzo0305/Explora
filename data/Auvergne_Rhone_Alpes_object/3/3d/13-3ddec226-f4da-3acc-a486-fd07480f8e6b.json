  "rdfs:comment": {
    "de": [
      "\"La Commanderie de Champarey\" ist ein seit 40 Jahren familiengeführtes Hotel-Restaurant in Bourgoin-Jallieu, an der Ferienstraße zwischen Seen und Bergen, vor den Toren des Massivs La Chartreuse und des Vercors, im Herzen der Nord-Isère zwischen Lyon und Grenoble."
    ],
    "en": [
      "\"La Commanderie de Champarey\" has been a family hotel-restaurant for 40 years, located in Bourgoin-Jallieu, on the holiday route between lakes and mountains, at the gateway to the Chartreuse and Vercors mountains, in the heart of Nord-Isère between Lyon and Grenoble."
    ],
    "it": [
      "\"La Commanderie de Champarey\" è un hotel-ristorante a conduzione familiare da 40 anni, situato a Bourgoin-Jallieu, sulla strada delle vacanze tra laghi e montagne, alle porte della Chartreuse e del Vercors, nel cuore della regione Nord-Isère tra Lione e Grenoble."
    ],
    "fr": [
      "\"La Commanderie de Champarey\" est un hôtel-restaurant familial depuis 40 ans, situé à Bourgoin-Jallieu, sur la route des vacances entre lacs et montagnes, aux portes du massif de La Chartreuse et du Vercors, au cœur du Nord-Isère entre Lyon et Grenoble."
    ],
    "nl": [
      "\"La Commanderie de Champarey\" is een familiehotel-restaurant sinds 40 jaar, gelegen in Bourgoin-Jallieu, op de vakantieroute tussen meren en bergen, aan de poort van de Chartreuse en de Vercors, in het hart van de regio Nord-Isère tussen Lyon en Grenoble."
    ],
    "es": [
      "\"La Commanderie de Champarey\" es un hotel-restaurante familiar desde hace 40 años, situado en Bourgoin-Jallieu, en la ruta de vacaciones entre lagos y montañas, a las puertas de la Chartreuse y las montañas de Vercors, en el corazón de la región de Nord-Isère, entre Lyon y Grenoble."
    ]
  },
