  "rdfs:comment": {
    "de": [
      "Auf dem Programm \"Bachblüten\" für dieses Gesundheitscafé: Raum für den Austausch zwischen Patienten und Bürgern mit Gesundheitsreferenten und Expertenpatienten!"
    ],
    "en": [
      "Bach flowers\" on the agenda for this health café: a place for patients and the general public to exchange ideas with health professionals and patient experts!"
    ],
    "it": [
      "I fiori di Bach\" è il tema di questo caffè della salute, un forum per i pazienti e il pubblico in generale per scambiare opinioni con i professionisti della salute e gli esperti dei pazienti!"
    ],
    "fr": [
      "Au programme \"Les fleurs de Bach\" pour ce café santé : espace d'échange entre patients et citoyens avec des intervenants en santé et des patients experts !"
    ],
    "es": [
      "Flores de Bach\" es el tema de este café de la salud, un foro para que pacientes y público en general intercambien opiniones con profesionales de la salud y pacientes expertos"
    ],
    "nl": [
      "Bachbloemen\" is het thema van dit gezondheidscafé, een forum waar patiënten en het grote publiek van gedachten kunnen wisselen met gezondheidsdeskundigen en patiëntenexperts!"
    ]
  },
