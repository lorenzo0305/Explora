  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg der Picola Lambretta bietet Ihnen Olivier Aucelli nun die Möglichkeit, die italienische Küche an einer anderen, geräumigeren und festlicheren Adresse zu entdecken."
    ],
    "en": [
      "With the success of the Picola Lambretta, Olivier Aucelli proposes you to discover Italian cuisine at another more spacious and festive address."
    ],
    "it": [
      "Con il successo della Picola Lambretta, Olivier Aucelli vi propone di scoprire la cucina italiana in un altro indirizzo più spazioso e festoso."
    ],
    "fr": [
      "Avec le succès de la Picola Lambretta, Olivier Aucelli vous propose de découvrir la cuisine italienne à une autre adresse plus spacieuse et festive."
    ],
    "nl": [
      "Met het succes van de Picola Lambretta biedt Olivier Aucelli u de Italiaanse keuken aan op een ander, ruimer en feestelijker adres."
    ],
    "es": [
      "Con el éxito de la Picola Lambretta, Olivier Aucelli le propone descubrir la cocina italiana en otra dirección más amplia y festiva."
    ]
  },
