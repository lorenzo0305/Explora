  "rdfs:comment": {
    "de": [
      "La Clef ist ein assoziatives Kulturcafé, in dem man sich mittags mit hausgemachten veganen und lokalen Mahlzeiten und rund um die Uhr mit leckeren Croques und Desserts verpflegen kann."
    ],
    "en": [
      "La Clef is a cultural café where you can enjoy home-cooked vegan and local meals at lunchtime, and gourmet croques and desserts all day long."
    ],
    "it": [
      "La Clef è un caffè culturale dove si possono gustare piatti vegani e locali cucinati in casa all'ora di pranzo e spuntini e dessert gourmet a qualsiasi ora."
    ],
    "fr": [
      "La Clef est un café culturel associatif où il est possible de se restaurer avec des repas maison végé et local les midis et des croques et desserts gourmands à toute heure."
    ],
    "nl": [
      "La Clef is een cultureel café waar je 's middags kunt genieten van zelfgemaakte veganistische en lokale maaltijden en op elk moment van gastronomische snacks en desserts."
    ],
    "es": [
      "La Clef es un café cultural donde podrá disfrutar de comida casera vegana y local al mediodía y de aperitivos y postres gourmet a cualquier hora."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Clef"
    ]
