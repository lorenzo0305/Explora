  "rdfs:comment": {
    "de": [
      "Das Restaurant \"l'éveil des délices\" liegt in einer grünen und typisch auvergnatischen Umgebung, 40 Minuten von Le Puy-en-Velay und 45 Minuten von Saint-Etienne entfernt. Ihnen werden eine traditionelle Küche und mehrere Menüs angeboten, die auf den neuesten Stand gebracht werden."
    ],
    "en": [
      "The restaurant \"l'éveil des délices\" is located in a green and typically Auvergne setting, 40 minutes from Le Puy-en-Velay and 45 minutes from Saint-Etienne. You'll be offered traditional cuisine and several menus that have been updated."
    ],
    "it": [
      "Il ristorante \"l'éveil des délices\" è immerso nel verde tipico dell'Alvernia, a 40 minuti da Le Puy-en-Velay e a 45 minuti da Saint-Etienne. Vi verrà proposta una cucina tradizionale e diversi menu aggiornati."
    ],
    "fr": [
      "Le restaurant \"l'éveil des délices\", situé dans un cadre verdoyant et typiquement auvergnat à 40 minutes du Puy-en-Velay et 45 minutes de Saint-Etienne. Vous sera proposé une cuisine traditionnelle et plusieurs menus qui sont remis au goût du jour."
    ],
    "nl": [
      "Het restaurant \"l'éveil des délices\" ligt in een typisch groene omgeving in de Auvergne op 40 minuten van Le Puy-en-Velay en 45 minuten van Saint-Etienne. Je krijgt hier een traditionele keuken en verschillende menu's die zijn bijgewerkt."
    ],
    "es": [
      "El restaurante \"l'éveil des délices\" se encuentra en un entorno verde típicamente auvernés, a 40 minutos de Le Puy-en-Velay y a 45 minutos de Saint-Etienne. Le ofrecerán cocina tradicional y varios menús actualizados."
    ]
  },
  "rdfs:label": {
