  "rdfs:comment": {
    "de": [
      "Ideale Anfängerpiste für Anfänger oder Kinder, sowohl für Alpinski als auch für Snowboards. Ein sanfter Hang und ein Teppich zum Aufsteigen. Gespurter und gesicherter Bereich. Zugang mit Skipass."
    ],
    "en": [
      "A beginner's slope, ideal for beginners and children, for both downhill skiing and snowboarding. A gentle slope and a carpet to climb back up. Groomed and secure area. Access with ski pass."
    ],
    "it": [
      "Una pista ideale per i principianti, sia per i bambini che per gli sciatori. Un pendio dolce e un tappeto per risalire. Area curata e sicura. Accesso con skipass."
    ],
    "fr": [
      "Piste d'initiation idéale pour les débutants ou les enfants, en ski alpin comme en snowboard. Une pente tout en douceur et un tapis pour remonter. Espace damé et sécurisé. Accès avec forfait."
    ],
    "es": [
      "Una pista ideal para principiantes, tanto para niños como para esquiadores. Una pendiente suave y una alfombra para subir. Zona cuidada y segura. Acceso con forfait."
    ],
    "nl": [
      "Een ideale beginnerspiste voor zowel kinderen als skiërs. Een zachte helling en een tapijt om terug omhoog te klimmen. Verzorgd en veilig gebied. Toegang met skipas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Espace initiation La Crémaillère - Le Revard"
    ]
  },
