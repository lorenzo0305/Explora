  "rdfs:comment": {
    "de": [
      "Eine Bibliothek, in der sich Groß und Klein um Bücher und punktuelle Animationen versammeln, mit der aktiven Teilnahme eines ganzen Teams von Freiwilligen."
    ],
    "en": [
      "A library where young and old alike can meet around books and occasional activities, with the active participation of a whole team of volunteers."
    ],
    "it": [
      "Una biblioteca dove grandi e piccini possono incontrarsi intorno ai libri e alle attività occasionali, con la partecipazione attiva di un intero gruppo di volontari."
    ],
    "fr": [
      "Une Bibliothèque où petits et grands se retrouvent autour des livres et des animations ponctuelles, avec la participation active de toute une équipe de bénévoles."
    ],
    "es": [
      "Una biblioteca en la que jóvenes y mayores pueden reunirse en torno a los libros y las actividades ocasionales, con la participación activa de todo un equipo de voluntarios."
    ],
    "nl": [
      "Een bibliotheek waar jong en oud elkaar kunnen ontmoeten rond boeken en incidentele activiteiten, met de actieve medewerking van een heel team vrijwilligers."
    ]
