  "rdfs:comment": {
    "de": [
      "Entdeckung der Trüffel (Höhlenforschung, Geschichte, Verkostung) an einem Tag oder à la carte. Die Ecke der Flucht, der Freiheit: eine wahre Geschichte."
    ],
    "en": [
      "Discover the truffle (truffle hunting, historical background, tasting) over one day or tailored visits. A taste of freedom and an opportunity to get away from it all!"
    ],
    "it": [
      "Scoprire il tartufo (cavage, storia, degustazione) in una giornata o alla carta. L'angolo della fuga e della libertà: una storia vera."
    ],
    "fr": [
      "Découverte de la truffe (cavage, historique, dégustation) sur une journée ou à la carte. Le coin de l'évasion, de la liberté : une histoire vraie."
    ],
    "nl": [
      "Introductie truffel (truffel zoeken, geschiedenis, proeverij), een hele dag of activiteit naar keuze. Hier bent u er even helemaal uit, het ultieme vrijheidsgevoel: een waargebeurd verhaal."
    ],
    "es": [
      "Descubra las trufas (cavage, historia, degustación) por un día o a la carta. El rincón de la evasión y la libertad: una historia real."
    ]
  },
