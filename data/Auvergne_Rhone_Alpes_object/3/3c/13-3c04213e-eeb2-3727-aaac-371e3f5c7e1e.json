  "rdfs:comment": {
    "de": [
      "Claire PHILIPCZYK\r\nBergbegleiterin und Yogalehrerin.\r\nDie Verbindung zur Natur und zu sich selbst wieder herstellen, sich in der Anstrengung respektieren, Körper und Geist in Einklang bringen, mit den Elementen in Resonanz sein - das sind die Elemente, die ich gerne mit anderen teile."
    ],
    "en": [
      "Claire PHILIPCZYK\r\nMountain leader"
    ],
    "it": [
      "Claire PHILIPCZYK\r\nGuida alpina e insegnante di yoga.\r\nRicreare legami con la natura e con se stessi, rispettare se stessi nello sforzo, armonizzare corpo e mente, essere in risonanza con gli elementi sono gli elementi che mi piace condividere."
    ],
    "fr": [
      "Claire PHILIPCZYK\r\nAccompagnatrice en montagne et enseignante de yoga.\r\nRecréer des liens avec la Nature et soi-même, se respecter dans l'effort, harmoniser le corps et l'esprit, être en résonance avec les éléments sont les éléments que j'aime à partager."
    ],
    "es": [
      "Claire PHILIPCZYK\r\nLíder de montaña y profesor de yoga.\r\nRecrear los vínculos con la Naturaleza y con uno mismo, respetarse en el esfuerzo, armonizar el cuerpo y la mente, estar en resonancia con los elementos son los elementos que me gusta compartir."
    ],
    "nl": [
      "Claire PHILIPCZYK\r\nBerggids"
    ]
  },
  "rdfs:label": {
    "en": [
      "Quintessence - mountain guide"
    ],
    "fr": [
      "Quintessence - accompagnatrice en montagne"
    ]
  },
