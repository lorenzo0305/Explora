  "rdfs:comment": {
    "de": [
      "Challenge The Room ist das erste Escape Game in der Region Rhône Alpes Auvergne und bietet Ihnen ein originelles Erlebnis mit der Familie, mit Freunden oder Kollegen. Sie haben 60 Minuten Zeit, um zu entkommen!"
    ],
    "en": [
      "A Live Escape Game in Grenoble for you great pleasure ! Adventure, inner-world, team spirit, observation, speed, enquiry... Those are the key words for Challenge The Room. Would you meet the challenges?"
    ],
    "it": [
      "il primo Escape Game della regione Rhône Alpes Auvergne, Challenge The Room vi offre un'esperienza originale con la famiglia, gli amici o i colleghi. Avrete 60 minuti per fuggire!"
    ],
    "fr": [
      "1er Escape Game de la Région Rhône Alpes Auvergne, Challenge The Room vous faire vivre une expérience originale en famille, entre amis ou entre collègues. Vous aurez 60 minutes pour vous échapper !"
    ],
    "nl": [
      "het eerste Escape Game in de regio Rhône Alpes Auvergne, Challenge The Room biedt u een originele ervaring met uw familie, vrienden of collega's. Je hebt 60 minuten om te ontsnappen!"
    ],
    "es": [
      "El 1er Juego de Escape de la región Rhône Alpes Auvergne, Challenge The Room es una experiencia original para familias, amigos o compañeros de trabajo. ¡Tendrás 60 minutos para escapar!"
    ]
  },
