  "rdfs:comment": {
    "de": [
      "Die Domaine de la Combe Morguière ist seit fünf Generationen im Besitz der Familie Desthieux.\r\nSie befindet sich im Herzen des Dorfes Salles-Arbuissonnas im Beaujolais und erstreckt sich über 19 Hektar."
    ],
    "en": [
      "The Domaine de la Combe Morguière has belonged to the Desthieux family for 5 generations. Located in the heart of the village of Salles-Arbuissonnas in Beaujolais, it extends over 20 hectares."
    ],
    "it": [
      "Il Domaine de la Combe Morguière appartiene alla famiglia Desthieux da 5 generazioni.\r\nSituato nel cuore del villaggio di Salles-Arbuissonnas nel Beaujolais, si estende su 19 ettari."
    ],
    "fr": [
      "Le Domaine de la Combe Morguière appartient à la famille Desthieux depuis 5 générations.\r\nPlacé au coeur du village de Salles-Arbuissonnas en Beaujolais, il s'étend sur 19 hectares."
    ],
    "es": [
      "El Domaine de la Combe Morguière pertenece a la familia Desthieux desde hace 5 generaciones.\r\nSituado en el corazón del pueblo de Salles-Arbuissonnas, en Beaujolais, ocupa 19 hectáreas."
    ],
    "nl": [
      "Domaine de la Combe Morguière is al 5 generaties in het bezit van de familie Desthieux.\r\nHet ligt in het hart van het dorp Salles-Arbuissonnas in de Beaujolais en beslaat 19 hectare."
    ]
  },
