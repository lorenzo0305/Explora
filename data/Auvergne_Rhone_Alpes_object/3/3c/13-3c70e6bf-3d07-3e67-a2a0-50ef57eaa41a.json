  "rdfs:comment": {
    "de": [
      "Neben den 1070 Parkplätzen, die die 17 Parkhäuser in Nyons bieten, gibt es auch zahlreiche kostenlose und unbegrenzte Parkplätze, die in den Straßen der Stadt markiert sind."
    ],
    "en": [
      "In addition to the 1,070 parking spaces available in Nyons' 17 parking lots, numerous free, unlimited parking spaces are also available on the town's streets."
    ],
    "it": [
      "Oltre ai 1.070 posti auto nei 17 parcheggi di Nyons, ci sono anche numerosi parcheggi gratuiti e illimitati nelle strade della città."
    ],
    "fr": [
      "Outre les 1070 places de parking qu'offrent les 17 parkings de Nyons, de nombreuses places de stationnement gratuites et illimitées sont également matérialisées dans les rues de la ville."
    ],
    "nl": [
      "Naast de 1.070 parkeerplaatsen in de 17 parkeergarages van Nyons zijn er ook veel gratis en onbeperkte parkeerplaatsen in de straten van de stad."
    ],
    "es": [
      "Además de las 1.070 plazas de aparcamiento en los 17 aparcamientos de Nyons, también hay numerosas plazas gratuitas e ilimitadas en las calles de la ciudad."
    ]
  },
  "rdfs:label": {
