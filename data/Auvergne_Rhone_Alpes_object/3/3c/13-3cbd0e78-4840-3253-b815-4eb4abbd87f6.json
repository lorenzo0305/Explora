  "rdfs:comment": {
    "de": [
      "Im Herzen der Haute-Savoie, zwischen Genf und Thonon, bietet Ihnen Pierrick Challamel, Meister des Konditorenhandwerks, eine große Auswahl an Leckereien, Entremets, kleine Kuchen, Eis, Schokolade, Süßigkeiten, Makronen, personalisierte Kuchen."
    ],
    "en": [
      "Located in the heart of the Haute-Savoie, between Geneva and Thonon, Pierrick Challamel, master pastry craftsman, offers you a wide choice of sweets, Entremets, small cakes, ice cream, chocolate, confectionery, macaroons, personalized cakes."
    ],
    "it": [
      "Situato nel cuore dell'Alta Savoia, tra Ginevra e Thonon, Pierrick Challamel, maestro pasticcere, offre una vasta gamma di prelibatezze, Entremets, torte, gelati, cioccolato, pasticceria, macaron, torte personalizzate."
    ],
    "fr": [
      "Situé au coeur de la Haute-Savoie, entre Genève et Thonon, Pierrick  Challamel, maître artisan pâtissier vous propose un large choix de gourmandises, Entremets, petits gâteaux, glaces, chocolat, confiserie, macarons, gâteaux personnalisés."
    ],
    "es": [
      "Situado en el corazón de la Alta Saboya, entre Ginebra y Thonon, Pierrick Challamel, maestro pastelero, le ofrece una amplia gama de delicias, Entremets, pasteles, helados, chocolate, confitería, macarrones, pasteles personalizados."
    ],
    "nl": [
      "Gelegen in het hart van de Haute-Savoie, tussen Genève en Thonon, biedt Pierrick Challamel, meester patissier, u een ruime keuze aan lekkernijen, Entremets, taarten, ijsjes, chocolade, snoepgoed, bitterkoekjes, gepersonaliseerde taarten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pâtisserie Challamel"
    ]
  },
