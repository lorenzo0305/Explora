  "rdfs:comment": {
    "de": [
      "Willkommen im Herzen des Dorfes. Geschäft für alle Trends im Bereich Skifahren, Textilien oder Accessoires, in dem Neuheiten neben den neuesten Technologien des Wintersports angeboten werden."
    ],
    "en": [
      "Welcome to the heart of the village. A shop for all the latest trends in winter sports, textiles and accessories, where the latest products are displayed alongside the latest technologies in winter sports."
    ],
    "it": [
      "Benvenuti nel cuore del villaggio. Un negozio per tutte le ultime tendenze in fatto di sport sulla neve, tessuti e accessori, dove i prodotti più recenti sono esposti insieme alle ultime tecnologie per gli sport invernali."
    ],
    "fr": [
      "Bienvenue au cœur du village. Magasin de toutes les tendances glisse, textile ou accessoires où les nouveautés côtoient les dernières technologies des sports d’hiver."
    ],
    "nl": [
      "Welkom in het hart van het dorp. Een winkel met de nieuwste trends op het gebied van boardsport, textiel en accessoires, waar nieuwe producten en de nieuwste wintersporttechnologie elkaar ontmoeten."
    ],
    "es": [
      "Bienvenido al corazón del pueblo. Una tienda para todas las últimas tendencias en deportes de nieve, textiles y accesorios, donde se exponen los últimos productos junto con las últimas tecnologías de los deportes de invierno."
    ]
  },
