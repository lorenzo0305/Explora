  "rdfs:comment": {
    "de": [
      "Dromeasy bietet den Verleih von elektrischen Geländerollern mit Zweiradantrieb an. Originelle und ungewöhnliche Fahrzeuge, lassen Sie sich verführen!\r\nSie werden das Tal der Drôme, diese schönen Landschaften und Panoramen auf andere Weise entdecken."
    ],
    "en": [
      "Dromeasy rents out electric two-wheel drive all-terrain scooters. Let yourself be seduced by these original and unusual machines!\r\nDiscover the Drôme Valley, its beautiful landscapes and panoramas, in a whole new way."
    ],
    "it": [
      "Dromeasy offre il noleggio di scooter elettrici a due ruote motrici. Macchine originali e insolite, lasciatevi sedurre!\r\nScoprirete la Valle della Drôme in modo diverso, con i suoi splendidi paesaggi e panorami."
    ],
    "fr": [
      "Dromeasy propose la location de trottinettes tout terrain électriques deux roues motrices. Engins originaux et insolites, laissez-vous séduire !\r\nVous découvrirez autrement la Vallée de la Drôme, ces beaux paysages et panoramas."
    ],
    "nl": [
      "Dromeasy verhuurt elektrische tweewielaangedreven terrein scooters. Laat je verleiden door deze originele en ongewone machines!\r\nOntdek de Drômevallei en haar prachtige landschappen en panorama's op een geheel nieuwe manier."
    ],
    "es": [
      "Dromeasy ofrece el alquiler de scooters eléctricos todo terreno de dos ruedas motrices. Máquinas originales e insólitas, ¡déjese seducir!\r\nDescubrirá el valle de la Drôme de una forma diferente, con sus bellos paisajes y panoramas."
    ]
  },
  "rdfs:label": {
