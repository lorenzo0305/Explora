  "rdfs:comment": {
    "de": [
      "10 Minuten vom Stadtzentrum entfernt, bietet Ihnen dieses Hotel, das unter dem Thema des Kinos dekoriert ist, jeglichen gewünschten Komfort. Besuchen Sie das Institut Lumière und profitieren Sie von einem Sportclub in 500 m Entfernung."
    ],
    "en": [
      "Located in a residential area at the foot of the Sans Souci metro station (6 minutes to Place Bellecour or Part-Dieu train station), the hotel immerses you in the history of cinema. The 4-star hotel has a private car park and a bistronomic restaurant."
    ],
    "it": [
      "Situato a 10 minuti dal centro di Lione, questo hotel decorato sul tema del cinema ti offre tutto il comfort che potresti desiderare. Visita l'Istituto Lumière e approfitta di un club di sport a 500 metri."
    ],
    "fr": [
      "Établi dans un environnement résidentiel, au pied du métro \"Sans Souci\" (6 minutes de la place Bellecour ou de la gare Part-Dieu), cet hôtel 4 étoiles vous plonge dans l'univers du cinéma. Profitez de son parking privé et de son restaurant bistronomique."
    ],
    "es": [
      "Este hotel, situado a 10 minutos del centro urbano, está decorado con el tema del cine y ofrece todas las comodidades posibles. Visite el Institut Lumière y disfrute de un gimnasio a 500 metros."
    ],
    "nl": [
      "Dit 4-sterrenhotel ligt in een woonwijk aan de voet van metrostation Sans Souci (op 6 minuten van Place Bellecour of station Part-Dieu) en dompelt je onder in de wereld van de cinema. Profiteer van de privéparkeerplaats en het bistronomische restaurant."
    ]
  },
