  "rdfs:comment": {
    "de": [
      "Genießen Sie die Fahrt mit dem Hundeschlitten, auch wenn kein Schnee mehr liegt. Verbinden Sie sich mit einem Hund und begeben Sie sich auf eine originelle Fahrt durch die Landschaft des Vercors."
    ],
    "en": [
      "Enjoy dog sledding even when the snow is gone. Linked to a dog, set off on an original ride through the Vercors countryside."
    ],
    "it": [
      "Godetevi una slitta trainata da cani anche quando la neve non c'è più. Unitevi a un cane per un giro originale nella campagna del Vercors."
    ],
    "fr": [
      "Profitez des chiens de traîneau même lorsqu’il n’y a plus de neige. Relié à un chien, partez pour une balade originale à travers les paysages du Vercors."
    ],
    "nl": [
      "Geniet van hondensleeën, zelfs als er geen sneeuw meer ligt. Ga mee met een hond voor een originele tocht door het landschap van de Vercors."
    ],
    "es": [
      "Disfrute de un paseo en trineo tirado por perros incluso cuando ya no hay nieve. Únete a un perro para dar un original paseo por la campiña del Vercors."
    ]
  },
