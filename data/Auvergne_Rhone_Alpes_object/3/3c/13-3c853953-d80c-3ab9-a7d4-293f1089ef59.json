  "rdfs:comment": {
    "de": [
      "10 Minuten von Lyon entfernt empfängt Sie das RDV Resto des Vins an Wochentagen.  Der Chefkoch bietet Ihnen eine großzügige, traditionelle Küche. Im Sommer können Sie die Terrasse und den Bouleplatz für einen geselligen Moment nutzen. Animationen das ganze Jahr über"
    ],
    "en": [
      "Just 10 minutes from Lyon, RDV Resto des Vins welcomes you on weekdays.  The chef offers generous, traditional cuisine. In summer, take advantage of the terrace and petanque court for a moment of conviviality. Events all year round"
    ],
    "it": [
      "A 10 minuti da Lione, il Resto des Vins RDV vi accoglie durante la settimana.  Lo chef propone una cucina generosa e tradizionale. In estate, approfittate della terrazza e del campo da bocce per un momento di convivialità. Eventi durante tutto l'anno"
    ],
    "fr": [
      "A 10 mn de Lyon, le RDV Resto des Vins vous accueille en semaine.  Le chef vous propose une cuisine généreuse, traditionnelle. En été, profitez de la terrasse et de son terrain de pétanque pour un moment de convivialité. Animations tout au long de l'année"
    ],
    "nl": [
      "Op 10 minuten van Lyon heet het RDV Resto des Vins je doordeweeks welkom.  De chef biedt een royale, traditionele keuken. Profiteer in de zomer van het terras en de petanquebaan voor een gezellig moment. Evenementen het hele jaar door"
    ],
    "es": [
      "A 10 minutos de Lyon, el RDV Resto des Vins le da la bienvenida entre semana.  El chef le propone una cocina generosa y tradicional. En verano, aproveche la terraza y su pista de petanca para un momento de convivencia. Eventos durante todo el año"
    ]
  },
