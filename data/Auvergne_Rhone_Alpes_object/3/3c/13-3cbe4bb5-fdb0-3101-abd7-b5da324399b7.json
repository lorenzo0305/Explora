  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse der Landschaften, der Natur und vieles mehr im Herzen des Massif des Bauges mit Emmanuel Dutordoir, einem Bergführer. Auf dem Programm stehen Wanderungen und sportliche Aktivitäten, je nach Jahreszeit zu Fuß oder mit Schneeschuhen."
    ],
    "en": [
      "Discover the secrets of the landscape, nature and much more in the heart of the Bauges massif with mountain guide Emmanuel Dutordoir. Hiking and sporting activities are on the program, on foot or with snowshoes, depending on the season."
    ],
    "it": [
      "Scoprite i segreti della campagna, della natura e molto altro nel cuore del massiccio dei Bauges con la guida alpina Emmanuel Dutordoir. Sono in programma escursioni e attività sportive, a piedi o con le racchette da neve, a seconda della stagione."
    ],
    "fr": [
      "Découvrez les secrets des paysages, de la nature et bien plus au cœur du massif des Bauges avec Emmanuel Dutordoir, accompagnateur en montagne. Randonnées pédestres et activités sportives sont au programme, à pied ou en raquettes selon la saison."
    ],
    "nl": [
      "Ontdek de geheimen van het landschap, de natuur en nog veel meer in het hart van het Bauges-massief met berggids Emmanuel Dutordoir. Wandelen en sportieve activiteiten staan op het programma, te voet of met sneeuwschoenen, afhankelijk van het seizoen."
    ],
    "es": [
      "Descubra los secretos del campo, la naturaleza y mucho más en el corazón del macizo de Bauges con el guía de montaña Emmanuel Dutordoir. El programa incluye senderismo y actividades deportivas, a pie o con raquetas de nieve, según la temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
