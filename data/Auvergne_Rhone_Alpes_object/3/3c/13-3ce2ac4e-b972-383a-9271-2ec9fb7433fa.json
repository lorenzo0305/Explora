  "rdfs:comment": {
    "de": [
      "Das Hôtel Les Sittelles ist ein charmantes Familienhotel im Herzen von Plagne Montalbert. Es befindet sich direkt am Fuße der Pisten, gegenüber der Gondelbahn, so dass Sie Ihre Skier schon am Morgen anschnallen und direkt losfahren können."
    ],
    "en": [
      "Hôtel Les Sittelles is a charming family-run hotel in the heart of Plagne Montalbert. It's right at the foot of the slopes, opposite the gondola, so you can put on your skis in the morning and head straight out."
    ],
    "it": [
      "L'Hôtel Les Sittelles è un affascinante hotel a conduzione familiare nel cuore di Plagne Montalbert. Si trova proprio ai piedi delle piste, di fronte alla funivia, per cui potrete indossare gli sci al mattino e partire subito."
    ],
    "fr": [
      "L’Hôtel Les Sittelles est un charmant hôtel familial situé au cœur de Plagne Montalbert. Il se trouve juste au pied des pistes, en face du télécabine, ce qui vous permettra de chausser vos skis dès le matin et de partir directement."
    ],
    "nl": [
      "Hôtel Les Sittelles is een charmant familiehotel in het hart van Plagne Montalbert. Het ligt aan de voet van de pistes, tegenover de kabelbaan, zodat je 's ochtends je ski's kunt aantrekken en meteen op pad kunt."
    ],
    "es": [
      "El Hôtel Les Sittelles es un encantador hotel familiar situado en el corazón de Plagne Montalbert. A pie de pistas, frente al teleférico, para ponerse los esquís por la mañana y salir enseguida."
    ]
  },
