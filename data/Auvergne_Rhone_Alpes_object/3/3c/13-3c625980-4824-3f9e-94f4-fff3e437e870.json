  "rdfs:comment": {
    "de": [
      "Ein öko-verantwortliches Co-Working-Café im Stadtzentrum, das mittags auch kleine Gerichte anbietet.\r\nBrunch an Sonntagen.\r\nAlles ist hausgemacht mit lokalen & saisonalen Produkten."
    ],
    "en": [
      "An ecoresponsible coworking coffeeshop in the heart of Grenoble, which offers lunch and brunches every Sunday.\r\nEverything is home-made with fresh and seasonal products."
    ],
    "it": [
      "Un co-working café eco-responsabile nel centro della città che offre anche un piccolo catering a pranzo\r\nBrunch la domenica.\r\nTutto è fatto in casa con prodotti locali e stagionali"
    ],
    "fr": [
      "Un café co-working éco-responsable en plein centre ville qui propose aussi de la petite restauration le midi \r\nBrunch les dimanches.\r\nTout est fait maison avec des produits locaux & de saison"
    ],
    "es": [
      "Un café de trabajo eco-responsable en el centro de la ciudad, que también sirve comidas ligeras al mediodía.\r\nBrunch los domingos.\r\nTodo casero, con productos locales y de temporada."
    ],
    "nl": [
      "Een eco-verantwoordelijk samenwerkingscafé in het centrum van de stad dat ook 's middags een kleinschalige catering aanbiedt\r\nBrunch op zondag.\r\nAlles is huisgemaakt met lokale & seizoensgebonden producten"
    ]
  },
  "rdfs:label": {
