  "rdfs:comment": {
    "de": [
      "Drei Tage lang können Sie in einer festlichen Atmosphäre Gleitschirm-Marken testen und kennenlernen, während Sie über wunderschöne Landschaften fliegen."
    ],
    "en": [
      "For three days, test and meet paragliding brands in a festive atmosphere and while flying over beautiful landscapes."
    ],
    "it": [
      "Per tre giorni, provate e incontrate le marche di parapendio in un'atmosfera festosa, sorvolando paesaggi meravigliosi."
    ],
    "fr": [
      "Pendant trois jours, testez et rencontrez des marques de parapente dans une ambiance festive en survolant des paysages magnifiques."
    ],
    "nl": [
      "Test en ontmoet drie dagen lang paraglidingmerken in een feestelijke sfeer en terwijl u over prachtige landschappen vliegt."
    ],
    "es": [
      "Durante tres días, pruebe y conozca marcas de parapente en un ambiente festivo mientras sobrevuela bellos paisajes."
    ]
  },
