  "rdfs:comment": {
    "de": [
      "Dieses Restaurant vom Typ \"Brasserie\" empfängt Sie für ein Mittag- oder Abendessen in einer geselligen Atmosphäre. Entdecken Sie die Vorspeisen- und Dessertbuffets nach Belieben."
    ],
    "en": [
      "For a delicious lunch or dinner, this \"brasserie\" type restaurant looks forward to welcoming you into a warm and friendly atmosphere. Discover the all-you-can-eat buffets of hors d’œuvres and desserts."
    ],
    "it": [
      "Per un pranzo o una cena, questo ristorante di tipo brasserie ti accoglie in una cordiale atmosfera. Scopri i i buffet di antipasti e di dessert da assaporare a volontà."
    ],
    "fr": [
      "Pour un déjeuner ou un dîner, ce restaurant type brasserie vous accueille dans une atmosphère conviviale. Découvrez les buffets de hors-d’œuvre et de desserts à déguster à volonté."
    ],
    "es": [
      "Este restaurante de estilo \"brasserie\" ofrece una atmósfera distendida para comer o cenar, además de un bufé de entremeses y postres."
    ],
    "nl": [
      "Dit restaurant in brasseriestijl verwelkomt u voor lunch of diner in een vriendelijke sfeer. Ontdek het buffet met hapjes en desserts die u naar believen kunt nuttigen."
    ]
  },
