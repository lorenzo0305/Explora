  "rdfs:comment": {
    "de": [
      "Inmitten der typischen hügeligen Landschaft des Reyssouze-Tals gelegen, ein angenehmer und sehr erschwinglicher Cross-Country-Lauf, der von der Freizeitanlage Plaine Tonique aus gestartet wird."
    ],
    "en": [
      "Set in the heart of the rolling countryside typical of the Reyssouze valley, a pleasant and very affordable cross-country race starting from the Plaine Tonique leisure park."
    ],
    "it": [
      "Nel cuore della campagna ondulata tipica della valle di Reyssouze, questa corsa campestre divertente e molto economica parte dal centro ricreativo Plaine Tonique."
    ],
    "fr": [
      "Situé au cœur des paysages vallonnés, typiques de la vallée de la Reyssouze, un cross-country agréable et très abordable au départ de la base de loisirs de la Plaine Tonique."
    ],
    "es": [
      "Situada en el corazón del paisaje ondulado típico del valle de Reyssouze, esta carrera campo a través, agradable y muy asequible, parte del centro de ocio de Plaine Tonique."
    ],
    "nl": [
      "In het hart van het glooiende landschap van de Reyssouze-vallei start deze leuke en zeer betaalbare crosscountrywedstrijd vanaf het recreatiecentrum Plaine Tonique."
    ]
  },
