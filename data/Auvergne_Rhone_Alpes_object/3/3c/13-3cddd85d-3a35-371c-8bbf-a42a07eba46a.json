  "rdfs:comment": {
    "de": [
      "Das Restaurant des Cro-Bidou, offen für alle, einschließlich unserer externen Kunden, lädt Sie ein, die geheimen Rezepte unserer Großmutter Marie-Sylvie zu genießen, lecker und tröstend."
    ],
    "en": [
      "The restaurant of the Cro-Bidou, open to all, including our external clientele, invites you to savor the secret recipes of our grandmother Marie-Sylvie, greedy and comforting."
    ],
    "it": [
      "Il ristorante Cro-Bidou, aperto a tutti, anche ai clienti esterni, vi invita a gustare le ricette segrete di nostra nonna Marie-Sylvie, deliziose e confortanti."
    ],
    "fr": [
      "Le restaurant du Cro-Bidou, ouvert à tous, y compris à notre clientèle extérieure, vous invite à savourer les recettes secrètes de notre grand-mère Marie-Sylvie, gourmandes et réconfortantes."
    ],
    "nl": [
      "Traditionele en creatieve keuken en niet te vergeten een menu met Savoyaardse specialiteiten."
    ],
    "es": [
      "El restaurante Cro-Bidou, abierto a todos, incluidos nuestros clientes externos, le invita a saborear las recetas secretas de nuestra abuela Marie-Sylvie, deliciosas y reconfortantes."
    ]
  },
