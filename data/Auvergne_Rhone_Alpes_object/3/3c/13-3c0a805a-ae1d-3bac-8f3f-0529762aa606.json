  "rdfs:comment": {
    "de": [
      "Dieser Abschnitt des Jakobswegs führt von Genf nach Lyon (die Route geht dann weiter bis Le Puy-en-Velay)."
    ],
    "en": [
      "This section of the Chemin de Compostelle takes you from Geneva to Lyon (the route then continues to Le Puy-en-Velay)."
    ],
    "it": [
      "Questo tratto del Cammino di Santiago de Compostela vi porta da Ginevra a Lione (il percorso prosegue poi fino a Le Puy-en-Velay)."
    ],
    "fr": [
      "Ce tronçon du chemin de Compostelle permet de rallier Lyon depuis Genève (l'itinéraire se poursuit ensuite jusqu'au Puy-en-Velay)."
    ],
    "es": [
      "Este tramo del Camino de Santiago le llevará de Ginebra a Lyon (la ruta continúa hasta Le Puy-en-Velay)."
    ],
    "nl": [
      "Dit deel van de Camino de Santiago de Compostela brengt je van Genève naar Lyon (de route gaat dan verder naar Le Puy-en-Velay)."
    ]
  },
