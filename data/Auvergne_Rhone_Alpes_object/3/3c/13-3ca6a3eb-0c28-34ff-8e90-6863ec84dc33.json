  "rdfs:comment": {
    "de": [
      "Das in Plagne Centre gelegene L'Art des Choix Burger ist der ideale Ort, um sich nach dem Skifahren zu verwöhnen. Jeden Winterabend genießen Sie unsere frisch zubereiteten Burger vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "In Plagne Centre, L'Art des Choix Burger is the ideal place for a treat at the end of your ski day. Every evening in winter, enjoy a fresh burger to eat in or take away."
    ],
    "it": [
      "Situato a Plagne Centre, L'Art des Choix Burger è il luogo ideale per concedersi una pausa dopo lo sci. Ogni sera d'inverno potrete gustare i nostri hamburger freschi sul posto o da asporto."
    ],
    "fr": [
      "Situé à Plagne Centre, L'Art des Choix Burger est l'endroit idéal pour vous régaler après le ski. Chaque soir d'hiver, savourez nos burgers frais sur place ou à emporter."
    ],
    "es": [
      "Situado en Plagne Centre, L'Art des Choix Burger es el lugar ideal para darse un capricho después de esquiar. Todas las noches de invierno, disfrute de nuestras hamburguesas frescas en el local o para llevar."
    ],
    "nl": [
      "L'Art des Choix Burger ligt in Plagne Centre en is de ideale plek om jezelf te verwennen na het skiën. Geniet elke winteravond van onze verse hamburgers ter plaatse of om mee te nemen."
    ]
  },
