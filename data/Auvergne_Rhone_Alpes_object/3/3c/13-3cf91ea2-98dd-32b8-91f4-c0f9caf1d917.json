  "rdfs:comment": {
    "de": [
      "Das Hotel-Bar-Restaurant befindet sich in La Loge des Gardes zwischen Roanne und Vichy, auf 1000 m Höhe im Herzen der Montagne Bourbonnaise. Einfache und leckere Küche, Menüs von 18 bis 26 Euro und möglichst viele lokale Produkte."
    ],
    "en": [
      "The hotel-bar-restaurant is located at La Loge des Gardes between Roanne and Vichy, at an altitude of 1000 meters in the heart of the Montagne Bourbonnaise. Simple, gourmet cuisine, menus from 18? to 26? and a maximum of local produce."
    ],
    "it": [
      "L'hotel-bar-ristorante si trova a La Loge des Gardes, tra Roanne e Vichy, a 1000 metri di altitudine nel cuore della Montagne Bourbonnaise. Cucina semplice e gourmet, menù da 18 a 26 portate e prodotti il più possibile locali."
    ],
    "fr": [
      "L'hôtel-bar-restaurant est situé à la Loge des Gardes entre Roanne et Vichy, à 1000 mètres d'altitude en plein coeur de la Montagne Bourbonnaise. Cuisine simple et gourmande, menus de 18€ à 26€ et produits locaux au maximum."
    ],
    "nl": [
      "Het hotel-bar-restaurant ligt in La Loge des Gardes tussen Roanne en Vichy, op 1000 meter hoogte in het hart van de Montagne Bourbonnaise. Eenvoudige, gastronomische keuken, menu's van 18 tot 26 euro en zoveel mogelijk lokale producten."
    ],
    "es": [
      "El hotel-bar-restaurante está situado en La Loge des Gardes, entre Roanne y Vichy, a 1000 metros de altitud, en el corazón de la Montagne Bourbonnaise. Cocina sencilla y gastronómica, menús de 18? a 26? y el mayor número posible de productos locales."
    ]
  },
  "rdfs:label": {
