  "rdfs:comment": {
    "de": [
      "Bauernkäse, Picodon AOP, gepresste Tommes, Aschenkäse und Gewürzkäse. Verkauf ab Hof morgens und abends sowie auf dem Markt in Beaufort sur Gervanne am Mittwochmorgen. Besuch des Bauernhofs und Entdeckung des Melkens jeden Abend, vorzugsweise nach vorheriger Anmeldung."
    ],
    "en": [
      "Farm cheese, Picodon AOP: creamy hard cheese wtih spices. Sales at the farm in the morning and evening and on the Beaufort sur Gervanne market. Visit the farm and discover the milking every night by appointment."
    ],
    "it": [
      "Allevatore di capre da latte e produttore di formaggi di fattoria a latte crudo, tra cui il Picodon DOP. Vendita diretta e visite in azienda da marzo a novembre.\r\nPresente al mercato di Beaufort il mercoledì."
    ],
    "fr": [
      "Éleveuse de chèvres laitières et productrice de fromages fermiers au lait cru dont le Picodon en AOP. Vente directe et visite de la ferme de mars à novembre. \r\nPrésente sur le marché de Beaufort les mercredis."
    ],
    "es": [
      "Criador de cabras lecheras y productor de quesos de granja elaborados con leche cruda, entre ellos el Picodon DOP. Venta directa y visitas a la granja de marzo a noviembre.\r\nPresente en el mercado de Beaufort los miércoles."
    ],
    "nl": [
      "Boerenkaas AOC-picodon: tommekaas, geperst of met askleurig laagje, en kruidenkaas. Verkoop bij de boerderij, 's ochtends en 's avonds, en op de markt van Crest. Bezoek aan de boerderij is mogelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de Saint Pancrace - Juliette Chadwick"
    ]
  },
