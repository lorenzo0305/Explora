  "rdfs:comment": {
    "de": [
      "Nach 20 Jahren in Dijon lässt der burgundische Sternekoch Alexis Billoux seine Kochmütze und seine Messer auf der Lyoner Halbinsel im Herzen des ersten Arrondissements in einem Restaurant nahe der Oper und des Rathauses aufsetzen."
    ],
    "en": [
      "Following 20 years in Dijon, Burgundian Chef Alexis Billoux, past holder of a Michelin star, has brought his passion and expertise to the Presqu’île district of Lyon. His restaurant is located in the heart of the 1st district, near the Opera House and City Hall."
    ],
    "it": [
      "Dopo 20 anni a Digione, lo chef Alexis Billoux, ex stellato borgognone, posa il cappello e i coltelli sulla Presqu'île di Lione, nel cuore del 1° arrondissement, in un ristorante vicino all'Opera e all'Hôtel de Ville."
    ],
    "fr": [
      "Après 20 ans à Dijon, le Chef Alexis Billoux, bourguignon anciennement étoilé, pose sa toque et ses couteaux sur la Presqu’île lyonnaise au cœur du 1er arrondissement, dans un restaurant près de l’Opéra et de l’Hôtel de Ville."
    ],
    "nl": [
      "Na 20 jaar in Dijon legt chef Alexis Billoux, een voormalige Bourgondische ster, zijn hoed en messen neer op het Presqu?île van Lyon, in het hart van het 1e arrondissement, in een restaurant vlakbij de Opera en het Hôtel de Ville."
    ],
    "es": [
      "Después de 20 años en Dijon, el chef Alexis Billoux, antiguo estrella de Borgoña, deja el sombrero y los cuchillos en la Presqu'île de Lyon, en el corazón del distrito 1, en un restaurante cercano a la Ópera y al Hôtel de Ville."
    ]
  },
