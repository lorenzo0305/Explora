  "rdfs:comment": {
    "de": [
      "Christophe und Angélique bieten Zeichenkurse für alle Altersgruppen ab 7 Jahren an, in Einzelsitzungen oder mit Abonnement. Als professionelle Zeichner verkaufen sie in ihrem Geschäft auch ihre Bilder zu erschwinglichen Preisen."
    ],
    "en": [
      "Christophe and Angélique offer drawing lessons for people of all ages from 7 years old, as one-time lessons or with a membership. As professional illustrators, they sell their works in their shop at affordable prices."
    ],
    "it": [
      "Christophe e Angélique offrono lezioni di disegno per tutte le età a partire dai 7 anni, in un'unica sessione o con un abbonamento. Disegnatori professionisti, vendono anche i loro dipinti a prezzi accessibili nel loro negozio."
    ],
    "fr": [
      "Christophe et Angélique proposent des cours de dessin pour tous les âges à partir de 7 ans, en séance unique ou avec abonnement. Dessinateurs professionnels, ils vendent également leurs tableaux à des prix abordables dans leur boutique."
    ],
    "es": [
      "Christophe y Angélique ofrecen clases de dibujo para todas las edades a partir de los 7 años, en una sesión o con un abono. Dibujantes profesionales, también venden sus cuadros a precios asequibles en su tienda."
    ],
    "nl": [
      "Christophe en Angélique bieden tekenlessen aan voor alle leeftijden vanaf 7 jaar, in één sessie of met een abonnement. Professionele tekenaars, ze verkopen hun schilderijen ook tegen betaalbare prijzen in hun winkel."
    ]
  },
