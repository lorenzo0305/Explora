  "rdfs:comment": {
    "de": [
      "An die Federn, an die Stifte!\r\nBearbeiten Sie eines der gefürchteten Diktate, die von den Bibliothekaren vorbereitet wurden.\r\nDauer: 2 Stunden.\r\nAnmeldung in der Bibliothek."
    ],
    "en": [
      "Get your pens and pencils ready!\r\nCome and work on one of the dreaded dictations prepared by the librarians.\r\nDuration: 2 hours.\r\nLibrary registration."
    ],
    "it": [
      "Preparate penne e matite!\r\nVenite a lavorare su uno dei temuti dettati preparati dai bibliotecari.\r\nDurata 2 ore.\r\nIscrizione alla biblioteca."
    ],
    "fr": [
      "A vos plumes, à vos stylos !\r\nVenez plancher sur l'une des redoutables dictées préparée par les bibliothécaires. \r\nDurée 2h.\r\nInscription bibliothèque."
    ],
    "es": [
      "¡Prepara tus lápices y bolígrafos!\r\nVen a trabajar en uno de los temidos dictados preparados por los bibliotecarios.\r\nDuración 2 horas.\r\nInscripción en la biblioteca."
    ],
    "nl": [
      "Hou je pennen en potloden klaar!\r\nKom werken aan een van de gevreesde dictees die door de bibliothecarissen zijn voorbereid.\r\nDuur 2 uur.\r\nInschrijving voor de bibliotheek."
    ]
  },
