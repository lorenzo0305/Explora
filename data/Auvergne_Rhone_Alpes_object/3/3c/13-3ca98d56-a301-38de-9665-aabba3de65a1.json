  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine schmackhafte regionale Küche, die je nach Jahreszeit neu interpretiert wird. Genießen Sie sie in einem hellen Speisesaal mit schillernden Farben oder auf der schattigen Terrasse mit Blick auf einen Garten mit aromatischen Pflanzen."
    ],
    "en": [
      "Come and discover a tasty local cuisine revisited according to the seasons, which you can enjoy in a bright dining room with shimmering colours or on the shady terrace overlooking a garden of aromatic plants."
    ],
    "it": [
      "Venite a scoprire una gustosa cucina locale rivisitata secondo le stagioni, che potrete gustare in una luminosa sala da pranzo dai colori scintillanti o sulla terrazza ombreggiata che si affaccia su un giardino di piante aromatiche."
    ],
    "fr": [
      "Venez découvrir une savoureuse cuisine du terroir revisitée au fil des saisons, que vous pourrez apprécier dans une salle à manger lumineuse aux couleurs chatoyantes ou sur la terrasse ombragée dominant un jardin de plantes aromatiques."
    ],
    "es": [
      "Venga a descubrir una sabrosa cocina local revisada según las estaciones, que podrá degustar en un luminoso comedor de brillantes colores o en la sombreada terraza con vistas a un jardín de plantas aromáticas."
    ],
    "nl": [
      "Kom en ontdek een smakelijke lokale keuken die wordt herzien volgens de seizoenen, waarvan u kunt genieten in een lichte eetzaal met glinsterende kleuren of op het schaduwrijke terras met uitzicht op een tuin met aromatische planten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Tour"
    ]
  },
