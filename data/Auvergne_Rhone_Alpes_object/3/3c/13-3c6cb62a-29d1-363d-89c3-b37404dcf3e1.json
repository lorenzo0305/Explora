  "rdfs:comment": {
    "de": [
      "Nachdem die Beefbar die Genießer der schönsten Städte der Welt erobert hat, kommt sie nun mit ihrem von Riccardo Giraudi entworfenen Konzept nach Megève. Von Paris über New York und Hongkong bis hin zu Monaco - dieser Tempel für außergewöhnliches Fleisch kommt nun nach Megève."
    ],
    "en": [
      "After conquering epicureans in the world's most beautiful cities, Beefbar arrives in Megève with a concept designed by Riccardo Giraudi. From Paris to Monaco, by way of New York and Hong Kong, this temple to exceptional meats has set up shop in Megève."
    ],
    "it": [
      "Dopo aver conquistato gli epicurei nelle più belle città del mondo, Beefbar arriva a Megève con un concept ideato da Riccardo Giraudi. Da Parigi a Monaco, passando per New York e Hong Kong, questo tempio della carne eccezionale arriva a Megève."
    ],
    "fr": [
      "Après avoir conquis les épicuriens des plus belles villes du monde, Beefbar débarque à Megève avec son concept signé Riccardo Giraudi. De Paris à Monaco, en passant par New York et Hong Kong, ce temple de la viande d’exception s'installe à Megève."
    ],
    "es": [
      "Tras conquistar a los epicúreos de las ciudades más bellas del mundo, Beefbar llega a Megève con un concepto diseñado por Riccardo Giraudi. De París a Mónaco, pasando por Nueva York y Hong Kong, este templo de la carne excepcional llega a Megève."
    ],
    "nl": [
      "Na het overtuigen van fijnproevers in de mooiste steden ter wereld, komt Beefbar naar Megève met een concept ontworpen door Riccardo Giraudi. Van Parijs tot Monaco, via New York en Hongkong, komt deze tempel voor uitzonderlijk vlees naar Megève."
    ]
  },
