  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren geologischen Reichtum. Geschliffene Felsen, Mineralien und erklärende Schilder sind in den alten Gewölbekellern des Südflügels des Priorats ausgestellt."
    ],
    "en": [
      "Come and discover our geological treasures. Polished rocks, minerals and explanatory panels are on display in the former vaulted cellars of the Priory's south wing."
    ],
    "it": [
      "Venite a scoprire i nostri tesori geologici. Rocce levigate, minerali e pannelli esplicativi sono esposti nelle antiche cantine a volta dell'ala sud del Priorato."
    ],
    "fr": [
      "Venez découvrir nos richesses géologiques. Roches polies, minéraux et panneaux explicatifs sont exposés dans les  anciennes caves voutées de l'aile sud du Prieuré."
    ],
    "es": [
      "Venga a descubrir nuestros tesoros geológicos. Rocas pulidas, minerales y paneles explicativos se exponen en las antiguas bodegas abovedadas del ala sur del Priorato."
    ],
    "nl": [
      "Kom en ontdek onze geologische schatten. Geslepen stenen, mineralen en verklarende panelen worden tentoongesteld in de oude gewelfde kelders in de zuidvleugel van de Priorij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition \" Roches et minéraux du Val d'Allier \""
    ]
  },
