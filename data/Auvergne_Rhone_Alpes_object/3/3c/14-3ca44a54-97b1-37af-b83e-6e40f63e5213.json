      "dc:description": {
        "de": [
          "Ab 16 Uhr: Workshops, Spiele und Überraschungen\n18H : das große Barbeuc\n20H08 : Konzert Pat Caley Music\nDuo aus Sängern und Musikern mit einem Repertoire von den 60er Jahren bis heute"
        ],
        "en": [
          "From 4pm: workshops, games and surprises\n6pm: le grand barbeuc\n8:08pm: Pat Caley Music concert\nSinger-musician duo with repertoire from the 60s to the present day"
        ],
        "it": [
          "Dalle 16.00: laboratori, giochi e sorprese\nore 18.00: grande grigliata\nore 20.08: concerto di Pat Caley Music\nUn duo di cantanti-musicisti con un repertorio che spazia dagli anni '60 ai giorni nostri"
        ],
        "fr": [
          "Dès 16H des ateliers, des jeux et des surprises \n18H : le grand barbeuc \n20H08 : concert Pat Caley Music\nDuo d'artistes chanteurs musiciens, au répertoire depuis les années 60et jusqu'à aujourd'hui"
        ],
        "nl": [
          "Vanaf 16.00 uur: workshops, spelletjes en verrassingen\n18.00 uur: de grote barbecue\n20.08 uur: concert van Pat Caley Music\nEen duo zangeressen-muzikanten met een repertoire van de jaren 60 tot nu"
        ],
        "es": [
          "A partir de las 16:00: talleres, juegos y sorpresas\n18.00 h: la gran barbacoa\n20.08 h: concierto de Pat Caley Music\nUn dúo de cantantes-músicos con un repertorio que abarca desde los años 60 hasta nuestros días"
        ]
      },
