  "rdfs:comment": {
    "de": [
      "Als Klettergebiet von sehr hohem Niveau zieht er zu jeder Jahreszeit sowohl die größten Kletterer als auch begeisterte Kletterer an. Auch für Besucher, die in der Nähe sind, ist es oft ein schönes Schauspiel."
    ],
    "en": [
      "A top-level climbing site, it attracts the greatest climbers and enthusiasts alike, whatever the season. It's often a sight to behold for visitors passing through the area."
    ],
    "it": [
      "Sito di arrampicata di altissimo livello, attira i più grandi scalatori e gli appassionati in tutte le stagioni. È spesso uno spettacolo per i visitatori che passano da queste parti."
    ],
    "fr": [
      "Site d'escalade de très haut niveau, il attire les plus grands grimpeurs comme les pratiquants passionnés en toute saison. Souvent un beau spectacle pour les visiteurs de passage à proximité."
    ],
    "es": [
      "Sitio de escalada de muy alto nivel, atrae a los más grandes escaladores, así como a aficionados en todas las estaciones. Suele ser un espectáculo para los visitantes que pasan por la zona."
    ],
    "nl": [
      "Het is een klimlocatie op zeer hoog niveau en trekt de grootste klimmers en liefhebbers in alle seizoenen. Het is vaak een bezienswaardigheid voor bezoekers die door het gebied trekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing site of La Balme-Pierre Châtel"
    ],
    "fr": [
      "Site d'escalade de la Balme-Pierre Châtel"
    ],
    "nl": [
      "Bergbeklimming La Balme-Pierre Châtel"
    ]
  },
