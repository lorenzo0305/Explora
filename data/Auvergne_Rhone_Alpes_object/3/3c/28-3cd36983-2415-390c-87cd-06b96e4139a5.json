  "rdfs:comment": {
    "de": [
      "Haben Sie schon Gemeinsame Vereinbarung gesagt? Das ist richtig! Commun Accord ist eine Band aus der Normandie mit Pop- und Rockeinflüssen, die ihr Publikum einen Abend lang auf eine mitreißende musikalische Reise mitnimmt, indem sie französische Chansons und internationale Hits covert! Gehen Sie sofort an Bord!"
    ],
    "en": [
      "Did you say Commun Accord? You bet! A band from Normandy with Pop / Rock influences, Commun accord is a group that, from covers of French songs to covers of international hits, takes its audience on a rousing musical journey for one evening! All aboard, by mutual agreement!"
    ],
    "it": [
      "Avete detto Commun Accord? Ci potete scommettere! Gruppo della Normandia con influenze Pop/Rock, i Commun accord sono un gruppo che, dalle cover di canzoni francesi a quelle di successi internazionali, accompagna il pubblico in un entusiasmante viaggio musicale per una sera! Tutti a bordo, di comune accordo!"
    ],
    "fr": [
      "Vous avez dit Commun Accord ? Affirmatif ! Formation normande aux influences Pop / Rock, Commun accord est un groupe qui, de reprises de chansons françaises en reprises de hits internationaux, emmène son public faire un voyage musical entrainant, le temps d’une soirée ! Embarquement immédiat et d’un commun accord !"
    ],
    "es": [
      "¿Has dicho Commun Accord? ¡Pues claro! Grupo de Normandía con influencias Pop/Rock, Commun accord es un grupo que, desde versiones de canciones francesas hasta versiones de éxitos internacionales, ¡lleva a su público a un emocionante viaje musical durante una velada! Todos a bordo, ¡de mutuo acuerdo!"
    ],
    "nl": [
      "Zei je Commun Accord? Reken maar! Commun accord, een groep uit Normandië met Pop/Rock invloeden, is een groep die, van covers van Franse liedjes tot covers van internationale hits, hun publiek een avond lang meeneemt op een opzwepende muzikale reis! Allemaal aan boord, in overleg!"
    ]
  },
  "rdfs:label": {
    "fr": [
