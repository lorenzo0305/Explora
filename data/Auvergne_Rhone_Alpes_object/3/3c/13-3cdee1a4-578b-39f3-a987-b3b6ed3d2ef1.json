  "rdfs:comment": {
    "de": [
      "Die Mediathek in Lurcy-Lévis (Moulins Communauté) ist 16 Stunden pro Woche geöffnet und bietet Ihnen eine große Auswahl an Büchern, Zeitschriften, Audio-CDs, CDRoms und DVDs."
    ],
    "en": [
      "The Lurcy-Lévis Community Mediatheque (Moulins Communauté) is open to the public 16 hours a week, and offers you to discover many documents: books, magazines, audio CD, CDRom and DVD."
    ],
    "it": [
      "La biblioteca multimediale della comunità di Lurcy-Lévis (Moulins Communauté) è aperta al pubblico 16 ore alla settimana e offre un'ampia gamma di documenti: libri, riviste, CD audio, CDRom e DVD."
    ],
    "fr": [
      "La Médiathèque communautaire de Lurcy-Lévis (Moulins Communauté) est ouverte au public 16 heures par semaine, et vous propose de découvrir de multiples documents: livres, revues, CD audio, CDRom et DVD."
    ],
    "es": [
      "La biblioteca multimedia comunitaria de Lurcy-Lévis (Moulins Communauté) está abierta al público 16 horas a la semana y le ofrece una amplia gama de documentos: libros, revistas, CD de audio, CDRoms y DVD."
    ],
    "nl": [
      "De mediatheek van de gemeenschap Lurcy-Lévis (Moulins Communauté) is 16 uur per week geopend voor het publiek en biedt u een breed scala aan documenten: boeken, tijdschriften, audio-cd's, cd-roms en dvd's."
    ]
  },
