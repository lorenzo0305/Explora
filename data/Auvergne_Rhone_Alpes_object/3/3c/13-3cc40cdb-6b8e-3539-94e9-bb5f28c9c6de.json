  "rdfs:comment": {
    "de": [
      "Traditionelle Brotsorten, Spezialbrote, Viennoiserie, Patisserie, Snacks.\r\nFür Ihre Veranstaltungen: Torten, Quiches, Pizzas, Blätterteiggebäck ...\r\n100% hausgemacht, Produkte, die je nach Jahreszeit variieren und aus regionalem Weizen hergestellt werden."
    ],
    "en": [
      "Bakery-Cake shop."
    ],
    "it": [
      "Pani tradizionali, pani speciali, dolci, snack\r\nPer i vostri eventi: pasticcini, quiche, pizze, sfogliatine...\r\n100% fatti in casa, prodotti che variano a seconda della stagione e realizzati con grano regionale."
    ],
    "fr": [
      "Pains traditionnels, pains spéciaux, viennoiseries, pâtisseries, snacking. \r\nPour vos événements : pièces montées, quiches, pizzas, feuilletés ...\r\n100% fait maison, des produits qui varient en fonction des saisons et fabriqués à partir de blés régionaux."
    ],
    "es": [
      "Panes tradicionales, panes especiales, bollería, bocadillos\r\nPara sus eventos: pasteles, quiches, pizzas, hojaldres...\r\n100% caseros, productos que varían según la temporada y elaborados con trigo de la región."
    ],
    "nl": [
      "Bakkerij-banketbakkerswinkel."
    ]
  },
