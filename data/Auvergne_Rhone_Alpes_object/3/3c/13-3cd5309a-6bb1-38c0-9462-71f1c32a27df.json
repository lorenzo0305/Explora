  "rdfs:comment": {
    "de": [
      "Am Stadtrand von Montbrison gelegen, bietet das Reitzentrum verschiedenste reiterische Aktivitäten. Die Reitlehrer sind da, um das Reitvergnügen mit Ihnen zu teilen. Der Klub arbeitet mit einem grossen Zusammengehörigkeitsgefühl."
    ],
    "en": [
      "Situated in the outskirts of Montbrison, the centre offers you a wide range of horse-riding activities. The teachers are there to share with you the pleasure of horse-riding."
    ],
    "it": [
      "Situato alla periferia di Montbrison, il centro offre una vasta gamma di attività equestri aperte a tutti i livelli e a tutte le età!"
    ],
    "fr": [
      "Installé dans la périphérie de Montbrison, le centre vous propose un grand nombre d'activités équestres ouvert tous niveaux et tous âges !"
    ],
    "es": [
      "Ubicado en la periferia de Montbrison, el centro ofrece un gran número de actividades ecuestres. Los profesores compartirán con usted el placer de la práctica de la equitación. El club trabaja con un espíritu de muy buena convivencia."
    ],
    "nl": [
      "Het Ruiters centrum is in de omgeving van Montbrison er worden hier verschillende paardrij activiteiten georganiseerd . De instructeurs zorgen er voor dat u bij het paardrijden veel plezier zult hebben. De clubdirektie vindt het belangrijk dat er een goede sfeer in hun club is."
    ]
  },
