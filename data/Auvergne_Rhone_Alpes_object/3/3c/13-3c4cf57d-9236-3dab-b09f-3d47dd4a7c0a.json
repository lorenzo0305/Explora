  "rdfs:comment": {
    "de": [
      "Das Hotel Saint-André befindet sich 30 m vom SNCF-Bahnhof entfernt und in der Nähe des Stadtzentrums. Es bietet Ihnen einen guten Komfort und einen freundlichen Empfang, eine Gastronomie für Familien oder Gruppen mit traditioneller und regionaler Küche."
    ],
    "en": [
      "The Hotel Saint-André is located 30m from the train station and close to the city centre. It offers you good comfort and a friendly welcome, a restaurant for families or groups based on traditional and regional cuisine."
    ],
    "it": [
      "L'Hotel Saint-André si trova a 30 metri dalla stazione ferroviaria e vicino al centro città. L'hotel offre un buon comfort e un'accoglienza cordiale, si rivolge a famiglie e gruppi con una cucina tradizionale e regionale."
    ],
    "fr": [
      "L'Hôtel Saint-André est situé à 30m de la gare SNCF et à proximité du centre- ville. Il vous réserve des prestations de bon confort et un accueil convivial, une restauration pour famille ou pour groupe autour d'une cuisine traditionnelle et régionale."
    ],
    "nl": [
      "Hotel Saint-André ligt op 30 meter van het station en vlakbij het stadscentrum. Het hotel biedt goed comfort en een vriendelijk onthaal, en richt zich op gezinnen en groepen met een traditionele en regionale keuken."
    ],
    "es": [
      "El Hotel Saint-André está situado a 30 metros de la estación de tren y cerca del centro de la ciudad. El hotel ofrece un buen confort y una agradable acogida, atendiendo a familias y grupos con cocina tradicional y regional."
    ]
  },
