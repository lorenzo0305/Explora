  "rdfs:comment": {
    "de": [
      "Pflanzenproduzent, Verkauf von Olivenbäumen, Zypressen, Lavendel, mehrjährigen Blütensträuchern. Landschaftsgärtner.\r\nZwei Adressen: 50, Bd Aristide Briand in Buis-les-Baronnies und der Chemin de Pommerol gegenüber von La Roche-sur-le-Buis."
    ],
    "en": [
      "Plant producer, sale of olive trees, cypresses, lavenders, perennial flowering shrubs. Landscaper.\r\nTwo addresses: 50, Bd Aristide Briand in Buis-les-Baronnies and chemin de Pommerol opposite La Roche-sur-le-Buis."
    ],
    "it": [
      "Produttore di piante, vendita di ulivi, cipressi, lavanda, arbusti da fiore perenni. Paesaggista\r\nDue indirizzi: 50, Bd Aristide Briand a Buis-les-Baronnies e chemin de Pommerol di fronte a La Roche-sur-le-Buis."
    ],
    "fr": [
      "Producteur de plantes, vente d'oliviers, cyprès, lavandes, arbustes à fleurs vivaces. Paysagiste. \r\nDeux adresses : 50, Bd Aristide Briand à Buis-les-Baronnies et le chemin de Pommerol en face de La Roche-sur-le-Buis."
    ],
    "es": [
      "Productor de plantas, venta de olivos, cipreses, lavanda, arbustos de flor perenne. Paisajista\r\nDos direcciones: 50, Bd Aristide Briand en Buis-les-Baronnies y chemin de Pommerol frente a La Roche-sur-le-Buis."
    ],
    "nl": [
      "Plantenproducent, verkoop van olijfbomen, cipressen, lavendel, vaste bloeiende heesters. Tuinarchitect.\r\nTwee adressen: 50, Bd Aristide Briand in Buis-les-Baronnies en chemin de Pommerol tegenover La Roche-sur-le-Buis."
    ]
  },
