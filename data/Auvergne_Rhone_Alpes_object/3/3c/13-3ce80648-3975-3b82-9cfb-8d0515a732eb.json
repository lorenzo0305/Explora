  "rdfs:comment": {
    "de": [
      "Das Freizeitgebiet Pointe de Nyon ist ein Sektor, der dem Skifahren, der Kontemplation und der Entdeckung der Berge, ihrer Bewohner und ihrer Aktivitäten gewidmet ist."
    ],
    "en": [
      "The Pointe de Nyon leisure area is dedicated to skiing, contemplation and discovery of the mountain, its inhabitants and their activities."
    ],
    "it": [
      "L'area ricreativa della Pointe de Nyon è dedicata allo sci, alla contemplazione e alla scoperta della montagna, dei suoi abitanti e delle loro attività."
    ],
    "fr": [
      "Le domaine de loisirs de la Pointe de Nyon est un secteur dédié à la pratique du ski, à la contemplation et la découverte de la montagne, de ses habitants et de leurs activités."
    ],
    "nl": [
      "Het recreatiegebied Pointe de Nyon is gewijd aan skiën, contemplatie en het ontdekken van de berg, de bewoners en hun activiteiten."
    ],
    "es": [
      "El espacio de ocio Pointe de Nyon está dedicado al esquí, la contemplación y el descubrimiento de la montaña, sus habitantes y sus actividades."
    ]
  },
