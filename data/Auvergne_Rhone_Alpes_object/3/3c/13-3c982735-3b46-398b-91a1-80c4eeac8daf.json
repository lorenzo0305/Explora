  "rdfs:comment": {
    "de": [
      "Vom 1. Mai bis zum 20. September 2026 findet in Zusammenarbeit mit der Agentur Magnum Photos in der Abtei von La Chaise-Dieu Folgendes statt: \"Wo alles beginnt\", eine neue große Fotoausstellung."
    ],
    "en": [
      "From May 1 to September 20, 2026, in collaboration with the Magnum Photos Agency, the Abbey of La Chaise-Dieu hosts \"Where it all begins\", a major new photo exhibition."
    ],
    "it": [
      "Dal 1° maggio al 20 settembre 2026, in collaborazione con l'Agenzia Magnum Photos, l'Abbazia di La Chaise-Dieu ospiterà \"Where it all begins\", una nuova grande mostra fotografica."
    ],
    "fr": [
      "Du 1er mai au 20 septembre 2026, en collaboration avec l’Agence Magnum Photos, l’abbaye de La Chaise-Dieu accueille : \"Là où tout commence\", une nouvelle grande exposition  de photos."
    ],
    "nl": [
      "Van 1 mei tot 20 september 2026 organiseert de abdij van La Chaise-Dieu in samenwerking met het fotoagentschap Magnum \"Where it all begins\", een grote nieuwe fototentoonstelling."
    ],
    "es": [
      "Del 1 de mayo al 20 de septiembre de 2026, en colaboración con la agencia Magnum Photos, la abadía de La Chaise-Dieu acoge \"Donde todo comienza\", una nueva gran exposición fotográfica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition temporaire : \"là où tout commence\""
    ]
  },
