  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais durch ein spielerisches Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nIn Mont Saint-Rigaud tauchen Sie in den Tannenwald ein, um den verirrten Gnolu Yookâ zu suchen!"
    ],
    "en": [
      "Discover the Beaujolais region through a fun geocaching experience: a treasure hunt to be enjoyed by the whole family!\r\nAt Mont Saint-Rigaud, dive into the forest of fir trees in search of the lost Gnolu Yookâ!"
    ],
    "it": [
      "Scoprite la regione del Beaujolais attraverso una divertente esperienza di geocaching: una caccia al tesoro per tutta la famiglia!\r\nA Mont Saint-Rigaud, immergetevi nella pineta alla ricerca dello Gnolu Yookâ perduto!"
    ],
    "fr": [
      "Découvrez le Beaujolais à travers une expérience ludique de géocaching : une chasse aux trésors à vivre en famille ! \r\nAu Mont Saint-Rigaud plongez dans la forêt de sapins à la recherche du Gnolu égaré Yookâ !"
    ],
    "nl": [
      "Ontdek de Beaujolais via een leuke geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nDuik op de Mont Saint-Rigaud het dennenbos in op zoek naar de verloren Gnolu Yookâ!"
    ],
    "es": [
      "Descubra la región del Beaujolais a través de una divertida experiencia de geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn el Monte Saint-Rigaud, sumérjase en el bosque de pinos en busca del Gnolu Yookâ perdido"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - ça sent le sapin..."
    ]
  },
