  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Salers empfängt Sie die Poterne, um dem Alltag ein wenig zu entfliehen Eine traditionelle Küche, in der alles aus lokalen Produkten zubereitet wird"
    ],
    "en": [
      "In the heart of Salers. A regional cooking with local products."
    ],
    "it": [
      "Nel cuore del villaggio di Salers, La Poterne vi accoglie per una piccola \"fuga\"? Una cucina tradizionale dove tutto è fatto in casa con prodotti locali?"
    ],
    "fr": [
      "Au cœur du village de Salers la poterne vous accueille pour « s’Evader » un peu… Une cuisine traditionnelle où tout est fait maison à partir de produits  locaux…"
    ],
    "nl": [
      "In het hart van het dorp Salers heet La Poterne u welkom voor een kleine \"ontsnapping\"? Traditionele keuken waar alles huisgemaakt is met lokale producten?"
    ],
    "es": [
      "En el corazón del pueblo de Salers, La Poterne le da la bienvenida para una pequeña \"escapada\"? Cocina tradicional en la que todo se elabora en casa con productos locales?"
    ]
  },
