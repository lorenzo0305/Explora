  "rdfs:comment": {
    "de": [
      "Jane empfängt jeden Mittwoch im Jahr angehende Künstler, die an verschiedenen kreativen Workshops teilnehmen: Zeichnen, Malen, Siebdruck, Modellieren, Mosaik, Glasarbeiten ... Es ist sehr abwechslungsreich und sehr herzlich."
    ],
    "en": [
      "Jane welcomes budding artists every Wednesday of the year for a wide variety of creative workshops: drawing, painting, silkscreening, modeling, mosaics, glasswork... It's all very varied and welcoming."
    ],
    "it": [
      "Jane accoglie ogni mercoledì dell'anno artisti in erba per una serie di laboratori creativi: disegno, pittura, serigrafia, modellazione, mosaico, lavorazione del vetro... È molto vario e molto amichevole."
    ],
    "fr": [
      "Jane accueille les artistes en herbe, tous les mercredis de l'année, pour faire des ateliers créatifs très variés : dessin, peinture, sérigraphie, modelage, mosaïque, travail du verre ... C'est très varié et très chaleureux."
    ],
    "nl": [
      "Jane verwelkomt elke woensdag van het jaar beginnende kunstenaars voor een breed scala aan creatieve workshops, waaronder tekenen, schilderen, zeefdrukken, boetseren, mozaïeken en glaswerk. Het is allemaal heel gevarieerd en erg gezellig."
    ],
    "es": [
      "Jane recibe a los artistas en ciernes todos los miércoles del año para realizar diversos talleres creativos: dibujo, pintura, serigrafía, modelado, mosaicos, trabajos en vidrio... Es muy variado y muy amigable."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Amies de la Poule Bottée"
    ]
  },
