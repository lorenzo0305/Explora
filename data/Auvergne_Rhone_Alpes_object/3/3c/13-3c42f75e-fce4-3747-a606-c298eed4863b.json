  "rdfs:comment": {
    "de": [
      "Willkommen im Le Victor Hugo. Fleur begrüßt Sie in einer freundlichen und dynamischen Atmosphäre. Unsere Gerichte können auch mitgenommen und zu Hause oder im Büro verzehrt werden: vor 12:00 Uhr reservieren."
    ],
    "en": [
      "Welcome to the Victor Hugo. Fleur welcomes visitors in a warm and dynamic setting. You can come and pick up our dishes to enjoy them at home or at work: reservations before 12 noon."
    ],
    "it": [
      "Benvenuti al Comptoir de Fredo\r\nAmpia scelta di piatti pronti da asporto o da consumare in casa.\r\nAperto durante il giorno e, eccezionalmente, nelle serate di festa del teatro antico."
    ],
    "fr": [
      "Bienvenue au Comptoir de Fredo \r\nLarge choix de plats cuisinés à emporter ou à consommer sur place.\r\nOuvert en journée et exceptionnellement les soirées de festivités au théâtre antique."
    ],
    "nl": [
      "Welkom bij Comptoir de Fredo\r\nRuime keuze aan kant-en-klare maaltijden om mee te nemen of om op te eten.\r\nOverdag geopend en, bij uitzondering, op feestelijke avonden in het antieke theater."
    ],
    "es": [
      "Bienvenido a Comptoir de Fredo\r\nAmplia selección de platos preparados para llevar o comer en casa.\r\nAbierto durante el día y, excepcionalmente, las noches de fiesta en el antiguo teatro."
    ]
  },
