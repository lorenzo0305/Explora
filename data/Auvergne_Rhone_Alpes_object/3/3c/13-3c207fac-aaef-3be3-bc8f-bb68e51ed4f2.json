  "rdfs:comment": {
    "de": [
      "Das Hotel des Barmes de l'Ours, Relais & Châteaux, wird Sie mit seiner privilegierten Lage am Fuße der mythischen Face de Bellevarde, seiner herzlichen Atmosphäre und seinem außergewöhnlichen Service begeistern."
    ],
    "en": [
      "The Relais & Châteaux Hôtel les Barmes de l'Ours will charm you with its prime location at the foot of the legendary Face de Bellevarde ski slope, its warm atmosphere and its exceptional service."
    ],
    "it": [
      "L'hotel des Barmes de l'Ours Relais & Châteaux vi conquisterà con la sua posizione privilegiata ai piedi della Face de Bellevarde, la sua calda atmosfera e il suo servizio eccezionale."
    ],
    "fr": [
      "L'hôtel des Barmes de l'Ours, Relais & Châteaux, vous séduira par son emplacement privilégié au pied de la mythique Face de Bellevarde, son atmosphère chaleureuse et son service d'exception."
    ],
    "nl": [
      "Hotel des Barmes de l'Ours, een Relais & Châteaux, zal je veroveren met zijn bevoorrechte locatie aan de voet van de legendarische Face de Bellevarde, zijn warme sfeer en zijn uitzonderlijke service."
    ],
    "es": [
      "El Hotel des Barmes de l'Ours, un Relais & Châteaux, le conquistará por su situación privilegiada a los pies de la legendaria Face de Bellevarde, su ambiente cálido y su servicio excepcional."
    ]
  },
