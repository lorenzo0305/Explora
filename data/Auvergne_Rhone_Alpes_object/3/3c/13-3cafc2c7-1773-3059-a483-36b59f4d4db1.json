  "rdfs:comment": {
    "de": [
      "Im Herzen der Almen von Sommand,auf 1500 m Höhe, werden Sie diesen Ort wegen seiner Ruhe und Frische schätzen. Der See wird jedes Frühjahr mit Forellen aufgefüllt. Regelung der ersten Kategorie. Genehmigung erforderlich."
    ],
    "en": [
      "At the heart of the Sommand pastures, at an altitude of 1,500 m, you’ll appreciate this quiet and refreshing place. The lake is re-filled with trout every year in Spring. 1st category regulations. Permit compulsory."
    ],
    "it": [
      "Nel cuore degli alpeggi di Sommand, a 1500 m di altitudine, apprezzerete questo sito per la sua calma e freschezza. Il lago si riempie di trote ogni primavera. Regolamenti di 1a categoria. È necessaria un'autorizzazione."
    ],
    "fr": [
      "Au coeur des alpages de Sommand,à 1500 m d'altitude, vous apprécierez ce site pour son calme, sa fraicheur. Le lac est réapprovisionné en truites chaque printemps. Règlement 1ère catégorie. Permis obligatoire."
    ],
    "nl": [
      "Midden in de alpenweiden van Sommand, op 1500 m hoogte, is dit een rustig en koel plekje om te vissen. Elk voorjaar wordt hier opnieuw forel uitgezet. Regelgeving: 1e categorie. Visvergunning verplicht."
    ],
    "es": [
      "En el corazón de los pastos de montaña de Sommand, a 1500 m de altitud, apreciará este lugar por su calma y su frescor. El lago se reabastece de truchas cada primavera. Reglamento de 1ª categoría. Permiso necesario."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing on the Lac de Sommand"
    ],
    "fr": [
      "Pêche au Lac de Sommand"
    ],
    "nl": [
      "Vissen bij het Lac de Sommand"
    ]
  },
