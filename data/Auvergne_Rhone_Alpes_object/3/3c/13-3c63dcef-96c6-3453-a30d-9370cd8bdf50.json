  "rdfs:comment": {
    "de": [
      "Le Comptoir ist wie ein Chalet - nur auf der Terrasse!\r\nSchmelzender Käse, klirrende Gläser und eine festliche Atmosphäre unter dem Sternenhimmel!"
    ],
    "en": [
      "Le Comptoir takes on a chalet air? but on the terrace!\r\nMelting cheese, clinking glasses and a festive atmosphere under the stars!"
    ],
    "it": [
      "Le Comptoir sembra uno chalet, ma in terrazza!\r\nFormaggio fuso, bicchieri che tintinnano e un'atmosfera festosa sotto le stelle!"
    ],
    "fr": [
      "Le Comptoir prend des airs de chalet… mais en terrasse ! \r\nFromage qui fond, verres qui s’entrechoquent et ambiance festive sous les étoiles!"
    ],
    "es": [
      "Le Comptoir parece un chalet... ¡pero en la terraza!\r\nQueso fundido, copas que tintinean y un ambiente festivo bajo las estrellas"
    ],
    "nl": [
      "Le Comptoir lijkt op een chalet, maar dan op het terras!\r\nSmeltende kaas, rinkelende glazen en een feestelijke sfeer onder de sterren!"
    ]
  },
