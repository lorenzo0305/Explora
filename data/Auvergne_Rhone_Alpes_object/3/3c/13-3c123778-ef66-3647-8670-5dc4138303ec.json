  "rdfs:comment": {
    "de": [
      "Das Restaurant Le France relais vélo-moto empfängt Sie an sieben Tagen in der Woche in einem besonderen Dekor.\r\nTartiflette mit 4 Käsesorten, Salate, Wurstteller, Spareribs, Suppe mit Thai-Reispaste werden Sie für ein Budget zwischen 10 und 20 € pro Person verwöhnen."
    ],
    "en": [
      "The Le France restaurant welcomes motorcyclists to Oisans - the gateway to the Southern Alps.\r\nTartiflette, salads, charcuterie plates and some meat dishes will delight you for a budget between 10 and 20 € per person."
    ],
    "it": [
      "Il ristorante Le France relais vélo-moto vi accoglie 7 giorni su 7 in un ambiente speciale.\r\nTartiflette con 4 formaggi, insalate, salumi, costine di maiale, zuppa di pasta di riso tailandese vi delizieranno per un budget tra i 10 e i 20 euro a persona."
    ],
    "fr": [
      "Le restaurant Le France relais vélo-moto vous accueille 7j/7 dans un décor particulier.\r\nTartiflette 4 fromages, salades, assiette de charcuterie, travers de porc, soupe pâte de riz thai vous régaleront pour un budget compris entre 10 et 20 € par personne."
    ],
    "nl": [
      "Het restaurant \"Le France\" - gekend door de bikers - verwelkomt u in Oisans, deur op Zuidelijke Alpen.\r\nTartiflette, salades, charcuterieborden en sommige vleesgerechten binnen een budget tussen de 10 en 20 € per persoon."
    ],
    "es": [
      "El restaurante Le France relais vélo-moto le da la bienvenida los 7 días de la semana en un entorno especial.\r\nTartiflette con 4 quesos, ensaladas, embutidos, costillas de cerdo, sopa de pasta de arroz tailandesa le deleitarán por un presupuesto entre 10 y 20€ por persona."
    ]
  },
  "rdfs:label": {
    "en": [
