  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Die Kirche Saint-Pierre, ein Juwel aus der romanischen Epoche, ist bemerkenswert wegen der Verzierung ihrer Fassade aus dem 12. Jahrhundert und ihrer Krypta aus dem 9. oder 10."
    ],
    "en": [
      "Free visit with document. The Saint-Pierre church, a jewel of the Romanesque period, is remarkable for the ornamentation of its 12th century façade and its 9th or 10th century crypt."
    ],
    "it": [
      "Visita autoguidata con documentazione. La chiesa di Saint-Pierre, gioiello del periodo romanico, si distingue per l'ornamentazione della facciata del XII secolo e per la cripta del IX o X secolo."
    ],
    "fr": [
      "Visite libre avec document. L'église Saint-Pierre, joyau de l'époque romane, est remarquable par l'ornementation de sa façade du XIIe siècle et par sa crypte du IXe ou Xe siècle."
    ],
    "nl": [
      "Zelf rondleiding met documentatie. De kerk Saint-Pierre, een juweel uit de Romaanse periode, is opmerkelijk vanwege de versiering van de 12e-eeuwse gevel en de 9e- of 10e-eeuwse crypte."
    ],
    "es": [
      "Visita autoguiada con documentación. La iglesia Saint-Pierre, joya del románico, destaca por la ornamentación de su fachada del siglo XII y su cripta de los siglos IX o X."
    ]
  },
  "rdfs:label": {
