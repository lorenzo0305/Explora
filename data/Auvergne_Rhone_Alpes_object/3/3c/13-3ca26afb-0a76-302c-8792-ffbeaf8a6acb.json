  "rdfs:comment": {
    "de": [
      "Am Fuße des Ostbalkons des Vercors entdecken Sie im Rahmen einer pädagogischen Animation den Tierbestand von Anne-Laure und Gilles (Ziegen, Ziegenböcke, Schafe, Widder, Eselinnen, Hühner und Hähne, Schutz- und Herdenhunde) und nehmen am Melken der Ziegen teil!"
    ],
    "en": [
      "At the foot of the Balcon Est du Vercors, discover Anne-Laure and Gilles' livestock (goats, billy goats, ewes, rams, donkeys, hens and roosters, guard dogs and herding dogs) and take part in milking the goats!"
    ],
    "it": [
      "Ai piedi del Balcon Est du Vercors, durante un'animazione didattica, scoprite il bestiame di Anne-Laure e Gilles (capre, caproni, pecore, arieti, asini, galline e galli, cani da guardia e da gregge) e partecipate alla mungitura delle capre!"
    ],
    "fr": [
      "Au pied du Balcon Est du Vercors, au cours d’une animation pédagogique, découvrez le cheptel d'Anne-Laure et Gilles (chèvres, boucs, brebis, bélier, ânesses, poules et coq, chiens de protection et de troupeau) et participez à la traite des chèvres !"
    ],
    "nl": [
      "Ontdek aan de voet van het Balcon Est du Vercors, tijdens een educatieve animatie, het vee van Anne-Laure en Gilles (geiten, bokken, ooien, rammen, ezels, kippen en hanen, waakhonden en kuddehonden) en neem deel aan het melken van de geiten!"
    ],
    "es": [
      "Al pie del Balcón Este del Vercors, durante una animación didáctica, descubra el ganado de Anne-Laure y Gilles (cabras, machos cabríos, ovejas, carneros, burros, gallinas y gallos, perros guardianes y perros de rebaño) y participe en el ordeño de las cabras"
    ]
  },
  "rdfs:label": {
    "en": [
      "Grand Veymont Farm"
    ],
    "fr": [
      "La Ferme du Grand Veymont"
    ]
  },
