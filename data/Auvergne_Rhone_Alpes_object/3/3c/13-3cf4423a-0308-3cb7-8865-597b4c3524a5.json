  "rdfs:comment": {
    "de": [
      "Als Winzer, der seit fünf Generationen vom Vater auf den Sohn übergegangen ist, führen wir das Know-how und die Qualität einer handwerklichen Methode der Weinbereitung fort. Wir stellen Clairette de Die AOC Tradition und Brut her."
    ],
    "en": [
      "Wine grower from father to son for 5 generations, Patrick Lantheaume has pursued his ancestors' know-how and quality traditional vinification methods. He produces the AOC Clairette de Die sparkling wine and its dry version."
    ],
    "it": [
      "Viticoltori di padre in figlio da cinque generazioni, perpetuiamo il know-how e la qualità di un metodo di vinificazione tradizionale. Produciamo Clairette de Die AOC Tradition e Brut."
    ],
    "fr": [
      "Vigneron de père en fils depuis cinq générations, nous perpétuons le savoir-faire et la qualité d'une méthode artisanale de vinification. Nous produisons de la Clairette de Die AOC Tradition et Brut."
    ],
    "nl": [
      "Wijnbouwers van vader op zoon, al vijf generaties lang. Patrick Lantheaume zet de expertise en de kwaliteit van de ambachtelijke wijnbereidingsmethode voort. Hij verbouwt al ongeveer tien jaar wijn op milieuvriendelijke en duurzame wijze."
    ],
    "es": [
      "Viticultores de padre a hijo desde hace cinco generaciones, perpetuamos el saber hacer y la calidad de un método de vinificación tradicional. Producimos Clairette de Die AOC Tradition y Brut."
    ]
  },
