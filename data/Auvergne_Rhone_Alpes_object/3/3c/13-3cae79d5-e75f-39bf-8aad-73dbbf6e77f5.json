  "rdfs:comment": {
    "de": [
      "Pianobar und erstklassiges Restaurant mit hausgemachten Speisen und einer sorgfältigen Auswahl an Whiskys, Bieren und Weinen.\r\nDinnerkonzerte jeden Freitag und Samstag."
    ],
    "en": [
      "High-quality piano bar and restaurant offering homemade dishes and a careful selection of whiskies, beers and wines.\r\nDinner concerts every Friday and Saturday."
    ],
    "it": [
      "Piano bar e ristorante di qualità che offre piatti fatti in casa e un'accurata selezione di whisky, birre e vini.\r\nConcerti a cena ogni venerdì e sabato."
    ],
    "fr": [
      "Piano-bar et restaurant de qualité proposant des plats fait maison et une sélection soignée de whiskys, bières et vins.\r\nDîner-concert tous les vendredis et samedis."
    ],
    "es": [
      "Piano bar y restaurante de calidad que ofrece platos caseros y una cuidada selección de whiskies, cervezas y vinos.\r\nCenas-concierto todos los viernes y sábados."
    ],
    "nl": [
