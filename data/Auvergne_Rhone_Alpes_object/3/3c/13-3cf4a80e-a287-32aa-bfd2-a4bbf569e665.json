  "rdfs:comment": {
    "de": [
      "Das gesamte Team von La Petite Assiette du Château und allen voran sein Chef Guillaume freuen sich sehr, Sie ab dem 19. März 2024 an einem neuen Ort und in einem neuen Rahmen begrüßen zu dürfen."
    ],
    "en": [
      "The entire team at La Petite Assiette du Château, led by Chef Guillaume, is delighted to welcome you to a new location and a new setting from 19 March 2024."
    ],
    "it": [
      "L'intero team de La Petite Assiette du Château, guidato dallo chef Guillaume, è lieto di darvi il benvenuto in una nuova location e in un nuovo ambiente a partire dal 19 marzo 2024."
    ],
    "fr": [
      "Toute l’équipe de La Petite Assiette du Château et en premier lieu son Chef Guillaume, ont le grand plaisir de vous accueillir à partir du 19 mars 2024 dans un nouveau lieu et un nouveau cadre."
    ],
    "es": [
      "Todo el equipo de La Petite Assiette du Château, dirigido por el Chef Guillaume, está encantado de darle la bienvenida a una nueva ubicación y un nuevo entorno a partir del 19 de marzo de 2024."
    ],
    "nl": [
      "Het hele team van La Petite Assiette du Château, onder leiding van chef-kok Guillaume, is verheugd u te mogen verwelkomen op een nieuwe locatie en in een nieuwe omgeving vanaf 19 maart 2024."
    ]
  },
  "rdfs:label": {
