  "rdfs:comment": {
    "de": [
      "Der Pochoirist CIRT Hash stellt Fragen. Die Figuren in Hashs Kompositionen, die er Geister nennt, sind niemand und jeder, denn ihre Gesichter werden nie abgebildet."
    ],
    "en": [
      "As a stencil artist, CIRT Hash raises questions. The characters in Hash's compositions, whom he calls ghosts, are nobody and everybody, because their faces are never represented."
    ],
    "it": [
      "Come artista dello stencil, CIRT Hash solleva domande. I personaggi delle composizioni di Hash, che lui chiama fantasmi, non sono nessuno e tutti, perché i loro volti non sono mai rappresentati."
    ],
    "fr": [
      "Pochoiriste, CIRT Hash interroge. Les personnages des compositions de Hash, qu'il appelle des fantômes, ne sont personne et tout le monde, car leurs visages ne sont jamais représentés."
    ],
    "es": [
      "Como artista del estarcido, CIRT Hash plantea interrogantes. Los personajes de las composiciones de Hash, a los que llama fantasmas, no son nadie ni nadie, porque sus rostros nunca están representados."
    ],
    "nl": [
      "Als stencilkunstenaar roept CIRT Hash vragen op. De personages in Hashs composities, die hij spoken noemt, zijn niemand en iedereen, omdat hun gezichten nooit worden afgebeeld."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - Les rayures de Cirt Hash"
    ]
  },
