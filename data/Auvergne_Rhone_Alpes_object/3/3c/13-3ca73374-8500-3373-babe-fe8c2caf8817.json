  "rdfs:comment": {
    "de": [
      "Montag bis Freitag: Sitzungen um 18 Uhr und 20:30 Uhr (außer in Ausnahmefällen). Sonntags: Vorführung um 18 Uhr. Zusätzliche Sitzungen um 16 Uhr möglich, je nach Wetterbedingungen.\r\nDas vollständige Programm finden Sie gleich nach Ihrer Ankunft in Le Petit Journal!"
    ],
    "en": [
      "Monday to Friday: sessions at 6 p.m. and 8:30 p.m. (with exceptions). Sunday: session at 6 p.m. Possibility of additional sessions at 4 p.m., depending on weather conditions. \r\nFind the complete program in Le Petit Journal as soon as you arrive!"
    ],
    "it": [
      "Dal lunedì al venerdì: proiezioni alle 18.00 e alle 20.30 (con alcune eccezioni). Domenica: ore 18.00. Possibili sessioni aggiuntive alle 16.00, tempo permettendo.\r\nCercate il programma completo su Le Petit Journal non appena arrivate!"
    ],
    "fr": [
      "Du lundi au vendredi : séances à 18h et 20h30 (sauf exceptions). Le dimanche : séance à 18h. Possibilité de séances supplémentaires à 16h, selon conditions météorologiques. \r\nRetrouvez le programme complet dans Le Petit Journal dès votre arrivée !"
    ],
    "nl": [
      "Maandag t/m vrijdag: voorstellingen om 18.00 en 20.30 uur (met enkele uitzonderingen). Zondag: 18.00 uur. Extra sessies om 16.00 uur mogelijk, als het weer het toelaat.\r\nKijk voor het volledige programma in Le Petit Journal zodra je aankomt!"
    ],
    "es": [
      "De lunes a viernes: sesiones a las 18.00 y 20.30 horas (con excepciones). Domingo: sesión a las 18 h. Posibilidad de sesiones adicionales a las 16 horas, dependiendo de las condiciones meteorológicas. \r\n¡Encuentra el programa completo en Le Petit Journal nada más llegar!"
    ]
  },
