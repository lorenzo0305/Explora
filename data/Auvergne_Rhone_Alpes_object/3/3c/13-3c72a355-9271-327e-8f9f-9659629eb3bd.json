  "rdfs:comment": {
    "de": [
      "In einer warmen Atmosphäre können Sie sich unter unseren erfahrenen Händen bei einer Wellness-Massage, einem Head Spa oder einer Facialiste-Massage entspannen.\r\nWir bieten auch sanfte Wachsenthaarung, eine Nagelbar und Augenschönheit an."
    ],
    "en": [
      "In a warm and welcoming atmosphere, relax under our expert hands with a wellness massage, a Head Spa, or a Facialist massage.\r\nWe also gently offer waxing, a nail bar, and eye beauty treatments."
    ],
    "it": [
      "In un’atmosfera calda e accogliente, rilassati sotto le nostre mani esperte con un massaggio benessere, un Head Spa o un massaggio facialista.\r\nOffriamo inoltre, con delicatezza, cerette, un nail bar e trattamenti per la bellezza dello sguardo."
    ],
    "fr": [
      "Dans une ambiance chaleureuse, détendez-vous sous nos mains expertes, le temps d'un massage bien-être, d'un Head Spa ou d'un massage Facialiste.\r\nNous proposons aussi, avec douceur, des épilations à la cire, un bar à ongles et la beauté du regard."
    ],
    "nl": [
      "Ontspan in een warme sfeer onder onze deskundige handen voor een wellnessmassage, een Head Spa of een gezichtsmassage.\r\nWe bieden ook zachte waxbehandelingen, een nagelstudio en oogbehandelingen."
    ],
    "es": [
      "En un ambiente cálido, relájese bajo nuestras manos expertas para disfrutar de un masaje de bienestar, un masaje Head Spa o un masaje facialista.\r\nTambién ofrecemos depilación suave, un bar de uñas y tratamientos de belleza ocular."
    ]
  },
  "rdfs:label": {
    "en": [
      "Beauty institute - Douceur des Cimes"
    ],
    "it": [
      "Salone di bellezza - Douceur des Cimes"
    ],
    "fr": [
      "Institut de Beauté - Douceur des Cimes"
    ]
  },
