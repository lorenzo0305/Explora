  "rdfs:comment": {
    "de": [
      "Der Raum Gliss Les Lutins ist dem Erlernen des Gleitens für Groß und Klein gewidmet. ."
    ],
    "en": [
      "A new zone to learn skiing dedicated to beginners !\r\nLocated next to the Tourist Office, it is made of 2 covered conveyors. This zone is multifunctional : one area is dedicated to skiing and the second one, to sledging.\r\nSpecial day and night entertainment subject to the entertainment programm available at the tourist office"
    ],
    "it": [
      "L'area Gliss Les Lutins è dedicata all'apprendimento dello scivolo per grandi e piccini."
    ],
    "fr": [
      "L’espace Gliss Les Lutins est dédié à l'apprentissage de la glisse pour petits et grands. ."
    ],
