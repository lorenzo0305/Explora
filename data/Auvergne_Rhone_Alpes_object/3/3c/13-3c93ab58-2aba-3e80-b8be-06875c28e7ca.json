  "rdfs:comment": {
    "de": [
      "Isabelle Laporte empfängt Sie in der 24 Grand Rue für einen Moment der Entspannung.\r\ntiefen Entspannung. Zur Auswahl: Wellness-Massagen, Fuß- oder Handreflexzonenmassage,\r\nEntspannung. Spezifische Techniken, die auf die Bedürfnisse und Wünsche jedes Einzelnen zugeschnitten sind. Nach Vereinbarung."
    ],
    "en": [
      "Isabelle Laporte welcomes you in Buis-les-Baronnies (24, Grand Rue), for a moment of relaxation with several massages: traditional massage or plantar and palmar reflexology. She adapts the care to your needs. Reservation requested."
    ],
    "it": [
      "Isabelle Laporte vi accoglie al 24 Grand Rue per un momento di profondo relax\r\nrilassamento. Si può scegliere tra un massaggio benessere, una riflessologia plantare o palmare,\r\nrilassamento. Tecniche specifiche adattate alle esigenze e ai desideri di ogni persona. Solo su appuntamento."
    ],
    "fr": [
      "Isabelle Laporte vous accueille au 24 Grand Rue pour un moment de détente\r\nprofonde. Au choix : massages-bien-être, réflexologie plantaire ou palmaire,\r\nrelaxation. Des techniques spécifiques adaptées aux besoins et envies de chacun. Sur RDV."
    ],
    "nl": [
      "Isabelle Laporte verwelkomt u in 24 Grand Rue voor een moment van diepe ontspanning. U kunt kiezen uit een wellnessmassage, voet- of handpalmreflexologie,\r\nSpecifieke technieken aangepast aan de behoeften en wensen van elke persoon. Op afspraak."
    ],
    "es": [
      "Isabelle Laporte le da la bienvenida a 24 Grand Rue para un momento de profunda relajación\r\nrelajación. Puede elegir entre un masaje de bienestar, reflexología podal o palmar,\r\nrelajación. Técnicas específicas adaptadas a las necesidades y deseos de cada persona. Sólo con cita previa."
    ]
  },
