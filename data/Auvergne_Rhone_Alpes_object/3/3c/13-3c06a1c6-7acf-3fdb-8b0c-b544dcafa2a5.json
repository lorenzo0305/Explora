  "rdfs:comment": {
    "de": [
      "L'apprenti Sage ist das pädagogische Restaurant der MFR Balan. Das Restaurant wurde so konzipiert, dass es eine ideale Umgebung für das Lernen und die kulinarische Erfahrung bietet, und das in einem einzigartigen Rahmen: der ehemaligen Kapelle des Landgutes aus dem 16."
    ],
    "en": [
      "L?apprenti Sage is the educational restaurant of the MFR de Balan. The restaurant has been designed to provide an ideal environment for learning and culinary experience, in a unique setting: the estate?s former chapel, dating from the 16th century."
    ],
    "it": [
      "L'apprendistato Sage è il ristorante didattico dell'MFR Balan. Il ristorante è stato progettato per offrire un ambiente ideale per l'apprendimento e l'esperienza culinaria, in un contesto unico: l'ex cappella della tenuta, risalente al XVI secolo."
    ],
    "fr": [
      "L’apprenti Sage est le restaurant pédagogique de la MFR de Balan. Le restaurant a été conçu pour offrir un environnement idéal pour l’apprentissage et l’expérience culinaire, dans un cadre unique : l’ancienne chapelle du domaine, datant du 16ème siècle."
    ],
    "nl": [
      "L'apprenti Sage is het educatieve restaurant van MFR Balan. Het restaurant is ontworpen om een ideale omgeving te bieden voor leren en culinaire ervaring, in een unieke omgeving: de voormalige kapel van het landgoed, daterend uit de 16e eeuw."
    ],
    "es": [
      "L'apprenti Sage es el restaurante educativo del MFR Balan. El restaurante ha sido diseñado para proporcionar un entorno ideal para el aprendizaje y la experiencia culinaria, en un entorno único: la antigua capilla de la finca, que data del siglo XVI."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Apprenti Sage"
    ]
  },
