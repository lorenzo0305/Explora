  "rdfs:comment": {
    "de": [
      "Konzert des Cello-Duos \"Facéties\": Raphaël JOUAN und Thibaut REZNICEK in der romanischen Kirche, die beheizt sein wird. Eine kommentierte Besichtigung des Ortes findet um 16:15 Uhr statt."
    ],
    "en": [
      "Concert by the \"Facéties\" cello duo: Raphaël JOUAN and Thibaut REZNICEK in the heated Romanesque church. A guided tour of the site will take place at 4.15pm."
    ],
    "it": [
      "Concerto del duo di violoncelli \"Facéties\": Raphaël JOUAN e Thibaut REZNICEK nella chiesa romanica, che sarà riscaldata. Alle 16.15 si terrà una visita guidata del sito."
    ],
    "fr": [
      "Concert de Duo de violoncelles \"Facéties\" : Raphaël JOUAN et Thibaut REZNICEK  dans l'église romane qui sera chauffée. Un visite commentée du lieu aura lieu à 16h15."
    ],
    "es": [
      "Concierto del dúo de violonchelos \"Facéties\": Raphaël JOUAN y Thibaut REZNICEK en la iglesia románica, que se calentará. A las 16.15 h tendrá lugar una visita guiada del lugar."
    ],
    "nl": [
      "Concert van het celloduo \"Facéties\": Raphaël JOUAN en Thibaut REZNICEK in de Romaanse kerk, die verwarmd zal worden. Om 16.15 uur vindt er een rondleiding plaats."
    ]
  },
