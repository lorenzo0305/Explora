  "rdfs:comment": {
    "de": [
      "Der Parcours Aventure Trièves bietet Ihnen an einem einzigen Ort vier spielerische und sportliche Aktivitäten. Im Herzen des Waldes, am Fuße des Mont-Aiguille gelegen, haben Sie die Wahl: Abenteuerparcours, Hochsitzhütten, Labyrinthwald oder Trapperbiwak."
    ],
    "en": [
      "The Parcours Aventure Trièves offers you four fun and sporting activities all in one place. In the heart of the forest, at the foot of Mont-Aiguille, you can choose from adventure courses, perched cabins, forest labyrinths or trapper's bivouacs."
    ],
    "it": [
      "Il Corso Avventura di Trièves vi offre quattro attività divertenti e sportive in un unico luogo. Nel cuore della foresta, ai piedi del Mont-Aiguille, potrete scegliere tra percorso avventura, capanne arroccate, foresta labirinto o bivacco del trapper."
    ],
    "fr": [
      "Le Parcours Aventure Trièves vous propose en un seul lieu quatre activités ludiques et sportives. Au cœur de la forêt, situé au pied du Mont-Aiguille, vous avez le choix : parcours aventure, cabanes perchées, forêt labyrinthe ou bivouac de trappeurs."
    ],
    "nl": [
      "Het Avonturenparcours van Trièves biedt u vier leuke en sportieve activiteiten op één plek. In het hart van het bos, gelegen aan de voet van de Mont-Aiguille, heeft u de keuze: avonturenparcours, berghutten, labyrintbos of trappersbivak."
    ],
    "es": [
      "El Curso de Aventura de Trièves le ofrece cuatro actividades divertidas y deportivas en un solo lugar. En el corazón del bosque, situado a los pies del Mont-Aiguille, podrá elegir: recorrido de aventura, cabañas encaramadas, bosque laberíntico o vivac de trampero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours aventure Trièves"
    ]
  },
