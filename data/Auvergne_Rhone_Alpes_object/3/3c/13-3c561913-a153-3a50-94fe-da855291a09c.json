  "rdfs:comment": {
    "de": [
      "Gleitschirmschule und Tandemflüge\r\nGleitschirmsprung und Taufe. Praktika und Kurse\r\nAtemberaubende Landschaften mit Blick auf den Mont Blanc, besinnliche, sportliche oder sogar akrobatische Flüge,\r\nÉlévation Parapente versteht es, seine Leidenschaft gut gelaunt an Sie weiterzugeben"
    ],
    "en": [
      "Paragliding school and tandem flights\r\nParagliding jump and baptism. Internships and courses\r\nBreathtaking landscapes facing Mont Blanc, contemplative, sporting or even acrobatic flights,\r\nÉlévation Parapente will know how to pass on its passion to you in a good mood"
    ],
    "it": [
      "Scuola di parapendio e voli tandem\r\nSalti in parapendio e primi voli. Corsi e lezioni\r\nPaesaggi mozzafiato di fronte al Monte Bianco, voli contemplativi, sportivi o addirittura acrobatici,\r\nÉlévation Parapente condividerà con voi la sua passione in un'atmosfera amichevole"
    ],
    "fr": [
      "Ecole et vols tandems en Parapente\r\nSaut et baptême de parapente. Stages et cours\r\nDes paysages à couper le souffle face au Mont Blanc, vol contemplatif, sportif ou même acrobatique,\r\nÉlévation Parapente saura vous transmettre sa passion dans la bonne humeur"
    ],
    "nl": [
      "Paragliding school en tandemsprongen\r\nParagliding sprongen en eerste vluchten. Cursussen en lessen\r\nAdembenemende landschappen met uitzicht op de Mont Blanc, contemplatieve, sportieve of zelfs acrobatische vluchten,\r\nÉlévation Parapente deelt zijn passie met u in een gezellige sfeer"
    ],
    "es": [
      "Escuela de parapente y vuelos biplaza\r\nSaltos y primeros vuelos en parapente. Cursos y clases\r\nImpresionantes paisajes frente al Mont Blanc, vuelos contemplativos, deportivos o incluso acrobáticos,\r\nÉlévation Parapente compartirá su pasión con usted en un ambiente agradable"
    ]
  },
