  "rdfs:comment": {
    "de": [
      "Im Herzen von Chamonix, auf dem von den höchsten Bergen Europas gekrönten Place du Mont-Blanc, winkt ein rotes Banner den zahlreichen Besuchern zu, die hier vorbeikommen... Die Boutique Paulsen-Guérin bietet Abenteuerlustigen einen Zwischenstopp."
    ],
    "en": [
      "In the heart of Chamonix, on the Place du Mont-Blanc, crowned by Europe's highest mountains, a red banner beckons to the many visitors who pass by... The Paulsen-Guérin boutique offers a stopover for adventure enthusiasts."
    ],
    "it": [
      "Nel cuore di Chamonix, sulla Place du Mont-Blanc, coronata dalle montagne più alte d'Europa, uno striscione rosso richiama i numerosi visitatori di passaggio... La boutique Paulsen-Guérin offre una sosta agli amanti dell'avventura."
    ],
    "fr": [
      "Au cœur de Chamonix, sur la place du Mont-Blanc couronnée des plus hautes montagnes d’Europe, une bannière rouge fait signe aux nombreux visiteurs qui passent par là… La boutique Paulsen-Guérin offre une halte aux passionnés d’aventure."
    ],
    "nl": [
      "In het hart van Chamonix, op de Place du Mont-Blanc, bekroond door de hoogste bergen van Europa, lonkt een rood spandoek naar de vele bezoekers die langskomen? De Paulsen-Guérin boetiek biedt een halte voor avonturiers."
    ],
    "es": [
      "En el corazón de Chamonix, en la Place du Mont-Blanc, coronada por las montañas más altas de Europa, una pancarta roja hace señas a los numerosos visitantes que pasan por allí... La boutique Paulsen-Guérin ofrece una parada a los amantes de la aventura."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Editions Guérin Paulsen"
    ]
  },
