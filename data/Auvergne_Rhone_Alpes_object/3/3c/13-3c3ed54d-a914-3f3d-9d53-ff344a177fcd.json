  "rdfs:comment": {
    "de": [
      "Familienbetrieb mit 60 Milchkühen, die hauptsächlich der Rasse Montbéliarde angehören.\r\nDirektverkauf von Joghurt, Quark, Faselle, Rohmilch, Butter, Sahne auf dem Markt in Craponne und auf dem Bauernhof."
    ],
    "en": [
      "Family farm with 60 dairy cows, mainly Montbéliarde.\r\nDirect sales of yogurts, fromage blanc, faisselles, raw milk, butter and cream at the Craponne market and at the farm."
    ],
    "it": [
      "Azienda agricola a conduzione familiare con 60 vacche da latte, principalmente di razza Montbéliarde.\r\nVendita diretta di yogurt, fromage blanc, faisselles, latte crudo, burro e panna al mercato di Craponne e in azienda."
    ],
    "fr": [
      "Ferme familiale qui compte 60 vaches laitières de race montbéliarde principalement.\r\nVente directe de yaourts, fromages blancs, faisselles, lait cru, beurre, crème sur le marché de Craponne et à la ferme."
    ],
    "nl": [
      "Familiebedrijf met 60 melkkoeien, voornamelijk van het ras Montbéliarde.\r\nDirecte verkoop van yoghurt, fromage blanc, faisselles, rauwe melk, boter en room op de markt van Craponne en op de boerderij."
    ],
    "es": [
      "Explotación familiar con 60 vacas lecheras, principalmente de raza Montbéliarde.\r\nVenta directa de yogures, fromage blanc, faisselles, leche cruda, mantequilla y nata en el mercado de Craponne y en la granja."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC du Bon Accueil"
    ]
  },
