  "rdfs:comment": {
    "de": [
      "Die Künstlervereinigung von Saint-Marcellois wird Sie mit den vielfältigen Werken dieser Ausstellung angenehm überraschen und Ihnen die Möglichkeit geben, alte und neue lokale Talente zu treffen! Vernissage: Freitag, 24. April um 19 Uhr."
    ],
    "en": [
      "The Saint-Marcellois artists? association will pleasantly surprise you with the varied works in this exhibition, and give you the chance to meet local talents, old and new! Opening: Friday April 24, 7pm."
    ],
    "it": [
      "L'associazione degli artisti di Saint-Marcell vi sorprenderà con le diverse opere in mostra e vi darà la possibilità di conoscere i talenti locali, vecchi e nuovi! Inaugurazione: venerdì 24 aprile alle 19.00."
    ],
    "fr": [
      "L’association d’artistes saint-marcellois vous surprendra agréablement par les œuvres variées de cette exposition et vous permettra de rencontrer les talents locaux, anciens et nouveaux ! Vernissage : vendredi 24 avril à 19h."
    ],
    "es": [
      "La asociación de artistas de Saint-Marcell le sorprenderá con las variadas obras expuestas y le brindará la oportunidad de conocer a viejos y nuevos talentos locales Inauguración: viernes 24 de abril a las 19.00 h."
    ],
    "nl": [
      "De kunstenaarsvereniging Saint-Marcell zal je verrassen met de gevarieerde tentoongestelde werken en je de kans geven om lokaal talent te ontmoeten, oud en nieuw! Opening: vrijdag 24 april om 19u."
    ]
  },
  "rdfs:label": {
