  "rdfs:comment": {
    "de": [
      "Das Copernicus-Netzwerk umfasst 3 Mediatheken, 56 Bibliotheken und 3 Ludotheken auf dem Gebiet der Loire Forez Agglomeration. Es handelt sich um Orte, die allen zugänglich sind, um sich auszutauschen, sich zu unterhalten, zu lernen und zu spielen."
    ],
    "en": [
      "The Copernic network gathers 3 media libraries, 56 libraries and 3 toy libraries on the territory of Loire Forez agglomeration. So many places accessible to all to exchange, have fun, learn and play."
    ],
    "it": [
      "La rete Copernic riunisce 3 mediateche, 56 biblioteche e 3 ludoteche dell'agglomerato Loire Forez. Tutti questi luoghi sono accessibili a tutti per scambiare idee, divertirsi, imparare e giocare."
    ],
    "fr": [
      "Le réseau Copernic rassemble 3 médiathèques, 56 bibliothèques et 3 ludothèques sur le territoire de Loire Forez agglomération. Autant de lieux accessibles à tous pour échanger, se divertir, apprendre et jouer."
    ],
    "es": [
      "La red Copernic reúne 3 mediatecas, 56 bibliotecas y 3 ludotecas en la aglomeración de Loire Forez. Todos estos lugares son accesibles a todos para intercambiar ideas, divertirse, aprender y jugar."
    ],
    "nl": [
      "Het Copernic-netwerk verenigt 3 mediatheken, 56 bibliotheken en 3 speelgoedbibliotheken in de agglomeratie Loire Forez. Al deze plaatsen zijn voor iedereen toegankelijk om ideeën uit te wisselen, plezier te maken, te leren en te spelen."
    ]
  },
