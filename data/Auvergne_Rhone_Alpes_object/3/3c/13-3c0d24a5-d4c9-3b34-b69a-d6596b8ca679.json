  "rdfs:comment": {
    "de": [
      "Finden Sie Ihr inneres Gleichgewicht wieder, während Sie gleichzeitig Ihren Körper durch das Üben von Körperhaltungen und Atemübungen revitalisieren.\r\nWöchentliche Kurse von September bis Juni."
    ],
    "en": [
      "Find back you inter peace thanks to the postures and breathings exercices. \r\nEvery week lessons from september to june."
    ],
    "it": [
      "Ritrovate il vostro equilibrio interiore mentre rivitalizzate il vostro corpo attraverso la pratica delle posture e della respirazione.\r\nLezioni settimanali da settembre a giugno."
    ],
    "fr": [
      "Retrouvez votre équilibre intérieur en même temps que vous revitalisez votre corps par la pratique de postures et de respirations.\r\nCours hebdomadaires de septembre à juin."
    ],
    "nl": [
      "Vind je innerlijke balans terwijl je je lichaam revitaliseert door het beoefenen van houdingen en ademhaling.\r\nWekelijkse lessen van september tot juni."
    ],
    "es": [
      "Encuentra tu equilibrio interior mientras revitalizas tu cuerpo a través de la práctica de posturas y respiración.\r\nClases semanales de septiembre a junio."
    ]
  },
