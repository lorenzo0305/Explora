  "rdfs:comment": {
    "de": [
      "Das Weingut Famille Chermette ist ein Familienbetrieb im südlichen Beaujolais. Jean-Etienne Chermette bietet bodenständige Weine mit Frucht und Finesse an: Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Morgon, Crémants de Bourgogne."
    ],
    "en": [
      "Domaines Chermette is a family estate in southern Beaujolais. Combining tradition and modernity, Martine, Pierre-Marie and Jean-Etienne Chermette offer authentic wines: Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Crémants de Bourgogne."
    ],
    "it": [
      "La tenuta Famille Chermette è un'azienda a conduzione familiare nella regione meridionale del Beaujolais. Jean-Etienne Chermette produce vini fruttati e di terroir pregiato: Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Morgon e Crémants de Bourgogne."
    ],
    "fr": [
      "Le domaine Famille Chermette est une exploitation familiale du Sud Beaujolais. Jean-Etienne Chermette propose des vins de terroir sur le fruit et la finesse : Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Morgon, Crémants de Bourgogne."
    ],
    "es": [
      "La finca Famille Chermette es una empresa familiar del sur de Beaujolais. Jean-Etienne Chermette produce vinos afrutados y finos de terruño: Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Morgon y Crémants de Bourgogne."
    ],
    "nl": [
      "Het domein van de Famille Chermette is een familiebedrijf in het zuiden van de Beaujolais. Jean-Etienne Chermette produceert fruitige, fijne terroirwijnen: Beaujolais, Brouilly, Fleurie, Moulin à Vent, St Amour, Morgon en Crémants de Bourgogne."
    ]
  },
