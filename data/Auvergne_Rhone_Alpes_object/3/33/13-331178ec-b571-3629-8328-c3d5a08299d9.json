  "rdfs:comment": {
    "de": [
      "Der Verein Valdequint bietet verschiedene Dienstleistungen (Zugang zu Rechten, digitaler Zugang) und Veranstaltungen (Workshops, Konzerte, Aufführungen...) für die Bewohnerinnen und Bewohner des Gebiets des Quinttals an."
    ],
    "en": [
      "The Valdequint association offers a wide range of services (access to rights, digital access) and events (workshops, concerts, shows...) for the residents of the Quint valley area."
    ],
    "it": [
      "L'associazione Valdequint offre una serie di servizi (accesso ai diritti, accesso digitale) ed eventi (laboratori, concerti, spettacoli, ecc.) per i residenti della zona della valle del Quint."
    ],
    "fr": [
      "L'association Valdequint propose des services (accès aux droits, accès numérique) et événements (ateliers, concerts, spectacles...) variés pour les habitant·es du territoire de la vallée de Quint."
    ],
    "es": [
      "La asociación Valdequint ofrece diversos servicios (acceso a derechos, acceso digital) y eventos (talleres, conciertos, espectáculos, etc.) a los residentes de la zona del valle del Quint."
    ],
    "nl": [
      "De vereniging Valdequint biedt verschillende diensten (toegang tot rechten, digitale toegang) en evenementen (workshops, concerten, voorstellingen, enz.) voor de bewoners van de Quint vallei."
    ]
  },
