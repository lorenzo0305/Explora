  "rdfs:comment": {
    "de": [
      "Chez Bànôi ist ein Restaurant, das Sie mit seiner schmackhaften und authentischen traditionellen Küche nach Vietnam entführt. Die Cheffe Bànôi bereitet Ihnen Gerichte aus frischen und hochwertigen Zutaten zu."
    ],
    "en": [
      "Chez Bànội is a Lyon-based restaurant that transports you to Vietnam with its delicious and authentic traditional cuisine. The Cheffe Bànội will prepare to you, dishes using fresh and high-quality ingredients, while the warm and attentive service level creates a friendly and welcoming atmosphere for all guests."
    ],
    "it": [
      "Chez Bànôi è un ristorante che vi trasporta in Vietnam con la sua cucina tradizionale, gustosa e autentica. Lo chef Bànôi preparerà i piatti con ingredienti freschi e di qualità."
    ],
    "fr": [
      "Chez Bànôi est un restaurant qui vous transporte au Vietnam grâce à sa cuisine traditionnelle savoureuse et authentique. La Cheffe Bànôi vous préparera des plats à base d'ingrédients frais et de qualité."
    ],
    "nl": [
      "Chez Bànôi is een restaurant dat u meeneemt naar Vietnam met zijn traditionele, smakelijke en authentieke keuken. Chef Bànôi bereidt gerechten met verse kwaliteitsingrediënten."
    ],
    "es": [
      "Chez Bànôi es un restaurante que le transporta a Vietnam con su cocina tradicional, sabrosa y auténtica. El chef Bànôi preparará platos con ingredientes frescos y de calidad."
    ]
  },
