  "rdfs:comment": {
    "de": [
      "Taxi mit allem Komfort zu Ihren Diensten 7/7j-24/24h - Alle Entfernungen - Klimatisiert. VSL und Transport von sitzenden Kranken, Krankenhaustransfers, Arztbesuche, Krankenhausaufenthalte. Transport zum Bahnhof, Flughafen. Touristische Rundfahrt."
    ],
    "en": [
      "Comfortable cab at your service 7/7d-24/24h - All distances - Air-conditioned. VSL and seated patient transport, hospital transfer, consultation, hospitalization. Airport and train station transportation. Sightseeing tours."
    ],
    "it": [
      "Taxi confortevole al vostro servizio 7/7d-24/24h - Tutte le distanze - Aria condizionata. Trasporto di pazienti in VSL e in posizione seduta, trasferimento in ospedale, consultazione, ricovero. Trasporto da e per le stazioni ferroviarie e gli aeroporti. Circuito turistico."
    ],
    "fr": [
      "Taxi tout confort à votre service 7/7j-24/24h - Toutes distances - Climatisé. VSL et transport malade assis, transfert hôpital, consultation, hospitalisation. Transport gare, aéroport. Circuit touristique."
    ],
    "es": [
      "Taxi confortable a su servicio 7/7d-24/24h - Todas las distancias - Con aire acondicionado. Transporte de pacientes en VSL y sentados, traslado al hospital, consulta, hospitalización. Transporte hacia y desde las estaciones de tren y los aeropuertos. Circuito turístico."
    ],
    "nl": [
      "Comfortabele taxi tot uw dienst 7/7d-24/24h - Alle afstanden - Airconditioning. VSL en zittend ziekenvervoer, ziekenhuistransfer, consultatie, hospitalisatie. Vervoer van en naar treinstations en luchthavens. Rondleidingen."
    ]
  },
