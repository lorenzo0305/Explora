  "rdfs:comment": {
    "de": [
      "Genießen Sie auf 2200 m Höhe die Panoramaterrasse und die Bar La Ranôva: Bar, hausgemachter Glühwein, Restaurant, Tagesgericht, Crêpes...\r\n30 Minuten zu Fuß (nur im Sommer) von der Ankunft des Sessellifts von Arcelle entfernt."
    ],
    "en": [
      "Come and enjoy at 2200 m altitude the panoramic terrace and the bar La Ranôva: bar, house mulled wine, restaurant, dish of the day, pancakes... \r\n30 minutes walk (summer only) from the arrival of the Arcelle chairlift."
    ],
    "it": [
      "Venite a godervi la terrazza panoramica e il bar de La Ranôva a 2200 m di altitudine: bar, vin brulé fatto in casa, ristorante, specialità del giorno, crêpes...\r\nA 30 minuti a piedi (solo in estate) dall'arrivo della seggiovia Arcelle."
    ],
    "fr": [
      "Venez profitez à 2200 m d'altitude de la terrasse panoramique et du bar La Ranôva : bar, vin chaud maison, restaurant, plat du jour, crêpes... \r\nA 30mn à pied (l'été uniquement) de l'arrivée du télésiège de l'Arcelle."
    ],
    "es": [
      "Venga a disfrutar de la terraza panorámica y del bar de La Ranôva, a 2200 m de altitud: bar, vino caliente casero, restaurante, platos del día, crepes...\r\nA 30 minutos a pie (sólo en verano) de la llegada del telesilla Arcelle."
    ],
    "nl": [
      "Kom en geniet op 2200 m hoogte van het panoramische terras en de bar La Ranôva: bar, huiswijn, restaurant, dagschotel, pannenkoeken... \r\n30 minuten lopen ( alleen zomer ) vanaf de aankomst van de Arcelle stoeltjeslift."
    ]
  },
