  "rdfs:comment": {
    "de": [
      "Evolution 2 ist zu einer der angesehensten Ski- und Abenteuerschulen in den französischen Alpen geworden. Wir glauben an das Lernen in kleinen Gruppen, von spezialisierten Lehrern, mit dem Schwerpunkt auf Fortschritt und Spaß!"
    ],
    "en": [
      "Evolution 2 has become one of the most respected ski and adventure schools in the French Alps. We believe in learning in small groups, with specialist instructors, and an emphasis on progression and fun!"
    ],
    "it": [
      "Evolution 2 è diventata una delle scuole di sci e avventura più rispettate delle Alpi francesi. Crediamo nell'apprendimento in piccoli gruppi, da parte di istruttori specializzati, con un'enfasi sulla progressione e sul divertimento!"
    ],
    "fr": [
      "Evolution 2 est devenue l’une des écoles de ski et d’aventure les plus respectées des Alpes françaises. Nous croyons à l’apprentissage en petits groupes, par des moniteurs spécialisés, avec un accent placé sur la progression et l'amusement!"
    ],
    "es": [
      "Evolution 2 se ha convertido en una de las escuelas de esquí y aventura más respetadas de los Alpes franceses. Creemos en el aprendizaje en grupos reducidos, con instructores especializados y haciendo hincapié en la progresión y la diversión"
    ],
    "nl": [
      "Evolution 2 is uitgegroeid tot een van de meest gerespecteerde ski- en avontuurscholen in de Franse Alpen. Wij geloven in leren in kleine groepen, door gespecialiseerde instructeurs, met de nadruk op vooruitgang en plezier!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Evolution 2 le lac"
    ]
  },
