  "rdfs:comment": {
    "de": [
      "Besichtigung des Weinkellers und des Ortes der Weinbereitung und Verpackung, Erklärung des Weinguts (Herkunft, Produktion, Terroir) und Verkostung der selbst hergestellten Produkte: roter Beaujolais, weißer Beaujolais."
    ],
    "en": [
      "Visit of the cellar and the place of vinification and packaging, explanation of the estate (origin, production, terroirs) and tasting of the products we make: red Beaujolais, white Beaujolais."
    ],
    "it": [
      "Visita della cantina e della zona di vinificazione e confezionamento, spiegazione del Domaine (origine, produzione, terroir) e degustazione dei prodotti di nostra produzione: Beaujolais rosso, Beaujolais bianco."
    ],
    "fr": [
      "Visite de la cave et du lieu de vinification et de conditionnement, explication du Domaine (origine, production, terroirs) et dégustation des produits élaborés par nos soins : beaujolais rouge, beaujolais blanc."
    ],
    "es": [
      "Visita de la bodega y de la zona de vinificación y envasado, explicación del Domaine (origen, producción, terruños) y degustación de los productos que producimos: Beaujolais rojo, Beaujolais blanco."
    ],
    "nl": [
      "Bezoek aan de kelder en de vinificatie- en verpakkingsruimte, uitleg over het Domaine (oorsprong, productie, terroirs) en proeven van de producten die wij produceren: rode Beaujolais, witte Beaujolais."
    ]
  },
