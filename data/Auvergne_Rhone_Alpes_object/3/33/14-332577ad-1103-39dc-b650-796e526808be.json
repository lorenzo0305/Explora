  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/54bd8740-54f6-35f6-b7b1-0ead2307e5f9",
      "dc:description": {
        "de": [
          "Bioladen: Frischprodukte, Obst und Gemüse, Lebensmittel, lose Ware, Haushaltspflege und Nahrungsergänzungsmittel\n\nNachhaltige Entwicklung: \"Null Plastik\", \"Null Abfall\", \"Wiederaufladbare Batterien\", \"Sensibilisierung\" und \"Anti-Verschwendung\""
        ],
        "en": [
          "Organic store: fresh produce, fruit and vegetables, groceries, bulk, home care and dietary supplements\n\nSustainable development: \"zero plastic\", \"zero waste\", \"rechargeable batteries\", \"awareness-raising\" and \"anti-gaspi\" initiatives"
        ],
        "it": [
          "Negozio biologico: prodotti freschi, frutta e verdura, alimentari, prodotti sfusi, cura della casa e integratori alimentari\n\nSviluppo sostenibile: iniziative \"zero plastica\", \"zero rifiuti\", \"batterie ricaricabili\", \"sensibilizzazione\" e \"antigas\""
        ],
        "fr": [
          "Magasin bio : produits frais, fruits et légumes, épicerie, vrac, entretien de la maison et compléments alimentaires\n\nDéveloppement durable : démarches \"zéro plastique\", \"zéro déchets\", \"batteries rechargeables\", \"sensibilisation\" et \"anti-gaspi\""
        ],
        "es": [
          "Tienda ecológica: productos frescos, frutas y verduras, comestibles, productos a granel, cuidado del hogar y complementos alimenticios\n\nDesarrollo sostenible: iniciativas \"plástico cero\", \"residuos cero\", \"pilas recargables\", \"sensibilización\" y \"antigaspi\""
        ],
        "nl": [
          "Biologische winkel: verse producten, groenten en fruit, kruidenierswaren, bulkproducten, thuiszorg en voedingssupplementen\n\nDuurzame ontwikkeling: \"nul plastic\", \"nul afval\", \"oplaadbare batterijen\", \"sensibilisering\" en \"anti-gaspi\"-initiatieven"
        ]
      },
      "@type": [
        "Description"
      ],
