  "rdfs:comment": {
    "de": [
      "L'Auberg'in ist ein Café-Restaurant mit einem gemütlichen Rahmen und einer entspannten, gemütlichen Atmosphäre. Für ein Bier oder einen Kaffee, ein Mittagsmenü oder einen Abend mit der Familie oder mit Freunden, treffen Sie sich in L'Auberg'in in Saint-Rémy"
    ],
    "en": [
      "Auberg'in is a café-restaurant with a warm, cosy and relaxed atmosphere. For a beer or coffee, a lunchtime menu, or an evening out with family and friends, come and meet us at Auberg'in, in Saint-Rémy."
    ],
    "it": [
      "Auberg'in è un caffè-ristorante dall'atmosfera calda, accogliente e rilassata. Per una birra o un caffè, un menu a pranzo o una serata in famiglia o con gli amici, venite a trovarci da Auberg'in, a Saint-Rémy"
    ],
    "fr": [
      "L'Auberg'in, c'est un café restaurant au cadre chaleureux, à l'ambiance cosy et  décontractée. Pour une bière ou un café, un menu pension le midi, ou une  soirée en famille ou avec des amis, venez vous retrouver à l'Auberg'in, à Saint-Rémy"
    ],
    "nl": [
      "Auberg'in is een café-restaurant met een warme, gezellige en ontspannen sfeer. Voor een biertje of een koffie, een lunchmenu of een avondje uit met familie of vrienden, kom naar Auberg'in in Saint-Rémy"
    ],
    "es": [
      "Auberg'in es un café-restaurante de ambiente cálido, acogedor y relajado. Para una cerveza o un café, un menú al mediodía o una velada en familia o entre amigos, venga a reunirse en Auberg'in, en Saint-Rémy"
    ]
  },
