  "rdfs:comment": {
    "de": [
      "Am Fuße der Pisten können Sie sich zu jeder Tageszeit eine Schlemmerpause gönnen.\r\nLokale Produkte, gesellige Atmosphäre, Après-Ski-Happy-Hour und eine große Sonnenterrasse zum Entspannen erwarten Sie hier."
    ],
    "en": [
      "At the foot of the slopes, treat yourself to a gourmet break at any time of day.\r\nLocal produce, a friendly atmosphere, après-ski happy hour and a large sunny terrace to relax on."
    ],
    "it": [
      "Ai piedi delle piste, concedetevi una pausa gourmet a qualsiasi ora del giorno.\r\nProdotti locali, atmosfera amichevole, happy hour après-ski e un'ampia terrazza soleggiata dove rilassarsi."
    ],
    "fr": [
      "Au pied des pistes, offrez-vous une pause gourmande à toute heure de la journée.\r\nProduits locaux, ambiance conviviale, happy hour après-ski et grande terrasse ensoleillée pour se détendre vous y attendent."
    ],
    "nl": [
      "Aan de voet van de pistes kun je jezelf op elk moment van de dag trakteren op een gastronomische pauze.\r\nLokale producten, een vriendelijke sfeer, après-ski happy hour en een groot zonnig terras om te ontspannen."
    ],
    "es": [
      "A pie de pistas, disfrute de una pausa gastronómica a cualquier hora del día.\r\nProductos locales, ambiente agradable, happy hour après-ski y una gran terraza soleada para relajarse."
    ]
  },
  "rdfs:label": {
