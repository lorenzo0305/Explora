  ],
  "rdfs:comment": {
    "de": [
      "Das Bistro du Couvent in Saint Prix, das in einem ehemaligen Kloster eingerichtet wurde, bietet Ihnen im Sommer handgemachtes Eis und Getränke sowie am Wochenende süße und herzhafte Snacks, Ravioligratins, Salate und Pizza."
    ],
    "en": [
      "The Bistro du Couvent in Saint Prix, housed in a former convent, offers homemade ice creams and drinks in summer, as well as sweet and savory snacks, ravioli gratins, salads and pizza at weekends."
    ],
    "it": [
      "Il Bistro du Couvent di Saint Prix, ospitato in un ex convento, offre gelati e bevande fatte in casa in estate, oltre a snack dolci e salati, ravioli gratinati, insalate e pizza nel fine settimana."
    ],
    "fr": [
      "Le Bistro du Couvent à Saint Prix, aménagé dans un ancien couvent, vous propose glaces artisanales et boissons en été, ainsi que des encas salés et sucrés, gratins de ravioles, salades et pizza en weekend."
    ],
    "es": [
      "El Bistro du Couvent de Saint Prix, ubicado en un antiguo convento, ofrece helados caseros y bebidas en verano, así como aperitivos dulces y salados, raviolis gratinados, ensaladas y pizza los fines de semana."
    ],
    "nl": [
      "De Bistro du Couvent in Saint Prix, gevestigd in een voormalig klooster, biedt in de zomer zelfgemaakt ijs en drankjes, en in het weekend zoete en hartige snacks, ravioli gratins, salades en pizza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistro du couvent"
    ]
  },
