  "rdfs:comment": {
    "de": [
      "500 m von der Autobahnmautstelle Chambéry Nord, Ausfahrt Nr. 14 entfernt, leicht zugänglich, kostenloser Privatparkplatz\r\n5 Min. vom Stadtzentrum entfernt\r\n99 klimatisierte und schallisolierte Zimmer\r\nGroßer Park, Außenpool, Sauna\r\nRestaurant, Bar\r\nSeminarräume"
    ],
    "en": [
      "500m from the motorway toll “Chambery Nord”, exit n°14. Easy to get to, free private car park.\r\n5mn from the town centre, large park, 100 soundproofed and air-conditioned rooms.\r\nRestaurant, bar, reception room and outdoor swimming pool."
    ],
    "it": [
      "A 500 m dal casello autostradale di Chambéry Nord, uscita 14, facile accesso, parcheggio privato gratuito\r\n5 minuti dal centro città\r\n99 camere climatizzate e insonorizzate\r\nAmpio parco, piscina all'aperto, sauna\r\nRistorante e bar\r\nSale per seminari"
    ],
    "fr": [
      "À 500 m du péage autoroute Chambéry Nord, sortie n°14, facile d'accès, parking privé gratuit\r\nÀ 5 mn du centre ville\r\n99 chambres climatisées et insonorisées\r\nGrand parc, piscine extérieure, sauna\r\nRestaurant, bar\r\nSalles de séminaire"
    ],
    "es": [
      "A 500 m del peaje de la autopista Chambéry Nord, salida 14, fácil acceso, aparcamiento privado gratuito\r\nA 5 minutos del centro de la ciudad\r\n99 habitaciones climatizadas e insonorizadas\r\nGran parque, piscina exterior, sauna\r\nRestaurante y bar\r\nSalas de seminarios"
    ],
    "nl": [
      "500 m van het tolplein van de snelweg Chambéry Nord, afrit 14, gemakkelijke toegang, gratis privéparkeerplaats\r\n5 minuten van het stadscentrum\r\n99 geluiddichte kamers met airconditioning\r\nGroot park, buitenzwembad, sauna\r\nRestaurant en bar\r\nSeminariezalen"
    ]
  },
