  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Familienbetrieb, der Gerste anbaut, die wir zu Malz und dann zu Bier verarbeiten. Herstellung und Verkauf von handwerklich gebrauten Bieren."
    ],
    "en": [
      "Family farm producing barley, which we transform into malt and beer. Manufacture and sale of artisanal beers."
    ],
    "it": [
      "Azienda agricola a conduzione familiare che produce orzo, trasformato in malto e poi in birra. Produzione e vendita di birre artigianali."
    ],
    "fr": [
      "Entreprise agricole familiale produisant de l'orge, que nous transformons en malt puis en bière. Fabrication et vente de bières artisanales."
    ],
    "nl": [
      "Familiebedrijf dat gerst produceert, die we verwerken tot mout en vervolgens tot bier. Productie en verkoop van ambachtelijke bieren."
    ],
    "es": [
      "Explotación familiar productora de cebada, que transformamos en malta y luego en cerveza. Producción y venta de cervezas artesanales."
    ]
  },
