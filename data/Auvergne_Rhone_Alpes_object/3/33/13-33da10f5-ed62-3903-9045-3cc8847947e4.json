  "rdfs:comment": {
    "de": [
      "Inmitten der Weinberge mit Blick auf den Mont Granier stellen wir Ihnen unseren Empfangsraum in einem einladenden und entrückenden Rahmen inmitten der Natur zur Verfügung."
    ],
    "en": [
      "Right in the heart of the vineyards, with a view of Mont Granier, our reception room is at your disposal in a welcoming, natural setting."
    ],
    "it": [
      "Nel cuore dei vigneti con vista sul Mont Granier, la nostra sala ricevimenti è a vostra disposizione in un ambiente accogliente e rilassante nel cuore della natura."
    ],
    "fr": [
      "En plein cœur des vignes avec vue sur le Mont Granier, nous mettons à votre disposition notre salle de réception dans un cadre accueillant et dépaysant en pleine nature."
    ],
    "nl": [
      "In het hart van de wijngaarden met uitzicht op de Mont Granier staat onze receptieruimte tot je beschikking in een gastvrije en ontspannen omgeving midden in de natuur."
    ],
    "es": [
      "En pleno corazón de los viñedos y con vistas al Mont Granier, nuestra sala de recepción está a su disposición en un marco acogedor y relajante en plena naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de réception de l'Etang de la Tourne"
    ]
  },
