  "rdfs:comment": {
    "de": [
      "75 Parkplätze stehen gegenüber dem Parc Aquatique im Zentrum von Nyons zur Verfügung.\nKostenlose Parkplätze mit unbegrenztem Parkraum.\nÖffentliche Toiletten in der Nähe."
    ],
    "en": [
      "75 parking spaces are available opposite the Parc Aquatique in the center of Nyons.\nFree, unlimited parking.\nPublic WCs nearby."
    ],
    "it": [
      "75 posti auto sono disponibili di fronte al Parc Aquatique nel centro di Nyons\nParcheggio gratuito e illimitato.\nServizi igienici pubblici disponibili nelle vicinanze."
    ],
    "fr": [
      "75 places de parking sont disponibles en face du Parc Aquatique en plein centre de Nyons. \nParking gratuit au stationnement non-limité.\nPrésence de WC publics à proximité."
    ],
    "es": [
      "hay 75 plazas de aparcamiento disponibles frente al Parc Aquatique en el centro de Nyons\nAparcamiento gratuito y sin límite de plazas.\nHay aseos públicos en las inmediaciones."
    ],
    "nl": [
      "Er zijn 75 parkeerplaatsen beschikbaar tegenover het Parc Aquatique in het centrum van Nyons.\nGratis en onbeperkt parkeren.\nOpenbare toiletten in de buurt."
    ]
  },
