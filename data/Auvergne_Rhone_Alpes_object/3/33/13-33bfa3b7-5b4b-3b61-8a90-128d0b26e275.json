  "rdfs:comment": {
    "de": [
      "Der Geschmack von Käse im Herzen von Saint-Denis. In unserem Geschäft finden Sie eine große Auswahl an Käsesorten aus Frankreich und anderen Ländern. Lokale Produkte, hausgemachte Herstellungen, Feinkost.\r\nProdukte aus Etrez Butter und Sahne AOP... Besuchen Sie uns!"
    ],
    "en": [
      "A taste of cheese in the heart of Saint-Denis. You'll find a wide range of cheeses from France and beyond. Local products, home-made products, delicatessen.\r\nEtrez products, PDO butter and cream... Come and visit us!"
    ],
    "it": [
      "Un assaggio di formaggio nel cuore di Saint-Denis. Troverete una vasta gamma di formaggi provenienti dalla Francia e non solo. Prodotti locali, prodotti fatti in casa, gastronomia.\r\nBurro e panna di Etrez DOP... Venite a trovarci!"
    ],
    "fr": [
      "Le goût du fromage au cœur de Saint-Denis. Vous pouvez retrouver dans notre enseigne une grande variété de fromages de France et d'ailleurs. Produits locaux, fabrications maison, épicerie fine.\r\nProduits d'Etrez beurre et crème AOP... Rendez-nous visite !"
    ],
    "nl": [
      "Proef de kaas in het hart van Saint-Denis. Je vindt hier een breed scala aan kazen uit Frankrijk en daarbuiten. Streekproducten, huisgemaakte producten, delicatessen.\r\nBoter en roomproducten van Etrez BOB... Kom ons bezoeken!"
    ],
    "es": [
      "El sabor del queso en el corazón de Saint-Denis. Encontrará una amplia gama de quesos franceses y de otros países. Productos locales, productos caseros, delicatessen.\r\nMantequilla DOP Etrez y productos a base de nata... ¡Venga a visitarnos!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Käserei Saint-Denis-lès-Bourg"
    ],
    "en": [
      "Fromagerie Saint-Denis-lès-Bourg"
    ],
    "fr": [
      "Fromagerie Saint-Denis-lès-Bourg"
    ]
  },
