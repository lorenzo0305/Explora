  "rdfs:comment": {
    "de": [
      "Ihre Pizzeria Basilic & Co empfängt Sie 7 Tage die Woche mittags und abends im Stadtzentrum von RIOM. Entdecken Sie unsere regionalen Pizzen, die vor Ihren Augen zubereitet werden, aber auch Salate und handwerklich hergestellte Desserts. Wir verfügen über 34 Innenplätze und 26 Plätze auf der Terrasse."
    ],
    "en": [
      "Your pizzeria Basilic & Co welcomes you 7/7 for lunch and dinner in downtown RIOM. Discover our local pizzas, prepared before your very eyes, as well as salads and homemade desserts. We have 34 seats inside and 26 on the terrace."
    ],
    "it": [
      "La vostra pizzeria Basilic & Co vi accoglie 7 giorni su 7 per pranzo e cena nel centro di RIOM. Scoprite le nostre pizze locali, preparate davanti ai vostri occhi, così come le insalate e i dolci fatti in casa. Abbiamo 34 posti a sedere all'interno e 26 sulla terrazza."
    ],
    "fr": [
      "Votre pizzeria Basilic & Co vous accueille 7j/7 midi et soir dans le centre-ville de RIOM. Découvrez nos pizzas de terroirs, préparées sous vos yeux, mais aussi des salades, des desserts artisanaux. Nous disposons de 34 places intérieur et 26 en terrasse."
    ],
    "es": [
      "Su pizzería Basilic & Co le da la bienvenida los 7 días de la semana para almorzar y cenar en el centro de RIOM. Descubra nuestras pizzas locales, preparadas ante sus propios ojos, así como ensaladas y postres caseros. Disponemos de 34 plazas en el interior y 26 en la terraza."
    ],
    "nl": [
      "Pizzeria Basilic & Co verwelkomt je 7 dagen per week voor lunch en diner in het centrum van RIOM. Ontdek onze lokale pizza's, voor je ogen bereid, evenals salades en huisgemaakte desserts. We hebben 34 zitplaatsen binnen en 26 op het terras."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant - Basilic & Co"
    ]
  },
