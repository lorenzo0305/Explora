  "rdfs:comment": {
    "de": [
      "Traditionelle und familiäre Küche in einer gemütlichen Atmosphäre, gegenüber den Aiguilles Croches, Sektor Cote 2000, inmitten der Pisten.\r\n Zugang auf Skiern von Rochebrune aus und zu Fuß vom Parkplatz aus (30min)."
    ],
    "en": [
      "Traditional and family orientated cooking in a friendly ambiance, facing the Aiguilles Croches, in the middle of the ski slopes of the Cote 2000 sector.\r\nOpen in the evenings for groups, by reservation only. Access on skis from Rochebrune. Access from the carpark at 30min on foot."
    ],
    "it": [
      "Cucina tradizionale e famigliare in un ambiente accogliente, con vista sull'Aiguille Croche, settore Cote 2000, in mezzo alle piste.\r\nAperto la sera per i gruppi, su prenotazione. Accesso in sci da Rochebrune. Accesso a piedi dal parcheggio (30 minuti)."
    ],
    "fr": [
      "Cuisine traditionnelle et familiale dans une ambiance chaleureuse, face aux Aiguilles Croches, secteur Cote 2000, au milieu des pistes.\r\n Accès à ski depuis Rochebrune, et à pied depuis le parking (30min)."
    ],
    "nl": [
      "Traditionele familiekeuken in een warme sfeer, tegenover de Aiguilles Croches, sector Cote 2000, midden op de pistes.\r\n Toegang vanaf Rochebrune en te voet vanaf de parkeerplaats (30 min)."
    ],
    "es": [
      "Cocina tradicional familiar en un ambiente cálido, frente a las Aiguilles Croches, sector Cote 2000, a pie de pistas.\r\n Acceso para esquiadores desde Rochebrune, y a pie desde el aparcamiento (30min)."
    ]
  },
