  "rdfs:comment": {
    "de": [
      "Nehmen Sie an der Schnitzeljagd in Montbrun teil! Entdecken Sie mit Ihrer Familie das historische Zentrum von Montbrun und lüften Sie die Geheimnisse der alten Steine! Wenn Sie die verschiedenen Rätsel lösen, gewinnen Sie ein kleines Geschenk!"
    ],
    "en": [
      "Discover the Tresur Hunt  with your family, visit the  history center of Montbrun .\r\nIf you answer to the differents puzzles, you will win a little gift!"
    ],
    "it": [
      "Partecipate alla caccia al tesoro di Montbrun! Scoprite il centro storico di Montbrun in famiglia e scoprite i segreti delle vecchie pietre! Rispondendo ai vari indovinelli, vincerete un distintivo da collezionare!"
    ],
    "fr": [
      "Participez au jeu de piste de Montbrun ! Découvrez en famille le centre historique de Montbrun, venez percer les secrets des vieilles pierres ! En répondant aux différentes énigmes, vous gagnerez un badge à collectionner !"
    ],
    "es": [
      "¡Participe en la búsqueda del tesoro de Montbrun! Descubra en familia el centro histórico de Montbrun y los secretos de las viejas piedras Respondiendo a las diferentes adivinanzas, ¡ganarás una insignia para coleccionar!"
    ],
    "nl": [
      "Ontdek met de hele familie het historisch stadscentrum met onze schattenjacht !\r\nDoor te antwoorden op enkele vragen, winnen de kinderen een klein kado !"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tresur Hunt in Montbrun les Bains"
    ],
    "fr": [
      "Jeu de piste : balade ludique pour petits et grands à Montbrun les Bains"
    ],
    "nl": [
      "Schattenjacht en Montbrun"
    ]
  },
