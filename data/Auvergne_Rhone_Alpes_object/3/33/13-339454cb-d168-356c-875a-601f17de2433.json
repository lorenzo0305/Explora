  "rdfs:comment": {
    "de": [
      "Vélo du Lac Vieille Ville, ganz dem Fahrradverleih gewidmet, ideal gelegen am Ausgang der Altstadt (neben der Schiffsgesellschaft) und 30 Meter vom Fahrradweg entfernt."
    ],
    "en": [
      "Vélo du Lac Vieille Ville, entirely dedicated to bicycle rental, ideally located just outside the old town (next to the boat company) and 30 meters from the cycle path."
    ],
    "it": [
      "Vélo du Lac Vieille Ville, interamente dedicato al noleggio di biciclette, situato in posizione ideale appena fuori dalla città vecchia (accanto alla compagnia di navigazione) e a 30 metri dalla pista ciclabile."
    ],
    "fr": [
      "Vélo du Lac Vieille Ville, entièrement dédié à la location de vélos idéalement situé à la sortie de la vieille ville (à côté de la compagnie des bateaux) et à 30 mètres de la piste cyclable."
    ],
    "nl": [
      "Vélo du Lac Vieille Ville, volledig gewijd aan fietsverhuur, ideaal gelegen net buiten de oude stad (naast het bootbedrijf) en op 30 meter van het fietspad."
    ],
    "es": [
      "Vélo du Lac Vieille Ville, enteramente dedicado al alquiler de bicicletas, idealmente situado a las afueras del casco antiguo (junto a la compañía de barcos) y a 30 metros del carril bici."
    ]
  },
