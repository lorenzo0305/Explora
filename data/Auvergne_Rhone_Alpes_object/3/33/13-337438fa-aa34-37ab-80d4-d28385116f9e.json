  "rdfs:comment": {
    "de": [
      "Genießen Sie eine gesellige Küche: Tagesmenü montags, donnerstags und freitags zum Mittagessen. Frösche auf Reservierung an Abenden und Wochenenden. Sonntagabend gibt es ein ländliches Menü. Karaoke von Oktober bis April und Gruppenmenüs möglich. Reservierung empfohlen."
    ],
    "en": [
      "Enjoy a convivial cuisine: daily menu Mondays, Thursdays and Fridays for lunch. Frogs on reservation evenings and weekends. Sunday evenings: country-style menu. Karaoke from October to April and group menus available. Reservations recommended."
    ],
    "it": [
      "Assaporate la nostra cucina conviviale: menù giornaliero lunedì, giovedì e venerdì a pranzo. Rane su prenotazione la sera e il fine settimana. Domenica sera: menu in stile rustico. Karaoke da ottobre ad aprile e menù per gruppi. Si consiglia la prenotazione."
    ],
    "fr": [
      "Savourez une cuisine conviviale : menu du jour les lundis, jeudis et vendredis midi. Grenouilles sur réservation les soirs et week-ends. Dimanche soir, place au menu campagnard. Karaoké d’octobre à avril et menus groupes possible. Réservation conseillée."
    ],
    "es": [
      "Saboree nuestra acogedora cocina: menú diario los lunes, jueves y viernes al mediodía. Ranas en las noches de reserva y los fines de semana. Domingos por la noche: menú campestre. Karaoke de octubre a abril y menús para grupos. Se recomienda reservar."
    ],
    "nl": [
      "Geniet van onze vriendelijke keuken: dagmenu op maandag, donderdag en vrijdag voor de lunch. Kikkers op reservering 's avonds en in het weekend. Zondagavond: landelijk menu. Karaoke van oktober tot april en groepsmenu's beschikbaar. Reserveren aanbevolen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de la Source"
    ]
  },
