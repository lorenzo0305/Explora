  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Animationen rund um Pflanzen mit Mapie, einer in Notre Dame de Bellecombe niedergelassenen Kräuterfrau: Balsame, Kräutertees, ätherische Öle, Tugenden von Heilpflanzen."
    ],
    "en": [
      "Join Mapie, a herbalist based in Notre Dame de Bellecombe, for a range of plant-related activities, including balms, herbal teas, essential oils and the virtues of medicinal plants."
    ],
    "it": [
      "Unitevi a Mapie, erborista di Notre Dame de Bellecombe, per una serie di attività legate alle piante, tra cui balsami, tisane, oli essenziali e le virtù delle piante medicinali."
    ],
    "fr": [
      "Venez découvrir les animations autour des plantes avec Mapie, herbaliste installée à Notre Dame de Bellecombe : baumes, tisanes, huiles essentielles, vertus des plantes médicinales."
    ],
    "es": [
      "Únase a Mapie, una herborista afincada en Notre Dame de Bellecombe, para realizar una serie de actividades relacionadas con las plantas, como bálsamos, infusiones, aceites esenciales y las virtudes de las plantas medicinales."
    ],
    "nl": [
      "Doe mee met Mapie, een kruidendokter uit Notre Dame de Bellecombe, voor een reeks plantgerelateerde activiteiten, waaronder balsems, kruidenthee, essentiële oliën en de deugden van geneeskrachtige planten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Le grenier aux plantes de Mapie"
    ],
    "en": [
      "Le grenier aux plantes de Mapie"
    ],
    "fr": [
      "Le grenier aux plantes de Mapie"
    ]
  },
