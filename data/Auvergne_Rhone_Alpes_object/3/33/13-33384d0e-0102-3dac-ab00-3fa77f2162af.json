  "rdfs:comment": {
    "de": [
      "Als Bergführer aus Chamroussien, der seit über 25 Jahren tätig ist, werde ich Sie mit Schneeschuhen an wilden und geheimen Stimmungen teilhaben lassen... Die winterliche Natur in ihrem rohen Zustand!"
    ],
    "en": [
      "As a local hiking guide for 25 years, I will share with you a wild and secret snowshoeing hikes... in an authentic winter nature !"
    ],
    "it": [
      "Sono una guida alpina di Chamroussian da oltre 25 anni e condividerò con voi, con le racchette da neve, atmosfere selvagge e segrete... La natura invernale allo stato grezzo!"
    ],
    "fr": [
      "Accompagnateur en Montagne Chamroussien depuis plus de 25 ans, je vous ferai partager en raquettes à neige des ambiances sauvages et secrètes... La nature hivernale à l’état brut !"
    ],
    "es": [
      "Desde hace más de 25 años soy guía de montaña de Chamroussian. Compartiré con usted, sobre raquetas de nieve, ambientes salvajes y secretos... La naturaleza invernal en estado puro"
    ],
    "nl": [
      "Als Chamroussische berggids voor meer dan 25 jaar, zal ik met u, op sneeuwschoenen, wilde en geheime sferen delen... Winter natuur in zijn ruwe staat!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Olivier BIZET/ Schneeschuhwanderungen inmitten unberührter Natur"
    ],
    "en": [
      "Olivier BIZET/ Snowshoeing in the heart of unspoilt nature"
    ],
    "fr": [
      "Olivier BIZET/ Balades en raquettes au cœur d’une nature préservée"
    ]
  },
