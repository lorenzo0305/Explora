  "rdfs:comment": {
    "de": [
      "Restaurant am Ufer der Saône in einer ruhigen und grünen Umgebung. Hier können Sie Ukelei-Fritüre, Froschfrikassee oder das ausgezeichnete Bresse-Geflügel probieren!"
    ],
    "en": [
      "Restaurant located on the banks of the Saône in a quiet, leafy setting, where you can enjoy fried bleak, frog fricassee or excellent Bresse poultry!"
    ],
    "it": [
      "Ristorante situato sulle rive della Saona in un ambiente tranquillo e verdeggiante, dove potrete gustare alborelle fritte, fricassea di rane o ottimo pollame di Bresse!"
    ],
    "fr": [
      "Restaurant situé au bord de la Saône dans un cadre calme et verdoyant pour déguster la friture d'ablettes, la fricassée de grenouilles ou l'excellente volaille de bresse !"
    ],
    "es": [
      "Restaurante situado a orillas del Saona, en un entorno tranquilo y frondoso, donde podrá degustar sombrío frito, fricasé de rana o excelentes aves de corral de Bresse"
    ],
    "nl": [
      "Restaurant gelegen aan de oevers van de Saône in een rustige, lommerrijke omgeving, waar u kunt genieten van gebakken alver, kikkerfricassee of uitstekend Bresse gevogelte!"
    ]
  },
