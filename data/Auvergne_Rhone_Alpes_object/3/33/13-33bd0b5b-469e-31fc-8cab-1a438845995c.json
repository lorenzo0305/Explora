  "rdfs:comment": {
    "de": [
      "Graines de Rencontres ist sowohl der Sitz - Büro von Mirlitoons als auch eine kulturelle Programmaktion, die sich zeitgenössischen Kreationen und Schriften der darstellenden, grafischen und plastischen Künste widmet."
    ],
    "en": [
      "Graines de Rencontres is both the headquarters and office of Mirlitoons and a cultural programming action, dedicated to contemporary creations and writings in the performing, graphic and plastic arts."
    ],
    "it": [
      "Graines de Rencontres è sia l'ufficio di Mirlitoons che un'azione di programmazione culturale, dedicata a creazioni e scritture contemporanee nelle arti performative, grafiche e plastiche."
    ],
    "fr": [
      "Graines de Rencontres est à la fois le siège – bureau de Mirlitoons et une action de programmation culturelle, dédiée aux créations et écritures contemporaines des arts vivants, graphiques et plastiques."
    ],
    "nl": [
      "Graines de Rencontres is zowel de zetel en het kantoor van Mirlitoons als een cultureel programma gewijd aan hedendaagse creaties en geschriften in de podiumkunsten, grafische en plastische kunsten."
    ],
    "es": [
      "Graines de Rencontres es a la vez la oficina de Mirlitoons y una acción de programación cultural, dedicada a las creaciones y escrituras contemporáneas en las artes escénicas, gráficas y plásticas."
    ]
  },
