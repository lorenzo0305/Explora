  "rdfs:comment": {
    "de": [
      "Das Bistrot du Pontias ist ein Bar-Restaurant, das das ganze Jahr über Getränke und Speisen anbietet. Wir verfügen über eine große Auswahl an Getränken und lokalen Gerichten sowie über eine Außenterrasse und einen Innenraum."
    ],
    "en": [
      "Le Bistrot du Pontias is a bar-restaurant offering drinks and food all year round. We offer a wide choice of drinks and local dishes, as well as an outdoor terrace and an indoor dining room."
    ],
    "it": [
      "Il Bistrot du Pontias è un bar-ristorante che offre bevande e cibo tutto l'anno. Offriamo una vasta gamma di bevande e piatti locali, oltre a una terrazza all'aperto e una sala da pranzo interna."
    ],
    "fr": [
      "Le Bistrot du Pontias est un bar-restaurant proposant boissons et restauration toute l'année. Nous disposons d'un large choix de boissons et de plats locaux, ainsi que d'une terrasse extérieure et d'une salle intérieure."
    ],
    "es": [
      "El Bistrot du Pontias es un bar-restaurante que ofrece bebidas y comida durante todo el año. Ofrecemos una amplia gama de bebidas y platos locales, así como una terraza al aire libre y un comedor interior."
    ],
    "nl": [
      "De Bistrot du Pontias is een bar-restaurant waar je het hele jaar door kunt eten en drinken. We bieden een breed scala aan drankjes en lokale gerechten, evenals een buitenterras en een eetzaal binnen."
    ]
  },
  "rdfs:label": {
