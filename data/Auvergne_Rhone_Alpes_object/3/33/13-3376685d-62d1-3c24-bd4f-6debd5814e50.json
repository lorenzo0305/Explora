  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Restaurantangebot von Ain'sTemps?Loisirs.\r\nEingebettet im Herzen von Plans d'Hotonnes auf dem Plateau de Retord: ein Gourmet-Erlebnis in einer natürlichen Umgebung, die neue Energie spendet."
    ],
    "en": [
      "Discover the dining options offered by Ain'sTempsLoisirs.\r\nNestled in the heart of the Plans d'Hotonnes on the Retord Plateau: a gourmet experience in a revitalizing natural setting."
    ],
    "it": [
      "Scoprite la gamma di ristoranti offerti da Ain'sTemps?Loisirs.\r\nNel cuore di Les Plans d'Hotonnes, sul Plateau de Retord: un'esperienza gastronomica in un ambiente naturale rigenerante."
    ],
    "fr": [
      "Découvrez l’offre de restauration proposée par Ain'sTemps Loisirs.\r\nNiché au cœur des Plans d’Hotonnes sur le Plateau de Retord : une expérience gourmande dans un décor naturel ressourçant."
    ],
    "nl": [
      "Ontdek het aanbod aan restaurants van Ain's Temps Loisirs.\r\nGenesteld in het hart van Les Plans d'Hotonnes op het Plateau de Retord: een gastronomische ervaring in een verjongende natuurlijke omgeving."
    ],
    "es": [
      "Descubra la oferta de restauración de Ain'sTemps-Loisirs.\r\nEn pleno corazón de Les Plans d'Hotonnes, en la meseta de Retord: una experiencia gastronómica en un entorno natural rejuvenecedor."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ain'sTemps Loisirs Café in Les Plans d'Hotonnes"
    ],
    "fr": [
      "Ain's Temps Loisirs : petite restauration aux Plans d'Hotonnes"
    ]
  },
