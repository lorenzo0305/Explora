  "rdfs:comment": {
    "de": [
      "Ein Weg mit vielen Facetten und ohne besondere Schwierigkeiten. Nehmen Sie sich also die Zeit, die Schilder des botanischen Pfades von Rozier-en-Donzy zu betrachten."
    ],
    "en": [
      "A multi-faceted trail with no particular difficulties. Take the time to look at the information panels on the Rozier-en-Donzy botanical trail."
    ],
    "it": [
      "Un percorso poliedrico che non presenta particolari difficoltà. Prendetevi il tempo di osservare i cartelli esplicativi del sentiero botanico di Rozier-en-Donzy."
    ],
    "fr": [
      "Parcours aux multiples facettes et sans difficulté particulière. Prenez donc le temps d’observer au passage les panneaux explicatifs du sentier botanique de Rozier-en-Donzy."
    ],
    "es": [
      "Un sendero polifacético sin dificultades particulares. Tómese su tiempo para observar los carteles explicativos del sendero botánico de Rozier-en-Donzy."
    ],
    "nl": [
      "Een veelzijdig pad zonder bijzondere moeilijkheden. Neem de tijd om de borden met uitleg over het botanische pad in Rozier-en-Donzy te bekijken."
    ]
  },
