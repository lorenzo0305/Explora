  "rdfs:comment": {
    "de": [
      "In Saint-Pierre-d?Albigny, in der Nähe der großen Radwege der Combe de Savoie, bietet der Fahrradstopp eine bequeme und praktische Pause für Radtouristen in einer natürlichen und geselligen Umgebung."
    ],
    "en": [
      "Located in Saint-Pierre-d?Albigny, close to the major cycle routes of the Combe de Savoie region, the bicycle stop-off area offers cyclists a comfortable and practical break in a natural and friendly setting."
    ],
    "it": [
      "Situato a Saint-Pierre-d'Albigny, vicino ai principali percorsi ciclabili della regione della Combe de Savoie, il ciclostazione offre ai ciclisti una sosta comoda e pratica in un ambiente naturale e accogliente."
    ],
    "fr": [
      "Située à Saint-Pierre-d’Albigny, à proximité des grands itinéraires cyclables de la Combe de Savoie, l’aire d’arrêt vélo offre une pause confortable et pratique aux cyclotouristes, dans un cadre naturel et convivial."
    ],
    "es": [
      "Situada en Saint-Pierre-d'Albigny, cerca de las principales rutas ciclistas de la región de Combe de Savoie, la parada ciclista ofrece a los ciclistas un descanso cómodo y práctico en un entorno natural y acogedor."
    ],
    "nl": [
      "Gelegen in Saint-Pierre-d?Albigny, dicht bij de belangrijkste fietsroutes in de regio Combe de Savoie, biedt de fietsstop fietsers een comfortabele en praktische pauze in een natuurlijke en vriendelijke omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de service vélo du Lac de Carouge"
    ]
  },
