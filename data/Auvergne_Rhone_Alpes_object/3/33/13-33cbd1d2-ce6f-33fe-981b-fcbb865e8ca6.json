  "rdfs:comment": {
    "de": [
      "Dieser 1 km lange \"Nehmen und Loslassen\"-Parcours befindet sich am Eingang der Maurienne unterhalb des Staudamms von Bramans und versetzt Sie in eine unvergleichliche Atmosphäre im Inneren der Avrieux-Schlucht."
    ],
    "en": [
      "Located at the entrance to the Maurienne, under the Bramans dam, this 1 km \"take and release\" course plunges you into an incomparable atmosphere inside the Avrieux gorges."
    ],
    "it": [
      "Situato all'ingresso della Maurienne, sotto la diga di Bramans, questo percorso di 1 km \"take and release\" vi immerge in un'atmosfera incomparabile all'interno delle gole di Avrieux."
    ],
    "fr": [
      "Situé à l'entrée de la Maurienne, sous le barrage de Bramans, ce parcours \"prendre et relâcher\" de 1 km vous plonge dans une ambiance incomparable à l'intérieur des gorges d'Avrieux."
    ],
    "es": [
      "Situado a la entrada de la Maurienne, bajo la presa de Bramans, este recorrido de \"toma y suelta\" de 1 km le sumerge en una atmósfera incomparable en el interior de las gargantas de Avrieux."
    ],
    "nl": [
      "Gelegen aan de ingang van de Maurienne, onder de Bramans dam, dompelt dit 1 km lange \"take and release\" parcours u onder in een onvergelijkbare sfeer binnen de Avrieux kloven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de pêche « Prendre et relâcher » sur l’Arc à Aussois"
    ],
    "nl": [
      "Visroute \"Catch and Release\" op de Arc van Aussois"
    ]
  },
