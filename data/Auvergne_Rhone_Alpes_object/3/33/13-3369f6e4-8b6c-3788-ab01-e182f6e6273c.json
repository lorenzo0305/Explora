  "rdfs:comment": {
    "de": [
      "Entdecken Sie anhand von Modellen, Rekonstruktionszeichnungen und interaktiven Vorrichtungen die Geschichte des Schlosses der Herzöge von Savoyen, einem Ort der Macht gestern und heute. Vermittler des Kulturerbes empfangen Sie und beantworten Ihre Fragen."
    ],
    "en": [
      "Discover the history of the Château des Ducs de Savoie, a place of power past and present, with models, reconstruction drawings and interactive displays. Heritage mediators welcome you and answer your questions."
    ],
    "it": [
      "Scoprite la storia del Castello dei Duchi di Savoia, luogo di potere di allora e di oggi, grazie a modelli, disegni di ricostruzione e display interattivi. I mediatori del patrimonio sono a disposizione per accogliervi e rispondere alle vostre domande."
    ],
    "fr": [
      "Découvrez l'histoire du château des ducs de Savoie, lieu de pouvoir hier et aujourd'hui, grâce à des maquettes, dessins de reconstitution et dispositifs interactifs. Des médiateurs du patrimoine vous accueillent et répondent à vos questions."
    ],
    "nl": [
      "Ontdek de geschiedenis van het Château des Ducs de Savoie, een plek van macht toen en nu, dankzij maquettes, reconstructietekeningen en interactieve displays. Erfgoedbemiddelaars staan klaar om je te verwelkomen en je vragen te beantwoorden."
    ],
    "es": [
      "Descubra la historia del Castillo de los Duques de Saboya, lugar de poder antes y ahora, gracias a maquetas, dibujos de reconstrucción y exposiciones interactivas. Los mediadores del patrimonio le darán la bienvenida y responderán a sus preguntas."
    ]
  },
