  "rdfs:comment": {
    "de": [
      "Gemütlicher Rahmen. Südterrasse mit Panoramablick. Spezialitäten aus Savoyen. Traditionelle Küche. Im Ortszentrum zwischen Piccard sports und Sport 2000. Frühstück, Snacks, Crêpes, Waffeln, Restaurant und Bar."
    ],
    "en": [
      "Warm and mountain setting. Room and panoramic terrace. Savoyard specialties. Traditional cuisine. In the resort center between Piccard Sports and Sport 2000. Breackfast, snacks, restaurant and bar."
    ],
    "it": [
      "Caldo, ambiente montano. Camera e terrazza panoramica. Specialità savoiarde. Cucina tradizionale. Nel centro della località tra Piccard Sports e Sport 2000. Colazioni, snack, frittelle, waffle, ristorante e bar."
    ],
    "fr": [
      "Cadre chaleureux. Terrasse plein sud avec panoramique. Spécialités savoyardes. Cuisine traditionnelle. En centre station entre Piccard sports et Sport 2000. Petits déjeuners, goûters, crêpes, gaufres, restaurant et bar."
    ],
    "nl": [
      "Warm en bergachtig. Kamer en panoramisch terras. Savoyaardse specialiteiten. Traditionele keuken. In het centrum van het resort tussen Piccard Sports en Sport 2000. Ontbijt, snacks, restaurant en bar."
    ],
    "es": [
      "Entorno acogedor. Terraza orientada al sur con vistas panorámicas. Especialidades saboyanas. Cocina tradicional. En el centro de la estación, entre Piccard sports y Sport 2000. Desayunos, meriendas, crepes, gofres, restaurante y bar."
    ]
  },
