  "rdfs:comment": {
    "de": [
      "Verbringen Sie ein paar Tage in einem der 3 35 m² großen Holzchalets auf einem kleinen ländlichen Campingplatz am Ufer des Flusses Albarine. Angelsee vor Ort."
    ],
    "en": [
      "Come and spend a few days in one of the 3 35 m² wooden chalets located in a small rural campsite on the banks of the Albarine. Fishing lake on site."
    ],
    "it": [
      "Venite a trascorrere qualche giorno in uno dei 3 chalet in legno (35 m²) situati in un piccolo campeggio rurale sulle rive dell'Albarine. Lago di pesca in loco."
    ],
    "fr": [
      "Venez passer quelques jours dans l’un des 3 chalets bois de 35 m² situés dans un petit camping rural en bordure de l'Albarine. Plan d’eau de pêche sur place."
    ],
    "es": [
      "Venga a pasar unos días en uno de los 3 chalets de madera de 35 m² situados en un pequeño camping rural a orillas del Albarine. Lago de pesca en el lugar."
    ],
    "nl": [
      "Kom een paar dagen logeren in een van de 3 houten chalets (35 m²) op een kleine, landelijke camping aan de oever van de Albarine. Visvijver ter plaatse."
    ]
  },
  "rdfs:label": {
    "de": [
