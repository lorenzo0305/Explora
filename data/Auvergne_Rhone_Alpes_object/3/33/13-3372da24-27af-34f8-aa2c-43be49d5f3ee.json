  "rdfs:comment": {
    "de": [
      "Der Fluss Teyssonne entspringt in der Nähe von Saint Bonnet des Quarts. Im oberen Teil des Flusses gibt es eine gute Population von wilden Bachforellen. Da der Fluss nur wenige Meter breit ist, sollten Sie eher auf \"Tock\" angeln."
    ],
    "en": [
      "The Teyssonne rises around Saint Bonnet des Quarts. On the upstream section, the river has a good population of wild fario trout. The river is only a few meters wide, so prefer to fish with toc."
    ],
    "it": [
      "Il Teyssonne nasce nei pressi di Saint Bonnet des Quarts. A monte, il fiume ospita una buona popolazione di trote fario selvatiche. Il fiume è largo solo pochi metri, quindi è preferibile pescare con il toc."
    ],
    "fr": [
      "La Teyssonne prend sa source vers saint Bonnet des Quarts. Sur la partie amont, la rivière possède une belle population de truites fario sauvages. La rivière étant large de quelques mètres, privilégiez donc plus la pêche \"au toc\"."
    ],
    "es": [
      "El Teyssonne nace cerca de Saint Bonnet des Quarts. Aguas arriba, el río cuenta con una buena población de truchas fario salvajes. El río sólo tiene unos metros de ancho, así que prefiera pescar con un toc."
    ],
    "nl": [
      "De Teyssonne ontspringt in de buurt van Saint Bonnet des Quarts. Stroomopwaarts heeft de rivier een goede populatie wilde fario-forel. De rivier is maar een paar meter breed, dus vis bij voorkeur met een toc."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Teyssonne"
    ]
  },
