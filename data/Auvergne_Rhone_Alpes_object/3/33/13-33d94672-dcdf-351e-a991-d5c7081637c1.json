  "rdfs:comment": {
    "de": [
      "Seit Dezember 2024 ist La Petite Pizzeria stolz darauf, großartigen Menschen köstliche Pizzen zu servieren. Wir bieten am selben Tag frisch zubereitete Pizzen zum Mitnehmen an."
    ],
    "en": [
      "Since December 2024, La Petite Pizzeria takes pride in serving great pizzas to great people. We offer pizzas made fresh on the day to take away."
    ],
    "it": [
      "Dal dicembre 2024, La Petite Pizzeria è orgogliosa di servire pizze deliziose a persone fantastiche. Offriamo pizze fresche da asporto in giornata."
    ],
    "fr": [
      "Depuis décembre 2024, La Petite Pizzeria est fière de servir de délicieuses pizzas à des gens formidables. Nous proposons des pizzas fraîchement préparées le jour même à emporter."
    ],
    "nl": [
      "Sinds december 2024 serveert La Petite Pizzeria met trots heerlijke pizza's aan geweldige mensen. Wij bieden dagverse pizza's om mee te nemen."
    ],
    "es": [
      "Desde diciembre de 2024, La Petite Pizzeria se enorgullece de servir deliciosas pizzas a gente estupenda. Ofrecemos pizzas recién hechas el mismo día para llevar."
    ]
  },
