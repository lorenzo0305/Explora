  "rdfs:comment": {
    "de": [
      "Das archäologische Museum in Hières-sur-Amby, das unterhalb der Ausgrabungsstätte Larina liegt, zeigt anhand seiner Sammlungen die Geschichte der Besiedlung der Isle-Crémieu von der Mitte der Vorgeschichte bis zum frühen Mittelalter."
    ],
    "en": [
      "The Hières-sur-Amby archaeological museum, located below the Larina site, uses its collections to present the history of settlement on the Isle Crémieu, from prehistoric times to the early Middle Ages."
    ],
    "it": [
      "Il museo archeologico di Hières-sur-Amby, situato sotto il sito di Larina, utilizza le sue collezioni per presentare la storia degli insediamenti nella regione dell'Isle-Crémieu, dalla preistoria all'alto Medioevo."
    ],
    "fr": [
      "Le musée archéologique de Hières-sur-Amby, situé en contrebas du site de Larina, présente à travers ses collections l’histoire du peuplement en Isle-Crémieu, du milieu de la Préhistoire au début du Moyen-Age."
    ],
    "nl": [
      "Het archeologisch museum van Hières-sur-Amby, gelegen onder de site van Larina, gebruikt zijn collecties om de geschiedenis van de nederzettingen in de regio Isle-Crémieu te presenteren, van de prehistorie tot de vroege middeleeuwen."
    ],
    "es": [
      "El museo arqueológico de Hières-sur-Amby, situado bajo el yacimiento de Larina, presenta con sus colecciones la historia de los asentamientos de la región de Isle-Crémieu, desde la prehistoria hasta la Alta Edad Media."
    ]
  },
