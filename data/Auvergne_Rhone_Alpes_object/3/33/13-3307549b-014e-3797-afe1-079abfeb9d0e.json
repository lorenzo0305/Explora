  "rdfs:comment": {
    "de": [
      "Entdecken Sie ein Spiel in Lebensgröße mit diesem permanenten Orientierungsparcours, der Geschichte und Kulturerbe im Herzen des Parks der Domaine de Vizille verbindet. Parcours nur auf dem Gelände des Parks."
    ],
    "en": [
      "Discover a life-size game with this permanent orientation course combining history and heritage in the heart of the Domaine de Vizille park. Course only within the grounds of the park."
    ],
    "it": [
      "Un percorso alla scoperta del patrimonio naturale del Parc de Vizille, che comprende alcuni degli straordinari alberi della tenuta.  Disponibile solo all'interno del parco."
    ],
    "fr": [
      "Un parcours pour découvrir le patrimoine naturel du Parc de Vizille et notamment quelques-uns des arbres remarquables du domaine.  Parcours uniquement dans l’enceinte du parc."
    ],
    "nl": [
      "Een parcours om het natuurlijke erfgoed van het Parc de Vizille te ontdekken, waaronder enkele opmerkelijke bomen van het landgoed.  Alleen beschikbaar in het park."
    ],
    "es": [
      "Descubra un juego a escala real con este recorrido de orientación permanente que combina historia y patrimonio en el corazón del parque Domaine de Vizille. El recorrido solo está disponible dentro del parque."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation patrimoine naturel"
    ]
  },
