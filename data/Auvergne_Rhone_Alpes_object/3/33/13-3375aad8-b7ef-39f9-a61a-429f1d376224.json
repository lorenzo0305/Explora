  "rdfs:comment": {
    "de": [
      "In einem kleinen Tierpark können Sie sich dem Damwild nähern. Dieser Park ist öffentlich und frei zugänglich. Wir möchten Sie daran erinnern, dass es verboten ist, die Tiere zu füttern."
    ],
    "en": [
      "A small animal park lets you get close to fallow deer. This park is open to the public. We remind you that it is forbidden to feed the animals."
    ],
    "it": [
      "Il parco dei piccoli animali offre la possibilità di avvicinarsi ai cervi. Questo parco è aperto al pubblico. È vietato dare da mangiare agli animali."
    ],
    "fr": [
      "Un petit parc animalier vous permet d'approcher des daims. Ce parc est public et en accès libre. Nous vous rappelons qu'il est interdit de nourrir les animaux."
    ],
    "es": [
      "Un parque de animales pequeños le brinda la oportunidad de acercarse a los ciervos. Este parque está abierto al público. Tenga en cuenta que está prohibido dar de comer a los animales."
    ],
    "nl": [
      "In een klein dierenpark kunt u damherten van dichtbij bekijken. Dit park is open voor het publiek en gratis toegankelijk. Wij herinneren u eraan dat het verboden is de dieren te voeren."
    ]
  },
  "rdfs:label": {
