  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument auf Anfrage der Schlüssel im Rathaus. Die Pfarrkirche ist ein Priorat und Pfarrhaus, das auf dem Gipfel eines Hügels über dem Zusammenfluss von Bieudre und Allier errichtet wurde."
    ],
    "en": [
      "Free visit with document on request of the keys at the town hall. The parish church is a priory-cure built on top of a mound which dominates the confluence of the Bieudre and the Allier rivers."
    ],
    "it": [
      "Visita gratuita con documento su richiesta delle chiavi presso il municipio. La chiesa parrocchiale è un priorato-cura costruito sulla sommità di un tumulo che domina la confluenza dei fiumi Bieudre e Allier."
    ],
    "fr": [
      "Visite libre avec document sur demande des clés à la mairie. L'église paroissiale est un prieuré-cure construit au sommet d'un monticule qui domine la confluence de la Bieudre et de l'Allier."
    ],
    "es": [
      "Visita gratuita con documento a petición de las llaves en el ayuntamiento. La iglesia parroquial es un priorato-cura construido sobre un montículo que domina la confluencia de los ríos Bieudre y Allier."
    ],
    "nl": [
      "Gratis bezoek met document op aanvraag van de sleutels op het stadhuis. De parochiekerk is een priorij-kerk gebouwd op een heuvel met uitzicht op de samenvloeiing van de Bieudre en de Allier."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Maurice"
    ]
  },
