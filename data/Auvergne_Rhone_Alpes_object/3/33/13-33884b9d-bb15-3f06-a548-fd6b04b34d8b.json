  "rdfs:comment": {
    "de": [
      "Kunsthandwerkliche Kreationen zu Dekorations- und Gebrauchszwecken in Blanzat. Ausstellungsladen und individuelle Arbeiten auf Bestellung.\r\nClaude Tinet bietet auch Einführungskurse für Erwachsene und Kinder an, um das Emaillieren auf Lavastein zu entdecken."
    ],
    "en": [
      "Decorative and utilitarian crafts in Blanzat. Showroom and personalized work to order.\r\nClaude Tinet also offers introductory courses for adults and children in lava stone enameling."
    ],
    "it": [
      "Artigianato decorativo e utilitario a Blanzat. Negozio espositivo e lavori personalizzati su ordinazione.\r\nClaude Tinet propone anche corsi di introduzione alla smaltatura su pietra lavica per adulti e bambini."
    ],
    "fr": [
      "Créations artisanales décoratives et utilitaires à Blanzat. Boutique d’expo et travaux personnalisés sur commande.\r\nClaude Tinet propose aussi des stages d’initiation pour adultes et enfants afin de découvrir l’émaillage sur pierre de lave."
    ],
    "nl": [
      "Decoratieve en utilitaire ambachten in Blanzat. Tentoonstellingswinkel en gepersonaliseerd werk op bestelling.\r\nClaude Tinet biedt ook inleidende cursussen voor volwassenen en kinderen om het emailleren op lavasteen te ontdekken."
    ],
    "es": [
      "Artesanía decorativa y utilitaria en Blanzat. Tienda exposición y trabajos personalizados por encargo.\r\nClaude Tinet también ofrece cursos de iniciación para adultos y niños para descubrir el esmaltado sobre piedra de lava."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de lave émaillée En Dessous du Volcan - Claude Tinet"
    ]
  },
