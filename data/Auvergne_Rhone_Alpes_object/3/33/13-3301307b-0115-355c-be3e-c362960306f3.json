  "rdfs:comment": {
    "de": [
      "In einem charmanten Dorf bietet Ihnen unser Restaurant eine hausgemachte Küche aus frischen Produkten, die Tradition und Kreativität in einem gepflegten und gemütlichen Rahmen vereint. Aufmerksamer Service, gesellige Atmosphäre, eine reichhaltige und erschwingliche Weinkarte."
    ],
    "en": [
      "Set in a charming village, our restaurant offers home-cooked cuisine based on fresh produce, blending tradition and creativity in a warm, well-kept setting. Attentive service, friendly atmosphere and a rich, affordable wine list."
    ],
    "it": [
      "Situato in un incantevole villaggio, il nostro ristorante offre una cucina casalinga a base di prodotti freschi, combinando tradizione e creatività in un ambiente caldo e curato. Servizio attento, atmosfera amichevole e una carta dei vini ampia e conveniente."
    ],
    "fr": [
      "Dans un charmant village, notre restaurant vous propose une cuisine faite maison à base de produits frais, mêlant tradition et créativité dans un cadre soigné et chaleureux. Service attentionné, ambiance conviviale, une carte des vins riche et abordable."
    ],
    "es": [
      "Situado en un pueblo con encanto, nuestro restaurante ofrece platos caseros a base de productos frescos, combinando tradición y creatividad en un ambiente cálido y cuidado. Servicio atento, ambiente agradable y una carta de vinos amplia y asequible."
    ],
    "nl": [
      "Ons restaurant ligt in een charmant dorp en biedt huisgemaakte maaltijden op basis van verse producten, een combinatie van traditie en creativiteit in een warme, verzorgde omgeving. Attente bediening, vriendelijke sfeer en een uitgebreide, betaalbare wijnkaart."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant le Saint Michel"
    ]
  },
