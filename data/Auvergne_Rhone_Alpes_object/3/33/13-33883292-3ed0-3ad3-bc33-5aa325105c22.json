  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Heritage-Orientierungslauf von Valezan-Montméry!\r\nEntdecken Sie diese beiden typischen Weiler des Versant du Soleil.\r\nEine Strecke von 3,3km mit 150mD+ und 9 Markierungen."
    ],
    "en": [
      "Welcome to the orienteering course focusing on the heritage of Valezan!-Montméry!\r\nDiscover these two traditional hamlets on the Versant du Soleil.\r\nA course of 3.3 km and 150m elevation gain, with 9 markers."
    ],
    "it": [
      "Benvenuti al corso di orientamento al patrimonio Valezan-Montméry!\r\nScoprite questi due borghi tipici del Versant du Soleil.\r\nUn percorso di 3,3 km con 150 mD+ e 9 marcatori."
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation patrimoine de Valezan-Montméry !\r\nDécouvrez ces deux hameaux typiques du Versant du Soleil.\r\nUn parcours de 3,3km avec 150mD+ et ses 9 balises."
    ],
    "nl": [
      "Welkom op de erfgoedroute Valezan-Montméry!\r\nOntdek deze twee typische gehuchten in de Versant du Soleil.\r\nHet is een route van 3,3 km met meer dan 150 m en 9 markeringen."
    ],
    "es": [
      "Bienvenido al curso de orientación sobre el patrimonio de Valezan-Montméry\r\nDescubra estas dos aldeas típicas del Versant du Soleil.\r\nUn recorrido de 3,3 km con 150mD+ y 9 balizas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Orientierungslauf Kulturerbe von Valezan Montméry - blauer Parcours"
    ],
    "en": [
      "Orienteering course - Heritage of Valezan Montméry - blue level"
    ],
    "fr": [
      "Parcours d'orientation Patrimoine de Valezan Montméry - parcours bleu"
    ],
    "nl": [
      "Valezan Montméry erfgoed oriëntatieloop - blauwe route"
    ]
  },
