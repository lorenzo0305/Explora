  "rdfs:comment": {
    "de": [
      "Die Bar \"Le Crépu\" empfängt Sie seit 2003 im Herzen von Morzine!\r\nAprès-Ski, Après-Bike, Live-Musik-Abende...\r\nStimmung das ganze Jahr über garantiert!"
    ],
    "en": [
      "The \"Le Crépu\" bar welcomes you to the heart of Morzine since 2003!\r\nAfter-ski, après-MTB, live music evenings...\r\nAtmosphere guaranteed all year round!"
    ],
    "it": [
      "Il bar \"Le Crépu\" vi accoglie nel cuore di Morzine dal 2003!\r\nAprès-ski, après-bike, serate di musica dal vivo...\r\nAtmosfera garantita tutto l'anno!"
    ],
    "fr": [
      "Le bar \"Le Crépu\" vous accueille au coeur de Morzine depuis 2003 !\r\nAprès-ski, après-bike, soirées live music...\r\nAmbiance assurée toute l'année !"
    ],
    "es": [
      "El bar \"Le Crépu\" le da la bienvenida en el corazón de Morzine desde 2003\r\nAprès-ski, après-bike, noches de música en vivo...\r\n¡Ambiente garantizado todo el año!"
    ],
    "nl": [
      "De bar \"Le Crépu\" verwelkomt je sinds 2003 in het hart van Morzine!\r\nAprès-ski, après-bike, live muziek avonden...\r\nEen geweldige sfeer het hele jaar door!"
    ]
  },
