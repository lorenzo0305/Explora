  "rdfs:comment": {
    "de": [
      "Ein Zentrum für Laserspiele, für einen funky Moment mit Freunden oder der Familie!\r\nAuf dem Programm steht ein Lasergame in einem 500 m² großen Labyrinth im Stil einer alten Industriestadt, ein Arcade-Raum und ein Geschicklichkeitsspiel durch einen Laserparcours!"
    ],
    "en": [
      "Laser game center, for a funky moment with friends or family!\r\nThe program includes laser games in a 500 m² maze decorated like an old industrial city, an arcade and an agility game on a laser course!"
    ],
    "it": [
      "Centro di giochi laser, per divertirsi con gli amici o la famiglia!\r\nIl programma prevede giochi laser in un labirinto di 500 m² decorato come una vecchia città industriale, una sala giochi e un gioco di agilità su un percorso laser!"
    ],
    "fr": [
      "Centre de jeux laser, pour un moment Funky entre amis ou en famille !\r\nAu programme, du laser game dans 500 m² de labyrinthe au décor d'ancienne cité indus, une salle d'arcades et un jeu d'agilité à travers un Parcours laser !"
    ],
    "nl": [
      "Lasergamecentrum, voor een funky tijd met vrienden of familie!\r\nOp het programma staan lasergames in een doolhof van 500 m² ingericht als een oude industriële stad, een arcadehal en een behendigheidsspel op een laserparcours!"
    ],
    "es": [
      "Centro de juegos láser, ¡para pasar un rato divertido con amigos o en familia!\r\nEl programa incluye juegos láser en un laberinto de 500 m² decorado como una antigua ciudad industrial, un salón recreativo y un juego de agilidad en un circuito láser"
    ]
  },
