  "rdfs:comment": {
    "de": [
      "Geselliges, bistronomisches Restaurant, herzlicher Empfang und großzügige Teller. Lokale Produkte, leckere und schmackhafte Küche, musikalische Unterhaltung am Mittwochabend. Terrasse im Stil einer Strohhütte. Bei Nine geht es ohne Chi-Chi."
    ],
    "en": [
      "Convivial bistro restaurant, warm welcome and generous plate. Local produce, tasty cuisine and live music on Wednesday evenings. Terrace-style straw hut. Chez Nine is chi-free."
    ],
    "it": [
      "Un accogliente ristorante bistrot con un'accoglienza calorosa e piatti generosi. Prodotti locali, cucina gustosa e musica dal vivo il mercoledì sera. Terrazza in stile capanna di paglia. Chez Nine non ha chi-chi."
    ],
    "fr": [
      "Restaurant bistronomique et convivial, accueil chaleureux et assiette généreuse. Produits locaux, cuisine savoureuse et goûteuse, ambiance musicale le mercredi soir. Terrasse façon paillotte. Chez Nine c'est sans chi-chi."
    ],
    "es": [
      "Un agradable restaurante bistró con una cálida bienvenida y platos generosos. Productos locales, cocina sabrosa y música en directo los miércoles por la noche. Terraza al estilo de una cabaña de paja. Chez Nine no tiene chi-chi."
    ],
    "nl": [
      "Een vriendelijk bistrorestaurant met een warm welkom en royale gerechten. Lokale producten, smakelijke gerechten en livemuziek op woensdagavond. Terras in de stijl van een strohut. Chez Nine heeft geen chi-chi."
    ]
  },
  "rdfs:label": {
