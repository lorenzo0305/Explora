  "rdfs:comment": {
    "de": [
      "Diese Käserei befindet sich in der ehemaligen Dorfschmiede am Fusse des Schlosses und bietet Ihnen traditionellen, handwerklich hergestellten Käse aus roher und pasteurisierter Milch an. Lokale und internationale Käsesorten."
    ],
    "en": [
      "Housed in the village’s old forge, at the foot of the Château, this dairy shop offers farm cheeses and artisan cheese, made with raw and pasteurised milk, both local and international."
    ],
    "it": [
      "Situata nell'antica fucina del paese, ai piedi del castello, questa cremeria e formaggeria offre formaggi di fattoria o artigianali, prodotti con latte crudo o pastorizzato, locali o internazionali. Troverete anche burro, yogurt, panna fresca..."
    ],
    "fr": [
      "Située dans l'ancienne forge du village, au pied du Château, cette crèmerie-fromagerie vous propose des fromages fermiers ou artisanaux, au lait cru ou pasteurisé, locaux ou internationaux. Vous y trouverez également du beurre, yaourts, crème fraiche..."
    ],
    "es": [
      "Situada en la antigua fragua del pueblo, a los pies del castillo, esta cremería y quesería ofrece quesos de granja o artesanales, elaborados con leche cruda o pasteurizada, locales o internacionales. También encontrará mantequilla, yogures, crema fresca..."
    ],
    "nl": [
      "Gevestigd in de oude smederij van het dorp, aan de voet van het kasteel, levert \r\ndeze zuivelfabriek-kaasmakerij lokale of internationale boerenkazen of ambachtelijke kazen, gemaakt uit rauwe of gepasteuriseerde melk."
    ]
  },
