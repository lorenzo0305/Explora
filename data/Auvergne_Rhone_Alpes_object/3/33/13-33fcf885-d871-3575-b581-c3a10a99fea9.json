  "rdfs:comment": {
    "de": [
      "Das Zentrum Aqua-Passion im Herzen der Emblavez-Ebene empfängt Sie das ganze Jahr über mit einem Schwimmbad, einem Wellnessbereich, einem Grünstrand, einer Sporthalle, einem Kardioraum und einem Multiaktivitätsraum."
    ],
    "en": [
      "A swimming pool, a wellness area, a green beach, a gymnasium, a cardio room and a multi-activity room in the heart of the Emblavez plain. The Aqua-Passion center welcomes you all year round, 7 days a week (except for the 2 technical shutdown weeks)"
    ],
    "it": [
      "Il centro Aqua-Passion, nel cuore della pianura di Emblavez, vi accoglie tutto l'anno con una piscina, un'area benessere, una spiaggia verde, una palestra, una sala cardio e una sala multiattività."
    ],
    "fr": [
      "Le centre Aqua-Passion au cœur de la plaine de l'Emblavez vous accueille toute l'année avec une piscine, un espace Bien-Etre, une plage verte, un gymnase, une salle cardio et une salle multi-activités."
    ],
    "nl": [
      "Het Aqua-Passion centrum in het hart van de vlakte van Emblavez verwelkomt je het hele jaar door, met een zwembad, een wellnessruimte, een groen strand, een fitnessruimte, een cardioruimte en een multi-activiteitenruimte."
    ],
    "es": [
      "El centro Aqua-Passion, en el corazón de la llanura de Emblavez, te acoge todo el año con una piscina, una zona de bienestar, una playa verde, un gimnasio, una sala de cardio y una sala multiactividades."
    ]
  },
  "rdfs:label": {
