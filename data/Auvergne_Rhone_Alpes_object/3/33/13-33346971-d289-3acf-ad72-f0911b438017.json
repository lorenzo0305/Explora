  "rdfs:comment": {
    "de": [
      "Das Théâtre du Forum heißt Sie das ganze Jahr über zu einem vielfältigen Kulturprogramm für jeden Geschmack willkommen: Tanz, Theater, Konzerte, Comedy …"
    ],
    "en": [
      "The Théâtre du Forum welcomes you all year round with culturally diverse programming for all audiences: dance, theatre, concerts, comedy, and more."
    ],
    "it": [
      "Il Théâtre du Forum vi accoglie tutto l'anno con un programma vario di eventi culturali per tutti i pubblici: danza, teatro, concerti, commedie, ecc Programma e biglietti disponibili presso gli uffici di informazione turistica di Forez-Est."
    ],
    "fr": [
      "Le Théâtre du Forum vous accueille toute l’année avec une programmation culturelle variée et pour tous publics : spectacles de danse, théâtre, concert, humour, … Programme et billetterie disponible dans les bureaux d’information touristique de Forez-Est."
    ],
    "nl": [
      "Het Théâtre du Forum verwelkomt u het hele jaar door met een gevarieerd programma van culturele evenementen voor elk publiek: dans, theater, concerten, komedie, enz Programma en kaartjes verkrijgbaar bij de VVV-kantoren van Forez-Est."
    ],
    "es": [
      "El Théâtre du Forum le da la bienvenida todo el año con una variada programación de actos culturales para todos los públicos: danza, teatro, conciertos, comedia, etc Programa y entradas disponibles en las oficinas de turismo de Forez-Est."
    ]
  },
