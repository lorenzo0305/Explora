  "rdfs:comment": {
    "de": [
      "Typisches Restaurant im Herzen eines der schönsten Täler des Cantal, am Fuße des Puy-Mary. Einfache, schmackhafte und leckere Gerichte mit lokalen und saisonalen Produkten. Saal mit Panoramablick auf den Puy Mary."
    ],
    "en": [
      "Typical restaurant nestled in the heart of one of Cantal?s most beautiful valleys, at the foot of Puy-Mary. Simple, tasty, gourmet cuisine using local, seasonal produce. Room with panoramic view of Puy Mary."
    ],
    "it": [
      "Ristorante tipico situato nel cuore di una delle più belle valli del Cantal, ai piedi del Puy-Mary. Cucina semplice, gustosa e gourmet con prodotti locali e di stagione. Camera con vista panoramica sul Puy Mary."
    ],
    "fr": [
      "Restaurant typique, niché au cœur d’une des plus belles vallées du Cantal, au pied du Puy-Mary. Restauration simple, savoureuse et gourmande avec des produits locaux et de saison. Salle avec vue panoramique sur le Puy Mary."
    ],
    "nl": [
      "Typisch restaurant in het hart van een van de mooiste valleien van de Cantal, aan de voet van Puy-Mary. Eenvoudige, smakelijke, gastronomische keuken met lokale, seizoensgebonden producten. Kamer met panoramisch uitzicht op Puy Mary."
    ],
    "es": [
      "Restaurante típico situado en el corazón de uno de los valles más bellos del Cantal, a los pies del Puy-Mary. Cocina gastronómica, sencilla y sabrosa, elaborada con productos locales de temporada. Habitación con vista panorámica del Puy Mary."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Grand Hôtel de la Vallée"
    ]
  },
