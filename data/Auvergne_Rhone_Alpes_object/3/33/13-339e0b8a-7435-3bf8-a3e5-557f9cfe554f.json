  "rdfs:comment": {
    "de": [
      "Dieses Gebäude beherbergt sowohl Bogenschützen als auch Boulisten. Es ermöglicht ihnen, trotz der schwierigen Wetterbedingungen in unserer Region das ganze Jahr über ihren Sport auszuüben."
    ],
    "en": [
      "This building welcomes both archers and bowmen. It allows them to practice all year round despite the difficult weather conditions in our region."
    ],
    "it": [
      "Questo edificio accoglie sia arcieri che giocatori di bocce. Permette loro di esercitarsi tutto l'anno nonostante le difficili condizioni climatiche della nostra regione."
    ],
    "fr": [
      "Ce bâtiment accueille aussi bien les archers que les boulistes. Il leur permet de pouvoir exercer leur pratique tout au long de l'année malgré les conditions météorologiques difficiles de notre région."
    ],
    "es": [
      "Este edificio acoge tanto a los arqueros como a los jugadores de bolos. Les permite practicar durante todo el año a pesar de las difíciles condiciones meteorológicas de nuestra región."
    ],
    "nl": [
      "Dit gebouw verwelkomt zowel schutters als bowlers. Zo kunnen ze het hele jaar door oefenen, ondanks de moeilijke weersomstandigheden in onze regio."
    ]
  },
  "rdfs:label": {
