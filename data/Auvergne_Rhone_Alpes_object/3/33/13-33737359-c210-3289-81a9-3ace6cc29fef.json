  "rdfs:comment": {
    "de": [
      "Lokale und saisonale Küche. Terrasse im Schatten der Arkaden. Zögern Sie nicht, uns für Ihre Gruppenmahlzeiten oder im Falle einer Diät zu kontaktieren, wir machen Ihnen gerne Vorschläge. Menü für 27€ mittags von Dienstag bis Freitag."
    ],
    "en": [
      "Local and homemade specialities. Terrace in the shade of the arches."
    ],
    "it": [
      "Cucina locale e stagionale. Terrazza all'ombra dei portici. Non esitate a contattarci per i vostri pasti di gruppo o se avete una dieta speciale, saremo lieti di darvi dei suggerimenti. Menu a 27? a pranzo dal martedì al venerdì."
    ],
    "fr": [
      "Cuisine locale et de saison. Terrasse à l'ombre des arcades. N'hésitez pas à nous contacter pour vos repas de groupe ou en cas de régime alimentaire, nous serons heureux de vous faire des propositions. Menu à 27€ le midi du mardi au vendredi."
    ],
    "nl": [
      "Lokale en seizoensgebonden keuken. Terras in de schaduw van de bogen. Vegan en vegetarische gerechten op aanvraaag (na reservering 1 dag op voorhand). Menu 23 €'s middags van dinsdag tot vrijdag."
    ],
    "es": [
      "Cocina local y de temporada. Terraza a la sombra de los soportales. No dude en ponerse en contacto con nosotros para sus comidas de grupo o si tiene una dieta especial, estaremos encantados de hacerle sugerencias. Menú a 27? para el almuerzo de martes a viernes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Fourchette"
    ],
    "nl": [
      "La Fourchette"
    ]
  },
