  "rdfs:comment": {
    "de": [
      "Workshop Blumenstrauß der Saison mit Gedichtlesung. In Partnerschaft mit der Mediathek von Cusset: Binden Sie einen Strauß aus aktuellen französischen Blumen, unterbrochen von Gedichtlesungen zum Thema Freiheit."
    ],
    "en": [
      "Seasonal bouquet workshop with poetry readings. In partnership with the Cusset media library, create a bouquet of contemporary French flowers, interspersed with poetry readings on the theme of freedom."
    ],
    "it": [
      "Laboratorio di bouquet stagionale con letture di poesie. In collaborazione con la mediateca Cusset, create un bouquet di fiori francesi contemporanei, intervallati da letture di poesie sul tema della libertà."
    ],
    "fr": [
      "Atelier bouquet de saison avec lecture de poèmes. En partenariat avec la médiathèque de Cusset, réalisation d'un bouquet de fleurs françaises du moment entrecoupé de lectures de poèmes sur le thème de la liberté."
    ],
    "es": [
      "Taller de ramos de flores de temporada con lectura de poemas. En colaboración con la mediateca de Cusset, cree un ramo de flores francesas contemporáneas, intercalado con lecturas de poesía sobre el tema de la libertad."
    ],
    "nl": [
      "Seizoensboeketworkshop met poëzievoordrachten. Maak in samenwerking met de mediatheek van Cusset een boeket hedendaagse Franse bloemen, afgewisseld met poëzievoordrachten over het thema vrijheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier floral du printemps des poètes"
    ]
  },
