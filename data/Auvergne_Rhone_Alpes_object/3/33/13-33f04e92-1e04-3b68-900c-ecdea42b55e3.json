  "rdfs:comment": {
    "de": [
      "Lassen Sie Ihre Seele bei einer unserer Entspannungsmassagen mit klingenden Namen wie Tour du Monde, Entre ciel et Terre oder Sensation d'Ailleurs baumeln"
    ],
    "en": [
      "Escape the time of a session in our hammam and sauna or let your mind travel during one of our relaxing massages with evocative names: Tour du Monde, Entre ciel et Terre or Sensation d'Ailleurs?"
    ],
    "it": [
      "Fuggite per una seduta nel nostro hammam e nella nostra sauna o lasciate viaggiare la mente durante uno dei nostri massaggi rilassanti dai nomi evocativi: Tour du Monde, Entre ciel et Terre o Sensation d'Ailleurs?"
    ],
    "fr": [
      "Evadez-vous le temps d’une séance dans notre hammam et sauna ou laissez votre esprit voyager pendant un de nos massages détente au nom évocateur : Tour du Monde, Entre ciel et Terre ou Sensation d’Ailleurs…"
    ],
    "nl": [
      "Ontsnap voor een sessie in onze hammam en sauna of laat uw geest op reis gaan tijdens een van onze ontspannende massages met suggestieve namen: Tour du Monde, Entre ciel et Terre of Sensation d?Ailleurs?"
    ],
    "es": [
      "Escápese para una sesión en nuestro hammam y sauna o deje que su mente viaje durante uno de nuestros masajes relajantes con nombres evocadores: Tour du Monde, Entre ciel et Terre o Sensation d'Ailleurs?"
    ]
  },
  "rdfs:label": {
