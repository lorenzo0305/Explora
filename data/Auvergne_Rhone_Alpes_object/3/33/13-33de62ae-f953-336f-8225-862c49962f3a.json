  "rdfs:comment": {
    "de": [
      "Im Sommer wie im Winter steht Ihnen das gesamte Team des Fremdenverkehrsamtes zur Verfügung, um Sie bei Ihrem Aufenthalt zu begleiten."
    ],
    "en": [
      "Summer and winter alike, the entire Tourist Office team is on hand to help you make the most of your stay."
    ],
    "it": [
      "Sia in estate che in inverno, l'intero team dell'Ufficio del Turismo è a disposizione per aiutarvi a sfruttare al meglio il vostro soggiorno."
    ],
    "fr": [
      "Été comme hiver, toute l'équipe de l'office de tourisme est à votre écoute pour vous accompagner lors de votre séjour."
    ],
    "nl": [
      "Zowel in de zomer als in de winter staat het hele team van het VVV-kantoor klaar om je te helpen het beste uit je verblijf te halen."
    ],
    "es": [
      "Tanto en verano como en invierno, todo el equipo de la Oficina de Turismo está a su disposición para ayudarle a aprovechar al máximo su estancia."
    ]
  },
  "rdfs:label": {
