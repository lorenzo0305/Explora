  "rdfs:comment": {
    "de": [
      "Claudine, eine Bäuerin, heißt Gruppen und Einzelpersonen zu einer lehrreichen Bauernhofaktivität willkommen und bietet Kindern die Möglichkeit, aktiv am Leben auf dem Bauernhof teilzunehmen. Auch Eltern finden ihr Glück. Nur mit Reservierung."
    ],
    "en": [
      "Claudine, a farmer, welcomes groups and individuals to an educational farm activity and offers children the opportunity to actively participate in farm life. Parents also find their happiness. By reservation only."
    ],
    "it": [
      "La contadina Claudine accoglie gruppi e singoli nella sua fattoria didattica, dove i bambini possono partecipare attivamente alla vita della fattoria. C'è qualcosa anche per i genitori. Solo su prenotazione."
    ],
    "fr": [
      "Claudine, agricultrice, reçoit des groupes et des particuliers dans une activité de ferme pédagogique et propose aux enfants de participer activement à la vie de la ferme. Les parents trouvent aussi leur bonheur. Uniquement sur réservation."
    ],
    "es": [
      "La granjera Claudine recibe a grupos y particulares en su granja educativa, donde los niños pueden participar activamente en la vida de la granja. También hay algo para los padres. Sólo con reserva previa."
    ],
    "nl": [
      "Boerin Claudine verwelkomt groepen en individuen op haar educatieve boerderij, waar kinderen actief kunnen deelnemen aan het boerenleven. Er is ook iets voor ouders. Alleen op reservering."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Arche de Noë - Ferme pédagogique"
    ]
  },
