  "rdfs:comment": {
    "de": [
      "LudOGaïa, das Erwachen der Natur... Ein spielerisches, pädagogisches und wissenschaftliches Eintauchen in die Welt der Natur, geeignet für Groß und Klein, geschaffen von leidenschaftlichen Ingenieuren und Forschern."
    ],
    "en": [
      "LudOGaïa, awakening to nature... A fun, educational and scientific immersion in the world of nature, suitable for young and old alike, created by passionate engineers and researchers."
    ],
    "it": [
      "LudOGaïa, imparare la natura... Un'immersione divertente, educativa e scientifica nel mondo della natura, adatta a grandi e piccini, creata da ingegneri e ricercatori appassionati."
    ],
    "fr": [
      "LudOGaïa, l'éveil à la nature... Une immersion ludique, pédagogique et scientifique dans le monde de la nature, adapté aux petits comme aux grands, créé par des ingénieurs et des chercheurs passionnés."
    ],
    "nl": [
      "LudOGaïa, leren over de natuur... Een leuke, educatieve en wetenschappelijke onderdompeling in de wereld van de natuur, geschikt voor jong en oud, gemaakt door ingenieurs en gepassioneerde onderzoekers."
    ],
    "es": [
      "LudOGaïa, aprender sobre la naturaleza... Una inmersión lúdica, pedagógica y científica en el mundo de la naturaleza, apta para grandes y pequeños, creada por ingenieros e investigadores apasionados."
    ]
  },
