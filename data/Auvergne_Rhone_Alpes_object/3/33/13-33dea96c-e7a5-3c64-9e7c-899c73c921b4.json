  "rdfs:comment": {
    "de": [
      "Im Herzen von La Bourboule und 100 m von den Thermalbädern entfernt empfängt Sie das Hotel-Restaurant Le Genève, das 2021 komplett renoviert wurde (2012 für die Superior-Zimmer), in einer familiären Atmosphäre."
    ],
    "en": [
      "In the heart of La Bourboule and 100 m from the thermal baths, the hotel-restaurant Le Genève, entirely renovated in 2021 (2012 for the superior rooms), will welcome you in a family atmosphere."
    ],
    "it": [
      "Nel cuore di La Bourboule e a 100 metri dalle terme, l'hotel-ristorante Le Genève, interamente rinnovato nel 2021 (2012 per le camere superior), vi accoglierà in un'atmosfera familiare."
    ],
    "fr": [
      "Au cœur de la Bourboule et à 100 m des thermes, l'hôtel-restaurant Le Genève,  établissement entièrement rénové en 2021, (2012 pour les chambres supérieures), vous accueillera dans une ambiance familiale."
    ],
    "nl": [
      "In het hart van La Bourboule en op 100 meter van de thermen ontvangt hotel-restaurant Le Genève, volledig gerenoveerd in 2021 (2012 voor de superieure kamers), u in een familiale sfeer."
    ],
    "es": [
      "En el corazón de La Bourboule y a 100 metros de los baños termales, el hotel-restaurante Le Genève, totalmente renovado en 2021 (2012 para las habitaciones superiores), le acogerá en un ambiente familiar."
    ]
  },
