  "rdfs:comment": {
    "de": [
      "Tag der offenen Tür & Einführung in den Fechtsport (klassisches und angepasstes Fechten). Vorführungen, kleine Spiele, Entdeckung der Ausrüstung und der Geschichte dieses Sports. Für alle ab 8 Jahren zugänglich, auch für Menschen mit Behinderungen."
    ],
    "en": [
      "Open house & introduction to fencing (classical and adapted). Demonstrations, games, discovery of equipment and history of the sport. Accessible to everyone aged 8 and over, including people with disabilities."
    ],
    "it": [
      "Apertura e introduzione alla scherma (classica e adattata). Dimostrazioni, giochi, scoperta dell'attrezzatura e della storia di questo sport. Aperto a tutti a partire dagli 8 anni, comprese le persone con disabilità."
    ],
    "fr": [
      "Portes ouvertes & initiation à l’escrime (classique et adaptée). Démonstrations, petits jeux, découverte du matériel et de l’histoire de ce sport. Accessible à tous dès 8 ans, y compris en situation de handicap."
    ],
    "nl": [
      "Open huis en kennismaking met schermen (klassiek en aangepast). Demonstraties, spelletjes, ontdekking van de uitrusting en de geschiedenis van de sport. Open voor iedereen vanaf 8 jaar, ook voor mensen met een handicap."
    ],
    "es": [
      "Jornada de puertas abiertas e iniciación a la esgrima (clásica y adaptada). Demostraciones, juegos, descubrimiento del material y de la historia de este deporte. Abierto a todos a partir de 8 años, incluidas las personas con discapacidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escrime pour tous !"
    ]
  },
