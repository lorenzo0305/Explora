  "rdfs:comment": {
    "de": [
      "Roul' ma Poule Annecy-le-Vieux :\r\nFahrradverleih: +500 Fahrräder : VTC, Komfort- oder Sporträder, Fitnessräder, VAE, Elektroräder, E-Bikes, Familien-VAE E-Cargo, Kinderfahrräder, Anhänger, Kindersitze...\r\n7 Tage die Woche nonstop geöffnet: von April bis November."
    ],
    "en": [
      "Roul' ma Poule Annecy-le-Vieux : \r\nBicycle rental: + 500 bikes. Comfort bikes, VTC, Sport bikes, Fitness bikes, VAE, E-Bikes comfort, VAE E-Road Bikes, VAE Family E-Cargo, Bikes/Remorques/Child seats...\r\nOpen 7 days a week non-stop: from April to November"
    ],
    "it": [
      "Roul' ma Poule Annecy-le-Vieux :\nNoleggio biciclette: +600 Biciclette: Comfort o Sport, VTC, Fitness, VAE, Biciclette elettriche, E-Bikes, VAE Famille Longtail, Biciclette per bambini, Rimorchi, Seggiolini per bambini...\nAperto 7 giorni su 7 Non Stop: da aprile a novembre."
    ],
    "fr": [
      "Roul' ma Poule Annecy-le-Vieux :\nLocation Vélos: +600 Vélos : Vélos Confort ou Sport, VTC, Vélos de Fitness, VAE, Vélos Electriques, E-Bikes, VAE Famille Longtail , Vélos enfants, Remorques, Sièges enfants...\nOuvert 7j/7 Non Stop : d'Avril à Novembre."
    ],
    "nl": [
      "Roul' ma Poule Annecy-le-Vieux :\nFietsverhuur: +600 Fietsen: Comfort- of Sportfietsen, VTC, Fitnessfietsen, VAE, Elektrische fietsen, E-bikes, VAE Famille Longtail , Kinderfietsen, Aanhangers, Kinderzitjes...\n7 dagen per week Non Stop geopend: van april tot november."
    ],
    "es": [
      "Roul' ma Poule Annecy-le-Vieux :\nAlquiler de bicicletas: +600 Bicicletas: Confortables o deportivas, VTC, Bicicletas de fitness, VAE, Bicicletas eléctricas, E-Bikes, VAE Famille Longtail , Bicicletas para niños, Remolques, Sillas para niños...\nAbierto 7 días a la semana Non Stop : de abril a noviembre."
    ]
  },
