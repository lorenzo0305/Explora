  "rdfs:comment": {
    "de": [
      "Airéole ist eine professionelle Schule, die seit 1987 mit dem FFVL-Label ausgezeichnet ist. Albert Baud, Olivier Rozier und das Team bieten Ihnen\r\nbieten Ausbildungskurse aller Niveaus für Gleitschirmfliegen im Sommer und Speed Riding im Winter an"
    ],
    "en": [
      "Airéole has been a FFVL-certified professional school since 1987. Albert Baud, Olivier Rozier and the team\r\noffer training courses for all levels in paragliding in summer and speed riding in winter."
    ],
    "it": [
      "Airéole è una scuola professionale approvata dalla FFVL dal 1987. Albert Baud, Olivier Rozier e il suo team\r\noffrono corsi di formazione per tutti i livelli nel parapendio in estate e nello speed riding in inverno"
    ],
    "fr": [
      "Airéole est une école professionnelle labellisée FFVL depuis 1987. Albert Baud, Olivier Rozier et l’équipe vous\r\nproposent des stages de formation de tous niveaux en parapente l'été et en speed riding l'hiver"
    ],
    "nl": [
      "Airéole is sinds 1987 een door de FFVL erkende professionele school. Albert Baud, Olivier Rozier en het team\r\nbieden cursussen voor alle niveaus in paragliding in de zomer en speed riding in de winter."
    ],
    "es": [
      "Airéole es una escuela profesional homologada por la FFVL desde 1987. Albert Baud, Olivier Rozier y su equipo\r\nofrecen cursos de formación para todos los niveles en parapente en verano y en speed riding en invierno"
    ]
  },
