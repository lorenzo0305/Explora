  "rdfs:comment": {
    "de": [
      "Der Echo-Ort ist ein Raum mit geringer Umweltbelastung und starker menschlicher Interaktion, in dem Sie Ihr Team zusammenbringen können, um eine authentische CSR-Erfahrung zu machen."
    ],
    "en": [
      "L'Écho-lieu is a space with low environmental impact and high human interaction, where you can bring your team together for an authentic CSR experience."
    ],
    "it": [
      "L'Echo-lieu è uno spazio a basso impatto ambientale e ad alta interazione umana dove potete riunire il vostro team per un'autentica esperienza di CSR."
    ],
    "fr": [
      "L'Écho-lieu est un espace à faible impact environnemental et à forte interaction humaine où vous pouvez rassembler votre équipe pour vivre une expérience RSE authentique."
    ],
    "es": [
      "El Eco-lugar es un espacio de bajo impacto ambiental y alta interacción humana donde puede reunir a su equipo para vivir una auténtica experiencia de RSC."
    ],
