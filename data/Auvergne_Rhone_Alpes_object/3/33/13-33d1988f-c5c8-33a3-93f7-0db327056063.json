  "rdfs:comment": {
    "de": [
      "Restaurant mit Terrasse, die auf einen angenehmen Innenhof führt\r\nAn schönen Tagen können Sie in einer grünen, ruhigen Umgebung am Pool zu Mittag oder zu Abend essen."
    ],
    "en": [
      "Restaurant with terrace overlooking a pleasant patio\r\nAs soon as the weather is fine, you can have lunch or dinner in a green setting, in a quiet place, near the swimming pool."
    ],
    "it": [
      "Ristorante con terrazza che si affaccia su un piacevole patio\r\nNella bella stagione, il pranzo o la cena possono essere serviti in un tranquillo ambiente verde vicino alla piscina."
    ],
    "fr": [
      "Restaurant avec terrasse donnant sur un agréable patio. \r\nDès les beaux jours, possibilité de déjeuner ou dîner  dans un écrin de verdure, au calme, près de la piscine."
    ],
    "es": [
      "Restaurante con terraza que da a un agradable patio\r\nCuando hace buen tiempo, se puede comer o cenar en un tranquilo entorno verde cerca de la piscina."
    ],
    "nl": [
      "Restaurant met terras met uitzicht op een aangename patio\r\nBij mooi weer kan de lunch of het diner worden geserveerd in een rustige groene omgeving bij het zwembad."
    ]
  },
