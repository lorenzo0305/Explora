  "rdfs:comment": {
    "de": [
      "Das Restaurant Les Gour'Mets im Stadtzentrum von La Verpillière bietet Ihnen eine neu interpretierte traditionelle Küche und \"hausgemachte\" Gerichte mit frischen Produkten in einem gemütlichen Rahmen."
    ],
    "en": [
      "The restaurant Les Gour'Mets, located in the center of La Verpillière, offers traditional cuisine and homemade dishes made with fresh produce in a warm setting."
    ],
    "it": [
      "Il ristorante Les Gour'Mets, situato nel centro di La Verpillière, offre una cucina tradizionale con un tocco di classe e piatti fatti in casa con prodotti freschi in un ambiente accogliente."
    ],
    "fr": [
      "Le restaurant Les Gour'Mets, situé en plein centre ville de La Verpillière vous propose une cuisine traditionnelle revisitée et des plats \"fait maison\" avec des produits frais dans un cadre chaleureux."
    ],
    "nl": [
      "Het restaurant Les Gour'Mets, gelegen in het centrum van La Verpillière, biedt een traditionele keuken met een twist, en huisgemaakte gerechten gemaakt met verse producten in een vriendelijke omgeving."
    ],
    "es": [
      "El restaurante Les Gour'Mets, situado en el centro de La Verpillière, ofrece cocina tradicional con un toque especial y platos caseros elaborados con productos frescos en un ambiente acogedor."
    ]
  },
  "rdfs:label": {
