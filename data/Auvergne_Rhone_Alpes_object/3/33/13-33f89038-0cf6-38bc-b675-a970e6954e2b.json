  "rdfs:comment": {
    "de": [
      "Mittags verwöhnt Sie der Chefkoch von Montag bis Freitag zum Lunch.\r\nAm Freitag- oder Samstagabend können Sie ein Ereignis feiern und/oder unsere Künstler entdecken!\r\nTanzrestaurant in La Bièvre, 25 Minuten von Grenoble entfernt, mit Platz für bis zu 200 Personen."
    ],
    "en": [
      "At lunchtime, our Chef will delight you from Monday to Friday.\r\nOn Friday or Saturday evenings, come and celebrate an event and/or discover our artists!\r\nRestaurant dansant de la Bièvre, 25 minutes from Grenoble, can accommodate up to 200 people."
    ],
    "it": [
      "A pranzo, lo chef vi delizierà dal lunedì al venerdì.\r\nIl venerdì o il sabato sera, venite a festeggiare un evento e/o a scoprire i nostri artisti!\r\nIl ristorante dansant de la Bièvre, a 25 minuti da Grenoble, può ospitare fino a 200 persone."
    ],
    "fr": [
      "Le midi, le Chef vous régale au déjeuner du lundi au vendredi.\r\nLe vendredi ou samedi soir, venez fêter un événement et/ou  découvrir nos artistes ! \r\nRestaurant dansant de la Bièvre à 25 minutes de Grenoble pouvant accueillir jusqu'à 200 personnes."
    ],
    "nl": [
      "Van maandag tot vrijdag kunt u 's middags genieten van de chef-kok.\r\nKom op vrijdag- of zaterdagavond een evenement vieren en/of onze artiesten ontdekken!\r\nRestaurant dansant de la Bièvre, op 25 minuten van Grenoble, biedt plaats aan maximaal 200 personen."
    ],
    "es": [
      "A la hora de comer, el Chef le deleitará de lunes a viernes.\r\nLos viernes o sábados por la noche, venga a celebrar un evento y/o a descubrir a nuestros artistas\r\nEl restaurante dansant de la Bièvre, a 25 minutos de Grenoble, puede acoger hasta 200 personas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bongo Resto Club"
    ]
  },
