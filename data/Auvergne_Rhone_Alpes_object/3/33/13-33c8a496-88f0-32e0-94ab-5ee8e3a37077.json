  "rdfs:comment": {
    "de": [
      "Die regionalen Spezialitäten werden hausgemacht und aus frischen Produkten zubereitet. Eine herzliche und gesellige Atmosphäre erwartet Sie bei einem Geschäftsessen oder mit der Familie."
    ],
    "en": [
      "Regioanl specialities, fried small fishes, frog legs, first choice meats, cooked pork meat. Handmade cuisine, typical regional dishes made with fresh products. Warm and friendly atmosphere for a business or a family meal."
    ],
    "it": [
      "Le specialità regionali sono fatte in casa con prodotti freschi. Un'atmosfera calda e accogliente vi attende per un pasto di lavoro o in famiglia."
    ],
    "fr": [
      "Les spécialités régionales sont réalisées maison à partir de produits frais. Ambiance chaleureuse et conviviale vous attendent pour un repas d'affaires ou en famille."
    ],
    "es": [
      "Las especialidades regionales se elaboran de forma casera con productos frescos. Un ambiente cálido y acogedor le espera para una comida de negocios o familiar."
    ],
    "nl": [
      "De regionale specialiteiten zijn huisgemaakt van verse producten. Een warme en vriendelijke sfeer wacht op u voor een zakelijke of familiale maaltijd."
    ]
  },
