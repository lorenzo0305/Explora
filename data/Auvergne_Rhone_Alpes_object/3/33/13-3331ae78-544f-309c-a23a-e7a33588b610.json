  "rdfs:comment": {
    "de": [
      "Familienbrauerei in L'Isle d'Abeau, von Montag bis Samstag jeden Mittag geöffnet!\r\nCharolais-Fleisch ist unsere Spezialität, also lassen Sie sich verwöhnen."
    ],
    "en": [
      "Family brewery in L'Isle d'Abeau open from Monday to Saturday every noon!\r\nCharolais meat is our speciality, so let yourself be tempted."
    ],
    "it": [
      "Brasserie a conduzione familiare a L'Isle d'Abeau aperta dal lunedì al sabato a pranzo!\r\nLa carne Charolais è la nostra specialità, quindi lasciatevi tentare."
    ],
    "fr": [
      "Brasserie familiale à L'Isle d'Abeau ouverte du lundi au samedi tous les midis ! \r\nLa viande charolaise est notre spécialité, alors laissez vous tenter."
    ],
    "nl": [
      "Familiale brasserie in L'Isle d'Abeau, elke middag geopend van maandag tot zaterdag!\r\nCharolais vlees is onze specialiteit, dus laat je verleiden."
    ],
    "es": [
      "Brasserie familiar de L'Isle d'Abeau abierta de lunes a sábado todos los mediodías\r\nLa carne charolesa es nuestra especialidad, así que déjese tentar."
    ]
  },
