  "rdfs:comment": {
    "de": [
      "Das Ibis Roanne befindet sich 7 km vom Stadtzentrum von Roanne und den Gewerbegebieten Mably und Bonvert entfernt. Das Hotel ist über die Autobahnen A89 (Lyon) und A72 (St. Etienne - Clermont-Ferrand) sehr gut erreichbar."
    ],
    "en": [
      "The Ibis hotel Roanne, situated 5kms from the town centre offers rooms equipped with private bathrooms, air-conditioning, flat-screen TV's with Canal + and Sports channels. Restaurant and swimming pool."
    ],
    "it": [
      "L'Ibis Roanne è a 7 km dal centro di Roanne e dai parchi commerciali Mably e Bonvert. L'hotel è facilmente raggiungibile dalle autostrade A89 (Lione) e A72 (St-Étienne - Clermont-Ferrand)."
    ],
    "fr": [
      "L'Ibis Roanne se trouve à 7 km du centre-ville de Roanne et des zones d'activités de Mably et Bonvert. L'hôtel est très facile d'accès par les autoroutes A89 (Lyon) et A72 (St-Étienne - Clermont-Ferrand)."
    ],
    "nl": [
      "Het Ibis Roanne ligt op 7 km van het centrum van Roanne en de bedrijventerreinen Mably en Bonvert. Het hotel is gemakkelijk te bereiken vanaf de snelwegen A89 (Lyon) en A72 (St-Étienne - Clermont-Ferrand)."
    ],
    "es": [
      "El Ibis Roanne está a 7 km del centro de Roanne y de los parques empresariales de Mably y Bonvert. El hotel está muy cerca de las autopistas A89 (Lyon) y A72 (St-Étienne - Clermont-Ferrand)."
    ]
  },
