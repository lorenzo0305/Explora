  "rdfs:comment": {
    "de": [
      "Arboria Aventure in Champagny: Hochseilgarten für alle Altersgruppen, ab 3 Jahren! Seilrutschen, Parcours in den Bäumen und Natur im Herzen der Berge. \n Sensationen und Spaß garantiert!"
    ],
    "en": [
      "Arboria Aventure in Champagny: accrobranche park for all ages, from 3 upwards! Zip lines, tree climbing and nature in the heart of the mountains.\n Thrills and fun guaranteed!"
    ],
    "it": [
      "Arboria Aventure a Champagny: un parco avventura per tutte le età, dai 3 anni in su! Traversata tirolese, arrampicata sugli alberi e natura nel cuore delle montagne.\n Emozioni e divertimento garantiti!"
    ],
    "fr": [
      "Arboria Aventure à Champagny : parc accrobranche pour tous les âges, dès 3 ans ! Tyroliennes, parcours dans les arbres et nature au cœur des montagnes. \n Sensations et fun garantis !"
    ],
    "nl": [
      "Arboria Aventure in Champagny: een avonturenpark voor alle leeftijden, vanaf 3 jaar! Tiroolse traverse, boomklimmen en natuur in het hart van de bergen.\n Spanning en plezier gegarandeerd!"
    ],
    "es": [
      "Arboria Aventure en Champagny: ¡un parque de aventuras para todas las edades, a partir de 3 años! Tirolina, arborismo y naturaleza en plena montaña.\n Emoción y diversión garantizadas"
    ]
  },
