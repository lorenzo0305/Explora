  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen die Möglichkeit, einen Tandemflug zu machen oder Gleitschirmpilot zu werden."
    ],
    "en": [
      "Driven by the desire to leave the ground, fly over the peaks, touch the clouds and flirt with birds of prey, we offer you the chance to fly a tandem or become a paragliding pilot."
    ],
    "it": [
      "Spinti dal desiderio di lasciare il suolo, sorvolare le cime, toccare le nuvole e flirtare con i rapaci, vi offriamo la possibilità di volare in parapendio in tandem o di diventare piloti di parapendio."
    ],
    "fr": [
      "Animée par l’envie de quitter le sol, survoler les sommets, toucher les nuages, flirter avec les rapaces nous vous proposons de voler en biplace ou de devenir pilote de parapente."
    ],
    "es": [
      "Impulsados por el deseo de abandonar el suelo, sobrevolar las cumbres, tocar las nubes y coquetear con las aves rapaces, le ofrecemos la posibilidad de volar en parapente biplaza o convertirse en piloto de parapente."
    ],
    "nl": [
      "Gedreven door het verlangen om de grond te verlaten, over de bergtoppen te zweven, de wolken aan te raken en te flirten met roofvogels, bieden we je de kans om met een tandem paraglider te vliegen of om paragliding piloot te worden."
    ]
  },
  "rdfs:label": {
