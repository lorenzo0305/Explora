  "rdfs:comment": {
    "de": [
      "Die Stadt bietet ein angenehmes Lebensumfeld und eine abwechslungsreiche Landschaft. Die Granithänge bieten Wanderwege, die zu herrlichen Aussichtspunkten auf die Rhône und ihren Nebenfluss La Galaure führen."
    ],
    "en": [
      "The town offers a pleasant living environment and varied landscapes. The granite hillsides offer hiking trails that lead to superb viewpoints over the Rhône and its tributary, the Galaure."
    ],
    "it": [
      "Città di Diane de Poitiers. La città offre un ambiente di vita piacevole e paesaggi variegati. Le colline granitiche offrono sentieri escursionistici che conducono a superbi punti di osservazione sul Rodano e sul suo affluente, la Galaure."
    ],
    "fr": [
      "Cité de Diane de Poitiers. La ville offre un cadre de vie agréable et des paysages variés. Les coteaux granitiques proposent des sentiers de randonnée qui aboutissent à de superbes belvédères sur le Rhône et sur son affluent La Galaure."
    ],
    "nl": [
      "De stad biedt een aangename leefomgeving en gevarieerde landschappen. Langs de granieten hellingen lopen wandelpaden naar prachtige uitkijkpunten over de Rhône en zijn zijrivier, de Galaure."
    ],
    "es": [
      "Ciudad de Diane de Poitiers. La ciudad ofrece un entorno de vida agradable y paisajes variados. Las laderas de granito ofrecen rutas de senderismo que conducen a magníficos miradores sobre el Ródano y su afluente, La Galaure."
    ]
  },
