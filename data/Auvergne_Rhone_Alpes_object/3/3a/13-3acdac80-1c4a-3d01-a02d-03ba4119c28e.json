  "rdfs:comment": {
    "de": [
      "Willkommen in Frontonas, das im Südwesten der Balcons du Dauphiné liegt. Die Gemeinde besitzt ein reiches mittelalterliches Erbe, darunter das Château de Saint-Julien, das heute ein Gourmetrestaurant ist, und beherbergt außerdem den Espace Naturel Sensible de la Tourbière de Charamel."
    ],
    "en": [
      "Welcome to Frontonas, located in the south-western part of the Balcons du Dauphiné. The commune boasts a rich medieval heritage, including the Château de Saint-Julien, now a gourmet restaurant, and is also home to the Espace Naturel Sensible de la Tourbière de Charamel."
    ],
    "it": [
      "Benvenuti a Frontonas, situata nel sud-ovest dei Balcons du Dauphiné. Il comune vanta un ricco patrimonio medievale, tra cui il Castello di Saint-Julien, oggi ristorante gourmet, e ospita la torbiera di Charamel."
    ],
    "fr": [
      "Bienvenue à Frontonas, situé au sud-ouest des Balcons du Dauphiné. La commune possède un riche patrimoine médiéval dont le château de Saint-Julien aujourd'hui restaurant gastronomique, et abrite aussi l’Espace Naturel Sensible de la Tourbière de Charamel."
    ],
    "nl": [
      "Welkom in Frontonas, gelegen in het zuidwesten van de Balcons du Dauphiné. De gemeente heeft een rijk middeleeuws erfgoed, waaronder het Château de Saint-Julien, nu een gastronomisch restaurant, en is ook de thuisbasis van het Charamel veengebied."
    ],
    "es": [
      "Bienvenido a Frontonas, situado en el suroeste de los Balcons du Dauphiné. El municipio posee un rico patrimonio medieval, como el castillo de Saint-Julien, hoy restaurante gastronómico, y alberga la turbera de Charamel."
    ]
  },
