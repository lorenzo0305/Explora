  "rdfs:comment": {
    "de": [
      "Eine Küche ... durch die Jahreszeiten hindurch! Die Atmosphäre in diesem Haus wird von den Jahreszeiten bestimmt und ist reich an Geschmäckern und Zutaten, die so unterschiedlich wie vielfältig sind."
    ],
    "en": [
      "The restaurant welcomes you in a warm and authentic atmosphere. Our regional and refined cuisine will make you travel  in the yesteryaear flavors."
    ],
    "it": [
      "Una cucina ... per tutte le stagioni! L'atmosfera di questa casa è scandita dalle stagioni, ricca di sapori e ingredienti tanto diversi quanto variegati."
    ],
    "fr": [
      "Une cuisine ... tout au long des saisons ! L'ambiance dans cette Maison est rythmée par les saisons, riche de goûts et d'ingrédients aussi différents que variés."
    ],
    "es": [
      "Una cocina ... a lo largo de las estaciones La atmósfera de esta casa está marcada por las estaciones, rica en sabores e ingredientes tan diferentes como variados."
    ],
    "nl": [
      "Achter de kerk in Grâne, een hooggelegen dorpje dat uitsteekt boven de Drômevallei, op het kruispunt tussen de Drôme des Collines, de Vercors en de Drôme Provençale."
    ]
  },
