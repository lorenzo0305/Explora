  "rdfs:comment": {
    "de": [
      "Catherine Garret, die Designerin und Kunsthandwerkerin von UNIMOI, fertigt einzigartige Lederwaren, Schmuck und Accessoires aus Rohstoffen und außergewöhnlichen Materialien an, die sie von Hand bearbeitet. Besuche in ihrem Atelier auf Anfrage."
    ],
    "en": [
      "Craftswoman and designer Catherine Garret, creator of UNIMOI, creates one-of-a-kind leather goods, jewelry and accessories from exceptional raw materials that she shapes by hand. Visits to her workshop on request."
    ],
    "it": [
      "L'artigiana e designer Catherine Garret, creatrice di UNIMOI, realizza articoli di pelletteria, gioielli e accessori unici con materie prime eccezionali che lavora a mano. Visite al suo laboratorio su richiesta."
    ],
    "fr": [
      "Artisan et designer, Catherine Garret, créatrice de UNIMOI confectionne des pièces uniques de maroquinerie, bijoux et accessoires à partir de matériaux bruts et d’exceptions qu’elle façonne à la main. Visites de son atelier à la demande."
    ],
    "es": [
      "La artesana y diseñadora Catherine Garret, creadora de UNIMOI, fabrica artículos de cuero, joyas y accesorios únicos a partir de materias primas excepcionales que elabora a mano. Visitas a su taller previa petición."
    ],
    "nl": [
      "Ambachtsvrouw en ontwerpster Catherine Garret, bedenker van UNIMOI, maakt unieke lederwaren, sieraden en accessoires van uitzonderlijke grondstoffen die ze met de hand vormgeeft. Bezoek aan haar atelier op aanvraag."
    ]
  },
  "rdfs:label": {
