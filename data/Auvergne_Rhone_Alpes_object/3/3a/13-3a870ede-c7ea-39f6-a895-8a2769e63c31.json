  "rdfs:comment": {
    "de": [
      "Das Oppidum von Corent überragt stolz das Plateau und offenbart die Überreste einer großen gallischen Stadt. Es war wahrscheinlich die Hauptstadt der Arverner und ist heute eine bedeutende archäologische Stätte inmitten einer spektakulären Landschaft."
    ],
    "en": [
      "Proudly dominating the plateau, the Corent oppidum reveals the remains of a major Gallic city. Probably the capital of the Arvernes, today it offers a major archaeological site in the heart of a spectacular landscape."
    ],
    "it": [
      "Dominando orgogliosamente l'altopiano, l'oppidum di Corent rivela i resti di un'importante città gallica. Probabilmente capitale degli Arvernes, è oggi un importante sito archeologico nel cuore di un paesaggio spettacolare."
    ],
    "fr": [
      "Dominant fièrement le plateau, l’oppidum de Corent révèle les vestiges d’une grande cité gauloise. Probable capitale des Arvernes, il offre aujourd’hui un site archéologique majeur au cœur d’un paysage spectaculaire."
    ],
    "nl": [
      "Het oppidum van Corent, dat trots het plateau domineert, onthult de overblijfselen van een belangrijke Gallische stad. Waarschijnlijk de hoofdstad van de Arvernes, nu een belangrijke archeologische vindplaats in het hart van een spectaculair landschap."
    ],
    "es": [
      "Dominando orgullosamente la meseta, el oppidum de Corent revela los vestigios de una gran ciudad gala. Probablemente la capital de los arvernos, hoy es un importante yacimiento arqueológico en el corazón de un paisaje espectacular."
    ]
  },
  "rdfs:label": {
    "en": [
      "Archaeological site of the oppidum of Corent"
    ],
    "fr": [
      "Site archéologique de l’oppidum gaulois de Corent"
    ]
  },
