  "rdfs:comment": {
    "de": [
      "Der Lac des Plagnes (1191 m, 6,8 ha) ist ein grünes Schmuckkästchen und ein beliebter Ort für Angler. Der See ist dicht besiedelt mit Bachforellen, Regenbogenforellen, Barschen, Schleien und Rotfedern."
    ],
    "en": [
      "The Lac des Plagnes (1191 m, 6.8 ha) is a veritable treasure trove of greenery and a popular spot for anglers. The lake is densely populated with fario trout, rainbow trout, perch, tench and rotengles."
    ],
    "it": [
      "Il Lac des Plagnes (1.191 m, 6,8 ha) è un'oasi di verde e un luogo molto amato dai pescatori. Il lago è densamente popolato da trote fario, trote iridee, persici, tinche e rombi."
    ],
    "fr": [
      "Véritable écrin de verdure, le lac des Plagnes (1191 m, 6,8 ha) est un lieu très apprécié des des pêcheurs. Le lac est densément peuplé en truites fario, truites arc-en-ciel, perches, tanches, rotengles."
    ],
    "nl": [
      "Het Lac des Plagnes (1.191 m, 6,8 ha) is een oase van groen en een populaire plek voor vissers. Het meer is dichtbevolkt met fario forel, regenboogforel, baars, zeelt en rotengles."
    ],
    "es": [
      "El Lac des Plagnes (1.191 m, 6,8 ha) es un remanso de verdor y un lugar muy frecuentado por los pescadores. El lago está densamente poblado de truchas fario, truchas arco iris, percas, tencas y rotengles."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at the Lac des Plagnes"
    ],
    "fr": [
      "Pêche au lac des Plagnes"
    ],
    "nl": [
      "Vissen bij Lac des Plagnes"
    ]
  },
