  "rdfs:comment": {
    "de": [
      "Ein halbsteifes Mountainbike. Dieses leicht zu bedienende Fahrrad ist ideal für einen Ausflug abseits der ausgetretenen Pfade. Ausgestattet mit Scheibenbremsen, einem verstärkten Display und einer Federgabel, wird Sie dieses Mountainbike auf den Wegen der Ardèche überall hin mitnehmen!"
    ],
    "en": [
      "Semi-rigid mountain bike. This easy-to-use bike is ideal for off-road cycling. Equipped with disc brakes, a reinforced display and suspension forks, this mountain bike will take you anywhere on the trails of the Ardèche!"
    ],
    "it": [
      "Mountain bike semirigida. Facile da usare, questa bicicletta è ideale per un giro in fuoristrada. Dotata di freni a disco, display rinforzato e forcella sospesa, questa VTC vi porterà ovunque sui sentieri dell'Ardéchois!"
    ],
    "fr": [
      "VTC semi-rigide. Facile d'utilisation ce vélo est idéal pour une sortie hors des sentiers battus. Équipé de freins à disque, d'un display renforcé, d'une fourche à suspension, ce VTC vous emmènera partout sur les chemins Ardéchois !"
    ],
    "nl": [
      "Semi-stijve mountainbike. Deze gebruiksvriendelijke fiets is ideaal voor off-road fietsen. Uitgerust met schijfremmen, een verstevigd display en verende voorvorken, brengt deze mountainbike je overal op de paden van de Ardèche!"
    ],
    "es": [
      "Bicicleta de montaña semirrígida. Fácil de usar, esta bicicleta es ideal para un paseo fuera de la carretera. Equipada con frenos de disco, una pantalla reforzada y una horquilla de suspensión, ¡esta VTC te llevará a cualquier lugar de los senderos de Ardéchois!"
    ]
  },
  "rdfs:label": {
    "de": [
