  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich in der privilegierten Umgebung des Weilers Le Gua (Straße D203) am Ufer des Flusses La Beaume.\r\nWir bieten eine traditionelle hausgemachte Küche mit einer regelmäßig wechselnden Speisekarte und außerhalb der Essenszeiten eine Snackkarte."
    ],
    "en": [
      "The restaurant is located in the privileged setting of the hamlet of Gua (road D203) on the banks of the river La Beaume.\r\nWe propose a traditional home-made cooking with a regularly renewed menu and, out of meal times, a snack menu."
    ],
    "it": [
      "Il ristorante si trova nella cornice privilegiata della frazione di Le Gua (strada D203), sulle rive del fiume La Beaume.\r\nOffriamo una cucina casalinga tradizionale con un menu regolarmente rinnovato e, al di fuori degli orari dei pasti, un menu per la merenda."
    ],
    "fr": [
      "Le restaurant se situe dans le cadre privilégié du hameau du Gua (route D203) au bord de la rivière La Beaume.\r\nNous proposons une cuisine traditionnelle maison avec une carte renouvelée régulièrement et, en dehors des heures de repas, une carte snack."
    ],
    "nl": [
      "Het restaurant is gelegen in de bevoorrechte omgeving van het gehucht Le Gua (weg D203) aan de oevers van de rivier La Beaume.\r\nWij bieden een traditionele thuiskeuken met een regelmatig vernieuwd menu en, buiten de maaltijden om, een snackmenu."
    ],
    "es": [
      "El restaurante está situado en el entorno privilegiado de la aldea de Le Gua (carretera D203), a orillas del río La Beaume.\r\nOfrecemos cocina casera tradicional con un menú renovado regularmente y, fuera de las horas de comida, un menú de aperitivos."
    ]
  },
