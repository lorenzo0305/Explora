  "rdfs:comment": {
    "de": [
      "Die Kneipe für Après-Ski in Mottaret, mit lokalen Bieren oder Guinness vom Fass, hausgemachten Cocktails und über 50 Spirituosen in Rock’n’Roll-Atmosphäre. Live-Sport auf 3 Bildschirmen, darunter eine GROSSE Leinwand. Live-Musik beim Après-Ski & abends (siehe Facebook & Instagram). Happy Hour täglich von 16:30 bis 18:00 Uhr!"
    ],
    "en": [
      "THE pub for après-ski in Mottaret, with local beers or draft Guinness, homemade cocktails and over 50 spirits in a Rock’n’Roll atmosphere. Live sports on 3 screens including a BIG one. Live music après-ski & evenings (see Facebook & Instagram). Happy Hour 4:30–6 daily!"
    ],
    "it": [
      "Il bar/pub di Mottaret con un'ottima selezione di birre (tra cui una prodotta per il locale o Guinness alla spina), cocktail e alcolici con una colonna sonora rock'n'roll\r\nSport in diretta su 3 schermi, happy hour dalle 16.30 alle 18.00, musica dal vivo dopo lo sci/serata"
    ],
    "fr": [
      "LE bar/pub à Mottaret avec une belle sélection de bières (dont une brassée pour l'établissement ou Guinness pression) cocktails et spiritueux sur un fond de Rock' n' Roll\r\nSport live sur 3 écrans, happy hour de 16h30 à 18h, live music en après ski/soirée"
    ],
    "es": [
      "El pub para el après-ski en Mottaret, con cervezas locales o Guinness de barril, cócteles caseros y más de 50 licores en un ambiente de Rock’n’Roll. Deportes en directo en 3 pantallas, incluida una GRAN pantalla. Música en vivo en el après-ski y por la noche (ver Facebook & Instagram). Happy Hour todos los días de 16:30 a 18:00."
    ],
    "nl": [
      "Dé kroeg voor après-ski in Mottaret, met lokale bieren of Guinness van het vat, huisgemaakte cocktails en meer dan 50 sterke dranken in een Rock’n’Roll-sfeer. Live sport op 3 schermen, waaronder een GROOT scherm. Live muziek tijdens après-ski en ’s avonds (zie Facebook & Instagram). Happy Hour elke dag van 16:30 tot 18:00!"
    ]
  },
