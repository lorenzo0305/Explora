  "rdfs:comment": {
    "de": [
      "Die 2017 gegründete Alimentation Générale ist eine allgemeine Buchhandlung mit über 14 000 Artikeln auf weniger als 35 m2! Unter ihrem langen weißen Gewölbe können Sie Geist und Herz erfrischen."
    ],
    "en": [
      "Created in 2017, Alimentation Générale is a general bookshop, with over 14,000 references in less than 35 m2! Under its long white vault, come and refresh your mind and heart."
    ],
    "it": [
      "Creata nel 2017, l'Alimentation Générale è una libreria generale, con più di 14.000 referenze su meno di 35 m2! Sotto la sua lunga volta bianca, venite a rinfrescare la mente e il cuore."
    ],
    "fr": [
      "Créée en 2017, l'Alimentation Générale est une librairie généraliste, avec plus de 14 000 références sur moins de 35 m2 ! Sous sa longue voûte blanche, venez vous rafraîchir l'esprit et le cœur."
    ],
    "es": [
      "Creada en 2017, la Alimentation Générale es una librería generalista, ¡con más de 14.000 referencias en menos de 35 m2! Bajo su larga bóveda blanca, ven a refrescar tu mente y tu corazón."
    ],
    "nl": [
      "Alimentation Générale, opgericht in 2017, is een algemene boekhandel met meer dan 14.000 referenties op minder dan 35 m2! Onder het lange witte gewelf kunt u uw geest en hart komen verfrissen."
    ]
  },
