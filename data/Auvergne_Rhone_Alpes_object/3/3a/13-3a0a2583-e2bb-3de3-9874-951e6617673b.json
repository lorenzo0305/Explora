  "rdfs:comment": {
    "de": [
      "Vor 40 Jahren legte Sanoflore seinen Garten an, um aromatische und medizinische Pflanzen anzubauen und daraus ätherische Öle zu gewinnen. Der botanische Garten umfasst eine Sammlung von 350 Pflanzensorten, die von dem Labor verwendet werden."
    ],
    "en": [
      "40 years ago, Sanoflore set up its botanical garden to grow aromatic and medicinal plants and extract their essential oils. The botanical garden houses a collection of 350 plant varieties used by the laboratory."
    ],
    "it": [
      "Quarant'anni fa, Sanoflore ha creato il suo giardino per coltivare piante aromatiche e medicinali ed estrarre oli essenziali. Il giardino botanico contiene una collezione di 350 varietà di piante utilizzate dal laboratorio."
    ],
    "fr": [
      "Il y a 40 ans, Sanoflore installait son jardin pour cultiver des plantes aromatiques et médicinales et en extraire les huiles essentielles. Le jardin botanique  réunit une collection 350 variétés de plantes utilisées par le laboratoire."
    ],
    "es": [
      "Hace cuarenta años, Sanoflore creó su jardín para cultivar plantas aromáticas y medicinales y extraer aceites esenciales. El jardín botánico contiene una colección de 350 variedades de plantas utilizadas por el laboratorio."
    ],
    "nl": [
      "40 jaar geleden richtte Sanoflore zijn tuin in om aromatische en geneeskrachtige planten te kweken en hun essentiële oliën te extraheren. De botanische tuin bevat een verzameling van 350 plantensoorten die door het laboratorium worden gebruikt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jardin botanique - Sanoflore"
    ]
  },
