  "rdfs:comment": {
    "de": [
      "Nicolas Guyot bietet Ihnen eine einfache und schmackhafte traditionelle Küche, die aus frischen und lokalen Produkten zubereitet und zu einem guten Preis-Leistungs-Verhältnis angeboten wird."
    ],
    "en": [
      "Nicolas Guyot offers simple, tasty traditional cuisine made with fresh, local produce and offering good value for money."
    ],
    "it": [
      "Nicolas Guyot offre una cucina tradizionale semplice e gustosa, a base di prodotti freschi locali, con un buon rapporto qualità-prezzo."
    ],
    "fr": [
      "Nicolas Guyot vous propose une cuisine traditionnelle simple et savoureuse, élaborée à base de produits frais et locaux, et proposée à un bon rapport qualité-prix."
    ],
    "es": [
      "Nicolas Guyot ofrece una cocina tradicional sencilla y sabrosa, elaborada con productos locales frescos, con una buena relación calidad-precio."
    ],
    "nl": [
      "Nicolas Guyot biedt een eenvoudige en smakelijke traditionele keuken, bereid met verse streekproducten, tegen een goede prijs-kwaliteitverhouding."
    ]
  },
