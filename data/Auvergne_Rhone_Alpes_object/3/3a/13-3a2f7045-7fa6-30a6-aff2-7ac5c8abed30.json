  "rdfs:comment": {
    "de": [
      "Wir organisieren Abfahrten von 6, 24 oder 30 km an einem halben Tag, 1 Tag , 2 Tagen und mehr mit Biwaks."
    ],
    "en": [
      "A small family business, Aventure canoës organizes canoe or kayak descents of 8 km, 13 km, 24 km or 32 km, over half a day, 1 day, 2 days and more with bivouac."
    ],
    "it": [
      "Aventure canoës è una piccola azienda a conduzione familiare che organizza escursioni in canoa o kayak di 5 km, 7 km, 12 km, 24 km o 31 km, per mezza giornata, 1 giorno, 2 giorni o più, con bivacco."
    ],
    "fr": [
      "Petite structure familiale, Aventure canoës organise des descentes en canoës ou kayak de 5 km, 7km, 12 km, 24 km ou 31 km, sur une demi-journée, 1 jour, 2 jours et plus avec bivouac."
    ],
    "nl": [
      "Een klein familiaal bedrijf. Aventure Canoë organiseerd verschillende afvaarten van 8, 13, 24 of 32 km, Dit gedurende een halve dag, een hele dag of 2 dagen met bivak."
    ],
    "es": [
      "Aventure canoës es una pequeña empresa familiar que organiza excursiones en canoa o kayak de 5 km, 7 km, 12 km, 24 km o 31 km, de media jornada, 1 día, 2 días o más, con vivac."
    ]
  },
