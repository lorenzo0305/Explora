  "rdfs:comment": {
    "de": [
      "Die Küche richtet sich nach dem jahreszeitlichen Angebot auf dem Markt. Grundsätzlich frische Zutaten. Herzlicher Empfang in modernem Ambiente."
    ],
    "en": [
      "Seasonal cuisine according to the market displays. The freshest products. A warm welcome in a contemporary setting."
    ],
    "it": [
      "Ristorante che offre un'autentica cucina francese in un ambiente elegante. Si impegna a fornire agli ospiti un'esperienza culinaria eccezionale utilizzando ingredienti freschi e di qualità."
    ],
    "fr": [
      "Restaurant proposant une cuisine française authentique dans un cadre élégant. Attaché à offrir à aux clients une expérience culinaire exceptionnelle avec des ingrédients frais et de qualité."
    ],
    "es": [
      "Restaurante que ofrece auténtica cocina francesa en un entorno elegante. Comprometidos a proporcionar a los huéspedes una experiencia culinaria excepcional con ingredientes frescos y de calidad."
    ],
    "nl": [
      "Restaurant met authentieke Franse keuken in een elegante omgeving. Toegewijd om gasten een uitzonderlijke culinaire ervaring te bieden met verse ingrediënten van hoge kwaliteit."
    ]
