  "rdfs:comment": {
    "de": [
      "Das Geschäft Maison Chapuis Yssingeaux ist da, um Sie bei der Durchführung Ihrer Renovierungs- oder Bauprojekte in Yssingeaux zu betreuen und zu beraten.\r\n\r\nBis bald bei Maison Chapuis Yssingeaux."
    ],
    "en": [
      "The Maison Chapuis Yssingeaux store is there to guide and advise you in carrying out your renovation or construction projects in Yssingeaux.\r\n\r\nSee you soon at Maison Chapuis Yssingeaux."
    ],
    "it": [
      "Il negozio della Maison Chapuis Yssingeaux è a disposizione per guidarvi e consigliarvi in tutti i vostri progetti di ristrutturazione e costruzione a Yssingeaux.\r\n\r\nCi vediamo presto alla Maison Chapuis Yssingeaux."
    ],
    "fr": [
      "Le magasin Maison Chapuis Yssingeaux est là pour vous guider et vous conseiller dans la réalisation de vos projets de rénovation ou de construction à Yssingeaux.\r\n\r\nA très bientôt chez Maison Chapuis Yssingeaux."
    ],
    "es": [
      "La tienda Maison Chapuis Yssingeaux está a su disposición para guiarle y aconsejarle en todos sus proyectos de renovación y construcción en Yssingeaux.\r\n\r\nNos vemos pronto en Maison Chapuis Yssingeaux."
    ],
    "nl": [
      "De winkel van Maison Chapuis Yssingeaux is er om je te begeleiden en te adviseren bij al je renovatie- en bouwprojecten in Yssingeaux.\r\n\r\nTot binnenkort bij Maison Chapuis Yssingeaux."
    ]
  },
