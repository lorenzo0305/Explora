  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/955c3b69-f079-36bd-9cb7-17601f66eede",
      "dc:description": {
        "de": [
          "-Anstoßen, essen, teilen\n- lokale Produkte\n- Gerichte der Woche\n-l'esprit Sablons\n- tapas\n\nlokale Produkte, kurze Wege, ökologische Haushaltsprodukte, Anti-Verschwendung\n\nBietet ein Kindermenü an"
        ],
        "en": [
          "-Drink, eat, share\n- local products\n- Dishes of the week\n-l'esprit Sablons\n- tapas\n\nlocal products, short circuit, ecological household products, anti-gaspi\n\nChildren's menu"
        ],
        "it": [
          "-Bere, mangiare, condividere\n- prodotti locali\n- I piatti della settimana\n-lo spirito di Sablons\n- tapas\n\nprodotti locali, cortocircuito, prodotti ecologici per la casa, anti-gaspi\n\nMenu per bambini"
        ],
        "fr": [
          "-Trinquer, manger, partager\n- produits Locaux\n- Plats de la semaine\n-l'esprit Sablons\n- tapas\n\nproduits locaux, circuit court, produits ménagers écologique, anti-gaspi \n\nPropose un menu enfant"
        ],
        "nl": [
          "-Drinken, eten, delen\n- lokale producten\n- Gerechten van de week\n-de geest van Sablons\n- tapas\n\nlokale producten, kortsluiting, ecologische huishoudelijke producten, anti-gaspi\n\nKindermenu"
        ],
        "es": [
          "-Beber, comer, compartir\n- productos locales\n- Platos de la semana\n-el espíritu Sablons\n- tapas\n\nproductos locales, cortocircuito, productos ecológicos para el hogar, antigaspi\n\nMenú infantil"
        ]
      },
