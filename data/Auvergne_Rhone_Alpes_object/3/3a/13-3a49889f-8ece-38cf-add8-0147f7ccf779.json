  "rdfs:comment": {
    "de": [
      "Karpfen, Forellen. Verwaltung, Karten und Öffnungszeiten, erkundigen Sie sich. Picknickplatz am Teich. Betrieb vom 01/03 bis 31/08 (vorher erkundigen, M. Faure, Tabakladen l'Eldorado in Costaros)."
    ],
    "en": [
      "Carp, trout. Management, maps and schedules, ask for details. Pond picnic area. Open from 01/03 to 31/08 (ask for details beforehand, M. Faure, Eldorado tobacconist's in Costaros)."
    ],
    "it": [
      "Carpa, trota. Gestione, mappe e orari, chiedere informazioni. Area picnic presso il laghetto. Aperto dal 01/03 al 31/08 (informarsi prima presso M. Faure, tabaccheria Eldorado a Costaros)."
    ],
    "fr": [
      "Carpes, truites. Gestion, cartes et horaires, se renseigner. Aire de pique-nique de l'étang. Fonctionnement du 01/03 au 31/08 (se renseigner auparavant, M. Faure, bureau de tabac l'Eldorado de Costaros)."
    ],
    "nl": [
      "Karper, forel. Beheer, kaarten en dienstregelingen, vraag naar details. Picknickplaats bij de vijver. Open van 01/03 tot 31/08 (informeer vooraf bij M. Faure, Eldorado tabakswinkel in Costaros)."
    ],
    "es": [
      "Carpas, truchas. Gestión, mapas y horarios, consultar. Zona de picnic junto al estanque. Abierto del 01/03 al 31/08 (informarse previamente en M. Faure, estanco Eldorado de Costaros)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etang du Pechay"
    ]
  },
