  "rdfs:comment": {
    "de": [
      "Einführung in den Reitsport. Unterricht, Vorbereitungskurse für die Galoppprüfung. Pensionen für Pferde und Ponys. Wettkämpfe für Vereine und Amateure. Ausritte im August, Grasplätze, Dressur, Cso, Reithalle, Paddock."
    ],
    "en": [
      "Introduction to horse riding. Teaching, preparatory courses for the passage of gallops. Pensions for horses and ponies. Club and amateur competitions. Hikes in August, grass quarries, dressage, cso, manége, paddock."
    ],
    "it": [
      "Introduzione all'equitazione. Insegnamento, corsi preparatori per il passaggio al galoppo. Pensione per cavalli e pony. Competizioni di club e amatoriali. Cavalcate in agosto, maneggi in erba, dressage, cso, maneggio, paddock."
    ],
    "fr": [
      "Initiation à l'équitation. Enseignement, stages préparatoires au passage de galops. Pensions pour chevaux et poneys. Compétitions club et amateur. Randonnées en août, carriéres en herbe, dressage, cso, manége, paddock."
    ],
    "nl": [
      "Kennismaking met paardrijden. Onderwijs, voorbereidende cursussen voor de passage van galop. Stalling voor paarden en pony's. Club- en amateurwedstrijden. Ritten in augustus, grasbakken, dressuur, cso, manege, paddock."
    ],
    "es": [
      "Introducción a la equitación. Enseñanza, cursos preparatorios para el paso de galopes. Pensión para caballos y ponis. Competiciones de clubes y aficionados. Paseos en agosto, picaderos de hierba, doma, cso, manege, paddock."
    ]
  },
