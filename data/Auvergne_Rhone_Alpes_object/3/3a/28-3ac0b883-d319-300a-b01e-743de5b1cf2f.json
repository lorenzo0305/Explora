  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b82e5fac-ea28-3e1c-ab0f-34bb3d1b058e",
      "dc:description": {
        "de": [
          "CHEZ NÈNE, bietet traditionelle und authentische westafrikanische Küche, schmackhafte und farbenfrohe Gerichte, die mit Liebe zubereitet und aus frischen und hochwertigen Zutaten zusammengestellt werden, die jedem Bissen einen einzigartigen und authentischen Geschmack verleihen."
        ],
        "en": [
          "CHEZ NÈNE, offers traditional and authentic West African cuisine, tasty and colorful dishes prepared with love and composed of fresh, quality ingredients, giving a unique and authentic flavor to every bite."
        ],
        "it": [
          "CHEZ NÈNE offre una cucina tradizionale e autentica dell'Africa occidentale, con piatti gustosi e colorati preparati con amore utilizzando ingredienti freschi e di qualità, che conferiscono un sapore unico e autentico a ogni boccone."
        ],
        "fr": [
          "CHEZ NÈNE, propose une cuisine traditionnelle et authentique ouest-africaine, des plats savoureux et hauts en couleurs préparés avec amour et composer d’ingrédients frais et de qualité, donnant une saveur unique et authentique à chaque bouchée."
        ],
        "es": [
          "CHEZ NÈNE ofrece una cocina tradicional y auténtica de África Occidental, con platos sabrosos y coloridos preparados con cariño con ingredientes frescos y de calidad, que dan un sabor único y auténtico a cada bocado."
        ],
        "nl": [
          "CHEZ NÈNE biedt een traditionele, authentieke West-Afrikaanse keuken, met smakelijke, kleurrijke gerechten die met liefde worden bereid met verse ingrediënten van hoge kwaliteit, waardoor elke hap een unieke, authentieke smaak krijgt."
        ]
      },
      "@type": [
        "Description"
      ],
