  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der Seilbahn entfernt, in einem Bergdekor oder auf der Südterrasse, genießen Sie Spezialitäten und eine Gourmetküche in der Nähe der Pisten und Wanderwege."
    ],
    "en": [
      "Opposite the cable car, in a typical mountain setting or at the south facing terrace, come and taste our specialities, near the slopes and hiking paths."
    ],
    "it": [
      "A due passi dalla funivia, in un ambiente montano o sulla terrazza esposta a sud, venite a gustare le nostre specialità e la nostra cucina gourmet, vicino alle piste e ai sentieri escursionistici."
    ],
    "fr": [
      "A deux pas de la télécabine, dans un décor montagnard ou sur la terrasse plein sud, venez déguster les spécialités et une cuisine gourmande, proche des pistes et des chemins de randonnées."
    ],
    "nl": [
      "Op een steenworp afstand van de kabelbaan, in een bergomgeving of op het terras op het zuiden, kom genieten van onze specialiteiten en gastronomische keuken, dicht bij de pistes en wandelpaden."
    ],
    "es": [
      "A un paso del teleférico, en un entorno de montaña o en la terraza orientada al sur, venga a disfrutar de nuestras especialidades y de la cocina gourmet, cerca de las pistas y de las rutas de senderismo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant l'Ecureuil"
    ],
    "en": [
      "Ecureuil restaurant"
    ],
    "fr": [
      "Restaurant l'Ecureuil"
    ]
  },
