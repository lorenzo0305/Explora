  "rdfs:comment": {
    "de": [
      "Betrieb mit seinen Herden von Kühen der Rasse Aubrac, die für den biologischen Landbau zertifiziert sind, Hanfanbau und Verkauf von Trockenblumen für Privatpersonen, Brauereien. Direktverkauf von Rindfleisch, Kälbern. Verkauf von Färsen. Unterkunft auf dem Bauernhof."
    ],
    "en": [
      "Farm with its herds of cows of Aubrac breed certified organic agriculture, hemp cultivation and sale of dried flowers for private individuals, brewers . Sale on the farm on Saturday morning. Visit of the farm on appointment. Cottage on the farm."
    ],
    "it": [
      "Azienda agricola con mandrie di vacche Aubrac certificate biologiche, coltivazione di canapa e vendita di fiori secchi a privati e produttori di birra. Vendita diretta di carne bovina. Vendita di manze. Gîte nella fattoria."
    ],
    "fr": [
      "Exploitation avec ses troupeaux de vaches de race Aubrac certifiés agriculture biologique, culture de chanvre et vente de fleurs séchées pour particuliers, brasseurs. Vente directe de viande de boeuf, veaux. Vente de génisses. Gîte à la ferme."
    ],
    "es": [
      "Granja con rebaños de vacas Aubrac con certificación ecológica, cultivo de cáñamo y venta de flores secas a particulares y cerveceros. Venta directa de carne de vacuno. Venta de novillas. Casa rural en la granja."
    ],
    "nl": [
      "Boerderij met kuddes gecertificeerde biologische Aubrac-koeien, hennepteelt en verkoop van gedroogde bloemen aan particulieren en brouwers. Directe verkoop van rundvlees. Verkoop van vaarzen. Gîte op de boerderij."
    ]
  },
  "rdfs:label": {
    "en": [
      "Jargot's Farm"
    ],
    "fr": [
      "Ferme Jargot"
    ]
  },
