  "rdfs:comment": {
    "de": [
      "Spielerischer und interaktiver Parcours: Entdeckung der Sanddünen, der Vögel auf der Wiese, der Süßwasserfische... dank Touchscreens. Ab April 2025: eine neue App für eine immersive, visuelle und akustische Reise."
    ],
    "en": [
      "A fun, interactive tour: discover sand dunes, prairie birds, freshwater fish... using touch screens. From April 2025, a new app for an immersive visual and audio journey."
    ],
    "it": [
      "Un tour divertente e interattivo: scoprite le dune di sabbia, gli uccelli del prato, i pesci d'acqua dolce... utilizzando i touch screen. Da aprile 2025, una nuova app per un viaggio visivo e sonoro coinvolgente."
    ],
    "fr": [
      "Parcours ludique et interactif : découverte des dunes de sable, des oiseaux de la prairie, des poissons d'eau douce... grâce à des écrans tactiles. A partir d'avril 2025, une nouvelle appli pour une voyage immersif, visuel et sonore."
    ],
    "es": [
      "Un recorrido lúdico e interactivo: descubra las dunas, las aves de la pradera, los peces de agua dulce... mediante pantallas táctiles. A partir de abril de 2025, una nueva app para un viaje visual y sonoro inmersivo."
    ],
    "nl": [
      "Een leuke en interactieve rondleiding: ontdek de zandduinen, de vogels van het weiland, de zoetwatervissen... met behulp van aanraakschermen. Vanaf april 2025, een nieuwe app voor een meeslepende visuele en audioreis."
    ]
  },
