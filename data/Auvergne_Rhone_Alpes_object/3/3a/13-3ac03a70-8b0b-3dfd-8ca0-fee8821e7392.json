  "rdfs:comment": {
    "de": [
      "Traditionelle Restauration in einer herzlichen und familiären Atmosphäre rund um die Menüs Aufschnitt, Rühreier, Brasérade.\r\nMittags Express-Menü: Entrecôte + hausgemachte Pommes frites + Salat + hausgemachtes Dessert."
    ],
    "en": [
      "Traditional catering in a warm, family atmosphere with charcuterie, râpée and brasérade menus.\r\nLunchtime express menu: entrecôte + home fries + salad + home-made dessert."
    ],
    "it": [
      "Cucina tradizionale in un'atmosfera calda e familiare, con menu a base di salumi, grattugiati e brasati.\r\nMenu espresso a pranzo: bistecca entrecôte + patatine fritte fatte in casa + insalata + dessert fatto in casa."
    ],
    "fr": [
      "Restauration traditionnelle dans une ambiance chaleureuse et familiale autour de menus charcuterie, râpée, brasérade.\r\nMenu express à midi : entrecôte + frites maison + salade + dessert maison."
    ],
    "nl": [
      "Traditioneel tafelen in een warme, familiale sfeer, met menu's van vleeswaren, geraspt vlees en gestoofd vlees.\r\nExpress menu 's middags: entrecôte steak + huisgemaakte frietjes + salade + huisgemaakt dessert."
    ],
    "es": [
      "Cena tradicional en un ambiente cálido y familiar, con menús de charcutería, carne rallada y carne estofada.\r\nMenú exprés al mediodía: entrecot + patatas fritas caseras + ensalada + postre casero."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ravarine"
    ]
  },
