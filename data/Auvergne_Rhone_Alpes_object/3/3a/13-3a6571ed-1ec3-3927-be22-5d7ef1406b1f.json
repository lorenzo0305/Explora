  "rdfs:comment": {
    "de": [
      "Bar, Wein, Bier, hausgemachte Cocktails, Tapas, kleine Snacks, süße oder salzige Snacks und Eis, Spezialitäten am Abend.\r\nIm oberen Teil des Dorfes in der Nähe des Wasserspiegels gelegen. Entspannte Atmosphäre."
    ],
    "en": [
      "Bar, wine, beer, house cocktails, tapas, snacks, sweet and savoury snacks and ice creams, evening specialities.\r\nLocated at the top of the village near the lake. Relaxed atmosphere."
    ],
    "it": [
      "Bar, vino, birra, cocktail della casa, tapas, spuntini, snack dolci e salati e gelati, specialità serali.\r\nSituato nella parte alta del paese, vicino al lago. Atmosfera rilassata."
    ],
    "fr": [
      "Bar, vin, bières, cocktails maison, tapas, petite restauration, goûters sucrés ou salés et glaces, spécialités le soir.\r\nSitué sur le haut du village proche du plan d'eau. Ambiance décontractée."
    ],
    "nl": [
      "Bar, wijn, bier, huisgemaakte cocktails, tapas, snacks, zoete en hartige hapjes en ijsjes, avondspecialiteiten.\r\nGelegen boven in het dorp, vlakbij het meer. Ontspannen sfeer."
    ],
    "es": [
      "Bar, vino, cerveza, cócteles de la casa, tapas, aperitivos, bocadillos dulces y salados y helados, especialidades nocturnas.\r\nSituado en lo alto del pueblo, cerca del lago. Ambiente relajado."
    ]
  },
