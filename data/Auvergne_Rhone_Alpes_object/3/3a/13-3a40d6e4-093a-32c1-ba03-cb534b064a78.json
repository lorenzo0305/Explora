  "rdfs:comment": {
    "de": [
      "Nathalie Nyault, Töpferin und Kunsthandwerkerin, empfängt Sie in ihrem Atelier/Laden. Sie stellt Gebrauchskeramik aus Steinzeug her und bietet Kurse zur Entdeckung der Töpferei an. Entdecken Sie ihre einzigartigen, handgefertigten Töpferwaren."
    ],
    "en": [
      "Nathalie Nyault, artisan d'art, welcomes you to her workshop/boutique. She creates utilitarian stoneware ceramics and offers pottery discovery courses. Discover her unique, hand-crafted creations."
    ],
    "it": [
      "Nathalie Nyault, artigiana ceramista, vi dà il benvenuto nel suo studio/negozio. Crea ceramiche utilitarie in gres e offre corsi di scoperta della ceramica. Scoprite le sue ceramiche uniche e artigianali."
    ],
    "fr": [
      "Nathalie Nyault, potière artisan d'art, vous accueille dans son atelier/boutique. Elle crée des céramiques utilitaires en grès et propose des stages de découverte de la poterie. Découvrez ses poteries uniques et artisanales."
    ],
    "nl": [
      "Nathalie Nyault, ambachtelijke pottenbakker, heet je welkom in haar atelier/winkel. Ze maakt gebruikskeramiek van steengoed en biedt cursussen pottenbakken aan. Ontdek haar unieke, handgemaakte aardewerk."
    ],
    "es": [
      "Nathalie Nyault, alfarera artesana, le da la bienvenida a su taller/tienda. Crea cerámicas utilitarias de gres y ofrece cursos de descubrimiento de la alfarería. Descubra su cerámica artesanal única."
    ]
  },
  "rdfs:label": {
    "en": [
      "Terres de Couleurs - Atelier céramique"
    ],
    "fr": [
      "Atelier Terres de Couleurs - céramique"
    ]
  },
