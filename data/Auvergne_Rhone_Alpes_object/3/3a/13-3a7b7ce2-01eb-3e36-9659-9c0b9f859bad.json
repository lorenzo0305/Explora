  "rdfs:comment": {
    "de": [
      "Die A V E wurde am 29. Januar 1984 gegründet, um dem wachsenden Wunsch der Studenten nachzukommen, sich in einer gemeinsamen Körperschaft zusammenfinden zu können, die ihren Geist verteidigt und einen neuen, sich ausdehnenden Universitätspol dynamisch gestaltet."
    ],
    "en": [
      "A V E was created on January 29, 1984 in response to the growing desire of students to be able to come together within a common entity that would defend their spirit and energize a new, rapidly expanding university hub."
    ],
    "it": [
      "L'AVE è stata creata il 29 gennaio 1984 per rispondere al crescente desiderio degli studenti di potersi riunire all'interno di un'entità comune che ne difendesse lo spirito e desse energia a un nuovo centro universitario in piena espansione."
    ],
    "fr": [
      "L'A V E fut créée le 29 janvier 1984 afin de répondre à la volonté croissante des étudiants de pouvoir se retrouver au sein d’une entité commune défendant leur esprit et dynamisant un nouveau pôle universitaire en pleine extension."
    ],
    "es": [
      "El AVE se creó el 29 de enero de 1984 para responder al creciente deseo de los estudiantes de poder reunirse en una entidad común que defendiera su espíritu y dinamizara un nuevo centro universitario en plena expansión."
    ],
    "nl": [
      "De AVE werd opgericht op 29 januari 1984 als antwoord op het groeiende verlangen van studenten om zich te kunnen verenigen in een gemeenschappelijke entiteit die hun geest zou verdedigen en energie zou geven aan een nieuw universitair centrum dat zich snel uitbreidde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Valentinoise des Etudiants"
    ]
  },
