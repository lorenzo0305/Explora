  "rdfs:comment": {
    "de": [
      "Die Mediathek von Saint-Agrève ist Teil des Netzwerks Pays-Lecture, das alle Maßnahmen zur Förderung von Büchern, Lesen und Spielen auf dem Plateau Vivarais-Lignon umfasst."
    ],
    "en": [
      "The Saint-Agrève media library is part of the Pays-Lecture network, which brings together all the actions aimed at promoting books, reading and games on the Plateau Vivarais-Lignon."
    ],
    "it": [
      "La mediateca di Saint-Agrève fa parte della rete Pays-Lecture, che riunisce tutte le azioni di promozione del libro, della lettura e del gioco sull'altopiano di Vivarais-Lignon."
    ],
    "fr": [
      "La médiathèque de Saint-Agrève fait partie du réseau Pays-Lecture, qui regroupe l'ensemble des actions visant la promotion du livre, de la lecture et du jeu sur le Plateau Vivarais-Lignon."
    ],
    "es": [
      "La mediateca de Saint-Agrève forma parte de la red Pays-Lecture, que reúne todas las acciones de promoción del libro, la lectura y el juego en la meseta de Vivarais-Lignon."
    ],
    "nl": [
      "De mediatheek van Saint-Agrève maakt deel uit van het netwerk Pays-Lecture, dat alle acties ter bevordering van boeken, lezen en spelen op het plateau van Vivarais-Lignon bundelt."
    ]
  },
  "rdfs:label": {
