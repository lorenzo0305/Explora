  "rdfs:comment": {
    "de": [
      "Die 1789 vom Marquis de Lévis, Antoine de Sinéty, am Vorabend der Französischen Revolution gegründete Porzellanmanufaktur von Couleuvre legt von Künstlern entworfene Objekte neu auf; Alltagsgegenstände aus Porzellan."
    ],
    "en": [
      "Created in 1789 by the Marquis de Lévis, Antoine de Sinéty, on the eve of the French Revolution, the Porcelain Factory of Couleuvre reissues objects created by artists; everyday objects in porcelain."
    ],
    "it": [
      "Creata nel 1789 dal marchese di Lévis, Antoine de Sinéty, alla vigilia della Rivoluzione francese, la fabbrica Porcelaine de Couleuvre riedita oggetti creati da artisti, oggetti di porcellana di uso quotidiano."
    ],
    "fr": [
      "Créée en 1789 par le Marquis de Lévis, Antoine de Sinéty, à la veille de la Révolution française, la manufacture de Porcelaine de Couleuvre réédite des objets créés par des artistes ; des objets du quotidien en porcelaine."
    ],
    "nl": [
      "De fabriek Porcelaine de Couleuvre, in 1789 opgericht door de markies van Lévis, Antoine de Sinéty, aan de vooravond van de Franse Revolutie, geeft voorwerpen uit die door kunstenaars zijn gemaakt; alledaagse porseleinen voorwerpen."
    ],
    "es": [
      "Creada en 1789 por el marqués de Lévis, Antoine de Sinéty, en vísperas de la Revolución Francesa, la fábrica Porcelaine de Couleuvre reedita objetos creados por artistas; objetos cotidianos de porcelana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Magasin Porcelaine de Couleuvre"
    ]
  },
