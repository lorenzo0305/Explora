  "rdfs:comment": {
    "de": [
      "Serge und Philippe Cornillat, die seit der Gründung des Ortes in Flaine leben, sind staatlich geprüfte Ski- und Snowboardlehrer und bieten Unterricht für alle Niveaus (auf Französisch, Englisch und Spanisch), stundenweise, für einen halben Tag oder einen ganzen Tag."
    ],
    "en": [
      "Serge and Philippe Cornillat, who have lived in Flaine since the resort was founded, are qualified ski and snowboard instructors and offer lessons at all levels (in French, English and Spanish), by the hour, half-day or full day."
    ],
    "it": [
      "Serge e Philippe Cornillat, che vivono a Flaine fin dalla fondazione del resort, sono maestri di sci e snowboard qualificati e offrono lezioni a tutti i livelli (in francese, inglese e spagnolo), a ore, mezza giornata o giornata intera."
    ],
    "fr": [
      "Serge et Philippe Cornillat, vivant à Flaine depuis la création de la station, moniteurs diplômés d'État, ski et snowboard, vous proposent des leçons tous niveaux (en français, anglais et espagnol), à l'heure, à la 1/2 journée, à la journée."
    ],
    "es": [
      "Serge y Philippe Cornillat, que viven en Flaine desde la fundación de la estación, son monitores titulados de esquí y snowboard y ofrecen clases de todos los niveles (en francés, inglés y español), por horas, media jornada o jornada completa."
    ],
    "nl": [
      "Serge en Philippe Cornillat, die al sinds de oprichting van het skigebied in Flaine wonen, zijn gediplomeerde ski- en snowboardleraren en bieden lessen op alle niveaus (in het Frans, Engels en Spaans), per uur, halve dag of hele dag."
    ]
  },
  "rdfs:label": {
    "en": [
