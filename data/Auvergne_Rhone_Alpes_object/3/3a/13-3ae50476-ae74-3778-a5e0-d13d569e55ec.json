  "rdfs:comment": {
    "de": [
      "Freier Zugang mit Informationsschild.\r\nWeg entlang des Flusses Allier auf seinem linken Ufer.\r\nVon Moulins Bain aus, unter der Eisenbrücke hindurch, führt dieser 6 km lange Weg, der im ersten Teil einen befestigten Belag hat, bis nach Bressolles."
    ],
    "en": [
      "Free access with information panel.\r\nThis trail runs along the left bank of the River Allier.\r\nStarting from Moulins Bain, and passing under the iron bridge, this 6 km path, with a stabilized surface in its first part, leads to Bressolles."
    ],
    "it": [
      "Accesso libero con pannello informativo.\r\nQuesto sentiero costeggia la riva sinistra del fiume Allier.\r\nPartendo da Moulins Bain e passando sotto il ponte di ferro, questo sentiero di 6 km, con un fondo stabilizzato nel primo tratto, conduce a Bressolles."
    ],
    "fr": [
      "Accès libre avec panneau d'information. \r\nChemin longeant la rivière Allier sur sa rive gauche.\r\nAu départ de Moulins Bain, en passant sous le pont de fer, ce sentier de 6 km, au revêtement stabilisé dans sa première partie, mène jusqu'à Bressolles."
    ],
    "nl": [
      "Gratis toegang met informatiebord.\r\nDit pad loopt langs de linkeroever van de Allier.\r\nVanaf Moulins Bain, onder de ijzeren brug door, leidt dit pad van 6 km, met een gestabiliseerd oppervlak op het eerste deel, naar Bressolles."
    ],
    "es": [
      "Acceso libre con panel informativo.\r\nEste sendero discurre por la orilla izquierda del río Allier.\r\nPartiendo de Moulins Bain y pasando por debajo del puente de hierro, este sendero de 6 km, con firme estabilizado en el primer tramo, conduce a Bressolles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le sentier des castors"
    ]
  },
