  "rdfs:comment": {
    "de": [
      "Herstellung von handwerklich hergestelltem, nützlichem und dekorativem Geschirr aus glasiertem Porzellan.\r\nNeue Kreationen: Tierskulpturen.\r\nKleiner Laden für den Verkauf vor Ort. Besichtigung auf RDV."
    ],
    "en": [
      "Manufacture of useful and decorative enameled porcelain tableware.\r\nNew creations: animal sculptures.\r\nSmall store for on-site sales. Visits by appointment."
    ],
    "it": [
      "Produzione di stoviglie utili e decorative in porcellana smaltata.\r\nNuove creazioni: sculture di animali.\r\nPiccolo negozio per la vendita in loco. Visite su appuntamento."
    ],
    "fr": [
      "Fabrication de vaisselle artisanale utile et décorative en porcelaine émaillée.\r\nNouvelles créations : sculptures animalières.\r\nPetite boutique pour la vente sur place. Visite sur RDV."
    ],
    "nl": [
      "Vervaardiging van nuttig en decoratief geëmailleerd porseleinen serviesgoed.\r\nNieuwe creaties: dierensculpturen.\r\nKleine winkel voor verkoop ter plaatse. Bezoek op afspraak."
    ],
    "es": [
      "Fabricación de vajillas de porcelana esmaltada útiles y decorativas.\r\nNuevas creaciones: esculturas de animales.\r\nPequeña tienda para la venta in situ. Visitas concertadas."
    ]
  },
