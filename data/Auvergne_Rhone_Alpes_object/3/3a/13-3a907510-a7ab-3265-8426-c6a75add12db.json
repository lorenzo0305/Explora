          "additionalInformation": {
            "de": [
              "Aikido\r\nKinder/Jugendliche:\r\nMittwoch 17.30 bis 19 Uhr + Teenager bis 19.30 Uhr\r\nFreitag 18h bis 19h30 + Teenager bis 20h\r\n\r\nErwachsene\r\nmontag von 19.30 bis 21.30 Uhr\r\nmittwoch von 19.30 bis 21.30 Uhr\r\nfreitag von 20.00 bis 22.00 Uhr\r\n\r\nSenioren: Samstag 9 Uhr\r\nWaffen: Samstag 11.00 bis 12.00 Uhr\r\n\r\nShiatsu\r\nJugendliche und Erwachsene: Donnerstag 19.00-20.30 Uhr\r\n\r\nSelbstverteidigung\r\nJugendliche und Erwachsene: Dienstag von 19.00 bis 20.30 Uhr"
            ],
            "en": [
