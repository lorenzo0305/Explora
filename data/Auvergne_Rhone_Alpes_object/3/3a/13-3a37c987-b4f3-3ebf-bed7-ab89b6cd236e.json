  "rdfs:comment": {
    "de": [
      "Erleben Sie das Abenteuer eines Escape Games im Freien im Herzen von Lyon. Erkunden Sie eine Stunde lang die symbolträchtigen Orte der Stadt und lösen Sie dabei im Team Rätsel."
    ],
    "en": [
      "Experience a fun and unique adventure of an outdoor escape game in the city of Lyon. During an hour, explore the emblematic places of the city while solving riddles as a team. Whether with family or friends, this is an opportunity to (re)discover the city in a different way."
    ],
    "it": [
      "Godetevi un'esperienza unica e divertente in un gioco di fuga all'aperto nel cuore di Lione. Per un'ora, esplorate i luoghi simbolo della città mentre risolvete gli enigmi in squadra."
    ],
    "fr": [
      "Vivez une expérience ludique et unique en vivant l'aventure d'un escape game en extérieur au cœur de Lyon. Pendant une heure, explorez les lieux emblématiques de la ville tout en résolvant des énigmes en équipe."
    ],
    "nl": [
      "Geniet van een unieke, leuke ervaring in een outdoor escape game in het hart van Lyon. Verken een uur lang de iconische plekken van de stad terwijl je als team puzzels oplost."
    ],
    "es": [
      "Disfrute de una experiencia única y divertida en un juego de escape al aire libre en el corazón de Lyon. Durante una hora, explore los lugares emblemáticos de la ciudad mientras resuelve enigmas en equipo."
    ]
  },
