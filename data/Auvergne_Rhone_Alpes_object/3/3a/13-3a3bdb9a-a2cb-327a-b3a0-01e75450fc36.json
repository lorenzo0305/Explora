  "rdfs:comment": {
    "de": [
      "Mad Dogs Sport Aventure heißt Sie das ganze Jahr über willkommen.\r\nEntdecken Sie unsere Berge in Begleitung eines Schlittenhundegespanns!\r\nLisa, Ihre Musherin, nimmt Sie mit auf ein Abenteuer in der Natur!"
    ],
    "en": [
      "Mad Dogs Sport Aventure welcomes you summer and winter.\r\nCome and discover our mountains with a team of sled dogs!\r\nLisa, your musher, will take you on a life-size adventure!"
    ],
    "it": [
      "Mad Dogs Sport Aventure vi accoglie tutto l'anno.\r\nVenite a scoprire le nostre montagne accompagnati da una squadra di cani da slitta!\r\nLisa, la vostra musher, vi accompagnerà in un'avventura a grandezza naturale!"
    ],
    "fr": [
      "Mad Dogs Sport Aventure vous accueille toute l'année.\r\nVenez découvrir nos montagnes accompagné d’un attelage de chiens de traîneaux !\r\nLisa, votre musheuse, vous emmène à l’aventure grandeur nature!"
    ],
    "es": [
      "Mad Dogs Sport Aventure le da la bienvenida todo el año.\r\nVenga a descubrir nuestras montañas acompañado de un equipo de perros de trineo\r\n¡Lisa, su musher, le llevará en una aventura a escala real!"
    ],
    "nl": [
      "Mad Dogs Sport Aventure heet u welkom in zomer en winter.\r\nKom en ontdek onze bergen met een team van sledehonden!\r\nLisa, je musher, neemt je mee op een levensgroot avontuur!"
    ]
  },
