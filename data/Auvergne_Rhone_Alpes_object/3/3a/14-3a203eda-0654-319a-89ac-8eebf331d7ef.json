      "dc:description": {
        "de": [
          "Ziel des Vereins ist es, die Pascal-Quoirin-Orgel zu fördern, indem er verschiedene Konzerte rund um dieses Instrument organisiert.\nOrganisation von 6 Konzerten pro Jahr."
        ],
        "en": [
          "The Association?s aim is to promote the Pascal Quoirin organ by organizing various concerts around this instrument.\n6 concerts a year."
        ],
        "it": [
          "Lo scopo dell'Associazione è quello di promuovere l'organo Pascal Quoirin organizzando vari concerti intorno a questo strumento.\n6 concerti all'anno."
        ],
        "fr": [
          "L’Association a pour objectif d’assurer la promotion de l’orgue Pascal Quoirin en organisant différents concerts autour de cet instrument.\nOrganisation de 6 concerts par an."
        ],
        "nl": [
          "Het doel van de vereniging is het promoten van het Pascal Quoirin-orgel door het organiseren van verschillende concerten rond dit instrument.\n6 concerten per jaar."
        ],
        "es": [
          "El objetivo de la Asociación es promover el órgano Pascal Quoirin organizando diversos conciertos en torno a este instrumento.\n6 conciertos al año."
        ]
