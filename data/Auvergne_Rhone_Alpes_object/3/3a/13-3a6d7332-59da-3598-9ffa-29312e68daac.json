  "rdfs:comment": {
    "de": [
      "Die Brasserie des Rieux stellt handwerklich gebraute Biere nach althergebrachten Methoden her. Die Biere werden weder gefiltert noch pasteurisiert und auf natürliche Weise in Flaschen nachgegoren."
    ],
    "en": [
      "Brewery des Rieux, beer breeders in Ardèche"
    ],
    "it": [
      "La Brasserie des Rieux produce birre artigianali con metodi tradizionali. Le birre non sono filtrate né pastorizzate e vengono rifermentate naturalmente in bottiglia."
    ],
    "fr": [
      "La Brasserie des Rieux produit des bières artisanales selon les méthodes ancestrales. Les bières ne sont ni filtrées, ni pasteurisées et sont refermentées naturellement en bouteille."
    ],
    "es": [
      "La Brasserie des Rieux produce cervezas artesanales siguiendo métodos tradicionales. Las cervezas no se filtran ni pasteurizan y se refermentan de forma natural en la botella."
    ],
    "nl": [
      "De bierbrouwer \"La Brasserie des Rieux\" produceert ambachtelijke bieren volgens voorouderlijke methoden. De bieren zijn niet gefilterd of gepasteuriseerd en hergisten op natuurlijke wijze op fles."
    ]
  },
