  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dd6eab7c-1276-3acf-9324-ec65dd4e433a",
      "dc:description": {
        "de": [
          "Informationen:\n\nÖffnungszeiten:\n\nMontag bis Freitag: 6:00-19:00 Uhr\nSamstag und Sonntag: 6:00-13:00 Uhr\n\nMittwochs geschlossen.\n\nAbholung:\n\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\nBestellung:\n\nBestellung per Telefon unter 03.21.71.54.58 möglich\n\n "
        ],
        "en": [
          "More information:\n\nOpening days:\n\nMonday to Friday: 6am-7pm\nSaturday and Sunday: 6am-1pm\n\nClosed on Wednesday.\n\nPick-up:\n\nTakeaway during bakery opening hours\n\nTo order:\n\nOrder by phone 03.21.71.54.58\n\n "
        ],
        "it": [
          "Per ulteriori informazioni:\n\nGiorni di apertura:\n\nDa lunedì a venerdì: 6-19\nSabato e domenica: 6.00-13.00\n\nChiuso il mercoledì.\n\nRaccolta:\n\nDa asporto durante gli orari di apertura della pasticceria\n\nCome ordinare\n\nÈ possibile ordinare telefonicamente allo 03.21.71.54.58\n\n "
        ],
        "fr": [
          "Informations:\n\nJours d'ouverture:\n\nDu lundi au vendredi : 6h-19h\nLe samedi et le dimanche : 6h-13h\n\nFermeture le mercredi. \n\nRetrait:\n\nA emporter aux horaires d'ouverture de la boulangerie\n\nCommande:\n\nPossibilité de commander par téléphone au 03.21.71.54.58\n\n "
        ],
        "nl": [
          "Voor meer informatie:\n\nOpeningsdagen:\n\nMaandag tot vrijdag: 6u-19u\nZaterdag en zondag: 6u-1u\n\nGesloten op woensdag.\n\nOphalen:\n\nAfhalen tijdens openingstijden van de bakkerij\n\nHoe te bestellen\n\nU kunt telefonisch bestellen op 03.21.71.54.58\n\n "
        ],
        "es": [
          "Para más información:\n\nDías de apertura:\n\nDe lunes a viernes: de 6.00 a 19.00 horas\nSábados y domingos: de 6.00 a 13.00 h\n\nMiércoles cerrado.\n\nRecogida:\n\nPara llevar durante el horario de apertura de la panadería\n\nCómo hacer un pedido\n\nPuede hacer su pedido por teléfono llamando al 03.21.71.54.58\n\n "
        ]
      },
