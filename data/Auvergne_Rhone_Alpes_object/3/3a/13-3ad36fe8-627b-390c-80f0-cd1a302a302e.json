  "rdfs:comment": {
    "de": [
      "Das Festival der 100%igen Country-Musik in Craponne sur Arzon findet jedes Jahr am letzten Juliwochenende statt.\r\nNeben den kostenpflichtigen Konzerten auf dem Gelände des \"Parc des étoiles\" findet das Off-Festival mit seinen kostenlosen Veranstaltungen im Stadtzentrum statt."
    ],
    "en": [
      "The 100% Country Music Festival in Craponne sur Arzon takes place every year on the last weekend in July.\r\nIn addition to paying concerts at the \"Parc des Etoiles\", the Festival Off offers free entertainment in the town center."
    ],
    "it": [
      "Il 100% Country Music Festival di Craponne sur Arzon si svolge ogni anno l'ultimo fine settimana di luglio.\r\nOltre ai concerti a pagamento nel \"Parc des Etoiles\", c'è l'Off Festival, con intrattenimento gratuito nel centro della città."
    ],
    "fr": [
      "Le Festival de musique 100% Country de Craponne sur Arzon a lieu chaque année le dernier Week end de juillet.\r\nEn plus des concerts payants sur le site du \"parc des étoiles\" se déroule le  Festival Off avec ses animations gratuites dans le centre-ville."
    ],
    "nl": [
      "Het 100% Country Music Festival in Craponne sur Arzon vindt elk jaar plaats in het laatste weekend van juli.\r\nNaast de betalende concerten in het \"Parc des Etoiles\" is er het Off Festival, met gratis entertainment in het stadscentrum."
    ],
    "es": [
      "El Festival de Música 100% Country de Craponne sur Arzon se celebra cada año el último fin de semana de julio.\r\nAdemás de los conciertos de pago en el \"Parc des Etoiles\", se celebra el Off Festival, con espectáculos gratuitos en el centro de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival Country de Craponne"
    ]
  },
