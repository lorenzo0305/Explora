  "rdfs:comment": {
    "de": [
      "Von Les Menuires aus führt Sie dieser Weg hin und zurück bis zum Lac du Lou und seiner Hütte. Eine zugängliche und angenehme Mountainbike-Strecke, perfekt für einen gemütlichen Ausflug."
    ],
    "en": [
      "Starting from Les Menuires, this out-and-back trail takes you to Lac du Lou and its refuge. An accessible and pleasant e-MTB route, perfect for a gentle ride."
    ],
    "it": [
      "Partendo da Les Menuires, questo percorso out-and-back vi porterà fino al Lac du Lou e al suo rifugio. Un percorso per mountain bike accessibile e piacevole, perfetto per una piacevole passeggiata."
    ],
    "fr": [
      "Au départ des Menuires, ce sentier aller-retour vous conduit jusqu’au Lac du Lou et son refuge. Un parcours VTTAE accessible et agréable, parfait pour une balade tranquille."
    ],
    "es": [
      "Partiendo de Les Menuires, este sendero de ida y vuelta le llevará hasta el Lac du Lou y su refugio. Un sendero para bicicleta de montaña accesible y agradable, perfecto para pasear sin prisas."
    ],
    "nl": [
      "Deze out-and-back trail vertrekt in Les Menuires en brengt je tot aan het Lac du Lou en zijn toevluchtsoord. Een toegankelijk en aangenaam mountainbikeparcours, perfect voor een ontspannen wandeling."
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE 2 bis - Les Belleville"
    ],
    "fr": [
      "VTTAE 2 bis - Les Belleville"
    ]
  },
