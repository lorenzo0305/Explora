  "rdfs:comment": {
    "de": [
      "Das Restaurant im Herzen des Freizeitparks empfängt Sie das ganze Jahr über am Ufer des Sees von Le Pontet, um etwas zu trinken, zu Mittag oder zu Abend zu essen!"
    ],
    "en": [
      "Enjoy the idillic situation of this restaurant, opposite the lake at the heart of the leisure park."
    ],
    "it": [
      ": al centro del parco Patrice Dominguez, il  ristorante vi accoglie a pranzo e cena sulle sponde del lago del Pontet."
    ],
    "fr": [
      "Au cœur du parc de loisirs, le restaurant vous accueille toute l'année au bord du lac du Pontet pour boire un coup, déjeuner ou diner !"
    ],
    "nl": [
      "In het hart van het recreatiepark ontvangt het restaurant u het hele jaar door aan de oever van het Lac du Pontet voor een drankje, lunch of diner!"
    ],
    "es": [
      "En el corazón del parque de ocio, el restaurante le recibe todo el año a orillas del lago del Pontet para tomar una copa, comer o cenar"
    ]
  },
