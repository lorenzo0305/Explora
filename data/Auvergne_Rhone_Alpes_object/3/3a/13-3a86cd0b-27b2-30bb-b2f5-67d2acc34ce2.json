  "rdfs:comment": {
    "de": [
      "Die Association Familles Rurales organisiert am Samstag, den 14. März, einen irischen Abend in der Salle des Sucs ab 18:30 Uhr mit der Gruppe ELVEN.\r\nVon 18:30 bis 19:30 Uhr Einführung in den Tanz und ab 21 Uhr irischer Ball.\r\nEine Reservierung für das Essen wird empfohlen."
    ],
    "en": [
      "The Association Familles Rurales is organizing an Irish evening on Saturday March 14th at the Salle des Sucs, starting at 6:30pm with the group ELVEN.\r\nFrom 6.30pm to 7.30pm, an introduction to Irish dancing, and from 9pm, an Irish ball.\r\nReservations recommended for the meal."
    ],
    "it": [
      "L'Associazione Familles Rurales organizza una serata irlandese sabato 14 marzo nella Salle des Sucs a partire dalle 18.30 con il gruppo ELVEN.\r\nDalle 18.30 alle 19.30, introduzione alle danze irlandesi e, dalle 21.00, ballo irlandese.\r\nPer il ballo è consigliata la prenotazione."
    ],
    "fr": [
      "L'Association Familles Rurales organise une soirée irlandaise samedi 14 mars à la salle des sucs à partir de 18h30 avec le groupe ELVEN.\r\nDe 18h30 à 19h30 initiation à la danse, et à partir de 21h bal irlandais.\r\nRéservation conseillée pour le repas."
    ],
    "es": [
      "La Asociación Familles Rurales organiza una velada irlandesa el sábado 14 de marzo en la sala des Sucs a partir de las 18.30 h con el grupo ELVEN.\r\nDe 18.30 a 19.30 h, iniciación a la danza irlandesa y, a partir de las 21 h, baile irlandés.\r\nSe recomienda reservar para la cena."
    ],
    "nl": [
      "De Association Familles Rurales organiseert een Ierse avond op zaterdag 14 maart in de Salle des Sucs vanaf 18.30 uur met de groep ELVEN.\r\nVan 18.30 tot 19.30 uur is er een inleiding in de Ierse dans en vanaf 21.00 uur is er een Iers bal.\r\nReserveren aanbevolen voor de maaltijd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Irlandaise"
    ]
  },
