  "rdfs:comment": {
    "de": [
      "Lassen Sie sich bei einem morgendlichen Spaziergang von der Rhône in den Schlaf wiegen, für den Ihnen ein Frühstück angeboten wird (1 Gebäck, 1 Heißgetränk und 1 Fruchtsaft)."
    ],
    "en": [
      "Let yourself be lulled by the Rhone River during a morning walk for which a breakfast will be offered (1 pastry, 1 hot drink and 1 fruit juice)."
    ],
    "it": [
      "Lasciatevi cullare dal Rodano durante una passeggiata mattutina per la quale vi verrà offerta una colazione (1 pasticcino, 1 bevanda calda e 1 succo di frutta)."
    ],
    "fr": [
      "Laissez vous bercer par le Rhône lors d'une balade matinale pour laquelle un petit déjeuner vous sera proposé (1 viennoiserie, 1 boisson chaude et 1 jus de fruits)."
    ],
    "nl": [
      "Laat u meeslepen door de Rhône tijdens een ochtendwandeling waarvoor u een ontbijt krijgt aangeboden (1 gebakje, 1 warme drank en 1 vruchtensap)."
    ],
    "es": [
      "Déjese arrullar por el Ródano durante un paseo matinal para el que se le ofrecerá un desayuno (1 bollería, 1 bebida caliente y 1 zumo de frutas)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade p'tit dej"
    ]
  },
