  "rdfs:comment": {
    "de": [
      "Das Bar-Restaurant de l'Essert befindet sich auf 1382 m im Skigebiet von l'Essert und bietet Ihnen regionale Produkte an. Für Fußgänger und Skifahrer über die Seilbahn erreichbar. Panoramaterrasse mit Blick auf die Pisten."
    ],
    "en": [
      "The Essert bar-restaurant at 1382 m, on the Essert ski area, serves regional produce. Accessible by gondola for pedestrians and skiers. Panoramic terrace overlooking the slopes."
    ],
    "it": [
      "Il bar-ristorante Essert si trova a 1382 m, nel comprensorio sciistico di Essert, e serve prodotti regionali. Accessibile con la funivia per pedoni e sciatori. Terrazza panoramica con vista sulle piste."
    ],
    "fr": [
      "Le bar-restaurant de l’Essert se situe à 1382 m, sur le domaine skiable de l'Essert, vous propose des produits régionaux. Accessible par la télécabine pour les piétons et les skieurs. Terrasse panoramique avec vue sur les pistes."
    ],
    "es": [
      "El bar-restaurante Essert está situado a 1382 m, en el dominio esquiable de Essert, y sirve productos regionales. Accesible en teleférico para peatones y esquiadores. Terraza panorámica con vistas a las pistas."
    ],
    "nl": [
      "Bar-restaurant Essert ligt op 1382 m, in het skigebied Essert, en serveert regionale producten. Bereikbaar met de kabelbaan voor voetgangers en skiërs. Panoramisch terras met uitzicht op de pistes."
    ]
  },
