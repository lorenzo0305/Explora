  "rdfs:comment": {
    "de": [
      "Spaziergänge, Fahrräder, Konzerte und Natur am Kanalufer .\nEinfache Gourmetküche, kühle Getränke, Terrasse in der Sonne oder im Schatten, ein lebendiges Heurigenlokal, um sich zu versammeln, zu entspannen und zu feiern."
    ],
    "en": [
      "Walks, bikes, concerts and nature by the canal.\nSimple, gourmet cuisine, fresh drinks, sunny or shady terraces, a lively guinguette to gather, relax and celebrate."
    ],
    "it": [
      "Passeggiate, ciclismo, concerti e natura in riva al canale.\nCucina semplice e gourmet, bevande fresche, una terrazza al sole o all'ombra, una vivace guinguette per riunirsi, rilassarsi e festeggiare."
    ],
    "fr": [
      "Balades, vélos, concerts et nature au bord du canal . \nCuisine simple et gourmande, boissons fraiches, terrasse au soleil ou à l'ombre, une guinguette vivante pour se rassembler, se détendre et célébrer."
    ],
    "nl": [
      "Wandelen, fietsen, concerten en natuur aan het kanaal.\nEenvoudige, gastronomische gerechten, verse drankjes, een terras in de zon of in de schaduw, een levendige guinguette om samen te komen, te ontspannen en te vieren."
    ],
    "es": [
      "Paseos, bicicleta, conciertos y naturaleza junto al canal.\nCocina sencilla y gastronómica, bebidas frescas, una terraza al sol o a la sombra, una guinguette animada para reunirse, relajarse y celebrar."
    ]
  },
  "rdfs:label": {
