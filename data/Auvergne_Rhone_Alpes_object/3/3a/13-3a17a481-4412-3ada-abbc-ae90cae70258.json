  "rdfs:comment": {
    "de": [
      "Im Herzen von Annecy, 10 Minuten zu Fuß von der Altstadt entfernt, befindet sich dieser Ort für Ausstellungen, Begegnungen, Konferenzen, Kunstreisen und die Sensibilisierung des jungen Publikums für zeitgenössische Kunst."
    ],
    "en": [
      "In the heart of Annecy, just a 10-minute walk from the old town, discover this venue for exhibitions, meetings, conferences, artistic tours and young people's exposure to contemporary art."
    ],
    "it": [
      "Nel cuore di Annecy, a soli 10 minuti a piedi dal centro storico, scoprite questa sede per mostre, incontri, conferenze, viaggi artistici e sensibilizzazione del pubblico giovane all'arte contemporanea."
    ],
    "fr": [
      "Au cœur de la ville d'Annecy, à 10 minutes à pied de la vieille ville, découvrez ce lieu d'expositions, de rencontres, de conférences, de voyages artistiques et de sensibilisation du jeune public à l'art contemporain."
    ],
    "nl": [
      "Ontdek in het hart van Annecy, op slechts 10 minuten lopen van de oude stad, deze locatie voor tentoonstellingen, vergaderingen, conferenties, artistieke reizen en het bewustmaken van een jong publiek van hedendaagse kunst."
    ],
    "es": [
      "En el corazón de Annecy, a 10 minutos a pie del casco antiguo, descubra este lugar de exposiciones, encuentros, conferencias, viajes artísticos y sensibilización del público joven al arte contemporáneo."
    ]
  },
