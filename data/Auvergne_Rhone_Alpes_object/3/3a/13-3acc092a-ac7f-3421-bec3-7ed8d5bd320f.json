  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant Monastère et Terminus freut sich, Sie von Mai bis Allerheiligen in La Chaise-Dieu begrüßen zu dürfen. Hier finden Sie eine traditionelle und familiäre Küche sowie Pizzas vor Ort oder zum Mitnehmen und einen Barbereich."
    ],
    "en": [
      "The Hotel-Restaurant Monastère et Terminus is happy to welcome you to La Chaise-Dieu from May to All Saints' Day. You will discover a traditional and family cooking as well as pizzas on the spot or to take away and a bar space."
    ],
    "it": [
      "L'Hotel-Restaurant Monastère et Terminus è lieto di accogliervi a La Chaise-Dieu da maggio a Ognissanti. Scoprirete una cucina tradizionale e familiare, nonché pizze sul posto o da asporto e uno spazio bar."
    ],
    "fr": [
      "L'Hôtel-Restaurant Monastère et Terminus est heureux de vous accueillir à La Chaise-Dieu de Mai à Toussaint. Vous y découvrirez une cuisine traditionnelle et familiale ainsi que des pizzas sur place ou à emporter et un espace bar ."
    ],
    "nl": [
      "Hotel-Restaurant Monastère et Terminus verwelkomt u graag in La Chaise-Dieu van mei tot Allerheiligen. U zult een traditionele en familiale keuken ontdekken, evenals pizza's ter plaatse of om mee te nemen en een barruimte."
    ],
    "es": [
      "El Hotel-Restaurante Monastère et Terminus se complace en recibirle en La Chaise-Dieu desde mayo hasta el día de Todos los Santos. Descubrirá una cocina tradicional y familiar, así como pizzas al momento o para llevar y un espacio de bar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant \"Monastère et Terminus\""
    ]
  },
