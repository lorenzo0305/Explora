  "rdfs:comment": {
    "de": [
      "Das Maison de Guignol ist ein echtes Lyoner Marionettentheater im Stadtteil Saint-Georges. Guignol und seine Freunde empfangen Sie mit offenen Armen, die Vorstellungen sind für das Publikum geöffnet."
    ],
    "en": [
      "La Maison de Guignol is a real puppet theatre of Lyon, situated in the Saint Georges area, Guignol and his friends welcome you with open arms to his theatre. Shows open to the public."
    ],
    "it": [
      "La Maison de Guignol è un autentico teatro di marionette a Lione, situato nel quartiere Saint-Georges. Guignol e i suoi amici vi accolgono a braccia aperte e gli spettacoli sono aperti al pubblico."
    ],
    "fr": [
      "La Maison de Guignol est un véritable théâtre de marionnettes lyonnais, situé dans le quartier de Saint-Georges. Guignol et ses amis vous accueillent à bras ouverts, spectacles ouverts au public."
    ],
    "nl": [
      "La Maison de Guignol is een echt poppentheater in Lyon, gelegen in de wijk Saint-Georges. Guignol en zijn vrienden ontvangen je met open armen en de voorstellingen zijn toegankelijk voor het publiek."
    ],
    "es": [
      "La Maison de Guignol es un auténtico teatro de marionetas de Lyon, situado en el barrio de Saint-Georges. Guignol y sus amigos le reciben con los brazos abiertos, y los espectáculos están abiertos al público."
    ]
  },
