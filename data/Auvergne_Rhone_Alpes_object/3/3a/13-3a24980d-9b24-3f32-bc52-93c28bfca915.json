  "rdfs:comment": {
    "de": [
      "mit drei Schwimmbecken, einem Whirlpool, einem großen Park und Spielplätzen bietet das Nauticum hochwertige Einrichtungen, um das ganze Jahr über Wassersport und Freizeitaktivitäten zu betreiben."
    ],
    "en": [
      "3 pools, a jacuzzi, a large park and playgrounds, the Nauticum offers quality facilities for water sports and leisure activities all year round."
    ],
    "it": [
      "con 3 piscine, una vasca idromassaggio, un ampio parco e aree gioco, il Nauticum offre strutture di alta qualità per gli sport acquatici e le attività di svago durante tutto l'anno."
    ],
    "fr": [
      "3 bassins, un jacuzzi, un grand parc et des aires de jeux, le Nauticum offre des équipements de qualité pour s’adonner toute l’année aux sports et loisirs aquatiques."
    ],
    "nl": [
      "met 3 zwembaden, een jacuzzi, een groot park en speeltuinen biedt Nauticum het hele jaar door faciliteiten van topkwaliteit voor watersporten en vrijetijdsactiviteiten."
    ],
    "es": [
      "con 3 piscinas, un jacuzzi, un gran parque y zonas de juego, el Nauticum ofrece instalaciones de primera calidad para practicar deportes acuáticos y actividades de ocio durante todo el año."
    ]
  },
