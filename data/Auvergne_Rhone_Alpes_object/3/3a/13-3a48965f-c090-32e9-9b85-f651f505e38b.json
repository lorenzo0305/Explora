  "rdfs:comment": {
    "de": [
      "Wopaya ist eine agro-ökologische Mikrofarm, aber auch ein Lebensprojekt, das köstliche pflanzliche Produkte herstellt und auch Momente des Glücks und des Teilens erzeugt."
    ],
    "en": [
      "Wopaya is not only an agro-ecological micro-farm, but also a life project that creates delicious plant-based products and generates moments of happiness and sharing."
    ],
    "it": [
      "Wopaya è una microfattoria agroecologica, ma anche un progetto di lifestyle che crea deliziosi prodotti a base vegetale e genera momenti di felicità e condivisione."
    ],
    "fr": [
      "Wopaya est une micro-ferme agro-écologique mais aussi un projet de vie qui crée de délicieux produits à base de plantes et qui génère aussi des moments de bonheur et de partage."
    ],
    "nl": [
      "Wopaya is een agro-ecologische microboerderij, maar ook een lifestyleproject dat heerlijke plantaardige producten maakt en momenten van geluk en delen genereert."
    ],
    "es": [
      "Wopaya es una microgranja agroecológica, pero también un proyecto de estilo de vida que crea deliciosos productos vegetales y genera momentos de felicidad y convivencia."
    ]
  },
