  "rdfs:comment": {
    "de": [
      "Das Hotel - Restaurant Au Feu de Bois am Ortseingang von Autrans befindet sich gegenüber der Attraktion \"4-Jahreszeiten-Schlitten\" und ist nur wenige Schritte vom Zentrum von Autrans entfernt."
    ],
    "en": [
      "The Au Feu de Bois hotel/restaurant at the entrance of the village of Autrans is located opposite the \"La Luge des 4 Saisons” attraction, just a stone's throw from the centre of Autrans."
    ],
    "it": [
      "L'hotel-ristorante Au Feu de Bois, all'ingresso del villaggio di Autrans, si trova di fronte all'attrazione \"la luge des 4 saisons\", a pochi passi dal centro di Autrans."
    ],
    "fr": [
      "L'hôtel - restaurant Au Feu de Bois à l'entrée du village d'Autrans est situé en face de l'attraction \"la luge des 4 saisons\" à deux pas du centre d’Autrans."
    ],
    "nl": [
      "Het hotel-restaurant Au Feu de Bois bij de ingang van het dorp Autrans ligt tegenover de attractie \"la luge des 4 saisons\", op een steenworp afstand van het centrum van Autrans."
    ],
    "es": [
      "El hotel-restaurante Au Feu de Bois, situado a la entrada del pueblo de Autrans, se encuentra frente a la atracción \"la luge des 4 saisons\", a dos pasos del centro de Autrans."
    ]
  },
