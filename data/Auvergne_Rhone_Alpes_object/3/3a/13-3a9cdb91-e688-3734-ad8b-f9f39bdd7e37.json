  "rdfs:comment": {
    "de": [
      "Vom Opinel-Platz aus erreichen Sie den Weiler La Cochette und dann den Weiler Gévoudaz über eine Mischung aus Pisten und Singles für Enduro-Mountainbike-Fans."
    ],
    "en": [
      "Starting from Place Opinel, you'll reach the hamlet of La Cochette and then the hamlet of Gévoudaz via a mix of trails and singles for enduro mountain bikers."
    ],
    "it": [
      "Partendo da Place Opinel, si raggiunge la frazione di La Cochette e poi quella di Gévoudaz attraverso un mix di sentieri e single per gli amanti della mountain bike enduro."
    ],
    "fr": [
      "Au départ de la Place Opinel, vous rejoindrez le hameau de la Cochette puis le hameau de Gévoudaz par un mélange de pistes et de singles pour les amateurs d'enduro VTT."
    ],
    "nl": [
      "Vanaf Place Opinel bereik je het gehucht La Cochette en vervolgens het gehucht Gévoudaz via een mix van paden en singles voor enduro mountainbikers."
    ],
    "es": [
      "Saliendo de la Place Opinel, llegarás a la aldea de La Cochette y luego a la de Gévoudaz por una mezcla de senderos y pistas individuales para ciclistas de montaña de enduro."
    ]
  },
