  "rdfs:comment": {
    "de": [
      "Unser Hotel befindet sich im Herzen der Fußgängerzone zwischen den alten Thermen, dem Casino und dem Kongresszentrum. Tiefgarage des Rathauses in der Nähe (50 m). Geschäfte und öffentliche Verkehrsmittel in der Nähe. Authentisches Hotel aus dem 18. Jahrhundert."
    ],
    "en": [
      "Our hotel is located in the heart of the pedestrian area, between the old thermal baths, the casino and the conference centre. Municipal underground parking nearby (50 m). Close to the shops and public transport. Authentic 18th century hotel."
    ],
    "it": [
      "Il nostro hotel è situato nel cuore dell'area pedonale, tra le antiche terme, il casinò e il palazzo dei congressi. Parcheggio sotterraneo del Municipio nelle vicinanze (50 m). Negozi e mezzi pubblici nelle vicinanze. Autentico hotel del XVIII secolo."
    ],
    "fr": [
      "Notre hôtel est situé au coeur de la zone piétonne, entre les anciens thermes, le Casino et le Centre des Congrès. Parking souterrain de la Mairie à proximité (50 m). Commerces et transports en commun à proximité. Authentique hôtel datant du 18ème siècle."
    ],
    "nl": [
      "Ons hotel ligt in het hart van de voetgangerszone, tussen de oude thermen, het Casino en het Congrescentrum. Parkeergarage van het stadhuis in de buurt (50 m). Winkels en openbaar vervoer in de buurt. Authentiek hotel uit de 18e eeuw."
    ],
    "es": [
      "Nuestro hotel está situado en el corazón de la zona peatonal, entre las antiguas termas, el Casino y el Centro de Congresos. Aparcamiento subterráneo del ayuntamiento cerca (50 m). Tiendas y transporte público cercanos. Auténtico hotel del siglo XVIII."
    ]
  },
  "rdfs:label": {
    "en": [
