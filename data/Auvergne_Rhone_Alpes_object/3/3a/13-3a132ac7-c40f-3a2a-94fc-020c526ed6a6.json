  "rdfs:comment": {
    "de": [
      "Inszenierung eines Miniaturdorfes im provenzalischen Stil, 100% handgemacht. Miniaturhäuser aus Ton, Erde, Steinen und Holz. Sie können auf einem Baumstamm, in der Rückenlehne eines Stuhls oder auf einem Stein gebaut werden."
    ],
    "en": [
      "Staging a miniature village, Provencal-style, 100% handmade. Miniature houses made of clay, earth, stone and wood. They can be built on a tree trunk, in the back of a chair or on a stone."
    ],
    "it": [
      "Allestimento di un villaggio in miniatura, di tipo provenzale, 100% fatto a mano. Case in miniatura fatte di argilla, terra, pietre, legno. Possono essere costruiti su un tronco d'albero, sullo schienale di una sedia, su una pietra."
    ],
    "fr": [
      "Mise en scène d'un village miniature, type provençale, 100% fait main. Maisons miniatures fabriquées en argile, terre, pierres, bois. Elles peuvent être construites sur un tronc d'arbre, dans le dossier d'une chaise, sur une pierre."
    ],
    "nl": [
      "Miniatuurdorp, Provençaalse stijl, 100% handgemaakt. Miniatuurhuisjes van klei, aarde, stenen, hout. Ze kunnen zijn gebouwd op een boomstam, in de rug van een stoel, op een steen."
    ],
    "es": [
      "Escenificación de un pueblo en miniatura, tipo provenzal, 100% artesanal. Casas en miniatura de arcilla, tierra, piedras y madera. Pueden construirse en el tronco de un árbol, en el respaldo de una silla, en una piedra."
    ]
  },
