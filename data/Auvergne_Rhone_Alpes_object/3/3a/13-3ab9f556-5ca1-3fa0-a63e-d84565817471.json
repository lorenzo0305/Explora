  "rdfs:comment": {
    "de": [
      "Dieses Hotel liegt in der Nähe von den Skigebieten, Genf und Annecy. Es ist sehr komfortabel und angenehm. Es bietet viele Leistungen an. Sie werden einen warm Empfangen und eine schön Atmosphäre mit viele Dienste, um zu erholen."
    ],
    "en": [
      "Ideally situated close to ski resorts, Geneva and Annecy, the Kyriad Bellegarde hotel offers all the comfort and amenities of a well-established hotel chain — a warm welcome, a relaxing atmosphere and services that meet all of your expectations."
    ],
    "it": [
      "Questo confortevole hotel offre camere ben arredate e un ristorante gourmet, il tutto in un'atmosfera accogliente."
    ],
    "fr": [
      "Confortable, cet établissement vous propose des chambres soignées et un restaurant gourmand, le tout dans une atmosphère chaleureuse."
    ],
    "es": [
      "Este confortable hotel ofrece habitaciones bien equipadas y un restaurante gourmet, todo ello en un ambiente cálido."
    ],
    "nl": [
      "Dit comfortabele hotel biedt goed uitgeruste kamers en een gastronomisch restaurant, allemaal in een warme sfeer."
    ]
  },
