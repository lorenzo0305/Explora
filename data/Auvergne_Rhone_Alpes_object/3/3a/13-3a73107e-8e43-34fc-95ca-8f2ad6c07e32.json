  "rdfs:comment": {
    "de": [
      "Seit der Gründung des Weinguts im Jahr 1993 bearbeiten wir 10 Hektar Weinberge, die an den Hängen von Chavanay, einer Gemeinde im Süden des Departements Loire, liegen."
    ],
    "en": [
      "Since the creation of the estate in 1993, we have been working 10 hectares of vines located on the slopes of Chavanay, a commune in the south of the Loire department."
    ],
    "it": [
      "Dalla creazione della tenuta nel 1993, lavoriamo 10 ettari di vigne situate sui pendii di Chavanay, un comune nel sud del dipartimento della Loira."
    ],
    "fr": [
      "Depuis la création du domaine en 1993, nous travaillons 10 hectares de vignes situés sur les côteaux de Chavanay, commune du sud du département de la Loire."
    ],
    "nl": [
      "Sinds de oprichting van het domein in 1993 bewerken wij 10 hectare wijngaarden op de hellingen van Chavanay, een gemeente in het zuiden van het departement Loire."
    ],
    "es": [
      "Desde la creación de la finca en 1993, trabajamos 10 hectáreas de viñedos situados en las laderas de Chavanay, municipio del sur del departamento del Loira."
    ]
  },
  "rdfs:label": {
