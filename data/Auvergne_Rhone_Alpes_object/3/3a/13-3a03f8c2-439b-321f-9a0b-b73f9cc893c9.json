  "rdfs:comment": {
    "de": [
      "Les Chevaux des Bisettes ist ein naturnaher und überschaubarer Reitstall, der für alle offen ist.\r\nQualitativ hochwertige Aktivitäten: Kurse, Ausritte, Wanderungen werden von Claire DE AMORIM, einer diplomierten, erfahrenen und gastfreundlichen Fachkraft, betreut."
    ],
    "en": [
      "Les Chevaux des Bisettes is an equestrian center open to all.\r\nQuality activities such as lessons, rides and excursions are supervised by Claire DE AMORIM, a qualified, experienced and welcoming professional."
    ],
    "it": [
      "Les Chevaux des Bisettes è un centro equestre naturalistico a misura d'uomo, aperto a tutti.\r\nAttività di qualità come lezioni, passeggiate ed escursioni sono seguite da Claire DE AMORIM, professionista qualificata, esperta e accogliente."
    ],
    "fr": [
      "Les Chevaux des Bisettes est un centre équestre de pleine nature et à taille humaine ouvert à tous.\r\nDes activités de qualité : cours, balades, randonnées, sont encadrées par Claire DE AMORIM, une professionnelle diplômée, expérimentée et accueillante."
    ],
    "nl": [
      "Les Chevaux des Bisettes is een paardrijcentrum in de natuur op menselijke schaal, open voor iedereen.\r\nKwaliteitsactiviteiten zoals lessen, ritten en excursies worden begeleid door Claire DE AMORIM, een gekwalificeerde, ervaren en gastvrije professional."
    ],
    "es": [
      "Les Chevaux des Bisettes es un centro ecuestre natural a escala humana, abierto a todos.\r\nLas actividades de calidad, como clases, paseos y excursiones, están supervisadas por Claire DE AMORIM, una profesional cualificada, experimentada y acogedora."
    ]
  },
