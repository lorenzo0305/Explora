  "rdfs:comment": {
    "de": [
      "Das Theater von Privas steht im Zeichen der Vielfalt und bietet dem Publikum ein Programm für alle: Ausstellungen, Theater, Poesie, Tanz, Zirkus, Musik, Konzerte... Scène conventionnée / Szene Rhône Alpes."
    ],
    "en": [
      "The Théâtre de Privas, under the sign of diversity, offers the public a program for everyone: exhibitions, theatre, poetry, dance, circus, music, concerts... Conventionnal stage / Rhône Alpes stage."
    ],
    "it": [
      "Il Théâtre de Privas, all'insegna della diversità, offre al pubblico un programma per tutti: mostre, teatro, poesia, danza, circo, musica, concerti... Tappa convenzionale / Tappa Rodano-Alpi."
    ],
    "fr": [
      "Le Théâtre de Privas, sous le signe de la diversité, propose au public une programmation pour tous: expositions, théâtre, poésie, danse, cirque, musique, concerts... Scène conventionnée / scène Rhône Alpes."
    ],
    "nl": [
      "Het Théâtre de Privas, in het teken van diversiteit, biedt het publiek een programma voor iedereen: tentoonstellingen, theater, poëzie, dans, circus, muziek, concerten... Conventionele etappe / etappe Rhône Alpes."
    ],
    "es": [
      "El Théâtre de Privas, bajo el signo de la diversidad, ofrece al público una programación para todos: exposiciones, teatro, poesía, danza, circo, música, conciertos... Etapa convencional / Etapa Rhône Alpes."
    ]
  },
