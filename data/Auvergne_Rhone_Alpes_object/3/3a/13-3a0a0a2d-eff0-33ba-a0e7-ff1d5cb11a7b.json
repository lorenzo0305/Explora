  "rdfs:comment": {
    "de": [
      "Jahrhundert, das besonders kohärent und einzigartig in der Isère ist, umfasst noch den Großteil seiner Anlagen und beherbergt die wichtigsten Produktionswerkzeuge."
    ],
    "en": [
      "This 19th century heritage site, which is especially meaningful and unique in Isère, is still home to most of its facilities and the main manufacturing rools."
    ],
    "it": [
      "Questo complesso patrimoniale del XIX secolo, particolarmente coerente e unico nell'Isère, comprende ancora la maggior parte delle sue installazioni e ospita i principali strumenti di produzione."
    ],
    "fr": [
      "Cet ensemble patrimonial du XIX° siècle, particulièrement cohérent et unique en Isère, comprend encore l’essentiel de ses installations et abrite les principaux outils de fabrication."
    ],
    "es": [
      "Este conjunto patrimonial del siglo XIX, especialmente coherente y único en Isère, conserva la mayor parte de sus instalaciones y alberga las principales herramientas de fabricación."
    ],
    "nl": [
      "Dit 19e-eeuwse erfgoedcomplex, bijzonder coherent en uniek in Isère, bevat nog steeds het grootste deel van zijn installaties en herbergt de belangrijkste productiemiddelen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Old BERTRAND tile factory"
    ],
    "fr": [
      "Ancienne Tuilerie BERTRAND"
    ]
  },
