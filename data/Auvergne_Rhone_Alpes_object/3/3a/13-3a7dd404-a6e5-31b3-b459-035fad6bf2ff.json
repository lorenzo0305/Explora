  "rdfs:comment": {
    "de": [
      "Herstellung von Ziegenkäse aus Rohmilch vom Bauernhof: Cabécous, Briketts, Elgines, Faselle, C cendrés, Tomme de chèvre.\r\nSeifen aus Ziegenmilch\r\nterrinen und Wurstwaren aus Zicklein, Schweinen aus Freilandhaltung (Pakete und verschiedene Wurstwaren)"
    ],
    "en": [
      "Production of raw-milk farmhouse goat cheeses since 1989: cabécous, briquettes, elgines, faisselles, cendrés, tomme de chèvre.\r\n New products: meat products (cabri) and soaps."
    ],
    "it": [
      "Produzione di formaggi di capra di fattoria: cabécous, briquettes, elgines, faisselles, cendrés, tomme de chèvre.\r\nSaponi a base di latte di capra\r\nterrine e salumi di capretto, maiali allevati all'aperto (paccheri e salumi vari)"
    ],
    "fr": [
      "Fabrication de fromages de chèvre fermiers au lait cru : cabécous, briquettes, elgines, faisselles, cendrés, tomme de chèvre.\r\nSavons au lait de chèvre\r\nterrines et charcuterie à base de chevreau, porcs élevés en plein air (colis et charcuteries diverses)"
    ],
    "nl": [
      "Productie van boerengeitenkazen: cabécous, briquettes, elgines, faisselles, cendrés, tomme de chèvre.\r\nZeep van geitenmelk\r\nterrines en vleeswaren van geitenlammeren en scharrelvarkens (pakketjes en diverse vleeswaren)"
    ],
    "es": [
      "Producción de quesos de cabra de granja: cabécous, briquettes, elgines, faisselles, cendrés, tomme de chèvre.\r\nJabones de leche de cabra\r\nterrinas y embutidos elaborados a partir de cabrito, cerdos criados en libertad (paquetes y embutidos diversos)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Fromagerie Maury"
    ],
    "fr": [
      "GAEC Chèvrerie Maury"
    ]
  },
