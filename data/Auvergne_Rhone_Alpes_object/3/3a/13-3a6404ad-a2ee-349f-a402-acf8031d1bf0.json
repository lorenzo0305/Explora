  "rdfs:comment": {
    "de": [
      "Der Rapper und Dichter Kery James inszeniert seine Lieblingsfigur erneut in einem geschlossenen Raum, in dem es um das Thema Polizeigewalt geht. Ein politisches und atemloses Stück, das mit den Sorgen unserer Zeit in Resonanz geht."
    ],
    "en": [
      "Rapper and poet Kery James brings his favorite character back to the stage in a closed-door play about police violence. A breathless, political play that resonates with the concerns of our time."
    ],
    "it": [
      "Il rapper e poeta Kery James riporta in scena il suo personaggio preferito in uno spettacolo a porte chiuse sulla violenza della polizia. Una pièce politica senza fiato che risuona con le preoccupazioni del nostro tempo."
    ],
    "fr": [
      "Le rappeur et poète Kery James remet en scène son personnage fétiche dans un huis clos sur la question des violences policières. Une pièce politique et haletante qui résonne avec les préoccupations de notre temps."
    ],
    "nl": [
      "Rapper en dichter Kery James brengt zijn favoriete personage terug op het toneel in een toneelstuk over politiegeweld. Een adembenemend politiek toneelstuk dat resoneert met de zorgen van onze tijd."
    ],
    "es": [
      "El rapero y poeta Kery James lleva de nuevo a escena a su personaje favorito en una obra a puerta cerrada sobre la violencia policial. Una obra política sin aliento que resuena con las preocupaciones de nuestro tiempo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "À huis clos - Théâtre, vidéo"
    ]
  },
