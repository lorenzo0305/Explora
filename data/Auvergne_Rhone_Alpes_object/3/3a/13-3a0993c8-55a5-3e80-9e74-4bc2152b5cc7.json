  "rdfs:comment": {
    "de": [
      "Das höchstgelegene Sternerestaurant der Isère\r\nKreative, puristische Küche, die die besten Produkte der Region einschließt und mit einem Stern im Guide Michelin ausgezeichnet wurde."
    ],
    "en": [
      "Creative and refined cuisine, made with the best regional products, rewarded with one star in the 'Guide Michelin'."
    ],
    "it": [
      "Cucina creativa, con i prodotti migliori della regione, premiato con una stella nel 'Guide Michelin'."
    ],
    "fr": [
      "Le restaurant étoilé le plus haut perché d'Isère\r\nCuisine créative, épurée, incluant les meilleurs produits de la région et récompensée d'une étoile au Guide Michelin."
    ],
    "nl": [
      "Het hoogste sterrenrestaurant in Isère\r\nCreatieve, overzichtelijke keuken met de beste producten uit de streek, bekroond met een ster in de Michelingids."
    ],
    "es": [
      "El restaurante con más estrellas de Isère\r\nCocina creativa y desenfadada, con los mejores productos de la región y galardonada con una estrella en la Guía Michelin."
    ]
  },
