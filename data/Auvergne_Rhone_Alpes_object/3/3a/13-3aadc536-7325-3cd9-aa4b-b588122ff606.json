  "rdfs:comment": {
    "de": [
      "Der Parc Paul Mistral ist der größte Park in Grenoble und erstreckt sich über 33 Hektar. Er bietet schöne Exemplare alter Bäume, Teiche und seine Lage in der Nähe des Speedway-Rings und ermöglicht die Ausübung zahlreicher Aktivitäten."
    ],
    "en": [
      "Spread over 33 hectares, the Parc Paul Mistral is Grenoble's largest park. It boasts some fine specimen ancient trees and ponds, and its location, close to the speedway, makes it ideal for a wide range of activities."
    ],
    "it": [
      "Esteso su 33 ettari, il parco Paul Mistral è il più grande parco di Grenoble. Ha bellissimi esemplari di alberi secolari, stagni e la sua posizione, vicino all'anello di velocità, permette la pratica di molte attività."
    ],
    "fr": [
      "Etendu sur 33 hectares, le parc Paul mistral est  le plus grand parc de Grenoble. Il présente de beaux spécimens d'arbres anciens, des bassins et sa situation, proche de l'anneau de vitesse et permet la pratique de nombreuses activités."
    ],
    "nl": [
      "Het Paul Mistral park, verspreid over 33 hectare, is het grootste park van Grenoble. Het heeft prachtige exemplaren van oude bomen, vijvers en zijn ligging, dicht bij de snelheidsring, maakt de beoefening van vele activiteiten mogelijk."
    ],
    "es": [
      "Con 33 hectáreas, el parque Paul Mistral es el más grande de Grenoble. Sus árboles centenarios, sus estanques y su proximidad al circuito de velocidad lo convierten en un lugar ideal para practicar numerosas actividades."
    ]
  },
