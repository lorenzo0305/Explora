  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in unser Know-how und entdecken Sie die einzigartigen Aromen unserer handwerklich hergestellten Liköre in unserem Atelier in Sainte-Sigolène."
    ],
    "en": [
      "Dive into the heart of our expertise and discover the unique flavors of our handcrafted liqueurs in our workshop in Sainte-Sigolène."
    ],
    "it": [
      "Immergetevi nella nostra esperienza e scoprite i sapori unici dei nostri liquori artigianali nel nostro laboratorio di Sainte-Sigolène."
    ],
    "fr": [
      "Plongez au cœur de notre savoir-faire et venez découvrir les saveurs uniques de nos liqueurs artisanales dans notre atelier à Sainte-Sigolène."
    ],
    "es": [
      "Sumérjase en nuestra experiencia y descubra los sabores únicos de nuestros licores artesanales en nuestro taller de Sainte-Sigolène."
    ],
    "nl": [
