  "rdfs:comment": {
    "de": [
      "Typhaine und Benjamin, Künstler und Handwerker, die zwischen Lyon und Paris gearbeitet haben, haben sich in der Ardèche niedergelassen, um Ihnen Einführungen in die Welt des Holzes anzubieten."
    ],
    "en": [
      "Typhaine, a designer and craftswoman who has worked between Lyon and Paris, has chosen to settle in the Ardèche to create wooden boards that will look great at the table in your kitchen."
    ],
    "it": [
      "Typhaine e Benjamin, artisti e artigiani che hanno lavorato tra Lione e Parigi, hanno scelto di stabilirsi nell'Ardèche per offrire un'introduzione al mondo del legno."
    ],
    "fr": [
      "Typhaine et Benjamin artistes et artisans ayant travaillé entre Lyon et Paris ont fait le choix de s'installer en Ardèche pour vous proposer des initiations au monde du bois."
    ],
    "es": [
      "Typhaine y Benjamin, artistas y artesanos que han trabajado entre Lyon y París, han elegido instalarse en la Ardèche para ofrecer iniciaciones al mundo de la madera."
    ],
    "nl": [
      "Typhaine en Benjamin, kunstenaars en ambachtslieden die tussen Lyon en Parijs hebben gewerkt, hebben ervoor gekozen zich in de Ardèche te vestigen om kennis te maken met de wereld van hout."
    ]
  },
