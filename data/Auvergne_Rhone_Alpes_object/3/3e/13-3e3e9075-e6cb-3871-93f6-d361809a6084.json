  "rdfs:comment": {
    "de": [
      "Erzählabend mit Lydie rund um das Drôme-Tal, während des Abendessens in der Moulin de la Pipe. Ein eindringlicher Moment, der Erzählungen, lokale Traditionen und Gastronomie in einer warmen und intimen Atmosphäre miteinander verbindet."
    ],
    "en": [
      "An evening of storytelling with Lydie about the Drôme Valley, during the evening meal at Moulin de la Pipe. An immersive moment combining stories, local traditions and gastronomy in a warm, intimate atmosphere."
    ],
    "it": [
      "Una serata di racconti con Lydie sulla Valle della Drôme, durante la cena al Moulin de la Pipe. Un momento coinvolgente che unisce storie, tradizioni locali e gastronomia in un'atmosfera calda e intima."
    ],
    "fr": [
      "Soirée contes avec Lydie autour de la Vallée de la Drôme, pendant le repas du soir au Moulin de la Pipe. Un moment immersif mêlant récits, traditions locales et gastronomie dans une ambiance chaleureuse et intimiste."
    ],
    "es": [
      "Una velada de cuentacuentos con Lydie sobre el valle del Drôme, durante la cena en el Moulin de la Pipe. Un momento de inmersión que combina historias, tradiciones locales y gastronomía en un ambiente cálido e íntimo."
    ],
    "nl": [
      "Een avond vertellen met Lydie over de Drômevallei, tijdens de avondmaaltijd in de Moulin de la Pipe. Een meeslepend moment dat verhalen, lokale tradities en gastronomie combineert in een warme en intieme sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dîner conte au Moulin de la Pipe"
    ]
  },
