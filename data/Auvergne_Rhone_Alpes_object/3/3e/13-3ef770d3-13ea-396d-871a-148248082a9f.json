  "rdfs:comment": {
    "de": [
      "Getragen vom Talent seiner Musiker und einer ansteckenden Energie, vermischt Le Condor keltische Klänge, provenzalische Trommeln, Dudelsäcke und zeitgenössische Einflüsse zu einer kraftvollen und zugleich bezaubernden Show."
    ],
    "en": [
      "Buoyed by the talent of its musicians and an infectious energy, Le Condor blends Celtic sounds, Provençal drums, bagpipes and contemporary influences to deliver a powerful, spellbinding show."
    ],
    "it": [
      "Sostenuti dal talento dei loro musicisti e dalla loro energia contagiosa, Le Condor fondono suoni celtici, tamburi provenzali, cornamuse e influenze contemporanee per offrire uno spettacolo potente e ammaliante."
    ],
    "fr": [
      "Porté par le talent de ses musiciens et une énergie communicative, Le Condor mêle sonorités celtiques, tambours provençaux, cornemuses et influences contemporaines pour offrir un spectacle à la fois puissant et envoûtant."
    ],
    "es": [
      "Impulsados por el talento de sus músicos y su contagiosa energía, Le Condor fusionan sonidos celtas, tambores provenzales, gaitas e influencias contemporáneas para ofrecer un espectáculo tan poderoso como hechizante."
    ],
    "nl": [
      "Dankzij het talent van hun muzikanten en hun aanstekelijke energie mengt Le Condor Keltische klanken, Provençaalse drums, doedelzakken en hedendaagse invloeden tot een show die zowel krachtig als betoverend is."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle Le Condor"
    ]
  },
