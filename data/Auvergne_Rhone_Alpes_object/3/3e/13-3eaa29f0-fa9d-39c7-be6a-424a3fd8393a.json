  "rdfs:comment": {
    "de": [
      "Sanft auf dem Wasserspiegel von Saint-Rémy-sur-Durolle gelegen, bietet Ihnen das Aqualudique-Schwimmbad jeden Tag 26°C warmes Wasser mit einem naturnahen Panoramablick..."
    ],
    "en": [
      "Saint-Remy swimming pool has 2 pools, the largest being 25 m long. Water slides, fountains, diving platforms and whirlpools. Heated pool to 26°C. Green outdoor spaces and solarium."
    ],
    "it": [
      "Delicatamente posizionata sulle acque di Saint-Rémy-sur-Durolle, la piscina acqualudica vi offre ogni giorno un'acqua riscaldata a 26°C con una vista panoramica molto..."
    ],
    "fr": [
      "Délicatement posée sur le plan d'eau de Saint-Rémy-sur-Durolle, la piscine aqualudique vous propose tous les jours une eau chauffée à 26°C avec une vue panoramique très nature..."
    ],
    "es": [
      "Delicadamente situada sobre el agua de Saint-Rémy-sur-Durolle, la piscina acuática le ofrece cada día un agua calentada a 26°C con una vista panorámica muy natural..."
    ],
    "nl": [
      "Delicaat geplaatst op het water van Saint-Rémy-sur-Durolle, het aqualudische zwembad biedt u elke dag een water verwarmd tot 26 ° C met een panoramisch uitzicht zeer natuurlijke..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Aqualudic swimming pool of Saint-Rémy-sur-Durolle"
    ],
    "fr": [
      "Piscine aqualudique de Saint-Rémy-sur-Durolle"
    ]
  },
