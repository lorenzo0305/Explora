  "rdfs:comment": {
    "de": [
      "BAR-Resto mit festlichem Ambiente, im Herzen des historischen Viertels von Grenoble gelegen, Place des Halles Ste Claire. Reservierung möglich, Gruppen akzeptiert.  Musik, Terrasse (beheizt). Also, bereit für ein kleines, unumgängliches Date...??!"
    ],
    "en": [
      "Bar-Resto with a festive atmosphere, located in the heart of Grenoble's historic district, Place des Halles Ste Claire. \r\nReservations possible, Groups accepted.  \r\nWine, Beers, Cocktails, Live Music, 3 x Terraces.\r\nSo, ready for a little Rencard...??!"
    ],
    "it": [
      "Bar-Resto dall'atmosfera festosa, situato nel cuore del quartiere storico di Grenoble, Place des Halles Ste Claire.\r\nPossibilità di prenotazione, accettazione gruppi.\r\nVini, birre, cocktail, musica dal vivo, 3 xTerrasses.\r\nEhi, diamoci un appuntamento!"
    ],
    "fr": [
      "BAR-Resto à Ambiance festive, situé en plein coeur du quartier historique de Grenoble, place des Halles Ste Claire. \r\nPossibilité de réservation, Groupes acceptés.\r\nVins, Bières, Cocktails, Musique Live, 3 xTerrasses.\r\nHey, et si nous nous donnions Rencard?!"
    ],
    "nl": [
      "Bar-Resto met een feestelijke sfeer, gelegen in het hart van de historische wijk van Grenoble, Place des Halles Ste Claire.\r\nReserveren mogelijk, groepen worden geaccepteerd.\r\nWijnen, bieren, cocktails, livemuziek, 3 x terrassen.\r\nHé, laten we afspreken!"
    ],
    "es": [
      "Bar-Resto de ambiente festivo, situado en el corazón del barrio histórico de Grenoble, Place des Halles Ste Claire. Posibilidad de reserva, se aceptan grupos.  Música, Terraza (climatizada). Entonces, ¿está listo para un poco de \"Rencard\"?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "AU RENCARD"
    ]
  },
