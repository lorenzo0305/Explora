  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e1e7105b-7f19-34e6-b86d-7e0c39d9a74c",
      "dc:description": {
        "de": [
          "ZWISCHEN DEM 14. JULI UND DEM 15. AUGUST 2024\nIn der Blue Bar von Nausicaa werden zwei Cine-Bar-Abende angeboten, damit Sie die langen Sommerabende am Meer in vollen Zügen genießen können!\nKostenlose Veranstaltung"
        ],
        "en": [
          "BETWEEN JULY 14 AND AUGUST 15, 2024\nTwo ciné-bar evenings will be held at Nausicaa's Blue Bar to make the most of long summer evenings by the sea!\nFree event"
        ],
        "it": [
          "TRA IL 14 LUGLIO E IL 15 AGOSTO 2024\nDue serate di film-bar si terranno al Nausicaa's Blue Bar per approfittare delle lunghe serate estive in riva al mare!\nEvento gratuito"
        ],
        "fr": [
          "ENTRE LE 14 JUILLET ET LE 15 AOUT 2024\nDeux soirées ciné-bar seront proposées au Blue Bar de Nausicaa pour profiter pleinement des longues soirées d'été au bord de la mer !\nEvénement gratuit"
        ],
        "nl": [
          "TUSSEN 14 JULI EN 15 AUGUSTUS 2024\nEr worden twee film-baravonden gehouden in Nausicaa's Blue Bar om optimaal te profiteren van de lange zomeravonden aan zee!\nGratis evenement"
        ],
        "es": [
          "ENTRE EL 14 DE JULIO Y EL 15 DE AGOSTO DE 2024\nDos noches de cine-bar en el Nausicaa's Blue Bar para disfrutar al máximo de las largas veladas estivales junto al mar\nEvento gratuito"
        ]
      },
      "@type": [
        "Description"
      ],
