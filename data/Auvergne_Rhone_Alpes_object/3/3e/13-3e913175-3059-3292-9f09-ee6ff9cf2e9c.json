  "rdfs:comment": {
    "de": [
      "Le Petit Drômois bietet Ihnen eine breite Palette an Produkten aus eigener Herstellung: feste Seifen, Flüssigseifen, flüssige und feste Shampoos, Duschgel, natürliche Kerzen und regionale Spezialitäten, gekühlte Getränke, Geschenke..."
    ],
    "en": [
      "Le Petit Drômois offers a wide range of products from its own production: solid soaps, liquid soaps, liquid and solid shampoos, shower gels, natural candles and regional specialities, cold drinks, gifts..."
    ],
    "it": [
      "Le Petit Drômois offre un'ampia gamma di prodotti di produzione propria: saponi solidi, saponi liquidi, shampoo liquidi e solidi, gel doccia, candele naturali e specialità regionali, bevande fredde, regali..."
    ],
    "fr": [
      "Le Petit Drômois vous propose une large gamme de produits de sa production  : Savons solides, savons liquides, shampoings liquides et solides, gel douche, bougies naturelles et des spécialités régionales, boissons fraiches, cadeaux..."
    ],
    "es": [
      "Le Petit Drômois ofrece una amplia gama de productos de producción propia: jabones sólidos, jabones líquidos, champús líquidos y sólidos, geles de ducha, velas naturales y especialidades regionales, bebidas frías, regalos..."
    ],
    "nl": [
      "Le Petit Drômois biedt een breed scala aan producten uit eigen productie: vaste zepen, vloeibare zepen, vloeibare en vaste shampoos, douchegels, natuurlijke kaarsen en regionale specialiteiten, koude dranken, geschenken..."
    ]
  },
