      "dc:description": {
        "de": [
          "Geschäft für Käsereiprodukte und Feinkost.\nGeöffnet von Montag bis Samstag von 9:00 bis 12:30 Uhr und von 15:00 bis 19:00 Uhr und am Sonntag von 9:00 bis 12:30 Uhr."
        ],
        "en": [
          "Cheese and delicatessen store.\nOpen Monday to Saturday, 9am to 12:30pm and 3pm to 7pm, and Sunday, 9am to 12:30pm."
        ],
        "it": [
          "Negozio di formaggi e specialità gastronomiche.\nAperto dal lunedì al sabato dalle 9.00 alle 12.30 e dalle 15.00 alle 19.00, e la domenica dalle 9.00 alle 12.30."
        ],
        "fr": [
          "Magasin fromagerie et épicerie fine.\nOuvert du lundi au samedi de 9h à 12h30 et de 15h à 19h et le dimanche de 9h à 12h30."
        ],
        "es": [
          "Tienda de quesos y delicatessen.\nAbierto de lunes a sábado de 9.00 a 12.30 y de 15.00 a 19.00, y los domingos de 9.00 a 12.30."
        ],
        "nl": [
          "Kaas- en delicatessenwinkel.\nGeopend van maandag tot zaterdag van 9.00 tot 12.30 en van 15.00 tot 19.00 en op zondag van 9.00 tot 12.30."
        ]
      },
