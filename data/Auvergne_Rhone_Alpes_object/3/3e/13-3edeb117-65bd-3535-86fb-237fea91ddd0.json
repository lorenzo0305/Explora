  "rdfs:comment": {
    "de": [
      "Als Meister des Schokoladenhandwerks ist Chocolartisan auf palmölfreie, gesunde und nachhaltige Brotaufstriche spezialisiert. Unter der Marke \"La Cabane à café\" finden Sie sorgfältig ausgewählte Kaffees und Tees. Besuche sind nach vorheriger Anmeldung möglich."
    ],
    "en": [
      "Chocolartisan is a master chocolatier specializing in healthy, sustainable, palm-oil-free spreads. The \"La Cabane à café\" brand offers carefully selected coffees and teas. Visits by appointment only."
    ],
    "it": [
      "Chocolartisan è un maestro cioccolatiere specializzato in creme spalmabili sane e sostenibili che non contengono olio di palma. Il marchio \"La Cabane à café\" offre caffè e tè accuratamente selezionati. Visite su prenotazione."
    ],
    "fr": [
      "Maître artisan chocolatier, Chocolartisan est spécialisé en pâtes à tartiner sans huile de palme, saines et durables. Au travers de la marque \"La Cabane à café\", retrouvez des cafés et thés sélectionnés avec soin. Visites possibles sur réservation."
    ],
    "nl": [
      "Chocolartisan is een meester-chocolademaker gespecialiseerd in gezond, duurzaam broodbeleg zonder palmolie. Het merk \"La Cabane à café\" biedt zorgvuldig geselecteerde koffie en thee. Bezoeken op afspraak."
    ],
    "es": [
      "Chocolartisan es un maestro chocolatero especializado en cremas para untar sanas y sostenibles que no contienen aceite de palma. La marca \"La Cabane à café\" ofrece cafés y tés cuidadosamente seleccionados. Visitas concertadas."
    ]
  },
