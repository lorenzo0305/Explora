  "rdfs:comment": {
    "de": [
      "Wir bieten weiterhin die Ausleihe von Spielen mit \"Spielen zum Mitnehmen\" an. Reservieren Sie Ihre Spiele im Voraus und gehen Sie dann allein zur Sprechstunde. Die zurückgegebenen Spiele werden zwei Wochen lang unter \"Quarantäne\" gestellt."
    ],
    "en": [
      "We will continue to offer a \"games to go\" service. Reserve your games in advance, then come alone to the lending desk. Returned games will be \"quarantined\" for 2 weeks."
    ],
    "it": [
      "Continuiamo a offrire un servizio di \"take-away\". Prenotate i vostri giochi in anticipo, poi andate da soli in ufficio. I giochi restituiti saranno messi in \"quarantena\" per 2 settimane."
    ],
    "fr": [
      "Nous continuons à assurer le service d'emprunt de jeux avec des \"jeux à emporter\". Réserver vos jeux au préalable, puis vous rendre seul-e à la permanence. Les jeux retournés seront mis en \"quarantaine\" pendant 2 semaines."
    ],
    "nl": [
      "We gaan door met de leenservice van games met \"games to go\". Reserveer je games van tevoren en kom dan alleen naar de bibliotheek. Teruggebrachte games worden 2 weken in \"quarantaine\" geplaatst."
    ],
    "es": [
      "Seguimos ofreciendo un servicio de \"comida para llevar\". Reserve sus juegos con antelación y luego vaya solo a la oficina. Los juegos devueltos se pondrán en \"cuarentena\" durante 2 semanas."
    ]
  },
