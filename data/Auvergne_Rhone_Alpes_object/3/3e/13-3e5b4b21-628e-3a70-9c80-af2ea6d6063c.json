  "rdfs:comment": {
    "de": [
      "L'Épicurien empfängt Sie in einem eleganten und beruhigenden Rahmen. Entdecken Sie eine traditionelle, großzügige und hausgemachte Küche, die Sie im Speisesaal oder auf der schönen Sonnenterrasse genießen können."
    ],
    "en": [
      "L'Épicurien welcomes you in an elegant and peaceful setting. Discover traditional, generous, and homemade cuisine, to be enjoyed indoors or on a beautiful sunny terrace."
    ],
    "it": [
      "L'Épicurien vi accoglie in un ambiente elegante e rilassante. Gustate la generosa cucina tradizionale e casalinga nella sala da pranzo o sulla terrazza soleggiata."
    ],
    "fr": [
      "L’Épicurien vous accueille dans un cadre élégant et apaisant. Découvrez une cuisine traditionnelle, généreuse et faite maison, à déguster en salle ou sur une belle terrasse ensoleillée."
    ],
    "nl": [
      "L'Épicurien verwelkomt je in een elegante en rustgevende omgeving. Geniet van royale, traditionele, huisgemaakte gerechten in de eetkamer of op het zonnige terras."
    ],
    "es": [
      "L'Épicurien le da la bienvenida en un ambiente elegante y relajante. Disfrute de una cocina casera, tradicional y generosa en el comedor o en la soleada terraza."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant-Bar l'Épicurien"
    ],
    "fr": [
      "Restaurant-Bar l'Épicurien"
    ]
  },
