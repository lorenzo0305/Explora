  "rdfs:comment": {
    "de": [
      "Der Bahnhof von Saillans an der Linie 64 Valence (Romans)-Die-Gap liegt außerhalb des Dorfes an der RD 93 (8 Minuten zu Fuß vom Zentrum entfernt). Fahrradpark (3 Plätze in Schließfächern), Parkplatz, Bushaltestelle der Linie D28 Richtung Die. Kein Fahrkartenschalter vor Ort."
    ],
    "en": [
      "Saillans station, on line 64 Valence (Romans)-Die-Gap, is located just outside the village on the RD 93 (8 min. walk from the center). Bike park (3 locker spaces), parking lot, bus stop for the D28 line to Die. No ticket office on site."
    ],
    "it": [
      "La stazione di Saillans, sulla linea 64 Valence (Romans) - Die-Gap, si trova fuori dal paese sulla RD 93 (8 minuti a piedi dal centro). Parcheggio per biciclette (3 posti a sedere), parcheggio, fermata dell'autobus per la linea D28 per Die. Non c'è biglietteria in loco."
    ],
    "fr": [
      "La gare de Saillans, sur la ligne 64 Valence (Romans)-Die-Gap, est située à l'extérieur du village sur la RD 93 (8 mn à pied du centre). Parc vélo (3 places en consigne), parking, arrêt de bus de la ligne D28 direction Die. Pas de guichet sur place."
    ],
    "es": [
      "La estación de Saillans, en la línea 64 Valence (Romans)-Die-Gap, se encuentra a las afueras del pueblo, en la RD 93 (a 8 minutos a pie del centro). Aparcamiento para bicicletas (3 plazas bajo llave), aparcamiento, parada de autobús de la línea D28 a Die. No hay taquilla."
    ],
    "nl": [
      "Het station van Saillans, op lijn 64 Valence (Romeinen)-Die-Gap, ligt buiten het dorp aan de RD 93 (8 minuten lopen van het centrum). Fietsenstalling (3 afsluitbare plaatsen), parkeerplaats, bushalte voor de lijn D28 naar Die. Geen loket ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gare de Saillans"
    ]
  },
