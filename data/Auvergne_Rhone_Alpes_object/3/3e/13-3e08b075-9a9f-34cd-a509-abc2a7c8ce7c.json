  "rdfs:comment": {
    "de": [
      "Die Notorious Family ist eine Kantine und ein Cateringservice für Familie und Freunde, die durch die Liebe zum Geschmack, zum Teilen und zu schönen Produkten vereint sind."
    ],
    "en": [
      "United by the same love of taste, sharing and beautiful products, the Notorious Family is a canteen and catering service for family and friends."
    ],
    "it": [
      "Uniti dallo stesso amore per il gusto, la condivisione e i bei prodotti, la Notorious Family è una mensa e un servizio di catering per famiglie e amici."
    ],
    "fr": [
      "Unie par le même amour du goût, du partage et des beaux produits, la Notorious Family c'est une cantine et un service traiteur en famille et entre amis."
    ],
    "nl": [
      "Verenigd door dezelfde liefde voor smaak, delen en mooie producten, is de Notorious Family een kantine en een cateringservice voor families en vrienden."
    ],
    "es": [
      "Unidos por el mismo amor al sabor, a compartir y a los productos bonitos, la Familia Notorious es una cantina y un servicio de catering para familias y amigos."
    ]
  },
