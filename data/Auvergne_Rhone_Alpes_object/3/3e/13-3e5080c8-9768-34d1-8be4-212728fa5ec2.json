  "rdfs:comment": {
    "de": [
      "Der Club des Gentianes ist ein Verein, der sich den Aktivitäten für Senioren in der Region widmet. Er organisiert gesellige Treffen, kulturelle Ausflüge, Wanderungen und kreative Workshops, um die Verbindung und das Wohlbefinden der Mitglieder zu fördern."
    ],
    "en": [
      "Club des Gentianes is an association dedicated to activities for local seniors. It organizes friendly get-togethers, cultural outings, hikes, and creative workshops to promote the bonding and well-being of its members."
    ],
    "it": [
      "Il Club des Gentianes è un'associazione dedicata alle attività per gli anziani della regione. Organizza incontri conviviali, uscite culturali, passeggiate e laboratori creativi per aiutare i membri a rimanere in contatto e a sentirsi bene."
    ],
    "fr": [
      "Le Club des Gentianes est une association dédiée aux activités pour les seniors de la région. Il organise des rencontres conviviales, des sorties culturelles, des randonnées, et des ateliers créatifs pour favoriser le lien et le bien-être des membres."
    ],
    "es": [
      "El Club des Gentianes es una asociación dedicada a actividades para las personas mayores de la región. Organiza encuentros amistosos, salidas culturales, paseos y talleres creativos para que los socios se mantengan en contacto y se sientan bien."
    ],
    "nl": [
      "Club des Gentianes is een vereniging die zich inzet voor activiteiten voor senioren uit de regio. Ze organiseert gezellige bijeenkomsten, culturele uitstapjes, wandelingen en creatieve workshops om de leden te helpen contact te houden en zich goed te voelen."
    ]
  },
