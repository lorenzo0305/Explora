  "rdfs:comment": {
    "de": [
      "Die charmanten Gassen von Upie winden sich um den Berg Miery. Entdecken Sie die Geschichte dieses kreisförmigen Dorfes und seiner Kirche, die auf den Ruinen eines alten Schlosses errichtet wurde."
    ],
    "en": [
      "Upie?s charming little streets wind around Mount Miery. Discover the history of this circular village and its church, built on the ruins of an ancient castle."
    ],
    "it": [
      "Ricche di fascino, le stradine di Upie si snodano intorno al Monte Miery. Scoprite la storia di questo villaggio circolare e della sua chiesa, costruita sulle rovine di un antico castello."
    ],
    "fr": [
      "Pleines de charme, les ruelles d’Upie s’enroulent autour du mont Miery. Découvrez l’histoire de ce village circulaire et celle de son église bâtie sur les ruines d’un ancien château."
    ],
    "nl": [
      "Vol charme kronkelen de smalle straatjes van Upie rond de berg Miery. Ontdek de geschiedenis van dit ronde dorp en zijn kerk, gebouwd op de ruïnes van een oud kasteel."
    ],
    "es": [
      "Llenas de encanto, las callejuelas de Upie serpentean alrededor del monte Miery. Descubra la historia de este pueblo circular y su iglesia, construida sobre las ruinas de un antiguo castillo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Le village d'Upie"
    ]
  },
