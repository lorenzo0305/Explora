  "rdfs:comment": {
    "de": [
      "Mars prend ses quartiers kehrt im 9. Jahr zurück: Ausstellungen, kommentierte Führungen, Dokumentarfilme... Entdecken und verstehen Sie in Begleitung von Gesundheitsfachkräften die Funktionsweise des medizinisch-psychologischen Zentrums Sainte Marie."
    ],
    "en": [
      "Mars prend ses quartiers is back for the 9th year: exhibitions, guided tours, documentaries... In the company of healthcare professionals, come and discover and understand how the Sainte Marie medical-psychological center works."
    ],
    "it": [
      "Mars prend ses quartiers torna per il nono anno: mostre, visite guidate, documentari... In compagnia di professionisti della salute, venite a scoprire e a capire come funziona il centro medico e psicologico Sainte Marie."
    ],
    "fr": [
      "Mars prend ses quartiers revient pour la 9e année : expositions, visites commentées, documentaires... En compagnie des professionnels de santé, venez découvrir et comprendre le fonctionnement du centre médico-psychologique Sainte Marie."
    ],
    "es": [
      "Mars prend ses quartiers vuelve por noveno año: exposiciones, visitas guiadas, documentales... En compañía de profesionales de la salud, venga a descubrir y comprender el funcionamiento del centro médico y psicológico Sainte Marie."
    ],
    "nl": [
      "Mars prend ses quartiers is terug voor het 9e jaar: tentoonstellingen, rondleidingen, documentaires... Kom in gezelschap van gezondheidsprofessionals ontdekken en begrijpen hoe het medisch en psychologisch centrum Sainte Marie werkt."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mars prend ses quartiers : visite commentée du centre médico-psychologique Sainte Marie"
    ]
  },
