  "rdfs:comment": {
    "de": [
      "Die Auberge de Larina bietet Ihnen Menüs im Rhythmus der Jahreszeiten in einer freundlichen Atmosphäre und einem authentischen Rahmen.\r\nEine schmackhafte Küche, die ausschließlich aus lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Situated on the heights of the Balcons du Dauphiné, Miguel and Anne-Laure welcome you to their inn, where you can enjoy seasonal menus in a friendly atmosphere. Their delicious cuisine is based exclusively on local produce."
    ],
    "it": [
      "L'Auberge de Larina offre menù stagionali in un'atmosfera amichevole e in un ambiente autentico.\r\nUna cucina gustosa realizzata esclusivamente con prodotti locali."
    ],
    "fr": [
      "L'auberge de Larina vous propose des menus rythmés par les saisons dans une ambiance conviviale et un cadre authentique.\r\nUne cuisine savoureuse élaborée exclusivement à base de produits locaux."
    ],
    "es": [
      "El Auberge de Larina ofrece menús de temporada en un ambiente acogedor y un marco auténtico.\r\nSabrosa cocina elaborada exclusivamente con productos locales."
    ],
    "nl": [
      "De Auberge de Larina biedt seizoensgebonden menu's in een vriendelijke sfeer en authentieke omgeving.\r\nSmakelijke gerechten uitsluitend gemaakt van lokale producten."
    ]
  },
