  "rdfs:comment": {
    "de": [
      "Genießen Sie diesen baumbestandenen Park, der die zahlreichen Baumarten mithilfe von erklärenden Schildern hervorhebt. Ein Spielplatz und die Tiere werden die Kinder erfreuen!"
    ],
    "en": [
      "Come and enjoy this wooded park, where the many species of trees are highlighted with explanatory panels. A play area and animals will delight children!(deer, hens, geese, ducks…)"
    ],
    "it": [
      "Venite a godervi questo parco alberato, dove le numerose specie di alberi sono evidenziate da pannelli esplicativi. Un'area giochi e animali faranno la gioia dei bambini!"
    ],
    "fr": [
      "Venez profiter de ce parc arboré qui met en valeur les nombreuses essences d'arbres à l'aide panneaux explicatifs. Une aire de jeux et les animaux réjouiront les enfants !"
    ],
    "es": [
      "Venga a disfrutar de este parque arbolado, donde las numerosas especies de árboles se destacan con paneles explicativos. Una zona de juegos y animales hará las delicias de los niños"
    ],
    "nl": [
      "Kom genieten van dit bosrijke park, waar de vele boomsoorten worden belicht met verklarende panelen. Een speeltuin en dieren zullen de kinderen verrukken!"
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Général Marchand\" Municipal Park and \"Arboretum\""
    ],
    "fr": [
      "Arboretum - Parc municipal Général Marchand"
    ]
  },
