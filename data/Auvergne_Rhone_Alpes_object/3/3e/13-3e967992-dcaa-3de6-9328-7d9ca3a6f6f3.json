  "rdfs:comment": {
    "de": [
      "Der Mountainbike-Bereich umfasst mehr als 40 verschiedene Strecken, die regelmäßig von den Freiwilligen des Mountainbike-Zentrums Pays d'Ambert markiert werden. Im Jahr 2023 werden mehrere Strecken im Haut Livradois mit mehreren Startpunkten eröffnet."
    ],
    "en": [
      "The mountain bike area includes over 40 different routes, regularly marked out by volunteers from the Pays d'Ambert mountain bike center. In 2023, several circuits will be opened in the Haut Livradois region, with several starting points."
    ],
    "it": [
      "L'area per la mountain bike comprende più di 40 percorsi diversi, regolarmente segnalati dai volontari del centro di mountain bike del Pays d'Ambert. Nel 2023 saranno aperti diversi circuiti nell'Haut Livradois, con diversi punti di partenza."
    ],
    "fr": [
      "L’espace VTT comprend plus de 40 parcours différents, balisés régulièrement par les bénévoles du centre VTT du Pays d’Ambert. En 2023, plusieurs circuits ouvrent sur le Haut Livradois avec plusieurs points de départ."
    ],
    "es": [
      "La zona de ciclismo de montaña incluye más de 40 rutas diferentes, señalizadas regularmente por voluntarios del centro de ciclismo de montaña Pays d'Ambert. En 2023 se abrirán varios circuitos en el Haut Livradois, con varios puntos de partida."
    ],
    "nl": [
      "Het mountainbikegebied omvat meer dan 40 verschillende routes, die regelmatig worden aangegeven door vrijwilligers van het mountainbikecentrum Pays d'Ambert. In 2023 worden er verschillende circuits geopend in de Haut Livradois, met verschillende startpunten."
    ]
  },
  "rdfs:label": {
