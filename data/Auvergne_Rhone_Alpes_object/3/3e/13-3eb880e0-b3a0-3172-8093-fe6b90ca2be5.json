  "rdfs:comment": {
    "de": [
      "Le Temps d’M bietet eine hausgemachte Küche und eine saisonal wechselnde Karte mit Gerichten aus frischen, lokalen Produkten. Vegetarier willkommen!"
    ],
    "en": [
      "Le Temps d’M offers home cooking and a seasonal menu based on fresh ingredients from local producers. Vegetarians welcome!"
    ],
    "it": [
      "Cucina casalinga di stagione, prodotti freschi di artigiani e produttori locali. Atmosfera accogliente e vegetariani benvenuti!"
    ],
    "fr": [
      "Cuisine fait maison de saison, produits frais des artisans et producteurs locaux. Ambiance cosy et Végétariens bienvenus !"
    ],
    "nl": [
      "Huisgemaakte seizoensgebonden gerechten, verse producten van lokale ambachtslieden en producenten. Gezellige sfeer en vegetariërs welkom!"
    ],
    "es": [
      "Cocina casera de temporada, productos frescos de artesanos y productores locales. Ambiente acogedor y los vegetarianos son bienvenidos"
