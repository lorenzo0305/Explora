  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Zentrum von Saint-Germain-Lembron entfernt bietet Ihnen der Jardin du Lembron ein vielfältiges Angebot an saisonalem Gemüse aus biologischem Anbau."
    ],
    "en": [
      "Just a stone's throw from the center of Saint-Germain-Lembron, the Jardin du Lembron offers a diverse range of organic seasonal vegetables."
    ],
    "it": [
      "A pochi passi dal centro di Saint-Germain-Lembron, l'orto Lembron offre una vasta gamma di verdure biologiche di stagione."
    ],
    "fr": [
      "A quelques pas du centre de Saint-Germain-Lembron, le jardin du Lembron vous propose une gamme diversifiée de légumes de saison en agriculture biologique."
    ],
    "nl": [
      "Op een steenworp afstand van het centrum van Saint-Germain-Lembron biedt de tuin van Lembron een gevarieerd aanbod van seizoensgebonden biologische groenten."
    ],
    "es": [
      "A dos pasos del centro de Saint-Germain-Lembron, el huerto Lembron ofrece una variada gama de verduras ecológicas de temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin du Lembron"
    ]
