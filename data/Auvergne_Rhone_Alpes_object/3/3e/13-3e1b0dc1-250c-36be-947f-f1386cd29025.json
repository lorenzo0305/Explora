  "rdfs:comment": {
    "de": [
      "Eine sportliche Rodelbahn mit einem Lift!\r\nDen ganzen Tag lang und auf einer für sie reservierten Piste können sich die Rodler dem Vergnügen hingeben, \"fast\" endlos hinunterzufahren."
    ],
    "en": [
      "A sportive sledging area with a ski lift!\r\nAll day, sledgers will have the pleasure to ride \"almost\" endlessly on a 2.1km dedicated slope. \r\nNo need to drag the sledge with Gaboureaux chairlift!"
    ],
    "it": [
      "Una pista da slittino sportiva con ascensore!\r\nPer tutto il giorno, e su una pista a loro riservata, gli slittinisti potranno godere del piacere di scendere \"quasi\" all'infinito."
    ],
    "fr": [
      "Une piste de luge sportive avec une remontée mécanique !\r\nToute la journée, et sur une piste qui leur est réservée, les lugeurs vont pouvoir s’adonner au plaisir de descendre \"presque\" sans fin."
    ],
    "es": [
      "Una pista de trineo deportiva con ascensor\r\nDurante todo el día, y en una pista reservada para ellos, los trineos podrán disfrutar del placer de bajar \"casi\" sin parar."
    ],
    "nl": [
      "Een sportrodelbaan met een lift!\r\nDe hele dag, en op een voor hen gereserveerd parcours, zullen de sleeërs kunnen genieten van het plezier om \"bijna\" eindeloos naar beneden te gaan."
    ]
  },
  "rdfs:label": {
    "de": [
      "Rodelpark - Schneeschlitten (Bobschlitten)"
    ],
    "en": [
      "Sledging Park - Snow luge (bobsled)"
    ],
    "fr": [
      "Luge Park - Snow luge (luge bob)"
    ]
  },
