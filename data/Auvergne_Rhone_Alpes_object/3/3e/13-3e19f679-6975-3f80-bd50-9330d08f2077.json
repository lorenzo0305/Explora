  "rdfs:comment": {
    "de": [
      "Die Black Pearl Bar ist gleichzeitig eine Bar und ein Restaurant in einem rockigen Ambiente mit Piratendeko und befindet sich in der Nähe des Parkplatzes von Le Breuil."
    ],
    "en": [
      "The Black Pearl Bar is both a bar and a restaurant, with a rock'n'roll atmosphere and pirate decor, located near the Breuil parking lot."
    ],
    "it": [
      "Il Black Pearl Bar è sia un bar che un ristorante, con un'atmosfera rock'n'roll e un arredamento piratesco, situato vicino al parcheggio Le Breuil."
    ],
    "fr": [
      "Le Black Pearl Bar est à la fois un bar et un restaurant dans une ambiance rock à la déco pirate, situé en proximité du parking du Breuil."
    ],
    "es": [
      "El Black Pearl Bar es a la vez bar y restaurante, con ambiente rock'n'roll y decoración pirata, situado cerca del aparcamiento de Le Breuil."
    ],
    "nl": [
      "De Black Pearl Bar is zowel een bar als een restaurant, met een rock-'n-roll sfeer en een piratendecor, en ligt vlak bij de parkeergarage Le Breuil."
