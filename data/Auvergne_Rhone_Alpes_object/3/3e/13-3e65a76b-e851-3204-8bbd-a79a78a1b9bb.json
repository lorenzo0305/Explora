  "rdfs:comment": {
    "de": [
      "Exzellenz zwischen See und Bergen!\r\n30 Minuten vom Flughafen Genf und 3 Stunden 45 Minuten von Paris mit dem TGV entfernt, liegt das Impérial Palace - Groupe PVG, in einem wunderschönen Park mit Bäumen und Blumen, am Ufer des Sees von Annecy."
    ],
    "en": [
      "Excellence between lake and mountains!\r\nJust 30 minutes from Geneva airport and 3h45 from Paris by TGV, the Impérial Palace - Groupe PVG, is set in a superb park with trees and flowers, on the shores of Lake Annecy."
    ],
    "it": [
      "A meno di 30 min. dall’aeroporto di Ginevra, l'Impérial Palace (Hôtel**** - Spa - Casinò – Centro Congressi) del gruppo PVG, si trova in un bellissimo parco alberato, lungo le sponde del lago di Annecy."
    ],
    "fr": [
      "L'excellence entre lac et montagnes !\r\nA 30 min de l'aéroport de Genève et 3h45 de Paris en TGV, l'Impérial Palace - Groupe PVG, est situé dans un superbe parc arboré et fleuri, sur les rives du lac d'Annecy."
    ],
    "es": [
      "¡Excelencia entre lago y montaña!\r\nA sólo 30 minutos del aeropuerto de Ginebra y a 3h45 de París en TGV, el Impérial Palace - Groupe PVG, se encuentra en un magnífico parque con árboles y flores, a orillas del lago de Annecy."
    ],
    "nl": [
      "Het Impérial Palace (Hotel**** - Spa - Casino - Congrescentrum) van de PVG groep ligt op minder dan 30 min van het vliegveld van Genève in een schitterend bebost park, aan de oevers van het zuiverste meer van Europa."
    ]
  },
