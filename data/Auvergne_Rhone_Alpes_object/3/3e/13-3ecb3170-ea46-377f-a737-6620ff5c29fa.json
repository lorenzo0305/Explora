  "rdfs:comment": {
    "de": [
      "Entdecken Sie unser komplett renoviertes Restaurant \"Le Loft\", wo sich Design mit Komfort und dem Licht energiegeladener Farben vermischt."
    ],
    "en": [
      "Completely renovated in 2025, Le Loft is open for lunch and dinner on weekdays. It offers a stylish setting that blends fine materials with industrial influences. Chef Sebastiao offers a concise menu featuring fresh and seasonal ingredients."
    ],
    "it": [
      "Vieni a scoprire il nostro ristorante interamente rinnovato, il Loft, dove il design si mescola al comfort e la luce ai colori energici."
    ],
    "fr": [
      "Entièrement rénové en 2025, Le Loft vous accueille midi et soir en semaine, dans un cadre design mêlant matériaux nobles et références industrielles. Le chef Sebastiao vous propose une carte courte, autour d'ingrédients frais et de saison."
    ],
    "nl": [
      "Le Loft, volledig gerenoveerd in 2025, verwelkomt je op doordeweekse dagen voor lunch en diner in een designomgeving met edele materialen en industriële referenties. Chef Sebastiao biedt een kort menu op basis van verse, seizoensgebonden ingrediënten."
    ],
    "es": [
      "Descubre nuestro restaurante Le Loft, completamente renovado, donde el diseño se mezcla con la comodidad y la luz de colores dinámicos."
    ]
  },
