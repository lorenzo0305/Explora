  "rdfs:comment": {
    "de": [
      "Verleih von E-Mountainbikes im Herzen der Berge in Chaucisse, einem Weiler von Saint-Nicolas la Chapelle. Zahlreiche Mountainbike-Strecken und großartige Naturlandschaften warten darauf, entdeckt zu werden."
    ],
    "en": [
      "Electric mountain bike rental in the heart of the mountains in Chaucisse, a hamlet of Saint-Nicolas la Chapelle. Numerous mountain bike trails to explore and magnificent natural landscapes."
    ],
    "it": [
      "Noleggio di mountain bike elettriche nel cuore delle montagne a Chaucisse, nella frazione di Saint-Nicolas la Chapelle. Ci sono molti percorsi per mountain bike da scoprire e il paesaggio è a grandezza naturale."
    ],
    "fr": [
      "Location de VTT électrique au cœur de la montagne à Chaucisse, hameau de Saint-Nicolas la Chapelle. De nombreux sentiers de VTT à découvrir et des paysages grandeurs nature."
    ],
    "nl": [
      "Verhuur van elektrische mountainbikes in het hart van de bergen in Chaucisse, in het gehucht Saint-Nicolas la Chapelle. Er zijn tal van mountainbikeroutes om te ontdekken en het landschap is levensgroot."
    ],
    "es": [
      "Alquiler de bicicletas eléctricas de montaña en el corazón de las montañas de Chaucisse, en la aldea de Saint-Nicolas la Chapelle. Hay un montón de senderos para bicicletas de montaña para descubrir y el paisaje es de tamaño natural."
    ]
  },
  "rdfs:label": {
    "de": [
      "L'Authentique – Verleih von E-Mountainbikes"
    ],
    "en": [
      "L'Authentique - Electric Mountain Bike Rentals"
    ],
    "fr": [
      "L'Authentique - Locations de VTT électriques"
    ]
  },
