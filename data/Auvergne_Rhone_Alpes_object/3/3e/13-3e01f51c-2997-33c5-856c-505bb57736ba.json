  "rdfs:comment": {
    "de": [
      "Für ein Naturbad mit der Familie oder mit Freunden, in menschlicher Größe und weit entfernt vom Trubel der Strände an den Seen, ist L'Estanquiol ein Ort, den es zu entdecken gilt!\r\nÖffnung vorbehaltlich günstiger Badebedingungen."
    ],
    "en": [
      "L’Estanquiol: free swimming area supervised in July and August everyday afternoons.\r\nOpening subject to favourable bathing conditions.\r\nFishing activity (1st category = whitefish): Specific local card on sale at the Calvinet post office: 5 trout per day, €6 per adult per day or €40 per season."
    ],
    "it": [
      "Per una nuotata naturale in famiglia o con gli amici, a misura d'uomo e lontano dalla frenesia delle spiagge lacustri, l'Estanquiol è un luogo da scoprire!\r\nApertura soggetta a condizioni di balneazione favorevoli."
    ],
    "fr": [
      "Pour une baignade nature en famille ou entre amis, à taille humaine et loin de l'agitation des plages de lacs, l'Estanquiol est un endroit à découvrir !\r\nOuverture sous réserve de conditions de baignade favorables."
    ],
    "es": [
      "Para un baño natural en familia o entre amigos, a escala humana y lejos del bullicio de las playas lacustres, l'Estanquiol es un lugar por descubrir\r\nApertura sujeta a condiciones de baño favorables."
    ],
    "nl": [
      "L’Estanquiol: gratis zwemmen onder toezicht, iedere middag in juli en augustus.\r\nOpening onder voorbehoud van gunstige zwemomstandigheden.\r\nVisserijactiviteit (1ste categorie = witvis): Visvergunning te koop bij het postkantoor in Calvinet (5 forellen per dag, € 6 per volwassene per dag of € 40 per seizoen)."
    ]
  },
  "rdfs:label": {
    "en": [
      "L'Estanquiol Pond"
    ],
    "fr": [
      "Étang d'Estanquiol - Calvinet"
    ],
    "nl": [
      "Vijver van Estanquiol"
    ]
  },
