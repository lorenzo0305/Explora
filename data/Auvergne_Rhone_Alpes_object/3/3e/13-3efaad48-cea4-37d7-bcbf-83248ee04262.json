  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, feine und gepflegte Küche. Savoyische Spezialitäten und Pizzeria vor Ort oder zum Mitnehmen. Bar. Terrasse mit Panoramablick auf das Beaufortain-Massiv und den Mont-Blanc."
    ],
    "en": [
      "Traditional restaurant, fine and neat cuisine. Savoy specialties and pizzeria on the spot or take away. Bar. Terrace with panoramic view on the Beaufortain mountains and Mont Blanc."
    ],
    "it": [
      "Ristorante tradizionale, cucina raffinata e attenta. Specialità savoiarde e pizzeria sul posto o da portare via. Bar. Terrazza con vista panoramica sul massiccio del Beaufortain e sul Monte Bianco."
    ],
    "fr": [
      "Restaurant traditionnel, cuisine fine et soignée. Spécialités savoyardes et pizzeria sur place ou à emporter. Bar. Terrasse avec vue panoramique sur le massif du Beaufortain et sur le Mont-Blanc."
    ],
    "nl": [
      "Traditioneel restaurant, fijne en zorgvuldige keuken. Savoyaardse specialiteiten en pizzeria ter plaatse of om mee te nemen. Bar. Terras met panoramisch uitzicht op het Beaufortain-massief en de Mont-Blanc."
    ],
    "es": [
      "Restaurante tradicional, cocina fina y cuidada. Especialidades de Saboya y pizzería in situ o para llevar. Bar. Terraza con vista panorámica del macizo de Beaufortain y del Mont Blanc."
    ]
  },
