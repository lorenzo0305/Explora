  "rdfs:comment": {
    "de": [
      "Das Restaurant zeigt seine neuen Farben... Das von Christian Lacroix dekorierte Restaurant in den Räumen des CNCS bietet Ihnen einen maßgeschneiderten und einladenden Service für Ihr Mittagessen oder einen Moment der Gaumenfreude."
    ],
    "en": [
      "The restaurant shows its new colors... Decorated by Christian Lacroix, within the CNCS spaces, a tailor-made and welcoming service for lunches, or for a gourmet moment."
    ],
    "it": [
      "Il ristorante mostra i suoi nuovi colori... Decorati da Christian Lacroix, all'interno degli spazi del CNCS, un servizio su misura e accogliente per pranzi, o per un momento gourmet."
    ],
    "fr": [
      "Le restaurant affiche ses nouvelles couleurs... Décoré par Christian Lacroix, au sein des espaces du CNCS, un service sur mesure et accueillant pour les déjeuners, ou à l'occasion d'un moment gourmand."
    ],
    "nl": [
      "Het restaurant toont zijn nieuwe kleuren... Ingericht door Christian Lacroix, binnen de CNCS ruimtes, een op maat gemaakte en gastvrije service voor lunches, of voor een gastronomisch moment."
    ],
    "es": [
      "El restaurante muestra sus nuevos colores... Decorado por Christian Lacroix, dentro de los espacios del CNCS, un servicio a medida y acogedor para los almuerzos, o para un momento gourmet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café-Brasserie du CNCS"
    ]
  },
