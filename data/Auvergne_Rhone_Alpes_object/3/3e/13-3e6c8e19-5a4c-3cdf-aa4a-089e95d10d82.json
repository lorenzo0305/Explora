  "rdfs:comment": {
    "de": [
      "Das Hôtel restaurant du Centre in Brioude bietet Ihnen eine Rast an einem privilegierten Ort mitten im Stadtzentrum, ideal für einen Urlaub. Genießen Sie die Einfachheit und Authentizität eines gastfreundlichen Lokals."
    ],
    "en": [
      "The Hotel Restaurant du Centre in Brioude offers you a stopover in a privileged location in the city centre, ideal for holidays. Enjoy the simplicity and authenticity of a welcoming establishment."
    ],
    "it": [
      "L'Hotel Restaurant du Centre di Brioude vi offre una sosta in una posizione privilegiata nel centro della città, ideale per le vacanze. Godetevi la semplicità e l'autenticità di una struttura accogliente."
    ],
    "fr": [
      "L'Hôtel restaurant du Centre à Brioude vous propose une halte dans un endroit privilégié en plein centre-ville, idéal pour les vacances. Profitez de la simplicité et de l'authenticité d'un établissement accueillant."
    ],
    "nl": [
      "Het Hotel Restaurant du Centre in Brioude biedt u een tussenstop op een bevoorrechte locatie in het stadscentrum, ideaal voor vakanties. Geniet van de eenvoud en authenticiteit van een gastvrij etablissement."
    ],
    "es": [
      "El Hotel Restaurant du Centre de Brioude le ofrece una parada en una ubicación privilegiada en el centro de la ciudad, ideal para las vacaciones. Disfrute de la sencillez y la autenticidad de un establecimiento acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hotel du Centre"
    ]
  },
