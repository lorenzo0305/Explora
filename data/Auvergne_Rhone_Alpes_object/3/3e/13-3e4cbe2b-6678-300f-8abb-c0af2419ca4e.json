  "rdfs:comment": {
    "de": [
      "Es bietet Informationen über Weinbau und die AOP des Diois und lädt ein, die Weingüter auf acht markierten Wein-Lehrwegen innerhalb von 35 bis 90 Minuten zu entdecken."
    ],
    "en": [
      "This centre provides information about wine-growing and the Diois AOP wines such as Clairette de Die, a sparkling and fruity wine. It can propose wine tastings and encourages the visitor to discover the estates and wine cellars along the Clairette de Die discovery route or along 7 wine tourism trails."
    ],
    "it": [
      "Sede del sindacato dei vini AOC Die. Comunicazione e promozione dei vini. Accoglienza dei visitatori che desiderano saperne di più sulla viticoltura e sulla DOC. Possibilità di degustazione."
    ],
    "fr": [
      "Siège du syndicat de l'AOC des vins de Die. Communication et promotion des vins. Accueil des visiteurs souhaitant s'informer sur la viticulture et les AOC. Dégustation possible."
    ],
    "es": [
      "Sede del sindicato de vinos AOC Die. Comunicación y promoción de vinos. Recepción de visitantes que deseen conocer mejor la viticultura y la DOC. Posibilidad de degustación."
    ],
    "nl": [
      "Hoofdkantoor van het wijnsyndicaat AOC Die. Communicatie en promotie van de wijnen. Ontvangt bezoekers die meer willen weten over de wijnbouw en de AOC. Wijnproeverij beschikbaar."
    ]
  },
