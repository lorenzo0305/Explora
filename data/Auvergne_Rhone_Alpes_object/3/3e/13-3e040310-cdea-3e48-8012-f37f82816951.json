  "rdfs:comment": {
    "de": [
      "Nature et Patrimoine besteht aus diplomierten Bergführern, die seit vielen Jahren im Vercors tätig sind. Im Laufe der Zeit haben wir uns Kenntnisse über diese Gegend angeeignet, die wir Ihnen mit Leidenschaft näher bringen."
    ],
    "en": [
      "Nature et Patrimoine is a group of qualified mountain guides who have been in the Vercors for many years. Over the years, we have acquired a wealth of knowledge about this area, which we will passionately share with you."
    ],
    "it": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey e gli altri, siamo noi, Curieux de Vercors!... un'allegra squadra di professionisti con la passione per la montagna e le qualifiche (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "fr": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey…. et les autres, c’est nous Curieux de Vercors !...une joyeuse équipe de professionnels passionnés de montagne, et diplômés (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "es": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey... y los demás, ¡somos nosotros, Curieux de Vercors!... un feliz equipo de profesionales apasionados por la montaña y cualificados (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ],
    "nl": [
      "Caroline, Laurent, Marie-Odile, Coralie, Audrey en de anderen, dat zijn wij, Curieux de Vercors!... een gelukkig team van professionals met een passie voor de bergen en kwalificaties (Diplôme d'Etat Accompagnateur en Moyenne Montagne)."
    ]
  },
  "rdfs:label": {
    "de": [
      "Les Accompagnateurs Nature et Patrimoine"
    ],
    "en": [
      "Nature et Patrimoine Guides"
    ],
    "fr": [
      "Curieux de Vercors, accompagnateurs en montagne"
    ]
  },
