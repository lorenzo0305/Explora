  "rdfs:comment": {
    "de": [
      "Philippe und Jean-Marie Vial stammen sowohl väterlicher- als auch mütterlicherseits aus Winzerfamilien. Sie bauen die Rebsorten Gamay, Chardonnay und Viognier auf den Hängen von Bouthéran an. Das Weingut ist für den biologischen Landbau zertifiziert."
    ],
    "en": [
      "Descended from winegrowing families on both their fathers' and mothers' sides, Philippe and Jean-Marie Vial grow Gamay, Chardonnay and Viognier grapes on the Bouthéran hillside. The estate is certified organic."
    ],
    "it": [
      "Philippe e Jean-Marie Vial provengono da famiglie di viticoltori sia da parte di padre che di madre e coltivano uve Gamay, Chardonnay e Viognier sulla collina di Bouthéran. La tenuta è certificata biologica."
    ],
    "fr": [
      "Issus de familles de viticulteurs aussi bien du côté paternel que maternel, Philippe et Jean-Marie Vial cultivent les cépages Gamay, Chardonnay et Viognier sur le coteau de Bouthéran. Le domaine est certifié Agriculture Biologique."
    ],
    "es": [
      "Philippe y Jean-Marie Vial proceden de familias de viticultores por parte de padre y madre, y cultivan uvas Gamay, Chardonnay y Viognier en la ladera de Bouthéran. La explotación está certificada como ecológica."
    ],
    "nl": [
      "Philippe en Jean-Marie Vial komen uit wijnbouwfamilies van zowel vaders- als moederskant en verbouwen Gamay-, Chardonnay- en Viognier-druiven op de heuvel van Bouthéran. Het landgoed is biologisch gecertificeerd."
    ]
  },
