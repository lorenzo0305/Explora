  "rdfs:comment": {
    "de": [
      "Die 6 Chöre desselben Chorleiters Christophe Andrieux werden für ein einziges Konzert am Samstag, den 21. März 2026 um 15 Uhr in der Turnhalle von Chaspuzac vereint. Ein Ereignis, das Sie nicht verpassen sollten, für einen guten Zweck: die medizinische Forschung in der Augenheilkunde."
    ],
    "en": [
      "The 6 choirs led by Christophe Andrieux will join forces for a single concert on Saturday, March 21, 2026 at 3 p.m. in the Chaspuzac gymnasium. An event not to be missed, for a good cause: medical research in ophthalmology."
    ],
    "it": [
      "I 6 cori diretti da Christophe Andrieux si uniranno in un unico concerto sabato 21 marzo 2026 alle 15.00 nella palestra di Chaspuzac. Un evento da non perdere, per una buona causa: la ricerca medica in oftalmologia."
    ],
    "fr": [
      "Les 6 chorales du même chef de chœur Christophe Andrieux seront unis pour un seul concert le samedi 21 mars 2026 à 15 h au gymnase de Chaspuzac. Un évènement à ne pas manquer, pour une bonne cause : la recherche médicale en ophtalmologie."
    ],
    "es": [
      "Los 6 coros dirigidos por Christophe Andrieux unirán sus fuerzas en un único concierto el sábado 21 de marzo de 2026 a las 15.00 horas en el gimnasio de Chaspuzac. Una cita ineludible por una buena causa: la investigación médica en oftalmología."
    ],
    "nl": [
      "De 6 koren onder leiding van Christophe Andrieux bundelen hun krachten voor één concert op zaterdag 21 maart 2026 om 15.00 uur in de gymzaal van Chaspuzac. Een niet te missen evenement voor een goed doel: medisch onderzoek in de oogheelkunde."
    ]
  },
  "rdfs:label": {
    "fr": [
      "150 voix pour un seul Chœur"
    ]
  },
