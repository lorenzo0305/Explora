  "rdfs:comment": {
    "de": [
      "Das gesamte Team des Château des Pertonnières freut sich darauf, Ihnen seine Türen zu öffnen, damit Sie ihre Leidenschaft verkosten und teilen können: den Beaujolais!"
    ],
    "en": [
      "The whole team at the Château des Pertonnières will be delighted to welcome you to come and share their passion for Beaujolais!"
    ],
    "it": [
      "L'intero team dello Château des Pertonnières è lieto di aprirvi le porte per farvi assaggiare e condividere la loro passione: il Beaujolais!"
    ],
    "fr": [
      "Toute l’équipe du Château des Pertonnières se réjouie de vous ouvrir ses portes pour vous faire déguster et partager leur passion : le Beaujolais !"
    ],
    "es": [
      "Todo el equipo del Château des Pertonnières está encantado de abrirle sus puertas para que deguste y comparta su pasión: el Beaujolais"
    ],
    "nl": [
      "Het hele team van het Château des Pertonnières opent graag zijn deuren voor u om u hun passie te laten proeven en delen: de Beaujolais!"
    ]
  },
