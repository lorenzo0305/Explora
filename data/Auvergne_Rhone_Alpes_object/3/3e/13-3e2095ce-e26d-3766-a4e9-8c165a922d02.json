  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Fotostudio Céline Rochier, Fotografin in Lamastre, ein Ort, der der Fotografie gewidmet ist. Das Studio ist ein Einzelraum, in dem Erinnerungen in Bildern geschaffen werden, von der Geburt bis zu Mehrgenerationensitzungen, sowie Passfotos nach ANTS-Standards"
    ],
    "en": [
      "Discover Studio Photo Céline Rochier, photographer in Lamastre, a place dedicated to photography. The studio is a solo space, creating memories in images, from birth to multi-generation sessions, as well as ANTS-compliant identity photos?"
    ],
    "it": [
      "Scoprite lo Studio Photo Céline Rochier, fotografo a Lamastre, un luogo dedicato alla fotografia. Lo studio è uno spazio personale, che crea ricordi in immagini, dalla nascita alle sessioni multigenerazionali, oltre a foto d'identità secondo gli standard ANTS?"
    ],
    "fr": [
      "Découvrez le Studio Photo Céline Rochier, photographe à Lamastre, un lieu dédié à la photographie. Le studio est un espace solo, créant des souvenirs en images, de la naissance aux séances multigénération, ainsi que des photos d’identité aux normes ANTS…"
    ],
    "nl": [
      "Ontdek Studio Photo Céline Rochier, fotograaf in Lamastre, een plek gewijd aan fotografie. De studio is een soloruimte waar herinneringen in beelden worden omgezet, van geboorte tot sessies met meerdere generaties, maar ook identiteitsfoto's volgens de ANTS-normen?"
    ],
    "es": [
      "Descubra Studio Photo Céline Rochier, fotógrafo en Lamastre, un lugar dedicado a la fotografía. El estudio es un espacio en solitario, que crea recuerdos en imágenes, desde el nacimiento hasta sesiones multigeneracionales, así como fotos de identidad según las normas ANTS?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Céline Rochier Photographe"
    ]
  },
