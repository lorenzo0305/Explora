  "rdfs:comment": {
    "de": [
      "Sie kommen mit Freunden, im Rahmen eines Firmenaufenthalts, mit Schulklassen in den Vercors\r\nProfitieren Sie von angepassten Wanderungen, von leicht bis sportlich, zu verschiedenen Themen (Fauna, Flora, lokale Geschichten, Orientierung), im Sommer wie im Winter (Schneeschuhwanderungen)."
    ],
    "en": [
      "If you're coming to the Vercors with friends, as part of a corporate trip or with school groups\r\nTake advantage of adapted hikes, from easy to sporty, with themes (fauna, flora, local history, orientation), summer or winter (Rando-raquettes)."
    ],
    "it": [
      "Venite nel Vercors con amici, nell'ambito di una vacanza aziendale o con gruppi scolastici?\r\nApprofittate delle passeggiate adattate, da facili a sportive, a tema (fauna, flora, storia locale, orientamento), in estate o in inverno (escursioni con le racchette da neve)."
    ],
    "fr": [
      "Vous venez dans le Vercors entre amis, dans le cadre d’un séjour en entreprise, avec des scolaires \r\nProfitez de randonnées adaptées, de faciles à sportives, à thèmes (faune, flore, histoires locales, orientation), été comme hiver (Rando-raquettes)."
    ],
    "es": [
      "¿Viene al Vercors con amigos, en el marco de unas vacaciones de empresa o con grupos escolares?\r\nAproveche los paseos adaptados, de fáciles a deportivos, con temas (fauna, flora, historia local, orientación), en verano o en invierno (excursiones con raquetas de nieve)."
    ],
    "nl": [
      "Kom je naar de Vercors met vrienden, in het kader van een bedrijfsvakantie of met schoolgroepen?\r\nProfiteer van de aangepaste wandelingen, van eenvoudig tot sportief, met thema's (fauna, flora, plaatselijke geschiedenis, oriëntatie), in de zomer of in de winter (sneeuwschoenwandelingen)."
    ]
  },
