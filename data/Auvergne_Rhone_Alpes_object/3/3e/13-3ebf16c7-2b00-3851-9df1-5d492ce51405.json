  "rdfs:comment": {
    "de": [
      "Bei Pizza Cosy legen wir großen Wert darauf, lokale und saisonale Zutaten zu verwenden. Damit unterstützen wir die Erzeuger in der Region und garantieren gleichzeitig eine unvergleichliche Frische."
    ],
    "en": [
      "At Pizza Cosy, we make a point of using local, seasonal ingredients, supporting local producers while guaranteeing unrivalled freshness."
    ],
    "it": [
      "Per noi di Pizza Cosy è un punto d'onore utilizzare ingredienti locali e di stagione, sostenendo i produttori locali e garantendo una freschezza senza pari."
    ],
    "fr": [
      "Chez Pizza Cosy, nous mettons un point d’honneur à utiliser des ingrédients locaux et de saison, soutenant ainsi les producteurs de la région tout en garantissant une fraîcheur inégalée."
    ],
    "es": [
      "En Pizza Cosy, tenemos el honor de utilizar ingredientes locales y de temporada, apoyando a los productores locales y garantizando al mismo tiempo una frescura inigualable."
    ],
    "nl": [
      "Bij Pizza Cosy maken we er een erezaak van om lokale en seizoensgebonden ingrediënten te gebruiken. Zo steunen we lokale producenten en garanderen we ongeëvenaarde versheid."
    ]
  },
  "rdfs:label": {
