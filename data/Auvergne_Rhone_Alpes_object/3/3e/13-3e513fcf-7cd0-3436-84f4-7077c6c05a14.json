  "rdfs:comment": {
    "de": [
      "Willkommen im Wellnesszentrum Y Être Apeisey, im Herzen von Peisey-Vallandry. \r\nGönnen Sie sich einen Moment der Entspannung: Neuro- und Neoreflexzonenmassage, Hybridsauna, Hamam, japanisches Kopfbad, Hot-Stone-Behandlungen, kalifornische Massage und Amma-Massage im Sitzen."
    ],
    "en": [
      "Welcome to the Y Être Apeisey Wellness Centre, in the heart of Peisey-Vallandry. \r\nTreat yourself to a moment of relaxation: neuro and neo-reflexology, hybrid sauna, hammam, Japanese head spa, hot stone treatments, Californian and seated amma massages."
    ],
    "it": [
      "Benvenuti al Centre de Bien-Être Y Être Apeisey, nel cuore di Peisey-Vallandry.\r\nConcedetevi un momento di relax: neuro e neo-riflessiologia, sauna ibrida, hammam, spa giapponese, trattamenti con pietre calde, massaggi californiani e amma-assis."
    ],
    "fr": [
      "Bienvenue au Centre de Bien-Être Y Être Apeisey, au cœur de Peisey-Vallandry. \r\nOffrez-vous un moment de détente : neuro et néo-réflexologie, sauna hybride, hammam, head spa japonais, soins aux pierres chaudes, massages californien et amma-assis."
    ],
    "nl": [
      "Welkom bij Centre de Bien-Être Y Être Apeisey, in het hart van Peisey-Vallandry.\r\nTrakteer jezelf op een moment van ontspanning: neuro- en neoreflexologie, hybride sauna, hammam, Japanse hoofdspa, behandelingen met warme stenen, Californische en amma-assis massages."
    ],
    "es": [
      "Bienvenido al Centre de Bien-Être Y Être Apeisey, en el corazón de Peisey-Vallandry.\r\nRegálese un momento de relajación: neuro y neorreflexología, sauna híbrida, hammam, spa de cabeza japonés, tratamientos con piedras calientes, masajes californianos y amma-assis."
    ]
  },
