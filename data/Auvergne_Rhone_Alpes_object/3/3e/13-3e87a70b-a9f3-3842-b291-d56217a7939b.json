  "rdfs:comment": {
    "de": [
      "Am Fuße der Klippe Croix des Têtes erstreckt sich die Gemeinde Saint-Julien-Montdenis am rechten Ufer des Flusses Arc."
    ],
    "en": [
      "At the foot of the Croix des Têtes cliff, Saint-Julien-Montdenis lies on the right bank of the Arc river."
    ],
    "it": [
      "Ai piedi della falesia della Croix des Têtes, Saint-Julien-Montdenis si trova sulla riva destra del fiume Arc."
    ],
    "fr": [
      "Au pied de la falaise de la Croix des Têtes, la commune de Saint-Julien-Montdenis s’étend sur la rive droite de l’Arc."
    ],
    "es": [
      "Al pie del acantilado de la Croix des Têtes, el municipio de Saint-Julien-Montdenis se encuentra en la orilla derecha del Arco."
    ],
    "nl": [
      "Aan de voet van de rotswand Croix des Têtes ligt Saint-Julien-Montdenis op de rechteroever van de Arc."
    ]
  },
