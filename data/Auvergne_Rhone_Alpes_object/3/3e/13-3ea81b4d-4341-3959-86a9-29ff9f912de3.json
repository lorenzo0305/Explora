  "rdfs:comment": {
    "de": [
      "In der Nähe des charmanten Bergsees \"Lac du Môle\" sorgt eine verführerische 12-Loch-Minigolfanlage für Abwechslung am Nachmittag oder Abend."
    ],
    "en": [
      "Near the charming mountain lake ‘Lac du Môle’, an attractive 12-hole mini golf course provides entertainment for the afternoon or evening."
    ],
    "it": [
      "Vicino all'incantevole lago di montagna \"le Lac du Môle\", un attraente campo da minigolf a 12 buche vi permetterà di divertirvi nel pomeriggio o alla sera."
    ],
    "fr": [
      "Près d'un charmant lac de montagne \"le Lac du Môle\", un séduisant mini-golf de 12 trous vous permettra de vous divertir durant l'après midi ou la soirée."
    ],
    "es": [
      "Cerca del encantador lago de montaña \"le Lac du Môle\", un atractivo campo de minigolf de 12 hoyos le permitirá divertirse por la tarde o por la noche."
    ],
    "nl": [
      "Bij een charmant bergmeer \"le Lac du Môle\" kunt u zich 's middags of 's avonds vermaken op een aantrekkelijke midgetgolfbaan met 12 holes."
    ]
