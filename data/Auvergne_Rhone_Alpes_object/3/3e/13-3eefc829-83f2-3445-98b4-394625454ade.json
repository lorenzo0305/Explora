  "rdfs:comment": {
    "de": [
      "Das Atelier 380 ist ein neuer Ort für Holzkreationen in der Region Diois. Die Idee ist, nützliche und zugleich dekorative Objekte anzubieten."
    ],
    "en": [
      "Atelier 380 is a new woodworking studio in the Diois region. The idea is to create objects that are both useful and decorative."
    ],
    "it": [
      "atelier 380 è un nuovo studio di design del legno nella regione di Diois. L'idea è quella di creare oggetti che siano allo stesso tempo utili e decorativi."
    ],
    "fr": [
      "l’Atelier 380 est un nouveau lieu de création bois dans le Diois. L’idée étant de proposer des objets utiles et décoratifs tout à la fois."
    ],
    "es": [
      "atelier 380 es un nuevo estudio de diseño en madera de la región de Diois. La idea es crear objetos que sean a la vez útiles y decorativos."
    ],
