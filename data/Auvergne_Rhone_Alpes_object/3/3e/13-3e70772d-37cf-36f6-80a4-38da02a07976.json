  "rdfs:comment": {
    "de": [
      "Du vin sur la planche - Weinbar - Caviste.\r\nGroße Auswahl an Weinen vor Ort oder zum Mitnehmen.\r\nBretter, Tapas, Spezialitäten zum Teilen.\r\nGlühweine, Biere, Kaltgetränke, Crêpes, Eis."
    ],
    "en": [
      "Du vin sur la planche - Wine bar - Caviste.\r\nWide choice of wines on the premises or to take away.\r\nPlates, tapas, specialties to share.\r\nHot wines, beers, softs, crêpes."
    ],
    "it": [
      "Du vin sur la planche - Enoteca - Caviste.\r\nAmpia scelta di vini in loco o da asporto.\r\nPiatti, tapas, specialità da condividere.\r\nVini caldi, birre, bevande fredde, crêpes, gelati."
    ],
    "fr": [
      "Du vin sur la planche - Bar à vin - Caviste.\r\nGrand choix de vins sur place ou à emporter.\r\nPlanches, tapas, spécialités à partager.\r\nVins chauds, bières, boissons fraiches, crêpes, glaces."
    ],
    "nl": [
      "Du vin sur la planche - Wijnbar - Caviste.\r\nRuime keuze aan wijnen ter plekke of om mee te nemen.\r\nBorden, tapas, specialiteiten om te delen.\r\nWarme wijnen, bieren, softs, crêpes."
    ],
    "es": [
      "Du vin sur la planche - Vinoteca - Caviste.\r\nAmplia selección de vinos en el local o para llevar.\r\nPlatos, tapas, especialidades para compartir.\r\nVinos calientes, cervezas, bebidas frías, crepes, helados."
    ]
  },
