  "rdfs:comment": {
    "de": [
      "Eine Einladung, ein Live-Konzert mit einem Programm aus Jazz, Vokaljazz, Bossa oder Blues zu genießen. In einer warmen und entspannten Atmosphäre im Jazzclub-Stil können Sie sich von einer einfachen und leckeren Hausmannskost verführen lassen."
    ],
    "en": [
      "An invitation to enjoy a live concert, featuring jazz, vocal jazz, bossa or blues. In a warm, relaxed atmosphere, in a jazz club spirit, let yourself be tempted by simple, gourmet home cooking."
    ],
    "it": [
      "Godetevi un concerto dal vivo di jazz, jazz vocale, bossa e blues. In un'atmosfera calda e rilassata, da jazz club, lasciatevi tentare da una cucina casalinga semplice e gourmet."
    ],
    "fr": [
      "Une invitation à savourer un concert live, autour d’une programmation jazz, jazz vocal, bossa ou blues. Ambiance chaleureuse et détendue, dans un esprit jazz club, laissez-vous tenter par une cuisine maison, simple et gourmande."
    ],
    "nl": [
      "Geniet van een live concert met jazz, vocale jazz, bossa en blues. Laat je in een warme, ontspannen sfeer met een jazzclubgevoel verleiden door de eenvoudige, gastronomische thuiskeuken."
    ],
    "es": [
      "Disfrute de un concierto en directo de jazz, jazz vocal, bossa y blues. En un ambiente cálido y relajado con aires de club de jazz, déjese tentar por una cocina casera sencilla y gourmet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : C'est la paye, ça s' arrose !"
    ]
  },
