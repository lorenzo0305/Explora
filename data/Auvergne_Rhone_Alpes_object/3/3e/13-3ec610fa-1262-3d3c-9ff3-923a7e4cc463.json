  "rdfs:comment": {
    "de": [
      "Parcours für erfahrene Erwachsene und Jugendliche. Sehr luftige und spielerische Strecke mit vielen Affenbrücken, Nepalbrücken, Balken, Hängeleitern und einer optionalen Seilrutsche mitten durch die Wand."
    ],
    "en": [
      "For experienced adults and teenagers. A very aerial and fun circuit with many monkey bridges, Nepalese bridges, beams, suspended ladders and an optional zip line in the middle of the wall."
    ],
    "it": [
      "Corso per adulti e ragazzi esperti. Un circuito molto aereo e divertente con tanti ponti di scimmie, ponti nepalesi, travi, scale sospese e una zip line opzionale al centro della parete."
    ],
    "fr": [
      "Parcours pour adultes et ados expérimentés. Circuit très aérien et ludique avec beaucoup de pont de singe, pont népalais, poutre, échelle suspendue et une tyrolienne facultative en pleine paroi."
    ],
    "nl": [
      "Cursus voor ervaren volwassenen en tieners. Een erg luchtig en leuk circuit met veel apenbruggen, Nepalese bruggen, balken, hangladders en een optionele tokkelbaan in het midden van de muur."
    ],
    "es": [
      "Curso para adultos y adolescentes con experiencia. Un circuito muy aéreo y divertido con muchos puentes mono, puentes nepalíes, vigas, escaleras suspendidas y una tirolina opcional en medio de la pared."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Ferrata Thiousso"
    ]
  },
