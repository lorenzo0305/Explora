  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn Sie mit Ihrer Familie einen geselligen Moment verbringen würden? Lernen Sie Minigolf auf dem Campingplatz von St Didier sur Chalaronne, der im Departement Ain am Flussufer in einer grünen und erholsamen Umgebung liegt. Es besteht die Möglichkeit, vor Ort zu essen."
    ],
    "en": [
      "How about spending some quality family time? Come and learn mini-golf at the St Didier sur Chalaronne campsite, located by the river in a green and relaxing setting. Possibility to eat on site."
    ],
    "it": [
      "Vi piacerebbe trascorrere un po' di tempo in famiglia? Venite a cimentarvi nel mini-golf al campeggio St Didier sur Chalaronne, situato nel dipartimento dell'Ain, accanto al fiume in un ambiente verde e rilassante. Ristorazione disponibile in loco."
    ],
    "fr": [
      "Que diriez-vous de passer un moment convivial en famille ? Venez vous initier au mini-golf du camping de St Didier sur Chalaronne, situé dans l’Ain, au bord de la rivière dans un cadre verdoyant et reposant. Possibilité de vous restaurer sur place."
    ],
    "es": [
      "¿Le apetece pasar un rato en familia? Venga a probar el minigolf en el camping St Didier sur Chalaronne, situado en el departamento de Ain, a orillas del río, en un entorno verde y relajante. Servicio de restauración in situ."
    ],
    "nl": [
      "Wat zou je ervan vinden om wat tijd met het gezin door te brengen? Kom midgetgolfen op camping St Didier sur Chalaronne in het departement Ain, aan de oever van de rivier, in een groene en ontspannende omgeving. Catering ter plaatse."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mini-Golf and mini farm"
    ],
    "fr": [
      "Mini-Golf et mini-ferme"
    ]
  },
