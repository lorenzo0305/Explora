      "@id": "https://data.datatourisme.fr/f6703a32-e4ce-3c85-9df8-a03f3c7bde6d",
      "dc:description": {
        "de": [
          "Yoga im Golfclub von Nampont\n\nWohlbefinden, Beweglichkeit, Atmung, Entspannung\nSamstag, 31. Januar von 9.30 bis 12 Uhr\nNampont-St-Martin\n------------------------------\nWorkshop unter der Leitung von Nathalie Nolen, Mentaltrainerin, Sophrologie, Hypnose, Achtsamkeit?\nOffen für Golfer und Nicht-Golfer\n\nPreis: 30? pro Workshop - Infos/Reservierungen: 06 76 64 11 21 oder auf der Website: www.coachmental-golf.fr\nIm Saal mit Panoramablick auf den Golfplatz\n\nCredit: Pixabay"
        ],
        "en": [
          "Yoga at the Nampont Golf Club\n\nWell-being, mobility, breathing, relaxation\nSaturday January 31st, 9.30am to 12pm\nNampont-St-Martin\n------------------------------\nWorkshop led by Nathalie Nolen, mental coach, sophrology, hypnosis, mindfulness?\nOpen to golfers and non-golfers alike\n\nFee: ?30 per workshop - Info/reservations: 06 76 64 11 21 or visit www.coachmental-golf.fr\nIn the room with panoramic view of the golf course\n\nCredit : Pixabay"
        ],
        "it": [
          "Yoga al Nampont Golf Club\n\nBenessere, mobilità, respirazione, rilassamento\nSabato 31 gennaio dalle 9.30 alle 12.00\nNampont-St-Martin\n------------------------------\nWorkshop condotto da Nathalie Nolen, mental trainer, sofrologia, ipnosi, mindfulness?\nAperto a golfisti e non golfisti\n\nCosto: € 30 per workshop - Informazioni/prenotazioni: 06 76 64 11 21 o www.coachmental-golf.fr\nNella sala con vista panoramica sul campo da golf\n\nCredito: Pixabay"
        ],
        "fr": [
          "Yoga au Golf Club de Nampont\n\nBien-être, mobilité, respiration, relaxation\nSamedi 31 janvier de 9h30 à 12h\nNampont-St-Martin\n------------------------------\nAtelier animé par Nathalie Nolen, préparatrice mentale, sophrologie, hypnose, pleine conscience…\nOuvert aux golfeurs et non-golfeurs\n\nTarif : 30€ l’atelier - Infos/réservations : 06 76 64 11 21 ou sur le site : www.coachmental-golf.fr \nDans la salle avec vue panoramique sur le golf\n\nCrédit : Pixabay"
        ],
        "nl": [
          "Yoga op de Nampont Golf Club\n\nWelzijn, mobiliteit, ademhaling, ontspanning\nZaterdag 31 januari van 9.30 tot 12.00 uur\nNampont-St-Martin\n------------------------------\nWorkshop onder leiding van Nathalie Nolen, mental trainer, sofrologie, hypnose, mindfulness?\nOpen voor golfers en niet-golfers\n\nKosten: € 30 per workshop - Informatie/reserveren: 06 76 64 11 21 of kijk op www.coachmental-golf.fr\nIn de zaal met panoramisch uitzicht op de golfbaan\n\nKrediet: Pixabay"
        ],
        "es": [
          "Yoga en el Nampont Golf Club\n\nBienestar, movilidad, respiración, relajación\nSábado 31 de enero de 9h30 a 12h00\nNampont-St-Martin\n------------------------------\nTaller dirigido por Nathalie Nolen, entrenadora mental, sofrología, hipnosis, mindfulness..\nAbierto a golfistas y no golfistas\n\nPrecio: 30 euros por taller - Información/reserva: 06 76 64 11 21 o visite www.coachmental-golf.fr\nEn la sala con vistas panorámicas al campo de golf\n\nCrédito: Pixabay"
        ]
      },
