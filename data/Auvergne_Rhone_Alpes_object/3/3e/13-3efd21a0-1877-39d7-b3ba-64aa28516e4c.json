  "rdfs:comment": {
    "de": [
      "Notre caveau se niche dans les hauteurs de Marcilly-le-Châtel, à une altitude de 650 mètres, offrant une vue imprenable sur le paysage environnant.\r\nNous avons choisi de rester à taille humaine et de travailler la terre avec des méthodes traditionnelles."
    ],
    "en": [
      "Notre caveau se niche dans les hauteurs de Marcilly-le-Châtel, à une altitude de 650 mètres, offrant une vue imprenable sur le paysage environnant.\r\nNous avons choisi de rester à taille humaine et de travailler la terre avec des méthodes traditionnelles."
    ],
    "it": [
      "La nostra cantina si trova sulle alture di Marcilly-le-Châtel, a 650 metri di altitudine, e offre una vista mozzafiato sul paesaggio circostante.\r\nAbbiamo scelto di rimanere a misura d'uomo e di lavorare la terra con metodi tradizionali."
    ],
    "fr": [
      "Notre caveau se niche dans les hauteurs de Marcilly-le-Châtel, à une altitude de 650 mètres, offrant une vue imprenable sur le paysage environnant.\r\nNous avons choisi de rester à taille humaine et de travailler la terre avec des méthodes traditionnelles."
    ],
    "nl": [
      "Ons wijnhuis ligt in de heuvels van Marcilly-le-Châtel, op 650 meter hoogte, en biedt een adembenemend uitzicht op het omringende landschap.\r\nWe hebben ervoor gekozen om op menselijke schaal te blijven en het land op traditionele wijze te bewerken."
    ],
    "es": [
      "Nuestra bodega se encuentra en las alturas de Marcilly-le-Châtel, a 650 metros de altitud, y ofrece una vista impresionante del paisaje circundante.\r\nHemos optado por mantenernos a escala humana y trabajar la tierra con métodos tradicionales."
    ]
  },
