  "rdfs:comment": {
    "de": [
      "Les Gourmandises de l'Ourson, bietet Ihnen seine zu 100 % handwerklich hergestellten Feinschmeckerkreationen an. Finden Sie ihre köstlichen Kekse, Sablés und andere Süßigkeiten auf den Handwerker- und Bauernmärkten des Skigebiets und Belledonne."
    ],
    "en": [
      "Les Gourmandises de l'Ourson, offers 100% handcrafted gourmet creations. You'll find their delicious cookies, shortbread and other sweet treats at artisan and producer markets in the resort and Belledonne."
    ],
    "it": [
      "Les Gourmandises de l'Ourson vi offre creazioni gastronomiche fatte al 100% in casa. Troverete i loro deliziosi biscotti, frollini e altri dolciumi nei mercati artigianali e dei produttori della località e di Belledonne."
    ],
    "fr": [
      "Les Gourmandises de l'Ourson, vous propose ses créations gourmandes 100% artisanales. Retrouvez leurs délicieux biscuits, sablés et autres douceurs sur les marchés d'artisans et de producteurs de la station et Belledonne."
    ],
    "es": [
      "Les Gourmandises de l'Ourson le ofrecen creaciones gastronómicas 100% caseras. Encontrará sus deliciosas galletas, bizcochos y otros dulces en los mercados artesanales y de productores de la estación y de Belledonne."
    ],
    "nl": [
      "Les Gourmandises de l'Ourson biedt u 100% zelfgemaakte gastronomische creaties. Je vindt hun heerlijke koekjes, zandkoekjes en andere zoete lekkernijen op ambachtelijke en producentenmarkten in het resort en Belledonne."
    ]
  },
  "rdfs:label": {
    "de": [
