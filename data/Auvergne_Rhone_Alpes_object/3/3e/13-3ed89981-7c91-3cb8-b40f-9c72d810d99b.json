  "rdfs:comment": {
    "de": [
      "Estelle Deshayes ist Naturheilpraktikerin, Sophrologin & Wellness-Massagepraktikerin und begleitet Sie mit maßgeschneiderten Behandlungen und einer traditionellen Sauna, um Stress und Verspannungen zu lösen, auf dem Weg zu einem ausgeglichenen Körper-Geist-Verhältnis."
    ],
    "en": [
      "Naturopath, sophrologist & wellness massage practitioner, Estelle Deshayes guides you towards body-mind balance, with tailor-made treatments and a traditional sauna to release stress and tension."
    ],
    "it": [
      "La naturopata, terapista del relax e massaggiatrice del benessere Estelle Deshayes vi aiuterà a raggiungere l'equilibrio tra corpo e mente, con trattamenti su misura e una sauna tradizionale per alleviare stress e tensioni."
    ],
    "fr": [
      "Naturopathe, sophrologue & praticienne en massages bien-être, Estelle Deshayes vous accompagne vers l’équilibre corps-esprit, avec des soins sur mesure et un sauna traditionnel pour libérer stress et tensions."
    ],
    "nl": [
      "Natuurgeneeskundige, ontspanningstherapeut en wellnessmasseur Estelle Deshayes helpt je een balans te vinden tussen lichaam en geest, met behandelingen op maat en een traditionele sauna om stress en spanning te verlichten."
    ],
    "es": [
      "La naturópata, terapeuta de relajación y masajista de bienestar Estelle Deshayes le ayudará a lograr un equilibrio entre cuerpo y mente, con tratamientos a medida y una sauna tradicional para aliviar el estrés y la tensión."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bien-être & Spa"
    ]
  },
