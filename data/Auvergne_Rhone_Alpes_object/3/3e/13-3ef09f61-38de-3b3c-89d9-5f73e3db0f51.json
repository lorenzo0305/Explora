  "rdfs:comment": {
    "de": [
      "Das Team Evolution 2 ist da, um Sie bei der Wahl Ihres Elektro-Mountainbikes zu beraten und Ihnen die passenden Strecken im Skigebiet und darüber hinaus im gesamten Elektro-Mountainbike-Gebiet von La Plagne zu zeigen."
    ],
    "en": [
      "The Team Evolution 2 is there to guide you in the choice of your electric mountain bike and to give you the adapted itineraries on the station and to see further on the whole domain of Electric bike of the Plagne."
    ],
    "it": [
      "Il Team Evolution 2 è qui per guidarvi nella scelta della vostra mountain bike elettrica e per fornirvi i percorsi adatti al resort e all'intera area di mountain bike elettrica di La Plagne"
    ],
    "fr": [
      "La Team Evolution 2 est là pour vous guider dans le choix de votre VTT électrique et vous donner les parcours adaptés sur la station et voir plus loin sur l'ensemble du domaine VTT Electrique de la Plagne"
    ],
    "nl": [
      "Team Evolution 2 is er om u te begeleiden bij uw keuze voor een elektrische mountainbike en om u de meest geschikte routes te geven in het resort en daarbuiten in het hele gebied van La Plagne voor elektrische mountainbikes."
    ],
    "es": [
      "El equipo Evolution 2 está aquí para guiarte en la elección de tu bicicleta eléctrica de montaña y para darte las rutas adaptadas en la estación y más allá en todo el dominio de la bicicleta eléctrica de montaña de La Plagne"
    ]
  },
  "rdfs:label": {
    "de": [
      "Mieten Sie Ihr Elektro-Mountainbike mit Evolution 2"
    ],
    "en": [
      "Rent your E-VTT"
    ],
    "fr": [
      "Louez votre VTT Electrique avec Evolution 2"
    ],
    "nl": [
      "Huur uw elektrische mountainbike bij Evolution 2"
    ]
  },
