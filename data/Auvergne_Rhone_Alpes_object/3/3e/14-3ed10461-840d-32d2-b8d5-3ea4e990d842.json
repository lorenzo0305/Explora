      "dc:description": {
        "de": [
          "Freitag, 8. März 2024\n\n20:00 Uhr - Ravel-Saal Kongresspalast.\nAus Gründen, die sich unserer Kontrolle entziehen, wird der Auftritt von Marianne James abgesagt."
        ],
        "en": [
          "Friday, March 8, 2024\n\n8pm - Salle Ravel Palais des Congrès.\nFor reasons beyond our control, the Marianne James show has been cancelled."
        ],
        "it": [
          "Venerdì 8 marzo 2024\n\nore 20.00 - Salle Ravel Palais des Congrès.\nPer motivi indipendenti dalla nostra volontà, lo spettacolo di Marianne James è stato annullato."
        ],
        "fr": [
          "Vendredi 8 mars 2024\n\n20h - Salle Ravel Palais des Congrès.\nPour des raisons indépendantes de notre volonté, le spectacle de Marianne James est annulé."
        ],
        "nl": [
          "Vrijdag 8 maart 2024\n\n20.00 uur - Salle Ravel Palais des Congrès.\nOm redenen die buiten onze macht liggen, is het optreden van Marianne James geannuleerd."
        ],
        "es": [
          "Viernes 8 de marzo de 2024\n\n20.00 h - Sala Ravel del Palacio de Congresos.\nPor razones ajenas a nuestra voluntad, el espectáculo de Marianne James ha sido cancelado."
        ]
      },
