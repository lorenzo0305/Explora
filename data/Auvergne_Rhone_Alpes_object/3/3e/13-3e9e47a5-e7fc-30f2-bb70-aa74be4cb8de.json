  "rdfs:comment": {
    "de": [
      "Die Domaine Equestre du Rival befindet sich 1 Autostunde von Lyon und Grenoble entfernt, an der Bièvre-Achse und 5 Minuten von La Côte Saint-André entfernt. Die Domaine équestre ermöglicht Sport- und Freizeitreiten, Pferdezucht und Pferdepensionen."
    ],
    "en": [
      "The Domaine Equestre du Rival is 1 hour's drive from Lyon and Grenoble, on the Bièvre axis and 5 minutes from La Côte Saint-André. The Domaine Equestre offers sport and leisure riding, breeding and horse boarding."
    ],
    "it": [
      "Il Domaine Equestre du Rival si trova a 1 ora di auto da Lione e Grenoble, sull'asse della Bièvre e a 5 minuti da La Côte Saint-André. Il Domaine Equestre offre equitazione sportiva e da diporto, nonché allevamento e pensione per cavalli."
    ],
    "fr": [
      "Le Domaine Equestre du Rival se trouve à 1h de route de Lyon et Grenoble, sur l’axe de Bièvre et à 5 minutes de la Côte Saint-André. Le Domaine équestre permet la pratique de l'équitation sportive et de loisirs, l'élevage et les pensions équine."
    ],
    "nl": [
      "Het Domaine Equestre du Rival ligt op 1 uur rijden van Lyon en Grenoble, op de Bièvre-as en op 5 minuten van La Côte Saint-André. Het Domaine Equestre biedt zowel sport- en vrijetijdsritten als fokkerij en paardenpension."
    ],
    "es": [
      "El Domaine Equestre du Rival está a 1 hora en coche de Lyon y Grenoble, en el eje de Bièvre y a 5 minutos de La Côte Saint-André. El Domaine Equestre ofrece tanto equitación deportiva como de ocio, así como cría y pupilaje de caballos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine équestre du rival"
    ]
  },
