  "rdfs:comment": {
    "de": [
      "Eau de Colognes, Eau de Toilettes, Eau de Parfums, Raumdüfte zu Fabrikpreisen sowie weitere Geschenkideen und duftende souvenirs."
    ],
    "en": [
      "Eaux de Cologne, eaux de toilette, savons, articles cadeaux\r\nperfumes, fragrances at factory prices, soap,perfumed gifts and souvenirs"
    ],
    "it": [
      "Scoprirete collezioni di alambicchi, laboratori di design, linee di produzione e impianti di imbottigliamento. Una visita gratuita e piena di profumi su 6.000 m²."
    ],
    "fr": [
      "Vous allez y découvrir des collections d'alambics, des ateliers de création, des chaines de fabrication et d'embouteillage . Une visite libre et pleine de senteurs. sur 6000 m²."
    ],
    "nl": [
      "Eau de Cologne, eau de toilette, eau de parfum, sfeergeurtjes tegen abrieksprijzen, en andere cadeau ideeën en souvenirs met een heerlijk geurtje."
    ],
    "es": [
      "Descubrirá colecciones de alambiques, talleres de diseño, líneas de producción y plantas de embotellado. Un recorrido gratuito y lleno de aromas por 6.000 m²."
    ]
  },
