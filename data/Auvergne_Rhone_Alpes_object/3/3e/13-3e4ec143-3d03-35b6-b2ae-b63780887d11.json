  "rdfs:comment": {
    "de": [
      "Hören Sie auf, Burger zu essen, verschlingen Sie unsere französischen Hamburger! Kommen Sie und probieren Sie den Unterschied!\r\nKommen Sie und probieren Sie lokale, 100 % französische Gourmet-Burger!\r\nWir haben keinen Speck oder Cheddar, sondern Rohmilchfleisch und Käse!"
    ],
    "en": [
      "Stop eating burgers, devour our French hamburgers! Come and taste the difference!\r\nCome and taste local, 100% French gourmet burgers!\r\nWe don't have bacon or cheddar, but meats and unpastorised cheeses!"
    ],
    "it": [
      "Smettete di mangiare hamburger, divorate i nostri hamburger francesi! Venite a provare la differenza!\r\nVenite a provare un hamburger gourmet che è 100% francese!\r\nNon usiamo né bacon né cheddar, ma solo manzo e formaggio di latte crudo!"
    ],
    "fr": [
      "Arrêtez de bouffer des burgers, dévorez nos hamburgers français ! Venez goûter la différence !\r\nVenez goûter aux burger gourmet de terroir et 100% franchouillard !\r\nChez nous pas de bacon ni cheddar mais barbaques et frometons au lait cru !"
    ],
    "nl": [
      "Eet geen hamburgers meer, maar verorber onze Franse burgers! Kom en proef het verschil!\r\nKom en probeer een gourmetburger die 100% Frans is!\r\nWe gebruiken geen spek of cheddar, alleen rauwmelkse barbecues en kazen!"
    ],
    "es": [
      "Deje de comer hamburguesas, ¡devore nuestras hamburguesas francesas! ¡Venga a probar la diferencia!\r\n¡Ven a probar una hamburguesa gourmet 100% francesa!\r\nNo usamos bacon ni cheddar, ¡sólo carne de vacuno de leche cruda y queso!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Big Fernand"
    ]
  },
