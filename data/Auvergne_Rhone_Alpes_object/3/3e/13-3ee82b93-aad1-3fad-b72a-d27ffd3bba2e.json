  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Bibliothek von Saint Chef empfängt Sie dienstags, mittwochs und samstags. Mehr als 12.000 Bücher sind zugänglich und Sie finden eine große Auswahl an Sammlungen für Groß und Klein."
    ],
    "en": [
      "Saint-Chef Intermunicipal Library opens on Tuesdays, Wednesdays and Saturdays. Over 12,000 books are at your disposal including a wide range of collections."
    ],
    "it": [
      "La biblioteca intercomunale di Saint Chef è aperta il martedì, il mercoledì e il sabato. Sono disponibili oltre 12.000 libri, con un'ampia scelta di collezioni per grandi e piccini."
    ],
    "fr": [
      "La bibliothèque intercommunale de Saint Chef vous accueille le mardi, mercredi et samedi. Plus de 12 000 ouvrages sont accessibles et vous trouverez un large choix de collections, pour petits et grands."
    ],
    "es": [
      "La biblioteca intermunicipal Saint Chef abre los martes, miércoles y sábados. Dispone de más de 12.000 libros y ofrece una amplia selección de colecciones para grandes y pequeños."
    ],
    "nl": [
      "De intercommunale Saint Chef is geopend op dinsdag, woensdag en zaterdag. Er zijn meer dan 12.000 boeken beschikbaar en je vindt er een ruime keuze aan collecties voor jong en oud."
    ]
  },
