  "rdfs:comment": {
    "de": [
      "In einer entspannten Welt und Atmosphäre entdecken Sie eine frische, hausgemachte und einfallsreiche Bistroküche, die die Klassiker der Pariser Brasserie mit lokalen Aromen und anderen exotischeren kulinarischen Inspirationen mischt."
    ],
    "en": [
      "In a relaxed atmosphere, come and discover fresh, homemade and inventive bistronomic cuisine, mixing Parisian brasserie classics, local flavors and more exotic culinary inspirations."
    ],
    "it": [
      "In un'atmosfera rilassata, venite a scoprire una cucina bistronomica fresca, casalinga e inventiva che combina i classici della brasserie parigina con i sapori locali e le ispirazioni culinarie più esotiche."
    ],
    "fr": [
      "Dans un univers et une ambiance décontractés, venez découvrir une cuisine bistronomique fraîche, faite maison et inventive mixant les classiques de la brasserie parisienne, des saveurs locales et d'autres inspirations culinaires plus exotiques."
    ],
    "nl": [
      "Kom in een ontspannen sfeer kennismaken met de verse, huisgemaakte en inventieve bistronomische keuken die de klassiekers van de Parijse brasserie combineert met lokale smaken en meer exotische culinaire inspiraties."
    ],
    "es": [
      "En un ambiente relajado, venga a descubrir una cocina bistronómica fresca, casera e inventiva que combina los clásicos de la brasserie parisina con sabores locales e inspiraciones culinarias más exóticas."
    ]
  },
