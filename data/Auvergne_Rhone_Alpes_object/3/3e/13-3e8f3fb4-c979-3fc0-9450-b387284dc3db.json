  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich nach Ihrem Ausflug nach Lyon eine Auszeit im Boscolo SPA & Wellness. Lassen Sie sich von der warmen Atmosphäre und dem prächtigen Dekor dieser authentischen römischen Thermen tragen."
    ],
    "en": [
      "During your stay in Lyon treat yourself to some pampering at the Boscolo SPA & Wellness. Allow yourself to be transported by the warm atmosphere and luxurious decor of these authentic Roman baths."
    ],
    "it": [
      "Dopo il vostro soggiorno a Lione, concedetevi una pausa di relax al Boscolo SPA & Wellness. Lasciatevi trasportare dalla calda atmosfera e dall'arredamento sontuoso di queste autentiche terme romane."
    ],
    "fr": [
      "Après votre escapade Lyonnaise, accordez-vous une parenthèse de détente au SPA & Wellness Boscolo. Laissez-vous porter par l’ambiance chaleureuse et le décor somptueux de ces authentiques thermes romains."
    ],
    "nl": [
      "Verwen uzelf na uw verblijf in Lyon met een ontspannende pauze in de Boscolo SPA & Wellness. Laat u meeslepen door de warme sfeer en de weelderige inrichting van deze authentieke Romeinse baden."
    ],
    "es": [
      "Tras su estancia en Lyon, regálese un descanso en el Boscolo SPA & Wellness. Déjese llevar por el ambiente cálido y la suntuosa decoración de estos auténticos baños romanos."
    ]
  },
