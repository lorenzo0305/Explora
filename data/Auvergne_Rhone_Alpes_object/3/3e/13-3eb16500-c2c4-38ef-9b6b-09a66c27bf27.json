  "rdfs:comment": {
    "de": [
      "Dekoration und Einrichtung für Ihr Zuhause: Sofas, Sessel, Beistellmöbel, maßgefertigte Esstische, Stühle, Konfektionen, Vorhänge und Jalousien, maßgefertigte Kopfteile für Betten. Personalisierung, Innendekoration."
    ],
    "en": [
      "Decoration and furnishings for your home : sofas, armchairs, occasional furniture, custom dining tables, chairs, confections, curtains and blinds, custom headboards. Customization, interior design."
    ],
    "it": [
      "Decorazione e arredamento per la vostra casa: divani, poltrone, mobili occasionali, tavoli da pranzo su misura, sedie, confetti, tende e tendine, testiere su misura. Progettazione d'interni personalizzata."
    ],
    "fr": [
      "Décoration et aménagement pour votre intérieur :  canapés, fauteuils, mobilier d'appoint, table à dîner sur mesure, chaises, confections, rideaux et stores, têtes de lit sur mesure. Personnalisation, décoration d'intérieur."
    ],
    "nl": [
      "Decoratie en inrichting voor je huis: banken, fauteuils, bijzetmeubelen, eettafels op maat, stoelen, confectie, gordijnen en jaloezieën, hoofdborden op maat. Maatwerk en interieurontwerp."
    ],
    "es": [
      "Decoración y mobiliario para su hogar: sofás, sillones, muebles auxiliares, mesas de comedor a medida, sillas, confecciones, cortinas y estores, cabeceros a medida. Personalización y diseño de interiores."
    ]
  },
