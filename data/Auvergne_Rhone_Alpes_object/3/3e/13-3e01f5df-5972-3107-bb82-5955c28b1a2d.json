  "rdfs:comment": {
    "de": [
      "Herstellung - Verkauf von handwerklich hergestelltem Bauernkäse: Beaufort, der auf der Alm hergestellt wird, Tomme, Raclette, Joghurt und Weißkäse. Die Milch stammt von unserer eigenen Kuhherde."
    ],
    "en": [
      "Production and sale of artisan cheeses: Beaufort, Tomme, Raclette, yoghurts and soft cheese. The milk comes from our own herd of cows."
    ],
    "it": [
      "Fabbricazione - vendita di formaggi caserecci fatti in casa: Beaufort prodotto in alpeggi, tomme, raclette, yogurt e formaggi bianchi. Il latte proviene dalla nostra stessa mandria di mucche."
    ],
    "fr": [
      "Fabrication - vente de fromages fermiers artisanaux : Beaufort fabriqué en alpage, Tomme, Raclette, yaourts et fromages blancs. Le lait est issu de notre propre troupeau de vaches."
    ],
    "es": [
      "Producción y venta de quesos artesanales de granja: Beaufort elaborado en los pastos de montaña, Tomme, Raclette, yogures y quesos blancos. La leche procede de nuestro propio rebaño de vacas."
    ],
    "nl": [
      "Fabricage - verkoop van ambachtelijke boerenkazen: Beaufort gemaakt in de alpenweiden, Tomme, Raclette, yoghurt en witte kazen. De melk is afkomstig van onze eigen kudde koeien."
    ]
  },
