  "rdfs:comment": {
    "de": [
      "Ch?ur aus dem 12. Jahrhundert, Fußgängerzone. Das ganze Jahr über täglich von 8:00 bis 19:00 Uhr geöffnet. Möglichkeit einer geführten Besichtigung mit einem Fremdenführer des Pays d'art et d'histoire du Haut-Allier Tel. 04 71 77 28 30."
    ],
    "en": [
      "12th-century choir, pedestrian area. Open daily year-round, 8am-7pm. Guided tours with a guide from the Pays d'art et d'histoire du Haut-Allier Tel. 04 71 77 28 30."
    ],
    "it": [
      "Coro del XII secolo, area pedonale. Aperto tutti i giorni dell'anno dalle 8.00 alle 19.00. Sono disponibili visite guidate con una guida del Pays d'art et d'histoire du Haut-Allier Tel. 04 71 77 28 30."
    ],
    "fr": [
      "Chœur du XIIe siècle, piétà. Ouverte tous les jours toute l'année de 8h à 19h. Possibilité de visite guidée avec un guide conférencier du Pays d'art et d'histoire du Haut-Allier Tél. 04 71 77 28 30."
    ],
    "es": [
      "Coro del siglo XII, zona peatonal. Abierto todos los días del año de 8.00 a 19.00 h. Visitas guiadas disponibles con un guía del Pays d'art et d'histoire du Haut-Allier Tel. 04 71 77 28 30."
    ],
    "nl": [
      "12e-eeuws koor, voetgangersgebied. Het hele jaar dagelijks geopend van 8.00 tot 19.00 uur. Rondleidingen mogelijk met een gids van het Pays d'art et d'histoire du Haut-Allier Tel. 04 71 77 28 30."
    ]
  },
