  "rdfs:comment": {
    "de": [
      "Mountainbiking (und VTTAE!) ist im Pays du Mont-Blanc überall zu finden! Entdecken Sie es also mit Sylvain, einem staatlich geprüften Mountainbike-Lehrer und -Führer."
    ],
    "en": [
      "Mountain biking (and VTTAE!) is everywhere in the Pays du Mont-Blanc ! So come and discover it with Sylvain, mountain bike guide instructor, state graduate."
    ],
    "it": [
      "La mountain bike (e VTTAE!) è ovunque nella Pays du Mont-Blanc ! Allora vieni a scoprirlo con Sylvain, istruttore di guida di mountain bike, diplomato."
    ],
    "fr": [
      "Le VTT (et le VTTAE !) est partout au Pays du Mont-Blanc ! Alors venez le découvrir avec Sylvain, moniteur guide VTT, diplômé d'état."
    ],
    "es": [
      "¡La bicicleta de montaña (¡y el VTTAE!) está por todas partes en la región del Mont Blanc! Venga a descubrirla con Sylvain, monitor y guía de BTT diplomado por el Estado."
    ],
    "nl": [
      "Mountainbiken (en VTTAE!) is overal in de Mont Blanc! Kom het ontdekken met Sylvain, een door de staat gecertificeerde mountainbike-instructeur en gids."
    ]
  },
  "rdfs:label": {
