  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich auf dem Aussichtspunkt Cerdon und bietet einen herrlichen Blick auf das malerische Dorf Cerdon und seine Weinberge."
    ],
    "en": [
      "As its name suggests Le Panoramique towers over the picturesque village of Cerdon giving some breathtaking views of its vineyards."
    ],
    "it": [
      "Situato sul belvedere di Cerdon, il ristorante si affaccia sul pittoresco villaggio di Cerdon e sui suoi vigneti."
    ],
    "fr": [
      "Situé sur le belvédère du Cerdon, le restaurant surplombe magnifiquement le pittoresque village de Cerdon et son vignoble."
    ],
    "es": [
      "Situado en el mirador de Cerdon, el restaurante tiene vistas al pintoresco pueblo de Cerdon y a sus viñedos."
    ],
    "nl": [
      "Gelegen op de belvedère van Cerdon heeft het restaurant een prachtig uitzicht op het pittoreske dorpje Cerdon en de wijngaarden."
    ]
  },
