  "rdfs:comment": {
    "de": [
      "Der Pfarrgemeinderat von La Chapelle-en-Vercors ist eine Gruppe engagierter Freiwilliger, die das Leben der Pfarrgemeinde unterstützen. Er organisiert Messen, Treffen und solidarische Veranstaltungen und stärkt so die Verbindungen der Mitglieder sowie ihren Glauben."
    ],
    "en": [
      "The La Chapelle-en-Vercors Parish Council is a group of committed volunteers who support the life of the parish. It organizes masses, meetings and solidarity events, strengthening members' bonds and their faith."
    ],
    "it": [
      "Il Consiglio parrocchiale di La Chapelle-en-Vercors è un gruppo di volontari impegnati a sostenere la vita della parrocchia. Organizza messe, incontri ed eventi di solidarietà, rafforzando i legami tra i membri e la loro fede."
    ],
    "fr": [
      "Le Conseil paroissial de La Chapelle-en-Vercors est un groupe de bénévoles engagés qui soutiennent la vie de la paroisse. Il organise des messes, des rencontres et des événements solidaires, renforçant les liens des membres ainsi que leur foi."
    ],
    "es": [
      "El Consejo Parroquial de La Chapelle-en-Vercors es un grupo de voluntarios comprometidos que apoyan la vida de la parroquia. Organiza misas, reuniones y actos de solidaridad, reforzando los vínculos entre los miembros y su fe."
    ],
    "nl": [
      "De parochieraad van La Chapelle-en-Vercors is een groep toegewijde vrijwilligers die het leven van de parochie ondersteunen. Het organiseert missen, ontmoetingen en solidariteitsevenementen en versterkt zo de band tussen de leden en hun geloof."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conseil Paroissial"
    ]
  },
