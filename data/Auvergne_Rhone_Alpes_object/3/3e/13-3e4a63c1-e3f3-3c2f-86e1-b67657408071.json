  "rdfs:comment": {
    "de": [
      "Lumière de Gaïa ist das Atelier von Virginie Duhamel, Schmuckdesignerin für Lithotherapie in Faverges-Seythenex (Hochsavoyen). Sie entwirft Armbänder, Halsketten und Anhänger aus Natursteinen, um für Ausgeglichenheit und Wohlbefinden zu sorgen."
    ],
    "en": [
      "Lumière de Gaïa is the studio of Virginie Duhamel, lithotherapy jewelry designer based in Faverges-Seythenex (Haute-Savoie). She designs bracelets, necklaces and pendants in natural stones to bring balance and well-being."
    ],
    "it": [
      "Lumière de Gaïa è l'atelier di Virginie Duhamel, designer di gioielli di litoterapia con sede a Faverges-Seythenex (Alta Savoia). Progetta bracciali, collane e ciondoli realizzati con pietre naturali per portare equilibrio e benessere."
    ],
    "fr": [
      "Lumière de Gaïa est l’atelier de Virginie Duhamel, créatrice de bijoux en lithothérapie à Faverges-Seythenex (Haute-Savoie). Elle conçoit des bracelets, colliers et pendentifs en pierres naturelles, afin d’apporter équilibre et bien-être."
    ],
    "nl": [
      "Lumière de Gaïa is het atelier van Virginie Duhamel, een ontwerpster van lithosieraden gevestigd in Faverges-Seythenex (Haute-Savoie). Ze ontwerpt armbanden, kettingen en hangers gemaakt van natuurstenen om evenwicht en welzijn te brengen."
    ],
    "es": [
      "Lumière de Gaïa es el estudio de Virginie Duhamel, diseñadora de joyas de litoterapia afincada en Faverges-Seythenex (Alta Saboya). Diseña pulseras, collares y colgantes de piedras naturales que aportan equilibrio y bienestar."
    ]
  },
