  "rdfs:comment": {
    "de": [
      "Die Kletterhalle Ablok Annecy bietet frei zugängliches Bouldern, Kletterkurse für Erwachsene und Kinder (ab 8 Jahren). Sie verfügt außerdem über eine Bar mit kleinen Snacks."
    ],
    "en": [
      "The Ablok Annecy climbing gym offers free bouldering and climbing lessons for adults and children (8 years and over). It also has a snack bar."
    ],
    "it": [
      "La palestra di arrampicata Ablok Annecy offre lezioni gratuite di bouldering e arrampicata per adulti e bambini (a partire dagli 8 anni). Dispone anche di uno snack bar."
    ],
    "fr": [
      "La salle d'escalade Ablok Annecy propose de l'escalade de bloc en accès libre, des cours d'escalade pour adultes et enfants (à partir de 8 ans). Elle dispose également d'un bar petite restauration."
    ],
    "es": [
      "El rocódromo Ablok Annecy ofrece clases gratuitas de búlder y escalada para adultos y niños (a partir de 8 años). También cuenta con un bar."
    ],
    "nl": [
      "De klimzaal Ablok Annecy biedt gratis boulder- en klimlessen voor volwassenen en kinderen (vanaf 8 jaar). Er is ook een snackbar."
    ]
  },
