  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/770001c5-c784-35fd-b3f6-f46406a9915e",
      "dc:description": {
        "de": [
          "Das Maison des habitants des Communes du Frugeois organisiert Gesellschaftsspiele und Spiele für draußen\nTreffpunkt im Gemeindesaal am Dienstag, den 12. August von 14:30 bis 16:30 Uhr\nOffen für alle - Freier Eintritt"
        ],
        "en": [
          "La Maison des habitants des Communes du Frugeois organizes board games and outdoor games\nMeet at the Salle Communale on Tuesday August 12, from 2:30 to 4:30 p.m\nOpen to all - Free admission"
        ],
        "it": [
          "La Maison des habitants des Communes du Frugeois organizza giochi da tavolo e giochi all'aperto\nAppuntamento alla Salle Communale martedì 12 agosto dalle 14.30 alle 16.30\nAperto a tutti - Ingresso libero"
        ],
        "fr": [
          "La Maison des habitants des Communes du Frugeois organise des jeux de société et jeux d'extérieurs\nRendez-vous à la Salle Communale le mardi 12 août de 14h30 à 16h30\nOuvert à tous - Entrée libre"
        ],
        "es": [
          "La Maison des habitants des Communes du Frugeois organiza juegos de mesa y al aire libre\nCita en la Salle Communale el martes 12 de agosto de 14h30 a 16h30\nAbierto a todos - Entrada gratuita"
        ],
        "nl": [
          "Het Maison des habitants des Communes du Frugeois organiseert gezelschapsspelen en buitenspelen\nAfspraak in de Salle Communale op dinsdag 12 augustus van 14u30 tot 16u30\nOpen voor iedereen - Gratis toegang"
        ]
      },
