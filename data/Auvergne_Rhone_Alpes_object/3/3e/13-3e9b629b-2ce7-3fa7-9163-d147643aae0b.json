  "rdfs:comment": {
    "de": [
      "Romanische Kirche mit einem Chor aus dem 11. Jahrhundert. Bewundern Sie die bemerkenswerten, unter Denkmalschutz stehenden Kapitelle des Querschiffs, die biblische und rätselhafte Szenen illustrieren. Ein Juwel des romanischen Kulturerbes, das Sie das ganze Jahr über jeden Tag frei entdecken können."
    ],
    "en": [
      "Romanesque church with 11th-century choir. Admire the remarkable listed capitals in the transept, illustrating biblical and enigmatic scenes. A jewel of Romanesque heritage to be discovered freely every day, all year round."
    ],
    "it": [
      "Chiesa romanica con coro dell'XI secolo. Ammirate i notevoli capitelli listati del transetto, che illustrano scene bibliche ed enigmatiche. Questo gioiello del patrimonio romanico è aperto ai visitatori tutti i giorni, tutto l'anno."
    ],
    "fr": [
      "Église romane au chœur du XIe siècle. Admirez ses remarquables chapiteaux classés du transept illustrant des scènes bibliques et énigmatiques. Un joyau du patrimoine roman à découvrir librement tous les jours, toute l'année."
    ],
    "nl": [
      "Romaanse kerk met een 11e-eeuws koor. Bewonder de opmerkelijke geklasseerde kapitelen in het dwarsschip, die bijbelse en raadselachtige scènes illustreren. Dit juweel van Romaans erfgoed is het hele jaar door elke dag geopend voor bezoekers."
    ],
    "es": [
      "Iglesia románica con coro del siglo XI. Admire los notables capiteles catalogados del crucero, que ilustran escenas bíblicas y enigmáticas. Esta joya del patrimonio románico se puede visitar todos los días del año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Romane Saint Jean Baptiste"
    ]
  },
