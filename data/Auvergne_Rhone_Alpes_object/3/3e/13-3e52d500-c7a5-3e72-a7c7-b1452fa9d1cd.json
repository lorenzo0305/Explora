  "rdfs:comment": {
    "de": [
      "Der Pumptrack in Vaulnaveys-le-Haut wurde von der Grenobler Vereinigung \"Alpine Skate Culture\" mit Hilfe der Bürgerbeteiligung der Vaulnaviards gebaut. Er soll umfassend und vielseitig sein, um alle Arten von Niveaus zu befriedigen."
    ],
    "en": [
      "The pumptrack in Vaulnaveys-le-Haut was built by the Grenoble-based association Alpine Skate Culture, with the participation of the people of Vaulnaveys. It is designed to be complete and versatile, to suit all levels of skater."
    ],
    "it": [
      "La pista di Vaulnaveys-le-Haut è stata costruita dall'associazione Alpine Skate Culture di Grenoble, con l'aiuto dei residenti locali. È stata progettata per essere completa e versatile, per adattarsi a tutti i livelli di skater."
    ],
    "fr": [
      "Le pumptrack de Vaulnaveys-le-Haut a été réalisé par l’association grenobloise « Alpine Skate Culture », avec la participation citoyenne des Vaulnaviards. Il se veut complet et polyvalent, afin de satisfaire tous types de niveaux."
    ],
    "es": [
      "El pumptrack de Vaulnaveys-le-Haut fue construido por la asociación Alpine Skate Culture, con sede en Grenoble, con la ayuda de los residentes locales. Su diseño es completo y versátil, para adaptarse a todos los niveles de patinadores."
    ],
    "nl": [
      "De pumptrack in Vaulnaveys-le-Haut is gebouwd door de vereniging Alpine Skate Culture uit Grenoble, met de hulp van buurtbewoners. Het is ontworpen om compleet en veelzijdig te zijn, zodat het geschikt is voor skaters van alle niveaus."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pumptrack de Vaulnaveys-le-Haut"
    ]
  },
