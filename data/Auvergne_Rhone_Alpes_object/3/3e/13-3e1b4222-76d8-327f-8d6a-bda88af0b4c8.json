  "rdfs:comment": {
    "de": [
      "Die Semène ist ein etwa 40 km langer Fluss, der in der Nähe von Montregard im Département Haute-Loire entspringt. Auf ihrem Weg durch die Schluchten der Semène hat sie eine wilde und grüne Landschaft mit Wäldern, Klippen und einer reichen Artenvielfalt geformt."
    ],
    "en": [
      "The Semène is a 40 km-long river that rises near Montregard in the Haute-Loire region. As it flows through the Semène gorges, it has shaped a wild, verdant landscape of forests, cliffs and rich biodiversity."
    ],
    "it": [
      "La Semène è un fiume lungo 40 km che nasce vicino a Montregard, nell'Alta Loira. Scorrendo attraverso le gole della Semène, ha dato forma a un paesaggio selvaggio e verdeggiante, con foreste, scogliere e una ricca biodiversità."
    ],
    "fr": [
      "La Semène est une rivière d’environ 40 km qui prend sa source près de Montregard, en Haute-Loire. En traversant les gorges de la Semène, elle a façonné un paysage sauvage et verdoyant, avec des forêts, des falaises et une riche biodiversité."
    ],
    "es": [
      "El Semène es un río de 40 km de longitud que nace cerca de Montregard, en el Alto Loira. A su paso por las gargantas del Semène, ha modelado un paisaje salvaje y verde, con bosques, acantilados y una rica biodiversidad."
    ],
    "nl": [
      "De Semène is een 40 km lange rivier die ontspringt bij Montregard in de Haute-Loire. Terwijl ze door de kloven van de Semène stroomt, heeft ze een wild en groen landschap gevormd, met bossen, kliffen en een rijke biodiversiteit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gorges de la Semène"
    ]
  },
