  "rdfs:comment": {
    "de": [
      "Einfaches, gemütliches Café-Restaurant mit schönen, bequemen Sitzbänken. Raffinierte Verpflegung, die von Alpes-Controle für biologischen Landbau zertifiziert wurde. Offen für alle, ohne Unterschied."
    ],
    "en": [
      "Simple, pleasant café-restaurant with pretty, comfortable banquettes. Fine dining certified organic by Alpes-Controle. Open to all, without distinction."
    ],
    "it": [
      "Un caffè-ristorante semplice e piacevole, con panchine graziose e confortevoli. Cucina raffinata certificata biologica da Alpes-Controle. Aperto a tutti, senza distinzioni."
    ],
    "fr": [
      "Café-restaurant, simple et agréable avec de jolies banquettes confortables. Restauration raffinée certifiée en agriculture biologique par Alpes-Controle. Ouvert à toutes et tous, sans distinction."
    ],
    "es": [
      "Un café-restaurante sencillo y agradable con bonitos y cómodos bancos. Buena mesa con certificación ecológica de Alpes-Controle. Abierto a todos, sin distinción."
    ],
    "nl": [
      "Een eenvoudig, aangenaam café-restaurant met mooie, comfortabele banken. Lekker eten, biologisch gecertificeerd door Alpes-Controle. Open voor iedereen, zonder onderscheid."
    ]
  },
