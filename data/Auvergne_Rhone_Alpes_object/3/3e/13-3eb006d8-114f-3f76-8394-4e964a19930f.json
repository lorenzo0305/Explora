  "rdfs:comment": {
    "de": [
      "AQUA VIVA begleitet Sie bei der Erlangung Ihres Bootsführerscheins. Dank unserer 20-jährigen Erfahrung in diesem Bereich garantieren wir Ihnen eine qualitativ hochwertige Ausbildung, die auf Ihre Bedürfnisse zugeschnitten ist und den französischen Vorschriften entspricht."
    ],
    "en": [
      "AQUA VIVA can help you obtain your boating license. Thanks to our 20 years' experience in the field, we can guarantee you quality training tailored to your needs and in compliance with French regulations."
    ],
    "it": [
      "AQUA VIVA può aiutarvi a conseguire la patente nautica. Grazie ai nostri 20 anni di esperienza nel settore, possiamo garantirvi una formazione di qualità, adatta alle vostre esigenze e conforme alla normativa francese."
    ],
    "fr": [
      "AQUA VIVA vous accompagne dans l’obtention de votre permis bateau. Grâce à nos 20 années d’expérience dans le domaine, nous vous garantissons une formation de qualité adaptée à vos besoins et en conformité avec la réglementation française."
    ],
    "es": [
      "AQUA VIVA le ayuda a obtener su permiso de navegación. Gracias a nuestros 20 años de experiencia en el sector, podemos garantizarle una formación de calidad adaptada a sus necesidades y conforme a la normativa francesa."
    ],
    "nl": [
      "AQUA VIVA kan je helpen bij het behalen van je vaarbewijs. Dankzij onze 20 jaar ervaring op dit gebied kunnen we je een kwaliteitsopleiding garanderen die is afgestemd op jouw behoeften en die voldoet aan de Franse regelgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aqua viva - Bateau école"
    ]
  },
