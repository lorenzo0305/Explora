  "rdfs:comment": {
    "de": [
      "Am Tor zum Drôme-Tal bietet die Altstadt von Montoison ein weites Panorama (von den Voralpen bis zum Zentralmassiv). Entdecken Sie dieses mittelalterliche Dorf mit seinem Turm und den Überresten seiner Burg."
    ],
    "en": [
      "At the gateway to the Drôme Valley, the old town of Montoison offers a wide panorama (from the Pre-Alps to the Massif Central). Discover this medieval village with its tower and the remains of its castle."
    ],
    "it": [
      "Alle porte della Valle della Drôme, l'antica Montoison offre un ampio panorama (dalle Prealpi al Massiccio Centrale). Scoprite questo villaggio medievale con la sua torre e i resti del suo castello."
    ],
    "fr": [
      "Aux portes de la Vallée de la Drôme, le vieux Montoison offre un large panorama (Préalpes au Massif Central). Découvrez ce bourg médiéval avec sa tour et les vestiges de son château."
    ],
    "nl": [
      "Aan de poort van de Drômevallei biedt het oude stadje Montoison een weids panorama (van de Vooralpen tot het Centraal Massief). Ontdek dit middeleeuwse dorp met zijn toren en de overblijfselen van zijn kasteel."
    ],
    "es": [
      "A las puertas del valle de la Drôme, la antigua Montoison ofrece un amplio panorama (desde los Prealpes hasta el Macizo Central). Descubra este pueblo medieval con su torre y los restos de su castillo."
    ]
  },
