  "rdfs:comment": {
    "de": [
      "Spezialisiert auf Lederwaren für Männer: Umhängetasche, Kalendereinband, Gürteltasche, Etui für Brillen oder Boulekugeln, Kulturbeutel oder Hosenträger...\r\nEinige Modelle für Frauen: Taschen, Totes Bags.\r\nEinige Gurte für Musikinstrumente"
    ],
    "en": [
      "Specialized in leather goods for men: satchels, diary covers, fanny packs, cases for glasses or bocce balls, toiletry bags or shoulder straps...\r\nA few models for women: bags, totes bags.\r\nSome musical instrument straps"
    ],
    "it": [
      "Specializzato in articoli di pelletteria per uomo: cartelle, copridiari, marsupi, custodie per occhiali o palle da bocce, borse da toilette o tracolle...\r\nAlcuni modelli per donna: borse, borse a tracolla.\r\nAlcune tracolle per strumenti musicali"
    ],
    "fr": [
      "Spécialisé dans la maroquinerie pour homme : sacoche, couverture d'agenda, banane, étui pour lunettes ou boules de pétanque, trousse de toilette ou bretelles...\r\nQuelques modèles pour femmes : sacs, totes bag.\r\nQuelques sangles d'instruments de musique"
    ],
    "nl": [
      "Gespecialiseerd in lederwaren voor mannen: boekentassen, agenda-omslagen, heuptassen, etuis voor brillen of jeu de boules-ballen, toilettassen of schouderbanden...\r\nEnkele modellen voor vrouwen: tassen, totes tassen.\r\nEnkele riemen voor muziekinstrumenten"
    ],
    "es": [
      "Especializada en marroquinería para hombre: carteras, fundas para agendas, riñoneras, estuches para gafas o pelotas de petanca, neceseres o bandoleras...\r\nAlgunos modelos para mujer: bolsos, bolsos totes.\r\nAlgunas correas para instrumentos musicales"
    ]
  },
