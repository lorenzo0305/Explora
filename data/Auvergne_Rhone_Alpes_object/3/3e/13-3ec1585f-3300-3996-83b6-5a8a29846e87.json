  "rdfs:comment": {
    "de": [
      "Das Restaurant SOS bietet Ihnen eine große Auswahl an Pizzen und eine traditionelle und kreative Küche in einer familiären Atmosphäre. Entdecken Sie unsere saisonalen Gerichte, die von unserem Chefkoch mit frischen Produkten zubereitet werden."
    ],
    "en": [
      "The restaurant with its new and dynamic team will welcome you with traditional yet creative cooking. In cosy surroundings, come and enjoy our seasonal dishes that our chef prepared using fresh produce only."
    ],
    "it": [
      "Il ristorante SOS offre un'ampia scelta di pizze e cucina tradizionale e creativa in un'atmosfera familiare. Accogliente e caldo, venite a scoprire i nostri piatti stagionali preparati dal nostro chef con prodotti freschi."
    ],
    "fr": [
      "Le restaurant SOS vous propos un large choix de pizzas et une cuisine traditionnelle et créative dans une ambiance familiale . Feutré et cosy, venez découvrir nos plats de saison préparés par notre chef avec des produits frais."
    ],
    "nl": [
      "Het restaurant SOS biedt een ruime keuze aan pizza's en traditionele en creatieve gerechten in een familiale sfeer. Kom en ontdek onze seizoensgebonden gerechten bereid door onze chef met verse producten."
    ],
    "es": [
      "El restaurante SOS ofrece una amplia selección de pizzas y cocina tradicional y creativa en un ambiente familiar. Acogedor y cálido, venga a descubrir nuestros platos de temporada preparados por nuestro chef con productos frescos."
    ]
  },
