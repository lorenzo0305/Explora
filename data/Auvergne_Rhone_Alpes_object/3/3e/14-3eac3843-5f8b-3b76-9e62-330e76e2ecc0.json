  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dbd50400-694f-34c3-a383-414a613ac642",
      "dc:description": {
        "de": [
          "Verkauf von Blumenarrangements für Innenräume, Außenbereiche und Schnittblumen.\n\nÖffnungszeiten: Montag, Dienstag und Donnerstag von 10:00 bis 12:30 Uhr und von 14:30 bis 18:00 Uhr, Freitag und Samstag von 10:00 bis 12:30 Uhr und von 14:30 bis 19:00 Uhr"
        ],
        "en": [
          "Sales of indoor and outdoor floral arrangements and cut flowers.\n\nOpen: Monday, Tuesday and Thursday from 10:00 to 12:30 and from 14:30 to 18:00, Friday and Saturday from 10:00 to 12:30 and from 14:30 to 19:00"
        ],
        "it": [
          "Vendita di composizioni floreali per interni ed esterni e di fiori recisi.\n\nApertura: lunedì, martedì e giovedì dalle 10.00 alle 12.30 e dalle 14.30 alle 18.00, venerdì e sabato dalle 10.00 alle 12.30 e dalle 14.30 alle 19.00"
        ],
        "fr": [
          "Vente de compositions florales interieures, exterieurs, et fleurs coupées.\n\nOuvertures : Lundi, mardi t jeudi de 10h00 à 12h30 et de 14h30 à 18h00, vendredi et samedi de 10h00 à 12h30 et de 14h30 à 19h00"
        ],
        "nl": [
          "Verkoop van bloemstukken voor binnen en buiten en snijbloemen.\n\nOpen: maandag, dinsdag en donderdag van 10.00 tot 12.30 en van 14.30 tot 18.00, vrijdag en zaterdag van 10.00 tot 12.30 en van 14.30 tot 19.00"
        ],
        "es": [
          "Venta de arreglos florales de interior y exterior y flores cortadas.\n\nAbierto : lunes, martes y jueves de 10.00 a 12.30 y de 14.30 a 18.00, viernes y sábado de 10.00 a 12.30 y de 14.30 a 19.00"
        ]
      },
