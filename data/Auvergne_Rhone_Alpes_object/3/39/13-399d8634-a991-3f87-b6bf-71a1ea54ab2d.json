  "rdfs:comment": {
    "de": [
      "Saint-Julien-de-Toursac ist ein kleines, hügeliges Dorf im Südwesten der Châtaigneraie Cantalienne, das zwischen den Bächen Anès und Rimal liegt. Das Schloss von Naucaze ist sein Schatz."
    ],
    "en": [
      "Saint-Julien-de-Toursac is a little hilly village located in the southwest of the Châtaigneraie Cantalienne, between the Anès and Rimal creeks. Naucaze castle represents its treasure."
    ],
    "it": [
      "Saint-Julien-de-Toursac è un piccolo villaggio collinare nel sud-ovest della Châtaigneraie cantaliana, situato tra i torrenti Anès e Rimal. Lo Château de Naucaze è uno dei suoi tesori."
    ],
    "fr": [
      "Saint-Julien-de-Toursac est un petit village vallonné situé au sud-ouest de la Châtaigneraie cantalienne, situé entre les ruisseaux d’Anès et du Rimal. Le château de Naucaze en constitue son trésor."
    ],
    "nl": [
      "Saint-Julien-de-Toursac is een klein heuvelachtig dorp in het zuidwesten van de Châtaigneraie cantalienne, tussen de kreken Anès en Rimal. Het kasteel van Naucaze vertegenwoordigt zijn schat."
    ],
    "es": [
      "Saint-Julien-de-Toursac es un pequeño pueblo de colinas situado al suroeste de la Châtaigneraie cantalienne, entre los arroyos Anès y Rimal. El castillo de Naucaze es uno de sus tesoros."
    ]
  },
