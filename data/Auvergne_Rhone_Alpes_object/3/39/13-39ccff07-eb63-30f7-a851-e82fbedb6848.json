  "rdfs:comment": {
    "de": [
      "Cathy Marre, plastische Keramikerin, stellt in ihrem Atelier in Le Vieux Moulin in der Drôme des Collines Keramikobjekte her. Jedes Produkt ist einzigartig und von Hand geformt. Sie stellt ihre Skulpturen in Galerien in Paris, Antwerpen und bis nach Sao Paulo aus."
    ],
    "en": [
      "Cathy Marre, Céramiste Plasticienne, creates ceramic objects in her Atelier du Vieux Moulin in the Drôme des Collines region. Each product is unique and hand-crafted. She exhibits her sculptures in galleries in Paris and as far afield as Sao Paulo."
    ],
    "it": [
      "Cathy Marre, Céramiste Plasticienne, crea oggetti in ceramica nel suo studio a Le Vieux Moulin, nella regione della Drôme des Collines. Ogni prodotto è unico e realizzato a mano. Espone le sue sculture in gallerie di Parigi, Anversa e San Paolo."
    ],
    "fr": [
      "Cathy Marre, Céramiste Plasticienne, crée des objets en céramique dans son Atelier du Vieux Moulin dans la Drôme des Collines. Chaque produit est unique et façonné à la main. Elle expose ses sculptures en galerie à Paris, à Anvers et jusqu’à Sao Paulo."
    ],
    "nl": [
      "Cathy Marre, Céramiste Plasticienne, maakt keramische voorwerpen in haar atelier in Le Vieux Moulin in de Drôme des Collines. Elk product is uniek en met de hand gemaakt. Ze exposeert haar sculpturen in galeries in Parijs en zelfs in Sao Paulo."
    ],
    "es": [
      "Cathy Marre, Céramiste Plasticienne, crea objetos de cerámica en su taller de Le Vieux Moulin, en la región de Drôme des Collines. Cada producto es único y artesanal. Expone sus esculturas en galerías de París, Amberes y Sao Paulo."
    ]
  },
