  "rdfs:comment": {
    "de": [
      "Das Auditorium Laurent Gerra, das im Oktober 2011 vom Künstler eingeweiht wurde, verfügt über 440 Plätze und eine 180 m² große Bühne. Hier findet ein vielfältiges künstlerisches Programm mit Tanz, Aufführungen, Seminaren und Filmvorführungen statt."
    ],
    "en": [
      "The Auditorium Laurent Gerra, inaugurated by the artist in October 2011, with its 440 seats and 180 m² stage, hosts a varied artistic program of dance, shows, seminars and film screenings."
    ],
    "it": [
      "L'Auditorium Laurent Gerra, inaugurato dall'artista nell'ottobre 2011, dispone di 440 posti a sedere e di un palcoscenico di 180 m² e ospita un variegato programma artistico di danza, spettacoli, seminari e proiezioni di film."
    ],
    "fr": [
      "L'Auditorium Laurent Gerra, inauguré par l'artiste en octobre 2011, avec ses 440 places et un plateau de 180 m², accueille une programmation artistique variée, de danse, spectacles, séminaires et séances de cinéma."
    ],
    "nl": [
      "Het Auditorium Laurent Gerra, dat in oktober 2011 door de kunstenaar werd ingehuldigd, heeft 440 zitplaatsen en een podium van 180 m² en biedt onderdak aan een gevarieerd artistiek programma van dans, voorstellingen, seminars en filmvertoningen."
    ],
    "es": [
      "El Auditorio Laurent Gerra, inaugurado por el artista en octubre de 2011, cuenta con 440 plazas y un escenario de 180 m², y acoge una variada programación artística de danza, espectáculos, seminarios y proyecciones cinematográficas."
    ]
  },
