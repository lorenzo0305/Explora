  "rdfs:comment": {
    "de": [
      "Auf dem Plateau du Revard, in einem intimen und warmen Raum, begleitet Sie Aurélie, seit über 20 Jahren passionierte Wellness-Praktikerin, während einer Behandlung in den Bergen."
    ],
    "en": [
      "On the Revard plateau, in a warm and intimate space, Aurélie, a passionate well-being practitioner for over 20 years, accompanies you for a treatment in the mountains."
    ],
    "it": [
      "Sull'altopiano di Revard, in un ambiente caldo e intimo, Aurélie, appassionata di benessere da oltre 20 anni, vi accompagna per un trattamento in montagna."
    ],
    "fr": [
      "Sur le plateau du Revard, dans un espace intime et chaleureux, Aurélie, praticienne bien-être passionnée depuis plus de 20 ans, vous accompagne le temps d'un soin à la montagne."
    ],
    "nl": [
      "Op het plateau van Revard, in een warme en intieme omgeving, begeleidt Aurélie, al meer dan 20 jaar een gepassioneerde wellness-beoefenaar, je voor een behandeling in de bergen."
    ],
    "es": [
      "En la meseta del Revard, en un ambiente cálido e íntimo, Aurélie, apasionada del bienestar desde hace más de 20 años, le acompaña para un tratamiento en la montaña."
    ]
