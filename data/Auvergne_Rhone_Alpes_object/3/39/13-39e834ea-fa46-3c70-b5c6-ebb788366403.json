  "rdfs:comment": {
    "de": [
      "Freizeitpark mitten in der Natur: Akrobatikpark, Bogenschießen, Moutainbiking..."
    ],
    "en": [
      "Tree-top acrobatic park with challenges suitable for all levels. Also archery, orienteering, mountain bike hire, pony and horse riding (in partnership with Jas Sport), 100m rope bridge, challenges for children under 1m40. Minimum height: 1m30"
    ],
    "it": [
      "Avventura a Forez con Jas Acro! Indossate l'imbracatura per seguire i diversi percorsi di arrampicata sugli alberi. Scoprite 2 percorsi per bambini (elfi e folletti) e 3 percorsi per adulti (barone, sentiero, fiume)."
    ],
    "fr": [
      "Aventurez-vous en Forez avec Jas Acro ! Harnachez votre baudrier pour suivre les différents parcours d’accrobranche. Découvrez 2 parcours enfants (lutins et elfes) et 3 parcours adulte (baron, chemin, rivière)."
    ],
    "es": [
      "¡Aventúrate en Forez con Jas Acro! Ponte el arnés para seguir los diferentes recorridos de escalada de árboles. Descubre 2 recorridos para niños (elfos y duendes) y 3 para adultos (barón, sendero, río)."
    ],
    "nl": [
      "Activiteitenpark in de volle natuur: acrobatisch park in de hoogte, boogschieten, mountainbike…"
    ]
  },
