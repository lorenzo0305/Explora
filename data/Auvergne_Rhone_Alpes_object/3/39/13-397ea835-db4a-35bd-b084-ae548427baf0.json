  "rdfs:comment": {
    "de": [
      "In Tence öffnet Ihnen Maria die Türen der Kapelle, eine Einladung, ihre Geschichte und die der Weißen Büßer zu entdecken."
    ],
    "en": [
      "In Tence, Marie opens the doors of the chapel, inviting you to discover its history and that of the Pénitents Blancs."
    ],
    "it": [
      "A Tence, Marie apre le porte della cappella, invitandovi a scoprire la sua storia e quella dei Pénitents Blancs."
    ],
    "fr": [
      "A Tence, Marie vous ouvre les portes de la chapelle, invitation à découvrir son histoire et celle des Pénitents Blancs."
    ],
    "nl": [
      "In Tence opent Marie de deuren van de kapel en nodigt je uit om haar geschiedenis en die van de Pénitents Blancs te ontdekken."
    ],
    "es": [
      "En Tence, Marie le abre las puertas de la capilla y le invita a descubrir su historia y la de los Penitentes Blancos."
    ]
  },
