  "rdfs:comment": {
    "de": [
      "Die Gallinothek ist ein einzigartiger und ungewöhnlicher Ort, an dem eine Sammlung von Objekten ausgestellt wird, die Hähne darstellen. Die Dauerausstellung wird in jeder Saison durch eine Sonderausstellung ergänzt, die ein bestimmtes Thema aufgreift."
    ],
    "en": [
      "The Gallinothèque is a unique and unusual venue featuring a collection of objects depicting roosters. The permanent exhibition is complemented each season by a temporary exhibition on a particular theme."
    ],
    "it": [
      "La Gallinothèque è un luogo unico e insolito che presenta una collezione di oggetti con galli. L'esposizione permanente è integrata ogni stagione da una mostra temporanea su un tema particolare."
    ],
    "fr": [
      "La Gallinothèque est un lieu unique et insolite qui présente une collection d'objets figurant des coqs. L'exposition permanente est complétée à chaque saison par une exposition temporaire qui permet d'évoquer une thématique particulière."
    ],
    "es": [
      "La Gallinothèque es un lugar único e insólito que presenta una colección de objetos protagonizados por gallos. La exposición permanente se completa cada temporada con una exposición temporal sobre un tema concreto."
    ],
    "nl": [
      "De Gallinothèque is een unieke en ongewone plek die een verzameling voorwerpen met hanen presenteert. De permanente tentoonstelling wordt elk seizoen aangevuld met een tijdelijke tentoonstelling over een bepaald thema."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gallinothèque"
    ]
  },
