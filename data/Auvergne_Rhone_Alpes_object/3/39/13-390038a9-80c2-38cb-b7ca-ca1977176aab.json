  "rdfs:comment": {
    "de": [
      "Das in Champs-sur-Tarentaine-Marchal gelegene Le Saint Rémi bietet Ihnen eine authentische und großzügige Küche.\r\n\r\nDas Restaurant ist von Sonntag bis Freitag das ganze Jahr über mittags geöffnet, im August mittags und abends. Es bietet: ein Tagesmenü für 17 ?, das mittags serviert wird."
    ],
    "en": [
      "Located in Champs-sur-Tarentaine-Marchal, Le Saint Rémi offers authentic and generous cuisine. Open from Sunday to Friday, for lunch all year round, and for lunch and dinner in August, the restaurant offers: a daily menu at €17, served at lunchtime."
    ],
    "it": [
      "Situato a Champs-sur-Tarentaine-Marchal, Le Saint Rémi offre una cucina autentica e generosa.\r\n\r\nAperto dalla domenica al venerdì, a pranzo tutto l'anno e a pranzo e a cena in agosto, il ristorante propone: un menu giornaliero a 17?, servito a pranzo."
    ],
    "fr": [
      "Situé à Champs-sur-Tarentaine-Marchal, Le Saint Rémi vous propose une cuisine authentique et généreuse. \r\n\r\nOuvert du dimanche au vendredi, le midi toute l'année, et midi et soir en août, le restaurant offre : un menu du jour à 17 €, servi le midi."
    ],
    "es": [
      "Situado en Champs-sur-Tarentaine-Marchal, Le Saint Rémi ofrece una cocina auténtica y generosa.\r\n\r\nAbierto de domingo a viernes, para almorzar todo el año, y para comer y cenar en agosto, el restaurante propone: un menú diario a 17 €, servido a mediodía."
    ],
    "nl": [
      "Le Saint Rémi ligt in Champs-sur-Tarentaine-Marchal en biedt een authentieke en royale keuken.\r\n\r\nHet restaurant is het hele jaar geopend van zondag tot vrijdag, voor de lunch en in augustus voor lunch en diner, en biedt: een dagmenu van 17 €, geserveerd tijdens lunchtijd."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant \"Le Saint-Rémi\""
    ],
    "fr": [
      "Restaurant Le Saint Rémi"
    ]
  },
