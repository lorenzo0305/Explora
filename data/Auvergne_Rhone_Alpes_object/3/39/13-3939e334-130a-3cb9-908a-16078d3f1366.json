  "rdfs:comment": {
    "de": [
      "Das C2V empfängt Sie 5 Minuten vom Stadtzentrum entfernt auf dem Campingplatz Haut-Rhône auf seiner Terrasse am Ufer der Rhône mit Panoramablick, die von 14 Uhr bis 1 Uhr geöffnet ist.\r\nBar / Eisdiele und Restaurant für alle geöffnet.\r\nAuf der Speisekarte stehen französische, hausgemachte und lokale Produkte"
    ],
    "en": [
      "C2V welcomes you 5 minutes from the town center, at the Haut-Rhône campsite, to its terrace on the banks of the Rhône with panoramic views, open from 1pm to 1am.\r\nBar / ice cream parlour and restaurant open to all.\r\nMenu featuring French, homemade and local products."
    ],
    "it": [
      "C2V vi accoglie a 5 minuti dal centro città, presso il campeggio Haut-Rhône, nella sua terrazza sulle rive del Rodano con vista panoramica, aperta dalle 14.00 all'1.00.\r\nBar/gelateria e ristorante aperti a tutti.\r\nMenu con prodotti francesi, fatti in casa e locali"
    ],
    "fr": [
      "Le C2V vous accueille à 5 minutes du centre ville, au camping du Haut-Rhône sur sa terrasse au bord du Rhône avec vue panoramique ouverte de 14h à 1h.\r\nBar / glacier et Restaurant ouvert à tous.\r\nCarte proposant des produits français, faits maison et locaux"
    ],
    "nl": [
      "C2V verwelkomt je op 5 minuten van het stadscentrum, op de camping Haut-Rhône, op zijn terras aan de oevers van de Rhône met panoramisch uitzicht, geopend van 14.00 tot 01.00 uur.\r\nBar / ijssalon en restaurant open voor iedereen.\r\nMenu met Franse, huisgemaakte en lokale producten"
    ],
    "es": [
      "C2V le da la bienvenida a 5 minutos del centro de la ciudad, en el camping Haut-Rhône, a su terraza a orillas del Ródano con vistas panorámicas, abierta de 14:00 a 01:00.\r\nBar / heladería y restaurante abierto a todos.\r\nMenú a base de productos franceses, caseros y locales"
    ]
  },
  "rdfs:label": {
