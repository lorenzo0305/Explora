  "rdfs:comment": {
    "de": [
      "In der gedämpften Atmosphäre des Speisesaals mit Blick auf die Abfahrtspiste der Olympischen Spiele, ein bistronomisches Restaurant in Meribel, das sich auf Feinschmecker reimt!"
    ],
    "en": [
      "In the understated atmosphere of the dining room, a restaurant in Méribel for gourmets!"
    ],
    "it": [
      "Nell'atmosfera accogliente della sala da pranzo con vista sulla pista di discesa olimpica, un ristorante bistronomico a Meribel all'insegna della buona cucina!"
    ],
    "fr": [
      "Dans l’ambiance feutrée de la salle à manger ayant vue sur la piste de descente des Jeux olympiques, un restaurant bistronomique à Meribel rimant avec gourmand !"
    ],
    "nl": [
      "In de gezellige sfeer van de eetzaal rijmt een restaurant in Meribel op gastronomie!"
    ],
    "es": [
      "En el acogedor ambiente del comedor con vistas al descenso olímpico, ¡un restaurante bistronómico en Meribel que apuesta por la buena mesa!"
    ]
  },
