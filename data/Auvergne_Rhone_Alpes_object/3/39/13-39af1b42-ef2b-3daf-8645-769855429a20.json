  "rdfs:comment": {
    "de": [
      "Erleben Sie alpines Wohlbefinden im Spa Deep Nature Les Aiglons,"
    ],
    "en": [
      "Experience alpine well-being at Spa Deep Nature Les Aiglons,"
    ],
    "it": [
      "Venite a sperimentare il benessere alpino alla Spa Deep Nature Les Aiglons,"
    ],
    "fr": [
      "Le bien-être alpin, le vrai. C'est ce qui vous attend au Spa Les Aiglons à Chamonix. L'Hôtel Les Aiglons est un lieu emblématique de la ville de Chamonix, mêlant subtilement architecture traditionnelle de montagne et design sophistiqué."
    ],
    "es": [
      "Experimente el bienestar alpino en el Spa Deep Nature Les Aiglons,"
    ],
    "nl": [
      "Alpien welzijn, het echte werk. Dat is wat je te wachten staat in de Spa Les Aiglons in Chamonix. Hôtel Les Aiglons is een bezienswaardigheid in de stad Chamonix, waar op subtiele wijze traditionele bergarchitectuur wordt gecombineerd met verfijnd design."
    ]
  },
