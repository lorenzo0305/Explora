  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d992d9de-d5f6-3c90-bea2-a3a68ff4c7f2",
      "dc:description": {
        "de": [
          "Das Hotel liegt im Zentrum des Dorfes, 700 m vom Meer und 2 Schritte vom Cap Blanc Nez entfernt.\nIm Herzen des Dorfes Escalles, am Fuße des Cap Blanc Nez, ist L'Escale seit seiner Entstehung im Jahr 1958 ein Treffpunkt für Naturliebhaber."
        ],
        "en": [
          "Located in the village center, 700m from the sea and 2 steps from Cap Blanc Nez.\nIn the heart of the village of Escalles, at the foot of Cap Blanc Nez, l'Escale has been a meeting place for nature lovers since it opened in 1958."
        ],
        "it": [
          "Situato nel centro del paese, a 700 m dal mare e a 2 passi dal Cap Blanc Nez.\nNel cuore del villaggio di Escalles, ai piedi del Cap Blanc Nez, l'Escale è un luogo d'incontro per gli amanti della natura sin dalla sua apertura nel 1958."
        ],
        "fr": [
          "Situé au centre village à 700m de la mer et à 2 pas de Cap Blanc Nez.\nAu cœur du village d'Escalles, au pied du Cap Blanc Nez, l'Escale est depuis son origine en 1958 le rendez-vous des amoureux de la nature."
        ],
        "es": [
          "Situado en el centro del pueblo, a 700 m del mar y a 2 pasos del Cap Blanc Nez.\nEn el corazón del pueblo de Escalles, a los pies del Cap Blanc Nez, l'Escale es un punto de encuentro para los amantes de la naturaleza desde su apertura en 1958."
        ],
        "nl": [
          "Gelegen in het dorpscentrum, op 700 meter van de zee en op 2 stappen van Cap Blanc Nez.\nIn het hart van het dorp Escalles, aan de voet van Cap Blanc Nez, is l'Escale sinds de opening in 1958 een ontmoetingsplaats voor natuurliefhebbers."
        ]
      },
      "@type": [
