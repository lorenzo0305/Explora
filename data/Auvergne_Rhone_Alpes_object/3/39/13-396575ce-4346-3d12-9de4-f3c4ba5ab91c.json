  "rdfs:comment": {
    "de": [
      "Das Büffet-Restaurant mit Grill «Le Chaudron» hat sich hübsch gemacht. Patrick und Anaïs bieten Ihnen einen Streifzug durch die großen Klassiker der traditionellen französischen Küche, die von unseren Karten zu verschwinden drohen."
    ],
    "en": [
      "Always worried of preserving the flavours and the values of a traditional cooking, Patrick Roux provides you all year round a choice of delicious menus, a card keeping the wealth of the country, and the discovery of a storeroom with the best wines."
    ],
    "it": [
      "Il Buffet et Rôtisserie \"Le Chaudron\" ha un nuovo look. Patrick e Anaïs vi accompagnano in un viaggio attraverso i grandi classici della cucina tradizionale francese, che tendono a scomparire dai nostri menu."
    ],
    "fr": [
      "Buffet et Rôtisserie \"Le Chaudron\" a fait peau neuve. Patrick et Anaïs vous propose un parcours parmi les grands classiques de la cuisine traditionnelle française qui ont tendance à disparaître de nos cartes."
    ],
    "es": [
      "Buffet et Rôtisserie \"Le Chaudron\" tiene un nuevo aspecto. Patrick y Anaïs le llevan de viaje por los grandes clásicos de la cocina tradicional francesa, que tienden a desaparecer de nuestros menús."
    ],
    "nl": [
      "Buffet et Rôtisserie \"Le Chaudron\" heeft een nieuwe look. Patrick en Anaïs nemen je mee op een reis langs de grote klassiekers van de traditionele Franse keuken, die vaak van onze menukaarten verdwijnen."
    ]
  },
