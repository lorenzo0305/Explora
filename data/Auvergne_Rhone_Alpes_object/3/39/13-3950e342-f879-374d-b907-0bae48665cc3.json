  "rdfs:comment": {
    "de": [
      "Räume, die von der Stadt oder der Agglo verwaltet und instand gehalten werden, können für Sitzungen, Generalversammlungen, Treffen, Versammlungen, festliche Veranstaltungen usw. zur Verfügung gestellt werden."
    ],
    "en": [
      "Rooms managed and maintained by the Town or the Agglo can be made available for meetings, general assemblies, gatherings, festive events..."
    ],
    "it": [
      "I locali gestiti e mantenuti dal Comune o dall'Agglo possono essere messi a disposizione per riunioni, assemblee generali, incontri, eventi festivi, ecc."
    ],
    "fr": [
      "Des salles gérées et entretenues par la Ville ou l’Agglo peuvent être mises à disposition pour des réunions, des assemblées générales, des rencontres, des rassemblements, des manifestations festives..."
    ],
    "nl": [
      "Ruimtes die worden beheerd en onderhouden door de stad of de Agglo kunnen beschikbaar worden gesteld voor vergaderingen, algemene bijeenkomsten, bijeenkomsten, feestelijke evenementen, enz."
    ],
    "es": [
      "Las salas gestionadas y mantenidas por la ciudad o el Agglo pueden ponerse a disposición para reuniones, asambleas generales, encuentros, actos festivos, etc."
    ]
  },
  "rdfs:label": {
