  "rdfs:comment": {
    "de": [
      "Laser Game Evolution Chambéry (La Ravoire) heißt Sie herzlich willkommen für jede Art von Veranstaltung: Mit der Familie oder mit Freunden, Geburtstage von Erwachsenen und Kindern, Junggesellenabschiede, Betriebsausflüge... für jeden das Richtige!"
    ],
    "en": [
      "For ten years, Lasergame Evolution Chambéry-La Ravoire has been welcoming visitors in a warm and friendly atmosphere. For individual or team-players, come and check out our slogan with your own eyes: Lasergame Evolution is not funny, it's worse than that!"
    ],
    "it": [
      "Laser Game Evolution Chambéry (La Ravoire) vi accoglie calorosamente per tutti i tipi di eventi: In famiglia o con gli amici, compleanni per adulti e bambini, addii al celibato, uscite aziendali... a ciascuno il suo!"
    ],
    "fr": [
      "Laser Game Evolution Chambéry (La Ravoire) vous accueille chaleureusement pour tout type d'évènements : En famille ou entre amis, anniversaires adultes et enfants, enterrement de vie de célibataire, sortie d'entreprise... à chacun sa formule !"
    ],
    "nl": [
      "Lasergame Evolution Chambéry (La Ravoire) heet u van harte welkom voor alle soorten evenementen: Met familie of vrienden, verjaardagen voor volwassenen en kinderen, vrijgezellenfeesten, bedrijfsuitjes... ieder zijn meug!"
    ],
    "es": [
      "Laser Game Evolution Chambéry (La Ravoire) le da la bienvenida para todo tipo de eventos: En familia o con amigos, cumpleaños de adultos y niños, despedidas de soltero, salidas de empresa... ¡a cada cual lo suyo!"
    ]
  },
