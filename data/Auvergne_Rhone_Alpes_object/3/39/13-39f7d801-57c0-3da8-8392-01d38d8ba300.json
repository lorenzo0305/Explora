  "rdfs:comment": {
    "de": [
      "Der vor den alten Gebäuden der Nationalthermen gelegene Campanusbogen ist ein wichtiges Zeugnis der reichen römischen Zeit in Aix-les-Bains. Er wurde von L. Pompeius Campanus errichtet, um die Verstorbenen seiner Familie zu ehren."
    ],
    "en": [
      "Located in front of the buildings of the old national thermal baths, the Arch of Campanus is an important testament to the rich Roman history of Aix-les-Bain. It was built by L. Pompeius Campanus to honour the departed members of his family."
    ],
    "it": [
      "L'Arc de Campanus sorge davanti agli antichi edifici delle Terme nazionali ed è un'importante testimonianza del fiorente periodo romano di Aix-les-Bains. Fu eretto da L. Pompeius Campanus per onorare i defunti della sua famiglia."
    ],
    "fr": [
      "Situé devant les bâtiments anciens des Thermes nationaux, l'Arc de Campanus est un témoignage important de la riche période romaine d'Aix-les-Bains. Construit par L. Pompeius Campanus pour honorer les défunts de sa famille."
    ],
    "es": [
      "Situado frente a los antiguos edificios de las Termas Nacionales, el Arco de Campanus es un importante testimonio de la rica época romana de Aix-les-Bains. Fue construido por L. Pompeius Campanus para honrar a los miembros fallecidos de su familia."
    ],
    "nl": [
      "De Boog van Campanus, gelegen tegenover de oude gebouwen van de Nationale Thermen, is een belangrijke getuigenis van de rijke Romeinse periode van Aix-les-Bains. Het werd gebouwd door L. Pompeius Campanus om de overleden leden van zijn familie te eren."
    ]
  },
