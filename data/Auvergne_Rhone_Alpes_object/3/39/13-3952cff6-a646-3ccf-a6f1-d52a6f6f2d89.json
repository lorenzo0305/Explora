  "rdfs:comment": {
    "de": [
      "Erreichen Sie die höchsten Gipfel, haben Sie Lust zu klettern oder einfach nur zu wandern, erleben Sie das mit einem Bergführer, einem Kletterprofi oder mit einem Begleiter. In den Fußstapfen der Größten machen Sie sich eine Freude."
    ],
    "en": [
      "Reach new heights, climb or simply hike with a mountain guide, a professional climber or a mountain leader. Follow in the footsteps of the greats, and enjoy yourself."
    ],
    "it": [
      "Raggiungere nuove vette, scalare o semplicemente camminare con una guida alpina, uno scalatore professionista o un leader di montagna. Seguite le orme dei grandi e divertitevi."
    ],
    "fr": [
      "Atteindre des sommets, envie de grimper ou simplement de randonnée, vivez l'expérience avec un guide de haute montagne, un professionnel de l'escalade ou avec un accompagnateur.. Dans les pas des plus grands faites vous plaisir."
    ],
    "nl": [
      "Bereik nieuwe hoogten, klim of wandel met een berggids, een professionele klimmer of een bergleider. Treed in de voetsporen van de groten en geniet."
    ],
    "es": [
      "Alcance nuevas alturas, escale o simplemente haga senderismo con un guía de montaña, un escalador profesional o un líder de montaña. Siga los pasos de los grandes y disfrute."
    ]
  },
