  "rdfs:comment": {
    "de": [
      "Der Komiker erforscht unseren Alltag noch tiefer und analysiert mit Humor und Präzision scheinbar banale Situationen, die sich jedoch als weitaus komplexer erweisen, als sie erscheinen."
    ],
    "en": [
      "The humorist explores our daily lives in even greater depth, analyzing seemingly banal situations with humor and precision, but revealing them to be far more complex than they appear."
    ],
    "it": [
      "Il comico si addentra ancora di più nella nostra vita quotidiana, analizzando con umorismo e precisione situazioni apparentemente banali, ma rivelando che sono molto più complesse di quanto sembrino."
    ],
    "fr": [
      "L'humoriste explore encore plus en profondeur notre quotidien, analysant avec humour et précision des situations apparemment banales, mais qui se révèlent bien plus complexes qu'elles n'y paraissent."
    ],
    "es": [
      "El cómico profundiza aún más en nuestra vida cotidiana, analizando con humor y precisión situaciones aparentemente banales, pero revelando que son mucho más complejas de lo que parecen."
    ],
    "nl": [
      "De komiek duikt nog dieper in ons dagelijks leven en analyseert schijnbaar banale situaties met humor en precisie, maar onthult dat ze veel complexer zijn dan ze lijken."
    ]
  },
  "rdfs:label": {
