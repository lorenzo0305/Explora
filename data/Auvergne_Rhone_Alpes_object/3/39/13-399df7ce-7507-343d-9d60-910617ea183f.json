  "rdfs:comment": {
    "de": [
      "Dieser Raum wird für private Feiern, Aufführungen, Schulfeste, Weihnachtsbäume, Versammlungen, aber auch im Rahmen verschiedener von Vereinen organisierter Veranstaltungen genutzt.\r\nParkplätze in der Nähe."
    ],
    "en": [
      "This hall is used for private parties, shows, school parties, Christmas trees, meetings and also for various events organized by associations.\r\nParking nearby."
    ],
    "it": [
      "Questa sala viene utilizzata per feste private, spettacoli, celebrazioni scolastiche, alberi di Natale, riunioni e vari eventi organizzati dalle associazioni.\r\nParcheggio nelle vicinanze."
    ],
    "fr": [
      "Cette salle est utilisée pour des fêtes privées, spectacles, fêtes des écoles, arbres de Noël, réunions mais aussi dans le cadre de manifestations diverses organisées par des associations.\r\nParking à proximité."
    ],
    "es": [
      "Esta sala se utiliza para fiestas privadas, espectáculos, celebraciones escolares, árboles de Navidad, reuniones y diversos actos organizados por asociaciones.\r\nAparcamiento cercano."
    ],
    "nl": [
      "Deze zaal wordt gebruikt voor privéfeesten, voorstellingen, schoolfeesten, kerstbomen, vergaderingen en verschillende evenementen georganiseerd door verenigingen.\r\nParkeerplaats in de buurt."
    ]
  },
