  "rdfs:comment": {
    "de": [
      "Spa Wellness und Schönheit.\r\nEntdecken Sie unseren neuen Wellnessbereich in Nyons, der zahlreiche hochwertige Behandlungen, Modellagen und Rituale aus aller Welt anbietet.\r\nAber auch: Nagelstudio, Haarentfernung, Gesichtspflege, Modellage."
    ],
    "en": [
      "Wellness and beauty spa.\r\nCome and discover our new wellness area in Nyons, offering a wide range of quality treatments, massages and rituals from around the world.\r\nWe also offer nail care, waxing, facials and sculpting."
    ],
    "it": [
      "Spa di benessere e bellezza.\r\nVenite a scoprire la nostra nuova area benessere a Nyons, che offre un'ampia gamma di trattamenti di qualità, modellamenti e rituali mondiali.\r\nMa anche: cura delle unghie, ceretta, trattamenti per il viso, modellazione."
    ],
    "fr": [
      "Spa bien-être et beauté.\r\nVenez découvrir notre nouvel espace bien-être à Nyons qui propose de nombreux soins de qualité, des modelages et rituels du monde.\r\nMais aussi : onglerie, épilation, soins visage, modelage."
    ],
    "nl": [
      "Wellness- en schoonheidscentrum.\r\nKom en ontdek ons nieuwe wellnesscentrum in Nyons, met een breed aanbod aan kwaliteitsbehandelingen, massages en rituelen uit de hele wereld.\r\nWe bieden ook nagelverzorging, harsen, gezichtsbehandelingen en modelage."
    ],
    "es": [
      "Spa de bienestar y belleza.\r\nVenga a descubrir nuestro nuevo espacio de bienestar en Nyons, que ofrece una amplia gama de tratamientos de calidad, modelado y rituales del mundo.\r\nPero también: cuidado de las uñas, depilación, tratamientos faciales, modelado."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spa Cinq Sens"
    ]
  },
