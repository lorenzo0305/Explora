  "rdfs:comment": {
    "de": [
      "Dreizehn Bibliotheken und Mediatheken des Pays Beaume-Drobie funktionieren in einem Netzwerk, das von den Gemeinden und dem Gemeindeverband des Pays Beaume-Drobie organisiert wird. Mehr als 60.000 Werke, Bücher, CDs, DVDs, Hörbücher oder digitale Bücher warten dort auf Sie."
    ],
    "en": [
      "Thirteen libraries and media libraries in the Pays Beaume-Drobie are part of a network organized by the communes and the community of communes of the Pays Beaume-Drobie. More than 60,000 books, CDs, DVDs, audio books or digital books are waiting for you."
    ],
    "it": [
      "Tredici biblioteche e mediateche nel Pays Beaume-Drobie operano come una rete organizzata dai comuni e dalla comunità dei comuni del Pays Beaume-Drobie. Sono disponibili oltre 60.000 libri, CD, DVD, audiolibri e libri digitali."
    ],
    "fr": [
      "Treize bibliothèques et médiathèques du Pays Beaume-Drobie fonctionnent en réseau organisé par les communes et la communauté de communes du Pays Beaume-Drobie. Plus de 60000 ouvrages, livres, CD, DVD, livres audio ou livres numériques, vous y attendent."
    ],
    "es": [
      "Trece bibliotecas y mediatecas del Pays Beaume-Drobie funcionan como una red organizada por los municipios y la comunidad de municipios del Pays Beaume-Drobie. Hay más de 60.000 libros, CDs, DVDs, audiolibros y libros digitales disponibles."
    ],
    "nl": [
      "Dertien bibliotheken en mediatheken zijn onderdeel van het netwerk van gemeentes in het Pays Beaume-Drobie. Meer dan 60.000 werken: boeken, cd's, dvd's, luisterboeken, e-boeken."
    ]
  },
