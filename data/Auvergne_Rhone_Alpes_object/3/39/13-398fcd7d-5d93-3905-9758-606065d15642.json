  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, keine Speisekarte.\r\nVorspeisenbuffet, 2 warme Gerichte nach Wahl, Käse, Dessert, 1/4 Rotwein.\r\nRestaurant nur mittags geöffnet."
    ],
    "en": [
      "Traditional cuisine, no à la carte menu.\r\nStarter buffet, choice of 2 hot dishes, cheese, dessert, 1/4 red wine.\r\nRestaurant open for lunch only."
    ],
    "it": [
      "Cucina tradizionale, senza menu à la carte.\r\nBuffet di antipasti, scelta di 2 piatti caldi, formaggio, dessert, 1/4 di bottiglia di vino rosso.\r\nRistorante aperto solo a pranzo."
    ],
    "fr": [
      "Cuisine traditionnelle, pas de carte.\r\nBuffet d'entrées, 2 plats chauds au choix, fromage, dessert, 1/4 de vin rouge.\r\nRestaurant ouvert uniquement les midis."
    ],
    "nl": [
      "Traditionele keuken, geen à la carte menu.\r\nVoorgerechtenbuffet, keuze uit 2 warme gerechten, kaas, dessert, 1/4 fles rode wijn.\r\nRestaurant alleen geopend voor lunch."
    ],
    "es": [
      "Cocina tradicional, sin menú a la carta.\r\nBuffet de entrantes, 2 platos calientes a elegir, queso, postre, 1/4 de botella de vino tinto.\r\nRestaurante abierto sólo al mediodía."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant L'Auberge de la Scierie"
    ]
  },
