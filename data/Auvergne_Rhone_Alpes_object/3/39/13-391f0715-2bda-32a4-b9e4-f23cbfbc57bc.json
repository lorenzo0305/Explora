  "rdfs:comment": {
    "de": [
      "Verkauf von Walnussöl und karamellisierten oder schokolierten Nusskernen aus unserem Familienbetrieb mit nachhaltigem Anbau. Goldmedaillengewinner 2020 und doppelter Silbermedaillengewinner beim Concours Général für Walnussöl im Jahr 2022."
    ],
    "en": [
      "Sale of walnut oil and caramelized or chocolate kernels from our family-run, sustainable farm. Gold medal winner in 2020 and double silver medal winner at the Concours Général for walnut oil in 2022."
    ],
    "it": [
      "Vendita di olio di noci e gherigli caramellati o di cioccolato provenienti dalla nostra azienda agricola integrata a conduzione familiare. Medaglia d'oro nel 2020 e doppia medaglia d'argento al Concours Général per l'olio di noci nel 2022."
    ],
    "fr": [
      "Vente d'huile de noix et de cerneaux caramélisés ou chocolatés issus de notre exploitation familiale en culture raisonnée. Médaillé d'or 2020 et double médaillé d'argent au concours général pour l'huile de noix en 2022."
    ],
    "nl": [
      "Verkoop van walnootolie en gekarameliseerde noten of chocoladepitten van onze geïntegreerde familieboerderij. Gouden medaillewinnaar in 2020 en dubbele zilveren medaillewinnaar in het Concours Général voor walnootolie in 2022."
    ],
    "es": [
      "Venta de aceite de nuez y granos caramelizados o de chocolate procedentes de nuestra explotación familiar integrada. Medalla de oro en 2020 y doble medalla de plata en el Concours Général de aceite de nuez en 2022."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sale of walnut oil and kernels at GAEC des Murailles"
    ],
    "fr": [
      "Vente d'huile de noix et de cerneaux au GAEC des Murailles"
    ]
  },
