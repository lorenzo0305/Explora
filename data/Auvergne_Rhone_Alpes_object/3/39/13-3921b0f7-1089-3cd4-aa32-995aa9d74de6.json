  "rdfs:comment": {
    "de": [
      "Im Herzen des Erholungsgebiets von Hurongues gelegen, ist der gleichnamige See der ideale Ort zum Spazierengehen und Angeln."
    ],
    "en": [
      "Located between Chazelles-sur-Lyon and Saint-Symphorien-sur-Coise, the leisure area covers 15 hectares and offers a number of facilities: 4-star campsite, winter/summer swimming pool, 6 tennis courts, equipped picnic areas and a lake for fishing."
    ],
    "it": [
      "Situato nel cuore dell'area ricreativa di Hurongues, l'omonimo lago è il luogo ideale per passeggiate e pesca."
    ],
    "fr": [
      "Situé au cœur de la zone de loisirs de Hurongues, le plan d’eau du même nom est le lieu idéal pour la promenade et la pêche."
    ],
    "es": [
      "Situado en el corazón de la zona de ocio de las Hurongues, el lago del mismo nombre es el lugar ideal para pasear y pescar."
    ],
    "nl": [
      "Het gelijknamige meer ligt in het hart van het recreatiegebied Hurongues en is de ideale plek om te wandelen en te vissen."
    ]
  },
  "rdfs:label": {
