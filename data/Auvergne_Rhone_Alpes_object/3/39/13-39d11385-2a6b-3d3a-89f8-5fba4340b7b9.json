  "rdfs:comment": {
    "de": [
      "Der Verein Arts, Letters and Techniques hat sich zum Ziel gesetzt, die bildende Kunst, Kunstverlage, kulturelle Veranstaltungen und alles, was mit Kunst, Literatur, Wissenschaft und Technik zu tun hat, zu fördern."
    ],
    "en": [
      "The Contemporary Art Centre CK is a non-contracted and non-subsidized exhibition space that has been open since 2014. It presents the collection of Christian Karoutzos, a visual artist, composed of artists of national and international renown."
    ],
    "it": [
      "L'associazione Arts, Lettres et Techniques si propone di promuovere le arti visive, l'editoria d'arte, gli eventi culturali e tutto ciò che ha a che fare con le arti, la letteratura, la scienza e la tecnologia."
    ],
    "fr": [
      "L'association Arts, Lettres et Techniques a pour but de promouvoir les arts plastiques, l'édition d'art, les manifestations culturelles et tout ce qui est en rapport avec les arts, les lettres, les sciences et les techniques."
    ],
    "es": [
      "La asociación Arts, Lettres et Techniques tiene como objetivo promover las artes visuales, la edición de arte, los eventos culturales y todo lo relacionado con las artes, la literatura, la ciencia y la tecnología."
    ],
    "nl": [
      "De vereniging Arts, Lettres et Techniques promoot beeldende kunst, kunstuitgeverijen, culturele evenementen en alles wat te maken heeft met kunst, literatuur, wetenschap en technologie."
    ]
  },
  "rdfs:label": {
    "en": [
