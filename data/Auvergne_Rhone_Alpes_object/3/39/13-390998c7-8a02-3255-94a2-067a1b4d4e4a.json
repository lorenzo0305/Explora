  "rdfs:comment": {
    "de": [
      "Weingut in Aurel, das BIO-Weine anbietet: Clairette de Die AOC, Crémant de Die AOC und Coteaux de Die AOC. Führungen durch das Weingut und Weinproben sind das ganze Jahr über nach Vereinbarung kostenlos möglich. Tag der offenen Tür am 14. Juli"
    ],
    "en": [
      "Wine estate located in Aurel and offering ORGANIC wines: Clairette de Die AOC, Crémant de Die AOC and Coteaux de Die AOC. Guided tour of the Estate and tasting possible all year round, free of charge, by appointment. Open day on July 14"
    ],
    "it": [
      "Azienda vinicola situata ad Aurel che offre vini biologici: Clairette de Die AOC, Crémant de Die AOC e Coteaux de Die AOC. La visita guidata alla tenuta e la degustazione dei vini sono possibili tutto l'anno, gratuitamente, su prenotazione. Giornata di apertura il 14 luglio"
    ],
    "fr": [
      "Domaine viticole situé à Aurel et proposant des vins BIO : Clairette de Die AOC, Crémant de Die AOC et Coteaux de Die AOC. Visite guidée du Domaine et dégustation possible toute l'année, gratuitement, sur rendez-vous. Journée portes ouvertes le 14 juillet"
    ],
    "nl": [
      "Rondleiding langs de kelder en de wijngaard, op aanvraag - Gratis wijnproeverij. Exclusieve wijnproductie en -bereiding."
    ],
    "es": [
      "Bodega situada en Aurel que ofrece vinos ecológicos: Clairette de Die AOC, Crémant de Die AOC y Coteaux de Die AOC. Posibilidad de visita guiada de la finca y degustación de vinos durante todo el año, gratuitas, previa cita. Jornada de puertas abiertas el 14 de julio"
    ]
  },
