  "rdfs:comment": {
    "de": [
      "Bagnols, ein sehr schönes Dorf aus goldenen Steinen, veranstaltet am 26. und 27. Juli 2025 von 10 bis 19 Uhr sein 27. Festival der Aquarellisten. (Kostenlose Parkplätze). Für die Öffentlichkeit kostenlos geöffnet."
    ],
    "en": [
      "On July 26 and 27, 2025, from 10am to 7pm, Bagnols, a beautiful village of golden stones, organizes its 27th watercolorists' festival. (Free parking). Open to the public free of charge."
    ],
    "it": [
      "Il 26 e 27 luglio 2025, dalle 10.00 alle 19.00, Bagnols, splendido villaggio di pietre dorate, ospita il 27° Festival dell'acquerello. (Parcheggio gratuito). Aperto al pubblico gratuitamente."
    ],
    "fr": [
      "Bagnols, très beau village en pierres dorées, organise les 26 et 27 juillet 2025 de 10h à 19h son 27ème festival des aquarellistes. (Parking gratuit). Ouvert gratuitement au public."
    ],
    "nl": [
      "Op 26 en 27 juli 2025, van 10.00 tot 19.00 uur, organiseert Bagnols, een prachtig dorp van gouden stenen, zijn 27e aquarelfestival. (Gratis parkeren). Gratis toegankelijk voor het publiek."
    ],
    "es": [
      "Los días 26 y 27 de julio de 2025, de 10.00 a 19.00 h, Bagnols, bello pueblo de piedras doradas, acoge su 27º Festival de la Acuarela. (Aparcamiento gratuito). Abierto al público gratuitamente."
    ]
  },
  "rdfs:label": {
