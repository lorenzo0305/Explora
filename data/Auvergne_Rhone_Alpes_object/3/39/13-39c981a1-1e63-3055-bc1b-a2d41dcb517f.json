  "rdfs:comment": {
    "de": [
      "Mitten im Zentrum von Valence, nur wenige Schritte vom Centre Hugo entfernt. Ich biete Ihnen eine sehr große Auswahl an französischen und ausländischen Weinen sowie Spirituosen für alle Gelegenheiten."
    ],
    "en": [
      "In the heart of Valence, a stone's throw from the Centre Hugo. I offer a wide range of French and foreign wines and spirits for all occasions."
    ],
    "it": [
      "Nel centro di Valence, a due passi dal Centre Hugo. Offro un'ampia gamma di vini e liquori francesi e stranieri per tutte le occasioni."
    ],
    "fr": [
      "En plein centre de Valence, à deux pas du Centre Hugo. Je vous propose une très large gamme de vins français, étrangers et d'alcools, pour toutes les circonstances."
    ],
    "nl": [
      "Midden in het centrum van Valence, op een steenworp afstand van het Centre Hugo. Ik bied een breed assortiment Franse en buitenlandse wijnen en sterke dranken voor alle gelegenheden."
    ],
    "es": [
      "En el centro de Valence, a un paso del Centro Hugo. Ofrezco una amplia gama de vinos y licores franceses y extranjeros para todas las ocasiones."
    ]
  },
