  "rdfs:comment": {
    "de": [
      "Hohe Tische, hohe Tische, hohe Tische für Gäste... und andere traditionelle Tische. LA TABLE mag es einfach, gesellig und authentisch. Ein Restaurant für alle Gelegenheiten."
    ],
    "en": [
      "Discover this charming, entirely renovated 2-star Hotel and Restaurant. The hotel has 27 bedrooms, with all mod cons."
    ],
    "it": [
      "Tavoli per gli ospiti, tavoli alti, tavoli alti per gli ospiti e altri tavoli tradizionali. LA TABLE ama le cose semplici, amichevoli e autentiche. Un ristorante per tutte le occasioni."
    ],
    "fr": [
      "Des tables d’hôtes, des tables hautes, de hautes tables d’hôtes… et d’autres tables traditionnelles. LA TABLE aime les choses simples, conviviales et authentiques. Un restaurant pour toutes les occasions."
    ],
    "nl": [
      "Ontdek de charme van het driesterrenhotel-restaurant dat onlangs volledig is gerenoveerd. Op dagen met mooi weer kunt u van uw maaltijd genieten op het schaduwrijke terras, met op de achtergrond het geluid van onze fontein, wat de charme heeft van vervlogen tijden."
    ],
    "es": [
      "Mesas de invitados, mesas altas, mesas altas de invitados... y otras mesas tradicionales. A LA TABLE le gustan las cosas sencillas, amables y auténticas. Un restaurante para todas las ocasiones."
    ]
  },
