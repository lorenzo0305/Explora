  "rdfs:comment": {
    "de": [
      "Entdecken Sie Combloux und die Panoramen des Mont-Blanc mit dem Mountainbike! Xavier, ein leidenschaftlicher Lehrer, bietet geführte Touren für jedes Niveau, Mountainbike-Kurse für Kinder und Coaching für Einzelpersonen oder Gruppen. Abenteuer und Spaß sind garantiert!"
    ],
    "en": [
      "Discover Combloux and the Mont-Blanc panoramas on a mountain bike! Xavier, a passionate instructor, offers guided tours for all levels, kids classes and individual or group coaching. Adventure and fun guaranteed!"
    ],
    "it": [
      "Scoprite Combloux e le viste panoramiche sul Monte Bianco in mountain bike! Xavier, istruttore appassionato, offre escursioni guidate per tutti i livelli, lezioni di mountain bike per bambini e coaching individuale o di gruppo. Avventura e divertimento garantiti!"
    ],
    "fr": [
      "Découvrez Combloux et les panoramas du Mont-Blanc en VTTAE ! Xavier, moniteur passionné, propose randonnées guidées tout niveau, cours VTT enfants et coaching pilotage individuel ou en groupe. Aventure et plaisir garantis !"
    ],
    "nl": [
      "Ontdek Combloux en het panoramische uitzicht op de Mont Blanc op een mountainbike! Xavier, een gepassioneerde instructeur, biedt begeleide tochten voor alle niveaus, mountainbikelessen voor kinderen en individuele of groepscoaching. Avontuur en plezier gegarandeerd!"
    ],
    "es": [
      "Descubra Combloux y los paisajes del Mont Blanc en bicicleta de montaña.\r\nXavier, instructor apasionado, propone recorridos guiados para todos los niveles (bicicleta, material y guía incluidos) y entrenamientos individuales o en grupo. ¡Aventura y diversión garantizadas!"
    ]
  },
