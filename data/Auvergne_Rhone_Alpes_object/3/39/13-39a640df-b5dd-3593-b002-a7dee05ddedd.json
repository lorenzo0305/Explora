  "rdfs:comment": {
    "de": [
      "Wir treffen uns um 19 Uhr in der Salle des Fêtes, um einen unvergesslichen Abend zu erleben! Singen Sie Ihre Lieblingslieder beim Karaoke und tanzen Sie bis zum Ende der Nacht!"
    ],
    "en": [
      "Join us at 7pm in the Salle des Fêtes for an unforgettable evening! Sing your favorite songs and dance the night away!"
    ],
    "it": [
      "Unitevi a noi alle 19:00 nella Salle des Fêtes per una serata indimenticabile! Cantate le vostre canzoni preferite al karaoke e ballate tutta la notte!"
    ],
    "fr": [
      "Rendez-vous à 19h la Salle des Fêtes pour une soirée inoubliable ! Chantez vos chansons préférées lors du karaoké et dansez jusqu’au bout de la nuit !"
    ],
    "es": [
      "Únase a nosotros a las 19:00 en la Sala de Fiestas para disfrutar de una velada inolvidable Canta tus canciones favoritas en el karaoke y baila toda la noche"
    ],
    "nl": [
      "Kom om 19.00 uur naar de Salle des Fêtes voor een onvergetelijke avond! Zing je favoriete nummers bij de karaoke en dans de hele nacht door!"
    ]
