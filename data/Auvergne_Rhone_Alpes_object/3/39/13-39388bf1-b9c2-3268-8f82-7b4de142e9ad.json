  "rdfs:comment": {
    "de": [
      "Die Agence Roche immobilier ist seit über 40 Jahren in der Gegend von Brivadois tätig. Transaktion, Verwaltung, Vermietung und Miteigentumsverwaltung, wir sind der Partner für alle Ihre Immobilienprojekte."
    ],
    "en": [
      "Agence Roche immobilier has been present in the Brivadois area for over 40 years. Transaction, Management, Rental and Property Management, we are the partner for all your real estate projects."
    ],
    "it": [
      "L'Agence Roche immobilier è presente sul territorio di Brivadois da oltre 40 anni. Transazione, gestione, locazione e comproprietà fiduciaria, siamo il partner per tutti i vostri progetti immobiliari."
    ],
    "fr": [
      "L'Agence Roche immobilier est présente sur le secteur du Brivadois depuis plus de 40 ans. Transaction, Gestion, Location et Syndic de Copropriété, nous sommes le partenaire de tous vos projets immobiliers."
    ],
    "nl": [
      "Agence Roche immobilier is al meer dan 40 jaar aanwezig in de regio Brivadois. Transactie, beheer, verhuur en mede-eigendom, wij zijn de partner voor al uw vastgoedprojecten."
    ],
    "es": [
      "Agence Roche immobilier está presente en la región de Brivadois desde hace más de 40 años. Transacción, Gestión, Alquiler y Copropiedad Fiduciaria, somos el socio para todos sus proyectos inmobiliarios."
    ]
