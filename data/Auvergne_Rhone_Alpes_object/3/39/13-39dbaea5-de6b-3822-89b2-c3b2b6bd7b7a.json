  "rdfs:comment": {
    "de": [
      "Das Château de Verchaüs ist ein gemeinsam genutzter Raum für künstlerisches Schaffen und Entwicklung, der dem Kunsthandwerk, der zeitgenössischen Kunst und der Live-Performance gewidmet ist."
    ],
    "en": [
      "The Château de Verchaüs is a shared space for artistic creation and development, dedicated to arts and crafts, contemporary creation and live performance."
    ],
    "it": [
      "Lo Château de Verchaüs è uno spazio condiviso per la creazione e lo sviluppo artistico, dedicato alle arti e ai mestieri, alla creazione contemporanea e alle performance dal vivo."
    ],
    "fr": [
      "Le Château de Verchaüs est un espace mutualisé de création et de développement artistiques dédié aux Métiers d’art, à la Création Contemporaine et au Spectacle Vivant."
    ],
    "nl": [
      "Het Château de Verchaüs is een gedeelde ruimte voor artistieke creatie en ontwikkeling, gewijd aan kunst en ambacht, hedendaagse creatie en live performance."
    ],
    "es": [
      "El Château de Verchaüs es un espacio compartido de creación y desarrollo artístico, dedicado a la artesanía, la creación contemporánea y el espectáculo en vivo."
