  "rdfs:comment": {
    "de": [
      "Gehen Sie in Vulcania, im Herzen der Vulkane der Auvergne, auf Entdeckungsreise und machen Sie Erfahrungen, die ebenso lehrreich wie unterhaltsam und spektakulär sind. Ein in Europa einzigartiger Park zum Thema Vulkane, Naturphänomene und die Erde im Weltraum!"
    ],
    "en": [
      "Want to discover the world of volcanoes and the natural phenomena of planet Earth? Go exploring in Vulcania in Auvergne, unique park in Europe on the theme of volcanoes and the Earth."
    ],
    "it": [
      "Esplorate Vulcania, nel cuore dei vulcani dell'Alvernia, e vivete esperienze tanto istruttive quanto divertenti e spettacolari. Un parco unico in Europa sul tema dei vulcani, dei fenomeni naturali e della Terra nello spazio!"
    ],
    "fr": [
      "Partez en exploration à Vulcania, au cœur des volcans d'Auvergne, et partagez des expériences aussi instructives qu'amusantes et spectaculaires. Parc unique en Europe sur le thème des volcans, des phénomènes naturels et de la Terre dans l'Espace !"
    ],
    "nl": [
      "Ontdek Vulcania, in het hart van de vulkanen van de Auvergne, en beleef even leerrijke als leuke en spectaculaire ervaringen. Een uniek park in Europa met vulkanen, natuurverschijnselen en de aarde in de ruimte als thema!"
    ],
    "es": [
      "Explore Vulcania, en el corazón de los volcanes de Auvernia, y disfrute de experiencias tan instructivas como divertidas y espectaculares. Un parque único en Europa dedicado a los volcanes, los fenómenos naturales y la Tierra en el espacio"
    ]
  },
  "rdfs:label": {
    "de": [
      "Erkundungspark Vulcania"
