  "rdfs:comment": {
    "de": [
      "Werkstatt für die Restaurierung von Kintsugi. Die althergebrachte japanische Kunst des Kintsugi: eine traditionelle und natürliche Reparatur, die Keramikscherben in ein aufgewertetes und einzigartiges Objekt verwandelt."
    ],
    "en": [
      "Kintsugi restoration workshop. The ancestral Japanese art of Kintsugi: a traditional, natural repair method that transforms broken ceramics into unique, restored objects."
    ],
    "it": [
      "Laboratorio di restauro Kintsugi. L'arte ancestrale giapponese del Kintsugi: un metodo di riparazione tradizionale e naturale che trasforma le ceramiche rotte in oggetti unici e restaurati."
    ],
    "fr": [
      "Atelier de restauration Kintsugi. L'art ancestral japonais du Kintsugi : une réparation traditionnelle et naturelle qui transforme les brisures de céramiques en objet revalorisé et unique."
    ],
    "es": [
      "Taller de restauración Kintsugi. El ancestral arte japonés del Kintsugi: un método de reparación tradicional y natural que transforma la cerámica rota en objetos únicos y restaurados."
    ],
    "nl": [
      "Kintsugi restauratie workshop. De voorouderlijke Japanse kunst van Kintsugi: een traditionele, natuurlijke reparatiemethode die gebroken keramiek verandert in unieke, gerestaureerde objecten."
    ]
  },
