  "rdfs:comment": {
    "de": [
      "Seine Konzerte, Festivals, Veranstaltungen und Ausstellungen, die von Tausenden von Besuchern geschätzt werden, machen das Fort l'Ecluse zu einem unumgänglichen Ort der Entdeckung und Freizeitgestaltung... weit über die Grenzen des Pays de Gex hinaus."
    ],
    "en": [
      "Concerts, festivals, events and exhibitions, enjoyed by thousands of visitors, make Fort l'Ecluse an unmissable place to discover and enjoy... Well beyond the borders of Pays de Gex."
    ],
    "it": [
      "Concerti, festival, eventi e mostre, apprezzati da migliaia di visitatori, fanno di Fort l'Ecluse un luogo di scoperta e di svago da non perdere.\r\nl'Ecluse un luogo di scoperta e di svago che va ben oltre i confini del Pays de Gex."
    ],
    "fr": [
      "Ses concerts, festivals, événements et expositions, plébiscités par des milliers de visiteurs, font du Fort\r\nl'Ecluse un lieu de découverte et de loisirs incontournable… Bien au-delà des frontières du Pays de Gex."
    ],
    "es": [
      "Conciertos, festivales, eventos y exposiciones, de los que disfrutan miles de visitantes, hacen de Fort l'Ecluse un lugar de descubrimiento y ocio que no hay que perderse.\r\nl'Ecluse un lugar de descubrimiento y ocio que va mucho más allá de las fronteras del Pays de Gex."
    ],
    "nl": [
      "Concerten, festivals, evenementen en tentoonstellingen, waar duizenden bezoekers van genieten, maken van Fort\r\nl'Ecluse een niet te missen plaats van ontdekking en ontspanning? Ver buiten de grenzen van het Pays de Gex."
    ]
  },
