  "rdfs:comment": {
    "de": [
      "Das Fort de Tamié liegt zwischen Albertville und Faverges, in der Nähe des Col de Tamié, auf 1000 m Höhe. Auf einer Fläche von 16 Hektar können Sie hier Naturerfahrungen sammeln!"
    ],
    "en": [
      "Situated between Albertville and Faverges, at 1000 meters above sea level, The Fort de Tamié on an area of ​​16 hectares will allow you to live experiences of full nature !"
    ],
    "it": [
      "Situato tra Albertville e Faverges, vicino al colle di Tamié, a 1000 metri di altitudine, il Forte di Tamié, che si estende su una superficie di 16 ettari, vi permetterà di vivere un'esperienza all'aria aperta!"
    ],
    "fr": [
      "Situé entre Albertville et Faverges, proche du col de Tamié, à 1000m d’altitude, le Fort de Tamié sur une superficie de 16 hectares vous permettra de vivre des expériences de pleine nature !"
    ],
    "es": [
      "Situado entre Albertville y Faverges, cerca del puerto de Tamié, a 1.000 metros de altitud, el Fuerte de Tamié, con una superficie de 16 hectáreas, le permitirá vivir una experiencia al aire libre"
    ],
    "nl": [
      "Het Fort van Tamié, gelegen tussen Albertville en Faverges, vlakbij de pas van Tamié, op een hoogte van 1000 meter, biedt u op een oppervlakte van 16 hectare de mogelijkheid om van de natuur te genieten!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Multi-activity base camp of the fort of Tamié"
    ],
    "fr": [
      "Camp de base multi-activités du fort de Tamié"
    ]
  },
