  "rdfs:comment": {
    "de": [
      "Ein prächtiges, geschichtsträchtiges Steinhaus in einer natürlichen Umgebung. Im Herzen dieses Gebäudes mit authentischem Charme und moderner Ausstattung haben Sie die Wahl zwischen zwei Zimmerkategorien für Ihren Aufenthalt."
    ],
    "en": [
      "A sumptuous stone house full of history in a natural setting. In the heart of this building with authentic charm combined with modernity, you will have the choice between two categories of rooms for your stay."
    ],
    "it": [
      "Una sontuosa casa in pietra ricca di storia in un ambiente naturale. Nel cuore di questo edificio dal fascino autentico unito alla modernità, potrete scegliere tra due categorie di camere per il vostro soggiorno."
    ],
    "fr": [
      "Une somptueuse maison de pierres chargée d’histoire dans un cadre nature. Au cœur de cette bâtisse au charme authentique allié à la modernité, vous aurez le choix entre deux catégories de chambres pour votre séjour."
    ],
    "es": [
      "Una suntuosa casa de piedra llena de historia en un entorno natural. En el corazón de este edificio de auténtico encanto combinado con la modernidad, podrá elegir entre dos categorías de habitaciones para su estancia."
    ],
    "nl": [
      "Een weelderig stenen huis vol geschiedenis in een natuurlijke omgeving. In het hart van dit gebouw met zijn authentieke charme gecombineerd met moderniteit, kunt u kiezen uit twee categorieën kamers voor uw verblijf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Clos des Cimes"
    ]
  },
