  "rdfs:comment": {
    "de": [
      "Emrod & Co, die aus Rom stammen, spielen seit fünf Jahren Hits von Michel Berger, France Gall oder Véronique Sanson mit Akkorden aus ihrer eigenen Produktion. Sie werden im Atelier Toros auftreten, um Ihre Ohren zu verwöhnen!"
    ],
    "en": [
      "For the past 5 years, Emrod & Co have been covering hits by Michel Berger, France Gall and Véronique Sanson, to chords they themselves have produced. They'll be at the Atelier Toros to delight your ears!"
    ],
    "it": [
      "Originari di Roma, Emrod & Co hanno coverizzato negli ultimi 5 anni successi di artisti del calibro di Michel Berger, France Gall e Véronique Sanson, su accordi da loro stessi prodotti. Saranno presenti all'Atelier Toros per deliziare le vostre orecchie!"
    ],
    "fr": [
      "D'origine romanaise, Emrod & Co reprend depuis maintenant 5 ans des tubes de Michel Berger, France Gall ou encore Véronique Sanson, sur des accords de leur production. Ils seront à l'atelier Toros pour le plus grand plaisir de vos oreilles!"
    ],
    "nl": [
      "Emrod & Co komen oorspronkelijk uit Roman en coveren al 5 jaar hits van onder andere Michel Berger, France Gall en Véronique Sanson op akkoorden die ze zelf hebben geproduceerd. Ze zijn in het Atelier Toros om je oren te verwennen!"
    ],
    "es": [
      "De origen romano, Emrod & Co versionan desde hace 5 años éxitos de Michel Berger, France Gall o Véronique Sanson, con acordes producidos por ellos mismos. Estarán en el Atelier Toros para deleitar sus oídos"
    ]
  },
