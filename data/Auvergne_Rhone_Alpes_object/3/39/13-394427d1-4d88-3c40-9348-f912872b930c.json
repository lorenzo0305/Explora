  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Dieser 17.000 m² große Park im englischen Stil aus dem 19. Jahrhundert wird wegen seiner verschiedenen Baumarten, darunter japanischer Ahorn, und seiner gewundenen Alleen geschätzt."
    ],
    "en": [
      "Free admission. This 19th-century English park, covering 17,000 m², is appreciated for its various species, including Japanese maples, and its winding paths."
    ],
    "it": [
      "Ingresso gratuito. Questo parco inglese del XIX secolo, che si estende su 17.000 m², è rinomato per la varietà di specie arboree, tra cui gli aceri giapponesi, e per i suoi sentieri tortuosi."
    ],
    "fr": [
      "Accès libre. Ce parc à l'anglaise du XIXe siècle, qui s'étend sur 17 000 m², est apprécié pour ses différentes essences dont les érables japonais et ses allées sinueuses."
    ],
    "nl": [
      "Gratis toegang. Dit 19e-eeuwse Engelse park van 17.000 m² staat bekend om zijn verscheidenheid aan boomsoorten, waaronder Japanse esdoorns, en zijn kronkelende paden."
    ],
    "es": [
      "Entrada gratuita. Este parque inglés del siglo XIX, de 17.000 m², es famoso por su variedad de especies arbóreas, entre ellas los arces japoneses, y sus sinuosos senderos."
    ]
  },
  "rdfs:label": {
