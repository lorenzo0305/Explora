  "rdfs:comment": {
    "de": [
      "Der Cross Can?Ain Club lädt Sie zu Les grenouilles sur un plateau ein, einem großen Hundesportwettbewerb, der im Kalender der Fédération Française des Sports et Loisirs Canins? eingetragen ist und auch als ?goldener Hund? zählt."
    ],
    "en": [
      "The Cross Can?Ain club invites you to Les grenouilles sur un plateau, a major canine sports competition on the calendar of the Fédération Française des Sports et Loisirs Canins? and also counting as the ?chien d?or? race."
    ],
    "it": [
      "Il club Cross Can'Ain vi aspetta a Les grenouilles sur un plateau, un'importante competizione sportiva canina nel calendario della Fédération Française des Sports et Loisirs Canins, che conta anche come gara di \"chien d'or\"."
    ],
    "fr": [
      "Le club Cross Can’Ain vous donne rendez-vous pour Les grenouilles sur un plateau, une grande compétition de sports canins inscrite au calendrier de la Fédération Française des Sports et Loisirs Canins — et comptant également comme course “chien d’or”."
    ],
    "es": [
      "El club Cross Can?Ain le espera en Les grenouilles sur un plateau, una de las principales competiciones deportivas caninas del calendario de la Fédération Française des Sports et Loisirs Canins ? y que también cuenta como la carrera ?chien d?or?"
    ],
    "nl": [
      "De Cross Can?Ain club kijkt ernaar uit om je te zien op Les grenouilles sur un plateau, een belangrijke hondensportwedstrijd op de kalender van de Fédération Française des Sports et Loisirs Canins ? en die ook meetelt als de ?chien d?or? race."
    ]
  },
