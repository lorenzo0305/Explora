  "rdfs:comment": {
    "de": [
      "Seit mehr als 30 Jahren bietet Le Relais de la Blâche im Herzen der Dauphiné traditionelle Gerichte an. David und sein Team heißen Sie herzlich willkommen und präsentieren Ihnen abwechslungsreiche Menüs."
    ],
    "en": [
      "Set in the heart of the Dauphiné, the Relais de la Blache has been offering a traditional French cuisine for over 30 years. Sophie, Loic and Remi welcome you with a varied menu and a large wine cellar."
    ],
    "it": [
      "Da oltre 30 anni, nel cuore del Delfinato, Le Relais de la Blâche offre una cucina tradizionale. David e il suo team sono lieti di accogliervi con i loro variegati menu."
    ],
    "fr": [
      "Depuis plus de 30 ans, au cœur du Dauphiné, Le Relais de la Blâche propose une restauration traditionnelle. David et son équipe vous accueillent et vous présentent des menus variés."
    ],
    "nl": [
      "In het hart van de Dauphiné biedt Le Relais de la Blâche al meer dan 30 jaar een traditionele keuken. David en zijn team verwelkomen je graag op hun gevarieerde menu's."
    ],
    "es": [
      "Desde hace más de 30 años, en el corazón del Dauphiné, Le Relais de la Blâche ofrece una cocina tradicional. David y su equipo le esperan para ofrecerle menús variados."
    ]
  },
