  "rdfs:comment": {
    "de": [
      "Am südlichen Ende der Appellation Bugey, in der Gemeinde Izieu, produziert Denis Martin-Barbaz fruchtige und strukturierte Weine, die seit 2010 als Agriculture Biologique zertifiziert sind."
    ],
    "en": [
      "At the southern end of the Bugey appellation, in the commune of Izieu, Denis Martin-Barbaz produces fruity, structured wines that have been certified organic since 2010."
    ],
    "it": [
      "All'estremità meridionale della denominazione Bugey, nel comune di Izieu, Denis Martin-Barbaz produce vini fruttati e strutturati, certificati biologici dal 2010."
    ],
    "fr": [
      "À l’extrémité sud de l’appellation Bugey, dans la commune d’Izieu, Denis Martin-Barbaz produit des vins fruités et structurés, certifiés Agriculture biologique depuis 2010."
    ],
    "es": [
      "En el extremo sur de la denominación Bugey, en la comuna de Izieu, Denis Martin-Barbaz produce vinos afrutados y estructurados que cuentan con la certificación ecológica desde 2010."
    ],
    "nl": [
      "Aan de zuidkant van de Bugey appellatie, in de gemeente Izieu, produceert Denis Martin-Barbaz fruitige, gestructureerde wijnen die sinds 2010 biologisch gecertificeerd zijn."
    ]
  },
