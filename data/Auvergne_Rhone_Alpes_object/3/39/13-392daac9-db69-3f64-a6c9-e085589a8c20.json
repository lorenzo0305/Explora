  "rdfs:comment": {
    "de": [
      "Das auf 1650 m Höhe gelegene Spa de la Traye bietet ein multisensorisches Erlebnis, das Entspannung, Hightech und Ästhetik miteinander verbindet. Entdecken Sie die Pflegekarte und die exklusiven Vivace Micro-Needling und das Hydrafacial System des Médi Spa."
    ],
    "en": [
      "The Spa of la Traye, nestled at an altitude of 1650 m, offers a multi-sensory experience combining relaxation, high technology and aesthetics. Discover the treatment menu and the exclusive Vivace Micro-Needling and Hydrafacial systems at Médi Spa."
    ],
    "it": [
      "La Spa de la Traye, situata a 1650 m di altitudine, offre un'esperienza multisensoriale che unisce relax, alta tecnologia e bellezza. Scoprite il menu dei trattamenti e gli esclusivi sistemi Vivace Micro-Needling e Hydrafacial della Médi Spa."
    ],
    "fr": [
      "Le Spa de la Traye, niché à 1650 m d’altitude, propose une expérience multisensorielle combinant relaxation, haute technologie et esthétique. Découvrez la carte des soins et les exclusivités Vivace Micro-Needling et le système Hydrafacial du Médi Spa."
    ],
    "es": [
      "El Spa de la Traye, situado a 1.650 m de altitud, ofrece una experiencia multisensorial que combina relajación, alta tecnología y belleza. Descubra la carta de tratamientos y los sistemas exclusivos Vivace Micro-Needling e Hydrafacial en Médi Spa."
    ],
    "nl": [
      "De spa Refuge de la Traye combineert ontspanning, een Savoyaardse sfeer en hoogwaardige technologie om je welzijn en je zintuigen te verbeteren. Met de toevoeging van Vivace Micro-Needling en het Hydrafacial systeem kun je genieten van een unieke medispa in combinatie met behandelingen."
    ]
  },
