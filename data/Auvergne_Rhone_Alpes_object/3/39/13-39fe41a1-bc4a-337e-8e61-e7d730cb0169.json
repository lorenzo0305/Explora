  "rdfs:comment": {
    "de": [
      "Les trois petits cochons: gekochte, getrocknete und konservierte Wurstwaren. 24-Stunden-Automaten in Lalizolle, Malifrais und Gannat (CB). Märkte: Mo. St-Gervais, Mi. Bellenaves, Do. Ébreuil, Fr. Commentry und Moulins, Sa. Gannat, St-Pourçain/Sle und St-Eloy."
    ],
    "en": [
      "The three little pigs transform their pigs into cooked and dried charcuterie and preserves."
    ],
    "it": [
      "Les trois petits cochons: salumi cotti, essiccati e conservati. Distributori automatici 24 ore su 24 a Lalizolle, Malifrais e Gannat (CB). Mercati: lun. St-Gervais, mer. Bellenaves, gio. Ébreuil, ven. Commentry e Moulins, sab. Gannat, St-Pourçain/Sle e St-Éloy."
    ],
    "fr": [
      "Les trois petits cochons : charcuteries cuites, sèches et conserves. Distributeurs 24h/24 à Lalizolle, Malifrais et Gannat (CB). Marchés : lun. St-Gervais, mer. Bellenaves, jeu. Ébreuil, ven. Commentry et Moulins, sam. Gannat, St-Pourçain/Sle et St-Éloy."
    ],
    "es": [
      "Les trois petits cochons: charcutería cocida, seca y en conserva. Máquinas expendedoras 24 horas en Lalizolle, Malifrais y Gannat (CB). Mercados: lun. St-Gervais, mié. Bellenaves, jue. Ébreuil, vie. Commentry y Moulins, sáb. Gannat, St-Pourçain/Sle y St-Éloy."
    ],
    "nl": [
      "De drie biggetjes maken zelf charcuteries, zowel  gekookt als gedroogd vlees en conserven. Online verkoop."
    ]
  },
