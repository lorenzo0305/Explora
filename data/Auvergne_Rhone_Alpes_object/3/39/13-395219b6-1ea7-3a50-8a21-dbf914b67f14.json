  "rdfs:comment": {
    "de": [
      "Nach mehreren Jahren der Renovierung öffnete das Maison du Mouton im Januar 2025 seine Türen!\r\nDas Ziel des Maison du Patrimoine ist es, über unser Kulturerbe zu informieren und einen neuen Blick auf unser Gebiet in der Region Pays de Romans zu ermöglichen."
    ],
    "en": [
      "After several years of renovations, the Maison du Mouton opened its doors in January 2025!\r\nThe goal of the Maison du Patrimoine is to provide information about our heritage and offer a new perspective on our region, the Pays de Romans."
    ],
    "it": [
      "Dopo diversi anni di ristrutturazione, la Maison du Mouton ha aperto le sue porte nel gennaio 2025!\r\nL'obiettivo della Maison du Patrimoine è fornire informazioni sul nostro patrimonio e offrire una nuova prospettiva sulla regione di Romans."
    ],
    "fr": [
      "Après plusieurs années de rénovation, la Maison du Mouton a ouvert ses portes en Janvier 2025 !\r\nL’objectif de la Maison du Patrimoine est d’informer sur notre patrimoine et de proposer un nouveau regard sur notre territoire du Pays de Romans."
    ],
    "es": [
      "Tras varios años de renovación, la Maison du Mouton abrió sus puertas en enero de 2025\r\nEl objetivo de la Maison du Patrimoine es proporcionar información sobre nuestro patrimonio y ofrecer una nueva perspectiva de la región de Romans."
    ],
    "nl": [
      "Na enkele jaren van renovatie opende het Maison du Mouton in januari 2025 zijn deuren!\r\nHet doel van het Maison du Patrimoine is om informatie te verstrekken over ons erfgoed en een nieuw perspectief te bieden op de regio Rome."
    ]
  },
