  "rdfs:comment": {
    "de": [
      "Marion und Maxime begrüßen Sie in ihrer Ferme Auberge und bieten Ihnen leckere Menüs mit den Produkten ihres Hofes an: Lämmer, Hühner, Enten, Gemüse, Pilze... Einzelpersonen, Reiter, Wanderer, Mountainbiker, Gruppen... sind herzlich willkommen."
    ],
    "en": [
      "Marion and Maxime welcome you in their farm inn and offer tasty menus based on their farm products: lamb, ducks, vegetables, mushrooms... Individuals, riders, hikers, mountain bikers, groups... are welcome."
    ],
    "it": [
      "Marion e Maxime vi accolgono nella loro locanda e propongono gustosi menu a base di prodotti della loro fattoria: agnelli, gallinacei, anatre, verdure, funghi... Singoli, cavalieri, escursionisti, mountain biker, gruppi... sono i benvenuti."
    ],
    "fr": [
      "Marion et Maxime vous accueillent dans leur ferme auberge et proposent des menus savoureux à base des produits de leur ferme: agneaux, gallinacées, canards, légumes, champignons... Individuels,cavaliers,randonneurs, VTTistes, groupes...sont les bienvenus."
    ],
    "es": [
      "Marion y Maxime le dan la bienvenida a su posada agrícola y le ofrecen sabrosos menús basados en los productos de su granja: corderos, gallináceas, patos, verduras, setas... Individuos, jinetes, excursionistas, ciclistas de montaña, grupos... son bienvenidos."
    ],
    "nl": [
      "Marion en Maxime heten u welkom in hun boerderijherberg en bieden smakelijke menu's op basis van de producten van hun boerderij: lammeren, hoenderachtigen, eenden, groenten, paddenstoelen... Individuen, ruiters, wandelaars, mountainbikers, groepen... zijn welkom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Pré de mon arbre"
    ]
  },
