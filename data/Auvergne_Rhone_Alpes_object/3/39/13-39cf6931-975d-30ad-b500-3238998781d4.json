  "rdfs:comment": {
    "de": [
      "Ehemaliges Priorat, das von der Abtei La Chaise-Dieu abhing, dessen romanischer Chor einen \"cul de four\" aufweist. Entdecken Sie im Inneren die schwarze Jungfrau (Notre-Dame de l'Assomption) und die Skulptur des Saint-Roch. Achten Sie außen auf die gemeißelten Steinmodillons."
    ],
    "en": [
      "Former priory dependent on the abbey of La Chaise-Dieu whose Romanesque choir is in \"cul de four\". Inside, discover the black virgin (Notre-Dame de l'Assomption) and the sculpture of Saint-Roch. Outside, observe the sculpted stone modillions."
    ],
    "it": [
      "Ex priorato appartenente all'abbazia di La Chaise-Dieu, con un coro romanico a forma di \"cul de four\". All'interno, scoprite la Vergine nera (Notre-Dame de l'Assomption) e la scultura di Saint-Roch. All'esterno, osservate i modiglioni in pietra scolpita."
    ],
    "fr": [
      "Ancien prieuré dépendant de l'abbaye de La Chaise-Dieu dont le chœur roman est en «cul de four». A l'intérieur, découvrez la vierge noire (Notre-Dame de l'Assomption) et la sculpture de Saint-Roch. A l'extérieur, observez les modillons de pierre sculptés."
    ],
    "nl": [
      "Voormalige priorij van de abdij van La Chaise-Dieu, met een romaans koor in de vorm van een \"cul de four\". Binnen ontdekt u de zwarte maagd (Notre-Dame de l'Assomption) en het beeld van Saint-Roch. Bekijk buiten de gebeeldhouwde stenen modillions."
    ],
    "es": [
      "Antiguo priorato perteneciente a la abadía de La Chaise-Dieu, con un coro románico en forma de \"cul de four\". En el interior, descubra la virgen negra (Notre-Dame de l'Assomption) y la escultura de Saint-Roch. En el exterior, observe los modillones de piedra esculpidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Notre-Dame de l'Assomption"
    ]
  },
