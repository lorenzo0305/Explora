  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98a15ac8-838d-3b1c-b1a4-cb3fc505dd77",
      "dc:description": {
        "de": [
          "Naturlauf in der Bucht der Canche \"La Passe Pierre\".\n\nLa Terrible - 20 km langer Naturtrail - 8:45 Uhr\nLa Douce - 10 km langer Naturtrail - 9 Uhr\nLa Tranquille - Entdeckungsmarsch von 9 km - Start um 9.15 Uhr am CNC d'Etaples.\nNEU! Mini Passe-Pierre: Kinderstrecke zwischen 500m und 1km. 11 Uhr Sainte-Cécile.\nAnkünfte Centre Nautique de la Baie de Canche (Base Nord)."
        ],
        "en": [
          "La Passe Pierre\" nature race in the Bay of Canche.\n\nLa Terrible - 20 km nature trail - 8:45 am\nLa Douce - 10 km nature trail - 9h\nLa Tranquille - 9 km discovery walk - Departure 9.15 am from the Etaples CNC.\nNEW! Mini Passe-Pierre: children's course between 500m and 1km. 11am Sainte-Cécile.\nFinish at Centre Nautique de la Baie de Canche (Base Nord)."
        ],
        "it": [
          "Gara naturalistica \"La Passe Pierre\" nella Baie de Canche.\n\nLa Terrible - percorso naturalistico di 20 km - ore 8.45\nLa Douce - percorso naturalistico di 10 km - ore 9.00\nLa Tranquille - passeggiata alla scoperta di 9 km - ore 9.15 partenza dal CNC di Etaples.\nNUOVO! Mini Passe-Pierre: percorso per bambini da 500 m a 1 km. ore 11 Sainte-Cécile.\nArrivo Centre Nautique de la Baie de Canche (Base Nord)."
        ],
        "fr": [
          "Course nature en Baie de Canche «La Passe Pierre».\n\nLa Terrible - Trail nature de 20 km - 8h45\nLa Douce - Trail nature de 10 km - 9h\nLa Tranquille - Marche découverte de 9 km - Départ 9h15 du CNC d'Etaples.\nNOUVEAUTE ! Mini Passe-Pierre : parcours enfant entre 500m et 1km. 11h Sainte-Cécile.\nArrivées Centre Nautique de la Baie de Canche (Base Nord)."
        ],
        "nl": [
          "Natuurrace \"La Passe Pierre\" in de Baie de Canche.\n\nLa Terrible - 20 km natuurpad - 8.45 uur\nLa Douce - 10 km natuurpad - 9.00 uur\nLa Tranquille - 9 km ontdekkingswandeling - 9.15 uur vertrek vanaf de Etaples CNC.\nNIEUW! Mini Passe-Pierre: kinderparcours van 500 m tot 1 km. 11u Sainte-Cécile.\nFinish Centre Nautique de la Baie de Canche (Base Nord)."
        ],
        "es": [
          "Carrera natural \"La Passe Pierre\" en la bahía de Canche.\n\nLa Terrible - recorrido natural de 20 km - 8h45\nLa Douce - recorrido natural de 10 km - 9h\nLa Tranquille - paseo de descubrimiento de 9 km - 9.15 h salida del CNC de Etaples.\n¡NOVEDAD! Mini Passe-Pierre: sendero infantil de entre 500 m y 1 km. 11h Sainte-Cécile.\nLlegada Centre Nautique de la Baie de Canche (Base Nord)."
        ]
      },
