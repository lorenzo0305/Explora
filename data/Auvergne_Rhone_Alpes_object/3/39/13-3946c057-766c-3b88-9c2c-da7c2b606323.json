  "rdfs:comment": {
    "de": [
      "Erste Mikrobrauerei und Bierbar (17 Zapfanlagen) der Stadt, mittags Essen, abends Aperitif-Bretter, im Sommer Konzerte auf der Terrasse, im Winter Konzerte und DJs und das ganze Jahr über ein Lächeln!"
    ],
    "en": [
      "Best craft beer bar in town, restaurant at lunch, nice patio with concert in summer, coffee place all day, friendly and laid back !\r\nA place to meet students, travellers and expats."
    ],
    "it": [
      "La prima microbirreria e birreria della città (17 birre alla spina), ristoranti a pranzo, aperitivi la sera, concerti in terrazza in estate, concerti e DJ in inverno e sorrisi tutto l'anno!"
    ],
    "fr": [
      "Première microbrasserie et Bar à bière (17 pressions) de la ville, restauration le midi, planches apéro le soir, concerts en terrasse l’été, concerts et DJ’s l’hiver, et sourires toute l’année !"
    ],
    "es": [
      "La primera microcervecería y cervecería de la ciudad (17 cervezas de barril), restaurantes al mediodía, platos de aperitivo por la noche, conciertos en la terraza en verano, conciertos y DJs en invierno, ¡y sonrisas todo el año!"
    ],
    "nl": [
      "De eerste microbrouwerij en bierbar van de stad (17 bieren van het vat), restaurants 's middags, aperitiefschotels 's avonds, terrasconcerten in de zomer, concerten en dj's in de winter, en het hele jaar door een glimlach!"
    ]
  },
  "rdfs:label": {
    "de": [
      "BHV - Bar de l’hôtel de ville"
    ],
    "en": [
      "BHV - Bar de l’hôtel de ville"
    ],
    "fr": [
      "BHV - Bar de l’hôtel de ville"
    ]
  },
