  "rdfs:comment": {
    "de": [
      "Erlernen Sie den Orientierungslauf auf der Basis von Lavalette mit dem blauen Parcours: 0,8 km, 10 Markierungen und 40 Minuten spielerische Erkundung. Diese Naturstrecke ist für alle zugänglich und fördert den Orientierungssinn und den Teamgeist."
    ],
    "en": [
      "Try your hand at orienteering at the Lavalette base with the blue course: 0.8 km, 10 markers and 40 minutes of fun exploration. Accessible to all, this nature trail develops your sense of direction and team spirit."
    ],
    "it": [
      "Mettetevi alla prova con l'orienteering alla base di Lavalette con il percorso blu: 0,8 km, 10 marcatori e 40 minuti di divertente esplorazione. Accessibile a tutti, questo percorso naturalistico vi aiuterà a sviluppare il senso dell'orientamento e lo spirito di squadra."
    ],
    "fr": [
      "Initiez-vous à la course d’orientation à la base de Lavalette avec le parcours bleu : 0,8 km, 10 balises et 40 min d’exploration ludique. Accessible à tous, ce circuit nature permet de développer sens de l’orientation et esprit d’équipe."
    ],
    "es": [
      "Pruebe a orientarse en la base de Lavalette con el recorrido azul: 0,8 km, 10 balizas y 40 minutos de divertida exploración. Accesible a todos, este recorrido natural te ayudará a desarrollar el sentido de la orientación y el espíritu de equipo."
    ],
    "nl": [
      "Probeer oriëntatieloop op de Lavalette basis met het blauwe parcours: 0,8 km, 10 markers en 40 minuten plezierige verkenning. Dit natuurparcours is toegankelijk voor iedereen en helpt je je richtingsgevoel en teamgeest te ontwikkelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours  bleu d'orientation de Lavalette"
    ]
  },
