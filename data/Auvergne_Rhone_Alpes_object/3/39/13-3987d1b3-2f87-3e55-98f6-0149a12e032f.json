  "rdfs:comment": {
    "de": [
      "Mithilfe eines einfachen Scherenschnittverfahrens werden die Teilnehmer eingeladen, mit ihrer Familie die Vielzahl an Insekten, die den Garten bevölkern, nachzubilden."
    ],
    "en": [
      "Using a simple paper-cutting process, participants are invited to recreate, as a family, the multitude of insects that inhabit the garden."
    ],
    "it": [
      "Utilizzando un semplice processo di ritaglio della carta, i partecipanti sono invitati a ricreare, come una famiglia, la moltitudine di insetti che abitano il giardino."
    ],
    "fr": [
      "A partir d’un procédé simple de papier découpé, les participants sont invités à recréer, en famille, la multitude d’insectes qui peuple le jardin."
    ],
    "nl": [
      "Met behulp van een eenvoudig papierknipproces worden de deelnemers uitgenodigd om als gezin de vele insecten na te maken die in de tuin leven."
    ],
    "es": [
      "Mediante un sencillo proceso de recorte de papel, se invita a los participantes a recrear, en familia, la multitud de insectos que habitan el jardín."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite créative \"Les petites bêtes\" - Les mercredis en famille"
    ]
  },
