  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit Wood Track in die Welt der Schlittenhunde ein,. Taufen, Fahren, Cani-Rando oder Go-Kart: Ein unvergessliches Abenteuer erwartet Sie das ganze Jahr über,. Sie werden von leidenschaftlichen Mushers geführt. Sensationen garantiert!"
    ],
    "en": [
      "Dive into the world of dog sledding with Wood Track. Baptisms, driving, cani-rando or karting: an unforgettable adventure awaits you all year round. You'll be guided by passionate mushers. Sensations guaranteed!"
    ],
    "it": [
      "Tuffatevi nel mondo dello sleddog con Wood Track. Battesimo, guida, cani-rando o kart: un'avventura indimenticabile vi aspetta tutto l'anno. Sarete guidati da mushers appassionati. Emozioni garantite!"
    ],
    "fr": [
      "Plongez dans l'univers des chiens de traineaux avec Wood Track,. Baptêmes, conduite, cani-rando ou kart : une aventure inoubliable vous attend toute l'année,. Vous serez guidés par des mushers passionnés. Sensations garanties !"
    ],
    "es": [
      "Sumérjase en el mundo de los trineos tirados por perros con Wood Track. Bautizos, conducción, cani-rando o kart: le espera una aventura inolvidable durante todo el año. Te guiarán mushers apasionados. ¡Emociones garantizadas!"
    ],
    "nl": [
      "Duik in de wereld van hondensleeën met Wood Track. Dopen, rijden, cani-rando of kart: er staat je het hele jaar door een onvergetelijk avontuur te wachten. Je wordt begeleid door gepassioneerde mushers. Sensatie gegarandeerd!"
    ]
  },
