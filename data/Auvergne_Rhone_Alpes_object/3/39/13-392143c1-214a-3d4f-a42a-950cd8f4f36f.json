  "rdfs:comment": {
    "de": [
      "Machen Sie sich bereit für ein einzigartiges intergalaktisches Abenteuer! Das Spiel Cosmix lädt Sie ein, die faszinierende Welt der Astronomie zu erforschen und dabei Spaß zu haben. An der Seite von Cosmix begeben Sie sich auf eine spannende Suche durch die Galerie."
    ],
    "en": [
      "Get ready for a unique intergalactic adventure! Cosmix invites you to explore the fascinating world of astronomy while having fun. Join Cosmix on a thrilling quest through the gallery."
    ],
    "it": [
      "Preparatevi a un'avventura intergalattica unica! Cosmix vi invita a esplorare l'affascinante mondo dell'astronomia divertendovi. Unitevi a Cosmix in un'emozionante ricerca attraverso la galleria."
    ],
    "fr": [
      "Préparez-vous à une aventure intergalactique unique en son genre ! Le jeu Cosmix vous invite à explorer l’univers fascinant de l’astronomie tout en vous amusant. Aux côtés de Cosmix, embarquez pour une quête palpitante à travers la galerie."
    ],
    "es": [
      "¡Prepárate para una aventura intergaláctica única! Cosmix te invita a explorar el fascinante mundo de la astronomía mientras te diviertes. Únete a Cosmix en una emocionante búsqueda a través de la galería."
    ],
    "nl": [
      "Bereid je voor op een uniek intergalactisch avontuur! Cosmix nodigt je uit om de fascinerende wereld van de astronomie te verkennen terwijl je plezier hebt. Ga met Cosmix mee op een spannende zoektocht door de galerij."
    ]
  },
