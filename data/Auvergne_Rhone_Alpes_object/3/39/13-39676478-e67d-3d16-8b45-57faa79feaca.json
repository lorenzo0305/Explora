  "rdfs:comment": {
    "de": [
      "Bewegen Sie sich mithilfe Ihrer Karte durch das Dorf Oz-en-Oisans und entdecken Sie seine typische Architektur der Weiler von Oisans und sein reiches Kulturerbe."
    ],
    "en": [
      "Explore the village of Oz-en-Oisans with your map to discover its typically local architecture and rich heritage."
    ],
    "it": [
      "Con l'aiuto della vostra mappa, spostatevi nel villaggio di Oz-en-Oisans per scoprire la sua tipica architettura di borgo dell'Oisans e il suo ricco patrimonio."
    ],
    "fr": [
      "A l'aide de votre carte, déplacez-vous dans le village d'Oz-en-Oisans pour découvrir son architecture typique des hameaux de l'Oisans et ses richesses patrimoniales."
    ],
    "nl": [
      "Gebruik je kaart om het dorp Oz-en-Oisans te verkennen en ontdek de typische architectuur en het rijke erfgoed van het gehucht Oisans."
    ],
    "es": [
      "Con la ayuda de su mapa, muévase por el pueblo de Oz-en-Oisans para descubrir su arquitectura típica de aldea de Oisans y su rico patrimonio."
    ]
  },
  "rdfs:label": {
