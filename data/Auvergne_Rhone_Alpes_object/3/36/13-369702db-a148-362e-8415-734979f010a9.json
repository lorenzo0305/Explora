  "rdfs:comment": {
    "de": [
      "Ein einfacher, schlüsselfertiger und modulierbarer Ort, der von einer Expertin für kollektive Intelligenz geschaffen und geleitet wird, um die Kreativität freizusetzen und den Zusammenhalt des Teams zu fördern. Positive Auswirkungen garantiert!"
    ],
    "en": [
      "A facilitating, turnkey, flexible venue, created and run by an expert in collective intelligence, to unleash creativity and develop team cohesion. Positive impact guaranteed!"
    ],
    "it": [
      "Una sede facilitante, chiavi in mano e flessibile, creata e gestita da un esperto di intelligenza collettiva, per liberare la creatività e sviluppare la coesione del team. Impatto positivo garantito!"
    ],
    "fr": [
      "Un lieu facilitant, clé en main, modulable, créé et animé par une experte de l'intelligence collective, pour libérer la créativité et développer la cohésion d'équipe. Impact positif garanti!"
    ],
    "es": [
      "Un espacio facilitador, llave en mano y flexible, creado y dirigido por un experto en inteligencia colectiva, para dar rienda suelta a la creatividad y desarrollar la cohesión de los equipos. ¡Impacto positivo garantizado!"
    ],
    "nl": [
      "Een faciliterende, kant-en-klare, flexibele locatie, gecreëerd en geleid door een expert in collectieve intelligentie, om creativiteit te ontketenen en teamcohesie te ontwikkelen. Positieve impact gegarandeerd!"
    ]
  },
