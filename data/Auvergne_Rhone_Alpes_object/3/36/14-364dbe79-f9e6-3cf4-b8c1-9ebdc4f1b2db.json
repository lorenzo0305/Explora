  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ebccf63b-fb25-33b2-93ef-13a4dfab34f7",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte :\n\nLes Vergers d'Artois bietet Ihnen im Direktverkauf Äpfel, Birnen und Kartoffeln an.\n\nÖffnungstage:\n\nTäglich von 14h bis 18h\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts :\n\nLes Vergers d'Artois offers direct sales of apples, pears and potatoes.\n\nOpening days:\n\nEvery day from 2pm to 6pm\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti :\n\nLes Vergers d'Artois propone la vendita diretta di mele, pere e patate.\n\nGiorni di apertura:\n\nTutti i giorni dalle 14.00 alle 18.00\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits :\n\nLes Vergers d'Artois vous proposent en vente directe des pommes, des poires et des pommes de terre.\n\nJours d'ouverture: \n\nTous les jours de 14h à 18h\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten :\n\nLes Vergers d'Artois biedt rechtstreekse verkoop van appels, peren en aardappelen.\n\nOpeningsdagen:\n\nElke dag van 14.00 tot 18.00 uur\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos :\n\nLes Vergers d'Artois ofrece venta directa de manzanas, peras y patatas.\n\nDías de apertura:\n\nTodos los días de 14:00 a 18:00\n\n\n "
        ]
      },
