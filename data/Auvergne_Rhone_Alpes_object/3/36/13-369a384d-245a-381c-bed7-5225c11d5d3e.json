  "rdfs:comment": {
    "de": [
      "Kleiner Badestrand am Anschalder See, mit saisonal geöffneter Jausenstation, Spielplatz, Pétanque-Platz, Picknickplatz. Barrierefreie Toiletten und Duschen im Gemeinschaftsgebäude des Imbisses."
    ],
    "en": [
      "Small beach on the lake of Anschald, with snack bar open in season, playground, pétanque court, picnic area. Accessible toilets and showers in the communal building of the snack bar."
    ],
    "it": [
      "Piccola spiaggia sul lago di Anschald, con snack bar aperto in stagione, parco giochi, area bocce, area picnic. Servizi igienici e doccia disponibili nell'edificio comune dello snack bar."
    ],
    "fr": [
      "Petite plage aménagée sur le plan d'eau d'Anschald, avec snack bar ouvert en saison, aire de jeux, terrain de pétanque, aire de pique-nique. Toilettes et douche accessibles dans le bâtiment communal du snack."
    ],
    "es": [
      "Pequeña playa en el lago Anschald, con bar abierto en temporada, parque infantil, zona de petanca, zona de picnic. Aseos y duchas en el edificio común del bar."
    ],
    "nl": [
      "Klein strand aan het meer van Anschald, met snackbar geopend in het seizoen, speeltuin, jeu de boulesbaan, picknickplaats. Toiletten en douche beschikbaar in het gemeenschappelijke gebouw van de snackbar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Swimming - Plan d'Eau d'Anschald"
    ],
    "fr": [
      "Baignade - Plan d'Eau d'Anschald"
    ]
  },
