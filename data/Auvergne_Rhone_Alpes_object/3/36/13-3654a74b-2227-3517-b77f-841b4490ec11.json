  "rdfs:comment": {
    "de": [
      "Tarentaise Traîneau Mushing bietet Ihnen eine unvergessliche Hundeschlittenfahrt im Herzen des nordischen Skigebiets Peisey-Vallandry. Begeben Sie sich auf ein authentisches nordisches Abenteuer unter der Leitung erfahrener Musher."
    ],
    "en": [
      "Tarentaise Traîneau Mushing offers an unforgettable dogsled ride in the heart of the Peisey-Vallandry Nordic area.\r\nEmbark on an authentic Nordic adventure, led by passionate mushers."
    ],
    "it": [
      "Tarentaise Traîneau Mushing offre escursioni con cani da slitta nel cuore della località nordica di Peisey-Vallandry.\r\nScoprite il mondo dei cani sportivi, seguiti da appassionati mushers con qualifiche statali."
    ],
    "fr": [
      "Tarentaise Traîneau Mushing vous propose l'activité traîneau à chiens  au cœur du site nordique de Peisey-Vallandry. \r\nDécouvrez l'univers du chiens de sport, encadrée par des mushers passionnés et diplômés d'état."
    ],
    "es": [
      "Tarentaise Traîneau Mushing ofrece paseos en trineo tirado por perros en el corazón de la estación nórdica de Peisey-Vallandry.\r\nDescubra el mundo de los perros deportivos, supervisado por apasionados mushers con titulación estatal."
    ],
    "nl": [
      "Tarentaise Traîneau Mushing biedt hondensledetochten aan in het hart van het Nordic resort Peisey-Vallandry.\r\nOntdek de wereld van sportieve honden, begeleid door gepassioneerde mushers met staatsdiploma."
    ]
  },
