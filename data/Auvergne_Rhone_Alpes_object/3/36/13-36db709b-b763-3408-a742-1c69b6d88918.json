  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie im Ökomuseum des Dorfes und vermitteln Ihnen alle Informationen über die Umgebung. Wir stehen Ihnen mit Rat und Tat zur Seite, damit Sie die Geheimnisse unseres wunderbaren Tals entdecken können."
    ],
    "en": [
      "We welcome you in the ecomuseum of the village to give you all the information about the area. We are at your disposal to advise you and allow you to discover the secrets of our wonderful valley."
    ],
    "it": [
      "Ti diamo il benvenuto nell'ecomuseo del villaggio per fornirti tutte le informazioni sui dintorni. Siamo a tua disposizione per consigliarti e farti scoprire i segreti della nostra meravigliosa valle."
    ],
    "fr": [
      "Nous vous accueillons dans l'écomusée du village pour vous communiquer toutes les informations sur les alentours. Nous sommes à votre disposition pour vous conseiller et vous permettre de découvrir les secrets de notre merveilleuse vallée."
    ],
    "nl": [
      "We verwelkomen je in het ecomuseum van het dorp om je alle informatie over het gebied te geven. Wij staan tot uw beschikking om u te adviseren en u de geheimen van onze prachtige vallei te laten ontdekken."
    ],
    "es": [
      "Le damos la bienvenida al ecomuseo del pueblo para ofrecerle toda la información que necesite sobre los alrededores. Estaremos encantados de aconsejarle y ayudarle a descubrir los secretos de nuestro maravilloso valle."
    ]
  },
