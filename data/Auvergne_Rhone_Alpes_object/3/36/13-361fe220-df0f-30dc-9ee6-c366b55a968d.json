  "rdfs:comment": {
    "de": [
      "Das Tord Boyaux Grenoble liegt ideal im Stadtzentrum von Grenoble und ist eine Bar mit aromatisiertem Wein in einer freundlichen Atmosphäre!\r\nAbend Blind Test jeden Dienstag ab 19.30 Uhr.\r\nBeer Pong-Abend jeden Mittwoch ab 18:30 Uhr, in Zweierteams!"
    ],
    "en": [
      "Ideally located in Grenoble's city center, Tord Boyaux Grenoble is a flavored wine bar with a friendly atmosphere!\r\nBlind Test evenings every Tuesday from 7:30 p.m.\r\nBeer Pong evenings every Wednesday at 6.30pm, in teams of 2!"
    ],
    "it": [
      "Situato in posizione ideale nel centro di Grenoble, Tord Boyaux Grenoble è un wine bar aromatizzato dall'atmosfera amichevole!\r\nSerate Blind Test ogni martedì dalle 19.30\r\nSerate di Beer Pong ogni mercoledì alle 18.30, a squadre di 2 persone!"
    ],
    "fr": [
      "Idéalement placé en plein centre ville de Grenoble, le Tord Boyaux Grenoble, c'est bar à vin aromatisé dans une ambiance conviviale !\r\nSoirée Blind Test tous les mardis à partir de 19h30\r\nSoirée Beer Pong tous les mercredis à 18h30, par équipe de 2 !"
    ],
    "nl": [
      "Tord Boyaux Grenoble, ideaal gelegen in het centrum van Grenoble, is een gearomatiseerde wijnbar met een gezellige sfeer!\r\nBlindtestavonden elke dinsdag vanaf 19.30 uur\r\nBierpongavonden elke woensdag om 18.30 uur, in teams van 2!"
    ],
    "es": [
      "Idealmente situado en el centro de la ciudad de Grenoble, Tord Boyaux Grenoble es un bar de vinos con sabor y ambiente agradable.\r\nCatas a ciegas todos los martes a partir de las 19.30 h.\r\nTardes de Beer Pong todos los miércoles a las 18.30 h, ¡en equipos de 2!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Tord Boyaux"
    ]
  },
