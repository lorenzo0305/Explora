  "rdfs:comment": {
    "de": [
      "Ideal gelegen am Fuße des Bikeparks und des Pierre-Longue-Sessellifts, neben dem Bobluges, bietet die Bar de la Perdrix Blanche mit ihrer großen Terrasse Bier, Aperitifs, Softdrinks, Cocktails... alles, was man braucht, um seinen Durst zu löschen!"
    ],
    "en": [
      "Ideally situated at the foot of the Bike Park and the Pierre-Longue chairlift, next to the Bobluges, the Perdrix Blanche bar with its large terrace offers beers, aperitifs, soft drinks, cocktails... everything you need to quench your thirst!"
    ],
    "it": [
      "Situato in posizione ideale ai piedi del Bike Park e della seggiovia Pierre-Longue, accanto al Bobluges, il bar Perdrix Blanche con la sua ampia terrazza offre birre, aperitivi, bibite, cocktail... tutto ciò che serve per dissetarsi!"
    ],
    "fr": [
      "Idéalement situé au pied du Bike Park et du Télésiège de Pierre-Longue, à côté du Bobluges, le bar de la Perdrix Blanche avec sa grande terrasse vous propose bières, apéritifs, soft, cocktails... tout ce qu'il faut pour se désaltérer !"
    ],
    "es": [
      "Idealmente situado al pie del Bike Park y del telesilla Pierre-Longue, junto a los Bobluges, el bar Perdrix Blanche, con su amplia terraza, ofrece cervezas, aperitivos, refrescos, cócteles... ¡todo lo necesario para calmar la sed!"
    ],
    "nl": [
      "Ideaal gelegen aan de voet van het Bike Park en de stoeltjeslift Pierre-Longue, naast de Bobluges, biedt de bar Perdrix Blanche met zijn grote terras bieren, aperitieven, frisdranken, cocktails... alles wat u nodig hebt om uw dorst te lessen!"
    ]
  },
  "rdfs:label": {
