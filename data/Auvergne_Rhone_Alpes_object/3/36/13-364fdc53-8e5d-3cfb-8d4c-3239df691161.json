  "rdfs:comment": {
    "de": [
      "Diese für Gravel-Fahrer geeignete Strecke erkundet die Wege und kleinen Straßen des Haut-Valromey zwischen dem Col de la Clye und dem Col de la Valorse, dem Standort La Praille, dem Plateau de Retord und der Corniche du Valromey."
    ],
    "en": [
      "This gravel-friendly route explores the paths and back roads of the Haut-Valromey between the Clye and Valorse passes, the Praille site, the Plateau de Retord and the Corniche du Valromey."
    ],
    "it": [
      "Questo percorso adatto agli sterrati esplora i sentieri e le strade secondarie dell'Haut-Valromey tra i passi Clye e Valorse, il sito della Praille, il Plateau de Retord e la Corniche du Valromey."
    ],
    "fr": [
      "Ce parcours adapté à la pratique du gravel explore les chemins et petites routes du Haut-Valromey entre les cols de la Clye et de la Valorse, le site de la Praille, le Plateau de Retord et la Corniche du Valromey."
    ],
    "es": [
      "Esta ruta, apta para la grava, explora los senderos y carreteras secundarias del Haut-Valromey entre los puertos de Clye y Valorse, el paraje de Praille, el Plateau de Retord y la Corniche du Valromey."
    ],
    "nl": [
      "Deze grindvriendelijke route verkent de paden en binnenwegen van de Haut-Valromey tussen de passen van Clye en Valorse, de site van Praille, het Plateau de Retord en de Corniche du Valromey."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours gravel rouge - Le tour du Haut-Valromey en gravel - Espace FFC Ain Forestière"
    ]
  },
