  "rdfs:comment": {
    "de": [
      "Vasen, Schalen, Näpfe, Ringe, Broschen, Soliflore... aus Porzellan, dekoriert mit den (zahlreichen) Techniken, die der Ton bietet (Airbrush, Intarsien....), sind die hier hergestellten Objekte anspruchsvoll und vor allem feminin."
    ],
    "en": [
      "Vases, bowls, bowls, rings, brooches, soliflore... created in porcelain, decorated using the multiple techniques available in clay (airbrush, inlay....), the objects created are sophisticated and feminine above all."
    ],
    "it": [
      "Vasi, ciotole, coppe, anelli, spille, soliflore... creati in porcellana, decorati con le molteplici tecniche offerte dall'argilla (aerografo, intarsio....), gli oggetti creati sono sofisticati e soprattutto femminili."
    ],
    "fr": [
      "Vase, bols, écuelles, anneaux, broches, soliflore... crées en porcelaine, décorés aux (multiples techniques qu'offre la terre (aérographe, incrustation....) les objets réalisés y sont sophistiqués et féminins avant tout."
    ],
    "nl": [
      "Vazen, schalen, kommen, ringen, broches, soliflore... gemaakt van porselein en gedecoreerd met behulp van de vele technieken die beschikbaar zijn in klei (airbrushen, inlaying....), zijn de gecreëerde objecten verfijnd en bovenal vrouwelijk."
    ],
    "es": [
      "Jarrones, cuencos, anillos, broches, soliflores... creados en porcelana, decorados con las múltiples técnicas que ofrece la arcilla (aerografía, incrustación....), los objetos creados son sofisticados y sobre todo femeninos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cil Céramique"
    ]
  },
