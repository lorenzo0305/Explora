  "rdfs:comment": {
    "de": [
      "Die Kammermusikschüler des Conservatoire musiques et théâtre de Montélimar agglomération werden Ihnen ein abwechslungsreiches, gefühlvolles und farbenfrohes Programm darbieten."
    ],
    "en": [
      "Chamber music students from the Montélimar agglomeration music and theater conservatory will perform a varied, sensitive and colorful program."
    ],
    "it": [
      "Gli studenti di musica da camera del Conservatorio di musica e teatro dell'agglomerato di Montélimar si esibiranno in un programma vario, sensibile e colorato."
    ],
    "fr": [
      "Les élèves de musique de chambre du conservatoire musiques et théâtre de Montélimar agglomération vous interprèteront un programme varié, sensible et coloré."
    ],
    "nl": [
      "Studenten kamermuziek van het muziek- en theaterconservatorium van de agglomeratie Montélimar brengen een gevarieerd, gevoelig en kleurrijk programma."
    ],
