  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die kulinarische Authentizität der Region und entdecken Sie unsere regionalen Gerichte, die mit Sorgfalt aus lokalen Produkten zubereitet werden, die sorgfältig nach Qualität und Frische ausgewählt wurden."
    ],
    "en": [
      "Immerse yourself in the culinary authenticity of the region and discover our regional dishes prepared with care from local products carefully selected for their quality and freshness."
    ],
    "it": [
      "Immergetevi nell'autenticità culinaria della regione e scoprite i nostri piatti regionali preparati con cura utilizzando prodotti locali accuratamente selezionati per la loro qualità e freschezza."
    ],
    "fr": [
      "Plongez dans l'authenticité culinaire de la région et découvrez nos plats régionaux préparés avec soin à partir de produits locaux soigneusement sélectionnés pour leur qualité et leur fraîcheur."
    ],
    "es": [
      "Sumérjase en la autenticidad culinaria de la región y descubra nuestros platos regionales preparados con esmero a partir de productos locales cuidadosamente seleccionados por su calidad y frescura."
    ],
    "nl": [
      "Dompel jezelf onder in de culinaire authenticiteit van de regio en ontdek onze regionale gerechten die met zorg zijn bereid met lokale producten die zorgvuldig zijn geselecteerd op kwaliteit en versheid."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hotel Restaurant des Voyageurs"
    ]
  },
