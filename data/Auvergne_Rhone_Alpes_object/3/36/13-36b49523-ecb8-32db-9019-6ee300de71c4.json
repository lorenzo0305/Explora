  "rdfs:comment": {
    "de": [
      "Klimatisiertes Familienhotel-Restaurant, Zimmer mit allem Komfort. Privilegierte Lage am Ortseingang von Die. Überdachter und privater Parkplatz, Bar, Garten, Terrasse. Traditionelle Küche. Ausgewählte lokale Produkte."
    ],
    "en": [
      "Air-conditioned family hotel-restaurant, comfortable rooms. Privileged location at the entrance to Die. Covered private parking, bar, garden, terrace. Traditional cuisine. Selected local products."
    ],
    "it": [
      "Hotel-ristorante a conduzione familiare climatizzato con camere confortevoli. Posizione privilegiata all'ingresso di Die. Parcheggio privato coperto, bar, giardino, terrazza. Cucina tradizionale. Prodotti locali selezionati."
    ],
    "fr": [
      "Hôtel-Restaurant familial climatisé, chambres tout confort. Situation privilégiée à l'entrée de Die. Parking couvert et privé, bar, jardin, terrasse. Cuisine traditionnelle. Produits locaux sélectionnés."
    ],
    "es": [
      "Hotel-restaurante familiar climatizado con habitaciones confortables. Situación privilegiada a la entrada de Die. Aparcamiento privado cubierto, bar, jardín, terraza. Cocina tradicional. Productos locales seleccionados."
    ],
    "nl": [
      "Familiehotel-restaurant met airconditioning en comfortabele kamers. Bevoorrechte locatie bij de ingang van Die. Overdekte privéparkeerplaats, bar, tuin, terras. Traditionele keuken. Geselecteerde lokale producten."
    ]
  },
