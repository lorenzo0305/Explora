  "rdfs:comment": {
    "de": [
      "Le Pic du 35, ein neues Café-Bar-Restaurant im Herzen des Dorfes, bietet Ihnen eine Speisekarte, auf der sich traditionelle Küche und savoyische Spezialitäten mit oder ohne Käse, zartschmelzend oder leichter, für jeden Geschmack etwas finden."
    ],
    "en": [
      "Le Pic du 35, a new café-bar-restaurant in the heart of the village, offers a menu combining traditional cuisine and Savoyard specialities, with or without cheese, melt-in-your-mouth or lighter, to satisfy every taste."
    ],
    "it": [
      "Le Pic du 35, un nuovo bar-ristorante nel cuore del villaggio, offre un menu che combina la cucina tradizionale savoiarda e le specialità, con o senza formaggio, fondenti o più leggere, per soddisfare tutti i gusti."
    ],
    "fr": [
      "Le Pic du 35, nouveau café-bar-restaurant situé au cœur du village, vous propose une carte où se mêlent cuisine traditionnelle et spécialités savoyardes, avec ou sans fromage, fondantes ou plus légères, pour satisfaire toutes les envies."
    ],
    "es": [
      "Le Pic du 35, un nuevo café-bar-restaurante en el corazón del pueblo, ofrece una carta que combina cocina tradicional saboyana y especialidades, con o sin queso, fundentes o más ligeras, para satisfacer todos los gustos."
    ],
    "nl": [
      "Le Pic du 35, een nieuw café-bar-restaurant in het hart van het dorp, biedt een menu dat traditionele Savoyaardse gerechten en specialiteiten combineert, met of zonder kaas, smeltend of lichter, om aan elke smaak te voldoen."
    ]
  },
