  "rdfs:comment": {
    "de": [
      "Mit Liebe und Leidenschaft stellt Isabelle seit mehreren Jahren Ziegenkäse aus Rohmilch vom Bauernhof her.\r\nÜbernahme des Familienbetriebs im Jahr 2024 durch ihre Tochter Marie mit immer noch denselben Produkten und Werten."
    ],
    "en": [
      "With love and passion, Isabelle has been making farmhouse goat's milk cheeses for many years.\r\nIn 2024, her daughter Marie took over the family business with the same products and values."
    ],
    "it": [
      "Isabelle produce formaggi di capra di fattoria con amore e passione da molti anni.\r\nNel 2024, sua figlia Marie ha rilevato l'azienda di famiglia, continuando a utilizzare gli stessi prodotti e valori."
    ],
    "fr": [
      "C'est avec amour et passion qu'Isabelle fabrique depuis plusieurs années des fromages de chèvres fermiers au lait cru. \r\nReprise en 2024 par sa fille Marie de l'entreprise familiale avec toujours les mêmes produits et valeurs."
    ],
    "nl": [
      "Isabelle maakt al vele jaren met liefde en passie boerengeitenkazen.\r\nIn 2024 nam haar dochter Marie het familiebedrijf over, nog steeds met dezelfde producten en waarden."
    ],
    "es": [
      "Isabelle lleva muchos años elaborando quesos de cabra de granja con amor y pasión.\r\nEn 2024, su hija Marie tomó las riendas de la empresa familiar, que sigue utilizando los mismos productos y valores."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Biquettes du Pays de Tronçais"
    ]
  },
