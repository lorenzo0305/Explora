  "rdfs:comment": {
    "de": [
      "Das Maison de la Fourme bietet Ihnen die Möglichkeit, etwas von den kulinarischen Spezialitäten der Auvergne (Käse, Wein, Marmelade), aber auch von regionalen Werken (Bücher, Messer usw.) mit nach Hause zu nehmen."
    ],
    "en": [
      "The Maison de la Fourme offers you the opportunity to take home some of the culinary specialities of the Auvergne (cheeses, wines, jams) as well as regional items (books, knives, etc.)."
    ],
    "it": [
      "La Maison de la Fourme offre la possibilità di portare a casa alcune specialità culinarie dell'Alvernia (formaggi, vini, marmellate) e oggetti regionali (libri, coltelli, ecc.)."
    ],
    "fr": [
      "La Maison de la Fourme vous propose de ramener chez vous un peu des spécialités culinaires d'Auvergne (fromages, vins, confitures) mais aussi des ouvrages régionaux (livres, couteaux, etc.)."
    ],
    "es": [
      "La Maison de la Fourme le ofrece la posibilidad de llevarse a casa algunas de las especialidades culinarias de Auvernia (quesos, vinos, mermeladas), así como artículos regionales (libros, cuchillos, etc.)."
    ],
    "nl": [
      "In het Maison de la Fourme kun je culinaire specialiteiten uit de Auvergne (kazen, wijnen, jam) en regionale voorwerpen (boeken, messen, enz.) mee naar huis nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boutique de la Maison de la Fourme"
    ]
  },
