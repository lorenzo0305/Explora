  "rdfs:comment": {
    "de": [
      "Mein Name ist Agnès, Reiseleiterin, kommen Sie mit mir, um den Reichtum des Erbes zu teilen, das im Laufe der Geschichte von denen hinterlassen wurde, die die Chaîne des Puys - Limagne-Verwerfung geprägt haben ..."
    ],
    "en": [
      "My name is Agnes, certified guide and lecturer. I can't wait to share with you our marvellous heritage, the richness and secrets left all throughout history by those who left their mark on the Chaîne des Puys-Limagne Fault and the beautiful Auvergne region."
    ],
    "it": [
      "Mi chiamo Agnès e sono una guida turistica. Venite a condividere con me la ricca eredità lasciata nel corso della storia da coloro che hanno segnato la Chaîne des Puys - faglia di Limagne e la splendida regione dell'Alvernia."
    ],
    "fr": [
      "Je m'appelle Agnès, je suis guide conférencière. Venez avec moi partager la richesse du patrimoine laissé tout au long de l'histoire par ceux qui ont marqué de leur empreinte la Chaîne des Puys - faille de Limagne et la belle région Auvergne."
    ],
    "nl": [
      "Mijn naam is Agnès en ik ben een reisleidster. Kom en deel met mij het rijke erfgoed dat door de geschiedenis heen is achtergelaten door degenen die hun stempel hebben gedrukt op de Chaîne des Puys - Limagne breuk en de prachtige Auvergne regio."
    ],
    "es": [
      "Me llamo Agnès y soy guía turística. Venga a compartir conmigo el rico patrimonio dejado a lo largo de la historia por aquellos que dejaron su huella en la falla Chaîne des Puys - Limagne y en la hermosa región de Auvernia."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fremdenführer Agnès Bertet - Grand Tour Auvergne"
    ],
    "en": [
      "Speaker guide Agnès Bertet - Grand Tour Auvergne"
    ],
    "fr": [
      "Guide conférencière Agnès Bertet - Grand Tour Auvergne"
    ]
  },
