  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/71f3ab41-fb92-3393-a27a-dc7a8b4c82df",
      "dc:description": {
        "de": [
          "Die Kirche Saint-Martin, die im Laufe der Jahrhunderte zu der heutigen dreischiffigen Kirche umgebaut wurde, zeigt ihren mittelalterlichen romanischen Stil mit Fassaden aus Kreide und roten Ziegeln."
        ],
        "en": [
          "Transformed over the centuries to become the three-aisled church it is today, Saint-Martin church displays its medieval Romanesque style with chalk facades and red bricks."
        ],
        "it": [
          "Trasformata nel corso dei secoli per diventare la chiesa a tre navate che è oggi, la chiesa di Saint-Martin presenta il suo stile romanico medievale con facciate in gesso e mattoni rossi."
        ],
        "fr": [
          "Transformée au fil des siècles pour devenir l'église à trois nefs d'aujourd'hui, l'église Saint-Martin présente son style roman médiéval avec ses façades en craie et ses briques rouges."
        ],
        "es": [
          "Transformada a lo largo de los siglos hasta convertirse en la iglesia de tres naves que es hoy, la iglesia Saint-Martin presenta su estilo románico medieval con fachadas de tiza y ladrillos rojos."
        ],
        "nl": [
          "De kerk Saint-Martin is door de eeuwen heen getransformeerd tot de driebeukige kerk die het nu is. De kerk heeft zijn middeleeuwse Romaanse stijl met krijtgevels en rode bakstenen."
        ]
      },
