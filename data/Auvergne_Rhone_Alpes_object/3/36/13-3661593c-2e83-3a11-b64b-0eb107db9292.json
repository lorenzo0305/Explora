  "rdfs:comment": {
    "de": [
      "Diese Tour führt Sie in eine wilde, unberührte Welt mit außergewöhnlichen Landschaften, die oft mit den Steppen der Mongolei oder den Hochebenen Schottlands verglichen werden."
    ],
    "en": [
      "Take the start of a tour that will give you access to a wild, unspoilt world, with exceptional landscapes often compared to the steppes of Mongolia or the plateaus of Scotland."
    ],
    "it": [
      "Partite per questo tour che vi darà accesso a un mondo selvaggio e incontaminato, con paesaggi eccezionali spesso paragonati alle steppe della Mongolia o agli altopiani della Scozia."
    ],
    "fr": [
      "Prenez le départ de ce circuit qui vous donnera accès à un monde sauvage, préservé, aux paysages exceptionnels souvent comparés aux steppes de Mongolie ou encore aux plateaux de l’Ecosse."
    ],
    "nl": [
      "Vertrek op deze tocht die je toegang geeft tot een wilde, ongerepte wereld, met uitzonderlijke landschappen die vaak worden vergeleken met de steppen van Mongolië of de hoogvlaktes van Schotland."
    ],
    "es": [
      "Emprenda este viaje que le dará acceso a un mundo salvaje y virgen, con paisajes excepcionales que a menudo se comparan con las estepas de Mongolia o las mesetas de Escocia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit thématique - Au cœur du Cézallier"
    ]
  },
