  "rdfs:comment": {
    "de": [
      "Saly Cosmétiques ist ein lokales Unternehmen, das Naturkosmetikprodukte herstellt. Seine beiden Marken, Saly Savons und Valambrun Cosmétiques, bieten natürliche Körperpflegeprodukte von höchster Qualität an."
    ],
    "en": [
      "Saly Cosmétiques is a local manufacturer of natural cosmetics. Its two brands, Saly Savons and Valambrun Cosmétiques, offer natural body care products of the highest quality."
    ],
    "it": [
      "Saly Cosmétiques è un'azienda locale che produce cosmetici naturali. I suoi due marchi, Saly Savons e Valambrun Cosmétiques, offrono prodotti naturali per la cura del corpo di altissima qualità."
    ],
    "fr": [
      "Saly Cosmétiques est une entreprise locale qui fabrique des produits de cosmétiques naturels. Ses deux marques, Saly Savons et Valambrun Cosmétiques, proposent des soins du corps naturels de très haute qualité."
    ],
    "nl": [
      "Saly Cosmétiques is een lokaal bedrijf dat natuurlijke cosmetica produceert. De twee merken, Saly Savons en Valambrun Cosmétiques, bieden natuurlijke lichaamsverzorgingsproducten van de hoogste kwaliteit."
    ],
    "es": [
      "Saly Cosmétiques es una empresa local que fabrica cosméticos naturales. Sus dos marcas, Saly Savons y Valambrun Cosmétiques, ofrecen productos naturales de máxima calidad para el cuidado del cuerpo."
    ]
  },
