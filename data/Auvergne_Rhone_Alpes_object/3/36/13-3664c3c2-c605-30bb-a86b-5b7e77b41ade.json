  "rdfs:comment": {
    "de": [
      "Mit Azize und Lucie, staatlich geprüften Bergbegleitern, können Sie die schönsten Natur- und Wildnisgebiete von Valloire erkunden."
    ],
    "en": [
      "With Azize and Lucie, certified mountain guides, discover natural areas and the heritage of Valloire."
    ],
    "it": [
      "Con Azize e Lucie, guide alpine certificate, scoprite gli spazi naturali e il patrimonio di Valloire."
    ],
    "fr": [
      "Avec Azize et Lucie, accompagnateurs en montagne, diplômés d'état, partez à la découverte des plus beaux espaces naturels et sauvages de Valloire."
    ],
    "nl": [
      "Kom natuurgebieden en het erfgoed van Valloire ontdekken met Azize en Lucie, erkende berggidsen met een staatsdiploma."
    ],
    "es": [
      "Con Azize y Lucie, guías de montaña diplomados por el Estado, descubra las zonas naturales y salvajes más bellas de Valloire."
    ]
