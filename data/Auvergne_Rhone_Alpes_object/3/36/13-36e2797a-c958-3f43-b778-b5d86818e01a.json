  "rdfs:comment": {
    "de": [
      "Als echte Ruhepause nach stundenlangem Skifahren im Winter oder einer Wanderung im Sommer bietet Ihnen der Food-Truck in Le Jaillet im Winter Burger und im Sommer Bretter und Salate an. Alles mit lokalen Produzenten."
    ],
    "en": [
      "A real place to relax after hours of skiing in winter or hiking in summer, the Jaillet food truck serves burgers in winter and platters and salads in summer. All made with ingredients from local producers."
    ],
    "it": [
      "Food truck al centro del parco giochi panoramico sulla cima della telecabina del Jaillet, di fronte al Monte Bianco.\r\nTavole con prodotti locali e dolci!!! Per il piacere di grandi e piccini."
    ],
    "fr": [
      "Véritable temps de repos après des heures de ski l'hiver ou une randonnée l'été, le food-truck du Jaillet vous propose une restauration de burgers en hiver et de planches et salades en été. Le tout avec des producteurs locaux."
    ],
    "es": [
      "El food truck de Jaillet, un auténtico lugar de descanso tras horas de esquí en invierno o de senderismo en verano, ofrece hamburguesas en invierno y tablas y ensaladas en verano. Todo ello elaborado con productos locales."
    ],
    "nl": [
      "De Jaillet food-truck is een echt verademing na uren skiën in de winter of wandelen in de zomer en serveert hamburgers in de winter en schotels en salades in de zomer. Allemaal van lokale producenten."
    ]
  },
  "rdfs:label": {
    "en": [
