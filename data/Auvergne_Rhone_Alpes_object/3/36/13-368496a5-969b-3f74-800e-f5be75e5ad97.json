  "rdfs:comment": {
    "de": [
      "Herstellung von Schönheits- und Pflegekosmetik aus Wildpflanzen der Baronnies: 100% Natur, lebendig, reichhaltig und konzentriert, wirklich aktiv auf der Haut. Ohne invasive Inhaltsstoffe oder Prozesse, handgefertigt in den Baronnies. 100% natürliche oder BIO-Aktivstoffe."
    ],
    "en": [
      "Production of beauty & skincare cosmetics with wild plants from the Baronnies: 100% natural, lively, rich and concentrated, truly active on the skin. No invasive ingredients or processes, handmade in the Baronnies. 100% natural or ORGANIC active ingredients."
    ],
    "it": [
      "Produzione di cosmetici per la bellezza e la cura con piante selvatiche delle Baronie: 100% naturali, vive, ricche e concentrate, realmente attive sulla pelle. Nessun ingrediente o processo invasivo, fatto a mano nelle Baronnies. Ingredienti 100% naturali o biologici."
    ],
    "fr": [
      "Fabrication de produits cosmétiques beauté & soin aux plantes sauvages des Baronnies : 100% Nature, vivants, riches et concentrés, véritablement actifs sur la peau. Sans ingrédient ou process invasif, fait main en Baronnies. Actifs 100% naturels ou BIO."
    ],
    "nl": [
      "Productie van schoonheids- en huidverzorgingscosmetica op basis van wilde planten uit de Baronnies: 100% natuurlijk, levend, rijk en geconcentreerd, echt actief op de huid. Geen invasieve ingrediënten of processen, handgemaakt in de Baronnies. 100% natuurlijke of biologische actieve ingrediënten."
    ],
    "es": [
      "Fabricación de cosméticos de belleza y cuidado con plantas silvestres de las Baronías: 100% naturales, vivas, ricas y concentradas, verdaderamente activas sobre la piel. Sin ingredientes ni procesos invasivos, hechos a mano en las Baronías. Ingredientes 100% naturales o ecológicos."
    ]
  },
  "rdfs:label": {
