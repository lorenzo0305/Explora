  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, Ihren Urlaub dynamischer zu gestalten und ungewöhnliche und atypische Erfahrungen zu machen? Dann sind Sie hier genau richtig! Explosiver Cocktail aus Aktivitäten für einen aufgedrehten Urlaub in Haute Maurienne Vanoise!"
    ],
    "en": [
      "Want to energize your holidays and live unusual and atypical experiences? You are in the right place ! An explosive cocktail of activities for a hectic holiday in Haute Maurienne Vanoise!"
    ],
    "it": [
      "Volete dare una spinta alle vostre vacanze e vivere esperienze insolite e atipiche? Siete nel posto giusto! Un cocktail esplosivo di attività per una vacanza supercarica nella Haute Maurienne Vanoise!"
    ],
    "fr": [
      "Envie de dynamiser vos vacances et de vivre des expériences insolites et atypiques ? Vous êtes au bon endroit ! Cocktail explosif d’activités pour des vacances survoltées en Haute Maurienne Vanoise !"
    ],
    "es": [
      "¿Quiere potenciar sus vacaciones y vivir experiencias insólitas y atípicas? Has venido al lugar adecuado Un cóctel explosivo de actividades para unas vacaciones supercargadas en Haute Maurienne Vanoise"
    ],
    "nl": [
      "Wilt u uw vakantie energie geven en ongewone en atypische ervaringen beleven? U bent op de juiste plaats! Een explosieve cocktail van activiteiten voor een hectische vakantie in Haute Maurienne Vanoise!"
    ]
  },
