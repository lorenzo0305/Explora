  "rdfs:comment": {
    "de": [
      "Austernpilze und Shitake-Pilze. Unsere extra frischen Champignons sind für den lokalen Vertrieb bestimmt.\r\nWir züchten sie mit guter Laune, was ihnen einen ganz anderen Geschmack verleiht!"
    ],
    "en": [
      "Oyster mushrooms and Shitakes. Our extra-fresh mushrooms are intended for local distribution.\r\nWe grow them in a friendly atmosphere, which gives them a whole new flavor!"
    ],
    "it": [
      "Champiloop, il vostro produttore di funghi biologici e locali.\r\n I nostri funghi freschissimi sono destinati alla distribuzione locale. Li coltiviamo in un'atmosfera amichevole, che conferisce loro un sapore tutto nuovo!"
    ],
    "fr": [
      "Champiloop, votre producteur de champignons bio et locaux.\r\n Nos champignons extra frais sont destinés à une distribution locale. Nous les cultivons dans la bonne humeur, ce qui leur donne une toute autre saveur !"
    ],
    "es": [
      "Setas ostra y Shitakes. Nuestras setas extra frescas están destinadas a la distribución local.\r\nLas cultivamos en un ambiente acogedor, ¡lo que les confiere un sabor totalmente nuevo!"
    ],
    "nl": [
      "Champiloop, uw producent van biologische en lokale champignons.\r\n Onze extra verse champignons zijn bedoeld voor lokale distributie. We kweken ze in een gemoedelijke sfeer, waardoor ze een hele nieuwe smaak krijgen!"
    ]
  },
