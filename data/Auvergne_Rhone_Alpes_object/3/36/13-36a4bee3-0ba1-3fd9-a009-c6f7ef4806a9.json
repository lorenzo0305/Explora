  "rdfs:comment": {
    "de": [
      "Genießen Sie einen Moment des Wohlbefindens in einer mit Holzfeuer beheizten Sauna.\r\nSie ist von Freitag bis Sonntag am Ufer des Lac aux dames in Samoëns installiert und kann den Rest der Woche für ein Erlebnis bei Ihnen zu Hause oder am Ort Ihrer Veranstaltung gemietet werden."
    ],
    "en": [
      "Enjoy a moment of well-being in a wood-fired sauna.\r\nSet up from Friday to Sunday on the shores of Lac aux Dames in Samoens, and available for hire the rest of the week for an experience in your own home or at your event venue."
    ],
    "it": [
      "Godetevi un momento di benessere in una sauna a legna.\r\nAllestita dal venerdì alla domenica sulle rive del Lac aux Dames a Samoëns e disponibile per il noleggio il resto della settimana per un'esperienza a casa vostra o nella sede di un evento."
    ],
    "fr": [
      "Profitez d'un moment de bien être dans un sauna chauffé au feu de bois.\r\nInstallé du vendredi au dimanche au bord du lac aux dames à Samoëns et disponible à la location le reste de la semaine pour une expérience chez vous ou sur le lieu de votre évènement."
    ],
    "nl": [
      "Geniet van een moment van welzijn in een houtgestookte sauna.\r\nOpgezet van vrijdag tot zondag aan de oevers van het Lac aux Dames in Samoens en de rest van de week te huur voor een belevenis bij u thuis of op uw evenementlocatie."
    ],
    "es": [
      "Disfrute de un momento de bienestar en una sauna de leña.\r\nInstalada de viernes a domingo a orillas del Lac aux Dames en Samoëns y disponible en alquiler el resto de la semana para vivir una experiencia en su propia casa o en el lugar de su evento."
    ]
  },
  "rdfs:label": {
