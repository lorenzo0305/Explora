  "rdfs:comment": {
    "de": [
      "Das Gleiten in der Luft in aller Sicherheit, im Tandem mit professionellen Piloten! \r\nErfüllen Sie sich den ältesten Traum des Menschen, unser Team ist da, um Sie bei diesem unvergesslichen Moment zu begleiten und LA PLAGNE zu entdecken."
    ],
    "en": [
      "Enjoy a safe tandem paragliding flight with a professional pilot! \r\nOur team is there to make man's oldest dream comes true and allow you to experience an unforgettable moment discovering La Plagne."
    ],
    "it": [
      "Scivolare nell'aria in tutta sicurezza, in tandem con piloti professionisti!\r\nRealizzate il sogno più antico dell'uomo e il nostro team vi accompagnerà in questo viaggio indimenticabile alla scoperta di LA PLAGNE."
    ],
    "fr": [
      "La glisse aérienne en toute sécurité, en biplace avec des pilotes professionnels ! \r\nRéalisez le plus vieux rêve de l'homme, notre équipe est là pour vous accompagner dans cet inoubliable moment pour découvrir LA PLAGNE ."
    ],
    "es": [
      "¡Deslizarse por el aire con total seguridad, en tándem con pilotos profesionales!\r\nHaga realidad el sueño más antiguo del hombre, y nuestro equipo estará allí para acompañarle en este viaje inolvidable para descubrir LA PLAGNE ."
    ],
    "nl": [
      "In alle veiligheid door de lucht glijden, in een tweezitter met een professionele piloot!  De oudste droom van de mens waar maken...  Ons team is er om u te begeleiden gedurende dit onvergetelijk ogenblik in la Plagne."
    ]
  },
  "rdfs:label": {
