  "rdfs:comment": {
    "de": [
      "Ein sehr schöner Park mit einem tollen Ausblick auf die Rhône. Einige Kinderspiele und eine Bank für eine Pause. Ein gut schattiger Park mit majestätischen Zedern zum Betrachten."
    ],
    "en": [
      "A very pleasant park, with a superb view over the Rhône. A few children's games and a bench for a break. A well-shaded park with majestic cedars to contemplate."
    ],
    "it": [
      "Un parco molto piacevole, con una splendida vista sul Rodano. Alcuni giochi per bambini e una panchina per una pausa. Un parco ben ombreggiato con maestosi cedri da contemplare."
    ],
    "fr": [
      "Un parc très agréable, avec un superbe point de vue sur le Rhône. Quelques jeux d'enfants et banc pour une pause. Un parc bien ombragé avec des cèdres majestueux à contempler."
    ],
    "es": [
      "Un parque muy agradable, con una magnífica vista sobre el Ródano. Algunos juegos infantiles y un banco para descansar. Un parque bien sombreado con majestuosos cedros para contemplar."
    ],
    "nl": [
      "Een heel aangenaam park, met een prachtig uitzicht over de Rhône. Een paar kinderspelletjes en een bankje voor een pauze. Een schaduwrijk park met majestueuze ceders om bij stil te staan."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parc de Bonrepos"
    ]
  },
