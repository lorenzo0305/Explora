  "rdfs:comment": {
    "de": [
      "Das Theatercafé in Rive de Gier, in dem Stand-Up-Comedy, Sketche, Charaktere, aber auch Musik, Pantomime und Zauberei zu finden sind - kurzum, wo man sich gerne trifft und träumt!"
    ],
    "en": [
      "The Café-Théâtre of Rive de Gier, where stand-up, sketches, characters, but also music, mime, magic; in short, where it is good to meet and dream!"
    ],
    "it": [
      "Il Café-Théâtre de Rive de Gier, dove si fanno stand-up, sketch, personaggi, ma anche musica, mimo, magia; insomma, dove è bello incontrarsi e sognare!"
    ],
    "fr": [
      "Le Café-Théâtre de Rive de Gier, où se côtoient stand-up, sketchs, personnages, mais aussi musique, mime, magie; bref, où il fait bon se retrouver et rêver !"
    ],
    "nl": [
      "Het Café-Théâtre de Rive de Gier, waar stand-up, sketches, personages, maar ook muziek, mime, magie; kortom, waar het goed is om elkaar te ontmoeten en te dromen!"
    ],
    "es": [
      "El Café-Théâtre de Rive de Gier, donde se hacen stand-up, sketches, personajes, pero también música, mimo, magia; en definitiva, ¡donde es bueno encontrarse y soñar!"
    ]
  },
