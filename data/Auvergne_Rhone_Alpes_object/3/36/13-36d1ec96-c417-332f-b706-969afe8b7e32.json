  "rdfs:comment": {
    "de": [
      "Die Chevalley-Thermen bieten 18-tägige konventionierte Thermalaufenthalte in den Bereichen Rheumatologie, Phlebologie oder mit doppelter Ausrichtung an.  Entdecken Sie unsere Mini-Kuren von 2 bis 6 Tagen für einen Moment des Wohlbefindens und der Entspannung."
    ],
    "en": [
      "The Thermes Chevalley offer 18-day spa treatments for rheumatology, phlebology or dual orientation.  Discover our mini-cures of 2 to 6 days for a moment of well-being and relaxation."
    ],
    "it": [
      "Le Terme di Chevalley propongono soggiorni termali di 18 giorni in reumatologia, flebologia o a doppio orientamento.  Scoprite le nostre mini-cure da 2 a 6 giorni per un momento di benessere e relax."
    ],
    "fr": [
      "Les Thermes Chevalley  proposent des séjours thermaux conventionnés  de 18 jours en rhumatologie, phlébologie ou en  double orientation.  Découvrez  nos mini-cures de 2 à 6 jours pour un moment de bien-être et de détente."
    ],
    "es": [
      "Las termas de Chevalley ofrecen estancias termales de 18 días en reumatología, flebología o con doble orientación.  Descubra nuestras minicuras de 2 a 6 días para un momento de bienestar y relajación."
    ],
    "nl": [
      "De thermen van Chevalley bieden 18-daagse kuurvakanties in reumatologie, flebologie of met een dubbele oriëntatie.  Ontdek onze minikuren van 2 tot 6 dagen voor een moment van welzijn en ontspanning."
    ]
  },
