    "de": [
      "Kebab aus 100% Kalbfleisch und hausgemachter Spieß aus 100% Halal, wir erwarten Sie zahlreich, um unser Sandwich \"le berliner\" sowie alle unsere Sorten zu probieren!"
    ],
    "en": [
      "100% veal kebab and 100% halal homemade broche, we look forward to seeing you there to taste our \"Berliner\" sandwich and all our other varieties!"
    ],
    "it": [
      "100% kebab di vitello e 100% spiedo artigianale halal, vi aspettiamo per gustare il nostro panino \"Berliner\" e tutte le altre varietà!"
    ],
    "fr": [
      "Kebab 100% veau et broche maison 100% halal, on vous attend nombreux pour déguster notre sandwich \" le berliner\" ainsi que toute nos variétés!"
    ],
    "es": [
      "100% kebab de ternera y 100% espetón casero halal, ¡le esperamos allí para disfrutar de nuestro bocadillo \"berlinés\" y de todas nuestras demás variedades!"
