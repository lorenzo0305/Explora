  "rdfs:comment": {
    "de": [
      "Kommen Sie und entdecken Sie unsere Zwergschweine, Kaninchen, Meerschweinchen, Hühner, Ziegen, Lamas, Schafe, Ponys und Pferde mit ihren Fohlen. Sie können sie füttern, streicheln und spazieren führen - zur Freude von Groß und Klein!"
    ],
    "en": [
      "Enjoy a moment with our miniature pigs, rabbits, guinea pigs, chickens, goats, llama, sheeps, ponies, horses with their foals. You can feed and pet them and walk along with them as well."
    ],
    "it": [
      "Venite a scoprire i nostri maialini nani, conigli, porcellini d'India, galline, capre, lama, pecore, pony e cavalli con i loro puledri. Potrete dar loro da mangiare, accarezzarli e portarli a fare un giro, per la gioia di grandi e piccini!"
    ],
    "fr": [
      "Venez découvrir nos cochons nains, lapins, cochons d'Inde, poules, chèvres, lama, moutons, poneys, chevaux avec leurs poulains. Vous pourrez les nourrir, les caresser et les balader pour le bonheur des petits et des grands !"
    ],
    "es": [
      "Venga a descubrir nuestros cerdos enanos, conejos, cobayas, gallinas, cabras, llamas, ovejas, ponis y caballos con sus potros. Podrás darles de comer, acariciarlos y pasear con ellos, ¡para deleite de pequeños y mayores!"
    ],
    "nl": [
      "Kom en ontdek onze dwergvarkens, konijnen, cavia's, kippen, geiten, lama's, schapen, pony's en paarden met hun veulens. Je kunt ze voeren, aaien en een ritje met ze maken, tot groot genoegen van jong en oud!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Educational farm - Les poneys de la Durme"
    ],
    "fr": [
      "Ferme pédagogique - Les poneys de la Durme"
    ]
  },
