  "rdfs:comment": {
    "de": [
      "Am Fuße der Langlauf- und Schneeschuhpisten, in einem neuen Raum mit gemütlicher Atmosphäre, entdecken Sie unsere Snackangebote, die Sie vor Ort genießen oder mitnehmen können!"
    ],
    "en": [
      "At the foot of the cross-country skiing and snowshoeing trails, in a new room with a warm ambience, come and discover our snacking proposals to eat in or take away!"
    ],
    "it": [
      "Ai piedi delle piste per lo sci di fondo e le racchette da neve, in un nuovo locale dall'atmosfera accogliente, venite a scoprire la nostra offerta di spuntini da consumare o da portare via!"
    ],
    "fr": [
      "Au pied des pistes de ski de fond et de raquettes, dans une nouvelle salle à l’ambiance chaleureuse, venez découvrir nos propositions de snacking à déguster sur place ou à emporter !"
    ],
    "es": [
      "Al pie de las pistas de esquí de fondo y de raquetas de nieve, en una nueva sala de ambiente cálido, venga a descubrir nuestra oferta de tentempiés para comer en casa o para llevar"
    ],
    "nl": [
      "Aan de voet van de langlauf- en sneeuwschoenpaden, in een nieuwe ruimte met een warme sfeer, kunt u kennismaken met ons assortiment snacks om te eten of mee te nemen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Petit Écureuil"
    ]
  },
