  "rdfs:comment": {
    "de": [
      "Er befindet sich in der Nähe der Tennisplätze in der Avenue Danton und besteht aus drei miteinander verbundenen Pisten, auf denen Mountainbikes, BMX-Räder, Roller, Inlineskates und Skateboards gefahren werden können."
    ],
    "en": [
      "Located not far from the tennis courts on Avenue Danton, it features three interconnected tracks for mountain biking, BMX, scootering, rollerblading and skateboarding."
    ],
    "it": [
      "Situato non lontano dai campi da tennis di Avenue Danton, comprende tre piste interconnesse per mountain bike, BMX, monopattino, rollerblade e skateboard."
    ],
    "fr": [
      "Situé non loin des terrains de tennis, Avenue Danton, il se compose de trois pistes, interconnectées, et permettant l’évolution en VTT, BMX, Trottinette, Roller, et Skateboard."
    ],
    "es": [
      "Situado no lejos de las pistas de tenis de la avenida Danton, consta de tres pistas interconectadas para bicicleta de montaña, BMX, patinetes, roller y monopatín."
    ],
    "nl": [
      "Het ligt niet ver van de tennisbanen aan de Avenue Danton en bestaat uit drie met elkaar verbonden banen voor mountainbiken, BMX, steppen, skeeleren en skateboarden."
    ]
  },
  "rdfs:label": {
