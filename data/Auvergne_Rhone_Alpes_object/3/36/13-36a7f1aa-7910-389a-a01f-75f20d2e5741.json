  "rdfs:comment": {
    "de": [
      "Begleitete Wanderungen , ein ununterbrochenes Programm von Wanderungen, um die Liebhaber von Wanderwegen zufrieden zu stellen, mindestens 3 Wanderungen pro Woche, halbtags, ganztags, sportliche Ausflüge und mehrtägige Eskapaden."
    ],
    "en": [
      "Accompanied hikes, an uninterrupted program of hikes to satisfy the amateurs of pedestrian courses, a minimum of 3 walks per week in half-day, full-day, sports outings, and escapade of several days."
    ],
    "it": [
      "Passeggiate accompagnate, un programma ininterrotto di passeggiate per tutti gli appassionati, con un minimo di 3 passeggiate a settimana in mezza giornata, giornata intera, escursioni sportive e di più giorni."
    ],
    "fr": [
      "Randonnées pédestres accompagnées , un programme ininterrompu de randonnées pour satisfaire les amateurs de parcours pédestres, un minimum de 3 balades par semaine en demi-journée, journée, sorties sportives, et escapade de plusieurs jours."
    ],
    "es": [
      "Paseos acompañados, un programa ininterrumpido de paseos que se adaptan a todos los aficionados al senderismo, un mínimo de 3 paseos por semana en excursiones de medio día, de un día entero, deportivas y de varios días."
    ],
    "nl": [
      "Begeleide wandelingen, een ononderbroken programma voor alle wandelliefhebbers, minimaal 3 wandelingen per week in halve dagen, hele dagen, sportieve en meerdaagse tochten."
    ]
  },
