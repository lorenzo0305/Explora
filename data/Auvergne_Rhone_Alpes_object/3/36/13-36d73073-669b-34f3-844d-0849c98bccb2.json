  "rdfs:comment": {
    "de": [
      "Vielleicht treffen Sie hinter einer Kurve auf kleine Nagetiere, die den Wald bevölkern: Eichhörnchen!"
    ],
    "en": [
      "You may come across small rodents that inhabit the forest at the bend in the road: squirrels!"
    ],
    "it": [
      "In curva potreste imbattervi in alcuni dei piccoli roditori che popolano la foresta: gli scoiattoli!"
    ],
    "fr": [
      "Vous croiserez peut-être de petits rongeurs qui peuplent la forêt au détour d'un virage : les écureuils !"
    ],
    "es": [
      "Es posible que al doblar una curva se cruce con alguno de los pequeños roedores que habitan el bosque: ¡las ardillas!"
    ],
    "nl": [
      "Als u een bocht omgaat, kunt u kleine knaagdieren tegenkomen die in het bos leven: eekhoorns!"
    ]
  },
  "rdfs:label": {
