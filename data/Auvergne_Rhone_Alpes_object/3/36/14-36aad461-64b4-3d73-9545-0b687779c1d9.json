  "rdfs:comment": {
    "de": [
      "Der Trompeter und Sänger ist der neue Chet Baker, von dem Robin sich inspirieren lässt... Er nimmt uns mit seinem charmanten Quintett, das aus großen Solisten besteht, mit auf die Spuren des charmanten Jazz, den wir alle lieben!"
    ],
    "en": [
      "A trumpeter and singer, Robin is the new Chet Baker, and with his charming quintet of great soloists, he takes us on a journey in the footsteps of the charming jazz we all love!"
    ],
    "it": [
      "Trombettista e cantante, Robin si ispira al nuovo Chet Baker... Con il suo affascinante quintetto di grandi solisti, ci porta in giro per il jazz affascinante che tutti amiamo!"
    ],
    "fr": [
      "Trompettiste, chanteur, c’est le nouveau Chet Baker dont Robin s’inspire…Il nous emmène, avec son quintet de charme formé de grands solistes, sur les traces de ce jazz de charme que nous aimons tous !"
    ],
    "es": [
      "Trompetista y cantante, Robin se inspira en el nuevo Chet Baker... Con su encantador quinteto de grandes solistas, ¡nos lleva de gira por el encantador jazz que todos amamos!"
    ],
    "nl": [
      "Robin is trompettist en zanger en laat zich inspireren door de nieuwe Chet Baker... Met zijn charmante kwintet van geweldige solisten neemt hij ons mee op een tournee langs de charmante jazz waar we allemaal van houden!"
    ]
  },
  "rdfs:label": {
