  "rdfs:comment": {
    "de": [
      "Am Fuße der Kirche laden Sie Sabrina MALOT und Ludovic DUPUIS, die Besitzer des Restaurants Plaisir des Sens in Chemilly, zu einem Moment der Entspannung und Gemütlichkeit bei eleganter Küche ein."
    ],
    "en": [
      "At the foot of the church, Sabrina MALOT and Ludovic DUPUIS, the owners of the restaurant Plaisir des Sens in Chemilly, invite you to a moment of relaxation and comfort around an elegant cuisine."
    ],
    "it": [
      "Ai piedi della chiesa, Sabrina MALOT e Ludovic DUPUIS, proprietari del ristorante Plaisir des Sens di Chemilly, vi invitano a rilassarvi e a godervi un momento di comfort attorno a una cucina elegante."
    ],
    "fr": [
      "Au pied de l'église, Sabrina MALOT et Ludovic DUPUIS, les propriétaires du restaurant Plaisir des Sens à Chemilly, vous convient à un moment de relaxation et de confort autour d'une cuisine élégante."
    ],
    "nl": [
      "Aan de voet van de kerk nodigen Sabrina MALOT en Ludovic DUPUIS, de eigenaars van het restaurant Plaisir des Sens in Chemilly, u uit om te ontspannen en te genieten van een moment van comfort rond een elegante keuken."
    ],
    "es": [
      "A los pies de la iglesia, Sabrina MALOT y Ludovic DUPUIS, propietarios del restaurante Plaisir des Sens de Chemilly, le invitan a relajarse y a disfrutar de un momento de confort en torno a una cocina elegante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plaisir des Sens"
    ]
