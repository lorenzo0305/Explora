  "rdfs:comment": {
    "de": [
      "Entdecken Sie La Falaise in Le Bourg-d'Oisans: eine einladende Pizzeria für Gruppen, die auch Rollstuhlfahrern den Zugang ermöglicht. Genießen Sie unseren schattigen Garten, die Terrasse und die Konzerte vor Ort. Haustiere sind willkommen."
    ],
    "en": [
      "Discover La Falaise in Le Bourg-d'Oisans: a group-friendly pizzeria with wheelchair access. Enjoy our shady garden, terrace and live music. Pets welcome."
    ],
    "it": [
      "Scoprite La Falaise a Le Bourg-d'Oisans: una pizzeria per gruppi con accesso per sedie a rotelle. Godetevi il nostro giardino ombreggiato, la terrazza e la musica dal vivo. Gli animali domestici sono i benvenuti."
    ],
    "fr": [
      "Découvrez La Falaise à Le Bourg-d'Oisans : une pizzeria accueillante pour les groupes, permettant l'accès aux fauteuils roulants. Profitez de notre jardin ombragé, terrasse et concerts sur place. Animaux bienvenus."
    ],
    "nl": [
      "Ontdek La Falaise in Le Bourg-d'Oisans: een groepsvriendelijke pizzeria die toegankelijk is voor rolstoelgebruikers. Geniet van onze schaduwrijke tuin, terras en livemuziek. Huisdieren welkom."
    ],
    "es": [
      "Descubra La Falaise en Le Bourg-d'Oisans: una pizzería para grupos con acceso para sillas de ruedas. Disfrute de nuestro jardín sombreado, terraza y música en directo. Se admiten mascotas."
    ]
  },
