  "rdfs:comment": {
    "de": [
      "Beheizter und klimatisierter Indoor-Freizeitpark mit zahlreichen Trampolinflächen.\r\nAb 6 Jahren können Sie alleine oder mit Freunden springen und von unseren verschiedenen Aktivitäten, unseren Geburtstagsformeln sowie einem Snacking-Service vor Ort profitieren"
    ],
    "en": [
      "Indoor leisure park, heated and air-conditioned, with many trampoline areas.\r\nFrom 6 years old, come jumper alone or with friends and enjoy our various activities, our birthday packages as well as a snack service on site"
    ],
    "it": [
      "Parco divertimenti al coperto, riscaldato e climatizzato, con numerose aree di trampolino.\r\nA partire dai 6 anni, venite a saltare da soli o con gli amici e godetevi le nostre varie attività, i pacchetti compleanno e il servizio merenda in loco"
    ],
    "fr": [
      "Parc de loisirs indoor, chauffé et climatisé, avec de nombreux espaces de trampolines.\r\nDès 6 ans, viens jumper seul ou entre amis et profite de nos diverses activités, de nos formules anniversaires ainsi que d’un service de snacking sur place"
    ],
    "nl": [
      "Vrijetijdspark binnen, verwarmd en voorzien van airconditioning, met veel trampolinegebieden.\r\nKom vanaf 6 jaar alleen of met vrienden jumper en geniet van onze verschillende activiteiten, onze verjaardagspakketten en een snackservice ter plaatse"
    ],
    "es": [
      "Parque de ocio cubierto, climatizado, con numerosas zonas de camas elásticas.\r\nA partir de los 6 años, ven a saltar solo o con amigos y disfruta de nuestras diversas actividades, paquetes de cumpleaños y servicio de merienda in situ"
    ]
  },
