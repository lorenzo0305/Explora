      "dc:description": {
        "de": [
          "Erfahrener Automechaniker mit einer Leidenschaft für die Kunst, alten Modellen neues Leben einzuhauchen, mit einer besonderen Spezialisierung auf die Wartung von Ferrari und Maserati"
        ],
        "en": [
          "Experienced car mechanic with a passion for bringing old models back to life, with a particular focus on Ferrari and Maserati maintenance"
        ],
        "it": [
          "Meccanico esperto con la passione di riportare in vita vecchi modelli, specializzato nella manutenzione di Ferrari e Maserati"
        ],
        "fr": [
          "Mécanicien automobile expérimenté et passionné par l’art de redonner vie aux modèles anciens, avec une spécialisation particulière pour l’entretien des Ferrari et Maserati"
        ],
        "es": [
          "Mecánico de coches con experiencia y pasión por devolver la vida a modelos antiguos, especializado en el mantenimiento de Ferraris y Maseratis"
        ],
        "nl": [
          "Ervaren automonteur met een passie voor het weer tot leven brengen van oude modellen, gespecialiseerd in het onderhouden van Ferrari's en Maserati's"
        ]
      },
