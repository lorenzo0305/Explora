  "rdfs:comment": {
    "de": [
      "Als Spezialist für Canyoning-Aktivitäten in der Region Annecy in Hochsavoyen bietet Ihnen Terréo abwechslungsreiche Strecken, die dem Niveau und der Motivation jedes Einzelnen angepasst sind. Terréo bietet Ihnen auch Klettersteige, Höhlenforschung und Wanderungen an!"
    ],
    "en": [
      "Specializing in canyoning in the Annecy region of Haute Savoie, Terréo offers you a variety of routes, adapted to your level and motivations. Terréo also offers via ferrata, caving and trekking!"
    ],
    "it": [
      "Specializzato nel canyoning nella regione di Annecy, in Alta Savoia, Terréo offre una varietà di percorsi adatti a tutti i livelli e a tutte le motivazioni. Terréo offre anche vie ferrate, speleologia ed escursioni!"
    ],
    "fr": [
      "Spécialiste de l’activité canyoning dans la région d’Annecy en Haute Savoie, Terréo vous propose des parcours variés, adaptés au niveau et aux motivations de chacun. Terréo vous propose également de la via ferrata, de la spéléologie et de la randonnée !"
    ],
    "nl": [
      "Terréo is gespecialiseerd in canyoning in de regio Annecy in de Haute Savoie en biedt verschillende routes voor alle niveaus en motivaties. Terréo biedt ook via ferrata, speleologie en wandelen!"
    ],
    "es": [
      "Especializado en barranquismo en la región de Annecy, en Alta Saboya, Terréo propone recorridos variados para todos los niveles y motivaciones. Terréo también ofrece vías ferratas, espeleología y senderismo"
    ]
  },
