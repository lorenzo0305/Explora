  "rdfs:comment": {
    "de": [
      "Das Viù beeindruckt mit einer Panoramaaussicht auf den See und die Berge und bietet eine optisch ansprechende Küche mit leichten Geschmacksnoten an."
    ],
    "en": [
      "Le Viù offers an exceptional direct panoramic view of the lake and mountains, offering beautifully presented cuisine with light flavours."
    ],
    "it": [
      "Il ristorante gourmet del Palace de Menthon vi accompagnerà in un viaggio magico. Con la sua sublime vista panoramica sul lago di Annecy, vi stupirà la bellezza del paesaggio circostante."
    ],
    "fr": [
      "Le restaurant gastronomique du Palace de Menthon vous fait voyager le temps d'un instant. Avec sa sublime vue panoramique sur le Lac d'Annecy, vous serez émerveillés par la beauté du paysage environnant."
    ],
    "nl": [
      "Het gastronomische restaurant van Palace de Menthon neemt je mee op een magische reis. Met zijn sublieme panoramische uitzicht over het meer van Annecy zul je je verbazen over de schoonheid van het omringende landschap."
    ],
    "es": [
      "El restaurante gastronómico del Palace de Menthon le lleva de viaje por un momento. Con su sublime vista panorámica sobre el lago de Annecy, le sorprenderá la belleza del paisaje circundante."
    ]
  },
