  "rdfs:comment": {
    "de": [
      "Die Foire Gourmande ist im Mai wieder da.\r\nErleben Sie mit Ihrer Familie oder Ihren Freunden ein einzigartiges, geselliges, originelles und verbindendes Erlebnis."
    ],
    "en": [
      "The Foire Gourmande is back in May.\r\nCome and enjoy a unique, convivial, original and unifying experience with family and friends."
    ],
    "it": [
      "La Foire Gourmande torna a maggio.\r\nVenite a vivere un'esperienza unica, conviviale, originale e unificante con la vostra famiglia o i vostri amici."
    ],
    "fr": [
      "La Foire Gourmande est de retour en mai.\r\nVenez vivre une expérience unique, conviviale, originale et fédératrice en famille ou entre amis."
    ],
    "es": [
      "La Foire Gourmande vuelve en mayo.\r\nVenga a disfrutar en familia o con amigos de una experiencia única, convivial, original y unificadora."
    ],
    "nl": [
      "De Foire Gourmande is terug in mei.\r\nKom samen met je gezin of vrienden genieten van een unieke, gezellige, originele en bindende ervaring."
    ]
  },
