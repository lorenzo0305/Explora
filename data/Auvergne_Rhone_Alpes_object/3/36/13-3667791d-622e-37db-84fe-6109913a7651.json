  "rdfs:comment": {
    "de": [
      "Crémant, Clairette de Die, stille Weine aus Chardonnay und Syrah, Winzer seit 4 Generationen in Bio-Qualität. Besichtigung des Weinkellers, Verkostung der Weine des Weinguts. Ausstellung von Weinpressen, Werkzeugen des Winzers. Mitglied von France Passion."
    ],
    "en": [
      "Crémant, Clairette de Die and still wines in Chardonnay & Syrah Bio. Winegrowers for 4 generations, in organic agriculture. Visit our wineries and taste our wines. Come and see old presses and winemakers' tools. France Passion camper vans welcome."
    ],
    "it": [
      "Crémant, Clairette de Die, vini fermi da Chardonnay e Syrah, viticoltori biologici da 4 generazioni. Visita della cantina e degustazione dei vini della tenuta. Esposizione di torchi e strumenti di vinificazione. Membro di France Passion."
    ],
    "fr": [
      "Crémant, Clairette de Die, vins tranquilles en Chardonnay et Syrah, vignerons depuis 4 générations en Agriculture Biologique. Visite de la cave, dégustation des crus du domaine. Exposition de pressoirs, outils du vigneron. Adhérent France Passion."
    ],
    "es": [
      "Crémant, Clairette de Die, vinos tranquilos de Chardonnay y Syrah, viticultores ecológicos desde hace 4 generaciones. Visita de la bodega y degustación de los vinos de la finca. Exposición de prensas y herramientas de vinificación. Miembro de France Passion."
    ],
    "nl": [
      "Crémant en Clairette de Die Bio, al 4 generaties lang wijnbouwers. Bezoek aan de boerderij en proeverij van de cruwijnen van het domein. Tentoonstelling van de persmachines en de werktuigen van de wijnboer. Aangesloten bij France Passion."
    ]
  },
