  "rdfs:comment": {
    "de": [
      "Der Verein Arc en Ciel Aac Tricastin freut sich, Ihnen auf seiner 59. Frühjahrsmesse die neuesten Werke seiner Mitglieder vorstellen zu können. Etwa 45 Maler werden ihre Bilder ausstellen, darunter Ölgemälde, Pastelle und Aquarelle."
    ],
    "en": [
      "For its 59th spring show, the Arc en Ciel Aac Tricastin association is pleased to present the latest works by its members. Some 45 painters will be exhibiting their oil paintings, pastels and watercolors."
    ],
    "it": [
      "Per la sua 59ª mostra di primavera, l'associazione Arc en Ciel Aac Tricastin è lieta di presentare le ultime opere dei suoi membri. Circa 45 pittori esporranno i loro dipinti a olio, pastelli e acquerelli."
    ],
    "fr": [
      "Pour le 59ème salon de printemps, l’association Arc en Ciel Aac Tricastin a le plaisir de vous présenter les dernières œuvres de ses adhérents. Environ 45 peintres exposeront leurs tableaux en peinture à l’huile, pastels, aquarelles."
    ],
    "es": [
      "En su 59ª exposición de primavera, la asociación Arc en Ciel Aac Tricastin se complace en presentar las últimas obras de sus miembros. Unos 45 pintores expondrán sus óleos, pasteles y acuarelas."
    ],
    "nl": [
      "De vereniging Arc en Ciel Aac Tricastin presenteert voor haar 59e voorjaarstentoonstelling de nieuwste werken van haar leden. Ongeveer 45 schilders zullen hun olieverfschilderijen, pastels en aquarellen tentoonstellen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "59ème Salon de Peinture"
    ]
  },
