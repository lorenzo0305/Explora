  "rdfs:comment": {
    "de": [
      "Das Golftrainingszentrum in Veigy verfügt über eine der größten Driving Ranges des Departements, 220 Meter lang, auf der bis zu 30 Spieler gleichzeitig spielen können."
    ],
    "en": [
      "The Veigy golf training center boasts one of the department's largest driving ranges, 220 meters long and able to accommodate up to 30 players at a time."
    ],
    "it": [
      "Il centro di formazione golfistica di Veigy dispone di uno dei più grandi campi pratica del dipartimento, lungo 220 metri e in grado di ospitare fino a 30 giocatori alla volta."
    ],
    "fr": [
      "Le centre d’entrainement de golf de Veigy possède l’un des plus grand practice du département, 220 mètres de long pouvant accueillir jusqu’à 30 joueurs en même temps."
    ],
    "nl": [
      "Het golftrainingscentrum van Veigy heeft een van de grootste driving ranges van het departement, 220 meter lang en geschikt voor maximaal 30 spelers tegelijk."
    ],
    "es": [
      "El centro de entrenamiento de golf de Veigy dispone de uno de los campos de prácticas más grandes del departamento, con 220 metros de longitud y capacidad para 30 jugadores a la vez."
    ]
  },
