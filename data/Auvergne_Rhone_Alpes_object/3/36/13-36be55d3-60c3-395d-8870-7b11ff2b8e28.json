  "rdfs:comment": {
    "de": [
      "Sie suchen authentische Natur? Willkommen in der \"Auberge de Grange Rouet\". Herzhafte Küche und freundlicher Empfang. Ein kleines Fleckchen Paradies, das seinen ursprünglichen Charme bewahrt hat."
    ],
    "en": [
      "Are you looking for an authentic rural setting? Welcome to the Auberge de Grange Rouet. Hearty cooking and a warm welcome. A little piece of heaven that has kept its old-fashioned charm."
    ],
    "it": [
      "Siete alla ricerca di una natura autentica? Benvenuti all'Auberge de Grange Rouet. Una cucina calda e un'accoglienza cordiale. Un piccolo angolo di paradiso che ha conservato il suo fascino antico."
    ],
    "fr": [
      "Vous êtes en quête de nature authentique? Bienvenue à l'Auberge de Grange Rouet. Une cuisine chaleureuse et un accueil convivial. Un petit coin de paradis qui a conservé son charme d'antan."
    ],
    "es": [
      "¿Busca una naturaleza auténtica? Bienvenido al Auberge de Grange Rouet. Una cocina cálida y una acogida amable. Un pequeño rincón del paraíso que ha conservado su encanto de antaño."
    ],
    "nl": [
      "Bent u op zoek naar authentieke natuur? Welkom in de Auberge de Grange Rouet. Een warme keuken en een vriendelijk onthaal. Een klein stukje paradijs dat zijn ouderwetse charme heeft behouden."
    ]
  },
