  "rdfs:comment": {
    "de": [
      "Nur 40 Minuten von Lyon entfernt können Sie im Wam Park frische Luft schnappen ! Die Freizeitanlage bietet Ihnen einen Strand und eine Vielzahl von Aktivitäten für einen entspannten Tag mit der Familie oder mit Freunden!"
    ],
    "en": [
      "Just 40 minutes from Lyon, come and get some fresh air at Wam Park ! The leisure park offers a beach and a host of activities for a relaxing day out with family and friends!"
    ],
    "it": [
      "A soli 40 minuti da Lione, venite a prendere un po' d'aria fresca al Wam Park! Il centro ricreativo offre una spiaggia e una serie di attività per una giornata rilassante in famiglia o con gli amici!"
    ],
    "fr": [
      "À seulement 40 minutes de Lyon, venez prendre l'air au Wam Park ! La base de loisirs vous permet de profiter d'une plage et d'une multitudes d'activités pour une journée de détente en famille ou entre amis !"
    ],
    "nl": [
      "Kom op 40 minuten van Lyon een frisse neus halen in Wam Park! Het recreatiecentrum biedt een strand en tal van activiteiten voor een ontspannen dagje uit met familie of vrienden!"
    ],
    "es": [
      "A sólo 40 minutos de Lyon, venga a tomar el aire en Wam Park El centro de ocio ofrece una playa y numerosas actividades para pasar un día relajado en familia o entre amigos"
    ]
  },
