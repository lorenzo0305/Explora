  "rdfs:comment": {
    "de": [
      "Besuch der Werkstatt-Boutique, Demonstration der verschiedenen Etappen der Verarbeitung der Wolle unserer Schafzucht (Waschen, Kardieren, Spinnen, Filzen, Matratzen, Weben usw.)."
    ],
    "en": [
      "Visit of the workshop-boutique, demonstration of the different stages of the transformation of the wool of our ewe breeding (washing, carding, spinning, felting, quilting, weaving, etc...)."
    ],
    "it": [
      "Visita del laboratorio-bottega, dimostrazione delle diverse fasi di trasformazione della lana proveniente dal nostro allevamento di pecore (lavaggio, cardatura, filatura, infeltrimento, trapuntatura, tessitura, ecc.)"
    ],
    "fr": [
      "Visite de l'atelier-boutique, démonstration des différentes étapes de la transformation de la laine de notre élevage de brebis (lavage, cardage, filage, feutre, matelassage, tissage, etc...)."
    ],
    "es": [
      "Visita del taller-boutique, demostración de las diferentes etapas de la transformación de la lana de nuestra granja de ovejas (lavado, cardado, hilado, afieltrado, acolchado, tejido, etc.)."
    ],
    "nl": [
      "Bezoek aan de werkplaats-boetiek, demonstratie van de verschillende stadia van de verwerking van de wol van onze schapenboerderij (wassen, kaarden, spinnen, vilten, quilten, weven, enz.)."
    ]
  },
