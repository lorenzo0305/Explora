  "rdfs:comment": {
    "de": [
      "Das Génissieux Judo präsentiert seinen Saint-Patrick-Abend, zu dem Sie zahlreich erwartet werden! Auf dem Programm stehen ein Pub-Abend, kleine Snacks und ein Konzert der Gruppe The Comments."
    ],
    "en": [
      "Génissieux Judo presents its St. Patrick's Day party, and we look forward to seeing you there! On the program: pub night, light refreshments and a concert by The Comments."
    ],
    "it": [
      "Il Judo Génissieux presenta la sua festa di San Patrizio, e speriamo di vedervi numerosi! In programma: serata pub, rinfresco e concerto dei The Comments."
    ],
    "fr": [
      "Le Génissieux Judo présente sa soirée Saint-Patrick auquel vous êtes attendus nombreux ! Au programme : soirée pub, petite restauration et concert du groupe The Comments."
    ],
    "nl": [
      "Génissieux Judo presenteert haar St. Patrick's Day feest, en we hopen veel van jullie daar te zien! Op het programma: pubavond, lichte versnaperingen en een concert door The Comments."
    ],
    "es": [
      "El Judo de Génissieux presenta su fiesta de San Patricio, ¡y esperamos veros a muchos de vosotros! En el programa: noche de pub, refrescos y un concierto de The Comments."
    ]
  },
