  "rdfs:comment": {
    "de": [
      "Werden Sie an einem halben Tag zum Musher Ihres eigenen Gespanns! Sie werden lernen, Ihren Schlitten und Ihre Hunde zu lenken und zu kontrollieren."
    ],
    "en": [
      "For half a day, become the musher of your own dog sled team! You will learn how to steer and control your sled and your dogs."
    ],
    "it": [
      "Per mezza giornata, diventate i musher della vostra squadra! Imparerete a guidare e controllare la slitta e i cani."
    ],
    "fr": [
      "Le temps d’une demi-journée, devenez le musher de votre propre attelage ! Vous apprendrez à diriger et à contrôler votre traîneau ainsi que vos chiens."
    ],
    "nl": [
      "Word een halve dag lang musher van uw eigen hondenslee! U leert hoe u uw slee en uw honden moet besturen en controleren."
    ],
    "es": [
      "Durante medio día, conviértete en el musher de tu propio equipo Aprenderás a dirigir y controlar tu trineo y tus perros."
    ]
  },
