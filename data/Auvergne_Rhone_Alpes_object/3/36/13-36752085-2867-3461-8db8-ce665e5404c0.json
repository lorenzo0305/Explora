  "rdfs:comment": {
    "de": [
      "Courtepaille empfängt Sie in einer rustikalen Umgebung, in der Sie gesellige Momente verbringen können. Genießen Sie gegrillte Fleischgerichte und Mahlzeitteller.\r\nWeinbarbereich mit Brettern und Pizza für ein Glas mit Freunden oder ein schnelles Essen."
    ],
    "en": [
      "Courtepaille welcomes you in a rustic setting to share convivial moments. Enjoy grilled meats and meal platters.\r\nWine bar with planks and pizza for a drink with friends or a quick bite to eat."
    ],
    "it": [
      "Courtepaille vi accoglie in un ambiente rustico per condividere momenti conviviali. Gustate carni alla griglia e piatti unici.\r\nEnoteca con tavole e pizza per un drink con gli amici o un boccone veloce."
    ],
    "fr": [
      "Courtepaille vous accueille dans un cadre rustique pour partager des moments de convivialités. Vous profiterez des grillades de viandes et d’assiettes-repas.\r\nEspace bar à vin avec planches et pizza  pour boire un verre entre amis ou manger sur le pouce."
    ],
    "nl": [
      "Courtepaille verwelkomt je in een rustieke omgeving om gezellige momenten te delen. Geniet van gegrild vlees en maaltijdschotels.\r\nWijnbar met planken en pizza voor een drankje met vrienden of een snelle hap."
    ],
    "es": [
      "Courtepaille le acoge en un marco rústico para compartir momentos de convivencia. Disfrute de carnes a la parrilla y platos combinados.\r\nWine bar con tablas y pizza para tomar una copa con los amigos o comer algo rápido."
    ]
  },
