  "rdfs:comment": {
    "de": [
      "Unser Reisebüro Havas Voyages Valence | Espace Club Med steht zu Ihren Diensten, um Sie zu beraten, Ihnen das beste Gehör zu schenken und Sie sicher bei all Ihren Reiseplänen zu begleiten."
    ],
    "en": [
      "Our travel agency Havas Voyages Valence | Espace Club Med is at your service to advise you, offer you the best listening and accompany you safely in all your travel plans."
    ],
    "it": [
      "La nostra agenzia di viaggi Havas Voyages Valence | Espace Club Med è al vostro servizio per consigliarvi, offrirvi il miglior ascolto e accompagnarvi in tutta sicurezza in tutti i vostri programmi di viaggio."
    ],
    "fr": [
      "Notre agence de voyages Havas Voyages Valence | Espace Club Med est à votre service pour vous conseiller, vous offrir la meilleure écoute et vous accompagner en toute sécurité dans tous vos projets de voyage."
    ],
    "nl": [
      "Ons reisbureau Havas Voyages Valence | Espace Club Med staat voor je klaar om je te adviseren, je de beste aanbiedingen te doen en je veilig te begeleiden bij al je reisplannen."
    ],
    "es": [
      "Nuestra agencia de viajes Havas Voyages Valence | Espace Club Med está a su servicio para aconsejarle, ofrecerle la mejor escucha y acompañarle con seguridad en todos sus planes de viaje."
    ]
  },
