  "rdfs:comment": {
    "de": [
      "PV ist der Treffpunkt zwischen Stand-up, Charakter und Improvisation, er ist ebenso lustig wie berührend! Lassen Sie sich von seiner überbordenden und überraschenden Vorstellungskraft mitreißen!"
    ],
    "en": [
      "PV is the meeting point between stand-up, character and improvisation, and is as funny as he is touching! Let yourself be swept away by his overflowing and surprising imagination!"
    ],
    "it": [
      "PV è il luogo in cui si incontrano stand-up, caratterizzazione e improvvisazione, ed è tanto divertente quanto commovente! Lasciatevi trasportare dalla sua straripante e sorprendente immaginazione!"
    ],
    "fr": [
      "PV est le point de rencontre entre stand-up, personnage et improvisation, ils est aussi drôle que touchant ! Laisser vous emporter dans son imaginaire débordant et surprenant !"
    ],
    "nl": [
      "PV is waar stand-up, karakterisering en improvisatie samenkomen, en hij is even grappig als ontroerend! Laat je meeslepen door zijn overvolle en verrassende fantasie!"
    ],
    "es": [
      "PV es el punto de encuentro entre el stand-up, la caracterización y la improvisación, ¡y es tan divertido como conmovedor! ¡Déjate llevar por su imaginación desbordante y sorprendente!"
    ]
  },
