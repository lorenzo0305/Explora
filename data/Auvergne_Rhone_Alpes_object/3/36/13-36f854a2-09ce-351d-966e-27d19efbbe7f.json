  "rdfs:comment": {
    "de": [
      "Traditionelles Bistro mit hausgemachten, großzügigen, einfachen und saisonalen Gerichten ? die in einer freundlichen Atmosphäre serviert werden.\r\nJeden Dienstag durchgehende Bewirtung von 9 bis 15 Uhr: Lassen Sie sich den marktfrischen Teller zur gewünschten Zeit schmecken."
    ],
    "en": [
      "Traditional bistro with generous, simple, seasonal home cooking? served in a friendly atmosphere.\r\nEvery Tuesday from 9 a.m. to 3 p.m.: come and enjoy the market plate at a time that suits you."
    ],
    "it": [
      "Bistrot tradizionale che serve una cucina casalinga generosa, semplice e di stagione in un'atmosfera amichevole.\r\nOgni martedì dalle 9.00 alle 15.00: venite a gustare il nostro piatto del mercato all'ora che preferite."
    ],
    "fr": [
      "Bistro traditionnel avec une cuisine maison, généreuse, simple et de saison – servie dans une ambiance conviviale. \r\nTous les mardis restauration en continue de 9h à 15h : venez vous régaler avec l'assiette du marché  à l’heure qui vous convient."
    ],
    "nl": [
      "Traditionele bistro waar royale, eenvoudige seizoensgebonden huisgemaakte gerechten worden geserveerd in een vriendelijke sfeer.\r\nElke dinsdag van 9 tot 15 uur: kom genieten van onze marktschotel op een moment dat het jou uitkomt."
    ],
    "es": [
      "Bistro tradicional que sirve una cocina casera, generosa, sencilla y de temporada en un ambiente agradable.\r\nTodos los martes de 9:00 a 15:00: venga a degustar nuestro plato de mercado a la hora que más le convenga."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistro de la fontaine"
    ]
  },
