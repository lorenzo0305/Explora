  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d659eeb5-4899-3d4b-b354-cad721ab67b2",
      "dc:description": {
        "de": [
          "Eine Wanderung ab dem Dorf Villers-au-Bois zur Entdeckung der angenehmen Landschaften des Artois zwischen Ebenen und bewaldeten, geschützten Hängen, die als Naturgebiet von ökologischem, faunistischem und floristischem Interesse klassifiziert sind."
        ],
        "en": [
          "A walk starting from the village of Villers-au-Bois to discover the pleasant Artois landscapes between plains and wooded hillsides, preserved and classified as a natural zone of ecological, faunistic and floristic interest."
        ],
        "it": [
          "Una passeggiata che parte dal villaggio di Villers-au-Bois per scoprire gli ameni paesaggi dell'Artois tra pianure e colline boscose, conservati e classificati come area naturale di interesse ecologico, faunistico e floristico."
        ],
        "fr": [
          "Une balade au départ du village de Villers-au-Bois à la découverte des paysages agréables de l’Artois entre plaines et coteaux boisés, préservés, classés en zone naturelle d’intérêt écologique, faunistique et floristique."
        ],
        "es": [
          "Un paseo que parte del pueblo de Villers-au-Bois para descubrir los agradables paisajes del Artois entre llanuras y laderas boscosas, preservados y clasificados como zona natural de interés ecológico, faunístico y florístico."
        ],
        "nl": [
          "Een wandeling vanuit het dorp Villers-au-Bois om de aangename landschappen van de Artois te ontdekken tussen vlakten en beboste hellingen, bewaard gebleven en geklasseerd als natuurgebied van ecologisch, faunistisch en floristisch belang."
        ]
      },
      "@type": [
        "Description"
      ],
