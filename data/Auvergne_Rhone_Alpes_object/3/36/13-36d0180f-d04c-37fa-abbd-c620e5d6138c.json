          "additionalInformation": {
            "de": [
              "Montag bis Sonntag Restaurant geöffnet von 18:00-02:00 Uhr jeden Abend (letzter Service 23:00 Uhr)\r\n\r\nFreitagmittag Samstagmittag und Sonntagmittag\r\nRestaurant geöffnet\r\nDie Bar ist nach dem Skifahren um 16 Uhr geöffnet , jeden Tag."
            ],
            "en": [
              "Monday to Sunday restaurant open from 6pm-02am every evening (last service 11pm)\r\n\r\nFriday lunchtime Saturday lunchtime and Sunday lunchtime\r\nRestaurant open\r\nBar open after skiing at 4pm, every day."
            ],
            "it": [
              "Dal lunedì alla domenica ristorante aperto dalle 18.00 alle 2.00 ogni sera (ultimo servizio alle 23.00)\r\n\r\nVenerdì a pranzo sabato a pranzo e domenica a pranzo\r\nRistorante aperto\r\nIl bar è aperto tutti i giorni dopo lo sci alle 16.00."
            ],
            "fr": [
              "Lundi au dimanche  restaurant ouvert à partir de 18h-02h tous les soirs (dernier service 23h)\r\n\r\nVendredi midi samedi midi  et dimanche midi \r\nRestaurant ouvert\r\nLe bar ouvert après ski à 16h , tout les jours."
            ],
            "nl": [
              "Maandag t/m zondag restaurant elke avond geopend van 18.00 tot 02.00 uur (laatste service 23.00 uur)\r\n\r\nVrijdagmiddag zaterdagmiddag en zondagmiddag\r\nRestaurant geopend\r\nDe bar is elke dag na het skiën om 16.00 uur geopend."
            ],
            "es": [
              "De lunes a domingo, el restaurante abre de 18.00 a 2.00 h. todas las noches (último servicio a las 23.00 h.)\r\n\r\nViernes al mediodía sábado al mediodía y domingo al mediodía\r\nRestaurante abierto\r\nEl bar abre todos los días después de esquiar a las 16 h."
            ]
          },
