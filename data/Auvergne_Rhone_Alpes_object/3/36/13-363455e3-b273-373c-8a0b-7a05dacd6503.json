  "rdfs:comment": {
    "de": [
      "Genießen Sie die Dorfatmosphäre, bevor Sie sich auf den Weg zum Laufen machen. Beginnen Sie am ruhigen See von Anneyron und laufen Sie dann in Richtung des Tour d'Albon, dem Wahrzeichen dieser Strecke."
    ],
    "en": [
      "Enjoy the village atmosphere before setting off on your run, starting at the peaceful Anneyron lake and heading for the Tour d'Albon, the circuit's landmark."
    ],
    "it": [
      "Godetevi l'atmosfera del villaggio prima di iniziare la corsa, partendo dal tranquillo lago di Anneyron e dirigendovi verso la Tour d'Albon, punto emblematico di questo circuito."
    ],
    "fr": [
      "Profitez de l'ambiance village avant de partir courir en commençant au paisible plan d'eau d'Anneyron puis en direction de la Tour d'Albon, point emblématique de ce circuit."
    ],
    "nl": [
      "Geniet van de dorpssfeer voordat je op pad gaat, beginnend bij het vredige meer van Anneyron en op weg naar de Tour d'Albon, het emblematische punt van dit circuit."
    ],
    "es": [
      "Disfrute del ambiente del pueblo antes de salir a correr, comenzando en el apacible lago de Anneyron y dirigiéndose hacia la Tour d'Albon, punto emblemático de este circuito."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Vigie du Dauphiné"
    ]
  },
