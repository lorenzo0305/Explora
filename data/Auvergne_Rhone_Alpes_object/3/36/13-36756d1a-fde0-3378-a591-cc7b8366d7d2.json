  "rdfs:comment": {
    "de": [
      "Im Chez Fifine bieten wir eine Gourmet- & moderne Küche, Qualitätsweine, einen aufmerksamen Service und das alles in einem wunderschönen Chalet in Septimontain\r\nWir kochen alle unsere Gerichte vor Ort mit Leidenschaft aus frischen und hochwertigen Produkten."
    ],
    "en": [
      "At Fifine's we offer gourmet & modern cuisine, quality wines, attentive service, all in a beautiful septimontan chalet. \r\nWe cook all our dishes with passion, using fresh, quality products."
    ],
    "it": [
      "Da Fifine's offriamo una cucina gourmet e moderna, vini di qualità, un servizio attento, il tutto in uno splendido chalet settentrionale\r\nCuciniamo tutti i nostri piatti con passione, utilizzando prodotti freschi e di qualità."
    ],
    "fr": [
      "Chez Fifine, nous proposons une cuisine gourmande & moderne, des vins de qualité, un service attentionné, le tout dans un magnifique chalet septimontain. \r\nNous cuisinons tous nos mets sur place avec passion, à partir de produits frais et de qualité."
    ],
    "es": [
      "En Fifine's ofrecemos cocina gourmet y moderna, vinos de calidad y un servicio atento, todo ello en un precioso chalet septimontano\r\nCocinamos todos nuestros platos con pasión, utilizando productos frescos y de calidad."
    ],
    "nl": [
      "Bij Fifine's bieden we een gastronomische & moderne keuken, kwaliteitswijnen, attente service, dit alles in een prachtig septimontisch chalet. \r\nWij koken al onze gerechten met passie en gebruiken verse kwaliteitsproducten."
    ]
  },
