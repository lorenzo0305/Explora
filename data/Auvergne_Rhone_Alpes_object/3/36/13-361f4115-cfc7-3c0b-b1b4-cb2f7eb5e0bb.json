  "rdfs:comment": {
    "de": [
      "Was haben Christoph Kolumbus, die Fürstin von Monaco und Louis de Funès gemeinsam? Sie sind alle drei Namen von Rosensträuchern, die von Antoine Meilland entworfen wurden!"
    ],
    "en": [
      "What do Christopher Columbus, the Princess of Monaco and Louis de Funès have in common? They are all three names of roses designed by Antoine Meilland!"
    ],
    "it": [
      "Cosa hanno in comune Cristoforo Colombo, la Principessa di Monaco e Louis de Funès? Sono tutti nomi di rosai disegnati da Antoine Meilland!"
    ],
    "fr": [
      "Quel est le point commun entre Christophe Colomb, la Princesse de Monaco et Louis de Funès ? Ils sont tous trois des nom de rosiers conçus par Antoine Meilland !"
    ],
    "es": [
      "¿Qué tienen en común Cristóbal Colón, la princesa de Mónaco y Louis de Funès? Todos son nombres de rosales diseñados por Antoine Meilland"
    ],
    "nl": [
      "Wat hebben Christoffel Columbus, de prinses van Monaco en Louis de Funès gemeen? Het zijn allemaal namen van rozenstruiken ontworpen door Antoine Meilland!"
    ]
  },
