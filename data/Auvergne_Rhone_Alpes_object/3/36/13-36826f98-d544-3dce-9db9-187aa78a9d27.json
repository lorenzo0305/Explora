  "rdfs:comment": {
    "de": [
      "Restaurant - Buchhandlung - Galerie L?Arbre vagabond möchte die Freuden kreuzen: die der Bücher und Gemälde mit denen des Weins und einer erfinderischen Küche."
    ],
    "en": [
      "Restaurant - Bookshop - Gallery L'Arbre vagabond aims to combine the pleasures of books and paintings with those of wine and inventive cuisine."
    ],
    "it": [
      "Ristorante - Libreria - Galleria L'Arbre vagabond si propone di combinare i piaceri dei libri e dei dipinti con quelli del vino e della cucina inventiva."
    ],
    "fr": [
      "Restaurant - Librairie - Galerie L’Arbre vagabond souhaite croiser les plaisirs : celui des livres et des tableaux avec celui du vin et d’une cuisine inventive."
    ],
    "es": [
      "Restaurante - Librería - Galería L'Arbre vagabond pretende combinar los placeres del libro y la pintura con los del vino y la cocina creativa."
    ],
    "nl": [
      "Restaurant - Boekhandel - Galerie L'Arbre vagabond wil het plezier van boeken en schilderijen combineren met dat van wijn en een inventieve keuken."
    ]
  },
