  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/da58a0f4-7fdf-3bef-b46e-10a517c21bcb",
      "dc:description": {
        "de": [
          "- Parken und Zuwasserlassen von Booten\n- Entdeckungstouren durch die Bucht von Authie an Bord eines Ausflugsboots\n- Führerscheinschule (Küsten-, Hochsee- und Flussführerschein)\nAb 4 Jahren."
        ],
        "en": [
          "- Boat parking and launching\n- Discovery tour of the Baie d'Authie on board a promenade boat\n- Licensing school (coastal, offshore and river)\nFrom age 4."
        ],
        "it": [
          "- Parcheggio e varo della barca\n- Tour alla scoperta della Baie d'Authie a bordo di una barca da passeggio\n- Scuola di patente nautica (costiera, d'altura e fluviale)\nPer i bambini dai 4 anni in su."
        ],
        "fr": [
          "- Parking et mise à l'eau de bateaux\n- Balade-découverte de la Baie d'Authie à bord de bateau promenade\n- Ecole de permis (côtier, hauturier et fluvial)\nA partir de 4 ans."
        ],
        "nl": [
          "- Parkeren en te water laten van boten\n- Ontdekkingstochten van de Baie d'Authie aan boord van een promenadeboot\n- Licentieschool (kust, offshore en rivier)\nVoor kinderen vanaf 4 jaar."
        ],
        "es": [
          "- Aparcamiento y botadura de barcos\n- Recorridos de descubrimiento de la bahía de Authie a bordo de un barco de paseo\n- Escuela de licencias (costera, de alta mar y fluvial)\nPara niños a partir de 4 años."
        ]
      },
      "@type": [
        "Description"
      ],
