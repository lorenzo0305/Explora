  "rdfs:comment": {
    "de": [
      "Dieses Restaurant liegt nur wenige Schritte vom Vogelpark entfernt und bietet Ihnen eine Flucht aus dem Alltag auf italienische Art. Hier können Sie eine der zahlreichen Pizzen aus dem Holzofen oder einen reichhaltigen Teller mit frischer Pasta in einem beruhigenden und gedämpften Rahmen genießen."
    ],
    "en": [
      "Just a stone's throw from the Parc des oiseaux, this restaurant offers you an Italian-style escape where you can choose to enjoy one of the many pizzas cooked over a wood fire or a hearty plate of fresh pasta in a soothing and cosy setting."
    ],
    "it": [
      "A pochi passi dal Parc des oiseaux, questo ristorante offre un'evasione in stile italiano, dove potrete scegliere di gustare una delle tante pizze cotte a legna o un abbondante piatto di pasta fresca in un ambiente rilassante e accogliente."
    ],
    "fr": [
      "A deux pas du Parc des oiseaux, ce restaurant vous offre de l'évasion à l'italienne où vous choissirez de déguster l'une des nombreuses pizzas cuites au feu de bois ou une copieuse assiette de pâtes fraîches dans un cadre apaisant et feutré."
    ],
    "nl": [
      "Op een steenworp afstand van het Vogelpark biedt dit restaurant een Italiaanse ontsnapping waar u kunt kiezen voor een van de vele houtgestookte pizza's of een stevig bord verse pasta in een rustgevende en gezellige omgeving."
    ],
    "es": [
      "A dos pasos del Parc des oiseaux, este restaurante ofrece una escapada al estilo italiano, donde podrá elegir entre una de las muchas pizzas al horno de leña o un buen plato de pasta fresca en un ambiente relajante y acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria La Toscane"
    ]
  },
