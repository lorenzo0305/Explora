  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Pizzeria mit gemütlicher Atmosphäre und genießen Sie leckere Pizzen, die der Chefkoch, ein ehemaliger Bäcker und Konditor, mit seiner Erfahrung beim Kneten von Pizzateig zubereitet"
    ],
    "en": [
      "Discover a pizzeria with a warm atmosphere and enjoy delicious pizzas thanks to the expertise of the chef, a former baker and pastry chef, who excels in kneading pizza dough!"
    ],
    "it": [
      "Scoprite una pizzeria dall'atmosfera accogliente e gustate pizze gustose grazie all'esperienza dello chef, ex panettiere e pasticcere, che eccelle nell'impasto della pizza!"
    ],
    "fr": [
      "Découvrez une pizzeria à l'ambiance chaleureuse et dégustez de savoureuses pizzas grâce à l'expertise du chef, ancien boulanger pâtissier, qui excelle dans le pétrissage de la pâte à pizzas!"
    ],
    "nl": [
      "Ontdek een pizzeria met een warme sfeer en geniet van lekkere pizza's dankzij de expertise van de chef, een voormalige bakker en banketbakker, die uitblinkt in het kneden van pizzadeeg!"
    ],
    "es": [
      "Descubra una pizzería con un ambiente cálido y disfrute de sabrosas pizzas gracias a la experiencia del chef, antiguo panadero y pastelero, que destaca en el amasado de la masa de pizza"
    ]
  },
