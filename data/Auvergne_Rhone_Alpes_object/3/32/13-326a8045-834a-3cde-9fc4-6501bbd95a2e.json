  "rdfs:comment": {
    "de": [
      "Über die Ausstellung von medizinischen Rezepten hinaus berät die Apotheke von Tençoise ihre Patienten zu ihrer Gesundheit und ihrem Wohlbefinden."
    ],
    "en": [
      "In addition to dispensing medical prescriptions, Pharmacie Tençoise advises patients on their health and well-being."
    ],
    "it": [
      "Oltre a dispensare prescrizioni mediche, la Pharmacie tençoise consiglia i suoi pazienti sulla loro salute e sul loro benessere."
    ],
    "fr": [
      "Au delà de la délivrance des prescriptions médicales, la Pharmacie tençoise conseille ses patients sur leur santé et leur bien-être."
    ],
    "nl": [
      "Naast het verstrekken van medische recepten adviseert de Pharmacie tençoise haar patiënten over hun gezondheid en welzijn."
    ],
    "es": [
      "Además de dispensar recetas médicas, la Pharmacie tençoise asesora a sus pacientes sobre su salud y bienestar."
    ]
  },
