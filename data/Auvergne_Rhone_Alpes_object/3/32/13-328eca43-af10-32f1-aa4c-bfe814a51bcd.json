  "rdfs:comment": {
    "de": [
      "J?aime la chasse? ist ein dokumentarisches, visuelles und musikalisches Märchen, in dem Katy, eine \"neo rural bobo écolo\", ihr Ideal von der Natur mit einer gewissen Realität konfrontiert."
    ],
    "en": [
      "J'aime la chasse? is a documentary, visual and musical tale in which Katy, a \"neo-rural bobo ecologist\", confronts her ideal of nature with a certain reality."
    ],
    "it": [
      "J?aime la chasse? è un documentario, un racconto visivo e musicale in cui Katy, una \"ecologista bobo neo-rurale\", confronta il suo ideale di natura con una certa realtà."
    ],
    "fr": [
      "J’aime la chasse ? est un conte documentaire, visuel et musical où Katy, une « néo rurale bobo écolo » confronte son idéal de la nature à une certaine réalité."
    ],
    "nl": [
      "J?aime la chasse? is een documentaire, visuele en muzikale vertelling waarin Katy, een \"neo-landelijke bobo-ecologe\", haar natuurideaal confronteert met een zekere realiteit."
    ],
    "es": [
      "J?aime la chasse? es un relato documental, visual y musical en el que Katy, una \"ecologista neo-rural bobo\", confronta su ideal de naturaleza con una cierta realidad."
    ]
  },
  "rdfs:label": {
    "fr": [
