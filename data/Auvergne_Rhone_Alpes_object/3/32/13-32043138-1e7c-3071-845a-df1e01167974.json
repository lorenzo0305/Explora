  "rdfs:comment": {
    "de": [
      "Filéo Loisirs, ein neuer Freizeitpark für Familien, 20 Minuten von Roanne entfernt, bietet Restaurants, ein Hochseilgarten, ein Ballbad, ein Labyrinth, Explor Games®, Minigolf und eine Riesenrutsche. Natürlicher, sicherer und spielerischer Rahmen für schöne Momente mit der Familie!"
    ],
    "en": [
      "Filéo Loisirs, a new family leisure park 20 minutes from Roanne, offers a restaurant, accro-filet, ball pool, labyrinth, Explor Games®, mini-golf and giant slide. A natural, safe and fun setting for great family fun!"
    ],
    "it": [
      "Filéo Loisirs, un nuovo parco ricreativo per famiglie a 20 minuti da Roanne, offre un ristorante, un accro-filet, una piscina di palline, un labirinto, Explor Games®, un minigolf e uno scivolo gigante. Un ambiente naturale, sicuro e divertente per un grande divertimento in famiglia!"
    ],
    "fr": [
      "Filéo Loisirs, nouveau parc de loisirs familial à 20 min de Roanne propose restauration, accro-filet, piscine à balles, labyrinthe, Explor Games®, mini-golf et toboggan géant. Cadre naturel, sécurisé et ludique pour de beaux moments en famille !"
    ],
    "es": [
      "Filéo Loisirs, un nuevo parque de ocio familiar a 20 minutos de Roanne, ofrece restaurante, accro-filet, piscina de bolas, laberinto, Explor Games®, minigolf y tobogán gigante. Un entorno natural, seguro y lúdico para divertirse en familia"
    ],
    "nl": [
      "Filéo Loisirs, een nieuw familiepretpark op 20 minuten van Roanne, biedt een restaurant, accro-filet, ballenbad, doolhof, Explor Games®, minigolf en reuzenglijbaan. Een natuurlijke, veilige en leuke omgeving voor veel plezier met het gezin!"
    ]
  },
