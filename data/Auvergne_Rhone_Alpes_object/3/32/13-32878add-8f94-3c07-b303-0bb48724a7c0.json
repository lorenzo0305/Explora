  "rdfs:comment": {
    "de": [
      "Wandern Sie anders und nehmen Sie am lokalen Leben teil, lernen Sie die Gebiete und die Menschen kennen, die das Land am Leben erhalten."
    ],
    "en": [
      "Experience a unique way to hike by being part of local life and getting up close and personal with the lands and locals who make the region what it is."
    ],
    "it": [
      "Dal 2007, il nostro ufficio Mountain Leader lavora per condividere con voi la nostra passione per questa regione!\r\nSentieri segreti, luoghi indimenticabili, rigenerazione e condivisione. Un programma completo, in tutte e 4 le stagioni, fatto su misura per tutti."
    ],
    "fr": [
      "Notre bureau des Accompagnateurs en Montagne œuvre depuis 2007 à vous faire partager notre passion pour ce territoire !\r\nSentiers secrets, spots inoubliables, ressourcements et partages. Tout un programme, aux 4 saisons, sur-mesure et pour tout publics."
    ],
    "nl": [
      "Wandel op een andere manier, neem deel aan het lokale leven, leer het gebied kennen en de mensen die de regio tot leven brengen."
    ],
    "es": [
      "Desde 2007, nuestra oficina de Mountain Leader trabaja para compartir contigo nuestra pasión por esta región\r\nSenderos secretos, rincones inolvidables, rejuvenecimiento y convivencia. Todo un programa, en las 4 estaciones, a la medida de cada uno."
    ]
  },
