  "rdfs:comment": {
    "de": [
      "Strecken von 7Km 250 D+ freier Start zwischen 13:00 und 16:00 Uhr und 15 km 550 D+ freier Start zwischen 13:00 und 14:30 Uhr in Eigenregie. Verpflegung bei der Ankunft. Die Anmeldung erfolgt vor Ort kurz vor dem Start im Sportkomplex."
    ],
    "en": [
      "7Km 250 D+ free start between 1pm and 4pm and 15 km 550 D+ free start between 1pm and 2:30pm. Refreshments at the finish. Registration on site just before the start at the sports complex."
    ],
    "it": [
      "7 km 250 D+ partenza libera tra le 13.00 e le 16.00 e 15 km 550 D+ partenza libera tra le 13.00 e le 14.30 in autonomia. Ristoro all'arrivo. Le iscrizioni si effettueranno presso il complesso sportivo poco prima della partenza."
    ],
    "fr": [
      "Parcours de 7Km 250 D+ départ libre entre 13h et 16h et 15 km 550 D+ départ libre entre 13h et 14h30  en autonomie. Ravitaillement à l'arrivée. Les inscriptions se feront sur place juste avant le départ au complexe sportif."
    ],
    "es": [
      "7Km 250 D+ salida libre entre las 13h y las 16h y 15 km 550 D+ salida libre entre las 13h y las 14h30 por su cuenta. Refrescos en la meta. La inscripción tendrá lugar en el complejo deportivo justo antes de la salida."
    ],
    "nl": [
      "7 km 250 D+ vrije start tussen 13.00 en 16.00 uur en 15 km 550 D+ vrije start tussen 13.00 en 14.30 uur op eigen gelegenheid. Versnaperingen bij de finish. De registratie vindt plaats bij het sportcomplex vlak voor de start."
    ]
  },
