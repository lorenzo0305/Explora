  "rdfs:comment": {
    "de": [
      "Im charmanten Steingewölbesaal der Auberge de la Tour und auf der hübschen Terrasse mit Blick auf Marcolès bietet Ihnen das Bistro-Restaurant Oxalis eine regionale Küche, die von Küchenchef Renaud Darmanin sorgfältig zubereitet wird."
    ],
    "en": [
      "Nestling in the charming stone-vaulted dining room of L'Auberge de la Tour and on the pretty terrace overlooking Marcolès, the bistronomic Oxalis restaurant serves local cuisine meticulously prepared by chef Renaud Darmanin."
    ],
    "it": [
      "Situato nell'incantevole sala da pranzo con volta in pietra de L'Auberge de la Tour e sulla graziosa terrazza con vista su Marcolès, il ristorante bistronomico Oxalis propone una cucina locale meticolosamente preparata dallo chef Renaud Darmanin."
    ],
    "fr": [
      "Niché dans la charmante salle voûtée en pierre de L'Auberge de la Tour et sur la jolie terrasse surplombant Marcolès, le restaurant bistronomique Oxalis vous propose de savourer une cuisine du terroir méticuleusement élaborée par le chef Renaud Darmanin."
    ],
    "es": [
      "Ubicado en el encantador comedor abovedado de piedra de L'Auberge de la Tour y en la bonita terraza con vistas a Marcolès, el restaurante bistronómico Oxalis sirve cocina local meticulosamente preparada por el chef Renaud Darmanin."
    ],
    "nl": [
      "In de charmante stenen gewelfde eetzaal van L'Auberge de la Tour en op het mooie terras met uitzicht op Marcolès serveert het bistronomische restaurant Oxalis lokale gerechten die zorgvuldig worden bereid door chef-kok Renaud Darmanin."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bistronomic restaurant Oxalis"
    ],
    "fr": [
      "Restaurant bistronomique Oxalis"
    ],
    "nl": [
      "Bistronomisch restaurant Oxalis"
    ]
  },
