  "rdfs:comment": {
    "de": [
      "Frau und Herr Dautremay bauen zahlreiche aromatische Pflanzen sowie Blumen und rote Früchte aus biologischem Anbau an. Verkauf der Produkte auf dem Hof, auf Märkten oder über AMAP."
    ],
    "en": [
      "Mrs. and Mr. Dautremay grow a wide range of aromatic plants, as well as organically grown flowers and berries. Products are sold at the farm, at markets and at the AMAP."
    ],
    "it": [
      "I coniugi Dautremay coltivano un'ampia gamma di piante aromatiche, oltre a fiori e frutti rossi coltivati con metodo biologico. I prodotti sono venduti in azienda, nei mercati e presso l'AMAP."
    ],
    "fr": [
      "Mme et M. Dautremay cultivent de nombreuses plantes aromatiques ainsi que des fleurs et fruits rouges issus de l'agriculture biologique. Vente de produits sur le lieu d'exploitation, sur les marchés ou encore à l'AMAP."
    ],
    "nl": [
      "Mevrouw en mijnheer Dautremay telen een breed assortiment aromatische planten, maar ook biologisch geteelde bloemen en rood fruit. De producten worden verkocht op de boerderij, op markten en bij de AMAP."
    ],
    "es": [
      "La Sra. y el Sr. Dautremay cultivan una amplia gama de plantas aromáticas, así como flores y frutos rojos de cultivo ecológico. Los productos se venden en la granja, en mercados y en la AMAP."
    ]
  },
  "rdfs:label": {
