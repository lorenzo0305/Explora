  "rdfs:comment": {
    "de": [
      "Der Nant d'Aillon ist ein wunderschöner Forellenbach und ein Nebenfluss des Chéran, der als Wildfluss im Herzen des regionalen Naturparks Les Bauges ausgezeichnet wurde.\r\nDer Fluss ist nicht auf Gegenseitigkeit mit der Karte des Departements Savoie verbunden."
    ],
    "en": [
      "A magnificent trout stream, the Nant d'Aillon is a tributary of the Chéran and a certified wild river in the heart of the Bauges Regional Nature Park.\r\nNon-reciprocal river on the Savoie departmental map."
    ],
    "it": [
      "Magnifico torrente da trota, il Nant d'Aillon è un affluente del Chéran e un fiume selvaggio designato nel cuore del Parco Naturale Regionale di Bauges.\r\nÈ un fiume non reciproco sulla carta dipartimentale della Savoia."
    ],
    "fr": [
      "Magnifique torrent à truites, le Nant d'Aillon est un affluent du Chéran labellisé rivière sauvage en plein cœur du Parc naturel régional des Bauges.\r\nRivière non réciprocitaire à la carte départementale Savoie."
    ],
    "es": [
      "Magnífico arroyo truchero, el Nant d'Aillon es un afluente del Chéran y un río declarado salvaje en el corazón del Parque Natural Regional de Bauges.\r\nRío no recreativo en el mapa departamental de Saboya."
    ],
    "nl": [
      "De Nant d'Aillon is een prachtige forelrivier, een zijrivier van de Chéran en een aangewezen wilde rivier in het hart van het regionale natuurpark van de Bauges.\r\nEen niet-wederkerige rivier op de departementale kaart van de Savoie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Nant d’Aillon"
    ]
  },
