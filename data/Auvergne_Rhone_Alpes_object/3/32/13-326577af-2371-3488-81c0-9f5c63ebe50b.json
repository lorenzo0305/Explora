  "rdfs:comment": {
    "de": [
      "Nach einem Tag auf der Piste gibt es nichts Schöneres, als sich mit der Familie oder Freunden in der gemütlichen Atmosphäre der Bar Rouge zu treffen!"
    ],
    "en": [
      "After a day on the slopes, Le Bar Rouge offers the perfect cosy hideaway for drinks with friends or family."
    ],
    "it": [
      "Dopo una giornata trascorsa sulle piste, non c'è nulla di più piacevole che ritrovarsi in famiglia o tra amici nell'atmosfera accogliente del Bar Rouge!"
    ],
    "fr": [
      "Après une journée passée sur les pistes, rien de plus plaisant que de se retrouver en famille ou entre amis dans l’atmosphère cosy du Bar Rouge !"
    ],
    "nl": [
      "Na een dag op de piste is er niets beter dan samenkomen met familie en vrienden in de gezellige sfeer van de Bar Rouge!"
    ],
    "es": [
      "Después de un día en las pistas, nada mejor que reunirse con la familia y los amigos en el acogedor ambiente del Bar Rouge"
    ]
  },
