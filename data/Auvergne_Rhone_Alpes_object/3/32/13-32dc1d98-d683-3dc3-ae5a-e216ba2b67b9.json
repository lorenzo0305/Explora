  "rdfs:comment": {
    "de": [
      "Eine Ostereiersuche wie zu Zeiten Ludwigs XIV Die Marquise de Sévigné hat Ostereier im Dorf versteckt! Eine spielerische, leckere Animation voller Überraschungen! Eine Animation von Planète Guides. Start vor dem Fremdenverkehrsamt."
    ],
    "en": [
      "An Easter egg hunt like in the time of Louis XIV! The Marquise de Sévigné has hidden Easter eggs in the village! A fun, gourmet event full of surprises! A Planète Guides event. Departure from in front of the Tourist Office."
    ],
    "it": [
      "Una caccia alle uova di Pasqua come ai tempi di Luigi XIV! La Marchesa di Sévigné ha nascosto delle uova di Pasqua nel villaggio! È divertente, deliziosa e piena di sorprese! Un'attività delle Guide Planète. Partenza di fronte all'Ufficio del Turismo."
    ],
    "fr": [
      "Une chasse aux œufs de Pâques comme au temps de Louis XIV ! La marquise de Sévigné a caché des oeufs de Pâques dans le village ! Une animation ludique, gourmande et pleine de surprises ! Une animation Planète Guides. Départ devant l'Office de tourisme."
    ],
    "es": [
      "¡Una búsqueda de huevos de Pascua como en tiempos de Luis XIV! La marquesa de Sévigné ha escondido huevos de Pascua en el pueblo Divertido, delicioso y lleno de sorpresas Una actividad de Planète Guides. Salida frente a la Oficina de Turismo."
    ],
    "nl": [
      "Een paaseierenjacht net als in de tijd van Louis XIV! De markiezin van Sévigné heeft paaseieren verstopt in het dorp! Leuk, lekker en vol verrassingen! Een activiteit van Planète Guides. Vertrek voor het Office du Tourisme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux oeufs de Pâques avec madame de Sévigné"
    ]
  },
