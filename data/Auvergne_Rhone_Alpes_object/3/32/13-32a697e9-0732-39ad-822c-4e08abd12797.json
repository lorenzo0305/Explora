  "rdfs:comment": {
    "de": [
      "Machen Sie eine Pause mitten im Wald auf den Meridianen der Plains. Ein günstiger Moment, um die Landschaft zu betrachten und sich zu entspannen."
    ],
    "en": [
      "Take a break in the middle of the forest, on the Plaines meridiennes. A moment to contemplate the landscape and relax."
    ],
    "it": [
      "Fate una pausa in mezzo alla foresta, sulle Plaines meridiennes. È il luogo ideale per ammirare il paesaggio e rilassarsi."
    ],
    "fr": [
      "Prenez une pause en pleine forêt, sur les méridiennes des Plaines. Un moment propice à la contemplation du paysage et à la relaxation."
    ],
    "es": [
      "Tómese un descanso en medio del bosque, en las Plaines meridiennes. Es el lugar perfecto para disfrutar del paisaje y relajarse."
    ],
    "nl": [
      "Neem een pauze midden in het bos, op de Plaines meridiennes. Het is de perfecte plek om te genieten van het landschap en te ontspannen."
    ]
  },
  "rdfs:label": {
    "en": [
