  "rdfs:comment": {
    "de": [
      "Ob vor Ort oder zum Mitnehmen, Le Peplum wartet auf Sie! Wir kochen auch gerne bei Ihnen zu Hause!"
    ],
    "en": [
      "Whether you want to eat in or take away, Le Peplum is waiting for you! We can also cook at your place!"
    ],
    "it": [
      "Che vogliate mangiare in casa o da asporto, Le Peplum vi aspetta! Possiamo anche cucinare a casa vostra!"
    ],
    "fr": [
      "Que ce soit sur place ou à emporter, Le Peplum vous attend ! Nous pouvons aussi cuisiner chez vous !"
    ],
    "es": [
      "Tanto si quiere comer en casa como para llevar, Le Peplum le espera También podemos cocinar en su casa"
    ],
    "nl": [
      "Of je nu wilt eten of afhalen, Le Peplum staat voor je klaar! Wij kunnen ook bij u thuis koken!"
    ]
