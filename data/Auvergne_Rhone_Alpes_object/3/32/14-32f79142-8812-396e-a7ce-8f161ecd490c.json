      "dc:description": {
        "de": [
          "Mehr als 120 voll ausgerüstete Soldaten und Tausende von Ausstellungsstücken. Tauchen Sie ein in die Geschichte des Zweiten Weltkriegs!"
        ],
        "en": [
          "Over 120 fully equipped soldiers and thousands of exhibits. Immerse yourself in the history of the Second World War!"
        ],
        "it": [
          "Oltre 120 soldati completamente equipaggiati e migliaia di oggetti in mostra. Immergetevi nella storia della Seconda guerra mondiale!"
        ],
        "fr": [
          "Plus de 120 soldats entièrement équipés et des milliers d'objets exposés. Plongez au cœur de l'histoire de la Seconde Guerre mondiale !"
        ],
        "nl": [
          "Meer dan 120 volledig uitgeruste soldaten en duizenden voorwerpen tentoongesteld. Dompel jezelf onder in de geschiedenis van de Tweede Wereldoorlog!"
        ],
        "es": [
          "Más de 120 soldados totalmente equipados y miles de objetos expuestos. Sumérgete en la historia de la Segunda Guerra Mundial"
        ]
