  "rdfs:comment": {
    "de": [
      "Beobachten Sie am Abend unseren natürlichen Satelliten, den Mond, in Begleitung von Experten!\n\nEin Abend, der von der Société Astronomique de France organisiert wird...\n\nRV auf der Promenade Saint-Martin in Laon von 20h bis 22h!"
    ],
    "en": [
      "Come and watch our natural satellite, the Moon, in the company of specialists!\n\nAn evening organized by the Société Astronomique de France...\n\nRendezvous on the Promenade Saint-Martin in Laon from 8pm to 10pm!"
    ],
    "it": [
      "Venite a osservare il nostro satellite naturale, la Luna, in compagnia di specialisti!\n\nUna serata organizzata dalla Société Astronomique de France...\n\nVenite sulla Promenade Saint-Martin di Laon dalle 20.00 alle 22.00!"
    ],
    "fr": [
      "Venez observer en soirée notre satellite naturel, la Lune, en compagnie de spécialistes !\n\nUne soirée organisée par la Société Astronomique de France... \n\nRV sur la Promenade Saint-Martin à Laon de 20h à 22h !"
    ],
    "es": [
      "¡Venga a observar nuestro satélite natural, la Luna, en compañía de especialistas!\n\nUna velada organizada por la Société Astronomique de France...\n\nVenga a la Promenade Saint-Martin de Laon de 20:00 a 22:00 horas"
    ],
    "nl": [
      "Kom kijken naar onze natuurlijke satelliet, de maan, in gezelschap van specialisten!\n\nEen avond georganiseerd door de Société Astronomique de France...\n\nKom naar de Promenade Saint-Martin in Laon van 20u tot 22u!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Evenement à Laon : \"On The Moon Again\""
    ]
  },
