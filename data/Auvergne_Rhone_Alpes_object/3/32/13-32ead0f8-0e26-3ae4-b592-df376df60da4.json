  "rdfs:comment": {
    "de": [
      "Am Eingang von Ruoms bieten wir jede Stunde Abfahrten. Nach der Rückkehr von Ihrer Abfahrt stehen Ihnen warme Duschen zur Verfügung und Sie können auch von unserem beheizten Schwimmbad profitieren. \r\nKontaktieren Sie uns zwischen 8:00 und 20:00 Uhr für ein personalisiertes Angebot."
    ],
    "en": [
      "We provide hourly departures on the way into Ruoms. When you get back from your trip you can use our hot showers and heated pool. \r\nContact us for a quote: 8am-8pm."
    ],
    "it": [
      "Situato all'ingresso di Ruoms, offre partenze ogni ora.  Al ritorno sono disponibili docce calde.\r\nContattateci dalle 8 alle 20 per un preventivo personalizzato."
    ],
    "fr": [
      "Situé à l'entrée de Ruoms  nous proposons des départs à toutes les heures.  Au retour de votre descente des douches chaudes sont à votre disposition. \r\nContactez nous de 8h à 20h pour un devis personnalisé."
    ],
    "es": [
      "Situado a la entrada de Ruoms, ofrecemos salidas cada hora.  Duchas de agua caliente a su regreso.\r\nPóngase en contacto con nosotros de 8:00 a 20:00 para obtener un presupuesto personalizado."
    ],
    "nl": [
      "Gelegen bij de ingang van Ruoms, bieden we elk uur vertrek. Warme douches zijn beschikbaar bij terugkomst. \r\nNeem van 8 tot 20 uur contact met ons op voor een persoonlijke offerte."
    ]
  },
