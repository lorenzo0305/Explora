  "rdfs:comment": {
    "de": [
      "Ein privater Landschaftsgarten von 1,2 Hektar, der 1997 angelegt wurde. Er liegt auf freiem Feld und bietet Hunderte von Gehölzen mit dekorativer Rinde, besonderem Laub, ausgedehnten Blüten, starken oder subtileren Düften und besonderen Fruchtständen."
    ],
    "en": [
      "A 1.2-hectare private landscape garden created in 1997. Located in an open field, it features hundreds of woody plants with decorative bark, distinctive foliage, spreading flowering, powerful or more subtle fragrances and distinctive fruiting bodies."
    ],
    "it": [
      "Un giardino paesaggistico privato di 1,2 ettari creato nel 1997. Situato in campo aperto, offre centinaia di piante legnose con corteccia decorativa, fogliame speciale, fioritura diffusa, profumi potenti o più tenui e fruttificazione speciale."
    ],
    "fr": [
      "Jardin paysager privé de 1,2 hectares créé en 1997. Situé en plein champ, il propose des centaines de ligneux à écorces décoratives, à feuillages particuliers, à floraisons étalées, à parfums puissants ou plus subtils, aux fructifications particulières."
    ],
    "es": [
      "Un jardín paisajista privado de 1,2 hectáreas creado en 1997. Situado en campo abierto, ofrece cientos de plantas leñosas de corteza decorativa, follaje especial, floración extendida, aromas potentes o más sutiles y fructificación especial."
    ],
    "nl": [
      "Een privétuin van 1,2 hectare aangelegd in 1997. Het ligt in open velden en bevat honderden houtachtige planten met decoratieve schors, opvallend gebladerte, wijdverspreide bloei, krachtige of subtielere geuren en opvallende vruchtlichamen."
    ]
  },
