  "rdfs:comment": {
    "de": [
      "In diesem Restaurant der ESAT herrschen Gastfreundschaft, Geselligkeit und Einfachheit. Das Restaurant bietet seinen Gästen den Geschmack einer großzügigen und familiären Küche. Jeden Tag gibt es ein anderes Menü, das eine große Auswahl an lokalen Produkten bietet."
    ],
    "en": [
      "ESAT's application restaurant, where a warm welcome, conviviality and simplicity reign. The restaurant offers guests a taste of generous, home-style cooking. A different menu is offered every day, featuring a wide range of local produce."
    ],
    "it": [
      "Il ristorante di formazione dell'ESAT offre una calda accoglienza, convivialità e semplicità. Il ristorante offre agli ospiti un assaggio di una cucina generosa e casalinga. Ogni giorno un menu diverso propone un'ampia gamma di prodotti locali."
    ],
    "fr": [
      "Restaurant d'application de l'ESAT ou règnent l'accueil, la convivialité et la simplicité. Le restaurant laisse à ses hôtes le goût d'une cuisine généreuse et familiale. Chaque jour un menu différent permet d’apprécier une large gamme de produits locaux."
    ],
    "nl": [
      "Het opleidingsrestaurant van ESAT biedt een warm welkom, gezelligheid en eenvoud. Het restaurant biedt gasten een voorproefje van de royale, familiaire keuken. Elke dag biedt een ander menu een breed scala aan lokale producten."
    ],
    "es": [
      "El restaurante de formación de la ESAT ofrece una cálida bienvenida, convivencia y sencillez. El restaurante ofrece a los huéspedes el sabor de una cocina casera y generosa. Cada día, un menú diferente ofrece una amplia gama de productos locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Berges de l'Allier"
    ]
  },
