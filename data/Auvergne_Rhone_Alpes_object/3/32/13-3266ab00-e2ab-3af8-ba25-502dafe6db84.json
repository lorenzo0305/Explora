  "rdfs:comment": {
    "de": [
      "Die GAEC Guilland des Plantaz bietet Ihnen eine große Auswahl an Bio-Äpfeln und -Birnen sowie daraus hergestellte Produkte: Säfte, Nektare, Kompotte, Pürees, Konfitüren, Sorbets und Eisschollen sowie Weine aus Bugey und Cidre fermier."
    ],
    "en": [
      "GAEC Guilland des Plantaz offers a wide range of organic apples and pears as well as related products: juices, nectars, compotes, purées, jams, sorbets and ice cream logs, as well as Bugey wines and farmhouse cider."
    ],
    "it": [
      "Il GAEC Guilland des Plantaz offre un'ampia gamma di mele e pere biologiche e prodotti correlati: succhi, nettari, composte, puree, marmellate, sorbetti e tronchetti surgelati, oltre a vini Bugey e sidro di fattoria."
    ],
    "fr": [
      "Le GAEC Guilland des Plantaz vous propose une large gamme de pommes et poires bios ainsi que des produits dérivés : jus, nectars, compotes, purées, confitures, sorbets et bûches glacées ainsi que des Vins du Bugey et du cidre fermier."
    ],
    "es": [
      "El GAEC Guilland des Plantaz le ofrece una amplia gama de manzanas y peras ecológicas y productos relacionados: zumos, néctares, compotas, purés, mermeladas, sorbetes y troncos congelados, así como vinos Bugey y sidra de granja."
    ],
    "nl": [
      "De GAEC Guilland des Plantaz biedt je een breed assortiment biologische appels en peren en aanverwante producten: sappen, nectars, compotes, puree, jam, sorbets en diepvriesstammen, maar ook Bugey-wijnen en boerencider."
    ]
  },
