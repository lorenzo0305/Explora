  "rdfs:comment": {
    "de": [
      "An einem friedlichen Ort, der sich zum Garten und den umliegenden Hügeln hin öffnet, können Sie mit sich selbst ins Reine kommen und sich wieder mit Ihrem tiefsten Selbst verbinden."
    ],
    "en": [
      "In a peaceful setting overlooking the garden and surrounding hills, come and take stock of yourself and reconnect with your inner self."
    ],
    "it": [
      "In un ambiente tranquillo con vista sul giardino e sulle colline circostanti, venite a fare il punto su voi stessi e a riconnettervi con il vostro io interiore."
    ],
    "fr": [
      "Dans un lieu paisible, ouvert sur le jardin et les collines environnantes, venez faire le point avec vous-même et vous reconnecter à votre moi profond."
    ],
    "nl": [
      "Handvaardigheden: schilderijen en illustraties, mobieltjes, kinderdecoraties, ansichtkaarten, bladwijzers, boeken. Originele geschenkideeën. Artistieke workshops op inschrijving (kinderen, tieners, volwassenen of alle publiek)."
    ],
    "es": [
      "En un entorno tranquilo con vistas al jardín y a las colinas circundantes, venga a hacer balance de sí mismo y a reconectar con su yo interior."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Coaching et Art Thérapie - Atelier L'Arbre bleu"
    ]
  },
