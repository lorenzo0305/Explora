  "rdfs:comment": {
    "de": [
      "Erleben Sie mit We Dolly ein originelles Abenteuer in einem 2CV! Ausflüge, Schnitzeljagden, Escape Games? Erleben Sie einen unvergesslichen Moment zwischen Geschichte, Natur und Gastronomie in der Dombes, im Beaujolais oder im Bugey. Ein maßgeschneidertes, spielerisches und authentisches Erlebnis!"
    ],
    "en": [
      "Enjoy an original adventure in a 2CV with We Dolly! Walks, treasure hunts, escape games? Experience an unforgettable blend of history, nature and gastronomy in the Dombes, Beaujolais or Bugey regions. A tailor-made, fun and authentic experience!"
    ],
    "it": [
      "Vivi un'avventura originale in una 2CV con We Dolly! Passeggiate, cacce al tesoro, giochi di fuga? Godetevi un'indimenticabile combinazione di storia, natura e gastronomia nelle regioni di Dombes, Beaujolais e Bugey. Un'esperienza su misura, divertente e autentica!"
    ],
    "fr": [
      "Vivez une aventure originale en 2CV avec We Dolly ! Balades, jeux de piste, escape games… Vivez un moment inoubliable entre histoire, nature et gastronomie dans la Dombes, le Beaujolais ou le Bugey. Une expérience sur-mesure, ludique et authentique !"
    ],
    "es": [
      "¡Disfruta de una original aventura en un 2CV con We Dolly! Paseos, búsquedas del tesoro, juegos de escape.. Disfrute de una inolvidable combinación de historia, naturaleza y gastronomía en las regiones de Dombes, Beaujolais y Bugey. Una experiencia a medida, divertida y auténtica"
    ],
    "nl": [
      "Geniet van een origineel avontuur in een 2CV met We Dolly! Wandelingen, schattenjachten, ontsnappingsspelletjes? Geniet van een onvergetelijke combinatie van geschiedenis, natuur en gastronomie in de regio's Dombes, Beaujolais en Bugey. Een leuke en authentieke ervaring op maat!"
    ]
  },
