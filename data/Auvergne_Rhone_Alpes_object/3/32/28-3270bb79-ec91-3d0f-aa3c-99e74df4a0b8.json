  "rdfs:comment": {
    "de": [
      "Hugo Wok ist ein großes Restaurant mit chinesischer und japanischer Küche und Grillgerichten\nEs verfügt über einen großen klimatisierten Saal mit 260 Sitzplätzen und einen Privatparkplatz mit 60 verfügbaren Plätzen\nEs besteht die Möglichkeit, Geschäftsessen, Bankette, Geburtstage... zu organisieren."
    ],
    "en": [
      "Hugo Wok is a great restaurant of Chinese, Japanese and grilled food\nIt has a large air-conditioned room with 260 seats and a private parking lot with 60 places available\nPossibility of organizing business meals, banquets, birthdays..."
    ],
    "it": [
      "Hugo Wok è un grande ristorante che serve piatti cinesi, giapponesi e alla griglia\nDispone di un'ampia sala climatizzata con 260 posti a sedere e di un parcheggio privato con 60 posti disponibili\nPossibilità di organizzare pranzi di lavoro, banchetti, compleanni..."
    ],
    "fr": [
      "Hugo Wok est un grand restaurant de cuisine chinoise, japonaise et de grillades. \nIl possède une grande salle climatisée avec 260 couverts et un parking privé avec 60 places disponibles. \nPossibilité d'organiser des repas d'affaires, banquet, anniversaire..."
    ],
    "nl": [
      "Hugo Wok is een groot restaurant dat Chinees, Japans en gegrild eten serveert\nHet beschikt over een grote zaal met airconditioning met 260 zitplaatsen en een eigen parkeerplaats met 60 plaatsen\nMogelijkheid tot het organiseren van zakendiners, banketten, verjaardagen..."
    ],
    "es": [
      "Hugo Wok es un gran restaurante que sirve comida china, japonesa y a la parrilla\nDispone de una gran sala climatizada con 260 plazas y un aparcamiento privado con 60 plazas disponibles\nPosibilidad de organizar comidas de empresa, banquetes, cumpleaños..."
    ]
  },
