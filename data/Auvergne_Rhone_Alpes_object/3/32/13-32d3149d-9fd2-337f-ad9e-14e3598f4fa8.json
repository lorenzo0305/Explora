  "rdfs:comment": {
    "de": [
      "Am Fuße des Naturparks Vercors mit seiner geschichtsträchtigen Vergangenheit und in einer großartigen touristischen Umgebung gelegen, stellt die Charcuterie des Limouches ihre Produkte her und vermarktet sie, darunter auch ihren berühmten Caillette."
    ],
    "en": [
      "Situated at the foot of the Vercors Natural Park, in a setting steeped in history, the charcuterie des Limouches produces and markets its products, including its famous caillette."
    ],
    "it": [
      "Situata ai piedi del parco naturale del Vercors, con un passato ricco di storia, in un ambiente grandioso e turistico, la salumeria di Limouches produce e commercializza i suoi prodotti, tra cui la famosa caillette."
    ],
    "fr": [
      "Situé au pied du parc naturel du Vercors, au passé chargé d'histoire, dans un cadre grandiose et touristique, la charcuterie des Limouches fabrique et commercialise ses produits dont sa célèbre caillette."
    ],
    "es": [
      "Situada al pie del parque natural del Vercors, con un pasado cargado de historia, en un entorno grandioso y turístico, la charcutería de Limouches produce y comercializa sus productos, entre ellos su famosa caillette."
    ],
    "nl": [
      "Aan de voet van het natuurpark van de Vercors, met een rijke geschiedenis, in een prachtige toeristische omgeving, produceert en verkoopt de charcuterie van Limouches haar producten, waaronder de beroemde caillette."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison des Limouches"
    ]
  },
