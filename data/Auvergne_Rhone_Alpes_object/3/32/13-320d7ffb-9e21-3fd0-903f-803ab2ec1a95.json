  "rdfs:comment": {
    "de": [
      "Angeln (1. Kategorie = Forellen und Weißfische). In dem 800 m² großen Teich in geschlossenen Gewässern kann man ohne Angelschein, aber mit der Gemeindekarte angeln, die im Restaurant Mazières erhältlich ist:"
    ],
    "en": [
      "Fishing activity (1st category = trout & whitefish). 800 m² pond where you can fish without a fishing licence but with the municipal card (€8 per day per adult, €4 per child) on sale at the Restaurant Mazières (5 trout per day).\r\nPicnic tables set up around the pond."
    ],
    "it": [
      "Pesca (1ª categoria = trota e coregone). Stagno di 800 m² in acque chiuse dove è possibile pescare senza licenza di pesca ma con la tessera comunale in vendita presso il ristorante Mazières:"
    ],
    "fr": [
      "Activité pêche (1e catégorie = truites et poissons blancs). Étang de 800 m² en eaux closes où l’on peut pêcher sans permis de pêche mais avec la carte communale en vente au Restaurant Mazières :"
    ],
    "nl": [
      "Visserijactiviteit (1ste categorie = forel & witvis). Meer van 800 m² in omheind water waar je kunt vissen zonder visvergunning maar met de gemeentekaart (€ 8 per dag per volwassene, € 4 per kind) te koop in het Restaurant Mazières (5 forellen per dag).\r\nPicknicktafels rond de vijver."
    ],
    "es": [
      "Pesca (1ª categoría = trucha y pescado blanco). Estanque de 800 m² en aguas cerradas donde se puede pescar sin licencia de pesca pero con la tarjeta comunal a la venta en el Restaurante Mazières:"
    ]
  },
  "rdfs:label": {
    "en": [
      "Saint-Saury trout fishing pond"
    ],
    "fr": [
      "Étang de pêche de Saint-Saury"
    ],
    "nl": [
      "Forellenvijver van Saint-Saury"
    ]
  },
