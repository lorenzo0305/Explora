  "rdfs:comment": {
    "de": [
      "Bei Sport 2000 finden Sie eine große Auswahl an Sport- und Freizeitartikeln: Mountainbikes, Skier, Bergausrüstung, Klettersteigausrüstung (Helm, Klettergurt, Flaschenzug)... zum Verkauf oder zur Miete."
    ],
    "en": [
      "Sport 2000 offers a wide selection of sports and leisure equipment: mountain bikes, skis, mountain gear, via ferrata equipment (helmets, harnesses, pulleys)... for sale or hire."
    ],
    "it": [
      "Sport 2000 offre un'ampia scelta di prodotti per lo sport e il tempo libero: mountain bike, sci, attrezzatura da montagna, attrezzatura da via ferrata (caschi, imbracature, carrucole)... in vendita o a noleggio."
    ],
    "fr": [
      "Retrouvez chez Sport 2000 une large sélection d'articles de sports et de loisirs : VTT, ski, matériel de montagne, matériel de via ferrata (casque, baudrier, harnais, poulie)... en vente ou à la location."
    ],
    "es": [
      "Sport 2000 ofrece una amplia selección de productos deportivos y de ocio: bicicletas de montaña, esquís, material de montaña, material de vía ferrata (cascos, arneses, poleas)... en venta o alquiler."
    ],
    "nl": [
      "Sport 2000 biedt een ruime keuze aan sport- en vrijetijdsproducten: mountainbikes, ski's, berguitrusting, via ferrata-uitrusting (helmen, harnassen, katrollen)... te koop of te huur."
    ]
  },
