  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel eines steil abfallenden Hügels scheint die Kapelle ND de Beauvoir (oder Beauver) über die Gemeinde Rousset zu wachen. Eine Draille (Schafsweg) vom Dorf aus führt Sie (1 Std.) zu diesem wichtigen Wallfahrtsort der weißen Büßer (Penitents blancs)."
    ],
    "en": [
      "Atop a sheer hill, Chapelle ND de Beauvoir (or Beauver) seems to watch over the commune of Rousset. A \"draille\" (sheep trail) from the village takes you (1h) to this important pilgrimage site of the white penitents."
    ],
    "it": [
      "In cima a una collina a strapiombo, la Chapelle ND de Beauvoir (o Beauvert) sembra vegliare sul comune di Rousset. Una \"draille\" (tratturo) dal villaggio vi porta (1h) a questo luogo di pellegrinaggio dei penitenti bianchi."
    ],
    "fr": [
      "Au sommet d’une colline en à pic, la Chapelle ND de Beauvoir (ou Beauvert) semble veiller sur la commune de Rousset. Une draille (sentier de moutons) au départ du village vous emmène (1h) vers ce haut-lieu de pèlerinage des pénitents blancs."
    ],
    "nl": [
      "Op de top van een steile heuvel lijkt de Chapelle ND de Beauvoir (of Beauver) over de gemeente Rousset te waken. Een \"draille\" (schapenpad) vanuit het dorp brengt je (1 uur) naar dit belangrijke bedevaartsoord van de witte boetelingen."
    ],
    "es": [
      "En lo alto de una colina escarpada, la Chapelle ND de Beauvoir (o Beauvert) parece vigilar el municipio de Rousset. Un \"draille\" (camino de ovejas) desde el pueblo lleva (1h) a este lugar de peregrinación de los penitentes blancos."
    ]
  },
