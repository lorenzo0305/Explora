  "rdfs:comment": {
    "de": [
      "Das Mikrofarm-Projekt von Nils und Nathalie wurde gerade erst ins Leben gerufen und hat zum Ziel, saisonales Gemüse mit Direktverkauf ab Hof in einem ländlichen territorialen Kontext in einem Mittelgebirge zu produzieren."
    ],
    "en": [
      "Nils and Nathalie's micro-farm project aims to produce seasonal vegetables and sell them directly from the farm in a rural mid-mountain context."
    ],
    "it": [
      "Il progetto di microfattoria di Nils e Nathalie è stato appena lanciato, con l'obiettivo di produrre verdure di stagione e venderle direttamente dalla fattoria in un ambiente rurale di media montagna."
    ],
    "fr": [
      "Le projet de micro ferme de Nils et Nathalie vient de voir le jour et a pour objectif de produire des légumes de saison avec une vente directe à la ferme dans un contexte territorial rural de moyenne montagne."
    ],
    "nl": [
      "Het microboerderijproject van Nils en Nathalie is net van start gegaan, met als doel seizoensgroenten te produceren en deze rechtstreeks van de boerderij te verkopen in een landelijke omgeving in het middengebergte."
    ],
    "es": [
      "El proyecto de microgranja de Nils y Nathalie acaba de ponerse en marcha, con el objetivo de producir verduras de temporada y venderlas directamente desde la granja, en un entorno rural de media montaña."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Jardins de Ruffieu - Organic market gardening"
    ],
    "fr": [
      "GAEC Les Jardins de Ruffieu - Maraichage bio"
    ]
  },
