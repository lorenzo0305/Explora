  "rdfs:comment": {
    "de": [
      "Nordicéa, das Tor zum Gebiet Savoie Grand Revard, liegt im Herzen des Waldes und empfängt Sie mit lokalen und saisonalen Spezialitäten sowie Überraschungen des Küchenchefs. Ein gemütlicher Raum, der für alle gedacht ist und besonders von Familien geschätzt wird."
    ],
    "en": [
      "At the gateway to the Savoie Grand Revard ski area, in the heart of the forest, Nordicéa welcomes you with its local, seasonal specialities and chef's surprises. A warm and inviting space designed for everyone, which will be particularly appreciated by families."
    ],
    "it": [
      "Alle porte del comprensorio sciistico Savoia Grand Revard, nel cuore della foresta, Nordicéa vi accoglie e celebra le specialità locali e stagionali e le sorprese dello chef. Un luogo caldo e invitante per tutti, che sarà particolarmente apprezzato dalle famiglie."
    ],
    "fr": [
      "Porte du domaine de Savoie Grand Revard, au cœur de la forêt, Nordicéa vous accueille et met à l'honneur les spécialités locales, de saison et les surprises du chef. Un espace chaleureux conçu pour tous, qui sera particulièrement apprécié des familles."
    ],
    "nl": [
      "Aan de poort van het skigebied Savoie Grand Revard, in het hart van het bos, verwelkomt Nordicéa u en viert lokale en seizoensgebonden specialiteiten en verrassingen van de chef. Een warme en uitnodigende plek voor iedereen, die vooral populair zal zijn bij gezinnen."
    ],
    "es": [
      "A las puertas del dominio esquiable de Savoie Grand Revard, en el corazón del bosque, Nordicéa le da la bienvenida y celebra las especialidades locales y de temporada y las sorpresas del chef. Un lugar cálido y acogedor para todos, que gustará especialmente a las familias."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Nordicéa - petite restauration, café, salon de thé"
    ]
  },
