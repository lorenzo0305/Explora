  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9b867ad2-299c-37ba-9d21-6cf6a5bf3709",
      "dc:description": {
        "de": [
          "Halloween ist im Office de Tourisme von Berck-sur-Mer zu Gast.\nWagst du es, an kleinen Spielen teilzunehmen, um Süßigkeiten zu ergattern?\n\nKostenlose Unterhaltung - Infos unter +33(0)3 21 09 50 00 oder tourisme@berck-sur-mer.com"
        ],
        "en": [
          "Halloween at the Berck-sur-Mer Tourist Office.\nDo you dare to play a few games to try and win some candy?\n\nFree entertainment - info +33(0)3 21 09 50 00 or tourisme@berck-sur-mer.com"
        ],
        "it": [
          "Halloween è in arrivo all'Ufficio del Turismo di Berck-sur-Mer.\nAvete il coraggio di fare qualche gioco e di provare a vincere qualche dolcetto?\n\nIntrattenimento gratuito - info +33(0)3 21 09 50 00 o tourisme@berck-sur-mer.com"
        ],
        "fr": [
          "Halloween s'invite à l'Office de Tourisme de Berck-sur-Mer. \nOseras-tu jouer à des petit jeux pour tenter de repartir avec des bonbons? \n\nAnimation gratuite- infos +33(0)3 21 09 50 00 ou tourisme@berck-sur-mer.com"
        ],
        "es": [
          "Halloween llega a la Oficina de Turismo de Berck-sur-Mer.\nTe atreverás con algunos juegos e intentarás ganar caramelos?\n\nAnimación gratuita - info +33(0)3 21 09 50 00 o tourisme@berck-sur-mer.com"
        ],
        "nl": [
          "Halloween komt naar het toeristenbureau van Berck-sur-Mer.\nDurf jij spelletjes te spelen en snoep te winnen?\n\nGratis animatie - info +33(0)3 21 09 50 00 of tourisme@berck-sur-mer.com"
        ]
      },
      "@type": [
        "Description"
      ],
