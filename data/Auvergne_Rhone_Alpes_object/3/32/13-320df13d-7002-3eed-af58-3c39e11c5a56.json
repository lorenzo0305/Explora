  "rdfs:comment": {
    "de": [
      "Ein Ort, eine Geschichte und eine außergewöhnliche Aussicht. Die 1760 am Ortseingang von Grignan erbaute Ferme Chapouton bietet 13 Zimmer mit hohem Komfort, ein Gourmet-Bistro und einen Swimmingpool, nur wenige Minuten vom Schloss entfernt. Schon bei Ihrer Ankunft wirkt der Charme."
    ],
    "en": [
      "A place, a history and an exceptional view. Built in 1760 at the edge of the village of Grignan, the Ferme Chapouton offers 13 rooms of great comfort as well as a bistro gourmand. A charming stay in the old holiday home of Nicolas de Staël."
    ],
    "it": [
      "Un luogo, una storia e una vista eccezionale. Costruita nel 1760 all'ingresso del villaggio di Grignan, la fattoria Chapouton offre 13 camere confortevoli, un bistrot gourmet e una piscina a pochi minuti dal castello. Dal momento dell'arrivo, il fascino si fa sentire."
    ],
    "fr": [
      "Un lieu, une histoire et une vue exceptionnelle. Construite en 1760 à l’entrée du village de Grignan, la Ferme Chapouton propose 13 chambres grand confort un bistro gourmand et une piscine à quelques minutes du château. Dès votre arrivée le charme opère."
    ],
    "es": [
      "Un lugar, una historia y una vista excepcional. Construida en 1760 a la entrada del pueblo de Grignan, la Granja Chapouton ofrece 13 cómodas habitaciones, un bistró gourmet y una piscina a pocos minutos del castillo. Desde el momento en que llegas, el encanto está servido."
    ],
    "nl": [
      "Een plek, een geschiedenis en een uitzonderlijk uitzicht. Ferme Chapouton, gebouwd in 1760 bij de ingang van het dorp Grignan, biedt 13 comfortabele kamers, een gastronomische bistro en een zwembad op slechts een paar minuten van het kasteel. Je zult gecharmeerd zijn vanaf het moment dat je aankomt."
    ]
  },
