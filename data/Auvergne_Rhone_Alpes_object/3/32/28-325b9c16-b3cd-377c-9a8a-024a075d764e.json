  "rdfs:comment": {
    "de": [
      "Nach der Honigernte werden die Produkte (Honig und Pollen) nach Vereinbarung verkauft. Auf der Facebook-Seite finden Sie die Termine für Veranstaltungen und auf der Website www.acheteralasource.com"
    ],
    "en": [
      "After harvesting the honey, the products (honey - pollen) are on sale by appointment, follow the facebook page for the date of events and on the website www.acheteralasource.com"
    ],
    "it": [
      "Dopo la raccolta del miele, i prodotti (miele - polline) sono in vendita su prenotazione, seguendo la pagina facebook per le date degli eventi e sul sito www.acheteralasource.com"
    ],
    "fr": [
      "Après récolte du miel, les produits (miel - pollen) sont en vente sur rdv ,suivre la page facebook pour les date événements et sur le site www.acheteralasource.com"
    ],
    "nl": [
      "Na het oogsten van de honing zijn de producten (honing - stuifmeel) te koop op afspraak, volg de facebookpagina voor de data van de evenementen en op de website www.acheteralasource.com"
    ],
    "es": [
      "Después de la cosecha de la miel, los productos (miel - polen) están a la venta con cita previa, siga la página de facebook para las fechas de los eventos y en el sitio web www.acheteralasource.com"
    ]
  },
