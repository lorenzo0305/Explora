  "rdfs:comment": {
    "de": [
      "Der Korso steht unter dem Motto \"Chabeuil geht in den Urlaub\" mehr als zwanzig Wagen, begleitet von drei Musikgruppen, Majoretten und vielen anderen Überraschungen."
    ],
    "en": [
      "The theme of the parade will be \"Chabeuil goes on vacation\" with more than twenty floats, accompanied by three musical groups, majorettes and many other surprises."
    ],
    "it": [
      "Il tema della sfilata sarà \"Chabeuil va in vacanza\" con più di venti carri, accompagnati da tre gruppi musicali, majorette e molte altre sorprese."
    ],
    "fr": [
      "Le thème du corso sera “Chabeuil part en vacances” : plus d'une vingtaine de chars, accompagnés de trois formations musicales, des majorettes et bien d'autres surprises."
    ],
    "nl": [
      "Het thema van de parade is \"Chabeuil gaat op vakantie\" met meer dan twintig praalwagens, begeleid door drie muziekgroepen, majorettes en vele andere verrassingen."
    ],
    "es": [
      "El tema del desfile será \"Chabeuil se va de vacaciones\" con más de veinte carrozas, acompañadas por tres grupos musicales, majorettes y muchas otras sorpresas."
    ]
  },
