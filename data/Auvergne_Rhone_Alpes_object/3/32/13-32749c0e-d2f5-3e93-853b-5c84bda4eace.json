  "rdfs:comment": {
    "de": [
      "Vermietung von Gokarts von 6 bis 99 Jahren. Organisation von Challenges oder Endurances. Auf einer 1 km langen Piste 300 französische Meisterschaften. Elektrische Motorrad- und Autopiste für Kinder unter 6 Jahren. Im Sommer donnerstags nächtliche Kartsessions bis Mitternacht !"
    ],
    "en": [
      "Go-kart hire for ages 6 to 99. Organisation of challenges and endurance events. On a 1km 300 French championship track. Electric motorbike and car track for children under 6. In summer, night karting sessions until midnight on Thursdays !"
    ],
    "it": [
      "Noleggio di go-kart dai 5 ai 99 anni. Organizzazione di sfide ed eventi di resistenza. Su una pista di 1 km del campionato francese 300. Pista per moto e auto elettriche per bambini sotto i 5 anni. In estate, sessioni di karting notturno fino a mezzanotte il martedì!"
    ],
    "fr": [
      "Location de karting de 5 à 99 ans. Organisation de challenges ou d'endurances. Sur une piste de 1km 300 de championnat de France. Piste moto et auto électriques pour les moins de 5 ans. En été le mardi, séances de kart en nocturne jusqu'à minuit !"
    ],
    "nl": [
      "Verhuur van skelters voor kinderen van 6 tot 99 jaar. Organisatie van uitdagingen en uithoudingsevenementen. Op een circuit van 1 km met 300 Franse kampioenschappen. Circuit voor elektrische motoren en auto's voor kinderen jonger dan 6 jaar. In de zomer nachtelijke kartsessies tot middernacht op donderdag !"
    ],
    "es": [
      "Alquiler de karts de 5 a 99 años. Organización de desafíos y pruebas de resistencia. En una pista de 1 km del campeonato francés de 300. Pista de motos y coches eléctricos para niños menores de 5 años. En verano, ¡sesiones nocturnas de karting hasta medianoche los martes!"
    ]
  },
