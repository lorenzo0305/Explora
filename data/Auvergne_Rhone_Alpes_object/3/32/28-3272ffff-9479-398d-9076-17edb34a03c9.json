      "dc:description": {
        "de": [
          "Im Krieg zerstört, wieder aufgebaut und 2003 erneut zerstört, wurde diese Kirche dank Stahlbeton auf modernere Weise wieder aufgebaut."
        ],
        "en": [
          "Destroyed during the war, rebuilt and destroyed again in 2003, this church was rebuilt in a more modern style using reinforced concrete."
        ],
        "it": [
          "Distrutta durante la guerra, ricostruita e poi nuovamente distrutta nel 2003, questa chiesa è stata ricostruita in uno stile più moderno utilizzando il cemento armato."
        ],
        "fr": [
          "Détruite durant la guerre, reconstruite, puis à nouveau détruite en 2003, cette église fut reconstruite de manière plus moderne grâce au béton armé."
        ],
        "nl": [
          "Deze kerk werd verwoest tijdens de oorlog, herbouwd en opnieuw verwoest in 2003 en werd herbouwd in een modernere stijl met gebruik van gewapend beton."
        ],
        "es": [
          "Destruida durante la guerra, reconstruida y destruida de nuevo en 2003, esta iglesia fue reconstruida en un estilo más moderno utilizando hormigón armado."
        ]
      },
