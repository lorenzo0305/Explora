  "rdfs:comment": {
    "de": [
      "Der Saal der Schwalben ist ein 65m² großer Saal mit angrenzender Küchenzeile und einer behindertengerechten Sanitäranlage.\r\nEr ist mit Tischen und Stühlen, einer Leinwand, einem Videoprojektor und einem Flipchart ausgestattet."
    ],
    "en": [
      "The \"salle des hirondelles\" is a 65m² room with an adjoining kitchenette and sanitary facilities suitable for people with reduced mobility.\r\nEquipped with tables and chairs, a projection screen, a video projector and a paper-board."
    ],
    "it": [
      "La Salle des Hirondelles è una sala di 65 m² con angolo cottura annesso e servizi igienici, adatta alle persone con mobilità ridotta.\r\nÈ dotata di tavoli e sedie, schermo per proiezioni, videoproiettore e lavagna a fogli mobili."
    ],
    "fr": [
      "La salle des hirondelles est une salle de 65m² avec attenant une kitchenette et un sanitaire adapté aux personnes à mobilité réduite .\r\nÉquipée de tables et de chaises, d’un écran de projection , d’un vidéoprojecteur et d’un tableau paper-board."
    ],
    "es": [
      "La Salle des Hirondelles es una sala de 65 m² con cocina americana contigua y cuarto de baño adaptado para personas con movilidad reducida.\r\nEstá equipada con mesas y sillas, una pantalla de proyección, un videoproyector y un rotafolio."
    ],
    "nl": [
      "De Salle des Hirondelles is een ruimte van 65 m² met een aangrenzende kitchenette en badkamerfaciliteiten die geschikt is voor mensen met beperkte mobiliteit.\r\nZe is uitgerust met tafels en stoelen, een projectiescherm, een videoprojector en een flipchart."
    ]
  },
  "rdfs:label": {
