  "rdfs:comment": {
    "de": [
      "Starten Sie in Romme! Eine markierte und gesicherte Strecke ist ideal, um mit dem Skitourengehen zwischen verschneiten Tannen und frischer Luft zu beginnen. Sie finden diese ungefährliche Strecke nur wenige Schritte vom Skilift Chavannes entfernt. Die Berge warten auf Sie!"
    ],
    "en": [
      "Take the plunge at Romme! A safe, signposted trail, ideal for beginner ski touring between snow-covered fir trees and the great outdoors. This safe trail is just a stone's throw from the Chavannes ski lift. The mountains await you!"
    ],
    "it": [
      "Fate il grande salto a Romme! Un percorso sicuro e segnalato, ideale per lo sci alpinismo per principianti tra abeti innevati e la natura. Questo percorso sicuro si trova a pochi passi dall'impianto di risalita di Chavannes. Le montagne vi aspettano!"
    ],
    "fr": [
      "Lancez-vous à Romme ! Un tracé balisé et sécurisé, idéal pour débuter le ski de rando entre sapins enneigés et grand air. Retrouvez ce parcours sans danger à deux pas du téléski des Chavannes. La montagne vous attend !"
    ],
    "es": [
      "¡Atrévase en Romme! Una ruta segura y señalizada, ideal para iniciarse en el esquí de travesía entre abetos nevados y la naturaleza. Este itinerario seguro se encuentra a dos pasos del telesilla de Chavannes. ¡La montaña te espera!"
    ],
    "nl": [
      "Waag de sprong in Romme! Een veilige, bewegwijzerde route, ideaal voor beginnende skiërs tussen besneeuwde dennenbomen en de vrije natuur. Deze veilige route ligt op een steenworp afstand van de skilift van Chavannes. De bergen wachten op je!"
    ]
  },
  "rdfs:label": {
