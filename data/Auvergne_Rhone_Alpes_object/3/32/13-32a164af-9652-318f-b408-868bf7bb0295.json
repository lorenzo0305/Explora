  "rdfs:comment": {
    "de": [
      "In der Eishalle von Courchevel können Sie sich auf dem Eis vergnügen, Eishockey-Shows und -Matches ansehen - im Winter wie im Sommer!"
    ],
    "en": [
      "In Courchevel's ice skating rink, come and have fun on the ice, watch beautiful shows and sporty hockey matches, in summer and in winter !"
    ],
    "it": [
      "Alla pista di pattinaggio di Courchevel, venite a divertirvi sul ghiaccio, ad assistere a spettacoli e partite di hockey, in inverno e in estate!"
    ],
    "fr": [
      "À la patinoire de Courchevel, venez vous amuser sur la glace, assister à des spectacles et matchs de hockey, en hiver comme en été !"
    ],
    "nl": [
      "Kom op de ijsbaan van Courchevel plezier maken op het ijs, shows en ijshockeywedstrijden bekijken, zowel in de winter als in de zomer!"
    ],
    "es": [
      "En la pista de hielo de Courchevel, venga a divertirse sobre el hielo, a ver espectáculos y partidos de hockey, ¡tanto en invierno como en verano!"
    ]
  },
