  "rdfs:comment": {
    "de": [
      "Kommen Sie an Bord meines Bootes und die Jagd nach Raubfischen wird kein Geheimnis mehr für Sie sein. Profitieren Sie von meiner persönlichen Beratung und meiner 15-jährigen Erfahrung, um das Potenzial der Seen des Zentralmassivs zu entdecken!"
    ],
    "en": [
      "Come aboard my boat and you'll know all about stalking predators. Benefit from personalized advice and my 15 years of experience to discover the potential of the lakes of the Massif Central!"
    ],
    "it": [
      "Salite a bordo della mia barca e saprete tutto sulla caccia ai predatori. Approfittate di una consulenza personalizzata e di 15 anni di esperienza per scoprire il potenziale dei laghi del Massiccio Centrale!"
    ],
    "fr": [
      "Montez à bord de mon bateau et la traque des carnassiers n’aura plus de secret pour vous. Bénéficiez de conseils personnalisés et de mes 15 années d’expérience pour découvrir le potentiel des lacs du Massif Central !"
    ],
    "es": [
      "Sube a bordo de mi barco y lo sabrás todo sobre el acecho de los depredadores. ¡Benefíciate de un asesoramiento personalizado y de 15 años de experiencia para descubrir el potencial de los lagos del Macizo Central!"
    ],
    "nl": [
      "Kom aan boord van mijn boot en je zult alles weten over het besluipen van roofdieren. Profiteer van persoonlijk advies en 15 jaar ervaring om het potentieel van de meren van het Centraal Massief te ontdekken!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Arnaud Landrieu / Guide de pêche"
    ]
  },
