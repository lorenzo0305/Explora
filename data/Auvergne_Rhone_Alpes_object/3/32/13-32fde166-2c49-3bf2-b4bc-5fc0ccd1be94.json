  "rdfs:comment": {
    "de": [
      "Der Minigolfplatz von Saint-Gervais befindet sich im Herzen des Sportzentrums \"Le Sporting Club\".\r\nJede Bahn ist eine kleine, originelle Herausforderung, die es mit möglichst wenigen Schlägen zu bewältigen gilt."
    ],
    "en": [
      "The mini-golf in Saint-Gervais is located at the heart of the sports centre.\r\nEach hole is a challenge, to be completed in as fewer strokes as possible."
    ],
    "it": [
      "Il minigolf di Saint-Gervais si trova nel cuore del centro polisportivo comunale “Le Sporting club”.\r\nOgni pista rappresenta una piccola sfida originale da completarsi con il minor numero di colpi."
    ],
    "fr": [
      "Le minigolf de Saint-Gervais est situé au coeur du centre sportif ‘’Le Sporting Club’’.\r\nChacune des pistes est un petit défi original qu’il convient de réaliser en un minimum de coups."
    ],
    "es": [
      "El minigolf de Saint-Gervais está situado en el corazón del centro deportivo Sporting Club.\r\nCada pista es un reto original que hay que completar en el menor número de golpes posible."
    ],
    "nl": [
      "De minigolfbaan van Saint-Gervais ligt in het hart van het sportcentrum Sporting Club.\r\nElke baan is een originele uitdaging die je in zo weinig mogelijk slagen moet afleggen."
    ]
  },
