  "rdfs:comment": {
    "de": [
      "Yummy ist ein asiatisches, kambodschanisches, vietnamesisches und thailändisches Restaurant, das eine Vielzahl von Gerichten anbietet, die sich von Tag zu Tag weiterentwickeln und verändern werden, je nach den Wünschen des Küchenchefs."
    ],
    "en": [
      "Yummy is an Asian, Cambodian, Vietnamese and Thai restaurant that offers a variety of dishes that will evolve and change from day to day according to the chef's desires."
    ],
    "it": [
      "Yummy è un ristorante asiatico, cambogiano, vietnamita e tailandese che offre una varietà di piatti che si evolvono e cambiano di giorno in giorno secondo i desideri dello chef."
    ],
    "fr": [
      "Yummy est un restaurant asiatique, cambodgien, vietnamien et thai qui propose une variété de plat qui va évoluer et changer de jour en jour selon les envies du chef."
    ],
    "nl": [
      "Yummy is een Aziatisch, Cambodjaans, Vietnamees en Thais restaurant dat een verscheidenheid aan gerechten biedt die van dag tot dag evolueren en veranderen volgens de wensen van de chef."
    ],
    "es": [
      "Yummy es un restaurante asiático, camboyano, vietnamita y tailandés que ofrece una variedad de platos que evolucionan y cambian de un día para otro según los deseos del chef."
    ]
  },
