  "rdfs:comment": {
    "de": [
      "Bar/Restaurant/Brasserie/Eisdiele, in der traditionelle Küche in einem Saal mit 45 Plätzen serviert wird. An schönen Tagen wird auf der Terrasse mit 50 Plätzen serviert. Im Juli und August Abendgastronomie."
    ],
    "en": [
      "Bar/Restaurant/Brasserie/Glacier serving traditional cuisine in a 45-seat dining room. In fine weather, service on the 50-seat terrace. Evening catering in July and August."
    ],
    "it": [
      "Bar/Ristorante/Brasserie/Glacier con cucina tradizionale in una sala da 45 posti. Nella bella stagione, servizio sulla terrazza da 50 posti. Cena serale in luglio e agosto."
    ],
    "fr": [
      "Bar/Restaurant/Brasserie/Glacier où est servie une cuisine traditionnelle dans une salle de 45 couverts. Aux beaux jours, service en terrasse de 50 places. Restauration le soir en juillet et en août."
    ],
    "es": [
      "Bar/Restaurante/Brasserie/Glacier que sirve cocina tradicional en un comedor de 45 plazas. Cuando hace buen tiempo, servicio en la terraza de 50 plazas. Cena por la noche en julio y agosto."
    ],
    "nl": [
      "Bar/Restaurant/Brasserie/Glacier serveert traditionele gerechten in een eetzaal met 45 zitplaatsen. Bij mooi weer bediening op het terras met 50 zitplaatsen. Avondeten in juli en augustus."
    ]
  },
  "rdfs:label": {
