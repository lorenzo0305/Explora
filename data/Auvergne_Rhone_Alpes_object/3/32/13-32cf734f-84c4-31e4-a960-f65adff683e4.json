  "rdfs:comment": {
    "de": [
      "Private Weinkellerei seit vier Generationen, heute vom Vater auf die Tochter. Ich produziere Clairette de Die AOC Tradition und Brut, Weißweine und Traubensaft auf einem 7 Hektar großen Betrieb, der im Herzen von Barsac und der Appellation liegt."
    ],
    "en": [
      "Independent winery for 4 generations, from father to daughters today.\r\nI  produce an AOC Clairette de Die Tradition and Brut on a 7-hectare farm at the heart of Barsac and the designated area."
    ],
    "it": [
      "Una cantina privata da quattro generazioni, da padre a figlia oggi. Produco Clairette de Die AOC Tradition e Brut, vini bianchi e succhi d'uva in una tenuta di 7 ettari nel cuore di Barsac e della denominazione."
    ],
    "fr": [
      "Cave particulière depuis quatre générations, de père en fille aujourd'hui. Je produis de la Clairette de Die AOC Tradition et Brut, des vins blancs et du jus de raisin sur une exploitation de 7 hectares, au cœur de Barsac et de l'appellation."
    ],
    "es": [
      "Una bodega privada desde hace cuatro generaciones, de padre a hija en la actualidad. Produzco Clairette de Die AOC Tradition y Brut, vinos blancos y mosto en una finca de 7 hectáreas en el corazón de Barsac y de la denominación."
    ],
    "nl": [
      "Privé-wijnkelder al vier generaties lang, van vader op dochters. We produceren Clairette de Die AOC Tradition en Brut, AOC Côteaux de Die op een stuk grond van 14 hectare, in het hart van Barsac en appellation."
    ]
  },
