  "rdfs:comment": {
    "de": [
      "Wenn Sie durch die engen Gassen schlendern, tauchen Sie in die mittelalterliche Vergangenheit von Saint?Saturnin ein, von der noch heute mehrere Bauwerke zeugen."
    ],
    "en": [
      "As you stroll through the narrow streets, you'll be immersed in Saint-Saturnin's medieval past, to which several buildings still bear witness today."
    ],
    "it": [
      "Passeggiando per le stradine, vi immergerete nel passato medievale di Saint-Saturnin, di cui alcuni edifici sono ancora oggi testimoni."
    ],
    "fr": [
      "En déambulant dans les ruelles étroites, vous plongez dans le passé médiéval de Saint‑Saturnin, dont plusieurs constructions témoignent encore aujourd’hui."
    ],
    "nl": [
      "Terwijl je door de smalle straatjes wandelt, word je ondergedompeld in het middeleeuwse verleden van Saint-Saturnin, waarvan een aantal gebouwen vandaag de dag nog getuigen."
    ],
    "es": [
      "Mientras pasea por sus callejuelas, se sumergirá en el pasado medieval de Saint-Saturnin, del que aún hoy son testigos numerosos edificios."
    ]
  },
  "rdfs:label": {
    "fr": [
