  "rdfs:comment": {
    "de": [
      "Das Sky Spa befindet sich in der Residenz Sky la Rosière und bietet Massagen, Gesichts- und Körperbehandlungen, Kinderbehandlungen, ein Kosmetikstudio und einen Nagelstudio. Bei den Massagen, Körper- und Gesichtsbehandlungen haben Sie vor Ihrer Behandlung eine Stunde lang Zugang zum Wasserbereich."
    ],
    "en": [
      "Located within the Sky La Rosière residence, the Sky Spa offers massages, facials, body treatments, children's treatments, a beauty salon, and nail services. Massages, body and facial treatments give you access to the aquatic area for 1 hour before your treatment."
    ],
    "it": [
      "Situata all'interno del residence Sky La Rosière, la Sky Spa offre massaggi, trattamenti viso, trattamenti corpo, trattamenti per bambini, un salone di bellezza e servizi per unghie. Massaggi, trattamenti corpo e viso danno diritto all'accesso all'area acquatica per 1 ora prima del trattamento."
    ],
    "fr": [
      "Situé au sein de la résidence Sky la Rosière, le Sky Spa propose massages, soins du visage, soins corps, soins enfants, institut, et onglerie. Les massages et les soins corps et visage vous donnent accès à l'espace aquatique pendant 1h avant votre soin."
    ],
    "es": [
      "Situado en la residencia Sky la Rosière, el Sky Spa ofrece masajes, tratamientos faciales, tratamientos corporales, tratamientos infantiles, un instituto y un salón de manicura. Los masajes y tratamientos corporales y faciales le dan acceso a la zona acuática durante 1 hora antes de su tratamiento."
    ],
    "nl": [
      "De Sky Spa ligt in de Sky la Rosière residentie en biedt massages, gezichtsbehandelingen, lichaamsbehandelingen, kinderbehandelingen, een instituut en een nagelsalon. Bij massages en lichaams- en gezichtsbehandelingen heb je 1 uur voor je behandeling toegang tot het zwemparadijs."
    ]
  },
