  "rdfs:comment": {
    "de": [
      "Michel Valhorgues stellt seine Werke aus, die die Landschaften des Haut Forez darstellen. Sein Atelier befindet sich in der Rue du Moulin in Marols zusammen mit anderen Künstlern."
    ],
    "en": [
      "Michel Valhorgues exhibits his works depicting the landscapes of Haut Forez. His studio is on rue du moulin in Marols, along with other artists."
    ],
    "it": [
      "Michel Valhorgues espone le sue opere che raffigurano i paesaggi della regione dell'Haut Forez. Il suo studio si trova in rue du Moulin a Marols, insieme ad altri artisti."
    ],
    "fr": [
      "Michel Valhorgues expose ses œuvres représentant les paysages du Haut Forez. Son atelier se trouve rue du moulin à Marols avec d'autres artistes."
    ],
    "nl": [
      "Michel Valhorgues stelt zijn werken tentoon die de landschappen van de Haut Forez uitbeelden. Zijn atelier bevindt zich in de rue du Moulin in Marols, samen met andere kunstenaars."
    ],
    "es": [
      "Michel Valhorgues expone sus obras que representan los paisajes de la región de Haut Forez. Su taller se encuentra en la rue du Moulin, en Marols, junto a otros artistas."
    ]
  },
