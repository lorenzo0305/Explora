  "rdfs:comment": {
    "de": [
      "Das Musée de la Ferme des Orgues bietet eine unvergessliche Reise durch seine Sammlung von mechanischen Instrumenten, die mit Leidenschaft restauriert wurden. die Miniatur-Spieldosen und majestätischen Orchestrien werden Groß und Klein in Erstaunen versetzen."
    ],
    "en": [
      "The Musée de la Ferme des Orgues offers an unforgettable journey through its collection of passionately restored mechanical instruments. miniature music boxes and majestic orchestrions will amaze young and old alike."
    ],
    "it": [
      "Il Musée de la Ferme des Orgues offre un viaggio indimenticabile attraverso la sua collezione di strumenti meccanici restaurati con passione. carillon in miniatura e maestosi orchestrali stupiranno grandi e piccini."
    ],
    "fr": [
      "Le Musée de la Ferme des Orgues offre un voyage inoubliable au milieu de sa collection d’instruments mécaniques restaurés avec passion. : boites à musique miniatures et orchestrions majestueux épateront petits et grands."
    ],
    "nl": [
      "Het Musée de la Ferme des Orgues biedt een onvergetelijke reis door de collectie met passie gerestaureerde mechanische instrumenten. miniatuur muziekdoosjes en majestueuze orchestrions zullen jong en oud versteld doen staan."
    ],
    "es": [
      "El Musée de la Ferme des Orgues ofrece un viaje inolvidable a través de su colección de instrumentos mecánicos restaurados con pasión. cajas de música en miniatura y majestuosas orquestas asombrarán a grandes y pequeños."
    ]
  },
  "rdfs:label": {
