  "rdfs:comment": {
    "de": [
      "Die Bibliothek in Villargondran bietet eine große Auswahl an Jugend- und Erwachsenenbüchern: Romane (verschiedene, Krimis, Savoyen...) Comics, Sachbücher (Tourismus und Wandern, Medizin, Geschichte) etc."
    ],
    "en": [
      "The Villargondran library offers a wide choice of books for young people and adults: novels (miscellaneous, detective stories, Savoyard...), comics, documentaries (tourism and hiking, medicine, history), etc."
    ],
    "it": [
      "La biblioteca di Villargondran offre un'ampia scelta di libri per giovani e adulti: romanzi (di vario genere, gialli, savoiardi, ecc.), fumetti, documentari (turismo ed escursionismo, medicina, storia), ecc."
    ],
    "fr": [
      "La bibliothèque de Villargondran propose un large choix de livres jeunesse et adulte : romans (divers, policiers, savoyards...) BD, documentaires (tourisme et randonnée, médecine, histoire) etc."
    ],
    "es": [
      "La biblioteca de Villargondran ofrece una amplia gama de libros para jóvenes y adultos: novelas (misceláneas, policíacas, saboyanas, etc.), cómics, documentales (turismo y senderismo, medicina, historia), etc."
    ],
    "nl": [
      "De bibliotheek van Villargondran biedt een breed scala aan boeken voor jongeren en volwassenen: romans (diversen, detectiveverhalen, Savoyaardse romans, etc.), stripverhalen, documentaires (toerisme en wandeltochten, geneeskunde, geschiedenis), etc."
    ]
  },
