  "rdfs:comment": {
    "de": [
      "SEIEN SIE BEREIT, SICH AUF ETWAS GEFASST ZU MACHEN\r\nDas neben dem Belvédère du Mont du Chat gelegene Restaurant des Aigles bietet Ihnen lokale und savoyische Küche und einen außergewöhnlichen 360°-Blick auf den Lac du Bourget und die Alpenberge!"
    ],
    "en": [
      "GET READY TO BE AMAZED\r\nOn the Mont du Chat Belvedere, the \"Restaurant des Aigles\" offers local and Savoyard cuisine and an exceptional 360° view of Lac du Bourget and the Alps !"
    ],
    "it": [
      "PREPARATEVI A ESSERE STUPITI\r\nSituato accanto al Belvedere del Mont du Chat, il Relais des Aigles offre una vista eccezionale a 360° sul Lac du Bourget e sulle Alpi."
    ],
    "fr": [
      "SOYEZ PRÊT À EN PRENDRE PLEIN LA VUE \r\nInstallé à côté du Belvédère du Mont du Chat, le Restaurant des Aigles vous propose une cuisine locale et savoyarde et une vue exceptionnelle à 360° sur le lac du Bourget et les montagnes alpines !"
    ],
    "es": [
      "PREPÁRESE PARA ASOMBRARSE\r\nSituado junto al mirador del Mont du Chat, el Restaurante des Aigles ofrece cocina local y saboyana y una vista excepcional de 360° sobre el lago Bourget y los Alpes"
    ],
    "nl": [
      "MAAK JE KLAAR OM VERSTELD TE STAAN\r\nRelais des Aigles ligt naast de Mont du Chat Belvedere en biedt een uitzonderlijk uitzicht van 360° op het Lac du Bourget en de Alpen."
    ]
  },
