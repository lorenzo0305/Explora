  "rdfs:comment": {
    "de": [
      "1 Orientierungslauf ab dem Standort Sailhant (Parkplatz gegenüber dem Schloss). 9 Markierungen. Karte zum Herunterladen oder in den Tourismusbüros erhältlich. Denken Sie daran, einen Kompass mitzunehmen."
    ],
    "en": [
      "1 orienteering course starting from the Sailhant site (parking lot opposite the château). 9 markers. Map available for download or from tourist offices. Don't forget your compass."
    ],
    "it": [
      "1 percorso di orientamento con partenza dal sito di Sailhant (parcheggio di fronte al castello). 9 marcatori. Mappa scaricabile o disponibile presso gli uffici turistici. Ricordarsi di portare una bussola."
    ],
    "fr": [
      "1 parcours d'orientation au départ du du site du Sailhant (Parking en face du château). 9 balises. Carte en téléchargement ou disponible auprès des offices de tourisme. Pensez à prendre une boussole."
    ],
    "es": [
      "1 recorrido de orientación a partir del emplazamiento de Sailhant (aparcamiento frente al castillo). 9 balizas. Mapa disponible para descargar o en las oficinas de turismo. No olvide llevar una brújula."
    ],
    "nl": [
      "1 oriëntatieloop vanaf de Sailhant site (parkeerplaats tegenover het kasteel). 9 markeringen. Kaart beschikbaar om te downloaden of bij de toeristenbureaus. Vergeet niet een kompas mee te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours d'orientation du Sailhant (Andelat)"
    ]
  },
