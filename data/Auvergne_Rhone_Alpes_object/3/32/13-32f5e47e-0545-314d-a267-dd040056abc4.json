  "rdfs:comment": {
    "de": [
      "Emmanuel Liotier, Messerschmied, schmiedet verschiedene Klingen, aber auch kleine Schmiedeprojekte (Flaschenöffner, Mantelhalter usw.).\r\nVollständige Personalisierung des Objekts.\r\nBietet Praktika für maximal 2 Personen an"
    ],
    "en": [
      "Emmanuel Liotier, cutlery blacksmith, forges a wide variety of blades, as well as small metalwork projects (bottle-opener, coat hanger, etc.).\r\nTotal object customization\r\nTraining courses for a maximum of 2 people"
    ],
    "it": [
      "Emmanuel Liotier, forgiatore di posate, forgia un'ampia varietà di lame e piccoli lavori in ferro (apribottiglie, appendiabiti, ecc.).\r\nPersonalizzazione totale dell'oggetto\r\nOffre corsi per un massimo di 2 persone"
    ],
    "fr": [
      "Emmanuel Liotier,  coutelier forgeron,  forge des lames diverses et variées mais aussi des petits projets de ferronnerie (décapsuleur, porte manteau etc).\r\nPersonnalisation totale de l'objet\r\nPropose des stages maximum 2 personnes"
    ],
    "es": [
      "Emmanuel Liotier, forjador de cuchillería, forja una gran variedad de cuchillas, así como pequeños proyectos de forja (abrebotellas, percha, etc.).\r\nPersonalización total del objeto\r\nOfrece cursos para un máximo de 2 personas"
    ],
    "nl": [
      "Emmanuel Liotier, besteksmid, smeedt een grote verscheidenheid aan messen, maar ook kleine ijzerwaren (flesopener, kleerhanger, enz.).\r\nTotale personalisatie van het object\r\nBiedt cursussen voor maximaal 2 personen"
    ]
  },
