  "rdfs:comment": {
    "de": [
      "Die Chocolatiers La Caraque verwöhnen Ihren Gaumen seit 1954. Die in Grenoble im Département Isère ansässigen Chocolatiers haben es sich zur Aufgabe gemacht, Sie mit neuen Geschmacksrichtungen zu überraschen, die auf der Grundlage von außergewöhnlichen Produkten hergestellt werden."
    ],
    "en": [
      "La Caraque chocolatiers have been delighting your taste buds since 1954. Based in Grenoble in the Isère region, these chocolatiers are committed to surprising you with new flavors made from exceptional products."
    ],
    "it": [
      "I cioccolatieri La Caraque deliziano il vostro palato dal 1954. Con sede a Grenoble, nella regione dell'Isère, questi cioccolatieri si impegnano a sorprendervi con nuovi sapori realizzati con prodotti eccezionali."
    ],
    "fr": [
      "Les artisans chocolatiers La Caraque régalent vos papilles depuis 1954. Installés à Grenoble en Isère, ces chocolatiers ont à coeur de vous surprendre avec de nouvelles saveurs confectionnées à base de produits d'exception."
    ],
    "es": [
      "Los chocolateros de La Caraque llevan deleitando su paladar desde 1954. Con sede en Grenoble, en la región de Isère, estos chocolateros se comprometen a sorprenderle con nuevos sabores elaborados a partir de productos excepcionales."
    ],
    "nl": [
      "De chocolatiers van La Caraque verwennen je smaakpapillen al sinds 1954. Deze chocolatiers, gevestigd in Grenoble in de Isère, doen er alles aan om je te verrassen met nieuwe smaken op basis van uitzonderlijke producten."
    ]
  },
  "rdfs:label": {
