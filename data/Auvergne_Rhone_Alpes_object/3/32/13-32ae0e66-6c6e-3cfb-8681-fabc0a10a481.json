  "rdfs:comment": {
    "de": [
      "Unser Sportgeschäft befindet sich auf dem Forum und empfängt Sie auf einer Fläche von 500 m². Wir sind spezialisiert auf den Verleih von Skiern und Snowboards, den Verkauf von Ausrüstung und Zubehör, technischen Textilien und Sportwaffen."
    ],
    "en": [
      "Located on the forum, our sports store welcomes you over a surface area of 500 m2. We specialise in hiring skis and snowboards and selling major equipment, accessory, technical textile and sportswear brands."
    ],
    "it": [
      "Situato nel Forum, il nostro negozio di articoli sportivi si estende su 500 m². Siamo specializzati nel noleggio di sci e snowboard, attrezzature e accessori, tessuti tecnici e abbigliamento sportivo."
    ],
    "fr": [
      "Situé sur le forum, notre magasin de sport vous accueille sur une surface de 500 m². Nous sommes spécialisés dans la location de skis et de snowboards, dans la vente de matériels et d’accessoires, de textiles techniques et de sportwears."
    ],
    "es": [
      "Situada en el Foro, nuestra tienda de deportes ocupa 500 m². Estamos especializados en alquiler de esquís y snowboards, equipamiento y accesorios, textiles técnicos y ropa deportiva."
    ],
    "nl": [
      "Onze sportwinkel bevindt zich in het Forum en beslaat 500 m². Wij zijn gespecialiseerd in ski- en snowboardverhuur, uitrusting en accessoires, technisch textiel en sportkleding."
    ]
  },
  "rdfs:label": {
    "en": [
