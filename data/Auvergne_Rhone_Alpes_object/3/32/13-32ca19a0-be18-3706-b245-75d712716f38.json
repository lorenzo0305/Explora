  "rdfs:comment": {
    "de": [
      "Betreute Naturausflüge in der Ardèche (Gard, Lozère, Drôme). Mountainbike, Kanu-Kajak, Wandern, Trail, Naturveranstaltungen... Diplomierter Führer für alle Niveaus. Spaß, Respekt vor der Natur und Wohlbefinden stehen im Vordergrund."
    ],
    "en": [
      "Supervised nature breaks in the Ardèche (Gard, Lozère, Drôme). Mountain biking, Canoeing, Kayaking, Hiking, Trail, Nature activities... Qualified guides for all levels. Priority to pleasure, respect for nature and well-being."
    ],
    "it": [
      "Interventi naturalistici supervisionati nell'Ardèche (Gard, Lozère, Drôme). Mountain bike, canoa, kayak, escursioni, sentieri, attività naturalistiche... Guide qualificate per tutti i livelli. Priorità al piacere, al rispetto della natura e al benessere."
    ],
    "fr": [
      "Évasion nature encadrée en Ardèche (Gard, Lozère, Drôme). VTT, Canoë-Kayak, Rando, Trail,  Animations Nature... Guide diplômé pour tous niveaux. Priorité au Plaisir, au Respect de la Nature et au Bien-être."
    ],
    "nl": [
      "Natuurverblijven in de Ardèche (Gard, Lozère, Drôme) onder begeleiding. Mountainbiken, kanoën, kajakken, wandelen, parcours, natuuractiviteiten... Gediplomeerde gidsen voor alle niveaus. Voorrang aan plezier, respect voor de natuur en welzijn."
    ],
    "es": [
      "Estancias en la naturaleza supervisadas en Ardèche (Gard, Lozère, Drôme). Bicicleta de montaña, Piragüismo, Kayak, Senderismo, Trail, Actividades en la naturaleza... Guías cualificados para todos los niveles. Prioridad al Placer, al Respeto de la Naturaleza y al Bienestar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Guide Sport de Nature - ASANA Sport & Bien-être"
    ]
  },
