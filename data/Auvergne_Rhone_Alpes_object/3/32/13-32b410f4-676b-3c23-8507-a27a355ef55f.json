  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Saint Jean d'Aulps gelegen, öffnet das Empfangsbüro das ganze Jahr über seine Türen für Sie: Unsere Tourismusberaterinnen bieten Ihnen alle Informationen, die Sie für einen gelungenen Aufenthalt im Vallée d'Aulps benötigen."
    ],
    "en": [
      "Located in the heart of Saint Jean d'Aulps Village, the tourist office is open all the year. Our trained holiday advisers are ready to give you all the information you need to make your stay in the Valley d’Aulps a real success."
    ],
    "it": [
      "Situato nel cuore del villaggio di Saint Jean d'Aulps, l'ufficio di accoglienza è aperto tutto l'anno: i nostri consulenti turistici vi forniranno tutte le informazioni necessarie per il successo del vostro soggiorno nella Vallée d'Aulps."
    ],
    "fr": [
      "Situé au coeur du village de Saint Jean d'Aulps, le bureau d'accueil vous ouvre ses portes toute l'année : nos conseilléres touristiques vous apporteront toutes les informations nécessaires à la réussite de votre séjour en Vallée d'Aulps."
    ],
    "es": [
      "Situada en el corazón del pueblo de Saint Jean d'Aulps, la oficina de recepción está abierta todo el año: nuestros asesores turísticos le proporcionarán toda la información necesaria para que su estancia en el Valle de Aulps sea un éxito."
    ],
    "nl": [
      "De receptie, gelegen in het hart van het dorp Saint Jean d'Aulps, is het hele jaar geopend: onze toeristische adviseurs geven u alle informatie die u nodig heeft om uw verblijf in de Vallée d'Aulps tot een succes te maken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Vallée d'Aulps Tourist Office - Saint Jean d'Aulps Tourist Point"
    ],
    "fr": [
      "Vallée d'Aulps Tourisme - Bureau d'accueil de St Jean d'Aulps"
    ]
  },
