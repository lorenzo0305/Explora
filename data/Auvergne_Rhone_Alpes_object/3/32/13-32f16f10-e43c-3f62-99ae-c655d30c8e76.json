  "rdfs:comment": {
    "de": [
      "Urlauber: Wir begleiten Sie bei der Suche nach einer Unterkunft, die Ihren Bedürfnissen entspricht.\r\nEigentümer: Wir helfen Ihnen bei der Vermietung Ihres Eigentums."
    ],
    "en": [
      "Personalized welcome and service. \r\nLooking for accommodation for your holidays or your spa treatment? I am in direct touch with many home owners.\r\nKey delivery, welcome of your guests, supervision of your property, rental of household linen (sheets and towels), cleaning."
    ],
    "it": [
      "Vacanzieri: possiamo aiutarvi a trovare un alloggio adatto alle vostre esigenze.\r\nProprietari di immobili: possiamo aiutarvi ad affittare la vostra proprietà."
    ],
    "fr": [
      "Vacanciers : nous vous accompagnons dans la recherche d'un hébergement correspondant à vos besoins.\r\nPropriétaires : nous vous aidons pour la mise en location de vos biens."
    ],
    "nl": [
      "Verwelkoming en persoonlijke service. U zoekt een accommodatie voor uw vakantie, uw kuur? Ik sta in direct contact met de eigenaars. Overhandiging van de sleutel, receptie, toezicht op uw woning, verhuur van linnengoed (lakens en handdoeken), schoonmaak."
    ],
    "es": [
      "Turistas: podemos ayudarle a encontrar un alojamiento que se adapte a sus necesidades.\r\nPropietarios: podemos ayudarle a alquilar su vivienda."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ventoux private concierge"
    ],
    "fr": [
      "Conciergerie privée du Ventoux"
    ],
    "nl": [
      "Private conciërge diensten Ventoux"
    ]
  },
