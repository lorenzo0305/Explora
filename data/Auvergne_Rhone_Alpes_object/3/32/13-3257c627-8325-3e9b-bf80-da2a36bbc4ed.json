  "rdfs:comment": {
    "de": [
      "Als Helikopterzüchter züchten und kochen wir unsere Schnecken auf unserem Hof in La Côte Saint André in biologischer Landwirtschaft mit überwiegend Produkten von unserem Hof."
    ],
    "en": [
      "Heliciculturists, we raise and cook our snails on our farm in La Côte Saint André, using organic farming methods and a majority of our own farm produce."
    ],
    "it": [
      "In qualità di allevatori di lumache, alleviamo e cuciniamo le nostre lumache nella nostra azienda agricola a La Côte Saint André utilizzando metodi di agricoltura biologica e la maggior parte dei prodotti proviene dalla nostra azienda."
    ],
    "fr": [
      "Héliciculteurs, nous élevons et cuisinons nos escargots dans notre ferme à La Côte Saint André en agriculture biologique avec une majorité de produits de notre ferme."
    ],
    "es": [
      "Como criadores de caracoles, criamos y cocinamos nuestros caracoles en nuestra granja de La Côte Saint André siguiendo métodos de agricultura ecológica, y la mayor parte de nuestros productos proceden de nuestra propia granja."
    ],
    "nl": [
      "Als slakkenkwekers kweken en koken we onze slakken op onze boerderij in La Côte Saint André volgens biologische landbouwmethoden. Het grootste deel van onze producten komt van onze eigen boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "1 escargot dans le jardin"
    ]
  },
