  "rdfs:comment": {
    "de": [
      "Hoch über dem Fluss Ain bietet dieser Ort einen atemberaubenden Ausblick. Auf dem Gipfel entdecken Sie außerdem die Ruinen einer alten Festung."
    ],
    "en": [
      "Overlooking the River Ain, Mont Balvay offers an unrestricted view. You'll also discover the ruins of a former fortress at the summit."
    ],
    "it": [
      "Affacciato sul fiume Ain, questo sito offre una vista mozzafiato. In cima scoprirete anche le rovine di un'antica fortezza."
    ],
    "fr": [
      "Surplombant la rivière d'Ain, ce site offre une vue imprenable. Vous découvrirez également  au sommet les ruines d'une ancienne forteresse."
    ],
    "nl": [
      "Met uitzicht op de rivier de Ain biedt deze plaats een adembenemend uitzicht. Op de top ontdekt u ook de ruïnes van een oud fort."
    ],
    "es": [
      "Con vistas al río Ain, este sitio ofrece una vista impresionante. En la cima también descubrirá las ruinas de una antigua fortaleza."
    ]
  },
