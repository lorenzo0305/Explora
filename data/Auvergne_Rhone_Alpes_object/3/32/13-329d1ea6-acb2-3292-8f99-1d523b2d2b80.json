  "rdfs:comment": {
    "de": [
      "Ein schönes Gebiet mit Bouldern, die vollständig ausgeschildert und auf den neuesten Stand gebracht wurden. An manchen Bouldern kann ein Seil erforderlich sein. Leicht zugänglich, Routen für alle, von Kindern bis zu Bouldermutanten."
    ],
    "en": [
      "A beautiful site of fully signposted and updated boulders. A rope may be necessary on some boulders. Easy access, routes for everyone, from children to bouldering mutants."
    ],
    "it": [
      "Un bellissimo sito di massi, completamente segnalato e aggiornato. Su alcuni massi può essere necessaria una corda. Facile accesso, percorsi per tutti, dai bambini ai mutanti del bouldering."
    ],
    "fr": [
      "Un beau site de blocs entièrement fléchés et remis au goût du jour. Une corde peut parfois être nécessaire sur certains blocs. Facile d’accès, des voies pour tous, des enfants aux mutants du bloc."
    ],
    "es": [
      "Un hermoso sitio de rocas, totalmente señalizado y actualizado. A veces puede ser necesaria una cuerda en algunas rocas. Fácil acceso, rutas para todos, desde los niños hasta los mutantes del búlder."
    ],
    "nl": [
      "Een prachtige site met volledig bewegwijzerde en bijgewerkte boulders. Een touw kan nodig zijn op sommige boulders. Gemakkelijk toegankelijk, routes voor iedereen, van kinderen tot bouldermutanten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bouldering site of La Berarde"
    ],
    "fr": [
      "Site de blocs de La Bérarde"
    ],
    "nl": [
      "Bouldergebied van La Bérarde"
    ]
  },
