  "rdfs:comment": {
    "de": [
      "L'Happycall ist eine Brauerei mit überschaubarer Größe in einem ehemaligen Bauernhaus, das nur wenige Schritte vom Schloss Saint Vidal entfernt liegt. Sie bietet handwerklich gebraute Biere von 50cl an, die in guter Laune geteilt werden."
    ],
    "en": [
      "L'Happycall is a human-scale brewery housed in a former farmhouse a stone's throw from the Château de Saint Vidal. It offers 50cl craft beers to be shared in good spirits."
    ],
    "it": [
      "L'Happycall è un birrificio a misura d'uomo, ospitato in un'antica casa colonica a due passi dallo Château de Saint Vidal. Offre birre artigianali da 50cl da condividere in allegria."
    ],
    "fr": [
      "L’Happycall est une brasserie à taille humaine dans un ancien corps de ferme situé à quelques pas du château de Saint Vidal. Elle propose des bières artisanales de 50cl à partager dans la bonne humeur."
    ],
    "nl": [
      "The Happycall is een brouwerij op mensenmaat, gevestigd in een oude boerderij op een steenworp afstand van het Château de Saint Vidal. De brouwerij biedt ambachtelijke bieren van 50 cl die je in een goed humeur kunt delen."
    ],
    "es": [
      "La Happycall es una cervecería a escala humana, instalada en una antigua granja a dos pasos del castillo de Saint Vidal. Ofrece cervezas artesanales de 50 cl para compartir con buen humor."
    ]
  },
  "rdfs:label": {
