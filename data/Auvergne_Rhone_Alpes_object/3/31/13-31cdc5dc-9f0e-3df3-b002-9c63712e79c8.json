  "rdfs:comment": {
    "de": [
      "Der Mont Brion liegt neben dem Roc de Tavaneuse und bietet drei nach Osten ausgerichtete Routen mit einer Höhe von 250 bis 300 Metern und einem Schwierigkeitsgrad von D+ bis TD-."
    ],
    "en": [
      "Located next to the Roc de Tavaneuse, Mont Brion offers 3 east-facing routes, from 250 to 300 metres high, of difficulty D+ to TD-."
    ],
    "it": [
      "Situato accanto al Roc de Tavaneuse, il Mont Brion offre 3 percorsi esposti a est, da 250 a 300 metri di altezza, con difficoltà che vanno da D+ a TD-."
    ],
    "fr": [
      "Situé à côté du Roc de Tavaneuse, le mont Brion propose 3 voies orientées est, de 250 à 300 mètres de hauteur, de difficulté D+ à TD-."
    ],
    "es": [
      "Situado junto al Roc de Tavaneuse, Mont Brion ofrece 3 rutas orientadas al este, de 250 a 300 metros de altura, con una dificultad que va de D+ a TD-."
    ],
    "nl": [
      "Mont Brion ligt naast de Roc de Tavaneuse en biedt 3 routes naar het oosten, 250 tot 300 meter hoog, met moeilijkheidsgraden van D+ tot TD-."
    ]
  },
