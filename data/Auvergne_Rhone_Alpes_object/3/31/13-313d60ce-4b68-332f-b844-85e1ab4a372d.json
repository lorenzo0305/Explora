  "rdfs:comment": {
    "de": [
      "Die Ausstellung zeigt Bilder des offiziellen Fotografen des französischen Behindertensportverbandes, Grégory Picout. Entdecken Sie Rollstuhlbasketball, Cécifoot, Goalball, Sitzvolleyball und erleben Sie die magischen Momente der Paralympischen Spiele 2024."
    ],
    "en": [
      "The exhibition will feature images by the official photographer of the French Handisport Federation, Grégory Picout.,Discover wheelchair basketball, cecifoot, goalball, seated volleyball... and relive magical moments from the 2024 Paralympic Games."
    ],
    "it": [
      "La mostra presenterà le immagini scattate da Grégory Picout, il fotografo ufficiale della Federazione Francese di Handisport, e mostrerà il basket in carrozzina, il cecifoot, il goalball, la pallavolo da seduti e altro ancora, oltre a rivivere alcuni momenti magici dei Giochi Paralimpici del 2024."
    ],
    "fr": [
      "L’exposition présentera des images du photographe officiel de la Fédération Française Handisport, Grégory Picout.,Découvrez le basket fauteuil, le cécifoot, le goalball, le volley assis… et revivez des moments magiques des Jeux Paralympiques 2024."
    ],
    "es": [
      "La exposición contará con imágenes de Grégory Picout, fotógrafo oficial de la Federación Francesa de Deportes de Mano, y mostrará baloncesto en silla de ruedas, cecifoot, goalball, voleibol sentado y mucho más, así como momentos mágicos de los Juegos Paralímpicos de 2024."
    ],
    "nl": [
      "De tentoonstelling bevat foto's die zijn genomen door Grégory Picout, de officiële fotograaf van de Franse handisportfederatie, en laat rolstoelbasketbal, cecifoot, goalball, zitvolleybal en nog veel meer zien, maar ook enkele magische momenten van de Paralympische Spelen van 2024."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Exposition photo \"Handisport\""
    ]
  },
