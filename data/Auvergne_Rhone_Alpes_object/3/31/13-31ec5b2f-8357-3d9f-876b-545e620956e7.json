  "rdfs:comment": {
    "de": [
      "Der Coach Baptiste vom Club Valence-Chabeuil BMX ist für die Betreuung des Pumptracks zuständig.\r\nKommen Sie vorbei und mieten Sie Ihr BMX vor Ort, um die Aktivität zu entdecken und zu praktizieren!"
    ],
    "en": [
      "Coach Baptiste from Valence-Chabeuil BMX is in charge of pumptrack management.\r\nCome and rent your BMX on site to discover and practice the activity!"
    ],
    "it": [
      "L'allenatore Baptiste, del club BMX di Valence-Chabeuil, è responsabile della gestione della pista.\r\nVenite a noleggiare la vostra BMX sul posto per scoprire e praticare l'attività!"
    ],
    "fr": [
      "Le coach Baptiste, du club Valence-Chabeuil BMX, est en charge de la gestion du pumptrack.\r\nVenez louez votre BMX sur place pour découvrir et pratiquer l'activité !"
    ],
    "es": [
      "El entrenador Baptiste, del club BMX Valence-Chabeuil, es el encargado de dirigir el pumptrack.\r\n¡Ven a alquilar tu BMX in situ para descubrir y practicar la actividad!"
    ],
    "nl": [
      "Coach Baptiste van de Valence-Chabeuil BMX club is verantwoordelijk voor het runnen van de pumptrack.\r\nKom ter plekke je BMX huren om de activiteit te ontdekken en te oefenen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location BMX Race"
    ]
  },
