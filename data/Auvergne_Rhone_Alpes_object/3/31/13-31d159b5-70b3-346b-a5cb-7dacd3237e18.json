  "rdfs:comment": {
    "de": [
      "Von Montag bis Samstag empfängt Sie das Bar-Restaurant Centeleghe morgens zu einem Drink und mittags zu einer familiären Küche im Herzen von La Mure.\r\nRegionale Spezialitäten auf Bestellung: Pasteten, Ravioles, Pognes de taillons..."
    ],
    "en": [
      "Family cuisine. Local specialities on request : pies, ravioles, pognes de taillons..."
    ],
    "it": [
      "Dal lunedi al sabato, il bar-ristorante Centeleghe vi accoglie il mattino per bere un bicchiere e il pranzo per la cucina famigliale nel cuore di La Mure.\r\nSpecialite regionali su ordine : torte, ravioli, pogne de taillons...."
    ],
    "fr": [
      "Du lundi au samedi, le bar-restaurant Centeleghe vous accueille le matin pour boire un verre et le midi pour goûter à une cuisine familiale au cœur de La Mure.\r\nSpécialités régionales sur commande : tourtes, ravioles, pognes de taillons..."
    ],
    "nl": [
      "Een familiale keuken. Regionale specialteiten zijn te bestellen : tourtes, ravioles en pognes de taillons (spektaart)."
    ],
    "es": [
      "De lunes a sábado, el bar-restaurante Centeleghe le recibe por la mañana para tomar una copa y al mediodía para saborear la cocina casera en el corazón de La Mure.\r\nEspecialidades regionales por encargo: empanadas, ravioles, pognes de taillons..."
    ]
  },
