  "rdfs:comment": {
    "de": [
      "Mittags und abends, vor oder nach einem Film, empfängt Sie der Crazy Burger im Park des Cinépole, zum Genießen von Burgern,Pommes, in geselliger Runde."
    ],
    "en": [
      "Lunchtime and evening, before or after a film, the Crazy Burger in the Cinépole grounds serves delicious burgers and chips in a pleasant, friendly atmosphere."
    ],
    "it": [
      "Dal martedì alla domenica, prima o dopo un film, il Crazy Burger situato nel parco Cinépole vi accoglie per gustare hamburger, patatine e insalate in un'atmosfera amichevole e gustosa."
    ],
    "fr": [
      "Du mardi au dimanche, avant ou après un film, le Crazy Burger situé dans le parc du Cinépole vous accueille pour savourer burgers, frites, salades en toute convivialité et gourmandise."
    ],
    "nl": [
      "Van dinsdag tot zondag, voor of na een film, verwelkomt de Crazy Burger in het Cinépole park u om te genieten van hamburgers, frietjes en salades in een gezellige en smakelijke sfeer."
    ],
    "es": [
      "De martes a domingo, antes o después de una película, el Crazy Burger, situado en el parque Cinépole, le recibe para degustar hamburguesas, patatas fritas y ensaladas en un ambiente agradable y sabroso."
    ]
  },
