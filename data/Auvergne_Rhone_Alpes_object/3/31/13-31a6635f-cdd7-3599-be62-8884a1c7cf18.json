  "rdfs:comment": {
    "de": [
      "Almacita verspricht ein authentisches südamerikanisches Gastronomieerlebnis mit einer festlichen Atmosphäre und bietet Gerichte wie Ceviche, Tacos, Gegrilltes und exotische Cocktails."
    ],
    "en": [
      "Almacita promises an authentic South American dining experience with a festive atmosphere, offering dishes such as ceviches, tacos, grills, and exotic cocktails."
    ],
    "it": [
      "L'Almacita promette un'autentica esperienza culinaria sudamericana in un'atmosfera festosa, offrendo piatti come ceviches, tacos, grigliate e cocktail esotici."
    ],
    "fr": [
      "Almacita promet une expérience gastronomique sud-américaine authentique avec une ambiance festive, offrant des plats tels que ceviches, tacos, grillades, et des cocktails exotiques."
    ],
    "es": [
      "Almacita promete una auténtica experiencia gastronómica sudamericana con un ambiente festivo, ofreciendo platos como ceviches, tacos, parrilladas y cócteles exóticos."
    ],
    "nl": [
      "Almacita belooft een authentieke Zuid-Amerikaanse eetervaring met een feestelijke sfeer, met gerechten als ceviches, taco's, grillgerechten en exotische cocktails."
    ]
  },
