  "rdfs:comment": {
    "de": [
      "Herstellung und Verkauf von Tommes aus Ziegenmilch, Sérac, Quark, Frischkäse, und reinem Ziegenkäse. Entdecken Sie den Ziegenhof von November bis März in La Poulière und im Sommer die mobile Melkstation alpin \"Les Mouilles\"."
    ],
    "en": [
      "Manufacture and sale of goat cheese. Discover the farm from november to march in hamlet La Poulière and during summer the mobile milking in alpine \"Les Mouilles\"."
    ],
    "it": [
      "Produzione e vendita di chevrotins, formaggi di capra, seracs, faisselles, petits frais, formaggi di pura capra. Scoprite la fattoria da novembre a marzo a La Poulière e in estate la mungitura mobile all'alpeggio di Mouilles."
    ],
    "fr": [
      "Fabrication et vente de chevrotins, tommes de chèvres, séracs, faisselles, petits frais, pur chèvre. Découvrez la ferme de novembre à mars à la Poulière et l'été la traite mobile à l'alpage des Mouilles."
    ],
    "nl": [
      "Productie en verkoop van chevrotins, geitenkaas, seracs, faisselles, petits frais, zuivere geitenkaas. Ontdek de boerderij van november tot maart in La Poulière en in de zomer het mobiele melken op de bergweide van Mouilles."
    ],
    "es": [
      "Producción y venta de chevrotins, quesos de cabra, seracs, faisselles, petits frais, quesos puros de cabra. Descubra la granja de noviembre a marzo en La Poulière y en verano el ordeño móvil en el pasto de montaña de Mouilles."
    ]
  },
