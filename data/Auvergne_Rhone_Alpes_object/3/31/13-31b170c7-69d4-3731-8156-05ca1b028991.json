  "rdfs:comment": {
    "de": [
      "Fest, bei dem eine bekannte Spezialität geehrt wird: Hechtklößchen mit Nantua-Soße. Auf dem Programm stehen Verkostungen, Demonstrationen von Fachwissen, Umzug, Markt mit lokalen Erzeugern..."
    ],
    "en": [
      "Programme includes exhibition, tasting of quenelles in Nantua sauce, market with local specialities (\"Marché des Délices de l'Ain\"), plate-dressing competition, children's activities."
    ],
    "it": [
      "Una festa che celebra una specialità molto conosciuta: la quenelle di luccio in salsa Nantua. In programma: degustazioni, dimostrazioni di know-how, sfilata, mercato dei produttori locali..."
    ],
    "fr": [
      "Fête qui met à l'honneur une spécialité bien connue  : la quenelle de brochet sauce Nantua. Au programme : dégustations, démonstrations de savoir-faire, défilé, marché de producteurs locaux..."
    ],
    "es": [
      "Una fiesta para celebrar una especialidad muy conocida: la quenelle de lucio en salsa Nantua. En el programa: degustaciones, demostraciones de saber hacer, desfile, mercado de productores locales..."
    ],
    "nl": [
      "Een feest ter ere van een bekende specialiteit: quenelle van snoek in Nantua-saus. Op het programma: proeverijen, demonstraties van knowhow, optocht, markt van lokale producenten..."
    ]
  },
