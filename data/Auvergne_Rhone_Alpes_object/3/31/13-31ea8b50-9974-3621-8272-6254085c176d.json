  "rdfs:comment": {
    "de": [
      "Die Halle besteht aus einem Bereich für Anfänger und Kinder, einem Boulderbereich, 1 großen Raum mit einem Schwierigkeitsgrad von 14,50 m, 1 Terrasse und 2 Außenwänden. Indoor-Abenteuerparcours in luftiger Höhe mit 18 Workshops: Leitern, Stege, Netze, Affenbrücke..."
    ],
    "en": [
      "Climbing walls indoor and outdoor for beginners and high level sportspeople. Illimited acces for self-clinging climbers."
    ],
    "it": [
      "La sala è composta da uno spazio per principianti e bambini, uno spazio boulder, 1 grande sala di difficoltà a 14,50 m, 1 terrazza e 2 pareti esterne. Percorso avventura indoor con 18 laboratori: scale, passerelle, reti, ponte delle scimmie..."
    ],
    "fr": [
      "La salle se compose d'un espace pour débutants et enfants, un espace bloc, 1 grande salle de difficulté à 14,50m, 1 terrasse et 2 murs extérieurs. Parcours aventure intérieur en hauteur avec 18 ateliers : échelles, passerelles, filets, pont de singe..."
    ],
    "es": [
      "La sala consta de una zona para principiantes y niños, una zona de boulder, una gran sala de dificultad a 14,50 m, una terraza y 2 muros exteriores. Recorrido interior de alta aventura con 18 talleres: escaleras, pasarelas, redes, puente de monos..."
    ],
    "nl": [
      "De zaal bestaat uit een ruimte voor beginners en kinderen, een boulderruimte, 1 grote moeilijkheidszaal op 14,50m, 1 terras en 2 buitenmuren. Indoor hoog avonturenparcours met 18 workshops: ladders, loopbruggen, netten, apenbrug..."
    ]
  },
