  "rdfs:comment": {
    "de": [
      "Herzlich willkommen auf dem Bauernhof Les Sens en Herbe! Gaétan und Nais, Bauern und Destillateure, lassen Sie an ihrer Tätigkeit teilhaben: Anbau und Sammeln von Heilpflanzen, Demonstration einer Destillation zur Gewinnung von ätherischem Öl und Blütenwasser."
    ],
    "en": [
      "Welcome to Les Sens en Herbe Farm! Gaétan and Nais, farmers and distillers, will share their work with you: growing and gathering medicinal plants, demonstrating distillation to obtain essential oils and floral waters."
    ],
    "it": [
      "Benvenuti alla fattoria Les Sens en Herbe! Gaétan e Nais, agricoltori e distillatori, condivideranno con voi il loro lavoro: coltivazione e raccolta di piante medicinali, dimostrazione della distillazione per ottenere oli essenziali e acque floreali."
    ],
    "fr": [
      "Bienvenus à la Ferme Les Sens en Herbe! Gaétan et Nais, Paysans et distillateurs vous ferons partager leur activité: culture et cueillette de plantes médicinales, démonstration d'une distillation pour l'obtention d'huile essentielle et d' eau florale."
    ],
    "es": [
      "¡Bienvenido a la granja Les Sens en Herbe! Gaétan y Nais, agricultores y destiladores, compartirán con usted su trabajo: cultivo y recolección de plantas medicinales, demostración de la destilación para obtener aceites esenciales y aguas florales."
    ],
    "nl": [
      "Welkom op de boerderij Les Sens en Herbe! Gaétan en Nais, boeren en distilleerders, zullen hun werk met je delen: het kweken en plukken van geneeskrachtige planten, het demonstreren van distillatie om essentiële oliën en bloemenwaters te verkrijgen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journée Porte ouverte Distillerie Les Sens en Herbe"
    ]
  },
