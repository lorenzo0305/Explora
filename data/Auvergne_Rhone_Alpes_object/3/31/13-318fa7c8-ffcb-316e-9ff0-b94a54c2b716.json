  "rdfs:comment": {
    "de": [
      "Der Verein \"Familles Rurales\" und der Jugendclub \"Odafun\" organisieren am Samstag, den 14. März 2026 von 18.00 bis 22.00 Uhr im Festsaal einen Spieleabend (Gesellschaftsspiele, Holzbaukästen, ...)."
    ],
    "en": [
      "The \"Familles Rurales\" association and the \"Odafun\" teen club are organizing a \"games\" evening (board games, wooden construction games, etc.) on Saturday March 14, 2026 from 6pm to 10pm at the village hall."
    ],
    "it": [
      "L'associazione \"Familles Rurales\" e il club di adolescenti \"Odafun\" organizzano una serata di \"giochi\" (giochi da tavolo, costruzioni in legno, ecc.) sabato 14 marzo 2026 dalle 18 alle 22 nella sala del villaggio."
    ],
    "fr": [
      "L’association ‘Familles Rurales’ et le Club Ados ‘Odafun’ organisent une soirée « jeux » (jeux de société, jeux de construction en bois, …), le Samedi 14 Mars 2026 de 18 heures à 22 heures à la salle des fêtes."
    ],
    "es": [
      "La asociación \"Familles Rurales\" y el club de adolescentes \"Odafun\" organizan una velada \"lúdica\" (juegos de mesa, juegos de construcción en madera, etc.) el sábado 14 de marzo de 2026 de 18:00 a 22:00 en la sala del pueblo."
    ],
    "nl": [
      "De vereniging \"Familles Rurales\" en de tienerclub \"Odafun\" organiseren een spelletjesavond (gezelschapsspelen, houten constructiespelen, enz.) op zaterdag 14 maart 2026 van 18u tot 22u in het dorpshuis."
    ]
  },
