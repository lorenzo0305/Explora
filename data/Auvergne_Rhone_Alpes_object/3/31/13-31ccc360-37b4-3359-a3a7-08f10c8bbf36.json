  "rdfs:comment": {
    "de": [
      "RDV in der Grange à Palabres jeden 1. Freitag im Monat! Das Programm befindet sich im ständigen Aufbau. Zögern Sie nicht, Filme vorzuschlagen. Wir erwarten Sie zahlreich und motiviert, um das Abenteuer des Dokumentarfilms im ländlichen Raum zu unterstützen!"
    ],
    "en": [
      "Meet us at the Grange à Palabres every 1st Friday of the month! The program is constantly evolving. Don?t hesitate to suggest films. We look forward to seeing many of you there to support the adventure of documentary film in rural areas!"
    ],
    "it": [
      "Appuntamento alla Grange à Palabres ogni 1° venerdì del mese! Il programma è in continua evoluzione. Non esitate a proporre film. Vi aspettiamo numerosi per sostenere l'avventura del cinema documentario nelle zone rurali!"
    ],
    "fr": [
      "RDV à la Grange à Palabres tous les 1ers vendredis du mois ! Le programme est en construction permanente. N’hésitez pas à proposer des films. On vous attend nombreux et motivés pour soutenir l’aventure du film documentaire en milieu rural !"
    ],
    "es": [
      "Reúnase con nosotros en la Grange à Palabres el primer viernes de cada mes El programa evoluciona constantemente. No dude en sugerirnos películas. Esperamos veros a muchos de vosotros para apoyar la aventura del cine documental en el medio rural"
    ],
    "nl": [
      "Ontmoet ons elke 1e vrijdag van de maand in de Grange à Palabres! Het programma verandert voortdurend. Aarzel niet om films voor te stellen. We hopen velen van jullie daar te zien om het avontuur van de documentaire film op het platteland te ondersteunen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Projection de films documentaires"
    ]
  },
