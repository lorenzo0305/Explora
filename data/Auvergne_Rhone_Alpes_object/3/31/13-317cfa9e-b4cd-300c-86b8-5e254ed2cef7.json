  "rdfs:comment": {
    "de": [
      "Das 3-Sterne-Hotel Le Place Neuve mit seinem Restaurant ist der ideale Ort für einen geselligen Moment bei einem einfallsreichen Teller, der aus frischen Produkten zubereitet und von einer Auswahl an Weinen begleitet wird."
    ],
    "en": [
      "The Place Neuve, a 3-star hotel and its restaurant is the ideal place for a moment of conviviality around an inventive plate made with fresh products and accompanied by a selection of wines."
    ],
    "it": [
      "La Place Neuve, hotel e ristorante a 3 stelle, è il luogo ideale per un momento di convivialità attorno a un piatto inventivo realizzato con prodotti freschi e accompagnato da una selezione di vini."
    ],
    "fr": [
      "Le Place Neuve, hôtel 3 étoiles et son restaurant est le lieu idéal pour un moment de convivialité autour d'une assiette inventive élaborée à base de produits frais et accompagné d'une sélection de vins."
    ],
    "es": [
      "La Place Neuve, hotel y restaurante de 3 estrellas, es el lugar ideal para un momento de convivencia en torno a un plato inventivo elaborado con productos frescos y acompañado de una selección de vinos."
    ],
    "nl": [
      "De Place Neuve, een driesterrenhotel en -restaurant, is de ideale plek voor een gezellig moment rond een inventief bord met verse producten en een selectie wijnen."
    ]
  },
