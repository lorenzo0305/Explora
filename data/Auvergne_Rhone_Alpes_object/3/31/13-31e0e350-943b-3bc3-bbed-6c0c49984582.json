  "rdfs:comment": {
    "de": [
      "Bar / Restaurant mit Terrasse, im Stadtzentrum.\r\nL'Eterlou bietet Ihnen eine gepflegte, traditionelle Küche und empfängt Sie in einem Saal mit 45 Plätzen. Im Sommer profitieren Sie von der schattigen Terrasse hinter dem Restaurant.\r\nPatio.\r\nWETTBÜRO."
    ],
    "en": [
      "Bar / Restaurant with terrace in town centre.\r\nL'Eterlou proposes traditional cooking with carefully prepared meals and welcomes you in our restaurant that seats 45. In summer enjoy our shady terrace."
    ],
    "it": [
      "Bar/ristorante con terrazza, nel centro della città.\r\nL'Eterlou serve una cucina tradizionale preparata con cura in una sala da 45 posti. In estate, godetevi la terrazza ombreggiata sul retro del ristorante.\r\nPatio.\r\nPMU."
    ],
    "fr": [
      "Bar / restaurant avec terrasse, en centre ville.\r\nL'Eterlou vous propose une cuisine soignée et traditionnelle et vous accueille dans une salle de 45 couverts. En été, profitez de sa terrasse ombragée, à l'arrière du restaurant.\r\nPatio.\r\nPMU."
    ],
    "nl": [
      "Bar/restaurant met terras, in het stadscentrum.\r\nL'Eterlou serveert traditionele, zorgvuldig bereide gerechten in een eetzaal met 45 zitplaatsen. Geniet in de zomer van het schaduwrijke terras aan de achterkant van het restaurant.\r\nPatio.\r\nPMU."
    ],
    "es": [
      "Bar-restaurante con terraza, en el centro de la ciudad.\r\nL'Eterlou ofrece una cocina tradicional elaborada con esmero en un comedor de 45 plazas. En verano, disfrute de la terraza sombreada situada en la parte trasera del restaurante.\r\nPatio.\r\nPMU."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant L'Eterlou"
    ],
    "fr": [
      "Bar / Restaurant L'Eterlou"
    ]
  },
