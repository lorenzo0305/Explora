  "rdfs:comment": {
    "de": [
      "Das Unternehmen d'Horloges Huchez besteht seit 190 Jahren. Die Familiengeschichte beginnt mit einem gewissen Auguste Vérité, der mit dem Bau der astronomischen Uhr der Kathedrale von Beauvais seine Spuren in der Region Oise hinterließ."
    ],
    "en": [
      "The company Horloges Huchez has existed for 190 years. The history of the family begins with a certain Auguste Vérité who left his mark in the Oise region by building the astronomical clock of the cathedral of Beauvais."
    ],
    "it": [
      "L'azienda Horloges Huchez esiste da 190 anni. La storia della famiglia inizia con un certo Auguste Vérité che ha lasciato il segno nella regione dell'Oise costruendo l'orologio astronomico della cattedrale di Beauvais."
    ],
    "fr": [
      "L'entreprise d'Horloges Huchez existe depuis 190 ans. L'histoire de la famille  commence avec un certain Auguste Vérité qui a laissé sa trace dans l'Oise par la construction de l'horloge astronomique de la cathédrale de Beauvais."
    ],
    "es": [
      "La empresa Horloges Huchez existe desde hace 190 años. La historia de la familia comienza con un tal Auguste Vérité, que dejó su huella en la región de Oise al construir el reloj astronómico de la catedral de Beauvais."
    ],
    "nl": [
      "Het bedrijf Horloges Huchez bestaat al 190 jaar. De geschiedenis van de familie begint met een zekere Auguste Vérité die zijn stempel op de Oise drukte door de astronomische klok van de kathedraal van Beauvais te bouwen."
    ]
  },
  "rdfs:label": {
