  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4184a160-cc64-3149-a794-fca02e4dbcfa",
      "dc:description": {
        "de": [
          "Traditioneller Fallensteller für Maulwürfe.\nEinsatz in den Gebieten Montreuil/mer, Etaples, Le Touquet, Merlimont und Umgebung...\n\nInterventionen von Montag bis Freitag."
        ],
        "en": [
          "Traditional mole trapper.\nIntervention in Montreuil/mer, Etaples, Le Touquet, Merlimont and surrounding areas...\n\nInterventions from Monday to Friday."
        ],
        "it": [
          "Trappola per talpe tradizionale.\nLavoro nelle zone di Montreuil/mer, Etaples, Le Touquet, Merlimont e dintorni...\n\nLavoro dal lunedì al venerdì."
        ],
        "fr": [
          "Piégeur traditionnel de taupes.\nIntervention sur les secteurs de Montreuil/mer, Etaples, Le Touquet, Merlimont et alentours...\n\nInterventions du lundi au vendredi."
        ],
        "es": [
          "Trampero de topos tradicional.\nTrabajo en el Montreuil/mer, Etaples, Le Touquet, Merlimont y alrededores....\n\nTrabajo de lunes a viernes."
        ],
        "nl": [
          "Traditionele mollenvanger.\nWerkzaamheden in Montreuil/mer, Etaples, Le Touquet, Merlimont en omstreken...\n\nWerkzaamheden van maandag tot vrijdag."
        ]
      },
