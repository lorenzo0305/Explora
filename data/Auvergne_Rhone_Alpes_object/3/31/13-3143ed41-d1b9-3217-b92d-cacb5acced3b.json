  "rdfs:comment": {
    "de": [
      "Mohair du Vercors bietet Produkte aus Mohairwolle, die von einer Herde Angora-Ziegen stammt. Entdecken Sie Mützen, Handschuhe, Schals und mehr, sowie spielerische Workshops und Bauernhofbesuche mit Vorführung des Wollspinnens."
    ],
    "en": [
      "Mohair du Vercors offers mohair wool products from a herd of Angora goats. Discover hats, gloves, scarves and more, as well as fun workshops and farm visits with wool spinning demonstrations."
    ],
    "it": [
      "Mohair du Vercors offre prodotti in lana mohair provenienti da un allevamento di capre d'Angora. Scoprite cappelli, guanti, sciarpe e molto altro, oltre a divertenti laboratori e visite alla fattoria con dimostrazioni di filatura della lana."
    ],
    "fr": [
      "Mohair du Vercors propose des produits en laine mohair issus d’un troupeau de chèvres Angora . Découvrez bonnets, gants, écharpes et plus, ainsi que des ateliers ludiques et des visites de la ferme avec démonstration de filage de laine."
    ],
    "es": [
      "Mohair du Vercors ofrece productos de lana mohair procedentes de un rebaño de cabras de Angora. Descubra sombreros, guantes, bufandas y mucho más, además de divertidos talleres y visitas a la granja con demostraciones de hilado de lana."
    ],
    "nl": [
      "Mohair du Vercors biedt mohairwolproducten van een kudde Angorageiten. Ontdek hoeden, handschoenen, sjaals en meer, maar ook leuke workshops en bezoeken aan de boerderij met demonstraties wol spinnen."
    ]
  },
