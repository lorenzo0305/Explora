  "rdfs:comment": {
    "de": [
      "Sechzehn renovierte Zimmer, davon 2 mit PMR-Zugang, verbinden modernen Komfort mit schlichter Eleganz. Das Restaurant bietet eine traditionelle Speisekarte mit Akzenten aus der Ardèche und der Provence sowie einen Gewölbesaal für Ihre Empfänge und Seminare."
    ],
    "en": [
      "Sixteen renovated rooms, including 2 with PRM access, combine modern comfort with sobriety. The restaurant offers a traditional menu with Ardèche and Provençal accents, as well as a vaulted room for receptions and seminars."
    ],
    "it": [
      "Sedici camere rinnovate, di cui 2 accessibili ai disabili, che combinano comfort moderno e sobrietà. Il ristorante offre un menu tradizionale dal sapore dell'Ardèche e della Provenza e una sala a volta per i vostri ricevimenti e seminari."
    ],
    "fr": [
      "Seize chambres rénovées, dont 2 accessibles PMR, alliant confort moderne et sobriété. Le restaurant propose une carte traditionnelle aux accents ardéchois et provençaux ainsi qu'une salle voûtée pour vos réceptions et séminaires."
    ],
    "nl": [
      "Zestien gerenoveerde kamers, waarvan 2 toegankelijk voor gehandicapten, die modern comfort en soberheid combineren. Het restaurant biedt een traditionele kaart met een Ardèche- en Provençaals tintje en een gewelfde zaal voor uw recepties en seminars."
    ],
    "es": [
      "Dieciséis habitaciones renovadas, 2 de ellas accesibles para minusválidos, que combinan confort moderno y sobriedad. El restaurante ofrece un menú tradicional con sabor a Ardèche y Provenza, así como una sala abovedada para sus recepciones y seminarios."
    ]
  },
