  "COVID19SpecialMeasures": {
    "de": [
      "Staffelung der An- und Abreise (Verabredung). Möglichkeit eines Picknickkorbs, eines Salat-Sandwich-Korbs und eines Lunchkorbs. Begrenzung des Austauschs von Dokumenten, indem der Versand per E-Mail oder SMS bevorzugt wird (Polizeikarte, Rechnung). Regelmäßige Reinigung der Kontaktflächen. Bereitstellung von hydroalkoholischem Gel in den Zimmern."
    ],
    "en": [
      "Staggered arrivals and departures (\"rendezvous\"). Possibility of picnic basket, salad-sandwich basket and lunch basket. Limiting the exchange of documents by preferring to send them by e-mail or SMS (police forms, invoices). Regular cleaning of contact surfaces. Provision of hydroalcoholic gel in the rooms."
    ],
    "it": [
      "Arrivi e partenze scaglionati (\"rendez-vous\"). Possibilità di cestino da picnic, cestino di insalata e cestino da pranzo. Limitare lo scambio di documenti privilegiando l'invio per e-mail o SMS (modulo di polizia, fattura). Pulizia regolare delle superfici di contatto. Fornitura di gel idroalcolico nelle camere."
    ],
    "es": [
      "Llegadas y salidas escalonadas (\"rendezvous\"). Posibilidad de cesta de picnic, cesta de ensalada-sándwich y cesta de almuerzo. Limitar el intercambio de documentos dando preferencia al envío por correo electrónico o por SMS (formulario policial, factura). Limpieza periódica de las superficies de contacto. Suministro de gel hidroalcohólico en las habitaciones."
    ],
    "nl": [
      "Gespreide aankomst en vertrek (\"rendez-vous\"). Mogelijkheid tot picknickmand, salade-sandwichmand en lunchmand. Het beperken van de uitwisseling van documenten door ze bij voorkeur per e-mail of SMS te verzenden (politieformulier, factuur). Regelmatige reiniging van contactoppervlakken. Verstrekking van hydroalcoholische gel in de kamers."
    ]
  },
