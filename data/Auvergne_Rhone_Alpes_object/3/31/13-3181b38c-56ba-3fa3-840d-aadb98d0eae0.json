  "rdfs:comment": {
    "de": [
      "Jean-Christophe ist Metallhandwerker und kreiert Möbel aus Stahl und Holz. Er bietet Ihnen einzigartige und maßgeschneiderte Realisierungen, um Ihre Innen- und Außeneinrichtungsprojekte zum Leben zu erwecken."
    ],
    "en": [
      "Jean-Christophe is an artisan metalworker and designer of steel and wood furniture, offering unique, made-to-measure creations to bring your interior and exterior design projects to life."
    ],
    "it": [
      "Jean-Christophe è un artigiano metalmeccanico e designer di mobili in acciaio e legno, che offre creazioni uniche e su misura per dare vita ai vostri progetti di design per interni ed esterni."
    ],
    "fr": [
      "Artisan métallier et créateur de mobilier en acier et bois, Jean-Christophe vous propose des réalisations uniques et sur mesure, pour donner vie à vos projets d’aménagement intérieur et extérieur."
    ],
    "nl": [
      "Jean-Christophe is een ambachtelijke metaalbewerker en ontwerper van stalen en houten meubels. Hij biedt unieke, op maat gemaakte creaties om je interieur- en exterieurontwerpprojecten tot leven te brengen."
    ],
    "es": [
      "Jean-Christophe es un artesano metalúrgico y diseñador de muebles de acero y madera, que ofrece creaciones únicas a medida para dar vida a sus proyectos de diseño de interiores y exteriores."
    ]
  },
  "rdfs:label": {
