  "rdfs:comment": {
    "de": [
      "Die Touristeninformation in Les Menuires im Stadtteil La Croisette ist das ganze Jahr über erreichbar und trägt die Marke Qualité Tourisme."
    ],
    "en": [
      "The tourist office in Les Menuires, in the La Croisette district, is open all year round and has been awarded the Qualité Tourisme label."
    ],
    "it": [
      "L'Ufficio del Turismo di Les Menuires, nel quartiere La Croisette, è aperto tutto l'anno e ha ottenuto il marchio Qualità del Turismo."
    ],
    "fr": [
      "L'office de tourisme des Menuires, dans le quartier de La Croisette, est joignable toute l'année et bénéficie de la marque Qualité Tourisme."
    ],
    "es": [
      "La Oficina de Turismo de Les Menuires, en el barrio de La Croisette, está abierta todo el año y ha obtenido el sello de Calidad Turística."
