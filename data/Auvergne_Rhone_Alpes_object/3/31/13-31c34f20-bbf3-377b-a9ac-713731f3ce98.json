  "rdfs:comment": {
    "de": [
      "Restaurant mit frischer Pasta, frischen Ravioli und Lasagne, Antipasti, die vor Ort hergestellt werden. Möglichkeit, vor Ort zu verzehren oder mitzunehmen\r\nVollständig hausgemachte Nudeln, Ravioli, Lasagne, Soßen und Desserts."
    ],
    "en": [
      "Fresh pasta restaurant serving ravioli and fresh lasagna, anti-pasti, all made on-site. To eat in or take away. The pasta, ravioli, lasagna, sauce and desserts are all home-made."
    ],
    "it": [
      "Ristorante che serve pasta fresca, ravioli e lasagne, antipasti, preparati sul momento. Può essere consumato all'interno o portato via\r\nPasta, ravioli, lasagne, sughi e dolci sono tutti fatti in casa."
    ],
    "fr": [
      "Restaurant de pâtes fraîches, raviolis et lasagnes frais, antipasti, fabriqués sur place. Possibilité de consommer sur place ou à emporter. \r\nPâtes, raviolis, lasagnes, sauces et desserts entièrement faits maison."
    ],
    "es": [
      "Restaurante que sirve pasta fresca, raviolis y lasaña, antipasti, hechos al momento. Se puede comer dentro o fuera\r\nLa pasta, los raviolis, la lasaña, las salsas y los postres son todos caseros."
    ],
    "nl": [
      "Restaurant met verse pasta, ravioli en lasagne, antipasti, ter plaatse gemaakt. Kan binnen of buiten gegeten worden\r\nPasta, ravioli, lasagne, sauzen en desserts zijn allemaal huisgemaakt."
    ]
  },
