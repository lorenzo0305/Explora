  "rdfs:comment": {
    "de": [
      "Königsetappe der ersten Tour Auvergne-Rhône-Alpes, der neuen Bezeichnung des Critérium du Dauphiné, zwischen La Bridoire und Grand Colombier.\r\nDie besten Fahrer des Profi-Pelotons messen sich ein letztes Mal in der Region AURA vor der Tour de France."
    ],
    "en": [
      "The queen stage of the inaugural Tour Auvergne-Rhône-Alpes, the new name for the Critérium du Dauphiné, runs between La Bridoire and the Grand Colombier.\r\nThe best riders in the professional peloton will test themselves one last time in the Auvergne-Rhône-Alpes region before the Tour de France."
    ],
    "it": [
      "La tappa regina del primo Tour Auvergne-Rhône-Alpes, il nuovo nome del Critérium du Dauphiné, tra La Bridoire e il Grand Colombier.\r\nI migliori corridori del gruppo dei professionisti si mettono alla prova un'ultima volta nella regione dell'AURA prima del Tour de France."
    ],
    "fr": [
      "Etape reine du premier Tour Auvergne-Rhône-Alpes, nouvelle appellation du Critérium du Dauphiné, entre La Bridoire et le Grand Colombier.\r\nLes meilleurs coureurs du peloton professionnel se jauge une dernière fois en région AURA avant le Tour de France."
    ],
    "es": [
      "Etapa reina del primer Tour Auvergne-Rhône-Alpes, nueva denominación del Critérium du Dauphiné, entre La Bridoire y el Grand Colombier.\r\nLos mejores corredores del pelotón profesional se ponen a prueba una última vez en la región de AURA antes del Tour de Francia."
    ],
    "nl": [
      "De koninginnerit van de eerste Tour Auvergne-Rhône-Alpes, de nieuwe naam voor het Critérium du Dauphiné, tussen La Bridoire en de Grand Colombier.\r\nDe beste renners in het profpeloton testen zichzelf nog een laatste keer in de AURA regio voor de Tour de France."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Bridoire - Grand Colombier Cycling stage 7 Tour Auvergne-Rhône-Alpes(former Dauphiné)."
    ],
    "fr": [
      "La Bridoire - Grand Colombier : étape 7 du Tour Auvergne-Rhône-Alpes de cyclisme (ex Dauphiné)."
    ]
  },
