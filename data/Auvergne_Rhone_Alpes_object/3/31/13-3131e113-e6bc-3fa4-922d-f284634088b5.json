  "rdfs:comment": {
    "de": [
      "Cédric, Jérôme und Romain sind die drei Teilhaber der Ferme du Mornantais. Da sie seit 2020 biologisch wirtschaften, bieten uns die Landwirte gesunde, hochwertige Produkte an. Die Stärke des Familienunternehmens: vielfältiges Know-how, schöne Werte und Überzeugungen"
    ],
    "en": [
      "Cédric, Jérôme and Romain are the 3 partners of the Mornantais farm. Organic since 2020, these farmers offer us healthy, quality products. The strengths of this family-run business: a wide range of expertise, strong values and convictions"
    ],
    "it": [
      "Cédric, Jérôme e Romain sono i 3 soci dell'azienda agricola Mornantais. Biologici dal 2020, gli agricoltori ci offrono prodotti sani e di alta qualità. La forza di questa azienda a conduzione familiare risiede nell'ampia competenza, nei forti valori e nelle convinzioni"
    ],
    "fr": [
      "Cédric, Jérôme, Romain sont les 3 associés de la ferme du Mornantais. En bio depuis 2020, les agriculteurs nous offrent des produits sains, de qualité. Le point fort de l'entreprise familiale : des savoir-faire variés, de belles valeurs et des convictions"
    ],
    "es": [
      "Cédric, Jérôme y Romain son los 3 socios de la granja Mornantais. Ecológicos desde 2020, los agricultores nos ofrecen productos sanos y de calidad. La fuerza de esta empresa familiar reside en su amplia experiencia, sus fuertes valores y sus convicciones"
    ],
    "nl": [
      "Cédric, Jérôme en Romain zijn de 3 partners van de boerderij Mornantais. De boeren zijn biologisch sinds 2020 en bieden ons gezonde producten van hoge kwaliteit. De kracht van dit familiebedrijf ligt in zijn brede expertise, sterke waarden en overtuigingen"
    ]
  },
