  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/aa3c804a-d91f-31b9-abc6-15073d164543",
      "dc:description": {
        "de": [
          "Entdecken Sie technische und technologische Meisterleistungen mit der Dokumentation über \"Ocean One\", den humanoiden Roboter-Archäologen, der die Tiefsee besuchen kann!\n\nFreier Eintritt - mit Reservierung"
        ],
        "en": [
          "Discover the technical and technological prowess of \"Ocean One\", the humanoid archaeologist robot capable of visiting the deep sea!\n\nFree admission - reservation required"
        ],
        "it": [
          "Scoprite le abilità tecniche e tecnologiche di \"Ocean One\", il robot archeologo umanoide in grado di visitare le profondità marine!\n\nIngresso gratuito - prenotazione obbligatoria"
        ],
        "fr": [
          "Découvrez les prouesses techniques et technologiques avec le documentaire consacré à \"Ocean One\", le robot humanoïde archéologue capable de visiter les profondeurs ! \n\nEntrée gratuite - sur réservation"
        ],
        "nl": [
          "Ontdek de technische en technologische dapperheid van \"Ocean One\", de humanoïde archeologische robot die de diepzee kan bezoeken!\n\nGratis toegang - reserveren verplicht"
        ],
        "es": [
          "Descubre las proezas técnicas y tecnológicas de \"Ocean One\", ¡el robot humanoide arqueólogo capaz de visitar las profundidades marinas!\n\nEntrada gratuita - reserva obligatoria"
        ]
      },
