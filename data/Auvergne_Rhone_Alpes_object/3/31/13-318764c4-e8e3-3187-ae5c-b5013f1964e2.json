  "rdfs:comment": {
    "de": [
      "Am Samstag, den 11. Juli, laden die Jäger von Chamalières-sur-Loire um 14 Uhr zu einer Wanderung und ab 19 Uhr zu einem festlichen Essen ein, das von der Gruppe Les Compères begleitet wird!"
    ],
    "en": [
      "On Saturday, July 11th, the Chamalières-sur-Loire hunters will be offering a walk at 2pm, followed by a festive meal at 7pm, accompanied by the group Les Compères!"
    ],
    "it": [
      "Sabato 11 luglio, i cacciatori di Chamalières-sur-Loire propongono una passeggiata alle 14.00, seguita da un pranzo festivo alle 19.00, accompagnati dal gruppo Les Compères!"
    ],
    "fr": [
      "Le samedi 11 juillet, les chasseurs de Chamalières-sur-Loire vous propose, à 14h, une marche, et, à partir de 19h, un repas festif accompagné par le groupe Les Compères !"
    ],
    "nl": [
      "Op zaterdag 11 juli bieden de jagers van Chamalières-sur-Loire om 14.00 uur een wandeling aan, gevolgd door een feestmaaltijd vanaf 19.00 uur, onder begeleiding van de groep Les Compères!"
    ],
    "es": [
      "El sábado 11 de julio, los cazadores de Chamalières-sur-Loire propondrán un paseo a las 14:00 h, seguido de una comida festiva a partir de las 19:00 h, ¡acompañados por el grupo Les Compères!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête Nationale à Chamalières-sur-Loire"
    ]
  },
