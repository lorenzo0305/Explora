  "rdfs:comment": {
    "de": [
      "Laden mit regionalen Produkten (natürlich zusätzlich zu Clairette de Die / Crémant de Die / Châtillon): Nougat, Oliven- und Nussöl, Schokolade und Terrine mit Clairette, Honig, Bonbons, Oliven und Tapenade, Nusscreme, Lavendelessenz und -säckchen..."
    ],
    "en": [
      "Regional products shop (in addition of course to Clairette, Crémant and other wines): nougats, olive and walnut oils, chocolate and pâtés flavoured with Clairette wine, honey, sweets, olives and tapenade spreads walnut cream, lavender essential oils and lavender bags…"
    ],
    "it": [
      "Negozio di prodotti regionali (oltre a Clairette de Die / Crémant de Die / Châtillon-en-Diois): vini della Valle del Rodano, torroni, olio d'oliva e noci, cioccolato, miele, dolci, olive e tapenade, crema di noci, essenza di lavanda e bustine..."
    ],
    "fr": [
      "Boutique de produits régionaux (en plus bien sûr des Clairette de Die / Crémant de Die / Châtillon-en-Diois) : vins Vallée Rhône, nougats, huile d'olive et noix, chocolat, miel, bonbons, olives et tapenade, crème de noix, essence et sachets de lavande..."
    ],
    "nl": [
      "Winkel met regionale producten (naast Clairette, Crémant en andere wijnen): nougat, olijfolie, notenolie, chocolade en terrine à la Clairette, honing, snoep, olijven, tapenade, notencrème, lavendelolie en lavendelzakjes, etc."
    ],
    "es": [
      "Tienda de productos regionales (además de Clairette de Die / Crémant de Die / Châtillon-en-Diois): vinos del Valle del Ródano, turrones, aceite de oliva y nueces, chocolate, miel, dulces, aceitunas y tapenade, crema de nueces, esencia y bolsitas de lavanda..."
    ]
  },
