  "rdfs:comment": {
    "de": [
      "Private Box mit einem hochwertigen Indoor-Golfsimulator in Issoire. Spielen Sie das ganze Jahr über mit 1 bis 4 Spielern! Mythische Golfplätze, professionelle Technologie, gemütliche Atmosphäre. Online-Reservierung."
    ],
    "en": [
      "Private box of top-of-the-range indoor golf simulator in Issoire. Play from 1 to 4 players all year round! Mythical courses, professional technology, cosy atmosphere. Book online."
    ],
    "it": [
      "Box privato di simulatori di golf indoor di alta gamma a Issoire. Gioco da 1 a 4 giocatori tutto l'anno! Campi leggendari, tecnologia professionale, atmosfera accogliente. Prenotate online."
    ],
    "fr": [
      "Box privée de simulateur de golf indoor haut de gamme à Issoire. Jouez de 1 à 4 joueurs toute l’année ! Parcours mythiques, technologie professionnelle, ambiance cosy. Réservation en ligne."
    ],
    "nl": [
      "Privébox met indoor golfsimulators van topklasse in Issoire. Speel het hele jaar door voor 1 tot 4 spelers! Legendarische banen, professionele technologie, gezellige sfeer. Reserveer online."
    ],
    "es": [
      "Box privado de simuladores de golf indoor de alta gama en Issoire. Juego de 1 a 4 jugadores durante todo el año Campos legendarios, tecnología profesional, ambiente acogedor. Reserve en línea."
    ]
  },
