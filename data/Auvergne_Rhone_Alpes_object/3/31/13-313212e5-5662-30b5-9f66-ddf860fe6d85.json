  "rdfs:comment": {
    "de": [
      "Gourmetküche, großzügige Küche in einem warmen, familiären Rahmen rund um die guten Gerichte unserer Küchenchefin Alexia. Wir bieten Tagesmenüs unter der Woche, savoyische Spezialitäten, eine Bistrokarte mittags, abends und am Wochenende."
    ],
    "en": [
      "Gourmet cuisine, generously served in a warm, family atmosphere, featuring delicious dishes created by our chef Alexia. We offer daily specials during the week, Savoyard specialities, and a bistronomic menu for lunch, dinner and weekends."
    ],
    "it": [
      "Una cucina generosa e gourmet in un ambiente accogliente e familiare, basata sui deliziosi piatti della nostra chef Alexia. Offriamo menù giornalieri durante la settimana, specialità savoiarde e un menù da bistrot per pranzo, cena e nei fine settimana."
    ],
    "fr": [
      "Cuisine gourmande, généreuse dans un cadre chaleureux, familial autour des bons plats de notre cheffe Alexia. Nous proposons des menus du jour en semaine, des spécialités savoyardes, une carte bistronomique le midi, le soir et le week-end."
    ],
    "nl": [
      "Heerlijke, royale gerechten in een gezellige, familiale sfeer, bereid door onze chef-kok Alexia. Wij bieden doordeweeks dagmenu's, specialiteiten uit de Savoie en een bistronomische kaart voor de lunch, het diner en in het weekend."
    ],
    "es": [
      "Cocina generosa y gastronómica en un ambiente cálido y familiar, en torno a los deliciosos platos de nuestra chef Alexia. Ofrecemos menús diarios durante la semana, especialidades de Saboya y un menú de bistró para el almuerzo, la cena y los fines de semana."
    ]
  },
  "rdfs:label": {
