  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a6d60f4a-ba2c-3bb8-abbf-97ed9491a5e5",
      "dc:description": {
        "de": [
          "Ideal gelegenes Hotel in der Nähe des Kanaltunnels und des Bahnhofs Calais-Fréthun. Es bietet komfortable Zimmer, ein Restaurant, ein Hallenbad, eine Sauna und Tagungsräume. Perfekt für Geschäftsreisende und Touristen."
        ],
        "en": [
          "Ideally located near the Channel Tunnel and Calais-Fréthun railway station. It offers comfortable rooms, a restaurant, indoor pool, sauna and meeting rooms. Perfect for business travelers and tourists alike."
        ],
        "it": [
          "Hotel situato in posizione ideale vicino al tunnel della Manica e alla stazione ferroviaria di Calais-Fréthun. Offre camere confortevoli, un ristorante, una piscina coperta, una sauna e sale riunioni. Perfetto per viaggiatori d'affari e turisti."
        ],
        "fr": [
          "Hôtel idéalement placé près du tunnel sous la Manche et de la gare de Calais-Fréthun. Il propose des chambres confortables, un restaurant, une piscine intérieure, un sauna et des salles de réunion. Parfait pour les voyageurs d'affaires et les touristes."
        ],
        "es": [
          "Hotel idealmente situado cerca del Túnel del Canal y de la estación de tren de Calais-Fréthun. Ofrece habitaciones confortables, un restaurante, una piscina cubierta, una sauna y salas de reuniones. Perfecto para viajeros de negocios y turistas."
        ],
        "nl": [
          "Hotel ideaal gelegen bij de Kanaaltunnel en het treinstation Calais-Fréthun. Het biedt comfortabele kamers, een restaurant, een binnenzwembad, een sauna en vergaderzalen. Perfect voor zakenreizigers en toeristen."
        ]
      },
