  "rdfs:comment": {
    "de": [
      "Der 1988 gegründete Golfplatz Les Chanalets bietet Ihnen: einen 18-Loch-Platz, einen kompakten 4-Loch-Platz, eine Driving Range mit 25 Plätzen (davon 8 überdacht) und ein Putting Green."
    ],
    "en": [
      "Created in 1988, the Chanalets golf course features an 18-hole course, a 4-hole compact course, a 25-station driving range (including 8 covered) and a putting green."
    ],
    "it": [
      "Creato nel 1988, il campo da golf di Chanalets dispone di un percorso a 18 buche, un percorso compatto a 4 buche, un campo pratica a 25 postazioni (di cui 8 coperte) e un putting green."
    ],
    "fr": [
      "Créé en 1988, le golf des Chanalets vous propose : un 18 trous, un compact de 4 trous, un practice de 25 postes (dont 8 couverts), un putting green."
    ],
    "nl": [
      "De golfbaan van Chanalets werd aangelegd in 1988 en heeft een 18-holesbaan, een compacte 4-holesbaan, een driving range met 25 banen (waarvan 8 overdekt) en een putting green."
    ],
    "es": [
      "Creado en 1988, el campo de golf de Chanalets cuenta con un recorrido de 18 hoyos, un recorrido compacto de 4 hoyos, un campo de prácticas de 25 puestos (8 de ellos cubiertos) y un putting green."
    ]
  },
