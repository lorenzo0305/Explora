  "rdfs:comment": {
    "de": [
      "Das Restaurant befindet sich am Fuße der Piste. Die lokale und saisonale Küche bietet Ihnen eine leckere und großzügige Speisekarte.  Das Milkhôtel ist ein Ort der Geselligkeit mit authentischer Atmosphäre."
    ],
    "en": [
      "The restaurant is located at the foot of the track. The local and seasonal cuisine offers you a gourmet and generous menu. The Milkhotel is a friendly place with an authentic atmosphere."
    ],
    "it": [
      "Il ristorante si trova ai piedi della pista. La cucina locale e stagionale offre un menù generoso e gourmet.  Il Milkhôtel è un luogo accogliente con un'atmosfera autentica."
    ],
    "fr": [
      "Le restaurant est situé en pied de piste. La cuisine locale et de saison vous offre une carte gourmande et généreuse.  Le Milkhôtel est un lieu de convivialité à l’atmosphère authentique."
    ],
    "nl": [
      "Het restaurant is gelegen aan de voet van de baan. De lokale en seizoensgebonden keuken biedt u een gastronomisch en royaal menu. Het Milkhotel is een gezellige plek met een authentieke sfeer."
    ],
    "es": [
      "El restaurante se encuentra a pie de pista. La cocina local y de temporada ofrece un menú generoso y gourmet.  El Milkhôtel es un lugar acogedor con un ambiente auténtico."
    ]
  },
