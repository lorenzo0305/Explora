  "rdfs:comment": {
    "de": [
      "Ein Restaurant bietet eine einfache und familiäre Küche.\r\nEs gibt Tagesmenüs und eine Speisekarte mit einer großen Auswahl an hausgemachten Gerichten."
    ],
    "en": [
      "Un Restaurant offers simple, home-style cooking.\r\nDaily set menus and an à la carte menu with a varied choice of home-cooked dishes."
    ],
    "it": [
      "Il ristorante presenta una cucina semplice e familiare\r\nMenu fissi giornalieri e un menu con una scelta variegata di piatti completamente cucinati in casa."
    ],
    "fr": [
      "Un Restaurant présente une cuisine simple et familiale. \r\nDes menus à la formule du jour ainsi qu'une carte avec un choix varié de plats intégralement cuisinés maison."
    ],
    "es": [
      "El restaurante presenta una cocina sencilla y familiar\r\nMenús diarios y una carta con una variada oferta de platos totalmente caseros."
    ],
    "nl": [
      "Dit restaurant biedt een eenvoudige, huiselijke keuken.\r\nDagelijkse vaste menu's en een à la carte menu met een gevarieerde keuze aan huisgemaakte gerechten."
    ]
  },
