  "rdfs:comment": {
    "de": [
      "Von Estelle und Cécile geführter süßer und salziger Lebensmittelladen für Schüttgut, der zu über 90% aus lokalen Produkten besteht: Obst und Gemüse, Käse, Pflegeprodukte, Zero-Waste-Produkte und vieles mehr!\r\nDas ganze Jahr über organisierte Workshops."
    ],
    "en": [
      "Sweet and savory bulk grocery store run by Estelle and Cécile, offering over 90% local produce: fruits and vegetables, cheeses, skincare products, zero-waste products and much more!\r\nWorkshops organized throughout the year."
    ],
    "it": [
      "Una drogheria sfusa dolce e salata gestita da Estelle e Cécile, che offre oltre il 90% di prodotti locali: frutta e verdura, formaggi, prodotti per la cura della pelle, prodotti a zero rifiuti e molto altro!\r\nLaboratori organizzati durante tutto l'anno."
    ],
    "fr": [
      "Épicerie sucrée et salée de vrac tenue par Estelle et Cécile qui proposent plus de 90% de produits locaux : fruits et légumes, fromages, produits de soins, produits zéro déchet et bien plus !\r\nAteliers organisés tout au long de l'année."
    ],
    "es": [
      "Una tienda a granel de productos dulces y salados dirigida por Estelle y Cécile, que ofrece más del 90% de productos locales: frutas y verduras, quesos, productos para el cuidado de la piel, productos de residuo cero y mucho más\r\nTalleres organizados durante todo el año."
    ],
    "nl": [
      "Een zoete en hartige groentewinkel gerund door Estelle en Cécile, die meer dan 90% lokale producten aanbieden: fruit en groenten, kazen, huidverzorgingsproducten, zero waste producten en nog veel meer!\r\nHet hele jaar door worden er workshops georganiseerd."
    ]
  },
  "rdfs:label": {
