  "rdfs:comment": {
    "de": [
      "Laotische und thailändische Spezialitäten.\r\nIm kleinen Saal dieses exotisch eingerichteten Restaurants werden Ihnen schmackhafte und abwechslungsreiche Gerichte serviert. Es gibt etwas für jeden Geschmack, Fleisch, Fisch und sogar einige Sushis. Service zum Mitnehmen."
    ],
    "en": [
      "Laotian and Thai specialties.\r\nThe small room of this exotic decoration restaurant offers tasty and varied dishes. There is something for everyone, meat, fish, vegetables and even some sushi. Take away service"
    ],
    "it": [
      "Specialità laotiane e thailandesi.\r\nLa piccola sala di questo ristorante dalle decorazioni esotiche offre piatti gustosi e variegati. Ce n'è per tutti i gusti, carne, pesce e persino sushi. Servizio d'asporto."
    ],
    "fr": [
      "Spécialités laotiennes et thaïlandaises.\r\nLa petite salle de ce restaurant à la décoration exotique vous propose des plats savoureux et variés. Il y en a pour tous les goûts, viandes, poissons, et même quelques sushis. Service de vente à emporter."
    ],
    "nl": [
      "Laotiaanse en Thaise specialiteiten.\r\nDe kleine zaal van dit restaurant met zijn exotische decoratie biedt u smakelijke en gevarieerde gerechten. Er is voor elk wat wils, vlees, vis en zelfs sushi. Afhaalservice."
    ],
    "es": [
      "Especialidades laosianas y tailandesas.\r\nLa pequeña sala de este restaurante, con su exótica decoración, le ofrece platos sabrosos y variados. Hay para todos los gustos, carne, pescado e incluso algo de sushi. Servicio de comida para llevar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chiangmaï restaurant"
    ],
    "fr": [
      "Chiangmaï"
    ]
  },
