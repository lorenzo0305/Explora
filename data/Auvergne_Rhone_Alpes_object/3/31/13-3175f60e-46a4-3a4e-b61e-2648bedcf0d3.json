  "rdfs:comment": {
    "de": [
      "Paillote des Lächelns und des Teilens seit 2014. Küche aus aller Welt. Bietet auch vegetarische Gerichte an. Bar und Cocktails.\r\nOrt des Teilens. Im Schatten der Bäume, mit den Füßen im Wasser."
    ],
    "en": [
      "Paillote of smiles and sharing since 2014. World cuisine. Bar and cocktails\r\nA place for sharing. In the shade of trees, feet in the water."
    ],
    "it": [
      "Paillote del sorriso e della condivisione dal 2014. Cucina mondiale. Offre anche piatti vegetariani. Bar e cocktail. Tavole.\nUn luogo di condivisione. All'ombra degli alberi, con i piedi nell'acqua."
    ],
    "fr": [
      "Paillote de sourire et de partage depuis 2014. Cuisine du monde. Propose aussi des plats végétariens. Bar et cocktails. Planches.\nLieu de partage. A l'ombre des arbres, les pieds dans l'eau."
    ],
    "nl": [
      "Paillote van glimlachen en delen sinds 2014. Wereldkeuken. Vegetarische gerechten beschikbaar. Bar en cocktails\r\nEen plek om te delen. In de schaduw van de bomen, met je voeten in het water."
    ],
    "es": [
      "Paillote de sonrisas y compartir desde 2014. Cocina del mundo. También ofrece platos vegetarianos. Bar y coctelería. Paillote.\nUn lugar para compartir. A la sombra de los árboles, con los pies en el agua."
    ]
  },
