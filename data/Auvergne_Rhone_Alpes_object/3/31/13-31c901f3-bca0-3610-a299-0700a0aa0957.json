  "rdfs:comment": {
    "de": [
      "Der Lac de Vernant ist ein Bergsee am Ende eines grasbewachsenen Tals, in dem man Bachforellen, Regenbogenforellen und Lachse angeln kann"
    ],
    "en": [
      "Lake Vernant is a mountain lake located at the bottom of a grassy valley, where you can fish for brown trout, rainbow trout, and salmon."
    ],
    "it": [
      "Il Lac de Vernant è un lago di montagna in fondo a una valle erbosa dove si possono pescare trote fario, trote iridee e salmoni"
    ],
    "fr": [
      "Le lac de Vernant est un plan d'eau de montagne situé au fond d'un vallon enherbé où l'on peut pêcher de la truite fario, de la truite arc-en-ciel et du saumon"
    ],
    "nl": [
      "Het Vernantmeer is een bergmeer gelegen op de bodem van een groene vallei, waar je kunt vissen op beekforel, regenboogforel en zalm."
    ],
    "es": [
      "El Lac de Vernant es un lago de montaña situado en el fondo de un valle cubierto de hierba donde se pueden pescar truchas marrones, truchas arco iris y salmones"
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing at Lake Vernant"
    ],
    "fr": [
      "Pêche au lac de Vernant"
    ],
    "nl": [
      "Vissen op het meer van Vernant"
    ]
  },
