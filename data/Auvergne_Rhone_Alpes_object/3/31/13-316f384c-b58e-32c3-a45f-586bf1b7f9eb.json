  "rdfs:comment": {
    "de": [
      "Familienbetrieb seit dem 16. Jahrhundert, in dem Kühe der Rasse Aubrac gezüchtet werden.\r\nDie GAEC de la Gentiane bevorzugt eine nachhaltige Landwirtschaft und kurze Transportwege."
    ],
    "en": [
      "A family farm since the 16th century, where Aubrac cows are raised.\r\nThe GAEC de la Gentiane favors sustainable agriculture and short supply chains."
    ],
    "it": [
      "Un'azienda agricola a conduzione familiare dal XVI secolo, dove si allevano mucche di razza Aubrac.\r\nIl GAEC de la Gentiane favorisce un'agricoltura sostenibile e canali di distribuzione brevi."
    ],
    "fr": [
      "Exploitation familiale depuis le 16e siècle où sont élevées des vaches de race Aubrac.\r\nLe GAEC de la Gentiane privilégie une agriculture raisonnée et les circuits courts."
    ],
    "es": [
      "Una explotación familiar desde el siglo XVI, donde se crían vacas de raza Aubrac.\r\nEl GAEC de la Gentiane favorece la agricultura sostenible y los circuitos cortos de distribución."
    ],
    "nl": [
      "Een familieboerderij sinds de 16e eeuw, waar Aubrac-koeien worden gehouden.\r\nDe GAEC de la Gentiane is voorstander van duurzame landbouw en korte distributiekanalen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gentiane (GAEC de la)"
    ]
  },
