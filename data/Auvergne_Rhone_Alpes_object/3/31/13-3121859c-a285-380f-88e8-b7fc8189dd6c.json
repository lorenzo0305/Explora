  "rdfs:comment": {
    "de": [
      "Das traditionelle Treffen von Oldtimern kehrt für seine 10. Ausgabe zu den Ateliers Magiques zurück.\r\nEin geselliger Tag für die ganze Familie mit kostenlosen Animationen im Freien am Fuße des Vercors!"
    ],
    "en": [
      "The traditional classic car show returns for its 10th edition at Les Ateliers Magiques.\r\nA family-friendly day of free outdoor entertainment at the foot of the Vercors!"
    ],
    "it": [
      "Il tradizionale salone di auto d'epoca torna per il 10° anno a Les Ateliers Magiques.\r\nUna giornata all'insegna del divertimento per tutta la famiglia, con intrattenimento gratuito all'aperto ai piedi del Vercors!"
    ],
    "fr": [
      "Le traditionnel rassemblement de véhicules de collection revient pour sa 10ème édition aux Ateliers Magiques.\r\nUne journée conviviale pour toute la famille pour des animations gratuites en extérieur au pied du Vercors !"
    ],
    "es": [
      "El tradicional salón del automóvil clásico vuelve por décima vez a los Ateliers Magiques.\r\nUna jornada lúdica para toda la familia, con animaciones gratuitas al aire libre y a los pies del Vercors"
    ],
    "nl": [
      "De traditionele klassieke autoshow keert voor zijn 10e jaar terug naar Les Ateliers Magiques.\r\nEen dag vol plezier voor het hele gezin, met gratis entertainment in de open lucht aan de voet van de Vercors!"
    ]
  },
