  "rdfs:comment": {
    "de": [
      "Ich betreibe seit 2020 eine Imkerei im kleinen Maßstab mit einer vernünftigen Führung des Bienenstocks.\r\nVerkauf vor Ort und nur nach Vereinbarung."
    ],
    "en": [
      "Since 2020, I've been practicing small-scale beekeeping, with a reasoned approach to apiary management.\r\nOn-site sales by appointment only."
    ],
    "it": [
      "Dal 2020 pratico l'apicoltura su piccola scala, con una gestione ragionata dell'apiario.\r\nVendita in loco solo su appuntamento."
    ],
    "fr": [
      "Je pratique depuis 2020 une apiculture à petite échelle, avec une conduite du rucher raisonnée. \r\nVente sur place et uniquement sur rendez-vous."
    ],
    "nl": [
      "Sinds 2020 beoefen ik bijenteelt op kleine schaal, met beredeneerd beheer van de bijenstal.\r\nVerkoop ter plaatse alleen op afspraak."
    ],
    "es": [
      "Desde 2020, practico la apicultura a pequeña escala, con una gestión razonada del colmenar.\r\nVenta in situ solo con cita previa."
    ]
  },
