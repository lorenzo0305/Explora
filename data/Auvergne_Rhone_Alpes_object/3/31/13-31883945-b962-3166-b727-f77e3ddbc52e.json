  "rdfs:comment": {
    "de": [
      "Die zwischen 1937 und 1940 erbaute Kirche Notre-Dame de Lourdes ist eines der seltenen Beispiele für eine Art-déco-Kirche in der Region. Die künstlerische Auswahl der gemalten Verzierungen, der Glasfenster und des Altars zeigen ein sehr modernes Ensemble."
    ],
    "en": [
      "Built between 1937 and 1940, Notre-Dame de Lourdes is one of the few examples of an Art Deco church in the region. The artistic choices of painted decor, stained glass and altar reveal a resolutely modern ensemble."
    ],
    "it": [
      "Costruita tra il 1937 e il 1940, Notre-Dame de Lourdes è uno dei rari esempi di chiesa Art Déco della regione. Le scelte artistiche della decorazione pittorica, delle vetrate e dell'altare rivelano un insieme decisamente moderno."
    ],
    "fr": [
      "Construite entre 1937 et 1940, Notre-Dame - de -Lourdes est un des rares exemples d’église Art déco sur le territoire. Les choix artistiques des décors peints, des vitraux et de son autel révèlent un ensemble résolument moderne."
    ],
    "nl": [
      "Gebouwd tussen 1937 en 1940, is Notre-Dame de Lourdes een van de zeldzame voorbeelden van een Art Deco kerk in de regio. De artistieke keuzes van het geschilderde decor, de glas-in-loodramen en het altaar verraden een resoluut modern geheel."
    ],
    "es": [
      "Construida entre 1937 y 1940, Notre-Dame de Lourdes es uno de los raros ejemplos de iglesia Art Déco de la región. Las elecciones artísticas de la decoración pintada, las vidrieras y el altar revelan un conjunto decididamente moderno."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée : Les icones religieuses dans l'art moderne"
    ]
  },
