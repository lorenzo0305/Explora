  "rdfs:comment": {
    "de": [
      "Am 13. Juli feiert die Feuerwehr von Vorey den Nationalfeiertag auf dem Place des Moulettes, an der Kanubasis und in der Mehrzweckhalle: Ab 14 Uhr gibt es einen Boule-Wettbewerb und am Abend Feuerwerk und kostenlosen Tanz."
    ],
    "en": [
      "On July 13, Vorey's firefighters will be celebrating the Fête Nationale on the Place des Moulettes, at the canoe base and at the salle polyvalente: from 2pm, pétanque competition, and in the evening fireworks and free dance."
    ],
    "it": [
      "Il 13 luglio, i vigili del fuoco di Vorey celebreranno la Fête Nationale sulla Place des Moulettes, presso la base di canoa e la sala polivalente: dalle 14:00, gara di pétanque, e in serata fuochi d'artificio e ballo libero."
    ],
    "fr": [
      "Le 13 juillet les pompiers de Vorey célébreront la Fête Nationale sur la Place des Moulettes, à la base canoë et à la salle polyvalente : dès 14h, concours de pétanque, et en soirée feux d'artifices et bal gratuit."
    ],
    "nl": [
      "Op 13 juli viert de brandweer van Vorey het Fête Nationale op de Place des Moulettes, bij de kanobasis en bij de salle polyvalente: vanaf 14.00 uur jeu de boules-wedstrijd en 's avonds vuurwerk en vrij dansen."
    ],
    "es": [
      "El 13 de julio, los bomberos de Vorey celebrarán la Fiesta Nacional en la plaza des Moulettes, en la base de canoas y en la sala polivalente: a partir de las 14.00 h, competición de petanca, y por la noche fuegos artificiales y baile libre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête Nationale à Vorey"
    ]
  },
