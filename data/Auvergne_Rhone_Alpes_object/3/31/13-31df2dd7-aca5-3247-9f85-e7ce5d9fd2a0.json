  "rdfs:comment": {
    "de": [
      "Via-Allier: Die Fahrradroute der Auvergne\r\nDas Tourismusbüro von Brioude Sud Accueil, das kürzlich mit dem Gütesiegel Accueil-vélo ausgezeichnet wurde, ist anwesend, um einen qualitativ hochwertigen Service anzubieten"
    ],
    "en": [
      "Via-Allier : The Auvergne cycle route\r\nThe Brioude Sud Accueil tourist office, recently awarded the \"Accueil-vélo\" label, is on hand to offer a quality service"
    ],
    "it": [
      "Via-Allier: l'itinerario ciclabile dell'Alvernia\r\nL'ufficio turistico di Brioude Sud Accueil, recentemente insignito del marchio \"Accueil-vélo\", è a disposizione per offrire un servizio di qualità"
    ],
    "fr": [
      "Via-Allier : La Véloroute de l'Auvergne \r\nL'office de tourisme de Brioude Sud Accueil récemment labelisé Accueil-vélo présent pour offrir un service de qualité"
    ],
    "es": [
      "Via-Allier : La ruta ciclista de Auvernia\r\nLa oficina de turismo Brioude Sud Accueil, recientemente galardonada con el sello \"Accueil-vélo\", está a su disposición para ofrecerle un servicio de calidad"
    ],
    "nl": [
      "Via-Allier : De fietsroute van de Auvergne\r\nHet VVV-kantoor Brioude Sud Accueil, onlangs bekroond met het label \"Accueil-vélo\", staat klaar om een kwaliteitsservice te bieden"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Allier, la véloroute de l'Auvergne"
    ]
  },
