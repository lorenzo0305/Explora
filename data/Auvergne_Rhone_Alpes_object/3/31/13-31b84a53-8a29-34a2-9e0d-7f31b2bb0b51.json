  "rdfs:comment": {
    "de": [
      "Teufel von Bessans, Salzhühner, Barock- und Tierstatuen ... Die Kunsthandwerker Georges und Fabrice Personnaz führen die jahrhundertealte Tradition der Bessanser Bildhauer fort."
    ],
    "en": [
      "Devils of Bessans, hens for salt, baroque and animal statues … Georges and Fabrice Personnaz, creative craftsmen, immortalize the secular tradition of the bessanais sculptors."
    ],
    "it": [
      "Diavoli di Bessans, galline a sale, statue barocche ed animalières  Giorgio e Fabrizio Personnaz, artigiani di arte, perpetuano la tradizione secolare degli scultori bessanais."
    ],
    "fr": [
      "Diables de Bessans, poules à sel, statues baroques et animalières … Georges et Fabrice Personnaz, artisans d'art, perpétuent la tradition séculaire des sculpteurs bessanais."
    ],
    "es": [
      "¿Diablos de Bessans, gallinas de sal, estatuas barrocas y de animales? Georges y Fabrice Personnaz, artesanos, perpetúan la antigua tradición de los escultores de Bessan."
    ],
    "nl": [
      "Devils van Bessans, kippen met zout, barok en dierlijke standbeelden … Georges en Fabrice Personnaz, creatieve ambachtslui, vereeuwigen de seculiere traditie van de bessanais beeldhouwers."
    ]
  },
