      "@id": "https://data.datatourisme.fr/8e9def30-a0cc-3bc6-b6ce-32ea2a4d4ae0",
      "dc:description": {
        "de": [
          "Café, Bar, Tabakladen, PMU neben dem großen Platz von Etaples, gesellige Atmosphäre mit Billard, Flipper, TV.\nSpielübertragungen und Abendunterhaltung."
        ],
        "en": [
          "Café, bar, Tabac, PMU located next to the main square in Etaples, friendly atmosphere with billiards, pinball, TV.\nGame broadcasts and evening entertainment."
        ],
        "it": [
          "Caffè, bar, tabaccheria, PMU situato vicino alla piazza principale di Etaples, atmosfera amichevole con tavolo da biliardo, flipper, TV.\nTrasmissione di partite e serate animate."
        ],
        "fr": [
          "Café, bar, Tabac, PMU situé à côté de la grande place d'Etaples, ambiance conviviale avec billard, flipper, TV.\nDiffusion de match et soirées animées."
        ],
        "nl": [
          "Café, bar, tabakswinkel, PMU gelegen naast het centrale plein in Etaples, gezellige sfeer met biljart, flipperkast, tv.\nUitzending van wedstrijden en gezellige avonden."
        ],
        "es": [
          "Café, bar, estanco, PMU situado junto a la plaza principal de Etaples, ambiente agradable con mesa de billar, pinball, TV.\nRetransmisión de partidos y veladas animadas."
        ]
      },
