  "rdfs:comment": {
    "de": [
      "Entdeckung oder Perfektionierung. Montag und Donnerstag für 5-8-Jährige; Dienstag und Freitag für 9-13-Jährige. Offen für alle, ob mit oder ohne Lizenz. Picknick mitzubringen."
    ],
    "en": [
      "Discovery or improvement. Mondays and Thursdays for 5-8 year-olds; Tuesdays and Fridays for 9-13 year-olds. Open to all, members of the club or not. Bring your own picnic."
    ],
    "it": [
      "Scoperta o miglioramento. Lunedì e giovedì per bambini dai 5 agli 8 anni; martedì e venerdì per ragazzi dai 9 ai 13 anni. Aperto a tutti, con o senza licenza. Portate il vostro picnic."
    ],
    "fr": [
      "Découverte ou perfectionnement. Lundi et jeudi pour les 5-8 ans ; mardi et vendredi pour les 9-13 ans. Ouvert à toutes et tous, licenciés ou non. Pique-nique à apporter."
    ],
    "nl": [
      "Ontdekking of verbetering. Maandag en donderdag voor kinderen van 5-8 jaar; dinsdag en vrijdag voor kinderen van 9-13 jaar. Open voor iedereen, met of zonder rijbewijs. Neem je eigen picknick mee."
    ],
    "es": [
      "Descubrimiento o perfeccionamiento. Lunes y jueves para niños de 5 a 8 años; martes y viernes para niños de 9 a 13 años. Abierto a todos, con o sin carné. Traiga su propio picnic."
    ]
  },
