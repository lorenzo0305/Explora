  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ba613903-35be-3470-ae11-de44debc466d",
      "dc:description": {
        "de": [
          "Restaurant mit Meerblick, traditionelle Küche, regelmäßig wechselnde Speisekarte, Möglichkeit, den hinteren Raum mit Meerblick zu reservieren. Frische Produkte, Fisch je nach Ankunft, hausgemachte Pommes frites"
        ],
        "en": [
          "Restaurant with sea view, traditional cuisine, menu changed regularly, possibility to book the back room with sea view. Fresh products, fish according to arrival, homemade fries"
        ],
        "it": [
          "Ristorante con vista sul mare, cucina tradizionale, menu che cambia regolarmente, possibilità di prenotare la sala posteriore con vista sul mare. Prodotti freschi, pesce secondo l'arrivo, patatine fritte fatte in casa"
        ],
        "fr": [
          "Restaurant vue mer, cuisine traditionnelle, carte changée régulièrement, possibilité de réserver salle du fond avec vue mer. Produits frais, poisson selon arrivage, frites faites maison"
        ],
        "es": [
          "Restaurante con vistas al mar, cocina tradicional, menú que cambia regularmente, posibilidad de reservar la sala trasera con vistas al mar. Productos frescos, pescado según llegada, patatas fritas caseras"
        ],
        "nl": [
          "Restaurant met uitzicht op zee, traditionele keuken, regelmatig gewijzigd menu, mogelijkheid om de achterkamer met uitzicht op zee te reserveren. Verse producten, vis volgens aankomst, huisgemaakte frieten"
        ]
      },
      "@type": [
        "Description"
