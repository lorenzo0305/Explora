  "rdfs:comment": {
    "de": [
      "YOGA,MEDIATION,SOPHROLOGIE,MASSAGE-BIEN-ETRE auf Anfrage: für Erwachsene, Kinder, Jugendliche. Unter der Woche, an Wochenenden und in Praktika. \"Stressbewältigung\" \"Schlaf\". Einzel- oder Gruppensitzungen. Im Herzen des Dorfes, ruhiger Ort. Unterkünfte in der Nähe."
    ],
    "en": [
      "Open ALL YEAR LONG. Week-ends, half and day workshops , on request. Sophro \"STRESS MANAGEMENT\", \"INSOMNIA\". Also INDIVIDUAL sessions.\r\nYOGA MEDITATION. Experienced and beginners. In the heart of the village. Accomodation close-by."
    ],
    "it": [
      "YOGA, MEDITAZIONE, SOPHROLOGIA, MASSAGGIO-BIEN-ETRE su richiesta: per adulti, bambini, adolescenti. Giorni feriali, weekend e corsi. \"Gestione dello stress\" \"Sonno\". Sessioni individuali o di gruppo. Nel cuore del villaggio, luogo tranquillo. Alloggio nelle vicinanze."
    ],
    "fr": [
      "YOGA,MÉDIATION,SOPHROLOGIE,MASSAGE-BIEN-ETRE à la demande : pour adultes, enfants, ados. En semaine, Week-end et stages. \"Gérer son stress\" \"Sommeil\". Séances individuelles ou groupes. Cœur du village, lieu calme. Hébergements proches."
    ],
    "nl": [
      "YOGA, MEDIATION, SOPHROLOGIE, WELL-BEING MASSAGE op aanvraag: voor volwassenen, kinderen en tieners. Weekdagen, weekends en cursussen. \"Omgaan met stress\" \"Slaap\". Individuele sessies of groepssessies. Rustige locatie in het hart van het dorp. Accommodatie in de buurt."
    ],
    "es": [
      "YOGA, MEDIACIÓN, SOPHROLOGÍA, MASAJE-BIEN-ETRE a la carta: para adultos, niños, adolescentes. Días laborables, fines de semana y cursos. \"Gestión del estrés\" \"Sueño\". Sesiones individuales o en grupo. En el corazón del pueblo, lugar tranquilo. Alojamiento cercano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Sophrologue - Professeur Yoga méditation - Sophie Tresca"
    ]
  },
