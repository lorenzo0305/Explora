  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6d610340-8c5a-332a-8265-9160fa8c5141",
      "dc:description": {
        "de": [
          "Täglich geöffnet von 10-12 Uhr und 14-19 Uhr (Sperrstunde 17:30 Uhr) / Mittwochs und sonntags geschlossen\nEin neuer Ort mitten im Stadtzentrum für Tätowierungsfans. Ein Team, bestehend aus 3 Personen, empfängt und berät Sie in einem komfortablen Salon mit besonders gepflegter Dekoration."
        ],
        "en": [
          "Open daily from 10am to 12pm and from 2pm to 7pm (curfew 5:30pm) / Closed on Wednesdays and Sundays\nA new downtown location for tattoo enthusiasts. A 3-strong team welcomes and advises you in a comfortable, well-decorated salon."
        ],
        "it": [
          "Aperto tutti i giorni dalle 10.00 alle 12.00 e dalle 14.00 alle 19.00 (coprifuoco alle 17.30) / Chiuso il mercoledì e la domenica\nUn nuovo locale in centro città per gli appassionati di tatuaggi. Un team di tre persone vi accoglie e vi consiglia in un salone confortevole e ben arredato."
        ],
        "fr": [
          "Ouvert tous les jours de 10h à 12h et de 14h à 19h (couvre-feu 17h30) / Fermé le mercredi et le dimanche\nUn nouveau lieu en plein centre-ville pour les adeptes du tatouage. Une équipe, composée de 3 personnes, vous accueille et vous conseille dans un salon confortable et à la décoration particulièrement soignée."
        ],
        "nl": [
          "Elke dag geopend van 10.00 tot 12.00 uur en van 14.00 tot 19.00 uur (avondklok 17.30 uur) / Gesloten op woensdag en zondag\nEen nieuwe plek in het stadscentrum voor tattooliefhebbers. Een 3-koppig team verwelkomt en adviseert je in een comfortabele, prachtig ingerichte salon."
        ],
        "es": [
          "Abierto todos los días de 10.00 a 12.00 y de 14.00 a 19.00 (toque de queda a las 17.30) / Cerrado miércoles y domingos\nUn nuevo lugar en el centro de la ciudad para los amantes de los tatuajes. Un equipo de 3 personas le acoge y le aconseja en un salón cómodo y bien decorado."
        ]
      },
