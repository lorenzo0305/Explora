  "rdfs:comment": {
    "de": [
      "Stéphane Verdet ist Bergbegleiter und Guide du Patrimoine Savoie Mont Blanc (Tours de Montmayeur). Er hat eine besondere Sensibilität für die Geschichte der Landwirtschaft in den Bergen und eine Leidenschaft für die Vermittlung an junge Menschen."
    ],
    "en": [
      "Stéphane Verdet is a mountain leader and Savoie Mont Blanc Heritage Guide (Tours de Montmayeur). He has a particular interest in the history of mountain farming, and a passion for passing on his knowledge to young people."
    ],
    "it": [
      "Stéphane Verdet è guida alpina e guida del patrimonio della Savoia Monte Bianco (Tours de Montmayeur). Ha un interesse particolare per la storia dell'agricoltura di montagna e la passione di trasmettere le sue conoscenze ai giovani."
    ],
    "fr": [
      "Stéphane Verdet est accompagnateur en montagne et Guide du Patrimoine Savoie Mont Blanc (Tours de Montmayeur). Il a une sensibilité particulière pour l'histoire de l'agriculture en montagne et une passion pour la transmission auprès des jeunes."
    ],
    "nl": [
      "Stéphane Verdet is bergleider en erfgoedgids van de Savoie Mont Blanc (Tours de Montmayeur). Hij heeft een bijzondere belangstelling voor de geschiedenis van de berglandbouw en een passie voor het doorgeven van zijn kennis aan jongeren."
    ],
    "es": [
      "Stéphane Verdet es monitor de montaña y guía del patrimonio de Savoie Mont Blanc (Tours de Montmayeur). Le interesa especialmente la historia de la agricultura de montaña y le apasiona transmitir sus conocimientos a los jóvenes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Stéphane Verdet - Guide du Patrimoine Savoie Mont Blanc"
    ]
  },
