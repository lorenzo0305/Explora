  "rdfs:comment": {
    "de": [
      "Internationale Bar mit musikalischer Atmosphäre und DJ.\r\nEntdecken Sie die Grotte, in der sich alle Yetis für völlig verrückte Abende treffen.\r\nUnsere Einrichtung ist für große Gruppen geeignet (Studentenaufenthalte, Firmenseminare ...)."
    ],
    "en": [
      "International music bar with DJ.\r\nCome and discover the Grotte, where all the Yetis meet for wild and unforgettable nights.\r\nOur venue is perfectly suited for hosting large groups (student trips, corporate seminars, etc.)."
    ],
    "it": [
      "Bar internazionale con musica e DJ.\r\nVenite a scoprire la Grotta, dove tutti gli Yeti si ritrovano per serate completamente pazze.\r\nIl nostro locale è adatto ad accogliere grandi gruppi (soggiorni studenteschi, seminari aziendali, ecc.)."
    ],
    "fr": [
      "Bar international à ambiance musicale avec DJ.\r\nVenez découvrir la Grotte où se retrouvent tous les Yétis pour des soirées complètement folles.\r\nNotre établissement est adapté à l'accueil de grands groupes (séjours étudiants, séminaires d'entreprise ...)."
    ],
    "nl": [
      "Internationale bar met livemuziek en DJ.\r\nKom en ontdek de Grot, waar alle Yeti's samenkomen voor wilde feesten.\r\nOns etablissement is geschikt voor grote groepen (studenten, bedrijfsseminars, enz.)."
    ],
    "es": [
      "Bar internacional con música en directo y DJ.\r\nVenga a descubrir la Gruta, donde todos los Yetis se reúnen para fiestas salvajes.\r\nNuestro establecimiento es adecuado para grupos grandes (estancias de estudiantes, seminarios de empresa, etc.)."
    ]
  },
  "rdfs:label": {
