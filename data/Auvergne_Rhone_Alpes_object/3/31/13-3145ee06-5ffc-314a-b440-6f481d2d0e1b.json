  "rdfs:comment": {
    "de": [
      "Landwirtschaftliche Produktion: Zucht von Haflinger- und Freizeitpferden, Getreide, Futtermittel.\r\nWeitere Informationen finden Sie auf der Website des Betriebs."
    ],
    "en": [
      "Equestrian centre, approved with French quality label “Bienvenue à la Ferme”.\r\nFormer 16th century silk manufacture in southern Ardèche, overlooking the famous Gorges and Labeaume, a village of character. \r\nDaytrips and riding adventures including setting up an overnight camp under the stars. \r\nHorse and pony rides – All levels. \r\nGroups welcome: Camping on the farm.\r\nWell-appointed self-catering accommodation available on the premises. \r\nEnglish spoken."
    ],
    "it": [
      "Prodotti dell'azienda: allevamento di cavalli Haflinger e cavalli da tempo libero, cereali, foraggio.\r\nPer maggiori informazioni, visitate il sito web della fattoria"
    ],
    "fr": [
      "Productions de la ferme : élevage de chevaux Haflinger et chevaux de loisirs, céréales, fourrages.\r\nPour en savoir plus, visitez le site internet de la ferme"
    ],
    "es": [
      "Productos agrícolas: cría de caballos Haflinger y de ocio, cereales, forraje.\r\nPara más información, visite el sitio web de la granja"
    ],
    "nl": [
      "Boerderijproducties: haflinger paarden en recreatieve paarden, granen, veevoer.\r\nVoor meer informatiekan je naar de website van de boerderij gaan."
    ]
  },
