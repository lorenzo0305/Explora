  "rdfs:comment": {
    "de": [
      "Der ländliche Kulturraum mit einer Kapazität für 140 Personen bietet lokalen Vereinen, aber auch Privatpersonen und Unternehmen das ganze Jahr über die Möglichkeit, ihre Veranstaltungen und diversen Events zu organisieren."
    ],
    "en": [
      "The cultural rural space with a capacity of 140 people, offers to local associations but also to individuals and companies the possibility of organizing their demonstrations and various events during all the year."
    ],
    "it": [
      "Lo spazio culturale rurale, con una capacità di 140 persone, offre alle associazioni locali, ai privati e alle aziende la possibilità di organizzare i loro vari eventi durante tutto l'anno."
    ],
    "fr": [
      "L’espace rural culturel d’une capacité d’accueil de 140 personnes, offre aux associations locales mais aussi aux particuliers et entreprises la possibilité d’organiser leurs manifestations et événements divers durant toute l’année."
    ],
    "es": [
      "El espacio cultural rural, con capacidad para 140 personas, ofrece a las asociaciones locales, así como a particulares y empresas, la posibilidad de organizar sus diversos eventos a lo largo del año."
    ],
    "nl": [
      "De landelijke culturele ruimte, met een capaciteit van 140 personen, biedt zowel plaatselijke verenigingen als particulieren en bedrijven de mogelijkheid om het hele jaar door verschillende evenementen te organiseren."
    ]
  },
