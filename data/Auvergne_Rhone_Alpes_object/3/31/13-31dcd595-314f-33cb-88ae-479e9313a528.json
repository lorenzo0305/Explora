  "rdfs:comment": {
    "de": [
      "Der Bergführer Jehan-Roland Guillot bietet zahlreiche Aktivitäten im Vercors an.\r\nVerwaltung des Eisfalls in Lans en Vercors."
    ],
    "en": [
      "Jehan-Roland Guillot is a mountain guide who offers many activities in the Vercors. He manages the Lans-en-Vercors ice waterfall."
    ],
    "it": [
      "Jehan-Roland Guillot, guida di alta montagna, propone numerose attività nel Vercors.\r\nGestione della cascata di ghiaccio di Lans en Vercors."
    ],
    "fr": [
      "Jehan-Roland Guillot, guide de haute montagne, propose de nombreuses activités sur le Vercors.\r\nGestion de la cascade de glace de Lans en Vercors."
    ],
    "es": [
      "Jehan-Roland Guillot, guía de alta montaña, ofrece numerosas actividades en el Vercors.\r\nGestión del desprendimiento de hielo de Lans en Vercors."
    ],
    "nl": [
      "Jehan-Roland Guillot, gids voor het hooggebergte, biedt vele activiteiten aan in de Vercors.\r\nBeheer van de ijsval van Lans en Vercors."
    ]
  },
