  "rdfs:comment": {
    "de": [
      "In Aix-la-Fayette bietet unser Restaurant eine hausgemachte, lokale und saisonale Küche, die in einer gemütlichen Atmosphäre serviert wird. Bar, kleiner Lebensmittelladen, Terrasse unter den Linden und freundlicher Empfang und Gourmetküche."
    ],
    "en": [
      "In Aix-la-Fayette, our restaurant offers homemade, local and seasonal cuisine, served in a warm atmosphere. Bar, small grocery store, terrace under the linden trees, friendly welcome and gourmet cuisine."
    ],
    "it": [
      "Ad Aix-la-Fayette, il nostro ristorante propone una cucina casalinga, locale e stagionale, servita in un'atmosfera accogliente. Bar, piccola drogheria, terrazza sotto i tigli, accoglienza cordiale e cucina gourmet."
    ],
    "fr": [
      "À Aix-la-Fayette, notre restaurant propose une cuisine maison, locale et de saison, servie dans une ambiance chaleureuse. Bar, petite épicerie, terrasse sous les tilleuls et accueil convivial et cuisine gourmande."
    ],
    "nl": [
      "In Aix-la-Fayette biedt ons restaurant huisgemaakte, lokale en seizoensgebonden gerechten, geserveerd in een warme sfeer. Bar, kleine kruidenierswinkel, terras onder de lindebomen, vriendelijk onthaal en gastronomische keuken."
    ],
    "es": [
      "En Aix-la-Fayette, nuestro restaurante ofrece cocina casera, local y de temporada, servida en un ambiente cálido. Bar, pequeña tienda de comestibles, terraza bajo los tilos, acogida cordial y cocina gastronómica."
    ]
  },
