  "rdfs:comment": {
    "de": [
      "In der Nähe von Lyon, im Herzen des Einkaufszentrums Caluire 2, wird das Restaurant Hippopotamus dank seiner zarten und schmackhaften Fleischgerichte Ihre Geschmacksknospen wecken."
    ],
    "en": [
      "Within close proximity of Lyon, in the heart of the Caluire 2 shopping centre, the Hippopotamus restaurant is sure to delight your taste buds thanks to its tender and tasty meat."
    ],
    "it": [
      "Vicino a Lione, nel cuore del centro commerciale Caluire 2, il ristorante Hippopotamus risveglierà il vostro palato con le sue carni tenere e gustose."
    ],
    "fr": [
      "A proximité de Lyon, au coeur du centre commercial Caluire 2, le restaurant Hippopotamus saura éveiller vos papilles grâce à ses viandes tendres et savoureuses."
    ],
    "nl": [
      "Vlakbij Lyon, in het hart van het winkelcentrum Caluire 2, zal het restaurant Hippopotamus uw smaakpapillen prikkelen met zijn malse en smakelijke vleeswaren."
    ],
    "es": [
      "Cerca de Lyon, en el corazón del centro comercial Caluire 2, el restaurante Hippopotamus despertará su paladar con sus tiernas y sabrosas carnes."
    ]
  },
