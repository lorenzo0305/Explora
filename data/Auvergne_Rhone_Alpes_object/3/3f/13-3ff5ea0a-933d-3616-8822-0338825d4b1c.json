  "rdfs:comment": {
    "de": [
      "Der Chefkoch aus der Ardèche bietet eine traditionelle französische Küche aus frischen biologischen und lokalen Produkten. Mittags wechselt die Speisekarte alle zwei Tage. Eine Küche, die man in einem sanften Rahmen im schicken Landhausstil genießen kann."
    ],
    "en": [
      "The Ardéchois chef offers traditional French cuisine based on fresh organic and local produce. At lunchtime, the menu changes every other day. A cuisine to be enjoyed in a gentle country chic setting."
    ],
    "it": [
      "Lo chef dell'Ardèche propone una cucina tradizionale francese a base di prodotti freschi, biologici e locali. Il menu cambia settimanalmente. Una cucina da gustare in un ambiente country chic."
    ],
    "fr": [
      "Le chef ardéchois propose une cuisine traditionnelle française composée de produits frais bios et locaux. La carte change toutes les semaines. Une cuisine à apprécier dans un cadre doux au style campagne chic."
    ],
    "es": [
      "El chef de Ardèche ofrece cocina tradicional francesa con productos frescos, ecológicos y locales. El menú cambia cada semana. Una cocina para degustar en un ambiente campestre y elegante."
    ],
    "nl": [
      "De chef van de Ardèche serveert traditionele Franse gerechten met verse biologische en lokale producten. Tijdens de lunch wisselt het menu om de dag. Een keuken om van te genieten in een zacht kader met een chique landelijke stijl."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Rémi"
    ]
  },
