  "rdfs:comment": {
    "de": [
      "Für alle Altersgruppen, alle Niveaus, seit langem: Abenteuer unter der Erde wie auf der Erde!\nHöhlenforschung oder Canyoning wählen Sie!\nVercors Plein Air: zum Besten und zum Lachen!"
    ],
    "en": [
      "For all ages, all levels, for a long time: adventure underground as on earth!\nCaving or canyoning, take your pick!\nVercors Plein Air: for fun and laughter!"
    ],
    "it": [
      "Per tutte le età, per tutti i livelli, per molto tempo: avventura sottoterra come sulla terraferma!\nScegliete la speleologia o il canyoning!\nVercors Plein Air: per il divertimento e l'avventura!"
    ],
    "fr": [
      "Pour tous publics, tous niveaux, depuis longtemps : l'aventure sous terre comme sur terre !\nSpéléo ou canyon choisissez !\nVercors Plein Air : pour le meilleur et pour le rire !"
    ],
    "nl": [
      "Voor alle leeftijden, alle niveaus, voor een lange tijd: avontuur onder de grond als op het land!\nKies voor speleologie of canyoning!\nVercors Plein Air: voor plezier en avontuur!"
    ],
    "es": [
      "Para todas las edades, todos los niveles, durante mucho tiempo: ¡aventura bajo tierra como en tierra!\n¡Elija la espeleología o el barranquismo!\nVercors Plein Air: ¡diversión y aventura!"
    ]
  },
