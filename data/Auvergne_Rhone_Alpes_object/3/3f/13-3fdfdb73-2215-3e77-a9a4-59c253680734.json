  "rdfs:comment": {
    "de": [
      "Sainte-Euphémie-sur-Ouvèze ist ein charmantes kleines Dorf, das man am Ende der Departementstraße 546 entdeckt. Es liegt am rechten Ufer des Flusses Ouvèze."
    ],
    "en": [
      "Sainte-Euphémie-sur-Ouvèze is a charming little village at the bottom of departmental road 546. Located on the right bank of the Ouvèze river."
    ],
    "it": [
      "Sainte-Euphémie-sur-Ouvèze è un incantevole paesino che si trova in fondo alla strada dipartimentale 546. Si trova sulla riva destra dell'Ouvèze."
    ],
    "fr": [
      "Sainte-Euphémie-sur-Ouvèze est un charmant petit village qui se découvre au bas de la départementale 546. Installé sur la rive droite de l’Ouvèze."
    ],
    "nl": [
      "Sainte-Euphémie-sur-Ouvèze is een charmant dorpje vlak bij de D546. Het ligt op de rechteroever van de rivier Ouvèze."
    ],
    "es": [
      "Sainte-Euphémie-sur-Ouvèze es un pequeño y encantador pueblo que se encuentra al final de la carretera departamental 546. Se encuentra en la orilla derecha del Ouvèze."
    ]
  },
