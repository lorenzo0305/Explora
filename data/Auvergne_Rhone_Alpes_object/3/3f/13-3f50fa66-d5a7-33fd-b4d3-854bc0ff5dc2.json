  "rdfs:comment": {
    "de": [
      "Im historischen und fußgängerfreundlichen Zentrum von Thonon ist das Restaurant ideal gelegen und bietet einen einzigartigen Rahmen. A la carte: savoyische Spezialitäten, Bretter, Pizzen, Tapas, Vorschläge der Woche (mittags) Desserts, Weinauswahl, Cocktails."
    ],
    "en": [
      "Ideally located in Thonon's historic pedestrian center, the restaurant offers a unique setting. A la carte: Savoyard specialties, platters, pizzas, tapas, weekly suggestions (midday), desserts, wine selection, cocktails."
    ],
    "it": [
      "Nel centro storico e pedonale di Thonon, il ristorante è situato in posizione ideale e offre un ambiente unico. In menu: specialità savoiarde, taglieri, pizze, tapas, proposte settimanali (mezzogiorno), dessert, selezione di vini, cocktail."
    ],
    "fr": [
      "Dans le centre historique et piéton de Thonon, le restaurant est idéalement placé et offre un cadre unique. A la carte : spécialités savoyardes, planches, pizzas, tapas, suggestions de la semaine (les midis) desserts, sélection de vins, cocktails."
    ],
    "nl": [
      "Het restaurant is ideaal gelegen in het historische en voetgangerscentrum van Thonon en biedt een unieke omgeving. Op het menu: Savoyaardse specialiteiten, schotels, pizza's, tapas, wekelijkse suggesties (middag), desserts, wijnselectie, cocktails."
    ],
    "es": [
      "En el centro histórico y peatonal de Thonon, el restaurante goza de una ubicación ideal y ofrece un entorno único. En la carta: especialidades de Saboya, platos combinados, pizzas, tapas, sugerencias semanales (mediodía), postres, selección de vinos, cócteles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Cochonneries du Général"
    ]
  },
