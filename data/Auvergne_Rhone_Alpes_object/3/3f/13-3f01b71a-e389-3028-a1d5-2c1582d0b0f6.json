  "rdfs:comment": {
    "de": [
      "Die Sektion Marche et Découvertes des Jacquemart bietet freitags Ausflüge an. Treffpunkt ist um 13:15 Uhr am Parkplatz der Île d'Amour. Auto erforderlich, um den Startpunkt zu erreichen (Fahrgemeinschaften)."
    ],
    "en": [
      "The Jacquemart Marche et Découvertes section organizes outings on Fridays, meeting at 1:15pm at the Île d'Amour parking lot. You'll need your own car to get to the starting point (car pooling)."
    ],
    "it": [
      "La sezione Passeggiate e Scoperte di Jacquemart organizza delle uscite il venerdì, con ritrovo alle 13.15 al parcheggio dell'Ile d'Amour. È necessario disporre di un'auto per raggiungere il punto di partenza (car pooling)."
    ],
    "fr": [
      "La section Marche et Découvertes du Jacquemart propose des sorties les vendredis, rendez-vous 13h15 au parking de l'île d'Amour. Voiture nécessaire pour rallier le point de départ (co-voiturage)."
    ],
    "es": [
      "La sección Senderismo y Descubrimiento de Jacquemart organiza salidas los viernes, con cita a las 13.15 h en el aparcamiento de Ile d'Amour. Necesitarás un coche para llegar al punto de partida (coche compartido)."
    ],
    "nl": [
      "De afdeling Wandelen en Ontdekken van Jacquemart organiseert uitstapjes op vrijdag. We verzamelen om 13.15 uur op de parkeerplaats van Ile d'Amour. Je hebt een auto nodig om bij het vertrekpunt te komen (carpoolen)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Section Marche et Découvertes | Jacquemart"
    ]
  },
