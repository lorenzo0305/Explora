  "rdfs:comment": {
    "de": [
      "Das Team der Bar-Restaurant-Pizza empfängt Sie jeden Tag in einer warmen und freundlichen Atmosphäre. Wir bieten Pizzas aus dem Ofen vor Ort oder zum Mitnehmen, Fondues, Tartiflettes, Burger, leckere Tagesgerichte und süße Crêpes."
    ],
    "en": [
      "The restaurant-bar team welcomes you every day in a warm and friendly atmosphere. We offer oven-baked pizzas on the spot or to take away, fondues, tartiflettes, sweet crepes, hamburgers and daily specials."
    ],
    "it": [
      "Il team del bar-ristorante-pizzeria vi accoglie ogni giorno in un'atmosfera calda e accogliente. Offriamo pizze al forno da mangiare o da portare via, fondute, tartiflettes, hamburger, gustose specialità del giorno e crêpes dolci."
    ],
    "fr": [
      "L'équipe du bar-restaurant-pizza vous accueille tous les jours dans une ambiance chaleureuse et conviviale. Nous proposons des pizzas cuites au four sur place ou à emporter, des fondues, tartiflettes, burgers, de savoureux plats du jour , crêpes sucrées."
    ],
    "nl": [
      "Het team van deze bar-restaurant verwelkomt u elke dag in een warme en gezellige sfeer.  Hier kan men genieten van op steenoven gebakken pizzas (ter plaatse of af te halen), fondus, tartiflettes, pannenkoeken en een dagschotel."
    ],
    "es": [
      "El equipo del bar-restaurante-pizzería le da la bienvenida cada día en un ambiente cálido y acogedor. Ofrecemos pizzas al horno para comer en el restaurante o para llevar, fondues, tartiflettes, hamburguesas, sabrosos platos del día y crepes dulces."
    ]
  },
  "rdfs:label": {
    "en": [
