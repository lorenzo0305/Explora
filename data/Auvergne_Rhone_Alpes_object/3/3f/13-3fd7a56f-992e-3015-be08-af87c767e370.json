          "additionalInformation": {
            "de": [
              "Sonntagabend für die Gastronomie außerhalb der Schulferien geschlossen\r\n\r\nFrühstück von 7:30 bis 10:30\r\nVerpflegung 11h-22h\r\n\r\nAußerordentliche Schließung am 24. Dezember abends und am 25. Dezember ganztägig."
            ],
            "en": [
              "Closed on Sunday evenings for catering outside school vacations\r\n\r\nBreakfast from 7:30am to 10:30am\r\nCatering 11am-10pm\r\n\r\nExceptionally closed on December 24 evening and December 25 all day."
            ],
            "it": [
              "Chiuso la domenica sera per la ristorazione al di fuori delle vacanze scolastiche\r\n\r\nColazione dalle 7.30 alle 10.30\r\nRistorazione dalle 11.00 alle 22.00\r\n\r\nEccezionalmente chiuso il 24 dicembre la sera e il 25 dicembre tutto il giorno."
            ],
            "fr": [
              "Fermé les dimanches soir pour la restauration hors vacances scolaires\r\n\r\nPetit déjeuner de 7h30 à 10h30\r\nRestauration 11h-22h\r\n\r\nFermeture exceptionnelle le 24 décembre le soir et le 25 décembre toute la journée."
            ],
            "nl": [
              "Gesloten op zondagavond voor catering buiten de schoolvakanties\r\n\r\nOntbijt van 7.30 tot 10.30 uur\r\nCatering 11.00-10.00\r\n\r\nUitzonderlijk gesloten op 24 december 's avonds en de hele dag op 25 december."
            ],
            "es": [
              "Cerrado los domingos por la noche por restauración fuera de las vacaciones escolares\r\n\r\nDesayuno de 7h30 a 10h30\r\nRestauración de 11.00 a 22.00\r\n\r\nCerrado excepcionalmente el 24 de diciembre por la tarde y todo el día el 25 de diciembre."
            ]
          },
