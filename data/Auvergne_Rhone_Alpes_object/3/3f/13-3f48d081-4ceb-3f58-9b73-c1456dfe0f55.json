  "rdfs:comment": {
    "de": [
      "M'ange & moi ist ein traditionelles Restaurant mit einer \"hausgemachten\", großzügigen und raffinierten Küche. Wir verwenden für jedes Gericht frische Produkte, um ein authentisches kulinarisches Erlebnis zu bieten. Angenehme Terrasse, um die schönen Tage zu genießen."
    ],
    "en": [
      "M'ange & moi is a traditional restaurant offering generous, refined, home-cooked cuisine. We use fresh produce for every dish, to offer an authentic culinary experience. Pleasant terrace to enjoy on sunny days."
    ],
    "it": [
      "M'ange & moi è un ristorante tradizionale che offre una cucina generosa, raffinata e casalinga. Utilizziamo prodotti freschi per ogni piatto, per offrire un'esperienza culinaria autentica. Una piacevole terrazza per godersi le giornate di sole."
    ],
    "fr": [
      "M'ange & moi est un restaurant traditionnel avec une cuisine \"fait maison\", généreuse et raffinée. Nous utilisons des produits frais pour chaque plat, pour offrir une expérience culinaire authentique. Terrasse agréable pour profiter des beaux jours."
    ],
    "nl": [
      "M'ange & moi is een traditioneel restaurant met een royale, verfijnde, huisgemaakte keuken. We gebruiken verse producten voor elk gerecht om een authentieke culinaire ervaring te bieden. Een aangenaam terras om van te genieten op zonnige dagen."
    ],
    "es": [
      "M'ange & moi es un restaurante tradicional que ofrece una cocina casera, generosa y refinada. Utilizamos productos frescos para cada plato, para ofrecer una experiencia culinaria auténtica. Una agradable terraza para disfrutar en los días soleados."
    ]
  },
