  "rdfs:comment": {
    "de": [
      "Das Festkomitee von Chazemais lädt Sie zu einem italienischen Abend ein, der von Musik begleitet wird!\r\n\r\n?? Begrenzte Anzahl an Plätzen\r\n Anmeldungen bis zum 14. März\r\n\r\nEin schöner geselliger Abend mit italienischen Aromen erwartet Sie! ?"
    ],
    "en": [
      "The Comité des fêtes de Chazemais invites you to a musical Italian evening!\r\n\r\n?? Limited places\r\n Registration until March 14\r\n\r\nA convivial evening of Italian flavors awaits you! ?"
    ],
    "it": [
      "Il Comitato del Festival di Chazemais vi invita a una serata italiana con musica dal vivo!\r\n\r\n?? I posti sono limitati\r\n Iscrizioni fino al 14 marzo\r\n\r\nVi aspetta una serata conviviale all'insegna dei sapori italiani!"
    ],
    "fr": [
      "Le comité des fêtes de Chazemais vous invite à une soirée italienne animée en musique !\r\n\r\n⚠️ Places limitées\r\n Inscriptions jusqu’au 14 mars\r\n\r\nUne belle soirée conviviale aux saveurs italiennes vous attend ! ✨"
    ],
    "nl": [
      "Het Festivalcomité van Chazemais nodigt u uit voor een Italiaanse avond met livemuziek!\r\n\r\n?? Plaatsen zijn beperkt\r\n Inschrijving tot 14 maart\r\n\r\nEr staat je een gezellige avond vol Italiaanse smaken te wachten!"
    ],
    "es": [
      "El Comité de Fiestas de Chazemais le invita a una velada italiana con música en directo\r\n\r\n?? Plazas limitadas\r\n Inscripciones hasta el 14 de marzo\r\n\r\nLe espera una agradable velada de sabores italianos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée italienne"
    ]
  },
