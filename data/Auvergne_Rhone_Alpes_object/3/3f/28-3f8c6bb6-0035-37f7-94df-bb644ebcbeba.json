  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/33bce8c9-35c5-3b4c-89f6-2c519f7a7199",
      "dc:description": {
        "de": [
          "Ein Escape Game, das auf einer wahren historischen Begebenheit beruht, die sich im Schloss von Eaucourt ereignet hat.\n\nDas Escape Game, eine neue Art, ein historisches Monument zu besichtigen!\n\nUngewöhnliche Entdeckungen garantiert.\n\nEscape game bis zu 6 Personen."
        ],
        "en": [
          "An escape game based on a real historical event that took place at Château d'Eaucourt.\n\nThe escape game, a new way to visit a historic monument!\n\nUnusual discoveries guaranteed.\n\nEscape game for up to 6 people."
        ],
        "it": [
          "Un gioco di fuga basato su un evento storico reale che ha avuto luogo al Castello di Eaucourt.\n\nIl gioco di fuga, un nuovo modo di visitare un monumento storico!\n\nScoperte insolite garantite.\n\nGioco di fuga per un massimo di 6 persone."
        ],
        "fr": [
          "Un escape game basé sur un fait historique réel qui s'est déroulé au château d'Eaucourt.\n\nL'escape game, une nouvelle façon de visiter un monument historique !\n\nDécouverte insolite garantie.\n\nEscape game jusque 6 personnes."
        ],
        "es": [
          "Un juego de escape basado en un acontecimiento histórico real que tuvo lugar en el Château d'Eaucourt.\n\nEl juego de escape, ¡una nueva forma de visitar un monumento histórico!\n\nDescubrimientos insólitos garantizados.\n\nJuego de escape para un máximo de 6 personas."
        ],
        "nl": [
          "Een ontsnappingsspel gebaseerd op een echte historische gebeurtenis die plaatsvond in het Château d'Eaucourt.\n\nHet ontsnappingsspel, een nieuwe manier om een historisch monument te bezoeken!\n\nOngewone ontdekkingen gegarandeerd.\n\nOntsnappingsspel voor maximaal 6 personen."
        ]
      },
