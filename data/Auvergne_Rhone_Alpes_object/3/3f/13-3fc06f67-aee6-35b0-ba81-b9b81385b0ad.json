  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Spezialitäten: hausgemachte Wurstwaren, Wild der Saison, Geflügelleberparfait mit Heidelbeeren, Desserts mit \"Cristille\", einem lokalen Likör. Wir bieten Ihnen eine hausgemachte Gourmetküche mit lokalen Zutaten."
    ],
    "en": [
      "Come and discover our specialties : homemade sausages, game in season, chicken liver with blueberries, desserts with \"cristille\" local liquor. We offer gourmet and homemade cuisine with local ingredients."
    ],
    "it": [
      "Venite a scoprire le nostre specialità: salumi fatti in casa, selvaggina di stagione, parfait di fegato di pollo con mirtilli, dessert con \"cristille\", liquore locale. Vi offriamo una cucina gourmet fatta in casa con ingredienti locali."
    ],
    "fr": [
      "Venez découvrir nos spécialités  : charcuterie maison, gibier en saison, parfait de foie de volaille aux myrtilles, desserts à la \"cristille\" liqueur locale. Nous vous proposons une cuisine gourmande et faite maison avec des ingrédients locaux."
    ],
    "es": [
      "Venga a descubrir nuestras especialidades: charcutería casera, caza de temporada, parfait de hígado de pollo con arándanos, postres con licor local \"cristille\". Le ofrecemos una cocina gourmet casera con ingredientes locales."
    ],
    "nl": [
      "Kom en ontdek onze specialiteiten: huisgemaakte vleeswaren, wild van het seizoen, parfait van kippenlever met bosbessen, desserts met \"cristille\" lokale likeur. Wij bieden u een huisgemaakte gastronomische keuken met lokale ingrediënten."
    ]
  },
