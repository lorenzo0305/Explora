  "rdfs:comment": {
    "de": [
      "Klettern - Hochtouren - Via Ferrata.\r\nMit Natura Grimpe können Sie sich auf das Abenteuer der Vertikalität einlassen.\r\nKletterkurse an natürlichen Standorten für alle Niveaus. Orte: Dieulefit, Saoû, Crest, Saillans, Buis les Baronnies."
    ],
    "en": [
      "Climbing - Long routes - Via Ferrata.\r\nWith Natura Grimpe, set off on a vertical adventure.\r\nClimbing sessions on natural sites for all levels. Locations: Dieulefit, Saoû, Crest, Saillans, Buis les Baronnies."
    ],
    "it": [
      "Arrampicata - Vie lunghe - Via ferrata.\r\nCon Natura Grimpe, partite per un'avventura verticale.\r\nSessioni di arrampicata su siti naturali per tutti i livelli. Località: Dieulefit, Saoû, Crest, Saillans, Buis les Baronnies."
    ],
    "fr": [
      "Escalade - Grande voie - Via Ferrata. \r\nAvec Natura Grimpe, partez à l’aventure de la verticalité . \r\nSéances d’escalade sur sites naturels pour tous les niveaux. Lieux : Dieulefit, Saoû, Crest,Saillans, Buis les Baronnies."
    ],
    "nl": [
      "Klimmen - Lange routes - Via Ferrata.\r\nVertrek met Natura Grimpe op een verticaal klimavontuur.\r\nKlimsessies op natuurlijke locaties voor alle niveaus. Locaties: Dieulefit, Saoû, Crest, Saillans, Buis les Baronnies."
    ],
    "es": [
      "Escalada - Vías largas - Vía Ferrata.\r\nCon Natura Grimpe, lánzate a la aventura vertical.\r\nSesiones de escalada en parajes naturales para todos los niveles. Lugares: Dieulefit, Saoû, Crest, Saillans, Buis les Baronnies."
    ]
  },
