  "rdfs:comment": {
    "de": [
      "In einer einzigartigen Umgebung in Crolles befindet sich das Restaurant in einem Park, der zu jeder Jahreszeit mit Bäumen bewachsen ist. Von den Terrassen und der Veranda aus haben Sie einen herrlichen Blick auf die Belledonne-Kette oder den Zahn von Crolles."
    ],
    "en": [
      "In a unique setting in Crolles, the restaurant is set in a park planted with trees in all seasons, with a magnificent view of the Belledonne mountain range or the Dent de Crolles, which you can admire from the terraces or the veranda."
    ],
    "it": [
      "In un contesto unico a Crolles, il ristorante è immerso in un parco alberato tutto l'anno, con una magnifica vista sulla catena montuosa della Belledonne e sulla Dent de Crolles, che si può ammirare dalle terrazze o dalla veranda."
    ],
    "fr": [
      "Dans un cadre unique à Crolles, le restaurant se situe dans un parc arboré en toutes saisons, avec une vue magnifique sur la chaîne de Belledonne ou sur la dent de Crolles, que vous pourrez admirer aussi bien des terrasses que de la véranda."
    ],
    "nl": [
      "In een unieke omgeving in Crolles ligt het restaurant in een park dat het hele jaar door beplant is met bomen, met een prachtig uitzicht op de bergketen van de Belledonne en de Dent de Crolles, dat je kunt bewonderen vanaf de terrassen of de veranda."
    ],
    "es": [
      "En un marco único en Crolles, el restaurante está situado en un parque arbolado todo el año, con una magnífica vista de la cordillera Belledonne y del Dent de Crolles, que podrá admirar desde las terrazas o el porche."
    ]
  },
