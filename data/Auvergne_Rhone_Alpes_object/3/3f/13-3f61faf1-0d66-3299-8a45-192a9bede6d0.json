  "rdfs:comment": {
    "de": [
      "Im Rahmen der nationalen Woche der frühen Kindheit findet in der Krippe Françoise Dolto ein Motorikparcours sowie eine Austauschzeit mit dem Psychomotoriker Nicolas Savoyat statt."
    ],
    "en": [
      "As part of the national week for young children, the Crèche Françoise Dolto is hosting a motor skills course and a discussion session with psychomotrician Nicolas Savoyat."
    ],
    "it": [
      "Nell'ambito della settimana nazionale della prima infanzia, la Crèche Françoise Dolto ospita un percorso motorio e una sessione di discussione con il terapista psicomotorio Nicolas Savoyat."
    ],
    "fr": [
      "Dans le cadre de la semaine nationale de la petite enfance, la Crèche Françoise Dolto accueille un parcours motricité ainsi qu'un temps d'échanges avec un psychomotricien, Nicolas Savoyat."
    ],
    "nl": [
      "In het kader van de nationale week van de jonge kinderen organiseert Crèche Françoise Dolto een motoriekparcours en een discussiesessie met psychomotorisch therapeut Nicolas Savoyat."
    ],
    "es": [
      "En el marco de la semana nacional de la primera infancia, la Crèche Françoise Dolto organiza un recorrido motriz y una sesión de debate con el psicomotricista Nicolas Savoyat."
    ]
  },
