  "rdfs:comment": {
    "de": [
      "Kostenlose Aufführung für Kleinkinder, die von Céline Bartassot und Lucie Droy, Lehrerinnen am Konservatorium von Vichy-Communauté, im Rahmen der Nationalen Woche für Kleinkinder realisiert wurde."
    ],
    "en": [
      "Free show for toddlers, produced by Céline Bartassot and Lucie Droy, teachers at the Vichy-Communauté conservatory, as part of the Semaine Nationale de la petite Enfance."
    ],
    "it": [
      "Uno spettacolo gratuito per i più piccoli, realizzato da Céline Bartassot e Lucie Droy, insegnanti del conservatorio di Vichy-Communauté, nell'ambito della Semaine Nationale de la petite Enfance (Settimana nazionale della piccola infanzia)."
    ],
    "fr": [
      "Spectacle gratuit pour les tout-petits, réalisé par Céline Bartassot et Lucie Droy, enseignantes au conservatoire de Vichy-Communauté, dans le cadre de la Semaine Nationale de la petite Enfance."
    ],
    "es": [
      "Espectáculo gratuito para los más pequeños, a cargo de Céline Bartassot y Lucie Droy, profesoras del conservatorio de Vichy-Communauté, en el marco de la Semaine Nationale de la petite Enfance (Semana Nacional de la Pequeña Infancia)."
    ],
    "nl": [
      "Een gratis peutervoorstelling van Céline Bartassot en Lucie Droy, docenten aan het conservatorium van Vichy-Communauté, in het kader van de Semaine Nationale de la petite Enfance (Nationale Week van de Jonge Kinderen)."
