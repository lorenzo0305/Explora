  "rdfs:comment": {
    "de": [
      "Ein Geschäftsessen oder ein Mittagessen mit Freunden? Testen Sie die Küche von Chefkoch Guillaume Dupuy mit einer Auswahl an auf der Plancha zubereitetem Fleisch, Burgern... und entdecken Sie auch den \"Cocotte\" des Augenblicks."
    ],
    "en": [
      "A lunch with colleagues or friends? Come enjoy the menu served up by Chef Guillaume Dupuy with a choice of meats cooked \"à la plancha\", burgers... and also to discover \"la cocotte\" of the moment."
    ],
    "it": [
      "Pranzo di lavoro o pranzo con gli amici? Venite a provare la cucina dello chef Guillaume Dupuy, con una scelta di carni cucinate a la plancha, hamburger... e scoprite anche la \"cocotte\" del momento."
    ],
    "fr": [
      "Un déjeuner d'affaires ou entre amis ? Venez tester la cuisine du Chef Guillaume Dupuy, avec un choix de viandes cuites à la plancha, des burgers... et découvrez également \"la cocotte\" du moment."
    ],
    "es": [
      "¿Almuerzo de negocios o con amigos? Venga a probar la cocina del Chef Guillaume Dupuy, con una selección de carnes cocinadas a la plancha, hamburguesas... y descubra también la \"cocotte\" del momento."
    ],
    "nl": [
      "Zakenlunch of lunch met vrienden? Kom en proef de keuken van chef Guillaume Dupuy, met een keuze aan vlees bereid a la plancha, hamburgers... en ontdek ook de \"cocotte\" van het moment."
    ]
  },
