  "rdfs:comment": {
    "de": [
      "Das Restaurant Au Bon Accueil liegt im Herzen des Marais Audomarois und lädt Sie zu einem authentischen kulinarischen Erlebnis in einer warmen und rustikalen Umgebung ein."
    ],
    "en": [
      "Located in the heart of the Audomarois marshes, Au Bon Accueil invites you to enjoy an authentic culinary experience in a warm, rustic setting."
    ],
    "it": [
      "Situato nel cuore delle paludi di Audomarois, il ristorante Au Bon Accueil vi invita a vivere un'autentica esperienza culinaria in un ambiente caldo e rustico."
    ],
    "fr": [
      "Situé au cœur du marais audomarois, le restaurant Au Bon Accueil vous invite à vivre une expérience culinaire authentique dans un cadre chaleureux et rustique."
    ],
    "es": [
      "Situado en el corazón de las marismas de Audomarois, el restaurante Au Bon Accueil le invita a disfrutar de una auténtica experiencia culinaria en un ambiente cálido y rústico."
    ],
    "nl": [
      "Het restaurant Au Bon Accueil ligt in het hart van de moerassen van Audomarois en nodigt je uit om te genieten van een authentieke culinaire ervaring in een warme, rustieke omgeving."
    ]
  },
