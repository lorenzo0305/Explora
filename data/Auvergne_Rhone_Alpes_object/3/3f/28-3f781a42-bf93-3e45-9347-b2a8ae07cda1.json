  "rdfs:comment": {
    "de": [
      "Ein lokaler Familienbetrieb, der Ziegen- und Kuhkäse aus biologischem Anbau herstellt, etwa 20 km nördlich von Laon. Und unser pädagogischer Bauernhof empfängt Sie kostenlos, ob groß oder klein, also zögern Sie nicht, einen Termin zu vereinbaren & bis bald!"
    ],
    "en": [
      "A local and family farm producing organic goat and cow cheeses, about 20 km north of Laon. And our educational farm will welcome you for free, young and old, so don't hesitate to make an appointment & see you soon!"
    ],
    "it": [
      "Azienda agricola locale a conduzione familiare che produce formaggio biologico di capra e di mucca, a circa 20 km a nord di Laon. E la nostra fattoria didattica vi accoglierà gratuitamente, grandi e piccini, quindi non esitate a fissare un appuntamento e ci vediamo presto!"
    ],
    "fr": [
      "Une ferme locale et familiale de production de fromages de chèvre et de vache bio, à une vingtaine de kilomètres au nord de Laon. Et notre ferme pédagogique vous accueillera gratuitement, petits comme grands, alors n'hésitez pas à prendre rendez-vous & à bientôt !"
    ],
    "es": [
      "Una granja familiar local que produce queso ecológico de cabra y vaca, a unos 20 km al norte de Laon. Y nuestra granja educativa te acogerá gratuitamente, tanto a jóvenes como a mayores, así que no dudes en pedir una cita y ¡hasta pronto!"
    ],
    "nl": [
      "Een lokale familieboerderij die biologische geiten- en koeienkaas produceert, ongeveer 20 km ten noorden van Laon. En onze educatieve boerderij ontvangt u gratis, jong en oud, dus aarzel niet om een afspraak te maken en tot ziens!"
    ]
  },
