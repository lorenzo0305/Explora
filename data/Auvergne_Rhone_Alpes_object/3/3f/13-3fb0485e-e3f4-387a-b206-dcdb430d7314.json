  "rdfs:comment": {
    "de": [
      "Dieses ***Sterne-Chalet-Hotel mit Bergcharme und herzlicher Atmosphäre lässt Sie die Geselligkeit seiner Tafel entdecken."
    ],
    "en": [
      "Located at the foot of the pistes, this chalet hotel *** with its mountain charm and warm ambience will make you discover the conviviality of its table."
    ],
    "it": [
      "Quest'albergo chalet *** stelle con il suo fascino montano e all'atmosfera calorosa, vi farà scoprire la convivialità del suo ristorante."
    ],
    "fr": [
      "Cet hôtel chalet *** étoiles au charme montagnard et à l'atmosphère chaleureuse vous fera découvrir la convivialité de sa table."
    ],
    "es": [
      "Este hotel chalet de 3 estrellas, con su encanto montañés y su ambiente cálido, le hará descubrir la convivencia de su mesa."
    ],
    "nl": [
      "Dit 3-sterren chalethotel met zijn bergcharme en warme sfeer laat u de gezelligheid van zijn tafel ontdekken."
    ]
  },
