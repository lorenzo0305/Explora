  "rdfs:comment": {
    "de": [
      "Le Clos du Régrillon liegt im regionalen Naturpark Pilat im Departement Loire und empfängt Sie für Praktika, Retreats, Schulungen oder Zeiten des Auftankens."
    ],
    "en": [
      "Located in the Pilat Regional Nature Park in the Loire, the Clos du Régrillon welcomes you for courses, retreats, training sessions or times of renewal."
    ],
