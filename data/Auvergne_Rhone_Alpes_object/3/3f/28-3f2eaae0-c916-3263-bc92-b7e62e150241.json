  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cb14eb83-196f-3d36-8f64-b2eb40221754",
      "dc:description": {
        "de": [
          "Restaurant ? Trattoria Angela Lesquin\nIhr italienisches Restaurant in Lesquin\nUnsere Gerichte, die mit Leidenschaft und Know-how zubereitet werden, verkörpern die Essenz der italienischen Tradition und verleihen ihr eine zeitgemäße und einzigartige Note"
        ],
        "en": [
          "Restaurant ? Trattoria Angela Lesquin\nYour Italian restaurant in Lesquin\nOur dishes, prepared with passion and savoir-faire, embody the very essence of Italian tradition, while adding a unique, contemporary touch"
        ],
        "it": [
          "Ristorante ? Trattoria Angela Lesquin\nIl vostro ristorante italiano a Lesquin\nI nostri piatti, preparati con passione e competenza, incarnano l'essenza stessa della tradizione italiana, aggiungendo un tocco contemporaneo e unico"
        ],
        "fr": [
          "Restaurant – Trattoria Angela Lesquin\nVotre restaurant Italien à Lesquin\nNos plats, préparés avec passion et savoir-faire, incarnent l’essence même de la tradition italienne, tout en apportant une touche contemporaine et unique"
        ],
        "es": [
          "Restaurante ? Trattoria Angela Lesquin\nSu restaurante italiano en Lesquin\nNuestros platos, preparados con pasión y maestría, encarnan la esencia misma de la tradición italiana, añadiendo al mismo tiempo un toque contemporáneo y único"
        ],
        "nl": [
          "Restaurant ? Trattoria Angela Lesquin\nUw Italiaanse restaurant in Lesquin\nOnze gerechten, bereid met passie en vakmanschap, belichamen de essentie van de Italiaanse traditie en voegen er een hedendaagse en unieke toets aan toe"
        ]
      },
      "@type": [
        "Description"
      ],
