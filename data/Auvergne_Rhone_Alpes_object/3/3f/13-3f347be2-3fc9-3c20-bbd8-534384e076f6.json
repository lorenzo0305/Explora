  "rdfs:comment": {
    "de": [
      "Genießen Sie die Ruhe der Chautagne und entspannen Sie sich an diesem Familienstrand in unmittelbarer Nähe des Hafens von Conjux. Hier können Sie Tretboote und Kanus mieten."
    ],
    "en": [
      "Beach on the Lac du Bourget. Free access."
    ],
    "it": [
      "Spiaggia in riva al lago del Bourget. Accesso gratuito."
    ],
    "fr": [
      "Profitez du calme de la Chautagne pour vous détendre sur cette plage familiale à proximité immédiate du port de Conjux. Vous pourrez y louer pédalos et canoës."
    ],
    "nl": [
      "Profiteer van de rust van de Chautagne om te ontspannen op dit familiestrand in de onmiddellijke nabijheid van de haven van Conjux. U kunt waterfietsen en kano's huren."
    ],
    "es": [
      "Aproveche la calma de la Chautagne para relajarse en esta playa familiar en las inmediaciones del puerto de Conjux. Se pueden alquilar botes a pedal y canoas."
    ]
  },
