  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Plateau des Petites Roches und das schöne Massiv der Chartreuse auf eine andere Art und Weise!\nPädagogische Ausflüge mit einem Begleiter: Staunen, Emotionen und Überraschungen, die Sie mit anderen teilen können!"
    ],
    "en": [
      "Discover Le Plateau des Petites Roches and the beautiful Chartreuse massif in a whole new way!\nEducational outings with a guide: wonder, excitement and surprises to share!"
    ],
    "it": [
      "Scoprite il Plateau des Petites Roches e il bellissimo massiccio della Chartreuse in un modo completamente nuovo!\nUscite didattiche con guida: meraviglia, emozione e sorprese da condividere!"
    ],
    "fr": [
      "Découvrez différemment le Plateau des Petites Roches et ce beau massif qu'est la Chartreuse !\nSorties pédagogiques avec accompagnateur : émerveillement, émotion et surprises à partager !"
    ],
    "nl": [
      "Ontdek het Plateau des Petites Roches en het prachtige Chartreuse-massief op een geheel nieuwe manier!\nEducatieve uitstapjes met een gids: verwondering, opwinding en verrassingen om te delen!"
    ],
    "es": [
      "Descubra el Plateau des Petites Roches y el hermoso macizo de Chartreuse de una forma totalmente nueva\nSalidas pedagógicas con guía: ¡asombro, emoción y sorpresas para compartir!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Chartreuse educational garden of culinary and medicinal plants"
    ],
    "fr": [
      "Jardin pédagogique des plantes culinaires et médicinales de Chartreuse"
    ],
    "nl": [
      "Chartreuse educatieve tuin van culinaire en medicinale planten"
    ]
  },
