  "rdfs:comment": {
    "de": [
      "La Martinette überspannt den Savasse mithilfe eines kleinen Aquädukts, das an die Brücke angebaut ist, die um 1830 gebaut wurde, als ein neues Flussbett ausgehoben wurde."
    ],
    "en": [
      "La Martinette spans the Savasse thanks to a small aqueduct attached to the bridge built around 1830, when a new river bed was dug."
    ],
    "it": [
      "La Martinette attraversa la Savasse grazie a un piccolo acquedotto collegato al ponte costruito intorno al 1830, quando fu scavato un nuovo letto del fiume."
    ],
    "fr": [
      "La Martinette enjambe la Savasse grâce à un petit aqueduc accolé au pont construit vers 1830, lorsqu’un nouveau lit de la rivière fut creusé."
    ],
    "es": [
      "La Martinette salva el Savasse gracias a un pequeño acueducto adosado al puente construido hacia 1830, cuando se excavó un nuevo cauce."
    ],
    "nl": [
      "La Martinette overspant de Savasse dankzij een klein aquaduct dat aan de brug vastzit en rond 1830 werd gebouwd, toen er een nieuwe rivierbedding werd gegraven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Déversoir de la  Martinette"
    ]
  },
