  "rdfs:comment": {
    "de": [
      "Unser myWo Coworking Space befindet sich im Hotel Chalet les Saytels im Herzen des Dorfes. Er bietet Ihnen einen gemütlichen und einladenden Rahmen, der perfekt ist, um in Ruhe zu arbeiten oder berufliche Treffen zu organisieren."
    ],
    "en": [
      "Located in the Chalet les Saytels hotel, right in the heart of the village, our myWo coworking space offers a cosy, welcoming setting, perfect for working in peace or organizing professional meetings."
    ],
    "it": [
      "Situato nell'hotel Chalet les Saytels, proprio nel cuore del villaggio, il nostro spazio di coworking myWo offre un ambiente accogliente, perfetto per lavorare in tranquillità o organizzare riunioni professionali."
    ],
    "fr": [
      "Situé dans l'hôtel Chalet les Saytels, en plein cœur du village, notre espace de coworking myWo vous offre un cadre cosy et accueillant, parfait pour travailler au calme ou organiser des rencontres professionnelles."
    ],
    "es": [
      "Situado en el hotel Chalet les Saytels, en pleno centro del pueblo, nuestro espacio de coworking myWo ofrece un ambiente acogedor y agradable, perfecto para trabajar con tranquilidad u organizar reuniones profesionales."
    ],
    "nl": [
      "Gelegen in het Chalet les Saytels hotel, in het hart van het dorp, biedt onze myWo coworking ruimte een gezellige, gastvrije omgeving, perfect om in alle rust te werken of professionele bijeenkomsten te organiseren."
    ]
  },
