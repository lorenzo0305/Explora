  "rdfs:comment": {
    "de": [
      "Weiß-, Rot- und Roséweine, traditionelle Methode für Weiß- und Roséweine. Die Weine werden auf natürliche Weise hergestellt, wobei der Einsatz von Hilfsmitteln so weit wie möglich eingeschränkt wird."
    ],
    "en": [
      "White, red and rosé wines, traditional method for white and rosé. The wines are made naturally, with as few inputs as possible."
    ],
    "it": [
      "Vini bianchi, rossi e rosati, metodo tradizionale per i bianchi e i rosati. I vini sono prodotti in modo naturale, con il minor numero possibile di input."
    ],
    "fr": [
      "Vins blancs, rouges et rosés, méthode traditionnelle en blanc et rosé. Les vins sont élaborés naturellement, en limitant le plus possible les intrants."
    ],
    "nl": [
      "Witte, rode wijnen en rosé. Wit en rosé volgens traditionele methode. De wijnen zijn biologisch, zonder toevoeging van middelen."
    ],
    "es": [
      "Vinos blancos, tintos y rosados, método tradicional para el blanco y el rosado. Los vinos se elaboran de forma natural, con el menor número posible de insumos."
    ]
  },
