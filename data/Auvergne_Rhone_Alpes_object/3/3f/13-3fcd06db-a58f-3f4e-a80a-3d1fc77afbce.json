  "rdfs:comment": {
    "de": [
      "Eine Auswahl an Kleidung, Accessoires, Schmuck und Vintage-Objekten steht neben kreativen Kreationen.\r\nSeit kurzem teilt sich super superflu seine Räumlichkeiten mit La Faïencerie (handgefertigtes Geschirr aus Steingut)"
    ],
    "en": [
      "A selection of clothes, accessories, jewelry and vintage objects sit alongside creations.\r\nSuper superflu recently opened its doors to La Faïencerie (handmade earthenware tableware)"
    ],
    "it": [
      "Una selezione di abiti, accessori, gioielli e oggetti vintage si affianca alle creazioni.\r\nSuperflu ha recentemente aperto le porte a La Faïencerie (vasellame in terracotta fatto a mano)"
    ],
    "fr": [
      "Une sélection de vêtements, accessoires, bijoux et objets vintage côtoie créations.\r\nDepuis peu, super superflu partage son local avec La Faïencerie (vaisselle artisanale en faïence)"
    ],
    "es": [
      "Una selección de ropa, accesorios, joyas y objetos vintage conviven con las creaciones.\r\nSuper superflu ha abierto recientemente sus puertas a La Faïencerie (vajilla de barro hecha a mano)"
    ],
    "nl": [
      "Naast creaties vind je er kleding, accessoires, sieraden en vintage objecten.\r\nSuper superflu heeft onlangs zijn deuren geopend voor La Faïencerie (handgemaakt aardewerk servies)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Boutique vintage et art Super Superflu"
    ]
  },
