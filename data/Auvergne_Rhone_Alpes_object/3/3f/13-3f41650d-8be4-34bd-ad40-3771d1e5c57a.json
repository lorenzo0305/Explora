  "rdfs:comment": {
    "de": [
      "Auf diesem großen Rundweg können Sie das gesamte Massiv von Rochefort-en-Valdaine bis La Touche entdecken. Zwischen kleinen Wegen und Singles bietet die Route die Möglichkeit, die mittelalterliche Stätte von Rochefort sowie die mediterranen Wälder zu entdecken."
    ],
    "en": [
      "This long circuit covers the entire massif from Rochefort-en-Valdaine to La Touche. The itinerary takes in the medieval site of Rochefort and the Mediterranean forests."
    ],
    "it": [
      "Questo lungo circuito copre l'intero massiccio da Rochefort-en-Valdaine a La Touche. L'itinerario comprende la città medievale di Rochefort e le foreste mediterranee."
    ],
    "fr": [
      "Ce grand circuit permet de découvrir l'ensemble du massif allant de Rochefort-en-Valdaine jusqu'à La Touche. Entre petits chemins et singles, l'itinéraire permet de découvrir le site médiéval de Rochefort ainsi que les forêts méditerranéennes."
    ],
    "es": [
      "Este largo circuito recorre todo el macizo desde Rochefort-en-Valdaine hasta La Touche. El itinerario incluye la ciudad medieval de Rochefort y los bosques mediterráneos."
    ],
    "nl": [
      "Dit lange circuit beslaat het hele massief van Rochefort-en-Valdaine tot La Touche. De route voert langs de middeleeuwse stad Rochefort en de mediterrane bossen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fonbrenoux et ruisseau des Citelles"
    ]
  },
