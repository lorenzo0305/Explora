  "rdfs:comment": {
    "de": [
      "9 Routen zum freien Klettern, Schwierigkeitsgrad von Anfänger bis 6a.\r\nZugang: Von der Ortschaft Le Monteil aus in Richtung des Klettergebiets Auteroche fahren, Auteroche in Richtung Sauvat durchqueren, dann den ersten Weg rechts abbiegen."
    ],
    "en": [
      "9 routes for free climbing, scale of difficulty from beginner to 6a.\r\nAccess: from the village of Le Monteil, head for the Auteroche climbing site, cross Auteroche towards Sauvat, then take the 1st path on the right."
    ],
    "it": [
      "9 vie di arrampicata libera, scala di difficoltà da principiante a 6a.\r\nAccesso: dal villaggio di Le Monteil, dirigersi verso il sito di arrampicata di Auteroche, attraversare Auteroche in direzione di Sauvat, quindi prendere il primo sentiero a destra."
    ],
    "fr": [
      "9 voies pour la pratique libre de l'escalade, échelle de difficulté de l'initiation à 6a. \r\nAccès : du bourg du Monteil, prendre la direction du site d'escalade d'Auteroche, traverser Auteroche en direction de Sauvat, puis prendre le 1er chemin à droite."
    ],
    "es": [
      "9 vías de escalada libre, escala de dificultad de principiante a 6a.\r\nAcceso: desde el pueblo de Le Monteil, dirigirse hacia el rocódromo de Auteroche, atravesar Auteroche en dirección a Sauvat y tomar el primer camino a la derecha."
    ],
    "nl": [
      "9 routes voor vrij klimmen, moeilijkheidsgraad van beginner tot 6a.\r\nBereikbaarheid: vanaf het dorp Le Monteil richting klimgebied Auteroche, Auteroche oversteken richting Sauvat, dan het 1e pad rechts nemen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Auteroche climbing area"
    ],
    "fr": [
      "Site d'escalade d'Auteroche"
    ]
  },
