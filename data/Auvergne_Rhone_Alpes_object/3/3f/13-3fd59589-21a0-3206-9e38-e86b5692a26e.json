  "rdfs:comment": {
    "de": [
      "La Ponatière, Scène conventionnée d'intérêt national Art et Création - Danse et Musiques, gehört zu den Scènes régionales Rhône-Alpes. Sie bietet eine große Auswahl an Live-Aufführungen, insbesondere für das junge Publikum ab 3 Jahren."
    ],
    "en": [
      "The Ponatière, a stage dedicated to dance and music, is part of the Regional Scenes of Rhône-Alpes. It offert a large choice of living shows, especially for young people from 3 years old. Circus, dance, music and theatre are to be seen"
    ],
    "it": [
      "La Ponatière, Scène conventionnée d'intérêt national Art et Création - Danse et Musiques, fa parte delle Scene regionali del Rodano-Alpi. Offre un'ampia gamma di spettacoli dal vivo, in particolare per il pubblico giovane a partire dai 3 anni."
    ],
    "fr": [
      "La Ponatière, Scène conventionnée d'intérêt national Art et Création - Danse et Musiques, fait partie des Scènes régionales Rhône-Alpes. Elle offre un large choix de spectacles vivants notamment pour le jeune public à partir de 3 ans."
    ],
    "es": [
      "La Ponatière, una Escène conventionnée d'intérêt national Art et Création - Danse et Musiques, es una de las Escènes régionales Rhône-Alpes. Ofrece una amplia gama de espectáculos en directo, especialmente para el público joven a partir de 3 años."
    ],
    "nl": [
      "La Ponatière, Scène conventionnée d'intérêt national Art et Création - Danse et Musiques, maakt deel uit van de Regionale Scènes Rhône-Alpes. Het biedt een breed scala aan live optredens, met name voor een jong publiek vanaf 3 jaar."
    ]
  },
