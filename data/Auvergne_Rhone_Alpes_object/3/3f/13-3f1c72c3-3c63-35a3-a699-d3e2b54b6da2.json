  "rdfs:comment": {
    "de": [
      "Lernen Sie die Arbeit des Vereins kennen, der das alte Dorf restauriert und schützt, und begleiten Sie eines seiner Mitglieder.\r\nMitzubringen sind: geschlossene Schuhe, Kopfbedeckung, Wasserflasche."
    ],
    "en": [
      "Come and discover the work of the association, which restores and preserves the old village, in the company of one of its members.\r\nBring closed shoes, headgear and a bottle of water."
    ],
    "it": [
      "Venite a scoprire il lavoro dell'associazione, che restaura e conserva l'antico borgo, in compagnia di uno dei suoi membri.\r\nPortare scarpe chiuse, copricapo e una bottiglia d'acqua."
    ],
    "fr": [
      "Venez découvrir le travail de l’association qui restaure et sauvegarde le vieux village, en compagnie de l’un de ses membres.\r\nPrévoir chaussures fermées, couvre-chef, bouteille eau."
    ],
    "es": [
      "Venga a descubrir el trabajo de la asociación, que restaura y conserva el antiguo pueblo, en compañía de uno de sus miembros.\r\nTraiga calzado cerrado, tocado y una botella de agua."
    ],
    "nl": [
      "Kom en ontdek het werk van de vereniging, die het oude dorp restaureert en bewaart, in gezelschap van een van de leden.\r\nNeem dichte schoenen, een hoofddeksel en een fles water mee."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite guidée du vieux village de Sahune"
    ]
  },
