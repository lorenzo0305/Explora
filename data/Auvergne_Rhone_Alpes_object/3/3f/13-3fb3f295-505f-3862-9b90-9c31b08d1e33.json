  "rdfs:comment": {
    "de": [
      "Dieser Rundweg beginnt in Abondance. Sie steigen den Col du Corbier hinauf und fahren dann auf der Seite des Tals von Abondance wieder hinunter. Eine Route, die Ihnen abwechslungsreiche und herrliche Panoramen bietet."
    ],
    "en": [
      "Starting in Abondance, this loop takes you up to the Col du Corbier and back down to the Abondance valley. An itinerary that will take you through a variety of splendid panoramas."
    ],
    "it": [
      "Partendo da Abondance, questo anello vi porterà fino al Col du Corbier per poi ridiscendere nella Vallée d'Abondance. È un itinerario che vi condurrà attraverso una serie di splendidi panorami."
    ],
    "fr": [
      "Boucle au départ d'Abondance, vous réaliserez l'ascension du Col du Corbier pour redescendre du côté de la vallée d'Abondance. Un itinéraire qui vous fera découvrir des panoramas diversifiés et splendides."
    ],
    "nl": [
      "Deze lus begint in Abondance en brengt je naar de Col du Corbier en weer terug naar de Vallée d'Abondance. Het is een route die je langs verschillende prachtige panorama's voert."
    ],
    "es": [
      "Comenzando en Abondance, este bucle le llevará hasta el Col du Corbier y de vuelta al Vallée d'Abondance. Es un itinerario que le llevará a través de una variedad de espléndidos panoramas."
    ]
  },
  "rdfs:label": {
    "en": [
      "Electric mountain bike course 39 - Abondance"
    ],
    "fr": [
      "VTT électrique parcours 39 - Abondance"
    ],
    "nl": [
      "Elektrische mountainbikeparcours 39 - Abondance"
    ]
  },
