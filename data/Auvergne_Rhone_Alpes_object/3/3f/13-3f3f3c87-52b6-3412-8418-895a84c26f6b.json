  "rdfs:comment": {
    "de": [
      "Die ganze Ardèche auf einem Tablett serviert! Lassen Sie sich vom Reichtum der Ardèche verzaubern. Hier finden Sie authentische, leckere und hausgemachte Gerichte im Rhythmus der Jahreszeiten."
    ],
    "en": [
      "The Ardèche served up on a platter! Marvel at the richness of the Ardèche terroir. Enjoy authentic, gourmet, homemade dishes that reflect the rhythm of the seasons."
    ],
    "it": [
      "Tutta l'Ardèche servita su un piatto d'argento! Ammirate la ricchezza del terroir dell'Ardèche. Gustate piatti autentici, gustosi e fatti in casa che rispecchiano le stagioni."
    ],
    "fr": [
      "Toute l’Ardèche servie sur un plateau ! Émerveillez-vous avec toute la richesse du terroir ardéchois. Retrouvez des assiettes authentiques, gourmandes et faites maison au rythme des saisons."
    ],
    "es": [
      "¡Todo el Ardèche servido en bandeja! Maravíllese con la riqueza del terruño de Ardèche. Disfrute de platos auténticos, sabrosos y caseros que reflejan las estaciones."
    ],
    "nl": [
      "De hele Ardèche op een presenteerblaadje! Bewonder de rijkdom van het terroir van de Ardèche. Geniet van authentieke, smakelijke, huisgemaakte gerechten die de seizoenen weerspiegelen."
    ]
  },
