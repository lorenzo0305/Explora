  "rdfs:comment": {
    "de": [
      "PICI PASTA ist ein kleines italienisches Restaurant, das großen Wert auf hausgemachte Produkte legt.\r\nUnsere Pasta, unsere Pizzen, unsere Desserts, unsere Pestos, unsere Saucen - alles wird vor Ort zubereitet und gekocht. Wir verwenden keine Konservierungsstoffe."
    ],
    "en": [
      "PICI PASTA is a small Italian restaurant that puts the emphasis on HOME-MADE.\r\nOur pasta, pizzas, desserts, pestos and sauces are all prepared and cooked on site. We use no preservatives."
    ],
    "it": [
      "PICI PASTA è un piccolo ristorante italiano che pone l'accento sul fatto in casa.\r\nLa nostra pasta, le pizze, i dolci, i pesti e le salse sono tutti preparati e cucinati sul posto. Non usiamo conservanti."
    ],
    "fr": [
      "PICI PASTA un petit restaurant italien qui fait une grande place au FAIT MAISON.\r\nNos pâtes, nos pizzas, nos desserts, nos pestos, nos sauces…tout est élaboré et cuisiné sur place. Nous n’utilisons pas de conservateurs."
    ],
    "nl": [
      "PICI PASTA is een klein Italiaans restaurant dat de nadruk legt op huisgemaakte producten.\r\nOnze pasta's, pizza's, desserts, pesto's en sauzen worden allemaal ter plekke bereid en gekookt. We gebruiken geen conserveringsmiddelen."
    ],
    "es": [
      "PICI PASTA es un pequeño restaurante italiano que pone el énfasis en lo HECHO EN CASA.\r\nNuestra pasta, pizzas, postres, pestos y salsas son todos preparados y cocinados en el lugar. No usamos conservantes."
    ]
  },
