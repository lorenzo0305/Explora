  "rdfs:comment": {
    "de": [
      "In einem Garten im Herzen von Lyon können Sie im Malting Pot vor Ort gebraute handwerklich hergestellte Biere zu einer ständig wechselnden Auswahl an Gerichten aus aller Welt entdecken."
    ],
    "en": [
      "In a garden in the heart of Lyon, the Malting Pot makes you discover homemade beers brewed on the spot around a constantly renewed selection of dishes from around the world."
    ],
    "it": [
      "In un giardino nel cuore di Lione, il Malting Pot vi invita a scoprire le birre artigianali prodotte in loco, insieme a una selezione sempre diversa di piatti del mondo."
    ],
    "fr": [
      "Dans un jardin au cœur de Lyon, le Malting Pot vous fait découvrir des bières artisanales brassées sur place autour d'une sélection de plats du monde constamment renouvelée."
    ],
    "nl": [
      "In een tuin in het hart van Lyon nodigt de Malting Pot u uit om ambachtelijke bieren te ontdekken die ter plaatse worden gebrouwen, samen met een steeds wisselende selectie wereldgerechten."
    ],
    "es": [
      "En un jardín en el corazón de Lyon, el Malting Pot le invita a descubrir las cervezas artesanales elaboradas en el local, junto con una selección de platos del mundo que cambia constantemente."
    ]
  },
  "rdfs:label": {
