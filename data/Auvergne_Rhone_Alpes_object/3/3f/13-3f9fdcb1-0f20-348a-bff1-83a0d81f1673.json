  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Tiere des Waldes. Auf diesem Weg, der ideal für eine Familienaktivität zu Fuß oder mit Schneeschuhen ist, sind lebensgroße Tiernachbildungen aus Kunstharz mit erklärenden Schildern zu sehen."
    ],
    "en": [
      "Come and discover the animals of the forest. This trail, ideal for a family activity on foot or on snowshoes, is lined with life-size resin reproductions of animals, accompanied by explanatory panels."
    ],
    "it": [
      "Venite a scoprire gli animali della foresta. Questo percorso, ideale per un'attività familiare a piedi o con le racchette da neve, è costellato di riproduzioni in resina a grandezza naturale di animali, accompagnate da pannelli esplicativi."
    ],
    "fr": [
      "Venez découvrir les animaux de la forêt. Ce parcours, idéal pour une activité familiale, à pied ou en raquettes à neige, est jalonnée de reproductions d'animaux de taille réelle en résine, accompagnées de panneaux explicatifs."
    ],
    "es": [
      "Venga a descubrir los animales del bosque. Este sendero, ideal para una actividad familiar a pie o con raquetas de nieve, está salpicado de reproducciones de animales en resina a tamaño natural, acompañadas de paneles explicativos."
    ],
    "nl": [
      "Kom en ontdek de dieren van het bos. Dit pad, ideaal voor een gezinsactiviteit te voet of op sneeuwschoenen, is bezaaid met levensgrote reproducties van dieren in hars, vergezeld van verklarende panelen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade - La piste des animaux"
    ]
  },
