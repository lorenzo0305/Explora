  "rdfs:comment": {
    "de": [
      "Diese Bar ist eine Institution in Grenoble für Musikliebhaber und Underground-Orte. Sie veranstaltet regelmäßig große Abende mit einem anspruchsvollen auditiven Programm mit dem George V."
    ],
    "en": [
      "The Grenoble-based institution for music lovers and underground venues, this bar regularly organises big parties with a sharp auditory program with the George V."
    ],
    "it": [
      "Istituzione di Grenoble per gli amanti della musica e dei locali underground, questo bar organizza regolarmente grandi feste con un programma audio all'avanguardia con il George V."
    ],
    "fr": [
      "L’institution grenobloise des amateurs de musique et des lieux undergrounds, ce bar organise régulièrement de grandes soirées à la programmation auditive pointue avec le George V."
    ],
    "es": [
      "Institución de Grenoble para los melómanos y los locales underground, este bar organiza regularmente grandes fiestas con un programa de audio de vanguardia con el George V."
    ],
    "nl": [
      "De Grenoble instelling voor muziekliefhebbers en underground podia, deze bar organiseert regelmatig grote feesten met een cutting-edge audio programma met de George V."
    ]
