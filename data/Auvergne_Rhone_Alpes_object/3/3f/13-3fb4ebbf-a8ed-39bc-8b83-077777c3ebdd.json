  "rdfs:comment": {
    "de": [
      "Willkommen im Roots Café!\r\n In Chambéry, nur wenige Schritte vom Parc du Verney entfernt, empfängt Sie unser 100% pflanzliches Café jeden Tag in einer freundlichen und leckeren Atmosphäre. Brunch von 10:00 bis 14:30 Uhr.Mittagessen von 12:00 bis 14:00 Uhr."
    ],
    "en": [
      "Welcome to Roots Café!\r\n Located in Chambéry, just a stone's throw from the Parc du Verney, our 100% plant-based café welcomes you every day in a friendly, gourmet atmosphere. Brunch from 10 a.m. to 2.30 p.m. Lunch from 12 p.m. to 2 p.m."
    ],
    "it": [
      "Benvenuti al Roots Café!\r\n Situato a Chambéry, a due passi dal Parc du Verney, il nostro caffè 100% vegetale vi accoglie ogni giorno in un'atmosfera amichevole e gourmet. Brunch dalle 10.00 alle 14.30. Pranzo dalle 12.00 alle 14.00."
    ],
    "fr": [
      "Bienvenue au Roots Café ! \r\n Situé à Chambéry, à deux pas du parc du Verney, notre café 100% végétal vous accueille chaque jour dans une ambiance conviviale et gourmande. Brunch de 10h à 14h30.Déjeuner de 12h à 14h."
    ],
    "es": [
      "¡Bienvenido a Roots Café!\r\n Situado en Chambéry, a dos pasos del Parc du Verney, nuestro café 100% vegetal le da la bienvenida todos los días en un ambiente agradable y gastronómico. Brunch de 10.00 a 14.30 h. Almuerzo de 12.00 a 14.00 h."
    ],
    "nl": [
      "Welkom bij Roots Café!\r\n Gelegen in Chambéry, op een boogscheut van het Parc du Verney, verwelkomt ons 100% plantaardig café je elke dag in een gezellige, gastronomische sfeer. Brunch van 10u tot 14u30. Lunch van 12u tot 14u."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Roots Café"
    ]
  },
