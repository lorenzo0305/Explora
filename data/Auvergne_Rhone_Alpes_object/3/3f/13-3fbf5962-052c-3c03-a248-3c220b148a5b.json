  "rdfs:comment": {
    "de": [
      "Le Pot'y Néron Traiteur bietet Ihnen traditionelle Küche, die von Chefkoch David und seinem Team zubereitet wird.  Fertiggerichte mit Fleisch oder Fisch, Beilagen, gemischte Salate, Desserts , sowie vakuumverpackte Schalen."
    ],
    "en": [
      "Le Pot'y Néron Traiteur offers traditional cuisine prepared by Chef David and his team.  Meat and fish dishes, side dishes, mixed salads, desserts and vacuum-packed trays."
    ],
    "it": [
      "Le Pot'y Néron Traiteur offre una cucina tradizionale preparata dallo chef David e dal suo team.  Piatti di carne e pesce, contorni, insalate miste, dessert e vassoi sottovuoto."
    ],
    "fr": [
      "Le Pot'y Néron Traiteur vous propose de la cuisine traditionnelle faite par le Chef David et son équipe.  Plats cuisinés à base de viande ou de poisson, garnitures,  salades composées, desserts , ainsi que des barquettes sous vide."
    ],
    "es": [
      "Le Pot'y Néron Traiteur ofrece cocina tradicional elaborada por el Chef David y su equipo.  Platos de carne y pescado, guarniciones, ensaladas mixtas, postres y bandejas envasadas al vacío."
    ],
    "nl": [
      "Le Pot'y Néron Traiteur biedt traditionele gerechten bereid door chef David en zijn team.  Vlees- en visgerechten, bijgerechten, gemengde salades, desserts en vacuümverpakte schalen."
    ]
  },
