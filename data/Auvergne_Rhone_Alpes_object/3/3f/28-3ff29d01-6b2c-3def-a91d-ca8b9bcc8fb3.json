      "rdfs:comment": {
        "de": [
          "Im Herzen von Le Crotoy bietet Ihnen die Käserei eine feine Auswahl an regionalen Käsesorten und Käse aus Regionen, die für ihre Spezialitäten bekannt sind."
        ],
        "en": [
          "In the heart of Le Crotoy, the cheese dairy offers a fine selection of regional cheeses and cheeses from regions known for their specialities."
        ],
        "it": [
          "Nel cuore di Le Crotoy, il caseificio offre una raffinata selezione di formaggi regionali e provenienti da regioni note per le loro specialità."
        ],
        "fr": [
          "Au coeur du Crotoy, la fromagerie vous propose une fine sélection de fromages régionaux et de fromages provenant de régions connues pour leurs spécialités."
        ],
        "nl": [
          "In het hart van Le Crotoy biedt de kaasmakerij een fijne selectie regionale kazen en kazen uit regio's die bekend staan om hun specialiteiten."
        ],
        "es": [
          "En el corazón de Le Crotoy, la quesería ofrece una fina selección de quesos regionales y de regiones conocidas por sus especialidades."
        ]
      },
