  "rdfs:comment": {
    "de": [
      "Die gemeindeübergreifende Bibliothek Maurice Burrus ist für alle offen. Als Partner der Mediathek bietet sie Mitgliedern und Besuchern eine große Auswahl an Büchern und Zeitschriften für Groß und Klein."
    ],
    "en": [
      "The Maurice Burrus inter-community library is open to all. A partner of the Médiathèque, it offers members and visitors a wide choice of books and magazines for young and old."
    ],
    "it": [
      "La biblioteca intercomunale Maurice Burrus è aperta a tutti. In quanto partner della Médiathèque, offre ai soci e ai visitatori un'ampia scelta di libri e riviste per grandi e piccini."
    ],
    "fr": [
      "La bibliothèque intercommunale Maurice Burrus est ouverte à tous. Partenaire de la Médiathèque, elle offre aux adhérents et aux visiteurs de passage un grand choix de livres et de magazines pour petits et grands."
    ],
    "es": [
      "La biblioteca intermunicipal Maurice Burrus está abierta a todos. Como colaboradora de la Médiathèque, ofrece a socios y visitantes una amplia selección de libros y revistas para grandes y pequeños."
    ],
    "nl": [
      "De Maurice Burrus intercommunale bibliotheek is voor iedereen toegankelijk. Als partner van de Médiathèque biedt ze leden en bezoekers een ruime keuze aan boeken en tijdschriften voor jong en oud."
    ]
  },
