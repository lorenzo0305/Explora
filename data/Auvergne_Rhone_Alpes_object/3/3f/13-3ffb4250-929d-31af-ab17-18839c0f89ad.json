  "rdfs:comment": {
    "de": [
      "Die Stadtverwaltung von Plateau d'Hauteville stellt Spender für Hunde und ihre Besitzer zur Verfügung, um die Stadt sauberer zu halten."
    ],
    "en": [
      "The Plateau d'Hauteville town council is providing cani-bag dispensers for dogs and their owners to help keep the town cleaner."
    ],
    "it": [
      "Il Comune di Plateau d'Hauteville mette a disposizione dei cani e dei loro padroni dei dispenser di cani-bag per contribuire a mantenere la città più pulita."
    ],
    "fr": [
      "La mairie de Plateau d'Hauteville met à disposition des distributeurs de cani-sacs pour les chiens et leurs maitres pour une ville plus propre."
    ],
    "nl": [
      "Het gemeentebestuur van Plateau d'Hauteville stelt zakjes met cani voor honden en hun baasjes ter beschikking om de stad schoner te houden."
    ],
    "es": [
      "El ayuntamiento de Plateau d'Hauteville pone a disposición de los perros y sus dueños dispensadores de bolsas caninas para ayudar a mantener la ciudad más limpia."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Distributeur de cani-sacs"
