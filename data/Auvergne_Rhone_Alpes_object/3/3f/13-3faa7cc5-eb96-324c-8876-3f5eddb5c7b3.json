  "rdfs:comment": {
    "de": [
      "Besuchen Sie unser Restaurant, in dem wir Ihnen französische und marokkanische Küche anbieten. Das Restaurant befindet sich zwischen Valence und Montélimar, gegenüber der ViaRhôna und 3 km von der Autobahn entfernt (Ausfahrt Loriol)."
    ],
    "en": [
      "Come and visit our restaurant, where we offer French and Moroccan cuisine. The restaurant is located between Valence and Montélimar, opposite the ViaRhôna and 3 km from the freeway (Loriol exit)."
    ],
    "it": [
      "Venite a visitare il nostro ristorante, dove serviamo cucina francese e marocchina. Il ristorante si trova tra Valence e Montélimar, di fronte alla ViaRhôna e a 3 km dall'autostrada (uscita Loriol)."
    ],
    "fr": [
      "Rendez-vous dans notre restaurant où nous vous proposons une cuisine française et marocaine. Le restaurant est situé entre Valence et Montélimar, en face de la ViaRhôna et à 3 km de l'autoroute (sortie Loriol)."
    ],
    "es": [
      "Venga a visitar nuestro restaurante, donde servimos cocina francesa y marroquí. El restaurante está situado entre Valence y Montélimar, frente a la ViaRhôna y a 3 km de la autopista (salida Loriol)."
    ],
    "nl": [
      "Kom langs in ons restaurant, waar we Franse en Marokkaanse gerechten serveren. Het restaurant ligt tussen Valence en Montélimar, tegenover de ViaRhôna en op 3 km van de snelweg (afslag Loriol)."
    ]
  },
