  "rdfs:comment": {
    "de": [
      "Alle Arten des Angelns (Angeln, Raubfischangeln, Karpfenangeln...). Handipêche-Bereich, für eine Praxis für alle. Jährliches Angeln oder Tagesangeln vom 31. Mai bis 31. August 2021."
    ],
    "en": [
      "All types of fishing (hitting, predators, carp...). Adapted for wheelchairs. Dedicated annual or daily permit necessary. Get settled and wait for the guard to come for payment."
    ],
    "it": [
      "Tutti i tipi di pesca (pallini, carnivori, carpe...). Area di pesca a mano, per una pratica per tutti. Pesca annuale o giornaliera dal 31 maggio al 31 agosto 2021."
    ],
    "fr": [
      "Tous les types de pêches (coup, carnassiers, carpes...). Espace Handipêche, pour une pratique pour tous. Pêche annuelle ou en journée du 31 Mai au 31 Août 2021."
    ],
    "es": [
      "Todo tipo de pesca (tiro, carnívora, carpa...). Zona de pesca a mano, para una práctica para todos. Pesca anual o diurna del 31 de mayo al 31 de agosto de 2021."
    ],
    "nl": [
      "Alle vormen van visserij (slaan, roofdieren, karpers....). Espace Handipêche, voor een praktijk voor iedereen. Jaarlijkse visserij of dagvisserij van juni tot september."
    ]
  },
  "rdfs:label": {
