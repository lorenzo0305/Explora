  "rdfs:comment": {
    "de": [
      "Ein Coworking-Bereich, in der Maison du Patrimoine et de l'Environnement in Chamrousse 1650 - Recoin.\r\nCoworking in Chamrousse verbindet Arbeit und Natur in einer außergewöhnlichen Umgebung im Herzen der Berge. Ideal, um Produktivität und Freizeit an der frischen Luft miteinander zu verbinden."
    ],
    "en": [
      "A coworking space at the Heritage and Environment centre in Chamrousse 1650 - Recoin.\r\nCoworking in Chamrousse combines work and nature in an exceptional setting in the heart of the mountains. Ideal for combining productivity and outdoor leisure."
    ],
    "it": [
      "Uno spazio di coworking presso la Maison du Patrimoine et de l'Environnement di Chamrousse 1650 - Recoin.\r\nIl coworking di Chamrousse unisce lavoro e natura in un ambiente eccezionale nel cuore delle montagne. Ideale per combinare produttività e tempo libero all'aria aperta."
    ],
    "fr": [
      "Un espace de coworking, à la Maison du Patrimoine et de l’Environnement à Chamrousse 1650 - Recoin.\r\nLe coworking à Chamrousse allie travail et nature dans un cadre exceptionnel au cœur des montagnes. Idéal pour mêler productivité et loisir en plein air."
    ],
    "es": [
      "Un espacio de coworking en la Maison du Patrimoine et de l'Environnement de Chamrousse 1650 - Recoin.\r\nEl coworking en Chamrousse combina trabajo y naturaleza en un marco excepcional en plena montaña. Ideal para combinar productividad y ocio al aire libre."
    ],
    "nl": [
      "Een coworkingruimte in het Maison du Patrimoine et de l'Environnement in Chamrousse 1650 - Recoin.\r\nCoworking in Chamrousse combineert werk en natuur in een uitzonderlijke omgeving in het hart van de bergen. Ideaal om productiviteit en vrije tijd in de buitenlucht te combineren."
    ]
  },
