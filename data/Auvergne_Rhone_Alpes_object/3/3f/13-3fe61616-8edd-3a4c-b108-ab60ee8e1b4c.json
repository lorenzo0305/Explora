  "rdfs:comment": {
    "de": [
      "Route für Fortgeschrittene, die an den Abenden geöffnet ist, an denen die Skilifte nachts von Le Grand-Bornand Chinaillon aus fahren. Erleben Sie das nächtliche Skitourengehen auf einer markierten Route. Ein neues \"Afterwork\"-Konzept in Le Grand Bornand."
    ],
    "en": [
      "Itinerary for advanced skiers open on the evenings of the night lifts from Le Grand-Bornand Chinaillon. Experience night skiing on a marked itinerary. A new \"afterwork\" concept in Grand Bornand."
    ],
    "it": [
      "Itinerario di livello confermato aperto nelle serate di risalita notturna da Grand-Bornand Chinaillon. Provate lo sci notturno su un itinerario segnalato. Un nuovo concetto di \"dopolavoro\" a Grand Bornand."
    ],
    "fr": [
      "Itinéraire niveau confirmé ouvert les soirs de nocturne des remontées mécaniques au départ du Grand-Bornand Chinaillon. Vivez l'expérience du ski de randonnée de nuit sur un itinéraire balisé. Un concept « afterwork » nouveau au Grand Bornand."
    ],
    "es": [
      "Itinerario de nivel confirmado abierto en las tardes de los remontes nocturnos de Grand-Bornand Chinaillon. Experimente el esquí nocturno en un itinerario marcado. Un nuevo concepto de \"afterwork\" en Grand Bornand."
    ],
    "nl": [
      "Bevestigd niveau route open op de avonden van de nachtliften van Grand-Bornand Chinaillon. Beleef het nachtskiën op een gemarkeerde route. Een nieuw \"afterwork\" concept in Grand Bornand."
    ]
  },
  "rdfs:label": {
    "de": [
      "Skitourenroute Outalays bei Nacht"
    ],
    "en": [
      "Ski touring route Outalays by night"
    ],
    "fr": [
      "Itinéraire ski de randonnée nocturne des Outalays"
    ]
  },
