  "rdfs:comment": {
    "de": [
      "Schmackhafte, familienfreundliche Gerichte aus alten Zeiten, die aus lokalen und marktfrischen Produkten bestehen und jeden Tag neu zubereitet werden.\r\nHerzliche Atmosphäre."
    ],
    "en": [
      "Tasty old-fashioned family dishes made with local and fresh market products, renewed every day.\r\nWarm atmosphere."
    ],
    "it": [
      "Piatti gustosi e familiari preparati con prodotti freschi del mercato locale, che vengono cambiati ogni giorno.\r\nAtmosfera calda."
    ],
    "fr": [
      "Plats d'antan savoureux et familiaux composés de produits locaux et frais du marché, renouvelés tous les jours.\r\nAmbiance chaleureuse."
    ],
    "nl": [
      "Smakelijke, familiaire gerechten gemaakt met lokale, verse marktproducten, dagelijks veranderd.\r\nWarme sfeer."
    ],
    "es": [
      "Sabrosos platos de estilo familiar elaborados con productos locales y frescos del mercado, que se cambian a diario.\r\nAmbiente cálido."
    ]
  },
