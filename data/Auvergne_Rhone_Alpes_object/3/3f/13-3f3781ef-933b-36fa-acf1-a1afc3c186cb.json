  "rdfs:comment": {
    "de": [
      "Das Atelier Framboise restauriert und verkleidet Sitzmöbel, Vorhänge oder Wände mit Textilien. Es vereint Technik, Liebe zum Detail und Sinn für Harmonie, um Innenräume zu verschönern. Er verwendet auch Aerogummierung für ein sanftes, präzises und sorgfältiges Abbeizen von Holz."
    ],
    "en": [
      "Atelier Framboise restores and dresses seats, curtains and walls with textiles. It combines technique, attention to detail and a sense of harmony to enhance interiors. It also uses air-scrubbing for gentle, precise and meticulous stripping of wood."
    ],
    "it": [
      "L'Atelier Framboise restaura e veste sedute, tende e pareti utilizzando i tessuti. Unisce tecnica, gusto per il dettaglio e senso dell'armonia per valorizzare gli interni. Utilizza anche l'air-scrubbing per una sverniciatura delicata, precisa e meticolosa del legno."
    ],
    "fr": [
      "L'Atelier Framboise restaure et habille sièges, rideaux ou murs à l'aide de textiles. Il allie technique, goût du détail et sens de l'harmonie pour sublimer les intérieurs. Il utilise aussi l’aérogommage pour un décapage doux, précis, et soigné des bois."
    ],
    "nl": [
      "Atelier Framboise restaureert en kleedt stoelen, gordijnen en muren met textiel. Het combineert techniek, oog voor detail en gevoel voor harmonie om interieurs te verfraaien. Het maakt ook gebruik van luchtschrobben voor het voorzichtig, precies en nauwkeurig strippen van hout."
    ],
    "es": [
      "Atelier Framboise restaura y viste con textiles asientos, cortinas y paredes. Combina técnica, gusto por el detalle y sentido de la armonía para realzar los interiores. También utiliza la aerografía para un decapado suave, preciso y meticuloso de la madera."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Framboise - Tapissier décorateur"
    ]
  },
