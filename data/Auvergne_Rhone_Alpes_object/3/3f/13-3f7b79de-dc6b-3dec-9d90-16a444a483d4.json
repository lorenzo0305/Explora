  "rdfs:comment": {
    "de": [
      "Besichtigung der Destillationswerkstatt und des Alterungskellers mit dem Destillateur-Enologen. Kennenlernen der MEZENK-Spirituosen und ihrer typischen Eigenschaften. Kommentierte Verkostung."
    ],
    "en": [
      "Visit the distillation workshop and ageing cellar with the distilling engineer. Discover the MEZENK range of spirits and their distinctive characteristics. Guided tasting."
    ],
    "it": [
      "Visitate il laboratorio di distillazione e la cantina di invecchiamento con l'ingegnere distillatore. Scoprite la gamma di distillati MEZENK e le loro caratteristiche distintive. Degustazione guidata."
    ],
    "fr": [
      "Visite de l'atelier de distillation et du chai de vieillissement avec l'œnologue distillateur. Découverte de la gamme des spiritueux MEZENK et leur typicité. Dégustation commentée."
    ],
    "es": [
      "Visite el taller de destilación y la bodega de envejecimiento con el ingeniero de destilación. Descubra la gama de espirituosos MEZENK y sus características distintivas. Degustación guiada."
    ],
    "nl": [
      "Bezoek het distillatieatelier en de rijpingskelder met de distilleertechnicus. Ontdek het MEZENK-gamma en hun specifieke kenmerken. Begeleide degustatie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "MEZENK, une distillerie en terre volcanique"
    ]
  },
