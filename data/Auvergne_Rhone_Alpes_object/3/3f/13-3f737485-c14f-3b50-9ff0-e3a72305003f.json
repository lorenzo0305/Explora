  "rdfs:comment": {
    "de": [
      "Roul' ma Poule Sevrier: Fahrradverleih für alle.\r\nKomforträder, Mountainbikes, Sporträder, Fitnessräder, E-Bikes, E-Cargo-Familienfahrräder, Kinder-Mountainbikes, Kinderanhänger, Kindersitze... \r\n+ 600 Fahrräder, 7 Tage die Woche nonstop geöffnet!"
    ],
    "en": [
      "Roul' ma Poule Sevrier: Bicycle rental for all.\r\nComfort bikes, VTC, Sport bikes, Fitness bikes, VAE, E-Bikes, VAE Family E-Cargo, Children's mountain bikes, Children's trailers, Children's seats... \r\n+ 600 Bikes, Open 7 days a week non-stop."
    ],
    "it": [
      "Roul' ma Poule Sevrier: Noleggio biciclette per tutti.\r\n+600 biciclette: biciclette comfort o sportive, VTC, biciclette fitness, VAE, biciclette elettriche, E-Bikes, VAE Family E-Cargo, biciclette per bambini, rimorchi per bambini, cani, seggiolini per bambini. Aperto 7 giorni su 7 senza interruzioni."
    ],
    "fr": [
      "Roul' ma Poule Sevrier: Location de vélos pour tous publics.\r\n+600 Vélos : Vélos Confort ou Sport, VTC, Vélos de Fitness, VAE, Vélos Electriques, E-Bikes, VAE Famille E-Cargo, Vélos enfants, Remorques enfants, Chiens, Sièges enfants. Ouvert 7j/7 non stop."
    ],
    "nl": [
      "Roul' ma Poule Sevrier: Fietsverhuur voor iedereen.\r\n+600 Fietsen: Comfort- of Sportfietsen, VTC, Fitnessfietsen, VAE, Elektrische fietsen, E-bikes, VAE Family E-Cargo, Kinderfietsen, Kinderkarren, Honden, Kinderzitjes. 7 dagen per week non-stop geopend."
    ],
    "es": [
      "Roul' ma Poule Sevrier: Alquiler de bicicletas para todos.\r\n+600 Bicicletas: Bicicletas de Confort o Deportivas, VTC, Bicicletas de Fitness, VAE, Bicicletas Eléctricas, E-Bikes, VAE Family E-Cargo, Bicicletas para Niños, Remolques para Niños, Perros, Asientos para Niños. Abierto 7 días a la semana ininterrumpidamente."
    ]
  },
