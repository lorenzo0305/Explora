  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro von Neuvéglise befindet sich in der Dorfmitte unweit des Flusses Truyère. Das ganze Jahr über geöffnet."
    ],
    "en": [
      "Neuvéglise Tourist Office is located in the village not far from the Truyère river. Open all year round."
    ],
    "it": [
      "L'ufficio turistico di Neuvéglise si trova nel villaggio, non lontano dal fiume Truyère. Aperto tutto l'anno."
    ],
    "fr": [
      "Bureau de tourisme de Neuvéglise est situé dans le bourg du village non loin de la Truyère. Ouvert toute l'année."
    ],
    "es": [
      "La oficina de turismo de Neuvéglise se encuentra en el pueblo, cerca del río Truyère. Abierto todo el año."
    ],
    "nl": [
