  "rdfs:comment": {
    "de": [
      "Mario stellt Ihnen seit 25 Jahren sein Wissen über italienische Spezialitäten zur Verfügung. Er bereitet einen traditionell gebackenen Pizzateig zu, dessen Geheimnis er kennt, und lässt ihn von Ihnen probieren."
    ],
    "en": [
      "Mario has been putting his know-how in Italian specialities at your service for 25 years. He prepares a pizza dough baked according to tradition, which he has the secret, and which he makes you taste."
    ],
    "it": [
      "Mario vi serve da 25 anni con la sua esperienza nelle specialità italiane. Prepara un impasto per pizza cucinato secondo la tradizione, di cui possiede il segreto, e che fa assaggiare."
    ],
    "fr": [
      "Mario met à votre service depuis 25 ans son savoir-faire dans les spécialités italiennes. Il prépare une pâte à pizza cuite selon la tradition, dont il a le secret, et qu'il vous fait déguster."
    ],
    "nl": [
      "Mario staat al 25 jaar voor u klaar met zijn expertise in Italiaanse specialiteiten. Hij bereidt een pizzadeeg volgens de traditie, waarvan hij het geheim heeft, en die hij u laat proeven."
    ],
    "es": [
      "Mario lleva 25 años sirviéndole con su experiencia en especialidades italianas. Prepara una masa de pizza cocinada según la tradición, de la que tiene el secreto, y que te hace probar."
    ]
  },
