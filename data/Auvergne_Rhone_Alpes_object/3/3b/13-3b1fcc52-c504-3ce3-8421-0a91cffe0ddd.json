  "rdfs:comment": {
    "de": [
      "Mit Autrement soie (Anders Seide) erkundet Martine die verschiedenen Techniken der Seidenmalerei. Mit ihrer Seide fertigt sie Mode- und Dekorationsaccessoires an, indem sie verschiedene Fertigkeiten und Materialien (Nähen, Buchbinden, Kartonieren) miteinander verbindet."
    ],
    "en": [
      "With Autrement soie, Martine explores different silk painting techniques. With her silks, she creates fashion and decorative accessories by combining different skills and materials (sewing, binding, cardboard)."
    ],
    "it": [
      "Con Autrement soie, Martine esplora le diverse tecniche di pittura su seta. Con le sue sete, crea accessori di moda e decorativi combinando diverse abilità e materiali (cucito, rilegatura, cartone)."
    ],
    "fr": [
      "Avec Autrement soie, Martine explore les différentes techniques de peinture sur soie. Avec ses soies, elles réalise des accessoires de mode et de décoration en associant plusieurs savoir-faire et matières (couture, reliure, cartonnage)."
    ],
    "nl": [
      "Met Autrement soie verkent Martine de verschillende technieken van het schilderen op zijde. Met haar zijde creëert ze mode- en decoratieve accessoires door verschillende vaardigheden en materialen te combineren (naaien, binden, karton)."
    ],
    "es": [
      "Con Autrement soie, Martine explora las diferentes técnicas de pintura sobre seda. Con sus sedas, crea accesorios de moda y decoración combinando distintas técnicas y materiales (costura, encuadernación, cartón)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Autrement soie / Autrement bleu"
    ]
  },
