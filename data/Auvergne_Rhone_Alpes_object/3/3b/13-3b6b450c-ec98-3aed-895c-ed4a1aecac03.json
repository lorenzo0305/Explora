  "rdfs:comment": {
    "de": [
      "Die Mediathek bietet einen freien Zugang zu Kultur, Information und Freizeit. Sie stellt Bücher, Zeitschriften, DVDs und Spiele zur Verfügung, die vor Ort eingesehen oder ausgeliehen werden können. Außerdem gibt es Lese- und Arbeitsbereiche sowie einen Café-Bereich."
    ],
    "en": [
      "The multimedia library offers free access to culture, information and leisure activities. Books, magazines, DVDs and games can be consulted on site or borrowed. Reading, work and coffee areas."
    ],
    "it": [
      "La biblioteca multimediale offre libero accesso alla cultura, all'informazione e alle attività del tempo libero. Libri, riviste, DVD e giochi possono essere consultati in loco o presi in prestito. Ci sono aree per la lettura, il lavoro e un caffè."
    ],
    "fr": [
      "La médiathèque offre un accès libre à la culture, à l’information et aux loisirs. Elle met à disposition des livres, magazines, DVD, jeux, consultables sur place ou empruntables. Des espaces de lecture, de travail, et un espace café."
    ],
    "es": [
      "La biblioteca multimedia ofrece acceso gratuito a la cultura, la información y el ocio. Libros, revistas, DVD y juegos pueden consultarse in situ o tomarse prestados. Hay zonas para leer, trabajar y una cafetería."
    ],
    "nl": [
      "De mediatheek biedt gratis toegang tot cultuur, informatie en vrijetijdsactiviteiten. Boeken, tijdschriften, dvd's en spelletjes kunnen ter plekke worden geraadpleegd of geleend. Er zijn lees- en werkruimtes en een café."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque municipale"
    ]
  },
