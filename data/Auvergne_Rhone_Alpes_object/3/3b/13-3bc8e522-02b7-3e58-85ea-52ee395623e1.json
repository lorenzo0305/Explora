  "rdfs:comment": {
    "de": [
      "Alle Landschaftsarbeiten: Bewässerung, Teiche, Anpflanzungen, Beschneiden, Beschneiden, Mähen. Terrassen aus Holz. Zulassung für Pflanzenschutzmittel, 50 % Steuergutschrift.\r\nVernichtung von Wespen- und Hornissennestern im Sommer."
    ],
    "en": [
      "All landscaping work: watering, ponds, planting, pruning, mowing. Wooden terraces. Approved for phytosanitary treatments, 50 percent tax credit recovery.\r\nDestruction of wasp and hornet nests in summer."
    ],
    "it": [
      "Tutti i lavori di giardinaggio: irrigazione, laghetti, piantumazione, potatura, sfalcio. Terrazze in legno. Trattamenti fitosanitari approvati, recupero del 50% del credito d'imposta\r\nDistruzione di nidi di vespe e calabroni nella stagione estiva."
    ],
    "fr": [
      "Tous travaux paysagers: arrosage, bassins, plantations, élagage, taille, tonte. Terrasses en bois. Agréé traitements phytosanitaires, recuperation credit impot 50 pourcent\r\nDestruction nids de guêpes et frelons, en saison estivale."
    ],
    "es": [
      "Todos los trabajos de jardinería: riego, estanques, plantación, poda, siega. Terrazas de madera. Tratamientos fitosanitarios aprobados, recuperación del 50 por ciento del crédito fiscal\r\nDestrucción de nidos de avispas y avispones en la temporada de verano."
    ],
    "nl": [
      "Alle tuinaanleg: water geven, vijvers, planten, snoeien, maaien. Houten terrassen. Goedgekeurd voor fytosanitaire behandelingen, 50 procent belastingkrediet terugvordering.\r\nVernietiging van wespen- en horzelnesten in de zomer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les 3 Cyprès"
    ]
  },
