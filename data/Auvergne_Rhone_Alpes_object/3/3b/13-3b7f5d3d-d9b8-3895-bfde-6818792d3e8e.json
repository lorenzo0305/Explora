  "rdfs:comment": {
    "de": [
      "Diese Route beginnt auf den Anhöhen von Savasse und erkundet das typische alte Dorf, bevor sie durch den Wald führt und dann auf dem Kamm bis zum Savasse-Relais endet."
    ],
    "en": [
      "This route starts at the top of Savasse and explores its typical old village, before winding through the forest and ending up on the ridge at the Relais de Savasse."
    ],
    "it": [
      "Questo percorso parte dalla cima di Savasse ed esplora il suo tipico borgo antico, prima di snodarsi nel bosco e terminare su un crinale fino alla stazione di staffetta di Savasse."
    ],
    "fr": [
      "Cet itinéraire part des hauteurs de Savasse et explore son vieux village typique avant de parcourir la forêt puis de terminer en crête jusqu'au relais de Savasse."
    ],
    "es": [
      "Esta ruta comienza en la cima de Savasse y explora su típico pueblo antiguo, antes de serpentear por el bosque y terminar en una cresta hasta la estación de relevo de Savasse."
    ],
    "nl": [
      "Deze route begint op de top van Savasse en verkent het typische oude dorp, voordat hij door het bos kronkelt en eindigt op een bergkam tot aan het relaisstation van Savasse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Autour du Vieux Savasse"
    ]
  },
