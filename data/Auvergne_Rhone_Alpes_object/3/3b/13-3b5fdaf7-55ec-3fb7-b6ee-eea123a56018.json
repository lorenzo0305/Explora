  "rdfs:comment": {
    "de": [
      "Straßenräder für Erwachsene (Kindersitze, Helme und Diebstahlsicherung werden zur Verfügung gestellt). Reservierung empfohlen."
    ],
    "en": [
      "Ride the greenway ‘Voie Verte du Beaujolais’ and cross the tourist biking loops on our hybrid bikes (VTC), or electrically assisted bikes (VAE). Adult VTC and VAE rental, children's mountain bikes, children's trailers, baby seats."
    ],
    "it": [
      "Percorrete la Voie Verte du Beaujolais e gli anelli cicloturistici su bici muscolari (VTC) o elettriche (VAE). Noleggio di biciclette VTC e VAE per adulti, mountain bike per bambini, rimorchi per bambini e seggiolini per condividere l'avventura con la famiglia."
    ],
    "fr": [
      "Parcourez la Voie Verte du Beaujolais et les boucles cyclotouristiques sur des vélos musculaires (VTC) ou électriques (VAE). Location de VTC et VAE adultes, VTT enfants, remorque enfants, sièges bébés pour partager l’aventure en famille."
    ],
    "nl": [
      "Rijd de Voie Verte du Beaujolais en de lussen van het fietstoerisme op musclebikes (VTC) of elektrische fietsen (VAE). Verhuur van VTC- en VAE-fietsen voor volwassenen, mountainbikes voor kinderen, kinderkarretjes en babyzitjes zodat je het avontuur met je gezin kunt delen."
    ],
    "es": [
      "Recorra la Voie Verte du Beaujolais y los bucles cicloturistas en bicicletas musculosas (VTC) o eléctricas (VAE). Alquiler de bicicletas VTC y VAE para adultos, bicicletas de montaña para niños, remolques infantiles y sillas de bebé para que pueda compartir la aventura en familia."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bike Rental at the Maison du terroir beaujolais"
    ],
    "fr": [
      "Location de Vélos de la Maison du terroir beaujolais"
    ]
  },
