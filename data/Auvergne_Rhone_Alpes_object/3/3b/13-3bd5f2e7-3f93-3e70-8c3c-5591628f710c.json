  "rdfs:comment": {
    "de": [
      "Die Coulée Verte ist eine echte Einladung zum Spazierengehen oder Radfahren und erstreckt sich über eine Länge von fast 2,5 km."
    ],
    "en": [
      "The Coulée Verte is an invitation to stroll or cycle along its 2.5 km length."
    ],
    "it": [
      "La Coulée Verte è un vero e proprio invito a fare una passeggiata a piedi o in bicicletta e si estende per quasi 2,5 km."
    ],
    "fr": [
      "Véritable invitation à se balader, à pied ou à vélo, la Coulée Verte s’étend sur près de 2,5 km."
    ],
