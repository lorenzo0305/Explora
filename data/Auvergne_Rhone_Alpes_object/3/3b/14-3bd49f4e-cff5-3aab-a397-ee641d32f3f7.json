  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/131dee0e-eb5e-339b-a1f2-0afd0d5056b9",
      "dc:description": {
        "de": [
          "Sportfischereiverein, der am Meer angelt. Mitglied der Fédération Française des pêches sportives (Französischer Verband für Sportfischerei).\n\nEinführung in das Angeln (Strand von Le Touquet, Sainte Cécile, Baie de Canche, Pilori?).\n\nLizenz für Wettkämpfe: 47? Jugendlizenz: 15?\n\nEinfache Leistung 2,5 Stunden Angeln 40 Euro (inklusive Köder und Material)."
        ],
        "en": [
          "Sport fishing association. Affiliated with the French Federation of Sport Fishing.\n\nIntroduction to fishing (Le Touquet beach, Sainte Cécile, Baie de Canche, Pilori?).\n\nCompetition license: 47? Youth license: 15?\n\nSimple 2h30 fishing 40? (bait and tackle included)."
        ],
        "it": [
          "Associazione di pesca sportiva in mare. Affiliata alla Federazione Francese di Pesca Sportiva.\n\nIntroduzione alla pesca (spiaggia di Le Touquet, Sainte Cécile, Baie de Canche, Pilori, ecc.).\n\nLicenza da competizione: 47 euro Licenza giovanile: 15 euro?\n\nPacchetto di pesca semplice di 2 ore: 40 € (esche e attrezzature incluse)."
        ],
        "fr": [
          "Association sportive de pêche en bord de mer. Affiliée à la Fédération Française des pêches sportives.\n\nInitiation de pêches (plage du Touquet, Sainte Cécile, Baie de Canche, Pilori…).\n\nLicence compétition : 47€ Licence jeune : 15€\n\nPrestation simple 2h30 de pêches 40€ (appâts compris et matériel)."
        ],
        "nl": [
          "Vereniging voor sportvissen aan zee. Aangesloten bij de Franse Federatie van Sportvisserij.\n\nKennismaking met vissen (strand van Le Touquet, Sainte Cécile, Baie de Canche, Pilori, enz.).\n\nWedstrijdvergunning: € 47 Jeugdvergunning: 15?\n\nEenvoudig visarrangement van 2 uur: €40 (aas en visgerei inbegrepen)."
        ],
        "es": [
          "Asociación de pesca deportiva costera. Afiliada a la Federación Francesa de Pesca Deportiva.\n\nIniciación a la pesca (playa de Le Touquet, Sainte Cécile, Baie de Canche, Pilori, etc.).\n\nLicencia de competición: 47? Licencia juvenil: 15?\n\nPaquete de pesca simple de 2 horas y media: 40 euros (cebos y aparejos incluidos)."
        ]
      },
      "@type": [
        "Description"
      ],
