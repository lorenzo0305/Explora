  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7156266e-500c-3012-a91b-44aee3a2b775",
      "dc:description": {
        "de": [
          "Weinbar.\n\nTäglich geöffnet außer Sonntagabend und Dienstag in der Nebensaison.\nAußer Sonntagabend in der Hochsaison.\nVon 9:30 bis 15:00 Uhr und von 18:00 bis 1:00 Uhr (Woche). 2.00 Uhr (Wochenende)."
        ],
        "en": [
          "Wine bar.\n\nOpen every day except Sunday evening and Tuesday in low season.\nExcept Sunday evening in high season.\n9:30 am to 3:00 pm and 6:00 pm to 1:00 am (weekdays). 2h00 (weekend)."
        ],
        "it": [
          "Enoteca.\n\nAperto tutti i giorni tranne la domenica sera e il martedì in bassa stagione.\nTranne la domenica sera in alta stagione.\nDalle 9.30 alle 15.00 e dalle 18.00 all'1.00 (giorni feriali). 2h00 (fine settimana)."
        ],
        "fr": [
          "Bar à vin.\n\nOuvert tous les jours sauf dimanche soir et mardi en basse saison.\nSauf le dimanche soir en haute saison.\nDe 9h30 à 15h00 et de 18h00 à 1h00 (semaine). 2h00 (week-end)."
        ],
        "nl": [
          "Wijnbar.\n\nDagelijks geopend behalve zondagavond en dinsdag in het laagseizoen.\nBehalve zondagavond in het hoogseizoen.\nVan 9.30 tot 15.00 en van 18.00 tot 01.00 (weekdagen). 2u00 (weekend)."
        ],
        "es": [
          "Bar de vinos.\n\nAbierto todos los días excepto los domingos por la noche y los martes en temporada baja.\nExcepto domingos por la noche en temporada alta.\nDe 9h30 a 15h00 y de 18h00 a 1h00 (entre semana). de 2h00 (fin de semana)."
        ]
      },
      "@type": [
        "Description"
      ],
