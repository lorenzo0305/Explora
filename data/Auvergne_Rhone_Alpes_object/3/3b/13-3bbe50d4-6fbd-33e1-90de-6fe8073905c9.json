  "rdfs:comment": {
    "de": [
      "Die Domaine St Romain umfasst 30 Hektar zertifizierte Bio-Anbaufläche. Entdecken Sie unsere Weine aus Jongieux: Marestel, Mondeuse oder sogar den ikonischen Jacquère... Der Verkauf und die Weinprobe finden täglich in der CAVE A PERRET statt und die Preise sind direkt im Weinkeller."
    ],
    "en": [
      "The Domaine St Romain has 30 hectares of certified organic land. Discover our Jongieux wines: Marestel, Mondeuse or even the iconic Jacquère... Sales and tasting take place at the CAVE A PERRET every day and at the direct cellar rate."
    ],
    "it": [
      "Il Domaine St Romain dispone di 30 ettari di terreno certificato biologico. Scoprite i nostri vini Jongieux: Marestel, Mondeuse o anche l'iconico Jacquère... La vendita e la degustazione si svolgono tutti i giorni presso la CAVE A PERRET, alla tariffa diretta della cantina."
    ],
    "fr": [
      "Le Domaine St Romain compte 30 hectares certifiés en Bio. Découvrez nos crus de Jongieux : Marestel, Mondeuse ou même iconique Jacquère...La vente et la dégustation s'effectuent à la CAVE A PERRET tous les jours et au tarif direct caveau."
    ],
    "es": [
      "El Domaine St Romain cuenta con 30 hectáreas de tierras ecológicas certificadas. Descubra nuestros vinos de Jongieux: Marestel, Mondeuse o incluso el emblemático Jacquère... La venta y la degustación tienen lugar en la CAVE A PERRET todos los días y a tarifa directa de bodega."
    ],
    "nl": [
      "Domaine St Romain heeft 30 hectare gecertificeerde biologische wijngaarden. Ontdek onze Jongieux-wijnen: Marestel, Mondeuse en zelfs de iconische Jacquère...Verkoop en proeverijen vinden dagelijks plaats in de CAVE A PERRET tegen het directe keldertarief."
    ]
  },
