  "rdfs:comment": {
    "de": [
      "Das Restaurant Aux Gourmands de Belleville bietet eine einzigartige Umgebung in der Nähe eines Gewässers und des Flusses Saône."
    ],
    "en": [
      "Aux Gourmands de Belleville restaurant is a unique location next to a lake and the Saône River. There you may eat delicious traditional cuisine: fresh frogs' legs, fried whitebait, homemade liver terrine, grilled meats, day's special."
    ],
    "it": [
      "Il ristorante Aux Gourmands de Belleville offre un ambiente unico vicino a un lago e al fiume Saône."
    ],
    "fr": [
      "Le restaurant Aux Gourmands de Belleville offre un cadre unique à proximité d'un plan d'eau et de la Saône."
    ],
