  "rdfs:comment": {
    "de": [
      "Die Auberge du Rozay freut sich, Ihnen hausgemachte und frisch zubereitete Gerichte anbieten zu können! Wir freuen uns, Sie in Condrieu begrüßen zu dürfen, um gemeinsam elegante und gesellige Tischmomente zu teilen."
    ],
    "en": [
      "The Auberge du Rozay is delighted to offer you freshly prepared, homemade dishes! We are delighted to welcome you to Condrieu to share elegant and convivial moments at the table."
    ],
    "it": [
      "L'Auberge du Rozay è lieto di offrirvi piatti preparati al momento e cucinati in casa! Saremo lieti di accogliervi a Condrieu per condividere momenti eleganti e conviviali a tavola."
    ],
    "fr": [
      "L'Auberge du Rozay est heureuse de vous offrir des plats faits maison et fraichement préparés ! Nous avons le plaisir de vous accueillir à Condrieu pour partager ensemble des moments de table élégants et conviviaux."
    ],
    "es": [
      "El Auberge du Rozay está encantado de ofrecerle platos caseros recién preparados Estaremos encantados de recibirle en Condrieu para compartir momentos elegantes y agradables a la mesa."
    ],
    "nl": [
      "De Auberge du Rozay is verheugd u vers bereide, huisgemaakte gerechten aan te bieden! We kijken ernaar uit u te verwelkomen in Condrieu om elegante en gezellige momenten aan tafel te delen."
    ]
  },
  "rdfs:label": {
