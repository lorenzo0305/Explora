  "rdfs:comment": {
    "de": [
      "Durch ihre Schlichtheit, architektonische Schönheit und Ausführung als Gewölbesaal war die ehemalige Fleischhalle von Anfang an für die moderne Kunst prädestiniert. Kulturerbe und künstlerisches Schaffen sind die Leitworte dieses Bauwerks."
    ],
    "en": [
      "The architectural simplicity and beauty of the former butchers' market with its vaulted room made it the ideal venue for contemporary art. Rich heritage and artistic creation are the venue's watchwords."
    ],
    "it": [
      "La sobrietà e la bellezza architettonica dell'ex Butchers Hall, con la sua pianta a volta, l'hanno predestinata a diventare uno spazio dedicato all'arte contemporanea. Un ricco patrimonio e la creazione artistica sono le parole chiave."
    ],
    "fr": [
      "La sobriété et la beauté architecturale de l’ancienne Halle des bouchers, avec sa disposition en salle voûtée, la prédestinait à devenir un lieu dédié à l’art contemporain. Richesse patrimoniale et création artistique sont les maîtres mots de ce lieu."
    ],
    "es": [
      "La sobriedad y la belleza arquitectónica de la antigua Carnicería, con su planta abovedada, la predestinaron a convertirse en un lugar dedicado al arte contemporáneo. Un rico patrimonio y creación artística son aquí las palabras clave."
    ],
    "nl": [
      "De soberheid en architecturale schoonheid van de voormalige Slagerszaal, met zijn gewelfde zaalindeling, waren voorbestemd om een locatie te worden die gewijd is aan hedendaagse kunst. Een rijk erfgoed en artistieke creatie zijn hier de sleutelwoorden."
    ]
  },
  "rdfs:label": {
    "de": [
      "Zentrum der modernen Kunst in der Fleischhalle"
    ],
    "en": [
      "Halle des Bouchers Contemporary Art Centre"
    ],
    "fr": [
      "Centre d'Art Contemporain La Halle des Bouchers"
    ],
    "es": [
      "Centro de Arte Contemporáneo"
    ]
  },
