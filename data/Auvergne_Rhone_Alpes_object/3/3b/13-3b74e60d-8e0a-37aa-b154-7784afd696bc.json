  "rdfs:comment": {
    "de": [
      "Suchen Sie einen sicheren Ort, um mit Ihren Kindern Schlitten zu fahren? Dann besuchen Sie den Espace Fripons in Le Planay! Fahren Sie die Piste hinunter und kommen Sie mühelos auf einem angelegten und geschützten Teppich in einem Tunnel wieder hoch. Der ideale Ort, um mit der ganzen Familie Spaß zu haben."
    ],
    "en": [
      "Looking for a safe place to go sledding with your children? Visit the Fripons area at Planay! Slide down the track and climb back up effortlessly on a fitted carpet sheltered under a tunnel. The ideal place for family fun."
    ],
    "it": [
      "Cercate un luogo sicuro per andare in slitta con i vostri bambini? Allora recatevi nell'area Fripons a Le Planay! Potrete sfrecciare lungo la pista e risalire senza fatica su un tappeto appositamente progettato e protetto da un tunnel. Il luogo ideale per il divertimento della famiglia."
    ],
    "fr": [
      "Vous cherchez un endroit sécurisé pour faire de la luge avec vos enfants ? Rendez-vous sur l'espace Fripons au Planay ! Dévalez la piste et remontez sans effort sur un tapis aménagé et abrité sous tunnel. L'endroit idéal pour s'amuser en famille."
    ],
    "es": [
      "¿Busca un lugar seguro para ir en trineo con sus hijos? Diríjase a la zona de Fripons, en Le Planay Podrás deslizarte por la pista y volver a subir sin esfuerzo por una alfombra especialmente diseñada y protegida por un túnel. El lugar ideal para divertirse en familia."
    ],
    "nl": [
      "Op zoek naar een veilige plek om te sleeën met je kinderen? Ga dan naar de Fripons in Le Planay! Je raast over de baan naar beneden en klimt moeiteloos weer omhoog op een speciaal ontworpen tapijt in de beschutting van een tunnel. De ideale plek voor familieplezier."
    ]
  },
  "rdfs:label": {
    "en": [
      "Cheaters' Area - Toboggan Run"
    ],
    "fr": [
      "Espace Fripons - Piste de luge"
    ]
  },
