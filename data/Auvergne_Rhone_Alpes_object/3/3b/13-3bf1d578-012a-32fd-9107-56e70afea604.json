  "rdfs:comment": {
    "de": [
      "Jeden 1. Donnerstag im Monat können Sie von 14:30 bis 18:00 Uhr mit dem Festkomitee einen geselligen Moment bei Gesellschaftsspielen, Basteln oder anderen Entspannungsmöglichkeiten verbringen."
    ],
    "en": [
      "Every 1st Thursday of the month, enjoy board games, arts and crafts or other moments of relaxation from 2.30pm to 6pm with the Comité des fêtes."
    ],
    "it": [
      "Ogni primo giovedì del mese, dalle 14.30 alle 18.00, il Comité des fêtes propone giochi da tavolo, artigianato o altri momenti di relax."
    ],
    "fr": [
      "Tous les 1ers jeudi du mois, passez un moment convivial autour de jeux de société , d'activités manuelles ou autres instants de détente de 14h30 à 18h avec le comité des fêtes."
    ],
    "es": [
      "Todos los primeros jueves de mes, disfrute de juegos de mesa, manualidades u otros momentos de relajación de 14.30 a 18.00 h con el Comité des fêtes."
    ],
    "nl": [
      "Geniet elke 1e donderdag van de maand van gezelschapsspelletjes, knutselen of andere momenten van ontspanning van 14.30 tot 18.00 uur met het Comité des fêtes."
    ]
  },
