  "rdfs:comment": {
    "de": [
      "Ein geselliger Tag! 14h-18h30: Gesellschaftsspiele für alle, Erfrischungsstände und Feinschmeckerbretter. 20:30 Uhr: Spannender Vortrag über den Staudamm von Lavalette (Herausforderungen, Auswirkungen, Perspektiven). Eintritt frei (Hut). Von Les Amis des Montfaucon de France."
    ],
    "en": [
      "A fun day out! 2-6:30pm: board games for all, refreshments and gourmet platters. 8:30pm: captivating talk on the Lavalette dam (issues, impacts, prospects). Free admission (hats on). By Les Amis des Montfaucon de France."
    ],
    "it": [
      "Una giornata all'insegna del divertimento! 14.00-18.30: giochi da tavolo per tutti, rinfreschi e spuntini gourmet. ore 20.30: conferenza accattivante sulla diga di Lavalette (problemi, impatti, prospettive). Ingresso libero (cappelli in testa). A cura di Les Amis des Montfaucon de France."
    ],
    "fr": [
      "Journée conviviale ! 14h-18h30 : jeux de société pour tous, buvette et planches gourmandes. 20h30 : conférence captivante sur le barrage de Lavalette (enjeux, impacts, perspectives). Entrée libre (chapeau). Par Les Amis des Montfaucon de France."
    ],
    "es": [
      "Una jornada lúdica 14.00-18.30: juegos de mesa para todos, refrescos y aperitivos gourmet. 20.30 h: conferencia apasionante sobre la presa de Lavalette (problemas, repercusiones, perspectivas). Entrada gratuita (con sombrero). A cargo de Les Amis des Montfaucon de France."
    ],
    "nl": [
      "Een leuk dagje uit! 14.00 - 18.30 uur: gezelschapsspellen voor iedereen, verfrissingen en hapjes voor fijnproevers. 20.30 uur: boeiende lezing over de Lavalette-dam (problemen, gevolgen, vooruitzichten). Gratis toegang (petten op). Door Les Amis des Montfaucon de France."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Après midi jeux de société et conférence"
    ]
  },
