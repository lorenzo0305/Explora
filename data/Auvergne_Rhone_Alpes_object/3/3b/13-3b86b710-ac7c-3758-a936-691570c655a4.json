  "rdfs:comment": {
    "de": [
      "Label Bienvenue à la Ferme (Willkommen auf dem Bauernhof)\r\nDirektverkauf von Käse aus Kuhmilch und Besuch des Bauernhofs.\r\nKleiner Imbiss vor Ort.\r\nProdukte auch in den Jardins du Gévaudan in Saugues zu finden."
    ],
    "en": [
      "Welcome to the Farm label\r\nDirect sale of cow's milk cheeses and visit to the farm.\r\nLight meals available on site.\r\nProducts also available at Jardins du Gévaudan in Saugues."
    ],
    "it": [
      "Benvenuti nel marchio della fattoria\r\nVendita diretta di formaggi di latte vaccino e visita alla fattoria.\r\nPossibilità di consumare pasti leggeri in loco.\r\nI prodotti sono disponibili anche presso i Jardins du Gévaudan a Saugues."
    ],
    "fr": [
      "Label Bienvenue à la Ferme\r\nVente directe de fromages au lait de vaches et visite de la ferme.\r\nPetite restauration sur place.\r\nProduits à retrouver également aux Jardins du Gévaudan à Saugues."
    ],
    "nl": [
      "Welkom op de boerderij\r\nDirecte verkoop van koemelkkazen en bezoek aan de boerderij.\r\nLichte maaltijden ter plaatse verkrijgbaar.\r\nDe producten zijn ook te vinden in de Jardins du Gévaudan in Saugues."
    ],
    "es": [
      "Etiqueta de bienvenida a la granja\r\nVenta directa de quesos de leche de vaca y visita a la granja.\r\nComidas ligeras in situ.\r\nLos productos también se pueden encontrar en los Jardins du Gévaudan en Saugues."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme aux Fromages"
    ]
  },
