  "rdfs:comment": {
    "de": [
      "In einem charmanten Rahmen, der die Umwelt und das Wohlbefinden respektiert, gehört dieses Fisch- und Meeresfrüchterestaurant mit 240 Plätzen zur Saga der Jols-Einrichtungen."
    ],
    "en": [
      "In a charming atmosphere, environmentally-friendly and well-being, the fish and seafood restaurant, up to 240 people, belongs to Jols institutions."
    ],
    "it": [
      "In un ambiente affascinante che rispetta l'ambiente e il benessere, questo ristorante di pesce e frutti di mare da 240 posti appartiene alla saga degli stabilimenti di Jols."
    ],
    "fr": [
      "Dans un cadre charmant qui respecte l’environnement et le bien-être, ce restaurant de poissons et fruits de mer de 240 couverts appartient à la saga des établissements Jols."
    ],
    "nl": [
      "In een charmant kader met respect voor het milieu en het welzijn, behoort dit vis- en zeevruchtenrestaurant met 240 plaatsen tot de saga van de Jols-etablissementen."
    ],
    "es": [
      "En un entorno encantador y respetuoso con el medio ambiente y el bienestar, este restaurante de pescado y marisco con capacidad para 240 personas pertenece a la saga de los establecimientos Jols."
    ]
  },
