  "rdfs:comment": {
    "de": [
      "Heben Sie sich von konventionellen Abendveranstaltungen ab und bieten Sie Ihren Teilnehmern eine Signierstunde an. Die Librairie de Paris kann am Ort Ihrer Veranstaltung mit einem eigenen Bereich vertreten sein, in dem Bücher verkauft werden, die im Zusammenhang mit Ihrer Veranstaltung stehen."
    ],
    "en": [
      "Get away from conventional evenings and offer a book signing session to your participants. The Librairie de Paris can be present at your event with a space dedicated to the sale of books related to your event."
    ],
    "it": [
      "Allontanatevi dagli eventi serali convenzionali e offrite una sessione di autografi ai vostri partecipanti. La Librairie de Paris può essere presente al vostro evento con uno spazio dedicato alla vendita di libri legati al vostro evento."
    ],
    "fr": [
      "Sortez des soirées conventionnelles et proposez une séance dédicace à vos participants. La Librairie de Paris peut être présente sur le lieu de votre manifestation avec un espace dédié à la vente d’ouvrages en lien avec votre événement."
    ],
    "nl": [
      "Stap af van de conventionele avondevenementen en bied uw deelnemers een signeersessie aan. De Librairie de Paris kan aanwezig zijn op uw evenement met een ruimte gewijd aan de verkoop van boeken met betrekking tot uw evenement."
    ],
    "es": [
      "Aléjese de los eventos nocturnos convencionales y ofrezca una sesión de firma de libros a sus participantes. La Librairie de Paris puede estar presente en su evento con un espacio dedicado a la venta de libros relacionados con su evento."
    ]
  },
  "rdfs:label": {
