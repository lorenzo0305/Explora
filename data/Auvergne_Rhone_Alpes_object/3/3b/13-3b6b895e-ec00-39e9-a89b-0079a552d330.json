  "rdfs:comment": {
    "de": [
      "Das Spa des des Alpes ist ein warmer Rahmen aus Holz und Stein und empfängt Sie für einen Moment außerhalb der Zeit. Gesichtsbehandlungen, Massagen und Lichttherapie vervollständigen den aquatisch-sensorischen Bereich, der den Anfang der Entdeckung der Alpinotherapie® bildet."
    ],
    "en": [
      "A warm and welcoming setting in wood and stone, the Spa des Alpes welcomes you all year round for a moment out of time, to share or enjoy for yourself. An invitation to discover the mountains in a different way, with Alpinothérapie®."
    ],
    "it": [
      "In un ambiente caldo di legno e pietra, la Spa des Alpes vi accoglie per un momento senza tempo. Trattamenti viso, massaggi e terapia della luce completano l'area acquasensoriale, primo passo per scoprire l'Alpinothérapie®."
    ],
    "fr": [
      "Écrin chaleureux de bois et de pierre vêtu, le Spa des des Alpes vous accueille pour un moment hors du temps. Soins visage, massages, luminothérapie, complètent l'espace aqua-sensoriel, prémices de la découverte de l'Alpinothérapie®."
    ],
    "nl": [
      "In een warme omgeving van hout en steen verwelkomt de Spa des Alpes je het hele jaar door voor een moment buiten de tijd, om te delen of om zelf van te genieten. Een uitnodiging om de bergen op een andere manier te ontdekken met Alpinothérapie®."
    ],
    "es": [
      "En un cálido marco de madera y piedra, el Spa des Alpes le da la bienvenida para un momento atemporal. Tratamientos faciales, masajes y luminoterapia complementan el espacio acutisensorial, primer paso para descubrir la Alpinothérapie®."
    ]
  },
