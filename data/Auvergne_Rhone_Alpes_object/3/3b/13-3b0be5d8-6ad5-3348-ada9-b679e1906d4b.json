  "rdfs:comment": {
    "de": [
      "Bubble Effect ist ein Raum für Bürogemeinschaften im Herzen von Dieulefit.\r\nWir bieten Ihnen 7 Büros mit sehr schnellem Internet, einen Entspannungsbereich mit Kaffee und Tee nach Belieben, alle Annehmlichkeiten, um einen Tag, eine Woche oder einen Monat lang zu arbeiten!"
    ],
    "en": [
      "Bubble effect is a coworking space. You will the chose of 7 desk with internet access, a relaxation area with coffee and tea. \r\nFor one day, one week, one month or one year - Welcome !"
    ],
    "it": [
      "Bubble Effect è un ufficio condiviso nel cuore di Dieulefit\r\nOffriamo 7 uffici con accesso a Internet ad alta velocità, un'area relax con caffè e tè illimitati e tutto il comfort necessario per lavorare per un giorno, una settimana o un mese!"
    ],
    "fr": [
      "Bubble Effect est un espace de bureaux partagés en plein cœur de Dieulefit. \r\nNous vous proposons 7 bureaux avec un internet très haut débit, un espace détente avec café et thé à volonté, tous le confort pour travailler à la journée, semaine, mois !"
    ],
    "nl": [
      "Bubble Effect is een gedeelde kantoorruimte in het hart van Dieulefit.\r\nWij bieden 7 kantoren met high-speed internet, een ontspanningsruimte met onbeperkt koffie en thee, en alle comfort die je nodig hebt om een dag, een week of een maand te werken!"
    ],
    "es": [
      "Bubble Effect es un espacio de oficina compartido en el corazón de Dieulefit\r\nOfrecemos 7 despachos con acceso a Internet de alta velocidad, una zona de descanso con café y té ilimitados, y toda la comodidad que necesitas para trabajar durante un día, una semana o un mes"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bubble Effect Coworking"
    ]
  },
