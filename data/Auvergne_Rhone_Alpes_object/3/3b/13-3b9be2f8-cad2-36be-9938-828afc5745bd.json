  "rdfs:comment": {
    "de": [
      "Entdecken Sie jeden Tag die Baronnies in der Drôme Provençale auf begleiteten Themenwanderungen: Fauna, Flora, lokale Kulturen, Viehzucht ... handwerkliche oder sportliche Aktivitäten, Kutschfahrten, Ponyreiten oder Gyropode, ..."
    ],
    "en": [
      "Every day, discover the Baronnies in the Drôme Provençale region on guided themed walks: fauna, flora, local cultures, animal husbandry ... manual or sporting activities, horse-drawn carriage, pony or gyropod rides, ..."
    ],
    "it": [
      "Ogni giorno, scoprite le Baronnies della Drôme Provençale con passeggiate a tema accompagnate da una guida: fauna, flora, culture locali, allevamento... attività manuali o sportive, gite in carrozza, in pony o in giostra,..."
    ],
    "fr": [
      "Chaque jour, découvrez les Baronnies en Drôme Provençale à l'occasion de balades à thèmes accompagnées : faune, flore, cultures locales, élevage ... activités manuelles ou sportives, balades en calèche, à poney ou en gyropode,..."
    ],
    "nl": [
      "Ontdek elke dag de Baronnies in de Drôme Provençale tijdens themawandelingen met een gids: fauna, flora, plaatselijke culturen, veeteelt... manuele of sportieve activiteiten, tochten met een koets, pony of gyro,..."
    ],
    "es": [
      "Descubra cada día las Baronnies de la Drôme provenzal en paseos temáticos con guía: fauna, flora, culturas locales, ganadería... actividades manuales o deportivas, paseos en coche de caballos, en poni o en autogiro,..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Startling outings...! Thematic outings in Baronnies en Drôme Provençale"
    ],
    "fr": [
      "Baladez, bougez curieux : balades à thèmes dans les Baronnies en Drôme Provençale"
    ],
    "nl": [
      "Verrassende uitstapjes...! Thematische uitstapjes in de Baronieën van de Provençaalse Drôme"
    ]
  },
