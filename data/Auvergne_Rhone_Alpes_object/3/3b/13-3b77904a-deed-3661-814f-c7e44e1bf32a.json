  "rdfs:comment": {
    "de": [
      "Auf dem See, Panoramaraum , Gourmet-Küche und Tradition. Fischspezialitäten aus dem See und Produckte aus dem Savoyen. Klimatisierte Zimmer.\r\nBootsliegeplatz Ponton"
    ],
    "en": [
      "On stilts over the lake, panoramic dining room, traditional gourmet cuisine. Specialities of lake fish and Savoyard products. Air-conditioned dining room.\r\nMooring pontoon for boats."
    ],
    "it": [
      "Su palafitte sul lago, sala da pranzo panoramica, cucina tradizionale gourmet. Specialità di pesce di lago e prodotti savoiardi. Sala da pranzo climatizzata.\r\nPontile di ormeggio per le barche."
    ],
    "fr": [
      "Sur pilotis sur le lac, salle panoramique, cuisine gourmande et de tradition. Spécialités de poissons de lac et produits savoyards. Salle climatisée.\r\nPonton d'amarrage pour bateaux."
    ],
    "es": [
      "Sobre pilotes sobre el lago, comedor panorámico, cocina gastronómica tradicional. Especialidades de pescado del lago y productos de Saboya. Comedor climatizado.\r\nPontón de amarre para embarcaciones."
    ],
    "nl": [
      "Op palen boven het meer, panoramische eetzaal, traditionele gastronomische keuken. Specialiteiten van vis uit het meer en Savoyaardse producten. Eetzaal met airconditioning.\r\nAanlegsteiger voor boten."
    ]
  },
