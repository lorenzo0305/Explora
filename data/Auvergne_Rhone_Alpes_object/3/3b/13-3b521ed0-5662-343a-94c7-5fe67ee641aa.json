  "rdfs:comment": {
    "de": [
      "Seit Oktober 1993 ist \"PIZZA-MAGIC\" auf den Straßen zwischen Loire und Haute-Loire unterwegs, um Sie zu verwöhnen!Unsere Verpflichtung:Hygiene, Qualität, Service, Auswahl und Preis!"
    ],
    "en": [
      "\"Since October 1993, “PIZZA-MAGIC” has travelled the roads of Loire and Haute-Loire to serve you delicious pizzas. Our promise:  meticulous hygiene, quality and service, plenty of choice and great prices!\""
    ],
    "it": [
      "Dall'ottobre 1993, \"PIZZA-MAGIC\" percorre le strade tra la Loira e l'Alta Loira per servirvi! Il nostro impegno: igiene, qualità, servizio, scelta e prezzo!"
    ],
    "fr": [
      "Depuis octobre 1993 ,« PIZZA-MAGIC » sillonne les routes entre Loire et Haute-Loire pour vous régaler! Notre engagement :  l'hygiène, la qualité, le service, le choix et le prix!"
    ],
    "nl": [
      "Sinds oktober 1993 bereist \"PIZZA-MAGIC\" de wegen tussen de Loire en de Haute-Loire om u te bedienen! Ons engagement: hygiëne, kwaliteit, service, keuze en prijs!"
    ],
    "es": [
      "Desde octubre de 1993, \"PIZZA-MAGIC\" recorre las carreteras entre el Loira y el Alto Loira para servirle Nuestro compromiso: higiene, calidad, servicio, elección y precio"
    ]
  },
