  "rdfs:comment": {
    "de": [
      "Das L'inattendu ist ein Restaurant mit 30/40 Plätzen, das eine traditionelle Küche anbietet. An schönen Tagen lädt eine schattige Terrasse zum Verweilen ein."
    ],
    "en": [
      "L'inattendu is a restaurant with seating for 30–40 people, serving traditional cuisine. A shaded terrace welcomes you on sunny days."
    ],
    "it": [
      "L'inattendu è un ristorante da 30/40 posti che serve cucina tradizionale. Una terrazza ombreggiata vi accoglie nella bella stagione."
    ],
    "fr": [
      "L'inattendu est un restaurant de 30/40 places qui propose une cuisine traditonnelle. Une terrasse ombragée vous accueille aux beaux jours."
    ],
    "nl": [
      "L'inattendu is een restaurant met 30/40 zitplaatsen dat traditionele gerechten serveert. Een schaduwrijk terras verwelkomt je bij mooi weer."
    ],
    "es": [
      "L'inattendu es un restaurante con capacidad para 30/40 comensales que sirve cocina tradicional. Una terraza a la sombra le da la bienvenida cuando hace buen tiempo."
    ]
  },
