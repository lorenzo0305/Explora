  "rdfs:comment": {
    "de": [
      "Das Hotel Volcan Sancy empfängt Sie in einer warmen und familiären Umgebung im Herzen des Regionalparks Volcans d'Auvergne. Es verfügt über 8 Zimmer ( Doppel-, Dreibett- und Familienzimmer)."
    ],
    "en": [
      "The Volcan Sancy hotel welcomes you in a warm and family atmosphere in the heart of the Parc Régional des Volcans d'Auvergne, 8 rooms (double, triple and family)."
    ],
    "it": [
      "L'hotel Volcan Sancy vi accoglie in un'atmosfera calda e familiare nel cuore del Parc Régional des Volcans d'Auvergne, con 8 camere (doppie, triple e familiari)."
    ],
    "fr": [
      "L’hôtel Volcan Sancy vous accueille dans un cadre chaleureux et familial au cœur du Parc Régional des Volcans d’Auvergne, 8 chambres ( doubles, triples et familiales)."
    ],
    "nl": [
      "Het hotel Volcan Sancy verwelkomt u in een warme en familiale sfeer in het hart van het Parc Régional des Volcans d'Auvergne, met 8 kamers (tweepersoons-, driepersoons- en familiekamers)."
    ],
    "es": [
      "El hotel Volcan Sancy le da la bienvenida en un ambiente cálido y familiar en el corazón del Parc Régional des Volcans d'Auvergne, con 8 habitaciones (dobles, triples y familiares)."
    ]
  },
  "rdfs:label": {
