  "rdfs:comment": {
    "de": [
      "Das Restaurant Atelier B bietet Gourmet-Burger, die zu 100% hausgemacht sind und aus Qualitätsprodukten bestehen, die in der Nähe des Restaurants ausgewählt werden, um kurze Wege zu bevorzugen."
    ],
    "en": [
      "The Restaurant Atelier B offers 100% homemade gourmet burgers with quality products selected as close as possible to the restaurant in order to favor short circuits."
    ],
    "it": [
      "Il ristorante Atelier B offre hamburger gourmet 100% fatti in casa con prodotti di qualità selezionati il più vicino possibile al ristorante per favorire i circuiti brevi."
    ],
    "fr": [
      "Le Restaurant Atelier B propose des burgers gourmets 100% maison avec des produits de qualité sélectionnés au plus près du restaurant afin de privilegier les circuits courts."
    ],
    "nl": [
      "Restaurant Atelier B biedt 100% huisgemaakte gourmetburgers met kwaliteitsproducten die zo dicht mogelijk bij het restaurant zijn geselecteerd om korte circuits te bevorderen."
    ],
    "es": [
      "El Restaurante Atelier B ofrece hamburguesas gastronómicas 100% caseras con productos de calidad seleccionados lo más cerca posible del restaurante para favorecer los circuitos cortos."
    ]
  },
