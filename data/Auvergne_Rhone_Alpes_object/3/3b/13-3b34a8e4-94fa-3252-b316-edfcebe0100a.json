  "rdfs:comment": {
    "de": [
      "Murmur et Nature, das sind 20 Jahre Erfahrung mit Aktivitäten in der freien Natur: Hochseilgarten, Via Ferrata, Nervenkitzelparcours, Seilrutschen, aber auch Kanu und Paddelboot... Es gibt etwas für die ganze Familie!"
    ],
    "en": [
      "Murmur and Nature, 20-year experience on climbing high rope courses."
    ],
    "it": [
      "Murmur et Nature vanta 20 anni di esperienza nelle attività all'aperto: tree climbing, via ferrata, thrill ride, zip line, ma anche canoa e paddle... C'è qualcosa per tutta la famiglia!"
    ],
    "fr": [
      "Murmur et Nature, c’est 20 ans d’expérience dans les activités de pleine nature : parcours accrobranche, via ferrata, parcours frisson, tyrolienne mais aussi canoë et paddle... Il y en a pour toute la famille !"
    ],
    "es": [
      "Murmur et Nature tiene 15 años de experiencia en los circuitos “accrobranche”."
    ],
    "nl": [
      "Murmur et Nature heeft 20 jaar ervaring in outdoor activiteiten: boomklimmen, via ferrata, thrill ride, zip line, maar ook kanoën en peddelen... Er is iets voor het hele gezin!"
    ]
  },
