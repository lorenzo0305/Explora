  "rdfs:comment": {
    "de": [
      "Vereinsbar: große Auswahl an Getränken und Tapas. Gastronomie vor Ort (traditionelle Gerichte, Weltküche) auf Reservierung.\nMehrere Räume: Bar, Konzertsaal, Glasdach und Garten."
    ],
    "en": [
      "Bar associative: wide range of drinks and tapas. Catering on site (traditional dishes, world cuisine) on reservation.\nSeveral areas: bar, concert hall, glass roof and garden."
    ],
    "it": [
      "Associazione bar: ampia scelta di bevande e tapas. Ristorazione in loco (piatti tradizionali, cucina mondiale) su prenotazione.\nDiverse aree: bar, sala concerti, tetto di vetro e giardino."
    ],
    "fr": [
      "Bar associatif : large panel de boissons et tapas. Restauration sur place (plats traditionnels, cuisine du monde) sur réservation.\nPlusieurs espaces : bar, salle de concert, verrière et jardin."
    ],
    "nl": [
      "Barvereniging: ruim assortiment dranken en tapas. Catering ter plaatse (traditionele gerechten, wereldkeuken) op reservering.\nVerschillende ruimtes: bar, concertzaal, glazen dak en tuin."
    ],
    "es": [
      "Asociación de bares: amplia gama de bebidas y tapas. Catering in situ (platos tradicionales, cocina del mundo) bajo reserva.\nVarios espacios: bar, sala de conciertos, techo de cristal y jardín."
    ]
