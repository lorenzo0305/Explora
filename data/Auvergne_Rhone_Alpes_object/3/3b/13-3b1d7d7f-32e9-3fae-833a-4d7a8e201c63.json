          "additionalInformation": {
            "de": [
              "Schmuck zum Verkauf:\n- in der Boutique l'Art et la Manière (in der Saison am WE und in den Ferien geöffnet, siehe Öffnungszeiten oben)\n- in den Tourismusbüros von St Pierre de Chartreuse und St Pierre d'Entremont (ganzjährig geöffnet)\n- im Atelier nur nach vorheriger Vereinbarung"
            ],
            "en": [
              "Jewelry for sale :\n- at the l'Art et la Manière boutique (open during the season on weekends and vacations, see opening hours above)\n- at St Pierre de Chartreuse and St Pierre d'Entremont tourist offices (open all year)\n- at the workshop by appointment only"
            ],
            "it": [
              "Vendita di gioielli :\n- presso il negozio l'Art et la Manière (aperto durante la stagione nei fine settimana e nei giorni festivi, vedi orari di apertura sopra)\n- presso gli uffici turistici di St Pierre de Chartreuse e St Pierre d'Entremont (aperti tutto l'anno)\n- presso il laboratorio su appuntamento"
            ],
            "fr": [
              "Bijoux en vente : \n- à la boutique l'Art et la Manière (ouverte en saison les WE et vacances, voir horaires ci-dessus)\n- aux offices du tourisme de St Pierre de Chartreuse et St Pierre d'Entremont (ouvert toute l'année)\n- à l'atelier sur RDV uniquement"
            ],
            "es": [
              "Venta de joyas :\n- en la tienda l'Art et la Manière (abierta durante la temporada los fines de semana y días festivos, ver horarios arriba)\n- en las oficinas de turismo de St Pierre de Chartreuse y St Pierre d'Entremont (abiertas todo el año)\n- en el taller con cita previa"
            ],
            "nl": [
              "Sieraden te koop :\n- in de winkel l'Art et la Manière (open tijdens het seizoen in het weekend en op feestdagen, zie openingstijden hierboven)\n- bij de VVV-kantoren in St Pierre de Chartreuse en St Pierre d'Entremont (het hele jaar geopend)\n- in het atelier, alleen op afspraak"
            ]
          },
