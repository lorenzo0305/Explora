  "rdfs:comment": {
    "de": [
      "Zweite Ausgabe des Black Box Club, präsentiert vom Kollektiv Bon.soir!\r\nHier gibt es keine Helden und keine Gesetzlosen. Nur der Klang, die Dunkelheit und die Spannung eines Duells, das bis in die frühen Morgenstunden andauert."
    ],
    "en": [
      "Second edition of Black Box Club presented by the Bon.soir collective!\r\nNo heroes, no outlaws. Just the sound, the darkness and the tension of a duel that lasts until dawn."
    ],
    "it": [
      "Seconda edizione del Black Box Club presentato dal collettivo Bon.soir!\r\nNiente eroi, niente fuorilegge. Solo il suono, l'oscurità e la tensione di un duello che dura fino all'alba."
    ],
    "fr": [
      "Deuxième édition de Black Box Club présentée par le collectif Bon.soir !\r\nIci pas de héros, pas de hors-la-loi. Seulement le son, l'obscurité et la tension d'un duel qui dure jusqu'au petit matin."
    ],
    "es": [
      "¡Segunda edición del Black Box Club presentado por el colectivo Bon.soir!\r\nNi héroes, ni forajidos. Sólo el sonido, la oscuridad y la tensión de un duelo que dura hasta el amanecer."
    ],
    "nl": [
      "Tweede editie van Black Box Club gepresenteerd door het Bon.soir collectief!\r\nGeen helden, geen bandieten. Alleen het geluid, de duisternis en de spanning van een duel dat duurt tot het ochtendgloren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "BON.SOIR présente : BLACK BOX CLUB : PENZER + HYPERLISON + YUNK"
    ]
  },
