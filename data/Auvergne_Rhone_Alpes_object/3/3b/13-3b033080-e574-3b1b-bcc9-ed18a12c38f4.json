  "rdfs:comment": {
    "de": [
      "Bei Savons du Léman stellen wir seit 2015 im Herzen des Großraums Genf mit Leidenschaft handgemachte Seifen her.\r\nAurore und ich stellen in Handarbeit außergewöhnliche feste Natur- und Biokosmetik her, die selbst empfindlichster Haut sofortiges Wohlbefinden verleiht."
    ],
    "en": [
      "At Savons du Léman, we've been passionately creating handcrafted soaps since 2015, in the heart of Greater Geneva.\r\nAurore and I handcraft exceptional natural and organic solid cosmetics, bringing immediate comfort to even the most sensitive skin."
    ],
    "it": [
      "Da Savons du Léman creiamo con passione saponi artigianali dal 2015, nel cuore della Grande Ginevra.\r\nAurore e io produciamo a mano eccezionali cosmetici solidi naturali e biologici, che donano un comfort immediato anche alle pelli più sensibili."
    ],
    "fr": [
      "Chez Savons du Léman, nous créons avec passion des savons artisanaux depuis 2015, au cœur du Grand Genève.\r\nAurore et moi fabriquons à la main, des cosmétiques solides naturels et bio d’exception, apportant un confort immédiat aux peaux les plus sensibles."
    ],
    "es": [
      "En Savons du Léman, creamos jabones artesanales con pasión desde 2015, en el corazón de la Gran Ginebra.\r\nAurore y yo elaboramos a mano excepcionales cosméticos sólidos naturales y ecológicos, que aportan un confort inmediato incluso a las pieles más sensibles."
    ],
    "nl": [
      "Bij Savons du Léman maken we sinds 2015 met passie handgemaakte zepen in het hart van Groot Genève.\r\nAurore en ik maken met de hand uitzonderlijke natuurlijke en biologische vaste cosmeticaproducten die zelfs de meest gevoelige huid onmiddellijk comfort bieden."
    ]
  },
