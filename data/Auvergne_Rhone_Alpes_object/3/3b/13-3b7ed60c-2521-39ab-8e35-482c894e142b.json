  "rdfs:comment": {
    "de": [
      "Das Val d'Arly und sein gleichnamiger Wildbach sind ideal, um in einer wunderschönen Berglandschaft, nur einen Steinwurf vom Mont Blanc entfernt, neue Energie zu tanken.\r\nWährend Sie diesen ein Kilometer langen Weg hinaufsteigen, trennen Sie sich allmählich von Siedlungen und Zivilisation."
    ],
    "en": [
      "The Val d'Arly and its eponymous torrent are ideal for recharging your batteries in a beautiful mountain setting just a stone's throw from Mont Blanc.\r\nAs you ascend this one-kilometer trail, you'll gradually disconnect from habitation and civilization."
    ],
    "it": [
      "La Val d'Arly e il suo omonimo torrente sono ideali per ricaricare le batterie in uno splendido scenario montano a due passi dal Monte Bianco.\r\nMentre risalite questo sentiero di un chilometro, vi separerete gradualmente dalle abitazioni e dalla civiltà."
    ],
    "fr": [
      "Le Val d'Arly et son torrent éponyme est idéal pour venir se ressourcer dans un joli cadre de montagne à deux pas du Mont-Blanc.\r\nEn remontant sur ce parcours d'un kilomètre, vous déconnecterez progressivement des habitations et de la civilisation."
    ],
    "es": [
      "El Val d'Arly y su torrente homónimo son el lugar perfecto para reponer fuerzas en un bello entorno de montaña a dos pasos del Mont Blanc.\r\nA medida que se asciende por el sendero de un kilómetro, se va desconectando poco a poco de los asentamientos y la civilización."
    ],
    "nl": [
      "De Val d'Arly en zijn gelijknamige bergstroom zijn ideaal om nieuwe energie op te doen in een prachtige bergachtige omgeving op een steenworp afstand van de Mont Blanc.\r\nTijdens de beklimming van deze route van een kilometer verbreekt u geleidelijk de verbinding met de bewoonde wereld."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstrecke \"Passion\" No-kill auf dem Fluss Arly in Flumet"
    ],
    "en": [
      "Passion\" No-kill fishing course on the Arly at Flumet"
    ],
    "it": [
      "Passione\" Pesca no-kill sull'Arly a Flumet"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" No-kill sur l'Arly à Flumet"
    ],
    "es": [
      "Passion\" Pesca sin muerte en el Arly en Flumet"
    ],
    "nl": [
      "Passie\" No-kill vissen op de Arly bij Flumet"
    ]
  },
