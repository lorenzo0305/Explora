  "rdfs:comment": {
    "de": [
      "Die Ferme du Rougequeue erstreckt sich über 5 Hektar und wird komplett biologisch bewirtschaftet. Alain baut von April bis Dezember Saisongemüse an und Marianne kümmert sich um die Hühner und die Beeren, Kräuter und verarbeiteten Produkte."
    ],
    "en": [
      "The Rougequeue farm covers 5 hectares, all of it organically farmed. Alain produces seasonal vegetables from April to December, and Marianne looks after the chickens, berries, herbs and processed products."
    ],
    "it": [
      "L'azienda agricola Rougequeue si estende su 5 ettari, tutti coltivati con metodo biologico. Alain produce ortaggi di stagione da aprile a dicembre, mentre Marianne si occupa di polli, bacche, erbe e prodotti trasformati."
    ],
    "fr": [
      "La ferme du Rougequeue s’étend sur 5 hectares, tout en Agriculture biologique. Alain produit des légumes de saison d’avril à décembre et Marianne s’occupe des poules et des petits fruits, des plantes aromatiques et des produits transformés."
    ],
    "es": [
      "La granja Rougequeue ocupa 5 hectáreas, todas ellas de agricultura ecológica. Alain produce verduras de temporada de abril a diciembre, y Marianne se ocupa de las gallinas, las bayas, las hierbas y los productos transformados."
    ],
    "nl": [
      "De boerderij in Rougequeue beslaat 5 hectare, allemaal biologisch bewerkt. Alain produceert seizoensgroenten van april tot december en Marianne zorgt voor de kippen, bessen, kruiden en verwerkte producten."
    ]
  },
