  "rdfs:comment": {
    "de": [
      "Landos: Kirche aus dem 12. Jahrhundert mit Kammglockenturm, romanischem Portal und Wandmalereien. Sehr reiche Natur- und Vulkanlandschaften mit 3 großen Sumpfgebieten: Landos, Pratclaux und La Sauvetat. Entdeckungspfade (freier Zugang) zu den Narces de La Sauvetat."
    ],
    "en": [
      "Landos: 12th-century church with combed bell tower, Romanesque portal and murals. Natural and volcanic sites with 3 large marshes: Landos, Pratclaux and La Sauvetat. Discovery trails (free access) at Les Narces de La Sauvetat."
    ],
    "it": [
      "Landos: chiesa del XII secolo con campanile a pettine, portale romanico e dipinti murali. Siti naturali e vulcanici molto ricchi con 3 grandi paludi: Landos, Pratclaux e La Sauvetat. Percorsi di scoperta (accesso gratuito) a Les Narces de La Sauvetat."
    ],
    "fr": [
      "Landos : Église du XIIe siècle avec clocher peigne, portail roman et peintures murales. Sites naturels et volcaniques très riches avec 3 grands marais : Landos, Pratclaux et La Sauvetat. Sentiers découverte (accès libre) aux Narces de La Sauvetat."
    ],
    "es": [
      "Landos: iglesia del siglo XII con campanario peinado, portal románico y pinturas murales. Sitios naturales y volcánicos muy ricos con 3 grandes marismas: Landos, Pratclaux y La Sauvetat. Senderos de descubrimiento (acceso libre) en Les Narces de La Sauvetat."
    ],
    "nl": [
      "Landos: 12e-eeuwse kerk met gekamde klokkentoren, Romaans portaal en muurschilderingen. Zeer rijke natuurlijke en vulkanische sites met 3 grote moerassen: Landos, Pratclaux en La Sauvetat. Ontdekkingspaden (gratis toegang) bij Les Narces de La Sauvetat."
    ]
  },
  "rdfs:label": {
