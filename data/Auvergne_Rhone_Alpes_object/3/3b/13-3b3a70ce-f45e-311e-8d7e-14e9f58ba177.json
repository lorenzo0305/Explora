  "rdfs:comment": {
    "de": [
      "Eine Strecke, auf der sich Wälder und Forste abwechseln: Bois de Malaval, Balvay, des Pierrets, du Charpeney, de Marmont, Villard und die Wälder von L'Ange, Chareyziat.\r\nAuf dem Weg: Teiche, Pferde, Bauernhöfe...\r\nZwei Rundwege: 35 km oder 21 km"
    ],
    "en": [
      "A trail of woods and forests: Bois de Malaval, Balvay, des Pierrets, du Charpeney, de Marmont, Villard and the forests of L'Ange and Chareyziat.\r\nAlong the way, ponds, horses, farms...\r\nTwo loops: 35 km or 21 km"
    ],
    "it": [
      "Un percorso di boschi e foreste: Malaval, Balvay, Pierrets, Charpeney, Marmont, Villard e le foreste di L'Ange e Chareyziat.\r\nLungo il percorso, stagni, cavalli, fattorie...\r\nDue percorsi: 35 km o 21 km"
    ],
    "fr": [
      "Un parcours ou se succèdent Bois et Forêts : Bois de Malaval, Balvay, des Pierrets, du Charpeney, de Marmont, Villard et les forêts de L'Ange, Chareyziat.\r\nSur le chemin, des étangs, des chevaux, des fermes...\r\nDeux boucles : 35 km ou 21 km"
    ],
    "es": [
      "Un sendero de bosques y selvas: Malaval, Balvay, Pierrets, Charpeney, Marmont, Villard y los bosques de L'Ange y Chareyziat.\r\nPor el camino, estanques, caballos, granjas...\r\nDos circuitos: 35 km o 21 km"
    ],
    "nl": [
      "Een parcours door bossen en wouden: Malaval, Balvay, Pierrets, Charpeney, Marmont, Villard en de bossen van L'Ange en Chareyziat.\r\nOnderweg vijvers, paarden, boerderijen...\r\nTwee lussen: 35 km of 21 km"
    ]
  },
  "rdfs:label": {
    "en": [
      "VTTAE circuit n°6 (red) Chemins des bois de Bresse"
    ],
    "fr": [
      "Circuit VTTAE n°6 (rouge) Chemins des bois de Bresse"
    ]
  },
