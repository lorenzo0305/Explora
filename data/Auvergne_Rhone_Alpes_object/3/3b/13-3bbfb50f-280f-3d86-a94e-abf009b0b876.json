  "rdfs:comment": {
    "de": [
      "Der neue Radweg, der Moûtiers mit Aigueblanche in der Tarentaise verbindet, ist Fahrrädern (Rennrädern, Mountainbikes, Elektrofahrrädern ...) gewidmet."
    ],
    "en": [
      "The new cycle path linking Moûtiers to Aigueblanche in the Tarentaise region is dedicated to bicycles (road bikes, mountain bikes, electric bikes, etc.)."
    ],
    "it": [
      "La nuova pista ciclabile che collega Moûtiers ad Aigueblanche, nella regione della Tarentaise, è dedicata alle biciclette (da strada, mountain bike, elettriche, ecc.)."
    ],
    "fr": [
      "La nouvelle piste cyclable reliant Moûtiers à Aigueblanche en Tarentaise, est dédiée aux vélos (vélos de route, VTT, vélos électriques ...)."
    ],
    "nl": [
      "Het nieuwe fietspad tussen Moûtiers en Aigueblanche in de Tarentaise regio is bestemd voor fietsen (racefietsen, mountainbikes, elektrische fietsen, enz.)."
    ],
    "es": [
      "El nuevo carril bici que une Moûtiers con Aigueblanche, en la región de la Tarentaise, está dedicado a las bicicletas (de carretera, de montaña, eléctricas, etc.)."
