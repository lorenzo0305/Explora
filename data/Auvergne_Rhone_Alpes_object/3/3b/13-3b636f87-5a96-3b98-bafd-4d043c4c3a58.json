  "rdfs:comment": {
    "de": [
      "Wir werden einen Hauch von Freiheit spüren - das nationale Thema dieses Jahres! Auch in Nyons werden wir die Freiheit, die Freiheiten, sprechen, rezitieren, slammen und singen hören, mit einem reichhaltigen und vielfältigen Veranstaltungsprogramm."
    ],
    "en": [
      "We're going to breathe a breath of Freedom - the national theme chosen this year! In Nyons, too, we're going to hear people talking, reciting, slamming and singing about freedom and liberty, with a rich and varied program of events."
    ],
    "it": [
      "Respireremo una brezza di libertà, il tema nazionale scelto quest'anno! Anche a Nyons sentiremo parlare, recitare, sbattere e cantare di libertà e libertà, con un programma ricco e variegato di eventi."
    ],
    "fr": [
      "Nous allons humer un vent de Liberté - thématique nationale retenue cette année ! À Nyons aussi nous allons entendre parler, réciter, slammer, chanter la liberté, les libertés, avec un programme d’animations riches et variées."
    ],
    "nl": [
      "We gaan een briesje vrijheid inademen - het nationale thema dat dit jaar gekozen is! Ook in Nyons zullen we mensen horen praten, voordragen, slaan en zingen over vrijheid en vrijheid, met een rijk en gevarieerd evenementenprogramma."
    ],
    "es": [
      "Vamos a respirar una brisa de libertad: ¡el tema nacional elegido este año! También en Nyons oiremos hablar, recitar, aporrear y cantar a la libertad, con un rico y variado programa de actos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Printemps des Poètes"
    ]
  },
