  "rdfs:comment": {
    "de": [
      "In der Domaine d'Epeyssoles, zwei Kilometer vom Village Blanc in Vonnas im Departement Ain entfernt, befindet sich das Restaurant La Terrasse des Étangs."
    ],
    "en": [
      "Located in the heart of the Domaine d'Épeyssoles, the Terrasse des Étangs restaurant is housed in a beautiful glass roof adjoining the château.\r\nBetween the two ponds, it offers a breathtaking view of the entire park, with its centuries-old trees."
    ],
    "it": [
      "A due chilometri dal Village Blanc di Vonnas, nella regione dell'Ain, il Domaine d'Epeyssoles ospita il ristorante La Terrasse des Étangs, immerso nel cuore di uno splendido tetto di vetro, inondato di luce naturale, adiacente al castello."
    ],
    "fr": [
      "À deux kilomètres du Village Blanc à Vonnas dans l’Ain, le Domaine d’Epeyssoles abrite le restaurant La Terrasse des Étangs, niché au cœur d’une belle verrière, baignée de lumière naturelle, attenante au château."
    ],
    "nl": [
      "Op twee kilometer van Village Blanc in Vonnas in de regio Ain ligt het restaurant La Terrasse des Étangs op het Domaine d'Epeyssoles, genesteld in het hart van een prachtig glazen dak, badend in natuurlijk licht, grenzend aan het kasteel."
    ],
    "es": [
      "A dos kilómetros del Village Blanc de Vonnas, en la región de Ain, el Domaine d'Epeyssoles alberga el restaurante La Terrasse des Étangs, enclavado en el corazón de una hermosa cubierta acristalada, bañada de luz natural, contigua al castillo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Terrasse des Etangs"
    ]
  },
