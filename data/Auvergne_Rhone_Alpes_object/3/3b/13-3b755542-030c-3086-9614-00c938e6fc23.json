        {
          "@id": "https://data.datatourisme.fr/39e54967-bca9-30e6-969b-bcf44386bd13",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Mittwoch bis Samstag von 12:15 bis 13:45 Uhr und von 19:15 bis 20:45 Uhr geöffnet.\r\nSonntags von 12:15 bis 13:45 Uhr geöffnet.\r\nAm Sonntagabend geschlossen.\r\nSamstags und sonntags geschlossen, wenn die Domaine für Hochzeitsempfänge privatisiert wird.\r\nReservierung empfohlen."
            ],
            "en": [
              "Open Wednesday to Saturday, 12:15 to 1:45pm and 7:15 to 8:45pm.\r\nOpen Sunday from 12.15pm to 1.45pm.\r\nClosed Sunday evening.\r\nClosed on Saturdays and Sundays when the Domaine is privatized for wedding receptions.\r\nReservations recommended."
            ],
            "it": [
              "Aperto dal mercoledì al sabato dalle 12.15 alle 13.45 e dalle 19.15 alle 20.45.\r\nDomenica aperto dalle 12.15 alle 13.45.\r\nChiuso la domenica sera.\r\nChiuso il sabato e la domenica quando la tenuta è utilizzata per ricevimenti nuziali.\r\nSi consiglia la prenotazione."
            ],
            "fr": [
              "Ouvert du mercredi au samedi de 12h15 à 13h45 et de 19h15 à 20h45.\r\nOuvert le dimanche de 12h15 à 13h45.\r\nFermé le Dimanche soir.\r\nFermeture le samedi et dimanche lorsque le Domaine est privatisé pour des réceptions de mariage. \r\nRéservation conseillée."
            ],
            "nl": [
              "Geopend van woensdag tot zaterdag van 12.15 tot 13.45 en van 19.15 tot 20.45.\r\nZondag geopend van 12.15 tot 13.45 uur.\r\nGesloten op zondagavond.\r\nGesloten op zaterdag en zondag wanneer het landgoed wordt gebruikt voor bruiloftsrecepties.\r\nReserveren aanbevolen."
            ],
            "es": [
              "Abierto de miércoles a sábado de 12.15 h a 13.45 h y de 19.15 h a 20.45 h.\r\nDomingos de 12.15 a 13.45 h.\r\nCerrado los domingos por la noche.\r\nCerrado los sábados y domingos en que se celebran bodas.\r\nSe recomienda reservar."
            ]
          },
