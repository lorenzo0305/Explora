      "dc:description": {
        "de": [
          "Bringen Sie Ihre solidarischen Socken mit nach Hause, um Ihre kleinen Figuren zu basteln und dabei zu recyceln und etwas für unseren Planeten zu tun."
        ],
        "en": [
          "Bring back your solidarity socks to make your own little characters while recycling and doing something for the planet."
        ],
        "it": [
          "Riportate i vostri calzini solidali per creare i vostri piccoli personaggi, riciclando e facendo qualcosa per il pianeta."
        ],
        "fr": [
          "Ramener vos chaussettes solidaires pour réaliser vos petits personnages tout en recyclant et faisant un geste pour la planète."
        ],
        "es": [
          "Trae tus calcetines solidarios para hacer tus propios personajillos mientras reciclas y haces algo por el planeta."
        ],
        "nl": [
          "Neem je solidariteitssokken mee om je eigen figuurtjes te maken terwijl je recycleert en iets doet voor de planeet."
        ]
      },
