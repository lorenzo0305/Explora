  "rdfs:comment": {
    "de": [
      "Der Verein O'Fil d'Ance & Co organisiert ein Bingo.\r\nEine einzige Linie horizontal, vertikal, diagonal oder alle vier Ecken und Sie haben gewonnen!\r\nEs gibt zahlreiche Preise zu gewinnen.\r\nKleine Snacks und Getränke vor Ort."
    ],
    "en": [
      "The association O'Fil d'Ance & Co is organizing a Bingo.\r\nA single line - horizontal, vertical, diagonal or all four corners - and you win!\r\nLots of prizes to be won.\r\nSnacks and refreshments on site."
    ],
    "it": [
      "L'associazione O'Fil d'Ance & Co organizza una tombola.\r\nBasta una riga - orizzontale, verticale, diagonale o ai quattro angoli - e si vince!\r\nIn palio numerosi premi.\r\nSnack e rinfreschi disponibili sul posto."
    ],
    "fr": [
      "L'association O'Fil d'Ance & Co organise un Bingo.\r\nUne seule ligne horizontale, verticale, en diagonale ou les quatre coins et c'est gagné !\r\nDe nombreux lots sont à gagner.\r\nPetite restauration et buvette sur place."
    ],
    "es": [
      "La asociación O'Fil d'Ance & Co organiza un Bingo.\r\nUna sola línea -horizontal, vertical, diagonal o en las cuatro esquinas- ¡y ganas!\r\nMuchos premios.\r\nAperitivos y refrescos in situ."
    ],
    "nl": [
      "De vereniging O'Fil d'Ance & Co organiseert een Bingo.\r\nEén regel - horizontaal, verticaal, diagonaal of alle vier de hoeken - en je wint!\r\nEr zijn veel prijzen te winnen.\r\nSnacks en drankjes ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bingo"
    ]
  },
