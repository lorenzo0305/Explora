  "rdfs:comment": {
    "de": [
      "Die Auberge de Ceilloux bietet eine traditionelle, neu interpretierte Küche der Auvergne, die von lokalen und saisonalen Produkten begleitet wird.\r\nDie Weinkarte ist klein, passt aber am besten zu den vor Ort gekochten Gerichten."
    ],
    "en": [
      "Terrines, poultry meat, roasts and so on. \r\nFood is prepared in the wood-fired oven as well as bread and pastries ! Everything here is prepared on the premises with fresh and local products. Open Monday and Friday evenings and Saturday and Sunday all day."
    ],
    "it": [
      "L'Auberge de Ceilloux propone una cucina tradizionale dell'Alvernia con un tocco di classe, utilizzando prodotti locali e di stagione.\r\nLa carta dei vini è piccola, ma si adatta al meglio ai piatti cucinati in loco."
    ],
    "fr": [
      "L’Auberge de Ceilloux propose une cuisine traditionnelle Auvergnate revisitée, accompagnée de produits locaux et de saison.\r\nLa carte des vins est petite mais elle s'adapte le mieux aux plats cuisiné sur place."
    ],
    "es": [
      "El Auberge de Ceilloux sirve cocina tradicional de Auvernia con un toque especial, utilizando productos locales de temporada.\r\nLa carta de vinos es reducida, pero se adapta perfectamente a los platos cocinados en el establecimiento."
    ],
    "nl": [
      "Auberge de Ceilloux serveert traditionele gerechten uit de Auvergne met een twist, waarbij gebruik wordt gemaakt van lokale, seizoensgebonden producten.\r\nDe wijnkaart is klein, maar past goed bij de gerechten die ter plekke worden bereid."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ceilloux's restaurant"
    ],
    "fr": [
      "L'Auberge de Ceilloux"
    ]
  },
