  "rdfs:comment": {
    "de": [
      "Vom Rebstock bis zur Flasche setzt die Kellerei Monge Granon ihr ganzes Können und ihre Leidenschaft ein, um Ihnen ihre schönsten Bläschen anzubieten."
    ],
    "en": [
      "La Cave Monge Granon puts all its know-how and passion into offering you the finest bubbles from the vinestock to the bottle."
    ],
    "it": [
      "Dalla vigna alla bottiglia, la cantina Monge Granon mette tutto il suo know-how e la sua passione per offrirvi le sue migliori bollicine."
    ],
    "fr": [
      "Du cep à la bouteille, la cave Monge Granon met tout son savoir-faire et sa passion pour vous offrir ses plus belles bulles."
    ],
    "nl": [
      "Van de wijnstok tot de fles, de wijnkelder Monge Granon zet zich met passie en expertise in om u hun mooiste bubbels aan te bieden."
    ],
    "es": [
      "De la vid a la botella, la bodega Monge Granon pone todo su saber hacer y su pasión para ofrecerle sus mejores burbujas."
    ]
  },
