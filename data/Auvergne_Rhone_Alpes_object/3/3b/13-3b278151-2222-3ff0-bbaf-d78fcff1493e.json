  "rdfs:comment": {
    "de": [
      "Als Hanfbauer und -verarbeiter entwickelt er aus seinen Ernten eine Reihe von Lebensmitteln (Samen, natives Öl, Mehl), biologischen und natürlichen Pflege- und Kosmetikprodukten sowie Produkten für die Isolierung, den Garten oder die Tierhaltung."
    ],
    "en": [
      "A hemp grower and processor, he uses his harvests to develop a range of food products (seeds, virgin oil, flour), organic and natural skincare and cosmetics, as well as products for insulation, the garden and animals."
    ],
    "it": [
      "Produttore e trasformatore di canapa, utilizza i suoi raccolti per sviluppare una gamma di prodotti alimentari (semi, olio vergine, farina), prodotti per la pelle e cosmetici biologici e naturali, nonché prodotti per l'isolamento, il giardino e gli animali."
    ],
    "fr": [
      "Producteur et transformateur de chanvre, il développe à partir de ses récoltes une gamme de produits alimentaires (graines, huile vierge, farine), de soins et cosmétiques bio et naturels, ainsi que des produits pour l’isolation, le jardin ou les animaux."
    ],
    "es": [
      "Productor y transformador de cáñamo, utiliza sus cosechas para elaborar una gama de productos alimentarios (semillas, aceite virgen, harina), cosméticos y cuidados de la piel ecológicos y naturales, así como productos para el aislamiento, el jardín y los animales."
    ],
    "nl": [
      "Als producent en verwerker van hennep gebruikt hij zijn oogst om een reeks voedingsproducten (zaden, vierge olie, meel), biologische en natuurlijke huidverzorging en cosmetica te ontwikkelen, evenals producten voor isolatie, de tuin en dieren."
    ]
  },
  "rdfs:label": {
