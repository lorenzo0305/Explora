  "rdfs:comment": {
    "de": [
      "Spiraline ist eine Marke für bäuerliche Spirulina, die im Schutz von 1 300 m2 Gewächshäusern produziert wird. Spirulina wird von Frühjahr bis Herbst in flachen Wasserbecken gezüchtet, da sie Wärme und Licht zum Gedeihen benötigt."
    ],
    "en": [
      "Spiraline is a brand of spirulina produced in 1,300 m2 of greenhouses. Spirulina is grown in shallow water basins from spring to autumn, as it needs heat and light to develop."
    ],
    "it": [
      "Spiraline è un marchio di spirulina contadina prodotta in 1.300 m2 di serre. La spirulina viene coltivata in bacini d'acqua poco profondi dalla primavera all'autunno, poiché ha bisogno di calore e luce per svilupparsi."
    ],
    "fr": [
      "Spiraline est une marque de spiruline paysanne produite à l’abri de 1 300 m2 de serres. La spiruline est cultivée dans des bassins d’eau peu profonds du printemps à l’automne, car elle a besoin de chaleur et de lumière pour se développer."
    ],
    "nl": [
      "Spiraline is een merk van zelfgekweekte spirulina, geproduceerd in 1300 m2 kassen. Spirulina wordt gekweekt in ondiepe waterbekkens van de lente tot de herfst, omdat het warmte en licht nodig heeft om zich te ontwikkelen."
    ],
    "es": [
      "Spiraline es una marca de espirulina campesina producida en 1.300 m2 de invernaderos. La espirulina se cultiva en cuencas de agua poco profundas desde la primavera hasta el otoño, ya que necesita calor y luz para desarrollarse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spiraline : production de spiruline"
    ]
  },
