      "@id": "https://data.datatourisme.fr/8fde23a8-f134-348a-89b0-ea76c81d4863",
      "dc:description": {
        "de": [
          "Ausleihe von Büchern und CDs an die Einwohner des Departements. Bibliobus-Service für die Bibliotheken im Westen des Departements. Schulung von Bibliotheksleitern des BDS-Netzwerks. Animationen - Ausstellungen."
        ],
        "en": [
          "Lending books and CDs to the inhabitants of the department. Bookmobile service to libraries in the west of the department. Training of the managers of the libraries of the BDS network. Animations - Exhibitions."
        ],
        "it": [
          "Prestito di libri e CD agli abitanti del dipartimento. Servizio di Bookmobile per le biblioteche della zona ovest del dipartimento. Formazione per i responsabili delle biblioteche della rete BDS. Animazioni - Mostre."
        ],
        "fr": [
          "Prêtes de livres et de CD aux habitants du département. Desserte par bibliobus aux bibliothèques de l'Ouest du département. Formation des gestionaires des bibliothèques du réseau de la BDS. Animations - Expositions."
        ],
        "nl": [
          "Uitlenen van boeken en cd's aan de inwoners van de afdeling. Boekmobielservice naar bibliotheken in het westen van het departement. Opleiding voor de beheerders van de bibliotheken in het BDS-netwerk. Animaties - Tentoonstellingen."
        ],
        "es": [
          "Préstamo de libros y CDs a los habitantes del departamento. Servicio de bibliobús a las bibliotecas del oeste del departamento. Formación para los gestores de las bibliotecas de la red de SDE. Animaciones - Exposiciones."
        ]
      },
