  "rdfs:comment": {
    "de": [
      "Magali Durantet hat das Land ihres Vaters in den Bergen von Bourbonnaise geerbt? Die Wälder, durch die sie als Kind mit ihm gewandert ist, sind heute noch in ihrem Besitz."
    ],
    "en": [
      "Magali Durantet inherited her father's land in the Bourbonnais mountains? Woods she walked with him as a child."
    ],
    "it": [
      "Magali Durantet ha ereditato la terra del padre sulle montagne del Bourbonnais? Boschi che ha percorso con lui da bambina."
    ],
    "fr": [
      "Magali Durantet a hérité des terres de son père en montagne bourbonnaise… Des bois qu’elle a arpenté avec lui quand elle était petite."
    ],
    "es": [
      "Magali Durantet heredó las tierras de su padre en las montañas de Bourbonnais? Bosques que recorrió con él de niña."
    ],
    "nl": [
      "Magali Durantet erfde het land van haar vader in de bergen van Bourbonnais? Bossen waar ze als kind met hem wandelde."
    ]
