  "rdfs:comment": {
    "de": [
      "Für einen Abend erstrahlt das Haus des Leutnants in einer Atmosphäre aus einer anderen Zeit und enthüllt seinen Besuchern einige seiner kleinen Geheimnisse."
    ],
    "en": [
      "For the space of an evening, the Lieutenant?s house takes on an atmosphere from another era, and reveals some of its little secrets to visitors."
    ],
    "it": [
      "Per lo spazio di una serata, la casa del tenente assume un'atmosfera d'altri tempi e svela ai visitatori alcuni dei suoi piccoli segreti."
    ],
    "fr": [
      "L’espace d’une soirée, la maison du Lieutenant retrouve une ambiance d’un autre temps et révèle à ses visiteurs quelques-uns de ses petits secrets."
    ],
    "es": [
      "Por espacio de una velada, la casa del Teniente adquiere una atmósfera de otra época y revela algunos de sus pequeños secretos a los visitantes."
    ],
    "nl": [
      "Een avond lang ademt het huis van de luitenant de sfeer van een ander tijdperk en geeft het enkele van zijn kleine geheimen prijs aan bezoekers."
    ]
  },
  "rdfs:label": {
