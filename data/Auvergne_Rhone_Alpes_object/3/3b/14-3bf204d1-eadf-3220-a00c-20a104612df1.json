      "@id": "https://data.datatourisme.fr/83754d59-2bea-3cdf-809b-721a463288b4",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Freitag: 7.30-12 Uhr / 16.30-19 Uhr\nSamstag: 8h-12h\n\nMontag und Sonntag geschlossen\n\nAbholung :\n\nZu den Öffnungszeiten des Geschäfts\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Friday: 7h30-12h / 16h30-19h\nSaturday: 8am-12pm\n\nClosed on Mondays and Sundays\n\nCollection :\n\nDuring store opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a venerdì: 7.30-12.00 / 16.30-19.00\nSabato: 8.00-12.00\n\nChiuso il lunedì e la domenica\n\nRaccolta :\n\nDurante gli orari di apertura del negozio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\n\nDu mardi au vendredi: 7h30-12h / 16h30-19h\nLe samedi: 8h-12h\n\nFermeture le lundi et le dimanche\n\nRetrait :\n\nAux horaires d'ouverture du magasin\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag tot vrijdag: 7u30-12u / 16u30-19u\nZaterdag: 8u-12u\n\nGesloten op maandag en zondag\n\nAfhalen :\n\nTijdens winkelopeningstijden\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a viernes: 7h30-12h00 / 16h30-19h00\nSábado: 8h-12h\n\nCerrado los lunes y domingos\n\nRecogida :\n\nDurante el horario de apertura de la tienda\n\n "
        ]
      },
