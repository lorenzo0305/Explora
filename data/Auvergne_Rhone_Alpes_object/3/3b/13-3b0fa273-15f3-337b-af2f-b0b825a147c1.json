  "rdfs:comment": {
    "de": [
      "Jedes Foto wird mit einer während des Workshops entworfenen Stickerei veredelt, die von einer digitalen Stickmaschine in Sekundenschnelle hergestellt wird."
    ],
    "en": [
      "Each photo will be enhanced with an embroidery designed during the workshop, and produced in seconds by a digital embroidery machine."
    ],
    "it": [
      "Ogni foto sarà impreziosita da un ricamo disegnato durante il workshop e realizzato in pochi secondi da una macchina da ricamo digitale."
    ],
    "fr": [
      "Chaque photo sera rehaussée d'une broderie dessinée pendant l'atelier, et fabriquée en quelques secondes par une brodeuse numérique."
    ],
    "nl": [
      "Elke foto wordt versierd met een borduurwerk dat tijdens de workshop wordt ontworpen en in slechts enkele seconden wordt gemaakt door een digitale borduurmachine."
    ],
    "es": [
      "Cada foto se adornará con un bordado diseñado durante el taller y realizado en pocos segundos por una máquina de bordado digital."
    ]
