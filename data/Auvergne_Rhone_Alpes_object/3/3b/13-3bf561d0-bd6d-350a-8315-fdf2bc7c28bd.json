  "rdfs:comment": {
    "de": [
      "Im Massiv des Grand Colombier, im Chalet d'Arvières auf 1200 m Höhe, regionale Küche mit aromatischen Pflanzen aus dem botanischen Garten und Wildkräutern. Ruhiger Rahmen mit Blick auf das Valromey."
    ],
    "en": [
      "In the Grand Colombier massif, in the Chalet d'Arvières at 1200 metres, local cuisine with aromatic plants from the botanical garden and wild plants. Peaceful setting with views over the Valromey."
    ],
    "it": [
      "Nel massiccio del Grand Colombier, nello Chalet d'Arvières a 1200 metri, cucina locale con piante aromatiche del giardino botanico e piante selvatiche. Ambiente tranquillo con vista sulla Valromey."
    ],
    "fr": [
      "Dans le massif du Grand Colombier, au Chalet d'Arvières à 1200 mètres,  cuisine du terroir aux plantes aromatiques du jardin botanique et aux plantes sauvages. Cadre au calme avec vue sur le Valromey."
    ],
    "nl": [
      "In het Grand Colombier massief, in het Chalet d'Arvières op 1200 meter, lokale keuken met aromatische planten uit de botanische tuin en wilde planten. Rustige omgeving met uitzicht over de Valromey."
    ],
    "es": [
      "En el macizo del Grand Colombier, en el Chalet d'Arvières a 1200 metros, cocina local con plantas aromáticas del jardín botánico y plantas silvestres. Entorno tranquilo con vistas al Valromey."
    ]
  },
