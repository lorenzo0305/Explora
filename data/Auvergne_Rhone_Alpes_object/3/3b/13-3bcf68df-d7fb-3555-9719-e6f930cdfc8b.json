  "rdfs:comment": {
    "de": [
      "Kirche aus dem 12. Jahrhundert, die im 15. und 18. Jahrhundert restauriert wurde. 1895 wurde sie entweiht. Sie ist im Zusatzinventar der historischen Denkmäler eingetragen."
    ],
    "en": [
      "This 12th-century church, restored in the 15th and 18th centuries, was decommissioned in 1895. It is listed in the supplementary inventory of historical monuments."
    ],
    "it": [
      "Questa chiesa del XII secolo, restaurata nel XV e XVIII secolo, è stata dismessa nel 1895. È inserita nell'inventario supplementare dei monumenti storici."
    ],
    "fr": [
      "Eglise du XIIème siècle, restaurée au XVème et XVIIIème siècle, elle a été désaffectée en 1895. Elle est inscrite à l'inventaire supplémentaire des monuments historiques."
    ],
    "es": [
      "Esta iglesia del siglo XII, restaurada en los siglos XV y XVIII, quedó en desuso en 1895. Está inscrita en el inventario suplementario de monumentos históricos."
    ],
    "nl": [
      "Deze kerk uit de 12e eeuw, gerestaureerd in de 15e en 18e eeuw, werd in 1895 buiten gebruik gesteld. Ze staat op de aanvullende inventaris van historische monumenten."
    ]
  },
