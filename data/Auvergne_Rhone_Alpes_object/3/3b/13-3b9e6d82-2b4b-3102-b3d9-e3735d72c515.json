  "rdfs:comment": {
    "de": [
      "Kurse ab 4 Jahren, Ausritte und Wanderungen. Möglichkeit, das ganze Jahr über zu reiten, auch ohne Abonnement. Erstes Reiten auf Ponys. Ablegen von Prüfungen und Teilnahme an Wettbewerben."
    ],
    "en": [
      "Hacks and treks - Horse riding available all year round, even for non-members - Introduction to ponies - Exam preparation"
    ],
    "it": [
      "Lezioni a partire dai 4 anni, passeggiate ed escursioni. Possibilità di cavalcare tutto l'anno, anche senza abbonamento. Introduzione ai pony. Esami e concorsi federali."
    ],
    "fr": [
      "Cours dès 4 ans, balades et randonnées. Possibilité de pratiquer l’équitation toute l’année même sans abonnement. Baptêmes à poneys. Passage d'examens fédéraux et sorties en concours."
    ],
    "nl": [
      "Lessen vanaf 4 jaar, ritten en excursies. Paardrijden kan het hele jaar door, ook zonder abonnement. Kennismaking met pony's. Federale examens en wedstrijden."
    ],
    "es": [
      "Clases a partir de 4 años, paseos y excursiones. Equitación disponible todo el año, incluso sin abono. Iniciación a los ponis. Exámenes federales y concursos."
    ]
  },
