  "rdfs:comment": {
    "de": [
      "In der dritten Septemberwoche kleidet sich die Oberstadt von Le Puy-en-Velay in ihre schönsten Renaissancefarben und lässt Sie ein 16. Jahrhundert in Lebensgröße erleben!"
    ],
    "en": [
      "During the 3rd week of September, the upper town of Le Puy-en-Velay will be decked out in its finest Renaissance colors to bring you back to life in a life-size 16th century!"
    ],
    "it": [
      "Durante la terza settimana di settembre, la città alta di Le Puy-en-Velay sarà addobbata con i suoi più bei colori rinascimentali per farvi tornare a grandezza naturale nel XVI secolo!"
    ],
    "fr": [
      "La 3e semaine de septembre, la haute-ville du Puy-en-Velay revêt ses plus belles couleurs Renaissance pour vous faire revivre un 16ème siècle grandeur nature !"
    ],
    "nl": [
      "Tijdens de 3e week van september wordt de bovenstad van Le Puy-en-Velay aangekleed in haar mooiste renaissancekleuren om je mee te nemen naar een levensechte 16e eeuw!"
    ],
    "es": [
      "Durante la 3ª semana de septiembre, la parte alta de la ciudad de Le Puy-en-Velay se engalanará con sus mejores colores renacentistas para trasladarle a un siglo XVI de tamaño natural"
    ]
  },
  "rdfs:label": {
    "fr": [
