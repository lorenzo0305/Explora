  "rdfs:comment": {
    "de": [
      "Zwischen Brasserie und typischen savoyischen Gerichten\r\nGenießen Sie mittags ihre Brasserie-Karte.\r\nAbends können Sie sich mit ihrer savoyischen Karte verwöhnen lassen."
    ],
    "en": [
      "Between brasserie and typical Savoyard dishes\r\nAt lunchtime, enjoy their brasserie menu.\r\nIn the evening, treat yourself to their Savoyard menu."
    ],
    "it": [
      "Brasserie e piatti tipici savoiardi\r\nA pranzo, gustate il menu della brasserie.\r\nLa sera, concedetevi il menù savoiardo."
    ],
    "fr": [
      "Entre brasserie et plats typiques savoyards\r\nLe midi, savourez leur carte brasserie.\r\nLe soir, régalez-vous avec leur carte savoyarde."
    ],
    "nl": [
      "Tussen brasserie en typische Savoyaardse gerechten\r\nGeniet 's middags van hun brasseriekaart.\r\n's Avonds kunt u zich tegoed doen aan hun Savoyaardse kaart."
    ],
    "es": [
      "Brasserie y platos típicos de Saboya\r\nAl mediodía, disfrute de su menú de brasserie.\r\nPor la noche, deléitese con su menú saboyano."
    ]
