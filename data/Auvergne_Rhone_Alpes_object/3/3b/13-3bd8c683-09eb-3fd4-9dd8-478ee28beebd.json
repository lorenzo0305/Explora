  "rdfs:comment": {
    "de": [
      "Das Bad \"le Petit Bois\" ist ein echtes Familenschwimmbad in entspanntem Rahmen mit wunderbarem Blick auf die Berge des Forez."
    ],
    "en": [
      "In a peaceful setting, the Petit Bois is a swimming pool perfect for families. It has a beautiful view on the \"Monts du Forez\"."
    ],
    "it": [
      "Le Petit Bois è una piscina per famiglie che gode di un ambiente tranquillo con una magnifica vista sui Monts du Forez."
    ],
    "fr": [
      "Le Petit Bois est une piscine familiale qui jouit d’un cadre paisible grâce à une vue magnifique sur les Monts du Forez."
    ],
    "nl": [
      "Le Petit Bois is een klein zwembad in een mooie omgeving waar U een prachtig uitzicht heeft op de Monts du Forez."
    ],
    "es": [
      "Le Petit Bois es una piscina familiar que goza de un entorno tranquilo gracias a sus magníficas vistas de los Montes del Forez. ."
    ]
  },
