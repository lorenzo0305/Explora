  "rdfs:comment": {
    "de": [
      "Das Baguette Ardéchoise, eine Mischung aus Weizen, Roggen und Kastanien, gemahlen vom letzten Mühlenbauer der Ardèche, erhältlich bei Le Pain d'Antan, einer Bäckerei in Lamastre."
    ],
    "en": [
      "The Ardèche-style baguette, a blend of wheat, rye, and chestnut, ground by the last miller in Ardèche, is available at Le Pain d'Antan, a bakery in Lamastre."
    ],
    "it": [
      "La baguette dell'Ardéchoise, una miscela di grano, segale e castagne, macinata dall'ultimo mugnaio dell'Ardéchois, disponibile presso Le Pain d'Antan, un panificio di Lamastre."
    ],
    "fr": [
      "La baguette Ardéchoise, mariage de blé, seigle, et châtaigne, moulue par le dernier minotier ardéchois, disponible chez Le Pain d'Antan, boulangerie à Lamastre."
    ],
    "es": [
      "La baguette Ardéchoise, una mezcla de trigo, centeno y castañas, molida por el último molinero de Ardéchois, disponible en Le Pain d'Antan, una panadería de Lamastre."
    ],
    "nl": [
      "De Ardèche stokbrood, een mix van tarwe, rogge en kastanje, gemalen door de laatste Ardèche molenaar, verkrijgbaar bij Le Pain d'Antan, een bakkerij in Lamastre."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le pain d'Antan - Boulangerie SCHULER  - \"La Baguette Ardéchoise\""
    ],
    "fr": [
      "Le pain d'Antan - Boulangerie SCHULER  - \"La Baguette Ardéchoise\" et Galets de la Daronne"
    ],
    "nl": [
      "Le pain d'Antan - Boulangerie SCHULER  - \"La Baguette Ardéchoise\""
    ]
