  "rdfs:comment": {
    "de": [
      "Abschlusskonzert der Gospel-Masterclass mit François Nyame-Siliki am 29. März 2026 um 16.30 Uhr in L'Embarcadère. Ein vibrierender und geselliger Moment, um die Arbeit der Chorsänger rund um das Gospelrepertoire zu entdecken!"
    ],
    "en": [
      "Gospel masterclass feedback concert with François Nyame-Siliki, March 29, 2026 at 4:30 pm at L?Embarcadère. A vibrant and convivial opportunity to discover the choristers' work on the gospel repertoire!"
    ],
    "it": [
      "Concerto di chiusura della masterclass di gospel con François Nyame-Siliki, il 29 marzo 2026 alle 16.30 presso L'Embarcadère. Un'occasione vibrante e conviviale per scoprire il lavoro dei coristi sul repertorio gospel!"
    ],
    "fr": [
      "Concert de restitution de la masterclass gospel avec François Nyame-Siliki, le 29 mars 2026 à 16h30 à L’Embarcadère. Un moment vibrant et convivial pour découvrir le travail des choristes autour du répertoire gospel !"
    ],
    "es": [
      "Concierto de clausura de la masterclass de gospel con François Nyame-Siliki, el 29 de marzo de 2026 a las 16:30 h en L'Embarcadère. Una ocasión vibrante y distendida para descubrir el trabajo de los coristas en el repertorio gospel"
    ],
    "nl": [
      "Concert ter afsluiting van de gospelmasterclass met François Nyame-Siliki, op 29 maart 2026 om 16.30 uur in L?Embarcadère. Een bruisende en gezellige gelegenheid om het werk van de koorleden op het gospelrepertoire te ontdekken!"
    ]
  },
