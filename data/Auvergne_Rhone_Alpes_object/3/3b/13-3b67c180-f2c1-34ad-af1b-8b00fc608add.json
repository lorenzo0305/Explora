  "rdfs:comment": {
    "de": [
      "Lassen Sie sich in die authentische Kunst der Stoffumwandlung einführen, in einem reichen und technischen Moment. Tauchen Sie mit Ihren Sinnen in das Herz einer handwerklichen Seifenherstellung ein. Lernen Sie, wie man das Material bearbeitet, um Ihre eigenen milden Seifen herzustellen."
    ],
    "en": [
      "Initiate yourself to the authentic art of transforming materials, in a rich and technical experience. Experience a sensory immersion in the heart of artisan soapmaking. Learn how to shape the material to create your own mild soaps."
    ],
    "it": [
      "Avviatevi all'autentica arte della trasformazione dei materiali, in un'esperienza ricca e tecnica. Provate un'immersione sensoriale nel cuore della saponificazione artigianale. Imparate a modellare la materia per creare i vostri saponi delicati."
    ],
    "fr": [
      "Initiez-vous à l’art authentique de la transformation des matières, dans un moment riche et technique. Vivez une immersion sensorielle au cœur de la savonnerie artisanale. Apprenez à façonner la matière pour créer vos savons doux."
    ],
    "nl": [
      "Maak kennis met de authentieke kunst van het transformeren van materialen, in een rijke en technische ervaring. Beleef een zintuiglijke onderdompeling in het hart van de ambachtelijke zeepmakerij. Leer hoe je het materiaal vormgeeft om je eigen milde zepen te maken."
    ],
    "es": [
      "Iníciese en el auténtico arte de transformar los materiales, en una experiencia rica y técnica. Viva una inmersión sensorial en el corazón de la jabonería artesanal. Aprenda a dar forma a la materia para crear sus propios jabones suaves."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier cosmétique \"Savons artisanaux\""
    ]
  },
