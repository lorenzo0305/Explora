  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Biotop eines Gartens und genießen Sie eine Führung durch den Hausherrn. Die Türen von Grumpy's Garden stehen allen offen, neugierigen Besuchern, Familien, Schulgruppen oder Hobbygärtnern!"
    ],
    "en": [
      "Come and discover the biotope of a garden and enjoy a guided tour by the owner. The doors to Grumpy's Garden are open to all, whether you're a curious visitor, a family, a school group or a hobby gardener!"
    ],
    "it": [
      "Venite a scoprire il biotopo di un giardino e godetevi una visita guidata dal proprietario. Le porte del Grumpy's Garden sono aperte a tutti, visitatori curiosi, famiglie, scolaresche o appassionati di giardinaggio!"
    ],
    "fr": [
      "Venez découvrir le biotope d'un jardin et profitez d'une visite guidée par le maître des lieux. Les portes du Jardin de Grumpy sont ouvertes à tous, visiteurs curieux, familles, groupes scolaires ou jardiniers amateurs !"
    ],
    "es": [
      "Venga a descubrir el biotopo de un jardín y disfrute de una visita guiada por el propietario. Las puertas del Jardín de Grumpy están abiertas a todos, ya seas un visitante curioso, una familia, un grupo escolar o un jardinero entusiasta"
    ],
    "nl": [
      "Kom de biotoop van een tuin ontdekken en geniet van een rondleiding door de eigenaar. De deuren van Grumpy's Garden staan open voor iedereen, of je nu een nieuwsgierige bezoeker bent, een gezin, een schoolgroep of een enthousiaste tuinier!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le jardin de Grumpy"
    ]
  },
