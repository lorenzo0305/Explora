  "rdfs:comment": {
    "de": [
      "Die jetzige Kirche ist ein zusammengesetzter Bau: romanische Sockel aus dem 12. Jahrhundert, gotische Öffnungen und Rippengewölbe. Größere Arbeiten, insbesondere Befestigungen, fanden im 15. Jahrhundert statt."
    ],
    "en": [
      "A composite building with Romanesque foundations from the 12th century, gothic openings and ribbed vaults. Extensive works were carried out in the 15th century notably fortifications."
    ],
    "it": [
      "L'attuale chiesa è un edificio composito, con fondamenta romaniche risalenti al XII secolo e aperture gotiche e volte a crociera. Nel XV secolo sono stati eseguiti importanti lavori, soprattutto di fortificazione."
    ],
    "fr": [
      "L’église actuelle est un bâtiment composite : bases romanes du XIIe siècle, des ouvertures et des voûtes nervurées sont gothiques. De gros travaux, notamment de fortifications, ont eu lieu au XVe siècle."
    ],
    "es": [
      "La iglesia actual es un edificio compuesto, con cimientos románicos del siglo XII y aberturas y bóvedas de crucería góticas. En el siglo XV se realizaron importantes obras, sobre todo de fortificación."
    ],
    "nl": [
      "De huidige kerk is een samengesteld gebouw, met Romaanse funderingen uit de 12e eeuw en gotische openingen en ribgewelven. In de 15e eeuw werden grote werken uitgevoerd, met name versterkingen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Church of Saint Gervais and Saint Protais"
    ],
