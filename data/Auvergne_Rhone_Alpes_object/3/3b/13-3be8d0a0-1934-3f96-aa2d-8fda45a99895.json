  "rdfs:comment": {
    "de": [
      "Kommen Sie zahlreich und entdecken Sie mehr als 3 500 Werke: Romane, Comics, Sachbücher... Das gesamte Team der Bibliothek \"Montbel Auteurs\" freut sich, Sie zu empfangen, um Sie bei Ihrer Auswahl zu unterstützen, Sie zu beraten.."
    ],
    "en": [
      "Come to discover over 3500 books: novels, comic books, documentaries...\r\nThe whole team of the \"Montbel Auteurs\" library will be happy to welcome you and guide you."
    ],
    "it": [
      "Venite a scoprire più di 3.500 libri: romanzi, fumetti, documentari? L'intera équipe della biblioteca \"Montbel Auteurs\" sarà lieta di accogliervi per guidarvi nelle vostre scelte, consigliarvi?"
    ],
    "fr": [
      "Venez nombreux découvrir plus de 3 500 ouvrages : romans, bandes dessinées, documentaires… Toute l’équipe de la bibliothèque \"Montbel Auteurs\" sera heureuse de vous accueillir pour vous guider dans vos choix, vous conseiller…"
    ],
    "es": [
      "Venga a descubrir más de 3.500 libros: novelas, cómics, documentales.. Todo el equipo de la biblioteca \"Montbel Auteurs\" estará encantado de recibirle para guiarle en sus elecciones, aconsejarle.."
    ],
    "nl": [
      "Kom en ontdek meer dan 3.500 boeken: romans, strips, documentaires... Het hele team van de bibliotheek \"Montbel Auteurs\" zal u graag ontvangen om u te begeleiden in uw keuzes, u te adviseren.."
    ]
  },
  "rdfs:label": {
    "en": [
