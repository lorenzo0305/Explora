  "rdfs:comment": {
    "de": [
      "Der Abend beginnt mit einem Imbiss um 17:30 Uhr, gefolgt von einer Vorführung von kurzen Animationsfilmen für Kinder.\r\nUm 20 Uhr wird der Film \"La théorie du Boxeur\" von Nathanaël Coste gezeigt. Getränke und Bio-Restaurants vor Ort."
    ],
    "en": [
      "The evening begins with a snack at 5:30pm, followed by a screening of animated shorts for children.\r\nAt 8pm, screening of the film \"La théorie du Boxeur\" by Nathanaël Coste. Refreshments and organic food on site."
    ],
    "it": [
      "La serata inizierà con una merenda alle 17.30, seguita dalla proiezione di cortometraggi d'animazione per bambini.\r\nAlle 20, proiezione del film \"La théorie du Boxeur\" di Nathanaël Coste. Rinfresco e cibo biologico sul posto."
    ],
    "fr": [
      "La soirée commencera avec un goûter à 17h30, suivie d’une projection de courts métrage d’animation pour les enfants. \r\nA 20h, projection du film \"La théorie du Boxeur\" de Nathanaël Coste. Buvette et restauration bio sur place."
    ],
    "es": [
      "La velada comenzará con un aperitivo a las 17.30 h, seguido de la proyección de cortos de animación para niños.\r\nA las 20.00 horas, proyección de la película \"La théorie du Boxeur\" de Nathanaël Coste. Refrescos y comida ecológica in situ."
    ],
    "nl": [
      "De avond begint met een snack om 17.30 uur, gevolgd door een vertoning van tekenfilms voor kinderen.\r\nOm 20.00 uur vertoning van de film \"La théorie du Boxeur\" van Nathanaël Coste. Versnaperingen en biologisch voedsel ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Documentaire : La théorie du boxeur"
    ]
  },
