  "rdfs:comment": {
    "de": [
      "Dieser Rundweg ermöglicht Ihnen eine schöne Entdeckung des Hochplateaus des Haut-Jura. Wandern Sie also durch diese Dolinen!"
    ],
    "en": [
      "This loop is a great way to discover the Haut-Jura plateau, so take a stroll through the dolines!"
    ],
    "it": [
      "Questo anello vi darà la possibilità di esplorare l'altopiano dell'Haut-Jura, quindi fate una passeggiata tra le doline!"
    ],
    "fr": [
      "Cette boucle vous permettra de faire une belle découverte du plateau du Haut-Jura, allez donc arpenter ces dolines !"
    ],
    "es": [
      "Este bucle le dará la oportunidad de explorar la meseta del Haut-Jura, así que ¡dé un paseo por las dolinas!"
    ],
    "nl": [
      "Deze lus biedt je een uitstekende gelegenheid om het plateau van de Haut-Jura te verkennen, dus maak een wandeling door de dolines!"
    ]
  },
