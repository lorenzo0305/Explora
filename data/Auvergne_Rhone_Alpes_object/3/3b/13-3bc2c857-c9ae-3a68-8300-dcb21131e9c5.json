  "rdfs:comment": {
    "de": [
      "ONAÏA - Cuisine en mouvement - Restaurant & Tables d'hôtes, 100% hausgemachte, lokavore und saisonale Küche. Im Herzen der Kartäusermühle von 1733, einem intimen Raum und einer Terrasse mit Blick auf den Fluss Guiers Vif."
    ],
    "en": [
      "ONAÏA - Cuisine in motion - Restaurant & Table d'hôte, 100% homemade, locally sourced and seasonal cuisine. In the heart of the Chartreux mill dating back to 1733, an intimate dining room and a terrace overlooking the Guiers Vif river."
    ],
    "it": [
      "ONAÏA - Cuisine en mouvement - Restaurant & Table d'hôtes, cucina 100% casalinga, locavorevole e stagionale. Nel cuore del mulino di Chartreux del 1733, una sala da pranzo intima e una terrazza con vista sul Guiers Vif."
    ],
    "fr": [
      "ONAÏA - Cuisine en mouvement - Restaurant & Tables d’hôtes, cuisine 100% faite maison, locavore et de saison. Au cœur du moulin des Chartreux 1733, une salle intimiste et une terrasse surplombant le Guiers Vif."
    ],
    "es": [
      "ONAÏA - Cuisine en mouvement - Restaurant & Table d'hôtes, cocina 100% casera, locavore y de temporada. En el corazón del molino de Chartreux de 1733, un comedor íntimo y una terraza con vistas al Guiers Vif."
    ],
    "nl": [
      "ONAÏA - Cuisine en mouvement - Restaurant & Table d'hôtes, 100% huisgemaakte, locavore en seizoensgebonden keuken. In het hart van de 1733 Chartreux molen, een intieme eetkamer en terras met uitzicht op de Guiers Vif."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Onaïa"
    ]
  },
