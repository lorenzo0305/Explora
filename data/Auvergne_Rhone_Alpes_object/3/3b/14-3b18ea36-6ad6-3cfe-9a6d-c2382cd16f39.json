  "rdfs:comment": {
    "de": [
      "Ein englischer Kolonist reist den Kongofluss hinauf und entdeckt dabei die Versklavung von Millionen schwarzer Männer und Frauen von den frühesten Siedlungen bis in die entferntesten Regionen."
    ],
    "en": [
      "An English colonist travels up the Congo River, discovering the enslavement of millions of black men and women, from the earliest settlements to the most remote regions."
    ],
    "it": [
      "Un colono inglese risale il fiume Congo, scoprendo la schiavitù di milioni di uomini e donne neri dai primi insediamenti alle regioni più remote."
    ],
    "fr": [
      "Un colon anglais remonte le fleuve Congo, en découvrant depuis les tous premiers campements jusqu'aux régions les plus lointaines, la mise en esclavage de millions d’hommes et de femmes noir-e-s."
    ],
    "es": [
      "Un colono inglés remonta el río Congo y descubre la esclavitud de millones de hombres y mujeres negros desde los primeros asentamientos hasta las regiones más remotas."
    ],
    "nl": [
      "Een Engelse kolonist reist de Congo-rivier op en ontdekt de slavernij van miljoenen zwarte mannen en vrouwen, van de vroegste nederzettingen tot de meest afgelegen gebieden."
    ]
  },
  "rdfs:label": {
