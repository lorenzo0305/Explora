  "rdfs:comment": {
    "de": [
      "Vereinssaal, der von der MJC Centre Social verwaltet und von einem Team leidenschaftlicher Kinobesucher betreut wird. Hier wird das Vergnügen des Kinos mit über 200 Filmen pro Jahr geteilt, wobei das Arthouse-Kino einen großen Stellenwert einnimmt."
    ],
    "en": [
      "A community cinema managed by the MJC Centre Social and run by a team of enthusiasts. Here, we share the pleasure of cinema with over 200 films a year, with a strong emphasis on arthouse films."
    ],
    "it": [
      "Un cinema comunitario gestito dal Centro Sociale MJC e diretto da un team di appassionati. Qui condividiamo il piacere del cinema con oltre 200 film all'anno, con una forte enfasi sui film d'essai."
    ],
    "fr": [
      "Salle associative gérée par la MJC Centre Social et animée par une équipe de passionnés. Ici, on partage le plaisir du cinéma avec plus de 200 films par an, avec une belle place pour le cinéma Art et Essai."
    ],
    "es": [
      "Un cine comunitario gestionado por el MJC Centre Social y dirigido por un equipo de entusiastas. Aquí compartimos el placer del cine con más de 200 películas al año, con un fuerte énfasis en el cine de autor."
    ],
    "nl": [
      "Een gemeenschapsbioscoop beheerd door het MJC Centre Social en gerund door een team van enthousiastelingen. Hier delen we het plezier van de bioscoop met meer dan 200 films per jaar, met een sterke nadruk op arthousefilms."
    ]
  },
