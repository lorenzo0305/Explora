  "rdfs:comment": {
    "de": [
      "In einem familiären Rahmen können Sie das Pferd im Reitzentrum mit Gütesiegel dank verschiedener Aktivitäten entdecken: Fußarbeit, Ausflüge mit Ponys, Reitkurse, Thementage... Möglichkeit der Pension, des Beritts, der Erziehung und Rehabilitation von Pferden."
    ],
    "en": [
      "In a family environment, horse discovery thanks to numerous activities : on foot working, pony walking, horse riding courses, theme day... Horse boarding possible."
    ],
    "it": [
      "In un ambiente familiare, scoprite i cavalli nel centro di equitazione accreditato attraverso una serie di attività: lavoro a piedi, pony trekking, lezioni di equitazione, giornate a tema... Possibilità di pensione, rodaggio, educazione e riabilitazione."
    ],
    "fr": [
      "Dans un cadre familial, découverte du cheval au centre équestre labellisé grâce à diverses activités : travail à pied, balade à poneys, cours d'équitations, journées à thème... Possibilité de pension, débourrage, éducation et rééducation du cheval."
    ],
    "nl": [
      "Ontdek de paarden in de erkende manege in een familiale omgeving door middel van verschillende activiteiten: werken te voet, ponyritten, paardrijlessen, themadagen... Pension, inrijden, onderwijs en rehabilitatie beschikbaar."
    ],
    "es": [
      "En un entorno familiar, descubra los caballos en el centro ecuestre acreditado a través de diversas actividades: trabajo a pie, paseos en poni, clases de equitación, jornadas temáticas... Posibilidad de alojamiento, doma, educación y rehabilitación."
    ]
  },
