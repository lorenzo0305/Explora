  "rdfs:comment": {
    "de": [
      "Betty und Jean-Paul begrüßen Sie in ihrem Lokal, das auf Grillfleisch und Kutteln spezialisiert ist. Ihre Geschmacksknospen werden auf Hochtouren laufen."
    ],
    "en": [
      "Betty and Jean-Paul welcome you to their establishment specializing in grilled meats and tripe. Your taste buds will be on fire."
    ],
    "it": [
      "Betty e Jean-Paul vi danno il benvenuto nel loro locale specializzato in carni e trippe alla griglia, dove le vostre papille gustative saranno deliziate."
    ],
    "fr": [
      "Betty et Jean-Paul vous accueillent dans leur établissement spécialisé dans les grillades et les tripailles, vos papilles vont être en éveil."
    ],
    "es": [
      "Betty y Jean-Paul le dan la bienvenida a su establecimiento especializado en carnes y callos a la brasa, donde sus papilas gustativas disfrutarán de lo lindo."
    ],
    "nl": [
      "Betty en Jean-Paul heten je welkom in hun zaak die gespecialiseerd is in gegrild vlees en pens. Je smaakpapillen zullen in de watten worden gelegd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les forges"
    ]
  },
