  "rdfs:comment": {
    "de": [
      "Dieses Restaurant mit seiner schönen Panoramaterrasse in einer grünen Umgebung empfängt Sie für einen Moment der Entspannung zum Mittagessen, Abendessen, einem Getränk, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "This restaurant, with its beautiful panoramic terrace set in greenery, welcomes you for a relaxing lunch, dinner or drink, on site or to take away."
    ],
    "it": [
      "Questo ristorante, con la sua splendida terrazza panoramica immersa nel verde, vi accoglie per un pranzo, una cena o un drink rilassanti, in loco o da asporto."
    ],
    "fr": [
      "Ce restaurant et sa belle terrasse panoramique dans un écrin de verdure vous accueille pour un moment de détente pour déjeuner, dîner, boire un verre, sur place ou à emporter."
    ],
    "es": [
      "Este restaurante, con su hermosa terraza panorámica rodeada de una exuberante vegetación, le da la bienvenida para un relajante almuerzo, cena o bebida, en el establecimiento o para llevar."
    ],
    "nl": [
      "Dit restaurant, met een prachtig panoramisch terras midden in het groen, verwelkomt je voor een ontspannen lunch, diner of drankje, ter plekke of om mee te nemen."
    ]
  },
  "rdfs:label": {
