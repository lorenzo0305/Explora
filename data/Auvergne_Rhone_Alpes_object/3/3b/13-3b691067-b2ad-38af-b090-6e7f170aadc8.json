  "rdfs:comment": {
    "de": [
      "Ob Sie nun Lust auf einen Gourmet-Burger, einen großzügigen Salat oder ein originelles Sandwich haben, bei Veloci Food werden Sie garantiert fündig."
    ],
    "en": [
      "Whether you fancy a gourmet burger, a generous salad or an original sandwich, you're sure to find something to suit your taste at Veloci Food."
    ],
    "it": [
      "Che abbiate voglia di un hamburger gourmet, di un'insalata abbondante o di un panino originale, da Veloci Food troverete sicuramente quello che cercate."
    ],
    "fr": [
      "Que vous ayez envie d'un burger gourmand, d'une salade généreuse ou d'un sandwich original, vous trouverez forcément votre bonheur chez Veloci Food."
    ],
    "es": [
      "Tanto si te apetece una hamburguesa gourmet, una generosa ensalada o un original sándwich, seguro que en Veloci Food encuentras lo que buscas."
    ],
