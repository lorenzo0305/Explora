  "rdfs:comment": {
    "de": [
      "Im Schatten des Schlosses der Herzöge von Savoyen vereint das Petit Hôtel Confidentiel***** samtene Atmosphäre und zarte Lebenskunst. Die Eleganz zieht sich wie ein roter Faden durch die 15 modernen und schlichten Zimmer und Suiten."
    ],
    "en": [
      "In the shade of the Castle of the Dukes of Savoy, PHC ***** combines a velvet atmosphere and a delicate art of living. Elegance unrolls its common thread in the 17 modern and refined rooms and suites."
    ],
    "it": [
      "All'ombra dello Château des Ducs de Savoie, il Petit Hôtel Confidentiel***** unisce un'atmosfera vellutata a una delicata arte di vivere. L'eleganza scorre come un filo rosso nelle 15 camere e suite moderne ed eleganti."
    ],
    "fr": [
      "A l’ombre du Château des Ducs de Savoie, Petit Hôtel Confidentiel***** conjugue atmosphère de velours et art de vivre délicat. L’élégance déroule son fil rouge dans les 15 chambres et suites, modernes et épurées."
    ],
    "nl": [
      "In de schaduw van het Château des Ducs de Savoie combineert Petit Hôtel Confidentiel***** een fluwelen sfeer met een verfijnde levenskunst. Elegantie loopt als een rode draad door de 15 strakke, moderne kamers en suites."
    ],
    "es": [
      "A la sombra del Castillo de los Duques de Saboya, el Petit Hôtel Confidentiel***** combina una atmósfera aterciopelada con un delicado arte de vivir. La elegancia corre como un hilo rojo a través de las 15 habitaciones y suites elegantes y modernas."
    ]
  },
