  "rdfs:comment": {
    "de": [
      "Im Herzen des Beaujolais gelegen, besticht unser 18-Loch-Platz durch seine abwechslungsreiche Streckenführung und seine makellosen Greens. Flexible Mitgliedschaften, Einführungen für Anfänger und ein dynamischer Sportverein. Erleben Sie ein einzigartiges Golferlebnis!"
    ],
    "en": [
      "Located in the heart of Beaujolais, our 18-hole course boasts a varied layout and impeccable greens. Flexible memberships, initiation sessions for beginners, and a dynamic Sports Association. Come experience golf in a unique setting!"
    ],
    "it": [
      "Situato nel cuore della regione del Beaujolais, il nostro campo a 18 buche vanta un layout vario e green impeccabili. Iscrizioni flessibili, corsi per principianti e un'associazione sportiva dinamica. Venite a vivere un'esperienza di golf unica!"
    ],
    "fr": [
      "Situé au cœur du Beaujolais, notre parcours 18 trous séduit par son tracé varié et ses greens impeccables. Abonnements flexibles, initiations pour débutants, et une Association Sportive dynamique. Venez vivre une expérience golfique unique !"
    ],
    "es": [
      "Situado en el corazón de la región de Beaujolais, nuestro campo de 18 hoyos cuenta con un trazado variado y greens impecables. Membresías flexibles, cursos para principiantes y una dinámica Asociación Deportiva. Disfrute de una experiencia de golf única"
    ],
    "nl": [
      "Onze 18-holesbaan ligt in het hart van de Beaujolais en heeft een gevarieerd parcours en onberispelijke greens. Flexibele lidmaatschappen, beginnerscursussen en een dynamische sportvereniging. Kom genieten van een unieke golfervaring!"
    ]
  },
  "rdfs:label": {
