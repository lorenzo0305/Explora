  "rdfs:comment": {
    "de": [
      "Ein Refugium für Genießer mit Blick auf den Mont Blanc! Hier gibt es kein Menü und keine Speisekarte, die Schiefertafel enthüllt jeden Tag Gerichte ohne Chichis, Spezialitäten aus Savoyen und Klassiker aus den französischen Regionen. Eine herzerwärmende Küche aus lokalen Produkten."
    ],
    "en": [
      "At \"Le Babotch\"  you are travelling somewhere else. You will enjoy tasting Savoyard specialities."
    ],
    "it": [
      "Nel nostro locale, vi ritroverete in un altro mondo! Venite a gustare le specialità savoiarde."
    ],
    "fr": [
      "Un refuge épicurien face au Mont Blanc ! Ici pas de menu ni de carte, l'ardoise dévoile chaque jour des plats sans chichis, spécialités savoyardes et classiques des régions françaises. Une cuisine réconfortante à base de produits locaux."
    ],
    "es": [
      "Un refugio epicúreo frente al Mont Blanc Aquí no hay menú ni carta, sino un menú diario de platos sencillos, especialidades saboyanas y clásicos de las regiones francesas. Una cocina reconfortante basada en los productos locales."
    ],
    "nl": [
      "Een toevluchtsoord voor fijnproevers met uitzicht op de Mont Blanc! Hier geen menu of à la carte, maar een dagmenu met eenvoudige gerechten, specialiteiten uit de Savoie en klassiekers uit de Franse regio. Een comfortabele keuken op basis van lokale producten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Babotch"
    ],
