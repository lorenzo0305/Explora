  "rdfs:comment": {
    "de": [
      "Auf der Seite der Abteikirche Saint-Austremoine in Issoire empfangen wir Sie das ganze Jahr über, um Ihnen das Pays d'Issoire näher zu bringen."
    ],
    "en": [
      "On the side of the Saint-Austremoine abbey in Issoire, we welcome you all year round to discover the Pays d'Issoire."
    ],
    "it": [
      "Sul lato dell'abbazia di Saint-Austremoine a Issoire, vi accogliamo tutto l'anno per farvi scoprire la regione di Issoire."
    ],
    "fr": [
      "Sur le côté de l'abbatiale Saint-Austremoine à Issoire, nous vous accueillons toute l'année pour vous faire découvrir le Pays d'Issoire."
    ],
    "es": [
      "Al lado de la abadía de Saint-Austremoine, en Issoire, le damos la bienvenida todo el año para ayudarle a descubrir la región de Issoire."
    ],
    "nl": [
      "Aan de kant van de Saint-Austremoine abdij in Issoire, verwelkomen wij u het hele jaar door om u te helpen de Issoire streek te ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
