  "rdfs:comment": {
    "de": [
      "Produzent vom Bauernhof ? Käse aus Rohmilch\r\n\r\nFlorian und Stéfanie laden Sie ein, ihren Betrieb bei authentischen Besuchen im Herzen der Landschaft zu entdecken."
    ],
    "en": [
      "Farmer ? Raw milk cheeses\r\n\r\nFlorian and Stéfanie invite you to discover their farm during authentic visits in the heart of the countryside."
    ],
    "it": [
      "Produttore di fattoria? Formaggi a latte crudo\r\n\r\nFlorian e Stéfanie vi invitano a scoprire la loro fattoria durante visite autentiche nel cuore della campagna."
    ],
    "fr": [
      "Producteur fermier – Fromages au lait cru\r\n\r\nFlorian et Stéfanie vous invitent à découvrir leur exploitation lors de visites authentiques au cœur de la campagne."
    ],
    "es": [
      "Granja productora ? Quesos de leche cruda\r\n\r\nFlorian y Stéfanie le invitan a descubrir su granja en auténticas visitas al corazón del campo."
    ],
    "nl": [
      "Boerderij producent ? Kaas van rauwe melk\r\n\r\nFlorian en Stéfanie nodigen je uit om hun boerderij te ontdekken tijdens authentieke bezoeken in het hart van het platteland."
    ]
  },
