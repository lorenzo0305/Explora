  "rdfs:comment": {
    "de": [
      "Familienfreundliches Freizeitzentrum am Ufer des Sees Saint-Clair: Spaziergang mit behindertengerechtem Zugang, Wasserspiele, Angeln, Picknickbereich, Gesundheitsparcours, Pumptrack, Natur- und Entspannungsaktivitäten für Groß und Klein."
    ],
    "en": [
      "The sports and recreation park of lake Saint-Clair is a place where all the family can relax. It is accessible to disabled people and there are picnic tables, a restaurant and a mini-golf. Fishing is possible as well as swimming (not watched). There are also a camping site and a parking area nearby."
    ],
    "it": [
      "Il centro ricreativo del Lac Saint-Clair è un luogo di relax ideale per tutta la famiglia. Intorno al lago ci sono tavoli da picnic e strutture per disabili."
    ],
    "fr": [
      "Base de loisirs familiale au bord du lac Saint-Clair : balade accessible PMR, jeux d’eau, pêche, aire de pique-nique, parcours santé, pumptrack, activités nature et détente pour petits et grands."
    ],
    "nl": [
      "Het recreatiecentrum Lac Saint-Clair is een geweldige plek om te ontspannen voor het hele gezin. Er zijn picknicktafels en faciliteiten voor gehandicapten rond het meer."
    ],
    "es": [
      "Centro de ocio familiar a orillas del lago Saint-Clair: paseo accesible para minusválidos, juegos acuáticos, pesca, zona de picnic, pista de fitness, pumptrack, actividades en la naturaleza y relajación para grandes y pequeños."
    ]
  },
  "rdfs:label": {
