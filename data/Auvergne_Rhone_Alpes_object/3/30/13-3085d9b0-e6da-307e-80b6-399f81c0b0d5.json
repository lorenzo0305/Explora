  "rdfs:comment": {
    "de": [
      "Liebhaber von Oldtimern bilden diesen Verein, der am Wochenende nach dem 15. August eine große Oldtimerausstellung auf dem Place des Balayes in Le Chambon organisiert."
    ],
    "en": [
      "The association is made up of classic car enthusiasts, and organizes a large classic car show at Place des Balayes in Le Chambon the weekend after August 15th."
    ],
    "it": [
      "L'associazione è composta da appassionati di auto d'epoca che organizzano una grande mostra di auto d'epoca in Place des Balayes a Le Chambon il fine settimana successivo al 15 agosto."
    ],
    "fr": [
      "Des passionnés de voiture anciennes forment cette association qui organisé une grande expo de voitures anciennes place des Balayes au Chambon le week-end après le 15 août."
    ],
    "es": [
      "La asociación está formada por aficionados a los coches clásicos que organizan un gran salón del automóvil clásico en la Place des Balayes de Le Chambon el fin de semana siguiente al 15 de agosto."
    ],
    "nl": [
      "De vereniging bestaat uit oldtimerliefhebbers die het weekend na 15 augustus een grote oldtimershow organiseren op Place des Balayes in Le Chambon."
    ]
  },
  "rdfs:label": {
