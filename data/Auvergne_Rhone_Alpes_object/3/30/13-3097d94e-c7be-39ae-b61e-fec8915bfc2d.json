  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg ihrer Show \"Amour\" kehrt Bérangère Krief mit \"Sexe\" auf die Bühne zurück, einer gewagten und urkomischen One-Woman-Show, die unsere Beziehung zur Sexualität erforscht."
    ],
    "en": [
      "After the success of her show \"Amour\", Bérangère Krief returns to the stage with \"Sexe\", a daring and hilarious one-woman show that explores our relationship with sexuality."
    ],
    "it": [
      "Dopo il successo del suo spettacolo \"Amour\", Bérangère Krief torna in scena con \"Sexe\", un one-woman show audace ed esilarante che esplora il nostro rapporto con la sessualità."
    ],
    "fr": [
      "Après le succès de son spectacle \"Amour\", Bérangère Krief revient sur scène avec \"Sexe\", un one-woman-show audacieux et hilarant qui explore notre rapport à la sexualité."
    ],
    "es": [
      "Tras el éxito de su espectáculo \"Amour\", Bérangère Krief vuelve a los escenarios con \"Sexe\", un atrevido e hilarante espectáculo en solitario que explora nuestra relación con la sexualidad."
    ],
    "nl": [
      "Na het succes van haar show \"Amour\", keert Bérangère Krief terug op het podium met \"Sexe\", een gedurfde en hilarische one-woman show die onze relatie met seksualiteit onderzoekt."
    ]
  },
  "rdfs:label": {
    "fr": [
