  "rdfs:comment": {
    "de": [
      "Im Winter: Startpunkt für Langlaufloipen und alpine Skipisten.\r\nIm Sommer: Entdecken Sie auf abwechslungsreichen Wanderungen die alpine Flora und Fauna\r\n\r\nZimmer: 24 - Private Duschbäder: 24 Kostenloser WLAN-Zugang. Kostenloser Parkplatz.\r\nRestaurant - Terroir"
    ],
    "en": [
      "Winter: cross-country and downhill ski trails.\r\nSummer: discover alpine flora and fauna on a variety of hikes.\r\n\r\nRooms: 24 - Private showers: 24 Free Wi-Fi access. Free parking.\r\nRestaurant - Terroir"
    ],
    "it": [
      "Inverno: dalle piste da sci di fondo e da discesa.\r\nEstate: scoprite la fauna e la flora delle Alpi con una serie di escursioni.\r\n\r\nCamere: 24 - Bagni privati con doccia: 24 Accesso Wi-Fi gratuito. Parcheggio gratuito.\r\nRistorante - Terroir"
    ],
    "fr": [
      "L'hiver :  au départ pistes de ski de fond et de ski alpin.\r\nL'été : vous découvrirez la faune et la flore alpine au gré de randonnées variées\r\n\r\nChambres : 24 - Bains douches privés : 24 Accès Wifi gratuit. Parking gratuit.\r\nRestaurant  - Terroir"
    ],
    "nl": [
      "Winter: van de langlauf- en skipistes.\r\nZomer: ontdek de fauna en flora van de Alpen tijdens verschillende wandelingen.\r\n\r\nKamers: 24 - Privé doucheruimtes: 24 Gratis Wi-Fi. Gratis parkeerplaats.\r\nRestaurant - Terroir"
    ],
    "es": [
      "Invierno: desde las pistas de esquí de fondo y de descenso.\r\nVerano: descubra la fauna y flora de los Alpes en variados paseos\r\n\r\nHabitaciones: 24 - Duchas privadas: 24 Acceso Wi-Fi gratuito. Aparcamiento gratuito.\r\nRestaurante - Terroir"
    ]
  },
