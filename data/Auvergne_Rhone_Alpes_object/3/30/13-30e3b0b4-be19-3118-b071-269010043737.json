  "rdfs:comment": {
    "de": [
      "Neoromanische Kirche aus dem 19. Jahrhundert. Jahrhundert. In diesem Gebäude finden Sie Gemälde und Statuen, die den sulpizischen Stil repräsentieren. Eine Statue der Jungfrau Maria ist ebenfalls zu sehen."
    ],
    "en": [
      "Neo-Romanesque church of the 19th century. In this building, you will find paintings and statues representing the Sulpician style. A statue of the Virgin is also visible there."
    ],
    "it": [
      "Chiesa neoromanica del XIX secolo. In questo edificio si trovano dipinti e statue che rappresentano lo stile sulpiziano. È visibile anche una statua della Vergine Maria."
    ],
    "fr": [
      "Église néo-romane du XIXème siècle. Dans cet édifice, retrouvez peintures et statuaires représentant le style sulpicien. Une statue de la Vierge y est également visible."
    ],
    "nl": [
      "Neo-Romaanse kerk uit de 19e eeuw. In dit gebouw vindt u schilderijen en beelden in Sulpische stijl. Een standbeeld van de Maagd Maria is ook zichtbaar."
    ],
    "es": [
      "Iglesia neorrománica del siglo XIX. En este edificio se encuentran pinturas y estatuas que representan el estilo sulpiciano. También puede verse una estatua de la Virgen María."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Germain"
    ]
  },
