  "rdfs:comment": {
    "de": [
      "Dieses kleine Café-Restaurant im Zentrum von Meru bietet Ihnen traditionelle Küche. Das Geschäft besteht seit über 100 Jahren. Restauration von Montag bis Freitag mittags."
    ],
    "en": [
      "In the centre of Méru, this small café-restaurant offers traditional cuisine. The sign has existed for over 100 years. Catering from Monday to Friday lunchtime."
    ],
    "it": [
      "Nel centro di Méru, questo piccolo caffè-ristorante offre una cucina tradizionale. Il ristorante esiste da oltre 100 anni. Ristorazione dal lunedì al venerdì a pranzo."
    ],
    "fr": [
      "Au centre de Méru, ce petit café-restaurant vous propose une cuisine traditionnelle. L'enseigne existe depuis plus de 100 ans. Restauration du lundi au vendredi midi."
    ],
    "nl": [
      "In het centrum van Méru biedt dit kleine café-restaurant een traditionele keuken. Het restaurant bestaat al meer dan 100 jaar. Catering van maandag tot vrijdagmiddag."
    ],
    "es": [
      "En el centro de Méru, este pequeño café-restaurante ofrece cocina tradicional. El restaurante existe desde hace más de 100 años. Servicio de comidas de lunes a viernes a la hora del almuerzo."
    ]
  },
