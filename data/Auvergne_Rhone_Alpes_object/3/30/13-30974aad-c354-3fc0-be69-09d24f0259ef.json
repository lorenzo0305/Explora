  "rdfs:comment": {
    "de": [
      "Ein Workshop, der als Zeit zum Atmen und zur grafischen Erkundung gedacht ist, eine Einladung, in die Texturen und Bewegungen des Himmels einzutauchen."
    ],
    "en": [
      "A workshop designed as a time for breathing and graphic exploration, an invitation to plunge into the textures and movements of the sky."
    ],
    "it": [
      "Un workshop concepito come un momento di respirazione e di esplorazione grafica, un invito a immergersi nelle trame e nei movimenti del cielo."
    ],
    "fr": [
      "Un atelier pensé comme un temps de respiration et d’exploration graphique, une invitation à plonger dans les textures et mouvements du ciel."
    ],
    "es": [
      "Un taller concebido como un tiempo de respiración y exploración gráfica, una invitación a sumergirse en las texturas y movimientos del cielo."
    ],
    "nl": [
      "Een workshop ontworpen als een tijd voor ademhaling en grafische verkenning, een uitnodiging om je onder te dompelen in de texturen en bewegingen van de lucht."
