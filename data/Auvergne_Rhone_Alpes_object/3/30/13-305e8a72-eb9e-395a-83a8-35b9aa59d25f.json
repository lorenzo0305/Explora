  "rdfs:comment": {
    "de": [
      "L'Escale himalayenne bietet Ihnen eine Gourmetpause auf dem Imbiss mit heißen und kalten Getränken, Eis, Sandwiches, regionalen Produkten, Pommes frites, Snackformel, ... auf dem Weg zur Passerelle des Gorges du Lignon."
    ],
    "en": [
      "L'Escale himalayenne offers you a gourmet break at the snack bar with hot and cold drinks, ice creams, sandwiches, local produce, French fries, snack formula, ... on the way to the Passerelle des Gorges du Lignon."
    ],
    "it": [
      "L'Escale himalayenne vi offre una pausa golosa allo snack bar con bevande calde e fredde, gelati, panini, prodotti locali, patatine fritte, formula snack, ecc. sulla strada per la passerella delle Gorges du Lignon."
    ],
    "fr": [
      "L'Escale himalayenne vous propose une pause gourmande sur le snack avec boissons chaudes et froides, glaces, sandwichs, produits du terroir, frites, formule snack, ... sur le chemin de la Passerelle des Gorges du Lignon."
    ],
    "es": [
      "L'Escale himalayenne le ofrece una pausa gastronómica en el snack bar con bebidas frías y calientes, helados, sándwiches, productos locales, patatas fritas, fórmula snack, etc. de camino a la pasarela de las Gorges du Lignon."
    ],
    "nl": [
      "L'Escale himalayenne biedt je een gastronomische pauze in de snackbar met warme en koude dranken, ijsjes, broodjes, streekproducten, friet, snackformule, enz. op weg naar de loopbrug van de Gorges du Lignon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Snack l'Escale himalayenne"
    ]
  },
