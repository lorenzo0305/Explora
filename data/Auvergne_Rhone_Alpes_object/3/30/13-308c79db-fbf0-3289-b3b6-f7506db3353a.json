  "rdfs:comment": {
    "de": [
      "Als zeitgenössische Mosaikkünstlerin bringe ich die Energie des Minerals in Ihr Universum, um Sie mit der Schönheit der Welt zu verbinden.\r\nWandkompositionen, Skulpturen, Spiegel...\r\nSchnupperworkshops, Kurse, Praktika."
    ],
    "en": [
      "As a contemporary mosaic artist, I bring the energy of minerals into your world to connect you with the beauty of the world.\r\nWall compositions, sculptures, mirrors...\r\nDiscovery workshops, courses, internships."
    ],
    "it": [
      "Come artista di mosaico contemporaneo, porto l'energia dei minerali nel vostro mondo per mettervi in contatto con la bellezza del mondo.\r\nComposizioni murali, sculture, specchi...\r\nLaboratori di scoperta, lezioni, corsi."
    ],
    "fr": [
      "Artiste en mosaïque contemporaine, j'amène l'énergie du minéral dans votre univers afin de vous relier à la beauté du monde.\r\nCompositions murales, sculptures, miroirs...\r\nAteliers découverte, cours, stages."
    ],
    "es": [
      "Como artista del mosaico contemporáneo, traigo la energía de los minerales a tu mundo para conectarte con la belleza del mundo.\r\nComposiciones murales, esculturas, espejos...\r\nTalleres de descubrimiento, clases, cursos."
    ],
    "nl": [
      "Als hedendaagse mozaïekkunstenaar breng ik de energie van mineralen in jouw wereld om je te verbinden met de schoonheid van de wereld.\r\nWandcomposities, sculpturen, spiegels...\r\nOntdekkingsworkshops, lessen, cursussen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Véronique Darcon Cazes Mosaic"
    ],
    "fr": [
      "Véronique Darcon Cazes Mosaïque"
    ]
  },
