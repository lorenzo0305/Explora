  "rdfs:comment": {
    "de": [
      "Siladen entwirft und organisiert schlüsselfertige Seminare inmitten der Natur in Rhône-Alpes, weniger als 2 Stunden von Ihren Räumlichkeiten entfernt. Ein einziger Ansprechpartner, eine einzige Rechnung für alles: Unterkunft, Verpflegung, Aktivitäten und Transport. Von 7 bis 300 Teilnehmern."
    ],
    "en": [
      "Siladen designs and organizes turnkey corporate retreats in the heart of nature across Rhône-Alpes. One single contact for everything: accommodation, catering, activities, and transport. From 7 to 300 participants."
    ],
    "it": [
      "Siladen progetta e organizza seminari \"chiavi in mano\" nel cuore della regione Rodano-Alpi, a meno di 2 ore dalla vostra sede. Un solo contatto, una sola fattura per tutto: alloggio, catering, attività e trasporto. Da 7 a 300 partecipanti."
    ],
    "fr": [
      "Siladen conçoit et organise des séminaires clés en main en pleine nature en Rhône-Alpes à moins de 2h de vos locaux. Un seul interlocuteur, une seule facture pour tout : hébergement, restauration, activités et transport. De 7 à 300 participants."
    ],
    "nl": [
      "Siladen ontwerpt en organiseert kant-en-klare seminars in het hart van de regio Rhône-Alpes, op minder dan 2 uur van uw bedrijf. Eén contactpersoon, één factuur voor alles: accommodatie, catering, activiteiten en vervoer. Van 7 tot 300 deelnemers."
    ],
    "es": [
      "Siladen diseña y organiza seminarios llave en mano en el corazón de la región Rhône-Alpes, a menos de 2 horas de sus instalaciones. Un interlocutor, una factura para todo: alojamiento, restauración, actividades y transporte. De 7 a 300 participantes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "SILADEN Séminaire au vert & Team Building nature"
    ]
  },
