  "rdfs:comment": {
    "de": [
      "Fernab vom Massentourismus können Sie mit einem Esel wandern gehen!\r\nNeu: Jede Jakobswanderung von 5 oder mehr Tagen mit Start in St Jeures erhält einen Rabatt von 70 € auf den Aufenthalt/Esel ..."
    ],
    "en": [
      "Away from mass tourism, go hiking with a donkey!\r\nNew : any hike in Compostela of 5 days or more with departure from St Jeures benefits from a 70 € discount on the stay/donkey ..."
    ],
    "it": [
      "Lontano dal turismo di massa, fate un'escursione con un asino!\r\nNovità: ogni trekking di Compostelle di 5 o più giorni con partenza da St Jeures beneficia di uno sconto di 70 € sul soggiorno/scimmia ..."
    ],
    "fr": [
      "Loin du tourisme de masse, partez en randonnée avec un âne !\r\nNouveauté : toute rando de Compostelle de 5 jours ou plus avec départ de St Jeures bénéficie d'une remise de 70 € sur le séjour/âne ..."
    ],
    "nl": [
      "Ver van het massatoerisme, ga wandelen met een ezel!\r\nNieuw: elke Compostelle trektocht van 5 dagen of meer met vertrek in St Jeures geniet van een korting van 70 € op het verblijf/de ezel ..."
    ],
    "es": [
      "Lejos del turismo de masas, ¡haga senderismo con un burro!\r\nNovedad: cualquier excursión de Compostelle de 5 días o más que parta de St Jeures se beneficia de un descuento de 70€ en la estancia/monedero..."
    ]
  },
