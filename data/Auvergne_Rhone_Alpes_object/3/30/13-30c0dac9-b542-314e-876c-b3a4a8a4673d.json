  "rdfs:comment": {
    "de": [
      "Kochkurse, bei denen Sie der Chef sind!\r\n\r\nMögen Sie einfache und originelle Gerichte?\r\nMöchten Sie in einer freundlichen Atmosphäre lernen?\r\nSie haben Lust, die Tricks der Küchenchefs kennenzulernen?\r\nSie suchen nach zugänglichen Menüs, die Sie zu Hause mit anderen teilen können?"
    ],
    "en": [
      "Cooking classes where you're the chef!\r\n\r\nDo you like simple, original cooking?\r\nWould you like to learn in a friendly atmosphere?\r\nWould you like to learn the tricks of the trade?\r\nLooking for affordable menus to share at home?"
    ],
    "it": [
      "Corsi di cucina in cui lo chef siete voi!\r\n\r\nVi piace una cucina semplice e originale?\r\nVolete imparare in un'atmosfera amichevole?\r\nVolete imparare i trucchi del mestiere?\r\nSiete alla ricerca di menu accessibili da condividere a casa?"
    ],
    "fr": [
      "Cours de cuisine où vous êtes le Chef !\r\n\r\nVous aimez la cuisine simple et originale ?\r\nVous souhaitez apprendre dans une ambiance conviviale ?\r\nVous avez envie de connaitre des astuces de chefs ?\r\nVous cherchez des menus accessibles à partager à la maison ?"
    ],
    "nl": [
      "Kooklessen waar jij de chef bent!\r\n\r\nHou je van eenvoudig en origineel koken?\r\nWil je leren in een gezellige sfeer?\r\nWil je de kneepjes van een chef leren?\r\nOp zoek naar betaalbare menu's om thuis te delen?"
    ],
    "es": [
      "Clases de cocina en las que usted es el chef\r\n\r\n¿Le gusta la cocina sencilla y original?\r\n¿Te gustaría aprender en un ambiente agradable?\r\n¿Quiere aprender los trucos del oficio?\r\n¿Busca menús accesibles para compartir en casa?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Come and Cook"
    ]
  },
