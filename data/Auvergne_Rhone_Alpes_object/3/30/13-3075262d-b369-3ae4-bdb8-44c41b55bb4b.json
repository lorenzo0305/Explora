  "rdfs:comment": {
    "de": [
      "Hapy bietet uns sein futuristisches, rhythmisches und melodiöses Universum für ein elektro-akustisch gefärbtes Set mit seinen Maschinen, seiner Gitarre und einer Stimme, die in den Wolken segelt."
    ],
    "en": [
      "Hapy brings us his futuristic, rhythmic and melodious universe for an electro-acoustic set with machines, guitar and a voice that sails in the clouds."
    ],
    "it": [
      "Hapy ci porta il suo universo futuristico, ritmico e melodioso per un set elettro-acustico con le sue macchine, la sua chitarra e una voce che naviga tra le nuvole."
    ],
    "fr": [
      "Hapy nous propose son univers futuriste, rythmé et mélodieux pour un set à couleur électro-acoustique avec ses machines, sa guitare et une voix qui navigue dans les nuages."
    ],
    "es": [
      "Hapy nos trae su universo futurista, rítmico y melodioso para un set electroacústico con sus máquinas, su guitarra y una voz que navega por las nubes."
    ],
    "nl": [
      "Hapy brengt ons zijn futuristische, ritmische en melodieuze universum voor een elektro-akoestische set met zijn machines, zijn gitaar en een stem die door de wolken zweeft."
    ]
  },
  "rdfs:label": {
