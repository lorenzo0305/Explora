  "rdfs:comment": {
    "de": [
      "Mitten im Stadtzentrum, auf der Halbinsel, nur wenige Schritte vom Place Bellecour entfernt, entdecken Sie ein Restaurant mit gemütlicher Atmosphäre und heimeliger Einrichtung."
    ],
    "en": [
      "Have a drink and a gastronomy break at the heart of the city."
    ],
    "it": [
      "Nel cuore della città, sulla penisola, a due passi da Place Bellecour, scoprite un ristorante dall'atmosfera calda e dall'arredamento accogliente."
    ],
    "fr": [
      "En plein centre-ville, sur la presqu’île à 2 pas de la place Bellecour, découvrez un restaurant à l’ambiance chaleureuse et à la décoration cosy."
    ],
    "nl": [
      "In het hart van de stad, op het schiereiland, op een steenworp afstand van Place Bellecour, ontdekt u een restaurant met een warme sfeer en een gezellige inrichting."
    ],
    "es": [
      "En el corazón de la ciudad, en la península, a dos pasos de la plaza Bellecour, descubra un restaurante de ambiente cálido y decoración acogedora."
    ]
  },
