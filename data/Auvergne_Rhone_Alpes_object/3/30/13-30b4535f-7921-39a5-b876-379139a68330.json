  "rdfs:comment": {
    "de": [
      "Der Food Truck La Note Gourmande ist die Geschichte von passionierten ambulanten Gastronomen, die Ihnen auf den Straßen der Drôme ihre Vision von der Küche näher bringen: frische, lokale und hochwertige Produkte."
    ],
    "en": [
      "The La Note Gourmande food truck is the story of two passionate travelling restaurateurs who share their vision of cuisine on the roads of the Drôme: fresh, local, quality products."
    ],
    "it": [
      "Il Food Truck La Note Gourmande è la storia di due persone appassionate di ristorazione mobile che vogliono farvi scoprire la loro visione della cucina sulle strade della Drôme: prodotti freschi, locali e di qualità."
    ],
    "fr": [
      "Le Food Truck La Note Gourmande, c'est l'histoire de passionnés de la restauration ambulante qui vous font découvrir leur vision de la cuisine sur les routes de la Drôme : produits frais, locaux et de qualité."
    ],
    "es": [
      "El Food Truck La Note Gourmande es la historia de dos personas apasionadas por la restauración móvil que quieren que descubra su visión de la cocina en las carreteras de la Drôme: productos frescos, locales y de calidad."
    ],
    "nl": [
      "De La Note Gourmande foodtruck is het verhaal van een groep gepassioneerde reizende restauranthouders die hun visie op de keuken meenemen op de wegen van de Drôme: verse, lokale kwaliteitsproducten."
    ]
  },
  "rdfs:label": {
