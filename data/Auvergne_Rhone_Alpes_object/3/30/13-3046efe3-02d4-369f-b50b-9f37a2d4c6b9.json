  "rdfs:comment": {
    "de": [
      "Die Bibliothek von Flaine ist eine Oase für Lesebegeisterte und bietet eine Auswahl an Werken für alle Altersgruppen, von Romanen bis hin zu Kinderbüchern."
    ],
    "en": [
      "The Flaine Library is a haven for book lovers, offering a selection of books for all ages, from novels to children's books."
    ],
    "it": [
      "La Biblioteca di Flaine è un paradiso per gli amanti dei libri e offre una selezione di libri per tutte le età, dai romanzi ai libri per bambini."
    ],
    "fr": [
      "La Bibliothèque de Flaine est un havre pour les passionnés de lecture, offrant une sélection d'ouvrages pour tous les âges, des romans aux livres pour enfants."
    ],
    "es": [
      "La Biblioteca de Flaine es un paraíso para los amantes de la lectura, ya que ofrece una selección de libros para todas las edades, desde novelas hasta libros infantiles."
    ],
    "nl": [
      "De bibliotheek van Flaine is een toevluchtsoord voor boekenliefhebbers en biedt een selectie boeken voor alle leeftijden, van romans tot kinderboeken."
    ]
  },
