  "rdfs:comment": {
    "de": [
      "Der Fluss breitet am Fuße des Pointe de Marcelly (1999 m) eine Reihe von Rinnsalen, Gouilles und Wasserfällen aus und hat einen leicht reißenden Charakter, der sich für das Wildwasserangeln eignet."
    ],
    "en": [
      "The river boasts a succession of riffles, pools and waterfalls, at the foot of the Pointe de Marcelly (1,999m). It is quite a fast-flowing river which makes it ideal for rapids fishing."
    ],
    "it": [
      "Il fiume, che si sviluppa in una successione di riffles, gullies e cascate ai piedi della Pointe de Marcelly (1999 m), ha un carattere leggermente torrentizio che si presta alla pesca in acque bianche."
    ],
    "fr": [
      "La rivière, qui étale une succession de radiers, gouilles et cascades, au pied de la pointe de Marcelly (1999 m), présente un caractère légèrement torrentueux qui se prête aux pêches d’eaux vives."
    ],
    "es": [
      "El río, que despliega una sucesión de rápidos, barrancos y cascadas al pie de la Pointe de Marcelly (1999 m), tiene un carácter ligeramente torrencial que se presta a la pesca en aguas bravas."
    ],
    "nl": [
      "De rivier bestaat uit een opeenvolging van stortebedden, plassen en watervallen, aan de voet van de Pointe de Marcelly (1999 m). Het water is licht kolkend, wat het een uitstekende plek voor wildwatervissen maakt."
    ]
  },
  "rdfs:label": {
