  "rdfs:comment": {
    "de": [
      "Nehmen Sie an einem musikalischen Abend teil und entdecken Sie das Tango-Orchester, das den Tangoball (Milonga) des Vereins Tango Volcanique in der Grange de Melussac in Cussas-sur-Loire am 21. März ab 20 Uhr beleben wird!"
    ],
    "en": [
      "Join us for a musical evening, and discover the tango orchestra that will be leading the Tango Volcanique association's tango ball (Milonga) at the Grange de Melussac in Cussas-sur-Loire on March 21, starting at 8pm!"
    ],
    "it": [
      "Venite a godervi una serata musicale con l'orchestra di tango che si esibirà alla milonga di tango dell'associazione Tango Volcanique nella Grange de Melussac a Cussas-sur-Loire il 21 marzo alle 20.00!"
    ],
    "fr": [
      "Venez participer à une soirée musical en découvrant l'orchestre tango qui animera le bal tango (Milonga) de l'association Tango Volcanique dans la Grange de Melussac à Cussas-sur-Loire le 21 mars dès 20h !"
    ],
    "es": [
      "Venga a disfrutar de una velada musical con la orquesta de tango que actuará en la Milonga de Tango de la asociación Tango Volcanique, en la Grange de Melussac, en Cussas-sur-Loire, el 21 de marzo a las 20:00 horas"
    ],
    "nl": [
      "Kom genieten van een muzikale avond met het tango-orkest dat zal optreden tijdens de Tango Milonga van de vereniging Tango Volcanique in de Grange de Melussac in Cussas-sur-Loire op 21 maart om 20.00 uur!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ateliers des Arts : Milonga / orchestre tango"
    ]
  },
