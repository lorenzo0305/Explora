  "rdfs:comment": {
    "de": [
      "Welcome to Brides-les-Bains! Sind Sie neu in unserem Ferienort? Feiern Sie Ihre Ankunft mit Musik der Gruppe And'Joy. Ab 17 Uhr wird warmer Rotwein angeboten!"
    ],
    "en": [
      "Welcome to Brides-les-Bains!\r\nHave you just arrived in our resort? Come and celebrate your arrival with Bélier Bleu Trio.\r\nFree mulled red wine from 5:00 pm!"
    ],
    "it": [
      "Benvenuti a Brides-les-Bains! Siete appena arrivati nel nostro resort? Venite a festeggiare il vostro arrivo con la band And'Joy. Vino rosso in omaggio dalle 17:00!"
    ],
    "fr": [
      "Welcome to Brides-les-Bains ! Vous venez de rejoindre notre station ? Venez fêter votre arrivée en musique avec le groupe And'Joy. Vin rouge chaud offert à partir de 17h !"
    ],
    "es": [
      "¡Bienvenido a Brides-les-Bains! ¿Acaba de incorporarse a nuestra estación? Venga a celebrar su llegada con el grupo And'Joy. Vino tinto de cortesía a partir de las 17 h"
    ],
    "nl": [
      "Welkom in Brides-les-Bains! Ben je net lid geworden van ons resort? Kom en vier je aankomst met de band And'Joy. Gratis rode wijn vanaf 17.00 uur!"
    ]
  },
  "rdfs:label": {
    "fr": [
