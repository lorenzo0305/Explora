  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/24bd2df3-360d-3844-8390-e8b06d8ef523",
      "dc:description": {
        "de": [
          "Lassen Sie sich inspirieren, um das Werk der Zeit und der Menschen auf diesem riesigen, 33 Hektar großen Gelände zu beobachten.Ein medizinischer Garten mit 104 Sorten wird gerade angelegt.\n "
        ],
        "en": [
          "Let yourself be inspired to observe the work of time and man on this vast 33-hectare site, where a medicinal garden is being created with 104 varieties.\n "
        ],
        "it": [
          "Lasciatevi ispirare dall'opera del tempo e dell'uomo in questo vasto sito di 33 ettari, dove è in corso di realizzazione un giardino medicinale con 104 varietà.\n "
        ],
        "fr": [
          "Laissez-vous porter par l'inspiration pour observer l'oeuvre du temps et des hommes sur ce vaste ensemble de 33 hectares.Un jardin médicinal est en cours de création avec 104 variétés.\n "
        ],
        "nl": [
          "Laat je inspireren om het werk van tijd en mens te observeren op dit uitgestrekte terrein van 33 hectare, waar een medicinale tuin wordt aangelegd met 104 variëteiten.\n "
        ],
        "es": [
          "Déjese inspirar para observar la obra del tiempo y del hombre en este vasto terreno de 33 hectáreas, donde se está creando un jardín medicinal con 104 variedades.\n "
        ]
      },
