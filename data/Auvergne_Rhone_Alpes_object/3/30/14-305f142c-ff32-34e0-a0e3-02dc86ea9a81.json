  "rdfs:comment": {
    "de": [
      "Der Schlosspark von Cercamp liegt in Frévent (Pas-de-Calais) im grünen Artois und steht in seiner Gesamtheit unter Denkmalschutz. Jede Epoche hat hier ihre Spuren hinterlassen."
    ],
    "en": [
      "Located in Frévent (Pas-de-Calais) in the green Artois region, and listed as a historic monument in its entirety, the grounds of Château de Cercamp have seen each era leave its mark."
    ],
    "it": [
      "Situato a Frévent (Pas-de-Calais), nella regione del verde Artois, e classificato come monumento storico nella sua interezza, il parco del Château de Cercamp ha visto ogni epoca lasciare il proprio segno."
    ],
    "fr": [
      "Situé à Frévent (Pas-de-Calais) dans l'Artois vert, classé monument historique dans son intégralité, la parc du château de Cercamp a vu chaque époque laisser son empreinte."
    ],
    "es": [
      "Situado en Frévent (Pas-de-Calais), en la región del Artois verde, y catalogado como monumento histórico en su totalidad, el recinto del castillo de Cercamp ha visto cómo cada época dejaba su huella."
    ],
    "nl": [
      "Het domein van Château de Cercamp ligt in Frévent (Pas-de-Calais) in de groene Artois-streek en staat in zijn geheel op de lijst van historische monumenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le parc du château de Cercamp"
    ]
  },
