  "rdfs:comment": {
    "de": [
      "Sports 360 ist ein Spezialist für den Verkauf und Verleih von Nordic-Ski-Ausrüstung und liegt gegenüber dem Biathlon-Stadion von Les Plans d'Hotonnes. Hier können Sie alles, was Sie zum Ski-Radfahren und Inlineskaten brauchen, mieten oder kaufen."
    ],
    "en": [
      "Specialist in the sale and rental of Nordic ski equipment facing the Plans d'Hotonnes biathlon stadium, Sports 360 provides you with all the equipment necessary for rollerskiing and rollerblading."
    ],
    "it": [
      "Situato di fronte allo stadio del biathlon di Les Plans d'Hotonnes, Sports 360 è specializzato nella vendita e nel noleggio di attrezzature per lo sci nordico. Abbiamo tutta l'attrezzatura necessaria per lo sci a rotelle e il pattinaggio in linea da noleggiare o acquistare."
    ],
    "fr": [
      "Spécialiste de la vente et de la location de matériel de ski nordique situé en face du stade de biathlon des Plans d'Hotonnes, Sports 360 a tout le matériel nécessaire à la pratique du ski roue et du roller en location ou à l'achat."
    ],
    "nl": [
      "Sports 360 is gevestigd tegenover het biatlonstadion in Les Plans d'Hotonnes en is gespecialiseerd in de verkoop en verhuur van nordic-skimateriaal. Je kunt bij ons alle materiaal dat je nodig hebt om te wheel-skiën en inline-skaten huren of kopen."
    ],
    "es": [
      "Situada frente al estadio de biatlón de Les Plans d'Hotonnes, Sports 360 está especializada en la venta y el alquiler de material de esquí nórdico. Disponemos de todo el material necesario para el esquí sobre ruedas y el patinaje en línea para alquilar o comprar."
    ]
  },
  "rdfs:label": {
    "en": [
      "Sports 360: Rollerski and rollerblade rental"
    ],
    "fr": [
      "Sports 360 : location de ski roue et roller"
    ]
  },
