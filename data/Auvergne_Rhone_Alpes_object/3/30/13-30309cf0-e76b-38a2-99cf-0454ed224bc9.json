  "rdfs:comment": {
    "de": [
      "Das Soi-Apogäum - Bach-Blumen-Beratungs-Kabinett & Energie-Pflege bietet personalisierte Sitzungen \"Ruhe-Entspannung\" je nach emotionaler Situation und Bedürfnis: Massagen, Fusswurzelreflexion Wellness, Kur für Blumen-Elixiere und mehr."
    ],
    "en": [
      "Cabinet advice in flowers of Bach and energy care."
    ],
    "it": [
      "L'Apogée de Soi - Consulenza sui fiori di Bach e sui trattamenti energetici, propone sedute personalizzate di \"riposo e relax\", adattate alla vostra situazione emotiva e alle vostre esigenze: massaggi, riflessologia plantare Well-Being, essenze floreali e altro..."
    ],
    "fr": [
      "L’Apogée de Soi - Cabinet conseils Fleurs de Bach & soins énergétiques, propose des séances personnalisées “repos-relaxation” selon votre situation émotionnelle et vos besoins : massages, réflexologie plantaire Bien Être, cure d’élixirs floraux et plus..."
    ],
    "nl": [
      "L'Apogée de Soi - adviesbureau voor Bach-bloesem- en energiebehandelingen, biedt gepersonaliseerde 'rust- en ontspanningssessies' op maat van uw emotionele situatie en uw behoeften: massages, voetreflexologie voor welzijn, bloemenessences en meer..."
    ],
    "es": [
      "L'Apogée de Soi - Asesoría en flores de Bach y tratamientos energéticos, ofrece sesiones personalizadas de \"descanso y relajación\" adaptadas a su situación emocional y a sus necesidades: masajes, reflexología podal Well-Being, esencias florales y mucho más..."
    ]
  },
