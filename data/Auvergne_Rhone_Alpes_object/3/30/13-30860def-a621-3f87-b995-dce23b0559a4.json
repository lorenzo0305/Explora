  "rdfs:comment": {
    "de": [
      "Le Blizart - Bistro du Marché & Bar Animé Weil wir die guten Produkte unserer Region lieben, ? Weil wir auch die Geschmäcker von anderswo lieben, ? Weil wir die Abwechslung lieben, ? Wir bieten Ihnen ein einzigartiges, frisches und hausgemachtes Menü."
    ],
    "en": [
      "Le Blizart - Bistro du Marché & Bar Animé Because we like good products from our region, ? because we also like flavors from elsewhere, ? Because we like change, ? We offer you a unique menu, fresh and homemade."
    ],
    "it": [
      "Le Blizart - Bistro du Marché & Bar Animé Perché ci piacciono i buoni prodotti della nostra regione, perché ci piacciono anche i sapori che vengono da altrove, ? Perché ci piace cambiare? Vi offriamo un menu unico, fresco e fatto in casa."
    ],
    "fr": [
      "Le Blizart - Bistro du Marché & Bar Animé Parce qu'on aime les bons produits de notre région, ​ Parce qu'on aime aussi les saveurs d'ailleurs, ​ Parce qu'on aime le changement, ​ Nous vous proposons un menu unique, frais et maison."
    ],
    "es": [
      "Le Blizart - Bistro du Marché & Bar Animé Porque nos gustan los buenos productos de nuestra región, ? porque también nos gustan los sabores de otros lugares, ? Porque nos gusta el cambio, ? Le ofrecemos un menú único, fresco y casero."
    ],
    "nl": [
      "Le Blizart - Bistro du Marché & Bar Animé Omdat we van goede producten uit onze streek houden, ? omdat we ook van smaken van elders houden, ? Omdat we van verandering houden, ? Wij bieden u een uniek menu, vers en huisgemaakt."
    ]
  },
