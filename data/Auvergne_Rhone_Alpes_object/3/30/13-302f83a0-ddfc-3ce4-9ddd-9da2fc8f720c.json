  "rdfs:comment": {
    "de": [
      "Bar - Schnellrestaurant, spezialisiert auf hausgemachtes Brathähnchen mit Burgern, Tenders, Hot Wings, French Pilons, Pommes frites, frischen Salaten und hausgemachten Desserts. Jede Woche Burger oder aktuelle Salate!"
    ],
    "en": [
      "Bar - fast food restaurant specialised in homemade fried chicken. Also offering burgers, tenders, hot wings, French drumsticks, fries, fresh salads and homemade desserts."
    ],
    "it": [
      "Bar - ristorante fast food specializzato in pollo fritto fatto in casa, che offre hamburger, tender, ali calde, bacchette francesi, patatine fritte, insalate fresche e dessert fatti in casa. L'hamburger o l'insalata del momento!"
    ],
    "fr": [
      "Bar - restaurant rapide spécialisé en poulet frit maison offrant burgers, tenders, hot wings, french pilons, frites, salades fraîches et desserts maison. Chaque semaine burger ou salade du moment!"
    ],
    "es": [
      "Bar - restaurante de comida rápida especializado en pollo frito casero que ofrece hamburguesas, tenders, alitas picantes, palillos franceses, patatas fritas, ensaladas frescas y postres caseros. La hamburguesa semanal o la ensalada del momento"
    ],
    "nl": [
      "Bar - fast food restaurant gespecialiseerd in huisgemaakte gefrituurde kip . Eveneens hamburgers, tenders, hot wings, Franse drumsticks, frietjes, verse salades en huisgemaakte desserts."
    ]
  },
