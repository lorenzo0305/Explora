  "rdfs:comment": {
    "de": [
      "Die Bibliothek wird von Freiwilligen geleitet und bietet eine vielfältige Auswahl an Werken (Sammlungen, Alben, Jugendromane, Comics, französische und ausländische Romane, Krimis, Dokumentarfilme, Einladung zu Reisen)."
    ],
    "en": [
      "The library is managed by volunteers and offers a varied choice of books (collections, albums, kids novels, comic books, French and foreign novels, police novels, documentaries, travel invitations)."
    ],
    "it": [
      "La biblioteca, gestita da volontari, offre una vasta gamma di libri (raccolte, album, romanzi per bambini, fumetti, romanzi francesi e stranieri, gialli, documentari, guide turistiche)."
    ],
    "fr": [
      "La bibliothèque, gérée par des bénévoles, propose un choix d’ouvrages très diversifié (collections, albums, romans jeunesse, BD, romans français et étrangers, policiers, documentaires, invitation aux voyages)."
    ],
    "es": [
      "La biblioteca, dirigida por voluntarios, ofrece una amplia gama de libros (colecciones, álbumes, novelas infantiles, cómics, novelas francesas y extranjeras, novelas policíacas, documentales, guías de viaje)."
    ],
    "nl": [
      "De bibliotheek, gerund door vrijwilligers, biedt een breed scala aan boeken (collecties, albums, kinderromans, strips, Franse en buitenlandse romans, detectiveverhalen, documentaires, reisgidsen)."
    ]
  },
