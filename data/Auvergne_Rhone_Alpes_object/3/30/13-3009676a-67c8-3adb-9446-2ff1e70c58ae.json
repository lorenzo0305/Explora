  "rdfs:comment": {
    "de": [
      "Ein professionelles Team, das Ihnen zuhört, kreativ ist und sich regelmäßig weiterbildet, um Ihnen die neuesten Trends anzubieten und dabei Ihre Persönlichkeit zu respektieren."
    ],
    "en": [
      "Hairdressing is our passion.we will make our meeting a moment of relaxation, unique pleasure.a professional team listening to you, creative, in regular training to offer the latest trends, while respecting your personality."
    ],
    "it": [
      "Un team dinamico vi accoglie proponendovi nuove tecniche e trattamenti naturali per un momento di relax."
    ],
    "fr": [
      "Une équipe dynamique vous accueille, en vous proposant de nouvelles techniques et des soins naturelles pour un moment de détente."
    ],
    "nl": [
      "We hebben een passie voor kappers, en we zorgen ervoor dat jouw afspraak met ons een uniek moment van ontspanning en plezier is. Een professioneel team dat naar je luistert, creatief is en regelmatig wordt bijgeschoold om je de laatste trends te kunnen bieden, met respect voor jouw persoonlijkheid."
    ],
    "es": [
      "Un equipo dinámico le da la bienvenida, ofreciéndole nuevas técnicas y tratamientos naturales para un momento de relajación."
    ]
  },
  "rdfs:label": {
    "fr": [
