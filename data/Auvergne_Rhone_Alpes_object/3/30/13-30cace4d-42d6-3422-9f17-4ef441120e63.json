  "rdfs:comment": {
    "de": [
      "Dieser 2,5 km lange „Catch and Release“-Kurs liegt auf einer Höhe von 1250 m in Haute Maurienne, flussabwärts von seinem Zusammenfluss mit dem Doron de Termignon, und ist ein Schatz, den es in einer atemberaubenden natürlichen Umgebung an der Grenze zum Vanoise-Park zu entdecken gilt."
    ],
    "en": [
      "Located at an altitude of 1250m in Haute Maurienne, downstream from its confluence with the Doron de Termignon, this 2.5km \"catch and release\" course is a treasure to discover in a stunning natural setting, on the borders of the Vanoise Park."
    ],
    "it": [
      "Situato a 1250 m di altitudine nell'Alta Maurienne, a valle della confluenza con il Doron de Termignon, questo percorso \"catch and release\" di 2,5 km è un tesoro da scoprire in uno scenario naturale mozzafiato, ai confini del Parco della Vanoise."
    ],
    "fr": [
      "Situé à 1250m d'altitude en Haute Maurienne, en aval de sa confluence avec le Doron de Termignon, ce parcours de 2,5 km \"prendre et relâcher\" est un trésor à découvrir dans un cadre naturel étourdissant, aux frontières du Parc de la Vanoise."
    ],
    "es": [
      "Situado a 1250 m de altitud en la Haute Maurienne, río abajo de su confluencia con el Doron de Termignon, este recorrido de 2,5 km \"captura y suelta\" es un tesoro por descubrir en un marco natural impresionante en los límites del Parque de la Vanoise."
    ],
    "nl": [
      "Dit 2,5 km lange \"catch and release\"-parcours ligt op 1250 meter hoogte in de Haute Maurienne, stroomafwaarts van de samenvloeiing met de Doron de Termignon. Het is een pareltje om te ontdekken in een adembenemende natuurlijke omgeving, aan de rand van het Vanoise Park."
    ]
  },
  "rdfs:label": {
    "de": [
      "No-Kill-Angelpfad „Passion“ von Arc nach Val Cenis (Sollières-Sardières)"
    ],
    "en": [
      "No-kill \"Passion\" Fishing Trail from Arc to Val Cenis (Sollières-Sardières)"
    ],
    "it": [
      "Sentiero di pesca No-kill \"Passion\" da Arc a Val Cenis (Sollières-Sardières)"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" No-kill de l'Arc à Val Cenis (Sollières-Sardières)"
    ],
    "nl": [
      "Vispad \"Passion\" zonder doden van Arc naar Val Cenis (Sollières-Sardières)"
    ]
  },
