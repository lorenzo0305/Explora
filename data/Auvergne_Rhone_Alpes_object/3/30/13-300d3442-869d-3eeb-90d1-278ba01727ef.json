  "rdfs:comment": {
    "de": [
      "Küche mit lokalen Produkten: Formel \"Tagesvorschlag\" unter der Woche, Pizzas und Burger (vor Ort oder zum Mitnehmen), Ravioli-Gratins, Desserts und Eis... Gemütlicher Rahmen.\r\nCatering-Service auf Bestellung für Gruppen (Cocktails, Mahlzeiten...)"
    ],
    "en": [
      "Cook using local products : \"suggestion of the day\" formula\" on weekdays, pizzas and burgers (eat in or take away), ravioli gratins, desserts and ice creams... Cosy setting. \r\nCatering service on order for groups (cocktails, meals...)"
    ],
    "it": [
      "Cucina a base di prodotti locali: menu \"proposta del giorno\" durante la settimana, pizze e hamburger (da mangiare o da portare via), ravioli gratinati, dolci e gelati... Atmosfera accogliente.\r\nServizio di catering su ordinazione per gruppi (cocktail, pasti...)"
    ],
    "fr": [
      "Cuisine à base de produits locaux : formule \"suggestion du jour\" en semaine, pizzas et burgers (sur place ou à emporter), gratins de ravioles, desserts et glaces... Cadre chaleureux.\r\nService traiteur sur commande pour les groupes (cocktails, repas...)"
    ],
    "nl": [
      "Keuken gebaseerd op lokale producten: \"suggestie van de dag\" menu tijdens de week, pizza's en hamburgers (eten of meenemen), ravioli gratins, desserts en ijsjes... Gezellige sfeer.\r\nCatering op bestelling voor groepen (cocktails, maaltijden...)"
    ],
    "es": [
      "Cocina basada en productos locales: menú del día entre semana, pizzas y hamburguesas (para comer o llevar), raviolis gratinados, postres y helados... Ambiente acogedor.\r\nServicio de catering por encargo para grupos (cócteles, comidas...)"
    ]
  },
