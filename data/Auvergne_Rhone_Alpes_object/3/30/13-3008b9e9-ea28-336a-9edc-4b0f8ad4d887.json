  "rdfs:comment": {
    "de": [
      "Das Polypode, benannt nach einem essbaren Farn, der in den Wäldern der Auvergne vorkommt, ist ein \"Neo-Bistro\"-Restaurant."
    ],
    "en": [
      "The Polypode, named after an edible fern found in the Auvergne forests, is a \"neo-bistro\" restaurant."
    ],
    "it": [
      "Il Polypode, che prende il nome da una felce commestibile presente nelle foreste dell'Alvernia, è un ristorante neo-bistrot."
    ],
    "fr": [
      "Le Polypode, du nom d’une fougère comestible que l’on trouve dans les forêts auvergnates, est un un restaurant \"néo-bistrot\"."
    ],
    "es": [
      "El Polipodo, llamado así por un helecho comestible que se encuentra en los bosques de Auvernia, es un restaurante neobistró."
    ],
    "nl": [
      "De Polypode, genoemd naar een eetbare varen uit de bossen van de Auvergne, is een \"neo-bistro\" restaurant."
    ]
  },
