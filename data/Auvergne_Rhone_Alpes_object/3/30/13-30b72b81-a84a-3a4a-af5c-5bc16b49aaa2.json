  "rdfs:comment": {
    "de": [
      "Genießen Sie einen geselligen Abend, der einen Kunsthandwerksmarkt mit einem Live-Konzert verbindet! Genießen Sie eine köstliche Mahlzeit aus der Region in einer gemütlichen Atmosphäre mit einem Gratiskonzert von Les ButterFlys."
    ],
    "en": [
      "Come and enjoy a convivial evening combining a craft market and a live concert! Enjoy a delicious local meal in a warm and friendly atmosphere, with a free concert by Les ButterFlys."
    ],
    "it": [
      "Venite a godervi una serata amichevole che combina un mercato artigianale e musica dal vivo! Gustate un delizioso pasto locale in un'atmosfera calda e accogliente, con la musica dal vivo gratuita dei Les ButterFlys."
    ],
    "fr": [
      "Venez profiter d'une soirée conviviale alliant marché artisanal et concert live ! Savourez un délicieux repas du terroir dans une ambiance chaleureuse avec Les ButterFlys en concert gratuit."
    ],
    "es": [
      "Venga a disfrutar de una agradable velada que combina mercado artesanal y música en directo Disfrute de una deliciosa comida local en un ambiente cálido y acogedor, con música en directo gratuita de Les ButterFlys."
    ],
    "nl": [
      "Kom genieten van een gezellige avond met een combinatie van een ambachtelijke markt en livemuziek! Geniet van een heerlijke lokale maaltijd in een warme en gezellige sfeer, met gratis livemuziek van Les ButterFlys."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les vendredis de l'andelot"
    ]
  },
