  "rdfs:comment": {
    "de": [
      "Entdecken Sie mitten im Zentrum von Aubenas das Café Popotte La Renaissance, einen charmanten Ort für eine süße oder herzhafte Pause. Jeden Tag wird Ihnen ein abwechslungsreiches Gericht mit subtilen Aromen angeboten. Frische Produkte aus der Region. Originelle und reichhaltige Getränkekarte."
    ],
    "en": [
      "In the heart of Aubenas, discover Café Popotte La Renaissance, a charming place to enjoy a sweet or savory treat. Every day, a varied menu with subtle flavors is on offer. Fresh, local produce. An original and extensive drinks menu."
    ],
    "it": [
      "Nel centro di Aubenas, scoprite il Café Popotte La Renaissance, un luogo incantevole per una pausa dolce o salata. Ogni giorno, serviamo un piatto vario dai sapori sottili. Prodotti freschi locali. Menu bevande originale e ben fornito"
    ],
    "fr": [
      "En plein centre d’Aubenas découvrez le Café Popotte La Renaissance, un lieu charmant pour une pause sucrée ou salée. Tous les jours, une assiette variée aux goûts subtils vous est proposée. Produits frais et locaux. Carte des boissons originale et fournie"
    ],
    "nl": [
      "Ontdek in het centrum van Aubenas Café Popotte La Renaissance, een charmante plek voor een zoete of hartige pauze. Elke dag wordt er een gevarieerd menu met subtiele smaken aangeboden. Verse en lokale producten. Originele en uitgebreide drankenkaart."
    ],
    "es": [
      "En el centro de Aubenas, descubra el Café Popotte La Renaissance, un lugar encantador para una pausa dulce o salada. Cada día, le servimos un plato variado de sabores sutiles. Productos locales frescos. Carta de bebidas original y bien surtida"
    ]
  },
