  "rdfs:comment": {
    "de": [
      "Die Domaine De Boisseyt, 11 Hektar Weinberge in den nördlichen Côtes du Rhône, stammt aus dem Jahr 1797 und ist damit das älteste Weingut in Chavanay. Heute schreibt Romain Decelle seine Geschichte mit Leidenschaft weiter."
    ],
    "en": [
      "Domaine De Boisseyt, 11 hectares of vines in the northern Côtes du Rhône, dates back to 1797 and is the oldest estate in Chavanay. Today, Romain Decelle continues to write its history with passion."
    ],
    "it": [
      "Il Domaine De Boisseyt, 11 ettari di vigneti nella Côtes du Rhône settentrionale, risale al 1797 ed è la più antica tenuta di Chavanay. Oggi Romain Decelle continua a scrivere la sua storia con passione."
    ],
    "fr": [
      "Le Domaine De Boisseyt, 11 hectares de vignes dans les Côtes du Rhône septentrionales, date de 1797 et s’impose comme le plus vieux domaine de Chavanay. Aujourd’hui, Romain Decelle continue d’écrire son histoire avec passion."
    ],
    "es": [
      "El Domaine De Boisseyt, con 11 hectáreas de viñedos en el norte de Côtes du Rhône, data de 1797 y es la finca más antigua de Chavanay. Hoy, Romain Decelle sigue escribiendo su historia con pasión."
    ],
    "nl": [
      "Domaine De Boisseyt, 11 hectare wijngaarden in het noorden van de Côtes du Rhône, dateert uit 1797 en is het oudste domein van Chavanay. Vandaag blijft Romain Decelle met passie zijn geschiedenis schrijven."
    ]
  },
  "rdfs:label": {
