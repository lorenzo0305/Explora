      "@id": "https://data.datatourisme.fr/91e622e1-6a27-31e1-85d2-d749ab4cd110",
      "dc:description": {
        "de": [
          "Darstellung des Werdegangs von Herrn Vozel, einem Widerstandskämpfer aus Loossois, der nach Mauthausen deportiert wurde. Diese Ausstellung wurde von Danyèle Régerat unter Mitwirkung der Kinder von Vincent Vozel zusammengestellt."
        ],
        "en": [
          "Presentation of the life story of Monsieur Vozel, a Loossois Resistance fighter deported to Mauthausen. This exhibition was compiled by Danyèle Régerat with the help of Vincent Vozel's children."
        ],
        "it": [
          "Presentazione della storia del signor Vozel, membro della Resistenza di Looss e deportato a Mauthausen. Questa mostra è stata realizzata da Danyèle Régerat con l'aiuto dei figli di Vincent Vozel."
        ],
        "fr": [
          "Présentation du parcours de Monsieur Vozel, Loossois résistant déporté à Mauthausen. Cette exposition a été compilée par Danyèle Régerat avec le concours des enfants de Vincent Vozel."
        ],
        "nl": [
          "Presentatie van het verhaal van de heer Vozel, lid van het Looss Verzet en gedeporteerd naar Mauthausen. Deze tentoonstelling is samengesteld door Danyèle Régerat met de hulp van de kinderen van Vincent Vozel."
        ],
        "es": [
          "Presentación de la historia del Sr. Vozel, miembro de la Resistencia de Looss que fue deportado a Mauthausen. Esta exposición ha sido realizada por Danyèle Régerat con la ayuda de los hijos de Vincent Vozel."
        ]
      },
