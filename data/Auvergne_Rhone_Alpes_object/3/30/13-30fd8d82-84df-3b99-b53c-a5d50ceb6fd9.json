  "rdfs:comment": {
    "de": [
      "Das Relais du Serre liegt in einer grünen, ruhigen Umgebung, 3 km von Dieulefit entfernt, und empfängt Sie in einer freundlichen Atmosphäre. Der Küchenchef bietet Ihnen eine raffinierte, gastronomische Küche mit regionalen Aromen."
    ],
    "en": [
      "Situated in a calm and green setting, 3 kilometers from Dieulefit, \"le Relais du Serre\" welcomes you in a friendly atmosphere."
    ],
    "it": [
      "Situato in un ambiente tranquillo e verde, a 3 km da Dieulefit, il Relais du Serre vi accoglie in un'atmosfera amichevole. Lo chef propone una cucina raffinata e gastronomica con sapori locali."
    ],
    "fr": [
      "Situé dans un cadre de verdure, au calme, à 3 km de Dieulefit, le Relais du Serre vous accueillera dans une ambiance sympathique. Le chef vous propose une cuisine raffinée et gastronomique aux saveurs du terroir."
    ],
    "es": [
      "Situado en un entorno tranquilo y verde, a 3 km de Dieulefit, el Relais du Serre le acogerá en un ambiente acogedor. El chef ofrece una cocina refinada y gastronómica con sabores locales."
    ],
    "nl": [
      "Het Relais du Serre biedt een warm welkom in een rustige, groene omgeving op 3 km van Dieulefit. De chef biedt een verfijnde, gastronomische keuken met lokale smaken."
    ]
  },
