  "rdfs:comment": {
    "de": [
      "Die Füße im Wasser, der Blick auf La Meije und den Parc National des Écrins? Das ist alles!\r\nDas Schwimmbad bietet einen Cafeteria-Bereich\r\nBadekappe empfohlen, aber nicht obligatorisch, Badeshorts verboten."
    ],
    "en": [
      "Feet in the water, a view of La Meije and the Ecrins National Park! That's all there is to it!\r\nRules and regulations: 1 or 2-piece bathing suit and close-fitting swimwear: briefs, boxer shorts. Bathing cap recommended but not compulsory."
    ],
    "it": [
      "Con i piedi nell'acqua, vista su La Meije e sul Parco Nazionale degli Ecrins! Non c'è altro da aggiungere!\r\nLa piscina dispone di un'area caffetteria\r\nLa cuffia è consigliata ma non obbligatoria, i pantaloncini da bagno non sono ammessi."
    ],
    "fr": [
      "Les pieds dans l’eau, la vue sur La Meije et le parc National des Écrins ! Rien que cela !\r\nLa piscine propose un espace cafétaria \r\nBonnet de bain recommandé mais non obligatoire, shorts de bain interdits."
    ],
    "nl": [
      "Voeten in het water, uitzicht op La Meije en het Ecrins National Park! Meer is het niet!\r\nRegels: 1 of 2-delige zwemkleding en nauwsluitende zwemkleding: slip, boxershort. Badmuts aanbevolen maar niet verplicht."
    ],
    "es": [
      "Con los pies en el agua, ¡una vista de La Meije y del Parque Nacional de los Ecrins! Eso es todo\r\nLa piscina dispone de una zona de cafetería\r\nSe recomienda llevar gorro de baño, pero no es obligatorio; no se permite el uso de bañador corto."
    ]
  },
  "rdfs:label": {
    "en": [
      "Panoramic covered swimming pool"
    ],
    "fr": [
      "Piscine panoramique couverte"
    ],
    "nl": [
      "Panoramisch overdekt zwembad"
    ]
  },
