  "rdfs:comment": {
    "de": [
      "Besuchen Sie jeden Sonntagmorgen den Kreativmarkt und den Kunsthandwerksmarkt. Kreation, Handwerk und Kunsthandwerk erwarten Sie auf einem der historischen Märkte von Lyon."
    ],
    "en": [
      "You'll find the Design Market and the Crafts Market every Sunday morning. Creation, Crafts and Arts and Crafts await you in one of Lyon's historic markets."
    ],
    "it": [
      "Troverete il Mercato del Design e il Mercato dell'Artigianato ogni domenica mattina. Creazione, artigianato e arti e mestieri vi aspettano in uno dei mercati storici di Lione."
    ],
    "fr": [
      "Retrouvez le marché de la Création et le marché de l’Artisanat tous les dimanches matin. Création, Artisanat et Artisanat d’Art vous attendent dans l’un des marchés historiques de Lyon."
    ],
    "es": [
      "Encontrará el Mercado de Diseño y el Mercado de Artesanía todos los domingos por la mañana. Creación, Artesanía y Manualidades le esperan en uno de los mercados históricos de Lyon."
    ],
    "nl": [
      "Bezoek elke zondagochtend de Design & Craft Markets. Creatie, handwerk en kunstnijverheid wachten op je op een van de historische markten van Lyon."
    ]
  },
