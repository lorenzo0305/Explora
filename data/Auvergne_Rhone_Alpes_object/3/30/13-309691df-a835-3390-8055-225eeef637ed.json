  "rdfs:comment": {
    "de": [
      "Unser Gourmet-Restaurant Le C?ur ist Sommer wie Winter geöffnet und empfängt Sie schon zum Frühstück mit einem abwechslungsreichen Süßigkeitenbuffet."
    ],
    "en": [
      "Open in both summer and winter, our gourmet restaurant Le Cœur welcomes you as from breakfast with its buffet of varied sweets."
    ],
    "it": [
      "Aperto sia d'estate che d'inverno, il nostro ristorante gourmet Le C?ur vi accoglie a colazione con il suo buffet di dolciumi."
    ],
    "fr": [
      "Ouvert été comme hiver, notre restaurant gourmand Le Cœur vous accueille dès le petit déjeuner avec son buffet de douceurs variées."
    ],
    "nl": [
      "Open gedurende zomer en winter, ons gastronomische restaurant Le Cœur verwelkomt u vanaf het ontbijt met een buffet van gevarieerde zoetigheden."
    ],
    "es": [
      "Abierto tanto en verano como en invierno, nuestro restaurante gastronómico Le Cœur le da la bienvenida en el desayuno con su bufé de golosinas variadas."
