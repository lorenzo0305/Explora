  "rdfs:comment": {
    "de": [
      "Was auch immer Ihr Skistil oder Ihre Disziplin ist, die 50 Skilehrer der École du Ski Français Les Karellis empfangen Sie zwischen Know-how und Freude am Skifahren!"
    ],
    "en": [
      "Whatever your skiing style or discipline, the 50 instructors of the Les Karellis French Ski School will welcome you, between know-how and pleasure of skiing!"
    ],
    "it": [
      "Qualunque sia il vostro stile o la vostra disciplina sciistica, i 50 maestri della scuola francese di sci Les Karellis vi accoglieranno con la loro esperienza e il loro piacere!"
    ],
    "fr": [
      "Quel que soit votre style de ski ou votre discipline, les 50 moniteurs de l'École du Ski Français Les Karellis vous accueillent, entre savoir-faire et plaisir de la glisse !"
    ],
    "nl": [
      "Wat uw skistijl of discipline ook is, de 50 instructeurs van de Franse skischool Les Karellis verwelkomen u met hun expertise en plezier!"
    ],
    "es": [
      "Sea cual sea su estilo o disciplina de esquí, los 50 monitores de la Escuela de Esquí Francés Les Karellis le acogerán con su experiencia y placer"
    ]
  },
