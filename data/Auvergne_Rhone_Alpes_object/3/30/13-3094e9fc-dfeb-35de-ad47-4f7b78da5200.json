  "rdfs:comment": {
    "de": [
      "Die Domaine de Balbuzard mit ihren 7 Hektar Fläche liegt in der Gemeinde Condat-en-Combraille (63).\r\nDer Teich wird jeden Winter mit Barschen, Hechten, Zandern und Schwarzbarschen besetzt und dient hauptsächlich dem Angeln von Raubfischen.100 % No Kill"
    ],
    "en": [
      "The 7-hectare Domaine de Balbuzard is located in the commune of Condat-en-Combraille (63).\r\nDedicated mainly to carnivore fishing, this pond is stocked every winter with perch, pike, zander and blackbass.100% no kill"
    ],
    "it": [
      "Con i suoi 7 ettari di superficie, il dominio di Balbuzard si trova nel comune di Condat-en-Combraille (63).\r\nDedicato principalmente alla pesca carnivora, questo laghetto viene rifornito ogni inverno di pesce persico, luccio, luccioperca e blackbass. 100% no kill"
    ],
    "fr": [
      "Avec ses 7 hectares de plan, le domaine de Balbuzard se situe sur la commune de Condat-en-Combraille (63).\r\nConsacré principalement à la pêche du carnassier, cet étang est empoissonné tous les hivers en perches, brochets, sandres et blackbass.100 % no kill"
    ],
    "nl": [
      "Het domein van Balbuzard, met een oppervlakte van 7 hectare, ligt in de gemeente Condat-en-Combraille (63).\r\nDeze vijver, die voornamelijk bestemd is voor de vleesvisserij, wordt elke winter uitgezet met baars, snoek, snoekbaars en blackbass. 100% no kill"
    ],
    "es": [
      "Con sus 7 hectáreas de plan, el dominio de Balbuzard se encuentra en la comuna de Condat-en-Combraille (63).\r\nDedicado principalmente a la pesca de carnívoros, este estanque se abastece cada invierno de percas, lucios, luciopercas y blackbass. 100% sin muerte"
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Lac du Balbuzard"
    ],
    "en": [
      "Fishing site - Lac du Balbuzard"
    ],
    "fr": [
      "Site de pêche - Lac du Balbuzard"
    ]
  },
