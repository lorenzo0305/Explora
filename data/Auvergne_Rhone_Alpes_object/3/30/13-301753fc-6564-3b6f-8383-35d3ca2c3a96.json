  "rdfs:comment": {
    "de": [
      "Erholung pur am Fuße des Puy Mary. Ob nach einer Wanderung oder einem kleinen Spaziergang, hier können Sie die wohltuende Wirkung von Wasser und Wärme genießen! Sauna und Hammam: für maximal 12 Personen. Schwedische Badetonne: für maximal 5 Personen."
    ],
    "en": [
      "Relaxation for all at the foot of Puy Mary. On your return from a hike, or after a breath of fresh air, come and enjoy the relaxing benefits of hot water!"
    ],
    "it": [
      "Relax per tutti ai piedi del Puy Mary. Al ritorno da un'escursione o dopo una semplice boccata d'aria, venite a godere dei benefici rilassanti dell'acqua calda!"
    ],
    "fr": [
      "Détente pour tous au pied du Puy Mary. Au retour de rando, ou après un simple bol d'air pur, venez profiter des bienfaits relaxants de l'eau chaude!"
    ],
    "es": [
      "Relajación para todos a los pies del Puy Mary. A la vuelta de una excursión, o después de un simple soplo de aire fresco, ¡venga a disfrutar de los beneficios relajantes del agua caliente!"
    ],
    "nl": [
      "Ontspanning voor iedereen aan de voet van de Puy Mary. Kom bij terugkomst van een wandeling of na een frisse neus te hebben gehaald, genieten van de ontspannende weldaden van het warme water!"
    ]
  },
  "rdfs:label": {
    "de": [
      "Alta Terra : Hammam, Sauna und schwedische Badetonne"
    ],
    "en": [
      "Sauna, steam bath and Nordic bath - Alta Terra"
    ],
    "fr": [
      "Sauna, hammam et bain nordique - Alta Terra"
    ]
  },
