  "rdfs:comment": {
    "de": [
      "Le Rousseau ist ein gemütliches Ambiente für Ihre Lust auf kulinarische Entdeckungen. Destandardisierte, qualitativ hochwertige, frische, lokale und saisonale Produkte. Eine elegante Küche, die von Chefkoch Elie Michel-Villaz zubereitet wird."
    ],
    "en": [
      "Le Rousseau is a warm setting for your desires for culinary discovery. De-standardized, quality, fresh, local and seasonal products. Elegant cuisine, made by Chef Elie Michel-Villaz."
    ],
    "it": [
      "Le Rousseau è un ambiente accogliente per le vostre scoperte culinarie. Prodotti de-standardizzati, di qualità, freschi, locali e di stagione. Cucina elegante, preparata dallo chef Elie Michel-Villaz."
    ],
    "fr": [
      "Le Rousseau c’est un écrin chaleureux pour vos envies de découverte culinaire. Des produits dé-standardisé, de qualité, frais, locaux et de saisons. Une cuisine élégante, faite par le Chef Elie Michel-Villaz."
    ],
    "nl": [
      "Le Rousseau is een warm kader voor uw culinaire ontdekkingen. Gestandaardiseerde, kwaliteitsvolle, verse, lokale en seizoensgebonden producten. Elegante keuken, bereid door Chef Elie Michel-Villaz."
    ],
    "es": [
      "Le Rousseau es un marco cálido para sus descubrimientos culinarios. Productos de calidad, frescos, locales y de temporada. Cocina elegante del Chef Elie Michel-Villaz."
    ]
  },
