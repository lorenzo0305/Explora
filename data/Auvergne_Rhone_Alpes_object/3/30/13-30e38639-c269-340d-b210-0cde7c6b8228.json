  "rdfs:comment": {
    "de": [
      "Die Elternvereinigung (APE) l'Euro de l'école unterstützt die Schule in Vassieux-en-Vercors, indem sie Veranstaltungen organisiert, um Bildungsprojekte, Schulausflüge und außerschulische Aktivitäten zu finanzieren: Verkauf von Blumen, Verkauf von Zitrusfrüchten ..."
    ],
    "en": [
      "The Euro de l'école Parents' Association (APE) supports the Vassieux-en-Vercors school by organizing events to finance educational projects, school outings and extracurricular activities: flower sales, citrus fruit sales, etc."
    ],
    "it": [
      "L'Associazione Genitori Euro de l'école (APE) sostiene la scuola di Vassieux-en-Vercors organizzando eventi per finanziare progetti educativi, gite scolastiche e attività extrascolastiche: vendita di fiori, vendita di agrumi, ecc."
    ],
    "fr": [
      "L'Association des Parents d'Élèves (APE) l'Euro de l'école soutient l'école de Vassieux-en-Vercors en organisant des événements pour financer des projets éducatifs, sorties scolaires et activités extrascolaires : vente de fleurs, vente d'agrumes ..."
    ],
    "es": [
      "La Asociación de Padres de Alumnos Euro de l'école (APE) apoya a la escuela de Vassieux-en-Vercors organizando eventos para financiar proyectos educativos, salidas escolares y actividades extraescolares: venta de flores, venta de cítricos, etc."
    ],
    "nl": [
      "De oudervereniging Euro de l'école (APE) steunt de school in Vassieux-en-Vercors door evenementen te organiseren om educatieve projecten, schoolreisjes en buitenschoolse activiteiten te financieren: bloemenverkoop, citrusvruchtenverkoop, enz."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'EURO DE L'ECOLE DE VASSIEUX"
    ]
  },
