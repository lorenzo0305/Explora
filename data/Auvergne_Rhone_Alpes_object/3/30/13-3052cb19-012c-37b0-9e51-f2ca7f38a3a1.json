  "rdfs:comment": {
    "de": [
      "Unser kleines Bergrestaurant ist in diesem Winter von Dienstag bis Samstag zum Mittagessen geöffnet.\r\nSavoyische Spezialitäten und hausgemachte Desserts, heiße Getränke und leckere Snacks.\r\nIn der Nähe des Holzofens oder auf der Terrasse inmitten des Tuéda-Reservats, das zu Fuß erreichbar ist."
    ],
    "en": [
      "Lovely mountain restaurant in a wonderful place. Open for lunch and drinks from Tuesday to Saturday this winter. On the sunny terrace or by the wood stove with a hot chocolate, mulled wine..Easily accessible by foot in 30 minutes."
    ],
    "it": [
      "Il nostro piccolo ristorante di montagna è aperto a pranzo dal martedì al sabato di quest'inverno.\r\nSpecialità savoiarde e dolci fatti in casa, bevande calde e spuntini gourmet.\r\nAccanto alla stufa a legna o sulla terrazza, nel cuore della riserva di Tuéda, facilmente raggiungibile a piedi."
    ],
    "fr": [
      "Notre petit restaurant de montagne est ouvert le midi du mardi au samedi cet hiver.\r\nSpécialités savoyardes et desserts maison, boissons chaudes et goûters gourmands.\r\nPrès du poêle à bois ou en terrasse au milieu de la réserve de Tuéda, accessible à pied."
    ],
    "nl": [
      "Het restaurant Refuge du Plan is in de winter 's avonds alleen op reservering geopend. Savoyaardse specialiteiten en huisgemaakte desserts."
    ],
    "es": [
      "Este invierno, nuestro pequeño restaurante de montaña abre al mediodía de martes a sábado.\r\nEspecialidades saboyanas y postres caseros, bebidas calientes y aperitivos gourmet.\r\nJunto a la estufa de leña o en la terraza, en plena reserva de Tuéda, a poca distancia a pie."
    ]
  },
