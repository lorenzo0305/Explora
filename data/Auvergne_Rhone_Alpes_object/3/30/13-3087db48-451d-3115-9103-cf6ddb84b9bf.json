  "rdfs:comment": {
    "de": [
      "Christine Verda ist Korbmacherin und Absolventin der Nationalen Schule für Weidenzucht und Korbflechterei. Sie bietet traditionelle und individuelle Korbflechterei aus weißer oder naturbelassener Weide an. Außerdem führt sie Einführungs- und Fortgeschrittenenkurse durch und repariert Weidenkörbe."
    ],
    "en": [
      "Christine Verda is a basket-maker and a graduate of the Ecole Nationale d'Osiériculture et de Vannerie.\r\nTraditional and made-to-measure wickerwork, in white or raw willow. Introductory and advanced courses. Repair of wickerwork."
    ],
    "it": [
      "Christine VERDA è cestaia e diplomata all'Ecole Nationale d'Osiériculture et de Vannerie.\r\nLavori in vimini tradizionali e su misura, in vimini bianco o grezzo. Corsi introduttivi e avanzati. Riparazione di oggetti in vimini."
    ],
    "fr": [
      "Christine VERDA est vannière, diplômée de l’Ecole Nationale d’Osiériculture et de Vannerie.\r\nVannerie traditionnelle et sur-mesure, en osier blanc ou brut. Stages d’initiation et d’approfondissement. Réparation d’articles en osier."
    ],
    "nl": [
      "Christine Verda is mandenvlechtster, afgestudeerd aan de Nationale School voor Wilgenteelt en Mandenvlechten.\r\n\r\nTraditionele en op maat gemaakte manden, van witte of natuurlijke wilgentakken. Workshops voor beginners en gevorderden. Reparatie van wilgentakken."
    ],
    "es": [
      "Christine VERDA es cestera y diplomada de la Escuela Nacional de Osiéricultura y Vanderismo.\r\nCestería tradicional y a medida, en mimbre blanco o crudo. Cursos de iniciación y perfeccionamiento. Reparación de artículos de mimbre."
    ]
  },
