  "rdfs:comment": {
    "de": [
      "Leichter Rundweg um den Teich von Chalignieu in Chozeau. Entdecken Sie zwischen Schilfgürteln und Feuchtwiesen die Flora und Fauna dieses sensiblen Naturraums, der Zufluchtsort der Europäischen Sumpfschildkröte und zahlreicher Vogelarten ist."
    ],
    "en": [
      "An easy loop around the Etang de Chalignieu in Chozeau. Between reedbeds and wet meadows, discover the flora and fauna of this sensitive natural area, home to the European pond terrapin and numerous bird species."
    ],
    "it": [
      "Un facile giro intorno all'Etang de Chalignieu a Chozeau. Tra canneti e prati umidi, scoprite la flora e la fauna di quest'area naturale sensibile, che ospita la tartaruga europea e molte specie di uccelli."
    ],
    "fr": [
      "Boucle facile autour de l’étang de Chalignieu à Chozeau. Entre roselières et prairies humides, découvrez la faune et la flore de cet Espace Naturel Sensible, refuge de la Cistude d’Europe et de nombreuses espèces d’oiseaux."
    ],
    "es": [
      "Un bucle fácil alrededor del Etang de Chalignieu, en Chozeau. Entre cañaverales y praderas húmedas, descubra la flora y la fauna de este espacio natural sensible, hábitat del galápago europeo y de numerosas especies de aves."
    ],
    "nl": [
      "Een gemakkelijke lus rond het Etang de Chalignieu in Chozeau. Ontdek tussen rietvelden en natte weiden de flora en fauna van dit kwetsbare natuurgebied, waar de Europese moerasschildpad en vele vogelsoorten leven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Balade pédestre en famille autour de l'étang de Chalignieu"
    ]
  },
