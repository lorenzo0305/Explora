  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cc330684-fd23-317d-b3d8-a30e8a76244e",
      "dc:description": {
        "de": [
          "\"14. Europäische Tage des Kulturerbes am Calot-Institut\" im Saal Jean XXII des Calot-Instituts - täglich von 14.00 bis 17.00 Uhr\n Ausstellungen über die Ursprünge der Krankenhäuser, die kaiserliche Familie und Hommage an Olga Chipiloff\n\n+ weitere Informationen https://www.facebook.com/societedhistoire.berck"
        ],
        "en": [
          "\"14th European Heritage Days at the Institut Calot\" in the Salle Jean XXII of the Institut Calot - daily from 2pm to 5pm\n Exhibitions on the origins of hospitals, the Imperial family and a tribute to Olga Chipiloff\n\n+ info https://www.facebook.com/societedhistoire.berck"
        ],
        "it": [
          "\"14° Giornate Europee del Patrimonio all'Institut Calot\" nella Salle Jean XXII dell'Institut Calot - tutti i giorni dalle 14:00 alle 17:00\n Mostre sulle origini degli ospedali, sulla famiglia imperiale e un omaggio a Olga Chipiloff\n\n+ Maggiori informazioni https://www.facebook.com/societedhistoire.berck"
        ],
        "fr": [
          "« 14ème Journées Européennes du Patrimoine à l’Institut Calot » à la salle Jean XXII de l’Institut Calot - tous les jours de 14h à 17h \n Expositions sur les origines des hôpitaux, la famille Impériale et hommage à Olga Chipiloff \n\n+ d'infos https://www.facebook.com/societedhistoire.berck"
        ],
        "es": [
          "\"XIV Jornadas Europeas del Patrimonio en el Instituto Calot\" en la Sala Jean XXII del Instituto Calot - todos los días de 14.00 a 17.00 horas\n Exposiciones sobre los orígenes de los hospitales, la familia imperial y homenaje a Olga Chipiloff\n\n+ Más información https://www.facebook.com/societedhistoire.berck"
        ],
        "nl": [
          "\"14e Europese Erfgoeddagen in het Institut Calot\" in de Salle Jean XXII van het Institut Calot - elke dag van 14u tot 17u\n Tentoonstellingen over de oorsprong van ziekenhuizen, de keizerlijke familie en een eerbetoon aan Olga Chipiloff\n\n+ Meer informatie https://www.facebook.com/societedhistoire.berck"
        ]
      },
