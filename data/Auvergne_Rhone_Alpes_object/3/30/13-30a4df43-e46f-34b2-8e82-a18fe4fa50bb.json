  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet Ihnen eine Auswahl von 7000 Büchern und 20 Abonnements für verschiedene Zeitschriften. Fast 150 CDs und etwa 100 DVDs. Hier finden Sie bestimmt das Buch oder die DVD, die Sie interessiert. Dieser Ort profitiert auch von einem Entspannungsbereich."
    ],
    "en": [
      "The library offers a choice of 7,000 books and 20 magazine subscriptions. Nearly 150 CDs and a hundred DVDs. You're sure to find the book or DVD that interests you. The library also boasts a relaxation area."
    ],
    "it": [
      "La biblioteca offre una scelta di 7.000 libri e 20 abbonamenti a riviste. Quasi 150 CD e un centinaio di DVD. Troverete sicuramente il libro o il DVD che vi interessa. La biblioteca dispone anche di un'area relax."
    ],
    "fr": [
      "La bibliothèque vous propose un choix de 7000 livres et de 20 abonnements à différents magazines. Près de 150 CD et une centaine de DVD. Vous trouverez certainement le livre ou DVD qui vous intéresse. Ce lieu bénéficie également d'un espace détente."
    ],
    "es": [
      "La biblioteca ofrece una selección de 7.000 libros y 20 suscripciones a revistas. Cerca de 150 CD y un centenar de DVD. Seguro que encuentras el libro o DVD que te interesa. La biblioteca también dispone de una zona de descanso."
    ],
    "nl": [
      "De bibliotheek biedt een keuze uit 7.000 boeken en 20 tijdschriftabonnementen. Bijna 150 cd's en een honderdtal dvd's. Je vindt zeker het boek of de dvd die je interesseert. De bibliotheek heeft ook een ontspanningsruimte."
    ]
  },
  "rdfs:label": {
