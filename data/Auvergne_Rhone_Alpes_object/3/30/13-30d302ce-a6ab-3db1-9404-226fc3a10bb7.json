  "rdfs:comment": {
    "de": [
      "Cécile hat sich mit ihren 8 Kühen der Rasse Brune des Alpes im Dorf Ouche niedergelassen.  Ab dem ersten Quartal 2024 wird sie ihre Käse, Joghurts und andere Produkte auf den Märkten von Champagne en Valromey und Belley anbieten"
    ],
    "en": [
      "Cécile lives in the village of Ouche with her 8 Brune des Alpes cows.  From the first quarter of 2024, she will be selling her cheeses, yoghurts and other products at the Champagne en Valromey and Belley markets.\r\nCurrent products: yoghurt, lactic cheeses, honey cheese, tomme, raclette (plain, pepper, cumin and fenigrec)."
    ],
    "it": [
      "Cécile risiede nel villaggio di Ouche con le sue 8 mucche Brune des Alpes.  Dal primo trimestre del 2024, Cécile venderà i suoi formaggi, yogurt e altri prodotti nei mercati di Champagne en Valromey e Belley"
    ],
    "fr": [
      "Cécile est installée dans le village d'Ouche avec ses 8 vaches de race Brune des Alpes.  A partir du premier trimestre 2024, elle proposera ses fromages, yaourts et autres productions sur les marchés de Champagne en Valromey et Belley"
    ],
    "nl": [
      "Cécile is gevestigd in het dorp Ouche met haar 8 Brune des Alpes koeien.  Vanaf het eerste kwartaal van 2024 verkoopt ze haar kazen, yoghurts en andere producten op markten in Champagne en Valromey en Belley"
    ],
    "es": [
      "Cécile está instalada en el pueblo de Ouche con sus 8 vacas Brune des Alpes.  A partir del primer trimestre de 2024, venderá sus quesos, yogures y otros productos en los mercados de Champagne en Valromey y Belley"
    ]
  },
  "rdfs:label": {
    "en": [
      "Cécile Clerc - cow's cheese"
    ],
    "fr": [
      "Cécile Clerc - Aux pas des Brunes - fromage de vaches"
    ]
  },
