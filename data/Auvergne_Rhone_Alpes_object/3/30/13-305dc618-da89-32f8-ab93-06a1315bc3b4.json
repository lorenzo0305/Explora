  "rdfs:comment": {
    "de": [
      "WOODY liegt im Herzen des Vallée d'Aulps und ist ein Indoor-Freizeitkomplex der neuen Generation, der Aktivitäten, Gastronomie und Unterhaltung an einem Ort vereint."
    ],
    "en": [
      "Located in the heart of the Vallée d'Aulps, WOODY is a new-generation indoor leisure complex combining activities, dining and entertainment in one place."
    ],
    "it": [
      "Situato nel cuore della Vallée d'Aulps, WOODY è un complesso ricreativo indoor di nuova generazione che combina attività, ristoranti e intrattenimento in un unico luogo."
    ],
    "fr": [
      "Situé au cœur de la Vallée d’Aulps, WOODY est un complexe de loisirs indoor nouvelle génération réunissant activités, restauration et divertissement dans un même lieu."
    ],
    "nl": [
      "WOODY, gelegen in het hart van de Vallée d'Aulps, is een nieuwe generatie overdekt recreatiecomplex dat activiteiten, restaurants en entertainment op één plek combineert."
    ],
    "es": [
      "Situado en el corazón del Valle de Aulps, WOODY es un complejo de ocio cubierto de nueva generación que combina actividades, restaurantes y entretenimiento en un solo lugar."
    ]
