  "rdfs:comment": {
    "de": [
      "KOMMEMORATIVE KEREMONIE - 80. Jahrestag der Erschossenen\r\n09.30 Uhr: Gedenkmesse in der Kirche\r\n10.30 Uhr: Aufstellung vor dem Rathaus, Umzug, Zeremonie und Kranzniederlegung am Kriegerdenkmal und am Hof der Erschossenen"
    ],
    "en": [
      "COMMEMORATIVE CEREMONY - 80th anniversary of the Fusillés (shootings)\r\n09:30: Mass of Remembrance at the Church\r\n10:30am: Gather in front of the Town Hall, move on, ceremony and wreath-laying at the Monument aux Morts and Cour des Fusillés"
    ],
    "it": [
      "CERIMONIA MEMORIALE - 80° anniversario della sparatoria\r\n09:30: Messa di commemorazione in chiesa\r\n10.30: raduno davanti al Municipio, spostamento, cerimonia e deposizione di corone al Monument aux Morts e alla Cour des Fusillés"
    ],
    "fr": [
      "CÉRÉMONIE COMMÉMORATIVE - 80ème anniversaire des Fusillés\r\n09h30 : Messe du souvenir à l’Église\r\n10h30 : Regroupement devant la Mairie, déplacement, cérémonie et dépôt de gerbes au Monument aux Morts ainsi qu’à la Cour des Fusillés"
    ],
    "nl": [
      "HERDENKING - 80ste verjaardag van de schietpartij\r\n09.30 uur: Herdenkingsmis in de kerk\r\n10.30 uur: Verzamelen voor het stadhuis, rondgang, ceremonie en kranslegging bij het Monument aux Morts en de Cour des Fusillés"
    ],
    "es": [
      "CEREMONIA EN MEMORIA - 80 aniversario del tiroteo\r\n09:30: Misa de recuerdo en la iglesia\r\n10h30: Concentración delante del Ayuntamiento, desplazamiento, ceremonia y colocación de coronas en el Monument aux Morts y en el Cour des Fusillés"
    ]
  },
