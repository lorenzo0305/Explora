  "rdfs:comment": {
    "de": [
      "Le Saint Bruno bietet Ihnen je nach Lust und Laune eine traditionelle Küche im Stil einer Brasserie sowie Spezialitäten, Pizzas ... Klimatisierter Saal und schattige Terrasse unter Platanen."
    ],
    "en": [
      "Le Saint Bruno offers you a traditional brasserie-style cuisine, as well as specialities, pizzas ... Air-conditioned room and shaded terrace under the plane trees."
    ],
    "it": [
      "Le Saint Bruno offre una cucina tradizionale in stile brasserie, oltre a specialità, pizze, ecc. Camera climatizzata e terrazza ombreggiata sotto i platani."
    ],
    "fr": [
      "Le Saint Bruno vous propose selon vos envies une cuisine traditionnelle type brasserie, ainsi qu'une cuisine de spécialités, des pizzas ... Salle climatisée et terrasse ombragée sous les platanes."
    ],
    "es": [
      "Le Saint Bruno le ofrece una cocina tradicional tipo brasserie, así como especialidades, pizzas, etc. Habitación con aire acondicionado y terraza sombreada bajo los plátanos."
    ],
    "nl": [
      "Le Saint Bruno biedt u een traditionele keuken in brasseriestijl, maar ook specialiteiten, pizza's, enz. Kamer met airconditioning en schaduwrijk terras onder de platanen."
    ]
  },
