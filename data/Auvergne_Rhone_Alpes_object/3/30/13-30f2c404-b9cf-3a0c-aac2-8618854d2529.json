  "rdfs:comment": {
    "de": [
      "Joël freut sich, Sie zu einem neuen Abenteuer mit seiner hausgemachten Küche begrüßen zu dürfen.\r\nTraditionelle Küche aus der Charente und der Vendée, hausgemacht. Entdecken Sie unsere verschiedenen Fischsorten, darunter den Marmite du pêcheur de l'Île d'Oléron."
    ],
    "en": [
      "Joël is happy to welcome you for a new adventure with his home cooking.\r\nTraditional Charentais and Vendée home cooking. Discover our different fish dishes, including the \"marmite du pêcheur de l'Île d'Oléron\"."
    ],
    "it": [
      "Joël è lieto di accogliervi per una nuova avventura con la sua cucina casalinga.\r\nCucina casalinga tradizionale della Charentaise e della Vandea. Scoprite i nostri diversi piatti di pesce, tra cui la marmellata dei pescatori dell'Ile d'Oléron."
    ],
    "fr": [
      "Joël est heureux de vous accueillir pour une nouvelle aventure avec sa cuisine maison.\r\nCuisine traditionnelle Charentaise et Vendéenne faite maison. Découvrez nos différents poissons dont la marmite du pêcheur de l’Île d'Oléron."
    ],
    "nl": [
      "Joël verwelkomt je graag voor een nieuw avontuur met zijn thuiskeuken.\r\nTraditionele Charentaise en Vendée huiskeuken. Ontdek onze verschillende visgerechten, waaronder de vissersmarmite van het Ile d'Oléron."
    ],
    "es": [
      "Joël está encantado de recibirle para una nueva aventura con su cocina casera.\r\nCocina casera tradicional de Charentaise y Vendée. Descubra nuestros diferentes platos de pescado, incluida la marmita de pescador de la isla de Oléron."
    ]
  },
  "rdfs:label": {
