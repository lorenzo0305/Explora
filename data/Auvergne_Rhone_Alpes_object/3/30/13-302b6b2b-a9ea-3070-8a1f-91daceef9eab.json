  "rdfs:comment": {
    "de": [
      "Finden Sie alle geschmacklichen Nuggets aus dem Forez! Entdecken Sie sie direkt in der Boutique oder bestellen Sie auf ihrer Internetseite bis Dienstagabend 20 Uhr, um sie am Freitagabend oder Samstag in ihrem Geschäft in Trelins abzuholen."
    ],
    "en": [
      "Find all the gustatory nuggets of Forez! Discover them directly in the shop or by placing an order on their website before 8pm on Tuesday evening to collect them on Friday evening or Saturday in their shop in Trelins."
    ],
    "it": [
      "Scoprite tutte le gustose pepite di Forez! Scopriteli direttamente in negozio o ordinandoli sul sito web entro le 20.00 del martedì sera e ritirateli il venerdì sera o il sabato nel negozio di Trelins."
    ],
    "fr": [
      "Retrouvez toutes les pépites gustatives du Forez ! Découvrez les directement en boutique ou en passant commande sur leur site internet avant le mardi soir 20h pour les récupérer le vendredi soir ou  le samedi dans leur boutique à Trelins."
    ],
    "es": [
      "¡Descubra todas las sabrosas pepitas de Forez! Descúbralos directamente en la tienda o haciendo un pedido en su página web antes de las 20:00 h del martes por la noche y recójalos el viernes por la noche o el sábado en su tienda de Trelins."
    ],
    "nl": [
      "Ontdek alle lekkere klompjes van Forez! Ontdek ze rechtstreeks in de winkel of door een bestelling te plaatsen op hun website voor 20u op dinsdagavond en haal ze op vrijdagavond of zaterdag af in hun winkel in Trelins."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boutique de la Luciole Forézienne"
    ]
  },
