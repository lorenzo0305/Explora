  "rdfs:comment": {
    "de": [
      "Die Stadtbibliothek von Allevard öffnet ihre Türen für Allevardins, aber auch für Kurgäste und Durchreisende."
    ],
    "en": [
      "The Allevard library for all is open to residents of Allevard, as well as to spa-goers or those just passing through."
    ],
    "it": [
      "La biblioteca comunale di Allevard è aperta non solo agli allevardesi, ma anche a coloro che frequentano le acque o che sono di passaggio."
    ],
    "fr": [
      "La Bibliothèque municipale d'Allevard ouvre ses portes aux Allevardins mais aussi aux curistes et gens de passage."
    ],
    "es": [
      "La biblioteca municipal de Allevard está abierta no sólo a los allevardinos, sino también a las personas que toman las aguas o simplemente están de paso."
    ],
    "nl": [
      "De Bibilothèque Pour Tous d'Allevard opent haar deuren voor de bewoners van Allevard, maar ook voor mensen die het water op gaan of gewoon op doorreis zijn."
