  "rdfs:comment": {
    "de": [
      "Eine lustige und unterhaltsame Art zu fahren! Der Pumptrack ist ein Rundkurs mit Steilkurven und Buckeln. Er eignet sich für verschiedene Arten von Fahrten: Mountainbike, Skateboard, Roller und bietet 3 Strecken mit unterschiedlichen Schwierigkeitsgraden."
    ],
    "en": [
      "A fun, playful way to ride! Pumptrack is a loop circuit with banked turns and bumps. It can be used by mountain bikers, skateboarders and scooters, and offers 3 circuits at different levels."
    ],
    "it": [
      "Un modo divertente e giocoso di andare in moto! Il Pumptrack è un circuito ad anello con curve e dossi. È adatto a diversi tipi di ciclisti, tra cui mountain bike, skateboard e scooter, e offre 3 circuiti a diversi livelli."
    ],
    "fr": [
      "Une façon fun et ludique de rouler ! Le pumptrack est un circuit en boucle, avec des virages relevés et des bosses. Il s'adresse à différents types de pratiques : VTT, skate, trottinette et propose 3 circuits de différents niveaux."
    ],
    "es": [
      "Una forma divertida y lúdica de pilotar Pumptrack es un circuito en bucle con curvas peraltadas y baches. Es apto para una gran variedad de usuarios, incluidos ciclistas de montaña, patinadores y scooters, y ofrece 3 circuitos de diferentes niveles."
    ],
    "nl": [
      "Een leuke en speelse manier om te rijden! Pumptrack is een circuit met bochten en bulten. Het is geschikt voor verschillende rijders, waaronder mountainbikers, skateboarders en scooters, en biedt 3 circuits op verschillende niveaus."
    ]
  },
