  "rdfs:comment": {
    "de": [
      "Das Triolet ist ein unumgänglicher Ort der lokalen Kulturszene. Es beherbergt eine große Vielfalt an Aufführungen, die von Theater über Musik bis hin zu Tanz und Humor reichen, und bietet ein reichhaltiges und abwechslungsreiches Programm."
    ],
    "en": [
      "This facility is named after Elsa Triolet, but \"triolet\" is also French for the musical term \"triplet\".\r\nThe auditorium boasts a stage, stage equipment and a sound system and accommodates 220 people in tiered seating, or 400 with a standing area."
    ],
    "it": [
      "Le Triolet è un luogo chiave della scena culturale locale. Ospita un'ampia varietà di spettacoli che spaziano dal teatro alla musica, dalla danza alla commedia, offrendo un programma ricco e variegato."
    ],
    "fr": [
      "Le Triolet est un lieu incontournable de la scène culturelle locale. Accueillant une grande diversité de spectacles allant du théâtre à la musique, en passant par la danse et l’humour, elle offre une programmation riche et variée."
    ],
    "nl": [
      "Le Triolet is een belangrijke locatie in de plaatselijke culturele scene. Met een grote verscheidenheid aan voorstellingen, van theater tot muziek, dans en komedie, biedt het een rijk en gevarieerd programma."
    ],
    "es": [
      "Le Triolet es un lugar clave de la escena cultural local. Acoge una amplia variedad de espectáculos que van desde el teatro a la música, la danza y la comedia, y ofrece una programación rica y variada."
    ]
  },
  "rdfs:label": {
