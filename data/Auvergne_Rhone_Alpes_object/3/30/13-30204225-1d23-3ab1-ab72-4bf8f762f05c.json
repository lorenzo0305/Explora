  "rdfs:comment": {
    "de": [
      "Mesalia Art: Die Kunst des Talismans\r\nEntdecken Sie eine Traumwelt, in der das Kunsthandwerk auf das Heilige trifft. Zwischen vibrierenden Herzen, wachsamen Pilzen und schützenden Augen ist jedes Stück ein poetischer Wächter, der entworfen wurde, um Ihren Alltag neu zu verzaubern."
    ],
    "en": [
      "Mésalia Art : The Art of the Talisman\r\nDiscover a dreamlike world where craftsmanship meets the sacred. From Vibrant Hearts to Watchful Mushrooms and Protective Eyes, each piece is a poetic guardian designed to enchant your everyday life."
    ],
    "it": [
      "Mésalia Art : L'arte del talismano\r\nScoprite un mondo onirico dove l'artigianato incontra il sacro. Dai cuori vibranti ai funghi vigili e agli occhi protettivi, ogni pezzo è un guardiano poetico progettato per incantare la vostra vita quotidiana."
    ],
    "fr": [
      "Mésalia Art : L'Art du Talisman\r\nDécouvrez un univers onirique où l'artisanat rencontre le sacré. Entre Cœurs vibrants, Champignons veilleurs et Yeux protecteurs, chaque pièce est un gardien poétique conçu pour réenchanter votre quotidien."
    ],
    "nl": [
      "Mésalia Kunst: De kunst van de talisman\r\nOntdek een droomwereld waar vakmanschap en heiligheid elkaar ontmoeten. Van levendige harten tot waakzame paddenstoelen en beschermende ogen, elk stuk is een poëtische beschermer die ontworpen is om je dagelijks leven te betoveren."
    ],
    "es": [
      "Mésalia Art : El arte del talismán\r\nDescubra un mundo de ensueño donde la artesanía se encuentra con lo sagrado. Desde Corazones vibrantes a Setas vigilantes y Ojos protectores, cada pieza es un guardián poético diseñado para encantar su vida cotidiana."
    ]
  },
  "rdfs:label": {
