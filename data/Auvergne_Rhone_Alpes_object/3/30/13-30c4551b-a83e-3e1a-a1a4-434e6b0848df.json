  "rdfs:comment": {
    "de": [
      "Die Skischule ESF Sainte Foy hält einige Überraschungen für Sie bereit. Sainte Foy bietet Ihnen die Natur, die ESF Sainte Foy erledigt den Rest. Erleben Sie eine einzigartige Erfahrung dank eines Teams von Fachleuten, die das Skifahren und die Berge lieben."
    ],
    "en": [
      "The ESF Sainte Foy ski school has some surprises in store for you. Sainte Foy offers you nature, the ESF Sainte Foy does the rest. Enjoy a unique experience thanks to a team of professionals who love skiing and the mountains."
    ],
    "it": [
      "La scuola di sci ESF Sainte Foy ha in serbo per voi alcune sorprese. Sainte Foy vi offre la natura, la ESF Sainte Foy fa il resto. Godetevi un'esperienza unica grazie a un team di professionisti che amano lo sci e la montagna."
    ],
    "fr": [
      "L'école de ski ESF Sainte Foy vous réserve des surprises. Sainte Foy vous offre la nature, l'ESF Sainte Foy fait le reste. Vivez une expérience unique grâce à une équipe de professionnels amoureux du ski et de la montagne."
    ],
    "es": [
      "La escuela de esquí ESF Sainte Foy le reserva algunas sorpresas. Sainte Foy te ofrece la naturaleza, la ESF Sainte Foy hace el resto. Disfrute de una experiencia única gracias a un equipo de profesionales amantes del esquí y de la montaña."
    ],
    "nl": [
      "De ESF Sainte Foy skischool heeft een aantal verrassingen voor je in petto. Sainte Foy biedt je de natuur, de ESF Sainte Foy doet de rest. Geniet van een unieke ervaring dankzij een team van professionals die houden van skiën en de bergen."
    ]
  },
