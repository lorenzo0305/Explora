  "rdfs:comment": {
    "de": [
      "Angenehmer, ummauerter Ort mit Bäumen, an dem sich die Quelle Pampadour befindet, die zu der Zeit, als das Anwesen für ein Thermalbad bestimmt war (die Marquise de Pompadour hatte sich dort aufgehalten), historische Lei war."
    ],
    "en": [
      "A pleasant, wooded, walled site featuring the Pampadour spring, a historic landmark when the property was intended as a spa (the Marquise de Pompadour once stayed here)."
    ],
    "it": [
      "Questo sito piacevole, boscoso e cinto da mura, ospita la sorgente di Pampadour, un punto di riferimento storico quando la proprietà era utilizzata come centro termale (la marchesa di Pompadour vi soggiornò una volta)."
    ],
    "fr": [
      "Site agréable, arboré, clos de murs sur lequel se trouve la Source Pampadour, lei historique au temps où la propriété était destinée à un établissement thermal (la marquise de Pompadour y avait séjourné)."
    ],
    "es": [
      "Este agradable lugar, arbolado y amurallado, alberga el manantial de Pampadour, un hito histórico cuando la propiedad se utilizaba como balneario (la marquesa de Pompadour se alojó aquí en una ocasión)."
    ],
    "nl": [
      "Dit aangename, beboste, ommuurde terrein beschikt over de Pampadour-bron, een historische mijlpaal toen het pand werd gebruikt als kuuroord (de markiezin van Pompadour verbleef hier ooit)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Écurie de la Source Pompadour"
    ]
  },
