  "rdfs:comment": {
    "de": [
      "Diese Etappe der La Voie Bleue begleitet die Saône mit dem Fahrrad auf ihren letzten Kilometern. Zwischen Trévoux und der Hauptstadt der Gastronomie bietet die Strecke ein Panorama der Natur mit den Monts d'Or und der Urlaubsorte und Wasserfreizeitaktivitäten."
    ],
    "en": [
      "This stage of the Voie Bleue accompanies the Saône by bike in its final kilometers. Between Trévoux and the capital of gastronomy, the route offers a panorama of nature with the Monts d'Or, and resort and water sports activities."
    ],
    "it": [
      "Questa tappa della Voie Bleue segue la Saona in bicicletta per gli ultimi chilometri. Tra Trévoux e la capitale della gastronomia, il percorso offre un panorama di natura con i Monts d'Or e sport acquatici e attività ricreative."
    ],
    "fr": [
      "Cette étape de La Voie Bleue accompagne la Saône à vélo dans ses derniers kilomètres. Entre Trévoux et la capitale de la gastronomie, le parcours offre un panorama de nature avec les Monts d’Or et de villégiature et activités de loisirs nautiques."
    ],
    "es": [
      "Esta etapa de la Voie Bleue sigue el Saona en bicicleta durante los últimos kilómetros. Entre Trévoux y la capital de la gastronomía, el recorrido ofrece un panorama de naturaleza con los Montes de Or y actividades náuticas y de ocio."
    ],
    "nl": [
      "Deze etappe van de Voie Bleue volgt de Saône op de fiets voor de laatste paar kilometer. Tussen Trévoux en de hoofdstad van de gastronomie biedt de route een panorama van de natuur met de Monts d'Or en watersport- en vrijetijdsactiviteiten."
    ]
  },
  "rdfs:label": {
    "de": [
      "La Voie Bleue® Moselle Saône à vélo - Etappe Trévoux - Lyon"
    ],
    "en": [
      "La Voie Bleue® Moselle Saône à vélo - Trévoux - Lyon stage"
    ],
    "it": [
      "La Voie Bleue® Moselle Saône à vélo - Trévoux - Tappa di Lione"
    ],
    "fr": [
