  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von der inspirierenden Küche des Küchenchefs Pascal Lefebvre verwöhnen.\nGesnackte Austern, Fischpressen mit Rote Beete. Jakobsmuscheln und Salzwiesenlamm in der Saison."
    ],
    "en": [
      "Let yourself be tempted by chef Pascal Lefebvre's inspired cuisine.\nSnacked oysters, pressed fish with beet. Scallops and salt-meadow lamb in season."
    ],
    "it": [
      "Lasciatevi tentare dalla cucina ispirata dello chef Pascal Lefebvre.\nOstriche a merenda, pesce pressato con barbabietola. Capesante e agnello salato di stagione."
    ],
    "fr": [
      "Laissez-vous tenter par la cuisine d'inspiration du chef Pascal Lefebvre.\nHuîtres snackées, pressé de poissons à la betterave. Saint Jacques et Agneau des prés salés en saison."
    ],
    "nl": [
      "Laat je verleiden door de geïnspireerde keuken van chef Pascal Lefebvre.\nSnackoesters, geperste vis met rode biet. Sint-jakobsschelpen en lam van de zoute weide in het seizoen."
    ],
    "es": [
      "Déjese tentar por la inspirada cocina del chef Pascal Lefebvre.\nOstras para picar, pescado prensado con remolacha. Vieiras y cordero de prado salado en temporada."
    ]
  },
