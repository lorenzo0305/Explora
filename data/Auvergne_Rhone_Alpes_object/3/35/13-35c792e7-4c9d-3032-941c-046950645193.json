  "rdfs:comment": {
    "de": [
      "La Grolle bereitet Ihnen Pizzas mit hausgemachtem Teig zu. Sie werden im Holzofen gebacken und versprechen, Ihnen das Wasser im Mund zusammenlaufen zu lassen. Das Restaurant liegt im Stadtzentrum und empfängt Sie in seinem Restaurant oder bietet Ihnen Pizzas zum Mitnehmen an."
    ],
    "en": [
      "La Grolle prepares pizzas with homemade dough. Baked over a wood fire, they promise to make your mouth water. The restaurant, conveniently located in the town center, welcomes you in its restaurant or offers pizzas to take away."
    ],
    "it": [
      "La Grolle prepara pizze fatte in casa. Cotte sul fuoco a legna, promettono di farvi venire l'acquolina in bocca. Il ristorante, comodamente situato nel centro della città, vi accoglie nel suo locale o offre pizze da asporto."
    ],
    "fr": [
      "La Grolle vous prépare des pizzas avec une pâte faite maison. Cuites au feu de bois, elle promettent de vous faire saliver. Le restaurant, bien situé en centre ville vous accueille dans son restaurant ou vous propose des pizzas à emporter."
    ],
    "es": [
      "La Grolle prepara pizzas caseras. Horneadas al fuego de leña, prometen hacerle la boca agua. El restaurante, convenientemente situado en el centro de la ciudad, le da la bienvenida en su restaurante o le ofrece pizzas para llevar."
    ],
    "nl": [
      "La Grolle bereidt zelfgemaakte pizza's. Ze worden op houtvuur gebakken en zullen je doen watertanden. Het restaurant, gunstig gelegen in het stadscentrum, verwelkomt je in zijn restaurant of biedt afhaalpizza's."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria La Grolles"
    ]
  },
