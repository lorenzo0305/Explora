    "de": [
      "Dorf Vergongheon: Industrielles Erbe aus dem 19. Jahrhundert, ehemalige Ziegeleien und Ziegeleien. Mittelalterliche Kirche, im 19. Jahrhundert umgebaut."
    ],
    "en": [
      "Village of Vergongheon: 19th-century industrial heritage, former brick and tile works. Church of medieval origin, remodeled in the 19th century."
    ],
    "it": [
      "Villaggio di Vergongheon: patrimonio industriale del XIX secolo, ex fabbrica di mattoni e piastrelle. Chiesa di origine medievale, modificata nel XIX secolo."
    ],
    "fr": [
      "Village de Vergongheon : Patrimoine industriel du XIXe siècle, anciennes briquetteries et tuileries. Église d’origine médiévale, remaniée au XIXe siècle."
    ],
    "es": [
      "Pueblo de Vergongheon: patrimonio industrial del siglo XIX, antigua fábrica de ladrillos y tejas. Iglesia de origen medieval, alterada en el siglo XIX."
    ],
    "nl": [
      "Dorp Vergongheon: 19e-eeuws industrieel erfgoed, voormalige baksteen- en dakpannenfabriek. Kerk van middeleeuwse oorsprong, verbouwd in de 19e eeuw."
    ]
