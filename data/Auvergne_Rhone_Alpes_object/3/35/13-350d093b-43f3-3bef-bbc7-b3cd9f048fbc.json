  "rdfs:comment": {
    "de": [
      "Efesyne friert die Vergänglichkeit ein, sublimiert die Gegenwart.\r\nEinzigartige Deko- oder Gebrauchsgegenstände aus Kunstharz mit floralen und pflanzlichen Inspirationen (Flaschenöffner, Flaschenverschlüsse, Schalen, Teller oder auch Kleinmöbel).  Objekte mit einem poetischen und designorientierten Touch."
    ],
    "en": [
      "Efesyne freezes the ephemeral, sublimates the present.\r\nUnique decorative and everyday resin objects inspired by flowers and plants (bottle openers, bottle caps, bowls, dishes and small furniture).  Objects with a poetic, designer touch."
    ],
    "it": [
      "Efesyne congela l'effimero, sublimando il presente.\r\nOggetti unici decorativi e di uso quotidiano in resina ispirati a fiori e piante (apribottiglie, tappi di bottiglia, ciotole, piatti e piccoli mobili).  Oggetti con un tocco poetico e di design."
    ],
    "fr": [
      "Efesyne figer l'éphémère, sublimer le présent.\r\nObjets déco ou usuels uniques en résine avec inspirations florales et végétales (décapsuleurs, bouchons de bouteilles, bols, plats ou encore petit mobilier).  Des objets avec une touche poétique et design."
    ],
    "es": [
      "Efesyne congela lo efímero, sublimando el presente.\r\nObjetos decorativos y cotidianos únicos en resina inspirados en flores y plantas (abrebotellas, tapones de botellas, cuencos, platos y pequeños muebles).  Objetos con un toque poético y de diseño."
    ],
    "nl": [
      "Efesyne bevriest het vergankelijke en sublimeert het heden.\r\nUnieke decoratieve en alledaagse objecten van hars geïnspireerd op bloemen en planten (flesopeners, flessendoppen, kommen, schalen en klein meubilair).  Objecten met een poëtisch en design tintje."
    ]
  },
