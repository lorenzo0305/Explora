  "rdfs:comment": {
    "de": [
      "Der Lac du Lou ist der größte See des Tals. Er bietet Ihnen große Angelmomente und sicherlich Ihre schönsten Exemplare des Bachsaiblings."
    ],
    "en": [
      "The Lac du Lou is the largest lake in the valley. It will offer you great moments of fishing and certainly your most beautiful specimens of char."
    ],
    "it": [
      "Il Lac du Lou è il lago più grande della valle. Vi offrirà grandi momenti di pesca e sicuramente i vostri più bei esemplari di salmerino."
    ],
    "fr": [
      "Le lac du Lou est le plus grand lac de la vallée. Il vous offrira de grands moments de pêche et certainement vos plus beaux spécimens d'ombles Chevalier."
    ],
    "nl": [
      "Het Lac du Lou is het grootste meer in de vallei. Het biedt u geweldige vismomenten en zeker de mooiste exemplaren van charr."
    ],
    "es": [
      "El Lac du Lou es el lago más grande del valle. Le ofrecerá grandes momentos de pesca y sin duda sus más bellos ejemplares de charr."
    ]
  },
