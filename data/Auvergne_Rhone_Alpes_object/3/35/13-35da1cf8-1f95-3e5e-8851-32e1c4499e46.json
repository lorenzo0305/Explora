  "rdfs:comment": {
    "de": [
      "Ganzjährig geöffnetes Café/Bar mit gemütlicher Terrasse in der Einkaufsstraße von Ruoms. Brasserie und Snack von Mai bis September mit Tagesvorschlag und Speisekarte. Motorradfahrer-Relais (MCP No Conforme)."
    ],
    "en": [
      "Café/bar open year-round with pleasant terrace in Ruoms' shopping street. Brasserie and snack bar from May to September with daily suggestions and à la carte menu. Relais motards (MCP No Conforme)."
    ],
    "it": [
      "Café/bar aperto tutto l'anno con una piacevole terrazza nella via dello shopping di Ruoms. Brasserie e snack bar da maggio a settembre con proposte giornaliere e menu à la carte. Punto di sosta per motociclette (MCP No Conforme)."
    ],
    "fr": [
      "Café/bar ouvert à l'année avec terrasse agréable dans la rue commerçante de Ruoms. Brasserie et Snack de mai à septembre avec suggestion du jour et carte. Relais motards (MCP No Conforme)."
    ],
    "es": [
      "Café/bar abierto todo el año con agradable terraza en la calle comercial de Ruoms. Brasserie y snack bar de mayo a septiembre con sugerencias diarias y menú a la carta. Parada de motos (MCP No Conforme)."
    ],
    "nl": [
      "Bar, heel het jaar door open met een aangenaam terras, gelegen in de winkelstraat van Ruoms. Van mei tot september kan je ook een snack eten of een menu."
    ]
  },
