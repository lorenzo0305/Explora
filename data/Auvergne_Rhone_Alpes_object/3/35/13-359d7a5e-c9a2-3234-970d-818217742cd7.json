  "rdfs:comment": {
    "de": [
      "Wir heißen dich willkommen, um mit deinen Freunden zu bowlen, ein Escape Game zu spielen, Axt zu werfen oder Karaoke zu singen. Vor Ort kannst du von Dienstag bis Samstag eine Pizza, einen Salat oder ein Entrecôte und viele andere Gerichte in einer gemütlichen Atmosphäre essen."
    ],
    "en": [
      "The Restaurant du Bowling welcomes you 7 days a week. A game of bowling amongst friends, to eat a pizza, a salad or a good rib steak or other dishes, in a friendly setting. We offer personalized menus, buffet dinner and drinks."
    ],
    "it": [
      "Vi diamo il benvenuto per il bowling, un gioco di fuga, il lancio dell'ascia o il karaoke con gli amici. In loco, dal martedì al sabato, potrete gustare pizza, insalata, costata di manzo e molti altri piatti in un'atmosfera amichevole."
    ],
    "fr": [
      "Nous vous accueillons pour faire un bowling, un escape game, du lancer de hache ou encore un karaoké entre amis. Sur place, du mardi au samedi, vous pourrez manger une pizza, une salade ou une entrecôte et bien d'autres plats dans un cadre convivial."
    ],
    "nl": [
      "We verwelkomen je graag voor bowlen, een ontsnappingsspel, bijlwerpen of karaoke met vrienden. Ter plaatse kun je van dinsdag tot zaterdag in een gezellige sfeer genieten van pizza, salade, ribsteak en vele andere gerechten."
    ],
    "es": [
      "Le invitamos a jugar a los bolos, a un juego de escape, a lanzar el hacha o a un karaoke con los amigos. En el local, de martes a sábado, podrá disfrutar de pizza, ensalada, filete de costilla y muchos otros platos en un ambiente agradable."
    ]
  },
