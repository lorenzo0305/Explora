  "rdfs:comment": {
    "de": [
      "Die Bourbonnerin Sylvie Livet wurde am 4. März 2017 vom damaligen Staatspräsidenten François Hollande zum Ritter des Nationalen Verdienstordens ernannt und von Senator Jean Cluzel ausgezeichnet."
    ],
    "en": [
      "Bourbonnaise Sylvie Livet was named Chevalier de l'Ordre National du Mérite, on March 4, 2017 by the then President of the Republic, François Hollande, and decorated by Senator Jean Cluzel."
    ],
    "it": [
      "Sylvie Livet di Bourbonnais è stata nominata Chevalier de l'Ordre National du Mérite il 4 marzo 2017 dall'allora Presidente della Repubblica, François Hollande, e decorata dal senatore Jean Cluzel."
    ],
    "fr": [
      "La Bourbonnaise Sylvie Livet a été nommée Chevalier de l’Ordre National du Mérite, le 4 mars 2017 par le Président de la République de l’époque, François Hollande et décorée par le Sénateur Jean Cluzel."
    ],
    "es": [
      "Sylvie Livet, de Bourbonnais, fue nombrada Caballero de la Orden Nacional del Mérito el 4 de marzo de 2017 por el entonces presidente de la República, François Hollande, y condecorada por el senador Jean Cluzel."
    ],
    "nl": [
      "Sylvie Livet uit Bourbonnais werd op 4 maart 2017 door de toenmalige president van de Republiek, François Hollande, benoemd tot Chevalier de l'Ordre National du Mérite en onderscheiden door senator Jean Cluzel."
    ]
  },
