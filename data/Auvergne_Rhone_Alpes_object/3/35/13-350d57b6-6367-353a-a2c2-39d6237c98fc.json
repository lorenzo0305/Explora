  "rdfs:comment": {
    "de": [
      "Zum Frühstück, für eine einfache Mahlzeit, eine gute Suppe ... Oder eine Pause mit hausgemachten Waffeln und Gebäck, oder zum Brunchen... Willkommen bei Brot & Co!"
    ],
    "en": [
      "For breakfast, for a simple meal, a good soup... Or for a snack, homemade waffles and pastries, or for brunch... Welcome to Pain et Cie!"
    ],
    "it": [
      "Per la colazione, per un pasto semplice, una buona zuppa... O per uno spuntino, cialde e dolci fatti in casa, o per un brunch... Benvenuti da Pain et Cie!"
    ],
    "fr": [
      "Pour le petit déjeuner, pour un simple repas, une bonne soupe... Ou une pause goûter, gaufres maison et pâtisseries, ou pour bruncher... Bienvenue à Pain et Cie!"
    ],
    "es": [
      "Para desayunar, para una comida sencilla, una buena sopa... O para merendar, gofres caseros y bollería, o para el brunch... ¡Bienvenido a Pain et Cie!"
    ],
    "nl": [
      "Als ontbijt, voor een eenvoudige maaltijd, een goede soep... Of voor een tussendoortje, zelfgemaakte wafels en gebak, of voor een brunch... Welkom bij Pain et Cie!"
    ]
  },
  "rdfs:label": {
