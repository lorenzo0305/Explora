  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ab517b4-8548-3ffe-8ef4-0814a1795da9",
      "dc:description": {
        "de": [
          "Julie Villers führt uns in eine Welt, die engagierter ist als ihr vorheriges Stück, aber immer noch verrückt und voller Selbstironie."
        ],
        "en": [
          "Julie Villers takes us into a more committed universe than her previous show, but still as crazy and full of self-deprecation."
        ],
        "it": [
          "Julie Villers ci porta in un universo più impegnato rispetto al suo precedente spettacolo, ma sempre altrettanto folle e pieno di autoironia."
        ],
        "fr": [
          "Julie Villers nous emmène dans un univers plus engagé que son précédent spectacle mais toujours aussi déjanté et plein d’auto-dérision."
        ],
        "es": [
          "Julie Villers nos adentra en un universo más comprometido que su anterior espectáculo, pero igual de loco y lleno de autodesprecio."
        ],
        "nl": [
          "Julie Villers neemt ons mee naar een universum dat geëngageerder is dan haar vorige show, maar nog steeds even gek en vol zelfspot."
        ]
      },
