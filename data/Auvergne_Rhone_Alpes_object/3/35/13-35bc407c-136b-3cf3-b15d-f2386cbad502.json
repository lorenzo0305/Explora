  "rdfs:comment": {
    "de": [
      "Zwischen Leidenschaft und Kreativität: Der Küchenchef arbeitet mit einer durchdachten, umweltbewussten Küche und hochwertigen Produkten und macht Ihnen Vorschläge, deren Überraschung er für Sie bereithält."
    ],
    "en": [
      "Between passion and creativity: working with the objective of a sustainable, eco-responsible cuisine and with quality products, the chef offers you suggestions which he keeps the surprise."
    ],
    "it": [
      "Una combinazione di passione e creatività: lavorando con una cucina sostenibile ed eco-responsabile e con prodotti di qualità, lo chef propone proposte sempre sorprendenti."
    ],
    "fr": [
      "Entre la passion et la créativité : travaillant autour d'une cuisine raisonnée, éco-responsable et avec des produits de qualité, le chef vous propose des suggestions dont il garde la surprise."
    ],
    "es": [
      "Una combinación de pasión y creatividad: trabajando con una cocina sostenible y ecorresponsable y con productos de calidad, el chef propone sugerencias que siempre sorprenden."
    ],
    "nl": [
      "Een combinatie van passie en creativiteit: werkend met een duurzame, ecologisch verantwoorde keuken en kwaliteitsproducten komt de chef met suggesties die altijd een verrassing zijn."
    ]
  },
