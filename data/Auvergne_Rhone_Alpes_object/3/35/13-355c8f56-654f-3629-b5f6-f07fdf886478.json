  "rdfs:comment": {
    "de": [
      "In der Domaine de Suzel in Vignieu bietet das Restaurant Chez Mémé eine Reise in die kulinarischen Erinnerungen der Kindheit. In diesem Restaurant wird die traditionelle Küche unserer Großmütter in einer authentischen und geselligen Atmosphäre geehrt."
    ],
    "en": [
      "At the Domaine de Suzel in Vignieu, the restaurant Chez Mémé offers a journey into the gourmet memories of childhood. This table celebrates the traditional cuisine of our grandmothers, in an authentic and friendly atmosphere."
    ],
    "it": [
      "Al Domaine de Suzel di Vignieu, il ristorante Chez Mémé vi accompagna in un viaggio nella memoria. Questo ristorante celebra la cucina tradizionale delle nostre nonne, in un'atmosfera autentica e accogliente."
    ],
    "fr": [
      "Au Domaine de Suzel à Vignieu, le restaurant Chez Mémé propose un voyage dans les souvenirs gourmands de l’enfance. Cette table met à l’honneur la cuisine traditionnelle de nos grand-mères, dans une ambiance authentique et conviviale."
    ],
    "nl": [
      "Op Domaine de Suzel in Vignieu neemt restaurant Chez Mémé je mee op een reis door het verleden. Dit restaurant viert de traditionele keuken van onze grootmoeders, in een authentieke en vriendelijke sfeer."
    ],
    "es": [
      "En el Domaine de Suzel, en Vignieu, el restaurante Chez Mémé le invita a un viaje por los recuerdos. Este restaurante celebra la cocina tradicional de nuestras abuelas, en un ambiente auténtico y acogedor."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chez Mémé, le bistrot de Suzel"
    ],
    "fr": [
      "Chez Mémé, le bistrot de Suzel"
    ]
  },
