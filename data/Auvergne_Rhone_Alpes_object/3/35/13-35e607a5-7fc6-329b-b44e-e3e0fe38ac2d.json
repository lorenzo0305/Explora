  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Bauernhof von Matt&Lili! Besuchen Sie unsere Freilandschweinezucht und probieren Sie unsere Bauernhofprodukte. Unser Campingplatz empfängt Sie für ruhige Nächte auf dem Land."
    ],
    "en": [
      "Welcome to Matt&Lili's farm! Come and discover our open-air pig farm and taste our farm products. Our campsite welcomes you for peaceful nights in the countryside."
    ],
    "it": [
      "Benvenuti alla fattoria di Matt&Lili! Venite a scoprire il nostro allevamento di maiali all'aperto e ad assaggiare i prodotti della nostra fattoria. Il nostro campeggio vi accoglie per notti tranquille in campagna."
    ],
    "fr": [
      "Bienvenue à la ferme de Matt&Lili ! Venez découvrir notre élevage de porcs en plein air et dégustez nos produits fermiers. Notre camping vous accueille pour des nuits paisibles à la campagne."
    ],
    "es": [
      "¡Bienvenido a la granja de Matt&Lili! Venga a descubrir nuestra granja de cerdos al aire libre y a degustar nuestros productos de granja. Nuestro camping le da la bienvenida para noches tranquilas en el campo."
    ],
    "nl": [
      "Welkom op Matt&Lili's boerderij! Kom onze varkensboerderij in de open lucht ontdekken en proef van onze boerderijproducten. Onze camping verwelkomt je voor rustige nachten op het platteland."
    ]
  },
  "rdfs:label": {
    "fr": [
      "De ferme en ferme : La Ferme de Matt' et Lili"
    ]
  },
