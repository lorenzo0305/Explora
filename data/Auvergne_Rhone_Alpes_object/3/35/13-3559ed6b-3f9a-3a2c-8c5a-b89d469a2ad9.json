  "rdfs:comment": {
    "de": [
      "Maud bietet Ihnen Gruppenkurse an: Vinyasa-Yoga, Yin-Yoga, Pilates. Einzelunterricht findet auf Anfrage statt. Online-Planung und obligatorische Online-Reservierung."
    ],
    "en": [
      "Maud offers group classes: vinyasa yoga, yin yoga, pilates. Private lessons are available on request. Online planning and mandatory online booking."
    ],
    "it": [
      "Maud offre lezioni di gruppo di vinyasa yoga, yin yoga e pilates. Le lezioni private sono disponibili su richiesta. È richiesta la prenotazione e l'orario online."
    ],
    "fr": [
      "Maud vous propose des cours collectifs : yoga vinyasa, yin yoga, pilates. Les cours particuliers se font sur demande. Planning en ligne et réservation obligatoire en ligne."
    ],
    "es": [
      "Maud ofrece clases en grupo de vinyasa yoga, yin yoga y pilates. Se pueden solicitar clases particulares. Horarios y reservas en línea."
    ],
    "nl": [
      "Maud biedt groepslessen aan: vinyasa yoga, yin yoga, pilates. Privélessen zijn op aanvraag beschikbaar. Online planning en verplichte online boeking."
    ]
  },
