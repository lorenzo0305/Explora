  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen schönen Moment am Ufer der Saône im Maison Éclusière von Parcieux!\r\nAnhand eines Entdeckungsparcours und einer Ausstellung können Sie in die Geschichte der Saône eintauchen..."
    ],
    "en": [
      "Come and spend some time on the banks of the Saône at the Maison Éclusière de Parcieux!\r\nCome and immerse yourself in the history of the Saône through a discovery trail and exhibition..."
    ],
    "it": [
      "Venite a trascorrere un po' di tempo sulle rive della Saona alla Maison Éclusière di Parcieux!\r\nImmergetevi nella storia della Saona attraverso un percorso di scoperta e una mostra..."
    ],
    "fr": [
      "Venez passer un beau moment en bord de Saône à la Maison Éclusière de Parcieux !\r\nA travers un parcours découverte et une exposition, venez vous immerger dans l’histoire de la Saône..."
    ],
    "es": [
      "Venga a pasar un rato a orillas del Saona en la Maison Éclusière de Parcieux\r\nSumérjase en la historia del Saona a través de un recorrido de descubrimiento y una exposición..."
    ],
    "nl": [
      "Kom een tijdje aan de oevers van de Saône doorbrengen in het Maison Éclusière in Parcieux!\r\nDompel u onder in de geschiedenis van de Saône via een ontdekkingsroute en een tentoonstelling..."
    ]
  },
  "rdfs:label": {
