  "rdfs:comment": {
    "de": [
      "Wir begrüßen Sie in unserem Restaurant mit Bar in Portes-lès-Valence. Unser Restaurant wurde im Laufe des Jahres 2016 eröffnet und ist ein Bouchon Lyonnais, das Ihnen eine große Auswahl an Tagesgerichten, Salaten, Vorspeisen und Desserts bietet."
    ],
    "en": [
      "We welcome you to our restaurant-bar in Portes-lès-Valence. Opened during 2016, our restaurant is a Lyonnais bouchon offering a wide variety of daily specials, salads, starters and desserts."
    ],
    "it": [
      "Vi diamo il benvenuto nel nostro ristorante-caffetteria a Portes-lès-Valence. Inaugurato nel corso del 2016, il nostro ristorante è un bouchon lionese che offre un'ampia varietà di specialità giornaliere, insalate, antipasti e dessert."
    ],
    "fr": [
      "Nous vous accueillons dans notre restaurant café à Portes-lès-Valence. Ouvert au cours de l'année 2016, notre restaurant est un bouchon lyonnais qui vous propose une large variété de plats du jour, de salades, d’entrées et de desserts."
    ],
    "nl": [
      "Wij heten u van harte welkom in ons restaurant-bar in Portes-lès-Valence. Ons restaurant is geopend in 2016 en is een Lyonnais bouchon met een ruime keuze aan dagschotels, salades, voorgerechten en desserts."
    ],
    "es": [
      "Le damos la bienvenida a nuestro restaurante café en Portes-lès-Valence. Inaugurado en 2016, nuestro restaurante es un bouchon lionés que ofrece una amplia variedad de platos del día, ensaladas, entrantes y postres."
    ]
  },
