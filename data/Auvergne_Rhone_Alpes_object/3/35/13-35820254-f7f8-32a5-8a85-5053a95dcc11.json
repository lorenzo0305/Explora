  "rdfs:comment": {
    "de": [
      "Mittagsverpflegung: Tagesmenü und Speisekarte mit hausgemachten Gerichten, Montag bis Freitag. Themenabende (Froschschenkel...), Aperitifbretter, Cocktails. Schöne Terrasse"
    ],
    "en": [
      "Bar/brasserie. Midday service: menu of the day and a la carte with homemade dishes, from Monday to Friday. Saturdays only salads and entrecotes.\r\nTheme evenings (frogs legs...) aperitifs with tapas, platters of charcuterie, cocktails. Lovely terrace."
    ],
    "it": [
      "Ristorazione a pranzo: menù del giorno e menù alla carta con piatti fatti in casa, dal lunedì al venerdì. Serate a tema (cosce di rana...), aperitivi al piatto, cocktail. Bella terrazza"
    ],
    "fr": [
      "Restauration le midi : menu du jour et carte avec des plats maison, du lundi au vendredi. Soirées à thème (cuisses de grenouilles...), planches apéro, cocktails. Belle terrasse"
    ],
    "es": [
      "Restauración a mediodía: menú del día y menú a la carta con platos caseros, de lunes a viernes. Veladas temáticas (ancas de rana...), platos de aperitivo, cócteles. Bonita terraza"
    ],
    "nl": [
      "Lunchtijd catering: dagmenu en a la carte menu met huisgemaakte gerechten, van maandag tot vrijdag. Thema-avonden (kikkerbilletjes...), aperitiefschotels, cocktails. Mooi terras"
    ]
  },
  "rdfs:label": {
    "en": [
      "Cafe des Sports."
    ],
    "fr": [
      "Café des sports"
    ]
  },
