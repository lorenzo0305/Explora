  "rdfs:comment": {
    "de": [
      "Sapnà bedeutet in der Hindi-Sprache \"Traum\", und wir haben viele Träume ... Im Herzen des Viertels La Martinière haben wir einen davon verwirklicht: ein zweites Restaurant zu eröffnen."
    ],
    "en": [
      "Sapnà means \"dream\" in Hindi and dreams: we are full of them ... It is in the heart of the Martinière district that we have made one of them come true: to open a second restaurant."
    ],
    "it": [
      "Sapnà significa \"sogno\" in hindi e noi abbiamo molti sogni... È nel cuore del quartiere Martinière che abbiamo realizzato uno dei nostri desideri: aprire un secondo ristorante."
    ],
    "fr": [
      "Sapnà signifie « rêve » en langue Hindi et des rêves : on en a plein la tête ... C’est au cœur du quartier de la Martinière, que nous avons concrétisé l’un d’eux : ouvrir un deuxième restaurant."
    ],
    "es": [
      "Sapnà significa \"sueño\" en hindi y nosotros tenemos muchos sueños... Es en el corazón del barrio de la Martinière donde hemos hecho realidad uno de ellos: abrir un segundo restaurante."
    ],
    "nl": [
      "Sapnà betekent \"droom\" in het Hindi, en we hebben veel dromen... Het is in het hart van de wijk Martinière dat we een van die wensen hebben waargemaakt: een tweede restaurant openen."
    ]
  },
