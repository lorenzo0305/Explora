  "rdfs:comment": {
    "de": [
      "In einer gemütlichen Umgebung im Bergstil empfangen Sie Stéphanie und Xavier in einem familiären Hotel-Restaurant mit einem einzigartigen Blick auf die Chartreuse und den Vercors."
    ],
    "en": [
      "Set in a warm, mountain style decor, Stephanie and Xavier welcome you to this family run hotel-restaurant. You can enjoy sweeping views over the Chartreuse and Vercors mountain ranges and 16 recently renovated bedrooms."
    ],
    "it": [
      "In un ambiente caldo e montano, Stéphanie e Xavier vi accolgono in un hotel ristorante a conduzione familiare con una vista unica sulle montagne della Chartreuse e del Vercors."
    ],
    "fr": [
      "Dans un cadre chaleureux et de style montagnard, Stéphanie et Xavier vous accueillent dans un hôtel restaurant familial offrant une vue unique sur la Chartreuse et le Vercors."
    ],
    "nl": [
      "In een warme, bergachtige omgeving heten Stéphanie en Xavier je welkom in een familierestaurant met een uniek uitzicht op de Chartreuse en de Vercors."
    ],
    "es": [
      "En un ambiente cálido y montañés, Stéphanie y Xavier le dan la bienvenida a un hotel restaurante familiar con una vista única de las montañas de Chartreuse y Vercors."
    ]
  },
