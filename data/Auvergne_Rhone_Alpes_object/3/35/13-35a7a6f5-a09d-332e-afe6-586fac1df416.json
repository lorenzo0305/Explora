  "rdfs:comment": {
    "de": [
      "Das Schloss Essalois bietet einen pädagogischen Bereich, der die Entdeckung der Loire-Schluchten, die unter Denkmalschutz stehen, und des Wasserkraftdamms von Grangent ermöglicht. Interaktives Mobiliar lockert den Rundgang auf: Filme, virtuelle Besichtigungen, 3D-Darstellungen"
    ],
    "en": [
      "The Château d'Essalois offers an educational area to discover the Loire Gorges, a listed site, and the Grangent hydroelectric dam. Interactive displays enhance the tour: films, virtual tours, 3D representations"
    ],
    "it": [
      "Lo Château d'Essalois offre uno spazio didattico per scoprire le Gole della Loira, sito classificato, e la diga idroelettrica di Grangent. I display interattivi arricchiscono la visita: filmati, tour virtuali, rappresentazioni in 3D"
    ],
    "fr": [
      "Le château d’Essalois propose un espace pédagogique permettant la découverte des gorges de la Loire, site classé, et du barrage hydroélectrique de Grangent. Des mobiliers interactifs agrémentent le parcours : films, visites virtuelles, représentations 3D"
    ],
    "nl": [
      "Het Château d'Essalois biedt een educatieve ruimte om de Gorges de la Loire, een geklasseerde site, en de Grangent hydro-elektrische stuwdam te ontdekken. Interactieve displays versterken de rondleiding: films, virtuele rondleidingen, 3D-voorstellingen"
    ],
    "es": [
      "El Château d'Essalois ofrece un espacio pedagógico para descubrir las Gargantas del Loira, un lugar protegido, y la presa hidroeléctrica de Grangent. Las pantallas interactivas mejoran la visita: películas, visitas virtuales, representaciones en 3D"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Centre d'interprétation des Gorges de la Loire"
    ]
  },
