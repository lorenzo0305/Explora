  "rdfs:comment": {
    "de": [
      "Bei diesem Enquête-Game© treffen die Spieler, die Zauberlehrlinge sind, auf der märchenhaften Mühle von Massons auf ihre Zauberlehrer.\r\nFür Familien mit Kindern zwischen 5 und 12 Jahren."
    ],
    "en": [
      "An investigative game, this Enquête-Game© sees apprentice sorcerers set off to meet their magic teachers on the magical site of the Moulin des Massons.\r\nFor families with children aged 5 to 12."
    ],
    "it": [
      "Un gioco investigativo, questo Enquête-Game© vede gli apprendisti stregoni partire per incontrare i loro insegnanti di magia nel magico sito del Moulin des Massons.\r\nPer famiglie con bambini dai 5 ai 12 anni."
    ],
    "fr": [
      "Jeu d’investigation, pour cet Enquête-Game©, les joueurs apprentis sorciers partent à la rencontre de leurs professeurs de magie sur le site féerique du Moulin des Massons.\r\nA destination des familles avec enfant de 5 à 12 ans."
    ],
    "nl": [
      "In dit onderzoekende spel Enquête-Game© gaan leerling-tovenaars op pad om hun toverleraren te ontmoeten op de magische plek van de Moulin des Massons.\r\nVoor gezinnen met kinderen van 5 tot 12 jaar."
    ],
    "es": [
      "Este Enquête-Game© es un juego de investigación en el que los aprendices de brujo parten al encuentro de sus maestros mágicos en el mágico emplazamiento del Moulin des Massons.\r\nPara familias con niños de 5 a 12 años."
    ]
  },
