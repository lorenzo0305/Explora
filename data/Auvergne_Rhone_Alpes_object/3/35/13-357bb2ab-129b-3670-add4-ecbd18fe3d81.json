  "rdfs:comment": {
    "de": [
      "Sports 360 (ehemals Servi Nature) ist ein Spezialist für Verleih und Reparatur und stellt Ihnen einen Park mit 100 Fahrrädern zur Verfügung, darunter mehr als 40 Fahrräder oder Mountainbikes mit elektrischer Unterstützung."
    ],
    "en": [
      "Specialised in rental and repair since 1995, Sports 360 rent 100 bicycles, including more than 40 electrically-assisted bicycles or mountain bikes."
    ],
    "it": [
      "Specialista nel noleggio e nella riparazione di biciclette, Sports 360 dispone di una flotta di 100 biciclette, tra cui più di 40 biciclette a pedalata assistita e mountain bike."
    ],
    "fr": [
      "Spécialiste de la location et de la réparation, Sports 360 met à votre disposition un parc de 100 vélos dont plus de 40 vélos ou VTT à assistance électrique."
    ],
    "nl": [
      "Sports 360 is gespecialiseerd in fietsverhuur en -reparatie en heeft een vloot van 100 fietsen, waaronder meer dan 40 elektrische fietsen en mountainbikes."
    ],
    "es": [
      "Especialista en alquiler y reparación de bicicletas, Sports 360 dispone de una flota de 100 bicicletas, entre ellas más de 40 de asistencia eléctrica y de montaña."
    ]
  },
