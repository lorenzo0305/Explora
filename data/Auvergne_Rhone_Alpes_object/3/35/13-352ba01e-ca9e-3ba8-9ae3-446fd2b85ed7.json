  "rdfs:comment": {
    "de": [
      "Kommen Sie zahlreich und erfahren Sie mehr über Krähen und ihre Intelligenz anhand des Vortrags \"Krähen an der Spitze der tierischen Intelligenz, warum?\", der von dem Ornithologen Bruno MACHTELINCK präsentiert wird."
    ],
    "en": [
      "Come one, come all to learn more about crows and their intelligence through the lecture \"Crows at the top of animal intelligence, why?\" presented by ornithologist Bruno MACHTELINCK."
    ],
    "it": [
      "Venite tutti a saperne di più sui corvi e sulla loro intelligenza grazie alla conferenza \"I corvi al top dell'intelligenza animale, perché?\" presentata dall'ornitologo Bruno MACHTELINCK."
    ],
    "fr": [
      "Venez nombreux pour en apprendre plus sur les corbeaux et leur intelligence au travers de la conférence \"Les corbeaux au sommet de l'intelligence animale, pourquoi ?\" présentée par l'ornithologue Bruno MACHTELINCK."
    ],
    "es": [
      "Vengan todos a aprender más sobre los cuervos y su inteligencia a través de la conferencia \"Los cuervos en la cima de la inteligencia animal, ¿por qué?\", presentada por el ornitólogo Bruno MACHTELINCK."
    ],
    "nl": [
      "Kom allen om meer te weten te komen over kraaien en hun intelligentie door middel van de lezing \"Crows at the top of animal intelligence, why?\" gepresenteerd door ornitholoog Bruno MACHTELINCK."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conférence : Les corbeaux au sommet de l'intelligence animale, pourquoi ?"
    ]
  },
