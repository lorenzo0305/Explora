  "rdfs:comment": {
    "de": [
      "Zugelassene Apnoe-Schule an den Alpenseen: in Duingt am Lac d'Annecy, am Strand von Lido in Le Bourget und in Thonon und Evian am Genfersee.\r\nVom Anfänger- bis zum Expertenniveau, spezialisiert auf Kaltwasser und Ausgleichstauchen."
    ],
    "en": [
      "Approved freediving school located on the Alpine lakes: in Duingt on Lake Annecy, at the Lido beach in Le Bourget and in Thonon and Evian on Lake Geneva.\r\nFrom beginner to expert level, specialized in cold water and compensation."
    ],
    "it": [
      "Scuola di apnea autorizzata situata sui laghi alpini: a Duingt sul lago di Annecy, sulla spiaggia del Lido a Le Bourget e a Thonon ed Evian sul lago di Ginevra.\r\nDal livello principiante a quello esperto, specializzata in acque fredde e compensazione."
    ],
    "fr": [
      "Ecole d'apnée agrée située sur les lacs alpins : à Duingt au lac d'Annecy, à la plage du Lido au Bourget et à Thonon et Evian au bord du Léman.\r\nDu niveau débutant à expert, spécialisé en eau froide et en compensation."
    ],
    "es": [
      "Escuela homologada de apnea situada en los lagos alpinos: en Duingt en el lago de Annecy, en la playa del Lido en Le Bourget y en Thonon y Evian en el lago Lemán.\r\nDesde el nivel principiante hasta el experto, especializada en aguas frías y compensadas."
    ],
    "nl": [
      "Erkende vrijduikschool aan de Alpenmeren: in Duingt aan het meer van Annecy, aan het Lidostrand in Le Bourget en in Thonon en Evian aan het meer van Genève.\r\nVan beginners tot gevorderden, gespecialiseerd in koud water en compensatie."
    ]
  },
