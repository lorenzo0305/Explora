  "rdfs:comment": {
    "de": [
      "Die \" lotus Bleu\" ist ein asiatisches Restaurant, wo wir Ihnen Spezialitäten dieser Küche vorschlagen."
    ],
    "en": [
      "Le Lotus Bleu is an Asian restaurant where we propose you specialities of this cooking. Renowned for its traditional food, you will taste in this restaurant the best Asian dishes of a gastronomic journey."
    ],
    "it": [
      "Il Blue Lotus è un ristorante asiatico dove vi offriamo le specialità di questa cucina. Rinomato per la sua cucina tradizionale, in questo ristorante potrete gustare i migliori piatti asiatici durante un viaggio gastronomico."
    ],
    "fr": [
      "Le Lotus Bleu est un restaurant asiatique où nous vous proposons des spécialités de cette cuisine. Réputé pour sa cuisine traditionnelle, vous dégusterez dans ce restaurant les meilleurs plats asiatiques le temps d’un voyage gastronomique."
    ],
    "nl": [
      "Le Lotus Bleu is een Aziatisch restaurant waar wij u specialiteiten uit deze keuken aanbieden. Bekend om zijn traditionele keuken, kunt u in dit restaurant genieten van de beste Aziatische gerechten tijdens een gastronomische reis."
    ],
    "es": [
      "Le Lotus Bleu es un restaurante asiático en el que le ofrecemos especialidades de esta cocina. Conocido por su cocina tradicional, en este restaurante podrá disfrutar de los mejores platos asiáticos durante un viaje gastronómico."
    ]
  },
