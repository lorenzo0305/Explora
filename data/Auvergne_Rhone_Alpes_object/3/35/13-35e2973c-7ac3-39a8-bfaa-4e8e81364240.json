  "rdfs:comment": {
    "de": [
      "Die Teufelsbrücke ist die kleinste Brücke, die den Fluss Giffre überquert.\r\nVon dieser symbolträchtigen Brücke in Mieussy können Sie den Tiefblick in die Schlucht genießen.\r\n\r\nUnter der Brücke ist die Schlucht 4 m breit und 9 m tief."
    ],
    "en": [
      "The Pont du Diable is the smallest bridge crossing the Giffre.\r\nFrom this emblematic bridge in Mieussy, you can enjoy a bird's-eye view of the gorge.\r\n\r\nUnder the bridge, the gorge is 4 metres wide and 9 metres deep."
    ],
    "it": [
      "Il Pont du Diable è il ponte più piccolo che attraversa la Giffre.\r\nDa questo emblematico ponte di Mieussy si gode la vista sulla gola.\r\n\r\nSotto il ponte, la gola è larga 4 metri e profonda 9 metri."
    ],
    "fr": [
      "Le pont du Diable est le plus petit pont traversant le Giffre.\r\nVous pourrez y apprécier la vue plongeante sur les gorges depuis ce pont emblématique de Mieussy.\r\n\r\nSous le pont, la gorge présente une largeur de 4 mètres sur 9 mètres de profondeur."
    ],
    "es": [
      "El Pont du Diable es el puente más pequeño que cruza el Giffre.\r\nDesde este emblemático puente de Mieussy, podrá disfrutar de la vista sobre el desfiladero.\r\n\r\nBajo el puente, el desfiladero tiene 4 metros de ancho y 9 de profundidad."
    ],
    "nl": [
      "De Pont du Diable is de kleinste brug over de Giffre.\r\nVanaf deze emblematische brug in Mieussy kun je genieten van een uitzicht in vogelperspectief op de kloven.\r\n\r\nOnder de brug is de kloof 4 meter breed en 9 meter diep."
    ]
  },
  "rdfs:label": {
    "en": [
      "Devil's Bridge"
    ],
    "fr": [
      "Pont du Diable"
    ],
    "nl": [
      "Duivelsbrug"
    ]
  },
