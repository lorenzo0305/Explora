  "rdfs:comment": {
    "de": [
      "La Mine Coworking ist ein heller und anregender Ort, an dem Kleinstunternehmen, Freiberufler und Telearbeiter in einer entspannten, warmen und angenehmen Atmosphäre synergetisch zusammenarbeiten."
    ],
    "en": [
      "La Mine Coworking is a bright, stimulating place where micro-businesses, freelancers and teleworkers work in synergy in a relaxed, warm and pleasant atmosphere."
    ],
    "it": [
      "La Mine Coworking è un luogo luminoso e stimolante dove microimprese, freelance e telelavoratori lavorano in sinergia in un'atmosfera rilassata, calda e piacevole."
    ],
    "fr": [
      "La Mine Coworking  est un lieu lumineux et stimulant où micro-entreprises, travailleurs indépendants et télétravailleurs travaillent en synergie dans une atmosphère détendue, chaleureuse et agréable."
    ],
    "nl": [
      "La Mine Coworking is een heldere en stimulerende plek waar micro-ondernemingen, freelancers en telewerkers samenwerken in een ontspannen, warme en aangename sfeer."
    ],
    "es": [
      "La Mine Coworking es un lugar luminoso y estimulante donde microempresas, autónomos y teletrabajadores trabajan en sinergia en un ambiente relajado, cálido y agradable."
    ]
  },
