  "rdfs:comment": {
    "de": [
      "Die Kirche wurde 1859-1860 vom Architekten Berruyer an der Stelle der alten Kirche wieder aufgebaut. Im Jahr 1861 wurde der Glockenturm gebaut und die Glocke installiert\r\nDie Kirche wurde 1992-1993 vollständig renoviert."
    ],
    "en": [
      "In 1859-1860, the church was rebuilt by the architect Berruyer on the site of the previous one. The belfry was added, and the bell installed, in 1861.\r\nThe entire church was renovated in 1992-1993."
    ],
    "it": [
      "Chiesa ricostruita nel 1859-1860 dall'architetto Berruyer, sul sito della vecchia chiesa. Nel 1861 fu costruito il campanile e fu installata la campana\r\nLa chiesa è stata completamente ristrutturata nel 1992-1993."
    ],
    "fr": [
      "Eglise reconstruite en 1859-1860 par l'architecte Berruyer, sur l'emplacement de l'ancienne église. En 1861, le beffroi est construit et la cloche installée. \r\nL'église est entièrement rénovée en 1992-1993."
    ],
    "nl": [
      "Kerk herbouwd in 1859-1860 door de architect Berruyer, op de plaats van de oude kerk. In 1861 werd de klokkentoren gebouwd en de klok geïnstalleerd\r\nDe kerk werd volledig gerenoveerd in 1992-1993."
    ],
    "es": [
      "Iglesia reconstruida en 1859-1860 por el arquitecto Berruyer, en el lugar de la antigua iglesia. En 1861 se construyó el campanario y se instaló la campana\r\nLa iglesia fue completamente renovada en 1992-1993."
    ]
  },
