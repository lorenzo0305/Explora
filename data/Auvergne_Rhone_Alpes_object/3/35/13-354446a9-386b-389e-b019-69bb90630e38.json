  "rdfs:comment": {
    "de": [
      "Willkommen im Kleinen Nizza des Cantal!\r\nMaurs, das dank seines milden Klimas und seiner südlichen Atmosphäre so genannt wird, enthüllt Ihnen auf dieser Rundreise alle seine Geheimnisse."
    ],
    "en": [
      "Welcome to the Little Nice of Cantal!\r\nSo nicknamed for its mild climate and southern ambience, Maurs reveals all its secrets on this heritage trail."
    ],
    "it": [
      "Benvenuti alla Piccola Nizza del Cantal!\r\nCosì chiamata per il suo clima mite e l'atmosfera meridionale, Maurs svela tutti i suoi segreti in questo tour."
    ],
    "fr": [
      "Bienvenue dans la Petite Nice du Cantal !\r\nAinsi surnommée grâce à son climat doux et son ambiance méridionale, Maurs vous dévoile dans ce circuit tous ses secrets."
    ],
    "es": [
      "¡Bienvenido a la Pequeña Niza del Cantal!\r\nLlamado así por su clima suave y su ambiente sureño, Maurs revela todos sus secretos en este recorrido."
    ],
    "nl": [
      "Welkom in het kleine Nice van de Cantal!\r\nMaurs, zo genoemd om zijn milde klimaat en zuidelijke sfeer, onthult al zijn geheimen langs dit erfgoedpad."
    ]
  },
  "rdfs:label": {
    "en": [
      "Heritage trail - Medieval town of Maurs"
    ],
    "fr": [
      "Circuit du Patrimoine - Cité médiévale de Maurs"
    ],
    "nl": [
      "Erfgoedpas - Middeleeuws stadje Maurs"
    ]
  },
