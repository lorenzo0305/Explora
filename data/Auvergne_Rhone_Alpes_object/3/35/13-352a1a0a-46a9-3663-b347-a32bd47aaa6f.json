  "rdfs:comment": {
    "de": [
      "Küchenchef Ton, thailändischer Herkunft, freut sich darauf, Ihnen die authentischen Aromen der Küche seines Landes näherzubringen."
    ],
    "en": [
      "Chef Ton, of Thai origin, will be happy to share with you the authentic flavors of his country's cuisine."
    ],
    "it": [
      "Lo chef Ton, di origine thailandese, sarà lieto di condividere con voi i sapori autentici della cucina del suo paese."
    ],
    "fr": [
      "Le chef Ton, d'origine thaïlandaise, se fera un plaisir de vous faire partager des saveurs authentiques de la cuisine de son pays."
    ],
    "es": [
      "El chef Ton, de origen tailandés, estará encantado de compartir con usted los auténticos sabores de la cocina de su país."
    ],
    "nl": [
      "Chef Ton, van Thaise origine, zal met veel plezier de authentieke smaken van de keuken van zijn land met u delen."
    ]
  },
