  "rdfs:comment": {
    "de": [
      "Das Relais Cyné in Bouvesse Quirieu heißt Sie das ganze Jahr über für einen Zwischenstopp willkommen. Ein großer Parkplatz, ein Picknicktisch und eine Haarklammerstange stehen Ihnen zur Verfügung."
    ],
    "en": [
      "The Relais Ciné in Bouvesse Quirieu invites you to stop for a break or stay for a night, any time of year.\r\nJonathan Minelli will answer all your queries about availability and the facilities at Relais Ciné."
    ],
    "it": [
      "Il Relais Cyné a Bouvesse Quirieu è aperto tutto l'anno. C'è un ampio parcheggio, un tavolo da picnic e un bar per i capelli."
    ],
    "fr": [
      "Le Relais Cyné de Bouvesse Quirieu vous accueille toute l'année pour une halte. Un grand parking, une table de pique-nique et une barre d'attache pour les cheveux sont mis à votre disposition."
    ],
    "nl": [
      "Relais Cyné in Bouvesse Quirieu is het hele jaar geopend. Er is voldoende parkeergelegenheid, een picknicktafel en een bar met haarspeldbochten."
    ],
    "es": [
      "El Relais Cyné de Bouvesse Quirieu está abierto todo el año. Hay mucho aparcamiento, una mesa de picnic y un bar para atarse los cabellos."
    ]
  },
