  "rdfs:comment": {
    "de": [
      "Modellbau.\r\nOrganisation der Tauschbörse für Miniaturen.\r\nTrain Train Mistral präsentiert seine Miniatureisenbahnanlage im Parc Louis Aragon in Portes-lès-Valence.\r\nKostenlose Fahrten für Groß und Klein mit Dampf- oder Elektrozügen."
    ],
    "en": [
      "Model making.\r\nOrganization of the Miniature Exchange.\r\nTrain Train Mistral presents its miniature railway circuit at the Parc Louis Aragon in Portes-lès-Valence.\r\nFree rides for young and old on steam and electric trains."
    ],
    "it": [
      "Modellazione.\r\nOrganizzazione della Borsa delle Miniature.\r\nTrain Train Mistral presenta il suo circuito ferroviario in miniatura nel Parco Louis Aragon di Portes-lès-Valence.\r\nViaggi gratuiti per grandi e piccini su treni a vapore o elettrici."
    ],
    "fr": [
      "Modélisme.\r\nOrganisation de la Bourse d'échange miniatures.\r\nTrain Train Mistral présente son circuit ferroviaire miniature au parc Louis Aragon de Portes-lès-Valence.\r\nPromenades gratuites pour petits et grands sur les trains à vapeur ou électriques."
    ],
    "nl": [
      "Modelbouw.\r\nOrganisatie van de Miniatuurbeurs.\r\nTrain Train Mistral presenteert zijn miniatuurspoorwegcircuit in het Parc Louis Aragon in Portes-lès-Valence.\r\nGratis ritten voor jong en oud op stoom- of elektrische treinen."
    ],
    "es": [
      "Fabricación de modelos.\r\nOrganización de la Bolsa de Miniaturas.\r\nTrain Train Mistral presenta su circuito ferroviario en miniatura en el parque Louis Aragon de Portes-lès-Valence.\r\nPaseos gratuitos para grandes y pequeños en trenes de vapor o eléctricos."
    ]
  },
