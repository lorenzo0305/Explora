  "rdfs:comment": {
    "de": [
      "Unten in Le Jaillet können Sie sich auf unseren kurvenreichen Pisten auf großen Schneereifen vergnügen. Spaß garantiert!"
    ],
    "en": [
      "At the bottom of the Jaillet, have fun on our winding slopes on big snow tubes. Fun guaranteed!"
    ],
    "it": [
      "In fondo al Jaillet, divertitevi sulle nostre piste a curve su grosse boe sulla neve. Divertimento garantito!"
    ],
    "fr": [
      "En bas du Jaillet, amusez-vous sur nos pistes à virages sur de grosses bouées sur neige. Fun garanti !"
    ],
    "nl": [
      "Onderaan Le Jaillet kun je je uitleven op onze bochtige pistes op grote sneeuwboeien. Gegarandeerd plezier!"
    ],
    "es": [
      "Abajo del Jaillet, diviértete en nuestras pistas con curvas sobre grandes boyas de nieve. ¡Diversión garantizada!"
    ]
  },
