  "rdfs:comment": {
    "de": [
      "Der Gravel-Einführungsparcours von Albiez ist: eine doppelte Achterschleife, auf der Sie den Gravel-Sport anhand mehrerer möglicher Beläge entdecken können, fernab vom Verkehr und mit abwechslungsreichen und einzigartigen Landschaften."
    ],
    "en": [
      "The Albiez Gravel initiation course is: a double figure-of-eight loop to help you discover Gravel on several possible surfaces, away from traffic, and offering varied and unique landscapes."
    ],
    "it": [
      "Il percorso Albiez Gravel per principianti è: un doppio anello a otto per farvi scoprire il Gravel su superfici diverse, lontano dal traffico e con paesaggi variegati e unici."
    ],
    "fr": [
      "Le parcours d'initiation Gravel d'Albiez c'est : une double boucle en huit pour vous faire découvrir le Gravel à travers plusieurs revêtements possibles, loin de la circulation, et offrant des paysages variés et uniques."
    ],
    "nl": [
      "Het Albiez Gravel beginnersparcours is: een dubbele achtvormige lus om je Gravel te laten ontdekken op verschillende ondergronden, weg van het verkeer en met gevarieerde en unieke landschappen."
    ],
    "es": [
      "El recorrido de iniciación Albiez Gravel es: un bucle en doble ocho para descubrir el Gravel en diferentes superficies, lejos del tráfico y con paisajes variados y únicos."
    ]
  },
  "rdfs:label": {
