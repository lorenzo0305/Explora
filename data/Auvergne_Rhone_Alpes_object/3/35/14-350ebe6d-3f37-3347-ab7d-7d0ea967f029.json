  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/254fb2c8-ab6a-3bac-a528-d8c9ce484ff1",
      "dc:description": {
        "de": [
          "KOSTENLOSES KONZERT\n80er Abend mit :\nWILLIAM (Beginn des Abends) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV um 21 Uhr\nGiraux-Sannier-Sporthalle\n\nPyrotechnische Show im Anschluss an das Konzert\n\nDer Eintritt ist frei ? Begrenzte Plätze"
        ],
        "en": [
          "FREE CONCERT\n80s evening with :\nWILLIAM (Early evening) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV at 9pm\nGiraux-Sannier Sports Hall\n\nFireworks show after the concert\n\nFree admission ? Limited seating"
        ],
        "it": [
          "CONCERTO GRATUITO\nSerata anni '80 con :\nWILLIAM (prima serata) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV alle 21.00\nPalazzetto dello sport Giraux-Sannier\n\nSpettacolo pirotecnico dopo il concerto\n\nIngresso libero? Posti limitati"
        ],
        "fr": [
          "CONCERT GRATUIT\nSoirée 80 avec :\nWILLIAM (Début de Soirée) – PATRICK HERNANDEZ – JEAN-PIERRE MADER – COOKIE DINGLER\nRDV à 21h\nSalle de sport Giraux-Sannier\n\nSpectacle pyrotechnique à l’issue du concert\n\nEntrée gratuite – Places limitées"
        ],
        "nl": [
          "GRATIS CONCERT\n80s avond met :\nWILLIAM (vroege avond) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV om 21u\nSporthal Giraux-Sannier\n\nVuurwerkshow na het concert\n\nGratis toegang ? Beperkte zitplaatsen"
        ],
        "es": [
          "CONCIERTO GRATUITO\nVelada de los 80 con :\nWILLIAM (Temprano por la noche) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV a las 21h\nPabellón Giraux-Sannier\n\nEspectáculo de fuegos artificiales tras el concierto\n\nEntrada gratuita Aforo limitado"
        ]
      },
