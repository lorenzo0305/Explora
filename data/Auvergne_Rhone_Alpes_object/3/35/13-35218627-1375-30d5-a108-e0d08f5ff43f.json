  "rdfs:comment": {
    "de": [
      "Das Freizeitzentrum 3 - 12 Jahre\r\nFür die 3- bis 5-Jährigen ist das Freizeitzentrum Ambiance Montessori\r\nFür die 6- bis 12-Jährigen ist das Freizeitzentrum Ambiance Ateliers Libres (Freie Workshops)"
    ],
    "en": [
      "The leisure centre 3 - 12 years\r\nFor the 3-5 years old, the leisure centre is Montessori Ambiance\r\nFor 6-12 year olds the leisure centre is an atmosphere of free workshops"
    ],
    "it": [
      "Il centro ricreativo 3 - 12 anni\r\nPer i bambini dai 3 ai 5 anni, il centro ricreativo è Montessori Ambiance\r\nPer i bambini dai 6 ai 12 anni, il centro ricreativo offre un'atmosfera di laboratorio gratuito"
    ],
    "fr": [
      "Le centres de loisirs 3 - 12 ans\r\nPour les 3-5 ans le centre de loisirs c'est Ambiance Montessori\r\nPour les 6-12 ans le centre de loisirs c'est Ambiance Ateliers Libres"
    ],
    "nl": [
      "Het recreatiecentrum 3 - 12 jaar\r\nVoor 3-5 jarigen is het vrijetijdscentrum Montessori Ambiance\r\nVoor 6-12 jarigen heeft het recreatiecentrum een gratis workshop sfeer"
    ],
    "es": [
      "El centro de ocio 3 - 12 años\r\nPara los niños de 3 a 5 años el centro de ocio es Montessori Ambiance\r\nPara los niños de 6 a 12 años, el centro de ocio tiene un ambiente de taller gratuito"
    ]
