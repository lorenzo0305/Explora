  "rdfs:comment": {
    "de": [
      "Vélo'box ist ein individueller oder kollektiver Schließfachservice, ideal für die Kombination von Busfahrten / Auto + Fahrrad.\r\nFinden Sie 14 Vélo'Box-Standorte in Valence.\r\nAbonnement in der Citéa-Agentur von Valence, Reservierungsmöglichkeit unter 04 75 600 626."
    ],
    "en": [
      "Vélo'box is an individual or collective locker service, ideal for combining bus / car + bike travel.\r\n14 Vélo'Box sites in Valence.\r\nSubscription at the Valence Citéa agency, reservation possible on 04 75 600 626."
    ],
    "it": [
      "Vélo'box è un servizio di blocco individuale o collettivo, ideale per combinare viaggi in autobus/auto + bici.\r\nA Valence ci sono 14 siti Vélo'Box.\r\nAbbonamento presso la filiale di Valence Citéa, prenotazione possibile al numero 04 75 600 626."
    ],
    "fr": [
      "Vélo’box est un service de consigne individuelle ou collective, idéal pour combiner déplacements en bus / voiture + vélo.\r\nRetrouver 14 sites Vélo'Box sur Valence.\r\nSouscription en agence Citéa de Valence, possibilité de réservation au 04 75 600 626."
    ],
    "nl": [
      "Vélo'box is een individuele of collectieve lock-up service, ideaal voor het combineren van bus / auto + fiets reizen.\r\nEr zijn 14 Vélo'Box-vestigingen in Valence.\r\nInschrijving in het filiaal Valence Citéa, reservering mogelijk op 04 75 600 626."
    ],
    "es": [
      "Vélo'box es un servicio de consigna individual o colectiva, ideal para combinar viajes en autobús / coche + bicicleta.\r\nHay 14 puntos Vélo'Box en Valence.\r\nAbono en la sucursal de Valence Citéa, posibilidad de reserva en el 04 75 600 626."
    ]
  },
  "rdfs:label": {
