  "rdfs:comment": {
    "de": [
      "Traditionelles japanisches Shiatsu. Um den Körper wieder ins Gleichgewicht zu bringen, verschiedene Beschwerden zu lindern (Schmerzen, Stress, Nervosität), den Geist zu beruhigen oder auch die Emotionen zu besänftigen."
    ],
    "en": [
      "Traditional Japanese Shiatsu. To rebalance the body, relieve a variety of ailments (pain, stress, nervousness), calm the mind and soothe the emotions."
    ],
    "it": [
      "Shiatsu tradizionale giapponese. Per riequilibrare il corpo, alleviare vari disturbi (dolore, stress, nervosismo), calmare la mente e placare le emozioni."
    ],
    "fr": [
      "Shiatsu Traditionnel japonais. Pour Ré-équilibrer l’organisme, soulager divers maux (douleurs, stress, nervosité) calmer le mental ou encore apaiser les émotions."
    ],
    "nl": [
      "Traditionele Japanse Shiatsu. Om het lichaam weer in balans te brengen, verschillende kwalen te verlichten (pijn, stress, nervositeit), de geest te kalmeren en de emoties te verzachten."
    ],
    "es": [
      "Shiatsu tradicional japonés. Para reequilibrar el cuerpo, aliviar diversas dolencias (dolor, estrés, nerviosismo) calmar la mente y apaciguar las emociones."
    ]
  },
