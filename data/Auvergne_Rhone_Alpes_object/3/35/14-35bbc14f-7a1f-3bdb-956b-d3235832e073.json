      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Lebensmittelgeschäft und Brotverkauf\n\n\nÖffnungszeiten:\n\nDienstag, Donnerstag, Freitag: 8.30-12.30 Uhr / 14.30-19.30 Uhr\nSamstag: 8.30-17.30 Uhr\n\n\nAbholung:\nZu den Öffnungszeiten des Geschäfts\n\n\n "
        ],
        "en": [
          "Information :\n\nProducts: general grocery and bread depot\n\n\nOpening days:\n\nTuesday, Thursday, Friday: 8h30-12h30 / 14h30-19h30\nSaturday: 8h30-17h30\n\n\nPick-up:\nDuring store opening hours\n\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: drogheria generale e deposito di pane\n\n\nGiorni di apertura:\n\nMartedì, giovedì, venerdì: 8.30-12.30 / 14.30-19.30\nSabato: 8.30-17.30\n\n\nRitiro:\nDurante gli orari di apertura del negozio\n\n\n "
        ],
        "fr": [
          "Informations : \n\nProduits: épicerie générale et dépôt de pain\n\n\nJours d'ouverture:\n\nMardi, jeudi, vendredi: 8h30-12h30 / 14h30-19h30\nSamedi: 8h30-17h30\n\n\nRetrait: \nAux horaires d'ouverture du magasin\n\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: kruidenierswaren en brooddepot\n\n\nOpeningsdagen:\n\nDinsdag, donderdag, vrijdag: 8.30-12.30 / 14.30-19.30\nZaterdag: 8.30 - 17.30 uur\n\n\nOphalen:\nTijdens winkelopeningstijden\n\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: ultramarinos y panadería\n\n\nDías de apertura:\n\nMartes, jueves, viernes: 8.30-12.30 / 14.30-19.30\nSábados: de 8.30 a 17.30 h\n\n\nRecogida:\nDurante el horario de apertura de la tienda\n\n\n "
        ]
      },
