  "rdfs:comment": {
    "de": [
      "Die \"Maisons de Montagne\": 3 charmante Häuser, die Authentizität, Komfort und Modernität miteinander verbinden. Lassen Sie sich von der Wärme des Holzes und der sanften Lebensart in der \"Auberge des Montagnes\" verzaubern.\r\nMit dem Gütesiegel \"Qualité Auvergne\" ausgezeichnet"
    ],
    "en": [
      "Les Maisons de Montagne\": 3 charming houses combining authenticity, comfort and modernity. Let yourself be seduced by the warmth of wood and the gentle way of life at the \"Auberge des Montagnes\".\r\nAuvergne Quality label"
    ],
    "it": [
      "Le \"Maisons de Montagne\": 3 case di charme che combinano autenticità, comfort e modernità. Lasciatevi sedurre dal calore del legno e dallo stile di vita gentile dell'Auberge des Montagnes.\r\nMarchio di qualità Auvergne"
    ],
    "fr": [
      "Les « Maisons de Montagne » : 3 maisons de charme qui allient authenticité, confort et modernité. Laissez vous séduire par la chaleur du bois et la douceur de vivre à « l’Auberge des Montagnes ».\r\nLabellisé Qualité Auvergne"
    ],
    "es": [
      "Las \"Maisons de Montagne\": 3 casas con encanto que combinan autenticidad, confort y modernidad. Déjese seducir por la calidez de la madera y la dulzura de vivir en el \"Auberge des Montagnes\".\r\nSello de calidad de Auvernia"
    ],
    "nl": [
      "De \"Maisons de Montagne\": 3 charmante huizen die authenticiteit, comfort en moderniteit combineren. Laat je verleiden door de warmte van hout en de zachte manier van leven in de Auberge des Montagnes.\r\nKwaliteitslabel Auvergne"
    ]
  },
