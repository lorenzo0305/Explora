  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro von Auris-en-Oisans am Eingang des Ortes empfängt Sie das ganze Jahr über und berät Sie bei der Vorbereitung Ihres Aufenthalts in den Bergen."
    ],
    "en": [
      "The Auris-en-Oisans tourist office, at the entrance to the resort, is there all year round to welcome you and advise you on preparing your stay in the mountains."
    ],
    "it": [
      "L'ufficio turistico di Auris-en-Oisans, all'ingresso della località, è presente tutto l'anno per accogliervi e consigliarvi nella preparazione del vostro soggiorno in montagna."
    ],
    "fr": [
      "L'office de tourisme d'Auris-en-Oisans, à l’entrée de la station, est là toute l’année pour vous accueillir et vous conseiller pour préparer votre séjour  en montagne."
    ],
    "es": [
      "La oficina de turismo de Auris-en-Oisans, a la entrada de la estación, está allí todo el año para recibirle y asesorarle en la preparación de su estancia en la montaña."
    ],
    "nl": [
      "Het VVV-kantoor van Auris-en-Oisans, bij de ingang van het resort, is het hele jaar door aanwezig om je te verwelkomen en je te adviseren bij de voorbereiding van je verblijf in de bergen."
    ]
  },
  "rdfs:label": {
    "en": [
