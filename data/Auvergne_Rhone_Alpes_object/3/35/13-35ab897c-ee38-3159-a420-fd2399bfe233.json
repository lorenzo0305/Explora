  "rdfs:comment": {
    "de": [
      "Die Valsoyades, eine spielerische Herausforderung für Teams, der Orientierungslauf, die Seilrutsche, Fußballgolf, Schatzsuche, Liegeräder, Schießen mit Lasergewehren oder Blasrohr, der Kinderspielplatz, so viele Aktivitäten, um alle zu begeistern!"
    ],
    "en": [
      "Les Valsoyades, a fun team challenge, the orienteering course, the zip line, footgolf, treasure hunt, recumbent bikes, laser rifle or blowgun shooting, the children's play area, so many activities to delight everyone!"
    ],
    "it": [
      "Le Valsoyades, una divertente sfida a squadre, il percorso di orienteering, la traversata tirolese, il footgolf, la caccia al tesoro, le biciclette reclinabili, il tiro con il fucile laser o con la cerbottana, l'area giochi per i bambini, tante attività per soddisfare tutti!"
    ],
    "fr": [
      "Les Valsoyades, challenge ludique en équipe, le parcours d'orientation, la tyrolienne, le footgolf, la chasse au trésor, les vélos couchés, le tir à la carabine laser ou à la sarbacane, l'espace jeux enfants, autant d'activités pour ravir tout le monde !"
    ],
    "es": [
      "Las Valsoyades, un divertido desafío por equipos, el recorrido de orientación, la tirolina, el footgolf, la búsqueda del tesoro, las bicicletas reclinadas, el tiro con rifle láser o con cerbatana, la zona de juegos para niños, ¡tantas actividades para deleitar a todos!"
    ],
    "nl": [
      "De Valsoyades, een leuke teamuitdaging, oriëntatieloop, tokkelbaan, footgolf, schattenjacht, ligfietsen, lasergeweer schieten, blaaspijp schieten, kinderspeeltuin - er is voor elk wat wils!"
    ]
  },
