          "additionalInformation": {
            "de": [
              "Von 9:30 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr am Montag, Dienstag, Donnerstag und Freitag.\r\nVon 9 bis 12 Uhr am Samstag, außer in den Schulferien.\r\nAuch nach Vereinbarung bei Ihnen zu Hause oder in der Boutique in Barnas."
            ],
            "en": [
              "Monday, Tuesday, Thursday and Friday, 9.30am to 12pm and 2pm to 5pm.\r\nFrom 9 a.m. to 12 p.m. on Saturdays, except during school vacations.\r\nAlso by appointment at your home or at the Barnas boutique."
            ],
            "it": [
              "Dalle 9.30 alle 12 e dalle 14 alle 17 il lunedì, martedì, giovedì e venerdì.\r\nDalle 9.00 alle 12.00 il sabato, tranne durante le vacanze scolastiche.\r\nAnche su appuntamento a casa vostra o presso la boutique Barnas."
            ],
            "fr": [
              "De 9h30 à 12 h de 14h à 17h le lundi, mardi, jeudi et vendredi.\r\nDe 9 h à 12 h le samedi, hors vacances scolaires.\r\nEt aussi sur rdv à votre domicile ou à la boutique de Barnas."
            ],
            "nl": [
              "Van 9.30 tot 12.00 uur en van 14.00 tot 17.00 uur op maandag, dinsdag, donderdag en vrijdag.\r\nVan 9 tot 12 uur op zaterdag, behalve tijdens schoolvakanties.\r\nOok op afspraak bij u thuis of in de Barnas boetiek."
            ],
            "es": [
              "De 9.30 a 12.00 h. y de 14.00 a 17.00 h. los lunes, martes, jueves y viernes.\r\nDe 9.00 a 12.00 los sábados, excepto durante las vacaciones escolares.\r\nTambién con cita previa en su domicilio o en la boutique Barnas."
            ]
          },
