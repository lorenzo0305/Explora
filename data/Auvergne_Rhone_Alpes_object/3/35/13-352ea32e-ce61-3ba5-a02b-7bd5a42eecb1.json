  "rdfs:comment": {
    "de": [
      "Fabien Viricel bietet Ihnen in einem außergewöhnlichen Rahmen eine traditionelle Küche auf der Grundlage regionaler Produkte. Die frischen Zutaten stammen von Erzeugern aus den Monts du Lyonnais."
    ],
    "en": [
      "In an exceptional setting, Fabien Viricel offers you traditional cuisine based on local produce. Fresh produce from growers in the Monts du Lyonnais. Cooking courses"
    ],
    "it": [
      "In un ambiente eccezionale, Fabien Viricel vi offre una cucina tradizionale a base di prodotti locali. Prodotti freschi dei produttori."
    ],
    "fr": [
      "Dans un cadre exceptionnel, Fabien Viricel vous propose une cuisine traditionnelle à base de produits du terroir. Produits frais issus de producteurs."
    ],
    "nl": [
      "In een uitzonderlijk kader biedt Fabien Viricel u een traditionele keuken op basis van lokale producten. Verse producten van producenten."
    ],
    "es": [
      "En un marco excepcional, Fabien Viricel le ofrece una cocina tradicional basada en productos locales. Productos frescos de los productores."
    ]
  },
