  "rdfs:comment": {
    "de": [
      "Dank des Floatings bietet der Cocon de Téthys neue Kraft, tiefe Entspannung, Erholung und Selbstverbundenheit."
    ],
    "en": [
      "The Cocoon de Téthys floatation system offers deep relaxation and recuperation, reconnecting you with yourself. Massage."
    ],
    "it": [
      "Concedetevi una pausa rilassante e viaggiate in voi stessi nella vasca di galleggiamento, isolati dagli stimoli esterni in un'acqua satura di sale di Epsom. Un massaggio all'olio su misura vi riporterà dolcemente ai vostri contorni."
    ],
    "fr": [
      "Venez faire une pause détente et un voyage en vous-même grâce au bain de flottaison, isolé des stimuli extérieurs dans une eau saturée en sel d'Epsom. Un massage à l'huile sur mesure vous est proposé pour vous ramener en douceur à vos propres contours."
    ],
    "es": [
      "Tómese un descanso relajante y viaje al interior de sí mismo en el baño de flotación, aislado de los estímulos externos en agua saturada de sal de Epsom. Un masaje con aceite hecho a medida le devolverá suavemente a sus propios contornos."
    ],
    "nl": [
      "Dankzij het zweven biedt de Cocoon of Téthys herbronning, diepe ontspanning en herstel, waarbij je weer in contact komt met jezelf."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Cocon de Téthys : flottaison et massages"
    ]
  },
