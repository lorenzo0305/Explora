  "rdfs:comment": {
    "de": [
      "Töpferwaren aus glasierter Erde. Ich biete Alltagsgegenstände an, die sowohl nützlich als auch dekorativ sind. Blumen- und Landmotive in Pastelltönen, vollständig von Hand bemalt."
    ],
    "en": [
      "Glazed earthenware pottery. I offer everyday objects that are both utilitarian and decorative. Floral and rustic patterns in pastel colors entirely hand painted."
    ],
    "it": [
      "Ceramiche in terracotta smaltata. Offro oggetti di uso quotidiano che sono al tempo stesso utilitari e decorativi. Motivi floreali e country in tonalità pastello, interamente dipinti a mano."
    ],
    "fr": [
      "Poteries de terre vernissée. Je propose des objets du quotidien à la fois utilitaires et décoratifs. Motifs floraux et champêtres aux teintes pastels entièrement peints à la main."
    ],
    "nl": [
      "Geglazuurd aardewerk. Ik bied alledaagse voorwerpen die zowel nuttig als decoratief zijn. Bloem- en plattelandsmotieven in pasteltinten, volledig met de hand beschilderd."
    ],
    "es": [
      "Cerámica de barro vidriado. Ofrezco objetos cotidianos que son a la vez utilitarios y decorativos. Motivos florales y campestres en tonos pastel, totalmente pintados a mano."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poterie Lobélia"
    ]
  },
