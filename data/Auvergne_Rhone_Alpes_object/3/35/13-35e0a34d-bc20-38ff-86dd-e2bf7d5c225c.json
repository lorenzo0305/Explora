  "rdfs:comment": {
    "de": [
      "Die Ressourcensammlung fördert die Abfallvermeidung: Sie sammelt, recycelt und renoviert. Die Ressourcensammelstelle sammelt den Abfall bei Ihnen zu Hause ein. Es gibt eine Verkaufsstelle, die für die Öffentlichkeit zugänglich ist."
    ],
    "en": [
      "The ressourcerie promotes waste reduction: it recovers, recycles and renovates. The ressourcerie collects waste at home. A sales outlet is open to the public."
    ],
    "it": [
      "La ressourcerie promuove la riduzione dei rifiuti: recupera, ricicla e rinnova. La risosteria raccoglierà i rifiuti a domicilio. È presente un punto vendita aperto al pubblico."
    ],
    "fr": [
      "La ressourcerie favorise la réduction des déchets : elle récupère, recycle et rénove. La ressourcerie collectera les déchets à domicile. Il y a un point de vente ouvert au publique."
    ],
    "es": [
      "La ressourcerie promueve la reducción de residuos: recupera, recicla y renueva. La ressourcerie recogerá los residuos a domicilio. Hay un punto de venta abierto al público."
    ],
    "nl": [
      "De ressourcerie helpt afval te verminderen: het herwint, recyclet en renoveert. De ressourcerie verzamelt afval aan huis. Er is een verkooppunt dat toegankelijk is voor het publiek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ressourcerie 3R - La Triade"
    ]
  },
