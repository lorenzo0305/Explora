  "rdfs:comment": {
    "de": [
      "Ein leidenschaftlicher Experte führt Sie durch das Opinel-Museum und zeigt Ihnen die Geschichte des berühmten Messers aus Savoyen anhand von exklusiven Anekdoten über die Familie Opinel, die Herstellungstechniken und deren Entwicklung..."
    ],
    "en": [
      "Guided through the Opinel Museum by a passionate expert, retrace the history of the famous Savoyard knife through exclusive anecdotes about the Opinel family, manufacturing techniques and their evolution..."
    ],
    "it": [
      "Guidati nel Museo Opinel da un esperto appassionato, ripercorrete la storia del famoso coltello savoiardo attraverso aneddoti esclusivi sulla famiglia Opinel, sulle tecniche di produzione e sul loro sviluppo..."
    ],
    "fr": [
      "Guidé au cœur du Musée Opinel par un expert passionné, retracez l'histoire du célèbre couteau savoyard au travers d'anecdotes exclusives sur la famille Opinel, les techniques de fabrication et leur évolution..."
    ],
    "nl": [
      "Volg de geschiedenis van het beroemde Savoyaardse mes aan de hand van exclusieve anekdotes over de familie Opinel, de productietechnieken en de ontwikkeling van het mes..."
    ],
    "es": [
      "Guiado a través del Museo Opinel por un apasionado experto, recorra la historia del famoso cuchillo saboyano a través de anécdotas exclusivas sobre la familia Opinel, las técnicas de fabricación y su desarrollo..."
    ]
  },
  "rdfs:label": {
    "en": [
      "Guided tour - The Opinel Museum"
    ],
    "fr": [
      "Visite guidée - Le Musée Opinel"
    ]
  },
