  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e17a963-de26-3b2d-a7a6-642731d11350",
      "dc:description": {
        "de": [
          "Jährliches Turnier der Rugbyschule \"Les Ovalies\" des TERC.\nVon 9 Uhr bis 17.30 Uhr.\nWir empfangen Vereine aus allen Teilen der Region Hauts-de-France, der Ile de France, der Normandie, aus Belgien, den Niederlanden und England."
        ],
        "en": [
          "Annual tournament of the TERC rugby school les Ovalies.\nFrom 9 a.m. to 5.30 p.m.\nWe'll be welcoming clubs from all over Hauts-de-France, Ile de France, Normandy, Belgium, the Netherlands and England."
        ],
        "it": [
          "Torneo annuale della scuola di rugby TERC Ovalies.\nDalle 9.00 alle 17.30.\nAccoglieremo club provenienti da tutto l'Hauts-de-France, l'Ile de France, la Normandia, il Belgio, i Paesi Bassi e l'Inghilterra."
        ],
        "fr": [
          "Tournoi annuel de l'école de rugby les Ovalies du TERC.\nDe 9h à 17h30.\nNous recevrons des clubs de tous les Hauts-de-France, d'Ile de France, de Normandie, de Belgique, des Pays-Bas et d'Angleterre."
        ],
        "es": [
          "Torneo anual de la escuela de rugby TERC Ovalies.\nDe 9h a 17h30.\nAcogeremos a clubes de todo Hauts-de-France, Île de France, Normandía, Bélgica, Países Bajos e Inglaterra."
        ],
        "nl": [
          "Jaarlijks toernooi van de TERC Ovalies rugbyschool.\nVan 9.00 tot 17.30 uur.\nWe verwelkomen clubs uit heel Hauts-de-France, Ile de France, Normandië, België, Nederland en Engeland."
        ]
      },
