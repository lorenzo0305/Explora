  "rdfs:comment": {
    "de": [
      "Das Alice-Sprungbrett ist ein musikalisches Sprungbrett für Künstler aus der Auvergne-Rhône-Alpes. Am Samstag, dem 14. März, findet ein kostenloses, öffentliches Konzert statt, bei dem die fünf Finalisten ihre musikalischen Projekte vorstellen werden."
    ],
    "en": [
      "A musical springboard dedicated to artists from the Auvergne-Rhône-Alpes region, the Tremplin Alice offers a free concert open to the public on Saturday March 14, at which the five shortlisted finalists will defend their musical projects."
    ],
    "it": [
      "Il Trampolino di Alice, concorso musicale dedicato agli artisti della regione Auvergne-Rhône-Alpes, propone un concerto gratuito aperto al pubblico sabato 14 marzo, durante il quale i cinque finalisti selezionati presenteranno i loro progetti musicali."
    ],
    "fr": [
      "Tremplin musical dédié aux artistes d’Auvergne-Rhône-Alpes, le Tremplin Alice propose un concert gratuit et ouvert au public le samedi 14 mars, à l’occasion duquel les cinq finalistes présélectionnés défendront leurs projets musicaux."
    ],
    "es": [
      "El Trampolín Alice, concurso musical dedicado a los artistas de la región de Auvernia-Ródano-Alpes, ofrece el sábado 14 de marzo un concierto gratuito y abierto al público en el que los cinco finalistas preseleccionados presentarán sus proyectos musicales."
    ],
    "nl": [
      "De Alice Springplank, een muziekwedstrijd gewijd aan artiesten uit de regio Auvergne-Rhône-Alpes, organiseert op zaterdag 14 maart een gratis toegankelijk concert voor het publiek, waarbij de vijf finalisten op de shortlist hun muzikale projecten presenteren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Finale du Tremplin Alice"
    ]
  },
