  "rdfs:comment": {
    "de": [
      "Zwei Trailstrecken (28 km in Staffel oder solo, und 15 km), zwei Wanderstrecken ( 6 und 17 km), ein Kinderlauf für 4/11-Jährige, gefolgt von einem für alle offenen Essen.\r\nWarten auf eine Bestätigung der Organisatoren"
    ],
    "en": [
      "Two trail courses (28 km relay or solo, and 15 km), two hiking courses (6 and 17 km), a children's race for 4/11 year-olds, followed by a meal open to all.\r\nAwaiting confirmation from the organizers"
    ],
    "it": [
      "Due percorsi di trail (28 km a staffetta o in solitaria, e 15 km), due percorsi di trekking (6 e 17 km), una gara per bambini di 4/11 anni, seguita da un pranzo aperto a tutti.\r\nIn attesa di conferma da parte degli organizzatori"
    ],
    "fr": [
      "Deux parcours trail (28 km en relais ou solo, et 15 km), deux parcours randonnée pédestre ( 6 et 17 km), une course enfant pour les 4/11 ans., suivis d'un repas ouvert à tous.\r\nAttente d'une confirmation des organisateurs"
    ],
    "nl": [
      "Twee trailparcoursen (28 km estafette of solo, en 15 km), twee wandelparcoursen (6 en 17 km), een kinderwedstrijd voor kinderen van 4/11 jaar, gevolgd door een maaltijd voor iedereen.\r\nWachten op bevestiging van de organisatoren"
    ],
    "es": [
      "Dos recorridos de trail (28 km por relevos o en solitario, y 15 km), dos recorridos de senderismo (6 y 17 km), una carrera infantil para niños de 4/11 años, seguida de una comida abierta a todos.\r\nA la espera de la confirmación de los organizadores"
    ]
  },
