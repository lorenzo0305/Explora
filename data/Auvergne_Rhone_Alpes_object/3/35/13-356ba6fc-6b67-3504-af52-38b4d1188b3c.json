  "rdfs:comment": {
    "de": [
      "Rasen- und Baumstrand in der Nähe des Hafens, mit beaufsichtigtem Schwimmen im Sommer, Hundezone, Kinderspielplatz, Bouleplatz und Tischtennisplatten. Bootsverleih und Wassersportschulen in der Nähe, mit Restaurants in der Umgebung."
    ],
    "en": [
      "Grassed beach with trees near the port, with supervised swimming in summer, dog area, children's play area, pétanque court and ping-pong tables. Boat rental and nautical schools nearby, with restaurants in the vicinity."
    ],
    "it": [
      "Spiaggia erbosa e alberata vicino al porto, con bagni sorvegliati in estate, area cani, area giochi per bambini, campo da bocce e tavoli da ping-pong. Noleggio barche e scuole di sport acquatici nelle vicinanze, con ristoranti nelle vicinanze."
    ],
    "fr": [
      "Plage engazonnée et arborée près du port, avec baignade surveillée en été, espace chiens, jeux pour enfants, terrain de pétanque et tables de ping-pong. Location de bateaux et écoles nautiques à proximité, avec restaurants autour."
    ],
    "es": [
      "Playa con césped y árboles cerca del puerto, con baño vigilado en verano, zona para perros, zona de juegos infantiles, campo de petanca y mesas de ping-pong. Alquiler de embarcaciones y escuelas náuticas en las inmediaciones, con restaurantes en los alrededores."
    ],
    "nl": [
      "Grasstrand met bomen in de buurt van de haven, met bewaakt zwemmen in de zomer, hondenzone, speeltuin, jeu de boulesbaan en tafeltennistafels. Bootverhuur en watersportscholen in de buurt, met restaurants in de buurt."
    ]
  },
