  "rdfs:comment": {
    "de": [
      "Im Herzen des Skiortes Val Thorens begrüßen Sie Françoise und Patrick am Fuße des Skigebiets des höchsten Skiortes der 3 Vallées."
    ],
    "en": [
      "In the heart of Val Thorens resort, Françoise and Patrick welcome you at the foot of the ski area of the highest ski resort in Les 3 Vallées."
    ],
    "it": [
      "Nel cuore della stazione di Val Thorens, Françoise e Patrick vi danno il benvenuto ai piedi del comprensorio sciistico della stazione sciistica più alta delle 3 Vallées."
    ],
    "fr": [
      "Au cœur de la station de Val Thorens, Françoise et Patrick vous accueillent au pied du domaine skiable de la plus haute station de ski des 3 Vallées."
    ],
    "nl": [
      "In het hart van het skigebied Val Thorens heten Françoise en Patrick u welkom aan de voet van het skigebied van het hoogste skioord van Les 3 Vallées."
    ],
    "es": [
      "En el corazón de la estación de Val Thorens, Françoise y Patrick le dan la bienvenida a los pies de la zona esquiable de la estación más alta de Les 3 Vallées."
    ]
  },
