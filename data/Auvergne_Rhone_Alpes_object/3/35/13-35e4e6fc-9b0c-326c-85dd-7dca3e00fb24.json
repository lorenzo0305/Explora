  "rdfs:comment": {
    "de": [
      "Alte Steinmühle am Ufer des Flusses Bez, flankiert von Weinbergen und den Klippen des Vercors. Traditionelle Küche, Pizzeria. Freundlicher Empfang. Unsere Spezialitäten: Die Pizzas - Lamm aus dem Diois - Ravioli-Gratins..."
    ],
    "en": [
      "An old stone mill alongside the river Bez, between the vineyards and the Vercors' cliffs. Traditional cuisine, pizzeria. A warm welcome awaits you. Our specialties are pizzas - Diois lamb and oven-baked Ravioles pasta..."
    ],
    "it": [
      "Antico mulino in pietra sulle rive del fiume Bez, contro le falesie del Vercors. Atmosfera amichevole.\r\nCucina tradizionale, onesta e generosa. Pizzeria tradizionale a legna. Agnello Diois, Ravioles e carne biologica di Picodon e Charolais."
    ],
    "fr": [
      "Ancien moulin en pierre situé au bord du Bez, contre les falaises du Vercors. Ambiance conviviale. \r\nCuisine traditionnelle, honnête et généreuse. Pizzéria artisanale au feu de bois. Agneau du Diois, Ravioles et Picodon bio, viande Charolaise."
    ],
    "nl": [
      "Oude natuurstenen molen aan de Bez, tussen het wijngebied en de rotswanden van de Vercors. Traditionele keuken, pizzeria. Hartelijke ontvangst. Onze specialiteiten: pizza's, gratins van ravioles…"
    ],
    "es": [
      "Antiguo molino de piedra a orillas del río Bez, contra los acantilados del Vercors. Ambiente acogedor.\r\nCocina tradicional, honesta y generosa. Pizzería tradicional de leña. Cordero de Diois, ravioles y carne ecológica de Picodon, Charolais."
    ]
  },
