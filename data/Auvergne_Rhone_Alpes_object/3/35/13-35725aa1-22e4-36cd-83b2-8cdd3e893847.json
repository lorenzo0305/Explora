  "rdfs:comment": {
    "de": [
      "Herstellung von gedrechselten Holzgegenständen wie Schalen, Tellern, Dosen und Schmuck. Spezialisiert auf Pendel und Radiästhesiestäbe sowie das Drechseln von Hirsch- und Rehgeweihen."
    ],
    "en": [
      "Manufacture of wood-turned objects, such as bowls, plates, boxes, jewelry, specializing in pendulums and dowsing rods as well as deer and roe antler turning."
    ],
    "it": [
      "Produzione di oggetti in legno torniti come ciotole, piatti, scatole e gioielli, specializzata in pendoli e bacchette da radiestesia, nonché nella tornitura di corna di cervo e capriolo."
    ],
    "fr": [
      "Fabrication d'objets tournés en bois, comme bols, assiettes, boites, bijoux, spécialisée dans les pendules et baguettes de radiesthésie ainsi que le tournage de bois de cerf et chevreuil."
    ],
    "nl": [
      "Vervaardiging van gedraaide houten voorwerpen zoals schalen, borden, dozen en sieraden, gespecialiseerd in pendels en wichelroeden, evenals het draaien van herten- en reegeweien."
    ],
    "es": [
      "Fabricación de objetos de madera torneada, como cuencos, platos, cajas y joyas, especializada en péndulos y varillas de zahorí, así como en el torneado de cornamentas de ciervo y corzo."
    ]
  },
