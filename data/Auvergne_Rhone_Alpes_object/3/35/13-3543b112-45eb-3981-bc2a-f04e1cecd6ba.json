  "rdfs:comment": {
    "de": [
      "Der Chefkoch David und seine Tochter Alison empfangen Sie von Mittwoch bis Sonntag in einem angenehmen und entspannten Rahmen, um ihre hausgemachten Menüs mit Produkten zu genießen, die aufgrund ihrer Qualität ausgewählt wurden und vorzugsweise von lokalen Produzenten stammen."
    ],
    "en": [
      "Chef David and his daughter Alison welcome you from Wednesday to Sunday to enjoy their home-cooked menus in a pleasant, relaxed setting, using products chosen for their quality and giving preference to local producers."
    ],
    "it": [
      "Lo chef David e sua figlia Alison vi accolgono dal mercoledì alla domenica in un ambiente piacevole e rilassato per gustare i loro menu casalinghi a base di prodotti scelti per la loro qualità, privilegiando i produttori locali."
    ],
    "fr": [
      "Le chef David et sa fille Alison vous accueillent du mercredi au dimanche dans un cadre agréable et décontracté pour déguster leurs menus cuisinés maison avec des produits choisis pour leur qualité et donnant préférence aux producteurs locaux."
    ],
    "es": [
      "El chef David y su hija Alison le dan la bienvenida de miércoles a domingo en un ambiente agradable y relajado para disfrutar de sus menús caseros elaborados con productos elegidos por su calidad, dando preferencia a los productores locales."
    ],
    "nl": [
      "Chef David en zijn dochter Alison verwelkomen je van woensdag tot zondag in een aangename, ontspannen omgeving om te genieten van hun huisgemaakte menu's met producten die zijn gekozen voor hun kwaliteit, met een voorkeur voor lokale producenten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Jardin des Delices"
    ]
  },
