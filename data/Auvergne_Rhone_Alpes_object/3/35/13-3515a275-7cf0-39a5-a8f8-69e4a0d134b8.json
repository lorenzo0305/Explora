  "rdfs:comment": {
    "de": [
      "Das in Europa einzigartige Aïga Resort Thermal & Spa ist ein Thermal- und Tourismuskomplex der neuen Generation in idealer Lage zwischen Stadt und Natur, im Herzen des außergewöhnlichen Gebiets Chaînes des puys ? Limagne-Falte, UNESCO-Weltkulturerbe."
    ],
    "en": [
      "Unique in Europe, Aïga Resort Thermal & Spa is a new-generation spa and tourism complex, ideally located between town and nature, in the heart of the exceptional Chaînes des puys? Faille de Limagne, a UNESCO World Heritage site."
    ],
    "it": [
      "Unico nel suo genere in Europa, l'Aïga Resort Thermal & Spa è un complesso termale e turistico di nuova generazione, idealmente situato tra città e campagna, nel cuore dell'eccezionale Chaînes des puys ? Faille de Limagne, patrimonio mondiale dell'UNESCO."
    ],
    "fr": [
      "Unique en Europe, Aïga Resort Thermal & Spa est un complexe thermal et touristique nouvelle génération, idéalement implanté entre ville et nature, au cœur du territoire d’exception Chaînes des puys – Faille de Limagne, patrimoine mondial de l’Unesco."
    ],
    "es": [
      "Único en Europa, Aïga Resort Thermal & Spa es un complejo termal y turístico de nueva generación, idealmente situado entre la ciudad y la naturaleza, en el corazón de las excepcionales Chaînes des puys ? Faille de Limagne, declaradas Patrimonio de la Humanidad por la UNESCO."
    ],
    "nl": [
      "Aïga Resort Thermal & Spa, het enige in zijn soort in Europa, is een nieuwe generatie spa en toeristisch complex, ideaal gelegen tussen stad en platteland, in het hart van de uitzonderlijke Chaînes des puys ? Faille de Limagne, dat op de Werelderfgoedlijst van UNESCO staat."
    ]
  },
