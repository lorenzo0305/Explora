  "rdfs:comment": {
    "de": [
      "5 Außenplätze und 2 Hallenplätze, temperiert mit Beleuchtung, das ganze Jahr über geöffnet.\r\nClubhaus zur Verfügung.\r\nVom Tennis Club Thônes angebotene Kurse und Lehrgänge.\r\nTennisschule, Wettkampftennis, Kurse für Erwachsene. Infos auf der Website."
    ],
    "en": [
      "5 outdoor courts and 2 covered, temperate courts with lighting, open all year round.\r\nClub house available.\r\nTraining courses and lessons offered by the Tennis Club de Thônes.\r\nTennis school, competitive tennis, adult courses. Information on the website."
    ],
    "it": [
      "5 campi all'aperto e 2 campi coperti, temperati con illuminazione, aperti tutto l'anno.\r\nCasa del club a disposizione.\r\nCorsi di formazione e lezioni offerti dal Tennis Club de Thônes.\r\nScuola di tennis, tennis agonistico, lezioni per adulti. Informazioni sul sito web."
    ],
    "fr": [
      "5 courts extérieurs et 2 courts couverts, tempérés avec éclairage ouverts toute l'année.\r\nClub house à disposition. \r\nStages et cours proposés par le Tennis Club de Thônes.\r\nÉcole de tennis, tennis en compétition, cours adultes. Infos sur le site internet."
    ],
    "es": [
      "5 pistas exteriores y 2 cubiertas, templadas con iluminación, abiertas todo el año.\r\nCasa club disponible.\r\nCursos de formación y clases ofrecidos por el Club de Tenis de Thônes.\r\nEscuela de tenis, tenis de competición, clases para adultos. Información en el sitio web."
    ],
    "nl": [
      "5 buitenbanen en 2 binnenbanen, gematigd met verlichting, het hele jaar geopend.\r\nClubhuis beschikbaar.\r\nTrainingen en lessen aangeboden door de Tennis Club de Thônes.\r\nTennisschool, competitief tennis, lessen voor volwassenen. Informatie op de website."
    ]
  },
