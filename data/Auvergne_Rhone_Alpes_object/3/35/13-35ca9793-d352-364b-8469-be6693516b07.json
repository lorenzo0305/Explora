  "rdfs:comment": {
    "de": [
      "Der Touristeninformationspunkt in Saint-Rémy-sur-Durolle empfängt Sie im Juli und August montags, dienstags, samstags und sonntags am Rande des Wasserspiegels."
    ],
    "en": [
      "The Saint-Rémy-sur-Durolle tourist information point welcomes you on Mondays, Tuesdays, Saturdays and Sundays in July and August, on the edge of the lake."
    ],
    "it": [
      "Il punto di informazione turistica di Saint-Rémy-sur-Durolle è aperto in luglio e agosto, in riva al lago, il lunedì, martedì, sabato e domenica."
    ],
    "fr": [
      "Le point d'information touristique de Saint-Rémy-sur-Durolle vous accueille en juillet-août, en bordure du plan d'eau, les lundis, mardis, samedis et dimanches."
    ],
    "nl": [
      "Het toeristeninformatiepunt van Saint-Rémy-sur-Durolle is in juli en augustus geopend aan de rand van het meer, op maandag, dinsdag, zaterdag en zondag."
    ],
    "es": [
      "El punto de información turística de Saint-Rémy-sur-Durolle está abierto en julio y agosto, a orillas del lago, los lunes, martes, sábados y domingos."
    ]
  },
