  "rdfs:comment": {
    "de": [
      "Die Mediathek l'Orangerie befindet sich in Le Clos Faure und blickt auf den großen Park des Rathauses von St Ismier. Sie ist eine ehemalige Orangerie, die 1986 von dem Architekten Benoît François restauriert wurde. Sie ist ein denkmalgeschütztes Gebäude mit einer Fläche von 360 m2, dessen Fassade kürzlich umgestaltet wurde."
    ],
    "en": [
      "The L’Orangerie multimedia library, located in Clos Faure, overlooks the large park of the St Ismier town hall. This former orangery was restored in 1986 by the architect Benoît François, and is a 360 m2 listed building whose façade has recently been redesigned."
    ],
    "it": [
      "La Médiathèque l'Orangerie, situata nel Clos Faure, si affaccia sul grande parco del municipio di St Ismier. Si tratta di un'antica aranciera restaurata nel 1986 dall'architetto Benoît François, un monumento classificato di 360 m2 la cui facciata è stata recentemente ridisegnata."
    ],
    "fr": [
      "La Médiathèque l'Orangerie, située au Clos Faure, donne sur le grand parc de la mairie de St Ismier. C'est une ancienne orangerie restaurée en 1986 par l'architecte Benoît François, un monument classé de 360 m2 dont la façade a été récemment remaniée."
    ],
    "es": [
      "La Médiathèque l'Orangerie, situada en el Clos Faure, domina el gran parque del ayuntamiento de St Ismier. Se trata de una antigua orangerie restaurada en 1986 por el arquitecto Benoît François, monumento protegido de 360 m2 cuya fachada se ha rediseñado recientemente."
    ],
    "nl": [
      "De mediatheek Orangerie, gelegen in Clos Faure, kijkt uit over het grote park van het gemeentehuis van St Ismier. Deze voormalige orangerie werd in 1986 gerestaureerd door architect Benoît François en is een monument van 360 m2 waarvan de gevel onlangs opnieuw is ontworpen."
    ]
  },
