  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ef694771-fadb-3cfa-b68e-f354c47ecf35",
      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungstage:\n\nDienstag bis Samstag von 7:00 bis 13:00 Uhr und von 14:30 bis 19:30 Uhr und Sonntag von 7:00 bis 12:30 Uhr\n\nBestellungen:\nKontaktieren Sie den Laden per Telefon unter 03 21 22 03 04\n\nAbholung:\nZu den Öffnungszeiten der Bäckerei\nOder per Tour\n\nAuf Tournee:\nDie Bäckerei Legros bietet Touren in die umliegenden Dörfer von Aubigny-en-Artois an\n "
        ],
        "en": [
          "Information :\n\nOpening days:\n\nTuesday to Saturday 7am to 1pm and 2:30pm to 7:30pm and Sunday 7am to 12:30pm\n\nOrders :\nContact the store by telephone on 03 21 22 03 04\n\nPick-up:\nDuring bakery opening hours\nOr by round\n\nTours:\nThe Legros bakery offers tours of the villages surrounding Aubigny-en-Artois\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\n\nDa martedì a sabato dalle 7 alle 13 e dalle 14.30 alle 19.30 e domenica dalle 7 alle 12.30\n\nOrdini :\nContattare il negozio per telefono al numero 03 21 22 03 04\n\nRitiro:\nDurante gli orari di apertura della panetteria\nO in giro\n\nVisite guidate:\nIl panificio Legros propone visite ai villaggi che circondano Aubigny-en-Artois\n "
        ],
        "fr": [
          "Informations : \n\nJours d'ouverture: \n\nDu mardi au samedi de 7h à 13h et de 14h30 à 19h30 et le dimanche de 7h à 12h30\n\nCommandes :\nContacter le magasin par téléphone au 03 21 22 03 04\n\nRetrait: \nAux horaires d'ouverture de la boulangerie\nOu par tournée\n\nTournée:\nLa boulangerie Legros propose des tournées dans les villages environnants d'Aubigny-en-Artois\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\n\nDinsdag t/m zaterdag van 7.00 tot 13.00 uur en van 14.30 tot 19.30 uur en zondag van 7.00 tot 12.30 uur\n\nBestellingen :\nNeem telefonisch contact op met de winkel op 03 21 22 03 04\n\nAfhalen:\nTijdens de openingsuren van de bakkerij\nOf per ronde\n\nRondleidingen:\nDe bakkerij Legros biedt rondleidingen door de dorpen rondom Aubigny-en-Artois\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\n\nDe martes a sábado de 7h a 13h y de 14h30 a 19h30 y domingo de 7h a 12h30\n\nPedidos :\nPóngase en contacto con la tienda por teléfono llamando al 03 21 22 03 04\n\nRecogida:\nDurante el horario de apertura de la panadería\nO por ronda\n\nVisitas:\nLa panadería Legros propone visitas a los pueblos de los alrededores de Aubigny-en-Artois\n "
        ]
      },
