    ],
    "fr": [
      "Les 3 Cols - Étape 2 - Du refuge de Péclet Polset au Refuge du Saut"
    ],
    "es": [
      "Les 3 Cols - Etapa 2 - Del refugio de Péclet Polset al refugio de Saut"
    ]
