  "rdfs:comment": {
    "de": [
      "Blumenfarm im Pays de Bourdeaux, wo Alice mit Leidenschaft authentische Schnittblumen im Rhythmus der Jahreszeiten züchtet. Ihre Sträuße finden Sie auf den Tischen Ihrer Veranstaltungen (Hochzeiten, Geburtstage, ...)."
    ],
    "en": [
      "Floral farm in the Pays de Bourdeaux, where Alice passionately cultivates authentic cut flowers, following the rhythm of the seasons. Her bouquets can be found in short circuits, on the tables of your events (weddings, birthdays, ...)."
    ],
    "it": [
      "Una fattoria floreale nel Pays de Bourdeaux, dove Alice coltiva con passione autentici fiori recisi al ritmo delle stagioni. I suoi bouquet si possono trovare nei circuiti brevi, sulle tavole dei vostri eventi (matrimoni, compleanni, ...)"
    ],
    "fr": [
      "Ferme florale au Pays de Bourdeaux où Alice cultive avec passion des fleurs coupées pleine d'authenticité, au rythme des saisons. Ses bouquets sont à retrouver en circuits courts,  sur les tables de vos évènements (mariages, anniversaires, ...)"
    ],
    "es": [
      "Una granja floral en el Pays de Bourdeaux, donde Alice cultiva con pasión auténticas flores cortadas al ritmo de las estaciones. Sus ramos se pueden encontrar en circuitos cortos, en las mesas de sus eventos (bodas, cumpleaños, ...)"
    ],
    "nl": [
      "Een bloemenkwekerij in het Pays de Bourdeaux, waar Alice met passie authentieke snijbloemen kweekt op het ritme van de seizoenen. Haar boeketten zijn te vinden in korte circuits, op de tafels van uw evenementen (bruiloften, verjaardagen, ...)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Raspail - Fleurs de la Drôme"
    ]
  },
