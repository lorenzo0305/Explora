  "rdfs:comment": {
    "de": [
      "Vom Garten auf den Tisch\r\nTradition vermischt sich mit Leichtigkeit.\r\nDas Jardins des Saveurs empfängt Sie am südlichen Ortsausgang von Saint-Euphémie, um eine bistronomische Küche zu entdecken, die Finesse und Gaumenfreuden vereint."
    ],
    "en": [
      "From garden to table\r\nTradition blends with lightness.\r\nLe Jardins des Saveurs welcomes you on the southern outskirts of Saint-Euphémie to discover bistronomic cuisine combining finesse and gourmandise."
    ],
    "it": [
      "Dal giardino alla tavola\r\nLa tradizione si fonde con la leggerezza.\r\nLe Jardins des Saveurs vi accoglie all'uscita sud di Saint-Euphémie per scoprire una cucina bistronomica che unisce finezza e delicatezza."
    ],
    "fr": [
      "Du jardin à la table\r\nLa tradition se mêle à  la légèreté.\r\nLe Jardins des Saveurs vous accueille à la sortie sud de Saint-Euphémie pour découvrir une cuisine bistronomique alliant finesse et gourmandise."
    ],
    "nl": [
      "Van tuin tot tafel\r\nTraditie vermengt zich met lichtheid.\r\nLe Jardins des Saveurs heet u welkom in de zuidelijke uitgang van Saint-Euphémie om een bistronomische keuken te ontdekken die finesse en delicatesse combineert."
    ],
    "es": [
      "Del jardín a la mesa\r\nLa tradición se mezcla con la ligereza.\r\nLe Jardins des Saveurs le da la bienvenida en la salida sur de Saint-Euphémie para descubrir una cocina bistronómica que combina finura y delicadeza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Jardin des Saveurs"
    ]
  },
