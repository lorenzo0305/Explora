  "rdfs:comment": {
    "de": [
      "Das Restaurant la Covagne empfängt Sie und bietet Ihnen die Spezialitäten des Küchenchefs in einer wunderschönen Umgebung im Herzen der Berge, zwischen dem Vallée d'Aulps und dem Vallée d'Abondance."
    ],
    "en": [
      "Here at Le Covagne restaurant, we look forward to welcoming you and tempting you with our chef’s specialities in our superb mountain setting between the Vallée d'Aulps and the Vallée d'Abondance."
    ],
    "it": [
      "Il ristorante Covagne vi accoglie e offre le specialità dello chef in un ambiente superbo nel cuore delle montagne, a cavallo tra la Vallée d'Aulps e la Vallée d'Abondance."
    ],
    "fr": [
      "Le restaurant la Covagne vous accueille et vous propose les spécialités du chef dans un superbe cadre au cœur des montagnes, à cheval entre la Vallée d'Aulps et la Vallée d'Abondance."
    ],
    "nl": [
      "Het restaurant Covagne verwelkomt je en biedt de specialiteiten van de chef in een prachtige omgeving in het hart van de bergen, op de grens tussen de Vallée d'Aulps en de Vallée d'Abondance."
    ],
    "es": [
      "El restaurante Covagne le da la bienvenida y le ofrece las especialidades del chef en un marco incomparable en plena montaña, a caballo entre el Valle de Aulps y el Valle de Abondance."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant La Covagne"
    ],
