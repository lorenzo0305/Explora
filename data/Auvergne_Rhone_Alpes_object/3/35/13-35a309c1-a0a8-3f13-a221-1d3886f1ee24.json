  "rdfs:comment": {
    "de": [
      "Paintball spielen ohne Schmerzen und Flecken. Gel Blaster ist eine dem klassischen Paintball ähnliche Aktivität mit verschiedenen Spielmodi und für Spieler ab 6 Jahren geeignet."
    ],
    "en": [
      "Play paintball pain-free and spotless. Gel Blaster is an activity similar to classic paintball, with different game modes and suitable for players aged 6 and over."
    ],
    "it": [
      "Giocate a paintball senza dolore e senza macchie. Gel Blaster è un'attività simile al paintball classico, con diverse modalità di gioco e adatta a giocatori dai 6 anni in su."
    ],
    "fr": [
      "Jouer au Paintball sans la douleur et sans tache. Le Gel Blaster est une activité similaire au paintball classique, avec différents mode de jeux et adapté aux joueurs à partir de 6 ans."
    ],
    "nl": [
      "Speel paintball zonder pijn en zonder vlekken. Gel Blaster is een activiteit die lijkt op klassiek paintball, met verschillende spelstanden en geschikt voor spelers vanaf 6 jaar."
    ],
    "es": [
      "Juega al paintball sin dolor y sin mancharte. Gel Blaster es una actividad similar al paintball clásico, con diferentes modalidades de juego y apta para jugadores a partir de 6 años."
    ]
  },
