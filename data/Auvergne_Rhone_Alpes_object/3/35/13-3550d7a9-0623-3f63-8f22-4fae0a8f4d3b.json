  "rdfs:comment": {
    "de": [
      "Ein Chateauneuf de Mazenc, unter dem Glockenturm der Stadt, eröffnet Jeannie Lucas seinem Sommeratelier-Galerie in den Kellergewölben des alten Gerichtsverfassungs. Jeden Sommer präsentiert sie ihre neuesten Arbeiten, Gemälde und Keramikskulpturen."
    ],
    "en": [
      "During summer, Jeannie Lucas opens her studio-gallery in Châteauneuf de Mazenc, under the belfry of the village. In the vaulted cellars of the old Judicature she organizes an artistic event with paintings, ceramics, photographies, graphic works…"
    ],
    "it": [
      "A Châteauneuf de Mazenc, sotto il campanile del paese, Jeannie Lucas apre durante l'estate il suo laboratorio-galleria nelle cantine a volta dell'antica Giudicatura, dove organizza un evento artistico di pittura, ceramica, fotografia e opere grafiche"
    ],
    "fr": [
      "A Châteauneuf de Mazenc, sous le beffroi du village, Jeannie Lucas ouvre l'été son atelier-galerie dans les caves voûtées de l'ancienne Judicature où elle organise un évènement artistique en peinture, céramique, photographie, oeuvres graphiques"
    ],
    "es": [
      "En Châteauneuf de Mazenc, bajo el campanario del pueblo, Jeannie Lucas abre durante el verano su taller-galería en las bodegas abovedadas de la antigua Judicatura, donde organiza un evento artístico de pintura, cerámica, fotografía y obra gráfica"
    ],
    "nl": [
      "Een Chateauneuf de Mazenc, onder de klokkentoren van het dorp, Jeannie Lucas opende zijn zomer atelier-galerie in de gewelfde kelders van de oude Judicature.Elke zomer presenteert ze haar recente werken, schilderijen en keramische sculpturen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier d'été Jeannie Lucas"
    ]
  },
