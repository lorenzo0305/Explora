  "rdfs:comment": {
    "de": [
      "Durch Chanteuges können Sie nach Belieben über einen Lavastrom zwischen Desges und Allier wandern. Dieser Basalttisch entstand durch die Abkühlung mehrerer Lavaströme in einem alten Flussnetz."
    ],
    "en": [
      "As you pass through Chanteuges, you can wander along a lava flow perched between Desges and Allier. This basalt table is the result of the cooling of several lava flows installed in an ancient hydrographic network."
    ],
    "it": [
      "Passando per Chanteuges, si può passeggiare lungo una colata lavica arroccata tra Desges e Allier. Questa tavola di basalto è il risultato del raffreddamento di diverse colate di lava incastonate in un antico sistema fluviale."
    ],
    "fr": [
      "A travers Chanteuges, vous pourrez à loisir déambuler sur une coulée de lave perchée entre Desges et Allier. Cette table de basalte est issue du refroidissement de plusieurs coulées de lave installées dans un réseau hydrographique ancien."
    ],
    "nl": [
      "Als je door Chanteuges rijdt, kun je langs een lavastroom wandelen die tussen Desges en Allier ligt. Deze basalttafel is het resultaat van de afkoeling van verschillende lavastromen in een oud rivierenstelsel."
    ],
    "es": [
      "A su paso por Chanteuges, podrá pasear por una colada de lava situada entre Desges y Allier. Esta mesa de basalto es el resultado del enfriamiento de varias coladas de lava encajadas en un antiguo sistema fluvial."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table Volcanique de Chanteuges"
    ]
  },
