  "rdfs:comment": {
    "de": [
      "Julien bietet Ihnen die Möglichkeit, grandiose Landschaften durch Canyoning, Klettersteige, Via Corda, Klettern und das ungewöhnliche Abseilen aus 180 m Höhe zu entdecken."
    ],
    "en": [
      "Discover spectacular landscapes whilst having fun!\r\nCanyoning, rock climbing, via cordata, via ferrata, caving and forest adventure.\r\nCourses available."
    ],
    "it": [
      "Julien è un istruttore specializzato in arrampicata, canyoning, via ferrata, via corda, discesa in corda doppia gigante (sì, 180 m) e guida di persone con disabilità.\nSiete alla ricerca di un'esperienza unica nel cuore della natura, sportiva e contemplativa?"
    ],
    "fr": [
      "Julien moniteur spécialisé en escalade, canyoning, via ferrata, via corda, rappel géant (oui 180m) et dans l'accompagnement de personnes en situation de handicap.\nEnvie de vivre une expérience unique en pleine nature à la fois sportive et contemplative ?"
    ],
    "nl": [
      "Julien nodigt u uit om grandioze landschappen te ontdekken met canyoning, de via Ferrata, de via Corda en het klimmen."
    ],
    "es": [
      "Julien es monitor especializado en escalada, barranquismo, vía ferrata, vía corda, rappel gigante (sí, 180 m) y guía de personas con discapacidad.\nBuscas una experiencia única en plena naturaleza, deportiva y contemplativa?"
    ]
  },
