  "rdfs:comment": {
    "de": [
      "Bei uns ist alles hausgemacht! Bio-Rindfleisch von Salers und Aubrac aus unserem Betrieb, Trüffel, Aligot, ausgezeichnete Desserts.\r\nEntdecken Sie alle regionalen Spezialitäten.\r\nWillkommen auf dem Bauernhof."
    ],
    "en": [
      "Everything is homemade! Organic Salers and Aubrac beef from our farm, truffade, aligot, excellent desserts.\r\nDiscover all the regional specialities.\r\nWelcome to the Farm."
    ],
    "it": [
      "Tutto è fatto in casa! Manzo biologico di Salers e Aubrac della nostra fattoria, truffade, aligot, ottimi dessert.\r\nScoprite tutte le specialità regionali.\r\nBenvenuti alla fattoria."
    ],
    "fr": [
      "Chez nous tout est fait maison ! Viande bovine Salers et Aubrac Bio issues de notre exploitation, truffade, aligot, excellents desserts.\r\nDécouvrez toutes les spécialités régionales.\r\nBienvenue à la Ferme."
    ],
    "es": [
      "Todo es casero Carne de vaca ecológica de Salers y Aubrac de nuestra granja, trufada, aligot, excelentes postres.\r\nDescubra todas las especialidades regionales.\r\nBienvenido a la granja."
    ],
    "nl": [
      "Alles is zelfgemaakt! Biologisch Salers en Aubrac rundvlees van onze boerderij, truffade, aligot, uitstekende desserts.\r\nOntdek alle regionale specialiteiten.\r\nWelkom op de boerderij."
    ]
  },
