  "rdfs:comment": {
    "de": [
      "Genießen Sie ein Picknick mit getrüffelten Wurstwaren, Trüffelkäse und Trüffeldessert, das aus den Trüffeln unseres Betriebs hergestellt wird. Ein Tag mit allem Drum und Dran (Spaziergang, Vorführung der Cavage, Geschichte des Betriebs...)"
    ],
    "en": [
      "Come and enjoy a picnic featuring truffled charcuterie, truffled cheese and truffled desserts made with truffles from our farm. An all-inclusive day (walk, truffle-hunting demonstration, history of the farm...)."
    ],
    "it": [
      "Scoprite una fattoria di tartufi e la storia del tartufo con una passeggiata tra querce e noccioli e una dimostrazione di caccia al tartufo."
    ],
    "fr": [
      "Partez à la découverte d’une truffière et de l’histoire de la truffe avec une balade entre chênes et noisetiers et démonstration de cavage."
    ],
    "nl": [
      "Ontdek een truffelboerderij en de geschiedenis van de truffel met een wandeling tussen eiken- en hazelnootbomen en een demonstratie truffeljagen."
    ],
    "es": [
      "Descubra una explotación trufera y la historia de la trufa con un paseo entre robles y avellanos y una demostración de búsqueda de trufas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Entdeckung des schwarzen Trüffels in der Drôme des Collines - La Baume Saint-Antoine"
    ],
    "en": [
      "Discovering black truffles in the Drôme des Collines - La Baume Saint-Antoine"
    ],
    "fr": [
      "Découverte de la truffe Noire  en  Drôme des Collines - La Baume Saint-Antoine"
    ],
    "nl": [
      "Zwarte truffels ontdekken in de Drôme des Collines - La Baume Saint-Antoine"
    ]
  },
