  "rdfs:comment": {
    "de": [
      "Equi'Dira ist der Traum von Anne, einer Lehrerin für Reittourismus, Züchterin von Freizeit- und Farbpferden und Coach-Pädagogin, die auf Komplizenschaft, Respekt für die Equiden und Abenteuer in der freien Natur setzt."
    ],
    "en": [
      "Equi'Dira is the dream of Anne, an equestrian tourism teacher, breeder of leisure and colored horses, and coach-educator who believes in complicity, respect for horses and adventure in the great outdoors."
    ],
    "it": [
      "Equi'Dira è il sogno di Anne, insegnante di Turismo Equestre, allevatrice di cavalli da tempo libero e di colore e allenatrice-educatrice che crede nella complicità, nel rispetto degli equini e nell'avventura all'aria aperta."
    ],
    "fr": [
      "Equi'Dira, c'est le rêve de Anne, enseignante de Tourisme Equestre, éleveuse de chevaux de loisir et de couleur, coach-éducatrice qui mise sur la complicité, le respect des équidés et l'aventure dans les grands espaces."
    ],
    "nl": [
      "Equi'Dira is de droom van Anne, lerares hippisch toerisme, fokker van vrijetijds- en bonte paarden en coach-educator die gelooft in medeplichtigheid, respect voor paarden en avontuur in de vrije natuur."
    ],
    "es": [
      "Equi'Dira es el sueño de Anne, profesora de Turismo Ecuestre, criadora de caballos de ocio y de color y entrenadora-educadora que cree en la complicidad, el respeto por los equinos y la aventura en plena naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Equi'Dira - Rêve Equestre en Trièves"
    ]
  },
