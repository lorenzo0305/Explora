  "rdfs:comment": {
    "de": [
      "Impulse bietet integrative und pädagogische Naturaktivitäten mit Wanderungen und Bergtouren, die für alle zugänglich sind und von einem fachkundigen Begleiter betreut werden."
    ],
    "en": [
      "Experience the Bugey region for yourself, whether you're on a hike, a walk or a nature outing."
    ],
    "it": [
      "Impulsion offre attività naturalistiche inclusive ed educative, con escursioni e gite in montagna accessibili a tutti, sotto la supervisione di una guida specializzata."
    ],
    "fr": [
      "Impulsion propose des activités nature inclusives et pédagogiques, avec des randonnées et sorties en montagne accessibles à tous, encadrées par un accompagnateur spécialisé."
    ],
    "nl": [
      "Impulsion biedt inclusieve en educatieve natuuractiviteiten, met wandelingen en bergtochten die voor iedereen toegankelijk zijn, onder begeleiding van een gespecialiseerde gids."
    ],
    "es": [
      "Impulsión ofrece actividades de naturaleza inclusivas y educativas, con caminatas y salidas a la montaña accesibles para todos, supervisadas por un guía especializado."
    ]
  },
