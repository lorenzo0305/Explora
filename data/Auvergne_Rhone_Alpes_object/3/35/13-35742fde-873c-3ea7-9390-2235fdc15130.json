  "rdfs:comment": {
    "de": [
      "Anthony und Angy empfangen Sie, um Ihnen in einer gemütlichen Atmosphäre traditionelle Küche, bretonische Galettes und Crêpes zu servieren. Auf unserer nach Süden ausgerichteten Terrasse gegenüber dem Grand Bec empfangen wir Sie mit einem unvergleichlichen Empfang."
    ],
    "en": [
      "Anthony and Angy will be delighted to serve you traditional Breton cuisine, galettes bretonnes and crêpes in a cosy atmosphere. On our south-facing terrace, facing the Grand Bec, we offer you a warm welcome.\r\n\r\nIn the evening, in a cosy atmosphere, enjoy more than 30 references of wines accompanying the restaurant's menu.\r\nFresh and local products.\r\nParking space nearby.\r\nOpen all year long (except annual vacations)"
    ],
    "it": [
      "Anthony e Angy saranno lieti di servirvi la cucina tradizionale bretone, galettes bretonnes e crêpes in un'atmosfera accogliente. Sulla nostra terrazza esposta a sud, di fronte al Grand Bec, vi offriamo un caloroso benvenuto."
    ],
    "fr": [
      "Anthony et Angy vous accueillent pour vous servir une cuisine traditionnelle, galettes bretonnes et crêpes dans une ambiance cosy. Sur notre terrasse exposée plein sud, face au Grand Bec nous vous recevons avec un accueil inégalé."
    ],
    "es": [
      "Anthony y Angy estarán encantados de servirle cocina tradicional bretona, galettes bretonnes y crêpes en un ambiente acogedor. En nuestra terraza orientada al sur, frente al Grand Bec, le ofrecemos una cálida bienvenida."
    ],
    "nl": [
      "Anthony en Angy serveren je graag traditionele Bretonse gerechten, galettes bretonnes en crêpes in een gezellige sfeer. Op ons terras op het zuiden, tegenover de Grand Bec, heten we je van harte welkom."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Goulue"
    ],
    "fr": [
      "Restaurant et crêperie la Goulue"
    ]
  },
