  "rdfs:comment": {
    "de": [
      "Im Herzen des charakteristischen Dorfes Perreux liegt diese Werkstatt/Boutique, die Ihnen offen steht, um die Arbeit mit Keramik durch Erklärungen, Vorführungen von Dreharbeiten oder Töpferkurse zu teilen."
    ],
    "en": [
      "Nestled in the heart of the Village de Caractère de Perreux, this workshop/boutique is open to you to share in the work of ceramics, through explanations, demonstrations of throwing or pottery classes."
    ],
    "it": [
      "Nel cuore del Village de Caractère di Perreux, questo laboratorio/negozio è aperto a tutti per condividere il lavoro della ceramica, attraverso spiegazioni, dimostrazioni di lavorazione e corsi di ceramica."
    ],
    "fr": [
      "Niché au plein cœur du Village de Caractère de Perreux, cet atelier/boutique vous est grand ouvert pour partager le travail de la céramique, au travers d'explications, de démonstrations de tournages ou de cours de poterie."
    ],
    "nl": [
      "Genesteld in het hart van het Village de Caractère in Perreux, is dit atelier/winkel open voor u om te delen in het keramiekwerk, door middel van uitleg, demonstraties van het gooien en pottenbakkerslessen."
    ],
    "es": [
      "Enclavado en el corazón del Village de Caractère de Perreux, este taller/tienda está abierto para compartir el trabajo de la cerámica, a través de explicaciones, demostraciones de vaciado y clases de alfarería."
    ]
  },
