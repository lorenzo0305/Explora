  "rdfs:comment": {
    "de": [
      "3 Töpferinnen, 1 Imker, 1 Holzdrechslerin sind in diesem Laden, der an die Töpferwerkstatt angrenzt, vereint. Hier finden Sie handgefertigte Töpferwaren, Bienenstockprodukte, Schaffelle und handgefertigte Leder- und Holzartikel aus lokaler Produktion."
    ],
    "en": [
      "3 potters, 1 beekeeper, 1 wood turner are all together in this boutique adjoining the pottery workshop. You'll find locally-produced handmade pottery, beehive products, sheepskins, leather and wood objects."
    ],
    "it": [
      "3 ceramisti, 1 apicoltore e 1 tornitore lavorano insieme in questo negozio adiacente al laboratorio di ceramica. Troverete ceramiche di produzione locale, prodotti dell'alveare, pelli di pecora, cuoio e legno."
    ],
    "fr": [
      "3 potières, 1 apiculteur,  1 tourneuse sur bois sont réunis dans cette boutique attenante à l'atelier de poterie. Vous trouverez des poteries artisanales, produits de la ruche, peaux de moutons et objets en cuir et en bois artisanaux en production locale."
    ],
    "nl": [
      "3 pottenbakkers, 1 imker en 1 houtdraaier werken samen in deze winkel naast het pottenbakkersatelier. Je vindt hier lokaal gemaakt aardewerk, bijenkorfproducten, schapenvachten, leer en houtwerk."
    ],
    "es": [
      "3 alfareros, 1 apicultor y 1 tornero trabajan juntos en esta tienda contigua al taller de alfarería. Encontrarás cerámica, productos de la colmena, pieles de oveja, cuero y madera de fabricación local."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Poteries et Compagnie"
    ]
  },
