  "rdfs:comment": {
    "de": [
      "Die 19. Ausgabe von Aluna verspricht unvergessliche Momente für alle zwischen Natur und Kultur, die einen Blick auf die atemberaubenden Landschaften von den Cevennen bis zu den Schluchten der Ardèche bieten."
    ],
    "en": [
      "The 19th edition of Aluna promises unforgettable moments for all, between nature and culture, overlooking breathtaking landscapes from the Cévennes to the Gorges de l'Ardèche."
    ],
    "it": [
      "La 19a edizione di Aluna promette un mix indimenticabile di natura e cultura, con una vista su paesaggi mozzafiato dalle Cévennes alle Gorges de l'Ardèche."
    ],
    "fr": [
      "La 19ème édition d’Aluna promet des moments inoubliables pour tous entre nature et culture offrant une vue sur les paysages époustouflants, des Cévennes aux Gorges de l’Ardèche."
    ],
    "es": [
      "La 19ª edición de Aluna promete una mezcla inolvidable de naturaleza y cultura, con vistas a paisajes impresionantes desde las Cevenas hasta las Gargantas del Ardèche."
    ],
    "nl": [
      "De 19e editie van Aluna belooft een onvergetelijke mix van natuur en cultuur, met uitzicht over adembenemende landschappen van de Cevennen tot de Gorges de l'Ardèche."
    ]
  },
  "rdfs:label": {
