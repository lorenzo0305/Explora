  "rdfs:comment": {
    "de": [
      "Jahrhundert in der ehemaligen Kirche des Ursulinenklosters in Crémieu, einer mittelalterlichen Stadt, die weniger als eine Stunde von Lyon entfernt liegt. Olivier und seine Brauer stellen im Laufe der Jahreszeiten ein Dutzend Rezepte für Fassbiere her."
    ],
    "en": [
      "Based in the former church of the 18th-century Ursuline convent in Crémieu, a medieval town less than an hour from Lyon, Olivier and his brewers create a dozen draught beer recipes over the seasons."
    ],
    "it": [
      "Con sede nell'ex chiesa del convento delle Orsoline del XVIII secolo a Crémieu, una città medievale a meno di un'ora da Lione, Olivier e i suoi birrai creano una dozzina di ricette di birra alla spina nel corso delle stagioni."
    ],
    "fr": [
      "Installé dans l'ancienne église du couvent des ursulines daté du XVIIIe siècle à Crémieu, cité médiévale et à moins d'une heure de Lyon, Olivier et ses brasseurs élaborent au fil des saisons une dizaine de recettes de bières à la pression."
    ],
    "nl": [
      "Olivier en zijn brouwers zijn gevestigd in de voormalige kerk van het 18e-eeuwse Ursulinenklooster in Crémieu, een middeleeuws stadje op minder dan een uur van Lyon. In de loop van de seizoenen creëren Olivier en zijn brouwers een dozijn tapbierrecepten."
    ],
    "es": [
      "Instalados en la antigua iglesia del convento ursulino del siglo XVIII de Crémieu, ciudad medieval situada a menos de una hora de Lyon, Olivier y sus cerveceros elaboran una docena de recetas de cerveza de barril a lo largo de las estaciones."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Ursulines - Craft beer factory"
    ],
    "fr": [
      "Les Ursulines - Fabrique de bières artisanales"
    ]
  },
