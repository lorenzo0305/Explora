  "rdfs:comment": {
    "de": [
      "Am Fuße des Vulkans von Jaujac, in einer natürlichen Umgebung, bietet Ihnen Escape Game Ardèche eine Spielzone für ein Outdoor-Escape-Game. Mehrere verschiedene Universen bieten sich Ihnen an. Groß und Klein sind herzlich willkommen!"
    ],
    "en": [
      "At the foot of the Jaujac volcano, in a natural setting, Escape Game Ardèche offers you an outdoor escape game zone. Several different worlds are available to you. Both young and old are welcome!"
    ],
    "it": [
      "Ai piedi del vulcano Jaujac, in un ambiente naturale, Escape Game Ardèche vi offre una zona di gioco di fuga all'aperto. Ci sono diversi mondi da esplorare. Grandi e piccini sono i benvenuti!"
    ],
    "fr": [
      "Au pied du volcan de Jaujac, dans un cadre naturel, Escape Game Ardèche vous propose une zone de jeux d'escape game extérieur. Plusieurs univers différents s'offrent à vous. Les petits comme les grands sont les bienvenus !"
    ],
    "es": [
      "Al pie del volcán de Jaujac, en un entorno natural, Escape Game Ardèche le ofrece una zona de juegos de escape al aire libre. Hay varios mundos diferentes para explorar. ¡Tanto jóvenes como mayores son bienvenidos!"
    ],
    "nl": [
      "Aan de voet van de vulkaan van Jaujac, in een natuurlijke omgeving, biedt Escape Game Ardèche je een outdoor escape game zone. Er zijn verschillende werelden om te verkennen. Jong en oud zijn welkom!"
    ]
  },
