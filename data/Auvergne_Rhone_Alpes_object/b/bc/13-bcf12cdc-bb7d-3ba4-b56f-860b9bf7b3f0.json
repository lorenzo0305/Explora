  "rdfs:comment": {
    "de": [
      "Die Relais-Mediathek, die sich in der Gemeinde Gimeaux befindet, ist seit 2016 Teil des öffentlichen Lesenetzes. Sie bietet fast 1000 Dokumente zur Ausleihe an (Bücher, Comics, Hörbücher, Jugendalben, DVDs...) und Sie haben Zugang zum gesamten Netz der COM COM."
    ],
    "en": [
      "The relay multimedia library in the commune of Gimeaux joined the public reading network in 2016. It has almost 1,000 items on loan (books, comics, audio books, children's albums, DVDs, etc.) and gives you access to the entire COM COM network."
    ],
    "it": [
      "La biblioteca multimediale a staffetta del comune di Gimeaux ha aderito alla rete di lettura pubblica nel 2016. Dispone di quasi 1.000 articoli in prestito (libri, fumetti, audiolibri, album per bambini, DVD, ecc.) e dà accesso all'intera rete COM COM."
    ],
    "fr": [
      "La médiathèque-relais située sur la commune de Gimeaux, a rejoint le réseau de lecture publique en 2016. Elle propose au prêt presque 1000 documents (livres, BD, livres audio, album jeunesse, DVD...) et vous avez accès à tout le réseau de la COM COM."
    ],
    "es": [
      "La biblioteca multimedia de relevo del municipio de Gimeaux se incorporó a la red de lectura pública en 2016. Cuenta con casi 1.000 obras en préstamo (libros, cómics, audiolibros, álbumes infantiles, DVD, etc.) y te da acceso a toda la red COM COM."
    ],
    "nl": [
      "De mediatheek van de gemeente Gimeaux is in 2016 toegetreden tot het openbare leesnetwerk. De bibliotheek leent bijna 1000 items uit (boeken, strips, audioboeken, kinderalbums, dvd's, enz.) en biedt toegang tot het hele COM COM-netwerk."
    ]
  },
