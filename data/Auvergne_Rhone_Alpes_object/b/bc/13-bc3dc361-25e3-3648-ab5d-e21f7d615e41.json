  "rdfs:comment": {
    "de": [
      "Manuelle Herstellung von Körben, Objekten und künstlerischen Kreationen aus Korbwaren in meiner Werkstatt/Boutique in Rosières. Anbau von verschiedenen Weiden-/Osienarten und Blut-Hartriegel, die für die Korbflechterei nützlich sind. Angebot von Praktika und Kurzausbildungen."
    ],
    "en": [
      "Handmade baskets, objects and artistic basketry creations in my workshop/shop in Rosières. Cultivation of various varieties of willow, rose and dogwood for use in basketry. Training courses and short courses available."
    ],
    "it": [
      "Cesti fatti a mano, oggetti e creazioni di cesteria artistica nel mio laboratorio/negozio di Rosières. Coltivazione di diverse varietà di salice e sanguinello utili per la cesteria. Offro corsi brevi e sessioni di formazione."
    ],
    "fr": [
      "Fabrication manuelle de paniers, objets et créations artistiques en vannerie dans mon atelier/boutique à Rosières. Culture de diverses variétés de saules/osiers et cornouiller sanguin utiles en vannerie. Proposition de stages et formations courtes."
    ],
    "nl": [
      "Handgemaakte manden, objecten en artistieke mandenmakerscreaties in mijn atelier/winkel in Rosières. Teelt van verschillende soorten wilg/osier en bloedkornoelje die nuttig zijn in de mandenmakerij. Ik bied korte cursussen en trainingen aan."
    ],
    "es": [
      "Cestas, objetos y creaciones de cestería artística hechos a mano en mi taller/tienda de Rosières. Cultivo de diversas variedades de sauce/osier y cornejo de sangre útiles en cestería. Ofrezco cursos cortos y de formación."
    ]
  },
