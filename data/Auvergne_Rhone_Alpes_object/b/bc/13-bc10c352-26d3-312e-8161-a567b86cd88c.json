  "rdfs:comment": {
    "de": [
      "Die Destillerie des Bughes ist auf die handwerkliche Herstellung von Spirituosen spezialisiert: Pur Malt, Whisky, Weißalkohol und Liköre aus Eisenkraut-Familienpflanzen.\r\nEntdecken Sie unser Know-how inmitten von handgehämmerten Kupferdestillierapparaten."
    ],
    "en": [
      "The Distillerie des Bughes specializes in the artisanal production of spirits: Pur Malt, Whisky, white spirit and verbena liqueurs.\r\nCome and discover our expertise amidst hand-hammered copper stills."
    ],
    "it": [
      "La Distillerie des Bughes è specializzata nella produzione tradizionale di liquori: puro malto, whisky, acqua ragia e liquori alla verbena.\r\nVenite a scoprire la nostra esperienza tra gli alambicchi di rame martellati a mano."
    ],
    "fr": [
      "La Distillerie des Bughes est spécialisée dans la fabrication artisanale de spiritueux : Pur Malt, Whisky, alcool blanc et liqueurs de verveine-plantation familiale.\r\nVenez découvrir notre savoir-faire au milieu des alambics en cuivre martelés à la main."
    ],
    "es": [
      "La Distillerie des Bughes está especializada en la producción tradicional de bebidas espirituosas: malta pura, whisky, aguardiente blanco y licores de verbena.\r\nVenga a descubrir nuestro saber hacer en medio de alambiques de cobre martillados a mano."
    ],
    "nl": [
      "De Distillerie des Bughes is gespecialiseerd in de traditionele productie van gedistilleerde dranken: pure mout, whisky, white spirit en verbenalikeuren.\r\nKom en ontdek onze expertise te midden van met de hand gehamerde koperen distilleerkolven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Home Distillers - Distillerie des Bughes"
    ]
  },
