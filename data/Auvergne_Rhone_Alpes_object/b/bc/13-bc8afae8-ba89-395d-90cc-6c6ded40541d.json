  "rdfs:comment": {
    "de": [
      "Laurent Voulzy: eine sanfte Stimme, leuchtende Melodien und eine einzigartige musikalische Poesie. Auf der Bühne bietet er eine bezaubernde Reise zwischen zeitlosen Hits, Emotionen und Eleganz."
    ],
    "en": [
      "Laurent Voulzy: a gentle voice, luminous melodies and unique musical poetry. On stage, he offers a spellbinding journey through timeless hits, emotion and elegance."
    ],
    "it": [
      "Laurent Voulzy: una voce delicata, melodie luminose e una poesia musicale unica. Sul palcoscenico, offre un viaggio incantato tra successi senza tempo, emozioni ed eleganza."
    ],
    "fr": [
      "Laurent Voulzy : une voix douce, des mélodies lumineuses et une poésie musicale unique. Sur scène, il offre un voyage envoûtant entre hits intemporels, émotion et élégance."
    ],
    "es": [
      "Laurent Voulzy: una voz suave, melodías luminosas y una poesía musical única. Sobre el escenario, ofrece un viaje hechizante a través de éxitos intemporales, emoción y elegancia."
    ],
    "nl": [
      "Laurent Voulzy: een zachte stem, heldere melodieën en unieke muzikale poëzie. Op het podium biedt hij een betoverende reis langs tijdloze hits, emotie en elegantie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Laurent Voulzy"
    ]
  },
