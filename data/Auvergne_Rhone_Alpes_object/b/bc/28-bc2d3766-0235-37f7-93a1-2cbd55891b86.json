  "rdfs:comment": {
    "de": [
      "Wussten Sie, dass die berühmten Cocottes der Marke in der Nähe von Saint-Quentin hergestellt werden? Es gibt sogar einen Fabrikverkauf, ideal, um ein Souvenir von Ihrem Aufenthalt mit nach Hause zu nehmen."
    ],
    "en": [
      "Did you know that the brand's famous cocottes are made just outside Saint-Quentin? There's even a factory outlet, ideal for taking home a souvenir of your stay."
    ],
    "it": [
      "Sapevate che le famose casseruole del marchio vengono prodotte appena fuori Saint-Quentin? C'è anche un outlet, ideale per portare a casa un souvenir del vostro soggiorno."
    ],
    "fr": [
      "Saviez-vous que les célèbres cocottes de la marque sont fabriquées à côté de Saint-Quentin ? Il y a même un magasin d'usine, idéal pour ramener un souvenir de votre séjour."
    ],
    "es": [
      "¿Sabía que las famosas cazuelas de la marca se fabrican a las afueras de Saint-Quentin? Incluso hay una tienda en la fábrica, ideal para llevarse un recuerdo de su estancia."
    ],
    "nl": [
      "Wist je dat de beroemde braadpannen van het merk net buiten Saint-Quentin worden gemaakt? Er is zelfs een factory outlet, ideaal om een souvenir van je verblijf mee naar huis te nemen."
    ]
  },
  "rdfs:label": {
    "fr": [
