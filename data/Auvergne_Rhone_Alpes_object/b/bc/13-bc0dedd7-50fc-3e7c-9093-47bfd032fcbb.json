  "rdfs:comment": {
    "de": [
      "Die Bibliothek verfügt über Bücher, Zeitschriften, CDs, DVDs, einen Internetanschluss (WLAN), aber auch über: ein System zum freien Austausch von Büchern (Bücherbox), Samen (Kornothek), Veranstaltungen und Workshops zu bestimmten Themen."
    ],
    "en": [
      "The library has books, magazines, CDs, DVDs, internet access (wifi) but also: a system of free exchange of books (book box), seeds (grain library), animations and thematic workshops."
    ],
    "it": [
      "La biblioteca dispone di libri, riviste, CD, DVD, accesso a internet (wifi), ma anche di un sistema di scambio gratuito di libri (book box), semi (seed library), attività e laboratori a tema."
    ],
    "fr": [
      "La bibliothèque dispose de livres, magazines, CD, DVD, poste internet (wifi) mais également : un système de libre-échange de livres (boîte à livres), de graines (grainothèque), des animations et ateliers à thèmes."
    ],
    "es": [
      "La biblioteca cuenta con libros, revistas, CDs, DVDs, acceso a internet (wifi) pero también: un sistema de intercambio gratuito de libros (caja de libros), semillas (biblioteca de semillas), actividades temáticas y talleres."
    ],
    "nl": [
      "De bibliotheek heeft boeken, tijdschriften, cd's, dvd's, internettoegang (wifi) maar ook: een systeem van gratis uitwisseling van boeken (boekenbox), zaden (zadenbibliotheek), thema-activiteiten en workshops."
    ]
  },
  "rdfs:label": {
