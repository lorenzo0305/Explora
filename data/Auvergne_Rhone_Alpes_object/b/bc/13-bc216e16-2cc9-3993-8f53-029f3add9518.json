  "rdfs:comment": {
    "de": [
      "Sylvie, Dominique und Maël laden alle Feinschmecker ein, ihren Betrieb mit roten Früchten zu besuchen, die im Sinne der bäuerlichen Landwirtschaft angebaut werden. Verkauf im Laden nach Vereinbarung: Konfitüren, Sirupe, Coulis, Fruchtsäfte..."
    ],
    "en": [
      "Sylvie and Dominique Bissardon invite gourmets to discover their farm where they grow red fruit according to a reasoned farming approach. Sale of jams, syrups, coulis, fruit juices in the shop by appointment."
    ],
    "it": [
      "Sylvie, Dominique e Maël sono lieti di invitare i buongustai a scoprire la loro fattoria di frutti rossi, coltivati nello spirito dell'agricoltura contadina. Il negozio vende su prenotazione marmellate, sciroppi, coulis, succhi di frutta e altro ancora."
    ],
    "fr": [
      "Sylvie, Dominique et Maël donnent rendez-vous aux gourmands pour venir découvrir leur exploitation de fruits rouges, cultivés dans un esprit d'agriculture paysanne. Vente à la boutique sur rendez vous : confitures, sirops, coulis, jus de fruits..."
    ],
    "es": [
      "Sylvie, Dominique y Maël le invitan a descubrir su explotación de frutos rojos, cultivados con espíritu de agricultura campesina. La tienda vende mermeladas, siropes, coulis, zumos de fruta y mucho más con cita previa."
    ],
    "nl": [
      "Sylvie, Dominique en Maël nodigen fijnproevers graag uit om hun boerderij met rode vruchten te komen ontdekken, geteeld in een geest van boerenlandbouw. De winkel verkoopt jam, siroop, coulis, vruchtensap en meer op afspraak."
    ]
  },
