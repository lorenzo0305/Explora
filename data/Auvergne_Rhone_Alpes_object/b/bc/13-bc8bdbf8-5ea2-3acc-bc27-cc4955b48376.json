  "rdfs:comment": {
    "de": [
      "Das Festival bietet fünf Konzerte mit barocker oder klassischer Musik, eine Konferenz und Überraschungsbesuche an Orten, die dem Publikum wenig oder gar nicht bekannt sind, sowie gesellige Momente mit einem barocken Imbiss, einem Frühstück und einem Umtrunk nach dem Konzert."
    ],
    "en": [
      "The festival features 5 concerts of baroque and classical music, a lecture and surprise visits to places little-known to the public, as well as a baroque snack, breakfast and post-concert drink."
    ],
    "it": [
      "Il festival prevede 5 concerti di musica barocca e classica, una conferenza e visite a sorpresa in luoghi poco noti al pubblico, oltre a una merenda barocca, una colazione e un drink dopo il concerto."
    ],
    "fr": [
      "Ce festival propose 5 concerts de musique baroque ou classique, une conférence et la visite-surprise d’endroits peu ou pas connus du public, ainsi que des moments de grande convivialité, avec un goûter baroque, un petit-déjeuner et un pot d’après-concert."
    ],
    "nl": [
      "Het festival omvat 5 concerten met barokke en klassieke muziek, een lezing en verrassingsbezoeken aan voor het publiek onbekende plaatsen, evenals een barokhapje, een ontbijt en een drankje na het concert."
    ],
    "es": [
      "El festival incluye 5 conciertos de música barroca y clásica, una conferencia y visitas sorpresa a lugares poco conocidos por el público, así como una merienda barroca, un desayuno y una copa después del concierto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journées musicales d'Automne"
    ]
  },
