  "rdfs:comment": {
    "de": [
      "Erleben Sie mit einem Bergführer Berg- und Natursportarten zu allen vier Jahreszeiten: Canyoning, Klettern, Klettersteig, Winterbergsteigen, Skitouren, nordische Skitouren, Eisklettern, Schneeschuhwandern und Schneeschuhbergsteigen."
    ],
    "en": [
      "Nature and adventure activities with a high mountain guide: canyoning, climbing, via ferrata, alpine hiking in winter, ski-mountaineering, nordic skiing, ice waterfall, walking with snow shoes."
    ],
    "it": [
      "Vivere la montagna e gli sport all'aria aperta in tutte e 4 le stagioni con una guida alpina: canyoning, arrampicata, via ferrata, alpinismo invernale, sci alpinismo, sci alpinismo nordico, arrampicata su ghiaccio, escursioni con le racchette da neve e alpinismo con le ciaspole."
    ],
    "fr": [
      "Vivez les sports de montagne et de pleine nature aux 4 saisons avec un guide de haute montagne : canyoning, escalade, via ferrata, alpinisme hivernal, ski de randonnée, ski de rando nordique, cascade de glace, raquette à neige et raquette alpinisme."
    ],
    "es": [
      "Experimente los deportes de montaña y al aire libre en las 4 estaciones con un guía de montaña: barranquismo, escalada, vía ferrata, alpinismo invernal, esquí de travesía, esquí nórdico de travesía, escalada en hielo, raquetas de nieve y alpinismo con raquetas de nieve."
    ],
    "nl": [
      "Ervaar berg- en buitensporten in alle 4 de seizoenen met een berggids: canyoning, klimmen, klettersteigen, winterklimmen, skitochten, nordic skitochten, ijsklimmen, sneeuwschoenwandelen en sneeuwschoenklimmen."
    ]
  },
  "rdfs:label": {
    "en": [
      "High mountain guide - Terre du Cantal"
    ],
    "fr": [
      "Activités et sports de montagne Terre du Cantal"
    ]
  },
