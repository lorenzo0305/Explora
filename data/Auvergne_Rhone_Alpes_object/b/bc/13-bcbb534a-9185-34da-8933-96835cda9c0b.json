  "rdfs:comment": {
    "de": [
      "Entdecke in Begleitung von Marine die geheimnisvolle Welt der Vögel in der Paarungszeit. Höre dir ihren Gesang an und lerne, sie in ihrem Revier zu entschlüsseln.\r\nAb 6 Jahren."
    ],
    "en": [
      "Come and discover the mysterious world of birds at the height of the mating season. Listen to their songs and learn to decipher their territory.\r\nAges 6 and up."
    ],
    "it": [
      "Venite a scoprire con Marine il misterioso mondo degli uccelli nel pieno della stagione degli amori. Ascoltate i loro canti e imparate a decifrare il loro territorio.\r\nA partire dai 6 anni."
    ],
    "fr": [
      "Accompagné de Marine, viens découvrir le monde mystérieux des oiseaux en pleine saison des amours. Ecoute leur chant et apprend à les décrypter sur leur territoire. \r\nDès 6 ans."
    ],
    "es": [
      "Venga a descubrir con Marine el misterioso mundo de las aves en plena época de celo. Escucha sus cantos y aprende a descifrar su territorio.\r\nA partir de 6 años."
    ],
    "nl": [
      "Kom en ontdek de mysterieuze wereld van vogels op het hoogtepunt van het paarseizoen met Marine. Luister naar hun gezang en leer hoe je hun territorium kunt ontcijferen.\r\nVanaf 6 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Découverte des chants des oiseaux"
    ]
  },
