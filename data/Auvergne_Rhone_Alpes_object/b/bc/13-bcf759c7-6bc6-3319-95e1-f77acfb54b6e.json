  "rdfs:comment": {
    "de": [
      "Historisches Lederwarengeschäft an der Hauptstraße von Chamonix. Große Auswahl an Damen-, Herren- und Reiseartikeln, die Qualität, Stil und Funktionalität vereinen, um all Ihren Wünschen gerecht zu werden."
    ],
    "en": [
      "Historic leather goods on Chamonix?s main street. Wide choice of women?s, men?s and travel goods, combining quality, style and functionality to meet your every need."
    ],
    "it": [
      "Storico negozio di pelletteria sulla via principale di Chamonix. Un'ampia scelta di articoli da donna, uomo e da viaggio, che combinano qualità, stile e funzionalità per soddisfare tutte le vostre esigenze."
    ],
    "fr": [
      "Maroquinerie historique sur la rue principale de Chamonix. Large choix d’articles femme, homme et voyage, alliant qualité, style et fonctionnalité pour répondre à toutes vos envies."
    ],
    "nl": [
      "Historische lederwarenwinkel in de hoofdstraat van Chamonix. Een ruime keuze aan dames-, heren- en reisartikelen die kwaliteit, stijl en functionaliteit combineren om aan al je behoeften te voldoen."
    ],
    "es": [
      "Histórica marroquinería en la calle principal de Chamonix. Una amplia selección de artículos para mujer, hombre y viaje, que combina calidad, estilo y funcionalidad para satisfacer todas sus necesidades."
    ]
  },
