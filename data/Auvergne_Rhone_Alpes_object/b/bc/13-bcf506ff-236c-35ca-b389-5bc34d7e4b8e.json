  "rdfs:comment": {
    "de": [
      "Die Ferme de Briska ist ein pädagogischer Bauernhof. Bei Führungen nach Vereinbarung und zahlreichen Veranstaltungen für alle Altersgruppen lernen Sie die Welt der Landwirtschaft auf spielerische und lehrreiche Weise kennen."
    ],
    "en": [
      "Briska's Farm is an educational farm. The guided tour by appointment and the numerous animations for all ages will make you discover the agricultural world in a playful and instructive way."
    ],
    "it": [
      "La Fattoria di Briska è una fattoria didattica. La visita guidata su prenotazione e le numerose attività per tutte le età vi faranno scoprire il mondo agricolo in modo giocoso e istruttivo."
    ],
    "fr": [
      "La Ferme de Briska est une ferme pédagogique. La visite guidée sur rendez-vous et les nombreuses animations pour tous les âges vous feront découvrir  le monde agricole de façon ludique et instructive."
    ],
    "es": [
      "La granja de Briska es una granja educativa. La visita guiada con cita previa y las numerosas actividades para todas las edades le harán descubrir el mundo agrícola de forma lúdica e instructiva."
    ],
    "nl": [
      "Briska's Farm is een educatieve boerderij. De rondleiding op afspraak en de talrijke activiteiten voor alle leeftijden laten u de agrarische wereld op een speelse en leerzame manier ontdekken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme pédagogique de Briska"
    ]
  },
