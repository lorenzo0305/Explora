  "rdfs:comment": {
    "de": [
      "Thibault und Anaïs bieten im Laufe des Jahres Ziegenkäse, Schafsjoghurt, Kalbfleisch, Färsenfleisch, Lämmer und Zicklein an.\r\nFinden Sie sie auf den Märkten!\r\nEs besteht die Möglichkeit, den Bauernhof zu besuchen... und zu probieren!"
    ],
    "en": [
      "Throughout the year, Thibault and Anaïs offer goat's cheese, ewe's yoghurt, veal, heifer, lamb and kid meat.\r\nSee them at the markets!\r\nYou can visit the farm... and taste!"
    ],
    "it": [
      "Durante tutto l'anno, Thibault e Anaïs propongono formaggio di capra, yogurt di pecora, carne di vitello, giovenca, agnello e capretto.\r\nCercateli nei mercati!\r\nPotete visitare la fattoria... e assaggiare!"
    ],
    "fr": [
      "Thibault et Anaïs proposent au fil de l'année du fromages de chèvres, du yaourt de brebis, de la viande veau, de génisse, d'agneaux et de chevreaux.\r\nRetrouvez-les sur les marchés !\r\nPossibilité de visiter la ferme... et de déguster !"
    ],
    "nl": [
      "Het hele jaar door bieden Thibault en Anaïs geitenkaas, schapenyoghurt, kalfs-, vaars-, lams- en geitenvlees aan.\r\nKijk naar ze uit op de markten!\r\nJe kunt de boerderij bezoeken... en proeven!"
    ],
    "es": [
      "Durante todo el año, Thibault y Anaïs ofrecen queso de cabra, yogur de oveja, carne de ternera, novilla, cordero y cabrito.\r\nBúsquelos en los mercados\r\nPuedes visitar la granja... ¡y degustar!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec de la Révolte"
    ]
  },
