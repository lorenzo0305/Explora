  "rdfs:comment": {
    "de": [
      "Das Rätsel des Savoyerkuchens ist Orientierungslauf und Schnitzeljagd zugleich und führt Familien durch Yenne im Savoyer Vorland auf der Suche nach allen Zutaten, die für das Rezept dieses uralten Desserts benötigt werden."
    ],
    "en": [
      "Part orienteering course, part treasure hunt, the Gâteau de Savoie enigma takes families through Yenne, in the Savoyard foreland, in search of all the ingredients needed to make this ancestral dessert."
    ],
    "it": [
      "In parte percorso di orienteering, in parte caccia al tesoro, l'enigma del Gâteau de Savoie conduce le famiglie attraverso Yenne, nell'avampaese savoiardo, alla ricerca di tutti gli ingredienti necessari per preparare questo dolce ancestrale."
    ],
    "fr": [
      "À la fois parcours d’orientation et jeu de piste, l’énigme du Gâteau de Savoie entraîne les familles à travers Yenne, dans l’avant-pays Savoyard, à la quête de tous les ingrédients nécessaires à la recette de cet ancestral dessert."
    ],
    "nl": [
      "Het enigma Gâteau de Savoie, deels oriëntatieloop, deels schattenjacht, neemt gezinnen mee door Yenne, in het voorland van de Savoie, op zoek naar alle ingrediënten die nodig zijn om dit voorouderlijke dessert te maken."
    ],
    "es": [
      "En parte recorrido de orientación, en parte búsqueda del tesoro, el enigma del Gâteau de Savoie lleva a las familias a través de Yenne, en el antepaís saboyano, en busca de todos los ingredientes necesarios para elaborar este postre ancestral."
    ]
  },
  "rdfs:label": {
    "en": [
      "Enigma of the Gâteau de Savoie"
    ],
    "fr": [
      "Enigme du Gâteau de Savoie"
    ],
    "nl": [
      "Raadsel van het kasteel van Savoie"
    ]
  },
