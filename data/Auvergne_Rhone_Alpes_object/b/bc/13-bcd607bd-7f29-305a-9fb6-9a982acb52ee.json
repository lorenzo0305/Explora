  "rdfs:comment": {
    "de": [
      "Die Pool House Snackbar empfängt Sie den ganzen Sommer über am Pool und am Park. Eis, süße Crêpes, Smoothies, Sandwiches, Paninis, Hot Dogs, Pommes frites. Getränke und Snacks zum Verzehr vor Ort oder zum Mitnehmen. Überdachte Terrasse"
    ],
    "en": [
      "The Pool House snack bar welcomes you poolside and parkside all summer long. Ice creams, sweet crepes, smoothies, sandwiches, paninis, hot dogs, French fries. Drinks and snacks to eat in or take away. Covered terrace"
    ],
    "it": [
      "Lo snack bar Pool House vi accoglie in piscina e nel parco per tutta l'estate. Gelati, crepes dolci, frullati, panini, panini, hot dog, patatine. Bevande e snack da consumare o da portare via. Terrazza coperta"
    ],
    "fr": [
      "Le Pool House snack bar vous accueille  côté piscine et côté parc tout l'été. Glaces, crêpes sucrées, smoothies, sandwichs, paninis, hot dog, frites. Boissons et snack à consommer sur place ou à emporter. Terrasse couverte"
    ],
    "es": [
      "El snack bar Pool House le da la bienvenida junto a la piscina y el parque durante todo el verano. Helados, crepes dulces, batidos, sándwiches, paninis, perritos calientes, patatas fritas. Bebidas y aperitivos para comer en el bar o para llevar. Terraza cubierta"
    ],
    "nl": [
      "De Pool House snackbar verwelkomt je de hele zomer bij het zwembad en het park. IJsjes, zoete pannenkoeken, smoothies, broodjes, panini's, hotdogs, frietjes. Drankjes en snacks om te eten of mee te nemen. Overdekt terras"
    ]
  },
