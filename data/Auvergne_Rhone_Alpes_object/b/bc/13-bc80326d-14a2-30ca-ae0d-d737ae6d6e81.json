  "rdfs:comment": {
    "de": [
      "Möchten Sie hoch hinaus, um unsere Panoramen zu bewundern, aber ohne Anstrengung? Das ist möglich! Die Gondelbahn Côte du Bois"
    ],
    "en": [
      "Would you like to get up high and admire our panoramic views effortlessly? It's possible! The Côte du bois gondola  is there for you!"
    ],
    "it": [
      "Volete salire in alto e ammirare le nostre viste panoramiche senza sforzo? È possibile! La funivia della Côte du Bois."
    ],
    "fr": [
      "Vous souhaitez prendre de la hauteur pour admirez nos panoramas mais sans effort ? C'est possible ! La Télécabine Côte du bois."
    ],
    "es": [
      "¿Le gustaría subir a lo alto y admirar nuestras vistas panorámicas sin esfuerzo? Es posible El teleférico de la Côte du Bois."
    ],
    "nl": [
      "Wil je hoog komen en moeiteloos onze panoramische uitzichten bewonderen? Het is mogelijk! De Côte du bois stoeltjeslift is er voor jou!"
    ]
  },
