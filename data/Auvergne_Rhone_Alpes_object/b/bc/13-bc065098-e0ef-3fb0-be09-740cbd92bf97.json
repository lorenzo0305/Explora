  "rdfs:comment": {
    "de": [
      "Zeitgenössisches Restaurant empfängt Feinschmecker in einem schönen Saal, in dem zwei extreme und doch so nahe Welten harmonisch miteinander verschmelzen: die Welt der Berge und des Meeres, des Holzes und der Korallen."
    ],
    "en": [
      "Contemporary restaurant welcomes gourmets in a beautiful room harmoniously blending two extreme and so close universes, that of the mountain and the sea, wood and coral."
    ],
    "it": [
      "Un ristorante contemporaneo che accoglie i buongustai in una splendida sala che fonde armoniosamente due mondi estremi e così vicini, quello della montagna e del mare, del legno e del corallo."
    ],
    "fr": [
      "Restaurant contemporain accueille les gourmets dans une belle salle mélant harmonieusement deux univers extrêmes et si proches, celui de la montagne et de la mer, du bois et du corail."
    ],
    "es": [
      "Un restaurante contemporáneo que acoge a los gastrónomos en una hermosa sala que mezcla armoniosamente dos mundos extremos y tan cercanos, el de la montaña y el del mar, el de la madera y el del coral."
    ],
    "nl": [
      "Een eigentijds restaurant dat fijnproevers verwelkomt in een prachtige ruimte waarin twee extreme en zo nabije werelden, die van de berg en de zee, van hout en koraal, harmonieus samengaan."
    ]
  },
