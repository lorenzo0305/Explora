  "rdfs:comment": {
    "de": [
      "Das Restaurant Resto du Parc befindet sich im Quartier de la Gare, im Gewerbegebiet Rovaltain.\r\n\r\nDas Resto du Parc bietet einen Selbstbedienungsbereich, in dem man zu Mittag essen kann, im Speisesaal oder auf der Terrasse."
    ],
    "en": [
      "The Resto du Parc restaurant is located in the Quartier de la Gare area of the Rovaltain business park.\r\n\r\nResto du Parc offers a self-service area, where you can enjoy lunch either inside or on the terrace."
    ],
    "it": [
      "Il ristorante Resto du Parc si trova nel Quartier de la Gare, nel parco commerciale Rovaltain.\r\n\r\nIl Resto du Parc dispone di un'area self-service, dove è possibile pranzare all'interno o sulla terrazza."
    ],
    "fr": [
      "Le restaurant Resto du Parc est situé Quartier de la Gare, sur le parc d'activités de Rovaltain.\r\n\r\nLe Resto du Parc propose un espace self service, où il est possible de déjeuner, en salle ou en terrasse."
    ],
    "nl": [
      "Het restaurant Resto du Parc ligt in het Quartier de la Gare, op het bedrijventerrein Rovaltain.\r\n\r\nResto du Parc heeft een zelfbedieningsruimte, waar u binnen of op het terras kunt lunchen."
    ],
    "es": [
      "El restaurante Resto du Parc está situado en el Quartier de la Gare, en el parque empresarial Rovaltain.\r\n\r\nEl Resto du Parc dispone de una zona de autoservicio, donde podrá almorzar en el interior o en la terraza."
    ]
  },
