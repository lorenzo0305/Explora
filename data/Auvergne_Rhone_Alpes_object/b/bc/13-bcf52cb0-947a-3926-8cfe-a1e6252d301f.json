  "rdfs:comment": {
    "de": [
      "Savoie Loisir, der Marktführer für Segway-Aktivitäten in Savoyen, bietet Ihnen zahlreiche Ausflüge und Wanderungen mit dem Segway zu den schönsten Orten in Savoyen an: Chambéry, Savoie Grand Revard, Valloire, Les Karellis, Lac du Bourget oder die savoyischen Weinberge."
    ],
    "en": [
      "Leader of the Segway activity in Savoie, Savoie Loisir offers you many walks and Segway rides on the most beautiful sites of Savoie: Chambéry, Savoie Grand Revard, Valloire, Les Karellis, the Lac du Bourget or the Savoyard vineyards."
    ],
    "it": [
      "Savoie Loisir, il principale operatore di Segway della Savoia, offre una vasta gamma di corse ed escursioni in Segway in alcune delle più belle località della Savoia: Chambéry, Savoia Grand Revard, Valloire, Les Karellis, Lac du Bourget e i vigneti della Savoia."
    ],
    "fr": [
      "Leader de l'activité Segway en Savoie, Savoie Loisir vous propose de nombreuses balades et randonnées à Segway sur les plus beaux sites de Savoie : Chambéry, Savoie Grand Revard, Valloire, Les Karellis, le Lac du Bourget ou les vignobles savoyards."
    ],
    "es": [
      "Savoie Loisir, el principal operador de Segway de Savoie, ofrece una amplia gama de paseos y excursiones en Segway en algunos de los lugares más bellos de Savoie: Chambéry, Savoie Grand Revard, Valloire, Les Karellis, Lac du Bourget y los viñedos de Savoie."
    ],
    "nl": [
      "Savoie Loisir, de toonaangevende Segway-operator van de Savoie, biedt een breed scala aan Segway-ritten en excursies in enkele van de mooiste locaties van de Savoie: Chambéry, Savoie Grand Revard, Valloire, Les Karellis, Lac du Bourget en de wijngaarden van de Savoie."
    ]
  },
