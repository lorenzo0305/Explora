  "rdfs:comment": {
    "de": [
      "Das Restaurant Le P?tit Montmartre lädt Sie zu einem kulinarischen Erlebnis ein, bei dem jedes Gericht eine Geschichte erzählt.\r\nIn verschiedenen Kapiteln entdecken Sie eine raffinierte Küche, die Ihren Gaumen auf eine Reise schickt."
    ],
    "en": [
      "Restaurant Le P?tit Montmartre invites you to a culinary experience where each dish tells a story.\r\nCome and discover a refined cuisine that will take your taste buds on a journey."
    ],
    "it": [
      "Le P?tit Montmartre vi invita a un'esperienza culinaria in cui ogni piatto racconta una storia.\r\nVenite a scoprire una cucina raffinata che farà viaggiare le vostre papille gustative."
    ],
    "fr": [
      "Le restaurant Le P’tit Montmartre vous invite à une expérience culinaire où chaque plat raconte une histoire.\r\nÀ travers différents chapitres, venez découvrir une cuisine raffinée qui fera voyager vos papilles."
    ],
    "nl": [
      "Le P?tit Montmartre nodigt u uit voor een culinaire ervaring waar elk gerecht een verhaal vertelt.\r\nKom en ontdek een verfijnde keuken die je smaakpapillen meeneemt op een reis."
    ],
    "es": [
      "Le P?tit Montmartre le invita a una experiencia culinaria en la que cada plato cuenta una historia.\r\nVenga a descubrir una cocina refinada que hará viajar a sus papilas gustativas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le P'tit Montmartre"
    ]
  },
