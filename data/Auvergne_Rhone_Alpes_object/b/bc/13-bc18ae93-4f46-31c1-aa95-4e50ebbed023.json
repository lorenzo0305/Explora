  "rdfs:comment": {
    "de": [
      "Gourmetrestaurant unter der Leitung von Jacques DECORET, dem besten Arbeiter Frankreichs. Erfindungsreiche und einfallsreiche, präzise und wertvolle Küche. 1 Michelin-Stern, 4 Toques Gault & Millau, in Reiseführern verzeichnet. 5 originelle Zimmer."
    ],
    "en": [
      "Gastronomic restaurant under the leadership of Jacques DECORET, Meilleur ouvrier de France. Inventive and ingenious, precise and precious cuisine. 1 Michelin star, 4 Toques Gault & Millau, referenced in the guides. 5 original rooms."
    ],
    "it": [
      "Ristorante gastronomico sotto la guida di Jacques DECORET, Meilleur ouvrier de France. Una cucina inventiva e geniale, precisa e preziosa. 1 stella Michelin, 4 Toques Gault & Millau, segnalato nelle guide. 5 camere originali."
    ],
    "fr": [
      "Restaurant gastronomique sous la houlette de Jacques DECORET, Meilleur ouvrier de France. Cuisine inventive et ingénieuse, précise et précieuse. 1 étoile Michelin, 4 Toques Gault & Millau, référencé dans les guides. 5 chambres originales."
    ],
    "es": [
      "Restaurante gastronómico bajo la dirección de Jacques DECORET, Meilleur ouvrier de France. Una cocina inventiva e ingeniosa, precisa y preciosa. 1 estrella Michelin, 4 Toques Gault & Millau, referenciado en las guías. 5 habitaciones originales."
    ],
    "nl": [
      "Gastronomisch restaurant onder leiding van Jacques DECORET, Meilleur ouvrier de France. Inventieve en ingenieuze keuken, precies en kostbaar. 1 Michelin-ster, 4 Toques Gault & Millau, vermeld in de gidsen. 5 originele kamers."
    ]
  },
