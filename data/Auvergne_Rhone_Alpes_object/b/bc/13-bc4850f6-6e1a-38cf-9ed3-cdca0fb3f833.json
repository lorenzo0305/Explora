  "rdfs:comment": {
    "de": [
      "Chocolatiers d'art et Cie vereint handwerkliche Herstellung und 3D-Druck aus\r\nBio-Kakao aus Lateinamerika, der mit aromatischen Pflanzen und Früchten kombiniert wird.\r\naus der Drôme."
    ],
    "en": [
      "Come and discover our shared boutique-workshop and taste our organic and fair trade chocolates, hand-made, from great pure origin vintages (Guatemala, Peru, Haiti, Dominican Republic). Artisanal coffee roasting on site."
    ],
    "it": [
      "Venite a scoprire la nostra boutique-laboratorio condivisa e a degustare i nostri cioccolatini artigianali biologici ed equosolidali, prodotti con le migliori annate di pura origine (Guatemala, Perù, Haiti, Repubblica Dominicana). Torrefazione artigianale di caffè in loco."
    ],
    "fr": [
      "Venez découvrir notre boutique-atelier partagée et déguster nos chocolats bio et équitables, façonnés à la main, issus de grands crus pures origines (Guatemala, Pérou, Haïti, République Dominicaine). Torréfaction artisanale de cafés sur place."
    ],
    "es": [
      "Venga a descubrir nuestro taller-boutique compartido y a degustar nuestros chocolates artesanales ecológicos y de comercio justo, elaborados con las mejores cosechas de origen puro (Guatemala, Perú, Haití, República Dominicana). Tostado artesanal de café in situ."
    ],
    "nl": [
      "Chocolatiers d'art et Cie combineert traditionele productie met 3D-printen met behulp van\r\nbiologische cacao uit Latijns-Amerika, gecombineerd met aromatische planten en fruit\r\nuit de Drôme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chocolatiers d'Art et Cie"
    ]
  },
