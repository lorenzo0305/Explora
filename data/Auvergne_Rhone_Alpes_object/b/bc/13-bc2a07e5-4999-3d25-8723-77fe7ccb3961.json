  "rdfs:comment": {
    "de": [
      "Die Brasserie Madeleine ist seit fast einem Vierteljahrhundert eine Institution auf dem Place de la Victoire.\r\nSie befindet sich am Fuße der Kathedrale und ist der ideale Ort, um mit Freunden zu essen oder etwas zu trinken!"
    ],
    "en": [
      "Brasserie Madeleine has been an institution on Place de la Victoire for almost a quarter of a century.\r\nLocated at the foot of the Cathedral, it's the ideal place to come for a meal or a drink with friends!"
    ],
    "it": [
      "La Brasserie Madeleine è un'istituzione in Place de la Victoire da quasi un quarto di secolo.\r\nSituata ai piedi della Cattedrale, è il luogo ideale per un pasto o un drink con gli amici!"
    ],
    "fr": [
      "La Brasserie Madeleine, c’est une institution sur la place de la Victoire depuis près d’un quart de siècle. \r\nSitué au pied de la Cathédrale, c'est un lieu idéal pour venir manger ou boire un verre entre amis !"
    ],
    "es": [
      "La Brasserie Madeleine es una institución en la Place de la Victoire desde hace casi un cuarto de siglo.\r\nSituada a los pies de la catedral, es el lugar ideal para comer o tomar una copa con los amigos"
    ],
    "nl": [
      "Brasserie Madeleine is al bijna een kwart eeuw een begrip op de Place de la Victoire.\r\nGelegen aan de voet van de kathedraal is het de ideale plek om te komen eten of drinken met vrienden!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie Madeleine"
    ]
  },
