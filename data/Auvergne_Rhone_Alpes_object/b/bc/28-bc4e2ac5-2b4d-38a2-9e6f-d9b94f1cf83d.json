  "rdfs:comment": {
    "de": [
      "Ihr werdet es mögen: eine reichhaltige und abwechslungsreiche Speisekarte mit einer großen Auswahl an Gerichten, die alle gleichermaßen herzhaft und raffiniert sind"
    ],
    "en": [
      "You'll love: a rich and varied menu with a wide choice of dishes, each as hearty and refined as the next"
    ],
    "it": [
      "Vi piacerà: un menu ricco e variegato con un'ampia scelta di piatti, uno più sostanzioso e raffinato dell'altro"
    ],
    "fr": [
      "Vous aimerez : une carte riche et variée avec un large choix de plats tous aussi copieux et raffinés les uns que les autres"
    ],
    "nl": [
      "U zult genieten van: een rijk en gevarieerd menu met een ruime keuze aan gerechten, de een nog hartiger en verfijnder dan de ander"
    ],
    "es": [
      "Le encantará: un menú rico y variado con una amplia selección de platos, cada uno tan abundante y refinado como el siguiente"
    ]
