  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c1fe01cf-ba6b-3460-87d9-e171c9476616",
      "dc:description": {
        "de": [
          "Informationen :\n\nTage der Öffnung:\nGeschlossen während der Eindämmung\n\n\nBestellungen:\nBestellungen können über die Facebook-Seite, per E-Mail oder Telefon aufgegeben werden\n\nAbholung der Bestellungen im Geschäft oder Liefermöglichkeit\n\n "
        ],
        "en": [
          "Information :\n\nOpening days:\nClosed during confinement\n\n\nOrdering :\nOrders can be placed on our facebook page, by mail or by phone\n\nIn-store pick-up or delivery possible\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura:\nChiuso durante il confino\n\n\nOrdini :\nLe ordinazioni possono essere effettuate tramite la nostra pagina Facebook, per e-mail o per telefono\n\nGli ordini possono essere ritirati in negozio o consegnati a domicilio\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture:\nFermé pendant le confinement\n\n\nCommandes :\nPossibilité de commande sur la page facebook, par mail ou téléphone \n\nRetrait des commandes en magasin ou possibilité de livraison\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen:\nGesloten tijdens de opsluiting\n\n\nBestellingen :\nBestellingen kunnen worden geplaatst op onze facebookpagina, per e-mail of per telefoon\n\nBestellingen kunnen worden opgehaald in de winkel of worden thuisbezorgd\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura:\nCerrado durante el cierre\n\n\nPedidos :\nLos pedidos se pueden hacer a través de nuestra página de facebook, por correo electrónico o por teléfono\n\nLos pedidos pueden recogerse en la tienda o entregarse en su domicilio\n\n "
        ]
      },
