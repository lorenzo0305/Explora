  "rdfs:comment": {
    "de": [
      "Dorfkraftwerke sind lokale Gesellschaften, deren Ziel es ist, erneuerbare Energien in einem Gebiet zu entwickeln, indem sie Bürger, Gebietskörperschaften und lokale Unternehmen zusammenbringen."
    ],
    "en": [
      "Centrales Villageoises are local companies whose aim is to develop renewable energies in a given area by bringing together citizens, local authorities and local businesses."
    ],
    "it": [
      "Le Centrales Villageoises sono società locali il cui obiettivo è sviluppare le energie rinnovabili in una determinata area riunendo cittadini, autorità locali e imprese locali."
    ],
    "fr": [
      "Les Centrales Villageoises sont des sociétés locales qui ont pour but de développer les énergies renouvelables sur un territoire en associant citoyens, collectivités et entreprises locales."
    ],
    "es": [
      "Las Centrales Aldeanas son empresas locales cuyo objetivo es desarrollar las energías renovables en una zona determinada, reuniendo a los ciudadanos, las autoridades locales y las empresas locales."
    ],
    "nl": [
      "Centrales Villageoises zijn lokale bedrijven die als doel hebben om hernieuwbare energie te ontwikkelen in een bepaald gebied door burgers, lokale autoriteiten en lokale bedrijven samen te brengen."
    ]
  },
  "rdfs:label": {
