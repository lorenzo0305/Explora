  "rdfs:comment": {
    "de": [
      "Willkommen bei Domaine de la Madone Cave & Boutique in Fleurie.\r\nHistorisch in diesem Cru verwurzelt, bieten wir eine Vielfalt an Weinstilen, die von der Lage, dem Terroir, dem Alter der Reben und der Weinbereitung abhängen..."
    ],
    "en": [
      "Welcome to Domaine de la Madone Cave & Boutique in Fleurie.\r\nHistorically established on this cru, we offer a diversity of wine styles depending on the location, the terroir, the age of the vines and the vinification..."
    ],
    "it": [
      "Benvenuti al Domaine de la Madone Cave & Boutique di Fleurie.\r\nStoricamente insediati in questa regione, offriamo una varietà di stili di vino a seconda della posizione, del terroir, dell'età delle viti e della vinificazione..."
    ],
    "fr": [
      "Bienvenue au Domaine de la Madone Cave & Boutique à Fleurie.\r\nHistoriquement implanté sur ce cru, nous offrons une diversité de style de vin selon l'emplacement, le terroir, l'âge des vignes et la vinification..."
    ],
    "nl": [
      "Welkom bij Domaine de la Madone Cave & Boutique in Fleurie.\r\nVan oudsher gevestigd in deze regio, bieden wij een diversiteit aan wijnstijlen, afhankelijk van de locatie, het terroir, de leeftijd van de wijnstokken en de vinificatie..."
    ],
    "es": [
      "Bienvenido a Domaine de la Madone Cave & Boutique en Fleurie.\r\nHistóricamente establecidos en esta región, ofrecemos una diversidad de estilos de vino en función de la ubicación, el terroir, la edad de las vides y la vinificación...."
    ]
  },
