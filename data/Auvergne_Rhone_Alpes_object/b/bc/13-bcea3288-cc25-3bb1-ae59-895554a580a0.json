  "rdfs:comment": {
    "de": [
      "Mehrfach ausgezeichnet bei nationalen und weltweiten Wettbewerben. Patrice und Nadège bieten Ihnen ihre Gourmetpizzen und hausgemachten Desserts zum Mitnehmen oder zum Verzehr vor Ort an. Denken Sie an eine Reservierung."
    ],
    "en": [
      "Winners of several national and international competitions. Patrice and Nadège offer gourmet pizzas and homemade desserts to take away or eat in. Don't forget to make a reservation."
    ],
    "it": [
      "Vincitori di numerosi concorsi nazionali e internazionali. Patrice e Nadège propongono pizze gourmet e dessert fatti in casa da asporto o da mangiare a casa. Non dimenticate di prenotare in anticipo."
    ],
    "fr": [
      "Récompensés à plusieurs reprises lors des concours nationaux et mondiaux. Patrice et Nadège vous proposent leurs pizzas gourmandes et desserts maison à emporter ou à déguster sur place. Pensez à réserver."
    ],
    "nl": [
      "Winnaars van verschillende nationale en internationale wedstrijden. Patrice en Nadège bieden gastronomische pizza's en huisgemaakte desserts om mee te nemen of om ter plekke op te eten. Vergeet niet van tevoren te reserveren."
    ],
    "es": [
      "Ganadores de varios concursos nacionales e internacionales. Patrice y Nadège ofrecen pizzas gourmet y postres caseros para llevar o comer en casa. No olvide reservar con antelación."
    ]
  },
  "rdfs:label": {
