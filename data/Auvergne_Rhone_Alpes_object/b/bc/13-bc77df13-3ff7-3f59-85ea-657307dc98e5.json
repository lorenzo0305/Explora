  "rdfs:comment": {
    "de": [
      "MTA Vinyl shop ist ein kleiner Plattenladen, der gebrauchte Schallplatten kauft, repariert und wieder verkauft. Sie können auch gebrauchte Hi-Fi-Geräte kaufen, die er repariert und verkauft, und Ihre Geräte zur Wartung oder Reparatur bringen (Plattenspieler, Verstärker usw.)."
    ],
    "en": [
      "MTA Vinyl shop is a small record shop that buys, recovers and resells second-hand vinyl records. You can also find second-hand hi-fi equipment, which he repairs and resells, and bring in your own equipment for maintenance or repair (turntables, amplifiers, etc.)."
    ],
    "it": [
      "MTA Vinyl shop è un piccolo negozio di dischi che acquista, recupera e rivende dischi in vinile di seconda mano. È inoltre possibile trovare apparecchiature hi-fi di seconda mano, che vengono riparate e rivendute, e portare le proprie apparecchiature per la manutenzione o la riparazione (giradischi, amplificatori, ecc.)."
    ],
    "fr": [
      "MTA Vinyl shop est un petit disquaire qui achète, récupère et revend des vinyles d'occasion. Vous pouvez aussi trouver du matériel hi-fi d'occasion, qu'il répare et revend, et amener votre matériel pour entretien ou réparation (platines, amplis…)."
    ],
    "nl": [
      "MTA Vinyl shop is een kleine platenzaak die tweedehands vinylplaten koopt, herstelt en doorverkoopt. Je kunt er ook terecht voor tweedehands hifi-apparatuur, die wordt gerepareerd en doorverkocht, en je eigen apparatuur inbrengen voor onderhoud of reparatie (draaitafels, versterkers, enz.)."
    ],
    "es": [
      "MTA Vinyl shop es una pequeña tienda de discos que compra, recupera y revende discos de vinilo de segunda mano. También puedes encontrar equipos de alta fidelidad de segunda mano, que repara y revende, y llevar tus propios equipos para su mantenimiento o reparación (giradiscos, amplificadores, etc.)."
    ]
  },
