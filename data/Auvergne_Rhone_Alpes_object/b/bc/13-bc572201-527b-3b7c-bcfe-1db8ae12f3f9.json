  "rdfs:comment": {
    "de": [
      "Gehen Sie auf Entdeckungsreise in die Welt dieser außergewöhnlichen Hunde:\r\n- Mushing (Gespannfahren) das ganze Jahr über\r\n- Cani-Wanderungen und geführte Besichtigungen nach Vereinbarung von April bis 14. Dezember."
    ],
    "en": [
      "Discover the world of these extraordinary dogs:\r\n- Mushing (carriage driving) all year round\r\n- Cani randonnée and guided tours by appointment from April to December 14."
    ],
    "it": [
      "Scoprite il mondo di questi cani straordinari:\r\n- Mushing (guida in carrozza) tutto l'anno\r\n- Passeggiate con i cani e visite guidate su prenotazione da aprile al 14 dicembre."
    ],
    "fr": [
      "Partez à la découverte de l'univers de ces chiens hors normes :\r\n- Mushing (conduite d'attelage) toute l'année\r\n- Cani randonnée et visite guidée sur rendez-vous d'avril au 14 décembre."
    ],
    "nl": [
      "Ontdek de wereld van deze bijzondere honden:\r\n- Mushing (koets rijden) het hele jaar door\r\n- Hondenuitlaatservice en rondleidingen op afspraak van april tot 14 december."
    ],
    "es": [
      "Descubra el mundo de estos extraordinarios perros:\r\n- Mushing (paseos en carruaje) todo el año\r\n- Paseos con perros y visitas guiadas con cita previa de abril al 14 de diciembre."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Elevage le Clos de la Vallée Blanche : à la Découverte du Monde des Chiens Polaires - Eric Boubert"
    ]
  },
