  "rdfs:comment": {
    "de": [
      "Im Sommer Möglichkeit zu Mountainbike-Touren zur Erkundung der Wanderrouten. Bergrestaurant ‚Altitude 2000‘ auf dem Gipfel. Zugang zum Gleitschirmabfluggelände. Kabinenbahn im Winter täglich geöffnet."
    ],
    "en": [
      "In summer, take your mountain bikes on the cable car to discover the local trails. Altitude 2000 restaurant at the top. Access to paragliding departure point. Cable car open daily in winter."
    ],
    "it": [
      "In estate: possibilità di andare in mountain bike da discesa e scoprire i percorsi di downhill. Quota 2000 ristorante in vetta. Accesso all'area di partenza del parapendio.\r\nFunivia aperta tutti i giorni in inverno."
    ],
    "fr": [
      "En été : possibilité de monter les VTT de descente et de découvrir les itinéraires à profil descendant. Restaurant Altitude 2000 au sommet. Accès à l'aire de départ des parapentes.\r\nTélécabine ouverte tous les jours en hiver."
    ],
    "nl": [
      "In de zomer: mogelijkheid om te mountainbiken en de downhill routes te ontdekken. Hoogte 2000 restaurant op de top. Toegang tot het vertrekgebied voor paragliding.\r\nKabelbaan elke dag open in de winter."
    ],
    "es": [
      "En verano: posibilidad de montar en bicicleta de montaña y descubrir las rutas de descenso. Restaurante de altitud 2000 en la cumbre. Acceso a la zona de salida del parapente.\r\nTeleférico abierto todos los días en invierno."
    ]
  },
  "rdfs:label": {
    "de": [
      "Offene Gondelbahn Cote 2000"
    ],
    "en": [
      "Cable car Cote 2000"
    ],
    "fr": [
      "Télécabine de la Cote 2000"
    ]
  },
