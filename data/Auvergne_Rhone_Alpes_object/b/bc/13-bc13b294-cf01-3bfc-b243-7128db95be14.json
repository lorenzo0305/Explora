  "rdfs:comment": {
    "de": [
      "Produzent von Schafskäse, Schafsjoghurt, Dessertcreme und Eis aus Schafsmilch: Vanille, Schokolade, weiße Schokolade, Praliné, Karamell, Kaffee, Kastanie, Himbeere, schwarze Johannisbeere, Zitrone.\r\nAlles aus Schafsmilch und Bio-Anbau!"
    ],
    "en": [
      "Producer of ewe's milk cheeses, ewe's milk yoghurts, dessert creams and ice creams: vanilla, chocolate, white chocolate, praline, caramel, coffee, chestnut, raspberry, blackcurrant and lemon.\r\nAll made with organic ewe's milk!"
    ],
    "it": [
      "Produttore di formaggi di latte di pecora, yogurt di latte di pecora, creme da dessert e gelati: vaniglia, cioccolato, cioccolato bianco, pralina, caramello, caffè, castagna, lampone, ribes nero e limone.\r\nTutti prodotti con latte di pecora biologico!"
    ],
    "fr": [
      "Producteur de Fromages  de brebis., yaourts de brebis, crème dessert ,glace au lait de brebis : vanille, chocolat, chocolat blanc, praliné, caramel, café, châtaigne, framboise, cassis , citronle.\r\nLe tout au lait de brebis et en agriculture Bio !"
    ],
    "es": [
      "Productor de quesos de leche de oveja, yogures de leche de oveja, cremas de postre y helados: vainilla, chocolate, chocolate blanco, praliné, caramelo, café, castaña, frambuesa, grosella negra y limón.\r\nTodos ellos elaborados con leche de oveja ecológica"
    ],
    "nl": [
      "Producent van schapenmelkkazen, schapenmelkyoghurts, dessertcrèmes en ijsjes: vanille, chocolade, witte chocolade, praliné, karamel, koffie, kastanje, framboos, zwarte bes en citroen.\r\nAllemaal gemaakt van biologische schapenmelk!"
    ]
  },
