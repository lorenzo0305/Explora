  "rdfs:comment": {
    "de": [
      "Herstellung von Holzgegenständen mit der Laubsäge: Ohrringe, Schneidebretter, Zierbäume, Bilder, Topfuntersetzer... Bestellmöglichkeit."
    ],
    "en": [
      "Making wooden objects with a scroll saw: earrings, cutting boards, decorative Christmas trees, pictures, trivets, etc. Orders can be placed."
    ],
    "it": [
      "Realizzare oggetti in legno con la sega da traforo: orecchini, taglieri, alberi di Natale decorativi, quadri, sottopentole, ecc. È possibile effettuare ordini."
    ],
    "fr": [
      "Fabrication d'objets en bois à la scie à chantourner : boucles d'oreilles, planches à découper, sapins décoratifs, tableaux, dessous de plats... Possibilité de commander."
    ],
    "nl": [
      "Houten objecten maken met de figuurzaag: oorbellen, snijplanken, decoratieve kerstbomen, foto's, onderzetters, enz. Bestellingen kunnen worden geplaatst."
    ],
    "es": [
      "Fabricación de objetos de madera con sierra de marquetería: pendientes, tablas de cortar, árboles de Navidad decorativos, cuadros, trébedes, etc. Se pueden hacer pedidos."
    ]
