  "rdfs:comment": {
    "de": [
      "Das Hotel hat eine ideale Lage 8 km von Vienne entfernt am Schnittpunkt großer Verkehrsachsen. Es ist 24 Stunden täglich für Ihre Eskapaden oder Geschäftsreisen geöffnet."
    ],
    "en": [
      "The hotel is ideally located near the intersection of the main motorways, 8 km from Vienne. It is open 24 hours a day and 7 days a week for a quick break or a business trip."
    ],
    "it": [
      "Questo hotel, situato in posizione ideale all'incrocio delle strade principali, a 8 km da Vienna, vi accoglie 24 ore su 24, 7 giorni su 7, per i vostri viaggi d'affari o le vostre fughe."
    ],
    "fr": [
      "Cet hôtel, idéalement situé au carrefour des grands axes routiers à 8 km de Vienne, vous accueille 24h/24, 7j/7 pour vos escapades ou déplacements professionnels."
    ],
    "es": [
      "Este hotel, idealmente situado en el cruce de las principales carreteras, a 8 km de Viena, le da la bienvenida las 24 horas del día para sus viajes de negocios o escapadas."
    ],
    "nl": [
      "Dit hotel, ideaal gelegen op het kruispunt van de belangrijkste wegen, op 8 km van Wenen, verwelkomt u 24/7 voor uw zakenreizen of uitstapjes."
    ]
  },
