  "rdfs:comment": {
    "de": [
      "Das Four Seasons Resort Megève ist das einzige Hotel an den Hängen des Mont d'Arbois mit direktem Zugang zu den Pisten. Es bietet außergewöhnliche Leistungen in einem schicken und zeitgenössischen Stil im Herzen der französischen Alpen."
    ],
    "en": [
      "Four Seasons Resort Megève, the only proprety of Mont d'Arbois with direct access to the slopes. It offers exceptional services in a chic and contemporary style in the heart of the French Alps."
    ],
    "it": [
      "Four Seasons Resort Megève, l'unico hotel sulle piste del Mont d'Arbois con accesso diretto alle piste. Offre strutture eccezionali in uno stile chic e contemporaneo nel cuore delle Alpi francesi."
    ],
    "fr": [
      "Four Seasons Resort Megève, seul établissement sur les versants du Mont d'Arbois permettant un accès direct aux pistes. Il offre des prestations exceptionnelles dans un style chic et contemporain au cœur des Alpes françaises."
    ],
    "nl": [
      "Four Seasons Resort Megève is het enige hotel op de hellingen van Mont d'Arbois met directe toegang tot de pistes. Het biedt uitzonderlijke faciliteiten in een chique, eigentijdse stijl in het hart van de Franse Alpen."
    ],
    "es": [
      "Four Seasons Resort Megève es el único hotel en las laderas del Mont d'Arbois con acceso directo a las pistas. Ofrece unas instalaciones excepcionales en un estilo chic y contemporáneo en el corazón de los Alpes franceses."
    ]
  },
