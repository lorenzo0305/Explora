  "rdfs:comment": {
    "de": [
      "Ein Tal, eine Kuh, ein Käse... ein Haus, das es zu entdecken gilt. Entdecken Sie bei einem spielerischen, wissenschaftlichen und sensorischen Besuch alle Eigenschaften dieses Käses mit geschützter Ursprungsbezeichnung."
    ],
    "en": [
      "A valley, a cow, a cheese... a house to discover. Discover all the characteristics of this Protected Designation of Origin cheese on a fun, scientific and sensory tour."
    ],
    "it": [
      "Una valle, una mucca, un formaggio... una casa da scoprire. Scoprite tutte le caratteristiche di questo formaggio a Denominazione di Origine Protetta in un tour divertente, scientifico e sensoriale."
    ],
    "fr": [
      "Une vallée, une vache, un fromage... une maison à découvrir. Découvrez toutes les caractéristiques de ce fromage Appellation d'Origine Protégée au cours d'une visite ludique, scientifique et sensorielle."
    ],
    "es": [
      "Un valle, una vaca, un queso... una casa por descubrir. Descubra todas las características de este queso con Denominación de Origen Protegida en un recorrido lúdico, científico y sensorial."
    ],
    "nl": [
      "Een vallei, een koe, een kaas... een huis om te ontdekken. Ontdek alle kenmerken van deze kaas met beschermde oorsprongsbenaming tijdens een leuke, wetenschappelijke en zintuiglijke rondleiding."
    ]
  },
