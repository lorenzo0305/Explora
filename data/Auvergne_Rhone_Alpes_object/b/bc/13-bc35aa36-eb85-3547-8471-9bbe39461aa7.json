  "rdfs:comment": {
    "de": [
      "Das Besucherzentrum des ehemaligen Klosters Sainte-Croix bietet lokale Produkte zum Verkauf an: Clairette de Die, Produkte auf Pflanzenbasis (ätherische Öle, Kräutertees, Sorbets...), Pasteten, Terrine, Honig, usw..."
    ],
    "en": [
      "At the Centre d'Accueil de l'Ancien Monastère boutique you will find a range of local produce from Clairette de Die sparkling wine, plant based products such as essential oils, herbal teas, sorbet to pâtés & terrines, honey etc..."
    ],
    "it": [
      "Il Centre d'Accueil de l'Ancien Monastère de Sainte-Croix vende prodotti locali: Clairette de Die, prodotti erboristici (oli essenziali, tisane, sorbetti, ecc.), paté, terrine, miele, ecc..."
    ],
    "fr": [
      "Le Centre d'Accueil de l'Ancien Monastère de Sainte-Croix propose à la vente des produits du terroir local : Clairette de Die, produits à base de plantes (huiles essentielles, tisanes, sorbets..), pâtés, terrine, miel, etc..."
    ],
    "nl": [
      "Het Ontvangstcentrum van het Oude Klooster Sainte-Croix verkoopt streekspecialiteiten uit de omgeving: Clairette de Die, producten op basis van planten (etherische oliën, kruidenthees, sorbets...), patés, terrines, honing, …"
    ],
    "es": [
      "El Centre d'Accueil de l'Ancien Monastère de Sainte-Croix vende productos locales: Clairette de Die, productos de herboristería (aceites esenciales, tisanas, sorbetes, etc.), patés, terrinas, miel, etc..."
    ]
  },
