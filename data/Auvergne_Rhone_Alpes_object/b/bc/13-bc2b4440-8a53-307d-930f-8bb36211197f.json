  "rdfs:comment": {
    "de": [
      "Vermietung, Ausflüge mit dem Mobylette. Entdecken Sie die kurvenreichen Straßen des Beaujolais des Pierres Dorées auf einem unserer alten Zweiräder. Flanieren Sie mit geringer Geschwindigkeit und nehmen Sie sich die Zeit, diese schöne Region zu entdecken. Erleben Sie Ihre 15 Jahre zurück!"
    ],
    "en": [
      "Rent, ride in Mobylette and vintage Vespa. Discover the winding roads of Beaujolais des Pierres Dorées on one of our old 2 wheels. Strolling at a low speed, take the time to discover this beautiful region. Get your 15th birthday back!"
    ],
    "it": [
      "Noleggio e giri in Mobylette. Scoprite le strade tortuose della regione del Beaujolais di Pierres Dorées su una delle nostre 2 ruote d'epoca. Passeggiate a bassa velocità, prendetevi il tempo per scoprire questa splendida regione. 15 anni di nuovo!"
    ],
    "fr": [
      "Location, balade en Mobylette. Découvrez les routes sinueuses du Beaujolais des Pierres Dorées au guidon d'un de nos 2 roues anciens. Flâner à petite vitesse, prenez le temps de découvrir celle  belle région. Retrouvez vos 15 ans!"
    ],
    "nl": [
      "Mobylette verhuur en ritten. Ontdek de kronkelende wegen van de Pierres Dorées Beaujolais streek op een van onze vintage 2-wielers. Wandel op lage snelheid en neem de tijd om deze prachtige streek te ontdekken. Weer 15 jaar oud!"
    ],
    "es": [
      "Alquiler y paseos en Mobylette. Descubra las sinuosas carreteras de la región de Pierres Dorées Beaujolais en una de nuestras 2 ruedas de época. Pasee a baja velocidad y tómese su tiempo para descubrir esta hermosa región. ¡15 años de nuevo!"
    ]
  },
  "rdfs:label": {
