  "rdfs:comment": {
    "de": [
      "Übernommen von Olivier Canal und Franck Delhoum, fördert dieses Bouchon Lyonnais die großen Klassiker der Lyoner Küche! Auf der Tagesordnung: Qualität und Großzügigkeit."
    ],
    "en": [
      "This traditional 'bouchon' restaurant of Lyon has been taken over by Olivier Canal and Franck Delhoum and mainly serves the great classics of the Lyon area! You can expect top-quality and hearty dishes."
    ],
    "it": [
      "Rilevato da Olivier Canal e Franck Delhoum, questo bouchon lionese dedica il posto d'onore ai grandi classici della cucina lionese! In programma: qualità e generosità."
    ],
    "fr": [
      "Repris par Olivier Canal et Franck Delhoum, ce bouchon lyonnais donne la part belle aux grands classiques de la cuisine lyonnaise ! Au menu : qualité et générosité."
    ],
    "es": [
      "Retomado por Olivier Canal y Franck Delhoum, este bouchon lionés da protagonismo a los grandes clásicos de la cocina lionesa.  En el menú reinan la calidad y la generosidad."
    ],
    "nl": [
      "Olivier Canal en Franck Delhoum hebben deze bouchon uit Lyonnais overgenomen. De grote klassiekers uit de Lyonnaise keuken staan hier centraal! Op het menu: kwaliteit en vrijgevigheid."
    ]
  },
