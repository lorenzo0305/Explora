  "rdfs:comment": {
    "de": [
      "Ein herzlicher Empfang, ein Essen, das auf frischen Produkten aus der Region basiert, die auf den neuesten Stand gebracht wurden, und ein reichhaltiger und abwechslungsreicher Weinkeller aus den französischen Regionen. Spezialitäten: Bresse-Geflügel, frische Frösche."
    ],
    "en": [
      "A warm welcome, a meal based on fresh local produce brought up to date, a rich and varied wine cellar from the French regions. Specialities: Bresse poultry, fresh frogs."
    ],
    "it": [
      "Un'accoglienza calorosa, un pasto a base di prodotti locali freschi e aggiornati, una cantina ricca e variegata delle regioni francesi. Specialità: pollame della Bresse, rane fresche."
    ],
    "fr": [
      "Un accueil chaleureux, un repas basé sur les produits frais du terroir remis au goût du jour, une cave riche et variée provenant des régions françaises. Spécialités: volailles de Bresse, Grenouilles fraîches."
    ],
    "es": [
      "Una cálida acogida, una comida basada en productos locales frescos y actualizados, una bodega rica y variada de las regiones francesas. Especialidades: Aves de corral de Bresse, ranas frescas."
    ],
    "nl": [
      "Een warm onthaal, een maaltijd op basis van verse streekproducten die up-to-date zijn, en een rijke en gevarieerde wijnkelder uit heel Frankrijk. Specialiteiten: gevogelte uit Bresse, verse kikkers."
    ]
  },
  "rdfs:label": {
    "de": [
      "Le Raisin"
