  "rdfs:comment": {
    "de": [
      "Nicolas Scauri alias SKIO schuf dieses Wandgemälde im Jahr 2023. SKIO ist ein urbaner Künstler, der 1980 in Nizza geboren wurde. Mit 15 Jahren begann er, mit Spraydosen aus seinem Keller auf die Wände seiner Stadt zu zeichnen, ohne zu wissen, dass dies verboten ist."
    ],
    "en": [
      "Nicolas Scauri alias SKIO created this fresco in 2023. SKIO is an urban artist born in Nice in 1980. At the age of 15, he began drawing on the walls of his city with sprays found in his cellar, unaware that it was forbidden."
    ],
    "it": [
      "Nicolas Scauri, in arte SKIO, ha realizzato questo affresco nel 2023. SKIO è un artista urbano nato a Nizza nel 1980. Dall'età di 15 anni ha iniziato a disegnare sui muri della sua città utilizzando spray trovati nella sua cantina, senza sapere che era vietato."
    ],
    "fr": [
      "Nicolas Scauri alias SKIO crée cette fresque en 2023. SKIO est un artiste urbain, né à Nice en 1980. Dès 15 ans, il commence à dessiner sur les murs de sa ville avec des sprays trouvés dans sa cave, sans savoir que c’est interdit."
    ],
    "es": [
      "Nicolas Scauri, alias SKIO, creó este fresco en 2023. SKIO es un artista urbano nacido en Niza en 1980. Desde los 15 años, empezó a dibujar en las paredes de su ciudad utilizando aerosoles que encontraba en su sótano, sin saber que estaba prohibido."
    ],
    "nl": [
      "Nicolas Scauri alias SKIO maakte dit fresco in 2023. SKIO is een stadskunstenaar die in 1980 in Nice werd geboren. Vanaf zijn 15e begon hij op de muren van zijn stad te tekenen met spuitbussen uit zijn kelder, zonder te weten dat het verboden was."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fresques et murs peints - La Gracieuse géométrie de Skio"
    ]
  },
