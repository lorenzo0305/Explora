  "rdfs:comment": {
    "de": [
      "Im Dorf Moneaux gelegen, regionale Gerichte auf Bestellung: Trüffel, Eintopf, gefüllter Kohl, Coq au Vin, Fleisch aus Salers. Tagesmenü (mittags) unter der Woche. Mahlzeiten zum Mitnehmen auf Bestellung."
    ],
    "en": [
      "Regional dishes to order: truffade, potée, stuffed cabbage, coq au vin. Menu of the day (lunch) during the week. Takeaway meals on order."
    ],
    "it": [
      "Situato nel villaggio di Moneaux, piatti regionali su ordinazione: truffade, potée, cavolo ripieno, coq au vin, carne di Salers. Menu del giorno (a pranzo) durante la settimana. Pasti da asporto su ordinazione."
    ],
    "fr": [
      "Située dans le village de Moneaux, plats régionaux sur commande : truffade, potée, chou farci, coq au vin, viande de Salers. Menu du jour (midi) en semaine. Repas à emporter sur commande."
    ],
    "es": [
      "Situado en el pueblo de Moneaux, platos regionales por encargo: truffade, potée, col rellena, coq au vin, carne de Salers. Menú del día (mediodía) entre semana. Comidas para llevar por encargo."
    ],
    "nl": [
      "Gelegen in het dorp Moneaux, streekgerechten op bestelling: truffade, potée, gevulde kool, coq au vin, vlees uit Salers. Dagmenu (lunchtijd) tijdens de week. Afhaalmaaltijden op bestelling."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Auberge de Moneaux"
    ]
  },
