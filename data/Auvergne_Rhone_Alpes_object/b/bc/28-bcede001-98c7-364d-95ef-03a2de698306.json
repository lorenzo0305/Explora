  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b2e6fff5-d52b-3761-800d-64711840d237",
      "dc:description": {
        "de": [
          "Ein 4 Hektar großer englischer Park umgibt das Schloss, ein Steinbau aus dem 18. Jahrhundert, ISMH. Auf einer Seite wurde ein französischer Garten angelegt: Teich, Gemüsegarten, japanischer Garten."
        ],
        "en": [
          "An English style park of 4 hectares surrounds the castle, an 18th century stone building, ISMH. A French garden has been laid out on one side: pond, vegetable garden, Japanese garden."
        ],
        "it": [
          "Un parco all'inglese di 4 ettari circonda il castello, una costruzione in pietra del XVIII secolo, ISMH. Su un lato è stato allestito un giardino alla francese: laghetto, orto, giardino giapponese."
        ],
        "fr": [
          "Un parc à l'anglaise de 4 hectares entoure le château, construction du XVIIIe siècle en pierre, ISMH. Un jardin à la française a été aménagé sur l'un des côtés : bassin, potager, jardin japonais."
        ],
        "es": [
          "Un parque inglés de 4 hectáreas rodea el castillo, una construcción de piedra del siglo XVIII, ISMH. En un lado se ha dispuesto un jardín francés: estanque, huerto, jardín japonés."
        ],
        "nl": [
          "Een Engels park van 4 hectare omringt het kasteel, een stenen constructie uit de 18e eeuw, ISMH. Aan de ene kant is een Franse tuin aangelegd: vijver, moestuin, Japanse tuin."
        ]
      },
