    ],
    "en": [
      "To discover: An English park, small French-style gardens and natural areas: woods, small orchard, meadows."
    ],
    "it": [
      "Da scoprire: Un parco all'inglese, piccoli giardini alla francese e aree naturali: boschi, piccoli frutteti, prati."
    ],
    "fr": [
      "A découvrir : Un parc à l'anglaise, des petits jardins \" à la française \" et des espaces naturels : bois, petit verger, prairies."
    ],
