  "rdfs:comment": {
    "de": [
      "Els und ihr Team empfangen Sie jeden Tag in einer herzlichen Atmosphäre.\r\nBar und kleine Restaurants im Herzen des ehemaligen Lebensmittelladens des Dorfes."
    ],
    "en": [
      "Els and her team welcome you every day in a warm and friendly atmosphere.\r\nBar and snack bar in the heart of the old village grocery store."
    ],
    "it": [
      "Els e il suo team vi accolgono ogni giorno in un'atmosfera calda e amichevole.\r\nBar e snack bar nel cuore del vecchio villaggio, negozio di alimentari."
    ],
    "fr": [
      "Els et son équipe vous accueillent tous les jours dans une ambiance chaleureuse.\r\nBar et petite restauration au cœur de l'ancienne épicerie du village."
    ],
    "es": [
      "Els y su equipo le dan la bienvenida cada día en un ambiente cálido y acogedor.\r\nBar y snack bar en el corazón de la antigua tienda de comestibles del pueblo."
    ],
    "nl": [
      "Els en haar team verwelkomen je elke dag in een warme en vriendelijke sfeer.\r\nBar en snackbar in het hart van het oude dorp kruidenierswinkel."
    ]
  },
