  "rdfs:comment": {
    "de": [
      "Dieses Gewässer mit einer Fläche von 2,5 Hektar ist ausschließlich dem Angeln gewidmet\r\nEr ist für Personen mit eingeschränkter Mobilität zugänglich\r\nEin Fußweg führt um ihn herum."
    ],
    "en": [
      "This 2.5-hectare lake is devoted exclusively to fishing.\r\nIt is accessible to people with reduced mobility.\r\nA footpath leads around it."
    ],
    "it": [
      "Questo lago di 2,5 ettari è dedicato esclusivamente alla pesca\r\nÈ accessibile alle persone con mobilità ridotta\r\nUn percorso pedonale lo circonda."
    ],
    "fr": [
      "Ce plan d’eau, d’une superficie de 2,5 hectares est consacré uniquement à la pêche. \r\nIl est accessible aux personnes à mobilité réduite \r\nUn cheminement piétonnier en fait le tour."
    ],
    "es": [
      "Este lago de 2,5 hectáreas está dedicado exclusivamente a la pesca\r\nEs accesible para personas con movilidad reducida\r\nUn camino peatonal lo rodea."
    ],
    "nl": [
      "Dit meer van 2,5 hectare is uitsluitend bestemd voor de visserij\r\nHet is toegankelijk voor mensen met beperkte mobiliteit\r\nEr loopt een voetgangerspad omheen."
    ]
  },
