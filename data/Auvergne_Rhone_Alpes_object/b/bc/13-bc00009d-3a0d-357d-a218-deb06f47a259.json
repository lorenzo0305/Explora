  "rdfs:comment": {
    "de": [
      "Touristischer Rundgang durch die mittelalterliche Stadt Saint-Flour. Dauer ca. 1 Stunde, um die wichtigsten Gebäude und Denkmäler der Stadt zu entdecken.\r\nFührungen für Gruppen das ganze Jahr über."
    ],
    "en": [
      "Sightseeing tour of the medieval town of Saint-Flour. Approx. 1 hour to discover the town's main buildings and monuments.\r\nGuided tours all year round for groups."
    ],
    "it": [
      "Visita della città medievale di Saint-Flour. Circa 1 ora per scoprire i principali edifici e monumenti della città.\r\nVisite guidate tutto l'anno per gruppi."
    ],
    "fr": [
      "Circuit touristique de la cité médiévale de Saint-Flour. Durée 1h environ à la découverte des principaux bâtiments et monuments de la ville. \r\nVisite guidée toute l'année pour les groupes."
    ],
    "es": [
      "Visita de la ciudad medieval de Saint-Flour. Aproximadamente 1 hora para descubrir los principales edificios y monumentos de la ciudad.\r\nVisitas guiadas todo el año para grupos."
    ],
    "nl": [
      "Sightseeing tour door de middeleeuwse stad Saint-Flour. Ongeveer 1 uur om de belangrijkste gebouwen en monumenten van de stad te ontdekken.\r\nHet hele jaar door rondleidingen voor groepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit la cité historique de Saint-Flour"
    ]
  },
