  "rdfs:comment": {
    "de": [
      "Das Restaurant des Hotels bietet eine kreative, regionale und französische Küche. Der Küchenchef achtet auf die Qualität der Rohstoffe aus dem hoteleigenen Bio-Garten und ändert die Speisekarte mindestens alle zwei Wochen je nach Saison."
    ],
    "en": [
      "The hotel restaurant features creative, regional French cuisine. Careful attention is paid to the quality of the raw materials harvested from the hotel?s own organic vegetable garden, and the chef changes the menu at least once a fortnight, according to the season."
    ],
    "it": [
      "Il ristorante dell'hotel offre una cucina francese creativa e regionale. Si presta molta attenzione alla qualità degli ingredienti raccolti dall'orto biologico dell'hotel e lo chef cambia il menu almeno una volta ogni due settimane, a seconda della stagione."
    ],
    "fr": [
      "Le restaurant de l’hôtel met en valeur une cuisine française, créative et régionale. Soucieux de la qualité des matières premières récoltées au sein même du potager bio de l’hôtel, le chef fait évoluer la carte au minimum tous les quinze jours et selon les saisons."
    ],
    "nl": [
      "Het restaurant van het hotel serveert creatieve, regionale Franse gerechten. Er wordt zorgvuldig aandacht besteed aan de kwaliteit van de ingrediënten uit de biologische moestuin van het hotel en de chef-kok verandert het menu minstens eens per twee weken, afhankelijk van het seizoen."
    ],
    "es": [
      "El restaurante del hotel ofrece cocina francesa creativa y regional. Se presta especial atención a la calidad de los ingredientes cosechados en el huerto ecológico del hotel, y el chef cambia el menú al menos una vez cada quince días, según la temporada."
    ]
  },
