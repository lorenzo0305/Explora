  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05b4ef35-04f7-3951-b87b-d5e994aa468e",
      "dc:description": {
        "de": [
          "Gemeindesaal in Wirwignes\n\nGenießen Sie einen warmen und festlichen Moment\n\nKostenloser Eintritt\n\nWir erwarten Sie zahlreich, um den Zauber von Weihnachten zu teilen!"
        ],
        "en": [
          "Wirwignes village hall\n\nCome and enjoy a warm and festive moment\n\nFree admission\n\nWe look forward to seeing you there to share in the magic of Christmas!"
        ],
        "it": [
          "Sala del villaggio di Wirwignes\n\nVenite a godervi un momento di calore e di festa\n\nIngresso libero\n\nVi aspettiamo per condividere la magia del Natale!"
        ],
        "fr": [
          "Salle communale de Wirwignes\n\nVenez profiter d’un moment chaleureux et festif  \n\nEntrée gratuite\n\nNous vous attendons nombreux pour partager la magie de Noël !"
        ],
        "nl": [
          "Dorpshuis Wirwignes\n\nKom genieten van een warm en feestelijk moment\n\nGratis toegang\n\nWe kijken ernaar uit om je daar te zien om te delen in de magie van Kerstmis!"
        ],
        "es": [
          "Ayuntamiento de Wirwignes\n\nVen a disfrutar de un momento cálido y festivo\n\nEntrada gratuita\n\n¡Esperamos verle allí para compartir la magia de la Navidad!"
        ]
      },
