  "rdfs:comment": {
    "de": [
      "Familienfreundliches und geselliges Reitzentrum. Equit'Astrée liegt nur 500 Meter La Bâtie d'Urfé entfernt und ist ein Reitzentrum mit dem Gütesiegel \"Ecole Française d'Equitation\". Ab 4 Jahren."
    ],
    "en": [
      "Riding stables with a friendly family atmosphere. Located 500 metres from La Bâtie d’Urfé, the Equit’Astrée riding stables, accredited by the French Equestrian School, proposes lessons for all from the age of 4 years."
    ],
    "it": [
      "Situato a 500 metri da La Bâtie d'Urfé, Equit'Astrée è un accogliente centro di equitazione a conduzione familiare con accreditamento Ecole Française d'Equitation, aperto a tutti."
    ],
    "fr": [
      "Situé à 500 mètres de la Bâtie d'Urfé, Equit'Astrée est un centre équestre familial et convivial labellisé Ecole Française d'Equitation qui accueille tout public."
    ],
    "es": [
      "Situado a 500 metros de La Bâtie d'Urfé, Equit'Astrée es un centro de equitación familiar y acogedor, abierto a todos y acreditado por la Ecole Française d'Equitation."
    ],
    "nl": [
      "Equit'Astrée ligt op 500 meter van La Bâtie d'Urfé en is een vriendelijke, door een familie gerunde manege met een Ecole Française d'Equitation-erkenning die voor iedereen toegankelijk is."
    ]
  },
