  "rdfs:comment": {
    "de": [
      "Sportliche Mountainbike-Runde mit Start in Le Bettex durch die Gemeinden Saint-Gervais, Megève, Demi-Quartier und Combloux. Eine schwarze Route für geübte Mountainbiker, auf der sich steile Anstiege, anspruchsvolle Abfahrten und herrliche Alpenpanoramen abwechseln."
    ],
    "en": [
      "Sporty VTTAE loop starting from Le Bettex, crossing the communes of Saint-Gervais, Megève, Demi-Quartier and Combloux. A black route reserved for experienced mountain bikers, alternating steep climbs, challenging descents and superb Alpine panoramas."
    ],
    "it": [
      "Un anello sportivo per MTB che parte da Le Bettex e attraversa i comuni di Saint-Gervais, Megève, Demi-Quartier e Combloux. Un percorso nero riservato a mountain biker esperti, che alterna salite ripide, discese impegnative e superbi panorami alpini."
    ],
    "fr": [
      "Boucle sportive en VTTAE au départ du Bettex, traversant les communes de Saint-Gervais, Megève, Demi-Quartier et Combloux. Un itinéraire noir réservé aux vététistes aguerris, alternant montées soutenues, descentes engagées et superbes panoramas alpins."
    ],
    "es": [
      "Un bucle deportivo en BTT que parte de Le Bettex y atraviesa los municipios de Saint-Gervais, Megève, Demi-Quartier y Combloux. Una ruta negra reservada a ciclistas de montaña experimentados, que alterna subidas empinadas, descensos desafiantes y magníficos panoramas alpinos."
    ],
    "nl": [
      "Een sportieve MTB-lus die vertrekt in Le Bettex en door de gemeenten Saint-Gervais, Megève, Demi-Quartier en Combloux loopt. Een zwarte route gereserveerd voor ervaren mountainbikers, met afwisselend steile beklimmingen, uitdagende afdalingen en prachtige Alpenpanorama's."
    ]
  },
