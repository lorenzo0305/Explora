  "rdfs:comment": {
    "de": [
      "Guinguette auf dem Gelände des städtischen Campingplatzes von Charmes sur Rhône.\r\nGuinguette für Freiluftgastronomie.\r\nVerpflegung vor Ort mittags und abends. Offen für Personen außerhalb des Campingplatzes."
    ],
    "en": [
      "Guinguette on the grounds of the Charmes sur Rhône municipal campsite.\r\nGuinguette for open-air catering.\r\nCatering on site for lunch and dinner. Open to guests from outside the campsite."
    ],
    "it": [
      "Guinguette nel campeggio comunale di Charmes sur Rhône.\r\nGuinguette per la ristorazione all'aperto.\r\nRistorazione in loco per pranzo e cena. Aperta a persone esterne al campeggio."
    ],
    "fr": [
      "Guinguette sur le terrain du camping municipal de Charmes sur Rhône.\r\nGuinguette pour restauration de plein-air.\r\nRestauration sur place midi et soir. Ouvert aux personnes extérieures au camping."
    ],
    "nl": [
      "Guinguette op de gemeentelijke camping in Charmes sur Rhône.\r\nGuinguette voor catering in de open lucht.\r\nCatering ter plaatse voor lunch en diner. Open voor mensen van buiten de camping."
    ],
    "es": [
      "Guinguette en el camping municipal de Charmes sur Rhône.\r\nGuinguette para catering al aire libre.\r\nCatering in situ para almuerzos y cenas. Abierto a personas ajenas al camping."
    ]
  },
  "rdfs:label": {
