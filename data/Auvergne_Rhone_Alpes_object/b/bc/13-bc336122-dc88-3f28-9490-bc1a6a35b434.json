  "rdfs:comment": {
    "de": [
      "Die Burg Ravel geht auf das Jahr 1147 zurück und ihr erster Bewohner war Pierre de Ravel. Es wurde unter Philipp III. dem Kühnen und Philipp dem Schönen zum königlichen Besitz."
    ],
    "en": [
      "This impressive middle-age fortress with its dungeon and its towers, was embel- lished at the end of the 18th century by admiral d’Estaing and whose naval memorabilia you can admire."
    ],
    "it": [
      "Il castello di Ravel risale al 1147 e il suo primo occupante fu Pierre de Ravel. Divenne proprietà reale sotto Filippo III l'Ardito e Filippo il Bello."
    ],
    "fr": [
      "Le château de Ravel remonte à 1147 et son premier occupant fut Pierre de Ravel. Il devint propriété royale sous Philippe III le hardi et Philippe Le Bel."
    ],
    "nl": [
      "Het kasteel van Ravel dateert uit 1147 en de eerste bewoner was Pierre de Ravel. Het werd koninklijk bezit onder Filips III de Stoute en Filips de Schone."
    ],
    "es": [
      "El castillo de Ravel data de 1147 y su primer ocupante fue Pierre de Ravel. Se convirtió en propiedad real bajo Felipe III el Temerario y Felipe el Hermoso."
    ]
  },
