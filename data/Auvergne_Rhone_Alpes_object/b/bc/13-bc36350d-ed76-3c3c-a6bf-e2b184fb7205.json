  "rdfs:comment": {
    "de": [
      "1781 gegründet, erlangte Vidal-Fleury sehr schnell internationale Anerkennung. Der Besuch Thomas Jeffersons im Jahr 1787 war sein erster Kontakt mit den Vereinigten Staaten. In den 1890ern heiratete Gustave VIDAL eine Demoiselle FLEURY."
    ],
    "en": [
      "Founded in 1781, Vidal-Fleury gained an international reputation very quickly. Thomas Jefferson's visit in 1787 was its first contact with the United States."
    ],
    "it": [
      "Fondato nel 1781, il Domaine Vidal-Fleury è la più antica cantina della Valle del Rodano settentrionale ancora in attività. Scoprite la sua storia e osservate come vengono prodotti i suoi prestigiosi vini!"
    ],
    "fr": [
      "Fondée en 1781, le domaine Vidal-Fleury est aujourd'hui la plus ancienne maison de la vallée du Rhône nord encore en activité. Découvrez son histoire et observez le processus de fabrication de Ses vins prestigieux !"
    ],
    "es": [
      "Fundada en 1781, Domaine Vidal-Fleury es la bodega más antigua del Valle del Ródano Norte que sigue en activo. Descubra su historia y vea cómo se elaboran sus prestigiosos vinos"
    ],
    "nl": [
      "Domaine Vidal-Fleury werd opgericht in 1781 en is het oudste wijnhuis in de Noordelijke Rhônevallei dat nog steeds actief is. Ontdek zijn geschiedenis en zie hoe zijn prestigieuze wijnen worden gemaakt!"
    ]
  },
