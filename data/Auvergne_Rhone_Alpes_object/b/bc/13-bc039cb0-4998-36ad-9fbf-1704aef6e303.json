  "rdfs:comment": {
    "de": [
      "Auf dieser Strecke können Sie die Ebene von Forez mit ihren zahlreichen Teichen für die Fischzucht sowie die Trabergestüte und ihre Trainingsstrecken entdecken. Auf dem Rückweg bietet er schöne Aussichtspunkte auf die Monts du Forez."
    ],
    "en": [
      "This tour takes in the Forez plain, with its numerous ponds used for fish farming, as well as its trotting stud farms and training tracks. On the way back, it offers fine views of the Monts du Forez."
    ],
    "it": [
      "Il percorso si snoda nella piana del Forez, con i suoi numerosi stagni per l'allevamento di pesci, le scuderie per il trotto e le piste di allenamento. Al ritorno, si gode di una bella vista sui Monts du Forez."
    ],
    "fr": [
      "Ce circuit permet de découvrir la plaine du Forez avec ses nombreux étangs destinés à l'élevage piscicole, ainsi que ses haras de trotteurs et leurs pistes d'entraînement. Au retour il offre de beaux points de vue sur les Monts du Forez."
    ],
    "es": [
      "Este itinerario recorre la llanura de Forez, con sus numerosos estanques piscícolas, sementales de trote y pistas de entrenamiento. En el trayecto de vuelta, las vistas de los Montes del Forez son magníficas."
    ],
    "nl": [
      "Deze route voert langs de vlakte van de Forez, met zijn vele viskwekerijvijvers, drafbanen en trainingspistes. Op de terugweg zijn er mooie uitzichten op de Monts du Forez."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Des Haras aux Etangs - Circuit Gravel (petit parcours)"
    ]
  },
