  "rdfs:comment": {
    "de": [
      "Im Genin-See kannst du mit etwas Glück Hechte, Karpfen, Barsche, Schleien, Plötzen und Forellen fangen Das Angeln im See ist vom 3. Samstag im April bis Anfang November möglich."
    ],
    "en": [
      "at the end of your line you ,ay be lucky enough to land a pike, carp, perch, tench, roach or trout. the lake's fishing season starts on the 3rd Saturday of April and goes on to early November."
    ],
    "it": [
      "Al lago Genin potrete avere la fortuna di catturare lucci, carpe, persici, tinche, lasche, trote? La pesca al lago si svolge dal terzo sabato di aprile all'inizio di novembre."
    ],
    "fr": [
      "Au lac Genin, vous aurez peut-être la chance de remonter brochets, carpes, perches, tanches, gardons, truites… La pêche se pratique au lac du 3ème samedi d'avril à début novembre."
    ],
    "es": [
      "En el lago Genin, puede tener la suerte de pescar lucios, carpas, percas, tencas, cucarachas, truchas.. Se puede pescar en el lago desde el tercer sábado de abril hasta principios de noviembre."
    ],
    "nl": [
      "Bij het Genin-meer kun je het geluk hebben om snoek, karper, baars, zeelt, voorn, forel te vangen? Op het meer wordt gevist van de 3e zaterdag in april tot begin november."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêcher au  lac Genin"
    ]
  },
