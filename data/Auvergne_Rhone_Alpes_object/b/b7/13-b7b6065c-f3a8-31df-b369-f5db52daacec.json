  "rdfs:comment": {
    "de": [
      "LABELISÉE FAMILLE PLUS / Auf 1450 m Höhe gelegen Christelle und Jean-Marc empfangen Sie in einer außergewöhnlichen Umgebung mit den Bergen im Hintergrund. Unser Restaurant, das mit dem Titel Maître Restaurateur ausgezeichnet wurde, bietet eine Feinschmeckerküche."
    ],
    "en": [
      "Located at 1450m Christelle and Jean Marc welcome you in an exceptional setting with the mountain as a backdrop. Our restaurant, awarded the Title of \"Maître Restaurateur\", offers gourmet cuisine."
    ],
    "it": [
      "LABELLISÉE FAMILLE PLUS / A 1450 metri di altitudine, Christelle e Jean-Marc vi accolgono in un ambiente eccezionale con le montagne come sfondo. Il nostro ristorante, insignito del titolo di Maître Restaurateur, offre una cucina gourmet."
    ],
    "fr": [
      "LABELLISÉE FAMILLE PLUS / Situés à 1450 m Christelle et Jean-Marc vous accueillent dans un cadre exceptionnel avec la montagne en toile de fond. Notre restaurant, récompensé du Titre de Maître Restaurateur, propose une cuisine gourmande."
    ],
    "es": [
      "LABELLISÉE FAMILLE PLUS / Situado a 1450 m Christelle y Jean-Marc le dan la bienvenida en un marco excepcional con las montañas como telón de fondo. Nuestro restaurante, galardonado con el título de Maître Restaurateur, ofrece cocina gourmet."
    ],
    "nl": [
      "Een familierestaurant dat u verwelkomt in een rustiek en gezellig kader op het benedenstation 1450 m. Jean Marc, stelt u een verzorgde en verfijnde keuken voor met veel huisgemaakte producten."
    ]
  },
