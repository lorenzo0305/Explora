  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ea3cb78b-5057-391b-85e1-a9cd1d5841bf",
      "dc:description": {
        "de": [
          "Restaurant mit traditioneller italienischer und französischer Küche in Lesquin, wir empfangen Sie in einer freundlichen Umgebung.\nHausgemachte Küche, herzlicher Empfang, wir stehen Ihnen zu Diensten und hören Ihnen zu, um Ihre Erwartungen zu erfüllen"
        ],
        "en": [
          "Traditional Italian and French cuisine restaurant, located in Lesquin, we welcome you in a friendly atmosphere.\nHome cooking, a warm welcome, we are at your service and ready to meet your expectations"
        ],
        "it": [
          "Un ristorante di cucina tradizionale italiana e francese, situato a Lesquin, vi accoglie in un'atmosfera amichevole.\nCucina casalinga, accoglienza calorosa, siamo al vostro servizio e pronti a soddisfare le vostre aspettative"
        ],
        "fr": [
          "Restaurant de cuisine traditionnelle italienne et française, situé à Lesquin, nous vous accueillons dans un cadre convivial.\nCuisine maison, accueil chaleureux, nous sommes à votre service et à votre écoute pour satisfaire vos attentes"
        ],
        "es": [
          "Restaurante de cocina tradicional italiana y francesa, situado en Lesquin, le damos la bienvenida en un ambiente acogedor.\nCocina casera, una cálida bienvenida, estamos a su servicio y listo para satisfacer sus expectativas"
        ],
        "nl": [
          "Een restaurant met traditionele Italiaanse en Franse keuken, gelegen in Lesquin, verwelkomen wij u in een vriendelijke sfeer.\nHuiselijke keuken, een warm welkom, wij staan tot uw dienst en klaar om aan uw verwachtingen te voldoen"
        ]
      },
      "@type": [
        "Description"
      ],
