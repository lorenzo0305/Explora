  "rdfs:comment": {
    "de": [
      "Florent CELLIER, staatlich geprüfter Mountainbike-Lehrer und Leiter der Fahrradschule 100% VTT, begleitet Sie bei all Ihren Aktivitäten rund um das Mountainbike!"
    ],
    "en": [
      "Florent CELLIER is a state-qualified mountain bike instructor and manager of the 100% VTT cycling school. We'll help you with all your mountain biking needs!"
    ],
    "it": [
      "Florent CELLIER, istruttore di mountain bike qualificato dallo Stato e direttore della scuola di ciclismo 100% VTT, può aiutarvi in tutte le vostre esigenze di mountain bike!"
    ],
    "fr": [
      "Florent CELLIER moniteur VTT diplômé d'Etat et dirigeant de l'école de vélo 100% VTT vous accompagne dans toutes vos pratiques autour du vélo tout terrain!"
    ],
    "nl": [
      "Florent CELLIER is staatsgediplomeerd mountainbike-instructeur en hoofd van de 100% VTT fietsschool. Hij kan je helpen met al je mountainbikebenodigdheden!"
    ],
    "es": [
      "Florent CELLIER es monitor de bicicleta de montaña diplomado por el Estado y director de la escuela de ciclismo 100% VTT. ¡Puede ayudarte en todo lo que necesites en bicicleta de montaña!"
    ]
  },
