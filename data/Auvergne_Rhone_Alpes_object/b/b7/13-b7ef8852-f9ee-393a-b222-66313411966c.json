  "rdfs:comment": {
    "de": [
      "L'Arteppes, der Raum für zeitgenössische Kunst des MJC Centre Social Le Mikado, bietet jedes Jahr eine Künstlerresidenz und ein Programm mit fünf Ausstellungen (darunter die des Künstlers in Residenz)."
    ],
    "en": [
      "L'Arteppes, the contemporary art space of the MJC Centre Social Le Mikado, offers an annual artist residency and a program of 5 exhibitions (including that of the artist in residence)."
    ],
    "it": [
      "Ogni anno, Arteppes, lo spazio d'arte contemporanea del MJC Centre Social Le Mikado, offre una residenza d'artista e un programma di 5 mostre (compresa quella dell'artista in residenza)."
    ],
    "fr": [
      "L'Arteppes, espace d'art contemporain de la MJC Centre Social Le Mikado propose chaque année une résidence d'artiste et une programmation de 5 expositions (dont celle de l'artiste en résidence)."
    ],
    "nl": [
      "Elk jaar biedt Arteppes, de hedendaagse kunstruimte van het MJC Centre Social Le Mikado, een kunstenaarsresidentie en een programma van 5 tentoonstellingen (inclusief die van de kunstenaar in residentie)."
    ],
    "es": [
      "Cada año, Arteppes, el espacio de arte contemporáneo del MJC Centre Social Le Mikado, ofrece una residencia artística y un programa de 5 exposiciones (incluida la del artista residente)."
    ]
  },
