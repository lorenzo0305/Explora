  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/12018986-25b2-3c4f-861c-f2dd2e4ffe9d",
      "dc:description": {
        "de": [
          "Offizielle Boutique der Marke JOTT\nTäglich von 10:00 bis 12:30 Uhr und von 14:30 bis 19:00 Uhr geöffnet.\n\nLust, eine Bestellung aufzugeben?\nFinden Sie die Must-Haves der Boutique, indem Sie auf die Schaltfläche \"Reservieren\" klicken"
        ],
        "en": [
          "Official JOTT boutique\nOpen daily from 10am to 12:30pm and from 2:30pm to 7pm.\n\nWant to place an order?\nClick on the \"Reserve\" button to find out more about the store's must-haves"
        ],
        "it": [
          "Negozio ufficiale JOTT\nAperto tutti i giorni dalle 10.00 alle 12.30 e dalle 14.30 alle 19.00.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Riserva\" per vedere gli articoli imperdibili del negozio"
        ],
        "fr": [
          "Boutique officielle de la marque JOTT \nOuvert tous les jours de 10h à 12h30 et de 14h30 à 19h.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "es": [
          "Tienda oficial JOTT\nAbierta todos los días de 10.00 a 12.30 y de 14.30 a 19.00.\n\n¿Desea hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver los artículos imprescindibles de la tienda"
        ],
        "nl": [
          "Officiële JOTT winkel\nElke dag geopend van 10.00 tot 12.30 uur en van 14.30 tot 19.00 uur.\n\nWilt u een bestelling plaatsen?\nKlik op de knop \"Reserveren\" om de must-have artikelen van de winkel te bekijken"
        ]
      },
      "@type": [
        "Description"
      ],
