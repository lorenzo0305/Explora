  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Trödelmarkt Saint-Martin in Laon, der von Dienstag bis Samstag (15 bis 18.30 Uhr) geöffnet ist: Dekoration aus den 1900er bis 70er Jahren, Kleinmöbel...\nKauf/Verkauf, denken Sie daran, zu recyceln statt wegzuwerfen!"
    ],
    "en": [
      "Come and discover the Brocante Saint-Martin in Laon, open Tuesday to Saturday (3pm to 6.30pm): decoration from the 1900s to the 70s, small pieces of furniture...\nBuy/sell, recycle instead of throwing away!"
    ],
    "it": [
      "Venite a scoprire la Brocante Saint-Martin di Laon, aperta dal martedì al sabato (dalle 15.00 alle 18.30): decorazioni dal '900 agli anni '70, piccoli mobili...\nComprare/vendere, riciclare invece di buttare!"
    ],
    "fr": [
      "Venez découvrir la Brocante Saint-Martin à Laon, ouverte du mardi au samedi (de 15h à 18h30) : de la décoration des années 1900 aux années 70, des petits meubles...\nAchat/vente, pensez à recycler au lieu de jeter !"
    ],
    "es": [
      "Venga a descubrir la Brocante Saint-Martin de Laon, abierta de martes a sábado (de 15:00 a 18:30 h): decoración de los años 1900 a 70, pequeños muebles...\nCompra/venta, ¡recicla en lugar de tirar!"
    ],
    "nl": [
      "Kom en ontdek de Brocante Saint-Martin in Laon, open van dinsdag tot zaterdag (15u tot 18u30): decoratie van de jaren 1900 tot de jaren 70, kleine meubelstukken...\nKopen/verkopen, recyclen in plaats van weggooien!"
    ]
  },
