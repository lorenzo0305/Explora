  "rdfs:comment": {
    "de": [
      "Ausritte und Ausflüge mit Ponys,\r\nPraktika für alle Niveaus (Einführung, Cso, Dressur, Equifun, Ponyspiele...)\r\nGruppenunterricht am Dienstag, Mittwoch, Freitag und Samstag.\r\nEinzelunterricht\r\nOffizielle Wettbewerbe,\r\nPension auf der Weide und in der Box."
    ],
    "en": [
      "Horseback riding, pony rides,\r\nCourse for all levels (initiation, cso, dressage, equifun, pony games...)\r\nGroup lessons on Wednesdays, Fridays and Saturdays.\r\nPrivate lessons\r\nOfficial competitions,\r\nBoarding in the meadow and stall"
    ],
    "it": [
      "Equitazione e pony trekking,\r\nCorsi per tutti i livelli (principianti, cso, dressage, equifun, pony games...)\r\nLezioni di gruppo il martedì, mercoledì, venerdì e sabato.\r\nLezioni private\r\nConcorsi ufficiali,\r\nPensione su prato e in box."
    ],
    "fr": [
      "Promenade à cheval, balade à poney,\r\nStage pour tout niveaux (initiation, cso, dressage, equifun, pony games...)\r\nCours collectifs le mardi, mercredi, vendredi et samedi.\r\nCours particuliers \r\nConcours officiels,\r\nPension au pré et box."
    ],
    "nl": [
      "Paardrijden en ponyrijden,\r\nCursussen voor alle niveaus (beginners, cso, dressuur, equifun, ponyspelen...)\r\nGroepslessen op dinsdag, woensdag, vrijdag en zaterdag.\r\nPrivélessen\r\nOfficiële wedstrijden,\r\nWeide- en boxstalling."
    ],
    "es": [
      "Equitación y paseos en poni,\r\nCursos para todos los niveles (iniciación, cso, doma, equifun, juegos con ponis...)\r\nClases en grupo los martes, miércoles, viernes y sábados.\r\nClases particulares\r\nCompeticiones oficiales,\r\nPensión en prado y box."
    ]
  },
