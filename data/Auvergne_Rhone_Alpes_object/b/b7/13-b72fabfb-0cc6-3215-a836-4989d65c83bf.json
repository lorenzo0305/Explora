  "rdfs:comment": {
    "de": [
      "Fast das ganze Jahr über können Sie neben der Berghütte Refuge des Narces in einer Gruppe ein neues Spielgefühl in der Natur entdecken. (mindestens 6 Personen und über 14 Jahre)."
    ],
    "en": [
      "Come and discover the thrill of playing in a group in a natural environment next to the Narces refuge, almost all year round. (minimum 6 people and over 14 years old)."
    ],
    "it": [
      "Tutto l'anno, venite a scoprire in gruppo nuove sensazioni di gioco in un ambiente naturale vicino al rifugio Narces. (minimo 6 persone e più di 14 anni)."
    ],
    "fr": [
      "Toute l'année, venez découvrir de nouvelles sensations de jeu en milieu naturel à côté du refuge des Narces en groupe. (minimum 6 personnes et plus de 14 ans)."
    ],
    "nl": [
      "Kom het hele jaar door in groepsverband nieuwe speelsensaties ontdekken in een natuurlijke omgeving naast de schuilhut Narces. (minimaal 6 personen en ouder dan 14 jaar)."
    ],
    "es": [
      "Durante todo el año, ven a descubrir en grupo nuevas sensaciones de juego en un entorno natural junto al refugio de Narces. (mínimo 6 personas y mayores de 14 años)."
    ]
  },
