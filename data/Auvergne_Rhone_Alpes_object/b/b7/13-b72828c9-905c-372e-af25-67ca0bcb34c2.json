  "rdfs:comment": {
    "de": [
      "Ein Bergbauernhof‑Restaurant, 6 km von Aurillac entfernt: Bulle de Salers bietet Sommer wie Winter ein gastronomisches Erlebnis rund um das Fleisch der eigenen Salers‑Rinder, in geodätischen Kuppeln auf der Weide oder in einem authentischen Berghirtenhaus in den Bergen."
    ],
    "en": [
      "A mountain farm restaurant 6 km from Aurillac, Bulle de Salers offers, summer and winter, a gastronomic experience centered on beef from its own Salers herd, in geodesic domes out in the fields or in an authentic mountain buron."
    ],
    "it": [
      "Ristorante di fattoria in alta montagna, a 6 km da Aurillac, Bulle de Salers propone, in estate e in inverno, un’esperienza gastronomica incentrata sulla carne di bovini Salers del proprio allevamento, in cupole geodetiche in mezzo ai campi o in un autentico rifugio (buron) di montagna."
    ],
    "fr": [
      "Restaurant de ferme en pleine montagne à 6 km d’Aurillac, Bulle de Salers propose, été comme hiver, une expérience gastronomique autour de la viande de Salers de notre élevage, en bulles géodésiques en plein champ ou dans un authentique buron d’altitude."
    ],
    "es": [
      "Granja restaurante en plena montaña, a 6 km de Aurillac, Bulle de Salers ofrece una experiencia gastronómica, tanto en verano como en invierno, en torno a la carne de Salers de nuestra propia granja, en burbujas geodésicas en campo abierto o en un auténtico aprisco de montaña."
    ],
    "nl": [
      "Bulle de Salers, een restaurant op de boerderij in het hart van de bergen, op 6 km van Aurillac, biedt een gastronomische ervaring, zowel in de zomer als in de winter, op basis van Salers vlees van onze eigen boerderij, in geodetische bubbels in het open veld of in een authentieke schaapskooi in de bergen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bulle de salers"
    ]
  },
