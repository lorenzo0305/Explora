  "rdfs:comment": {
    "de": [
      "Wagen Sie es, die Umfassungsmauer dieses Landsitzes aus dem Jahr 1717 zu durchbrechen, um einen erstaunlichen 2 Hektar großen Garten in Humeroeuille (Pas-de-Calais) im grünen Artois zu entdecken."
    ],
    "en": [
      "Dare to climb over the perimeter wall of this 1717 gentleman's residence to discover an astonishing 2-hectare garden at Humeroeuille (Pas-de-Calais) in the Artois Vert region."
    ],
    "it": [
      "Osate scavalcare il muro di cinta di questa casa padronale del 1717 per scoprire un sorprendente giardino di 2 ettari a Humeroeuille (Pas-de-Calais), nella verde regione dell'Artois."
    ],
    "fr": [
      "Osez franchir le mur d'enceinte de cette gentilhommière de 1717 pour y découvrir un jardin de 2 hectares étonnant à Humeroeuille (Pas-de-Calais) dans l'Artois vert."
    ],
    "nl": [
      "Durf over de ommuring van dit herenhuis uit 1717 te klimmen om een verbazingwekkende tuin van 2 hectare te ontdekken in Humeroeuille (Pas-de-Calais) in de groene Artois streek."
    ],
    "es": [
      "Atrévase a escalar el muro perimetral de esta casa solariega de 1717 para descubrir un asombroso jardín de 2 hectáreas en Humeroeuille (Pas-de-Calais), en la verde región de Artois."
    ]
  },
