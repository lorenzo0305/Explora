  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a8cb1504-6d3a-3cb4-ac3a-cd54f052aca1",
      "dc:description": {
        "de": [
          "Mieten Sie Ihr Fahrrad im Herzen eines Hotels***& Restaurants.\nVerleih von Fahrrädern für Erwachsene und Kinder für Einwohner und Nicht-Einwohner.\nAusgangspunkt für Ihre Ausflüge in die Somme-Bucht.\nFahrradpark: 30 Fahrräder für Erwachsene - 3 Fahrräder für Jugendliche - 2 Kindersitze."
        ],
        "en": [
          "Rent your bike in the heart of a hotel***& restaurant.\nBicycle hire for adults and children for residents and non-residents.\nStarting point for your rides in the bay of the Somme.\nBike park : 30 adult bikes - 3 teenage bikes - 2 baby seats."
        ],
        "it": [
          "Noleggiate la vostra bicicletta nel cuore di un hotel***& ristorante.\nNoleggio di biciclette per adulti e bambini per residenti e non residenti.\nPunto di partenza per le vostre escursioni nella Baia della Somme.\nParco biciclette: 30 biciclette per adulti - 3 biciclette per ragazzi - 2 seggiolini per bambini."
        ],
        "fr": [
          "Louez votre vélo au coeur d'un hotel***& restaurant.\nLocation de vélos adultes et enfants pour les résidents et non résidents.\nPoint de départ de vos balades en baie de Somme.\nParc vélos : 30 vélos adultes - 3 vélos ado - 2 sièges bébés."
        ],
        "nl": [
          "Huur uw fiets in het hart van een hotel***& restaurant.\nFietsverhuur voor volwassenen en kinderen voor inwoners en niet-inwoners.\nVertrekpunt voor uw tochten in de Baai van de Somme.\nFietsenstalling: 30 volwassen fietsen - 3 tienerfietsen - 2 babyzitjes."
        ],
        "es": [
          "Alquile su bicicleta en el corazón de un hotel***& restaurante.\nAlquiler de bicicletas para adultos y niños para residentes y no residentes.\nPunto de partida para sus paseos en la Bahía del Somme.\nParque de bicicletas: 30 bicicletas para adultos - 3 bicicletas para adolescentes - 2 sillas para bebés."
        ]
      },
