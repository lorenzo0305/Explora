  "rdfs:comment": {
    "de": [
      "Machen Sie die einzigartige Erfahrung eines Ortes mit einer über 200-jährigen Geschichte. Das Hôtel Restaurant Ancien Grand Séminaire ist ein Schmuckkästchen der Ruhe im Herzen der mittelalterlichen Stadt Saint-Flour."
    ],
    "en": [
      "Experience a unique place with over 200 years of history. The Hôtel Restaurant Ancien Grand Séminaire is a haven of calm in the heart of the medieval town of Saint-Flour."
    ],
    "it": [
      "Godetevi un'esperienza unica in un luogo con oltre 200 anni di storia. L'Hôtel Restaurant Ancien Grand Séminaire è un'oasi di pace nel cuore della città medievale di Saint-Flour."
    ],
    "fr": [
      "Faites l'expérience unique d'un lieu de plus de 200 ans d'histoire. L'Hôtel Restaurant Ancien Grand Séminaire est un écrin de calme au coeur de la cité médiévale de Saint-Flour."
    ],
    "nl": [
      "Geniet van een unieke ervaring op een plek met meer dan 200 jaar geschiedenis. Hôtel Restaurant Ancien Grand Séminaire is een oase van rust in het hart van de middeleeuwse stad Saint-Flour."
    ],
    "es": [
      "Disfrute de una experiencia única en un lugar con más de 200 años de historia. El Hôtel Restaurant Ancien Grand Séminaire es un remanso de calma en el corazón de la ciudad medieval de Saint-Flour."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Restaurant de l'Ancien Grand Séminaire"
    ]
  },
