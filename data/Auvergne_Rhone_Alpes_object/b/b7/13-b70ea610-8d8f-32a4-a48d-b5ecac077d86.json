  "rdfs:comment": {
    "de": [
      "Im Geist eines Dorfcafés empfängt Sie das Team von Frédéric Molina (Moulin de Léré & Forêt Ivre*) im Billiat, einem historischen Restaurant im Dorf Vailly."
    ],
    "en": [
      "In the spirit of the village café, Frédéric Molina's team (Moulin de Léré & Forêt Ivre*) welcomes you to Le Billiat, the historic restaurant in the village of Vailly."
    ],
    "it": [
      "Nello spirito del caffè di paese, il team di Frédéric Molina (Moulin de Léré & Forêt Ivre*) vi dà il benvenuto a Le Billiat, lo storico ristorante del villaggio di Vailly."
    ],
    "fr": [
      "Dans l'esprit du café du village, l'équipe de Frédéric Molina (Moulin de Léré & Forêt Ivre*) vous accueille au Billiat, restaurant historique du village de Vailly."
    ],
    "nl": [
      "In de geest van het dorpscafé heet het team van Frédéric Molina (Moulin de Léré & Forêt Ivre*) je welkom in Le Billiat, het historische restaurant in het dorp Vailly."
    ],
    "es": [
      "En el espíritu del café de pueblo, el equipo de Frédéric Molina (Moulin de Léré & Forêt Ivre*) le da la bienvenida a Le Billiat, el restaurante histórico del pueblo de Vailly."
    ]
  },
