  "rdfs:comment": {
    "de": [
      "Gleich nach seiner Ankunft in Caullery rührte Abbé Dupas die Not der Kirche und begann mit dem Bau einer neuen Kirche."
    ],
    "en": [
      "As soon as he arrived in Caullery, Abbé Dupas was moved by the distress of the church and set about building a new one."
    ],
    "it": [
      "Appena arrivato a Caullery, l'Abbé Dupas si commosse per l'angoscia della chiesa e si mise a costruirne una nuova."
    ],
    "fr": [
      "Dès son arrivée à Caullery, l'abbé Dupas s'émeut de la détresse de l'église et entreprend d'en bâtir une nouvelle."
    ],
    "nl": [
      "Zodra hij in Caullery aankwam, was Abbé Dupas ontroerd door de nood van de kerk en begon hij met de bouw van een nieuwe."
    ],
    "es": [
      "Nada más llegar a Caullery, el abate Dupas se sintió conmovido por el desamparo de la iglesia y se dispuso a construir una nueva."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise de la Vierge Marie de Caullery"
    ]
  },
