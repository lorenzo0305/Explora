  "rdfs:comment": {
    "de": [
      "Sylvie und Pauline begrüßen Sie in diesem Gebäude aus dem Jahr 1788, das renoviert wurde, um das Moderne mit dem Alten zu verbinden. Es werden Ihnen lokale und traditionelle Gerichte sowie Spezialitäten zum Teilen angeboten."
    ],
    "en": [
      "Sylvie and Pauline welcome you to this 1788 building, renovated to combine the old and the new. You will be offered local and traditional dishes, as well as specialities to share."
    ],
    "it": [
      "Sylvie e Pauline vi danno il benvenuto in questo edificio del 1788, ristrutturato per combinare il moderno e l'antico. Vi verranno offerti piatti locali e tradizionali e specialità da condividere."
    ],
    "fr": [
      "Sylvie et Pauline vous accueillent dans cette bâtisse de 1788 rénovée pour allier le moderne et l'ancien. Vous seront proposés des plats locaux, traditionnels ainsi que des spécialités à partager."
    ],
    "es": [
      "Sylvie y Pauline le dan la bienvenida a este edificio de 1788, renovado para combinar lo moderno y lo antiguo. Se le ofrecerán platos locales y tradicionales, así como especialidades para compartir."
    ],
    "nl": [
      "Sylvie en Pauline heten u welkom in dit gebouw uit 1788, gerenoveerd om het oude en het nieuwe te combineren. U krijgt lokale en traditionele gerechten geserveerd, evenals specialiteiten om te delen."
    ]
  },
  "rdfs:label": {
