  "rdfs:comment": {
    "de": [
      "Dieses unabhängige Winzerpaar bietet Ihnen Weine ohne Hilfsmittel an, die aus einer biologischen oder in Umstellung befindlichen Produktion stammen."
    ],
    "en": [
      "This independent winegrower couple offer you wines produced without inputs using organic or in-conversion methods."
    ],
    "it": [
      "Questa coppia di viticoltori indipendenti vi offre vini prodotti senza alcun apporto, sia in regime biologico che di conversione."
    ],
    "fr": [
      "Ce couple de vignerons indépendants vous propose des vins sans intrants, issus d’une production en agriculture biologique ou en conversion."
    ],
    "es": [
      "Esta pareja de viticultores independientes le ofrece vinos producidos sin insumos, ya sea de forma ecológica o en conversión."
    ],
    "nl": [
      "Dit stel onafhankelijke wijnboeren biedt je wijnen die zonder enige input zijn geproduceerd, zowel biologisch als in conversie."
    ]
  },
