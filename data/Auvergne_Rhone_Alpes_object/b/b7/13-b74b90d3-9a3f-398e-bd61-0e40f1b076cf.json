  "rdfs:comment": {
    "de": [
      "Der private Fischteich von Lafay ist ein künstlich angelegtes Gewässer, durch das der Bach Rosson fließt. Er gehört dem Schloss Lafay."
    ],
    "en": [
      "The Lafay private fishing pond is a man-made lake crossed by the Rosson stream. It belongs to Château de Lafay."
    ],
    "it": [
      "Il laghetto di pesca privato di Lafay è un lago artificiale in cui scorre il torrente Rosson. Appartiene allo Château de Lafay."
    ],
    "fr": [
      "L'étang de pêche privé de Lafay est un plan d’eau artificiel traversé par le ruisseau le Rosson. Il appartient au château de Lafay."
    ],
    "es": [
      "El estanque privado de pesca de Lafay es un lago artificial atravesado por el arroyo Rosson. Pertenece al castillo de Lafay."
    ],
    "nl": [
      "De privévisvijver in Lafay is een kunstmatig aangelegd meer waar de Rosson doorheen stroomt. Het behoort toe aan het Château de Lafay."
    ]
  },
