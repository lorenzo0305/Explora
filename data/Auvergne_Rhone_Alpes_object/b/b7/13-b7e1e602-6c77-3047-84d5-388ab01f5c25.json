  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Technik des Mikro-Macramé, indem Sie mehrere kleine Armbänder herstellen. Große Auswahl an Garn- und Perlenfarben. Offen für alle ab 6 Jahren."
    ],
    "en": [
      "Discover the micro macramé technique by making several small bracelets. Wide choice of thread and bead colors. Open to everyone aged 6 and over."
    ],
    "it": [
      "Scoprite la tecnica del micro macramè realizzando diversi piccoli braccialetti. Ampia scelta di colori di fili e perline. Aperto a tutti a partire dai 6 anni."
    ],
    "fr": [
      "Découvrez la technique du micro macramé par la réalisation de plusieurs petits bracelets. Large choix de couleurs de fils et de perles. Ouvert à tous dès 6 ans."
    ],
    "nl": [
      "Ontdek de micro macramé techniek door verschillende kleine armbandjes te maken. Ruime keuze uit draad- en kraalkleuren. Voor iedereen vanaf 6 jaar."
    ],
    "es": [
      "Descubra la técnica del micro macramé realizando varias pulseras pequeñas. Amplia gama de colores de hilos y cuentas. Abierto a todos a partir de 6 años."
    ]
  },
