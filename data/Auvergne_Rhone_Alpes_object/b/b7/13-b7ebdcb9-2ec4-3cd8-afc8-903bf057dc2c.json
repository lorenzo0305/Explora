  "rdfs:comment": {
    "de": [
      "Herstellung von Käse aus Kuhmilch und Fässern.\r\nVerkauf ab Hof am Mittwochnachmittag und am Samstagvormittag.\r\nBonus: Die Kälber im Stall warten auf den Besuch von Groß und Klein."
    ],
    "en": [
      "Production of cow's milk cheeses and faisselles.\r\nFarm sales on Wednesday afternoons and Saturday mornings.\r\nBonus: calves in the cowshed await visits from young and old."
    ],
    "it": [
      "Produzione di formaggi di fattoria a latte crudo di vacca e faisselles.\r\nVendita in fattoria il mercoledì pomeriggio e il sabato mattina.\r\nBonus: i vitelli nella stalla sono aperti ai visitatori di tutte le età."
    ],
    "fr": [
      "Production de fromages fermiers au lait cru de vaches et de faisselles.\r\nVente à la ferme le mercredi après-midi et le samedi matin.\r\nBonus : les veaux dans l'étable attendent la visite des petits et grands."
    ],
    "nl": [
      "Productie van boerenkazen van rauwe koemelk en faisselles.\r\nBoerderijverkoop op woensdagmiddag en zaterdagochtend.\r\nBonus: de kalveren in de koeienstal zijn toegankelijk voor bezoekers van alle leeftijden."
    ],
    "es": [
      "Producción de quesos de leche de vaca y faisselles.\r\nVenta en la granja los miércoles por la tarde y los sábados por la mañana.\r\nAdemás, los terneros del establo esperan la visita de grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme du Mas des Buissons"
    ]
  },
