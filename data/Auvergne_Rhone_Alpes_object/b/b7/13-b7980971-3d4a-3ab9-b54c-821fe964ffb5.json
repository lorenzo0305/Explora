  "rdfs:comment": {
    "de": [
      "See mit beaufsichtigtem Badebetrieb. Der Bereich Ludi'lacs bietet Ihnen in der Umgebung: Kajak, Paddle, Snack, Bouleplatz, Beachvolleyballfeld, Grillplätze und Picknicktische."
    ],
    "en": [
      "Supervised bathing lake. The Ludi'lacs area offers you nearby: kayak, paddle, snack, pétanque area, beach volleyball court, barbecues and picnic tables."
    ],
    "it": [
      "Lago balneabile sorvegliato. L'area Ludi'lacs offre kayak, paddle-board, uno snack bar, un'area per le bocce, un campo da beach volley, barbecue e tavoli da picnic."
    ],
    "fr": [
      "Lac de baignade surveillée. L'espace Ludi'lacs vous propose aux abords : kayak, paddle, snack, espace de pétanque, terrain de beach-volley, barbecues et tables de pique-nique."
    ],
    "es": [
      "Lago de baño vigilado. La zona de Ludi'lacs ofrece kayak, paddle-board, un snack bar, una zona de petanca, una pista de vóley-playa, barbacoas y mesas de picnic."
    ],
    "nl": [
      "Bewaakt zwemmeer. Het gebied van Ludi'lacs biedt u in de buurt: kajak, paddle, snack, jeu de boules, beachvolleybalveld, barbecues en picknicktafels."
    ]
  },
