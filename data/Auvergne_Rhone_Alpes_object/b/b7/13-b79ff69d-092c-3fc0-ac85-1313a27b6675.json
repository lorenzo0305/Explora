  "rdfs:comment": {
    "de": [
      "Der Espace Forme, für eine bessere körperliche Verfassung. Es handelt sich um einen Sportbereich, der für Einheimische, Kurgäste und Touristen zugänglich ist. Dieser Bereich umfasst einen Cardiotrainingsbereich, einen Bereich für Muskelaufbau und einen Bereich für Dehnübungen."
    ],
    "en": [
      "The Espace Forme, for improved fitness. This is a sports area open to locals, spa-goers and tourists alike. This area includes a cardiotraining zone, a muscle-strengthening zone and a stretching zone."
    ],
    "it": [
      "L'Espace Forme, per una migliore condizione fisica. Si tratta di uno spazio dedicato allo sport accessibile a locali, curisti e turisti. Quest'area comprende una zona di cardiotraining, una zona di rafforzamento muscolare e una zona di stretching."
    ],
    "fr": [
      "L'Espace Forme, pour une meilleure condition physique. Il s'agit d'un espace dédié au sport accessible aux locaux, curistes et touristes. Cet espace comprend une zone cardiotraining, une zone de renforcement musculaire, ainsi qu'une zone d'étirements."
    ],
    "es": [
      "El Espace Forme, para una mejor condición física. Se trata de un espacio dedicado al deporte accesible a locales, curistas y turistas. Esta área incluye una zona de cardiotraining, una zona de fortalecimiento muscular y una zona de estiramientos."
    ],
    "nl": [
      "De Espace Forme, voor een betere conditie. Dit is een sportterrein dat openstaat voor de plaatselijke bevolking, kuurgasten en toeristen. Dit gebied bevat een cardiotrainingszone, een spierversterkingszone en een stretchingzone."
    ]
  },
