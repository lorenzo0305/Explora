  "rdfs:comment": {
    "de": [
      "Entdecken Sie die bretonische Authentizität mit unserer mobilen Crêperie! Galettes, handgemachte Crêpes und außergewöhnlicher bretonischer Cidre. Wir kommen für alle Ihre Veranstaltungen mit lokalen und bretonischen Produkten, die Ihre Gäste begeistern werden."
    ],
    "en": [
      "Discover authentic Brittany with our mobile crêperie! Galettes, home-made crepes and exceptional Breton ciders. We travel to all your events with local and Breton products that will delight your guests."
    ],
    "it": [
      "Scoprite l'autenticità della Bretagna con la nostra crêperie mobile! Galettes, crêpes fatte in casa e sidri bretoni eccezionali. Ci rechiamo a tutti i vostri eventi con prodotti locali e bretoni che delizieranno i vostri ospiti."
    ],
    "fr": [
      "Découvrez l’authenticité bretonne avec notre crêperie ambulante ! Galettes, crêpes artisanales et cidres bretons d’exception. Nous nous déplaçons pour tous vos événements avec des produits locaux et bretons qui raviront vos convives."
    ],
    "nl": [
      "Ontdek de authenticiteit van Bretagne met onze reizende crêperie! Galettes, huisgemaakte crêpes en uitzonderlijke Bretonse ciders. Wij reizen naar al uw evenementen met lokale en Bretonse producten die uw gasten zullen verrukken."
    ],
    "es": [
      "Descubra la autenticidad de Bretaña con nuestra crepería ambulante Galettes, crêpes caseros y sidras bretonas excepcionales. Nos desplazamos a todos sus eventos con productos locales y bretones que harán las delicias de sus invitados."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tout de Breizh"
    ]
  },
