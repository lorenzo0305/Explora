  "rdfs:comment": {
    "de": [
      "Von der Freizeitanlage in Aurec-sur-Loire aus wandern Sie am Ufer der Loire entlang bis zum Felsen Saut du chien und dann über die inzwischen berühmte Fußgängerbrücke über den Fluss! Diese einfache Route ohne Höhenunterschiede ist für alle zugänglich."
    ],
    "en": [
      "From the Aurec-sur-Loire leisure center, follow the banks of the Loire to the Saut du chien rock. Then take the now-famous footbridge over the river! This route is accessible to all."
    ],
    "it": [
      "Dal centro ricreativo di Aurec-sur-Loire, camminate lungo le rive della Loira fino alla roccia del Saut du chien, poi prendete la famosa passerella sul fiume! Questo percorso semplice e pianeggiante è accessibile a tutti."
    ],
    "fr": [
      "À partir de la base de loisirs d'Aurec-sur-Loire, longez les bords de Loire jusqu'au rocher du Saut du chien puis empruntez la désormais célèbre passerelle au dessus du fleuve ! Cet itinéraire simple et sans dénivelé est accessible à tous."
    ],
    "nl": [
      "Wandel vanaf het recreatiecentrum van Aurec-sur-Loire langs de oevers van de Loire naar de rots Saut du chien en neem vervolgens de beroemde loopbrug over de rivier! Deze eenvoudige, vlakke route is voor iedereen toegankelijk."
    ],
    "es": [
      "Desde el centro de ocio de Aurec-sur-Loire, camine por las orillas del Loira hasta la roca Saut du chien y, a continuación, tome la famosa pasarela sobre el río Este recorrido sencillo y llano es accesible para todos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Saut du Chien footbridges"
    ],
    "fr": [
      "Passerelles du Saut du Chien"
    ]
  },
