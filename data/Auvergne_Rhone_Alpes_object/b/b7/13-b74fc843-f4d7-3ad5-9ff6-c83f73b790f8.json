  "rdfs:comment": {
    "de": [
      "ESI verfügt über ein Team von 40 staatlich geprüften Skilehrern/innen, Bergführern/innen und Lehrern/innen für Gleitschirmfliegen und Vol Libre, die ihre Leidenschaft mit Ihnen teilen möchten. Anerkannt von DDJS und Education Nationale - Privatunterricht, Gruppenunterricht."
    ],
    "en": [
      "Our team includes 40 instructors, high mountain guides and parapenting and hang-gliding instructors come and share our passion.\r\nPrivate lessons, group lessons 9 people maximum..."
    ],
    "it": [
      "L'ESI dispone di un team di 40 maestri di sci, guide di alta montagna e istruttori di parapendio e deltaplano, tutti qualificati dallo Stato, per condividere con voi le loro passioni. Approvato dal DDJS e dal Ministero dell'Istruzione francese - Lezioni private, lezioni di gruppo."
    ],
    "fr": [
      "L'ESI dispose d'une équipe de 40 moniteurs/trices de ski, guides de haute montagne et moniteurs de parapente et Vol Libre, diplômés d'état, pour vous faire partager leurs passions. Agréée DDJS et Education Nationale - Leçons privées, cours collectifs."
    ],
    "nl": [
      "Ons team bestaat uit 40 instructeurs, berggidsen en parapenten en deltavliegen instructeurs komen en delen onze passie."
    ],
    "es": [
      "La ESI cuenta con un equipo de 40 instructores de esquí, guías de alta montaña e instructores de parapente y ala delta, todos ellos con titulación estatal, para compartir sus pasiones con usted. Homologado por la DDJS y el Ministerio de Educación francés - Clases particulares, clases en grupo."
    ]
  },
  "rdfs:label": {
