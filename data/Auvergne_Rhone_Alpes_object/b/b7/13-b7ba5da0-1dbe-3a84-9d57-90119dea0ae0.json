  "rdfs:comment": {
    "de": [
      "Erleben Sie fantastische oder historische Abenteuer. Tauche ein in fesselnde Geschichten, die mit Geheimnissen gespickt sind. Durchsuche, manipuliere Gegenstände und löse Rätsel, um deine Missionen in Teams von 2 bis 7 Spielern ab 12 Jahren zu erfüllen."
    ],
    "en": [
      "Come and experience fantastic or historical adventures. Immerse yourself in gripping stories studded with mystery. Dig, manipulate objects and solve enigmas to accomplish your missions in teams of 2 to 7 players, aged 12 and over."
    ],
    "it": [
      "Venite a vivere avventure fantastiche o storiche. Immergetevi in storie avvincenti e piene di misteri. Scavate, maneggiate oggetti e risolvete enigmi per completare le vostre missioni in squadre da 2 a 7 giocatori, a partire dai 12 anni."
    ],
    "fr": [
      "Venez vivre des aventures fantastiques ou historiques. Plongez dans des histoires prenantes, parsemées de mystères. Fouillez, manipulez des objets et résolvez les énigmes pour accomplir vos missions en équipe de 2 à 7 joueurs, dès 12 ans."
    ],
    "es": [
      "Venga a vivir aventuras fantásticas o históricas. Sumérgete en apasionantes historias salpicadas de misterios. Excava, manipula objetos y resuelve enigmas para completar tus misiones en equipos de 2 a 7 jugadores, a partir de 12 años."
    ],
    "nl": [
      "Kom fantastische of historische avonturen beleven. Dompel jezelf onder in aangrijpende verhalen vol mysteries. Graaf, hanteer voorwerpen en los raadsels op om je missies te voltooien in teams van 2 tot 7 spelers vanaf 12 jaar."
    ]
  },
  "rdfs:label": {
