  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant unweit des historischen Zentrums des Dorfes Désaignes. Genießen Sie Gerichte, die aus frischen, lokalen Produkten zubereitet werden. Da es in der Nähe des Sees liegt, ist es auch eine gute Gelegenheit, sich zwischen zwei Badegängen mit einem Eis zu erfrischen."
    ],
    "en": [
      "Traditional restaurant located not far from the historical centre of the village of Désaignes. Enjoy dishes made from fresh and local products. Located near the lake, it is also an opportunity to refresh yourself between two swims with an ice cream."
    ],
    "it": [
      "Ristorante tradizionale situato non lontano dal centro storico del villaggio di Désaignes. Si possono gustare piatti a base di prodotti freschi e locali. Situato vicino al lago, è anche un luogo ideale per rinfrescarsi tra una nuotata e l'altra con un gelato."
    ],
    "fr": [
      "Restaurant traditionnel situé non loin du centre historique du village de Désaignes. Savourez des plats faits à partir de produits frais et locaux. Situé près du lac, c'est aussi une occasion de se rafraîchir entre deux baignades avec une glace."
    ],
    "es": [
      "Restaurante tradicional situado no lejos del centro histórico del pueblo de Désaignes. Disfrute de platos elaborados con productos frescos y locales. Situado cerca del lago, también es un lugar ideal para refrescarse entre chapuzón y chapuzón con un helado."
    ],
    "nl": [
      "Het restaurant op de camping is voor iedereen toegankelijk. De prioriteit ligt bij het bereiden van verse, lokale producten. Vlak naast het meer is het ook de perfecte plek om af te koelen met een traditioneel ijsje uit de Ardèche."
    ]
  },
  "rdfs:label": {
