  "rdfs:comment": {
    "de": [
      "Als Anlaufstelle für Liebhaber oder Sammler, die ein Möbelstück kaufen, verkaufen oder begutachten lassen möchten, ist es auch ein Ort für wechselnde Ausstellungen."
    ],
    "en": [
      "A place to welcome amateurs and collectors wishing to buy, sell or have a piece of furniture appraised, it is also a venue for temporary exhibitions."
    ],
    "it": [
      "È un luogo per amatori o collezionisti che desiderano acquistare, vendere o far valutare un mobile. È anche uno spazio per mostre temporanee."
    ],
    "fr": [
      "Lieu d'accueil pour amateurs ou collectionneurs souhaitant acheter, vendre ou faire expertiser un bien mobilier, c'est aussi un espace d'expositions temporaires."
    ],
    "nl": [
      "Het is een plek voor amateurs of verzamelaars die een meubelstuk willen kopen, verkopen of laten taxeren. Het is ook een ruimte voor tijdelijke tentoonstellingen."
    ],
    "es": [
      "Es un lugar donde aficionados y coleccionistas pueden comprar, vender o tasar un mueble, y también alberga exposiciones temporales."
    ]
  },
