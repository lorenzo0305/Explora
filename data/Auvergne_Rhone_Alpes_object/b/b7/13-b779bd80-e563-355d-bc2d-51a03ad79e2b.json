  "rdfs:comment": {
    "de": [
      "Traditionelle Pizzeria mit neapolitanischen Pizzen, die im Holzofen gebacken werden und besonders lecker schmecken.\r\nEin einfaches, schnelles und köstliches Angebot. Ausschließlich zum Mitnehmen!"
    ],
    "en": [
      "Artisanal pizzeria offering Neapolitan-style pizzas cooked in a wood-fired oven for a delicious flavour.\r\nA simple, quick and tasty menu. Takeaway only!"
    ],
    "it": [
      "Pizzeria artigianale che offre pizze in stile napoletano cotte alla fiamma, con un tocco gustoso.\r\nSemplice, veloce e deliziosa. Esclusivamente da asporto!"
    ],
    "fr": [
      "Pizzeria artisanale proposant des pizzas style napolitaine cuites à la flamme, offrant une cuisson savoureuse. \r\nUne offre simple, rapide et gourmande. Exclusivement à emporter !"
    ],
    "es": [
      "Pizzería artesanal que ofrece pizzas al estilo napolitano cocinadas a la llama, con un sabroso toque.\r\nSencillas, rápidas y deliciosas. Exclusivamente para llevar"
    ],
    "nl": [
      "Ambachtelijke pizzeria met Napolitaanse pizza's bereid boven een vlam, met een smakelijke twist.\r\nEenvoudig, snel en heerlijk. Uitsluitend afhalen!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Félicia - Pizzas à emporter"
    ]
  },
