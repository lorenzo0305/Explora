  "rdfs:comment": {
    "de": [
      "Mountainbike-Schule MCF (Mountainbike, Fatbike, Radfahren, Gravel). Kurse, Coaching, Praktika, Wanderungen, Entdeckungen. Entdecken Sie das Fahrrad und wunderschöne Landschaften, angepasst an Ihre Wünsche und Ihr Niveau, immer unter dem Zeichen des Unterrichts und der spielerischen Betreuung"
    ],
    "en": [
      "MCF mountain bike school (MTB, Fatbike, cycling, gravel). Courses, Coaching, Training, Hiking, Discovery. Come and discover cycling and magnificent landscapes, adapted to your wishes and your level, always under the sign of teaching and playful supervision"
    ],
    "it": [
      "Scuola di mountain bike MCF (MTB, Fatbike, Ciclismo, Gravel). Corsi, Coaching, Formazione, Escursioni, Scoperta. Venite a scoprire il ciclismo e i magnifici paesaggi, adattati ai vostri desideri e al vostro livello, sempre all'insegna dell'insegnamento e del divertimento"
    ],
    "fr": [
      "Ecole de VTT MCF (VTT, Fatbike, cyclisme, gravel). Cours, Coaching, Stage, Rando, Découverte. Venez découvrir le vélo et des paysages magnifiques, adaptées à vos souhaits, à votre niveau, toujours sous le signe de l’enseignement et l’encadrement ludique"
    ],
    "nl": [
      "MCF Mountainbikeschool (MTB, Fatbike, Wielrennen, Gravel). Cursussen, Coaching, Training, Wandelen, Ontdekken. Kom fietsen en prachtige landschappen ontdekken, aangepast aan je wensen en je niveau, altijd onder het teken van lesgeven en leuke begeleiding"
    ],
    "es": [
      "MCF Escuela de BTT (MTB, Fatbike, Ciclismo, Gravel). Cursos, Coaching, Formación, Senderismo, Descubrimiento. Venga a descubrir el ciclismo y magníficos paisajes, adaptados a sus deseos y a su nivel, siempre bajo el signo de la enseñanza y de una supervisión lúdica"
    ]
  },
