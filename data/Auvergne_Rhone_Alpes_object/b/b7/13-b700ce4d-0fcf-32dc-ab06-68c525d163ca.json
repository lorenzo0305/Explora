  "rdfs:comment": {
    "de": [
      "Ein einzigartiges Gelände für Mountainbiker in Buis-les-Baronnies in der Drôme Provençale.\r\nEin Spielplatz für Mountainbiker, der für alle Altersgruppen (ab 5 Jahren) geeignet ist."
    ],
    "en": [
      "A unique site dedicated to mountain biking in Buis-les-Baronnies, Drôme Provençale.\r\nA playground adapted to mountain biking, open to riders of all ages (from 5 upwards)."
    ],
    "it": [
      "Un sito unico dedicato alla mountain bike a Buis-les-Baronnies, nella Drôme Provençale.\r\nUn parco giochi adattato alla mountain bike, aperto a tutte le età (a partire dai 5 anni)"
    ],
    "fr": [
      "Un site unique d’aménagement dédié à la pratique du VTT à Buis-les-Baronnies, en Drôme Provençale.\r\nUne aire de jeux adaptée au vtt, ouvert à tous les pratiquants de tout âge (dès 5 ans)"
    ],
    "es": [
      "Un sitio único dedicado a la bicicleta de montaña en Buis-les-Baronnies, en la Drôme provenzal.\r\nUn parque infantil adaptado a la bicicleta de montaña, abierto a todas las edades (a partir de 5 años)"
    ],
    "nl": [
      "Een unieke site gewijd aan mountainbiken in Buis-les-Baronnies, in de Drôme Provençale.\r\nEen speeltuin aangepast aan mountainbiken, open voor rijders van alle leeftijden (vanaf 5 jaar)."
    ]
  },
  "rdfs:label": {
