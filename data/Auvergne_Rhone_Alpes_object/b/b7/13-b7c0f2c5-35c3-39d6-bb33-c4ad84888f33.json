  "rdfs:comment": {
    "de": [
      "Modeschmuck und andere Accessoires aus Federn...\r\nHalsketten, Schlüsselanhänger oder Taschenschmuck, Innendekoration, Ohrringe, Lesezeichen......\r\nNur nach vorheriger Anmeldung. Ich habe kein Geschäft."
    ],
    "en": [
      "Costume jewelry and other feather accessories...\r\nNecklaces, key rings or bag jewelry, home decor, earrings, bookmarks.....\r\nReservations only. I don't have a store."
    ],
    "it": [
      "Gioielli di moda e altri accessori di piume...\r\nCollane, portachiavi o gioielli per borse, decorazioni per interni, orecchini, segnalibri.....\r\nSolo su prenotazione. Non ho un negozio."
    ],
    "fr": [
      "Bijoux fantaisies et autres accessoires en plumes...\r\nColliers, porte clés ou bijoux de sac, décoration d'intérieur,  boucles d'oreilles, marque-page.....\r\nUniquement sur réservation. Je n’ai pas de magasin."
    ],
    "nl": [
      "Modejuwelen en andere accessoires voor veren...\r\nKettingen, sleutelhangers of tassieraden, interieurdecoraties, oorbellen, boekenleggers .....\r\nAlleen op reservering. Ik heb geen winkel."
    ],
    "es": [
      "Bisutería y otros accesorios de plumas...\r\nCollares, llaveros o joyas para bolsos, decoración de interiores, pendientes, marcapáginas.....\r\nSólo reservas. No tengo tienda."
    ]
