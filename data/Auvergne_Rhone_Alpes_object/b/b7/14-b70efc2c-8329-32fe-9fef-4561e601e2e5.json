  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/90792e9c-52c8-39e6-8132-7a43b2df51fa",
      "dc:description": {
        "de": [
          "Dieser hübsche Jachthafen am Rande des Sumpfgebiets Audomarois liegt inmitten einer grünen Oase und wird Ihnen angenehme Momente der Entspannung und des Vergnügens bescheren."
        ],
        "en": [
          "Located on the edge of the marsh audomarois, this pretty marina in its green setting, will make you spend pleasant moments of relaxation and pleasure."
        ],
        "it": [
          "Situato ai margini delle paludi di Audomarois, questo grazioso porto turistico immerso nel verde vi regalerà piacevoli momenti di relax e piacere."
        ],
        "fr": [
          "Situé en bordure du marais audomarois, ce joli port de plaisance dans son écrin de verdure, vous fera passer d'agréables moments de détente et de plaisirs."
        ],
        "es": [
          "Situado al borde de las marismas de Audomarois, este bonito puerto deportivo en su entorno verde le proporcionará agradables momentos de relajación y placer."
        ],
        "nl": [
          "Gelegen aan de rand van de moerassen van Audomarois, zal deze mooie jachthaven in zijn groene omgeving u aangename momenten van ontspanning en plezier bezorgen."
        ]
      },
