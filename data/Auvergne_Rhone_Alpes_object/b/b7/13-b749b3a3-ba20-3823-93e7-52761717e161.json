  "rdfs:comment": {
    "de": [
      "Der Plan d'eau des Iles ist ein Flachlandsee der 2. Kategorie und ideal für Familienangeln. Hier findet man eine große Artenvielfalt: Karpfen, Hecht und sogar Zander, aber keine Salmoniden."
    ],
    "en": [
      "The plan d'eau des Iles is a 2nd category flatwater lake, ideal for family fishing. A wide variety of species can be found here: carp, pike and even zander, but no salmon."
    ],
    "it": [
      "Il lago di Iles è un lago di pianura di 2a categoria, ideale per la pesca in famiglia. Ospita una grande varietà di specie: carpe, lucci e persino lucioperca, ma non salmoni."
    ],
    "fr": [
      "Le plan d'eau des Iles est un plan de plaine de 2ème catégorie, idéal pour une pêche familiale. On y trouve une grande diversité d'espèces : carpe, brochet et même sandre, mais pas de salmonidé."
    ],
    "nl": [
      "Het meer van Iles is een laaglandmeer van de 2e categorie, ideaal om met het hele gezin te vissen. Er leven veel verschillende soorten: karper, snoek en zelfs snoekbaars, maar geen zalm."
    ],
    "es": [
      "El lago de Iles es un lago bajo de 2ª categoría, ideal para la pesca familiar. Hay una gran variedad de especies: carpas, lucios e incluso luciopercas, pero ningún salmón."
    ]
  },
