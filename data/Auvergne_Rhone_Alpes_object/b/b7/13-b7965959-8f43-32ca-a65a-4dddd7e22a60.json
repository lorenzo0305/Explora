  "rdfs:comment": {
    "de": [
      "Unsere Backstube befindet sich in der Gemeinde Châteaudouble und ist seit 2011 auf dem angestammten Bauernhof eingerichtet. Wir bewirtschaften 10 ha, auf denen wir Roggen, Einkorn und verschiedene Weizensorten produzieren."
    ],
    "en": [
      "Located in the commune of Châteaudouble, our bakery has been established on the ancestral farm since 2011. We work 10 hectares of land, producing rye, small spelt and different varieties of wheat."
    ],
    "it": [
      "Situato nel comune di Châteaudouble, il nostro panificio si è insediato nella fattoria ancestrale dal 2011. Lavoriamo 10 ettari di terreno, producendo segale, piccolo farro e diverse varietà di grano."
    ],
    "fr": [
      "Situé sur la commune de Châteaudouble, notre fournil est installé depuis 2011 sur la ferme ancestrale. Nous travaillons 10 ha en  sur lesquels nous produisons : seigle, petit épeautre et différentes variétés de blé."
    ],
    "es": [
      "Situada en la comuna de Châteaudouble, nuestra panadería está establecida en la granja ancestral desde 2011. Trabajamos 10 hectáreas de tierra, produciendo centeno, espelta pequeña y diferentes variedades de trigo."
    ],
    "nl": [
      "Onze bakkerij ligt in de gemeente Châteaudouble en is sinds 2011 gevestigd op de voorouderlijke boerderij. We bewerken 10 hectare grond en produceren rogge, kleine spelt en verschillende tarwesoorten."
    ]
  },
  "rdfs:label": {
