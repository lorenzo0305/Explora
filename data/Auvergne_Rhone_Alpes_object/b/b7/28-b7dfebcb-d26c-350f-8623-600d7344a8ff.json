  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7720040f-b204-3b26-8c54-9c8a60582710",
      "dc:description": {
        "de": [
          "Entdecken Sie Chicken Food in Noyon. Sie bieten Ihnen Take-away, Kindermenüs, einen bis spät in die Nacht geöffneten Restaurantservice, Desserts und vieles mehr in einer herzlichen Atmosphäre!"
        ],
        "en": [
          "Discover Chicken Food in Noyon. They offer takeaway, children's menu, late night catering, desserts and much more in a warm atmosphere!"
        ],
        "it": [
          "Scoprite il cibo a base di pollo a Noyon. Offrono piatti da asporto, menu per bambini, catering fino a tarda notte, dessert e molto altro ancora in un'atmosfera accogliente!"
        ],
        "fr": [
          "Découvrez Chicken Food à Noyon. Ils vous proposent vente à emporter, menu enfant, un service de restauration ouvert tard le soir, des dessers et bien d'autres dans une ambiance chaleureuse !"
        ],
        "nl": [
          "Ontdek Chicken Food in Noyon. Ze bieden afhaalmaaltijden, kindermenu's, late night catering, desserts en nog veel meer in een warme sfeer!"
        ],
        "es": [
          "Descubra la comida de pollo en Noyon. Ofrecen comida para llevar, menú infantil, catering nocturno, postres y mucho más en un ambiente cálido"
        ]
      },
