  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von den Zubereitungen der Küchenchefin verführen! Machen Sie es sich in unserem renovierten und klimatisierten Saal gemütlich und genießen Sie unsere hausgemachte Küche, die mit frischen und lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Let yourself be tempted by the chef's preparations! Make yourself comfortable in our renovated, air-conditioned dining room and savor our home-cooked cuisine prepared with fresh, local produce."
    ],
    "it": [
      "Lasciatevi tentare dalle preparazioni dello chef! Mettetevi comodi nella nostra sala da pranzo rinnovata e climatizzata e gustate i nostri piatti casalinghi preparati con prodotti freschi e locali."
    ],
    "fr": [
      "Laissez-vous tenter par les préparations de la cheffe ! Installez-vous confortablement dans notre salle rénovée et climatisée pour déguster notre cuisine maison préparée avec des produits frais et locaux."
    ],
    "es": [
      "¡Déjese tentar por las preparaciones del chef! Póngase cómodo en nuestro comedor renovado y climatizado y disfrute de nuestra comida casera preparada con productos frescos de la zona."
    ],
    "nl": [
      "Laat je verleiden door de bereidingen van de chef! Maak het jezelf gemakkelijk in onze gerenoveerde eetzaal met airconditioning en geniet van onze huisgemaakte maaltijden bereid met verse, lokale producten."
    ]
  },
  "rdfs:label": {
