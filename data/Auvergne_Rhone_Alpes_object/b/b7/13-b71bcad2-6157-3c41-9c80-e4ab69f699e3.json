  "rdfs:comment": {
    "de": [
      "Dauerausstellung, die das Alltagsleben in Savoyen von 1850 bis 1950 nachzeichnet.\r\n\r\nTemporäre Ausstellung \" Les vieux jouets\" und botanischer Miniaturgarten über die aromatischen Pflanzen des Johannistages."
    ],
    "en": [
      "The old trades of the Val Gelon of yesteryear: permanent exhibition about daily life in the Savoie from 1850-1950. Numerous objects are on display, including headdresses, clothes, plates, old looms and utensils."
    ],
    "it": [
      "Gli antichi mestieri e il Val Gelon del passato: esposizione permanente che racconta la vita quotidiana nella Savoia tra il 1850 e il 1950. Numerosi oggetti: cuffie, indumenti, stoviglie, utensili..."
    ],
    "fr": [
      "Exposition permanente retraçant la vie quotidienne en Savoie de 1850 à 1950.\r\n\r\nExposition Temporaire \" Les vieux jouets\" et jardin botanique miniature sur les plantes aromatiques de la St Jean."
    ],
    "nl": [
      "Permanente tentoonstelling over het dagelijks leven in de Savoie van 1850 tot 1950.\r\n\r\nTijdelijke tentoonstelling \"Oud speelgoed\" en botanische miniatuurtuin over aromatische planten op Sint-Jansdag."
    ],
    "es": [
      "Exposición permanente sobre la vida cotidiana en Saboya de 1850 a 1950.\r\n\r\nExposición temporal \"Juguetes antiguos\" y jardín botánico en miniatura sobre las plantas aromáticas de San Juan."
    ]
  },
