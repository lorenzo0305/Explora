  "rdfs:comment": {
    "de": [
      "Pizzeria Snack zum Mitnehmen.\r\nNINOU PIZZA bietet diese Pizzas, Paninis, Salate, Boxen, Eis und Getränke das ganze Jahr über zum Mitnehmen an.\r\nBei schönem Wetter Verzehr vor Ort auf der Terrasse.\r\nEis nach italienischer Art im Sommer."
    ],
    "en": [
      "Pizzeria snack to take away.\r\nNINOU PIZZA proposes these pizzas, paninis, salads, boxes, ice creams, drinks to take away all the year.\r\nConsumption on the spot in terrace as of the beautiful days.\r\nItalian ice cream in summer."
    ],
    "it": [
      "Spuntino in pizzeria da portare via.\r\nNINOU PIZZA offre pizze, panini, insalate, scatole, gelati e bevande da asporto tutto l'anno.\r\nConsumo in loco sulla terrazza nella bella stagione.\r\nGelato all'italiana in estate."
    ],
    "fr": [
      "Pizzeria snack à emporter.\r\nNINOU PIZZA  propose ces pizzas, paninis, salades, box, glaces, boissons à emporter toute l'année.\r\nConsommation sur place en terrasse dès les beaux jours.\r\nGlaces à l'italienne l'été."
    ],
    "nl": [
      "Pizzeria snack to go.\r\nNINOU PIZZA biedt het hele jaar door pizza's, panini's, salades, boxen, ijs en drankjes om mee te nemen.\r\nConsumptie ter plaatse op het terras bij mooi weer.\r\nItaliaans ijs in de zomer."
    ],
    "es": [
      "Pizza para llevar.\r\nNINOU PIZZA ofrece sus pizzas, paninis, ensaladas, cajas, helados y bebidas para llevar todo el año.\r\nConsumo in situ en la terraza cuando hace buen tiempo.\r\nHelado a la italiana en verano."
    ]
  },
  "rdfs:label": {
