  "rdfs:comment": {
    "de": [
      "Entstanden aus einer Umschulung, um eine Leidenschaft auszuleben: das Drechseln von Holz. Emmanuel Landais bietet eine handwerkliche Arbeit zur Herstellung von Gebrauchs-, Dekorations- und Spielgegenständen mit umweltfreundlichen Endbearbeitungen an, die hauptsächlich aus Holz aus der Chartreuse hergestellt werden."
    ],
    "en": [
      "Born from a reconversion to live a passion: woodturning. Emmanuel Landais proposes a craft work of creation of utilitarian, decorative, playful objects with ecological finishes and made of wood mainly from the Chartreuse."
    ],
    "it": [
      "Nasce da una riconversione per vivere una passione: la tornitura del legno. Emmanuel Landais propone un lavoro artigianale di creazione di oggetti utilitari, decorativi e ludici con finiture ecologiche e realizzati in legno proveniente principalmente dalla Chartreuse."
    ],
    "fr": [
      "Né d’une reconversion pour vivre une passion : le tournage sur bois. Emmanuel Landais propose un travail artisanal de création d’objets utilitaires, décoratifs, ludiques aux finitions écologiques et réalisés en bois principalement issu de la Chartreuse."
    ],
    "es": [
      "Nace de una reconversión para vivir una pasión: el torneado de madera. Emmanuel Landais propone un trabajo artesanal de creación de objetos utilitarios, decorativos, lúdicos, con acabados ecológicos y realizados en madera principalmente de la Chartreuse."
    ],
    "nl": [
      "Geboren uit een omschakeling naar een passie: houtdraaien. Emmanuel Landais stelt een ambachtelijke creatie voor van utilitaire, decoratieve, speelse voorwerpen met ecologische afwerkingen en gemaakt van hout voornamelijk uit de Chartreuse."
    ]
  },
  "rdfs:label": {
