  "rdfs:comment": {
    "de": [
      "SPEZIELLES ANGEBOT FÜR KURGÄSTE!\r\nNehmen Sie die Herausforderung des Alpengiganten an! : Col de La Loze Challenge für die 7. Ausgabe des Cyclosportive.\r\nNehmen Sie kostenlos an der 30 km langen Strecke teil und leihen Sie sich ein VAE-Fahrrad aus, um Sie während der Strecke zu unterstützen."
    ],
    "en": [
      "CURISTE SPECIAL OFFER!\r\nTake up the challenge of the giant of the Alps! take on the Col de La Loze Challenge for the 7th edition of the Cyclosportive.\r\nTake part in the 30 km course free of charge and benefit from the loan of a VAE bike to assist you along the way."
    ],
    "it": [
      "OFFERTA SPECIALE PER I CURISTI!\r\nAccettate la sfida del gigante delle Alpi! affrontate la sfida del Col de La Loze per la 7ª edizione della Ciclosportiva.\r\nPartecipate gratuitamente al percorso di 30 km e beneficiate del prestito di una bicicletta VAE per assistervi durante il percorso."
    ],
    "fr": [
      "OFFRE SPECIALE CURISTE !\r\nRelevez le défi du géant des Alpes ! : Col de La Loze Challenge  pour la 7ème édition de la Cyclosportive.\r\nParticipez au parcours 30 km gratuitement et bénéficiez du prêt d'un vélo VAE pour vous assister pendant le parcours."
    ],
    "es": [
      "¡OFERTA ESPECIAL CURIST!\r\n¡Acepta el reto del gigante de los Alpes! acepte el reto del Col de La Loze en la 7ª edición de la Ciclosportiva.\r\nParticipe gratuitamente en el recorrido de 30 km y benefíciese del préstamo de una bicicleta VAE para ayudarle durante el recorrido."
    ],
    "nl": [
      "SPECIALE CURISTENAANBIEDING!\r\nGa de uitdaging aan van de reus van de Alpen! ga de Col de La Loze Challenge aan voor de 7e editie van de Cyclosportive.\r\nNeem gratis deel aan het parcours van 30 km en leen een VAE-fiets om je te helpen tijdens het parcours."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Col de la Loze Challenge  - OFFRE CURISTE - 30 km"
    ]
  },
