  "rdfs:comment": {
    "de": [
      "Das Office de Tourisme de Chambéry, das heute zu Grand Chambéry Alpes Tourisme gehört, besteht seit 1896 und war eines der ersten in Frankreich, das gegründet wurde. Zögern Sie nicht, von seiner langjährigen Erfahrung und seinen Dienstleistungen zu profitieren."
    ],
    "en": [
      "Today included in Greater Chambéry Alps Tourism, Chambéry Tourist Information Center exists since 1896 and was one of the first created in France. Do not hesitate to take advantage of its long experience and its services."
    ],
    "it": [
      "Oggi incluso in Grande Chambéry Alpi Tourismo, l'Ufficio del Turismo di Chambéry esiste dal 1896 ed è stato uno dei primi creati in Francia. Non esitate a trarre vantaggio dalla sua lunga esperienza e dai suoi servizi."
    ],
    "fr": [
      "Aujourd'hui inclus dans Grand Chambéry Alpes Tourisme, l'Office de Tourisme de Chambéry existe depuis 1896 et a été l’un des premiers créés en France. N'hésitez pas à profiter de sa longue expérience et de ses services."
    ],
    "es": [
      "La Oficina de Turismo de Chambéry, que ahora forma parte de Grand Chambéry Alpes Tourisme, existe desde 1896 y fue una de las primeras que se crearon en Francia. No dude en aprovechar su larga experiencia y sus servicios."
    ],
    "nl": [
      "Het toeristenbureau van Chambéry, dat nu deel uitmaakt van Grand Chambéry Alpes Tourisme, bestaat sinds 1896 en was een van de eerste in Frankrijk. Aarzel niet om te profiteren van zijn lange ervaring en diensten."
    ]
  },
