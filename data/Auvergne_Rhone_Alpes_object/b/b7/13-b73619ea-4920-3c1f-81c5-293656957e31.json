  "rdfs:comment": {
    "de": [
      "Das Team bietet eine traditionelle Küche, in der frische und lokale Produkte bevorzugt werden, um den Geschmack zu respektieren. Raum, der für Schulungen und Seminare genutzt werden kann."
    ],
    "en": [
      "Traditional cuisine, using fresh and local produce, respecting flavours. Dining room can host training sessions and meetings."
    ],
    "it": [
      "Il team offre una cucina tradizionale, utilizzando prodotti freschi e locali e rispettando i sapori. Sala disponibile per corsi di formazione e seminari."
    ],
    "fr": [
      "L'équipe propose une cuisine traditionnelle, favorisant les produits frais et locaux, dans le respect des saveurs. Salle pouvant accueillir les formations et les séminaires."
    ],
    "nl": [
      "Het team biedt een traditionele keuken met verse, lokale producten en respect voor smaken. Ruimte beschikbaar voor trainingen en seminars."
    ],
    "es": [
      "El equipo ofrece cocina tradicional, utilizando productos frescos y locales y respetando los sabores. Sala disponible para cursos de formación y seminarios."
    ]
  },
