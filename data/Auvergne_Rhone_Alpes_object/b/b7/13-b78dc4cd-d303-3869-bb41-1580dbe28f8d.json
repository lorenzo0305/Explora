  "rdfs:comment": {
    "de": [
      "Das Restaurant La Corderie bietet Ihnen eine traditionelle und geschmackvolle Küche. Genießen Sie an schönen Tagen die zur Natur hin offene Terrasse. Unser gemütlicher und moderner Saal wird Sie angenehm empfangen."
    ],
    "en": [
      "La Corderie restaurant offers traditional, tasteful cuisine. On sunny days, enjoy its terrace overlooking the countryside. Our warm and modern dining room will welcome you in the best possible conditions."
    ],
    "it": [
      "Il ristorante La Corderie offre una cucina tradizionale e di gusto. Quando il tempo è bello, approfittate della nostra terrazza con vista sulla campagna. La nostra sala da pranzo, calda e moderna, vi accoglierà nelle migliori condizioni."
    ],
    "fr": [
      "Le restaurant La Corderie vous propose une cuisine de tradition et de bon goût. Profitez aux beaux jours de sa terrasse ouverte sur la nature. Notre salle chaleureuse et moderne saura agréablement vous recevoir dans les meilleures conditions."
    ],
    "nl": [
      "Restaurant La Corderie biedt een traditionele, smaakvolle keuken. Geniet bij mooi weer van ons terras met uitzicht op het platteland. Onze warme, moderne eetzaal verwelkomt je in de beste omstandigheden."
    ],
    "es": [
      "El restaurante La Corderie ofrece una cocina tradicional y sabrosa. Cuando hace buen tiempo, aproveche nuestra terraza con vistas al campo. Nuestro comedor, cálido y moderno, le acogerá en las mejores condiciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Corderie"
    ]
  },
