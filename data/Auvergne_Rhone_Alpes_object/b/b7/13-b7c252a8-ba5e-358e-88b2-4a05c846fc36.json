  "rdfs:comment": {
    "de": [
      "Tarentaise Tours bietet Ihnen Outdoor-Aktivitäten, Reisen und Abenteuer im Winter - Sommer in den Alpen und an den schönsten Orten der Welt. Begleitet werden Sie von UIAGM-zertifizierten Experten, die Ihnen neue Momente mit einem Adrenalinschub bescheren werden."
    ],
    "en": [
      "Tarentaise Tours offers you outdoor activities, travel and adventure in winter and summer in the Alps and the most beautiful places in the world. Accompanied by UIAGM certified experts, they will make you live original moments on a background of adrenaline and nature."
    ],
    "it": [
      "Tarentaise Tours propone attività all'aria aperta invernali ed estive, viaggi e avventure nelle Alpi e nei luoghi più belli del mondo. Accompagnati da esperti certificati UIAGM, vivrete un'esperienza adrenalinica unica."
    ],
    "fr": [
      "Tarentaise Tours vous propose des activités outdoor, voyages et aventures hiver - été dans les Alpes et les plus beaux endroits du monde. Accompagnés par des experts certifiés UIAGM, ils vous feront vivre des moments inédits sur fond d'adrénaline."
    ],
    "es": [
      "Tarentaise Tours ofrece actividades al aire libre de invierno y verano, viajes y aventuras en los Alpes y en los lugares más bellos del mundo. Acompañado por expertos certificados por la UIAGM, disfrutarás de una experiencia única cargada de adrenalina."
    ],
    "nl": [
      "Tarentaise Tours biedt u outdoor activiteiten, reizen en avontuur in winter en zomer in de Alpen en de mooiste plaatsen ter wereld. Onder begeleiding van door UIAGM gecertificeerde deskundigen zullen zij u originele momenten laten beleven op een achtergrond van adrenaline en natuur."
    ]
  },
