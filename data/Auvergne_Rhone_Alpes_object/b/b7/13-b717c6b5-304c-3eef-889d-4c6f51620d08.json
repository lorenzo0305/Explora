  "rdfs:comment": {
    "de": [
      "Ein angenehmer Ort in Vizille, um auf der Terrasse im ruhigen Hinterhof zu essen.\r\nPizzas vor Ort oder zum Mitnehmen: Wählen Sie Ihre Pizzagröße für kleinen, mittleren oder großen Appetit, Menü auf der Schiefertafel."
    ],
    "en": [
      "A pleasant place in Vizille to eat on the terrace overlooking the backyard, in a quiet setting.\r\nPizzas to eat in or take away: choose your pizza size for small, medium or large appetites, menu by the slate."
    ],
    "it": [
      "Un luogo piacevole a Vizille per mangiare sulla terrazza nel cortile, in un posto tranquillo.\r\nPizze sul posto o da asporto: scegliete il formato della pizza per piccoli, medi o grandi appetiti, menù alla lavagna."
    ],
    "fr": [
      "Un lieu agréable à Vizille pour manger en terrasse sur arrière cour, au calme.\r\nPizzas sur place ou à emporter : choisissez votre taille de pizza pour petit, moyen ou gros appétit, menu à l'ardoise."
    ],
    "es": [
      "Un lugar agradable en Vizille para comer en la terraza con vistas al patio, en un entorno tranquilo.\r\nPizzas para comer o para llevar: elija su tamaño de pizza para pequeños, medianos o grandes apetitos, menú por pizarra."
    ],
    "nl": [
      "Een aangename plek in Vizille om te eten op het terras in de achtertuin, op een rustige plek.\r\nPizza's ter plaatse of om mee te nemen: kies uw formaat pizza voor kleine, middelgrote of grote trek, menu op de lei."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Cardinal"
    ],
    "fr": [
      "Le Cardinal"
    ]
  },
