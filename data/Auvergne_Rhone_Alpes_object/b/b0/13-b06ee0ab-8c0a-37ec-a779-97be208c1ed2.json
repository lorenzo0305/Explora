  "rdfs:comment": {
    "de": [
      "Spezialisten für Reitkurse von 1 bis 10 Tagen und Tagesausflüge mit Baden im Chassezac. Spaziergänge mit Ponys. Reitkurse von 2-3 Stunden oder ganztätig. Sportreiten-Dressur-Hindernisse."
    ],
    "en": [
      "Specialists in riding courses from 1 to 10 days and day treks with swimming in the Chassezac (1hr/2hr/1 day). Pony rides. Riding lessons from 2 to 3 hours or all day. Sports riding - dressage - obstacles - cross-country"
    ],
    "it": [
      "Specializzato in corsi di equitazione da 1 a 10 giorni e passeggiate di un giorno con bagno nello Chassezac (1h - 2h - 1 giorno). Cavalcate su pony. Corsi di equitazione di 2h, 3h o giornata intera. Equitazione sportiva - dressage - salto - cross-country"
    ],
    "fr": [
      "Spécialiste du stage d'équitation de 1 à 10 jours et de la randonnée journée avec baignade dans le Chassezac (1h - 2h - 1 jour). Balades à poneys. Stages d'équitation de 2h, 3 h ou à la journée complète. Équitation sportive - dressage - obstacles - cross"
    ],
    "nl": [
      "Specialist in rijstages van 1 tot 10 dagen en dagtochten te paard met zwempartijen in de Chassezac-rivier. Tochten van 1 of 2 uur en 1 dag; rijstages van 2 tot 3 uur of hele dag. Sportief rijden, dressuur rijden, hindernissenparcours, paardenrennen."
    ],
    "es": [
      "Especialista en cursos de equitación de 1 a 10 días y paseos de un día con baño en el Chassezac (1h - 2h - 1 día). Paseos en poni. Cursos de equitación de 2h, 3h o jornada completa. Equitación deportiva - doma - salto - campo a través"
    ]
  },
