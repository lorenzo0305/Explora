  "rdfs:comment": {
    "de": [
      "Liebevoll verzierte, hausgemachte Küche aus lokalen Zutaten, köstliche und lebendige Weine aus der Region und hübsch kitschige Zimmer."
    ],
    "en": [
      "Lovingly decorated home cooking made with local ingredients, delicious and lively local wines, and beautifully kitsch rooms."
    ],
    "it": [
      "Cucina casalinga preparata con amore e con ingredienti locali, vini locali deliziosi e vivaci e camere splendidamente kitsch."
    ],
    "fr": [
      "Une cuisine maison ornée d'amour et élaborée avec des ingrédients locaux, des vins de terroir délicieux et vivants, et des chambres joliment kitsch."
    ],
    "nl": [
      "Liefdevol bereide thuiskeuken met lokale ingrediënten, heerlijke en levendige lokale wijnen en prachtige kitscherige kamers."
    ],
    "es": [
      "Cocina casera preparada con cariño con ingredientes locales, deliciosos y animados vinos de la tierra y preciosas habitaciones kitsch."
    ]
  },
