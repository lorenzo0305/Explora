  "rdfs:comment": {
    "de": [
      "Restaurant, Bar, Pizzeria, im oberen Teil des Ortes, sonnige Terrasse mit Blick auf die Pisten am Straßenrand.\r\nFamiliäre, herzliche Atmosphäre, 7 Tage die Woche, savoyische Gerichte, Burger, Pizzas, Eis, Crêpes, Waffeln, vor Ort oder zum Mitnehmen."
    ],
    "en": [
      "Restaurant, bar, pizzeria, at the top of the resort, with a sunny terrace overlooking the slopes on the roadside.\r\nFamily atmosphere, welcoming, 7 days a week, Savoyard dishes, burgers, pizzas, ice creams, pancakes, waffles, to eat in or to take away."
    ],
    "it": [
      "Ristorante, bar, pizzeria, nella parte alta della stazione, terrazza soleggiata con vista sulle piste a bordo strada.\r\nAtmosfera calda e familiare, 7 giorni su 7, piatti savoiardi, hamburger, pizze, gelati, crêpes, waffles, da mangiare o da portare via."
    ],
    "fr": [
      "Restaurant, bar, pizzeria, haut de station, terrasse ensoleillée vue sur les pistes en bordure de route.\r\nAmbiance familiale, chaleureuse, 7J/7, plats savoyards, burgers, pizzas, glaces, crêpes, gaufres, sur place ou à emporter."
    ],
    "es": [
      "Restaurante, bar, pizzería, en la cima de la estación, terraza soleada con vistas a las pistas al borde de la carretera.\r\nAmbiente cálido y familiar, 7 días a la semana, platos saboyanos, hamburguesas, pizzas, helados, crepes, gofres, para comer o llevar."
    ],
    "nl": [
      "Restaurant, café, pizzeria, bovenin het skioord, zonnig terras met uitzicht op de pistes aan de kant van de weg.\r\nFamiliale sfeer, knus, 7 dagen per week, Savoyaardse gerechten, hamburgers, pizza's, ijsjes, pannenkoeken, wafels, ter plaatse of om mee te nemen."
    ]
  },
