  "rdfs:comment": {
    "de": [
      "Ausgabe werden 8 Orchester ein ganzes Wochenende lang in allen Ecken des Club-Resorts ausschließlich traditionellen Jazz spielen.\r\nEin Galaabend im Saal Mageva - Palais wird das Festival mit einem talentierten Orchester und der anschließenden Preisverleihung beenden."
    ],
    "en": [
      "For the 30th edition, eight orchestras will play exclusively traditional jazz throughout the village during a festive weekend.\r\nA gala evening at the Mageva Hall in the Palais will close the festival with a performance by a talented orchestra, followed by the awards ceremony."
    ],
    "it": [
      "Per la 30a edizione, 8 orchestre suoneranno esclusivamente jazz tradizionale in tutto il villaggio durante un intero weekend di festa.\r\nUna serata di gala, nella sala Mageva - Palais, chiuderà il festival con un'orchestra di talento, seguita dalla cerimonia di premiazione."
    ],
    "fr": [
      "Pour la 30è édition, 8 orchestres joueront exclusivement du Jazz traditionnel aux 4 coins du  Village durant tout un week-end festif.\r\nUne soirée de gala, salle Mageva - Palais, clôturera ce festival avec 1 orchestre talentueux suivi de la remise des prix."
    ],
    "nl": [
      "Voor de 30e editie spelen 8 orkesten uitsluitend traditionele Jazz in de 4 hoeken van het Dorp gedurende een heel feestelijk weekend.\r\nEen gala-avond in de Salle Mageva - Palais zal het festival afsluiten met 1 getalenteerde band, gevolgd door de prijsuitreiking."
    ],
    "es": [
      "En su 30ª edición, 8 orquestas tocarán exclusivamente Jazz tradicional en los 4 rincones de la Villa durante todo un fin de semana festivo.\r\nUna velada de gala en la Salle Mageva - Palais clausurará el festival con 1 orquesta de talento, seguida de la ceremonia de entrega de premios."
    ]
  },
  "rdfs:label": {
    "en": [
      "Megève Jazz Contest"
    ],
    "it": [
      "Megève Jazz Contest"
    ],
    "fr": [
      "30ème Megève Jazz Contest"
    ]
  },
