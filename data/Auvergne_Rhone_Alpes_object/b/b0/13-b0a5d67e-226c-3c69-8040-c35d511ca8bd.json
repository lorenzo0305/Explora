  "rdfs:comment": {
    "de": [
      "Mikrobrauerei mit Gastronomie - Herstellung von handwerklich hergestelltem Bier. Die Speisekarte wechselt jede Saison und bietet viele Optionen für neugierige Vegetarier und Nicht-Vegetarier."
    ],
    "en": [
      "Beers brewed on house, great food whether you are a veggie, a vegan or a meat eater. No beer list here as it changes all the time."
    ],
    "it": [
      "Microbirrificio con ristorazione - Produzione di birra artigianale. Il menu cambia ogni stagione e offre molte opzioni per vegetariani e curiosi non vegetariani."
    ],
    "fr": [
      "Micro-brasserie avec restauration - Fabrication de bière artisanales. Le menu change chaque saison et offre de nombreuses options pour les végétariens et non végétariens curieux."
    ],
    "es": [
      "Microcervecería con catering - Producción de cerveza artesanal. El menú cambia cada temporada y ofrece muchas opciones para vegetarianos y curiosos no vegetarianos."
    ],
    "nl": [
      "Microbrouwerij met restaurant - Productie van ambachtelijk bier. Het menu verandert elk seizoen en biedt veel opties voor vegetariërs en nieuwsgierige niet-vegetariërs."
    ]
