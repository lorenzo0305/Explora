  "rdfs:comment": {
    "de": [
      "La Chaumière liegt in der Nähe des Sees und des Kletterfelsens Les Gaillands und nur wenige Gehminuten von der Haupteinkaufsstraße im Stadtzentrum von Chamonix entfernt."
    ],
    "en": [
      "La Chaumière is located near the lake and the Gaillands climbing rock and only a few minutes walk from the main shopping street in downtown Chamonix."
    ],
    "it": [
      "La Chaumière si trova vicino al lago e alla palestra di roccia Gaillands e a pochi minuti a piedi dalla principale via dello shopping del centro di Chamonix."
    ],
    "fr": [
      "La Chaumière se situe près du lac et du rocher d'escalade des Gaillands et seulement à quelques minutes de marche de la principale rue commerçante du centre ville de Chamonix."
    ],
    "nl": [
      "La Chaumière ligt vlakbij het meer en de Gaillands klimrots en op slechts enkele minuten lopen van de belangrijkste winkelstraat in het centrum van Chamonix."
    ],
    "es": [
      "La Chaumière está situada cerca del lago y de la roca de escalada de Gaillands y a pocos minutos a pie de la principal calle comercial del centro de Chamonix."
    ]
  },
