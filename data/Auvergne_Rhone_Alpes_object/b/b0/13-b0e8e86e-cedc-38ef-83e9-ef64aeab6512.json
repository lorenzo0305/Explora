  "rdfs:comment": {
    "de": [
      "Starten Sie vom Plan d'eau du Mas aus zu einer 70 km langen Van-Tour, um das Livradois zu entdecken!\r\nAuf dieser Strecke können Sie einige Nuggets des Pays d'Issoire entdecken."
    ],
    "en": [
      "From the Plan d'eau du Mas, embark on a 70km van tour to discover the Livradois!\r\nThis tour will allow you to discover some of the nuggets of the Pays d'Issoire."
    ],
    "it": [
      "Partendo dal Plan d'eau du Mas, partite per un tour in furgone di 70 km alla scoperta del Livradois!\r\nQuesto itinerario vi permetterà di scoprire alcune delle gemme della regione dell'Issoire."
    ],
    "fr": [
      "Au départ du Plan d'eau du Mas, embarquez pour un circuit van de 70km à la découverte du Livradois !\r\nCe parcours vous permettra de découvrir certaines pépites du Pays d'Issoire."
    ],
    "nl": [
      "Vanuit het Plan d'eau du Mas vertrekt u voor een tocht van 70 km met een busje om de Livradois te ontdekken!\r\nDeze route zal u toelaten enkele van de pareltjes van de Issoire streek te ontdekken."
    ],
    "es": [
      "Partiendo del Plan d'eau du Mas, embárquese en un recorrido de 70 km en furgoneta para descubrir los Livradois\r\nEsta ruta le permitirá descubrir algunas de las pepitas de la región de Issoire."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Circuit van - A la découverte du Livradois"
    ]
  },
