  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e02ee51f-fa17-3b4d-83c8-f6a89eea769a",
      "dc:description": {
        "de": [
          "Jahrhundert mit unsignierten Glasfenstern aus dem Jahr 1930, die das Sacré-Coeur, die Jungfrau Maria und den Heiligen Josef darstellen. Die Kirche besitzt außerdem ein bedeutendes Statuarium."
        ],
        "en": [
          "Located on the heights of the village, the church of neo-gothic style, dates from the XIXth with unsigned stained glasses of 1930 approximately, representing, the Sacred Heart, the Virgin and Saint-Joseph. It also has an important statuary."
        ],
        "it": [
          "Situata sulle alture del villaggio, la chiesa neogotica risale al XIX secolo con vetrate non firmate del 1930 circa, che rappresentano il Sacro Cuore, la Vergine e San Giuseppe. Ha anche un'importante statuaria."
        ],
        "fr": [
          "Située sur les hauteurs du village, l’église de style néo-gothique, date du XIXe avec des verrières non signées de 1930 environ, représentant, le Sacré-Coeur, la Vierge et Saint-Joseph. Elle possède aussi un important statuaire."
        ],
        "es": [
          "Situada en las alturas del pueblo, la iglesia neogótica data del siglo XIX con vidrieras sin firmar de alrededor de 1930, que representan el Sagrado Corazón, la Virgen y San José. También cuenta con una importante estatuaria."
        ],
        "nl": [
          "De neogotische kerk, gelegen op de hoogten van het dorp, dateert uit de 19e eeuw met ongesigneerde gebrandschilderde ramen van rond 1930, die het Heilig Hart, de Maagd en Sint-Jozef voorstellen. Het heeft ook een belangrijk standbeeld."
        ]
      },
