  "rdfs:comment": {
    "de": [
      "Ungewöhnlich! Besuchen Sie die aktuelle Baustelle der Mediathek Simone-de-Beauvoir und erfahren Sie mehr über die Gestaltung der Isère-Ufer im Laufe der Geschichte.\r\nBesichtigung in Zusammenarbeit mit dem Réseau de lecture publique de Valence Romans Agglo."
    ],
    "en": [
      "Unusual! Visit the current construction site of the Simone-de-Beauvoir multimedia library and discover the historical development of the banks of the Isère.\r\nVisit in collaboration with the Valence Romans Agglo public reading network."
    ],
    "it": [
      "L'insolito! Visitate il cantiere della biblioteca multimediale Simone-de-Beauvoir e scoprite come sono cambiate le rive dell'Isère nel corso della storia.\r\nVisita in collaborazione con la rete di lettura pubblica Valence Romans Agglo."
    ],
    "fr": [
      "Insolite ! Visitez le chantier en cours de la médiathèque Simone-de-Beauvoir et découvrez les aménagements des berges de l’Isère au fil de l’histoire.\r\nVisite en collaboration avec le Réseau de lecture publique de Valence Romans Agglo."
    ],
    "es": [
      "Lo insólito Recorra las obras de la biblioteca multimedia Simone-de-Beauvoir y descubra cómo han cambiado las orillas del Isère a lo largo de la historia.\r\nVisita en colaboración con la red de lectura pública Valence Romans Agglo."
    ],
    "nl": [
      "Het ongewone! Maak een rondleiding door de mediatheek Simone-de-Beauvoir en ontdek hoe de oevers van de Isère in de loop van de geschiedenis zijn veranderd.\r\nBezoek in samenwerking met het openbare leesnetwerk Valence Romans Agglo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite Guidée : Insolite, Attention travaux !"
    ]
  },
