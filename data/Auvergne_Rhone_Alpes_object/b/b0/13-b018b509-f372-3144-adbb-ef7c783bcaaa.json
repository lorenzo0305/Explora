  "rdfs:comment": {
    "de": [
      "Zu Fuß, mit dem Fahrrad oder mit Schneeschuhen, Wanderungen in den Bergen, um unsere Bergmassive und ihre Umgebung zu entdecken (Flora, Fauna, Geologie, Geographie, menschliche Aktivitäten, Kulturerbe...)"
    ],
    "en": [
      "On foot, by bike or with snowshoes, discover our mountains and their environment (flora, fauna, geology, geography, human activities, heritage...)."
    ],
    "it": [
      "A piedi, in bicicletta o con le racchette da neve, scoprite le nostre montagne e il loro ambiente (flora, fauna, geologia, geografia, attività umane, patrimonio...)."
    ],
    "fr": [
      "A pied, en vélo ou en raquette, randonnée en montagne pour partir à la découverte de nos massifs et de sont environnement (la flore, la faune, la géologie, la géographie, activités humaine, patrimoine…)"
    ],
    "nl": [
      "Ontdek te voet, op de fiets of op sneeuwschoenen onze bergen en hun omgeving (flora, fauna, geologie, geografie, menselijke activiteiten, erfgoed...)."
    ],
    "es": [
      "A pie, en bicicleta o con raquetas de nieve, excursiones de montaña para descubrir nuestras montañas y su entorno (flora, fauna, geología, geografía, actividades humanas, patrimonio...)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Aravis VTT - Mountain biking and activities school"
    ],
    "it": [
      "Aravis VTT - Scuola di ciclismo e attività in montagna"
    ],
    "fr": [
      "Aravis VTT - Ecole Vélo et activités de montagne"
    ],
    "nl": [
      "Aravis VTT - Mountainbike en activiteiten school"
    ]
  },
