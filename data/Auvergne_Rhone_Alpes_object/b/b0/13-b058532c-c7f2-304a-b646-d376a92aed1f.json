  "rdfs:comment": {
    "de": [
      "Die Bar/Restaurant bietet Gegrilltes, Rindertartar, Forelle Müllerin Art, gemischte Salate & Wurstplatten, Eis, Waffeln und Crêpes. Es ist auch ein einzigartiger Ort für Ihre Veranstaltungen: Hochzeiten, Taufen, Geburtstage und andere...."
    ],
    "en": [
      "The bar/restaurant offers grilled meats, beef tartare, trout meunière, mixed salads & charcuterie boards, ice creams, waffles and crêpes. It's also a unique venue for your events: weddings, christenings, birthdays and more...."
    ],
    "it": [
      "Il bar/ristorante serve carni alla griglia, tartare di manzo, meunière di trota, insalate miste e taglieri di salumi, gelati, waffle e crêpes. È anche un luogo unico per i vostri eventi: matrimoni, battesimi, compleanni e altro ancora...."
    ],
    "fr": [
      "Le bar/restaurant propose des grillades, tartare de bœuf, truite meunière, salades composées & planches de charcuterie, glaces, gaufres et crêpes. C'est aussi un lieu unique pour vos événements : mariages, baptême, anniversaire et autres...."
    ],
    "es": [
      "El bar-restaurante sirve carnes a la parrilla, tartar de ternera, trucha a la meunière, ensaladas mixtas y tablas de embutidos, helados, gofres y crepes. También es un lugar único para sus eventos: bodas, bautizos, cumpleaños, etc. ...."
    ],
    "nl": [
      "De bar/restaurant serveert gegrild vlees, tartaar van rundvlees, meunière van forel, gemengde salades en vleeswarenplankjes, ijs, wafels en crêpes. Het is ook een unieke locatie voor uw evenementen: bruiloften, doopfeesten, verjaardagen en meer ...."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Etang du Repos | Bar - Restaurant - Lieu événementiel"
    ]
  },
