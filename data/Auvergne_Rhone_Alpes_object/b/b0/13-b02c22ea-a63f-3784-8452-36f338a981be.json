  "rdfs:comment": {
    "de": [
      "Der Ch?ur Régional d'Auvergne präsentiert Händels Messias (Teil I & II): ~50 Choristen, das Orchester Les Passions de Montauban, 4 Solisten und der Dirigent Blaise Plumettaz vereint für ~2 Stunden Barockmusik!"
    ],
    "en": [
      "The Ch?ur Régional d'Auvergne presents Handel's Messiah (parts I & II): ~50 choristers, the orchestra Les Passions de Montauban, 4 soloists and conductor Blaise Plumettaz join forces for ~2h of Baroque music!"
    ],
    "it": [
      "Il Ch?ur Régional d'Auvergne presenta il Messiah di Handel (parti I e II): ~50 coristi, l'orchestra Les Passions de Montauban, 4 solisti e il direttore Blaise Plumettaz si riuniscono per ~2 ore di musica barocca!"
    ],
    "fr": [
      "Le Chœur Régional d'Auvergne présente le Messie de Haendel (parties I & II) : ~50 choristes, l'orchestre Les Passions de Montauban, 4 solistes et le chef Blaise Plumettaz réunis pour ~2h de musique baroque !"
    ],
    "es": [
      "La Ch?ur Régional d'Auvergne presenta El Mesías de Haendel (partes I y II): unos 50 coristas, la orquesta Les Passions de Montauban, 4 solistas y el director Blaise Plumettaz se reúnen durante unas 2 horas de música barroca"
    ],
    "nl": [
      "Het Ch?ur Régional d'Auvergne presenteert de Messiah van Händel (deel I & II): ~50 koorleden, het orkest Les Passions de Montauban, 4 solisten en dirigent Blaise Plumettaz komen samen voor ~2 uur barokmuziek!"
    ]
  },
  "rdfs:label": {
