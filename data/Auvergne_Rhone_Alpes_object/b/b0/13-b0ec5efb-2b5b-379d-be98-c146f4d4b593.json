  "rdfs:comment": {
    "de": [
      "Das verführerische Langley Hotel Gustavia liegt direkt neben dem Bahnhof. Das Hotel strahlt ein Gefühl von Bergsteigen gemischt mit modernem Dekor aus. Dieses Hotel hat seit den 1890er Jahren Reisende beherbergt und wir freuen uns, diese Tradition fortzusetzen."
    ],
    "en": [
      "The attractive Langley Hotel Gustavia is located right next to the train station. The hotel has an alpine feel mixed with modern decor. This hotel has welcomed travelers since the 1890's and we are happy to continue this tradition."
    ],
    "it": [
      "L'attraente Langley Hotel Gustavia si trova proprio accanto alla stazione ferroviaria. L'hotel ha un'atmosfera alpina mescolata a un arredamento moderno. Questo hotel ha accolto i viaggiatori fin dal 1890 e siamo felici di continuare questa tradizione."
    ],
    "fr": [
      "Le séduisant Langley Hotel Gustavia est situé juste à côté de la gare. L’hôtel dégage une sensation d’alpinisme mélangé à un décor moderne. Cet hôtel a accueilli voyageurs depuis les années 1890 et nous sommes heureux de perpétuer cette tradition."
    ],
    "nl": [
      "Het aantrekkelijke Langley Hotel Gustavia ligt direct naast het treinstation. Het hotel heeft een alpine uitstraling gemengd met een moderne inrichting. Dit hotel verwelkomt reizigers al sinds de jaren 1890 en wij zetten deze traditie graag voort."
    ],
    "es": [
      "El atractivo Langley Hotel Gustavia está situado justo al lado de la estación de tren. El hotel tiene un aire alpino mezclado con una decoración moderna. Este hotel ha dado la bienvenida a los viajeros desde la década de 1890 y nos complace continuar con esta tradición."
    ]
  },
