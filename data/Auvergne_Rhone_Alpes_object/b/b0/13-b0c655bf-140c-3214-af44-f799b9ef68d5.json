  "rdfs:comment": {
    "de": [
      "Das Team der Bibliothek von La Côte d'Aime bietet dem Publikum ein breites Spektrum an Lektüre. Ob Erwachsene oder Kinder, für jeden Geschmack ist etwas dabei!"
    ],
    "en": [
      "The team from La Côte d'Aime library offers a wide range of reading. There is something for everyone - children and adults!"
    ],
    "it": [
      "Il team della biblioteca di La Côte d'Aime offre un'ampia gamma di materiale di lettura. Che siate adulti o bambini, ce n'è per tutti i gusti!"
    ],
    "fr": [
      "L'équipe de la bibliothèque de La Côte d'Aime offre au public un large panel de lectures. Que l'on soit adulte ou enfant, il y en a pour tous les goûts !"
    ],
    "nl": [
      "Het bibliotheekteam van La Côte d'Aime biedt een breed scala aan leesmateriaal. Of u nu een volwassene of een kind bent, er is voor elk wat wils!"
