  "rdfs:comment": {
    "de": [
      "Dieser schöne See liegt auf 2254 m Höhe in der Nähe des Loze-Passes und bietet ein schönes Panorama über zwei Täler. Hier finden Sie Regenbogenforellen."
    ],
    "en": [
      "A pretty high altitude lake at 2254 metres, close to the Col de la Loze, offering a beautiful panorama over two valleys. You'll find rainbow trout here."
    ],
    "it": [
      "Un bel lago d'alta quota a 2254 metri, vicino al Col de la Loze, che offre un bel panorama su due valli. Qui si trovano le trote iridee."
    ],
    "fr": [
      "Joli lac d'altitude situé à 2254 mètres, proche du col de la Loze, offrant un beau panorama sur deux vallées . Vous y trouverez des truites Arc-en-ciel."
    ],
    "es": [
      "Un bonito lago de altitud a 2254 metros, cerca del Col de la Loze, que ofrece un hermoso panorama sobre dos valles. Aquí encontrará truchas arco iris."
    ],
    "nl": [
      "Een mooi hooggelegen meer op 2254 meter, vlakbij de Col de la Loze, dat een prachtig panorama biedt over twee valleien. Je vindt hier regenboogforel."
    ]
  },
