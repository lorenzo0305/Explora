  "rdfs:comment": {
    "de": [
      "VS Prod freut sich, gemeinsam mit dem Bistrot de Venterol die erste Ausgabe des Spring Brunch zu eröffnen.\r\nEine elegante Mischung aus Musik, Gastronomie und Lebenskunst, um die Ankunft des Frühlings zu feiern"
    ],
    "en": [
      "VS Prod is delighted to join forces with the Bistrot de Venterol to inaugurate the first edition of Spring Brunch.\r\nAn elegant event combining music, gastronomy and the art of living, to celebrate the arrival of spring"
    ],
    "it": [
      "VS Prod è lieta di unire le forze con il Bistrot de Venterol per lanciare il primo Brunch di Primavera.\r\nUn evento elegante che unisce musica, gastronomia e arte di vivere, per celebrare l'arrivo della primavera"
    ],
    "fr": [
      "VS Prod a le plaisir de s’associer au Bistrot de Venterol pour inaugurer la première édition du Spring Brunch,.\r\nUn rendez-vous élégant mêlant musique, gastronomie et art de vivre, pour célébrer l’arrivée du printemps"
    ],
    "es": [
      "VS Prod se complace en unir fuerzas con el Bistrot de Venterol para lanzar el primer Brunch de Primavera.\r\nUn elegante evento que combina música, gastronomía y el arte de vivir, para celebrar la llegada de la primavera"
    ],
    "nl": [
      "VS Prod is verheugd de krachten te bundelen met Bistrot de Venterol om de eerste Lente Brunch te lanceren.\r\nEen elegant evenement dat muziek, gastronomie en levenskunst combineert om de komst van de lente te vieren"
    ]
  },
  "rdfs:label": {
    "fr": [
      "SPRING BRUNCH— Première Édition"
    ]
  },
