  "rdfs:comment": {
    "de": [
      "Eine Route, auf der Sie sich mit den Techniken des Skitourengehens, wie z. B. Umschwüngen, vertraut machen können. Diese Route eignet sich sowohl für gelegentliche Skitourengeher als auch für erfahrene Skitourengeher, die gerne trainieren möchten."
    ],
    "en": [
      "An itinerary that allows you to learn ski touring techniques such as kick turns. Suitable for occasional skiers as well as more experienced ski tourers eager for training."
    ],
    "it": [
      "Questo percorso permette di familiarizzare con le tecniche di scialpinismo, come le conversioni. È adatto sia agli scialpinisti occasionali sia agli sciatori più esperti che vogliono allenarsi."
    ],
    "fr": [
      "Itinéraire permettant de se familiariser avec les techniques de ski de randonnée telles que les conversions. Il conviendra à des skieurs de randonnée occasionnels comme aux plus aguerris avides d'entrainement."
    ],
    "nl": [
      "Parcours om vertrouwd te raken met technieken voor toeringskitochten, zoals conversies. Het is zowel geschikt voor occasionele toeringskitoeristen als voor meer ervaren toerskiërs die willen trainen."
    ],
    "es": [
      "Esta ruta permite familiarizarse con técnicas de esquí de travesía como las conversiones. Es adecuada tanto para esquiadores de travesía ocasionales como para los más experimentados que deseen formarse."
    ]
  },
  "rdfs:label": {
    "de": [
      "Skitourenroute: Montalbert 1600 - Le Fornelet"
    ],
    "en": [
      "Ski touring itinerary: Montalbert 1600 - Le Fornelet"
    ],
    "fr": [
      "Itinéraire de ski de randonnée : Montalbert 1600 - Le Fornelet"
    ],
    "nl": [
      "Skiroute: Montalbert 1600 - Le Fornelet"
    ]
  },
