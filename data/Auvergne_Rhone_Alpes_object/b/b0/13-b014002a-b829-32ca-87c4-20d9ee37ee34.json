  "rdfs:comment": {
    "de": [
      "Ein Kulturverein für die Region, im Dienste aller.\r\nNoonsi productions entwickelt seit 2013 Projekte, die die kulturelle Entstehung im Gebiet der Baronnies provençales und des Mont Ventoux fördern."
    ],
    "en": [
      "A local cultural association serving all.\r\nSince 2013, Noonsi productions has been developing projects to promote the emergence of culture in the Baronnies Provençales and Mont Ventoux regions."
    ],
    "it": [
      "Un'associazione culturale locale, al servizio di tutti.\r\nDal 2013, Noonsi productions sviluppa progetti per promuovere lo sviluppo culturale nelle regioni Baronnies Provençales e Mont Ventoux."
    ],
    "fr": [
      "Une association culturelle de territoire, au service de tous.\r\nNoonsi productions développe depuis 2013 des projets favorisant l’émergence culturelle sur le territoire des Baronnies provençales et du Mont Ventoux."
    ],
    "es": [
      "Una asociación cultural local al servicio de todos.\r\nDesde 2013, Noonsi producciones desarrolla proyectos para promover el desarrollo cultural en las regiones de Baronnies Provençales y Mont Ventoux."
    ],
    "nl": [
      "Een lokale culturele vereniging ten dienste van iedereen.\r\nSinds 2013 ontwikkelt Noonsi productions projecten om opkomende cultuur in de Baronnies Provençales en Mont Ventoux te promoten."
    ]
  },
