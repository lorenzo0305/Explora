  "rdfs:comment": {
    "de": [
      "La Kantina, Dorfkantine durch die assoziative Konservenfabrik \"Le Bateleur\".\r\nJeden Donnerstagmittag von November bis März können Sie hier hausgemachte, lokale und biologische Gerichte genießen.\r\nVorspeise, Hauptgericht und Dessert von 12? bis 15?"
    ],
    "en": [
      "La Kantina, a village canteen run by the \"Le Bateleur\" cannery association.\r\nEvery Thursday at lunchtime from November to March, come enjoy homemade, local, and organic cuisine.\r\nStarter, main course, and dessert from €12 to €15."
    ],
    "it": [
      "La Kantina, una mensa di paese gestita dal conservificio comunitario \"Le Bateleur\".\r\nOgni giovedì a pranzo, da novembre a marzo, venite a gustare cibo casalingo, locale e biologico.\r\nAntipasto-primo piatto-dessert dalle 12 alle 15?"
    ],
    "fr": [
      "La Kantina, cantine de village par la conserverie associative \"Le Bateleur\". \r\nTous les jeudis midi de novembre à mars, venez déguster une cuisine maison, locale et biologique.\r\nEntrée-plat-dessert de 12€ à 15€."
    ],
    "es": [
      "La Kantina, un comedor de pueblo gestionado por la conservera comunitaria \"Le Bateleur\".\r\nTodos los jueves al mediodía, de noviembre a marzo, venga a degustar comida casera, local y ecológica.\r\nEntrante-principio-postre de 12? a 15?"
    ],
    "nl": [
      "La Kantina, een dorpskantine gerund door de gemeenschappelijke conservenfabriek \"Le Bateleur\".\r\nKom van november tot maart elke donderdagmiddag genieten van huisgemaakte, lokale en biologische gerechten.\r\nVoorgerecht-hoofdgerecht-toetje van 12 tot 15 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Kantina"
    ]
  },
