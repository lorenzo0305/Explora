  "rdfs:comment": {
    "de": [
      "Der Geigenbauer Julien Perey hat sich im Zentrum von Roanne niedergelassen und ist auf Quartettinstrumente spezialisiert. Ob Violine, Viola, Cello oder Kontrabass, er bietet Vermietung, Restaurierung, Herstellung oder Verkauf an."
    ],
    "en": [
      "Julien Perey is a luthier based in the center of Roanne, specializing in quartet instruments. Whether for violin, viola, cello or double bass, he offers rental, restoration, manufacture or sale."
    ],
    "it": [
      "Julien Perey è un liutaio con sede nel centro di Roanne, specializzato in strumenti per quartetto. Che si tratti di un violino, di una viola, di un violoncello o di un contrabbasso, egli offre il noleggio, il restauro, la fabbricazione o la vendita."
    ],
    "fr": [
      "Luthier installé dans le centre de Roanne, Julien Perey est spécialiste des instruments du quatuor. Que ce soit pour un violon, alto, violoncelle ou contrebasse, il propose de la location, restauration, fabrication ou vente."
    ],
    "nl": [
      "Julien Perey is een vioolbouwer in het centrum van Roanne, gespecialiseerd in kwartetinstrumenten. Of het nu gaat om een viool, altviool, cello of contrabas, hij biedt verhuur, restauratie, fabricage of verkoop."
    ],
    "es": [
      "Julien Perey es un fabricante de violines afincado en el centro de Roanne, especializado en instrumentos de cuarteto. Ya sea violín, viola, violonchelo o contrabajo, ofrece servicios de alquiler, restauración, fabricación o venta."
    ]
  },
