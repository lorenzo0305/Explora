  "rdfs:comment": {
    "de": [
      "Die Schule Aiguebelette Parapente bietet Ihnen mit staatlich geprüften Lehrern die Möglichkeit, das außergewöhnliche Abenteuer des Gleitschirmfliegens, des zugänglichsten Luftfahrzeugs der Welt, zu entdecken?"
    ],
    "en": [
      "Attempt Icarus' dream of flying in a two-seater rig, for a flight offering panoramic views available for 6+ years of age. The  school offers lessons for beginners or improvers so that you can experience flying with your \"own wings\"."
    ],
    "it": [
      "Con istruttori qualificati, la scuola Aiguebelette Parapente vi farà scoprire la straordinaria avventura del parapendio, l'aereo più accessibile al mondo?"
    ],
    "fr": [
      "Avec des moniteurs diplômés d’État, l'école Aiguebelette Parapente vous fera découvrir l’extraordinaire aventure du parapente, l’aéronef le plus accessible du monde…"
    ],
    "nl": [
      "De Parapente-school Aiguebelette laat u met gediplomeerde instructeurs het buitengewone avontuur van parapente ontdekken, het meest toegankelijke vliegtuig ter wereld?"
    ],
    "es": [
      "Con instructores titulados por el Estado, la escuela Aiguebelette Parapente le hará descubrir la extraordinaria aventura del parapente, el avión más accesible del mundo?"
    ]
  },
