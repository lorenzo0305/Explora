  "rdfs:comment": {
    "de": [
      "Das Atelier Papivole ist eine Werkstatt für handwerkliche Buchbinderei. Edith fertigt individuelle, handgefertigte Einbände an und bietet auch Einführungskurse an, um die Grundfertigkeiten des Buchbindens zu erlernen und zu üben."
    ],
    "en": [
      "L'atelier Papivole is a bookbinding workshop. As well as producing handmade bookbindings, Edith offers courses and workshops."
    ],
    "it": [
      "Il laboratorio di Papivole è una legatoria artigianale. Edith crea rilegature personalizzate e fatte a mano e offre anche corsi introduttivi per scoprire e praticare le tecniche di base della rilegatura."
    ],
    "fr": [
      "L’atelier Papivole est un atelier de reliure artisanale. Edith y réalise des reliures personnalisées, façonnées à la main, et propose également des stages d’initiation pour découvrir et pratiquer les gestes de base de la reliure ."
    ],
    "nl": [
      "Het Papivole atelier is een ambachtelijk boekbindatelier. Edith maakt persoonlijke, handgemaakte boekbanden en biedt ook inleidende cursussen om je de basistechnieken van het boekbinden te laten ontdekken en oefenen."
    ],
    "es": [
      "El taller Papivole es un taller de encuadernación artesanal. Edith crea encuadernaciones personalizadas hechas a mano, y también ofrece cursos de iniciación para descubrir y practicar las técnicas básicas de encuadernación."
    ]
  },
