  "rdfs:comment": {
    "de": [
      "Das Hotel enthält 38 Zimmer mit Bad und WC. Busparkplatz in der Nähe, schneller Zugang zum Stadtzentrum zu Fuß."
    ],
    "en": [
      "The hotel with 38 rooms, each equipped with a bathroom and toilet. Coach parking nearby, with quick pedestrian access to the town center."
    ],
    "it": [
      "L'Hotel contiene 38 camere con bagni e wc. Parcheggio pullman vicino, accesso veloce al centro città a piedi."
    ],
    "fr": [
      "L'hôtel contient 38 chambres avec salle de bains et wc. Parking autocar à proximité, accès rapide au centre ville à pied."
    ],
    "es": [
      "El hotel dispone de 38 habitaciones con baño. Aparcamiento para autocares en las inmediaciones, acceso rápido al centro de la ciudad a pie."
    ],
    "nl": [
      "Drie sterren hotel met 38 kamers voorzien van badkamer en wc. Télévisie, zwembad, fietsgarage. Autobus parking naast het hotel. Op enkele stappen van de stad. De privaat parking is voorzien van laders voor éléktrisch oplaadbare autos."
    ]
