  "rdfs:comment": {
    "de": [
      "Familienfreundliche Menüs, die vor Ort mit frischen, saisonalen Produkten zubereitet werden, die vorzugsweise von lokalen Erzeugern stammen.\r\n\r\nAbends werden verschiedene Pizzasorten sowie Schnellgerichte wie \"Burger, Tartine, Wrap\" angeboten."
    ],
    "en": [
      "Family-style menus prepared on site with fresh, seasonal produce, preferably from local producers.\r\n\r\nIn the evenings, we offer a variety of pizzas, as well as a \"Burger, Tartine, Wrap\" fast-food service."
    ],
    "it": [
      "Menù in stile familiare preparati in loco con prodotti freschi e di stagione, preferibilmente provenienti da produttori locali.\r\n\r\nLa sera vengono proposte diverse varietà di pizze e il fast food \"Burger, Tartine, Wrap\""
    ],
    "fr": [
      "Des menus à l’esprit familial préparés sur place avec des produits frais, de saison et de préférence issus de producteurs locaux.\r\n\r\nSont proposées le soir différentes variétés de pizzas ainsi qu'une restauration rapide \"Burger, Tartine,Wrap\""
    ],
    "nl": [
      "Menu's in familiestijl, ter plaatse bereid met verse seizoensproducten, bij voorkeur van lokale producenten.\r\n\r\ns Avonds is er een verscheidenheid aan pizza's beschikbaar, evenals een fastfoodservice \"Burger, Tartine, Wrap\"."
    ],
    "es": [
      "Menús familiares elaborados in situ con productos frescos y de temporada, preferentemente de productores locales.\r\n\r\nPor la noche, se proponen diferentes variedades de pizzas, así como comida rápida \"Burger, Tartine, Wrap\""
    ]
  },
  "rdfs:label": {
