  "rdfs:comment": {
    "de": [
      "Unter dem Etendard-Gletscher gehören diese beiden natürlichen Seen, die durch kleine Bauwerke erhöht wurden, zu den unumgänglichen Sehenswürdigkeiten in Savoyen."
    ],
    "en": [
      "Under the Etendard glacier, these two natural lakes, heightened by small structures, are among the must-see places in Savoie."
    ],
    "it": [
      "Sotto il ghiacciaio dell'Etendard, questi due laghi naturali, arricchiti da piccole strutture, sono tra i luoghi imperdibili della Savoia."
    ],
    "fr": [
      "Sous le glacier de l'Etendard, ces deux lacs naturels, rehaussés par de petits ouvrages, font partie des incontournables en Savoie."
    ],
    "nl": [
      "Onder de Etendard-gletsjer behoren deze twee natuurlijke meren, versterkt door kleine bouwwerken, tot de niet te missen bezienswaardigheden in de Savoie."
    ],
    "es": [
      "Bajo el glaciar de Etendard, estos dos lagos naturales, realzados por pequeñas estructuras, figuran entre las visitas obligadas de Saboya."
    ]
  },
  "rdfs:label": {
