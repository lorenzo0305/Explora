  "rdfs:comment": {
    "de": [
      "Traditionelle, lokale und authentische Küche. 100% hausgemacht. Maximum an Produkten von Erzeugern. Freitags für alle geöffnet für Couscous. Ansonsten auf Reservierung ( von 6 bis 100 Personen). Hochzeiten, Geburtstage, Abschiedsfeiern..."
    ],
    "en": [
      "Traditional, local and authentic cuisine. 100% homemade. Maximum use of local produce. Open to all on Fridays for couscous. Otherwise, by reservation (6 to 100 people). Weddings, birthdays, farewells..."
    ],
    "it": [
      "Cucina tradizionale, locale e autentica. 100% fatta in casa. Massimo utilizzo di prodotti locali. Aperto a tutti il venerdì per il couscous. Altrimenti su prenotazione (da 6 a 100 persone). Matrimoni, compleanni, addii..."
    ],
    "fr": [
      "Cuisine de tradition, locale et authentique. 100% fait maison. Maximum de produits de producteurs. Ouvert à tous le vendredi pour le couscous. Sinon sur réservation ( de 6 à 100 personnes). Mariage, anniversaire, pot de départ..."
    ],
    "nl": [
      "Traditionele, lokale en authentieke keuken. 100% huisgemaakt. Maximaal gebruik van lokale producten. Open voor iedereen op vrijdag voor couscous. Anders op reservering (van 6 tot 100 personen). Bruiloften, verjaardagen, afscheid..."
    ],
    "es": [
      "Cocina tradicional, local y auténtica. 100% casera. Máximo aprovechamiento de los productos locales. Abierto a todos los viernes para el cuscús. Si no, con reserva previa (de 6 a 100 personas). Bodas, cumpleaños, despedidas..."
    ]
  },
  "rdfs:label": {
