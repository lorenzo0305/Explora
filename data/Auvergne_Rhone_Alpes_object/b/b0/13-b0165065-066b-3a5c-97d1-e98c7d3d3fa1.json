  "rdfs:comment": {
    "de": [
      "Das festliche Restaurant auf 2500 m Höhe in Les Menuires. Erreichbar über den Sessellift Sunny Express oder die Piste \"David Douillet\". Sonnenterrasse, Innenbereich, großzügige Gourmetküche am Mittag und DJ-Sets ab 14 Uhr!"
    ],
    "en": [
      "The festive restaurant at 2500 m altitude in Les Menuires. Accessible from the Sunny Express chairlift or the “David Douillet” slope. Sunny terrace, indoor dining room, generous gourmet cuisine at lunchtime and DJ sets from 2pm!"
    ],
    "it": [
      "Il ristorante festivo situato a 2500 metri di altitudine a Les Menuires. Accessibile dalla seggiovia Sunny Express o dalla pista \"David Douillet\". Terrazza soleggiata, sala interna, cucina gourmet generosa a pranzo e DJ set dalle 14:00!"
    ],
    "fr": [
      "Le restaurant festif situé à 2500 mètres d’altitude aux Menuires. Accessible depuis le télésiège du Sunny Express ou piste « David Douillet ». Terrasse ensoleillée, salle intérieure, cuisine gourmande et généreuse le midi et DJ sets dès 14h !"
    ],
    "nl": [
      "Het feestelijke restaurant op 2500 meter hoogte in Les Menuires. Bereikbaar vanaf de stoeltjeslift Sunny Express of de piste \"David Douillet\". Zonnig terras, eetzaal binnen, royale gastronomische keuken 's middags en dj-sets vanaf 14.00 uur!"
    ],
    "es": [
      "El restaurante festivo situado a 2500 metros de altitud en Les Menuires. Accesible desde el telesilla Sunny Express o la pista \"David Douillet\". Terraza soleada, comedor interior, generosa cocina gastronómica al mediodía y sesiones de DJ a partir de las 14 h"
    ]
  },
