  "rdfs:comment": {
    "de": [
      "Tagesbistro mit einer großen Auswahl an Bieren und Weinen vom Fass und gutem Kaffee! In der Brasserie werden dienstags bis samstags mittags die leckeren Gerichte des Küchenchefs angeboten. Gerichte werden à la carte angeboten. Tagesmenü von Dienstag bis Freitag (außer an Feiertagen)"
    ],
    "en": [
      "Café next to the Tourist Office, central location, with a pleasant outdoor space on a paved area. Salads, pancakes, icecream, evening buffets… Wifi hotspot available."
    ],
    "it": [
      "Bistrot aperto tutto il giorno che offre una vasta gamma di birre e vini alla spina, oltre a un buon caffè! Nella brasserie, i deliziosi piatti dello chef sono serviti dal martedì al sabato a pranzo. Piatti alla carta. Menu giornaliero da martedì a venerdì (esclusi i giorni festivi)"
    ],
    "fr": [
      "Bistro à la journée proposant une belle gamme de bières pression et de vins, et un bon café! Côté brasserie les bons petits plats du Chef sont proposés du mardi au samedi le midi. Plats à la carte. Menu du jour du mardi au vendredi (hors jour férié)"
    ],
    "nl": [
      "De hele dag door een bistro met een grote keuze aan bieren en wijnen van het vat, plus een goede kop koffie! In de brasserie serveert de chef van dinsdag tot en met zaterdag heerlijke gerechten. A la carte gerechten. Dagmenu dinsdag t/m vrijdag (met uitzondering van feestdagen)"
    ],
    "es": [
      "Bistró abierto todo el día que ofrece una gran variedad de cervezas de barril y vinos, además de un buen café En la brasserie, se sirven deliciosos platos del chef de martes a sábado al mediodía. Platos a la carta. Menú del día de martes a viernes (excepto festivos)"
    ]
  },
  "rdfs:label": {
    "en": [
      "Au bistro de Julie"
    ],
    "fr": [
      "Au Bistro de Julie"
    ]
  },
