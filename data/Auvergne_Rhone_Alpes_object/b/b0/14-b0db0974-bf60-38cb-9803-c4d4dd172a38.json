      "@id": "https://data.datatourisme.fr/eca7ec19-8067-3fc8-96e1-45916d487e2b",
      "dc:description": {
        "de": [
          "Unterricht durch Johan diplomierter Coach.  \nEs besteht die Möglichkeit, ein oder zwei kostenlose Probetrainings zu absolvieren.\n\nWir erwarten Sie mit Freude und guter Laune."
        ],
        "en": [
          "Lessons given by Johan, a qualified coach.  \nOne or 2 free trials available.\n\nWe look forward to seeing you in a good mood."
        ],
        "it": [
          "Le lezioni sono tenute da Johan, un allenatore qualificato.  \nSono disponibili una o due prove gratuite.\n\nCi auguriamo di vedervi di buon umore."
        ],
        "fr": [
          "Cours dispensés par Johan coach diplômé.  \nPossibilité de faire un ou 2 essais gratuitement. \n\nOn vous attend dans la joie et la bonne humeur."
        ],
        "nl": [
          "Lessen gegeven door Johan, een gediplomeerde coach.  \nEen of 2 gratis proeflessen beschikbaar.\n\nWe zien je graag vol goede moed."
        ],
        "es": [
          "Clases impartidas por Johan, un entrenador cualificado.  \nUna o 2 pruebas gratuitas disponibles.\n\nEsperamos verte de buen humor."
        ]
      },
