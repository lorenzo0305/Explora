  "rdfs:comment": {
    "de": [
      "Die Feuerwehr von Bas-en-Basset lädt Sie herzlich zur 3. Ausgabe des Festi?Memory ein!\r\nEin herzlicher Moment, der Musik, Geselligkeit und Erinnerung miteinander verbindet\r\n konzert, Getränke und Snacks vor Ort."
    ],
    "en": [
      "The Bas-en-Basset Sapeurs-Pompiers are pleased to invite you to the 3rd edition of the Festi?Memory!\r\nA warm moment combining music, conviviality and memory\r\n concert, refreshment bar and snack bar on site."
    ],
    "it": [
      "I Vigili del Fuoco di Bas-en-Basset sono lieti di invitarvi alla terza edizione del Festi?Memory!\r\nUn momento caloroso che unisce musica, convivialità e memoria\r\n concerto, punto di ristoro e snack bar sul posto."
    ],
    "fr": [
      "Les Sapeurs-Pompiers de Bas-en-Basset ont le plaisir de vous inviter à la 3ᵉ édition du Festi’Memory !\r\nUn moment chaleureux mêlant musique, convivialité et mémoire. billetterie sur place\r\n concert, buvette et snack sur place."
    ],
    "es": [
      "El Cuerpo de Bomberos de Bas-en-Basset tiene el placer de invitarle a la 3ª edición del Festival de la Memoria\r\nUn momento cálido que combina música, convivencia y memoria\r\n concierto, bar de refrescos y snack bar in situ."
    ],
    "nl": [
      "De brandweer van Bas-en-Basset nodigt u graag uit voor het 3e Festi?Memory!\r\nEen warm moment dat muziek, gezelligheid en herinnering combineert\r\n concert, verfrissingsbar en snackbar ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "3ème édition du Festi MEMORY"
    ]
  },
