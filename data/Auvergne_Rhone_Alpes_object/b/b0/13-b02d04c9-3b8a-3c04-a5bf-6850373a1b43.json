  "rdfs:comment": {
    "de": [
      "Im Herzen des Pôle Loisirs Confluence wird das Hippopotamus Lyon Confluence mit seinen zarten und schmackhaften Fleischgerichten Ihre Geschmacksknospen wecken."
    ],
    "en": [
      "In the Confluence leisure and retail area, Hippopotamus Lyon Confluence will delight your taste buds with its tender and tasty meat dishes."
    ],
    "it": [
      "Nel cuore del centro ricreativo Confluence, l'Hippopotamus Lyon Confluence risveglierà il vostro palato con le sue carni tenere e gustose."
    ],
    "fr": [
      "Au cœur du Pôle Loisirs Confluence, Hippopotamus Lyon Confluence saura éveiller vos papilles grâce à ses viandes tendres et savoureuses."
    ],
    "nl": [
      "In het hart van de Pôle Loisirs Confluence zal Hippopotamus Lyon Confluence uw smaakpapillen prikkelen met zijn malse en smakelijke vleeswaren."
    ],
    "es": [
      "En el corazón del centro de ocio Confluence, Hippopotamus Lyon Confluence despertará sus papilas gustativas con sus tiernas y sabrosas carnes."
    ]
  },
