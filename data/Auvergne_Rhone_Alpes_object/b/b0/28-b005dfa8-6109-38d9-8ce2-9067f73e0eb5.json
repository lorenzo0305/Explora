  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/620dbdf4-177c-3802-a8a2-d9cc7aa0ea86",
      "dc:description": {
        "de": [
          "Die Mediathek von Ribeaucourt empfängt Sie :\n- am Dienstag von 10:00 bis 12:00 Uhr und von 15:00 bis 18:30 Uhr ;\n- am Mittwoch von 10:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- am Freitag von 14:00 bis 18:00 Uhr ;\n- am Samstag von 10:00 bis 12:00 Uhr."
        ],
        "en": [
          "The Ribeaucourt media library welcomes you:\n- tuesday from 10:00 to 12:00 and 15:00 to 18:30;\n- wednesdays from 10:00 to 12:00 and from 14:00 to 18:00;\n- friday from 14h00 to 18h00;\n- saturday from 10:00 to 12:00."
        ],
        "it": [
          "La mediateca Ribeaucourt vi dà il benvenuto:\n- il martedì dalle 10:00 alle 12:00 e dalle 15:00 alle 18:30;\n- mercoledì dalle 10:00 alle 12:00 e dalle 14:00 alle 18:00;\n- venerdì dalle 14:00 alle 18:00;\n- sabato dalle 10:00 alle 12:00."
        ],
        "fr": [
          "La médiathèque de Ribeaucourt vous accueille :\n- le mardi de 10h00 à 12h00 et de 15h00 à 18h30 ;\n- le mercredi de 10h00 à 12h00 et de 14h00 à 18h00 ;\n- le vendredi de 14h00 à 18h00 ;\n- le samedi de 10h00 à 12h00."
        ],
        "es": [
          "La mediateca de Ribeaucourt le da la bienvenida:\n- martes de 10:00 a 12:00 y de 15:00 a 18:30;\n- miércoles de 10:00 a 12:00 y de 14:00 a 18:00;\n- viernes de 14 a 18 horas;\n- sábado de 10:00 a 12:00."
        ],
        "nl": [
          "De mediatheek van Ribeaucourt heet u welkom:\n- dinsdag van 10.00 tot 12.00 uur en van 15.00 tot 18.30 uur;\n- woensdag van 10:00 tot 12:00 uur en van 14:00 tot 18:00 uur;\n- vrijdag van 14.00 tot 18.00 uur;\n- zaterdag van 10:00 tot 12:00 uur."
        ]
      },
