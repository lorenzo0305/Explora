      "@id": "https://data.datatourisme.fr/c715c2ce-0b7c-3eeb-bcb2-2fa25ae88dfc",
      "dc:description": {
        "de": [
          "Goenergie , spezialisierte Energiemaklerfirma für Gewerbetreibende, Verbrauchsbilanz und kostenlose Studie.  \nSie sparen garantiert bei Ihren nächsten Rechnungen"
        ],
        "en": [
          "Goenergie , specialized energy brokerage company for professionals, consumption assessment and free study .  \nYou're sure to save money on your next bill!"
        ],
        "it": [
          "Goenergie , società di intermediazione energetica specializzata per i professionisti, valutazione dei consumi e studio gratuito.  \nIl risparmio sulle prossime bollette è garantito"
        ],
        "fr": [
          "Goenergie , société de courtage en énergie spécialisée pour les professionnels, bilan de consommation et étude gratuite .  \nVous êtes assurés de faire des économies sur vos prochaines factures"
        ],
        "nl": [
          "Goenergie , gespecialiseerd energiebemiddelingsbedrijf voor professionals, verbruiksbepaling en gratis studie.  \nU bespaart gegarandeerd op uw volgende facturen"
        ],
        "es": [
          "Goenergie , empresa de intermediación energética especializada para profesionales, evaluación de consumos y estudio gratuito.  \nTe garantizamos un ahorro en tus próximas facturas"
        ]
      },
