  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine argentinische Spezialität, die Sie auf eine Reise über den Atlantik mitnehmen wird: die Empañadas! In den Gassen des historischen Viertels gelegen, werden Sie freundlich, gut gelaunt und mit Respekt vor jedem Einzelnen empfangen."
    ],
    "en": [
      "Come and discover an Argentinean specialty that will take you across the Atlantic: empañadas! Located in the alleys of the historical district, you will be welcomed in a friendly atmosphere, in a good mood and with respect for everyone."
    ],
    "it": [
      "Venite a scoprire una specialità argentina che vi porterà oltreoceano: le empañadas! Situati nelle strette vie del quartiere storico, sarete accolti in un'atmosfera amichevole, bonaria e rispettosa."
    ],
    "fr": [
      "Venez découvrir une spécialité argentine qui vous fera voyager outre-Atlantique : les empañadas ! Situé dans les ruelles du quartier historique, vous serez accueillis dans la convivialité, la bonne humeur et le respect de chacun."
    ],
    "es": [
      "Venga a descubrir una especialidad argentina que le hará cruzar el Atlántico: ¡las empañadas! Situado en las callejuelas del casco histórico, le acogerán en un ambiente cordial, de buen humor y respetuoso."
    ],
    "nl": [
      "Kom en ontdek een Argentijnse specialiteit die u over de Atlantische Oceaan brengt: empañadas! Gelegen in de smalle straatjes van de historische wijk, wordt u ontvangen in een vriendelijke, goed gehumeurde en respectvolle sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cosa Nuestra"
    ]
  },
