  "rdfs:comment": {
    "de": [
      "Ob zum Spaß oder für die Anstrengung, werfen Sie sich in die Badewanne! 25m-Becken, Spaßbad mit Rutsche, Planschbecken, Wellnessbereich, Fitnessbereich und Kraftraum."
    ],
    "en": [
      "Whether for fun or for exercise, take a dip in the pool! 25m pool, fun pool with slide, paddling pool, wellness area, fitness area and weight room."
    ],
    "it": [
      "Che siate alla ricerca di divertimento o di fitness, entrate in acqua! Piscina di 25 metri, piscina ludica con scivolo, piscina per bambini, area benessere, area fitness e sala pesi."
    ],
    "fr": [
      "Pour le fun ou pour l’effort, mettez-vous dans le bain ! Bassin de 25m, piscine ludique avec toboggan, pataugeoire, espace wellness, espace fitness et salle de musculation."
    ],
    "es": [
      "Ya sea para divertirse o para ponerse en forma, ¡al agua! Piscina de 25 m, piscina lúdica con tobogán, piscina infantil, zona de bienestar, zona de fitness y sala de musculación."
    ],
    "nl": [
      "Of je nu op zoek bent naar plezier of fitness, ga het water in! 25m zwembad, fun pool met glijbaan, peuterbad, wellnessruimte, fitnessruimte en gewichtenruimte."
    ]
  },
  "rdfs:label": {
