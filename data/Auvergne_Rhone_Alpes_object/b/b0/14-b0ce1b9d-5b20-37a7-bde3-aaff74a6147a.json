  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/679c108b-4ecc-3e65-afa5-fbcd4f987319",
      "dc:description": {
        "de": [
          "Von der Stadt Camiers organisierter Jahrmarkt.\nTreffpunkt Place des Anciens Combattants, um Zuckerwatte, Liebesäpfel....eine Fahrt auf dem Karussell oder Entenangeln zu genießen"
        ],
        "en": [
          "Fair organized by the town of Camiers.\nCome to Place des Anciens Combattants for cotton candy, pomme d'amour...., a ride on the merry-go-round and duck fishing"
        ],
        "it": [
          "Luna park organizzato dalla città di Camiers.\nAppuntamento in Place des Anciens Combattants per zucchero filato, pomme d'amour, pesca delle anatre e un giro sulla giostra..."
        ],
        "fr": [
          "Fête Foraine organisée par la ville de Camiers. \nRendez-vous Place des Anciens Combattants pour déguster barbe à papa, pomme d'amour....faire un tour de manège au faire une pêche aux canards"
        ],
        "nl": [
          "Kermis georganiseerd door de stad Camiers.\nKom naar Place des Anciens Combattants voor suikerspinnen, pomme d'amour, eendjes vissen en een ritje in de draaimolen..."
        ],
        "es": [
          "Feria de atracciones organizada por la ciudad de Camiers.\nCita en la plaza de los Antiguos Combatientes para disfrutar de algodón de azúcar, pomme d'amour, pesca de patos y un paseo en el tiovivo ..."
        ]
      },
      "@type": [
