  "rdfs:comment": {
    "de": [
      "Eingana Reconnexion à la Nature bietet sanfte Überlebenskurse und naturkundliche Ausbildungen an, um die Natur zu entdecken, die wesentlichen Gesten der Selbstständigkeit zu erlernen und ein Abenteuer zu erleben, das die Lebewesen respektiert und von Experten betreut wird."
    ],
    "en": [
      "Eingana Reconnexion à la Nature offers gentle survival courses and naturalist training to discover nature, learn the essential gestures of self-reliance and live an adventure respectful of living things, supervised by experts."
    ],
    "it": [
      "Eingana Reconnexion à la Nature offre corsi di sopravvivenza dolce e formazione naturalistica per farvi scoprire la natura, imparare le abilità essenziali di autosufficienza e vivere un'avventura nel rispetto degli esseri viventi, sotto la supervisione di esperti."
    ],
    "fr": [
      "Eingana Reconnexion à la Nature propose des stages de survie douce et des formations naturalistes pour découvrir la nature, apprendre les gestes essentiels d’autonomie et vivre une aventure respectueuse du vivant, encadrée par des experts."
    ],
    "es": [
      "Eingana Reconnexion à la Nature ofrece cursos de supervivencia suave y formación naturalista para ayudarle a descubrir la naturaleza, aprender habilidades esenciales de autosuficiencia y disfrutar de una aventura respetuosa con los seres vivos, supervisada por expertos."
    ],
    "nl": [
      "Eingana Reconnexion à la Nature biedt zachte survivalcursussen en naturalistentrainingen om de natuur te ontdekken, de essentiële gebaren van autonomie te leren en een avontuur te beleven met respect voor levende wezens, onder begeleiding van experts."
    ]
  },
