  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/66e3303a-7585-3916-81a7-6c61bad4d94f",
      "dc:description": {
        "de": [
          "Wahl 2024 Oma Touquet\nUm 14:30 Uhr\n\nBus ab Rathaus um 13:45 Uhr, Haltestelle am Sozial- und Kulturzentrum um 13:50 Uhr und dann an der Residenz Marcel Pagnol um 14 Uhr.\nRückfahrt 17 Uhr."
        ],
        "en": [
          "Election 2024 Mamie Touquet\nAt 2:30 p.m\n\nBus departs from the town hall at 1:45pm, stopping at the social and cultural center at 1:50pm, then at the Marcel Pagnol residence at 2pm.\nReturn at 5pm."
        ],
        "it": [
          "Elezione 2024 Mamie Touquet\nAlle 14.30\n\nPartenza del bus dal municipio alle 13.45, con fermata al centro sociale e culturale alle 13.50, poi alla residenza Marcel Pagnol alle 14.00.\nRitorno alle 17.00."
        ],
        "fr": [
          "Election 2024 Mamie Touquet\nA 14h30\n\nBus au départ de l'hôtel de ville à 13h45, arrêt au centre social et culturel à 13h50 puis à la résidence Marcel Pagnol à 14h.\nRetour 17h."
        ],
        "nl": [
          "Verkiezing 2024 Mamie Touquet\nOm 14.30 uur\n\nDe bus vertrekt om 13.45 uur vanaf het gemeentehuis en stopt om 13.50 uur bij het sociaal en cultureel centrum en om 14.00 uur bij de woning van Marcel Pagnol.\nTerugkomst om 17.00 uur."
        ],
        "es": [
          "Elección 2024 Mamie Touquet\nA las 14h30\n\nSalida del Ayuntamiento a las 13.45 h, parada en el Centro Social y Cultural a las 13.50 h y a las 14.00 h en la residencia Marcel Pagnol.\nRegreso a las 17.00 h."
        ]
      },
