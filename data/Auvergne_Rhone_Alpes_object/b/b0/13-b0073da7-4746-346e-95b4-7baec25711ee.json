  "rdfs:comment": {
    "de": [
      "Ihr Geschäft bietet Ihnen eine große Abteilung mit losen Waren, einen Obst- und Gemüsebereich, Käse-, Fleisch- und Kosmetikabteilungen, Nahrungsergänzungsmittel... sowie individuelle Dienstleistungen (besondere Bestellungen, bestimmte Mengen...)."
    ],
    "en": [
      "Shop offering a large range of bulk products, fruits and vegetables, cheeses, meat, cosmetics, dietary supplements...and personalised services (special order, special quantity...)"
    ],
    "it": [
      "Il vostro negozio offre un'ampia gamma di prodotti sfusi, frutta e verdura, formaggi, carne, cosmetici, integratori alimentari, ecc. e servizi personalizzati (ordini speciali, quantità specifiche, ecc.)."
    ],
    "fr": [
      "Votre magasin vous propose un large rayon de produits en vrac, une partie fruits et légumes, des rayons fromage, viande, cosmétiques, des compléments alimentaires... ainsi que des services personnalisés (commande particulière, quantité spécifique...)."
    ],
    "es": [
      "Su tienda ofrece una amplia gama de productos a granel, fruta y verdura, queso, carne, cosméticos, complementos alimenticios, etc., así como servicios personalizados (pedidos especiales, cantidades específicas, etc.)."
    ],
    "nl": [
      "Je winkel biedt een breed assortiment bulkproducten, fruit en groenten, kaas, vlees, cosmetica, voedingssupplementen, enz., maar ook gepersonaliseerde diensten (speciale bestellingen, specifieke hoeveelheden, enz.)."
    ]
  },
  "rdfs:label": {
