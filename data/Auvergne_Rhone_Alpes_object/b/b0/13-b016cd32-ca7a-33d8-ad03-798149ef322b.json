  "rdfs:comment": {
    "de": [
      "Die Stadt Marignier stellt einen Lese- und Musikservice zur Verfügung. Hier finden Sie Bücher, Zeitschriften und CDs, um sich zu unterhalten, zu informieren und sich zu dokumentieren."
    ],
    "en": [
      "The town of Marignier is open for people to come in and read or listen to music.  You will find books, periodicals and CDs here for entertainment, education and research."
    ],
    "it": [
      "La città di Marignier offre un servizio di lettura e musica. Troverete libri, riviste e CD per il vostro intrattenimento, informazioni e documentazione."
    ],
    "fr": [
      "La ville de Marignier met à la disposition un service lecture et musique. Vous y trouverez des livres, des revues, des CD pour vous distraire, vous informer et vous documenter."
    ],
    "es": [
      "La ciudad de Marignier ofrece un servicio de lectura y música. Encontrará libros, revistas y CDs para su entretenimiento, información y documentación."
    ],
    "nl": [
      "De stad Marignier biedt een lees- en muziekdienst aan. U vindt er boeken, tijdschriften en cd's voor uw vermaak, informatie en documentatie."
    ]
  },
