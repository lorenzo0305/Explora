  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/300c83fd-5f39-3109-99f4-091755607bdc",
      "dc:description": {
        "de": [
          "Kinosaal mit etwa 100 Plätzen, in dem jede Woche ein anderes, aktuelles Programm gezeigt wird.\n\nSehen Sie diese Woche \"Inglorious Basterds\", einen Film von Tarantino mit Brad Pitt (ab 12 Jahren freigegeben)."
        ],
        "en": [
          "A 100-seat cinema with a different and topical programme every week.\n\nThis week, come and see \"Inglorious Basterds\", a Tarantino film with Brad Pitt (not for children under 12)."
        ],
        "it": [
          "Un cinema con circa 100 posti a sedere, con un programma diverso e di attualità ogni settimana.\n\nQuesta settimana, venite a vedere \"Inglorious Basterds\", un film di Tarantino con Brad Pitt (vietato ai minori di 12 anni)."
        ],
        "fr": [
          "Salle de cinéma d'une centaine de places avec toutes les semaines une programmation différente et d'actualité.\n\nCette semaine, venez voir \"Inglorious Basterds\", un film de Tarantino avec Brad Pitt (interdit aux moins de 12 ans)."
        ],
        "es": [
          "Un cine de unas 100 plazas, con una programación diferente y de actualidad cada semana.\n\nEsta semana, ven a ver \"Malditos bastardos\", una película de Tarantino con Brad Pitt (prohibida para menores de 12 años)."
        ],
        "nl": [
          "Een bioscoop met ongeveer 100 plaatsen, met elke week een ander en actueel programma.\n\nKom deze week naar \"Inglorious Basterds\", een Tarantino-film met Brad Pitt (verboden voor kinderen onder de 12 jaar)."
        ]
      },
