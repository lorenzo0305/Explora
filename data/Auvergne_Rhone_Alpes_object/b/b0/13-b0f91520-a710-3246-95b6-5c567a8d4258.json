  "rdfs:comment": {
    "de": [
      "Hier finden Sie Informationsmaterial über Rumilly-Albanais und die Region: Broschüren, Pläne, touristische Karten, Veranstaltungsprogramme, Aktivitäten und Besichtigungen.\r\nVerkauf von Angelkarten der APPMA de l'Albanais.\r\nBoutique: Produkte aus der Region, lokales Kunsthandwerk, Souvenirs?"
    ],
    "en": [
      "Find all the documentation for Rumilly-Albanais and the region: brochures, maps, tourist maps, program of events, activities and visits.\r\nAPPMA de l'Albanais fishing cards for sale.\r\nStore area: local products, crafts, hiking guides, souvenirs..."
    ],
    "it": [
      "Rumilly-Albanais e documentazione regionale: opuscoli, cartine, mappe turistiche, programma di eventi, attività e visite.\r\nVendita di carte da pesca APPMA de l'Albanais.\r\nNegozio: prodotti regionali, artigianato locale, souvenir, ecc"
    ],
    "fr": [
      "Retrouvez la documentation Rumilly-Albanais et de la région : brochures, plans, cartes touristiques, programme des animations, activités et visites. \r\nVente de carte de pêche APPMA de l'Albanais.\r\nBoutique : Produits du terroir, artisanat local, souvenirs…"
    ],
    "nl": [
      "Rumilly-Albanais en regionale documentatie: brochures, kaarten, toeristische kaarten, programma van evenementen, activiteiten en bezoeken.\r\nVerkoop van viskaarten APPMA de l'Albanais.\r\nWinkel: regionale producten, lokale ambachten, souvenirs, enz"
    ],
    "es": [
      "Documentación sobre Rumilly-Albanais y la región: folletos, mapas, planos turísticos, programa de actos, actividades y visitas.\r\nVenta de tarjetas de pesca APPMA de l'Albanais.\r\nTienda: productos regionales, artesanía local, recuerdos, etc"
    ]
  },
