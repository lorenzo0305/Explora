  "rdfs:comment": {
    "de": [
      "Im reinen romanischen Stil der Auvergne aus dem 12. Sie befindet sich im Herzen von Riom-ès-Montagnes und kann täglich frei besichtigt werden, wobei sie zwischen 12 und 14 Uhr geschlossen ist."
    ],
    "en": [
      "Pure 12th-century Auvergne Romanesque. Located in the heart of Riom-ès-Montagnes, it is open to visitors every day, closing between 12pm and 2pm."
    ],
    "it": [
      "La chiesa, in puro stile romanico alverniate, risale al XII secolo. Situata nel cuore di Riom-ès-Montagnes, è aperta ai visitatori tutti i giorni, con chiusura tra le 12.00 e le 14.00."
    ],
    "fr": [
      "De pur style roman auvergnat du XIIème siècle. Située au coeur de Riom-ès-Montagnes, elle se visite librement tous les jours, avec une fermeture entre 12h et 14h."
    ],
    "es": [
      "La iglesia es de puro estilo románico auvernés y data del siglo XII. Situada en el corazón de Riom-ès-Montagnes, se puede visitar todos los días, cerrando entre las 12h y las 14h."
    ],
    "nl": [
      "De kerk heeft een zuivere Romaanse stijl uit de Auvergne en dateert uit de 12e eeuw. De kerk ligt in het hart van Riom-ès-Montagnes en is elke dag open voor bezoekers, maar sluit tussen 12 en 14 uur."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Georges"
    ]
  },
