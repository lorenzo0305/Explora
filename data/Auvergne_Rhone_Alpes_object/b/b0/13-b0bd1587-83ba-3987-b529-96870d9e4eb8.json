  "rdfs:comment": {
    "de": [
      "In der Nähe des Office de Tourisme du Corbier gibt es kostenlose Ladestationen für Fahrräder mit Elektrounterstützung, sodass Sie Ihren Akku während Ihres Aufenthalts problemlos aufladen können."
    ],
    "en": [
      "Charging stations for electric bikes are available free of charge near the Corbier Tourist Office, so you can easily recharge your battery during your stay."
    ],
    "it": [
      "Nei pressi dell'Ufficio del Turismo di Corbier sono disponibili gratuitamente punti di ricarica per le biciclette elettriche, in modo da poter ricaricare facilmente la batteria durante il soggiorno."
    ],
    "fr": [
      "Des bornes de recharge pour vélos à assistance électrique sont disponibles gratuitement à proximité de l’Office de Tourisme du Corbier, pour recharger facilement votre batterie pendant votre séjour."
    ],
    "nl": [
      "Oplaadpunten voor elektrische fietsen zijn gratis beschikbaar in de buurt van het toeristenbureau van Corbier, dus je kunt je accu gemakkelijk opladen tijdens je verblijf."
    ],
    "es": [
      "Cerca de la Oficina de Turismo de Corbier hay puntos de carga gratuitos para bicicletas eléctricas, para que pueda recargar la batería fácilmente durante su estancia."
    ]
  },
  "rdfs:label": {
    "en": [
      "VAE charging stations"
    ],
    "fr": [
      "Bornes de recharge VAE"
    ],
    "nl": [
      "VAE oplaadpunten"
    ]
  },
