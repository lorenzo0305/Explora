  "rdfs:comment": {
    "de": [
      "Fotokurse Nachthimmel Foto, Wasserfall, Langzeitbelichtung in den Bergen: Fotokurse Einführung in die Langzeitbelichtung: Nachtlandschaften, Himmelsgewölbe, Sternenhimmel, Sonnenuntergang, Milchstraße, Zirkumpolar, Spiegelungen von Seen und Wasserfällen."
    ],
    "en": [
      "Night sky photo courses, waterfalls, long exposure in the mountains: introductory photography courses in long exposure: night landscapes, celestial vault, starry sky, sunset, milky way, circumpolar, lake and waterfall reflections."
    ],
    "it": [
      "Corsi di fotografia notturna, cascate, lunga esposizione in montagna: corsi introduttivi di fotografia a lunga esposizione: paesaggi notturni, volta celeste, cielo stellato, tramonto, via lattea, circumpolare, riflessi di laghi e cascate."
    ],
    "fr": [
      "Stages photo ciel nocturne photo, cascade, pose longue en montagne : cours de photographies initiation à la pose longue : paysages de nuit, voûte céleste, ciel étoilé, couché de soleil, voie lactée, circumpolaire, reflet lac et cascades."
    ],
    "nl": [
      "Fotocursussen nachthemel, watervallen, lange belichting in de bergen: inleidende fotocursussen lange belichting: nachtlandschappen, hemelgewelf, sterrenhemel, zonsondergang, melkweg, circumpolair, reflecties van meren en watervallen."
    ],
    "es": [
      "Cursos de fotografía de cielo nocturno, cascadas, larga exposición en montaña: cursos de iniciación a la fotografía de larga exposición: paisajes nocturnos, bóveda celeste, cielo estrellado, puesta de sol, vía láctea, circumpolar, reflejos de lagos y cascadas."
    ]
