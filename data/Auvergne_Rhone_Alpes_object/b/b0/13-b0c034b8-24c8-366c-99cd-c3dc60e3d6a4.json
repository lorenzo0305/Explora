  "rdfs:comment": {
    "de": [
      "Ein schnelles und lächelndes Saalteam wird Ihnen eine angenehme Zeit bereiten und dafür sorgen, dass die Zeit des Essens ein unvergesslicher Moment bleibt."
    ],
    "en": [
      "A fast, smiling wait staff will make sure you have a great time and that your meal is unforgettable."
    ],
    "it": [
      "Il personale, veloce e sorridente, farà in modo di farvi trascorrere un momento piacevole e che il pasto sia indimenticabile."
    ],
    "fr": [
      "Une équipe de salle rapide et souriante, saura vous faire passer un moment agréable et fera en sorte que le temps du repas reste un moment inoubliable."
    ],
    "nl": [
      "Het snelle en glimlachende personeel zorgt ervoor dat u een aangename tijd heeft en dat de maaltijd onvergetelijk wordt."
    ],
    "es": [
      "El personal, rápido y sonriente, se encargará de que pase un rato agradable y de que la comida sea inolvidable."
    ]
  },
  "rdfs:label": {
