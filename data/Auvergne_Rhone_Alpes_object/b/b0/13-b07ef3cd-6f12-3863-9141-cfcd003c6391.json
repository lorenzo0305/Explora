  "rdfs:comment": {
    "de": [
      "Génération Musher bietet Taufen mit dem Hundeschlitten an.\r\nMachen Sie es sich an Bord unseres Schlittens für die Dauer einer Fahrt über das Plateau von Champagny Le Haut gemütlich."
    ],
    "en": [
      "Génération Musher offers dog sledding baptisms.\r\nCome and make yourself comfortable aboard our sled for a ride on the Champagny Le Haut plateau."
    ],
    "it": [
      "Génération Musher offre gite introduttive in slitta trainata da cani.\r\nVenite a mettervi comodi a bordo della nostra slitta per un giro sull'altopiano di Champagny Le Haut."
    ],
    "fr": [
      "Génération Musher propose des baptêmes en traineau à chien.\r\nVenez vous installer confortablement à bord de notre traîneau le temps d'une balade sur le plateau de Champagny Le Haut."
    ],
    "es": [
      "Génération Musher ofrece paseos de iniciación al trineo tirado por perros.\r\nVen y ponte cómodo a bordo de nuestro trineo para dar un paseo por la meseta de Champagny Le Haut."
    ],
    "nl": [
      "Génération Musher biedt kennismakingsritten met de hondenslee.\r\nKom en maak het jezelf gemakkelijk aan boord van onze slee voor een rit op het plateau van Champagny Le Haut."
    ]
  },
  "rdfs:label": {
