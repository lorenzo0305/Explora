  "rdfs:comment": {
    "de": [
      "Dieser Parcours startet im Park des Rathauses und zeigt Ihnen die verschiedenen Facetten der Gemeinde Eybens, wobei Sie 12 Markierungen finden müssen."
    ],
    "en": [
      "Starting from the town hall park, this route will make you discover the different facets of the town of Eybens, with 12 markers to find."
    ],
    "it": [
      "Partendo dal parco del municipio, questo percorso vi aiuterà a scoprire le diverse sfaccettature della città di Eybens, con 12 indicatori da trovare."
    ],
    "fr": [
      "Au départ du parc de la mairie, ce parcours vous fera découvrir les différentes facettes de la commune d’Eybens, avec 12 balises à trouver."
    ],
