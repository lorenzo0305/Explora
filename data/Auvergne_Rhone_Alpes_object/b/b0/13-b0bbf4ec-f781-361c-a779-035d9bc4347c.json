  "rdfs:comment": {
    "de": [
      "Traditionelle Kastanienwälder, die sich an die Hänge der Ardèche schmiegen und von einer Herde Ziegen beweidet werden, die den Picodon herstellen. Auf der Ferme de la Blache finden Sie Ziegenkäse und Kastanien als Marmelade oder in naturbelassener Form."
    ],
    "en": [
      "Traditional chestnut groves nestled on the slopes of the Ardèche, grazed by a herd of Picodon-producing goats. At Ferme de la Blache, you'll find goat's cheese and chestnuts in jam or in their natural state."
    ],
    "it": [
      "Tradizionali castagneti adagiati sulle pendici dell'Ardèche, pascolati da una mandria di capre produttrici di Picodon. Alla Ferme de la Blache troverete formaggio di capra e castagne in confettura o al naturale."
    ],
    "fr": [
      "Des châtaigneraies traditionnelles nichées sur les pentes ardéchoises, pâturées par un troupeau de chèvres productrices de Picodon. Vous trouverez à la Ferme de la Blache des fromages de chèvre et des châtaignes en confiture ou au naturel."
    ],
    "nl": [
      "Traditionele kastanjebossen op de hellingen van de Ardèche, begraasd door een kudde Picodon-geiten. Bij Ferme de la Blache vind je geitenkaas en kastanjes in jam of in natuurlijke staat."
    ],
    "es": [
      "Castañares tradicionales enclavados en las laderas del Ardèche, pastoreados por un rebaño de cabras productoras de Picodon. En la Ferme de la Blache, encontrará queso de cabra y castañas en mermelada o al natural."
    ]
  },
  "rdfs:label": {
