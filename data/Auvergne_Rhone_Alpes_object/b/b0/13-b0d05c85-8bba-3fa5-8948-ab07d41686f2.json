  "rdfs:comment": {
    "de": [
      "Neue Mer de Glace-Gondelbahn an der Bergstation des Montenvers-Zuges, die den Zugang zur Mer de Glace-Höhle ermöglicht und die Rückkehr aus dem Vallée Blanche erleichtert."
    ],
    "en": [
      "The new Mer de Glace gondola, located at the Montenvers train station, provides access to the Mer de Glace cave and facilitates the return journey from the Vallée Blanche."
    ],
    "it": [
      "La nuova funivia della Mer de Glace, situata presso la stazione ferroviaria di Montenvers, consente di accedere alla grotta della Mer de Glace e facilita il ritorno dalla Vallée Blanche."
    ],
    "fr": [
      "Nouvelle télécabine de la Mer de Glace, située à la gare d'arrivée du Train du Montenvers permettant d'accéder à la grotte de la Mer de Glace et de faciliter le retour de la Vallée Blanche."
    ],
    "es": [
      "El nuevo teleférico de Mer de Glace, situado en la estación de tren de Montenvers, permite acceder a la gruta de Mer de Glace y facilita el regreso desde Vallée Blanche."
    ],
    "nl": [
      "De nieuwe kabelbaan Mer de Glace, die zich bij het treinstation Montenvers bevindt, biedt toegang tot de grot Mer de Glace en maakt het gemakkelijker om terug te keren vanuit de Vallée Blanche."
    ]
  },
  "rdfs:label": {
    "de": [
      "Gondelbahn zum Mer de Glace"
    ],
    "en": [
      "Mer de Glace gondola lift"
    ],
