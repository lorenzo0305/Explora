  "rdfs:comment": {
    "de": [
      "Matthieu Brachet, Tischlermeister, öffnet die Türen seiner Werkstatt in einem Gemeinschaftsatelier und bietet Ihnen Praktika und Ausbildungen in Tischlerei und Holzdrechseln an."
    ],
    "en": [
      "Matthieu Brachet, Master Craftsman Carpenter, opens the doors of his workshop in shared workshop and offers courses and training in carpentry and wood turning."
    ],
    "it": [
      "Matthieu Brachet, Maestro Artigiano Falegname, apre le porte del suo laboratorio in un'officina condivisa e vi offre corsi di formazione in falegnameria e tornitura del legno."
    ],
    "fr": [
      "Matthieu Brachet, Maître Artisan Menuisier, ouvre les portes de son atelier en atelier partagé et vous propose des stages et formations en menuiserie et tournage sur bois."
    ],
    "nl": [
      "Matthieu Brachet, meester-timmerman, opent de deuren van zijn atelier in een gemeenschappelijke werkplaats en biedt u opleidingen in timmeren en houtdraaien."
    ],
    "es": [
      "Matthieu Brachet, Maestro Artesano Carpintero, le abre las puertas de su taller en un taller compartido y le ofrece cursos de formación en carpintería y torneado de madera."
    ]
  },
