  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine originelle und elegante Malerei nach Maß: vorübergehende oder dauerhafte Schaufenster, Wandmalereien innen/außen auf verschiedenen Untergründen/Stilen. Engagiert im Dienste von Körperschaften, Vereinen, Händlern und Privatpersonen."
    ],
    "en": [
      "Experience original, elegant décor with our expertise. We create temporary/permanent window displays, interior/exterior wall paintings on diverse surfaces/styles. Committed to serving communities, associations, merchants, and individuals."
    ],
    "it": [
      "Regalatevi un dipinto originale, elegante e su misura: vetrine effimere o permanenti, murales per interni/esterni su una varietà di superfici/stili. Impegnati a servire enti locali, associazioni, rivenditori e privati."
    ],
    "fr": [
      "Offrez-vous une peinture originale et élégante sur mesure : vitrines éphémères ou permanentes, peintures murales intérieures/extérieures sur divers supports/styles. Engagés à servir collectivités, associations, commerçants et particuliers."
    ],
    "es": [
      "Regálese una pintura original, elegante y a medida: escaparates efímeros o permanentes, murales interiores/exteriores sobre superficies/estilos variados. Al servicio de colectividades, asociaciones, comercios y particulares."
    ],
    "nl": [
      "Met onze expertise creëren we unieke binnen- en buitenmuurschilderingen, tijdelijke/permanente etalages in diverse stijlen. Toegewijd aan het bedienen van gemeenschappen, verenigingen, handelaren en particulieren."
    ]
  },
