  "rdfs:comment": {
    "de": [
      "Große Terrasse am Fuße der Pisten, in der Nähe des Sessellifts Charmieux, freie Aussicht. \r\nSelbstbedienung zum Mittagessen. \r\nA la carte Catering, jeden Dienstag und Abend Savoyard-Spezialitäten."
    ],
    "en": [
      "Sunny terrace at the bottom of the slopes, near the Charmieux chairlift, panoramic view. Savoyard specialities on Tuesday evening.\r\nSelf-service for lunch. \r\n\"A la carte\" catering, Savoyard meals specialities every Tuesday evenings and nights skiing evenings."
    ],
    "it": [
      "Ampia terrazza ai piedi delle piste, vicino alla seggiovia di Charmieux, con vista ininterrotta.\r\nPranzo self-service.\r\nRistorante à la carte con specialità savoiarde ogni martedì sera e sci notturno."
    ],
    "fr": [
      "Grande terrasse au pied des pistes, près du télésiège du Charmieux, vue dégagée. \r\nSelf-service les midis. \r\nRestauration à la carte, spécialités savoyardes tous les mardis soirs et soirs de ski en nocturne."
    ],
    "nl": [
      "Groot terras aan de voet van de pistes, vlakbij de Charmieux-stoeltjeslift, met ononderbroken uitzicht.\r\nZelfbediening tijdens lunchtijd.\r\nA la carte restaurant met specialiteiten uit de Savoie elke dinsdagavond en nachtskiën."
    ],
    "es": [
      "Amplia terraza al pie de las pistas, cerca del telesilla de Charmieux, con vistas ininterrumpidas.\r\nAutoservicio a mediodía.\r\nRestaurante a la carta con especialidades saboyanas todos los martes por la noche y esquí nocturno."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant \"Les Bruyères\""
    ],
    "en": [
      "Restaurant Les Bruyères"
    ],
    "fr": [
      "Restaurant Les Bruyères"
    ]
  },
