  "rdfs:comment": {
    "de": [
      "Am Eingang zum Stadtzentrum, Brasserie mit Tagesmenü von Montag bis Sonntag - à la carte. Traditionelle hausgemachte Küche aus frischen Produkten. Herzliche und freundliche Atmosphäre. Spätdienst am Mittag - Snacks zu jeder Stunde. Geschützte Terrasse."
    ],
    "en": [
      "Situated on the edge of the town centre, a brasserie with dish of the day from Monday to Sunday + à la carte. Traditional  cuisine with fresh products. Atmosphere warm and convivial. Late lunch service - snacks served all day. Covered terrace."
    ],
    "it": [
      "All'ingresso del centro città, brasserie con menu giornaliero dal lunedì alla domenica - alla carta. Cucina casalinga tradizionale con prodotti freschi. Atmosfera calda e amichevole. Servizio tardivo a pranzo - snack a tutte le ore. Terrazza riparata."
    ],
    "fr": [
      "A l'entrée du centre ville, brasserie avec menu du jour du lundi au dimanche - carte. Cuisine maison traditionnelle à base de produits frais. Ambiance chaleureuse et conviviale. Service tardif le midi - snack à toute heure. Terrasse abritée."
    ],
    "nl": [
      "Aan de rand van het centrum, brasserie met dagmenu van maandag tot zondag - à la carte. Keuken met traditionele gerechten op basis van verse producten. Warme gezellige sfeer. Late service 's middags - snack op elk tijdstip van de dag. Schaduwrijk terras."
    ],
    "es": [
      "A la entrada del centro de la ciudad, brasserie con menú diario de lunes a domingo - a la carta. Cocina casera tradicional con productos frescos. Ambiente cálido y acogedor. Servicio tardío a la hora de comer - merienda a todas horas. Terraza protegida."
    ]
  },
