  "rdfs:comment": {
    "de": [
      "Das Theatercafé La Guinguette ist ein Ort, an dem sich Anfänger, Amateure und etablierte Künstler ausdrücken können. Hier erlebt das Publikum im kleinen Kreis zahlreiche Aufführungen von manchmal nicht klassifizierbaren Darbietungen."
    ],
    "en": [
      "The café-théâtre La Guinguette is a place of expression for beginners, amateurs and established artists. Here, small audiences can enjoy a wide range of sometimes unclassifiable shows."
    ],
    "it": [
      "Il café-théâtre La Guinguette è un luogo di espressione per principianti, dilettanti e artisti esperti. Qui il pubblico assiste in piccoli gruppi a numerose rappresentazioni di spettacoli talvolta inclassificabili."
    ],
    "fr": [
      "Le café-théâtre La Guinguette est un lieu d'expression pour les artistes débutants, amateurs ou confirmés. Ici le public assiste en petit comité à de nombreuses représentations de spectacles parfois inclassables."
    ],
    "nl": [
      "Het café-théâtre La Guinguette is een plaats van expressie voor beginners, amateurs en ervaren kunstenaars. Hier woont het publiek in kleine groepen talrijke voorstellingen bij van soms ongenuanceerde voorstellingen."
    ],
    "es": [
      "El café-teatro La Guinguette es un lugar de expresión para principiantes, aficionados y artistas consagrados. Aquí, el pequeño público puede disfrutar de una amplia gama de espectáculos a veces inclasificables."
    ]
  },
  "rdfs:label": {
