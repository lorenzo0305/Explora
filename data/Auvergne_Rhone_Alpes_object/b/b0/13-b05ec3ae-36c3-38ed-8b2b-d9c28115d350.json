  "rdfs:comment": {
    "de": [
      "Eine erstaunliche Kulisse, in der man zu jeder Tageszeit die Spezialitäten der französisch-schweizerischen Alpen genießen kann. Hier finden Sie alle unsere Rezepte für Fondues, Grillgerichte und Salate, für die unsere Berge berühmt sind."
    ],
    "en": [
      "Enjoy the specialties of the Franco-Swiss Alps in astonishing decor at any time of day.  You can discover all the recipes for fondues, grills and salads that make our mountains famous."
    ],
    "it": [
      "Uno scenario sorprendente in cui gustare le specialità delle Alpi franco-svizzere in ogni momento della giornata. Trovate tutte le nostre ricette di fondute, grigliate e insalate che rendono famose le nostre montagne."
    ],
    "fr": [
      "Un décor étonnant dans lequel se dégustent à toute heure de la journée les spécialités des Alpes Franco-Suisses. Retrouvez toutes nos recettes de fondues, grillades et salades qui font la réputation de nos montagnes."
    ],
    "es": [
      "Un marco incomparable para degustar las especialidades de los Alpes francosuizos a cualquier hora del día. Descubra todas nuestras recetas de fondues, parrilladas y ensaladas que han hecho famosas nuestras montañas."
    ],
    "nl": [
      "Een prachtige omgeving om op elk moment van de dag te genieten van de specialiteiten van de Frans-Zwitserse Alpen. Ontdek al onze recepten voor fondues, grillgerechten en salades die onze bergen beroemd hebben gemaakt."
    ]
  },
  "rdfs:label": {
