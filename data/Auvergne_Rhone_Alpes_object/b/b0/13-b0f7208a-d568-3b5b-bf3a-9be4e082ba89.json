  "rdfs:comment": {
    "de": [
      "Lauriane und David laden Sie ein, ihre authentische und großzügige Küche zu entdecken. Bei Ihrem Besuch genießen Sie einen herzlichen Empfang und einen einzigartigen Blick auf den See von Aiguebelette."
    ],
    "en": [
      "Lauriane and David invite you to discover their authentic and generous cuisine. During your visit, you will enjoy a warm welcome and a unique view of Lake Aiguebelette."
    ],
    "it": [
      "Lauriane e David vi invitano a scoprire la loro cucina autentica e generosa. Durante la vostra visita, potrete godere di un'accoglienza calorosa e di una vista unica sul lago di Aiguebelette."
    ],
    "fr": [
      "Lauriane et David vous invitent à découvrir leur cuisine authentique et généreuse. Lors de votre venue, vous profiterez d'un accueil chaleureux et d'une vue unique sur le lac d'Aiguebelette."
    ],
    "es": [
      "Lauriane y David le invitan a descubrir su cocina auténtica y generosa. Durante su visita, disfrutará de una cálida bienvenida y de una vista única del lago de Aiguebelette."
    ],
    "nl": [
      "Lauriane en David nodigen u uit om hun authentieke en genereuze keuken te ontdekken. Tijdens uw bezoek geniet u van een warm onthaal en een uniek uitzicht op het meer van Aiguebelette."
    ]
  },
