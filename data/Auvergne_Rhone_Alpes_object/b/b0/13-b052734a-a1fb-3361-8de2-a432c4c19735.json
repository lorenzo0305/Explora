  "rdfs:comment": {
    "de": [
      "Ausübung von Pétanque und Jeu Provençal in der Freizeit und im Wettkampf (Erwachsene und Kinder).\r\nOrganisation der \"8 Tage der Stadt Nyons\" Ende September/Anfang Oktober."
    ],
    "en": [
      "\"Pétanque\" practice and \"jeu provençal\" as a leisure or in competitions (adults and children). Organization of the \"8 jours de la ville de Nyons\" late September/early October."
    ],
    "it": [
      "Pratica della petanque e dei giochi provenzali per il tempo libero e la competizione (adulti e bambini).\r\nOrganizzazione della \"8 giorni della città di Nyons\" a fine settembre/inizio ottobre."
    ],
    "fr": [
      "Pratique de la pétanque et du jeu provençal en loisir et compétition (adulte et enfants).\r\nOrganisation des \"8 jours de la ville de Nyons\" fin septembre/début octobre."
    ],
    "es": [
      "Práctica de la petanca y los juegos provenzales de ocio y competición (adultos y niños).\r\nOrganización de los \"8 días de la ciudad de Nyons\" a finales de septiembre y principios de octubre."
    ],
    "nl": [
      "Het beoefenen van pétanque en het provençaalse spel als ontspanning en als wedstrijd  (volwassenen en kinderen).\r\nOrganisatie van \" 8 jours de la ville de Nyons\" ( 8 dagen van de stad Nyons) eind september/begin october."
    ]
  },
