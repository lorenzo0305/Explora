  "rdfs:comment": {
    "de": [
      "15:00 bis 18:30 Uhr, Der Chefkoch lädt Sie und Ihre Familie dazu ein, die Geheimnisse der roten Früchte mit leckeren, kreativen Rezepten zu entdecken. Verbringen Sie einen süßen und spielerischen Moment mit der Familie!  70? für das Duo (1 Kind und 1 Erwachsener). Reservierung unter 04 71 66 86 66."
    ],
    "en": [
      "from 3pm to 6:30pm, the chef invites you and your family to discover the secrets of red fruits, with creative, gourmet recipes. Come and enjoy a sweet and playful moment with your family!  70? for duo (1 child and 1 adult). Book on 04 71 66 86 66."
    ],
    "it": [
      "dalle 15.00 alle 18.30, lo chef inviterà voi e la vostra famiglia a scoprire i segreti dei frutti rossi, con ricette deliziose e creative. Venite a godervi un momento dolce e giocoso con la vostra famiglia!  70 per un duo (1 bambino e 1 adulto). Prenotare al numero 04 71 66 86 66."
    ],
    "fr": [
      "15h à 18h30, le chef vous invite en famille à découvrir les secrets des fruits rouges avec des recettes gourmandes, créatives. Venez passer un moment sucré et ludique en famille !  70€ pour le duo (1 enfant et 1 adulte). Réservation au 04 71 66 86 66."
    ],
    "nl": [
      "van 15.00 tot 18.30 uur nodigt de chef jou en je gezin uit om de geheimen van rood fruit te ontdekken, met heerlijke en creatieve recepten. Kom en geniet van een zoet en speels moment met je gezin!  70 voor een duo (1 kind en 1 volwassene). Reserveer op 04 71 66 86 66."
    ],
    "es": [
      "de 15:00 a 18:30, el chef le invitará a usted y a su familia a descubrir los secretos de los frutos rojos, con deliciosas y creativas recetas. Venga a disfrutar de un momento dulce y lúdico en familia  70 ¤ por dúo (1 niño y 1 adulto). Reserve en el 04 71 66 86 66."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cours de cuisine en duo: les fruits rouges"
    ]
  },
