  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit dem jungen Wundermusiker Célestin auf die Suche nach dem Erbe seines Großvaters. Bevor er starb, hinterließ er Célestin einen Brief und einen Schuhkarton voller merkwürdiger Gegenstände. Wozu könnte das gut sein? Es liegt an Ihnen, das herauszufinden!"
    ],
    "en": [
      "Join Célestin, a young musical prodigy, in his search for his grandfather's legacy. Before he died, he left Célestin a letter and a shoebox full of curious objects. What could they be used for? It's up to you to find out!"
    ],
    "it": [
      "Partite con Célestin, un giovane prodigio della musica, alla ricerca dell'eredità del nonno. Prima di morire, ha lasciato a Célestin una lettera e una scatola da scarpe piena di oggetti curiosi. A cosa potrebbero servire? Sta a voi scoprirlo!"
    ],
    "fr": [
      "Partez avec Célestin, jeune musicien prodige, à la recherche de l'héritage de son grand-père. Avant de mourir, il a laissé à Célestin une lettre et une boite à chaussures pleine de curieux objets. A quoi cela peut servir ? A vous de le découvrir !"
    ],
    "nl": [
      "Ga samen met Célestin, een jong muzikaal wonderkind, op zoek naar de nalatenschap van zijn grootvader. Voordat hij stierf, liet hij Célestin een brief en een schoenendoos vol merkwaardige voorwerpen na. Waar kunnen ze voor gebruikt worden? Aan jou om dat uit te zoeken!"
    ],
    "es": [
      "Acompaña a Célestin, un joven prodigio de la música, en busca del legado de su abuelo. Antes de morir, dejó a Célestin una carta y una caja de zapatos llena de objetos curiosos. ¿Para qué podrían servir? Averígualo tú"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Explore game : jeu de piste \"Le curieux héritage de Célestin\""
    ]
  },
