  "rdfs:comment": {
    "de": [
      "Orthopädischer Schuh für den vorübergehenden Gebrauch.\r\nDas Ziel: ein einfaches, bequemes Schuhwerk mit guter Passform anzubieten, um die Erwartungen der Operationsteams zu erfüllen und das Wohlbefinden der Patienten zu verbessern."
    ],
    "en": [
      "Orthopedic footwear for temporary use.\r\nThe aim: to offer simple, comfortable, good-fitting footwear to meet the expectations of surgical teams and improve patient well-being."
    ],
    "it": [
      "Scarpa ortopedica per uso temporaneo.\r\nL'obiettivo: offrire una scarpa semplice, comoda e con una buona vestibilità per soddisfare le aspettative delle équipe chirurgiche e migliorare il benessere dei pazienti."
    ],
    "fr": [
      "Chaussure orthopédique à usage temporaire.\r\nLe but : offrir un chaussage simple, confortable, avec une bonne tenue pour répondre aux attentes des équipes chirurgicales et améliorer le bien-être des patients."
    ],
    "es": [
      "Zapato ortopédico de uso temporal.\r\nEl objetivo: ofrecer un zapato sencillo, cómodo y con un buen ajuste para satisfacer las expectativas de los equipos quirúrgicos y mejorar el bienestar de los pacientes."
    ],
    "nl": [
      "Orthopedische schoen voor tijdelijk gebruik.\r\nHet doel is om eenvoudig, comfortabel schoeisel met een goede pasvorm te bieden om aan de verwachtingen van chirurgische teams te voldoen en het welzijn van patiënten te verbeteren."
    ]
  },
