  "rdfs:comment": {
    "de": [
      "Das Plateau d'Hauteville ist das \"Dach\" des Haut Bugey, eine Dachlandschaft, die dem Blick des Wanderers und Reiter, des Radfahrers, des Skifahrers und des Autofahrers immer wieder neue Ansichten bietet."
    ],
    "en": [
      "The Plateau d'Hauteville is the \"roof\" of the Haut Bugey, a landscape roof that offers to the pedestrian and equestrian, cyclist, skier and motorist, always different views."
    ],
    "it": [
      "Il Plateau d'Hauteville è il \"tetto\" dell'Haut Bugey, un tetto paesaggistico che offre al pedone, al cavaliere, al ciclista, allo sciatore e all'automobilista panorami sempre diversi."
    ],
    "fr": [
      "Le Plateau d'Hauteville est le \"toit\" du Haut Bugey, un toit paysage qui offre au regard du promeneur pédestre et équestre, du cycliste, du skieur et de l'automobiliste, des vues toujours différentes."
    ],
    "nl": [
      "Het Plateau d'Hauteville is het \"dak\" van de Haut Bugey, een landschappelijk dak dat de voetganger, de ruiter, de fietser, de skiër en de automobilist steeds wisselende uitzichten biedt."
    ],
    "es": [
      "El Plateau d'Hauteville es el \"techo\" del Haut Bugey, un techo paisajístico que ofrece al peatón, al jinete, al ciclista, al esquiador y al automovilista unas vistas siempre cambiantes."
    ]
  },
  "rdfs:label": {
