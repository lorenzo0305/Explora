  "rdfs:comment": {
    "de": [
      "Tauchen Sie um 15 Uhr mit einer Führung durch das Schloss in die Geschichte ein (Reservierung erforderlich unter 06 07 15 17 74).\r\nErkunden Sie den Park bei den geführten Touren um 14 und 16 Uhr (Treffpunkt auf der Terrasse).\r\nVon 12 bis 18 Uhr können Sie den Park in Ihrem eigenen Tempo erkunden."
    ],
    "en": [
      "Dive into history at 3pm with a guided tour of the château (reservation required on 06 07 15 17 74).\r\nExplore the park with guided tours at 2pm and 4pm (meet on the terrace).\r\nFrom 12pm to 6pm, enjoy the park at your own pace."
    ],
    "it": [
      "Immergetevi nella storia alle 15.00 con una visita guidata del castello (prenotazione obbligatoria allo 06 07 15 17 74).\r\nEsplorate il parco con visite guidate alle 14.00 e alle 16.00 (ritrovo sulla terrazza).\r\nDalle 12.00 alle 18.00, godetevi il parco a vostro piacimento."
    ],
    "fr": [
      "Plongez dans l’histoire à 15h avec la visite guidée du château (sur réservation au 06 07 15 17 74).\r\nExplorez le parc lors des visites commentées à 14h et 16h (rendez-vous sur la terrasse).\r\nDe 12h à 18h, profitez librement du parc à votre rythme."
    ],
    "es": [
      "Sumérjase en la historia a las 15:00 h con una visita guiada del castillo (previa reserva en el 06 07 15 17 74).\r\nA las 14:00 y a las 16:00, descubra el parque con una visita guiada (cita en la terraza).\r\nDe 12:00 a 18:00, disfrute del parque a su ritmo."
    ],
    "nl": [
      "Dompel jezelf onder in de geschiedenis om 15.00 uur met een rondleiding door het kasteel (reserveren verplicht op 06 07 15 17 74).\r\nVerken het park tijdens rondleidingen om 14.00 en 16.00 uur (afspraak op het terras).\r\nVan 12.00 tot 18.00 uur kun je op je eigen tempo van het park genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite du château et du Parc et jardins château de Figon"
    ]
  },
