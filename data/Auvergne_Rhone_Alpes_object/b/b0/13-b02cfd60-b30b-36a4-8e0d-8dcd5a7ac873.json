  "rdfs:comment": {
    "de": [
      "Poetischer Spaziergang - Duo Cordes sensibles :\r\n\r\nErleben Sie diese Kreation, in der die Worte tanzen, zwischen Musik und Liedern, zwischen dem Leben und der Lust, die Liebe in unsere Straßen, unsere Viertel und, warum nicht?\r\nlasst uns verrückt sein, im Herzen der Welt?"
    ],
    "en": [
      "Balade poétique - Duo Cordes sensibles :\r\n\r\nCome to this creation where words dance, between music and songs, between life and the desire to invite love to the heart of our streets, our neighborhoods and why not?\r\nthe heart of the world?"
    ],
    "it": [
      "Passeggiata poetica - Duo Cordes sensibles :\r\n\r\nVenite a vedere questa creazione dove le parole danzano, tra musica e canto, tra la vita e il desiderio di invitare l'amore nel cuore delle nostre strade, dei nostri quartieri e, perché no?\r\nperché no, nel cuore del mondo?"
    ],
    "fr": [
      "Balade poétique - Duo Cordes sensibles : \r\n\r\nVenez assister à cette création où les mots dansent, entre musique et chansons, entre la vie et l’envie d’inviter l’amour au cœur de nos rues, nos quartiers et pourquoi pas\r\nsoyons fous, au cœur du Monde…"
    ],
    "nl": [
      "Poëtische wandeling - Duo Cordes sensibles :\r\n\r\nKom kijken naar deze creatie waar woorden dansen, tussen muziek en zang, tussen leven en het verlangen om liefde uit te nodigen in het hart van onze straten, onze buurten en waarom niet?\r\nwaarom niet, in het hart van de wereld?"
    ],
    "es": [
      "Paseo poético - Duo Cordes sensibles :\r\n\r\nVengan a ver esta creación donde bailan las palabras, entre música y canción, entre vida y deseo de invitar al amor al corazón de nuestras calles, de nuestros barrios y ¿por qué no?\r\n¿al corazón del mundo?"
    ]
  },
