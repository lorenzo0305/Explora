  "rdfs:comment": {
    "de": [
      "OUTDOOR-Restaurants auf dem Campingplatz des Gouffre de la Croix - gegenüber von Choranche und den Felsen von Presles\r\nVon Mai bis September jeden Abend geöffnet, NUR nach vorheriger Reservierung\r\nEintritt zu Fuß, kostenloser Parkplatz am Eingang"
    ],
    "en": [
      "OUTDOOR dining at Camping du Gouffre de la Croix - facing Choranche and the Presles cliffs\r\nOpen every evening from May to September BY RESERVATION ONLY\r\nWalk in, free parking at the entrance"
    ],
    "it": [
      "Ristorazione esterna al campeggio Gouffre de la Croix - di fronte a Choranche e alle falesie di Presles\r\nAperto tutte le sere da maggio a settembre SOLO SU PRENOTAZIONE\r\nIngresso a piedi, parcheggio gratuito all'ingresso"
    ],
    "fr": [
      "Restauration OUTDOOR au sein du Camping du Gouffre de la Croix - face à Choranche et aux falaises de Presles\r\nOuverts tous les soirs de mai a septembre UNIQUEMENT SUR RESERVATION \r\nEntrée à pied, parking gratuit à l’entrée"
    ],
    "es": [
      "Restauración AL AIRE LIBRE en el camping Gouffre de la Croix - frente a Choranche y los acantilados de Presles\r\nAbierto todas las noches de mayo a septiembre SÓLO CON RESERVA\r\nEntrada a pie, aparcamiento gratuito en la entrada"
    ],
    "nl": [
      "Catering in de openlucht op camping Gouffre de la Croix - tegenover Choranche en de kliffen van Presles\r\nElke avond geopend van mei tot september ALLEEN op reservering\r\nIngang te voet, gratis parkeren bij de ingang"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Snack Pizza du Camping Gouffre de la Croix"
    ]
  },
