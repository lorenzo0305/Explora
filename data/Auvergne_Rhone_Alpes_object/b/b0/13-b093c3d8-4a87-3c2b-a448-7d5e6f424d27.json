  "rdfs:comment": {
    "de": [
      "Véronique und Stéphane hatten einen Traum: ein innovatives, handwerkliches und ökologisches Unternehmen zu gründen. Sie hatten auch die Idee, die Wohltaten der Kaltverseifung für die Haut einem möglichst breiten Publikum bekannt zu machen..."
    ],
    "en": [
      "Véronique and Stéphane had a dream: to create an innovative, artisanal and ecological company. They also had the idea of spreading the word about the benefits of cold saponification for the skin..."
    ],
    "it": [
      "Véronique e Stéphane avevano un sogno: creare un'attività innovativa, tradizionale ed ecologica. Avevano anche l'idea di far conoscere a quante più persone possibile i benefici della saponificazione a freddo per la pelle..."
    ],
    "fr": [
      "Véronique et Stéphane avaient un rêve : celui de créer une entreprise innovante, artisanale et écologique. Ils avaient également l'idée de faire connaitre au plus grand nombre les bienfaits de la saponification à froid sur la peau..."
    ],
    "es": [
      "Véronique y Stéphane tenían un sueño: crear una empresa innovadora, tradicional y respetuosa con el medio ambiente. También tenían la idea de dar a conocer al mayor número posible de personas los beneficios de la saponificación en frío para la piel..."
    ],
    "nl": [
      "Véronique en Stéphane hadden een droom: een innovatief, traditioneel en milieuvriendelijk bedrijf oprichten. Ze hadden ook het idee om zoveel mogelijk mensen bewust te maken van de voordelen van koude verzeping voor de huid..."
    ]
  },
