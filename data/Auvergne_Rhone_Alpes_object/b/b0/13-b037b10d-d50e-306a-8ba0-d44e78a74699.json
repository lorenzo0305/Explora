  "rdfs:comment": {
    "de": [
      "Christelle, zertifizierte Massagepraktikerin, ist leidenschaftliche Wellness-, Massage- und Energietherapeutin und lädt Sie zu einer inneren Reise durch umfassende, intuitive und mit dem Herzen verankerte Behandlungen in der Residenz Matsuzaka in Les Eucherts ein"
    ],
    "en": [
      "Passionate about the world of well-being, Christelle, a certified massage practitioner, offers you a journey of relaxation and letting go at your home and at the Relais du Petit Saint-Bernard. Massages performed with skill and kindness."
    ],
    "it": [
      "Appassionata del mondo del benessere, Christelle, operatrice certificata di massaggi, vi propone un viaggio di rilassamento e lasciarsi andare a casa vostra e al Relais du Petit Saint-Bernard. Massaggi eseguiti con competenza e gentilezza."
    ],
    "fr": [
      "Passionnée par l'univers du bien-être, massages et soins énergétiques, Christelle, praticienne certifiée en massage vous invite à un voyage intérieur à travers des soins complets, intuitifs et ancrés avec le cœur au Matsuzaka résidence située aux Eucherts"
    ],
    "nl": [
      "Christelle, gediplomeerd massagebeoefenaar en gepassioneerd door de wereld van welzijn, massage en energiebehandelingen, nodigt je uit op een innerlijke reis door middel van uitgebreide, intuïtieve behandelingen die geworteld zijn in het hart in de Matsuzaka residentie in Les Eucherts"
    ],
    "es": [
      "Apasionada del mundo del bienestar, del masaje y de los tratamientos energéticos, Christelle, masajista diplomada, le invita a un viaje interior a través de tratamientos completos, intuitivos y arraigados en el corazón en la residencia Matsuzaka de Les Eucherts"
    ]
  },
  "rdfs:label": {
    "en": [
