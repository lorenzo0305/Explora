  "rdfs:comment": {
    "de": [
      "Zwischen Pont-en-Royans und Villard de Lans, im Herzen der Bourne-Schlucht, betreten Sie eine märchenhafte Welt und entdecken Sie eine smaragdgrüne, kristallklare unterirdische Welt, in der die Galerien im Rhythmus Ihrer Schritte leuchten!"
    ],
    "en": [
      "Between Pont-en-Royans and Villard de Lans, at the heart of the Gorges de la Bourne, enter a magical universe and discover an underground world with emerald and crystalline reflections, where the tunnels light up to the rhythm of your steps!"
    ],
    "it": [
      "Tra Pont-en-Royans e Villard de Lans, nel cuore delle Gole del Bourne, entrate in un mondo magico e scoprite un mondo sotterraneo dai riflessi smeraldini e cristallini, dove le gallerie si illuminano al ritmo dei vostri passi!"
    ],
    "fr": [
      "Entre Pont-en-Royans et Villard de Lans, au cœur des Gorges de la Bourne, entrez dans un univers féerique et découvrez un monde souterrain aux reflets émeraude et cristallins, où les galeries s'illuminent au rythme de vos pas !"
    ],
    "nl": [
      "Tussen Pont-en-Royans en Villard de Lans, in het hart van de Gorges du Bourne, betreedt u een magische wereld en ontdekt u een ondergrondse wereld met smaragdgroene en kristalheldere weerspiegelingen, waar de galerijen oplichten op het ritme van uw stappen!"
    ],
    "es": [
      "Entre Pont-en-Royans y Villard de Lans, en el corazón de las Gargantas del Bourne, entre en un mundo mágico y descubra un mundo subterráneo con reflejos esmeralda y cristalinos, donde las galerías se iluminan al ritmo de sus pasos"
    ]
  },
  "rdfs:label": {
    "de": [
      "Die Höhle von Choranche"
    ],
    "en": [
      "Choranche cave"
    ],
    "fr": [
      "La Grotte de Choranche"
    ]
  },
