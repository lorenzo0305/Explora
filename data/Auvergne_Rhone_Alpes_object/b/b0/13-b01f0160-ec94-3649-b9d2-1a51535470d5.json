  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich mit der Eröffnung des Multiplexkinos von Thonon-les-Bains eine echte Kinovorführung. Ciné Léman, das sind nun 8 Kinosäle, 4 Vorstellungen pro Tag und 12 angeschlagene Filme jede Woche. Dazu kommen noch die 3D-Filme ..."
    ],
    "en": [
      "Treat yourself to a real cinema experience with the Thonon-les-Bains multiplex. Ciné Léman has eight theaters, four sequences per day and twelve films shown each week, not to mention the 3D films..."
    ],
    "it": [
      "Concedetevi una vera esperienza cinematografica con il multiplex di Thonon-les-Bains. Il Ciné Léman dispone di otto sale, quattro sequenze al giorno e dodici film proiettati ogni settimana, senza dimenticare i film in 3D..."
    ],
    "fr": [
      "Offrez-vous une véritable séance de cinéma avec le multiplexe de Thonon-les-Bains. Le Ciné Léman c'est huit salles, quatre séquences par jour et douze films à l'affiche chaque semaine, sans oublier les films en 3D..."
    ],
    "nl": [
      "Trakteer uzelf op een echte bioscoopervaring met de multiplex van Thonon-les-Bains. Ciné Léman heeft acht zalen, vier zalen per dag en twaalf films per week, zonder de 3D-films te vergeten..."
    ],
    "es": [
      "Disfrute de una auténtica experiencia cinematográfica en los multicines de Thonon-les-Bains. Ciné Léman cuenta con ocho salas, cuatro secuencias diarias y doce películas proyectadas cada semana, sin olvidar las películas en 3D..."
    ]
  },
