  "rdfs:comment": {
    "de": [
      "Diese Passage wurde von den Architekten Jean Barrody und Antoine Percilly in den Höfen der Hotels Givois-Prêtre und Mombrun angelegt, als diese 1887 von Raymond Giboin zusammengelegt wurden."
    ],
    "en": [
      "Architects Jean Barrody and Antoine Percilly designed this passageway in the courtyards of the Givois-Prêtre and Mombrun hotels, when they were merged by Raymond Giboin in 1887."
    ],
    "it": [
      "Questo passaggio è stato progettato dagli architetti Jean Barrody e Antoine Percilly nei cortili degli hotel Givois-Prêtre e Mombrun, quando furono fusi da Raymond Giboin nel 1887."
    ],
    "fr": [
      "Ce passage est aménagé par les architectes Jean Barrody et Antoine Percilly dans les cours des hôtels Givois-Prêtre et Mombrun, à l’occasion de leur fusion effectuée par Raymond Giboin en 1887."
    ],
    "es": [
      "Este pasaje fue diseñado por los arquitectos Jean Barrody y Antoine Percilly en los patios de los hoteles Givois-Prêtre y Mombrun, cuando fueron fusionados por Raymond Giboin en 1887."
    ],
    "nl": [
      "Deze passage werd ontworpen door architecten Jean Barrody en Antoine Percilly in de binnenplaatsen van de hotels Givois-Prêtre en Mombrun, toen deze werden samengevoegd door Raymond Giboin in 1887."
    ]
  },
