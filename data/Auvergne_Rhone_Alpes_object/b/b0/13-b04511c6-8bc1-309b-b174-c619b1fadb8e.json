  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant und Pizzeria mit Holzfeuerung seit 1991. Wir bieten Ihnen zahlreiche Gerichte und Pizzen, die Sie vor Ort genießen oder mitnehmen können.\r\nFrische Qualitätsprodukte aus der Region."
    ],
    "en": [
      "Traditional restaurant and wood-fired pizzeria since 1991. We offer a wide range of dishes and pizzas, to eat in or take away.\r\nFresh quality local produce."
    ],
    "it": [
      "Ristorante tradizionale e pizzeria a legna dal 1991. Offriamo una vasta gamma di piatti e pizze, da mangiare o da portare via.\r\nProdotti locali freschi e di qualità."
    ],
    "fr": [
      "Restaurant traditionnel et Pizzéria au feu de bois depuis 1991. Nous vous proposons de nombreux plats et pizzas, à déguster sur place ou à emporter.\r\nProduits frais de qualité et locaux."
    ],
    "nl": [
      "Traditioneel restaurant en houtgestookte pizzeria sinds 1991. We bieden een breed scala aan gerechten en pizza's, om te eten of om mee te nemen.\r\nVerse kwaliteitsproducten uit de streek."
    ],
    "es": [
      "Restaurante tradicional y pizzería de leña desde 1991. Ofrecemos una amplia gama de platos y pizzas, para comer en casa o para llevar.\r\nProductos locales frescos y de calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Grillon"
    ]
  },
