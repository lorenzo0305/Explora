  "rdfs:comment": {
    "de": [
      "Ein geschlossener Bereich, weit weg von erfahrenen Skifahrern: ideal für Ihr sanftes Skifahrenlernen!\r\nRDV im YETI CAMP, gegenüber dem Hameau de Méribel Mottaret, am Skilift von Arolles und dem Teppich von Table Verte."
    ],
    "en": [
      "THE YETI CAMP : a perfect area to learn skiing or snowboarding ! \r\nIn front of Le Hameau from Méribel-Mottaret, on the Arolles skilift and the Table Verte magic carpet."
    ],
    "it": [
      "Un'area chiusa, lontana dagli sciatori esperti: ideale per imparare a sciare dolcemente!\r\nRitrovo allo YETI CAMP, di fronte alla frazione di Méribel Mottaret, sull'impianto di risalita di Arolles e sul tappeto della Table Verte."
    ],
    "fr": [
      "Un espace fermé, loin des skieurs chevronnés : idéal pour votre apprentissage de la glisse en douceur ! \r\nRDV au YETI CAMP, en face du Hameau de Méribel Mottaret, sur le téléski des Arolles et le tapis de Table Verte."
    ],
    "es": [
      "Una zona cerrada, lejos de los esquiadores experimentados: ¡ideal para aprender a esquiar suavemente!\r\nEncuentro en el YETI CAMP, frente a la aldea de Méribel Mottaret, en el remonte de Arolles y la alfombra de la Table Verte."
    ],
    "nl": [
      "THE YETI CAMP : a perfect area to learn skiing or snowboarding ! \r\nIn front of Le Hameau from Méribel-Mottaret, on the Arolles skilift and the Table Verte magic carpet."
    ]
  },
  "rdfs:label": {
