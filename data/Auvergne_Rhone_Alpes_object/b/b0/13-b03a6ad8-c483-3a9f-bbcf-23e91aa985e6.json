  "rdfs:comment": {
    "de": [
      "Entdecken Sie auf den Hängen von Thyez in 960 m Höhe die von Isabelle zubereiteten Gerichte aus der Region.\r\nIhr Team steht Ihnen in einem traditionellen und gemütlichen Rahmen zur Verfügung."
    ],
    "en": [
      "Discover on the hillsides of Thyez, the local dishes prepared by Isabelle.\r\nHer team is at your disposal in a traditional and warm environment."
    ],
    "it": [
      "Venite a scoprire i piatti locali preparati da Isabelle sulle pendici di Thyez, a 960 metri di altitudine.\r\nIl suo team è a vostra disposizione in un ambiente tradizionale e caloroso."
    ],
    "fr": [
      "Venez découvrir sur les coteaux de Thyez à 960 m d'altitude, les plats du terroir préparés par Isabelle.\r\nSon équipe est à votre disposition dans un cadre traditionnel et chaleureux."
    ],
    "es": [
      "Venga a descubrir los platos locales preparados por Isabelle en las laderas de Thyez, a 960 metros de altitud.\r\nSu equipo está a su disposición en un ambiente tradicional y cálido."
    ],
    "nl": [
      "Kom de streekgerechten ontdekken die Isabelle bereidt op de hellingen van Thyez op 960 meter hoogte.\r\nHaar team staat tot uw beschikking in een traditioneel en warm kader."
    ]
  },
  "rdfs:label": {
