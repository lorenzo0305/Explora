  "rdfs:comment": {
    "de": [
      "Geigenbauwerkstatt für Streichinstrumente: Violine, Viola, Violoncello und Kontrabass. Beratung, Wartung, Klangeinstellungen, Restaurierung, Herstellung, Verleih und Verkauf von Instrumenten und Zubehör. Herzlich willkommen in der Werkstatt!"
    ],
    "en": [
      "Workshop for stringed instruments: violin, viola, cello and double bass. Advice, maintenance, sound adjustments, restoration, manufacturing, rentals and sales of instruments and accessories. Welcome to the workshop!"
    ],
    "it": [
      "Laboratorio di strumenti ad arco: violino, viola, violoncello e contrabbasso. Consulenza, manutenzione, regolazione del suono, restauro, fabbricazione, noleggio e vendita di strumenti e accessori. Benvenuti nel laboratorio!"
    ],
    "fr": [
      "Atelier de lutherie pour les instruments à cordes frottées : violon, alto, violoncelle et contrebasse. Conseils, entretien, réglages sonores, restauration, fabrication, locations et ventes d'instruments et d'accessoires. Bienvenus à l'atelier !"
    ],
    "nl": [
      "Werkplaats voor strijkinstrumenten: viool, altviool, cello en contrabas. Advies, onderhoud, klankaanpassingen, restauratie, fabricage, verhuur en verkoop van instrumenten en accessoires. Welkom in de werkplaats!"
    ],
    "es": [
      "Taller de instrumentos de cuerda: violín, viola, violonchelo y contrabajo. Asesoramiento, mantenimiento, ajustes de sonido, restauración, fabricación, alquiler y venta de instrumentos y accesorios. ¡Bienvenido al taller!"
    ]
  },
