  "rdfs:comment": {
    "de": [
      "Dieser 4 Hektar große Teich ist zum Angeln, Picknicken und Spazierengehen reserviert. Hier finden Sie Hechte, Karpfen, Schleien, Plötzen, Ukeleien, Gemeiner Barsch, Sonnenbarsch, Goujons usw."
    ],
    "en": [
      "With a total area of 7ha including 4ha of water, this body of water is reserved for fishing, picnic and promenade."
    ],
    "it": [
      "Questo lago di 4 ettari è riservato alla pesca, ai picnic e alle passeggiate. Vi si trovano lucci, carpe, tinche, lasche, alborelle, persici comuni, persici sole, scardole e altro ancora."
    ],
    "fr": [
      "Ce plan d'eau de 4 hectares est réservé à la pêche, au pique-nique et à la promenade. Vous y trouverez des brochets, carpes, tanches, gardons, ablettes, perches communes, perches soleil, goujons, etc. "
    ],
    "es": [
      "Este lago de 4 hectáreas está reservado a la pesca, los picnics y los paseos. Encontrarás lucios, carpas, tencas, rutilos, alburnos, percas comunes, percas sol, gobios y mucho más."
    ],
    "nl": [
      "Dit meer van 4 hectare is gereserveerd voor vissen, picknicken en wandelen. Je vindt er snoek, karper, zeelt, voorn, alver, rivierbaars, zonnebaars, riviergrondel en nog veel meer."
    ]
  },
  "rdfs:label": {
    "en": [
      "Charles Bailly Pond"
    ],
    "fr": [
      "Étang Charles Bailly"
    ]
  },
