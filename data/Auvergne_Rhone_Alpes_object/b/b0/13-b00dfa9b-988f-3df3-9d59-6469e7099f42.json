  "rdfs:comment": {
    "de": [
      "Profitieren Sie von einem symbolträchtigen Ort des Wirtschaftslebens in Clermont-Ferrand und mieten Sie Ihre Tagungsräume am Sitz der Industrie- und Handelskammer Puy-de-Dôme Clermont Auvergne Métropole."
    ],
    "en": [
      "Take advantage of an emblematic location in Clermont-Ferrand's economic life by renting your meeting rooms at the headquarters of the Puy-de-Dôme Clermont Auvergne Métropole Chamber of Commerce and Industry."
    ],
    "it": [
      "Approfittate di una posizione emblematica nella vita economica di Clermont-Ferrand affittando le vostre sale riunioni presso la sede della Camera di Commercio e dell'Industria del Puy-de-Dôme Clermont Auvergne Métropole."
    ],
    "fr": [
      "Profitez d'un lieu emblématique de la vie économique clermontoise en louant vos salles de réunions au siège de la Chambre de Commerce et d'Industrie Puy-de-Dôme Clermont Auvergne Métropole."
    ],
    "nl": [
      "Profiteer van een emblematische locatie in het economische leven van Clermont-Ferrand door uw vergaderzalen te huren in het hoofdkantoor van de Kamer van Koophandel en Industrie van Puy-de-Dôme Clermont Auvergne Métropole."
    ],
    "es": [
      "Aproveche una ubicación emblemática en la vida económica de Clermont-Ferrand alquilando sus salas de reuniones en la sede de la Cámara de Comercio e Industria de Puy-de-Dôme Clermont Auvergne Métropole."
    ]
  },
  "rdfs:label": {
    "fr": [
