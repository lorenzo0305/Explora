  "rdfs:comment": {
    "de": [
      "Galerie, die sich der Kunstcollage in all ihren Formen widmet. Michel Goldberg, Collagist, ist ein Künstler, der Werke aus Papier, Zeitungen, Kartons usw. schafft."
    ],
    "en": [
      "Gallery devoted to collage art in all its forms. Michel Goldberg, collagist, is an artist who creates works from paper, newspapers, cardboard, etc.\r\nThe Gallery regularly presents exhibitions by collage artists"
    ],
    "it": [
      "L'unica galleria in Francia dedicata esclusivamente ai collage in tutte le loro forme\r\nMichel Goldberg, collagista egli stesso, vi accoglie in numerose mostre durante tutto l'anno."
    ],
    "fr": [
      "La seule Galerie de France uniquement consacrée aux collages sous toutes ses formes \r\nMichel Goldberg, collagiste lui même, vous accueille pour de nombreuses expositions tout au long de l'année ."
    ],
    "es": [
      "Galería dedicada al arte del collage en todas sus formas. Michel Goldberg, collagista, es un artista que crea obras a partir de papel, periódicos, cartón, etc."
    ],
    "nl": [
      "De enige galerie in Frankrijk die uitsluitend gewijd is aan collages in al hun vormen\r\nMichel Goldberg, zelf collagist, verwelkomt je het hele jaar door op talrijke tentoonstellingen."
    ]
  },
