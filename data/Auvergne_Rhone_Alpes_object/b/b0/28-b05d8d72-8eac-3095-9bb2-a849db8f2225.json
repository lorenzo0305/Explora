      "rdfs:comment": {
        "de": [
          "Besuchen Sie unser Atelier in Boeschèpe, im Herzen von Flandern. Wir würden uns freuen, Sie (nach Vereinbarung) begrüßen zu dürfen, um Ihnen unsere Spiele, unsere Kreationen und unser Kunsthandwerk vorzustellen."
        ],
        "en": [
          "Come and discover our workshop in Boeschèpe, in the heart of Flanders. We would be happy to welcome you (by appointment) to make you discover our games, our creations, our crafts."
        ],
        "it": [
          "Venite a scoprire il nostro laboratorio a Boeschèpe, nel cuore delle Fiandre. Saremo lieti di accogliervi (su appuntamento) per mostrarvi i nostri giochi, le nostre creazioni, i nostri mestieri."
        ],
        "fr": [
          "Venez découvrir notre atelier à Boeschèpe, au cœur des Flandres. Nous serions heureux de vous accueillir (sur rendez-vous) pour vous faire découvrir nos jeux, nos créations, notre artisanat."
        ],
        "es": [
          "Venga a descubrir nuestro taller de Boeschèpe, en el corazón de Flandes. Estaremos encantados de recibirle (previa cita) para mostrarle nuestros juegos, nuestras creaciones, nuestras artesanías."
        ],
        "nl": [
          "Kom en ontdek ons atelier in Boeschèpe, in het hart van Vlaanderen. Wij ontvangen u graag (op afspraak) om u onze spelen, onze creaties, onze ambachten te tonen."
        ]
      },
