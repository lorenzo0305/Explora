  "rdfs:comment": {
    "de": [
      "Die 1962 gegründete und von Michel Warren entwickelte Cinémathèque de Grenoble ist ein Ort der Bewahrung und Aufwertung des Filmerbes sowie der Bildung am Bild."
    ],
    "en": [
      "Founded in 1962 and developed by Michel Warren, the Cinémathèque de Grenoble is a center for the conservation and promotion of cinematographic heritage, as well as image education."
    ],
    "it": [
      "Fondata nel 1962 e sviluppata da Michel Warren, la Cinémathèque de Grenoble è un luogo di conservazione e promozione del patrimonio cinematografico e di educazione all'immagine."
    ],
    "fr": [
      "Fondée en 1962, développée par Michel Warren, la Cinémathèque de Grenoble est un lieu de conservation, de valorisation du patrimoine cinématographique ainsi que d’éducation à l’image."
    ],
    "es": [
      "Fundada en 1962 y dirigida por Michel Warren, la Cinemateca de Grenoble es un centro de conservación y promoción del patrimonio cinematográfico, así como de educación en artes visuales."
    ],
    "nl": [
      "De Cinémathèque de Grenoble, opgericht in 1962 en ontwikkeld door Michel Warren, is een plaats voor het behoud en de promotie van het filmerfgoed en voor beeldeducatie."
    ]
  },
