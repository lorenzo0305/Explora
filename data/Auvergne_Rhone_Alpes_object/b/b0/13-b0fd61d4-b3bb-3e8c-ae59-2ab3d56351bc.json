  "rdfs:comment": {
    "de": [
      "Unser Restaurant empfängt Sie ausschließlich mit Buffetservice, auch für Gruppen: ein reibungsloser, einfacher und für alle zugänglicher Service. Hausgemachte, regionale Küche."
    ],
    "en": [
      "Our restaurant welcomes you with buffet-style service only, including for groups: a smooth, simple, and accessible service for everyone. Homemade, local cuisine."
    ],
    "it": [
      "Il vostro ristorante offre un servizio a buffet, anche per gruppi: un servizio semplice e accessibile a tutti. Cucina casalinga e locale."
    ],
    "fr": [
      "Votre restaurant vous accueille avec un service en buffet uniquement, pour les groupes également : service fluide, simple et accessible à tous. Cuisine maison et locale."
    ],
    "nl": [
      "Uw restaurant biedt alleen buffetservice, ook voor groepen: vlotte, eenvoudige service die voor iedereen toegankelijk is. Huisgemaakte, lokale keuken."
    ],
    "es": [
      "Su restaurante sólo ofrece servicio de bufé, también para grupos: servicio fluido, sencillo y accesible para todos. Cocina casera y local."
    ]
  },
