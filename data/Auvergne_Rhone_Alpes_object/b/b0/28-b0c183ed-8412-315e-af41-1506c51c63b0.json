  "rdfs:comment": {
    "de": [
      "Dieser tolle Hofladen wird Sie mitten ins Herz treffen. Für Feinschmecker, die das Lokale lieben, sind Sie hier am richtigen Ort!"
    ],
    "en": [
      "This wonderful farm store will touch your heart. For local food lovers, you've come to the right place!"
    ],
    "it": [
      "Questa meravigliosa fattoria vi toccherà il cuore. Per gli amanti del cibo locale, siete nel posto giusto!"
    ],
    "fr": [
      "Ce formidable magasin à la ferme saura vous toucher en plein coeur. Pour les gourmands amateurs de local, vous êtes au bon endroit !"
    ],
    "es": [
      "Esta maravillosa granja-tienda te llegará al corazón. Para los amantes de la comida local, ¡han venido al lugar adecuado!"
    ],
    "nl": [
      "Deze prachtige boerderijwinkel zal je hart raken. Liefhebbers van lokaal eten zijn hier aan het juiste adres!"
    ]
  },
