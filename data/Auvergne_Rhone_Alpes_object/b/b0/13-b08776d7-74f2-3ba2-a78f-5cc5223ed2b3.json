  "rdfs:comment": {
    "de": [
      "GAEC Ferme de la côte Linière ist ein landwirtschaftlicher Betrieb in Chantesse, der Milchkühe züchtet und Getreide sowie Nüsse anbaut. Er produziert nachhaltige landwirtschaftliche Lebensmittel aus umweltfreundlichen Praktiken."
    ],
    "en": [
      "GAEC Ferme de la côte Linière is a farm in Chantesse that raises dairy cows and grows cereals and nuts, producing sustainable agricultural food from environmentally-friendly practices."
    ],
    "it": [
      "La GAEC Ferme de la côte Linière è un'azienda agricola di Chantesse che alleva mucche da latte e coltiva cereali e noci, producendo alimenti sostenibili con pratiche ecologiche."
    ],
    "fr": [
      "GAEC Ferme de la côte Linière est une exploitation agricole à Chantesse qui élève des vaches laitières et cultive céréales ainsi que des noix, produisant des aliments agricoles durables issus de pratiques respectueuses de l’environnement."
    ],
    "nl": [
      "GAEC Ferme de la côte Linière is een boerderij in Chantesse die melkkoeien fokt en granen en walnoten verbouwt, en die duurzaam landbouwvoedsel produceert met behulp van milieuvriendelijke praktijken."
    ],
    "es": [
      "GAEC Ferme de la côte Linière es una granja de Chantesse que cría vacas lecheras y cultiva cereales y nueces, produciendo alimentos agrícolas sostenibles mediante prácticas respetuosas con el medio ambiente."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la côte Linière"
    ]
  },
