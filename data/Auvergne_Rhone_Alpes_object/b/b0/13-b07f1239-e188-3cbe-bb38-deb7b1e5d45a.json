  "rdfs:comment": {
    "de": [
      "Wein-, Gourmet-, Natur- und Neugierausflüge...\r\nEine Flucht aus dem Alltag, die Ihnen ähnelt. Mit Ihren Kindern, Ihren Freunden, Ihrer besseren Hälfte, Ihrer Großmutter, Ihren Kollegen und sogar Ihrem Hund."
    ],
    "en": [
      "Wine tours, gourmet tours, nature tours, curious tours...\r\nA beautiful escape that's a change of scenery for you. With your children, your friends, your other half, your grandmother, your colleagues and even your dog."
    ],
    "it": [
      "Gite tecnologiche, gastronomiche, naturalistiche, curiose...\r\nUna bella fuga che vi farà cambiare scenario e sarà proprio come voi. Con i vostri figli, i vostri amici, la vostra dolce metà, vostra nonna, i vostri colleghi e persino il vostro cane."
    ],
    "fr": [
      "Virées œnologiques, gourmandes, nature, curieuses...\r\nUne échappée belle qui vous dépayse et vous ressemble. Avec vos enfants, vos ami(e)s, votre moitié, votre grand-mère, vos collègues et même votre chien."
    ],
    "nl": [
      "Wijntours, eettours, natuurtours, nieuwsgierigheidstours...\r\nEen heerlijk uitje dat een verandering van omgeving is en helemaal bij jou past. Met je kinderen, je vrienden, je wederhelft, je oma, je collega's en zelfs je hond."
    ],
    "es": [
      "Viajes de carácter ecológico, gastronómico, de naturaleza, de curiosidad...\r\nUna hermosa escapada que te permitirá cambiar de aires y ser como tú. Con tus hijos, tus amigos, tu otra mitad, tu abuela, tus colegas e incluso tu perro."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les p'tites virées de Youpi"
    ]
  },
