  "rdfs:comment": {
    "de": [
      "Amerikanisches Lebensgefühl mit dem Flair der Berge.\r\nUnser Foodtruck, der von der Rhodos-Piste aus zu sehen ist, ist für Groß und Klein gedacht.\r\nDie Smash Burgers, Chicken Wings, Pommes und Sweets sind genau das Richtige für Skifahrer!\r\nAnhalten ist Pflicht."
    ],
    "en": [
      "American spirit with a mountain twist.\r\nVisible from the Rhodos slope, our Foodtruck is designed for young and old alike.\r\nSmash burgers, chicken wings, fries and sweets are just the thing for ski fans! Mandatory stop."
    ],
    "it": [
      "Lo spirito americano con un tocco di montagna.\r\nVisibile dalla pista di Rhodos, il nostro Foodtruck è perfetto per grandi e piccini.\r\nHamburger, alette di pollo, patatine fritte e dolci sono l'ideale per gli appassionati di sci!\r\nFermata obbligatoria."
    ],
    "fr": [
      "L’esprit américain à la sauce des montagnes. \r\nVisible de la piste des Rhodos, notre Foodtruck est fait pour les petits et les grands.\r\nLes Smash Burgers, chicken wings, frites et sweets conviendront aux fous du skis ! \r\nArrêt obligatoire."
    ],
    "es": [
      "El espíritu americano con un toque montañés.\r\nVisible desde la pista de Rhodos, nuestro Foodtruck es perfecto para grandes y pequeños.\r\nHamburguesas, alitas de pollo, patatas fritas y dulces para los amantes del esquí\r\nParada obligatoria."
    ],
    "nl": [
      "De Amerikaanse geest met een bergtintje.\r\nOnze Foodtruck is zichtbaar vanaf de Rhodos-piste en is perfect voor jong en oud.\r\nSmash burgers, chicken wings, frietjes en zoetigheden zijn precies wat de skifans nodig hebben! Verplichte stop."
    ]
  },
  "rdfs:label": {
