  "rdfs:comment": {
    "de": [
      "Ein Ort des Lebens und kollektiver Aktivitäten, an dem sich Bewohner, Unternehmer, Künstler, Vereine und die Öffentlichkeit treffen.\r\nEs werden Konzerte, Aufführungen, eine Bar für Vereine usw. organisiert.\r\nSpiele für Kinder und Aktivitäten für die ganze Familie."
    ],
    "en": [
      "A place for community life and activities, where residents, entrepreneurs, artists, associations and the general public come together.\r\nConcerts, shows, community bar..."
    ],
    "it": [
      "Un luogo per la vita e le attività della comunità, dove si riuniscono residenti, imprenditori, artisti, associazioni e il pubblico in generale.\r\nQui vengono organizzati concerti, spettacoli, bar della comunità, ecc."
    ],
    "fr": [
      "Lieu de vie et d'activités collectives où se rencontrent habitants, entrepreneurs, artistes, vie associative et public.\r\nSont organisés des concerts, spectacles, bar associatif..."
    ],
    "es": [
      "Un lugar de vida y actividades comunitarias, donde se reúnen residentes, empresarios, artistas, asociaciones y público en general.\r\nAquí se organizan conciertos, espectáculos, bar comunitario, etc."
    ],
    "nl": [
      "Een plek voor het gemeenschapsleven en activiteiten, waar bewoners, ondernemers, kunstenaars, verenigingen en het grote publiek samenkomen.\r\nEr worden concerten, voorstellingen, een buurtbar enz. georganiseerd.\r\nSpelletjes voor kinderen en gezinsactiviteiten."
    ]
  },
