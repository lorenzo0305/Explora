  "rdfs:comment": {
    "de": [
      "Das L'Accroche-C?ur bietet Ihnen eine großzügige und herzerwärmende Küche, die von den einfachen (und doch so schmackhaften) Rezepten unserer Großmütter inspiriert ist.Auf Ihrem Teller: nur sorgfältig ausgewählte lokale Qualitätsprodukte."
    ],
    "en": [
      "L’Accroche-Cœur offers generous, comforting cuisine inspired by the simple (yet delicious) recipes of our grandmothers. On your plate: only carefully selected, high-quality local produce."
    ],
    "it": [
      "L'Accroche-Cœur propone una cucina generosa e confortante, ispirata alle ricette semplici (ma comunque gustose) delle nostre nonne. Nel vostro piatto: solo prodotti locali di qualità, accuratamente selezionati."
    ],
    "fr": [
      "L’Accroche-Cœur vous propose une cuisine généreuse et réconfortante, inspirée des recettes simples (et pourtant si savoureuses) de nos grands-mères.Dans votre assiette : uniquement des produits locaux de qualité, soigneusement sélectionnés."
    ],
    "es": [
      "L'Accroche-Cœur ofrece una cocina generosa y acogedora inspirada en las sencillas y deliciosas recetas de nuestras abuelas, utilizando únicamente productos locales de calidad cuidadosamente seleccionados."
    ],
    "nl": [
      "L'Accroche-C?ur biedt een gulle, hartverwarmende keuken geïnspireerd door de eenvoudige maar heerlijke recepten van onze grootmoeders, waarbij alleen zorgvuldig geselecteerde lokale kwaliteitsproducten worden gebruikt."
    ]
  },
