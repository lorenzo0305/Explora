  "rdfs:comment": {
    "de": [
      "Besuchen Sie das Konzert von Ingalawash in der Brasserie Motueka am Freitag, den 10. April ab 20 Uhr.\r\nDie Band aus Le Puy-en-Velay besteht aus fünf Musikern, die eine enge Freundschaft verbindet."
    ],
    "en": [
      "Come and see Ingalawash in concert at Brasserie Motueka on Friday April 10 from 8pm.\r\nThe group, originally from Le Puy-en-Velay, is made up of five musicians bound by a strong friendship."
    ],
    "it": [
      "Venite a vedere gli Ingalawash in concerto alla Brasserie Motueka venerdì 10 aprile dalle 20.00.\r\nIl gruppo, proveniente da Le Puy-en-Velay, è composto da cinque musicisti con un forte legame di amicizia."
    ],
    "fr": [
      "Venez assister au concert d'Ingalawash à la Brasserie Motueka le vendredi 10 avril à partir de 20h.\r\nLe groupe, originaire du Puy-en-Velay est composé de cinq musiciens liés par une solide amitié."
    ],
    "es": [
      "Venga a ver a Ingalawash en concierto en la Brasserie Motueka el viernes 10 de abril a partir de las 20:00 h.\r\nEl grupo, originario de Le Puy-en-Velay, está formado por cinco músicos con un fuerte vínculo de amistad."
    ],
    "nl": [
      "Kom op vrijdag 10 april vanaf 20.00 uur naar het concert van Ingalawash in Brasserie Motueka.\r\nDe groep uit Le Puy-en-Velay bestaat uit vijf muzikanten met een sterke vriendschapsband."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert Ingalawash à la Brasserie Motueka"
    ]
  },
