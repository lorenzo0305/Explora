  "rdfs:comment": {
    "de": [
      "Der Club Hippique Viennois empfängt Sie in einer grünen und friedlichen Umgebung. Qualifizierte Reitlehrer bieten Ihnen zahlreiche Aktivitäten an: Reitstunden auf allen Niveaus, Ausritte, Dressur, Pony-Club..."
    ],
    "en": [
      "The Club Hippique Viennois welcomes you in a green and peaceful setting. Qualified instructors offer a wide range of activities: lessons for all levels, rides, dressage, pony club..."
    ],
    "it": [
      "Il Club Hippique Viennois vi accoglie in un ambiente verde e tranquillo. Istruttori qualificati vi offrono un'ampia gamma di attività: equitazione a tutti i livelli, trail ride, dressage, pony club..."
    ],
    "fr": [
      "Le Club Hippique Viennois vous accueille dans un cadre verdoyant et paisible. Des moniteurs qualifiés vous proposent de multiples activités : reprises de tous niveaux, randonnées, dressage, poney club..."
    ],
    "es": [
      "El Club Hippique Viennois le da la bienvenida en un entorno verde y tranquilo. Instructores cualificados le ofrecen una amplia gama de actividades: equitación a todos los niveles, paseos por senderos, doma, pony club..."
    ],
    "nl": [
      "De Club Hippique Viennois ontvangt u in een groene en rustige omgeving. Gekwalificeerde instructeurs bieden u een breed scala aan activiteiten: paardrijden op alle niveaus, trail ritten, dressuur, pony club..."
    ]
  },
