  "rdfs:comment": {
    "de": [
      "In einem savoyischen Rahmen und einer familiären und herzlichen Atmosphäre bietet Ihnen Le Grizzli Salate, Gegrilltes, savoyische Gerichte und Pizzas."
    ],
    "en": [
      "In a Savoy setting with its fireplace, Le Grizzli restaurant offers you salads, grills, regional specialities, pizzas to take away."
    ],
    "it": [
      "In un ambiente savoiardo e in una calda atmosfera familiare, Le Grizzli offre insalate, grigliate, piatti savoiardi e pizze."
    ],
    "fr": [
      "Dans un cadre savoyard et une ambiance familiale et chaleureuse, Le Grizzli vous propose ses salades, grillades, plats savoyards, et pizzas."
    ],
    "es": [
      "En un marco saboyano y un cálido ambiente familiar, Le Grizzli ofrece ensaladas, parrilladas, platos saboyanos y pizzas."
    ],
