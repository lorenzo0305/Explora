  "rdfs:comment": {
    "de": [
      "Für die 11. Ausgabe ändern wir alles! Das Dekor, das Badewasser und das Datum!\r\nWir treffen uns am 12. September zu einem sommerlicheren Gravity Race, dem es nicht an Würze fehlt."
    ],
    "en": [
      "For the 11th edition, we're changing everything! The decor, the bathwater and the date!\r\nRendezvous on September 12 for a more summery Gravity Race with plenty of spice."
    ],
    "it": [
      "Per l'undicesima edizione, cambiamo tutto! L'arredamento, la vasca da bagno e la data!\r\nCi vediamo il 12 settembre per una Gravity Race più estiva e ricca di pepe."
    ],
    "fr": [
      "Pour la 11ème édition, on change tout ! Le décor, l’eau du bain et la date !\r\nRendez-vous le 12 septembre pour une Gravity Race plus estivale et qui ne manque pas de piquant."
    ],
    "nl": [
      "Voor de 11e editie veranderen we alles! Het decor, het badwater en de datum!\r\nTot ziens op 12 september voor een meer zomerse Gravity Race met veel pit."
    ],
    "es": [
      "Para la 11ª edición, ¡lo cambiamos todo! La decoración, el agua de la bañera y la fecha\r\nNos vemos el 12 de septiembre para una Gravity Race más veraniega y con mucho picante."
    ]
  },
