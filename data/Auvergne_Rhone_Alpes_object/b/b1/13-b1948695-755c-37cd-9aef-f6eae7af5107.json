  "rdfs:comment": {
    "de": [
      "Besuchen Sie den Heil- und Esspflanzengarten eines Herstellers von Kräutertees und Naturkosmetik und entdecken Sie viele wilde und kultivierte Arten. Eine Verkostung in der Boutique-Ecke schließt die Entdeckung ab."
    ],
    "en": [
      "Visit the garden of medicinal and edible plants from a producer of herbal teas and natural cosmetics, and discover numerous wild and cultivated species. A tour of the drying room and boutique will round off your discovery."
    ],
    "it": [
      "Visitate il giardino di piante medicinali e commestibili di un produttore di tisane e cosmetici naturali e scoprite molte specie selvatiche e coltivate. Il tour si conclude con una visita all'essiccatoio e al negozio."
    ],
    "fr": [
      "Visitez le jardin de plantes médicinales et comestibles d'une productrice de tisanes et de cosmétiques naturels, et découvrez de nombreuses espèces sauvages et cultivées. Un tour au séchoir et au coin boutique clôturera la découverte."
    ],
    "es": [
      "Visite el jardín de plantas medicinales y comestibles de un productor de tisanas y cosméticos naturales, y descubra numerosas especies silvestres y cultivadas. El recorrido termina con una visita al secadero y la tienda."
    ],
    "nl": [
      "Kruidenthee, gedroogde planten, bezoek aan een ‘wilde’ plantentuin."
    ]
  },
  "rdfs:label": {
