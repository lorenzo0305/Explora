          "additionalInformation": {
            "de": [
              "Boutique-Ecke nach Vereinbarung geöffnet.\r\nPädagogische Führung durch den Garten, im Juni samstags von 15:00 bis 16:30 Uhr und im Juli/August dienstags von 10:00 bis 11:30 Uhr."
            ],
            "en": [
              "Store open by appointment.\r\nEducational tours of the garden, in June on Saturdays from 3 pm to 4:30 pm and in July/August on Tuesdays from 10 am to 11:30 am."
            ],
            "it": [
              "Negozio aperto su appuntamento.\r\nVisite didattiche al giardino, in giugno il sabato dalle 15.00 alle 16.30 e in luglio/agosto il martedì dalle 10.00 alle 11.30."
            ],
            "fr": [
              "Coin boutique ouvert sur rendez-vous.\r\nVisite pédagogique du jardin, en juin les samedis de 15h à 16h30 et en juillet/août les mardis de 10h à 11h30."
            ],
            "nl": [
              "Winkel open op afspraak.\r\nEducatieve rondleidingen door de tuin, in juni op zaterdag van 15.00 tot 16.30 uur en in juli/augustus op dinsdag van 10.00 tot 11.30 uur."
            ],
            "es": [
              "Tienda abierta con cita previa.\r\nVisitas pedagógicas del jardín, en junio los sábados de 15:00 a 16:30 y en julio/agosto los martes de 10:00 a 11:30."
            ]
          },
