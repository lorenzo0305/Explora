        "nl": [
          "Dagelijks geopend van 8.00 tot 20.00 uur en zondag van 9.00 tot 13.00 uur. Thuisbezorging voor bestellingen boven de 30 euro, bel 03.21.91.86.99."
        ],
        "es": [
