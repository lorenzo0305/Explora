  "rdfs:comment": {
    "de": [
      "Keller zum Essen - Terroir zum Mitnehmen!\r\nEinzigartiges Universum für lebende Weine! Unveröffentlichte Keller, lokale lecker, gesund und aufrichtig. Muss trinken, um zu glauben."
    ],
    "en": [
      "Cellar where to eat - Terroir to take away!\r\nUnique universe dedicated to live wines! Unpublished cellar, local yum, healthy and sincere. Must drink to believe."
    ],
    "it": [
      "Commerciante di vini alternativi e VIVANT WINE BISTRO che offre cibo per tutti i gusti, da condividere \"o meno\".\r\nUna cantina unica, locale, sana e sincera. Bisogna berlo per crederci!"
    ],
    "fr": [
      "Caviste alternatif et Bistro à VINS VIVANTS proposant une restauration pour toutes les faims, à partager \"ou pas\".\r\nCave à manger inédite, miam local, sain et sincère. Faut y boire pour y croire !"
    ],
    "es": [
      "Comerciante de vinos alternativo y VIVANT WINE BISTRO que ofrece comida para todos los gustos, para compartir \"o no\".\r\nUna bodega única, local, sana y sincera. Hay que beberlo para creerlo"
    ],
    "nl": [
      "Alternatieve wijnhandelaar en VIVANT WINE BISTRO met eten voor alle smaken, om te delen \"of niet\".\r\nEen unieke eetkelder, lokaal, gezond en oprecht. Je moet het drinken om het te geloven!"
    ]
  },
