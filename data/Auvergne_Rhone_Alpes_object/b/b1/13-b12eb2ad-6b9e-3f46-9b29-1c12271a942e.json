  "rdfs:comment": {
    "de": [
      "Die Bibliothek befindet sich im Gebäude des Theaters von Coise. Ein Team von 15 Freiwilligen empfängt Sie und bietet Ihnen ca. 2500 Medien für alle Zielgruppen. Eine Computerstation steht zur Verfügung."
    ],
    "en": [
      "The library is located in the Coise theater building. A team of 15 volunteers welcomes you and offers around 2,500 documents for all publics. A computer station is available."
    ],
    "it": [
      "La biblioteca si trova nell'edificio del teatro Coise. Un team di 15 volontari vi accoglie e offre circa 2.500 documenti per tutte le età. È disponibile un computer."
    ],
    "fr": [
      "La bibliothèque est située dans le bâtiment du théâtre de Coise. Une équipe de 15 bénévoles vous accueille et vous propose 2500 documents environ, pour tous les publics. Un poste informatique est à disposition."
    ],
    "es": [
      "La biblioteca se encuentra en el edificio del teatro Coise. Un equipo de 15 voluntarios le da la bienvenida y le ofrece unos 2.500 documentos para todas las edades. Hay un ordenador a su disposición."
    ],
    "nl": [
      "De bibliotheek bevindt zich in het theatergebouw Coise. Een team van 15 vrijwilligers verwelkomt je en biedt ongeveer 2500 documenten voor alle leeftijden. Er is een computer beschikbaar."
    ]
  },
  "rdfs:label": {
