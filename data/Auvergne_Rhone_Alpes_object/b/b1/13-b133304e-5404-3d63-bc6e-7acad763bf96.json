  "rdfs:comment": {
    "de": [
      "Willkommen an einem vollständig renovierten und benutzerfreundlichen Ort, der neue Räume bietet, insbesondere einen Multimediaraum und einen Veranstaltungsraum, in dem Begegnungen, Workshops, Aufführungen und Filmvorführungen geplant sind."
    ],
    "en": [
      "Welcome to a completely renovated, user-friendly facility offering new spaces, including a multimedia room and an entertainment room where meetings, workshops, shows and screenings will be scheduled."
    ],
    "it": [
      "Benvenuti in una sede completamente rinnovata e di facile utilizzo, con nuovi spazi, tra cui una sala multimediale e una sala di intrattenimento dove saranno programmati incontri, workshop, spettacoli e proiezioni."
    ],
    "fr": [
      "Bienvenue dans un lieu entièrement rénové et convivial qui offre de nouveaux espaces, notamment une salle multimédia et une salle d’animations où seront programmés des rencontres, des ateliers, des spectacles et des projections."
    ],
    "nl": [
      "Welkom in een volledig gerenoveerde, gebruiksvriendelijke faciliteit met nieuwe ruimtes, waaronder een multimediaruimte en een evenementenruimte waar vergaderingen, workshops, voorstellingen en screenings gepland zullen worden."
    ],
    "es": [
      "Bienvenido a un recinto completamente renovado y de fácil uso, con nuevos espacios, entre ellos una sala multimedia y una sala de entretenimiento donde se programarán reuniones, talleres, espectáculos y proyecciones."
    ]
  },
  "rdfs:label": {
