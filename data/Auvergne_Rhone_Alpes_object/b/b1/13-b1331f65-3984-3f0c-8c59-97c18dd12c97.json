  "rdfs:comment": {
    "de": [
      "Der Plan d'eau de la Tour verfügt über einen angelegten und im Sommer bewachten Strand, der ideal für Familien mit Kindern ist. Genießen Sie einen Moment der Entspannung auf dem feinen Sand, während die Kleinen sich im Wasser vergnügen."
    ],
    "en": [
      "Plan d?eau de la Tour has a supervised beach in summer, ideal for families with children. Enjoy a moment of relaxation on the fine sand, while the little ones play in the water."
    ],
    "it": [
      "Plan d'eau de la Tour dispone di una spiaggia sorvegliata in estate, ideale per le famiglie con bambini. Godetevi un momento di relax sulla sabbia fine, mentre i più piccoli giocano in acqua."
    ],
    "fr": [
      "Le Plan d’eau de la Tour dispose d’une plage aménagée et surveillée en été, idéale pour les familles avec enfants. Profitez d’un moment de détente sur le sable fin, tandis que les plus petits s’amusent dans l’eau."
    ],
    "nl": [
      "Plan d'eau de la Tour heeft een bewaakt strand in de zomer, ideaal voor gezinnen met kinderen. Geniet van een moment van ontspanning op het fijne zand, terwijl de kleintjes in het water spelen."
    ],
    "es": [
      "Plan d'eau de la Tour dispone de una playa vigilada en verano, ideal para familias con niños. Disfrute de un momento de relax en la arena fina, mientras los más pequeños juegan en el agua."
    ]
  },
