  "rdfs:comment": {
    "de": [
      "Vercors Rugby ist ein dynamischer Rugbyverein, der Jugendliche von 5 bis 14 Jahren empfängt, um ihnen die Werte Teamgeist, Bescheidenheit, Respekt und Engagement zu vermitteln."
    ],
    "en": [
      "Vercors Rugby is a dynamic rugby club for youngsters aged 5 to 14, teaching them the values of team spirit, humility, respect and commitment."
    ],
    "it": [
      "Il Vercors Rugby è un club di rugby dinamico per giovani dai 5 ai 14 anni, che insegna loro i valori dello spirito di squadra, dell'umiltà, del rispetto e dell'impegno."
    ],
    "fr": [
      "Vercors Rugby est un club de rugby dynamique qui accueille les jeunes de 5 à 14 ans afin de leur enseigner les valeurs de l'esprit d'équipe, d'humilité, de respect et d'engagement."
    ],
    "nl": [
      "Vercors Rugby is een dynamische rugbyclub voor jongeren van 5 tot 14 jaar, die hen de waarden van teamgeest, nederigheid, respect en toewijding bijbrengt."
    ],
