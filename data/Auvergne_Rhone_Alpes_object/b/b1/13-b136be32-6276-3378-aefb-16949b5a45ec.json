  "rdfs:comment": {
    "de": [
      "Die Compagnie A travers Ciels präsentiert \"Éclosion\", ein vibrierendes und poetisches Tanztheater-Solo über den Lebensweg einer Frau.\r\nEin starker Moment, voller Bewegung und Emotionen."
    ],
    "en": [
      "The Compagnie A travers Ciels presents \"Éclosion\", a vibrant, poetic dance-theater solo based on the story of one woman.\r\nA powerful moment, full of movement and emotion."
    ],
    "it": [
      "La Compagnie A travers Ciels presenta \"Éclosion\", un vibrante e poetico assolo di teatro-danza sul viaggio di una donna.\r\nUn momento potente, pieno di movimento ed emozione."
    ],
    "fr": [
      "La Compagnie A travers Ciels présente « Éclosion », un solo de danse-théâtre vibrant et poétique autour de la trajectoire d’une femme.\r\nUn moment fort, tout en mouvement et en émotion."
    ],
    "es": [
      "La Compagnie A travers Ciels presenta \"Éclosion\", una vibrante y poética pieza de danza-teatro en solitario sobre el viaje de una mujer.\r\nUn momento poderoso, lleno de movimiento y emoción."
    ],
    "nl": [
      "De Compagnie A travers Ciels presenteert \"Éclosion\", een levendig en poëtisch solo danstheaterstuk over de reis van een vrouw.\r\nEen krachtig moment, vol beweging en emotie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle : Eclosion"
    ]
  },
