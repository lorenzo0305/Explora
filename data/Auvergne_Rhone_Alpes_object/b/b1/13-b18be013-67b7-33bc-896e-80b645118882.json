  "rdfs:comment": {
    "de": [
      "Ein Picknicktisch mit Zugang für Behinderte und einige Bänke in einem Park mit Bäumen, die Ihnen Schatten spenden. Es stehen Ihnen Mülleimer und Parkplätze entlang der gesamten Strecke zur Verfügung. Die Nutzung ist völlig kostenlos."
    ],
    "en": [
      "A picnic table with PRM access and a few benches in a park with trees to keep you in the shade. Garbage garbage cans and parking spaces are available all along the site. Use is totally free."
    ],
    "it": [
      "Un tavolo da picnic con accesso per disabili e alcune panchine in un parco con alberi per rimanere all'ombra. Sono disponibili cestini per i rifiuti e parcheggi lungo tutto il sito. L'uso del sito è completamente gratuito."
    ],
    "fr": [
      "Une table de pique nique avec accès PMR et quelques bancs dans un parc avec des arbres pour vous tenir à l'ombre. Des poubelles sont à votre disposition ainsi que des places de parking tout le long. Son utilisation est totalement gratuite."
    ],
    "es": [
      "Una mesa de picnic con acceso para minusválidos y algunos bancos en un parque con árboles a la sombra. Hay contenedores de basura y plazas de aparcamiento a lo largo de todo el recinto. El uso del camping es totalmente gratuito."
    ],
    "nl": [
      "Een picknicktafel met toegang voor gehandicapten en een paar bankjes in een park met bomen om je in de schaduw te houden. Vuilnisbakken zijn beschikbaar, net als parkeerplaatsen langs het hele terrein. Het gebruik van de camping is volledig gratis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table de pique nique"
    ]
  },
