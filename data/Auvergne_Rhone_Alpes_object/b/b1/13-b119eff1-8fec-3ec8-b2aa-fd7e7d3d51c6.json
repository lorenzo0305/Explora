  "rdfs:comment": {
    "de": [
      "Mein Bäcker bietet Ihnen eine große Auswahl an Roggen-, Land- und Getreidebrot... Fleischpastete, Quiche, Pizza, Sandwich.... verschiedene Gebäcksorten...\r\nVom 1. Juli bis 31. August: Verkauf von Pizzas jeden Abend außer mittwochs von 18 bis 21 Uhr."
    ],
    "en": [
      "My baker offers a wide variety of breads: rye, country, cereal... meat pies, quiches, pizzas, sandwiches.... various pastries...\r\nFrom July 1 to August 31: pizza sales every evening except Wednesday, from 6pm to 9pm."
    ],
    "it": [
      "Il mio panettiere vi offre un'ampia varietà di pani: di segale, di campagna, ai cereali... pasticci di carne, quiche, pizze, panini.... dolci vari...\r\nDal 1° luglio al 31 agosto: vendita di pizze tutte le sere, tranne il mercoledì, dalle 18.00 alle 21.00."
    ],
    "fr": [
      "Mon boulanger vous propose une grande variété de pains seigle, campagne, céréales... pâté à la viande, quiche, pizza, sandwich.... pâtisseries variées...\r\nDu 1er juillet au 31 août : vente de pizzas tous les soirs sauf le mercredi de 18h à 21h."
    ],
    "nl": [
      "Mijn bakker biedt je een grote verscheidenheid aan broden: roggebrood, boerenbrood, graanbrood... vleespasteitjes, quiches, pizza's, sandwiches .... diverse gebakjes...\r\nVan 1 juli tot 31 augustus: pizza's te koop elke avond behalve woensdag van 18u tot 21u."
    ],
    "es": [
      "Mi panadero le ofrece una gran variedad de panes: de centeno, de payés, de cereales... pasteles de carne, quiches, pizzas, bocadillos.... bollería variada...\r\nDel 1 de julio al 31 de agosto: venta de pizzas todas las tardes excepto los miércoles de 18.00 a 21.00 h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mon Boulanger"
    ]
  },
