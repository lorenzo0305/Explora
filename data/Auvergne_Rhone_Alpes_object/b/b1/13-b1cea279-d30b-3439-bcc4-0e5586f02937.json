  "rdfs:comment": {
    "de": [
      "Das Hotel liegt 2 km von dem unter Naturschutz stehenden Gebiet Le Claps (Schwimmen, Klettern, Klettersteig) entfernt, im Herzen des Dorfes, in der Nähe des Platzes, auf dem jeden Freitagmorgen ein Markt stattfindet.\r\nVor Ort: kostenloses Wifi Cigale, Boutique."
    ],
    "en": [
      "Situated at 2 km from the classified site \"Le Claps\" (bathing, climbing, via ferrata), at the heart of the village, near by the square where the market is held every friday mornings. On the site: WIFI (hotspot CIGALE), individualised answers, many document to your disposal or on sale."
    ],
    "it": [
      "Situato a 2 km dal sito classificato di Le Claps (nuoto, arrampicata, via ferrata), nel cuore del villaggio, vicino alla piazza dove si tiene il mercato ogni venerdì mattina.\r\nIn loco: Cigale WiFi gratuito, negozio."
    ],
    "fr": [
      "Situé à 2 km du site classé du Claps (baignade, escalade, via ferrata), au cœur du village, à proximité de la place où se tient le marché tous les vendredis matins. \r\nSur place : Wifi Cigale gratuit, boutique."
    ],
    "es": [
      "Situado a 2 km del sitio protegido de Le Claps (natación, escalada, vía ferrata), en el corazón del pueblo, cerca de la plaza donde se celebra el mercado todos los viernes por la mañana.\r\nEn el establecimiento: WiFi Cigale gratuito, tienda."
    ],
    "nl": [
      "Gelegen op 2 km van de geklasseerde site van Le Claps (zwemmen, klimmen, via ferrata), in het hart van het dorp, vlakbij het plein waar elke vrijdagochtend de markt wordt gehouden.\r\nTer plaatse: gratis Cigale WiFi, winkel."
    ]
  },
