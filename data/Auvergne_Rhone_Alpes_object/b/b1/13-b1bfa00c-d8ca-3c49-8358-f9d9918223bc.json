  "rdfs:comment": {
    "de": [
      "Wir treffen uns im Festsaal für einen unvergesslichen Abend! Kommen Sie zahlreich, um zu feiern und einen geselligen Moment mit den Classards der Gemeinde zu teilen."
    ],
    "en": [
      "Rendezvous at the Salle des Fêtes for an unforgettable evening! Come one, come all to celebrate and share a convivial moment with the local classics."
    ],
    "it": [
      "Ci vediamo alla Salle des Fêtes per una serata indimenticabile! Venite tutti a festeggiare e a condividere un momento di convivialità con i compagni di classe locali."
    ],
    "fr": [
      "Rendez-vous à la salle des fêtes pour une soirée inoubliable ! Venez nombreux faire la fête et partager un moment convivial avec les classards de la commune."
    ],
    "es": [
      "¡Nos vemos en la Salle des Fêtes para una velada inolvidable! Venga uno, vengan todos a celebrar y compartir un momento de convivencia con los compañeros locales."
    ],
    "nl": [
      "Tot ziens in de Salle des Fêtes voor een onvergetelijke avond! Kom allen om feest te vieren en een gezellig moment te delen met de lokale klasgenoten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bal des classards"
    ]
  },
