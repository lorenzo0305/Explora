  "rdfs:comment": {
    "de": [
      "Das im Herzen des Dorfes gelegene \"Le coindes écureuils\" bietet Ihnen eine authentische Küche mit frischen und lokalen Produkten.Nur auf Reservierung."
    ],
    "en": [
      "\"In the heart of the village, the Coin des Ecureuils serves authentic dishes made from fresh local ingredients.\r\nPrior reservation compulsory.\""
    ],
    "it": [
      "Situato nel cuore del villaggio, Le Coin des Écureuils offre una cucina autentica a base di prodotti freschi locali.\r\nSolo su prenotazione.\r\nSerate a tema il venerdì sera, programma sulla pagina facebook."
    ],
    "fr": [
      "Situé au cœur du village, le coin des écureuils vous propose une cuisine authentique avec des produits frais et locaux.\r\nSur réservation seulement.\r\nSoirées à thème les vendredis soirs, programme sur la page facebook."
    ],
    "es": [
      "Situado en el corazón del pueblo, Le Coin des Écureuils ofrece una cocina auténtica con productos frescos y locales.\r\nSólo con reserva.\r\nVeladas temáticas los viernes por la noche, programa en la página de facebook."
    ],
    "nl": [
      "Gelegen in het hart van het dorp biedt de Eekhoorntjeshoek een authentieke keuken met verse en lokale producten.\r\nAlleen op reservering.\r\nThema-avonden op vrijdagavond, programma op de facebookpagina."
    ]
  },
