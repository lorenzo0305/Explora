  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über können Sie hier die von unserem Chefkoch mit Liebe zubereiteten Gerichte genießen, der frische, saisonale und lokale Produkte bevorzugt."
    ],
    "en": [
      "All year round, you can enjoy dishes lovingly prepared by our Chef, who favors fresh, seasonal and local produce."
    ],
    "it": [
      "Durante tutto l'anno, potrete gustare i piatti preparati con cura dal nostro chef, che privilegia i prodotti freschi, di stagione e locali."
    ],
    "fr": [
      "Tout au long de l’année, vous pouvez y déguster les plats réalisés avec amour par notre Chef qui privilégie les produits frais, de saison et locaux."
    ],
    "nl": [
      "Het hele jaar door kun je genieten van gerechten die met liefde zijn bereid door onze chef-kok, die de voorkeur geeft aan verse, seizoensgebonden en lokale producten."
    ],
    "es": [
      "Durante todo el año, podrá degustar los platos preparados con esmero por nuestro Chef, que privilegia los productos frescos, de temporada y locales."
    ]
  },
