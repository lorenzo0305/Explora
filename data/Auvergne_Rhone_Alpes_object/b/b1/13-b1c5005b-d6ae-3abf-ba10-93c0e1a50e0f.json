  "rdfs:comment": {
    "de": [
      "Der Tour des Juges mit Blick auf den Lac d'Allier bietet ebenfalls zwei Säle. Der erste Raum befindet sich im ersten Stock und kann bis zu 70 Personen aufnehmen (12 m x 7 m). Im Erdgeschoss befindet sich ein Saal (11 m x 6 m)"
    ],
    "en": [
      "The Judges' Tower, overlooking the lake of Allier, also offers 2 rooms. The first one, located on the second floor, can accommodate up to 70 people (12 m x 7 m). On the first floor a room of 11 m x 6 m"
    ],
    "it": [
      "La Tour des Juges, affacciata sul lago di Allier, offre anche 2 camere. La prima, situata al primo piano, può ospitare fino a 70 persone (12 m x 7 m). Al piano terra, una sala di 11 m x 6 m"
    ],
    "fr": [
      "La Tour des Juges, surplombant le lac d’Allier offre également 2 salles. La première, située au premier étage  peut réunir jusqu’à 70 personnes (12 m x 7 m). Au rez-de-chaussée une salle de 11 m x 6 m"
    ],
    "es": [
      "La Tour des Juges, con vistas al lago Allier, también ofrece 2 habitaciones. La primera, situada en la primera planta, tiene capacidad para 70 personas (12 m x 7 m). En la planta baja, una habitación de 11 m x 6 m"
    ],
    "nl": [
      "De Tour des Juges, met uitzicht op het meer van Allier, biedt ook 2 kamers. De eerste, gelegen op de eerste verdieping, biedt plaats aan maximaal 70 personen (12 m x 7 m). Op de begane grond, een kamer van 11 m x 6 m"
    ]
  },
  "rdfs:label": {
