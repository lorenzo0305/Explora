  "rdfs:comment": {
    "de": [
      "Allemond, ein kleines Dorf in den Alpen am Rande des Lac du Verney, empfängt Sie in einer natürlichen und zauberhaften Umgebung, dem Tal der Eau d'Olle, und bietet Ihnen alle Freuden des Wassers und der Berge."
    ],
    "en": [
      "A small Alpine village on the banks of Lac du Verney, Allemond welcomes you to the enchanting natural setting of the Vallée de l'Eau d'Olle, offering you all the pleasures of water and mountains."
    ],
    "it": [
      "Allemond, piccolo villaggio delle Alpi ai margini del Lac du Verney, vi accoglie nell'incantevole cornice naturale della Valle dell'Eau d'Olle e vi offre tutti i piaceri dell'acqua e della montagna."
    ],
    "fr": [
      "Petit village des Alpes en bordure du lac du Verney, Allemond vous accueille dans un cadre naturel et enchanteur, la Vallée de l’Eau d’Olle et vous offre tous les plaisirs de l'eau et de la montagne."
    ],
    "es": [
      "Allemond, un pequeño pueblo de los Alpes al borde del lago de Verney, le da la bienvenida al encantador entorno natural del valle de Eau d'Olle y le ofrece todos los placeres del agua y la montaña."
    ],
    "nl": [
      "Allemond is een klein alpendorpje aan de rand van het meer van Verney. Het dorp verwelkomt u temidden een natuurkader, de vallei van de Eau d'Olle, waar u ten volle kunt genieten van water -en bergactiviteiten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Tourist office of Allemond"
    ],
    "fr": [
      "Office de tourisme d'Allemond"
    ],
    "nl": [
      "VVV-kantoor van Allemond"
    ]
  },
