  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/88d62f76-eff7-350d-8db1-a21c6a96d703",
      "dc:description": {
        "de": [
          "Öffnung der Türen: 19.00 Uhr\nBeginn des Konzerts: 20.00 Uhr.\n\nMarc Lavoine, die Ikone des französischen Chansons, kehrt mit einem Symphonieorchester auf die Bühne zurück, um ein bedeutendes Ereignis zu feiern: das 40-jährige Jubiläum seines unvergesslichen Hits \"Elle a les yeux revolver\" (Sie hat die Augen des Revolvers)."
        ],
        "en": [
          "Doors open: 7:00 pm\nConcert starts: 8:00 p.m.\n\nFrench chanson icon Marc Lavoine returns to the stage with a symphony orchestra to celebrate the 40th anniversary of his unforgettable hit \"Elle a les yeux revolver\"."
        ],
        "it": [
          "Apertura porte: 19:00\nInizio concerto: ore 20:00.\n\nMarc Lavoine, icona della chanson francese, torna sul palco con un'orchestra sinfonica per celebrare un evento storico: il 40° anniversario del suo indimenticabile successo \"Elle a les yeux revolver\"."
        ],
        "fr": [
          "Ouverture des portes : 19h00\nDébut du concert : 20h00.\n\nMarc Lavoine, l’icône de la chanson française reviens sur scène avec un orchestre symphonique pour célébrer un événement marquant : les 40 ans de son inoubliable succès « Elle a les yeux revolver »."
        ],
        "nl": [
          "Deuren open: 19:00\nAanvang concert: 20.00 uur.\n\nMarc Lavoine, het icoon van het Franse chanson, keert terug op het podium met een symfonieorkest om een mijlpaal te vieren: de 40e verjaardag van zijn onvergetelijke hit \"Elle a les yeux revolver\"."
        ],
        "es": [
          "Apertura de puertas: 19:00\nInicio del concierto: 20:00\n\nMarc Lavoine, icono de la chanson francesa, vuelve a los escenarios con una orquesta sinfónica para celebrar un acontecimiento histórico: el 40 aniversario de su inolvidable éxito \"Elle a les yeux revolver\"."
        ]
      },
