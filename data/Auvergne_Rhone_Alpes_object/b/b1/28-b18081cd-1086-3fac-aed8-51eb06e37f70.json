  "rdfs:comment": {
    "de": [
      "Die Boote \"Commandant Charcot\" nehmen Sie mit in die Sommebucht! Kommentierte Fahrten mit den Gezeiten: 40-minütige bis 2-stündige Ausflüge von St Valery sur Somme und Le Crotoy aus.\nNeuheit 2025: Verbinden Sie das Angenehme mit dem Angenehmen und genießen Sie eine Meeresfrüchteplatte im Herzen der Bucht von Somme."
    ],
    "en": [
      "The \"Commandant Charcot\" boats take you to the Baie de Somme! Guided tours according to the tides: from 40 minutes to 2 hours, departing from St Valery sur Somme and Le Crotoy.\nNew for 2025: enjoy a seafood platter in the heart of the Baie de Somme."
    ],
    "it": [
      "Le barche del \"Commandant Charcot\" vi portano alla Baie de Somme! Visite guidate in base alle maree: gite da 40 minuti a 2 ore con partenza da St Valery sur Somme e Le Crotoy.\nNovità 2025: gustare un piatto di pesce nel cuore della Baie de Somme."
    ],
    "fr": [
      "Les bateaux \"Commandant Charcot\" vous emmènent en Baie de Somme ! Des promenades commentées au gré des marées : des sorties de 40 mn  à 2h au départ de St Valery sur Somme et du Crotoy.\nNouveauté 2025 : joignez l'agréable à l'agréable et dégustez un plateau de fruits de mer au cœur de la baie de Somme."
    ],
    "es": [
      "Los barcos del \"Commandant Charcot\" le llevan a la Bahía de Somme Visitas guiadas en función de las mareas: salidas de 40 minutos a 2 horas desde St Valery sur Somme y Le Crotoy.\nNovedad 2025: disfrute de una mariscada en el corazón de la Bahía de Somme."
    ],
    "nl": [
      "De boten \"Commandant Charcot\" brengen je naar de Baie de Somme! Begeleide tochten naargelang de getijden: tochten van 40 minuten tot 2 uur met vertrek in St Valery sur Somme en Le Crotoy.\nNieuw in 2025: geniet van een zeevruchtenschotel in het hart van de Baie de Somme."
    ]
  },
