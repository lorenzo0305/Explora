  "rdfs:comment": {
    "de": [
      "Als Tapas- und Streetfood-Restaurant im Herzen von Lyon bietet Sabaï Sabaï eine authentische und zugleich neu interpretierte Küche aus Südostasien."
    ],
    "en": [
      "Sabaï Sabaï is a tapas and street-food restaurant in the heart of Lyon serving authentic South-East Asian cuisine, plus dishes with a modern twist."
    ],
    "it": [
      "Sabaï Sabaï è un ristorante di tapas e street food nel cuore di Lione, che propone una cucina autentica e rivisitata del Sud-Est asiatico."
    ],
    "fr": [
      "Restaurant de tapas et street food en plein cœur de Lyon, Sabaï Sabaï propose une cuisine à la fois authentique et revisitée de la cuisine du sud-est asiatique."
    ],
    "nl": [
      "Sabaï Sabaï is een tapas- en streetfoodrestaurant in het hart van Lyon. Het biedt authentieke en vernieuwde Zuidoost-Aziatische gerechten."
    ],
    "es": [
      "Sabaï Sabaï es un restaurante de tapas y comida callejera en el corazón de Lyon, que ofrece una cocina del sudeste asiático auténtica y revisitada."
