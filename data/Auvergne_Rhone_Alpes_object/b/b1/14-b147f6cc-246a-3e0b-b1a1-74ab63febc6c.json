  "rdfs:comment": {
    "de": [
      "Diese kostenlose und für alle offene Veranstaltung, die seit 2023 zu einem unumgänglichen Frühlingstreffen geworden ist, kehrt für eine dritte Ausgabe zurück, die ganz im Zeichen von guter Laune, Musik und Schaum steht!"
    ],
    "en": [
      "A must-see spring event since 2023, this free event, open to all, is back for a third edition featuring good spirits, music and foam!"
    ],
    "it": [
      "Ormai appuntamento imperdibile della primavera dal 2023, questo evento gratuito e aperto al pubblico torna per la sua terza edizione, con tutto il divertimento, la musica e la schiuma che si possono desiderare!"
    ],
    "fr": [
      "Devenue un rendez-vous printanier incontournable depuis 2023, cette animation gratuite et ouverte à tous revient pour une troisième édition placée sous le signe de la bonne humeur, de la musique et de la mousse !"
    ],
    "nl": [
      "Dit gratis toegankelijke evenement is al sinds 2023 een niet te missen voorjaarsevenement en is terug voor de derde editie, met alle plezier, muziek en schuim dat je je maar kunt wensen!"
    ],
    "es": [
      "Desde 2023, este evento primaveral, gratuito y abierto al público, vuelve en su tercera edición con toda la diversión, música y espuma que puedas desear"
    ]
  },
  "rdfs:label": {
