      "dc:description": {
        "de": [
          "Man nehme einen DJ mit guter Musik, Schaum und Spots für eine noch festlichere Stimmung und schon hat man den Cocktail der DJ Mousse-Party"
        ],
        "en": [
          "Take a DJ with good sound, foam and spotlights for an even more festive atmosphere, and you've got the DJ Mousse cocktail"
        ],
        "it": [
          "Prendete un DJ con un buon suono, un po' di schiuma e dei riflettori per un'atmosfera ancora più festosa e avrete il cocktail serale DJ Mousse"
        ],
        "fr": [
          "Prenez un DJ avec du bon son, de la mousse, des spots pour une ambiance encore plus festive et vous avez le cocktail de la soirée DJ Mousse"
        ],
        "nl": [
          "Neem een DJ met een goed geluid, wat schuim en spotjes voor een nog feestelijker sfeer en je hebt de DJ Mousse avondcocktail"
        ],
        "es": [
          "Coge un DJ con un buen sonido, un poco de espuma y focos para crear un ambiente aún más festivo y ya tienes el cóctel nocturno DJ Mousse"
        ]
      },
