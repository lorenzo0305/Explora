  "rdfs:comment": {
    "de": [
      "Der Parc Omnisports Auvergne-Rhône-Alpes-Vichy verfügt über einen Disc-Golf-Parcours mit 18 Körben, die über den ganzen Park verteilt sind und so einen sportlichen und spielerischen Spaziergang bieten."
    ],
    "ru": [
      "В парке Omnisports Auvergne-Rhône-Alpes-Vichy есть поле для диск-гольфа с 18 корзинами, расположенными по всей территории парка, - спортивный и веселый способ передвижения."
    ],
    "en": [
      "The Parc Omnisports Auvergne-Rhône-Alpes-Vichy has an 18-basket disc golf course spread throughout the park, offering a fun and sporting stroll."
    ],
    "it": [
      "Il Parc Omnisports Auvergne-Rhône-Alpes-Vichy dispone di un campo da disc golf con 18 canestri distribuiti in tutto il parco, che offre un modo sportivo e divertente di spostarsi."
    ],
    "fr": [
      "Le Parc Omnisports Auvergne-Rhône-Alpes-Vichy dispose d'un parcours de disc golf de 18 paniers répartis dans tout le Parc offrant ainsi une balade sportive et ludique."
    ],
    "zh": [
      "奥弗涅-罗讷-阿尔卑斯-维希综合运动公园（Parc Omnisports Auvergne-Rhône-Alpes-Vichy）有一个飞盘高尔夫球场，18 个球篮遍布整个公园，为游客提供了一种既运动又有趣的出行方式。"
    ],
    "nl": [
      "Het Parc Omnisports Auvergne-Rhône-Alpes-Vichy heeft een disc golf parcours met 18 baskets verspreid over het park, een sportieve en leuke manier om je te verplaatsen."
    ],
    "es": [
      "El Parc Omnisports Auvergne-Rhône-Alpes-Vichy dispone de un campo de disc golf con 18 cestas repartidas por todo el Parque, que ofrece una forma deportiva y divertida de desplazarse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours de Disc Golf du Parc omnisports Auvergne Rhône Alpes Vichy"
    ]
  },
