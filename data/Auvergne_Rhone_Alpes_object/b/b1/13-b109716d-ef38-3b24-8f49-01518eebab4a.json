  "rdfs:comment": {
    "de": [
      "Anlässlich der Wiedereröffnung des Ortes Les Cornelles laden wir Sie zu einem Wochenende ein, das dem mittelalterlichen Handwerk und den Animationen gewidmet ist."
    ],
    "en": [
      "To mark the reopening of the Cornelles site, we invite you to a weekend of medieval craftsmanship and entertainment."
    ],
    "it": [
      "In occasione della riapertura del sito delle Cornelles, vi invitiamo a un fine settimana dedicato ai mestieri e alle attività medievali."
    ],
    "fr": [
      "A l'occasion de la réouverture du site des Cornelles, nous vous convions à un week-end dédié à l’artisanat et aux animations médiévales."
    ],
    "nl": [
      "Ter gelegenheid van de heropening van de site van Cornelles nodigen we je uit voor een weekend gewijd aan middeleeuwse ambachten en activiteiten."
    ],
    "es": [
      "Con motivo de la reapertura del yacimiento de Cornelles, le invitamos a un fin de semana dedicado a los oficios y actividades medievales."
    ]
  },
