  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Produktion von Saisongemüse! Eine natürliche und umweltfreundliche Produktion, die biologisch angebaut wird und zum Verkauf ab Hof erhältlich ist."
    ],
    "en": [
      "Come and enjoy some tasty seasonal vegetables ! Those products are grown with a deep care for the environment, with organic farming, which you can buy directly at the farm."
    ],
    "it": [
      "Venite a scoprire la nostra produzione di ortaggi di stagione! Una produzione naturale e rispettosa dell'ambiente, coltivata con metodo biologico e disponibile per la vendita in azienda."
    ],
    "fr": [
      "Venez découvrir la production de légumes de saisons ! Une production naturelle et respectueuse de son environnement, en agriculture biologique, et disponible en vente à la ferme."
    ],
    "es": [
      "¡Venga a descubrir nuestra producción hortícola de temporada! Una producción natural y respetuosa con el medio ambiente, cultivada ecológicamente y disponible para la venta en la granja."
    ],
    "nl": [
      "Kom en ontdek onze seizoensgroenteteelt! Een natuurlijke productie met respect voor het milieu, biologisch geteeld en te koop op de boerderij."
    ]
  },
  "rdfs:label": {
