  "rdfs:comment": {
    "de": [
      "Ein Bereich, der speziell für das Skateboarding, Inlineskaten, Rollerfahren und BMX-Fahren konzipiert wurde. Bestehend aus Rampen, Bowls, Halfpipes, Rails und anderen Hindernissen, kannst du hier fahren oder üben, um akrobatische Figuren zu machen."
    ],
    "en": [
      "A space specially designed for skateboarding, rollerblading, scooters and BMX. Made with ramps, bowls, half-pipes, rails and other obstacles, you can ride or train to achieve acrobatic figures."
    ],
    "it": [
      "Un'area appositamente progettata per skateboard, rollerblade, monopattino e BMX. Con rampe, bocce, half-pipes, rail e altri ostacoli, si può pedalare o praticare trick acrobatici."
    ],
    "fr": [
      "Un espace spécialement conçu pour la pratique du skateboard, du roller, de la trottinette et du BMX. Composé de rampes, de bowls, de half-pipes, de rails et d'autres obstacles, vous pourrez rider ou vous entraîner pour réaliser des figures acrobatiques."
    ],
    "es": [
      "Una zona especialmente diseñada para el skate, el patinaje, el scooter y la BMX. Con rampas, bowls, half-pipes, rails y otros obstáculos, podrás montar o practicar trucos acrobáticos."
    ],
    "nl": [
      "Een gebied speciaal ontworpen voor skateboarden, skeeleren, steppen en BMX. Met schansen, kommen, halfpipes, rails en andere obstakels kun je rijden of acrobatische trucs oefenen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fillinges Skate Park"
    ],
    "fr": [
      "Bowl de Fillinges"
    ]
  },
