  "rdfs:comment": {
    "de": [
      "GBA SAS (Granulés de bois de l'Allier) ist ein Unternehmen, das im Ecocentre, dem ehemaligen Militärstützpunkt von Varennes-sur-Allier, Holzpellets und Holzhackschnitzel für Heizanlagen herstellt."
    ],
    "en": [
      "GBA SAS (Granulés de bois de l'Allier) is based at the Ecocentre, a former military base in Varennes-sur-Allier, and produces wood pellets and wood chips for heating systems."
    ],
    "it": [
      "GBA SAS (Granulés de bois de l'Allier) ha sede presso l'Ecocentre, un'ex base militare a Varennes-sur-Allier, e produce pellet e cippato per sistemi di riscaldamento."
    ],
    "fr": [
      "Implanté au sein de l’Ecocentre, ancienne base militaire de Varennes-sur-Allier, GBA SAS (Granulés de bois de l’Allier) est une entreprise de production de granulés de bois et de plaquettes de bois destinées aux chaufferies."
    ],
    "es": [
      "GBA SAS (Granulés de bois de l'Allier) tiene su sede en el Ecocentro, antigua base militar de Varennes-sur-Allier, y produce pellets y astillas de madera para sistemas de calefacción."
    ],
    "nl": [
      "GBA SAS (Granulés de bois de l'Allier) is gevestigd in het Ecocentre, een voormalige militaire basis in Varennes-sur-Allier, en produceert houtpellets en houtsnippers voor verwarmingssystemen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "3 Bois"
    ]
  },
