  "rdfs:comment": {
    "de": [
      "Die wunderschöne Kirche von Thollon-les-Mémises wurde im 19. Jahrhundert im sardischen Stil erbaut. Sie befindet sich im Herzen des Dorfes und kann jeden Tag des Jahres besichtigt werden."
    ],
    "en": [
      "The magnificent church of Thollon-les-Mémises was built in the 19th century in Sardinian style. Located in the heart of the village, it is free to visit every day of the year."
    ],
    "it": [
      "La magnifica chiesa di Thollon-les-Mémises fu costruita nel XIX secolo in stile sardo. Situato nel cuore del villaggio, è aperto ai visitatori tutti i giorni dell'anno."
    ],
    "fr": [
      "La magnifique église de Thollon-les-Mémises a été construite au XIXème siècle dans un style sarde. Située au cœur du village, elle est libre à la visite tous les jours de l'année."
    ],
    "es": [
      "La magnífica iglesia de Thollon-les-Mémises fue construida en el siglo XIX en estilo sardo. Situado en el corazón del pueblo, está abierto a los visitantes todos los días del año."
    ],
    "nl": [
      "De prachtige kerk van Thollon-les-Mémises werd in de 19e eeuw gebouwd in Sardijnse stijl. De kerk ligt in het hart van het dorp en is elke dag van het jaar open voor bezoekers."
    ]
  },
