  "rdfs:comment": {
    "de": [
      "Zu den \"Cactées de Saint Jean\" zu gehen, ist ein bisschen wie eine Reise zu unternehmen und gleichzeitig in der Region Drôme des Collines zu bleiben. Es ist die Begegnung mit einem leidenschaftlichen Kakteen- und Sukkulentenliebhaber."
    ],
    "en": [
      "Cacti and succulent plants, design of dry gardens, green walls and roofs."
    ],
    "it": [
      "Andare alle \"Cactées de Saint Jean\" è come fare un viaggio rimanendo nella Drôme des Collines. È un incontro con un appassionato di cactus e piante grasse."
    ],
    "fr": [
      "Aller aux \"Cactées de Saint Jean\" c'est un peu partir en voyage tout en restant en Drôme des Collines. C'est la rencontre avec un passionné de cactus et de plantes grasses."
    ],
    "es": [
      "Ir a las \"Cactées de Saint Jean\" es como ir de viaje sin salir de la Drôme des Collines. Es un encuentro con un entusiasta de los cactus y las plantas suculentas."
    ],
    "nl": [
      "Cactus en vetplanten, creëren van rotstuinen, plantenmuren en -daken"
    ]
  },
