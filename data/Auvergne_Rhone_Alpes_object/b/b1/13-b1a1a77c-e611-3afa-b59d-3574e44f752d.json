  "rdfs:comment": {
    "de": [
      "Le P'tit Vaugris empfängt Sie unter der Woche und bietet Ihnen Menüs vor Ort oder zum Mitnehmen an.\r\nFroschabend samstags abends einmal im Monat."
    ],
    "en": [
      "Le P'tit Vaugris welcomes you during the week and offers take-away and sit-down menus.\r\nFrog evenings on Saturday evenings once a month."
    ],
    "it": [
      "Le P'tit Vaugris vi accoglie durante la settimana e propone menu da asporto e menu fissi.\r\nSerate a base di rane il sabato sera una volta al mese."
    ],
    "fr": [
      "Le P'tit Vaugris vous accueille en semaine et vous propose des menus sur place ou à emporter.\r\nSoirée grenouilles les samedis soirs une fois par mois."
    ],
    "nl": [
      "Le P'tit Vaugris verwelkomt je doordeweeks en biedt afhaalmaaltijden en menu's.\r\nEén keer per maand kikkeravond op zaterdagavond."
    ],
    "es": [
      "Le P'tit Vaugris le da la bienvenida durante la semana y le ofrece menús para llevar y menús del día.\r\nVeladas de rana los sábados por la noche una vez al mes."
    ]
  },
