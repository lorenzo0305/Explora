      "dc:description": {
        "de": [
          "Das Team empfängt Sie das ganze Jahr über mittags und abends und lädt Sie ein, eine traditionelle Küche mit regionalen Akzenten zu entdecken."
        ],
        "en": [
          "The team welcomes you all year round for lunch and dinner and invites you to discover a traditional cuisine with regional accents."
        ],
        "it": [
          "Il team vi accoglie tutto l'anno per pranzo e cena e vi invita a scoprire una cucina tradizionale con accenti regionali."
        ],
        "fr": [
          "L'équipe vous accueille toute l'année midi et soir et vous invite à découvrir une cuisine traditionnelle aux accents régionaux."
        ],
        "nl": [
          "Het team verwelkomt u het hele jaar door voor lunch en diner en nodigt u uit om een traditionele keuken met regionale accenten te ontdekken."
        ],
        "es": [
          "El equipo le da la bienvenida todo el año para comer y cenar y le invita a descubrir una cocina tradicional con acentos regionales."
        ]
