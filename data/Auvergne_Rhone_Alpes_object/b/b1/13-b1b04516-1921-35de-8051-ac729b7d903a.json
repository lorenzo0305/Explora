  "rdfs:comment": {
    "de": [
      "Entdecken Sie in einer freundlichen Atmosphäre eine traditionelle Küche mit der Möglichkeit, Gerichte zum Mitnehmen zu bestellen. Spezialitäten: hausgemachter Couscous, Lasagne mit Lachs und Spinat"
    ],
    "en": [
      "Friendly atmosphere, let's discover a traditional cooking with to go meals.\r\n\r\nSpecialties : hand-made couscous, spinash and salmon lasagna."
    ],
    "it": [
      "In un'atmosfera amichevole, scoprite una cucina tradizionale con possibilità di pasti da asporto. Specialità: couscous fatto in casa, lasagne di salmone e spinaci"
    ],
    "fr": [
      "Dans une ambiance conviviale, découvrez une cuisine traditionnelle avec possibilité de plats à emporter. Spécialités : couscous maison, lasagnes saumon épinards"
    ],
    "nl": [
      "Ontdek in een gezellige sfeer een traditionele keuken met de mogelijkheid om maaltijden af te halen. Specialiteiten: huisgemaakte couscous, lasagne met zalm en spinazie"
    ],
    "es": [
      "En un ambiente acogedor, descubra una cocina tradicional con posibilidad de comidas para llevar. Especialidades: cuscús casero, lasaña de salmón y espinacas"
    ]
  },
