  "rdfs:comment": {
    "de": [
      "Kommen Sie vorbei, um Ihre Keramik zu bemalen und dabei einen guten Kaffee zu trinken.\r\nEin perfekter Ort, um sich zu entspannen, zu plaudern und unserer künstlerischen Fantasie freien Lauf zu lassen."
    ],
    "en": [
      "Come and paint your ceramics over a cup of coffee.\r\nA perfect place to relax, chat and let your artistic imagination run wild."
    ],
    "it": [
      "Venite a dipingere le vostre ceramiche davanti a una tazza di caffè.\r\nÈ il luogo perfetto per rilassarsi, chiacchierare e dare sfogo alla propria immaginazione artistica."
    ],
    "fr": [
      "Venez peindre votre céramique en buvant un bon café.\r\nUn lieu parfait pour se détendre, papoter et laisser libre cours à notre imagination artistique."
    ],
    "es": [
      "Ven a pintar tus cerámicas mientras tomas un café.\r\nEs el lugar perfecto para relajarse, charlar y dar rienda suelta a su imaginación artística."
    ],
    "nl": [
      "Kom keramiek beschilderen onder het genot van een kopje koffie.\r\nHet is de perfecte plek om te ontspannen, te kletsen en je artistieke verbeelding de vrije loop te laten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Pots Potins - céramic café"
    ]
  },
