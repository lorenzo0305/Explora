  "rdfs:comment": {
    "de": [
      "Das neue künstlerische Konzept des Théâtre Nouvelle Génération - Centre dramatique national de Lyon, vereint nun das Théâtre Les Ateliers und das TNG. Der Spielplan trägt die Farben eines Theaters des Imaginären, das für szenische Neuerungen offen ist."
    ],
    "en": [
      "The new artistic project of Théâtre Nouvelle Génération (the Lyon National Centre of Dramatic Art) has joined the TNG with the Théâtre Les Ateliers. The programme includes imaginative theatre, open to stage innovations."
    ],
    "it": [
      "Il nuovo progetto artistico del Théâtre Nouvelle Génération - Centre Dramatique National (centro nazionale di arti drammatiche) di Lione, è il frutto dell'unione tra i teatri Théâtre Les Ateliers e TNG. La programmazione sfoggia i colori di un teatro dell'immaginario, aperto alle innovazioni sceniche."
    ],
    "fr": [
      "Le nouveau projet artistique du Théâtre Nouvelle Génération - Centre dramatique national de Lyon, réunit désormais le Théâtre Les Ateliers et le TNG. La programmation porte les couleurs d’un théâtre des imaginaires, ouvert aux innovations scéniques."
    ],
    "nl": [
      "Het nieuwe artistieke project van het Théâtre Nouvelle Génération - Centre dramatique national de Lyon, brengt nu het Théâtre Les Ateliers en het TNG samen. Het programma draagt de kleuren van een theater van de verbeelding, dat openstaat voor scenische vernieuwingen."
    ],
    "es": [
      "El nuevo proyecto artístico del Théâtre Nouvelle Génération - Centre dramatique national de Lyon reúne a partir de ahora al teatro Les Ateliers y al TNG. La programación viste los colores de un teatro imaginativo y abierto a las innovaciones escénicas."
    ]
  },
