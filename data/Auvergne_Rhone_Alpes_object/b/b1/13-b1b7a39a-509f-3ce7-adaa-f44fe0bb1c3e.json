  "rdfs:comment": {
    "de": [
      "Die Kirche überragt auf ihrem Basaltfelsen die Ortschaft St Julien-Chapteuil. Ende des 11. Jahrhunderts holten die Herren von Chapteuil Benediktinermönche aus La chaise Dieu ins Land, die dieses Priorat gründeten."
    ],
    "en": [
      "The church dominates the village of St Julien-Chapteuil on its basalt rock. At the end of the 11th century, the lords of Chapteuil summoned Benedictine monks of the Chair Dieu who founded this priory."
    ],
    "it": [
      "La chiesa domina il villaggio di St Julien-Chapteuil sulla sua roccia basaltica. Alla fine dell'XI secolo, i signori di Chapteuil fecero arrivare dalla chaise Dieu i monaci benedettini che fondarono questo priorato."
    ],
    "fr": [
      "L'église domine le bourg de St Julien-Chapteuil sur son rocher de basalte. A la fin du XIe siècle, les seigneurs de Chapteuil firent venir des moines bénédictins de la chaise Dieu qui fondèrent ce prieuré."
    ],
    "es": [
      "La iglesia domina el pueblo de St Julien-Chapteuil sobre su roca de basalto. A finales del siglo XI, los señores de Chapteuil trajeron a los monjes benedictinos de la chaise Dieu que fundaron este priorato."
    ],
    "nl": [
      "De kerk domineert het dorp St Julien-Chapteuil op haar basaltrots. Aan het eind van de 11e eeuw haalden de heren van Chapteuil benedictijner monniken van de chaise Dieu binnen, die deze priorij stichtten."
    ]
  },
