  "rdfs:comment": {
    "de": [
      "An sechs Tagen in der Woche geöffnet. Vor Ort oder zum Mitnehmen. Regionale Gerichte nur auf Bestellung (Huhn \"Mistral\", Aioli, Lammkeule...). Schattige Terrasse. Reservierung empfohlen."
    ],
    "en": [
      "Open 6 days a week. On-site or takeaway. Regional dishes to order only (\"mistral\" chicken, aioli, leg of lamb...). Shaded terrace. Reservations recommended."
    ],
    "it": [
      "Aperto 6 giorni alla settimana. Sul posto o da portare via. Piatti regionali solo su ordinazione (pollo \"mistral\", aioli, cosciotto d'agnello?). Terrazza ombreggiata. Si consiglia la prenotazione."
    ],
    "fr": [
      "Ouvert 6j/7. Sur place ou à emporter. Plats régionaux uniquement sur commande (poulet \" mistral \",aïoli, gigot d'agneau…). Terrasse ombragée. Réservation conseillée."
    ],
    "es": [
      "Abierto 6 días a la semana. En el acto o para llevar. Platos regionales sólo por encargo (pollo \"mistral\", alioli, pierna de cordero...). Terraza sombreada. Se recomienda reservar."
    ],
    "nl": [
      "6 dagen per week geopend. Ter plaatse of om mee te nemen. Streekgerechten alleen op bestelling (\"mistral\" kip, aioli, lamsbout, enz.). Schaduwrijk terras. Reserveren aanbevolen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Arbre à Pizza"
    ]
  },
