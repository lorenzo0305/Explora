  "rdfs:comment": {
    "de": [
      "Bei Marion und Thomas wird das Biogemüse mit Sorgfalt angebaut und im Direktverkauf, in AMAP oder in Bioläden angeboten. Entdecken Sie auch ihr disruptives Restaurant, in dem die Produkte bis auf den Teller aufgewertet werden."
    ],
    "en": [
      "At Marion and Thomas, organic vegetables are grown with care and offered for direct sale, in AMAPs or in organic stores. And don't miss their disruptive restaurant, where the products are showcased right up to the plate."
    ],
    "it": [
      "Marion e Thomas coltivano con cura le loro verdure biologiche e le vendono direttamente, tramite AMAP o nei negozi biologici. Potete anche provare il loro ristorante dirompente, dove i prodotti sono presentati fino al piatto."
    ],
    "fr": [
      "Chez Marion et Thomas, les légumes bio sont cultivés avec soin et proposés en vente directe, en AMAP ou dans les magasins bio. À découvrir aussi dans leur restaurant disruptif où les produits sont valorisés jusque dans l'assiette."
    ],
    "es": [
      "Marion y Thomas cultivan sus verduras ecológicas con esmero y las venden directamente, a través de AMAP o en tiendas ecológicas. También puedes probar su disruptivo restaurante, donde los productos se exhiben hasta en el plato."
    ],
    "nl": [
      "Marion en Thomas verbouwen hun biologische groenten met zorg en verkopen ze rechtstreeks, via AMAP's of in biologische winkels. Je kunt ook hun ontwrichtende restaurant proberen, waar de producten tot op het bord worden gepresenteerd."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chez Marion et Thomas"
    ]
  },
