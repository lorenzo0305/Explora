  "rdfs:comment": {
    "de": [
      "Besuchen Sie im Herzen des Dorfes Cervières ein Museum, das in Frankreich einzigartig ist: die Maison des Grenadières, eine Museumswerkstatt für Golddrahtstickerei. Das Haus zeugt von einer spezifischen jahrhundertealten Geschichte des Haut-Forez."
    ],
    "en": [
      "In the heart of Cervières, come visit a unique museum in France : the Museum-workshop of goldwork embroidery. You will discover the history and the technique of the embroiderers called \"Grenadières\" specific to the Haut-Forez."
    ],
    "it": [
      "Godetevi una visita che unisce competenza tessile, storia militare, artigianato e paesaggio."
    ],
    "fr": [
      "Profitez d’une visite entre savoir-faire textile, histoire militaire, métier d'art et paysage."
    ],
    "nl": [
      "Geniet van een bezoek dat textielexpertise, militaire geschiedenis, vakmanschap en landschap combineert."
    ],
    "es": [
      "Disfrute de una visita que combina conocimientos textiles, historia militar, artesanía y paisaje."
    ]
  },
