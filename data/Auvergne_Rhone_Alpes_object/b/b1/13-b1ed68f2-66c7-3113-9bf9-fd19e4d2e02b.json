  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen säuerlichen Abend, an dem Sie die Akteure sind, indem Sie Ihre Stimmbänder entfalten. Und vergessen Sie vor allem nicht die Texte, wie Nagui sagen würde."
    ],
    "en": [
      "Come and enjoy a tangy evening where you're the actors, and you'll be able to deploy your vocal chords. And don't forget the lyrics, as Nagui would say."
    ],
    "it": [
      "Venite a godervi una serata piccante, in cui sarete voi gli attori, mentre allungherete le vostre corde vocali. E non dimenticate le parole, come direbbe Nagui."
    ],
    "fr": [
      "Venez passer une soirée acidulée où vous êtes les acteurs en déployant vos cordes vocales. Et surtout n'oubliez pas les paroles, comme dirait Nagui."
    ],
    "es": [
      "Vengan a disfrutar de una velada picante en la que ustedes serán los actores mientras estiran sus cuerdas vocales. Y no te olvides de la letra, como diría Nagui."
    ],
    "nl": [
      "Kom genieten van een pittige avond waarbij jullie de acteurs zijn terwijl jullie je stembanden uitrekken. En vergeet de tekst niet, zoals Nagui zou zeggen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Karaoké night"
    ]
  },
