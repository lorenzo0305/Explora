  "rdfs:comment": {
    "de": [
      "Anlässlich der Europäischen Tage des Denkmals ist der Eintritt in das Museum Mémoires d'Alpinismes kostenlos.\r\nEntdecken Sie die Welt des Alpinismus und die Geschichte der Route de la Bérarde."
    ],
    "en": [
      "On the occasion of the European Heritage Days, admission to the Mémoires d'Alpinismes museum is free.\r\nDiscover the world of mountaineering and the history of the Bérarde route."
    ],
    "it": [
      "In occasione delle Giornate Europee del Patrimonio, l'ingresso al museo Mémoires d'Alpinismes è gratuito.\r\nScoprite il mondo dell'alpinismo e la storia della via Bérarde."
    ],
    "fr": [
      "A l'occasion des journées européennes du patrimoine, l'entrée du musée Mémoires d'Alpinismes est gratuite.\r\nDécouvrez le monde de l'alpinisme et l'histoire de la route de la Bérarde."
    ],
    "nl": [
      "Ter gelegenheid van de Europese Erfgoeddagen is de toegang tot het museum Mémoires d'Alpinismes gratis.\r\nOntdek de wereld van het alpinisme en de geschiedenis van de route van Bérarde aan de hand van 400 m² tentoonstellingsstukken."
    ],
    "es": [
      "Con motivo de las Jornadas Europeas del Patrimonio, la entrada al museo Mémoires d'Alpinismes es gratuita.\r\nDescubra el mundo del alpinismo y la historia de la ruta de Bérarde."
    ]
  },
  "rdfs:label": {
    "en": [
