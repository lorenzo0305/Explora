  "rdfs:comment": {
    "de": [
      "Das Restaurant empfängt Sie in einem gemütlichen Raum, der mit antiken Gegenständen dekoriert ist. Der Chefkoch bietet Ihnen seine traditionelle regionale Küche an. Sie können auch eine Bergküche probieren (auf Bestellung: Raclette, Tartiflette...)."
    ],
    "en": [
      "The restaurant welcomes you in a warm setting decorated with antiques. The chef offers traditional local cuisine. You can also enjoy mountain cuisine (to order: raclette, tartiflette...)."
    ],
    "it": [
      "Il ristorante offre un'accoglienza calorosa, decorato con pezzi d'antiquariato. Lo chef propone una cucina tradizionale locale. È possibile anche assaggiare la cucina di montagna (su ordinazione: raclette, tartiflette, ecc.)."
    ],
    "fr": [
      "Le restaurant vous accueille dans un lieu chaleureux décoré d'objets anciens. Le chef vous proposera sa cuisine du terroir traditionnelle. Vous pourrez également déguster une cuisine montagnarde (sur commande : raclette, tartiflette...)."
    ],
    "nl": [
      "Het restaurant biedt een warm welkom, ingericht met antiek. De chef biedt traditionele lokale gerechten. Je kunt ook proeven van de bergkeuken (op bestelling: raclette, tartiflette, enz.)."
    ],
    "es": [
      "El restaurante ofrece una cálida bienvenida, decorado con antigüedades. El chef ofrece cocina local tradicional. También se puede degustar cocina de montaña (por encargo: raclette, tartiflette, etc.)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant la Chicholière"
    ]
  },
