  "rdfs:comment": {
    "de": [
      "Die Galerien 337 stellen Werke von anerkannten und aufstrebenden Künstlern aus. Einzigartige Orte der Geselligkeit und des Austauschs, um Sie bei Ihrer Suche bestmöglich zu unterstützen. Treten Sie ein in unsere Welt, um eine unvergessliche Erfahrung zu teilen."
    ],
    "en": [
      "Galeries 337 represent works by both established and emerging artists. Unique places of conviviality and exchange to accompany you in your search. Enter our world and share an unforgettable experience."
    ],
    "it": [
      "Le Galeries 337 rappresentano opere di artisti affermati ed emergenti. Luoghi unici di convivialità e scambio per accompagnarvi nella vostra ricerca. Entrate nel nostro mondo e condividete un'esperienza indimenticabile."
    ],
    "fr": [
      "Les Galeries 337 représentent des œuvres d'artistes reconnus et émergents. Des lieux uniques de convivialité et d'échanges pour vous accompagner au mieux dans votre recherche. Entrez dans notre univers afin de partager une expérience inoubliable."
    ],
    "es": [
      "Las Galeries 337 representan obras de artistas consagrados y emergentes. Lugares únicos de convivencia e intercambio para acompañarle en su búsqueda. Entre en nuestro mundo y comparta una experiencia inolvidable."
    ],
    "nl": [
      "Galeries 337 vertegenwoordigt werken van zowel gevestigde als opkomende kunstenaars. Unieke plekken van gezelligheid en uitwisseling om u te begeleiden in uw onderzoek. Treed binnen in onze wereld en beleef een onvergetelijke ervaring."
    ]
  },
