  "rdfs:comment": {
    "de": [
      "Le Cairn vereint :\r\n-einen Veranstaltungssaal (Konzerte, Aufführungen für junges Publikum, Festivals) \r\n-die gemeindeübergreifende Mediathek \r\n-das Vereinskino Le Clap \r\n-Praxisräume: Dojo, Tanz, Musik \r\n-einen Versammlungssaal \r\n-Ausstellungsräume"
    ],
    "en": [
      "The Cairn includes:\r\n- a performance hall (concerts, shows for young audiences, festivals)\r\n- the intercommunal media library\r\n- the Le Clap community cinema\r\n- practice rooms: dojo, dance, music\r\n- a meeting room\r\n- exhibition areas"
    ],
    "it": [
      "Un centro in cui gli appassionati di sport, gli amanti della letteratura, i cinefili, i frequentatori di teatri e i curiosi di ogni genere si incontrano e si incrociano con l'evolversi del programma della sede."
    ],
    "fr": [
      "Centre où le pratiquants sportifs, amateurs de littérature, cinéphiles, férus de spectacles et curieux en tous genres se retrouvent et se croisent au gré de la programmation du lieu."
    ],
    "es": [
      "Un centro donde se reúnen y se cruzan deportistas, literatos, cinéfilos, aficionados al teatro y curiosos de todo tipo, a medida que evoluciona la programación del recinto."
    ],
    "nl": [
      "Een centrum waar sportliefhebbers, literatuurliefhebbers, filmfanaten, theaterbezoekers en nieuwsgierigen van allerlei pluimage elkaar ontmoeten en kruisen naarmate het programma van de locatie zich ontwikkelt."
    ]
  },
  "rdfs:label": {
    "de": [
      "Kultur- und Sportzentrum Le Cairn"
    ],
    "en": [
      "Le Cairn Cultural and Sports Centre"
    ],
    "fr": [
      "Centre culturel Le Cairn"
    ]
  },
