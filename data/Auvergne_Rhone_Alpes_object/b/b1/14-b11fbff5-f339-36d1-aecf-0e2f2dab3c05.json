  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/720cd26f-b0e0-3162-8145-7310c617e9d2",
      "dc:description": {
        "de": [
          "Auf dem Programm in diesem Jahr stehen :\n? Impromptus mit dem Ballet du Nord,\n? ein Abend mit Mick Strauss, der mysteriösen Figur von Arthur B. Gillette, Gitarrist und Mitbegründer von Moriarty,\n? ein musikalisches Märchen aus 100% 9-9bis Paysages pas si sages\n? ein riesiges Yoga im Herzen unserer bemerkenswerten Bergbaustätte\n? und Workshops Metaphon-Instrument, Musik und Kulturerbe, Siebdruck."
        ],
        "en": [
          "This year's program includes :\n? impromptus with Ballet du Nord,\n? an evening with Mick Strauss, the mysterious character of Arthur B. Gillette, guitarist and co-founder of Moriarty,\n? a musical tale 100% 9-9bis Paysages pas si sages\n? giant yoga in the heart of our remarkable mining site\n? and workshops on Métaphone-Instrument, music and heritage, and screen printing."
        ],
        "it": [
          "In programma quest'anno :\nesibizioni estemporanee con il Ballet du Nord,\nuna serata con Mick Strauss, il misterioso personaggio di Arthur B. Gillette, chitarrista e cofondatore dei Moriarty,\nun racconto musicale 100% 9-9bis Paysages pas si sages\nyoga gigante nel cuore del nostro straordinario sito minerario\ne laboratori su Métaphone-Instrument, musica e patrimonio e serigrafia."
        ],
        "fr": [
          "Au programme cette année :\n• des impromptus avec le Ballet du Nord, \n• une soirée avec Mick Strauss le mystérieux personnage d’Arthur B. Gillette, guitariste et cofondateur de Moriarty, \n• un conte musical 100% 9-9bis Paysages pas si sages \n• un yoga géant au coeur de notre site minier remarquable\n• et des ateliers Métaphone-Instrument, musique et patrimoine, sérigraphie."
        ],
        "nl": [
          "Op het programma dit jaar :\n? geïmproviseerde optredens met het Ballet du Nord,\n? een avond met Mick Strauss, de mysterieuze figuur van Arthur B. Gillette, gitarist en medeoprichter van Moriarty,\n? een muzikaal verhaal 100% 9-9bis Paysages pas si sages\nreuzenyoga in het hart van onze opmerkelijke mijnsite\n? en workshops over metafoon-instrument, muziek en erfgoed, en zeefdrukken."
        ],
        "es": [
          "En el programa de este año :\n? actuaciones improvisadas con el Ballet du Nord,\n? una velada con Mick Strauss, el misterioso personaje de Arthur B. Gillette, guitarrista y cofundador de Moriarty,\n? un cuento musical 100% 9-9bis Paysages pas si sages\n? yoga gigante en el corazón de nuestro extraordinario yacimiento minero\n? y talleres sobre Métaphone-Instrument, música y patrimonio, y serigrafía."
        ]
      },
