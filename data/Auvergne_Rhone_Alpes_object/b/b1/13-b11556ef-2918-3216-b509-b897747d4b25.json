  "rdfs:comment": {
    "de": [
      "Begleiten Sie uns auf einen Tag voller Musik und guter Laune bei der Veranstaltung \"Ça chante à Brides\", die am 10. August ab 15:30 Uhr stattfindet!"
    ],
    "en": [
      "Join us for a day filled with music and good cheer at the \"Ça chante à Brides\" event, taking place on August 10th from 3:30pm!"
    ],
    "it": [
      "Unitevi a noi per una giornata all'insegna della musica e del buonumore in occasione dell'evento \"Ça chante à Brides\", che si terrà il 10 agosto a partire dalle 15.30!"
    ],
    "fr": [
      "Joignez-vous à nous pour une journée remplie de musique et de bonne humeur lors de l’événement \"Ça chante à Brides\", qui se déroulera le 10 août à partir de 15h30 !"
    ],
    "nl": [
      "Kom naar het evenement \"Ça chante à Brides\" op 10 augustus vanaf 15.30 uur voor een dag vol muziek en humor!"
    ],
    "es": [
      "Acompáñenos en una jornada llena de música y buen humor en el evento \"Ça chante à Brides\", que tendrá lugar el 10 de agosto a partir de las 15.30 horas"
    ]
  },
