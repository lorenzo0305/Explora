  "rdfs:comment": {
    "de": [
      "Das Restaurant l'Essentiel bietet Ihnen eine Küche mit lokalen, frischen und saisonalen Produkten.\r\nFinden Sie eine kreative und traditionelle Speisekarte mit einem Tagesmenü, aber auch Salate, Burger für den Sommer..."
    ],
    "en": [
      "The restaurant l'Essentiel offers you a cuisine with local, fresh and seasonal products.\r\nFind a creative and traditional menu, with a daily menu but also salads, burgers for the summer..."
    ],
    "it": [
      "Il ristorante l'Essentiel propone una cucina con prodotti locali, freschi e di stagione.\r\nTrovate un menù creativo e tradizionale, con un menù giornaliero ma anche insalate, hamburger per l'estate..."
    ],
    "fr": [
      "Le restaurant l'Essentiel vous propose une cuisine avec des produits locaux, frais et de saison.\r\nRetrouvez une carte créative et traditionnelle, avec un menu du jour mais aussi des salades, burgers pour l'été..."
    ],
    "nl": [
      "Het restaurant l'Essentiel biedt u een keuken met lokale, verse en seizoensgebonden producten.\r\nEen creatief en traditioneel menu, met een dagmenu maar ook salades, hamburgers voor de zomer..."
    ],
    "es": [
      "El restaurante l'Essentiel le ofrece una cocina con productos locales, frescos y de temporada.\r\nEncontrará una carta creativa y tradicional, con un menú diario pero también ensaladas, hamburguesas para el verano..."
    ]
  },
