          "additionalInformation": {
            "de": [
              "Mittwoch bis Sonntag mittags.\r\nFreitag und Samstag abends.\r\n\r\nIn der Sommersaison von Montag bis Sonntag mittags und freitags, samstags und sonntags abends.\r\nVorzugsweise mit Reservierung."
            ],
            "en": [
              "Wednesday to Sunday lunchtimes.\r\nFriday and Saturday evenings.\r\n\r\nIn summer, Monday to Sunday lunchtime and Fridays, Saturdays and Sunday evenings.\r\nReservations preferred."
            ],
            "it": [
              "Da mercoledì a domenica a pranzo.\r\nVenerdì e sabato sera.\r\n\r\nIn estate, dal lunedì alla domenica a pranzo e il venerdì, sabato e domenica sera.\r\nÈ preferibile la prenotazione."
            ],
            "fr": [
              "Du mercredi au dimanche les midis.\r\nVendredi et samedi les soirs.\r\n\r\nEn période estivale du lundi au dimanche midi et les vendredis, samedis et les dimanches soirs. \r\nSur réservation de préférence."
            ],
            "nl": [
              "Woensdag tot zondag lunchtijd.\r\nVrijdag- en zaterdagavond.\r\n\r\nIn de zomer van maandag tot zondag lunchtijd en vrijdag-, zaterdag- en zondagavond.\r\nReserveren gewenst."
            ],
            "es": [
              "Almuerzos de miércoles a domingo.\r\nViernes y sábados por la noche.\r\n\r\nEn verano, de lunes a domingo al mediodía y viernes, sábados y domingos por la noche.\r\nEs preferible reservar."
            ]
          },
