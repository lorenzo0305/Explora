  "rdfs:comment": {
    "de": [
      "In die Natur eintauchen, in Frankreich oder im Ausland, sich in der natürlichen Umgebung entfalten, sich Zeit nehmen, sie zu beobachten, sie zu verstehen, sie zu lieben... Das sind die Schlüsselwörter unserer Aufenthalte und Praktika."
    ],
    "en": [
      "Immerse yourself in nature, in France or abroad, blossom in the natural environment, take the time to observe, understand and love it... These are the watchwords of our stays and courses."
    ],
    "it": [
      "Immergersi nei grandi spazi aperti, in Francia o all'estero, sbocciare nell'ambiente naturale, prendersi il tempo per osservarlo, comprenderlo e amarlo... Queste sono le parole d'ordine delle nostre vacanze e dei nostri corsi."
    ],
    "fr": [
      "S'immerger en pleine nature, en France ou à l’étranger, s’épanouir dans le milieu naturel, prendre le temps de l’observer, de le comprendre, de l'aimer... Voilà les maîtres mots de nos séjours et stages."
    ],
    "es": [
      "Sumergirse en plena naturaleza, en Francia o en el extranjero, florecer en el medio natural, tomarse el tiempo de observarlo, comprenderlo y amarlo... Éstas son las consignas de nuestras vacaciones y cursos."
    ],
    "nl": [
      "Opgaan in de natuur, in Frankrijk of in het buitenland, opbloeien in de natuur, de tijd nemen om te observeren, te begrijpen en ervan te houden... Dit zijn de sleutelwoorden van onze vakanties en cursussen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Amarok l'Esprit Nature"
    ]
  },
