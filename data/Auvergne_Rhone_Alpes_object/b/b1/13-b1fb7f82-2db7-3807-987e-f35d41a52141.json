  "rdfs:comment": {
    "de": [
      "Die Chapellerie Traclet ist seit Ende des 19. Jahrhunderts in Roanne auf Hüte spezialisiert und seit 1996 auch im Internet zu finden. Diese Hutmacherei bietet noch immer zahlreiche Produkte an, die in Frankreich in der reinen Tradition der französischen Hutmacherei hergestellt werden."
    ],
    "en": [
      "Chapellerie Traclet has specialized in hats since the late 19th century in Roanne and on the web since 1996. This hat shop still offers many products made in France in the pure tradition of French hat-making."
    ],
    "it": [
      "La Chapellerie Traclet è specializzata in cappelli dalla fine del XIX secolo a Roanne e dal 1996 è presente sul web. Questo negozio di cappelli offre ancora molti prodotti realizzati in Francia nella pura tradizione della cappelleria francese."
    ],
    "fr": [
      "La Chapellerie Traclet est spécialisée dans le chapeau depuis la fin du XIXe siècle sur Roanne et sur le web depuis 1996. Cette chapellerie propose encore de nombreux produits fabriqués en France dans la pure tradition de la Chapellerie Française."
    ],
    "es": [
      "La Chapellerie Traclet está especializada en sombreros desde finales del siglo XIX en Roanne y en la web desde 1996. Esta sombrerería sigue ofreciendo numerosos productos fabricados en Francia siguiendo la pura tradición de la sombrerería francesa."
    ],
    "nl": [
      "Chapellerie Traclet is sinds het einde van de 19e eeuw gespecialiseerd in hoeden in Roanne en sinds 1996 op het web. Deze hoedenwinkel biedt nog steeds veel producten die in Frankrijk zijn gemaakt in de pure traditie van de Franse hoedenmakerij."
    ]
  },
