  "rdfs:comment": {
    "de": [
      "Italien zum Teilen!\r\nCiccio e Vino ist ein italienischer Feinkostladen, eine Weinbar und ein kleiner Imbiss und lädt Sie dazu ein, die Authentizität Italiens zu genießen. Hier finden Sie außergewöhnliche Wurst- und Käsesorten, frische Pasta, Piadine und viele andere Überraschungen."
    ],
    "en": [
      "Italy to share!\r\nItalian delicatessen, epicurean wine bar and snack bar, Ciccio e Vino invites you to savor the authenticity of Italy. Exceptional cured meats and cheeses, fresh pasta, piadine and many other surprises."
    ],
    "it": [
      "Italia da condividere!\r\nSalumeria italiana, enoteca epicurea e snack bar, Ciccio e Vino vi invita a gustare l'autenticità dell'Italia. Salumi e formaggi eccezionali, pasta fresca, piadine e tante altre sorprese."
    ],
    "fr": [
      "L’Italie à partager !\r\nÉpicerie fine italienne, bar à vin épicurien et petite restauration, Ciccio e Vino vous invite à savourer l’authenticité de l’Italie. Charcuteries et fromages d’exception, pâtes fraîche, piadine et bien d'autres surprises."
    ],
    "es": [
      "Italia para compartir\r\nCharcutería italiana, vinoteca epicúrea y snack bar, Ciccio e Vino le invita a saborear la autenticidad de Italia. Embutidos y quesos excepcionales, pasta fresca, piadine y muchas otras sorpresas."
    ],
    "nl": [
      "Italië om te delen!\r\nItaliaanse delicatessenwinkel, epicuristische wijnbar en snackbar, Ciccio e Vino nodigt je uit om de authenticiteit van Italië te proeven. Uitzonderlijke vleeswaren en kazen, verse pasta, piadine en vele andere verrassingen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ciccio e Vino"
    ]
  },
