      "dc:description": {
        "de": [
          "Ich bin seit 26 Jahren niedergelassen und biete ein Änderungsatelier vor Ort an. Ich bin 7 Tage die Woche anwesend. Ich kleide von Größe 40 bis 56."
        ],
        "en": [
          "Established 26 years ago, I offer an on-site alterations workshop. I'm available 7 days a week. I dress sizes 40 to 56."
        ],
        "it": [
          "Sono in attività da 26 anni e offro un laboratorio di modifiche in loco. Sono disponibile 7 giorni su 7. Vesto taglie dalla 40 alla 56."
        ],
        "fr": [
          "Installée depuis 26 ans, je propose un atelier de retouches sur place. Je suis présente 7 jours sur 7. J'habille du 40 au 56."
        ],
        "es": [
          "Llevo 26 años en el negocio y ofrezco un taller de arreglos in situ. Estoy disponible los 7 días de la semana. Atiendo tallas del 40 al 56."
        ],
        "nl": [
          "Ik besta al 26 jaar en bied een workshop op locatie aan. Ik ben 7 dagen per week beschikbaar. Ik pas maten 40 tot 56."
        ]
      },
