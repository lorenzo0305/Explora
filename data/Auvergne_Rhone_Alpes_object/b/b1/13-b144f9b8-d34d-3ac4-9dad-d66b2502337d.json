  "rdfs:comment": {
    "de": [
      "Archipel Art Contemporain ist eine in ihrer Struktur originelle Einrichtung, die im Bereich der Verbreitung und Entdeckung zeitgenössischer Kunst auf dem Gebiet von Saint-Gervais Mont-Blanc tätig ist!"
    ],
    "en": [
      "Archipel Art Contemporain is a device, original in its structure, which intervenes in the field of the dissemination and discovery of contemporary art in the territory of Saint-Gervais Mont-Blanc!"
    ],
    "it": [
      "Archipel Art Contemporain è un dispositivo, originale nella sua struttura, che interviene nel campo della divulgazione e scoperta dell'arte contemporanea nel territorio di Saint-Gervais Mont-Blanc!"
    ],
    "fr": [
      "Archipel Art Contemporain est un dispositif, original dans sa structure, qui intervient dans le champ de la diffusion et de la découverte de l’art contemporain sur le territoire de Saint-Gervais Mont-Blanc !"
    ],
    "nl": [
      "Archipel Art Contemporain is een organisatie met een originele structuur, die zich inzet voor de promotie en ontdekking van hedendaagse kunst in de regio Saint-Gervais Mont-Blanc!"
    ],
    "es": [
      "Archipel Art Contemporain es una organización con una estructura original que trabaja para promover y descubrir el arte contemporáneo en la zona de Saint-Gervais Mont-Blanc"
    ]
  },
