  "rdfs:comment": {
    "de": [
      "Sylvain Meucci bietet Ihnen Spaziergänge, Entdeckungswanderungen zu Fuß oder mit dem Fahrrad mit elektrischer Unterstützung an.\r\nBegleiter in den Bergen.\r\nMoniteur activités du cyclisme - coach vélo santé.\r\nD.U. Nutrition Santé Activité Physique et Montagne (Gesundheitsernährung, körperliche Aktivität und Berge)."
    ],
    "en": [
      "Sylvain Meucci offers walks and discovery tours on foot or by electric bike.\r\nMountain guide.\r\nCycling instructor - health cycling coach.\r\nD.U Nutrition Santé Activité Physique et Montagne."
    ],
    "it": [
      "Sylvain Meucci propone passeggiate ed escursioni di scoperta a piedi o in bicicletta a pedalata assistita.\r\nGuida alpina.\r\nIstruttore di ciclismo - allenatore di ciclismo per la salute.\r\nD.U Nutrizione Salute Attività Fisica e Montagna."
    ],
    "fr": [
      "Sylvain Meucci vous propose balades, randonnées découverte à pied ou à vélo à assistance électrique. \r\nAccompagnateur en montagne.\r\nMoniteur activités du cyclisme - coach vélo santé.\r\nD.U Nutrition Santé Activité Physique et Montagne."
    ],
    "es": [
      "Sylvain Meucci ofrece paseos y excursiones de descubrimiento a pie o en bicicleta con asistencia eléctrica.\r\nGuía de montaña.\r\nMonitor de ciclismo - entrenador de ciclismo de salud.\r\nD.U Nutrición Salud Actividad Física y Montaña."
    ],
    "nl": [
      "Sylvain Meucci biedt wandelingen en ontdekkingstochten te voet of met een elektrisch ondersteunde fiets.\r\nBerggids.\r\nFietsinstructeur - gezondheidscoach.\r\nD.U. Voeding, gezondheid, lichaamsbeweging en bergen."
    ]
  },
