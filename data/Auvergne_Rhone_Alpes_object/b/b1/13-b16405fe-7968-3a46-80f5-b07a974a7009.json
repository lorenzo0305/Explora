  "rdfs:comment": {
    "de": [
      "Ob mit Freunden, der Familie oder Kollegen, fordern Sie sich heraus und haben Sie Spaß als Bogenschützen in epischen Kämpfen, im Team oder als Einzelkämpfer. Für alle Altersgruppen, von 8 bis 78 Jahren..."
    ],
    "en": [
      "With friends, family or colleagues, come and challenge yourselves and have fun as archers in epic team or individual battles. For all ages, from 8 to 78..."
    ],
    "it": [
      "Con amici, familiari o colleghi, venite a sfidarvi e a divertirvi come arcieri in epiche battaglie di squadra o individuali. Per tutte le età, dagli 8 ai 78 anni..."
    ],
    "fr": [
      "Entre amis, en famille ou entre collègues, venez vous défier et vous amuser en tant qu’archers dans des combats épiques, par équipe ou en individuel. Pour tous les âges, de 8 à 78 ans..."
    ],
    "nl": [
      "Kom met vrienden, familie of collega's en daag jezelf uit en beleef veel plezier aan boogschieten in epische team- of individuele gevechten. Voor alle leeftijden, van 8 tot 78..."
    ],
    "es": [
      "Con amigos, familia o compañeros, venid a retaros y divertiros como arqueros en épicas batallas por equipos o individuales. Para todas las edades, de 8 a 78..."
    ]
  },
