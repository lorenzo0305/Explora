  "rdfs:comment": {
    "de": [
      "Fahren Sie vom mittelalterlichen Dorf Le Grand Serre aus durch die Landschaften der Drôme des Collines zwischen bukolischen Straßen, Wäldern und geschützter Natur. Zu entdecken in der App MHIKES."
    ],
    "en": [
      "From the medieval village of Grand Serre, cross the landscapes of the Drôme des Collines between bucolic roads, forest and preserved nature. On the way, enjoy a nature break at the Joanna Maria pond and at the arrival don't miss the medieval hall of Grand Serre."
    ],
    "it": [
      "Partendo dal villaggio medievale di Grand Serre, esplorate i paesaggi della Drôme des Collines, con le sue strade bucoliche, i boschi e la campagna incontaminata. Per saperne di più, consultate l'app MHIKES."
    ],
    "fr": [
      "Au départ du village médiéval du Grand Serre, traversez les paysages de la Drôme des Collines entre routes bucoliques, forêt et nature préservée. A découvrir dans l'application MHIKES."
    ],
    "nl": [
      "Vertrek vanuit het middeleeuwse dorp Grand Serre en verken de landschappen van de Drôme des Collines, met zijn bucolische wegen, bossen en ongerepte natuur. Ontdek de applicatie MHIKES."
    ],
    "es": [
      "Saliendo del pueblo medieval de Grand Serre, explora los paisajes de la Drôme des Collines, con sus bucólicas carreteras, bosques y paisajes vírgenes. Más información en la aplicación MHIKES."
    ]
  },
  "rdfs:label": {
