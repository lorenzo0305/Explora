  "rdfs:comment": {
    "de": [
      "La Comedia wird Sie mit seinem atemberaubenden Blick auf die Isère und die Stiftskirche Saint-Barnard verzaubern.  Restaurant Bistro und Pizzeria"
    ],
    "en": [
      "La Comedia will charm you with its breathtaking view of the Isère River and the Saint-Barnard Collegiate Church.\r\nEnjoy high-quality cuisine thanks to a regularly updated menu featuring gourmet ingredients!\r\n\r\nA wide selection of pizzas, ravioles of Romans, salads..."
    ],
    "it": [
      "La Comedia vi affascinerà con la sua vista mozzafiato sull'Isère e sulla collegiata di Saint-Barnard.  \r\nCucina di alta qualità grazie a un menu regolarmente aggiornato a base di prodotti gourmet!\r\nAmpia scelta di pizze, ravioli, insalate..."
    ],
    "fr": [
      "La Comedia vous charmera par sa vue imprenable sur l'Isère et la collégiale Saint-Barnard.  \r\nUne cuisine très qualitative grâce à un menu mis à jour régulièrement à base de produits gourmands !\r\nGrand choix de pizzas, ravioles, salades..."
    ],
    "es": [
      "La Comedia le seducirá con sus impresionantes vistas sobre el Isère y la colegiata de Saint-Barnard.  \r\nCocina de calidad gracias a una carta actualizada regularmente a base de productos gourmet\r\nAmplia selección de pizzas, raviolis, ensaladas..."
    ],
    "nl": [
      "La Comédia zal je betoveren met zijn adembenemende uitzicht over de Isère en de collegiale kerk Saint-Barnard.  Traditioneel restaurant en pizzeria"
    ]
  },
