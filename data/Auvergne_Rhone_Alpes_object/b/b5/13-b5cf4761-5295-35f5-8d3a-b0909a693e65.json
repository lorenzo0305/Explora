  "rdfs:comment": {
    "de": [
      "Ich bin seit drei Jahren professionelle Fotografin in der Gemeinde La Plagne Tarentaise. Ich kann mich in der gesamten Region Savoyen und Auvergne/Rhône-Alpes bewegen.\nMitglied der FFPMI seit Sommer 2024"
    ],
    "en": [
      "I've been a professional photographer for two years in La Plagne Tarentaise. I can travel anywhere in Savoie and Auvergne/Rhône-Alpes.\r\nMember of the FFPMI since summer 2024."
    ],
    "it": [
      "Sono un fotografo professionista da tre anni a La Plagne Tarentaise. Posso viaggiare ovunque in Savoia e in Alvernia/Rodano-Alpi.\nMembro della FFPMI dall'estate 2024"
    ],
    "fr": [
      "Je suis photographe professionnelle depuis trois ans sur la commune de La Plagne Tarentaise. Je peux me déplacer sur l'ensemble du territoire savoyard et Auvergne/Rhône-Alpes.\nMembre de la FFPMI depuis l'été 2024"
    ],
    "es": [
      "Soy fotógrafo profesional desde hace tres años en La Plagne Tarentaise. Puedo viajar a cualquier lugar en Savoie y Auvernia / Ródano-Alpes.\nMiembro de la FFPMI desde el verano de 2024"
    ],
    "nl": [
      "Ik ben al twee jaar professioneel fotograaf in La Plagne Tarentaise. Ik kan overal in de Savoie en Auvergne/Rhône-Alpes komen.\r\nLid van de FFPMI sinds de zomer van 2024."
    ]
  },
