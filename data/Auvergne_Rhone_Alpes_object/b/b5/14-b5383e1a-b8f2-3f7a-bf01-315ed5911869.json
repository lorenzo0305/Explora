  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/32d64905-f617-3ca3-8b6b-b83be73101a7",
      "dc:description": {
        "de": [
          "Nehmen Sie an einem Gourmet-Spaziergang durch Liévin teil.\nGeplant ist ein 5 km langer Rundgang mit drei Schlemmerstopps.\nAuf dem Programm stehen Sport und die Verkostung lokaler Produkte."
        ],
        "en": [
          "Join us for a gourmet walk around Liévin.\nA 5-kilometer circuit with 3 gourmet stops is planned.\nOn the program: sport and tasting of local products."
        ],
        "it": [
          "Partecipate alla passeggiata gastronomica intorno a Liévin.\nÈ previsto un circuito di 5 chilometri con 3 tappe gastronomiche.\nIn programma: sport e degustazione di prodotti locali."
        ],
        "fr": [
          "Participez à la balade gourmande dans Liévin.\nUn circuit de 5 kilomètres avec 3 arrêts gourmands est prévu.\nAu programme, sport et dégustation de produits locaux."
        ],
        "es": [
          "Participe en el paseo gastronómico por Liévin.\nEstá previsto un circuito de 5 kilómetros con 3 paradas gastronómicas.\nEn el programa: deporte y degustación de productos locales."
        ],
        "nl": [
          "Neem deel aan de gastronomische wandeling rond Liévin.\nEr staat een circuit van 5 kilometer met 3 gastronomische haltes op het programma.\nOp het programma: sport en proeven van lokale producten."
        ]
      },
