  "rdfs:comment": {
    "de": [
      "Besichtigung der Gärten und des Schlossweinkellers von Mai bis Oktober nach Terminvereinbarung."
    ],
    "en": [
      "17th century historical monument designed by Mansart. Please make an appointment if you wish to visit the gardens designed by Le Nôtre and taste the wines in the cellar which, incidentally, is the longest in the Beaujolais area (108 m)."
    ],
    "it": [
      "La più grande tenuta del Beaujolais e una delle più iconiche della Borgogna meridionale, Château de la Chaize, con la sua cantina e la tinaia lunga 108 metri, è classificata come Monument Historique."
    ],
    "fr": [
      "Plus grand domaine du Beaujolais, et l'un des plus iconique du Sud de la Bourgogne, le Château de la Chaize est, avec sa cave de 108 m de long et le cuvage, classé aux Monuments Historiques."
    ],
    "es": [
      "El Château de la Chaize, la finca más grande del Beaujolais y una de las más emblemáticas del sur de Borgoña, con su bodega de 108 metros de largo y su casa de cubas, está catalogado como Monumento Histórico."
    ],
    "nl": [
      "Château de la Chaize, het grootste landgoed in de Beaujolais en een van de meest iconische in Zuid-Bourgondië, staat met zijn 108 m lange kelder en kuipkamer op de monumentenlijst."
    ]
  },
  "rdfs:label": {
