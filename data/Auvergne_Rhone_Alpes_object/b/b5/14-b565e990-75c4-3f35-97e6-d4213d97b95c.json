      "dc:description": {
        "de": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\" (Meine Liebesgeschichte sind Sie).\nAm Donnerstag, den 24. Juli 2025 im Kursaal von Berck um 20.30 Uhr.\n\nPreise:\nErmäßigt: 10?\nVoller Preis: 15?\nKartenvorverkauf: Casino, Tourismusbüro und Ticketmaster."
        ],
        "en": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\".\nThursday, July 24, 2025 at Kursaal de Berck, 8:30 pm.\n\nPrice :\nReduced : 10?\nFull Price: 15?\nTickets available at: casino, tourist office and ticketmaster."
        ],
        "it": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\".\nGiovedì 24 luglio 2025 al Kursaal di Berck alle 20.30.\n\nPrezzo :\nBiglietto ridotto : 10?\nIntero: 15?\nBiglietti disponibili presso il casinò, l'ufficio turistico e ticketmaster."
        ],
        "fr": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\".\nLe jeudi 24 juillet 2025 au Kursaal de Berck à 20h 30. \n\nTarifs :\nRéduit : 10€\nPlein : 15€ \nBilletterie ouverte : casino, office de tourisme et ticketmaster."
        ],
        "es": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\".\nJueves 24 de julio de 2025 en el Kursaal de Berck a las 20.30 h.\n\nPrecio :\nEntrada reducida : 10?\nCompleta: 15?\nEntradas disponibles en el casino, la oficina de turismo y ticketmaster."
        ],
        "nl": [
          "Natasha St-Pier \"Mon histoire d'amour c'est vous\".\nDonderdag 24 juli 2025 in het Kursaal in Berck om 20.30 uur.\n\nPrijs :\nGereduceerd ticket : 10?\nVol: 15?\nTickets verkrijgbaar bij het casino, toeristenbureau en ticketmaster."
        ]
      },
