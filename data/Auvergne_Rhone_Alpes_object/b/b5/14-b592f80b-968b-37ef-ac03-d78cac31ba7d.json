  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f1046291-085e-34b9-85dd-d9ff380e8a7f",
      "dc:description": {
        "de": [
          "Vom 23. bis 27. Februar\n--------------------------------------\nAktivität: Winterzirkuskurs, angeboten von der Animationsabteilung des Rathauses von Merlimont\nTreffpunkt: Tourismusbüro Merlimont, von 10 bis 12 Uhr\nTARIF: 3? pro Sitzung\n\nSie können sich beim Service Animation im Office de Tourisme von Merlimont anmelden: 70 Avenue du Centre in Merlimont, montags bis freitags von 9 bis 12 Uhr\nKONTAKT: 03 21 94 72 18\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "February 23 to 27\n--------------------------------------\nActivity: Winter Circus Workshop offered by the Merlimont Town Council's Service Animation\nMeet at Merlimont Tourist Office, 10am to 12pm\nRATE: 3? per session\n\nYou can register at the Service Animation located in the Merlimont Tourist Office: 70 Avenue du center, Merlimont, Monday to Friday, 9am to 12pm\nCONTACT : 03 21 94 72 18\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Dal 23 al 27 febbraio\n--------------------------------------\nAttività: Laboratorio di circo invernale a cura dell'Ufficio Eventi del Comune di Merlimont\nPunto d'incontro: Ufficio del Turismo di Merlimont, dalle 10.00 alle 12.00\nTARIFFA: 3? per sessione\n\nÈ possibile iscriversi presso il servizio di animazione situato nell'Ufficio del Turismo di Merlimont: 70 Avenue du centre, Merlimont, dal lunedì al venerdì, dalle 9.00 alle 12.00\nCONTATTO: 03 21 94 72 18\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Du 23 au 27 février\n--------------------------------------\nActivité : Stage de Cirque d'Hiver proposée par le Service Animation de la Mairie de Merlimont\nRendez-vous à l'Office de Tourisme de Merlimont, de 10h à 12h\nTARIF : 3€ par séance\n\nVous pouvez vous inscrire au près du Service Animation situé dans l'Office de Tourisme de Merlimont : 70 Avenue du centre à Merlimont, du lundi au vendredi de 9h à 12h\nCONTACT : 03 21 94 72 18\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Van 23 tot 27 februari\n--------------------------------------\nActiviteit: Wintercircusworkshop aangeboden door de Dienst Evenementen van de Stad Merlimont\nTrefpunt: Toeristische dienst van Merlimont, 10u tot 12u\nTarief: 3? per sessie\n\nJe kunt je inschrijven bij de Dienst Animatie in de Dienst voor Toerisme van Merlimont: 70 Avenue du centre, Merlimont, van maandag tot vrijdag van 9 tot 12 uur\nCONTACT: 03 21 94 72 18\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Del 23 al 27 de febrero\n--------------------------------------\nActividad: Taller de Circo de Invierno ofrecido por el Departamento de Eventos del Ayuntamiento de Merlimont\nPunto de encuentro: Oficina de Turismo de Merlimont, de 10 a 12 horas\nTARIFA: 3? por sesión\n\nPuede inscribirse en el Servicio de Animación situado en la Oficina de Turismo de Merlimont: 70 Avenue du centre, Merlimont, de lunes a viernes, de 9h a 12h\nCONTACTO: 03 21 94 72 18\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
