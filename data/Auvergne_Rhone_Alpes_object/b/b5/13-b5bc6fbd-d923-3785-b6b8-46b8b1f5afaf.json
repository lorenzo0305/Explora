  "rdfs:comment": {
    "de": [
      "Die Boutique du Viel Audon und ihr Getränkestand sind das ganze Jahr über geöffnet. Produkte vom Bauernhof (Ziegenkäse, Kräuter, Fleisch ...) und lokale Produkte, lokale Kunstwerke und eine kleine Buchhandlung. Kleine Imbisse von April bis September."
    ],
    "en": [
      "The Viel Audon store and refreshment bar are open all year round. Farm products (goat's cheese, herbs, meat, etc.) and local produce, local art and a small bookshop. Snack bar from April to September."
    ],
    "it": [
      "Il negozio e il bar del Viel Audon sono aperti tutto l'anno. Prodotti della fattoria (formaggio di capra, erbe, carne, ecc.) e prodotti locali, arte locale e una piccola libreria. Snack bar aperto da aprile a settembre."
    ],
    "fr": [
      "La boutique du Viel Audon et sa buvette sont ouvertes toute l'année. Produits de la ferme (fromages de chèvre, plantes aromatiques, viande ...) et produits locaux, créations artistiques locales et petite librairie. Petite restauration d'avril à septembre."
    ],
    "es": [
      "La tienda y el bar de Viel Audon están abiertos todo el año. Productos de granja (queso de cabra, hierbas, carne, etc.) y productos locales, arte local y una pequeña librería. Merendero abierto de abril a septiembre."
    ],
    "nl": [
      "De winkel en verfrissingsbar van Viel Audon zijn het hele jaar door geopend. Producten van de boerderij (geitenkaas, kruiden, vlees, enz.) en lokale producten, lokale kunst en een kleine boekwinkel. Snackbar geopend van april tot september."
    ]
  },
