  "rdfs:comment": {
    "de": [
      "Olivier Deloire und Claire Pichot empfangen Sie in einem Gebäude aus dem 17. Jahrhundert für ein Essen mit der Familie oder mit Freunden ab 10 Personen. Traditionelle Küche mit Produkten vom Bauernhof. Produkte aus einer bäuerlichen Landwirtschaft."
    ],
    "en": [
      "Olivier Deloire and Claire Pichot welcome you to a 17th-century building, for a meal with family or friends for 10 or more. Traditional cuisine based on farm products. Farm-fresh products."
    ],
    "it": [
      "Olivier Deloire e Claire Pichot vi accolgono in un edificio del XVII secolo per un pasto in famiglia o con gli amici a partire da 10 persone. Cucina tradizionale a base di prodotti di fattoria. Prodotti della fattoria."
    ],
    "fr": [
      "Olivier Deloire et Claire Pichot vous accueillent dans une bâtisse du XVIIe siècle, pour un repas en famille ou entre amis à partir de 10 personnes. Cuisine traditionnelle à base de produits issus de la ferme. Produits issus d'une agriculture paysanne."
    ],
    "es": [
      "Olivier Deloire y Claire Pichot le acogen en un edificio del siglo XVII para una comida en familia o entre amigos a partir de 10 personas. Cocina tradicional a base de productos de la granja. Productos de la granja."
    ],
    "nl": [
      "Olivier Deloire en Claire Pichot heten u welkom in een 17e-eeuws gebouw voor een maaltijd met familie of vrienden vanaf 10 personen. Traditionele keuken op basis van producten van de boerderij. Producten van de boerderij."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme Auberge La Grange à Liens"
    ]
  },
