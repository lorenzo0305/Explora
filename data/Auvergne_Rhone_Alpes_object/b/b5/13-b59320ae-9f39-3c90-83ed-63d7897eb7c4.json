  "rdfs:comment": {
    "de": [
      "Lola, Aurélien und Gaspard, die sich seit 2018 niedergelassen haben, freuen sich, Sie auf Terre-Ferme sur Arzon begrüßen zu dürfen, einem agroökologischen Mikro-Bauernhof, der sich ständig weiterentwickelt!"
    ],
    "en": [
      "Lola, Aurélien and Gaspard, settled since 2018 are delighted to welcome you to Terre-Ferme sur Arzon, an agroecological micro-farm in perpetual evolution!"
    ],
    "it": [
      "Lola, Aurélien e Gaspard, che lavorano qui dal 2018, sono lieti di darvi il benvenuto a Terre-Ferme sur Arzon, una micro-fattoria agro-ecologica in continua evoluzione!"
    ],
    "fr": [
      "Lola, Aurélien et Gaspard, installés depuis 2018 sont ravis de vous accueillir à Terre-Ferme sur Arzon, une micro-ferme agroécologique en perpétuelle évolution !"
    ],
    "es": [
      "Lola, Aurélien y Gaspard, que trabajan aquí desde 2018, están encantados de darte la bienvenida a Terre-Ferme sur Arzon, ¡una microgranja agroecológica en constante evolución!"
    ],
    "nl": [
      "Lola, Aurélien en Gaspard, die hier sinds 2018 werken, heten je van harte welkom op Terre-Ferme sur Arzon, een agro-ecologische microboerderij die voortdurend in ontwikkeling is!"
    ]
  },
