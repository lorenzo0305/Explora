  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg der ersten Veranstaltung organisiert der Verein \"Les Belles Mécaniques en Bourbonnais\" Cusset Historic für eine zweite Auflage am Samstag, den 20. und Sonntag, den 21. Juni 2026 an der Côte des Justices."
    ],
    "en": [
      "Following the success of its first edition, the association \"Les Belles Mécaniques en Bourbonnais\" is organizing a second edition of Cusset Historic on Saturday June 20 and Sunday June 21, 2026, on the Côte des Justices."
    ],
    "it": [
      "Dopo il successo della prima edizione, l'associazione \"Les Belles Mécaniques en Bourbonnais\" organizza una seconda edizione del Cusset Historic sabato 20 e domenica 21 giugno 2026, sulla Côte des Justices."
    ],
    "fr": [
      "Suite au succès de sa première édition, l’association « Les Belles Mécaniques en Bourbonnais » organise Cusset Historic pour une deuxième édition les samedi 20 et dimanche 21 juin 2026, sur la Côte des Justices."
    ],
    "es": [
      "Tras el éxito de su primera edición, la asociación \"Les Belles Mécaniques en Bourbonnais\" organiza una segunda edición de Cusset Historique el sábado 20 y el domingo 21 de junio de 2026, en la Côte des Justices."
    ],
    "nl": [
      "Na het succes van de eerste editie organiseert de vereniging \"Les Belles Mécaniques en Bourbonnais\" een tweede editie van Cusset Historic op zaterdag 20 en zondag 21 juni 2026, aan de Côte des Justices."
    ]
  },
