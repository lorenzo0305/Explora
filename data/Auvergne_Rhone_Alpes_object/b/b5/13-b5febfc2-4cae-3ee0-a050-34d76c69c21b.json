  "rdfs:comment": {
    "de": [
      "Im Herzen der Rue des Moulins gelegen, öffnen Sie die Türen der Bar du Moulin, einem emblematischen und unumgänglichen Ort des Nachtlebens in Chamonix."
    ],
    "en": [
      "Located in the heart of the Rue des Moulins, open the doors to the Bar du Moulin, an emblematic and essential part of Chamonix's nightlife."
    ],
    "it": [
      "Nel cuore di Rue des Moulins, si aprono le porte del Bar du Moulin, un locale emblematico e imperdibile della vita notturna di Chamonix."
    ],
    "fr": [
      "Situé au coeur de la rue des Moulins, ouvrez les portes du Bar du Moulin, un lieu emblématique et incontournable de la vie nocturne chamoniarde"
    ],
    "es": [
      "Situado en el corazón de la rue des Moulins, abra las puertas del Bar du Moulin, local emblemático e ineludible de la vida nocturna de Chamonix."
    ],
    "nl": [
      "Open in het hart van de Rue des Moulins de deuren van de Bar du Moulin, een emblematische en niet te missen locatie in het nachtleven van Chamonix"
    ]
