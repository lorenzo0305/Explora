  "rdfs:comment": {
    "de": [
      "Die Fruitière du Valromey bietet Comté, Tomme, Raclette, Butter, Sahne und Quark an.\r\nSie verfügt über einen Besucherbereich, in dem die Herstellung des Comté erklärt wird, einen Ausstellungsraum und einen Laden mit lokalen Produkten."
    ],
    "en": [
      "The Fruitière du Valromey offers Comté, tomme, raclette, butter, cream and fromage blanc. \r\nIt is equipped with a visit area explaining the making of Comté cheese, an exhibition room and a shop selling local products."
    ],
    "it": [
      "La Fruitière du Valromey offre Comté, tomme, raclette, burro, panna e fromage blanc.\r\nÈ dotata di un'area di visita che illustra la produzione del formaggio Comté, di una sala espositiva e di un negozio di prodotti locali."
    ],
    "fr": [
      "La Fruitière du Valromey propose du Comté, de la tomme, de la raclette, du beurre, de la crème et du fromage blanc. \r\nElle est équipée d'un espace de visite expliquant la fabrication du Comté, d'une salle d'exposition et d'une boutique de produits locaux."
    ],
    "es": [
      "La Fruitière du Valromey ofrece Comté, tomme, raclette, mantequilla, nata y fromage blanc.\r\nEstá equipada con un espacio de visita que explica la fabricación del queso Comté, una sala de exposiciones y una tienda de productos locales."
    ],
    "nl": [
      "De Fruitière du Valromey biedt Comté, tomme, raclette, boter, room en fromage blanc.\r\nEr is een bezoekruimte met uitleg over het maken van Comté-kaas, een expositieruimte en een winkel met streekproducten."
    ]
  },
  "rdfs:label": {
    "de": [
      "La Fruitière du Valromey - Herstellung von Comté-Käse"
    ],
    "en": [
      "\"Fruitière du Valromey\": production of Comté cheese"
    ],
    "fr": [
      "La Fruitière du Valromey - Production de Comté"
    ]
  },
