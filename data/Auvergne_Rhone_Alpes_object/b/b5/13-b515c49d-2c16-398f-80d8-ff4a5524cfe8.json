  "rdfs:comment": {
    "de": [
      "Chanvre d'Auvergne aujourd'hui ist eine Vereinigung von Hanfproduzenten, deren Ziel es ist, \"eine Verbindung zwischen Landwirten, Baufachleuten und Selbstbauern rund um ein lokales, faires und gesundes Produkt zu schaffen\"."
    ],
    "en": [
      "Chanvre d'Auvergne aujourd'hui is an association of hemp producers whose aim is to \"create a link between farmers, building professionals and self-builders around a local, fair-trade and healthy product\"."
    ],
    "it": [
      "Chanvre d'Auvergne è un'associazione di produttori di canapa il cui obiettivo è \"creare un legame tra agricoltori, professionisti dell'edilizia e autocostruttori intorno a un prodotto locale, equo e sano\"."
    ],
    "fr": [
      "Chanvre d’Auvergne aujourd’hui, est une association de producteur de chanvre dont le but est de « Créer un lien entre agriculteurs, professionnels du bâtiment et auto-constructeurs autour d’un produit local, équitable et sain »."
    ],
    "nl": [
      "Chanvre d?Auvergne is een vereniging van hennepproducenten met als doel \"een band te creëren tussen boeren, bouwprofessionals en zelfbouwers rond een lokaal, eerlijk en gezond product\"."
    ],
    "es": [
      "Chanvre d'Auvergne es una asociación de productores de cáñamo cuyo objetivo es \"crear un vínculo entre agricultores, profesionales de la construcción y autoconstructores en torno a un producto local, justo y sano\"."
    ]
  },
