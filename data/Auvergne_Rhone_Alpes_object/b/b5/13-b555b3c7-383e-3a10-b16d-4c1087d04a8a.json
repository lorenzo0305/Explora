  "rdfs:comment": {
    "de": [
      "Gut und lecker essen, das ist unsere Philosophie seit fünf Generationen. Kommen Sie und probieren Sie unsere komplett hausgemachte Küche. Wir bieten Ihnen Gerichte à la carte, Menüs oder Tagesgerichte an."
    ],
    "en": [
      "Good eating is the philosophy of \"La Clairière’s\" cuisine. Frogs are the stars\r\nof the house. Other dishes and Regional specialties will dazzle you. \r\nFrom April to September open every days for lunch."
    ],
    "it": [
      "Il buon cibo e la buona tavola sono la nostra filosofia da 5 generazioni. Venite a gustare la nostra cucina casalinga. Offriamo piatti à la carte, menu e specialità del giorno."
    ],
    "fr": [
      "Bien et bon manger, telle est notre philosophie depuis 5 générations. Venez déguster notre cuisine entièrement faite maison. Nous vous proposons des plats à la carte, menus ou plats du jour."
    ],
    "es": [
      "La buena comida y el buen comer han sido nuestra filosofía durante 5 generaciones. Venga a degustar nuestra cocina casera. Ofrecemos platos a la carta, menús y especiales del día."
    ],
    "nl": [
      "Goed eten en lekker eten is al 5 generaties lang onze filosofie. Kom en proef onze huisgemaakte keuken. Wij bieden à la carte gerechten, menu's en dagschotels."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Clairiere - Restaurant"
    ],
    "fr": [
      "Restaurant La Clairiere"
    ]
  },
