  "rdfs:comment": {
    "de": [
      "Erleben Sie eine einzigartige Erfahrung und tanken Sie Nervenkitzel! Stürzen Sie sich von der Spielzone Chaput, gegenüber den Aiguilles d'Arves, in die Tiefe und gleiten Sie 150 m über den Eriscal-See. Ein atemberaubendes Panorama!"
    ],
    "en": [
      "Treat yourself to a unique and unforgettable experience. For thrill seekers!  Take off from the Chaput play area, facing the Aiguilles d'Arves and glide above the Eriscal lake for 150m. A breathtaking panorama!"
    ],
    "it": [
      "Godetevi un'esperienza unica e fate il pieno di emozioni! Lanciatevi dalla zona di divertimento Chaput, di fronte alle Aiguilles d'Arves, e planate sul lago Eriscal per 150 metri. Un panorama mozzafiato!"
    ],
    "fr": [
      "Vivez une expérience unique et faites le plein de sensations fortes! Elancez-vous depuis la zone ludique du Chaput, face aux Aiguilles d'Arves et glissez au dessus du lac de l'Eriscal pendant 150m. Un panorama à couper le souffle!"
    ],
    "es": [
      "Disfrute de una experiencia única y llénese de emociones Lánzate desde la zona de diversión Chaput, frente a las Aiguilles d'Arves, y planea sobre el lago Eriscal durante 150 m. Un panorama impresionante"
    ],
    "nl": [
      "Beleef een unieke ervaring en intense gewaarwordingen! Vertrek vanaf de Chaput-speeltuin, met uitzicht op de Aiguilles d'Arves en glijd 150 meter boven het Eriscal-meer. Een adembenemend panorama!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Eriscal Zip Line"
    ],
    "fr": [
      "Tyrolienne de l'Eriscal"
    ],
    "nl": [
      "TOKKELBAAN"
    ]
  },
