  "rdfs:comment": {
    "de": [
      "Kurse für klassischen Langlauf, Skating, Biathlon und Schneeschuhwandern, Gruppenkurse, wöchentlich, mit der Möglichkeit der Teilnahme an einem halben oder ganzen Tag.\r\nOffen für alle Niveaus, vom Anfänger bis zum Fortgeschrittenen, Kinder & Erwachsene."
    ],
    "en": [
      "Classical cross-country skiing, skating, biathlon and snowshoeing courses, group lessons, weekly, with the possibility of full-day or half-day participation.\nOpen to all levels, from beginner to advanced, children & adults."
    ],
    "it": [
      "Lezioni di sci di fondo classico, pattinaggio, biathlon e racchette da neve, lezioni di gruppo, a settimana, con la possibilità di partecipare per una giornata o mezza giornata.\r\nAperto a tutti i livelli, da principiante ad avanzato, bambini e adulti."
    ],
    "fr": [
      "Cours de ski de fond classique, skating, biathlon et raquettes à neige, cours collectifs, à la semaine, avec possibilité de participation à la journée ou à la demi-journée.\r\nOuverts à tous les niveaux, du débutant au confirmé, enfants & adultes."
    ],
    "nl": [
      "Lessen in klassiek langlaufen, schaatsen, biatlon en sneeuwschoenwandelen, groepslessen, per week, met de mogelijkheid om een dag of een halve dag deel te nemen.\nOpen voor alle niveaus, van beginners tot gevorderden, kinderen en volwassenen."
    ],
    "es": [
      "Clases de esquí de fondo clásico, patinaje, biatlón y raquetas de nieve, clases en grupo, por semanas, con la opción de participar durante un día o medio día.\r\nAbierto a todos los niveles, de principiante a avanzado, niños y adultos."
    ]
  },
