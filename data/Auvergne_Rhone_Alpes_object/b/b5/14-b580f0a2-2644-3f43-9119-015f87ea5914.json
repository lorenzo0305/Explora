  "rdfs:comment": {
    "de": [
      "Das Louvre-Lens-Museum ist ein Ort der Erlebnisse, an dem sich die Teams engagieren, um Sie über Ihre Erwartungen hinaus mitzunehmen."
    ],
    "en": [
      "The Louvre-Lens Museum is a place of experiences where the teams are mobilized to take you beyond your expectations."
    ],
    "it": [
      "Il Museo Louvre-Lens è un luogo di esperienze in cui le équipe sono mobilitate per portarvi oltre le vostre aspettative."
    ],
    "fr": [
