  "rdfs:comment": {
    "de": [
      "Diese speziell für Fahrräder entwickelte Mission ermöglicht es, den Kanal aus einem anderen Blickwinkel zu entdecken.\r\nUm zu spielen, laden Sie die kostenlose mobile App \"PÉPIT\" herunter."
    ],
    "en": [
      "This mission specially designed for bicycles allows you to discover the canal from another angle.\r\nTo play, download the free mobile application \"PÉPIT\"."
    ],
    "it": [
      "Questa missione, appositamente progettata per le biciclette, permette di scoprire il canale da un'angolazione diversa.\r\nPer giocare, scaricare l'applicazione mobile gratuita \"PÉPIT\"."
    ],
    "fr": [
      "Cette mission spécialement conçue pour les vélos permet de découvrir le canal sous un autre angle.\r\nPour jouer, téléchargez l’application mobile gratuite \"PÉPIT\"."
    ],
    "es": [
      "Esta misión, especialmente diseñada para bicicletas, le permite descubrir el canal desde un ángulo diferente.\r\nPara jugar, descargue la aplicación móvil gratuita \"PÉPIT\"."
    ],
    "nl": [
      "Deze missie, speciaal ontworpen voor fietsen, stelt u in staat het kanaal vanuit een andere hoek te ontdekken.\r\nOm te spelen download je de gratis mobiele applicatie \"PÉPIT\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "PÉPIT : Halez et venez le long du canal"
    ]
  },
