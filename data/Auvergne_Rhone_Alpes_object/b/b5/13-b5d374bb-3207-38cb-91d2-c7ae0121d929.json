  "rdfs:comment": {
    "de": [
      "Sie suchen einen geselligen und unkomplizierten Ort, um etwas zu essen? La Terrasse empfängt Sie im Stadtzentrum von Lamastre und bietet Ihnen eine traditionelle Küche, die aus frischen und lokalen Produkten zubereitet wird."
    ],
    "en": [
      "Seeking a friendly spot for dining, drinks, or ice cream? Visit La Terrasse: bar, restaurant, ice cream parlor in Lamastre's center, nestled in Monts d'Ardèche Regional Nature Park. Enjoy fresh, local seasonal cuisine."
    ],
    "it": [
      "Cercate un posto semplice e accogliente dove mangiare? La Terrasse si trova proprio nel centro di Lamastre e serve una cucina tradizionale a base di prodotti freschi locali."
    ],
    "fr": [
      "Vous cherchez un endroit convivial et simple pour vous restaurer ? La Terrasse vous accueille en plein centre-ville de Lamastre et vous propose une cuisine traditionnelle élaborée à partir de produits frais et locaux."
    ],
    "es": [
      "¿Busca un lugar sencillo y acogedor para comer? La Terrasse está en pleno centro de Lamastre y sirve cocina tradicional elaborada con productos frescos de la zona."
    ],
    "nl": [
      "Ontdek La Terrasse: een gezellige plek in Lamastre's centrum, voor eten, drinken en ijs. Geniet van onze traditionele, seizoensgebonden keuken met verse lokale producten in het hart van Monts d'Ardèche."
    ]
  },
