  "rdfs:comment": {
    "de": [
      "Ein von einem Mutter-Tochter-Duo geführtes Familienrestaurant, das mit frischen Zutaten belegte Holzofenpizzen anbietet."
    ],
    "en": [
      "Everything started 10 years ago, from a simple country restaurant, today the business is run by the mother and the daughter who propose wonderful pizzas."
    ],
    "it": [
      "Un ristorante a conduzione familiare gestito da un duo madre-figlia che offre pizze cotte a legna e condite con ingredienti freschi."
    ],
    "fr": [
      "Un restaurant familial géré par un duo mère/fille qui propose des pizzas cuites au feu de bois garnies d'ingrédients frais."
    ],
    "es": [
      "Un restaurante familiar dirigido por un dúo de madre e hija que ofrece pizzas al horno de leña con ingredientes frescos."
    ],
    "nl": [
      "Een familierestaurant gerund door een moeder/dochter duo dat houtgestookte pizza's met verse ingrediënten aanbiedt."
    ]
