  "rdfs:comment": {
    "de": [
      "Digitales Museum und Raum für virtuelle Realität: Die Micro-Folie ist in Zusammenarbeit mit 12 nationalen Kulturinstitutionen entstanden, die sie gegründet haben. Sie ist eine echte kulturelle Plattform in der Nähe, die den Zugang zu Kunst und Wissen demokratisiert."
    ],
    "en": [
      "Digital museum and virtual reality space: La Micro-Folie works in collaboration with 12 founding national cultural institutions. It's a truly local cultural platform that democratizes access to art and knowledge."
    ],
    "it": [
      "Un museo digitale e uno spazio di realtà virtuale: La Micro-Folie lavora in collaborazione con 12 istituzioni culturali nazionali fondatrici. È una piattaforma culturale veramente locale che democratizza l'accesso all'arte e alla conoscenza."
    ],
    "fr": [
      "Musée numérique  et espace de réalité Virtuelle : La Micro-Folie s'articule en collaboration avec 12 Ets Culturels Nationaux Fondateurs. C'est une véritable plateforme culturelle de proximité permettant de démocratiser l'accès à l'Art et au Savoir."
    ],
    "es": [
      "Museo digital y espacio de realidad virtual: La Micro-Folie trabaja en colaboración con 12 instituciones culturales nacionales fundadoras. Es una plataforma cultural verdaderamente local que democratiza el acceso al arte y al conocimiento."
    ],
    "nl": [
      "Een digitaal museum en virtual reality-ruimte: La Micro-Folie werkt samen met 12 nationale culturele instellingen. Het is een echt lokaal cultureel platform dat de toegang tot kunst en kennis democratiseert."
    ]
  },
