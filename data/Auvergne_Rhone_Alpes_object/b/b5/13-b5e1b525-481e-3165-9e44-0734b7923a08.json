  "rdfs:comment": {
    "de": [
      "Valence Arcade empfängt nostalgische Spieler in einem über 80 m2 großen Gaming-Bereich! Nicht weniger als 20 Automaten werden regelmäßig erneuert. Es stehen Arcade-Terminals, 3 Flipperautomaten, ein Tischfußball und vieles mehr zur Verfügung..."
    ],
    "en": [
      "Valence Arcade welcomes nostalgic gamers to its 80 m2 gaming space! No fewer than 20 machines, renewed periodically. You'll find arcade machines, 3 pinball machines, table soccer and much more..."
    ],
    "it": [
      "La sala giochi di Valence accoglie i nostalgici nella sua area di gioco di 80 m2! Ci sono non meno di 20 macchine, che vengono rinnovate periodicamente. Ci sono macchine arcade, 3 flipper, calcio balilla e molto altro..."
    ],
    "fr": [
      "Valence Arcade accueille les joueurs nostalgiques dans un espace gaming de plus de 80 m2 ! Pas moins de 20 machines renouvelées périodiquement. Seront à disposition des bornes d'arcade, 3 flippers, un baby-foot et bien plus encore..."
    ],
    "nl": [
      "Valence Arcade verwelkomt nostalgische gamers in zijn speelhal van 80 m2! Er staan niet minder dan 20 machines, die regelmatig worden vernieuwd. Er zijn arcadekasten, 3 flipperkasten, tafelvoetbal en nog veel meer..."
    ],
    "es": [
      "Valence Arcade recibe a los jugadores nostálgicos en su zona de juego de 80 m2 Hay nada menos que 20 máquinas, que se renuevan periódicamente. Hay máquinas recreativas, 3 pinballs, futbolines y mucho más..."
    ]
  },
