  "rdfs:comment": {
    "de": [
      "Restaurant mit französischer Küche mit italienischen Einschlägen\r\nFrische, saisonale Produkte"
    ],
    "en": [
      "The restaurant serves fresh products with a short food supply chain. Seasonal menu, a warm and cosy atmosphere. A pleasant welcome and smile, we make a point of honor of welcoming you to make you feel at home. Off-season: open from Monday to Saturday (closed for dinner on Monday and Thursday). In the summer: open for lunch and dinner every day."
    ],
    "it": [
