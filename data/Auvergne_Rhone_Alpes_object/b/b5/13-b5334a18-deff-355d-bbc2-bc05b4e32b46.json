  "rdfs:comment": {
    "de": [
      "Entdecken Sie den neuen Ponton für Personen mit eingeschränkter Mobilität am Oberlauf des Flon mit seinem Weg sowie einen \"Familien\"-Angelparcours entlang der Rhone. 3 Angelstellen säumen diese Strecke."
    ],
    "en": [
      "A special platform created for anglers with reduced mobility, upstream of the Flon and with an access path, plus a \"family\" fishing area along the river Rhône providing 3 fishing sites."
    ],
    "it": [
      "Scoprite il nuovo pontone per persone a mobilità ridotta a monte del Flon con il suo percorso e un sentiero di pesca \"familiare\" lungo il Rodano. lungo questo percorso ci sono 3 stazioni di pesca."
    ],
    "fr": [
      "Découvrez le nouveau ponton pour personnes à mobilité réduite à l'amont du Flon avec son cheminement ainsi qu'un parcours de pêche\" famille\" le long du Rhône. 3 postes de pêche jalonnent ce parcours."
    ],
    "nl": [
      "Ontdek het nieuwe ponton voor mensen met een beperkte mobiliteit stroomopwaarts van de Flon, met zijn loopbrug, evenals een \"familie\" vispad langs de Rhône. Er zijn 3 visstations langs de route."
    ],
    "es": [
      "Descubra el nuevo pontón para personas con movilidad reducida aguas arriba del Flon con su sendero, así como un sendero de pesca \"familiar\" a lo largo del Ródano. hay 3 estaciones de pesca a lo largo de esta ruta."
    ]
  },
  "rdfs:label": {
    "en": [
      "Family fishing on the Rhône at Yenne"
    ],
    "fr": [
      "Parcours de pêche \"Famille\" sur le Rhône à Yenne"
    ],
    "nl": [
      "Vissen met het gezin\" op de Rhône bij Yenne"
    ]
  },
