  "rdfs:comment": {
    "de": [
      "\"Unsere Produkte werden so einfach und natürlich wie möglich hergestellt, und unsere Pfandgläser halten den Abfall gering.\" Herstellung von Milchprodukten aus hofeigener Milch."
    ],
    "en": [
      "\"Our products are made as simply and naturally as possible, and our returnable glass jars limit waste.\" Dairy products made from milk from the farm."
    ],
    "it": [
      "\"I nostri prodotti sono realizzati nel modo più semplice e naturale possibile e i nostri barattoli di vetro a rendere limitano gli sprechi\" Prodotti caseari realizzati con il latte della fattoria."
    ],
    "fr": [
      "\"Nos produits sont faits le plus simplement et naturellement possible, et nos pots en verre consignés limitent les déchets.\" Fabrication de produits laitiers à partir du lait de la ferme."
    ],
    "nl": [
      "\"Onze producten worden zo eenvoudig en natuurlijk mogelijk gemaakt en onze glazen potten die kunnen worden geretourneerd, beperken de hoeveelheid afval.\" Zuivelproducten gemaakt van melk van de boerderij."
    ],
    "es": [
      "\"Nuestros productos se elaboran de la forma más sencilla y natural posible, y nuestros tarros de vidrio retornables limitan los residuos\" Productos lácteos elaborados con leche de la granja."
    ]
  },
  "rdfs:label": {
    "fr": [
      "GAEC de Barnaudière - Lait délices de Lucie"
    ]
  },
