  "rdfs:comment": {
    "de": [
      "Ständige Ausstellung von Mosaiken und Malerei (Mischtechnik). In ihrem Atelier kreiert Odile Maffone farbenfrohe und fröhliche Objekte. Mosaikkurse jeden Mittwoch-Samstag und auf Anfrage. Anfertigungen auf Bestellung."
    ],
    "en": [
      "Permanent exhibition of mosaic and painting. Odile Maffone makes her own colorful and joyful objects. Mosaic workshops every Wednesday and Saturday and on demand. Made-to-order objects."
    ],
    "it": [
      "Mostra permanente di mosaico e pittura (tecnica mista). Nel suo laboratorio, Odile Maffone crea oggetti colorati e gioiosi. Corsi di mosaico ogni mercoledì-sabato e su richiesta. Creazioni su ordinazione."
    ],
    "fr": [
      "Exposition permanente de mosaïque et de peinture (technique mixte). Dans son atelier, Odile Maffone crée des objets colorés et joyeux. Stages de mosaïque tous les mercredis-samedis et à la demande. Réalisations sur commande."
    ],
    "nl": [
      "Permanente tentoonstelling van mozaïeken en schilderijen (gemengde technieken). In haar atelier maakt Odile Maffone kleurrijke en vrolijke objecten. Mozaïekcursussen elke woensdag-zaterdag en op aanvraag. Creaties op bestelling."
    ],
    "es": [
      "Exposición permanente de mosaico y pintura (técnica mixta). En su taller, Odile Maffone crea objetos coloridos y alegres. Cursos de mosaico todos los miércoles-sábado y a petición. Creaciones por encargo."
    ]
  },
