  "rdfs:comment": {
    "de": [
      "Familienfreundliche Route, um zur Chapelle du Calvaire hinaufzusteigen und das Panorama mit Blick auf den Lac du môle und die Giffre-Berge zu bewundern.\r\n\r\nTopo Schritt für Schritt verfügbar, indem Sie auf das Druckersymbol klicken."
    ],
    "en": [
      "Family itinerary to walking up to the Chapel and admire the panorama that overlooks the Mole Lake and the mountains of Giffre.\r\n\r\nStep-by-step directions are available by clicking on the printer icon."
    ],
    "it": [
      "Un percorso per famiglie fino alla Chapelle du Calvaire per ammirare la vista panoramica sul Lac du Môle e le montagne di Giffre.\r\n\r\nLa guida passo-passo è disponibile cliccando sull'icona della stampante."
    ],
    "fr": [
      "Itinéraire familial pour monter jusqu'à la Chapelle du Calvaire et admirer le panorama qui donne sur le lac du môle et les montagnes du Giffre. \r\n\r\nTopo pas à pas disponible en cliquant sur l'icône imprimante."
    ],
    "es": [
      "Un sendero familiar hasta la Chapelle du Calvaire para admirar la vista panorámica sobre el Lac du Môle y las montañas de Giffre.\r\n\r\nGuía paso a paso disponible haciendo clic en el icono de la impresora."
    ],
    "nl": [
      "Een familiepad naar de Chapelle du Calvaire om het panoramische uitzicht over het Lac du Môle en de bergen van Giffre te bewonderen.\r\n\r\nStapsgewijze gids beschikbaar door op het printerpictogram te klikken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Walking tour - La Chapelle du Calvaire"
    ],
    "fr": [
      "Balade pédestre - La Chapelle du Calvaire"
    ]
  },
