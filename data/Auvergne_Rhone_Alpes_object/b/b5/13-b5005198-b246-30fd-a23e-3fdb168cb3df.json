  "rdfs:comment": {
    "de": [
      "Orientierungstisch im Schloss von Poët-Celard mit freiem Blick auf die Synklinale. Der Tisch ist in gutem Zustand und befindet sich im Hof des Schlosses von Poët-Célard."
    ],
    "en": [
      "Orientation table at the Château de Poët-Celard with a clear view of the syncline. The table, in good condition, is located in the courtyard of the Château de Poët-Célard."
    ],
    "it": [
      "Tavolo di orientamento del Castello di Poët-Celard con vista libera sul sinclinale. Il tavolo, in buone condizioni, si trova nel cortile dello Château de Poët-Célard."
    ],
    "fr": [
      "Table d'orientation au château de Poët-celard avec une vue dégagé sur le synclinal. La table, en bon état, est située dans la cour du Château de Poët-Célard."
    ],
    "nl": [
      "Oriëntatietafel in het Château de Poët-Celard met vrij uitzicht op de syncline. De tafel, in goede staat, bevindt zich op de binnenplaats van het Château de Poët-Célard."
    ],
    "es": [
      "Mesa de orientación en el Château de Poët-Célard con una vista despejada del sinclinal. La mesa, en buen estado, se encuentra en el patio del Château de Poët-Célard."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'orientation château"
    ]
  },
