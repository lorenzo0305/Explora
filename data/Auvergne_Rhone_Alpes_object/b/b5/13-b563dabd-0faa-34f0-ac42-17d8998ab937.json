  "rdfs:comment": {
    "de": [
      "Dieses Museum wurde von einer Gruppe ehemaliger regionaler Widerstandskämpfer gegründet und soll der Nachwelt die Erinnerung daran hinterlassen, wie der Kampf der Widerstandskämpfer gegen den Nationalsozialismus und das Vichy-Regime ausgesehen hat."
    ],
    "en": [
      "Created by a group of former regional resistance fighters, this museum aims to bequeath to posterity the memory of the fight of the resistance fighters against Nazism and the Vichy regime."
    ],
    "it": [
      "Creato da un gruppo di ex combattenti della Resistenza regionale, l'obiettivo di questo museo è quello di lasciare ai posteri la memoria di quella che fu la lotta della Resistenza contro il nazismo e il regime di Vichy."
    ],
    "fr": [
      "Créé par un groupe d’anciens résistants régionaux, ce musée a pour objectif de léguer à la postérité le souvenir de ce qu’a été le combat des résistants face au nazisme et au régime de Vichy."
    ],
    "nl": [
      "Isère is één van de departementen waar tijdens de tweede wereldoorlog het ondergrondse verzet sterk georganiseerd was."
    ],
    "es": [
      "Creado por un grupo de antiguos combatientes de la Resistencia regional, el objetivo de este museo es dejar a la posteridad el recuerdo de lo que fue la lucha de la Resistencia contra el nazismo y el régimen de Vichy."
    ]
  },
  "rdfs:label": {
    "en": [
      "Local Resistance and  Deportation Museum"
    ],
    "fr": [
      "Musée de la Résistance régionale et de la Déportation"
    ],
    "nl": [
      "Museum over het regionale verzet"
    ]
  },
