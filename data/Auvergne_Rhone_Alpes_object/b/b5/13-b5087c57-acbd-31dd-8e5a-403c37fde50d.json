  "rdfs:comment": {
    "de": [
      "Im Weiler Le Désert hat René eine kommentierte Führung durch seine Ausstellung mit handgefertigten Modellen, Fotos und alten Werkzeugen vorbereitet, um Ihnen die landwirtschaftliche Epoche von La Morte näher zu bringen."
    ],
    "en": [
      "René guides you in his exhibition where you will see models, old pictures and tools."
    ],
    "it": [
      "Nella frazione di Le Désert, René ha preparato una visita guidata alla sua mostra di modelli fatti a mano, foto e vecchi attrezzi per farvi scoprire il passato agricolo di La Morte."
    ],
    "fr": [
      "Au hameau du Désert, René vous a préparé une visite commentée de son exposition de maquettes faites à la main, photos et vieux outils afin de vous faire découvrir l'époque agricole de La Morte."
    ],
    "nl": [
      "In het gehucht Le Désert heeft René een rondleiding voorbereid door zijn tentoonstelling van handgemaakte modellen, foto's en oude gereedschappen om je het agrarische verleden van La Morte te laten ontdekken."
    ],
    "es": [
      "En la aldea de Le Désert, René ha preparado una visita guiada a su exposición de maquetas hechas a mano, fotos y herramientas antiguas para ayudarle a descubrir el pasado agrícola de La Morte."
    ]
  },
  "rdfs:label": {
    "en": [
      "Museum of René Mistral - Exhibition"
    ],
    "fr": [
      "Musée de René Mistral - Exposition d'objets anciens"
    ]
  },
