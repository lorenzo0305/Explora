  "rdfs:comment": {
    "de": [
      "Durch Berührungen, Worte und Bilder begleite ich Sie dabei, wieder in Fluss zu kommen und Harmonie in Ihrem Körper und in Ihrem Leben zu finden."
    ],
    "en": [
      "Through touch, words and images, I help you to rediscover fluidity and harmony in your body and in your life."
    ],
    "it": [
      "Attraverso il tocco, le parole e le immagini, vi aiuto a ritrovare la fluidità e l'armonia nel vostro corpo e nella vostra vita."
    ],
    "fr": [
      "Par le toucher, les mots et  l'image, je vous accompagne pour retrouver de la fluidité, de l'harmonie dans votre corps, dans votre vie."
    ],
    "nl": [
      "Door middel van aanraking, woorden en beelden help ik je om vloeibaarheid en harmonie te herontdekken in je lichaam en in je leven."
    ],
    "es": [
      "A través del tacto, las palabras y las imágenes, te ayudo a redescubrir la fluidez y la armonía en tu cuerpo y en tu vida."
    ]
  },
