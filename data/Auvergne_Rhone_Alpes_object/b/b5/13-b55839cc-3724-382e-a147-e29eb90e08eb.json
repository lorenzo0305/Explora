  "rdfs:comment": {
    "de": [
      "Laufen Sie von der mittelalterlichen Stätte Allan aus los, bevor Sie diesen weitläufigen Wald mit seinen vielen kleinen Pfaden erkunden. Ein kleiner Abstecher zum berühmten Croix de Siméon rundet diese schöne blaue Trailrunde ab."
    ],
    "en": [
      "Start your run at the medieval site of Allan and explore this vast forest with its many small trails. A short detour to the famous Croix de Siméon completes this beautiful blue trail loop."
    ],
    "it": [
      "Partite di corsa dal sito medievale di Allan prima di esplorare questa vasta foresta, ricca di piccoli sentieri. Una breve deviazione verso la famosa Croix de Siméon completa questo bellissimo anello blu."
    ],
    "fr": [
      "Partez courir au départ du site médiéval d'Allan avant d'explorer cette vaste forêt qui regorge de petits sentiers. Un petit détour par la fameuse Croix de Siméon pour terminer cette belle boucle de trail bleu."
    ],
    "nl": [
      "Vertrek vanaf de middeleeuwse plaats Allan en verken dit uitgestrekte bos vol kleine paadjes. Een korte omleiding naar het beroemde Croix de Siméon maakt deze mooie blauwe lus compleet."
    ],
    "es": [
      "Salga a correr desde el emplazamiento medieval de Allan antes de explorar este vasto bosque, repleto de pequeños senderos. Un breve desvío a la famosa Croix de Siméon completa este hermoso bucle de senderos azules."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forêt d'Allan et Croix de Siméon"
    ]
  },
