  "rdfs:comment": {
    "de": [
      "Pizzas, Burger, ein Tagesgericht, ein Arbeitermenü, ein Wochenendmenü und ein Ardèche-Menü. Die Gerichte werden hausgemacht und mit lokalen Produkten zubereitet.\r\nAn jedem letzten Wochenende des Monats stehen Froschschenkel auf dem Speiseplan.\r\nRegelmäßig Themenabende."
    ],
    "en": [
      "In the heart of the small village of Cheminas on the heights of the Tournonais, warm and welcoming\r\nPizzas, burgers, the plate of the day, a worker's menu, a week end menu and a Ardèche menu. The dishes are homedate with local products. \r\nEvery last week end of the month, frogs's legs are the highlight. \r\nRegular theme evenings"
    ],
    "it": [
      "Pizze, hamburger, un piatto del giorno, un menu per i lavoratori, un menu per il fine settimana e un menu Ardèche. I piatti sono fatti in casa con prodotti locali\r\nOgni ultimo fine settimana del mese, le cosce di rana saranno protagoniste.\r\nLe serate a tema si tengono regolarmente."
    ],
    "fr": [
      "Pizzas, burgers, un plat du jour, un menu ouvrier, un menu week-end et un menu ardéchois. Les plats sont faits maison avec des produits locaux. \r\nChaque dernier week-end du mois, les cuisses de grenouilles seront à l’honneur.\r\nSoirées à thème régulièrement."
    ],
    "es": [
      "Pizzas, hamburguesas, un plato del día, un menú de trabajadores, un menú de fin de semana y un menú Ardèche. Los platos son caseros con productos locales\r\nTodos los últimos fines de semana del mes se ofrecerán ancas de rana.\r\nSe celebran regularmente veladas temáticas."
    ],
    "nl": [
      "Pizza's, hamburgers, een dagschotel, een arbeidersmenu, een weekendmenu en een Ardèche-menu. Alle gerechten zijn huisgemaakt met lokale producten.\r\nElk laatste weekend van de maand staan er kikkerbilletjes in de schijnwerpers.\r\nEr worden regelmatig thema-avonden georganiseerd."
    ]
  },
  "rdfs:label": {
