  "rdfs:comment": {
    "de": [
      "Eingebettet am Ende des Thermalparks laden Sie die Thermen von Saint-Gervais zu einem unvergesslichen Entspannungsmoment ein! Einen halben Tag lang können Sie sich dank eines Wellness-Parcours in tausendjährigem, natürlich warmem und wohltuendem Thermalwasser entspannen."
    ],
    "en": [
      "Nestled at the heart of the Thermal Park, the Saint-Gervais Thermal Baths invite you to enjoy an unforgettable moment of relaxation! Spend half a day unwinding with a wellness programme in ancient thermal waters that are naturally warm and beneficial."
    ],
    "it": [
      "Immerse nel cuore del Parco Termale, le Terme di Saint-Gervais vi invitano a vivere un momento di relax indimenticabile! Mezza giornata di relax grazie a un percorso benessere in acque termali millenarie, naturalmente calde e benefiche."
    ],
    "fr": [
      "Nichés au fond du Parc Thermal, les Thermes de Saint-Gervais vous invitent à vivre un moment de détente inoubliable ! Une demi-journée de détente grâce à un parcours bien-être dans une eau thermale millénaire, naturellement chaude et bienfaisante."
    ],
    "es": [
      "Enclavado al final del Parque Termal, el Balneario de Saint-Gervais le invita a vivir un momento de relajación inolvidable Medio día de relajación gracias a un curso de bienestar en unas aguas termales milenarias, naturalmente cálidas y beneficiosas."
    ],
    "nl": [
      "De Spa Saint-Gervais, genesteld aan het einde van het Thermaal Park, nodigt u uit voor een onvergetelijk moment van ontspanning! Een halve dag ontspanning dankzij een wellnesscursus in een duizend jaar oud thermaal water, van nature warm en heilzaam."
    ]
  },
