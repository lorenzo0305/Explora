  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Orcival liegt im Herzen des Dorfes, gegenüber der berühmten Basilika Notre-Dame, und empfängt Sie in einem alten, renovierten traditionellen Haus. Hier haben Sie die Gelegenheit, unsere wechselnden Kunstausstellungen zu entdecken!"
    ],
    "en": [
      "Nestled in the heart of the village, facing the famous Notre-Dame Basilica, the Orcival Tourist Office welcomes you in an old renovated traditional house. The opportunity to discover our temporary art exhibitions!"
    ],
    "it": [
      "Situato nel cuore del villaggio, di fronte alla famosa Basilica di Notre-Dame, l'Ufficio del Turismo di Orcival vi accoglie in un'antica casa tradizionale ristrutturata. Un'occasione per scoprire le nostre mostre d'arte temporanee!"
    ],
    "fr": [
      "Niché en plein cœur du village, face à la célèbre Basilique Notre-Dame, l’Office de tourisme d’Orcival vous accueille dans une ancienne maison traditionnelle rénovée. L’occasion de découvrir nos expositions artistiques temporaires !"
    ],
    "nl": [
      "Genesteld in het hart van het dorp, tegenover de beroemde basiliek Notre-Dame, ontvangt het VVV-kantoor van Orcival u in een oud gerenoveerd traditioneel huis. Een gelegenheid om onze tijdelijke kunsttentoonstellingen te ontdekken!"
    ],
    "es": [
      "Enclavada en el corazón del pueblo, frente a la famosa basílica de Notre-Dame, la Oficina de Turismo de Orcival le da la bienvenida en una antigua casa tradicional renovada. Descubra nuestras exposiciones temporales"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Office de tourisme Auvergne VolcanSancy - Bureau d'Orcival"
    ]
  },
