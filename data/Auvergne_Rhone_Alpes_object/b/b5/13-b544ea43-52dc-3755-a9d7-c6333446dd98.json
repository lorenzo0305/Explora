  "rdfs:comment": {
    "de": [
      "der \"Ch?ur Adhémar\" ist ein vierstimmiger gemischter Chor mit 45 bis 50 Sängern, der ein vorwiegend klassisches Repertoire a capella oder mit Begleitung von Orchestern oder Instrumentalisten singt."
    ],
    "en": [
      "\"Ch?ur Adhémar\" is a four-voice mixed choir of 45 to 50 singers, performing a mainly classical repertoire a capella or with orchestral or instrumental accompaniment."
    ],
    "it": [
      "il \"Ch?ur Adhémar\" è un coro misto a quattro voci, composto da 45 a 50 cantanti, che esegue un repertorio prevalentemente classico a cappella o con l'accompagnamento di orchestre o strumentisti."
    ],
    "fr": [
      "\"Chœur Adhémar\" est un chœur mixte à quatre voix , de 45 à 50 choristes, qui aborde un répertoire essentiellement classique à capella ou avec l'accompagnement d'orchestres ou d'instrumentistes."
    ],
    "nl": [
      "\"Ch?ur Adhémar\" is een gemengd vierstemmig koor van 45 tot 50 zangers, dat een voornamelijk klassiek repertoire a capella of met begeleiding van orkesten of instrumentalisten uitvoert."
    ],
    "es": [
      "\"Ch?ur Adhémar\" es un coro mixto a cuatro voces de 45 a 50 cantantes, que interpreta un repertorio principalmente clásico a capella o con acompañamiento de orquesta o instrumentistas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Chœur Adhémar \"Grands chœurs d'opéra\""
    ]
  },
