  "rdfs:comment": {
    "de": [
      "1-stündige Bootsfahrt, begleitet von einem Getränk. Genießen Sie die wechselnden Farben, die Spiegelungen auf dem Wasser und die Kühle des Abends."
    ],
    "en": [
      "1 hour of sailing with a drink, enjoy the changing colors, the reflections on the water and the cool evening air."
    ],
    "it": [
      "navigate per 1 ora con un drink e godetevi i colori che cambiano, i riflessi sull'acqua e l'aria fresca della sera."
    ],
    "fr": [
      "1h de navigation accompagné d'un verre, profitez des changements de couleurs, des reflets sur l'eau et de la fraicheur du soir."
    ],
    "nl": [
      "vaar 1 uur met een drankje en geniet van de veranderende kleuren, de weerspiegelingen op het water en de koele avondlucht."
    ],
    "es": [
      "navegue durante 1 hora con una bebida y disfrute de los colores cambiantes, los reflejos en el agua y el aire fresco del atardecer."
    ]
  },
