  "rdfs:comment": {
    "de": [
      "Die an den Kais gelegene Brasserie la Voile bietet eine schmackhafte Küche. In der Saison können Sie auf der großen Terrasse unweit des Sees die Sonne genießen."
    ],
    "en": [
      "Situated on the quays, the Brasserie la Voile offers you a gourmet menu. In season, you can enjoy the sun on the vast terrace, a few feet away from the lake…"
    ],
    "it": [
      "Situata sui moli, la brasserie la Voile vi propone un menù ghiotto, In alta stagione, approfittate del sole sull'ampia terrazza a pochi passi dal lago."
    ],
    "fr": [
      "Située sur les quais, la brasserie la Voile vous propose une carte gourmande. En saison, vous pourrez profiter du soleil sur sa vaste terrasse à quelques pas du lac..."
    ],
    "es": [
      "Situada en los muelles, la brasserie La Voile ofrece un menú gourmet. En temporada, podrá disfrutar del sol en su amplia terraza, a pocos pasos del lago..."
    ],
    "nl": [
      "De brasserie La Voile, gelegen aan de kades, biedt een gastronomisch menu. In het seizoen kunt u van de zon genieten op het grote terras, op een steenworp afstand van het meer..."
    ]
  },
