  "rdfs:comment": {
    "de": [
      "Für Berufstätige bietet Ihnen O?Lodge einen idealen Ort für Ihre Arbeitstage, Kolloquien, Seminare, Praktika etc. je nach Ihren Bedürfnissen, Ihrem Budget? Individuell anpassbare Dienstleistungen!"
    ],
    "en": [
      "For professionals, O'Lodge offers the ideal venue for your workdays, conferences, seminars, training courses, etc... depending on your needs... your budget...? Customizable services!"
    ],
    "it": [
      "Per i professionisti, O'Lodge offre la sede ideale per le vostre giornate di lavoro, conferenze, seminari, corsi di formazione, ecc. in base alle vostre esigenze e al vostro budget Servizi personalizzabili!"
    ],
    "fr": [
      "Pour vous professionnels, O’Lodge vous propose un lieu idéal pour vos journées de travail, colloques, séminaires, stages etc….. suivant vos besoins…. vos budgets…… Services personnalisables !!"
    ],
    "nl": [
      "Voor professionals biedt O'Lodge de ideale locatie voor uw werkdagen, conferenties, seminars, trainingen, enzovoort, afhankelijk van uw behoeften en budget Services op maat!"
    ],
    "es": [
      "Para los profesionales, O'Lodge ofrece el lugar ideal para sus jornadas de trabajo, conferencias, seminarios, cursos de formación, etc., en función de sus necesidades y presupuesto ¡Servicios personalizables!"
    ]
  },
