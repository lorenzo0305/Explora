  "rdfs:comment": {
    "de": [
      "Von 13:30 bis 15:30 Uhr: Bourrée Auvergnate-Workshop mit Sarah Serec und der Gruppe l'Arlésienne (Reservierung erforderlich).\r\nVon 16 bis 19 Uhr: Trad-Ball. Getränke und kleine Snacks vor Ort."
    ],
    "en": [
      "1:30 pm to 3:30 pm: Auvergne bourrée workshop with Sarah Serec and the group l'Arlésienne (booking required).\r\nFrom 4pm to 7pm: trad dance. Refreshments and snacks on site."
    ],
    "it": [
      "Dalle 13.30 alle 15.30: laboratorio di bourrée d'Auvergne con Sarah Serec e il gruppo l'Arlésienne (su prenotazione).\r\nDalle 16.00 alle 19.00: danza tradizionale. Rinfreschi e spuntini sul posto."
    ],
    "fr": [
      "De 13h30 à 15h30 : stage de bourrée auvergnate avec Sarah Serec et le groupe l'Arlésienne sur réservation.\r\nDe 16h à 19h : bal trad. Buvette et petite restauration sur place."
    ],
    "nl": [
      "Van 13u30 tot 15u30: workshop Auvergne bourrée met Sarah Serec en de groep l'Arlésienne (reserveren verplicht).\r\nVan 16u tot 19u: traditionele dans. Versnaperingen en hapjes ter plaatse."
    ],
    "es": [
      "De 13.30 a 15.30 h: taller de bourrée de Auvernia con Sarah Serec y el grupo l'Arlésienne (reserva obligatoria).\r\nDe 16:00 a 19:00 h: baile tradicional. Refrescos y tentempiés in situ."
    ]
  },
