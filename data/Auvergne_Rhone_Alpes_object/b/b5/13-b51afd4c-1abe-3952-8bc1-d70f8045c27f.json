  "rdfs:comment": {
    "de": [
      "In einem hübschen, sehr typischen und angenehmen Dorf, das als eines der schönsten Dörfer Frankreichs eingestuft wurde, empfängt Sie Chef Dominique DUBRAY in einem 3***-Hotel mit 8 Zimmern, einem Restaurant mit 35 Plätzen, Bibliothek und Terrasse in Blesle."
    ],
    "en": [
      "In a pretty village, very typical and pleasant, classified as one of the most Beautiful Villages in France, Chef Dominique DUBRAY welcomes you to a 3*** hotel with 8 rooms, a 35-seat restaurant, library and terrace located in Blesle."
    ],
    "it": [
      "In un grazioso villaggio, molto tipico e piacevole, classificato come uno dei Borghi più Belli di Francia, lo chef Dominique DUBRAY vi dà il benvenuto in un hotel 3*** con 8 camere, un ristorante da 35 posti, biblioteca e terrazza situato a Blesle."
    ],
    "fr": [
      "Dans un joli village, très typique et agréable, classé un des plus Beaux Villages de France, le Chef Dominique DUBRAY vous accueille dans un hôtel 3***  de 8 chambres, un restaurant de 35 places, bibliothèque et terrasse situé à Blesle."
    ],
    "nl": [
      "In een mooi dorp, zeer typisch en aangenaam, geklasseerd als een van de Mooiste Dorpen van Frankrijk, heet Chef Dominique DUBRAY u welkom in een 3*** hotel met 8 kamers, een restaurant met 35 zitplaatsen, bibliotheek en terras gelegen in Blesle."
    ],
    "es": [
      "En un bonito pueblo, muy típico y agradable, clasificado como uno de los Pueblos más Bonitos de Francia, el Chef Dominique DUBRAY le da la bienvenida a un hotel de 3*** con 8 habitaciones, un restaurante de 35 plazas, biblioteca y terraza situado en Blesle."
    ]
  },
