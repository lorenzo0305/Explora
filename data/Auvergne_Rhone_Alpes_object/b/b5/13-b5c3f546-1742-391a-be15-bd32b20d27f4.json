  "rdfs:comment": {
    "de": [
      "Finesse Art: eine Sammlung von Fotografien für Sie, ein Hingucker für Ihre Wände!\r\nJacquie fotografiert seit 2008 die wunderschönen Französischen Alpen und hat Finesse Art geschaffen, um die Freude an ihrer Arbeit an die Wände Ihres Hauses zu bringen."
    ],
    "en": [
      "Finesse Art: a collection of photographic artwork for your walls!\r\nJacquie has been photographing the beautiful French Alps since 2008 and she created Finesse Art to bring the joy of her work to your home."
    ],
    "it": [
      "Finesse Art: una collezione di fotografie per voi, un'opera d'arte per le vostre pareti!\r\nJacquie fotografa le splendide Alpi francesi dal 2008 e ha creato Finesse Art per portare la gioia del suo lavoro sulle pareti di casa vostra."
    ],
    "fr": [
      "Finesse Art : une collection des photographies pour vous, un coup de cœur pour vos murs !\r\nJacquie photographie les magnifiques Alpes Françaises depuis 2008 et elle a créé Finesse Art pour apporter la joie de son travail aux murs de votre maison."
    ],
    "es": [
      "Finesse Art: una colección de fotografías para usted, ¡una obra maestra para sus paredes!\r\nJacquie fotografía los bellos Alpes franceses desde 2008 y ha creado Finesse Art para llevar la alegría de su trabajo a las paredes de su casa."
    ],
    "nl": [
      "Finesse Art: een verzameling foto's voor jou, een pronkstuk voor je muren!\r\nJacquie fotografeert sinds 2008 de prachtige Franse Alpen en heeft Finesse Art gecreëerd om het plezier van haar werk ook bij jou thuis aan de muur te hangen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Finesse Art Photos"
    ],
    "fr": [
      "Finesse Art Photos"
    ]
  },
