  "rdfs:comment": {
    "de": [
      "Das Restaurant In Secreto lädt Sie zu einem kulinarischen Erlebnis im Rhythmus der Jahreszeiten ein. Die Küchenchefin Céline Bénichou bietet eine neu interpretierte regionale Küche, die mit den lokalen Erzeugern und dem Gemüsegarten des Weinguts in Verbindung steht."
    ],
    "en": [
      "The In Secreto restaurant invites you to enjoy a culinary experience in tune with the seasons. Chef Céline Bénichou proposes a revisited regional cuisine, in collaboration with local producers and the estate's vegetable garden."
    ],
    "it": [
      "Il ristorante In Secreto vi invita a vivere un'esperienza culinaria in sintonia con le stagioni. Lo chef, Céline Bénichou, propone una cucina fresca e locale, collaborando con i produttori locali e con l'orto della tenuta."
    ],
    "fr": [
      "Le restaurant In Secreto vous invite à une expérience culinaire au rythme des saisons. La cheffe Céline Bénichou propose une cuisine de terroir revisitée, en lien avec les producteurs locaux et le potager du domaine."
    ],
    "nl": [
      "Het restaurant In Secreto nodigt je uit voor een culinaire ervaring in harmonie met de seizoenen. De chef-kok, Céline Bénichou, biedt een frisse kijk op de lokale keuken en werkt met lokale producenten en de moestuin van het landgoed."
    ],
    "es": [
      "El restaurante In Secreto le invita a disfrutar de una experiencia culinaria en sintonía con las estaciones. La chef, Céline Bénichou, propone una reinterpretación de la cocina local, trabajando con los productores locales y el huerto de la finca."
    ]
  },
  "rdfs:label": {
    "fr": [
      "In Secreto"
    ]
  },
