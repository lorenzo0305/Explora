  "rdfs:comment": {
    "de": [
      "Skulpturkreationen aus Erde und Stein (Alabaster, Kalk). Körper, menschliche\r\nKöpfe und abstrakte Figuren präsentieren die Vielfalt meiner\r\nKreationen."
    ],
    "en": [
      "Working under the name of Irma Janssen, she devotes herself to her passion here in the Ardèche - that of shaping earth and stone."
    ],
    "it": [
      "Creo sculture in argilla e pietra (alabastro, calcare). Corpi, teste umane e sculture più astratte rappresentano la maggior parte delle mie creazioni."
    ],
    "fr": [
      "Créations de sculptures en terre et en pierre (albâtre, calcaire). Corps, têtes humaines et sculpture plus abstraites représentent la plupart de mes créations."
    ],
    "es": [
      "Creo esculturas en arcilla y piedra (alabastro, piedra caliza). Cuerpos, cabezas humanas y esculturas más abstractas representan la mayoría de mis creaciones."
    ],
    "nl": [
      "Creaties van sculpturen van klei en steen (albast, kalksteen). Lichamen,\r\nmenselijke hoofden en meer abstracte sculpturen vertegenwoordigen\r\nhet grootste deel van mijn creaties."
    ]
  },
