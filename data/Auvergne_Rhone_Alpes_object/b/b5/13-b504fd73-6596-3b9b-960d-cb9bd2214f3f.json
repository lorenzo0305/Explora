  "rdfs:comment": {
    "de": [
      "Das Café de la Fora bietet Ihnen warme oder kalte Getränke (Bier, lokale Weine und Softdrinks...) sowie einen kleinen Imbiss: einzigartige Gerichte, gemischte Salate...aus Produkten der Region Bugey.\r\nAuswahl an 18 Eissorten auf der schattigen Terrasse ."
    ],
    "en": [
      "The Café de la Fora serves hot and cold drinks (local beers, wines and soft drinks...) as well as snacks: unique dishes, mixed salads...made with Bugey products.\r\nChoice of 18 flavors of ice cream on shaded terrace."
    ],
    "it": [
      "Il Café de la Fora serve bevande calde e fredde (birre locali, vini e bibite, ecc.) e una serie di snack: piatti unici, insalate miste, ecc. a base di prodotti locali di Bugey.\r\nUna scelta di 18 gusti di gelato sulla terrazza ombreggiata."
    ],
    "fr": [
      "Le Café de la Fora vous propose des boissons chaudes ou fraiches (bières, vins et sodas locaux...) ainsi qu'une petite restauration : des plats uniques, salades composées...de produits du Bugey.\r\nChoix de 18 parfums de glaces sur terrasse ombragée ."
    ],
    "nl": [
      "Het Café de la Fora serveert warme en koude dranken (lokale bieren, wijnen en frisdranken, enz.) en een assortiment snacks: unieke gerechten, gemengde salades, enz. gemaakt van lokale Bugey-producten.\r\nKeuze uit 18 smaken ijs op het schaduwrijke terras."
    ],
    "es": [
      "El Café de la Fora sirve bebidas frías y calientes (cervezas locales, vinos y refrescos, etc.), así como una gama de aperitivos: platos únicos, ensaladas mixtas, etc. elaborados con productos locales de Bugey.\r\nUna selección de 18 sabores de helados en la terraza a la sombra."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Café la Fora"
    ]
  },
