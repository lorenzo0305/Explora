  "rdfs:comment": {
    "de": [
      "Haut?Saveurs?de?Verthier in Doussard ist eine Feinschmeckeradresse, wo Regionalität und Kunsthandwerk miteinander verschmelzen: ein Feinkostladen mit regionalen Produkten, eine handwerkliche Schokoladenfabrik und ein Snack-Laden."
    ],
    "en": [
      "Located in Doussard, Haut Saveurs de Verthier is a gourmet destination where local produce and craftsmanship come together: a fine food shop featuring regional products, an artisanal chocolate shop, and a café‑snack area."
    ],
    "it": [
      "Situato a Doussard, Haut?Saveurs?de?Verthier è un indirizzo gastronomico dove si incontrano prodotti locali e artigianato: una gastronomia di prodotti regionali, una cioccolateria tradizionale e uno snack bar."
    ],
    "fr": [
      "Situé à Doussard, Haut Saveurs de Verthier est une adresse gourmande où terroir et artisanat se mêlent : épicerie fine de produits régionaux, chocolaterie artisanale et salon‑snack."
    ],
    "es": [
      "Situado en Doussard, Haut?Saveurs?de?Verthier es una dirección gastronómica donde se dan cita los productos locales y la artesanía: una charcutería de productos regionales, una chocolatería tradicional y un snack bar."
    ],
    "nl": [
      "Haut Saveurs de Verthier, gelegen in Doussard, is een adres voor fijnproevers waar streekproducten en vakmanschap samenkomen: een delicatessenzaak met streekproducten, een traditionele chocolaterie en een snackbar."
    ]
  },
