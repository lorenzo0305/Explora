  "rdfs:comment": {
    "de": [
      "Wagen Sie ein Höhlenabenteuer im Vercors: Höhlenforschung für alle!\r\nAls Spezialist für Höhlenforschung organisiert Antre 2 Mondes für Sie die unterirdische Erkundung nach Maß und in kleinen Gruppen (4 bis max. 8 Personen). Anstellung eines privaten Führers möglich."
    ],
    "en": [
      "Dare to try a cave adventure in Vercors: caving for all!\r\nSpecialists in caving, Antre 2 Mondes organises tailor-made underground explorations in small groups (4 to 8 people max). You can hire a private guide."
    ],
    "it": [
      "Osate un'avventura in grotta nel Vercors: la speleologia per tutti!\r\nLa speleologia è un'attività divertente, educativa e sportiva, accessibile a tutti."
    ],
    "fr": [
      "Osez l'aventure grottesque en Vercors : la spéléo pour tous !\r\nLa spéléologie : une activité ludique, éducative et sportive, accessible à toutes et à tous."
    ],
    "nl": [
      "Waag je aan een grottenavontuur in de Vercors: speleologie voor iedereen!\r\nSpeleologie is een leuke, leerzame en sportieve activiteit die voor iedereen toegankelijk is."
    ],
    "es": [
      "Atrévase con una aventura en las cuevas del Vercors: ¡espeleología para todos!\r\nLa espeleología es una actividad lúdica, educativa, deportiva y accesible a todos."
    ]
  },
  "rdfs:label": {
    "de": [
      "Antre 2 Mondes, Höhlenforschung & Höhlenabenteuer"
    ],
    "en": [
      "Antre 2 Mondes, caving & cave adventures"
    ],
    "fr": [
      "Antre 2 Mondes, Spéléologie Vercors"
    ]
  },
