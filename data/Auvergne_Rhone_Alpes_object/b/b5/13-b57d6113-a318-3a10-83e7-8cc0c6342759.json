  "rdfs:comment": {
    "de": [
      "Power Soccer ist ein 2200 m² großer Fußballkomplex, der die Leidenschaft für Futsal und Geselligkeit fördert. Wir verbinden Spaß mit drei Kunstrasenplätzen, einem Clubhaus und professionellem Service."
    ],
    "en": [
      "Power Soccer is a 1,800m² soccer complex promoting the passion of futsal and conviviality. Combining fun with three synthetic pitches, a clubhouse and corporate offers."
    ],
    "it": [
      "Il Power Soccer è un complesso calcistico di 2200 m² che promuove la passione per il futsal e un'atmosfera amichevole. Uniamo il divertimento a tre campi sintetici, una clubhouse e servizi professionali."
    ],
    "fr": [
      "Power Soccer est un complexe footballistique de 2200 m² prônant la passion du futsal et la convivialité. Nous associons le plaisir grâce à trois terrains synthétiques, un club-house, au professionnalisme de nos services."
    ],
    "nl": [
      "Power Soccer is een voetbalcomplex van 1.800 m² dat de passie voor futsal en een gezellige sfeer bevordert. Met drie synthetische velden, een clubhuis en een reeks bedrijfsaanbiedingen draait het allemaal om plezier maken."
    ],
    "es": [
      "Power Soccer es un complejo futbolístico de 2200 m² que fomenta la pasión por el fútbol sala y un ambiente agradable. Combinamos diversión con tres campos sintéticos, una casa club y servicios profesionales."
    ]
  },
  "rdfs:label": {
