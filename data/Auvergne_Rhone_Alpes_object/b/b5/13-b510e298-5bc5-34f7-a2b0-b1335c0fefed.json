  "rdfs:comment": {
    "de": [
      "Als leidenschaftliche Imker wandern wir mit unseren Bienenstöcken durch die Region und manchmal auch darüber hinaus, um je nach Blütezeit spezifische und qualitativ hochwertige Honige zu produzieren."
    ],
    "en": [
      "As passionate beekeepers, we migrate our hives throughout the region and sometimes beyond, to produce specific, high-quality honeys according to the flowering season."
    ],
    "it": [
      "Come apicoltori appassionati, facciamo migrare i nostri alveari in tutta la regione e talvolta anche oltre, per produrre mieli specifici e di alta qualità a seconda della stagione di fioritura."
    ],
    "fr": [
      "Apiculteurs passionnés, nous transhumons nos ruches dans la région et parfois au delà afin de produire des miels spécifiques et de qualité au grès des floraisons."
    ],
    "es": [
      "Como apicultores apasionados, hacemos migrar nuestras colmenas por toda la región y a veces más lejos para producir mieles específicas de alta calidad según la estación de floración."
    ],
    "nl": [
      "Als gepassioneerde imkers verplaatsen we onze bijenkorven naar andere delen van de regio en soms verder weg om specifieke kwaliteitshoning te produceren wanneer deze in bloei staat."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Gaec Les Ruchers de la Valdaine"
    ]
  },
