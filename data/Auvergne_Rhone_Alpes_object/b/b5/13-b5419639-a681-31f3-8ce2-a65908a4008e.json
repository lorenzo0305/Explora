  "rdfs:comment": {
    "de": [
      "Der Sessellift Lune Bleue ist im Winter und im Sommer für Fußgänger zugänglich.\r\nIm Sommer können Mountainbiker den Aufstieg genießen, da es Sitzgelegenheiten gibt, die für ihre Mountainbikes und E-Bikes eingerichtet wurden."
    ],
    "en": [
      "In winter, chairlift accessible to pedestrians, snowshoes, alternative gliding devices.\r\nDuring Summer, chairlift accessible to pedestrians, mountain bikers (e-bikes allowed) and all-terrain chair (Cimgo)."
    ],
    "it": [
      "La seggiovia Lune Bleue è accessibile ai pedoni in inverno e in estate.\r\nIn estate, gli appassionati di mountain bike possono godersi la salita grazie ai posti attrezzati per ospitare le loro mountain bike e VAE."
    ],
    "fr": [
      "Le télésiège Lune Bleue est accessible aux piétons en hiver et en été.\r\nEn été les vététistes pourront profiter de la montée grâce aux sièges aménagés pour accueillir leurs VTT et VAE."
    ],
    "es": [
      "El telesilla Lune Bleue es accesible a los peatones en invierno y en verano.\r\nEn verano, los ciclistas de montaña pueden disfrutar de la subida gracias a los asientos habilitados para acomodar sus bicicletas de montaña y VAE."
    ],
    "nl": [
      "De stoeltjeslift Lune Bleue is in de winter en in de zomer toegankelijk voor voetgangers.\r\nIn de zomer kunnen mountainbikers genieten van de beklimming dankzij de zitplaatsen die zijn ingericht voor hun mountainbikes en VAE."
    ]
  },
  "rdfs:label": {
    "en": [
      "Chairlift Lune Bleue"
    ],
    "fr": [
      "Télésiège de la Lune Bleue"
    ],
    "nl": [
      "Stoeltjeslift Lune Bleue"
    ]
  },
