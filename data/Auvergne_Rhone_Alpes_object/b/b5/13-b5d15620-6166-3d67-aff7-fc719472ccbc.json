  "rdfs:comment": {
    "de": [
      "Kletterrouten in der wunderschönen Gegend von L'Esseillon, an den Felsklippen über den Forts Charles Félix und Victor Emmanuel. Naturlandschaften inmitten von Wäldern mit Blick auf die Berge."
    ],
    "en": [
      "Climbing routes in the magnificent Esseillon area, on the rocky cliffs overlooking the Charles Félix and Victor Emmanuel forts. Natural forest landscapes with mountain views."
    ],
    "it": [
      "Arrampicata vie del magnifico dell'Esseillon."
    ],
    "fr": [
      "Voies d'escalade dans le magnifique site de l'Esseillon, sur la falaise rocheuse qui domine les forts Charles Félix et Victor Emmanuel. Paysages naturels au sein de forêts avec vue sur les montagnes."
    ],
    "es": [
      "Vías de escalada en la magnífica zona de Esseillon, en los acantilados rocosos que dominan los fuertes Charles Félix y Victor Emmanuel. Paisajes naturales rodeados de bosques con vistas a las montañas."
    ],
    "nl": [
      "Klimroutes in de prachtige omgeving van Esseillon, op de rotsachtige kliffen met uitzicht op de forten Charles Félix en Victor Emmanuel. Natuurlijke landschappen omringd door bossen met uitzicht op de bergen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Climbing way Les Côtes Blanches"
    ],
    "it": [
      "via di arrampicata Les Côtes Blanches"
    ],
    "fr": [
      "Voie d'escalade des Côtes Blanches"
    ],
    "nl": [
      "Klimpad Les Côtes Blanches"
    ]
  },
