  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fb6e5a1a-3cb7-374e-abc7-8bed29d1b91f",
      "dc:description": {
        "de": [
          "Club für Radfahrer. Straße und Mountainbike. Mitglied der FFC (Fédération Française de cyclisme) und der FSGT (Fédération Sportive Gymnique les Travailleurs), also Wettkampfsport.\n\nSportliche Wettkämpfe im Straßenradsport, Mountainbiking und Sandbahnrennen."
        ],
        "en": [
          "Cycling club. Road and mountain biking. Affiliated with FFC (Fédération Française de cyclisme) and FSGT (Fédération Sportive Gymnique les Travailleurs), so competitive.\n\nRoad, mountain bike and sand racing competitions."
        ],
        "it": [
          "Club ciclistico. Strada e mountain bike. Affiliato alla FFC (Fédération Française de cyclisme) e alla FSGT (Fédération Sportive Gymnique les Travailleurs), quindi competitivo.\n\nGare su strada, mountain bike e sabbia."
        ],
        "fr": [
          "Club cycliste. Route et VTT. Affiliée FFC (Fédération Française de cyclisme) et FSGT (Fédération Sportive Gymnique les Travailleurs), donc de compétition.\n\nCompétition sportives cycliste sur route, VTT et courses sur sable."
        ],
        "nl": [
          "Wielerclub. Fietsen op de weg en mountainbiken. Aangesloten bij de FFC (Fédération Française de Cyclisme) en FSGT (Fédération Sportive Gymnique les Travailleurs), dus competitief.\n\nWeg-, mountainbike- en zandraces."
        ],
        "es": [
          "Club de ciclismo. Ciclismo de carretera y de montaña. Afiliado a la FFC (Fédération Française de cyclisme) y a la FSGT (Fédération Sportive Gymnique les Travailleurs), por lo que es competitivo.\n\nCarreras en carretera, BTT y arena."
        ]
      },
