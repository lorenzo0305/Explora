  "rdfs:comment": {
    "de": [
      "Das Bauhaus ist ein traditionelles Restaurant im Herzen des Skiortes Flaine. Es feiert die Lebenskunst in den Bergen und bietet Ihnen vom Mittag- bis zum Abendessen durchgehende Verpflegung in einer entspannten, ja sogar festlichen Atmosphäre..."
    ],
    "en": [
      "A traditional restaurant in the heart of the Flaine resort, the Bauhaus celebrates the art of mountain living, offering continuous dining from lunch to dinner in a relaxed, even festive atmosphere..."
    ],
    "it": [
      "Ristorante tradizionale nel cuore della località di Flaine, il Bauhaus celebra l'arte di vivere in montagna, offrendo una ristorazione continua dal pranzo alla cena in un'atmosfera rilassata e persino festosa..."
    ],
    "fr": [
      "Restaurant traditionnel au coeur de la station de Flaine, le Bauhaus célèbre l’art de vivre à la montagne, en vous proposant une restauration continue du déjeuner au dîner dans une ambiance détendue, voire festive..."
    ],
    "es": [
      "Restaurante tradicional en el corazón de la estación de Flaine, el Bauhaus celebra el arte de vivir en la montaña, ofreciendo una cena continua desde el almuerzo hasta la cena en un ambiente relajado, incluso festivo..."
    ],
    "nl": [
      "Het Bauhaus restaurant in het hart van het Flaine resort, viert de kunst van het leven in de bergen en biedt een doorlopend diner van lunch tot diner in een ontspannen, zelfs feestelijke sfeer..."
    ]
  },
