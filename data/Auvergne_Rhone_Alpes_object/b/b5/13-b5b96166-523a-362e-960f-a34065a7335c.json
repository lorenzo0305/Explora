  "rdfs:comment": {
    "de": [
      "Die Brasserie de la Pleine Lune stellt seit 2011 handwerklich gebraute und biologische Biere her. Biere mit ausgesuchtem und kontrolliertem Geschmack! Kommen Sie in unsere Bar/Boutique und probieren oder kaufen Sie das Bier, das zu Ihrem Gaumen passt!"
    ],
    "en": [
      "Brasserie de la Pleine Lune has been producing handcrafted, organic beers since 2011. Beers with refined, mastered tastes! Come and taste or buy the beer that suits your palate in our bar/shop!"
    ],
    "it": [
      "Il birrificio Pleine Lune produce birre artigianali e biologiche dal 2011. Birre dai gusti raffinati e magistrali! Venite a degustare o ad acquistare la birra più adatta al vostro palato nel nostro bar/negozio!"
    ],
    "fr": [
      "La brasserie de la Pleine Lune produit des bières artisanales et bio depuis 2011. Bières aux goûts recherchés et maîtrisés ! Venez déguster ou acheter la bière qui s'accorde à votre palais dans notre bar/boutique !"
    ],
    "es": [
      "La cervecería Pleine Lune produce cervezas artesanales y ecológicas desde 2011. ¡Cervezas con gustos refinados y dominados! Venga a degustar o a comprar la cerveza que se adapte a su paladar en nuestro bar/tienda"
    ],
    "nl": [
      "De brouwerij Pleine Lune produceert sinds 2011 ambachtelijke en biologische bieren. Bieren met smaken die zijn onderzocht en beheerst! Kom proeven of koop het bier dat bij je smaak past in onze bar/winkel!"
    ]
  },
  "rdfs:label": {
