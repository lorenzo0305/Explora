  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Grandioz, das Restaurant im Pasino Grand, in dem Raffinesse und Gastlichkeit aufeinandertreffen. Großzügige Buffets, schmackhafte Gerichte und ein eleganter Rahmen erwarten Sie für einen einzigartigen gastronomischen Moment, nur wenige Minuten von Lyon entfernt."
    ],
    "en": [
      "Discover Le Grandioz, the Pasino Grand’s restaurant, where refinement meets conviviality. Generous buffets, delicious dishes, and an elegant setting await you for a unique dining experience just minutes from Lyon."
    ],
    "it": [
      "Scoprite Le Grandioz, il ristorante del Pasino Grand, dove la raffinatezza incontra la convivialità. Generosi buffet, piatti gustosi e un ambiente elegante vi aspettano per un'esperienza gastronomica unica a pochi minuti da Lione."
    ],
    "fr": [
      "Découvrez Le Grandioz, le restaurant du Pasino Grand, où raffinement et convivialité se rencontrent. Buffets généreux, plats savoureux et un cadre élégant vous attendent pour un moment gastronomique unique à seulement quelques minutes de Lyon."
    ],
    "nl": [
      "Ontdek Le Grandioz, het restaurant van Pasino Grand, waar verfijning en gezelligheid elkaar ontmoeten. Royale buffetten, smakelijke gerechten en een elegante omgeving wachten op je voor een unieke gastronomische ervaring op slechts een paar minuten van Lyon."
    ],
    "es": [
      "Descubra Le Grandioz, el restaurante del Pasino Grand, donde el refinamiento se une a la convivencia. Buffets generosos, platos sabrosos y un marco elegante le esperan para vivir una experiencia gastronómica única a pocos minutos de Lyon."
    ]
  },
