          "additionalInformation": {
            "de": [
              "Behandlungen von Montag bis Sonntag nach Terminvereinbarung.\r\nSprechstunde ohne RDV von 12:00 bis 13:00 Uhr, außer an Wochenenden.\r\nSekretariat montags bis freitags von 9:00 bis 16:00 Uhr geöffnet."
            ],
            "en": [
              "Treatments from Monday to Sunday, by appointment.\r\nOpen from 12:00 to 13:00, except on weekends.\r\nSecretariat open from Monday to Friday from 9am to 4pm."
            ],
            "it": [
              "Trattamento dal lunedì alla domenica, su appuntamento.\r\nServizio walk-in dalle 12.00 alle 13.00, tranne nei fine settimana.\r\nSegreteria aperta dal lunedì al venerdì dalle 9.00 alle 16.00."
            ],
            "fr": [
              "Soins du lundi au dimanche, sur rendez-vous.\r\nPermanence sans RDV de 12h à 13h, sauf les week-ends.\r\nSecrétariat ouvert du lundi au vendredi de 9h à 16h."
            ],
            "es": [
              "Tratamiento de lunes a domingo, con cita previa.\r\nServicio sin cita previa de 12 a 13 horas, excepto los fines de semana.\r\nSecretaría abierta de lunes a viernes de 9 a 16 horas."
            ],
            "nl": [
              "Behandeling van maandag tot zondag, op afspraak.\r\nInloopdienst van 12.00 tot 13.00 uur, behalve in het weekend.\r\nSecretariaat geopend van maandag tot en met vrijdag van 9.00 tot 16.00 uur."
            ]
          },
