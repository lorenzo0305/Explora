  "rdfs:comment": {
    "de": [
      "Das Hôtel du Midi liegt im Grésivaudan-Tal, 10 Minuten vom Zentrum Grenobles entfernt, in der Nähe der Skigebiete Les 7 Laux und Chamrousse. Es ist der ideale Ort für Geschäftsreisende auf der Durchreise und für den Freizeittourismus."
    ],
    "en": [
      "Hôtel du Midi is located in the Grésivaudan Valley, 10 minutes from the centre of Grenoble and close to the Chamrousse and Les 7 Laux ski resorts. It is the ideal place for visiting professionals and leisure tourists."
    ],
    "it": [
      "Nella valle del Grésivaudan, un'antica palazzo dall'inizio del secolo, a 10 minuti dal centro di Grenoble, vicino alle stazioni sciistiche di Chamrousse, e Sept Laux, il nostro hotel Le offre un posto ideale per il turismo ricreativo e d'affari."
    ],
    "fr": [
      "Situé dans la Vallée du Grésivaudan à 10 minutes du centre de Grenoble, proche des stations de ski des 7 Laux et de Chamrousse l'Hôtel du Midi est le lieu idéal pour les professionnels de passage et le tourisme de loisirs."
    ],
    "nl": [
      "Hôtel du Midi ligt in de Grésivaudan-vallei, op 10 minuten van het centrum van Grenoble en dicht bij de skigebieden Chamrousse en 7 Laux. Het is de ideale plek voor bezoekende professionals en vakantiegangers."
    ],
    "es": [
      "En en Valle del Grésivaudan, una antigua residencia de Maestro de los principios de este siglo, a  minutos del centro de Grenoble, de la estaciónes de esquí de Chamrousse y los 7 Laux, nuestro hotel le ofrece una situación ideal para turismo de negocios y de ocios."
    ]
  },
