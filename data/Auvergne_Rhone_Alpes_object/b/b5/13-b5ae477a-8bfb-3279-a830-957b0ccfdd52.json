  "rdfs:comment": {
    "de": [
      "Name der Einwohner: Saint-Agathois. In einer ländlichen Umgebung breitet Ste-Agathe-en-Donzy seine wenigen Häuser rund um die Kirche aus. Viele Besucher entdecken die lokale Flora auf dem botanischen Wieselpfad und genießen die Panoramen."
    ],
    "en": [
      "Inhabitants: the Saint-Agathois. In a rural setting, Ste-Agathe-en-Donzy spreads out its few houses around the church. Many visitors discover the local flora on the Weasel Botanical Trail and enjoy the panoramic views."
    ],
    "it": [
      "Abitanti: i Saint-Agathois. In un ambiente rurale, Ste-Agathe-en-Donzy distribuisce le sue poche case intorno alla chiesa. Molti visitatori vengono a scoprire la flora locale sul Sentiero botanico della donnola e a godersi le viste panoramiche."
    ],
    "fr": [
      "Nom des habitants : les Saint-Agathois. Dans un cadre champêtre, Ste-Agathe-en-Donzy étale ses quelques maisons autour de l'église. Les visiteurs sont nombreux à découvrir la flore locale du sentier botanique de la belette et à profiter des panoramas."
    ],
    "nl": [
      "Inwoners: de Saint-Agathois. In een landelijke omgeving spreidt Ste-Agathe-en-Donzy zijn weinige huizen uit rond de kerk. Veel bezoekers komen de plaatselijke flora ontdekken op het Weasel Botanical Trail en genieten van het panoramische uitzicht."
    ],
    "es": [
      "Habitantes: los Saint-Agathois. En un entorno rural, Ste-Agathe-en-Donzy extiende sus pocas casas alrededor de la iglesia. Muchos visitantes acuden para descubrir la flora local en el sendero botánico de la Comadreja y disfrutar de las vistas panorámicas."
    ]
  },
