  "rdfs:comment": {
    "de": [
      "Eine warme Atmosphäre, kleine Gerichte, die mit Sorgfalt zwischen Tradition und Originalität zusammengestellt werden, Black Side Café wird sich bemühen, Sie wie zu Hause zu empfangen."
    ],
    "en": [
      "With its warm atmosphere and carefully prepared dishes combining tradition and originality, Black Side Café will make you feel right at home."
    ],
    "it": [
      "Con la sua calda atmosfera e i piatti preparati con cura che combinano tradizione e originalità, il Black Side Café vi farà sentire come a casa vostra."
    ],
    "fr": [
      "Une ambiance chaleureuse, des petits plats concoctés avec soin entre tradition et originalité, Black Side Café aura coeur de vous accueillir comme à la maison."
    ],
    "nl": [
      "Met zijn warme sfeer en zorgvuldig bereide gerechten die traditie en originaliteit combineren, zal Black Side Café je meteen thuis laten voelen."
    ],
    "es": [
      "Con su ambiente acogedor y sus platos cuidadosamente elaborados que combinan tradición y originalidad, Black Side Café le hará sentirse como en casa."
    ]
  },
