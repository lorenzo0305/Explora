  "rdfs:comment": {
    "de": [
      "Ich bin Caroline, eine ganzheitliche Therapeutin. Die Kunst, sich um den Menschen in seiner Gesamtheit zu kümmern, d. h. Körper, Emotionen, Geist und Seele. Ich beschränke mich nicht darauf, Ihre Symptome des Übels zu lindern, sondern suche nach den wirklichen Ursachen der Störung."
    ],
    "en": [
      "I'm Caroline, a holistic therapist. The art of caring for the whole human being: body, emotions, mind and soul. I don't limit myself to alleviating your symptoms, but look for the real causes of the disorder."
    ],
    "it": [
      "Sono Caroline, una terapista olistica. L'arte di prendersi cura dell'intero essere umano: corpo, emozioni, mente e anima. Non mi limito ad alleviare i sintomi, ma cerco le vere cause del problema."
    ],
    "fr": [
      "Je suis Caroline, thérapeute holistique. L'art de prendre soin de l'être humain dans sa globalité, à savoir le corps, les émotions, le mental et l'âme. Je ne me limite pas à soulager vos symptômes du mal mais à chercher les réelles causes du trouble."
    ],
    "es": [
      "Soy Caroline, terapeuta holística. El arte de cuidar del ser humano en su totalidad: cuerpo, emociones, mente y alma. No me limito a aliviar tus síntomas, sino que busco las verdaderas causas del problema."
    ],
    "nl": [
      "Ik ben Caroline, een holistisch therapeut. De kunst van het zorgen voor de hele mens: lichaam, emoties, geest en ziel. Ik beperk me niet tot het verlichten van je symptomen, maar ga op zoek naar de echte oorzaken van het probleem."
    ]
  },
  "rdfs:label": {
