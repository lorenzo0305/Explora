  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/71a040a4-1426-3b7c-823c-f9a66dc25d9d",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck und Konditoreiwaren\n\nTage der Öffnung:\n\nDienstag bis Samstag von 5:30 bis 13:30 Uhr und von 15:30 bis 19:30 Uhr.\nSonntags von 7:00 bis 13:00 Uhr.\n\nMontags geschlossen\n \n Abholung :\n\nZum Mitnehmen während der Ladenöffnungszeiten\n\nBestellungen:\n\nTelefonische Bestellungen unter 03 21 48 31 55 möglich\n\n "
        ],
        "en": [
          "Information :\n\nProducts: breads, viennoiseries and pastries\n\nOpening days:\n\nTuesday to Saturday, 5.30am to 1.30pm and 3.30pm to 7.30pm.\nSundays from 7am to 1pm.\n\nClosed on Mondays\n \n Collection:\n\nTakeaway during store opening hours\n\nOrdering :\n\nOrder by telephone on 03 21 48 31 55\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: pane, pasticceria viennese e torte\n\nGiorni di apertura:\n\nDa martedì a sabato dalle 5.30 alle 13.30 e dalle 15.30 alle 19.30.\nDomenica dalle 7.00 alle 13.00.\n\nChiuso il lunedì\n \n Raccolta:\n\nDa asporto durante gli orari di apertura del negozio\n\nOrdini :\n\nLe ordinazioni possono essere effettuate telefonicamente al numero 03 21 48 31 55\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits : pains, viennoiseries et pâtisserie\n\nJours d'ouverture:\n\nDu mardi au samedi de 5h30 à 13h30 et de 15h30 à 19h30.\nLe dimanche de 7h à 13h.\n\nFermeture le lundi\n \n Retrait :\n\nÀ emporter aux horaires d'ouverture du magasin\n\nCommandes :\n\nPossibilité de commander par téléphone au 03 21 48 31 55\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: brood, Weens gebak en taarten\n\nOpeningsdagen:\n\nDinsdag tot zaterdag van 5.30 tot 13.30 en van 15.30 tot 19.30.\nZondag van 7.00 tot 13.00 uur.\n\nGesloten op maandag\n \n Ophalen:\n\nAfhalen tijdens openingstijden winkel\n\nBestellen :\n\nBestellingen kunnen telefonisch worden doorgegeven op 03 21 48 31 55\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: pan, bollería y pastelería\n\nDías de apertura:\n\nDe martes a sábado de 5.30 h a 13.30 h y de 15.30 h a 19.30 h.\nDomingos de 7.00 a 13.00 h.\n\nLunes cerrado\n \n Recogida:\n\nPara llevar durante el horario de apertura de la tienda\n\nPedidos :\n\nSe pueden hacer pedidos por teléfono llamando al 03 21 48 31 55\n\n "
        ]
      },
