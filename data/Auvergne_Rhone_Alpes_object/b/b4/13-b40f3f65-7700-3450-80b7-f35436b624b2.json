  "rdfs:comment": {
    "de": [
      "Ort der künstlerischen Gestaltung und Verbreitung von Live-Shows (Programm von Oktober bis Juni). Kreation mit Les Tréteaux du Fenouillet auf Tour im Sommer in den Dörfern Drôme und Ardèche. Theaterworkshops. Freilufttheater"
    ],
    "en": [
      "Artistic creation and live shows diffusion place (program from october to june).\r\nCreation with \"les tréteaux du fenouillet\" on summer tour in the Drôme provençale villages.\r\nTheatre workshops, green theater."
    ],
    "it": [
      "Luogo di creazione artistica e diffusione di spettacoli dal vivo (programmazione da ottobre a giugno). Creazione con Les Tréteaux du Fenouillet in tournée durante l'estate nei villaggi della Drôme e dell'Ardèche. Laboratori teatrali. Teatro del verde."
    ],
    "fr": [
      "Lieu de création artistique et de diffusion de spectacles vivants (programmation d'octobre à juin). Création avec Les Tréteaux du Fenouillet en tournée en période estivale dans les villages de Drôme et d'Ardèche. Ateliers de théâtre. Théâtre de verdure."
    ],
    "es": [
      "Lugar de creación artística y difusión de espectáculos en vivo (programación de octubre a junio). Creación con Les Tréteaux du Fenouillet en gira durante el verano en los pueblos de Drôme y Ardèche. Talleres de teatro. Teatro de la vegetación."
    ],
    "nl": [
      "Een plek voor artistieke creativiteit en voor\r\nuitvoeringen (programmering van oktober t/m juni). In de zomer toeren Les\r\nTretaux du Fenouillet langs de dorpen van de Drôme. Theater workshops.\r\nOpen lucht uitvoeringen."
    ]
  },
