  "rdfs:comment": {
    "de": [
      "Reitausflüge von 1 bis 3 Stunden und von 1 Tag bis 5 Tage (Ausritte Plateau de Retord mit Übernachtung in Gîtes).\r\nPonyreiten für Kinder (2 bis 7 Jahre), Pferdepension. Für alle Niveaus. Nach vorheriger Reservierung.\r\nBaby-Pony-Kurse, Galopps in freier Natur."
    ],
    "en": [
      "The Lavant Equesterian Centre in Thézillieu offers Treks on horseback that can range in duration from a couple of hours to up to 5 days and Shetland pony rides for children aged between 2 and 7 years old (RESERVATION ESSENTIAL)."
    ],
    "it": [
      "Escursioni a cavallo da 1 a 3 ore e da 1 giorno a 5 giorni (passeggiate sul Plateau de Retord con pernottamento in gîtes).\r\nPasseggiate su pony per bambini (da 2 a 7 anni), pensione per cavalli. Tutti i livelli. Su prenotazione.\r\nLezioni di baby pony, galoppate di passaggio in campagna."
    ],
    "fr": [
      "Balades à cheval de 1h à 3h et de 1 journée à 5 jours (randonnées Plateau de Retord avec nuit en gîtes).\r\nPromenade en poney pour les enfants (2 à 7 ans), pension chevaux. Tous niveaux. Sur réservation.\r\nCours baby poneys, passage galops pleine nature."
    ],
    "es": [
      "Paseos a caballo de 1 a 3 horas y de 1 a 5 días (paseos por el Plateau de Retord con pernoctación en casas rurales).\r\nPaseos en poni para niños (de 2 a 7 años), pupilaje de caballos. Todos los niveles. En reserva.\r\nClases de ponis para bebés, galopes de paso por el campo."
    ],
    "nl": [
      "Paardrijden van 1 tot 3 uur en van 1 dag tot 5 dagen (ritten op het Plateau de Retord met overnachting in gîtes).\r\nPonyrijden voor kinderen (2 tot 7 jaar), paardenpension. Alle niveaus. Op reservering.\r\nBaby pony lessen, passage galops op het platteland."
    ]
  },
  "rdfs:label": {
    "en": [
