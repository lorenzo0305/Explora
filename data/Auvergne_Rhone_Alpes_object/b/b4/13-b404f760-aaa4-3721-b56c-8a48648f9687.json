  "rdfs:comment": {
    "de": [
      "Auf dieser langen Wanderung können Sie die Höhen von Puy-Saint-Martin entdecken und das Dorf Manas über die Montagne Sainte-Euphémie erreichen: Aussichtspunkt garantiert!"
    ],
    "en": [
      "This long hike takes in the heights of Puy-Saint-Martin and leads to the village of Manas via Montagne Sainte-Euphémie: you're guaranteed a great view!"
    ],
    "it": [
      "Questa lunga escursione permette di scoprire le alture del Puy-Saint-Martin e di raggiungere il villaggio di Manas dalla Montagne Sainte-Euphémie: un punto panoramico garantito!"
    ],
    "fr": [
      "Cette longue randonnée permet de découvrir les hauteurs de Puy-Saint-Martin et de rejoindre le village de Manas par la Montagne Sainte-Euphémie : point de vue assuré !"
    ],
    "es": [
      "Esta larga caminata permite descubrir las alturas de Puy-Saint-Martin y llegar al pueblo de Manas por la Montaña Sainte-Euphémie: ¡un mirador garantizado!"
    ],
    "nl": [
      "Deze lange wandeling voert langs de hoogten van Puy-Saint-Martin en het dorp Manas via de Montagne Sainte-Euphémie: je bent verzekerd van een geweldig uitzicht!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Chevrière - Sainte Euphémie"
    ]
  },
