  "rdfs:comment": {
    "de": [
      "Karte wird zweimal im Jahr erneuert.\r\nPizzas aus der Region, aber auch Produkte aus der Region, Focacce.\r\nOriginelle Rezepte, die um außergewöhnliche Produkte aus emblematischen Gegenden Frankreichs und anderer Länder herum entwickelt werden."
    ],
    "en": [
      "Menu renewed 2 times a year.\r\nLocal pizzas, as well as local products and focaccia.\r\nOriginal recipes based on exceptional products from emblematic regions of France and beyond."
    ],
    "it": [
      "Menu rinnovato due volte l'anno.\r\nPizze locali, ma anche prodotti tipici, focacce.\r\nRicette originali a base di prodotti eccezionali provenienti da regioni emblematiche della Francia e non solo."
    ],
    "fr": [
      "Carte renouvelée 2 fois par an.\r\nPizzas de terroir, mais aussi produits du terroir, focacce.\r\nRecettes originales, élaborées autour de produits d'exception issus de terroirs emblématiques de France et d’ailleurs."
    ],
    "nl": [
      "Menu twee keer per jaar veranderd.\r\nLokale pizza's, maar ook lokale producten en focaccia.\r\nOriginele recepten op basis van uitzonderlijke producten uit emblematische regio's van Frankrijk en daarbuiten."
    ],
    "es": [
      "Menú renovado dos veces al año.\r\nPizzas locales, pero también productos locales, focacce.\r\nRecetas originales basadas en productos excepcionales de regiones emblemáticas de Francia y de otros países."
    ]
  },
