  "rdfs:comment": {
    "de": [
      "Crêperie, Pizzas, savoyische Spezialitäten und hausgemachte Spezialitäten. Handgemachter Pizzateig, selbst gekochte Tomaten. Crêpes aus biologischen Mehlen. Fondue \"Ptite Bouffe\", hausgemachte Spezialitäten \"Polenta\", \"Crozets\"."
    ],
    "en": [
      "Creperie, pizzas, local specialties and homemade specialties. Pizza dough handmade, cooked tomatoes by us. Pancakes made with organic flour. Fondue \"Ptite Bouffe\" house specialties \"Polenta-Crozets.\""
    ],
    "it": [
      "Creperie, pizze, specialità locali e specialità fatte in casa. Pizza pasta fatta a mano, pomodori cotti da noi. Frittelle fatti con farina biologica. Fondue \"Ptite Bouffe\" specialità della casa \"Polenta-Crozets.\""
    ],
    "fr": [
      "Crêperie, pizzas, spécialités savoyardes et spécialités maison. Pâte à pizza réalisée à la main, tomates cuisinées par nos soins. Crêpes à base de farines biologiques. Fondue \"Ptite Bouffe\", spécialités maison \"Polenta\", \"Crozets\"."
    ],
    "es": [
      "Crepería, pizzas, especialidades de Saboya y especialidades caseras. Masa de pizza hecha a mano, tomates caseros. Tortitas elaboradas con harinas ecológicas. Fondue \"Ptite Bouffe\", especialidades de la casa \"Polenta\", \"Crozets\"."
    ],
    "nl": [
      "Crêperie, pizza's, specialiteiten uit de Savoie en huisgemaakte specialiteiten. Handgemaakt pizzadeeg, zelf gekookte tomaten. Pannenkoeken gemaakt met biologisch meel. Fondue \"Ptite Bouffe\", huisspecialiteiten \"Polenta\", \"Crozets\"."
    ]
  },
