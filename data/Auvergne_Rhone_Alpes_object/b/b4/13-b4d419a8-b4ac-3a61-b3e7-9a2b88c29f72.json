  "rdfs:comment": {
    "de": [
      "Wir bereiten alle unsere Gerichte mit einem Maximum an lokalen oder regionalen Produkten zu und arbeiten mit Handwerkern, Metzgern, Fleischern, Bäckern und Käsern zusammen, um Ihnen die besten Produkte der Haute-Loire in unserem Restaurant in Le Puy-en-Velay anbieten zu können!"
    ],
    "en": [
      "We prepare all our dishes with a maximum of local or regional products and work with craftsmen, butchers, butchers, bakers and cheese makers to offer you the best products of Haute-Loire in our restaurant in Puy-en-Velay !"
    ],
    "it": [
      "Prepariamo tutti i nostri piatti con un massimo di prodotti locali o regionali e collaboriamo con artigiani, macellai, norcini, panettieri e casari per offrirvi i migliori prodotti dell'Alta Loira nel nostro ristorante a Le Puy-en-Velay!"
    ],
    "fr": [
      "Nous préparons tous nos plats avec un maximum de produits locaux ou régionaux et travaillons avec des artisans, bouchers, charcutiers, boulangers et fromagers pour vous proposer les meilleurs produits de Haute-Loire dans notre restaurant au Puy-en-Velay !"
    ],
    "nl": [
      "Wij bereiden al onze gerechten met een maximum aan lokale of regionale producten en werken samen met ambachtslieden, slagers, varkensslagers, bakkers en kaasmakers om u in ons restaurant in Le Puy-en-Velay de beste producten uit de Haute-Loire aan te bieden!"
    ],
    "es": [
      "Preparamos todos nuestros platos con un máximo de productos locales o regionales y trabajamos con artesanos, carniceros, charcuteros, panaderos y queseros para ofrecerle los mejores productos del Alto Loira en nuestro restaurante de Le Puy-en-Velay"
    ]
  },
  "rdfs:label": {
