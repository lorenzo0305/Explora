  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ad0d0eeb-c74c-3b17-96fe-b84e9040c3bb",
      "dc:description": {
        "de": [
          "Die Ducasse de Coupelle-Neuve findet ab 19.00 Uhr statt\n\n- Der Eintritt ist frei,\n- Verpflegung vor Ort,\n\nReservierung vor dem 8. September unter 06 73 04 19 29 oder 07 49 36 19 24 erforderlich"
        ],
        "en": [
          "La Ducasse de Coupelle-Neuve will be held from 7:00 p.m\n\n- Free admission,\n- Catering on site,\n\nReservations required by September 8 on 06 73 04 19 29 or 07 49 36 19 24"
        ],
        "it": [
          "La Coupelle-Neuve Ducasse si terrà a partire dalle 19.00\n\n- Ingresso libero,\n- Ristorazione in loco,\n\nPrenotazione obbligatoria entro l'8 settembre al numero 06 73 04 19 29 o 07 49 36 19 24"
        ],
        "fr": [
          "La Ducasse de Coupelle-Neuve se tiendra à partir de 19h00\n\n- Entrée gratuite,\n- Restauration sur place,\n\nRéservation obligatoire avant le 8 septembre au 06 73 04 19 29 ou 07 49 36 19 24"
        ],
        "es": [
          "La Coupelle-Neuve Ducasse se celebrará a partir de las 19.00 horas\n\n- Entrada gratuita,\n- Catering in situ,\n\nReserva obligatoria antes del 8 de septiembre en el 06 73 04 19 29 o en el 07 49 36 19 24"
        ],
        "nl": [
          "De Coupelle-Neuve Ducasse wordt gehouden vanaf 19.00 uur\n\n- Gratis toegang,\n- Catering ter plaatse,\n\nReserveren verplicht vóór 8 september op 06 73 04 19 29 of 07 49 36 19 24"
        ]
      },
