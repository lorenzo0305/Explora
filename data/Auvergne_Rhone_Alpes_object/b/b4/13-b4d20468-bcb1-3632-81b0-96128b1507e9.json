  "rdfs:comment": {
    "de": [
      "Freie Besichtigung auf Anfrage im Rathaus von Gannat, mit Informationsschild. Der Hauptteil dieses Gebäudes soll aus dem Jahr 1000 stammen: gewölbtes Kirchenschiff aus Holz, schlichtes Dekor..."
    ],
    "en": [
      "Self-guided tour on request from Gannat town hall, with information board. The main part of this edifice dates back to the year 1000: wooden vaulted nave, sober decor..."
    ],
    "it": [
      "Visita guidata su richiesta presso il municipio di Gannat, con pannello informativo. La parte principale di questo edificio risale all'anno 1000: navata con volte in legno, arredamento sobrio..."
    ],
    "fr": [
      "Visite libre sur demande à la mairie de Gannat, avec panneau d'information. La partie principale de cet édifice daterait de l'an mille : nef voûtée en bois, sobriété dans le décor..."
    ],
    "es": [
      "Visita autoguiada previa solicitud al ayuntamiento de Gannat, con tablón de información. La parte principal de este edificio data del año 1000: nave abovedada de madera, decoración sobria..."
    ],
    "nl": [
      "Rondleiding op aanvraag bij het gemeentehuis van Gannat, met informatiebord. Het grootste deel van dit gebouw dateert uit het jaar 1000: houten gewelfd schip, sober decor..."
    ]
  },
