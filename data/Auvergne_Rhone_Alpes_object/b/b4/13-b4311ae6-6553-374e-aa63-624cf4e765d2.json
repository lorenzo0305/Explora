  "rdfs:comment": {
    "de": [
      "Holen Sie Ihre schönsten Neon-Outfits hervor und begeben Sie sich auf eine Reise in die Vergangenheit! Tanzendes Essen zu den legendären Hits der 80er Jahre. Garantierte Stimmung durch das Duo Eclipse. Komplettes Menü mit kostenlosem Cocktail. Kostenlos bis 10 Jahre. Reservieren Sie vor dem 4. März!"
    ],
    "en": [
      "Get out your best fluorescent outfits for a trip back in time! Meal and dance to the legendary hits of the 80s. The Eclipse Duo guarantees a great atmosphere. Full menu with complimentary cocktail. Free for children under 10. Book before March 4!"
    ],
    "it": [
      "Tirate fuori i vostri migliori abiti fluorescenti per un viaggio nel tempo! Pranzate e ballate le leggendarie hit degli anni '80. Atmosfera garantita dal Duo Eclipse. Menu completo con cocktail in omaggio. Gratis per i bambini sotto i 10 anni. Prenota prima del 4 marzo!"
    ],
    "fr": [
      "Ressortez vos plus belles tenues fluo pour un voyage dans le temps ! Repas dansant sur les tubes mythiques des années 80. Ambiance garantie par le Duo Eclipse. Menu complet avec cocktail offert. Gratuit jusqu'à 10 ans. Réservez avant le 4 mars !"
    ],
    "es": [
      "¡Saca tus mejores atuendos fluorescentes para un viaje al pasado! Come y baila al ritmo de los míticos éxitos de los 80. Ambiente garantizado por el Dúo Eclipse. Menú completo con cóctel de cortesía. Gratis para menores de 10 años. Reserva antes del 4 de marzo"
    ],
    "nl": [
      "Trek je beste fluorescerende outfits uit de kast voor een reis terug in de tijd! Maaltijd en dans op de legendarische hits van de jaren 80. Sfeer gegarandeerd door het Duo Eclipse. Volledig menu met gratis cocktail. Gratis voor kinderen onder de 10 jaar. Reserveer voor 4 maart!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Années 80's"
    ]
  },
