  "rdfs:comment": {
    "de": [
      "In Kategorie 1 eingestuft.\r\nTouristische Informationen über die Region, aber auch: Fotokopien, kostenloser WLAN-Zugang, Wetterbericht, Souvenirladen...\r\nZugang für Behinderte und Kinderwagen: Zugang über eine Rampe und Klingel, die bei Bedarf zur Verfügung gestellt wird, automatische Türen."
    ],
    "en": [
      "Classified as Category 1.\r\nTourist information on the region but also: photocopies, free Wi-Fi access, weather forecast displayed every day, babysitter list, small souvenir shop etc. \r\nAccess for people with reduced mobility and pushchairs : access with a ramp and bell provided if required, automatic doors."
    ],
    "it": [
      "Classificato come categoria 1.\r\nInformazioni turistiche sulla regione, fotocopie, connessione Wi-Fi gratuita, previsioni meteorologiche, negozio di souvenir, ecc.\r\nAccesso PRM e passeggini: accesso tramite rampa e campanello, se necessario, porte automatiche."
    ],
    "fr": [
      "Classé en Catégorie 1.\r\nInformation touristique sur la région mais aussi : photocopies, accès wifi gratuit, météo, boutique souvenirs... \r\nAccès PMR et poussettes : accès via une rampe d'accès et sonnette mise à disposition si besoin, portes automatiques."
    ],
    "nl": [
      "Ingedeeld als categorie 1.\r\nToeristische informatie over de regio, maar ook: fotokopieën, gratis wifi, dagelijks weerbericht, lijst van babysitters, kleine souvenirwinkel... \r\nToegang voor personen met beperkte mobiliteit en kinderwagens: toegang met een helling en bel indien nodig, automatische deuren."
    ],
    "es": [
      "Clasificado como categoría 1.\r\nInformación turística sobre la región, así como fotocopias, acceso Wi-Fi gratuito, previsión meteorológica, tienda de recuerdos, etc.\r\nAcceso para PMR y cochecitos: acceso mediante rampa y timbre disponible en caso necesario, puertas automáticas."
    ]
  },
