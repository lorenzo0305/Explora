  "rdfs:comment": {
    "de": [
      "La Note Gourmande, das ist vor allem eine Geschichte der Leidenschaft. Wir erfinden das Street Food neu, indem wir eine Speisekarte zusammenstellen, die sowohl die unumgänglichen Klassiker dieser Küche als auch die Klassiker der Bistroküche ehrt."
    ],
    "en": [
      "La Note Gourmande is above all a story of passionate people sharing their culinary adventure with you. Between modernity and tradition, we give pride of place to the best products from the artisans of our beautiful region, offering you a menu combining Bistro cuisine and Street Food."
    ],
    "it": [
      "La Note Gourmande è la storia di un gruppo di appassionati che condividono con voi la loro avventura culinaria. Tra modernità e tradizione, privilegiamo i migliori prodotti degli artigiani della nostra regione: un menu che combina cucina da bistrot e street food"
    ],
    "fr": [
      "La Note Gourmande, c’est une histoire de passionné qui vous font partager leur aventure culinaire. Entre modernité et tradition nous mettons à l’honneur les meilleurs produits des artisans de notre région:une carte alliant cuisine de Bistrot & Street Food"
    ],
    "nl": [
      "La Note Gourmande is vooral een verhaal van passie. We vinden street food opnieuw uit met een menu dat zowel de must-tries van street food als klassieke bistrogerechten bevat."
    ],
    "es": [
      "La Note Gourmande es la historia de un grupo de entusiastas que comparten con usted su aventura culinaria. Entre modernidad y tradición, damos protagonismo a los mejores productos de los artesanos de nuestra región: una carta que combina cocina de bistró y Street Food"
    ]
  },
  "rdfs:label": {
