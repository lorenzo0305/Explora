  "rdfs:comment": {
    "de": [
      "Das ehemalige CNP Bellecour, das heute in Lumière Bellecour umbenannt wurde, bietet nun allen Komfort, den die Zuschauer in einem Kinosaal erwarten dürfen."
    ],
    "en": [
      "Formerly CNP Bellecour and now renamed Lumière Bellecour, the cinema now offers all the comfort that moviegoers are entitled to expect in a movie theatre."
    ],
    "it": [
      "Già CNP Bellecour e ora ribattezzato Lumière Bellecour, il cinema offre tutti i comfort che gli spettatori hanno il diritto di aspettarsi da una sala cinematografica."
    ],
    "fr": [
      "Anciennement CNP Bellecour et aujourd'hui rebaptisé Lumière Bellecour, le cinéma offre à présent tout le confort que les spectateurs sont en droit d’attendre dans une salle de cinéma."
    ],
    "nl": [
      "Voorheen CNP Bellecour en nu omgedoopt tot Lumière Bellecour, biedt de bioscoop nu al het comfort dat toeschouwers in een bioscoop mogen verwachten."
    ],
    "es": [
      "Antiguamente CNP Bellecour y ahora rebautizado como Lumière Bellecour, el cine ofrece ahora todo el confort que los espectadores tienen derecho a esperar en una sala de cine."
    ]
  },
  "rdfs:label": {
