  "rdfs:comment": {
    "de": [
      "La SALLE NOIRE, seit 2011 in der ehemaligen Fabrik Cémoi in Grenoble angesiedelt, ist der Ort, an dem die Cie des Barbarins Fourchus kreativ tätig ist: Aufführungssaal, multidisziplinäres Labor, Raum für Experimente und künstlerische Begegnungen."
    ],
    "en": [
      "Since 2011, the SALLE NOIRE, located in the former Cémoi factory in Grenoble, has been the creative home of the Cie des Barbarins Fourchus: a performance space, a multidisciplinary laboratory, a place for experimentation and artistic encounters."
    ],
    "it": [
      "Dal 2011, la SALLE NOIRE, situata nell'ex fabbrica Cémoi di Grenoble, è la casa creativa della Cie des Barbarins Fourchus: uno spazio performativo, un laboratorio multidisciplinare, un luogo di sperimentazione e di incontro artistico."
    ],
    "fr": [
      "La SALLE NOIRE, implantée depuis 2011 dans l’ancienne usine Cémoi à Grenoble, est le lieu de création de la Cie des Barbarins Fourchus : salle de spectacle, laboratoire pluridisciplinaire, espace d’expérimentation et de rencontres artistiques."
    ],
    "nl": [
      "Sinds 2011 is het SALLE NOIRE, gevestigd in de voormalige Cémoi fabriek in Grenoble, de creatieve thuisbasis van de Cie des Barbarins Fourchus: een performance ruimte, een multidisciplinair laboratorium, een plek voor experimenten en artistieke ontmoetingen."
    ],
    "es": [
      "Desde 2011, la SALLE NOIRE, instalada en la antigua fábrica Cémoi de Grenoble, es el hogar creativo de la Cie des Barbarins Fourchus: un espacio de espectáculos, un laboratorio multidisciplinar, un lugar para la experimentación y los encuentros artísticos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Salle Noire"
    ]
  },
