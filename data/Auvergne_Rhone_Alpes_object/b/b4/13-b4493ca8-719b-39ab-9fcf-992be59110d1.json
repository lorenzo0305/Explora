  "rdfs:comment": {
    "de": [
      "Handwerklich hergestellte Pizzas unter Einhaltung der italienischen Traditionen.\r\nZum Mitnehmen, vor Ort und Lieferung nach Hause. Bars, in denen Bier ausgeschenkt wird. Gesellige und gemütliche Atmosphäre!\r\nGenießen Sie im Sommer unsere schöne Terrasse ."
    ],
    "en": [
      "Artisan pizzas respecting Italian traditions. \r\nTakeaway, on-site, and home delivery. Beer bars. Friendly and cozy atmosphere! \r\nCome enjoy our beautiful terrace in summer."
    ],
    "it": [
      "Pizze artigianali nel rispetto delle tradizioni italiane. \r\nDa asporto, sul posto e consegna a domicilio. Birrerie. Atmosfera conviviale e accogliente! \r\nVenite a godervi la nostra bella terrazza d'estate."
    ],
    "fr": [
      "Pizzas artisanales dans le respect des traditions italiennes. \r\nA emporter, sur place et livraison à domicile. Bars à bières. Ambiance conviviale et cosy ! \r\nVenez profitez de notre belle terrasse en été ."
    ],
    "nl": [
      "Traditionele Italiaanse pizza's.\r\nAfhaalmaaltijden, bezorging op locatie en thuisbezorging. Bierbars. Gezellige, vriendelijke sfeer!\r\nKom en geniet van ons mooie terras in de zomer."
    ],
    "es": [
      "Pizzas italianas tradicionales.\r\nPara llevar, in situ y a domicilio. Cervecerías. Ambiente acogedor y agradable\r\nVenga a disfrutar de nuestra agradable terraza en verano."
    ]
  },
  "rdfs:label": {
