  "rdfs:comment": {
    "de": [
      "Werden Sie für ein Wochenende zum Schlossherrn und empfangen Sie Ihre Familie und Freunde exklusiv, wie \"bei sich zu Hause\", für Hochzeiten, Cocktailpartys, Arbeitstreffen und prestigeträchtige Veranstaltungen."
    ],
    "en": [
      "Become a châtelain for a weekend and welcome your family and friends exclusively \"at home\" for your weddings, cocktails, business meetings and prestigious events."
    ],
    "it": [
      "Diventate proprietari del castello per un fine settimana e accogliete la vostra famiglia e i vostri amici in modo esclusivo, come \"a casa vostra\", per i vostri matrimoni, cocktail, riunioni di lavoro ed eventi prestigiosi."
    ],
    "fr": [
      "Devenez châtelain le temps d'un week-end et accueillez vos familles et amis en exclusivité, comme \"chez vous\", pour vos mariages, cocktails, réunions de travail et événements de prestige."
    ],
    "nl": [
      "Word voor een weekend eigenaar van een kasteel en ontvang uw familie en vrienden in exclusiviteit, zoals \"thuis\", voor uw bruiloften, cocktails, zakelijke bijeenkomsten en prestigieuze evenementen."
    ],
    "es": [
      "Conviértase en propietario de un castillo por un fin de semana y reciba a su familia y amigos en exclusiva, como \"en casa\", para sus bodas, cócteles, reuniones de negocios y eventos de prestigio."
    ]
  },
  "rdfs:label": {
