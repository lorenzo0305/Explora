  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine Minigolfanlage, 18 Löcher wie die Großen, die so angelegt wurde, dass sie den Besuchern ein spielerisches und unterhaltsames Erlebnis bietet."
    ],
    "en": [
      "Discover a miniature golf course, 18 holes just like the big ones, designed to offer visitors a fun and entertaining experience."
    ],
