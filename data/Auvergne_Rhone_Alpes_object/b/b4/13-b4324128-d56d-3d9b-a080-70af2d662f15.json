  "rdfs:comment": {
    "de": [
      "Parcours für erfahrene Erwachsene und Jugendliche. Sehr luftig und körperlich anstrengend. Er beginnt mit einer 40 m langen senkrechten Wand, dann einer weiteren weiter hinten und geht über Brücken und Stege in den höchsten Felsabschnitt über. Optional: 20 m Überhang."
    ],
    "en": [
      "Course for experienced adults and teenagers. Very aerial and physical, it starts with a 40-metre vertical wall, then another one further on, followed by bridges and footbridges on the highest rock section. Optional: 20m slope."
    ],
    "it": [
      "Corso per adulti e ragazzi esperti. Molto aereo e fisico, inizia con una parete verticale di 40 metri, poi un'altra più avanti, seguita da ponti e passerelle sul tratto di roccia più alto. Opzionale: pendio di 20 metri."
    ],
    "fr": [
      "Parcours pour adultes et ados expérimentés. Très aérien et physique, il débute par un mur vertical de 40 mètres puis un autre plus loin et enchaîne par des ponts et passerelles sur la plus haute partie rocher. En option : devers de 20m."
    ],
    "nl": [
      "Parcours voor ervaren volwassenen en tieners. Zeer luchtig en fysiek, het begint met een verticale wand van 40 meter, dan nog een verderop, gevolgd door bruggen en loopbruggen op het hoogste rotsgedeelte. Optioneel: helling van 20 meter."
    ],
    "es": [
      "Curso para adultos y adolescentes con experiencia. Muy aéreo y físico, comienza con una pared vertical de 40 metros, luego otra más adelante, seguida de puentes y pasarelas en la sección de roca más alta. Opcional: pendiente de 20 m."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Via Ferrata Roumpo Quieu"
    ]
  },
