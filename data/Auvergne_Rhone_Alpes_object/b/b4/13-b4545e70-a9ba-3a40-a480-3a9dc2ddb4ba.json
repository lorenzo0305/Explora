  "rdfs:comment": {
    "de": [
      "STARMUSICAL ist eine einzigartige musikalische Reise, die Hits, Emotionen, Lachen und Erinnerungen miteinander verbindet. Atemberaubende Choreographien, schillernde Kostüme und eine Live-Band sorgen für eine festliche und großartige Show, die das Publikum von Anfang bis Ende in Staunen versetzt."
    ],
    "en": [
      "STARMUSICAL is a unique musical journey combining cult hits, emotions, laughter and memories. Breathtaking choreography, flamboyant costumes and a live band give life to a festive, grandiose show that fills the audience with wonder from start to finish."
    ],
    "it": [
      "STARMUSICAL è un viaggio musicale unico che unisce successi cult, emozioni, risate e ricordi. Coreografie mozzafiato, costumi sgargianti e una band dal vivo danno vita a uno spettacolo festoso e grandioso che stupisce il pubblico dall'inizio alla fine."
    ],
    "fr": [
      "STARMUSICAL, c’est un voyage musical unique mêlant hits cultes, émotions, rires et souvenirs. Chorégraphies époustouflantes, costumes flamboyants et live band donnent vie à un show festif et grandiose qui émerveille le public du début à la fin."
    ],
    "nl": [
      "STARMUSICAL is een unieke muzikale reis die culthits, emotie, gelach en herinneringen combineert. Adembenemende choreografie, flamboyante kostuums en een live band brengen een feestelijke, grandioze show tot leven die het publiek van begin tot eind versteld doet staan."
    ],
    "es": [
      "STARMUSICAL es un viaje musical único que combina éxitos de culto, emoción, risas y recuerdos. Coreografías impresionantes, trajes extravagantes y una banda en directo dan vida a un espectáculo festivo y grandioso que sorprende al público de principio a fin."
    ]
  },
  "rdfs:label": {
