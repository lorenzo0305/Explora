  "rdfs:comment": {
    "de": [
      "Sur le Zinc empfängt Sie vom Morgen an für den kleinen Café Croissant bis zum Abend für einen kleinen Aperitif vor Ihrem Abendessen."
    ],
    "en": [
      "Sur le Zinc welcomes you from the morning for the small croissant coffee until the evening for a small aperitif before your dinner."
    ],
    "it": [
      "Sur le Zinc vi accoglie dal mattino per un piccolo caffè croissant alla sera per un piccolo aperitivo prima della cena."
    ],
    "fr": [
      "Sur le Zinc vous accueille dès le matin pour le petit café croissant jusqu'au soir pour un petit apéro avant votre dîner."
    ],
    "nl": [
