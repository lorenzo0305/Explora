  "rdfs:comment": {
    "de": [
      "Der Bugeon ist ein Gebirgsbach mit vielen fischreichen Nebenflüssen. Er ist in seinem oberen Teil in Richtung St. François Longchamp am interessantesten zu befischen, weil er fischreicher ist."
    ],
    "en": [
      "The Bugeon is a mountain torrent with many fishy tributaries. It is more interesting to fish on its upstream part in the direction of St François Longchamp, because it is more fishy."
    ],
    "it": [
      "Il Bugeon è un torrente di montagna con molti affluenti pescosi. È più interessante pescare nella sua parte a monte, verso St François Longchamp, perché è più pescosa."
    ],
    "fr": [
      "Le Bugeon est un torrent de montagne qui comporte de nombreux affluents piscicoles. Il est plus intéressant à pêcher sur sa partie amont en direction de St François Longchamp, parce qu'elle est plus poissoneuse."
    ],
    "es": [
      "El Bugeon es un arroyo de montaña con numerosos afluentes piscícolas. Es más interesante pescar en su parte aguas arriba, hacia St François Longchamp, porque es más piscícola."
    ],
    "nl": [
      "De Bugeon is een bergstroom met vele visdragende zijrivieren. Het is interessanter om te vissen op het stroomopwaartse deel richting St François Longchamp, omdat daar meer vis zit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bugeon et affluents"
    ]
  },
