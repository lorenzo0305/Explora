  "rdfs:comment": {
    "de": [
      "Romain bietet Ihnen eine Vielzahl von Leistungen an, von der Einführung bis zur Perfektionierung über das Float-Tube in Allier anderswo oder auch Auslandsaufenthalte."
    ],
    "en": [
      "Romain offers a wide range of services, from beginners to advanced levels, including float-tubing in the Allier region and trips abroad."
    ],
    "it": [
      "Romain offre un'ampia gamma di servizi, dall'iniziazione al perfezionamento, compreso il float-tubing nella regione dell'Allier e i viaggi all'estero."
    ],
    "fr": [
      "Romain vous propose une multitude de prestations, de l'initiation au perfectionnement en passant par le float-tube en Allier ailleurs ou encore les séjours à l'étranger."
    ],
    "es": [
      "Romain ofrece una amplia gama de servicios, desde la iniciación hasta el perfeccionamiento, pasando por la práctica del float-tubing en la región de Allier y los viajes al extranjero."
    ],
    "nl": [
      "Romain biedt een breed scala aan diensten, van initiatie tot verbetering, waaronder float-tubing in de Allier en reizen naar het buitenland."
    ]
  },
  "rdfs:label": {
