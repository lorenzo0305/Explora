  "rdfs:comment": {
    "de": [
      "\"Gönnen Sie sich eine Pause im Chalet du Golf\". Von der Sonnenterrasse des Club-House aus geniessen Sie eine Lage mitten im Parcours, zwei Schritte vom Green des Lochs Nr. 18 entfernt und eine atemberaubende Aussicht auf die Berge."
    ],
    "en": [
      "\"Treat yourself to a break at the Chalet du Golf\". From the Clubhouse’s sunny terrace, enjoy a spot at the heart of the course, a stone’s throw from the 18th green with uninterrupted views of the mountains."
    ],
    "it": [
      "\"Concedetevi una pausa allo Chalet du Golf. Dalla terrazza soleggiata della Club-House si gode di una posizione nel cuore del campo, a pochi passi dal green della buca 18 e con una vista mozzafiato sulle montagne."
    ],
    "fr": [
      "\"Accordez-vous une pause au Chalet du Golf\". Depuis la terrasse ensoleillée du Club-House profitez d’une situation au cœur du parcours, à deux pas du green du trou n°18 et avec une vue imprenable sur les montagnes."
    ],
    "nl": [
      "\"Trakteer jezelf op een pauze in het Chalet du Golf. Geniet vanaf het zonnige terras van het Clubhuis van een locatie in het hart van de golfbaan, op een steenworp afstand van de green van hole 18 en met een adembenemend uitzicht op de bergen."
    ],
    "es": [
      "\"Tómese un descanso en el Chalet du Golf. Desde la soleada terraza de la Casa-Club podrá disfrutar de una ubicación en el corazón del campo, a un paso del green del hoyo 18 y con unas vistas impresionantes de las montañas."
    ]
  },
  "rdfs:label": {
    "de": [
      "Le Chalet du Golf"
    ],
    "en": [
      "Chalet du Golf"
    ],
    "fr": [
      "Le Chalet du golf"
    ],
    "nl": [
      "Het Golf Chalet"
    ]
  },
