  "rdfs:comment": {
    "de": [
      "La Pizza aux 4 Coins ist eine Pizzeria mit altfranzösischem Flair.\r\nMehr als 70 handgemachte Pizzen stehen auf der Speisekarte, die Sie vor Ort essen (in der Saison) oder mitnehmen können.\r\nAußerdem gibt es Aperitifplatten, Quiches, Wein- und Bierverkauf sowie Bio-Eis."
    ],
    "en": [
      "La Pizza aux 4 Coins is a pizzeria with an Old French flair.\r\nOver 70 artisanal pizzas à la carte, to eat in (in season) or take away.\r\nAlso aperitif boards, quiches, wine and beer sales, and organic ice creams."
    ],
    "it": [
      "La Pizza aux 4 Coins è una pizzeria dal sapore antico e francese.\r\nOltre 70 pizze fatte in casa alla carta, da mangiare (in stagione) o da portare via.\r\nInoltre, aperitivi al piatto, quiche e vendita di vino e birra, oltre a gelati biologici."
    ],
    "fr": [
      "La Pizza aux 4 Coins est une pizzeria a l'allure vieille France.\r\nPlus de 70 pizzas artisanales à la carte, à manger sur place (en saison) ou à emporter. \r\nEgalement des planches apéritives, des quiches et vente de vins et bières ainsi que des glaces bio."
    ],
    "nl": [
      "La Pizza aux 4 Coins is een pizzeria met een oude Franse sfeer.\r\nMeer dan 70 huisgemaakte pizza's à la carte, om te eten (in het seizoen) of om mee te nemen.\r\nOok aperitiefschotels, quiches en verkoop van wijn en bier, en biologisch ijs."
    ],
    "es": [
      "La Pizza aux 4 Coins es una pizzería con aire francés.\r\nMás de 70 pizzas caseras a la carta, para comer en casa (en temporada) o para llevar.\r\nTambién platos de aperitivo, quiches, venta de vinos y cervezas y helados ecológicos."
    ]
  },
  "rdfs:label": {
