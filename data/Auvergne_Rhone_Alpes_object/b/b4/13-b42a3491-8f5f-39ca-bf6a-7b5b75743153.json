  "rdfs:comment": {
    "de": [
      "In diesem Club finden Sie die neuesten Matrix-Fitnessgeräte, die für alle zugänglich sind, ein dynamisches Lehrerteam, Privattrainer sowie zahlreiche Gruppenkurse! Entdecken Sie eine familiäre und gesellige Atmosphäre."
    ],
    "en": [
      "You will find in this club the latest Matrix fitness equipment accessible to all, a team of dynamic teachers, private coaches and many group classes! Discover a family and friendly atmosphere."
    ],
    "it": [
      "In questo club troverete le più moderne attrezzature fitness Matrix accessibili a tutti, un team di istruttori dinamici, allenatori privati e numerosi corsi di gruppo! Scoprite un'atmosfera familiare e amichevole."
    ],
    "fr": [
      "Vous trouverez dans ce club des appareils de fitness Matrix dernier cri et accessibles à tous, une équipe de professeurs dynamiques, des coachs particuliers ainsi que de nombreux cours collectifs ! Découvrez une ambiance familiale et conviviale."
    ],
    "nl": [
      "In deze club vindt u de nieuwste Matrix fitnessapparatuur die voor iedereen toegankelijk is, een team van dynamische instructeurs, privécoaches en talrijke groepslessen! Ontdek een familiale en vriendelijke sfeer."
    ],
    "es": [
      "En este club encontrará los últimos equipos de fitness Matrix accesibles para todos, un equipo de instructores dinámicos, entrenadores privados y numerosas clases en grupo Descubra un ambiente familiar y acogedor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'appart fitness"
    ]
  },
