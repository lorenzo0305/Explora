  "rdfs:comment": {
    "de": [
      "Nach der Gedichtsammlung von Millie Rosier.\r\nLesung: Marie-Paule Kervennic, Guy Chauvet und Véronique Spitz.\r\nDiese drei Schauspieler der Compagnie Les Javeysans haben sich auf Initiative von Véronique Spitz für dieses besondere Projekt engagiert."
    ],
    "en": [
      "Based on the collection of poems by Millie Rosier.\r\nRead by Marie-Paule Kervennic, Guy Chauvet and Véronique Spitz.\r\nThese three actors from Compagnie Les Javeysans took on this particular project at the initiative of Véronique Spitz."
    ],
    "it": [
      "Basato sulla raccolta di poesie di Millie Rosier.\r\nLetto da Marie-Paule Kervennic, Guy Chauvet e Véronique Spitz.\r\nQuesti tre attori della Compagnie Les Javeysans hanno intrapreso questo progetto speciale su iniziativa di Véronique Spitz."
    ],
    "fr": [
      "D’après le recueil de poèmes de Millie Rosier. \r\nLecture : Marie-Paule Kervennic, Guy Chauvet et Véronique Spitz. \r\nCes trois comédiens de la Compagnie Les Javeysans se sont engagés dans ce projet particulier à l’initiative de Véronique Spitz."
    ],
    "nl": [
      "Gebaseerd op de gedichtenbundel van Millie Rosier.\r\nVoorgelezen door Marie-Paule Kervennic, Guy Chauvet en Véronique Spitz.\r\nDeze drie acteurs van de Compagnie Les Javeysans namen dit bijzondere project aan op initiatief van Véronique Spitz."
    ],
    "es": [
      "Basado en el poemario de Millie Rosier.\r\nLeído por Marie-Paule Kervennic, Guy Chauvet y Véronique Spitz.\r\nEstos tres actores de la Compagnie Les Javeysans emprendieron este proyecto especial por iniciativa de Véronique Spitz."
    ]
  },
  "rdfs:label": {
    "fr": [
