  "rdfs:comment": {
    "de": [
      "Maud Bonnet arbeitet mit Textilien, Pflanzen, Objekten ... Als Sammlerin von Geschichten und Erinnerungen kreiert und komponiert sie Kleidungsskulpturen, Silhouetten, Objekte ... mit den Erinnerungen eines jeden. Sie bietet auch Workshops an."
    ],
    "en": [
      "Maud Bonnet works with textiles, plants and objects... A collector of stories and memories, she creates and composes sculptural garments, silhouettes and objects... to suit everyone's memories. She also offers workshops."
    ],
    "it": [
      "Maud Bonnet lavora con tessuti, piante e oggetti. Collezionista di storie e ricordi, crea e compone abiti scultorei, silhouette e oggetti basati sui ricordi di ogni individuo. Offre anche laboratori."
    ],
    "fr": [
      "Maud Bonnet travaille les textiles, végétaux, objets ...Récupératrice ,d'histoires et de souvenirs, elle crée et compose des vétements sculptures, silhouettes, objets...aux souvenirs de chacun. Elle propose également des ateliers."
    ],
    "nl": [
      "Maud Bonnet werkt met textiel, planten en objecten. Als verzamelaar van verhalen en herinneringen creëert en componeert ze sculpturale kledingstukken, silhouetten en objecten gebaseerd op de herinneringen van elk individu. Ze biedt ook workshops aan."
    ],
    "es": [
      "Maud Bonnet trabaja con tejidos, plantas y objetos. Coleccionista de historias y recuerdos, crea y compone prendas escultóricas, siluetas y objetos basados en los recuerdos de cada individuo. También ofrece talleres."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maud Bonnet - Artiste plasticienne, scénographe et graphiste"
    ]
  },
