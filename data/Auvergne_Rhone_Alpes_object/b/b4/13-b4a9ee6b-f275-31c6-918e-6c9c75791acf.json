  "rdfs:comment": {
    "de": [
      "Zwischen Landhausstil, Holz und Stein, Traditionen und Erinnerungen, ein gemütlicher und geselliger Ort, an dem Sie eine traditionelle, hausgemachte Küche genießen können."
    ],
    "en": [
      "Between chic country decor, wood and stone, traditions and memories, a warm and friendly place to enjoy traditional homemade cuisine."
    ],
    "it": [
      "Un luogo caldo e accogliente dove gustare la tradizionale cucina casalinga in un ambiente di campagna chic, legno e pietra, tradizioni e ricordi."
    ],
    "fr": [
      "Entre décor campagne chic, bois et pierre, traditions et souvenirs, lieu chaleureux et convivial propice à déguster une cuisine traditionnelle faite maison."
    ],
    "es": [
      "Un lugar cálido y acogedor donde se puede disfrutar de la cocina casera tradicional en un entorno campestre elegante, madera y piedra, tradiciones y recuerdos."
    ],
    "nl": [
      "Een warme en vriendelijke plek waar u kunt genieten van traditionele huisgemaakte gerechten in een chique landelijke omgeving, hout en steen, tradities en herinneringen."
    ]
  },
  "rdfs:label": {
