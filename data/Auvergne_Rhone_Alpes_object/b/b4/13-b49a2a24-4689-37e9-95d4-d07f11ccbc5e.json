  "rdfs:comment": {
    "de": [
      "In den Straßen von Corps erwartet Sie eine Schnitzeljagd zum Thema Napoleon! Er ermöglicht es Ihnen, Napoleons Ankunft im Dorf auf spielerische Weise nachzuvollziehen."
    ],
    "en": [
      "A Napoleon-themed treasure hunt awaits you in the streets of Corps! It will allow you to retrace Napoleon's arrival in the village in a fun way."
    ],
    "it": [
      "Una caccia al tesoro a tema napoleonico vi aspetta per le strade di Corps! È un modo divertente per ripercorrere la visita di Napoleone al villaggio."
    ],
    "fr": [
      "Un jeu de piste sur le thème Napoléon vous attend dans les rues de Corps ! Il vous permettra de retracer la venue de Napoléon dans le village de façon ludique."
    ],
    "es": [
      "Una búsqueda del tesoro de temática napoleónica le espera en las calles de Corps Es una forma divertida de rememorar la visita de Napoleón al pueblo."
    ],
    "nl": [
      "In de straten van Corps ligt een speurtocht met Napoleonthema op je te wachten! Het is een leuke manier om Napoleons bezoek aan het dorp te herbeleven."
    ]
  },
  "rdfs:label": {
