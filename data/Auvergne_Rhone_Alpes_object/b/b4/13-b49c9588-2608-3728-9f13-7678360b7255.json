  "rdfs:comment": {
    "de": [
      "Restaurant mit atypischem Rahmen am Ufer des Lac du Bourget. Mehr als ein Restaurant, eine Kuriosität, Mahlzeit im Rhythmus des Gesangs der Uhren \"Kuckuck\"!"
    ],
    "en": [
      "A restaurant in an atypical setting on the Lac du Bourget. More than a restaurant, it's a curiosity, with your meal punctuated by the clocks chiming \"cuckoo\"!"
    ],
    "it": [
      "Ristorante immerso in una cornice atipica in riva al lago del Bourget. Più di un ristorante, una curiosità. Pasti ritmati dal canto degli orologi a cucù!"
    ],
    "fr": [
      "Restaurant au cadre atypique au bord du lac du Bourget. Plus qu'un restaurant, une curiosité, repas rythmé par le chant des horloges \"coucou\" !"
    ],
    "es": [
      "Restaurante en un entorno atípico a orillas del lago Bourget. Más que un restaurante, una curiosidad, una comida puntuada por el canto de los relojes \"cucú\""
    ],
    "nl": [
      "Restaurant in een atypische omgeving aan de oevers van het meer van Bourget. Meer dan een restaurant, een curiositeit, een maaltijd onderbroken door het lied van de \"koekoeksklokken\"!"
    ]
  },
