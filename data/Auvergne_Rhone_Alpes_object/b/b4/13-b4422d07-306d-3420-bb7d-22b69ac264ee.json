  "rdfs:comment": {
    "de": [
      "Das Bistrot de Serine serviert raffinierte regionale Gerichte aus sorgfältig verarbeiteten Produkten. Die ausgewogenen Geschmackskombinationen sind dabei perfekt auf die guten regionalen Weine von der Karte abgestimmt."
    ],
    "en": [
      "The Bistrot à Vin de Serine is a restaurant, wine bar and cellar serving local dishes with original flavours. There are over 400 wines to choose from on the wine menu, and you can get tips about food and wine matches."
    ],
    "it": [
      "Il bistrot de Serine offre un servizio di enoteca che valorizza la produzione regionale e in particolare le AOC Côte-Rôtie, Condrieu e Saint-Joseph. Fate la vostra scelta tra le 400 referenze del nostro libro di cantina."
    ],
    "fr": [
      "Le bistrot de Serine vous propose un service de bars à vins qui met à l'honneur la production régionale et en particulier les AOC Côte-Rôtie, Condrieu et Saint-Joseph. Faîtes votre choix parmi 400 références sur notre livre de cave."
    ],
    "es": [
      "Le bistrot de Serine le ofrece un servicio de bar de vinos que honra la producción regional y, en particular, la AOC Côte-Rôtie, Condrieu y Saint-Joseph. Haga su elección entre las 400 referencias de nuestro libro de bodega."
    ],
    "nl": [
      "Le bistrot de Serine biedt u een wijnbar service die de regionale productie eert en in het bijzonder de AOC Côte-Rôtie, Condrieu en Saint-Joseph. Maak uw keuze uit de 400 referenties in ons kelderboek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bar à vin du Bistrot de Serine"
    ]
  },
