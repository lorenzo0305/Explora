  "rdfs:comment": {
    "de": [
      "Dorf Saint-Haon: Romanische Kirche mit Kammglockenturm und polychromem Kopfende, skulptierte Modillons. Kapelle in Le Cros. Kapelle Saint-Médard mit Sarkophagen. Ruinen des Schlosses von Rochefort aus dem 16. Jahrhundert (privat). Überreste des Château du Thord (privat)."
    ],
    "en": [
      "Village of Saint-Haon: Romanesque church with combed bell tower, polychrome chevet and sculpted modillions. Le Cros chapel. Chapel of Saint-Médard with sarcophagi. Ruins of the 16th-century Château de Rochefort (private). Remains of Château du Thord (private)."
    ],
    "it": [
      "Villaggio di Saint-Haon: chiesa romanica con campanile a pettine e chevet policromo, modiglioni scolpiti. Cappella di Cros. Cappella di Saint-Médard con sarcofagi. Rovine del castello di Rochefort del XVI secolo (privato). Resti dello Château du Thord (privato)."
    ],
    "fr": [
      "Village de Saint-Haon : Église romane à clocher peigne avec chevet polychrome, modillons sculptés. Chapelle au Cros. Chapelle de Saint-Médard avec sarcophages. Ruines du château de Rochefort du XVIe siècle (privé). Vestiges du Château du Thord (privé)."
    ],
    "es": [
      "Pueblo de Saint-Haon: iglesia románica con campanario peinado y caballete policromado, modillones esculpidos. Capilla de Cros. Capilla de Saint-Médard con sarcófagos. Ruinas del castillo de Rochefort del siglo XVI (privado). Restos del castillo de Thord (privado)."
    ],
    "nl": [
      "Dorp Saint-Haon: Romaanse kerk met gekamde klokkentoren en polychroom chevet, gebeeldhouwde modillions. Kapel van Cros. Kapel van Saint-Médard met sarcofagen. Ruïnes van het 16e eeuwse kasteel van Rochefort (privé). Overblijfselen van het Château du Thord (privé)."
    ]
  },
  "rdfs:label": {
