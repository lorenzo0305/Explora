  "rdfs:comment": {
    "de": [
      "Restaurant - Feinkostgeschäft. Véronique und Jean Jacques Mirzoian empfangen Sie in ihrem klimatisierten Lokal für Hochzeitsfeiern, Geburtstage, Taufen, Familienessen, Weihnachtsbäume, Themenabende etc. Crêpes, Fleisch, Fisch, Desserts."
    ],
    "en": [
      "Restaurant - caterer. Véronique and Jean Jacques Mirzoian receive in their air-conditioned establishment, for wedding ceremonies, birthdays, baptisms, family meals, Christmas trees, theme evenings, etc. Pancakes, meat, fish, desserts."
    ],
    "it": [
      "Ristorante - catering. Véronique e Jean Jacques Mirzoian ricevono gli ospiti nella loro struttura climatizzata per cerimonie nuziali, compleanni, battesimi, pranzi di famiglia, alberi di Natale, serate a tema, ecc. Crepes, carne, pesce, dessert."
    ],
    "fr": [
      "Restaurant - traiteur. Véronique et Jean Jacques Mirzoian reçoivent dans leur établissement climatisé, pour des cérémonies de mariage, anniversaire, baptême, repas de famille, arbres de noël, soirées à thème, etc. Crèpes, viandes, poissons, desserts."
    ],
    "es": [
      "Restaurante - catering. Véronique y Jean Jacques Mirzoian reciben a los invitados en su establecimiento climatizado para ceremonias de boda, cumpleaños, bautizos, comidas familiares, árboles de Navidad, veladas temáticas, etc. Crepes, carne, pescado, postres."
    ],
    "nl": [
      "Restaurant - cateraar. Véronique en Jean Jacques Mirzoian ontvangen gasten in hun geklimatiseerde etablissement voor huwelijksceremonies, verjaardagen, doopfeesten, familiediners, kerstbomen, thema-avonden, enz. Pannenkoeken, vlees, vis, desserts."
    ]
  },
