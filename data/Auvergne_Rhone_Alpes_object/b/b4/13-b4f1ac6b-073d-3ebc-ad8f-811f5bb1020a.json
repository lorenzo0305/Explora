  "rdfs:comment": {
    "de": [
      "Das familiengeführte Restaurant Le Trainô im Herzen des Ortes empfängt Sie in einer freundlichen Atmosphäre, in der Sie eine traditionelle und großzügige Küche genießen können, die von einer gemütlichen Bar begleitet wird."
    ],
    "en": [
      "Family restaurant in the heart of the resort, Le Trainô welcomes you in a friendly atmosphere to enjoy traditional and generous cuisine, along with a warm and inviting bar."
    ],
    "it": [
      "Ristorante familiare nel cuore della località, Le Trainô vi accoglie in un'atmosfera amichevole per gustare una cucina generosa e tradizionale, accompagnata da un accogliente bar."
    ],
    "fr": [
      "Restaurant familial au cœur de la station, Le Trainô vous accueille dans une ambiance conviviale pour savourer une cuisine traditionnelle et généreuse, accompagnée d’un bar chaleureux."
    ],
    "es": [
      "Restaurante familiar en el corazón de la estación, Le Trainô le acoge en un ambiente acogedor para disfrutar de una cocina generosa y tradicional, acompañada de un bar acogedor."
    ],
    "nl": [
      "Gezinsrestaurant in het hart van het resort, Le Trainô heet u welkom in een gezellige sfeer om te genieten van traditionele en royale gerechten, vergezeld van een warme en uitnodigende bar."
    ]
  },
