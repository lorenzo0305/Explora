  "rdfs:comment": {
    "de": [
      "Das 1965 gegründete Le Chardon d'Écosse ist hier eine Institution. Mit seinem unvergesslichen schottischen Teppich behält jeder eine eingravierte Erinnerung an diesen Tempel der Nacht in Annécienne!"
    ],
    "en": [
      "Created in 1965, the Chardon d'Écosse is a local institution. With its unforgettable tartan carpeting, this temple to the Annécian nightlife has a special place in everyone's memory!"
    ],
    "it": [
      "Creato nel 1965, lo Chardon d'Écosse è un'istituzione locale. Con il suo indimenticabile tappeto tartan, tutti avranno un bel ricordo di questo tempio della vita notturna annese!"
    ],
    "fr": [
      "Créé en 1965, le Chardon d’Écosse, c'est une institution ici. Avec son inoubliable moquette écossaise, tout le monde garde un souvenir gravé de ce temple de la nuit annécienne !"
    ],
    "nl": [
      "De Chardon d'Écosse, opgericht in 1965, is een plaatselijke instelling. Met zijn onvergetelijke ruitjesvloer zal iedereen dierbare herinneringen hebben aan deze tempel van het Annéciaanse nachtleven!"
    ],
    "es": [
      "Creado en 1965, el Chardon d'Écosse es una institución local. Con su inolvidable alfombra de tartán, ¡todo el mundo guardará un grato recuerdo de este templo de la vida nocturna anneciana!"
    ]
  },
