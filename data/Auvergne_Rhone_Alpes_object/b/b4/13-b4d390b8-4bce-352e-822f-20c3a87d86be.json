  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes Sauxillanges bieten wir Ihnen traditionelle Küche und Tagesgerichte unter der Woche, Pizza an den Wochenendabenden und im Juli/August mittwochs die Braseros. Kommen Sie und teilen Sie einen geselligen Moment mit unserem Team."
    ],
    "en": [
      "In the heart of the village of Sauxillanges, we offer traditional cuisine and daily specials during the week, pizzas on weekend evenings, and braziers on Wednesdays in July and August. Come and share a moment of conviviality with our team."
    ],
    "it": [
      "Nel cuore del villaggio di Sauxillanges, proponiamo una cucina tradizionale e specialità del giorno durante la settimana, pizze nei fine settimana e bracieri il mercoledì in luglio e agosto. Venite a condividere un momento di convivialità con il nostro team."
    ],
    "fr": [
      "Au cœur du village de Sauxillanges, nous proposons une cuisine traditionnelle, et des plats du jour en semaine, des pizzas les soirs de fin de semaine, les braseros le mercredi en juillet/août. Venez partager un moment de convivialité avec notre équipe."
    ],
    "nl": [
      "In het hart van het dorp Sauxillanges bieden we een traditionele keuken en dagschotels tijdens de week, pizza's tijdens de weekendavonden en braziers op woensdagen in juli en augustus. Kom en deel een moment van gezelligheid met ons team."
    ],
    "es": [
      "En el corazón del pueblo de Sauxillanges, ofrecemos cocina tradicional y platos del día durante la semana, pizzas los fines de semana por la noche y braseros los miércoles de julio y agosto. Venga a compartir un momento de convivencia con nuestro equipo."
    ]
  },
  "rdfs:label": {
