  "rdfs:comment": {
    "de": [
      "Praktikum Glasmalerei im Atelier...\r\nIn einer zweistündigen Sitzung (oder mehr, je nach Praktikum) behandeln wir alle Schritte, um ein Glasobjekt mit der Tiffany-Methode herzustellen.\r\nFür Erwachsene und Kinder ab 10 Jahren.\r\nGeschlossene Schuhe erforderlich."
    ],
    "en": [
      "Stained glass workshop...\r\nIn a 2-hour session (or more depending on the course), we will cover all the steps to make a glass object with the Tiffany method.\r\nFor adults and children from 10 years.\r\nClosed shoes required."
    ],
    "it": [
      "Laboratorio di vetrate...\r\nDurante una sessione di 2 ore (o più, a seconda del workshop), verranno illustrate tutte le fasi di realizzazione di un oggetto in vetro con il metodo Tiffany.\r\nPer adulti e bambini a partire da 10 anni.\r\nSono richieste scarpe chiuse."
    ],
    "fr": [
      "Stage vitrail à l'atelier...\r\nLors d'une séance de 2 heures (ou plus selon le stage), nous aborderons toutes les étapes pour réaliser un objet en verre avec la méthode Tiffany.\r\nPour adultes et enfants à partir de 10 ans.\r\nChaussures fermées obligatoire."
    ],
    "es": [
      "Taller de vidrieras...\r\nDurante una sesión de 2 horas (o más según el taller), recorreremos todos los pasos para realizar un objeto de vidrio con el método Tiffany.\r\nPara adultos y niños a partir de 10 años.\r\nSe requiere calzado cerrado."
    ],
    "nl": [
      "Glas-in-lood atelier...\r\nTijdens een sessie van 2 uur (of meer, afhankelijk van de workshop) doorlopen we alle stappen om een glasobject te maken volgens de Tiffany-methode.\r\nVoor volwassenen en kinderen vanaf 10 jaar.\r\nGesloten schoenen verplicht."
    ]
  },
  "rdfs:label": {
    "en": [
      "Couleur & Transparence - Stained glass"
    ],
    "fr": [
      "Couleur & Transparence - Vitrail"
    ]
  },
