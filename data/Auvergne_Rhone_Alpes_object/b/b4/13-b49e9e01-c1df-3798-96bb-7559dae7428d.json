  "rdfs:comment": {
    "de": [
      "3 Tennisplätze neben dem städtischen Campingplatz \"Les Tilleuls\" und \"Pétanclos\". Zugang von der Avenue de la gare aus.\r\nUm zu reservieren, rufen Sie einfach an oder gehen Sie zum Tabac-Presse Maran, um Ihr Zeitfenster zu reservieren und die Schlüssel abzuholen."
    ],
    "en": [
      "3 tennis courts next to the Tilleuls and Pétanclos municipal campsites. Access from avenue de la gare.\r\nTo book, simply phone or visit Tabac-Presse Maran to reserve your time and collect the keys."
    ],
    "it": [
      "3 campi da tennis situati accanto ai campeggi comunali di Tilleuls e Pétanclos. Accesso da avenue de la gare.\r\nPer prenotare, è sufficiente telefonare o recarsi al Tabac-Presse Maran per prenotare e ritirare le chiavi."
    ],
    "fr": [
      "3 cours de tennis situés à côté du camping municipal des Tilleuls et du Pétanclos. Accès depuis l'avenue de la gare.\r\nPour réserver, il suffit de téléphoner ou de vous rendre au Tabac-Presse Maran pour réserver votre plage horaire et récupérer les clés."
    ],
    "nl": [
      "3 tennisbanen naast de campings van de gemeente Tilleuls en Pétanclos. Toegang vanaf de avenue de la gare.\r\nOm te reserveren, bel of bezoek je Tabac-Presse Maran om je tijd te reserveren en de sleutels af te halen."
    ],
    "es": [
      "3 pistas de tenis situadas junto a los campings municipales de Tilleuls y Pétanclos. Acceso por la avenue de la gare.\r\nPara reservar, sólo tiene que llamar por teléfono o acudir al Tabac-Presse Maran para reservar su hora y recoger las llaves."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Courts de tennis"
    ]
  },
