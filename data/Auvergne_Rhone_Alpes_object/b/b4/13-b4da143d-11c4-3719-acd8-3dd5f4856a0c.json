  "rdfs:comment": {
    "de": [
      "In einer freundlichen Atmosphäre empfangen Sie Emeric und das gesamte Team wie zu Hause, zwischen Lachen, Teilen und authentischen Geschmäckern."
    ],
    "en": [
      "In the friendly atmosphere, Christine and Patrick will give you a warm welcome. Try the homemade dishes, created by the chef, Jean-Pierre. Specialities: frogs legs, please order in advance."
    ],
    "it": [
      "In un'atmosfera amichevole, Emeric e tutto il team vi accolgono come se foste a casa vostra, tra risate, condivisione e sapori autentici."
    ],
    "fr": [
      "Dans une ambiance conviviale, Emeric et toute l'équipe vous accueillent comme à la maison, entre rires, partage et saveurs authentiques."
    ],
    "nl": [
      "In een vriendelijke sfeer verwelkomen Emeric en het hele team je alsof je thuis bent, met lachen, delen en authentieke smaken."
    ],
    "es": [
      "En un ambiente acogedor, Emeric y todo el equipo le dan la bienvenida como si estuviera en casa, entre risas, compartiendo y sabores auténticos."
    ]
  },
  "rdfs:label": {
