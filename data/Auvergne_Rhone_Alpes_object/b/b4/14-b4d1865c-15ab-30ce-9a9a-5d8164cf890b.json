  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b7e4b7f9-cc62-3d2a-a490-97b1a198fb0a",
      "dc:description": {
        "de": [
          "Als Liebhaber unserer regionalen Küche und der Schmorgerichte unserer Großmütter hat dieses Restaurant die Atmosphäre der Speisesäle von früher wiederbelebt, ein Ort der familiären Geselligkeit, wo gutes Essen das Schlüsselwort ist."
        ],
        "en": [
          "In love with our regional cuisine and the simmered dishes of our grandmothers, this restaurant has recreated the atmosphere of the dining rooms of yesteryear, a place of family conviviality where good food is the key word."
        ],
        "it": [
          "Innamorato della nostra cucina regionale e dei piatti cucinati dalle nostre nonne, questo ristorante ha ricreato l'atmosfera delle sale da pranzo di un tempo, un luogo di convivialità familiare dove la buona cucina è la parola d'ordine."
        ],
        "fr": [
          "Amoureux de notre cuisine régionale et des plats mijotés de nos grands-mères, ce restaurant a recréé l'ambiance des salles à manger d'antan, lieu de convivialité familiale où la bonne chère est maître mot."
        ],
        "nl": [
          "Verliefd op onze regionale keuken en de gerechten van onze grootmoeders, heeft dit restaurant de sfeer van de eetzalen van weleer herschapen, een plek van familiale gezelligheid waar lekker eten het sleutelwoord is."
        ],
        "es": [
          "Enamorado de nuestra cocina regional y de los platos cocinados por nuestras abuelas, este restaurante ha recreado el ambiente de los comedores de antaño, un lugar de convivencia familiar donde la buena comida es la palabra clave."
        ]
      },
      "@type": [
        "Description"
      ],
