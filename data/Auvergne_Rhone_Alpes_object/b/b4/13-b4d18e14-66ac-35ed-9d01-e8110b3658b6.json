  "rdfs:comment": {
    "de": [
      "Sport Nature Ardèche ist auf Aktivitäten in der freien Natur und die Entdeckung der natürlichen Lebensräume rund um die Schluchten der Ardèche, der Cèze und anderswo spezialisiert..."
    ],
    "en": [
      "Sport Nature Ardèche specializes in outdoor activities and the discovery of natural environments around the Ardèche and Cèze gorges and elsewhere..."
    ],
    "it": [
      "Sport Nature Ardèche è specializzato in attività all'aria aperta e nella scoperta dell'ambiente naturale intorno alle gole dell'Ardèche e della Cèze e altrove..."
    ],
    "fr": [
      "Sport Nature Ardèche est spécialisé dans les activités de pleine nature et la découverte des milieux naturels autour des gorges de l'Ardèche, de la Cèze et ailleurs..."
    ],
    "nl": [
      "Sport Nature Ardèche is gespecialiseerd in buitenactiviteiten en het ontdekken van de natuur rond de Gorges de l'Ardèche en de Cèze en elders..."
    ],
    "es": [
      "Sport Nature Ardèche está especializada en actividades al aire libre y en el descubrimiento del entorno natural de las gargantas de Ardèche y Cèze y de otros lugares..."
    ]
  },
