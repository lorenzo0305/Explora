  "rdfs:comment": {
    "de": [
      "2-Stern-Hotel-Restaurant, 2 Min. vom Zentrum von Aubenas und 5 Min. vom Thermalbad Vals-les-Bains entfernt. Herberge mit allem Komfort: Dusche, Waschbecken, Föhn, WC, LCD-Fernseher, Klimaanlage, kostenloser WLAN-Zugang. Busparkplatz auf Reservierung. Garage für Motorräder."
    ],
    "en": [
      "2-stars hotel and restaurant, 2 minutes from the centre of Aubenas and 5 minutes from the Vals-les-Bains spa. Comfortable hostel: shower, washbasin, hairdryer, WC, LCD TV, air conditioning, free Wi-Fi. Coach parking by prior arrangement. Motorbike garage."
    ],
    "it": [
      "Hotel e ristorante a 2 stelle, a 2 minuti dal centro di Aubenas e a 5 minuti dalle terme di Vals-les-Bains. Ostello confortevole: doccia, lavabo, asciugacapelli, WC, TV LCD, aria condizionata, Wi-Fi gratuito. Parcheggio per pullman su prenotazione. Garage per moto e biciclette."
    ],
    "fr": [
      "Hôtel Restaurant 2 étoiles, à 2 min du centre d'Aubenas et 5 min de la station thermale de Vals-les-Bains. Auberge tout confort : douche, lavabo, sèche-cheveux, WC, TV LCD, Climatisation, Wifi gratuit. Parking autocar sur réservation. Garage motos & Vélo."
    ],
    "es": [
      "Hotel de 2 estrellas y restaurante, a 2 minutos del centro de Aubenas y a 5 minutos del balneario de Vals-les-Bains. Albergue confortable: ducha, lavabo, secador de pelo, WC, TV LCD, aire acondicionado, Wi-Fi gratuito. Aparcamiento para autocares con reserva previa. Garaje para motos y bicicletas."
    ],
    "nl": [
      "2-sterrenhotel en restaurant, op 2 minuten van het centrum van Aubenas en op 5 minuten van het kuuroord Vals-les-Bains. Comfortabele herberg: douche, wastafel, haardroger, wc, lcd-tv, airconditioning, gratis wifi. Parkeerplaats voor bussen op afspraak. Garage voor motoren."
    ]
  },
