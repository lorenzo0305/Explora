  "rdfs:comment": {
    "de": [
      "Spezialitäten der französischen Übersee-Inseln, eine Mischküche, die Gewürze und exotische Produkte miteinander verbindet. Farbenfrohe Küche, die reich an Geschmack und Duft ist."
    ],
    "en": [
      "Specialities from the French Overseas Islands, a mixed cuisine that combines spices and exotic products. Colourful cuisine rich in taste and aroma."
    ],
    "it": [
      "Specialità delle isole francesi d'oltremare, una cucina mista che combina spezie e prodotti esotici. Una cucina colorata e ricca di sapori e profumi."
    ],
    "fr": [
      "Spécialités des Iles Françaises d'Outre-mer, une cuisine métissée qui associe les épices et les produits exotiques. Cuisine colorée riche en goût et en parfum."
    ],
    "nl": [
      "Specialiteiten van de Franse Overzeese Eilanden, een gemengde keuken die kruiden en exotische producten combineert. Kleurrijke keuken rijk aan smaak en geur."
    ],
    "es": [
      "Especialidades de las Islas Francesas de Ultramar, una cocina mixta que combina especias y productos exóticos. Una cocina colorida y rica en sabores y fragancias."
    ]
  },
