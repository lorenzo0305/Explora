  "rdfs:comment": {
    "de": [
      "Tagsüber und abends können Sie im Coup de Pompe in der Sonne entspannen.\r\nSchnellrestaurants am Mittag und Tapas/Platten zum Teilen am Abend.\r\nDurchgehend Cocktails, Eis, Smoothies und Waffeln.\r\nAlles hausgemacht aus lokalen und regionalen Produkten."
    ],
    "en": [
      "At any time of the day, you can grab a bite at Au Coup de Pompe. You'll find on our menu: sandwiches, toasts, \"Apéro\" appetizers trail, ice creams and special Tapas or Apéro evenings.\r\nOur dishes are made with local or regional products."
    ],
    "it": [
      "Durante il giorno e la sera, rilassatevi al sole presso Au Coup de Pompe.\r\nFast food a pranzo e tapas/tavoli da condividere la sera.\r\nCocktail continui, gelati, frullati e cialde.\r\nTutto fatto in casa con prodotti locali e regionali."
    ],
    "fr": [
      "En journée comme en soirée, détente ensoleillée Au Coup de Pompe.\r\nRestauration rapide le midi et tapas/planches à partager le soir. \r\nCocktails, glaces, smoothies, gaufres en continu.\r\nLe tout, fait maison avec des produits locaux et régionaux."
    ],
    "nl": [
      "Ontspan overdag en 's avonds in de zon bij Au Coup de Pompe.\r\nFast food 's middags en tapas/planken om te delen 's avonds.\r\nContinu cocktails, ijsjes, smoothies en wafels.\r\nAllemaal huisgemaakt met lokale en regionale producten."
    ],
    "es": [
      "Durante el día y por la noche, relájese al sol en Au Coup de Pompe.\r\nComida rápida al mediodía y tapas/tapas para compartir por la noche.\r\nCócteles continuos, helados, batidos y gofres.\r\nTodo casero con productos locales y regionales."
    ]
  },
  "rdfs:label": {
    "en": [
      "Au coup de pompe"
    ],
    "fr": [
      "Snack-Bar : Au coup de pompe"
    ]
  },
