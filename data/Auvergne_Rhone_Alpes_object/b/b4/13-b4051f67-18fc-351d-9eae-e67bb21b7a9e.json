  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes der Trödler stehen hier immer gute saisonale Gerichte auf dem Speiseplan, inmitten von Fotoausstellungen, Gemäldeausstellungen, Taschenkonzerten, Aufführungen... Gutes und Schönes!"
    ],
    "en": [
      "In the heart of the Brocanteurs Village, seasonal delicacies are always on the menu, along with photo and painting exhibitions, pocket concerts and shows... All good stuff!"
    ],
    "it": [
      "Nel cuore del Villaggio dei Brocanteurs, le prelibatezze di stagione sono sempre presenti nel menu, insieme a mostre fotografiche e di pittura, concerti e spettacoli tascabili... È tutto un divertimento!"
    ],
    "fr": [
      "Au cœur du Village des Brocanteurs, les bons petits plats de saison sont ici toujours au menu au milieu d'expos photos, peintures, des concerts de poches, des spectacles... Du bon et du beau !"
    ],
    "nl": [
      "In het hart van het Brocanteursdorp staan seizoensgebonden lekkernijen altijd op het menu, samen met foto- en schilderijententoonstellingen, zakconcerten en shows... Allemaal leuk en aardig!"
    ],
    "es": [
      "En el corazón del pueblo de los Brocanteurs, no faltan las delicias de temporada, las exposiciones de fotografía y pintura, los conciertos de bolsillo, los espectáculos... Todo es diversión"
    ]
  },
  "rdfs:label": {
    "en": [
