  "rdfs:comment": {
    "de": [
      "Genießen Sie eine Einführung in die Ausstellung durch einen Mediator, bevor Sie frei herumlaufen und die Natur und das Leben der Palawan durch die Augen des Fotografen Pierre de Vallombreuse entdecken."
    ],
    "en": [
      "Enjoy an introduction to the exhibition by a mediator, before wandering freely to discover the nature and life of the Palawan people through the eyes of photographer Pierre de Vallombreuse."
    ],
    "it": [
      "Godetevi un'introduzione alla mostra da parte di un interprete prima di vagare liberamente alla scoperta della natura e della vita del popolo di Palawan attraverso gli occhi del fotografo Pierre de Vallombreuse."
    ],
    "fr": [
      "Profitez d’une introduction à l’exposition par un médiateur avant de déambuler librement à la découverte de la nature et de la vie des Palawan à travers le regard du photographe Pierre de Vallombreuse."
    ],
    "nl": [
      "Geniet van een inleiding op de tentoonstelling door een tolk voordat je vrij rondloopt om de natuur en het leven van de Palawan-bevolking te ontdekken door de ogen van fotograaf Pierre de Vallombreuse."
    ],
    "es": [
      "Disfrute de una introducción a la exposición a cargo de un intérprete antes de deambular libremente para descubrir la naturaleza y la vida de los palawanos a través de los ojos del fotógrafo Pierre de Vallombreuse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Visite éclairage de l'exposition \"Les temps modernes. Palawan, Philippines\""
    ]
  },
