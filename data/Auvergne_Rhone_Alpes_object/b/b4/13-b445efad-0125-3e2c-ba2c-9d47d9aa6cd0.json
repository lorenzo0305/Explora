  "rdfs:comment": {
    "de": [
      "Wettbewerb für alle, auch für Anfänger, mit den Archers du Vivarais-Lignon. Bögen und Pfeile werden gestellt. Kategorien: Kinder 8-15 Jahre Erwachsene ab 16 Jahren. Anmeldung 9h-15h."
    ],
    "en": [
      "Competition open to all, even beginners, with Les Archers du Vivarais-Lignon. Bows and arrows provided. Categories: children aged 8-15, adults aged 16 and over. Registration 9am-3pm."
    ],
    "it": [
      "Gara aperta a tutti, anche ai principianti, con gli Arcieri del Vivarais-Lignon. Archi e frecce forniti. Categorie: bambini dagli 8 ai 15 anni, adulti dai 16 anni in su. Iscrizioni dalle 9.00 alle 15.00."
    ],
    "fr": [
      "Concours ouvert à tous même débutant avec les Archers du Vivarais-Lignon. Arcs, flèches fournis. Catégories : enfant 8-15 ans adulte dès 16 ans. Inscriptions 9h-15h."
    ],
    "nl": [
      "Wedstrijd voor iedereen, zelfs beginners, met de boogschutters van Vivarais-Lignon. Bogen en pijlen aanwezig. Categorieën: kinderen van 8-15 jaar, volwassenen van 16 jaar en ouder. Registratie van 9.00 tot 15.00 uur."
    ],
    "es": [
      "Competición abierta a todos, incluso principiantes, con los Arqueros de Vivarais-Lignon. Arcos y flechas proporcionados. Categorías: niños de 8 a 15 años, adultos a partir de 16 años. Inscripciones de 9.00 a 15.00 h."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête de la Flèche du Lignon"
    ]
  },
