  "rdfs:comment": {
    "de": [
      "Der Campus ist eine für alle zugängliche Einrichtung, die dank der Qualität seiner Infrastruktur und seiner Ausstattung dem Empfang von Seminaren, Konferenzen, Schulungen, Kolloquien, Treffen usw. unter den besten Bedingungen gewidmet ist."
    ],
    "en": [
      "The Campus is a facility accessible to all, dedicated to hosting seminars, conferences, training courses, symposia, meetings... in the best possible conditions, thanks to the quality of its infrastructure and equipment."
    ],
    "it": [
      "Il Campus è una struttura accessibile a tutti, dedicata a ospitare seminari, conferenze, corsi di formazione, simposi, riunioni, ecc. nelle migliori condizioni, grazie alla qualità delle sue infrastrutture e attrezzature."
    ],
    "fr": [
      "Le Campus est un équipement accessible à tous, dédié à l’accueil de séminaires, conférences, formations, colloques, rencontres... dans les meilleures conditions, grâce à la qualité de ses infrastructures et de ses équipements."
    ],
    "es": [
      "El Campus es una instalación accesible a todos, dedicada a acoger seminarios, conferencias, cursos de formación, simposios, reuniones, etc. en las mejores condiciones, gracias a la calidad de su infraestructura y equipamiento."
    ],
    "nl": [
      "De Campus is een faciliteit die voor iedereen toegankelijk is en waar seminars, conferenties, trainingen, symposia, vergaderingen, etc. kunnen plaatsvinden in de best mogelijke omstandigheden, dankzij de kwaliteit van de infrastructuur en apparatuur."
    ]
  },
  "rdfs:label": {
