  "rdfs:comment": {
    "de": [
      "Kunsttherapie & persönliche Entwicklung\r\nEine einfühlsame Begleitung, um dank der Kreation voranzukommen.\r\n\r\nAtelier für bildende Kunst\r\nKurse für Jung und Alt: Acrylmalerei, Zeichnen, Aquarell, Pastell, Mosaik, meditatives Zeichnen?\r\nKunsthandwerkliche Kreationen"
    ],
    "en": [
      "Creation of wooden objects. Painting on wood. Lessons, courses, adults and children."
    ],
    "it": [
      "Arteterapia e sviluppo personale\r\nUn supporto sensibile per aiutarvi a progredire attraverso la creazione.\r\n\r\nLaboratorio d'arte\r\nCorsi per tutte le età: pittura acrilica, disegno, acquerello, pastello, mosaico, disegno meditativo?\r\nCreazioni artigianali"
    ],
    "fr": [
      "Art-thérapie & développement personnel\r\nUn accompagnement sensible pour avancer grâce à la création.\r\n\r\nAtelier d’arts plastiques\r\nCours pour petits et grands : peinture acrylique, dessin, aquarelle, pastel, mosaïque, dessin méditatif…\r\nCréations artisanales"
    ],
    "nl": [
      "Kunstzinnige therapie & persoonlijke ontwikkeling\r\nGevoelige ondersteuning om je vooruit te helpen door middel van creatie.\r\n\r\nKunst workshop\r\nLessen voor alle leeftijden: acrylschilderen, tekenen, aquarel, pastel, mozaïek, meditatief tekenen?\r\nAmbachtelijke creaties"
    ],
    "es": [
      "Arteterapia y desarrollo personal\r\nApoyo sensible para ayudarte a avanzar a través de la creación.\r\n\r\nTaller de arte\r\nClases para todas las edades: pintura acrílica, dibujo, acuarela, pastel, mosaico, dibujo meditativo..\r\nCreaciones artesanales"
    ]
  },
  "rdfs:label": {
    "en": [
      "The \" Coquelicot bleu\" (blue poppy)"
    ],
    "fr": [
