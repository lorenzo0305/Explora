  "rdfs:comment": {
    "de": [
      "Alpes in Bike ist der Spezialist für den Verleih von Fahrrädern mit Lieferservice, wo immer Sie wollen! Ob mit Freunden oder der Familie, wir haben eine Auswahl, die für alle Altersgruppen und jedes Niveau geeignet ist."
    ],
    "en": [
      "Alpes in Bike is the mountain bike and VTTAE rental specialist for adults and juniors.\r\nWe'll come to you and deliver wherever you want!"
    ],
    "it": [
      "Alpes in Bike è specializzata nel noleggio di mountain bike e ATV per adulti e ragazzi.\r\nVeniamo da voi e vi consegniamo dove volete!"
    ],
    "fr": [
      "Alpes in Bike est le spécialiste de la location de vélos en livraison où vous le souhaitez ! Entre amis ou en famille, nous disposons d’une gamme adaptée à tous les âges et tous les niveaux."
    ],
    "nl": [
      "Alpes in Bike is de specialist in fietsverhuur, geleverd waar jij maar wilt! Of je nu met vrienden of familie bent, we hebben een assortiment fietsen voor alle leeftijden en niveaus."
    ],
    "es": [
      "Alpes in Bike es el especialista en alquiler de bicicletas, ¡donde tú quieras! Ya sea con amigos o en familia, tenemos una gama de bicicletas para todas las edades y habilidades."
    ]
  },
