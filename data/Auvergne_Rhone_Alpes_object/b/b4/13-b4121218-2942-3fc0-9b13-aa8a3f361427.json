  "rdfs:comment": {
    "de": [
      "Entdecken Sie in Begleitung von Mylène, einer Filzerin, das Vergnügen, mit den Fingerspitzen Ihr erstes Filzquadrat und andere handgefertigte Produkte herzustellen!"
    ],
    "en": [
      "Come and discover the pleasure of making your first felt square and other handicrafts with your fingertips, in the company of felting expert Mylène!"
    ],
    "it": [
      "In compagnia di Mylène, una feltraia, venite a scoprire il piacere di realizzare il vostro primo quadrato di feltro e altri manufatti con la punta delle dita!"
    ],
    "fr": [
      "En compagnie de Mylène, feutrière, venez découvrir le plaisir de fabriquer du bout des doigts votre premier carré de feutre et autre fabrication artisanale !"
    ],
    "nl": [
      "Kom in het gezelschap van Mylène, een viltmaakster, het plezier ontdekken van het maken van je eerste vilten vierkant en andere handwerken met je vingertoppen!"
    ],
    "es": [
      "En compañía de Mylène, artesana del fieltro, venga a descubrir el placer de realizar su primer cuadrado de fieltro y otras manualidades con la punta de los dedos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier : Initiation feutrage de la laine"
    ]
  },
