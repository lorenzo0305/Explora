  "rdfs:comment": {
    "de": [
      "Graine des Bauges ist eine Produktion von Beerenfrüchten und Heilpflanzen im C?ur des Bauges, die zu Fruchtköstlichkeiten, Sirup, Essig und Aperitifs mit Pflanzen verarbeitet werden."
    ],
    "en": [
      "Graine des Bauges produces berries and medicinal plants in the heart of the Bauges region, transformed into fruit delights, syrups, vinegars and herbal aperitifs."
    ],
    "it": [
      "Graine des Bauges produce bacche e piante officinali nel cuore della regione di Bauges, trasformate in delizie di frutta, sciroppi, aceti e aperitivi alle erbe."
    ],
    "fr": [
      "Graine des Bauges, c'est une production de petits fruits et de plantes médicinales dans le Cœur des Bauges transformée en délices de fruits, sirops, vinaigres et apéritifs aux plantes."
    ],
    "nl": [
      "Graine des Bauges produceert bessen en geneeskrachtige planten in het hart van de Bauges, die worden verwerkt tot fruitlekkernijen, siropen, azijn en kruidenaperitieven."
    ],
    "es": [
      "Graine des Bauges produce bayas y plantas medicinales en el corazón de la región de Bauges, transformadas en delicias de frutas, jarabes, vinagres y aperitivos a base de hierbas."
    ]
  },
