  "rdfs:comment": {
    "de": [
      "Verkauf von Sportartikeln.\r\nMaterialverleih, Mountainbikes, VTC, Langzeit- und Kurzzeitverleih, Fahrradreparaturset und Fahrradwerkstatt, Verkauf von Fahrrädern mit Elektrounterstützung, Fahrradanhänger. Möglichkeit eines Rücktransports von Fahrrad und Person (siehe Bedingungen)."
    ],
    "en": [
      "Sports shop. Rental: cross-country skis, Alpine skis, skates, snowshoes, sleds, surfboards, repair service. Rental: mountain bikes, tandems, racing bikes, electric bikes, trailers, baby trailers. Bike transport on request."
    ],
    "it": [
      "Vendita di attrezzature sportive.\r\nNoleggio di attrezzature, mountain bike, VTC, noleggio a lungo e a breve termine, kit di riparazione e officina per biciclette, vendita di biciclette elettriche, rimorchio per biciclette. Servizio di navetta di ritorno per biciclette e persone (vedi condizioni)."
    ],
    "fr": [
      "Vente d'articles de sport. \r\nLocation de matériel, VTT, VTC, location longue et courte durée, kit réparation cycles et atelier cycles, vente de vélos à assistance électrique, remorque vélo. Possibilité de navette retour vélo et personne (voir conditions)."
    ],
    "nl": [
      "Verkoop van sportuitrusting.\r\nVerhuur van materiaal, mountainbikes, VTC, lange- en kortetermijnverhuur, fietsreparatieset en fietswerkplaats, verkoop van elektrische fietsen, fietskar. Pendeldienst voor fietsers en personen (zie voorwaarden)."
    ],
    "es": [
      "Venta de material deportivo.\r\nAlquiler de material, bicicletas de montaña, VTC, alquiler de larga y corta duración, kit de reparación de bicicletas y taller de bicicletas, venta de bicicletas de asistencia eléctrica, remolque para bicicletas. Servicio de transporte de ida y vuelta para bicicletas y personas (consulte las condiciones)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Intersport"
    ],
