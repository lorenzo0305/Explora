  "rdfs:comment": {
    "de": [
      "Traditionelle und raffinierte Küche, die mit frischen, hausgemachten Produkten zubereitet wird. Coté Bistro: Gegrilltes Fleisch und Fisch, Tagesgerichte und französische Spezialitäten. Coté Gusto: Pizzas, frische handgemachte Pasta und italienische Spezialitäten."
    ],
    "en": [
      "Traditional and refined home-made cuisine made with fresh produce. Coté Bistro: grilled meat and fish, day's specials and French specialities. Coté Gusto: pizzas, fresh pasta and Italian specialities."
    ],
    "it": [
      "Cucina tradizionale e raffinata a base di prodotti freschi e fatti in casa. Lato bistrot: carne e pesce alla griglia, specialità del giorno e specialità francesi. Gusto side: pizze, pasta fresca fatta in casa e specialità italiane."
    ],
    "fr": [
      "Cuisine traditionnelle et raffinée réalisée avec des produits frais et préparés maison. Coté Bistro : viandes et poissons grillés, plats du jour et spécialités Françaises. Coté Gusto : pizzas, pâtes fraîches artisanales et spécialités Italiennes."
    ],
    "nl": [
      "Traditionele en verfijnde keuken met verse en zelfgemaakte producten. Bistrozijde: gegrild vlees en vis, dagschotels en Franse specialiteiten. Gusto kant: pizza's, verse huisgemaakte pasta en Italiaanse specialiteiten."
    ],
    "es": [
      "Cocina tradicional y refinada elaborada con productos frescos y caseros. Cara de bistró: carnes y pescados a la parrilla, platos del día y especialidades francesas. Gusto side: pizzas, pasta fresca casera y especialidades italianas."
    ]
  },
