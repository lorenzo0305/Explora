  "rdfs:comment": {
    "de": [
      "Une Faim de Loup, das ist Greg, der Ihnen leckere Burger, Salate, Desserts und viele andere Kleinigkeiten anbietet, die Sie bei einem Getränk oder zum Mitnehmen genießen können.\r\nAlle Gerichte werden täglich frisch vor Ort zubereitet."
    ],
    "en": [
      "Une Faim de Loup is Greg's way of serving up tasty burgers, salads, desserts and lots of other goodies to enjoy with a drink or to take away.\r\nAll cooked fresh daily on site."
    ],
    "it": [
      "Une Faim de Loup è il modo in cui Greg serve gustosi hamburger, piatti principali, insalate, dessert e tante altre prelibatezze da gustare con un drink o da portare via.\nTutto cucinato fresco ogni giorno sul posto."
    ],
    "fr": [
      "Une Faim de Loup, c' est Greg qui vous propose de vous régaler de savoureux burgers, plats, salades, desserts et pleins de petites choses à dévorer, autour d' un verre, ou à emporter.\nL'ensemble est cuisiné chaque jour, sur place avec des produits frais."
    ],
    "nl": [
      "Une Faim de Loup is Greg's manier om lekkere hamburgers, salades, desserts en nog veel meer lekkers te serveren voor bij de borrel of om mee te nemen.\r\nAlles wordt dagelijks ter plekke vers bereid."
    ],
    "es": [
      "Une Faim de Loup es la forma que tiene Greg de servir sabrosas hamburguesas, platos principales, ensaladas, postres y muchas otras delicias para disfrutar con una bebida o para llevar.\nTodo ello recién hecho en el mismo restaurante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Une faim de loup"
    ]
  },
