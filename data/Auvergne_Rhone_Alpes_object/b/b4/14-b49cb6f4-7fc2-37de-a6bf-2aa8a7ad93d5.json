  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0d0f7ac5-3ce3-3384-8d40-46f68e49d588",
      "dc:description": {
        "de": [
          "Architekt für Inneneinrichtungen\nLösungen für die Einrichtung von Möbeln für den Wohnbereich und für Pros.\nPlanung Ihrer Projekte, schlüsselfertige Ausführung.\n\nMöchten Sie eine Bestellung aufgeben?\nKlicken Sie auf die Schaltfläche \"Reservieren\", um die wichtigsten Produkte des Shops zu finden"
        ],
        "en": [
          "Interior designer\nFurnishing solutions for homes and businesses.\nStudy of your projects, turnkey realization.\n\nWant to place an order?\nClick on the \"Reserve\" button to see all the store's must-haves"
        ],
        "it": [
          "Designer di interni\nSoluzioni d'arredo per case e aziende.\nStudio dei vostri progetti, realizzazione chiavi in mano.\n\nVolete fare un ordine?\nCliccate sul pulsante \"Prenota\" per vedere tutti gli articoli imperdibili del negozio"
        ],
        "fr": [
          "Architecte d'intérieur\nSolutions d'aménagement mobilier pour l'habitat et les Pros.\nEtude de vos projets, réalisation clefs en main.\n\nEnvie de passer une commande ? \nRetrouvez les incontournables de la boutique en cliquant sur le bouton \"Réserver\""
        ],
        "nl": [
          "Interieurontwerper\nInrichtingsoplossingen voor woningen en bedrijven.\nStudie van uw projecten, kant-en-klare uitvoering.\n\nWil je een bestelling plaatsen?\nKlik op de knop \"Reserveren\" om alle must-have artikelen in de winkel te bekijken"
        ],
        "es": [
          "Diseñador de interiores\nSoluciones de mobiliario para viviendas y empresas.\nEstudio de sus proyectos, realización llave en mano.\n\n¿Desea hacer un pedido?\nHaga clic en el botón \"Reservar\" para ver todos los artículos imprescindibles de la tienda"
        ]
      },
      "@type": [
        "Description"
      ],
