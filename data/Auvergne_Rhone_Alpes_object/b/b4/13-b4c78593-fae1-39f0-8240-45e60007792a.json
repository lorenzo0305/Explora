  "rdfs:comment": {
    "de": [
      "Eingebettet im Herzen des charmanten Dorfes Goudet, am Ufer der Loire, auf der emblematischen Passage des GR70, dem berühmten Weg von Stevenson.\r\nUnsere Spezialitäten? Pizzas, Salate, süße Crêpes und Eis, die Ihren Gaumen erfreuen werden.\r\nSonnige Terrasse."
    ],
    "en": [
      "Nestled in the heart of the charming village of Goudet, on the banks of the Loire, on the emblematic route of the GR70, the famous Stevenson trail.\r\nOur specialities? Pizzas, salads, sweet crepes and ice creams to delight your taste buds.\r\nSunny terrace."
    ],
    "it": [
      "Nel cuore dell'affascinante villaggio di Goudet, sulle rive della Loira, sull'emblematico percorso del GR70, il famoso sentiero di Stevenson.\r\nLe nostre specialità? Pizze, insalate, crêpes dolci e gelati per deliziare il vostro palato.\r\nTerrazza soleggiata."
    ],
    "fr": [
      "Niché au cœur du charmant village de Goudet, en bord de Loire,  sur le passage emblématique du GR70, célèbre chemin de Stevenson.\r\nNos spécialités ? Des pizzas, des salades, des crêpes sucrées, glaces qui raviront vos papilles.\r\nTerrasse ensoleillée."
    ],
    "nl": [
      "Genesteld in het hart van het charmante dorpje Goudet, aan de oevers van de Loire, op de emblematische route van de GR70, de beroemde route van Stevenson.\r\nOnze specialiteiten? Pizza's, salades, zoete crêpes en ijs om je smaakpapillen te verwennen.\r\nZonnig terras."
    ],
    "es": [
      "Enclavado en el corazón del encantador pueblo de Goudet, a orillas del Loira, en la emblemática ruta del GR70, el famoso sendero de Stevenson.\r\n¿Nuestras especialidades? Pizzas, ensaladas, crepes dulces y helados para deleitar su paladar.\r\nTerraza soleada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bistrot \" La dentelle\""
    ]
  },
