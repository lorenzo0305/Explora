  "rdfs:comment": {
    "de": [
      "Das topografische Profil dieser Strecke zeichnet sich durch gleichmäßige Höhenunterschiede und rollende Abschnitte aus, was eine gute Verteilung der Anstrengung ermöglicht."
    ],
    "en": [
      "The topographical profile of this circuit is characterized by a homogeneity of gradients and rolling sections, which allows a good distribution of effort."
    ],
    "it": [
      "Il profilo topografico di questo circuito è caratterizzato da un'omogeneità di pendenze e di tratti ondulati, che consente una buona distribuzione dello sforzo."
    ],
    "fr": [
      "Le profil topographique de ce circuit est caractérisé par une homogénéité des dénivelés et des parties roulantes ce qui permet une bonne répartition de l’effort."
    ],
    "nl": [
      "Het topografische profiel van dit circuit wordt gekenmerkt door homogene hellingen en glooiende stukken, waardoor de inspanning goed verdeeld kan worden."
    ],
    "es": [
      "El perfil topográfico de este circuito se caracteriza por una homogeneidad de pendientes y tramos de rodadura, lo que permite una buena distribución del esfuerzo."
    ]
  },
