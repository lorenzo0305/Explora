  "rdfs:comment": {
    "de": [
      "Im Herzen des Manchet-Tals gelegen, empfängt das Le Piaf Restaurant alle Feierfreudigen, die einen geselligen Moment bei einem leckeren Essen verbringen möchten."
    ],
    "en": [
      "Located in the heart of the Manchet Valley, Le Piaf Restaurant welcomes party lovers who want to share a convivial moment over a delicious meal."
    ],
    "it": [
      "Situato nel cuore della valle del Manchet, il ristorante Le Piaf accoglie gli amanti delle feste che desiderano condividere un momento conviviale durante un pasto gustoso."
    ],
    "fr": [
      "Situé au cœur de la vallée du Manchet, Le Piaf Restaurant accueille les amoureux de la fête souhaitant partager un moment convivial lors d’un repas savoureux."
    ],
    "es": [
      "Situado en el corazón del valle del Manchet, el restaurante Le Piaf acoge a los amantes de la fiesta que desean compartir un momento de convivencia en torno a una sabrosa comida."
    ],
    "nl": [
      "Restaurant Le Piaf ligt in het hart van de Manchet-vallei en verwelkomt feestvierders die een gezellig moment willen delen tijdens een smakelijke maaltijd."
    ]
  },
