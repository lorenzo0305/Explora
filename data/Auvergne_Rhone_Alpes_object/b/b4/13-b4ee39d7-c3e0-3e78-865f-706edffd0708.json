  "rdfs:comment": {
    "de": [
      "Die besten französischen Skifahrerinnen über 18 Jahre und einige internationale Skifahrerinnen treffen sich zu zwei Slalom-Wettbewerben. Nehmen Sie sich einen Moment Zeit, um sie zu beobachten, wenn Sie am Fuß der Piste vorbeifahren."
    ],
    "en": [
      "France's top female skiers aged 18 and over, plus a few international stars, will be on hand for two Slalom events. Take a few moments to watch them as you pass by the slopes."
    ],
    "it": [
      "Le migliori sciatrici francesi dai 18 anni in su e alcune star internazionali si sfideranno in due gare di Slalom. Prendetevi qualche momento per osservarle mentre passate in fondo alla pista."
    ],
    "fr": [
      "Les meilleures skieuses françaises de plus de 18 ans et quelques internationales ont rendez-vous pour deux épreuves en Slalom. Prenez quelques instants pour les observer lors de votre passage au pied de la piste."
    ],
    "es": [
      "Las mejores esquiadoras francesas a partir de 18 años y varias estrellas internacionales competirán en dos pruebas de Slalom. Dedique unos instantes a observarlas a su paso por el fondo de la pista."
    ],
    "nl": [
      "Frankrijks beste vrouwelijke skiërs van 18 jaar en ouder, plus een aantal internationale sterren, doen mee aan twee Slalomwedstrijden. Neem even de tijd om ze te bekijken als je onderaan de piste langskomt."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ladies' FIS Slalom races"
    ],
    "fr": [
      "Courses FIS Slalom Dames"
    ]
  },
