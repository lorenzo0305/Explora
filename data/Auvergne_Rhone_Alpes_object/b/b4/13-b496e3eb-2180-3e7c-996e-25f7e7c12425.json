  "rdfs:comment": {
    "de": [
      "La Belli Gourmande kehrt nach Bellevue-la-Montagne zurück! Eine gesellige Wanderung von 10 oder 20 km, gefolgt von einer Gourmetmahlzeit, die im Ofen von Souffleix zubereitet wird, organisiert vom Festkomitee."
    ],
    "en": [
      "The Belli Gourmande returns to Bellevue-la-Montagne! A friendly 10 or 20 km hike, followed by a gourmet meal cooked in the Souffleix oven, organized by the festivities committee."
    ],
    "it": [
      "Il Belli Gourmande torna a Bellevue-la-Montagne! Una passeggiata amichevole di 10 o 20 km, seguita da un pasto gourmet cucinato nel forno di Souffleix, organizzato dal comitato dei festeggiamenti."
    ],
    "fr": [
      "La Belli Gourmande revient à Bellevue-la-Montagne ! Une randonnée pédestre conviviale de 10 ou 20 km, suivie d’un repas gourmand cuit au four de Souffleix, organisée par le comité des fêtes."
    ],
    "es": [
      "¡La Belli Gourmande vuelve a Bellevue-la-Montagne! Una marcha amistosa de 10 o 20 km, seguida de una comida gourmet cocinada en el horno Souffleix, organizada por la comisión de festejos."
    ],
    "nl": [
      "De Belli Gourmande keert terug naar Bellevue-la-Montagne! Een gezellige wandeling van 10 of 20 km, gevolgd door een gastronomische maaltijd bereid in de Souffleix-oven, georganiseerd door het feestcomité."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Randonnée : La Belli Gourmande"
    ]
  },
