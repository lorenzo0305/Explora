  "rdfs:comment": {
    "de": [
      "Le Sucre ist ein Club und Kulturort auf dem Dach der Sucrière in Lyon, einem Ort der Kultur und des Erfahrungsaustauschs. Hier finden das ganze Jahr über Clubabende, Konzerte, Aperitifs und Veranstaltungen statt."
    ],
    "en": [
      "Le Sucre is a cultural site located on the roof of La Sucrière in Lyon. It hosts clubs, concerts, aperitifs, conferences and other events throughout the year."
    ],
    "it": [
      "Luogo di cultura e di condivisione di esperienze, Le Sucre è un club e un luogo culturale situato sul tetto de La Sucrière a Lione. Ospita serate in discoteca, concerti, aperitivi ed eventi durante tutto l'anno."
    ],
    "fr": [
      "Lieu de culture et de partage d’expériences, Le Sucre est un club et lieu culturel situé sur le toit de la Sucrière à Lyon. Il accueille soirées club, concerts, apéros et événements tout au long de l'année."
    ],
    "es": [
      "Le Sucre, un lugar para la cultura y el intercambio de experiencias, es un club y espacio cultural situado en la azotea de la Sucrière de Lyon. Acoge noches de club, conciertos, aperitivos y eventos durante todo el año."
    ],
    "nl": [
      "Le Sucre, een plek voor cultuur en het delen van ervaringen, is een club en cultureel trefpunt op het dak van La Sucrière in Lyon. Het hele jaar door worden hier clubavonden, concerten, aperitieven en evenementen georganiseerd."
    ]
  },
