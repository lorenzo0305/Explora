  "rdfs:comment": {
    "de": [
      "Der Komplex liegt an der Kreuzung der Autobahnen A75, A89 und A71, in der Nähe des Flughafens Clermont Ferrand Auvergne und 5 Minuten von der Hotelzone Le Brezet entfernt. Der Komplex verfügt über 14 Spielfelder."
    ],
    "en": [
      "Located at the junction of the A75, A89 and A71 freeways, close to Clermont Ferrand Auvergne airport and 5 minutes from the Brezet hotel zone, the complex has 14 playing fields."
    ],
    "it": [
      "Situato all'incrocio delle autostrade A75, A89 e A71, vicino all'aeroporto di Clermont Ferrand Auvergne e a 5 minuti dalla zona alberghiera di Brezet, il complesso dispone di 14 campi da gioco."
    ],
    "fr": [
      "Situé au croisement des autoroute A75, A89 et A71, à proximité de l’aéroport de Clermont Ferrand Auvergne et à 5 minutes de la zone hôtelière du Brezet, Le complexe dispose de 14 terrains de jeu."
    ],
    "es": [
      "Situado en el cruce de las autopistas A75, A89 y A71, cerca del aeropuerto de Clermont Ferrand Auvergne y a 5 minutos de la zona hotelera de Brezet, el complejo cuenta con 14 campos de juego."
    ],
    "nl": [
      "Het complex ligt op het kruispunt van de snelwegen A75, A89 en A71, dicht bij de luchthaven van Clermont Ferrand Auvergne en op 5 minuten van de hotelzone Brezet, en beschikt over 14 speelvelden."
    ]
  },
  "rdfs:label": {
