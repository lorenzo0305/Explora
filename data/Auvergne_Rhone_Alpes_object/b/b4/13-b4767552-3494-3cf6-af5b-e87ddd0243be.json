  "rdfs:comment": {
    "de": [
      "Unsere Bar empfängt Sie an jedem Tag des Jahres bis 1 Uhr morgens. Unser Barkeeper Robin berät Sie gerne, improvisiert aber auch gerne nach Lust und Laune."
    ],
    "en": [
      "Our bar welcomes you daily all year long until 1 am. Our barman, Robin, will be happy to advise you but also to improvise according to your desires."
    ],
    "it": [
      "Il nostro bar vi accoglie tutti i giorni dell'anno fino all'una di notte. Il nostro barman, Robin, sarà felice di consigliarvi ma anche di improvvisare secondo i vostri desideri."
    ],
    "fr": [
      "Notre bar vous accueille tous les jours de l'année jusqu'à 1h du matin. Notre barman, Robin, se fera un plaisir de vous conseiller mais aussi d'improviser selon vos envies."
    ],
    "nl": [
      "Onze bar verwelkomt u elke dag van het jaar tot 1 uur 's nachts. Onze barman, Robin, zal u graag adviseren maar ook improviseren volgens uw wensen."
    ],
    "es": [
      "Nuestro bar le da la bienvenida todos los días del año hasta la 1 de la madrugada. Nuestro barman, Robin, estará encantado de aconsejarle pero también de improvisar según sus deseos."
    ]
  },
