  "rdfs:comment": {
    "de": [
      "Ihr 200 m2 großer Wellnessbereich mit Spa, Sauna, Hammam, Wärmelounge, Einzel- und Doppelmassageräumen, Affusionsdusche, Entspannungsraum mit Blick auf die Rhône.\r\nGesichts- und Körperbehandlungen sowie Massagen in einem intimen und überraschenden Rahmen."
    ],
    "en": [
      "Your 200 m2 wellness area with Spa, Sauna, Hammam, heated lounge, single and double massage rooms, affusion shower, relaxation room overlooking the Rhône.\r\nFace and body treatments and massages in a surprisingly intimate setting."
    ],
    "it": [
      "La vostra area benessere di 200 m2 con Spa, Sauna, Hammam, saloni riscaldati, sale massaggi singole e doppie, doccia ad affusione, sala relax con vista sul Rodano.\r\nTrattamenti viso e corpo e massaggi in un ambiente sorprendentemente intimo."
    ],
    "fr": [
      "Votre espace bien être de 200 m2 avec Spa, Sauna, Hammam, Lounge chauffants, salles de massage simples et doubles , douche à affusion, salle de détente avec vue sur le Rhône.\r\nSoins Visage et Corps et Massages dans un cadre intimiste et surprenant."
    ],
    "nl": [
      "Uw wellnessruimte van 200 m2 met Spa, Sauna, Hammam, verwarmde lounges, enkele en dubbele massageruimtes, affusiondouche, ontspanningsruimte met uitzicht op de Rhône.\r\nGezichts- en lichaamsbehandelingen en massages in een verrassend intieme omgeving."
    ],
    "es": [
      "Su espacio de bienestar de 200 m2 con Spa, Sauna, Hammam, salones climatizados, salas de masaje individuales y dobles, ducha de afusión, sala de relajación con vistas al Ródano.\r\nTratamientos faciales y corporales y masajes en un ambiente sorprendentemente íntimo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spa du Rhône"
    ]
  },
