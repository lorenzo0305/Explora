  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d6e2b9f-67b1-3fba-a9ca-c171104879d3",
      "dc:description": {
        "de": [
          "der Verein Les Chti's Freinetard organisiert in Zusammenarbeit mit dem Comité Normand Cas am 1. Juni 2025 in Embry von 9:30 bis 18:00 Uhr das 7. Seifenrennen. Weitere Informationen finden Sie auf dem Plakat."
        ],
        "en": [
          "the association Les Chti's Freinetard, in partnership with the Comité Normand Cas, is organizing the 7th edition of the soap race on June 1, 2025 in Embry, from 9:30 am to 6 pm. For more information, see the poster."
        ],
        "it": [
          "l'associazione Les Chti's Freinetard, in collaborazione con il Comité Normand Cas, organizza la 7ª edizione della gara di soapbox il 1° giugno 2025 a Embry, dalle 9.30 alle 18.00. Per maggiori informazioni, consultare la locandina."
        ],
        "fr": [
          "l'association Les Chti's Freinetard, en partenariat avec le Comité Normand Cas, organise la 7ème édition de la course à savon le 1er juin 2025 à Embry, de 9h30 à 18h. Pour plus d'informations, voir l'affiche."
        ],
        "es": [
          "la asociación Les Chti's Freinetard, en colaboración con el Comité Normand Cas, organiza la 7ª edición de la carrera de soapbox el 1 de junio de 2025 en Embry, de 9h30 a 18h00. Para más información, consulte el cartel."
        ],
        "nl": [
          "de vereniging Les Chti's Freinetard organiseert in samenwerking met het Comité Normand Cas de 7e editie van de zeepkistenrace op 1 juni 2025 in Embry, van 9.30 tot 18.00 uur. Zie voor meer informatie de poster."
        ]
      },
