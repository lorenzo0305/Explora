  "rdfs:comment": {
    "de": [
      "Ein anspruchsvoller und abwechslungsreicher Enduro-Trail, auf dem sich technische Abschnitte mit schnellen Abschnitten in bergigem Gelände abwechseln. Ideal für Fahrer, die nach Tempo und Herausforderung suchen."
    ],
    "en": [
      "A demanding and varied enduro trail that mixes technical sections with fast-paced mountain segments. Perfect for riders looking for flow and challenge."
    ],
    "it": [
      "Un percorso enduro impegnativo e vario, che alterna tratti tecnici a tratti di montagna veloci. Ideale per chi cerca ritmo e sfida."
    ],
    "fr": [
      "Un sentier enduro exigeant et varié, qui alterne sections techniques et portions rapides en terrain montagnard. Idéal pour les riders en quête de rythme et de challenge."
    ],
    "es": [
      "Una pista de enduro exigente y variada, que alterna tramos técnicos con rápidos tramos de montaña. Ideal para pilotos que buscan ritmo y desafío."
    ],
    "nl": [
      "Een veeleisende en gevarieerde enduro trail, die technische stukken afwisselt met snelle bergsecties. Ideaal voor rijders die op zoek zijn naar tempo en uitdaging."
    ]
  },
  "rdfs:label": {
