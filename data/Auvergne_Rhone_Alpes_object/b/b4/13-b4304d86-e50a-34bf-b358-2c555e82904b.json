  "rdfs:comment": {
    "de": [
      "Staatlich geprüfter Lehrer für Höhlenforschung und Canyoning."
    ],
    "en": [
      "State-certified caving and canyoning instructor."
    ],
    "it": [
      "Istruttore di speleologia e canyoning certificato dallo Stato.\r\n\r\nSpeleologia tutto l'anno, anche sotto la pioggia e la neve!\r\nCanyoning tra metà aprile e metà ottobre"
    ],
    "fr": [
      "Moniteur de spéléologie et canyoning diplômé d'Etat.\r\n\r\nActivité spéléo toute l'année même sous la pluie, même sous la neige !\r\nCanyoning entre mi-avril et mi-octobre"
    ],
    "nl": [
      "Staatsgecertificeerd speleologie- en canyoninginstructeur.\r\n\r\nSpeleologie het hele jaar door, zelfs in de regen en sneeuw!\r\nCanyoning tussen half april en half oktober"
    ],
    "es": [
      "Monitor de espeleología y barranquismo titulado por el Estado.\r\n\r\nEspeleología todo el año, ¡incluso con lluvia y nieve!\r\nBarranquismo entre mediados de abril y mediados de octubre"
    ]
  },
