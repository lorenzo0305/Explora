  "rdfs:comment": {
    "de": [
      "Das in Saint-Omer gelegene Ch?ti Charivari lädt Sie zu einer wahren kulinarischen Reise in das Herz der Alpen ein, ohne die Region Hauts-de-France zu verlassen."
    ],
    "en": [
      "Located in Saint-Omer, the Ch?ti Charivari invites you on a culinary journey to the heart of the Alps, without leaving the Hauts-de-France region."
    ],
    "it": [
      "Situato a Saint-Omer, lo Ch?ti Charivari vi invita a un viaggio culinario nel cuore delle Alpi, senza lasciare l'Hauts-de-France."
    ],
    "fr": [
      "Situé à Saint-Omer, le Ch’ti Charivari vous invite à un véritable voyage culinaire au cœur des Alpes, sans quitter les Hauts-de-France."
    ],
    "es": [
      "Situado en Saint-Omer, el Ch?ti Charivari le invita a un viaje culinario al corazón de los Alpes, sin salir de Hauts-de-France."
    ],
    "nl": [
      "De Ch?ti Charivari in Saint-Omer nodigt je uit voor een culinaire reis naar het hart van de Alpen, zonder de Hauts-de-France te verlaten."
    ]
  },
