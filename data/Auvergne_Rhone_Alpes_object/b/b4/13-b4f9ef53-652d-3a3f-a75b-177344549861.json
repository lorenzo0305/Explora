  "rdfs:comment": {
    "de": [
      "Gruppenkurse, Unterricht und Privatlehrer, für Kinder, Jugendliche, Erwachsene alle Niveaus. Schneeschuhwanderungen für alle Niveaus.\r\nOrganisation von Gruppen- und Seminarevents."
    ],
    "en": [
      "Group lessons, private lessons and instructors, for children, teenagers and adults of all levels. Snowshoeing for all levels.\r\nDuring summer: Rafting, Hydro-speed swimming, Tree-top adventure course, Canyoning and Paragliding.\r\nOrganised activities for groups and seminars during the summer and winter seasons."
    ],
    "it": [
      "Lezioni di gruppo, lezioni private e istruttori per bambini, adolescenti e adulti a tutti i livelli. Escursioni con le racchette da neve per tutti i livelli.\r\nOrganizzazione di eventi di gruppo e seminari."
    ],
    "fr": [
      "Cours collectifs, leçons et moniteurs privés, pour enfants, ados, adultes tous niveaux. Randonnées en raquettes tous niveaux.\r\nOrganisation d'évènements groupes et séminaires."
    ],
    "nl": [
      "Groepslessen, privélessen en instructeurs voor kinderen, tieners en volwassenen op alle niveaus. Sneeuwschoenuitstapjes voor alle niveaus.\r\nOrganisatie van groepsevenementen en seminars."
    ],
    "es": [
      "Clases en grupo, clases particulares y monitores para niños, adolescentes y adultos de todos los niveles. Salidas con raquetas de nieve para todos los niveles.\r\nOrganización de eventos de grupo y seminarios."
    ]
  },
