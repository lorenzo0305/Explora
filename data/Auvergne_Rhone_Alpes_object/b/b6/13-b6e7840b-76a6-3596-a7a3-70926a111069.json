  "rdfs:comment": {
    "de": [
      "Von Ihrem Chefkoch signierte Rezepte, die in der reinen Tradition der französischen Küche mit einem Hauch von Kühnheit und viel Aufmerksamkeit zubereitet werden. Ein gepflegter und gastfreundlicher Service."
    ],
    "en": [
      "Recipes signed by your chef, made in the pure tradition of French cuisine with a touch of audacity and a lot of attention. A careful and welcoming service."
    ],
    "it": [
      "Ricette firmate dal vostro chef, preparate nella pura tradizione della cucina francese con un tocco di audacia e molta attenzione. Servizio attento e cordiale."
    ],
    "fr": [
      "Des recettes signées par votre chef, réalisées dans la pure tradition de la cuisine française avec un soupçon d'audace et beaucoup d'attention. Un service soigné et accueillant."
    ],
    "es": [
      "Recetas firmadas por su chef, elaboradas en la más pura tradición de la cocina francesa con un toque de audacia y mucha atención. Servicio atento y acogedor."
    ],
    "nl": [
      "Recepten ondertekend door uw chef, bereid in de pure traditie van de Franse keuken met een vleugje durf en veel aandacht. Zorgvuldige en vriendelijke bediening."
    ]
  },
