  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet der Racing Club de Vichy Rugby eine kostenlose Schnupperstunde an: Reaktivierung des Körpers in Sicherheit.\r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Racing Club de Vichy Rugby offers a free discovery session: reactivating your body in safety.\r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, il Racing Club de Vichy Rugby propone una sessione di scoperta gratuita: riattivare il corpo in modo sicuro.\r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Racing Club de Vichy Rugby propose une séance gratuite de découverte : réactiver son Corps en sécurité.\r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het Vitaliteitsprogramma van Vichy biedt Racing Club de Vichy Rugby een gratis ontdekkingssessie aan: je lichaam op een veilige manier reactiveren.\r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, el Racing Club de Rugby de Vichy le propone una sesión gratuita de descubrimiento: reactivar su cuerpo con total seguridad.\r\nInformación e inscripciones por teléfono."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Réactiver son Corps en sécurité - Vichy Vitalité"
    ]
  },
