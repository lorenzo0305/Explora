  "rdfs:comment": {
    "de": [
      "Kinderspielplatz neben dem Rathaus.\r\nHier gibt es eine Struktur mit Rutsche, Federspiel, Tischtennisplatte, Gleichgewichtsparcours, Fitnessstruktur, Bouleplatz. Picknicktische und Bänke."
    ],
    "en": [
      "Children's play area next to the town hall.\r\nIncluding slide, spring-loaded game, ping-pong table, balance course, fitness structure, petanque court. Picnic tables and benches."
    ],
    "it": [
      "Area giochi per bambini accanto al municipio.\r\nC'è una struttura con scivolo, un gioco a molla, un tavolo da ping pong, un percorso di equilibrio, una struttura per il fitness e un'area per le bocce. Tavoli da picnic e panchine."
    ],
    "fr": [
      "Aire de jeux pour enfants à côté de la Mairie. \r\nPrésence d'une structure avec toboggan, jeu à ressort, table de ping-pong, parcours d'équilibre, structure fitness, terrain de pétanque. Tables de pique-nique et bancs."
    ],
    "es": [
      "Zona de juegos infantiles junto al ayuntamiento.\r\nHay una estructura con tobogán, un juego de muelles, una mesa de ping-pong, un recorrido de equilibrio, una estructura de fitness y una zona de petanca. Mesas de picnic y bancos."
    ],
    "nl": [
      "Kinderspeelplaats naast het gemeentehuis.\r\nEr is een structuur met een glijbaan, een veerspel, een tafeltennistafel, een evenwichtsparcours, een fitnessstructuur en een petanqueterrein. Picknicktafels en banken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux"
    ]
  },
