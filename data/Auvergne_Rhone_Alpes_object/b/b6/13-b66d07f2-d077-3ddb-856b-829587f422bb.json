  "rdfs:comment": {
    "de": [
      "Hochgebirgsführer, begleitet Sie mit der Familie oder mit Freunden :\r\n- Wandern mit Übernachtung in einer Berghütte\r\n- Bergsteigen, Gletscherwanderungen und Gipfelbesteigungen\r\n- Schneeschuhwandern, Skitouren\r\n- Klettern in der Schule und in großen Routen, Via Ferrata\r\n- MOUNTAINBIKE"
    ],
    "en": [
      "High Mountain Guide will guide you with your family or friends:\r\n- Hiking with night in a refuge\r\n- Mountaineering, glacier trekking and summit climbing\r\n- Snowshoeing, ski touring\r\n- Climbing, Via Ferrata\r\n- Mountaing biking"
    ],
    "it": [
      "Guida alpina, vi accompagna con la famiglia o gli amici:\r\n- Escursioni con pernottamento in rifugio\r\n- Alpinismo, trekking su ghiacciaio e scalata delle vette\r\n- Escursioni con le racchette da neve, sci alpinismo\r\n- Arrampicata su scuole e grandi vie, Via Ferrata\r\n- MOUNTAIN BIKE"
    ],
    "fr": [
      "Guide de Haute Montagne, vous accompagne en famille ou entre amis : \r\n- Randonnée avec nuit en refuge\r\n- Alpinisme, randonnée glaciaire et ascension de sommets\r\n- Raquettes, ski de randonnée\r\n- Escalade en école et en grandes voies, Via Ferrata\r\n- VTT"
    ],
    "nl": [
      "High Mountain Guide, begeleidt je met je familie of vrienden:\r\n- Wandelen met overnachting in een berghut\r\n- Bergbeklimmen, gletsjertrekking en beklimming van toppen\r\n- Sneeuwschoenwandelen, skitochten\r\n- Beklimming van scholen en grote routes, Via Ferrata\r\n- MOUNTAINBIKEN"
    ],
    "es": [
      "Guía de Alta Montaña, te acompaña con tu familia o amigos:\r\n- Senderismo con pernoctación en refugio\r\n- Alpinismo, trekking por glaciares y escalada de cumbres\r\n- Raquetas de nieve, esquí de travesía\r\n- Escalada escolar y de grandes vías, Vía Ferrata\r\n- BICICLETA DE MONTAÑA"
    ]
  },
