  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf die spanische Gastronomie im Roannais? Entdecken Sie unsere Spezialitäten: Tapas, Paëlla ... und dazu unsere Sangria.\r\nRuhig gelegenes Lokal mit einer Terrasse, die einen atemberaubenden Panoramablick auf den See von Villerest bietet."
    ],
    "en": [
      "Would you like to try Spanish gastronomy in Roannais? Come and discover our specialities: tapas, paella... accompanied by our sangria.\r\nA quiet establishment with a terrace offering a breathtaking panoramic view of Lake Villerest."
    ],
    "it": [
      "Volete provare la cucina spagnola a Roannais? Venite a scoprire le nostre specialità: tapas, paella... accompagnate dalla nostra sangria.\r\nUn locale tranquillo con una terrazza che offre una vista panoramica mozzafiato sul lago di Villerest."
    ],
    "fr": [
      "La gastronomie espagnole dans le Roannais, ça vous tente ? Venez découvrir nos spécialités : tapas, paëlla... agrémentées de notre sangria.\r\nÉtablissement au calme bénéficiant d'une terrasse avec une vue panoramique imprenable sur le lac de Villerest."
    ],
    "es": [
      "¿Desea probar la cocina española en Roannais? Venga a descubrir nuestras especialidades: tapas, paella... acompañadas de nuestra sangría.\r\nUn establecimiento tranquilo con una terraza que ofrece una impresionante vista panorámica del lago Villerest."
    ],
    "nl": [
      "Wil je de Spaanse keuken uitproberen in Roannais? Kom en ontdek onze specialiteiten: tapas, paella... vergezeld van onze sangria.\r\nEen rustig etablissement met een terras dat een adembenemend panoramisch uitzicht biedt op het meer van Villerest."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de la Vieille Castille"
    ]
  },
