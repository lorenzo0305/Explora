  "rdfs:comment": {
    "de": [
      "Wir bieten extrafrische Bio-Eier an. Unsere Hühner haben einen Auslauf im Wald und genießen im Sommer den Schatten der Bäume und die Erde, die sie nach Herzenslust aufscharren können."
    ],
    "en": [
      "We offer extra-fresh organic eggs, our chickens have a run in the woods and enjoy the shade of the trees in summer as well as a soil that they can scratch at leisure."
    ],
    "it": [
      "Offriamo uova biologiche freschissime, le nostre galline hanno una pista nel bosco e in estate godono dell'ombra degli alberi e del terreno che possono grattare a volontà."
    ],
    "fr": [
      "Nous proposons des œufs bios extra-frais, nos poules ont un parcours dans les bois et profitent ainsi de l’ombre des arbres en été ainsi que d’une terre qu’elles peuvent gratter à loisir."
    ],
    "nl": [
      "Wij bieden extra verse biologische eieren, onze kippen hebben een ren in het bos en genieten in de zomer van de schaduw van de bomen en de grond waar ze naar believen kunnen scharrelen."
    ],
    "es": [
      "Ofrecemos huevos ecológicos extra frescos, nuestras gallinas tienen un corral en el bosque y disfrutan de la sombra de los árboles en verano, así como de la tierra que pueden escarbar a voluntad."
    ]
  },
  "rdfs:label": {
