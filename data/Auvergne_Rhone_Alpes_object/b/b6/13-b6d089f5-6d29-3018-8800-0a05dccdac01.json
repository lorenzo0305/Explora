  "rdfs:comment": {
    "de": [
      "Rund um die Geschichten aus dem Bienenstock von Pierre-Olivier Bannwartth bietet Ihnen das Orchester Junior Pizzicato eine ganze Reihe von Musikstücken wie die der Bienen. Und warum nicht ein paar Bienenprodukte probieren?"
    ],
    "en": [
      "With Pierre-Olivier Bannwartth?s Contes de la Ruche as its theme, the Junior Pizzicato orchestra brings you a whole range of bee-related music. And why not sample some bee products?"
    ],
    "it": [
      "Con il tema dei Contes de la Ruche di Pierre-Olivier Bannwartth, l'orchestra Junior Pizzicato suonerà tutta una serie di musiche, compresa quella delle api. E perché non assaggiare i prodotti delle api?"
    ],
    "fr": [
      "C’est autour des Contes de la Ruche de Pierre-Olivier Bannwartth que l’orchestre Junior Pizzicato vous propose toute une série de musiques comme celle des abeilles. Et pourquoi ne pas déguster quelques produits qui en sont issus ?"
    ],
    "nl": [
      "Met Contes de la Ruche van Pierre-Olivier Bannwartth als thema speelt het Junior Pizzicato-orkest een hele reeks muziek, waaronder bijenmuziek. En waarom geen bijenproducten proeven?"
    ],
    "es": [
      "Con los Contes de la Ruche de Pierre-Olivier Bannwartth como tema, la orquesta Junior Pizzicato interpretará música de todo tipo, incluida música apícola. ¿Y por qué no degustar productos apícolas?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert : Bis Bees"
    ]
  },
