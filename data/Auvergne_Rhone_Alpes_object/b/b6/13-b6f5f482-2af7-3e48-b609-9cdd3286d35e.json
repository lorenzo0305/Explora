  "rdfs:comment": {
    "de": [
      "Ein bezaubernder Ort, an dem sich ein trendiges Restaurant, eine grandiose Terrasse, ein gemütliches Ambiente, Lounge-Bereiche und private Räume vereinen. Semi-gastronomische Verpflegung."
    ],
    "en": [
      "A bewitching place combining a trendy restaurant, a grandiose terrace, a cosy atmosphere, lounge areas and private rooms. Semi-gastronomic cuisine."
    ],
    "it": [
      "Un luogo incantevole dove si fondono un ristorante alla moda, un'imponente terrazza, un'atmosfera accogliente, aree lounge e sale private. Ristorazione semi-gastronomica."
    ],
    "fr": [
      "Un lieu envoûtant où s'unissent un restaurant tendance, une terrasse grandiose, une ambiance cosy, des espaces lounge et des salles privatisées. Restauration semi-gastronomique."
    ],
    "es": [
      "Un lugar encantador en el que confluyen un restaurante de moda, una imponente terraza, un ambiente acogedor, zonas de descanso y salones privados. Catering semigastronómico."
    ],
    "nl": [
      "Een betoverende plek waar een trendy restaurant, een imposant terras, een gezellige sfeer, lounges en privékamers samenkomen. Semi-gastronomische catering."
    ]
  },
