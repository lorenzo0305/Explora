  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Lichtrealisierungen und die Ausstellung, die von den Studenten der E.S.D.A.C. (École Supérieure d'Art et de Design) und des Centre de Formation des Apprentis (Ausbildungszentrum für Lehrlinge) in Clermont-Ferrand kreiert wurden."
    ],
    "en": [
      "Discover the luminous creations and exhibition created from scratch by students from E.S.D.A.C. (École Supérieure d?Art et de Design) and the Centre de Formation des Apprentis de Clermont-Ferrand."
    ],
    "it": [
      "Scoprite le creazioni illuminotecniche e le mostre realizzate da zero dagli studenti dell'E.S.D.A.C. (École Supérieure d'Art et de Design) e del Centro di formazione per apprendisti di Clermont-Ferrand."
    ],
    "fr": [
      "Découvrez les réalisations lumineuses et l’exposition créée de toutes pièces par les étudiants de l’E.S.D.A.C. (École Supérieure d’Art et de Design) et du Centre de Formation des Apprentis de Clermont-Ferrand."
    ],
    "nl": [
      "Ontdek de verlichtingscreaties en -tentoonstelling die vanaf nul zijn gemaakt door studenten aan de E.S.D.A.C. (École Supérieure d?Art et de Design) en het opleidingscentrum voor leerlingen van Clermont-Ferrand."
    ],
    "es": [
      "Descubra las creaciones luminosas y la exposición creadas desde cero por los alumnos de la E.S.D.A.C. (Escuela Superior de Arte y Diseño) y del Centro de Formación de Aprendices de Clermont-Ferrand."
    ]
  },
