          "additionalInformation": {
            "de": [
              "Verpflegung vor Ort und zum Mitnehmen :\r\nDienstag bis Freitag mittags von 11:30 bis 14:30 Uhr.\r\nSamstagmittag von 9:00 bis 14:30 Uhr.\r\nDonnerstag- und Freitagabend = Weinbar mit Weinen und Saisonbrettern von 18h bis 21h30."
            ],
            "en": [
              "On-site and takeaway catering:\r\nTuesday to Friday lunchtime, 11:30am to 2:30pm.\r\nSaturday lunchtime from 9am to 2.30pm.\r\nThursday and Friday evenings = Wine bar and seasonal platters from 6pm to 9:30pm."
            ],
            "it": [
              "Ristorazione in loco e da asporto:\r\nDa martedì a venerdì a pranzo dalle 11.30 alle 14.30.\r\nSabato a pranzo dalle 9.00 alle 14.30.\r\nGiovedì e venerdì sera = Wine bar e piatti stagionali dalle 18.00 alle 21.30."
            ],
            "fr": [
              "Restauration sur place et à emporter :\r\nDu mardi au vendredi midi de 11h30 à 14h30.\r\nSamedi midi de 9h à 14h30.\r\nJeudi et Vendredi soir = Bar à vin et planches de saison de 18h à 21h30."
            ],
            "es": [
              "Restauración in situ y para llevar:\r\nDe martes a viernes, de 11.30 a 14.30 h.\r\nSábados al mediodía de 9.00 a 14.30 h.\r\nJueves y viernes por la noche = Barra de vinos y platos de temporada de 18:00 a 21:30."
            ],
            "nl": [
              "Catering ter plaatse en afhaalmaaltijden:\r\nDinsdag t/m vrijdag lunchtijd van 11.30 tot 14.30 uur.\r\nZaterdagmiddag van 9.00 tot 14.30 uur.\r\nDonderdag- en vrijdagavond = Wijnbar en seizoensgerechten van 18.00 tot 21.30 uur."
            ]
          },
