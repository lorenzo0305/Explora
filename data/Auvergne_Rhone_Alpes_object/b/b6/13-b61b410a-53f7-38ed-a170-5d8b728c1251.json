  "rdfs:comment": {
    "de": [
      "Das Domaine des Oliviers empfängt Sie in einem raffinierten und zeitgemäßen Rahmen. Es verfügt über 3 Seminarräume für Ihre beruflichen und persönlichen Bedürfnisse, die vollständig ausgestattet sind. Videoprojektor, Wi-Fi, Tische und Stühle."
    ],
    "en": [
      "Domaine des Oliviers welcomes you to a refined, contemporary setting. It has 3 fully-equipped seminar rooms for your professional and personal needs. Video projector, Wi-fi, tables and chairs."
    ],
    "it": [
      "Il Domaine des Oliviers vi accoglie in un ambiente raffinato e contemporaneo. Dispone di 3 sale per seminari completamente attrezzate per le vostre esigenze professionali e personali. Videoproiettore, Wi-fi, tavoli e sedie."
    ],
    "fr": [
      "Le domaine des Oliviers vous accueille dans un cadre raffiné et contemporain. Il dispose de 3 salles de séminaire pour vos besoins professionnels et personnels entièrement équipées. Vidéoprojecteur, Wi-fi, tables et chaises."
    ],
    "nl": [
      "Het Domaine des Oliviers verwelkomt u in een verfijnde, eigentijdse omgeving. Het beschikt over 3 volledig uitgeruste seminariezalen voor uw professionele en persoonlijke behoeften. Videoprojector, Wi-fi, tafels en stoelen."
    ],
    "es": [
      "El Domaine des Oliviers le da la bienvenida en un marco refinado y contemporáneo. Dispone de 3 salas de seminarios totalmente equipadas para sus necesidades profesionales y personales. Proyector de vídeo, Wi-fi, mesas y sillas."
    ]
  },
