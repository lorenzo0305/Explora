  "rdfs:comment": {
    "de": [
      "Zahlreiche Aussteller, um einen schönen, geselligen Abend zu verbringen und das Essen und die Getränke nach Wunsch auswählen zu können. Tische und Stühle stehen zur Verfügung. Musikalische Umrahmung durch Canel Wine Pear."
    ],
    "en": [
      "Numerous exhibitors to enjoy a convivial evening and choose the meal and drinks you want. Tables and chairs available. Musical entertainment provided by Canel Wine Pear."
    ],
    "it": [
      "Numerosi espositori saranno a disposizione per aiutarvi a trascorrere una serata conviviale e a scegliere il pasto e le bevande che desiderate. Tavoli e sedie a disposizione. Intrattenimento musicale a cura di Canel Wine Pear."
    ],
    "fr": [
      "De nombreux exposants pour passer une belle soirée conviviale et pouvoir choisir le repas et boissons qu'on souhaite. Tables et chaises disponibles. Ambiance musicale assurée par Canel Wine Pear."
    ],
    "nl": [
      "Tal van exposanten zullen aanwezig zijn om je te helpen van een gezellige avond te genieten en de maaltijd en drankjes te kiezen die je wilt. Tafels en stoelen beschikbaar. Muzikale omlijsting door Canel Wine Pear."
    ],
    "es": [
      "Numerosos expositores le ayudarán a disfrutar de una velada agradable y a elegir la comida y bebida que desee. Mesas y sillas disponibles. Animación musical a cargo de Canel Wine Pear."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée gourmande"
    ]
  },
