  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2efa0ff7-681c-3254-8b8a-f86dea3d0bb9",
      "dc:description": {
        "de": [
          "Das Kama-Team erwartet Sie in seinem loungeartigen und modernen Dekor, um Ihnen Gerichte mit indischen Spezialitäten zu servieren. Entspannen Sie sich und genießen Sie die raffinierte und fein gewürzte Küche."
        ],
        "en": [
          "The Kama team awaits you in a modern lounge setting to serve you Indian specialties. Relax and enjoy refined, finely spiced cuisine."
        ],
        "it": [
          "Il team del Kama vi aspetta in un moderno ambiente lounge per servirvi le specialità indiane. Venite a rilassarvi gustando una cucina raffinata e finemente speziata."
        ],
        "fr": [
          "L'équipe Kama vous attend dans son décor lounge et moderne pour vous servir des plats de spécialités indiennes. Venez vous détendre en profitant d'une cuisine raffinée et finement épicée."
        ],
        "nl": [
          "Het Kama-team wacht op je in de moderne loungesetting om je Indiase specialiteiten te serveren. Kom en ontspan terwijl je geniet van verfijnde, fijn gekruide gerechten."
        ],
        "es": [
          "El equipo de Kama le espera en su moderno salón para servirle especialidades indias. Venga a relajarse mientras disfruta de una cocina refinada y finamente condimentada."
        ]
      },
      "@type": [
