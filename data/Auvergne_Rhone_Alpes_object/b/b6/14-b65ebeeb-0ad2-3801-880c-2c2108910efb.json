  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/27913708-9b4e-30dd-8341-f8287d11786a",
      "dc:description": {
        "de": [
          "Dieses Konzert des Vokalensembles des Conservatoire du Boulonnais umfasst ein eklektisches Repertoire, das von Barock über Jazz bis hin zu Musicals reicht. Das Vokalensemble unter der Leitung von Anne-Laure Playoust besteht aus einem Dutzend erfahrener Sänger."
        ],
        "en": [
          "This concert, by the Boulonnais Conservatory Vocal Ensemble, covers an eclectic repertoire ranging from baroque to jazz and musical comedy. The vocal ensemble, under the direction of Anne-Laure Playoust, is made up of a dozen experienced singers."
        ],
        "it": [
          "Il concerto dell'ensemble vocale del Conservatorio di Boulonnais propone un repertorio eclettico che spazia dal barocco al jazz e alla commedia musicale. Diretto da Anne-Laure Playoust, l'ensemble è composto da una dozzina di cantanti esperti."
        ],
        "fr": [
          "Ce concert, par l’ensemble vocal du conservatoire du boulonnais, couvre un répertoire éclectique allant du baroque au jazz, en passant par la comédie musicale. Cet ensemble vocal, sous la direction d’Anne-Laure Playoust, est composé d’une douzaine de chanteurs confirmés."
        ],
        "es": [
          "Este concierto, a cargo del conjunto vocal del Conservatorio de Boulonnais, abarca un repertorio ecléctico que va del barroco al jazz, pasando por la comedia musical. Dirigido por Anne-Laure Playoust, el conjunto está formado por una docena de cantantes experimentados."
        ],
        "nl": [
          "Dit concert van het vocaal ensemble van het Boulonnais Conservatorium omvat een eclectisch repertoire van barok tot jazz en muzikale komedie. Het ensemble staat onder leiding van Anne-Laure Playoust en bestaat uit een dozijn ervaren zangers."
        ]
      },
