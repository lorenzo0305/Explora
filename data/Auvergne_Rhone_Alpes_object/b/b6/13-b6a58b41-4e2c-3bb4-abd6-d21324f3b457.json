  "rdfs:comment": {
    "de": [
      "Die drei Bibliotheken (Malissol, Estressin und Vallée de Gère) sind in den Wiener Bezirken verteilt und ergänzen das Dienstleistungsangebot der städtischen Mediathek.\r\nEin im Netzwerk registrierter Leser kann in allen Bibliotheken ausleihen."
    ],
    "en": [
      "This library works in  partenership with the main library of Vienne."
    ],
    "it": [
      "Le 3 biblioteche (Malissol, Estressin e Vallée de Gère) si trovano nei distretti di Vienne e completano la gamma di servizi offerti dalla mediateca comunale.\r\nUn lettore registrato nella rete può prendere in prestito da tutte le biblioteche."
    ],
    "fr": [
      "Répartie dans les quartiers viennois, les 3 bibliothèques (Malissol, Estressin et Vallée de Gère) complètent l'offre de services de la médiathèque municipale.\r\nUn lecteur inscrit dans le réseau peut emprunter dans toutes les bibliothèques."
    ],
    "es": [
      "Las 3 bibliotecas (Malissol, Estressin y Vallée de Gère) están situadas en los distritos de Vienne y completan la oferta de la mediateca municipal.\r\nUn lector registrado en la red puede tomar prestado de todas las bibliotecas."
    ],
    "nl": [
      "De drie bibliotheken (Malissol, Estressin en Vallée de Gère) bevinden zich in de wijken van Vienne en vervolledigen het aanbod van de gemeentelijke mediatheek.\r\nEen in het netwerk geregistreerde lezer kan uit alle bibliotheken lenen."
    ]
  },
