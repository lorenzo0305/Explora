  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt stellt Ihnen Folgendes zur Verfügung: touristische Dokumentation über die Destination Monts du Lyonnais und Umgebung (Lyon, Beaujolais, ...), Wanderkarten, Mountainbike-Routen, ... Organisation von Führungen durch das römische Aquädukt des Gier"
    ],
    "en": [
      "The Tourist Office provides you with : tourist documentation on the Monts du Lyonnais Destination and surroundings (Lyon, Beaujolais, ...), hiking maps, mountain bike circuits, ... Organization of guided tours of the Roman Aqueduct of Gier"
    ],
    "it": [
      "L'Ufficio del Turismo mette a disposizione: documentazione turistica sui Monts du Lyonnais e sulle zone circostanti (Lione, Beaujolais, ecc.), cartine escursionistiche, circuiti per mountain bike, ecc Organizzazione di visite guidate all'Acquedotto Romano di Gier"
    ],
    "fr": [
      "L’Office de Tourisme met à votre disposition : documentation touristique sur la Destination Monts du Lyonnais et alentours (Lyon, Beaujolais, ...), cartes de randonnées pédestres, circuits VTT, … Organisation de visites guidées de l’Aqueduc romain du Gier"
    ],
    "es": [
      "La Oficina de Turismo pone a su disposición: documentación turística sobre los Montes del Lyón y sus alrededores (Lyon, Beaujolais, etc.), mapas de senderismo, circuitos de bicicleta de montaña, etc Organización de visitas guiadas al acueducto romano de Gier"
    ],
    "nl": [
      "Het Office du Tourisme biedt u: toeristische documentatie over de Monts du Lyonnais en omgeving (Lyon, Beaujolais, enz.), wandelkaarten, mountainbikeroutes, enz. Organisatie van rondleidingen in het Romeinse aquaduct van de Gier"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Office de Tourisme des Monts du Lyonnais"
