  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5c33ebaa-a4df-3311-b54b-bb201d93965c",
      "dc:description": {
        "de": [
          "Freitag, 7. bis Sonntag, 9. November 2025\n\n4. RALLYE CLASSIC automobile CLASSIC CÔTE D'OPALE\nGastgeber ist Le Touquet Automobiles de Collection\n6/11: 7.30 Uhr - Abfahrt der Fahrzeuge nach Montreuillois und in die Gegend von Fruges\n18h - Rückkehr der Fahrzeuge vor dem Manoir Hôtel***\n7/11: 8 Uhr - Abfahrt der Fahrzeuge für Montreuillois und die Region Fruges\nAb 11:30 Uhr - Gymcana auf der Plattform hinter der Tribüne des Hippodroms."
        ],
        "en": [
          "Friday, November 7 to Sunday, November 9, 2025\n\n4TH RALLYE CLASSIC automobile CLASSIC CÔTE D'OPALE\nHosted by Le Touquet Automobiles de Collection\n6/11 : 7:30 am - Departure of vehicles for the montreuillois and Fruges region\n6pm - Vehicles return in front of the Manoir Hôtel***\n7/11: 8am - Departure of vehicles for the montreuillois and Fruges region\nFrom 11:30 am - Gymcana on the platform behind the Hippodrome grandstand."
        ],
        "it": [
          "Da venerdì 7 a domenica 9 novembre 2025\n\n4° RALLY CLASSICO automobilistico CÔTE D'OPALE\nOspitato da Le Touquet Automobiles de Collection\n6/11 : 7.30 - Partenza dei veicoli per la regione di Montreuil e Fruges\n18.00 - Ritorno dei veicoli davanti al Manoir Hôtel***\n7/11 : ore 8 - Partenza dei veicoli per la zona di Montreuil e la regione di Fruges\nDalle 11.30 - Gymcana sulla piattaforma dietro la tribuna dell'Ippodromo."
        ],
        "fr": [
          "Du vendredi 7 au dimanche 9 novembre 2025\n\n4ÈME RALLYE CLASSIC automobile CLASSIC CÔTE D'OPALE\nAccueilli par Le Touquet Automobiles de Collection\n6/11 : 7h30 - Départ des véhicules pour le montreuillois et la région de Fruges\n18h - Retour des véhicules devant le Manoir Hôtel***\n7/11 : 8h - Départ des véhicules pour le montreuillois et la région de Fruges\nÀ partir de 11h30 - Gymcana sur la plateforme à l'arrière de la tribune de l'Hippodrome."
        ],
        "nl": [
          "Van vrijdag 7 tot zondag 9 november 2025\n\n4DE RALLYE CLASSIC automobile CÔTE D'OPALE\nGeorganiseerd door Le Touquet Automobiles de Collection\n6/11 : 7u30 - Vertrek van de voertuigen naar de streek van Montreuil en Fruges\n18u00 - Voertuigen keren terug voor het Manoir Hôtel***\n7/11 : 8u - Vertrek van de voertuigen voor de streek van Montreuil en de streek van Fruges\nVanaf 11u30 - Gymcana op het platform achter de tribune van het Hippodrome."
        ],
        "es": [
          "Del viernes 7 al domingo 9 de noviembre de 2025\n\n4o RALLYE CLASSIC automóvil CÔTE D'OPALE\nOrganizado por Le Touquet Automobiles de Collection\n6/11 : 7.30 h - Salida de los vehículos hacia la región de Montreuil y Fruges\n18h - Regreso de los vehículos delante del Manoir Hôtel***\n7/11 : 8h - Salida de los vehículos para la región de Montreuil y Fruges\nA partir de las 11h30 - Gymcana en el andén detrás de la tribuna del Hipódromo."
        ]
      },
