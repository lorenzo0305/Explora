  "rdfs:comment": {
    "de": [
      "Alle Freuden des Wassers für Groß und Klein! Bewegen Sie sich, tanken Sie neue Energie und genießen Sie schöne Momente mit der Familie mit einem Sportbecken, Spiel- und Balneo-Entspannungsanlagen!"
    ],
    "en": [
      "All the pleasures of water for young and old! Come and work out, recharge your batteries and enjoy some family time in our sports pool, fun facilities and balneo-relaxation area!"
    ],
    "it": [
      "Tutti i piaceri dell'acqua per grandi e piccini! Venite ad allenarvi, a fare il pieno di energia e a divertirvi con la famiglia nella piscina sportiva, nel parco giochi e nelle strutture balneo-rilassanti!"
    ],
    "fr": [
      "Tous les plaisirs de l'eau pour petits et grands ! Venez vous dépenser, vous ressourcer, et profiter de bons moments en famille avec un bassin sportif, des installations ludiques et de balnéo-détente !"
    ],
    "es": [
      "Todos los placeres del agua para grandes y pequeños Venga a hacer ejercicio, a recargar las pilas y a disfrutar de buenos momentos con su familia en la piscina deportiva, el parque infantil y las instalaciones de balneo-relax"
    ],
    "nl": [
      "Alle geneugten van het water voor jong en oud! Kom trainen, nieuwe energie opdoen en geniet met uw gezin van het sportbad, de speeltuin en de balneo-ontspanningsfaciliteiten!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Over the River O"
    ],
    "fr": [
      "Au fil de l'Ô"
    ]
  },
