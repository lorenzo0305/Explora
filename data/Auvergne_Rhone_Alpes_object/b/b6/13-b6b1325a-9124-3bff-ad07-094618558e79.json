  "rdfs:comment": {
    "de": [
      "Kommen Sie und lassen Sie sich in die Kunst der Fotografie einführen oder perfektionieren Sie sie anhand von drei Themen: Makrofotografie, Porträt oder Landschaft!\r\nSie wünschen sich schöne Fotos von Ihnen? Ich stehe Ihnen auch für individuelle Shootings zur Verfügung!"
    ],
    "en": [
      "Come and learn or perfect your photographic skills through three themes: macro, portrait or landscape photography! Do you want great photos of yourself? I am also available for individual photo shoots!"
    ],
    "it": [
      "Venite a imparare o a perfezionare l'arte della fotografia attraverso tre temi: macro, ritratto o paesaggio!\r\nSe volete fare delle belle foto a voi stessi, sono disponibile anche per scatti individuali!"
    ],
    "fr": [
      "Venez vous initier ou perfectionner à l'art de la photographie à travers trois thèmes : macro photographie, portrait ou paysage !\r\nVous souhaitez de belles photos de vous ? je suis également à votre disposition pour des shooting individuels !"
    ],
    "es": [
      "Venga a aprender o perfeccionar el arte de la fotografía a través de tres temas: macrofotografía, retrato o paisaje\r\nSi quieres hacerte fotos bonitas, también estoy disponible para sesiones individuales"
    ],
    "nl": [
      "Kom U initiëren of vervolmaken in de kunst van de fotografie aan de hand van drie thema's:  macrofotografie, portret of landschap!\r\nU wenst mooie foto's van uzelf?  ik ben ook ter uwer beschikking voor individuele opnamen!"
    ]
  },
