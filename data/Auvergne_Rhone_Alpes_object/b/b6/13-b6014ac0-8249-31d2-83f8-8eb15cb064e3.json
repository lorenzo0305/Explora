  "rdfs:comment": {
    "de": [
      "Miniaturdorf : originelll  und naturgetreu spiegelt das kleine Dorf die ganz besondere Identität des Tals der Drobie, an dem es sich inspiriert, wider."
    ],
    "en": [
      "Come and explore the Ron des Fades (fairy rocks), a miniature village perched above the hamlet Pourcharesse in Dompnac. Pierre Bouvarel invites you to visit his artistic creation that he designed and built as an ideal Drobie valley village. This miniature world will delight adults and children alike!"
    ],
    "it": [
      "Al Ron des Fades (roccia delle fate), il tour inizia con una passeggiata insolita e favolosa attraverso un bosco di castagni secolari per scoprire il villaggio in miniatura delle Cévennes nella sua radura."
    ],
    "fr": [
      "Au Ron des Fades (rocher des fées), la visite commence par un insolite et fabuleux parcours sous un bois de châtaigniers multicentenaires pour découvrir dans sa clairière le village cévenol miniature."
    ],
    "es": [
      "En Ron des Fades (roca de las hadas), el recorrido comienza con un insólito y fabuloso paseo por un bosque de castaños centenarios para descubrir en su claro el pueblo en miniatura de las Cevenas."
    ],
    "nl": [
      "Bij Le Ron des Fades (de elfenrots) begint het bezoek met een uniek parcours door een eeuwenoud kastanjebos dat uitkomt op dit miniatuurdorp van de Drobie-vallei."
    ]
  },
  "rdfs:label": {
    "de": [
      "\"Le Ron des Fades (Feenfelsen)\""
    ],
    "en": [
      "Le monde merveilleux du pic des fées - Le Ron des Fades"
    ],
    "fr": [
      "Le monde merveilleux du pic des fées - Le Ron des Fades"
    ],
    "nl": [
      "Miniatuurdorp Le Ron des Fades"
    ]
  },
