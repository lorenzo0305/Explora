  "rdfs:comment": {
    "de": [
      "Dieses Museum entstand aus der Begegnung von Sport, Kunst und Literatur und wertet die Géo-Charles-Spende auf. Das Museum bleibt dem Geist von Géo-Charles treu, der der modernen Kunst und ihren Kühnheiten nahesteht."
    ],
    "en": [
      "Este museo nació del encuentro entre el deporte, el arte y la literatura. Valorando la donación Géo-Charles, el museo se mantiene fiel a su espíritu, cerca del arte contemporáneo y de su audacia."
    ],
    "it": [
      "Questo museo è nato dall'incontro tra sport, arte e letteratura e valorizza la donazione Géo-Charles. Il museo rimane fedele allo spirito di Géo-Charles, vicino all'arte moderna e alla sua audacia."
    ],
    "fr": [
      "Ce musée est  né de la rencontre du sport, de l'art et de la littérature et valorise la donation Géo-Charles. Le musée reste fidèle à l'esprit de Géo-Charles, proche de l'art moderne et de ses audaces."
    ],
    "es": [
      "Este museo, nacido del encuentro entre deporte, arte y literatura, expone la donación Géo-Charles. El museo se mantiene fiel al espíritu de Géo-Charles, cercano al arte moderno y a su audacia."
    ],
    "nl": [
      "Dit museum is ontstaan uit de ontmoeting tussen sport, kunst en literatuur en versterkt de schenking van Géo-Charles. Het museum blijft trouw aan de geest van Géo-Charles, dicht bij de moderne kunst en haar durf."
    ]
  },
