  "rdfs:comment": {
    "de": [
      "Isabelle Maillet ist Polstererin und Restauratorin und hat sich auf die Restaurierung und den Verkauf von Sesseln, die Anfertigung von Vorhängen und Kissen, das Patinieren von Kleinmöbeln und die Beratung in Sachen Dekoration spezialisiert."
    ],
    "en": [
      "Isabelle Maillet is an upholsterer-restorer specializing in the restoration and sale of armchairs, curtains and cushions, patina on small pieces of furniture and decorating advice."
    ],
    "it": [
      "Isabelle Maillet è una tappezziera e restauratrice specializzata nel restauro e nella vendita di poltrone, nella realizzazione di tende e cuscini, nella patinatura di piccoli mobili e nella consulenza sulla decorazione."
    ],
    "fr": [
      "Tapissier restaurateur, Isabelle Maillet est spécialisée dans la restauration et vente de fauteuils, la confection de rideaux et coussins, la patine sur petits meubles et conseils en décoration."
    ],
    "nl": [
      "Isabelle Maillet is een stoffeerder-restaurateur die gespecialiseerd is in het restaureren en verkopen van fauteuils, het maken van gordijnen en kussens, het patineren van kleine meubelstukken en het geven van decoratieadvies."
    ],
    "es": [
      "Isabelle Maillet es una tapicera y restauradora especializada en la restauración y venta de sillones, la confección de cortinas y cojines, la pátina de pequeños muebles y el asesoramiento en decoración."
    ]
  },
  "rdfs:label": {
