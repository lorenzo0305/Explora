  "rdfs:comment": {
    "de": [
      "Begeben Sie sich von Praz sur Arly aus auf eine unvergessliche Reise auf den Spuren von Jules Verne angesichts der höchsten Alpengipfel: Mont-Blanc-Massiv, Aravis, Beaufortain, Fiz, Bauges, Schweizer und italienische Alpen... die Berge entblößen sich und zeigen Ihnen ihre schönsten Facetten."
    ],
    "en": [
      "From Praz sur Arly, leave for an unforgettable journey in the footsteps of Jules Verne in front of the highest alpine peaks: Mont Blanc, Aravis, Beaufortain, Fiz, Bauges, Swiss and Italian Alps... the mountains are exposed and reveal their most beautiful facets."
    ],
    "it": [
      "Da Praz sur Arly, partite per un viaggio indimenticabile sulle orme di Jules Verne verso le cime più alte delle Alpi: il massiccio del Monte Bianco, gli Aravis, il Beaufortain, i Fiz, i Bauges, le Alpi svizzere e italiane... le montagne vi svelano le loro sfaccettature più belle."
    ],
    "fr": [
      "Au départ de Praz sur Arly, partez pour un voyage inoubliable sur les traces de Jules Verne face aux plus hauts sommets alpins : Massif du Mont-Blanc, Aravis, Beaufortain, Fiz, Bauges, Alpes Suisses, italiennes."
    ],
    "nl": [
      "Vanuit Praz sur Arly vertrekt u voor een onvergetelijke reis in de voetsporen van Jules Verne naar de hoogste toppen van de Alpen: het Mont Blanc-massief, de Aravis, de Beaufortain, de Fiz, de Bauges, de Zwitserse en Italiaanse Alpen... de bergen onthullen u hun mooiste facetten."
    ],
    "es": [
      "Desde Praz sur Arly, emprenda un viaje inolvidable tras las huellas de Julio Verne hacia las cumbres más altas de los Alpes: el macizo del Mont Blanc, el Aravis, el Beaufortain, los Fiz, el Bauges, los Alpes suizos e italianos... las montañas le revelarán sus facetas más bellas."
    ]
  },
