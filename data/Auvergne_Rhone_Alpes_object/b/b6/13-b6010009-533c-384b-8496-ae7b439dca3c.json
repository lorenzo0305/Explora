  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, Pizza, Hamburger, Tagesgerichte, Diätkost mit frischen Saisonprodukten, Terrasse im Sommer und Pub für verschiedene Getränke den ganzen Tag lang mit guter Stimmung."
    ],
    "ru": [
      "Традиционный ресторан, пицца, гамбургеры, блюда дня, диетические блюда из свежих и сезонных продуктов, летняя терраса и бар с различными напитками в течение всего дня с отличной атмосферой."
    ],
    "en": [
      "Bistronomic restaurant, pizzas and burger houses, corporate menu (17€) fresh and seasonal products, summer terrace and pub for various drinks all day with good atmosphere. Live sport on big screen, RMC sport, Bein Sport, Canal.... Free delivery of meals at home in the resort and sale of meals to take away all year."
    ],
    "it": [
      "Cucina bistronomica, pizze e hamburger fatti in casa, menu aziendale, prodotti freschi di stagione, terrazza estiva e grande atmosfera. Sport in diretta sul grande schermo. Consegna a domicilio gratuita e pasti da asporto disponibili tutto l'anno."
    ],
    "fr": [
      "Restauration bistronomique, pizzas et burger maisons, menu entreprises, produits frais de saison, terrasse l'été dans une bonne ambiance. Live sport sur grand écran. Livraisons de repas a domicile gratuite et vente de repas a emporter toute l'année."
    ],
    "es": [
      "Cocina bistronómica, pizzas y hamburguesas caseras, menú corporativo, productos frescos de temporada, terraza de verano y gran ambiente. Deporte en directo en pantalla gigante. Servicio a domicilio gratuito y comida para llevar durante todo el año."
    ],
    "nl": [
      "Bistronomische keuken, huisgemaakte pizza's en hamburgers, bedrijfsmenu, verse seizoensproducten, zomerterras en geweldige sfeer. Live sport op groot scherm. Gratis thuisbezorging en afhaalmaaltijden het hele jaar door."
    ]
  },
  "rdfs:label": {
