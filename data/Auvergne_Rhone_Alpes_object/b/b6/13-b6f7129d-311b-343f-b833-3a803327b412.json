  "rdfs:comment": {
    "de": [
      "Freier Zugang mit Informationstafel. In dem Bestreben, das ökologische, landschaftliche und ornamentale Potenzial der Tümpel hervorzuheben, hat sich die Gemeinde St-Fargeol dem Programm \"Mares communales de l'Allier, un patrimoine à préserver\" (kommunale Tümpel im Allier, ein zu bewahrendes Erbe) angeschlossen."
    ],
    "en": [
      "Free access with information panel. In order to enhance the environmental, landscaping and ornamental potential of the ponds, the commune of St-Fargeol has committed itself to the programme \"Ponds in the Allier, a heritage to be preserved\"."
    ],
    "it": [
      "Accesso libero con pannello informativo. Per valorizzare il potenziale ambientale, paesaggistico e ornamentale degli stagni, il comune di St-Fargeol ha aderito al programma \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ],
    "fr": [
      "Accès libre avec panneau d'information. Dans le souci de mettre en valeur le potentiel environnemental, paysager et ornemental des mares, la commune de St-Fargeol s'est engagée dans le programme \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ],
    "nl": [
      "Vrije toegang met informatiepaneel. De gemeente St-Fargeol heeft zich aangesloten bij het programma \"Mares communales de l'Allier, un patrimoine à préserver\" om het milieu-, landschaps- en sierpotentieel van de vijvers te versterken."
    ],
    "es": [
      "Acceso gratuito con panel informativo. Para valorizar el potencial medioambiental, paisajístico y ornamental de los estanques, el municipio de St-Fargeol se ha adherido al programa \"Mares communales de l'Allier, un patrimoine à préserver\"."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mare communale du Cros"
    ]
  },
