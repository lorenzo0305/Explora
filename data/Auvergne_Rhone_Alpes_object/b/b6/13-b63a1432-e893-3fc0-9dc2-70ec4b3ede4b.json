  "rdfs:comment": {
    "de": [
      "Ein echter Forézien-Pub, inspiriert von den besten irischen Pubs?8 Bierzapfanlagen und ein warmer, lebendiger Empfang, Boule- und Dartspiele, eine gesellige Rugby-Atmosphäre, um mit Freunden und Familie die Welt neu zu gestalten!"
    ],
    "en": [
      "A real Forézien pub inspired by the best Irish pubs... 8 beer taps and a warm, lively welcome, bowls and darts games, a rugby and friendly atmosphere to remake the world with friends and family!"
    ],
    "it": [
      "Un vero e proprio Forézien pub ispirato ai migliori pub irlandesi... 8 spillatori di birra e un'accoglienza calda e vivace, giochi di bocce e freccette, un'atmosfera da rugby e un modo amichevole di ritrovarsi con amici e familiari!"
    ],
    "fr": [
      "Un vrai pub forézien inspiré des meilleurs pubs irlandais…8 tireuses à bière et un accueil chaud et vivant, des jeux de boules et de fléchettes, une ambiance rugby et conviviale pour refaire le monde avec les amis et la famille !"
    ],
    "es": [
      "Un auténtico pub de Forézien inspirado en los mejores pubs irlandeses... 8 grifos de cerveza y una cálida y animada bienvenida, partidas de petanca y dardos, un ambiente de rugby y una forma agradable de ponerse al día con los amigos y la familia"
    ],
    "nl": [
      "Een echte Forézien pub geïnspireerd op de beste Ierse pubs... 8 biertaps en een warm en levendig onthaal, bowls- en dartspellen, een rugbysfeer en een gezellige manier om bij te praten met vrienden en familie!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "PAM Pub Art Music"
    ]
  },
