  "rdfs:comment": {
    "de": [
      "In einem Meer von Weinreben, im Herzen einer wilden und geschützten Natur gelegen, bietet unsere Domaine Terra Noé einen Weinberg von außergewöhnlicher Qualität, der das Schaufenster unseres Know-hows darstellt."
    ],
    "en": [
      "Set in a sea of vines, in the heart of unspoilt nature, our Domaine Terra Noé offers a vineyard of exceptional quality, a showcase for our expertise."
    ],
    "it": [
      "Immerso in un mare di vigneti, nel cuore di una natura selvaggia e incontaminata, il nostro Domaine Terra Noé offre un vigneto di qualità eccezionale, una vetrina per la nostra competenza."
    ],
    "fr": [
      "Situé dans un océan de vigne, au cœur d’une nature sauvage et préservée, notre Domaine Terra Noé offre un vignoble d’une qualité exceptionnelle, vitrine de notre savoir-faire."
    ],
    "es": [
      "Situado en un mar de viñas, en el corazón de un entorno natural salvaje y virgen, nuestro Domaine Terra Noé ofrece un viñedo de calidad excepcional, escaparate de nuestro saber hacer."
    ],
    "nl": [
      "Gelegen in een zee van wijnstokken, in het hart van een wilde en ongerepte natuurlijke omgeving, biedt ons Domaine Terra Noé een wijngaard van uitzonderlijke kwaliteit, een showcase voor onze expertise."
    ]
  },
