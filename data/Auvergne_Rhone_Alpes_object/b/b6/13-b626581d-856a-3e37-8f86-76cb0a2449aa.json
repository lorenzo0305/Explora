  "rdfs:comment": {
    "de": [
      "Restaurant am Fuße des Jacquemart, im Herzen des historischen Viertels. Entdecken Sie eine lokale und hausgemachte Küche, eine schöne Auswahl an Fleischsorten und Weinen."
    ],
    "en": [
      "Restaurant located at the foot of the Jacquemart, in the heart of the historic district. Come and discover local and homemade cuisine, a fine selection of meats and wines."
    ],
    "it": [
      "Ristorante situato ai piedi del Jacquemart, nel cuore del quartiere storico. Venite a scoprire la cucina locale e casalinga, una raffinata selezione di carni e vini."
    ],
    "fr": [
      "Restaurant situé au pied du Jacquemart, en plein cœur du quartier historique. Venez découvrir une cuisine locale et maison, une belle sélection de viandes et de vins ."
    ],
    "es": [
      "Restaurante situado a los pies del Jacquemart, en pleno casco histórico. Venga a descubrir la cocina local y casera, una cuidada selección de carnes y vinos."
    ],
    "nl": [
      "Restaurant gelegen aan de voet van de Jacquemart, in het hart van de historische wijk. Kom en ontdek de lokale en huisgemaakte keuken, een fijne selectie vleeswaren en wijnen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Ducs"
