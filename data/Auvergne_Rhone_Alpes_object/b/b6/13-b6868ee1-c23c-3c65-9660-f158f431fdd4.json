  "rdfs:comment": {
    "de": [
      "Für eine gesellige und schmackhafte Mahlzeit. Ob im Saal oder auf der Terrasse, in der Brasserie Le \"1933\" vermischen sich Geselligkeit, Schnelligkeit und Großzügigkeit."
    ],
    "en": [
      "For a delicious meal in a friendly setting. Inside or out on the terrasse, Brasserie Le \"1933\" offers a winning mix of friendly staff, speed and generous portions."
    ],
    "it": [
      "Per un pasto amichevole e gustoso. Nella sala da pranzo o sulla terrazza, la Brasserie Le \"1933\" unisce convivialità, velocità e generosità."
    ],
    "fr": [
      "Pour un repas convivial et savoureux. En salle ou en terrasse, la Brasserie Le \"1933\" mêle convivialité, rapidité et générosité."
    ],
    "nl": [
      "Voor een vriendelijke en smakelijke maaltijd. In de eetzaal of op het terras combineert de Brasserie Le \"1933\" gezelligheid, snelheid en gulheid."
    ],
    "es": [
      "Para una comida agradable y sabrosa. En el comedor o en la terraza, la Brasserie Le \"1933\" combina convivencia, rapidez y generosidad."
    ]
  },
