  "rdfs:comment": {
    "de": [
      "Parkplatz des Intermodalen Pols (neben der Fußgängerbrücke Bahnhof SNCF)\r\n- 180 Plätze\r\n- nicht überdacht, nicht videoüberwacht\r\n- parken mit oder ohne Abonnement\r\n- an Wochenenden und Feiertagen kostenlos\r\n- einfahrt auf 2,20 m (Höhe) und 5,50 m (Länge) begrenzt"
    ],
    "en": [
      "Pôle Intermodal parking lot (next to the SNCF station footbridge)\r\n- 180 spaces\r\n- not covered, not video-surveilled\r\n- parking with or without season ticket\r\n- free on weekends and public holidays\r\n- entrance limited to 2.20 m (height) and 5.50 m (length)"
    ],
    "it": [
      "Parcheggio Pôle Intermodal (accanto alla passerella della stazione SNCF)\r\n- 180 posti auto\r\n- non coperto, non videosorvegliato\r\n- parcheggio con o senza abbonamento\r\n- gratuito nei fine settimana e nei giorni festivi\r\n- ingresso limitato a 2,20 m (altezza) e 5,50 m (lunghezza)"
    ],
    "fr": [
      "Parking du Pôle Intermodal (à côté de la passerelle gare SNCF)\r\n- 180 places\r\n- non couvert, non vidéo-surveillé\r\n- stationnement avec ou sans abonnement\r\n- gratuit les week-ends et jours fériés\r\n- entrée limitée à 2,20 m (hauteur) et 5,50 m (longueur)"
    ],
    "nl": [
      "Parkeergarage Pôle Intermodal (naast de loopbrug van het SNCF-station)\r\n- 180 plaatsen\r\n- niet overdekt, geen videobewaking\r\n- parkeren met of zonder abonnement\r\n- gratis in het weekend en op feestdagen\r\n- toegang beperkt tot 2,20 m (hoogte) en 5,50 m (lengte)"
    ],
    "es": [
      "Aparcamiento Pôle Intermodal (junto a la pasarela de la estación SNCF)\r\n- 180 plazas\r\n- no cubierto, sin videovigilancia\r\n- aparcamiento con o sin abono\r\n- gratuito los fines de semana y días festivos\r\n- entrada limitada a 2,20 m (altura) y 5,50 m (longitud)"
    ]
  },
  "rdfs:label": {
