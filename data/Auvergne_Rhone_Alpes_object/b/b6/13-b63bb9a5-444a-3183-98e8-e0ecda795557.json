  "rdfs:comment": {
    "de": [
      "15 Minuten vom hektischen Lyon entfernt, in Saint-Priest, befindet sich eine Blase der Gelassenheit, in der das Gleichgewicht von Körper und Geist im Mittelpunkt jeder Erfahrung steht."
    ],
    "en": [
      "Just 15 minutes from the city of Lyon, in Saint-Priest, lies a serene haven where the balance of body and mind is at the heart of every experience."
    ],
    "it": [
      "A soli 15 minuti dal trambusto di Lione, Saint-Priest è una bolla di serenità dove l'equilibrio tra corpo e mente è al centro di ogni esperienza."
    ],
    "fr": [
      "A 15 minutes de l’effervescence de la ville de Lyon, à Saint-Priest, se trouve une bulle de sérénité où l’équilibre du corps et de l’esprit est au cœur de chaque expérience."
    ],
    "nl": [
      "Saint-Priest, op slechts 15 minuten van de drukte van Lyon, is een bubbel van sereniteit waar de balans tussen lichaam en geest centraal staat bij elke ervaring."
    ],
    "es": [
      "A sólo 15 minutos del bullicio de Lyon, Saint-Priest es una burbuja de serenidad donde el equilibrio entre cuerpo y mente está en el centro de cada experiencia."
    ]
  },
