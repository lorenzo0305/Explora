  "rdfs:comment": {
    "de": [
      "Der Poney Club du Bréda ist eine FFE-Reitschule. Ein idealer Ort, um das Reiten in einer freundlichen Atmosphäre zu entdecken und zu erlernen, vom Anfänger bis zum Fortgeschrittenen."
    ],
    "en": [
      "The Poney Club du Bréda is an FFE riding school. The ideal place to discover and learn horse riding in a friendly atmosphere, from beginners to advanced riders."
    ],
    "it": [
      "Il Poney Club du Bréda è una scuola di equitazione FFE. Il luogo ideale per scoprire e imparare l'equitazione in un'atmosfera amichevole, dai principianti agli esperti."
    ],
    "fr": [
      "Le Poney Club du Bréda est une école d'équitation FFE. Lieu idéal pour découvrir et apprendre l’équitation dans une ambiance conviviale du débutant au confirmé."
    ],
    "es": [
      "El Poney Club du Bréda es una escuela de equitación de la FFE. El lugar ideal para descubrir y aprender a montar a caballo en un ambiente agradable, desde principiantes hasta jinetes avanzados."
    ],
    "nl": [
      "De Poney Club du Bréda is een FFE manege. De ideale plek om paardrijden te ontdekken en te leren in een gezellige sfeer, van beginners tot gevorderden."
    ]
  },
