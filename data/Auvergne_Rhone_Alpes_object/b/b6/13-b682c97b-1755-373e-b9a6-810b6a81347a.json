  "rdfs:comment": {
    "de": [
      "AUFFÜHRUNG IN ZUSAMMENARBEIT MIT VICHY CULTURE\r\n\r\nNach dem Erfolg ihrer vorherigen Show FIQ! kehrt die Groupe acrobatique de Tanger für zwei außergewöhnliche Abende ins Théâtre de Cusset zurück."
    ],
    "en": [
      "SHOW CO-HOSTED WITH VICHY CULTURE\r\n\r\nFollowing the success of its previous show, FIQ!, the Tangier Acrobatic Group returns to the Théâtre de Cusset for two exceptional evenings."
    ],
    "it": [
      "SPETTACOLO CONDOTTO IN COLLABORAZIONE CON VICHY CULTURE\r\n\r\nDopo il successo del suo precedente spettacolo, FIQ! il Gruppo Acrobatico di Tangeri torna al Théâtre de Cusset per due serate eccezionali."
    ],
    "fr": [
      "SPECTACLE CO-ACCUEILLI AVEC VICHY CULTURE\r\n\r\nAprès le succès de son précédent spectacle FIQ !, le Groupe acrobatique de Tanger est de retour au Théâtre de Cusset pour deux soirées exceptionnelles."
    ],
    "nl": [
      "SHOW IN SAMENWERKING MET VICHY CULTURE\r\n\r\nNa het succes van zijn vorige show, FIQ! is de Tanger Acrobatic Group terug in het Théâtre de Cusset voor twee uitzonderlijke avonden."
    ],
    "es": [
      "PROGRAMA COPRESENTADO CON VICHY CULTURE\r\n\r\nTras el éxito de su espectáculo anterior, FIQ! el Grupo Acrobático de Tánger vuelve al Théâtre de Cusset para dos veladas excepcionales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "KA-IN • Groupe acrobatique de Tanger"
    ]
  },
