  "rdfs:comment": {
    "de": [
      "Einem klassischen Konzert zuzuhören bedeutet, sich treiben zu lassen: von den Emotionen, der eigenen Fantasie ... es bedeutet auch, auf alle Klänge, alle Farben des Stücks zu achten. Man muss in die Musik hineingehen."
    ],
    "en": [
      "Listening to a classical concert means letting yourself be carried away: by your emotions, your imagination... it also means being attentive to all the sounds and colors of the piece. You have to enter into the music."
    ],
    "it": [
      "Ascoltare un concerto di musica classica significa lasciarsi trasportare: dalle emozioni, dall'immaginazione... significa anche essere attenti a tutti i suoni e i colori del brano. Bisogna entrare nella musica."
    ],
    "fr": [
      "Ecouter un concert classique, c'est se laisser porter : par les émotions, son imagination... c'est aussi être attentif à tous les sons, toutes les couleurs du morceau. Il faut entrer dans la musique."
    ],
    "nl": [
      "Luisteren naar een klassiek concert betekent je laten meeslepen: door je emoties, je verbeelding... het betekent ook aandachtig luisteren naar alle klanken en kleuren van het stuk. Je moet in de muziek opgaan."
    ],
    "es": [
      "Escuchar un concierto de música clásica significa dejarse llevar: por las emociones, la imaginación... También significa estar atento a todos los sonidos y colores de la pieza. Hay que entrar en la música."
    ]
  },
  "rdfs:label": {
    "fr": [
