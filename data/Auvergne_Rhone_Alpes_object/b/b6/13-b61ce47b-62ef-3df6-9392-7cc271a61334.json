  "rdfs:comment": {
    "de": [
      "Das Historial du paysan soldat in Fleuriel, im Herzen des Allier zwischen Saint-Pourçain-sur-Sioule und Chantelle, ist ein Museum, das die Rolle der Bauern während des Ersten Weltkriegs beleuchtet."
    ],
    "en": [
      "The Historial du paysan soldat, located in Fleuriel, at the heart of the Allier department, between Saint-Pourçain and Chantelle, is a museum displays the peasant world during the Great War."
    ],
    "it": [
      "L'Historial du paysan soldat, situato a Fleuriel, nel cuore della regione dell'Allier, tra Saint-Pourçain-sur-Sioule e Chantelle, è un museo che mette in luce il posto del mondo contadino durante la Grande Guerra."
    ],
    "fr": [
      "L'Historial du paysan soldat situé à Fleuriel, au cœur de l'Allier, entre Saint-Pourçain-sur-Sioule et Chantelle, est un musée qui met en lumière la place du monde paysan pendant la Grande Guerre."
    ],
    "es": [
      "El Historial du paysan soldat, situado en Fleuriel, en el corazón de la región de Allier, entre Saint-Pourçain-sur-Sioule y Chantelle, es un museo que pone de relieve el lugar del mundo campesino durante la Gran Guerra."
    ],
    "nl": [
      "De Historial du Peasant Soldier in Fleuriel, in het hart van de Allier, is een museum dat een nieuwe blik werpt op de 2 wereldoorlogen in de twintigste eeuw,  en de gevolgen voor de regio."
    ]
  },
