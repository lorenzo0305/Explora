  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, Pizza, Hamburger, Tagesgerichte, Diätkost mit frischen Saisonprodukten, Terrasse im Sommer und Pub für verschiedene Getränke den ganzen Tag lang mit guter Stimmung."
    ],
    "ru": [
      "Традиционный ресторан, пицца, гамбургеры, блюда дня, диетические блюда из свежих и сезонных продуктов, летняя терраса и бар с различными напитками в течение всего дня с отличной атмосферой."
    ],
    "en": [
      "Bistronomic restaurant, pizzas and burger houses, corporate menu fresh and seasonal products, summer terrace and pub for various drinks all day with good atmosphere."
    ],
    "it": [
      "Cucina bistronomica, prodotti freschi di stagione, terrazza estiva e grande atmosfera.\r\nNovità 2025: il ristorante sta per ottenere la certificazione dietetica!"
    ],
    "fr": [
      "Restauration bistronomique, produits frais de saison, terrasse l'été dans une bonne ambiance. .\r\nNouveauté 2025 : Le restaurant est en cours de labélisation diététique !"
    ],
    "es": [
      "Cocina bistronómica, productos frescos de temporada, terraza de verano y buen ambiente .\r\nNovedad para 2025: ¡el restaurante está en proceso de obtener la certificación dietética!"
    ],
    "nl": [
      "Bistronomische keuken, verse seizoensproducten, zomerterras en geweldige sfeer .\r\nNieuw in 2025: Het restaurant is bezig met het verkrijgen van een diëtistische certificering!"
    ]
  },
