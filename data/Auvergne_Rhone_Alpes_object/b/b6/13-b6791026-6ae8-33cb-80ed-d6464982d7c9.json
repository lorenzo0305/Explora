  "rdfs:comment": {
    "de": [
      "Workshop zur Umwandlung von Obst in pasteurisierten Saft für Privatpersonen und Fachleute.\r\nLa vaudelinoise bietet auch eine eigene Linie von Bio-Produkten an, die aus seinen Umwandlungen hervorgegangen sind, hauptsächlich auf der Basis von Äpfeln."
    ],
    "en": [
      "Workshop for transforming fruit into pasteurized juice open to individuals and professionals.\r\nLa vaudelinoise also offers its own line of organic products resulting from its transformations, mainly based on apples."
    ],
    "it": [
      "Laboratorio di trasformazione della frutta in succo pastorizzato aperto a privati e professionisti.\r\nIl Vaudelinoise offre anche una propria linea di prodotti biologici derivanti dalla sua lavorazione, principalmente a base di mele."
    ],
    "fr": [
      "Atelier de transformation de fruits en jus pasteurisés ouvert aux particuliers et professionnels.\r\nLa vaudelinoise propose également sa propre ligne de produits biologiques issus de ses transformations essentiellement à base de pommes."
    ],
    "nl": [
      "Workshop voor de verwerking van fruit tot gepasteuriseerd sap open voor particulieren en professionals.\r\nDe Vaudelinoise biedt ook een eigen lijn van biologische producten die voortkomen uit de verwerking, voornamelijk op basis van appels."
    ],
    "es": [
      "Taller de transformación de fruta en zumo pasteurizado abierto a particulares y profesionales.\r\nLa Vaudelinoise también ofrece su propia línea de productos ecológicos resultantes de su procesamiento, principalmente a base de manzanas."
    ]
  },
