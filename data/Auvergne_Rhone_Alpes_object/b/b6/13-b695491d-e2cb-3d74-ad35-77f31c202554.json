  "rdfs:comment": {
    "de": [
      "Produzent von Balsamico aus 100% handgelesenen Trauben, der im Kessel gekocht wird, und von naturbelassenem Wein, Freilandgänsen und -hühnern, Highland-Rindern und Schafen in einer Herde. Mahlzeiten und Animationen für Gruppen von 20 Personen. Etappe des europäischen Wanderwegs Sur les Pas des Huguenots (Auf den Spuren der Hugenotten)."
    ],
    "en": [
      "We produce balsamic vinegar made 100% from grapes picked by hand and cooked in a cauldron. Our vines are naturally maintained by grazing sheep and we rear poultry in the orchards. We are situated on a botanical trail near the Cévenol faultline which is also part of the \"Sur les Pas des Huguenots\" European footpath."
    ],
    "it": [
      "Produttore di uve balsamiche 100% raccolte a mano e cotte in un calderone e di vino naturale, di oche e polli ruspanti, di mucche di alta montagna e di greggi di pecore. Pasti e intrattenimento per gruppi di 20 persone. Tappa del percorso europeo Sulle orme degli Ugonotti."
    ],
    "fr": [
      "Producteur de balsamique 100% raisin vendangé main cuit au chaudron et de vin nature, oies et poulets plein air, vaches highlands et brebis en troupeau. Repas et animations pour groupes de 20 personnes. Etape du sentier européen Sur les Pas des Huguenots."
    ],
    "es": [
      "Productor de uvas balsámicas 100% recogidas a mano y cocidas en caldero y vino natural, gansos y pollos de corral, vacas de las tierras altas y rebaños de ovejas. Comidas y animación para grupos de 20 personas. Parada en la ruta europea Tras las huellas de los hugonotes."
    ],
    "nl": [
      "Producent van 100% handgeplukte balsamico-druiven gekookt in een ketel en natuurlijke wijn, ganzen en kippen met vrije uitloop, hooglandkoeien en kuddes ooien. Maaltijden en animatie voor groepen van 20 personen. Tussenstop op de Europese route In de voetsporen van de hugenoten."
    ]
  },
