  "rdfs:comment": {
    "de": [
      "Zwischen Aubenas und Montélimar gelegen, empfängt Sie dieses Gebäude aus goldenem Stein aus der Ardèche.\r\nGourmet-Etappe in einem gemütlichen Rahmen.\r\nSpeisekarte des Restaurants auf unserer Website."
    ],
    "en": [
      "Located between Aubenas and Montélimar, this gold stoned building welcomes you as you begin your gastronomic exploration of Ardèche in a warm setting.\r\nRestaurant menu on the website."
    ],
    "it": [
      "Situato tra Aubenas e Montélimar, questo edificio in pietra dorata dell'Ardèche vi dà il benvenuto.\r\nUna sosta gourmet in un ambiente accogliente.\r\nMenu del ristorante sul nostro sito web."
    ],
    "fr": [
      "Située entre Aubenas et Montélimar, cette batisse en pierre dorée d'Ardèche vous accueille.\r\nEtape gourmande dans un cadre chaleureux.\r\nCarte du restaurant sur notre site internet."
    ],
    "es": [
      "Situado entre Aubenas y Montélimar, este edificio de piedra dorada del Ardèche le da la bienvenida.\r\nUna parada gastronómica en un entorno cálido.\r\nCarta del restaurante en nuestro sitio web."
    ],
    "nl": [
      "Gelegen tussen Aubenas en Montélimar, verwelkomt dit gouden stenen gebouw uit de Ardèche je.\r\nEen gastronomische tussenstop in een warme omgeving.\r\nRestaurantmenu op onze website."
    ]
  },
