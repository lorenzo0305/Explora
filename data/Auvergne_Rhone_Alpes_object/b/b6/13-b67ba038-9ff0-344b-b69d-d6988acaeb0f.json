  "rdfs:comment": {
    "de": [
      "Jedes Jahr im Januar kehrt das nationale Akkordeonfestival nach Val Cenis Termignon zurück. Konzerte, Abende in Bars und Restaurants, Künstler aus ganz Frankreich und dem Ausland und eine verdammt gute Stimmung im ganzen Ort."
    ],
    "en": [
      "Every January, the Festival national d'accordéon returns to Val Cenis Termignon. Concerts, evenings in bars and restaurants, artists from all over France and abroad, and a great atmosphere all over the resort."
    ],
    "it": [
      "Ogni anno, a gennaio, il Festival Nazionale della Fisarmonica torna a Val Cenis Termignon. Concerti, serate in bar e ristoranti, artisti provenienti da tutta la Francia e dall'estero e una grande atmosfera in tutta la località."
    ],
    "fr": [
      "Chaque année en janvier, le Festival national d’accordéon fait son retour à Val Cenis Termignon. Des concerts, des soirées dans les bars et restaurants, des artistes venus de toute la France et de l'étranger, et une sacrée ambiance sur toute la station."
    ],
    "nl": [
      "Elk jaar in januari keert het Nationale Accordeonfestival terug naar Val Cenis Termignon. Concerten, avonden in bars en restaurants, artiesten uit heel Frankrijk en het buitenland, en een geweldige sfeer in het hele resort."
    ],
    "es": [
      "Cada año en enero, el Festival Nacional del Acordeón vuelve a Val Cenis Termignon. Conciertos, veladas en bares y restaurantes, artistas de toda Francia y del extranjero, y un gran ambiente en toda la estación."
    ]
  },
  "rdfs:label": {
    "en": [
      "Val Cenis-Termignon National Accordion Festival 2027"
    ],
    "fr": [
      "Festival National d'Accordéon de Val Cenis-Termignon 2027"
    ],
    "nl": [
      "Nationaal Accordeonfestival Val Cenis-Termignon 2027"
    ]
  },
