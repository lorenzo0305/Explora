  "rdfs:comment": {
    "de": [
      "Feine Pâtisserie, 100% \"hausgemacht\" von Cécile Marcon, einer renommierten Konditorin.\r\nSchokolade, Eis, Cakes, Petit Fours..., Kekse aus unserer Kindheit ...\r\nEin handwerkliches Know-how und schmackhafte, lokale Leckereien, die Sie ohne Mäßigung genießen können..."
    ],
    "en": [
      "Fine patisserie, 100% home-made by Cécile Marcon, renowned pastry chef.\r\nChocolates, ice creams, cakes, petits fours, childhood cookies...\r\nArtisanal know-how and tasty local delicacies to be enjoyed without moderation..."
    ],
    "it": [
      "Pasticceria fine, 100% fatta in casa da Cécile Marcon, rinomata pasticcera.\r\nCioccolatini, gelati, torte, petits fours, biscotti della nostra infanzia...\r\nCompetenza artigianale e gustose prelibatezze locali da assaporare senza moderazione."
    ],
    "fr": [
      "Pâtisserie fine, 100% \"fait maison\" par Cécile Marcon, pâtissière de renom.\r\nChocolats, glaces, cakes, petits fours., biscuits de notre enfance ...\r\nUn savoir-faire artisanal et des gourmandises savoureuses et locales à déguster sans modération.."
    ],
    "es": [
      "Repostería fina, 100% casera, elaborada por Cécile Marcon, pastelera de renombre.\r\nChocolates, helados, pasteles, petits fours, galletas de nuestra infancia...\r\nUn saber hacer artesanal y sabrosas delicias locales para degustar sin moderación."
    ],
    "nl": [
      "Fijne gebakjes, 100% huisgemaakt door Cécile Marcon, een gerenommeerde patissier.\r\nChocolade, ijs, gebak, petits fours, koekjes uit onze kindertijd ...\r\nAmbachtelijke expertise en lekkere lokale lekkernijen om zonder mate van te genieten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pâtisserie fine Cécile Marcon"
    ]
  },
