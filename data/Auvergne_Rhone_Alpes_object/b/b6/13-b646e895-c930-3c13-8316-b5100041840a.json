  "rdfs:comment": {
    "de": [
      "Treten Sie mitten in die unberührte Natur der Gorges du Doux: 2 Kurse, die Sie mit Ihrer Familie oder Freunden auf der historischen Linie der Vivarais-Bahn entdecken können."
    ],
    "en": [
      "Pedal in the heart of the unspoilt nature of the Gorges du Doux: 4 courses to discover with family or friends on the historic line of the Vivarais Railway."
    ],
    "it": [
      "Provate le emozioni del Vélorail de l'Ardèche, nelle Gole del Doux.\r\nQuesta attività insolita offre un panorama a 360° sulla campagna.\r\nSeguite le rotaie e pedalate per 8, 12 o 20 km alla scoperta di paesaggi inaccessibili."
    ],
    "fr": [
      "Faites le plein de sensations avec le Vélorail de l'Ardèche, dans les Gorges du Doux.\r\nCette activité insolite offre un panorama à 360° en pleine nature.\r\nSuivez les rails et pédalez sur 8, 12 ou 20 km pour découvrir des paysages inaccessibles."
    ],
    "es": [
      "Experimente la emoción del Vélorail de l'Ardèche, en las Gorges du Doux.\r\nEsta insólita actividad ofrece una panorámica de 360° de la campiña.\r\nSiga los raíles y pedalee 8, 12 o 20 km para descubrir paisajes inaccesibles."
    ],
    "nl": [
      "Beleef de sensatie van de Ardèche Vélorail.\r\nDeze ongewone activiteit biedt een 360° panorama van het platteland.\r\nVolg de rails en trap 8, 12 of 20 km om ontoegankelijke landschappen te ontdekken."
    ]
  },
