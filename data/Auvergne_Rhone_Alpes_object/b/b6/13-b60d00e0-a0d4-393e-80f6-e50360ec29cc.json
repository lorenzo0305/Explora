  "rdfs:comment": {
    "de": [
      "Ob Sie eine außergewöhnliche Veranstaltung organisieren oder einfach nur einen Coworking-Tag einlegen möchten, wir heißen Sie in unseren verschiedenen Räumen willkommen."
    ],
    "en": [
      "Whether you'd like to organize a special event or simply enjoy a day of coworking, we welcome you to our different spaces."
    ],
    "it": [
      "Che vogliate organizzare un evento speciale o semplicemente una giornata di coworking, vi diamo il benvenuto nei nostri diversi spazi."
    ],
    "fr": [
      "Que vous souhaitez organiser un évènement hors du commun ou bien simplement faire une journée de coworking, nous vous accueillons dans nos différents espaces."
    ],
    "es": [
      "Tanto si desea organizar un evento especial como un simple día de coworking, le damos la bienvenida a nuestros diferentes espacios."
    ],
    "nl": [
      "Of je nu een speciaal evenement wilt organiseren of gewoon een dagje wilt coworking, we verwelkomen je graag in onze verschillende ruimtes."
    ]
