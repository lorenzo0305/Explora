  "rdfs:comment": {
    "de": [
      "Sparen & Geldanlagen. Vorsorge, Gesundheitsergänzung & Versicherungen auf Gegenseitigkeit. Kfz-, Hausrat-, Motorrad-, Lebens-, Multirisk-Versicherungen. Versicherungen für BTP, Unternehmen und Handwerker. Générali-Netzwerk."
    ],
    "en": [
      "Savings & financial investments. Provident, complementary health & mutual insurance. Car, home, motorcycle, life, multi-risk insurance... Construction, company & craftsman insurance. Generali network."
    ],
    "it": [
      "Risparmio e investimenti finanziari. Assicurazioni previdenziali, sanitarie complementari e mutualistiche. Assicurazione auto, casa, moto, vita, multirischi... Assicurazioni per l'edilizia e i lavori pubblici, per le aziende e gli artigiani. Rete generale."
    ],
    "fr": [
      "Épargne & placements financiers. Prévoyance, complémentaire santé & mutuelle. Assurances automobile, habitation, moto, vie, multirisque... Assurances BTP, d'entreprise & pour artisan. Réseau Générali."
    ],
    "nl": [
      "Sparen en financiële investeringen. Voorzorg-, aanvullende ziektekosten- & onderlinge verzekeringen. Auto-, opstal-, motor-, levens-, multirisicoverzekeringen... Verzekering voor bouw en openbare werken, bedrijven en ambachtslieden. Algemeen netwerk."
    ],
    "es": [
      "Ahorro e inversiones financieras. Previsión, salud complementaria y mutuas. Seguros de coche, hogar, moto, vida, multirriesgo... Seguros para la construcción y obras públicas, empresas y artesanos. Red Générali."
    ]
  },
