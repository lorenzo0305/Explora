  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/78673839-1757-3dba-8485-a5e96a181eaa",
      "dc:description": {
        "de": [
          "Der Club Nautique de Wimereux organisiert ein Rennen/eine Regatta \"La conviviale\"\n\nAnmeldungen am selben Morgen ab 9 Uhr.\n\nIm Anschluss an \"La Conviviale\" findet eine Auberge espagnole statt."
        ],
        "en": [
          "Club Nautique de Wimereux organizes \"La conviviale\" race/regatta\n\nRegistration in the morning at 9am.\n\nThe \"Conviviale\" will be followed by a \"auberge espagnole\"."
        ],
        "it": [
          "Il Club Nautique de Wimereux organizza una gara/regata chiamata \"La conviviale\"\n\nIscrizioni la mattina dell'evento a partire dalle 9.00.\n\nLa \"Conviviale\" sarà seguita da una \"auberge espagnole\"."
        ],
        "fr": [
          "Le Club Nautique de Wimereux organise une course/régate \"La conviviale\" \n\nInscriptions le matin même dès 9h.\n\nLa \"Conviviale\" sera suivie d'une auberge espagnole."
        ],
        "es": [
          "El Club Nautique de Wimereux organiza una regata llamada \"La conviviale\"\n\nInscripciones la mañana del evento a partir de las 9h.\n\nLa \"conviviale\" irá seguida de una \"auberge espagnole\"."
        ],
        "nl": [
          "De Club Nautique de Wimereux organiseert een race/regatta met de naam \"La conviviale\"\n\nInschrijving op de ochtend van het evenement vanaf 9 uur.\n\nDe \"Conviviale\" wordt gevolgd door een \"auberge espagnole\"."
        ]
      },
