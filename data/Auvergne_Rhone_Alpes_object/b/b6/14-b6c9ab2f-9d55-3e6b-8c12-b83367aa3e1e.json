  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/176b4738-996b-3038-8aba-356025ea1c1a",
      "dc:description": {
        "de": [
          "Direkt neben dem Restaurant Le Piccolino bietet Ihnen die Epicerie du Picco viele italienische Produkte an: Präsentkörbe, Süßwaren, Wurstwaren, Käse, Weine usw.\nAber auch einen Feinkostbereich, in dem Sie frische Pasta und Fertiggerichte entdecken können."
        ],
        "en": [
          "Right next door to Le Piccolino restaurant, l'Epicerie du Picco offers you a wide range of Italian products: baskets, sweets, cold meats, cheeses, wines...\nThere's also a catering section, where you can discover fresh pasta and ready-made dishes."
        ],
        "it": [
          "Proprio accanto al ristorante Le Piccolino, l'Epicerie du Picco offre una vasta gamma di prodotti italiani: pranzi al sacco, dolci, salumi, formaggi, vini...\nC'è anche una sezione dedicata alla ristorazione, dove si possono provare pasta fresca e piatti pronti."
        ],
        "fr": [
          "Juste à côté du restaurant Le Piccolino, l'Epicerie du Picco vous propose pleins de produits d'origine italienne : paniers garnis, confiseries, charcuteries, fromages, vins...\nMais aussi une partie traiteur, où vous pourrez découvrir les pâtes fraîches et des plats cuisinés."
        ],
        "nl": [
          "Vlak naast restaurant Le Piccolino biedt l'Epicerie du Picco je een hele reeks Italiaanse producten: lunchpakketten, zoetigheden, vleeswaren, kazen, wijnen...\nEr is ook een traiteurgedeelte, waar je verse pasta en kant-en-klare gerechten kunt proberen."
        ],
        "es": [
          "Justo al lado del restaurante Le Piccolino, l'Epicerie du Picco le ofrece toda una serie de productos italianos: almuerzos para llevar, dulces, embutidos, quesos, vinos...\nTambién hay una sección de restauración, donde podrá degustar pasta fresca y platos preparados."
        ]
      },
      "@type": [
        "Description"
      ],
