  "rdfs:comment": {
    "de": [
      "Wir bieten eine Karte mit außergewöhnlichen Fleischgerichten, die im Speisesaal auf dem Holzfeuer zubereitet werden. Diese Spezialität kann mit Gemüse der Saison und einer Auswahl an verschiedenen gemischten Salaten serviert werden"
    ],
    "en": [
      "We offer a menu of exceptional meats cooked over an open wood fire. This speciality can be accompanied by seasonal vegetables and a choice of various mixed salads"
    ],
    "it": [
      "Offriamo un eccezionale menu di carne cotta a fuoco aperto. Questa specialità può essere accompagnata da verdure di stagione e da una varietà di insalate miste"
    ],
    "fr": [
      "Nous proposons une carte de viande d'exception avec une cuisson au feu de bois en salle. Cette spécialité peut-être accompagnée de légumes de saisons et d'un choix de salade composées diverses et variées"
    ],
    "nl": [
      "We bieden een uitzonderlijk vleesmenu bereid boven een open vuur. Deze specialiteit kan worden vergezeld door seizoensgroenten en een verscheidenheid aan gemengde salades"
    ],
    "es": [
      "Ofrecemos un excepcional menú de carnes cocinadas a la brasa. Esta especialidad se puede acompañar con verduras de temporada y una variedad de ensaladas mixtas"
    ]
  },
  "rdfs:label": {
