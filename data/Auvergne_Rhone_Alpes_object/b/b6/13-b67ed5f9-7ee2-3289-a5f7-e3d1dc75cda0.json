  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geschichte der Seidenweberei in Charlieu vom 19. Jahrhundert bis heute. Nehmen Sie an einer Webvorführung teil, um das Geheimnis der komplexen Stofftechniken zu lüften. Bewundern Sie einige Kreationen, die in die Geschichte eingegangen sind..."
    ],
    "en": [
      "Discover the history of silk weaving in Charlieu, from the 19th century to the present day. Watch a weaving demonstration to discover the secrets of complex fabric techniques. Admire some of the creations that have gone down in history..."
    ],
    "it": [
      "Scoprite la storia della tessitura della seta a Charlieu, dal XIX secolo a oggi. Assistete a una dimostrazione di tessitura per scoprire i segreti delle complesse tecniche utilizzate per tessere questi tessuti. Ammirate alcune delle creazioni passate alla storia..."
    ],
    "fr": [
      "Découvrez l'histoire du tissage de la soie à Charlieu, du XIXe siècle à nos jours. Assistez à une démonstration de tissage pour percer le secret des techniques complexes des tissus. Admirez certaines créations restées dans l'histoire..."
    ],
    "nl": [
      "Ontdek de geschiedenis van de zijdeweverij in Charlieu, van de 19e eeuw tot nu. Bekijk een weefdemonstratie en ontdek de geheimen achter de complexe technieken om deze stoffen te weven. Bewonder enkele creaties die de geschiedenis zijn ingegaan..."
    ],
    "es": [
      "Descubra la historia del tejido de la seda en Charlieu, desde el siglo XIX hasta nuestros días. Asista a una demostración de tejido y descubra los secretos de las complejas técnicas utilizadas para tejer estas telas. Admire algunas de las creaciones que han pasado a la historia..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de la soierie"
    ]
  },
