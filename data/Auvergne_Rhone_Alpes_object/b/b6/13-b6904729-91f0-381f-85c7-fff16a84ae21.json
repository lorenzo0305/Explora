  "rdfs:comment": {
    "de": [
      "Individuelle Massagen: thailändisch, ayurvedisch, schwedisch (Sport).\r\nAyurvedische Untersuchungen: Erhaltung oder Wiedererlangung des gesundheitlichen Gleichgewichts dank des überlieferten indischen Wissens und der neuesten wissenschaftlichen Forschung."
    ],
    "en": [
      "Personalized massages: Thai, Ayurvedic, Swedish (sports).\r\nAyurvedic check-ups: maintain or regain balanced health thanks to ancestral Indian knowledge and the latest advances in scientific research."
    ],
    "it": [
      "Massaggi personalizzati: thailandese, ayurvedico, svedese (sportivo).\r\nCheck-up ayurvedico: mantenere o ritrovare uno stato di salute equilibrato grazie alle conoscenze indiane ancestrali e ai più recenti progressi della ricerca scientifica."
    ],
    "fr": [
      "Massages personnalisés: thaïlandais, ayurvédique, suédois (sportif).\r\nBilans ayurvédiques : conserver ou retrouver un équilibre de santé grâce aux connaissances ancestrales indiennes et aux dernières avancées de la recherche scientifique."
    ],
    "nl": [
      "Massages op maat: Thais, Ayurvedisch, Zweeds (sport).\r\nAyurvedische check-ups: behoud of herstel van een evenwichtige gezondheid dankzij voorouderlijke Indiase kennis en de nieuwste ontwikkelingen in wetenschappelijk onderzoek."
    ],
    "es": [
      "Masajes personalizados: tailandés, ayurvédico, sueco (deportivo).\r\nChequeos ayurvédicos: mantener o recuperar un estado de salud equilibrado gracias a los conocimientos ancestrales de la India y a los últimos avances de la investigación científica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Equilibre Massages & Ayurveda"
    ]
  },
