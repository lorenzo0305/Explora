  "rdfs:comment": {
    "de": [
      "Gemütliche Atmosphäre und gute Küche. Traditionelle und italienische Küche. Tagesmenü von Montag bis Mittwoch und Freitag, am Wochenende à la carte, am Abend nur am Freitag und Samstag geöffnet, am Donnerstag geschlossen."
    ],
    "en": [
      "Welcoming atmosphere and quality cuisine. Traditional and Italian cuisine. Daily menu from Monday to Wednesday and Friday, weekend à la carte, evening open only on Friday and Saturday, closed on Thursday."
    ],
    "it": [
      "Ambiente accogliente e cucina di qualità. Cucina tradizionale e italiana. Menù giornaliero da lunedì a mercoledì e venerdì, à la carte nei fine settimana, aperto solo di sera il venerdì e il sabato, chiuso il giovedì."
    ],
    "fr": [
      "Cadre accueillant et cuisine de qualité. Cuisine traditionnelle et italienne. Menu du jour du lundi au mercredi et vendredi, week-end à la carte, le soir ouvert uniquement le vendredi et le samedi, fermeture le jeudi."
    ],
    "nl": [
      "Gastvrije omgeving en kwaliteitskeuken. Traditionele en Italiaanse keuken. Dagmenu van maandag tot woensdag en vrijdag, à la carte in het weekend, 's avonds alleen open op vrijdag en zaterdag, gesloten op donderdag."
    ],
    "es": [
      "Ambiente acogedor y cocina de calidad. Cocina tradicional e italiana. Menú diario de lunes a miércoles y viernes, fines de semana a la carta, por la noche sólo abierto los viernes y sábados, cerrado los jueves."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bruges"
    ]
  },
