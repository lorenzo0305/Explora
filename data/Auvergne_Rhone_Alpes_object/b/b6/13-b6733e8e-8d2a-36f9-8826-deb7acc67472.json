  "rdfs:comment": {
    "de": [
      "Kleiner Familienbetrieb seit sieben Generationen, in mehreren Appellationen: Morgon, Fleurie, Chiroubles Brouilly, Cote de Brouilly und Chardonnay.\r\nZertifiziert nach TERRA VITIS und HVE seit 2018."
    ],
    "en": [
      "Smallholding spanning several appellations, inherited from seven generations of family vineyards. All our wines are produced using sustainable methods to respect the environment and consumers. TERRA VITIS and HVE certified since 2018."
    ],
    "it": [
      "Una piccola tenuta familiare da sette generazioni, con diverse denominazioni: Morgon, Fleurie, Chiroubles Brouilly, Cote de Brouilly e Chardonnay.\r\nCertificata TERRA VITIS e HVE dal 2018."
    ],
    "fr": [
      "Petite exploitation familiale depuis sept générations, sur plusieurs appellations : Morgon, Fleurie, Chiroubles Brouilly, Cote de Brouilly et Chardonnay.\r\nCertifiés TERRA VITIS et HVE depuis 2018."
    ],
    "es": [
      "Pequeña propiedad familiar desde hace siete generaciones, con varias denominaciones: Morgon, Fleurie, Chiroubles Brouilly, Cote de Brouilly y Chardonnay.\r\nCertificado TERRA VITIS y HVE desde 2018."
    ],
    "nl": [
      "Een klein familiedomein sinds zeven generaties, met verschillende appellations: Morgon, Fleurie, Chiroubles Brouilly, Cote de Brouilly en Chardonnay.\r\nTERRA VITIS en HVE gecertificeerd sinds 2018."
    ]
  },
