  "rdfs:comment": {
    "de": [
      "Kunstgalerie, die von einem Verein betrieben wird.\r\nNur wenige Schritte vom Stadtzentrum entfernt, am Fuße der mittelalterlichen Markthallen, können Sie zahlreiche Werke von Künstlern und Kunsthandwerkern entdecken."
    ],
    "en": [
      "Associative art gallery.\r\nJust a stone's throw from the town center, at the foot of the medieval covered market, you'll find a wealth of works by artists and craftspeople."
    ],
    "it": [
      "Galleria d'arte.\r\nA pochi passi dal centro della città, ai piedi del mercato coperto medievale, si possono scoprire numerose opere di artisti e artigiani."
    ],
    "fr": [
      "Galerie d’art associative.\r\nA quelques pas du centre ville, au pied des halles médiévales, vous pourrez découvrir de nombreuses oeuvres d’artistes et d’artisans d’art."
    ],
    "nl": [
      "Kunstgalerie.\r\nOp een steenworp afstand van het stadscentrum, aan de voet van de middeleeuwse overdekte markt, kun je een schat aan werken van kunstenaars en ambachtslieden ontdekken."
    ],
    "es": [
      "Galería de arte.\r\nA dos pasos del centro de la ciudad, al pie del mercado medieval cubierto, podrá descubrir una gran cantidad de obras de artistas y artesanos."
    ]
  },
