  "rdfs:comment": {
    "de": [
      "Angelfreunde können im Fluss Fûre auf Fischfang gehen. Die Fûre wird von der APPMN Haute Fûre-Val d'Ars verwaltet und erstreckt sich vom Ausgang des Lac de Paladru bis zur Kreuzung der 4 Kantone (Bonpertuis). Diese Strecke umfasst 5 Fischereireservate."
    ],
    "en": [
      "Come and try your luck in the Fûre River. Managed by the APPMN Haute Fûre-Val d'Ars, the Fûre stretches from the outlet of Lake Paladru to the crossroads of the four cantons (Bonpertuis). This route includes five fishing reserves."
    ],
    "it": [
      "Appassionati di pesca, venite a stuzzicare i pesci del fiume Fûre. Gestita dall'APPMN Haute Fûre-Val d'Ars, la Fûre si estende dallo sbocco del Lac de Paladru fino al crocevia dei 4 cantoni (Bonpertuis). Comprende 5 riserve di pesca."
    ],
    "fr": [
      "Amateurs de pêche, venez taquiner le poisson dans la rivière la Fûre. Gérée par l'APPMN Haute Fûre-Val d'Ars, la Fûre s'étend de la sortie du lac de Paladru au croisement des 4 cantons (Bonpertuis). Ce parcours comprend 5 réserves de pêche."
    ],
    "nl": [
      "Visliefhebbers, kom vissen in de Fûre. De Fûre wordt beheerd door de APPMN Haute Fûre-Val d'Ars en strekt zich uit van de uitmonding van het Lac de Paladru tot het kruispunt van de 4 kantons (Bonpertuis). Het omvat 5 visreservaten."
    ],
    "es": [
      "Aficionados a la pesca, vengan a tentar a los peces en el río Fûre. Gestionado por la APPMN Haute Fûre-Val d'Ars, el Fûre se extiende desde la desembocadura del lago de Paladru hasta el cruce de los 4 cantones (Bonpertuis). Incluye 5 cotos de pesca."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in Haute Fûre Val d'Ars"
    ],
    "fr": [
      "Pêche dans la Haute Fûre Val d'Ars"
    ]
  },
