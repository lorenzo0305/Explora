  "rdfs:comment": {
    "de": [
      "Alexis, ein leidenschaftlicher Fotograf, der sich auf Naturlandschaften und die Tierwelt der Alpen spezialisiert hat, bietet Fotokurse in den Bergen an und teilt sein Fachwissen und seine Leidenschaft, die Schönheit der Alpen mit innovativen Aufnahmetechniken einzufangen."
    ],
    "en": [
      "Alexis, a passionate photographer specializing in natural landscapes and alpine wildlife, offers mountain photography courses and shares his expertise and passion for capturing the beauty of the Alps with innovative shooting techniques."
    ],
    "it": [
      "Alexis, appassionato fotografo specializzato in paesaggi naturali e fauna alpina, offre corsi di fotografia di montagna e condivide la sua esperienza e la sua passione nel catturare la bellezza delle Alpi utilizzando tecniche di ripresa innovative."
    ],
    "fr": [
      "Alexis, photographe passionné, spécialisé dans les paysages naturels et la faune alpine, propose des cours de photographie en montagne et partage son expertise et sa passion pour capturer la beauté des Alpes avec des techniques de prise de vue innovantes."
    ],
    "es": [
      "Alexis, fotógrafo apasionado especializado en paisajes naturales y fauna alpina, ofrece cursos de fotografía de montaña y comparte su experiencia y pasión por captar la belleza de los Alpes mediante técnicas fotográficas innovadoras."
    ],
    "nl": [
      "Alexis, een enthousiaste fotograaf die gespecialiseerd is in natuurlijke landschappen en wilde dieren in de Alpen, biedt cursussen bergfotografie en deelt zijn expertise en passie voor het vastleggen van de schoonheid van de Alpen met behulp van innovatieve fotografietechnieken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Alpes et nature photographie"
    ]
  },
