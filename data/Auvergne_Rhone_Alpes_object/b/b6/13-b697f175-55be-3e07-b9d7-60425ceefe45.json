  "rdfs:comment": {
    "de": [
      "Das Matacena Club House heißt Sie willkommen :\r\n? Mittags: Traditionelles Essen (Speisekarte und Tagesmenü)\r\n? Den ganzen Tag und am Abend: gesellige Atmosphäre, erfrischende Getränke, Aperitifbretter (Wurst, Käse, Tapas)"
    ],
    "en": [
      "The Matacena Club House welcomes you: \r\n• Lunch: traditional catering (menu and menu of the day) \r\n• All day and in the evening: friendly atmosphere, refreshing drinks, aperitif boards (cold cuts, cheese, tapas)"
    ],
    "it": [
      "Il Matacena Club House vi accoglie : \r\n• Pranzo: ristorazione tradizionale (menu e menù del giorno) \r\n• Tutto il giorno e la sera: atmosfera conviviale, bevande rinfrescanti, aperitivo (salumi, formaggi, tapas)"
    ],
    "fr": [
      "Le Matacena Club House vous accueille : \r\n• Le midi : restauration traditionnelle (carte et menu du jour) \r\n• Tout la journée et en soirée : ambiance conviviale, boissons rafraîchissantes, planches apéro (charcuterie, fromage, tapas)"
    ],
    "es": [
      "La Casa Club Matacena le da la bienvenida :\r\n? A mediodía: restaurante tradicional (a la carta y menú del día)\r\n? Todo el día y por la noche: ambiente agradable, bebidas refrescantes, platos de aperitivo (embutidos, quesos, tapas), etc"
    ],
    "nl": [
      "Het Matacena Club House heet je van harte welkom:\r\n? Lunchtijd: traditioneel restaurant (à la carte en dagmenu)\r\n? De hele dag en avond: gezellige sfeer, verfrissende drankjes, aperitiefschotels (vleeswaren, kaas, tapas), enz"
    ]
  },
