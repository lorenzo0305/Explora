  "rdfs:comment": {
    "de": [
      "Mehrere lokale Bauernhöfe organisieren die Abholung einer Bio-Kiste, die jede Woche bestellt und jeden Dienstag im Rathaus von Saint-Théoffrey abgeholt werden kann."
    ],
    "en": [
      "Several local farms organize collect of an organic crate to be ordered each week and to pick up every friday at the town hall of Saint-Theoffrey."
    ],
    "it": [
      "Diverse fattorie organizzano la raccolta di una cassa bio da ordinare ogni settimane e da ritirare ogni martedi al municipio di Saint-Theoffrey"
    ],
    "fr": [
      "Plusieurs  fermes locales organisent le retrait d'une cagette bio à commander chaque semaine et à venir récupérer tous les mardis à la mairie de Saint-Théoffrey."
    ],
    "nl": [
      "Verschillende lokale boerderijen organiseren de inzameling van een biologische krat, die elke week kan worden besteld en elke dinsdag kan worden opgehaald op het gemeentehuis van Saint-Théoffrey."
    ],
    "es": [
      "Varias granjas locales organizan la recogida de una caja de productos ecológicos, que puede encargarse cada semana y recogerse todos los martes en el ayuntamiento de Saint-Théoffrey."
    ]
  },
