  "rdfs:comment": {
    "de": [
      "Das Dahu stellt Ihnen für Ihre privaten Feiern einen Barbereich im typischen Stil der Berge zur Verfügung.\r\nAuf Wunsch bietet Ihnen das Le Dahu einen Barkeeper oder eine Barmaid, die sich nur um Sie kümmert, mit privater Musik."
    ],
    "en": [
      "For your private parties, Le Dahu offers you a bar area, typical of the mountains.\r\nAt your request, Le Dahu can provide a bartender or barmaid to take care of you, with private music."
    ],
    "it": [
      "Per le vostre feste private, Le Dahu vi offre un'area bar, tipica delle montagne.\r\nSu richiesta, Le Dahu può fornire un barman o una barista che si occupi di voi, con musica privata."
    ],
    "fr": [
      "Le Dahu met à votre disposition, pour vos soirées privées, un espace bar, typiquement montagne.\r\nA votre demande, le Dahu vous propose un service de barman ou barmaid qui ne s’occupera que de vous, avec musique privative."
    ],
    "nl": [
      "Voor je privéfeesten biedt Le Dahu je een barruimte, typisch voor de bergen.\r\nOp jouw verzoek kan Le Dahu zorgen voor een barman of barmeid, met privémuziek."
    ],
    "es": [
      "Para sus fiestas privadas, Le Dahu pone a su disposición una zona de bar, típica de montaña.\r\nSi lo desea, Le Dahu puede poner a su disposición un barman o una camarera para atenderle, con música privada."
    ]
  },
