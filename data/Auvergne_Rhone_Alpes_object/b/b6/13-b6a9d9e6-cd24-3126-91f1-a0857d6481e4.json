  "rdfs:comment": {
    "de": [
      "In der Bibliothek des Dorfes finden Sie: Romane, Comics, regionale Zeitschriften und Bücher, Werke in Großdruck (Large Vision) etc.\r\nIn einem Lesesalon können Sie auch vor Ort lesen."
    ],
    "en": [
      "In the village library, you'll find novels, comics, magazines and regional books, large-print books (wide vision) etc...\nA reading room is also available for on-site reading."
    ],
    "it": [
      "Nella biblioteca del villaggio troverete: romanzi, fumetti, riviste e libri regionali, libri a caratteri grandi (wide vision) ecc...\nC'è anche una sala di lettura dove è possibile leggere sul posto."
    ],
    "fr": [
      "Retrouvez au sein de la bibliothèque du village : romans, bandes dessinées, magazines et livres régionaux, ouvrages en gros caractères (large vision) etc...\r\nUn salon de lecture vous permet de lire également sur place."
    ],
    "nl": [
      "In de dorpsbibliotheek vind je romans, stripboeken, tijdschriften en regionale boeken, boeken met grote letters (breedbeeld) enz.\r\nEr is ook een leeszaal waar je ter plaatse kunt lezen."
    ],
    "es": [
      "En la biblioteca del pueblo encontrará: novelas, cómics, revistas y libros regionales, libros de letra grande (visión amplia), etc.\r\nTambién hay una sala de lectura donde se puede leer in situ."
    ]
  },
