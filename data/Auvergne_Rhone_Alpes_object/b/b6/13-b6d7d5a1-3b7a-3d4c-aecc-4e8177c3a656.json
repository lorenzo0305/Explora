  "rdfs:comment": {
    "de": [
      "Der Val Park liegt auf 2500 m auf der Rückseite von Bellevarde (Massif de La Daille) in der Combe du Mont Blanc. Er ist nach Süden ausgerichtet und für alle Niveaus zugänglich, von der grünen Zone (Schule) bis zur schwarzen Zone (Experte)."
    ],
    "en": [
      "Located at 2500m on the reverse side of Bellevarde (La Daille massif), in the Combe du Mont Blanc, the Val Park faces due south and is accessible to all levels, from the green zone (school) to the black zone (expert)."
    ],
    "it": [
      "Situato a 2500 m sul versante opposto del Bellevarde (massiccio della Daille), nella Combe du Mont Blanc, il Val Park è esposto a sud ed è accessibile a tutti i livelli, dalla zona verde (scuola) alla zona nera (esperto)."
    ],
    "fr": [
      "Situé à 2500m sur l'envers de Bellevarde (massif de La Daille), dans la Combe du Mont Blanc, le Val Park est exposé plein sud et est accessible à tous les niveaux, de la zone verte (école) à la zone noire (expert)."
    ],
    "nl": [
      "Val Park ligt op 2500 meter aan de achterkant van Bellevarde (La Daille-massief), in de Combe du Mont Blanc. Het ligt op het zuiden en is toegankelijk voor alle niveaus, van de groene zone (school) tot de zwarte zone (expert)."
    ],
    "es": [
      "Situado a 2.500 m de altitud en la parte trasera de Bellevarde (macizo de La Daille), en la Combe du Mont Blanc, Val Park está orientado hacia el sur y es accesible a todos los niveles, desde la zona verde (escuela) hasta la zona negra (experto)."
    ]
  },
