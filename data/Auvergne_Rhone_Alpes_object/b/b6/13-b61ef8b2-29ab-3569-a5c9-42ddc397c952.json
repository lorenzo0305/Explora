  "rdfs:comment": {
    "de": [
      "Das TEC ist ein kultureller Ausstellungsraum, der auf die Initiative eines Kollektivs innerhalb des Vereins Altaz'art zurückgeht. Die Idee besteht darin, Künstlern, die Lust dazu haben, einen Ausstellungsraum anzubieten."
    ],
    "en": [
      "The TEC is a cultural exhibition space initiated by a collective within the association Altaz'art. The idea is to offer an exhibition space to artists who want it."
    ],
    "it": [
      "Il TEC è uno spazio espositivo culturale avviato da un collettivo all'interno dell'associazione Altaz'art. L'idea è quella di offrire uno spazio espositivo agli artisti che lo desiderano."
    ],
    "fr": [
      "Le TEC est un espace culturel d'exposition à l'initiative d'un collectif au sein de l'association Altaz'art . L'idée consiste à proposer aux artistes qui en ont envie un espace d'exposition."
    ],
    "es": [
      "El TEC es un espacio de exposición cultural iniciado por un colectivo de la asociación Altaz'art. La idea es ofrecer un espacio de exposición a los artistas que lo deseen."
    ],
    "nl": [
      "De TEC is een culturele tentoonstellingsruimte die is opgezet door een collectief binnen de vereniging Altaz'art. Het idee is om een tentoonstellingsruimte te bieden aan kunstenaars die dat willen."
    ]
  },
  "rdfs:label": {
    "fr": [
