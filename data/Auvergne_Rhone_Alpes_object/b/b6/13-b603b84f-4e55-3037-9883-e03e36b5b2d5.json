  "rdfs:comment": {
    "de": [
      "Lebensmittelgeschäft von lokalen Produzenten (mindestens 70%) ohne Verpackung mit Verkauf von losen Lebensmitteln (Mehl, Reis, Getreide, Kaffee, Tee...), Haushaltswaren, Produkten für die Körperpflege und Spirituosen."
    ],
    "en": [
      "Unwrapped grocery store from local producers (70% minimum) selling bulk food (flour, rice, cereals, coffee, teas, etc.), home care, personal hygiene products and spirits."
    ],
    "it": [
      "Negozio di alimentari di produttori locali (70% minimo) senza imballaggi, con vendita di alimenti sfusi (farina, riso, cereali, caffè, tè, ecc.), prodotti per la casa, per l'igiene personale e alcolici."
    ],
    "fr": [
      "Épicerie de producteurs locaux (70% minimum) sans emballage avec vente de vrac alimentaire ( farines, riz, céréales, café, thés...), de l'entretien pour la maison, des produits pour l'hygiène corporelle ainsi que des alcools."
    ],
    "es": [
      "Tienda de comestibles de productores locales (70% mínimo) sin envasar, que vende alimentos a granel (harina, arroz, cereales, café, tés, etc.), productos de cuidado del hogar, higiene personal y licores."
    ],
    "nl": [
      "Kruidenierswinkel van lokale producenten (minimaal 70%) zonder verpakking, met verkoop van bulkvoedsel (meel, rijst, granen, koffie, thee, enz.), huishoudelijke verzorging, producten voor persoonlijke hygiëne en sterke drank."
    ]
  },
