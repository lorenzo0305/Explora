  "rdfs:comment": {
    "de": [
      "Das Le Buddha Plage bietet Ihnen am Wasser eine traditionelle Küche mit frischen und größtenteils lokalen Produkten. In der Snackbar können Sie ein schnelles Mittagessen zu sich nehmen und die gemütliche Lounge der Bar genießen."
    ],
    "en": [
      "The Buddha Plage offers traditional cuisine based on fresh, mostly local ingredients. The snack bar is perfect for a quick lunch, and you can also enjoy the cosy lounge area of the bar."
    ],
    "it": [
      "Il Buddha Plage offre una cucina tradizionale a base di prodotti freschi, per lo più locali, proprio in riva al mare. A disposizione anche uno snack bar e un'accogliente area lounge."
    ],
    "fr": [
      "Le Buddha Plage vous propose au bord de l'eau, une cuisine traditionnelle à base de produits frais et pour la plupart locaux. Le côté snack vous permettra de déjeuner sur le pouce et vous pourrez également profiter de l'espace cosy lounge du bar."
    ],
    "es": [
      "El Buddha Plage ofrece cocina tradicional basada en productos frescos, en su mayoría locales, a orillas del agua. También hay un snack bar y un acogedor salón."
    ],
    "nl": [
      "Buddha Plage biedt een traditionele keuken op basis van verse, voornamelijk lokale producten, direct aan het water. Er is ook een snackbar en een gezellige loungeruimte."
    ]
  },
