  "rdfs:comment": {
    "de": [
      "Les Écuries liegt auf dem Gelände des Château d'Ygrande, Hotel-Restaurant****, und bietet Sport- und Freizeitreitern Ausritte, Fortbildungskurse, Dressur- oder Springkurse, Einführungen..."
    ],
    "en": [
      "Located on the grounds of the Château d'Ygrande, hotel-restaurant****, the stables offer horse riding, advanced training courses, dressage or jumping lessons, initiations... for sport or leisure riders."
    ],
    "it": [
      "Situato nel parco dello Château d'Ygrande, l'hotel-ristorante****, il maneggio offre ai cavalieri sportivi o di piacere passeggiate a cavallo, corsi di perfezionamento, lezioni di dressage o salto, iniziazioni..."
    ],
    "fr": [
      "Situé sur le domaine du château d'Ygrande, hôtel-restaurant****, les Écuries proposent aux cavaliers de sport ou de loisir des promenades à cheval, des stages de perfectionnement, des cours de dressage ou de saut, des initiations..."
    ],
    "es": [
      "Situada en el recinto del Château d'Ygrande, hotel-restaurante ****, la cuadra ofrece a los jinetes deportivos o de ocio paseos a caballo, cursos de perfeccionamiento, clases de doma o de salto, iniciaciones..."
    ],
    "nl": [
      "Gelegen op het terrein van het Château d'Ygrande, hotel-restaurant****, biedt de manege sport- of vrijetijdsruiters paardrijtochten, cursussen voor gevorderden, dressuur- of springlessen, initiaties..."
    ]
  },
