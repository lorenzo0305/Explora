  "rdfs:comment": {
    "de": [
      "Alpes Aventures stellt Ihnen seine Erfahrung und sein Wissen über die Bergwelt zur Verfügung, damit Sie die Freuden des Mountainbikens in den Aravis entdecken können!"
    ],
    "en": [
      "Alpes Aventures puts its experience and knowledge of the mountain environment at your service to help you discover the joys of mountain biking in the Aravis mountains!"
    ],
    "it": [
      "Alpes Aventures mette la sua esperienza e la sua conoscenza dell'ambiente montano al vostro servizio per farvi scoprire le gioie della mountain bike sui monti Aravis!"
    ],
    "fr": [
      "Alpes Aventures met à votre service son expérience et sa connaissance du milieu montagnard pour vous faire découvrir les joies du VTT dans les Aravis !"
    ],
    "nl": [
      "Alpes Aventures stelt zijn ervaring en kennis van de bergomgeving tot uw dienst om u de geneugten van het mountainbiken in het Aravis te laten ontdekken!"
    ],
    "es": [
      "Alpes Aventures pone su experiencia y su conocimiento del medio montañoso a su servicio para hacerle descubrir los placeres de la bicicleta de montaña en los montes Aravis"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mountain biking with Alpes Aventures"
    ],
    "fr": [
      "Sorties en VTT avec Alpes Aventures"
    ],
    "nl": [
      "Mountainbiken met Alpes Aventures"
    ]
  },
