  "rdfs:comment": {
    "de": [
      "Sie wünschen sich eine Begleitung bei der Vermietung Ihrer möblierten Immobilien über Airbnb oder Booking?\r\nDelegieren Sie die Verwaltung Ihrer Kurzzeitvermietungen an den Concierge-Service Les Grandes Maisons!\r\nWir bieten Ihnen eine schlüsselfertige Lösung."
    ],
    "en": [
      "Do you need help renting out your furnished properties on Airbnb or Booking?\r\nDelegate the management of your short-term rentals to Les Grandes Maisons concierge service!\r\nWe offer a turnkey solution."
    ],
    "it": [
      "Avete bisogno di aiuto per affittare le vostre proprietà ammobiliate su Airbnb o Booking?\r\nDelegate la gestione dei vostri affitti a breve termine al servizio di portineria di Les Grandes Maisons!\r\nOffriamo una soluzione \"chiavi in mano\"."
    ],
    "fr": [
      "Vous souhaitez un accompagnement pour louer vos biens meublés sur Airbnb ou Booking ?\r\nDéléguez la gestion de vos locations courte durée à la conciergerie Les Grandes Maisons ! \r\nNous offrons une solution clé en main."
    ],
    "es": [
      "¿Necesita ayuda para alquilar sus propiedades amuebladas en Airbnb o Booking?\r\nDelegue la gestión de sus alquileres de corta duración en el servicio de conserjería de Les Grandes Maisons\r\nLe proponemos una solución llave en mano."
    ],
    "nl": [
      "Heeft u hulp nodig bij het verhuren van uw gemeubileerde woningen op Airbnb of Booking?\r\nDelegeer het beheer van uw korte termijn verhuur aan de conciërgeservice van Les Grandes Maisons!\r\nWij bieden een kant-en-klare oplossing."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Conciergerie Les Grandes Maisons SAS"
    ]
  },
