      "dc:description": {
        "de": [
          "Der Cercle d'Études en Pays Boulonnais: Vortrag von Gatien WIEREZ\nAUFBAU EINER FAMILIE UND DIE DIENSTLEISTUNG FÜR DEN KÖNIG IM 18\nRDV von 18:30 bis 19:30 Uhr im Foyer communal Germaine-Dumortier\n107, rue de la Colonne\n\nFREIER EINTRITT"
        ],
        "en": [
          "Le Cercle d?Études en Pays Boulonnais: Lecture by Gatien WIEREZ\nBUILDING A FAMILY WHILE SERVING THE KING IN THE 18th CENTURY\n6:30 pm to 7:30 pm at Foyer communal Germaine-Dumortier\n107, rue de la Colonne\n\nFREE ADMISSION"
        ],
        "it": [
          "Il Cercle d'Études en Pays Boulonnais : Conferenza di Gatien WIEREZ\nCostruire una famiglia mentre si serviva il re nel XVIII secolo\nDalle 18.30 alle 19.30 presso il Foyer communal Germaine-Dumortier\n107, rue de la Colonne\n\nINGRESSO LIBERO"
        ],
        "fr": [
          "Le Cercle d’Études en Pays Boulonnais : Conférence de Gatien WIEREZ\nCONSTRUIRE UNE FAMILLE TOUT EN SERVANT LE ROI AU XVIIIe SIÈCLE\nRDV de 18h30 à 19h30 au Foyer communal Germaine-Dumortier\n107, rue de la Colonne\n\nENTRÉE GRATUITE"
        ],
        "nl": [
          "Le Cercle d'Études en Pays Boulonnais : Lezing door Gatien WIEREZ\nEEN FAMILIE OPBOUWEN IN DIENST VAN DE KONING IN DE 18e Eeuw\n18.30 tot 19.30 uur in de Foyer Communal Germaine-Dumortier\n107, Rue de la Colonne\n\nGRATIS TOEGANG"
        ],
        "es": [
          "Le Cercle d'Études en Pays Boulonnais : Conferencia de Gatien WIEREZ\nCONSTRUIR UNA FAMILIA AL SERVICIO DEL REY EN EL SIGLO XVIII\n18.30 h a 19.30 h en el Foyer communal Germaine-Dumortier\n107, rue de la Colonne\n\nENTRADA GRATUITA"
        ]
      },
