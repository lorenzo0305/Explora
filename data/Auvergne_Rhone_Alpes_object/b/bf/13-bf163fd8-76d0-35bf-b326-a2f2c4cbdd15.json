  "rdfs:comment": {
    "de": [
      "Auf dieser Wanderung können Sie die jurassischen Hochalmen entdecken. Spazieren Sie um die farbenfrohen Blumenfelder herum und genießen Sie jeden Moment!"
    ],
    "en": [
      "This walk takes you through the high alpine pastures of the Jura. Stroll around fields of multicolored flowers, and savor every moment!"
    ],
    "it": [
      "Questa passeggiata vi porterà attraverso i pascoli d'alta quota del Giura. Passeggiate tra i campi di fiori multicolori e assaporate ogni momento!"
    ],
    "fr": [
      "Cette balade vous permettra de découvrir les hauts alpages Jurassien. Promenez-vous autour des champs de fleurs multi couleurs, et savourez chaque moments !"
    ],
    "es": [
      "Este paseo le llevará por los pastos alpinos del Jura. Pasee por los campos de flores multicolores y saboree cada momento"
    ],
    "nl": [
      "Deze wandeling voert je door de hoge alpenweiden van de Jura. Wandel langs de veelkleurige bloemenvelden en geniet van elk moment!"
    ]
  },
