  "rdfs:comment": {
    "de": [
      "Das Montélimar Bowling verfügt über 9 Bowlingbahnen der neuesten Generation und eine Bar. Die großen Pisten sind für Kinder ab Größe 22 zugänglich, 2 Minipisten ab 2 Jahren. Billard und Tischfußball"
    ],
    "en": [
      "The Montélimar Bowling has 9 latest generation bowling lanes and a bar. The large slopes are accessible to children from size 22, 2 mini slopes accessible from 2 years old. Billiards and table football"
    ],
    "it": [
      "Il Bowling de Montélimar dispone di 9 piste da bowling all'avanguardia e di un bar. Le piste grandi sono accessibili ai bambini dal numero di scarpe 22 in su, mentre 2 piste mini sono accessibili a partire dai 2 anni. Biliardo e calcio balilla"
    ],
    "fr": [
      "Le Bowling de Montélimar dispose de 9 pistes de Bowling dernière génération et d'un bar. Les grandes pistes sont accessibles aux enfants à partir de la pointure 22, 2 mini pistes accessibles dès 2 ans. Billards et Babyfoot"
    ],
    "nl": [
      "De Montélimar Bowling beschikt over 9 bowlingbanen van de nieuwste generatie en een bar. De grote pistes zijn toegankelijk voor kinderen vanaf maat 22, 2 minipistes toegankelijk vanaf 2 jaar. Biljart en tafelvoetbal"
    ],
    "es": [
      "Bowling de Montélimar cuenta con 9 pistas de última generación y un bar. Las pistas grandes son accesibles para niños a partir de la talla 22, y 2 pistas mini son accesibles a partir de los 2 años. Billar y futbolín"
    ]
  },
