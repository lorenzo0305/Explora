  "rdfs:comment": {
    "de": [
      "365 Kilometer Strecken - 365 Tage voller Emotionen\r\nDas ganze Jahr über, bei Tag und bei Nacht, betreten Sie den Espace Trail des Baronnies in der Drôme Provençale und profitieren Sie von einem Angebot von 21 markierten und gesicherten Strecken sowie Trainingsworkshops."
    ],
    "en": [
      "365 kilometers of trail itineraries - 365 days of emotions\r\nDuring the whole year, come and discover « l’Espace Trail des Baronnies en Drôme Provençale » and enjoy the 21 marked and secured trails as well as training workshops !"
    ],
    "it": [
      "365 chilometri di percorsi - 365 giorni di emozioni\r\nTutto l'anno, di giorno o di notte, venite a godervi l'Espace Trail des Baronnies nella Drôme Provençale, con i suoi 21 circuiti segnalati e sicuri e i laboratori di allenamento."
    ],
    "fr": [
      "365 kilomètres d'itinéraires - 365 jours d'émotions\r\nToute l’année, de jour comme de nuit, venez fouler l’Espace Trail des Baronnies en Drôme Provençale et profitez d’une offre de 21 circuits balisés et sécurisés ainsi que des ateliers d’entraînement."
    ],
    "nl": [
      "365 kilometer routes - 365 dagen vol spanning\r\nKom het hele jaar door, dag en nacht, het Espace Trail des Baronnies in Drôme Provençale verkennen en profiteer van 21 bewegwijzerde, veilige circuits en trainingsworkshops."
    ],
    "es": [
      "365 kilómetros de rutas - 365 días de emoción\r\nDurante todo el año, de día o de noche, venga a disfrutar del Espace Trail des Baronnies en Drôme Provençale, con sus 21 circuitos señalizados y seguros y sus talleres de entrenamiento."
    ]
  },
  "rdfs:label": {
    "en": [
      "Trail park of the Baronnies in Drôme Provençale"
    ],
    "fr": [
      "Espace Trail des Baronnies en Drôme provençale"
    ]
  },
