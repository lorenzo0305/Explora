  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Sportmuseum, einen einzigartigen, interaktiven und pädagogischen Ort. Es zeigt eine Sammlung von Gegenständen, die lokalen, nationalen und internationalen Champions gehörten, die die Geschichte des Sports geprägt haben."
    ],
    "en": [
      "The Sports Museum is an outstanding hands-on educational venue. The collection of objects is constantly enriched with mementos that belonged to local, national and international champions who have left their mark in different sporting fields over the years."
    ],
    "it": [
      "Scoprite il museo dello sport, un luogo unico, interattivo ed educativo. Presenta una collezione di oggetti appartenenti a campioni locali, nazionali e internazionali che hanno segnato la storia dello sport."
    ],
    "fr": [
      "Découvrez le musée des sports, lieu unique, interactif et pédagogique. Il présente une collection d'objets  ayant appartenu à des champions locaux, nationaux et internationaux qui ont marqué l'histoire du sport."
    ],
    "nl": [
      "Ontdek het sportmuseum, een unieke, interactieve en educatieve plek. Het bevat een collectie voorwerpen van lokale, nationale en internationale kampioenen die hun stempel hebben gedrukt op de geschiedenis van de sport."
    ],
    "es": [
      "Descubra el museo del deporte, un lugar único, interactivo y educativo. Presenta una colección de objetos pertenecientes a campeones locales, nacionales e internacionales que han dejado su huella en la historia del deporte."
    ]
  },
  "rdfs:label": {
