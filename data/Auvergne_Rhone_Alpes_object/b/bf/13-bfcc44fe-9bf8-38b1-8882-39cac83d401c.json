  "rdfs:comment": {
    "de": [
      "Wettbewerb für Schäferhunde, Vorführung der Schur, Markt mit lokalen Produkten, musikalische Unterhaltung, kostenlose Hüpfburgen für Kinder, Mittagessen (Im Menü: Taboulé, gegrilltes Lamm und Kartoffeln, Käse und Dessert)."
    ],
    "en": [
      "Shepherd dog competition, shearing demonstration, local produce market, musical entertainment, free inflatable games for children, lunch (Menu: Tabbouleh, grilled lamb and potatoes, cheese and dessert)."
    ],
    "it": [
      "Gara di cani da pastore, dimostrazione di tosatura, mercato dei prodotti locali, intrattenimento musicale, giochi gonfiabili gratuiti per i bambini, pranzo (nel menu: Tabouleh, agnello e patate alla griglia, formaggio e dessert)."
    ],
    "fr": [
      "Concours de chiens de bergers, démonstration de tonte, marché de produits locaux, animation musicale, jeux gonflables gratuits pour les enfants, déjeuner (Au menu : Taboulé, grillades d'agneau et pommes de terre, fromage et dessert)."
    ],
    "nl": [
      "Herdershondenwedstrijd, scheerdemonstratie, markt met lokale producten, muzikaal entertainment, gratis opblaasbare spelletjes voor kinderen, lunch (op het menu: tabouleh, gegrild lamsvlees en aardappelen, kaas en dessert)."
    ],
    "es": [
      "Concurso de perros pastores, demostración de esquileo, mercado de productos locales, animación musical, juegos hinchables gratuitos para los niños, almuerzo (en el menú: tabulé, cordero a la parrilla con patatas, queso y postre)."
    ]
