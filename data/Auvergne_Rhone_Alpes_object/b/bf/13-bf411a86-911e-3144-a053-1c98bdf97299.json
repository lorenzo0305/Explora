  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen maßgeschneiderte Rahmen und Spiegel an.\r\nReproduktionen des Künstlers INIS.\r\nRestaurierung von alten Gemälden.\r\nBestellmöglichkeit per E-Mail oder Telefon und Click & Collect in der Rahmenwerkstatt."
    ],
    "en": [
      "We offer custom-made frames and mirrors.\nReproductions by the artist INIS.\nRestoration of old paintings.\nPossibility of ordering by email or telephone and Click & Collect at the frame shop."
    ],
    "it": [
      "Offriamo cornici e specchi su misura.\r\nRiproduzioni dell'artista INIS.\r\nRestauro di dipinti antichi.\r\nPossibilità di ordinare per e-mail o per telefono e di fare clic e ritirare presso il negozio di cornici."
    ],
    "fr": [
      "Nous vous proposons des cadres et des miroirs sur mesure.\r\nDes reproductions de l'artiste INIS.\r\nRestauration d'anciens tableaux.\r\nPossibilité de commander par email ou par téléphone et Click & Collect à l’atelier d’encadrement."
    ],
    "nl": [
      "Wij bieden op maat gemaakte lijsten en spiegels.\r\nReproducties van de kunstenaar INIS.\r\nRestauratie van oude schilderijen.\r\nMogelijkheid tot bestellen per e-mail of per telefoon en Click & Collect in de lijstenmakerij."
    ],
    "es": [
      "Ofrecemos marcos y espejos a medida.\r\nReproducciones del artista INIS.\r\nRestauración de cuadros antiguos.\r\nPosibilidad de hacer el pedido por correo electrónico o por teléfono y Click & Collect en la tienda de marcos."
    ]
  },
  "rdfs:label": {
    "en": [
      "Inis framing workshop"
    ],
    "fr": [
      "Atelier d'encadrement Inis"
    ]
  },
