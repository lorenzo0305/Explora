  "rdfs:comment": {
    "de": [
      "Betreten Sie das Zentrum des Genusses? Ihr Blick wird sofort auf das verlockende und reichhaltige Dessertbuffet gerichtet sein, das bereits zu einer Reise der Gaumenfreuden einlädt!"
    ],
    "en": [
      "Step into the heart of pleasure... and your eyes will immediately be drawn to the tempting and sumptuous dessert buffet, inviting you to embark on a gourmet journey!"
    ],
    "it": [
      "Entrate nel cuore del piacere... il vostro sguardo sarà immediatamente catturato dall'allettante e abbondante buffet di dolci che invita già a un viaggio goloso!"
    ],
    "fr": [
      "Entrez au cœur du plaisir… votre regard sera immédiatement rivé sur l’alléchant et l’abondant buffet de desserts qui invite déjà au voyage gourmand !"
    ],
    "nl": [
      "Stap binnen in het hart van het genot... uw blik zal onmiddellijk worden getrokken door het verleidelijke en overvloedige dessertbuffet dat u uitnodigt voor een culinaire reis!"
    ],
    "es": [
      "Adéntrese en el corazón del placer... ¡su mirada quedará inmediatamente cautivada por el apetecible y abundante bufé de postres que ya le invita a emprender un viaje gastronómico!"
    ]
  },
