  "rdfs:comment": {
    "de": [
      "Schließen Sie sich dem Templerorden an und versuchen Sie, die in der heiligen Stadt gefangenen Templer zu befreien! Eine immersive Untersuchung im Stil eines Escape Games unter freiem Himmel, im Herzen der Geschichte..."
    ],
    "en": [
      "Join the Order of the Temple and try to free the Templars trapped in the Holy City! An immersive outdoor Escape Game-style investigation into the heart of history..."
    ],
    "it": [
      "Unisciti all'Ordine del Tempio e cerca di liberare i Templari intrappolati nella Città Santa! Un'indagine coinvolgente in stile Escape Game all'aperto nel cuore della storia..."
    ],
    "fr": [
      "Rejoignez l'ordre du Temple et tentez de libérer les Templiers prisonniers de la ville sainte ! Une enquête immersive à la manière d'un Escape Game en plein air, au cœur de l'Histoire..."
    ],
    "es": [
      "Únete a la Orden del Temple e intenta liberar a los templarios atrapados en la Ciudad Santa Una inmersiva investigación al aire libre al estilo de los Juegos de Escape en el corazón de la historia..."
    ],
    "nl": [
      "Sluit je aan bij de Orde van de Tempel en probeer de Tempeliers te bevrijden die gevangen zitten in de Heilige Stad! Een meeslepend onderzoek in Escape Game-stijl in het hart van de geschiedenis..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "City Game : L'héritage des Templiers"
    ]
  },
