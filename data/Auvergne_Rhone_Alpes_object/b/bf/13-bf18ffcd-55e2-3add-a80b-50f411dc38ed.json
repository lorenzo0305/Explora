  "rdfs:comment": {
    "de": [
      "Mitten im Ferienort Les Arcs bietet Arcadella Pizza großzügige, handgemachte Pizzen aus frischen Zutaten und hochwertigem Teig für authentischen Geschmack. Ein lokales, Gourmet-Konzept mit einzigartigem Charakter, das ausschließlich zum Mitnehmen erhältlich ist."
    ],
    "en": [
      "In the heart of Les Arcs resort, Arcadella Pizza offers generous, handcrafted pizzas made with fresh ingredients and quality dough for an authentic taste. A local, gourmet, and unique concept available exclusively for takeout."
    ],
    "it": [
      "Nel cuore del resort Les Arcs, Arcadella Pizza offre pizze artigianali generose, preparate con ingredienti freschi e impasti di qualità per un gusto autentico. Un concept locale, gourmet e unico, disponibile esclusivamente per l'asporto."
    ],
    "fr": [
      "Au cœur de la station des Arcs, Arcadella Pizza propose des pizzas artisanales et généreuses, préparées avec des produits frais et une pâte de qualité pour un goût authentique. Un concept local, gourmand et unique à retrouver exclusivement à emporter."
    ],
    "nl": [
      "In het hart van resort Les Arcs biedt Arcadella Pizza royale, ambachtelijke pizza's, bereid met verse ingrediënten en kwaliteitsdeeg voor een authentieke smaak. Een lokaal, gastronomisch en uniek concept, exclusief beschikbaar voor afhaal."
    ],
    "es": [
      "En el corazón de la estación de Les Arcs, Arcadella Pizza ofrece generosas pizzas caseras, preparadas con productos frescos y masa de calidad para un sabor auténtico. Un concepto local, gourmet y único, disponible exclusivamente para llevar."
    ]
  },
