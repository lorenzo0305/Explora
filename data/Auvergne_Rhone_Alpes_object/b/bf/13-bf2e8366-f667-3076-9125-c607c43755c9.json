  "rdfs:comment": {
    "de": [
      "Ein Skitag, der für Menschen mit Behinderungen und Senioren geeignet ist. Kartski-Kurse und Tandemski-Fahrten sind nach vorheriger Anmeldung möglich. Ermäßigte Skipässe für Personen mit eigenem Sitzski."
    ],
    "en": [
      "A day of skiing for people with disabilities and the elderly. With kartski lessons and tandem ski descents available for booking and reduced price forfaits for anyone with their own sit ski."
    ],
    "it": [
      "Una giornata di sci adattata alle persone con disabilità e agli anziani. Lezioni di kartski e discese in tandem su prenotazione, e pass a prezzo ridotto per chi possiede un proprio sci da sedere."
    ],
    "fr": [
      "Une journée de ski adaptée aux personnes en situation de handicap et aux seniors. Cours de kartski et descentes en tandemski disponibles sur réservation, et forfaits à tarif réduit pour les personnes possédant leur propre ski assis."
    ],
    "es": [
      "Un día de esquí adaptado para personas con discapacidad y mayores. Clases de kartski y descensos en tándem previa reserva, y forfaits a precio reducido para personas con su propio sit-ski."
    ],
    "nl": [
      "Een dag skiën aangepast voor mensen met een handicap en senioren. Kartskilessen en tandemski-afdalingen op reservering, en skipassen met korting voor mensen met een eigen zit-ski."
    ]
  },
  "rdfs:label": {
