  "rdfs:comment": {
    "de": [
      "La Mandarine bietet Ihnen eine schöne, abwechslungsreiche Speisekarte mit gebackenen Galettes und traditionellen Gerichten à la carte, die aus lokalen Produkten der Saison hergestellt werden. Unter der Woche gibt es jeden Mittag ein Tagesmenü. Tagesgericht zum Mitnehmen auf Reservierung (10?)."
    ],
    "en": [
      "La Mandarine offers a varied menu of galettes and traditional à la carte dishes based on local seasonal produce. Daily lunch menu weekdays. Daily takeaway lunch available on reservation (10?)."
    ],
    "it": [
      "La Mandarine offre un menu vario di galette cotte e piatti tradizionali à la carte, utilizzando prodotti locali di stagione. Menu giornaliero per il pranzo durante la settimana. Piatto del giorno da asporto a pranzo su prenotazione (10?)."
    ],
    "fr": [
      "La Mandarine vous propose une belle carte variée de galettes cuisinées et de plats traditionnels à la carte, à base de produits locaux de saison. Menu du jour chaque midi en semaine. Plat du jour à emporter les midis sur réservation (10€)."
    ],
    "es": [
      "La Mandarine ofrece un menú variado de galettes cocidas y platos tradicionales a la carta, con productos locales de temporada. Menú del día entre semana. Plato del día para llevar al mediodía previa reserva (10?)."
    ],
    "nl": [
      "La Mandarine biedt een gevarieerd menu van gekookte galettes en traditionele à la carte gerechten, met lokale seizoensproducten. Dagelijks lunchmenu tijdens de week. Afhaalmaaltijd van de dag tijdens de lunch op reservering (10?)."
    ]
  },
