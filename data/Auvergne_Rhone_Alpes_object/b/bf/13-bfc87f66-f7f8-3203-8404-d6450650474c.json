  "rdfs:comment": {
    "de": [
      "Produktion und Destillation von aromatischen und medizinischen Pflanzen, aus biologischem Anbau.\r\nVom Feld bis zum Flakon kümmern wir uns um die Pflanzen, um Ihnen das Beste zu bieten.\r\nTauchen Sie während der Besuchszeiten in diese Welt ein."
    ],
    "en": [
      "Production and distillation of medicinal plants.\r\nFrom the field to the bottle, we take care of the plants to offer you the best. Immerse yourself in this world during visiting hours."
    ],
    "it": [
      "Produzione e distillazione biologica di piante aromatiche e medicinali.\r\nDal campo alla bottiglia, ci prendiamo cura delle nostre piante per offrirvi il meglio.\r\nImmergetevi in questo mondo durante i nostri orari di apertura."
    ],
    "fr": [
      "Production et distillation de plantes aromatiques et médicinales, en Agriculture Biologique.\r\nDu champ au flacon, nous prenons soin des plantes pour vous proposer le meilleur.\r\nPlongez vous dans cet univers le temps d'une immersion aux heures de visite."
    ],
    "nl": [
      "Production and distillation of medicinal plants.\r\nFrom the field to the bottle, we take care of the plants to offer you the best. Immerse yourself in this world during visiting hours."
    ],
    "es": [
      "Producción ecológica y destilación de plantas aromáticas y medicinales.\r\nDel campo a la botella, cuidamos nuestras plantas para ofrecerle lo mejor.\r\nSumérjase en este mundo durante nuestro horario de apertura."
    ]
  },
