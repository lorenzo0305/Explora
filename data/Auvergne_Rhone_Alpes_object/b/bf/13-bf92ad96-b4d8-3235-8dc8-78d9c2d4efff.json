  "rdfs:comment": {
    "de": [
      "Als handwerklicher Brauer seit 2012 bietet Ouroboros charaktervolle Biere, Met, Limonaden und Destillate an. Eine lokale, kreative und sich ständig weiterentwickelnde Produktion, die im Laden im Direktverkauf und in mehreren Verkaufsstellen in der Region erhältlich ist."
    ],
    "en": [
      "An artisan brewer since 2012, Ouroboros offers beers with character, mead, lemonade and distillates. A local, creative and constantly evolving production, available at the direct sales boutique and in several local outlets."
    ],
    "it": [
      "Produttore di birra artigianale dal 2012, Ouroboros offre birre di carattere, idromele, limonate e distillati. Una produzione locale, creativa e in continua evoluzione, disponibile nel negozio di vendita diretta e in diversi punti vendita della regione."
    ],
    "fr": [
      "Artisan brasseur depuis 2012, Ouroboros propose bières de caractère, hydromel, limonade et distillats. Une production locale, créative et en perpétuelle évolution, disponible à la boutique en vente directe et dans plusieurs points de vente du territoire."
    ],
    "nl": [
      "Ouroboros is een ambachtelijke brouwer sinds 2012 en biedt karaktervolle bieren, honingdrank, limonade en distillaten. Een lokale, creatieve en voortdurend evoluerende productie, verkrijgbaar in de directe verkoopwinkel en in verschillende verkooppunten in de regio."
    ],
    "es": [
      "Cervecera artesanal desde 2012, Ouroboros ofrece cervezas con carácter, hidromiel, limonada y destilados. Una producción local, creativa y en constante evolución, disponible en la tienda de venta directa y en varios puntos de venta de la región."
    ]
  },
