  "rdfs:comment": {
    "de": [
      "Der Sattler fertigt Sitze, Sessel, Bänke und alle Arten von Ausstattungen an, für die weiche Materialien und verschiedene Arten von Füllungen, hauptsächlich Polyurethanschaum, erforderlich sind"
    ],
    "en": [
      "The upholsterer makes seats, armchairs, benches and all types of equipment requiring flexible materials and different types of trim, mainly polyurethane foams."
    ],
    "it": [
      "Il tappezziere realizza sedili, poltrone, panche e tutti i tipi di attrezzature che richiedono materiali flessibili e diversi tipi di imbottitura, principalmente schiume poliuretaniche"
    ],
    "fr": [
      "Le sellier garnisseur confectionne des sièges, des fauteuils, des banquettes et tous types d'équipements nécessitant des matériaux souples et différents types de garnitures, principalement des mousses polyuréthanes"
    ],
    "es": [
      "El tapicero fabrica asientos, sillones, bancos y todo tipo de equipamiento que requiera materiales flexibles y diferentes tipos de tapicería, principalmente espumas de poliuretano"
    ],
    "nl": [
      "De stoffeerder maakt stoelen, fauteuils, banken en alle soorten apparatuur waarvoor flexibele materialen en verschillende soorten bekleding nodig zijn, voornamelijk polyurethaanschuim"
    ]
  },
