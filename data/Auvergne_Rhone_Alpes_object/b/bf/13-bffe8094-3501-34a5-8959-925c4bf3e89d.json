  "rdfs:comment": {
    "de": [
      "Durch die Entwicklung der \"Musikbäder\" hat Flaine einen Konzertsaal mit über 500 Plätzen und einer besonders gut durchdachten Akustik erhalten."
    ],
    "en": [
      "With the development of the \"bains de musique\" (music baths), Flaine now has a concert hall with over 500 seats and specially designed acoustics."
    ],
    "it": [
      "Con lo sviluppo dei \"bains de musique\" (bagni di musica), Flaine dispone ora di una sala concerti con oltre 500 posti a sedere e un'acustica appositamente progettata."
    ],
    "fr": [
      "De par le développement des « bains de musique », Flaine s’est équipée d’une salle de concert de plus de 500 places à l’acoustique particulièrement étudiée."
    ],
    "nl": [
      "Dankzij de ontwikkeling van \"bains de musique\" (muziekbaden) heeft Flaine nu een concertzaal met meer dan 500 zitplaatsen en een speciaal ontworpen akoestiek."
    ],
    "es": [
      "Con el desarrollo de los \"bains de musique\" (baños de música), Flaine dispone ahora de una sala de conciertos con más de 500 plazas y una acústica especialmente diseñada."
    ]
  },
