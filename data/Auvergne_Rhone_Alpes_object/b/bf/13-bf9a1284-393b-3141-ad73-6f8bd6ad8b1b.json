  "rdfs:comment": {
    "de": [
      "Unser Team steht Ihnen zur Verfügung, um alle Ihre Reisepläne zu prüfen und zu organisieren, egal ob kurz oder lang, nah oder fern, allein, zu zweit, mit der Familie oder mit Freunden."
    ],
    "en": [
      "Our team is at your service to study and organize all your travel plans, whether short or long, near or far, alone, as a couple, with family or friends."
    ],
    "it": [
      "Il nostro team è a disposizione per studiare e organizzare tutti i vostri programmi di viaggio, brevi o lunghi, vicini o lontani, da soli, in coppia, con la famiglia o con gli amici."
    ],
    "fr": [
      "Notre équipe est à votre écoute pour étudier et organiser tous vos projets de voyages, qu’ils soient courts ou longs, proches ou lointains, seul, en couple, en  famille  ou entre amis."
    ],
    "nl": [
      "Ons team is er om je te helpen bij het plannen en organiseren van al je reisplannen, of ze nu kort of lang zijn, dichtbij of ver weg, alleen, met z'n tweeën, met familie of vrienden."
    ],
    "es": [
      "Nuestro equipo está a su disposición para estudiar y organizar todos sus planes de viaje, ya sean cortos o largos, cercanos o lejanos, solo, en pareja, en familia o con amigos."
    ]
  },
