  "rdfs:comment": {
    "de": [
      "Der Zugang ist frei. Im 6. Jahrhundert findet der Sklave Portianus, der von einem brutalen Meister befreit wurde, in Mirandense, wie der Ort früher hieß, Zuflucht in einem Kloster, das den Fluss Sioule überblickt."
    ],
    "en": [
      "Free access. In the 6th century, the slave Portianus, freed from a brutal master, found refuge in Mirandense, the ancient name of the village, in a monastery overlooking the Sioule river."
    ],
    "it": [
      "Ingresso libero. Nel VI secolo, lo schiavo Portianus, liberato da un padrone brutale, trovò rifugio a Mirandense, l'antico nome del villaggio, in un monastero che si affacciava sul fiume Sioule."
    ],
    "fr": [
      "Accès libre. Au VIème siècle, l’esclave Portianus, affranchi d’un maitre brutal, trouve refuge à Mirandense, ancien nom du bourg, dans un monastère dominant la rivière de la Sioule."
    ],
    "nl": [
      "Gratis toegang. In de 6e eeuw vond de slaaf Portianus, bevrijd van een wrede meester, onderdak in Mirandense, de oude naam van het dorp, in een klooster met uitzicht op de rivier de Sioule."
    ],
    "es": [
      "Entrada gratuita. En el siglo VI, el esclavo Portianus, liberado de un amo brutal, encontró refugio en Mirandense, antiguo nombre del pueblo, en un monasterio que domina el río Sioule."
    ]
  },
