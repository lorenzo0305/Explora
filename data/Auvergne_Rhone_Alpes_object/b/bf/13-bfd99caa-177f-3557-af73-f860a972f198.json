  "rdfs:comment": {
    "de": [
      "Angeln ist den Mitgliedern der Gaule Dizimolane und den Einwohnern von Dizimieu vorbehalten. Teich mit Raubfischen, Karpfen, Schleien, Schwarzbarsch.\r\n Nachtangeln ist erlaubt."
    ],
    "en": [
      "Fishing reserved to the members of the Gaule Dizimolane and the inhabitants of Dizimieu. Pond populated with carnivores, carp, tench, black-bass.\r\n Night fishing is allowed."
    ],
    "it": [
      "Pesca riservata ai membri della Gaule Dizimolane e ai residenti di Dizimieu. Lo stagno è popolato da carnivori, carpe, tinche e black bass.\r\n È consentita la pesca notturna."
    ],
    "fr": [
      "Pêché réservée aux sociétaires de la Gaule Dizimolane et aux habitants de Dizimieu. Étang peuplé de carnassiers, carpes, tanches, black-bass.\r\n La pêche de nuit est autorisée."
    ],
    "nl": [
      "Vissen is voorbehouden aan leden van de Gaule Dizimolane en inwoners van Dizimieu. Vijver gevuld met carnivoren, karper, zeelt en black bass.\r\n Nachtvissen is toegestaan."
    ],
    "es": [
      "Pesca reservada a los miembros de la Gaule Dizimolane y a los residentes de Dizimieu. Estanque repoblado con carnívoros, carpas, tencas y black bass.\r\n Se permite la pesca nocturna."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pêche à l'étang de Dizimieu"
    ]
  },
