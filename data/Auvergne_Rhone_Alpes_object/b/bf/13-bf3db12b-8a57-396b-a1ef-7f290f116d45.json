  "rdfs:comment": {
    "de": [
      "ViaRhôna, von Lyon nach Saint-Romain-en-Gal / Vienne.\r\nNach dem feurigen Treiben in Lyon führt diese Etappe der ViaRhôna nach Givors und dann nach Saint-Romain-en-Gal."
    ],
    "en": [
      "ViaRhôna, from Lyon to Saint-Romain-en-Gal / Vienne.\r\nAfter the hustle and bustle of Lyon, this stage of the ViaRhôna leads to Givors, then Saint-Romain-en-Gal."
    ],
    "it": [
      "ViaRhôna, da Lione a Saint-Romain-en-Gal / Vienne.\r\nDopo la frenesia di Lione, questa tappa della ViaRhôna conduce a Givors e poi a Saint-Romain-en-Gal."
    ],
    "fr": [
      "ViaRhôna, de Lyon à Saint-Romain-en-Gal / Vienne.\r\nAprès l’ardente agitation lyonnaise, cette étape de ViaRhôna mène à Givors, puis Saint-Romain-en-Gal."
    ],
    "nl": [
      "ViaRhôna, van Lyon naar Saint-Romain-en-Gal / Vienne.\r\nNa de drukte van Lyon leidt deze etappe van de ViaRhôna naar Givors en vervolgens naar Saint-Romain-en-Gal."
    ],
    "es": [
      "ViaRhôna, de Lyon a Saint-Romain-en-Gal / Vienne.\r\nTras el ajetreo de Lyon, esta etapa de la ViaRhôna conduce a Givors y luego a Saint-Romain-en-Gal."
    ]
  },
  "rdfs:label": {
    "fr": [
      "ViaRhôna à vélo - Étape 10 - Lyon > St-Romain-en-Gal / Vienne"
    ]
  },
