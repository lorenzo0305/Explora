  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt von Manigod heißt Sie das ganze Jahr über am Col de la Croix Fry willkommen! Täglich von 9.00 bis 12.30 Uhr und von 13.30 bis 17.00 Uhr geöffnet."
    ],
    "en": [
      "The Manigod Tourist Office welcomes you year-round to the Col de la Croix Fry! Open every day from 9 a.m. to 12:30 p.m. and from 1:30 p.m. to 5 p.m."
    ],
    "it": [
      "L'Ufficio del Turismo di Manigod vi accoglie tutto l'anno al Col de la Croix Fry! Aperto tutti i giorni dalle 9.00 alle 12.30 e dalle 13.30 alle 17.00."
    ],
    "fr": [
      "L'Office de Tourisme de Manigod vous accueille à l'année au Col de la Croix Fry ! Ouvert tous les jours de 9h à 12h30 et de 13h30 à 17h."
    ],
    "es": [
      "La Oficina de Turismo de Manigod le da la bienvenida todo el año al Col de la Croix Fry Abierta todos los días de 9:00 a 12:30 y de 13:30 a 17:00."
    ],
    "nl": [
      "Het toeristenbureau van Manigod heet je het hele jaar door welkom op de Col de la Croix Fry! Elke dag geopend van 9.00 tot 12.30 uur en van 13.30 tot 17.00 uur."
    ]
  },
