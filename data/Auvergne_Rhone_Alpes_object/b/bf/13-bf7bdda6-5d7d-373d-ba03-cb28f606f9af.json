  "rdfs:comment": {
    "de": [
      "Das elegante und beruhigende Bergspa Susanne Kaufmann lädt zu einer Wellness-Pause zwischen Natur und Raffinesse ein. Körperbehandlungen, Innen-/Außenpool, Sauna und Entspannungsbereich für eine einzigartige Sinneserfahrung."
    ],
    "en": [
      "An elegant and soothing mountain spa, the Susanne Kaufmann Spa invites you to enjoy a wellness break surrounded by nature and refinement. Body treatments, indoor/outdoor pool, sauna, and relaxation area for a unique sensory experience."
    ],
    "it": [
      "Elegante e rilassante spa di montagna, la Spa Susanne Kaufmann invita a concedersi una pausa di benessere tra natura e raffinatezza. Trattamenti per il corpo, piscina interna/esterna, sauna e area relax per un'esperienza sensoriale unica."
    ],
    "fr": [
      "Spa de montagne élégant et apaisant, le Spa Susanne Kaufmann invite à une parenthèse bien-être entre nature et raffinement. Soin du corps, piscine intérieure/extérieure, sauna et espace détente pour une expérience sensorielle unique."
    ],
    "es": [
      "Elegante y relajante spa de montaña, el Spa Susanne Kaufmann le invita a tomarse un respiro entre naturaleza y refinamiento. Tratamientos corporales, piscina interior/exterior, sauna y zona de relajación para una experiencia sensorial única."
    ],
    "nl": [
      "De Spa Susanne Kaufmann, een elegante en rustgevende spa in de bergen, nodigt je uit voor een pauze in de natuur en verfijning. Lichaamsbehandelingen, binnen-/buitenzwembad, sauna en ontspanningsruimte voor een unieke zintuiglijke ervaring."
    ]
  },
