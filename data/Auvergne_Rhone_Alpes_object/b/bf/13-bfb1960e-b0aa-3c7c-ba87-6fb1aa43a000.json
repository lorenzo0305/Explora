  "rdfs:comment": {
    "de": [
      "Der Club hat etwa 50 Mitglieder, die Ultraleichtflugzeuge fliegen. Er besitzt drei Flugzeuge, die von den Mitgliedern gemietet werden können und die auch für Taufen und Pilotenausbildung genutzt werden."
    ],
    "en": [
      "The Club brings together some fifty ultralight flying members, and owns 3 aircraft which members can rent, and which are also used for first flights and pilot training."
    ],
    "it": [
      "Il Club conta circa 50 soci che volano in ultraleggero e possiede 3 velivoli che i soci possono noleggiare e che vengono utilizzati anche per i primi voli e per l'addestramento dei piloti."
    ],
    "fr": [
      "Le Club rassemble une cinquantaine de membres pratiquants le vol en ULM et possède  3 appareils que les membres peuvent louer et qui servent également pour effectuer des baptêmes ainsi que les formations des pilotes."
    ],
    "es": [
      "El Club cuenta con unos 50 socios que vuelan ultraligeros y posee 3 aeronaves que los socios pueden alquilar y que también se utilizan para primeros vuelos y formación de pilotos."
    ],
    "nl": [
      "De club heeft ongeveer vijftig leden die met microlights vliegen en bezit 3 vliegtuigen die leden kunnen huren en die ook worden gebruikt voor eerste vluchten en piloottraining."
    ]
  },
  "rdfs:label": {
