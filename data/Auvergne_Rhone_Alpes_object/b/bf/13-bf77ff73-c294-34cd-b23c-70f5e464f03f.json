  "rdfs:comment": {
    "de": [
      "Langues Academy by Jeunes Diplomates bietet Sprachkurse für Kinder, Erwachsene und Berufstätige an, die sich auf Kommunikation konzentrieren. Entdecken Sie auch unsere Sommersprachreisen für 6- bis 16-Jährige mit oder ohne Unterkunft in einer außergewöhnlichen Umgebung."
    ],
    "en": [
      "Language school for children, adults, and professionals. Summer/Winter Camps (from 6 to 17 years old, with or without accommodation) where children live the language and enjoy sport activities."
    ],
    "it": [
      "Scuola di lingue per bambini, adulti e professionisti che si prefigge l'obiettivo di promuovere l'apprendimento delle lingue ponendo l'accento sulla comunicazione. Soggiorni linguistici in estate e in inverno da 6 a 17 anni, con o senza alloggio."
    ],
    "fr": [
      "Langues Academy by Jeunes Diplomates propose des cours de langues pour enfants, adultes et professionnels, axés sur la communication. Découvrez aussi nos séjours linguistiques d'été pour les 6-16 ans, avec ou sans hébergement, dans un cadre exceptionnel."
    ],
    "es": [
      "Langues Academy by Jeunes Diplomates ofrece cursos de idiomas para niños, adultos y profesionales, centrados en la comunicación. Descubra nuestros cursos de idiomas de verano para niños de 6 a 16 años, con o sin alojamiento, en un marco excepcional."
    ],
    "nl": [
      "Langues Academy by Jeunes Diplomates biedt taalcursussen voor kinderen, volwassenen en professionals, met de nadruk op communicatie. Ontdek onze zomerstages voor kinderen van 6-16 jaar, met of zonder accommodatie, in een uitzonderlijke omgeving."
    ]
  },
