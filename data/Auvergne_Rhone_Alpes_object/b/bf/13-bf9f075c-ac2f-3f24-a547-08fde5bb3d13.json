  "rdfs:comment": {
    "de": [
      "Diese vertikale Route führt Sie auf den Gipfel des Berges La Lance, von wo aus Sie einen Panoramablick genießen und in der Ferne den Mont Ventoux erblicken können."
    ],
    "en": [
      "This vertical route takes you to the summit of the Lance mountain, from where you can enjoy panoramic views and see Mont Ventoux in the distance."
    ],
    "it": [
      "Questo percorso verticale vi porta in cima alla Montagne de la Lance, dove potrete godere di una vista panoramica e vedere il Mont Ventoux in lontananza."
    ],
    "fr": [
      "Cet itinéraire vertical vous emmène au sommet de la montagne de la Lance, d’où vous pourrez profiter d’une vue panoramique et apercevoir le Mont Ventoux au loin."
    ],
    "es": [
      "Esta ruta vertical le lleva a la cima de la Montagne de la Lance, donde podrá disfrutar de vistas panorámicas y ver el Mont Ventoux a lo lejos."
    ],
    "nl": [
      "Deze verticale route brengt je naar de top van de Montagne de la Lance, waar je kunt genieten van panoramische uitzichten en de Mont Ventoux in de verte kunt zien liggen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Trail 13 - Verticale de la Lance"
    ]
  },
