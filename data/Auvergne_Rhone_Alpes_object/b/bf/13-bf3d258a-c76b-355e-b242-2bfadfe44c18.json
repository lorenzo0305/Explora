  "rdfs:comment": {
    "de": [
      "Traditionelle Küche mit überwiegend lokalen Produkten. Wir legen Wert darauf, unsere Produkte vollständig zuzubereiten und wählen unsere Lieferanten nach ihren Produkten und Werten aus"
    ],
    "en": [
      "Traditional cuisine with a majority of local products. We take it to heart to prepare our products in full and select our suppliers according to their products and their values"
    ],
    "it": [
      "Cucina tradizionale con prevalenza di prodotti locali. Ci preoccupiamo di preparare i nostri prodotti nella loro interezza e selezioniamo i nostri fornitori in base ai loro prodotti e ai loro valori"
    ],
    "fr": [
      "Cuisine traditionnelle avec une majorité de produits locaux. Nous prenons à cœur de préparer intégralement nos produits et sélectionnons nos fournisseurs en fonction de leurs produits et de leurs valeurs"
    ],
    "nl": [
      "Traditionele keuken met voornamelijk lokale producten. Wij vinden het belangrijk om onze producten in hun geheel te bereiden en selecteren onze leveranciers op basis van hun producten en hun waarden"
    ],
    "es": [
      "Cocina tradicional con mayoría de productos locales. Cuidamos mucho la elaboración de nuestros productos en su totalidad y seleccionamos a nuestros proveedores en función de sus productos y sus valores"
    ]
  },
  "rdfs:label": {
