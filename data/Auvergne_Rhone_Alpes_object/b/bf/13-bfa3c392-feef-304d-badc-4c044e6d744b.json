  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte vom Wasserfall von Glandieu entfernt finden Sie im Laden die Produkte lokaler Handwerker und Produzenten und können auf der Terrasse die Salate, das handgemachte Eis und die Getränke unserer ultra-lokalen Partner genießen!"
    ],
    "en": [
      "Just a stone's throw from the Glandieu waterfall, the Quand on sème shop offers produce from Géraldine Dunand's farm and from local producers."
    ],
    "it": [
      "A due passi dalla cascata di Glandieu, troverete un negozio di prodotti di artigiani e produttori locali, mentre sulla terrazza potrete gustare insalate, gelati fatti in casa e bevande dei nostri partner ultra-locali!"
    ],
    "fr": [
      "À deux pas de la cascade de Glandieu, vous trouverez en boutique les produits des artisans et producteurs locaux, et pourrez savourer en terrasse les salades, les glaces artisanales et boissons de nos partenaires ultra locaux !"
    ],
    "nl": [
      "Op een steenworp afstand van de waterval van Glandieu vind je een winkel met producten van lokale ambachtslieden en producenten, en op het terras kun je genieten van salades, zelfgemaakt ijs en drankjes van onze ultra-lokale partners!"
    ],
    "es": [
      "A dos pasos de la cascada de Glandieu, encontrará una tienda de productos de artesanos y productores locales, y en la terraza podrá degustar ensaladas, helados caseros y bebidas de nuestros socios ultralocales"
    ]
  },
  "rdfs:label": {
    "en": [
      "Quand on sème - local products store"
    ],
    "fr": [
      "Quand on sème"
    ]
  },
