  "rdfs:comment": {
    "de": [
      "Bei Poterie Méli Mélo de terre entdecken Sie farbenfrohe Töpferwaren aus glasierter Erde, die sowohl für den Gebrauch als auch zur Dekoration geeignet sind. Drehen und Verzieren, traditionelle Herstellung aus der Region."
    ],
    "en": [
      "In Melimelo de terre, discover colourful handmade pottery. Clay turning, Drôme traditional and technical savoir-faire."
    ],
    "it": [
      "Presso la Poterie Méli Mélo de terre, scoprite le coloratissime terrecotte smaltate, sia utilitarie che decorative. Tornitura e decorazione, manifattura tradizionale della regione."
    ],
    "fr": [
      "Chez Poterie Méli Mélo de terre, découvrez des poteries colorées en terre vernissée, utilitaires et décoratives. Tournage et décoration, fabrication traditionnelle de la région."
    ],
    "nl": [
      "Ontdek bij Poterie Méli Mélo de terre kleurrijk geglazuurd aardewerk, zowel gebruiks- als sieraardewerk. Draaien en decoreren, traditionele regionale productie."
    ],
    "es": [
      "En la Poterie Méli Mélo de terre, descubra la colorida loza esmaltada, tanto utilitaria como decorativa. Torneado y decoración, fabricación tradicional en la región."
    ]
  },
