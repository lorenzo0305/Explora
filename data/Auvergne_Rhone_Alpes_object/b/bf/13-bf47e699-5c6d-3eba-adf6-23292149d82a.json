  "rdfs:comment": {
    "de": [
      "Die Diskothek Le Malaysia ist ein unumgänglicher Ort für die Abende in Val Thorinois. Sie öffnet jeden Abend ihre Türen mit einem Live-Konzert ab 23 Uhr, gefolgt von einem DJ-Set bis 4 Uhr morgens. Wenn Sie Musik mögen, ist dies der ideale Ort für Sie!"
    ],
    "en": [
      "The place to be if you want to party in Val Thorens, Le Malaysia nightclub opens its doors every night with a live concert from 11pm, followed by a DJ set until 4am. If you like music, this is the place to be!"
    ],
    "it": [
      "La discoteca Le Malaysia, il luogo ideale per fare festa a Val Thorens, apre le sue porte ogni sera con un concerto dal vivo a partire dalle 23:00, seguito da un DJ set fino alle 4:00 del mattino. Se vi piace la musica, questo è il posto giusto!"
    ],
    "fr": [
      "Lieu incontournable des soirées Val Thorinoises, la discothèque Le Malaysia ouvre ses portes tous les soirs avec un concert live à partir de 23h00, suivi d'un DJ set jusqu'à 4h00 du matin. Si vous aimez la musique, c'est l'endroit idéal !"
    ],
    "es": [
      "La discoteca Le Malaysia, el lugar ideal para salir por la noche en Val Thorens, abre sus puertas todas las noches con un concierto en directo a partir de las 23:00, seguido de una sesión de DJ hasta las 4:00 de la madrugada. Si le gusta la música, ¡no se lo pierda!"
    ],
    "nl": [
      "Dé plek om te zijn als je wilt feesten in Val Thorens, de nachtclub Le Malaysia opent elke avond zijn deuren met een live concert vanaf 23.00 uur, gevolgd door een dj-set tot 4.00 uur. Als je van muziek houdt, moet je hier zijn!"
    ]
  },
