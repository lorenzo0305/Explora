  "rdfs:comment": {
    "de": [
      "In 622 m Höhe, im Herzen des Waldmassivs des Beaujolais, bietet die Communauté de Communes Saône Beaujolais folgende Räumlichkeiten zur Vermietung an: einen Versammlungsraum mit 30 bis 60 Sitzplätzen, alles in einer Holzatmosphäre."
    ],
    "en": [
      "At an altitude of 622m, in the heart of the Beaujolais forest, the Communauté de Communes Saône Beaujolais offers a meeting room for 30 to 60 people, all in a woodland atmosphere."
    ],
    "it": [
      "A 622 m di altitudine, nel cuore della foresta del Beaujolais, la Communauté de Communes Saône Beaujolais offre una sala riunioni per 30-60 persone, il tutto in un ambiente boschivo."
    ],
    "fr": [
      "A 622m d'altitude, au cœur du massif forestier du Beaujolais, la Communauté de Communes Saône Beaujolais propose à la location:  une salle de réunion de 30 à 60 places as, le tout dans une ambiance bois."
    ],
    "nl": [
      "Op 622 m hoogte, in het hart van het bos van de Beaujolais, biedt de Communauté de Communes Saône Beaujolais een vergaderzaal voor 30 tot 60 personen, in een bosrijke omgeving."
    ],
    "es": [
      "A 622 m de altitud, en pleno bosque de Beaujolais, la Communauté de Communes Saône Beaujolais ofrece una sala de reuniones para 30 a 60 personas, en un entorno arbolado."
    ]
  },
  "rdfs:label": {
    "fr": [
