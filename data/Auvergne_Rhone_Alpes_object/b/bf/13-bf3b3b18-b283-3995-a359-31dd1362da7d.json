  "rdfs:comment": {
    "de": [
      "Das im Januar 2015 eröffnete Kino Le Coeur d'Or in Bourg Saint Maurice verfügt über drei Säle mit insgesamt 378 Plätzen und einem reichhaltigen und abwechslungsreichen Programm für jedes Publikum."
    ],
    "en": [
      "Inaugurated in January 2015, the Coeur d'Or cinema in Bourg Saint Maurice, is 3 cinemas for a total of 378 seats with a rich and varied program for all audiences."
    ],
    "it": [
      "Inaugurato nel gennaio 2015, il cinema Coeur d'Or di Bourg Saint Maurice dispone di 3 sale per un totale di 378 posti e una programmazione ricca e variegata per tutti i tipi di pubblico."
    ],
    "fr": [
      "Inauguré en janvier 2015, le cinéma le Coeur d'Or à Bourg Saint Maurice, c'est 3 salles pour un total de 378 places avec une programmation riche et variée pour tout public."
    ],
    "es": [
      "Inaugurado en enero de 2015, el cine Coeur d'Or de Bourg Saint Maurice dispone de 3 salas con un total de 378 butacas y una programación rica y variada para todos los públicos."
    ],
    "nl": [
      "De bioscoop Coeur d'Or in Bourg Saint Maurice werd in januari 2015 geopend en beschikt over 3 zalen met in totaal 378 plaatsen met een rijk en gevarieerd programma voor elk publiek."
    ]
  },
