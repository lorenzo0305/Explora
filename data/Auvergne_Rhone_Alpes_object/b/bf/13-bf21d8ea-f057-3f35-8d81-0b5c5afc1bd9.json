  "rdfs:comment": {
    "de": [
      "Neues Bistronomierestaurant des Küchenchefs Emmanuel Renaut am Place de l'Eglise. Saisonale und lokale Produkte. Warme und freundliche Einrichtung. Schöne Sonnenterrasse."
    ],
    "en": [
      "Chef Emmanuel Renaut's new bistronomic restaurant on Church Square. Seasonal and local produce. Warm, friendly decor. Sunny terrace."
    ],
    "it": [
      "Il nuovo ristorante bistronomico dello chef Emmanuel Renaut in Place de l'Eglise. Prodotti di stagione e locali. Arredamento caldo e accogliente. Bella terrazza soleggiata."
    ],
    "fr": [
      "Nouveau restaurant bistronomique du Chef Emmanuel Renaut situé sur la place de l’église. Produits de saison et locaux. Décor chaleureux et convivial. Belle terrasse ensoleillée."
    ],
    "nl": [
      "Het nieuwe bistronomische restaurant van chef-kok Emmanuel Renaut op de Place de l'Eglise. Seizoensgebonden en lokale producten. Warm en vriendelijk decor. Prachtig zonnig terras."
    ],
    "es": [
      "El nuevo restaurante bistronómico del Chef Emmanuel Renaut en la Place de l'Eglise. Productos locales y de temporada. Decoración cálida y acogedora. Bonita terraza soleada."
    ]
  },
