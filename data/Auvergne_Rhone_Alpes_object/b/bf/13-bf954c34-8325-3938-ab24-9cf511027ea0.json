  "rdfs:comment": {
    "de": [
      "Treffen Sie sich, um die Radfahrer anzufeuern und die festliche Atmosphäre zu genießen! Dekorationen, Animationen und Verpflegung sorgen dafür, dass dieses Ereignis zu einem wahren Fest wird."
    ],
    "en": [
      "Come and cheer on the cyclists and enjoy the festive atmosphere! Decorations, entertainment and refreshments will be on hand to make this a truly festive event."
    ],
    "it": [
      "Venite a fare il tifo per i ciclisti e a godervi l'atmosfera di festa! Decorazioni, intrattenimento e rinfreschi saranno a disposizione per rendere questo evento davvero festoso."
    ],
    "fr": [
      "Rendez-vous pour encourager les cyclistes et profiter de l’ambiance festive ! Décorations, animations et ravitaillement seront au rendez-vous pour faire de cet événement une véritable fête."
    ],
    "es": [
      "Venga a animar a los ciclistas y a disfrutar del ambiente festivo Decoraciones, entretenimiento y refrescos estarán a mano para hacer de este un evento verdaderamente festivo."
    ],
    "nl": [
      "Kom de fietsers aanmoedigen en geniet van de feestelijke sfeer! Versieringen, entertainment en versnaperingen zullen aanwezig zijn om er een echt feestelijk evenement van te maken."
    ]
  },
  "rdfs:label": {
    "fr": [
