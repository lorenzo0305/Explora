  "rdfs:comment": {
    "de": [
      "Sportverein aus Loriolais mit drei Aktivitäten:\r\nCYCLO: Wöchentliche oder zweiwöchentliche Halbtagesausflüge auf Strecken in der Drôme und der Ardèche.\r\nRANDO: Monatliche oder zweimonatliche Ausflüge auf Strecken in der Drôme und der Ardèche.\r\nGOLF: Parcours auf den Golfplätzen der Drôme."
    ],
    "en": [
      "Loriolais sports club with 3 activities:\r\nCYCLO: Weekly or bi-weekly half-day outings on Drôme and Ardèche circuits.\r\nRANDO : Monthly or bimonthly outings on circuits in Drôme and Ardèche.\r\nGOLF: Courses on Drôme golf courses."
    ],
    "it": [
      "Club sportivo di Loriolais con 3 attività:\r\nCICLO: uscite settimanali o bisettimanali di mezza giornata sui circuiti della Drôme e dell'Ardèche.\r\nESCURSIONI: uscite mensili o bimestrali sui circuiti della Drôme e dell'Ardèche.\r\nGOLF : Campi da golf nella Drôme."
    ],
    "fr": [
      "Club de sport Loriolais regroupant 3 activités :\r\nCYCLO : Sorties hebdo ou bi-hebdo en demi-journées sur circuits Drôme et Ardèche.\r\nRANDO : Sorties mensuelles ou bimestrielles sur des circuits en Drôme et Ardèche.\r\nGOLF : Parcours sur les golfs de la Drôme."
    ],
    "nl": [
      "Sportclub van Loriolais met 3 activiteiten:\r\nCYCLO: Wekelijkse of tweewekelijkse uitstapjes van een halve dag op circuits in de Drôme en de Ardèche.\r\nWANDELEN: maandelijkse of tweewekelijkse tochten op routes in de Drôme en de Ardèche.\r\nGOLF: Golfbanen in de Drôme."
    ],
    "es": [
      "Club deportivo de Loriolais con 3 actividades:\r\nCYCLO: Salidas semanales o quincenales de media jornada por los circuitos de la Drôme y la Ardèche.\r\nSENDERISMO: Salidas mensuales o bimensuales por los circuitos de la Drôme y la Ardèche.\r\nGOLF : Campos de golf en la Drôme."
    ]
  },
