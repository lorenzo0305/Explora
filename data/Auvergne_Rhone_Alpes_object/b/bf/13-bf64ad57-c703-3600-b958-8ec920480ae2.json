  "rdfs:comment": {
    "de": [
      "Am Fuße der Cantal-Berge kann man aufatmen! Etwas außerhalb der Stadt, auf der Straße nach Rodez, finden Sie ein kleines, familiengeführtes Hotel und Restaurant."
    ],
    "en": [
      "At the foot of the mountains of Cantal, you breathe! Close to the town, on the road to Rodez, discover a veritable small hotel restaurant family."
    ],
    "it": [
      "Ai piedi delle montagne del Cantal, si respira! Appena fuori città, sulla strada per Rodez, scoprite un piccolo hotel ristorante a conduzione familiare."
    ],
    "fr": [
      "Au pied des monts du Cantal, on respire ! Juste en sortie de ville, sur la route de Rodez, decouvrez un veritable petit hotel restaurant familial."
    ],
    "es": [
      "¡A los pies de las montañas del Cantal, respiramos! Justo en las afueras de la ciudad, en la carretera que va a Rodez, descubre este pequeño Hotel-restaurante familiar."
    ],
    "nl": [
      "Aan de voet van de Cantal kunt u ademhalen! Net buiten de stad, op de weg naar Rodez, ontdekt u een klein familiehotel-restaurant."
    ]
  },
