  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über werden im Theater Le Pot au Noir in der Domaine de Rivoiranche kreative Theatergruppen in Residenz aufgenommen, die ihre Aufführungen präsentieren. An den Abenden ist die Bar geöffnet und die Zuschauer können gemeinsam mit den Künstlern essen."
    ],
    "en": [
      "Throughout the year, creative companies are in residence at the Le Pot au Noir theater at Domaine de Rivoiranche, presenting their shows. During the evenings, the bar is open and spectators can eat with the artists."
    ],
    "it": [
      "Durante tutto l'anno, le compagnie creative sono accolte in residenza presso il teatro Le Pot au Noir del Domaine de Rivoiranche e presentano i loro spettacoli. Durante le serate, il bar è aperto e gli spettatori possono mangiare con gli artisti."
    ],
    "fr": [
      "Toute l’année, des compagnies de création sont accueillies en résidence au théâtre Le Pot au Noir au Domaine de Rivoiranche, et présentent leur spectacle. Pour les soirées, le bar est ouvert et les spectateurs peuvent se restaurer avec les artistes."
    ],
    "nl": [
      "In het theater Pot au Noir op het Domaine de Rivoiranche worden het hele jaar door creatieve gezelschappen in residentie ontvangen en presenteren zij hun voorstellingen. S Avonds is de bar open en kunnen de toeschouwers samen met de artiesten eten."
    ],
    "es": [
      "Durante todo el año, las compañías creativas son acogidas en residencia en el teatro Le Pot au Noir del Domaine de Rivoiranche y presentan sus espectáculos. Por la noche, el bar está abierto y los espectadores pueden comer con los artistas."
    ]
  },
  "rdfs:label": {
    "en": [
