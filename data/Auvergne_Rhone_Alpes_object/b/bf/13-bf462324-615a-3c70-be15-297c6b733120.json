  "rdfs:comment": {
    "de": [
      "Ein atypischer und familiärer Ort in orientalischen Farben, der algerische Spezialitäten in Form von geselligen und großzügigen Gerichten anbietet, die vor Ort serviert werden, oder Sandwiches und Salate mit frischem Fleisch oder vegetarisch zum Mitnehmen."
    ],
    "en": [
      "An atypical, family-friendly place with an oriental flair, offering Algerian specialties in the form of generous, convivial dishes served on the spot, or sandwiches and salads to take away with fresh meat or vegetarian dishes."
    ],
    "it": [
      "Locale atipico a conduzione familiare dal sapore orientale, offre specialità algerine sotto forma di piatti accoglienti e generosi serviti sul posto, oppure panini e insalate da asporto con carne fresca o piatti vegetariani."
    ],
    "fr": [
      "Un lieu atypique et familial aux couleurs orientales, proposant des spécialités algériennes sous forme de plats conviviaux et généreux servis sur place, ou bien de sandwiches et salades à emporter avec de la viande fraîche ou végétariens."
    ],
    "es": [
      "Un local atípico y familiar con sabor oriental, que ofrece especialidades argelinas en forma de platos amables y generosos servidos al momento, o bocadillos y ensaladas para llevar con carne fresca o platos vegetarianos."
    ],
    "nl": [
      "Een atypische familiezaak met een oosters tintje die Algerijnse specialiteiten aanbiedt in de vorm van vriendelijke, royale gerechten die ter plekke worden geserveerd, of broodjes en salades om mee te nemen met verse vlees- of vegetarische gerechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant et restauration rapide : La Rose des Sables"
    ]
  },
