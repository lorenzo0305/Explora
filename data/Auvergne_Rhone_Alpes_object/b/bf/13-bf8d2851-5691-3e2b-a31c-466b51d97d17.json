  "rdfs:comment": {
    "de": [
      "Der 70 km lange Fluss entspringt auf einer Höhe von 630 m in der Nähe von Aveize. Sein Lauf führt teilweise entlang des Tals der Brévenne auf der westlichen Seite der Monts du Lyonnais in Richtung Lentilly und erreicht Lyon auf einer Höhe von 282 Metern."
    ],
    "en": [
      "The river is 70 km long, rising at an altitude of 630 m near Aveize. Part of its course follows the Brévenne valley on the western slopes of the Monts du Lyonnais towards Lentilly, arriving in Lyon at an altitude of 282 m."
    ],
    "it": [
      "Il fiume è lungo 70 km e nasce ad un'altitudine di 630 m presso Aveize. Una parte del suo corso segue la valle di Brévenne sulle pendici occidentali dei Monts du Lyonnais verso Lentilly, raggiungendo Lione a 282 m di altitudine."
    ],
    "fr": [
      "Long de 70 km, il prend sa source à 630 m d'altitude près de Aveize. Son parcours longe en partie la vallée de la Brévenne sur le versant occidental des Monts du Lyonnais en direction de Lentilly pour arriver à Lyon à une altitude de 282 m."
    ],
    "es": [
      "El río tiene 70 km de longitud y nace a 630 m de altitud cerca de Aveize. Parte de su curso sigue el valle del Brévenne por la vertiente occidental de los Montes del Lyonnais hacia Lentilly, llegando a Lyon a 282 m de altitud."
    ],
    "nl": [
      "De rivier is 70 km lang en ontspringt op een hoogte van 630 m bij Aveize. Een deel van de loop volgt de vallei van de Brévenne op de westelijke hellingen van de Monts du Lyonnais richting Lentilly en bereikt Lyon op een hoogte van 282 m."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aqueduc romain de la Brévenne"
    ]
  },
