  "rdfs:comment": {
    "de": [
      "Alain Ferrier von Les Moulins du Bouchat bietet Forellenfilets an, die mit Buchenholzsägemehl geräuchert werden. Von ihm selbst geräuchert. Frische und getrocknete Pilze, rote Früchte.\r\nSie finden Alain auf den Märkten von Le Chambon/Lignon, Tence, Yssingeaux und Saint-Agrève."
    ],
    "en": [
      "Alain Ferrier of Moulins du Bouchat offers trout fillets smoked with beechwood sawdust. Smoked in-house. Fresh and dried mushrooms, red fruits.\r\nAlain can be found at markets in Le Chambon/Lignon, Tence, Yssingeaux and Saint-Agrève."
    ],
    "it": [
      "Alain Ferrier, di Moulins du Bouchat, propone filetti di trota affumicati con segatura di faggio. Affumicato in casa. Funghi freschi e secchi, frutti rossi.\r\nAlain è presente nei mercati di Le Chambon/Lignon, Tence, Yssingeaux e Saint-Agrève."
    ],
    "fr": [
      "Alain Ferrier, aux  Moulins du Bouchat, propose des filets de truite fumée à la sciure de bois de hêtre. Fumée par ses soins. Champignons frais et secs, fruits rouges.\r\nRetrouvez Alain sur le marché du Chambon/Lignon, Tence, Yssingeaux et Saint-Agrève."
    ],
    "nl": [
      "Alain Ferrier, van Moulins du Bouchat, biedt forelfilets gerookt met zaagsel van beukenhout. Zelf gerookt. Verse en gedroogde paddenstoelen, rood fruit.\r\nAlain is te vinden op markten in Le Chambon/Lignon, Tence, Yssingeaux en Saint-Agrève."
    ],
    "es": [
      "Alain Ferrier, de Moulins du Bouchat, propone filetes de trucha ahumados con serrín de haya. Ahumado propio. Setas frescas y secas, frutos rojos.\r\nPuede encontrar a Alain en los mercados de Le Chambon/Lignon, Tence, Yssingeaux y Saint-Agrève."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les truites fumées du Haut-Lignon"
    ]
  },
