  "rdfs:comment": {
    "de": [
      "Das Spa Le Roure Manoir ist eine glückliche Mischung aus Tradition und Innovation. Hier macht es Sinn, sich gut zu fühlen und gut zu sein. Wellness, Erholung und Fit, Pflege und Massage."
    ],
    "en": [
      "Les Sources du Roure, rituals established and followed by professionals allow you to recharge your batteries and regenerate yourself in complete serenity. You can thus find yourself and take care of yourself."
    ],
    "it": [
      "Les Sources du Roure, un luogo di relax e benessere. La spa offre strutture moderne: bagno turco, sauna, piscina di galleggiamento e jacuzzi. Trattamenti, massaggi e rituali personalizzati sono offerti e forniti da professionisti."
    ],
    "fr": [
      "Les Sources du Roure, lieu de détente et de bien-être. Le spa offre des équipements modernes : hammam, sauna, bassin de flottaison et jacuzzi. Des soins personnalisés, massages et rituels sont proposés et assurés par des professionnels."
    ],
    "es": [
      "Les Sources du Roure, un lugar de relajación y bienestar. El spa ofrece modernas instalaciones: sala de vapor, sauna, piscina de flotación y jacuzzi. Se ofrecen tratamientos personalizados, masajes y rituales proporcionados por profesionales."
    ],
    "nl": [
      "Les Sources du Roure, rituelen opgesteld en gevolgd door professionals stellen u in staat om uw batterijen op te laden en uzelf te regenereren in alle rust. Zo kunt u zichzelf terugvinden en voor uzelf zorgen."
    ]
  },
