  "rdfs:comment": {
    "de": [
      "Die Monts du Lyonnais mit einem Oldtimer-Moped zu erkunden, ist jetzt möglich! Genießen Sie ein einzigartiges Erlebnis auf den Landstraßen des Beaujolais und der Monts du Lyonnais, nur wenige Kilometer von Lyon entfernt."
    ],
    "en": [
      "Discover the Monts du Lyonnais on a vintage moped! Enjoy a unique experience on the country roads of the Beaujolais and Monts du Lyonnais regions, just a few kilometers from Lyon."
    ],
    "it": [
      "Scoprite i Monts du Lyonnais su un ciclomotore d'epoca! Godetevi un'esperienza unica sulle strade di campagna delle regioni del Beaujolais e dei Monts du Lyonnais, a pochi chilometri da Lione."
    ],
    "fr": [
      "Découvrir les Monts du Lyonnais en mobylette vintage, c’est désormais possible ! Profitez d’une expérience unique sur les routes de campagne du Beaujolais et des Monts du Lyonnais, à seulement quelques kilomètres de Lyon."
    ],
    "es": [
      "¡Descubra los Monts du Lyonnais en un ciclomotor de época! Disfrute de una experiencia única por las carreteras rurales de las regiones de Beaujolais y Monts du Lyonnais, a pocos kilómetros de Lyon."
    ],
    "nl": [
      "Ontdek de Monts du Lyonnais op een oldtimer brommer! Geniet van een unieke ervaring op de landweggetjes van de Beaujolais en de Monts du Lyonnais, op slechts een paar kilometer van Lyon."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location de Mobylette Vintage"
    ]
  },
