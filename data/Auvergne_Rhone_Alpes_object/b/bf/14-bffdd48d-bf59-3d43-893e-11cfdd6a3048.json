  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/144452cc-70e2-32fa-9c5b-626cccd0aeae",
      "dc:description": {
        "de": [
          "Das in Camiers gelegene Domaine du Rohart ist ein etwa zwölf Hektar großes Naturschutzgebiet, eine wahre Wiege der Artenvielfalt (Schilfgürtel, Feuchtwälder, Bäche)"
        ],
        "en": [
          "Located in Camiers, the Rohart estate is a preserved natural environment of a dozen hectares, a real cradle of biodiversity (reed beds, wet woodlands, streams)"
        ],
        "it": [
          "Situata a Camiers, la tenuta Rohart è un ambiente naturale preservato di una dozzina di ettari, una vera e propria culla di biodiversità (canneti, boschi umidi, ruscelli)"
        ],
        "fr": [
          "Situé à Camiers, le domaine du Rohart est un milieu naturel préservé d'une douzaine d'hectares, véritable berceau de biodiversité (roselières, boisements humides, ruisseaux)"
        ],
        "es": [
          "Situada en Camiers, la finca Rohart es un entorno natural preservado de una docena de hectáreas, una auténtica cuna de biodiversidad (cañaverales, bosques húmedos, arroyos)"
        ],
        "nl": [
          "Het landgoed van Rohart, gelegen in Camiers, is een beschermd natuurgebied van een tiental hectaren, een echte bakermat van biodiversiteit (rietvelden, vochtige bossen, beken)"
        ]
      },
