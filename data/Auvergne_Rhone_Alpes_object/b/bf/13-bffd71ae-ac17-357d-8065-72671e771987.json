  "rdfs:comment": {
    "de": [
      "Kunsthandwerk, Trödelmarkt, Teesalon und kreative Workshops. Eine eklektische Auswahl an Einzelstücken, die aus Quellen stammen oder aufgespürt wurden, an einem einzigartigen und atypischen Ort!"
    ],
    "en": [
      "Craft, antique tea shop and arts and crafts workshops. Our unique and original boutique offers an eclectic selection of unique vintage pieces sourced or found on flea markets."
    ],
    "it": [
      "Artigianato, oggetti di seconda mano, sala da tè e laboratori creativi. Una selezione eclettica di pezzi unici, reperiti o trovati, in un luogo unico e atipico!"
    ],
    "fr": [
      "Artisanat, brocante, salon de thé et ateliers créatifs. Une sélection éclectique de pièces uniques, sourcées ou chinées, dans un lieu unique et atypique !"
    ],
    "nl": [
      "Handwerk, tweedehands goederen, tearoom en creatieve workshops. Een eclectische selectie van unieke stukken, gekocht of gevonden, in een unieke en atypische locatie!"
    ],
    "es": [
      "Artesanía, artículos de segunda mano, salón de té y talleres creativos. Una selección ecléctica de piezas únicas, de origen o encontradas, en un lugar único y atípico"
    ]
  },
