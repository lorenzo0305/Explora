  "rdfs:comment": {
    "de": [
      "Dieser Angelplatz der ersten Kategorie mit einer Länge von etwas mehr als 1 km profitiert von einer recht bescheidenen Forellenpopulation, die jedoch über ein großes Wachstumspotenzial verfügt."
    ],
    "en": [
      "This 1st category fishing route is just over 1 km long and boasts a fairly modest trout population, but one with significant growth potential."
    ],
    "it": [
      "Questo percorso di pesca di prima categoria è lungo poco più di 1 km e vanta una popolazione di trote piuttosto modesta, ma con un notevole potenziale di crescita."
    ],
    "fr": [
      "Ce parcours de pêche de 1ère catégorie d’une longueur d’un peu plus de 1 km bénéficie d’une population de truites assez modeste mais au potentiel de croissance important."
    ],
    "es": [
      "Esta ruta de pesca de 1ª categoría tiene algo más de 1 km de longitud y cuenta con una población de truchas bastante modesta, pero con un considerable potencial de crecimiento."
    ],
    "nl": [
      "Deze visroute van de 1e categorie is iets meer dan 1 km lang en heeft een vrij bescheiden forellenpopulatie, maar wel een met een aanzienlijk groeipotentieel."
    ]
  },
  "rdfs:label": {
    "fr": [
