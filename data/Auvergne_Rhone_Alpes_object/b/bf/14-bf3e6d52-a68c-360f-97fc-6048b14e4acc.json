  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3505d6c-01d8-3661-8d0c-e65063fa075a",
      "dc:description": {
        "de": [
          "Qipao ist ein neues, zeitgemäßes und originelles Konzept für einen Schönheitssalon.\nEin eleganter Ort, der der Schönheit gewidmet ist und sich an die moderne Frau von heute wendet, die den besten Schönheitsservice zum besten Preis wünscht."
        ],
        "en": [
          "Qipao is a new, contemporary and original beauty salon concept.\nAn elegant place dedicated to beauty for today's women who want the best aesthetic service at the best price."
        ],
        "it": [
          "Qipao è un salone di bellezza nuovo, contemporaneo e originale.\nUn luogo elegante dedicato alla bellezza, rivolto alle donne di oggi che desiderano il miglior servizio di bellezza al miglior prezzo."
        ],
        "fr": [
          "Qipao est un nouveau consept d'institut de beauté contemporzin et original.\nUn lieu élégant dédié à la beauté qui s'adresse aux femmes d'aujourd'hui, souhaitant le meilleur service esthétique au meilleur prix."
        ],
        "nl": [
          "Qipao is een nieuwe, eigentijdse en originele schoonheidssalon.\nEen elegante plek gewijd aan schoonheid, gericht op de hedendaagse vrouw die de beste schoonheidsservice wil voor de beste prijs."
        ],
        "es": [
          "Qipao es un salón de belleza nuevo, contemporáneo y original.\nUn lugar elegante dedicado a la belleza, dirigido a las mujeres de hoy que desean el mejor servicio de belleza al mejor precio."
        ]
      },
      "@type": [
        "Description"
      ],
