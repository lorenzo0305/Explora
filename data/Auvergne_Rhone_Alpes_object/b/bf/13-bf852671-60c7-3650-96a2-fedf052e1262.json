  "rdfs:comment": {
    "de": [
      "Nach dem Erfolg von Adieu Hier kehrt Fabrice Éboué mit einer neuen Show auf die Bühne zurück und tourt durch ganz Frankreich, wobei er auch in der Oper von Vichy Halt macht."
    ],
    "en": [
      "After the success of Adieu Hier, Fabrice Éboué returns to the stage with a new show, touring the length and breadth of France, with a stopover at the Opéra de Vichy."
    ],
    "it": [
      "Dopo il successo di Adieu Hier, Fabrice Éboué torna in scena con un nuovo spettacolo in tournée in tutta la Francia, con una tappa all'Opéra de Vichy."
    ],
    "fr": [
      "Après le succès de Adieu Hier, Fabrice Éboué revient sur scène avec un nouveau spectacle en tournée dans toute la France, et fait escale à l’Opéra de Vichy."
    ],
    "es": [
      "Tras el éxito de Adieu Hier, Fabrice Éboué vuelve a los escenarios con un nuevo espectáculo que recorre toda Francia, con escala en la Ópera de Vichy."
    ],
    "nl": [
      "Na het succes van Adieu Hier staat Fabrice Éboué weer op de planken met een nieuwe show die door heel Frankrijk toert, met een tussenstop in de Opéra de Vichy."
    ]
  },
