  "rdfs:comment": {
    "de": [
      "Ein außergewöhnlicher Wettkampf an der Seite der Gnolus und der talentierten Kompett. Verfolge sie von Prüfung zu Prüfung, wobei sich Wege, Wälder und das Dorf Saint Laurent de Vaux abwechseln."
    ],
    "en": [
      "An extraordinary competition alongside the Gnolus and the talented Kompett. Follow her from event to event, alternating between paths, forest and the village of Saint Laurent de Vaux."
    ],
    "it": [
      "Una gara straordinaria al fianco dello Gnolus e del talentuoso Kompett. Seguitela di evento in evento, alternando sentieri, foreste e il villaggio di Saint Laurent de Vaux."
    ],
    "fr": [
      "Une compétition hors norme aux côtés des Gnolus et de la talentueuse Kompett. Suivez la d'épreuves en épreuves alternant chemins, forêt et village de Saint Laurent de Vaux."
    ],
    "es": [
      "Una competición extraordinaria junto a los Gnolus y el talentoso Kompett. Síguela de evento en evento, alternando caminos, bosques y el pueblo de Saint Laurent de Vaux."
    ],
    "nl": [
      "Een buitengewone wedstrijd aan de zijde van de Gnolus en de getalenteerde Kompett. Volg haar van evenement naar evenement, afwisselend op de paden, in het bos en in het dorp Saint Laurent de Vaux."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Tous aux jeux Gnolympiques !"
    ]
  },
