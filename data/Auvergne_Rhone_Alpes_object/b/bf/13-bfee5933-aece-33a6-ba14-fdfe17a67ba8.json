  "rdfs:comment": {
    "de": [
      "La Grande Coutellerie wurde 2011 von Claudine Dozorme in Clermont, Cannes und Paris gegründet und bietet alle Messerserien aus dem Hause Dozorme sowie andere von Claudine sorgfältig ausgewählte Produkte an. Schärfen, Personalisierung möglich."
    ],
    "en": [
      "La Grande Coutellerie, founded by Claudine Dozorme in 2011 in Clermont, Cannes and Paris, offers the full range of Dozorme knives and other products carefully selected by Claudine. Sharpening and customization available."
    ],
    "it": [
      "La Grande Coutellerie, fondata da Claudine Dozorme nel 2011 a Clermont, Cannes e Parigi, offre tutte le gamme di coltelli Dozorme e altri prodotti accuratamente selezionati da Claudine. Affilatura e personalizzazione disponibili."
    ],
    "fr": [
      "La Grande Coutellerie, fondée par Claudine Dozorme en 2011 à Clermont, Cannes et Paris, propose toutes les gammes de couteaux de la maison Dozorme ainsi que d'autres produits sélectionnés minutieusement par Claudine. Affûtage, personnalisation possibles."
    ],
    "nl": [
      "La Grande Coutellerie, opgericht door Claudine Dozorme in 2011 in Clermont, Cannes en Parijs, biedt alle Dozorme messenreeksen en andere zorgvuldig door Claudine geselecteerde producten. Slijpen en maatwerk mogelijk."
    ],
    "es": [
      "La Grande Coutellerie, fundada por Claudine Dozorme en 2011 en Clermont, Cannes y París, ofrece todas las gamas de cuchillos Dozorme, así como otros productos cuidadosamente seleccionados por Claudine. Afilado y personalización disponibles."
    ]
  },
