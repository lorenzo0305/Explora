  "rdfs:comment": {
    "de": [
      "Die Gemeindebibliothek empfängt ihre Leser mittwochs von 9:30 bis 11:00 Uhr und sonntags von 10:00 bis 11:30 Uhr (außer an Feiertagen).\r\nSie ist Teil des Copernicus-Netzwerks, das den Zugang zur Kultur in der Region Loire Forez fördert."
    ],
    "en": [
      "The municipal library welcomes readers on Wednesdays from 9:30am to 11am and Sundays from 10am to 11:30am (except public holidays).\r\nIt is part of the Copernic network, which promotes access to culture in the Loire Forez region."
    ],
    "it": [
      "La biblioteca comunale accoglie i lettori il mercoledì dalle 9.30 alle 11 e la domenica dalle 10 alle 11.30 (esclusi i giorni festivi).\r\nFa parte della rete Copernic, che promuove l'accesso alla cultura nella regione Loire Forez."
    ],
    "fr": [
      "La bibliothèque municipale accueille les lecteurs les mercredis de 9h30 à 11h et les dimanches de 10h à 11h30 (hors jours fériés).\r\nElle fait partie du réseau Copernic favorisant l’accès à la culture sur le territoire Loire Forez."
    ],
    "es": [
      "La biblioteca municipal recibe a los lectores los miércoles de 9:30 a 11:00 y los domingos de 10:00 a 11:30 (excepto festivos).\r\nForma parte de la red Copernic, que promueve el acceso a la cultura en la región de Loire Forez."
    ],
    "nl": [
      "De gemeentelijke bibliotheek ontvangt lezers op woensdag van 9.30 tot 11.00 uur en op zondag van 10.00 tot 11.30 uur (met uitzondering van feestdagen).\r\nZe maakt deel uit van het Copernic-netwerk dat de toegang tot cultuur in de Loire Forez bevordert."
    ]
  },
  "rdfs:label": {
