      "dc:description": {
        "de": [
          "In einer grünen und beruhigenden Umgebung können Sie sich in sanfte Sportpraktiken für Körper und Geist einführen lassen: Yoga, Qi Gong und Selbstmassage."
        ],
        "en": [
          "In a green, soothing setting, discover gentle sports practices for body and mind: yoga, Qi Gong and self-massage."
        ],
        "it": [
          "In un ambiente verde e rilassante, cimentatevi in sport dolci per il corpo e la mente: yoga, Qi Gong e automassaggio."
        ],
        "fr": [
          "Dans un cadre verdoyant et apaisant, initiez-vous à des pratiques sportives douces pour le corps et l’esprit : Yoga, Qi Gong et Auto-massage."
        ],
        "nl": [
          "Probeer in een groene en rustgevende omgeving zachte sporten voor lichaam en geest: yoga, Qi Gong en zelfmassage."
        ],
        "es": [
          "En un entorno verde y relajante, practique deportes suaves para el cuerpo y la mente: yoga, Qi Gong y automasaje."
        ]
      },
