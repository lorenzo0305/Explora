  "rdfs:comment": {
    "de": [
      "Besonderheit des Parks: Im Parc du Mottay befindet sich ein Angelplatz für Personen mit eingeschränkter Mobilität. Ein spezieller Parkplatz befindet sich am Eingang des Parks sowie angepasste automatische Sanitäranlagen"
    ],
    "en": [
      "A special feature of the park: a fishing area for people with reduced mobility is located in the Parc du Mottay. A dedicated parking space is located at the entrance to the park, along with adapted automatic sanitary facilities."
    ],
    "it": [
      "Specificità del parco: nel parco di Mottay si trova un'area di pesca per persone a mobilità ridotta. All'ingresso del parco si trova un parcheggio dedicato e servizi igienici automatici adattati"
    ],
    "fr": [
      "Spécificité du parc : un emplacement pêche pour les personnes à mobilité réduite se situe dans le parc du Mottay. Une place de stationnement dédiée se trouve à l'entrée du parc ainsi que des sanitaires automatiques adaptés"
    ],
    "es": [
      "Especificidad del parque: en el parque de Mottay se encuentra una zona de pesca para personas con movilidad reducida. A la entrada del parque hay una plaza de aparcamiento dedicada, así como aseos automáticos adaptados"
    ],
    "nl": [
      "Een bijzonder kenmerk van het park: in het Parc du Mottay bevindt zich een visgebied voor mensen met beperkte mobiliteit. Er is een speciale parkeerplaats bij de ingang van het park, evenals aangepaste automatische sanitaire voorzieningen."
    ]
  },
  "rdfs:label": {
