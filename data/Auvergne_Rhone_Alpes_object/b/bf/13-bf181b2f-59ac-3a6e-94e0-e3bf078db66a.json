  "rdfs:comment": {
    "de": [
      "MÖBELRIESE - GROSSER LITIERER - SCHMIDT\r\n\r\n1000 m² erwarten Sie, um Ihnen die gesamte Welt des Hauses anzubieten. Auf der anderen Seite der Straße bieten Ihnen mehr als 300 m² eine große Auswahl an Küchen, Badezimmern und Aufbewahrungsmöglichkeiten."
    ],
    "en": [
      "GEANT DU MEUBLES - GRAND LITIER - SCHMIDT\r\n\r\n1000 m2 await you to offer you the whole universe of the house. On the other side of the road, over 300m² offer a wide choice of kitchens, bathrooms and storage."
    ],
    "it": [
      "GEANT DU MEUBLES - GRAND LITIER - SCHMIDT\r\n\r\n1000 m2 vi aspettano per offrirvi l'intero universo della casa. Dall'altra parte della strada, più di 300 m² offrono un'ampia scelta di cucine, bagni e magazzini."
    ],
    "fr": [
      "GEANT DU MEUBLES - GRAND LITIER - SCHMIDT \r\n\r\n1000 m2 vous attendent pour vous proposer tout l'univers de la maison. De l'autre côté de la route plus de 300m² vous offrent un large choix de cuisines, salles de bains, rangements."
    ],
    "nl": [
      "HUISBEDIENDE - GRAND LITIER - SCHMIDT\r\n\r\n1000 m2 wachten op je om je het hele universum van het huis te bieden. Aan de andere kant van de weg bieden meer dan 300m² een ruime keuze aan keukens, badkamers en opslagruimtes."
    ],
    "es": [
      "GEANT DU MEUBLES - GRAND LITIER - SCHMIDT\r\n\r\n1000 m2 le esperan para ofrecerle todo el universo de la casa. Al otro lado de la carretera, más de 300 m² ofrecen una amplia selección de cocinas, baños y trasteros."
    ]
  },
  "rdfs:label": {
