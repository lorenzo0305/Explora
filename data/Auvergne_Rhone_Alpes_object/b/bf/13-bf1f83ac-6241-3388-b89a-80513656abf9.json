  "rdfs:comment": {
    "de": [
      "Bauernhof-Eis, das aus der Milch unserer Montbéliard-Kühe hergestellt wird.\r\nEisgekühlte Kuchen\r\nMaislabyrinth im Sommer (Achtung: je nach Wetterlage können die Öffnungszeiten variieren)"
    ],
    "en": [
      "Farmhouse ice creams made from the milk of our Montbeliarde cows.\r\nIce cakes\r\nCorn maze during the summer (please note that times may vary according to weather conditions)"
    ],
    "it": [
      "Gelati di fattoria prodotti con il latte delle nostre mucche Montbéliard.\r\nTorte gelato\r\nLabirinto di mais durante l'estate (si prega di notare che gli orari possono variare a seconda del tempo)"
    ],
    "fr": [
      "Glaces fermières produites à partir du lait de nos vaches montbéliardes. \r\nGâteaux glacés \r\nLabyrinthe de maïs sur la période estivale (Attention en fonction de la météo les plages horaires peuvent varier)"
    ],
    "es": [
      "Helados artesanos elaborados con la leche de nuestras vacas de Montbéliard.\r\nTartas heladas\r\nLaberinto de maíz durante el verano (Tenga en cuenta que los horarios pueden variar en función del tiempo)"
    ],
    "nl": [
      "Boerenijs gemaakt van de melk van onze Montbéliard koeien.\r\nIjscake\r\nMaïsdoolhof tijdens de zomer (Let op: tijden kunnen variëren afhankelijk van het weer)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Glaces Alliait - GAEC La Laitière"
    ]
  },
