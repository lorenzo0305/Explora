  "rdfs:comment": {
    "de": [
      "Thema: Alpine Skiweltmeisterschaft 2023.\r\nDie Skifahrerin nimmt den Besucher in den Arm, während sie mit hoher Geschwindigkeit Ski fährt. Der Künstler sucht die Verbindung \"Werk\" / \"Betrachter\".\r\nFarbige sportliche Frau, Stellung von Frauen im Sport."
    ],
    "en": [
      "Theme: Alpine World Ski Championships 2023\r\nThe skier takes the visitor in her arms as she skis at high speed. The artist seeks the connection between \"work\" and \"spectator\".\r\nSportswoman of color, women's place in sport."
    ],
    "it": [
      "Tema: Campionati mondiali di sci alpino 2023\r\nLa sciatrice prende in braccio il visitatore mentre scia ad alta velocità. L'artista cerca un collegamento tra \"lavoro\" e \"spettatore\".\r\nUna sportiva di colore, il posto delle donne nello sport."
    ],
    "fr": [
      "Thème : Championnat du monde de ski alpin 2023\r\nLa skieuse prend le visiteur dans ses bras alors qu'elle skie à grande vitesse. L'artiste recherche la connexion \"œuvre\" / \"spectateur\".\r\nFemme sportive de couleur, place qu'occupent les femmes dans le sport."
    ],
    "nl": [
      "Thema: 2023 Alpine Wereldkampioenschappen Skiën\r\nDe skiër neemt de bezoeker in haar armen terwijl ze met hoge snelheid skiet. De kunstenaar zoekt naar een verband tussen \"werk\" en \"toeschouwer\".\r\nEen sportvrouw met kleur, de plaats van vrouwen in de sport."
    ],
    "es": [
      "Tema: Campeonato del Mundo de Esquí Alpino 2023\r\nLa esquiadora coge al visitante en brazos mientras esquía a gran velocidad. El artista busca una conexión entre la \"obra\" y el \"espectador\".\r\nUna deportista de color, el lugar de la mujer en el deporte."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fresko: \"Die Umarmung der Skifahrerin\"."
    ],
    "en": [
      "Fresco: \"Le câlin de la skieuse\" (The skier's hug)"
    ],
    "it": [
      "Affresco: \"La coccola dello sciatore"
    ],
    "fr": [
      "Fresque : \"Le câlin de la skieuse\""
    ],
    "nl": [
      "Fresco: \"De knuffel van de skiër"
    ]
  },
