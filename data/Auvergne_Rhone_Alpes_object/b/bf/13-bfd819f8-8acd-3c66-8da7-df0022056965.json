  "rdfs:comment": {
    "de": [
      "Das Ciné Massiac, ein ehemaliger Wohnort, der in einen Kinosaal umgewandelt wurde, erweckt einen symbolträchtigen Raum im Stadtzentrum zu neuem Leben. In einer warmen und intimen Atmosphäre empfangen seine 80 Sessel Groß und Klein, um das Vergnügen der großen Leinwand zu genießen."
    ],
    "en": [
      "Ciné Massiac, a former living space that has been converted into a cinema, has given a new lease of life to an emblematic downtown venue. In a warm and intimate atmosphere, its 80 seats welcome young and old to enjoy the pleasure of the big screen."
    ],
    "it": [
      "Il Ciné Massiac, un ex spazio abitativo trasformato in cinema, ha ridato vita a uno degli spazi più emblematici del centro città. In un'atmosfera calda e intima, i suoi 80 posti a sedere accolgono giovani e meno giovani per godere del piacere del grande schermo."
    ],
    "fr": [
      "Ancien lieu de vie réhabilité en salle de cinéma, le Ciné Massiac redonne vie à un espace emblématique du centre-ville. Dans une ambiance chaleureuse et intime, ses 80 fauteuils accueillent petits et grands pour savourer le plaisir du grand écran."
    ],
    "es": [
      "Ciné Massiac, una antigua vivienda reconvertida en sala de cine, ha dado nueva vida a uno de los espacios más emblemáticos del centro de la ciudad. En un ambiente cálido e íntimo, sus 80 butacas acogen a grandes y pequeños para disfrutar del placer de la gran pantalla."
    ],
    "nl": [
      "Ciné Massiac, een voormalige woonruimte die is omgebouwd tot bioscoop, heeft een van de meest karakteristieke ruimtes van het stadscentrum nieuw leven ingeblazen. In een warme en intieme sfeer verwelkomen de 80 zitplaatsen jong en oud om te genieten van het grote scherm."
    ]
  },
  "rdfs:label": {
