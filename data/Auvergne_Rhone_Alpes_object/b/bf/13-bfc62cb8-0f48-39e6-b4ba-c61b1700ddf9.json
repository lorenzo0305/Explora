  "rdfs:comment": {
    "de": [
      "Das in den 1920er Jahren errichtete Sägewerk nutzte zunächst die Wasserkraft des Flusses Dranse. Jahrhunderts elektrifiziert, um den jahreszeitlich bedingten Schwankungen der Wasserführung des Wildbachs entgegenzuwirken."
    ],
    "en": [
      "Built in the 1920s, this sawmill initially used the hydraulic power of the Dranse. It was electrified in the mid-20th century to compensate for seasonal variations in the torrent's flow."
    ],
    "it": [
      "Costruita negli anni '20, questa segheria inizialmente sfruttava la forza idraulica della Dranse. A metà del XX secolo è stata elettrificata per compensare le variazioni stagionali della portata del torrente."
    ],
    "fr": [
      "Bâtie dans les années 1920, cette scierie a d'abord utilisé la force hydraulique de la Dranse. Elle fut électrifiée au milieu du XXème siècle pour remédier aux variations saisonnières du débit du torrent."
    ],
    "nl": [
      "Deze in de jaren twintig gebouwde zagerij maakte eerst gebruik van het hydraulische vermogen van de Dranse. Het werd geëlektrificeerd in het midden van de twintigste eeuw om seizoensgebonden variaties in de stroom van de torrent tegen te gaan."
    ],
    "es": [
      "Construido en la década de 1920, este aserradero utilizaba inicialmente la fuerza hidráulica del Dranse. A mediados del siglo XX se electrificó para compensar las variaciones estacionales del caudal del torrente."
    ]
  },
  "rdfs:label": {
    "en": [
      "The sawmill of Villapeyron"
    ],
    "fr": [
      "La Scierie de Villapeyron"
    ],
    "nl": [
      "Villapeyron zaagmolen"
    ]
  },
