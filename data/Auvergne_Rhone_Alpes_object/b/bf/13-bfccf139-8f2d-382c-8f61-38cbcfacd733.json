  "rdfs:comment": {
    "de": [
      "Schon immer hat sich Gregory Vacher die Frage nach dem Sinn des Lebens gestellt. Was wird ihn endlich dauerhaft glücklich machen?"
    ],
    "en": [
      "Gregory Vacher has always wondered about the meaning of life. What will finally make him happy in the long term?"
    ],
    "it": [
      "Gregory Vacher si è sempre interrogato sul senso della vita. Cosa lo renderà finalmente felice a lungo termine?"
    ],
    "fr": [
      "Depuis toujours, Gregory Vacher s'interroge sur le sens de la vie. Qu'est-ce qui le rendra enfin heureux de manière durable ?"
    ],
    "es": [
      "Gregory Vacher siempre se ha preguntado por el sentido de la vida. Qué es lo que finalmente le hará feliz a largo plazo?"
    ],
    "nl": [
      "Gregory Vacher heeft zich altijd afgevraagd wat de zin van het leven is. Wat zal hem uiteindelijk gelukkig maken op de lange termijn?"
    ]
  },
