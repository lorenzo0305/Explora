  "rdfs:comment": {
    "de": [
      "Freie Besichtigung gegen Gebühr.\r\nDieser englische Park wurde 1804 von Aglaë Adanson angelegt und ist der älteste private Botanik- und Blumenpark Frankreichs (als Jardin remarquable - MH und Jardin remarquable et jardin européen klassifiziert)."
    ],
    "en": [
      "Self-guided tour (fee payable).\r\nThis English-style park, created in 1804 by Aglaë Adanson, is the oldest private botanical and floral park in France (classified as a \"jardin remarquable\" - MH - and a \"jardin remarquable\" and European garden)."
    ],
    "it": [
      "Ingresso gratuito.\r\nQuesto parco in stile inglese, creato nel 1804 da Aglaë Adanson, è il più antico parco botanico e floreale privato di Francia (classificato come giardino notevole - MH e giardino notevole e giardino europeo)."
    ],
    "fr": [
      "Visite libre payante. \r\nCe parc à l'anglaise, créé en 1804 par Aglaë Adanson, est le plus ancien parc botanique et floral privé de France (classé jardin remarquable - MH et jardin remarquable et jardin européen)."
    ],
    "nl": [
      "Gratis toegang.\r\nDit park in Engelse stijl, aangelegd in 1804 door Aglaë Adanson, is het oudste privé botanische en bloemenpark in Frankrijk (geklasseerd als opmerkelijke tuin - MH en opmerkelijke tuin en Europese tuin)."
    ],
    "es": [
      "Entrada gratuita.\r\nEste parque de estilo inglés, creado en 1804 por Aglaë Adanson, es el parque botánico y floral privado más antiguo de Francia (catalogado como jardín notable - MH y jardín notable y jardín europeo)."
    ]
  },
