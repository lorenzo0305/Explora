  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Bar und unser Restaurant. Tagesgericht auf Vorbestellung und Schnellimbiss mit Wurstbrett oder Wurst und Käse. Möglichkeit, Pizzas zu bestellen, die Sie vor Ort essen oder mitnehmen können"
    ],
    "en": [
      "Come and discover our bar and restaurant. Dish of the day on reservation and fast food with charcuterie board or charcuterie and cheese. Pizzas available to eat in or take away"
    ],
    "it": [
      "Venite a scoprire il nostro bar e ristorante. Piatto del giorno su prenotazione e fast food con tagliere di salumi o salumi e formaggi. È inoltre possibile ordinare pizze da mangiare o da portare via"
    ],
    "fr": [
      "Venez découvrir notre bar et restaurant. Plat du jour sur réservation et restauration rapide avec planche de charcuterie ou charcuterie et fromage. Possibilité de commander des pizzas à manger sur place ou à emporter"
    ],
    "es": [
      "Venga a descubrir nuestro bar y restaurante. Plato del día previa reserva y comida rápida con tabla de embutidos o charcutería y queso. También puede pedir pizzas para comer en el restaurante o para llevar"
    ],
    "nl": [
      "Kom en ontdek onze bar en restaurant. Dagschotel op reservering en fastfood met vleeswarenplankje of vleeswaren en kaas. Je kunt ook pizza's bestellen om te eten of om mee te nemen"
    ]
  },
