  "rdfs:comment": {
    "de": [
      "Der Bauernhof Les Grands Goulets züchtet Ziegen und Kühe. Vercodons, Tomme à pâte pressée non cuite, Bleu de chèvre sind die Hauptprodukte. Direktverkauf ab Hof oder auf dem Markt in La Chapelle en Vercors."
    ],
    "en": [
      "The Grands Goulets farm raises goats and cows. Vercodons, pressed uncooked tomme and bleu de chèvre are the star products. Direct sales at the farm or at the La Chapelle en Vercors market."
    ],
    "it": [
      "L'azienda agricola Grands Goulets alleva capre e mucche. I prodotti di punta sono i Vercodons, il tomme pressato non cotto e il formaggio blu di capra. Venduti direttamente dalla fattoria o al mercato di La Chapelle en Vercors."
    ],
    "fr": [
      "La ferme des Grands Goulets, élève chèvres et vaches. Vercodons, tomme à pâte pressée non cuite, bleu de chèvre  sont les produits phares. Vente directe à la ferme ou sur le marché de La Chapelle en Vercors."
    ],
    "es": [
      "La granja Grands Goulets cría cabras y vacas. Vercodons, tomme cruda prensada y queso azul de cabra son los productos estrella. Se venden directamente en la granja o en el mercado de La Chapelle en Vercors."
    ],
    "nl": [
      "De boerderij Grands Goulets fokt geiten en koeien. Vercodons, geperste ongekookte tomme en blauwe geitenkaas zijn de paradepaardjes. Ze worden rechtstreeks van de boerderij verkocht of op de markt in La Chapelle en Vercors."
    ]
  },
