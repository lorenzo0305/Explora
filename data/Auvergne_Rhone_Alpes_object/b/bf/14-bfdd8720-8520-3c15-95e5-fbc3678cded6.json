  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a7ab4852-ae26-365f-9490-0bbab4954575",
      "dc:description": {
        "de": [
          "Barbier Friseur\nPremium - Barttrimmen - Haartattoo\nErstellung von Instagram- und Tiktok-Inhalten\nVerkauf von Stylingprodukten\n\nAnsatz zur Förderung einer nachhaltigen und natürlichen Haargesundheit, indem dem Haar ein zweiter Lebenszyklus geboten wird --> capillum"
        ],
        "en": [
          "Barber hairdresser\nPremium - Beard trimming - Hair tattoo\nInstagram and Tiktok content creation\nSale of styling products\n\nPromoting sustainable, natural hair health by giving hair a second life cycle --> capillum"
        ],
        "it": [
          "Barbiere\nPremium - Rifinitura della barba - Tatuaggio dei capelli\nCreazione di contenuti Instagram e Tiktok\nVendita di prodotti per lo styling\n\nPromuovere una salute dei capelli sostenibile e naturale, dando ai capelli un secondo ciclo di vita --> capillum"
        ],
        "fr": [
          "Coiffeur barbier \nPremium - Taille de barbe - Hair tattoo\nCréation de contenu Instagram et Tiktok\nVente de produits coiffants\n\nDémarche de promotion de la santé capillaire durable et naturelle en offrant un second cycle de vie aux cheveux --> capillum"
        ],
        "es": [
          "Peluquería\nPremium - Corte de barba - Tatuaje de pelo\nCreación de contenidos para Instagram y Tiktok\nVenta de productos de peluquería\n\nPromoción de la salud capilar sostenible y natural dando al cabello un segundo ciclo de vida --> capillum"
        ],
        "nl": [
          "Kapper\nPremium - Baard knippen - Haartatoeage\nCreatie van Instagram en Tiktok-content\nVerkoop van stylingproducten\n\nBevorderen van duurzame, natuurlijke haargezondheid door haar een tweede levenscyclus te geven --> capillum"
        ]
      },
      "@type": [
        "Description"
      ],
