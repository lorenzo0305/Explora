  "rdfs:comment": {
    "de": [
      "Ich bin ein staatlich geprüfter Bergführer, der sich für die Wildnis und Abenteuerreisen begeistert. Ich hatte das Glück, zahlreiche Reisen zu Fuß, mit dem Motorrad oder dem Kanu in Europa, Südostasien und Kanada zu unternehmen."
    ],
    "en": [
      "A qualified mountain leader with a passion for the wilderness and adventure travel, I have been lucky enough to make a large number of trips on foot, motorcycle or canoe in Europe, South-East Asia and Canada."
    ],
    "it": [
      "Leader di montagna qualificato con la passione per la natura selvaggia e i viaggi d'avventura, ho avuto la fortuna di intraprendere un gran numero di viaggi a piedi, in moto o in canoa in Europa, nel Sud-Est asiatico e in Canada."
    ],
    "fr": [
      "Accompagnateur en montagne Diplômé d’État, passionné par les milieux sauvages et le voyage d’aventure, j’ai eu la chance de réaliser un grand nombre de voyages à pied, en moto ou en canoë en Europe, en Asie du Sud-Est et au Canada."
    ],
    "es": [
      "Líder de montaña titulado y apasionado de la naturaleza salvaje y los viajes de aventura, he tenido la suerte de emprender un gran número de viajes a pie, en moto o en canoa por Europa, el sudeste asiático y Canadá."
    ],
    "nl": [
      "Ik ben een gekwalificeerd bergleider met een passie voor de wildernis en avontuurlijk reizen. Ik heb het geluk gehad om een groot aantal tochten te voet, op de motor of per kano te maken in Europa, Zuidoost-Azië en Canada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Accompagnateur en montagne - Sébastien VINCENT"
    ]
  },
