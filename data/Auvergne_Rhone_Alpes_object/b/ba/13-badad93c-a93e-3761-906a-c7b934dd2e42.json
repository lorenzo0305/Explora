  "rdfs:comment": {
    "de": [
      "Haben Sie Lust, eine Weile zu spielen? Ob mit Freunden oder der Familie, ob Sie nun ein Experte oder ein Anfänger sind, kommen Sie einfach vorbei und verbringen Sie eine schöne Zeit!\r\nSnacks und Getränke vor Ort.\r\nOrganisiert von der Xtrem Nord Association."
    ],
    "en": [
      "Want to spend some time playing? With friends or family, whether you're an expert or a beginner, don't hesitate to come and have a good time!\r\nSnacks and refreshments on site.\r\nOrganized by Association Xtrem Nord."
    ],
    "it": [
      "Volete passare un po' di tempo a giocare? Con gli amici o la famiglia, che siate esperti o principianti, non esitate a venire a divertirvi!\r\nSpuntini e rinfreschi sul posto.\r\nOrganizzato dall'Associazione Xtrem Nord."
    ],
    "fr": [
      "Envie de passer un moment à jouer? Entre amis ou en famille, que vous soyez un expert ou un(e) débutant(e), n'hésitez pas à venir passez un bon moment!\r\nSnack et buvette sur place.\r\nOrganisé par l'Association Xtrem Nord."
    ],
    "es": [
      "¿Quieres pasar un rato jugando? Con amigos o en familia, ya seas experto o principiante, ¡no dudes en venir a pasarlo bien!\r\nAperitivos y refrescos in situ.\r\nOrganizado por la Asociación Xtrem Nord."
    ],
    "nl": [
      "Wil je wat tijd doorbrengen met spelen? Met vrienden of familie, of je nu een expert bent of een beginner, aarzel niet en kom plezier maken!\r\nSnacks en drankjes ter plaatse.\r\nGeorganiseerd door de Xtrem Nord Association."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Journée jeux de société"
    ]
  },
