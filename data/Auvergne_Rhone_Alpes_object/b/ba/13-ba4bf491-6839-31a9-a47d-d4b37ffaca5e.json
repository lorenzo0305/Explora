  "rdfs:comment": {
    "de": [
      "Traben Sie mit dem Carré des As! Geführte Spaziergänge mit französischen Maxitrott' TOUT TERRAIN und Elektrofahrzeugen. Vereinbaren Sie Ihren Termin mit Jérôme, Ihrem professionellen Führer."
    ],
    "en": [
      "Trottinez avec le Carré des As ! Guided rides on French ALL-TERRAIN and electric maxitrott'. Make an appointment with Jérôme, your professional guide."
    ],
    "it": [
      "Trottinez avec le Carré des As ! Escursioni guidate su ALL-TERRAIN e maxitrottini elettrici francesi. Fissate un appuntamento con Jérôme, la vostra guida professionale."
    ],
    "fr": [
      "Trottinez avec le Carré des As ! Promenades guidées en maxitrott' françaises TOUT TERRAIN et électriques. Fixez votre rendez-vous avec Jérôme, votre guide professionnel."
    ],
    "es": [
      "¡Trottinez avec le Carré des As ! Paseos guiados en ALL-TERRAIN francés y maxitrott' eléctrico. Concierte una cita con Jérôme, su guía profesional."
    ],
    "nl": [
      "Trottinez avec le Carré des As ! Begeleide ritten op Franse ALL-TERRAIN en elektrische maxitrott'. Maak een afspraak met Jérôme, je professionele gids."
    ]
