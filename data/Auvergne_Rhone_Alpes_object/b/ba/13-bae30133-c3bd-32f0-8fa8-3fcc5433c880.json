  "rdfs:comment": {
    "de": [
      "Die Academy von Evian Resort Golf Club wurde von einem Team von Spezialisten (Designern, Spielern, Champions) entwickelt, um das Golfspiel ganz neu zu erfinden."
    ],
    "en": [
      "The Academy of the Evian Resort Golf Club was designed by a team of specialists (designers, players, champions and pros) in order to reinvent pure and simple the practice of golf."
    ],
    "it": [
      "L'Accademia dell'Evian Resort Golf Club è stata progettata da un team di specialisti (designer, giocatori, campioni e professionisti) per reinventare semplicemente il gioco del golf."
    ],
    "fr": [
      "L’Academy de l’Evian Resort Golf Club a été conçue par une équipe de spécialistes (concepteurs, joueurs, champions et pros) afin de réinventer purement et simplement la pratique du golf."
    ],
    "es": [
      "La Academia del Evian Resort Golf Club ha sido diseñada por un equipo de especialistas (diseñadores, jugadores, campeones y profesionales) para reinventar de forma sencilla el juego del golf."
    ],
    "nl": [
      "De Evian Resort Golf Club Academy is ontworpen door een team van specialisten (ontwerpers, spelers, kampioenen en pro's) om het golfspel opnieuw uit te vinden."
    ]
  },
