  "rdfs:comment": {
    "de": [
      "Die ADIS-Gruppe bietet Ihnen 27 neue Wohnungen zum Verkauf in Suze-la-Rousse an. Die ruhig gelegene Residenz Le Jardin des Baux bietet Ihnen Komfort und ein angenehmes Wohnen nur 10 Minuten von der A7 entfernt."
    ],
    "en": [
      "The ADIS Group offers 27 new apartments, on sale at Suze-la-Rousse. In a peaceful location, the residence Le Jardin des Baux offers comfort and good living 10 minutes from the A7."
    ],
    "it": [
      "ADIS è un costruttore di case unifamiliari, promotore immobiliare, suddividitore e agente di gestione.\r\nProgetto: residenza con 18 appartamenti in vendita a Suze la Rousse, da consegnare nel dicembre 2024."
    ],
    "fr": [
      "ADIS est à la fois constructeur de maisons individuelles, promoteur immobilier, aménageur, lotisseur et gestionnaire de syndic. \r\nProjet : résidence composée de 18 appartements à la vente sur Suze la Rousse, livraison décembre 2024."
    ],
    "nl": [
      "Groep “ADIS” biedt, in Suze-la-Rousse, 27 nieuwe appartementen te koop aan. In een rustige omgeving, op 10 minuten van de A7, verzekert residentie “Le Jardin des Baux” een comfortabele en rustige levensplek."
    ],
    "es": [
      "ADIS es un constructor de viviendas unifamiliares, promotor inmobiliario, subdivisor y agente de gestión.\r\nProyecto: residencia con 18 pisos en venta en Suze la Rousse, que se entregará en diciembre de 2024."
    ]
  },
