  "rdfs:comment": {
    "de": [
      "Taboulé&Co bietet Sandwiches oder Bowls an, die mit typischen Gerichten wie Falafel oder Hummus zusammengestellt und mit Rohkost serviert werden.\r\nEin Tagesgericht wird ebenfalls angeboten."
    ],
    "en": [
      "Taboulé&Co offers sandwiches or bowls with typical dishes such as falafel or hummus, accompanied by crudités.\r\nA daily special is also available."
    ],
    "it": [
      "Taboulé&Co propone panini o ciotole con piatti tipici, come falafel o hummus, accompagnati da verdure crude.\r\nÈ disponibile anche un piatto del giorno."
    ],
    "fr": [
      "Taboulé&Co propose des sandwichs ou bowls à composer avec des mets typiques, comme des falafels ou du houmous, accompagnés de crudités.\r\nUn plat du jour est également proposé."
    ],
    "es": [
      "Taboulé&Co ofrece bocadillos o cuencos con platos típicos, como falafel o hummus, acompañados de verduras crudas.\r\nTambién se ofrece un plato del día."
    ],
    "nl": [
      "Taboulé&Co biedt sandwiches of bowls met typische gerechten, zoals falafel of hummus, vergezeld van rauwkost.\r\nEr is ook een dagschotel verkrijgbaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restauration rapide : Traiteur Taboulé & Co"
    ]
  },
