  "rdfs:comment": {
    "de": [
      "Fleischrestaurant und Bierbar. Alle unsere Produkte sind frisch und werden von uns zubereitet oder zerlegt, lokale Produkte, hausgemachte Pommes frites... Geselligkeit und hausgemachte Küche sind unsere Schlüsselwörter."
    ],
    "en": [
      "Meat restaurant and beer bar. All our products are fresh, prepared or cut by us, local produce, home fries... Conviviality and home cooking are our watchwords."
    ],
    "it": [
      "Ristorante di carne e birreria. Tutti i nostri prodotti sono freschi, preparati o tagliati da noi, prodotti locali, patatine fritte... Convivialità e cucina casalinga sono le nostre parole d'ordine."
    ],
    "fr": [
      "Restaurant de viande et bar à bières. Tous nos produits sont frais, préparés ou découpés par nos soins, produits locaux, frites maison... Convivialité et cuisine maison sont nos maitres mots."
    ],
    "nl": [
      "Vleesrestaurant en bierbar. Al onze producten zijn vers, door ons bereid of versneden, streekproducten, huisgemaakte frietjes... Gezelligheid en thuis koken zijn onze sleutelwoorden."
    ],
    "es": [
      "Restaurante de carne y bar de cerveza. Todos nuestros productos son frescos, preparados o cortados por nosotros, productos locales, patatas fritas caseras... Convivialidad y cocina casera son nuestras consignas."
    ]
  },
  "rdfs:label": {
