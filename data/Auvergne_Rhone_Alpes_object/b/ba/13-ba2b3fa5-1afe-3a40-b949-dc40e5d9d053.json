  "rdfs:comment": {
    "de": [
      "Die seit 1800 in den Bergen von Bourbonnaise ansässige Mühle stellt ausschließlich Mehl aus Getreide aus zertifiziertem biologischem Anbau FR-B/O-01 (Weizen, Roggen, Dinkel, Kamut, Einkorn) sowie Walnuss- und Haselnussöl her."
    ],
    "en": [
      "The mill, installed in the Bourbonnais mountains since 1800, produces only flours from cereals grown organically certified FR-B/O-01 (wheat, rye, spelt, kamut, baby spelt) and walnut and hazelnut oil."
    ],
    "it": [
      "Il mulino, situato sulle montagne di Bourbonnaise dal 1800, produce solo farine di cereali da agricoltura biologica certificati FR-B/O-01 (grano, segale, farro, kamut, piccolo farro) e olio di noci e nocciole."
    ],
    "fr": [
      "Le moulin, installé en  montagne bourbonnaise depuis 1800 produit uniquement des farines issues de céréales en culture biologique certifiée FR-B/O-01 (blé, seigle, épeautre, kamut, petit épeautre) et de l'huile de noix et de noisettes."
    ],
    "es": [
      "El molino, establecido en las montañas de Bourbonnaise desde 1800, sólo produce harinas de cereales de cultivo ecológico certificadas FR-B/O-01 (trigo, centeno, espelta, kamut, pequeña espelta) y aceite de nuez y avellana."
    ],
    "nl": [
      "De molen, die sinds 1800 in de bergen van Bourbonnais staat, produceert uitsluitend meel van biologisch geteelde granen met FR-B/O-01 certificaat (tarwe, rogge, spelt, kamut, kleine spelt) en walnoot- en hazelnootolie."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Moulin de Gribory"
    ]
  },
