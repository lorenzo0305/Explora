  "rdfs:comment": {
    "de": [
      "Bauernhof zur Herstellung und Entdeckung von Heilpflanzen: In ihren Workshops, aber auch bei geführten Pflückungen oder botanischen Ausflügen, lässt Marie-France Sie ganz einfach an ihrem Wissen und ihren Tricks teilhaben!"
    ],
    "en": [
      "Production and discovery farm for medicinal plants: Marie-France shares her knowledge and her tricks of the trade through her workshops, guided gatherings and botanical outings!"
    ],
    "it": [
      "Una fattoria dove si producono e si scoprono le piante medicinali: Marie-France condivide con voi le sue conoscenze e i suoi trucchi del mestiere nei suoi laboratori, nelle raccolte guidate e nelle uscite botaniche!"
    ],
    "fr": [
      "Ferme de production et de découverte de plantes médicinales : au travers de ses ateliers, mais aussi de cueillettes guidées ou encore de sorties botaniques, Marie-France vous fait partager ses connaissances et ses tours de main en toute simplicité !"
    ],
    "es": [
      "Una granja donde se producen y descubren plantas medicinales: Marie-France comparte con usted sus conocimientos y sus trucos del oficio en sus talleres, recolecciones guiadas y salidas botánicas"
    ],
    "nl": [
      "Een boerderij waar geneeskrachtige planten worden geproduceerd en ontdekt: Marie-France deelt haar kennis en kneepjes van het vak met jou tijdens haar workshops, begeleide plukbeurten en botanische uitstapjes!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de la Reine des Près"
    ]
  },
