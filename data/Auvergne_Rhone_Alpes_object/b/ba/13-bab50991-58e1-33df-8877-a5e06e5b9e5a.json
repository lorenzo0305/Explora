  "rdfs:comment": {
    "de": [
      "Familienbetrieb. Anbau von Olivenbäumen und Trüffeleichen. \r\nVerkauf von Olivenöl das ganze Jahr über und frischen Trüffeln in der Saison. \r\nNur nach Vereinbarung."
    ],
    "en": [
      "Farm products, fresh truffles and olive oil. \r\nFamily-run farm of olive trees and truffle oaks. Olive oil sales all year and truffles in season. Appointments only"
    ],
    "it": [
      "Il Domaine du Val des Nymphes in Provenza... un nome magico per un sito storico di rilievo.\r\nQuesta tenuta è soprattutto un luogo familiare, con i suoi ulivi e le sue querce da tartufo."
    ],
    "fr": [
      "Le Domaine du Val des Nymphes en Provence... un nom magique pour un site historique classé remarquable.\r\nCe domaine est avant tout un lieu familial avec ses oliviers et ses chênes truffiers."
    ],
    "nl": [
      "Producten afkomstig van onze boerderij, verse truffels en olijfolie, familieboerderij. Olijfboomgaard en truffeleiken. Verkoop olijfolie gehele jaar en verse truffels in het seizoen. Alleen op afspraak."
    ],
    "es": [
      "El Domaine du Val des Nymphes en Provenza... un nombre mágico para un notable lugar histórico catalogado.\r\nEsta finca es ante todo un lugar familiar, con sus olivos y robles trufados."
    ]
  },
