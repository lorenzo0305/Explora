  "rdfs:comment": {
    "de": [
      "Denkmalgeschützte Kirche aus dem 12. Jahrhundert mit einem Glockenturm, der mit mehrfarbigen glasierten Dachziegeln bedeckt ist. Sie gehört zu den Kluniazenserstätten. Château de Séjallières aus dem 15. Jahrhundert (privat). Voie Bollène: alte römische Straße. Ehemalige kastralische Siedlung am Felsen La Miramande."
    ],
    "en": [
      "Listed 12th-century church with bell tower covered in polychrome glazed tiles. One of the Cluniac sites. 15th-century Château de Séjallières (private). Voie Bollène: ancient Roman road. Ancient castral site at La Miramande rock."
    ],
    "it": [
      "Chiesa del XII secolo, tutelata, con campanile rivestito di piastrelle smaltate policrome. È uno dei siti cluniacensi. Castello di Séjallières (privato) del XV secolo. Voie Bollène: antica strada romana. Antico sito castrale presso la roccia di La Miramande."
    ],
    "fr": [
      "Église classée du 12e siècle avec clocher recouvert de tuiles vernissées polychromes. Elle fait partie des sites clunisiens. Château de Séjallières du XVe siècle (privé). Voie Bollène : ancienne voie romaine. Ancien site castral au rocher de La Miramande."
    ],
    "es": [
      "Iglesia catalogada del siglo XII con campanario cubierto de azulejos policromados. Forma parte de los lugares cluniacenses. Castillo de Séjallières del siglo XV (privado). Voie Bollène: antigua calzada romana. Antiguo emplazamiento castral en la roca de La Miramande."
    ],
    "nl": [
      "Een kerk uit de 12e eeuw met een klokkentoren bedekt met polychrome geglazuurde tegels. Het is een van de Cluniac sites. 15e-eeuws kasteel van Séjallières (privé). Voie Bollène: oude Romeinse weg. Oude castrale site bij de rots van La Miramande."
    ]
  },
