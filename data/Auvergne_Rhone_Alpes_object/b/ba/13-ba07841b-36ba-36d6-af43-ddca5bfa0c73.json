  "rdfs:comment": {
    "de": [
      "Teilen Sie einen geselligen Moment bei einem Sauerkrautabend! Auf dem Menü stehen großzügiges Sauerkraut, Käse, Salat, Dessert und Kaffee, alles in einer festlichen Atmosphäre, die für einen Abend im Zeichen der guten Laune animiert."
    ],
    "en": [
      "Share a convivial moment over an evening of sauerkraut! On the menu: generous sauerkraut, cheese, salad, dessert and coffee, all in a lively, festive atmosphere for a fun-filled evening."
    ],
    "it": [
      "Condividete un momento di convivialità in una serata a base di crauti! Nel menu: crauti abbondanti, formaggio, insalata, dessert e caffè, il tutto in un'atmosfera vivace e festosa per una serata all'insegna del buonumore."
    ],
    "fr": [
      "Partagez un moment convivial autour d’une soirée choucroute ! Au menu : choucroute généreuse, fromage, salade, dessert et café, le tout dans une ambiance festive animée pour une soirée placée sous le signe de la bonne humeur."
    ],
    "nl": [
      "Deel een gezellig moment tijdens een avondje zuurkool! Op het menu: royale zuurkool, kaas, salade, dessert en koffie, allemaal in een levendige, feestelijke sfeer voor een avond vol goed humeur."
    ],
    "es": [
      "Comparta un momento de convivencia durante una velada a base de chucrut En el menú: chucrut abundante, queso, ensalada, postre y café, todo ello en un ambiente animado y festivo para una velada llena de buen humor."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée choucroute"
    ]
  },
