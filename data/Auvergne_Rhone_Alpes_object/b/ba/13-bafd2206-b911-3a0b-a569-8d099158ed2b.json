  "rdfs:comment": {
    "de": [
      "LOTO -->+1 500 ? an Preisen zu gewinnen!  Versuchen Sie Ihr Glück und verbringen Sie einen geselligen Moment!  Essen und Trinken vor Ort. Mit dem Erlös wird die Jahresabschlussfahrt der Schüler der Grundschule und des Kindergartens in Bellenaves finanziert."
    ],
    "en": [
      "LOTO -->+1,500? prizes to be won!  Come and try your luck and share a convivial moment!  Catering and refreshments on site. Profits will be used to finance the end-of-year trip for pupils at Bellenaves primary and nursery schools."
    ],
    "it": [
      "LOTO -->+1.500? premi in palio!  Venite a tentare la fortuna e a condividere un momento di convivialità!  Catering e rinfreschi in loco. Il ricavato sarà destinato alla gita di fine anno degli alunni delle scuole elementari e materne di Bellenaves."
    ],
    "fr": [
      "LOTO -->+1 500 € de lots à gagner !  Venez tenter votre chance et partager un moment convivial !  Restauration et buvette sur place. Les bénéfices financeront le voyage de fin d’année des élèves de l’école primaire et maternelle de Bellenaves."
    ],
    "nl": [
      "LOTO -->+1.500? prijzen te winnen!  Kom je geluk beproeven en deel een gezellig moment!  Catering en versnaperingen ter plaatse. Alle opbrengsten gaan naar de eindejaarsreis voor leerlingen van de Bellenaves lagere en kleuterscholen."
    ],
    "es": [
      "LOTO -->+1.500? ¡premios para ganar!  ¡Venga a probar suerte y a compartir un momento de convivencia!  Catering y refrescos in situ. La recaudación se destinará íntegramente al viaje de fin de curso de los alumnos de las escuelas primarias e infantiles de Bellenaves."
    ]
  },
  "rdfs:label": {
    "fr": [
      "LOTO de l'association des Parents d'Elèves de Bellenaves"
    ]
  },
