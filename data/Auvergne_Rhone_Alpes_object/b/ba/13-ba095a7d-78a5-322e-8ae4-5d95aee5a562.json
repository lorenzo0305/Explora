  "rdfs:comment": {
    "de": [
      "Romanische Kirche, deren südwestliches Querschiff eine im 13. Jahrhundert errichtete Herrschaftskapelle war. Das Querschiff im Norden wurde im 18. Jahrhundert errichtet und 1853 umgebaut."
    ],
    "en": [
      "Romanesque church whose southwest transept of the church was a lord's chapel built in the 13th century. The transept to the north was erected in the 18th century and modified in 1853."
    ],
    "it": [
      "Chiesa romanica il cui transetto sud-ovest era una cappella signorile costruita nel XIII secolo. Il transetto nord fu costruito nel XVIII secolo e modificato nel 1853."
    ],
    "fr": [
      "Eglise Romane dont le transept sud-ouest de l'église fut une chapelle de seigneur construite au XIIIème siècle. Le transept au Nord a été érigé au 18ème siècle et modifié en 1853."
    ],
    "nl": [
      "Romaanse kerk waarvan het zuidwestelijke dwarsschip een herenkapel was die in de 13e eeuw werd gebouwd. Het noordelijke dwarsschip werd gebouwd in de 18e eeuw en gewijzigd in 1853."
    ],
    "es": [
      "Iglesia románica cuyo crucero suroeste era una capilla señorial construida en el siglo XIII. El transepto norte fue construido en el siglo XVIII y modificado en 1853."
    ]
  },
  "rdfs:label": {
