  "rdfs:comment": {
    "de": [
      "Nutzen Sie unseren Gourmet-Barbereich und unsere Terrasse in aller Ruhe, um Waffeln, Aperitifbretter, Bier, Cocktails und lokale Weine zu probieren.\r\n\r\nNeu seit 2025: ein Bouleplatz für Ihre Aperitifs und Afterworks."
    ],
    "en": [
      "A quiet break for a tasting break... take advantage of our bar area & tastings to taste the local flavors offered in our tasting boards, our cocktails and our wine cellar."
    ],
    "it": [
      "Una pausa di tranquillità per una pausa degustazione... approfittate della nostra area bar & degustazioni per gustare i sapori locali proposti nelle nostre tavole degustazione, i nostri cocktail e la nostra cantina."
    ],
    "fr": [
      "Profitez de notre espace bar gourmand et de notre terrasse en toute tranquillité pour déguster gaufres, planches apéritives, bières, cocktails et vins locaux. \r\n\r\nNouveauté depuis 2025 : un terrain de pétanque pour vos apéritifs et Afterworks."
    ],
    "nl": [
      "Profiteer van onze gastronomische bar en terras om te genieten van wafels, aperitieven, bieren, cocktails en lokale wijnen.\r\n\r\nNieuw sinds 2025: een jeu-de-boulesbaan voor uw aperitieven en drankjes na het werk."
    ],
    "es": [
      "Aproveche nuestro bar gastronómico y nuestra terraza para disfrutar de gofres, aperitivos, cervezas, cócteles y vinos locales.\r\n\r\nNovedad desde 2025: una pista de petanca para sus aperitivos y sobremesas."
    ]
  },
  "rdfs:label": {
