  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die bezaubernde Welt von Vellavie: 17 handwerklich hergestellte Liköre und ihre authentischen Aromen. Probieren Sie die ungekünstelte, lokale Exzellenz und lassen Sie sich zu einem unvergesslichen Geschmackserlebnis verführen."
    ],
    "en": [
      "Immerse yourself in the enchanting world of Vellavie: 17 artisanal liqueurs and their authentic flavors. Taste local excellence, without artifice, and let yourself be seduced by an unforgettable taste experience."
    ],
    "it": [
      "Immergetevi nell'incantevole mondo di Vellavie: 17 liquori artigianali e i loro sapori autentici. Assaggiate l'eccellenza locale, senza artifici, e lasciatevi sedurre da un'esperienza di gusto indimenticabile."
    ],
    "fr": [
      "Plongez dans l'univers envoûtant de Vellavie :  17 liqueurs artisanales et leurs saveurs authentiques. Dégustez l'excellence locale, sans artifice, et laissez-vous séduire par une expérience gustative inoubliable."
    ],
    "es": [
      "Sumérjase en el encantador mundo de Vellavie: 17 licores artesanales y sus auténticos sabores. Deguste la excelencia local, sin artificios, y déjese seducir por una experiencia gustativa inolvidable."
    ],
    "nl": [
      "Dompel jezelf onder in de betoverende wereld van Vellavie: 17 ambachtelijke likeuren en hun authentieke smaken. Proef lokale uitmuntendheid, zonder kunstgrepen, en laat je verleiden door een onvergetelijke smaakervaring."
    ]
  },
  "rdfs:label": {
