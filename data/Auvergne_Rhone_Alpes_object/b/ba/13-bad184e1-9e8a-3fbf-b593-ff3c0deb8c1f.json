  "rdfs:comment": {
    "de": [
      "Die Cabane d'Éveux ist eines von 9 Gebäuden, die im Rahmen einer Aktion zur Sanierung von landwirtschaftlichen Hütten in verschiedenen Gemeinden des Pays de L'Arbresle restauriert wurden. Die Aktion wurde vom Fremdenverkehrsamt in Zusammenarbeit mit den Eigentümern und verschiedenen Institutionen durchgeführt."
    ],
    "en": [
      "The Éveux shed is one of five buildings renovated as part of an operation undertaken to save farming sheds in various villages throughout the Arbresle area, headed by the Tourist Office in conjunction with their owners and various institutions."
    ],
    "it": [
      "La capanna di Éveux è uno dei 9 edifici restaurati nell'ambito di un'operazione di recupero di capanne agricole in vari comuni del Pays de L'Arbresle, realizzata dall'Ufficio del Turismo in collaborazione con i proprietari e varie istituzioni."
    ],
    "fr": [
      "La cabane d'Éveux est un des 9 édifices restaurés dans le cadre d'une opération de réhabilitation des cabanes agricoles, sur diverses communes du Pays de L'Arbresle, menée par l'Office de Tourisme en lien avec les propriétaires et diverses institutions."
    ],
    "es": [
      "La cabaña de Éveux es uno de los 9 edificios restaurados en el marco de una operación de rehabilitación de cabañas agrícolas en varios municipios del Pays de L'Arbresle, realizada por la Oficina de Turismo en colaboración con los propietarios y diversas instituciones."
    ],
    "nl": [
      "De hut van Éveux is een van de 9 gebouwen die zijn gerestaureerd in het kader van de restauratie van landbouwhutten in verschillende gemeenten van het Pays de L'Arbresle, uitgevoerd door het Office du Tourisme in samenwerking met de eigenaars en verschillende instellingen."
    ]
  },
