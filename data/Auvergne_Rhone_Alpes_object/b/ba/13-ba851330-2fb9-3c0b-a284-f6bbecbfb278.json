  "rdfs:comment": {
    "de": [
      "Das am Rhône-Ufer gegenüber dem Hôtel Dieu angedockte Ayers Rock Boat bietet Rockkonzerte und Live-Elektro-DJs, Cocktails, Gastronomie und die Möglichkeit der Privatisierung"
    ],
    "en": [
      "Moored on the banks of the Rhône river opposite the Hôtel-Dieu, Ayers Rock Boat Rock offers catering."
    ],
    "it": [
      "Ormeggiato sulle banchine del Rodano di fronte all'Hôtel-Dieu, l'Ayers Rock Boat offre un servizio di ristorazione."
    ],
    "fr": [
      "Amarré sur les quais du Rhône face à l’Hôtel-Dieu, l’Ayers Rock Boat propose de la restauration."
    ],
    "es": [
      "El Ayers Rock Boat, amarrado en las orillas del Ródano, frente al Hôtel-Dieu, ofrece conciertos de rock, sesiones de electro en directo con DJ y cócteles, además de un espacio de restauración y la posibilidad de acoger eventos privados."
    ],
    "nl": [
      "De Ayers Rock Boat ligt afgemeerd aan de kades van de Rhône tegenover het Hôtel-Dieu en biedt catering."
    ]
  },
