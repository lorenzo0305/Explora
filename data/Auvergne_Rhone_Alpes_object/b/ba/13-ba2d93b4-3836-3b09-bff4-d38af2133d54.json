  "rdfs:comment": {
    "de": [
      "Handwerker Messerschmied Schmied Schneider.\r\nVon der Klinge bis zum Griff wird alles vor Ort in meiner Werkstatt hergestellt.\r\nAbgesehen von Ebenholz ist kein anderes Holz exotisch.\r\nAlle Hölzer stammen aus unseren Regionen."
    ],
    "en": [
      "Artisan cutlery forger and taillandier\r\nFrom the blade to the handle, everything is made on site in my workshop.\r\nApart from ebony, no other wood is exotic.\r\nThey all come from our regions."
    ],
    "it": [
      "Coltellinaio e fabbro artigiano\r\nDalla lama al manico, tutto viene realizzato sul posto nel mio laboratorio\r\nOltre all'ebano, nessun altro legno è esotico\r\nTutti provengono dalle nostre regioni."
    ],
    "fr": [
      "Artisan coutelier forgeron taillandier\r\nDe la lame en passant par le manche, tout y est réalisé sur place dans mon atelier. \r\nHormis l'ébène aucun autres bois n'est exotique. \r\nTous viennent de nos régions."
    ],
    "es": [
      "Artesano cuchillero y herrero\r\nDesde la hoja hasta el mango, todo se hace en el momento en mi taller\r\nAparte del ébano, ninguna otra madera es exótica\r\nTodos proceden de nuestras regiones."
    ],
    "nl": [
      "Ambachtelijke besteksmid en -snijder\r\nVan het lemmet tot het handvat, alles wordt ter plekke in mijn werkplaats gemaakt.\r\nBehalve ebbenhout is geen enkel hout exotisch.\r\nZe komen allemaal uit onze streken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Miranda Coutellerie"
    ]
  },
