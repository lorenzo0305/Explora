  "rdfs:comment": {
    "de": [
      "Atmen, beobachten, fühlen... Körper und Geist wieder verbinden, wieder atmen lernen, Gelenke lösen und lockern, Muskeln stärken und dehnen, Raum in unserem Körper und in unserem Geist schaffen."
    ],
    "en": [
      "Breathe, observe, feel. Reconnect body and mind, relearn to breathe, loosen and soften joints, strengthen and stretch muscles, create space in our body and in our mind."
    ],
    "it": [
      "Respirare, osservare, sentire... Ricollegare corpo e mente, reimparare a respirare, sciogliere e rilassare le articolazioni, rafforzare e allungare i muscoli, creare spazio nel nostro corpo e nella nostra mente."
    ],
    "fr": [
      "Respirer, observer, ressentir... Reconnecter corps et esprit, réapprendre à respirer, délier et assouplir les articulations, renforcer et étirer les muscles, créer de l'espace dans notre corps et dans notre esprit."
    ],
    "es": [
      "Respira, observa, siente... Reconectar el cuerpo y la mente, volver a aprender a respirar, aflojar y relajar las articulaciones, fortalecer y estirar los músculos, crear espacio en nuestro cuerpo y nuestra mente."
    ],
    "nl": [
      "Adem, observeer, voel. Verbind lichaam en geest opnieuw, leer opnieuw ademen, maak gewrichten los en verzacht, versterk en rek spieren, creëer ruimte in ons lichaam en in onze geest."
    ]
  },
  "rdfs:label": {
