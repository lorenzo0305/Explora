  "rdfs:comment": {
    "de": [
      "Authentische, moderne und gesellige asiatische Küche, die traditionelle Aromen in einer gemütlichen Atmosphäre vereint. Zubereitet aus frischen Zutaten, erleben Sie ein kulinarisches Erlebnis, das vietnamesische und japanische Traditionen miteinander verbindet."
    ],
    "en": [
      "Authentic, modern, and convivial Asian cuisine blending traditional flavors in a warm atmosphere. Prepared with fresh ingredients, enjoy a culinary experience combining Vietnamese and Japanese traditions"
    ],
    "it": [
      "Cucina asiatica autentica, moderna e amichevole che combina i sapori tradizionali in un'atmosfera accogliente. Preparati con prodotti freschi, godetevi un'esperienza culinaria che unisce le tradizioni vietnamite e giapponesi."
    ],
    "fr": [
      "Cuisine asiatique authentique, moderne et conviviale mêlant des saveurs traditionnelles dans une ambiance chaleureuse. Préparée à base de produits frais, vivez une expérience culinaire alliant traditions vietnamiennes et japonaises."
    ],
    "es": [
      "Cocina asiática auténtica, moderna y acogedora que combina sabores tradicionales en un ambiente cálido. Preparada con productos frescos, disfrute de una experiencia culinaria que combina las tradiciones vietnamita y japonesa."
    ],
    "nl": [
      "Authentieke, moderne en vriendelijke Aziatische keuken met traditionele smaken in een warme sfeer. Bereid met verse producten, geniet van een culinaire ervaring die Vietnamese en Japanse tradities combineert."
    ]
  },
