  "rdfs:comment": {
    "de": [
      "? Sport-, Wellness- und therapeutische Massage: mehr als eine Massage, eine echte Pflege!\r\n? Schocks und Schmerzen: mehr als nur Linderung, beschleunigte Heilung!\r\n? Ayurveda Gesundheit und Ernährung.\r\n? Kundalini Yoga: Mehr als nur eine Körperpraxis!"
    ],
    "en": [
      "• Sports, well-being and therapeutic massage: more than a massage, a real treatment!\r\n• Shocks and pain: more than relief, accelerated healing.\r\n• Ayurveda health and nutrition.\r\n• Kundalini Yoga: more than just a body practice!"
    ],
    "it": [
      "? Massaggio sportivo, benessere e terapeutico: più che un massaggio, un vero e proprio trattamento!\r\n? Shock e dolore: più che sollievo, guarigione accelerata.\r\n? Salute e nutrizione ayurvedica.\r\n? Kundalini Yoga: più di una pratica corporea!"
    ],
    "fr": [
      "• Massage sportif, bien-être et thérapeutique : plus qu'un massage, un véritable soin ! \r\n• Chocs et douleurs : plus qu'un soulagement, une guérison accélérée. \r\n• Ayurvéda santé et nutrition.\r\n• Kundalini Yoga : plus qu'une simple pratique corporelle !"
    ],
    "nl": [
      "? Sport-, welzijns- en therapeutische massage: meer dan een massage, een echte behandeling!\r\n? Schok en pijn: meer dan verlichting, versnelde genezing.\r\n? Ayurveda gezondheid en voeding.\r\n? Kundalini Yoga: meer dan alleen een lichaamsoefening!"
    ],
    "es": [
      "? Masaje deportivo, de bienestar y terapéutico: ¡más que un masaje, un verdadero tratamiento!\r\n? Choque y dolor: más que alivio, curación acelerada.\r\n? Salud y nutrición ayurvédicas.\r\n? Kundalini Yoga: ¡más que una práctica corporal!"
    ]
  },
