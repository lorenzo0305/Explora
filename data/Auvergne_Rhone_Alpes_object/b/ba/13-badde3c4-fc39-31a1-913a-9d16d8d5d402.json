  "rdfs:comment": {
    "de": [
      "Druckerei - Papeterie ? Beaux arts: Herstellung von Visitenkarten, Umschlägen, Notizbüchern, Faltblättern, Broschüren, Katalogen. Kopien in Selbstbedienung.\r\nAusstellung und Bar vor Ort.\r\nBesichtigung während des Sommers oder auf Reservierung für Schulklassen."
    ],
    "en": [
      "Printing - Stationery ? Fine arts: Production of business cards, envelopes, notebooks, leaflets, brochures, catalogs. Self-service copying.\r\nOn-site exhibition and bar.\r\nVisits during summer or by reservation for school groups."
    ],
    "it": [
      "Stampa - Cartoleria? Belle arti: produzione di biglietti da visita, buste, quaderni, opuscoli, brochure, cataloghi. Copiatura self-service.\r\nEsposizione e bar in loco.\r\nVisite durante l'estate o su prenotazione per gruppi scolastici."
    ],
    "fr": [
      "Imprimerie - Papeterie – Beaux arts : Réalisation de cartes de visite, enveloppes, carnets, dépliants, brochures, catalogues. Copies en libre service. \r\nExposition et bar sur place.\r\nVisite durant l'été ou sur réservation pour les scolaires."
    ],
    "es": [
      "Impresión - Papelería ? Bellas artes: Producción de tarjetas de visita, sobres, cuadernos, folletos, prospectos, catálogos. Copistería en autoservicio.\r\nExposición y bar in situ.\r\nVisitas en verano o previa reserva para grupos escolares."
    ],
    "nl": [
      "Drukkerij - kantoorbenodigdheden ? Beeldende kunst: Productie van visitekaartjes, enveloppen, notitieboekjes, folders, brochures, catalogi. Zelfbediening kopiëren.\r\nTentoonstelling en bar ter plaatse.\r\nBezoeken tijdens de zomer of op reservering voor schoolgroepen."
    ]
  },
  "rdfs:label": {
