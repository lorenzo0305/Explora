  "rdfs:comment": {
    "de": [
      "Wir sind Hochgebirgs- und Canyoningführer mit 23 Jahren Erfahrung. Unser Ziel ist es, Ihnen in kleinen Gruppen und in guter Atmosphäre eine unvergessliche Zeit zu bereiten."
    ],
    "en": [
      "High mountain and canyoning guides with 23 years' experience, our ambition is to give you an unforgettable experience in small groups and in a good atmosphere."
    ],
    "it": [
      "Come guide di alta montagna e di canyoning con 23 anni di esperienza, il nostro obiettivo è quello di farvi vivere un'esperienza indimenticabile in piccoli gruppi e in una grande atmosfera."
    ],
    "fr": [
      "Guides de haute-montagne et de canyon avec 23 ans d'expérience au compteur, notre ambition est de vous faire passer un moment inoubliable en petits groupes et dans la bonne ambiance."
    ],
    "es": [
      "Como guías de alta montaña y barranquismo con 23 años de experiencia, nuestro objetivo es ofrecerte una experiencia inolvidable en grupos reducidos y en un gran ambiente."
    ],
    "nl": [
      "Als hooggebergte- en canyoninggidsen met 23 jaar ervaring is het ons doel om je een onvergetelijke ervaring te geven in kleine groepen en in een geweldige sfeer."
    ]
  },
