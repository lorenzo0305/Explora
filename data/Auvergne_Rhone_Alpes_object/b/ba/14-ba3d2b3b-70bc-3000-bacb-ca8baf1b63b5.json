  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3e7e9bbd-cfd2-3e0c-8f23-647e6a3ca285",
      "dc:description": {
        "de": [
          "Breite Alleen schlängeln sich entlang der Gräben und Befestigungen der Zitadelle und durch den Wald, der auf ihrem ehemaligen Glacis gewachsen ist."
        ],
        "en": [
          "Wide avenues wind along the citadel's moats and fortifications and through the woods that have grown up on its former glacis."
        ],
        "it": [
          "Ampi viali si snodano lungo i fossati e le fortificazioni della cittadella e attraverso i boschi cresciuti sul suo antico glacis."
        ],
        "fr": [
          "De larges allées serpentent le long des douves et des fortifications de la citadelle et traversent le bois qui a poussé sur son ancien glacis."
        ],
        "nl": [
          "Brede lanen slingeren langs de grachten en vestingwerken van de citadel en door het bos dat op de voormalige glacis is gegroeid."
        ],
        "es": [
          "Amplias avenidas serpentean a lo largo de los fosos y fortificaciones de la ciudadela y a través del bosque que ha crecido en su antiguo glacis."
        ]
      },
