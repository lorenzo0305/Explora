  "rdfs:comment": {
    "de": [
      "Der Eau Rousse ist ein Wildbach mit sehr sauberem Wasser. Er und seine Nebenflüsse sind reich an Bachforellen."
    ],
    "en": [
      "The Eau Rousse is a torrent with very pure waters. Sometimes very steep, it and its tributaries are rich in fario trout."
    ],
    "it": [
      "L'Eau Rousse è un torrente con acqua molto pura. A volte molto ripidi, sono ricchi di trote fario insieme ai loro affluenti."
    ],
    "fr": [
      "L'Eau Rousse est un torrent aux eaux très pures. Parfois très encaissé, lui et ses affluents sont riches en truite fario."
    ],
    "es": [
      "El Eau Rousse es un torrente de agua muy pura. A veces muy escarpados, tanto él como sus afluentes son ricos en truchas fario."
    ],
    "nl": [
      "De Eau Rousse is een stroom met zeer zuiver water. Deze soms zeer steile rivier en haar zijrivieren zijn rijk aan fario-forel."
    ]
  },
