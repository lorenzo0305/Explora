  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1645cf26-a715-3d21-9ebc-d798c9cfe022",
      "dc:description": {
        "de": [
          "Boutique mit Prêt-à-porter-Mode für Frauen in einem atypischen Rahmen. Hier findet man Kleider, Röcke, Tuniken, Pullover, Mäntel usw. Schuhe und Accessoires.\nBefindet sich auf dem kleinen Platz in der Nähe der Kirche.\n\nGeöffnet von Dienstag bis Samstag von 9:30 bis 12:30 Uhr und von 14:30 bis 19:15 Uhr"
        ],
        "en": [
          "Women's ready-to-wear boutique, in an atypical setting, offering dresses, skirts, tunics, sweaters, coats, etc. Shoes and accessories.\nLocated on the small square near the church.\n\nOpen Tuesday to Saturday, 9.30am to 12.30pm and 2.30pm to 7.15pm"
        ],
        "it": [
          "Negozio di prêt-à-porter femminile, in un ambiente insolito, che offre abiti, gonne, tuniche, maglie, cappotti, ecc. Scarpe e accessori.\nSituato nella piazzetta vicino alla chiesa.\n\nAperto da martedì a sabato, dalle 9.30 alle 12.30 e dalle 14.30 alle 19.15"
        ],
        "fr": [
          "Boutique de prêt-à-porter féminin, dans un cadre atypique, on y trouve des robes, jupes, tuniques, pulls, manteaux etc...Chaussures et accessoires.\nSe situe sur la petite place proche de l'église.\n\nOuvert du mardi au samedi de 9h30 à 12h30 et de 14h30 à 19h15"
        ],
        "es": [
          "Tienda de prêt-à-porter femenino, en un marco insólito, que ofrece vestidos, faldas, túnicas, jerseys, abrigos, etc. Calzado y accesorios.\nSituada en la pequeña plaza cerca de la iglesia.\n\nAbierto de martes a sábado de 9.30 a 12.30 y de 14.30 a 19.15 h"
        ],
        "nl": [
          "Confectiewinkel voor dames, in een ongewone omgeving, met jurken, rokken, tunieken, truien, jassen, enz. Schoenen en accessoires.\nGelegen op het pleintje bij de kerk.\n\nGeopend van dinsdag tot zaterdag van 9.30 tot 12.30 uur en van 14.30 tot 19.15 uur"
        ]
      },
