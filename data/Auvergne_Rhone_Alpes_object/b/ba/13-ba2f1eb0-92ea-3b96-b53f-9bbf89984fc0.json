  "rdfs:comment": {
    "de": [
      "Divertimento organisiert seit 2005 \"Les Musicales en Tricastin\". Jedes Jahr werden international bekannte Künstler eingeladen, an zwei Orten aufzutreten und prestigeträchtige Werke vorzutragen, zur großen Freude der Zuschauer."
    ],
    "en": [
      "Since 2005, Divertimento has been organizing “Les Musicales en Tricastin.” Every year, internationally renowned artists are invited to perform at two venues, presenting prestigious works to the delight of audiences."
    ],
    "it": [
      "Dal 2005 Divertimento organizza \"Les Musicales en Tricastin\". Ogni anno, artisti di fama internazionale sono invitati a esibirsi in 2 sedi, presentando opere prestigiose per la gioia del pubblico."
    ],
    "fr": [
      "Divertimento organise depuis 2005 « les Musicales en Tricastin ». Chaque année, des artistes de renommée internationale sont invités à se produire dans 2 lieux en proposant des oeuvres prestigieuses, pour le plus grand bonheur des spectateurs."
    ],
    "es": [
      "Divertimento organiza \"Les Musicales en Tricastin\" desde 2005. Cada año, artistas de renombre internacional son invitados a actuar en 2 lugares, presentando obras prestigiosas para deleite del público."
    ],
    "nl": [
      "Divertimento organiseert \"Les Musicales en Tricastin\" sinds 2005. Elk jaar worden internationaal bekende artiesten uitgenodigd om op 2 locaties op te treden en prestigieuze werken te presenteren tot groot genoegen van het publiek."
    ]
  },
