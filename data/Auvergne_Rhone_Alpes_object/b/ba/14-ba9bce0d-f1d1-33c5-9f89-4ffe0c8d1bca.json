      "dc:description": {
        "de": [
          "Die Feierlichkeiten zum 14. Juli!\n\nDie Gemeinde Parenty und das Festkomitee laden Sie ein, einen Tag im City-Stadion zu verbringen."
        ],
        "en": [
          "July 14th festivities!\n\nThe Commune de Parenty and the Comité des Fêtes invite you to spend a day at the city stadium."
        ],
        "it": [
          "I festeggiamenti del 14 luglio!\n\nIl Comune di Parenty e il Comitato delle Feste vi invitano a trascorrere una giornata allo stadio della città."
        ],
        "fr": [
          "Les Festivités du 14 juillet !\n\nLa Commune de Parenty et le Comité des Fêtes vous invitent à passer une journée au city stade."
        ],
        "es": [
          "Las fiestas del 14 de julio\n\nEl Ayuntamiento de Parenty y el Comité des Fêtes le invitan a pasar un día en el estadio de la ciudad."
        ],
        "nl": [
          "De festiviteiten op 14 juli!\n\nDe gemeente Parenty en het Comité des Fêtes nodigen je uit om een dag door te brengen in het stadion van de stad."
        ]
