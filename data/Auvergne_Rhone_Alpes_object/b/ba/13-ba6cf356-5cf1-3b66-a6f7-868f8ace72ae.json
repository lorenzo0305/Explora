  "rdfs:comment": {
    "de": [
      "Die Plaine des Sports de Montélimar ist ein echter Sportort im Freien und vereint zahlreiche Sportarten mit freiem Zugang sowie Zonen zum Entspannen und Ausruhen."
    ],
    "en": [
      "A genuine outdoor sports venue, the Plaine des Sports de Montélimar offers a wide range of sports disciplines with free access, as well as relaxation and rest areas."
    ],
    "it": [
      "La Plaine des Sports de Montélimar è un vero e proprio impianto sportivo all'aperto, che offre un'ampia gamma di discipline sportive ad accesso libero, oltre a zone di relax e riposo."
    ],
    "fr": [
      "Véritable lieu sportif de plein-air, la Plaine des Sports de Montélimar regroupe de nombreuses disciplines sportives en accès libre ainsi que des zones de détente et de repos."
    ],
    "es": [
      "La Plaine des Sports de Montélimar es un auténtico recinto deportivo al aire libre, que ofrece una amplia gama de disciplinas deportivas de libre acceso, así como zonas de relajación y descanso."
    ],
    "nl": [
      "De Plaine des Sports de Montélimar is een echt sportterrein in de open lucht en biedt een breed scala aan sportdisciplines met vrije toegang, evenals ontspannings- en rustruimtes."
    ]
  },
