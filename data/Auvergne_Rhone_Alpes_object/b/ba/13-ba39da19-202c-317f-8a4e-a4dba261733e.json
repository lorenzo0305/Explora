  "rdfs:comment": {
    "de": [
      "Die Destillerie Pagès öffnet ihre Türen für eine Führung, die dem Verveine du Velay gewidmet ist: von den Feldern der Zitronenverbene über die Destillierapparate bis hin zu einer Verkostung. Tauchen Sie ein in die Geschichte und das Know-how dieses emblematischen Likörs."
    ],
    "en": [
      "Distillerie Pagès opens its doors to you for a guided tour dedicated to Verveine du Velay: from lemongrass verbena fields to stills and a tasting session. Immerse yourself in the history and expertise of this emblematic liqueur."
    ],
    "it": [
      "La Distillerie Pagès vi apre le porte per una visita guidata dedicata alla Verveine du Velay: dai campi di verbena al limone agli alambicchi, fino alla degustazione. Immergetevi nella storia e nell'esperienza di questo liquore emblematico."
    ],
    "fr": [
      "La Distillerie Pagès vous ouvre ses portes pour une visite guidée dédiée à la Verveine du Velay : du champs de verveine citronnelle aux alambics en passant par une dégustation. Plongez dans l’histoire et le savoir-faire de cette liqueur emblématique."
    ],
    "es": [
      "La Destilería Pagès le abre sus puertas para una visita guiada dedicada a la Verveine du Velay: de los campos de hierba luisa a los alambiques y una degustación. Sumérjase en la historia y el saber hacer de este licor emblemático."
    ],
    "nl": [
      "De distilleerderij Pagès opent haar deuren voor een rondleiding gewijd aan Verveine du Velay: van de citroenverbena velden tot de distilleerkolven en een proeverij. Laat u onderdompelen in de geschiedenis en de knowhow van deze emblematische likeur."
    ]
  },
