  "rdfs:comment": {
    "de": [
      "Das Museum LA FABRIQUE befindet sich in einer ehemaligen Schalwerkstatt und wurde von einem Team aus ehemaligen Posamentierern und Kunststoffherstellern eingerichtet und betrieben."
    ],
    "en": [
      "This museum provides a wonderful insight into the history of the textiles industry in Marches du Velay.\r\nCome visit The Mill museum and discover over 400 years’ worth of some of the finest weaving carried out by some of the finest experts."
    ],
    "it": [
      "Ospitato in un ex laboratorio di sciarpe, il museo LA FABRIQUE è stato creato e gestito da un team di ex tagliatori e produttori di materie plastiche."
    ],
    "fr": [
      "Installé dans un ancien atelier de fabrication d’écharpes, le musée LA FABRIQUE a été réalisé et animé par une équipe d’anciens passementiers et plasturgistes."
    ],
    "es": [
      "Ubicado en un antiguo taller de fabricación de pañuelos, el museo LA FABRIQUE fue creado y dirigido por un equipo de antiguos recortadores y fabricantes de plásticos."
    ],
    "nl": [
      "Het museum LA FABRIQUE is gevestigd in een voormalig atelier waar sjaals werden gemaakt. Het is opgezet en wordt gerund door een team van voormalige trimmers en plasticfabrikanten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Textiles museum"
    ],
    "fr": [
      "Musée la Fabrique"
    ]
  },
