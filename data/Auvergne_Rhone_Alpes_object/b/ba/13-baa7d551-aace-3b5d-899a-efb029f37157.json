  "rdfs:comment": {
    "de": [
      "Tagsüber können Sie am Wasser oder im Zelt frische Salate, handgemachtes Eis sowie süße und herzhafte Crêpes genießen."
    ],
    "en": [
      "Enjoy fresh salads, homemade ice creams and sweet and savoury crêpes by the water or under the tent."
    ],
    "it": [
      "Durante il giorno, potrete gustare insalate fresche, gelati fatti in casa e crêpes dolci e salate in riva al mare o sotto una tenda."
    ],
    "fr": [
      "En journée, au bord de l'eau ou sous la tente, dégustez salades fraîcheur, glaces artisanales et crêpes salées et sucrées."
    ],
    "nl": [
      "Geniet overdag van verse salades, zelfgemaakt ijs en zoete en hartige crêpes aan het water of onder een tent."
    ],
    "es": [
      "Durante el día, disfrute de ensaladas frescas, helados caseros y crepes dulces y salados junto al agua o bajo una carpa."
    ]
  },
