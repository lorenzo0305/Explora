  "rdfs:comment": {
    "de": [
      "Angelstrecke der 1. Kategorie am Fluss Borne, die von der AAPPMA de Faucigny verwaltet wird. Technischer Bereich für erfahrene Angler, bekannt für Bachforelle, Regenbogenforelle und Groppe."
    ],
    "en": [
      "1st category fishing course on the Borne, managed by the Faucigny AAPPMA. Technical sector for experienced anglers, renowned for its fario trout, rainbow trout and sculpin."
    ],
    "it": [
      "Corso di pesca di 1ª categoria sul Borne, gestito dall'AAPPMA di Faucigny. Una zona tecnica per pescatori esperti, rinomata per le trote fario, le trote iridee e gli sculpi."
    ],
    "fr": [
      "Parcours de pêche de 1re catégorie sur le Borne, géré par l’AAPPMA de Faucigny. Secteur technique destiné aux pêcheurs confirmés, réputé pour la truite fario, la truite arc-en-ciel et le chabot."
    ],
    "nl": [
      "Viscursus 1e categorie op de Borne, beheerd door de AAPPMA Faucigny. Een technisch gebied voor ervaren vissers, bekend om zijn fario-forel, regenboogforel en zeedonderpad."
    ],
    "es": [
      "Curso de pesca de 1ª categoría en el Borne, gestionado por la AAPPMA de Faucigny. Una zona técnica para pescadores experimentados, famosa por sus truchas fario, truchas arco iris y escórporas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Parcours pêche \"Le Borne en aval des étroits\""
    ]
  },
