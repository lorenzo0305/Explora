  "rdfs:comment": {
    "de": [
      "Das Restaurant Casa Bianco bietet eine Geschmacksreise ins Herz der Region in einer geschützten Umgebung."
    ],
    "en": [
      "The Casa Bianco restaurant offers a gustatory journey to the heart of the terroir, in an unspoilt setting."
    ],
    "it": [
      "Il ristorante Casa Bianco vi porta in un viaggio gustoso nel cuore della regione, in un ambiente incontaminato."
    ],
    "fr": [
      "Le restaurant Casa Bianco propose un voyage gustatif au cœur du terroir dans un cadre préservé."
    ],
    "nl": [
      "Het restaurant Casa Bianco neemt je mee op een smakelijke reis naar het hart van de regio in een ongerepte omgeving."
    ],
