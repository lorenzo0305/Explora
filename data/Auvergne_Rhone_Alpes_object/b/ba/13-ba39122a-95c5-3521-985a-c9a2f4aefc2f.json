  "rdfs:comment": {
    "de": [
      "Le Complexe ist der gesellige Ort, an dem man sich mit der Familie oder mit Freunden treffen kann. Entfliehen Sie dem Alltag in einem der beiden Säle des Theatercafés auf den Pentes de la Croix-Rousse, das der Komödie gewidmet ist!"
    ],
    "en": [
      "The Complexe is a friendly place to meet with family or friends. Escape from daylife in one of the two rooms of this \"café-théâtre\" of the Croix-Rousse slopes, devoted to comedy!"
    ],
    "it": [
      "Le Complexe è il luogo ideale per stare con la famiglia e gli amici. Fuggite dalla vita quotidiana in una delle due sale del caffè-teatro alle pendici della Croix-Rousse, dedicate alla commedia!"
    ],
    "fr": [
      "Le Complexe, c'est l'endroit convivial où se retrouver en famille ou entre amis. Échappez vous de la vie quotidienne dans l'une des deux salles du café-théâtre des pentes de la Croix-Rousse, dédié à la comédie !"
    ],
    "nl": [
      "Le Complexe is een gezellige plek om familie en vrienden te ontmoeten. Ontsnap aan het dagelijkse leven in een van de twee zalen van het café-theater op de hellingen van de Croix-Rousse, gewijd aan komedie!"
    ],
    "es": [
      "Le Complexe es el lugar para estar con la familia y los amigos. Escápese de la vida cotidiana en una de las dos salas del café-teatro de las laderas de la Croix-Rousse, dedicada a la comedia"
    ]
  },
