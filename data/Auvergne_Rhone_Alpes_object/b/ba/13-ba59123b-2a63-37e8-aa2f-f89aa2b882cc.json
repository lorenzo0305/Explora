  "rdfs:comment": {
    "de": [
      "Der Lesepunkt von Velanne bietet Ihnen in den Räumen des Rathauses Sprechstunden an. Vor Ort können Sie sich in das Netzwerk der Bibliotheken des Pays en Voironnais einschreiben, Ihre Bücher zurückgeben oder abholen..."
    ],
    "en": [
      "Velanne's \"Point Lecture\" (reading point) is open all day, in the town hall. On site, you can register with the Pays en Voironnais library network, return or collect your books..."
    ],
    "it": [
      "Il centro di lettura di Velanne è aperto tutto il giorno, nel municipio. Qui è possibile iscriversi alla rete di biblioteche del Voironnais, restituire i libri o ritirarli."
    ],
    "fr": [
      "Le point lecture de Velanne vous propose des permanences,  dans les locaux de la mairie. Sur place, vous pouvez vous inscrire au réseau des Bibliothèques du Pays en Voironnais, rendre ou retirer vos livres.."
    ],
    "nl": [
      "Het leescentrum van Velanne is de hele dag geopend, in het gemeentehuis. Hier kun je je inschrijven bij het Voironnais netwerk van bibliotheken, boeken inleveren of ophalen."
    ],
    "es": [
      "El centro de lectura de Velanne está abierto todo el día, en el ayuntamiento. Aquí puede inscribirse en la red de bibliotecas de Voironnais, devolver libros o recogerlos."
    ]
  },
  "rdfs:label": {
