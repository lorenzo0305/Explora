  "rdfs:comment": {
    "de": [
      "Das Hôtel La Vanoise 1825*** im Ortskern liegt in unmittelbarer Nähe zur Drahtseilbahn nach Méribel im Herzen des Skigebiets Les Trois Vallées, zum Grand Spa Thermal und zum Kurzentrum."
    ],
    "ru": [
      "3-звездочный отель La Vanoise 1825 расположился в центре деревни и находится в непосредственной близости от гондольного подъемника до станции «Мерибель» — самого центра курорта «Три долины», спа-комплекса Grand Spa Thermal и термального центра."
    ],
    "en": [
      "Located in the village centre, the 3*** Hôtel La Vanoise 1825** is right next to the gondola lift that goes up to Méribel, at the heart of Les 3 Vallées, as well as the Grand Spa Thermal and thermal spa centre."
    ],
    "it": [
      "L'Hotel La Vanoise 1825***, nel centro del villaggio, si trova nelle immediate vicinanze della funivia che porta a Méribel, il cuore delle Tre Valli, la Grand Spa Thermal e il centro termale."
    ],
    "fr": [
      "L’Hôtel La Vanoise 1825***, au centre du Village, est à proximité immédiate de la télécabine menant à Méribel, cœur des Trois Vallées, du Grand Spa Thermal et du centre thermal."
    ],
    "nl": [
      "Hotel La Vanoise 1825***, in het centrum van het dorp, ligt in de onmiddellijke nabijheid van de kabelbaan naar Méribel, het hart van de Trois Vallées, de Grand Spa Thermal en het thermale centrum."
    ],
    "es": [
      "El Hotel La Vanoise 1825***, situado en el centro de la Villa, se encuentra en las inmediaciones del teleférico que lleva a Méribel, el corazón de los Tres Valles, el Grand Spa Thermal y el centro termal."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Vanoise Hotel"
    ],
