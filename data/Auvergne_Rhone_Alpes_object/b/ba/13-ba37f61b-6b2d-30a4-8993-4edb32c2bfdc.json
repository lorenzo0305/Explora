  "rdfs:comment": {
    "de": [
      "Ort für künstlerisches Schaffen. \r\nKreative Residenzen mit Zugang zu Aufnahmestudios, Toningenieur und Zimmern können gemietet werden.\r\nBar Café Konzerte"
    ],
    "en": [
      "Place of artistic creation. \r\nCreative residencies with access to recording studios, sound engineer, rooms, are available for rent.\r\nBar-café concerts"
    ],
    "it": [
      "Un luogo di creazione artistica. \r\nSono disponibili residenze creative con accesso a studi di registrazione, ingegneri del suono, stanze in affitto.\r\nBar caffè concerti"
    ],
    "fr": [
      "Lieu de création artistique. \r\nLes résidences de création avec l'accès aux studios d'enregistrement, à l'ingénieur du son, aux chambres, sont disponibles à la location.\r\nBar café concerts"
    ],
    "es": [
      "Un lugar para la creación artística. \r\nSe alquilan residencias creativas con acceso a estudios de grabación, ingeniero de sonido y salas.\r\nConciertos en el bar-cafetería"
    ],
    "nl": [
      "Een plek voor artistieke creatie.\r\nCreatieve residenties met toegang tot opnamestudio's, geluidstechnicus en slaapkamers zijn te huur.\r\nBar café concerten"
    ]
