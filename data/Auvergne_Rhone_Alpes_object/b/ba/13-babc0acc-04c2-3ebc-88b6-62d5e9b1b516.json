  "rdfs:comment": {
    "de": [
      "Der erste Eindruck, wenn man den kleinen Friedhof der Kirche Sainte-Marie betritt, ist Überraschung... Der Kirchturm von Sainte-Marie ist schief wie der Turm von Pisa!"
    ],
    "en": [
      "It’s quite a surprise when you enter the small cemetery of Sainte-Marie Church... the bell tower leans just like the Tower of Pisa!"
    ],
    "it": [
      "La prima impressione quando si entra nel piccolo cimitero della chiesa di St. Mary è di sorpresa... Il campanile di St. Mary è pendente come la torre di Pisa!"
    ],
    "fr": [
      "La première impression quand on pénètre dans le petit cimetière de l'église Sainte-Marie est la surprise... Le clocher de Sainte-Marie est penché comme la tour de Pise !"
    ],
    "es": [
      "La primera impresión al entrar en el pequeño cementerio de Sainte-Marie es de sorpresa... El campanario de Sainte-Marie se inclina como la Torre de Pisa."
    ],
    "nl": [
      "De eerste indruk als je het kleine kerkhof van de St. Mary's kerk betreedt is er een van verbazing... De klokkentoren van St. Mary's leunt als de toren van Pisa!"
    ]
  },
