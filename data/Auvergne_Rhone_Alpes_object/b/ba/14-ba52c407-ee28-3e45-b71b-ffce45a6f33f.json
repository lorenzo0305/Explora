  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/99182b45-bddb-320b-b075-9383f62fd9c9",
      "dc:description": {
        "de": [
          "Erdbeeren aus Freilandanbau, Konfitüren, Erdbeerapfelsaft, Eier vom Bauernhof.\nProdukte direkt über den Drive Fermier oder den Vertriebspartner von Les Fraises de la Vallée de la Course in Inxent erhältlich."
        ],
        "en": [
          "Free-range strawberries, jams, strawberry apple juice, farm eggs.\nProducts available directly from Drive Fermier or from the Fraises de la Vallée de la Course distributor in Inxent."
        ],
        "it": [
          "Fragole ruspanti, marmellate, succo di mela alla fragola, uova di fattoria.\nProdotti disponibili direttamente presso il Drive Fermier o presso il distributore Fraises de la Vallée de la Course di Inxent."
        ],
        "fr": [
          "Fraises de pleine terre, confitures, jus de pomme fraise, œufs fermiers.\nProduits disponibles directement via le Drive Fermier ou le distributeur des Fraises de la Vallée de la Course à Inxent."
        ],
        "nl": [
          "Scharrelaardbeien, jam, aardbeien-appelsap, eieren van de boerderij.\nProducten direct verkrijgbaar bij de Drive Fermier of bij de Fraises de la Vallée de la Course distributeur in Inxent."
        ],
        "es": [
          "Fresas de granja, mermeladas, zumo de fresa y manzana, huevos de granja.\nProductos disponibles directamente en el Drive Fermier o en el distribuidor de Fraises de la Vallée de la Course en Inxent."
        ]
      },
