  "rdfs:comment": {
    "de": [
      "Die städtische Mediathek ist für alle zugänglich. Sie bietet Ihnen einen vielfältigen Bestand für alle Altersgruppen: Romane, Krimis, Science-Fiction, Dokumentarfilme, Comics, Mangas und Zeitschriften. Nicht zu vergessen sind DVDs, CDs und Gesellschaftsspiele."
    ],
    "en": [
      "The municipal media library is open to all. It offers a wide range of books for all ages: novels, detective stories, science fiction, documentaries, comics, manga and magazines. Not forgetting DVDs, CDs and board games."
    ],
    "it": [
      "La biblioteca multimediale comunale è aperta a tutti. Offre una vasta gamma di libri per tutte le età: romanzi, gialli, fantascienza, documentari, fumetti, manga e riviste. Senza dimenticare DVD, CD e giochi da tavolo."
    ],
    "fr": [
      "La médiathèque municipale est accessible à tous. Elle vous propose des fonds variés pour tous les âges : romans, policiers, science-fiction, documentaires, bandes dessinées, mangas et revues. Sans oublier des DVDs, des CDs et des jeux de sociétés."
    ],
    "es": [
      "La biblioteca multimedia municipal está abierta a todos. Ofrece una amplia gama de libros para todas las edades: novelas, novelas policíacas, ciencia ficción, documentales, cómics, manga y revistas. Sin olvidar DVD, CD y juegos de mesa."
    ],
    "nl": [
      "De gemeentelijke mediatheek is voor iedereen toegankelijk. Er is een ruim aanbod aan boeken voor alle leeftijden: romans, detectiveverhalen, sciencefiction, documentaires, stripverhalen, manga en tijdschriften. En niet te vergeten dvd's, cd's en bordspellen."
    ]
  },
