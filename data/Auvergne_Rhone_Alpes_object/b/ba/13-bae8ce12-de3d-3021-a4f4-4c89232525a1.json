  "rdfs:comment": {
    "de": [
      "Unsere Diskothek öffnet seit 18 Jahren ihre Türen für Sie, damit Sie außergewöhnliche Abende genießen können. Für einen After-Work-Abend mit Freunden stellen wir Ihnen eine große Auswahl an Softdrinks und alkoholischen Getränken zur Verfügung."
    ],
    "en": [
      "Our discotheque has been opening its doors to you for 18 years, so you can enjoy exceptional evenings. For an after-work drink with friends, we offer a wide choice of soft and alcoholic beverages."
    ],
    "it": [
      "La nostra discoteca vi apre le porte da 18 anni e vi permette di trascorrere serate eccezionali. Per un drink dopo il lavoro con gli amici, offriamo un'ampia scelta di bevande analcoliche e alcoliche."
    ],
    "fr": [
      "Notre discothèque vous ouvre ses portes depuis 18 ans pour vous faire profiter de soirées exceptionnelles. Pour un after work entre amis, nous mettons à votre disposition un large choix de boissons softs ou alcoolisées."
    ],
    "nl": [
      "Onze discotheek opent al 18 jaar haar deuren voor jou, zodat je kunt genieten van uitzonderlijke avonden. Voor een drankje met vrienden na het werk bieden we een ruime keuze aan frisdranken en alcoholische dranken."
    ],
    "es": [
      "Nuestra discoteca lleva 18 años abriéndote sus puertas para que disfrutes de unas veladas excepcionales. Para tomar una copa después del trabajo con los amigos, te ofrecemos una amplia selección de bebidas sin alcohol y alcohólicas."
    ]
  },
