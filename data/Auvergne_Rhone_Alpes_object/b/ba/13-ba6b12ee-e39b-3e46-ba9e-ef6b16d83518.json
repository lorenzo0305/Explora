  "rdfs:comment": {
    "de": [
      "The Craic ist das Gourmet-Refugium des Hotels. Genießen Sie die gesunde Gourmetküche unseres Küchenchefs, der die Produkte der Region in den Vordergrund stellt. Inspiriert von seinen zahlreichen Reisen, interpretiert er die lokalen Rezepte mit viel Talent neu."
    ],
    "en": [
      "The Craic is the hotel's Gourmet Refuge. Savour the healthy, gourmet cuisine of our Chef, who gives pride of place to local produce. Inspired by his many travels, he revisits local recipes with talent."
    ],
    "it": [
      "Il Craic è il Refuge Gourmand dell'hotel. Assaporate la cucina sana e gourmet del nostro chef, che privilegia i prodotti locali. Ispirato dai suoi numerosi viaggi, rivisita con talento le ricette locali."
    ],
    "fr": [
      "The Craic, c’est le Refuge Gourmand de l’hôtel. Dégustez la cuisine gourmande et saine de notre Chef qui met à l’honneur les produits de la région. Inspiré par ses nombreux voyages, il revisite avec talent les recettes locales."
    ],
    "nl": [
      "The Craic is de Refuge Gourmand van het hotel. Geniet van de gezonde, gastronomische keuken van onze chef-kok, die de voorkeur geeft aan lokale producten. Geïnspireerd door zijn vele reizen, herziet hij lokale recepten met talent."
    ],
    "es": [
      "El Craic es el refugio gastronómico del hotel. Saboree la cocina sana y gastronómica de nuestro Chef, que da prioridad a los productos locales. Inspirado por sus numerosos viajes, revisita las recetas locales con talento."
    ]
  },
