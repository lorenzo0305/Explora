  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/837b210b-6aaf-33fb-91ab-883cba9ad9b7",
      "dc:description": {
        "de": [
          "Vicomte Arthur Franchise\nKleidung für Männer, Frauen und Kinder\n\nGeöffnet von Montag bis Samstag außer Dienstag und Mittwoch von 10:00 bis 13:00 Uhr und von 14:00 bis 19:00 Uhr.\nSonntags von 10:00 bis 13:00 Uhr und von 14:0 bis 18:00 Uhr"
        ],
        "en": [
          "Franchise Vicomte Arthur\nClothing for men, women and children\n\nOpen Monday to Saturday except Tuesday and Wednesday, 10am to 1pm and 2pm to 7pm.\nSundays from 10am to 1pm and from 2pm to 6pm"
        ],
        "it": [
          "Franchising Vicomte Arthur\nAbbigliamento uomo, donna e bambino\n\nAperto dal lunedì al sabato, tranne martedì e mercoledì, dalle 10.00 alle 13.00 e dalle 14.00 alle 19.00.\nDomenica dalle 10.00 alle 13.00 e dalle 14.00 alle 18.00"
        ],
        "fr": [
          "Franchise Vicomte Arthur\nVêtements homme, femme, enfant\n\nOuvert du lundi au samedi sauf mardi et mercredi de 10h à 13h et de 14h à 19h.\nLe dimanche de 10h à 13h et de 14h0 à 18h"
        ],
        "es": [
          "Franquicia Vicomte Arthur\nRopa para hombre, mujer y niño\n\nAbierto de lunes a sábado, excepto martes y miércoles, de 10.00 a 13.00 h. y de 14.00 a 19.00 h.\nDomingos de 10.00 a 13.00 h. y de 14.00 a 18.00 h"
        ],
        "nl": [
          "Franchise Vicomte Arthur\nHeren-, dames- en kinderkleding\n\nGeopend van maandag t/m zaterdag behalve dinsdag en woensdag van 10.00 tot 13.00 en van 14.00 tot 19.00.\nZondag van 10.00 tot 13.00 en van 14.00 tot 18.00"
        ]
      },
