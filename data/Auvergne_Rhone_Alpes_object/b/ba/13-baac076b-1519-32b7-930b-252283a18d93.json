  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Tür zu dem hübschen Raum, der wie ein Feinkostladen aussieht, und lassen Sie sich an einem kleinen Holztisch nieder, der von der Zeit Patina angesetzt hat."
    ],
    "en": [
      "Push open the doors of the pretty room, which looks like a delicatessen, and take a seat on a small wooden table with a patina of age."
    ],
    "it": [
      "Apriamo le porte della graziosa stanza, che sembra una salumeria, e ci sediamo a un tavolino di legno con una patina d'età."
    ],
    "fr": [
      "Poussez les portes de la jolie salle aux allures d’épicerie fine, installez vous sur une petite table en bois patiné par le temps."
    ],
    "es": [
      "Empuja las puertas de la bonita sala, que parece una charcutería, y siéntate en una pequeña mesa de madera con pátina de antigüedad."
    ],
    "nl": [
      "Duw de deuren van de mooie kamer, die eruitziet als een delicatessenwinkel, open en neem plaats aan een kleine houten tafel met een patina van ouderdom."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel Bristol & la Table de Felix"
    ]
  },
