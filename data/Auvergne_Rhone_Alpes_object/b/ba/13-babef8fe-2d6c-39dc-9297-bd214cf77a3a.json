  "rdfs:comment": {
    "de": [
      "Die Crémerie du Mont Blanc bietet eine hochwertige Auswahl an Beaufort, Savoie-Käse, Fleisch aus dem Beaufortain, Wurstwaren, Weinen und Feinkost. Profitieren Sie von personalisierten Dienstleistungen: Käse-/Wurstplatten und Präsentkörbe."
    ],
    "en": [
      "Crémerie du Mont Blanc offers a quality selection of Beaufort, Savoy cheeses, Beaufortain meats, charcuterie, wines and delicatessen. Take advantage of our personalized services: cheese and charcuterie platters and full baskets."
    ],
    "it": [
      "La Crémerie du Mont Blanc offre una selezione di qualità di formaggi Beaufort, Savoia, carni Beaufortain, salumi, vini e specialità gastronomiche. Approfittate dei nostri servizi personalizzati: vassoi di formaggi e salumi e cestini pieni di leccornie."
    ],
    "fr": [
      "La Crémerie du Mont Blanc propose une sélection de qualité avec Beaufort, fromages de Savoie, viande du Beaufortain, charcuterie, vins, et épicerie fine. Profitez de services personnalisés : plateaux de fromages/charcuteries et paniers garnis."
    ],
    "es": [
      "La Crémerie du Mont Blanc le ofrece una selección de calidad de quesos de Beaufort, Saboya, carnes de Beaufortain, charcutería, vinos y delicatessen. Disfrute de nuestros servicios personalizados: tablas de quesos y embutidos y cestas llenas de golosinas."
    ],
    "nl": [
      "De Crémerie du Mont Blanc biedt een kwaliteitsselectie van kazen uit Beaufort, Savoie, vleeswaren uit Beaufortain, charcuterie, wijnen en delicatessen. Profiteer van onze gepersonaliseerde diensten: kaas- en vleeswarenplateaus en manden vol lekkernijen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Crèmerie du Mont-Blanc"
    ]
  },
