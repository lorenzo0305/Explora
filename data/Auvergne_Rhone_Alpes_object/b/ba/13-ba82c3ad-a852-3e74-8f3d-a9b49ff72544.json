  "rdfs:comment": {
    "de": [
      "Die Guinguette du Loup Blanc empfängt Sie von Mitte April bis Mitte Oktober! Auf dem Programm stehen Marktkonzerte, kulturelle Veranstaltungen und lokale Biere und Produkte, die Sie vor Ort trinken oder mitnehmen können"
    ],
    "en": [
      "La Guinguette du Loup Blanc welcomes you from mid-April to mid-October! On the program: concert markets, cultural events and local beers and products to eat in or take away!"
    ],
    "it": [
      "La Guinguette du Loup Blanc vi accoglie da metà aprile a metà ottobre! In programma: mercati di concerti, eventi culturali, birre e prodotti locali da mangiare o da portare via!"
    ],
    "fr": [
      "La Guinguette du Loup Blanc vous accueille de Mi Avril à Mi Octobre ! Au Programme: des marchés concerts, des évènements culturels et des bières et produits locaux à consommer sur place ou à emporter!"
    ],
    "nl": [
      "La Guinguette du Loup Blanc verwelkomt je van half april tot half oktober! Op het programma: concertmarkten, culturele evenementen en bieren en streekproducten om te eten of mee te nemen!"
    ],
    "es": [
      "La Guinguette du Loup Blanc le da la bienvenida de mediados de abril a mediados de octubre En el programa: mercados de conciertos, eventos culturales y cervezas y productos locales para comer o llevar"
    ]
  },
