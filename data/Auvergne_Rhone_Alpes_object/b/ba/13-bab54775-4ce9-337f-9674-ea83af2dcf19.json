  "rdfs:comment": {
    "de": [
      "Das ganze Jahr über bietet Ihnen Rando Quad Ardèche Quad-Touren in der Ardèche an. Begleitete Wanderungen mit Führer ab Joyeuse, um die Ardèche auf den Pfaden zu entdecken."
    ],
    "en": [
      "All year round, Rando Quad Ardèche offers you Quad rides in Ardèche. Accompanied rides with guide from Joyeuse to discover the Ardeche by the trails."
    ],
    "it": [
      "Tutto l'anno, il Rando Quad Ardèche propone escursioni in quad nell'Ardèche. Escursioni accompagnate da una guida di Joyeuse per scoprire l'Ardèche attraverso i sentieri."
    ],
    "fr": [
      "Toute l'année, Rando Quad Ardèche vous propose des randonnées Quad en Ardèche. Randonnées accompagnées avec guide au départ de Joyeuse pour découvrir l'Ardèche par les sentiers."
    ],
    "nl": [
      "Rando Quad Ardèche biedt het hele jaar door quadrijden in de Ardèche aan. Begeleide ritten met een gids van Joyeuse om de Ardèche via de paden te ontdekken."
    ],
    "es": [
      "Durante todo el año, Rando Quad Ardèche ofrece paseos en quad por el Ardèche. Paseos acompañados con un guía de Joyeuse para descubrir la Ardèche por los senderos."
    ]
  },
  "rdfs:label": {
