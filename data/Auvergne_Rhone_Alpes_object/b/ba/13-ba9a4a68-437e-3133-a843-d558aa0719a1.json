  "rdfs:comment": {
    "de": [
      "Hausgemachte Backwaren und Viennoiseries, salzige Kuchen, Brunchformel, Mittags- und Abendverpflegung und Getränke können Sie vor Ort genießen oder mitnehmen!\r\nIm Sommer: hausgemachtes, handwerklich hergestelltes Eis!"
    ],
    "en": [
      "Homemade pastries and viennoiseries, savoury tarts, brunch, lunch and dinner, and drinks are available to eat in or take away!\r\nIn summer: homemade ice creams!"
    ],
    "it": [
      "Pasticceria e viennoiseries fatte in casa, torte salate, brunch, pranzi e cene e bevande sono disponibili per il consumo o l'asporto!\r\nIn estate: gelati fatti in casa!"
    ],
    "fr": [
      "Pâtisseries et viennoiseries maison, tartes salées, formule brunch, restauration midi et soir, et boissons sont à déguster sur place ou à emporter !\r\nL'été : glaces artisanales faites maison !"
    ],
    "es": [
      "Pastelería y viennoiseries caseras, tartas saladas, brunch, almuerzos y cenas, y bebidas para comer o llevar\r\nEn verano: ¡helados caseros!"
    ],
    "nl": [
      "Huisgemaakt gebak en viennoiseries, hartige taartjes, brunch, lunch en diner, en drankjes zijn allemaal verkrijgbaar om te eten of mee te nemen!\r\nIn de zomer: huisgemaakt ijs!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Frenchy Délices"
    ]
  },
