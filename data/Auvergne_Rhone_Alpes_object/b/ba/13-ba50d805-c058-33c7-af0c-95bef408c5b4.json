  "rdfs:comment": {
    "de": [
      "Produktion und Direktverkauf von Bio-Bauernprodukten nach Jahreszeiten. Gemüse, frische oder trockene Kräuter von Papé. Und vor Ort waren es die Geschenke.fr, Vision und Bestellung."
    ],
    "en": [
      "Organic seasonal vegetables and aromatic plants. Farmer's market every third Thursday of the month from 6pm. Stall at the market in Marsanne on Friday mornings."
    ],
    "it": [
      "Produzione e vendita diretta di prodotti agricoli biologici secondo la stagione. Verdure, erbe fresche o essiccate del papé."
    ],
    "fr": [
      "Production et Vente directe de produits fermiers bio en fonction des saisons. Légumes, herbes aromatiques fraiches ou sèches du papé."
    ],
    "nl": [
      "Seizoensgroente en aromatische planten door biologische landbouw. Markt van producenten op de derde donderdag van de maand, vanaf 18.00 u. Op vrijdagochtend aanwezig op de markt in Marsanne."
    ],
    "es": [
      "Producción y venta directa de productos agrícolas ecológicos según temporada. Verduras, hierbas frescas o secas del papé."
    ]
  },
