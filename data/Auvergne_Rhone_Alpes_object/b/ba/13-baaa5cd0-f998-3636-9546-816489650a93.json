  "rdfs:comment": {
    "de": [
      "Als Ausbilder für Pizzaïolos an der Pizza-Akademie in Lyon bietet Olivier Aucelli Ihnen über 50 verschiedene Sorten knuspriger und weicher Pizzen mit italienischen Qualitätsprodukten an."
    ],
    "en": [
      "Olivier Aucelli is a trainer for Pizzaïolos at the Pizza Academy of Lyon. He offers you more than 50 varieties of crispy and soft pizzas with quality Italian products."
    ],
    "it": [
      "Formatore di Pizzaïolos presso l'Accademia della Pizza di Lione, Olivier Aucelli vi propone più di 50 varietà di pizze croccanti e morbide con prodotti italiani di qualità."
    ],
    "fr": [
      "Formateur pour Pizzaïolos au sein de l'Académie de Pizza de Lyon, Olivier Aucelli vous propose plus de 50 variétés de pizzas croustillantes et moelleuses avec des produits italiens de qualité."
    ],
    "nl": [
      "Trainer van Pizzaïolos aan de Pizza Academy van Lyon, Olivier Aucelli biedt u meer dan 50 soorten krokante en zachte pizza's met Italiaanse kwaliteitsproducten."
    ],
    "es": [
      "Formador de Pizzaïolos en la Academia de la Pizza de Lyon, Olivier Aucelli le ofrece más de 50 variedades de pizzas crujientes y blandas con productos italianos de calidad."
    ]
  },
