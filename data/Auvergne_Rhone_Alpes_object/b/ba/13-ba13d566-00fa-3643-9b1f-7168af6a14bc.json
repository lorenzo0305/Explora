  "rdfs:comment": {
    "de": [
      "5-Sterne-Hotel mit 19 Zimmern von 25 bis 60 m2, die bis zu 57 Personen beherbergen können. L'Armancette bietet einen herrlichen Blick auf die Dômes de Miage. Die beiden Restaurants, die Bar, das Spa und der Teesalon & Bäckerei sind für alle geöffnet."
    ],
    "en": [
      "5-star hotel with 19 rooms ranging from 25 to 60 m2, accommodating up to 57 guests. L'Armancette offers a splendid view of the Dômes de Miage. The two restaurants, bar, Spa and Tearoom & Bakery are open to all."
    ],
    "it": [
      "Le nostre camere/suite da 25m² a 60m² accolgono fino a 6 persone. Kids club, Spa con piscina e sala fitness. Sale per seminari, due ristoranti, terrazza, sala da tè, bar a vino."
    ],
    "fr": [
      "Hôtel 5 étoiles de 19 chambres de 25 à 60 m2, pouvant accueillir jusqu'à 57 personnes. L’Armancette offre une vue splendide sur les Dômes de Miage. Les deux restaurants, le bar, le spa et le salon de thé & boulangerie sont ouverts à tous."
    ],
    "es": [
      "Hotel de 5 estrellas con 19 habitaciones de 25 a 60 m2, con capacidad para 57 personas. L'Armancette ofrece una espléndida vista de los Dômes de Miage. Los dos restaurantes, el bar, el spa y el salón de té y panadería están abiertos a todos."
    ],
    "nl": [
      "5-sterrenhotel met 19 kamers, variërend in grootte van 25 tot 60 m2, voor maximaal 57 gasten. L'Armancette biedt een prachtig uitzicht op de Dômes de Miage. De twee restaurants, bar, spa en tearoom & bakkerij zijn voor iedereen toegankelijk."
    ]
  },
