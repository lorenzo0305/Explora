  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/06c63d0b-6fa9-329f-83ca-1494248b7c03",
      "dc:description": {
        "de": [
          "Treffen Sie sich am Strand von Boulogne-sur-Mer zu einem geselligen Beachhandballturnier\nvon 10 Uhr bis 18.30 Uhr!\nOrganisiert wird das Turnier von der Association Boulonnaise de Handball, und es gibt vor Ort Essen und Trinken bei Live-Musik."
        ],
        "en": [
          "Rendezvous at Boulogne-sur-Mer beach for a friendly beach handball tournament\nfrom 10 a.m. to 6.30 p.m.!\nOrganized by the Association Boulonnaise de Handball, you'll find on-site catering and live music."
        ],
        "it": [
          "Unitevi a noi sulla spiaggia di Boulogne-sur-Mer per un torneo amichevole di beach handball\ndalle 10.00 alle 18.30!\nOrganizzato dall'Association Boulonnaise de Handball, vi attendono catering in loco e musica dal vivo."
        ],
        "fr": [
          "Rendez-vous à la plage de Boulogne-sur-Mer pour un tournoi de beach handball convivial\nde 10h à 18h30 !\nOrganisé par l'Association Boulonnaise de Handball, vous y retrouverez de la restauration sur place avec de la musique."
        ],
        "es": [
          "Participe en un torneo amistoso de balonmano playa en la playa de Boulogne-sur-Mer\nde 10.00 a 18.30 h\nOrganizado por la Association Boulonnaise de Handball, contará con servicio de catering y música en directo."
        ],
        "nl": [
          "Kom naar het strand van Boulogne-sur-Mer voor een vriendschappelijk beachhandbaltoernooi\nvan 10.00 tot 18.30 uur!\nGeorganiseerd door de Association Boulonnaise de Handball, met catering en livemuziek."
        ]
      },
