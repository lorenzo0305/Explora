  "rdfs:comment": {
    "de": [
      "Im Herzen des Rhônetals liegt die Domaine Dumien Serrette in der Gemeinde Cornas in der Ardèche. In der keltischen Sprache bedeutet Cornas \"verbrannte Erde\"."
    ],
    "en": [
      "In the heart of the Rhône Valley, the Domaine Dumien Serrette is located in the commune of Cornas in the Ardèche.\r\nIn Celtic, Cornas means \"Terres brûlées\"."
    ],
    "it": [
      "Nel cuore della Valle del Rodano, il Domaine Dumien Serrette si trova nel comune di Cornas, nell'Ardèche. In celtico, Cornas significa \"terra bruciata\"."
    ],
    "fr": [
      "Au cœur de la vallée du Rhône, le Domaine Dumien Serrette est situé sur la commune de Cornas en Ardèche. En Celte, Cornas, signifie « Terres brûlées »."
    ],
    "nl": [
      "In het hart van de Rhône-vallei ligt Domaine Dumien Serrette in de gemeente Cornas in de Ardèche. In het Keltisch betekent Cornas \"verbrand land\"."
    ],
    "es": [
      "En el corazón del Valle del Ródano, el Domaine Dumien Serrette se encuentra en la comuna de Cornas, en la Ardèche. En celta, Cornas significa \"tierra quemada\"."
    ]
  },
