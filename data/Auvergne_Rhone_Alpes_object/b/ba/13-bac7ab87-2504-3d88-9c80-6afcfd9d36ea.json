  "rdfs:comment": {
    "de": [
      "Mitten im Herzen des Haut Forez, erleben Sie ein tolles Abenteuer in den Bäumen. Im Park können Sie akrobatische Aktivitäten wie Seilrutschen, Sprungnetze, Trampoline, Tarzanlianen...in einer warmen, familiären und sicheren Umgebung entdecken."
    ],
    "en": [
      "\"Try a fabulous treetop adventure in the heart of the Haut Forez mountains.\r\nThe park proposes high-flying activities such as the zipwire, pirate trail, trampolines and tarzan jumps, all in a safe setting with a warm and friendly atmosphere.\""
    ],
    "it": [
      "Venite a godervi 2 o 3 ore di attività acrobatiche sugli alberi: zip line, rete corsara, rete trampolino, liana Tarzan? Con 5 percorsi adatti a tutti i livelli."
    ],
    "fr": [
      "Venez vivre 2 à 3 heures d’activités acrobatiques dans les arbres : tyrolienne, filet corsaire, filet trampoline, liane Tarzan… Avec 5 parcours adaptés à tous les niveaux."
    ],
    "es": [
      "Venga a disfrutar de 2 a 3 horas de actividades acrobáticas en los árboles: tirolina, red corsario, red trampolín, liana de Tarzán? Con 5 recorridos para todos los niveles."
    ],
    "nl": [
      "Kom en geniet van 2 tot 3 uur acrobatische activiteiten in de bomen: tokkelbaan, corsair net, trampoline net, Tarzan liaan? Met 5 parcours voor alle niveaus."
    ]
  },
