  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Türen des L?Atelier, um Ausstellungen zu entdecken, Aufführungen (Theater, Lesungen, Märchen...) zu besuchen, Autorinnen und Autoren zu treffen, an Kunstworkshops teilzunehmen..."
    ],
    "en": [
      "Visit L'Atelier to discover exhibitions, attend shows (theater, readings, storytelling...), meet authors, take part in artistic workshops..."
    ],
    "it": [
      "Visitate L'Atelier per scoprire mostre, assistere a spettacoli (teatro, letture, narrazioni...), incontrare autori, partecipare a laboratori artistici..."
    ],
    "fr": [
      "Franchissez les portes de L’Atelier pour découvrir des expositions, assister à des spectacles (théâtre, lectures, contes...), rencontrer des autrices et des auteurs, participer à des ateliers artistiques..."
    ],
    "es": [
      "Visite L'Atelier para descubrir exposiciones, asistir a espectáculos (teatro, lecturas, cuentacuentos...), conocer a autores, participar en talleres artísticos..."
    ],
    "nl": [
      "Bezoek L'Atelier om tentoonstellingen te ontdekken, voorstellingen bij te wonen (theater, lezingen, verhalen vertellen...), auteurs te ontmoeten, deel te nemen aan artistieke workshops..."
    ]
