  "rdfs:comment": {
    "de": [
      "Gegenüber dem Tourismusbüro empfängt Sie das Restaurant Les Fontaines Blanches auf seiner großen Sonnenterrasse. Entdecken Sie die savoyische Küche: Tartiflettes, Raclettes, Grillspezialitäten, Pizzas aus dem Holzofen und Tagessalate. Mittagsbuffet im Winter."
    ],
    "en": [
      "Opposite the Tourist Office, Les Fontaines Blanches Restaurant welcomes you on its large sunny terrace. Discover Savoyard cuisine: tartiflettes, raclettes, grilled dishes, wood-fired pizzas, and daily salads. Lunch buffet available in winter."
    ],
    "it": [
      "Di fronte all'Ufficio del Turismo, il ristorante Les Fontaines Blanches vi accoglie sulla sua grande terrazza soleggiata. La cucina savoiarda comprende tartiflettes, raclettes, grigliate, pizze al forno a legna e insalate giornaliere. Pranzo a buffet in inverno."
    ],
    "fr": [
      "Face à l’Office de Tourisme, le Restaurant Les Fontaines Blanches vous accueille sur sa grande terrasse ensoleillée. Découvrez une cuisine savoyarde : tartiflettes, raclettes, grillades, pizzas au feu de bois et salades du jour. Buffet midi en hiver."
    ],
    "nl": [
      "Tegenover het VVV-kantoor verwelkomt restaurant Les Fontaines Blanches u op zijn grote zonnige terras. Ontdek de Savoyaardse keuken: tartiflettes, raclettes, grillgerechten, houtgestookte pizza’s en dagsalades. ’s Winters lunchbuffet."
    ],
    "es": [
      "Frente a la Oficina de Turismo, el Restaurante Les Fontaines Blanches le da la bienvenida en su gran terraza soleada. La cocina saboyana incluye tartiflettes, raclettes, parrilladas, pizzas al horno de leña y ensaladas diarias. Almuerzo buffet en invierno."
    ]
  },
