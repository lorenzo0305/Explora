  "rdfs:comment": {
    "de": [
      "Die Rückkehr von Dame Randonne! Eine ungewöhnliche Art, die Altstadt von Nyons zu entdecken. Eine ungewöhnliche und historische Nachtführung.\r\nDame Randonne de Montauban, die im 13. Jahrhundert Nyons besaß, hat ein Geheimnis, das sie Ihnen verraten möchte, eine Suche, die sie Ihnen anvertrauen möchte."
    ],
    "en": [
      "The return of Dame Randonne! An unusual way to discover old Nyons. An unusual and historic night-time guided tour.\r\nDame Randonne de Montauban, owner of Nyons in the 13th century, has a secret to tell you, a quest to entrust to you."
    ],
    "it": [
      "Dame Randonne è tornata! Un modo insolito per scoprire il centro storico di Nyons. Una visita guidata notturna insolita e storica.\r\nDame Randonne de Montauban, proprietaria di Nyons nel XIII secolo, ha un segreto da svelarvi, una missione da affidarvi."
    ],
    "fr": [
      "Le retour de Dame Randonne ! Une manière insolite de découvrir le vieux Nyons. Une visite guidée nocturne insolite et historique.\r\nDame Randonne de Montauban, propriétaire de Nyons au 13e s a un secret à vous livrer, une quête à vous confier."
    ],
    "es": [
      "¡Vuelve Dame Randonne! Una forma insólita de descubrir el casco antiguo de Nyons. Una visita guiada nocturna insólita e histórica.\r\nDama Randonne de Montauban, dueña de Nyons en el siglo XIII, tiene un secreto que contarle, una misión que confiarle."
    ],
    "nl": [
      "Dame Randonne is terug! Een ongewone manier om de oude stad Nyons te ontdekken. Een ongewone en historische nachtelijke rondleiding.\r\nDame Randonne de Montauban, eigenaresse van Nyons in de 13e eeuw, heeft je een geheim te vertellen, een zoektocht aan je toe te vertrouwen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le secret de Dame Randonne"
    ]
  },
