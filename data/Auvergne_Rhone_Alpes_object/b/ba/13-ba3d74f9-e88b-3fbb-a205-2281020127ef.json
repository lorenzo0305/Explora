  "rdfs:comment": {
    "de": [
      "Der Haras du Vercors nimmt Sie vom Einstieg in die Vercors das ganze Jahr über in hochwertigen, dem Bergklima angepassten Strukturen auf, mit seinem grossen, überdachten Stall und Karussell."
    ],
    "en": [
      "From initiation to improvement, the Haras du Vercors welcomes you all year round, in quality structures adapted to the mountain climate, with its stable and large covered riding stables."
    ],
    "it": [
      "Dall'iniziazione al perfezionamento, l'Haras du Vercors vi accoglie tutto l'anno, in strutture di qualità adatte al clima di montagna, con la sua scuderia e il suo grande maneggio coperto."
    ],
    "fr": [
      "De l'initiation au perfectionnement, le Haras du Vercors vous accueille toute l'année, dans des structures de qualité adaptées au climat montagnard, avec son écurie et son manège couvert de grande taille."
    ],
    "nl": [
      "Van initiatie tot verbetering, de Haras du Vercors verwelkomt u het hele jaar door, in kwaliteitsstructuren aangepast aan het bergklimaat, met zijn stal en zijn grote overdekte manege."
    ],
    "es": [
      "Desde la iniciación hasta el perfeccionamiento, el Haras du Vercors le acoge durante todo el año, en estructuras de calidad adaptadas al clima de montaña, con su establo y su gran picadero cubierto."
    ]
  },
