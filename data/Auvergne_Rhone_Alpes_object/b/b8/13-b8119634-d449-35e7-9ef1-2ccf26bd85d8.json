  "rdfs:comment": {
    "de": [
      "Brasserie mit überschaubarer Größe, die sich auf dem gemütlichen Place de la Victoire befindet. Bei schönem Wetter auf der Terrasse oder drinnen bietet der Chefkoch des Le Derrière frische und saisonale Produkte an: Salate, Schmorgerichte und Pizzas."
    ],
    "en": [
      "Brasserie on a human scale, located on the pleasant Place de la Victoire. On the terrace when the weather's fine, or indoors, Le Derrière's chef serves up fresh seasonal produce: salads, stews and pizzas."
    ],
    "it": [
      "Brasserie a misura d'uomo, situata nella piacevole Place de la Victoire. Sulla terrazza nella bella stagione o all'interno, lo chef di Le Derrière serve prodotti freschi di stagione: insalate, stufati e pizze."
    ],
    "fr": [
      "Brasserie à taille humaine, située sur l'agréable place de la Victoire. En terrasse aux beaux jours ou à l’intérieur le chef du Derrière propose des produits frais et de saison : salades, plats mijotés et pizzas."
    ],
    "nl": [
      "Brasserie op menselijke schaal, gelegen aan de gezellige Place de la Victoire. Op het terras bij mooi weer of binnen serveert de chef van Le Derrière verse seizoensproducten: salades, stoofschotels en pizza's."
    ],
    "es": [
      "Brasserie a escala humana, situada en la agradable Place de la Victoire. En la terraza cuando hace buen tiempo o en el interior, el chef de Le Derrière sirve productos frescos de temporada: ensaladas, guisos y pizzas."
    ]
  },
  "rdfs:label": {
