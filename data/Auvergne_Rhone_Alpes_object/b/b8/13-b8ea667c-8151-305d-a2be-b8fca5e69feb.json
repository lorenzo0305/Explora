  "rdfs:comment": {
    "de": [
      "Mit Ludimoulins können Sie an Brettspielnachmittagen moderne Spiele entdecken oder wiederentdecken. Mit der Familie, mit Freunden oder allein, teilen Sie einen spielerischen und geselligen Moment rund um Bretter, Karten und Herausforderungen, die ab 8 Jahren zugänglich sind."
    ],
    "en": [
      "Board game afternoons to discover or rediscover modern games with Ludimoulins. As a family, with friends or on your own, share a playful and convivial moment around boards, cards and challenges accessible from the age of 8."
    ],
    "it": [
      "Pomeriggi di giochi da tavolo per scoprire o riscoprire i giochi moderni con Ludimoulins. In famiglia, con gli amici o da soli, condividete un momento divertente e conviviale intorno a tavoli da gioco, carte e sfide accessibili a partire dagli 8 anni."
    ],
    "fr": [
      "Des après-midis jeux de société pour découvrir ou redécouvrir les jeux modernes avec Ludimoulins. En famille, entre amis ou en solo, partagez un moment ludique et convivial autour de plateaux, cartes et défis accessibles dès 8 ans."
    ],
    "es": [
      "Tardes de juegos de mesa para descubrir o redescubrir los juegos modernos con Ludimoulins. En familia, con amigos o solo, comparta un momento de diversión y convivencia en torno a tableros, cartas y desafíos accesibles a partir de los 8 años."
    ],
    "nl": [
      "Bordspelmiddagen om moderne spellen te ontdekken of herontdekken met Ludimoulins. Met het gezin, met vrienden of alleen, deel een leuk en gezellig moment rond borden, kaarten en uitdagingen die toegankelijk zijn vanaf 8 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jeux de société"
    ]
  },
