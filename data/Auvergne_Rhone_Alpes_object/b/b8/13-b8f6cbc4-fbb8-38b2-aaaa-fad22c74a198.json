  "rdfs:comment": {
    "de": [
      "CJ Pro'Vence Conciergerie: Vertrauen Sie uns Ihre Kurzzeitvermietungen an, um mehr Gelassenheit zu erlangen. Sie sind Eigentümer oder Investor und möchten Ihre Immobilie mithilfe von Kurzzeitvermietungen rentabel machen? Ihre Immobilie ist bei uns in guten Händen!"
    ],
    "en": [
      "CJ Pro'Vence Conciergerie: Entrust us with your short-term rentals for greater peace of mind. Are you a property owner or investor looking to maximize the profitability of your property through short-term rentals? Your property will be in good hands!"
    ],
    "it": [
      "CJ Pro'Vence Conciergerie : Affidateci i vostri affitti a breve termine per una maggiore tranquillità. Siete proprietari o investitori che desiderano trarre profitto dalla vostra proprietà attraverso l'affitto a breve termine? La vostra proprietà sarà in mani sicure!"
    ],
    "fr": [
      "CJ Pro'Vence Conciergerie : Confiez-nous vos locations courte durée pour plus de sérénité. Vous êtes propriétaire ou investisseur et souhaitez rentabiliser votre bien grâce à la location courte durée ? Votre bien sera entre de bonnes mains !"
    ],
    "nl": [
      "CJ Pro'Vence Conciergerie : Vertrouw ons uw kortetermijnverhuur toe voor meer gemoedsrust. Bent u eigenaar of investeerder en wilt u uw eigendom op korte termijn verhuren? Uw eigendom is bij ons in veilige handen!"
    ],
    "es": [
      "CJ Pro'Vence Conciergerie : Confíenos sus alquileres de corta duración para mayor tranquilidad. ¿Es usted propietario o inversor y desea rentabilizar su propiedad mediante el alquiler a corto plazo? ¡Su propiedad estará en buenas manos!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "CJ Pro'vence Conciergerie"
    ]
  },
