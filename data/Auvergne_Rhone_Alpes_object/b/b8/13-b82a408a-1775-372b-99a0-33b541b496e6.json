  "rdfs:comment": {
    "de": [
      "Die Basilika Notre-Dame-du-Port ist ein Meisterwerk der romanischen Kunst in der Auvergne und gehört zum UNESCO-Weltkulturerbe. Sie besticht durch ihre architektonische Harmonie, ihre geschnitzten Kapitelle und den Glanz ihres blonden Steins."
    ],
    "en": [
      "A masterpiece of Auvergne Romanesque art and a UNESCO World Heritage site, the Notre-Dame-du-Port basilica captivates visitors with its architectural harmony, sculpted capitals and brilliant blond stone."
    ],
    "it": [
      "Capolavoro dell'arte romanica dell'Alvernia e patrimonio mondiale dell'UNESCO, la Basilica di Notre Dame du Port è un capolavoro architettonico con capitelli scolpiti e pietra bionda scintillante."
    ],
    "fr": [
      "Chef‑d’œuvre de l’art roman auvergnat et classée au patrimoine mondial de l’UNESCO, la basilique Notre‑Dame‑du‑Port séduit par son harmonie architecturale, ses chapiteaux sculptés et l’éclat de sa pierre blonde."
    ],
    "es": [
      "Obra maestra del arte románico en Auvernia y Patrimonio Mundial de la UNESCO, la basílica de Notre-Dame-du-Port posee una armonía arquitectónica cautivadora, capiteles esculpidos y reluciente piedra rubia."
    ],
    "nl": [
      "De Basiliek Notre-Dame-du-Port is een meesterwerk van de Romaanse kunst in Auvergne en staat op de Werelderfgoedlijst van UNESCO. Het heeft een fascinerende architectonische harmonie, gebeeldhouwde kapitelen en glinsterende blonde steen."
    ]
  },
