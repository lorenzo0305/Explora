  "rdfs:comment": {
    "de": [
      "Auf den Allees provençales neben den Kinos, traditionelles und kreatives Kochen von frischen und hochwertigen Produkten, schöne Auswahl an Wein und Champagner in einer Struktur mit origineller Deko."
    ],
    "en": [
      "On the Allées Provençales, close to the cinemas, you'll find gourmet bistro-style cuisine, made using high-quality, fresh produce, as well as a great wine list and selection of champagnes, in an establishment with original decoration."
    ],
    "it": [
      "Sull'Allées Provençales, accanto ai cinema, cucina bistronomica con prodotti freschi e di qualità, una raffinata selezione di vini e champagne in una struttura dall'arredamento originale."
    ],
    "fr": [
      "Sur les Allées provençales à coté des cinémas, cuisine bistronomique de produits frais et de qualité, belle sélection de vins et de champagnes dans une structure à la déco originale."
    ],
    "nl": [
      "Traditionele creatieve keuken met verse kwaliteitsproducten aan de Allées Provençales naast de bioscopen. Fijne selectie van wijnen en champagne in een ruimte met originele inrichting!"
    ],
    "es": [
      "En las Allées Provençales, junto a los cines, cocina bistronómica con productos frescos y de calidad, una buena selección de vinos y champagnes en una estructura con una decoración original."
    ]
  },
