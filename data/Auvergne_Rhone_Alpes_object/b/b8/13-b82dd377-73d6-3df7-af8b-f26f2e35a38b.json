  "rdfs:comment": {
    "de": [
      "Das Edmond's im Four Seasons Resort Megève ist der ideale Ort, um sich in einem anspruchsvollen und zugleich gemütlichen Ambiente zu entspannen. Dieser gemütliche Raum, der über eine Terrasse verfügt, bietet eine abwechslungsreiche und raffinierte Speisekarte."
    ],
    "en": [
      "Edmond's at  Four Seasons Resort Megève is the perfect venue to relax in an ambiance that is both cosy and sophisticated. Warm and friendly, with a terrace, the bar offers a varied and refined list."
    ],
    "it": [
      "Edmond's al Four Seasons Resort Megève è il luogo ideale per rilassarsi in un'atmosfera sofisticata e vellutata. Questo spazio accogliente con terrazza propone una carta molto varia e raffinata."
    ],
    "fr": [
      "Edmond's au Four Seasons Resort Megève, est le lieu idéal pour se relaxer dans une ambiance à la fois sophistiquée et feutrée. Cet espace chaleureux, disposant d'une terrasse, propose une carte variée et raffinée."
    ],
    "es": [
      "Edmond's, en el Four Seasons Resort Megève, es el lugar ideal para relajarse en un ambiente sofisticado y acogedor a la vez. Este acogedor espacio, con terraza, ofrece una carta variada y refinada."
    ],
    "nl": [
      "Edmond's in het Four Seasons Resort Megève is de ideale plek om te ontspannen in een verfijnde en gezellige sfeer. Deze gezellige ruimte, met terras, biedt een gevarieerd en verfijnd menu."
    ]
  },
