  "rdfs:comment": {
    "de": [
      "Das Café des Loisirs lädt Sie zu gemeinsamen Stunden rund um die \"Kunst des Fadens\" ein: Stricken, Häkeln, Weben oder jede andere Technik... Diese Treffen sind kostenlos und unverbindlich."
    ],
    "en": [
      "Le Café des Loisirs invites you to share your passion for \"the art of yarn\": knitting, crocheting, weaving or any other technique... This is a free, no-obligation event."
    ],
    "it": [
      "Il Café des Loisirs vi invita a condividere un po' di tempo insieme intorno all'\"arte del filo\": maglia, uncinetto, tessitura o qualsiasi altra tecnica... Questo incontro è gratuito e senza impegno."
    ],
    "fr": [
      "Le Café des Loisirs vous convie à des moments de partage autour de « l’art du fil »Tricot, crochet, tissage ou tout autre technique... Ce rendez-vous est libre et sans engagement."
    ],
    "nl": [
      "Het Café des Loisirs nodigt je uit om samen wat tijd door te brengen rond de \"kunst van het garen\": breien, haken, weven of een andere techniek... Deze bijeenkomst is gratis en vrijblijvend."
    ],
    "es": [
      "El Café des Loisirs le invita a compartir un rato juntos en torno al \"arte del hilo\": punto, ganchillo, tejido o cualquier otra técnica... Este encuentro es gratuito y sin compromiso."
    ]
  },
  "rdfs:label": {
