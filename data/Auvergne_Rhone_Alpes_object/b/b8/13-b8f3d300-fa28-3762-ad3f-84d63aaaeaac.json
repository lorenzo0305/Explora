  "rdfs:comment": {
    "de": [
      "Das Café ist ein gemütlicher Ort, an dem Sie Ihr Frühstück ab 7 Uhr genießen können, mit Gebäck und einer entspannenden Atmosphäre, die ideal ist, um den ganzen Tag über zu diskutieren oder zu arbeiten.\r\nDas Restaurant ist ein eleganter Ort, der eine köstliche Auswahl an Bistrogerichten anbietet."
    ],
    "en": [
      "The café A warm and inviting place to enjoy breakfast from 7 a.m., pastries and a relaxing atmosphere, ideal for chatting or working all day long.\r\nThe restaurant an elegant venue offering a delicious variety of bistronomic dishes."
    ],
    "it": [
      "La caffetteria Un luogo accogliente dove gustare la colazione dalle 7 del mattino, dolci e un'atmosfera rilassante, ideale per chiacchierare o lavorare tutto il giorno.\r\nIl ristorante Un locale elegante che offre una deliziosa varietà di piatti bistronomici."
    ],
    "fr": [
      "Le café lieu chaleureux où vous pourrez déguster votre petit déjeuner des 7h, viennoiseries et une ambiance relaxante, idéale pour discuter ou travailler toute la jrnée.\r\nLe restaurant lieu élégant proposant une délicieuse variété de plats bistronomiques."
    ],
    "es": [
      "La cafetería Un lugar acogedor donde disfrutar del desayuno desde las 7 de la mañana, bollería y un ambiente relajado, ideal para charlar o trabajar todo el día.\r\nEl restaurante Un lugar elegante que ofrece una deliciosa variedad de platos bistronómicos."
    ],
    "nl": [
      "Het café Een gezellige plek waar je kunt genieten van ontbijt vanaf 7 uur, gebak en een ontspannen sfeer, ideaal om de hele dag te kletsen of te werken.\r\nHet restaurant is een elegante plek met een heerlijke verscheidenheid aan bistronomische gerechten."
    ]
  },
