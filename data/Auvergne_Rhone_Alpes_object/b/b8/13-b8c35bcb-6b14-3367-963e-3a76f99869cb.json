  "rdfs:comment": {
    "de": [
      "Weinkeller und Workshops zur Weinverkostung. Im Herzen von Lezoux Les Vingabonds lieben, was gut ist. Weine von ethisch einwandfreien Erzeugern, Originalität und Entdeckung von handwerklich gebrauten Bieren."
    ],
    "en": [
      "Cellar and tasting workshops. In the heart of Lezoux, Les Vingabonds love what's good, wines from ethical growers, originality and discovery of craft beers."
    ],
    "it": [
      "Cantina e laboratori di degustazione. Nel cuore di Lezoux, Les Vingabonds amano le cose buone, i vini di coltivatori etici, l'originalità e la scoperta delle birre artigianali."
    ],
    "fr": [
      "Cave et ateliers de dégustation. Au cœur de Lezoux Les Vingabonds aiment ce qui est bon, vins de récoltants éthiques, originalité et découverte de bières artisanales."
    ],
    "nl": [
      "Kelder en proeverij workshops. In het hart van Lezoux houden Les Vingabonds van wat goed is, wijnen van ethische telers, originaliteit en het ontdekken van ambachtelijke bieren."
    ],
    "es": [
      "Bodega y talleres de degustación. En el corazón de Lezoux, Les Vingabonds aman lo bueno, los vinos de viticultores éticos, la originalidad y el descubrimiento de cervezas artesanales."
    ]
  },
  "rdfs:label": {
