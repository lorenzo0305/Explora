  "rdfs:comment": {
    "de": [
      "Kooperative Spiele, Stimmungsspiele, Brettspiele...\r\n\r\nKomm allein oder mit deinen Freunden für einen Moment in die Bibliothek und entdecke die Spiele, die dir zur Verfügung gestellt werden."
    ],
    "en": [
      "Cooperative games, mood games, board games...\r\n\r\nCome and spend some time at the library, on your own or with your friends, and discover the games available to you."
    ],
    "it": [
      "Giochi cooperativi, giochi d'atmosfera, giochi da tavolo...\r\n\r\nVenite in biblioteca da soli o con gli amici per scoprire l'offerta di giochi."
    ],
    "fr": [
      "Jeux coopératifs, jeux d'ambiance, jeux de plateau... \r\n\r\nViens te poser un moment à la bibliothèque en solo ou avec tes amis pour découvrir des jeux mis à ta disposition."
    ],
    "es": [
      "Juegos cooperativos, juegos atmosféricos, juegos de mesa...\r\n\r\nAcércate a la biblioteca solo o con tus amigos para descubrir los juegos que te proponemos."
    ],
    "nl": [
      "Coöperatieve spellen, sfeervolle spellen, bordspellen...\r\n\r\nKom alleen of met je vrienden naar de bibliotheek om het spelaanbod te ontdekken."
    ]
  },
