  "rdfs:comment": {
    "de": [
      "Willkommen in der Asinerie! Der Esel ist der ideale Begleiter, um einen ungewöhnlichen und unvergesslichen Urlaub mit der Familie oder mit Freunden zu verbringen! Eselverleih, Wandertouren, Kinderkurse (6-12 Jahre), Besichtigung der Eselfarm, Empfang von Gruppen?"
    ],
    "en": [
      "Welcome to the Assinerie! The donkey is the ideal companion for spending unusual and unforgettable holidays with family or friends! Donkey rental, hike-meeting, children’s course 6-12 years old, visit to the donkey farm, group reception…"
    ],
    "it": [
      "Benvenuti all'Asinerie! L'asino è il compagno ideale per trascorrere vacanze insolite e indimenticabili in famiglia o con gli amici! Noleggio asini, trekking, corso per bambini 6-12 anni, visita alla fattoria degli asini, gruppi?"
    ],
    "fr": [
      "Bienvenue à l’Asinerie ! L'âne est le compagnon idéal pour passer des vacances insolites et inoubliables en famille ou entre amis ! Location d’âne, rando-rencontre, stage enfants 6-12 ans, visite de l’asinerie, accueil de groupes…"
    ],
    "es": [
      "¡Bienvenido a la Asinerie! ¡El burro es el compañero ideal para pasar unas vacaciones insólitas e inolvidables en familia o entre amigos! Alquiler de burros, senderismo, curso para niños de 6 a 12 años, visita de la granja de burros, recepción de grupos.."
    ],
    "nl": [
      "Welkom bij de Assinerie! De ezel is de ideale metgezel voor een ongewone en onvergetelijke vakantie met familie of vrienden! Ezelverhuur, wandelbijeenkomst, kindercursus 6-12 jaar, bezoek aan de ezelboerderij, groepsontvangst…"
    ]
  },
  "rdfs:label": {
    "en": [
      "Donkeys and Hikes"
    ],
    "fr": [
      "Ânes et Randonnées"
    ],
    "nl": [
      "Ezels en wandelen"
    ]
  },
