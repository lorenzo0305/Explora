  "rdfs:comment": {
    "de": [
      "4. Ausgabe des Biermarathons mit dem Thema Mittelalter!\r\nAuf dem Programm stehen: Marathon, Halbmarathon, 10-km-Lauf, barrierefreie (8 km) und sportliche (15 km) Wanderung, Verkostungen, Abendveranstaltungen, Kinderläufe, Messe des Made in Loire."
    ],
    "en": [
      "4th edition of the beer marathon on the theme of the Middle Ages!\r\nOn the program: marathon, half-marathon, 10km race, accessible (8km) and sporty (15km) hikes, tastings, evening events, children's races, Made in Loire trade fair."
    ],
    "it": [
      "quarta edizione della maratona della birra sul tema del Medioevo!\r\nIn programma: maratona, mezza maratona, gara di 10 km, escursioni accessibili (8 km) e sportive (15 km), degustazioni, eventi serali, gare per bambini, fiera del Made in Loire."
    ],
    "fr": [
      "4ème édition du marathon de la bière sur le thème du Moyen-Age ! \r\nAu programme : marathon, semi marathon, course de 10 km, randonnée accessible (8km) et sportive (15km), dégustations, soirées, courses pour les enfants, salon du made in Loire."
    ],
    "nl": [
      "4e editie van de biermarathon met als thema de Middeleeuwen!\r\nOp het programma: marathon, halve marathon, 10 km wedstrijd, toegankelijke (8 km) en sportieve (15 km) wandelingen, proeverijen, avondevenementen, kinderwedstrijden, Made in Loire beurs."
    ],
    "es": [
      "4ª edición del maratón de la cerveza sobre el tema de la Edad Media\r\nEn el programa: maratón, medio maratón, carrera de 10 km, caminatas accesibles (8 km) y deportivas (15 km), degustaciones, veladas, carreras infantiles, feria Made in Loire."
    ]
  },
