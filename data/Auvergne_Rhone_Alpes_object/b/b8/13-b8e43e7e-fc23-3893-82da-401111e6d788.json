  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Gasthaus mit seinem rustikalen Charme und seinen traditionellen Räumen, die mit einem Brotofen und einem Kamin ausgestattet sind. Genießen Sie authentische Gerichte: Ochsenzunge, Frösche, Räucherlachs... Säle können für Ihre Veranstaltungen gemietet werden."
    ],
    "en": [
      "The Auberge Campagnard Ailloud is a country inn composed of two rooms with a bread oven and a fireplace. Will you prefer having today's menu or pleasure menu?!"
    ],
    "it": [
      "Scoprite il fascino rustico della locanda, con le sue camere tradizionali dotate di forno per il pane e camino. Assaggiate i piatti autentici: lingua di manzo, rane, salmone affumicato... Sale disponibili in affitto per i vostri eventi."
    ],
    "fr": [
      "Découvrez l'auberge au charme rustique, avec ses salles traditionnelles équipées d'un four à pain et d'une cheminée. Savourez des plats authentiques : langue de bœuf, grenouilles, saumon fumé... Salles disponibles à la location pour vos évènements."
    ],
    "nl": [
      "Ontdek de rustieke charme van de herberg, met zijn traditionele kamers met broodoven en open haard. Proef authentieke gerechten: rundertong, kikkers, gerookte zalm... Zalen te huur voor uw evenementen."
    ],
    "es": [
      "Descubra el encanto rústico de la posada, con sus habitaciones tradicionales dotadas de horno de pan y chimenea. Saboree platos auténticos: lengua de vaca, ranas, salmón ahumado... Alquiler de salas para sus eventos."
    ]
  },
