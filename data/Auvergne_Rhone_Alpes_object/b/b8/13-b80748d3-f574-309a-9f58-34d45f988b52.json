  "rdfs:comment": {
    "de": [
      "Die Gemeinde Verchaix erstreckt sich vom Giffre über die Hochebene von Loëx bis zur Alm Joux-Plane. Das Dorf liegt auf der Sonnenseite und hat sich auf 788 m Höhe eingenistet."
    ],
    "en": [
      "Verchaix stretches from the Giffre valley to the Joux-Plane Alpine pastures via the Loëx plateau. The village nestles on the sunny side of the mountain at an elevation of 788 metres."
    ],
    "it": [
      "Il comune di Verchaix si estende dalla Giffre all'alpeggio di Joux-Plane, passando per l'altopiano di Loëx. Situato sul versante soleggiato, il villaggio è adagiato a 788 m di altitudine."
    ],
    "fr": [
      "La commune de Verchaix s’étend du Giffre à l’alpage de Joux-Plane en passant par le plateau de Loëx, situé sur le versant ensoleillé le village s’est niché à 788m d’altitude."
    ],
    "es": [
      "El municipio de Verchaix se extiende desde el Giffre hasta los pastos de montaña de Joux-Plane, pasando por la meseta de Loëx. Situado en el lado soleado, el pueblo está enclavado a 788 m de altitud."
    ],
    "nl": [
      "De gemeente Verchaix strekt zich uit van de Giffre tot de bergweide Joux-Plane, via het plateau van Loëx. Het dorp ligt op de zonzijde en is genesteld op een hoogte van 788 m."
    ]
  },
