  "rdfs:comment": {
    "de": [
      "Tâm, Chefpatissier, und sein Team haben die Küche übernommen und bereiten Ihnen Gerichte aus unprätentiösen, schmackhaften lokalen Produkten zu, die aus kühnen, atemberaubenden Aromen bestehen, die mit Hilfe saisonaler Zutaten erzielt werden."
    ],
    "en": [
      "Tâm, pastry chef and his team have taken the reins of the kitchen and prepare dishes using unpretentious, tasty local products, composed of bold, breathtaking flavours obtained using seasonal ingredients."
    ],
    "it": [
      "Il pasticcere Tâm e il suo team hanno preso in mano la cucina e preparano piatti con prodotti locali gustosi e senza pretese, con sapori audaci e mozzafiato utilizzando ingredienti di stagione."
    ],
    "fr": [
      "Tâm, chef pâtissier et son équipe ont pris les rennes de la cuisine et vous préparent des plats à partir de produits locaux sans prétention, savoureux, composés de saveurs audacieuses à couper le souffle obtenues à l’aide d’ingrédients de saisons."
    ],
    "es": [
      "El pastelero Tâm y su equipo se han hecho cargo de la cocina y preparan platos con productos locales sin pretensiones y sabrosos, con sabores atrevidos e impresionantes con ingredientes de temporada."
    ],
    "nl": [
      "Banketbakker Tâm en zijn team hebben de keuken overgenomen en bereiden gerechten van pretentieloze, smakelijke streekproducten, met adembenemend gedurfde smaken met seizoensgebonden ingrediënten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Tâm à l'Affiche"
    ]
  },
