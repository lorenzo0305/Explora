  "rdfs:comment": {
    "de": [
      "Das Plateau des Prioux liegt auf 1725 m Höhe und ist ein seltener Ort am Rande des Nationalparks Vanoise. Der Doron de Chavière, der das Gebiet durchfließt, wird von Bachforellen, Regenbogenforellen und Brunnenlachsen bevölkert."
    ],
    "en": [
      "At an altitude of 1725 metres, the Prioux plateau is a rare site at the gateway to the Vanoise National Park. The Doron de Chavière that runs through it is populated by fario trout, rainbow trout and brook salmon."
    ],
    "it": [
      "A 1725 metri di altitudine, l'altopiano di Prioux è un sito raro alle porte del Parco Nazionale della Vanoise. Il Doron de Chavière che lo attraversa è popolato da trote fario, trote iridee e salmoni di ruscello."
    ],
    "fr": [
      "À 1725 mètres d’altitude, le plateau des Prioux est un site rare aux portes du Parc national de la Vanoise. Le Doron de Chavière qui le traverse est peuplé de truites fario, truites arc-en-ciel et saumons de fontaine."
    ],
    "nl": [
      "Op 1725 meter hoogte is het plateau van Prioux een zeldzame plek aan de poort van het Vanoise National Park. De Doron de Chavière die er doorheen stroomt wordt bevolkt door fario forel, regenboogforel en beekzalm."
    ],
    "es": [
      "A 1.725 metros de altitud, la meseta de Prioux es un paraje excepcional a las puertas del Parque Nacional de la Vanoise. El Doron de Chavière que la atraviesa está poblado por truchas fario, truchas arco iris y salmones de arroyo."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstrecke \"Passion\" No-kill des Doron de Chavière in Pralognan-la-Vanoise"
    ],
    "ru": [
      "Рыболовная тропа \"Страсть\" на Дорон-де-Шавьер в Пралоньян-ла-Вануаз"
    ],
    "en": [
      "No-kill \"Passion\" fishing trail on the Doron de Chavière at Pralognan-la-Vanoise"
    ],
    "it": [
      "Percorso di pesca no-kill \"Passion\" sul Doron de Chavière a Pralognan-la-Vanoise"
    ],
    "fr": [
      "Parcours Pêche \"Passion\" No-kill du Doron de Chavière à Pralognan-la-Vanoise"
    ],
    "zh": [
      "位于瓦努瓦斯普拉洛尼昂的多龙-德-沙维耶尔（Doron de Chavière）河上的 \"激情 \"垂钓小径，无需杀生"
    ],
    "es": [
      "Ruta de pesca sin muerte \"Pasión\" en el Doron de Chavière en Pralognan-la-Vanoise"
    ],
    "nl": [
      "No-kill \"Passion\" visroute op de Doron de Chavière in Pralognan-la-Vanoise"
    ]
  },
