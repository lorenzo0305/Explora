  "rdfs:comment": {
    "de": [
      "Wir befinden uns auf der Piste des Bahnhofs und bieten Ihnen eine leckere und großzügige Küche in einem authentischen und gemütlichen Rahmen."
    ],
    "en": [
      "Open every day, located on the station track, we offer generous gourmet cuisine in a warm, authentic setting."
    ],
    "it": [
      "Situato nel piazzale della stazione, offre un'abbondante cucina gourmet in un ambiente caldo e autentico."
    ],
    "fr": [
      "Situé sur la piste de la gare, nous vous proposons une cuisine gourmande et généreuse dans un cadre authentique et chaleureux."
    ],
    "es": [
      "Situado en la explanada de la estación, ofrecemos una generosa cocina gourmet en un ambiente cálido y auténtico."
    ],
    "nl": [
      "Gelegen op het voorplein van het station, bieden we een royale gastronomische keuken in een warme, authentieke omgeving."
    ]
  },
