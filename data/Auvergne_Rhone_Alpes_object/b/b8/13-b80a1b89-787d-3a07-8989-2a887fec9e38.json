  "rdfs:comment": {
    "de": [
      "Familienessen, Taufe, Kommunion, Hochzeit oder ein einfaches Essen mit Freunden, ganz nach Ihrem Geschmack und Ihren Wünschen werden wir Sie verwöhnen.....Catering-Service."
    ],
    "en": [
      "Family meals, christenings, communions, weddings or just a meal with friends, we can cater to your tastes and desires.....Service traiteur."
    ],
    "it": [
      "Che si tratti di un pranzo in famiglia, di un battesimo, di una comunione, di un matrimonio o semplicemente di un pranzo tra amici, possiamo soddisfare i vostri gusti e desideri..... servizio di catering."
    ],
    "fr": [
      "Repas de famille, baptême, communion, mariage ou simple repas entre amis, selon vos goûts et vos envies nous saurons vous régaler.....Service traiteur."
    ],
    "es": [
      "Ya sea una comida familiar, un bautizo, una comunión, una boda o simplemente una comida entre amigos, podemos satisfacer sus gustos y deseos.....Servicio de catering."
    ],
    "nl": [
      "Of het nu gaat om een familiemaaltijd, doop, communie, bruiloft of gewoon een maaltijd met vrienden, wij kunnen aan uw smaak en wensen voldoen.....Catering service."
    ]
  },
