  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine Entdeckungsreise durch das industrielle Erbe der Region. Das Wasserkraftwerk von Monistrol d'Allier feiert 2026 seinen 100."
    ],
    "en": [
      "Discover the region's industrial heritage. The Monistrol d'Allier hydroelectric power station celebrates its 100th anniversary in 2026."
    ],
    "it": [
      "Scoprite il patrimonio industriale della regione. La centrale idroelettrica di Monistrol d'Allier festeggia il suo 100° anniversario nel 2026."
    ],
    "fr": [
      "Partez à la découverte du patrimoine industriel du territoire. La centrale hydroélectrique de Monistrol d'Allier fête ses 100 ans en 2026."
    ],
    "nl": [
      "Ontdek het industriële erfgoed van de regio. De waterkrachtcentrale Monistrol d'Allier viert zijn 100e verjaardag in 2026."
    ],
    "es": [
      "Descubra el patrimonio industrial de la región. La central hidroeléctrica de Monistrol d'Allier celebra su centenario en 2026."
    ]
  },
