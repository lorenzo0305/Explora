  "rdfs:comment": {
    "de": [
      "In einer bergigen Umgebung auf 1524 m Höhe wird der Lac du Loup Angler begeistern, die auf der Suche nach Weißfischen, aber auch Hechten und Karpfen sind."
    ],
    "en": [
      "In a mountain setting at an altitude of 1524m, Lac du Loup will delight anglers looking for white fish as well as pike and carp."
    ],
    "it": [
      "In un ambiente montano a 1524 m di altitudine, il Lac du Loup farà la gioia dei pescatori alla ricerca di pesce bianco, lucci e carpe."
    ],
    "fr": [
      "Dans un cadre montagnard à 1524m d'altitude, le lac du Loup ravira les pêcheurs à la recherche de poissons blancs mais aussi de brochets et de carpes."
    ],
    "nl": [
      "In een bergachtige omgeving op 1524 meter hoogte zal Lac du Loup vissers die op zoek zijn naar witvis, snoek en karper verrukken."
    ],
    "es": [
      "En un entorno montañoso a 1.524 m de altitud, el lago del Loup hará las delicias de los pescadores que buscan peces blancos, además de lucios y carpas."
    ]
  },
