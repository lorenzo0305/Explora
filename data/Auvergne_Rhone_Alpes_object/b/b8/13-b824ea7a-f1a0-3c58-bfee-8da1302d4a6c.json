  "rdfs:comment": {
    "de": [
      "Workshop zur Gestaltung und Einführung in das Tufting, in dem du lernen kannst, wie du deine eigenen Teppiche oder Wanddekorationen herstellen kannst.\r\nTapezieren Sie Ihr Leben mit Farben in Begleitung von Alexandra!"
    ],
    "en": [
      "Tufting workshop where you can learn to make your own rugs or wall decorations.\r\nAdd color to your life with Alexandra!"
    ],
    "it": [
      "Un laboratorio di tufting per imparare a realizzare tappeti o decorazioni da parete.\r\nAggiungete un tocco di colore alla vostra vita con Alexandra!"
    ],
    "fr": [
      "Atelier de création et d'initiation au tufting où vous pouvez apprendre à réaliser vos propres tapis ou décoration murale.\r\nTapissez votre vie de couleurs en compagnie d'Alexandra !"
    ],
    "es": [
      "Un taller de tufting en el que podrás aprender a hacer tus propias alfombras o adornos de pared.\r\n¡Dale un toque de color a tu vida con Alexandra!"
    ],
    "nl": [
      "Een tuftworkshop waar je je eigen vloerkleden of wanddecoraties leert maken.\r\nGeef je leven kleur met Alexandra!"
