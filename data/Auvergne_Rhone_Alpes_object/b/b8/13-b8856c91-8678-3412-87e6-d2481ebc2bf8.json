  "rdfs:comment": {
    "de": [
      "Willkommen in unserem neuen Skatepark! Entdecken Sie diesen neuen Mehrzweck-Skatebereich, der für Skateboards, Roller (nicht klappbar), BMX-Räder und Inlineskates konzipiert ist und sich im Herzen des Freizeitbereichs des Dorfes befindet."
    ],
    "en": [
      "Welcome to our new skate park! Come and discover this new multi-purpose skating area, designed for skateboards, scooters (non-folding), BMX bikes and rollerblades, located in the heart of the Village's leisure area."
    ],
    "it": [
      "Benvenuti nel nostro nuovo skate park di 617 m²! Scoprite quest'area polivalente per skateboard, monopattini (non pieghevoli), biciclette BMX e rollerblade, situata nel cuore dell'area ricreativa del Villaggio."
    ],
    "fr": [
      "Bienvenue sur notre nouveau skate park de 617m² ! Découvrez cette aire de glisse polyvalente, destinée aux skateboards, trottinettes (non pliantes), BMX et rollers, située au cœur de l'aire de loisirs du Village."
    ],
    "es": [
      "¡Bienvenido a nuestro nuevo skatepark de 617 m²! Descubra este espacio polivalente para monopatines, patinetes (no plegables), bicicletas BMX y patines, situado en el corazón de la zona de ocio del Village."
    ],
    "nl": [
      "Welkom in ons nieuwe skatepark van 617 m²! Ontdek deze multifunctionele ruimte voor skateboards, steps (niet opvouwbaar), BMX-fietsen en skeelers, gelegen in het hart van het recreatiegebied Village."
    ]
  },
