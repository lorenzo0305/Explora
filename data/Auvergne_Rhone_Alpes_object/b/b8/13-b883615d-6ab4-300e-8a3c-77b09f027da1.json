  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Bogenschießen und das Blasrohrschießen oder lassen Sie sich diese Sportarten zeigen. Diese Sportarten fördern das Gleichgewicht, die Präzision und die Konzentration.  Es handelt sich um eine der wenigen Sportarten, die sich an alle Zielgruppen anpassen können."
    ],
    "en": [
      "Come and discover archery and blowpipe shooting. These sports develop balance, precision and concentration. It's one of the few sports that can be adapted to all ages."
    ],
    "it": [
      "Venite a scoprire il tiro con l'arco e il tiro con la cerbottana. Questi sport sviluppano equilibrio, precisione e concentrazione.  È uno dei pochi sport che può essere adattato a tutti."
    ],
    "fr": [
      "Venez découvrir ou faire découvrir le tir à l'arc et le tir à la sarbacane. Ces disciplines sportives développent l'équilibre, la précision et la concentration.  Il s'agit d'un des rares sports pouvant s'adapter à tous les publics."
    ],
    "es": [
      "Ven a descubrir el tiro con arco y el tiro con cerbatana. Estos deportes desarrollan el equilibrio, la precisión y la concentración.  Es uno de los pocos deportes que puede adaptarse a todo el mundo."
    ],
    "nl": [
      "Kom kennismaken met boogschieten en blaaspijpschieten. Deze sporten ontwikkelen evenwicht, precisie en concentratie.  Het is een van de weinige sporten die aan iedereen kan worden aangepast."
    ]
  },
  "rdfs:label": {
