  "rdfs:comment": {
    "de": [
      "Entdecken Sie Le Rucher des Ointes in Peyriat: Im Herzen der Landschaft bieten Ihnen unsere leidenschaftlichen Imker hochwertige Bienenprodukte an. Wir engagieren uns für einen verantwortungsbewussten Tourismus und setzen uns für die lokale Wirtschaft und Umwelt ein."
    ],
    "en": [
      "The \"Rucher des Ointes\" offers you different kind of honey. Member of \"Brin de Paille\""
    ],
    "it": [
      "Scoprite Le Rucher des Ointes a Peyriat: nel cuore della campagna, i nostri appassionati apicoltori vi offrono prodotti apistici di qualità. Impegnati in un turismo responsabile, lavoriamo per l'economia e l'ambiente locali."
    ],
    "fr": [
      "Découvrez Le Rucher des Ointes à Peyriat : au cœur de la campagne, nos apiculteurs passionnés vous offrent des produits apicoles de qualité. Engagés pour un tourisme responsable, nous œuvrons pour l'économie et l'environnement local."
    ],
    "nl": [
      "Ontdek Le Rucher des Ointes in Peyriat: in het hart van het platteland bieden onze gepassioneerde imkers je bijenteeltproducten van hoge kwaliteit. Wij zetten ons in voor verantwoord toerisme en zetten ons in voor de lokale economie en het milieu."
    ],
    "es": [
      "Descubra Le Rucher des Ointes en Peyriat: en plena naturaleza, nuestros apasionados apicultores le ofrecen productos apícolas de calidad. Comprometidos con el turismo responsable, trabajamos por la economía y el medio ambiente locales."
    ]
  },
