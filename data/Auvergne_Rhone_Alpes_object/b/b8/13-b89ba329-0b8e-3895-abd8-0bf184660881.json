  "rdfs:comment": {
    "de": [
      "Monts Jura bietet die ideale Höhe zum Wandern zwischen 900 und 1723 m über dem Meeresspiegel. Markierte und gepflegte Wanderwege warten auf Sie."
    ],
    "en": [
      "The Monts Jura offers the ideal altitude for hiking between 900 and 1723 m. There are marked and maintained trails waiting for you."
    ],
    "it": [
      "Il Monts Jura offre l'altitudine ideale per le escursioni, tra i 900 e i 1723 m. Vi aspettano sentieri ben segnalati e curati."
    ],
    "fr": [
      "Monts Jura offre l'altitude idéale pour randonner entre 900 et 1723 m d'altitude. Des sentiers balisés et entretenus vous attendent."
    ],
    "es": [
      "Los Montes Jura ofrecen una altitud ideal para el senderismo entre 900 y 1723 m. Le esperan senderos bien señalizados y mantenidos."
    ],
