  "rdfs:comment": {
    "de": [
      "Ein intimer Veranstaltungssaal mit 200 Plätzen, ideal, um jede Emotion voll auszuleben! Wir bieten ein reichhaltiges Kulturprogramm mit etwa zehn Aufführungen pro Jahr, die Theater, Musik, Humor und originelle Kreationen miteinander verbinden."
    ],
    "en": [
      "Theatre with seating for 200 people. Several activities available: a cultural season with some ten shows a year and an \"artists in residency\" programme. The theatre can also be used for shows, conferences and debates."
    ],
    "it": [
      "Uno spazio intimo da 200 posti, ideale per vivere appieno ogni emozione! Offriamo un ricco programma culturale, con una decina di spettacoli all'anno che combinano teatro, musica, commedia e creazioni originali."
    ],
    "fr": [
      "Une salle de spectacles intimiste de 200 places, idéale pour vivre pleinement chaque émotion ! Nous proposons une programmation culturelle riche, avec une dizaine de spectacles par an mêlant théâtre, musique, humour et créations originales."
    ],
    "es": [
      "Una sala íntima de 200 plazas, ideal para vivir al máximo todas las emociones Ofrecemos una rica programación cultural, con una decena de espectáculos al año que combinan teatro, música, comedia y creaciones originales."
    ],
    "nl": [
      "Een intieme zaal met 200 zitplaatsen, ideaal om elke emotie ten volle te beleven! We bieden een rijk cultureel programma, met ongeveer tien voorstellingen per jaar waarin theater, muziek, komedie en originele creaties worden gecombineerd."
    ]
  },
  "rdfs:label": {
