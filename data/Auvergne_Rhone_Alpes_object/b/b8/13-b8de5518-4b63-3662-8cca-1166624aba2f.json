  "rdfs:comment": {
    "de": [
      "Der Green Triathlon des Balcons du Dauphiné kehrt mit einem Familien- und Sportprogramm zurück. Fünf Tage lang können Groß und Klein in den Triathlonsport hineinschnuppern.  Seien Sie außerdem bei den Meisterschaften der Liga Auvergne Rhône-Alpes und der französischen Militärmeisterschaft dabei."
    ],
    "en": [
      "The Balcons du Dauphiné Green Triathlon is back with a family and sports program. For five days, young and old alike can try their hand at triathlon.  Come and watch the Auvergne Rhône-Alpes league and French military championships."
    ],
    "it": [
      "Il Balcons du Dauphiné Green Triathlon torna con un programma sportivo e familiare. Per cinque giorni, grandi e piccini potranno cimentarsi nel triathlon.  Venite a vedere i campionati di lega Auvergne Rhône-Alpes e i campionati militari francesi."
    ],
    "fr": [
      "Le Green Triathlon des Balcons du Dauphiné revient avec un programme familial et sportif. Pendant cinq jours, petits et grands peuvent s'initier au triathlon.  Venez assister également aux championnats de ligue Auvergne Rhône-Alpes et de France militaire."
    ],
    "es": [
      "Vuelve el Triatlón Verde Balcons du Dauphiné con un programa familiar y deportivo. Durante cinco días, grandes y pequeños podrán probar el triatlón.  Venga a ver los campeonatos de la liga Auvergne Rhône-Alpes y los campeonatos militares franceses."
    ],
    "nl": [
      "De Balcons du Dauphiné Green Triathlon is terug met een familie- en sportief programma. Vijf dagen lang kunnen jong en oud zich wagen aan triatlon.  Kom kijken naar de competitiekampioenschappen van de Auvergne Rhône-Alpes en de Franse militaire kampioenschappen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Green Triathlon des Balcons du Dauphiné - 4e édition"
    ]
  },
