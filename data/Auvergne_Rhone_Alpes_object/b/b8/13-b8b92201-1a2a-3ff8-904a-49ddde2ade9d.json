  "rdfs:comment": {
    "de": [
      "Seit 1969 ist LS Lanches Sport Ihre lokale Referenz für den Verleih, den Verkauf und die Wartung von Skiern und Fahrrädern, die für alle Niveaus geeignet sind."
    ],
    "en": [
      "Since 1969, LS Lanches Sport has been your local reference for the rental, sale and maintenance of skis and bikes for all levels."
    ],
    "it": [
      "Dal 1969, LS Lanches Sport è il vostro riferimento locale per il noleggio, la vendita e la manutenzione di sci e biciclette per tutti i livelli."
    ],
    "fr": [
      "Depuis 1969, LS Lanches Sport est votre référence locale pour la location, la vente et l’entretien de skis et de vélos adaptés à tous les niveaux."
    ],
    "nl": [
      "Sinds 1969 is LS Lanches Sport uw plaatselijke referentie voor de verhuur, verkoop en het onderhoud van ski's en fietsen voor alle niveaus."
    ],
    "es": [
      "Desde 1969, LS Lanches Sport es su referencia local para el alquiler, la venta y el mantenimiento de esquís y bicicletas para todos los niveles."
    ]
  },
