  "rdfs:comment": {
    "de": [
      "Handgebrautes Bier, das mit Holzfeuer gebraut wird, mit lokalen Zutaten und wild gesammelten Pflanzen für historisch inspirierte Rezepte und originelle Kreationen!"
    ],
    "en": [
      "Historic infused beers, with foraged ingredients, but not only."
    ],
    "it": [
