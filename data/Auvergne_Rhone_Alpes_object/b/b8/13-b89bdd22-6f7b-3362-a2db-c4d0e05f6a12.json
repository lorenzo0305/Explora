  "rdfs:comment": {
    "de": [
      "Jeden Freitag- und Samstagabend verwandelt sich das Samsonnet in eine Stimmungsbar: Funk, Salsa, Disco, 80er und 2000er Jahre... hier gibt es alles, was man braucht, um einen schönen Abend zu verbringen."
    ],
    "en": [
      "Every Friday and Saturday night, Samsonnet transforms itself into an atmospheric bar: funk, salsa, disco, 80s and 2000s... there's everything you need for a great night out."
    ],
    "it": [
      "Ogni venerdì e sabato sera, il Samsonnet si trasforma in un bar d'atmosfera: funk, salsa, disco, anni '80 e 2000... c'è tutto quello che serve per una grande serata."
    ],
    "fr": [
      "Tous les vendredis et samedis soirs, le Samsonnet se transforme en bar à ambiance: funk, salsa, disco, années 80/ 2000... il y a tout ce qu'il faut pour passer une bonne soirée."
    ],
    "es": [
      "Todos los viernes y sábados por la noche, Samsonnet se transforma en un bar de ambiente: funk, salsa, disco, años 80 y 2000... hay de todo para pasar una gran noche."
    ],
    "nl": [
      "Elke vrijdag- en zaterdagavond verandert Samsonnet in een sfeervolle bar: funk, salsa, disco, jaren 80 en 2000... er is alles wat je nodig hebt voor een geweldige avond uit."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirées ambiance musicale funk, salsa, disco, années 80"
    ]
  },
