  "rdfs:comment": {
    "de": [
      "Diese Skulptur vermittelt eine universelle Botschaft, die den leidenden Völkern der Welt gewidmet ist, die sich mit ihrem Mut den Prüfungen der Geschichte widersetzen."
    ],
    "en": [
      "This sculpture delivers a universal message, dedicated to the suffering peoples of the world, who resist the trials of history through their courage."
    ],
    "it": [
      "Questa scultura trasmette un messaggio universale, dedicato ai popoli sofferenti del mondo che resistono alle prove della storia con il loro coraggio."
    ],
    "fr": [
      "Cette sculpture délivre un message universel, dédié aux peuples qui souffrent de par le monde et qui résistent par leur courage aux épreuves de l’histoire."
    ],
    "es": [
      "Esta escultura transmite un mensaje universal, dedicado a los pueblos sufrientes del mundo que resisten con su valor las pruebas de la historia."
    ],
    "nl": [
      "Deze sculptuur brengt een universele boodschap, opgedragen aan de lijdende volkeren van de wereld, die met hun moed weerstand bieden aan de beproevingen van de geschiedenis."
    ]
  },
  "rdfs:label": {
    "fr": [
