  "rdfs:comment": {
    "de": [
      "Als Schöpferin vergänglicher Kompositionen auf pflanzlicher Basis lädt Léa durch Herbar-Workshops und Werke, die die Schönheit natürlicher Details feiern, zur Kontemplation ein. Jede Sammlung wird zu einem poetischen Werk und einer Hommage an die Natur."
    ],
    "en": [
      "Creator of ephemeral compositions based on plants, Léa invites contemplation through herbarium workshops and works celebrating the beauty of natural detail. Each collection becomes a poetic work and a tribute to nature."
    ],
    "it": [
      "Creatrice di composizioni effimere a base vegetale, Léa invita alla contemplazione attraverso laboratori di erbario e opere che celebrano la bellezza dei dettagli naturali. Ogni collezione diventa un'opera d'arte poetica e un omaggio alla natura."
    ],
    "fr": [
      "Créatrice de compositions éphémères à base de végétaux, Léa invite à la contemplation à travers des ateliers herbier et des œuvres célébrant la beauté du détail naturel. Chaque collecte devient une œuvre poétique et un hommage à la nature."
    ],
    "nl": [
      "Léa creëert kortstondige plantaardige composities en nodigt uit tot contemplatie door middel van herbariumworkshops en werken die de schoonheid van natuurlijke details vieren. Elke collectie wordt een poëtisch kunstwerk en een eerbetoon aan de natuur."
    ],
    "es": [
      "Creadora de composiciones efímeras a base de plantas, Léa invita a la contemplación a través de talleres de herbario y obras que celebran la belleza de los detalles naturales. Cada colección se convierte en una obra de arte poética y un homenaje a la naturaleza."
    ]
  },
  "rdfs:label": {
