  "rdfs:comment": {
    "de": [
      "Bistronomisches Restaurant. Feinschmeckerküche mit lokalen, frischen Bio- und/oder Bauernprodukten und/oder nachhaltiger Landwirtschaft. Wir bieten auch ein Menü aus 100 % pflanzlichen Zutaten an. Schattige Terrasse. Maître Restaurateur, Labels: Vegoresto, Verantwortungsvoller Tourismus."
    ],
    "en": [
      "Gourmet bistro-style restaurant serving delicious dishes made using local and fresh products that are organic and/or farm-grown, and/or from reasonable farming practices. We also have a 100% plant-based menu. Shaded terrace. Chef with the 'Maître Restaurateur' title. Labels: Vegoresto."
    ],
    "it": [
      "Ristorante bistronomico. Cucina gourmet con prodotti locali, biologici e/o freschi di fattoria e/o agricoltura sostenibile. Offriamo anche un menu 100% vegetale. Terrazza ombreggiata. Maître Restaurateur, etichette: Vegoresto, Turismo responsabile."
    ],
    "fr": [
      "Restaurant bistronomique. Cuisine gourmande avec des produits locaux, frais en Bio et/ou fermier et/ou agriculture raisonnée. Nous proposons également un menu 100% Végétal. Terrasse ombragée. Maître Restaurateur, labels: Vegoresto, Tourisme responsable."
    ],
    "es": [
      "Restaurante bistronómico. Cocina gourmet con productos locales, ecológicos y/o frescos de granja y/o agricultura sostenible. También ofrecemos un menú 100% vegetal. Terraza sombreada. Maître Restaurateur, etiquetas: Vegoresto, Turismo Responsable."
    ],
    "nl": [
      "Bistronomisch restaurant. Een gastronomische keuken met lokale, biologische en/of verse en/of duurzame producten. We bieden ook een 100% plantaardig menu. Schaduwrijk terras. Maître Restaurateur, keurmerken: Vegoresto, Verantwoordelijk Toerisme."
    ]
  },
