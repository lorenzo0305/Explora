  "rdfs:comment": {
    "de": [
      "Von der Spitze des Sessellifts La Ramasse aus, zu Fuß oder auf Skiern, erwarten Sie Berggerichte in einer paradiesischen Umgebung."
    ],
    "en": [
      "Accessible on foot, or on skis, from the top of the la Ramasse chairlift, the restaurant provides local delicacies in a spectacular setting."
    ],
    "it": [
      "Dalla cima della seggiovia Ramasse, a piedi o con gli sci, vi aspettano piatti di montagna in un ambiente paradisiaco."
    ],
    "fr": [
      "Depuis le sommet du télésiège de la Ramasse, à pied ou à ski, des plats montagnards vous attendent dans un cadre paradisiaque."
    ],
    "nl": [
      "Vanaf de top van de stoeltjeslift Ramasse, te voet of op ski's, wachten u berggerechten in een paradijselijke omgeving."
    ],
    "es": [
      "Desde lo alto del telesilla de Ramasse, a pie o esquiando, le esperan platos de montaña en un entorno paradisíaco."
    ]
  },
