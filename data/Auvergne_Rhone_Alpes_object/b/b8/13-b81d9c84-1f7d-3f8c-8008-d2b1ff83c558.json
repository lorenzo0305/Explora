  "rdfs:comment": {
    "de": [
      "4 Hallenplätze und 4 Außenplätze. 4 überdachte Harzplätze im Tenniscenter mit Clubhaus. Die Anlage ist an einen renovierten Bauernhof angebaut, der Gruppen, Seminare und Ferienzentren aufnehmen kann."
    ],
    "en": [
      "4 indoor and 4 outdoor courts. 4 covered resin courts at the tennis center with club house. The structure is adjacent to a renovated farmhouse that can accommodate groups, seminars and vacation centers."
    ],
    "it": [
      "4 campi coperti e 4 campi all'aperto. 4 campi coperti in resina presso il centro tennis con club house. La struttura è adiacente a un casale ristrutturato che può ospitare gruppi, seminari e centri vacanze."
    ],
    "fr": [
      "4 courts couverts et 4 courts extérieurs. 4 courts couverts en résine au centre de tennis avec club house. La structure est accolée à une ferme rénovée pouvant accueillir des groupes, des séminaires, des centres de vacances."
    ],
    "es": [
      "4 pistas cubiertas y 4 al aire libre. 4 pistas cubiertas de resina en el centro de tenis con casa club. La estructura es adyacente a una granja renovada que puede alojar grupos, seminarios y centros de vacaciones."
    ],
    "nl": [
      "4 binnen- en 4 buitenbanen. 4 overdekte harsbanen in het tenniscentrum met clubhuis. De structuur grenst aan een gerenoveerde boerderij die geschikt is voor groepen, seminars en vakantiecentra."
    ]
  },
  "rdfs:label": {
