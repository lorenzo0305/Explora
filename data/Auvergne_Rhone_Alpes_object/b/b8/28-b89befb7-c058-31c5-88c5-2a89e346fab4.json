  "rdfs:comment": {
    "de": [
      "Ein geselliger Besuch und atemberaubende Landschaften mit dem Haus Boucant Thiery, in dem Emmanuel herrscht."
    ],
    "en": [
      "A friendly visit and breathtaking landscapes with the Boucant Thiery house where Emmanuel reigns supreme."
    ],
    "it": [
