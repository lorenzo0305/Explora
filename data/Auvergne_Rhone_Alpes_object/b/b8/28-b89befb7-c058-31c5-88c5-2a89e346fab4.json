        "de": [
          "Ein geselliger Besuch und atemberaubende Landschaften mit dem Haus Boucant Thiery, in dem Emmanuel herrscht."
        ],
        "en": [
          "A friendly visit and breathtaking landscapes with the Boucant Thiery house where Emmanuel reigns supreme."
        ],
        "it": [
          "Una visita amichevole e paesaggi mozzafiato con la casa Boucant Thiery dove Emmanuel regna sovrano."
        ],
        "fr": [
          "Une visite conviviale et des paysages à couper le souffle avec la maison Boucant Thiery où Emmanuel règne en maître."
        ],
        "es": [
          "Una visita agradable y paisajes impresionantes con la casa Boucant Thiery, donde reina Emmanuel."
        ],
        "nl": [
          "Een vriendelijk bezoek en adembenemende landschappen met het huis Boucant Thiery waar Emmanuel heerst."
        ]
