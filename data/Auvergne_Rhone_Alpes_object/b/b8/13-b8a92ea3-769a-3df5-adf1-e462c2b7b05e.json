  "rdfs:comment": {
    "de": [
      "L?Babatchô liegt den ganzen Winter über am Fuße der Skipisten von Bessans und ganz in der Nähe der Langlaufloipen und bietet Ihnen eine kulinarische Pause mit süßen oder herzhaften Speisen."
    ],
    "en": [
      "Set up for the winter at the foot of the Bessans downhill ski slopes and close to the cross-country ski trails, L'Babatchô offers you a gourmet break, savoury or sweet."
    ],
    "it": [
      "Allestito per l'inverno ai piedi delle piste da discesa di Bessans e molto vicino alle piste da sci di fondo, L'Babatchô vi offre una pausa gourmet dolce o salata."
    ],
    "fr": [
      "Installé pour l'hiver au pied des pistes de ski alpin de Bessans et tout près des pistes ski de fond, L’Babatchô vous propose une pause gourmande, salée ou sucrée."
    ],
    "nl": [
      "L'Babatchô, dat voor de winter aan de voet van de skipistes van Bessans en vlakbij de langlaufpistes ligt, biedt u een gastronomische pauze met hartige of zoete gerechten."
    ],
    "es": [
      "Instalado en invierno al pie de las pistas de esquí alpino de Bessans y muy cerca de las pistas de esquí de fondo, L'Babatchô le propone una pausa gastronómica dulce o salada."
    ]
  },
