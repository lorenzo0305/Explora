  "rdfs:comment": {
    "de": [
      "Micro-Folie versammelt die Meisterwerke von 233 nationalen Institutionen und Museen, die in digitaler Form entdeckt werden können. Diese virtuelle Kunstgalerie, die bildende Kunst, darstellende Kunst, Design und Architektur miteinander verbindet, ist ein einzigartiges und spielerisches Kulturangebot."
    ],
    "en": [
      "Micro-Folie brings together the masterpieces of 233 national museums and institutions in digital form. This virtual art gallery, combining visual arts, live performance, design and architecture, is a unique and entertaining cultural offering."
    ],
    "it": [
      "Micro-Folie riunisce i capolavori di 233 musei e istituzioni nazionali in forma digitale. Questa galleria d'arte virtuale, che combina arti visive, spettacoli dal vivo, design e architettura, è un'offerta culturale unica e divertente."
    ],
    "fr": [
      "Micro-Folie rassemble les chefs-d’œuvre de 233 institutions et musées nationaux à découvrir sous forme numérique. Cette galerie d’art virtuelle mêlant arts plastiques, spectacle vivant, design, architecture… est une offre culturelle ludique et unique."
    ],
    "es": [
      "Micro-Folie reúne las obras maestras de 233 museos e instituciones nacionales en formato digital. Esta galería de arte virtual, que combina las artes visuales, las actuaciones en directo, el diseño y la arquitectura, es una oferta cultural divertida y única."
    ],
    "nl": [
      "Micro-Folie brengt de meesterwerken van 233 nationale musea en instellingen samen in digitale vorm. Deze virtuele kunstgalerie, een combinatie van beeldende kunst, live optredens, design en architectuur, is een leuk en uniek cultureel aanbod."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Micro Folie : Le musée numérique"
    ]
  },
