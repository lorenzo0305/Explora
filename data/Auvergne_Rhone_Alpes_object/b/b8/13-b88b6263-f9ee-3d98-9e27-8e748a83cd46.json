  "rdfs:comment": {
    "de": [
      "Am Wochenende des 4. und 5. April 2026 findet die 11. Ausgabe der \"Temps des Chimères\" statt, der Messe für Spiele und Fantasy in Le Puy-en-Velay! 1500 m² spielerische Animationen auf 4 Etagen! Getränke und kleine Snacks sind vor Ort erhältlich."
    ],
    "en": [
      "Join us on the weekend of April 4 & 5, 2026, for the 11th edition of Le Temps des Chimères, Le Puy-en-Velay?s fair for games and the imaginary! 1500 m² of playful entertainment on 4 floors! Refreshments and snacks available on site."
    ],
    "it": [
      "Unitevi a noi nel weekend del 4 e 5 aprile 2026 per l'11° edizione di Le Temps des Chimères, la fiera dei giochi e della fantasia di Le Puy-en-Velay! 1500 m² di attività ludiche su 4 piani! Rinfreschi e snack disponibili in loco."
    ],
    "fr": [
      "Rendez-vous le weekend du 4 & 5 avril 2026 pour la 11e édition du Temps des Chimères, Salon du jeu et de l’imaginaire au Puy-en-Velay ! 1500 m² d'animations ludique sur 4 étages ! Buvette et petite restauration disponibles sur place."
    ],
    "nl": [
      "Kom in het weekend van 4 & 5 april 2026 naar de 11e editie van Le Temps des Chimères, de spellen- en fantasiebeurs in Le Puy-en-Velay! 1500 m² aan leuke activiteiten op 4 verdiepingen! Versnaperingen en snacks ter plaatse verkrijgbaar."
    ],
    "es": [
      "Acompáñenos el fin de semana del 4 y 5 de abril de 2026 en la 11ª edición de Le Temps des Chimères, la feria de juegos y fantasía de Le Puy-en-Velay 1500 m² de actividades lúdicas en 4 plantas Refrescos y tentempiés in situ."
    ]
  },
  "rdfs:label": {
