  "rdfs:comment": {
    "de": [
      "Im Herzen des Viertels Croix-Rousse befindet sich in einem gemütlichen Umfeld eine großzügige, kreative und raffinierte Bistroküche realisiert vom Küchenchef Cédric Blin."
    ],
    "en": [
      "In the heart of the Croix-Rousse district, tuck into the generous, creative and refined bistro cuisine of the Chef Cédric Blin in a warm and friendly setting."
    ],
    "it": [
      "Nel cuore del quartiere della Croix-Rousse, in un ambiente accogliente, una cucina di bistrot, generosa, creativa e raffinata realizzata dallo chef Cédric Blin."
    ],
    "fr": [
      "Au cœur du quartier de la Croix-Rousse, dans un cadre chaleureux, venez savourer une cuisine de bistrot, généreuse, créative et raffinée, réalisée par le Chef, Cédric Blin."
    ],
    "es": [
      "Una cocina generosa, creativa y elegante, realizada por el chef Cédric Blin, en pleno barrio de la Croix-Rousse, en un marco acogedor."
    ],
    "nl": [
      "In het hart van de wijk Croix-Rousse, in een warm kader, kunt u genieten van een genereuze, creatieve en verfijnde bistrokeuken, bereid door chef-kok Cédric Blin."
    ]
  },
