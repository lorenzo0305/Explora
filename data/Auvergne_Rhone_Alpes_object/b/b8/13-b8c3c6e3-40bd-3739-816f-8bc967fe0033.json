  "rdfs:comment": {
    "de": [
      "Dieses Restaurant ist auf \"hochwertiges\" Fleisch spezialisiert, das nach Gewicht verkauft wird. Die angebotenen Beilagen werden aus frischen, lokalen Produkten hergestellt. Alle Gerichte sind \"hausgemacht\"."
    ],
    "en": [
      "This restaurant offers \"high-end\" meat, sold by weight. The proposed accompaniments are made from fresh and local products. All dishes are \"homemade\"."
    ],
    "it": [
      "Questo ristorante è specializzato in carne di prima scelta, venduta a peso. I contorni sono a base di prodotti freschi e locali. Tutti i piatti sono fatti in casa."
    ],
    "fr": [
      "Ce restaurant est spécialisé dans la viande \"haut de gamme\", vendue au poids. Les accompagnements proposés sont réalisés à partir de produits frais et locaux. Tous les plats sont \"faits maison\"."
    ],
    "es": [
      "Este restaurante está especializado en carnes de alta gama, que se venden al peso. Las guarniciones se elaboran con productos frescos y locales. Todos los platos son caseros."
    ],
    "nl": [
      "Dit restaurant is gespecialiseerd in eersteklas vlees dat per gewicht wordt verkocht. De bijgerechten zijn gemaakt van verse, lokale producten. Alle gerechten zijn huisgemaakt."
    ]
  },
