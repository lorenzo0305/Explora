  "rdfs:comment": {
    "de": [
      "Wir stellen ökologische Biokosmetik unter der Bezeichnung Nature et Progrès her. Seifen, Cremes, Balsame und Massageöle mit Pflanzen aus den Bergen und biologischen Inhaltsstoffen.\r\nLaborbesichtigung nach Bestätigung per E-Mail oder SMS."
    ],
    "en": [
      "We manufacture organic and ecological cosmetics under the Nature et Progrès label. SOAPS, CREAMS, BALMS and MASSAGE OILS with mountain plants and organic ingredients.\r\nVisit the lab after confirmation by e-mail or SMS."
    ],
    "it": [
      "Produciamo cosmetici ecologici biologici con il marchio Nature et Progrès. Saponi, creme, saponette e oli da massaggio a base di piante di montagna e ingredienti biologici.\r\nVisita del laboratorio dopo conferma via e-mail o SMS."
    ],
    "fr": [
      "Nous fabriquons des cosmétiques Bio Ecologiques sous mention Nature et Progrès. SAVONS, CREMES, BAUMES et HUILES DE MASSAGE aux plantes de montagne et aux ingrédients biologiques.\r\nVisite du labo après confirmation mail ou SMS."
    ],
    "nl": [
      "Wij produceren biologische en ecologische cosmetica onder het label Nature et Progrès. Zepen, Crèmes, ZADEN en MASSAGE OLIËN gemaakt van bergplanten en biologische ingrediënten.\r\nBezoek aan het lab na bevestiging per e-mail of sms."
    ],
    "es": [
      "Fabricamos cosméticos ecológicos orgánicos bajo la etiqueta Nature et Progrès. JABONES, CREMAS, JABONES y ACEITES DE MASAJE elaborados con plantas de montaña e ingredientes ecológicos.\r\nVisita del laboratorio previa confirmación por correo electrónico o SMS."
    ]
  },
  "rdfs:label": {
