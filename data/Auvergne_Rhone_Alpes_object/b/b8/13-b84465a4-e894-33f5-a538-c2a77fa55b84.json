  "rdfs:comment": {
    "de": [
      "Joël SAUVANT, der sich für den Ansatz ici.c.local einsetzt, bietet Ihnen in seinen Gärten \"biologisches\" Obst und Gemüse zum Direktverkauf an."
    ],
    "en": [
      "Joël SAUVANT, who is committed to the ici.c.local initiative, sells organic fruit and vegetables direct from his gardens."
    ],
    "it": [
      "Joël SAUVANT, coinvolto nell'approccio ici.c.local, vi offre frutta e verdura \"biologica\" in vendita diretta nei suoi orti."
    ],
    "fr": [
      "Joël SAUVANT, investi dans la démarche ici.c.local, vous propose des fruits et légumes \"bio\" en vente direct  dans ses jardins."
    ],
    "es": [
      "Joël SAUVANT, implicado en el enfoque ici.c.local, le ofrece frutas y verduras \"ecológicas\" para la venta directa en sus huertos."
    ],
    "nl": [
      "Joël SAUVANT, betrokken bij de ici.c.local aanpak, biedt u \"biologisch\" fruit en groenten aan voor directe verkoop in zijn tuinen."
    ]
