  "rdfs:comment": {
    "de": [
      "Lucrèce Andreae wird uns über ihren neuen Comic berichten, der direkt von ihrer eigenen Erfahrung mit der Mutterschaft inspiriert ist. Eine feministische Begegnung ohne Tabus, um gegen die Klischees anzugehen!"
    ],
    "en": [
      "Lucrèce Andreae will be on hand to talk about her new comic strip, directly inspired by her own experience of motherhood. A no-holds-barred feminist encounter to turn clichés on their head!"
    ],
    "it": [
      "Lucrèce Andreae parlerà del suo nuovo fumetto, direttamente ispirato alla sua esperienza di maternità. Un incontro femminista senza esclusione di colpi che va contro i luoghi comuni!"
    ],
    "fr": [
      "Lucrèce Andreae viendra nous parler de sa nouvelle bande dessinée, directement inspirée de sa propre expérience de la maternité. Une rencontre féministe sans tabou pour aller à l'encontre des clichés !"
    ],
    "es": [
      "Lucrèce Andreae nos hablará de su nuevo cómic, inspirado directamente en su propia experiencia de la maternidad. Un encuentro feminista sin tapujos que va en contra de los tópicos"
    ],
    "nl": [
      "Lucrèce Andreae is aanwezig om te praten over haar nieuwe stripverhaal, dat rechtstreeks geïnspireerd is op haar eigen ervaringen met het moederschap. Het is een onverbloemde feministische ontmoeting die tegen de clichés ingaat!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Rencontre dédicace avec Lucrèce Andreae"
    ]
  },
