  "rdfs:comment": {
    "de": [
      "Eine ehemalige Poststation, die zum renovierten Hotel mit Charme wurde, im Zentrum von Lamastre.\r\nNutzen Sie die Sommersaison, um sich im Pool neben dem Garten zu entspannen. Die Zimmer sind komfortabel und geräumig für einen entspannten Aufenthalt."
    ],
    "en": [
      "Charming hotel in Lamastre, Doux valley's heart. Comfortable, spacious rooms with shower, TV, Wi-Fi. Summer pool by garden. 50m from 'Train de l'Ardèche.' Enjoy homemade regional cuisine."
    ],
    "it": [
      "Un'antica locanda per allenatori trasformata in un affascinante hotel ristrutturato nel centro di Lamastre.\r\nApprofittate della stagione estiva per rilassarvi nella piscina vicino al giardino. Le camere sono confortevoli e spaziose per un soggiorno rilassante."
    ],
    "fr": [
      "Un ancien relais de poste devenu hôtel de charme rénové au centre de Lamastre. \r\nProfitez de la saison estivale, pour vous détendre dans la piscine près du jardin. Les chambres sont confortables et spacieuses pour un séjour détente."
    ],
    "nl": [
      "In het hart van Doux-vallei: voormalige herberg nu charmant hotel in Lamastre. Comfortabele kamers met douche, tv, Wi-Fi. Zomerse ontspanning bij het tuinzwembad. Op 50m van \"Train de l'Ardèche\". Geniet van huisgemaakte regionale gerechten."
    ],
    "es": [
      "Antigua posada convertida en encantador hotel renovado en el centro de Lamastre.\r\nAproveche la temporada de verano para relajarse en la piscina junto al jardín. Las habitaciones son cómodas y espaciosas para una estancia relajante."
    ]
  },
