  "rdfs:comment": {
    "de": [
      "Förderbänder für die Industrie\r\nDie zu 100% aus Frankreich stammende Industrie entwickelt und realisiert maßgeschneiderte Lösungen für alle Förderprobleme und den Schutz von Maschinen mit hochpräzisen Materialien."
    ],
    "en": [
      "Industrial conveyors\r\n100% French quality, l'industrie develops and manufactures customized solutions for all conveying and machine protection requirements, using high-precision materials."
    ],
    "it": [
      "Trasportatori industriali\r\n100% qualità francese, l'industrie sviluppa e produce soluzioni su misura per tutti i problemi di trasporto e protezione delle macchine, utilizzando materiali di alta precisione."
    ],
    "fr": [
      "Convoyeurs industriels\r\nDe qualité 100% française, l’industrie développe et réalise des solutions sur-mesure pour toute problématique de convoyage et protection de machines avec des matériaux de haute précision."
    ],
    "es": [
      "Transportadores industriales\r\nCalidad 100% francesa, l'industrie desarrolla y fabrica soluciones a medida para todos los problemas de transporte y protección de máquinas, utilizando materiales de alta precisión."
    ],
    "nl": [
      "Industriële transportbanden\r\n100% Franse kwaliteit, l'industrie ontwikkelt en produceert oplossingen op maat voor alle transport- en machinebeveiligingsproblemen, met gebruik van zeer nauwkeurige materialen."
    ]
  },
