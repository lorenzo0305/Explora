  "rdfs:comment": {
    "de": [
      "Jeden Sommerabend – sowie an bestimmten Wochenenden und Feiertagen im Mai, Juni und September – gibt es auf dem Campingplatz Huttopia Pizzaabend! Ein Familienrezept, mit hausgemachtem Teig und Sauce, vor Ort zubereitet mit frischen Zutaten."
    ],
    "en": [
      "Every summer evening – and on certain weekends and public holidays in May, June, and September – it’s pizza night at the Huttopia campsite! A family recipe, with homemade dough and sauce prepared on-site using fresh ingredients."
    ],
    "it": [
      "Tutte le sere d'estate e alcuni fine settimana e giorni festivi di maggio, giugno e settembre al campeggio Huttopia: serata pizza! Una ricetta di famiglia, impasto e salsa fatti in casa con prodotti freschi."
    ],
    "fr": [
      "Tous les soirs de l'été et certains week-ends et jours fériés de mai, juin et septembre au camping Huttopia : soirée pizza ! Une recette familiale, une pâte et une sauce faites maison sur place avec des produits frais."
    ],
    "es": [
      "Todas las noches de verano y algunos fines de semana y días festivos de mayo, junio y septiembre en el camping Huttopia: ¡noche de pizza! Una receta familiar, masa y salsa caseras elaboradas in situ con productos frescos."
    ],
    "nl": [
      "Elke zomeravond – en op bepaalde weekenden en feestdagen in mei, juni en september – is het pizzafeest op camping Huttopia! Een familierecept, met huisgemaakte deeg en saus, ter plekke bereid met verse ingrediënten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pizzas by Huttopia"
    ],
    "fr": [
      "Les pizzas by Huttopia"
    ]
  },
