  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/157894ec-69c3-36cb-bf01-3ffad7490619",
      "dc:description": {
        "de": [
          "Sportliche Aktivität \"Wohlbefinden\", Muskelaufbau, Körperhaltung?\nvon 11.00 bis 12.00 Uhr.\nAb 16 Jahren mit elterlicher Erlaubnis.\nTreffpunkt an der Strandhütte mit Handtuch oder Matte und Wasser.\nKostenlos."
        ],
        "en": [
          "Well-being\" sports activity, sheathing, posture?\nfrom 11am to 12pm.\nAges 16 and over with parental consent.\nMeet at the beach chalet with your towel or mat, and water.\nFree admission."
        ],
        "it": [
          "Benessere\" attività sportiva, guaina, postura?\ndalle 11.00 alle 12.00.\nA partire dai 16 anni con l'autorizzazione dei genitori.\nRitrovo presso lo chalet della spiaggia con asciugamano o tappetino e acqua.\nIngresso libero."
        ],
        "fr": [
          "Activité Sportive \"Bien-être\", gainage, posture… \nde 11h à 12h. \nA partir de 16 ans avec autorisation parentale. \nRendez-vous au chalet de plage avec votre serviette ou votre tapis, et de l'eau. \nGratuit."
        ],
        "nl": [
          "Welzijn\" sportactiviteit, omhulling, houding?\nvan 11.00 tot 12.00 uur.\nVanaf 16 jaar met toestemming van de ouders.\nVerzamelen bij het strandchalet met handdoek of matje en water.\nGratis toegang."
        ],
        "es": [
          "Bienestar\" actividad deportiva, enfundado, postura?\nde 11h a 12h.\nA partir de 16 años con autorización de los padres.\nReúnase en el chalet de la playa con su toalla o esterilla y agua.\nEntrada gratuita."
        ]
      },
      "@type": [
        "Description"
      ],
