  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b19e519a-e21e-315a-9f54-811842c6d0ec",
      "dc:description": {
        "de": [
          "Bei dieser freien Besichtigung können Sie den Fußstapfen Victor Hugos bei seinem Besuch in Ault am 8. September 1837 folgen. Entdecken Sie die Überreste seines Besuchs und die Hinweise auf den historischen Kontext der Vergangenheit von Ault. Dieser Rundgang besteht aus 11 Stationen mit dreisprachigen Schildern."
        ],
        "en": [
          "This self-guided tour follows in the footsteps of Victor Hugo during his visit to Ault on September 8, 1837. Discover the vestiges of his visit and references to the historical context of Ault's past. The tour comprises 11 stations with trilingual panels."
        ],
        "it": [
          "Questa visita autoguidata segue le orme di Victor Hugo, che giunse ad Ault l'8 settembre 1837. Scoprite i resti della sua visita e il contesto storico del passato di Ault. Il percorso comprende 11 stazioni con segnaletica trilingue."
        ],
        "fr": [
          "Cette visite libre permet de suivre les pas de Victor Hugo lors de sa venue à Ault le 8 septembre 1837. Découvrez les vestiges de son passage et les références au contexte historique du passé Aultois. Ce parcours se compose de 11 stations avec des panneaux trilingues."
        ],
        "es": [
          "Esta visita autoguiada sigue los pasos de Victor Hugo cuando llegó a Ault el 8 de septiembre de 1837. Descubra los vestigios de su visita y el contexto histórico del pasado de Ault. El recorrido consta de 11 estaciones con señalización trilingüe."
        ],
        "nl": [
          "Deze rondleiding volgt de voetsporen van Victor Hugo toen hij op 8 september 1837 naar Ault kwam. Ontdek de overblijfselen van zijn bezoek en de historische context van het verleden van Ault. De rondleiding bestaat uit 11 stations met drietalige borden."
        ]
      },
