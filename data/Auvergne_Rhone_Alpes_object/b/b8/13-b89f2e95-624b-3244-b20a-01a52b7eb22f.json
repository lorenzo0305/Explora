  "rdfs:comment": {
    "de": [
      "Wasserläufe von Amourette, Ebron, Vanne, Bach von Cordéac, Bach von Lalley und Nebenflüsse und Bach von Saint Sébastien. In diesem Sektor sind Fischereischutzgebiete vorhanden."
    ],
    "en": [
      "Amourette, Ebron, Vanne, Cordéac brook, Lalley brook and tributaries and Saint Sébastien brook. Fishing reserves are present in this sector."
    ],
    "it": [
      "L'Amourette, l'Ebron, la Vanne, il torrente Cordéac, il torrente Lalley e i suoi affluenti e il torrente Saint Sébastien. In questo settore sono presenti riserve di pesca."
    ],
    "fr": [
      "Cours d'eau de l'Amourette, l'Ebron, la Vanne, le ruisseau de Cordéac, le ruisseau de Lalley et affluents et le ruisseau de Saint Sébastien. Des réserves de pêche sont présentes sur ce secteur."
    ],
    "es": [
      "El Amourette, el Ebron, el Vanne, el arroyo Cordéac, el arroyo Lalley y sus afluentes y el arroyo Saint Sébastien. Las reservas de pesca están presentes en este sector."
    ],
    "nl": [
      "De beken Amourette, Ebron, Vanne, Cordéac, Lalley en zijrivieren en de Saint Sébastien. In deze sector zijn visreserves aanwezig."
    ]
  },
