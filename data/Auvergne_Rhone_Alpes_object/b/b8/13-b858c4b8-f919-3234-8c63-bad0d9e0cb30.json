  "rdfs:comment": {
    "de": [
      "Bio-Bauernhof in Saint-Antoine-l'Abbaye, der Grenoble-Nüsse, Haselnüsse, Äpfel und Spargel produziert. Direktverkauf ab Hof und Empfang von Wohnmobilen in einer natürlichen Umgebung am Fuße des Vercors."
    ],
    "en": [
      "Organic farm in Saint-Antoine-l?Abbaye producing walnuts, hazelnuts, apples and asparagus. Direct farm sales and motorhome reception in a natural setting at the foot of the Vercors."
    ],
    "it": [
      "Azienda agricola biologica a Saint-Antoine-l'Abbaye che produce noci, nocciole, mele e asparagi. Vendita diretta in fattoria e accoglienza camper in un ambiente naturale ai piedi del Vercors."
    ],
    "fr": [
      "Ferme bio à Saint-Antoine-l’Abbaye produisant Noix de Grenoble, Noisettes, Pommes et Asperges. Vente directe à la ferme et accueil de camping-cars dans un cadre naturel au pied du Vercors."
    ],
    "es": [
      "Granja ecológica en Saint-Antoine-l'Abbaye que produce nueces, avellanas, manzanas y espárragos. Venta directa en la granja y recepción de autocaravanas en un entorno natural al pie del Vercors."
    ],
    "nl": [
      "Biologische boerderij in Saint-Antoine-l'Abbaye die walnoten, hazelnoten, appels en asperges produceert. Directe verkoop op de boerderij en ontvangst van campers in een natuurlijke omgeving aan de voet van de Vercors."
    ]
  },
  "rdfs:label": {
