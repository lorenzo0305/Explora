  "rdfs:comment": {
    "de": [
      "Bar, Restaurant, Grill, Cocktails und Eisbecher: Nur wenige Schritte vom Zentrum von Vallon-Pont-d'Arc entfernt, entdecken Sie einen ruhigen und harmonischen Ort. Gepflegte Küche, offene oder überdachte Terrasse und ein Team, das sich freut, Sie mit einem Lächeln zu empfangen!"
    ],
    "en": [
      "Bar, Restaurant, Grill, Cocktails and ice cream sundaes: just a stone's throw from the center of Vallon-Pont-d'Arc, discover a calm, harmonious setting. Meticulous cuisine, open or covered terrace, and a team happy to welcome you with a smile!"
    ],
    "it": [
      "Bar, ristorante, grill, cocktail e gelati: a due passi dal centro di Vallon-Pont-d'Arc, scoprite un ambiente tranquillo e armonioso. Cucina accurata, terrazza aperta o coperta e un team felice di accogliervi con un sorriso!"
    ],
    "fr": [
      "Bar, Restaurant, Grill, Cocktails et coupes de glaces : A deux pas du centre de Vallon-Pont-d’Arc, découvrez un lieu calme et harmonieux. Cuisine soignée, terrasse ouverte ou couverte, et une équipe heureuse de vous accueillir avec le sourire !"
    ],
    "es": [
      "Bar, restaurante, parrilla, cócteles y helados: a dos pasos del centro de Vallon-Pont-d'Arc, descubra un marco tranquilo y armonioso. Cocina cuidada, terraza cubierta o descubierta y un equipo encantado de recibirle con una sonrisa"
    ],
    "nl": [
      "Bar, Restaurant, Grill, Cocktails and Ice Cream Sundaes: Just steps from the center of Vallon-Pont-d’Arc, discover a calm and harmonious setting. Enjoy refined cuisine, an open or covered terrace, and a team happy to welcome you with a smile!"
    ]
  },
  "rdfs:label": {
