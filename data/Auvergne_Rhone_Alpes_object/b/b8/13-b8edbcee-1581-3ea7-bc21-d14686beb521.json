  "rdfs:comment": {
    "de": [
      "Sie möchten eine Tagung oder ein Seminar organisieren? Das Hôtel Côté Sud Léman freut sich, Ihnen zwei Räume in seinem Haus anbieten zu können, die je nach Budget individuelle Dienstleistungen bieten."
    ],
    "en": [
      "Are you planning a meeting or seminar? The Hôtel Côté Sud Léman is delighted to offer you two rooms on its premises, with personalized services to suit your budget."
    ],
    "it": [
      "Volete organizzare una riunione o un seminario? L'Hôtel Côté Sud Léman è lieto di offrirvi due sale all'interno della sua struttura, con servizi personalizzati in base al vostro budget."
    ],
    "fr": [
      "Vous souhaitez organiser une réunion ou un séminaire ? L'Hôtel Côté Sud Léman est ravi de vous proposer deux salles au sein de son établissement, offrant des services personnalisés en fonction de votre budget."
    ],
    "es": [
      "¿Desea organizar una reunión o un seminario? El Hôtel Côté Sud Léman se complace en ofrecerle dos salas dentro de su establecimiento, con servicios personalizados que se adaptan a su presupuesto."
    ],
    "nl": [
      "Wilt u een vergadering of seminar organiseren? Hôtel Côté Sud Léman biedt u met veel plezier twee zalen in zijn etablissement, met gepersonaliseerde diensten die passen bij uw budget."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Location salle de séminaire - Hôtel Côté Sud Léman"
    ]
  },
