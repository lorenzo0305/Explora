  "rdfs:comment": {
    "de": [
      "Arnaud, ein diplomierter Bergführer und Lehrer, bietet Ihnen Mountainbike-Touren auf den Albiez, Fat Bike im Winter, Draisienne-, Biclou- oder Biker-Kurse, um Kindern das Radfahren in den Bergen näher zu bringen oder zu vertiefen, sowie Lasergewehrschießen."
    ],
    "en": [
      "Arnaud, a qualified guide and instructor, offers VTTAE rides in the Albiez, Draisienne, Biclou or Biker courses to help children (aged 3 and over) discover or improve their mountain biking skills, as well as laser rifle shooting."
    ],
    "it": [
      "Arnaud, guida e istruttore qualificato, propone tour in mountain bike dell'Albiez, fat bike in inverno, corsi Draisienne, Biclou o Biker per aiutare i bambini a scoprire o migliorare le loro abilità in mountain bike, e tiro con fucile laser."
    ],
    "fr": [
      "Arnaud, guide moniteur diplômé, vous propose des randonnées en VTTAE sur les Albiez, du Fat bike en hiver, des stages Draisienne, Biclou ou Biker pour faire découvrir ou approfondir le vélo en montagne aux enfants, ainsi que du Tir à la carabine laser."
    ],
    "es": [
      "Arnaud, guía e instructor cualificado, ofrece recorridos en bicicleta de montaña por el Albiez, fat bike en invierno, cursos de Draisienne, Biclou o Biker para que los niños descubran o mejoren sus habilidades con la bicicleta de montaña, y tiro con rifle láser."
    ],
    "nl": [
      "Arnaud, een gediplomeerde gids en instructeur, biedt mountainbiketochten door de Albiez, fatbiking in de winter, Draisienne, Biclou of Biker cursussen om kinderen te helpen hun mountainbikevaardigheden te ontdekken of te verbeteren, en lasergeweer schieten."
    ]
  },
