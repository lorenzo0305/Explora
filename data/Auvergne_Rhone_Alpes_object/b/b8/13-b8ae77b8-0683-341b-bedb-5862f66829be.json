  "rdfs:comment": {
    "de": [
      "Yzeron Évasion, Ihre Wellness-Auszeit im Herzen der Monts du Lyonnais. Ein gemütliches Spa, in dem Entspannung, Gesichtsbehandlungen, Massagen nach Maß und Rituale der Flucht aufeinander abgestimmt sind, um Ihnen einen Moment des Loslassens zu schenken."
    ],
    "en": [
      "Yzeron Évasion, your wellness break in the heart of the Monts du Lyonnais. A welcoming spa where relaxation, facials, customized massages and escape rituals combine to offer a genuine moment of letting go."
    ],
    "it": [
      "Yzeron Évasion, la vostra pausa di benessere nel cuore dei Monts du Lyonnais. Una spa calda e accogliente dove relax, trattamenti per il viso, massaggi su misura e rituali di evasione si fondono per offrire un vero e proprio momento di abbandono."
    ],
    "fr": [
      "Yzeron Évasion, votre parenthèse bien-être au cœur des Monts du Lyonnais. Un spa chaleureux où détente, soins visage, massages sur mesure et rituels d’évasion s’harmonisent pour offrir un véritable moment de lâcher-prise."
    ],
    "es": [
      "Yzeron Évasion, su escapada de bienestar en el corazón de los Montes del Lyonnais. Un spa cálido y acogedor donde la relajación, los tratamientos faciales, los masajes a medida y los rituales de evasión se unen para ofrecerle un auténtico momento de dejarse llevar."
    ],
    "nl": [
      "Yzeron Évasion, een wellnessvakantie in het hart van de Monts du Lyonnais. Een gastvrije spa waar ontspanning, gezichtsbehandelingen, massages op maat en ontsnappingsrituelen samenkomen om een echt moment van ontspanning te bieden."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Yzeron Evasion"
    ]
  },
