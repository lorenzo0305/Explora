  "rdfs:comment": {
    "de": [
      "Die Gemeinde Saint-Gervais stellt Künstlern, die ihre Werke ausstellen möchten, den Saal Géo Dorival im Stadtzentrum zur Verfügung."
    ],
    "en": [
      "The commune of Saint-Gervais makes the Salle Géo Dorival, located in the town center, available to artists wishing to exhibit their work."
    ],
    "it": [
      "Il comune di Saint-Gervais mette a disposizione degli artisti che desiderano esporre le proprie opere la Salle Géo Dorival, situata nel centro della città."
    ],
    "fr": [
      "La commune de Saint-Gervais met à disposition des artistes souhaitant exposer leurs œuvres, la salle Géo Dorival, située dans le centre-ville."
    ],
    "es": [
      "El municipio de Saint-Gervais pone la Sala Géo Dorival, situada en el centro de la ciudad, a disposición de los artistas que deseen exponer sus obras."
    ],
    "nl": [
      "De gemeente Saint-Gervais stelt de Salle Géo Dorival, gelegen in het stadscentrum, ter beschikking van kunstenaars die hun werk willen tentoonstellen."
    ]
  },
