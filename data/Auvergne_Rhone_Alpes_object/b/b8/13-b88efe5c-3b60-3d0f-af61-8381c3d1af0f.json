  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Trianon bietet ausgewogene, schmackhafte Gerichte und hausgemachte Desserts. Seine Terrasse mit Blick auf den Parc des Thermes macht es zu einem Ort, der zum Entspannen einlädt."
    ],
    "en": [
      "Le Trianon restaurant serves healthy, tasty dishes and home-made desserts. Its terrace overlooking the Parc des Thermes makes it an ideal place to relax."
    ],
    "it": [
      "Il ristorante Le Trianon serve piatti equilibrati e gustosi e dessert fatti in casa. La sua terrazza con vista sul Parc des Thermes lo rende un luogo ideale per rilassarsi."
    ],
    "fr": [
      "Le Restaurant Le Trianon propose des plats équilibrés, savoureux et des desserts maison. Sa terrasse avec vue sur le Parc des thermes en fait un lieu propice à la détente."
    ],
    "nl": [
      "Restaurant Le Trianon serveert gezonde, smakelijke gerechten en zelfgemaakte desserts. Het terras met uitzicht op het Parc des Thermes maakt het een ideale plek om te ontspannen."
    ],
    "es": [
      "El restaurante Le Trianon sirve platos equilibrados y sabrosos y postres caseros. Su terraza con vistas al Parc des Thermes lo convierte en un lugar ideal para relajarse."
    ]
  },
