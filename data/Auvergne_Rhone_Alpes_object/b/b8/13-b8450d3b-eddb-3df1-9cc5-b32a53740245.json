  "rdfs:comment": {
    "de": [
      "Entdecken Sie mithilfe der Baludik-App Yssingeaux und seine Geschichte, indem Sie den Hähnen der \"Flâneries yssingelaises\" folgen! Ein spielerischer Rundgang auf den Spuren der fünf Wahrzeichen der Stadt."
    ],
    "en": [
      "Using the Baludik app, discover Yssingeaux and its history by following the roosters on the \"Flâneries yssingelaises\"! A fun tour following in the footsteps of the town's five emblems."
    ],
    "it": [
      "Utilizzate l'app Baludik per scoprire Yssingeaux e la sua storia seguendo i galli delle \"Flâneries yssingelaises\"! È un modo divertente per seguire le orme dei cinque emblemi della città."
    ],
    "fr": [
      "A l'aide de l'application Baludik, découvrez Yssingeaux et son histoire en suivant les coqs des \"Flâneries yssingelaises\" ! Une visite ludique à la trace des cinq emblèmes de la ville."
    ],
    "nl": [
      "Gebruik de Baludik-app om Yssingeaux en zijn geschiedenis te ontdekken door de hanen op de \"Flâneries yssingelaises\" te volgen! Het is een leuke manier om in de voetsporen te treden van de vijf emblemen van de stad."
    ],
    "es": [
      "Con la aplicación Baludik, descubra Yssingeaux y su historia siguiendo a los gallos de las \"Flâneries yssingelaises\" Es una forma divertida de seguir los pasos de los cinco emblemas de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Des empreintes dans la ville"
    ]
  },
