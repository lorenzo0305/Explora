  "rdfs:comment": {
    "de": [
      "Die Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors unterstützt die Feuerwehrleute und ihre Familien, organisiert Veranstaltungen zur Förderung des Zusammenhalts, schärft das Sicherheitsbewusstsein der Bevölkerung und sammelt Geld, um die Ausrüstung zu verbessern und ihren Einsatz zu würdigen."
    ],
    "en": [
      "The Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors supports firefighters and their families, organizes cohesion events, raises safety awareness and raises funds to improve equipment and honor their commitment."
    ],
    "it": [
      "L'Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors sostiene i vigili del fuoco e le loro famiglie, organizza eventi di team building, sensibilizza l'opinione pubblica sui temi della sicurezza e raccoglie fondi per migliorare le attrezzature e onorare il loro impegno."
    ],
    "fr": [
      "L'Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors soutient les pompiers et leurs familles, organise des événements de cohésion, sensibilise la population à la sécurité et collecte des fonds pour améliorer l'équipement et honorer leur engagement."
    ],
    "es": [
      "La Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors apoya a los bomberos y a sus familias, organiza actividades para fomentar el espíritu de equipo, sensibiliza a la opinión pública sobre cuestiones de seguridad y recauda fondos para mejorar los equipos y honrar su compromiso."
    ],
    "nl": [
      "De Amicale des Sapeurs-Pompiers de Vassieux-en-Vercors steunt brandweerlieden en hun gezinnen, organiseert teambuildingevenementen, maakt het publiek bewust van veiligheidskwesties en zamelt geld in om hun uitrusting te verbeteren en hun inzet te eren."
    ]
  },
  "rdfs:label": {
