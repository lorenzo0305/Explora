  "rdfs:comment": {
    "de": [
      "Entlang des Madonnensees gibt es zehn Stationen, an denen Sie mit der ganzen Familie Sport treiben können! Vor Ort finden Sie außerdem ein Arboretum, einen Spielplatz und Picknicktische."
    ],
    "en": [
      "Along the Madonna Lake, ten stations are set up for family sports! On site, you will also find an arboretum, a playground and picnic tables."
    ],
    "it": [
      "Lungo il lago della Madonna sono state allestite dieci postazioni per lo sport in famiglia! Sono presenti anche un arboreto, un parco giochi e tavoli da picnic."
    ],
    "fr": [
      "Le long du lac de la Madone, dix stations sont disposées pour faire du sport en famille ! Sur place, vous trouverez également un arboretum, une aire de jeux et des tables de pique-nique."
    ],
    "nl": [
      "Langs het Madonna meer zijn tien stations ingericht voor familiesporten! Er is ook een arboretum, een speeltuin en picknicktafels."
    ],
    "es": [
      "A lo largo del lago Madonna, se han instalado diez estaciones para practicar deporte en familia También hay un arboreto, un parque infantil y mesas de picnic."
    ]
