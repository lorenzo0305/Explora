  "rdfs:comment": {
    "de": [
      "Haben Sie sich schon einmal gefragt, was Kinder sehen? Können Sie das Werk erkennen, das sie Ihnen beschreiben? Eine Animation für Groß und Klein (mindestens 1 Erwachsener + 1 Kind)."
    ],
    "en": [
      "Have you ever wondered what children see? Can you recognize the work they're describing? An activity for young and old alike (minimum 1 adult + 1 child)."
    ],
    "it": [
      "Vi siete mai chiesti cosa vedono i bambini? Sarete in grado di riconoscere i lavori che descrivono? Un'attività per grandi e piccini (minimo 1 adulto + 1 bambino)."
    ],
    "fr": [
      "Vous êtes-vous déjà demandé ce que voient les enfants ? Saurez-vous reconnaître l’œuvre qu'ils vous décrivent ? Une animation à partager entre petits et grands (minimum 1 adulte + 1 enfant)."
    ],
    "es": [
      "¿Se ha preguntado alguna vez qué ven los niños? ¿Serías capaz de reconocer las obras que describen? Una actividad para grandes y pequeños (mínimo 1 adulto + 1 niño)."
    ],
    "nl": [
      "Heb je je ooit afgevraagd wat kinderen zien? Kun je het werk dat ze beschrijven herkennen? Een activiteit voor jong en oud (minimaal 1 volwassene + 1 kind)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Animation : Prête-moi tes yeux"
    ]
  },
