  "rdfs:comment": {
    "de": [
      "Produzent von Saint-Joseph, Condrieu und IGP des Collines Rhodaniennes weiß und rot auf einem 12 ha großen Weingut, wo der ehemalige Bauernhof der Familie renoviert und in einen Weinkeller umgewandelt wurde. Besichtigung der Weinkeller möglich."
    ],
    "en": [
      "Producer of Saint-Joseph, Condrieu and IGP des Collines Rhodaniennes white and red wines on a 12-hectare vineyard, where the old family farmhouse has been renovated and converted into a winery. Cellar tours available."
    ],
    "it": [
      "Produttore di Saint-Joseph, Condrieu e bianco e rosso IGP des Collines Rhodaniennes in una tenuta di 12 ettari di vigneto, dove l'antica casa colonica di famiglia è stata ristrutturata e trasformata in cantina. Sono disponibili visite alle cantine."
    ],
    "fr": [
      "Producteur de Saint-Joseph, Condrieu et d'IGP des Collines Rhodaniennes blanc et rouge sur un domaine de 12ha de vignes, où l'ancienne ferme familiale à été rénovée et transformée en cave. Visite des chais possible."
    ],
    "es": [
      "Productor de vinos blancos y tintos de Saint-Joseph, Condrieu e IGP des Collines Rhodaniennes en una finca de 12 ha de viñedos, donde la antigua granja familiar ha sido renovada y convertida en bodega. Posibilidad de visitar las bodegas."
    ],
    "nl": [
      "Producent van Saint-Joseph, Condrieu en witte en rode IGP des Collines Rhodaniennes op een domein van 12ha wijngaarden, waar de oude familieboerderij is gerenoveerd en omgebouwd tot kelder. Rondleidingen door de kelders zijn mogelijk."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Domaine Romain D'Aniello"
    ]
  },
