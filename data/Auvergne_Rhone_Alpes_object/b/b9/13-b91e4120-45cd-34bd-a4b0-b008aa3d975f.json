  "rdfs:comment": {
    "de": [
      "Die Auberge de la Providence liegt im malerischen Dorf Saint-Donat und ist ein ruhiges, familiengeführtes Gasthaus mit komfortablen Zimmern."
    ],
    "en": [
      "Located in the picturesque village of Saint-Donat, the Auberge de la Providence is a quiet, family-run inn with comfortable rooms."
    ],
    "it": [
