  "rdfs:comment": {
    "de": [
      "Haut-Bugey Tourisme bietet Ihnen in seiner Boutique eine Auswahl an lokalen Produkten, made in Haut-Bugey, an. Hier finden Sie lokale Spezialitäten (Quenelles sauce Nantua), in Haut-Bugey hergestellte handwerkliche Gegenstände sowie eine Buchabteilung."
    ],
    "en": [
      "Haut-Bugey Tourisme's store offers a selection of local products, made in Haut-Bugey. You'll find local specialities (quenelles with Nantua sauce), handicrafts made in Haut-Bugey and a bookshop."
    ],
    "it": [
      "Haut-Bugey Tourisme vi offre, nel suo negozio, una selezione di prodotti locali, realizzati nell'Haut-Bugey. Troverete specialità locali (quenelles con salsa Nantua), oggetti di artigianato prodotti nell'Haut-Bugey e una libreria."
    ],
    "fr": [
      "Haut-Bugey Tourisme vous propose, dans sa boutique, une sélection de produits locaux, made in Haut-Bugey. Vous y trouverez des spécialités locales (quenelles sauce Nantua), des objets artisanaux fabriqués dans le Haut-Bugey ainsi qu'un rayon librairie."
    ],
    "es": [
      "Haut-Bugey Tourisme le ofrece, en su tienda, una selección de productos locales, hechos en Haut-Bugey. Encontrará especialidades locales (quenelles con salsa Nantua), artesanía hecha en el Haut-Bugey y una librería."
    ],
    "nl": [
      "Haut-Bugey Tourisme biedt u in zijn winkel een selectie van lokale producten, gemaakt in Haut-Bugey. U vindt er plaatselijke specialiteiten (quenelles met Nantua-saus), handwerk van Haut-Bugey en een boekhandel."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boutique de Haut-Bugey Tourisme"
    ]
  },
