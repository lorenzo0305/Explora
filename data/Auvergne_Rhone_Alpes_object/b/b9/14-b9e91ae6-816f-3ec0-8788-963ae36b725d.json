  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ab05420-3734-3812-acfb-9afcf88e2c38",
      "dc:description": {
        "de": [
          "62Ways oder einfach 62W zeichnet sich durch seine bunten Farbtöne, seine weichen und bequemen Materialien aus. Eine Marke für Qualitätskleidung, die von Designern der Côte d'Opale entworfen wurde.\nOnline-Verkauf"
        ],
        "en": [
          "62Ways, simply 62W, stands out for its colorful tones and soft, comfortable fabrics. A brand of quality clothing imagined by designers from the Côte d'Opale.\nOnline sales"
        ],
        "it": [
          "62Ways, semplicemente 62W, si distingue per le sue tonalità colorate e i suoi tessuti morbidi e confortevoli. Un marchio di abbigliamento di qualità creato da stilisti della Côte d'Opale.\nVendite online"
        ],
        "fr": [
          "62Ways plus simplement 62W se distingue par ses tons colorés, ses matières douces et confortables. Une marque de vêtements de qualité imaginée par des créateurs de la Côte d'Opale.\nVente en ligne"
        ],
        "es": [
          "62Ways, simplemente 62W, destaca por sus tonos coloridos y sus tejidos suaves y cómodos. Una marca de ropa de calidad creada por diseñadores de la Costa de Ópalo.\nVenta en línea"
        ],
        "nl": [
          "62Ways, simpelweg 62W, valt op door zijn kleurrijke tinten en zachte, comfortabele stoffen. Een kwaliteitskledingmerk gemaakt door ontwerpers uit de Côte d'Opale.\nOnline verkoop"
        ]
      },
      "@type": [
        "Description"
      ],
