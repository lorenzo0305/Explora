  "rdfs:comment": {
    "de": [
      "Gegenüber dem Krankenhaus von Bourgoin-Jallieu gelegen, bietet Amplitude Center Fachleuten einen eingerichteten Ort zur gemeinsamen Nutzung an, um ihre Tätigkeit auszuüben, und stellt Folgendes zur Verfügung: 3 ausgestattete Büros und einen Raum für Besprechungen, Schulungen oder Empfänge."
    ],
    "en": [
      "Located opposite the Bourgoin-Jallieu hospital, Amplitude Center offers professionals a fully-equipped space to share in order to run their business, with 3 fully-equipped offices and a meeting, training or reception room."
    ],
    "it": [
      "Situato di fronte all'ospedale Bourgoin-Jallieu, il Centro Amplitude offre ai professionisti uno spazio appositamente costruito da condividere per svolgere la propria attività, con 3 uffici completamente attrezzati e una sala per riunioni, formazione o ricevimenti."
    ],
    "fr": [
      "Situé en face de l'hôpital de Bourgoin-Jallieu, Amplitude Center propose aux professionnels un lieu aménagé à partager afin d'exercer leur activité et met à disposition : 3 bureaux équipés et une salle de réunion, de formation ou de réception."
    ],
    "es": [
      "Situado frente al hospital Bourgoin-Jallieu, el Amplitude Center ofrece a los profesionales un espacio específico que compartir para desarrollar su actividad, con 3 despachos totalmente equipados y una sala para reuniones, formación o recepciones."
    ],
    "nl": [
      "Het Amplitude Center ligt tegenover het Bourgoin-Jallieu ziekenhuis en biedt professionals een speciaal gebouwde ruimte om hun bedrijf te delen, met 3 volledig uitgeruste kantoren en een ruimte voor vergaderingen, trainingen of recepties."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Amplitude Center"
    ]
  },
