  "rdfs:comment": {
    "de": [
      "Sie haben sie bei den vorherigen Ausgaben geliebt, nun kommt sie zurück, um Ihnen eine zeitlose Auszeit zu bieten... Ihr Wasserkomplex verwandelt sich für einen Abend in eine wahre Oase des Friedens."
    ],
    "en": [
      "You've loved it in previous editions, and now it's back to offer you a timeless interlude... Your aquatic complex is transformed into a haven of peace for an evening."
    ],
    "it": [
      "L'avete amata negli anni passati e ora torna per una parentesi senza tempo... Il vostro complesso di piscine si trasformerà in un'oasi di pace per una sera."
    ],
    "fr": [
      "Vous l'avez adorée lors des précédentes éditions, elle revient pour vous offrir une parenthèse hors du temps... Votre complexe aquatique se transforme en un véritable havre de paix le temps d'une soirée."
    ],
    "es": [
      "Le ha encantado en años anteriores, y ahora vuelve para ofrecerle un interludio atemporal... Su complejo de piscinas se transformará en un remanso de paz por una noche."
    ],
    "nl": [
      "Je vond het de vorige jaren geweldig en nu is het terug voor een tijdloos intermezzo... Je zwembadcomplex wordt voor een avond omgetoverd tot een oase van rust."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Zen"
    ]
  },
