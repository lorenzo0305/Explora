  "rdfs:comment": {
    "de": [
      "Das Château des Lèbres aus dem 16. Jahrhundert ist von 6,5 Hektar Weinbergen umgeben, die biologisch bewirtschaftet werden.  Entdecken Sie die Magie dieses Ortes sowie seine Cuvées, die authentisch unser Terroir widerspiegeln!"
    ],
    "en": [
      "Château des Lèbres, dating from the 16th century, is surrounded by 6.5 hectares of organically-farmed vines.  Come and discover the magic of this place and its cuvées, which authentically reflect our terroir!"
    ],
    "it": [
      "Lo Château des Lèbres risale al XVI secolo ed è circondato da 6,5 ettari di vigneti coltivati con metodo biologico.  Venite a scoprire la magia di questo luogo e dei suoi vini, che sono un autentico riflesso del nostro terroir!"
    ],
    "fr": [
      "Le château des Lèbres, datant du XVIème siècle, est entouré de 6,5 hectares de vignes menées en agriculture biologique.  Venez découvrir la magie de ce lieu ainsi que ses cuvées qui reflètent avec authenticité notre terroir !"
    ],
    "es": [
      "El Château des Lèbres data del siglo XVI y está rodeado de 6,5 hectáreas de viñedos de cultivo ecológico.  Venga a descubrir la magia de este lugar y de sus vinos, ¡auténtico reflejo de nuestro terruño!"
    ],
    "nl": [
      "Château des Lèbres dateert uit de 16e eeuw en wordt omringd door 6,5 hectare biologisch gekweekte wijngaarden.  Kom en ontdek de magie van deze plek en zijn wijnen, die een authentieke weerspiegeling zijn van ons terroir!"
    ]
  },
  "rdfs:label": {
