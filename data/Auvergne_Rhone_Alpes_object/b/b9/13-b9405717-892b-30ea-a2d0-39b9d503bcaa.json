  "rdfs:comment": {
    "de": [
      "Verleih von Bergsportausrüstung: Schneeschuhe, Skier, Snowboards. (+ Langlaufskiverleih nur in Aouste). Verkauf von Sport- und Freizeitartikeln. Fahrradreparaturwerkstatt, Teileverkauf und -verleih."
    ],
    "en": [
      "Mountain equipment rentals: snowshoes, skis, snowboards. (+ Cross-country ski rentals in Aouste only). Sports store and sales of leisure equipment. Bike repair shop, parts sales and rentals."
    ],
    "it": [
      "Noleggio di attrezzatura da montagna: racchette da neve, sci, snowboard (+ noleggio di sci di fondo solo ad Aouste). Negozio di riparazione di biciclette, vendita di ricambi e noleggio di biciclette. Vendita di articoli sportivi e per il tempo libero."
    ],
    "fr": [
      "Location de matériel de montagne : raquettes, ski, snowboard (+ Location de skis de fond à Aouste uniquement). Atelier de réparation, vente de pièces et location de vélo. Vente d'articles de sports et de Loisirs."
    ],
    "nl": [
      "Verhuur van bergsportmateriaal: sneeuwschoenen, ski's, snowboards. (+ Verhuur van langlaufski's alleen in Aouste). Verkoop van sport- en vrijetijdsartikelen. Fietsreparatiewerkplaats, verkoop en verhuur van onderdelen."
    ],
    "es": [
      "Alquiler de material de montaña: raquetas de nieve, esquís, tablas de snowboard (+ alquiler de esquís de fondo sólo en Aouste). Taller de reparación de bicicletas, venta de piezas y alquiler de bicicletas. Venta de artículos deportivos y de ocio."
    ]
  },
