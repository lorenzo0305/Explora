  "rdfs:comment": {
    "de": [
      "Dorian Lachaise bietet Ihnen an, Ihre Geschäftsveranstaltungen und Firmenevents zu moderieren.\r\nEr fühlt sich am Mikrofon und in der Öffentlichkeit wohl und wird die richtigen Worte finden, um zu Ihrem Publikum zu sprechen und dabei die Vorgaben einzuhalten."
    ],
    "en": [
      "Dorian Lachaise can animate your commercial and corporate events.\r\nAt ease at the microphone and in public, he'll find the right words to speak to your audience, while respecting your specifications."
    ],
    "it": [
      "Dorian Lachaise è disponibile per ospitare i vostri eventi commerciali e aziendali.\r\nA suo agio al microfono e in pubblico, troverà le parole giuste per parlare al vostro pubblico, rispettando le vostre specifiche."
    ],
    "fr": [
      "Dorian Lachaise vous propose d'animer vos événements commerciaux et événements d'entreprises.\r\nA l'aise au micro et en public, il saura trouver les mots justes pour parler à votre public, en respectant le cahier des charges."
    ],
    "nl": [
      "Dorian Lachaise is beschikbaar voor uw commerciële en bedrijfsevenementen.\r\nHij voelt zich op zijn gemak bij de microfoon en in het openbaar en vindt de juiste woorden om uw publiek aan te spreken, terwijl hij uw specificaties respecteert."
    ],
    "es": [
      "Dorian Lachaise está disponible para presentar sus eventos comerciales y corporativos.\r\nA gusto ante el micrófono y en público, encontrará las palabras adecuadas para dirigirse a su público, respetando su pliego de condiciones."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Dorian Lachaise - speaker"
    ]
  },
