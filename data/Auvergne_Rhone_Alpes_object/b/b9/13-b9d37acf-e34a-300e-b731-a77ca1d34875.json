  "rdfs:comment": {
    "de": [
      "Technisch zugänglicher Rundweg ab dem Sportkomplex Boost Center.\r\nEine Wanderung bis nach Les Teillères mit einer Rückkehr über Vaux und den Étang des Lésines ."
    ],
    "en": [
      "Technically accessible circuit starting from the Boost Center sports complex.\r\nA stroll to Les Teillères with a return via Vaux and the Lésines pond."
    ],
    "it": [
      "Percorso tecnicamente accessibile con partenza dal complesso sportivo Boost Center.\r\nUna passeggiata fino a Les Teillères, con ritorno attraverso Vaux e l'Etang des Lésines."
    ],
    "fr": [
      "Circuit accessible techniquement au départ du complexe sportif Boost Center. \r\nUne balade jusqu'aux Teillères avec un retour par Vaux et l'étang des Lésines ."
    ],
    "nl": [
      "Technisch toegankelijke route die begint bij het sportcomplex van Boost Center.\r\nEen wandeling tot Les Teillères, terug via Vaux en het Etang des Lésines."
    ],
    "es": [
      "Recorrido técnicamente accesible que parte del complejo deportivo Boost Center.\r\nPaseo hasta Les Teillères, regreso por Vaux y el Etang des Lésines."
    ]
  },
