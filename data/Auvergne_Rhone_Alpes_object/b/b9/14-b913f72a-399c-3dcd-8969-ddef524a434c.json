      "@id": "https://data.datatourisme.fr/7d1e9575-0130-34fa-bb8b-317f9d232632",
      "dc:description": {
        "de": [
          "Feiern zum Jahresende\nSamstag, 20. Dezember von 14 bis 20 Uhr\nNeuville-sous-Montreuil\n--------------------------\nOrganisiert vom Festkomitee der Gemeinde\n\nDie Anmeldungen sind geschlossen\nAuskünfte per E-Mail :comitefetes.neuville@gmail.com\n\nKredit: Comité des Fêtes Neuville"
        ],
        "en": [
          "End of year festivities\nSaturday December 20, 2pm to 8pm\nNeuville-sous-Montreuil\n--------------------------\nOrganized by the Comité des Fêtes de la Commune\n\nRegistration closed\nInformation by e-mail :comitefetes.neuville@gmail.com\n\nCredit: Comité des Fêtes Neuville"
        ],
        "it": [
          "Feste di fine anno\nSabato 20 dicembre dalle 14.00 alle 20.00\nNeuville-sous-Montreuil\n--------------------------\nOrganizzato dal Comitato delle feste locale\n\nIscrizioni chiuse\nPer ulteriori informazioni, inviare un'e-mail a :comitefetes.neuville@gmail.com\n\nCredito: Comitato delle feste Neuville"
        ],
        "fr": [
          "Fêtes de fin d'année\nSamedi 20 décembre de 14h à 20h\nNeuville-sous-Montreuil\n--------------------------\nOrganisé par le Comité des Fêtes de la Commune\n\nLes inscriptions sont closes\nRenseignements par mail :comitefetes.neuville@gmail.com\n\nCrédit : Comité des Fêtes Neuville"
        ],
        "es": [
          "Fiestas de fin de año\nSábado 20 de diciembre de 14:00 a 20:00\nNeuville-sous-Montreuil\n--------------------------\nOrganizado por el Comité local de Fiestas\n\nInscripción cerrada\nPara más información, envíe un correo electrónico a :comitefetes.neuville@gmail.com\n\nCrédito: Comité des Fêtes Neuville"
        ],
        "nl": [
          "Eindejaarsfeesten\nZaterdag 20 december van 14u tot 20u\nNeuville-sous-Montreuil\n--------------------------\nGeorganiseerd door het plaatselijke Comité des Fêtes\n\nInschrijving gesloten\nStuur voor meer informatie een e-mail naar :comitefetes.neuville@gmail.com\n\nKrediet: Comité des Fêtes Neuville"
        ]
      },
