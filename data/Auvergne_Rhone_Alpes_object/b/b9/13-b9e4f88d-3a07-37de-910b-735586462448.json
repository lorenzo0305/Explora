  "rdfs:comment": {
    "de": [
      "Auvergnatisches Bistro-Restaurant mit gallischem Flair, gemütlicher Atmosphäre und einfacher, traditioneller Küche, die überwiegend auf frischen und lokalen Produkten basiert. Weinkeller, Wein im Glas und Spezialitäten aus der Auvergne ... Ven!"
    ],
    "en": [
      "Restaurant Bistro Auvergnat with a Gaulish spirit, warm atmosphere and simple, traditional cuisine, using mostly fresh, local produce. Wine cellar, wine by the glass and Auvergne specialties ... Ven!"
    ],
    "it": [
      "Ristorante bistrot dell'Alvernia con un'atmosfera gallica, un'atmosfera calda e una cucina semplice e tradizionale, che utilizza prevalentemente prodotti freschi e locali. Cantina, vini al bicchiere e specialità dell'Alvernia... Ven!"
    ],
    "fr": [
      "Restaurant Bistro Auvergnat à l'esprit Gaulois, ambiance chaleureuse  et cuisine  simple, traditionnelle, à base de produits frais et locaux  en majorité. Cave à vin, vin au verre et spécialités Auvergnates ... Ven !"
    ],
    "es": [
      "Restaurante bistró de Auvernia con aire galo, ambiente cálido y cocina sencilla y tradicional, elaborada principalmente con productos frescos y locales. Bodega, vinos por copas y especialidades de Auvernia... ¡Ven !"
    ],
    "nl": [
      "Auvergne bistro restaurant met een Gallische sfeer, warme sfeer en eenvoudige, traditionele keuken, met voornamelijk verse, lokale producten. Wijnkelder, wijn per glas en specialiteiten uit de Auvergne ... Ven !"
    ]
  },
