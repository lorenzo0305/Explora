  "rdfs:comment": {
    "de": [
      "Das Team empfängt Sie in einem Vintage- und Recovery-Dekor und bietet Ihnen eine vom Chefkoch sorgfältig zusammengestellte Speisekarte mit köstlichen Crêpes, Galettes, Eis und schönen handwerklichen Überraschungen, die es zu entdecken gilt."
    ],
    "en": [
      "Breton pancakes in the heart of Dauphiné facing the medieval Halle? This is the gourmet challenge that Crêperie Krémolane has set itself! The unexpected marriage of Celtic cuisine and fresh local produce will delight the taste buds of both young and old."
    ],
    "it": [
      "Il team vi accoglie in un arredamento vintage e riciclato, per offrirvi un menu preparato con cura dallo chef, con deliziose crêpes, galettes, gelati e sorprese fatte in casa da scoprire."
    ],
    "fr": [
      "L'équipe vous accueille dans un décor vintage et récup', pour vous proposer une carte soigneusement élaborée par le Chef, avec de délicieuses crêpes, des galettes, des glaces et de belles surprises artisanales à découvrir."
    ],
    "nl": [
      "Het team verwelkomt je in een vintage en gerecycled decor, om je een menu voor te schotelen dat zorgvuldig is bereid door de chef-kok, met heerlijke crêpes, galettes, ijsjes en huisgemaakte verrassingen om te ontdekken."
    ],
    "es": [
      "El equipo le da la bienvenida en una decoración vintage y reciclada, para ofrecerle un menú cuidadosamente preparado por el Chef, con deliciosos crêpes, galettes, helados y sorpresas caseras por descubrir."
    ]
  },
