  "rdfs:comment": {
    "de": [
      "Dieses Theater in der Nähe von Clermont-Fd kann für die Organisation Ihrer privaten oder geschäftlichen Veranstaltungen privatisiert werden. Die Comédie des Volcans bietet Ihnen maßgeschneiderte Lösungen, um Ihre Veranstaltung zu einem Erfolg zu machen."
    ],
    "en": [
      "This theater, located on the outskirts of Clermont-Fd, is available for private or corporate events. La Comédie des Volcans offers tailor-made solutions to make your event a success."
    ],
    "it": [
      "Questo teatro, situato alla periferia di Clermont-Fd, è disponibile per il noleggio privato per organizzare i vostri eventi privati o professionali. La Comédie des Volcans offre soluzioni su misura per il successo del vostro evento."
    ],
    "fr": [
      "Ce théâtre situé en proche périphérie de Clermont-Fd est privatisable pour organiser vos événements privés ou professionnels. La Comédie des Volcans vous propose des solutions sur mesure pour faire de votre évènement une réussite."
    ],
    "es": [
      "Este teatro, situado en las afueras de Clermont-Fd, está disponible en alquiler privado para organizar sus eventos particulares o profesionales. La Comédie des Volcans ofrece soluciones a medida para que su evento sea un éxito."
    ],
    "nl": [
      "Dit theater, gelegen aan de rand van Clermont-Fd, is beschikbaar voor privéverhuur om uw privé- of professionele evenementen te organiseren. De Comédie des Volcans biedt oplossingen op maat om van uw evenement een succes te maken."
    ]
  },
