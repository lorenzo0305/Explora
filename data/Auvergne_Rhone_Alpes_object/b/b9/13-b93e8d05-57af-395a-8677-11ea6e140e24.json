  "rdfs:comment": {
    "de": [
      "Pauline und Jaime begrüßen Sie in ihrer Werkstatt, in der sie zeitgenössischen Schmuck herstellen, bei dem Edelmetalle und Edelsteine aufeinandertreffen. Zögern Sie nicht, diese leidenschaftlichen Schmuckhandwerkerinnen kennenzulernen!"
    ],
    "en": [
      "Pauline and Jaime welcome you to their contemporary jewellery making workshop where precious metals and fine stones meet. Don't hesitate to come and meet these jewellery craftsmen who are passionate about their trade!"
    ],
    "it": [
      "Pauline e Jaime vi danno il benvenuto nel loro laboratorio di gioielleria contemporanea dove si incontrano metalli preziosi e pietre pregiate. Non esitate a venire a conoscere questi gioiellieri appassionati del loro lavoro!"
    ],
    "fr": [
      "Pauline et Jaime vous accueillent dans leur atelier de fabrication de bijoux contemporains où métaux précieux et pierres fines se rencontrent. N'hésitez pas à venir à la rencontre de ces artisans bijoutiers passionnés par leur métier !"
    ],
    "es": [
      "Pauline y Jaime le dan la bienvenida a su taller de joyería contemporánea, donde se unen los metales preciosos y las piedras finas. No dude en venir a conocer a estos joyeros apasionados por su trabajo"
    ],
    "nl": [
      "Pauline en Jaime heten u welkom in hun hedendaagse juwelenatelier waar edele metalen en fijne stenen elkaar ontmoeten. Aarzel niet om kennis te komen maken met deze juweliers die gepassioneerd zijn over hun werk!"
    ]
  },
  "rdfs:label": {
