      "@id": "https://data.datatourisme.fr/1242ac97-dd72-3bf7-b1de-0b5cff6988ea",
      "dc:description": {
        "de": [
          "Biologischer und diversifizierter Gemüsebaubetrieb. Hier finden Sie mehr als 60 verschiedene Sorten, die das ganze Jahr über angebaut werden. Markt mit lokalen Erzeugern auf dem Hof."
        ],
        "en": [
          "Diversified organic market garden. Over sixty varieties grown throughout the year. Local farmers' market at the farm."
        ],
        "it": [
          "Orto biologico diversificato. Oltre sessanta varietà coltivate tutto l'anno. Mercato dei produttori locali presso la fattoria."
        ],
        "fr": [
          "Ferme maraîchère bio et diversifiée. Venez y retrouver plus d'une soixantaine de variétés cultivées sur l'année. Marché de producteurs locaux à la ferme."
        ],
        "es": [
          "Huerta ecológica diversificada. Más de sesenta variedades cultivadas durante todo el año. Mercado de productores locales en la granja."
        ],
        "nl": [
          "Gediversifieerde biologische tuin. Meer dan zestig variëteiten die het hele jaar door worden geteeld. Lokale producentenmarkt op de boerderij."
        ]
      },
