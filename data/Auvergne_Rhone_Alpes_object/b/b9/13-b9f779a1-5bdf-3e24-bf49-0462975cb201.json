  "rdfs:comment": {
    "de": [
      "Pickleball ist ein Sport mit Schlägern auf einem kleinen Tennisfeld mit einem Plastikball. Diese Aktivität ist einfacher als Tennis und für die ganze Familie ab etwa 5 Jahren geeignet."
    ],
    "en": [
      "Pickleball is a racket sport played on a small tennis court with a plastic ball. Easier than playing tennis, this activity is accessible to the whole family, for children aged 5 and over."
    ],
    "it": [
      "Il pickleball è uno sport di racchetta giocato su un piccolo campo da tennis con una pallina di plastica. Più facile del tennis, questa attività è accessibile a tutta la famiglia, a partire dai 5 anni circa."
    ],
    "fr": [
      "Le pickleball est un sport de raquettes sur un petit terrain de tennis avec une balle en plastique. Plus facile que la pratique du tennis, cette activité est accessible à toute la famille, à partir de 5 ans environ."
    ],
    "nl": [
      "Pickleball is een racketsport die wordt gespeeld op een kleine tennisbaan met een plastic bal. Deze activiteit is gemakkelijker dan tennissen en toegankelijk voor het hele gezin, voor kinderen vanaf 5 jaar."
    ],
    "es": [
      "El pickleball es un deporte de raqueta que se juega en una pequeña pista de tenis con una pelota de plástico. Más fácil que jugar al tenis, esta actividad es accesible a toda la familia, a partir de unos 5 años."
    ]
  },
  "rdfs:label": {
    "en": [
      "Pickleball court hire"
    ],
    "fr": [
      "Location de terrain pickleball"
    ],
    "nl": [
      "Pickleballbaan huren"
    ]
  },
