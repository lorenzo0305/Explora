  "rdfs:comment": {
    "de": [
      "Dieser Weg, der hin und zurück durch den Wald führt, bringt Sie in Richtung Montchavin (Plan Bois) mit schönen Aussichtspunkten auf das Beaufortain-Massiv und den Mont Blanc."
    ],
    "en": [
      "The trail takes the form of a round trip through the forest towards Plan Bois (plateau located above Montchavin les Coches)."
    ],
    "it": [
      "Questo sentiero, che si inoltra nella foresta, vi porterà verso Montchavin (Plan Bois) con una splendida vista sul massiccio del Beaufortain e sul Monte Bianco."
    ],
    "fr": [
      "Ce chemin, aller-retour en forêt, vous emmènera en direction de Montchavin (Plan Bois) avec de beaux points de vue sur le massif du Beaufortain et le Mont Blanc."
    ],
    "nl": [
      "Piste in de vorm van een heen en terug in het bos in de richting van Plan Bois (plateau gelegen boven Montchavin les Coches)."
    ],
    "es": [
      "Este camino, que va de un lado a otro del bosque, le llevará hacia Montchavin (Plan Bois) con hermosas vistas del macizo de Beaufortain y del Mont Blanc."
    ]
  },
  "rdfs:label": {
