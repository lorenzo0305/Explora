  "rdfs:comment": {
    "de": [
      "William De Cock und sein Team bieten Ihnen: Freilandschweine, Geflügel, Wiederverkauf von lokalen Produkten, Charolais-Rindfleisch, etc.\r\nVerkauf von vakuumverpacktem Frischfleisch, Wurstwaren, Pökelfleisch, Fertiggerichten, alles hausgemacht"
    ],
    "en": [
      "William De Cock and his team offer: free-range pork, poultry, resale of local produce, Charolais beef, etc...\r\nSale of fresh vacuum-packed meat, charcuterie, cured meats, ready-made meals, all home-made"
    ],
    "it": [
      "William De Cock e il suo team offrono: carne di maiale all'aperto, pollame, rivendita di prodotti locali, carne bovina Charolais, ecc...\r\nVendita di carne fresca sottovuoto, salumi, insaccati, piatti pronti, tutti fatti in casa"
    ],
    "fr": [
      "William De Cock et son équipe vous propose  : porcs fermiers, volailles, revente de production locale, viande bovine charolaise, etc... \r\nVente de viande Fraiche conditionnée sous vide , charcuteries , salaisons, plats cuisinés le tout fabrication maison"
    ],
    "es": [
      "William De Cock y su equipo ofrecen: carne de cerdo de corral, aves de corral, reventa de productos locales, ternera Charolais, etc...\r\nVenta de carne fresca envasada al vacío, embutidos, salazones, platos preparados, todo casero"
    ],
    "nl": [
      "William De Cock en zijn team bieden: scharrelvarkensvlees, gevogelte, doorverkoop van streekproducten, Charolais rundvlees, enz.\r\nVerkoop van vers vacuümverpakt vlees, charcuterie, vleeswaren, kant-en-klaarmaaltijden, alles huisbereid"
    ]
  },
