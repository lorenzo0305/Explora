  "rdfs:comment": {
    "de": [
      "Die Miellerie empfängt Sie zur Verkostung und zum Verkauf von Honig, Lebkuchennougat und anderen Produkten aus der Bienenzucht.\r\nVorstellung der Tätigkeit und der Herstellung der Produkte."
    ],
    "en": [
      "La Miellerie welcomes you to taste and sell honey, gingerbread, nougat and other beekeeping products.\r\nPresentation of the business and how the products are made."
    ],
    "it": [
      "La Miellerie vi accoglie per la degustazione e la vendita di miele, panpepato, torrone e altri prodotti dell'apicoltura.\r\nPresentazione dell'attività e della lavorazione dei prodotti."
    ],
    "fr": [
      "La Miellerie vous accueille pour une dégustation et vente de miel, pain d'épice nougat et autres produits issus de l'apiculture. \r\nPrésentation de l'activité et de la fabrication des produits."
    ],
    "nl": [
      "La Miellerie verwelkomt je om honing, peperkoek, noga en andere bijenteeltproducten te proeven en te verkopen.\r\nPresentatie van het bedrijf en hoe de producten worden gemaakt."
    ],
    "es": [
      "La Miellerie le da la bienvenida para degustar y vender miel, pan de especias, turrón y otros productos apícolas.\r\nPresentación del negocio y de cómo se elaboran los productos."
    ]
  },
  "rdfs:label": {
