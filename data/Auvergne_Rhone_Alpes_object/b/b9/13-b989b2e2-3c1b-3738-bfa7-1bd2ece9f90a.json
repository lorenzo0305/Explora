  "rdfs:comment": {
    "de": [
      "Unser Blumenatelier bietet Ihnen eine Auswahl an lokalen oder in Frankreich gezüchteten Blumen, die dem Rhythmus der Jahreszeiten entsprechen. Wir arbeiten mit Künstlern und Handwerkern zusammen, um Ihnen eine Auswahl an Keramiken, Weinen und anderen kleinen Aufmerksamkeiten anbieten zu können."
    ],
    "en": [
      "Our florist's workshop offers a selection of local flowers or flowers grown in France according to the rhythm of the seasons. We work with artists and craftsmen to offer you a selection of ceramics, wines and other little extras."
    ],
    "it": [
      "La nostra fioreria offre una selezione di fiori locali o di coltivazione francese secondo il ritmo delle stagioni. Collaboriamo con artisti e artigiani per offrirvi una selezione di ceramiche, vini e altre piccole prelibatezze."
    ],
    "fr": [
      "Notre atelier fleuriste vous propose une sélection de fleurs locales ou cultivées en France en fonction du rythme des saisons. Nous travaillons avec les artistes, artisans pour vous proposer une sélection de céramiques, vins et autres petites attentions."
    ],
    "nl": [
      "Ons bloemenatelier biedt je een selectie lokale bloemen of in Frankrijk geteelde bloemen volgens het ritme van de seizoenen. We werken samen met kunstenaars en ambachtslieden om je een selectie keramiek, wijnen en andere kleine lekkernijen aan te bieden."
    ],
    "es": [
      "Nuestro taller de floristería le ofrece una selección de flores locales o cultivadas en Francia al ritmo de las estaciones. Trabajamos con artistas y artesanos para ofrecerle una selección de cerámicas, vinos y otras pequeñas delicias."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les petites attentions"
    ]
  },
