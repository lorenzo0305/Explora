  "rdfs:comment": {
    "de": [
      "Metzgerei, Wurstwaren, Lebensmittelgeschäft (Rillettes, Pasteten, Ravioli, frische Nudeln, Cassoulet, Olivenöl, ...) und Zerlegebetrieb für Profis.\r\nUnser Fleisch stammt aus der Region und ein Teil davon sehr lokal (Drôme und Ardèche)."
    ],
    "en": [
      "Butchery, delicatessen, grocery (rillettes, pâtés, ravioles, fresh pasta, cassoulets, olive oils, etc.) and cutting workshop for professionals.\r\nOur meats are of regional origin, some of them very local (Drôme and Ardèche)."
    ],
    "it": [
      "Macelleria, salumeria, drogheria (rillettes, paté, ravioles, pasta fresca, cassoulets, oli d'oliva, ecc.) e laboratorio di taglio per professionisti.\r\nLe nostre carni sono di origine regionale, alcune molto locali (Drôme e Ardèche)."
    ],
    "fr": [
      "Boucherie, charcuterie, épicerie (Rillettes, pâtés, ravioles, pâtes fraîches, cassoulets, huiles d’olive, ...) et atelier de découpe pour professionnels. \r\nNos viandes sont d'origine régionale et une partie très locale (Drôme et Ardèche)."
    ],
    "nl": [
      "Slagerij, delicatessenzaak, kruidenierswinkel (rillettes, patés, ravioli, verse pasta, cassoulets, olijfolie, enz.) en uitsnijderij voor professionals.\r\nOns vlees is van regionale oorsprong, sommige zeer lokaal (Drôme en Ardèche)."
    ],
    "es": [
      "Carnicería, charcutería, ultramarinos (rillettes, patés, ravioles, pasta fresca, cassoulets, aceites de oliva, etc.) y sala de despiece para profesionales.\r\nNuestras carnes son de origen regional, algunas muy locales (Drôme y Ardèche)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Comptoir drômois des viandes"
    ]
  },
