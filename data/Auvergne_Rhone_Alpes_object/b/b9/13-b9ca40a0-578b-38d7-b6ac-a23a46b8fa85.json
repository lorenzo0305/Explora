  "rdfs:comment": {
    "de": [
      "Pizzas zum Mitnehmen oder als Lieferservice. Automatische Ausgabe von warmen und kalten Pizzen aus frischen Qualitätsprodukten (7 Tage pro Woche und 24 Stunden pro Tag)."
    ],
    "en": [
      "Pizzas to take away or in delivery. Automatic dispenser of hot or cold homemade pizzas made from fresh and quality products (7 days a week and 24 hours a day)."
    ],
    "it": [
      "Pizze da asporto o a domicilio. Distributore automatico di pizze artigianali calde o fredde preparate con prodotti freschi e di qualità (7 giorni su 7 e 24 ore su 24)."
    ],
    "fr": [
      "Pizzas à emporter ou en livraison. Distributeur automatique de pizzas chaudes ou froides faîtes maison à partir de produits frais et de qualité (7j/7j et 24h/24h)."
    ],
    "es": [
      "Pizzas para llevar o a domicilio. Máquina expendedora automática de pizzas caseras calientes o frías elaboradas con productos frescos de calidad (7 días a la semana y 24 horas al día)."
    ],
    "nl": [
      "Pizza's om mee te nemen of om te bezorgen. Automaat voor warme of koude zelfgemaakte pizza's van verse kwaliteitsproducten (7 dagen per week en 24 uur per dag)."
