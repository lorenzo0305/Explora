  "rdfs:comment": {
    "de": [
      "Restaurant - Pizzeria, Tagesmenü, Küche aus dem Holzofen, herzlicher und familiärer Empfang im Herzen des Dorfes Saint Laurent en Royans. Pizzen zum Mitnehmen am Abend. Bitte reservieren Sie."
    ],
    "en": [
      "Restaurant - pizzeria, menu of the day, wood oven cooking, warm and family welcome in the heart of the village of Saint Laurent en Royans. Pizzas to take away in the evening. Thank you for booking."
    ],
    "it": [
      "Ristorante-pizzeria, menù giornaliero, forno a legna, calda accoglienza familiare nel cuore del villaggio di Saint Laurent en Royans. Pizze da asporto la sera. Si prega di prenotare in anticipo."
    ],
    "fr": [
      "Restaurant - pizzeria, menu du jour, cuisine au four à bois, accueil chaleureux et familial au cœur du village de Saint Laurent en Royans. Pizzas à emporter le soir. Merci de réserver."
    ],
    "es": [
      "Restaurante - pizzería, menú diario, horno de leña, cálida acogida familiar en el corazón del pueblo de Saint Laurent en Royans. Pizzas para llevar por la noche. Se ruega reservar con antelación."
    ],
    "nl": [
      "Restaurant - pizzeria, dagmenu, houtoven, warm onthaal in het hart van het dorp Saint Laurent en Royans. S Avonds pizza's om mee te nemen. Graag vooraf reserveren."
    ]
  },
  "rdfs:label": {
