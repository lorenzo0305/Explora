  "rdfs:comment": {
    "de": [
      "Der 17 ha große Plan d'eau de Villemouze (mit Karpfen, Zander, Hecht, Blackbass) ist für alle Personen mit einer Tagesangelkarte zugänglich, die beim Natural Wake Park erhältlich ist."
    ],
    "en": [
      "The 17-hectare Villemouze lake (with carp, pike-perch, pike and black-bass) is open to anyone with a daily fishing pass, available from the Natural Wake Park."
    ],
    "it": [
      "Il lago di Villemouze, di 17 ettari (con carpe, lucciperca, lucci e black-bass), è aperto a tutti coloro che possiedono un permesso di pesca giornaliero, disponibile presso il Parco Naturale Wake."
    ],
    "fr": [
      "Le plan d'eau de Villemouze de 17 ha (avec carpes, sandres, brochets, black-bass) est accessible à toute personne munie d'une carte de pêche journalière disponible auprès du Natural Wake Park."
    ],
    "nl": [
      "Het 17 hectare grote meer van Villemouze (met karper, snoekbaars, snoek en black-bass) is voor iedereen toegankelijk met een dagelijkse vispas, verkrijgbaar bij het Natuurreservaat."
    ],
    "es": [
      "El lago de Villemouze, de 17 hectáreas (con carpas, luciopercas, lucios y black-bass), está abierto a todo el mundo con un pase diario de pesca, disponible en el Parque Natural de Estelas."
    ]
  },
