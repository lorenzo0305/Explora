  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant sous les pins liegt 8 km von Valence entfernt und empfängt Sie in einer angenehmen Umgebung. Es stehen Ihnen 30 klimatisierte und perfekt ausgestattete Zimmer sowie ein klimatisiertes Restaurant und Tagungsräume zur Verfügung. Geschlossener Parkplatz."
    ],
    "en": [
      "8 km from Valence, the Hotel and Restaurant \"Sous les pins\" welcomes you in a nice and peaceful setting. This hotel has 30 bedrooms with air conditioning and all modern conveniences . The restaurant also has air conditioning and large rooms for meetings."
    ],
    "it": [
      "Situato a 8 km da Valence, l'hotel-ristorante sous les pins vi accoglie in un ambiente piacevole. a vostra disposizione 30 camere climatizzate e completamente attrezzate, un ristorante climatizzato e sale riunioni. Parcheggio chiuso."
    ],
    "fr": [
      "Situé A 8 km de Valence, l'hôtel-restaurant sous les pins vous accueillera dans un cadre agréable. 30 chambres climatisées et parfaitement équipées sont à votre disposition, ainsi qu’un restaurant climatisé et des salles de réunion. Parking fermé."
    ],
    "es": [
      "Situado a 8 km de Valence, el hotel-restaurante sous les pins le da la bienvenida en un entorno agradable. tiene a su disposición 30 habitaciones con aire acondicionado y totalmente equipadas, así como un restaurante con aire acondicionado y salas de reuniones. Aparcamiento cerrado."
    ],
    "nl": [
      "Het hotel-restaurant sous les pins ligt op 8 km van Valence en verwelkomt u in een aangename omgeving. 30 volledig uitgeruste kamers met airconditioning staan tot uw beschikking, evenals een restaurant met airconditioning en vergaderzalen. Gesloten parkeerplaats."
    ]
  },
