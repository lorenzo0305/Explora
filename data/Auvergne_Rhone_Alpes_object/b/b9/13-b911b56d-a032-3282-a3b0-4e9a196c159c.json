  "rdfs:comment": {
    "de": [
      "Dieses Familienhaus, ein ehemaliges Hospital der Malteserritter, bietet Ruhe und Charme und liegt nur 3 km von Grenoble entfernt. Mit seinem 250 m² großen Spa ist es ideal für einen romantischen Aufenthalt, eine gastronomische Entspannung oder einen geschäftlichen Aufenthalt in Grenoble."
    ],
    "en": [
      "This family home, a former hospital residence of the Knights of Malta, offers peace and charm just 3 km from Grenoble. With its 250 m² spa, it's ideal for a romantic, gastronomic or business stay in Grenoble."
    ],
    "it": [
      "Questa casa familiare, ex residenza ospedaliera dei Cavalieri di Malta, offre calma e fascino a soli 3 chilometri da Grenoble. Con i suoi 250 mq di spa, è ideale per un soggiorno romantico, di relax gastronomico o d'affari a Grenoble."
    ],
    "fr": [
      "Ancienne résidence hospitalière des Chevaliers de Malte, offre calme et charme à seulement 3 km de Grenoble. Avec son spa de 250 m², elle est idéale pour un séjour romantique, de détente gastronomique ou d'affaire à Grenoble."
    ],
    "es": [
      "Esta casa familiar, antigua residencia hospitalaria de los Caballeros de Malta, ofrece tranquilidad y encanto a sólo 3 km de Grenoble. Con su spa de 250 m², es ideal para una estancia romántica, gourmet relajante o de negocios en Grenoble."
    ],
    "nl": [
      "Deze voormalige hospitaalresidentie van de Ridders van Malta biedt rust en charme op slechts 3 km van Grenoble. Met zijn 250 m² spa is het ideaal voor een romantisch, ontspannend gastronomisch of zakelijk verblijf in Grenoble."
    ]
  },
