  "rdfs:comment": {
    "de": [
      "Brasserie im modernen, industriellen Stil, in der die Qualität an erster Stelle steht. Sie können jeden Tag ein anderes Menü entdecken.\r\nEin Team von 6 Personen wird Sie gebührend empfangen, um Ihre Gourmetwünsche zu erfüllen."
    ],
    "en": [
      "Brewery with a modern and industrial style where quality is of paramount importance. You will be able to discover a different menu every day.\r\nA team of 6 people will know how to welcome you as it should be to satisfy your greedy desires."
    ],
    "it": [
      "Brasserie dallo stile moderno e industriale, dove la qualità è la priorità principale. Potrete scoprire un menu diverso ogni giorno.\r\nUn team di 6 persone vi accoglierà come si deve per soddisfare i vostri golosi desideri."
    ],
    "fr": [
      "Brasserie au style moderne et industriel où la qualité occupe une place prépondérante. Vous pourrez découvrir chaque jour un menu différent.\r\nUne équipe de 6 personnes saura vous recevoir comme il se doit pour satisfaire vos envies gourmandes."
    ],
    "nl": [
      "Brasserie met een moderne en industriële stijl, waar kwaliteit voorop staat. U kunt elke dag een ander menu ontdekken.\r\nEen team van 6 personen zal u ontvangen zoals het hoort om uw gulzige verlangens te bevredigen."
    ],
    "es": [
      "Brasserie con un estilo moderno e industrial, donde la calidad es la principal prioridad. Puedes descubrir un menú diferente cada día.\r\nUn equipo de 6 personas le acogerá como es debido para satisfacer sus codiciosos deseos."
    ]
  },
  "rdfs:label": {
