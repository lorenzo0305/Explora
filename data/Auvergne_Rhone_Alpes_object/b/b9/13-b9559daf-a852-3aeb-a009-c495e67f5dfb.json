  "rdfs:comment": {
    "de": [
      "Einen Moment mit den Hunden von A Pas de Loups zu verbringen, bedeutet, einen zeitlosen Moment inmitten der Natur zu verbringen, im Kontakt mit sanften und mutigen Hunden von Legenden. Die Hundetraktion ist ein Hundesport, der die Hunde begeistert."
    ],
    "en": [
      "Come and spend a moment with the dogs of A Pas de Loups, and spend a timeless moment in the heart of nature, in contact with gentle and courageous legendary dogs. Canine traction is the canine sport that makes dogs happy."
    ],
    "it": [
      "Venite a trascorrere un momento con i cani di A Pas de Loups, e passate un momento senza tempo nel cuore della natura a contatto con cani leggendari, gentili e coraggiosi. La trazione canina è lo sport canino che delizia i cani."
    ],
    "fr": [
      "Venir passer un moment avec les chiens de A Pas de Loups, c'est passer un instant hors temps en pleine nature au contact de doux et courageux chiens de légendes. La traction canine, c'est le sport canin qui ravi les chiens."
    ],
    "es": [
      "Venga a pasar un momento con los perros de A Pas de Loups, y pase un momento intemporal en plena naturaleza en contacto con perros legendarios amables y valientes. La tracción canina es el deporte canino que hace las delicias de los perros."
    ],
    "nl": [
      "Kom een moment doorbrengen met de honden van A Pas de Loups, en beleef een tijdloos moment in het hart van de natuur in contact met zachtaardige en moedige legendarische honden. Canine traction is de hondensport waar honden plezier aan beleven."
    ]
  },
  "rdfs:label": {
    "fr": [
      "À pas de loups"
    ]
  },
