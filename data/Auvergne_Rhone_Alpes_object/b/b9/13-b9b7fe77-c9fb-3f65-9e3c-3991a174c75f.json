  "rdfs:comment": {
    "de": [
      "Der Espace Jean-Claude Colin ist ein Raum mit einer Art Parcours, der in die Geschichte und die Mission der Kongregation der Maristenpatres und ihres Gründers Jean-Claude COLIN eintaucht."
    ],
    "en": [
      "The Espace Jean-Claude Colin is an immersive journey through the history and mission of the Marist Fathers and their founder Jean-Claude COLIN."
    ],
