  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf einen Orientierungslauf auf der Suche nach Eiern und entdecken Sie bei dieser Gelegenheit das Dorf La Chaise Dieu und den Kreuzgang der Abtei. Start und Ziel im öffentlichen Garten"
    ],
    "en": [
      "Set off on an orienteering hunt for eggs, and discover the village of La Chaise Dieu and the abbey cloister at the same time. Start and finish in the public garden"
    ],
    "it": [
      "Partite a caccia di uova con l'orienteering e scoprite allo stesso tempo il villaggio di La Chaise Dieu e il chiostro dell'abbazia. Partenza e arrivo nei giardini pubblici"
    ],
    "fr": [
      "Partez pour une course d'orientation à la chasse aux oeufs et découvrez par la même occasion le village de La Chaise Dieu et le cloître de l'abbaye. Départ et arrivée au jardin public"
    ],
    "es": [
      "Salga a la caza de huevos en un recorrido de orientación y descubra al mismo tiempo el pueblo de La Chaise Dieu y el claustro de la abadía. Salida y llegada en los jardines públicos"
    ],
    "nl": [
      "Ga op zoek naar eieren en ontdek tegelijkertijd het dorp La Chaise Dieu en het klooster van de abdij. Start en finish in de openbare tuinen"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chasse aux oeufs"
    ]
  },
