  "rdfs:comment": {
    "de": [
      "Willkommen in La Balme-les-Grottes, einem Dorf im Norden der Balcons du Dauphiné, einer unumgänglichen Etappe auf der ViaRhôna. Hier verbinden sich Kulturerbe und Natur und laden zu einer Reise in die Vergangenheit ein, insbesondere durch die Höhlen und das Naturschutzgebiet ENS des Coteaux de Saint-Roch."
    ],
    "en": [
      "Welcome to La Balme-les-Grottes, a village to the north of the Balcons du Dauphiné, a must-see stop on the ViaRhôna. Here, heritage and nature combine to invite you on a journey back in time, notably through the caves and the ENS des Coteaux de Saint-Roch."
    ],
    "it": [
      "Benvenuti a La Balme-les-Grottes, villaggio a nord dei Balcons du Dauphiné, tappa obbligata della ViaRhôna. Qui, patrimonio e natura si fondono per invitarvi a un viaggio nel tempo, in particolare attraverso le grotte e l'ENS des Coteaux de Saint-Roch."
    ],
    "fr": [
      "Bienvenue à La Balme-les-Grottes, un village au nord des Balcons du Dauphiné, étape incontournable sur ViaRhôna. Ici, patrimoine et nature se marient invitant à un voyage dans le temps, notamment à travers les grottes et l’ENS des Coteaux de Saint-Roch."
    ],
    "nl": [
      "Welkom in La Balme-les-Grottes, een dorp in het noorden van de Balcons du Dauphiné, een niet te missen halte op de ViaRhôna. Hier nodigen erfgoed en natuur u uit voor een reis terug in de tijd, met name door de grotten en de ENS des Coteaux de Saint-Roch."
    ],
    "es": [
      "Bienvenido a La Balme-les-Grottes, pueblo del norte de los Balcones del Dauphiné, parada obligada de la ViaRhôna. Aquí, el patrimonio y la naturaleza se combinan para invitarle a un viaje en el tiempo, especialmente a través de las cuevas y el ENS des Coteaux de Saint-Roch."
    ]
  },
