  "rdfs:comment": {
    "de": [
      "Das Hôtel du Lac liegt in einer Oase der Ruhe am Ufer des Sees von Montriond, in der Nähe des weltbekannten Berggebiets von Avoriaz und in der Nähe des Dorfzentrums von Morzine."
    ],
    "en": [
      "The Hôtel du Lac sits in a haven of peace on the shores of Lake Montriond, close to the world-renowned mountain resort of Avoriaz and the village of Morzine."
    ],
    "it": [
      "L'Hôtel du Lac si trova in un'oasi di pace sulle rive del lago di Montriond, vicino alla località montana di fama mondiale di Avoriaz e al centro del paese di Morzine."
    ],
    "fr": [
      "L'Hôtel du Lac siège dans un havre de paix sur les bords du lac de Montriond, à proximité du domaine de montagne d'Avoriaz et près du centre-village de Morzine, mondialement reconnus."
    ],
    "nl": [
      "Hôtel du Lac ligt in een oase van rust aan de oevers van het meer van Montriond, dicht bij het wereldberoemde bergresort Avoriaz en het dorpscentrum van Morzine."
    ],
    "es": [
      "El Hôtel du Lac se encuentra en un remanso de paz a orillas del lago Montriond, cerca de la estación de montaña de Avoriaz, conocida en todo el mundo, y del centro del pueblo de Morzine."
    ]
  },
