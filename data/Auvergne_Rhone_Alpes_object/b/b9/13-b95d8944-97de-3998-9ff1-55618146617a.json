  "rdfs:comment": {
    "de": [
      "Bugey Côtés Fermes ist eine Erzeugervereinigung von Landwirten, die Ihnen die Möglichkeit bietet, alle Produkte zu entdecken, die in den Betrieben der angeschlossenen Erzeuger angebaut, gezüchtet oder hergestellt werden."
    ],
    "en": [
      "Bugey Côtés Fermes is an association of producers that brings together farmers who offer you to discover all the products grown, raised or manufactured on the farms of the member producers."
    ],
    "it": [
      "Bugey Côtés Fermes è un'associazione di produttori che riunisce agricoltori che offrono la possibilità di scoprire tutti i prodotti coltivati, allevati o fabbricati nelle aziende agricole dei produttori associati."
    ],
    "fr": [
      "Bugey Côtés Fermes est une association de producteurs rassemblant des agriculteurs vous proposant de découvrir l’ensemble des produits cultivés, élevés ou fabriqués dans les exploitations les producteurs adhérents."
    ],
    "nl": [
      "Producten : organisatie van lokale producenten"
    ],
    "es": [
      "Bugey Côtés Fermes es una asociación de productores que reúne a los agricultores y les ofrece la oportunidad de descubrir todos los productos cultivados, criados o fabricados en las explotaciones de los productores miembros."
    ]
  },
