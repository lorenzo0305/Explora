  "rdfs:comment": {
    "de": [
      "Unser Tapas Club in Lyon vereint Aromen und Köstlichkeiten, an die Sie sich erinnern werden! Privatisieren Sie diesen magischen Ort für einen Abend - Sie werden einen unvergesslichen Moment verbringen! Kommen Sie von unseren ganzjährig geöffneten und beheizten Freiluft-Terrassen profitieren."
    ],
    "en": [
      "Our Tapas Club in Lyon, offers flavours and gastronomic delights that leave a lasting impression on the palette. Available for hire as your venue to hold private evnets in a superb setting. Outdoor terraces heated all year round."
    ],
    "it": [
      "Il nostro Tapas Club a Lione unisce sapori e golosità che non potrai dimenticare! Riserva per una sera questo luogo magico per un evento privato: trascorrerai un momento indimenticabile! Vieni a goderti le nostre terrazze all'aperto riscaldate durante tutto l'anno."
    ],
    "fr": [
      "Notre Tapas Club à Lyon allie saveurs et gourmandises dont vous vous souviendrez ! Privatisez ce lieu magique le temps d'une soirée, vous passerez un moment inoubliable ! Venez profiter de nos terrasses ouvertes et chauffées tout au long de l’année."
    ],
    "nl": [
      "Onze Tapas Club in Lyon combineert smaken en lekkernijen die u zullen bijblijven! Privatiseer deze magische plek voor een avond, u zult een onvergetelijk moment beleven! Kom het hele jaar door genieten van onze open en verwarmde terrassen."
    ],
    "es": [
      "Nuestro Tapas Club en Lyon combina sabores y delicias inolvidables. Ofrecemos la posibilidad de reservar este lugar mágico para fiestas privadas, ¡una experiencia para recordar! También disponemos de terraza abierta y climatizada durante todo el año."
    ]
  },
