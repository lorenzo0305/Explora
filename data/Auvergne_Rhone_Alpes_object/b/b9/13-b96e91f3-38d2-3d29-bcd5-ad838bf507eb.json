  "rdfs:comment": {
    "de": [
      "Hommage an Leonard Cohen\r\nFolk Rock Chanson\r\n\r\nZehn Jahre nach dem Tod des kanadischen Dichters präsentiert der Franzose H-Burns eine sowohl persönliche als auch kollektive Hommage an Leonard Cohen, begleitet von dem großartigen Streichquartett The Stranger Quartet."
    ],
    "en": [
      "Tribute to Leonard Cohen\r\nFolk rock song\r\n\r\nTen years after the death of the Canadian poet, France's H-Burns pays a personal and collective tribute to Leonard Cohen, accompanied by the magnificent string quartet The Stranger Quartet."
    ],
    "it": [
      "Omaggio a Leonard Cohen\r\nCanzone folk rock\r\n\r\nA dieci anni dalla morte del poeta canadese, il francese H-Burns rende un tributo personale e collettivo a Leonard Cohen, accompagnato dal magnifico quartetto d'archi The Stranger Quartet."
    ],
    "fr": [
      "Hommage à Léonard Cohen\r\nChanson folk rock\r\n\r\nDix ans après la disparition du poète canadien, le français H-Burns rend un hommage à la fois personnel et collectif à Leonard Cohen, accompagné du magnifique quatuor à cordes The Stranger Quartet."
    ],
    "nl": [
      "Hommage aan Leonard Cohen\r\nFolk rock lied\r\n\r\nTien jaar na de dood van de Canadese dichter brengt de Fransman H-Burns een persoonlijk en collectief eerbetoon aan Leonard Cohen, begeleid door het prachtige strijkkwartet The Stranger Quartet."
    ],
    "es": [
      "Homenaje a Leonard Cohen\r\nCanción folk rock\r\n\r\nDiez años después de la muerte del poeta canadiense, el francés H-Burns rinde un homenaje personal y colectivo a Leonard Cohen, acompañado por el magnífico cuarteto de cuerda The Stranger Quartet."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Concert: H-Burns & The Stranger Quartet"
    ]
  },
