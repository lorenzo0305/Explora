  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen kreativen und authentischen Ort im Herzen der Alpen: das Galerie-Atelier von Adrianna MJW. Unter den Dächern eines alten Bauernhofs mit Blick auf den Mont-Blanc gelegen, lädt dieser einzigartige Ort dazu ein, in die künstlerische Welt einer leidenschaftlichen Designerin einzutauchen."
    ],
    "en": [
      "Discover a creative and authentic space in the heart of the Alps: the atelier-gallery of Adrianna MJW. Nestled under the roof of an old farmhouse facing Mont-Blanc, this unique place is an invitation to immerse yourself in the artistic world of a passionate creator."
    ],
    "it": [
      "Scopri uno spazio creativo e autentico nel cuore delle Alpi: l'atelier-galleria di Adrianna MJW. Nascosto sotto il tetto di una vecchia fattoria di fronte al Monte Bianco, questo luogo unico è un invito a immergersi nell'universo artistico di una creatrice appassionata."
    ],
    "fr": [
      "Découvrez un lieu créatif et authentique au cœur des Alpes : l’atelier-galerie d’Adrianna MJW. Niché sous les toits d’une ancienne ferme face au Mont-Blanc, ce lieu unique est une invitation à plonger dans l’univers artistique d’une créatrice passionnée."
    ],
    "nl": [
      "Ontdek een creatieve en authentieke plek in het hart van de Alpen: de studio-galerie van Adrianna MJW. Genesteld onder het dak van een oude boerderij met uitzicht op de Mont Blanc, is deze unieke ruimte een uitnodiging om een duik te nemen in de artistieke wereld van een gepassioneerde ontwerper."
    ],
    "es": [
      "Descubra un lugar creativo y auténtico en el corazón de los Alpes: el estudio-galería de Adrianna MJW. Ubicado bajo el tejado de una antigua granja frente al Mont Blanc, este espacio único es una invitación a sumergirse en el mundo artístico de una diseñadora apasionada."
    ]
  },
  "rdfs:label": {
    "en": [
      "Adrianna MJW gallery and artist studio"
    ],
