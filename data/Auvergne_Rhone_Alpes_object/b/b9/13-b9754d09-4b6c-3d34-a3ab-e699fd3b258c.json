  "rdfs:comment": {
    "de": [
      "Produktion und Verkauf von Fleisch von Limousin-Färsen. Die Tiere werden auf dem Hof geboren, wachsen auf der Weide auf und werden mit dem auf dem Betrieb erzeugten Getreide gefüttert. Wir verkaufen Ochsenpakete von 5 oder 10 kg auf Vorbestellung, die auf dem Hof abgeholt werden können."
    ],
    "en": [
      "Production and sale of Limousine heifer meat. Animals are born on the farm, live in the meadows and fed with cereals grown on the farm."
    ],
    "it": [
      "Produzione e vendita di carne di vitella Limousin. Animali nati in azienda, allevati al pascolo e alimentati con cereali prodotti in azienda. Vendiamo pacchi di carne da 5 o 10 kg su prenotazione, da ritirare in azienda."
    ],
    "fr": [
      "Production et vente de viande de génisse limousine. Animaux nés à la ferme, grandissant au pré et nourris avec les céréales produites sur l'exploitation. Nous vendons des colis de bœuf de 5 ou 10 kg sur réservation, à retirer à la ferme."
    ],
    "nl": [
      "Productie en verkoop van vlees van Limousin vaarzen. Dieren geboren op de boerderij, opgegroeid in de wei en gevoed met granen geproduceerd op de boerderij. We verkopen pakketten rundvlees van 5 of 10 kg op afspraak, af te halen op de boerderij."
    ],
    "es": [
      "Producción y venta de carne de novillas Limousin. Animales nacidos en la explotación, criados en pastos y alimentados con cereales producidos en la explotación. Vendemos paquetes de 5 o 10 kg de carne de vacuno previo acuerdo, a recoger en la granja."
    ]
  },
  "rdfs:label": {
    "en": [
      "La Ferme des gones"
    ],
