  "rdfs:comment": {
    "de": [
      "Angeln (1. Kategorie = Forellen, Karpfen und Weißfische): Angelschein erforderlich, erhältlich unter www.cartedepeche.fr oder in der Bar Le Phocéen in Montsalvy oder in der Bar-Tabac in Junhac.\r\nDie Umrundung des Sees dauert etwa 15 Minuten."
    ],
    "en": [
      "Fishing activity (1st category = trout, carp & whitefish): Daily (€14), weekly (€36.50) or yearly permits (€87) on sale at www.cartedepeche.fr or from Bar Le Phocéen in Montsalvy or from Junhac bar-tobacconist's. \r\nThe tour of the lake takes about 15 mn."
    ],
    "it": [
      "Pesca (1a categoria = trota, carpa e coregone): è necessario un permesso di pesca, in vendita sul sito www.cartedepeche.fr o presso il bar Le Phocéen a Montsalvy o il bar-tabacchi a Junhac.\r\nIl giro del lago dura circa 15 minuti."
    ],
    "fr": [
      "Activité pêche (1e catégorie = truites, carpes et poissons blancs) : permis de pêche nécessaire, en vente sur www.cartedepeche.fr ou au bar Le Phocéen à Montsalvy ou au bar-tabac à Junhac.\r\nLe tour du lac prend environ 15 mn."
    ],
    "nl": [
      "Visserijactiviteit (1ste categorie = forel, karper & witvis): Visvergunning vereist: Dagelijkse (€ 14), wekelijkse (€ 36,50) of jaarlijkse pas (€ 87) verkrijgbaar op www.cartedepeche.fr of bij de bar Le Phocéen in Montsalvy of bij de bar-tabac in Junhac. \r\nDe tocht rond het meer duurt ongeveer 15 minuten."
    ],
    "es": [
      "Pesca (1ª categoría = trucha, carpa y pescado blanco): se necesita permiso de pesca, a la venta en www.cartedepeche.fr o en el bar Le Phocéen de Montsalvy o en el bar-tabac de Junhac.\r\nEl recorrido por el lago dura unos 15 minutos."
    ]
  },
  "rdfs:label": {
