  "rdfs:comment": {
    "de": [
      "\"Les cueillettes d'Heidi\" bietet Ihnen Veranstaltungen zum Thema essbare und medizinische Wildpflanzen an: Lernen Sie, sie zu identifizieren, sie zu kochen und entdecken Sie ihre wohltuende Wirkung."
    ],
    "en": [
      "\"Les cueillettes d'Heidi\" offers activities on the theme of edible and medicinal wild plants: learn to identify them, cook them and discover their benefits."
    ],
    "it": [
      "\"Les cueillettes d'Heidi\" propone una serie di attività sul tema delle piante selvatiche commestibili e medicinali: imparate a identificarle, a cucinarle e a scoprirne i benefici."
    ],
    "fr": [
      "\"Les cueillettes d'Heidi\" vous propose des animations sur le thème des plantes sauvages comestibles et médicinales : apprenez à les identifier, à les cuisines et découvrez leurs bienfaits."
    ],
    "es": [
      "\"Les cueillettes d'Heidi\" propone una serie de actividades sobre el tema de las plantas silvestres comestibles y medicinales: aprender a identificarlas, cocinarlas y descubrir sus beneficios."
    ],
    "nl": [
      "\"Les cueillettes d'Heidi\" biedt een reeks activiteiten rond het thema van eetbare en geneeskrachtige wilde planten: leer ze herkennen, koken en ontdek hun voordelen."
    ]
  },
