  "rdfs:comment": {
    "de": [
      "Traditionelle Küche und Savoyer Spezialitäten, eine große Auswahl an Desserts. Täglich eine kleine Pause für einen Imbiss und Après-Ski. Restaurant Bar"
    ],
    "en": [
      "Pizzeria and traditional Savoyard restaurant with a large choice of salads and desserts.  Afternoon snacks après-ski every day.  Restaurant and bar at the foot of the pistes."
    ],
    "it": [
      "Pizzeria, cucina tradizionale e specialità savoiarde, ampia scelta di insalate e dessert. Spuntino doposci tutti i giorni. Bar ristorante sul fronte neve. Trasmissione delle partite di Coppa del Mondo"
    ],
    "fr": [
      "Pizzéria, restauration traditionnelle et spécialités savoyardes, grand choix de salades et desserts. Pause goûter après-ski tous les jours. Restaurant Bar en front de neige. Retransmission des Matchs de la coupe du Monde"
    ],
    "nl": [
      "Traditionele keuken en Savoyaardse specialiteiten, grote keuze nagerechten. Dagelijks snacks voor uw après-ski pauzes. Bar Restaurant."
    ],
    "es": [
      "Pizzería, comida tradicional y especialidades saboyanas, amplia selección de ensaladas y postres. Merienda après-ski todos los días. Restaurante Bar en primera línea de nieve. Retransmisión de los partidos de la Copa del Mundo"
    ]
  },
