  "rdfs:comment": {
    "de": [
      "Alté Chamrousse Aventures bietet Ihnen 90 Workshops in den Bäumen ab 4 Jahren.\r\nEntdecken Sie Parcours, die für jedes Alter und jedes Niveau geeignet sind. So können Sie mit der Familie oder mit Freunden ein gemeinsames Abenteuer erleben."
    ],
    "en": [
      "Alté Chamrousse Aventures park offers you 90 games in the trees from the age of 4.\r\nCome and discover courses adapted to all ages and all abilities. You will be able to share an adventure in family or with friends."
    ],
    "it": [
      "Alté Chamrousse Aventures propone 90 laboratori sugli alberi dai 4 anni in su.\r\nVenite a scoprire percorsi adatti a tutte le età e a tutti i livelli. Potrete condividere l'avventura con la famiglia o con gli amici."
    ],
    "fr": [
      "Alté Chamrousse Aventures vous propose 90 ateliers dans les arbres dès 4 ans.\r\nVenez découvrir des parcours adaptés à tous les âges et tous les niveaux. Vous pourrez ainsi partager une aventure en famille ou entre amis."
    ],
    "es": [
      "Alté Chamrousse Aventures propone 90 talleres en los árboles a partir de 4 años.\r\nVen a descubrir rutas adaptadas a todas las edades y niveles. Podrás compartir una aventura con tu familia o amigos."
    ],
    "nl": [
      "Alté Chamrousse Aventures biedt 90 workshops in de bomen vanaf 4 jaar.\r\nKom en ontdek routes die geschikt zijn voor alle leeftijden en niveaus. Je kunt een avontuur delen met je familie of vrienden."
    ]
  },
