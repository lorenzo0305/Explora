  "rdfs:comment": {
    "de": [
      "Im 1. Arrondissement von Lyon, in der Rue du Bât d'Argent, wo die Papillote erfunden wurde, bietet das Gourmet-Restaurant La Quintessence seine emotionale Küche in einem ehemaligen Jesuitenrefektorium aus dem 16."
    ],
    "en": [
      "In Lyon's 1st arrondissement, on rue du Bât d'Argent, where the papillote was invented, the gourmet restaurant La Quintessence serves up a range of exciting dishes in a former Jesuit refectory dating from the 16th century."
    ],
    "it": [
      "Nel 1° arrondissement di Lione, in rue du Bât d? Argent, dove è stata inventata la papillote, il ristorante gourmet La Quintessence propone una serie di piatti entusiasmanti in un ex refettorio gesuita del XVI secolo."
    ],
    "fr": [
      "Dans le 1er arrondissement de Lyon, rue du Bât d’Argent, là où la papillote fut inventée, le restaurant gastronomique La Quintessence décline sa cuisine d’émotion dans un ancien réfectoire jésuite du XVIème siècle."
    ],
    "nl": [
      "In het 1e arrondissement van Lyon, in de rue du Bât d? Argent, waar de papillote werd uitgevonden, serveert het gastronomische restaurant La Quintessence een reeks spannende gerechten in een voormalige jezuïetenrefter uit de 16e eeuw."
    ],
    "es": [
      "En el distrito 1 de Lyon, en la rue du Bât d'Argent, donde se inventó el papillote, el restaurante gastronómico La Quintessence sirve una gran variedad de platos en un antiguo refectorio jesuita del siglo XVI."
    ]
  },
