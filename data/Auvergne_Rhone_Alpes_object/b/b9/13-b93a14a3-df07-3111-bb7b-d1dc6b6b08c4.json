  "rdfs:comment": {
    "de": [
      "ViaRhôna, von Saint-Gingolph nach Thonon-les-Bains.\r\nAn den Ufern des Genfer Sees, an der Grenze zur Schweiz, markiert Saint-Gingolph den Startpunkt der ViaRhôna-Route."
    ],
    "en": [
      "ViaRhôna, from Saint-Gingolph to Thonon-les-Bains.\r\nOn the shores of Lake Geneva, on the border with Switzerland, Saint-Gingolph marks the start of the ViaRhôna itinerary."
    ],
    "it": [
      "ViaRhôna, da Saint-Gingolph a Thonon-les-Bains.\r\nSulle rive del Lago di Ginevra, al confine con la Svizzera, Saint-Gingolph segna l'inizio del percorso della ViaRhôna."
    ],
    "fr": [
      "ViaRhôna, de Saint-Gingolph à Thonon-les-Bains.\r\nSur les berges du lac Léman, à la frontière avec la Suisse, Saint-Gingolph marque le départ de l’itinéraire ViaRhôna."
    ],
    "nl": [
      "ViaRhôna, van Saint-Gingolph naar Thonon-les-Bains.\r\nAan de oevers van het meer van Genève, op de grens met Zwitserland, markeert Saint-Gingolph het begin van de ViaRhôna-route."
    ],
    "es": [
      "ViaRhôna, de Saint-Gingolph a Thonon-les-Bains.\r\nA orillas del lago Lemán, en la frontera con Suiza, Saint-Gingolph marca el inicio de la ruta ViaRhôna."
    ]
  },
  "rdfs:label": {
    "de": [
      "ViaRhôna 01 - St-Gingolph > Thonon"
    ],
    "en": [
      "ViaRhôna by bike - Stage 01 - St-Gingolph > Thonon"
    ],
    "fr": [
      "ViaRhôna à vélo - Étape 01 - St-Gingolph > Thonon"
    ],
    "nl": [
      "ViaRhôna met de fiets - Etappe 01 - St-Gingolph > Thonon"
    ]
  },
