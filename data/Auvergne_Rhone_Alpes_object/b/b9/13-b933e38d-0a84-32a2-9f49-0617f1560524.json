  "rdfs:comment": {
    "de": [
      "In La Parenthèse ist die Bibliothek untergebracht. Mit ihrem gemütlichen Bereich sowie modulierbarem Mobiliar in einem 80 m² großen Raum kann sie nun zahlreiche Leser und Veranstaltungen empfangen."
    ],
    "en": [
      "La Parenthèse houses the library, with its conviviality area and modular furniture in an 80 m² room, and can now accommodate a large number of readers and events."
    ],
    "it": [
      "La Parenthèse ospita la biblioteca che, con la sua area di convivialità e l'arredamento modulare in una sala di 80 m², può ora ospitare un gran numero di lettori e di attività."
    ],
    "fr": [
      "La Parenthèse abrite la bibliothèque, avec son espace convivialité ainsi qu’un mobilier modulable dans un local de 80 m², elle peut désormais accueillir lecteurs en nombre et animations."
    ],
    "nl": [
      "La Parenthèse is de thuisbasis van de bibliotheek, met een gebruiksvriendelijke ruimte en modulair meubilair in een ruimte van 80 m², en biedt nu plaats aan een groot aantal lezers en evenementen."
    ],
    "es": [
      "La Parenthèse alberga la biblioteca, con su zona de convivencia y su mobiliario modular en una sala de 80 m², que ahora puede acoger a un gran número de lectores y actividades."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Bibliothèque \"La Parenthèse\" à Peyrus"
    ]
