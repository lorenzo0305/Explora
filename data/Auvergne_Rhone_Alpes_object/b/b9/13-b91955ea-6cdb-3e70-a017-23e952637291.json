  "rdfs:comment": {
    "de": [
      "Produktion von AB-Rindfleisch: Verkauf ab Hof auf Bestellung per E-Mail von Mai bis Dezember.\nProduktion von AB-Eiern: Der Verkauf erfolgt ab Hof - Bestellung per SMS.\nProduktion von AB-Gemüse zur Haltbarmachung (Kartoffeln, Kürbisse)"
    ],
    "en": [
      "AB beef production: sales at the farm by e-mail order from May to December.\nProduction of AB eggs: sales are made at the farm - reservation by sms.\nProduction of AB preserved vegetables (potatoes, pumpkins)."
    ],
    "it": [
      "Produzione di carne bovina AB: la vendita avviene in azienda tramite ordine via e-mail da maggio a dicembre.\nProduzione di uova AB: la vendita avviene in azienda - prenotazione via sms\nProduzione di ortaggi da conservazione AB (patate, zucche)"
    ],
    "fr": [
      "Production de viande bovine AB: la vente se fait à la ferme sur commande par e-mail de mai à décembre.\nProduction d'oeufs AB : la vente se fait à la ferme - Réservation par sms \nProduction de légumes AB de conservation ( pommes de terre, potimarrons)"
    ],
    "nl": [
      "Productie van AB-rundvlees: verkoop op de boerderij via e-mailbestelling van mei tot december.\nProductie van AB-eieren: verkoop op de boerderij - reservering per sms\nProductie van bewaargroenten (aardappelen, pompoenen)"
    ],
    "es": [
      "Producción de carne de vacuno AB: venta en la granja por pedido por correo electrónico de mayo a diciembre.\nProducción de huevos AB: venta en la granja - reservas por SMS.\nProducción de verduras ecológicas en conserva (patatas, calabazas)."
    ]
  },
  "rdfs:label": {
