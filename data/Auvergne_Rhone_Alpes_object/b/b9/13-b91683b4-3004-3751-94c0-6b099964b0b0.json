  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt ist dieses Hotel eine vertrauliche Adresse für Reisende, die auf Lebenskunst, disktrete Eleganz und einen natürlich großzügigen Service bedacht sind."
    ],
    "en": [
      "In the heart of the city, this hotel is a confidential address for connoisseurs of the art of living, discreet elegance, and naturally generous service."
    ],
    "it": [
      "Nel cuore della città, questo hotel è una struttura intima per viaggiatori che hanno a cuore l'arte di vivere, l'eleganza discreta e un servizio naturalmente generoso."
    ],
    "fr": [
      "Au cœur de la ville, cet hôtel est une adresse confidentielle pour les voyageurs soucieux d'art de vivre, de discrète élégance et de service naturellement généreux."
    ],
    "nl": [
      "In het hart van de stad is dit hotel een vertrouwelijk adres voor reizigers die gesteld zijn op levenskunst, discrete elegantie en natuurlijk genereuze service."
    ],
    "es": [
      "En pleno centro de la ciudad, este hotel es una opción particular para viajeros a los que les gusta disfrutar de la vida, que buscan elegancia, discreción y un servicio generoso."
    ]
  },
