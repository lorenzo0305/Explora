  "rdfs:comment": {
    "de": [
      "Immobilienspezialist in der Provence und Vaucluse seit 1960, mit 7 Büros zu Ihrer Verfügung. Finden Sie alle unsere Ankündigungen auf unserer Website."
    ],
    "en": [
      "Specialized in real estate in Drôme Provençale and Vaucluse since 1960, with 7 agencies at your service. Find all our announcements on our website."
    ],
    "it": [
      "Immobili in Provenza dal 1960.\r\nAl vostro servizio da 3 generazioni, cerchiamo di offrirvi i migliori immobili nella Drôme Provençale, nel Ventoux, nel Luberon e nelle Alpilles."
    ],
    "fr": [
      "Immobilier en Provence depuis 1960.\r\nA votre service depuis 3 générations, nous nous efforçons de vous proposer la meilleure offre immobilière sur le secteur de la Drôme Provençale, du Ventoux, du Luberon et des Alpilles."
    ],
    "nl": [
      "Vastgoed specialist in de Provence en Vaucluse sinds 1960, met 7 kantoor tot uw dienst. Vind al onze aankondigingen op onze website."
    ],
    "es": [
      "Inmobiliaria en Provenza desde 1960.\r\nA su servicio desde hace 3 generaciones, nos esforzamos por ofrecerle las mejores propiedades inmobiliarias en las zonas de Drôme Provençale, Ventoux, Luberon y Alpilles."
    ]
  },
