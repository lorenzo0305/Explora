  "rdfs:comment": {
    "de": [
      "Romanische Kirche aus dem 11. und 12. Jahrhundert, eine der ältesten an der Loire. Im Inneren ein außergewöhnliches Kulturerbe: Fresken aus dem Hochmittelalter und ein polychromer Holzchristus aus dem 12."
    ],
    "en": [
      "Romanesque church dating from the 11th and 12th centuries, one of the oldest in the Loire. Inside, exceptional cultural heritage: frescoes from the early Middle Ages and a polychrome wooden Christ from the 12th century."
    ],
    "it": [
      "Chiesa romanica dell'XI e XII secolo, una delle più antiche della Loira. All'interno si trova un patrimonio culturale eccezionale: affreschi dell'Alto Medioevo e un Cristo ligneo policromo del XII secolo."
    ],
    "fr": [
      "Eglise romane du XI et XIIème siècle, une des plus anciennes de la Loire. A l'intérieur, patrimoine culturel exceptionnel : fresques du haut Moyen Age et Christ en bois polychrome du XIIème siècle."
    ],
    "nl": [
      "Romaanse kerk uit de 11e en 12e eeuw, een van de oudste in de Loire. Binnen vind je een uitzonderlijk cultureel erfgoed: fresco's uit de vroege middeleeuwen en een polychrome houten Christus uit de 12e eeuw."
    ],
    "es": [
      "Iglesia románica de los siglos XI y XII, una de las más antiguas del Loira. En su interior, encontrará un patrimonio cultural excepcional: frescos de la Alta Edad Media y un Cristo de madera policromada del siglo XII."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Ste Marie du Vieux bourg de Cherier"
    ]
  },
