  "rdfs:comment": {
    "de": [
      "Das Centre Saint Martin ist eine alte romanische Kirche aus dem 12. Jahrhundert. Jahrhundert. Diese Kirche weist schöne, 1992 restaurierte Wandmalereien im Hahnentrittgewölbe und an den Wänden der Apsis auf."
    ],
    "en": [
      "A former Romanesque church of the XII. century disused in the late nineteenth century."
    ],
    "it": [
      "Il Centre Saint Martin è un'antica chiesa romanica del XII secolo. La chiesa presenta bellissimi dipinti murali restaurati nel 1992 sulla volta e sulle pareti dell'abside."
    ],
    "fr": [
      "Le Centre Saint Martin est une ancienne église romane datant du XIIe siècle. Cette église présente de belles peintures murales restaurées en 1992 sur la voûte en cul de poule et sur les murs de l’abside."
    ],
    "nl": [
      "Het Centre Saint Martin is een voormalige Romaanse kerk uit de 12e eeuw. Deze kerk heeft prachtige muurschilderingen die in 1992 zijn gerestaureerd op de bogen van de kip en op de muren van de apsis."
    ],
    "es": [
      "El Centro Saint Martin es una antigua iglesia románica del siglo XII. La iglesia cuenta con hermosas pinturas murales restauradas en 1992 en la bóveda y las paredes del ábside."
    ]
  },
