  "rdfs:comment": {
    "de": [
      "Esprit Fermier, das sind 12 Landwirte, die sich zusammengeschlossen haben, um eine neue Verkaufsstelle in Glisy, in der Nähe von Amiens, zu eröffnen."
    ],
    "en": [
      "Esprit Fermier is a group of 12 farmers who have joined forces to create a new sales outlet in Glisy, a stone's throw from Amiens."
    ],
    "it": [
      "Esprit Fermier è un gruppo di 12 agricoltori che si sono uniti per creare un nuovo punto vendita a Glisy, a due passi da Amiens."
    ],
    "fr": [
      "Esprit Fermier, ce sont 12 agriculteurs qui se sont associés pour créer un nouveau point de vente à Glisy, à deux pas d'Amiens."
    ],
    "nl": [
      "Esprit Fermier is een groep van 12 landbouwers die zich hebben verenigd om een nieuw verkooppunt op te richten in Glisy, op een boogscheut van Amiens."
    ],
    "es": [
      "Esprit Fermier es un grupo de 12 agricultores que se han unido para crear un nuevo punto de venta en Glisy, a un paso de Amiens."
    ]
