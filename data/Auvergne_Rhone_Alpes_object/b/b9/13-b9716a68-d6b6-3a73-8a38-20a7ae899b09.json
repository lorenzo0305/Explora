  "rdfs:comment": {
    "de": [
      "Tisch zur Orientierung\r\nEin atemberaubender Panoramablick, der eine Landschaftsbetrachtung von über 200 Grad ermöglicht.\r\nDer Orientierungstisch zeigt die wichtigsten sichtbaren Gipfel.\r\nAuch die lokale Flora und Fauna wird dargestellt."
    ],
    "en": [
      "Orientation table\r\nA breathtaking panoramic view that allows you to observe the landscape from over 200 degrees.\r\nThe interpretation table indicates the main visible peaks.\r\nLocal flora and fauna are also depicted."
    ],
    "it": [
      "Tavolo di orientamento\r\nUna vista panoramica mozzafiato che permette di osservare il paesaggio da oltre 200 gradi.\r\nLa tabella di interpretazione mostra le principali cime in vista.\r\nVengono inoltre descritte la flora e la fauna locali."
    ],
    "fr": [
      "Table d'orientation\r\nUne vue panoramique à couper le souffle qui permet une observation du paysage sur plus de 200 degrés.\r\nLa table d’interprétation indique les principaux sommets visibles.\r\nLa faune et la flore locale sont aussi représentées."
    ],
    "nl": [
      "Oriëntatietafel\r\nEen adembenemend panoramisch uitzicht waarmee je het landschap vanuit meer dan 200 graden kunt bekijken.\r\nDe interpretatietabel geeft de belangrijkste zichtbare bergtoppen aan.\r\nDe plaatselijke flora en fauna worden ook beschreven."
    ],
    "es": [
      "Mesa de orientación\r\nUna impresionante vista panorámica que permite observar el paisaje desde más de 200 grados.\r\nLa tabla de interpretación muestra los principales picos a la vista.\r\nTambién se describen la flora y la fauna locales."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Table d'orientation Les Trois Croix"
    ]
  },
