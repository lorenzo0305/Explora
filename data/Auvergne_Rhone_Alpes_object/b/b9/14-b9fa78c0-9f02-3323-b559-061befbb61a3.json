      "@id": "https://data.datatourisme.fr/b865c103-b5ac-3de6-9b20-a3db9c792409",
      "dc:description": {
        "de": [
          "Sportartikelgeschäft mit Schwerpunkt auf Fahrrädern in Boulogne-sur-Mer. Verkauf von Fahrrädern und Zubehör für alle Arten von Fahrrädern. Straße, Mountainbike, VAE, Gravel, VTC usw."
        ],
        "en": [
          "Sports goods store, specializing in bicycles, in Boulogne-sur-Mer. Sale of cycles and accessories for all types of bikes. Road, MTB, VAE, Gravel, VTC etc."
        ],
        "it": [
          "Negozio di articoli sportivi, specializzato in biciclette, a Boulogne-sur-Mer. Vendita di biciclette e accessori per tutti i tipi di bici. Strada, MTB, VAE, Gravel, VTC ecc."
        ],
        "fr": [
          "Magasin d'articles de sports, spécialisé dans le vélo, à Boulogne-sur-Mer. Vente de cycles et d'accessoires pour tous types de vélos. Route, VTT, VAE, Gravel, VTC etc."
        ],
        "es": [
          "Tienda de artículos deportivos, especializada en bicicletas, en Boulogne-sur-Mer. Venta de bicicletas y accesorios para todo tipo de bicicletas. Carretera, BTT, VAE, Gravel, VTC, etc."
        ],
        "nl": [
          "Sportzaak, gespecialiseerd in fietsen, in Boulogne-sur-Mer. Verkoop van fietsen en accessoires voor alle soorten fietsen. Weg, MTB, VAE, Gravel, VTC enz."
        ]
      },
