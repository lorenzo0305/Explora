  "rdfs:comment": {
    "de": [
      "Le Comptoir Équestre, der Erforscher des Pferdewohlbefindens, ist weit mehr als ein einfacher Händler von Pflegeprodukten für Pferde. Es ist ein Ort, an dem innovative Ideen rund um das Pferd entstehen und gedeihen."
    ],
    "en": [
      "Le Comptoir Équestre, an explorer of equine well-being, is much more than just a retailer of horse care products. It's a place where innovative ideas around the horse are born and nurtured."
    ],
    "it": [
      "Le Comptoir Équestre, esploratore del benessere equino, è molto più di un semplice rivenditore di prodotti per la cura del cavallo. È un luogo dove nascono e si sviluppano idee innovative sul cavallo."
    ],
    "fr": [
      "Le Comptoir Équestre, explorateur du bien-être équin, est bien plus qu’un simple revendeur de produits de soin pour chevaux. C’est un lieu où naissent et s’épanouissent des idées innovantes autour du cheval."
    ],
    "es": [
      "Le Comptoir Équestre, explorador del bienestar equino, es mucho más que un simple minorista de productos para el cuidado del caballo. Es un lugar donde nacen y crecen ideas innovadoras sobre los caballos."
    ],
    "nl": [
      "Le Comptoir Équestre, een ontdekkingsreiziger op het gebied van paardenwelzijn, is veel meer dan alleen een verkoper van paardenverzorgingsproducten. Het is een plek waar innovatieve ideeën over paarden worden geboren en gekweekt."
    ]
  },
  "rdfs:label": {
