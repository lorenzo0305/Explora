  "rdfs:comment": {
    "de": [
      "Ihr findet unsere traditionelle Küche, unsere Pizzen zum Verzehr vor Ort oder zum Mitnehmen, und sogar einen Lieferservice mit einer kleinen Überraschung!"
    ],
    "en": [
      "You will find our traditional cuisine, our pizzas to enjoy on-site or to take away, and even a delivery system with a little surprise!"
    ],
    "it": [
      "troverete i nostri ristoranti tradizionali, le pizze da mangiare o da portare via e persino un servizio di consegna a domicilio con una piccola sorpresa!"
    ],
    "fr": [
      "vous retrouverez notre restauration traditionnelle, nos pizzas sur place ou à emporter, et même un système de livraison avec une petite surprise !"
    ],
    "nl": [
      "Je zult onze traditionele keuken vinden, onze pizza’s om ter plaatse te eten of mee te nemen, en zelfs een leveringsservice met een kleine verrassing!"
    ],
    "es": [
      "Encontrarás nuestra cocina tradicional, nuestras pizzas para disfrutar en el local o para llevar, ¡y hasta un sistema de entrega con una pequeña sorpresa!"
    ]
  },
