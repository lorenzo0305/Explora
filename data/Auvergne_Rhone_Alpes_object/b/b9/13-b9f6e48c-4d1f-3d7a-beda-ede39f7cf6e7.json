  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Schwalbe, eine Boutique mit lokalen Designern, in der Sie das lokale Know-how kennenlernen können. Sie werden im Teesalon von Caroline empfangen, die für Sie auch einen Coworking-Bereich eingerichtet hat. Organisation von Tischlerei-Workshops."
    ],
    "en": [
      "Discover l'hirondelle, a boutique for local creators to discover local know-how. You'll be welcomed in Caroline's tearoom, where she's also set up a coworking space. Organization of woodworking workshops."
    ],
    "it": [
      "Scoprite l'hirondelle, una boutique di designer locali e scoprite il know-how locale. Sarete accolti nella sala da tè di Caroline, che ha anche allestito uno spazio di coworking. Organizzazione di laboratori di lavorazione del legno."
    ],
    "fr": [
      "Découvrez l'hirondelle,  une boutique de créateurs locaux pour découvrir le savoir-faire local. Vous serez accueillis dans le salon de thé de Caroline qui a aménagé pour vous également un espace de coworking. Organisation d'ateliers de menuiserie."
    ],
    "nl": [
      "Ontdek l'hirondelle, een boetiek voor lokale ontwerpers en ontdek lokale knowhow. Je wordt ontvangen in Caroline's tearoom, waar ze ook een coworkingruimte heeft ingericht. Organisatie van workshops houtbewerking."
    ],
    "es": [
      "Descubra l'hirondelle, una boutique para diseñadores locales y descubra el saber hacer local. Le acogerán en el salón de té de Caroline, donde también ha instalado un espacio de coworking. Organización de talleres de carpintería."
    ]
  },
  "rdfs:label": {
