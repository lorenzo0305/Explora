  "rdfs:comment": {
    "de": [
      "Der Janssen - Cocktail Club empfängt Sie in seiner unglaublichen Umgebung mit Blick auf den Mont-Blanc.\nCocktails der Haute Couture oder ein Glas erlesenen Weins, die Wahl wird am schwersten fallen, wenn Sie den großen Komfort seiner Sofas verlassen."
    ],
    "en": [
      "The Janssen - Cocktail Club welcomes you to its incredible setting overlooking Mont Blanc.\nWhether it's a haute-couture cocktail or a glass of fine wine, the hardest part is choosing and leaving the comfort of your sofas."
    ],
    "it": [
      "Il Janssen - Cocktail Club vi dà il benvenuto nella sua incredibile cornice con vista sul Monte Bianco.\nChe si tratti di un cocktail di alta moda o di un bicchiere di vino pregiato, la parte più difficile sarà scegliere e lasciare il comfort dei vostri divani."
    ],
    "fr": [
      "Le Janssen - Cocktail Club vous accueille dans son cadre incroyable avec vue sur le Mont-Blanc.\nCocktails haute-couture ou verre de vin raffiné, le plus dur sera de choisir et de quitter le grand confort de ses canapés."
    ],
    "es": [
      "El Janssen - Cocktail Club le da la bienvenida a su increíble entorno con vistas al Mont Blanc.\nYa sea un cóctel de alta costura o una copa de buen vino, lo más difícil será elegir y abandonar la comodidad de sus sofás."
    ],
    "nl": [
      "De Janssen - Cocktail Club heet je welkom in zijn ongelooflijke omgeving met uitzicht op de Mont Blanc.\nOf het nu gaat om een haute-couture cocktail of een glas goede wijn, het moeilijkste deel zal zijn om te kiezen en het comfort van uw sofa's te verlaten."
    ]
  },
