  "rdfs:comment": {
    "de": [
      "Mit Stéphanie, einer Keramikerin aus Voiron, betreten Sie die Welt der Bunnies, der handgeformten und handverzierten Keramikhasen. Ein kreatives Universum, das von dekorativ bis utilitaristisch reicht und alle Methoden der Bearbeitung von Ton und Glasuren erkundet."
    ],
    "en": [
      "With Stéphanie, a ceramist from Voiron, enter the world of Bunnies, hand-modeled and hand-decorated ceramic rabbits. A creative universe that ranges from the decorative to the utilitarian, exploring all methods of working with clay and glazes."
    ],
    "it": [
      "Unitevi a Stéphanie, ceramista di Voiron, ed entrate nel mondo dei Bunnies, conigli in ceramica modellati e decorati a mano. Un universo creativo che spazia dal decorativo all'utilitario, esplorando tutti i diversi metodi di lavorazione dell'argilla e degli smalti."
    ],
    "fr": [
      "Avec Stéphanie, céramiste voironnaise, entrez dans l'univers des Bunnies, des lapins en céramique, modelés et décorés à la main. Un univers créatif qui va du décoratif à l'utilitaire, explorant toutes les méthodes de travail de la terre et des émaux."
    ],
    "es": [
      "Únase a Stéphanie, ceramista de Voiron, y entre en el mundo de los Bunnies, conejos de cerámica modelados y decorados a mano. Un universo creativo que va de lo decorativo a lo utilitario, explorando todos los métodos de trabajo con la arcilla y los esmaltes."
    ],
    "nl": [
      "Ga mee met Stéphanie, een keramiste uit Voiron, en betreed de wereld van Bunnies, met de hand gemodelleerde en gedecoreerde keramische konijnen. Een creatief universum dat varieert van decoratief tot utilitair, waarbij alle verschillende methodes om met klei en glazuur te werken worden verkend."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Victoria Céramique"
    ]
  },
