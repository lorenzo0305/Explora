  "rdfs:comment": {
    "de": [
      "Stellen Sie sich eine geheimnisvolle, verschlossene Truhe vor, die eine Reihe von Rätseln enthält, die es zu lösen gilt... Mit Freunden oder der Familie müssen Sie suchen, kommunizieren und zusammenarbeiten, um das Geheimnis der Truhe zu lüften."
    ],
    "en": [
      "Imagine a mysterious locked chest containing a series of puzzles to solve... With friends or family, you'll have to search, communicate and cooperate to unlock the secret of the chest."
    ],
    "it": [
      "Immaginate un misterioso forziere chiuso a chiave che contiene una serie di enigmi da risolvere? Con gli amici o la famiglia, dovrete cercare, comunicare e cooperare per svelare il segreto del forziere."
    ],
    "fr": [
      "Imaginez un mystérieux coffre verrouillé, contenant une série d’énigmes à résoudre… Entre amis ou en famille, vous devrez fouiller, communiquer et coopérer pour percer le secret du coffre."
    ],
    "es": [
      "¿Te imaginas un misterioso cofre cerrado que contiene una serie de acertijos por resolver? Con amigos o familiares, tendrás que buscar, comunicarte y cooperar para desvelar el secreto del cofre."
    ],
    "nl": [
      "Stel je een mysterieuze afgesloten kist voor met een reeks raadsels die je moet oplossen? Samen met vrienden of familie moet je zoeken, communiceren en samenwerken om het geheim van de kist te ontrafelen."
    ]
  },
  "rdfs:label": {
    "de": [
      "Fluchtspiel in einem Kofferraum"
    ],
    "en": [
      "Escape game in a trunk"
    ],
    "fr": [
      "Escape coffre"
    ]
  },
