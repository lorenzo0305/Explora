  "rdfs:comment": {
    "de": [
      "Uto-Pic sind drei von einem Verein betriebene Gemeinschaftsarbeitsräume in Autrans, Villard-de-Lans und Lans-en-Vercors. Neben Großraumbüros finden Sie hier auch geschlossene Büros für Videokonferenzen, eine Küche, einen Besprechungsraum und eine Terrasse."
    ],
    "en": [
      "Uto-Pic is an associative shared workspace. In addition to a large, convivial main space with a kitchen area, a separate meeting room is available."
    ],
    "it": [
      "Uto-Pic è costituito da 3 spazi di lavoro condivisi a Autrans, Villard-de-Lans e Lans-en-Vercors, gestiti da un'associazione. Oltre agli spazi aperti, troverete uffici chiusi per videoconferenze, una cucina, una sala riunioni e una terrazza."
    ],
    "fr": [
      "Uto-Pic c'est 3 espaces de travail partagés à Autrans, Villard-de-Lans et Lans-en-Vercors, gérés par une association. En plus d’open space, vous y trouverez des bureaux fermés pour vos visio-conférences, une cuisine, une salle de réunion, une terrasse."
    ],
    "nl": [
      "Uto-Pic zijn 3 gedeelde werkruimten in Autrans, Villard-de-Lans en Lans-en-Vercors, beheerd door een vereniging. Naast open ruimtes vind je er gesloten kantoren voor videoconferenties, een keuken, een vergaderruimte en een terras."
    ],
    "es": [
      "Uto-Pic son 3 espacios de trabajo compartidos en Autrans, Villard-de-Lans y Lans-en-Vercors, gestionados por una asociación. Además de espacios abiertos, encontrarás despachos cerrados para videoconferencias, una cocina, una sala de reuniones y una terraza."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Uto-Pic - Espaces de Coworking"
    ]
  },
