  "rdfs:comment": {
    "de": [
      "10:30 Uhr: Lesung von Auszügen aus Aragon durch Marc-Henri Boisse: \"Le roman inachvé\" und \"les Poètes\".\r\n16 Uhr: Treffen mit Milène Tournier: Auszüge aus ihren Texten von Lurlure und Castor astral.\r\n18.30 Uhr: P'tite guinguette, Ausstellung der Zeichnungen von F. Drapier."
    ],
    "en": [
      "10:30 am: Reading of excerpts from Aragon by Marc-Henri Boisse: \"Le roman inachvé\" and \"Les Poètes\".\r\n4pm: Meeting with Milène Tournier: extracts from her texts published by Lurlure and Castor astral.\r\n6:30pm: P'tite guinguette, exhibition of drawings by F. Drapier."
    ],
    "it": [
      "10.30: Lettura di brani da Aragon di Marc-Henri Boisse: \"Le roman inachvé\" e \"les Poètes\".\r\nore 16.00: Incontro con Milène Tournier: estratti dai suoi testi pubblicati da Lurlure e Castor astral.\r\n18.30: P'tite guinguette, mostra di disegni di F. Drapier."
    ],
    "fr": [
      "10h30 : Lecture d'extraits d'Aragon par Marc-Henri Boisse : \"Le roman inachvé\" et \"les Poètes\".\r\n16h : Rencontre avec Milène Tournier : extraits de ses textes  de chez Lurlure et Castor astral.\r\n18h30 : P'tite guinguette, expo des dessins de F. Drapier."
    ],
    "nl": [
      "10u30: Lezing van fragmenten uit Aragon door Marc-Henri Boisse: \"Le roman inachvé\" en \"les Poètes\".\r\n16u: Ontmoeting met Milène Tournier: uittreksels uit haar teksten gepubliceerd door Lurlure en Castor astral.\r\n18u30: P'tite guinguette, tentoonstelling van tekeningen door F. Drapier."
    ],
    "es": [
      "10.30 h: Lectura de extractos de Aragon de Marc-Henri Boisse: \"Le roman inachvé\" y \"les Poètes\".\r\n16.00 h: Encuentro con Milène Tournier: extractos de sus textos publicados por Lurlure y Castor astral.\r\n18.30 h: P'tite guinguette, exposición de dibujos de F. Drapier."
    ]
  },
