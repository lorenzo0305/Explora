  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/17821aca-d48d-3b97-a47c-a863ff1bd8bd",
      "dc:description": {
        "de": [
          "Informationen :\n\nProdukte: Brot, Gebäck und Konditoreiwaren\n\nÖffnungszeiten:\nMontag bis Sonntag von 6:30 bis 19:00 Uhr\nSonntags von 6.30 bis 12.30 Uhr\n\nMittwochs geschlossen\n\nBestellung:\nEs besteht die Möglichkeit, 48 Stunden im Voraus telefonisch unter 03 21 15 38 47 zu bestellen\n\nAbholung:\nZum Mitnehmen während der Öffnungszeiten der Bäckerei\n\n "
        ],
        "en": [
          "Information :\n\nProducts: Bread, pastries and cakes\n\nOpening days:\nMonday to Sunday, 6.30am to 7pm\nSunday from 6.30am to 12.30pm\n\nClosed on Wednesday\n\nOrdering:\nOrders can be placed 48 hours in advance by telephone on 03 21 15 38 47\n\nPick-up:\nTakeaway during bakery opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nProdotti: Pane, pasticceria viennese e torte\n\nGiorni di apertura :\nDa lunedì a domenica dalle 6.30 alle 19.00\nDomenica dalle 6.30 alle 12.30\n\nChiuso il mercoledì\n\nCome ordinare :\nLe ordinazioni possono essere effettuate con 48 ore di anticipo telefonando al numero 03 21 15 38 47\n\nRitiro:\nDa asporto durante gli orari di apertura della pasticceria\n\n "
        ],
        "fr": [
          "Informations :\n\nProduits: Pains, viennoiseries et pâtisseries\n\nJours d'ouverture : \nDu lundi au dimanche de 6h30 à 19h\nLe dimanche de 6h30 à 12h30\n\nFermeture le mercredi\n\nCommande : \nPossibilité de commander, 48h avant, par téléphone au 03 21 15 38 47\n\nRetrait :\nÀ emporter aux horaires d'ouverture de la boulangerie\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nProducten: Brood, Weens gebak en taarten\n\nOpeningsdagen :\nMaandag tot zondag van 6.30 tot 19.00 uur\nZondag van 6.30 tot 12.30 uur\n\nWoensdag gesloten\n\nHoe bestellen?\nBestellingen kunnen 48 uur van tevoren telefonisch worden doorgegeven op 03 21 15 38 47\n\nAfhalen:\nAfhalen tijdens de openingstijden van de bakkerij\n\n "
        ],
        "es": [
          "Más información :\n\nProductos: Pan, bollería y pastelería\n\nDías de apertura :\nDe lunes a domingo de 6h30 a 19h00\nDomingo de 6h30 a 12h30\n\nMiércoles cerrado\n\nCómo hacer un pedido :\nLos pedidos pueden realizarse con 48 horas de antelación por teléfono llamando al 03 21 15 38 47\n\nRecogida:\nPara llevar durante el horario de apertura de la panadería\n\n "
        ]
      },
