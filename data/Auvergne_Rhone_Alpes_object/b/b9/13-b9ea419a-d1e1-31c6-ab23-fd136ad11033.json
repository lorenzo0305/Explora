  "rdfs:comment": {
    "de": [
      "Sie sind ein Kunstfan und kennen die Galerie Pasqui noch nicht?\r\nWir laden Sie ein, diesen Ausstellungsraum für zeitgenössische Kunst im Herzen von Saint-Etienne zu entdecken."
    ],
    "en": [
      "Are you an art fan who hasn't heard of Galerie Pasqui?\r\nWe invite you to discover this contemporary art exhibition space in the heart of Saint-Etienne."
    ],
    "it": [
      "Siete appassionati d'arte e non avete mai sentito parlare della Galerie Pasqui?\r\nVi invitiamo a scoprire questo spazio espositivo di arte contemporanea nel cuore di Saint-Etienne."
    ],
    "fr": [
      "Vous êtes fan d'art et vous ne connaissez pas la galerie Pasqui ?\r\nOn vous invite à découvrir cet espace d'exposition d'art contemporain en plein cœur de Saint-Etienne."
    ],
    "es": [
      "¿Es usted un aficionado al arte y no ha oído hablar de la Galerie Pasqui?\r\nLe invitamos a descubrir este espacio de exposición de arte contemporáneo en el corazón de Saint-Etienne."
    ],
    "nl": [
      "Ben je een kunstliefhebber die nog nooit van Galerie Pasqui heeft gehoord?\r\nWe nodigen je uit om deze expositieruimte voor hedendaagse kunst in het hart van Saint-Etienne te ontdekken."
    ]
  },
  "rdfs:label": {
