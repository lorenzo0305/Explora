  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Freude am Zeichnen, Malen und entdecken Sie die trockene Pastellmalerei.\r\nAgnès Prigent wird Sie in ihre Welt einführen und sie Ihnen vermitteln."
    ],
    "en": [
      "Come and discover the pleasure of drawing, painting and dry pastel.\r\nAgnès Prigent will introduce you to her world and share it with you."
    ],
    "it": [
      "Venite a scoprire il piacere del disegno, della pittura e del pastello secco.\r\nAgnès Prigent vi farà scoprire il suo mondo e ve lo trasmetterà."
    ],
    "fr": [
      "Venez découvrir le plaisir de dessiner, peintre et découvrir le pastel sec.\r\nAgnès Prigent vous feras découvrir son univers et vous le transmettre."
    ],
    "es": [
      "Venga a descubrir el placer del dibujo, la pintura y el pastel seco.\r\nAgnès Prigent te hará descubrir su mundo y te lo transmitirá."
    ],
    "nl": [
      "Kom en ontdek het plezier van tekenen, schilderen en droge pastel.\r\nAgnès Prigent zal je helpen haar wereld te ontdekken en aan jou door te geven."
    ]
  },
