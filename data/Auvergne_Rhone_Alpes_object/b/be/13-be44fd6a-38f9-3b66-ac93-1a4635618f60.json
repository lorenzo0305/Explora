  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses traditionelle Restaurant im Herzen des Plateau de Retord, wo die Authentizität der Gerichte und der herzliche Empfang Sie in die Atmosphäre der Berge eintauchen lassen. Für eine kurze Pause bietet Ihnen die Auberge ihre Snackbar und ihre Bar."
    ],
    "en": [
      "Discover this traditional restaurant in the heart of the Plateau de Retord, where authentic dishes and a warm welcome immerse you in the mountain atmosphere. For a short break, the Auberge also offers a snack bar."
    ],
    "it": [
      "Scoprite questo ristorante tradizionale, nel cuore del Plateau de Retord, dove l'autenticità dei piatti e la calorosa accoglienza vi faranno immergere nell'atmosfera di montagna. Per una breve pausa, l'Auberge dispone di uno snack bar e di un bar."
    ],
    "fr": [
      "Découvrez ce restaurant traditionnel, au cœur du Plateau de Retord, où l’authenticité des plats et l’accueil chaleureux vous plongent dans l’ambiance montagnarde. Pour une courte pause, l'Auberge vous propose son snack et son bar."
    ],
    "nl": [
      "Ontdek dit traditionele restaurant, in het hart van het Plateau de Retord, waar de authenticiteit van de gerechten en het warme onthaal je onderdompelen in de sfeer van de bergen. Voor een korte pauze heeft de Auberge een snackbar en een bar."
    ],
    "es": [
      "Descubra este restaurante tradicional, en el corazón del Plateau de Retord, donde la autenticidad de los platos y la cálida acogida le sumergirán en el ambiente de montaña. Para una breve pausa, el Auberge cuenta con un snack bar y un bar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de Cuvéry"
    ]
  },
