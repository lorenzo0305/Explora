  "rdfs:comment": {
    "de": [
      "100% französisches Fleisch, aus dem Schlachtkörper, überwiegend \"Label Rouge\".\r\nHausgemachte Wurstwaren: Wachteln, Perlhuhnterrine mit Morcheln, La Gervaisienne,... Hausgemachte Fertiggerichte.\r\nLebensmittelgeschäft, Brotverkauf und lokale Produkte."
    ],
    "en": [
      "100% French meat carcasses, mostly \"Label Rouge\".  \r\nHomemade charcuterie: local recipe faggots, young guinea fowl terrine with morel mushrooms,  La Gervaisienne, …  Homemade cooked dishes.\r\nGrocery store, bread and local products."
    ],
    "it": [
      "100% carne francese, carcassa, principalmente \"Label Rouge\".\r\nSalumi fatti in casa: caillettes, terrina di faraona con spugnole, La Gervaisienne, ecc. Piatti fatti in casa.\r\nNegozio di alimentari, pane e prodotti locali."
    ],
    "fr": [
      "Viande 100% française, en carcasse, majoritairement \"Label Rouge\".\r\nCharcuterie maison : caillettes, terrine de pintadeau aux morilles, La Gervaisienne,... Plats cuisinés maison.\r\nÉpicerie, dépôt de pain et produits locaux."
    ],
    "es": [
      "Carne 100% francesa, en canal, principalmente \"Label Rouge\".\r\nCharcutería casera: caillettes, terrina de pintada con colmenillas, La Gervaisienne, etc. Platos caseros.\r\nTienda de comestibles, pan y productos locales."
    ],
    "nl": [
      "100% Frans vlees, met bot, voornamelijk \"Label Rouge\".\r\nHuisgemaakte charcuterie: lebmaag, parelhoenterrine met morieljes, La Gervaisienne, etc. Huisgemaakte gerechten.\r\nKruidenier, brooddepot en lokale producten."
    ]
  },
