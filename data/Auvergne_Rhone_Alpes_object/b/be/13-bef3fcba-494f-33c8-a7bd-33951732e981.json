  "rdfs:comment": {
    "de": [
      "Authentisches Haus und Modell der ländlichen Architektur des 19. Jahrhunderts, das Heritage House, das Ökomuseum Grand-Bornand, zeugt von den Traditionen und dem Know-how, die die Identität des Dorfes geprägt haben."
    ],
    "en": [
      "Authentic house and a model of 19th century rural architecture, the Heritage House, the ecomuseum of Grand-Bornand, bears witness to the traditions and know-how that forge the identity of the village."
    ],
    "it": [
      "Casa autentica e modello di architettura rurale del XIX secolo, la Maison du Patrimoine, l'eco-museo di Grand-Bornand, testimonia le tradizioni e le competenze che hanno forgiato l'identità del villaggio."
    ],
    "fr": [
      "Authentique maison et modèle de l’architecture rurale du XIXe siècle, la Maison du patrimoine, écomusée du Grand-Bornand, est le témoin des traditions et des savoir-faire qui forgent l’identité du village."
    ],
    "nl": [
      "Het Maison du Patrimoine, het eco-museum van Grand-Bornand, is een authentiek huis en model van de 19e-eeuwse plattelandsarchitectuur en getuigt van de tradities en vaardigheden die de identiteit van het dorp hebben gevormd."
    ],
    "es": [
      "Auténtica casa y modelo de la arquitectura rural del siglo XIX, la Maison du Patrimoine, el ecomuseo de Grand-Bornand, es testigo de las tradiciones y el saber hacer que forjan la identidad del pueblo."
    ]
  },
