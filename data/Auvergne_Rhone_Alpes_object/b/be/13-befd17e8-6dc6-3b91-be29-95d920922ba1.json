  "rdfs:comment": {
    "de": [
      "Steve Renaudat ehrt die Produkte der Saison durch eine einfallsreiche Bistroküche. Mit Gerichten, die alle 14 Tage neu zubereitet werden, und einer freundlichen Atmosphäre entdecken Sie die Küche dieses leidenschaftlichen Küchenchefs!"
    ],
    "en": [
      "Steve Renaudat honors seasonal produce with inventive bistronomic cuisine. With dishes renewed every 15 days and a friendly atmosphere, discover the cuisine of this passionate chef!"
    ],
    "it": [
      "Steve Renaudat mette a frutto i prodotti di stagione nella sua inventiva cucina da bistrot. Con piatti che cambiano ogni 15 giorni e un'atmosfera amichevole, scoprite la cucina di questo chef appassionato!"
    ],
    "fr": [
      "Steve Renaudat met à l’honneur les produits de saison à travers une cuisine bistronomique inventive. Avec des plats renouvelés tous les 15 jours et une ambiance conviviale, découvrez la cuisine de ce chef passionné !"
    ],
    "es": [
      "Steve Renaudat utiliza los productos de temporada en su cocina de bistró. Con platos que cambian cada 15 días y un ambiente acogedor, ¡descubra la cocina de este apasionado chef!"
    ],
    "nl": [
      "Steve Renaudat gebruikt seizoensproducten in zijn inventieve bistrokeuken. Met gerechten die elke 15 dagen veranderen en een vriendelijke sfeer, ontdek de keuken van deze gepassioneerde chef-kok!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Instant Présent"
    ]
  },
