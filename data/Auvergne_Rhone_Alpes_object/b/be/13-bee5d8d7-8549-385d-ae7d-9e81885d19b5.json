  "rdfs:comment": {
    "de": [
      "Eine einzigartige Herberge am Fuße der Ruinen des Schlosses Crussol, in einem geschützten Naturgebiet, mit einem herrlichen Blick auf die Hänge von Saint-Péray und Cornas."
    ],
    "en": [
      "A unique restaurant, at the foot of the ruins of Crussol castle, in a protected natural area, with a splendid view of the hills of Saint-Péray and Cornas."
    ],
    "it": [
      "Un ostello unico, ai piedi delle rovine del Castello di Crussol, in un'area naturale protetta, con una splendida vista sulle colline di Saint-Péray e Cornas."
    ],
    "fr": [
      "Une auberge unique, au pied des ruines du château de Crussol, dans un espace naturel protégé, avec une vue splendide sur les coteaux de Saint-Péray et de Cornas."
    ],
    "es": [
      "Un albergue único, al pie de las ruinas del Château de Crussol, en una zona natural protegida, con una espléndida vista de las laderas de Saint-Péray y Cornas."
    ],
    "nl": [
      "Een unieke herberg, aan de voet van de ruïnes van het kasteel van Crussol, in een beschermd natuurgebied, met een prachtig uitzicht op de heuvels van Saint-Péray en Cornas."
    ]
  },
