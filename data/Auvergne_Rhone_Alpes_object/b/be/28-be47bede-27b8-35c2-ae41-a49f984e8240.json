  "rdfs:comment": {
    "de": [
      "Das Bistrot de Paris liegt auf dem Grand'Place gegenüber dem Abteiturm. Das Bistronomierestaurant bietet Ihnen eine Küche aus frischen und saisonalen Produkten."
    ],
    "en": [
      "Located on the main square in front of the abbey tower, the Bistrot de Paris, a Bistronomic restaurant, offers you a cuisine based on fresh and seasonal products."
    ],
    "it": [
      "Situato sulla Grand'Place, di fronte alla torre dell'abbazia, il Bistrot de Paris, ristorante bistronomico, offre una cucina a base di prodotti freschi e di stagione."
    ],
    "fr": [
      "Situé sur la grand'place face à la tour abbatiale, le Bistrot de Paris, restaurant Bistronomique, vous propose une cuisine à base de produits frais et de saison."
    ],
    "es": [
      "Situado en la Grand'Place, frente a la torre de la abadía, el Bistrot de Paris, restaurante bistronómico, ofrece una cocina basada en productos frescos y de temporada."
    ],
    "nl": [
      "De Bistrot de Paris, een bistronomisch restaurant op de Grand'Place tegenover de abdijtoren, biedt een keuken op basis van verse, seizoensgebonden producten."
    ]
  },
