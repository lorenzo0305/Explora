  "rdfs:comment": {
    "de": [
      "Zeitgenössische Kunst - Skulptur - Malerei - Keramik\r\nCôté arts ist ein Ort, der der Kunst gewidmet ist; ein buntes Universum voller Poesie und Energie, das zwei Künstlerinnen aus der Gegend vereint: Alexandrine Aimé, Bildhauerin, Keramikerin, und Nadine Nacinovic, Malerin."
    ],
    "en": [
      "Contemporary art - Sculpture - Painting - Ceramics\r\nCôté arts is a place dedicated to art; a colorful universe full of poetry and energy, bringing together two local artists, Alexandrine Aimé, sculptor and ceramist, and Nadine Nacinovic, painter."
    ],
    "it": [
      "Arte contemporanea? Scultura? Pittura ? Ceramica\r\nCôté arts è un luogo dedicato all'arte; un universo colorato e pieno di poesia ed energia, che riunisce due artiste locali, Alexandrine Aimé, scultrice e ceramista, e Nadine Nacinovic, pittrice"
    ],
    "fr": [
      "Art contemporain – Sculpture – Peinture – Céramique\r\nCôté arts est un lieu dédié à l’art ; un univers coloré emprunt de poésie et d’énergie, qui réunit deux artistes du coin, Alexandrine Aimé, sculptrice, céramiste et Nadine Nacinovic, peintre"
    ],
    "es": [
      "¿Arte contemporáneo? ¿Escultura? Pintura ? Cerámica\r\nCôté arts es un lugar dedicado al arte; un universo colorido lleno de poesía y energía, que reúne a dos artistas locales, Alexandrine Aimé, escultora y ceramista, y Nadine Nacinovic, pintora"
    ],
    "nl": [
      "Hedendaagse kunst - Beeldhouwen - Schilderen - Keramiek\r\nCôté arts is een plek gewijd aan kunst; een kleurrijk universum vol poëzie en energie, dat twee plaatselijke kunstenaars samenbrengt: Alexandrine Aimé, beeldhouwer en keramist, en Nadine Nacinovic, schilderes."
    ]
  },
