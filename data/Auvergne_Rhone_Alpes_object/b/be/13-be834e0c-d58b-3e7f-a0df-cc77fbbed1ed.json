  "rdfs:comment": {
    "de": [
      "Diese Brasserie in Clermont-Ferrand außerhalb des Stadtzentrums bietet eine 100% hausgemachte Küche aus frischen Zutaten.\r\nDer Service ist schnell und wird von einem dynamischen und herzlichen Team gewährleistet."
    ],
    "en": [
      "This Clermont-Ferrand brasserie just outside the city center offers 100% home-cooked cuisine based on fresh produce.\r\nService is fast and provided by a dynamic, friendly team."
    ],
    "it": [
      "Questa brasserie di Clermont-Ferrand, appena fuori dal centro della città, serve una cucina casalinga al 100% a base di prodotti freschi.\r\nIl servizio è veloce e curato da un team dinamico e cordiale."
    ],
    "fr": [
      "Cette brasserie clermontoise située à l'extérieur du centre ville propose une cuisine 100% maison à base de produits frais. \r\nLe service est rapide et assuré par une équipe dynamique et chaleureuse."
    ],
    "es": [
      "Esta brasserie de Clermont-Ferrand, a las afueras del centro de la ciudad, sirve comida 100% casera elaborada con productos frescos.\r\nEl servicio es rápido y está atendido por un equipo dinámico y amable."
    ],
    "nl": [
      "Deze brasserie in Clermont-Ferrand net buiten het stadscentrum serveert 100% huisgemaakte gerechten met verse producten.\r\nDe bediening is snel en wordt verzorgd door een dynamisch en vriendelijk team."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brasserie le Jules Verne"
    ]
  },
