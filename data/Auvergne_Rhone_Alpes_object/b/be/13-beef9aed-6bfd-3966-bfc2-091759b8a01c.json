  "rdfs:comment": {
    "de": [
      "Vom Place Opinel aus folgen Sie einem Waldweg, der zu einer atemberaubenden Aussicht auf die Aiguilles d'Arves führt, bevor Sie durch den Wald zum Collet gelangen."
    ],
    "en": [
      "Starting from Place Opinel, follow a forest trail that leads to a breathtaking view of the Aiguilles d'Arves before reaching Le Collet through the forest."
    ],
    "it": [
      "Lasciata la Place Opinel, si segue una pista forestale che conduce a una vista mozzafiato sulle Aiguilles d'Arves prima di raggiungere il Collet attraverso il bosco."
    ],
    "fr": [
      "Au départ de la Place Opinel, parcourez une piste forestière qui débouchera sur une vue imprenable des Aiguilles d'Arves avant de rejoindre le Collet par la forêt."
    ],
    "es": [
      "Saliendo de la Place Opinel, siga una pista forestal que conduce a una vista impresionante de las Aiguilles d'Arves antes de llegar al Collet a través del bosque."
    ],
    "nl": [
      "Als je de Place Opinel verlaat, volg je een bospad dat leidt naar een adembenemend uitzicht op de Aiguilles d'Arves voordat je door het bos de Collet bereikt."
    ]
  },
