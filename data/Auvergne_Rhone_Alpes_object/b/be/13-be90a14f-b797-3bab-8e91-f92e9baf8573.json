  "rdfs:comment": {
    "de": [
      "Gerichte zum Mitnehmen: Pizzas, Kebab jeden Abend von Dienstag bis einschließlich Sonntag.\r\nBestellen Sie unter 04 72 31 19 82.\r\nTraditionelles Restaurant und Pizzeria vor Ort und zum Mitnehmen. Donnerstagabends wird ein Themenmenü angeboten."
    ],
    "en": [
      "Takeaway meals: pizzas, kebabs every evening from Tuesday to Sunday inclusive.\r\nPlace your order on 04 72 31 19 82.\r\nTraditional restaurant and pizzeria on site and takeaway. Theme menu proposed on Thursday evenings."
    ],
    "it": [
      "Cibo da asporto: pizze, kebab tutte le sere dal martedì alla domenica compresa.\r\nOrdinare al numero 04 72 31 19 82.\r\nRistorante tradizionale e pizzeria in loco e da asporto. Menù a tema disponibile il giovedì sera."
    ],
    "fr": [
      "Plats à emporter : pizzas, kebabs tous les soirs du mardi au dimanche inclus.\r\nPassez commande au 04 72 31 19 82.\r\nRestaurant traditionnel et pizzeria sur place et à emporter. Menu thématique proposé les jeudis soirs."
    ],
    "es": [
      "Comida para llevar: pizzas, kebabs todas las noches de martes a domingo inclusive.\r\nPida en el 04 72 31 19 82.\r\nRestaurante tradicional y pizzería in situ y para llevar. Menú temático disponible los jueves por la noche."
    ],
    "nl": [
      "Afhaalmaaltijden: pizza's, kebab elke avond van dinsdag tot en met zondag.\r\nBestel op 04 72 31 19 82.\r\nTraditioneel restaurant en pizzeria ter plaatse en om mee te nemen. Themamenu beschikbaar op donderdagavond."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Pizzeria La Belle Etoile"
    ]
  },
