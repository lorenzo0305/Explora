  "rdfs:comment": {
    "de": [
      "Einzigartiges Freizeitzentrum, 30 min. von Annecy und 15 min. von Genf entfernt. Es vereint an einem einzigen Ort mehrere Freizeitbereiche auf einmal \r\n(Wassersport, großer Spielebereich \"Vitam'ludic\", Wellness & Spa, Top in Form, Schneeschuhwandern, Klettern), eine Shopping-Galerie, Restaurants und ein Hotel."
    ],
    "en": [
      "A unique leisure centre, 30 minutes from Annecy and 15 minutes from Geneva. It brings together many leisure options within one space (Aquatic, Vitam'Ludic, Wellbeing & Spa, Fitness, racket sports and climbing), a shopping gallery and restaurants"
    ],
    "it": [
      "Un centro ricreativo decisamente unico a 30 min da Annecy e a 15 min da Ginevra. Vari spazi ricreativi sono riuniti in un unico luogo (Acquatica, Vitam'ludic, Benessere & Spa, Forma, Sport con racchetta e Arrampicata), nonché la galleria per lo shopping, ristoranti e un hotel."
    ],
    "fr": [
      "Un centre de loisirs unique à 30 mn d’Annecy et à 15 mn de Genève. Il rassemble en un seul lieu plusieurs espaces loisirs (Aquatique, Bien-être & Spa, Forme, Sports de raquettes, Escalade et Vitam’ludic) ainsi que des points de restauration"
    ],
    "es": [
      "Un centro único de ocio a 30 minutos de Annecy y a 15 de Ginebra. Reúne en un solo lugar varios espacios de ocio (acuático, Vitam’ludic, bienestar y spa, puesta en forma, deportes de raquetas y escalada), una galería comercial, restaurantes y un hotel."
    ],
    "nl": [
      "Een uniek vrijetijdscentrum op 30 min van Annecy en 15 min van Genève. Op één en dezelfde plek zijn meerdere recreatieruimtes (Wateractiviteiten, Vitam’ludic, Welzijn & Spa, Sport, Raket- en klimsporten), een winkelgalerij, restaurants en een hotel verzameld."
    ]
  },
