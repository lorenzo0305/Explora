  "rdfs:comment": {
    "de": [
      "Pizzeria im Herzen von Pont-d'Ain nur wenige Schritte vom Fluss entfernt.\r\n\r\nInfo Covid-19: hält Pizzas zum Mitnehmen bereit + Dienstag bis Freitag mittags Gerichte zum Mitnehmen. Informationen auf Facebook und Website"
    ],
    "en": [
      "Pizzeria, restaurant"
    ],
    "it": [
      "Pizzeria nel cuore di Pont-d'Ain, a due passi dal fiume.\r\n\r\nInfo covid-19: tiene pizze da asporto + vendita da asporto dal martedì al venerdì a pranzo. informazioni su Facebook e sito web"
    ],
    "fr": [
      "Pizzeria au cœur de Pont-d'Ain a deux pas de la rivière.\r\n\r\nInfo covid-19: maintient des pizzas a emporter + du mardi au vendredi le midi vente de plat a emporter. information sur Facebook et site internet"
    ],
    "nl": [
      "Pizzeria in het hart van Pont-d'Ain, op een steenworp afstand van de rivier.\r\n\r\nInfo covid-19: onderhoudt pizza's om mee te nemen + van dinsdag tot vrijdag tussen de middag verkoop van afhaalmaaltijden. informatie op Facebook en website"
    ],
    "es": [
      "Pizzería en el corazón de Pont-d'Ain, a un paso del río.\r\n\r\nInformación covid-19: mantiene las pizzas para llevar + venta de martes a viernes de comida para llevar. información en Facebook y en la página web"
    ]
  },
