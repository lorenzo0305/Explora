  "rdfs:comment": {
    "de": [
      "Der Küchenchef bietet Ihnen traditionelle französische Küche mit gegrilltem und geschmortem Fleisch sowie italienische Küche\r\nIn der Pizzeria können Sie leckere Pizzen und Lasagne aus dem Holzofen genießen."
    ],
    "en": [
      "The chef offers traditional French cuisine based on grilled meats and in sauce as well as Italian cuisine\r\nOn the pizzeria side, enjoy tasty pizzas and wood-fired lasagne."
    ],
    "it": [
      "Lo chef propone una cucina francese tradizionale con carni e salse alla griglia e una cucina italiana\r\nNella pizzeria potrete gustare gustose pizze e lasagne cotte sul fuoco a legna."
    ],
    "fr": [
      "Le chef cuisinier vous propose une cuisine française traditionnelle à base de viandes grillées et en sauce ainsi qu'une cuisine italienne. \r\nCôté pizzeria, dégustez de savoureuses pizzas et des lasagnes cuites au feu de bois."
    ],
    "es": [
      "El chef ofrece cocina tradicional francesa con carnes y salsas a la parrilla, así como cocina italiana\r\nEn la pizzería, podrá disfrutar de sabrosas pizzas y lasañas cocinadas a fuego de leña."
    ],
    "nl": [
      "De chef serveert traditionele Franse gerechten met gegrild vlees en sauzen en Italiaanse gerechten\r\nIn de pizzeria kunt u genieten van smakelijke pizza's en lasagne die boven een houtvuur worden bereid."
    ]
  },
