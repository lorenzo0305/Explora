  "rdfs:comment": {
    "de": [
      "Mit 250 m2 Kletterfläche bietet der Boulder de l'Ours eine große Vielfalt an Parcours und Stimmungen für jedes Niveau. Vom Kletteranfänger bis zum erfahrenen Sportler oder für Familien auf der Suche nach einer spielerischen Aktivität kann sich jeder in seinem eigenen Rhythmus entwickeln."
    ],
    "en": [
      "With 250m2 of climbing space, the Boulder de l'Ours offers a wide variety of routes and climbs to suit all levels. From beginners to experienced climbers, or families looking for a fun activity, everyone can progress at their own pace."
    ],
    "it": [
      "Con 250 m2 di spazio per l'arrampicata, il Boulder de l'Ours offre un'ampia varietà di percorsi e ambienti adatti a tutti i livelli. Dai principianti agli arrampicatori esperti, o alle famiglie in cerca di un'attività divertente, ognuno può progredire al proprio ritmo."
    ],
    "fr": [
      "Avec 250m2 de surface de grimpe, le bloc de l’Ours propose une large variété de parcours, d’ambiances, adaptés à tous niveaux. Du grimpeur débutant au sportif confirmé ou pour les familles en quête d’une activité ludique, chacun peut évoluer à son rythme."
    ],
    "nl": [
      "Met 250m2 klimruimte biedt de Boulder de l'Ours een grote verscheidenheid aan routes en omgevingen voor alle niveaus. Van beginners tot ervaren klimmers, of gezinnen op zoek naar een leuke activiteit, iedereen kan in zijn eigen tempo vooruitgang boeken."
    ],
    "es": [
      "Con 250m2 de espacio de escalada, el Boulder de l'Ours ofrece una gran variedad de vías y entornos para todos los niveles. Desde principiantes a escaladores experimentados, o familias en busca de una actividad divertida, todos pueden progresar a su propio ritmo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le bloc de l'Ours"
    ]
  },
