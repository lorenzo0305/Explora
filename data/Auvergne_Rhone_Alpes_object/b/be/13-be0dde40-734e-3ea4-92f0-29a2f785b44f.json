  "rdfs:comment": {
    "de": [
      "Endé ist ein französisches Haus, das Schmuckstücke aus Hochsavoyen herstellt, die fein aus den Bergen stammen und Sinn und Emotionen vermitteln. Handgefertigte Kreationen, die mit dem Herzen erdacht und in Armoy am Genfer See von Hand hergestellt werden."
    ],
    "en": [
      "Endé is a French company that makes jewelry from Haute-Savoie, with a mountain touch and a sense of meaning and emotion. Handcrafted creations, imagined from the heart and handmade in Armoy on the shores of Lake Geneva."
    ],
    "it": [
      "Endé è un'azienda francese che produce gioielli della regione dell'Alta Savoia, finemente lavorati in montagna e ricchi di significato ed emozione. Creazioni artigianali, pensate con il cuore e realizzate a mano ad Armoy, sulle rive del Lago di Ginevra."
    ],
    "fr": [
      "Endé est une maison française de fabrication de bijoux bijoux haut-savoyards, finement montagnards, porteurs de sens et d’émotion. Des créations artisanales, imaginées avec le cœur et fabriquées à la main à Armoy sur les rives du lac Léman."
    ],
    "nl": [
      "Endé is een Frans bedrijf dat sieraden maakt uit de Haute-Savoie, fijn bewerkt in de bergen en vol betekenis en emotie. Handgemaakte creaties, bedacht vanuit het hart en handgemaakt in Armoy aan de oevers van het meer van Genève."
    ],
    "es": [
      "Endé es un fabricante francés de joyas con sede en la Alta Saboya, que produce joyas con aire montañés, llenas de significado y emoción. Creaciones artesanales, imaginadas con el corazón y hechas a mano en Armoy, a orillas del lago Lemán."
    ]
  },
