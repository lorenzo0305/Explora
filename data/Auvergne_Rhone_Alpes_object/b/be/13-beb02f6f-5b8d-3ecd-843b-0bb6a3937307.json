  "rdfs:comment": {
    "de": [
      "Ob am Strand mit überwachtem Badebereich oder in den grasbewachsenen Buchten, die Freizeitbasis von les Iles bietet echte Momente der Entspannung und Erholung"
    ],
    "en": [
      "Whether on the beach with its supervised swimming area or in the grassy coves, the leisure base of les Iles offers real moments of relaxation and recreation"
    ],
    "it": [
      "In spiaggia, con la sua area balneare sorvegliata, o nelle calette erbose, il centro ricreativo dell'isola offre veri e propri momenti di relax e svago"
    ],
    "fr": [
      "Que ce soit sur la plage aménagée avec sa zone de baignade surveillée ou dans les criques herbeuses, la base de loisir des îles offre de vrais moments de détente et de loisirs"
    ],
    "es": [
      "Ya sea en la playa con su zona de baño vigilada o en las calas de hierba, el centro de ocio de las islas ofrece verdaderos momentos de relajación y recreo"
    ],
    "nl": [
      "Op het strand met bewaakte badzone of in de kreken met gras, het recreatiecentrum van het eiland biedt echte momenten van ontspanning en recreatie"
    ]
  },
