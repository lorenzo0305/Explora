  "rdfs:comment": {
    "de": [
      "La Table du MiL8, eine schicke Brasserie in Avoriaz, verwöhnt Sie mittags und abends. Morgens: hausgemachtes Frühstück. Mittags: BBQ, Salate und Streetfood. Abends: raffinierte Gerichte, lokale Fleischsorten und leckere Desserts. Terrasse mit Blick auf die Berge."
    ],
    "en": [
      "La Table du MiL8, a chic brasserie in Avoriaz, welcomes you for lunch and dinner. In the morning, enjoy a homemade breakfast. At lunchtime: BBQ, salads and street food. In the evening: refined dishes, local meats and indulgent desserts. Terrace with mountain views."
    ],
    "it": [
      "La Table du MiL8, brasserie chic di Avoriaz, vi delizierà a pranzo e a cena. Al mattino, colazione fatta in casa. A pranzo: barbecue, insalate e street food. La sera: piatti raffinati, carni locali e dessert gourmet. Terrazza con vista sulle montagne."
    ],
    "fr": [
      "La Table du MiL8, une brasserie chic à Avoriaz, vous régale midi et soir. Le matin, petit-déjeuner maison. Le midi : BBQ, salades et street-food. Le soir : plats raffinés, viandes locales et desserts gourmands. Terrasse avec vue sur les montagnes."
    ],
    "es": [
      "La Table du MiL8, una elegante brasserie de Avoriaz, le deleitará para el almuerzo y la cena. Por la mañana, un desayuno casero. A mediodía: barbacoa, ensaladas y street food. Por la noche: platos refinados, carnes locales y postres gourmet. Terraza con vistas a la montaña."
    ],
    "nl": [
      "La Table du MiL8, een chique brasserie in Avoriaz, verwelkomt u voor lunch en diner. ’s Ochtends wordt een huisgemaakt ontbijt geserveerd. Tijdens de lunch: BBQ, salades en streetfood. ’s Avonds: verfijnde gerechten, lokale vleessoorten en heerlijke desserts. Terras met uitzicht op de bergen."
    ]
  },
  "rdfs:label": {
    "en": [
      "The Mil8 restaurant"
    ],
