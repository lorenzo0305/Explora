  "rdfs:comment": {
    "de": [
      "Sanitäranlagen, Waschbecken, Holz, Eisenwaren, Farbe, Elektrizität, Tischlerei usw.\r\nWir sammeln, richten ein und verkaufen bald Materialien zu freien Preisen. Bastler, Anhänger der Wiederverwertung, schließen Sie sich uns an!"
    ],
    "en": [
      "Sanitaryware, sinks, wood, hardware, paint, electricity, carpentry and more...\r\nWe collect, furnish and soon sell materials at free prices. Do-it-yourselfers and recycling enthusiasts, join us!"
    ],
    "it": [
      "Sanitari, lavandini, legno, ferramenta, vernici, elettricità, falegnameria ecc...\r\nRaccogliamo, allestiamo e presto venderemo i materiali a prezzo libero. Gli amanti del fai-da-te e del riciclo si uniscano a noi!"
    ],
    "fr": [
      "Sanitaires, éviers, bois, quincaillerie, peinture, électricité, menuiseries etc...\r\nOn collecte, on aménage, et bientôt on vend à prix libre des matériaux. Bricoleurs, adeptes de la récup., rejoignez-nous !"
    ],
    "es": [
      "Sanitarios, fregaderos, madera, ferretería, pintura, electricidad, carpintería, etc.\r\nRecogemos, acondicionamos y pronto venderemos materiales a precio libre. Aficionados al bricolaje y al reciclaje, ¡únanse a nosotros!"
    ],
    "nl": [
      "Sanitair, gootstenen, hout, ijzerwaren, verf, elektriciteit, schrijnwerkerij enz...\r\nWe zamelen in, we richten in en binnenkort verkopen we materialen tegen vrije prijzen. Doe-het-zelvers en recyclers, kom erbij!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Matériauthèque  BIS-USUS"
    ]
  },
