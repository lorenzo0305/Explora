  "rdfs:comment": {
    "de": [
      "Keksfabrik im Herzen der Dombes, gute Kekse mit dem guten Geschmack unserer lokalen Produkte!\r\nHerstellung von Cookies, Sablés, Choco-Drèche, Sablés gourmands, Schokoriegeln, Karamell mit gesalzener Butter..."
    ],
    "en": [
      "Biscuiterie in the heart of the Dombes region, delicious cookies made with local ingredients!\r\nProduction of cookies, shortbread, madeleines, financiers, choco-drèche palets, gourmet shortbread, florentines, savory cakes..."
    ],
    "it": [
      "Biscottificio nel cuore delle Dombes, biscotti divini con il grande gusto dei nostri prodotti locali!\r\nProduzione di biscotti, frollini e barrette di cioccolato\r\nBurro di Etre, farina di grano tenero dell'Atelier de Niermont e uova intere della Ferme du Bertholon"
    ],
    "fr": [
      "Biscuiterie au cœur de la Dombes, de divins biscuits au bon goût de nos produits locaux !\r\nFabrication de cookies, sablés et barres chocolatées\r\nBeurre Etre, Farine de blé tendre Atelier de Niermont et oeufs plein Ferme du Bertholon"
    ],
    "nl": [
      "Koekjesfabriek in het hart van de Dombes, goddelijke koekjes met de heerlijke smaak van onze lokale producten!\r\nProductie van koekjes, zandkoekjes en chocoladerepen\r\nEtre-boter, zachte tarwebloem van Atelier de Niermont en volvette eieren van Ferme du Bertholon"
    ],
    "es": [
      "Fábrica de galletas en el corazón de las Dombes, ¡galletas divinas con el gran sabor de nuestros productos locales!\r\nProducción de galletas, shortbread y barras de chocolate\r\nMantequilla Etre, harina de trigo blando del Atelier de Niermont y huevos enteros de la Ferme du Bertholon"
    ]
  },
  "rdfs:label": {
    "de": [
      "Hestia Keksfabrik"
    ],
    "fr": [
      "Hestia Biscuiterie"
    ]
  },
