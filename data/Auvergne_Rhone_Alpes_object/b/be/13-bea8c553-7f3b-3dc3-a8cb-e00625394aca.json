  "rdfs:comment": {
    "de": [
      "Nachdem er seine Sporen bei Têtedoie und La Mère Vittet abverdient hat, übernimmt Frédéric Therriaud die Leitung des Plato in La Croix-Rousse. Er bietet eine marktfrische Küche, indem er die Klassiker mit seinen kreativen Gerichten verbindet."
    ],
    "en": [
      "After having made his debut at Têtedoie and La Mère Vittet, Frédéric Therriaud took over the reins of Le Plato in La Croix-Rousse, offering market cuisine by combining the classics with his creative dishes."
    ],
    "it": [
      "Dopo aver lavorato alla Têtedoie e a La Mère Vittet, Frédéric Therriaud ha preso le redini del Plato a La Croix-Rousse, proponendo una cucina di mercato che combina i classici con i suoi piatti creativi."
    ],
    "fr": [
      "Après avoir fait ses armes chez Têtedoie et La Mère Vittet, Frédéric Therriaud  prend les rênes du Plato à La Croix-Rousse en proposant une cuisine du marché en conjuguant les classiques et ses plats créatifs."
    ],
    "es": [
      "Tras haber trabajado en Têtedoie y La Mère Vittet, Frédéric Therriaud tomó las riendas de Plato en La Croix-Rousse, proponiendo una cocina de mercado combinando los clásicos con sus platos creativos."
    ],
    "nl": [
      "Na gewerkt te hebben bij Têtedoie en La Mère Vittet nam Frédéric Therriaud de leiding over van Plato in La Croix-Rousse. Hij biedt een marktkeuken door de klassiekers te combineren met zijn creatieve gerechten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plato Restaurant"
    ]
  },
