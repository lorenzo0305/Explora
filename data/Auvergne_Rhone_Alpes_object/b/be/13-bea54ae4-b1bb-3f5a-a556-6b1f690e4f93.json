  "rdfs:comment": {
    "de": [
      "Wasserfläche von etwa 1 Hektar, inmitten der Natur in einer angenehmen Umgebung. Angelplatz der ersten Kategorie. Wasserfläche mit touristischer Aufwertung. Ein idealer Ort, um das Angeln zu erlernen oder einen Familienausflug zu machen."
    ],
    "en": [
      "Approx. 1 hectare of water in a pleasant natural setting. 1st category fishing site. A tourist attraction. Ideal for learning to fish or for a family outing."
    ],
    "it": [
      "Circa 1 ettaro di acqua, circondato dalla natura in un ambiente piacevole. Sito di pesca di 1ª categoria. Un'attrazione turistica. Un luogo ideale per imparare a pescare o per una gita in famiglia."
    ],
    "fr": [
      "Plan d'eau d'environ 1 hectare, en pleine nature dans un cadre agréable. Site pêche 1ere catégorie. Plan d’eau à valorisation Touristique. C’est un endroit idéale pour l’apprentissage de la pêche ou une sortie en famille."
    ],
    "nl": [
      "Ongeveer 1 hectare water, omgeven door natuur in een aangename omgeving. Vissersplaats 1e categorie. Een toeristische attractie. Een ideale plek om te leren vissen of voor een gezinsuitstapje."
    ],
    "es": [
      "Aproximadamente 1 hectárea de agua, rodeada de naturaleza en un entorno agradable. Zona de pesca de 1ª categoría. Una atracción turística. Un lugar ideal para aprender a pescar o para pasear en familia."
    ]
  },
  "rdfs:label": {
