  "rdfs:comment": {
    "de": [
      "Der Weiler Hameau des Champs liegt 6 km von Bozel entfernt und ist nur im Sommer mit dem Auto erreichbar. Im Winter ist die Straße von Villemartin aus nämlich gesperrt."
    ],
    "en": [
      "Located at 6 km from Bozel, the hamlet of les Champs is easy to reach only in summer. In winter, the road is closed from Villemartin."
    ],
    "it": [
      "Situata a 6 km da Bozel, la frazione di Les Champs è accessibile in auto solo in estate. In inverno, la strada da Villemartin è chiusa."
    ],
    "fr": [
      "Situé à 6 km de Bozel, le hameau des Champs est accessible en voiture seulement en été. En effet, en hiver la route est fermée depuis Villemartin."
    ],
    "es": [
      "Situada a 6 km de Bozel, la aldea de Les Champs sólo es accesible en coche en verano. En invierno, la carretera de Villemartin está cerrada."
    ],
    "nl": [
      "Het gehucht Les Champs ligt op 6 km van Bozel en is alleen in de zomer per auto bereikbaar. In de winter is de weg vanuit Villemartin afgesloten."
    ]
  },
