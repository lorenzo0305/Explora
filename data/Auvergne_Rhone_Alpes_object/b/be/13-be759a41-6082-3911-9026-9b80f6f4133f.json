  "rdfs:comment": {
    "de": [
      "Das Pferd ohne Hindernisse im Vertrauen und mit Respekt....Das ist es, was Parole de Cheval anbietet. Vali wird Ihnen Erfahrungen und Entdeckungen mit Pferden anbieten, die für alle Altersgruppen und Niveaus geeignet sind, in einem geschützten Naturraum...."
    ],
    "en": [
      "Unfettered horse riding with confidence and respect....That's what Parole de Cheval is all about. Vali will offer you equestrian experiences and discoveries for all ages and levels, in an unspoilt natural environment...."
    ],
    "it": [
      "Andare a cavallo senza ostacoli, con fiducia e rispetto.... Questo è l'obiettivo di Parole de Cheval. Vali vi offrirà esperienze e scoperte equestri per tutte le età e tutti i livelli, in un ambiente naturale incontaminato...."
    ],
    "fr": [
      "Le cheval sans entrave en confiance et avec respect....C'est ce que propose Parole de Cheval. Vali vous proposera des expériences et découvertes équestres adaptées à tous les âges et niveaux, dans un espace naturel préservé...."
    ],
    "nl": [
      "Paardrijden zonder belemmeringen, met vertrouwen en respect....Daar draait het om bij Parole de Cheval. Vali biedt je ruiterervaringen en ontdekkingen voor alle leeftijden en niveaus, in een ongerepte natuurlijke omgeving...."
    ],
    "es": [
      "Montar a caballo sin trabas, con confianza y respeto....Eso es Parole de Cheval. Vali le ofrecerá experiencias y descubrimientos ecuestres para todas las edades y niveles, en un entorno natural intacto...."
    ]
  },
