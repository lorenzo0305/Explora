  "rdfs:comment": {
    "de": [
      "Gesäumt von bunten Stadthäusern und Geschäften mit großen Fensterfronten, bildet der Place Jean-Jaurès das historische Herz der Stadt Lens."
    ],
    "en": [
      "Bordered by brightly-coloured town houses and shops with large bays, the Place Jean-Jaurès is the historic heart of the town of Lens."
    ],
    "it": [
      "Fiancheggiata da case cittadine dai colori vivaci e da negozi con grandi vetrine, Place Jean-Jaurès è il cuore storico della città di Lens."
    ],
    "fr": [
      "Bordée de maisons de ville et de commerces de couleurs vives et à larges baies,  la place Jean-Jaurès constitue le cœur historique de la ville de Lens."
    ],
    "es": [
      "La plaza Jean-Jaurès, bordeada de casas urbanas de colores vivos y de tiendas con grandes escaparates, es el corazón histórico de la ciudad de Lens."
    ],
    "nl": [
      "De Place Jean-Jaurès, omzoomd met felgekleurde herenhuizen en winkels met grote ramen, is het historische hart van de stad Lens."
    ]
  },
