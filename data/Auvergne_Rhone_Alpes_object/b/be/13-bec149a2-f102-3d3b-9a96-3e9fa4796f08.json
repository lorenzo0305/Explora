  "rdfs:comment": {
    "de": [
      "Julien ist ein auf Gleitsportarten spezialisierter Ingenieur, ein mit seiner Heimat verbundener Bergführer und ein Experte für Mountainbiking in verschiedenen Formen. Er möchte, dass Sie ein einzigartiges Abenteuer im Land des Mont-Blanc erleben."
    ],
    "en": [
      "Julien is an engineer specialising in board sports, a mountain guide with a strong attachment to his region and an expert in mountain biking in all its forms. His aim is to take you on a unique adventure in the Mont Blanc region."
    ],
    "it": [
      "Ingegnere specializzato in sport da tavola, guida alpina con un profondo attaccamento alla sua regione ed esperto di mountain bike in tutte le sue forme, Julien vuole farvi vivere un'avventura unica nella regione del Monte Bianco."
    ],
    "fr": [
      "Ingénieur spécialisé des sports de glisse, accompagnateur en montagne attaché à son territoire et expert du VTT sous diverses formes, Julien veut vous faire vivre une aventure unique au Pays du Mont-Blanc."
    ],
    "es": [
      "Ingeniero especializado en deportes de tabla, guía de montaña con un fuerte apego a la región y experto en bicicleta de montaña en todas sus modalidades, Julien quiere que vivas una aventura única en la región del Mont Blanc."
    ],
    "nl": [
      "Als ingenieur gespecialiseerd in boardsporten, berggids met een sterke band met de regio en expert in mountainbiken in al zijn vormen, wil Julien je een uniek avontuur laten beleven in de Mont Blanc-regio."
    ]
  },
  "rdfs:label": {
    "en": [
      "Ambition Outdoor: Hiking, trekking and mountain biking in the Mont Blanc region"
    ],
    "it": [
      "Ambition Outdoor: escursioni, trekking e mountain bike nella regione del Monte Bianco"
    ],
    "fr": [
      "Ambition Outdoor : Randonnées, trekking et VTT(AE) au Pays du Mont-Blanc"
    ]
  },
