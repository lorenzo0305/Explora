  "rdfs:comment": {
    "de": [
      "Im Herzen der Berge offenbart sich der Mont Cenis. Königreich des Cristivomer, einige seiner Exemplare sind über 80 cm lang!"
    ],
    "en": [
      "Within the heart of the mountain, the Mont Cenis reveals itself. Kingdom of the char, some of its species are larger than 80 cm !"
    ],
    "it": [
      "Nel cuore della montagna, il Mont Cenis si rivela. Regno del cristivomero, alcuni dei suoi esemplari superano gli 80 cm!"
    ],
    "fr": [
      "Au cœur de la montagne, le Mont Cenis se dévoile. Royaume du cristivomer, certains de ses spécimens dépassent les 80 cm !"
    ],
    "nl": [
      "In het hart van de berg openbaart zich de Mont Cenis. Koninkrijk van de cristivomer, sommige van zijn exemplaren overschrijden de 80 cm!"
    ],
    "es": [
      "En el corazón de la montaña, el Mont Cenis se revela. Reino del cristivomer, ¡algunos de sus ejemplares superan los 80 cm!"
    ]
  },
