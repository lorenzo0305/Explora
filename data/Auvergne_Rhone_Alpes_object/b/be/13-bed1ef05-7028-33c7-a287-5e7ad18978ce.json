  "rdfs:comment": {
    "de": [
      "Käserei, in der der in diesem Dorf geborene Chambérat hergestellt wird. Es handelt sich um einen Käse aus roher, vollfetter Kuhmilch, der durch einfaches Abtropfen gepresst und nicht gekocht wird."
    ],
    "en": [
      "Cheese dairy where the chambermelon born in this village is made. It is a raw and whole cow's milk cheese, pressed by simple draining, uncooked."
    ],
    "it": [
      "Caseificio dove viene prodotto il formaggio Chambérat nato in questo villaggio. È un formaggio prodotto con latte vaccino intero crudo, pressato per semplice sgocciolamento, non cotto."
    ],
    "fr": [
      "Fromagerie où est fabriqué le chambérat né dans ce village. C'est un fromage au lait de vache cru et entier, à pâte pressée par simple égouttage, non cuite."
    ],
    "nl": [
      "Kaasmakerij waar de in dit dorp geboren Chambérat-kaas wordt gemaakt. Het is een kaas gemaakt van rauwe, volle koemelk, geperst door eenvoudig uitlekken, ongekookt."
    ],
    "es": [
      "Fábrica de quesos donde se elabora el queso Chambérat nacido en este pueblo. Es un queso elaborado con leche de vaca cruda y entera, prensada por simple escurrido, sin cocer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fromagerie de Pierrefite"
    ]
  },
