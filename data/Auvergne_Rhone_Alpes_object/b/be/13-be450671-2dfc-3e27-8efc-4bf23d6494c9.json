  "rdfs:comment": {
    "de": [
      "Wir treffen uns am 17. und 18. März 2026 in Tignes. Junioren, Amateure und Profis können sich in einem gewagten Indoor-Skatepark auf Skateboards und Inlineskates herausfordern."
    ],
    "en": [
      "See you in Tignes on March 17 and 18, 2026. Juniors, amateurs, and professionals will be able to challenge themselves on a daring indoor skatepark with skateboards and rollerblades."
    ],
    "it": [
      "Ci vediamo a Tignes il 17 e 18 marzo 2026. Juniores, dilettanti e professionisti potranno sfidarsi su un audace skatepark indoor in skateboard e rollerblade."
    ],
    "fr": [
      "Rendez-vous à Tignes les 17 et 18 mars 2026. Les juniors, les amateurs et les professionnels pourront se challenger sur un skatepark indoor audacieux en skateboard et en roller."
    ],
    "nl": [
      "Tot ziens in Tignes op 17 en 18 maart 2026. Junioren, amateurs en professionals zullen elkaar kunnen uitdagen op een gedurfd indoor skatepark in skateboard en rollerblade."
    ],
    "es": [
      "Nos vemos en Tignes los días 17 y 18 de marzo de 2026. Juniors, aficionados y profesionales podrán retarse en un atrevido skatepark cubierto en monopatín y patines."
    ]
  },
  "rdfs:label": {
