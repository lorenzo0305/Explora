  "rdfs:comment": {
    "de": [
      "Willkommen auf dem Orientierungslauf von Centron! \r\nRealisiert von der EV Centron &amp; Cap Orientation unter Beteiligung der Dorfbewohner und der Schulkinder."
    ],
    "en": [
      "Welcome to Centron orienteering course! \r\nCreated by the Centron parent-teacher association & Cap Orientation with the participation of the inhabitants of the village and the local schoolchildren"
    ],
    "it": [
      "Benvenuti al percorso di orientamento di Centron!\r\nRealizzato dall'APE Centron & Cap Orientation con la partecipazione degli abitanti del villaggio e dei bambini della scuola"
    ],
    "fr": [
      "Bienvenue sur le parcours d'orientation de Centron ! \r\nRéalisé par l'APE Centron & Cap Orientation avec la participation des habitants du village et des enfants de l'école"
    ],
    "es": [
      "¡Bienvenido al recorrido de orientación de Centron!\r\nRealizado por la APE Centron & Cap Orientación con la participación de los habitantes del pueblo y los niños de la escuela"
    ],
    "nl": [
      "Welkom op het oriëntatieparcours van Centron!\r\nGemaakt door de APE Centron & Cap Orientation met de deelname van de inwoners van het dorp en de kinderen van de school."
