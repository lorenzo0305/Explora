  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Vincent, ein romanisches Juwel aus dem 12. Jahrhundert, besticht durch ihr tonnengewölbtes Kirchenschiff und ihren typisch auvergnatischen Ch?ur. Der PAH Haut-Allier organisiert manchmal geführte Besichtigungen, um alle Geheimnisse zu entdecken"
    ],
    "en": [
      "The church of Saint-Vincent, a 12th-century Romanesque gem, features a barrel-vaulted nave and typical Auvergne choir. The PAH Haut-Allier sometimes organizes guided tours to discover all its secrets"
    ],
    "it": [
      "La chiesa di Saint-Vincent, gioiello romanico del XII secolo, vanta una navata con volta a botte e un coro tipico dell'Alvernia. Il PAH Haut-Allier organizza talvolta visite guidate per scoprire tutti i suoi segreti"
    ],
    "fr": [
      "L'église Saint-Vincent, joyau roman du XIIe siècle, séduit par sa nef voûtée en berceau et son chœur typique auvergnat. Le PAH Haut-Allier organise parfois des visites guidées pour en découvrir tous les secrets"
    ],
    "es": [
      "La iglesia de Saint-Vincent, joya románica del siglo XII, posee una nave con bóveda de cañón y un coro típico de Auvernia. La PAH Haut-Allier organiza a veces visitas guiadas para descubrir todos sus secretos"
    ],
    "nl": [
      "De kerk Saint-Vincent, een romaans juweeltje uit de 12e eeuw, heeft een schip met tongewelven en een typisch koor uit de Auvergne. De PAH Haut-Allier organiseert soms rondleidingen om al haar geheimen te ontdekken"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise Saint-Vincent de Vieille-Brioude"
    ]
  },
