  "rdfs:comment": {
    "de": [
      "Starten Sie im Dorfzentrum von Courzieu und entdecken Sie die 5 permanenten Trailstrecken für alle Niveaus (von grün bis schwarz) auf vollständig markierten Wegen (von 8 bis 23 km). Parkplatz am Start der Trails. Warme Dusche mit freiem Zugang vor Ort."
    ],
    "en": [
      "Starting from the centre of the village of Courzieu, come and discover the 5 permanent trail courses for all levels (from green to black) on fully marked paths (from 8 to 23 km). Parking at the start of the trails. Free hot shower on site."
    ],
    "it": [
      "Partendo dal centro del villaggio di Courzieu, venite a scoprire i 5 percorsi permanenti per tutti i livelli (dal verde al nero) su sentieri completamente segnalati (da 8 a 23 km). Parcheggio all'inizio dei sentieri. Doccia calda gratuita in loco."
    ],
    "fr": [
      "Au départ du centre du village de Courzieu, venez découvrir les 5 parcours de trail permanents tous niveaux (du vert au noir) sur des chemins entièrement balisés (de 8 à 23 km). Parking au départ des traces. Douche chaude en accès libre sur place."
    ],
    "es": [
      "Partiendo del centro del pueblo de Courzieu, venga a descubrir los 5 recorridos permanentes de trail para todos los niveles (del verde al negro) por senderos totalmente señalizados (de 8 a 23 km). Aparcamiento al inicio de los senderos. Ducha caliente gratuita en el lugar."
    ],
    "nl": [
      "Kom vanuit het centrum van het dorp Courzieu de 5 permanente parcours ontdekken voor alle niveaus (van groen tot zwart) op volledig gemarkeerde paden (van 8 tot 23 km). Parkeren aan het begin van de paden. Gratis warme douche ter plaatse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Courz'y Trail Park"
    ]
  },
