  "rdfs:comment": {
    "de": [
      "Das im Parc du Vercors zwischen Valence und Grenoble gelegene Royans bietet seinen Besuchern zahlreiche kulturelle, klimatische und landschaftliche Nuancen."
    ],
    "en": [
      "Le Royans, located in the Parc du Vercors, between Valence and Grenoble, offers its visitors many cultural, climatic and landscape nuances."
    ],
    "it": [
      "Royans, situata nel Parco del Vercors tra Valence e Grenoble, offre ai suoi visitatori numerose sfumature culturali, climatiche e paesaggistiche."
    ],
    "fr": [
      "Le Royans situé dans le Parc du Vercors, entre Valence et Grenoble, propose à ses visiteurs de nombreuses nuances culturelles, climatiques et paysagères."
    ],
    "es": [
      "Royans, situado en el Parque del Vercors, entre Valence y Grenoble, ofrece a sus visitantes numerosos matices culturales, climáticos y paisajísticos."
