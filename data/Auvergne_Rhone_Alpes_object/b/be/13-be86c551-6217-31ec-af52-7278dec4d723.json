      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/a30a73ae-1c45-36ec-b61c-c4c444539d17",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Schulferien (Winter-Frühling-Herbst-Weihnachten) :\r\nZone A: Montag bis Freitag von 9:30 bis 12:00 Uhr und 15:00 bis 17:00 Uhr.\r\nZonen B und C: Montag bis Freitag von 9:30 bis 12:00 Uhr.\r\n\r\nVom 8. Juli bis 29. August: Montag bis Samstag von 9:30 bis 12:00 und 15:00 bis 17:00 Uhr.\r\n\r\nAußerhalb der Schulferien: Montag bis Freitag von 9:30 bis 12:00 Uhr.\r\n\r\nGanzjährig: Sonntag, Dienstagnachmittag und an Feiertagen geschlossen."
            ],
            "en": [
              "School vacations (Winter-Spring-Autumn-Christmas) :\r\nZone A: Monday to Friday, 9:30am to 12pm and 3pm to 5pm.\r\nZones B and C: Monday to Friday, 9:30am to 12pm.\r\n\r\nFrom July 8 to August 29: Monday to Saturday, 9.30am to 12pm and 3pm to 5pm.\r\n\r\nOutside school vacations: Monday to Friday, 9:30am to 12pm.\r\n\r\nAll year round: Closed on Sundays, Tuesday afternoons and public holidays."
            ],
            "it": [
              "Vacanze scolastiche (inverno-primavera-autunno-natale) :\r\nZona A: dal lunedì al venerdì, dalle 9.30 alle 12.00 e dalle 15.00 alle 17.00.\r\nZone B e C: dal lunedì al venerdì, dalle 9.30 alle 12.00.\r\n\r\nDall'8 luglio al 29 agosto: dal lunedì al sabato, dalle 9.30 alle 12.00 e dalle 15.00 alle 17.00.\r\n\r\nFuori dalle vacanze scolastiche: dal lunedì al venerdì, dalle 9.30 alle 12.00.\r\n\r\nTutto l'anno: chiuso la domenica, il martedì pomeriggio e i giorni festivi."
            ],
            "fr": [
              "Vacances scolaires (Hiver-Printemps-Automne-Noël) : \r\nZone A : Du lundi au vendredi de 9h30 à 12h et 15h à 17h. \r\nZones B et C : Du lundi au vendredi de 9h30 à 12h. \r\n\r\nDu 8 Juillet au 29 Août : Du lundi au samedi de 9h30 à 12h et 15h à 17h.\r\n\r\nHors vacances scolaires : Du lundi au vendredi de 9h30 à 12h.\r\n\r\nToute l'année : Fermé le dimanche, le mardi après-midi et les jours fériés."
            ],
            "es": [
              "Vacaciones escolares (invierno-primavera-otoño-navidad) :\r\nZona A: de lunes a viernes, de 9.30 a 12.00 y de 15.00 a 17.00 horas.\r\nZonas B y C: de lunes a viernes, de 9.30 a 12 h.\r\n\r\nDel 8 de julio al 29 de agosto: de lunes a sábado, de 9.30 a 12.00 y de 15.00 a 17.00 horas.\r\n\r\nFuera de vacaciones escolares: de lunes a viernes, de 9.30 a 12.00 horas.\r\n\r\nTodo el año: domingos, martes por la tarde y festivos cerrado."
            ],
            "nl": [
              "Schoolvakanties (winter-voorjaar-herfst-kerst) :\r\nZone A: maandag t/m vrijdag van 9.30 tot 12.00 uur en van 15.00 tot 17.00 uur.\r\nZones B en C: maandag t/m vrijdag van 9.30 tot 12.00 uur.\r\n\r\nVan 8 juli tot 29 augustus: maandag tot en met zaterdag van 9.30 tot 12.00 uur en van 15.00 tot 17.00 uur.\r\n\r\nBuiten de schoolvakanties: maandag t/m vrijdag van 9.30 tot 12.00 uur.\r\n\r\nHet hele jaar door: gesloten op zondag, dinsdagmiddag en feestdagen."
            ]
          },
