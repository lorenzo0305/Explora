  "rdfs:comment": {
    "de": [
      "Entdecken Sie Chanaz und seine Umgebung mit unserem Verleih von klassischen und elektrischen Fahrrädern. Die gesicherte Viarhôna, für Ausflüge mit der ganzen Familie."
    ],
    "en": [
      "Electric bike and mountain bike rental to discover the Via Rhôna, explore the area and enjoy tastings, or visit the castle in Clermont-en-Genevois via the small trails that overlook the Seyssel dams and the majestic river Rhône!"
    ],
    "it": [
      "Noleggio bici elettriche e mountain bike per scoprire la Via Rhôna, far passeggiate nel territorio e degustazioni, o visitare il castello di Clermont en Genevois per le stradine che si affacciano sulle dighe di Seyssel e il maestoso fiume Rodano!"
    ],
    "fr": [
      "Découvrez Chanaz et son terroir, grâce à notre location de Vélo classiques et électriques. La Viarhôna sécurisée, pour des balades en familles."
    ],
    "nl": [
      "Ontdek Chanaz en zijn regio dankzij onze klassieke en elektrische fietsverhuur. De beveiligde Viarhôna, voor uitstapjes met het gezin."
    ],
    "es": [
      "Descubra Chanaz y su región, gracias a nuestro alquiler de bicicletas clásicas y eléctricas. El Viarhôna seguro, para paseos en familia."
    ]
  },
  "rdfs:label": {
    "en": [
      "Electric bike rental on the Via Rhôna and Themed Trail"
    ],
    "it": [
      "Noleggio bici elettrica sulla Via Rhôna e Percorso a tema"
    ],
    "fr": [
      "Prolynx Sports - Location vélos et vélos électrique- Via Rhôna et Parcours à thème"
    ]
  },
