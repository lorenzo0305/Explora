  "rdfs:comment": {
    "de": [
      "Iris Galerie bietet ein einzigartiges Erlebnis: das Wesen des Blicks einzufangen und Ihre Iris zu verewigen, dank einer Technologie, die Fotografie und hochwertigen Druck miteinander verbindet."
    ],
    "en": [
      "Iris Galerie offers a unique experience: capture the essence of your eyes and immortalize your iris, thanks to a technology that combines photography and high-quality printing."
    ],
    "it": [
      "Iris Galerie offre un'esperienza unica: catturare l'essenza dei vostri occhi e immortalare la vostra iride, grazie a una tecnologia che combina fotografia e stampa di alta qualità."
    ],
    "fr": [
      "Iris Galerie propose une expérience unique : capter l'essence du regard et immortaliser votre iris, grâce à une technologie alliant photographie et impression de haute qualité."
    ],
    "es": [
      "Iris Galerie ofrece una experiencia única: capturar la esencia de sus ojos e inmortalizar su iris, gracias a una tecnología que combina fotografía e impresión de alta calidad."
    ],
    "nl": [
      "Iris Galerie biedt een unieke ervaring: het vastleggen van de essentie van je ogen en het vereeuwigen van je iris, dankzij een technologie die fotografie en afdrukken van hoge kwaliteit combineert."
    ]
  },
