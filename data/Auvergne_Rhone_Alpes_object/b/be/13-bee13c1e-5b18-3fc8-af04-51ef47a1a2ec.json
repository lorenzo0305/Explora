  "rdfs:comment": {
    "de": [
      "In Crozet bin ich eine Glasschneiderin, die sich auf das Recycling von nicht recycelbarem Glas spezialisiert hat: Geschirr, Glasmalereien, Karaffen, Pyrex? All diese Materialien, die eigentlich für den Abfall bestimmt waren, finden in meinen Händen ein neues Leben."
    ],
    "en": [
      "Based in Le Crozet, I'm a glass spinner specializing in the recycling of non-recyclable glass: crockery, stained glass, carafes, Pyrex? All these materials destined for the scrap heap find new life in my hands."
    ],
    "it": [
      "Con sede a Le Crozet, sono una filatrice di vetro, specializzata nel riciclaggio di vetro non riciclabile: stoviglie, vetri colorati, caraffe, Pyrex? Tutti questi materiali destinati al macero trovano una nuova vita nelle mie mani."
    ],
    "fr": [
      "Installée au Crozet, je suis fileuse de verre au chalumeau, spécialisée dans le recyclage du verre non recyclable : vaisselle, vitraux, carafes, Pyrex… Toutes ces matières destinées au déchet retrouvent une nouvelle vie entre mes mains."
    ],
    "nl": [
      "Ik woon in Le Crozet en ben glasspinner. Ik ben gespecialiseerd in het recyclen van niet-recyclebaar glas: serviesgoed, glas in lood, karaffen, Pyrex? Al deze materialen die bestemd zijn voor de schroothoop vinden een nieuw leven in mijn handen."
    ],
    "es": [
      "Afincada en Le Crozet, soy hilandera de vidrio, especializada en reciclar vidrio no reciclable: vajillas, vidrieras, garrafas, Pyrex.. Todos estos materiales destinados a la chatarra encuentran una nueva vida en mis manos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Verre d'art - Andreia Matos"
    ]
  },
