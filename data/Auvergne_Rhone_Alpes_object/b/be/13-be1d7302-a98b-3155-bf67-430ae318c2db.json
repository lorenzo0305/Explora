  "rdfs:comment": {
    "de": [
      "Kurioser vulkanischer Gipfel in der Velay-Kette.\r\nDominiert im Osten das Becken von Le Puy und im Westen das Tal des Allier."
    ],
    "en": [
      "A curious volcanic peak in the Velay mountain range.\r\nIt overlooks the Puy basin to the east and the Allier valley to the west."
    ],
    "it": [
      "Curiosa cima vulcanica della catena montuosa del Velay.\r\nDomina il bacino del Puy a est e la valle dell'Allier a ovest."
    ],
    "fr": [
      "Curieux pic volcanique de la chaîne du Velay.\r\nDomine à l'Est le bassin du Puy et à l'Ouest la vallée de l'Allier."
    ],
    "nl": [
      "Een merkwaardige vulkanische piek in het Velay-gebergte.\r\nHij kijkt uit over het Puy-bekken in het oosten en de Allier-vallei in het westen."
    ],
    "es": [
      "Curioso pico volcánico del macizo del Velay.\r\nDomina la cuenca del Puy al este y el valle del Allier al oeste."
    ]
  },
