  "rdfs:comment": {
    "de": [
      "Kochkurs mit Chefkoch Gilles Roux: Erleben Sie die großen französischen Klassiker neu! Von 15:00 bis 18:30 Uhr beherrschen Sie seine Techniken und teilen einen Moment der Gaumenfreuden. 60? mit 2 Portionen zum Mitnehmen. Die Anzahl der Plätze ist begrenzt. Reservierung: 04 71 66 86 66."
    ],
    "en": [
      "Cooking classes with Chef Gilles Roux: revisit the great French classics! From 3 pm to 6:30 pm, master his techniques and share a gourmet moment. 60? with 2 portions to take away. Places limited. Reservations: 04 71 66 86 66."
    ],
    "it": [
      "Corsi di cucina con lo chef Gilles Roux: rivisitate i grandi classici francesi! Dalle 15.00 alle 18.30, padroneggiate le sue tecniche e condividete un momento gourmet. 60? con 2 porzioni da portare via. Posti limitati. Prenotazioni: 04 71 66 86 66."
    ],
    "fr": [
      "Cours de cuisine avec le Chef Gilles Roux : revisitez les grands classiques français ! De 15h à 18h30, maîtrisez ses techniques et partagez un moment gourmand. 60€ avec 2 portions à emporter. Places limitées. Réservation : 04 71 66 86 66."
    ],
    "nl": [
      "Kooklessen met chef-kok Gilles Roux: herontdek de grote Franse klassiekers! Van 15.00 tot 18.30 uur, beheers zijn technieken en deel een gastronomisch moment. 60? met 2 porties om mee te nemen. Beperkt aantal plaatsen. Reserveren: 04 71 66 86 66."
    ],
    "es": [
      "Clases de cocina con el Chef Gilles Roux: ¡revisite los grandes clásicos franceses! De 15:00 a 18:30, domine sus técnicas y comparta un momento gourmet. 60? con 2 raciones para llevar. Plazas limitadas. Reservas: 04 71 66 86 66."
    ]
  },
