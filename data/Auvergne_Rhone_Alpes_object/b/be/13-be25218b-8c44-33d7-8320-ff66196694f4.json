  "rdfs:comment": {
    "de": [
      "Von seinem Felsvorsprung aus überblickt das Schloss Peufeilhoux das Tal des Flusses Cher und den Wald von Tronçais."
    ],
    "en": [
      "From the top of its rocky spur, Peufeilhoux castle overlooks the Cher valley and Tronçais forest."
    ],
    "it": [
      "Dall'alto del suo sperone roccioso, il castello di Peufeilhoux domina la valle dello Cher e la foresta di Tronçais."
    ],
    "fr": [
      "Du haut de son éperon rocheux, le château de Peufeilhoux domine la vallée du Cher et la forêt de Tronçais."
    ],
    "nl": [
      "Vanaf de top van zijn rotsachtige uitloper domineert het kasteel van Peufeilhoux de vallei van de Cher en het bos van Tronçais."
    ],
    "es": [
      "Desde lo alto de su espolón rocoso, el castillo de Peufeilhoux domina el valle del Cher y el bosque de Tronçais."
