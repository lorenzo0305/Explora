  "rdfs:comment": {
    "de": [
      "Charmantes Hotel mit gemütlicher Einrichtung, im Stadtzentrum gelegen. Unser Restaurant und seine traditionelle Küche. Entspannungsbereich: sein Salon mit gedämpfter Ruhe. Preise für Kuraufenthalte auf Anfrage."
    ],
    "en": [
      "Cosy, charming hotel in the city centre. Our restaurant and its gourmet cuisine. Relaxation area: a quiet tea room. For spa rates, please contact us."
    ],
    "it": [
      "Hotel di charme con arredamento accogliente, situato nel centro della città. Il nostro ristorante con cucina tradizionale. Area relax: un accogliente salotto. Contattateci per conoscere le tariffe."
    ],
    "fr": [
      "Hôtel de charme avec une décoration cosy, situé en centre-ville. Notre restaurant et sa cuisine traditionnelle. Espace détente : son salon au calme feutré. Tarifs cure, nous consulter."
    ],
    "es": [
      "Hotel con encanto y decoración acogedora, situado en el centro de la ciudad. Nuestro restaurante con su cocina tradicional. Zona de relajación: un acogedor salón. Para tarifas de cura, póngase en contacto con nosotros."
    ],
    "nl": [
      "Charmant hotel met gezellige inrichting, gelegen in het stadscentrum. Ons restaurant met zijn traditionele keuken. Ontspanningsruimte: een gezellige lounge. Neem voor kuurtarieven contact met ons op."
    ]
  },
  "rdfs:label": {
