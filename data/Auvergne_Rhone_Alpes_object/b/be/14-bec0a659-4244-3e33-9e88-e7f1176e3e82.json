  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/24de27b3-8aaa-3e0b-98ba-253f40164d9b",
      "dc:description": {
        "de": [
          "16.00 Uhr Flash Mob (vor dem Colisée in Lens)\n\nKommen Sie und lernen Sie La Danse de Rabbi Jacob mit dem Choreografen des Films. Ilan Zaoui und seine Tänzer vor dem Colisée.\n\n17.00 Uhr Vorführung des Films\n\n DIE ABENTEUER DES RABBI JACOB (Gérard Oury, 1973 - 1h35)\n\n18.45 Uhr Treffen rund um Louis de Funès mit Bernard Alane, Henri Guybet, Agathe Natanson und Ilan Zaoui."
        ],
        "en": [
          "16:00 Flash Mob (in front of Colisée de Lens)\n\nCome and learn Rabbi Jacob's Dance with the film's choreographer. Ilan Zaoui and his dancers in front of the Colisée.\n\n5:00 pm Screening of the film\n\n THE ADVENTURES OF RABBI JACOB (Gérard Oury, 1973 - 1h35)\n\n6:45 pm Rencontre autour de Louis de Funès with Bernard Alane, Henri Guybet, Agathe Natanson and Ilan Zaoui."
        ],
        "it": [
          "16:00 Flash Mob (davanti al Colisée di Lens)\n\nVenite a imparare la Danza di Rabbi Jacob con il coreografo del film. Ilan Zaoui e i suoi ballerini davanti al Colisée.\n\n17:00 Proiezione del film\n\n LE AVVENTURE DI RABBI JACOB (Gérard Oury, 1973 - 1h35)\n\n18.45 Incontro su Louis de Funès con Bernard Alane, Henri Guybet, Agathe Natanson e Ilan Zaoui."
        ],
        "fr": [
          "16h00 Flash Mob (devant le Colisée de Lens)\n\nVenez apprendre La Danse de Rabbi Jacob avec le chorégraphe du film. Ilan Zaoui et ses danseurs devant le Colisée.\n\n17h00 Projection du film\n\n LES AVENTURES DE RABBI JACOB (Gérard Oury, 1973 - 1h35)\n\n18h45 Rencontre autour de Louis de Funès avec Bernard Alane, Henri Guybet, Agathe Natanson et Ilan Zaoui."
        ],
        "nl": [
          "16:00 Flash Mob (voor het Colisée in Lens)\n\nKom Rabbi Jacobsdans leren met de choreograaf van de film. Ilan Zaoui en zijn dansers voor het Colisée.\n\n17:00 Vertoning van de film\n\n DE ADVENTURES VAN RABBI JACOB (Gérard Oury, 1973 - 1u35)\n\n18u45 Ontmoeting over Louis de Funès met Bernard Alane, Henri Guybet, Agathe Natanson en Ilan Zaoui."
        ],
        "es": [
          "16:00 Flash Mob (frente al Colisée de Lens)\n\nVenga a aprender la Danza del Rabino Jacob con el coreógrafo de la película Ilan Zaoui y sus bailarines frente al Colisée.\n\n17:00 Proyección de la película\n\n LAS AVENTURAS DE RABBI JACOB (Gérard Oury, 1973 - 1h35)\n\n18.45 Encuentro sobre Louis de Funès con Bernard Alane, Henri Guybet, Agathe Natanson e Ilan Zaoui."
        ]
      },
