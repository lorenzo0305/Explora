  "rdfs:comment": {
    "de": [
      "E-MOTION ist ein multifunktionaler Ort, der eine einzigartige Kombination von Aktivitäten und Dienstleistungen anbietet. Es befindet sich in einer dynamischen städtischen und bergigen Umgebung und zeichnet sich durch sein innovatives Design und seine Angebotsvielfalt aus."
    ],
    "en": [
      "E-MOTION is a multifunctional venue offering a unique combination of activities and services. Set in a dynamic urban and mountainous environment, it stands out for its innovative design and diversity of offerings."
    ],
    "it": [
      "E-MOTION è un luogo multifunzionale che offre una combinazione unica di attività e servizi. Situato in un ambiente urbano e montano dinamico, si distingue per il suo design innovativo e la diversità delle offerte."
    ],
    "fr": [
      "E-MOTION est un lieu multifonctionnel offrant une combinaison unique d’activités et de services. Situé dans un environnement urbain dynamique et montagneux, il se démarque par sa conception innovante et sa diversité d’offres."
    ],
    "nl": [
      "E-MOTION is een multifunctionele locatie met een unieke combinatie van activiteiten en diensten. Het ligt in een dynamische stedelijke en bergachtige omgeving en onderscheidt zich door zijn innovatieve ontwerp en gevarieerde aanbod."
    ],
    "es": [
      "E-MOTION es un recinto multifuncional que ofrece una combinación única de actividades y servicios. Situado en un dinámico entorno urbano y montañoso, destaca por su diseño innovador y la diversidad de su oferta."
    ]
  },
