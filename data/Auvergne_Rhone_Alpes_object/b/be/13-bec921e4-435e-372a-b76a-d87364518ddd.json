  "rdfs:comment": {
    "de": [
      "Kommentierte Besichtigung der Außenanlagen des Schlosses (einschließlich der Gärten).\r\nDas Château des Vieux Melays (IMH) ist ein typisches Beispiel für die Architektur des 17. Jahrhunderts in Bourbonnais."
    ],
    "en": [
      "Guided tour of the castle's exterior (including the gardens).\r\nThe Vieux Melays castle (IMH) represents a typical example of 17th century Bourbonnais architecture."
    ],
    "it": [
      "Visita guidata dell'esterno del castello (compresi i giardini).\r\nIl Castello Vieux Melays (IMH) è un tipico esempio di architettura Bourbonnais del XVII secolo."
    ],
    "fr": [
      "Visite commentée des extérieurs du château (y compris des jardins).\r\nLe château des Vieux Melays (IMH) représente un exemple type de l'architecture bourbonnaise du XVIIe siècle."
    ],
    "es": [
      "Visita guiada del exterior del castillo (incluidos los jardines).\r\nEl castillo Vieux Melays (IMH) es un ejemplo típico de la arquitectura Bourbonnais del siglo XVII."
    ],
    "nl": [
      "Rondleiding door de buitenkant van het kasteel (inclusief de tuinen).\r\nHet kasteel van Vieux Melays (IMH) is een typisch voorbeeld van 17e eeuwse Bourbonnais architectuur."
    ]
  },
