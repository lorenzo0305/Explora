  "rdfs:comment": {
    "de": [
      "Eine wunderschöne Route durch den Wald von Montchavin, auf der Sie Ihre Skitourentechniken wie z. B. das Umkehren verfeinern können. Ideal für Fortgeschrittene oder erfahrene Tourenskifahrer."
    ],
    "en": [
      "A fabulous trail through Montchavin forest where you can perfect your ski touring techniques such as kick turns. Ideal for progressing or for experienced ski tourers."
    ],
    "it": [
      "Un bellissimo percorso attraverso la foresta di Montchavin per perfezionare le tecniche di scialpinismo come le conversioni. Ideale per i principianti o per gli scialpinisti esperti."
    ],
    "fr": [
      "Itinéraire magnifique à travers la forêt de Montchavin permettant de peaufiner les techniques de ski de randonnée telles que les conversions. Idéal pour progresser ou pour les skieurs de randonnée aguérris."
    ],
    "es": [
      "Un hermoso recorrido por el bosque de Montchavin para perfeccionar las técnicas de esquí de travesía, como las conversiones. Ideal para principiantes o para esquiadores experimentados."
    ],
    "nl": [
      "Prachtige route door het bos van Montchavin dat toelaat de technieken van het touringskiën zoals de conversies te vervolmaken.  Ideaal om vooruitgang te maken of voor de ervaren touringsskiërs."
    ]
  },
  "rdfs:label": {
    "de": [
      "Skitourenroute: Montchavin - Les Pierres Blanches"
    ],
    "en": [
      "Ski touring trail : Montchavin - Les Pierres Blanches"
    ],
    "fr": [
      "Itinéraire de ski de randonnée : Montchavin - Les Pierres Blanches"
    ],
    "nl": [
      "Skitouringroute: Montchavin - Les Pierres Blanches"
    ]
  },
