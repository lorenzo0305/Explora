  "rdfs:comment": {
    "de": [
      "Die Bibliothek bietet eine große Auswahl an Romanen, Comics, Dokumentarfilmen, Zeitschriften und Mangas in drei Bereichen: Jugend, Jugendliche und Erwachsene, die Groß und Klein begeistern."
    ],
    "en": [
      "The library offers a wide selection of novels, comics, documentaries, magazines and mangas in 3 sectors: youth, teenagers and adults, something to delight young and old."
    ],
    "it": [
      "La biblioteca offre un'ampia gamma di romanzi, fumetti, documentari, riviste e manga in 3 settori: giovani, adolescenti e adulti, per la gioia di grandi e piccini."
    ],
    "fr": [
      "La bibliothèque offre un large choix de romans, de bandes dessinées, de documentaires, de magazines et de mangas répartis dans 3 secteurs : jeunesse, adolescents et adultes, de quoi ravir petits et grands."
    ],
    "es": [
      "La biblioteca ofrece un amplio abanico de novelas, cómics, documentales, revistas y manga en 3 sectores: juvenil, adolescente y adulto, algo que hará las delicias de grandes y pequeños."
    ],
    "nl": [
      "De bibliotheek biedt een breed scala aan romans, strips, documentaires, tijdschriften en manga in 3 sectoren: jeugd, tieners en volwassenen, iets om jong en oud te plezieren."
    ]
  },
