  "rdfs:comment": {
    "de": [
      "Das Haus Grizlaw bietet Ihnen :\r\n- eine saisonale Gourmetküche, die aus frischen Produkten zubereitet wird,\r\n- eine große Auswahl an Weinen\r\n- eine Käseplatte mit reifen Käsesorten aus dem Hause MONS\r\n- köstliche Desserts, darunter die des MOF Philippe RIGOLLOT"
    ],
    "en": [
      "La Maison Grizlaw offers :\r\n- gourmet seasonal cuisine based on fresh produce,\r\n- a wide selection of wines\r\n- a platter of cheeses matured by MONS\r\n- delicious desserts, including those of MOF Philippe RIGOLLOT"
    ],
    "it": [
      "La Maison Grizlaw vi offre :\r\n- cucina gourmet di stagione con prodotti freschi,\r\n- un'ampia selezione di vini\r\n- un piatto di formaggi stagionati da MONS\r\n- deliziosi dessert, tra cui quelli del MOF Philippe RIGOLLOT"
    ],
    "fr": [
      "La Maison Grizlaw vous proposent :\r\n· une cuisine de saison gourmande élaborée à base de produits frais,\r\n· une large sélection de vins\r\n· un plateau de fromages affinés par la maison MONS\r\n· de délicieux desserts dont ceux du MOF Philippe RIGOLLOT"
    ],
    "es": [
      "La Maison Grizlaw le ofrece :\r\n- una cocina gastronómica de temporada elaborada con productos frescos,\r\n- una amplia selección de vinos\r\n- una tabla de quesos madurados por MONS\r\n- deliciosos postres, entre ellos los del MOF Philippe RIGOLLOT"
    ],
    "nl": [
      "La Maison Grizlaw biedt u :\r\n- gastronomische seizoensgerechten met verse producten,\r\n- een uitgebreide selectie wijnen\r\n- een schotel met kazen gerijpt door MONS\r\n- heerlijke desserts, waaronder die van MOF Philippe RIGOLLOT"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison Grizlaw"
    ]
  },
