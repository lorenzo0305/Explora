      "dc:description": {
        "de": [
          "Die Chocolaterie de Beussent hat am 30. und 31. Mai einen Tag der offenen Tür!\nTreffpunkt von 9 bis 17 Uhr (letzte Abfahrt) in 66 Route de Desvres"
        ],
        "en": [
          "Chocolaterie de Beussent is holding its open house on May 30th and 31st!\nMeet us from 9am to 5pm (last departure) at 66 Route de Desvres"
        ],
        "it": [
          "La Chocolaterie de Beussent apre le porte il 30 e 31 maggio!\nPunto d'incontro dalle 9.00 alle 17.00 (ultima partenza) al 66 Route de Desvres"
        ],
        "fr": [
          "La Chocolaterie de Beussent fait ses portes ouvertes le 30 et 31 mai ! \nRendez-vous de 9h à 17h (dernier départ) au 66 Route de Desvres"
        ],
        "nl": [
          "La Chocolaterie de Beussent houdt op 30 en 31 mei open huis!\nTrefpunt van 9 tot 17 uur (laatste vertrek) op 66 Route de Desvres"
        ],
        "es": [
          "La Chocolatería de Beussent celebra su jornada de puertas abiertas los días 30 y 31 de mayo\nPunto de encuentro de 9:00 a 17:00 (última salida) en 66 Route de Desvres"
        ]
