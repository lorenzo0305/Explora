  "rdfs:comment": {
    "de": [
      "Das Schloss La Borie war einst die Bastion des Schlosses von Suze, mit dem es damals durch von den Tempelrittern ge- schaffene unterirdische Gänge verbunden war."
    ],
    "en": [
      "In the midst of forests, truffle trees and lavender fields, Chateau La Borie is one of the rare wineries in the Rhone to be a chateau as well. Built in the 18th century, the castle is built on a hill and is surrounded by 170 acres of vines."
    ],
    "it": [
      "Circondato da boschi, tartufaie e campi di lavanda, La Borie è uno dei pochi nella Valle del Rodano a fregiarsi dell'appellativo di Château. Costruito nel XVIII secolo, lo château sorge su una collinetta circondata da 65 ettari di vigneti."
    ],
    "fr": [
      "Entre forêts, truffières et champs de lavande, La Borie est l'un des rares de la Vallée du Rhône à porter l'appellation Château. Construit au XVIIIe siècle, le château est bâti sur une butte entouré de 65 hectares de vignes."
    ],
    "es": [
      "Rodeado de bosques, campos de trufas y de lavanda, La Borie es uno de los pocos del valle del Ródano que ostenta la denominación de Château. Construido en el siglo XVIII, el castillo se alza sobre un montículo rodeado de 65 hectáreas de viñedos."
    ],
    "nl": [
      "Château La Borie was het vooruitgeschoven bastion (voorburcht) van het \r\nkasteel van Suze, waarmee het in verbinding stond dankzij lange ondergrondse gangen, gegraven door de Tempeliers."
    ]
  },
