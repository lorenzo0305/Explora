  "rdfs:comment": {
    "de": [
      "ANIM?Alex bietet Ihnen die Gestaltung und Organisation von Schatzsuchen, Orientierungsspielen, kreativen Workshops usw. für Einzelpersonen und Gruppen, private oder öffentliche Standorte, Schulklassen, Betriebsräte, Geburtstage, Team Building."
    ],
    "en": [
      "ANIM'Alex offers the creation and organization of treasure hunts, orienteering games, creative workshops... for individuals and groups, private or public sites, schools, works councils, birthdays, team building."
    ],
    "it": [
      "ANIM?Alex crea e organizza cacce al tesoro, giochi di orientamento e laboratori creativi per singoli e gruppi, siti pubblici o privati, gruppi scolastici, consigli di fabbrica, feste di compleanno e team building."
    ],
    "fr": [
      "ANIM’Alex vous propose la création et l’organisation de chasses aux trésors, jeux d’orientation, ateliers créatifs … pour individuels et groupes, sites privés ou publics, sous des écoles, comités d’entreprise, anniversaires, team building."
    ],
    "es": [
      "ANIM?Alex crea y organiza búsquedas del tesoro, juegos de orientación y talleres creativos para particulares y grupos, centros privados o públicos, grupos escolares, comités de empresa, fiestas de cumpleaños y actividades de team building."
    ],
    "nl": [
      "ANIM?Alex creëert en organiseert speurtochten, oriëntatiespellen en creatieve workshops voor individuen en groepen, privé of openbare locaties, schoolgroepen, ondernemingsraden, verjaardagsfeestjes en teambuilding."
    ]
  },
  "rdfs:label": {
    "en": [
      "ANIM'Alex, your pocket activity leader"
    ],
    "fr": [
      "ANIM’Alex, votre animateur de poche"
    ]
  },
