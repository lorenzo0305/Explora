  "rdfs:comment": {
    "de": [
      "Nein, Arnaud Askoy ist nicht Brel, aber wenn man ihn hört und sieht, könnte man das glauben. Arnaud gibt dem großen Jacques aufrichtiges Fleisch."
    ],
    "en": [
      "No, Arnaud Askoy is not Brel, but to hear and see him, you'd think he was. Arnaud sincerely brings Brel to life."
    ],
    "it": [
      "No, Arnaud Askoy non è Brel, ma a sentirlo e vederlo si potrebbe credere. Arnaud dà sinceramente vita a Brel."
    ],
    "fr": [
      "Non, Arnaud Askoy n’est pas Brel mais à l’entendre, à le voir on pourrait y croire. Arnaud donne chair avec sincérité au Grand Jacques."
    ],
    "es": [
      "No, Arnaud Askoy no es Brel, pero al oírle y verle, uno podría creerlo. Arnaud da vida a Brel con sinceridad."
    ],
    "nl": [
      "Nee, Arnaud Askoy is Brel niet, maar als je hem hoort en ziet, zou je het kunnen geloven. Arnaud brengt Brel oprecht tot leven."
    ]
  },
  "rdfs:label": {
