  "rdfs:comment": {
    "de": [
      "Das Glockenspiel von Taninges, das sich im Kirchturm befindet, ist das größte des Departements: Es zählt 40 Glocken und empfängt jedes Jahr renommierte Carillonneure für Konzerte. Es enthält außerdem eine Sammlung von Harmonien."
    ],
    "en": [
      "The peal of bells at Taninges, in the church belltower, is the largest in the area: it has 40 bells and every year attracts expert bellringers for concert performances.  It also houses a collection of harmoniums."
    ],
    "it": [
      "Il carillon di Taninges, nel campanile della chiesa, è il più grande del dipartimento. È composto da 40 campane e ogni anno vi si tengono concerti di prestigiosi campanari. Presenta inoltre una collezione di armonium."
    ],
    "fr": [
      "Le Carillon de Taninges, installé dans le clocher de l'église est le plus grand du département : il compte 40 cloches et accueille chaque année des carillonneurs prestigieux pour des concerts.Il renferme également une collection d'harmoniums."
    ],
    "es": [
      "El carillón de Taninges, instalado en la torre de la iglesia, es el más grande del departamento: cuenta con 40 campanas y acoge cada año a prestigiosos carilloneros para dar conciertos. También cuenta con una colección de armonios."
    ],
    "nl": [
      "De beiaard van Taninges, die zich in de kerktoren bevindt, is de grootste van het departement: hij heeft 40 klokken en ontvangt elk jaar prestigieuze beiaardiers voor concerten, evenals een verzameling harmoniums."
    ]
  },
  "rdfs:label": {
    "en": [
      "Peal of bells at Taninges and harmonium museum"
    ],
    "it": [
      "Carillon di Taninges e museo dell'armonium"
    ],
    "fr": [
      "Le carillon de Taninges et collection d'harmoniums"
    ],
    "nl": [
      "De Taninges beiaard- en harmoniumcollectie"
    ]
  },
