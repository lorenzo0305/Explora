  "rdfs:comment": {
    "de": [
      "Das Restaurant \"Au Vieux chalet\" befindet sich in Thyez im Herzen des Arve-Tals in Hochsavoyen. Es liegt im Erdgeschoss des 4*-Hotels La Ferme du Lac in ruhiger Lage.\r\nAuf dem Parkplatz des Restaurants finden Sie 2 Ladestationen."
    ],
    "en": [
      "The restaurant \"Au Vieux chalet\" is located on the ground floor of the hotel La Ferme du Lac 4*. Ideally located in Thyez in the heart of the Arve Valley,  also close to the ski resorts and the most beautiful passes of Haute-Savoie."
    ],
    "it": [
      "Situato a Thyez, nel cuore della Valle dell'Arve in Alta Savoia, il ristorante \"Au Vieux Chalet\" si trova al piano terra dell'Hotel 4* La Ferme du Lac, in una zona tranquilla.\r\nNel parcheggio del ristorante si trovano 2 punti di ricarica."
    ],
    "fr": [
      "Situé à Thyez au cœur de la vallée de l'Arve en Haute-Savoie, le restaurant « Au Vieux chalet » est implanté au rez-de-chaussée de l’hôtel La Ferme du Lac 4*, au calme.\r\nSur le parking du restaurant, vous trouverez 2 bornes de rechargement."
    ],
    "es": [
      "Situado en Thyez, en el corazón del valle del Arve, en Alta Saboya, el restaurante \"Au Vieux Chalet\" se encuentra en la planta baja del hotel de 4* La Ferme du Lac, en una zona tranquila.\r\nEn el aparcamiento del restaurante, encontrará 2 puntos de recarga."
    ],
    "nl": [
      "Het restaurant \"Au Vieux Chalet\" ligt in Thyez, in het hart van het Arve-dal in de Haute-Savoie, op de begane grond van het hotel La Ferme du Lac 4*, in een rustige omgeving.\r\nOp de parkeerplaats van het restaurant vindt u 2 oplaadpunten."
    ]
  },
  "rdfs:label": {
    "en": [
      "Restaurant Au Vieux Chalet"
    ],
    "fr": [
      "Restaurant Au Vieux Chalet"
    ]
  },
