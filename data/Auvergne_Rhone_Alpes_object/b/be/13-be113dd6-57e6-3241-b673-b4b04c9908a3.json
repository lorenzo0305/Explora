  "rdfs:comment": {
    "de": [
      "Restaurant Glacier: 50 m von Marques Avenue und dem Schuhmuseum entfernt, in Richtung des Stadtzentrums von Romans. Traditionelle Speisekarte mit einem Tagesmenü, Gerichten à la carte und Innereien-Spezialitäten."
    ],
    "en": [
      "Restaurant Glacier: Located 50m from Marques Avenue and the Shoe Museum, on the way to Romans town center, a traditional menu with daily specials, à la carte dishes and offal specialties."
    ],
    "it": [
      "Ristorante situato a 50 m da viale Marques e dal Museo della calzatura, sulla strada per il centro di Roma. Menu tradizionale con menu del giorno a pranzo durante la settimana, piatti fatti in casa alla carta e specialità di frattaglie."
    ],
    "fr": [
      "Restaurant situé à 50m de Marques Avenue et du Musée de la Chaussure, en direction du centre ville de Romans, une carte traditionnelle avec un menu du jour les midis de la semaine, des plats fait maison à la carte et des spécialités d'abats."
    ],
    "es": [
      "Restaurante situado a 50 m de la Avenida del Marqués y del Museo del Calzado, camino del centro de Romans. Carta tradicional con menú del día al mediodía durante la semana, platos caseros a la carta y especialidad en despojos."
    ],
    "nl": [
      "Restaurant Glacier: Gelegen op 50 meter van de Marques Avenue en het Schoenenmuseum, op weg naar het centrum van Rome, een traditionele kaart met een Menu du Jour, à la carte gerechten en specialiteiten van orgaanvlees."
    ]
  },
