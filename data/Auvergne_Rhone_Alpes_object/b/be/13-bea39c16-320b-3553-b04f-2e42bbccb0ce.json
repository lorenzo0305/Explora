  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Angeln in Bergseen und Gebirgsbächen! Bachforellen, Regenbogenforellen und Saiblinge...\r\nKarte im Juli und August im Tourismusbüro von Saint Sorlin d'Arves erhältlich.\r\nFoto erforderlich für Wochen- und Jahreskarten."
    ],
    "en": [
      "Come and discover fishing in mountain lakes and streams !\r\nPermits on sale at the Saint Sorlin d'Arves Tourist Office in July and August."
    ],
    "it": [
      "Venite a scoprire la pesca nei laghi e nei torrenti di montagna! Trota fario, trota iridea e salmerino alpino...\r\nCarte in vendita presso l'Ufficio del Turismo di Saint Sorlin d'Arves nei mesi di luglio e agosto.\r\nPer le tessere settimanali e annuali è richiesta una foto."
    ],
    "fr": [
      "Venez découvrir la pêche en lacs et torrents de montagne ! Truites fario, arc-en-ciel et ombles chevaliers...\r\nCarte en vente à l'Office de Tourisme de Saint Sorlin d'Arves en juillet et août.\r\nPhoto obligatoire pour les cartes semaines et annuelles."
    ],
    "es": [
      "¡Venga a descubrir la pesca en lagos y arroyos de montaña! Trucha fario, trucha arco iris y trucha ártica...\r\nTarjetas a la venta en la Oficina de Turismo de Saint Sorlin d'Arves en julio y agosto.\r\nSe requiere foto para las tarjetas semanales y anuales."
    ],
    "nl": [
      "Kom en ontdek het vissen in bergmeren en beken!\r\nVergunningen te koop bij het VVV-kantoor van Saint Sorlin d'Arves in juli en augustus."
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing in lakes and streams"
    ],
    "fr": [
      "Pêche en lacs et torrents"
    ],
    "nl": [
      "Vissen in meren en bergstromen"
    ]
  },
