  "rdfs:comment": {
    "de": [
      "Campero'S ist auf warme Sandwiches aus Spanien spezialisiert. Großzügige Rezepte, authentische Geschmäcker und ein echter Moment des Teilens für Groß und Klein."
    ],
    "en": [
      "Campero'S specializes in hot sandwiches from Spain. Generous recipes, authentic flavors and a real moment of sharing for young and old."
    ],
    "it": [
      "Campero'S è specializzato in panini caldi provenienti dalla Spagna. Ricette generose, sapori autentici e un vero momento di condivisione per grandi e piccini."
    ],
    "fr": [
      "Campero'S est spécialisée dans les sandwichs chauds venus d’Espagne. Des recettes généreuses, des saveurs authentiques et un vrai moment de partage pour petits et grands."
    ],
    "nl": [
      "Campero'S is gespecialiseerd in warme broodjes uit Spanje. Royale recepten, authentieke smaken en een echt moment om te delen voor jong en oud."
    ],
    "es": [
      "Campero'S está especializado en bocadillos calientes de España. Recetas generosas, sabores auténticos y un verdadero momento de compartir para grandes y pequeños."
    ]
  },
