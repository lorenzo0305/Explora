  "rdfs:comment": {
    "de": [
      "Die Cafeteria, die sich in der Erweiterung des Komplexes (Bowling, Karting und Laser Game) befindet, ist das eigentliche Nervenzentrum! Sie besteht aus einer Bar und Aufenthaltsräumen mit Bildschirmen und Panoramablick auf die Kartbahn und die Bowlingbahnen."
    ],
    "en": [
      "The cafeteria located in the extension of the complex (Bowling, Karting and Laser Game) is the real nerve center! It has a bar and lounge areas with screens and a panoramic view of the go-karting track and bowling lanes."
    ],
    "it": [
      "La caffetteria situata nell'estensione del complesso (Bowling, Karting e Laser Game) è il vero centro nevralgico! È composta da un bar e da aree lounge con schermi e vista panoramica sulla pista di go-kart e sulle piste da bowling."
    ],
    "fr": [
      "La cafétéria située dans l’extension du complexe (Bowling, Karting et Laser Game) est le réel centre névralgique ! Elle est composée d’un bar et d’espaces salons avec écrans et vue panoramique sur la piste de Karting, mais aussi sur les pistes de bowling."
    ],
    "es": [
      "La cafetería situada en la ampliación del complejo (Bowling, Karting y Laser Game) es el verdadero centro neurálgico Consta de un bar y zonas de descanso con pantallas y una vista panorámica de la pista de karts y las pistas de bolos."
    ],
    "nl": [
      "De cafetaria in het verlengde van het complex (Bowling, Karting en Lasergame) is het echte zenuwcentrum! Het bestaat uit een bar en lounges met schermen en een panoramisch uitzicht op de kartbaan en de bowlingbanen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Cafétéria Loisi Sambre"
    ]
  },
