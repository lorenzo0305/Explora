  "rdfs:comment": {
    "de": [
      "Entdecken Sie das einzigartige Know-how von Piganiol: Ein unumgänglicher Besuch in Aurillac\r\nLassen Sie sich in Aurillac zu einem einzigartigen Erlebnis verführen und besuchen Sie das Maison Piganiol, eine der renommiertesten Regenschirm-Manufakturen Frankreichs."
    ],
    "en": [
      "Discover Piganiol's unique know-how: an unmissable visit to Aurillac\r\nEnjoy a unique experience in Aurillac with a visit to Maison Piganiol, one of France's most prestigious umbrella manufacturers."
    ],
    "it": [
      "Scoprite il know-how unico di Piganiol: una visita imperdibile ad Aurillac\r\nVivete un'esperienza unica ad Aurillac con una visita a Piganiol, uno dei più prestigiosi produttori di ombrelli di Francia."
    ],
    "fr": [
      "Découvrez le Savoir-Faire Unique de Piganiol : Une Visite Incontournable à Aurillac\r\nLaissez-vous séduire par une expérience unique à Aurillac en visitant la Maison Piganiol, l'une des plus prestigieuses manufactures de parapluies en France."
    ],
    "nl": [
      "Ontdek de unieke knowhow van Piganiol: een niet te missen bezoek aan Aurillac\r\nGeniet van een unieke ervaring in Aurillac met een bezoek aan Piganiol, een van de meest prestigieuze paraplufabrikanten van Frankrijk."
    ],
    "es": [
      "Descubra el saber hacer único de Piganiol: una visita ineludible en Aurillac\r\nDisfrute de una experiencia única en Aurillac con una visita a Piganiol, uno de los fabricantes de paraguas más prestigiosos de Francia."
    ]
  },
