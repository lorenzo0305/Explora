  "rdfs:comment": {
    "de": [
      "Der Evian Tennis Club bietet 10 Plätze, davon 9 Greensets und 1 Kunstrasenplatz. Zwei Plätze sind von Winter bis Frühling überdacht und drei Außenplätze sind beleuchtet."
    ],
    "en": [
      "The Evian Tennis Club offers ten courts, including 9 greens and 1 synthetic turf. 2 courts are covered from winter to spring and 3 outdoor courts are lit."
    ],
    "it": [
      "L'Evian Tennis Club offre dieci campi, di cui 9 in green e 1 in erba sintetica. 2 campi sono coperti dall'inverno alla primavera e 3 campi all'aperto sono illuminati."
    ],
    "fr": [
      "L'Evian Tennis Club propose dix courts dont 9 greensets et 1 gazon synthétique. 2 courts sont couverts de l'hiver au printemps et 3 courts extérieurs sont éclairés."
    ],
    "es": [
      "El Club de Tenis Evian cuenta con diez pistas, de las cuales 9 son de hierba y 1 de césped sintético. 2 pistas están cubiertas de invierno a primavera y 3 pistas exteriores están iluminadas."
    ],
    "nl": [
      "De Evian Tennis Club heeft tien banen, waaronder 9 greens en 1 kunstgrasbaan. 2 banen zijn overdekt van winter tot lente en 3 buitenbanen zijn verlicht."
    ]
  },
