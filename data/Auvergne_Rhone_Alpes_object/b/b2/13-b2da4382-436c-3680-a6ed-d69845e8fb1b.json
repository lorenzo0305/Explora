  "rdfs:comment": {
    "de": [
      "Der weltweite Superstar und GRAMMY®-Gewinner Doja Cat kehrt mit ihrer spektakulären Tour Ma Vie World Tour 2026 zurück! Sie ist am 06. Juni 2026 in der LDLC Arena in Lyon-Décines zu Gast."
    ],
    "en": [
      "Global superstar and GRAMMY® winner Doja Cat returns with her spectacular Ma Vie World Tour 2026! She will be performing at the LDLC Arena in Lyon-Décines on 6 June 2026."
    ],
    "it": [
      "La superstar mondiale e vincitrice del GRAMMY® Doja Cat torna con il suo spettacolare Tour Ma Vie World Tour 2026! Sarà all'Arena LDLC di Lione-Décines il 6 giugno 2026."
    ],
    "fr": [
      "La superstar mondiale et lauréate d’un GRAMMY® Doja Cat revient avec son spectaculaire Tour Ma Vie World Tour 2026 ! Elle est de passage à la LDLC Arena de Lyon-Décines, le 06 juin 2026."
    ],
    "nl": [
      "Wereldsuperster en GRAMMY®-winnares Doja Cat keert terug met haar spectaculaire Tour Ma Vie World Tour 2026! Ze staat op 06 juni 2026 in de LDLC Arena in Lyon-Décines."
    ],
    "es": [
      "Doja Cat, superestrella mundial y ganadora del GRAMMY®, regresa con su espectacular Tour Ma Vie World Tour 2026 Estará en el LDLC Arena de Lyon-Décines el 6 de junio de 2026."
    ]
  },
