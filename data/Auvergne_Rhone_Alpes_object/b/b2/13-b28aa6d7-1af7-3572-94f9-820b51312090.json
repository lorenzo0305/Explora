  "rdfs:comment": {
    "de": [
      "Vom 14. bis 18. Mai kehrt ?Brides fait sa comédie? mit einer neuen Auswahl an Komikern ins Kino Le Doron in Brides les Bains zurück.\r\n\r\nEntdecken Sie das Duo Joucla/Massot, das Theaterstück \"Mes Applis, Mes Amours, Mes Emmerdes\" und Alexandre Pesle!"
    ],
    "en": [
      "From May 14 to 18 ?Brides fait sa comédie? will be back with a new selection of comedians at the Le Doron cinema in Brides les Bains.\r\n\r\nCome and discover the Joucla/Massot duo, the play \"Mes Applis, Mes Amours, Mes Emmerdes\" and Alexandre Pesle!"
    ],
    "it": [
      "Dal 14 al 18 maggio, Brides fait sa comédie? torna con una nuova selezione di comici al cinema Le Doron di Brides les Bains.\r\n\r\nVenite a scoprire il duo Joucla/Massot, lo spettacolo \"Mes Applis, Mes Amours, Mes Emmerdes\" e Alexandre Pesle!"
    ],
    "fr": [
      "Du 14 au 18 mai “Brides fait sa comédie” sera de retour avec une nouvelle sélection d’humoristes au cinéma Le Doron de Brides les Bains.\r\n\r\nVenez découvrir le duo Joucla/Massot, la pièce de Théatre \"Mes Applis, Mes Amours, Mes Emmerdes\" et Alexandre Pesle !"
    ],
    "nl": [
      "Van 14 tot 18 mei is Brides fait sa comédie? terug met een nieuwe selectie komieken in bioscoop Le Doron in Brides les Bains.\r\n\r\nKom en ontdek het duo Joucla/Massot, het toneelstuk \"Mes Applis, Mes Amours, Mes Emmerdes\" en Alexandre Pesle!"
    ],
    "es": [
      "Del 14 al 18 de mayo, Brides fait sa comédie? vuelve con una nueva selección de cómicos en el cine Le Doron de Brides les Bains.\r\n\r\n¡Venga a descubrir al dúo Joucla/Massot, la obra \"Mes Applis, Mes Amours, Mes Emmerdes\" y a Alexandre Pesle!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Brides fait sa comédie 2025"
    ]
  },
