  "rdfs:comment": {
    "de": [
      "Produzentin von Biogemüse und Biogetreide, ich bearbeite 2,5 Hektar diversifiziertes Freilandgemüse, davon 3000 m2 Gewächshausfläche, und 48 Hektar Getreide (Raps und Sonnenblumen werden zu Öl für den Großhandel verarbeitet)."
    ],
    "en": [
      "Producer of organic vegetables and cereals, I work 2 hectares of diversified vegetables in open fields including three greenhouses of 1000 m2 in total and 48 hectares of cereals (rapeseed and sunflower transformed into oil for bulk sale)."
    ],
    "it": [
      "Produttore di ortaggi e cereali biologici, lavoro 2,5 ettari di ortaggi diversificati in campo aperto, di cui 3000 m2 di serre, e 48 ettari di cereali (colza e girasole trasformati in olio per la vendita all'ingrosso)"
    ],
    "fr": [
      "Productrice de légumes bio et céréales bio, je travaille 2,5 hectares de légumes diversifiés en plein champs dont 3000 m2 de serres et 48 hectares de céréales (colza et tournesol transformés en huile à la vente en vrac)"
    ],
    "es": [
      "Productor de hortalizas y cereales ecológicos, trabajo 2,5 hectáreas de hortalizas diversificadas en campo abierto, incluidos 3000 m2 de invernaderos, y 48 hectáreas de cereales (colza y girasol transformados en aceite para la venta a granel)"
    ],
    "nl": [
      "Als producent van biologische groenten en granen bewerk ik 2 hectare gediversifieerde groenten in open velden, waaronder drie kassen van 1000 m2, en 48 hectare granen (koolzaad en zonnebloem omgezet in olie voor bulkverkoop)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme Cabotine"
    ]
  },
