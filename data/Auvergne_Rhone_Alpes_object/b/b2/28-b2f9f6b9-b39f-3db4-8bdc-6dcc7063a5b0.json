  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50227deb-3774-373b-a2f7-4a3ff7507e5e",
      "dc:description": {
        "de": [
          "Die Mediathek in Flixecourt empfängt Sie :\n- am Dienstag von 14:00 bis 17:00 Uhr ;\n- am Mittwoch und Freitag von 10:00 bis 12:00 Uhr und von 14:00 bis 19:00 Uhr ;\n- am Samstag von 10:00 bis 12:00 Uhr und von 14:00 bis 17:00 Uhr."
        ],
        "en": [
          "The media library of Flixecourt welcomes you:\n- tuesday from 14:00 to 17:00;\n- wednesday and Friday from 10:00 to 12:00 and from 14:00 to 19:00;\n- saturday from 10:00 to 12:00 and from 14:00 to 17:00."
        ],
        "it": [
          "La mediateca di Flixecourt vi dà il benvenuto:\n- il martedì dalle 14.00 alle 17.00;\n- mercoledì e venerdì dalle 10.00 alle 12.00 e dalle 14.00 alle 19.00;\n- sabato dalle 10.00 alle 12.00 e dalle 14.00 alle 17.00."
        ],
        "fr": [
          "La médiathèque de Flixecourt vous accueille :\n- le mardi de 14h00 à 17h00 ;\n- les mercredi et vendredi de 10h00 à 12h00 et de 14h00 à 19h00 ;\n- le samedi de 10h00 à 12h00 et de 14h00 à 17h00."
        ],
        "es": [
          "La mediateca de Flixecourt le da la bienvenida:\n- los martes de 14 a 17 horas;\n- miércoles y viernes de 10 a 12 y de 14 a 19 horas;\n- los sábados de 10 a 12 y de 14 a 17 horas."
        ],
        "nl": [
          "De mediatheek van Flixecourt heet u welkom:\n- dinsdags van 14.00 tot 17.00 uur;\n- woensdag en vrijdag van 10 tot 12 uur en van 14 tot 19 uur;\n- op zaterdag van 10 tot 12 uur en van 14 tot 17 uur."
        ]
      },
