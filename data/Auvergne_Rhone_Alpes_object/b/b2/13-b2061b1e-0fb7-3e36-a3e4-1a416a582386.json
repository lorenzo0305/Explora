  "rdfs:comment": {
    "de": [
      "Indoor-Freizeit- und Vergnügungspark für Kinder von 1 bis 11 Jahren (CM2): 1000m² Spielstrukturen, Rutschen, Trampoline, 45m² Babybereich, Hüpfburg, virtuelle und interaktive Schatzsuche, Tretkarts- und Draisinenbahn."
    ],
    "en": [
      "Indoor amusement park for children aged 1 to 11 (CM2): 1,000m² of play structures, slides, trampolines, 45m² Baby area, bouncy castle, virtual interactive treasure hunt, pedal go-kart track and draisiennes."
    ],
    "it": [
      "Parco divertimenti al coperto per bambini da 1 a 11 anni (CM2): 1.000 m² di strutture di gioco, scivoli, tappeti elastici, 45 m² di area baby, castello gonfiabile, caccia al tesoro virtuale e interattiva, pista di go-kart a pedali e draisiennes."
    ],
    "fr": [
      "Parc de loisirs et d'attraction indoor pour les enfants de 1 à 11 ans (CM2) : 1 000m² de structures de jeux, tobogans, trampolines, Espace Baby de 45m², château gonflable, chasse au trésor virtuelle et interactive, piste de Karts à pédales et draisiennes."
    ],
    "es": [
      "Parque de atracciones cubierto para niños de 1 a 11 años (CM2): 1.000 m² de estructuras de juego, toboganes, camas elásticas, zona Baby de 45 m², castillo hinchable, búsqueda del tesoro virtual e interactiva, pista de karts a pedales y draisiennes."
    ],
    "nl": [
      "Indoorpretpark voor kinderen van 1 tot 11 jaar (CM2): 1.000m² speelstructuren, glijbanen, trampolines, babyruimte van 45m², springkasteel, virtuele en interactieve schattenjacht, skelterbaan en draisiennes."
    ]
  },
  "rdfs:label": {
    "fr": [
