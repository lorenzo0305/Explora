  "rdfs:comment": {
    "de": [
      "Die 1926 im Stadtzentrum von Péronne gegründete Brauerei De Clerck ist für ihre vielfältige und qualitativ hochwertige handwerkliche Produktion bekannt."
    ],
    "en": [
      "Established in 1926 in downtown Péronne, the De Clerck brewery is known for its varied, high-quality artisanal production."
    ],
    "it": [
      "Fondata nel 1926 nel centro di Péronne, la birreria De Clerck è nota per la sua produzione tradizionale varia e di alta qualità."
    ],
    "fr": [
      "Établie en 1926 en centre-ville de Péronne, la brasserie De Clerck est connue pour sa production artisanale variée et de qualité."
    ],
    "nl": [
      "De brouwerij De Clerck, opgericht in 1926 in het centrum van Péronne, staat bekend om haar gevarieerde en kwalitatief hoogstaande traditionele productie."
    ],
    "es": [
      "Creada en 1926 en el centro de Péronne, la cervecería De Clerck es conocida por su producción tradicional variada y de gran calidad."
    ]
  },
