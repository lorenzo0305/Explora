  "rdfs:comment": {
    "de": [
      "Der Staudamm besteht aus zwei unterschiedlich großen Stauseen: 2 ha + 33 ha.\r\nNeuheit 2026: Fischereiaufseher, der der AAPPMA von Combronde zugewiesen ist und für die Überwachung des Staudamms von La Sep zuständig ist."
    ],
    "en": [
      "The dam consists of two reservoirs of different sizes: 2 ha + 33 ha.\r\nNew for 2026: Fishing warden assigned to the Combronde AAPPMA (Association Agréée de Pêche et de Protection du Milieu Aquatique - Approved Association for Fishing and Protection of the Aquatic Environment) and responsible for monitoring the Sep dam."
    ],
    "it": [
      "La diga è composta da 2 bacini disuguali: 2 ha + 33 ha.\r\nNovità 2026: guardiano della pesca assegnato all'AAPPMA di Combronde e responsabile del monitoraggio della diga di Sep."
    ],
    "fr": [
      "Le barrage est composé de 2 retenues inégales : 2 ha + 33 ha.\r\nNouveauté 2026 : Garde de pêche affecté à l'AAPPMA de Combronde et en charge de la surveillance du barrage de la Sep."
    ],
    "es": [
      "La presa se compone de 2 embalses desiguales: 2 ha + 33 ha.\r\nNovedad en 2026: guarda de pesca asignado a la AAPPMA de Combronde y responsable de la vigilancia de la presa del Sep."
    ],
    "nl": [
      "De stuwdam bestaat uit 2 ongelijke reservoirs: 2 ha + 33 ha.\r\nNieuw in 2026: Visserijopzichter toegewezen aan de AAPPMA Combronde en verantwoordelijk voor het toezicht op de stuwdam Sep."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Sep-Damm"
    ],
    "en": [
      "Fishing site - Barrage de la Sep"
    ],
    "fr": [
      "Site de pêche - Barrage de la Sep"
    ]
  },
