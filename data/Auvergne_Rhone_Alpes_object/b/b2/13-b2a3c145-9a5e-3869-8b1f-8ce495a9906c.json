  "rdfs:comment": {
    "de": [
      "Saint-Vincent beherbergte früher eine Komturei der Ritter des Hospitals von Sankt Johannes zu Jerusalem.\r\nAnzahl der Einwohner: 398\r\nFläche: 1.333 Hektar"
    ],
    "en": [
      "Saint-Vincent was once home to a commandery of the Knights of the Hospital of Saint-Jean-de-Jérusalem.\nPopulation: 398\nSurface area: 1,333 hectares"
    ],
    "it": [
      "Saint-Vincent ospitava una commenda dei Cavalieri dell'Ospedale di San Giovanni di Gerusalemme.\r\nNumero di abitanti: 398\r\nSuperficie: 1.333 ettari"
    ],
    "fr": [
      "Saint-Vincent hébergeait autrefois une commanderie des chevaliers de l’Hôpital de Saint-Jean-de-Jérusalem.\r\nNombre d'habitants : 398\r\nSuperficie : 1 333 hectares"
    ],
    "nl": [
      "Vroeger stond in Saint-Vincent een commanderij van de hospitaalridders. De oude, natuurstenen huizen aan de hoofdstraat van het dorp lijken de gastvrije traditie van de commanderij in ere te houden."
    ],
    "es": [
      "Saint-Vincent albergó en su día una comandancia de los Caballeros del Hospital de San Juan de Jerusalén.\r\nNúmero de habitantes: 398\r\nSuperficie: 1.333 hectáreas"
    ]
  },
