  "rdfs:comment": {
    "de": [
      "Charlène empfängt Sie in ihrem renovierten Lokal in einer familiären Atmosphäre und bietet Ihnen eine großzügige, hausgemachte Küche mit lokalen Aromen."
    ],
    "en": [
      "Charlène welcome you to her renovated establishment in a warm atmosphere and offer you gourmet cuisine, homemade with local flavors: St Nectaire fondue, beef steak, ... all accompanied by volcanic wines."
    ],
    "it": [
      "Charlène vi accoglie nella sua struttura rinnovata in un'atmosfera familiare e vi offre una cucina generosa, casalinga e dai sapori locali."
    ],
    "fr": [
      "Charlène vous accueillent dans son établissement rénové dans une ambiance familiale & vous propose une cuisine généreuse , faite maison aux saveurs locales."
    ],
    "nl": [
      "Charlène verwelkomt je in haar gerenoveerde etablissement in een familiale sfeer en biedt een royale, huisgemaakte keuken met lokale smaken."
    ],
    "es": [
      "Charlène le da la bienvenida a su renovado establecimiento en un ambiente familiar y le ofrece una generosa cocina casera con sabores locales."
    ]
  },
