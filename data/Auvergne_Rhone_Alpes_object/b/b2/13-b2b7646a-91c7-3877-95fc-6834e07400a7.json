  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse der Verarbeitung und Verwendung von Aroma- und Medizinalpflanzen: ätherische Öle, Blütenwasser, Kräutertees, Seifen, Kosmetika, Alkohol... Botanischer Pfad, Spaziergänge, Besichtigungen, Vorführungen, Shop, Imbiss/Eisdiele."
    ],
    "en": [
      "La Distillerie du Bois de Païolive Flor’Ardèche welcomes you to its garden filled with both wild and cultivated species of Mediterranean medecinal plants whose fragrances will enchant you."
    ],
    "it": [
      "Scoprite i segreti della trasformazione e degli usi delle piante aromatiche e medicinali: oli essenziali, acque floreali, tisane, saponi, cosmetici, alcolici... Percorso botanico, passeggiate, visite, dimostrazioni, negozio, bar/gelateria."
    ],
    "fr": [
      "Découvrez les secrets de la transformation et des usages des plantes aromatiques et médicinales : huiles essentielles, eaux florales, tisanes, savons, cosmétiques, alcools... Sentier botanique, balades, visites, démonstrations, boutique, buvette/glacier."
    ],
    "nl": [
      "Ontdek de geheimen van de transformatie en het gebruik van aromatische en geneeskrachtige planten: essentiële oliën, bloemenwaters, kruidenthee, zeep, cosmetica, alcoholen... Botanische route, wandelingen, bezoeken, demonstraties, winkel, bar/ijssalon."
    ],
    "es": [
      "Descubra los secretos de la transformación y los usos de las plantas aromáticas y medicinales: aceites esenciales, aguas florales, tisanas, jabones, cosméticos, alcoholes... Recorrido botánico, paseos, visitas, demostraciones, tienda, bar/heladería."
    ]
  },
