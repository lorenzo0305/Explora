  "rdfs:comment": {
    "de": [
      "Tauchen Sie mit unserem Escape Game im Montagut-Museum in die 200-jährige Geschichte der Seidenindustrie ein!\r\nHaben Sie den richtigen Riecher, um das Rätsel zu lösen? Testen Sie es, wo die Geschichte der Textilindustrie zum Abenteuer wird!"
    ],
    "en": [
      "Immerse yourself in 200 years of the silk industry with our immersive escape game at Musée Montagut!\r\nWill you find the thread to solve the riddle? Come and test your skills, where the history of textiles becomes an adventure!"
    ],
    "it": [
      "Immergetevi in 200 anni di industria della seta con il nostro gioco di fuga immersivo al Musée Montagut!\r\nRiuscirete a trovare il filo per risolvere l'enigma? Venite a provare, dove la storia del tessile diventa un'avventura!"
    ],
    "fr": [
      "Plongez au cœur de 200 ans d'industrie soyeuse avec notre escape game immersif au Musée Montagut !\r\nAurez-vous le fil pour résoudre l'énigme ? Venez tester, là où l'histoire du textile devient aventure !"
    ],
    "es": [
      "Sumérjase en los 200 años de la industria de la seda con nuestro juego de escape inmersivo en el Museo Montagut\r\n¿Encontrará el hilo para resolver el enigma? Venga a probarlo, ¡donde la historia del textil se convierte en una aventura!"
    ],
    "nl": [
      "Dompel jezelf onder in 200 jaar zijde-industrie met ons meeslepende ontsnappingsspel in het Musée Montagut!\r\nVind jij de draad om het raadsel op te lossen? Kom het proberen, waar de geschiedenis van textiel een avontuur wordt!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escape Game - Musée Montagut"
    ]
  },
