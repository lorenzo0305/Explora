  "rdfs:comment": {
    "de": [
      "GAEC Escourolle in Lugarde. Wir sind leidenschaftliche Züchter von etwa 50 Montbéliard-Kühen und produzieren Saint Nectaire Fermier AOP, wobei die Kühe in der Milchproduktion nur Gras und Heu fressen."
    ],
    "en": [
      "GAEC Escourolle in Lugarde. Passionate breeders of some fifty Montbéliard cows, we produce Saint Nectaire Fermier PDO with grass and hay as fodder for the dairy cows."
    ],
    "it": [
      "GAEC Escourolle a Lugarde. Allevatori appassionati di una cinquantina di vacche Montbéliardes, produciamo Saint Nectaire Fermier DOP con solo erba e fieno come foraggio per le vacche da latte."
    ],
    "fr": [
      "GAEC Escourolle à Lugarde. Éleveurs passionnés d’une cinquantaine de vaches Montbéliardes, nous produisons du Saint Nectaire Fermier AOP avec comme fourrage pour les vaches en production laitière uniquement de l'herbe et du foin."
    ],
    "nl": [
      "GAEC Escourolle in Lugarde. Gepassioneerde fokkers van zo'n vijftig Montbéliardes-koeien produceren Saint Nectaire Fermier BOB met alleen gras en hooi als voer voor de melkkoeien."
    ],
    "es": [
      "GAEC Escourolle en Lugarde. Criadores apasionados de unas cincuenta vacas Montbéliardes, producimos Saint Nectaire Fermier DOP con sólo hierba y heno como forraje para las vacas lecheras."
    ]
  },
