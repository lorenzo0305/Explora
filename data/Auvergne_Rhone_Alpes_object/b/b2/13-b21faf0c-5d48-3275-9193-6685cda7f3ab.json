  "rdfs:comment": {
    "de": [
      "Die Brasserie / Pizzeria Le Vega liegt gegenüber der Schneefront auf der Seite der Galerie du Pelvoux und bietet eine große Sonnenterrasse sowie einen schönen Saal im Inneren mit einer Sitzecke."
    ],
    "en": [
      "Located opposite the \"snow front\" next to LaGalerie du Pelvoux. the brasserie/pizzeria, Le Vega, has a large terrace as well as a beautiful indoor dining area."
    ],
    "it": [
      "Situata di fronte al fronte della neve, sul lato della galleria Pelvoux, la brasserie/pizzeria Le Vega offre un'ampia terrazza soleggiata e una bella sala interna con area lounge."
    ],
    "fr": [
      "Située face au front de neige, du côté de la galerie du Pelvoux, la brasserie / pizzeria Le Vega offre une grande terrasse ensoleillée ainsi qu'une belle salle en intérieur, avec un coin salon."
    ],
    "es": [
      "Situada frente a la nieve, en el lado de la galería Pelvoux, la brasserie / pizzería Le Vega ofrece una gran terraza soleada, así como una hermosa sala interior con zona de estar."
    ],
    "nl": [
      "Le Vega brasserie / pizzeria ligt tegenover het sneeuwfront, aan de kant van de Pelvoux-galerie, en biedt zowel een groot zonnig terras als een mooie binnenruimte met een zithoek."
    ]
  },
