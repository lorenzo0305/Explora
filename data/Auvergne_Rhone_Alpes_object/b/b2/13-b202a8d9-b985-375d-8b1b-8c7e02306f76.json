  "rdfs:comment": {
    "de": [
      "L?Envolée in Creys-Mépieu ist ein intimer Veranstaltungssaal mit 49 Plätzen, der sich der darstellenden Kunst widmet. Sie wird von einer Vereinigung begeisterter Freiwilliger getragen und bietet das ganze Jahr über ein abwechslungsreiches Programm und Theaterworkshops für alle an."
    ],
    "en": [
      "In Creys-Mépieu, L?Envolée is an intimate 49-seat theater dedicated to live performance. Run by an association of enthusiastic volunteers, it offers a varied program and theater workshops open to all throughout the year."
    ],
    "it": [
      "A Creys-Mépieu, L'Envolée è un teatro intimo di 49 posti dedicato allo spettacolo dal vivo. Gestito da un'associazione di volontari appassionati, offre un programma vario e laboratori teatrali aperti a tutti durante tutto l'anno."
    ],
    "fr": [
      "À Creys-Mépieu, L’Envolée est une salle de spectacle intimiste de 49 places dédiée au spectacle vivant. Portée par une association de bénévoles passionnés, elle propose toute l’année une programmation variée et des ateliers théâtre ouverts à tous."
    ],
    "nl": [
      "In Creys-Mépieu is L'Envolée een intiem theater met 49 zitplaatsen dat gewijd is aan live optredens. Het wordt gerund door een vereniging van gepassioneerde vrijwilligers en biedt het hele jaar door een gevarieerd programma en theaterworkshops voor iedereen."
    ],
    "es": [
      "En Creys-Mépieu, L'Envolée es un teatro íntimo de 49 plazas dedicado al espectáculo en vivo. Dirigido por una asociación de voluntarios apasionados, ofrece una programación variada y talleres de teatro abiertos a todos durante todo el año."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Salle de spectacle L'envolée"
    ]
  },
