  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere Auswahl an Säften, Suppen, Salaten, Healthy Sandwiches... die mit frischen und natürlichen Zutaten zubereitet werden. Jeder Bissen und Schluck ist so konzipiert, dass er Ihren Gaumen verwöhnt und Ihren Körper nährt."
    ],
    "en": [
      "Discover our range of juices, soups, salads, healthy sandwiches... prepared with fresh, natural ingredients. Every bite and sip is designed to delight your taste buds and nourish your body."
    ],
    "it": [
      "Scoprite la nostra gamma di succhi, zuppe, insalate, panini sani... preparati con ingredienti freschi e naturali. Ogni boccone e sorso è pensato per deliziare le vostre papille gustative e nutrire il vostro corpo."
    ],
    "fr": [
      "Découvrez notre gamme de jus, soupes, salades, sandwichs healthy... préparés avec des ingrédients frais et naturels. Chaque bouchée et gorgée sont conçues pour ravir vos papilles et nourrir votre corps."
    ],
    "nl": [
      "Ontdek ons assortiment sappen, soepen, salades, gezonde sandwiches... bereid met verse, natuurlijke ingrediënten. Elke hap en slok is ontworpen om je smaakpapillen te verwennen en je lichaam te voeden."
    ],
    "es": [
      "Descubra nuestra gama de zumos, sopas, ensaladas, sándwiches saludables... preparados con ingredientes frescos y naturales. Cada bocado y sorbo está diseñado para deleitar su paladar y nutrir su cuerpo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ced & Jus"
    ]
  },
