  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5bd6f201-ac97-34e8-b265-4fd1b41b02fd",
      "dc:description": {
        "de": [
          "Die Gespenster von Halloween halten Einzug in Hénin-Beaumont.\nAuf dem Programm stehen:\n- Kürbisschnitzen ;\n- Aufführung ;\n- Schminkstand ;\n- Kostümwettbewerb...\n- Vorführung des Films \"Sacrées Momies\" (Heilige Mumien)"
        ],
        "en": [
          "The ghosts of Halloween come to Hénin-Beaumont.\nOn the program:\n- Pumpkin carving ;\n- Shows ;\n- Face painting;\n- Costume contest...\n- Screening of the film \"Sacrées Momies"
        ],
        "it": [
          "I fantasmi di Halloween arrivano a Hénin-Beaumont.\nIn programma:\n- Intaglio di zucche;\n- Spettacoli;\n- Pittura del viso;\n- Concorso in maschera...\n- Proiezione del film \"Sacrées Momies"
        ],
        "fr": [
          "Les fantômes d'Halloween s'invitent à Hénin-Beaumont. \nAu programme : \n- Sculpture de citrouilles ; \n- Spectacle ;\n- Stand de maquillage ;\n- Concours de déguisements...\n- Projection du film \"Sacrées Momies\""
        ],
        "es": [
          "Los fantasmas de Halloween llegan a Hénin-Beaumont.\nEn el programa:\n- Talla de calabazas;\n- Espectáculos ;\n- Pintura de caras;\n- Concurso de disfraces...\n- Proyección de la película \"Sacrées Momies"
        ],
        "nl": [
          "De spoken van Halloween komen naar Hénin-Beaumont.\nOp het programma:\n- Pompoen snijden;\n- Shows ;\n- Schminken;\n- Verkleedwedstrijd...\n- Vertoning van de film \"Sacrées Momies"
        ]
      },
      "@type": [
        "Description"
