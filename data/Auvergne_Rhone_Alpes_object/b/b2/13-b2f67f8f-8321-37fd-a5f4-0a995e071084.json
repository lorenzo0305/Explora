    "de": [
      "Charmante Kirche mit geschnitzten Holzpaneelen. Das Pfarrhaus bietet Ausstellungen und einen Ziergarten zum Klang des Glockenspiels."
    ],
    "en": [
      "Charming church with carved wood panels. The curacy offers exhibitions and an ornamental garden to the sound of the carillon."
    ],
    "it": [
      "Incantevole chiesa con pannelli in legno intagliato. La chiesa parrocchiale offre mostre e un giardino ornamentale al suono del carillon."
    ],
    "fr": [
      "Charmante église dotée de panneaux de bois sculpté. La cure propose des expositions et un jardin d'ornement au son du carillon."
    ],
    "es": [
      "Encantadora iglesia con paneles de madera tallada. La iglesia parroquial ofrece exposiciones y un jardín ornamental al son del carillón."
    ],
    "nl": [
      "Charmante kerk met gebeeldhouwde houten panelen. De parochiekerk biedt tentoonstellingen en een siertuin op het geluid van de beiaard."
    ]
