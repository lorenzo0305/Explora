  "rdfs:comment": {
    "de": [
      "Die Gemeinde verfügt über zwei Squashplätze und eine Squashwand, die vom Verein Miribel Tennis genutzt werden. Um einen Platz zu reservieren, müssen Sie nur Ihren Namen und den Ihres Partners auf der Reservierungstafel eintragen."
    ],
    "en": [
      "The commune has two courts and a squash wall, which are used by the Miribel Tennis association. To reserve a court, simply enter your name and that of your partner on the reservation board."
    ],
    "it": [
      "Il comune dispone di due campi e di una parete da squash, utilizzati dall'Associazione Tennis Miribel. Per prenotare un campo è sufficiente inserire il proprio nome e quello del partner nell'apposito cartellone."
    ],
    "fr": [
      "La commune dispose de deux terrains et d'un mur de squash dont l'utilisation est assurée par l'association Miribel Tennis. Pour réserver un terrain, il suffit d’inscrire son nom et celui de son partenaire sur le tableau de réservation."
    ],
    "es": [
      "El municipio dispone de dos pistas y una pared de squash, que son utilizadas por la Asociación de Tenis Miribel. Para reservar una pista, basta con introducir su nombre y el de su pareja en el tablón de reservas."
    ],
    "nl": [
      "De gemeente beschikt over twee banen en een squashmuur, die worden gebruikt door de Tennisvereniging Miribel. Om een baan te reserveren hoeft u alleen uw naam en die van uw partner in te vullen op het reserveringsbord."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Courts de tennis"
    ]
  },
