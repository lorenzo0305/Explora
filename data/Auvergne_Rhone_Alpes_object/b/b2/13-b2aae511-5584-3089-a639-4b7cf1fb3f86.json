  "rdfs:comment": {
    "de": [
      "Rutschen, Siegel, Wasserfall, aufblasbare Spiele, Solarium, Nebler...\r\nEntdecken Sie mit Ihrer Familie eine 750m² große Insel der Frische"
    ],
    "en": [
      "Slides, bucket, waterfall, inflatable games, solarium, misters...\r\nWith your family, come and discover an island of coolness of 750m²"
    ],
    "it": [
      "Scivoli, secchiello, cascata, giochi gonfiabili, solarium, misters...\r\nCon la vostra famiglia, venite a scoprire un'isola di freschezza di 750 m²"
    ],
    "fr": [
      "Toboggans, sceau, cascade, jeux gonflables, solarium, brumisateurs.. \r\nEn famille, venez découvrir un îlot de fraicheur de 750m²"
    ],
    "es": [
      "Toboganes, cubo, cascada, juegos hinchables, solarium, nebulizadores...\r\nCon su familia, venga a descubrir una isla de frescor de 750m²"
    ],
