  "rdfs:comment": {
    "de": [
      "Das Restaurant besteht aus zwei Räumen mit je 50 Plätzen und einer Terrasse auch mit 50 Plätzen. Der Chef bietet Ihnen Menüs, die von der Saison und dem Tagesmarkt abhängen."
    ],
    "en": [
      "Two 50-seater dining-rooms and a 50-seater terrace. Our chef has put together different menus based on seasonal and local market produce."
    ],
    "it": [
      "Il ristorante dispone di una sala da pranzo, una terrazza estiva e una sala riunioni. Lo chef propone menu e formule antipasto/primo piatto o secondo piatto/dessert che variano a seconda della stagione e del mercato del giorno."
    ],
    "fr": [
      "Le restaurant se compose d'une salle et d'une terrasse pour l'été ainsi que d'une salle de réunion. Le chef vous propose des menus ainsi que des formules entrée/plat ou plat/dessert variant au gré des saisons et du marché du jour."
    ],
    "nl": [
      "Traditionele keuken. Restaurant met traditionele, huisgemaakte gerechten, streekproducten op een schaduwrijk terras."
    ],
    "es": [
      "El restaurante dispone de un comedor, una terraza de verano y una sala de reuniones. El chef ofrece menús y fórmulas de entrante/principal o plato principal/postre que varían según la temporada y el mercado del día."
    ]
  },
