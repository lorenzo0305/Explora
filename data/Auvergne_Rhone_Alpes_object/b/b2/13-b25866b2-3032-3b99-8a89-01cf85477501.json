  "rdfs:comment": {
    "de": [
      "Neuer Name, dieselben Köche, dieselbe Philosophie, um die Identität und die Werte des Restaurants zu bekräftigen: \"Aus der Natur blüht der Teller\". Die Damen stehen im Mittelpunkt, Mutter Natur inspiriert die Damen TIRET Edwige und DUGAT Léonie."
    ],
    "en": [
      "New name, same Chefs, same philosophy, to affirm the identity and values of the restaurant, 'From nature to the plate'. The ladies have the place of honour, Mother Nature inspiring the TIRET Edwige and DUGAT Léonie ladies."
    ],
    "it": [
      "Nuovo nome, stessi chef, stessa filosofia, per affermare l'identità e i valori del ristorante: \"Dalla natura nasce il piatto\". Le signore hanno il posto d'onore, Madre Natura ispira le signore TIRET Edwige e DUGAT Léonie."
    ],
    "fr": [
      "Nouveau nom, mêmes Chefs, même philosophie, afin d’affirmer l’identité et les valeurs du restaurant, ‘De la nature éclot l’assiette’. Les dames sont à l’honneur, Dame Nature qui inspire les Dames TIRET Edwige et DUGAT Léonie."
    ],
    "es": [
      "Nuevo nombre, mismos Chefs, misma filosofía, para afirmar la identidad y los valores del restaurante, \"De la naturaleza brota el plato\". Las damas ocupan el lugar de honor, la Madre Naturaleza inspira a las damas TIRET Edwige y DUGAT Léonie."
    ],
    "nl": [
      "Nieuwe naam, dezelfde chefs, dezelfde filosofie, om de identiteit en waarden van het restaurant te bevestigen, 'Van de natuur tot op het bord'. De dames hebben de ereplaats, Moeder Natuur inspireert de dames TIRET Edwige en DUGAT Léonie."
    ]
  },
  "rdfs:label": {
