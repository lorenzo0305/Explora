  "rdfs:comment": {
    "de": [
      "Die Mediathek Ange Abrate ist als Ort des Lebens, der Freizeit und des kreativen Schaffens konzipiert. Sie bietet ein vielfältiges dokumentarisches Angebot sowie zahlreiche kulturelle Aktivitäten."
    ],
    "en": [
      "The Ange Abrate media library is conceived as a place for living, leisure and creation. It offers a diversified documentary offer as well as numerous cultural activities."
    ],
    "it": [
      "La mediateca di Ange Abrate è concepita come un luogo di vita, di svago e di creazione. Offre una vasta gamma di documenti e numerose attività culturali."
    ],
    "fr": [
      "La médiathèque Ange Abrate est conçue comme un lieu de vie, de loisirs et de création. Elle propose une offre documentaire diversifiée ainsi que de nombreuses activités culturelles."
    ],
    "es": [
      "La mediateca de Ange Abrate está concebida como un lugar de vida, ocio y creación. Ofrece una amplia gama de documentos, así como numerosas actividades culturales."
    ],
    "nl": [
      "De mediatheek van Ange Abrate is ontworpen als een plaats voor leven, ontspanning en creatie. Het biedt een breed scala aan documenten en talrijke culturele activiteiten."
    ]
  },
