  "rdfs:comment": {
    "de": [
      "Das ultimative VR-Erlebnis! In einem 400m² großen Raum können Sie mit 2 Spielen in eine virtuelle Welt eintauchen: \"After-H Battle Arena\" (+12 Jahre) oder \"Moon of the Dead\" (+16 Jahre)."
    ],
    "en": [
      "The ultimate VR experience! In a 500m² room, immerse yourself in a virtual world with 2 games: \"After-H Battle Arena\" (+12 years) or \"Moon of the Dead\" (+16 years)."
    ],
    "it": [
      "L'esperienza VR per eccellenza! In una sala di 500 m², immergetevi in un mondo virtuale con 2 giochi: \"After-H Battle Arena\" (+12 anni) o \"Moon of the Dead\" (+16 anni)."
    ],
    "fr": [
      "L'expérience VR ultime ! Dans une salle de 500m², immergez vous dans un monde virtuel avec 2 jeux : \"After-H Battle Arena\" (+12 ans) ou \"Moon of the Dead\" (+16 ans)."
    ],
    "es": [
      "¡La experiencia VR definitiva! En una sala de 500 m², sumérgete en un mundo virtual con 2 juegos: \"After-H Battle Arena\" (+12 años) o \"Moon of the Dead\" (+16 años)."
