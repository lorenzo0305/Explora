  "rdfs:comment": {
    "de": [
      "Le Dolmen serviert abwechslungsreiche Küche mit hausgemachten Produkten sowie mehrere Menüarten auf Anfrage. Kommunionsfeiern, Taufen, Familienfeiern – zögern Sie nicht, uns zu fragen!"
    ],
    "en": [
      "Restaurant managed by the same family for several generations. It offers a regional cuisine with a Forez accent. The menus are renewed frequently and the cuisine is entirely homemade using local and seasonal products."
    ],
    "it": [
      "Un ristorante con una tradizione familiare di diverse generazioni, che propone una cucina regionale con accento Forez. I menu vengono cambiati frequentemente e i piatti sono tutti fatti in casa con prodotti locali di stagione."
    ],
    "fr": [
      "Restaurant de tradition familiale depuis plusieurs générations et proposant une cuisine régionale avec l'accent du Forez. Les menus sont renouvelés fréquemment et la cuisine est entièrement faite \"maison\" à base de produits locaux de saison."
    ],
    "es": [
      "Restaurante de tradición familiar de varias generaciones que sirve cocina regional con acento de Forez. Los menús cambian con frecuencia y la comida es casera y se elabora con productos locales de temporada."
    ],
    "nl": [
      "Een restaurant met een familietraditie die al meerdere generaties teruggaat, waar regionale gerechten met een Forez accent worden geserveerd. De menu's veranderen regelmatig en het eten is allemaal huisgemaakt met lokale seizoensproducten."
    ]
  },
  "rdfs:label": {
    "de": [
      "Restaurant Le Dolmen –  Traditionelle Küche (und Hotel)"
    ],
    "en": [
      "Restaurant \"Le Dolmen\""
    ],
    "fr": [
      "Le Dolmen"
    ]
  },
