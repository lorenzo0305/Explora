  "rdfs:comment": {
    "de": [
      "Der Park liegt nur wenige Schritte vom Naturreservat der Dranse entfernt\r\n beherbergt ein Mosaik aus verschiedenen Lebensräumen: Feuchtgebiete, Waldgebiete, Strauchränder und offene Wiesenflächen."
    ],
    "en": [
      "Located just a stone's throw from the Dranse Nature Reserve, the park is home to a mosaic of environments: wetlands, wooded areas, shrub borders and open meadows."
    ],
    "it": [
      "Situato a pochi passi dalla Riserva Naturale di Dranse, il parco ospita un mosaico di ambienti: zone umide, aree boschive, bordure di arbusti e prati aperti\r\n ospita un mosaico di ambienti: zone umide, aree boschive, bordure di arbusti e prati aperti."
    ],
    "fr": [
      "Situé à quelques pas de la Réserve Naturelle de la Dranse, le parc \r\n accueille une mosaïque de milieux : des secteurs humides, des espaces boisées, des lisières arbustives et des espaces ouverts de prairie."
    ],
    "es": [
      "Situado a tiro de piedra de la Reserva Natural de Dranse, el parque\r\n alberga un mosaico de ambientes: humedales, zonas boscosas, lindes arbustivas y praderas abiertas."
    ],
    "nl": [
      "Het park ligt op een steenworp afstand van het Dranse Natuurreservaat en herbergt een mozaïek van omgevingen: wetlands, beboste gebieden, bosranden en open weiden."
    ]
  },
  "rdfs:label": {
    "en": [
