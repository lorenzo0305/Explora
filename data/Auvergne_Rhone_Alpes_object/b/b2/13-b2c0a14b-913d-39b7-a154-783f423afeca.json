  "rdfs:comment": {
    "de": [
      "In der Residenz Manaka empfängt Sie die M'Bar jeden Tag, um nach dem Skifahren eine heiße Schokolade oder einen Tee zu genießen. Abends können Sie einen geselligen Moment bei einem Glas Savoyer Wein oder einem Cocktail verbringen."
    ],
    "en": [
      "In Manaka residence, the M'Bar is open every day for a hot chocolate or a tea when you get back from skiing, or for a convivial glass of Savoie wine or a cocktail  in the evening."
    ],
    "it": [
      "Nella residenza Manaka, il M'Bar vi accoglie ogni giorno per una cioccolata calda o un tè dopo lo sci, e la sera per un bicchiere di vino della Savoia o un cocktail."
    ],
    "fr": [
      "Au sein de la résidence Manaka, le M'Bar vous accueille tous les jours pour partager un chocolat chaud ou un thé au retour du ski et en soirée pour partager un instant convivial autour d'un verre de vin de Savoie ou d'un cocktail."
    ],
    "nl": [
      "In de Manaka residentie verwelkomt de M'Bar je elke dag voor een warme chocolademelk of thee na het skiën, en 's avonds voor een glas Savoie wijn of een cocktail."
    ],
    "es": [
      "En la residencia Manaka, el M'Bar le da la bienvenida todos los días para tomar un chocolate caliente o un té después de esquiar, y por la noche para tomar una copa de vino de Saboya o un cóctel."
    ]
  },
