  "rdfs:comment": {
    "de": [
      "Museumsbereich, der einen Einblick in die Geschichte der lokalen Käsesorten, das Leben der Landwirte und des Käsers bietet."
    ],
    "en": [
      "In this museum, you will learn more about the history of cheese, the life of farmers and cheese-mongers.\r\nMoulding of the cheese at 9:30 am.\r\n\r\nOpen access, guided tours, cheese-making workshop by reservation only.\r\nSale of local handicrafts."
    ],
    "it": [
      "L'esposizione illustra la storia dei formaggi, la vita degli agricoltori e dei formaggiai.\r\nMessa in forma degli formaggi alle ore 9:30.\r\n\r\nVisita libera, guidata, laboratorio di produzione... su prenotazione.\r\nVendita di prodotti artigianali."
    ],
    "fr": [
      "Espace muséographique permettant de mieux comprendre l'histoire des fromages locaux, la vie des agriculteurs et du fromager."
    ],
    "es": [
      "Un espacio museográfico donde podrá conocer mejor la historia de los quesos locales y la vida de los ganaderos y queseros."
    ],
    "nl": [
      "Museumruimte waar u de geschiedenis van de lokale kazen, het leven van de boeren en de kaasboeren kunt ontdekken.\r\nPersen van kazen om 9.30 uur.\r\n\r\nBezoek met of zonder rondleiding, productieruimte...op reservering.\r\nVerkoop van ambachtelijke producten."
    ]
  },
