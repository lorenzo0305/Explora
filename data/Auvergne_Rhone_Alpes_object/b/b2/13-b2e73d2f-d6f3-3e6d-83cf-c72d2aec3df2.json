  "rdfs:comment": {
    "de": [
      "Auf dem Gipfel des Dorfes zeugen die Ruinen des mittelalterlichen Schlosses und die Kirche St Félix von einem intensiven Leben im Mittelalter."
    ],
    "en": [
      "At the top of the village, the ruins of the medieval castle and the church of St. Félix bear witness to the intense life of the Middle Ages."
    ],
    "it": [
      "In cima al villaggio, le rovine del castello medievale e della chiesa di Saint-Félix testimoniano l'intensa vita del Medioevo."
    ],
    "fr": [
      "Au sommet du village, les ruines du château médiéval et l'église Saint-Félix témoignent d'une vie intense au Moyen-Âge."
    ],
    "nl": [
      "Op de top van het dorp getuigen de ruïnes van het middeleeuwse kasteel en de kerk van St Félix van een intens leven in de Middeleeuwen."
    ],
    "es": [
      "En lo alto del pueblo, las ruinas del castillo medieval y la iglesia de Saint-Félix son testigos de una intensa vida en la Edad Media."
    ]
  },
