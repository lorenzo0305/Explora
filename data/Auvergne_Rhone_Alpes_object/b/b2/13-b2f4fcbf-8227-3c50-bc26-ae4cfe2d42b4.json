  "rdfs:comment": {
    "de": [
      "Rund um den Dorfplatz, in einer geselligen Atmosphäre, Trödler, Privatpersonen und ihre Flohmärkte und Stände mit Kostproben Crêpes, Brassadeaux, Schnellimbiss"
    ],
    "en": [
      "Around the village square, in a friendly atmosphere, second-hand goods dealers, private individuals and their garage sales, and stands offering crepes, brassadeaux, fast food, etc., all make their presence felt"
    ],
    "it": [
      "Intorno alla piazza del paese, in un'atmosfera amichevole, si trovano commercianti di oggetti usati, privati e le loro vendite in garage, oltre a bancarelle di crepes, brassadeaux e fast food"
    ],
    "fr": [
      "Autour de la place du village, dans une ambiance conviviale, des brocanteurs, des particuliers et leur vide grenier et des stands de dégustation crêpes, brassadeaux, restauration rapide"
    ],
    "nl": [
      "Rond het dorpsplein, in een gezellige sfeer, vind je handelaars in tweedehands spullen, particulieren en hun garageverkoop, maar ook kraampjes met crêpes, brassadeaux en fastfood"
    ],
    "es": [
      "Alrededor de la plaza del pueblo, en un ambiente agradable, encontrará vendedores de artículos de segunda mano, particulares y sus ventas de garaje, así como puestos de crepes, brassadeaux y comida rápida"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Foire des brassadeaux - vide grenier"
    ]
  },
