  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf Gerichte aus lokalen, frischen, saisonalen und qualitativ hochwertigen Produkten? dann ist \"Au Soldat laboureur\", ein Restaurant in Eps nahe St Pol-sur-Ternoise, Arras und Béthune im Pas de Calais (62), genau das Richtige für Sie!"
    ],
    "en": [
      "Would you like to eat dishes made with local, fresh, seasonal, quality produce? \"Au Soldat Laboureur\", a restaurant in Eps near St Pol-sur-Ternoise, Arras and Béthune in Pas de Calais (62) is the restaurant for you!"
    ],
    "it": [
      "Avete voglia di un pasto a base di prodotti locali, freschi, stagionali e di qualità? \"Au Soldat Laboureur\", un ristorante a Eps vicino a St Pol-sur-Ternoise, Arras e Béthune nel Pas de Calais (62) è il ristorante che fa per voi!"
    ],
    "fr": [
      "Une envie de manger des plats à base de produits locaux, frais de saison et de qualité ? « Au Soldat laboureur », restaurant à Eps près de St Pol-sur-Ternoise, Arras et Béthune dans le Pas de Calais (62) est le restaurant qu’il vous faut !"
    ],
    "es": [
      "¿Le apetece una comida a base de productos locales, frescos, de temporada y de calidad? \"Au Soldat Laboureur\", un restaurante situado en Eps, cerca de St Pol-sur-Ternoise, Arras y Béthune, en el Paso de Calais (62), ¡es su restaurante!"
    ],
    "nl": [
      "Zin in een maaltijd op basis van lokale, verse, seizoensgebonden kwaliteitsproducten? \"Au Soldat Laboureur\", een restaurant in Eps in de buurt van St Pol-sur-Ternoise, Arras en Béthune in Pas de Calais (62) is het restaurant voor jou!"
    ]
  },
