  "rdfs:comment": {
    "de": [
      "Restaurant im Zentrum des Dorfes. Genießen Sie die traditionelle Küche.\r\nSpezialitäten: frische Frösche, Bresse-Hähnchen mit Etrez-Creme, Schnecken aus Burgund."
    ],
    "en": [
      "Restaurant in the center of the village, enjoy traditional cuisine.\r\nSpecialities: fresh frogs, Bresse chicken with Etrez cream, Burgundy snails."
    ],
    "it": [
      "Ristorante nel centro del paese, con cucina tradizionale.\r\nSpecialità: rane fresche, pollo di Bresse con crema di Etrez, lumache di Borgogna."
    ],
    "fr": [
      "Restaurant au centre du village, dégustez la cuisine traditionnelle. \r\nSpécialités : grenouilles fraîches, Poulet de Bresse à la crème d'Etrez, les escargots de Bourgognes."
    ],
    "es": [
      "Restaurante en el centro del pueblo, que sirve cocina tradicional.\r\nEspecialidades: ranas frescas, pollo de Bresse con crema de Etrez, caracoles de Borgoña."
    ],
    "nl": [
      "Restaurant in het centrum van het dorp, proef de Bresse keuken. Specialiteiten: verse kikkerbilletjes, Bressense kip."
    ]
  },
