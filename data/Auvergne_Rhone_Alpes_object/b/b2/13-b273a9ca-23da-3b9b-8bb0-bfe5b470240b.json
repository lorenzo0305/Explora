  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere schönsten Wanderwege mit einem Mountainbike mit elektrischer Unterstützung, allein oder mit einem geführten Fahrradführer!\r\nCycl'O Lac landet in Yenne mit einem Geschäft, das zu 100% dem Fahrrad gewidmet ist"
    ],
    "en": [
      "Discover our most beautiful trails on an electrically-assisted mountain bike, either on your own or with an instructor-guide! NEW FOR SUMMER 2025! Cycl'O Lac arrives in Yenne with a shop 100% dedicated to the world of cycling"
    ],
    "it": [
      "Scoprite i nostri sentieri più belli su una mountain bike a pedalata assistita, da soli o con un istruttore-guida!\r\nCycl'O Lac arriva a Yenne con un negozio dedicato al 100% al mondo della bici"
    ],
    "fr": [
      "Partez à la découverte de nos plus beaux sentier en VTT à assistance électrique seul ou avec un moniteur guide !\r\nCycl'O Lac débarque à Yenne avec une boutique 100% dédiée à l’univers du vélo"
    ],
    "nl": [
      "Ontdek onze mooiste routes op een elektrisch ondersteunde mountainbike, alleen of met een begeleider!\r\nCycl'O Lac arriveert in Yenne met een winkel die 100% gewijd is aan de wereld van fietsen"
    ],
    "es": [
      "Descubra nuestros senderos más bellos en bicicleta de montaña con asistencia eléctrica, solo o con un monitor-guía\r\nCycl'O Lac llega a Yenne con una tienda 100% dedicada al mundo del ciclismo"
    ]
  },
