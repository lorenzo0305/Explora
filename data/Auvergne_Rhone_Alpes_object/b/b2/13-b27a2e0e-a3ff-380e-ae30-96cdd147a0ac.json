  "rdfs:comment": {
    "de": [
      "In einem gemütlichen Rahmen bietet Ihnen der Chefkoch leckere und herzhafte Gerichte, wie man sie liebt! Zarte Aromen, die den Gaumen erfreuen!"
    ],
    "en": [
      "In a warm and welcoming setting, the chef offers gourmet and hearty dishes just the way we like them! Delicate flavors to please the taste buds!"
    ],
    "it": [
      "In un ambiente caldo e accogliente, lo chef propone piatti gourmet e sostanziosi proprio come piacciono a noi! Sapori delicati per soddisfare le papille gustative!"
    ],
    "fr": [
      "Dans un cadre chaleureux le chef vous propose des plats gourmands et copieux comme on les aimes ! Des saveurs délicates qui font plaisir aux papilles !"
    ],
    "nl": [
      "In een warme en gastvrije omgeving biedt de chef gastronomische en hartige gerechten zoals wij ze graag hebben! Delicate smaken om de smaakpapillen te plezieren!"
    ],
    "es": [
      "En un ambiente cálido y acogedor, el chef propone platos gastronómicos y contundentes como a nosotros nos gustan Sabores delicados para deleitar el paladar"
    ]
  },
