  "rdfs:comment": {
    "de": [
      "Die interkommunale Mediathek la Passerelle liegt an einem privilegierten Ort am Ufer der Saône und empfängt Sie auf drei Ebenen. Das Team der Mediathek bietet Ihnen ein reichhaltiges und vielfältiges Angebot an Dokumenten."
    ],
    "en": [
      "On the banks of the Saône, in a privileged location, La Passerelle intercommunal multimedia library welcomes you on three levels. The media library team offers a rich and varied range of documents."
    ],
    "it": [
      "Sulle rive della Saona, in un luogo privilegiato, la mediateca intercomunale La Passerelle vi accoglie su tre livelli. L'équipe della mediateca offre una gamma ricca e variegata di documenti."
    ],
    "fr": [
      "Aux bords de la Saône, sur un site privilégié, La Médiathèque intercommunale la Passerelle vous accueille sur trois niveaux. L’équipe de la médiathèque vous propose une offre documentaire riche et variée."
    ],
    "nl": [
      "Aan de oevers van de Saône, op een bevoorrechte locatie, verwelkomt de intercommunale mediatheek La Passerelle u op drie niveaus. Het mediatheekteam biedt een rijk en gevarieerd aanbod aan documenten."
    ],
    "es": [
      "A orillas del Saona, en un emplazamiento privilegiado, la mediateca intercomunal La Passerelle le da la bienvenida en tres niveles. El equipo de la mediateca ofrece una rica y variada gama de documentos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Médiathèque intercommunale La Passerelle"
    ]
  },
