  "rdfs:comment": {
    "de": [
      "Entdecken Sie den Komplex \"Le Stelsia Megève\". Casino (Spielautomaten der neuesten Generation, elektronisches Roulette, traditionelle Spiele), Raum für traditionelle VIP-Spiele, stimmungsvolle Café-Bar \"Le Gallery Bar\", Ausstellungen, Veranstaltungen, Nachtclub \"Le Rendez-vous\"."
    ],
    "en": [
      "Discover the complex \"Le Stelsia Megève\". Casino (slot machines new generation, electronic roulette, traditional games), lounge bar \"Gallery Bar\", artistic exhibitions, events, nightclub \"Le Rendez-vous\"."
    ],
    "it": [
      "Scoprite il nuovissimo complesso \"Le Stelsia Megève\". Casinò (slot machine di ultima generazione, roulette elettronica, giochi tradizionali), Café Bar suggestivo \"Le Gallery Bar\", mostre, eventi, Nightclub \"Le Rendez-vous\"."
    ],
    "fr": [
      "Découvrez le complexe \"Le Stelsia Megève\". Casino (machines à sous dernière génération, roulette électronique, jeux traditionnels), salle de jeux traditionnels VIP, café-bar d'ambiance \"Le Gallery Bar\", expositions, évènements, nightclub \"Le Rendez-vous\"."
    ],
    "nl": [
      "Ontdek het complex \"Le Stelsia Megève\". Casino (gokkasten van de nieuwste generatie, elektronische roulette, traditionele spellen), traditionele VIP-spellenkamer, sfeervolle café-bar \"Le Gallery Bar\", tentoonstellingen, evenementen, nachtclub \"Le Rendez-vous\"."
    ],
    "es": [
      "Descubra el complejo \"Le Stelsia Megève\". Casino (máquinas tragaperras de última generación, ruleta electrónica, juegos tradicionales), sala de juegos VIP tradicional, café-bar atmosférico \"Le Gallery Bar\", exposiciones, eventos, discoteca \"Le Rendez-vous\"."
    ]
  },
