  "rdfs:comment": {
    "de": [
      "Dorf Barges: Kirche aus dem 19. Jahrhundert mit einem Glockenturm, der mit mehrfarbigen glasierten Dachziegeln bedeckt ist. Steinkreuz im Dorf mit Heilungslegende."
    ],
    "en": [
      "Village of Barges: 19th-century church with bell tower covered in polychrome glazed tiles. Stone cross in the village with healing legend."
    ],
    "it": [
      "Villaggio di Barges: chiesa del XIX secolo con campanile rivestito di piastrelle smaltate policrome. Croce di pietra nel villaggio con leggenda di guarigione."
    ],
    "fr": [
      "Village de Barges : Église du XIXe siècle avec clocher recouvert de tuiles vernissées polychromes. Croix en pierre dans le village avec légende de guérison."
    ],
    "es": [
      "Pueblo de Barges: iglesia del siglo XIX con campanario cubierto de azulejos policromados. Cruz de piedra en el pueblo con leyenda curativa."
    ],
    "nl": [
      "Dorp Barges: 19e-eeuwse kerk met klokkentoren bedekt met polychrome geglazuurde tegels. Stenen kruis in het dorp met genezingslegende."
    ]
  },
