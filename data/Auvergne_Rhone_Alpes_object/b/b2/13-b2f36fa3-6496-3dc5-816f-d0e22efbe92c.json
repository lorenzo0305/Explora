  "rdfs:comment": {
    "de": [
      "Traditionelle Küche, savoyische Spezialitäten. Nehmen Sie an den Themenabenden teil: donnerstags Froschschenkelabend, freitags Barschfilet, samstags: Couscous im Winter und Paella im Sommer."
    ],
    "en": [
      "Traditionnal cusine, savoyard specialities. Enjoy our theme evenings : Thursday evening frogs legs, Friday filets of perch, Saturday marrocan couscous in winter, and paella."
    ],
    "it": [
      "Cucina tradizionale, specialità savoiarde. Partecipate alle serate a tema: giovedì serata di cosce di rana, venerdì filetti di pesce persico, sabato: couscous in inverno e paella in estate."
    ],
    "fr": [
      "Cuisine traditionnelle, spécialités savoyardes. Participez aux soirées à thème : le jeudi soirée cuisses de grenouilles, vendredi filets de perches, samedi : couscous l’hiver et paella l’été."
    ],
    "nl": [
      "Traditionele keuken, Savoyaardse specialiteiten. Neem deel aan de thema-avonden: donderdag kikkerbilletjesavond, vrijdag baarsfilets, zaterdag: couscous in de winter en paella in de zomer."
    ],
    "es": [
      "Cocina tradicional, especialidades saboyanas. Participe en las veladas temáticas: el jueves, velada de ancas de rana; el viernes, filetes de perca; el sábado, cuscús en invierno y paella en verano."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le Kar'Pat'Ciao"
    ],
    "fr": [
      "Le Kar'Pat'Ciao"
    ]
  },
