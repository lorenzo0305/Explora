  "rdfs:comment": {
    "de": [
      "Zwischen zwei Skisitzungen oder nach einem Tag im Paradiski ist es Zeit, sich zu stärken! Sie werden die freundliche und familiäre Atmosphäre im Chalet, einer Brasserie mit Panoramablick, lieben!"
    ],
    "en": [
      "Between two runs on the ski slopes or a day out in the Paradiski area, you will need to recharge your batteries! You will love the convivial, family-friendly atmosphere in Le Chalet, a brasserie with a panoramic view!"
    ],
    "it": [
      "Tra due sessioni di sci o dopo una giornata al Paradiski, è il momento di ricaricare le batterie! Vi piacerà l'atmosfera amichevole e familiare di Le Chalet, una brasserie con vista panoramica!"
    ],
    "fr": [
      "Entre deux sessions de ski ou après une journée au Paradiski, il est temps de reprendre des forces ! Vous aimerez l’ambiance conviviale et familiale du Chalet, brasserie à la vue panoramique !"
    ],
    "nl": [
      "Tussen twee skisessies door of na een dag in Paradiski is het tijd om nieuwe energie op te doen! U zult genieten van de gezellige, familiale\r\nsfeer van Le Chalet, een brasserie met panoramisch uitzicht!"
    ],
    "es": [
      "Entre dos sesiones de esquí o después de un día en Paradiski, ¡es hora de reponer fuerzas! Le Chalet, una brasserie con vistas panorámicas, ofrece un ambiente familiar y acogedor"
    ]
  },
