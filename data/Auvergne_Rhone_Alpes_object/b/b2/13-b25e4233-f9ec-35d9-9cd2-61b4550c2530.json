  "rdfs:comment": {
    "de": [
      "Das nur in der Wintersaison geöffnete Restaurant, das Selbstbedienungsrestaurant, die Bar und die Snackbar heißen Sie während eines Tages auf der Piste willkommen. Hunde an der Leine sind nur auf der Terrasse erlaubt."
    ],
    "en": [
      "Open only during the winter season, the restaurant, self-service, bar and snack bar welcome you for a day on the slopes. Dogs on leashes are only permitted on the terrace."
    ],
    "it": [
      "Aperti solo durante la stagione invernale, il ristorante, il ristorante self-service, il bar e lo snack bar vi accolgono per tutta la durata del vostro soggiorno sulle piste. I cani al guinzaglio sono ammessi solo sulla terrazza."
    ],
    "fr": [
      "Ouvert uniquement en saison d'hiver, le restaurant, le self-service, le bar et le snack vous accueillent tout au long de votre sur les pistes. Les chiens en laisse sont acceptés uniquement sur la terrasse."
    ],
    "nl": [
      "Het restaurant, het zelfbedieningsrestaurant, de bar en de snackbar zijn alleen tijdens het winterseizoen geopend en verwelkomen je tijdens je verblijf op de pistes. Aangelijnde honden zijn alleen toegestaan op het terras."
    ],
    "es": [
      "Abiertos sólo durante la temporada de invierno, el restaurante, el autoservicio, el bar y el snack bar le dan la bienvenida durante toda su estancia en las pistas. Sólo se admiten perros con correa en la terraza."
    ]
  },
