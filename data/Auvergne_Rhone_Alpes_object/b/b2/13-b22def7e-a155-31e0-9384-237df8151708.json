  "rdfs:comment": {
    "de": [
      "Restauriert mit großem Know-how alte Sitzmöbel und entwirft zeitgemäßere Stücke, bei denen edle Materialien wie Leder verarbeitet werden.\r\nEinführungskurse und Fortgeschrittenenkurse, siehe Programmdetails."
    ],
    "en": [
      "Highly skilled restoration of antique chairs and design of more contemporary pieces using noble materials such as leather.\r\nIntroductory and advanced courses, see program details."
    ],
    "it": [
      "Restauro, con grande competenza, di sedie antiche e progettazione di pezzi più contemporanei combinando materiali nobili come la pelle.\r\nCorsi introduttivi e avanzati, vedi programma dettagliato."
    ],
    "fr": [
      "Restauration, avec un grand savoir-faire, de sièges anciens et conception de pièces plus contemporaines associant des matérieux nobles comme le cuir.\r\nStages d'initiation et perfectionnement, voir détail programme."
    ],
    "nl": [
      "Restauratie, met grote expertise, van antieke stoelen en ontwerp van meer eigentijdse stukken waarbij edele materialen zoals leer worden gecombineerd.\r\nInleidende en gevorderde cursussen, zie gedetailleerd programma."
    ],
    "es": [
      "Restauración, con gran maestría, de sillas antiguas y diseño de piezas más contemporáneas combinando materiales nobles como el cuero.\r\nCursos de iniciación y perfeccionamiento, ver programa detallado."
    ]
  },
