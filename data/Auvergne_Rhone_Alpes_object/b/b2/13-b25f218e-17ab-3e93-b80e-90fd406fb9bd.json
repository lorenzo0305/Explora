  "rdfs:comment": {
    "de": [
      "Gruppen- und Einzelworkshop zur Entwicklung der eigenen kreativen und künstlerischen Fähigkeiten durch Loslassen mithilfe von Medien der bildenden Kunst (Modellieren von Ton, Malen, Zeichnen, Pflanzen). Eine Zeit der Kreativität und Entspannung für sich selbst."
    ],
    "en": [
      "Group and individual workshop to develop creative and artistic skills through letting go, using plastic arts media (clay modeling, painting, drawing, plants). A time for creativity and relaxation."
    ],
    "it": [
      "Un laboratorio di gruppo e individuale per sviluppare le proprie capacità creative e artistiche lasciandosi andare con i mezzi delle arti plastiche (modellazione dell'argilla, pittura, disegno, piante). Un momento di creatività e relax."
    ],
    "fr": [
      "Atelier collectif et individuel pour développer ses capacités créatives et artistiques par le lâcher-prise en utilisant les supports arts plastiques (modelage de la terre, peinture, dessin, végétaux). Un temps de créativité et de détente pour soi."
    ],
    "es": [
      "Un taller en grupo e individual para desarrollar tus capacidades creativas y artísticas dejándote llevar por los medios de las artes plásticas (modelado en arcilla, pintura, dibujo, plantas). Un momento de creatividad y relajación."
    ],
    "nl": [
      "Een groeps- en individuele workshop om je creatieve en artistieke vaardigheden te ontwikkelen door los te laten met behulp van beeldende kunst (boetseren met klei, schilderen, tekenen, planten). Een tijd voor creativiteit en ontspanning."
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Étincelle Kréac'tive - Ateliers de Bien-être Créatif : Sculpture, Peinture, Dessin, Land'art"
    ]
  },
