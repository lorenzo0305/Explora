  "rdfs:comment": {
    "de": [
      "\"Messen Sie Ihre Gelüste\" in S M L und XL. Entdecken Sie unsere Speisen und Getränke in allen Größen zu jeder Stunde und zu jedem Preis."
    ],
    "en": [
      "“Size up” your appetite: S M L or XL. Discover a range of meals and dishes to suit all sizes and pockets, at all times of day."
    ],
    "it": [
      "«Misura il tuo appetito»: S, M, L, o XL? Scopri i nostri piatti e le nostre bevande di diversi formati, a tutte le ore e con un'ampia gamma di prezzi."
    ],
    "fr": [
      "« Mesurez vos envies » en S M L et XL. Découvrez nos mets et boissons à toutes les tailles, toutes les heures et tous les prix."
    ],
    "nl": [
      "\"Meet uw wensen\" in S M L en XL. Ontdek ons eten en drinken in alle maten, tijden en prijzen."
    ],
    "es": [
