  "rdfs:comment": {
    "de": [
      "Bar im Herzen des Dorfes Peisey.\r\nKostenloses WLAN, Billard.\r\nIm Winter: Bier, Cocktails, Bar mit Live-Musik, Billard – Pizza zum Mitnehmen von 18:30 bis 21:30 Uhr.\r\nIm Sommer: Geöffnet auf der Terrasse – Bar, Eis und süße Crêpes"
    ],
    "en": [
      "Bar located in the heart of the village of Peisey.\r\nFree Wi-Fi access, billiards.\r\nIn winter: Beers, cocktails, bar with live music, billiards - Takeaway pizzas from 6:30 p.m. to 9:30 p.m.\r\nIn summer: Open on the terrace - Bar, ice creams and sweet crêpes"
    ],
    "it": [
      "Bar situato nel cuore del villaggio di Peisey.\r\nAccesso WIFI gratuito, tavolo da biliardo, calcio balilla, freccette, ...\r\nBirre, cocktail, bar con atmosfera musicale\r\nPizze da asporto dalle 18.30 alle 21.30\r\nIn estate: aperto sulla terrazza dalle 15.30 alle 19.00 - Bar, Coupes Glacées"
    ],
    "fr": [
      "Bar situé au cœur du village de Peisey.\r\nAccès WIFI gratuit, billard, babyfoot, fléchettes, ...\r\nBières, Cocktails, Bar à ambiance musicale -\r\nPizzas à emporter de 18h30 à 21h30\r\nEn été :  Ouvert en terrasse de 15h30 à19h - Bar, Coupes Glacées"
    ],
    "es": [
      "Bar situado en el corazón del pueblo de Peisey.\r\nAcceso WIFI gratuito, mesa de billar, futbolín, dardos, ...\r\nCervezas, Cócteles, Bar con ambiente musical -\r\nPizzas para llevar de 18h30 a 21h30\r\nEn verano: Abierto en la terraza de 15h30 a 19h00 - Bar, Coupes Glacées"
    ],
    "nl": [
      "Bar gelegen in het hart van het dorp Peisey.\r\nGratis WIFI, biljart, tafelvoetbal, darts, ...\r\nBieren, cocktails, bar met muzikale omlijsting - Pizza's om mee te nemen van 18.30 tot 21.30 uur\r\nPizza's om mee te nemen van 18.30 tot 21.30 uur\r\nIn de zomer: Open op het terras van 15u30 tot 19u - Bar, Coupes Glacées"
    ]
  },
