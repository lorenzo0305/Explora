  "rdfs:comment": {
    "de": [
      "Schnitzeljagd zur Entdeckung des Kulturerbes und 4 km lange Wanderung. Auf den Spuren von Inspektor Rando müssen die Kinder ein altersgerechtes Rätsel lösen."
    ],
    "en": [
      "Heritage treasure hunt and 4km walk. Following in the footsteps of Inspector Rando, children will have to solve an age-appropriate riddle."
    ],
    "it": [
      "Una caccia al tesoro del patrimonio e una passeggiata di 4 km. Seguendo le orme dell'ispettore Rando, i bambini dovranno risolvere un indovinello adatto alla loro età."
    ],
    "fr": [
      "Jeu de piste à la découverte du patrimoine et balade de 4km. Sur les traces de l'inspecteur Rando, les enfants devront résoudre une énigme adaptée à leur âge."
    ],
    "es": [
      "Una búsqueda del tesoro patrimonial y un paseo de 4 km. Siguiendo los pasos del Inspector Rando, los niños tendrán que resolver un acertijo apropiado para su edad."
    ],
    "nl": [
      "Een erfgoedschattenjacht en een wandeling van 4 km. In de voetsporen van inspecteur Rando moeten kinderen een raadsel oplossen dat past bij hun leeftijd."
    ]
  },
