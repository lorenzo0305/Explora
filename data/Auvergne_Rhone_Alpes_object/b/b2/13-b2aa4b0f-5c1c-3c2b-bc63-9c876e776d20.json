  "rdfs:comment": {
    "de": [
      "Genießen Sie in diesem Restaurant mit der Atmosphäre eines traditionellen Chalets die köstlichen Fondue-, Tartiflette- und Raclette-Rezepte, für die unsere Region so berühmt ist. Private Shuttlebusse stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Enjoy the tasty fondues, tartiflettes and raclettes for which our region is famous in this restaurant with its traditional chalet atmosphere. Private shuttles available."
    ],
    "it": [
      "Gustate le gustose fondute, tartiflettes e raclettes per cui la nostra regione è famosa in questo ristorante dall'atmosfera tradizionale da chalet. Servizio navetta privato disponibile."
    ],
    "fr": [
      "Dégustez les savoureuses recettes de fondues, tartiflettes et raclettes qui font la renommée de notre région dans ce restaurant à l’ambiance d'un chalet traditionnel. Navettes privées à votre disposition."
    ],
    "nl": [
      "Geniet in dit restaurant met zijn traditionele chaletsfeer van de smakelijke fondues, tartiflettes en raclettes waar onze streek beroemd om is. Privé shuttle service beschikbaar."
    ],
    "es": [
      "Disfrute de las sabrosas fondues, tartiflettes y raclettes por las que es famosa nuestra región en este restaurante con ambiente de chalet tradicional. Servicio de transporte privado disponible."
    ]
  },
