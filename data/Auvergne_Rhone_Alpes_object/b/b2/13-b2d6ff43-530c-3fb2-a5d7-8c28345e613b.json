  "rdfs:comment": {
    "de": [
      "Das Spa des Hotels Ermitage lädt Sie ein, seine reinigenden und mineralisierenden Behandlungen zu entdecken. Eine natürliche Erfahrung für eine lange Reise, bei der der Körper belebt und entgiftet zurückkehrt."
    ],
    "en": [
      "The Spa of the Ermitage Hotel invites you to discover its paths of purifying and mineralizing treatments. A natural experience for a long journey whose body comes back invigorated and detoxified."
    ],
    "it": [
      "La Spa dell'Hôtel Ermitage vi invita a scoprire la sua gamma di trattamenti purificanti e mineralizzanti. Un'esperienza naturale per un lungo viaggio da cui il corpo torna rinvigorito e disintossicato."
    ],
    "fr": [
      "Le Spa de l'Hôtel Ermitage vous invite à découvrir ses parcours de soins purifiants et minéralisants. Une expérience naturelle pour un long voyage dont le corps revient vivifié et détoxifié."
    ],
    "es": [
      "El Spa del Hôtel Ermitage le invita a descubrir su gama de tratamientos purificantes y mineralizantes. Una experiencia natural para un largo viaje del que el cuerpo regresa tonificado y desintoxicado."
    ],
    "nl": [
      "De Spa van Hôtel Ermitage nodigt je uit om de reeks zuiverende en mineraliserende behandelingen te ontdekken. Een natuurlijke ervaring voor een lange reis waarvan het lichaam verkwikt en ontgift terugkeert."
    ]
  },
