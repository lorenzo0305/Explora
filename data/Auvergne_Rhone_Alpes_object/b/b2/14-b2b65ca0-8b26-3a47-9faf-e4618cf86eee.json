      "dc:description": {
        "de": [
          "Das Office de Tourisme Haut Pays Côte d'Opale präsentiert :\nLes Avesnes, eine 28,8 km lange Mountainbike-Tour.\nDauer: 3 Stunden 15 Minuten | Start: Fruges"
        ],
        "en": [
          "The Haut Pays Côte d'Opale Tourist Office presents :\nLes Avesnes, a 28.8km mountain bike trail.\nDuration : 3h15 | Departure : From Fruges"
        ],
        "it": [
          "L'Ufficio del turismo dell'Haut Pays Côte d'Opale presenta :\nLes Avesnes, un percorso di 28,8 km in mountain bike.\nDurata: 3h15 | Partenza: da Fruges"
        ],
        "fr": [
          "L'Office de Tourisme Haut Pays Côte d'Opale présente :\nLes Avesnes,  une randonnée à faire en VTT de 28,8km.\nDurée : De 3h15 | Départ : De Fruges"
        ],
        "es": [
          "La Oficina de Turismo de Haut Pays Côte d'Opale presenta :\nLes Avesnes, un recorrido de 28,8 km en bicicleta de montaña.\nDuración: 3h15 | Salida: Desde Fruges"
        ],
        "nl": [
          "Het VVV-kantoor van Haut Pays Côte d'Opale presenteert :\nLes Avesnes, een mountainbiketocht van 28,8 km.\nDuur: 3u15 | Start: Vanuit Fruges"
        ]
