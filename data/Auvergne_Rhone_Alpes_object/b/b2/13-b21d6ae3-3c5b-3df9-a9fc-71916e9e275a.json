  "rdfs:comment": {
    "de": [
      "Schließfächer mit Selbstbedienung rund um die Uhr mit frischen und lokalen Produkten. Sie finden dort Eier, Mehl, Milch, Fleisch, Fisch, Obst, Gemüse, Getränke, Eis... werden jede Woche von den Produzenten aus der Umgebung angeliefert."
    ],
    "en": [
      "Self-service racks 24/24h with fresh and local products, you will find eggs, flours, milks, meats, fish, fruits, vegetables, drinks, ice creams... are deposited each week by the local producers."
    ],
    "it": [
      "Casse self-service 24 ore su 24 con prodotti freschi e locali, tra cui uova, farina, latte, carne, pesce, frutta, verdura, bevande, gelati, ecc. portati ogni settimana dai produttori locali."
    ],
    "fr": [
      "Casiers en libre service 24/24h avec des produits frais et locaux, vous y trouverez des œufs, farines, laits, viandes, poissons, fruits, légumes, boissons, glaces... sont chaque semaine déposés par les producteurs du coin."
    ],
    "es": [
      "Cajas de autoservicio las 24 horas del día con productos locales frescos, como huevos, harina, leche, carne, pescado, fruta, verdura, bebidas, helados, etc., traídos cada semana por productores locales."
    ],
    "nl": [
      "24 uur per dag zelfbedieningskratten met verse, lokale producten, waaronder eieren, meel, melk, vlees, vis, fruit, groenten, drankjes en ijs, allemaal wekelijks aangevoerd door lokale producenten."
    ]
  },
