  "rdfs:comment": {
    "de": [
      "Im Herzen des Dorfes empfangen Sie Philippe und sein Team zu einem gemütlichen und herzlichen Essen. In diesem Restaurant mit rustikalem Bergdekor können Sie Fondues, Tartiflettes, Raclettes, Pierrades und Spezialitäten aus der Region genießen."
    ],
    "en": [
      "Restaurant with a rustic and mountain decor where you can enjoy fondues, tartiflettes, raclettes, pierrades and local specialities in a warm atmosphere.\r\nLocated in the heart of the village, Philippe and his team welcome you for a convivial meal."
    ],
    "it": [
      "Nel cuore del villaggio, Philippe e il suo team vi accolgono per un pasto amichevole e caloroso. In questo ristorante dall'arredamento rustico e montano, potrete gustare fondute, tartiflettes, raclettes, pierrades e specialità locali."
    ],
    "fr": [
      "Au cœur du village, Philippe et son équipe vous accueille pour un repas convivial et chalereux. Dans ce restaurant au décor rustique et montagnard, vous pourrez déguster des fondues, tartiflettes, raclettes, pierrades et des spécialités du terroir."
    ],
    "nl": [
      "In het hart van het dorp ontvangen Philippe en zijn team u voor een gezellige en warme maaltijd. In dit restaurant met zijn rustieke en bergachtige inrichting kunt u genieten van fondues, tartiflettes, raclettes, pierrades en lokale specialiteiten."
    ],
    "es": [
      "En el corazón del pueblo, Philippe y su equipo le dan la bienvenida para una comida amistosa y cálida. En este restaurante de decoración rústica y montañesa, podrá degustar fondues, tartiflettes, raclettes, pierrades y especialidades locales."
    ]
  },
