  "rdfs:comment": {
    "de": [
      "Als Vorpremiere des Festivals...\r\nWir freuen uns, Ihnen ein außergewöhnliches Konzert anbieten zu können, eine fabelhafte Begegnung zwischen Ablaye Cissoko, dem internationalen Griot und Meister der Kora, und dem französischen Star des diatonischen Akkordeons, Cyrille Brotto."
    ],
    "en": [
      "Festival preview...\r\nWe are delighted to present an exceptional concert, a fabulous encounter between Ablaye Cissoko, international griot and master of the kora, and French diatonic accordion star Cyrille Brotto."
    ],
    "it": [
      "Anteprima del festival...\r\nSiamo lieti di presentarvi un concerto eccezionale, un favoloso incontro tra Ablaye Cissoko, griot internazionale e maestro della kora, e la star francese della fisarmonica diatonica, Cyrille Brotto."
    ],
    "fr": [
      "En avant première du festival... \r\nNous avons le plaisir de vous proposer un concert exceptionnel, une fabuleuse rencontre entre Ablaye Cissoko, griot international et maître de la kora, et de la star française de l’accordéon diatonique, Cyrille Brotto."
    ],
    "es": [
      "Preestreno del festival...\r\nNos complace presentarles un concierto excepcional, un fabuloso encuentro entre Ablaye Cissoko, griot internacional y maestro de la kora, y la estrella francesa del acordeón diatónico, Cyrille Brotto."
    ],
    "nl": [
      "Festival preview...\r\nWe zijn verheugd u een uitzonderlijk concert te kunnen brengen, een fabelachtige ontmoeting tussen Ablaye Cissoko, internationaal griot en meester van de kora, en de Franse ster van de diatonische accordeon, Cyrille Brotto."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ablaye CISSOKO & Cyrille BROTTO"
    ]
  },
