  "rdfs:comment": {
    "de": [
      "Das Phänomen Yann Muller kommt für ein völlig neues Konzert auf die Pferderennbahn von MOULINS!\r\nEin außergewöhnlicher Abend.\r\nEin Minifestival.\r\nEine aufgeladene Atmosphäre."
    ],
    "en": [
      "The phenomenon Yann Muller arrives at the MOULINS racecourse for a never-before-seen concert!\r\nAn extraordinary evening.\r\nA mini festival.\r\nA supercharged atmosphere."
    ],
    "it": [
      "Il fenomeno Yann Muller arriva all'ippodromo dei MOULINS per un concerto senza precedenti!\r\nUna serata straordinaria.\r\nUn mini festival.\r\nUn'atmosfera super carica."
    ],
    "fr": [
      "Le phénomène Yann Muller débarque à l’hippodrome de MOULINS pour un concert inédit !\r\nUne soirée hors norme.\r\nUn mini festival.\r\nUne ambiance survoltée."
    ],
    "nl": [
      "Het fenomeen Yann Muller komt naar de MOULINS renbaan voor een ongekend concert!\r\nEen buitengewone avond.\r\nEen minifestival.\r\nEen supergeladen sfeer."
    ],
    "es": [
      "El fenómeno Yann Muller llega al hipódromo de MOULINS para un concierto sin precedentes\r\nUna velada extraordinaria.\r\nUn mini festival.\r\nUn ambiente sobrecargado."
    ]
  },
