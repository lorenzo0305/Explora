  "rdfs:comment": {
    "de": [
      "Pfarrei der ehemaligen Diözese Nevers, die im 7. Jahrhundert vom Heiligen Ennemond, dem Erzbischof von Lyon, gegründet wurde (dessen Statue rechts im Chor und Reliquien über der Tür zur Sakristei zu sehen sind)."
    ],
    "en": [
      "Parish of the former diocese of Nevers founded in the 7th century by Saint Ennemond, archbishop of Lyon (whose statue can be seen to the right of the choir and the relics above the sacristy door)."
    ],
    "it": [
      "Parrocchia dell'antica diocesi di Nevers fondata nel VII secolo da Sant'Ennemondo, arcivescovo di Lione (la cui statua è visibile a destra del coro e le cui reliquie si trovano sopra la porta della sacrestia)."
    ],
    "fr": [
      "Paroisse de l'ancien diocèse de Nevers fondée au VIIème siècle par Saint Ennemond, archevêque de Lyon (dont on voit la statue à la droite du chœur et les reliques au dessus de la porte de la sacristie)."
    ],
    "es": [
      "Parroquia de la antigua diócesis de Nevers fundada en el siglo VII por San Ennemond, arzobispo de Lyon (cuya estatua puede verse a la derecha del coro y cuyas reliquias se encuentran sobre la puerta de la sacristía)."
    ],
    "nl": [
      "Parochie van het voormalige bisdom Nevers, gesticht in de 7e eeuw door de heilige Ennemond, aartsbisschop van Lyon (wiens standbeeld rechts van het koor te zien is en wiens relieken zich boven de deur van de sacristie bevinden)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Laurent"
    ]
  },
