  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant. Savoyardische Spezialitäten. Herzliche und gemütliche Atmosphäre. Sonnenterrasse.\r\nAm Nachmittag bietet Ihnen Le Jalouvre süße und herzhafte Snacks an."
    ],
    "en": [
      "Warm and friendly atomosphere with a sunny terrace.Traditional cuisine and Savoyard specialities.\r\nIn the afternoon, Le Jalouvre offers sweet and savoury snacks."
    ],
    "it": [
      "Specialità savoiarde. Atmosfera accogliente in un ambiente di legno antico. Posizione soleggiata.\r\nNel pomeriggio, Le Jalouvre serve spuntini dolci e salati."
    ],
    "fr": [
      "Spécialités savoyardes. Ambiance chaleureuse dans un cadre de vieux bois. Situation ensoleillée.\r\nDans l’après-midi, Le Jalouvre vous propose des en-cas sucrés et salés."
    ],
    "nl": [
      "Savoyaardse specialiteiten. Gezellige sfeer in oude houten omgeving. Zonnige locatie.\r\nIn de namiddag serveert Le Jalouvre zoete en hartige hapjes."
    ],
    "es": [
      "Especialidades de Saboya. Ambiente acogedor en un entorno de madera antigua. Lugar soleado.\r\nPor la tarde, Le Jalouvre sirve aperitivos dulces y salados."
    ]
  },
