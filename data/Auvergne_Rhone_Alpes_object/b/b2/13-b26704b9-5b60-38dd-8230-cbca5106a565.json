  "rdfs:comment": {
    "de": [
      "Im Herzen des Bauges-Massivs gelegen, empfängt dieses Hotel-Restaurant Ihre Lust auf Entspannung und Entdeckung. Dank seiner zentralen Lage zwischen Aillons-Margériaz 1000 und 1400 haben Sie sowohl im Winter als auch im Sommer leichten Zugang zu Aktivitäten und der Natur."
    ],
    "en": [
      "Located in the heart of the Massif des Bauges, between the departments of Savoie and Haute-Savoie, the Hotel Restaurant du Soleil welcomes your desires for relaxation and discovery, allowing you to discover splendid and exceptional landscapes."
    ],
    "it": [
      "Situato nel cuore del Massiccio dei Bauges, tra i dipartimenti della Savoia e dell'Alta Savoia, l'Hotel Restaurant accoglie il vostro desiderio di relax e di scoperta di un paesaggio splendido ed eccezionale."
    ],
    "fr": [
      "Situé au cœur du massif des Bauges, cet Hôtel Restaurant accueille vos envies de détente et de découverte. Sa position centrale entre les Aillons-Margériaz 1000 et 1400 vous permet un accès facile aux activités et à la nature, en hiver comme en été."
    ],
    "es": [
      "Situado en el corazón del macizo de Bauges, este hotel y restaurante acoge sus ganas de relajarse y descubrir. Su situación central entre Aillons-Margériaz 1000 y 1400 le permite acceder fácilmente a las actividades y a la naturaleza, tanto en invierno como en verano."
    ],
    "nl": [
      "Gelegen in het hart van het Massif des Bauges tussen de departementen Savoie en Haute-Savoie, verwelkomt het Hotel Restaurant uw wens om te ontspannen en het prachtige en uitzonderlijke landschap te ontdekken."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hôtel Restaurant du Soleil"
