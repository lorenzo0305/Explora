  "rdfs:comment": {
    "de": [
      "Laden für lokale Produkte aus der Picardie mit einer sehr umfangreichen Abteilung für Käse vom Bauernhof oder handwerklich hergestellte französische Käse: Gemüsekörbe, Käseplatten, Schlemmerpakete... Kostenpflichtige Verkostung vor Ort auf Vorbestellung möglich."
    ],
    "en": [
      "A shop selling local Picardy products with a large selection of farmhouse or artisanal French cheeses: vegetable baskets, cheese platters, gourmet parcels, etc... Possibility of paid tasting on the spot on reservation."
    ],
    "it": [
      "Acquisti di prodotti locali della Piccardia con una gamma molto ampia di formaggi francesi di fattoria e artigianali: cestini di verdure, taglieri di formaggi, pacchi gourmet, ecc. Possibilità di degustazione a pagamento in loco su prenotazione."
    ],
    "fr": [
      "Magasin de produits locaux picards avec un rayon très étoffé de fromages fermiers ou artisanaux français : paniers de légumes, plateaux de fromages, colis gourmands... Possibilité de dégustation payante sur place sur réservation."
    ],
    "nl": [
      "Winkel voor streekproducten uit Picardië met een zeer uitgebreid assortiment boerenkazen en ambachtelijke Franse kazen: groentemanden, kaasplateaus, gastronomische pakketten, enz. Mogelijkheid tot betaalde proeverij ter plaatse op reservering."
    ],
    "es": [
      "Compre productos locales de Picardía con una gama muy amplia de quesos de granja y artesanales franceses: cestas de verduras, bandejas de queso, paquetes gourmet, etc. Posibilidad de degustación pagada in situ previa reserva."
    ]
  },
