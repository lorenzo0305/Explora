  "rdfs:comment": {
    "de": [
      "Sind wir der Welt fremd? Sind wir den anderen fremd? Auch denen, die wir zu kennen glauben und mit denen wir zusammenleben? Können wir von dem, was uns vermeintlich fremd ist, in unserem Innersten berührt werden?"
    ],
    "en": [
      "Are we strangers to the world? Are we strangers to others? Even those we think we know and live with? Can we be touched at the deepest level by what is supposedly foreign to us?"
    ],
    "it": [
      "Siamo estranei al mondo? Siamo estranei agli altri? Anche quelli che pensiamo di conoscere e con cui viviamo? Possiamo essere toccati nel profondo da ciò che dovrebbe esserci estraneo?"
    ],
    "fr": [
      "Sommes-nous étrangers au monde ? Sommes-nous étrangers aux autres ? Même ceux que nous croyons connaître et avec qui nous vivons ? Pouvons-nous être touchés au plus profond de nous-mêmes par ce qui nous est soi-disant étranger ?"
    ],
    "es": [
      "¿Somos extraños al mundo? ¿Somos extraños para los demás? ¿Incluso para aquellos que creemos conocer y con los que vivimos? ¿Podemos sentirnos tocados en lo más profundo por lo que supuestamente nos es ajeno?"
    ],
    "nl": [
      "Zijn we vreemden voor de wereld? Zijn we vreemden voor anderen? Zelfs degenen die we denken te kennen en met wie we samenleven? Kunnen we op het diepste niveau geraakt worden door wat zogenaamd vreemd voor ons is?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Théâtre : Raz-de-marée et marée basse"
    ]
  },
