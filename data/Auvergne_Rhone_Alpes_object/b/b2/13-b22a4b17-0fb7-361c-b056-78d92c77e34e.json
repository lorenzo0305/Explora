  "rdfs:comment": {
    "de": [
      "Landwirtschaftlicher Bauernhof mit Ackerbau und Gemüseanbau, Verkauf von Gemüse und Obst ab Hof. Wir verkaufen unser Gemüse und Obst sowie andere Produkte aus der Region (Honig, Käse,...) auf dem Bauernhof in einer freundlichen und bäuerlichen Umgebung."
    ],
    "en": [
      "Arable and market-gardening farm, farm-gate sales of vegetables and fruit. We sell our vegetables and fruit at the farm, as well as other local products (honey, cheese, etc.), in a friendly, farm-style setting."
    ],
    "it": [
      "Azienda agricola a seminativo e ortofrutticola, vendita al dettaglio di ortaggi e frutta. Vendiamo in azienda la nostra verdura e la nostra frutta, oltre ad altri prodotti locali (miele, formaggio, ecc.), in un ambiente amichevole e in stile contadino."
    ],
    "fr": [
      "Ferme agricole de grande culture et de maraîchage, vente à la ferme de légumes et fruits. Nous vendons à la ferme nos légumes et nos fruits, ainsi que d'autres produits du territoires (miel, fromages,...), dans un cadre convivial et fermier."
    ],
    "es": [
      "Explotación agrícola y hortícola, venta de verduras y frutas a domicilio. Vendemos nuestras hortalizas y frutas en la granja, así como otros productos locales (miel, queso, etc.), en un ambiente acogedor y de granja."
    ],
    "nl": [
      "Akkerbouw- en groenteteeltbedrijf, boerderijverkoop van groenten en fruit. We verkopen onze groenten en fruit op de boerderij, evenals andere lokale producten (honing, kaas, enz.), in een vriendelijke, boerderijachtige omgeving."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme de Marquet"
    ]
  },
