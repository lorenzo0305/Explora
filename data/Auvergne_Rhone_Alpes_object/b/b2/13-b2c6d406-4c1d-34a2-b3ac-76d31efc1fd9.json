  "rdfs:comment": {
    "de": [
      "Das Bel'Vue*** ist ein charmantes Hotel mit einem herrlichen Panoramablick auf das Tal. es stehen Ihnen 15 komfortable und helle Zimmer zur Verfügung. Genießen Sie auch das Restaurant in der Unterkunft."
    ],
    "en": [
      "Panoramic room upon the hills of High Beaujolais. Closed garage. Summer terrace."
    ],
    "it": [
      "Il Bel'Vue*** è un hotel di charme con una splendida vista panoramica sulla valle. dispone di 15 camere luminose e confortevoli. È inoltre possibile usufruire del ristorante in loco."
    ],
    "fr": [
      "Le Bel'Vue*** est un hôtel de charme avec une superbe vue panoramique sur la vallée. 15 chambres confortables et lumineuses vous sont proposées. Profitez également du restaurant au sein de l'établissement."
    ],
    "nl": [
      "Het Bel'Vue*** is een charmant hotel met een prachtig panoramisch uitzicht over de vallei. je kunt kiezen uit 15 lichte, comfortabele kamers. Je kunt ook gebruikmaken van het restaurant ter plaatse."
    ],
    "es": [
      "El Bel'Vue*** es un hotel con encanto con una magnífica vista panorámica sobre el valle. dispone de 15 habitaciones luminosas y confortables. También podrá disfrutar de su restaurante."
    ]
  },
  "rdfs:label": {
