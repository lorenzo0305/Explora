  "rdfs:comment": {
    "de": [
      "Die Bibliothek steht allen kostenlos zum Lesen und zur Konsultation vor Ort offen. Für einen symbolischen Betrag kann man sich anmelden und Bücher und Zeitschriften ausleihen. Zugang zum Internet für alle."
    ],
    "en": [
      "The library is open to everyone for reading and consultation in the building. For a nominal fee you can subscribe to borrow books and magazines. Internet access for everyone."
    ],
    "it": [
      "La biblioteca è aperta a tutti gratuitamente per la lettura e la consultazione in loco. Per una quota nominale, è possibile registrarsi e prendere in prestito libri e riviste. Accesso a Internet per tutti."
    ],
    "fr": [
      "La bibliothèque est ouverte à tous gratuitement pour la lecture et la consultation sur place. Pour une somme symbolique, on peut s'inscrire et emprunter livres et revues. Accès pour tous à Internet."
    ],
    "es": [
      "La biblioteca está abierta a todos de forma gratuita para la lectura y la consulta in situ. Por un precio simbólico, puede registrarse y tomar prestados libros y revistas. Acceso a Internet para todos."
    ],
    "nl": [
      "De bibliotheek is voor iedereen gratis toegankelijk voor lezing en raadpleging ter plaatse. Tegen een kleine vergoeding kunt u zich inschrijven en boeken en tijdschriften lenen. Internettoegang voor iedereen."
    ]
  },
