  "rdfs:comment": {
    "de": [
      "Festi'banquet - 30 Jahre Festkomitee! Festlicher Tag mit einem kompletten Bankett (Vorspeise, Hauptgericht, Käse, Dessert). 40? Erwachsene (+14 Jahre), 25? Kinder. Treffpunkt um 12 Uhr in der Sporthalle. Eintrittskarten: Office de Tourisme."
    ],
    "en": [
      "Festi'banquet - 30 years of the Comité des Fêtes! Festive day with full banquet (starter, main course, cheese, dessert). 40? adults (+14 years), 25? children. Meet at 12 noon in the gymnasium. Tickets: Tourist Office."
    ],
    "it": [
      "Festi'banquet - 30 anni del Comité des Fêtes! Giornata di festa con banchetto completo (antipasto, piatto principale, formaggio, dessert). 40? adulti (+14 anni), 25? bambini. Ritrovo alle 12.00 presso la palestra. Biglietti: Ufficio del Turismo."
    ],
    "fr": [
      "Festi'banquet - 30 ans du Comité des Fêtes ! Journée festive avec banquet complet (entrée, plat, fromage, dessert). 40€ adultes (+14 ans), 25€ enfants. RDV 12h au gymnase. Billets : Office de Tourisme."
    ],
    "es": [
      "Festi'banquet - ¡30 años del Comité des Fêtes! Jornada festiva con banquete completo (entrante, plato principal, queso, postre). 40? adultos (+14 años), 25? niños. Punto de encuentro a las 12 h en el gimnasio. Entradas: Oficina de Turismo."
    ],
    "nl": [
      "Festi'banquet - 30 jaar Comité des Fêtes! Feestelijke dag met volledig banket (voorgerecht, hoofdgerecht, kaas, dessert). 40? volwassenen (+14 jaar), 25? kinderen. Trefpunt 12 uur bij de gymzaal. Tickets: Toeristenbureau."
    ]
