  "rdfs:comment": {
    "de": [
      "Freie Besichtigung mit Dokument. Die Kirche wurde Ende des 11. Jahrhunderts im romanischen Cluniazensischen Stil erbaut und im Laufe der Jahrhunderte stark umgebaut. Dem Kirchenschiff geht ein Narthex voraus, auf dessen linker Seite sich ein Baptisterium öffnet, das im Land von Levis sehr selten ist."
    ],
    "en": [
      "Free visit with document. Church built at the end of the 11th century in a Cluniac Romanesque style which has been strongly remodelled over the centuries. The nave is preceded by a narthex on the left of which opens a baptistery, very rare in the country of Levis."
    ],
    "it": [
      "Visita gratuita con documentazione. La chiesa fu costruita alla fine dell'XI secolo in stile romanico cluniacense ed è stata pesantemente modificata nel corso dei secoli. La navata è preceduta da un nartece a sinistra del quale si apre un battistero, molto raro nella regione di Lévis."
    ],
    "fr": [
      "Visite libre avec document. Eglise construite à la fin du XIe siècle dans un style roman clunisien qui a été fortement remaniée au cours des siècles. La nef est précédée d'un narthex sur la gauche duquel s'ouvre un baptistère, très rare en pays de Lévis."
    ],
    "es": [
      "Visita gratuita con documentación. La iglesia fue construida a finales del siglo XI en estilo románico cluniacense y ha sido muy modificada a lo largo de los siglos. La nave está precedida por un nártex a cuya izquierda se abre un baptisterio, muy raro en la región de Lévis."
    ],
    "nl": [
      "Gratis bezoek met documentatie. De kerk werd aan het eind van de 11e eeuw gebouwd in de Cluniac Romaanse stijl en is in de loop der eeuwen sterk gewijzigd. Het schip wordt voorafgegaan door een narthex met links daarvan een doopkapel, zeer zeldzaam in de streek van Levis."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Hippolyte"
    ]
  },
