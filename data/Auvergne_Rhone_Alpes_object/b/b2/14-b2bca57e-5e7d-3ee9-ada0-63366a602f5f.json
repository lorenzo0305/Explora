  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/768974c8-f448-3218-8cd6-0c3f1356fabe",
      "dc:description": {
        "de": [
          "Eine Debatte mit Herrn Pierre-René Prévost über den Urknall. Er ist Absolvent der Pariser Sternwarte. Treffen Sie ihn, um mehr über die Veränderungen im Universum zu erfahren und zu diskutieren."
        ],
        "en": [
          "A debate with Pierre-René Prévost on the Big Bang. A graduate of the Paris Observatory, come and meet him to discover and discuss the changes in the Universe."
        ],
        "it": [
          "Un dibattito con Pierre-René Prévost sul Big Bang. Laureato all'Osservatorio di Parigi, venite a incontrarlo per scoprire e discutere i cambiamenti dell'Universo."
        ],
        "fr": [
          "Un débat avec Monsieur Pierre-René Prévost sur le Big Bang. Diplômé de l'observatoire de Paris, venez à sa rencontre afin de découvrir et de discuter sur les changements de l'Univers."
        ],
        "es": [
          "Un debate con Pierre-René Prévost sobre el Big Bang. Diplomado del Observatorio de París, venga a conocerle para descubrir y debatir sobre los cambios del Universo."
        ],
        "nl": [
          "Een debat met Pierre-René Prévost over de oerknal. Afgestudeerd aan het Observatorium van Parijs, kom hem ontmoeten om de veranderingen in het heelal te ontdekken en te bespreken."
        ]
      },
