  "rdfs:comment": {
    "de": [
      "Cocotte bietet Ihnen eine familiäre, traditionelle und authentische Küche, die mit frischen und hochwertigen Produkten zubereitet wird... Brathähnchen, Eisbein und alle anderen köstlichen Fleischsorten am Spieß.\r\nPrivatisierung möglich und maßgeschneiderte Leistungen."
    ],
    "en": [
      "Cocotte offers you a family, traditional and authentic cuisine made with fresh and quality products. Roast chicken, ham and all other delicious meats on the spit.\r\nPrivatization possible and tailor-made services."
    ],
    "it": [
      "La Cocotte offre una cucina familiare tradizionale e autentica, fatta di prodotti freschi e di qualità... Pollo arrosto, stinco di prosciutto e tutte le altre deliziose carni allo spiedo.\r\nPossibilità di privatizzazione e servizi su misura."
    ],
    "fr": [
      "Cocotte vous propose une cuisine familiale, traditionnelle et authentique élaborée avec des produits frais et de qualité...Poulet rôti, jambonneau et toutes autres délicieuses viandes à la broche.\r\nPrivatisation possible et prestations sur-mesure."
    ],
    "es": [
      "Cocotte ofrece una cocina familiar tradicional y auténtica elaborada con productos frescos y de calidad... Pollo asado, codillo de jamón y todas las demás deliciosas carnes al espeto.\r\nPosible privatización y servicios a medida."
    ],
    "nl": [
      "Cocotte biedt een traditionele en authentieke familiekeuken gemaakt met verse en kwaliteitsproducten... Geroosterde kip, knakworst en alle andere heerlijke vleeswaren aan het spit.\r\nPrivatisering mogelijk en diensten op maat."
    ]
  },
