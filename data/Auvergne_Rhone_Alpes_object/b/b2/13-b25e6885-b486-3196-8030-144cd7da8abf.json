  "rdfs:comment": {
    "de": [
      "Bauernladen seit 2014 mit rund 60 Produzentinnen und Produzenten.\r\n\r\nDer Laden ist auch Schauplatz regelmäßiger Veranstaltungen. Besuchen Sie unsere Facebook-Seite, um unsere Neuigkeiten zu verfolgen und unsere Produkte zu entdecken."
    ],
    "en": [
      "Country grocery store since 2014 with around 60 producers.\r\n\r\nThe store also hosts regular events, so visit our facebook page to follow our news and discover our products."
    ],
    "it": [
      "Un negozio di alimentari per agricoltori dal 2014 con circa sessanta produttori.\r\n\r\nIl negozio ospita anche eventi periodici. Visitate la nostra pagina facebook per rimanere aggiornati sulle nostre novità e scoprire i nostri prodotti."
    ],
    "fr": [
      "Épicerie paysanne depuis 2014 avec une soixantaine de producteurs et productrices.\r\n\r\nLe magasin est également le lieux d'évènements réguliers, visitez notre page facebook pour suivre notre actualité et découvrir nos produits."
    ],
    "es": [
      "Una tienda de comestibles de agricultores desde 2014 con unos sesenta productores.\r\n\r\nVisita nuestra página de Facebook para estar al día de nuestras novedades y descubrir nuestros productos."
    ],
    "nl": [
      "Een kruidenierswinkel voor boeren sinds 2014 met ongeveer zestig producenten.\r\n\r\nBezoek onze facebookpagina om op de hoogte te blijven van ons nieuws en onze producten te ontdekken."
    ]
  },
  "rdfs:label": {
