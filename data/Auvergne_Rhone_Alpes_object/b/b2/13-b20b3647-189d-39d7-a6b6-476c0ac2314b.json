  "rdfs:comment": {
    "de": [
      "Freizeitzentrum auf einem großen Gelände: Picknickplatz, Tennisplätze, Stadion, Bouleplätze, Kinderspielplatz, Seilbahn, Spaziergänge, Gesundheitsparcours... 2 Paddle-Tennisplätze können reserviert werden, 1 Pumptrack."
    ],
    "en": [
      "Leisure center on extensive grounds: picnic area, tennis courts, stadium, petanque courts, children's playground, zip line, walks, fitness trail, etc. 2 padel courts to reserve, 1 pump track."
    ],
    "it": [
      "Centro ricreativo immerso in un vasto parco: area picnic, campi da tennis, stadio, campi da bocce, area giochi per bambini, zip line, passeggiate, percorso fitness, ecc. 2 campi da padel su prenotazione, 1 pump track."
    ],
    "fr": [
      "Base de loisirs sur un vaste terrain : aire de pique-nique, cours de tennis, stade, terrains de pétanque, aire de jeux pour enfants, tyrolienne, balades, parcours de santé… 2 terrains de padel à réserver, 1 pump track."
    ],
    "nl": [
      "Recreatiecentrum op een uitgestrekt terrein: picknickplaats, tennisbanen, stadion, petanquebanen, speeltuin, tokkelbaan, wandelingen, fitnessparcours, etc. 2 padelbanen beschikbaar voor reservering, 1 pumptrack."
    ],
    "es": [
      "Centro de ocio situado en un extenso terreno: zona de picnic, pistas de tenis, estadio, pistas de petanca, parque infantil, tirolina, paseos, pista de fitness, etc. 2 pistas de pádel disponibles para reservar, 1 pista de pump track."
    ]
  },
