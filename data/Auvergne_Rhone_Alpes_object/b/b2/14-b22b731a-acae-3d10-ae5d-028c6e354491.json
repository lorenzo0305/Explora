  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f94bcc2a-5e42-3cc8-9c9c-4ed884e3295d",
      "dc:description": {
        "de": [
          "Im Jahr 1913 ließ der Abt Crocfer diese Höhle aus Beton und Feuerstein als Dank für seine Heilung von einer Knochenkrankheit errichten."
        ],
        "en": [
          "In 1913, Father Crocfer had this cave built of concrete and flint in recognition of his recovery from a bone disease."
        ],
        "it": [
          "Nel 1913, l'abate Crocfer fece costruire questa grotta in cemento e selce come riconoscimento per la sua guarigione da una malattia ossea."
        ],
        "fr": [
          "En 1913, l'abbé Crocfer fait construite cette grotte de béton et de silex en reconnaissance de sa guérison d'une maladie osseuse."
        ],
        "nl": [
          "In 1913 liet Abt Crocfer deze grot van beton en vuursteen bouwen ter erkenning van zijn herstel van een botziekte."
        ],
        "es": [
          "En 1913, el abad Crocfer hizo construir esta cueva de hormigón y sílex en reconocimiento a su recuperación de una enfermedad ósea."
        ]
      },
