  "rdfs:comment": {
    "de": [
      "Im kleinen Weiler Brion löscht das Ecir et l'Angélique den Durst und belebt alle, die in die warme Atmosphäre eines alten Gasthauses eintauchen möchten."
    ],
    "en": [
      "In the small hamlet of Brion, l'Ecir et l'Angélique quenches the thirst of all those who want to immerse themselves in the warm atmosphere of an old inn."
    ],
    "it": [
      "Nella piccola frazione di Brion, l'Ecir et l'Angélique disseta tutti coloro che vogliono immergersi nella calda atmosfera di un'antica locanda."
    ],
    "fr": [
      "Dans le petit hameau de Brion l'Ecir et l'Angélique désaltère et revigore tous ceux qui veulent se plonger dans l'atmosphère chaleureuse d'une vielle auberge."
    ],
    "nl": [
      "In het kleine gehucht Brion lest l'Ecir et l'Angélique de dorst van iedereen die zich wil onderdompelen in de warme sfeer van een oude herberg."
    ],
    "es": [
      "En la pequeña aldea de Brion, l'Ecir et l'Angélique sacia la sed de todos aquellos que quieren sumergirse en el cálido ambiente de una antigua posada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Bistrot d'en Haut"
    ]
  },
