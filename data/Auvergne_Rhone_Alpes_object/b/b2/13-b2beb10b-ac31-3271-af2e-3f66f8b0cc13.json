  "rdfs:comment": {
    "de": [
      "Dicht am Stadtzentrum von Montbrison bietet das Restaurant \"Mise en Scène\" einen gemütlichen Rahmen. Stephanie und Julien schlagen Ihnen eine gepflegte traditionelle, den Jahreszeiten angepasste Küche vor."
    ],
    "en": [
      "Close to the town centre of Montbrison, the  Mise en Scène restaurant offers a you a very warm welcome.  Stéphanie and Julien serve  traditional dishes using seasonal foods."
    ],
    "it": [
      "Il ristorante Mise en Scène offre un ambiente accogliente. Stéphanie e Julien propongono una cucina tradizionale e curata che rispecchia le stagioni."
    ],
    "fr": [
      "Le restaurant Mise en Scène offre un cadre des plus chaleureux. Stéphanie et Julien vous proposent une cuisine traditionnelle soignée rythmée par les saisons."
    ],
    "nl": [
      "Het restaurant Mise en Scène biedt een warme omgeving. Stéphanie en Julien serveren traditionele, zorgvuldig bereide gerechten die de seizoenen weerspiegelen."
    ],
    "es": [
      "El restaurante Mise en Scène ofrece un ambiente acogedor. Stéphanie y Julien sirven una cocina tradicional y cuidada que refleja las estaciones."
    ]
  },
