  "rdfs:comment": {
    "de": [
      "Sattlerei für Motorräder und Schneemobile, Möbel und Lederwaren.\r\nIch bin Handwerker und daher oft bei Kundenterminen im Freien anzutreffen. Zögern Sie nicht, mich vor Ihrem Besuch anzurufen, um sicherzugehen, dass ich da bin."
    ],
    "en": [
      "Motorbike and snowmobile upholstery, furnishings and leather goods.\r\nI'm a craftsman, so I'm often out on location, so don't hesitate to call before you come to make sure I'll be there."
    ],
    "it": [
      "Tappezzeria per moto e motoslitte, arredamento e pelletteria.\r\nEssendo un artigiano, sono spesso in giro con i clienti, quindi non esitate a chiamarmi prima di venire per accertarvi della mia presenza."
    ],
    "fr": [
      "Sellerie motos, moto-neiges, ameublement et création de maroquinerie.\r\nArtisan et donc souvent en rdv clientèle en extérieur, n’hésitez-pas à m’appeler avant de venir pour être certain que je sois là."
    ],
    "es": [
      "Tapicería de motos y motonieves, mobiliario y marroquinería.\r\nComo soy artesano, a menudo estoy fuera con los clientes, así que no dude en llamarme antes de venir para asegurarse de que estaré allí."
    ],
    "nl": [
      "Motor- en sneeuwscooterbekleding, meubels en lederwaren.\r\nOmdat ik een ambachtsman ben, ben ik vaak op pad met klanten, dus aarzel niet om me van tevoren te bellen om er zeker van te zijn dat ik er ben."
    ]
  },
  "rdfs:label": {
    "de": [
      "Une montagne de savoir faire"
    ],
    "en": [
      "Une montagne de savoir faire"
    ],
    "fr": [
      "Une montagne de savoir faire"
    ]
  },
