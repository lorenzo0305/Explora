  "rdfs:comment": {
    "de": [
      "Etablissement im Herzen von Les 2 Alpes.\r\nGourmet-Restaurant, Weinkeller mit kleinen und großen französischen Weinen, eine sehr sonnige Terrasse, ein gemütlicher Salon mit Kamin, ein unterhaltsames und festliches Bistro."
    ],
    "en": [
      "Establishment in the heart of Les 2 Alpes.\r\nGourmet restaurant, wine cellar decorated with small and large French wines, a very sunny terrace, a cozy lounge with fireplace, an entertaining and festive bistro."
    ],
    "it": [
      "Stabilimento nel cuore di Les 2 Alpes.\r\nRistorante gourmet, cantina di vini con vini francesi piccoli e grandi, una terrazza molto soleggiata, un salotto accogliente con camino, un bistrot divertente e festivo."
    ],
    "fr": [
      "Etablissement au cœur des 2 Alpes.\r\nRestaurant gourmand, cave à vins agrémentée de petits et grands crus français, une terrasse très ensoleillée, un salon cosy avec cheminée, un bistrot divertissant et festif."
    ],
    "nl": [
      "Etablissement in het hart van Les 2 Alpes.\r\nEen gastronomisch restaurant, een wijnkelder met een selectie van kleine en grote Franse wijnen, een zonnig terras, een gezellig salon met open haard, een gezellige en feestelijke bistro."
    ],
    "es": [
      "Establecimiento en el corazón de Les 2 Alpes.\r\nUn restaurante gastronómico, una bodega con una selección de pequeños y grandes vinos franceses, una terraza soleada, un salón acogedor con chimenea, un bistró lúdico y festivo."
    ]
  },
  "rdfs:label": {
    "en": [
