  "rdfs:comment": {
    "de": [
      "Die Galerie öffnet ihre Türen für alle, die neugierig auf Kunst sind. Sie befindet sich in dem kleinen provenzalischen Dorf Venterol, hinter der Kirche im ehemaligen Gemeindehaus. Die Galerie präsentiert Ihnen Gemälde und Skulpturen von etablierten Künstlern."
    ],
    "en": [
      "Paintings, sculptures and photos, exhibited in a former parich house with vaulted ceilings."
    ],
    "it": [
      "La galleria apre le sue porte a tutti gli amanti dell'arte. Si trova nel piccolo villaggio provenzale di Venterol, dietro la chiesa nella vecchia casa parrocchiale. La galleria presenta dipinti e sculture di artisti affermati."
    ],
    "fr": [
      "La galerie ouvre ses portes à tout curieux d'art. Elle se situe dans le petit village provençal de Venterol, derrière l'église dans l'ancienne maison paroissiale. La galerie vous présente des oeuvres de peintures et sculptures d'artistes confirmés."
    ],
    "es": [
      "La galería abre sus puertas a todos los amantes del arte. Se encuentra en el pequeño pueblo provenzal de Venterol, detrás de la iglesia, en la antigua casa parroquial. La galería presenta pinturas y esculturas de artistas consagrados."
    ],
    "nl": [
      "De galerie staat open voor iedereen met interesse in kunst. De galerie is gevestigd in het kleine Provençaalse dorp Venterol, achter de kerk in het voormalige parochiehuis. De galerie presenteert schilderijen en beeldhouwwerken van gevestigde kunstenaars."
    ]
  },
  "rdfs:label": {
    "en": [
      "\"Ombre et Lumière\" Gallery"
    ],
    "fr": [
      "Galerie Ombre et Lumière"
    ]
  },
