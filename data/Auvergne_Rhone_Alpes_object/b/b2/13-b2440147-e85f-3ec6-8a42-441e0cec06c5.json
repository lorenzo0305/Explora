  "rdfs:comment": {
    "de": [
      "Auf der ständigen Suche nach den neuesten Trends, die klare Linien und edle Materialien vereinen, ist es unser Engagement als dekorative Tischler und Akteure des zeitgenössischen Designs, für Sie elegante Möbel zu kreieren."
    ],
    "en": [
      "Constantly on the lookout for the latest trends combining pure lines and noble materials, our commitment as cabinetmakers and decorators, and as players in contemporary design, is to create elegant furniture for you."
    ],
    "it": [
      "Un artigiano vicino ai suoi clienti, che si prende il tempo di immaginare i vostri progetti e di realizzarli per armonizzare i vostri interni.\r\nOffro prodotti di qualità come il legno regionale o francese e una competenza riconosciuta."
    ],
    "fr": [
      "Artisan proche de ses clients qui prend le temps d'imaginer vos projets et les réalise pour harmoniser votre intérieur.\r\nJe propose des produits de qualité comme des bois régionaux ou français et un savoir faire reconnu."
    ],
    "nl": [
      "Voortdurend op zoek naar de nieuwste trends die pure lijnen en edele materialen combineren, is het onze belofte als meubelmakers en decorateurs, en spelers in hedendaags design, om elegante meubels voor jou te creëren."
    ],
    "es": [
      "Un artesano cercano a sus clientes, que se toma el tiempo de imaginar sus proyectos y realizarlos para armonizar su interior.\r\nOfrezco productos de calidad, como madera regional o francesa, y una experiencia reconocida."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier Sainte Anne"
    ]
  },
