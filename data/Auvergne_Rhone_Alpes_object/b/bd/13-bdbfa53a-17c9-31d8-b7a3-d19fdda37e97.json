  "rdfs:comment": {
    "de": [
      "Ski Joering in Avoriaz: Ausflüge auf Skiern, die von einem Pferd gezogen werden, um die Leidenschaft für das Skifahren und das Pferd zu vereinen. Einführung oder Ausritt für einen einzigartigen Moment."
    ],
    "en": [
      "Ski Joering in Avoriaz: skiing while being pulled by a horse, combining the love of skiing and horseback riding. Beginners or guided rides for a unique experience."
    ],
    "it": [
      "Ski Joering ad Avoriaz: sci alpinismo a cavallo, che unisce la passione per lo sci e l'equitazione. Iniziazione o cavalcata per un momento unico."
    ],
    "fr": [
      "Ski Joering à Avoriaz : balade en ski tiré par un cheval, pour allier passion du ski et du cheval. Initiation ou balade pour un moment unique."
    ],
    "nl": [
      "Ski Joering in Avoriaz: skiën terwijl je door een paard wordt getrokken, voor wie van skiën en paarden houdt. Initiatie of begeleide tocht voor een unieke ervaring."
    ],
    "es": [
      "Ski Joering en Avoriaz: esquí de travesía a caballo, combinando la pasión por el esquí y la equitación. Iniciación o paseo para un momento único."
    ]
  },
