  "rdfs:comment": {
    "de": [
      "5 Abfahrten - Für den ultimativen Nervenkitzel geht es nach La Mine, einer 4-Saison-Schienenschlittenattraktion in Les 3 Vallées, die Sie in die Geschichte des Skigebiets eintauchen lässt (ab 5 Jahren und 1,10 m)."
    ],
    "en": [
      "5 runs - For the ultimate thrill, head for La Mine, a 4-season tobogganing attraction in Les 3 Vallées that plunges you into the history of the resort (from 5 years and 1.10m)."
    ],
    "it": [
      "5 piste - Per provare tutte le emozioni del caso, recatevi a La Mine, un'attrazione per slittini su rotaia per 4 stagioni a Les 3 Vallées che vi immerge nella storia della località (a partire da 5 anni e 1,10 m)."
    ],
    "fr": [
      "5 descentes - Pour faire le plein de frissons, direction La Mine, une attraction de luge sur rails 4 saison dans Les 3 Vallées qui vous plonge dans l'histoire de la station (à partir de 5 ans et 1,10m)."
    ],
    "es": [
      "5 pistas - Para disfrutar de todas las emociones, diríjase a La Mine, una atracción de trineo sobre raíles en Les 3 Vallées que le sumergirá en la historia de la estación (a partir de 5 años y 1,10 m)."
    ],
    "nl": [
      "5 afdalingen - Voor sensatie gaat u naar La Mine, een 4-seizoenen rodelbaan in Les 3 Vallées die u onderdompelt in de geschiedenis van het skioord (vanaf 5 jaar en 1.10m)."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Mine - luge sur rails - 5 descentes"
    ]
  },
