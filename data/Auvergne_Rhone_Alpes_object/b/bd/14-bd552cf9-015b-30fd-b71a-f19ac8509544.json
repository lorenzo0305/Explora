        "de": [
          "Aufführung am Nikolaustag\nFestsaal um 16:30 Uhr \"Répartout, le lutin du Père-Noël, Gratis mit Anmeldung im Rathaus. Mit der Anwesenheit des Heiligen Nikolaus."
        ],
        "en": [
          "Saint-Nicolas show\nSalle des fêtes at 4:30pm \"Répartout, le lutin du Père-Noël, Free with registration at the Mairie. With the presence of Saint Nicolas."
        ],
        "it": [
          "Spettacolo di Saint-Nicolas\nSalle des fêtes alle 16.30 \"Répartout, le lutin du Père-Noël\", gratuito su iscrizione alla Mairie. Con la presenza di San Nicola."
        ],
        "fr": [
          "Spectacle de la Saint-Nicolas\nSalle des fêtes à 16h30 \"Répartout, le lutin du Père-Noël, Gratuit sur inscription en mairie. Avec la présence de Saint Nicolas."
        ],
        "nl": [
          "Saint-Nicolas voorstelling\nSalle des fêtes om 16u30 \"Répartout, le lutin du Père-Noël, Gratis na inschrijving bij de Mairie. Met de aanwezigheid van Sinterklaas."
        ],
        "es": [
          "Espectáculo de Saint-Nicolas\nSalle des fêtes a las 16.30 h \"Répartout, le lutin du Père-Noël, Gratuito previa inscripción en la Mairie. Con la presencia de San Nicolás."
        ]
