  "rdfs:comment": {
    "de": [
      "La Maison du Lac bietet Ihnen einen erholsamen Zwischenstopp in einem sechs Hektar großen Park, 30 Minuten von Moulins, 45 Minuten von Vichy entfernt, in der Nähe des Freizeit- und Tierparks Le PAL."
    ],
    "en": [
      "La Maison du Lac offers you a relaxing stopover in a six-hectare park, 30 minutes from Moulins, 45 minutes from Vichy, close to the Le PAL amusement and animal park."
    ],
    "it": [
      "La Maison du Lac vi offre una sosta riposante in un parco di sei ettari, a 30 minuti da Moulins, a 45 minuti da Vichy, vicino al parco divertimenti e faunistico Le PAL."
    ],
    "fr": [
      "La Maison du Lac vous propose une halte reposante dans un parc de six hectares, 30 minutes de Moulins, 45 minutes de Vichy, à proximité du parc d'attractions et animalier Le PAL."
    ],
    "es": [
      "La Maison du Lac le ofrece una parada de descanso en un parque de seis hectáreas, a 30 minutos de Moulins, a 45 minutos de Vichy, cerca del parque de atracciones y fauna Le PAL."
    ],
    "nl": [
      "La Maison du Lac biedt je een rustgevende tussenstop in een park van zes hectare, op 30 minuten van Moulins, 45 minuten van Vichy, vlakbij het attractie- en wildpark Le PAL."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Hôtel La Maison du Lac"
    ]
  },
