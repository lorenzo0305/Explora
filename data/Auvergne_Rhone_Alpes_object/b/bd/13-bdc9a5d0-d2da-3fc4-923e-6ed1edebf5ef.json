  "rdfs:comment": {
    "de": [
      "In unserem Factory Outlet finden Sie alle Le Batistou-Produkte zu unwiderstehlichen Preisen: Rohwürste, getrocknete Schinken, Miniwürste, IGP-Auvergne-Produkte, reines Schweinefleisch und Stierchorizo ​​..."
    ],
    "en": [
      "Find all Le Batistou products in our factory outlet at irresistible prices: dry sausages, dried hams, mini sausages, IGP Auvergne products, pure pork and bull chorizo ​​..."
    ],
    "it": [
      "Trovate tutti i prodotti Le Batistou nel nostro negozio di vendita diretta a prezzi da produttore.\r\nVenite a scoprire i nostri salumi tradizionali."
    ],
    "fr": [
      "Retrouvez tous les produits Le Batistou dans notre magasin de vente directe au prix producteur. \r\nVenez découvrir nos salaisons fabriquées dans le respect de la pure tradition."
    ],
    "nl": [
      "Vind alle producten van Le Batistou in onze winkel voor rechtstreekse verkoop tegen producentenprijzen.\r\nKom en ontdek onze traditionele vleeswaren."
    ],
    "es": [
      "Encuentre todos los productos Le Batistou en nuestra tienda de venta directa a precios de productor.\r\nVenga a descubrir nuestros embutidos tradicionales."
    ]
