  "rdfs:comment": {
    "de": [
      "Unsere Crêperie liegt ideal inmitten der Pisten von Plaine Dranse und verwöhnt Ihren Gaumen mit hausgemachten Crêpes aus Weizenmehl."
    ],
    "en": [
      "Ideally situated in the middle of the Plaine Dranse area, our crêperie offers you the chance to treat your taste buds to home-made crêpes made from wheat flour."
    ],
    "it": [
      "Situata in posizione ideale in mezzo alle piste della Plaine Dranse, la nostra crêperie vi offre la possibilità di deliziare il vostro palato con crêpes fatte in casa con farina di grano."
    ],
    "fr": [
      "Idéalement située au milieu des pistes de Plaine Dranse, notre crêperie propose de vous régaler les papilles avec des crêpes faites maison, à base de farine de froment."
    ],
    "nl": [
      "Onze crêperie is ideaal gelegen in het midden het Plaine Dranse gebied en biedt u de kans om uw smaakpapillen te verwennen met huisgemaakte crêpes gemaakt van tarwemeel."
    ],
    "es": [
      "Idealmente situada en medio de las pistas de la Plaine Dranse, nuestra crepería le ofrece la posibilidad de deleitar su paladar con crepes caseros elaborados con harina de trigo."
    ]
  },
  "rdfs:label": {
