  "rdfs:comment": {
    "de": [
      "Handwerkliche Herstellung von hübschen, ganz weißen Töpferwaren aus glasiertem Steingut, die sowohl als Gebrauchsgegenstände als auch als Dekoration dienen.\r\nVorführungen und Einführungen während der Sommer- und Wintersaison nur nach Voranmeldung unter 0658104556."
    ],
    "en": [
      "Artisanal production of beautiful, all-white glazed stoneware pottery, both utilitarian and decorative.\r\nDemonstrations and introductions during the summer and winter seasons, by reservation only, at 0658104556."
    ],
    "it": [
      "Produzione artigianale di graziose ceramiche in gres smaltato tutto bianco, sia utilitarie che decorative.\r\nDimostrazioni e presentazioni durante la stagione estiva e invernale, solo su prenotazione, all'indirizzo 0658104556."
    ],
    "fr": [
      "Fabrication artisanale de jolies poteries toutes blanches en grès émaillé, utilitaires et décoratives.\r\nDémonstrations et initiations durant les saisons été et hiver sur réservation uniquement au 0658104556."
    ],
    "es": [
      "Producción artesanal de bonita cerámica de gres esmaltado totalmente blanco, tanto utilitaria como decorativa.\r\nDemostraciones y presentaciones durante las temporadas de verano e invierno, solo con cita previa, en 0658104556."
    ],
    "nl": [
      "Ambachtelijke productie van mooi, volledig wit geglazuurd steengoed aardewerk, zowel gebruiks- als sieraardewerk.\r\nDemonstraties en inleidingen tijdens het zomer- en winterseizoen, alleen op afspraak, op 0658104556."
    ]
  },
