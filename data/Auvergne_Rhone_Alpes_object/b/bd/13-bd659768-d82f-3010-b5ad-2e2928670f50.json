  "rdfs:comment": {
    "de": [
      "Gérard und Caroline freuen sich, Sie in der Chèvrerie des Thoules begrüßen zu dürfen. Sie sind ihren Traditionen und ihrer landwirtschaftlichen Produktion verbunden und teilen ihr Wissen mit Leidenschaft, sodass auch die Jüngsten eine Erfahrung machen können, bei der es viel zu entdecken gibt."
    ],
    "en": [
      "Caroline and Gérard invite you to discover their passion for goats and mountain farming in a one-hour visit. You will discover what goes on behind-the-scenes in their farm and end the visit with a tasting of their products."
    ],
    "it": [
      "Gérard e Caroline sono lieti di darvi il benvenuto alla Chèvrerie des Thoules. Attaccati alle loro tradizioni e ai loro prodotti agricoli, condividono con passione il loro know-how, offrendo ai giovani un'esperienza ricca di scoperte."
    ],
    "fr": [
      "Gérard et Caroline sont ravis de vous accueillir à la Chèvrerie des Thoules. Attachés à leurs traditions et à leurs productions agricoles, ils partagent avec passion leur savoir-faire, offrant aux plus jeunes une expérience riche en découvertes."
    ],
    "es": [
      "Gérard y Caroline están encantados de recibirle en la Chèvrerie des Thoules. Apegados a sus tradiciones y a sus productos agrícolas, comparten su saber hacer con pasión, ofreciendo a los más jóvenes una experiencia rica en descubrimientos."
    ],
    "nl": [
      "Caroline en Gérard nodigen je uit om hun passie voor geiten en berglandbouw te ontdekken tijdens een bezoek. Je krijgt een kijkje achter de schermen van hun boerderij en eindigt het bezoek met een proeverij van hun producten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "La chèvrerie des Thoules"
    ]
  },
