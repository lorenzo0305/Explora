  "rdfs:comment": {
    "de": [
      "Wir sind ein neuer, epikureischer Tisch im Zentrum von Valencia. Wir arbeiten mit lokalen Akteuren (Fleisch, Fisch, Gemüse, Wurstwaren, Käse) auf der Suche nach frischen und saisonalen Produkten."
    ],
    "en": [
      "We're a new epicurean restaurant in the center of Valence. We work with local players (meat, fish, vegetables, charcuterie, cheese) in search of fresh, seasonal produce."
    ],
    "it": [
      "Siamo un nuovo ristorante epicureo nel centro di Valencia. Lavoriamo con attori locali (carne, pesce, verdure, salumi, formaggi) alla ricerca di prodotti freschi e stagionali."
    ],
    "fr": [
      "Nous sommes une nouvelle table épicurienne au centre de Valence. Nous travaillons avec acteur locaux (viande, poisson, légumes, charcuterie, fromage) à la recherche de produits frais et de saison."
    ],
    "nl": [
      "Wij zijn een nieuw epicuristisch restaurant in het centrum van Valence. We werken met lokale spelers (vlees, vis, groenten, vleeswaren, kaas) op zoek naar verse, seizoensgebonden producten."
    ],
    "es": [
      "Somos un nuevo restaurante epicúreo en el centro de Valencia. Trabajamos con actores locales (carne, pescado, verduras, charcutería, queso) en busca de productos frescos y de temporada."
    ]
  },
