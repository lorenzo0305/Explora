  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/926d7421-b117-3e7f-9bdc-14d93b120e77",
      "dc:description": {
        "de": [
          "Sport für jedermann! Ich biete Ihnen Einzel- oder Kleingruppentraining an. Auf dem Programm stehen sanfte Gymnastik, Fitness, Cardio-Step, Yoga-Einführung, Pilates, Stretching und Muskeltraining."
        ],
        "en": [
          "Sport for everyone! I offer individual or small group sessions. The program includes gentle gym, fitness, cardio step, yoga initiation, Pilates, stretching and weight training."
        ],
        "it": [
          "Sport per tutti! Offro sessioni individuali o di piccolo gruppo personalizzate in base alle vostre esigenze. Il programma comprende ginnastica dolce, fitness, cardio step, introduzione allo yoga, pilates, stretching e allenamento con i pesi."
        ],
        "fr": [
          "Le sport à la porté de tous ! je vous propose des séances individuelles ou en petit groupe adaptés. Au programme gym douce, fitness, cardio step, Yoga initiation, Pilates, stretching et musculation."
        ],
        "nl": [
          "Sport voor iedereen! Ik bied individuele sessies of sessies in een kleine groep, afgestemd op jouw behoeften. Het programma omvat rustige gymnastiek, fitness, cardio step, inleidende yoga, Pilates, stretching en krachttraining."
        ],
        "es": [
          "Deporte para todos. Ofrezco sesiones individuales o en pequeños grupos adaptadas a sus necesidades. El programa incluye gimnasia suave, fitness, cardio step, iniciación al yoga, pilates, estiramientos y musculación."
        ]
      },
