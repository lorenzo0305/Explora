  "rdfs:comment": {
    "de": [
      "In besonderem Rahmen zeigen die Schülerinnen und Schüler ihr Können im Kochen und Servieren. Empfang von Gruppen auf Reservierung. Menüs auf der Website."
    ],
    "en": [
      "In a unique setting, students demonstrate their culinary expertise and table-service skills. Please phone ahead for group bookings. Set menus available on our website."
    ],
    "it": [
      "In un ambiente unico, gli studenti offrono la loro esperienza in cucina e nel servizio ai tavoli. I gruppi sono benvenuti su prenotazione.\r\nMenù disponibili sul sito web e prenotazione online."
    ],
    "fr": [
      "Dans un cadre unique, les élèves proposent leur savoir-faire en matière de cuisine et de service à table. Accueil de groupes sur réservation. \r\nMenus en ligne sur le site internet et réservation en ligne."
    ],
    "nl": [
      "In een unieke omgeving bieden de studenten hun expertise in koken en bediening. Groepen zijn welkom op afspraak.\r\nMenu's beschikbaar op de website en online reserveren."
    ],
    "es": [
      "En un entorno único, los estudiantes ofrecen su experiencia en cocina y servicio de mesa. Se admiten grupos previa concertación.\r\nMenús disponibles en el sitio web y reservas en línea."
    ]
  },
