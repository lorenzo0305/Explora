  "rdfs:comment": {
    "de": [
      "Im Herzen von Lans-en-Vercors ist das Atelier du Presse-Citron ein atypischer Ort mit einem kollaborativen Geist, an dem man sich trifft, um zu arbeiten, zu kreieren, seine Leidenschaft zu teilen und auch zu lachen."
    ],
    "en": [
      "In the heart of Lans-en-Vercors, the Atelier du Presse-Citron is an unusual place with a collaborative spirit where people meet to work, create, share their passion, and laugh too."
    ],
    "it": [
      "L'Atelier du presse-citron è uno spazio associativo atipico con uno spirito collaborativo che riunisce spazi di lavoro e spazi creativi a Lans-en-Vercors. Nel negozio si possono scoprire le opere di artisti e artigiani della regione del Vercors."
    ],
    "fr": [
      "L’Atelier du presse-citron est un lieu associatif, atypique, à l’esprit collaboratif qui réunit des espaces de travail et des espaces de création à Lans-en-Vercors. Côté boutique, découvrez le travail d'artistes et artisans du Vercors."
    ],
    "nl": [
      "L'Atelier du presse-citron is een atypische associatieve ruimte met een samenwerkingsgeest die werkruimtes en creatieve ruimtes in Lans-en-Vercors samenbrengt. Ontdek in de winkel het werk van kunstenaars en ambachtslieden uit de Vercors."
    ],
    "es": [
      "L'Atelier du presse-citron es un espacio asociativo atípico de espíritu colaborativo que reúne espacios de trabajo y de creación en Lans-en-Vercors. En la tienda, descubra el trabajo de los artistas y artesanos de Vercors."
    ]
  },
  "rdfs:label": {
