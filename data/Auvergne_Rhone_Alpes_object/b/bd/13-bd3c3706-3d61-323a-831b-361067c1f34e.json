  "rdfs:comment": {
    "de": [
      "Ihr Sport- und Gesundheitsclub bietet Ihnen eine allgemeine körperliche Vorbereitung: Cross-Training, Mobilität, Gymnastik, Gewichtheben, Ausdauer, Krafttraining, Ernährung. Einzelcoaching, Kleingruppen und freier Zugang."
    ],
    "en": [
      "Your sports and health club offers general physical preparation: cross training, mobility, gymnastics, weightlifting, endurance, bodybuilding, nutrition. Individual coaching, small groups and free access."
    ],
    "it": [
      "Il vostro club sportivo e di salute offre una preparazione fisica generale: cross training, mobilità, ginnastica, sollevamento pesi, resistenza, bodybuilding e alimentazione. Corsi individuali, piccoli gruppi e accesso libero."
    ],
    "fr": [
      "Votre club sport et santé vous propose une préparation physique générale : cross training, mobilité, gymnastique, haltérophilie, endurance, musculation, nutrition. Coaching individuel, petit groupe et accès libre."
    ],
    "es": [
      "Su club deportivo y de salud le ofrece preparación física general: cross training, movilidad, gimnasia, halterofilia, resistencia, musculación y nutrición. Entrenamiento individual, grupos reducidos y acceso libre."
    ],
    "nl": [
      "Jouw sport- en gezondheidsclub biedt algemene lichamelijke voorbereiding: crosstraining, mobiliteit, gymnastiek, gewichtheffen, uithoudingsvermogen, bodybuilding en voeding. Individuele begeleiding, kleine groepen en vrije toegang."
    ]
  },
