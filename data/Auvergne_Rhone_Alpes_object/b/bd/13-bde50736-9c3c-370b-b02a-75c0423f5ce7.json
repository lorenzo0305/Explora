  "rdfs:comment": {
    "de": [
      "Das Labor Vercuma produziert und verkauft einfache Bio-Kosmetik, die für jeden Haut-, Haar- und Charaktertyp geeignet ist. Die angebotenen Kosmetika werden in kleinem Maßstab hergestellt, um das Wohlbefinden der Anwenderinnen und Anwender zu gewährleisten und die Umwelt zu schonen."
    ],
    "en": [
      "The Vercuma laboratory manufactures and sells simple organic cosmetics adapted to each skin, hair and character type. The cosmetics are manufactured on a small scale for users’ well-being and to respect the environment."
    ],
    "it": [
      "Nel loro micro-laboratorio, Nicolas e Laura formulano e producono cosmetici innovativi di alta gamma utilizzando ingredienti attivi al 100%, locali e biologici."
    ],
    "fr": [
      "Dans leur micro laboratoire, Nicolas et Laura formulent et fabriquent des cosmétiques haute gamme et innovateurs, à partir d'ingrédients 100% actifs, locaux et bio."
    ],
    "nl": [
      "In hun micro-laboratorium formuleren en produceren Nicolas en Laura hoogwaardige, innovatieve cosmetica met 100% actieve, lokale en biologische ingrediënten."
    ],
    "es": [
      "En su microlaboratorio, Nicolas y Laura formulan y fabrican cosméticos innovadores de gama alta utilizando ingredientes 100% activos, locales y ecológicos."
    ]
  },
