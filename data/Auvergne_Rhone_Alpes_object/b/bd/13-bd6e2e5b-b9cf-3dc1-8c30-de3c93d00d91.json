  "rdfs:comment": {
    "de": [
      "Gehen Sie an Bord des Lavendelzugs und fahren Sie durch die Felder. Tauchen Sie dann in die zauberhafte Welt des Lavendels ein mit dem 360° Immersionsraum, dem Raum der Düfte und Destillierkolben und der anschließenden Live-Destillation von ätherischem Öl."
    ],
    "en": [
      "Climb aboard the Lavender Train for a ride through the fields, then plunge into the enchanting world of lavender with the 360° immersive room, the scent room and stills, followed by live essential oil distillation."
    ],
    "it": [
      "Salite a bordo del Treno della lavanda per un giro tra i campi, poi immergetevi nell'incantevole mondo della lavanda con la sala immersiva a 360°, la sala dei profumi e degli alambicchi e la distillazione in diretta dell'olio essenziale."
    ],
    "fr": [
      "Embarquez à bord du Train des lavandes pour une balade à travers les champs, puis plongez dans l'univers enchanteur de la lavande avec la salle immersive 360°, la salle des senteurs et des alambics puis la distillation d'huile essentielle en direct."
    ],
    "es": [
      "Suba al Tren de la Lavanda para dar un paseo por los campos y, a continuación, sumérjase en el encantador mundo de la lavanda con la sala de inmersión de 360°, la sala de los aromas y los alambiques y la destilación en directo de aceite esencial."
    ],
    "nl": [
      "Neem de trein doorheen de lavendelvelden om mee te gaan in de wondere wereld van kleuren en geuren! Ontdek de magische transformatie van een bloem door artisanale distillatie."
    ]
  },
