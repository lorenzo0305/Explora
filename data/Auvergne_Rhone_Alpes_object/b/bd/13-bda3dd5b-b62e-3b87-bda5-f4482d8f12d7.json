  "rdfs:comment": {
    "de": [
      "Typische Herberge im Herzen des Dorfes, 3 km von den Schluchten entfernt. Von Guide Vert ausgewählt. Regionale Küche, Terrasse mit Blick auf die Weinberge. Restaurant, Zimmer, Weinstube, Eisdiele und Laden mit lokalen Produkten: eine schmackhafte und authentische Etappe."
    ],
    "en": [
      "Typical inn in the heart of the village, 3 km from the Gorges. Selected by Guide Vert. Local cuisine, terrace overlooking vineyards. Restaurant, rooms, wine bar, ice-cream parlour and store selling local produce: a tasty, authentic stopover."
    ],
    "it": [
      "Locanda tipica nel cuore del villaggio, a 3 km dalle Gole. Selezionato dalla Guide Vert. Cucina locale, terrazza con vista sui vigneti. Ristorante, camere, enoteca, gelateria e negozio di prodotti locali: una sosta gustosa e autentica."
    ],
    "fr": [
      "Auberge typique au cœur du village, à 3 km des Gorges. Sélectionnée Guide Vert. Cuisine du terroir, terrasse avec vue sur les vignes. Restaurant, chambres, bar à vin, glacier et boutique de produits locaux : une étape savoureuse et authentique."
    ],
    "nl": [
      "Typische herberg in het hart van het dorp, op 3 km van de Gorges. Geselecteerd door de Guide Vert. Plaatselijke keuken, terras met uitzicht op de wijngaarden. Restaurant, kamers, wijnbar, ijssalon en winkel met streekproducten: een smakelijke en authentieke tussenstop."
    ],
    "es": [
      "Posada típica en el corazón del pueblo, a 3 km de las Gargantas. Seleccionado por la Guide Vert. Cocina local, terraza con vistas a los viñedos. Restaurante, habitaciones, bar de vinos, heladería y tienda de productos locales: una parada sabrosa y auténtica."
    ]
  },
