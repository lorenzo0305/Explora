  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der Eislaufbahn entfernt, mitten im Ortszentrum. Mountain Piz'Burg bietet leckere Pizzas und Burger, die Sie vor Ort genießen oder mitnehmen können. Ideal für eine schnelle und effiziente Schlemmerpause!"
    ],
    "en": [
      "Just steps from the ice rink, right in the heart of the resort. Mountain Piz'Burg offers delicious pizzas and burgers, available to eat in or take away. Perfect for a quick and tasty bite!"
    ],
    "it": [
      "A pochi passi dalla pista di pattinaggio, proprio nel centro del resort. Mountain Piz'Burg offre gustose pizze e hamburger, da mangiare o da portare via. Ideale per una pausa gourmet veloce ed efficiente!"
    ],
    "fr": [
      "À deux pas de la patinoire, en plein centre station. Mountain Piz'Burg propose pizzas et burgers savoureux, à déguster sur place ou à emporter. Idéal pour une pause gourmande rapide et efficace !"
    ],
    "nl": [
      "Op een steenworp van de ijsbaan, midden in het centrum van het resort. Mountain Piz'Burg serveert heerlijke pizza’s en burgers, ter plaatse te eten of om mee te nemen. Ideaal voor een snelle en smakelijke pauze!"
    ],
    "es": [
      "A tiro de piedra de la pista de hielo, en pleno centro de la estación. Mountain Piz'Burg ofrece sabrosas pizzas y hamburguesas, para comer en el restaurante o para llevar. Ideal para una pausa gastronómica rápida y eficaz"
    ]
  },
  "rdfs:label": {
    "en": [
      "Mountain Piz'Burg Restaurant"
    ],
    "fr": [
      "Restaurant Mountain Piz'Burg"
    ],
    "nl": [
      "Restaurant Mountain Piz'Burg"
    ]
  },
