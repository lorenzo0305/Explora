  "rdfs:comment": {
    "de": [
      "Véronique Crud, die Chefin dieses Restaurants , bietet Ihnen hausgemachte Gerichte aus frischen, saisonalen und lokalen Produkten an. Am Wochenende gibt es hausgemachte Burger mit Pommes frites."
    ],
    "en": [
      "Véronique Crud, the restaurant's chef, offers homemade dishes made from fresh, seasonal and local produce. Home-fried burgers on weekends."
    ],
    "it": [
      "Véronique Crud, chef del ristorante, serve piatti fatti in casa con prodotti freschi, di stagione e locali. Hamburger fritti in casa nei fine settimana."
    ],
    "fr": [
      "Véronique Crud, la cheffe de ce restaurant , vous propose des plats faits maison à partir de produits frais, de saison et locaux,. Des burgers frites maison en fin de semaine."
    ],
    "nl": [
      "Véronique Crud, de chef-kok van het restaurant, serveert huisgemaakte gerechten van verse, seizoensgebonden en lokale producten. Huisgebakken hamburgers in het weekend."
    ],
    "es": [
      "Véronique Crud, chef del restaurante, sirve platos caseros elaborados con productos frescos, de temporada y locales. Hamburguesas caseras los fines de semana."
    ]
  },
