  "rdfs:comment": {
    "de": [
      "Wenn eine epische Jagd auf den weißen Wal aus Melvilles Roman Moby-Dick in einer Konzertfiktion aus orchestraler Brandung, Geräuschkulisse und atemloser Erzählung zum Leben erweckt wird."
    ],
    "en": [
      "The epic hunt for the white whale from Melville’s Moby-Dick comes to life in a concert-fiction fusing orchestral waves, sound effects, and gripping narration."
    ],
    "it": [
      "Quando un'epica caccia alla balena bianca, quella del romanzo di Melville Moby-Dick, prende vita in un concerto-fiction che combina esplosioni orchestrali, effetti sonori e una narrazione senza respiro."
    ],
    "fr": [
      "Quand une épique chasse à la baleine blanche, celle du roman Moby-Dick de Melville, prend vie dans un concert-fiction mêlant déferlement orchestral, bruitages et narration haletante."
    ],
    "nl": [
      "Wanneer een epische jacht op de witte walvis, de walvis uit Melville's roman Moby-Dick, tot leven komt in een concertfictie die orkestrale golven, geluidseffecten en ademloze vertellingen combineert."
    ],
    "es": [
      "La épica caza de la ballena blanca, la de la novela Moby-Dick de Melville, cobra vida en un concierto-ficción que combina arrebatos orquestales, efectos sonoros y una narración sin aliento."
    ]
  },
