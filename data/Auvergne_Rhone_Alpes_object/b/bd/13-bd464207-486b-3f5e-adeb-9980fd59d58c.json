  "rdfs:comment": {
    "de": [
      "Mit seinen 400 Hektar bietet dieses Gewässer den Liebhabern des Raubfischangelns zahlreiche Möglichkeiten, vom Ufer oder vom Boot aus. Es stehen 5 Sektoren für das Karpfenangeln ohne Abschuss bei Nacht zur Verfügung."
    ],
    "en": [
      "With its 400 hectares, this body of water offers predator fishing enthusiasts multiple possibilities, from the shore or by boat. 5 sectors are offered for no-kill night carp fishing."
    ],
    "it": [
      "Questo lago di 400 ettari offre numerose opportunità per i pescatori di carnivori, da riva o in barca. 5 settori sono disponibili per la pesca notturna no-kill alla carpa."
    ],
    "fr": [
      "Avec ses 400 hectares, ce plan d'eau offre aux amateurs de pêche aux carnassiers de multiples possibilités, du bord ou en bateau. 5 secteurs sont proposés pour la pêche de la carpe de nuit en no-kill."
    ],
    "es": [
      "Este lago de 400 hectáreas ofrece numerosas oportunidades a los pescadores de carnívoros, desde la orilla o en barco. Hay 5 sectores disponibles para la pesca nocturna sin muerte de la carpa."
    ],
    "nl": [
      "Dit meer van 400 hectare biedt volop mogelijkheden voor vleesetende vissers, vanaf de oever of per boot. Er zijn 5 sectoren beschikbaar voor het no-kill nachtvissen op karper."
    ]
  },
  "rdfs:label": {
    "de": [
      "Angelstelle - Lac des Fades-Besserve"
    ],
    "en": [
      "Fishing site - Lac des Fades-Besserve"
    ],
    "fr": [
      "Site de pêche - Lac des Fades-Besserve"
    ]
  },
