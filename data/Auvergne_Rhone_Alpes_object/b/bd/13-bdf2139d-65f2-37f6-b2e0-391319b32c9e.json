  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Auswahl des Betreibers, in dessen Weinkeller unzählige ausgezeichnete Crus von regionalen und anderen Erzeugern zu finden sind."
    ],
    "en": [
      "Try the manager's special selections, including a whole host of exceptional wines, with pride of place given to winemakers from the region and elsewhere."
    ],
    "it": [
      "Approfittate delle selezioni del gestore, la cui cantina è ricca di vini eccezionali, con i successi di produttori regionali e non."
    ],
    "fr": [
      "Profitez des sélections du gérant dont la cave à vins regorge de crus d'exception, mettant à l'honneur les réalisations des producteurs régionaux et d'autres."
    ],
    "nl": [
      "Profiteer van de selectie van de manager, wiens wijnkelder vol staat met uitzonderlijke wijnen, met de prestaties van regionale en andere producenten."
    ],
    "es": [
      "Aproveche las selecciones del gerente, cuya bodega está llena de vinos excepcionales, con los logros de los productores regionales y de otros países."
    ]
  },
