  "rdfs:comment": {
    "de": [
      "Mit Leidenschaft stellen wir jeden Tag unsere Rezepte in Handarbeit mit lokalen Rohstoffen her, bevor wir sie in Dosen abfüllen.  Besuchen Sie uns in unserem Laden und schauen Sie uns bei der Herstellung über die Schulter!"
    ],
    "en": [
      "Every day, we passionately prepare our recipes using local raw materials before canning them.  Come and visit us in our shop and see how we make them!"
    ],
    "it": [
      "Ogni giorno prepariamo con passione le nostre ricette utilizzando materie prime locali prima di inscatolarle.  Venite a trovarci nel nostro negozio per vedere come li realizziamo!"
    ],
    "fr": [
      "C'est avec passion que nous élaborons chaque jour nos recettes artisanalement avec des matières premières locales avant de les mettre en conserve.  Venez nous rendre visite dans notre boutique et observer notre fabrication !"
    ],
    "nl": [
      "Elke dag bereiden we met passie onze recepten met lokale grondstoffen voordat we deze inblikken.  Kom langs in onze winkel en zie hoe we ze maken !"
    ],
    "es": [
      "Cada día, preparamos con pasión nuestras recetas con materias primas locales antes de enlatarlas.  Venga a visitarnos a nuestra tienda y vea cómo los hacemos"
    ]
  },
