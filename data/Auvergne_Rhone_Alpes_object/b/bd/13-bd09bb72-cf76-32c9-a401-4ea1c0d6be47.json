  "rdfs:comment": {
    "de": [
      "In einem 40 ha großen Park, 15 Minuten von Aurillac, 25 Minuten vom Puy Mary und 1 Stunde von Salers entfernt, finden Sie Ruhe und Frieden, um sich zu erholen."
    ],
    "en": [
      "In 40 hectares of grounds, located at just a 15-minute drive from Aurillac, 25 minutes from Puy Mary and one hour from Salers, the Lac des Graves is the perfect place to come and relax and recharge your batteries."
    ],
    "it": [
      "In un parco di 40 ettari, a 15 minuti da Aurillac, 25 minuti da Puy Mary e 1 ora da Salers, troverete pace e tranquillità per ricaricarvi."
    ],
    "fr": [
      "Dans un parc de 40ha, à 15minutes d’Aurillac, 25 minutes du Puy Mary et 1h de Salers, vous trouverez calme et tranquillité pour vous ressourcer."
    ],
    "nl": [
      "In een park van 40 ha, op 15 minuten van Aurillac, 25 minuten van Puy Mary en 1 uur van Salers, vindt u rust en stilte om nieuwe energie op te doen."
    ],
    "es": [
      "En un parque de 40 hectáreas, a 15 minutos de Aurillac, 25 minutos de Puy Mary y 1 hora de Salers, encontrará paz y tranquilidad para recargar las pilas."
    ]
  },
