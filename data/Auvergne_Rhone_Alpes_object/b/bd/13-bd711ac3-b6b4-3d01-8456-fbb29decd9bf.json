  "rdfs:comment": {
    "de": [
      "Die Moulin Richard de Bas bietet Ihnen eine große Auswahl an Produkten, die aus der Papierproduktion des Standorts hergestellt werden. Sie können eine große Auswahl an Produkten rund um Papierwaren (Notizbücher, Karten, gedruckte Texte usw.) und andere Produkte finden."
    ],
    "en": [
      "The Richard de Bas Mill offers a wide range of products made with the site's paper production. You can find a wide variety of products around the stationery (notebook, cardboard, printed text, etc.) and other products."
    ],
    "it": [
      "Il Mulino Richard de Bas offre un'ampia gamma di prodotti realizzati con la produzione di carta del sito. Troverete un'ampia varietà di prodotti legati alla cancelleria (quaderni, biglietti, testi stampati, ecc.) e altri prodotti."
    ],
    "fr": [
      "Le Moulin Richard de Bas vous propose une large gamme de produits faits avec la production de papier du site. Vous pourrez retrouver une grande variété de produits autour de la papeterie (carnet, carterie, texte imprimé, etc.) et autres produits."
    ],
    "es": [
      "El molino Richard de Bas ofrece una amplia gama de productos elaborados con la producción de papel del lugar. Encontrará una gran variedad de productos relacionados con la papelería (cuadernos, tarjetas, textos impresos, etc.) y otros productos."
    ],
    "nl": [
      "De molen Richard de Bas biedt een breed scala aan producten die met de papierproductie van de site zijn gemaakt. U vindt er een grote verscheidenheid aan producten met betrekking tot kantoorbenodigdheden (notitieboekjes, kaarten, gedrukte teksten, enz.) en andere producten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La boutique du Moulin Richard de Bas"
    ]
  },
