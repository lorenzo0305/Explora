  "rdfs:comment": {
    "de": [
      "Es ist die Geschichte einer leidenschaftlichen Familie, die sorgfältig Weine, Biere und Spirituosen aus kleinen, unabhängigen Häusern auswählt. Kommen Sie zu unseren Verkostungen und Workshops in einem authentischen Weinkeller und genießen Sie einen geselligen Moment."
    ],
    "en": [
      "It's the story of a passionate family that carefully selects wines, beers and spirits from small independent houses. Come and share a convivial moment around our tastings and workshops in the heart of an authentic cellar."
    ],
    "it": [
      "È la storia di una famiglia appassionata che seleziona con cura vini, birre e liquori di piccole case indipendenti. Venite a godervi le nostre degustazioni e i nostri laboratori nel cuore di un'autentica cantina."
    ],
    "fr": [
      "C’est l’histoire d’une famille passionnée qui sélectionne avec soin vins, bières et spiritueux issus de petites maisons indépendantes. Venez partager un moment convivial autour de nos dégustations et ateliers au coeur d’une cave authentique."
    ],
    "nl": [
      "Het is het verhaal van een gepassioneerde familie die zorgvuldig wijnen, bieren en sterke dranken selecteert van kleine onafhankelijke huizen. Kom genieten van onze proeverijen en workshops in het hart van een authentieke kelder."
    ],
    "es": [
      "Es la historia de una familia apasionada que selecciona cuidadosamente vinos, cervezas y licores de pequeñas casas independientes. Venga a disfrutar de nuestras catas y talleres en el corazón de una auténtica bodega."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Cave Vins Marcon"
    ]
  },
