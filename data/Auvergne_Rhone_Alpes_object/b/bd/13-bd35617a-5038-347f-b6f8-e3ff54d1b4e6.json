  "rdfs:comment": {
    "de": [
      "Nach dem Eröffnungsabend folgen nun die beiden Termine für die Galas des Montlu Comedy Festivals!\r\n7 außergewöhnliche Künstler für jeden Galaabend!\r\n2 Stunden Lachen ohne Unterbrechungen, ein Erlebnis, das Sie nicht gleichgültig lassen wird!"
    ],
    "en": [
      "After the opening night, here are the two dates for the Montlu Comedy Festival galas!\r\n7 exceptional artists for each gala evening!\r\n2 hours of uninterrupted laughter, an experience that won't leave you indifferent!"
    ],
    "it": [
      "Dopo la serata inaugurale, ecco le due date dei galà del Montlu Comedy Festival!\r\n7 artisti d'eccezione per ogni serata di gala!\r\n2 ore di risate ininterrotte, un'esperienza che non vi lascerà indifferenti!"
    ],
    "fr": [
      "Après la soirée d'ouverture, voici les deux dates des galas du Montlu Comedy Festival ! \r\n7 artistes exceptionnels pour chaque soirée de gala ! \r\n2h de rires sans interruptions, une expérience qui ne vous laissera pas indifférents !"
    ],
    "es": [
      "Tras la noche inaugural, ¡aquí están las dos fechas de las galas del Montlu Comedy Festival!\r\n7 artistas excepcionales para cada noche de gala\r\n2 horas de risas ininterrumpidas, ¡una experiencia que no le dejará indiferente!"
    ],
    "nl": [
      "Na de openingsavond zijn hier de twee data voor de gala's van het Montlu Comedy Festival!\r\n7 uitzonderlijke artiesten voor elke gala-avond!\r\n2 uur ononderbroken lachen, een ervaring die je niet onverschillig zal laten!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Montlu Comedy Festival 2026 : Galas"
    ]
  },
