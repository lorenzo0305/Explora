  "rdfs:comment": {
    "de": [
      "An der Ankunft der Seilbahn. Ideal, um die Ruhe der Berge zu genießen, mit einer großen Auswahl à la carte. Beobachten Sie den Bartgeier von Ihrem Liegestuhl aus!"
    ],
    "en": [
      "At the top station of the aerial tram. The ideal restaurant to enjoy the peaceful calm of the mountains with a wide choice of dishes on the menu! Observe wild bearded vultures in flight from your deck chair"
    ],
    "it": [
      "All'arrivo della funivia. Ideale per godersi la pace e la tranquillità delle montagne, con una vasta gamma di scelte à la carte. Osservate il lammergeier dalla vostra sedia a sdraio!"
    ],
    "fr": [
      "À l’arrivée du téléphérique. Idéal pour profiter du calme de la montagne, avec un large choix à la carte. Observez le gypaète depuis votre transat !"
    ],
    "nl": [
      "Bij de aankomst van de kabelbaan. Ideaal om te genieten van de rust van de bergen, met een ruim aanbod à la carte. Kijk naar de lammergeier vanuit je ligstoel!"
    ],
    "es": [
      "A la llegada del teleférico. Ideal para aprovechar la calma de la sierra con una amplia oferta a la carta. ¡Observa al quebrantahuesos desde una tumbona!"
    ]
  },
  "rdfs:label": {
