  "rdfs:comment": {
    "de": [
      "In Morestel bietet das Tuk Tuk Thaï authentische thailändische Küche. Hausgemachte Gerichte aus frischen Produkten, die vor Ort von der Chefin Chanchaï mit 20 Jahren Erfahrung zubereitet werden."
    ],
    "en": [
      "In Morestel, Tuk Tuk Thaï offers authentic Thai cuisine. Home-cooked dishes prepared on site with fresh produce by chef Chanchaï, with 20 years' experience."
    ],
    "it": [
      "A Morestel, il Tuk Tuk Thaï serve un'autentica cucina thailandese. Piatti casalinghi preparati in loco con prodotti freschi dallo chef Chanchaï, che vanta 20 anni di esperienza."
    ],
    "fr": [
      "À Morestel, le Tuk Tuk Thaï propose une cuisine thaïlandaise authentique. Plats maison préparés sur place avec des produits frais, par la cheffe Chanchaï, forte de 20 ans d’expérience."
    ],
    "nl": [
      "In Morestel serveert Tuk Tuk Thaï authentieke Thaise gerechten. Huisgemaakte gerechten ter plaatse bereid met verse producten door chef-kok Chanchaï, die 20 jaar ervaring heeft."
    ],
    "es": [
      "En Morestel, Tuk Tuk Thaï sirve auténtica cocina tailandesa. Platos caseros preparados in situ con productos frescos por el chef Chanchaï, con 20 años de experiencia."
    ]
  },
