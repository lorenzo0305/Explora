  "rdfs:comment": {
    "de": [
      "In der Nähe von La Chaise-Dieu und Craponne-sur-Arzon und auf dem Jakobsweg empfängt Sie unser Hotel-Restaurant in einem ruhigen, modernen Rahmen und in einer geschützten Landschaft, umgeben von bemerkenswerten Sehenswürdigkeiten."
    ],
    "en": [
      "Close to La Chaise-Dieu and Craponne-sur-Arzon and on the Chemin Saint Jacques de Compostelle, our hotel-restaurant welcomes you to a quiet, modern setting in protected countryside, surrounded by remarkable sites."
    ],
    "it": [
      "Vicino a La Chaise-Dieu e Craponne-sur-Arzon e sul Cammino di Santiago de Compostela, il nostro hotel-ristorante vi accoglie in un ambiente tranquillo e moderno, in una campagna protetta e circondata da siti notevoli."
    ],
    "fr": [
      "A proximité de la Chaise-Dieu et de Craponne-sur-Arzon et sur le Chemin Saint Jacques de Compostelle, notre hôtel-restaurant vous accueille dans un cadre calme, moderne et dans une campagne protégée, entouré de sites remarquables."
    ],
    "nl": [
      "Dichtbij La Chaise-Dieu en Craponne-sur-Arzon en op de pelgrimsroute naar Santiago de Compostela, heet ons hotel-restaurant u welkom in een rustige, moderne omgeving in een beschermd landschap, omringd door opmerkelijke bezienswaardigheden."
    ],
    "es": [
      "Cerca de La Chaise-Dieu y Craponne-sur-Arzon y en el Camino de Santiago, nuestro hotel-restaurante le da la bienvenida en un entorno tranquilo y moderno en un campo protegido, rodeado de lugares notables."
    ]
  },
  "rdfs:label": {
    "fr": [
