  "rdfs:comment": {
    "de": [
      "Sie sind bei uns zu Hause. Ein Treffpunkt, an dem Sie essen und einen Aufenthalt in unseren Gästezimmern verbringen können; wir möchten Ihnen einen Moment des Teilens, der Geselligkeit und der Entschleunigung bieten."
    ],
    "en": [
      "Traditional and local cooking with local (some organic) and season products introduced by a family trio of a cook, a pastries chef and a sommelier."
    ],
    "it": [
      "Siete a casa vostra. Un luogo di incontro dove mangiare e soggiornare nelle nostre camere; vogliamo offrirvi un momento di condivisione, convivialità e relax."
    ],
    "fr": [
      "Vous êtes à la maison. Un lieu de rencontre pour vous restaurer et passer un séjour dans nos chambres d'hôtes ; nous voulons vous offrir un moment de partage, de convivialité et de décompression."
    ],
    "es": [
      "Usted está en su casa. Un lugar de encuentro donde comer y alojarse en nuestras habitaciones de huéspedes; queremos ofrecerle un momento de compartir, convivencia y relajación."
    ],
    "nl": [
      "Je bent thuis. Een ontmoetingsplaats waar je kunt eten en overnachten in onze gastenkamers; we willen je een moment van delen, gezelligheid en ontspanning bieden."
    ]
  },
