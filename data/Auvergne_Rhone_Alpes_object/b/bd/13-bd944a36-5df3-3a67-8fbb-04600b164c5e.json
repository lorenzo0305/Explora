  "rdfs:comment": {
    "de": [
      "Entdecken Sie Lokanta und probieren Sie seine Sandwiches, Tacos, Burger oder auch Gegrilltes in einem einladenden Raum.\r\nSie können auch den Take-away-Service in Anspruch nehmen."
    ],
    "en": [
      "Come and discover Lokanta and taste its sandwiches, tacos, burgers and grilled meats in a welcoming atmosphere.\r\nTakeaway service is also available."
    ],
    "it": [
      "Venite a scoprire Lokanta e provate i suoi panini, tacos, hamburger e carne alla griglia in un'atmosfera accogliente.\r\nPotete anche approfittare del servizio d'asporto."
    ],
    "fr": [
      "Venez découvrir Lokanta et goûtez à ses sandwiches, tacos, burgers ou encore grillades dans une salle accueillante.\r\nVous pourrez aussi profiter du service à emporter."
    ],
    "es": [
      "Ven a descubrir Lokanta y prueba sus bocadillos, tacos, hamburguesas y carnes a la parrilla en un ambiente acogedor.\r\nTambién puedes aprovechar el servicio de comida para llevar."
    ],
    "nl": [
      "Kom Lokanta ontdekken en probeer de broodjes, taco's, hamburgers en gegrild vlees in een gezellige sfeer.\r\nJe kunt ook gebruikmaken van de afhaalservice."
    ]
  },
