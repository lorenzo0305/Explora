  "rdfs:comment": {
    "de": [
      "Die Immobilienagentur Immo-Look ist in der Region Drôme Provençale Dieulefit und Umgebung auf typische Objekte des Typs :\r\nAnwesen, Herrenhäuser, Gästehäuser und Ferienwohnungen, Bauernhäuser aus Stein, Landhäuser."
    ],
    "en": [
      "The Immo-Look real estate agency specializes in the Drôme Provençale Dieulefit region and the surrounding area for property types such as :\r\nProperty, charming or manor houses, guest houses and gîtes, stone farmhouses, mas."
    ],
    "it": [
      "Specializzata nell'area della Drôme Provençale e più precisamente nei dintorni di Dieulefit per operazioni immobiliari quali: proprietà, case di charme, casali in pietra, case coloniche, case per ospiti, gîtes, case, edifici, appartamenti, ecc."
    ],
    "fr": [
      "Spécialisée sur le territoire Drôme Provençale et plus précisément autour de Dieulefit  pour des transactions de biens  du type : Propriété, demeure de charme, fermes en pierre, mas, maison d'hôtes, gîtes, maisons, immeubles, appartements, etc..."
    ],
    "nl": [
      "Het Immo-Look makelaarskantoor is gespecialiseerd in de Drôme Provençale Dieulefit regio en de omgeving voor vastgoedtypes zoals:\r\nOnroerend goed, charmante of herenhuizen, pensions en gîtes, stenen boerderijen, mas."
    ],
    "es": [
      "Especializado en la zona de Drôme Provençale y más concretamente en los alrededores de Dieulefit para transacciones inmobiliarias tales como: Propiedad, casas con encanto, masías de piedra, casas de campo, casas de huéspedes, casas rurales, casas, edificios, pisos, etc..."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Magali Terrot, mandataire immobilier du réseau SAFTI"
    ]
  },
