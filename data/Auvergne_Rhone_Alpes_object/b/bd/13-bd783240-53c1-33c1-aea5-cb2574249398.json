  "rdfs:comment": {
    "de": [
      "Pierre bietet eine semi-gastronomische Küche mit frischen, saisonalen Produkten, die vollständig hausgemacht sind!\r\nChloé, im Speisesaal, wird Sie durch eine Auswahl an Weinen aus dem Rhône-Tal führen, die mehr als 200 Referenzen umfasst."
    ],
    "en": [
      "Restaurant set in peaceful surroundings. The young chef serves up semi-gourmet dishes using fresh seasonal ingredients. The menu changes with the seasons."
    ],
    "it": [
      "Pierre propone una cucina semi-gastronomica con prodotti freschi e di stagione e interamente fatti in casa!\r\nChloé, nella sala da pranzo, vi guiderà attraverso una selezione di vini della Valle del Rodano, con oltre 200 referenze."
    ],
    "fr": [
      "Pierre propose une cuisine de type semi-gastronomique avec des produits frais et de saison et entièrement Fait Maison !\r\nChloé, en salle, sera vous guider parmi une sélection de vins de la Vallée du Rhône, comptant plus de 200 références."
    ],
    "nl": [
      "Pierre stelt een semi-gastronomische keuken voor met verse en seizoensgebonden producten en volledig huisgemaakt!\r\nIn de eetzaal leidt Chloé u door een selectie van wijnen uit het Rhônedal, met meer dan 200 referenties."
    ],
    "es": [
      "Pierre propone una cocina semigastronómica con productos frescos y de temporada, ¡y totalmente casera!\r\nChloé, en el comedor, le guiará a través de una selección de vinos del Valle del Ródano, con más de 200 referencias."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les 4 vents restaurant"
    ],
    "fr": [
      "Restaurant Epona"
    ]
  },
