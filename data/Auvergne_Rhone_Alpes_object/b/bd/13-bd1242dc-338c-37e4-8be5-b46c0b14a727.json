  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Beaujolais Vert durch ein spielerisches und kostenloses Geocaching-Erlebnis: eine Schatzsuche für die ganze Familie!\r\nAm Lac des Sapins begeben Sie sich auf die Jagd nach Sooshi, der über die Geschichte des Sees und des Wassers nicht im Unklaren ist."
    ],
    "en": [
      "Discover the Beaujolais Vert region through a free geocaching experience: a treasure hunt for the whole family!\r\nAt Lac des Sapins, go on a hunt for Sooshi, who knows all there is to know about the history of the lake and water."
    ],
    "it": [
      "Scoprite la regione del Beaujolais Vert attraverso un'esperienza di geocaching divertente e gratuita: una caccia al tesoro per tutta la famiglia!\r\nAl Lac des Sapins, andate a caccia di Sooshi, che sa tutto sulla storia del lago e dell'acqua."
    ],
    "fr": [
      "Découvrez le Beaujolais Vert à travers une expérience ludique et gratuite de géocaching : une chasse aux trésors à vivre en famille !\r\nAu Lac des Sapins, partez à la chasse de Sooshi, incollable sur l'histoire du lac et de l'eau."
    ],
    "nl": [
      "Ontdek de Beaujolais Vert via een leuke, gratis geocaching-ervaring: een schattenjacht voor het hele gezin!\r\nGa bij Lac des Sapins op zoek naar Sooshi, die alles weet over de geschiedenis van het meer en het water."
    ],
    "es": [
      "Descubra la región del Beaujolais Vert a través de una divertida experiencia gratuita de geocaching: ¡una búsqueda del tesoro para toda la familia!\r\nEn el lago des Sapins, busque a Sooshi, que lo sabe todo sobre la historia del lago y del agua."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Gnolus - Gare au coup de pompe !"
    ]
  },
