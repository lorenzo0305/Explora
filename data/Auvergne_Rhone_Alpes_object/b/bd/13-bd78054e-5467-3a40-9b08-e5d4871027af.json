  "rdfs:comment": {
    "de": [
      "Seit 1984 ist Vidéoformes eine ständige Beobachtungsstelle für die Entwicklungen der zeitgenössischen hybriden und digitalen Künste. Es bietet verschiedene Möglichkeiten der Präsentation, Produktion, Begegnung und Reflexion für Künstler, Profis und das Publikum."
    ],
    "en": [
      "Since 1984, Vidéoformes has been a permanent observatory of developments in contemporary hybrid and digital arts. It offers diverse opportunities for presentation, production, encounters and reflection for artists, professionals and the public."
    ],
    "it": [
      "Dal 1984, Vidéoformes è un osservatorio permanente sugli sviluppi delle arti contemporanee ibride e digitali. Offre una serie di opportunità di presentazione, produzione, incontro e riflessione per artisti, professionisti e pubblico in generale."
    ],
    "fr": [
      "Depuis 1984, Vidéoformes est un observatoire permanent des développements des arts contemporains hybrides et numériques. Il offre diverses possibilités de présentation, de production, de rencontres et de réflexion aux artistes, aux pros et au public."
    ],
    "nl": [
      "Sinds 1984 is Vidéoformes een permanent observatorium van ontwikkelingen in de hybride en digitale hedendaagse kunsten. Het biedt een scala aan mogelijkheden voor presentatie, productie, ontmoetingen en reflectie voor kunstenaars, professionals en het grote publiek."
    ],
    "es": [
      "Desde 1984, Vidéoformes es un observatorio permanente de la evolución de las artes contemporáneas híbridas y digitales. Ofrece un abanico de oportunidades de presentación, producción, encuentro y reflexión para artistas, profesionales y público en general."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Vidéoformes - 41ème Festival International d'Arts Hybrides et Numériques"
    ]
  },
