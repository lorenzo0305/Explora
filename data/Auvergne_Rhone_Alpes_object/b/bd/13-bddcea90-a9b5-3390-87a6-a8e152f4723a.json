  "rdfs:comment": {
    "de": [
      "Vom 24. Juni bis zum 22. August können Sie im Schloss Grignan die Faszination von Molières „Die Schule der Weiber“ unter der Regie von Robin Renucci erleben. Diese 39. Aufführung fällt mit einem historischen Ereignis zusammen: dem 400. Geburtstag von Madame de Sévigné."
    ],
    "en": [
      "From June 24 to August 22 at Grignan Castle, experience the thrill of Molière's The School for Wives, directed by Robin Renucci. This 39th edition coincides with a historic moment: the 400th anniversary of Madame de Sévigné's birth."
    ],
    "it": [
      "Dal 24 giugno al 22 agosto, al Castello di Grignan, emozione per L'École des Femmes di Molière, con la regia di Robin Renucci. Questa 39ª edizione dello spettacolo segna un'occasione storica: il quadricentenario della nascita di Madame de Sévigné."
    ],
    "fr": [
      "Du 24 juin au 22 août au château de Grignan, vibrez avec L’École des Femmes de Molière, mis en scène par Robin Renucci. Une 39e édition qui s’inscrit dans un moment historique : le quadricentenaire de la naissance de Madame de Sévigné."
    ],
    "nl": [
      "Van 24 juni tot 22 augustus in het Château de Grignan, sensatie voor L'École des Femmes van Molière, geregisseerd door Robin Renucci. Deze 39e editie van het stuk markeert een historische gebeurtenis: de vierhonderdste geboortedag van Madame de Sévigné."
    ],
    "es": [
      "Del 24 de junio al 22 de agosto en el castillo de Grignan, emociónese con L'École des Femmes de Molière, dirigida por Robin Renucci. Esta 39ª edición de la obra marca una ocasión histórica: el cuatricentenario del nacimiento de Madame de Sévigné."
    ]
  },
