  "rdfs:comment": {
    "de": [
      "Im Zentrum des mittelalterlichen Dorfes, in einer Bistro-Atmosphäre, bieten wir Ihnen eine marktfrische und regionale Küche. Entdecken Sie auch unsere Auswahl an Bio- und Naturweinen."
    ],
    "en": [
      "In the core of the medieval village, in a café atmosphere for the lunch and a cosy one for the evening, Véronique compose a French cuisine with local products of the market. Come discover also our organic and natural wines."
    ],
    "it": [
      "Nel centro del borgo medievale, in un'atmosfera da bistrot, proponiamo una cucina di mercato e locale. Venite a scoprire la nostra selezione di vini biologici e naturali."
    ],
    "fr": [
      "Au centre du village médiéval, dans une ambiance bistrot, nous vous proposons une cuisine de marché et du terroir. Venez également découvrir notre sélection de vins bio et naturel."
    ],
    "nl": [
      "In het centrum van het middeleeuwse dorp, in een bistrosfeer, bieden we markt- en streekgerechten. Kom en ontdek onze selectie biologische en natuurlijke wijnen."
    ],
    "es": [
      "En el centro del pueblo medieval, en un ambiente de bistró, ofrecemos cocina de mercado y local. Venga a descubrir nuestra selección de vinos ecológicos y naturales."
    ]
  },
  "rdfs:label": {
    "en": [
