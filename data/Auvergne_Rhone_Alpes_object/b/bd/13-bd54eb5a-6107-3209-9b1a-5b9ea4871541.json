  "rdfs:comment": {
    "de": [
      "Die Landwirtschaftskammer des Departements Drôme unterstützt die Landwirte des Departements in den Bereichen Beratung, Ausbildung und nachhaltige Entwicklung. Sie vertritt außerdem ihre Interessen gegenüber den Behörden und unterstützt die lokale landwirtschaftliche Innovation."
    ],
    "en": [
      "The Drôme Chamber of Agriculture supports the department's farmers with advice, training and sustainable development. It also represents their interests with public authorities and supports local agricultural innovation."
    ],
    "it": [
      "Agricoltori, autorità locali e attori locali, la Camera dell'Agricoltura della Drôme può aiutarvi a realizzare i vostri progetti. Insieme, possiamo costruire l'agricoltura di domani."
    ],
    "fr": [
      "Agriculteurs(trices), collectivités et acteurs du territoire, la Chambre d'agriculture de la Drôme vous accompagne dans vos projets. Ensemble, construisons l’agriculture de demain."
    ],
    "nl": [
      "De Landbouwkamer van de Drôme geeft advies, opleidingen en ondersteuning bij duurzame ontwikkeling aan de landbouwers van het departement. Ze vertegenwoordigt ook hun belangen bij de overheid en ondersteunt lokale landbouwinnovatie."
    ],
    "es": [
      "Agricultores, colectividades y agentes locales, la Cámara de Agricultura de Drôme puede ayudarle en sus proyectos. Juntos podemos construir la agricultura del mañana."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chambre d'agriculture de la Drôme"
    ]
  },
