  "rdfs:comment": {
    "de": [
      "Französische Küche, die von der Welt inspiriert ist. Einheimische Produkte, Bio-Produkte, Aromen, Farben, die der Jahreszeit folgen, und das alles mit strukturiertem und dynamisiertem Wasser."
    ],
    "en": [
      "French cuisine inspired by the world. Local, organic, flavors, colors, which follows the season, all worked with a structured and energized water. 75 wine references."
    ],
    "it": [
      "Cucina francese ispirata al mondo. Locale, biologica, saporita, colorata, che segue le stagioni, il tutto lavorato con acqua strutturata ed energizzata. Una cucina virtuosa e un'accoglienza calorosa. 75 referenze di vino."
    ],
    "fr": [
      "Cuisine française à l' inspiration du monde. Du local, du bio, des saveurs, de la couleur, en suivant les saisons, le tout travaillé avec une eau structurée et dynamisée. Un cuisine vertueuse et un accueil chaleureux. 75 références de vins."
    ],
    "nl": [
      "Franse keuken geïnspireerd door de wereld. Lokaal, biologisch, smaken, kleuren, die het seizoen volgen, allemaal bewerkt met een gestructureerd en energiek water. 75 wijnreferenties."
    ],
    "es": [
      "Cocina francesa inspirada en el mundo. Local, orgánica, sabrosa, colorida, siguiendo las estaciones, todo ello trabajado con agua estructurada y energizada. Una cocina virtuosa y una cálida acogida. 75 referencias de vino."
    ]
  },
