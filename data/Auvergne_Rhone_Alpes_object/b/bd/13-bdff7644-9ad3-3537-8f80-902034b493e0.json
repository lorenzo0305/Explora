      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/4e42232a-5d61-3004-a98c-fd0c3ff8600d",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Hochsaison: 7 Tage die Woche mittags und abends geöffnet.\r\nNebensaison: Sonntagabend und Donnerstagabend geschlossen (außer am 3. Donnerstag des Monats, an dem ein Abend mit Speisen und Wein stattfindet)\r\nFür Gruppen ist eine Reservierung erforderlich.\r\nWeitere Informationen und Veranstaltungspläne finden Sie auf unserer Website."
            ],
            "en": [
              "High season: open 7/7 for lunch and dinner.\r\nLow season: closed Sunday evening and Thursday evening (except food and wine evening on 3rd Thursday of the month)\r\nOpen on reservation for groups.\r\nMore details and schedule of events on our website."
            ],
            "it": [
              "Alta stagione: aperto 7/7 per pranzo e cena.\r\nBassa stagione: chiuso la domenica sera e il giovedì sera (tranne le serate enogastronomiche del 3° giovedì del mese)\r\nAperto su prenotazione per gruppi.\r\nMaggiori dettagli e calendario degli eventi sul nostro sito web."
            ],
            "fr": [
              "Haute saison : ouvert 7/7 midi et soir.\r\nBasse saison: fermé dimanche soir et jeudi soir ( sauf soirée mets et vins le 3ème jeudi du mois)\r\nOuvert sur réservation pour les groupes.\r\nPlus de détails et planning des évènements sur notre site internet."
            ],
            "es": [
              "Temporada alta: abierto 7/7 para almuerzos y cenas.\r\nTemporada baja: cerrado los domingos por la noche y los jueves por la noche (excepto las veladas gastronómicas del 3er jueves del mes)\r\nAbierto con reserva para grupos.\r\nMás detalles y calendario de eventos en nuestra página web."
            ],
            "nl": [
              "Hoogseizoen: 7 dagen per week geopend voor lunch en diner.\r\nLaagseizoen: zondagavond en donderdagavond gesloten (behalve eet- en wijnavonden op de 3e donderdag van de maand)\r\nOpen op reservering voor groepen.\r\nMeer informatie en een evenementenschema op onze website."
            ]
          },
