  "rdfs:comment": {
    "de": [
      "L'Assiette du jardin bietet Ihnen die Möglichkeit, die vor Ort zubereiteten Produkte des Bauernhofs zu probieren. Am Rande der Dolce Via, zwischen Les Ollières und St Sauveur de Montagut, erreichen Sie uns zu Fuß oder mit dem Fahrrad."
    ],
    "en": [
      "At L'Assiette du Jardin, enjoy fresh food grown and cooked on site. Situated next to the river, along the Dolce Via, in between Les Ollières and St Sauveur de Montagut, you can join us by bike or on foot."
    ],
    "it": [
      "L'Assiette du jardin offre la possibilità di degustare i prodotti della fattoria cucinati sul posto. Ai margini della Dolce Via, tra Les Ollières e St Sauveur de Montagut, raggiungeteci a piedi o in bicicletta."
    ],
    "fr": [
      "L'Assiette du jardin vous propose de déguster les productions de la ferme cuisinées sur place. Au bord de la Dolce Via, entre les Ollières et St Sauveur de Montagut, rejoignez-nous à pied ou à vélo."
    ],
    "es": [
      "L'Assiette du jardin le ofrece degustar los productos de la granja cocinados al momento. Al borde de la Dolce Via, entre Les Ollières y St Sauveur de Montagut, únase a nosotros a pie o en bicicleta."
    ],
    "nl": [
      "Bij L'Assiette du jardin kunt u de producten van de boerderij ter plaatse proeven. Aan de rand van de Dolce Via, tussen Les Ollières en St Sauveur de Montagut, kunt u ons te voet of met de fiets bereiken."
    ]
  },
