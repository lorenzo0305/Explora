  "rdfs:comment": {
    "de": [
      "In 1030 m Höhe, 2 km vom Skiort Chalmazel entfernt, stellen Marie Agnès und René Plagne den bäuerlichen Fourme de Montbrison (kontrollierte Herkunftsbezeichnung) her."
    ],
    "en": [
      "At an elevation of 1,030 metres, 2kms from the ski resort of Chalmazel, Marie Agnès and René Plagne make traditional PDO Fourme de Montbrison cheese."
    ],
    "it": [
      "A 1030 metri di altitudine, a 2 km dalla stazione sciistica di Chalmazel, Marie Agnès e René Plagne producono il formaggio di fattoria Fourme de Montbrison DOP con un know-how di 7 generazioni."
    ],
    "fr": [
      "A 1030 mètres d’altitude, à 2 kms de la station de ski de Chalmazel, Marie Agnès et René Plagne produisent de la fourme de Montbrison fermière AOP. avec un savoir-faire de 7 générations."
    ],
    "nl": [
      "Op 1030 meter hoogte, op 2 km van het skigebied van Chalmazel, produceren Marie Agnès en René Plagne met 7 generaties knowhow boerenkaas Fourme de Montbrison BOB."
    ],
    "es": [
      "A 1.030 metros de altitud, a 2 km de la estación de esquí de Chalmazel, Marie Agnès y René Plagne elaboran el queso de granja Fourme de Montbrison DOP con un saber hacer de 7 generaciones."
    ]
  },
