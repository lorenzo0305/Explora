  "rdfs:comment": {
    "de": [
      "Schneeschuhwanderungen für alle Niveaus, gesellige Atmosphäre, die auf Ihre Wünsche eingeht, Wälder und große verschneite Flächen mit Xavier, Bergführer"
    ],
    "en": [
      "Snowshoe outings and hikes for all levels in a convivial atmosphere. Xavier, your guide, makes every effort to meet your requirements, taking you through snow-covered forests and open spaces."
    ],
    "it": [
      "Escursioni con le racchette da neve e passeggiate per tutti i livelli, in un'atmosfera amichevole che ascolta i vostri desideri, in boschi e ampi spazi aperti coperti di neve con Xavier, guida alpina."
    ],
    "fr": [
      "Randonnées et balades raquettes tous niveaux, ambiance conviviale et à l'écoute de vos envies, forêts et grands espaces enneigés avec Xavier, accompagnateur en montagne."
    ],
    "nl": [
      "Wandelen en sneeuwschoenwandelen voor alle niveaus, in een vriendelijke sfeer die luistert naar wat je wilt, in bossen en open vlaktes bedekt met sneeuw met Xavier, berggids."
    ],
    "es": [
      "Caminatas con raquetas de nieve y paseos para todos los niveles, en un ambiente acogedor que escucha lo que quieres, en bosques y amplios espacios abiertos cubiertos de nieve con Xavier, guía de montaña."
    ]
  },
  "rdfs:label": {
    "de": [
      "Schneeschuhwanderungen - Bergpass"
    ],
    "en": [
      "Snowshoeing - Pass Montagne"
    ],
    "fr": [
      "Balades à raquettes - Pass Montagne"
    ],
    "nl": [
      "Wandelingen op sneeuwschoenen"
    ]
  },
