  "rdfs:comment": {
    "de": [
      "Das Café de la Page ist ein Ort der Geselligkeit, man kommt hierher, um einen Moment des Glücks zu teilen! Wir arbeiten mit Produzenten aus dem Trièves, das ist eine Verpflichtung!"
    ],
    "en": [
      "The Café de la Page is a place of conviviality, where people come to share a moment of happiness! We're committed to working with producers from the Trièves!"
    ],
    "it": [
      "Il Café de la Page è un luogo accogliente dove le persone vengono a condividere un momento di felicità! Lavoriamo con i produttori di Trièves, questo è il nostro impegno!"
    ],
    "fr": [
      "Le Café de la Page est un lieu de convivialité, on y vient pour partager un moment de bonheur! Nous travaillons avec les producteurs du Trièves, c’est un engagement!"
    ],
    "es": [
      "El Café de la Page es un lugar acogedor donde la gente viene a compartir un momento de felicidad Trabajamos con productores de las Trièves, ¡ese es nuestro compromiso!"
    ],
    "nl": [
      "Café de la Page is een gezellige plek waar mensen komen om een moment van geluk te delen! We werken met producenten uit de Trièves, dat is onze inzet!"
    ]
  },
