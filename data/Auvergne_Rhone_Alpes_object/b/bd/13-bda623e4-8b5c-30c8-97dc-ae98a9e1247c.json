  "rdfs:comment": {
    "de": [
      "Im Herzen von BistrÔboul' entdecken Sie Rest'haut und seinen talentierten und kreativen Chefkoch, der Ihnen jeden Mittag 1 Tagesmenü und mehrere Vorschläge anbietet."
    ],
    "en": [
      "In the heart of BistrÔboul', discover Rest'haut and its talented, creative chef, who offers 1 daily menu and several suggestions every lunchtime."
    ],
    "it": [
      "Nel cuore di BistrÔboul', scoprite Rest'haut e il suo chef talentuoso e creativo, che propone 1 menu del giorno e diverse proposte ogni ora di pranzo."
    ],
    "fr": [
      "Au cœur de BistrÔboul', découvrez Rest'haut et son chef talentueux et créatif, qui vous propose 1 menu du jour et plusieurs suggestions tous les midis."
    ],
    "nl": [
      "Ontdek in het hart van BistrÔboul' de Rest'haut en zijn getalenteerde en creatieve chef die u elke middag 1 menu van de dag en verschillende suggesties voorstelt."
    ],
    "es": [
      "En el corazón de BistrÔboul', descubra Rest'haut y a su talentoso y creativo chef, que propone 1 menú del día y varias sugerencias cada mediodía."
    ]
  },
  "rdfs:label": {
