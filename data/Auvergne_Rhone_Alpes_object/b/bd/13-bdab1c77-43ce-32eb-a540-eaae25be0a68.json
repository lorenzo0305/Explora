  "rdfs:comment": {
    "de": [
      "Die Mediathek befindet sich im Kultur- und Sportzentrum von Lans-en-Vercors, Le Cairn, in einem einzigen Block, das in mehrere Bereiche aufgeteilt ist: Jugend, Presse, Comics, Computerplätze mit Internetzugang...."
    ],
    "en": [
      "The media library is located inside Le Cairn, the Lans-en-Vercors cultural and sports centre, in a single volume divided into several areas: youth, press, comics, computer stations with internet access etc."
    ],
    "it": [
      "La mediateca si trova all'interno del centro culturale e sportivo di Lans-en-Vercors, Le Cairn, in un unico volume suddiviso in diverse aree: giovani, stampa, fumetti, postazioni informatiche con accesso a Internet...."
    ],
    "fr": [
      "La médiathèque se situe à l’intérieur du Centre culturel et sportif de Lans-en-Vercors, Le Cairn, dans un seul volume réparti en plusieurs espaces  : jeunesse, presse, bandes dessinées, postes informatiques offrant un accès à internet...."
    ],
    "es": [
      "La mediateca se encuentra en el centro cultural y deportivo de Lans-en-Vercors, Le Cairn, en un volumen único dividido en varios espacios: juventud, prensa, cómics, puestos informáticos con acceso a Internet...."
    ],
    "nl": [
      "De mediatheek bevindt zich in het cultureel en sportcentrum van Lans-en-Vercors, Le Cairn, in één volume dat verdeeld is in verschillende ruimtes: jeugd, pers, strips, computerstations met internettoegang...."
    ]
  },
