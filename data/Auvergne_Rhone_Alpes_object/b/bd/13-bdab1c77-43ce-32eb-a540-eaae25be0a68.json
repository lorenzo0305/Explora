      "schema:openingHoursSpecification": [
        {
          "@id": "https://data.datatourisme.fr/7bbfc0b7-0e73-3054-bb60-9b644dbd2ae3",
          "schema:validFrom": "2026-01-01T00:00:00",
          "schema:validThrough": "2026-12-31T23:59:59",
          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Die Öffnungszeiten \r\nDas ganze Jahr über außer an Feiertagen.\r\nDienstag und Freitag: 16h-19h\r\nMittwoch: 10h-12h und 14h-19h\r\nSamstag: 10:00-12:00 Uhr und 16:00-19:00 Uhr\r\nDer Donnerstag ist den Kindern gewidmet, die für außerschulische Aktivitäten im Freizeitzentrum von Lans angemeldet sind."
            ],
            "en": [
              "Opening hours \r\nAll year round except public holidays.\r\nTuesday and Friday: 4pm-7pm\r\nWednesday: 10am-12pm and 2pm-7pm\r\nSaturday: 10am-12pm and 4pm-7pm\r\nThursdays are dedicated to children enrolled in extracurricular activities at the Lans leisure centre."
            ],
            "it": [
              "Orari di apertura \r\nTutto l'anno, tranne i giorni festivi.\r\nMartedì e venerdì: 16.00-19.00\r\nMercoledì: 10.00-12.00 e 14.00-19.00\r\nSabato: 10.00-12.00 e 16.00-19.00\r\nIl giovedì è dedicato ai bambini iscritti alle attività extrascolastiche del centro ricreativo di Lans."
            ],
            "fr": [
              "Les horaires d'ouverture : \r\nToute l'année sauf jours fériés.\r\nMardi et vendredi : 16h-19h\r\nMercredi : 10h-12h et 14h-19h\r\nSamedi : 10h-12h et 16h-19h\r\nLe jeudi est consacré aux enfants inscrits en activité périscolaire au centre de loisirs de Lans."
            ],
            "nl": [
              "Openingstijden \r\nHet hele jaar door, behalve op feestdagen.\r\nDinsdag en vrijdag: 16.00-19.00 uur\r\nWoensdag: 10u-12u en 14u-19u\r\nZaterdag: 10u-12u en 16u-19u\r\nDe donderdag is bestemd voor kinderen die deelnemen aan buitenschoolse activiteiten in het recreatiecentrum van Lans."
            ],
            "es": [
              "Horario de apertura \r\nTodo el año, excepto los días festivos.\r\nMartes y viernes: de 16 a 19 horas\r\nMiércoles: 10:00-12:00 y 14:00-19:00\r\nSábado: 10:00-12:00 y 16:00-19:00\r\nLos jueves se dedican a los niños inscritos en actividades extraescolares en el centro de ocio de Lans."
            ]
          },
