  "rdfs:comment": {
    "de": [
      "Regionale und handwerklich hergestellte Lebensmittel: Weine, Biere, Käse, Wurstwaren u. v. m. Spezialisiert auf Crestoise defarde (ein lokales Gericht aus Kutteln und Innereien). Herzlicher Empfang und kompetente Beratung."
    ],
    "en": [
      "Regional and artisanal food products : wines, beers, cheeses, charcuterie, ... Specializing in Crestoise defarde (a local dish made with tripe and offal). Warm welcome and expert advice."
    ],
    "it": [
      "Gastronomia che offre un'ampia gamma di prodotti alimentari e artigianali regionali: vini, birre, formaggi, salumi, ecc. Specializzati in défarde Crestoise (piatto locale a base di trippa e frattaglie). Accoglienza calorosa e consigli di esperti."
    ],
    "fr": [
      "Épicerie fine proposant une large gamme de produits régionaux alimentaires et artisanaux : vins, bières, fromages, charcuterie, ... Spécialiste de la défarde Crestoise (plat local à base de tripes et abats). Accueil chaleureux et conseils avisés."
    ],
    "nl": [
      "Regionale en ambachtelijke voedingsproducten: wijnen, bieren, kazen, vleeswaren, enz. Gespecialiseerd in Crestoise defarde (een lokaal gerecht gemaakt met pens en ingewanden). Hartelijk welkom en deskundig advies."
    ],
    "es": [
      "Delicatessen que ofrece una amplia gama de productos alimenticios y artesanales regionales: vinos, cervezas, quesos, charcutería, etc. Especialistas en \"défarde Crestoise\" (plato local a base de callos y vísceras). Cálida acogida y consejos de expertos."
    ]
  },
