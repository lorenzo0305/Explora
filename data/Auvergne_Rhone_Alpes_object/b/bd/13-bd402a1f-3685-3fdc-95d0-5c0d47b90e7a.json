  "rdfs:comment": {
    "de": [
      "2 Orientierungsläufe in der Nähe des Nordic Walking-Gebiets Les Estables:\r\n- entdeckungsparcours vom Dorf aus in Richtung des Nordic-Walking-Bereichs, 4,1 km lang.\r\n-entdeckungsparcours am Anfang des nordischen Bereichs, grüne Strecke von 2 km."
    ],
    "en": [
      "2 orienteering courses located near the Les Estables Nordic area:\r\n- discovery trail from the village towards the Nordic area, 4.1 km long.\r\n-discovery trail starting from the Nordic area, 2 km green route."
    ],
    "it": [
      "2 percorsi di orientamento vicino all'area nordica di Les Estables:\r\n- percorso di scoperta dal villaggio verso l'area nordica, lungo 4,1 km.\r\n-percorso di scoperta a partire dall'area nordica, percorso verde di 2 km."
    ],
    "fr": [
      "2 parcours d'orientation se situant près du domaine nordique des Estables:\r\n- parcours découverte au départ du village en direction de la zone nordique; parcours long de 4,1 Km.\r\n-parcours découverte au départ du domaine nordique, parcourt vert de 2 Km."
    ],
    "es": [
      "2 senderos de orientación cerca de la zona nórdica de Les Estables:\r\n- sendero de descubrimiento desde el pueblo hacia la zona nórdica, de 4,1 km.\r\n-sendero de descubrimiento a partir de la zona nórdica, ruta verde de 2 km."
    ],
    "nl": [
      "2 oriëntatieroutes in de buurt van het Nordic gebied Les Estables:\r\n- ontdekkingstocht vanuit het dorp naar de Nordic area, 4,1 km lang.\r\n-ontdekkingsparcours vanaf de Nordic area, groene route van 2 km."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Course d'orientation -parcours domaine nordique"
    ]
  },
