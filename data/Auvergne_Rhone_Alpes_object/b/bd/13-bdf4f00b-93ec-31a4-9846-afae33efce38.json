  "rdfs:comment": {
    "de": [
      "Winzer seit mehreren Generationen an der berühmten Côte du Py. Verkostung DE Morgon und Unterkunft in einem mit 3 Ähren klassifizierten Ferienhaus und einem ungewöhnlichen Gästezimmer. Mitglieder der \"Vignerons Indépendants\" (Unabhängige Winzer)."
    ],
    "en": [
      "We have been winegrowers for several generations on the famous Côte du Py. We will make you taste our Morgon and we propose you an accommodation in a gîte classified 3 épis. We are a member of the \"Vignerons Indépendants\"."
    ],
    "it": [
      "Viticoltori da diverse generazioni nella famosa Côte du Py. Degustazione di DE Morgon e alloggio in un gîte 3 épis e in un insolito bed and breakfast. Membri dei Vignerons Indépendants."
    ],
    "fr": [
      "Viticulteurs depuis plusieurs générations sur la célèbre Côte du Py. Déguster DE Morgon et hébergement en gîte classé 3 épis et chambre d'hôtes insolite. Membres des Vignerons Indépendants."
    ],
    "es": [
      "Viticultores de varias generaciones en la famosa Côte du Py. Degustación de DE Morgon y alojamiento en una casa rural de 3 épis y bed and breakfast insólito. Miembros de Vignerons Indépendants."
    ],
    "nl": [
      "Al generaties lang wijnbouwers aan de beroemde Côte du Py. Proeverij van DE Morgon en overnachting in een 3 épis gîte en ongewone bed & breakfast. Leden van de Vignerons Indépendants."
    ]
  },
