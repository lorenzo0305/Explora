  "rdfs:comment": {
    "de": [
      "Ein Bistro mit Brasserie-Charakter auf einer Dachterrasse. Ein lebendiger und geselliger Ort, an dem sich alle treffen.\nEinfache, köstliche Produkte aus regionalem Bezug, mit einer schönen Pizzakarte"
    ],
    "en": [
      "A bistro with a brasserie vibe on a rooftop. A lively, welcoming place where everyone comes together.\nSimple, tasty, locally sourced products, with a great pizza menu."
    ],
    "it": [
      "Un bistrot dallo spirito brasserie su un rooftop. Un luogo di vita e convivialità dove tutti si ritrovano.\nProdotti semplici e gustosi a filiera corta, con una bella carta delle pizze"
    ],
    "fr": [
      "Un bistro à tendance brasserie en rooftop. Un lieu de vie et convivial ou tout le monde s'y retrouve.\nDes produits simples et gourmands en circuit court avec une belle carte de pizza."
    ],
    "es": [
      "Un bistró en la azotea con aire de brasserie. Un lugar de encuentro para todos.\nProductos sencillos, sabrosos y de corta duración y una gran carta de pizzas."
    ],
    "nl": [
      "Een bistro op het dak met de sfeer van een brasserie. Een gezellige plek waar iedereen elkaar kan ontmoeten.\nEenvoudige, smakelijke producten op korte termijn en een geweldig pizzamenu."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant La tour de contrôle"
    ]
  },
