  "rdfs:comment": {
    "de": [
      "Hugues und Jennifer züchten ihre Tiere auf einem Kalksteinplateau. Die Schweine werden im Freien geboren und aufgezogen. Ihr ganzes Leben lang werden sie mit einer Mischung aus einem Dutzend Getreidesorten gefüttert. Die Ochsen werden mit Gras und Heu aufgezogen."
    ],
    "en": [
      "Hugues and Jennifer raise their animals on a limestone plateau. Pigs are born and raised outdoors. Throughout their lives, they are fed a mixture of a dozen cereals. The cows are raised on grass and hay."
    ],
    "it": [
      "Hugues e Jennifer allevano i loro animali su un altopiano calcareo. I maiali nascono e vengono allevati all'aria aperta. Per tutta la loro vita vengono nutriti con una miscela di una dozzina di cereali. Le uova sono allevate con erba e fieno."
    ],
    "fr": [
      "Hugues et Jennifer élèvent leurs animaux sur un plateau calcaire. Les cochons naissent et sont élevés en plein air. Tout au long de leur vie, ils sont nourris avec un mélange d'une douzaine de céréales. Les bœufs sont élevés à l'herbe et au foin."
    ],
    "es": [
      "Hugues y Jennifer crían a sus animales en una meseta de piedra caliza. Los cerdos nacen y se crían al aire libre. Durante toda su vida, se alimentan con una mezcla de una docena de cereales. Los huevos se crían con hierba y heno."
    ],
    "nl": [
      "Hugues en Jennifer fokken hun dieren op een kalksteenplateau. De varkens worden in de open lucht geboren en grootgebracht. Hun hele leven lang krijgen ze een mix van een dozijn granen te eten. De eieren worden grootgebracht met gras en hooi."
    ]
  },
  "rdfs:label": {
    "en": [
      "Hugues and Jennifer's farm"
    ],
    "fr": [
      "La ferme d'Hugues et Jennifer"
    ]
  },
