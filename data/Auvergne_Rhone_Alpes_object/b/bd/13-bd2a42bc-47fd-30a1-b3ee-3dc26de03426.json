  "rdfs:comment": {
    "de": [
      "Lotto der amicale laïque von Pizancon.\r\nMit dem Erlös werden die Schulprojekte der Schule Marc Antoine et Rosalie Jullien in Pizancon finanziert."
    ],
    "en": [
      "Loto de l?amicale laïque de Pizancon.\r\nProceeds will help finance school projects at the Marc Antoine et Rosalie Jullien school in Pizancon."
    ],
    "it": [
      "Lotteria organizzata dall'Amicale laïque de Pizancon.\r\nIl ricavato andrà a finanziare i progetti scolastici della scuola Marc Antoine e Rosalie Jullien di Pizancon."
    ],
    "fr": [
      "Loto de l’amicale laïque de Pizancon.\r\nLes fonds récoltés permettront le financement des projets scolaires de l’école Marc Antoine et Rosalie Jullien de Pizancon."
    ],
    "es": [
      "Loto organizado por la Amicale laïque de Pizancon.\r\nLa recaudación se destinará a financiar proyectos escolares en la escuela Marc Antoine y Rosalie Jullien de Pizancon."
    ],
    "nl": [
      "Loto georganiseerd door de Amicale laïque de Pizancon.\r\nDe opbrengst gaat naar de financiering van schoolprojecten op de Marc Antoine en Rosalie Jullien school in Pizancon."
    ]
  },
