  "rdfs:comment": {
    "de": [
      "Bist du bereit für ein Abenteuer? Wählen Sie aus 6 Escape-Game-Räumen: Lösen Sie die Rätsel, nehmen Sie die Herausforderungen an und schlagen Sie die Uhr. Sie können nicht kommen? Unsere 9 Escape Rooms kommen zu Ihnen nach Hause! Verlängern Sie den Spaß an der Bar: Tischfußball, Billard, Flipper!"
    ],
    "en": [
      "Ready for adventure? Choose from 6 escape game rooms: solve puzzles, take on challenges and beat the clock. Can't make it? Our 9 escapes come to you! Extend the fun at the bar: foosball, billiards, pinball!"
    ],
    "it": [
      "Pronti per l'avventura? Scegliete tra 6 stanze di fuga: risolvete gli enigmi, affrontate le sfide e battete il tempo. Non riuscite a venire? Le nostre 9 escape room verranno da voi! Prolungate il divertimento al bar: calcio balilla, biliardo, flipper!"
    ],
    "fr": [
      "Prêt pour l’aventure ? Choisissez parmi 6 salles d’escape game : résolvez les énigmes, relevez les défis et battez le chrono. Impossible de venir ? Nos 9 escapes se déplacent chez vous ! Prolongez le fun au bar : baby-foot, billard, flipper !"
    ],
    "es": [
      "¿Listo para la aventura? Elija entre 6 salas de juegos de escape: resuelva los enigmas, afronte los retos y gane al reloj. ¿No puede venir? Nuestras 9 salas de escape vendrán a verte Amplíe la diversión en el bar: ¡fútbol de mesa, mesa de billar, máquina de pinball!"
    ],
    "nl": [
      "Klaar voor avontuur? Kies uit 6 escape game rooms: los de raadsels op, ga de uitdagingen aan en versla de klok. Kun je er niet bij zijn? Onze 9 escape rooms komen naar je toe! Verleng het plezier in de bar: tafelvoetbal, pooltafel, flipperkast!"
    ]
  },
