  "rdfs:comment": {
    "de": [
      "Der Sessellift von Charmasson befindet sich 200 m vom Ortseingang von Valfréjus entfernt und bietet Zugang zu mehreren Abfahrten von Mountainbike-Wegen."
    ],
    "en": [
      "The Charmasson Chairlift is located 200 m from the entrance to Valfréjus. From there, access to several mountain bike trail starts will be possible."
    ],
    "it": [
      "La seggiovia Charmasson si trova a 200 m dall'ingresso di Valfréjus. Da lì, sarà possibile l'accesso a diversi percorsi per mountain bike."
    ],
    "fr": [
      "Le Télésiège de Charmasson est situé à 200 m de l'entrée de Valfréjus et offre l'accès à plusieurs départs de sentiers VTT."
    ],
    "es": [
      "El telesilla Charmasson se encuentra a 200 m de la entrada de Valfréjus y da acceso a varias rutas de bicicleta de montaña."
    ],
    "nl": [
      "De Charmasson-stoeltjeslift ligt op 200 m van de ingang van Valfréjus en biedt toegang tot verschillende vertrektijden van mountainbikeroutes."
    ]
