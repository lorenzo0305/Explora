  "rdfs:comment": {
    "de": [
      "Die Schwestern bieten Ihnen Kunsthandwerk (z. B. Postkarten), Nähen und Stricken sowie Kerzen an, die das ganze Jahr über in Moûtier verkauft werden."
    ],
    "en": [
      "The sisters offer handicrafts (such as postcards), sewing and knitting, and candles for sale in Le Moûtier all year round."
    ],
    "it": [
      "A Le Moûtier le suore vendono tutto l'anno oggetti di artigianato (come cartoline), lavori di cucito e a maglia e candele."
    ],
    "fr": [
      "Les sœurs vous proposent un travail d'artisanat (tels que les cartes postales), de la couture et tricot, des bougies en vente au Moûtier toute l'année."
    ],
    "es": [
      "Las hermanas ofrecen artesanía (como postales), costura y punto, y velas a la venta en Le Moûtier durante todo el año."
    ],
    "nl": [
      "De zusters bieden het hele jaar door handwerk (zoals ansichtkaarten), naai- en breiwerk en kaarsen te koop aan in Le Moûtier."
    ]
  },
