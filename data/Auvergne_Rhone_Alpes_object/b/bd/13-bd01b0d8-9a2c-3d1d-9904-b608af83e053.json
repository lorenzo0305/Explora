  "rdfs:comment": {
    "de": [
      "Châtel Tourisme ist viel mehr als eine einfache Empfangs- und Informationsstelle: Es ist das lebendige und menschliche Eingangstor des Ortes, für Besucher wie für Einwohner."
    ],
    "en": [
      "Châtel Tourisme is much more than just a welcome and information point: it's the lively, human gateway to the resort, for visitors and locals alike."
    ],
    "it": [
      "Châtel Tourisme è molto più di un semplice punto di accoglienza e di informazione: è la porta d'accesso alla località, viva e pulsante, per i visitatori e i residenti."
    ],
    "fr": [
      "Châtel Tourisme, c'est bien plus qu'un simple point d'accueil  et d'information :  c'est la porte d'entrée vivante et humaine de la station, pour les visiteurs comme pour les habitants."
    ],
    "nl": [
      "Châtel Tourisme is veel meer dan alleen een receptie en informatiepunt: het is de levende, ademende toegangspoort tot het resort voor bezoekers en bewoners."
    ],
    "es": [
      "Châtel Tourisme es mucho más que un simple punto de recepción e información: es la puerta de entrada a la estación viva y palpitante, tanto para los visitantes como para los residentes."
    ]
  },
