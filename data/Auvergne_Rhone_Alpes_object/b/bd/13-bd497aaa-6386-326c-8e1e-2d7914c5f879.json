  "rdfs:comment": {
    "de": [
      "Familienbetrieb am Südhang des Brouilly-Hügels, 1956 von Michel Chevalier gegründet, 1987 von seinem Schwiegersohn und seiner Tochter Sylvain & Marie-Noëlle Métrat übernommen. 2023 setzt ihre Tochter Cyrielle das Abenteuer fort..."
    ],
    "en": [
      "A family business on the southern slopes of the Brouilly hill, founded in 1956 by Michel Chevalier, taken over in 1987 by his son-in-law and daughter Sylvain & Marie-Noëlle Métrat. In 2023, their daughter Cyrielle continues the adventure..."
    ],
    "it": [
      "Azienda familiare situata sulle pendici meridionali della collina di Brouilly, creata nel 1956 da Michel Chevalier, rilevata nel 1987 dal genero e dalla figlia Sylvain & Marie-Noëlle Métrat. nel 2023, la figlia Cyrielle continua l'avventura..."
    ],
    "fr": [
      "Exploitation familiale située sur le versant sud de la colline de Brouilly, créée en 1956 par Michel Chevalier, reprise en 1987 par son gendre et sa fille Sylvain & Marie-Noëlle Métrat. 2023, leur fille Cyrielle poursuit l'aventure..."
    ],
    "nl": [
      "Familiebedrijf gelegen op de zuidelijke hellingen van de heuvel van Brouilly, opgericht in 1956 door Michel Chevalier, in 1987 overgenomen door zijn schoonzoon en dochter Sylvain & Marie-Noëlle Métrat. in 2023 zet hun dochter Cyrielle het avontuur voort..."
    ],
    "es": [
      "Empresa familiar situada en la ladera sur de la colina de Brouilly, creada en 1956 por Michel Chevalier, adquirida en 1987 por su yerno y su hija Sylvain & Marie-Noëlle Métrat. en 2023, su hija Cyrielle continúa la aventura..."
    ]
  },
