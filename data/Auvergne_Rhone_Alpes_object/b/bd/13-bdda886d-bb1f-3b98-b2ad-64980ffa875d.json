  "rdfs:comment": {
    "de": [
      "Im Zentrum von Chambéry, nur wenige Schritte vom Kongresszentrum und den Fußgängerzonen entfernt, wird sich das Carré des Sens immer irgendwo auf Ihrem Weg befinden! Semi-gastronomische Küche und Menu retour du marché."
    ],
    "en": [
      "In the centre of Chambéry, a step or two away from the Congress Centre and the pedestrian areas, the Carré des Sens will always close at hand! Semi-gastronomic cuisine and seasonal market menu."
    ],
    "it": [
      "Nel pieno centro di Chambéry, a due passi dal Centro Congressi e dalle vie pedonali, il Carré des Sens sarà sempre sul vostro percorso! Cucina semi-gastronomica e menù di ritorno dal mercato."
    ],
    "fr": [
      "En plein centre de Chambéry, à deux pas du Centre des Congrès et des rues piétonnes, le Carré des Sens se trouvera toujours quelque part sur votre route ! Cuisine semi-gastronomique et Menu retour du marché."
    ],
    "nl": [
      "Midden in het centrum van Chambéry, op een steenworp afstand van het Congrescentrum en de voetgangersstraten, ligt het Carré des Sens altijd ergens op uw route! Semi-gastronomische keuken en marktretourmenu."
    ],
    "es": [
      "En pleno centro de Chambéry, a un paso del Centro de Congresos y de las calles peatonales, el Carré des Sens siempre estará en algún lugar de su ruta Cocina semigastronómica y menú de vuelta al mercado."
    ]
  },
  "rdfs:label": {
    "en": [
