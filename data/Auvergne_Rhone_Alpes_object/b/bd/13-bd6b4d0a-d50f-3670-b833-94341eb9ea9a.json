  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine spritzige und energiegeladene Komödie im Smart Cabaret in Brives-Charensac am 21. November um 20 Uhr, in der sich drei farbenfrohe Frauen in ein ebenso riskantes wie urkomisches Abenteuer stürzen."
    ],
    "en": [
      "Discover a sparkling, high-energy comedy at the Smart Cabaret in Brives-Charensac, November 21 at 8pm, where three colorful women embark on an adventure as risky as it is hilarious."
    ],
    "it": [
      "Scoprite una commedia frizzante e ad alto tasso di energia allo Smart Cabaret di Brives-Charensac il 21 novembre alle 20.00, dove tre donne colorate si imbarcano in un'avventura tanto rischiosa quanto esilarante."
    ],
    "fr": [
      "Découvrez une comédie pétillante et pleine d’énergie au Smart Cabaret de Brives-Charensac, le 21 novembre à 20h, où trois femmes hautes en couleur se lancent dans une aventure aussi risquée qu’hilarante."
    ],
    "nl": [
      "Ontdek een sprankelende, energieke komedie in het Smart Cabaret in Brives-Charensac op 21 november om 20.00 uur, waar drie kleurrijke vrouwen een even riskant als hilarisch avontuur aangaan."
    ],
    "es": [
      "Descubra una comedia chispeante y llena de energía en el Smart Cabaret de Brives-Charensac el 21 de noviembre a las 20:00 horas, donde tres mujeres pintorescas se embarcan en una aventura tan arriesgada como hilarante."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Comédie : Trois drôles de Blond€s"
    ]
  },
