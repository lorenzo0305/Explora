  "rdfs:comment": {
    "de": [
      "ARENA CITY bietet Ihnen unvergessliche Erlebnisse und entspannende Momente, die Sie mit Ihren Freunden oder Ihrer Familie erleben können!\r\nNeuer, einzigartiger Freizeitkomplex mit Bar, Laser Game, Karaoke, Escape Game und Axtwerfen!"
    ],
    "en": [
      "ARENA CITY offers you unforgettable experiences and relaxing moments to enjoy with friends or family!\r\nNew, unique leisure complex with Bar, Laser Game, Karaoke, Escape Game and Axe Throwing!"
    ],
    "it": [
      "ARENA CITY vi offre esperienze indimenticabili e momenti di relax da vivere con gli amici o la famiglia!\r\nUn nuovo complesso ricreativo unico nel suo genere con bar, laser game, karaoke, escape game e lancio dell'ascia!"
    ],
    "fr": [
      "ARENA CITY vous propose des expériences inoubliables et des moments détente à vivre avec vos amis ou en famille ! \r\nNouveau complexe de loisirs unique avec Bar, Laser Game, Karaoké, Escape Game et Lancer de Hache !"
    ],
    "es": [
      "ARENA CITY le ofrece experiencias inolvidables y momentos de relax para disfrutar con sus amigos o su familia\r\nUn nuevo y exclusivo complejo de ocio con bar, juego de láser, karaoke, juego de escape y lanzamiento de hachas"
    ],
    "nl": [
      "ARENA CITY biedt je onvergetelijke ervaringen en ontspannende momenten om van te genieten met je vrienden of familie!\r\nEen uniek nieuw vrijetijdscomplex met bar, lasergame, karaoke, ontsnappingsspel en bijlwerpen!"
    ]
  },
