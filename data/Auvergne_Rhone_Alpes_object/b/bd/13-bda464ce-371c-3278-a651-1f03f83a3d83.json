  "rdfs:comment": {
    "de": [
      "Englischer Pub in einem Chalet im Herzen von Plagne 1800. Wunderschöne Kulisse von Mine. Konzerte. Große Auswahl an Bieren, Cidres, Weinen, Cocktails, etc. Kostenloses WLAN, Sportübertragungen auf französischen und englischen Kanälen. Unbedingt entdecken!"
    ],
    "en": [
      "English pub located in a chalet in the heart of Plagne 1800. Fabulous mine-themed decor. Concerts. Wide selection of beers, wines, cocktails and ciders. Free Wi-Fi, sports broadcasts on French and English channels. An absolute must!"
    ],
    "it": [
      "Pub inglese situato in uno chalet nel cuore di Plagne 1800. Superba ambientazione della miniera. Musica dal vivo. Ampia scelta di birre, sidri, vini, cocktail, ecc... WiFi gratuito, trasmissioni sportive su canali francesi e inglesi. Da non perdere!"
    ],
    "fr": [
      "Pub anglais situé dans un chalet au cœur de Plagne 1800. Superbe décor de Mine. Concerts. Large choix de bières, cidres, vins, cocktails, etc... Wifi gratuit, retransmissions sportives sur chaînes françaises et anglaises. A découvrir absolument !"
    ],
    "es": [
      "Pub inglés situado en un chalet en el corazón de Plagne 1800. Magnífico entorno minero. Música en directo. Amplia selección de cervezas, sidras, vinos, cócteles, etc. WiFi gratuito, retransmisiones deportivas en canales franceses e ingleses. Una visita obligada"
    ],
    "nl": [
      "Engelse Pub in een chalet in hartje Plagne 1800. Prachtig mijndecor. Concerten. Ruim aanbod van bier, cider, wijnen, cocktails, enz... Gratis Wi-Fi, uitzending van sportevenementen op Franse en Engelse televisiezenders. Een bezoekje waard!"
    ]
  },
