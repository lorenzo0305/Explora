  "rdfs:comment": {
    "de": [
      "Entdecken Sie einen spielerischen Bereich, in dem Sie die Freuden des Wassers und des Nichtstuns miteinander verbinden können, umgeben von Bergen. Sie finden Picknicktische sowie ein Bar-Restaurant. Beaufsichtigtes Baden jeden Tag im Sommer von 12:30 bis 18:00 Uhr."
    ],
    "en": [
      "Discover a playful space where you can combine the pleasures of water and idleness, surrounded by mountains. Picnic tables and a bar-restaurant. Supervised swimming every day in summer from 12:30 to 18:00."
    ],
    "it": [
      "Scoprite un'area divertente dove potrete unire i piaceri dell'acqua e del relax, circondati dalle montagne. Sono presenti tavoli da picnic e un bar-ristorante. Nuoto sorvegliato tutti i giorni in estate dalle 12.30 alle 18.00."
    ],
    "fr": [
      "Découvrez un espace ludique où vous pourrez allier les plaisirs de l'eau et du farniente, entouré de montagnes. Vous trouverez des tables de pique-nique ainsi qu'un bar-restaurant. Baignade surveillée tous les jours de l'été de 12h30 à 18h."
    ],
    "nl": [
      "Ontdek een leuk gebied waar je het plezier van water en ontspanning kunt combineren, omgeven door bergen. Er zijn picknicktafels en een bar-restaurant. Zwemmen onder toezicht elke dag in de zomer van 12.30 tot 18.00 uur."
    ],
    "es": [
      "Descubra una zona de diversión donde podrá combinar los placeres del agua y la relajación, rodeado de montañas. Hay mesas de picnic y un bar-restaurante. Natación vigilada todos los días en verano de 12.30 a 18 h."
    ]
  },
