  "rdfs:comment": {
    "de": [
      "Dieser Klettersteig stellt sich als sportliche Herausforderung dar: athletisch, lang und luftig, ist er ideal oder um die vertikale Welt zu entdecken oder als Einführung in den Alpinismus. Sensationen und eine Landschaft 100 % Oisans!"
    ],
    "en": [
      "This via ferrata is a sporting challenge: athletic, long and aerial, it's ideal for discovering the vertical world or as an introduction to mountaineering. Sensations and scenery 100% Oisans!"
    ],
    "it": [
      "Questa via ferrata è una sfida sportiva: atletica, lunga e aerea, è ideale per scoprire il mondo verticale o come introduzione all'alpinismo. Un'esperienza 100% Oisans!"
    ],
    "fr": [
      "Cette via ferrata se présente comme un défi sportif : athlétique, longue et aérienne, elle est idéale ou pour découvrir l’univers vertical ou comme introduction à l'alpinisme. Des sensations et un paysage 100 % Oisans !"
    ],
    "es": [
      "Esta vía ferrata es un desafío deportivo: atlética, larga y aérea, es ideal para descubrir el mundo vertical o como iniciación al alpinismo. ¡Una experiencia 100% de Oisans!"
    ],
    "nl": [
      "Deze klettersteig is een sportieve uitdaging: atletisch, lang en luchtig, ideaal om de verticale wereld te ontdekken of als kennismaking met bergbeklimmen. Een 100% Oisans ervaring!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Via Ferrata  \"Le Voile de la Mariée\""
    ],
    "fr": [
      "Via Ferrata  \"Le Voile de la Mariée\""
    ],
    "nl": [
      "Via Ferrata \"Le Voile de la Mariée\""
    ]
  },
