  "rdfs:comment": {
    "de": [
      "Le Room ist das 1. Escape Game in Morzine. 60 Minuten Live-Abenteuer! Ihr Team hat eine Stunde Zeit, um die Herausforderungen zu lösen, die Mission erfolgreich abzuschließen und zu fliehen."
    ],
    "en": [
      "Morzine’s first Escape Room experience, Le ROOM is a live 60-minute adventure. Your team has an hour to solve the challenges, complete the mission and escape."
    ],
    "it": [
      "The Room è il primo gioco di fuga a Morzine. 60 minuti di avventura dal vivo! La squadra ha un'ora di tempo per risolvere le sfide, completare la missione e fuggire."
    ],
    "fr": [
      "Le Room est le 1er escape game à Morzine. 60 minutes d’aventure en live ! Votre équipe a une heure pour résoudre les défis, réussir la mission et s'échapper."
    ],
    "nl": [
      "The Room is het 1e ontsnappingsspel in Morzine. 60 minuten live avontuur! Je team heeft een uur om de uitdagingen op te lossen, de missie te voltooien en te ontsnappen."
    ],
    "es": [
      "The Room es el primer juego de escape en Morzine. ¡60 minutos de aventura en vivo! Tu equipo tiene una hora para resolver los retos, completar la misión y escapar."
    ]
  },
