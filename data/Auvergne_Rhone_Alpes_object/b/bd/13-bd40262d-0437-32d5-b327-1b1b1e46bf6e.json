  "rdfs:comment": {
    "de": [
      "La Vouivre: Auch keine Angst! Lux bietet eine poetische Vision, die auf sanfte Weise dazu einlädt, die Höhle der Dunkelheit, ihre vielfältigen Gesichter und im Gegensatz dazu das Geheimnis der funkelnden Kämme des Lichts zu erforschen."
    ],
    "en": [
      "La Vouivre: Don't be afraid! Lux offers a poetic vision, gently inviting us to explore the lair of darkness, its many faces, and by contrast, the mystery of the sparkling crests of light."
    ],
    "it": [
      "La Vouivre : Nemmeno la paura! Lux offre una visione poetica, un invito gentile a esplorare la tana dell'oscurità, le sue molteplici facce e, per contrasto, il mistero delle scintillanti creste di luce."
    ],
    "fr": [
      "La Vouivre : Même pas peur ! Lux propose un vision poétique, qui invite avec douceur, à explorer l'antre de l'obscurité, ses visages multiples et par opposition, le mystère des crêtes étincelantes de la lumière."
    ],
    "es": [
      "La Vouivre : ¡Ni siquiera miedo! Lux ofrece una visión poética, una suave invitación a explorar la guarida de la oscuridad, sus múltiples caras y, por contraste, el misterio de las crestas centelleantes de luz."
    ],
    "nl": [
      "La Vouivre : Zelfs niet bang! Lux biedt een poëtische visie, een zachte uitnodiging om het hol van de duisternis, haar vele gezichten en, in contrast daarmee, het mysterie van de sprankelende randen van het licht te verkennen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Danse - Lux ou la petite fille qui avait peur du blanc"
    ]
  },
