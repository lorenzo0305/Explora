  "rdfs:comment": {
    "de": [
      "Das Festkomitee von Saint Marcel les Sauzet stellt mehr als 25 spielerische Holzspiele für Erwachsene und Kinder mit professioneller Begleitung und ein Dutzend aufblasbarer Kinderstrukturen auf. Spiele für alle, für die Kleinen und die Älteren."
    ],
    "en": [
      "The Comité des fêtes de Saint Marcel les Sauzet is setting up more than 25 wooden games for adults and children, accompanied by professionals, and a dozen inflatables for children. Games for everyone, young and old."
    ],
    "it": [
      "Il Comitato delle feste di Saint Marcel les Sauzet organizza più di 25 giochi in legno per adulti e bambini, accompagnati da professionisti, e una dozzina di strutture gonfiabili per bambini. Giochi per tutti, per grandi e piccini."
    ],
    "fr": [
      "Le Comité des fêtes de Saint Marcel les Sauzet met en place plus de 25 jeux ludiques en bois pour adultes et enfants avec accompagnement de professionnels et d'une dizaine de structure gonflables pour enfants. Jeux pour tous, pour les petits et ainés."
    ],
    "nl": [
      "Het feestcomité van Saint Marcel les Sauzet organiseert meer dan 25 leuke houten spellen voor volwassenen en kinderen, met de hulp van professionals en een dozijn opblaasbare structuren voor kinderen. Spelletjes voor iedereen, voor jong en oud."
    ],
    "es": [
      "El Comité des fêtes de Saint Marcel les Sauzet organiza más de 25 juegos de madera para adultos y niños, acompañados por profesionales, así como una decena de estructuras hinchables para niños. Juegos para todos, para grandes y pequeños."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Animation autour des jeux: \"Faites vos jeux!\""
    ]
  },
