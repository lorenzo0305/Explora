  "rdfs:comment": {
    "de": [
      "Traditionelle kalte und traditionelle Seifenfabrik im Herzen von Combrailles. Manufakturwerkstatt und Shop, Geschenkideen, Führungen, Einführungsworkshops. Naturkosmetik, vegan, Gastdesigner."
    ],
    "en": [
      "Traditional soap factory/shop in the heart of Combrailles. Manufacturing workshop and shop, gift ideas, guided tours, introductory workshops. Natural cosmetics, vegan, guest designers."
    ],
    "it": [
      "Produzione tradizionale di sapone a freddo nel cuore della regione di Combrailles.\r\nLaboratorio e negozio, idee regalo, visite guidate, laboratori introduttivi e avanzati per adulti e bambini. Cosmetici naturali e vegani, designer ospiti."
    ],
    "fr": [
      "Savonnerie artisanale à froid, à l'ancienne au cœur des Combrailles.\r\nAtelier de fabrication et boutique, idées cadeaux, visites commentées, ateliers initiation et perfectionnement adultes/enfants. Cosmétique naturelle, végane, artisans créateurs invités."
    ],
    "nl": [
      "Geheel met de hand gemaakte zeep."
    ],
    "es": [
      "Fabricación tradicional de jabón en frío en el corazón de la región de Combrailles.\r\nTaller y tienda, ideas para regalos, visitas guiadas, talleres de iniciación y perfeccionamiento para adultos y niños. Cosmética natural y vegana, diseñadores invitados."
    ]
  },
  "rdfs:label": {
