  "rdfs:comment": {
    "de": [
      "Seit 18 Jahren verarbeitet Karen die wertvolle Milch ihrer Eselinnen zu wunderschönen handgefertigten Seifen. Lernen Sie ihren Bauernhof, ihre Tiere und insbesondere ihre Eselinnen in Tence kennen!"
    ],
    "en": [
      "For 18 years, Karen has been transforming the precious milk of her donkeys into magnificent handmade soaps. Come and meet her farm, her animals and especially her donkeys in Tence!"
    ],
    "it": [
      "Da 18 anni, Karen trasforma il prezioso latte delle sue asine in magnifici saponi fatti a mano. Venite a conoscere la sua fattoria, i suoi animali e soprattutto i suoi asini a Tence!"
    ],
    "fr": [
      "Depuis 18 ans, Karen transforme le précieux lait de ses ânesses en de magnifiques savons artisanaux. Partez à la rencontre de sa ferme, de ses animaux et notamment de ses ânesses à Tence !"
    ],
    "es": [
      "Desde hace 18 años, Karen transforma la preciosa leche de sus burras en magníficos jabones artesanales. ¡Ven a conocer su granja, sus animales y sus burras en Tence!"
    ],
    "nl": [
      "Al 18 jaar lang verwerkt Karen de kostbare melk van haar ezels tot prachtige handgemaakte zepen. Kom kennismaken met haar boerderij, haar dieren en vooral haar ezels in Tence!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Savonnerie du Velay"
    ]
  },
