  "rdfs:comment": {
    "de": [
      "Willkommen im Ponton de l'Embarcadère! Zwischen dem Hafen und dem Strand von Saint-Jorioz gelegen, bieten wir eine Reihe von Wassersportaktivitäten an, die ideal für alle sind, die Entspannung und Nervenkitzel suchen."
    ],
    "en": [
      "Welcome to the Ponton de l'Embarcadère! Situated between the port and the beach of Saint-Jorioz, we offer a range of water sports activities ideal for all lovers of relaxation and thrills."
    ],
    "it": [
      "Benvenuti al Ponton de l'Embarcadère! Situato tra il porto e la spiaggia di Saint-Jorioz, offre una serie di attività sportive acquatiche ideali per chi è alla ricerca di relax e divertimento."
    ],
    "fr": [
      "Bienvenue au Ponton de l'Embarcadère ! Situé entre le port et la plage de Saint-Jorioz, nous proposons une gamme d'activités nautiques idéales pour tous les amateurs de détente et de sensations."
    ],
    "es": [
      "¡Bienvenido al Ponton de l'Embarcadère! Situado entre el puerto y la playa de Saint-Jorioz, ofrecemos una amplia gama de actividades náuticas ideales para todos aquellos que buscan relajación y emoción."
    ],
    "nl": [
      "Welkom bij Ponton de l'Embarcadère! Gelegen tussen de haven en het strand van Saint-Jorioz, bieden wij een scala aan watersportactiviteiten, ideaal voor iedereen die op zoek is naar ontspanning en spanning."
    ]
  },
