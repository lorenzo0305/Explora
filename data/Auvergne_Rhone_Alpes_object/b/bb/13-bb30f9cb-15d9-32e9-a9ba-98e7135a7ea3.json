  "rdfs:comment": {
    "de": [
      "Im La Table de L'Alpaga, einem Restaurant mit einem Michelin-Stern, nimmt Sie der Chefkoch mit auf einen gastronomischen und savoyischen Spaziergang, der sich je nach Ernte und Jahreszeit entwickelt. Eine Küche von großer Finesse, sensibel und inspiriert."
    ],
    "en": [
      "At La Table de L'Alpaga, a Michelin 1-star restaurant, Chef takes you on a gastronomic journey through Savoy, evolving with the harvests and seasons. A cuisine of great finesse, sensitivity, and inspiration."
    ],
    "it": [
      "Al ristorante La Table de L'Alpaga, insignito di una stella Michelin, lo chef vi accompagna in un viaggio gastronomico alla scoperta della Savoia, che evolve al ritmo dei raccolti e delle stagioni. Una cucina raffinata, sensibile e ispirata."
    ],
    "fr": [
      "À La Table de L'Alpaga, restaurant 1 étoile Michelin, le Chef vous entraîne dans une balade gastronomique et savoyarde, évoluant au fil des cueillettes et des saisons. Une cuisine d'une grande finesse, sensible et inspirée."
    ],
    "nl": [
      "In La Table de L'Alpaga, een 1-sterren Michelin-restaurant, neemt de chef u mee op een gastronomische en Savoyaardse reis die met de seizoenen mee evolueert. Een keuken met veel finesse, gevoeligheid en inspiratie."
    ],
    "es": [
      "En La Table de L'Alpaga, restaurante 1 estrella Michelin, el Chef le lleva a un viaje gastronómico y saboyano, que evoluciona con las estaciones. Una cocina de gran finura, sensibilidad e inspiración."
    ]
  },
