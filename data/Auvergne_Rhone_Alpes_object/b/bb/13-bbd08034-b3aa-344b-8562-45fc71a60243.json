  "rdfs:comment": {
    "de": [
      "An zwei Tagen in der Woche finden Sie hier einen freien und kostenlosen Internetzugang! Das Multimediazentrum bietet auch Schulungen an, damit Sie alles über die Geheimnisse des Computers verstehen."
    ],
    "en": [
      "Internet access open to all and free-of-charge. Programme for computer courses and training on request."
    ],
    "it": [
      "Due giorni alla settimana troverete l'accesso gratuito a Internet! Il centro multimediale offre anche corsi di formazione per aiutarvi a comprendere i misteri del computer."
    ],
    "fr": [
      "Vous trouverez deux jours par semaine un accès internet libre et gratuit ! Le centre multimédia propose aussi des formations, afin de tout comprendre des mystères de l'informatique."
    ],
    "nl": [
      "Twee dagen per week is er gratis internet! Het multimediacentrum biedt ook opleidingen aan om u de geheimen van de computer te helpen begrijpen."
    ],
    "es": [
      "Dos días a la semana encontrará acceso gratuito a Internet El centro multimedia también ofrece cursos de formación para ayudarle a comprender los misterios de la informática."
    ]
  },
