  "rdfs:comment": {
    "de": [
      "TATUM Cristal ist ein auf Mineralien spezialisiertes Unternehmen mit zwei Geschäften in Frankreich. Wir bieten eine große Auswahl an Natursteinen, Schmuck aus der Lithotherapie, maßgeschneiderte Kreationen, gemmologische Analysen und außergewöhnliche Edelsteine."
    ],
    "en": [
      "TATUM Cristal is a company specialized in the world of minerals, with two boutiques in France. We offer a wide selection of natural stones, lithotherapy jewelry, custom creations, gemological analysis and exceptional gemstones."
    ],
    "it": [
      "TATUM Cristal è un'azienda specializzata nel mondo dei minerali, con due negozi in Francia. Offriamo un'ampia gamma di pietre naturali, gioielli per litoterapia, creazioni su misura, analisi gemmologiche e gemme eccezionali."
    ],
    "fr": [
      "TATUM Cristal est une société spécialisée dans l’univers des minéraux avec deux boutiques en France. Nous proposons un large choix de pierres naturelles, bijoux en lithothérapie, créations sur mesure, analyses gemmologiques et pierres gemmes d’exception."
    ],
    "nl": [
      "TATUM Cristal is een bedrijf gespecialiseerd in de wereld van mineralen, met twee winkels in Frankrijk. Wij bieden een breed assortiment natuurstenen, lithosieraden, creaties op maat, gemmologische analyses en uitzonderlijke edelstenen."
    ],
    "es": [
      "TATUM Cristal es una empresa especializada en el mundo de los minerales, con dos tiendas en Francia. Ofrecemos una amplia gama de piedras naturales, joyas de litoterapia, creaciones a medida, análisis gemológicos y piedras preciosas excepcionales."
    ]
  },
