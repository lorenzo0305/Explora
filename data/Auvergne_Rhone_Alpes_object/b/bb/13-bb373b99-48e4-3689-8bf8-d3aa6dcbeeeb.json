  "rdfs:comment": {
    "de": [
      "Der Mouna ist ein Einsteigercanyon. Mit wenig Wasser und kleinen Hindernissen (kleine Sprünge, kleine Rutschen) ist dieser Canyon für schwindelfreie Kinder geeignet (Abseilen aus 20 m Höhe)."
    ],
    "en": [
      "The Mouna is an introductory canyon. With little water and small obstacles (small jumps, small slides), this canyon is ideal for children who are not afraid of heights (20 m abseil)."
    ],
    "it": [
      "Il Mouna è un canyon introduttivo. Con poca acqua e piccoli ostacoli (piccoli salti, piccoli scivoli), questo canyon è adatto ai bambini che non hanno paura dell'altezza (discesa in corda doppia da 20 m)."
    ],
    "fr": [
      "Le Mouna est un canyon d’initiation. Peu aquatique et avec des obstacles de taille réduite (petits sauts, petits toboggans), ce canyon est adapté à la pratique avec des enfants qui n’ont pas le vertige (rappel de 20 m)."
    ],
    "es": [
      "El Mouna es un cañón introductorio. Con poca agua y pequeños obstáculos (pequeños saltos, pequeños toboganes), este cañón es adecuado para los niños que no tienen miedo a las alturas (rappel desde 20 m)."
    ],
    "nl": [
      "De Mouna is een inwijdingskloof. Met weinig water en kleine hindernissen (kleine sprongen, kleine glijbanen) is deze canyon geschikt voor kinderen die geen hoogtevrees hebben (20m abseilen)."
    ]
  },
  "rdfs:label": {
    "en": [
      "Mouna Canyon"
    ],
    "fr": [
      "Canyon de la Mouna"
    ]
  },
