  "rdfs:comment": {
    "de": [
      "Unser gemütliches Bistro empfängt Sie mit einer traditionellen, saisonalen Küche, lokalen Produkten und guten Weinen. Kommen Sie und verbringen Sie schöne Momente! Spezialität: Frischer Frosch mit Petersilie und Rinderbirne mit St.-Marcellin-Creme."
    ],
    "en": [
      "We welcome you to our warm, gourmet bistro, where you can enjoy traditional seasonal cuisine, local produce and fine wines. Our pleasure is to make you spend good moments."
    ],
    "it": [
      "Il nostro accogliente bistrot gourmet propone una cucina tradizionale di stagione, prodotti locali e vini pregiati. Venite a divertirvi! Specialità: rana fresca con prezzemolo e pera di manzo con crema di San Marcellino."
    ],
    "fr": [
      "Notre bistrot chaleureux et gourmand, vous accueille autour d’une cuisine traditionnelle de saison, de produits locaux et de bons vins. Venez passer de bons moments! Spécialité : grenouille fraîche persillées et poire de boeuf à la crème saint-marcellin."
    ],
    "nl": [
      "Onze warme, gastronomische bistro serveert traditionele seizoensgerechten, lokale producten en heerlijke wijnen. Kom gezellig langs! Specialiteit: verse kikker met peterselie en peer van rundvlees met Saint Marcellin crème."
    ],
    "es": [
      "Nuestro cálido bistró gastronómico sirve cocina tradicional de temporada, productos locales y vinos de calidad. ¡Venga a divertirse! Especialidad: rana fresca con perejil y pera de ternera con crema de San Marcelino."
    ]
  },
  "rdfs:label": {
    "en": [
      "Bistrot Lu'Lu"
    ],
    "fr": [
      "Bistrot Lu'Lu"
    ]
  },
