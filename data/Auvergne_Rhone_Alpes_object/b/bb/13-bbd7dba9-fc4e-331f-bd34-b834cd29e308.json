  "rdfs:comment": {
    "de": [
      "Eine Woche lang lässt sich die Lyoner Oper mit der Einrichtung des Opernwagens und dem Stück Le Sang du glacier (Das Blut des Gletschers) im Herzen des Dorfes Saint-Gervais nieder."
    ],
    "en": [
      "For a week, the Opéra de Lyon sets up in the heart of the village of Saint-Gervais with the opera truck and the play Le Sang du glacier."
    ],
    "it": [
      "Per una settimana, l'Opéra de Lyon si installa nel cuore del villaggio di Saint-Gervais con il suo camion dell'opera e lo spettacolo Le Sang du glacier."
    ],
    "fr": [
      "Pendant une semaine, l'Opéra de Lyon s'installe au coeur du village de Saint-Gervais avec le dispositif du camion-opéra et la pièce Le Sang du glacier."
    ],
    "nl": [
      "Een week lang vestigt de Opéra de Lyon zich in het hart van het dorp Saint-Gervais met zijn operawagen en het toneelstuk Le Sang du glacier."
    ],
    "es": [
      "Durante una semana, la Ópera de Lyon se instala en el corazón del pueblo de Saint-Gervais con su camión-ópera y la obra Le Sang du glacier."
    ]
  },
  "rdfs:label": {
