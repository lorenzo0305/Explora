  "rdfs:comment": {
    "de": [
      "Künstlerin, Illustratorin und Siebdruckerin Florie entwirft und druckt originelle Siebdrucke, Schreibwaren, Textilien und andere Objekte in Kleinserien. Ihr Lokal im Zentrum von Les Vans beherbergt einen Kollektivladen für Kunsthandwerk und Drucke."
    ],
    "en": [
      "La Vitrine Flow is a screen printing workshop installed in Les Vans.\r\nArtist, illustrator and serigraph, Florie draws is printed original silkscreens, paper stationery and other items, textiles  and other screen-printed objects, always in small series.\r\nSince 2020, La Vitrine Flow has also been a collective shop for fine crafts and prints. Ceramics, lighting, prints, jewelry, furniture, accessories, stationery, cosmetics: creations of local craftsmen mainly and also from elsewhere."
    ],
    "it": [
      "Artista, illustratore e serigrafo, Florie progetta e stampa serigrafie originali, articoli di cancelleria, tessuti e altri oggetti in piccole serie. I suoi locali nel centro di Les Vans ospitano un laboratorio collettivo di artigianato e stampa."
    ],
    "fr": [
      "Artiste, illustratrice et sérigraphe Florie dessine et imprime des sérigraphies originales, de la papeterie, du textile et autres objets en petite série. Son local au centre des Vans accueille une boutique collective de métiers d’art et d’estampes."
    ],
    "es": [
      "La artista, ilustradora y serigrafista Florie diseña e imprime serigrafías originales, artículos de papelería, textiles y otros objetos en pequeñas series. Su local en el centro de Les Vans alberga una tienda de artesanía e imprenta colectiva."
    ],
    "nl": [
      "Kunstenaar, illustrator en zeefdrukker Florie ontwerpt en drukt originele zeefdrukken, briefpapier, textiel en andere objecten in kleine series. Haar pand in het centrum van Les Vans herbergt een collectieve ambachts- en drukkerij."
    ]
  },
