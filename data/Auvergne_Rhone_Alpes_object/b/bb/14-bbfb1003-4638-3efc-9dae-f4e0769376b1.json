      "dc:description": {
        "de": [
          "Concert d'Astrée\nBach im Trio\nUm 20 Uhr in der Kirche Notre Dame des Sables (Pl. de l'Eglise)\nEintrittskarten sind im Fremdenverkehrsamt von Berck und im Museum Opale Sud erhältlich\nVoller Preis: 12?\nErmäßigter Tarif: 10?\norganisiert von der Kulturabteilung, Infos unter +33 (0)3 21 89 90 15"
        ],
        "en": [
          "Concert d?Astrée\nBach in trio\n8pm at Eglise Notre Dame des Sables (Pl. de l'Eglise)\nTickets on sale at Berck Tourist Office and Musée Opale Sud\nFull price: 12?\nReduced 10?\norganized by Service Culture, info on +33 (0)3 21 89 90 15"
        ],
        "it": [
          "Concerto d'orchestra\nBach in trio\nOre 20.00 presso l'Eglise Notre Dame des Sables (Pl. de l'Eglise)\nBiglietti in vendita presso l'Ufficio del Turismo di Berck e il Musée Opale Sud\nPrezzo intero: 12 euro\nRidotto: 10 euro?\norganizzato dall'Assessorato alla Cultura, info al +33 (0)3 21 89 90 15"
        ],
        "fr": [
          "Concert d’Astrée\nBach en trio\nÀ 20h à l’Eglise Notre Dame des Sables (Pl. de l’Eglise)\nBilletterie en vente à l'Office de tourisme de Berck et au Musée Opale Sud\nTarif plein : 12€\nTarif réduit 10€\norganisé par le service culture, infos au +33 (0)3 21 89 90 15"
        ],
        "es": [
          "Concierto de cuerda\nBach en trío\n20:00 h en la Eglise Notre Dame des Sables (Pl. de l'Eglise)\nVenta de entradas en la Oficina de Turismo de Berck y en el Musée Opale Sud\nPrecio completo: 12?\nTarifa reducida: 10?\norganizado por el departamento de cultura, información en el +33 (0)3 21 89 90 15"
        ],
        "nl": [
          "Concert d'Astrée\nBach in trio\n20u in de Eglise Notre Dame des Sables (Pl. de l'Eglise)\nKaartjes te koop bij het toeristenbureau van Berck en het Musée Opale Sud\nVolle prijs: €12\nKorting: 10?\ngeorganiseerd door de dienst cultuur, info op +33 (0)3 21 89 90 15"
        ]
      },
