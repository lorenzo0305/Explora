  "rdfs:comment": {
    "de": [
      "In Les 2 Alpes finden die französischen Ben?J-Meisterschaften statt. Die besten französischen Rider der Kategorie U14 werden auf technisch anspruchsvollen Strecken gegeneinander antreten und ihre Beherrschung, ihre Geschwindigkeit und ihren Wettkampfgeist unter Beweis stellen"
    ],
    "en": [
      "Les 2 Alpes is hosting the French Ben’J Championships. The best French U14 riders will compete on technical and demanding courses, showcasing their skill, speed, and competitive spirit."
    ],
    "it": [
      "Les 2 Alpes ospita i Campionati Francesi Ben’J. Durante questo evento, i migliori rider francesi della categoria U14 si sfideranno su percorsi tecnici e impegnativi, dimostrando la loro abilità, velocità e spirito competitivo."
    ],
    "fr": [
      "Les 2 Alpes accueillent les Championnat de France Ben’J. Les meilleurs riders français de la catégorie U14 s’affronteront sur des parcours techniques et exigeants, démontrant leur maîtrise, leur vitesse et leur esprit de compétition"
    ],
    "nl": [
      "Les 2 Alpes organiseert de Ben?J Franse kampioenschappen. De beste Franse ruiters in de U14-categorie gaan de strijd aan op technische en veeleisende parcoursen en tonen hun beheersing, snelheid en competitieve instelling"
    ],
    "es": [
      "Les 2 Alpes acoge los Campeonatos de Francia Ben?J. Los mejores pilotos franceses de la categoría sub-14 competirán en recorridos técnicos y exigentes, demostrando su dominio, velocidad y espíritu competitivo"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ben'J Championnats de France U14"
    ]
  },
