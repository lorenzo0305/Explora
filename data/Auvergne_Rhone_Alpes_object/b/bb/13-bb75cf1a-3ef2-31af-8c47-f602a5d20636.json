  "rdfs:comment": {
    "de": [
      "Willkommen im Restaurant Ô Soleil, einem Bergrestaurant, das täglich (nur im Winter) zum Frühstück und Abendessen geöffnet ist. Der Küchenchef serviert Ihnen eine französische Küche mit vielen Spezialitäten aus Savoyen und lokalen Produkten."
    ],
    "en": [
      "Welcome to Ô Soleil restaurant, a mountain restaurant that is open every day (only in the winter season) for breakfast and dinner. The chef proposes French cuisine with many Savoyard specialities and local products."
    ],
    "it": [
      "Benvenuti al ristorante Ô Soleil, un ristorante di montagna aperto tutti i giorni (solo in inverno) per colazione e cena. Lo chef propone una cucina francese con molte specialità savoiarde e prodotti locali."
    ],
    "fr": [
      "Bienvenue au restaurant Ô Soleil, un restaurant de montagne ouvert tous les jours (en hiver seulement) pour le petit-déjeuner et le dîner. Le chef vous proposera une cuisine française avec de nombreuses spécialités savoyardes et des produits locaux."
    ],
    "nl": [
      "Welkom bij restaurant Ô Soleil, een bergrestaurant dat dagelijks open is (uitsluitend 's winters), voor ontbijt en diner. De kok biedt een Franse keuken met diverse specialiteiten uit de Savoie en streekproducten."
    ],
    "es": [
      "Bienvenido al restaurante Ô Soleil, un restaurante de montaña abierto todos los días (sólo en invierno) para el desayuno y la cena. El chef ofrece cocina francesa con muchas especialidades de Saboya y productos locales."
    ]
  },
