  "rdfs:comment": {
    "de": [
      "Bei Léontine wird Ihnen eine Küche aus vergangenen Zeiten und eine große Auswahl an Fondues geboten, die vor Ihren Augen zubereitet werden, um Ihren Gaumen zu erfreuen... und Ihre Augen!"
    ],
    "en": [
      "At Léontine's, we offer traditional cuisine and a wide selection of fondues cooked right in front of you to delight your taste buds... and your eyes!"
    ],
    "it": [
      "Da Léontine troverete una cucina d'altri tempi e un'ampia scelta di fondute cucinate davanti a voi per deliziare le vostre papille gustative... e i vostri occhi!"
    ],
    "fr": [
      "Chez Léontine, on vous propose une cuisine d'autrefois et une large sélection de fondues cuisinées devant vous pour ravir vos papilles... et vos yeux !"
    ],
    "es": [
      "En Léontine's, encontrará una cocina a la antigua usanza y una amplia selección de fondues cocinadas delante de usted para deleite de sus papilas gustativas... ¡y de sus ojos!"
    ],
    "nl": [
      "Bij Léontine's vind je een ouderwetse keuken en een ruime keuze aan fondues die voor je neus worden bereid om je smaakpapillen te strelen... en je ogen!"
    ]
  },
