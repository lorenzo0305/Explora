  "rdfs:comment": {
    "de": [
      "Im Sommer wie im Winter gibt es im Centre Montagnard Cap Guéry viel zu entdecken und zu erleben. Unser Team wird Ihnen seine besten Tipps geben, damit Sie diesen einzigartigen Ort im hohen Norden voll und ganz genießen können!"
    ],
    "en": [
      "Summer and winter alike, the Centre Montagnard Cap Guéry is full of activities and discoveries. Our team will share with you its best advice to take full advantage of this unique site in Great North mode!"
    ],
    "it": [
      "Sia d'estate che d'inverno, il Centro montano di Cap Guéry è ricco di attività e scoperte. Il nostro team condividerà con voi i suoi migliori consigli per sfruttare al meglio questo sito unico in modalità Nord!"
    ],
    "fr": [
      "Été comme hiver, le Centre Montagnard Cap Guéry regorge d’activités et de découvertes. Notre équipe vous partagera ses meilleurs conseils pour profiter pleinement de ce site unique en mode Grand Nord !"
    ],
    "nl": [
      "Zowel in de zomer als in de winter is het Cap Guéry Mountain Centre vol activiteiten en ontdekkingen. Ons team zal zijn beste advies met u delen om optimaal van deze unieke site te genieten in ware North-modus!"
    ],
    "es": [
      "Tanto en verano como en invierno, el Centro de Montaña de Cap Guéry está lleno de actividades y descubrimientos. ¡Nuestro equipo compartirá con usted sus mejores consejos para aprovechar al máximo este sitio único en auténtico modo Norte!"
    ]
  },
  "rdfs:label": {
    "fr": [
