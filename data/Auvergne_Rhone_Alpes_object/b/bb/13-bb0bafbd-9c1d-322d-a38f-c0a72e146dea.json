  "rdfs:comment": {
    "de": [
      "Keramik, Raku, Porzellan, Steingut, Schmuck, gedrechseltes Holz\r\nOrganisiert Raku-Workshops. Direktverkauf nach Vereinbarung.\r\nCreaterra Ceramiques ist Teil der Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "en": [
      "Ceramics, raku, porcelain, stoneware, jewellery, turned wood\r\nOrganizes raku courses. Direct sales by appointment.\r\nCreaterra Ceramiques is part of the Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "it": [
      "Ceramica, raku, porcellana, grès, gioielli, legno tornito\r\nOrganizza corsi di raku. Vendita diretta su appuntamento.\r\nCreaterra Ceramiques fa parte della Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "fr": [
      "Céramiques, raku, porcelaine, grès, bijoux, bois tourné\r\nOrganise des stages de raku. Vente directe sur rendez-vous.\r\nCreaterra Ceramiques fait partie de la Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "nl": [
      "Keramiek, raku, porselein, steengoed, juwelen, gedraaid hout\r\nOrganiseert raku cursussen. Directe verkoop op afspraak.\r\nCreaterra Ceramiques maakt deel uit van de Route Terroir et Savoir-Faire du Haut-Chablais."
    ],
    "es": [
      "Cerámica, rakú, porcelana, gres, joyería, madera torneada\r\nOrganiza cursos de rakú. Venta directa con cita previa.\r\nCreaterra Ceramiques forma parte de la Route Terroir et Savoir-Faire du Haut-Chablais."
    ]
  },
