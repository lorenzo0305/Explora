  "rdfs:comment": {
    "de": [
      "Ich biete Ihnen im Direktverkauf ab Hof biologische und regionale Produkte an: Einkorn: Mehl, Nudeln, Lavandinöl, Eier, Nektar und Konfitüre aus Aprikosen und Kirschen, Oliven, Olivenöl, Tapenade. Auf dem Bauernmarkt in Montbrun vertreten."
    ],
    "en": [
      "I propose direct sales of organic and local products at the farm every afternoon: einkorn wheat, lavender essential oil, eggs, apricots and cherries jams and nectars, olives, olive oil and tapenade."
    ],
    "it": [
      "Vendo direttamente dalla fattoria, prodotti biologici e locali: piccolo farro: farina, pasta, olio di lavanda, uova, nettari e marmellate di albicocche e ciliegie, olive, olio d'oliva, tapenade. Presente al mercato agricolo di Montbrun"
    ],
    "fr": [
      "Je vous propose en vente directe à la ferme, des produits bio et du terroir : petit épeautre: farine, pâtes, HE de lavandin, œufs, nectars et confitures d'abricots et cerises, olives, huile d'olives, tapenade. Présent au marché des producteurs de Montbrun"
    ],
    "es": [
      "Vendo directamente de la granja, productos orgánicos y locales: pequeña espelta: harina, pasta, aceite de lavanda, huevos, néctares y mermeladas de albaricoques y cerezas, aceitunas, aceite de oliva, tapenade. Presente en el mercado agrícola de Montbrun"
    ],
    "nl": [
      "Ik bied u in directe verkoop bij de boerderij, alle namiddagen biologische streekproducten: spelt, bloem, deegwaren, etherische lavandinolie, eieren, nectar en abrikozen- en kersenjam, olijven, olijfolie en tapenade."
    ]
  },
