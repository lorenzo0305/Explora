  "rdfs:comment": {
    "de": [
      "Plastic Boum Boum bringt seltsame Dinge auf die Bühne: schwatzende Bauklötze, einen großen blauen Kanister, der funktioniert, riesige magische Rohre, eine gefährliche Säge, Plastikkisten, die lärmende Schätze verbergen?"
    ],
    "en": [
      "Plastic Boum Boum brings strange things to the stage: chattering building blocks, a big blue walking can, giant magic pipes, a dangerous all-purpose saw, plastic crates that hide noisy treasures?"
    ],
    "it": [
      "Plastic Boum Boum porta in scena cose strane: blocchi da costruzione che chiacchierano, una grande lattina blu che cammina, tubi magici giganti, una pericolosa sega multiuso, casse di plastica che nascondono tesori rumorosi?"
    ],
    "fr": [
      "Plastic Boum Boum convoque au plateau des choses étranges : des plots de chantier qui bavardent, un gros bidon bleu qui marche, des tuyaux magiques géants, une dangereuse scie passe-partout, des caisses en plastique qui cachent de bruyants trésors…"
    ],
    "es": [
      "Plastic Boum Boum trae cosas extrañas al escenario: bloques de construcción parlanchines, una gran lata azul para caminar, tuberías mágicas gigantes, una peligrosa sierra multiusos, cajas de plástico que esconden ruidosos tesoros.."
    ],
    "nl": [
      "Plastic Boum Boum brengt vreemde dingen op het toneel: kletsende bouwstenen, een groot blauw wandelblik, reusachtige magische pijpen, een gevaarlijke alleszaag, plastic kratten die luidruchtige schatten verbergen?"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Plastic Boum Boum"
    ]
  },
