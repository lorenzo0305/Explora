  "rdfs:comment": {
    "de": [
      "Die Lehrerin, Sylvie Annequin, ist Therapeutin und Instruktorin für Achtsamkeitsmeditation. Sie wurde von der Academy for Mindfull Teaching ausgebildet, die von Eline Snel in den Niederlanden gegründet wurde."
    ],
    "en": [
      "The teacher, Sylvie Annequin, Therapist and Full Consciousness Meditation Instructor, was trained by the Academy for Mindfull Teaching, created by Eline Snel in the Netherlands."
    ],
    "it": [
      "L'insegnante, Sylvie Annequin, terapeuta e istruttrice di meditazione mindfulness, è stata formata dall'Academy for Mindfull Teaching, creata da Eline Snel nei Paesi Bassi."
    ],
    "fr": [
      "La professeur, Sylvie Annequin, Thérapeute et Instructrice en Méditation Pleine Présence- Pleine Conscience, a été formée par l'Academy for Mindfull Teaching, crée par Eline Snel aux Pays Bas."
    ],
    "es": [
      "La profesora, Sylvie Annequin, terapeuta e instructora de meditación de atención plena, ha sido formada por la Academy for Mindfull Teaching, creada por Eline Snel en los Países Bajos."
    ],
    "nl": [
      "De docente, Sylvie Annequin, therapeute en instructrice in Mindfulness Meditatie, is opgeleid door de Academie voor Mindfull Teaching, opgericht door Eline Snel in Nederland."
