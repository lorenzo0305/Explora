  "rdfs:comment": {
    "de": [
      "Dieser Wettbewerb, der von der ESF für über 14-Jährige mit mindestens dem Chamois d'argent ins Leben gerufen wurde, ermöglicht es den esf-Schülerinnen und -Schülern, sich auf nationaler Ebene zu messen."
    ],
    "en": [
      "Created by the ESF for those over 14 who hold at least the Chamois d'argent, this competition enables ESF students to compete on a national scale."
    ],
    "it": [
      "Creato dall'ESF per coloro che hanno compiuto 14 anni e che sono in possesso almeno del Chamois d'argent, questo concorso permette agli studenti dell'ESF di competere su scala nazionale."
    ],
    "fr": [
      "Créée par l'ESF pour les plus de 14 ans titulaires au minimum du Chamois d’argent, cette compétition permet aux élèves esf de se mesurer à l’échelle nationale."
    ],
    "nl": [
      "Deze competitie is opgezet door de ESF voor leerlingen van 14 jaar en ouder die ten minste de Chamois d'argent hebben en stelt ESF-studenten in staat om te concurreren op nationaal niveau."
    ],
    "es": [
      "Creado por el FSE para los mayores de 14 años que posean al menos la Gamuza de Plata, este concurso permite a los estudiantes del FSE competir a escala nacional."
    ]
  },
  "rdfs:label": {
