  "rdfs:comment": {
    "de": [
      "Im Massif des Bauges, an der Kreuzung von Wanderwegen, genießen Sie den Ort bei einer Mahlzeit, einem Getränk oder einem Aperitif auf 1250 m Höhe!"
    ],
    "en": [
      "In the Massif des Bauges, at the crossroads of hiking trails, come and enjoy the place around a meal, a drink, or an aperitif, at 1250 meters of altitude!"
    ],
    "it": [
      "Nel Massiccio dei Bauges, al crocevia dei sentieri escursionistici, venite a godervi il posto per un pasto, un drink o un aperitivo, a 1250 metri di altitudine!"
    ],
    "fr": [
      "Dans le Massif des Bauges, à la croisée des chemins de randonnées, venez profiter du lieu autour d'un repas, d'une boisson, ou d'un apéro, à 1250 mètres d'altitude !"
    ],
    "nl": [
      "In het Massif des Bauges, op het kruispunt van wandelpaden, kunt u op 1250 meter hoogte genieten van een maaltijd, een drankje of een aperitief!"
    ],
    "es": [
      "En el Macizo de Bauges, en el cruce de rutas de senderismo, venga a disfrutar del lugar con una comida, una copa o un aperitivo, ¡a 1.250 metros de altitud!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Petite restauration à la ferme du Morbier"
    ]
  },
