  "rdfs:comment": {
    "de": [
      "Gegenüber dem Park von Uriage bietet Ihnen das Team von Le Carillon seine Pizzakarte, seine Tagesgerichte und seine abwechslungsreichen Salate an: Im Herzen des Ortes mit Blick auf die Berge und seiner Terrasse im Sommer.\r\nPizzas vor Ort und zum Mitnehmen."
    ],
    "en": [
      "Opposite the Uriage Park, the Carillon team offers you its pizza menu, daily specials and various salads: In the heart of the resort with a view of the mountains and its terrace in summer.\r\nPizzas on the spot and to take away."
    ],
    "it": [
      "Di fronte al Parc d'Uriage, il team del Carillon vi propone il suo menu di pizze, le sue specialità del giorno e le sue insalate variegate: nel cuore della località, con vista sulle montagne e sulla sua terrazza in estate.\r\nPizze sul posto e da asporto."
    ],
    "fr": [
      "Face au parc d'Uriage, l'équipe du Carillon vous propose sa carte de pizzas, ses plats du jour et ses salades variés :  Au cœur de la station avec vue sur les montagnes et sa terrasse en été.\r\nPizzas sur place et à emporter."
    ],
    "nl": [
      "Met uitzicht op het park van Uriage biedt het team van Carillon u zijn pizzamenu, zijn dagelijkse specialiteiten en zijn gevarieerde salades: in het hart van het resort met uitzicht op de bergen en zijn terras in de zomer.\r\nPizza's ter plaatse en om mee te nemen."
    ],
    "es": [
      "Frente al Parc d'Uriage, el equipo del Carillon le ofrece su carta de pizzas, sus platos del día y sus variadas ensaladas: en el corazón de la estación con vistas a las montañas y su terraza en verano.\r\nPizzas al momento y para llevar."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Pizzeria Le Carillon"
    ]
  },
