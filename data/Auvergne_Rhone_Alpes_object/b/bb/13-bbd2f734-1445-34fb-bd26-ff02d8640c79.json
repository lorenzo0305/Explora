  "rdfs:comment": {
    "de": [
      "Jeremy aus dem Atelier LET ist seit 2010 Schmied und Schneider. Er ist leidenschaftlich und lässt Sie in diese faszinierende Welt der Eisenverarbeitung mit Feuer eintauchen. Messer, Werkzeuge für ND-de-Paris, zahlreiche Werkzeuge, die Sie in seiner Werkstatt entdecken können."
    ],
    "en": [
      "Jeremy from Atelier LET has been a blacksmith since 2010. He's passionate about immersing you in the fascinating world of working iron with fire. From knives to ND-de-Paris tools, you'll find plenty of tools to discover in his workshop."
    ],
    "it": [
      "Jeremy di Atelier LET è un fabbro dal 2010. La sua passione è quella di farvi immergere nell'affascinante mondo della lavorazione del ferro con il fuoco. Dai coltelli agli strumenti per l'ND-de-Paris, ci sono molti strumenti da scoprire nel suo laboratorio."
    ],
    "fr": [
      "Jeremy de l'Atelier LET est forgeron taillandier depuis 2010. Passionné, il vous immergera dans cet univers  fascinant du travail du fer avec le feu. Couteaux, outils pour ND-de-Paris, nombreux sont les outils à vous faire découvrir dans son atelier."
    ],
    "es": [
      "Jeremy, de Atelier LET, es herrero desde 2010. Le apasiona sumergirte en el fascinante mundo del trabajo del hierro con fuego. Desde cuchillos hasta herramientas para ND-de-Paris, en su taller podrás descubrir un montón de herramientas."
    ],
    "nl": [
      "Jeremy van Atelier LET is smid sinds 2010. Hij dompelt je met passie onder in de fascinerende wereld van het bewerken van ijzer met vuur. Van messen tot gereedschap voor ND-de-Paris, er is genoeg te ontdekken in zijn werkplaats."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Forge coutellerie & taillanderie Atelier LET"
    ]
  },
