  "rdfs:comment": {
    "de": [
      "Anzahl der Einwohner: 728\r\nFläche: 10,9 km²\r\n\r\nDie Gemeinde erstreckt sich zwischen den Tälern des Chalon und der Savasse, in diesem Teil des Gebiets der \"Drôme des collines\", der aus dem Südwesthang der \"Chambarans\" besteht."
    ],
    "en": [
      "Population: 728\r\nSurface area : 10,9 km²\r\n\r\nThe commune lies between the Chalon and Savasse valleys, on the south-western slopes of the \"Chambarans\" in the \"Drôme des collines\" region."
    ],
    "it": [
      "Numero di abitanti: 728\r\nSuperficie: 10,9 km² (6,5 miglia quadrate)\r\n\r\nIl comune si trova tra le valli dei fiumi Chalon e Savasse, sul versante sud-occidentale dello Chambarans, nella Drôme des collines."
    ],
    "fr": [
      "Nombre d'habitants : 728\r\nSuperficie : 10,9 km²\r\n\r\nLa commune s’étend entre les vallées du Chalon et de la Savasse, sur cette partie du territoire de la “Drôme des collines” constituée par le versant sud-ouest des “Chambarans”."
    ],
    "es": [
      "Número de habitantes: 728\r\nSuperficie: 10,9 km² (6,5 millas cuadradas)\r\n\r\nEl municipio se encuentra entre los valles de los ríos Chalon y Savasse, en la vertiente suroeste de los Chambaranes, en la \"Drôme des collines\"."
    ],
    "nl": [
      "Bevolking: 728\r\nOppervlakte : 10,9 km²\r\n\r\nDe gemeente ligt tussen de valleien van Chalon en Savasse, op de zuidwestelijke hellingen van de \"Chambarans\" in de \"Drôme des collines\"."
    ]
  },
