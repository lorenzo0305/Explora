  "rdfs:comment": {
    "de": [
      "Nehmen Sie mit Ihrem Kind von 4 bis 6 Jahren an diesem Workshop mit Emmanuelle Houdart, der Autorin von \"Les formidables journées de Piloursine\", teil und tauchen Sie in ihre zärtliche und fantasievolle Welt ein.\r\nNach Anmeldung."
    ],
    "en": [
      "Bring your 4 to 6 year-old child to this workshop with Emmanuelle Houdart, author of \"Les formidables journées de Piloursine\", and enter her world full of tenderness and fantasy.\r\nRegistration required."
    ],
    "it": [
      "Partecipate a questo laboratorio con il vostro bambino dai 4 ai 6 anni, con Emmanuelle Houdart, autrice di \"Les formidables journées de Piloursine\", ed entrate nel suo mondo pieno di tenerezza e fantasia.\r\nIscrizione obbligatoria."
    ],
    "fr": [
      "Venez participer, avec votre enfant de 4 à 6 ans, à cet atelier avec Emmanuelle Houdart, auteure des \"formidables journées de Piloursine\", et rentrez dans son univers plein de tendresse et de fantaisie.\r\nSur inscription."
    ],
    "es": [
      "Venga a participar con su hijo de 4 a 6 años en este taller con Emmanuelle Houdart, autora de \"Les formidables journées de Piloursine\", y entre en su mundo lleno de ternura y fantasía.\r\nInscripción obligatoria."
    ],
    "nl": [
      "Kom met je kind van 4 tot 6 jaar deelnemen aan deze workshop met Emmanuelle Houdart, auteur van \"Les formidables journées de Piloursine\", en betreed haar wereld vol tederheid en fantasie.\r\nInschrijving verplicht."
    ]
  },
  "rdfs:label": {
    "fr": [
