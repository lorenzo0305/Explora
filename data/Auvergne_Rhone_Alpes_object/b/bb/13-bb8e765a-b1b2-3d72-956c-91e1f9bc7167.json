  "rdfs:comment": {
    "de": [
      "Spielplatz für Kinder.\r\nVorhandensein einer Multi-Spiel-Struktur mit Rutsche. Schaukel mit einer Wippe. Spiel mit einer Feder. Korb für den Basketball. Rampen als Sprungbrett für Skateboards. Picknicktisch und Bänke."
    ],
    "en": [
      "Children's play area.\r\nMulti-play structure with slide. Rocking swing. Spring game. Basketball hoop. Skateboard ramps. Picnic table and benches."
    ],
    "it": [
      "Area giochi per bambini.\r\nStruttura multigioco con scivolo. Altalena a dondolo. Gioco a molla. Canestro da basket. Rampe per skateboard. Tavolo da picnic e panche."
    ],
    "fr": [
      "Aire de jeux pour enfants. \r\nPrésence d'une structure multi-jeux avec toboggan. Balançoire à bascule. Jeu à ressort. Panier de basket. Rampes tremplin pour skate. Table de pique-nique et bancs."
    ],
    "es": [
      "Zona de juegos infantiles.\r\nEstructura multijuego con tobogán. Columpio balancín. Juego de muelle. Canasta de baloncesto. Rampas para monopatín. Mesa de picnic y bancos."
    ],
    "nl": [
      "Speelruimte voor kinderen.\r\nMultispeelstructuur met glijbaan. Schommel. Lentespelletje. Basketbalring. Skateboardhellingen. Picknicktafel en banken."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de jeux La Combe Bacha"
    ]
  },
