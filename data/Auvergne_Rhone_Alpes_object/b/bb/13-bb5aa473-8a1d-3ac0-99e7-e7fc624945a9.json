  "rdfs:comment": {
    "de": [
      "Montrottier, dessen Ursprung bis ins 10. Jahrhundert zurückreicht, zeigt sich im Herzen des Dorfes, wovon die Kirche Saint-Martin zeugt."
    ],
    "en": [
      "Montrottier, whose origins date back to the 10th century, lies at the heart of the village, as witnessed by the Saint-Martin church."
    ],
    "it": [
      "Montrottier, le cui origini risalgono al X secolo, si trova nel cuore del villaggio, come testimonia la chiesa di Saint-Martin."
    ],
    "fr": [
      "Montrottier dont l'origine remonte au Xe siècle s'affiche au coeur du village, en témoigne l'église Saint-Martin."
    ],
    "nl": [
      "Montrottier, waarvan de oorsprong teruggaat tot de 10e eeuw, ligt in het hart van het dorp, zoals blijkt uit de kerk Saint-Martin."
    ],
    "es": [
      "Montrottier, cuyos orígenes se remontan al siglo X, se encuentra en el corazón del pueblo, como demuestra la iglesia de Saint-Martin."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Église Saint-Martin"
    ]
