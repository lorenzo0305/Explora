  "rdfs:comment": {
    "de": [
      "Lust auf ein einzigartiges und unvergessliches Erlebnis? In Bourgoin-Jallieu erwartet Sie der größte Komplex für Virtual-Reality-Erlebnisse in Frankreich!\r\nTauchen Sie mit Ihrer Familie, Ihren Freunden oder Kollegen in fesselnde virtuelle Welten ein!"
    ],
    "en": [
      "Looking for a unique and unforgettable experience? France's largest complex dedicated to virtual reality experiences awaits you in Bourgoin-Jallieu!\r\nCome and immerse yourself in captivating virtual worlds with family, friends or colleagues!"
    ],
    "it": [
      "Siete alla ricerca di un'esperienza unica e indimenticabile? Il più grande complesso dedicato alle esperienze di realtà virtuale in Francia vi aspetta a Bourgoin-Jallieu!\r\nVenite a immergervi in mondi virtuali accattivanti con la vostra famiglia, i vostri amici o i vostri colleghi!"
    ],
    "fr": [
      "Envie d’une expérience unique et inoubliable? Le plus grand complexe dédié aux expériences de réalité virtuelle de France vous attend à Bourgoin-Jallieu ! \r\nVenez vous plonger dans des mondes virtuels captivants en famille, entre amis ou collègues !"
    ],
    "es": [
      "¿Busca una experiencia única e inolvidable? El mayor complejo dedicado a las experiencias de realidad virtual de Francia le espera en Bourgoin-Jallieu\r\n¡Venga y sumérjase en cautivadores mundos virtuales con su familia, amigos o compañeros de trabajo!"
    ],
    "nl": [
      "Op zoek naar een unieke en onvergetelijke ervaring? Het grootste complex gewijd aan virtual reality ervaringen in Frankrijk wacht op je in Bourgoin-Jallieu!\r\nKom en dompel jezelf onder in fascinerende virtuele werelden met je familie, vrienden of collega's!"
    ]
  },
  "rdfs:label": {
    "fr": [
