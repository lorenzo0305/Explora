          "@type": [
            "schema:OpeningHoursSpecification"
          ],
          "additionalInformation": {
            "de": [
              "Öffnungszeiten während der Schulferien :\r\nMittwoch: 10:00 - 22:00 Uhr.\r\nDonnerstag: 10h - 22h.\r\nFreitag: 10h - 22h.\r\nSamstag: 10h - 23h.\r\nSonntag: 10h -20h.\r\n\r\nAbweichende Öffnungszeiten während der Schulferien oder bei Privatisierung.\r\nEs wird dringend empfohlen, einen Zeitslot zu reservieren."
            ],
            "en": [
              "Opening times during school vacations:\r\nWednesday: 10am - 10pm.\r\nThursday: 10am - 10pm.\r\nFriday: 10am - 10pm.\r\nSaturday: 10am - 11pm.\r\nSunday: 10am - 8pm.\r\n\r\nDifferent times for school vacations or privatization.\r\nWe strongly advise you to reserve a slot."
            ],
            "it": [
              "Orari di apertura durante le vacanze scolastiche:\r\nMercoledì: dalle 10.00 alle 22.00.\r\nGiovedì: dalle 10.00 alle 22.00.\r\nVenerdì: dalle 10.00 alle 22.00.\r\nSabato: dalle 10.00 alle 23.00.\r\nDomenica: dalle 10 alle 20.\r\n\r\nOrari di apertura diversi durante le vacanze scolastiche o quando il sito è privato.\r\nSi consiglia vivamente di prenotare una fascia oraria."
            ],
            "fr": [
              "Horaires durant la période de vacances scolaires :\r\nMercredi : 10h - 22h.\r\nJeudi : 10h-22h.\r\nVendredi : 10h - 22h.\r\nSamedi : 10h - 23h.\r\nDimanche : 10h -20h.\r\n\r\nHoraires différents pour les vacances scolaires ou en cas de privatisation.\r\nIl est fortement conseillé de réserver un créneau."
            ],
            "nl": [
              "Openingstijden tijdens schoolvakanties:\r\nWoensdag: 10.00 - 22.00 uur.\r\nDonderdag: 10.00 - 22.00 uur.\r\nVrijdag: 10.00 - 22.00 uur.\r\nZaterdag: 10.00 - 23.00 uur.\r\nZondag: 10.00 - 20.00 uur.\r\n\r\nAndere openingstijden tijdens schoolvakanties of wanneer de camping geprivatiseerd is.\r\nWe raden je sterk aan om te reserveren."
            ],
            "es": [
              "Horario durante las vacaciones escolares:\r\nMiércoles: de 10.00 a 22.00 horas.\r\nJueves: de 10.00 a 22.00 h.\r\nViernes: de 10.00 a 22.00 h.\r\nSábado: de 10.00 a 23.00 h.\r\nDomingo: de 10.00 a 20.00 h.\r\n\r\nHorarios diferentes durante las vacaciones escolares o cuando el recinto está privatizado.\r\nLe recomendamos encarecidamente que reserve una plaza."
            ]
          },
