  "rdfs:comment": {
    "de": [
      "Bertrand singt noch mehr als sonst und seine breite Prosa bietet seinem legendären und paradoxen Minimalismus neue Bäume."
    ],
    "en": [
      "Bertrand sings even more than usual, and his ample prose offers new arborescences to his legendary and paradoxical minimalism."
    ],
    "it": [
      "Bertrand canta ancora più del solito e la sua prosa di ampio respiro conferisce al suo leggendario e paradossale minimalismo una nuova struttura ad albero."
    ],
    "fr": [
      "Bertrand chante plus encore qu’à l’habitude et sa prose ample offre à son légendaire et paradoxale minimalisme de nouvelles arborescences."
    ],
    "nl": [
