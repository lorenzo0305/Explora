  "rdfs:comment": {
    "de": [
      "Fred Pégeot bietet Ihnen Kurse für alle Angelarten (Fliegenfischen, Toc, Nymphe, Köder) am Fluss Chéran in Savoyen und Hochsavoyen, den er wie seine Westentasche kennt. Keine großen Theorien oder lange Reden über das Angeln, das Ziel ist es, Spaß zu haben!"
    ],
    "en": [
      "Fred Pégeot offers courses in all types of fishing (fly, nymph, lures) on the Chéran river in Savoie and Haute-Savoie, which he knows like the back of his hand. No big theories or long speeches about fishing, the aim is to have fun!"
    ],
    "it": [
      "Fred Pégeot propone corsi di tutti i tipi di pesca (mosca, toc, ninfa, esche artificiali) sul Chéran in Savoia e Alta Savoia, che conosce a menadito. Niente teorie o lunghi discorsi sulla pesca, ma solo divertimento!"
    ],
    "fr": [
      "Fred Pégeot vous propose des stages toutes pêches (mouche, toc à la nymphe, leurres) sur le Chéran en Savoie et Haute-Savoie, qu'il connaît comme sa poche. Pas de grandes théories et de longs discours sur la pêche, le but, se faire plaisir!"
    ],
    "es": [
      "Fred Pégeot ofrece todo tipo de cursos de pesca (con mosca, con ninfa, con señuelos) en el río Chéran, en Saboya y Alta Saboya, que conoce como la palma de su mano. ¡Nada de grandes teorías y largos discursos sobre la pesca, el objetivo, divertirse!"
    ],
    "nl": [
      "Fred Pégeot geeft cursussen in alle soorten vissen (vlieg, toc, nimf, kunstaas) op de Chéran in de Savoie en Haute-Savoie, die hij op zijn duimpje kent. Geen grote theorieën of lange toespraken over vissen, gewoon genieten!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Fishing guide - Frédéric PÉGEOT"
    ],
    "it": [
      "Guida di pesca - Frédéric PÉGEOT"
    ],
    "fr": [
      "Moniteur guide de pêche - Frédéric PÉGEOT"
    ],
    "nl": [
      "Visgids - Frédéric PÉGEOT"
    ]
  },
