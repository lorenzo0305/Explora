  "rdfs:comment": {
    "de": [
      "Franceraft, Spezialist für Wildwassersportarten, bietet Ihnen: Rafting, Hydrospeed, Canoraft und Airboat auf der Isère und Canyoning in den Tälern der Tarentaise, Savoyen und Haute-Savoie sowie Stand Up Paddling auf dem Wasser vor unserer Basis."
    ],
    "en": [
      "White-water specialist Franceraft proposes: rafting, hydrospeed, canoe-raft and airboat on the Isère river and canyoning in the valleys of the Tarentaise and in Savoie and Haute-Savoie, as well as paddleboarding on the reservoir at our base."
    ],
    "it": [
      "Franceraft è specializzata in sport d'acqua bianca e offre: Rafting, Hydrospeed, Canoraft e Airboat sull'Isère e Canyoning nelle valli Tarentaise, Savoia e Alta Savoia e Stand Up Paddle sull'acqua di fronte alla nostra base."
    ],
    "fr": [
      "Franceraft spécialiste des sports d’eau vive vous  propose : Rafting, Hydrospeed, Canoraft et Airboat sur l’Isère et Canyoning dans les vallées de la Tarentaise, de Savoie et Haute-Savoie et du Stand Up Paddle sur le plan d’eau situé devant notre base."
    ],
    "nl": [
      "Franceraft, specialist in wildwatersport stelt U voor : rafting, hydrospeed, canoeraft en airboat op de Isère alsook canyoning in de valleien van la Tarentaise, van Savoie en Haute-Savoie en  Stand Up Paddle op het bassin voor onze basis."
    ],
    "es": [
      "Franceraft está especializado en deportes de aguas bravas y ofrece: Rafting, Hydrospeed, Canoraft y Airboat en el Isère y Canyoning en los valles de Tarentaise, Savoie y Haute-Savoie y Stand Up Paddle en el agua frente a nuestra base."
    ]
  },
