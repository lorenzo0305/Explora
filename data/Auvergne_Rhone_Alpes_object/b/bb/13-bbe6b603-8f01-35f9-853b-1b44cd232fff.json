  "rdfs:comment": {
    "de": [
      "Ein letzter Blick auf Moulins und seine Kirchtürme, die über den Fluss ragen, und schon sitzen Sie wieder im Sattel der Via Allier."
    ],
    "en": [
      "One last look at Moulins and its steeples towering over the river, and you're back in the saddle on La Via Allier."
    ],
    "it": [
      "Un ultimo sguardo a Moulins e ai suoi campanili che svettano sul fiume e si torna in sella alla Via Allier."
    ],
    "fr": [
      "Un dernier coup d'œil sur Moulins et ses clochers qui pointent au-dessus de la rivière et vous voilà de nouveau en selle sur La Via Allier."
    ],
    "es": [
      "Una última mirada a Moulins y sus campanarios que se elevan sobre el río y ya está de vuelta en la Via Allier."
    ],
    "nl": [
      "Een laatste blik op Moulins en zijn klokkentorens die boven de rivier uittorenen en je zit weer in het zadel op La Via Allier."
    ]
  },
  "rdfs:label": {
