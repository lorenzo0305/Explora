  "rdfs:comment": {
    "de": [
      "Kunstgalerie, die von einem Verein betrieben wird. Bietet das ganze Jahr über Ausstellungen von Gemälden und Skulpturen französischer und ausländischer Künstler. Zu Beginn des Jahres Vorführungen von Künstlerfilmen."
    ],
    "en": [
      "Art gallery. Offers year-round exhibitions of paintings and sculptures by French and foreign artists. At the start of the new year, screenings of artists' films."
    ],
    "it": [
      "Galleria d'arte. Offre mostre di pittura e scultura di artisti francesi e stranieri durante tutto l'anno. All'inizio dell'anno, proiezione di film d'artista."
    ],
    "fr": [
      "Galerie d'Art associative. Propose tout au long de l'année des expositions de peintures et sculptures d'artistes français et étrangers. En début d'année, des projections de films d'artistes."
    ],
    "nl": [
      "Kunstgalerie. Het hele jaar door exposities van schilderijen en beeldhouwwerken van Franse en buitenlandse kunstenaars. Aan het begin van het jaar worden er films van kunstenaars vertoond."
    ],
    "es": [
      "Galería de arte. Ofrece exposiciones de pintura y escultura de artistas franceses y extranjeros durante todo el año. A principios de año, proyecciones de películas de artistas."
    ]
  },
  "rdfs:label": {
