  "rdfs:comment": {
    "de": [
      "Das Hotel wurde in den letzten 3 Jahren renoviert. 15 schallisolierte Zimmer, davon 4 zusätzliche Zimmer mit eigener Loggia mit Blick auf den Garten. Familienzimmer."
    ],
    "en": [
      "The hotel has been renovated in the last 3 years, 15 soundproofed rooms, including 4 additional rooms with individual loggia overlooking the garden. Family rooms."
    ],
    "it": [
      "L'hotel è stato rinnovato negli ultimi 3 anni, 15 camere insonorizzate, tra cui 4 camere aggiuntive con loggia individuale con vista sul giardino. Camere familiari."
    ],
    "fr": [
      "L'hôtel a été rénové ces 3 dernières années, 15 chambres insonorisées, dont 4 chambres supplémentaires avec loggia individuelle donnant sur jardin. Chambres familiales."
    ],
    "nl": [
      "Het hotel is in de afgelopen 3 jaar gerenoveerd, 15 geluiddichte kamers, waaronder 4 extra kamers met individuele loggia met uitzicht op de tuin. Familiekamers."
    ],
    "es": [
      "El hotel ha sido renovado en los últimos 3 años, 15 habitaciones insonorizadas, incluyendo 4 habitaciones adicionales con logia individual con vistas al jardín. Habitaciones familiares."
