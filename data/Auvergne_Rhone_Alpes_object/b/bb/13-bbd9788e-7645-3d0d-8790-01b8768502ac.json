  "rdfs:comment": {
    "de": [
      "Das FabLab LABOBINE in Malicorne, Service von Commentry Montmarault Néris Communauté, begleitet Unternehmen, Fachleute, Vereine und Privatpersonen und bietet Zugang zu CNC-gesteuerten Maschinen, 3D-Druck, Laserschneiden..."
    ],
    "en": [
      "The FabLab LABOBINE, in Malicorne, a service of the Commentry Montmarault Néris Communauté, supports companies, professionals, associations and individuals, and provides access to CNC machines, 3D printing, laser cutting..."
    ],
    "it": [
      "Il LABOBINE FabLab di Malicorne, un dipartimento della Communauté Commentry Montmarault Néris, fornisce supporto a imprese, professionisti, associazioni e privati e offre accesso a macchine CNC, stampa 3D, taglio laser, ecc."
    ],
    "fr": [
      "Le FabLab LABOBINE, à Malicorne, service de Commentry Montmarault Néris Communauté, accompagne entreprises, professionnels, associations et particuliers et donne accès à des machines à commande numériques type CNC, impression 3D, découpe laser..."
    ],
    "nl": [
      "Het LABOBINE FabLab in Malicorne, een afdeling van de Commentry Montmarault Néris Communauté, biedt ondersteuning aan bedrijven, professionals, verenigingen en particulieren en biedt toegang tot CNC-machines, 3D-printing, lasersnijden, enz."
    ],
    "es": [
      "El FabLab LABOBINE de Malicorne, departamento de la Communauté Commentry Montmarault Néris, presta apoyo a empresas, profesionales, asociaciones y particulares y ofrece acceso a máquinas CNC, impresión 3D, corte por láser, etc."
    ]
  },
