  "rdfs:comment": {
    "de": [
      "Begeben Sie sich auf eine 30-minütige Fahrt inmitten der Natur an Bord eines in Frankreich einzigartigen Zuges, einem exakten Nachbau von SNCF-Fahrzeugen. Strecke von 6 km hin und zurück, von Anse-Pont bis zum Plan d'eau du Colombier. Abfahrt jede Stunde."
    ],
    "en": [
      "Take a 30-minute ride in the midst of nature aboard a train wich is unique in France, an exact replica of SNCF vehicles. A 6 km round trip from Anse-Pont to le plan d'eau du Colombier. Departures every hour."
    ],
    "it": [
      "Partite per un viaggio di 30 minuti attraverso la campagna a bordo di un treno unico in Francia, replica esatta dei veicoli SNCF. 6 km di andata e ritorno, da Anse-Pont al lago Colombier. Partenze ogni ora."
    ],
    "fr": [
      "Embarquez pour une balade de 30 min en pleine nature à bord d'un train unique en France, réplique exacte de véhicules SNCF. Parcours de 6km aller-retour, de Anse-Pont au plan d'eau du Colombier. Départ toutes les heures."
    ],
    "nl": [
      "Vertrek voor een rit van 30 minuten door het platteland aan boord van een trein die uniek is in Frankrijk, een exacte replica van SNCF-voertuigen. Rondrit van 6 km, van Anse-Pont naar het Colombier-meer. Vertrek elk uur."
    ],
    "es": [
      "Embárquese en un paseo de 30 minutos por el campo a bordo de un tren único en Francia, réplica exacta de los vehículos de la SNCF. Recorrido de ida y vuelta de 6 km, desde Anse-Pont hasta el lago Colombier. Salidas cada hora."
    ]
  },
  "rdfs:label": {
    "en": [
      "Anse Tourist Railway"
    ],
    "fr": [
      "Chemin de Fer Touristique d'Anse"
    ]
  },
