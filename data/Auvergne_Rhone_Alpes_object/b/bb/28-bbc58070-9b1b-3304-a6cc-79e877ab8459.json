  "rdfs:comment": {
    "de": [
      "45 km östlich von Amiens ein herrliches Panorama am Anfang einer Wanderung zum Belvédère de Vaux, das das obere Tal der Somme überragt und ein herrliches Panorama von Verflechtungen, Teichen und Sümpfen bietet."
    ],
    "en": [
      "45 km east of Amiens, a superb panorama at the start of a walk at the Belvédère de Vaux which dominates the Upper Somme valley and offers a superb panorama of interlacing lakes, ponds and marshes."
    ],
    "it": [
      "A 45 km a est di Amiens, un superbo panorama dal Belvédère de Vaux, che si affaccia sull'alta valle della Somme e offre una vista superba di stagni e paludi che si intrecciano."
    ],
    "fr": [
      "À 45 km à l'est d'Amiens un superbe panorama au départ d'une promenade à faire au Belvédère de Vaux qui domine la Haute vallée de la Somme et offre un superbe panorama d’entrelacs, d’étangs et de marais."
    ],
    "es": [
      "A 45 km al este de Amiens, un magnífico panorama desde el Belvédère de Vaux, que domina el alto valle del Somme y ofrece una magnífica vista de estanques y pantanos entrelazados."
    ],
    "nl": [
      "45 km ten oosten van Amiens, een prachtig panorama vanaf het Belvédère de Vaux, dat uitkijkt over het dal van de Somme en een prachtig uitzicht biedt op in elkaar overlopende vijvers en moerassen."
    ]
  },
  "rdfs:label": {
