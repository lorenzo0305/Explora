  "rdfs:comment": {
    "de": [
      "Die in Bidon ansässige Savonnerie des Champs Libres verfolgt mit ihrem Sortiment aus 6 kaltverseiften, rückfettenden Seifen einen ökologischen und verantwortungsbewussten Ansatz."
    ],
    "en": [
      "The Savonnerie des Champs Libres, located in Bidon, is part of an ecological and responsible approach with its range of 6 cold-saponified superfatted soaps. Without dyes or essential oils, the soaps are made from local, quality raw materials and all from organic farming. They are coloured with clays from the Gard and are lightly perfumed by macerates of plants picked and dried by me. Each formula has been controlled by a toxicologist, thought out and developed to offer you a varied range adapted to all skin types."
    ],
    "it": [
      "La Savonnerie des Champs Libres, con sede a Bidon, ha adottato un approccio ecologico e responsabile con la sua gamma di 6 saponi supergrassi saponificati a freddo."
    ],
    "fr": [
      "La Savonnerie des Champs Libres, installée à Bidon, s’inscrit dans une démarche écologique et responsable avec sa gamme de 6 savons surgras saponifiés à froid."
    ],
    "es": [
      "La Savonnerie des Champs Libres, con sede en Bidon, ha adoptado un enfoque ecológico y responsable con su gama de 6 jabones supergrasos saponificados en frío."
    ],
    "nl": [
      "De Savonnerie des Champs Libres, gevestigd in Bidon, heeft gekozen voor een ecologische en verantwoordelijke aanpak met haar assortiment van 6 koudgezeepte supervette zepen."
    ]
  },
  "rdfs:label": {
    "en": [
      "Champs Lbres Soap fabrik"
    ],
    "fr": [
      "Savonnerie des Champs Libres"
    ]
  },
