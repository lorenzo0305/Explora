  "rdfs:comment": {
    "de": [
      "Die Géants du Vercors laden Sie ein, die Natur durch poetische Spaziergänge, Märchen und naturkundliche Entdeckungen zu erforschen. Entdecken Sie die Verbindung zwischen Mensch und Lebewesen neu und erleben Sie das Wesen der Berge fernab der modernen Hektik."
    ],
    "en": [
      "Les Géants du Vercors invites you to explore nature through poetic walks, storytelling and naturalist discoveries. Rediscover the links between man and nature, and experience the essence of the mountains, far from the hustle and bustle of modern life."
    ],
    "it": [
      "Les Géants du Vercors vi invitano a esplorare la natura attraverso passeggiate poetiche, racconti e scoperte naturalistiche. Riscoprite i legami tra l'uomo e il mondo vivente e vivete appieno l'essenza della montagna, lontano dalla frenesia della vita moderna."
    ],
    "fr": [
      "Les Géants du Vercors vous invitent à explorer la nature à travers balades poétiques, contes et découvertes naturalistes. Redécouvrez les liens entre humains et vivant, et vivez pleinement l’essence de la montagne, loin du tumulte moderne."
    ],
    "nl": [
      "Les Géants du Vercors nodigt je uit om de natuur te verkennen door middel van poëtische wandelingen, verhalen en naturalistische ontdekkingen. Herontdek de banden tussen de mens en de levende wereld, en ervaar ten volle de essentie van de bergen, ver van de drukte van het moderne leven."
    ],
    "es": [
      "Les Géants du Vercors le invitan a explorar la naturaleza a través de paseos poéticos, narraciones y descubrimientos naturalistas. Redescubra los vínculos entre el ser humano y el mundo vivo, y viva plenamente la esencia de la montaña, lejos del ajetreo de la vida moderna."
    ]
  },
  "rdfs:label": {
