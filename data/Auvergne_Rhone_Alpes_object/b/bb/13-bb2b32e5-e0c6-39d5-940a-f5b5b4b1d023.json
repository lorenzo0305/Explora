  "rdfs:comment": {
    "de": [
      "L'Augère ist das älteste der 13 Schlösser der Gemeinde Agonges. Jahrhundert, die Gärten und das Museum der bourbonischen Jagd."
    ],
    "en": [
      "L'Augère is the oldest of the 13 castles in the commune of Agonges. Guided tour of the interior of the 15th century castle, the gardens, the museum of the Bourbonnaise venery."
    ],
    "it": [
      "L'Augère è il più antico dei 13 castelli del comune di Agonges. Visita guidata degli interni del castello del XV secolo, dei giardini e del museo di Bourbonnais."
    ],
    "fr": [
      "L'Augère est le plus ancien des 13 châteaux de la commune d’Agonges. Visite guidée de l’intérieur du château du XVème siècle, des jardins, du musée de la vénerie bourbonnaise."
    ],
    "nl": [
      "L'Augère is het oudste van de 13 kastelen van de gemeente Agonges. Rondleiding met gids door het interieur van het kasteel uit de 15e eeuw, de tuinen en het museum van Bourbonnais venery."
    ],
    "es": [
      "L'Augère es el más antiguo de los 13 castillos del municipio de Agonges. Visita guiada del interior del castillo del siglo XV, los jardines y el museo de la viña Bourbonnais."
    ]
  },
