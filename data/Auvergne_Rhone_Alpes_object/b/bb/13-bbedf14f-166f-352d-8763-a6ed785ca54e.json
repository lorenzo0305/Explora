  "rdfs:comment": {
    "de": [
      "Tauchen Sie ein in die Welt des Olivenbaums und lassen Sie sich verzaubern! Entdecken Sie unsere Verkostungsworkshops, kreatives Kochen, unsere einzigartige sensorische Ausstellung, erkunden Sie unsere Boutique mit Produkten aus 100% Frankreich und erleben Sie ein unvergessliches Erlebnis für alle!"
    ],
    "en": [
      "Immerse yourself in the world of the olive tree and let yourself be enchanted! Discover our tasting workshops, our creative cuisine, our unique sensory exhibition, explore our boutique of 100% French products and enjoy an unforgettable experience for all!"
    ],
    "it": [
      "Scoprite la degustazione dell'olio d'oliva e delle olive di Francia, i laboratori di cucina e di cosmetica e la nostra mostra sensoriale unica. Esplorate il nostro negozio di prodotti locali e vivete un'esperienza indimenticabile per tutti!"
    ],
    "fr": [
      "Découvrez nos ateliers de dégustation, cuisine et cosmétique autour des Huiles d’Olives et Olives de France ainsi que notre exposition sensorielle unique. Explorez notre boutique de produits du terroir et vivez une expérience inoubliable pour tous !"
    ],
    "nl": [
      "Dompel jezelf onder in de wereld van de olijfboom en laat je betoveren! Ontdek onze proeverij workshops, creatief koken, onze unieke zintuiglijke tentoonstelling, verken onze winkel met 100% Franse producten en geniet van een onvergetelijke ervaring voor iedereen!"
    ],
    "es": [
      "Descubra nuestros talleres de degustación de aceite de oliva y aceitunas de Francia, cocina y cosmética, así como nuestra exposición sensorial única. ¡Explore nuestra tienda de productos locales y disfrute de una experiencia inolvidable para todos!"
    ]
  },
