  "rdfs:comment": {
    "de": [
      "Der Besuch des Ökomuseums von Varacieux ist eine Reise in die Vergangenheit. Das vertrauliche Museum wurde im Laufe der Zeit von einem Sammler aufgebaut, der die Pflicht hat, sich an die Vergangenheit zu erinnern."
    ],
    "en": [
      "A visit to the Varacieux Ecomuseum is like stepping back in time. This confidential museum has been built up over time by a collector driven by a duty to remember."
    ],
    "it": [
      "Visitare l'Ecomuseo di Varacieux è come fare un viaggio nel tempo. Questo museo riservato è stato costruito nel tempo da un collezionista animato dal dovere di ricordare."
    ],
    "fr": [
      "La visite de l’écomusée de Varacieux est un voyage dans le temps. Confidentiel, il a été constitué au fil du temps par un collectionneur animé d’un devoir de mémoire."
    ],
    "es": [
      "Visitar el Ecomuseo de Varacieux es como viajar en el tiempo. Este museo confidencial ha sido construido a lo largo del tiempo por un coleccionista movido por el deber de recordar."
    ],
    "nl": [
      "Een bezoek aan het Ecomuseum Varacieux is als een reis terug in de tijd. Dit vertrouwelijke museum is in de loop der tijd opgebouwd door een verzamelaar die gedreven werd door de plicht om te herinneren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ecomusée des Objets d'Antan"
    ]
  },
