  "rdfs:comment": {
    "de": [
      "Moments d'Argile ist ein Dokumentarfilmfestival rund um den Ton in all seiner Vielfalt, von den Anfängen bis heute, vom Steinbruch bis zur Werkstatt, von der Töpferei bis zur Architektur aus Lehm, vom Tanz bis zur zeitgenössischen Kunst."
    ],
    "en": [
      "Moments d?Argile is a festival of documentary films about clay in all its diversity, from its origins to the present day, from quarry to workshop, from pottery to raw clay architecture, from dance to contemporary art."
    ],
    "it": [
      "Moments d'Argile è un festival di film documentari sull'argilla in tutta la sua diversità, dalle origini ai giorni nostri, dalla cava al laboratorio, dalla ceramica all'architettura in argilla cruda, dalla danza all'arte contemporanea."
    ],
    "fr": [
      "Moments d’Argile est un festival de films documentaire autour de l’argile dans toute sa diversité, de l’origine à nos jours, de la carrière à l’atelier, de la poterie à l’architecture de terre crue, de la danse à l’art contemporain."
    ],
    "nl": [
      "Moments d?Argile is een festival van documentaires over klei in al zijn diversiteit, van de oorsprong tot nu, van de steengroeve tot de werkplaats, van pottenbakken tot architectuur in ruwe klei, van dans tot hedendaagse kunst."
    ],
    "es": [
      "Moments d'Argile es un festival de películas documentales sobre la arcilla en toda su diversidad, desde sus orígenes hasta nuestros días, de la cantera al taller, de la alfarería a la arquitectura de barro crudo, de la danza al arte contemporáneo."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Association Moments d'Argile"
    ]
  },
