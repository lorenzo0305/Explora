  "rdfs:comment": {
    "de": [
      "Erobern Sie den legendären Col du Galibier, bevor Sie in das hübsche Vallon de la Lauzette hinabfahren! Die Enduro-ähnliche Abfahrt bietet Ihnen einen sehr natürlichen Spielplatz."
    ],
    "en": [
      "Conquer the mythical Col du Galibier before descending into the pretty valley of La Lauzette! The typical Enduro descent will offer you a very natural playground."
    ],
    "it": [
      "Partite alla conquista del leggendario Col du Galibier prima di scendere nella graziosa valle di Lauzette! La discesa in stile Enduro vi offre un terreno di gioco molto naturale."
    ],
    "fr": [
      "Partez à la conquête du mythique Col du Galibier avant de redescendre dans le joli vallon de la Lauzette ! La descente typée Enduro vous offrira un terrain de jeu très nature."
    ],
    "es": [
      "Lánzate a la conquista del legendario Col du Galibier antes de descender al bonito valle de Lauzette El descenso de estilo enduro le ofrece un terreno de juego muy natural."
    ],
    "nl": [
      "Ga op weg om de legendarische Col du Galibier te bedwingen voordat je afdaalt naar de mooie Lauzette-vallei! De afdaling in Enduro-stijl biedt je een heel natuurlijk speelterrein."
    ]
  },
