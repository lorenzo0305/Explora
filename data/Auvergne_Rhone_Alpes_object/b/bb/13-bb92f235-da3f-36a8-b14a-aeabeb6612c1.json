  "rdfs:comment": {
    "de": [
      "Von Lavoûte-sur-Loire bis Annonay; durchqueren Sie auf dieser ehemaligen Eisenbahnstrecke mit ihrem sanften Höhenunterschied sechs Gebiete mit unterschiedlichen Landschaften. Für alle zugänglich für unvergessliche Spaziergänge und Entdeckungen zwischen Haute-Loire und Ardèche."
    ],
    "en": [
      "From Lavoûte-sur-Loire to Annonay, cross six different landscapes on this gently sloping former railroad line. Accessible to all for unforgettable walks and discoveries between Haute-Loire and Ardèche."
    ],
    "it": [
      "Da Lavoûte-sur-Loire ad Annonay, attraversate sei paesaggi diversi su questa ex linea ferroviaria dolcemente ondulata. Il percorso è accessibile a tutti e offre passeggiate e scoperte indimenticabili tra Haute-Loire e Ardèche."
    ],
    "fr": [
      "De Lavoûte-sur-Loire à Annonay ; traversez six territoires aux paysages variés sur cette ancienne voie ferrée au dénivelé doux. Accessible à tous pour des balades et découvertes inoubliables entre Haute-Loire et Ardèche."
    ],
    "nl": [
      "Van Lavoûte-sur-Loire tot Annonay doorkruist u zes verschillende landschappen op deze licht glooiende voormalige spoorlijn. De route is toegankelijk voor iedereen en biedt onvergetelijke wandelingen en ontdekkingen tussen de Haute-Loire en de Ardèche."
    ],
    "es": [
      "De Lavoûte-sur-Loire a Annonay, atraviese seis paisajes diferentes en esta antigua línea de ferrocarril suavemente ondulada. La ruta, accesible para todos, ofrece paseos y descubrimientos inolvidables entre el Alto Loira y Ardèche."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Via Fluvia - Véloroute entre Loire et Rhône"
    ]
  },
