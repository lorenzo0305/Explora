  "rdfs:comment": {
    "de": [
      "Charmantes Hotel am Fuße der Pisten von Les Eucherts in La Rosière 1850. Zimmer für 2 bis 4 Personen, Familiensuite. 1/2 Pension. Bar. Terrasse in südlicher Richtung. Sauna. Parkplatz. Willkommen für Gruppen. Das ganze Jahr über auf Reservierung geöffnet. Online-Reservierung."
    ],
    "en": [
      "Chalet-hotel at the foot of the slopes in Les Eucherts. 15 rooms sleeping 2 to 4 people. Half-board, bar, south-facing terrace. Sauna. Groups welcome. Open all year, upon reservation."
    ],
    "it": [
      "Chalet-hotel ai piedi delle piste di Eucherts composto da 18 camere da 2 a 5 persone e in grado di accogliere anche gruppi, gruppi\r\naziendali e associazioni."
    ],
    "fr": [
      "Hôtel de charme au pied des pistes des Eucherts à La Rosière 1850. Chambres 2 à 4 personnes, suite famille. 1/2 pension. Bar. Terrasse plein sud. Sauna. Parking. Bienvenue aux groupe. Ouvert toute l'année sur réservation. Réservation en ligne."
    ],
    "es": [
      "Hotel con encanto al pie de las pistas de Eucherts, en La Rosière 1850. Habitaciones de 2 a 4 personas, suite familiar. 1/2 pensión. Bar. Terraza orientada al sur. Sauna. Aparcamiento. Admite grupos. Abierto todo el año con reserva previa. Reserva en línea."
    ],
    "nl": [
      "Charmant hotel aan de voet van de Eucherts-pistes in La Rosière 1850. Kamers voor 2 tot 4 personen, gezinssuite. 1/2 pension. Bar. Terras op het zuiden. Sauna. Parkeerplaats. Groepen welkom. Het hele jaar geopend op reservering. Reserveer online."
    ]
  },
