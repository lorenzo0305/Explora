  "rdfs:comment": {
    "de": [
      "Fleisch und Geflügel aus der Region.\r\nEssen auf Rädern das ganze Jahr über (privat und beruflich).\r\nCatering für alle Ihre Veranstaltungen: Hochzeiten, Taufen, Geburtstage."
    ],
    "en": [
      "Local meats and poultry.\r\nMeals on wheels all year round (private and professional).\r\nCatering for all your events: weddings, christenings, birthdays."
    ],
    "it": [
      "Carne e pollame locali.\r\nPasti a domicilio tutto l'anno (privati e professionisti).\r\nCatering per tutti i vostri eventi: matrimoni, battesimi, compleanni."
    ],
    "fr": [
      "Viandes et volailles de pays. \r\nPortage de repas à domicile toute l'année (particulier et professionnel).\r\nTraiteur pour tous vos événements : mariages, baptêmes, anniversaires."
    ],
    "nl": [
      "Lokaal vlees en gevogelte.\r\nMaaltijden op wieltjes het hele jaar door (privé en professioneel).\r\nCatering voor al uw evenementen: bruiloften, doopfeesten, verjaardagen."
    ],
    "es": [
      "Carne y aves de corral locales.\r\nComidas sobre ruedas todo el año (particulares y profesionales).\r\nCatering para todos sus eventos: bodas, bautizos, cumpleaños."
    ]
