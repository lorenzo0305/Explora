  "rdfs:comment": {
    "de": [
      "Café-Restaurant, das im Sommer auf der Alm von Villard-Reculas und im Winter auf der Skipiste eingerichtet ist. Spezialitäten aus den Bergen, der Dauphiné und anderen Ländern, die Sie auf der Südterrasse oder am Kamin genießen können."
    ],
    "en": [
      "A cafe and restaurant located in the pastureland of Villard-Reculas in the summer and on the ski slopes in the winter. Providing dishes from the mountains, the Dauphiné region and further afield to be enjoyed on the south-facing terrace or inside, next to the fire."
    ],
    "it": [
      "Caffè-ristorante situato nell'alpeggio di Villard-Reculas in estate e sulla pista da sci in inverno. Specialità di montagna, del Delfinato e di altro tipo da gustare sulla terrazza esposta a sud o accanto al camino."
    ],
    "fr": [
      "Café restaurant installé dans l'alpage de Villard-Reculas l'été et en hiver sur la piste de ski. Spécialités de montagne, du Dauphiné et d'ailleurs à déguster sur la terrasse plein sud ou au coin de la cheminée."
    ],
    "es": [
      "Café-restaurante situado en los pastos de montaña de Villard-Reculas en verano y en la pista de esquí en invierno. Especialidades de montaña, del Dauphiné y otras para disfrutar en la terraza orientada al sur o junto a la chimenea."
    ],
    "nl": [
      "Café-restaurant gelegen in de bergweide van Villard-Reculas in de zomer en op de skipiste in de winter. Berg-, Dauphiné- en andere specialiteiten om van te genieten op het terras op het zuiden of bij de open haard."
    ]
  },
