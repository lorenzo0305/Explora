  "rdfs:comment": {
    "de": [
      "Ruhiges Landrestaurant an den Ufern des Flusses Varèze. Etablissement in der Nähe des Stadions und des Flusses\r\nParkplatz - Terrasse - klimatisierter Saal - Bouleplatz in der Nähe"
    ],
    "en": [
      "This is a rural restaurant located on the quiet banks of the river Vareze, near the stadium. Car park, terrace, 'boules' pitch and air conditioned  room."
    ],
    "it": [
      "Tranquillo ristorante di campagna sulle rive del Varèze. Situato vicino allo stadio e al fiume\r\nParcheggio - Terrazza - Camera climatizzata - Campo da bocce nelle vicinanze"
    ],
    "fr": [
      "Restaurant de campagne au calme sur les berges de la Varèze. Établissement situé près du stade et de la rivière. \r\nParking - Terrasse - Salle climatisée - terrain de pétanque à proximité"
    ],
    "es": [
      "Tranquilo restaurante rural a orillas del Varèze. Situado cerca del estadio y del río\r\nAparcamiento - Terraza - Habitación con aire acondicionado - Pista de petanca en las inmediaciones"
    ],
    "nl": [
      "Rustig plattelandsrestaurant aan de oever van de Varèze. Gelegen bij het stadion en de rivier\r\nParkeerplaats - Terras - Kamer met airconditioning - Petanquebaan in de buurt"
    ]
  },
