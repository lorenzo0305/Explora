  "rdfs:comment": {
    "de": [
      "Willkommen auf der Domaine de la Combe au Loup. David Meziat bewirtschaftet 9 Hektar Weinberge in der hügeligen Landschaft des Beaujolais."
    ],
    "en": [
      "In the centre of the village of Chiroubles, an exceptional site, we will welcome you to our air-conditioned cellar to give you a tasting of our 4 appellations: Chiroubles, Morgon, Régnié and Beaujolais-Villages which is also available as a rosé."
    ],
    "it": [
      "Benvenuti al Domaine de la Combe au Loup. Viticoltore da diverse generazioni, di padre in figlio, David Meziat gestisce oggi 9 ettari di vigneti sulle dolci colline della regione del Beaujolais."
    ],
    "fr": [
      "Bienvenue au Domaine de la Combe au Loup. Vignerons depuis plusieurs générations de père en fils, aujourd’hui David Meziat exploite 9 hectares de vignes sur les reliefs vallonnés du Beaujolais."
    ],
    "nl": [
      "Welkom op Domaine de la Combe au Loup. David Meziat is al generaties lang wijnbouwer, van vader op zoon, en beheert nu 9 hectare wijngaarden op de glooiende heuvels van de Beaujolais."
    ],
    "es": [
      "Bienvenido al Domaine de la Combe au Loup. Viticultor desde hace varias generaciones, de padre a hijo, David Meziat gestiona actualmente 9 hectáreas de viñedos en las onduladas colinas de la región de Beaujolais."
    ]
  },
