  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Rodelbahn des Sancy Parks, ein Spielplatz, der dem Rodeln gewidmet ist, mit Förderband und Ausrüstungsverleih möglich."
    ],
    "en": [
      "Come and discover the Sancy Park toboggan run, a playful area dedicated to the practice of tobogganing with a conveyor belt and equipment rental available."
    ],
    "it": [
      "Venite a scoprire la pista da slittino del Sancy Park, un'area di divertimento dedicata allo slittino con nastro trasportatore e noleggio di attrezzature."
    ],
    "fr": [
      "Venez découvrir la piste de luge du Sancy Park, un espace ludique dédié à la pratique de la luge avec tapis roulant et location de matériel possible."
    ],
    "es": [
      "Venga a descubrir la pista de trineo del Sancy Park, una zona de diversión dedicada al trineo con una cinta transportadora y alquiler de material disponible."
    ],
    "nl": [
      "Kom de rodelbaan van Sancy Park ontdekken, een ludiek rodelgebied met een lopende band en verhuur van materiaal."
    ]
  },
