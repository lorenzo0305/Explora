  "rdfs:comment": {
    "de": [
      "Die Thermalquellen von Brides-les-Bains sind seit über einem Jahrhundert dafür bekannt, dass sie Übergewicht bekämpfen und Zentimeter verlieren lassen."
    ],
    "en": [
      "The thermal springs at Brides-les-Bains have been recognized for over a century for their ability to combat excess weight and help you lose inches."
    ],
    "it": [
      "Le sorgenti termali di Brides-les-Bains sono rinomate da oltre un secolo per combattere il sovrappeso e aiutare a perdere centimetri."
    ],
    "fr": [
      "Les sources thermales de Brides-les-Bains sont reconnues depuis plus d’un siècle pour lutter contre le surpoids et permettre de perdre des centimètres."
    ],
    "es": [
      "Las aguas termales de Brides-les-Bains son famosas desde hace más de un siglo por ayudar a perder peso y centímetros."
    ],
    "nl": [
      "De thermale bronnen in Brides-les-Bains staan al meer dan een eeuw bekend om de bestrijding van overgewicht en helpen je om centimeters te verliezen."
    ]
  },
