  "rdfs:comment": {
    "de": [
      "Diese Radtour ohne Höhenunterschied ist ideal für Radfahrer und führt Sie mühelos und sicher von Montrond-les-Bains nach Bellegarde-en-Forez."
    ],
    "en": [
      "Ideal to do by bike, this walk without unevenness allows you to go from Montrond-les-Bains to Bellegarde-en-Forez without effort and in complete safety."
    ],
    "it": [
      "Ideale per il cicloturismo, questo percorso dolce vi porterà da Montrond-les-Bains a Bellegarde-en-Forez in modo sicuro e senza sforzo."
    ],
    "fr": [
      "Idéale à faire en vélo, cette balade sans dénivelé vous permet de rallier Montrond-les-Bains à Bellegarde-en-Forez sans effort et en toute sécurité."
    ],
    "es": [
      "Ideal para recorrer en bicicleta, este suave paseo le llevará de Montrond-les-Bains a Bellegarde-en-Forez con seguridad y sin esfuerzo."
    ],
    "nl": [
      "Deze rustige fietstocht brengt je veilig en moeiteloos van Montrond-les-Bains naar Bellegarde-en-Forez."
    ]
  },
