  "rdfs:comment": {
    "de": [
      "Das Hotel La Terrasse befindet sich im Herzen des kleinen Dorfes Vieillevie am Ufer des Flusses Lot im äußersten Süden des Departements Cantal."
    ],
    "en": [
      "The La Terrasse hotel is located in the heart of the little village of Vieillevie, close to the Lot River, at the extreme south of Cantal."
    ],
    "it": [
      "L'hotel La Terrasse si trova nel cuore del piccolo villaggio di Vieillevie, sulle rive del fiume Lot, nell'estremo sud del dipartimento del Cantal."
    ],
    "fr": [
      "L'hôtel La Terrasse est situé au cœur du petit village de Vieillevie, en bordure de la rivière Lot, à l'extrême sud du département du Cantal."
    ],
    "nl": [
      "Het hotel La Terrasse ligt in het hart van het kleine dorpje Vieillevie, aan de oevers van de rivier de Lot, in het uiterste zuiden van de Cantal."
    ],
    "es": [
      "El hotel La Terrasse está situado en el corazón del pequeño pueblo de Vieillevie, a orillas del río Lot, en el extremo sur del departamento de Cantal."
    ]
  },
