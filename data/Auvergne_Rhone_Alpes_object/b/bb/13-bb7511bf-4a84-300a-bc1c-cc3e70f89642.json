  "rdfs:comment": {
    "de": [
      "Das Gemeindebad von Jarrie ist ein Freibad mit einem großen Schwimmbecken, einem Spielbecken und einem Planschbecken für die ganz Kleinen.\r\nSnackbar im Sommer geöffnet."
    ],
    "en": [
      "The Jarrie municipal swimming pool is an open-air pool, equipped with a large swimming pool, a fun pool and a paddling pool for toddlers.\r\nSnack bar open in summer."
    ],
    "it": [
      "La piscina comunale di Jarrie è una piscina all'aperto, dotata di una grande vasca per il nuoto, una vasca per i giochi e una vasca per i bambini.\r\nSnack bar aperto in estate."
    ],
    "fr": [
      "La piscine municipale de Jarrie est une piscine de plein air, équipée d'un grand bassin de natation, d'un bassin ludique et d'une pataugeoire pour les tous petits.\r\nSnack ouvert l'été."
    ],
    "es": [
      "La piscina municipal de Jarrie es una piscina al aire libre con una gran piscina, una piscina lúdica y una piscina infantil.\r\nBar abierto en verano."
    ],
    "nl": [
      "Het gemeentelijk zwembad van Jarrie is een openluchtzwembad, uitgerust met een groot zwembad, een speelbad en een peuterbad voor de allerkleinsten.\r\nSnackbar geopend in de zomer."
    ]
  },
