  "rdfs:comment": {
    "de": [
      "Einführung in die natürliche Parfümerie.\r\nEin Eintauchen in die fantastische Welt der Gerüche! Entdecken Sie die wichtigsten Rohstoffe der Parfümerie, bevor Sie sich an die Komposition machen."
    ],
    "en": [
      "An introduction to natural perfumery.\r\nA plunge into the fantastic world of scents! Discover the key raw materials used in perfumery before starting to compose."
    ],
    "it": [
      "Un'introduzione alla profumeria naturale.\r\nUn tuffo nel fantastico mondo dei profumi! Scoprite le principali materie prime utilizzate in profumeria prima di iniziare a creare le vostre composizioni."
    ],
    "fr": [
      "Initiation à la parfumerie naturelle. \r\nUne plongée dans le monde fantastique des odeurs ! Découverte des matières premières phares de la parfumerie avant de se lancer dans la composition."
    ],
    "es": [
      "Introducción a la perfumería natural.\r\nUna inmersión en el fantástico mundo de los aromas Descubra las principales materias primas utilizadas en perfumería antes de empezar a crear sus propias composiciones."
    ],
    "nl": [
      "Een kennismaking met natuurlijke parfumerie.\r\nEen duik in de fantastische wereld van geuren! Ontdek de belangrijkste grondstoffen die in de parfumerie worden gebruikt voordat je begint met het maken van je eigen composities."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier parfum : \"Entrée en matières\""
    ]
  },
