  "rdfs:comment": {
    "de": [
      "Für das Vergnügen ... Egal, welchen Skistil oder welche Disziplin Sie bevorzugen, die 65 Skilehrerinnen und Skilehrer werden Ihnen die unerlässlichen Techniken beibringen und Ihnen das volle Vergnügen vermitteln."
    ],
    "en": [
      "For your enjoyment...Learn to ski with our 65 instructors."
    ],
    "it": [
      "Per il piacere... Qualunque sia il vostro stile o la vostra disciplina sciistica, i 65 maestri vi insegneranno le tecniche essenziali e vi regaleranno un piacere totale."
    ],
    "fr": [
      "Pour le plaisir... Quelque soit votre style de ski ou votre discipline, les 65 moniteurs et monitrices sauront vous apprendre les techniques indispensables et vous transmettre un plaisir total."
    ],
    "nl": [
      "Voor jouw plezier... Wat je skistijl of -discipline ook is, onze 65 instructeurs zullen je de essentiële technieken bijbrengen en je volledig laten genieten."
    ],
    "es": [
      "Por el placer... Sea cual sea su estilo o disciplina de esquí, los 65 instructores le enseñarán las técnicas esenciales y le proporcionarán un placer total."
    ]
  },
