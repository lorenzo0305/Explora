  "rdfs:comment": {
    "de": [
      "Als ein junger Wikinger sich der Tradition widersetzt und sich mit einem wilden Drachen anfreundet, müssen sie gemeinsam gegen alle Widerstände kämpfen, um ihre beiden Welten zu retten. Erleben Sie diesen fesselnden Film der DreamWorks Studios als Filmkonzert."
    ],
    "en": [
      "When a young Viking defies tradition and befriends a fierce dragon, they must fight together against all odds to save both their worlds. Discover this captivating film from DreamWorks Studios in ciné-concert."
    ],
    "it": [
      "Quando un giovane vichingo sfida la tradizione e fa amicizia con un feroce drago, i due devono combattere insieme contro ogni probabilità per salvare entrambi i loro mondi. Scoprite questo avvincente film dei DreamWorks Studios in concerto."
    ],
    "fr": [
      "Quand un jeune Viking défie la tradition et se lie d’amitié avec un dragon féroce, ils doivent lutter ensemble contre vents et marées pour sauver leurs deux mondes. Découvrez ce film captivant des studios DreamWorks en ciné-concert."
    ],
    "nl": [
      "Wanneer een jonge Viking de traditie trotseert en bevriend raakt met een woeste draak, moeten ze samen tegen alle verwachtingen in vechten om hun beider werelden te redden. Ontdek deze meeslepende film van DreamWorks Studios in concert."
    ],
    "es": [
      "Cuando un joven vikingo desafía la tradición y se hace amigo de un feroz dragón, deben luchar juntos contra viento y marea para salvar sus dos mundos. Descubre esta cautivadora película de DreamWorks Studios en concierto."
    ]
  },
