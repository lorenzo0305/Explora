  "rdfs:comment": {
    "de": [
      "1-10 Galerie, der Abdruck der Kunst\r\nMurielle Campillo Lädt Sie ein, die vielen Facetten der Kunst zu erkunden.\r\nKreationen, Ausstellungen, Schulungen\r\nKunstworkshops für Kinder\r\nZeichnen und Malen, Töpfern, Aquarell, Acryl, Öl..."
    ],
    "en": [
      "1-10 Galerie, the imprint of art\r\nMurielle Campillo invites you to explore the many facets of art.\r\nCreations, Exhibitions, Training\r\nArt workshops for children\r\ndrawing and painting, pottery, watercolor, acrylic, oil..."
    ],
    "it": [
      "1-10 Galerie, l'impronta dell'arte\r\nMurielle Campillo vi invita a esplorare le molteplici sfaccettature dell'arte.\r\nCreazioni, mostre, formazione\r\nLaboratori d'arte per bambini, disegno e pittura, ceramica, acquerello, acrilico, olio..."
    ],
    "fr": [
      "1-10 Galerie, l'empreinte de l'art \r\nMurielle Campillo vous Invite à explorer les multiples facettes de l'art.\r\nCréations, Expositions, Formations\r\nAteliers d'arts plastiques pour les enfants du dessin et peinture,  poterie , aquarelle, Acrylique, Huile..."
    ],
    "es": [
      "1-10 Galerie, la huella del arte\r\nMurielle Campillo le invita a explorar las múltiples facetas del arte.\r\nCreaciones, exposiciones, formación\r\nTalleres de arte para niños\r\ndibujo y pintura, cerámica, acuarela, acrílico, óleo..."
    ],
    "nl": [
