  "rdfs:comment": {
    "de": [
      "Ab Herbst 2027 wird Julien Clerc sein großes Bühnen-Comeback feiern und in der LDLC Arena in Lyon-Décines weiterhin mit zeitloser Eleganz von der Liebe und dem Leben singen"
    ],
    "en": [
      "From autumn 2027, Julien Clerc will be back on stage, singing about love and life with timeless elegance at the LDLC Arena in Lyon-Décines"
    ],
    "it": [
      "A partire dall'autunno 2027, Julien Clerc tornerà sul palco, cantando l'amore e la vita con un'eleganza senza tempo all'Arena LDLC di Lione-Décines"
    ],
    "fr": [
      "A partir de l’automne 2027, Julien Clerc fera son grand retour sur scène et continuera de chanter l’amour et la vie avec une élégance intemporelle à la LDLC Arena de Lyon-Décines"
    ],
    "nl": [
      "Vanaf de herfst van 2027 staat Julien Clerc weer op het podium en zingt hij met tijdloze elegantie over de liefde en het leven in de LDLC Arena in Lyon-Décines"
    ],
    "es": [
      "A partir del otoño de 2027, Julien Clerc volverá a los escenarios para cantar al amor y a la vida con una elegancia atemporal en el LDLC Arena de Lyon-Décines"
    ]
  },
