  "rdfs:comment": {
    "de": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Stellen Sie sich Ihre Herausforderung so zusammen, wie Sie es wünschen: Stellen Sie sich einem kompletten Wettkampf über 3 Tage, nehmen Sie an einer einzigen Etappe teil oder wählen Sie jeden Tag eine andere Etappe."
    ],
    "en": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Compose your challenge as you wish: take on a complete 3-day event, take part in a single stage, or choose a different stage each day."
    ],
    "it": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Componete la vostra sfida come preferite: affrontate un evento completo di 3 giorni, partecipate a una sola tappa o scegliete una tappa diversa ogni giorno."
    ],
    "fr": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Composez votre défi comme vous le souhaitez : relevez une épreuve complète sur 3 jours, participez à une seule étape, ou choisissez une étape différente chaque jour."
    ],
    "nl": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Stel je uitdaging samen zoals jij dat wilt: neem een compleet 3-daags evenement aan, neem deel aan slechts één etappe of kies elke dag een andere etappe."
    ],
    "es": [
      "Baroudeurs des Alpes / Ultra Raid Samoëns - Grand Massif. Organiza tu desafío como quieras: prueba completa de 3 días, participa en una sola etapa o elige una etapa diferente cada día."
    ]
  },
