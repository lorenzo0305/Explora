  "rdfs:comment": {
    "de": [
      "Möchten Sie ein unvergessliches Erlebnis in Aussois haben? Théo CAMUS, diplomierter Lehrer DEJEPS, nimmt Sie mit auf einen Zweisitzer, um die Schönheit der Landschaft der Vanoise aus der Vogelperspektive zu betrachten."
    ],
    "en": [
      "Looking for an unforgettable experience in Aussois? Théo CAMUS will take you on a bi-plane flight to contemplate the beauty of the Vanoise landscape from the air."
    ],
    "it": [
      "Cercate un'esperienza indimenticabile ad Aussois? Théo CAMUS, istruttore qualificato DEJEPS, vi accompagnerà in un volo in tandem per ammirare la bellezza del paesaggio della Vanoise dall'alto."
    ],
    "fr": [
      "Vous souhaitez vivre une expérience inoubliable à Aussois ? Théo CAMUS moniteur diplômé DEJEPS  vous emmène en bi-place contempler la beauté du paysage de la Vanoise vue du ciel."
    ],
    "es": [
      "¿Busca una experiencia inolvidable en Aussois? Théo CAMUS, instructor cualificado de DEJEPS, le llevará en un vuelo en tándem para admirar la belleza del paisaje de la Vanoise desde el aire."
    ],
    "nl": [
      "Op zoek naar een onvergetelijke ervaring in Aussois? Théo CAMUS neemt je mee in een tweezitter om de schoonheid van het landschap van de Vanoise vanuit de lucht te bewonderen."
    ]
  },
