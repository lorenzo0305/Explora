  "rdfs:comment": {
    "de": [
      "Jumpen Sie mit der Familie oder mit Freunden!\r\nTrampolinpark Valence, das sind 1850 m² an Aktivitäten und miteinander verbundenen Trampolinen (Basket Dunk, Trampolinarena, Air Bag)."
    ],
    "en": [
      "Come and jump with your family or friends !\r\n1850 m² of activities and interconnected trampolines (Basket dunk, Trampoline arena, Air Bag).\r\nNews! \"Twister\": Two rotating arms that must be avoided and \"You Jump Warrior\" inspired by the legendary journey of heroes!\r\nKid's Land space for 1 to 6 year olds.\r\n1 hour session."
    ],
    "it": [
      "Venite a saltare con la vostra famiglia o i vostri amici!\r\nIl Trampoline Park Valence è costituito da 1850 m² di attività e trampolini interconnessi (Basket dunk, Trampoline arena, Air Bag)."
    ],
    "fr": [
      "Venez jumper en famille ou entre ami(e)s !\r\nTrampoline Park Valence, c'est 1850 m² d’activités et de trampolines interconnectés (Basket dunk, Trampoline arena, Air Bag)."
    ],
    "es": [
      "¡Venga a saltar con su familia o amigos!\r\nTrampoline Park Valence es 1850 m² de actividades y trampolines interconectados (Basket dunk, Trampoline arena, Air Bag)."
    ],
    "nl": [
      "Kom en spring met je familie of vrienden!\r\nTrampolinepark Valence biedt 1850 m² aan activiteiten en onderling verbonden trampolines (Basket dunk, Trampoline arena, Air Bag)."
    ]
  },
