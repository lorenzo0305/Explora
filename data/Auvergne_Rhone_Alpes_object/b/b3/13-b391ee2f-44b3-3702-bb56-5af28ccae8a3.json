  "rdfs:comment": {
    "de": [
      "Die Bahnsteige bleiben vom ersten bis zum letzten fahrenden Zug zugänglich, mit Ausnahme des Fahrkartenschalters (Fahrpläne können geändert werden)."
    ],
    "en": [
      "Platforms remain accessible from the 1st train to the last running train, except for the ticket office (timetable subject to change)."
    ],
    "it": [
      "I binari rimangono accessibili dal primo all'ultimo treno, ad eccezione della biglietteria (gli orari sono soggetti a modifiche)."
    ],
    "fr": [
      "Les quais restent accessibles du 1er train au dernier train en circulation, sauf le guichet (horaires modifiables)."
    ],
    "es": [
      "Los andenes permanecen accesibles desde el primer tren hasta el último, excepto la taquilla (horarios sujetos a cambios)."
    ],
    "nl": [
      "De perrons blijven toegankelijk van de 1e tot de laatste trein die rijdt, met uitzondering van het loket (dienstregelingen onder voorbehoud)."
    ]
  },
