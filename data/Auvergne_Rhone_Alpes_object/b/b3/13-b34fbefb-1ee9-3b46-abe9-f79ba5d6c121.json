  "rdfs:comment": {
    "de": [
      "Bauernhof in Familienbesitz ? Käse vom Bauernhof & regionale Produkte\r\nWir stellen auf unserem Bauernhof authentische Produkte her, die auf handwerklichem Können beruhen und direkt verkauft werden."
    ],
    "en": [
      "Family farm ? Farmhouse cheeses & local produce\r\nWe make authentic products on our farm, based on traditional know-how and sold directly."
    ],
    "it": [
      "Fattoria di famiglia? Formaggi di fattoria e prodotti locali\r\nRealizziamo prodotti autentici di fattoria, utilizzando il know-how tradizionale, e li vendiamo direttamente."
    ],
    "fr": [
      "Ferme familiale – Fromages fermiers & produits du terroir\r\nNous fabriquons à la ferme des produits authentiques, issus d’un savoir-faire artisanal et vendus en direct."
    ],
    "es": [
      "Granja familiar ? Quesos de granja y productos locales\r\nElaboramos auténticos productos de granja, con el saber hacer tradicional, y los vendemos directamente."
    ],
    "nl": [
      "Familieboerderij ? Boerenkazen en streekproducten\r\nWe maken authentieke boerderijproducten met traditionele knowhow en verkopen ze rechtstreeks."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Ferme de la Roche d'Or"
    ]
  },
