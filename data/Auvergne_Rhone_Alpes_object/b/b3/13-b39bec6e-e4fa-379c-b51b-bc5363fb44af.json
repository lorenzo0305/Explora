  "rdfs:comment": {
    "de": [
      "Willkommen in Balmes le Château.\r\nDas einzige Schloss der Welt, das von seinen biologischen Lavendelfeldern umgeben ist. Das Schloss aus dem Jahr 1827 wurde komplett renoviert und befindet sich auf einem 9 Hektar großen Grundstück. Es liegt an der Spitze der Provence und ist ideal für Familien geeignet."
    ],
    "en": [
      "Welcome to Balmes le Château.\r\nThe only château in the world surrounded by fields of organic lavender. Château dating from 1827, entirely renovated, on a 9-hectare estate, at the forefront of Provence, ideally located for family gatherings."
    ],
    "it": [
      "Benvenuti a Balmes le Château.\r\nL'unico castello al mondo circondato da campi di lavanda biologica. Un castello del 1827, completamente ristrutturato, in una tenuta di 9 ettari, all'avanguardia in Provenza, in posizione ideale per le famiglie."
    ],
    "fr": [
      "Bienvenue à Balmes le Château.\r\nLe seul château au monde entouré de ses champs de lavande biologique. Château datant de 1827, entièrement rénové, sur un Domaine de 9 hectares, à l’avant-garde de la Provence, idéalement situé pour rassembler familles."
    ],
    "nl": [
      "Welkom in Balmes le Château.\r\nHet enige kasteel ter wereld omringd door velden met biologische lavendel. Een kasteel uit 1827, volledig gerenoveerd, op een landgoed van 9 hectare, aan de rand van de Provence, ideaal gelegen voor gezinnen."
    ],
    "es": [
      "Bienvenido a Balmes le Château.\r\nEl único castillo del mundo rodeado de campos de lavanda biológica. Un château de 1827, completamente renovado, en una finca de 9 hectáreas, a la vanguardia de la Provenza, idealmente situado para familias."
    ]
  },
