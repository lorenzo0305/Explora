  "rdfs:comment": {
    "de": [
      "Wir bieten Ihnen eine Speisekarte, die in Zusammenarbeit mit unseren lokalen Produzenten erstellt wurde. Unsere gesunde Küche basiert auf frischen, edlen Produkten und respektiert die Jahreszeiten."
    ],
    "en": [
      "We offer you a menu elaborated in collaboration with our local producers, a healthy cuisine, based on fresh, noble and seasonal products."
    ],
    "it": [
      "Offriamo un menu sviluppato in collaborazione con i nostri produttori locali, una cucina sana, basata su prodotti freschi, nobili e di stagione."
    ],
    "fr": [
      "Nous vous proposons une carte élaborée en collaboration avec nos producteurs locaux, une cuisine saine, à base de produits frais, nobles et respectueux des saisons."
    ],
    "nl": [
      "Wij bieden een menu, ontwikkeld in samenwerking met onze lokale producenten, een gezonde keuken, gebaseerd op verse, edele en seizoensgebonden producten."
    ],
    "es": [
      "Ofrecemos un menú elaborado en colaboración con nuestros productores locales, una cocina sana, basada en productos frescos, nobles y de temporada."
    ]
  },
