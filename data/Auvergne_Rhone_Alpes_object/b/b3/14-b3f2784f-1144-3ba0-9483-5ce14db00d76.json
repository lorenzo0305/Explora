  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bcec8fc0-6d10-39ba-8d46-0b0fe3f1fa35",
      "dc:description": {
        "de": [
          "Alle Reinigungsarbeiten :\nFenster, Böden, Wände, Teppiche.\nReinigung von Wohnungen vor und nach der Vermietung, Reinigung nach Baustellen, Instandhaltung von Miteigentümern, Büros."
        ],
        "en": [
          "All cleaning jobs:\nWindows, floors, walls, carpets...\nPre-rental and post-rental cleaning, post-construction cleaning, maintenance of condominiums and offices."
        ],
        "it": [
          "Tutti i lavori di pulizia:\nFinestre, pavimenti, pareti, tappeti, ecc.\nPulizie residenziali pre e post affitto, pulizia di cantieri, manutenzione di immobili e uffici in comproprietà."
        ],
        "fr": [
          "Tous travaux de nettoyage :\nVitres, sols, murs, moquettes... \nNettoyage logement avant et après location, nettoyage après chantier, entretien de co-propriétés, bureaux."
        ],
        "es": [
          "Todos los trabajos de limpieza:\nVentanas, suelos, paredes, alfombras, etc.\nLimpieza residencial previa y posterior al alquiler, limpieza después de obras, mantenimiento de propiedades en copropiedad y oficinas."
        ],
        "nl": [
          "Alle schoonmaakklussen:\nRamen, vloeren, muren, tapijten, enz.\nPre-let en post-let residentiële schoonmaak, schoonmaak na bouwwerven, onderhoud van mede-eigendom en kantoren."
        ]
      },
      "@type": [
        "Description"
      ],
