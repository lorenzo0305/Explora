  "rdfs:comment": {
    "de": [
      "Vertical Way bietet Ihnen Aktivitäten an, die von staatlich geprüften Fachleuten betreut werden, die leidenschaftlich und begeistert sind, Ihnen ihre Welt zu zeigen: Cayoning, Klettern oder auch Klettersteige."
    ],
    "en": [
      "Vertical Way offers a range of activities supervised by qualified professionals who are enthusiastic about helping you discover their world: cayoning, climbing and via ferrata."
    ],
    "it": [
      "Vertical Way offre una serie di attività supervisionate da professionisti qualificati, entusiasti di farvi scoprire il loro mondo: cayoning, arrampicata e via ferrata."
    ],
    "fr": [
      "Vertical Way vous propose des activités encadrées par des professionnels diplômés d'état passionnés et enthousiastes de vous faire découvrir leur univers : cayoning, escalade ou encore via ferrata."
    ],
    "es": [
      "Vertical Way te ofrece actividades supervisadas por profesionales con diploma estatal que se apasionan y entusiasman por hacerte descubrir su mundo: cayoning, escalada o vía ferrata."
    ],
    "nl": [
      "Vertical Way biedt een scala aan activiteiten onder begeleiding van gekwalificeerde professionals die enthousiast zijn om je hun wereld te laten ontdekken: cayoning, klimmen en via ferrata."
    ]
  },
