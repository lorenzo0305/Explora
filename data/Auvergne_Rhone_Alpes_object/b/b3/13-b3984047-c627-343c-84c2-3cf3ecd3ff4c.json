  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Geheimnisse eines Bienenvolkes. Lernen Sie die Königin kennen. Folgen Sie einer Biene von ihrer Geburt bis zur Bestäubung der Blume. Wachs- und Kerzenworkshop, Verkostung."
    ],
    "en": [
      "Discover the secrets of a bee colony. Meet the queen bee. Follow a bee from its birth to the pollination of the flower. Wax and candle workshop, tasting."
    ],
    "it": [
      "Entrate nei segreti di una colonia di api. Vi presentiamo l'ape regina. Seguite un'ape dalla sua nascita all'impollinazione del fiore. Laboratorio di cera e candele, degustazione."
    ],
    "fr": [
      "Pénétrez les secrets d’une colonie d’abeilles. Partez à la rencontre de la reine. Suivez une abeille depuis sa naissance jusqu’à la pollinisation de la fleur. Atelier cire et bougie, dégustation."
    ],
    "nl": [
      "Kom binnen in de geheimen van een bijenkolonie. Ontmoet de bijenkoningin. Volg een bij vanaf zijn geboorte tot de bestuiving van de bloem. Was en kaarsen workshop, proeverij."
    ],
    "es": [
      "Adéntrese en los secretos de una colonia de abejas. Conoce a la abeja reina. Siga a una abeja desde su nacimiento hasta la polinización de la flor. Taller de cera y velas, degustación."
    ]
  },
  "rdfs:label": {
    "fr": [
      "A la découverte des abeilles"
    ]
  },
