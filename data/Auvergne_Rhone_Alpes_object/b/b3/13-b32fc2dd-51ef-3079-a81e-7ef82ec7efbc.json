  "rdfs:comment": {
    "de": [
      "Neben der Burg Ruphy und gegenüber der Bucht von Talloires finden Sie einen Wiesenstrand mit Teilschatten und herrlichen Ausblicken."
    ],
    "en": [
      "Next to the Château de Ruphy and across from the Baie de Talloires is a grassy, partially shady beach, with a stunning view."
    ],
    "it": [
      "Accanto al Castello di Ruphy e davanti alla Baia di Talloires, scoprite una spiaggia di erba e parzialmente ombreggiata, dal panorama stupendo."
    ],
    "fr": [
      "Face au célèbre Châteauvieux, découvrez une plage en herbe et partiellement ombragée, au superbe panorama."
    ],
    "nl": [
      "Naast het kasteel van Ruphy, en net tegenover de Baai van Talloires, ligt een gedeeltelijk beschutte zonneweide met een schitterend vergezicht."
    ],
    "es": [
      "Frente al famoso Châteauvieux, descubra una playa de hierba, en parte sombreada y con un magnífico panorama."
    ]
  },
