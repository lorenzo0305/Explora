  "rdfs:comment": {
    "de": [
      "Seit 1926 , im Herzen von Vichy, in der gleichen Familie von Konditoren. Die Tradition der Süßwarenherstellung der Königin der Kurstädte und die süßen und schokoladigen Spezialitäten der Gegenwart."
    ],
    "en": [
      "Since 1926, in the heart of Vichy, in the same family of confectioners. The confectionery tradition of the queen of the water cities and the sweet and chocolatey specialities of the present."
    ],
    "it": [
      "Dal 1926, nel cuore di Vichy, nella stessa famiglia di pasticceri. La tradizione dolciaria della regina delle città d'acqua e le specialità dolciarie e di cioccolato del presente."
    ],
    "fr": [
      "Depuis 1926 , au coeur de Vichy, dans la même famille de confiseurs. La tradition de la confiserie de la reine des villes d'eaux et les spécialités sucrées et chocolatées du présent."
    ],
    "nl": [
      "Sinds 1926, in het hart van Vichy, in dezelfde familie van banketbakkers. De banketbakkerstraditie van de koningin van de watersteden en de zoete en chocoladespecialiteiten van nu."
    ],
    "es": [
      "Desde 1926, en el corazón de Vichy, en la misma familia de pasteleros. La tradición pastelera de la reina de las ciudades del agua y las especialidades dulces y de chocolate del presente."
    ]
  },
  "rdfs:label": {
