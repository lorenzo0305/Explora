  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/893a3168-7e50-36ca-a39c-b72de7dc3265",
      "dc:description": {
        "de": [
          "Verleih von Stadt-, Freizeit- und Elektrofahrrädern für Erwachsene und Kinder (keine Mountainbikes)\nHelm, Schloss und Korb werden gestellt\n\nGeöffnet von 10:00 bis 19:00 Uhr an jedem Wochenende und an allen Tagen der Schulferien.\nKeine Reservierungen."
        ],
        "en": [
          "Rental of city, leisure and electric bikes for adults and children (no mountain bikes)\nHelmet, lock and basket provided\n\nOpen from 10am to 7pm every weekend and every day of the school holidays.\nNo reservations."
        ],
        "it": [
          "Noleggio di biciclette da città, da tempo libero ed elettriche per adulti e bambini (no mountain bike)\nCasco, lucchetto e cestino in dotazione\n\nAperto dalle 10 alle 19 tutti i fine settimana e tutti i giorni durante le vacanze scolastiche.\nNessuna prenotazione."
        ],
        "fr": [
          "Location de vélos de ville, de loisirs et électriques adulte et enfant (pas de VTT)\nCasque, antivol et panier fournis\n\nOuvert de 10h00 à 19h00  tous les week-ends et tous les jours des vacances scolaires.\nPas de réservations."
        ],
        "nl": [
          "Verhuur van stads-, vrijetijds- en elektrische fietsen voor volwassenen en kinderen (geen mountainbikes)\nHelm, slot en mandje aanwezig\n\nGeopend van 10 tot 19 uur elk weekend en elke dag tijdens de schoolvakanties.\nGeen reserveringen."
        ],
        "es": [
          "Alquiler de bicicletas urbanas, de ocio y eléctricas para adultos y niños (no hay bicicletas de montaña)\nCasco, candado y cesta proporcionados\n\nAbierto de 10 a 19 horas todos los fines de semana y todos los días durante las vacaciones escolares.\nNo hay reservas."
        ]
      },
      "@type": [
        "Description"
      ],
