  "rdfs:comment": {
    "de": [
      "Le Soleil d'Or musste die Thermalvergangenheit der Region würdigen, indem es ein Eintauchen in die natürlichen Elemente Stein, Wasser und Pflanzen anbietet."
    ],
    "en": [
      "The Soleil d’Or is dedicated to paying tribute to the region’s thermal past by offering a close immersion into the different natural elements: stone, water and vegetal."
    ],
    "it": [
      "Soleil d'Or doveva rendere omaggio al passato termale della regione offrendo un'immersione negli elementi naturali: pietra, acqua e piante"
    ],
    "fr": [
      "Le Soleil d’Or se devait de rendre hommage au passé thermal de la région en proposant une immersion au plus près des éléments naturels : la pierre, l’eau et le végétal."
    ],
    "nl": [
      "Le Soleil d'Or is een eerbetoon aan het kuurverleden van de regio en biedt een onderdompelingservaring die zo dicht mogelijk bij de natuurlijke elementen staat: steen, water en planten."
    ],
    "es": [
      "Le Soleil d'Or es un homenaje al pasado balneario de la región, que ofrece una experiencia de inmersión lo más cercana posible a los elementos naturales: piedra, agua y plantas."
    ]
  },
