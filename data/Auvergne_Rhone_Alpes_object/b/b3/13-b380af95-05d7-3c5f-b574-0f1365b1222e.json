  "rdfs:comment": {
    "de": [
      "Zwei Abende, zehn Künstler auf der Bühne, ein Tag mit rund dreißig Aktivitäten und Freizeitangeboten in der Natur, die für alle offen sind - der Rahmen ist abgesteckt, um Sie ein Wochenende lang wieder willkommen zu heißen."
    ],
    "en": [
      "Two evenings, ten artists on stage, one day with some thirty activities and outdoor leisure activities open to all - the stage is set to welcome you back for a weekend."
    ],
    "it": [
      "Per la sesta edizione, 2 serate, 12 artisti sul palco, una giornata con una ventina di attività e attività ricreative all'aperto aperte a tutti, il palcoscenico è pronto ad accogliervi per un weekend!"
    ],
    "fr": [
      "Pour la 6ème édition, 2 soirées, 12 artistes sur scène, une journée avec une vingtaine d’activités et de loisirs en pleine nature ouverts à tous, le décor est planté pour vous accueillir de nouveau le temps d’un week-end !"
    ],
    "nl": [
      "Voor de 6e editie, 2 avonden, 12 artiesten op het podium, een dag met een twintigtal activiteiten en vrijetijdsactiviteiten in de buitenlucht die voor iedereen toegankelijk zijn, is het podium klaar om je terug te verwelkomen voor een weekend!"
    ],
    "es": [
      "Para la 6ª edición, 2 veladas, 12 artistas en escena, un día con una veintena de actividades y actividades de ocio al aire libre abiertas a todos, ¡el escenario está preparado para recibirle de nuevo durante un fin de semana!"
    ]
  },
