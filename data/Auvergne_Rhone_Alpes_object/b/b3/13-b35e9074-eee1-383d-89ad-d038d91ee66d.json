  "rdfs:comment": {
    "de": [
      "Die Fruitière ist der Ort, an dem Milch zu Käse verarbeitet wird und an dem die Früchte der Milch geerntet werden, daher der Name Fruitière."
    ],
    "en": [
      "The “Fruitière” is the place where milk is turned into cheese,where the fruit of the milk is collected, hence the word “fruitière”."
    ],
    "it": [
      "La Fruitière è il luogo in cui il latte viene trasformato in formaggio, dove viene raccolto il frutto del latte, da cui il nome \"fruitière\"."
    ],
    "fr": [
      "La Fruitière est l’endroit où l’on transforme le lait en fromage, où l’on récolte le fruit du lait, d’où le nom de fruitière."
    ],
    "nl": [
      "La Fruitière is de plek waar van melk kaas gemaakt worden of waar we het fruit van de melk oogsten, vandaar de naam Fruitière."
    ],
    "es": [
      "La Fruitière es el lugar donde la leche se transforma en queso, donde se recoge el fruto de la leche, de ahí el nombre de \"fruitière\"."
    ]
  },
