  "rdfs:comment": {
    "de": [
      "Das Wassersportzentrum verfügt über ein 25 m langes Sportbecken mit 5 Bahnen und ein 15 m x 8 m großes Lehrbecken. Außenbereich bestehend aus einem zweiten 25-m-Becken mit 5 Bahnen."
    ],
    "en": [
      "The nautical center is equipped with a sports pool of 25 m with 5 corridors and a learning pool of 15 m x 8 m. Outdoor area consisting of a second 25 m basin with 5 corridors."
    ],
    "it": [
      "Il centro acquatico dispone di una piscina sportiva di 25 metri con 5 corsie e di una piscina didattica di 15 metri x 8 metri. Un'area esterna con una seconda piscina da 25 m con 5 corsie."
    ],
    "fr": [
      "Le centre aquatique est équipé d'un bassin sportif de 25 m avec 5 couloirs et d'un bassin d'apprentissage de 15 m x 8 m. Espace extérieur composé d'un second bassin de 25 m avec 5 couloirs."
    ],
    "nl": [
      "Groot en klein overdekt zwembad. Openlucht zwembad in de zomer geopend."
    ],
    "es": [
      "El centro acuático cuenta con una piscina deportiva de 25 m con 5 carriles y una piscina de aprendizaje de 15 m x 8 m. Una zona exterior con una segunda piscina de 25 m y 5 calles."
    ]
  },
