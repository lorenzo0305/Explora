  "rdfs:comment": {
    "de": [
      "Hier finden Sie leckere Gerichte und Tagesmenüs, die mit frischen, saisonalen Produkten aus der lokalen Landwirtschaft zubereitet werden. Lassen Sie sich an diesem Ort des guten Geschmacks nieder, um zu schlemmen und zu genießen."
    ],
    "en": [
      "The time of a meal, find dishes and tasty menu of the day, prepared with seasonal products, fresh and from local agriculture. Settle into this tasteful landmark to feast and enjoy."
    ],
    "it": [
      "Per i pasti, potrete gustare piatti gustosi e menù giornalieri, preparati con prodotti freschi, coltivati localmente e di stagione. Sedetevi e godetevi un pasto in questo ristorante di buon gusto."
    ],
    "fr": [
      "Le temps d’un repas, retrouvez des plats et menu du jour savoureux, élaborés avec des produits de saison, frais et issus d’une agriculture locale. Installez-vous dans ce repère de bon goût pour vous régaler et apprécier."
    ],
    "es": [
      "Para comer, disfrute de sabrosos platos y menús diarios, elaborados con productos frescos, locales y de temporada. Siéntese y disfrute de una comida en este restaurante de buen gusto."
    ],
    "nl": [
      "Geniet van een maaltijd met smakelijke gerechten en dagschotels, bereid met verse, lokaal geteelde seizoensproducten. Ga lekker zitten en geniet van een heerlijke maaltijd in deze smaakvolle omgeving."
    ]
  },
  "rdfs:label": {
    "en": [
      "Les Cornettes brewery"
    ],
