  "rdfs:comment": {
    "de": [
      "Entdecken Sie dieses traditionelle Restaurant im Herzen des Dorfes.\r\nTraditionelle und originelle Gerichte aus frischen, lokalen Produkten werden Ihnen in einer gemütlichen Bistro-Atmosphäre angeboten."
    ],
    "en": [
      "Discover this traditional restaurant in the heart of the village.\r\nTraditional and original dishes made with fresh local produce are served in a warm bistro atmosphere."
    ],
    "it": [
      "Scoprite questo ristorante tradizionale nel cuore del villaggio.\r\nPiatti tradizionali e originali a base di prodotti freschi locali sono serviti in un'accogliente atmosfera da bistrot."
    ],
    "fr": [
      "Découvrez ce restaurant traditionnel au cœur du village.\r\nPlats traditionnels et originaux à base de produits frais et locaux vous sont proposés dans une ambiance de bistrot chaleureuse."
    ],
    "nl": [
      "Ontdek dit traditionele restaurant in het hart van het dorp.\r\nIn een gezellige bistrosfeer worden traditionele en originele gerechten geserveerd, bereid met verse streekproducten."
    ],
    "es": [
      "Descubra este restaurante tradicional en el corazón del pueblo.\r\nSe sirven platos tradicionales y originales elaborados con productos locales frescos en un acogedor ambiente de bistró."
    ]
  },
