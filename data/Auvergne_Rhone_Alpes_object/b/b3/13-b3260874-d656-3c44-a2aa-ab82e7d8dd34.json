  "rdfs:comment": {
    "de": [
      "Willkommen in Creys-Mépieu, einer Gemeinde im Osten der Balcons du Dauphiné in Nord-Isère. Entdecken Sie die Steingebäude inmitten der Natur, darunter das regionale Naturschutzgebiet der Étangs de Mépieu."
    ],
    "en": [
      "Welcome to Creys-Mépieu, a commune located to the east of the Balcons du Dauphiné in Nord-Isère. Discover its stone buildings in a natural setting, including the Étangs de Mépieu regional nature reserve."
    ],
    "it": [
      "Benvenuti a Creys-Mépieu, un comune situato a est dei Balcons du Dauphiné, nel Nord-Isère. Scoprite le sue costruzioni in pietra in un ambiente naturale, tra cui la riserva naturale regionale degli Étangs de Mépieu."
    ],
    "fr": [
      "Bienvenue à Creys-Mépieu, commune située à l’est des Balcons du Dauphiné en Nord-Isère. Découvrez ses édifices en pierre dans un écrin de nature dont la réserve naturelle régionale des Étangs de Mépieu."
    ],
    "nl": [
      "Welkom in Creys-Mépieu, een gemeente ten oosten van de Balcons du Dauphiné in Nord-Isère. Ontdek de stenen gebouwen in een natuurlijke omgeving, waaronder het regionale natuurreservaat Étangs de Mépieu."
    ],
    "es": [
      "Bienvenido a Creys-Mépieu, municipio situado al este de los Balcons du Dauphiné, en Nord-Isère. Descubra sus edificios de piedra en un entorno natural, incluida la reserva natural regional de Étangs de Mépieu."
    ]
  },
