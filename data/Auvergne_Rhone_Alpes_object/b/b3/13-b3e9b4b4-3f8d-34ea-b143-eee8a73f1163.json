  "rdfs:comment": {
    "de": [
      "Japan wird bei der 17. Ausgabe des Festivals EIN Land EIN Film im Mittelpunkt stehen. Insgesamt 40 Länder werden bei der 17. Ausgabe vertreten sein. 56 Filme, von denen 31 zum ersten Mal in Frankreich gezeigt werden, konkurrieren um die verschiedenen Preise des Festivals."
    ],
    "en": [
      "Japan takes center stage at the 17th edition of the UN Pays UN Film festival. A total of 40 countries will be represented at this 17th edition. 56 films, including 31 presented for the first time in France, will compete for the festival's various prizes."
    ],
    "it": [
      "Il Giappone sarà l'ospite d'onore della 17ª edizione del festival cinematografico UN Pays UN. In questa 17a edizione saranno rappresentati 40 Paesi. 56 film, di cui 31 presentati per la prima volta in Francia, si contenderanno i vari premi del festival."
    ],
    "fr": [
      "Le Japon sera à l'honneur de la 17e édition du festival UN Pays UN Film. En tout 40 pays seront représentés lors de cette 17e édition. 56 films dont 31 présentés pour la première fois en France concourront pour les différents prix du festival."
    ],
    "nl": [
      "Japan zal de eregast zijn op de 17e editie van het UN Pays UN Filmfestival. In totaal zullen 40 landen vertegenwoordigd zijn op deze 17e editie. 56 films, waaronder 31 die voor het eerst in Frankrijk worden gepresenteerd, dingen mee naar de verschillende prijzen van het festival."
    ],
    "es": [
      "Japón será el invitado de honor de la 17ª edición del festival de cine UN Pays UN. Un total de 40 países estarán representados en esta 17ª edición. 56 películas, 31 de ellas presentadas por primera vez en Francia, competirán por los diversos premios del festival."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Festival UN Pays UN Film - 17e édition"
    ]
  },
