  "rdfs:comment": {
    "de": [
      "Odile ist eine echte Handwerkerin im Bereich Mützen und Erbin eines von Generation zu Generation weitergegebenen Know-hows. Ihre Leidenschaft für Garn und Wolle hat ihre Wurzeln im Fachwissen ihrer Mutter, einer Schneiderin von Beruf, und ihrer Großmutter, einer begeisterten Strickerin."
    ],
    "en": [
      "Odile is a true artisan of hats, heir to a skill passed down from generation to generation. Her passion for yarn and wool has its roots in the expertise of her mother, a professional seamstress, and her grandmother, who was passionate about knitting."
    ],
    "it": [
      "Odile è una vera artigiana del bonnet, erede di competenze tramandate di generazione in generazione. La sua passione per i filati e la lana affonda le radici nell'esperienza di sua madre come sarta e nella passione di sua nonna per il lavoro a maglia."
    ],
    "fr": [
      "Odile est une véritable artisane du bonnet, héritière d’un savoir-faire transmis de génération en génération. Sa passion pour le fil et la laine trouve ses racines dans l’expertise de sa mère couturière de métier et de sa grand-mère, passionnée de tricot."
    ],
    "nl": [
      "Odile is een echte mutsenmaakster, erfgename van vaardigheden die van generatie op generatie zijn doorgegeven. Haar passie voor garen en wol is geworteld in haar moeders expertise als kleermaker en haar grootmoeders passie voor breien."
    ],
    "es": [
      "Odile es una auténtica artesana del capó, heredera de un saber hacer transmitido de generación en generación. Su pasión por los hilos y la lana tiene sus raíces en la pericia de su madre como modista y en la pasión de su abuela por tejer."
    ]
  },
  "rdfs:label": {
    "de": [
      "Odile Sureau - Designerin von Modeaccessoires"
    ],
    "en": [
      "Odile Sureau - fashion accessories designer"
    ],
    "fr": [
      "Odile Sureau - créatrice d’accessoires de mode"
    ]
  },
