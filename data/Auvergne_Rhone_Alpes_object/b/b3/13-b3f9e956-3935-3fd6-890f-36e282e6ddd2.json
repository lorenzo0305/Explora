  "rdfs:comment": {
    "de": [
      "WineYouWant? Der neue Tempel der Gastronomie und des Weins in Lyon! Eine kreative und saisonale Küche, 48 Weine im Glas, ein geschichtsträchtiger Ort am Fuße des Croix-Rousse? Jede Mahlzeit wird zu einem Erlebnis, das es zu teilen gilt. Entdecken Sie es ohne Mäßigung!"
    ],
    "en": [
      "WineYouWant — Lyon's new temple of food and wine! Creative, seasonal cuisine, 48 wines by the glass, a place steeped in history at the foot of the Croix-Rousse... Every meal becomes an experience to share. Discover it without moderation!"
    ],
    "it": [
      "WineYouWant? Il nuovo tempio della gastronomia e del vino a Lione! Cucina creativa e stagionale, 48 vini al bicchiere, un luogo ricco di storia ai piedi della Croix-Rousse? Ogni pasto diventa un'esperienza da condividere. Da scoprire senza moderazione!"
    ],
    "fr": [
      "WineYouWant — Le nouveau temple de la gastronomie et du vin à Lyon ! Une cuisine créative et de saison, 48 vins au verre, un lieu chargé d’histoire au pied de la Croix-Rousse… Chaque repas devient une expérience à partager. À découvrir sans modération !"
    ],
    "es": [
      "WineYouWant? El nuevo templo de la gastronomía y el vino en Lyon Cocina creativa y de temporada, 48 vinos por copa, un lugar cargado de historia a los pies de la Croix-Rousse? Cada comida se convierte en una experiencia para compartir. Para descubrir sin moderación"
    ],
    "nl": [
      "WineYouWant? De nieuwe tempel van gastronomie en wijn in Lyon! Een creatieve, seizoensgebonden keuken, 48 wijnen per glas, een plek met een rijke geschiedenis aan de voet van de Croix-Rousse? Elke maaltijd wordt een ervaring om te delen. Om te ontdekken zonder mate!"
    ]
  },
