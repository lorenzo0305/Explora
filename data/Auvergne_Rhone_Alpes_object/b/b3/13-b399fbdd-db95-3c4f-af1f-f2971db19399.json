  "rdfs:comment": {
    "de": [
      "Café mit spielerischen Elementen. Entdecken Sie den Spaß an Gesellschaftsspielen (wieder) und schlürfen Sie dabei eines der zahlreichen Getränke, die auf der Karte angeboten werden (Spirituosen, Bier, Softdrinks, Bubble Tea...). Kleine süße und herzhafte Snacks. Kinderecke."
    ],
    "en": [
      "Fun cafe. Come (re)discover the pleasure of board games while sipping one of the many beverages on the menu (alcohols, beers, soft drinks, bubble tea...). Snacks. Children's corner."
    ],
    "it": [
      "Caffè del divertimento. Venite a (ri)scoprire il piacere dei giochi da tavolo sorseggiando uno dei tanti drink proposti (alcolici, birre, soft, bubble tea...). Snack salati e dolci. Angolo per i bambini."
    ],
    "fr": [
      "Café ludique. Venez (re)découvrir le plaisir des jeux de société tout en sirotant une des nombreuses boissons proposées à la carte (alcools, bières, softs, bubble tea...). Petite restauration salée et sucrée. Coin enfants."
    ],
    "es": [
      "Un café divertido. Venga a (re)descubrir el placer de los juegos de mesa mientras saborea una de las muchas bebidas que se ofrecen (licores, cervezas, softs, té de burbujas...). Aperitivos salados y dulces. Rincón infantil."
    ],
    "nl": [
      "Gezellig café. Kom en (her)ontdek het plezier van gezelschapsspellen terwijl je nipt van een van de vele aangeboden drankjes (sterke dranken, bieren, softs, bubble tea...). Hartige en zoete snacks. Kinderhoek."
    ]
  },
  "rdfs:label": {
    "en": [
      "Le repaire des petits joueurs"
    ],
    "fr": [
      "Le repaire des petits joueurs"
    ]
  },
