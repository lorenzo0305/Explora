  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine Fahrt mit dem Dreirad und entdecken Sie die versteckten Schätze von Valencia!\r\nAbfahrt von Ihrem Hotel oder Ihrer Wohnung aus. Möglichkeit für maximal 4 Passagiere."
    ],
    "en": [
      "Treat yourself to a scooter ride and discover Valencia's hidden treasures!\r\nDepart from your hotel or home. Maximum of 4 passengers."
    ],
    "it": [
      "Concedetevi un giro in scooter e scoprite i tesori nascosti di Valencia!\r\nPartenza dal vostro hotel o da casa. Massimo 4 passeggeri."
    ],
    "fr": [
      "Offrez-vous une balade en triporteur et venez découvrir les trésors cachés de Valence !\r\nDépart de votre hôtel ou de votre domicile. Possibilité de 4 passagers maximum."
    ],
    "nl": [
      "Trakteer jezelf op een scootertocht en ontdek de verborgen schatten van Valencia!\r\nVertrek vanaf je hotel of thuis. Maximaal 4 passagiers."
    ],
    "es": [
      "Regálese un paseo en scooter y descubra los tesoros ocultos de Valencia\r\nSalida desde su hotel o domicilio. Máximo 4 pasajeros."
    ]
  },
  "rdfs:label": {
    "fr": [
