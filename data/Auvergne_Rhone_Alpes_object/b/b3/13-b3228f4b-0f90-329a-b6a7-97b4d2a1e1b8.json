  "rdfs:comment": {
    "de": [
      "Möbel, Geschirr, Spiele, Spielzeug, Werkzeuge, Bücher, CDs, Textilien, Möbel ... Sie wollen es nicht mehr? Werfen Sie nicht mehr weg! La Piste reCyclable sammelt alles und verkauft es zu niedrigen Preisen weiter."
    ],
    "en": [
      "Furniture, crockery, games, toys, tools, books, CDs, textiles ... You don't want it anymore? Don't throw it away! La Piste reCyclable recovers everything and resells it at low prices."
    ],
    "it": [
      "Mobili, stoviglie, giochi, giocattoli, utensili, libri, CD, tessuti... Non li volete più? Non buttateli via! La Piste reCyclable recupera tutto e lo rivende a prezzi bassi."
    ],
    "fr": [
      "Mobilier, vaisselle, jeux, jouets, outils, livres, CD, textile, meubles .. Vous n'en voulez plus ? Ne jetez plus ! La Piste reCyclable récupère tout et revend à bas prix."
    ],
    "es": [
      "Muebles, vajillas, juegos, juguetes, herramientas, libros, CD, textiles... ¿Ya no lo quieres? ¡No lo tires! La Piste reCyclable lo recupera todo y lo revende a bajo precio."
    ],
    "nl": [
      "Meubels, serviesgoed, spelletjes, speelgoed, gereedschap, boeken, cd's, textiel ... Wilt u het niet meer? Gooi het niet weg! La Piste reCyclable recupereert alles en verkoopt het tegen lage prijzen."
    ]
  },
