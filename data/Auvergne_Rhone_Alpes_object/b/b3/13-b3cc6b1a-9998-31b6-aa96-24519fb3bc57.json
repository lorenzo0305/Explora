  "rdfs:comment": {
    "de": [
      "Ausflüge mit Pferden und Ponys, die Sie mieten können.\r\nAm Fuße des Berges St Maurice begrüßen wir Groß und Klein zu einem gemeinsamen Erlebnis mit den Pferden von Le Rohan."
    ],
    "en": [
      "Horse and pony rides for hire.\r\nAt the foot of the St Maurice mountain, we welcome young and old to share a moment with the Rohan horses."
    ],
    "it": [
      "Noleggio di cavalli e pony.\r\nAi piedi della montagna di St Maurice, accogliamo grandi e piccini per condividere un momento con i cavalli Rohan."
    ],
    "fr": [
      "Randonnées à cheval et à poneys en location. \r\nAu pied de la montagne de St Maurice nous accueillons petits et grands pour un moment de partage avec les chevaux du Rohan."
    ],
    "nl": [
      "Verhuur van paard- en ponyritten.\r\nAan de voet van de St Maurice berg verwelkomen we jong en oud om een moment te delen met de Rohan paarden."
    ],
    "es": [
      "Alquiler de paseos a caballo y en poni.\r\nAl pie de la montaña St Maurice, damos la bienvenida a grandes y pequeños para compartir un momento con los caballos Rohan."
    ]
  },
  "rdfs:label": {
