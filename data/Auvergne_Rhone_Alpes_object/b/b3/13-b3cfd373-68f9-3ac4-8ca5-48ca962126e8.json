  "rdfs:comment": {
    "de": [
      "Schneeschuhwandern ermöglicht es, die winterliche Bergwelt auf sanfte und kontemplative Weise zu erleben! Wir bieten Ihnen ganz- oder halbtägige Wanderungen an, um die verschneiten Berge zu entdecken."
    ],
    "en": [
      "Snowshoeing is a gentle and contemplative way to explore the mountains in winter! We offer full-day or half-day excursions to discover the snow-covered mountains."
    ],
    "it": [
      "Le escursioni con le racchette da neve sono un modo dolce e contemplativo per esplorare le montagne invernali! Offriamo escursioni con le racchette da neve di un'intera giornata e di mezza giornata per scoprire le montagne innevate."
    ],
    "fr": [
      "La raquette permet d’aborder la montagne hivernale d’une manière douce et contemplative ! Nous vous proposons des randonnées à la journée ou à la demi-journée pour découvrir la montagne enneigé."
    ],
    "nl": [
      "Sneeuwschoenwandelen is een rustige en contemplatieve manier om de bergen in de winter te verkennen! Wij bieden excursies van een hele of halve dag aan om de met sneeuw bedekte bergen te ontdekken."
    ],
    "es": [
      "Las raquetas de nieve son una forma suave y contemplativa de explorar las montañas en invierno Ofrecemos excursiones con raquetas de nieve de día completo y medio día para descubrir las montañas nevadas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Jean-Luc TAMANINI :  Sortie raquettes"
    ]
  },
