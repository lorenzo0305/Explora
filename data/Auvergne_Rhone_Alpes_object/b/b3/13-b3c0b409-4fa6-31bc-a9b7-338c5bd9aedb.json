  "rdfs:comment": {
    "de": [
      "Sam'Branche bietet Ihnen die Möglichkeit, den Wald auf andere Weise zu entdecken, indem Sie in den Bäumen bis zu deren Wipfel klettern. Baumwanderung, Übernachtung in der Hängematte, Snacks oder Picknick im Freien, für Menschen mit motorischen Behinderungen geeignet."
    ],
    "en": [
      "Sam'Branche invites you to discover the forest in a different way, by climbing to the top of the trees. Arbro-trekking, night in a perched hammock, perched snack or picnic, adapted service for people with motor disabilities (adapted hull)..."
    ],
    "it": [
      "Sam'Branche offre un modo diverso di scoprire la foresta, salendo in cima agli alberi. Trekking sugli alberi, notte su un'amaca appollaiata, merenda o picnic da un trespolo, adattato alle persone con disabilità motorie."
    ],
    "fr": [
      "Sam'Branche propose de découvrir la forêt autrement en grimpant dans les arbres jusqu'à leur cîme. Arbro-randonnée, nuit en hamac perché, goûter ou pique nique perché, prestation adaptée pour personnes en situation de handicap moteur."
    ],
    "es": [
      "Sam'Branche ofrece una forma diferente de descubrir el bosque, subiendo a lo alto de los árboles. Senderismo por los árboles, noche en una hamaca encaramada, merienda o picnic desde una percha, adaptada para personas con discapacidad motriz."
    ],
    "nl": [
      "Sam'Branche biedt een andere manier om het bos te ontdekken, door naar de top van de bomen te klimmen. Boomtocht, nacht in een hangmat, snack of picknick vanaf een baars, aangepast voor mensen met een motorische handicap."
    ]
  },
