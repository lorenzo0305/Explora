  "rdfs:comment": {
    "de": [
      "Bildhauerei auf Stein, Metall und Holz. Originalkreationen auf Kopien und auf Bestellung. Elemente für die Architektur. Gartengestaltung, Steingarten, Brunnen, Land Art, Wasserspeier-Dekoration, Gravur. Kurse in Bildhauerei. Rufen Sie an, um einen Termin zu vereinbaren."
    ],
    "en": [
      "Sculpture in stone, metal and wood. Original creations by copy and commission. Architectural elements. Garden arrangements, rock gardens, fountains, land art, gargoyle decoration, engraving. Sculpture courses. Call to make an appointment."
    ],
    "it": [
      "Scultura in pietra, metallo e legno. Creazioni originali su copia e su commissione. Elementi architettonici. Progettazione di giardini, giardini rocciosi, fontane, land art, decorazione di doccioni, incisioni. Corsi di scultura. Chiamare per fissare un appuntamento."
    ],
    "fr": [
      "Sculpture sur pierre, métal et bois. Créations originales sur copie et sur commande. Éléments d'architecture. Aménagements pour jardin, rocaille, fontaine, land art, décoration gargouille, gravure. Cours de sculpture. Téléphonez pour prendre rendez-vous."
    ],
    "es": [
      "Escultura en piedra, metal y madera. Creaciones originales por copia y encargo. Elementos arquitectónicos. Diseño de jardines, rocallas, fuentes, land art, decoración de gárgolas, grabado. Cursos de escultura. Llame para concertar una cita."
    ],
    "nl": [
      "Beeldhouwwerk in steen, metaal en hout. Originele creaties door kopie en in opdracht. Architecturale elementen. Tuinontwerp, rotstuinen, fonteinen, land art, waterspuwer decoratie, graveren. Cursussen beeldhouwen. Bel voor een afspraak."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Atelier de sculpture Rouchon Jérome"
    ]
  },
