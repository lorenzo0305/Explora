  "rdfs:comment": {
    "de": [
      "Das Château la Robine liegt im Herzen der Drôme Provençale, in einer Gegend, die von Lavendel, Olivenbäumen und Trüffeln geprägt ist. In dieser magischen Umgebung wachsen die 30 Ha Weinberge des Weinguts sowie ein Olivenhain mit 100 Bäumen."
    ],
    "en": [
      "Château la Robine is located in the heart of the Drôme Provençale, in a land of lavender, olive trees and truffles. The estate's 30 hectares of vines and a hundred-tree olive grove grow in this magical setting."
    ],
    "it": [
      "Château la Robine si trova nel cuore della Drôme Provençale, in una terra di lavanda, ulivi e tartufi. È in questa magica cornice che crescono i 30 ettari di vigneti della tenuta, oltre a un uliveto con un centinaio di alberi."
    ],
    "fr": [
      "Le Château la Robine est situé au coeur de la Drôme Provençale, sur un territoire de lavande, d'oliviers et de truffes. C'est dans ce cadre magique que poussent les 30 Ha de vignes du domaine, ainsi qu'une oliveraie d'une centaine d'arbres."
    ],
    "es": [
      "El Château la Robine está situado en el corazón de la Drôme provenzal, en una tierra de lavanda, olivos y trufas. En este entorno mágico crecen las 30 hectáreas de vides de la finca, así como un olivar con un centenar de árboles."
    ],
    "nl": [
      "Château la Robine ligt in het hart van de Drôme Provençale, in een land van lavendel, olijfbomen en truffels. Deze magische omgeving herbergt 30 hectare wijngaarden en een olijfgaard met ongeveer honderd bomen."
    ]
  },
  "rdfs:label": {
