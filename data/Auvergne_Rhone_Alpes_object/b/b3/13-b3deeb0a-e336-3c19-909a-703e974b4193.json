  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der Rue Victor Hugo entfernt und an der Ecke des Place Ampère erwartet Sie ein kleines Stück Amerika. Probieren Sie unsere einzigartigen Bagel-Rezepte mit Nachos, Coleslaw oder Gewürzgurken."
    ],
    "en": [
      "A few steps from Victor Hugo street and at the corner of Place Ampère, a little corner of America awaits you. Come taste our unique bagel recipes with nachos, coleslaw or pickles."
    ],
    "it": [
      "A pochi passi da via Victor Hugo e all'angolo con piazza Ampère, vi aspetta un piccolo angolo d'America. Venite a gustare le nostre ricette uniche di bagel accompagnate da nachos, insalata di cavolo o sottaceti."
    ],
    "fr": [
      "À quelques pas de la rue Victor Hugo et à l’angle de la place Ampère, un petit coin d’Amérique vous attend. Venez déguster nos recettes uniques de bagels accompagnés de nachos, coleslaw ou pickles."
    ],
    "nl": [
      "Op een steenworp afstand van de Victor Hugo straat en op de hoek van de Place Ampère wacht u een klein hoekje Amerika. Kom en proef onze unieke bagel recepten vergezeld van nacho's, koolsla of augurken."
    ],
    "es": [
      "A pocos pasos de la calle Victor Hugo y en la esquina de la plaza Ampère, le espera un pequeño rincón de América. Venga a degustar nuestras exclusivas recetas de bagels acompañadas de nachos, ensalada de col o encurtidos."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Best Bagels Lyon Ampère"
    ]
  },
