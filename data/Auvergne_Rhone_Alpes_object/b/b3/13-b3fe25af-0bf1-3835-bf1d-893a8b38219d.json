  "rdfs:comment": {
    "de": [
      "Die Grange Dîmière aus dem Jahre 1655 ist ein ehemaliges Nebengebäude des Kartäuserklosters Sylve Bénite. Steinmauern, ein kolossaler Portalvorbau, meisterhafte Balkenwerke, die bis zu 18 m hoch reichen ... Der ideale Ort für Ausstellungen von zeitgenössischen Keramikskulpturen."
    ],
    "en": [
      "A former outbuilding of the Sylve Bénite Carthusian Monastery, the Grange Dîmière dates from 1655. With its stone walls, monumental porch and remarkable structure, rising to a height of 18m, today it offers the perfect location for staging contemporary, ceramic sculpture exhibitions."
    ],
    "it": [
      "Antica dépendance (XVII secolo) della Certosa di La Sylve Bénite, la Grange Dîmière era utilizzata per riscuotere le royalties in natura e conservare i raccolti. Oggi ospita sculture contemporanee in ceramica e spettacoli dal vivo"
    ],
    "fr": [
      "Ancienne dépendance (XVIIe) du Monastère Chartreux de la Sylve Bénite, la Grange Dîmière servait à recueillir les redevances en nature et à stocker les récoltes. C'est aujourd'hui un lieu dédié à la sculpture céramique contemporaine et au spectacle vivant"
    ],
    "nl": [
      "De Grange Dîmière, een voormalig bijgebouw (17e eeuw) van het kartuizerklooster van La Sylve Bénite, werd gebruikt om royalty's in natura te innen en oogsten op te slaan. Nu is het een plek voor hedendaagse keramische beeldhouwkunst en live optredens"
    ],
    "es": [
      "Antigua dependencia (siglo XVII) de la Cartuja de La Sylve Bénite, la Grange Dîmière servía para recaudar derechos en especie y almacenar las cosechas. En la actualidad es un espacio de escultura contemporánea en cerámica y espectáculos en vivo"
    ]
  },
  "rdfs:label": {
