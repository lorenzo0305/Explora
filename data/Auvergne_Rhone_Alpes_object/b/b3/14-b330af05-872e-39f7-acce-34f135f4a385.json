  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bdafaf36-5cf7-3ed3-9a63-700f2898cdde",
      "dc:description": {
        "de": [
          "Besuchen Sie den Weihnachtsmarkt in der Chèvrerie de la Planquette! Lokale Handwerker und Produzenten bieten Ihnen frische und leckere Produkte an, um Ihre Festtagstafeln zu verschönern"
        ],
        "en": [
          "Come and discover the Christmas market at the Chèvrerie de la Planquette! Local craftsmen and producers will be offering fresh, gourmet products to brighten up your festive tables"
        ],
        "it": [
          "Venite a scoprire il mercatino di Natale alla Chèvrerie de la Planquette! Artigiani e produttori locali venderanno prodotti freschi e gustosi per rallegrare le vostre tavole festive"
        ],
        "fr": [
          "Venez découvrir le marché de Noël à la Chèvrerie de la Planquette ! Des artisans et producteurs locaux vous proposeront des produits frais et gourmands pour embellir vos tables de fêtes"
        ],
        "es": [
          "Venga a descubrir el mercado navideño de la Chèvrerie de la Planquette Artesanos y productores locales venderán productos frescos y sabrosos para alegrar sus mesas festivas"
        ],
        "nl": [
          "Kom en ontdek de kerstmarkt in de Chèvrerie de la Planquette! Lokale ambachtslieden en producenten zullen verse, smakelijke producten verkopen om je feestelijke tafels op te fleuren"
        ]
      },
      "@type": [
        "Description"
