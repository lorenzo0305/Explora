  "rdfs:comment": {
    "de": [
      "Permakulturgärten, in denen das Lebendige mit der Hand angebaut wird. Wir produzieren Obst, aromatische Pflanzen und Blumen für Sträuße. Der Verkauf erfolgt während der Saison ab Hof oder an Gastronomen, die auf der Suche nach Qualitätsprodukten sind."
    ],
    "en": [
      "Permaculture gardens where living things are cultivated by hand. We produce fruit, herbs and flowers for bouquets. Sales are made at the farm during the season, or to restaurateurs looking for quality products."
    ],
    "it": [
      "Orti in permacultura dove gli esseri viventi vengono coltivati a mano. Produciamo frutta, piante aromatiche e fiori per bouquet. Le vendite vengono effettuate in azienda durante la stagione o ai ristoratori che cercano prodotti di qualità."
    ],
    "fr": [
      "Des jardins en permaculture où l'on cultive le vivant à la main. Nous produisons des fruits, des plantes aromatiques et des fleurs à bouquet. Les ventes se font à la ferme durant la saison ou aux restaurateurs en recherche de produits de qualité."
    ],
    "nl": [
      "Permacultuurtuinen waar levende dingen met de hand worden gekweekt. We produceren fruit, aromatische planten en bloemen voor boeketten. De verkoop gebeurt op de boerderij tijdens het seizoen of aan restauranthouders die op zoek zijn naar kwaliteitsproducten."
    ],
    "es": [
      "Huertos de permacultura en los que se cultivan seres vivos a mano. Producimos fruta, plantas aromáticas y flores para ramos. La venta se realiza en la granja durante la temporada o a restauradores que buscan productos de calidad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les Jardins de La Source Dorée"
    ]
  },
