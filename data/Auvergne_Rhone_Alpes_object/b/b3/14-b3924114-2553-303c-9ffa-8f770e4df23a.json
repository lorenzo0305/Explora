      "@id": "https://data.datatourisme.fr/a6a27fe7-9345-3bc0-acb4-8f01e30cafe2",
      "dc:description": {
        "de": [
          "Verkauf von Tabakwaren, FDJ-Produkten, Zigarrenkeller, Souvenirgeschenken, Schmuck, Spielzeug, Regionalpresse.\n\nÖffnungszeiten:\n- montag bis Samstag von 08:30 bis 13:00 Uhr und von 14:30 bis 19:30 Uhr."
        ],
        "en": [
          "Sale of tobacco, FDJ products, cigar cabinet, souvenir gifts, jewelry, toys, regional press.\n\nOpening hours :\n- monday to Saturday, 08:30 to 13:00 and 14:30 to 19:30."
        ],
        "it": [
          "Vendita di tabacco, prodotti FDJ, portasigari, souvenir, gioielli, giocattoli, stampa regionale.\n\nOrari di apertura:\n- dal lunedì al sabato, dalle 08:30 alle 13:00 e dalle 14:30 alle 19:30."
        ],
        "fr": [
          "Vente de tabac, produits FDJ, cave à cigares, cadeaux souvenirs, bijoux, jouets, presse régionale.\n\nHoraires :\n- du lundi au samedi de 08h30 à 13h et de 14h30 à 19h30."
        ],
        "nl": [
          "Verkoop van tabak, FDJ-producten, sigarenkabinet, souvenircadeaus, sieraden, speelgoed, regionale pers.\n\nOpeningstijden:\n- maandag tot zaterdag, 08:30 tot 13:00 en 14:30 tot 19:30."
        ],
        "es": [
          "Venta de tabaco, productos FDJ, vitrina de puros, regalos de recuerdo, joyas, juguetes, prensa regional.\n\nHorario de apertura:\n- de lunes a sábado, de 08:30 a 13:00 y de 14:30 a 19:30."
        ]
      },
