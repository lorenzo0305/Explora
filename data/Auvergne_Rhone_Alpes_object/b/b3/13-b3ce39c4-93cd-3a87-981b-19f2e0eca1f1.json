  "rdfs:comment": {
    "de": [
      "Magic Gate ist ein Geschäft, das Liebhaber von Halbedelsteinen und Mineralien mit energetischen Kräften glücklich machen wird. Ein kleiner Raum, der der Esoterik gewidmet ist und Pendel-Liebhaber glücklich machen wird."
    ],
    "en": [
      "Magic Gate is a boutique for lovers of semi-precious stones and minerals with energetic powers. A small space dedicated to esotericism that will delight clock lovers."
    ],
    "it": [
      "Magic Gate è un negozio che delizierà gli amanti delle pietre semipreziose e dei minerali con poteri energetici. Un piccolo spazio dedicato all'esoterismo che farà la gioia degli amanti degli orologi."
    ],
    "fr": [
      "Magic Gate est une boutique qui fera le bonheur des amoureux des pierres semi-précieuses et les minerais aux pouvoirs énergétiques. Un petit espace consacré à l’ésotérisme qui fera le bonheur des amateurs de pendules."
    ],
    "nl": [
      "Magic Gate is een winkel waar liefhebbers van halfedelstenen en mineralen met energetische krachten hun hart kunnen ophalen. Een kleine ruimte gewijd aan esoterie waar liefhebbers van klokken hun hart kunnen ophalen."
    ],
    "es": [
      "Magic Gate es una tienda que hará las delicias de los amantes de las piedras semipreciosas y los minerales con poderes energéticos. Un pequeño espacio dedicado al esoterismo que hará las delicias de los amantes de los relojes."
    ]
  },
  "rdfs:label": {
