  "rdfs:comment": {
    "de": [
      "Patronatsfest von Chassagnes mit Programm am Samstag: Aperitifbretter, Karaoke, Open-Air-Ball, aufblasbare Spiele. Sonntag: Essen, Boule-Wettbewerb, Feuerwerk & Ball, Animationen für Kinder (Hüpfburgen, Schminken....)"
    ],
    "en": [
      "Fête Patronale de Chassagnes with Saturday program: aperitif boards, karaoke, open-air ball, inflatable games. Sunday: meal, pétanque competition, fireworks & dance, children's entertainment (inflatables, face painting....)"
    ],
    "it": [
      "Festa patronale di Chassagnes con un programma il sabato: aperitivo a tavola, karaoke, ballo all'aperto, giochi gonfiabili. Domenica: pasto, gara di pétanque, fuochi d'artificio e ballo, animazione per bambini (strutture gonfiabili, face painting....)"
    ],
    "fr": [
      "Fête Patronale de Chassagnes avec au programme le samedi : planches apéros, karaoké, bal en plein air, jeux gonflables. Dimanche : repas, concours de pétanque, feu d'artifice & bal, animations pour les enfants (structures gonflables, maquillage....)"
    ],
    "nl": [
      "Patronaal Festival van de Chassagnes met een programma op zaterdag: aperitiefplanken, karaoke, openluchtdans, opblaasbare spelen. Zondag: maaltijd, petanquewedstrijd, vuurwerk en dans, animatie voor kinderen (opblaasbare structuren, schminken ....)"
    ],
    "es": [
      "Fiesta patronal de Chassagnes con un programa el sábado: tablas de aperitivos, karaoke, verbena, juegos hinchables. Domingo: comida, concurso de petanca, fuegos artificiales y baile, animaciones para niños (estructuras hinchables, pintacaras....)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Fête Patronale | Chassagnes"
    ]
  },
