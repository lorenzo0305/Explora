  "rdfs:comment": {
    "de": [
      "Das Hotel ist ein großes, authentisches und intimes Bergchalet, das sich an den höchsten Punkt des Ortes schmiegt. Es profitiert von einer außergewöhnlichen Lage in direkter Nähe zum Start der wichtigsten Skilifte und Skischulen."
    ],
    "en": [
      "The hotel is a large, authentic and intimate mountain chalet nestled at the highest point of the resort, in an exceptional location, right next to the main ski lifts and ski schools."
    ],
    "it": [
      "L'hotel è un grande chalet di montagna, autentico e intimo, situato nel punto più alto del resort e gode di una posizione eccezionale, proprio accanto ai principali impianti di risalita e alle scuole di sci."
    ],
    "fr": [
      "L'hôtel est un grand chalet de montagne authentique et intimiste niché au point haut de la station, bénéficiant d’une situation exceptionnelle, à proximité directe du départ des principales remontées mécaniques et des écoles de ski."
    ],
    "nl": [
      "Het hotel is een groot, authentiek en intiem bergchalet genesteld op het hoogste punt van het resort, op een uitzonderlijke locatie, direct naast de belangrijkste skiliften en skischolen."
    ],
    "es": [
      "El hotel es un amplio, auténtico e íntimo chalet de montaña enclavado en el punto más alto de la estación, que goza de una ubicación excepcional, justo al lado de los principales remontes y escuelas de esquí."
    ]
  },
