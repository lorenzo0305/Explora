  "rdfs:comment": {
    "de": [
      "Kleiner Snack oder echtes Mittagessen, willkommen im Jardin du Chalet ...\r\nSemi-Gastro- und traditionelle Küche, alles zubereitet vom Team des hoteleigenen Gourmetrestaurants.\r\nRestaurant am Pool und gegenüber von La Muzelle"
    ],
    "en": [
      "Whether you fancy a snack or a proper lunch, welcome to the Jardin du Chalet …\r\nSemi-gastronomic and traditional cuisine, prepared by the hotel restaurant’s\r\nteam.\r\nRestaurant by the pool and facing the Muzelle"
    ],
    "it": [
      "Piccolo spuntino o vero pranzo, benvenuti al Jardin du Chalet. \r\nCuccina semi gastronomica e tradizionale, preparata dalla squadra del hotel.\r\nRistorante vicino alla piscina e di fronte alla Muzelle"
    ],
    "fr": [
      "Petit encas ou véritable déjeuner, bienvenue au Jardin du Chalet ...\r\nCuisine semi gastro et traditionnelle, le tout préparé par l'équipe du restaurant gastronomique de l'hôtel.\r\nRestaurant au bord de la piscine et face à la Muzelle"
    ],
    "es": [
      "Pequeño tentempié o auténtico almuerzo, bienvenido al Jardin du Chalet ...\r\nCocina semigastronómica y tradicional, todo ello elaborado por el equipo de restauración gourmet del hotel.\r\nRestaurante junto a la piscina y frente a la Muzelle"
    ],
    "nl": [
      "Kleine snack of echte lunch, welkom in de Jardin du Chalet ...\r\nSemi-gastronomische en traditionele gerechten, allemaal bereid door het gastronomische restaurantteam van het hotel.\r\nRestaurant bij het zwembad en tegenover de Muzelle"
    ]
  },
