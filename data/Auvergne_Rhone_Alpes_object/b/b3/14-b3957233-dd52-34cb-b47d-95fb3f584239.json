  "rdfs:comment": {
    "de": [
      "Begeben Sie sich an Bord der Nautilus auf eine märchenhafte und immersive Reise ins Herz der Ozeane, wo sich magische Seifenblasen und eine ökologische Botschaft in einer ebenso bezaubernden wie engagierten Show vereinen!"
    ],
    "en": [
      "Come aboard the Nautilus for a magical, immersive voyage to the heart of the oceans, where magical soap bubbles and an ecological message come together in a show as enchanting as it is engaging!"
    ],
    "it": [
      "Salite a bordo del Nautilus per un viaggio magico e coinvolgente nel cuore degli oceani, dove bolle di sapone magiche e un messaggio ecologico si fondono in uno spettacolo tanto incantevole quanto impegnato!"
    ],
    "fr": [
      "Embarquez à bord du Nautilus pour un voyage féérique et immersif au cœur des océans, où bulles de savon magiques et message écologique s’unissent dans un spectacle aussi enchanteur qu’engagé !"
    ],
    "es": [
      "Suba a bordo del Nautilus para un viaje mágico y envolvente al corazón de los océanos, donde pompas de jabón mágicas y un mensaje ecológico se unen en un espectáculo tan encantador como comprometido"
    ],
    "nl": [
      "Kom aan boord van de Nautilus voor een magische, meeslepende reis naar het hart van de oceanen, waar magische zeepbellen en een ecologische boodschap samenkomen in een show die even betoverend als geëngageerd is!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Spectacle 20000 bulles sous les mers"
    ]
  },
