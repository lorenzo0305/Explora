  "rdfs:comment": {
    "de": [
      "Das Tourismusbüro des Ferrand-Tals wird Ihnen helfen, Mizoën, Clavans-en-Haut-Oisans und Besse-en-Oisans zu entdecken, indem Sie das Tal von den Höhen des Lac du Chambon über das Plateau d'Emparis bis zum Col de Sarenne durchwandern!"
    ],
    "en": [
      "The Vallée du Ferrand tourist office will help you discover Mizoën, Clavans-en-Haut-Oisans and Besse-en-Oisans as you tour the valley from the heights of Lac du Chambon to the Col de Sarenne and the Plateau d'Emparis!"
    ],
    "it": [
      "L'Ufficio del Turismo della Vallée du Ferrand vi farà scoprire Mizoën, Clavans-en-Haut-Oisans e Besse-en-Oisans accompagnandovi in un tour della valle dalle alture del Lac du Chambon al Col de Sarenne, passando per il Plateau d'Emparis!"
    ],
    "fr": [
      "L'office de tourisme de la Vallée du Ferrand vous aidera à découvrir Mizoën, Clavans-en-Haut-Oisans et Besse-en-Oisans en parcourant la vallée depuis les hauteurs du lac du Chambon jusqu'au du col de Sarenne en passant par le plateau d'Emparis !"
    ],
    "es": [
      "La Oficina de Turismo del Valle del Ferrand le ayudará a descubrir Mizoën, Clavans-en-Haut-Oisans y Besse-en-Oisans recorriendo el valle desde las alturas del lago de Chambon hasta el puerto de Sarenne, pasando por la meseta de Emparis"
    ],
    "nl": [
      "Het Office du Tourisme Vallée du Ferrand laat je Mizoën, Clavans-en-Haut-Oisans en Besse-en-Oisans ontdekken door je mee te nemen op een tocht door de vallei vanaf de hoogten van Lac du Chambon tot aan de Col de Sarenne en Plateau d'Emparis!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Tourist office of le Ferrand"
    ],
    "fr": [
      "Office de tourisme de la Vallée du Ferrand"
    ],
    "nl": [
      "VVV-kantoor van Le Ferrand"
    ]
  },
