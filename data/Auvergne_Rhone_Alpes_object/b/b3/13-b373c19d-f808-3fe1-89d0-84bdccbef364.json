  "rdfs:comment": {
    "de": [
      "Artisan Karl ist seit 2006 als Polsterer in Saint Paul les Romans tätig und bietet Ihnen eine umfassende und qualitativ hochwertige Dienstleistung in der Instandsetzung von Sitzmöbeln, der Restaurierung von Möbeln und dem Anbringen von Innen- und Außenjalousien."
    ],
    "en": [
      "Artisan upholsterer since 2006 in Saint Paul les Romans, Artisan Karl brings you a complete range of quality services in upholstery repair, furniture restoration and the installation of interior & exterior blinds."
    ],
    "it": [
      "Tappezziere artigiano dal 2006 a Saint Paul les Romans, Artisan Karl vi offre un servizio completo e di qualità nella riparazione di sedili, nel restauro di mobili e nell'installazione di tende per interni ed esterni."
    ],
    "fr": [
      "Artisan Tapissier depuis 2006 à Saint Paul les Romans, Artisan Karl vous apporte une prestation complète de qualité dans la réfection de sièges, restauration de meubles et la pose de stores intérieurs & extérieurs."
    ],
    "es": [
      "Tapicero artesano desde 2006 en Saint Paul les Romans, Artisan Karl le ofrece un servicio completo de calidad en la reparación de asientos, la restauración de muebles y la instalación de persianas interiores y exteriores."
    ],
    "nl": [
      "Artisan Karl, ambachtelijke stoffeerder sinds 2006 in Saint Paul les Romans, biedt je een compleet aanbod van kwaliteitsdiensten op het gebied van stofferingsreparatie, meubelrestauratie en het plaatsen van binnen- en buitenzonwering."
    ]
  },
  "rdfs:label": {
