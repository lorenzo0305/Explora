  "rdfs:comment": {
    "de": [
      "Hoch über dem Steilhang gelegen, passt sich dieses noch sehr vollständige Werk dem Relief auf spektakuläre Weise an."
    ],
    "en": [
      "Located a short distance from the pass at an altitude of 1570 m, above a sheer drop overlooking Saint-Michel-de-Maurienne, the impressive Fort du Télégraphe owes its name to the Chappe signalling mast which was built on the site in the early 19th C."
    ],
    "it": [
      "Questo imponente edificio sorge a poca distanza dal colle a 1570 m di altezza, su un picco che domina Saint-Michel-de-Maurienne. Deve il suo nome alla presenza di un ripetitore del telegrafo di Chappe costruito all'inizio del XIX secolo."
    ],
    "fr": [
      "Perché au-dessus de l'à-pic, cet ouvrage encore très complet épouse le relief de façon spectaculaire."
    ],
    "nl": [
      "Hoog boven de steile helling omarmt dit nog steeds zeer complete bouwwerk het reliëf op spectaculaire wijze."
    ],
    "es": [
      "Encaramada sobre el acantilado, esta estructura aún muy completa sigue el relieve de forma espectacular."
    ]
  },
