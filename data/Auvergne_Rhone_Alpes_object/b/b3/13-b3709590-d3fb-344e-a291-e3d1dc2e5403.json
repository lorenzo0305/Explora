  "rdfs:comment": {
    "de": [
      "Finden Sie Ihren Zeit-Raum wieder, einen Moment der Wiedervereinigung mit sich selbst, eine Blase, eine Klammer, in der Sie neue Kraft schöpfen können. Energie-Yoga das ganze Jahr über, Bioenergie und Yogatherapie."
    ],
    "en": [
      "Rediscover your space-time, a moment of reconnecting with yourself, a bubble, a break to recharge your batteries. Energy yoga all year round, bioenergy and yogatherapy."
    ],
    "it": [
      "Riscoprire il proprio spazio-tempo, un momento di riconnessione con se stessi, una bolla, una pausa per ricaricare le batterie. Yoga energetico tutto l'anno, bioenergetica e yogaterapia."
    ],
    "fr": [
      "Retrouvez votre espace-temps, un moment de retrouvaille avec vous-même, une bulle, une parenthèse pour vous ressourcer. Yoga de l'énergie toute l'année, Bioénergie  et yogathérapie."
    ],
    "es": [
      "Redescubre tu espacio-tiempo, un momento de reconexión contigo mismo, una burbuja, una pausa para recargar las pilas. Yoga energético todo el año, bioenergía y yogaterapia."
    ],
    "nl": [
      "Herontdek je ruimte-tijd, een moment van herverbinding met jezelf, een bubbel, een pauze om je batterijen op te laden. Energie yoga het hele jaar door, bio-energie en yogatherapie."
    ]
  },
