  "rdfs:comment": {
    "de": [
      "Entdecken Sie das digitale Museum in der Mediathek, in dem Sie Werke aus den Sammlungen der größten Museen Frankreichs entdecken können!"
    ],
    "en": [
      "Come and discover the digital museum in the multimedia library, a space where you can discover works from the collections of France's greatest museums !"
    ],
    "it": [
      "Venite a scoprire il museo digitale nella mediateca, uno spazio dove potrete scoprire le opere delle collezioni dei più grandi musei francesi!"
    ],
    "fr": [
      "Installé au sein de la médiathèque, venez découvrir le musée numérique, un espace où l’on découvre des œuvres issues des collections des plus grands musées de France !"
    ],
    "es": [
      "Situado en la mediateca, venga a descubrir el museo digital, un espacio donde podrá descubrir obras procedentes de las colecciones de los mayores museos de Francia"
    ],
    "nl": [
      "Kom in de mediatheek het digitale museum ontdekken, een ruimte waar u werken uit de collecties van de grootste musea van Frankrijk kunt ontdekken!"
    ]
  },
