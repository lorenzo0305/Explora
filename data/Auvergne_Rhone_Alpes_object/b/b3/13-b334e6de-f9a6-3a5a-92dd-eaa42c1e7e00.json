  "rdfs:comment": {
    "de": [
      "Die Association des Parents d'Élèves de l'enseignement Libre (APEL) der Schule Jeanne d'Arc setzt sich für die Schüler ein, indem sie sich an der katholischen Lehre beteiligt, und unterstützt die Umsetzung von Bildungsprojekten, schulischen und außerschulischen Aktivitäten."
    ],
    "en": [
      "The Association des Parents d'Élèves de l'Enseignement Libre (APEL) at École Jeanne d'Arc works on behalf of students by participating in Catholic education, and supporting the implementation of educational projects, school and extracurricular activities."
    ],
    "it": [
      "L'Association des Parents d'Élèves de l'enseignement Libre (APEL) della scuola Jeanne d'Arc lavora a favore degli alunni partecipando all'educazione cattolica e sostenendo la realizzazione di progetti educativi, attività scolastiche ed extra-scolastiche."
    ],
    "fr": [
      "L'Association des Parents d'Élèves de l'enseignement Libre (APEL) de l'école Jeanne d'Arc œuvre pour les élèves en  participant à l'enseignement catholique, et appui à la mise en place de projets éducatifs, activités scolaires et extrascolaires."
    ],
    "es": [
      "La Association des Parents d'Élèves de l'enseignement Libre (APEL) de la escuela Jeanne d'Arc trabaja en favor de los alumnos participando en la educación católica, y apoya la realización de proyectos educativos y actividades escolares y extraescolares."
    ],
    "nl": [
      "De Association des Parents d'Élèves de l'enseignement Libre (APEL) van de Jeanne d'Arc-school zet zich in voor leerlingen door deel te nemen aan katholiek onderwijs en ondersteunt de uitvoering van onderwijsprojecten, schoolactiviteiten en buitenschoolse activiteiten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "APEL Ecole Jeanne d'Arc"
    ]
  },
