  "rdfs:comment": {
    "de": [
      "Im Zest Urban Restaurant essen Sie so, wie Sie es mögen!\r\nWählen Sie aus 10 Vorspeisen, 5 warmen Gerichten, 4 Beilagen sowie 10 verschiedenen Gourmet-Desserts, Eis und Sorbets der Saison. So wird jeder Gaumen verwöhnt!"
    ],
    "en": [
      "At the Zest Urban restaurant, eat as you like!\r\nChoose from 10 starters, 5 hot dishes, 4 fillings as well as 10 varieties of gourmet desserts, ice creams and sorbets in season. Something for every appetite!"
    ],
    "it": [
      "Al ristorante Zest Urban, mangiate come preferite!\r\nScegliete tra 10 antipasti, 5 piatti caldi, 4 contorni e 10 varietà di dessert gourmet, gelati e sorbetti di stagione. Qualcosa per ogni palato!"
    ],
    "fr": [
      "Au Zest Urban restaurant, mangez comme vous aimez !\r\nChoisissez parmi 10 entrées, 5 plats chauds, 4 garnitures ainsi que 10 variétés de desserts gourmands, glaces et sorbets en saison. De quoi régaler tous les palais !"
    ],
    "es": [
      "En el restaurante Zest Urban, ¡come como quieras!\r\nElija entre 10 entrantes, 5 platos calientes, 4 guarniciones y 10 variedades de postres gourmet, helados y sorbetes de temporada. Algo para todos los paladares"
    ],
    "nl": [
      "Bij restaurant Zest Urban eet u zoals u wilt!\r\nKies uit 10 voorgerechten, 5 warme gerechten, 4 bijgerechten en 10 soorten gastronomische desserts, ijs en sorbets van het seizoen. Voor elk wat wils!"
    ]
  },
  "rdfs:label": {
    "en": [
      "Zest Urban restaurant"
    ],
    "fr": [
      "Au Zest Urban Restaurant"
    ]
  },
