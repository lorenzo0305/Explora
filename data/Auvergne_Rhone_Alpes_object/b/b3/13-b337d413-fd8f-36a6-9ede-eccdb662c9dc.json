  "rdfs:comment": {
    "de": [
      "Delphine bietet Ihnen Honig, aber auch daraus hergestellte Produkte wie Bonbons und Lebkuchen mit Honig und Kerzen, die aus dem Wachs ihrer Bienen hergestellt werden."
    ],
    "en": [
      "Delphine offers honey, as well as by-products such as honey-flavored candies and gingerbread, and candles made with their own beeswax."
    ],
    "it": [
      "Delphine non vende solo miele, ma anche una serie di prodotti correlati, come dolci e pan di zenzero aromatizzati al miele e candele fatte con la loro cera d'api."
    ],
    "fr": [
      "Delphine vous propose du miel mais également des produits dérivés tels que des bonbons et du pain d'épice au miel et des bougies fabriquées avec la cire de leurs abeilles."
    ],
    "nl": [
      "Delphine verkoopt niet alleen honing, maar ook een reeks aanverwante producten zoals snoepgoed met honingsmaak en peperkoek, en kaarsen gemaakt van hun eigen bijenwas."
    ],
    "es": [
      "Delphine no sólo vende miel, sino también una gama de productos relacionados, como dulces con sabor a miel y pan de especias, y velas hechas con su propia cera de abeja."
    ]
  },
  "rdfs:label": {
    "fr": [
