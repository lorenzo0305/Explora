  "rdfs:comment": {
    "de": [
      "Sophie ist Landwirtin und bietet Ihnen die Möglichkeit, ihre Pferde zu mieten, um die Landschaft und die Wanderwege rund um Montcombroux-les-Mines zu erkunden."
    ],
    "en": [
      "Sophie is a farmer and gives you the opportunity to rent her horses to discover the landscapes and the hiking trails around Montcombroux-les-Mines."
    ],
    "it": [
      "Sophie è un'agricoltrice e vi offre la possibilità di noleggiare i suoi cavalli per scoprire la campagna e i sentieri intorno a Montcombroux-les-Mines."
    ],
    "fr": [
      "Sophie est exploitante agricole et vous donne la possibilité de louer ses chevaux pour découvrir les paysages et les chemins de randonnée autour de Montcombroux-les-Mines."
    ],
    "nl": [
      "Sophie is boerin en biedt je de mogelijkheid om haar paarden te huren om het platteland en de wandelpaden rond Montcombroux-les-Mines te ontdekken."
    ],
    "es": [
      "Sophie es agricultora y le ofrece la posibilidad de alquilar sus caballos para descubrir el campo y las rutas de senderismo de los alrededores de Montcombroux-les-Mines."
    ]
  },
  "rdfs:label": {
    "fr": [
