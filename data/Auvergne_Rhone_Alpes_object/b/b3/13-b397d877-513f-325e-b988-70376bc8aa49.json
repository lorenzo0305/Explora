  "rdfs:comment": {
    "de": [
      "Im Rahmen des Programms Vichy Vitalité bietet Le Fleuret Nomade kostenlose Schnupperkurse an: Fechten für alle.   \r\nInformationen und Anmeldung per Telefon."
    ],
    "en": [
      "As part of the Vichy Vitality program, Le Fleuret Nomade offers free discovery sessions: Escrime pour Tous.   \r\nInformation and registration by telephone."
    ],
    "it": [
      "Nell'ambito del programma Vichy Vitality, Le Fleuret Nomade propone delle sessioni gratuite di scoperta: Scherma per tutti.   \r\nInformazioni e iscrizioni telefoniche."
    ],
    "fr": [
      "Dans le cadre du programme Vichy Vitalité, Le Fleuret Nomade propose des séances gratuites de découverte : Escrime pour Tous.   \r\nRenseignements et inscription par téléphone."
    ],
    "nl": [
      "In het kader van het vitaliteitsprogramma van Vichy biedt Le Fleuret Nomade gratis ontdekkingssessies aan: Schermen voor iedereen.   \r\nInformatie en inschrijving per telefoon."
    ],
    "es": [
      "En el marco del programa Vichy Vitality, Le Fleuret Nomade propone sesiones gratuitas de descubrimiento: Esgrima para todos.   \r\nInformación e inscripciones por teléfono."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Escrime pour Tous - Vichy Vitalité"
    ]
  },
