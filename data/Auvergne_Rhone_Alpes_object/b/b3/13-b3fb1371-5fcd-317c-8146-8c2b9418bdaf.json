  "rdfs:comment": {
    "de": [
      "Von seinen 35 Metern Höhe aus bietet das Aquädukt ein außergewöhnliches Panorama auf den Vercors. Die Fahrt mit dem Panoramaaufzug ermöglicht es Ihnen, auf angenehme Weise an Höhe zu gewinnen und dann das Panorama über den Vercors zu entdecken."
    ],
    "en": [
      "A 32 metre lift offering panoramic views provides access to a walk above the water with unforgettable views over the Vercors and the Bourne Valley. Information panells, orientation tables and audio points present the Royans Vercors to the visitor."
    ],
    "it": [
      "Dalla cima dell'Acquedotto, alto 35 metri, si gode di un'eccezionale vista panoramica sul Vercors. Salite con l'ascensore panoramico in cima all'Acquedotto e godetevi la vista sul Vercors."
    ],
    "fr": [
      "Du haut de ses 35 mètres, l’Aqueduc vous offre un panorama exceptionnel sur le Vercors. La montée en ascenseur panoramique vous permet de prendre de la hauteur agréablement puis de découvrir un panorama sur le Vercors."
    ],
    "nl": [
      "Vanaf de top van het 35 meter hoge Aqueduc kun je genieten van een uitzonderlijk panoramisch uitzicht over de Vercors. Neem de panoramische lift naar de top van het Aqueduct en geniet van het uitzicht over de Vercors."
    ],
    "es": [
      "Desde lo alto del Acueducto, de 35 metros de altura, podrá disfrutar de una vista panorámica excepcional del Vercors. Suba en el ascensor panorámico hasta la cima del Acueducto y disfrute de la vista sobre el Vercors."
    ]
  },
