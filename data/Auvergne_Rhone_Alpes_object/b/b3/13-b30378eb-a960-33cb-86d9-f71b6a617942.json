  "rdfs:comment": {
    "de": [
      "Ein Opernkünstler, der zu den schönsten Stimmen unserer Zeit gehört: der Weltstar Étienne Dupuis. Das Versprechen eines flammenden, temperamentvollen und lebensfrohen Abends!"
    ],
    "en": [
      "The world-renowned Étienne Dupuis is one of the most outstanding voices of our time. Enjoy a dazzling evening, full of spirit and life !"
    ],
    "it": [
      "Un artista lirico tra le migliori voci del nostro tempo: la star mondiale Étienne Dupuis. La promessa di una serata fiammeggiante, piena di energia e di vita!"
    ],
    "fr": [
      "Un artiste lyrique parmi les plus belles voix de notre temps : la star mondiale Étienne Dupuis. La promesse d’une soirée flamboyante, pleine de fougue et de vie !"
    ],
    "es": [
      "Un artista lírico entre las mejores voces de nuestro tiempo: la estrella mundial Étienne Dupuis. ¡La promesa de una velada extravagante, llena de energía y vida!"
    ],
    "nl": [
      "Een lyrische artiest onder de beste stemmen van onze tijd: wereldster Étienne Dupuis. De belofte van een flamboyante avond, vol energie en leven!"
    ]
  },
