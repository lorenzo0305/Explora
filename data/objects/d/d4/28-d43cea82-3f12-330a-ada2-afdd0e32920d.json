  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/07f27cdf-b78f-3577-8c0c-b6e653d3c4be",
      "dc:description": {
        "de": [
          "Brasserie, traditionelle Küche.\nGesprochene Sprachen: Französisch, Englisch, Spanisch.\nZahlungen mit Urlaubs- oder Restaurantgutscheinen werden akzeptiert.\nDie Brasserie verfügt über eine Terrasse und eine Babyausstattung.\nHaustiere sind erlaubt."
        ],
        "en": [
          "Brasserie, traditional cuisine.\nLanguages spoken: French, English, Spanish.\nPayment by holiday vouchers or restaurant tickets accepted.\nBrasserie equipped with a terrace, baby equipment.\nPets are allowed."
        ],
        "it": [
          "Brasserie, cucina tradizionale.\nLingue parlate: francese, inglese, spagnolo.\nSi accettano pagamenti con buoni vacanza o buoni ristorante.\nBrasserie dotata di terrazza, attrezzatura per bambini.\nGli animali sono ammessi."
        ],
        "fr": [
          "Brasserie, cuisine traditionnelle.\nLangues parlées: Français, Anglais, Espagnol.\nRèglements par chèques vacances ou tickets restaurant acceptés.\nBrasserie équipée d'une terrasse, d'un équipement bébé.\nLes animaux sont admis."
        ],
        "nl": [
          "Brasserie, traditionele keuken.\nGesproken talen: Frans, Engels, Spaans.\nBetaling met vakantiebonnen of restaurantbonnen wordt geaccepteerd.\nBrasserie uitgerust met een terras, baby uitrusting.\nDieren zijn toegestaan."
        ],
        "es": [
          "Brasserie, cocina tradicional.\nLenguas habladas: francés, inglés y español.\nSe acepta el pago con vales de vacaciones o vales de restaurante.\nBrasserie equipada con una terraza, equipo para bebés.\nSe admiten animales."
        ]
      },
