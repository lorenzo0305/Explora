      "dc:description": {
        "de": [
          "GéMuzik lädt Sie zu einem sensorischen Workshop zwischen Licht und Schatten ein, eine einzigartige Erfahrung, die Sie im Herzen der Mediathek erleben können."
        ],
        "en": [
          "GéMuzik invites you to a sensory workshop between light and shadow, a unique experience in the heart of the multimedia library."
        ],
        "it": [
          "GéMuzik vi invita a partecipare a un laboratorio sensoriale, un'esperienza unica nel cuore della biblioteca multimediale."
        ],
        "fr": [
          "GéMuzik vous convie à un atelier sensoriel entre ombres et lumières, une expérience unique à vivre au cœur de la médiathèque."
        ],
        "nl": [
          "GéMuzik nodigt je uit om deel te nemen aan een zintuiglijke workshop, een unieke ervaring in het hart van de mediatheek."
        ],
        "es": [
          "GéMuzik le invita a participar en un taller sensorial, una experiencia única en el corazón de la biblioteca multimedia."
        ]
      },
