  "rdfs:comment": {
    "de": [
      "Liebe Reiter, liebe Reiterinnen! Entdecken Sie mit Ihrem Pferd die Sümpfe von Condé-Folie in Fontaine-sur-Somme.\nBei einem Ritt durch die Moore können Sie sich wieder mit der Natur verbinden!\n Nur für Reiter mit eigenem Pferd und einer gültigen Versicherung.\nPicknick vorsehen"
    ],
    "en": [
      "Riding friends! Bring your horse and discover the Condé-Folie marshes at Fontaine-sur-Somme.\nTake a ride through the peat bogs and reconnect with nature!\n Open only to riders with their own mount and valid insurance.\nPlease bring a picnic lunch"
    ],
    "it": [
      "Amici dell'equitazione! Venite a scoprire le paludi della Condé-Folie a Fontaine-sur-Somme con il vostro cavallo.\nFate un giro tra le torbiere e riconnettetevi con la natura!\n Aperto solo a cavalieri con cavallo proprio e assicurazione valida.\nPranzo al sacco"
    ],
    "fr": [
      "Amis cavaliers! Avec votre monture, venez découvrir les marais de Condé-Folie à Fontaine-sur-Somme. \nGrâce à une randonnée au cœur des tourbières, reconnectez-vous à la nature !\n Ouvert uniquement aux cavaliers ayant leur monture et une assurance valide.\nPrévoir un pique nique"
    ],
    "es": [
      "¡Amigos jinetes! Ven a descubrir las marismas de Condé-Folie en Fontaine-sur-Somme con tu caballo.\nPasee por las turberas y vuelva a conectar con la naturaleza\n Sólo para jinetes con montura propia y seguro válido.\nAlmuerzo tipo picnic"
    ],
    "nl": [
      "Paardrijvrienden! Kom met je paard de moerassen van de Condé-Folie in Fontaine-sur-Somme ontdekken.\nMaak een rit door de venen en kom weer in contact met de natuur!\n Alleen toegankelijk voor ruiters met een eigen paard en een geldige verzekering.\nNeem een picknick lunch mee"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Caval Marais : Les Prés à Pions"
    ]
  },
