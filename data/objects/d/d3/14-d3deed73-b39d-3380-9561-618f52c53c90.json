  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6b8a2700-f77e-3379-b151-c3478695ea42",
      "dc:description": {
        "de": [
          "Wir treffen uns am 23. November 2024 um 16.00 Uhr im Centre Phénix mit dem städtischen Harmonieorchester von Outreau\nund der Chor \"La Clé des Chants\" mit dem Harmonieorchester von Samer als Gäste."
        ],
        "en": [
          "Rendezvous on November 23, 2024 at 4:00 pm at the Centre Phénix with the Orchestre d'Harmonie Municipale d'Outreau\nand the \"Clé des Chants\" choir, with the Samer brass band as guests."
        ],
        "it": [
          "Appuntamento il 23 novembre 2024 alle 16.00 al Centre Phénix con l'Orchestra municipale di Armonia di Outreau e il coro \"Clé des Chants\"\ne il coro \"Clé des Chants\", con la banda di ottoni di Samer come ospiti."
        ],
        "fr": [
          "Rendez-vous le 23 novembre 2024 à 16h00 au Centre Phénix avec l'orchestre d'Harmonie Municipale d'Outreau \net la chorale \" la Clé des Chants\" avec , pour invités, l'orchestre d'Harmonie de Samer."
        ],
        "nl": [
          "Rendez-vous op 23 november 2024 om 16.00 uur in het Centre Phénix met het Harmonieorkest van de gemeente Outreau\nen het koor \"Clé des Chants\", met als gasten de fanfare van Samer."
        ],
        "es": [
          "Cita el 23 de noviembre de 2024 a las 16.00 horas en el Centro Phénix con la Orquesta Municipal de Armonía de Outreau\ny el coro \"Clé des Chants\", con la banda de música de Samer como invitada."
        ]
      },
