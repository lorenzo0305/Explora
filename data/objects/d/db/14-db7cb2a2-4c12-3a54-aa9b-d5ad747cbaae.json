  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a1b8d6f-bf71-353b-8ab0-713d38595387",
      "dc:description": {
        "de": [
          "Pétanque-Club, der seine Mitglieder dienstags und donnerstags von 14:00 bis 19:00 Uhr zum Training empfängt. Der Club veranstaltet etwa 15 Mal im Jahr Pétanque-Wettbewerbe, die für alle offen sind."
        ],
        "en": [
          "Petanque club that welcomes members every Tuesday and Thursday from 2:00 pm to 7:00 pm for training. The club organizes pétanque competitions open to all, about fifteen a year."
        ],
        "it": [
          "Un club di bocce che accoglie i suoi membri ogni martedì e giovedì dalle 14:00 alle 19:00 per gli allenamenti. Il club organizza gare di bocce aperte a tutti, circa quindici all'anno."
        ],
        "fr": [
          "Club de pétanque qui reçoit ses adhérents tous les mardis et jeudis de 14h00 à 19h00  pour s’entraîner. Le club organise des concours de pétanque ouverts à tous, une quinzaine dans l année."
        ],
        "es": [
          "Un club de petanca que acoge a sus socios todos los martes y jueves de 14:00 a 19:00 para entrenarse. El club organiza competiciones de petanca abiertas a todos, unas quince al año."
        ],
        "nl": [
          "Een jeu de boules club waar leden elke dinsdag en donderdag van 14.00 tot 19.00 uur kunnen trainen. De club organiseert petanquewedstrijden voor iedereen, ongeveer vijftien per jaar."
        ]
      },
