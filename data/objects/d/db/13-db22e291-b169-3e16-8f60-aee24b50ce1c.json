  "rdfs:comment": {
    "de": [
      "Er wurde am 11. Oktober 1936 mit einem Passionszug eingeweiht.\r\n\r\nQuelle: Archiv des Vereins Racines et Patrimoine und verschiedene Bände der Geschichte von Rousies von Alain Delfosse."
    ],
    "en": [
      "It was inaugurated on October 11, 1936 with a procession of passion.\r\n\r\nSource: Archives of the Racines et Patrimoine association and various volumes of Rousies history by Alain Delfosse."
    ],
    "it": [
      "Fu inaugurato l'11 ottobre 1936 con una processione di passione.\r\n\r\nFonte: Archivi dell'associazione Racines et Patrimoine e vari volumi della storia di Rousies di Alain Delfosse."
    ],
    "fr": [
      "Il a été inauguré le 11 octobre 1936 avec un cortège de la passion.\r\n\r\nSource : Archives de l’association Racines et Patrimoine et divers tomes de l’histoire de Rousies par Alain Delfosse."
    ],
    "es": [
      "Se inauguró el 11 de octubre de 1936 con una procesión de la pasión.\r\n\r\nFuente: Archivos de la asociación Racines et Patrimoine y varios volúmenes de la historia de Rousies de Alain Delfosse."
    ],
    "nl": [
      "Het werd op 11 oktober 1936 ingewijd met een processie van passie.\r\n\r\nBron: Archief van de vereniging Racines et Patrimoine en verschillende delen van de geschiedenis van Rousies door Alain Delfosse."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Calvaire du nouveau cimetière"
    ]
  },
