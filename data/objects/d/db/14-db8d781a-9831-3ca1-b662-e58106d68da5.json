  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d30195a6-330e-33a1-83ea-b1f1b41af8cc",
      "dc:description": {
        "de": [
          "Die Kirche besteht aus einem Chor aus weißem Stein aus dem 16. Jahrhundert, einem einfachen Schiff mit einem Querschiff aus dem 17. Jahrhundert und einem Turm aus Stein aus dem 16. Jahrhundert mit einer Turmspitze aus Holz und Schiefer. Die Mönche von Wisques restaurierten den Turm nach dem Zweiten Weltkrieg."
        ],
        "en": [
          "The church features a 16th-century white stone choir, a simple nave with a 17th-century transept, and a 16th-century stone tower topped by a bulbous slate and timber spire. The monks of Wisques restored it after the Second World War."
        ],
        "it": [
          "La chiesa ha un coro in pietra bianca del XVI secolo, una navata unica con transetto del XVII secolo e una torre in pietra del XVI secolo sormontata da una guglia bulbosa in ardesia e legno. I monaci di Wisques l'hanno restaurata dopo la seconda guerra mondiale."
        ],
        "fr": [
          "L'église se compose d'un chœur du XVIème siècle en pierre blanche, d'une nef simple dotée d'un transept du 17ème, et d'une tour du 16ème siècle, en pierre, coiffée d'une flèche en charpente et ardoise, de base bulbeuse. Les moines de Wisques l'ont restaurée après la Seconde Guerre Mondiale."
        ],
        "es": [
          "La iglesia tiene un coro de piedra blanca del siglo XVI, una sola nave con crucero del siglo XVII y una torre de piedra del siglo XVI rematada por un chapitel bulboso de pizarra y madera. Los monjes de Wisques la restauraron tras la Segunda Guerra Mundial."
        ],
        "nl": [
          "De kerk heeft een 16e-eeuws koor van witte steen, een enkel schip met een 17e-eeuws dwarsschip en een 16e-eeuwse stenen toren met een bolvormige spits van leisteen en hout. De monniken van Wisques restaureerden de kerk na de Tweede Wereldoorlog."
        ]
      },
