  "rdfs:comment": {
    "de": [
      "Traditionelle französische Gastronomie\nQualität, Frische, Kreationen.\nMeerblick, Haustiere erlaubt. Reservierungen werden dringend empfohlen. Kostenlose Parkplätze und Parkhäuser, Fahrradpark (gegen Diebstahl gesichert)"
    ],
    "en": [
      "Traditional French catering\nQuality, freshness, creations.\nSea view, pets allowed. Reservations strongly recommended. Free parking, bike park (anti-theft loan)"
    ],
    "it": [
      "Ristorazione tradizionale francese\nQualità, freschezza, creazioni.\nVista mare, animali ammessi. Si consiglia vivamente la prenotazione. Parcheggio gratuito, parco biciclette (prestito antifurto)"
    ],
    "fr": [
      "Restauration Française traditionnelle\nQualité, fraîcheur, créations. \nVue sur la mer, animaux admis. Réservations fortement conseillée. Parking et stationnement gratuit, parc à vélos (prêt anti-vol)"
    ],
    "nl": [
      "Traditionele Franse catering\nKwaliteit, versheid, creaties.\nUitzicht op zee, huisdieren toegestaan. Reserveren sterk aangeraden. Gratis parkeren, fietsenstalling (antidiefstallening)"
    ],
    "es": [
      "Catering tradicional francés\nCalidad, frescura, creaciones.\nVistas al mar, se admiten animales. Se recomienda reservar. Aparcamiento gratuito, aparcamiento para bicicletas (préstamo antirrobo)"
    ]
  },
