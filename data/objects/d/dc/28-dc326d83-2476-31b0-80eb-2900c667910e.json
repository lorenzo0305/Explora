  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/82c4e5ec-ad2e-3e7a-a78d-a8d8f575f402",
      "dc:description": {
        "de": [
          "Pascal und Anne begrüßen Sie in ihrem Restaurant in Faumont. Jeden Mittag bieten sie Ihnen Gerichte an, die aus lokalen Produkten zubereitet werden.\nZögern Sie nicht, die beiden für Ihre Familienessen oder Firmenveranstaltungen zu kontaktieren. Das sylver kann Gruppen bis zu 100 Personen empfangen, auch am Wochenende!"
        ],
        "en": [
          "Pascal and Anne welcome you to their restaurant in Faumont. Every lunchtime, they serve dishes made from local produce.\nDon't hesitate to contact them for your family meals or corporate events. Le sylver can accommodate groups of up to 100 people, even at weekends!"
        ],
        "it": [
          "Pascal e Anne vi danno il benvenuto nel loro ristorante a Faumont. Ogni giorno a pranzo servono piatti a base di prodotti locali.\nNon esitate a contattarli per i vostri pranzi in famiglia o per eventi aziendali. Le sylver può ospitare gruppi fino a 100 persone, anche nei fine settimana!"
        ],
        "fr": [
          "Pascal et Anne vous accueillent dans leur restaurant, situé à Faumont. Chaque midi, ils vous proposent des plats confectionnés à partir de produits locaux.\nN'hésitez pas à les contacter pour vos repas familiaux ou leur événements d'entreprise. Le sylver peut accueillir les groupes jusque 100 personnes, même le week-end !"
        ],
        "es": [
          "Pascal y Anne le dan la bienvenida a su restaurante de Faumont. Todos los mediodías sirven platos elaborados con productos locales.\nNo dude en ponerse en contacto con ellos para sus comidas familiares o eventos de empresa. Le sylver puede acoger a grupos de hasta 100 personas, ¡incluso los fines de semana!"
        ],
        "nl": [
          "Pascal en Anne heten je welkom in hun restaurant in Faumont. Elke middag serveren ze gerechten op basis van lokale producten.\nAarzel niet om contact met hen op te nemen voor uw familiemaaltijden of bedrijfsevenementen. Le sylver kan groepen tot 100 personen ontvangen, zelfs in het weekend!"
        ]
      },
      "@type": [
        "Description"
      ],
