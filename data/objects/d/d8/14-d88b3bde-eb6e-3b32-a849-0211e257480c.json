      "@id": "https://data.datatourisme.fr/005b07ef-59ad-3a29-93f2-2b37659a30b9",
      "dc:description": {
        "de": [
          "Honig und Produkte aus dem Bienenstock. Entdecken Sie die Honigfabrik im Course-Tal, wo Eugénie mit Leidenschaft zu jeder Jahreszeit Honig erntet."
        ],
        "en": [
          "Honey and hive products. Discover the honey house in the Course valley, where Eugénie passionately harvests honey in all seasons."
        ],
        "it": [
          "Miele e prodotti dell'alveare. Scoprite la casa del miele nella valle del Corso, dove Eugénie raccoglie con passione il miele tutto l'anno."
        ],
        "fr": [
          "Miel et produits de la ruche. Découvrez la miellerie de la vallée de la Course où Eugénie récolte avec passion, du miel en toute saison."
        ],
        "es": [
          "Miel y productos de la colmena. Descubra la casa de la miel en el valle del Course, donde Eugénie cosecha miel con pasión durante todo el año."
        ],
        "nl": [
          "Honing en producten uit de bijenkorf. Ontdek het honinghuis in de Course-vallei, waar Eugénie het hele jaar door met passie honing oogst."
        ]
      },
