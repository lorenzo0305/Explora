  "rdfs:comment": {
    "de": [
      "Der kleine B taucht sehr junge Zuschauerinnen und Zuschauer in ein sinnliches Bad aus Klängen, Materie und Poesie, ein seltenes immersives Abenteuer, das speziell für sie geschaffen wurde."
    ],
    "en": [
      "Le petit B immerses very young viewers in a sensory bath of sound, matter and poetry, a rare immersive adventure created especially for them."
    ],
    "it": [
      "Le petit B immerge i giovanissimi spettatori in un bagno sensoriale di suoni, materia e poesia, una rara avventura immersiva creata appositamente per loro."
    ],
    "fr": [
      "Le petit B plonge les très jeunes spectateurs∙rices dans un bain sensitif fait de sons, de matière et de poésie, une rare aventure immersive créée spécialement pour eux."
    ],
    "es": [
      "Le petit B sumerge al público más joven en un baño sensorial de sonido, materia y poesía, una rara aventura de inmersión creada especialmente para ellos."
    ],
    "nl": [
      "Le petit B dompelt het zeer jonge publiek onder in een zintuiglijk bad van geluid, materie en poëzie, een zeldzaam meeslepend avontuur dat speciaal voor hen is gecreëerd."
    ]
  },
  "rdfs:label": {
