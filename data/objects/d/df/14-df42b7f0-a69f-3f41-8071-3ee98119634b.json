  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0319cd7b-e492-34a5-b8ab-99811d99a7d7",
      "dc:description": {
        "de": [
          "In einem ehemaligen Pfarrhaus aus dem 17. Jahrhundert wird Ihnen dieses Estaminet mit seiner altmodischen regionalen Küche und seinen regionalen Bieren einen geselligen Moment bereiten."
        ],
        "en": [
          "In an old presbytery of the 17th century, this estaminet will know how to make you spend a convivial moment with its old-fashioned local cuisine and its regional beers."
        ],
        "it": [
          "In un ex presbiterio del XVII secolo, questo estaminet vi farà trascorrere un momento di convivialità con la sua cucina locale all'antica e le sue birre regionali."
        ],
        "fr": [
          "Dans un ancien presbytère du 17ème siècle, cet estaminet saura vous faire passer un moment convivial avec sa cuisine de terroir à l’ancienne et ses bières régionales."
        ],
        "nl": [
          "In een voormalige pastorie uit de 17e eeuw zal dit estaminet u een gezellig moment bezorgen met zijn ouderwetse lokale keuken en zijn regionale bieren."
        ],
        "es": [
          "En un antiguo presbiterio del siglo XVII, este estaminet le hará pasar un momento de convivencia con su cocina local a la antigua y sus cervezas regionales."
        ]
      },
      "@type": [
        "Description"
