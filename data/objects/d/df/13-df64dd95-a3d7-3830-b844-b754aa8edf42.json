  "rdfs:comment": {
    "de": [
      "Ob mit der Familie oder in der Gruppe: Genießen Sie den Standort der Etangs des Moines, seinen 871 Hektar großen Wald und seine vier Teiche, um sich zu entspannen."
    ],
    "en": [
      "In family or in group come to benefit from the site of the Ponds of the Monks, of its forest of 871 hectares and its four ponds to slacken you."
    ],
    "it": [
      "In famiglia o in gruppo, venite a godervi il sito degli Etangs des Moines, la sua foresta di 871 ettari e i suoi quattro stagni per rilassarvi."
    ],
    "fr": [
      "En famille ou en groupe venez profiter du site des Etangs des Moines, de sa forêt de 871 hectares et de ses quatre étangs pour vous détendre."
    ],
    "nl": [
      "Kom als gezin of in groepsverband genieten van de site Etangs des Moines, het bos van 871 hectare en de vier vijvers om u te ontspannen."
    ],
    "es": [
      "En familia o en grupo, venga a disfrutar del recinto de Etangs des Moines, de su bosque de 871 hectáreas y de sus cuatro estanques para relajarse."
    ]
  },
  "rdfs:label": {
