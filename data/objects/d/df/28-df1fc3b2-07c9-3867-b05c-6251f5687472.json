  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9f81c336-c67c-3198-b842-5104ebb05e54",
      "dc:description": {
        "de": [
          "Le Bonhomique ist ein bistronomisches Restaurant, in dem die Einfachheit der Art und Weise mit der Güte, die von Herzen kommt, verbunden wird. Erleben Sie ein kulinarisches Erlebnis in Einfachheit, Wohlwollen, Güte und Freundlichkeit"
        ],
        "en": [
          "Le Bonhomique is a bistronomic restaurant where simplicity of manner is combined with kindness from the heart. Come and discover a culinary experience based on simplicity, kindness, goodness and friendliness"
        ],
        "it": [
          "Le Bonhomique è un ristorante bistronomico dove la semplicità dello stile si unisce alla gentilezza che viene dal cuore. Venite a scoprire un'esperienza culinaria basata su semplicità, gentilezza e cordialità"
        ],
        "fr": [
          "Le Bonhomique est un restaurant bistronomique où la simplicité dans la manière est alliée à la bonté qui vient du coeur. Venez découvrir une expérience culinaire dans la simplicité, la bienveillance, la bonté et l'amabilité"
        ],
        "nl": [
          "Le Bonhomique is een bistronomisch restaurant waar eenvoud van stijl wordt gecombineerd met de vriendelijkheid die uit het hart komt. Kom en ontdek een culinaire ervaring gebaseerd op eenvoud, vriendelijkheid en gezelligheid"
        ],
        "es": [
          "Le Bonhomique es un restaurante bistronómico donde la sencillez de estilo se combina con la amabilidad que nace del corazón. Venga a descubrir una experiencia culinaria basada en la sencillez, la amabilidad y la simpatía"
        ]
      },
      "@type": [
        "Description"
