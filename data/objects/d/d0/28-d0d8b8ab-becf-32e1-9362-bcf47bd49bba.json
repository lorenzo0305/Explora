  "rdfs:comment": {
    "de": [
      "Von den Gräbern mit einem Hauch von Art déco bis hin zu La Pleureuse des Bildhauers Rogerol, die den Verstorbenen huldigt, durchstreifen Sie den Hauptfriedhof mit einem neuen Blickwinkel."
    ],
    "en": [
      "From graves with Art Deco touches to Rogerol's La Pleureuse, a tribute to the departed, take a fresh look at the main cemetery."
    ],
    "it": [
      "Dalle tombe con tocchi Art Déco a La Pleureuse dello scultore Rogerol che rende omaggio ai defunti, date un'occhiata al cimitero principale."
    ],
    "fr": [
      "Des sépultures aux touches Art déco à La Pleureuse du sculpteur Rogerol rendant hommage aux disparus, parcourez le cimetière principal avec un nouveau regard."
    ],
    "nl": [
      "Van graven met Art Deco accenten tot de La Pleureuse van beeldhouwer Rogerol die een eerbetoon brengt aan de overledenen, neem een frisse kijk op de belangrijkste begraafplaats."
    ],
    "es": [
      "Desde tumbas con toques Art Déco hasta La Pleureuse del escultor Rogerol que rinde homenaje a los difuntos, eche un vistazo al cementerio principal."
    ]
  },
  "rdfs:label": {
