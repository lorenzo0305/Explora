  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2fed5d9c-ff9e-32b0-be87-8d3eb2627ab5",
      "dc:description": {
        "de": [
          "Claire im Speisesaal und Mickaël in der Küche begrüßen Sie zu einer Schlemmerpause im Herzen des Dorfes Souchez. Auf der Speisekarte stehen gegrillte Fleischspezialitäten und Brasseriegerichte."
        ],
        "en": [
          "Claire, in the dining room, and Mickaël, in the kitchen, welcome you for a gourmet break in the heart of the village of Souchez. On the menu, specialities of grilled meats and brasserie dishes."
        ],
        "it": [
          "Claire, in sala da pranzo, e Mickaël, in cucina, vi accolgono per una pausa gourmet nel cuore del villaggio di Souchez. Il menu comprende specialità di carne alla griglia e piatti da brasserie."
        ],
        "fr": [
          "Claire, en salle, et Mickaël, en cuisine, vous accueillent pour une pause gourmande au coeur du village de Souchez. A la carte des spécialités de viandes grillées, et des plats de brasseries."
        ],
        "nl": [
          "Claire, in de eetkamer, en Mickaël, in de keuken, heten u welkom voor een gastronomisch verblijf in het hart van het dorp Souchez. Op het menu staan gegrilde vleesspecialiteiten en brasseriegerechten."
        ],
        "es": [
          "Claire, en el comedor, y Mickaël, en la cocina, le dan la bienvenida para una pausa gastronómica en el corazón del pueblo de Souchez. En el menú hay especialidades de carne a la parrilla y platos de brasserie."
        ]
      },
