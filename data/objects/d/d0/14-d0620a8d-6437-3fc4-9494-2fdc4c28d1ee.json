      "@id": "https://data.datatourisme.fr/a117e95b-5a71-3e00-b87b-c472cccf79eb",
      "dc:description": {
        "de": [
          "Am Freitag, den 8. und Samstag, den 9. Mai 2026\nVerkauf am 9. Mai um 14 Uhr im Palais des Congrès\nExpo-Versteigerung :\n\"Chic la Fête des Mères au Touquet!\"\n\"Mode, Schmuck & Uhren, Zeitgenössische Kunst\""
        ],
        "en": [
          "Friday, May 8 and Saturday, May 9, 2026\nSale on May 9 at 2pm at the Palais des Congrès\nAuction-Exhibition:\n\"Chic Mother's Day in Le Touquet!\"\n\"Fashion, Jewelry & Watches, Contemporary Art\""
        ],
        "it": [
          "Venerdì 8 e sabato 9 maggio 2026\nVendita il 9 maggio alle ore 14.00 presso il Palazzo dei Congressi\nEsposizione-Asta:\n\"Festa della mamma chic a Le Touquet!\n\"Moda, gioielli e orologi, arte contemporanea\""
        ],
        "fr": [
          "Le vendredi 8 et le samedi 9 mai 2026 \nVente le 9 mai à 14h au Palais des Congrès\nExpo-Vente aux Enchères :\n\"Chic la Fête des Mères au Touquet !\"\n« Mode, Bijoux & Montres, Art Contemporain »"
        ],
        "nl": [
          "Vrijdag 8 en zaterdag 9 mei 2026\nVerkoop op 9 mei om 14.00 uur in het Palais des Congrès\nExpo-veiling:\n\"Chique Moederdag in Le Touquet!\n\"Mode, Juwelen & Horloges, Hedendaagse Kunst \""
        ],
        "es": [
          "Viernes 8 y sábado 9 de mayo de 2026\nVenta el 9 de mayo a las 14:00 h en el Palacio de Congresos\nExpo-Subasta:\n\" ¡Día de la Madre Chic en Le Touquet!\n\"Moda, Joyería y Relojería, Arte Contemporáneo \""
        ]
      },
