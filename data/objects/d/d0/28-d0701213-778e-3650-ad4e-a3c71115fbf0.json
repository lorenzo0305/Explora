  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/78616391-aa84-314d-9724-daf3bac00993",
      "dc:description": {
        "de": [
          "Dieser einzigartige Komplex verbindet einen gemütlichen und gedämpften Rahmen mit einem modernen Freizeitzentrum der Region, dem Quai 121, das gleichzeitig eine Bowlingbahn, ein Laser-Game, eine Bar, ein Restaurant und Seminarräume umfasst."
        ],
        "en": [
          "This unique complex combines a warm, cosy setting with the region's most modern leisure center, Quai 121, featuring a bowling alley, laser-game, bar, restaurant and seminar rooms."
        ],
        "it": [
          "Questo complesso unico combina un ambiente caldo e accogliente con un moderno centro ricreativo regionale, il Quai 121, che comprende una pista da bowling, un laser-game, un bar, un ristorante e sale per seminari."
        ],
        "fr": [
          "Ce complexe unique alliant un cadre chaleureux et feutré à un centre de loisirs moderne de la région, le Quai 121 regroupe à la fois un bowling, un laser-game, un bar, un restaurant et des salles de séminaires."
        ],
        "es": [
          "Este complejo único combina un entorno cálido y acogedor con un moderno centro de ocio regional, el Quai 121, que incluye una bolera, un juego de láser, un bar, un restaurante y salas para seminarios."
        ],
        "nl": [
          "Dit unieke complex combineert een warme en gezellige omgeving met een modern regionaal recreatiecentrum, Quai 121, met onder andere een bowlingbaan, lasergame, bar, restaurant en seminarruimten."
        ]
      },
