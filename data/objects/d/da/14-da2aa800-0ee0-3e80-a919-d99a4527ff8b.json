  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine zauberhafte Welt, die der Leidenschaft für Pferde und Ponys gewidmet ist. Sie liegt im Herzen von Marck, in einer natürlichen und sicheren Umgebung.\n\n Der Poney Club Jules Verne lädt Sie ein, dem Alltag zu entfliehen und die Welt zu entdecken, um besondere Momente des Teilens und Lernens zu erleben."
    ],
    "en": [
      "Discover an enchanted world dedicated to the passion of horses and ponies, nestled in the heart of Marck, in a safe, natural environment.\n\n The Poney Club Jules Verne invites you to escape and discover for privileged moments of sharing and learning."
    ],
    "it": [
      "Scoprite un mondo incantato dedicato alla passione dei cavalli e dei pony, immerso nel cuore di Marck, in un ambiente naturale e sicuro.\n\n Il Poney Club Jules Verne vi invita a evadere e a scoprire per momenti speciali di condivisione e apprendimento."
    ],
    "fr": [
      "Découvrez un univers enchanté dédié à la passion du cheval et du poney, niché au cœur de Marck, dans un environnement naturel et sécurisé.\n\n Le Poney Club Jules Verne vous invite à l'évasion et à la découverte pour des moments de partage et d'apprentissage privilégiés."
    ],
    "nl": [
      "Ontdek een betoverende wereld gewijd aan de passie van paarden en pony's, genesteld in het hart van Marck, in een natuurlijke en veilige omgeving.\n\n De Poney Club Jules Verne nodigt je uit om te ontsnappen en te ontdekken voor speciale momenten van delen en leren."
    ],
    "es": [
      "Descubra un mundo encantado dedicado a la pasión de los caballos y ponis, enclavado en el corazón de Marck, en un entorno natural y seguro.\n\n El Poney Club Jules Verne le invita a evadirse y descubrir momentos especiales para compartir y aprender."
    ]
  },
