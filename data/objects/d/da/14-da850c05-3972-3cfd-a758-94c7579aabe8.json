  "rdfs:comment": {
    "de": [
      "Um das Doppeljubiläum des 10-jährigen Bestehens des Louvre-Lens und der Aufnahme des Bassin Minier in das Weltkulturerbe zu feiern, schlägt Ihnen das Pays d'art et d'histoire, das Land der Kunst und Geschichte, vor, die Erfahrung der Spiegelbesuche fortzusetzen!"
    ],
    "en": [
      "To celebrate the double anniversary of the 10th anniversary of the Louvre-Lens and the inscription of the mining basin on the World Heritage List, the Pays d'art et d'histoire proposes you to continue the experience of mirror visits!"
    ],
    "it": [
      "Per celebrare il doppio anniversario del decimo anniversario del Louvre-Lens e dell'iscrizione del Bassin Minier al Patrimonio mondiale dell'umanità, il Pays d'art et d'histoire vi invita a continuare l'esperienza del tour degli specchi!"
    ],
    "fr": [
      "Pour célébrer le double anniversaire des 10 ans du Louvre-Lens et de l’inscription du Bassin minier au Patrimoine mondial, le Pays d’art et d’histoire, vous propose de continuer l'expérience visites miroir !"
    ],
    "es": [
      "Para celebrar el doble aniversario del 10º aniversario del Louvre-Lens y de la inscripción del Bassin Minier como Patrimonio Mundial, el Pays d'art et d'histoire le invita a continuar la experiencia de la visita en espejo"
    ],
    "nl": [
      "Om de dubbele verjaardag van de 10e verjaardag van het Louvre-Lens en de opname van het Bassin Minier als werelderfgoed te vieren, nodigt het Pays d'art et d'histoire u uit om de spiegelrondleiding voort te zetten!"
    ]
  },
