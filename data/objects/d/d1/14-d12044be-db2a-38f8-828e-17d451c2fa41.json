  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/baeec454-b1c0-37e4-bfd9-cae97248833a",
      "dc:description": {
        "de": [
          "Die APEL der katholischen Schule in Etaples-sur-Mer organisiert das traditionelle Lottospiel.\nVerbringen Sie einen Moment mit der Familie oder mit Freunden und versuchen Sie, schöne Preise zu gewinnen."
        ],
        "en": [
          "The APEL of the Etaples-sur-mer Catholic school is organizing its traditional bingo game.\nCome along with family and friends for a chance to win some great prizes."
        ],
        "it": [
          "L'APEL della scuola cattolica di Etaples-sur-mer organizza la sua tradizionale lotteria.\nVenite a trascorrere un po' di tempo con la vostra famiglia o i vostri amici e provate a vincere dei fantastici premi."
        ],
        "fr": [
          "L'APEL de l'école catholique d'Etaples-sur-mer organise le traditionnel jeu de loto.\nVenez passer un moment en famille ou entre amis pour tenter de remporter de beaux lots."
        ],
        "es": [
          "La APEL de la escuela católica de Etaples-sur-mer organiza su tradicional lotería.\nVen a pasar un rato con tu familia o amigos e intenta ganar magníficos premios."
        ],
        "nl": [
          "Het APEL van de katholieke school van Etaples-sur-mer organiseert zijn traditionele loterij.\nKom wat tijd doorbrengen met je familie of vrienden en probeer mooie prijzen te winnen."
        ]
      },
