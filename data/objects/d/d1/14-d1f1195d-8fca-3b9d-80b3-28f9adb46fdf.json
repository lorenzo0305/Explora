  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8d940069-4d75-3ad8-b1d3-8d9061082747",
      "dc:description": {
        "de": [
          "Dünenmassiv mit großem Höhenunterschied, wo Sie den schönsten Ausblick auf die Bucht von Canche genießen können. Der Weg führt zweimal über die Landstraße. Länge des Rundwegs: 2,3 km."
        ],
        "en": [
          "A dune massif with a significant difference in altitude, where you'll enjoy the best views of the Bay of Canche. The route crosses the departmental road twice. Loop distance: 2.3 km."
        ],
        "it": [
          "Un massiccio di dune con un notevole dislivello da cui si gode la migliore vista sulla baia di Canche. Il percorso attraversa due volte la strada dipartimentale. Distanza dell'anello: 2,3 km."
        ],
        "fr": [
          "Massif dunaire à importante dénivellation où vous bénéficierez du plus beau point de vue sur la baie de Canche. Le tracé traverse 2 fois la route départementale. Distance de la boucle : 2,3 km."
        ],
        "es": [
          "Un macizo de dunas con un desnivel importante donde se puede disfrutar de las mejores vistas sobre la bahía de Canche. El recorrido cruza dos veces la carretera departamental. Distancia del bucle: 2,3 km."
        ],
        "nl": [
          "Een duinmassief met een aanzienlijk niveauverschil waar je kunt genieten van het beste uitzicht over de Baai van Canche. De route kruist tweemaal de departementale weg. Afstand van de lus: 2,3 km."
        ]
      },
      "@type": [
        "Description"
