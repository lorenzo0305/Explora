  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/538b48e4-dd4c-3edc-88e4-d14446a008c8",
      "dc:description": {
        "de": [
          "Das berühmte Restaurant 3 Brasseurs landet in Boulogne-sur-Mer.\nKommen Sie und entdecken Sie das vor Ort gebraute handwerkliche Bier und die schmackhaften Gerichte der Gazette."
        ],
        "en": [
          "The famous 3 Brasseurs restaurant arrives in Boulogne-sur-Mer.\nCome and discover the craft beer brewed on site and the tasty dishes of La Gazette."
        ],
        "it": [
          "Il famoso ristorante 3 Brasseurs arriva a Boulogne-sur-Mer.\nVenite a scoprire la birra artigianale prodotta in loco e i gustosi piatti de La Gazette."
        ],
        "fr": [
          "Le célèbre restaurant 3 Brasseurs débarque à Boulogne-sur-Mer.\nVenez découvrir la bière artisanale brassée sur place et les plats savoureux de la Gazette."
        ],
        "nl": [
          "Het beroemde restaurant 3 Brasseurs komt naar Boulogne-sur-Mer.\nKom en ontdek het ambachtelijke bier dat ter plaatse wordt gebrouwen en de smakelijke gerechten van La Gazette."
        ],
        "es": [
          "El famoso restaurante 3 Brasseurs llega a Boulogne-sur-Mer.\nVenga a descubrir la cerveza artesanal elaborada in situ y los sabrosos platos de La Gazette."
        ]
      },
      "@type": [
        "Description"
