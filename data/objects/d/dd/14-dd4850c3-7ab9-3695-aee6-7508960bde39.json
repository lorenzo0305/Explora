  "rdfs:comment": {
    "de": [
      "Die Rendez-vous aux jardins, die vom Kulturministerium am ersten Wochenende im Juni organisiert werden, stehen in diesem Jahr unter dem Motto \"Fünf Sinne im Garten\"."
    ],
    "en": [
      "This year's Rendez-vous aux jardins, organized by the French Ministry of Culture on the first weekend in June, will focus on the \"five senses in the garden\"."
    ],
    "it": [
      "Il Rendez-vous aux jardins, organizzato dal Ministero della Cultura francese il primo fine settimana di giugno, si svolge quest'anno all'insegna dei \"cinque sensi in giardino\"."
    ],
    "fr": [
      "Les Rendez-vous aux jardins, organisés par le Ministère de la Culture le premier week-end de juin, se tiennent cette année sous le signe des « cinq sens au jardin »."
    ],
    "es": [
      "El Rendez-vous aux jardins, organizado por el Ministerio francés de Cultura el primer fin de semana de junio, se celebra este año bajo el lema \"los cinco sentidos en el jardín\"."
    ],
    "nl": [
      "De Rendez-vous aux jardins, georganiseerd door het Franse ministerie van Cultuur in het eerste weekend van juni, wordt dit jaar gehouden onder de noemer \"de vijf zintuigen in de tuin\"."
    ]
  },
