  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8eee0366-7bdd-3e62-8062-ebf0edcabf98",
      "dc:description": {
        "de": [
          "Die Feuermaschinen der Compagnie Titanos erobern die Grube 11/19. Tauchen Sie mit den Fuuu-Figuren und dem allgegenwärtigen Feuer in eine fremde Traumwelt ein."
        ],
        "en": [
          "Compagnie Titanos?s fire machines take over Fosse 11/19. Enter the strange, dreamlike world of the Fuuu characters and the omnipresence of fire."
        ],
        "it": [
          "Le macchine del fuoco della Compagnie Titanos conquistano Fosse 11/19. Entrate nello strano mondo onirico dei personaggi Fuuu e dell'onnipresenza del fuoco."
        ],
        "fr": [
          "Les machines de feu de la Compagnie Titanos s’emparent de la Fosse 11/19. Pénétrez dans l’univers onirique et étrange en compagnie des personnages Fuuu et de l’omniprésence du feu."
        ],
        "es": [
          "Las máquinas de fuego de la Compagnie Titanos toman el Fosse 11/19. Adéntrate en el extraño y onírico mundo de los personajes Fuuu y la omnipresencia del fuego."
        ],
        "nl": [
          "De vuurmachines van Compagnie Titanos nemen Fosse 11/19 over. Treed binnen in de vreemde, droomachtige wereld van de Fuuu-figuren en de alomtegenwoordigheid van vuur."
        ]
      },
