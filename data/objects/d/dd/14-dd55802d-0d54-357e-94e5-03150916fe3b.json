  "rdfs:comment": {
    "de": [
      "Um die Feuer der Heiligen Barbara anzuzünden, braucht man zunächst Funken, die die Glut während des gesamten Festivals zum Brennen bringen sollen."
    ],
    "en": [
      "To light the Saint Barbara Fires, you first need sparks to keep the embers burning for the duration of the Festival."
    ],
    "it": [
      "Per accendere i Fuochi di Santa Barbara, occorrono innanzitutto le Scintille per mantenere le braci accese per tutta la durata della Festa."
    ],
    "fr": [
      "Pour allumer les Feux de la Sainte Barbe, il faut d’abord des Etincelles destinées à faire brûler les braises pendant toute la durée du Festival."
    ],
    "es": [
      "Para encender los Fuegos de Santa Bárbara, primero necesitas Chispas para mantener las brasas encendidas durante todo el Festival."
    ],
    "nl": [
      "Om de Vuren van Sint Barbara aan te steken, heb je eerst vonken nodig om de sintels het hele Festival lang brandend te houden."
    ]
  },
