  "rdfs:comment": {
    "de": [
      "Das Fremdenverkehrsamt mit Sitz in Péronne verleiht Fahrräder, damit Sie Ihre Naturtage in der Haute Somme genießen können."
    ],
    "en": [
      "The tourist office based in Péronne rents bicycles in order to enjoy your nature days in the Haute Somme."
    ],
    "it": [
      "L'ufficio turistico di Péronne mette a disposizione biciclette a noleggio per godersi le giornate nell'Haute Somme."
    ],
    "fr": [
      "L'office de tourisme basé à Péronne met en location des vélos afin de profiter de vos journées nature en Haute Somme."
    ],
    "es": [
      "La oficina de turismo de Péronne pone a su disposición bicicletas de alquiler para que pueda disfrutar de sus días en la Alta Somme."
    ],
    "nl": [
      "Bij het VVV-kantoor in Péronne kunt u fietsen huren om uw dagen in de Haute Somme te genieten."
    ]
