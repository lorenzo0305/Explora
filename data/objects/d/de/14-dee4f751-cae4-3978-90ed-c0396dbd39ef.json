      "dc:description": {
        "de": [
          "Dienstag, 2. bis Freitag, 5. November 2021\n\nZweistündige Workshops für 8/15-Jährige - Preis: 25 € pro Sitzung\nAuf dem Campus Tourismus und Innovation\nVon 14h bis 16h\n\nReservierung: Coding & Bricks Tel: 06 56 71 66 93"
        ],
        "en": [
          "From Tuesday 2 to Friday 5 November 2021\n\n2 hour workshops for 8/15 year olds - Price: 25 € per session\nAt the Tourism and Innovation Campus\nFrom 2pm to 4pm\n\nReservation: Coding & Bricks Tel: 06 56 71 66 93"
        ],
        "it": [
          "Da martedì 2 a venerdì 5 novembre 2021\n\nLaboratori di 2 ore per bambini di 8/15 anni - Prezzo: 25 ? per sessione\nPresso il Campus del Turismo e dell'Innovazione\nDalle 14:00 alle 16:00\n\nPrenotazione: Coding & Bricks Tel: 06 56 71 66 93"
        ],
        "fr": [
          "Du mardi 2 au vendredi 5 novembre 2021\n\nAteliers de 2h pour les 8/15 ans - Tarif : 25 € par session\nAu Campus Tourisme et Innovation\nDe 14h à 16h\n\nRéservation : Coding & Bricks Tél : 06 56 71 66 93"
        ],
        "nl": [
          "Van dinsdag 2 tot en met vrijdag 5 november 2021\n\nWorkshops van 2 uur voor kinderen van 8/15 jaar - Prijs: 25 ? per sessie\nOp de Campus Toerisme en Innovatie\nVan 14.00 tot 16.00 uur\n\nReservering: Coding & Bricks Tel: 06 56 71 66 93"
        ],
        "es": [
          "Del martes 2 al viernes 5 de noviembre de 2021\n\nTalleres de 2 horas para niños de 8/15 años - Precio: 25€ por sesión\nEn el Campus de Turismo e Innovación\nDe 14 a 16 horas\n\nReservas: Coding & Bricks Tel: 06 56 71 66 93"
        ]
      },
