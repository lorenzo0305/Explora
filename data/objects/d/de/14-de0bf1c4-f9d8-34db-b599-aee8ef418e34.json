  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f2ca777c-bdbc-30a7-afc9-5eba51b4e278",
      "dc:description": {
        "de": [
          "Größe des Beckens: 25 x 10 m\n \nTiefe des Beckens: 0,90 m bis 2,10 m\n \nWassertemperatur: 28°\n \nSchiebedächer\n\nSauna\n \n Möglichkeit der Aufnahme von Freizeitzentren während der kleinen und großen Ferien\n\nDas Tragen einer Mütze ist Pflicht"
        ],
        "en": [
          "Pool size: 25 x 10 m\n \nPool depth: 0.90 m to 2.10 m\n \nWater temperature: 28°C\n \nOpening roofs\n\nSauna\n \n Possibility of hosting leisure centers during the summer and summer vacations\n\nWearing a cap is compulsory"
        ],
        "it": [
          "Dimensioni della piscina: 25 x 10 m\n \nProfondità della piscina: da 0,90 m a 2,10 m\n \nTemperatura dell'acqua: 28°C\n \nTetti apribili\n\nSauna\n \n Possibilità di ospitare centri ricreativi durante le vacanze brevi e lunghe\n\nÈ obbligatorio indossare un berretto"
        ],
        "fr": [
          "Dimension du bassin : 25 x 10 m\n \nProfondeur du bassin : 0,90 m à 2,10 m\n \nTempérature de l’eau : 28°\n \nToits ouvrants \n\nSauna\n \n Possibilité d’accueil des centres de loisirs pendant les petites et les grandes vacances \n\nLe port du bonnet est obligatoire"
        ],
        "es": [
          "Piscina: 25 x 10 m\n \nProfundidad de la piscina: de 0,90 m a 2,10 m\n \nTemperatura del agua: 28°C\n \nTechos practicables\n\nSauna\n \n Posibilidad de albergar centros de ocio durante las vacaciones cortas y largas\n\nEs obligatorio llevar gorra"
        ],
        "nl": [
          "Afmeting zwembad: 25 x 10 m\n \nDiepte zwembad: 0,90 m tot 2,10 m\n \nWater temperatuur: 28°C\n \nDaken openen\n\nSauna\n \n Mogelijkheid tot het hosten van vrijetijdscentra tijdens de korte en lange vakanties\n\nHet dragen van een pet is verplicht"
        ]
      },
