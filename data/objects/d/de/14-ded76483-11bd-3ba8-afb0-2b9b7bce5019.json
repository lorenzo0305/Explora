  "rdfs:comment": {
    "de": [
      "Genießen Sie den Sommer und tanken Sie Sauerstoff bei einer Wanderung durch die Landschaft oder bei einem erfrischenden Bad an einem Fluss."
    ],
    "en": [
      "Take advantage of summer to get some fresh air on a heritage hike in the countryside or cool off along a river."
    ],
    "it": [
      "Approfittate dell'estate per prendere un po' d'aria fresca durante una passeggiata in campagna o per rinfrescarvi lungo un fiume."
    ],
    "fr": [
      "Profitez de l’été pour vous oxygéner le temps d’une randonnée patrimoniale en campagne ou de vous rafraichir le long d’un cours d’eau."
    ],
    "nl": [
      "Profiteer van de zomer om een frisse neus te halen tijdens een erfgoedwandeling op het platteland of om af te koelen langs een rivier."
    ],
    "es": [
      "Aproveche el verano para tomar el aire en un paseo patrimonial por el campo o refrescarse junto a un río."
    ]
  },
