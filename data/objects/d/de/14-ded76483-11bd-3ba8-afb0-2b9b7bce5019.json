  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/85bfdca3-f381-332e-9a15-543462ec4fab",
      "dc:description": {
        "de": [
          "Beginnen Sie den Sommer mit dem Juli und der frischen Luft! Entdecken Sie das Gebiet auf einer Wanderung, um die Landschaft im Herzen der ländlichen Gemeinden des Gebiets zu erkunden!"
        ],
        "en": [
          "Start the summer with the month of July and the fresh air! Discover the region on a landscape-reading hike through its rural communities!"
        ],
        "it": [
          "Iniziate l'estate con luglio e l'aria fresca! Scoprite la regione con un'escursione a piedi, per scoprire la campagna nel cuore delle sue comunità rurali!"
        ],
        "fr": [
          "Débutez l’été avec le mois de juillet et le bon air ! Découvrez le territoire lors d’une randonnée pour une lecture de paysage au cœur des communes rurales du territoire !"
        ],
        "es": [
          "¡Comience el verano con julio y el aire fresco! Descubra la región a pie, en plena naturaleza y en el corazón de las comunidades rurales"
        ],
        "nl": [
          "Begin de zomer met juli en frisse lucht! Ontdek de omgeving tijdens een wandeltocht en geniet van het platteland in het hart van de landelijke gemeenschappen in de regio!"
        ]
      },
      "@type": [
        "Description"
