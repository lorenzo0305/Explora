      "dc:description": {
        "de": [
          "Das Hotel liegt nur wenige Meter vom Bahnhof Lens entfernt.\nEntdecken Sie eine gemütliche Umgebung und eine familiäre Atmosphäre zu einem günstigen Preis:"
        ],
        "en": [
          "Located just a few meters from Lens train station.\nCome and discover a warm, family atmosphere at an affordable price:"
        ],
        "it": [
          "Situato a pochi metri dalla stazione di Lens.\nVenite a scoprire un'atmosfera calda e familiare a un prezzo accessibile:"
        ],
        "fr": [
          "Situé à quelques mètres de la gare de Lens.\nVenez découvrir un cadre chaleureux et une ambiance familiale pour un prix économique :"
        ],
        "es": [
          "Situado a pocos metros de la estación de Lens.\nVenga a descubrir un ambiente cálido y familiar a un precio asequible:"
        ],
        "nl": [
          "Gelegen op een paar meter van het station van Lens.\nKom en ontdek een warme, familiale sfeer tegen een betaalbare prijs:"
        ]
      },
