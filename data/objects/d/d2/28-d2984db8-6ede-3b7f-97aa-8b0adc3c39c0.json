  "rdfs:comment": {
    "de": [
      "Entdecken Sie in einem zeitgenössischen, warmen und freundlichen Ambiente eine Küche, die aus den besten Produkten von Land und Meer besteht und von einem aufmerksamen Service begleitet wird."
    ],
    "en": [
      "In a contemporary, warm and friendly setting, discover a cuisine composed of the best products of the earth and the sea, accompanied by an attentive service."
    ],
    "it": [
      "In un ambiente contemporaneo, caldo e accogliente, scoprite una cucina composta dai migliori prodotti della terra e del mare, accompagnata da un servizio attento."
    ],
    "fr": [
      "Dans un cadre contemporain, chaleureux et convivial, découvrez une cuisine  composée des meilleurs produits de la terre et de la mer, accompagnée d'un service attentionné."
    ],
    "nl": [
      "In een modern, warm en vriendelijk kader ontdekt u een keuken samengesteld uit de beste producten van het land en de zee, vergezeld van een attente service."
    ],
    "es": [
      "En un ambiente contemporáneo, cálido y acogedor, descubra una cocina compuesta por los mejores productos de la tierra y del mar, acompañada de un servicio atento."
    ]
  },
