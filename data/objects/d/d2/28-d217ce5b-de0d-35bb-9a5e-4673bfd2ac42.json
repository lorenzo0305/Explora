  "rdfs:comment": {
    "de": [
      "Seit 2008 bietet Ihnen La Capsule eine große Auswahl an handwerklich gebrauten Bieren und Wurstplatten. Diese malerische Bar mit ihrem rustikalen Chic ist der ideale Ort, um gesellige Stunden mit Freunden oder der Familie zu genießen."
    ],
    "en": [
      "Since 2008, La Capsule has been offering a wide selection of craft beers and charcuterie platters. This picturesque bar, with its rustic chic setting, is the ideal place to enjoy convivial moments with friends or family."
    ],
    "it": [
      "Dal 2008, La Capsule offre un'ampia selezione di birre artigianali e taglieri di salumi. Questo bar pittoresco, con il suo ambiente rustico e chic, è il luogo ideale per trascorrere momenti conviviali con gli amici o la famiglia."
    ],
    "fr": [
      "Depuis 2008, La Capsule vous propose une vaste sélection de bières artisanales et des plateaux de charcuteries. Ce bar pittoresque, au cadre rustique chic, est l'endroit idéal pour profiter des moments conviviaux entre amis ou en famille."
    ],
    "nl": [
      "Sinds 2008 biedt La Capsule een uitgebreide selectie ambachtelijke bieren en vleeswarengerechten. Deze pittoreske bar, met zijn rustieke chique setting, is de ideale plek om te genieten van gezellige momenten met vrienden of familie."
    ],
    "es": [
      "Desde 2008, La Capsule ofrece una amplia selección de cervezas artesanales y tablas de embutidos. Este pintoresco bar, con su ambiente rústico chic, es el lugar ideal para disfrutar de momentos de convivencia con los amigos o la familia."
    ]
  },
