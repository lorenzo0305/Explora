  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3d3d6a33-08ba-3e1b-be02-52f2fc707823",
      "dc:description": {
        "de": [
          "- Les heures artistiques - Les Bulles Géantes sind ein purer Spaß für Kinder ab 4 Jahren, bei dem sie sich mit Hilfe von Zauberstäben und Seifenblasenbläsern in der Luft ausdrücken können. Treffpunkt um 19:30 Uhr auf der Esplanade mit der Kompanie Magi'Potes."
        ],
        "en": [
          "- Les heures artistiques - Les Bulles Géantes is pure fun for children aged 4 and over, allowing them to express themselves in the air using bubble-blowing wands and blowers. Rendezvous at 7.30pm on the Esplanade with the Magi'Potes company."
        ],
        "it": [
          "- Les heures artistiques - Les Bulles Géantes è un puro divertimento per i bambini dai 4 anni in su, che potranno esprimersi nell'aria utilizzando bastoni e soffiatori di bolle. Appuntamento alle 19.30 sull'Esplanade con la compagnia Magi'Potes."
        ],
        "fr": [
          "- Les heures artistiques - Les Bulles Géantes sont un pur moment d'amusement pour les enfants dès 4 ans qui leur permettent de s'exprimer dans les airs à l'aide de baguettes et de souffleurs à bulles. Rendez-vous à 19h30 sur l'Esplanade avec la compagnie Magi'Potes."
        ],
        "nl": [
          "- Les heures artistiques - Les Bulles Géantes is puur plezier voor kinderen vanaf 4 jaar, waarbij ze zich in de lucht kunnen uitdrukken met bellenstokken en blaasmachines. Verzamelen om 19.30 uur op de Esplanade met het gezelschap Magi'Potes."
        ],
        "es": [
          "- Les heures artistiques - Les Bulles Géantes es pura diversión para los niños a partir de 4 años, ya que les permite expresarse en el aire utilizando palos de burbujas y sopladores. Cita a las 19.30 h en la Explanada con la compañía Magi'Potes."
        ]
      },
