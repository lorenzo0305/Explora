      "dc:description": {
        "de": [
          "Der Club bietet einen Intensivkurs 27. bis 31. Oktober an\nAnmeldung unter 03 21 32 47 46 (10.00 - 12.00 Uhr und 15.30 - 19.00 Uhr) oder per E-Mail: tennis-wimereux@fft.fr"
        ],
        "en": [
          "The club is offering an intensive course from October 27 to 31\nTo register, call 03 21 32 47 46 (10.00am - 12.00pm and 3.30pm - 7.00pm) or email tennis-wimereux@fft.fr"
        ],
        "it": [
          "Il club offre un corso intensivo dal 27 al 31 ottobre\nPer iscriversi, chiamare il numero 03 21 32 47 46 (dalle 10.00 alle 12.00 e dalle 15.30 alle 19.00) o inviare un'e-mail a tennis-wimereux@fft.fr"
        ],
        "fr": [
          "Le club propose un stage intensif 27 au 31 octobre  \nInscription au 03 21 32 47 46 (10h00 - 12h00 et 15h30 - 19h00) ou par mail : tennis-wimereux@fft.fr"
        ],
        "es": [
          "El club ofrece un curso intensivo del 27 al 31 de octubre\nPara inscribirse, llame al 03 21 32 47 46 (de 10.00 a 12.00 y de 15.30 a 19.00) o envíe un correo electrónico a: tennis-wimereux@fft.fr"
        ],
        "nl": [
          "De club biedt een intensieve cursus aan van 27 tot 31 oktober\nOm je in te schrijven, bel 03 21 32 47 46 (10u - 12u en 15u30 - 19u) of e-mail: tennis-wimereux@fft.fr"
        ]
      },
