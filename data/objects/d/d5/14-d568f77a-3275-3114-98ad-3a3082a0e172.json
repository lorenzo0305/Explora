      "dc:description": {
        "de": [
          "Charlotte begrüßt Sie in ihrem Weinkeller, in dem Sie Weine, Champagner, Bier und Spirituosen kaufen und eine Bierpumpe mieten können."
        ],
        "en": [
          "Charlotte welcomes you to her wine, champagne, beer and spirits cellar, and beer pump rental."
        ],
        "it": [
          "Charlotte vi dà il benvenuto nella sua cantina di vini, champagne, birra e liquori, dove potrete noleggiare una pompa di birra."
        ],
        "fr": [
          "Charlotte vous accueille  dans sa Cave à vins, champagnes, bières et spiritueux, location de pompe à bière."
        ],
        "es": [
          "Charlotte le da la bienvenida a su bodega de vinos, champán, cerveza y licores, donde podrá alquilar un surtidor de cerveza."
        ],
        "nl": [
          "Charlotte heet je welkom in haar wijn-, champagne-, bier- en sterke drankenkelder, waar je een bierpomp kunt huren."
        ]
