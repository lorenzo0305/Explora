  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b0dd987c-69ec-36a5-9b24-b8c6c1feddfb",
      "dc:description": {
        "de": [
          "Große musikalische Erinnerungen\nSamstag, den 28. Februar um 19.00 Uhr\n5 place de la Gare ? Montreuil-Ville Basse\n----------------------------\nBlockiere dein Datum, keine Ausrede, komm und tanze mit uns!\n Ein einzigartiges Programm :\n-          House, Techno, Trance, Hardgroove?\n-          Organisiert und beschallt von OMAHATEK\n \nVerpflegung vor Ort, Bar, kostenloser Parkplatz\nPreis: 3? Eintritt - Goodies und Accessoires zum Verkauf\n Kredit: La Maison des Faiseurs"
        ],
        "en": [
          "Great musical memories\nSaturday, February 28 at 7:00 pm\n5 place de la Gare ? Montreuil-Ville Basse\n----------------------------\nSave the date, no excuses, come and dance with us!\n A unique program :\n-          House, techno, trance, hardgroove?\n-          Organized and soundtracked by OMAHATEK\n \nOn-site catering, bar, free parking\nAdmission: 3? - Goodies and accessories for sale\n Credit: La Maison des Faiseurs"
        ],
        "it": [
          "Grandi ricordi musicali\nSabato 28 febbraio alle 19.00\n5 place de la Gare ? Montreuil-Ville Basse\n----------------------------\nNon ci sono scuse, venite a ballare con noi!\n Un programma unico:\n-          House, techno, trance, hardgroove?\n-          Organizzato e prodotto da OMAHATEK\n \nRistorazione in loco, bar, parcheggio gratuito\nIngresso: 3 euro - Vendita di articoli e accessori\n Credit: La Maison des Faiseurs"
        ],
        "fr": [
          "Grands souvenirs musicaux\nSamedi 28 février à 19h00\n5 place de la Gare – Montreuil-Ville Basse\n----------------------------\nBloque ta date, pas d’excuse, viens danser avec nous !\n Un programme unique :\n-          House, techno, trance, hardgroove…\n-          Organisé et sonorisé par OMAHATEK\n \nRestauration sur place, bar, parking gratuit\nTarif : 3€ l’entrée - Goodies et accessoires à vendre\n Crédit : La Maison des Faiseurs"
        ],
        "es": [
          "Grandes recuerdos musicales\nSábado 28 de febrero a las 19.00 h\n5 place de la Gare ? Montreuil-Ville Basse\n----------------------------\nReserve la fecha, no hay excusas, ¡venga a bailar con nosotros!\n Un programa único :\n-          House, techno, trance, hardgroove?\n-          Organizado y producido por OMAHATEK\n \nCatering, bar, aparcamiento gratuito\nEntrada: 3 euros - Venta de artículos y accesorios\n Crédito: La Maison des Faiseurs"
        ],
        "nl": [
          "Geweldige muzikale herinneringen\nZaterdag 28 februari om 19.00 uur\n5 place de la Gare ? Montreuil-Ville Basse\n----------------------------\nSave the date, geen excuses, kom met ons dansen!\n Een uniek programma :\n-          House, techno, trance, hardgroove?\n-          Georganiseerd en geproduceerd door OMAHATEK\n \nCatering ter plaatse, bar, gratis parkeren\nToegangsprijs: 3 euro - Goodies en accessoires te koop\n Krediet: La Maison des Faiseurs"
        ]
      },
