  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee30337f-7374-3441-b792-036a82565733",
      "dc:description": {
        "de": [
          "Wettbewerb im Forellenangeln - Étangs Le Martin Pêcheur\nHinweis an alle Angler!\n\nNehmen Sie am großen Forellenangelwettbewerb teil, der von \"Le Martin Pêcheur\" organisiert wird.\nDiese Veranstaltung ist für alle offen, egal ob Sie ein erfahrener Angler oder ein Anfänger sind."
        ],
        "en": [
          "Trout Fishing Competition - Étangs Le Martin Pêcheur\nNotice to all anglers!\n\nTake part in the big trout fishing competition organized by \"Le Martin Pêcheur\".\nThis event is open to all, whether you're an experienced angler or a beginner."
        ],
        "it": [
          "Gara di pesca alla trota - Étangs Le Martin Pêcheur\nAvviso a tutti i pescatori!\n\nPartecipate alla gara di pesca alla trota grossa organizzata da \"Le Martin Pêcheur\".\nQuesto evento è aperto a tutti, sia ai pescatori esperti che ai principianti."
        ],
        "fr": [
          "Concours de Pêche aux Truites - Étangs Le Martin Pêcheur\nAvis à tous les pêcheurs !\n\nParticipez au grand concours de pêche aux truites organisé par \"Le Martin Pêcheur\".\nCet événement est ouvert à tous, que vous soyez pêcheur confirmé ou débutant."
        ],
        "nl": [
          "Wedstrijd forelvissen - Étangs Le Martin Pêcheur\nBericht aan alle vissers!\n\nDoe mee aan de grote forelviswedstrijd georganiseerd door \"Le Martin Pêcheur\".\nDit evenement staat open voor iedereen, of je nu een ervaren visser bent of een beginner."
        ],
        "es": [
          "Concurso de pesca de truchas - Étangs Le Martin Pêcheur\n¡Aviso a todos los pescadores!\n\nParticipe en el gran concurso de pesca de truchas organizado por \"Le Martin Pêcheur\".\nEste evento está abierto a todos, tanto a los pescadores experimentados como a los principiantes."
        ]
      },
      "@type": [
        "Description"
      ],
