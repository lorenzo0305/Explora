  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/766cd5fc-37ac-3a6c-b15c-ca81ebbe1c70",
      "dc:description": {
        "de": [
          "Die gelungene Integration einer zeitgenössischen Innenarchitektur in ein klassisches Gebäude ist sehenswert. Eingang über den Ehrenhof der Abtei, Rue Paul-Doumer."
        ],
        "en": [
          "The successful integration of contemporary interior architecture into a classic édiﬁce is worth a look. Entrance via the main courtyard of the abbey, rue Paul-Doumer."
        ],
        "it": [
          "Vale la pena di vedere la riuscita integrazione di un'architettura d'interni contemporanea in un edificio classico. Ingresso dal cortile principale dell'abbazia, rue Paul-Doumer."
        ],
        "fr": [
          "L’intégration réussie d’une architecture intérieure contemporaine dans un édiﬁce classique vaut le coup d’œil. Entrée par la cour d’honneur de l’abbaye, rue Paul-Doumer."
        ],
        "es": [
          "El éxito de la integración de la arquitectura interior contemporánea en un edificio clásico es digno de ver. Entrada por el patio principal de la abadía, calle Paul-Doumer."
        ],
        "nl": [
          "De geslaagde integratie van hedendaagse interieurarchitectuur in een klassiek gebouw is bezienswaardig. Ingang via de binnenplaats van de abdij, rue Paul-Doumer."
        ]
      },
