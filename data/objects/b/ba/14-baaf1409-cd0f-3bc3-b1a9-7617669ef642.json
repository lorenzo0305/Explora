      "dc:description": {
        "de": [
          "Weihnachtsschminken & heiße Schokolade\n- Samstag, den 9. Dezember von 14.30 bis 17 Uhr\n- Sonntag, 10. Dezember von 9:30 bis 12:00 Uhr\n- Mittwoch, 13. Dezember von 14:30 bis 17:30 Uhr\n- Samstag, 16. Dezember von 14:30 bis 17:00 Uhr\n- Mittwoch, 20. Dezember von 14.30 bis 17.30 Uhr"
        ],
        "en": [
          "Christmas make-up & hot chocolate\n- Saturday, December 9, 2:30 pm to 5 pm\n- Sunday, December 10, 9:30am to 12pm\n- Wednesday, December 13, 2:30 pm to 5:30 pm\n- Saturday, December 16, 2:30 pm to 5:00 pm\n- Wednesday, December 20, 2.30 pm to 5.30 pm"
        ],
        "it": [
          "Pittura facciale natalizia e cioccolata calda\n- Sabato 9 dicembre dalle 14.30 alle 17.00\n- Domenica 10 dicembre dalle 9.30 alle 12.00\n- Mercoledì 13 dicembre dalle 14.30 alle 17.30\n- Sabato 16 dicembre dalle 14.30 alle 17.00\n- Mercoledì 20 dicembre, dalle 14.30 alle 17.30"
        ],
        "fr": [
          "Maquillage de Noël & chocolat chaud\n- Samedi 9 décembre de 14h30 à 17h\n- Dimanche 10 décembre de 9h30 à 12h\n- Mercredi 13 décembre de 14h30 à 17h30\n- Samedi 16 décembre de 14h30 à 17h\n- Mercredi 20 décembre de 14h30 à 17h30"
        ],
        "es": [
          "Pintura de caras navideña y chocolate caliente\n- Sábado 9 de diciembre de 14h30 a 17h00\n- Domingo 10 de diciembre de 9h30 a 12h00\n- Miércoles 13 de diciembre de 14.30 a 17.30 horas\n- Sábado 16 de diciembre de 14.30 a 17.00\n- Miércoles 20 de diciembre de 14h30 a 17h30"
        ],
        "nl": [
          "Kerst schminken & warme chocolademelk\n- Zaterdag 9 december van 14.30 tot 17.00 uur\n- Zondag 10 december van 9.30 tot 12 uur\n- Woensdag 13 december van 14.30 tot 17.30 uur\n- Zaterdag 16 december van 14.30 tot 17.00 uur\n- Woensdag 20 december van 14.30 tot 17.30 uur"
        ]
