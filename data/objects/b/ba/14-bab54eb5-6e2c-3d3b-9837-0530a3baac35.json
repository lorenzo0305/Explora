  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/56887e0c-0c7c-39e7-a085-576177a25634",
      "dc:description": {
        "de": [
          "55 avenue J. Kennedy\n06 60 70 13 74 ? chapelledusaintsang62@orange.fr\n\nSamstag und Sonntag: 10:00-18:30 Uhr\nFreie oder begleitete Besichtigung.\nKapelle, die an die Reliquie des Blutes Christi erinnert, die von Godefroy de Bouillon im Jahr 1100 geschickt wurde.\nBegrenzte Besucherzahl von 25 Personen."
        ],
        "en": [
          "55 avenue J. Kennedy\n06 60 70 13 74 ? chapelledusaintsang62@orange.fr\n\nSaturday and Sunday: 10am-6.30pm\nSelf-guided or guided tour.\nChapel commemorating the relic of Christ's blood sent by Godefroy de Bouillon in 1100.\nCapacity limited to 25 people."
        ],
        "it": [
          "55 avenue J. Kennedy\n06 60 70 13 74 ? chapelledusaintsang62@orange.fr\n\nSabato e domenica: 10-18.30\nVisita autogestita o guidata.\nCappella commemorativa della reliquia del sangue di Cristo inviata da Godefroy de Bouillon nel 1100.\nCapacità limitata a 25 persone."
        ],
        "fr": [
          "55 avenue J. Kennedy\n06 60 70 13 74 – chapelledusaintsang62@orange.fr\n\nSamedi et dimanche : 10h-18h30\nVisite libre ou accompagnée.\nChapelle commémorant la relique du sang du Christ envoyée par Godefroy de Bouillon en 1100.\nJauge limitée à 25 personnes."
        ],
        "es": [
          "55 avenue J. Kennedy\n06 60 70 13 74 ? chapelledusaintsang62@orange.fr\n\nSábados y domingos: de 10.00 a 18.30 h\nVisita autoguiada o guiada.\nCapilla conmemorativa de la reliquia de la sangre de Cristo enviada por Godofredo de Bouillon en 1100.\nAforo limitado a 25 personas."
        ],
        "nl": [
          "55 J. Kennedylaan\n06 60 70 13 74 ? chapelledusaintsang62@orange.fr\n\nZaterdag en zondag: 10-18u30\nRondleiding met of zonder gids.\nKapel ter herdenking van de relikwie van het bloed van Christus, gestuurd door Godefroy de Bouillon in 1100.\nCapaciteit beperkt tot 25 personen."
        ]
      },
