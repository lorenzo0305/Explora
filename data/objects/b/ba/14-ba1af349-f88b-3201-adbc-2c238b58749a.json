  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f571af53-d85d-30c4-bb60-f8611154c49b",
      "dc:description": {
        "de": [
          "Die Funny Days sind Spiele, Ausflüge, Aufführungen und sportliche Herausforderungen für die ganze Familie und den ganzen Sommer lang. Ein dichtes und abwechslungsreiches Programm, mit dem man einen tollen Sommer verbringen kann!"
        ],
        "en": [
          "Funny Days offers games, outings, shows and sporting challenges for the whole family, all summer long. A dense and varied program, enough to spend a superb summer!"
        ],
        "it": [
          "Funny Days offre giochi, gite, spettacoli e sfide sportive per tutta la famiglia, per tutta l'estate. Con un programma ricco e vario, sarà sicuramente un'estate fantastica!"
        ],
        "fr": [
          "Les Funny Days ce sont des jeux, des sorties, des spectacles et des défis sportifs pour toute la famille et pendant tout l'été. Une programmation dense et variée, de quoi passer un superbe été !"
        ],
        "es": [
          "Funny Days ofrece juegos, salidas, espectáculos y retos deportivos para toda la familia durante todo el verano. Con un programa repleto y variado, ¡seguro que será un verano estupendo!"
        ],
        "nl": [
          "Funny Days biedt de hele zomer spelletjes, uitjes, shows en sportieve uitdagingen voor het hele gezin. Met een bomvol en gevarieerd programma wordt het zeker een geweldige zomer!"
        ]
      },
