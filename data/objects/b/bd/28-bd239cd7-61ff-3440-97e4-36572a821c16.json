  "rdfs:comment": {
    "de": [
      "Dieses kleine Museum erzählt von der Jugend des Dorfkindes Jean Racine. Anhand zahlreicher Dokumente und Zeugnisse können Sie sein Werk kennenlernen. Für einen sympathischen Blick auf die Stadt sollten Sie Ihren Besuch anschließend bis zur Fassade des Schlosses der Herzöge von Orléans ausdehnen. Gehen Sie dann wieder hinunter bis zur Brücke..."
    ],
    "en": [
      "This small museum retraces the youth of the village child, Jean Racine. Numerous documents and testimonies allow you to discover his work. For a nice view of the town, then push your visit to the facade of the castle of the Dukes of Orleans. Then, go down to the bridge..."
    ],
    "it": [
      "Questo piccolo museo ripercorre la giovinezza del figlio del villaggio, Jean Racine. Numerosi documenti e testimonianze permettono di scoprire il suo lavoro. Per una bella vista sulla città, salite sulla facciata del Castello dei Duchi d'Orléans. Poi, tornate giù al ponte..."
    ],
    "fr": [
      "Ce petit musée retrace la jeunesse de l'enfant du village, Jean Racine. De nombreux documents, témoignages vous permettent de découvrir son oeuvre. Pour une vue sympathique sur la ville, poussez ensuite votre visite jusqu'à la façade du château des Ducs d'Orléans. Puis, redescendez jusqu'au pont..."
    ],
    "es": [
      "Este pequeño museo recorre la juventud del niño del pueblo, Jean Racine. Numerosos documentos y testimonios permiten descubrir su obra. Para disfrutar de una bonita vista de la ciudad, suba a la fachada del Château des Ducs d'Orléans. Entonces, vuelve a bajar al puente..."
    ],
    "nl": [
      "Dit kleine museum toont de jeugd van het kind van het dorp, Jean Racine. Talrijke documenten en getuigenissen laten u zijn werk ontdekken. Voor een mooi uitzicht over de stad gaat u naar de gevel van het Château des Ducs d'Orléans. Ga dan terug naar de brug..."
    ]
  },
