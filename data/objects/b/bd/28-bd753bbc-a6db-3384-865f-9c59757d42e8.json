  "rdfs:comment": {
    "de": [
      "Die Kirche Saint-Lucien et Saint-Fiacre: Diese Kirche wurde kürzlich von der Communauté de Communes des Sablons restauriert und verfügt über ein romanisches Kirchenschiff, einen Chor aus Backstein aus dem 19."
    ],
    "en": [
      "The church of Saint-Lucien and Saint-Fiacre: Recently restored by the Communauté de Communes des Sablons, this church has a Romanesque nave, a 19th century brick choir and a small chapel."
    ],
    "it": [
      "Chiesa di Saint-Lucien e Saint-Fiacre: recentemente restaurata dalla Communauté de Communes des Sablons, questa chiesa presenta una navata romanica, un coro in mattoni del XIX secolo e una piccola cappella."
    ],
    "fr": [
      "L'église Saint-Lucien et Saint-Fiacre : Récemment restaurée par la Communauté de Communes des Sablons, cette église possède une nef romane, un chœur de briques du XIXème siècle et une petite chapelle."
    ],
    "es": [
      "Iglesia de Saint-Lucien y Saint-Fiacre: recientemente restaurada por la Communauté de Communes des Sablons, esta iglesia tiene una nave románica, un coro de ladrillo del siglo XIX y una pequeña capilla."
    ],
    "nl": [
      "De kerk Saint-Lucien en Saint-Fiacre: Deze kerk is onlangs gerestaureerd door de Communauté de Communes des Sablons en heeft een romaans schip, een 19e-eeuws bakstenen koor en een kleine kapel."
    ]
  },
