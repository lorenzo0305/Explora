  "rdfs:comment": {
    "de": [
      "Tiot Loupiot ist das Festival für sehr junges Publikum in Hauts de France. Auf geht's zur 24. Ausgabe des Festivals für Babys und Kinder bis 6 Jahre."
    ],
    "en": [
      "Tiot Loupiot is the very young audience festival in the Hauts de France region. Let's get ready for the 24th edition of the festival for babies and children up to 6 years old."
    ],
    "it": [
      "Tiot Loupiot è il festival dei giovanissimi della regione Hauts de France. Prepariamoci alla 24ª edizione di questo festival per neonati e bambini fino a 6 anni."
    ],
    "fr": [
      "Tiot Loupiot c'est le festival très jeune public des Hauts de France. En route pour la 24e édition du festival pour les bébés et les enfants jusqu’à 6 ans."
    ],
    "nl": [
      "Tiot Loupiot is het festival voor heel jong publiek in de regio Hauts de France. Bereid je voor op de 24e editie van dit festival voor baby's en kinderen tot 6 jaar."
    ],
    "es": [
      "Tiot Loupiot es el festival para el público más joven de la región de Hauts de France. Preparémonos para la 24ª edición de este festival para bebés y niños de hasta 6 años."
    ]
  },
