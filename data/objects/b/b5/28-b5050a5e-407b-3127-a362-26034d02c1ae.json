  "rdfs:comment": {
    "de": [
      "Les Automnales de Montigny-en-Ostrevent feiert jedes Jahr am letzten Oktoberwochenende die Traditionstage des Nordens. Auf dem Programm stehen: Hutzeremonie, Braderie, Folkloreumzug, Handwerkermesse, Tanzabend und viele andere Überraschungen warten auf Sie."
    ],
    "en": [
      "Every year, Les Automnales de Montigny-en-Ostrevent celebrates the Journées Traditions du Nord on the last weekend of October. On the program: hat ceremony, braderie, folk procession, craft fair, dance and many other surprises."
    ],
    "it": [
      "Ogni anno, Les Automnales de Montigny-en-Ostrevent celebrano le Journées Traditions du Nord l'ultimo fine settimana di ottobre. Il programma prevede una cerimonia del cappello, un'asta, una processione folkloristica, una fiera dell'artigianato, un ballo e molte altre sorprese."
    ],
    "fr": [
      "Les Automnales de Montigny-en-Ostrevent fête chaque année les Journées Traditions du Nord le dernier week-end d'octobre. Au programme : cérémonie du chapeau, braderie, cortège folklorique, salon des artisans, soirée dansante et tant d'autres surprises vous attendent."
    ],
    "es": [
      "Todos los años, Les Automnales de Montigny-en-Ostrevent celebran las Journées Traditions du Nord el último fin de semana de octubre. El programa incluye una ceremonia del sombrero, una subasta, un desfile folclórico, una feria de artesanía, un baile y muchas otras sorpresas."
    ],
    "nl": [
      "Elk jaar vieren Les Automnales de Montigny-en-Ostrevent de Journées Traditions du Nord in het laatste weekend van oktober. Op het programma staan een hoedenceremonie, een veiling, een folkloristische optocht, een ambachtsbeurs, een dans en nog veel meer verrassingen."
    ]
  },
