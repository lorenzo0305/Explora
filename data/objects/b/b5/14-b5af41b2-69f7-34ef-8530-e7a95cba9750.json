  "rdfs:comment": {
    "de": [
      "Ein Verein \"Ensemble au verger\" (Gemeinsam im Obstgarten), der alte Apfelsorten aus der Region in einem Obstgarten namens \"le verger des Vertes Collines\" (Obstgarten der Grünen Hügel) in Monchy-Cayeux (Pas-de-Calais) im grünen Artois bewahrt."
    ],
    "en": [
      "An association called \"Ensemble au verger\" (Together in the orchard) preserves old varieties of local apple trees in a sonervatory orchard called \"le verger des Vertes Collines\" at Monchy-Cayeux (Pas-de-Calais) in the Artois vert region."
    ],
    "it": [
      "Un'associazione chiamata \"Ensemble au verger\" (\"Insieme nel frutteto\") che conserva vecchie varietà di meli locali in un frutteto figlio chiamato \"le verger des Vertes Collines\" a Monchy-Cayeux (Pas-de-Calais), nella regione del verde Artois."
    ],
    "fr": [
      "Une association \"Ensemble au verger\" qui sauvegarde les anciennes variétés de pommiers du terroir  dans un verger sonservatoire appelé \"le verger des Vertes Collines\" à Monchy-Cayeux (Pas-de-Calais) dans l'Artois vert."
    ],
    "es": [
      "Una asociación llamada \"Ensemble au verger\" (\"Juntos en el huerto\") que preserva variedades antiguas de manzanos locales en un huerto sonervatorio llamado \"le verger des Vertes Collines\" en Monchy-Cayeux (Pas-de-Calais), en la región del Artois verde."
    ],
    "nl": [
      "Een vereniging genaamd \"Ensemble au verger\" (\"Samen in de boomgaard\") die oude variëteiten van lokale appelbomen in stand houdt in een boomgaard die \"le verger des Vertes Collines\" heet in Monchy-Cayeux (Pas-de-Calais) in de groene Artoisstreek."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le verger des vertes collines"
    ]
  },
