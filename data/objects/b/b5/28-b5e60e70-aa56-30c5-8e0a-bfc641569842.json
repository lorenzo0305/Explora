  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2434c83b-b348-3b84-9b09-e9620b4a7bda",
      "dc:description": {
        "de": [
          "Es ist vor allem eine gesellige Bar. Hier treffen sich viele Bier-, Wein- und Champagnerliebhaber in einem gemütlichen Rahmen und im Sommer auf einer Sonnenterrasse."
        ],
        "en": [
          "It is above all a friendly bar. The meeting place for many beer, wine and champagne lovers in a cosy setting and in summer on a sunny terrace."
        ],
        "it": [
          "È soprattutto un bar accogliente. Il luogo d'incontro di molti amanti della birra, del vino e dello champagne in un ambiente accogliente e in estate su una terrazza soleggiata."
        ],
        "fr": [
          "C'est avant tout un bar convivial. Le rdv de nombreux amateurs de bières, vins et champagnes dans un cadre cosy et l'été sur une terrasse ensoleillé."
        ],
        "nl": [
          "Het is vooral een gezellige bar. De ontmoetingsplaats voor vele bier-, wijn- en champagneliefhebbers in een gezellig kader en in de zomer op een zonnig terras."
        ],
        "es": [
          "Es sobre todo un bar acogedor. El lugar de encuentro de muchos amantes de la cerveza, el vino y el champán en un entorno acogedor y, en verano, en una soleada terraza."
        ]
      },
