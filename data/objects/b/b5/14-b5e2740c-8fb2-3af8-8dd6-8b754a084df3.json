  "rdfs:comment": {
    "de": [
      "François Cervantes lädt Sie zu seinem Bankett mit köstlichem Humor ein, der von Emotionen und Poesie genährt wird und eine wahre Liebeserklärung an das Theater und das Publikum darstellt."
    ],
    "en": [
      "François Cervantes invites you to his banquet of savory humor, emotion and poetry, a true declaration of love for the theater and the audience."
    ],
    "it": [
      "François Cervantes vi invita al suo banchetto di umorismo, emozione e poesia, una vera dichiarazione d'amore per il teatro e per il pubblico."
    ],
    "fr": [
      "François Cervantes vous convie à son banquet à l’humour savoureux nourri d’émotion et de poésie, véritable déclaration d’amour au théâtre et au public."
    ],
    "nl": [
      "François Cervantes nodigt je uit voor zijn banket van hartige humor, emotie en poëzie, een ware liefdesverklaring aan het theater en het publiek."
    ],
    "es": [
      "François Cervantes le invita a su banquete de sabroso humor, emoción y poesía, una verdadera declaración de amor al teatro y al público."
    ]
  },
