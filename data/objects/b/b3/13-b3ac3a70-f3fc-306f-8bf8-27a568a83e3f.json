  "rdfs:comment": {
    "de": [
      "Im Herzen des Waldes von Mormal liegt dieses ehemalige Jagdschloss, das heute ein Gasthaus ist und seit 28 Jahren von derselben Familie geführt wird."
    ],
    "en": [
      "Located in the heart of the forest of Mormal, this former hunting lodge, now inn is held for 28 years by the same family."
    ],
    "it": [
      "Situata nel cuore della foresta di Mormal, questa ex casa di caccia, ora locanda, è gestita dalla stessa famiglia da 28 anni."
    ],
    "fr": [
      "Situé en plein cœur de la forêt de Mormal cet ancien relais de chasse, désormais auberge est tenu depuis 28 ans par la même famille."
    ],
    "es": [
      "Situado en el corazón del bosque de Mormal, este antiguo pabellón de caza, ahora posada, está regentado por la misma familia desde hace 28 años."
    ],
    "nl": [
      "Gelegen in het hart van het mormelbos, wordt dit voormalige jachthuis, nu een herberg, al 28 jaar gerund door dezelfde familie."
    ]
