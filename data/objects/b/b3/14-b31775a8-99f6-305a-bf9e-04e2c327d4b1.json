  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b7e50247-7f60-3dc2-b60c-b5d2bc3b2b26",
      "dc:description": {
        "de": [
          "Gegenüber dem Belfried von Arras bieten wir Ihnen eine große Auswahl an Bieren, Cocktails, verschiedenen Erfrischungen und Desserts.\nGenießen Sie mittags und abends unsere traditionelle Brasserie und unsere regionalen Spezialitäten."
        ],
        "en": [
          "Facing the Arras belfry, we offer a wide range of beers, cocktails, refreshments and desserts.\nEnjoy our traditional brasserie and regional specialities for lunch and dinner."
        ],
        "it": [
          "Di fronte al campanile di Arras, offriamo un'ampia gamma di birre, cocktail, bevande e dessert.\nGodetevi la nostra brasserie tradizionale e le specialità regionali a pranzo e a cena."
        ],
        "fr": [
          "Face au beffroi d'Arras, nous vous porposons une large gamme de bières, cocktails, rafraîchissements divers et desserts. \nVenez vous y restaurer midi et soir avec notre brasserie traditionnelle et nos spécialités régionales. "
        ],
        "nl": [
          "Tegenover het belfort van Arras bieden we een ruim assortiment bieren, cocktails, versnaperingen en desserts.\nGeniet van onze traditionele brasserie en regionale specialiteiten voor lunch en diner."
        ],
        "es": [
          "Frente al campanario de Arras, ofrecemos una amplia gama de cervezas, cócteles, refrescos y postres.\nDisfrute de nuestra brasserie tradicional y especialidades regionales para el almuerzo y la cena."
        ]
      },
      "@type": [
        "Description"
