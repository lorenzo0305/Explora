        "de": [
          "Das Syndicat d'élevage du Haut boulonnais organisiert die Fête de l'Attelage in Maninghem\nReservierung beim Fremdenverkehrsamt Haut-Pays Côte d'Opale"
        ],
        "en": [
          "The Syndicat d'élevage du Haut boulonnais organizes the Fête de l'Attelage in Maninghem\nBookings at the Haut-Pays Côte d'Opale Tourist Office"
        ],
        "it": [
          "Il Syndicat d'élevage du Haut boulonnais organizza la Fête de l'Attelage a Maninghem\nPrenotazioni presso l'Ufficio del Turismo dell'Haut-Pays Côte d'Opale"
        ],
        "fr": [
          "Le Syndicat d'élevage du Haut boulonnais organise la Fête de l'Attelage à Maninghem\nRéservation auprès de l'Office de Tourisme Haut-Pays Côte d'Opale"
        ],
        "nl": [
          "Het Syndicat d'élevage du Haut boulonnais organiseert het Fête de l'Attelage in Maninghem\nReserveringen bij de Dienst voor Toerisme van de Haut-Pays Côte d'Opale"
        ],
        "es": [
