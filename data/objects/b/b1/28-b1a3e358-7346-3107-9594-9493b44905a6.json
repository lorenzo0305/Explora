  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9a9152c-2085-314b-a0a2-294247d18dc3",
      "dc:description": {
        "de": [
          "Ein kleiner Coin d'Espagne auf dem Place St Nicolas in Valenciennes! Teste deine Musikkultur ab 20 Uhr, Stimmung garantiert! Tapas, Cocktails & gute Laune sind angesagt!"
        ],
        "en": [
          "A little Corner of Spain in Valenciennes' Place St Nicolas! Come and test your musical culture from 8pm, atmosphere guaranteed! Tapas, cocktails and a good time guaranteed!"
        ],
        "it": [
          "Un piccolo angolo di Spagna in Place St Nicolas a Valenciennes! Venite a mettere alla prova la vostra cultura musicale a partire dalle 20.00, atmosfera garantita! Tapas, cocktail e divertimento assicurato!"
        ],
        "fr": [
          "Un petit Coin d'Espagne sur la place St Nicolas de Valenciennes ! Viens tester ta culture musicale dès 20h, ambiance garantie ! Tapas, cocktails & bonne humeur au rendez-vous !"
        ],
        "es": [
          "¡Un pequeño rincón de España en la plaza San Nicolás de Valenciennes! Venga a poner a prueba su cultura musical a partir de las 20:00 horas, ¡ambiente garantizado! Tapas, cócteles y diversión garantizada"
        ],
        "nl": [
          "Een klein stukje Spanje op de Place St Nicolas in Valenciennes! Kom en test je muzikale cultuur vanaf 20u, sfeer gegarandeerd! Tapas, cocktails en gezelligheid gegarandeerd!"
        ]
      },
