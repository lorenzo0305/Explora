  "rdfs:comment": {
    "de": [
      "Wer kann Les Coquettes aufhalten? Nachdem sie mit ihrer ersten Show fast 500.000 Zuschauer begeistert haben, kehren sie mit \"Merci Francis\" zurück!"
    ],
    "en": [
      "Who can stop Les Coquettes? After winning over nearly 500,000 spectators with their first show, they are back with \"Merci Francis\"!"
    ],
    "it": [
      "Chi può fermare Les Coquettes? Dopo aver conquistato quasi 500.000 spettatori con il loro primo spettacolo, tornano con \"Merci Francis\"!"
    ],
    "fr": [
      "Qui peut arrêter Les Coquettes ? Après avoir conquis près de 500 000 spectateurs avec leur premier spectacle, elles reviennent avec « Merci Francis » !"
