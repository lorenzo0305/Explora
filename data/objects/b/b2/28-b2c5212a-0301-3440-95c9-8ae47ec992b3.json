  "rdfs:comment": {
    "de": [
      "Der Picknickplatz von Catheux liegt in der Nähe des Coulée Verte und eignet sich gut für ein Mittagessen während Ihrer Wanderung. Er ist mit einem Tisch und einem Mülleimer ausgestattet."
    ],
    "en": [
      "Located near the Coulée Verte, the picnic area of Catheux is perfect for a lunch during your hike. It is equipped with a table and a garbage can."
    ],
    "it": [
      "Situata vicino alla Coulée Verte, l'area picnic di Catheux è ideale per pranzare durante la passeggiata. È dotata di un tavolo e di un cestino per i rifiuti."
    ],
    "fr": [
      "Située à proximité de la Coulée Verte, l'aire de pique-nique de Catheux est propice pour un déjeuner lors de votre randonnée. Elle est aménagée d'une table et d'une poubelle."
    ],
    "es": [
      "Situado cerca de la Coulée Verte, el merendero de Catheux es ideal para comer durante el paseo. Está equipada con una mesa y una papelera."
    ],
    "nl": [
      "De picknickplaats van Catheux, vlakbij de Coulée Verte, is ideaal voor de lunch tijdens uw wandeling. Het is uitgerust met een tafel en een vuilnisbak."
    ]
  },
  "rdfs:label": {
