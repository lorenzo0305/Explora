  "rdfs:comment": {
    "de": [
      "Auf dem Grand Place von Arras, in einer traditionellen und gemütlichen Umgebung, entdecken Sie die köstlichen Speisen und Getränke der savoyischen Länder! Geselligkeit und Gaumenfreuden kommen hier täglich zusammen, um Ihnen angenehme Momente zu garantieren."
    ],
    "en": [
      "On Arras' Grand Place, in a warm, traditional setting, come and discover the delicious dishes and beverages of Savoyard lands! Conviviality and gourmandise come together daily to guarantee you a pleasant time."
    ],
    "it": [
      "Sulla Grand Place di Arras, in un ambiente caldo e tradizionale, venite a scoprire i piatti e le bevande deliziose della regione savoiarda! La convivialità e le delizie gastronomiche si uniscono ogni giorno per garantirvi un'esperienza indimenticabile."
    ],
    "fr": [
      "Sur la Grand Place d'Arras, dans un décor traditionnel et chaleureux, venez découvrir les délicieux mets et breuvages des contrées savoyardes ! Convivialité et gourmandise se réunissent quotidiennement afin de vous garantir des moments agréables."
    ],
    "nl": [
      "Kom op de Grand Place in Arras, in een warm en traditioneel kader, kennismaken met de heerlijke gerechten en dranken uit de Savoie! Gezelligheid en gastronomie komen elke dag samen om je een geweldige tijd te bezorgen."
    ],
    "es": [
      "En la Grand Place de Arras, en un ambiente cálido y tradicional, venga a descubrir los deliciosos platos y bebidas de la región de Saboya Convivialidad y delicias gastronómicas se dan la mano cada día para que lo pase en grande."
    ]
  },
  "rdfs:label": {
