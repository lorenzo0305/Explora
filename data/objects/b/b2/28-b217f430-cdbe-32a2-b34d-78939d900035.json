  "rdfs:comment": {
    "de": [
      "Ausdrucke mit Gravur!\n---------------------\n\n**Zeichnen, gravieren, einfärben, abziehen: Treten Sie ein in die Welt der Druckkunst zwischen Kupferstich und Linolschnitt und behalten Sie eine Spur von Ihrem Besuch im Museum.**\n\n? Frühjahrssession: Dienstag, 28/04, 5/05 und 12/05/2026"
    ],
    "en": [
      "Engraved impressions!\n---------------------\n\n**Drawing, engraving, inking, printing: enter the world of printmaking between intaglio and linocut and keep a trace of your visit to the museum\n\n? Spring session: Tuesdays 28/04, 5/05 and 12/05/2026"
    ],
    "it": [
      "Impressioni incise!\n---------------------\n\n**Disegnare, incidere, inchiostrare, stampare: entrate nel mondo dell'arte della stampa tra calcografia e linoleografia e conservate una traccia della vostra visita al museo **\n\n? Sessione primaverile: martedì 28/04, 5/05 e 12/05/2026"
    ],
    "fr": [
      "Impressions gravées !\n---------------------\n\n**Dessiner, graver, encrer, tirer : entrez dans l’univers de l’art de l’estampe entre taille douce et linogravure et gardez une trace de votre passage au musée.**\n\n→ Session de printemps : les mardis 28/04, 5/05 et 12/05/2026"
    ],
    "nl": [
      "Indrukken gegraveerd!\n---------------------\n\n**Tekenen, graveren, inkten, drukken: stap in de wereld van de prentkunst, van diepdruk tot linoleumsnede, en bewaar een spoor van je bezoek aan het museum\n\n? Lentesessie: dinsdag 28/04, 5/05 en 12/05/2026"
    ],
    "es": [
      "Impresiones grabadas\n---------------------\n\n**Dibujo, grabado, entintado, estampación: adéntrese en el mundo del grabado, de la calcografía al linograbado, y guarde una huella de su visita al museo\n\n? Sesión de primavera: martes 28/04, 5/05 y 12/05/2026"
    ]
  },
