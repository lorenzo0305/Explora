  "rdfs:comment": {
    "de": [
      "Panik im Louvre-Lens!  Überall auf der Welt werden Besucher von Museen und Stätten des Weltkulturerbes auf mysteriöse Weise versteinert.\nDie Schlangenhäute, die an den Orten gefunden wurden, weisen auf die Schuldige hin: die abscheuliche Medusa!"
    ],
    "en": [
      "Panic at Louvre-Lens!  All over the world, visitors to museums and World Heritage sites are mysteriously petrified.\nSnake skins found at the scene point to the culprit: the abominable Medusa!"
    ],
    "it": [
      "Panico al Louvre-Lens!  In tutto il mondo, i visitatori di musei e siti del patrimonio mondiale vengono misteriosamente pietrificati.\nLe pelli di serpente trovate sulla scena indicano il colpevole: l'abominevole Medusa!"
    ],
    "fr": [
      "Panique au Louvre-Lens !  Un peu partout aux 4 coins du globe, des visiteurs de musées et de sites du Patrimoine mondial sont mystérieusement pétrifiés.\nLes peaux de serpents retrouvées sur les lieux désignent la coupable : l'abominable Méduse !"
    ],
    "nl": [
      "Paniek bij Louvre-Lens!  Over de hele wereld worden bezoekers van musea en werelderfgoed op mysterieuze wijze versteend.\nDe gevonden slangenhuiden wijzen naar de boosdoener: de afschuwelijke Medusa!"
    ],
    "es": [
      "Pánico en el Louvre-Lens  En todo el mundo, los visitantes de museos y sitios del Patrimonio Mundial están siendo misteriosamente petrificados.\nLas pieles de serpiente encontradas en el lugar apuntan al culpable: ¡la abominable Medusa!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "JEU D’ÉNIGME : CHEFS-D’ŒUVRE EN PÉRIL ? LA VENGEANCE DE MÉDUSE"
    ]
  },
