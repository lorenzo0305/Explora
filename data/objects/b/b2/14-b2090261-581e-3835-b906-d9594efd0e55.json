  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7f33ced7-f929-34eb-bf43-a3905206dd93",
      "dc:description": {
        "de": [
          "Lassen Sie sich unter den funkelnden Sternen von der Magie des Freiluftkinos mitreißen. Mit einem Drink in der Hand und einem bequemen Sitzplatz machen Sie sich bereit für einen unvergesslichen Abend."
        ],
        "en": [
          "Under the twinkling stars, let yourself be carried away by the magic of open-air cinema. With a drink in hand and a comfortable seat, get ready for an unforgettable evening."
        ],
        "it": [
          "Sotto le stelle scintillanti, lasciatevi trasportare dalla magia del cinema all'aperto. Con un drink in mano e una comoda poltrona, preparatevi a una serata indimenticabile."
        ],
        "fr": [
          "Sous les étoiles scintillantes, laissez-vous emporter par la magie du cinéma en plein air. Un verre à la main, confortablement installé, préparez-vous à vivre une soirée inoubliable."
        ],
        "nl": [
          "Laat je onder de fonkelende sterrenhemel meeslepen door de magie van openluchtbioscopen. Met een drankje in de hand en een comfortabele stoel maak je je klaar voor een onvergetelijke avond."
        ],
        "es": [
          "Bajo las estrellas parpadeantes, déjese llevar por la magia del cine al aire libre. Con una copa en la mano y un asiento cómodo, prepárese para una velada inolvidable."
        ]
      },
      "@type": [
        "Description"
