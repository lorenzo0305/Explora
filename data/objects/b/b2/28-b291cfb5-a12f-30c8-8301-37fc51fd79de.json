      "dc:description": {
        "de": [
          "Tennisplätze\nDer Club verfügt über vier Plätze, davon zwei Hallenplätze, die rund um die Uhr zugänglich sind."
        ],
        "en": [
          "Tennis courts\nThe club has four courts, two of which are covered and accessible 24 hours a day."
        ],
        "it": [
          "Campi da tennis\nIl club dispone di quattro campi da gioco, due dei quali sono coperti e accessibili 24 ore al giorno."
        ],
        "fr": [
          "Cours de tennis\nLe club dispose de quatre courts dont deux couverts, accessibles 24h/24."
        ],
        "nl": [
          "Tennisbanen\nDe club beschikt over vier banen, waarvan er twee overdekt zijn en 24 uur per dag toegankelijk."
        ],
        "es": [
          "Pistas de tenis\nEl club cuenta con cuatro pistas, dos de ellas cubiertas y accesibles las 24 horas del día."
        ]
