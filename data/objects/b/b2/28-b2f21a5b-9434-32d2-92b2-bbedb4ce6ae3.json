  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c0fb9235-ca70-3de4-a1fe-e988706467b5",
      "dc:description": {
        "de": [
          "Der Stall Cheval Passion liegt im Park eines Schlosses zwischen Wäldern und Sümpfen und empfängt Sie das ganze Jahr über für begleitete Ausritte zu Pferd oder auf einem Pony.\n\nFür erfahrene Reiter: Vorbereitung auf Springprüfungen unter dem wohlwollenden Auge eines Trainers."
        ],
        "en": [
          "Located in the grounds of a chateau between woods and marshes, Écurie Cheval Passion welcomes you all year round for accompanied horse or pony rides.\n\nExperienced riders can prepare for jumping competitions under the watchful eye of a coach."
        ],
        "it": [
          "Situata nel parco di un castello tra boschi e paludi, Écurie Cheval Passion vi accoglie tutto l'anno per passeggiate accompagnate a cavallo o su pony.\n\nI cavalieri più esperti possono prepararsi alle gare di salto sotto l'occhio vigile di un allenatore."
        ],
        "fr": [
          "Située dans le parc d'un château entre bois et marais, l'Écurie Cheval Passion vous accueille toute l'année pour des balades accompagnées à cheval ou à poney.\n\nPour les cavaliers confirmés, préparation aux épreuves du jumping sous l'oeil bienveillant d'un coach."
        ],
        "nl": [
          "Écurie Cheval Passion, gelegen op het terrein van een kasteel tussen bossen en moerassen, verwelkomt je het hele jaar door voor begeleide tochten te paard of op een pony.\n\nErvaren ruiters kunnen zich onder het toeziend oog van een coach voorbereiden op springwedstrijden."
        ],
        "es": [
          "Situada en los terrenos de un castillo entre bosques y pantanos, Écurie Cheval Passion le acoge todo el año para paseos acompañados a caballo o en poni.\n\nLos jinetes experimentados pueden prepararse para las competiciones de salto bajo la atenta mirada de un entrenador."
        ]
      },
      "@type": [
        "Description"
      ],
