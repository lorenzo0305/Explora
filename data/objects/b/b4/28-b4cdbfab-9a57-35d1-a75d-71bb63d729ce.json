  "rdfs:comment": {
    "de": [
      "Nur wenige Schritte von der berühmten Kathedrale entfernt hat sich das Restaurant Chez Rosa niedergelassen. Genießen Sie hier köstliche hausgemachte Pizzen, entweder vor Ort oder zum Mitnehmen!"
    ],
    "en": [
      "A few steps away from the famous cathedral, the restaurant Chez Rosa has been set up. Come and taste delicious homemade pizzas, on the spot or to take away!"
    ],
    "it": [
      "Chez Rosa si trova a pochi isolati dalla famosa cattedrale. Venite a gustare deliziose pizze fatte in casa, sul posto o da asporto!"
    ],
    "fr": [
      "C'est à quelques encamblures de la célèbre cathédrale que s'est installé le restaurant Chez Rosa. Venez y déguster de délicieuses pizzas maison, sur place ou à emporter !"
    ],
    "es": [
      "Chez Rosa se encuentra a pocas manzanas de la famosa catedral. Ven a disfrutar de deliciosas pizzas caseras, en el momento o para llevar"
    ],
    "nl": [
      "Chez Rosa ligt een paar blokken van de beroemde kathedraal. Kom genieten van heerlijke huisgemaakte pizza's, ter plaatse of om mee te nemen!"
    ]
  },
