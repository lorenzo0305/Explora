  "rdfs:comment": {
    "de": [
      "Südlich von Maubeuge bietet dieser Tisch am Rande der Nationalstraße 2 ein schönes Erlebnis großer Tradition in einem bürgerlichen Rahmen, der dem Geschmack der Zeit angepasst wurde. Man kommt hierher, um die Klassiker des französischen Registers wiederzuentdecken."
    ],
    "en": [
      "Just south of Maubeuge, this restaurant on the banks of the N2 offers a fine traditional experience, in a bourgeois setting brought up to date. We come here to rediscover the classics of French cuisine."
    ],
    "it": [
      "A sud di Maubeuge, questo ristorante ai margini della RN2 offre una raffinata esperienza tradizionale, in un ambiente borghese aggiornato. Si viene qui per riscoprire i classici della cucina francese."
    ],
    "fr": [
      "Au sud de Maubeuge, cette table au bord de la nationale 2 propose une belle expérience de grande tradition, dans un cadre bourgeois remis au goût du jour. On y vient pour redécouvrir les classiques du registre français."
    ],
    "nl": [
      "Ten zuiden van Maubeuge biedt dit restaurant aan de rand van de RN2 een fijne traditionele ervaring, in een burgerlijk kader dat up-to-date is gebracht. Je komt hier om de klassiekers van de Franse keuken te herontdekken."
    ],
    "es": [
      "Al sur de Maubeuge, este restaurante al borde de la RN2 ofrece una experiencia tradicional en un ambiente burgués actualizado. Aquí se redescubren los clásicos de la cocina francesa."
    ]
  },
  "rdfs:label": {
