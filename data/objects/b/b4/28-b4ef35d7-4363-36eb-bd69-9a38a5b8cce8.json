  "rdfs:comment": {
    "de": [
      "Das in einem ehemaligen Schrankenwärterhaus in Wambrechies untergebrachte La Cantine überrascht Sie mit seiner Dekoration und Küche in einem traditionellen und gemütlichen Stil."
    ],
    "en": [
      "Installed in a former gatehouse in Wambrechies, the decoration and the kitchen of La Cantine will surprise you with their traditional and warm style."
    ],
    "it": [
      "Situata in un'antica portineria di Wambrechies, la decorazione e la cucina de La Cantine vi sorprenderanno per il loro stile tradizionale e caloroso."
    ],
    "fr": [
      "Installé dans une ancienne maison de garde barrière à Wambrechies, la décoration et la cuisine de La Cantine vous surprendront par leur style traditionnel et chaleureux."
    ],
    "es": [
      "Situado en una antigua portería de Wambrechies, la decoración y la cocina de La Cantine le sorprenderán por su estilo tradicional y cálido."
    ],
    "nl": [
      "De inrichting en keuken van La Cantine, gevestigd in een voormalig poortgebouw in Wambrechies, zullen u verrassen door hun traditionele en warme stijl."
    ]
  },
