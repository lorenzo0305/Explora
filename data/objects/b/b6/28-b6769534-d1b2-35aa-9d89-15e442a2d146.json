  "rdfs:comment": {
    "de": [
      "Das Hotel-Restaurant Campanile Lille Sud ? Seclin empfängt Sie während Ihres Familienurlaubs oder Ihrer Geschäftsreise 10 km vom Stadtzentrum von Lille, 2 km vom SNCF-Bahnhof Seclin und 4 km vom Flughafen entfernt. Das Hotel verfügt über ein Restaurant mit Terrasse, eine Lounge und einen Barbereich sowie einen Seminarraum."
    ],
    "en": [
      "The Campanile Lille Sud ? Seclin welcomes you for your family or business trip, 10 km from downtown Lille, 2 km from the Seclin SNCF train station and 4 km from the airport. The hotel features a restaurant with terrace, a lounge and bar area, and a seminar room."
    ],
    "it": [
      "L'hotel-ristorante Campanile Lille Sud ? Seclin vi accoglie per le vostre vacanze in famiglia o per un viaggio d'affari, a 10 km dal centro di Lille, a 2 km dalla stazione ferroviaria SNCF di Seclin e a 4 km dall'aeroporto. L'hotel dispone di un ristorante con terrazza, di un'area lounge e bar e di una sala per seminari."
    ],
    "fr": [
      "L'hôtel-restaurant Campanile Lille Sud – Seclin vous accueille lors de votre séjour familial ou voyage d'affaires à 10 km du centre-ville de Lille, à 2 km de la gare SNCF de Seclin et à 4 km de l’aéroport. Hôtel dispose d'un restaurant avec terrasse,  d'un salon et espace bar et d'une salle de séminaire."
    ],
    "nl": [
      "Hotel-restaurant Campanile Lille Sud ? Seclin verwelkomt u voor uw familievakantie of zakenreis, op 10 km van het centrum van Lille, 2 km van het SNCF-station Seclin en 4 km van de luchthaven. Het hotel beschikt over een restaurant met terras, een lounge en bar en een seminarruimte."
    ],
    "es": [
      "El hotel-restaurante Campanile Lille Sud ? Seclin le da la bienvenida para sus vacaciones en familia o sus viajes de negocios, a 10 km del centro de Lille, a 2 km de la estación de tren SNCF de Seclin y a 4 km del aeropuerto. El hotel dispone de un restaurante con terraza, un salón, un bar y una sala de seminarios."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Campanile Lille Sud Seclin"
    ]
  },
  "COVID19SpecialMeasures": {
    "de": [
      "3*-Hotel mit 49 Zimmern.\nDieses Hotel ist um Ihre Zufriedenheit bemüht und garantiert Ihnen einen hochwertigen Komfort, indem es Ihnen ein funktionelles Zimmer anbietet.\nDas Restaurant bietet Ihnen verschiedene Formeln rund um saisonale Produkte und regionale Rezepte"
    ],
    "en": [
      "3* hotel with 49 rooms.\nCommitted to your satisfaction, this hotel guarantees quality comfort and functional rooms.\nThe restaurant offers a range of formulas based on seasonal produce and regional recipes"
    ],
    "it": [
      "Hotel a 3 stelle con 49 camere.\nPensando alla vostra soddisfazione, questo hotel vi garantisce un comfort di qualità offrendovi una camera funzionale.\nIl ristorante propone varie formule a base di prodotti di stagione e ricette regionali"
    ],
    "fr": [
      "Hôtel 3* de 49 chambres.\nSoucieux de votre satisfaction, cet hôtel vous garantit un confort de qualité en vous proposant une chambre fonctionnelle.\nLe Restaurant vous propose différentes formules autour de produits de saison et de recettes régionales"
    ],
    "es": [
      "Hotel de 3 estrellas con 49 habitaciones.\nPensando en su satisfacción, este hotel le garantiza un confort de calidad ofreciéndole una habitación funcional.\nEl restaurante ofrece una gama de fórmulas basadas en productos de temporada y recetas regionales"
    ],
    "nl": [
      "Driesterrenhotel met 49 kamers.\nMet uw tevredenheid in het achterhoofd garandeert dit hotel u kwaliteitscomfort door u een functionele kamer aan te bieden.\nHet restaurant biedt een scala aan formules op basis van seizoensproducten en regionale recepten"
    ]
  },
