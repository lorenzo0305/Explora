  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e2246566-cceb-32c7-a308-52baaa8b603a",
      "dc:description": {
        "de": [
          "Fabrice empfängt Sie herzlich in seinem charmanten Restaurant im Herzen des Circuit du Souvenir. Probieren Sie eine traditionelle und raffinierte Küche und verbringen Sie einen köstlichen Moment."
        ],
        "en": [
          "Fabrice welcomes you in all friendliness in his charming restaurant in the heart of the circuit of the memory. Come and taste a traditional and refined cuisine and spend a delicious moment."
        ],
        "it": [
          "Fabrice vi accoglie in un'atmosfera amichevole nel suo affascinante ristorante nel cuore del circuito del souvenir. Venite a gustare una cucina tradizionale e raffinata e a trascorrere un momento delizioso."
        ],
        "fr": [
          "Fabrice vous accueille en toute convivialité dans son charmant restaurant en plein cœur du circuit du souvenir. Venez goûter une cuisine traditionnelle et raffinée et passer un moment délicieux."
        ],
        "nl": [
          "Fabrice ontvangt u in een gezellige sfeer in zijn charmante restaurant in het hart van het souvenircircuit. Kom proeven van een traditionele en verfijnde keuken en breng een heerlijk moment door."
        ],
        "es": [
          "Fabrice le da la bienvenida en un ambiente agradable en su encantador restaurante en el corazón del circuito del recuerdo. Venga a degustar una cocina tradicional y refinada y pase un momento delicioso."
        ]
      },
