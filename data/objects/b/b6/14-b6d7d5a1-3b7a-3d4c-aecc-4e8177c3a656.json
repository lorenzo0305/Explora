  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cb382820-b730-37d2-b8c7-fd978a67b57f",
      "dc:description": {
        "de": [
          "Aufführung & Austausch \"Mein kleines Nest fürs Leben\"\nDas Ensemble \"La belle histoire\" präsentiert \"Mon p'tit nid pour la vie\"\nSchauspiel und Austausch über die Einrichtung der Wohnung, um gut zu Hause alt zu werden\nFreier Eintritt"
        ],
        "en": [
          "Show & Exchange \" Mon p?tit nid pour la vie \" (My little nest for life)\nLa belle histoire\" company presents \"Mon p'tit nid pour la vie\" (My little nest for life)\nShow and discussion on home improvements for ageing well at home\nFree admission"
        ],
        "it": [
          "Spettacolo e dibattito \"Mon p?tit nid pour la vie\nLa compagnia \"La belle histoire\" presenta \"Mon p'tit nid pour la vie\" (Il mio piccolo nido per la vita)\nSpettacolo e dibattito sui miglioramenti domestici per invecchiare bene a casa propria\nIngresso libero"
        ],
        "fr": [
          "Spectacle & Échanges « Mon p’tit nid pour la vie »\nLa compagnie \"La belle histoire\" présente \"Mon p'tit nid pour la vie\"\nSpectacle et échanges sur l’aménagement du logement pour bien vieillir chez soi\nEntrée libre"
        ],
        "nl": [
          "Mon p'tit nid pour la vie\" voorstelling en discussie\nHet gezelschap \"La belle histoire\" presenteert \"Mon p'tit nid pour la vie\" (Mijn kleine nestje voor het leven)\nShow en discussie over verbeteringen voor thuis ouder worden\nGratis toegang"
        ],
        "es": [
          "Espectáculo y debate \"Mon p?tit nid pour la vie\nLa compañía \"La belle histoire\" presenta \"Mon p'tit nid pour la vie\" (Mi pequeño nido para la vida)\nEspectáculo y debate sobre las mejoras para envejecer bien en casa\nEntrada gratuita"
        ]
      },
      "@type": [
        "Description"
      ],
