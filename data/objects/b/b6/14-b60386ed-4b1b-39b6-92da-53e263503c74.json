      "@id": "https://data.datatourisme.fr/b5a0abb8-aa86-3ab1-aa58-be912024b6ea",
      "dc:description": {
        "de": [
          "Während aller Schulferien. Ab 15 Uhr. Espace Wallard - rue Wallard. 4€ pro Person. Theater mit animierten Objekten rund um die Themen Umweltfreundlichkeit und Natur\nRens.: 06 86 98 68 16"
        ],
        "en": [
          "Every school holiday. Starting at 3:00 p.m. Espace Wallard - rue Wallard. 4€ per person. Theatre of animated objects around the themes of respect for the environment and nature\nContact : 06 86 98 68 16"
        ],
        "it": [
          "Tutte le vacanze scolastiche. Dalle 15:00. Espace Wallard - rue Wallard. 4? a persona. Teatro d'oggetti animato sui temi del rispetto dell'ambiente e della natura\nContatto: 06 86 98 68 16"
        ],
        "fr": [
          "Toutes les vacances scolaires. Dès 15h. Espace Wallard - rue Wallard. 4€ par personne. Théâtre d'objets animés autour des thèmes du respect de l'environnement et de la nature\nRens. : 06 86 98 68 16"
        ],
        "es": [
          "Todas las vacaciones escolares. A partir de las 15 horas. Espace Wallard - rue Wallard. 4 euros por persona. Teatro de objetos animados sobre el tema del respeto al medio ambiente y la naturaleza\nContacto: 06 86 98 68 16"
        ],
        "nl": [
          "Alle schoolvakanties. Vanaf 15.00 uur. Espace Wallard - rue Wallard. 4? per persoon. Geanimeerd objecttheater over de thema's respect voor milieu en natuur\nContact: 06 86 98 68 16"
        ]
      },
