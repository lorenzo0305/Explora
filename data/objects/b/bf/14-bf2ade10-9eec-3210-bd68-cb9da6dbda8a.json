  "rdfs:comment": {
    "de": [
      "In Lens findet das 5. Video Mapping Festival in der Region Hauts de France statt, im Rahmen des 10. Jahrestags der Aufnahme des Bergbaubeckens in das Weltkulturerbe und als Abschluss des Art-Deco-Frühlings."
    ],
    "en": [
      "Lens hosts the 5th edition of the Video Mapping Festival in the Hauts de France, as part of the 10th anniversary of the inclusion of the mining basin in the World Heritage List, at the close of the Printemps de l'Art Déco."
    ],
    "it": [
      "Lens ospita la quinta edizione del Video Mapping Festival nella regione Hauts de France, nell'ambito del decimo anniversario dell'inserimento del Bassin Minier nel Patrimonio dell'Umanità e in occasione della conclusione del festival Printemps de l'Art Déco."
    ],
    "fr": [
      "Lens accueille la 5ème édition du Video Mapping Festival dans les Hauts de France, dans le cadre du 10ème anniversaire de l’inscription du Bassin minier au Patrimoine mondial, en clôture du Printemps de l’Art déco."
    ],
    "nl": [
      "Lens organiseert de 5e editie van het Video Mapping Festival in de Hauts de France regio, als onderdeel van de 10e verjaardag van de opname van het Bassin Minier op de Werelderfgoedlijst en ter gelegenheid van het einde van het Printemps de l?Art Déco festival."
    ],
    "es": [
      "Lens acoge la 5ª edición del Festival de Video Mapping en la región de Hauts de France, en el marco del 10º aniversario de la inscripción del Bassin Minier como Patrimonio Mundial de la Humanidad y con motivo del final del festival Printemps de l'Art Déco."
    ]
  },
