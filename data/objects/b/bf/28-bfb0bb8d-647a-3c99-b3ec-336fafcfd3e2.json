  "rdfs:comment": {
    "de": [
      "Ihre brandneue Adresse in der Unterstadt, in der Nähe des Bahnhofs von Laon: Im Kigo kommen die Jahreszeiten auf Ihren Teller, und alles ist hausgemacht!"
    ],
    "en": [
      "Your brand new address in the lower town, near the Laon train station: at Kigo, it's as if the seasons were inviting you to your plate, all home-made!"
    ],
    "it": [
      "Il vostro nuovo indirizzo nella città bassa, vicino alla stazione di Laon: da Kigo è come se le stagioni vi invitassero al vostro piatto, tutto fatto in casa!"
    ],
    "fr": [
      "Votre toute nouvelle adresse en ville basse, à proximité de la gare de Laon : au Kigo, c'est un peu comme si les saisons s'invitaient dans votre assiette, le tout fait maison !"
    ],
    "nl": [
      "Uw gloednieuwe adres in de benedenstad, vlakbij het station van Laon: bij Kigo is het alsof de seizoenen u uitnodigen op uw bord, helemaal zelfgemaakt!"
    ],
    "es": [
      "Su nueva dirección en la parte baja de la ciudad, cerca de la estación de Laon: en Kigo, es como si las estaciones le invitaran a su plato, ¡todo casero!"
    ]
  },
