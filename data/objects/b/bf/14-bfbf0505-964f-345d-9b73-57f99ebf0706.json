      "dc:description": {
        "de": [
          "Entdecken Sie die Schicksale von Félix, Elie und Elisa auf einer Wanderung, die an den Überresten der Compagnie des Mines de Lens vorbeiführt."
        ],
        "en": [
          "Come and discover the destinies of Félix, Elie and Elisa during a hike marked out by the remains of the Compagnie des Mines de Lens."
        ],
        "it": [
          "Venite a scoprire i destini di Félix, Elie ed Elisa durante una passeggiata tracciata dai resti della Compagnie des Mines de Lens."
        ],
        "fr": [
          "Venez découvrir les destins de Félix, d'Elie et d'Elisa lors d'une randonnée jalonnée des vestiges de la Compagnie des Mines de Lens."
        ],
        "es": [
          "Venga a descubrir los destinos de Félix, Elie y Elisa durante un paseo marcado por los restos de la Compagnie des Mines de Lens."
        ],
        "nl": [
          "Ontdek het lot van Félix, Elie en Elisa tijdens een wandeling langs de overblijfselen van de Compagnie des Mines de Lens."
