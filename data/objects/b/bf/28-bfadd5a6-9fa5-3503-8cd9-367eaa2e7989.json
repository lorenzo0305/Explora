  "rdfs:comment": {
    "de": [
      "Gegenüber der Markthalle von Abbeville gelegen, empfängt Sie unser Lokal von Dienstag bis Samstag, um drinnen oder auf der Terrasse einen Moment der Entspannung bei einem Glas, einem Kaffee oder einer Mahlzeit zu genießen."
    ],
    "en": [
      "Located opposite Abbeville's covered market, our establishment welcomes you from Tuesday to Saturday to enjoy a relaxing moment indoors or on the terrace with a drink, coffee or meal."
    ],
    "it": [
      "Situato di fronte al mercato coperto di Abbeville, il nostro locale vi accoglie dal martedì al sabato per un drink, un caffè o un pasto rilassante, all'interno o sulla terrazza."
    ],
    "fr": [
      "Situé face au marché couvert d'Abbeville, notre établissement vous accueille du mardi au samedi pour profiter d'un moment de détente à l'intérieur ou en terrasse autour d'un verre, d'un café ou pour vous restaurer."
    ],
    "es": [
      "Situado frente al mercado cubierto de Abbeville, nuestro establecimiento le acoge de martes a sábado para tomar una copa, un café o comer tranquilamente, en el interior o en la terraza."
    ],
    "nl": [
      "Ons etablissement ligt tegenover de overdekte markt van Abbeville en verwelkomt je van dinsdag tot zaterdag voor een ontspannen drankje, koffie of maaltijd, binnen of op het terras."
    ]
  },
  "rdfs:label": {
