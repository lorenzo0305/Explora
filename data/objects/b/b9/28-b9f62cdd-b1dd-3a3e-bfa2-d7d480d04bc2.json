      "dc:description": {
        "de": [
          "Reservieren Sie vor dem 20. September 2025 Ihren Platz, um am 04. Oktober im Bouly-Saal in Tergnier einen Transformisten-Kabarettabend zu besuchen. Es werden Ihnen zwei Menüs für Erwachsene und Kinder angeboten, die zwischen 15 und 45 Euro liegen"
        ],
        "en": [
          "Reserve your place before September 20, 2025 to attend a transformist cabaret evening on October 04 at the Salle Bouly in Tergnier. Two menus are available, for adults and children, ranging from 15 to 45 euros"
        ],
        "it": [
          "Prenotate il vostro posto entro il 20 settembre 2025 per la serata di cabaret trasformista del 4 ottobre alla Salle Bouly di Tergnier. Sono disponibili due menu, per adulti e bambini, da 15 a 45 euro"
        ],
        "fr": [
          "Réservez votre place avant le 20 septembre 2025 pour venir assister à une soirée cabaret transformiste le 04 octobre dans la salle Bouly à Tergnier. Deux menus vous sont proposés, adultes et enfants, allant de 15 à 45 euros"
        ],
        "nl": [
          "Reserveer vóór 20 september 2025 je plaats voor een transformistische cabaretavond op 04 oktober in de Salle Bouly in Tergnier. Er zijn twee menu's beschikbaar, voor volwassenen en kinderen, variërend van 15 tot 45 euro"
        ],
        "es": [
          "Reserve su plaza antes del 20 de septiembre de 2025 para una velada de cabaret transformista el 04 de octubre en la Salle Bouly de Tergnier. Hay dos menús disponibles, para adultos y niños, de 15 a 45 euros"
        ]
      },
