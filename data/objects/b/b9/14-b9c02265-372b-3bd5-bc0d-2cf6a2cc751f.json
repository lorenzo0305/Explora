  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/91c2093c-0bd3-3b08-a44c-ab31f60f2994",
      "dc:description": {
        "de": [
          "Entdecken Sie mit der Eröffnung von Volfoni das Dolce Vita im Boulonnais: Von Antipasti über Pizza und Pasta bis hin zu Desserts - Italien kommt zu Ihnen!"
        ],
        "en": [
          "Come and discover the Dolce Vita in the Boulonnais region with the opening of Volfoni: from antipasti to desserts, pizza and pasta, Italy comes to you!"
        ],
        "it": [
          "Venite a scoprire la Dolce Vita nel quartiere Boulonnais con l'apertura di Volfoni: dagli antipasti ai dolci, dalla pizza alla pasta, l'Italia viene da voi!"
        ],
        "fr": [
          "Venez découvrir la Dolce Vita dans le Boulonnais avec l'ouverture de Volfoni : des antipasti aux desserts en passant par les pizza et pasta, l'Italie vient à vous !"
        ],
        "es": [
          "Venga a descubrir la Dolce Vita en el Boulonnais con la apertura de Volfoni: desde antipasti a postres, pasando por pizza y pasta, ¡Italia se acerca a usted!"
        ],
        "nl": [
          "Kom het Dolce Vita ontdekken in de Boulonnais met de opening van Volfoni: van antipasti tot desserts, pizza en pasta, Italië komt naar je toe!"
        ]
      },
