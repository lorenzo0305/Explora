  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8bf82c4d-7377-38b1-a2ba-b7c491fa89c7",
      "dc:description": {
        "de": [
          "Dieser Sportkomplex bietet verschiedene Ballspiele, Rennbahnen und einen Bouleplatz\nIn der Nähe des Tennisplatzes, der Bogenschießanlage, des Schwimmbads und des Ponyclubs"
        ],
        "en": [
          "This sports complex offers a variety of ball games, running tracks and a pétanque court\nLocated near tennis, archery, swimming pool and pony club"
        ],
        "it": [
          "Questo complesso sportivo offre una varietà di giochi con la palla, piste da corsa e un campo da bocce\nSi trova vicino ai campi da tennis, al tiro con l'arco, alla piscina e al pony club"
        ],
        "fr": [
          "Ce complexe sportif permet divers jeux de ballons, pistes de courses, terrain de pétanque…\nSitué prés du tennis, du tir a l'arc, de la piscine et du poney club"
        ],
        "es": [
          "Este complejo deportivo ofrece diversos juegos de pelota, pistas de atletismo y un campo de petanca\nCerca de pistas de tenis, tiro con arco, piscina y pony club"
        ],
        "nl": [
          "Dit sportcomplex biedt verschillende balspellen, atletiekbanen en een jeu de boulesbaan\nDichtbij de tennisbanen, boogschietbaan, zwembad en ponyclub"
        ]
      },
