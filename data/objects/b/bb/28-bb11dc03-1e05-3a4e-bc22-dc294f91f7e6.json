  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/983f5be1-a5ab-38a2-bdab-23dc9e30c018",
      "dc:description": {
        "de": [
          "My Dwich!\nDas sind Hamburger! Sandwiches!\nHühnchen!Rindfleisch!\nPommes frites!Käse!\nSoße! Soft!\nAber es ist auch ein Lächeln :)\nUnd das alles mit frischen Produkten!"
        ],
        "en": [
          "My Dwich!\nIt's Hamburgers! Sandwiches!\nChicken! Beef!\nFrench fries! Cheese!\nSauce! Soft!\nBut it's also a Smile :)\nAll With Fresh Products!"
        ],
        "it": [
          "Il mio Dwich!\nSono hamburger! Panini!\nPollo! Manzo!\nPatatine fritte! Formaggio!\nSalsa! Bevande analcoliche!\nMa è anche un sorriso :)\nIl tutto con prodotti freschi!"
        ],
        "fr": [
          "My Dwich!\nC'est des Hamburgers! Sandwichs!\nDu Poulet!Du Bœuf!\nDes Frites!Du Fromages!\nDe la Sauce! Des Soft!\nMais c'est aussi un Sourire :)\nLe tout Avec des Produits Frais !"
        ],
        "es": [
          "¡Mi Dwich!\n¡Son hamburguesas! ¡Sandwiches!\n¡Pollo! ¡Carne!\n¡Patatas fritas! ¡Queso!\n¡Salsa! ¡Refrescos!\nPero también es una sonrisa :)\n¡Todo con productos frescos!"
        ],
        "nl": [
          "Mijn Dwich!\nHet zijn hamburgers! Broodjes!\nKip! Rundvlees!\nFrietjes! Kaas!\nSaus! Frisdrank!\nMaar het is ook een glimlach :)\nAllemaal met verse producten!"
        ]
      },
