  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ecb1363-2eb4-3fb1-8590-9a05f5a5f99d",
      "dc:description": {
        "de": [
          "Entdecken Sie die Aromen des Fernen Ostens und lassen Sie sich auf eine einzigartige und originelle kulinarische Reise entführen. Sie werden von den exotischen und leckeren Tellern überrascht sein."
        ],
        "en": [
          "Discover the flavours of the Far East and let yourself be carried away on a unique and original culinary journey. You will be surprised by the exotic and gourmet plates."
        ],
        "it": [
          "Scoprite i sapori dell'Estremo Oriente e lasciatevi trasportare in un viaggio culinario unico e originale. Sarete sorpresi dai piatti esotici e gourmet."
        ],
        "fr": [
          "Découvrez les saveurs de l'extrême-orient et laissez vous emporter dans un voyage culinaire unique et original. Vous allez être surpris par les assiettes exotiques et gourmandes."
        ],
        "nl": [
          "Ontdek de smaken van het Verre Oosten en laat u meevoeren op een unieke en originele culinaire reis. U zult verrast zijn door de exotische en gastronomische gerechten."
        ],
        "es": [
          "Descubra los sabores del Lejano Oriente y déjese llevar por un viaje culinario único y original. Le sorprenderán los platos exóticos y gourmet."
        ]
      },
