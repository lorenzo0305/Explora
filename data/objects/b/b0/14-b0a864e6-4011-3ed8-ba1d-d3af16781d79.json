  "rdfs:comment": {
    "de": [
      "Das Centre Denis Papin ist heute einer der erhaltenen Schätze der ehemaligen Fosse n°2 in Oignies. Diese zum UNESCO-Weltkulturerbe gehörende Stätte bietet auf 43.000 m2 Entdeckungsmöglichkeiten für Groß und Klein."
    ],
    "en": [
      "The Denis Papin Center is one of the preserved treasures of the former Fosse n°2 in Oignies. This Unesco World Heritage site offers 43,000 m2 of discoveries for young and old alike."
    ],
    "it": [
      "Il Centro Denis Papin è uno dei tesori conservati dell'ex Fosse n°2 di Oignies. Questo sito, patrimonio mondiale dell'UNESCO, offre 43.000 m2 di scoperte per grandi e piccini."
    ],
    "fr": [
      "Le Centre Denis Papin est aujourd'hui l'un des trésors préservés de l'ancienne Fosse n°2 de Oignies. Ce site inscrit au Patrimoine mondial de l'Unesco offre 43 000 m2 de découvertes pour petits et grands."
    ],
    "nl": [
      "Het Centre Denis Papin is een van de bewaard gebleven schatten van de voormalige Fosse n°2 in Oignies. Dit UNESCO Werelderfgoed biedt 43.000 m2 aan ontdekkingen voor jong en oud."
    ],
    "es": [
      "El Centro Denis Papin es uno de los tesoros conservados de la antigua Fosse n°2 de Oignies. Este lugar declarado Patrimonio Mundial por la UNESCO ofrece 43.000 m2 de descubrimientos para grandes y pequeños."
    ]
  },
