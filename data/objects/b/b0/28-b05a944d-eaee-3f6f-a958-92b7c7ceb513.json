  "rdfs:comment": {
    "de": [
      "Dieses Estaminet im \"Brocante\"-Dekor bietet Ihnen typisch flämische Gerichte: Potjevleesch, Carbonnade, Welsh, gefüllte Geflügelbrust mit altem Brügge oder Burger mit Maroilles."
    ],
    "en": [
      "This estaminet with its \"brocante\" décor offers typical Flemish dishes: potjevleesch, carbonnade, welsh, poultry breast stuffed with old Bruges or burger with maroilles."
    ],
    "it": [
      "Questo estaminet \"brocante\" offre piatti tipici fiamminghi: potjevleesch, carbonnade, welsh, petto di pollame ripieno di vecchia Bruges o hamburger con maroilles."
    ],
    "fr": [
      "Cet estaminet au décor \"brocante\" vous propose des plats typiquement flamand : potjevleesch, carbonnade, welsh, blanc de volaille farci au vieux Bruges ou burger au maroilles."
    ],
    "es": [
      "Este estaminet \"brocante\" ofrece platos típicos flamencos: potjevleesch, carbonnade, galesa, pechuga de ave rellena al viejo Brujas o hamburguesa con maroilles."
    ],
    "nl": [
      "Dit \"brocante\" estaminet biedt typisch Vlaamse gerechten: potjevleesch, carbonnade, welsh, gevogelteborst gevuld met oud Brugge of hamburger met maroilles."
    ]
  },
