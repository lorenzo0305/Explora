  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7aa9e5e5-ae05-3144-994a-d6733605e1c4",
      "dc:description": {
        "de": [
          "Dédales d'opale - Fannys Labyrinth feiert seinen 10. Geburtstag: große Maislabyrinthe in Wissant, Spiele und Rätsel für Kinder, Jugendliche und Erwachsene zwischen Natur und Abenteuer.\nCorn maze labyrinth / Maislabyrinth / Reuzenmaïslabyrint"
        ],
        "en": [
          "Dédales d'opale - le laby de Fanny celebrates its 10th anniversary: large corn mazes in Wissant, games and puzzles for children, teenagers and adults between nature and adventure.\nCorn maze labyrinth / Maislabyrinth / Reuzenmaïslabyrint"
        ],
        "it": [
          "Dédales d'opale - le laby de Fanny festeggia il suo 10° anniversario: grandi labirinti di mais a Wissant, giochi ed enigmi per bambini, ragazzi e adulti, che uniscono natura e avventura.\nLabirinto di mais / Maislabyrinth / Reuzenmaïslabyrint"
        ],
        "fr": [
          "Dédales d'opale - le laby de Fanny fête ses 10 ans : grands labyrinthes de maïs à Wissant, jeux et énigmes pour enfants, ados et adultes entre nature et aventure. \nCorn maze labyrinth / Maislabyrinth / Reuzenmaïslabyrint"
        ],
        "nl": [
          "Dédales d'opale - le laby de Fanny viert haar 10-jarig bestaan: grote maïsdoolhoven in Wissant, spellen en puzzels voor kinderen, tieners en volwassenen, een combinatie van natuur en avontuur.\nMaïsdoolhof / Maislabyrinth / Reuzenmaïslabyrint"
        ],
        "es": [
          "Dédales d'opale - le laby de Fanny celebra su 10º aniversario: grandes laberintos de maíz en Wissant, juegos y rompecabezas para niños, adolescentes y adultos, que combinan naturaleza y aventura.\nLaberinto de maíz / Maislabyrinth / Reuzenmaïslabyrint"
        ]
      },
      "@type": [
        "Description"
      ],
