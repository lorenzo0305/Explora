  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f3c5b506-9d11-3339-9262-e9bb87aa43fa",
      "dc:description": {
        "de": [
          "Freiwillige Bibliothekarinnen und Bibliothekare empfangen Sie mittwochs von 14 bis 16 Uhr und samstags von 14 bis 16 Uhr.\n\nDie Ausleihe beträgt 3 Bücher, 2 CDs oder DVDs pro Person für eine Dauer von 3 Wochen, die verlängert werden kann."
        ],
        "en": [
          "Volunteer librarians welcome you on Wednesdays from 2 to 4 pm and Saturdays from 2 to 4 pm.\n\nYou can borrow 3 books, 2 CDs or DVDs per person for 3 weeks, renewable if necessary."
        ],
        "it": [
          "I bibliotecari volontari vi accoglieranno il mercoledì dalle 14.00 alle 16.00 e il sabato dalle 14.00 alle 16.00.\n\nÈ possibile prendere in prestito 3 libri, 2 CD o DVD a persona per un periodo di 3 settimane, eventualmente rinnovabili."
        ],
        "fr": [
          "Des bibliothécaires bénévoles vous accueillent le mercredi de 14 à 16 heure et le samedi de 14 à 16 heure.\n\nLe prêt est de 3 livres, 2 CD ou DVD  par personne pour une durée de 3 semaines éventuellement renouvelable."
        ],
        "nl": [
          "Vrijwillige bibliothecarissen verwelkomen je op woensdag van 14.00 tot 16.00 uur en op zaterdag van 14.00 tot 16.00 uur.\n\nJe kunt 3 boeken, 2 cd's of dvd's per persoon lenen voor een periode van 3 weken, eventueel te verlengen."
        ],
        "es": [
          "Los bibliotecarios voluntarios le reciben los miércoles de 14.00 a 16.00 horas y los sábados de 14.00 a 16.00 horas.\n\nPuede tomar prestados 3 libros, 2 CD o DVD por persona durante un periodo de 3 semanas, renovable en caso necesario."
        ]
      },
      "@type": [
        "Description"
