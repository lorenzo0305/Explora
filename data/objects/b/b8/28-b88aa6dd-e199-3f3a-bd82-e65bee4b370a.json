  "rdfs:comment": {
    "de": [
      "Im Herzen der Stadt Rosendael zwischen dem Krankenhaus von Dünkirchen und dem Place des martyrs de la résistance gelegen, bietet Ihnen Le Gaston einen Moment der Geselligkeit und des Austauschs."
    ],
    "en": [
      "Located in the heart of the city of Rosendael between the hospital of Dunkerque and the place of the martyrs of the resistance, Le Gaston proposes you a moment of conviviality and sharing."
    ],
    "it": [
      "Situato nel cuore della città di Rosendael, tra l'ospedale di Dunkerque e il luogo dei martiri della resistenza, Le Gaston vi offre un momento di convivialità e condivisione."
    ],
    "fr": [
      "Situé au cœur de la ville de Rosendael entre l’hôpital de Dunkerque et la place des martyrs de la résistance, Le Gaston vous propose un moment de convivialité et de partage."
    ],
    "es": [
      "Situado en el corazón de la ciudad de Rosendael, entre el hospital de Dunkerque y el lugar de los mártires de la resistencia, Le Gaston le ofrece un momento de convivencia y de compartir."
    ],
    "nl": [
      "Gelegen in het hart van de stad Rosendael tussen het ziekenhuis van Duinkerken en de plaats van de martelaren van het verzet, biedt Le Gaston u een moment van gezelligheid en delen."
    ]
  },
