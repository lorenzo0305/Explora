  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6410727f-2f48-3eae-be07-4d4747a7b968",
      "dc:description": {
        "de": [
          "Traditionelle Käserei\nBauernkäse aus Rohmilch oder Käse aus traditioneller handwerklicher Herstellung\nFreude zu teilen...\n\nGeöffnet montags bis samstags von 8:30 bis 13:00 Uhr und von 15:30 bis 19:00 Uhr.\nSonntags von 8:30 bis 13:00 Uhr."
        ],
        "en": [
          "Traditional Cheese Factory\nFarmhouse cheeses made from raw milk or traditional cheeses\nA pleasure to share...\n\nOpen from Monday to Saturday from 8:30 am to 1:00 pm and from 3:30 pm to 7:00 pm.\nSunday from 8:30 am to 1:00 pm."
        ],
        "it": [
          "Caseificio tradizionale\nFormaggi di fattoria a latte crudo o formaggi tradizionali\nUn piacere da condividere...\n\nAperto dal lunedì al sabato dalle 8.30 alle 13.00 e dalle 15.30 alle 19.00.\nDomenica dalle 8.30 alle 13.00."
        ],
        "fr": [
          "Fromagerie Traditionnelle\nFromages Fermiers au lait cru ou fromages de tradition artisanale\nDu plaisir à partager...\n\nOuvert du lundi au samedi de 8h30 à 13h00 et de 15h30 à 19h.\nLe dimanche de 8h30 à 13h00."
        ],
        "nl": [
          "Traditionele kaasmakerij\nBoerenkazen van rauwe melk of traditionele kazen\nEen genoegen om te delen...\n\nGeopend van maandag tot zaterdag van 8.30 tot 13.00 uur en van 15.30 tot 19.00 uur.\nZondag van 8.30 tot 13.00 uur."
        ],
        "es": [
          "Quesería tradicional\nQuesos de granja elaborados con leche cruda o quesos tradicionales\nUn placer compartir...\n\nAbierto de lunes a sábado de 8.30 a 13.00 y de 15.30 a 19.00.\nDomingo de 8:30 a 13:00 horas."
        ]
      },
