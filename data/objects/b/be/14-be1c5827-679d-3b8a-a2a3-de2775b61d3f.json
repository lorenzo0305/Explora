  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f569ef1c-aa5d-38c4-ab3d-b8f3c4c11ca2",
      "dc:description": {
        "de": [
          "Das Konzept der Bar à Manger ist ein Lokal, in dem man mittags nonstop bis 16:30 Uhr isst und ab 18 Uhr in den Barmodus wechselt, mit Wurst-/Käseplatten, Austernteller und Wurstplatten."
        ],
        "en": [
          "The Bar à Manger concept is an establishment where you eat lunch non-stop until 4:30pm, then switch to bar mode at 6pm with charcuterie/cheese boards, oyster platters and sausage boards."
        ],
        "it": [
          "Il concetto di Bar à Manger è un locale in cui si pranza ininterrottamente fino alle 16.30 per poi passare alla modalità bar dalle 18.00 con taglieri di salumi/formaggi, piatti di ostriche e taglieri di salsicce."
        ],
        "fr": [
          "Le concept du Bar à Manger est un établissement où l’on mange le midi en service non stop jusque 16h30 et on passe en mode bar à partir de 18h avec Planches de charcuteries/fromage, assiette d’huîtres et planches de saucissons."
        ],
        "nl": [
          "Het Bar à Manger-concept is een etablissement waar je non-stop luncht tot 16.30 uur en dan vanaf 18.00 uur overschakelt op barmodus met vleeswaren/kaasplankjes, oesterplateaus en worstplankjes."
        ],
        "es": [
          "El concepto Bar à Manger es un establecimiento en el que se almuerza sin parar hasta las 16.30 y luego se pasa al modo bar a partir de las 18.00 con tablas de embutidos/quesos, bandejas de ostras y tablas de salchichas."
        ]
      },
      "@type": [
        "Description"
      ],
