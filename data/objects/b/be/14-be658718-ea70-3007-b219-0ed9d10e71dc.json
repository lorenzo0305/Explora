  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/52c960b6-c7ba-3f06-b95e-be6e1bbc95a9",
      "dc:description": {
        "de": [
          "Geöffnet montags bis freitags von 8 bis 12 Uhr und von 13:30 bis 17 Uhr , samstags am 11. und 25. von 8:30 bis 12 Uhr.\nVorführung am Mittwoch, dem 12. April, von 14.00 bis 17.00 Uhr im großen Salon."
        ],
        "en": [
          "Open Monday to Friday, 8am to 12pm and 1:30pm to 5pm, Saturdays 11th and 25th, 8:30am to 12pm.\nDemonstration on Wednesday April 12 from 2 to 5 p.m. in the grand salon."
        ],
        "it": [
          "Aperto dal lunedì al venerdì dalle 8.00 alle 12.00 e dalle 13.30 alle 17.00, sabato 11 e 25 dalle 8.30 alle 12.00.\nDimostrazione mercoledì 12 aprile dalle 14.00 alle 17.00 nel grande salone."
        ],
        "fr": [
          "Ouvert du lundi au vendredi de 8h à 12h et de 13h30 à 17h , les samedis 11 et 25 de 8h30 à 12 h.\nDémonstration le mercredi 12 avril de 14 h à 17 h  dans le grand salon."
        ],
        "nl": [
          "Open van maandag t/m vrijdag van 8.00 tot 12.00 uur en van 13.30 tot 17.00 uur, op zaterdag 11 en 25 van 8.30 tot 12.00 uur.\nDemonstratie op woensdag 12 april van 14.00 tot 17.00 uur in de grote salon."
        ],
        "es": [
          "Abierto de lunes a viernes, de 8.00 a 12.00 y de 13.30 a 17.00, y los sábados 11 y 25, de 8.30 a 12.00.\nDemostración el miércoles 12 de abril de 14.00 a 17.00 h en el gran salón."
        ]
      },
