  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0b95e497-d56b-3b85-aa2a-44742c9a6032",
      "dc:description": {
        "de": [
          "Repas-Spectacle zum Thema Kino, organisiert von Les Dancing Stars.\nMehrzweckhalle Claude Bailly.\nMit der Sängerin Lycia.\nTeilnahme von DNL Animation.\n\nShow allein : 2 ? (Erwachsene) | Kostenlos (-12 Jahre)\n\nReservierung vor dem 27.10.2025 erforderlich.\n\nEin Tag im Zeichen der Musik, des Tanzes und der Geselligkeit."
        ],
        "en": [
          "Cinema-themed dinner and show organized by Les Dancing Stars.\nSalle polyvalente Claude Bailly.\nWith singer Lycia.\nDNL Animation takes part.\n\nShow only: 2 ? (adults) | Free (under 12s)\n\nReservations required by 10/27/2025.\n\nA day of music, dance and conviviality."
        ],
        "it": [
          "Cena e spettacolo a tema cinematografico organizzato da Les Dancing Stars.\nSala polivalente Claude Bailly.\nCon la cantante Lycia.\nCon la partecipazione di DNL Animazione.\n\nSolo spettacolo: 2 ? (adulti) | Gratuito (minori di 12 anni)\n\nPrenotazione obbligatoria entro il 27/10/2025.\n\nUna giornata di musica, danza e divertimento."
        ],
        "fr": [
          "Repas-Spectacle sur le thème du Cinéma organisé par Les Dancing Stars.\nSalle polyvalente Claude Bailly.\nAvec la chanteuse Lycia.\nParticipation de DNL Animation.\n\nSpectacle seul : 2 € (adultes) | Gratuit (-12 ans)\n\nRéservation obligatoire avant le 27/10/2025.\n\nUne journée placée sous le signe de la musique, de la danse et de la convivialité."
        ],
        "es": [
          "Cena-espectáculo de temática cinematográfica organizada por Les Dancing Stars.\nSala polivalente Claude Bailly.\nCon la cantante Lycia.\nCon la participación de DNL Animation.\n\nSólo espectáculo: 2 ? (adultos) | Gratis (menores de 12 años)\n\nReserva obligatoria antes del 27/10/2025.\n\nUn día de música, baile y diversión."
        ],
        "nl": [
          "Bioscoopdiner en -show georganiseerd door Les Dancing Stars.\nSalle polyvalente Claude Bailly.\nMet de zangeres Lycia.\nMet medewerking van DNL Animation.\n\nAlleen voorstelling: 2 ? (volwassenen) | Gratis (onder 12 jaar)\n\nReserveren verplicht vóór 27/10/2025.\n\nEen dag vol muziek, dans en plezier."
        ]
      },
