  "rdfs:comment": {
    "de": [
      "Treffen und Signierstunde mit Bérénice Pichat, der der Prix littéraire des Villes S?urs 2025 verliehen wird, und Vorstellung der Ausgabe 2026.\nIn Anwesenheit der Buchhandlung L'Encre Marine. In Partnerschaft mit dem Réseau des Bibliothèques."
    ],
    "en": [
      "Meeting and signing session with Bérénice Pichat, who will receive the Prix littéraire des Villes S?urs 2025, and launch of the 2026 edition.\nIn the presence of the Encre Marine bookshop. In partnership with the Réseau des Bibliothèques."
    ],
    "it": [
      "Incontro e sessione di firme con Bérénice Pichat, che riceverà il Premio letterario Villes S?urs 2025, e lancio dell'edizione 2026.\nIn presenza della libreria Encre Marine. In collaborazione con il Réseau des Bibliothèques."
    ],
    "fr": [
      "Rencontre et dédicace avec Bérénice Pichat, qui recevra le Prix littéraire des Villes Sœurs 2025, et lancement de l’édition 2026. \nEn présence de la librairie l’Encre Marine. En partenariat avec le Réseau des Bibliothèques."
    ],
    "nl": [
      "Ontmoeting en signeersessie met Bérénice Pichat, die de literatuurprijs Villes S?urs 2025 in ontvangst zal nemen, en lancering van de editie 2026.\nIn aanwezigheid van boekhandel Encre Marine. In samenwerking met het Réseau des Bibliothèques."
    ],
    "es": [
      "Encuentro y sesión de firmas con Bérénice Pichat, que recibirá el Premio Literario Villes Sœurs 2025, y lanzamiento de la edición 2026.\nEn presencia de la librería Encre Marine. En colaboración con la Red de Bibliotecas."
    ]
  },
