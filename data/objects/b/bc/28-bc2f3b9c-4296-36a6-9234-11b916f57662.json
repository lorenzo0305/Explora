  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f7b21c52-544f-36bf-8032-ceccf0349370",
      "dc:description": {
        "de": [
          "Kapazität: 120 Personen ( 1 Raum )\nArt der Besucher: 30 Jahre\nArt der Musik: Blues, Rock\nPub im Herzen der Metropole, das sowohl ein Restaurant als auch einen Barbereich bietet, um einen geselligen und gemütlichen Moment zu verbringen.\nGeöffnet montags bis donnerstags von 12:00 bis 14:30 Uhr und von 18:00 bis 0:00 Uhr, freitags und samstags von 17:00 bis 1:00 Uhr\nSonntags geschlossen"
        ],
        "en": [
          "Capacity: 120 people ( 1 room )\nClientele : 30 years old\nType of music: blues, rock\nPub in the heart of the metropolis, offering both a restaurant and a bar area for a warm, friendly atmosphere.\nOpen Monday to Thursday, 12pm to 2:30pm and 6pm to 12am, Friday and Saturday, 5pm to 1am\nClosed on Sunday"
        ],
        "it": [
          "Capacità : 120 persone ( 1 sala )\nClientela : 30 anni\nTipo di musica : blues, rock\nPub nel cuore della città che offre sia un ristorante che una zona bar per un'atmosfera calda e amichevole.\nAperto dal lunedì al giovedì dalle 12.00 alle 14.30 e dalle 18.00 alle 24.00, il venerdì e il sabato dalle 17.00 all'una di notte\nChiuso la domenica"
        ],
        "fr": [
          "Capacité : 120 personnes ( 1 salle )\nType de clientèle : 30 ans\nType de musique :  blues, rock\nPub en plein cœur de la métropole offrant à la fois une restauration et un espace bar pour passer un moment convivial et chaleureux.\nOuvert du lundi au jeudi de 12h à 14h30 et de 18h à 0h, vendredi et samedi de 17h à 1h\nFermé le dimanche"
        ],
        "nl": [
          "Capaciteit : 120 personen ( 1 zaal )\nKlantenkring : 30 jaar oud\nSoort muziek : blues, rock\nPub in het hart van de stad met zowel een restaurant als een bargedeelte voor een warme en gezellige sfeer.\nOpen van maandag tot donderdag van 12u tot 14u30 en van 18u tot 12u, vrijdag en zaterdag van 17u tot 01u\nGesloten op zondag"
        ],
        "es": [
          "Capacidad : 120 personas ( 1 sala )\nClientela : 30 años\nTipo de música : blues, rock\nPub en el corazón de la ciudad que ofrece a la vez un restaurante y una zona de bar para un ambiente cálido y acogedor.\nAbierto de lunes a jueves de 12h a 14h30 y de 18h a 24h, viernes y sábado de 17h a 1h\nDomingos cerrado"
        ]
      },
      "@type": [
        "Description"
      ],
