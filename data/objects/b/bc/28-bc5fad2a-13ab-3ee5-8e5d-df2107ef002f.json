  "rdfs:comment": {
    "de": [
      "Entdecken Sie eine saisonale Küche mit Produkten aus der Somme-Bucht: Fisch aus dem lokalen Fischfang, Pflanzen aus der Bucht und Spezialitäten aus der Region."
    ],
    "en": [
      "Discover seasonal cuisine based on products from the Bay of the Somme: locally caught fish, plants from the bay and local specialties."
    ],
    "it": [
      "Scoprite la cucina stagionale a base di prodotti della Baia della Somme: pesce pescato localmente, piante della baia e specialità locali."
    ],
    "fr": [
      "Découvrez une cuisine de saison à base de produits de la baie de Somme : poissons de la pêche locale, végétaux de la baie et spécialités du terroir."
    ],
    "nl": [
      "Ontdek de seizoensgebonden keuken op basis van producten uit de Baai van de Somme: lokaal gevangen vis, planten uit de baai en lokale specialiteiten."
    ],
    "es": [
      "Descubra una cocina de temporada basada en los productos de la bahía de Somme: pescado de captura local, plantas de la bahía y especialidades locales."
    ]
  },
