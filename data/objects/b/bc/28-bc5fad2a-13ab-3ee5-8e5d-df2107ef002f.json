  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d5b747e2-36d2-3915-ac88-de424540bf91",
      "dc:description": {
        "de": [
          "Diese Adresse befindet sich im Zentrum von Le Crotoy und wird Ihren Gaumen erfreuen. Chefkoch Philippe bietet Ihnen Rezepte mit fein zubereiteten lokalen Produkten an: Jakobsmuscheln, Pflanzen aus der Bucht, Lamm von der Salzwiese in der Saison?\nAuf Reservierung."
        ],
        "en": [
          "Located right in the center of Le Crotoy, this address will delight your taste buds. Chef Philippe proposes recipes based on finely-cooked local produce: scallops, bay vegetables, salt-meadow lamb in season?\nReservations required."
        ],
        "it": [
          "Situato proprio nel centro di Le Crotoy, questo ristorante delizierà il vostro palato. Lo chef Philippe propone ricette a base di prodotti locali finemente cucinati: capesante, piante della baia, agnello salato di stagione, ecc\nPrenotazione obbligatoria."
        ],
        "fr": [
          "Située en plein centre du Crotoy, cette adresse ravira vos papilles. Le chef Philippe vous propose des recettes à base de produits locaux finement cuisinés : coquille saint Jacques, végétaux de la baie, agneau de pré salé en saison…\nSur réservation."
        ],
        "es": [
          "Situado en pleno centro de Le Crotoy, este restaurante hará las delicias de su paladar. El Chef Philippe le propone recetas a base de productos locales finamente cocinados: vieiras, plantas de la bahía, cordero de los prados salados en temporada, etc\nReserva obligatoria."
        ],
        "nl": [
          "Dit restaurant ligt in het centrum van Le Crotoy en zal je smaakpapillen verrukken. Chef Philippe biedt u recepten op basis van fijne streekproducten: sint-jakobsschelpen, planten uit de baai, lamsvlees van de zoute weide in het seizoen, enz\nReserveren verplicht."
        ]
      },
      "@type": [
        "Description"
      ],
