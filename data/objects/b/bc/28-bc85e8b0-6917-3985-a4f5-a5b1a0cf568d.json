  "rdfs:comment": {
    "de": [
      "Eine Küche ohne Etikette, die das Glück auf den Teller bringt, und das alles in einem Rahmen, der Dschungel, Holz, Metall, ein in die Bar eingebautes Klavier, eine offene Küche, eine versteckte Terrasse und ein helles Mezzanin miteinander vereint."
    ],
    "en": [
      "An unpretentious cuisine that puts happiness on the plate, all in a setting combining jungle, wood, metal, piano embedded in the bar, open kitchen, hidden terrace and luminous mezzanine."
    ],
    "it": [
      "Una cucina senza etichette che mette la felicità nel piatto, il tutto in un ambiente che combina giungla, legno, metallo, un pianoforte incastonato nel bar, una cucina aperta, una terrazza nascosta e un luminoso mezzanino."
    ],
    "fr": [
      "Une cuisine sans étiquette qui met du bonheur dans l'assiette, le tout dans un cadre mêlant jungle, bois, métal, piano incrusté dans le bar, cuisine ouverte, terrasse cachée, mezzanine lumineuse."
    ],
    "es": [
      "Una cocina sin etiquetas que pone la felicidad en el plato, todo ello en un marco que combina selva, madera, metal, un piano incrustado en la barra, una cocina abierta, una terraza escondida y un luminoso entresuelo."
    ],
    "nl": [
      "Een keuken zonder etiketten die geluk op het bord legt, en dat alles in een decor dat jungle, hout, metaal, een piano in de bar, een open keuken, een verborgen terras en een lichte mezzanine combineert."
    ]
  },
