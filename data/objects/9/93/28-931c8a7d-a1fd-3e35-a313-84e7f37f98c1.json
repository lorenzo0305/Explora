      "dc:description": {
        "de": [
          "Die Mediathek in Fort-Mahon-Plage bietet Ihnen eine große Auswahl an Büchern und Zeitschriften, eine Spielothek, einen Multimedia-Bereich sowie kostenloses WLAN"
        ],
        "en": [
          "The Fort-Mahon-Plage multimedia library offers a wide selection of books and magazines, a games library, a multimedia area and free wifi access"
        ],
        "it": [
          "La biblioteca multimediale di Fort-Mahon-Plage offre un'ampia selezione di libri e riviste, una ludoteca, un'area multimediale e la connessione Wi-Fi gratuita"
        ],
        "fr": [
          "La médiathèque de Fort-Mahon-Plage vous propose un large choix de livres et de magazines, un espace ludothèque,  un espace multimédia ainsi qu'une connexion wifi gratuite"
        ],
        "es": [
          "La biblioteca multimedia de Fort-Mahon-Plage ofrece una amplia selección de libros y revistas, una ludoteca, un espacio multimedia y conexión Wi-Fi gratuita"
