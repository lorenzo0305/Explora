      "@id": "https://data.datatourisme.fr/889200f9-ec73-3974-a5fc-cb2535fded25",
      "dc:description": {
        "de": [
          "es werden 5 Wanderungen angeboten:\n14 Uhr: La Saint Roch - Cani-Wanderung von 8 km\n14:15 Uhr: La Maurice - 14 km\n14:30 Uhr: Nordic Walking 8 km\n14:35 Uhr: La Marguerite (8 km)\n15:00 Uhr: Rando Patrimoine (Wanderung zum Kulturerbe) von 4 km"
        ],
        "en": [
          "5 hikes are proposed:\n2pm: La Saint Roch - 8km cani rando\n2:15pm: La Maurice - 14km\n2:30 pm: Nordic Walking, 8km\n2:35pm: La Marguerite, 8km\n3pm: Rando Patrimoine 4km"
        ],
        "it": [
          "sono previste 5 passeggiate:\nore 14.00: La Saint Roch - 8 km di cani rando\n14.15: La Maurice - 14 km\n14.30: Nordic Walking, 8 km\n14.35: La Marguerite, 8 km\n15.00: Passeggiata nel patrimonio, 4 km"
        ],
        "fr": [
          "5 randonnées sont proposées :\n14h : La Saint Roch - cani rando de 8km\n14h15 : La Maurice de 14km\n14h30 : Marche Nordique de 8km\n14h35 : La Marguerite de 8km\n15h : Rando Patrimoine de 4km"
        ],
        "es": [
          "se proponen 5 paseos:\n14h: La Saint Roch - 8km cani rando\n14h15: La Maurice - 14km\n14h30: Nordic Walking, 8km\n14h35: La Marguerite, 8km\n15:00: Paseo por el patrimonio, 4 km"
        ],
        "nl": [
          "er worden 5 wandelingen aangeboden:\n14.00 uur: La Saint Roch - 8 km cani rando\n14.15u: La Maurice - 14km\n14.30: Nordic Walking, 8km\n14.35u: La Marguerite, 8km\n15.00 uur: Erfgoedwandeling, 4km"
        ]
