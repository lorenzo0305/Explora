  "rdfs:comment": {
    "de": [
      "Diese Kirche zwischen Saint-Valery-sur-Somme und Cayeux-sur-Mer ist ein religiöses Gebäude, das der Geburt der Heiligen Jungfrau huldigt. Sie ist Teil der Pfarrei Saint-Pierre de la Baie de Somme."
    ],
    "en": [
      "This church, located between Saint-Valery-sur-Somme and Cayeux-sur-Mer is a religious building that pays homage to the Nativity of the Holy Virgin. It is part of the Saint-Pierre parish of the Baie de Somme."
    ],
    "it": [
      "Questa chiesa, situata tra Saint-Valery-sur-Somme e Cayeux-sur-Mer, è un edificio religioso che rende omaggio alla Natività della Beata Vergine. Fa parte della parrocchia di Saint-Pierre de la Baie de Somme."
    ],
    "fr": [
      "Cette église, située entre Saint-Valery-sur-Somme et Cayeux-sur-Mer est un édifice religieux qui rend hommage à la Nativité de la Sainte-Vierge. Elle fait partie de la paroisse Saint-Pierre de la Baie de Somme."
    ],
    "es": [
      "Esta iglesia, situada entre Saint-Valery-sur-Somme y Cayeux-sur-Mer, es un edificio religioso que rinde homenaje a la Natividad de la Santísima Virgen. Forma parte de la parroquia de Saint-Pierre de la Baie de Somme."
    ],
    "nl": [
      "Deze kerk, gelegen tussen Saint-Valery-sur-Somme en Cayeux-sur-Mer, is een religieus gebouw dat hulde brengt aan de Geboorte van de Heilige Maagd. Het maakt deel uit van de parochie Saint-Pierre de la Baie de Somme."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Eglise de la Nativité de la Sainte Vierge"
    ]
  },
