      "dc:description": {
        "de": [
          "Workshop Einrahmung\nLernen Sie, Ihre Fotos und Drucke aufzuwerten, indem Sie sie mit klassischen oder zeitgenössischen Passepartouts verzieren."
        ],
        "en": [
          "Management Workshop\nCome and learn how to enhance your photos, engravings, by decorating them with classic or contemporary mats."
        ],
        "it": [
          "Laboratorio di cornici\nVenite a scoprire come valorizzare le vostre foto e stampe decorandole con tappetini classici o contemporanei."
        ],
        "fr": [
          "Atelier Encadrement\nVenez apprendre à valoriser vos photos, gravures, en les agrémentant de passe-partout classiques ou contemporains."
        ],
        "nl": [
          "Workshop inlijsten\nKom leren hoe u uw foto's en afdrukken kunt verfraaien door ze te versieren met klassieke of eigentijdse matten."
        ],
        "es": [
          "Taller de encuadernación\nVenga y aprenda a mejorar sus fotos e impresiones decorándolas con felpudos clásicos o contemporáneos."
        ]
