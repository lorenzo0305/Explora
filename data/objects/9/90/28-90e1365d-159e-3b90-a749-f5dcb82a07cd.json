  "rdfs:comment": {
    "de": [
      "Unser Restaurant im Stadtzentrum von Dünkirchen ist bewusst einfach und schlicht gehalten, um den Schwerpunkt auf unsere Küche in einer gemütlichen Atmosphäre zu legen. Sie werden sich hier wie zu Hause fühlen."
    ],
    "en": [
      "Restaurant located in downtown Dunkerque, our establishment is deliberately simple and uncluttered to emphasize our cuisine in a warm atmosphere. You will feel at home here."
    ],
    "it": [
      "Il nostro ristorante, situato nel centro di Dunkerque, è volutamente semplice e ordinato per dare risalto alla nostra cucina in un'atmosfera accogliente. Qui vi sentirete come a casa."
    ],
    "fr": [
      "Restaurant situé au centre-ville de Dunkerque, notre établissement se veut volontairement simple et épuré afin de mettre l'accent sur notre cuisine dans une ambiance chaleureuse. Vous vous y sentirez comme chez vous."
    ],
    "nl": [
      "Ons restaurant ligt in het centrum van Duinkerken en is bewust eenvoudig en overzichtelijk ingericht om onze keuken in een warme sfeer te benadrukken. U zult zich hier thuis voelen."
    ],
    "es": [
      "Nuestro restaurante, situado en el centro de Dunkerque, es deliberadamente sencillo y despejado para realzar nuestra cocina en un ambiente cálido. Aquí se sentirá como en casa."
    ]
  },
