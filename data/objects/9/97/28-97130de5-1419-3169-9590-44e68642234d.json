  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/04f2e78a-0513-3c7f-b6c2-a562e6d688c3",
      "dc:description": {
        "de": [
          "Klassifizierter Park des Schlosses Boury (Historisches Monument).\nEhrenhof \"à la française\" mit Topiari und Buchsbaumstickereien. Obstgarten aus dem 18. Jh. Kühlhaus aus dem 17."
        ],
        "en": [
          "Listed park of the Château de Boury (Historical Monument).\nCourtyard of honor \"à la française\" with topiaries and boxwood embroidery. Orchard XVIIIth century. Cooler of the XVIIth century."
        ],
        "it": [
          "Parco del Castello di Boury (monumento storico).\nCortile principale in stile francese con topiari e ricami di bosso. Frutteto del XVIII secolo. Ghiacciaia del XVII secolo."
        ],
        "fr": [
          "Parc classé du Château de Boury (Monument Historique).\nCour d’honneur « à la française » avec topiaires et broderies de buis. Verger XVIIIe siècle. Glacière du XVIIe siècle."
        ],
        "es": [
          "Parque catalogado del castillo de Boury (Monumento Histórico).\nPatio principal de estilo francés con topiarios y borduras de boj. Huerto del siglo XVIII. Casa de hielo del siglo XVII."
        ],
        "nl": [
          "Monumentaal park van het Château de Boury.\nBinnenplaats in Franse stijl met topiaries en borduurwerk van buxus. Boomgaard uit de 18e eeuw. Ijshuis uit de 17e eeuw."
        ]
      },
