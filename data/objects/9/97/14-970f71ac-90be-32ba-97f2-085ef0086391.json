  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/58bf422c-c46d-3b2b-8eba-84d356f1080c",
      "dc:description": {
        "de": [
          "Accary Salaisons ist ein 1956 gegründetes maritimes Pökelhaus in Boulogne-sur-Mer, das die Tradition des Pökelns und Räucherns von Fisch über Holz in Boulogne fortsetzt, um schmackhaften Lachs, Hering, Bückling, Schellfisch und andere geräucherte Fische anzubieten, die mit einfachen, natürlichen Zutaten und ohne Konservierungsstoffe hergestellt werden."
        ],
        "en": [
          "Accary Salaisons is a Boulogne-sur-Mer-based maritime salting company founded in 1956, perpetuating the Boulogne tradition of salting and smoking fish over wood to offer salmon, herring, kippers, haddock and other tasty smoked fish, made with simple, natural ingredients and no preservatives."
        ],
        "it": [
          "Accary Salaisons è un'azienda di salatura marittima con sede a Boulogne-sur-Mer, fondata nel 1956, che perpetua la tradizione di Boulogne di salare e affumicare il pesce a legna per offrire salmone, aringhe, kippers, eglefino e altri gustosi pesci affumicati, preparati con ingredienti semplici e naturali e senza conservanti."
        ],
        "fr": [
          "Accary Salaisons est une maison de salaisons maritimes à Boulogne-sur-Mer fondée en 1956, perpétuant la tradition boulonnaise de salage et fumage du poisson au bois pour offrir du saumon, harengs, kippers, haddock et autres poissons fumés savoureux, élaborés avec des ingrédients simples, naturels et sans conservateurs."
        ],
        "nl": [
          "Accary Salaisons is een maritiem zoutbedrijf uit Boulogne-sur-Mer, opgericht in 1956, dat de Boulogne-traditie van het zouten en roken van vis op hout voortzet om zalm, haring, haring, schelvis en andere smakelijke gerookte vis aan te bieden, gemaakt met eenvoudige, natuurlijke ingrediënten en zonder conserveringsmiddelen."
        ],
        "es": [
          "Accary Salaisons es una empresa de salazón marítima con sede en Boulogne-sur-Mer, fundada en 1956, que perpetúa la tradición de Boulogne de salar y ahumar el pescado a la leña para ofrecer salmón, arenque, arenque, eglefino y otros sabrosos pescados ahumados, elaborados con ingredientes sencillos y naturales y sin conservantes."
        ]
      },
