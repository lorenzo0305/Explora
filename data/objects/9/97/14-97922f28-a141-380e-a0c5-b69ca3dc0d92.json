  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c83d0103-3dcc-34fc-8f83-51c55b84de96",
      "dc:description": {
        "de": [
          "Treten Sie ein in das Art-déco-Juwel der Côte d'Opale!\nDas L?Atlantic liegt im Herzen des Deiches von Wimereux und empfängt Sie, damit Sie die neue schicke Erfahrung der Strandhotels und Restaurants erleben können, die von Aurélie und Benjamin Delpierre erdacht wurde."
        ],
        "en": [
          "Enter the Art Deco jewel of the Opal Coast!\nLocated at the heart of the Wimereux seawall, L'Atlantic welcomes you to the chic new seaside hotel and restaurant experience imagined by Aurélie and Benjamin Delpierre."
        ],
        "it": [
          "Entrate nel gioiello Art Déco della Costa d'Opale!\nSituato nel cuore del frangiflutti di Wimereux, L'Atlantic vi dà il benvenuto nella nuova esperienza di hotel e ristorante sul mare progettato da Aurélie e Benjamin Delpierre."
        ],
        "fr": [
          "Entrez dans le joyau Art déco de la Côte d’Opale !\nSitué au cœur de la digue de Wimereux, L’Atlantic vous accueille pour vous faire vivre la nouvelle expérience chic d’hôtellerie balnéaire et de restauration imaginée par Aurélie et Benjamin Delpierre."
        ],
        "nl": [
          "Treed binnen in het Art Deco juweel van de Opaalkust!\nL'Atlantic ligt in het hart van de golfbreker van Wimereux en verwelkomt u in het chique nieuwe hotel-restaurantconcept aan zee, ontworpen door Aurélie en Benjamin Delpierre."
        ],
        "es": [
          "Entre en la joya Art Déco de la Costa de Ópalo\nSituado en el corazón del rompeolas de Wimereux, L'Atlantic le da la bienvenida al nuevo y elegante hotel y restaurante costero diseñado por Aurélie y Benjamin Delpierre."
        ]
      },
      "@type": [
        "Description"
      ],
