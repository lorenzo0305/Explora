  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c69db317-4f69-3890-a5bd-671f426f0581",
      "dc:description": {
        "de": [
          "Flussstrecke der 1. Kategorie von 2,5 km.<br> Öffnungs- und Schließungszeiten je nach Erlass der Präfektur<br> Angeln von Bachforellen und Äschen.<br> Eine No-Kill-Fliegenstrecke steht zur Verfügung.<br> Weitere Informationen zur Hausordnung.<br> <br> Jahreskarte Erwachsene: 95? 12-18 Jahre 56?   -12 Jahre: 5 ? <br> Tageskarte 15 ? und 20? (Tag des Fischbesatzes) <br> <br> <br>"
        ],
        "en": [
          "1ere category river course of 2.5 kms.<br>Opening and closing dates according to prefectoral decree<br>Fario trout and grayling fishing.<br>A no-kill fly course is available.<br>More info on the rules.<br> <br>Annual pass adults: 95? 12-18 years 56?   -12 years old: 5? <br>Daily pass 15? and 20? (restocking day)<br> <br>"
        ],
        "it": [
          "Corso fluviale di 1a categoria di 2,5 km.<br>Date di apertura e chiusura secondo decreto prefettizio<br>Pesca alla trota fario e al temolo.<br>E' disponibile un corso di mosca no-kill.<br>Maggiori informazioni sul regolamento.<br> <br>Pass annuale adulti: 95? 12-18 anni 56?   -12 anni: 5? <br>Pass giornaliero 15? e 20? (giorno di ripopolamento)<br> <br>"
        ],
        "fr": [
          "Parcours en rivière de 1ere catégorie de 2.5 kms.<br>Date d'ouverture et fermeture suivant arrêté préfectoral<br>Pêche de la truite fario et de l'ombre commun.<br>Un parcours mouche no-kill est à disposition.<br>Plus d'infos sur le règlement intérieur.<br> <br>Carte annuelle adultes: 95€  12-18 ans  56 €   -12 ans: 5€ <br>Carte journalière 15 € et 20€ (jour de rempoissonnement)<br> <br>"
        ],
        "nl": [
          "Rivierenparcours 1e categorie van 2,5 km.<br>Openings- en sluitingsdata volgens prefectoraal besluit<br>Vissen op forel en vlagzalm.<br>Er is een no-kill vliegcursus beschikbaar.<br>Meer info over de regels.<br> <br>Jaarkaart volwassenen: 95? 12-18 jaar 56?   -12 jaar: 5? <br>Dagpas 15? en 20? (uitzetdag)<br> <br>"
        ],
        "es": [
          "Recorrido fluvial de 1ª categoría de 2,5 kms.<br>Fechas de apertura y cierre según decreto prefectoral<br>Pesca de trucha fario y tímalo.<br>Se ofrece un recorrido a mosca sin muerte.<br>Más información sobre el reglamento.<br> <br>Pase anual adultos: 95? 12-18 años 56?   -12 años: 5? <br>Pase diario 15€ y 20€ (día de repoblación)<br> <br>"
        ]
      },
      "@type": [
        "Description"
      ],
