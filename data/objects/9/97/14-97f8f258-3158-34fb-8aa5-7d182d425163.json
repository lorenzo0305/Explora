  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b15b78c8-b284-346f-9dab-bb61982fb995",
      "dc:description": {
        "de": [
          "Der Bauernhof bietet Papin des fruits-Torten, Brioches, Pizzas und Quiches an. Fleisch auf Bestellung\nVerkauf auf dem Bauernhof freitags von 14 bis 19 Uhr und samstags von 9 bis 19 Uhr"
        ],
        "en": [
          "The farm offers fruit tarts, brioches, pizzas and quiches. Meat to order\nSales at the farm on Fridays from 2pm to 7pm and Saturdays from 9am to 7pm"
        ],
        "it": [
          "L'azienda offre crostate di frutta, brioches, pizze e quiche. Carne su ordinazione\nVendita in fattoria il venerdì dalle 14.00 alle 19.00 e il sabato dalle 9.00 alle 19.00"
        ],
        "fr": [
          "La ferme propose des tartes au papin des fruits, brioches, pizzas et quiches. Viande sur commande\nVente à la ferme le vendredi de 14h à 19h et le samedi de 9h à 19h"
        ],
        "es": [
          "La granja ofrece tartas de frutas, brioches, pizzas y quiches. Carne por encargo\nVenta en la granja los viernes de 14:00 a 19:00 y los sábados de 9:00 a 19:00"
        ],
        "nl": [
          "De boerderij biedt fruittaarten, brioches, pizza's en quiches. Vlees op bestelling\nVerkoop op de boerderij op vrijdag van 14.00 tot 19.00 uur en op zaterdag van 9.00 tot 19.00 uur"
        ]
      },
