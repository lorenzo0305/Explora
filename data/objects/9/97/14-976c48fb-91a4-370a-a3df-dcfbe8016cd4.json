  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/89ff7cf4-2425-3925-b12e-c6ce332936f4",
      "dc:description": {
        "de": [
          "KOMMENTIERTE BESICHTIGUNG DES PARKS UND DES OBSTGARTENS :\nBei diesem Rundgang lernen Sie die im Clos Saint Victor vorgenommenen Anordnungen und die verschiedenen Arten kennen, die den Obstgarten bilden.\nKostenlos."
        ],
        "en": [
          "GUIDED TOUR OF THE PARK AND ORCHARD:\nDuring this tour, you'll learn about the work done at Clos Saint Victor and the different species that make up the orchard.\nFree admission."
        ],
        "it": [
          "VISITA GUIDATA DEL PARCO E DEL FRUTTETO:\nDurante questa visita, potrete conoscere le migliorie apportate al Clos Saint Victor e le diverse specie che compongono il frutteto.\nIngresso libero."
        ],
        "fr": [
          "VISITE COMMENTÉE DU PARC ET DU VERGER :\nVous découvrirez au cours de cette visite les aménagements réalisés au clos Saint Victor et les différentes espèces qui composent le verger.\nGratuit."
        ],
        "es": [
          "VISITA GUIADA AL PARQUE Y AL HUERTO:\nDurante este recorrido, conocerá las mejoras realizadas en el Clos Saint Victor y las diferentes especies que componen el huerto.\nEntrada gratuita."
        ],
        "nl": [
          "RONDLEIDING DOOR HET PARK EN DE BOOMGAARD:\nTijdens deze rondleiding leer je meer over de verbeteringen die zijn aangebracht aan de Clos Saint Victor en de verschillende soorten die deel uitmaken van de boomgaard.\nGratis toegang."
        ]
      },
