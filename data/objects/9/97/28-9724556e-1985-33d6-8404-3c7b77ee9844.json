  "rdfs:comment": {
    "de": [
      "Probieren Sie die guten, frischen Pommes frites bei Nounours und Séverine!\nImmer lächelnd, freundlich und einladend.\nSpezialitäten: Burger, Paninis, amerikanische, savoyische und Andouillettes.\nNounours et Séverine kommen auch auf Anfrage für Ihre Veranstaltungen.\nFans von Pommes frites, fragen Sie nach unserer Treuekarte."
    ],
    "en": [
      "Come and taste the good fresh fries at Nounours and Séverine's !\nAlways smiling, friendly and welcoming.\nSpecialities: burgers, paninis, American, Savoyard and andouillettes.\nNounours et Séverine also travel on demand for your events.\nFans of french fries, ask for our loyalty card."
    ],
    "it": [
      "Venite a gustare le buone patatine fritte fresche di Nounours e Séverine!\nSempre sorridenti, cordiali e accoglienti.\nSpecialità: hamburger, panini, americani, savoiardi e andouillettes.\nNounours et Séverine viaggiano anche su richiesta per i vostri eventi.\nAppassionati di patatine, richiedete la nostra carta fedeltà."
    ],
    "fr": [
      "Venez goûter les bonnes frites fraîches chez Nounours et Séverine !\nToujours souriants, aimables et accueillants.\nSpécialités : burgers, paninis, américains, savoyards et andouillettes.\nNounours et Séverine se déplacent également à la demande pour vos événements.\nFans de frites, demandez notre carte de fidélité."
    ],
    "es": [
      "¡Ven a probar las buenas patatas fritas frescas de Nounours y Séverine's!\nSiempre sonrientes, amables y acogedores.\nEspecialidades: hamburguesas, paninis, americana, saboyana y andouillettes.\nNounours et Séverine también se desplazan a petición para sus eventos.\nAficionados a las patatas fritas, soliciten nuestra tarjeta de fidelidad."
    ],
    "nl": [
      "Kom en proef de goede verse frieten bij Nounours en Séverine's!\nAltijd glimlachend, vriendelijk en gastvrij.\nSpecialiteiten: hamburgers, panini's, Amerikaanse, Savoyaardse en andouillettes.\nNounours et Séverine reizen ook op aanvraag voor uw evenementen.\nFans van frietjes, vraag naar onze klantenkaart."
    ]
  },
