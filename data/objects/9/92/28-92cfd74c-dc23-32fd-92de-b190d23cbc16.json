  "rdfs:comment": {
    "de": [
      "Bar, Brasserie, Creperie in der Fußgängerzone mit einer großen Auswahl an Crepes, Galettes, Spezialitäten aus der Picardie (Ficelle Picarde) und 11 Rezepten für Miesmuscheln und Pommes frites.\nGerichte zum Mitnehmen."
    ],
    "en": [
      "Bar, Brasserie, Creperie located in the pedestrian area offering a wide variety of crepes, galettes, Picardy specialities (ficelle picarde) and 11 recipes of mussels and chips.\nPossibility of take-away meals."
    ],
    "it": [
      "Bar, Brasserie, Creperie situato nella zona pedonale che offre un'ampia varietà di crepes, galettes, specialità piccarde (ficelle picarde) e 11 ricette di cozze e patatine.\nPossibilità di pasti da asporto."
    ],
    "fr": [
      "Bar, Brasserie, Creperie situe dans la zone pietonne proposant une grande variete de crepes, galettes, specialites picardes (ficelle picarde) et 11 recettes de moules-frites.\nPossibilite de plats a emporter."
    ],
    "es": [
      "Bar, Brasserie, Creperie situado en la zona peatonal que ofrece una gran variedad de crepes, galettes, especialidades de Picardía (ficelle picarde) y 11 recetas de mejillones con patatas fritas.\nPosibilidad de comidas para llevar."
    ],
    "nl": [
      "Bar, Brasserie, Creperie gelegen in de voetgangerszone met een grote verscheidenheid aan crêpes, galettes, Picardische specialiteiten (ficelle picarde) en 11 recepten van mosselen en frieten.\nMogelijkheid tot afhaalmaaltijden."
    ]
  },
