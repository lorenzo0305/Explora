  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0371037c-5dbe-3536-8c1c-4b05dba90b7e",
      "dc:description": {
        "de": [
          "Balad'en ferme von 14:30 bis 16:30 Uhr\nEntdecken Sie die Aktivitäten auf dem Bauernhof von M. Tourret in Camiers - Anmeldung beim Fremdenverkehrsamt erforderlich\nPreis: 6?/Erwachsener und 4?/Kind"
        ],
        "en": [
          "Balad'en ferme from 2:30 pm to 4:30 pm\nCome and discover the activities on Mr. Tourret's farm in Camiers - Registration essential at the Tourist Office\nPrice: 6?/adult and 4?/child"
        ],
        "it": [
          "Balad'en ferme dalle 14.30 alle 16.30\nVenite a scoprire le attività della fattoria del signor Tourret a Camiers - È indispensabile iscriversi all'Ufficio del Turismo\nPrezzo: 6€/adulto e 4€/bambino"
        ],
        "fr": [
          "Balad'en ferme de 14h30 à 16h30\nVenez découvrir les activités à la ferme de M. Tourret à Camiers - Inscription indispensable à l'Office de Tourisme\nTarif : 6€/adulte et 4€/enfant"
        ],
        "nl": [
          "Balad'en ferme van 14.30 tot 16.30 uur\nKom en ontdek de activiteiten op de boerderij van Mr Tourret in Camiers - Aanmelden noodzakelijk bij het Office du Tourisme\nPrijs: 6€/volwassene en 4€/kind"
        ],
        "es": [
          "Balad'en ferme de 14h30 a 16h30\nVenga a descubrir las actividades de la granja del Sr. Tourret en Camiers - Inscripción obligatoria en la Oficina de Turismo\nPrecio: 6€/adulto y 4€/niño"
        ]
      },
