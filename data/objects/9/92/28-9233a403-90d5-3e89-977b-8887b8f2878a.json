  "rdfs:comment": {
    "de": [
      "Am Samstag, dem 11. April 2026, wird sich der Place Jeanne-Hachette in eine riesige Freiluftbibliothek verwandeln. Ausgabe der Buchmesse von Beauvais lädt Groß und Klein dazu ein, die \"Macht des Buches\" an einem Tag voller Begegnungen und Entdeckungen zu feiern."
    ],
    "en": [
      "On Saturday April 11, 2026, the Place Jeanne-Hachette will be transformed into a huge open-air library. For its 8th edition, the Salon du Livre de Beauvais invites young and old to celebrate \"the power of books\" during a day rich in encounters and discoveries."
    ],
    "it": [
      "Sabato 11 aprile 2026, la Place Jeanne-Hachette si trasformerà in una grande biblioteca a cielo aperto. Per la sua ottava edizione, il Salone del Libro di Beauvais invita grandi e piccini a celebrare \"il potere dei libri\" in una giornata ricca di incontri e scoperte."
    ],
    "fr": [
      "Le samedi 11 avril 2026, la Place Jeanne-Hachette se transformera en une immense bibliothèque à ciel ouvert. Pour sa 8ème édition, le Salon du Livre de Beauvais invite petits et grands à célébrer \"le pouvoir du livre\" lors d’une journée riche en rencontres et en découvertes."
    ],
    "nl": [
      "Op zaterdag 11 april 2026 wordt de Place Jeanne-Hachette omgetoverd tot een grote openluchtbibliotheek. Voor haar 8e editie nodigt de Boekenbeurs van Beauvais jong en oud uit om \"de kracht van boeken\" te vieren tijdens een dag vol ontmoetingen en ontdekkingen."
    ],
    "es": [
      "El sábado 11 de abril de 2026, la plaza Jeanne-Hachette se transformará en una gran biblioteca al aire libre. En su 8ª edición, la Feria del Libro de Beauvais invita a grandes y pequeños a celebrar \"el poder de los libros\" en una jornada llena de encuentros y descubrimientos."
    ]
  },
  "rdfs:label": {
