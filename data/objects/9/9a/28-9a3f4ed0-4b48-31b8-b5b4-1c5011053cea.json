  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/045ba497-fcd2-3155-9090-09154ff60edd",
      "dc:description": {
        "de": [
          "Die Société des Amis des Musées de Lille ist ein Kulturverein, der die drei Museen von Lille vertritt, die im Herzen der Metropole Lille liegen: das Palais des Beaux-Arts, das Musée de l'Hospice Comtesse und das Musée d'Histoire Naturelle (Naturkundemuseum). Ihre Aufgabe ist es, zur Bereicherung ihrer Sammlungen, ihrer Entwicklung und ihrer Animation beizutragen."
        ],
        "en": [
          "The Société des Amis des Musées de Lille is a cultural association representing Lille?s three museums, located in the heart of the city: the Palais des Beaux-Arts, the Musée de l?Hospice Comtesse and the Musée d?Histoire Naturelle. Its mission is to contribute to the enrichment, development and animation of their collections."
        ],
        "it": [
          "La Société des Amis des Musées de Lille è un'associazione culturale che rappresenta i tre musei di Lille nel cuore della città: il Palais des Beaux-Arts, il Musée de l'Hospice Comtesse e il Musée d'Histoire Naturelle. La sua missione è contribuire all'arricchimento, allo sviluppo e alla promozione delle loro collezioni."
        ],
        "fr": [
          "La Société des Amis des Musées de Lille est une association culturelle qui représente les trois Musées lillois, implantés au cœur de la métropole lilloise : le Palais des Beaux-Arts, le Musée de l’Hospice Comtesse et le Musée d’Histoire Naturelle. Elle a pour mission de contribuer à l’enrichissement de leurs collections, à leur développement et à leur animation."
        ],
        "es": [
          "La Société des Amis des Musées de Lille es una asociación cultural que representa a los tres museos de Lille situados en el corazón de la ciudad: el Palais des Beaux-Arts, el Musée de l'Hospice Comtesse y el Musée d'Histoire Naturelle. Su misión es contribuir al enriquecimiento, desarrollo y promoción de sus colecciones."
        ],
        "nl": [
          "De Société des Amis des Musées de Lille is een culturele vereniging die de drie musea van Lille in het hart van de stad vertegenwoordigt: het Palais des Beaux-Arts, het Musée de l'Hospice Comtesse en het Musée d'Histoire Naturelle. Haar missie is om bij te dragen aan de verrijking, ontwikkeling en promotie van hun collecties."
        ]
      },
