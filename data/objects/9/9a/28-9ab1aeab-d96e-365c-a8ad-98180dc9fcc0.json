  "rdfs:comment": {
    "de": [
      "Sensorische Tour\n\nAus der Perspektive eines Tieres erkunden die Kleinsten die Landschaften der Metropolregion mit ihren Sinnen: Hören, Fühlen und Sehen."
    ],
    "en": [
      "Sensory tour\n\nBy taking the point of view of an animal, toddlers explore the landscapes of the Metropolis through their senses: hearing, touch and sight."
    ],
    "it": [
      "Visita sensoriale\n\nAssumendo il punto di vista di un animale, i bambini possono esplorare i paesaggi della Francia metropolitana attraverso i loro sensi: udito, tatto e vista."
    ],
    "fr": [
      "Visite sensorielle\n\nEn prenant le point de vue d’un animal, les tout-petits explorent les paysages de la Métropole à travers leurs sens : l’ouïe, le toucher et la vue."
    ],
    "nl": [
      "Zintuiglijk bezoek\n\nDoor het standpunt van een dier in te nemen, kunnen peuters de landschappen van Metropolitan France verkennen via hun zintuigen: horen, aanraken en zien."
    ],
    "es": [
      "Visita sensorial\n\nAdoptando el punto de vista de un animal, los más pequeños podrán explorar los paisajes de la Francia metropolitana a través de sus sentidos: el oído, el tacto y la vista."
    ]
  },
  "rdfs:label": {
    "fr": [
