  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab38e81e-fe81-3dd5-9828-faa362853ec5",
      "dc:description": {
        "de": [
          "Sois Ane in Rumilly bietet Wandertouren für Familien im Rhythmus des Esels auf Strecken von 4 und 8 km an. Der Verein bietet auch Mediation für Gruppen mit dem Esel an. Individualisierte Projekte, Teamarbeit mit den Partnern. Zielgruppen: Menschen mit Behinderungen oder in Schwierigkeiten."
        ],
        "en": [
          "Sois Ane à Rumilly offers family walks at the pace of the donkey, on 4 and 8 km circuits. The association also offers group mediation with the donkey. Individualized projects, teamwork with partners. Target groups: people with disabilities or in difficulty."
        ],
        "it": [
          "Sois Ane a Rumilly propone passeggiate per famiglie al passo dell'asino su circuiti di 4 e 8 km. L'associazione offre anche mediazione per gruppi, con l'asino. Progetti personalizzati, lavoro di squadra con i partner. Gruppi target: persone con disabilità o in difficoltà."
        ],
        "fr": [
          "Sois Ane à Rumilly vous propose des randonnées pédestres en famille, au rythme de l'âne sur des circuits de 4 et 8 km. L'association propose également de la médiation pour les groupes, avec l'âne. Projets individualisés, travail en équipe avec les partenaires. Publics concernés : personnes en situation de handicap ou en difficulté."
        ],
        "es": [
          "Sois Ane, en Rumilly, ofrece paseos familiares al paso del burro en circuitos de 4 y 8 km. La asociación también ofrece mediación para grupos, con el burro. Proyectos individualizados, trabajo en equipo con socios. Grupos destinatarios: personas discapacitadas o con dificultades."
        ],
        "nl": [
          "Sois Ane in Rumilly biedt gezinswandelingen op het tempo van de ezel op circuits van 4 en 8 km. De vereniging biedt ook bemiddeling voor groepen, met de ezel. Projecten op maat, samenwerking met partners. Doelgroepen: mensen met een handicap of in moeilijkheden."
        ]
      },
      "@type": [
        "Description"
