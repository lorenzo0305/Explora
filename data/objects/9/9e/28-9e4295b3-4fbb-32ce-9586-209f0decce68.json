  "rdfs:comment": {
    "de": [
      "Aux Moules de Lille ist die unumgängliche Adresse im Hyperzentrum von Lille, um Muscheln, Meeresfrüchte und Fisch in einer geselligen Atmosphäre zu genießen."
    ],
    "en": [
      "Aux Moules de Lille is the place to go in the center of Lille for mussels, seafood and fish in a friendly atmosphere."
    ],
    "it": [
      "Aux Moules de Lille è il luogo in cui recarsi nel centro di Lille per gustare cozze, frutti di mare e pesce in un'atmosfera accogliente."
    ],
    "fr": [
      "Aux Moules de Lille est l'adresse incontournable en hyper centre de Lille pour déguster les moules, fruits de mer et poissons dans une ambiance conviviale."
    ],
    "es": [
      "En el centro de Lille, Aux Moules de Lille ofrece mejillones, marisco y pescado en un ambiente agradable."
    ],
    "nl": [
      "Aux Moules de Lille is dé plek in het centrum van Lille voor mosselen, zeevruchten en vis in een gezellige sfeer."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aux Moules de Lille"
    ]
  },
  "COVID19SpecialMeasures": {
    "de": [
      "Das Aux Moules de Lille liegt in der Nähe des Grand Place und ist eine gute Adresse, um Meeresfrüchte und regionale Gerichte zu genießen. Das an sieben Tagen in der Woche geöffnete Restaurant bietet zwei Bereiche mit 50 und 100 Gedecken, in denen Sie Ihre Geschäftsessen, Gruppen und Seminare abhalten können."
    ],
    "en": [
      "Located near the Grand Place, Aux Moules de Lille is the place to go for seafood and regional dishes. Open 7 days a week, the restaurant offers 2 dining areas, with 50 and 100 place settings, for business meals, groups and seminars."
    ],
    "it": [
      "Situato vicino alla Grand Place, Aux Moules de Lille è il luogo ideale per gustare frutti di mare e piatti regionali. Il ristorante è aperto 7 giorni su 7 e dispone di 2 sale da pranzo, con 50 e 100 coperti, per pranzi di lavoro, gruppi e seminari."
    ],
    "fr": [
      "Situé à proximité de la Grand Place, Aux Moules de Lille est une adresse pour déguster produits de la mer et plats régionaux. Ce restaurant ouvert 7J/7 propose 2 espaces, de 50 et 100 couverts, pour recevoir vos repas d’affaires, groupes et séminaires."
    ],
    "es": [
      "Situado cerca de la Grand Place, Aux Moules de Lille es el lugar ideal para degustar marisco y platos regionales. El restaurante abre los 7 días de la semana y ofrece 2 comedores, de 50 y 100 cubiertos, para comidas de negocios, grupos y seminarios."
    ],
    "nl": [
      "Aux Moules de Lille ligt vlak bij de Grote Markt en is de plek bij uitstek voor zeevruchten en regionale gerechten. Het restaurant is 7 dagen per week geopend en biedt 2 eetzalen, met 50 en 100 couverts, voor zakendiners, groepen en seminars."
    ]
  },
