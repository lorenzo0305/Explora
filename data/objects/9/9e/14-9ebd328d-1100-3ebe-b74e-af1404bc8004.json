  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/196e2e00-6002-39ed-8375-f47c48018d63",
      "dc:description": {
        "de": [
          "Erleben Sie das Mittelalter im Schloss von Fressin!\nAuf dem Programm stehen Racon?thé-Vorträge, eine Theateraufführung, eine Spinnwerkstatt, Führungen zu essbaren und medizinischen Pflanzen sowie Fechtvorführungen.\n\n? Freier und kostenloser Zugang zum Gelände."
        ],
        "en": [
          "Relive the Middle Ages at Château de Fressin!\nOn the program: Racon?thé lectures, theatrical performances, spinning workshops, guided tours of edible and medicinal plants, and fencing demonstrations.\n\n? Free admission to the site."
        ],
        "it": [
          "Rivivete il Medioevo al Castello di Fressin!\nIn programma: lezioni di Racon?thé, spettacoli teatrali, un laboratorio di filatura, visite guidate alle piante commestibili e medicinali e dimostrazioni di scherma.\n\n? Ingresso gratuito al sito."
        ],
        "fr": [
          "Revivez le Moyen Âge au Château de Fressin !\nAu programme : conférences Racon’thé, représentation théâtrale, atelier de filage, visites guidées sur les plantes comestibles et médicinales, ainsi que des démonstrations d’escrime. \n\n👉 Accès libre et gratuit au site."
        ],
        "es": [
          "Reviva la Edad Media en el castillo de Fressin\nEn el programa: conferencias de Racon?thé, representaciones teatrales, un taller de hilado, visitas guiadas a plantas comestibles y medicinales, y demostraciones de esgrima.\n\n? Entrada gratuita al recinto."
        ],
        "nl": [
          "Herleef de Middeleeuwen in Château de Fressin!\nOp het programma: Racon?thé lezingen, theatervoorstellingen, een spinworkshop, rondleidingen langs eetbare en geneeskrachtige planten en schermdemonstraties.\n\n? Gratis toegang tot de site."
        ]
      },
