  "rdfs:comment": {
    "de": [
      "Atmen Sie durch, bewegen Sie sich, genießen Sie eine einzigartige grüne Oase, nur einen Katzensprung von Lens entfernt!\nEin weitläufiger Landschaftspark zwischen Wasser und Grün, ideal zum Entspannen, für sportliche Aktivitäten oder Veranstaltungen unter freiem Himmel."
    ],
    "en": [
      "Breathe, move and enjoy a unique green setting just a stone's throw from Lens!\nA vast landscaped park between water and greenery, ideal for relaxation, sporting activities or outdoor events."
    ],
    "it": [
      "Respirare, muoversi e godere di un ambiente verde unico a due passi da Lens!\nUn vasto parco paesaggistico tra acqua e verde, ideale per rilassarsi, praticare sport o godersi eventi all'aperto."
    ],
    "fr": [
      "Respirez, bougez, profitez d’un écrin de verdure unique à deux pas de Lens !\nUn vaste parc paysager entre eau et verdure, idéal pour se détendre, pratiquer des activités sportives ou profiter d’événements en plein air."
    ],
    "es": [
      "Respire, muévase y disfrute de un entorno verde único a tiro de piedra de Lens\nUn inmenso parque ajardinado entre agua y vegetación, ideal para relajarse, practicar deportes o disfrutar de eventos al aire libre."
    ],
    "nl": [
      "Adem, beweeg en geniet van een unieke groene omgeving op een steenworp afstand van Lens!\nEen uitgestrekt landschapspark tussen water en groen, ideaal om te ontspannen, te sporten of te genieten van openluchtevenementen."
    ]
  },
