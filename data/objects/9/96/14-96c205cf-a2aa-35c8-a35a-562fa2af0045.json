  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11b6a9ad-e781-3909-aede-eb1c7d40ff8c",
      "dc:description": {
        "de": [
          "Vorkonzert Hinter den Kulissen des 9-9bis :\n Entdecken Sie diesen einzigartigen Konzertsaal: Von der Klangarchitektur des Gebäudes über die Bühne bis hin zur technischen Funktionsweise von Ton und Licht - das?Métaphone?wird keine Geheimnisse mehr vor Ihnen haben!"
        ],
        "en": [
          "Avant-concert Backstage at 9-9bis:\n Discover this one-of-a-kind concert hall: from the sound architecture of the building to the stage and the technical operation of sound and lighting, the ?Métaphone? will hold no secrets for you!"
        ],
        "it": [
          "Avant-concert Dietro le quinte del 9-9bis:\n Scoprite questo luogo di concerti unico nel suo genere: dall'architettura sonora dell'edificio al palcoscenico e al funzionamento tecnico degli impianti audio e luci, il \"Métaphone\" non avrà segreti per voi!"
        ],
        "fr": [
          "Avant-concert Les coulisses du 9-9bis :\n Découvrez cette salle de concert unique en son genre : de l’architecture sonore du bâtiment à la scène, en passant par le fonctionnement technique du son et de la lumière, le Métaphone n’aura plus de secrets pour vous !"
        ],
        "es": [
          "Avant-concert Entre bastidores en el 9-9bis:\n Descubra esta sala de conciertos única en su género: desde la arquitectura sonora del edificio hasta el escenario y el funcionamiento técnico de los sistemas de sonido e iluminación, el \"Métaphone\" no tendrá secretos para usted"
        ],
        "nl": [
          "Avant-concert Achter de schermen bij 9-9bis:\n Ontdek deze unieke concertzaal: van de geluidsarchitectuur van het gebouw tot het podium en de technische werking van de geluids- en lichtsystemen, de \"Métaphone\" heeft geen geheimen voor jou!"
        ]
      },
      "@type": [
        "Description"
