  "rdfs:comment": {
    "de": [
      "Tiken Jah Fakoly, Legende mit ivorischen Wurzeln, Kämpfer der ersten Stunde für Gleichheit und Gerechtigkeit, feiert mit dieser Tournee sein Repertoire in akustischer Form."
    ],
    "en": [
      "Tiken Jah Fakoly, the Ivorian-born legend and early campaigner for equality and justice, celebrates his acoustic repertoire on this tour."
    ],
    "it": [
      "Tiken Jah Fakoly, leggenda di origine ivoriana e attivista per l'uguaglianza e la giustizia, celebra il suo repertorio acustico in questo tour."
    ],
    "fr": [
      "Tiken Jah Fakoly, légende d’origine ivoirienne, militant de la première heure pour l’égalité et la justice, célèbre avec cette tournée son répertoire en acoustique."
    ],
    "es": [
      "Tiken Jah Fakoly, la leyenda nacida en Costa de Marfil y uno de los primeros defensores de la igualdad y la justicia, celebra su repertorio acústico en esta gira."
    ],
    "nl": [
      "Tiken Jah Fakoly, de in Ivoorkust geboren legende en vroege campagnevoerder voor gelijkheid en rechtvaardigheid, viert zijn akoestische repertoire op deze tour."
