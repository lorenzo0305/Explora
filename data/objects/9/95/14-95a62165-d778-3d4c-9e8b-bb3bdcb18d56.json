  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d6ef7d1d-c633-3628-b53c-ba4f80c41c01",
      "dc:description": {
        "de": [
          "Brot, Gebäck, Viennoiserie, Mittagstisch, Pizzas zum Mitnehmen?\nWillkommen bei Sophie!\nDas Team empfängt Sie jeden Tag durchgehend, 7 Tage die Woche, von 6:30 bis 19:30 Uhr"
        ],
        "en": [
          "Bread, pastries, viennoiseries, lunch, takeaway pizzas?\nWelcome to Sophie's!\nThe team welcomes you every day, 7 days a week, from 6.30am to 7.30pm"
        ],
        "it": [
          "Pane, pasticceria, viennoiseries, offerte per il pranzo, pizze da asporto?\nBenvenuti da Sophie's!\nIl team vi accoglie ogni giorno, 7 giorni su 7, dalle 6.30 alle 19.30"
        ],
        "fr": [
          "Pains pâtisseries, viennoiseries, formule déjeuner, pizzas à emporter…. \nBienvenue chez Sophie ! \nL’équipe vous accueille chaque jour en continu, 7 jours sur 7, de 6h30 à 19h30"
        ],
        "es": [
          "¿Pan, bollería, viennoiseries, ofertas de almuerzo, pizzas para llevar?\n¡Bienvenido a Sophie's!\nEl equipo le da la bienvenida todos los días, 7 días a la semana, de 6h30 a 19h30"
        ],
        "nl": [
          "Brood, gebak, viennoiseries, lunchaanbiedingen, afhaalpizza's?\nWelkom bij Sophie's!\nHet team verwelkomt u elke dag, 7 dagen per week, van 6.30 tot 19.30 uur"
        ]
      },
