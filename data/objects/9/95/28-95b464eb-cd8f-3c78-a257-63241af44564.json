  "rdfs:comment": {
    "de": [
      "Maître Restaurant, Restaurateur de France. Ein Restaurant mit einem in der Region sehr seltenen provenzalischen Ambiente, das sich in der Nähe des Freizeitzentrums Axo'Plage und des Chemin des Dames, der Drachenhöhle und des Center Parcs zwischen Laon und Soissons befindet.\nZwischen traditionell und gastronomisch liegt es an Ihnen, zu urteilen: Abwechslung garantiert."
    ],
    "en": [
      "Maître restaurant, Restaurateur de France. A restaurant with a Provencal atmosphere, rare in the region, located near the Axo'Plage leisure park and Chemin des Dames, the Caverne du Dragon and Center Parcs, between Laon and Soissons.\nFrom traditional to gastronomic, you be the judge: a change of scenery guaranteed."
    ],
    "it": [
      "Ristorante Master, Restaurateur de France. Un ristorante dall'atmosfera provenzale, molto raro nella regione, situato vicino al centro ricreativo Axo'Plage e allo Chemin des Dames, alla Caverne du Dragon e al Center Parcs, tra Laon e Soissons.\nDalla tradizione alla gastronomia, la scelta è vostra: un cambiamento di scenario garantito."
    ],
    "fr": [
      "Maître restaurant, Restaurateur de France. Un restaurant au cadre très rare dans la région à l'ambiance provençale, situé à proximité de la base de loisirs Axo'Plage et du Chemin des Dames, de la Caverne du Dragon et du Center Parcs, entre Laon et Soissons.\nEntre traditionnel et gastronomique à vous de juger : dépaysement garanti ."
    ],
    "es": [
      "Restaurante maestro, Restaurateur de France. Un restaurante de ambiente provenzal, muy poco común en la región, situado cerca del centro de ocio Axo'Plage y del Chemin des Dames, la Caverne du Dragon y Center Parcs, entre Laon y Soissons.\nDe lo tradicional a lo gastronómico, la elección es suya: un cambio de aires garantizado."
    ],
    "nl": [
      "Meesterrestaurant, Restaurateur de France. Een restaurant met een Provençaalse sfeer, zeer zeldzaam in de regio, gelegen in de buurt van het recreatiecentrum Axo'Plage en de Chemin des Dames, de Caverne du Dragon en Center Parcs, tussen Laon en Soissons.\nVan traditioneel tot gastronomisch, de keuze is aan u: een verandering van omgeving gegarandeerd."
    ]
  },
