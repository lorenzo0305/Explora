  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ec9dd90c-1f58-37cd-af56-73387f280e3d",
      "dc:description": {
        "de": [
          "Nehmen Sie im Rahmen der Olympischen Spiele 2024 am \"Jeu des Vitrines\" teil, das vom Fremdenverkehrsamt in Partnerschaft mit den Geschäftsleuten von Camiers-Sainte Cécile organisiert wird."
        ],
        "en": [
          "As part of the 2024 Olympic Games, take part in the \"Jeu des Vitrines\" organized by the Tourist Office in partnership with Camiers-Sainte Cécile shopkeepers."
        ],
        "it": [
          "Nell'ambito dei Giochi Olimpici del 2024, partecipate al \"Gioco delle vetrine\" organizzato dall'Ufficio del Turismo in collaborazione con i commercianti di Camiers-Sainte Cécile."
        ],
        "fr": [
          "Dans le cadre des jeux olympiques 2024, participez au \"Jeu des Vitrines\" organisé par l'Office de Tourisme en partenariat avec les commerçants de Camiers-Sainte Cécile."
        ],
        "es": [
          "En el marco de los Juegos Olímpicos de 2024, participe en el \"Juego de los escaparates\" organizado por la Oficina de Turismo en colaboración con los comerciantes de Camiers-Sainte Cécile."
        ],
        "nl": [
          "Doe in het kader van de Olympische Spelen van 2024 mee aan het \"Etalagespel\", georganiseerd door het Office du Tourisme in samenwerking met de winkeliers van Camiers-Sainte Cécile."
        ]
      },
