  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/35b49250-3384-3421-b0cd-13411246de78",
      "dc:description": {
        "de": [
          "Es ist eine flache Strecke, die sich Ihnen bietet. Kein einziger Anstieg ist zu sehen. Willkommen im \"Pays des Wateringues\" in der Region Flandres Maritimes."
        ],
        "en": [
          "It's a flat circuit. Not a single climb in sight. Welcome to the \"Pays des Wateringues\" in maritime Flanders."
        ],
        "it": [
          "È un circuito piatto. Non c'è una sola salita all'orizzonte. Benvenuti nel \"Pays des Wateringues\" nelle Fiandre marittime."
        ],
        "fr": [
          "C'est un circuit plat qui s'offre à vous. Pas la moindre montée à l'horizon. Bienvenue au \"Pays des Wateringues\" dans les Flandres maritimes."
        ],
        "nl": [
          "Het is een vlak parcours. Geen enkele klim aan de horizon. Welkom in het \"Pays des Wateringues\" in maritiem Vlaanderen."
        ],
        "es": [
          "Es un circuito llano. Ni una sola subida en el horizonte. Bienvenido al \"Pays des Wateringues\", en el Flandes marítimo."
        ]
      },
