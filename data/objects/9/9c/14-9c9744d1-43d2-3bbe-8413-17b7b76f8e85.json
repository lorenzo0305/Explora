      "dc:description": {
        "de": [
          "Herr Mickaël Dégardin bietet Ihnen Bienenprodukte an, die vor Ort und nach Vereinbarung verkauft werden. Honig aus allen Blüten und Pollen."
        ],
        "en": [
          "Mr Mickaël Dégardin offers beekeeping products for sale on site and by appointment. All-flower honeys and pollen."
        ],
        "it": [
          "Il signor Mickaël Dégardin offre prodotti apistici in vendita sul posto e su appuntamento. Mieli e polline di tutti i fiori."
        ],
        "fr": [
          "Mr Mickaël Dégardin vous propose des produits apicoles vente sur place et  sur rendez-vous. Miels toute fleur et pollen."
        ],
        "es": [
          "El Sr. Mickaël Dégardin ofrece productos apícolas a la venta in situ y con cita previa. Mieles de todas las flores y polen."
        ],
        "nl": [
          "De heer Mickaël Dégardin biedt ter plaatse en op afspraak imkerijproducten te koop aan. Alle bloemenhoning en stuifmeel."
        ]
      },
