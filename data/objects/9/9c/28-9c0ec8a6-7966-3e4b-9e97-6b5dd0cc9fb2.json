  "rdfs:comment": {
    "de": [
      "Unser Hotel-Restaurant, das sich in einer alten Mühle befindet, empfängt Sie am Flussufer im Herzen der Champagner-Weinberge. Wir bieten Ihnen eine hausgemachte Küche aus der Region.\nMeisterrestaurator\nMichelin-Führer\nGault und Millau"
    ],
    "en": [
      "Our hotel-restaurant, located in an old mill, welcomes you to the riverside in the heart of the Champagne vineyards. We offer home-made, local cuisine.\nMaster restaurateur\nMichelin Guide\nGault et Millau"
    ],
    "it": [
      "Il nostro hotel-ristorante, ricavato da un antico mulino, vi accoglie nel suo ambiente fluviale nel cuore dei vigneti della Champagne. Offriamo una cucina casalinga e locale.\nMaestro ristoratore\nGuida Michelin\nGault et Millau"
    ],
    "fr": [
      "Notre hôtel-restaurant, situé dans un ancien moulin, vous accueille au bord de la rivière en plein coeur du vignoble de champagne. Nous proposons une cuisine du terroir, faite maison.\nMaître restaurateur \nGuide Michelin \nGault et Millau"
    ],
    "nl": [
      "Ons hotel-restaurant, gevestigd in een oude molen, verwelkomt je aan de rivier in het hart van de Champagne wijngaarden. Wij bieden huisgemaakte, lokale gerechten.\nMeester-restauranthouder\nMichelin-gids\nGault et Millau"
    ],
    "es": [
      "Nuestro hotel-restaurante, ubicado en un antiguo molino, le da la bienvenida en su entorno ribereño, en el corazón de los viñedos de Champaña. Le ofrecemos una cocina casera y local.\nMaestro restaurador\nGuía Michelin\nGault et Millau"
    ]
  },
