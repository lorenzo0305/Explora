  "rdfs:comment": {
    "de": [
      "Richtung Kanada, nach Vimy! Seit September 2023 ist die Gedenkstätte als Grab- und Gedenkstätten des Ersten Weltkriegs in das UNESCO-Weltkulturerbe aufgenommen."
    ],
    "en": [
      "Direction Canada, to Vimy! Since September 2023, the memorial has been listed as a World Heritage Site by Unesco."
    ],
    "it": [
      "In viaggio verso il Canada, a Vimy! Dal settembre 2023, il monumento commemorativo è stato inserito nella lista del patrimonio mondiale dell'Unesco per la Prima Guerra Mondiale."
    ],
    "fr": [
      "Direction le Canada, à Vimy ! Depuis septembre 2023 le mémorial est inscrit en tant que sites funéraires et mémoriels de la Première Guerre mondiale au Patrimoine mondial de l'Unesco."
    ],
    "es": [
      "Rumbo a Canadá, ¡a Vimy! Desde septiembre de 2023, el monumento conmemorativo está inscrito en la Lista del Patrimonio Mundial de la Unesco de la Primera Guerra Mundial."
    ],
    "nl": [
      "Op weg naar Canada, naar Vimy! Sinds september 2023 staat het monument op de Werelderfgoedlijst van Unesco voor de Eerste Wereldoorlog."
    ]
  },
