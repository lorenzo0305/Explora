  "rdfs:comment": {
    "de": [
      "Eine kurze Speisekarte, hausgemachte Gerichte aus frischen Zutaten, eine durchdachte Weinkarte und ein freundlicher Service... öffnen Sie die Tür des Studios für einen Moment des Geschmackserlebnisses..."
    ],
    "en": [
      "A short menu, homemade dishes made with fresh produce, a well-structured wine list and attentive service... push open the Studio's door for a moment of gustatory pleasure..."
    ],
    "it": [
      "Un menu breve, piatti fatti in casa con prodotti freschi, una carta dei vini accuratamente selezionata e un servizio attento... entrate nello Studio per un momento di piacere gustativo..."
    ],
    "fr": [
      "Une carte courte, des plats faits maison avec des produits frais, une carte des vins étudiée et un service aux petits oignons... poussez la porte du Studio pour un moment de plaisir gustatif..."
    ],
    "es": [
      "Una carta corta, platos caseros elaborados con productos frescos, una carta de vinos cuidadosamente seleccionada y un servicio atento... entre en el Studio para un momento de placer gustativo..."
    ],
    "nl": [
      "Een korte kaart, huisgemaakte gerechten met verse producten, een zorgvuldig geselecteerde wijnkaart en attente bediening... stap binnen in de Studio voor een moment van smakelijk genot..."
    ]
  },
