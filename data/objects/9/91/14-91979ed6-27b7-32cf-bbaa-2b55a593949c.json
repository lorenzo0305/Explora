      "@id": "https://data.datatourisme.fr/16c13d25-ab7f-39d0-8907-ef6d242e2b3a",
      "dc:description": {
        "de": [
          "Samstag, 4. und Sonntag, 5. Mai 2024\n\nStart am Samstag um 14:30 Uhr, Place du Centenaire (Spaziergang in der Baie de Canche).\nStart am Sonntag um 10 Uhr, Place du Centenaire (Solidaritätsparade)."
        ],
        "en": [
          "Saturday May 4 and Sunday May 5, 2024\n\nDeparture Saturday at 2:30 pm, place du Centenaire (stroll in the Baie de Canche).\nSunday 10am, Place du Centenaire (solidarity parade)."
        ],
        "it": [
          "Sabato 4 e domenica 5 maggio 2024\n\nPartenza sabato alle 14.30 da Place du Centenaire (passeggiata nella Baie de Canche).\nPartenza domenica alle 10 da Place du Centenaire (corteo di solidarietà)."
        ],
        "fr": [
          "Samedi 4 et dimanche 5 mai 2024\n\nDépart samedi à 14h30, place du Centenaire (balade en Baie de Canche).\nDépart dimanche à 10h, place du Centenaire (parade solidaire)."
        ],
        "nl": [
          "Zaterdag 4 en zondag 5 mei 2024\n\nVertrek op zaterdag om 14.30 uur vanaf Place du Centenaire (wandeling in de Baie de Canche).\nVertrek op zondag om 10u vanaf de Place du Centenaire (solidariteitsparade)."
        ],
        "es": [
          "Sábado 4 y domingo 5 de mayo de 2024\n\nSalida el sábado a las 14.30 h de la plaza del Centenario (paseo por la bahía de Canche).\nSalida el domingo a las 10 h de la plaza del Centenario (desfile solidario)."
        ]
      },
