  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/427475f1-fdc8-38cc-93b9-5fff4f79831e",
      "dc:description": {
        "de": [
          "Entdecken Sie die Aromen einer raffinierten und eleganten Küche in einem atypischen Dekor, das Sie in die 20er Jahre zurückversetzt und Sie mit seinen ausgeklügelten Kreationen in den Geschmackshimmel führt."
        ],
        "en": [
          "Come and discover the flavors of refined, elegant cuisine in an atypical setting that will take you back to the 1920s and take you to gustatory heaven with its elaborate creations."
        ],
        "it": [
          "Venite a scoprire i sapori di una cucina raffinata ed elegante in un ambiente atipico che vi riporterà indietro agli anni '20 e vi porterà in paradiso gustativo con le sue elaborate creazioni."
        ],
        "fr": [
          "Venez découvrir les saveurs d'une cuisine raffinée et élégante dans un décor atypique qui vous fera voyager dans les années 20 et vous amènera au ciel gustative avec ses  créations élaborées."
        ],
        "es": [
          "Venga a descubrir los sabores de una cocina refinada y elegante en un marco atípico que le transportará a los años 20 y le llevará al paraíso gustativo con sus elaboradas creaciones."
        ],
        "nl": [
          "Kom en ontdek de smaken van een verfijnde, elegante keuken in een atypische omgeving die je terugbrengt naar de jaren 1920 en je met zijn uitgebreide creaties in de culinaire hemel brengt."
        ]
      },
