      "dc:description": {
        "de": [
          "Die Stadtverwaltung bietet Ihnen die Möglichkeit, an einer \"Familiensport-Herausforderung\" teilzunehmen.  Haben Sie Spaß und fordern Sie die anderen Teilnehmer in verschiedenen bunten Wettbewerben heraus."
        ],
        "en": [
          "The municipality invites you to take part in a \"Family Sport Challenge\".  Come and have fun and challenge the other participants in a variety of colorful events."
        ],
        "it": [
          "Il Comune vi invita a partecipare alla \"Family Sport Challenge\".  Venite a divertirvi e a sfidare gli altri partecipanti in una serie di eventi colorati."
        ],
        "fr": [
          "La municipalité vous propose de participer à un « Défi sport famille ».  Venez-vous amuser et défier les autres participants lors de différentes épreuves hautes en couleurs."
        ],
        "es": [
          "El ayuntamiento le invita a participar en un \"Desafío deportivo familiar\".  Ven a divertirte y desafía a los demás participantes en una serie de vistosas pruebas."
        ],
        "nl": [
          "De gemeente nodigt je uit om deel te nemen aan een \"Family Sport Challenge\".  Kom plezier maken en daag de andere deelnemers uit in een reeks kleurrijke evenementen."
        ]
      },
