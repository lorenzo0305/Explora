  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/29670621-3b5b-358f-ae75-ac2a4cc4e184",
      "dc:description": {
        "de": [
          "Kaffeestube - Heiße und kalte süße und herzhafte Getränke - Qualitätskaffee- und Teepakete.\n\nGeöffnet von Montag bis Samstag von 8:00 bis 19:30 Uhr und am Sonntag von 9:00 bis 19:00 Uhr.\n\nArt der Kundschaft: 30 Jahre.\n\n "
        ],
        "en": [
          "Coffee lounge - Hot and cold sweet and savoury drinks - Quality coffee and tea packs.\n\nOpen Monday to Saturday 8am to 7:30pm and Sunday 9am to 7pm.\n\nClientele: 30 years old.\n\n "
        ],
        "it": [
          "Coffee lounge - Bevande dolci e salate calde e fredde - Confezioni di caffè e tè di qualità.\n\nAperto dal lunedì al sabato dalle 8.00 alle 19.30 e la domenica dalle 9.00 alle 19.00.\n\nClientela: 30 anni.\n\n "
        ],
        "fr": [
          "Salon de café - Boissons chaudes et froides sucrées et salées - Paquets de café et thés de qualité.\n\nOuvert du lundi au samedi de 8h à 19h30 et le dimanche de 9h à 19h.\n\nType de clientèle : 30 ans.\n\n "
        ],
        "nl": [
          "Koffielounge - Warme en koude zoete en hartige dranken - Koffie- en theepakketten van hoge kwaliteit.\n\nGeopend van maandag tot zaterdag van 8.00 tot 19.30 uur en zondag van 9.00 tot 19.00 uur.\n\nKlantenkring: 30 jaar oud.\n\n "
        ],
        "es": [
          "Cafetería - Bebidas dulces y saladas calientes y frías - Paquetes de café y té de calidad.\n\nAbierto de lunes a sábado de 8.00 a 19.30 y los domingos de 9.00 a 19.00.\n\nClientela: 30 años.\n\n "
        ]
      },
      "@type": [
        "Description"
