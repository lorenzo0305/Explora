  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ed2f95f-80d7-3d5a-98c2-404965bcb8d2",
      "dc:description": {
        "de": [
          "Kirche im Art-déco-Stil aus der Zeit zwischen den beiden Weltkriegen in Wattrelos, die eine traditionelle und gleichzeitig durch ihre Art-déco-Elemente moderne Architektur aufweist.\n\n\nFührungen sind beim Fremdenverkehrsamt von Wattrelos erhältlich"
        ],
        "en": [
          "Art-deco church dating from the interwar period in Wattrelos, featuring both traditional and modern Art-deco architecture.\n\n\nGuided tours available from the Wattrelos Tourist Office"
        ],
        "it": [
          "Chiesa Art-deco risalente al periodo tra le due guerre a Wattrelos, con caratteristiche Art-deco sia tradizionali che moderne.\n\n\nVisite guidate disponibili presso l'Ufficio del Turismo di Wattrelos"
        ],
        "fr": [
          "Église de l'entre-deux-guerres de style Art-déco à Wattrelos présentant une architecture à la fois traditionnelle et moderne par ses éléments Art-déco. \n\n\nVisites guidées disponibles auprès de l'Office de Tourisme de Wattrelos"
        ],
        "es": [
          "Iglesia Art-decó de entreguerras en Wattrelos, con elementos Art-decó tradicionales y modernos.\n\n\nVisitas guiadas disponibles en la Oficina de Turismo de Wattrelos"
        ],
        "nl": [
          "Art-deco kerk uit het interbellum in Wattrelos, met zowel traditionele als moderne Art-deco kenmerken.\n\n\nRondleidingen met gids beschikbaar bij het toeristenbureau van Wattrelos"
        ]
      },
