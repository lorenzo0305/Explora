  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05a18021-0222-37cb-bc8e-55de20ebecbb",
      "dc:description": {
        "de": [
          "Die Mediathek in Bettencourt-Saint-Ouen empfängt Sie :\n- am Mittwoch von 10:00 bis 12:00 Uhr und von 14:00 bis 18:00 Uhr ;\n- am Donnerstag von 15:00 bis 17:00 Uhr ;\n- am Freitag von 16:00 bis 18:00 Uhr ;\n- am Samstag 10.00 bis 12.30 Uhr."
        ],
        "en": [
          "The media library of Bettencourt-Saint-Ouen welcomes you:\n- wednesdays from 10:00 to 12:00 and from 14:00 to 18:00;\n- thursday from 15h00 to 17h00;\n- friday from 16h00 to 18h00;\n- saturday 10:00 am to 12:30 pm."
        ],
        "it": [
          "La mediateca di Bettencourt-Saint-Ouen vi dà il benvenuto:\n- mercoledì dalle 10:00 alle 12:00 e dalle 14:00 alle 18:00;\n- giovedì dalle 15.00 alle 17.00;\n- venerdì dalle 16:00 alle 18:00;\n- il sabato dalle 10.00 alle 12.30."
        ],
        "fr": [
          "La médiathèque de Bettencourt-Saint-Ouen vous accueille :\n- le mercredi de 10h00 à 12h00 et de 14h00 à 18h00 ;\n- le jeudi de 15h00 à 17h00 ;\n- le vendredi de 16h00 à 18h00 ;\n- le samedi 10h00 à 12h30."
        ],
        "es": [
          "La mediateca de Bettencourt-Saint-Ouen le da la bienvenida:\n- los miércoles de 10:00 a 12:00 y de 14:00 a 18:00;\n- jueves de 15 a 17 horas;\n- viernes de 16 a 18 horas;\n- los sábados de 10 a 12.30 horas."
        ],
        "nl": [
          "De mediatheek van Bettencourt-Saint-Ouen heet u welkom:\n- woensdag van 10 tot 12 uur en van 14 tot 18 uur;\n- donderdag van 15.00 tot 17.00 uur;\n- vrijdag van 16.00 tot 18.00 uur;\n- op zaterdag van 10.00 tot 12.30 uur."
        ]
      },
