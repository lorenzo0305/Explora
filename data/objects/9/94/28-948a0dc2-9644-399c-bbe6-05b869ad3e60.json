  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/447565f3-3cc5-3e0f-b897-543bd6864f9f",
      "dc:description": {
        "de": [
          "Trézor des Z'Îles bietet Ihnen eine kulinarische Reise zu den tropischen Inseln. Die mauritischen Gerichte sind würzig und schmackhaft. Deshalb finden Sie diese Geschmäcker in typisch mauritischen Gerichten wie Biriani, Rougail..."
        ],
        "en": [
          "Trézor des Z'Îles takes you on a culinary voyage to the Tropical Islands. Mauritian dishes are spicy and flavorful. That's why you'll find these flavors in typical Mauritian dishes such as biriani, rougail..."
        ],
        "it": [
          "Trézor des Z'Îles vi porta in un viaggio culinario nelle isole tropicali. I piatti mauriziani sono piccanti e saporiti. Ecco perché troverete questi sapori in piatti tipici mauriziani come il biriani, il rougail..."
        ],
        "fr": [
          "Trézor des Z'Îles vous propose un voyage culinaire vers les îles Tropicales. Les plats mauriciens sont épicés et savoureux. C'est pourquoi vous retrouvez ces saveurs à travers des plats typiques mauriciens tels que le biriani, le rougail..."
        ],
        "nl": [
          "Trézor des Z'Îles neemt je mee op een culinaire reis naar de Tropische Eilanden. Mauritiaanse gerechten zijn pittig en smakelijk. Daarom vind je deze smaken terug in typisch Mauritiaanse gerechten zoals biriani, rougail..."
        ],
        "es": [
          "Trézor des Z'Îles le lleva en un viaje culinario a las islas tropicales. Los platos mauricianos son picantes y sabrosos. Por eso encontrará estos sabores en platos típicos mauricianos como el biriani, el rougail..."
        ]
      },
      "@type": [
        "Description"
      ],
