  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8e8134f8-f798-3b07-984a-42c14cb9c454",
      "dc:description": {
        "de": [
          "Le Comptoir des Etomelles ist ein Straßenrestaurant, in dem Sie mit Großzügigkeit bedient werden\nDie Großzügigkeit findet sich auch auf den Tellern mit hausgemachter Küche wieder."
        ],
        "en": [
          "Le Comptoir des Etomelles is a roadside restaurant where you'll be served with generosity\nYou'll also find generosity on the plates, with home cooking."
        ],
        "it": [
          "Le Comptoir des Etomelles è un ristorante di strada dove sarete serviti con generosità\nGenerosità che si ritrova anche nei piatti, con una cucina casalinga."
        ],
        "fr": [
          "Le Comptoir des Etomelles est un restaurant routier où vous serez servis avec générosité \nLa générosité se retrouve également dans les assiettes avec une cuisine maison."
        ],
        "nl": [
          "Le Comptoir des Etomelles is een wegrestaurant waar je met gulheid wordt bediend\nVrijgevigheid vind je ook terug op de borden, met huisgemaakte gerechten."
        ],
        "es": [
          "Le Comptoir des Etomelles es un restaurante de carretera donde le atenderán con generosidad\nLa generosidad también se encuentra en los platos, con cocina casera."
        ]
      },
