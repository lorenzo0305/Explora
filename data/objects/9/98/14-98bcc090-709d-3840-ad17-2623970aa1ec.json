      "dc:description": {
        "de": [
          "Dieses Trainingslager wird mit einem Freundschaftsspiel gegen den TAC FCO am Freitag, den 2. August um 16 Uhr abgeschlossen.\nDas Spiel ist für die Öffentlichkeit zugänglich."
        ],
        "en": [
          "The course will conclude with a friendly match against TAC FCO on Friday August 2 at 4pm.\nMatch open to the public."
        ],
        "it": [
          "Il corso si concluderà con un'amichevole contro il TAC FCO venerdì 2 agosto alle ore 16.00.\nLa partita è aperta al pubblico."
        ],
        "fr": [
          "Ce stage se clôturera par un match amical contre le TAC FCO vendredi 2 août à 16h.\nMatch ouvert au public."
        ],
        "es": [
          "El curso concluirá con un partido amistoso contra el TAC FCO el viernes 2 de agosto a las 16.00 horas.\nEl partido está abierto al público."
        ],
        "nl": [
          "De cursus wordt afgesloten met een vriendschappelijke wedstrijd tegen TAC FCO op vrijdag 2 augustus om 16.00 uur.\nDe wedstrijd is toegankelijk voor het publiek."
        ]
      },
