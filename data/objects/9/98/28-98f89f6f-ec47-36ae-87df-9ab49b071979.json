  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant mit 60 Gedecken\n\nGeöffnet von Montag bis Donnerstag abends von 19:00 bis 21:00 Uhr.\nGenießen Sie Gourmetgerichte im Stil einer Brasserie in einem gemütlichen Rahmen.\nMenü für Kinder\nBar vor Ort"
    ],
    "en": [
      "60-seat hotel restaurant\n\nOpen Monday to Thursday evenings from 7pm to 9pm.\nEnjoy gourmet brasserie-style dishes in a cosy setting.\nChildren's menu\nOn-site bar"
    ],
    "it": [
      "Ristorante dell'hotel da 60 posti\n\nAperto dal lunedì al giovedì sera dalle 19.00 alle 21.00.\nGustate piatti gourmet in stile brasserie in un ambiente accogliente.\nMenu per bambini\nBar in loco"
    ],
    "fr": [
      "Hôtel restaurant de 60 couverts\n\nOuvert du lundi au jeudi soir de 19h à 21h.\nSavourez des plats gourmands de type brasserie dans un cadre chaleureux.\nMenu enfant \nBar sur place"
    ],
    "nl": [
      "Hotel-restaurant met 60 zitplaatsen\n\nGeopend van maandag- tot donderdagavond van 19.00 tot 21.00 uur.\nGeniet van gastronomische gerechten in brasseriestijl in een gezellige omgeving.\nKindermenu\nBar ter plaatse"
    ],
    "es": [
      "Hotel restaurante con 60 plazas\n\nAbierto de lunes a jueves de 19.00 a 21.00 h.\nDisfrute de platos gourmet estilo brasserie en un ambiente acogedor.\nMenú infantil\nBar del hotel"
    ]
  },
