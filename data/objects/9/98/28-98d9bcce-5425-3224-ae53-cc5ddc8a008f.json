  "rdfs:comment": {
    "de": [
      "Um das Schloss aus dem 19. Jahrhundert und seine Nebengebäude herum befindet sich eine weitläufige Landschaftsanlage: Gemüsegarten mit altem Verlauf, Rosengarten, jahrhundertealte Bäume, Stauden..."
    ],
    "en": [
      "Around the XIXth century castle and its outbuildings, a vast landscaped area: vegetable garden with an ancient layout, rose garden, secular trees, perennials..."
    ],
    "it": [
      "Intorno al castello ottocentesco e ai suoi annessi, una vasta area paesaggistica: orto con un antico impianto, roseto, alberi secolari, piante perenni..."
    ],
    "fr": [
      "Autour du château du XIXème et de ses dépendances, un vaste ensemble paysager : jardin potager au tracé ancien, roseraie, arbres séculaires, plantes vivaces..."
    ],
    "nl": [
      "Rond het 19e eeuwse kasteel en zijn bijgebouwen, een uitgestrekt landschap: moestuin met oude aanleg, rozentuin, eeuwenoude bomen, vaste planten..."
    ],
    "es": [
      "Alrededor del castillo del siglo XIX y de sus dependencias, una amplia zona ajardinada: huerto con trazado antiguo, rosaleda, árboles seculares, plantas perennes..."
    ]
  },
