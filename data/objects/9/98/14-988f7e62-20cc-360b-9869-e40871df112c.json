  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/25105297-6c95-3549-b6e5-0a27f3ec9061",
      "dc:description": {
        "de": [
          "Der Belfried ? Kommentierte Besichtigung\nTreffpunkt in der Halle des Rathauses, Place Godefroy de Bouillon\n\nSamstag: 14h, 15h, 16h, 17h\nSonntag: 10 Uhr, 11 Uhr, 14 Uhr, 15 Uhr, 16 Uhr, 17 Uhr\nDauer: 45 min ? begrenzte Zuschauerzahl\nAchtung: zahlreiche Stufen, kein Aufzug!\nEntdecken Sie die Geschichte und die Architektur des Belfrieds (UNESCO-Weltkulturerbe). Panorama vom Belvedere aus.\nTreffpunkt in der Halle des Rathauses, Place Godefroy de Bouillon"
        ],
        "en": [
          "The Belfry ? Guided tour\nMeet in the lobby of the Hôtel de Ville, place Godefroy de Bouillon\n\nSaturday: 2 pm, 3 pm, 4 pm, 5 pm\nSunday: 10am, 11am, 2pm, 3pm, 4pm, 5pm\nDuration: 45 min\nPlease note: many steps, no elevator\nDiscover the history and architecture of the belfry (UNESCO World Heritage Site). Panoramic view from the belvedere.\nMeet in the lobby of the Hôtel de Ville, place Godefroy de Bouillon"
        ],
        "it": [
          "Il Belfry? Visita guidata\nRitrovo nella hall dell'Hôtel de Ville, place Godefroy de Bouillon\n\nSabato: 14.00, 15.00, 16.00, 17.00\nDomenica: 10.00, 11.00, 14.00, 15.00, 16.00, 17.00\nDurata: 45 min\nAttenzione: molti gradini, senza ascensore\nScoprite la storia e l'architettura del campanile (patrimonio mondiale dell'UNESCO). Vista panoramica dal belvedere.\nRitrovo nella hall dell'Hôtel de Ville, place Godefroy de Bouillon"
        ],
        "fr": [
          "Le Beffroi – Visite commentée\nRendez-vous dans le hall de l’Hôtel de Ville, place Godefroy de Bouillon\n\nSamedi : 14h, 15h, 16h, 17h\nDimanche : 10h, 11h, 14h, 15h, 16h, 17h\nDurée : 45 min – jauge limitée\nAttention : nombreuses marches, pas d’ascenseur\nDécouvrez l’histoire et l’architecture du beffroi (Patrimoine mondial UNESCO). Panorama depuis le belvédère.\nRendez-vous dans le hall de l’Hôtel de Ville, place Godefroy de Bouillon"
        ],
        "nl": [
          "Het Belfort ? Rondleiding\nAfspraak in de hal van het Hôtel de Ville, place Godefroy de Bouillon\n\nZaterdag: 14u, 15u, 16u, 17u\nZondag: 10u, 11u, 14u, 15u, 16u, 17u\nDuur: 45 min? beperkte capaciteit\nLet op: veel treden, geen lift\nOntdek de geschiedenis en architectuur van het belfort (UNESCO Werelderfgoed). Panoramisch uitzicht vanaf de belvedère.\nAfspraak in de lobby van het Hôtel de Ville, place Godefroy de Bouillon"
        ],
        "es": [
          "El Campanario ? Visita guiada\nEncuentro en el vestíbulo del Hôtel de Ville, place Godefroy de Bouillon\n\nSábado: 14:00 h, 15:00 h, 16:00 h, 17:00 h\nDomingo: 10:00, 11:00, 14:00, 15:00, 16:00, 17:00\nDuración: 45 min ? aforo limitado\nAtención: muchos escalones, sin ascensor\nDescubra la historia y la arquitectura del campanario (Patrimonio Mundial de la UNESCO). Vista panorámica desde el mirador.\nEncuentro en el vestíbulo del Hôtel de Ville, place Godefroy de Bouillon"
        ]
      },
