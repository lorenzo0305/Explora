  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/100f722b-f327-388a-a6c5-77bc7a8051e4",
      "dc:description": {
        "de": [
          "Erleben Sie ein Konzert eines Quartetts des Orchesters von Douai / Region Hauts-de-France mit Werken von Jacques de la Presles und Paul Paray, die sie während ihrer Zeit an der Front oder in Gefangenschaft komponiert haben."
        ],
        "en": [
          "Attend a concert by a quartet from the Douai / Région Hauts-de-France orchestra, featuring works by Jacques de la Presles and Paul Paray, composed while they were at the front or in captivity."
        ],
        "it": [
          "Assistete a un concerto di un quartetto dell'orchestra della regione di Douai / Hauts-de-France, con opere di Jacques de la Presles e Paul Paray composte mentre erano al fronte o in prigionia."
        ],
        "fr": [
          "Assistez au concert d’un quatuor de l’orchestre de Douai / Région Hauts-de-France autour d'œuvres de Jacques de la Presles et Paul Paray composées alors qu'ils étaient sur le front ou en captivité."
        ],
        "nl": [
          "Woon een concert bij van een kwartet van het orkest van de regio Douai / Hauts-de-France, met werken van Jacques de la Presles en Paul Paray die ze componeerden terwijl ze aan het front waren of in gevangenschap."
        ],
        "es": [
          "Asista a un concierto de un cuarteto de la orquesta de la Región de Douai / Hauts-de-France, con obras de Jacques de la Presles y Paul Paray compuestas mientras estaban en el frente o en cautividad."
        ]
      },
