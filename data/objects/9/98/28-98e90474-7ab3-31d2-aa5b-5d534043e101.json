  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/65187bab-861c-396a-8504-0747a8cd3e7d",
      "dc:description": {
        "de": [
          "Das Volfoni ist eine geschmackliche Reise Richtung Italien! Pizzas, Pasta, Burrata ... Hier ist für jeden Geschmack etwas dabei, von der Vorspeise über die Getränke bis hin zum Dessert!"
        ],
        "en": [
          "Le Volfoni takes you on a gustatory journey to Italy! Pizzas, pasta, burrata... There's something for everyone, from appetizers to drinks and desserts!"
        ],
        "it": [
          "Le Volfoni vi porta in un viaggio gastronomico in Italia! Pizze, pasta, burrata... Ce n'è per tutti i gusti, dagli antipasti ai dolci e alle bevande!"
        ],
        "fr": [
          "Le Volfoni, c'est un voyage gustatif direction l'Italie ! Pizzas, pates, burrata... Il y en a pour tous les goûts, de l'entrée au dessert, en passant par les boissons !"
        ],
        "nl": [
          "Le Volfoni neemt je mee op een culinaire reis naar Italië! Pizza's, pasta, burrata... Er is voor elk wat wils, van voorgerechten tot desserts en drankjes!"
        ],
        "es": [
          "Le Volfoni le lleva de viaje a Italia Pizzas, pasta, burrata... Hay para todos los gustos, desde los entrantes hasta los postres y las bebidas"
        ]
      },
