  "rdfs:comment": {
    "de": [
      "Nach Lens im Jahr 2022 lädt die Agglomeration Lens-Liévin das Video Mapping Festival zu zwei aufeinanderfolgenden Veranstaltungen in zwei Städten der Agglomeration ein: Liévin und Vimy!"
    ],
    "en": [
      "After Lens in 2022, the Lens-Liévin conurbation invites the Video Mapping Festival for 2 events to be discovered one after the other, in 2 towns of the conurbation: Liévin and Vimy!"
    ],
    "it": [
      "Dopo Lens nel 2022, l'agglomerato di Lens-Liévin invita il Video Mapping Festival a 2 eventi, uno dopo l'altro, in 2 città dell'agglomerato: Liévin e Vimy!"
    ],
    "fr": [
      "Après Lens en 2022, l’Agglomération de Lens-Liévin invite le Video Mapping Festival pour 2 événements à découvrir l’un après l’autre, dans 2 villes de l’agglomération : Liévin et Vimy !"
    ],
    "nl": [
      "Na Lens in 2022 nodigt de agglomeratie Lens-Liévin het Video Mapping Festival uit voor 2 opeenvolgende evenementen in 2 steden van de agglomeratie: Liévin en Vimy!"
    ],
    "es": [
      "Después de Lens en 2022, la aglomeración de Lens-Liévin invita al Festival de Video Mapping a dos eventos consecutivos en dos ciudades de la aglomeración: Liévin y Vimy"
    ]
  },
  "rdfs:label": {
