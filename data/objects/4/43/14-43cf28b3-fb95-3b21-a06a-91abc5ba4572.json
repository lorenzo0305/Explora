      "dc:description": {
        "de": [
          "Das Le Chatillon bietet Ihnen jeden Tag frische Produkte direkt aus dem Fischfang in Boulogne, die am Morgen frisch angelandet werden."
        ],
        "en": [
          "Every day, Le Chatillon offers fresh produce directly from the Boulonnais fishery, landed that very morning."
        ],
        "it": [
          "Ogni giorno, Le Chatillon vi offre prodotti freschi direttamente dalla pesca del Boulonnais, sbarcati la mattina stessa."
        ],
        "fr": [
          "Le Chatillon vous propose chaque jour des produits frais directement issus de la pêche boulonnaise, fraîchement débarqués le matin même."
        ],
        "es": [
          "Todos los días, Le Chatillon le ofrece productos frescos directamente de la pesca del Boulonnais, desembarcados esa misma mañana."
        ],
        "nl": [
          "Le Chatillon biedt je elke dag verse producten rechtstreeks van de visserij uit Boulonnais, die diezelfde ochtend nog aan land worden gebracht."
        ]
      },
