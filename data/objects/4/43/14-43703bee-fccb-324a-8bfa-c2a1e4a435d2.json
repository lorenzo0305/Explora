      "dc:description": {
        "de": [
          "Die Friterie Desvroise empfängt Sie mit ihrem freundlichen und qualifizierten Personal und bietet Ihnen eine schnelle, typische und freundliche Verpflegung. Qualitätsprodukte."
        ],
        "en": [
          "La Friterie Desvroise welcomes you with its warm and qualified staff, ensuring a fast, typical and friendly catering. Quality products."
        ],
        "it": [
          "La Friterie Desvroise vi accoglie con il suo personale cordiale e qualificato, offrendo una cucina veloce, tipica e cordiale. Prodotti di qualità."
        ],
        "fr": [
          "La Friterie Desvroise vous accueille avec son personnel chaleureux et qualifié, assurent une restauration rapide, typique et conviviale. Produits de qualité."
        ],
        "es": [
          "La Friterie Desvroise le da la bienvenida con su personal cálido y cualificado, proporcionando una comida rápida, típica y amable. Productos de calidad."
        ],
        "nl": [
          "De Friterie Desvroise verwelkomt u met zijn warme en gekwalificeerde personeel en biedt u snel, typisch en vriendelijk eten. Kwaliteitsproducten."
        ]
      },
