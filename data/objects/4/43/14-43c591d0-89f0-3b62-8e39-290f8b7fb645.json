  "rdfs:comment": {
    "de": [
      "Mit Romeo Mivekannin, Annabelle Ténèze, Direktorin des Louvre-Lens und Anne Lafont, Kunsthistorikerin, Studiendirektorin an der École des hautes études en sciences sociales oder Pierre Singaravélou, Historiker, Universitätsprofessor für Zeitgeschichte an der Universität Paris 1 Panthéon-Sorbonne."
    ],
    "en": [
      "With Roméo Mivekannin, Annabelle Ténèze, Director of Louvre-Lens and Anne Lafont, art historian, Director of Studies at the École des hautes études en sciences sociales or Pierre Singaravélou, historian, University Professor of Contemporary History at Paris 1 Panthéon-Sorbonne University."
    ],
    "it": [
      "Con Roméo Mivekannin, Annabelle Ténèze, direttrice del Louvre-Lens e Anne Lafont, storica dell'arte, direttrice degli studi presso l'École des hautes études en sciences sociales o Pierre Singaravélou, storico, professore di storia contemporanea all'Università di Parigi 1 Panthéon-Sorbonne."
    ],
    "fr": [
      "Avec Roméo Mivekannin, Annabelle Ténèze, directrice du Louvre-Lens et Anne Lafont, historienne de l’art, directrice d'études à l’École des hautes études en sciences sociales ou Pierre Singaravélou, historien, professeur des universités en histoire contemporaine à l’université Paris 1 Panthéon-Sorbonne."
    ],
    "nl": [
      "Met Roméo Mivekannin, Annabelle Ténèze, Directeur van het Louvre-Lens en Anne Lafont, kunsthistoricus, Directeur Studies aan de École des hautes études en sciences sociales of Pierre Singaravélou, historicus, Professor Hedendaagse Geschiedenis aan de Universiteit van Parijs 1 Panthéon-Sorbonne."
    ],
    "es": [
      "Con Roméo Mivekannin, Annabelle Ténèze, Directora del Louvre-Lens y Anne Lafont, historiadora del arte, Directora de Estudios en la École des hautes études en sciences sociales o Pierre Singaravélou, historiador, Profesor de Historia Contemporánea en la Universidad de París 1 Panthéon-Sorbonne."
    ]
  },
