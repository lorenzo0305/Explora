  "rdfs:comment": {
    "de": [
      "Das Relais du Vexin in Chaumont-en-Vexin bietet Ihnen den Verleih von Fahrrädern mit elektrischer Unterstützung und demnächst auch: Fahrradreparaturen und Fahrradverkauf."
    ],
    "en": [
      "The relay of Vexin in Chaumont-en-Vexin proposes you the rent of electric bikes and soon: repair of bikes, sale of bikes."
    ],
    "it": [
      "Il Relais du Vexin a Chaumont-en-Vexin offre il noleggio di biciclette a pedalata assistita e presto offrirà riparazioni e vendita di biciclette."
    ],
    "fr": [
      "Le relais du Vexin à Chaumont-en-Vexin vous propose  la location de vélos à assistance électrique et prochainement : réparation de vélos, vente de vélos."
    ],
    "nl": [
      "Het Relais du Vexin in Chaumont-en-Vexin verhuurt elektrisch ondersteunde fietsen en zal binnenkort ook fietsreparaties en -verkoop aanbieden."
    ],
    "es": [
      "El Relais du Vexin, en Chaumont-en-Vexin, ofrece alquiler de bicicletas con asistencia eléctrica y pronto ofrecerá reparación y venta de bicicletas."
    ]
