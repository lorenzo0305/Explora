  "rdfs:comment": {
    "de": [
      "Warm Up des Festivals Les Enchanteurs?  \nBarcella ist ein untypischer, sonniger Künstler, ein moderner Poet, der von Wasser und Kühnheit nur so strotzt, und der zu den einfallsreichsten Virtuosen seiner Generation gehört."
    ],
    "en": [
      "Warm Up for Les Enchanteurs Festival  \nAn atypical, sunny artist, a modern poet dripping with living water and audacity, Barcella is one of the most inventive virtuosos of his generation."
    ],
    "it": [
      "Riscaldamento per il festival Les Enchanteurs  \nArtista atipico e solare, poeta moderno che gronda acqua viva e audacia, Barcella è uno dei virtuosi più inventivi della sua generazione."
    ],
    "fr": [
      "Warm Up du festival “Les Enchanteurs”  \nArtiste atypique et solaire, poète moderne ruisselant d’eau vive et d’audace, Barcella «conte» parmi les virtuoses les plus inventifs de sa génération."
    ],
    "nl": [
      "Warming-up voor festival Les Enchanteurs  \nBarcella is een atypische en zonnige artiest, een moderne dichter die druipt van het levende water en durf. Hij is een van de meest inventieve virtuozen van zijn generatie."
    ],
    "es": [
      "Calentamiento para el festival Les Enchanteurs  \nArtista atípico y soleado, poeta moderno que gotea agua viva y audacia, Barcella es uno de los virtuosos más inventivos de su generación."
    ]
  },
