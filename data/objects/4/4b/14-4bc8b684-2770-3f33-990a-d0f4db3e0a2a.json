  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6e7ba77b-3fbc-3f6b-be06-e55b3b57c514",
      "dc:description": {
        "de": [
          "20 KM LANGER MOUNTAINBIKE-WEG - 2,5 STUNDEN\nSTART HINTER DEM KERAMIKMUSEUM\nBRAUNE MARKIERUNG MIT DER ZAHL 2\n\nFinden Sie den Verlauf der Strecke in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "20 KM MOUNTAIN BIKE TRAIL - 2 H 30\nSTART BEHIND THE CERAMICS MUSEUM\nBROWN MARKINGS WITH NUMBER 2\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "20 KM DI PERCORSO IN MOUNTAIN BIKE - 2 H 30\nINIZIA DIETRO IL MUSEO DELLA CERAMICA\nCONTRASSEGNATO IN MARRONE CON IL NUMERO 2\n\nPotete trovare il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER  VTT  DE 20 KM - 2 H 30\nDEPART DERRIERE LE MUSEE DE LA CERAMIQUE\nBALISAGE EN MARRON AVEC LE CHIFFRE 2\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA EN BICICLETA DE MONTAÑA DE 20 KM - 2 H 30\nCOMIENZA DETRÁS DEL MUSEO DE CERÁMICA\nMARCADO EN MARRÓN CON EL NÚMERO 2\n\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "20 KM MOUNTAINBIKEROUTE - 2 H 30\nSTART ACHTER HET KERAMIEKMUSEUM\nGEMARKEERD IN BRUIN MET HET NUMMER 2\n\nJe kunt de route vinden op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
      "@type": [
        "Description"
      ],
