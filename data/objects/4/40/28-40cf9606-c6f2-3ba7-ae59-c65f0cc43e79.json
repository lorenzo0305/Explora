  "rdfs:comment": {
    "de": [
      "In diesem avantgardistischen Ort ist die Küche zeitgemäß, einfach und anspruchsvoll zugleich. Die Speisekarte wird je nach Jahreszeit erneuert."
    ],
    "en": [
      "In this avant-garde place, the cuisine is contemporary, simple and sophisticated at the same time. The menu is renewed according to the seasons."
    ],
    "it": [
      "In questo locale all'avanguardia, la cucina è contemporanea, semplice e sofisticata allo stesso tempo. Il menu viene rinnovato in base alle stagioni."
    ],
    "fr": [
      "Dans ce lieu avant-gardiste, la cuisine se veut contemporaine, simple et sophistiquée à la fois. La carte est renouvelée au fil des saisons."
    ],
    "nl": [
