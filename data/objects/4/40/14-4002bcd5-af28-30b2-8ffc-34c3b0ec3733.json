  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1e28dc70-46ea-3584-bee4-2b390b4a88c3",
      "dc:description": {
        "de": [
          "Zeremonie am 11. November\n- 11.00 Uhr: Denkmal für die Gefallenen\nKranzniederlegung durch Monsieur Le Maire & die Anciens Combattants (Kriegsveteranen)\nAufstellung der Parade, um sich zum Friedhof zu begeben\nBritisches Denkmal\nNiederlegung der Kränze\nStädtische Harmonie\nGrab von Oberst Mac Craë\nLesung des Gedichts \"Les Coquelicots\" (Die Mohnblumen) auf Englisch und Französisch durch die Schulkinder\nHarmonie Municiplae \"O Canada\" (Kanadische Hymne)"
        ],
        "en": [
          "November 11 Ceremony\n- 11:00: Monument aux morts\nLaying of wreaths by the Mayor & Veterans\nFormation of the parade to the Cemetery\nBritish Monument\nLaying of wreaths\nHarmonie Municipale\nTomb of Colonel Mac Craë\nReading of the poem \"Les Coquelicots\" in English and French by schoolchildren\nHarmonie Municiplae \"O Canada\" (Canadian anthem)"
        ],
        "it": [
          "11 novembre cerimonia\n- 11:00 : Monumento ai morti\nDeposizione di corone da parte del Sindaco e dei veterani\nFormazione del corteo verso il Cimitero\nMonumento britannico\nDeposizione delle corone\nBanda municipale\nTomba del colonnello Mac Craë\nLettura del poema \"Les Coquelicots\" in inglese e francese da parte dei bambini delle scuole\nBanda municipale \"O Canada\" (inno canadese)"
        ],
        "fr": [
          "Cérémonie du  11 novembre \n- 11 h 00  : Monument aux morts \nDépôt de Gerbes par Monsieur Le Maire & les Anciens Combattants \nFormation du défilé pour se rendre au Cimetière \nMonument britannique \nDépôt de gerbes \nHarmonie Municipale\nTombe du Colonel Mac Craë \nLecture du Poème \"Les Coquelicots\" en Anglais et en Français par les enfants des écoles \nHarmonie Municiplae \"O Canada\" (Hymne canadien)"
        ],
        "es": [
          "Ceremonia del 11 de noviembre\n- 11:00 : Monument aux morts\nColocación de coronas por el alcalde y los veteranos\nFormación del desfile hacia el Cementerio\nMonumento británico\nColocación de coronas\nBanda Municipal\nTumba del Coronel Mac Craë\nLectura del poema \"Les Coquelicots\" en inglés y francés por escolares\nBanda Municipal \"O Canada\" (Himno de Canadá)"
        ],
        "nl": [
          "11 november ceremonie\n- 11:00 : Monument aux morts\nKranslegging door de burgemeester en veteranen\nOptocht naar de begraafplaats\nBrits Monument\nKranslegging\nGemeentelijke muziekkapel\nGraf van kolonel Mac Craë\nVoorlezen van het gedicht \"Les Coquelicots\" in het Engels en Frans door schoolkinderen\nGemeenteband \"O Canada\" (Canadees volkslied)"
        ]
      },
