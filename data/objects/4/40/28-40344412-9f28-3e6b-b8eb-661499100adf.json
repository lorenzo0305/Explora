  "rdfs:comment": {
    "de": [
      "In Bellicourt-Riqueval wurde das amerikanische Denkmal vom Bundesstaat Tennessee errichtet. Es ehrt die Soldaten aus Tennessee der 59. und 60. Brigade und der 30. Division der US-Armee, die am 29. September 1918 die Hindenburg-Linie durchbrachen."
    ],
    "en": [
      "At Bellicourt-Riqueval, the American monument was erected by the State of Tennessee. It pays tribute to the Tennessee soldiers of the 59th and 60th Brigades and the 30th Division of the American Army who broke the Hindenburg Line on September 29, 1918."
    ],
    "it": [
      "A Bellicourt-Riqueval, il monumento americano è stato eretto dallo Stato del Tennessee. Onora i soldati del Tennessee delle 59esime e 60esime brigate e della 30esima divisione dell'esercito statunitense, che il 29 settembre 1918 hanno infranto la linea di Hindenburg."
    ],
    "fr": [
      "À Bellicourt-Riqueval, le monument américain a été érigé par l'Etat du Tennessee. Il rend hommage aux soldats du Tennessee des 59ème et 60ème brigades et de la 30ème division de l'armée américaine qui ont brisé la ligne Hindenburg le 29 septembre 1918."
    ],
    "nl": [
      "In Bellicourt-Riqueval werd het Amerikaanse monument opgericht door de staat Tennessee. Het eert de Tennessee soldaten van de 59e en 60e Brigades en de 30e Divisie van het Amerikaanse leger die op 29 september 1918 de Hindenburglinie doorbraken."
    ],
    "es": [
      "En Bellicourt-Riqueval, el Estado de Tennessee erigió el monumento americano. Rinde homenaje a los soldados de Tennessee de las brigadas 59 y 60 y de la 30ª división del ejército estadounidense que rompieron la Línea Hindenburg el 29 de septiembre de 1918."
    ]
  },
  "rdfs:label": {
