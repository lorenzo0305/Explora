  "rdfs:comment": {
    "de": [
      "Cesaria Evoras plötzlicher Tod am 17. Dezember 2011 löste große Emotionen unter ihren Fans aus, die sich 2012 zu Tausenden versammelten, um ihr Andenken mit denkwürdigen Konzerten zu ehren, unter anderem in Toulouse, Lissabon, Amsterdam und Paris."
    ],
    "en": [
      "Cesaria Evora's sudden death on December 17, 2011 sparked great emotion among her fans, who gathered in their thousands in 2012 to honor her memory at memorable concerts in Toulouse, Lisbon, Amsterdam and Paris."
    ],
    "it": [
      "La morte improvvisa di Cesaria Evora, avvenuta il 17 dicembre 2011, ha suscitato grande scalpore tra i suoi fan, che nel 2012 si sono riuniti a migliaia per onorare la sua memoria in occasione di memorabili concerti a Tolosa, Lisbona, Amsterdam e Parigi."
    ],
    "fr": [
      "La disparition soudaine de Cesaria Evora le 17 décembre 2011 suscita une grande émotion parmi ses fans qui se réunirent par milliers, en 2012, pour honorer sa mémoire lors de concerts mémorables, notamment à Toulouse, Lisbonne, Amsterdam et Paris."
    ],
    "es": [
      "La repentina muerte de Cesaria Evora el 17 de diciembre de 2011 causó conmoción entre sus fans, que se reunieron por miles en 2012 para honrar su memoria en memorables conciertos en Toulouse, Lisboa, Ámsterdam y París."
    ],
    "nl": [
      "Cesaria Evora's plotselinge dood op 17 december 2011 veroorzaakte opschudding onder haar fans, die in 2012 met duizenden tegelijk bijeenkwamen om haar te eren tijdens gedenkwaardige concerten in Toulouse, Lissabon, Amsterdam en Parijs."
    ]
  },
