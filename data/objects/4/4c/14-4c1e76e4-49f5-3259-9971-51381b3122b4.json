  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/57bd68e1-baca-3230-aac2-985e711649d6",
      "dc:description": {
        "de": [
          "Der Mont Saint Frieux liegt in Dannes und besteht aus Dünen, die auf einen Kreidehügel gedrückt werden.\nDer Gipfel des Mont Saint Frieux ist 152 Meter hoch und bietet einen außergewöhnlichen Ausblick."
        ],
        "en": [
          "Located in Dannes, the Mont Saint Frieux is made up of dunes set on a chalky hillock.\nThe summit of Mont Saint Frieux reaches 152 meters and offers an exceptional view."
        ],
        "it": [
          "Situato a Dannes, il Mont Saint Frieux è costituito da dune incastonate su una collinetta gessosa.\nLa cima del Mont Saint Frieux raggiunge i 152 metri e offre una vista eccezionale."
        ],
        "fr": [
          "Situé à Dannes, le Mont Saint Frieux est constitué de dunes plaquées sur une butte crayeuse.\nLe sommet du Mont Saint Frieux culmine à 152 mètres et offre une vue exceptionelle."
        ],
        "es": [
          "Situado en Dannes, el Monte Saint Frieux está formado por dunas situadas en una colina calcárea.\nLa cima del Monte Saint Frieux alcanza los 152 metros y ofrece una vista excepcional."
        ],
        "nl": [
          "De Mont Saint Frieux, gelegen in Dannes, bestaat uit duinen op een krijtachtige heuvel.\nDe top van de Mont Saint Frieux bereikt 152 meter en biedt een uitzonderlijk uitzicht."
        ]
      },
