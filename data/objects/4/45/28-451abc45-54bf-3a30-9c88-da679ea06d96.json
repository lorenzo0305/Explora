  "rdfs:comment": {
    "de": [
      "Der Parc du Marquenterre liegt im Herzen des nationalen Naturschutzgebiets der Somme-Bucht. Dieses 200 ha große Schutzgebiet ist seit 40 Jahren eine Hochburg der Ornithologie in Europa und ideal für Naturbeobachtungen."
    ],
    "en": [
      "The Parc du Marquenterre is located in the heart of the Baie de Somme National Nature Reserve. This protected area of 200 ha has been for 40 years a mecca for ornithology in Europe, ideal for observing nature."
    ],
    "it": [
      "Il Parco Marquenterre si trova nel cuore della Riserva Naturale Nazionale della Baie de Somme. Quest'area protetta di 200 ettari è da 40 anni una mecca dell'ornitologia in Europa, ideale per l'osservazione della natura."
    ],
    "fr": [
      "Le parc du Marquenterre se situe au cœur de la Réserve Naturelle Nationale de la Baie de Somme. Cet espace protégé de 200 ha est depuis 40 ans un haut lieu de l’ornithologie en Europe, idéal pour observer la nature."
    ],
    "nl": [
      "Het park van Marquenterre ligt in het hart van het Nationaal Natuurreservaat van de Baie de Somme. Dit 200 hectare grote beschermde gebied is al 40 jaar een mekka voor ornithologie in Europa, ideaal voor natuurwaarneming."
    ],
    "es": [
      "El Parque del Marquenterre está situado en el corazón de la Reserva Natural Nacional de la Bahía de Somme. Esta zona protegida de 200 hectáreas es desde hace 40 años la meca de la ornitología en Europa, ideal para la observación de la naturaleza."
    ]
  },
