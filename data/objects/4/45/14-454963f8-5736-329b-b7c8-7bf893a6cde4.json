  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3416fa88-282d-354a-bfb8-756db492cd3b",
      "dc:description": {
        "de": [
          "Les clefs du château junior (Ab 7 Jahren) - Begleiteter Rundgang\nIn Begleitung des Zeitmeisters beobachten Sie die Spuren der einzelnen Epochen, um die Geschichte des Schlosses zu rekonstruieren.\nSamstag und Sonntag um 16:30 Uhr\nKostenlos - Reservierung empfohlen - Begrenzte Teilnehmerzahl"
        ],
        "en": [
          "Les clefs du château junior (From age 7) - Guided tour\nIn the company of the master of time, observe the traces of each era to reconstruct the castle?s history.\nSaturday and Sunday at 4:30pm\nFree - Reservations recommended - Limited capacity"
        ],
        "it": [
          "Les clefs du château junior (dai 7 anni) - Visita guidata\nIn compagnia del maestro del tempo, osservate le tracce di ogni epoca per ricostruire la storia del castello.\nSabato e domenica alle 16.30\nGratuito - Si consiglia la prenotazione - Capacità limitata"
        ],
        "fr": [
          "Les clefs du château junior (Dès 7 ans) - Visite accompagnée\nEn compagnie du maître du temps observez les traces de chaque époque pour reconstituer l’histoire du château.\nSamedi et dimanche à 16h30\nGratuit - Réservation conseillée - Jauge limitée"
        ],
        "nl": [
          "Les clefs du château junior (Vanaf 7 jaar) - Rondleiding met gids\nObserveer in gezelschap van de meester van de tijd de sporen van elk tijdperk om de geschiedenis van het kasteel te reconstrueren.\nZaterdag en zondag om 16.30 uur\nGratis - Reserveren aanbevolen - Beperkte capaciteit"
        ],
        "es": [
          "Les clefs du château junior (A partir de 7 años) - Visita guiada\nEn compañía del maestro del tiempo, observe las huellas de cada época para reconstruir la historia del castillo.\nSábado y domingo a las 16.30 h\nGratuito - Se recomienda reservar - Aforo limitado"
        ]
      },
      "@type": [
        "Description"
