  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/353a0b0c-f1eb-300a-9d15-34c23ca1bfed",
      "dc:description": {
        "de": [
          "Lens Philatélique, das Comité des sages (Abteilung Geschichte von Lens) und der Verein Fosse 13 bis Félix-Bollaert laden Sie in das Gewerkschaftshaus ein, um das 170-jährige Bestehen der Minengesellschaft von Lens zu feiern, die die Geschichte, die Wirtschaft und die Landschaft des Bergbaus für immer geprägt hat."
        ],
        "en": [
          "Lens Philatelic, the committee of wise men (history section of Lens) and the association Fosse 13 bis Félix-Bollaert invite you to the Maison syndicale to celebrate the 170 years of the mining company of Lens, which has forever marked the history, the economy and the mining landscape."
        ],
        "it": [
          "Lens Philatélique, il Comité des Sages (sezione storica di Lens) e l'associazione Fosse 13 bis Félix-Bollaert vi invitano alla Maison Syndicale per celebrare il 170° anniversario della Société des Mines de Lens, che ha lasciato un segno indelebile nella storia, nell'economia e nel paesaggio minerario."
        ],
        "fr": [
          "Lens Philatélique, le comité des sages (section histoire de Lens) et l'association Fosse 13 bis Félix-Bollaert vous invitent à la Maison syndicale pour fêter les 170 ans de la société des mines de Lens, qui a marqué à jamais l'histoire, l'économie et le paysage minier."
        ],
        "nl": [
          "Lens Philatélique, het Comité des Sages (afdeling geschiedenis van Lens) en de vereniging Fosse 13 bis Félix-Bollaert nodigen u uit in het Maison Syndicale om de 170e verjaardag te vieren van de Société des Mines de Lens, die een onuitwisbare stempel heeft gedrukt op de geschiedenis, de economie en het mijnlandschap."
        ],
        "es": [
          "Lens Philatélique, el Comité des Sages (sección de historia de Lens) y la asociación Fosse 13 bis Félix-Bollaert le invitan a la Maison Syndicale para celebrar el 170 aniversario de la Société des Mines de Lens, que ha dejado una huella indeleble en la historia, la economía y el paisaje minero."
        ]
      },
