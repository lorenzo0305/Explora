  "rdfs:comment": {
    "de": [
      "Im Herzen des Bois du Roi gelegen, beherbergt der Pierre Glissoire auf einer Fläche von 15 ha bemerkenswerte natürliche Lebensräume wie trockene Heideflächen und säureliebende Rasenflächen. Der Pfad, der durch den Kiefernwald führt, und das Vorhandensein eines Sandsteinchaos ziehen viele Besucher an."
    ],
    "en": [
      "Situated in the heart of the Bois du Roi, the Pierre Glissoire is home to remarkable natural environments, such as dry moors and acidophilic lawns, on a surface area of 15ha. The path that runs under the pine forest and the presence of a chaos of sandstone attracts many visitors."
    ],
    "it": [
      "Inserito nel cuore del Bois du Roi, il Pierre Glissoire ospita 15 ettari di ambienti naturali notevoli, come brughiere secche e praterie acidofile. Il sentiero che corre sotto la pineta e la presenza di un caos di arenaria attirano molti visitatori."
    ],
    "fr": [
      "Insérée au cœur du Bois du Roi, la Pierre Glissoire accueille sur une surface de 15ha des milieux naturels remarquables, comme les landes sèches et les pelouses acidophiles. Le sentier qui chemine sous la pinède et la présence d'un chaos de grés attire de nombreux visiteurs."
    ],
    "es": [
      "Situado en el corazón del Bois du Roi, el Pierre Glissoire ocupa una superficie de 15 hectáreas y alberga entornos naturales notables, como páramos secos y praderas acidófilas. El sendero que discurre bajo el pinar y la presencia de un caos de arenisca atraen a muchos visitantes."
    ],
    "nl": [
      "De Pierre Glissoire, gelegen in het hart van het Bois du Roi, beslaat een oppervlakte van 15 hectare en herbergt opmerkelijke natuurlijke milieus, zoals droge heide en zure graslanden. Het pad dat onder het dennenbos doorloopt en de aanwezigheid van een zandstenen chaos trekt veel bezoekers."
    ]
  },
