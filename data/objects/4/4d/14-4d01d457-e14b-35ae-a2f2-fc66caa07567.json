  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50fa0bdf-0d0c-3530-b2c9-29bdedbe38d7",
      "dc:description": {
        "de": [
          "Eine Geschichte von Feen und Hexen..., die die Halde, ihre Geschichte und ihren natürlichen Reichtum durch ein Spiel mit den Sinnen entdecken lässt. Verwendung von natürlichen Pinseln und pflanzlichen Farben."
        ],
        "en": [
          "A story of fairies and witches... that lets you discover the terril, its history and its natural riches, playing with your senses. Using natural brushes and vegetable paints."
        ],
        "it": [
          "Una storia di fate e streghe... per farvi scoprire il cumulo di scorie, la sua storia e le sue ricchezze naturali, giocando con i sensi. Utilizzando pennelli naturali e colori vegetali."
        ],
        "fr": [
          "Une histoire de fées et de sorcières... qui fait découvrir le terril, son histoire et ses richesses naturelles en jouant avec les sens. Utilisation de pinceaux naturels et de peintures végétales."
        ],
        "es": [
          "Una historia de hadas y brujas... para descubrir el escorial, su historia y sus riquezas naturales, jugando con los sentidos. Con pinceles naturales y pinturas vegetales."
        ],
        "nl": [
          "Een verhaal over feeën en heksen... om je de terril, zijn geschiedenis en zijn natuurlijke rijkdommen te laten ontdekken, terwijl je speelt met je zintuigen. Met natuurlijke penselen en plantaardige verf."
        ]
      },
      "@type": [
        "Description"
