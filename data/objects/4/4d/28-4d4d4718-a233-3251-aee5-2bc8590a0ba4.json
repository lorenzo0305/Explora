  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6dd25c4f-42ff-303b-8435-23d0d7156728",
      "dc:description": {
        "de": [
          "Kindergarten auf der Esplanade, der Ihnen einen Blick auf die Belle Epoque-Villen und den Strand bietet.\nSpiele und Geräte für Kinder, die von ihren Eltern begleitet und beaufsichtigt werden."
        ],
        "en": [
          "Children's playground on the Esplanade overlooking the belle époque villas and the beach.\nGames and equipment available for children accompanied and supervised by their parents."
        ],
        "it": [
          "Il parco giochi per bambini sull'Esplanade si affaccia sulle ville belle époque e sulla spiaggia.\nGiochi e attrezzature a disposizione dei bambini accompagnati e sorvegliati dai genitori."
        ],
        "fr": [
          "Jardin d'enfants sur l'Esplanade qui vous offre une vue sur les villas belles époque et la plage.\nJeux et agrès mis à la disposition des enfants accompagnés et surveillés par leurs parents."
        ],
        "es": [
          "El parque infantil de la Explanada domina las villas de la belle époque y la playa.\nJuegos y material a disposición de los niños acompañados y supervisados por sus padres."
        ],
        "nl": [
          "De kinderspeelplaats op de Esplanade kijkt uit over de villa's uit de belle époque en het strand.\nEr zijn spelletjes en toestellen beschikbaar voor kinderen onder begeleiding van hun ouders."
        ]
      },
