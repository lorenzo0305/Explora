  "rdfs:comment": {
    "de": [
      "Die Enigmamiens-Schatzsuchen sind eine Mischung aus Sightseeing und Escape Game. Sie ermöglichen es, Sightseeing auf eine andere Art und Weise zu betreiben und ungewöhnliche Orte in Amiens zu entdecken."
    ],
    "en": [
      "The Enigmamien treasure hunts are halfway between sightseeing and escape game, they allow to make tourism differently and to discover unusual places of Amiens."
    ],
    "it": [
      "Le cacce al tesoro di Enigmamiens sono a metà strada tra la visita turistica e l'escape game, permettono di fare turismo in modo diverso e di scoprire luoghi insoliti di Amiens."
    ],
    "fr": [
      "Les chasses au trésor Enigmamiens sont à mi-chemin entre la visite touristique et l'escape game, elles permettent de faire du tourisme autrement et de découvrir des lieux insolites d'Amiens."
    ],
    "es": [
      "Las cazas del tesoro Enigmamiens están a medio camino entre la visita turística y el juego de escape, permiten hacer turismo de una manera diferente y descubrir lugares insólitos de Amiens."
    ],
    "nl": [
      "De speurtochten van Enigmamiens houden het midden tussen een toeristisch bezoek en een ontsnappingsspel, ze laten u toe op een andere manier aan toerisme te doen en ongewone plaatsen in Amiens te ontdekken."
    ]
  },
