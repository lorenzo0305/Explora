  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/97d6413a-edb4-3f6d-8f0b-8d37079b335d",
      "dc:description": {
        "de": [
          "Ducasse de Zoteux, organisiert von der Festkommission und Zoteux en Fête mit Beteiligung der Vereine\nTreffpunkt am Sonntag, den 6. Juli ab 7 Uhr mit dem Trödelmarkt\nInformationen und Reservierungen: 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ],
        "en": [
          "Ducasse de Zoteux organized by the Commission des Fêtes and Zoteux en Fête with the participation of associations\nSee you on Sunday, July 6 from 7 a.m. with the flea market\nInformation and reservations: 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ],
        "it": [
          "Ducasse de Zoteux organizzata dalla Commission des Fêtes e Zoteux en Fête con la partecipazione delle associazioni\nAppuntamento domenica 6 luglio dalle 7 del mattino con il mercatino delle pulci\nInformazioni e prenotazioni: 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ],
        "fr": [
          "Ducasse de Zoteux organisée par la Commission des Fêtes et Zoteux en Fête avec la participation des associations\nRendez-vous le dimanche 6 juillet à partir de 7h avec la brocante\nInformations et réservations : 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ],
        "es": [
          "Ducasse de Zoteux organizada por la Comisión de Fiestas y Zoteux en Fête con la participación de asociaciones\nCita el domingo 6 de julio a partir de las 7 h con el mercadillo\nInformación y reservas: 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ],
        "nl": [
          "Ducasse de Zoteux georganiseerd door de Commission des Fêtes en Zoteux en Fête met de deelname van verenigingen\nAfspraak op zondag 6 juli vanaf 7 uur met de rommelmarkt\nInformatie en reserveringen: 03 21 86 11 23 / 06 21 18 25 84 / 06 59 27 84 11 / 06 31 87 44 67"
        ]
      },
