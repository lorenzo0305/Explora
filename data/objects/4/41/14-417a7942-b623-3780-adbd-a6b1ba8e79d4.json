  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3449fd2-4610-3bf0-b6cf-e2c07871bf5e",
      "dc:description": {
        "de": [
          "Ganzjährig geöffnet.ca. 2-stündige Animation.Die Animationen für alle Altersgruppen sind kostenlos.Zugang nur für Fußgänger. Geführte Ausflüge im Frühling und Herbst. Ausstellungen im Maison de la Forêt zum Thema Natur."
        ],
        "en": [
          "Open all year round.2 hours of activities for the general public, free of charge.pedestrian access only. Guided tours in spring and autumn. Exhibitions at the Maison de la Forêt on the theme of Nature."
        ],
        "it": [
          "Aperto tutto l'anno.Visita guidata di 2 ore.Gratuita per il pubblico.Accesso solo pedonale. Visite guidate in primavera e in autunno. Mostre alla Maison de la Forêt sul tema della natura."
        ],
        "fr": [
          "Ouvert toute l'année.Animation d'environ 2h.Les animations tout public sont gratuites.Accès réservé aux piétons. Sortie guidée au printemps et en automne. Expositions à la Maison de la Forêt sur le thème de la Nature."
        ],
        "nl": [
          "Het hele jaar geopend.Rondleiding van 2 uur.Gratis voor het grote publiek.Alleen toegankelijk voor voetgangers. Rondleidingen in voor- en najaar. Tentoonstellingen in het Maison de la Forêt over het thema natuur."
        ],
        "es": [
          "Abierto todo el año. Visita guiada de 2 horas. Visitas guiadas en primavera y otoño. Exposiciones en la Maison de la Forêt sobre el tema de la naturaleza."
        ]
      },
