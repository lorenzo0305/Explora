  "rdfs:comment": {
    "de": [
      "Die Kapelle Carlier?Manesse ist eine Kapelle mit achteckigem Grundriss, die überwiegend aus Backstein gebaut ist. Sie liegt etwas zurückversetzt und überhängend von der Straße am Rande der Felder. Eine Treppe ermöglicht den Zugang."
    ],
    "en": [
      "The Carlier-Manesse chapel is an octagonal chapel built mainly of brick. It is set back slightly from the road, on the edge of a field. A staircase provides access."
    ],
    "it": [
      "La cappella Carlier-Manesse è una cappella ottagonale costruita principalmente in mattoni. È leggermente arretrata e sovrasta la strada, ai margini dei campi. Vi si accede tramite una scala."
    ],
    "fr": [
      "La chapelle Carlier−Manesse est une chapelle de plan octogonal majoritairement en brique. Elle se trouve en léger retrait et surplomb de la route, en bord de champs. Un escalier en permet l'accès."
    ],
    "es": [
      "La capilla Carlier-Manesse es una capilla octogonal construida principalmente en ladrillo. Está ligeramente retranqueada y sobresale de la carretera, al borde de los campos. Se accede a ella por una escalera."
    ],
    "nl": [
      "De kapel van Carlier-Manesse is een achthoekige kapel die voornamelijk uit baksteen is opgetrokken. Ze ligt iets naar achteren en hangt over de weg, aan de rand van de velden. Een trap biedt toegang."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Chapelle Carlier Manesse"
    ]
  },
