  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d7bf92e7-8a7e-3503-9dfd-a82bdee43294",
      "dc:description": {
        "de": [
          "Zeitgenössischer Landschaftspark, der das Wasser und die Vegetation des Talbodens hervorhebt und von der Landschaftsarchitektin Jacqueline Osty angelegt wurde. Spaziergänge, Spiele, Freizeit."
        ],
        "en": [
          "Contemporary landscaped park highlighting water and valley bottom vegetation, designed by landscape architect Jacqueline Osty. Walks, games, leisure activities."
        ],
        "it": [
          "Parco paesaggistico contemporaneo che mette in risalto l'acqua e la vegetazione del fondovalle, progettato dall'architetto paesaggista Jacqueline Osty. Passeggiate, giochi, attività ricreative."
        ],
        "fr": [
          "Parc paysager contemporain mettant en valeur l'eau et la végétation de fond de vallée, réalisé par l'architecte paysagiste Jacqueline Osty. Promenades, jeux, loisirs."
        ],
        "es": [
          "Parque paisajístico contemporáneo que resalta el agua y la vegetación del fondo del valle, diseñado por la arquitecta paisajista Jacqueline Osty. Paseos, juegos, actividades de ocio."
        ],
        "nl": [
          "Hedendaags landschapspark met aandacht voor het water en de vegetatie op de bodem van de vallei, ontworpen door de landschapsarchitect Jacqueline Osty. Wandelingen, spelletjes, vrijetijdsactiviteiten."
        ]
      },
