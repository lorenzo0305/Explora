  "rdfs:comment": {
    "de": [
      "Die Aufträge werden von Jacqueline Otsy ausgeführt. Der Parc Saint-Pierre ist zeitgenössisch und stellt das Wasser und die Vegetation in den Vordergrund. Er ist ein Ort zum Spazierengehen, Spielen ..."
    ],
    "en": [
      "The orders are carried out by Jacqueline Otsy. Parc Saint-Pierre is contemporary and highlights water and vegetation. It is a place for walking, games..."
    ],
    "it": [
      "Le commissioni sono realizzate da Jacqueline Otsy. Il Parc Saint-Pierre è contemporaneo e mette in risalto l'acqua e la vegetazione. È un luogo per passeggiare, giocare..."
    ],
    "fr": [
      "Les commandes sont réalisées par Jacqueline Otsy. Le Parc Saint-Pierre est contemporain et met en avant l'eau et la végétation. C'est un endroit de promenade, de jeux..."
    ],
    "es": [
      "Los encargos son realizados por Jacqueline Otsy. El Parque Saint-Pierre es contemporáneo y hace hincapié en el agua y la vegetación. Es un lugar para pasear, jugar..."
    ],
    "nl": [
      "De opdrachten zijn gemaakt door Jacqueline Otsy. Het Parc Saint-Pierre is eigentijds en legt de nadruk op water en vegetatie. Het is een plek om te wandelen, te spelen..."
    ]
  },
