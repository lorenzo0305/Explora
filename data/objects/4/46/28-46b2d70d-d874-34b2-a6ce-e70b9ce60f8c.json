  "rdfs:comment": {
    "de": [
      "Jahrhundert in der Oberstadt von Laon zu sehen. Der kleine Innenhof ist ein kleines Wunder!"
    ],
    "en": [
      "A magnificent example of 15th- and 16th-century architecture to be seen in Laon's upper town, its small inner courtyard is a little marvel!"
    ],
    "it": [
      "Magnifico esempio di architettura del XV e XVI secolo da ammirare nella città alta di Laon, il suo piccolo cortile interno è un vero gioiello!"
    ],
    "fr": [
      "Magnifique exemple de bâti des XVe et XVIe à voir en ville haute de Laon, sa petite cour intérieure est une petite merveille !"
    ],
    "es": [
      "Magnífico ejemplo de la arquitectura de los siglos XV y XVI que se puede contemplar en la parte alta de la ciudad de Laon, su pequeño patio interior es una auténtica joya"
    ],
    "nl": [
      "Een prachtig voorbeeld van 15e- en 16e-eeuwse architectuur in de bovenstad van Laon. De kleine binnenplaats is een echt juweeltje!"
    ]
  },
