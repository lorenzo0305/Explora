  "rdfs:comment": {
    "de": [
      "Noires Mines Samir ist die Geschichte einer algerischen Einwandererfamilie, die aus ihren kabylischen Bergen in die Minen Nordfrankreichs gerissen wird."
    ],
    "en": [
      "Noires Mines Samir is the story of a family of Algerian immigrants uprooted from their Kabyle mountains for the mines of northern France."
    ],
    "it": [
      "Noires Mines Samir è la storia di una famiglia di immigrati algerini strappati dalle loro montagne cabilonesi per le miniere del nord della Francia."
    ],
    "fr": [
      "Noires Mines Samir est l’histoire d’une famille d’immigrés algériens arrachés à leurs montagnes kabyles pour les mines du Nord de la France."
    ],
    "nl": [
      "Noires Mines Samir is het verhaal van een familie Algerijnse immigranten die uit hun Kabyle-bergen worden weggerukt voor de mijnen van Noord-Frankrijk."
