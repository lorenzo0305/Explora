  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/71ff7cb0-f8c5-36c7-84c8-1838d654ba81",
      "dc:description": {
        "de": [
          "Kommen Sie und entfalten Sie sich in Ihrer Leidenschaft, in einer qualitativ hochwertigen Struktur und einer familiären Atmosphäre. Von den Kleinsten bis zu den Größten, von Anfängern über Touristiker bis hin zu Wettkämpfern."
        ],
        "en": [
          "Come and develop your passion in a quality structure and family atmosphere. From the youngest to the oldest, from beginners to competition and touring enthusiasts."
        ],
        "it": [
          "Venite a vivere la vostra passione in una struttura di qualità e in un'atmosfera familiare. Dai più giovani ai più anziani, dai principianti agli agonisti, compresi gli appassionati di turismo."
        ],
        "fr": [
          "Venez vous épanouir dans votre passion, dans une structure de qualité et une ambiance familiale. Du plus petit au plus grand, du débutant à la compétition en passant par les amateurs de tourisme."
        ],
        "es": [
          "Ven a disfrutar de tu pasión en unas instalaciones de calidad y un ambiente familiar. Desde los más jóvenes a los más mayores, desde principiantes a competidores, pasando por aficionados al touring."
        ],
        "nl": [
          "Kom en geniet van je passie in een kwaliteitsfaciliteit en familiale sfeer. Van de jongste tot de oudste, van beginners tot concurrenten, inclusief toerliefhebbers."
        ]
      },
