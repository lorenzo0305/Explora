  "rdfs:comment": {
    "de": [
      "Judith und Damien begrüßen Sie in diesem hübschen, typisch avesnoisen Haus, um Sie zu verwöhnen und Ihre Herzen zu erwärmen werden Sie den Kamin schätzen!"
    ],
    "en": [
      "Judith and Damien welcome you in this pretty house typically avesnoise to treat you and warm your hearts you will appreciate the fireplace!"
    ],
    "it": [
      "Judith e Damien vi accolgono in questa graziosa casa tipicamente Avesnois, dove potrete gustare un pasto delizioso e scaldarvi il cuore con il camino!"
    ],
    "fr": [
      "Judith et Damien vous accueillent dans cette jolie maison typiquement avesnoise pour vous régaler et réchauffer vos cœurs vous apprécierez la cheminée !"
    ],
    "es": [
      "Judith y Damien le dan la bienvenida a esta bonita casa típicamente avesnois donde podrá disfrutar de una deliciosa comida y calentar su corazón con la chimenea"
    ],
    "nl": [
      "Judith en Damien heten u welkom in dit mooie, typisch Avesnois huis waar u kunt genieten van een maaltijd en uw hart kunt verwarmen bij de open haard!"
    ]
  },
