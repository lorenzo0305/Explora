  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/39bd0272-87eb-3833-8eb1-6e690a6819f3",
      "dc:description": {
        "de": [
          "Im Au Virage d'Ourton erwartet Sie ein traditionelles Restaurant in einer freundlichen Atmosphäre. Dieses Restaurant bietet auch einen Cateringservice und Take-away an. Jeden Mittag sowie Freitag- und Samstagabend geöffnet. Mittwochs geschlossen."
        ],
        "en": [
          "A traditional restoration, in a friendly atmosphere awaits you at the Turn of Ourton. This restaurant also offers a catering service and takeaway sales, open every lunchtime and on Friday and Saturday evenings. Closed on Wednesdays."
        ],
        "it": [
          "Un ristorante tradizionale in un'atmosfera amichevole vi attende all'Au Virage d'Ourton. Questo ristorante offre anche un servizio di catering e di vendita da asporto. Aperto a pranzo e il venerdì e il sabato sera. Chiuso il mercoledì."
        ],
        "fr": [
          "Une restauration traditionnelle, dans une ambiance conviviale vous attend Au Virage d'Ourton . Ce restaurant propose également un service traiteur et de la vente à emporter.Ouvert tous les midis et le vendredi et samedi soir. Fermé le mercredi."
        ],
        "es": [
          "En Au Virage d'Ourton le espera un restaurante tradicional en un ambiente acogedor. Este restaurante también ofrece un servicio de catering y venta de comida para llevar. Abre todos los almuerzos y los viernes y sábados por la noche. Cerrado el miércoles."
        ],
        "nl": [
          "Een traditioneel restaurant in een vriendelijke sfeer wacht op u in Au Virage d'Ourton. Dit restaurant biedt ook een catering service en take-away verkoop. Open elke lunch en op vrijdag en zaterdag avond. Gesloten op woensdag."
        ]
      },
