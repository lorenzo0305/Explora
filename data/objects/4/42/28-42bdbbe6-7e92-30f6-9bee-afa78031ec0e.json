  "rdfs:comment": {
    "de": [
      "Wie wäre es, wenn wir auf Schmetterlingsjagd gehen? In dieser Animation werden wir uns gemeinsam auf den Weg machen, um die überraschende Welt der Schmetterlinge zu entdecken.\n\nReservierung erforderlich"
    ],
    "en": [
      "How about a butterfly hunt? In this activity, we'll set off together to discover the surprising world of butterflies.\n\nReservation required"
    ],
    "it": [
      "Che ne dite di una caccia alle farfalle? In questa attività partiremo insieme alla scoperta del sorprendente mondo delle farfalle.\n\nPrenotazione obbligatoria"
    ],
    "fr": [
      "Et si on allait à la chasse au papillon ? Lors de cette animation nous partirons, ensemble pour découvrir le monde surprenant des papillons de jours.\n\nRéservation obligatoire"
    ],
    "es": [
      "¿Qué tal una cacería de mariposas? En esta actividad saldremos juntos a descubrir el sorprendente mundo de las mariposas.\n\nReserva previa"
    ],
    "nl": [
      "Wat dacht je van een vlinderjacht? In deze activiteit gaan we samen op pad om de verrassende wereld van vlinders te ontdekken.\n\nReserveren verplicht"
    ]
  },
  "rdfs:label": {
