  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d3612963-dc68-3406-9d63-f7df32e039a7",
      "dc:description": {
        "de": [
          "Samstag, 13. April 2024\n\nUm 20:30 Uhr\nPalais des Congrès ? Ravel-Saal\n\nNach ihrer Tournee durch die Zéniths für die ZAZIE AIR TOUR wird Zazie uns auf dieser Tournee 2024 ein Konzert in einer ganz neuen Formel präsentieren. Die NEUE AIR TOUR hebt ab, begleitet vom Album AIR, das bereits erhältlich ist."
        ],
        "en": [
          "Saturday, April 13, 2024\n\nAt 8:30pm\nPalais des Congrès ? Salle Ravel\n\nAfter her Zeniths tour for the ZAZIE AIR TOUR, Zazie will be presenting a concert in a brand new format on this 2024 tour. The NEW AIR TOUR takes off, accompanied by the AIR album, already available."
        ],
        "it": [
          "Sabato 13 aprile 2024\n\nAlle 20.30\nPalazzo dei Congressi? Sala Ravel\n\nDopo la tournée degli Zeniths per lo ZAZIE AIR TOUR, Zazie presenterà in questo tour del 2024 un concerto in un formato del tutto nuovo. Il NUOVO AIR TOUR decolla, accompagnato dall'album AIR, già disponibile."
        ],
        "fr": [
          "Samedi 13 avril 2024\n\nA 20h30\nPalais des Congrès – Salle Ravel\n\nAprès sa tournée de Zéniths pour le ZAZIE AIR TOUR, Zazie nous présentera un concert dans une formule inédite lors de cette tournée 2024. Le NOUVEL AIR TOUR s’envole, accompagné de l’album AIR, déjà disponible."
        ],
        "nl": [
          "Zaterdag 13 april 2024\n\nOm 20.30 uur\nCongrespaleis ? Zaal Ravel\n\nNa haar Zeniths tournee voor de ZAZIE AIR TOUR, presenteert Zazie een concert in een gloednieuw formaat tijdens deze tournee in 2024. De NIEUWE AIR TOUR gaat van start, vergezeld van het album AIR, dat nu al verkrijgbaar is."
        ],
        "es": [
          "Sábado 13 de abril de 2024\n\nA las 20h30\nPalacio de Congresos ? Sala Ravel\n\nDespués de su gira Zeniths para el ZAZIE AIR TOUR, Zazie presentará un concierto en un formato totalmente nuevo en esta gira de 2024. Despega el NUEVO AIR TOUR, acompañado del álbum AIR, ya disponible."
        ]
      },
