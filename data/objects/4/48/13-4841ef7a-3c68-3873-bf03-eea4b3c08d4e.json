  "rdfs:comment": {
    "de": [
      "Frédéric und Aurélie begrüßen Sie in ihrem Restaurant/Bistro, dessen Schlüsselwörter Geselligkeit, Großzügigkeit und Teilen sind...\r\nWenn das Schild leuchtet, gehen Sie hinein!"
    ],
    "en": [
      "Frédéric and Aurélie welcome you to their restaurant/bistro, whose watchwords are conviviality, generosity and sharing...\r\nIf the sign is on, come in!"
    ],
    "it": [
      "Frédéric e Aurélie vi danno il benvenuto nel loro ristorante/bistrot, dove le parole chiave sono convivialità, generosità e condivisione...\r\nSe l'insegna è accesa, entrate!"
    ],
    "fr": [
      "Frédéric et Aurélie, vous accueillent  dans leur restaurant/bistrot, dont les maîtres mots sont convivialité, générosité, partage... \r\nSi l'enseigne est allumée, rentrez !"
    ],
    "es": [
      "Frédéric y Aurélie le dan la bienvenida a su restaurante/bistro, donde las palabras clave son convivencia, generosidad y compartir...\r\nSi el cartel está encendido, ¡entra!"
    ],
    "nl": [
      "Frédéric en Aurélie heten u welkom in hun restaurant/bistro, waar gezelligheid, gulheid en delen de sleutelwoorden zijn...\r\nAls het bordje brandt, kom dan binnen!"
    ]
  },
  "rdfs:label": {
