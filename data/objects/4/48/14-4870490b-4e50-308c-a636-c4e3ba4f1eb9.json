  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ff7fed75-7ba5-381a-9668-43eabeba0d9d",
      "dc:description": {
        "de": [
          "Während der Ducasse de la Saint-Michel, die das Stadtzentrum und den Hafen von Étaples-sur-Mer belebt, bietet Ihnen der AS Étaples die Möglichkeit, dem traditionellen Spiel zwischen Seeleuten und Landbewohnern beizuwohnen."
        ],
        "en": [
          "During the Saint-Michel ducasse, which brings the town center and port of Étaples-sur-mer to life, AS Étaples invites you to attend the traditional match between sailors and landlubbers."
        ],
        "it": [
          "Durante la ducasse di Saint-Michel, che anima il centro e il porto di Étaples-sur-mer, AS Étaples vi invita ad assistere al tradizionale incontro tra marinai e marinai di terra."
        ],
        "fr": [
          "Lors de la ducasse de la Saint-Michel qui anime le centre-ville et le port d’Étaples-sur-mer, l’AS Étaples vous propose d’assister au traditionnel match qui oppose les marins et les terriens."
        ],
        "nl": [
          "Tijdens de Saint-Michel ducasse, die het stadscentrum en de haven van Étaples-sur-mer tot leven brengt, nodigt AS Étaples je uit om de traditionele wedstrijd tussen zeilers en landrotten bij te wonen."
        ],
        "es": [
          "Durante la ducada de Saint-Michel, que anima el centro de la ciudad y el puerto de Étaples-sur-mer, AS Étaples le invita a presenciar el tradicional duelo entre marineros y marineros de agua dulce."
        ]
      },
