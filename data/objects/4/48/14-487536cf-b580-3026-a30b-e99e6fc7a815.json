  "rdfs:comment": {
    "de": [
      "Culture Commune ist die nationale Bühne des Bergbaugebiets Pas-de-Calais und befindet sich auf dem Gelände des 11/19 in der ehemaligen Salle des Pendus, die heute die Fabrique Théâtrale ist."
    ],
    "en": [
      "Scène nationale du Bassin minier du Pas-de-Calais, Culture Commune is located on the 11/19 site in the former Salle des Pendus, now the Fabrique Théâtrale."
    ],
    "it": [
      "Culture Commune, il teatro nazionale del bacino carbonifero del Pas-de-Calais, ha sede nel sito 11/19 nell'ex Salle des Pendus, oggi Fabrique Théâtrale."
    ],
    "fr": [
      "Scène nationale du Bassin minier du Pas-de-Calais, Culture Commune est installée sur le site du 11/19 dans l'ancienne Salle des Pendus, devenue la Fabrique Théâtrale."
    ],
    "nl": [
      "Culture Commune, het nationale theater van het steenkoolgebied Pas-de-Calais, is gevestigd op de site 11/19 in de voormalige Salle des Pendus, nu de Fabrique Théâtrale."
    ],
    "es": [
      "Culture Commune, el teatro nacional de la cuenca carbonífera de Pas-de-Calais, tiene su sede en la 11/19, en la antigua Salle des Pendus, hoy Fabrique Théâtrale."
    ]
  },
