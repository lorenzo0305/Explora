      "dc:description": {
        "de": [
          "In dem charmanten Dorf entdecken Sie die Kirche Saint Pierre, eines der schön erhaltenen Kulturgüter des Dorfes."
        ],
        "en": [
          "In the charming village, discover the church of Saint Pierre, one of the village's best-preserved heritage buildings."
        ],
        "it": [
          "Nell'incantevole villaggio, scoprite la chiesa di Saint-Pierre, uno dei siti del patrimonio del villaggio magnificamente conservati."
        ],
        "fr": [
          "Dans le charmant de village, découvrez l'église Saint Pierre l'un des patrimoine du village magnifiquement préservé."
        ],
        "nl": [
          "Ontdek in het charmante dorp de kerk Saint-Pierre, een van de prachtig bewaard gebleven erfgoedlocaties."
        ],
        "es": [
          "En el encantador pueblo, descubra la iglesia de Saint Pierre, uno de los patrimonios magníficamente conservados del pueblo."
        ]
