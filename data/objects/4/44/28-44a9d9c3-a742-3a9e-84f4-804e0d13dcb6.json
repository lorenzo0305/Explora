  "rdfs:comment": {
    "de": [
      "Chauny Foot Indoor, Ihr Sportkomplex für Hallenfußball in Chauny.\n5 vs. 5, 3 vs. 3 oder sogar 2 vs. 2 - leben Sie Ihre Leidenschaft aus und lassen Sie Ihre Technik auf unseren beiden Spielfeldern sprechen!"
    ],
    "en": [
      "Chauny Foot Indoor, your indoor football sports complex in Chauny.\n5 vs 5, 3 vs 3 or even 2 vs 2, come to live your passion, to make speak your techniques on our two fields!"
    ],
    "it": [
      "Chauny Foot Indoor, il vostro complesso sportivo di calcio al coperto a Chauny.\n5 contro 5, 3 contro 3 o anche 2 contro 2, venite a vivere la vostra passione, lasciate che le vostre abilità parlino da sole sui nostri due campi!"
    ],
    "fr": [
      "Chauny Foot Indoor, votre complexe sportif de foot en salle à Chauny.\n5 vs 5, 3 vs 3 ou même 2 vs 2, venez vivre votre passion, faire parler votre techniques sur nos deux terrains !"
    ],
    "nl": [
      "Chauny Foot Indoor, uw indoor voetbal sportcomplex in Chauny.\n5 vs 5, 3 vs 3 of zelfs 2 vs 2, kom en leef je passie, laat je vaardigheden spreken op onze twee velden!"
    ],
    "es": [
      "Chauny Foot Indoor, su complejo deportivo de fútbol sala en Chauny.\n5 contra 5, 3 contra 3 o incluso 2 contra 2, ven a vivir tu pasión, ¡deja que tus habilidades hablen por sí mismas en nuestros dos campos!"
    ]
  },
