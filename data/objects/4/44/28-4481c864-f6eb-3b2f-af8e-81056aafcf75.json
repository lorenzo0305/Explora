  "rdfs:comment": {
    "de": [
      "Der Parc du Cam mit seinem Teich und seinen Waldwegen empfängt Sie zum Baumklettern, aber auch zu Schnitzeljagden, Minigolf und Kanufahren"
    ],
    "en": [
      "The Parc du Cam, with its pond and wooded paths, welcomes you for tree climbing, treasure hunts, mini-golf and canoeing"
    ],
    "it": [
      "Il Parc du Cam, con il suo laghetto e i suoi sentieri boscosi, è il luogo ideale per arrampicarsi sugli alberi, fare cacce al tesoro, giocare a minigolf e andare in canoa"
    ],
    "fr": [
      "Le Parc du Cam, son étang et ses chemins boisés, vous accueille pour de l'accrobranche mais aussi des jeux de piste, un minigolf et du canoë-kayak"
    ],
    "nl": [
      "Het Parc du Cam, met zijn vijver en beboste paden, is de perfecte plek om te boomklimmen, schatzoeken, minigolfen en kanoën"
    ],
    "es": [
      "El Parc du Cam, con su estanque y senderos arbolados, es el lugar perfecto para trepar a los árboles, buscar tesoros, jugar al minigolf y practicar piragüismo"
    ]
  },
