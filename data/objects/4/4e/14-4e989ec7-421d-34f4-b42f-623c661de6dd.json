  "rdfs:comment": {
    "de": [
      "Eine humorvolle Fanfare.\nVier Musiker erzählen die Geschichte von Walt Disneys Zeichentrickfilmen, von den ersten Spielfilmen bis heute, auf einer Zeitleiste. Einige seiner bekanntesten und beliebtesten Produktionen werden mit Musik und Requisiten angehalten."
    ],
    "en": [
      "Humorous fanfare.\nWith jubilation, four musicians retrace the history of Walt Disney?s cartoons, from his first feature films to the present day, articulating them around a timeline. Stops with music and props are made on some of his most iconic and popular productions."
    ],
    "it": [
      "Fanfara umoristica.\nCon allegria, quattro musicisti ripercorrono la storia dei cartoni animati di Walt Disney, dai primi film ai giorni nostri, articolandoli su una linea del tempo. Vengono effettuate soste musicali e puntate su alcune delle sue produzioni più emblematiche e popolari."
    ],
    "fr": [
      "Fanfare humouristique.\nAvec jubilation, quatre musiciens retracent l’histoire des dessins animés de Walt Disney, de ses premiers longs métrages à nos jours, en les articulant autour d’une ligne du temps. Des arrêts en musique et accessoires sont réalisés sur certaines de ses productions les plus emblématiques et populaires."
    ],
    "nl": [
      "Humoristische fanfare.\nVier muzikanten doorlopen met veel plezier de geschiedenis van Walt Disney's tekenfilms, van zijn eerste speelfilms tot nu, door ze rond een tijdlijn te plaatsen. Muzikale stops en rekwisieten worden gemaakt op enkele van zijn meest emblematische en populaire producties."
    ],
    "es": [
      "Fanfarria humorística.\nCon regocijo, cuatro músicos recorren la historia de los dibujos animados de Walt Disney, desde sus primeros largometrajes hasta la actualidad, articulándolos en torno a una línea de tiempo. Se hacen paradas musicales y de atrezzo en algunas de sus producciones más emblemáticas y populares."
    ]
  },
