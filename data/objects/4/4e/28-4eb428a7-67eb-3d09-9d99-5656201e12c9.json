  "rdfs:comment": {
    "de": [
      "Führungen, Imbissbude, Show und Konzert für den Tag der offenen Tür in der Mikrobrauerei Bulle's Not Dead am Samstag, den 18. April 2026 von 10 Uhr bis 1 Uhr morgens.\nWir erklären Ihnen, wie unsere Biere gebraut werden!\nFoodtruck den ganzen Tag über.\nKonzert am Abend: La brigade Circus."
    ],
    "en": [
      "Guided tours, refreshment bar, show and concert for the open house at Bulle's Not Dead microbrewery on Saturday, April 18, 2026 from 10am to 1am.\nWe'll explain how our beers are brewed!\nFoodtruck all day.\nEvening concert: La brigade Circus."
    ],
    "it": [
      "Visite guidate, punto ristoro, spettacolo e concerto per l'open house del microbirrificio Bulle's Not Dead sabato 18 aprile 2026 dalle 10 all'1 di notte.\nVi spiegheremo come vengono prodotte le nostre birre!\nFoodtruck tutto il giorno.\nConcerto serale: La brigade Circus."
    ],
    "fr": [
      "Visites guidées, buvette, spectacle et concert piur les portes ouvertes à la microbrasserie Bulle's Not Dead le samedi 18 avril 2026 de 10h à 1h du matin.\nOn vous explique comment sont brassées nos bières !\nFoodtruck toute la journée.\nConcert en soirée : La brigade Circus."
    ],
    "es": [
      "Visitas guiadas, bar de refrescos, espectáculo y concierto para la jornada de puertas abiertas de la microcervecería Bulle's Not Dead el sábado 18 de abril de 2026 de 10.00 a 1.00 h.\nLe explicaremos cómo se elaboran nuestras cervezas\nFoodtruck todo el día.\nConcierto por la noche: La brigade Circus."
    ],
    "nl": [
      "Rondleidingen, bar, show en concert voor het open huis van de Bulle's Not Dead microbrouwerij op zaterdag 18 april 2026 van 10u tot 1u.\nWe leggen uit hoe onze bieren worden gebrouwen!\nFoodtruck de hele dag.\nAvondconcert: La brigade Circus."
    ]
  },
