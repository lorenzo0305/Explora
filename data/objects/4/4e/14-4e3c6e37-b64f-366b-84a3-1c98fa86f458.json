      "dc:description": {
        "de": [
          "Samstag, den 11. April 2026\n\"Freimaurerei: Für wen? Warum?\"\nUm 15 Uhr im Maison des Associations (Haus der Vereine)\nEintritt frei, Reservierung per E-Mail an laroseetlesable62520@gmail.com empfohlen"
        ],
        "en": [
          "Saturday, April 11, 2026\n\"Freemasonry: Who for? Why?\nAt 3pm at the Maison des Associations\nFree admission, booking recommended by e-mail to laroseetlesable62520@gmail.com"
        ],
        "it": [
          "Sabato 11 aprile 2026\n\"Massoneria: per chi, perché?\nAlle ore 15.00 presso la Maison des Associations\nIngresso libero, prenotazione consigliata via e-mail a laroseetlesable62520@gmail.com"
        ],
        "fr": [
          "Samedi 11 avril 2026\n\"Franc Maçonnerie : Pour qui ? pourquoi ?\"\nA 15h à la Maison des Associations\nEntrée gratuite, réservation conseillée par mail à laroseetlesable62520@gmail.com"
        ],
        "nl": [
          "Zaterdag 11 april 2026\n\"Vrijmetselarij: voor wie, waarom?\nOm 15.00 uur in het Maison des Associations\nGratis toegang, reserveren aanbevolen via e-mail naar laroseetlesable62520@gmail.com"
        ],
        "es": [
          "Sábado 11 de abril de 2026\n\"Masonería: ¿para quién? ¿por qué?\nA las 15h en la Maison des Associations\nEntrada gratuita, se recomienda reservar por correo electrónico a laroseetlesable62520@gmail.com"
        ]
      },
