  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c85393a5-fad3-3948-983e-5266ef4178b4",
      "dc:description": {
        "de": [
          "Die Domaine des Cascades liegt 5 Minuten von Arras entfernt\n\nSeine weiten Ebenen, Teiche und Flüsse bieten den Anglern Entspannung und Geselligkeit in aller Einfachheit"
        ],
        "en": [
          "Domaine des Cascades is 5 minutes from Arras\n\nIts wide-open plains, ponds and rivers offer anglers relaxation and conviviality in complete simplicity"
        ],
        "it": [
          "Il Domaine des Cascades si trova a 5 minuti da Arras\n\nLe sue ampie pianure, gli stagni e i fiumi offrono ai pescatori la possibilità di rilassarsi e divertirsi in tutta semplicità"
        ],
        "fr": [
          "Le domaine des cascades est situé à 5 minutes d'Arras\n\nSes grands espaces de plaines, ses étangs et ses rivières offrent aux pêcheurs détente et convivialité en toute simplicité"
        ],
        "es": [
          "El Domaine des Cascades se encuentra a 5 minutos de Arras\n\nSus amplias llanuras, estanques y ríos ofrecen a los pescadores la posibilidad de relajarse y disfrutar con total sencillez"
        ],
        "nl": [
          "Domaine des Cascades ligt op 5 minuten van Arras\n\nDe uitgestrekte vlaktes, vijvers en rivieren bieden vissers de kans om te ontspannen en te genieten in alle eenvoud"
        ]
      },
      "@type": [
        "Description"
