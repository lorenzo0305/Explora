      "@id": "https://data.datatourisme.fr/2adadbfe-3f54-3388-9db7-b55bc3ec612b",
      "dc:description": {
        "de": [
          "Verein für Kultur und Freizeit. Sein Hauptziel ist es, Senioren Unterhaltung zu bieten und sie für neue kulturelle Aktivitäten zu öffnen."
        ],
        "en": [
          "Cultural and leisure association. Its primary objective is to enable senior citizens to enjoy themselves and open up to new cultural activities."
        ],
        "it": [
          "Associazione culturale e ricreativa. Il suo obiettivo principale è dare ai cittadini anziani l'opportunità di divertirsi e di aprirsi a nuove attività culturali."
        ],
        "fr": [
          "Association culturelle et de loisirs. Son objectif premier est de permettre aux seniors de se divertir et de s'ouvrir à de nouvelles activités culturelles."
        ],
        "nl": [
          "Culturele en vrijetijdsvereniging. Het belangrijkste doel is om senioren de kans te geven zich te vermaken en nieuwe culturele activiteiten te leren kennen."
        ],
        "es": [
          "Asociación cultural y de ocio. Su principal objetivo es ofrecer a las personas mayores la oportunidad de divertirse y conocer nuevas actividades culturales."
        ]
      },
