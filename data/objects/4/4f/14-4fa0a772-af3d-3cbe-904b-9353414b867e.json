        ],
        "en": [
          "Easter egg hunt\nFrom 10am to 12pm in Parc des Pins.\n\nTravelling farm - Inflatable structures - Face painting stand."
        ],
        "it": [
          "Caccia alle uova di Pasqua\nDalle 10.00 alle 12.00 al Parc des Pins.\n\nFattoria itinerante - Strutture gonfiabili - Stand di face painting."
        ],
        "fr": [
          "Grande chasse aux oeufs de Pâques\nDe 10h à 12h au Parc des Pins.\n\nFerme itinérante - Structures gonflables - Stand maquillage."
        ],
        "nl": [
          "Paaseieren zoeken\nVan 10.00 tot 12.00 uur in Parc des Pins.\n\nReizende boerderij - Opblaasbare structuren - Stand met schmink."
