  "rdfs:comment": {
    "de": [
      "Gehen Sie mit uns an Bord und wählen Sie das Ziel!\nDie Harmonie Avenir de Burbure lädt Sie zu ihrem Frühlingskonzert unter der Leitung von Jean-Michel RICQUEBOURG ein."
    ],
    "en": [
      "Embark with us and choose your destination!\nThe Harmonie Avenir de Burbure invites you to its spring concert, conducted by Jean-Michel RICQUEBOURG."
    ],
    "it": [
      "Salite a bordo con noi e scegliete la vostra destinazione!\nL'Harmonie Avenir de Burbure vi invita al suo concerto di primavera, diretto da Jean-Michel RICQUEBOURG."
    ],
    "fr": [
      "Embarquez avec nous et choisissez la destination ! \nL’Harmonie Avenir de Burbure vous invite à son concert de printemps, sous la direction de Jean-Michel RICQUEBOURG."
    ],
    "es": [
      "¡Suba a bordo con nosotros y elija su destino!\nLa Harmonie Avenir de Burbure le invita a su concierto de primavera, dirigido por Jean-Michel RICQUEBOURG."
    ],
    "nl": [
      "Kom bij ons aan boord en kies je bestemming!\nDe Harmonie Avenir de Burbure nodigt u uit voor haar voorjaarsconcert onder leiding van Jean-Michel RICQUEBOURG."
    ]
  },
