  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/668f996a-574c-37cd-8c4b-d5d187d1e8db",
      "dc:description": {
        "de": [
          "Machen Sie Ihre Mittagspause oder frühstücken Sie im 360 in Soissons. Es liegt mitten im Stadtzentrum in einer gemütlichen Umgebung, in der Sie Tapas, Tagesgerichte und vieles mehr genießen können!"
        ],
        "en": [
          "Come and have your lunch or breakfast at 360 in Soissons, located in the heart of the city center, where you can enjoy tapas, daily specials and much more!"
        ],
        "it": [
          "Venite a fare pausa pranzo o colazione al 360 di Soissons, situato nel cuore del centro città, dove potrete gustare tapas, specialità del giorno e molto altro!"
        ],
        "fr": [
          "Venez faire votre pause déjeuner ou prendre votre petit-déjeuner au 360 à Soissons, situé en plein coeur du centre-ville dans un cadre chaleureux pour déguster des tapas, les plats du jour et bien d'autres choses encore !"
        ],
        "es": [
          "Venga a comer o a desayunar a 360 en Soissons, en pleno centro de la ciudad, donde podrá degustar tapas, platos del día y mucho más"
        ],
        "nl": [
          "Kom lunchen of ontbijten bij 360 in Soissons, in het hart van het stadscentrum, waar je kunt genieten van tapas, dagschotels en nog veel meer!"
        ]
      },
