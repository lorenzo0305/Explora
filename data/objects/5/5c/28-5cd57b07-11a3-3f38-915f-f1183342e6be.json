  "rdfs:comment": {
    "de": [
      "Eine Veranstaltung, die zahlreiche Fachleute an einem einzigen Ort zusammenbringt, um all Ihre Erwartungen zu erfüllen.\nDie Messe, um sich inspirieren zu lassen und Ihre Projekte zu konkretisieren!"
    ],
    "en": [
      "An event that brings together numerous professionals in a single location to meet all your expectations.\nThe show to get inspired and turn your plans into reality!"
    ],
    "it": [
      "Un evento che riunisce un'ampia gamma di professionisti in un unico luogo per soddisfare tutte le vostre esigenze.\nIl salone che vi ispirerà e trasformerà i vostri progetti in realtà!"
    ],
    "fr": [
      "Un événement qui rassemble de nombreux professionnels en un seul et même lieu pour répondre à toutes vos attentes.\nLe salon pour s’inspirer et concrétiser ses projets !"
    ],
    "es": [
      "Un evento que reúne a una amplia gama de profesionales en un solo lugar para satisfacer todas sus necesidades.\n¡El salón para inspirarle y convertir sus planes en realidad!"
    ],
    "nl": [
      "Een evenement dat een breed scala aan professionals op één plek samenbrengt om aan al je behoeften te voldoen.\nDe show die je inspireert en je plannen werkelijkheid laat worden!"
    ]
  },
