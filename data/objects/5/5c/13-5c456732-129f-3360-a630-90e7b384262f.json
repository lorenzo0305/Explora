  "rdfs:comment": {
    "de": [
      "Die zwischen 1723 und 1779 erbaute Kapelle wird noch immer regelmäßig als Kultstätte genutzt und beherbergt die Reliquien des Heiligen Gorgon, dem sie geweiht ist."
    ],
    "en": [
      "This chapel, built between 1723 and 1779, is still used regularly for worship and houses the relics of Saint Gorgon to whom it is dedicated."
    ],
    "it": [
      "Questa cappella, costruita tra il 1723 e il 1779, è ancora regolarmente utilizzata per il culto e ospita le reliquie di Santa Gorgone, a cui è dedicata."
    ],
    "fr": [
      "Cette chapelle édifiée entre 1723 et 1779 fait encore l’objet d’un usage cultuel régulier et abrite les reliques de Saint Gorgon auquel elle est dévouée."
    ],
    "es": [
      "Esta capilla, construida entre 1723 y 1779, sigue utilizándose regularmente para el culto y alberga las reliquias de Santa Gorgona, a quien está dedicada."
    ],
    "nl": [
      "Deze kapel, gebouwd tussen 1723 en 1779, wordt nog regelmatig voor de eredienst gebruikt en herbergt de relikwieën van de heilige Gorgon aan wie zij is gewijd."
    ]
  },
  "rdfs:label": {
