      "dc:description": {
        "de": [
          "Besuchen Sie von April bis September den Bauernhof Souchinet und entdecken Sie einen 15 Hektar großen Tier- und Freizeitpark.\nNeu in diesem Park: Blindenparcours"
        ],
        "en": [
          "Come to the Souchinet farm from April to September to discover 15 hectares of animal and leisure park.\nNew in this park: blind trail"
        ],
        "it": [
          "Venite alla fattoria Souchinet da aprile a settembre per scoprire 15 ettari di parco animale e ricreativo.\nNovità di questo parco: percorso cieco"
        ],
        "fr": [
          "Rendez vous à la ferme souchinet de avril à septembre pour découvrir 15 hectares de parc animalier et de loisirs. \nNouveauté de ce parc : parcours à l'aveugle"
        ],
        "es": [
          "Venga a la granja de Souchinet de abril a septiembre para descubrir 15 hectáreas de parque de animales y de ocio.\nNovedad en este parque: sendero a ciegas"
        ],
        "nl": [
          "Kom van april tot september naar de boerderij Souchinet om 15 hectare dieren- en recreatiepark te ontdekken.\nNieuw in dit park: blindenparcours"
        ]
      },
