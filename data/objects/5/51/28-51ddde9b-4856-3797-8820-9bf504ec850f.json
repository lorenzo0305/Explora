  "rdfs:comment": {
    "de": [
      "Ein Film von Todd Komarnicki\nAls die Welt am Rande der Vernichtung steht, gerät der Pastor Dietrich Bonhoeffer in eine Verschwörung, die Hitler beseitigen soll. Kann er einen Menschen ermorden, um Millionen von Menschen zu retten? Sein Leben und sein Glaube stehen auf dem Spiel."
    ],
    "en": [
      "A film by Todd Komarnicki\nWith the world on the brink of annihilation, Pastor Dietrich Bonhoeffer finds himself at the heart of a plot to eliminate Hitler. Can he murder one man in the hope of saving millions? His life and faith are at stake."
    ],
    "it": [
      "Un film di Todd Komarnicki\nCon il mondo sull'orlo dell'annientamento, il pastore Dietrich Bonhoeffer si trova al centro di un complotto per eliminare Hitler. Può uccidere un uomo nella speranza di salvarne milioni? La sua vita e la sua fede sono in gioco."
    ],
    "fr": [
      "Un film de Todd Komarnicki\nAlors que le monde est au bord de l'anéantissement, le pasteur Dietrich Bonhoeffer est plongé au cœur d'un complot visant à éliminer Hitler. Peut-il assassiner un homme pour espérer en sauver des millions ? Sa vie et sa foi sont en jeu."
    ],
    "es": [
      "Una película de Todd Komarnicki\nCon el mundo al borde de la aniquilación, el pastor Dietrich Bonhoeffer se encuentra en el centro de un complot para eliminar a Hitler. ¿Puede asesinar a un hombre con la esperanza de salvar a millones? Su vida y su fe están en juego."
    ],
    "nl": [
      "Een film van Todd Komarnicki\nMet de wereld op de rand van vernietiging bevindt dominee Dietrich Bonhoeffer zich in het hart van een complot om Hitler uit te schakelen. Kan hij één man vermoorden in de hoop miljoenen te redden? Zijn leven en zijn geloof staan op het spel."
    ]
  },
  "rdfs:label": {
