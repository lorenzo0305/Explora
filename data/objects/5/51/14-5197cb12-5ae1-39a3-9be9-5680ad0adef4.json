  "rdfs:comment": {
    "de": [
      "Tiot Loupiot ist ein Festival für ein sehr junges Publikum (0-6 Jahre), das von Droit de Cité getragen wird.\nEs reist durch 30 Gemeinden in der Region Hauts-de-France und vermittelt mit Aufführungen, Workshops und Ausstellungen die Freude an Büchern."
    ],
    "en": [
      "Tiot Loupiot is a festival for very young audiences (0-6 years old) supported by Droit de Cité.\nIt travels to 30 towns in the Hauts-de-France region to transmit the pleasure of books through shows, workshops and exhibitions."
    ],
    "it": [
      "Tiot Loupiot è un festival per i giovanissimi (0-6 anni) organizzato da Droit de Cité.\nSi sposta in 30 città e villaggi della regione Hauts-de-France per trasmettere la gioia dei libri attraverso spettacoli, laboratori e mostre."
    ],
    "fr": [
      "Tiot Loupiot est un festival très jeune public (0-6 ans) porté par Droit de Cité.\nIl voyage dans 30 communes des Hauts-de-France pour transmettre le plaisir du livre grâce à des spectacles, des ateliers et des expositions."
    ],
    "nl": [
      "Tiot Loupiot is een festival voor een zeer jong publiek (0-6 jaar) georganiseerd door Droit de Cité.\nHet reist langs 30 steden en dorpen in de regio Hauts-de-France om het plezier van boeken door te geven door middel van voorstellingen, workshops en tentoonstellingen."
    ],
    "es": [
      "Tiot Loupiot es un festival para público muy joven (0-6 años) organizado por Droit de Cité.\nRecorre 30 ciudades y pueblos de la región de Hauts-de-France para transmitir la alegría de los libros a través de espectáculos, talleres y exposiciones."
    ]
  },
  "rdfs:label": {
