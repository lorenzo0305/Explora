  "rdfs:comment": {
    "de": [
      "Unser Restaurant bietet Ihnen eine traditionelle Küche, die bodenständige ländliche Gerichte mit einem Hauch von Originalität verbindet. Auf unseren Speisekarten wechseln sich saisonale Gerichte ab, die von frischem Gemüse begleitet werden und den Geschmack vergangener Zeiten in den Mund bringen."
    ],
    "en": [
      "Our restaurant offers a traditional cuisine combining country dishes with a touch of originality in the proposed dishes. Our menus alternate seasonal dishes accompanied by fresh vegetables that will bring out the flavors of yesteryear."
    ],
    "it": [
      "Il nostro ristorante offre una cucina tradizionale che combina piatti di campagna con un tocco di originalità. I nostri menu alternano piatti di stagione accompagnati da verdure fresche che fanno rivivere i sapori di una volta."
    ],
    "fr": [
      "Notre Restaurant vous propose une cuisine traditionnelle alliant plats de terroir campagnards avec une pointe d'originalité dans les mets proposés. Nos cartes alternent des plats de saisons accompagnés de légumes frais qui mettront en bouche les saveurs d'antan."
    ],
    "nl": [
      "Ons restaurant biedt een traditionele keuken die gerechten in landelijke stijl combineert met een vleugje originaliteit. Op onze kaart staan afwisselend seizoensgebonden gerechten met verse groenten die de smaken van weleer naar boven halen."
    ],
    "es": [
      "Nuestro restaurante ofrece una cocina tradicional que combina platos de estilo rústico con un toque de originalidad. Nuestra carta alterna platos de temporada acompañados de verduras frescas que le harán revivir los sabores de antaño."
    ]
  },
  "rdfs:label": {
