  "rdfs:comment": {
    "de": [
      "Die Herberge, ein ehemaliges Forsthaus, das 1902 erbaut wurde, ist vom Wald des Grafen von Paris umgeben. Der rustikale Rahmen bietet ein warmes Klima. Angenehme Terrasse in der schönen Jahreszeit. Traditionelle Küche."
    ],
    "en": [
      "The inn, an old forest house built in 1902, is surrounded by the forest of the Count of Paris. The rustic setting offers a warm atmosphere. Pleasant terrace in good season. Traditional cuisine."
    ],
    "it": [
      "L'ostello è un'ex casa forestale costruita nel 1902 ed è circondata dalla foresta del Conte di Parigi. L'ambiente rustico offre un'atmosfera accogliente. Piacevole terrazza nei mesi estivi. Cucina tradizionale."
    ],
    "fr": [
      "L'auberge, ancienne maison forestière construite en 1902, est entourée par la forêt du comte de Paris. Le cadre rustique offre un climat chaleureux. Terrasse agréable en belle saison. Cuisine traditionnelle."
    ],
    "es": [
      "El albergue es una antigua casa forestal construida en 1902 y está rodeada por el bosque del Conde de París. El entorno rústico ofrece un ambiente cálido. Agradable terraza en los meses de verano. Cocina tradicional."
    ],
    "nl": [
      "De herberg is een voormalig boshuis uit 1902 en is omgeven door het bos van de graaf van Parijs. De rustieke omgeving biedt een warme sfeer. Aangenaam terras in de zomermaanden. Traditionele keuken."
    ]
  },
