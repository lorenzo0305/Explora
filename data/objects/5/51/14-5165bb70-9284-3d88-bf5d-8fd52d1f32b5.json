        "de": [
          "Im Sommer können Sie den Bauernhof besichtigen und nach Absprache um 16:30 Uhr beim Melken der Kühe zuschauen."
        ],
        "en": [
          "In summer, visit of the farm and possibility to attend the milking of the cows at 4.30 pm by appointment."
        ],
        "it": [
          "In estate, visitate la fattoria e assistete alla mungitura delle mucche alle 16.30 su appuntamento."
        ],
        "fr": [
          "En été, visite de la ferme et possibilité d'assister à la traite des vaches à 16h30 sur rendez-vous."
        ],
        "nl": [
          "In de zomer kunt u de boerderij bezoeken en op afspraak om 16.30 uur zien hoe de koeien worden gemolken."
        ],
        "es": [
          "En verano, visite la granja y vea cómo se ordeñan las vacas a las 16:30 horas con cita previa."
        ]
