  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/22419571-495b-3e3f-9def-4ab8c27f924d",
      "dc:description": {
        "de": [
          "Saint-Josse-au-Val ist eine der ältesten Pfarreien der Stadt, da sie in einem Text aus dem Jahr 1042 erwähnt wird. Die Kirche wurde natürlich mehrmals renoviert, vor allem im 18. und 19. Die letzte Restaurierung fand 2009 statt."
        ],
        "en": [
          "Saint-Josse-au-Val is one of the oldest parishes in the city since it is mentioned in a text dating from 1042. It has of course been reformed many times, notably in the 18th and 19th centuries. It was last restored in 2009."
        ],
        "it": [
          "Saint-Josse-au-Val è una delle parrocchie più antiche della città, poiché è menzionata in un testo del 1042. Naturalmente è stato ristrutturato più volte, soprattutto nel XVIII e XIX secolo. L'ultimo restauro risale al 2009."
        ],
        "fr": [
          "Saint-Josse-au-Val est l'une des plus anciennes paroisses de la ville puisqu'elle est mentionnée dans un texte de 1042. Elle a bien sûr été ramaniée de nombreuses fois, notamment aux XVIIIèmme et XIXème siècles. Sa dernière restauration date de 2009."
        ],
        "nl": [
          "Saint-Josse-au-Val is een van de oudste parochies van de stad, zoals blijkt uit een tekst uit 1042. Uiteraard is het vele malen gerenoveerd, met name in de 18e en 19e eeuw. De laatste restauratie dateert van 2009."
        ],
        "es": [
          "Saint-Josse-au-Val es una de las parroquias más antiguas de la ciudad, ya que se menciona en un texto de 1042. Por supuesto, ha sido renovado muchas veces, sobre todo en los siglos XVIII y XIX. Su última restauración data de 2009."
        ]
      },
