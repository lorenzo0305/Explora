  "rdfs:comment": {
    "de": [
      "Eine großzügige, ehrliche und aufrichtige Küche. Animationen und musikalische Untermalung am Wochenende. Pizzas vor Ort und zum Mitnehmen: Freitagabend, Samstag, Sonntagmittag."
    ],
    "en": [
      "Generous, honest and sincere cuisine. Entertainment and music at weekends. On-site and takeaway pizzas: Friday evening, Saturday, Sunday lunchtime."
    ],
    "it": [
      "Cucina generosa, onesta e sincera. Intrattenimento e musica nei fine settimana. Pizze a domicilio o da asporto: venerdì sera, sabato, domenica a pranzo."
    ],
    "fr": [
      "Une cuisine généreuse, honnête et sincère. Animations et ambiance musicale le week-end. Pizzas sur place et à emporter : vendredi soir, samedi, dimanche midi."
    ],
    "nl": [
      "Genereuze, eerlijke en oprechte keuken. Entertainment en muziek in het weekend. Pizza's om te eten of om mee te nemen: vrijdagavond, zaterdag, zondagmiddag."
    ],
    "es": [
      "Cocina generosa, honesta y sincera. Animación y música los fines de semana. Pizzas para comer o llevar: viernes por la noche, sábados, domingos al mediodía."
    ]
  },
