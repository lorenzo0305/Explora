      "rdfs:comment": {
        "de": [
          "Lernen Sie den landwirtschaftlichen Betrieb, seine menschliche, tierische und natürliche Umgebung kennen.\n\nEs werden verschiedene Workshops rund um den Weizen und die Tiere angeboten."
        ],
        "en": [
          "Come and discover the farm, its human, animal and natural environment.\n\nVarious workshops are proposed around wheat and animals."
        ],
        "it": [
          "Venite a scoprire la fattoria, il suo ambiente umano, animale e naturale.\n\nVengono proposti diversi laboratori sul grano e sugli animali."
        ],
        "fr": [
          "Venez découvrir l'exploitation agricole, son environnement humain, animal et naturel.\n\nDivers ateliers sont proposés autour du blé et des animaux."
        ],
        "es": [
          "Venga a descubrir la granja, su entorno humano, animal y natural.\n\nSe ofrecen diversos talleres en torno al trigo y los animales."
        ],
        "nl": [
          "Kom en ontdek de boerderij, zijn menselijke, dierlijke en natuurlijke omgeving.\n\nEr worden verschillende workshops aangeboden rond tarwe en dieren."
        ]
      },
