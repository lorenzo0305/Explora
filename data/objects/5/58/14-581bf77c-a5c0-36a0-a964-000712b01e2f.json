  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/62928b88-0207-3e55-8e0c-dc2f0d32cd2d",
      "dc:description": {
        "de": [
          "Sie erobern das Museum! Um das Ende des Kurses der 15 Make-up-Lehrlinge zu feiern, tragen professionelle Schauspieler ihre Masken durch das Museum, für eine ebenso traumhafte wie gruselige Parade!"
        ],
        "en": [
          "They invade the museum! To celebrate the end of the course for the fifteen apprentice film make-up artists, professional actors wear their masks in the museum, for a parade as dreamlike as it is scary!"
        ],
        "it": [
          "Si impadroniscono del museo! Per festeggiare la fine del corso per quindici apprendisti truccatori, attori professionisti indossano le loro maschere nel museo, per una parata tanto onirica quanto spaventosa!"
        ],
        "fr": [
          "Elles envahissent le musée ! Pour fêter la fin du stage des quinze apprentis maquilleurs de cinéma, des acteurs professionnels portent leurs masques dans le musée, pour un défilé aussi onirique qu’effrayant !"
        ],
        "es": [
          "¡Se apoderan del museo! Para celebrar el final del curso de quince aprendices de maquilladores cinematográficos, actores profesionales se ponen sus máscaras en el museo, ¡para un desfile tan onírico como terrorífico!"
        ],
        "nl": [
          "Ze nemen het museum over! Om het einde van de cursus voor de vijftien filmvisagisten te vieren, dragen professionele acteurs hun maskers in het museum, voor een even droomachtige als enge parade!"
        ]
      },
