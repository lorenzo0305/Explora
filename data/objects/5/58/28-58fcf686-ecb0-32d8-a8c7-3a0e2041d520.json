  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dd20dd05-ea96-3fb1-8818-1aa3cf5a68e4",
      "dc:description": {
        "de": [
          "Café, Pommesbude mit beheizter Terrasse mit 25 Plätzen und 50 Plätzen im Sommer. Spezialitäten: frische Pommes frites, frisches französisches Hackfleisch und vor Ort gebackenes Brot. Hausgemachte Hamburger, Potjevleesch, Carbonade, Hähnchen mit Maroilles."
        ],
        "en": [
          "Café, French fry shop with heated terrace seating 25 and 50 in summer. Specialities: fresh French fries, fresh French minced meat and bread made on site. Homemade hamburger, potjevleesch, carbonade, maroilles chicken."
        ],
        "it": [
          "Caffè, negozio di patatine fritte con terrazza riscaldata con 25 e 50 posti a sedere in estate. Specialità: patatine fritte fresche, carne macinata francese fresca e pane fatto in casa. Hamburger fatti in casa, potjevleesch, carbonade, pollo con formaggio maroilles."
        ],
        "fr": [
          "Café, friterie avec terrasse chauffée de 25 places et 50 places en été. Spécialités : frites fraiches, viande hachée fraiche français et pain fait sur place. Hamburger maison, potjevleesch, carbonade, poulet au maroilles."
        ],
        "es": [
          "Cafetería, tienda de patatas fritas con terraza climatizada para 25 y 50 personas en verano. Especialidades: patatas fritas frescas, carne picada francesa fresca y pan hecho en el establecimiento. Hamburguesa casera, potjevleesch, carbonada, pollo con queso maroilles."
        ],
        "nl": [
          "Café, friettent met verwarmd terras voor 25 en 50 zitplaatsen in de zomer. Specialiteiten: verse friet, vers Frans gehakt en ter plekke gebakken brood. Huisgemaakte hamburger, potjevleesch, carbonade, kip met maroilles."
        ]
      },
      "@type": [
        "Description"
      ],
