  "rdfs:comment": {
    "de": [
      "Sie werden mögen: Die Schiefertafel wechselt jeden Tag und garantiert Frische und Qualität. Die Preise sind sehr erschwinglich."
    ],
    "en": [
      "You'll love : The menu changes daily, guaranteeing freshness and quality. Very affordable prices."
    ],
    "it": [
      "Cosa vi piacerà Il menu cambia ogni giorno, garantendo freschezza e qualità. I prezzi sono molto convenienti."
    ],
    "fr": [
      "Vous aimerez : L'ardoise change tous les jours, garantissant fraîcheur et qualité. Les prix sont très abordables."
    ],
    "nl": [
      "Wat je lekker vindt Het menu verandert elke dag, waardoor versheid en kwaliteit gegarandeerd zijn. De prijzen zijn zeer betaalbaar."
    ],
    "es": [
      "Lo que le gustará El menú cambia cada día, garantizando frescura y calidad. Los precios son muy asequibles."
    ]
