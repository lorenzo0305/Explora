  "rdfs:comment": {
    "de": [
      "Dieses Lokal bietet Spezialitäten aus Bouchot-Muscheln und Bindfäden aus der Bucht an. Der Service ist einladend und schnell auf der Terrasse (überdacht und bei Bedarf beheizt)."
    ],
    "en": [
      "This establishment specializes in Bouchot mussels and ficelles de la baie. Service is friendly and fast on the terrace (covered and heated if required)."
    ],
    "it": [
      "Questo locale offre specialità di cozze bouchot e ficelles della baia. Il servizio è cordiale e veloce sulla terrazza (coperta e riscaldata se necessario)."
    ],
    "fr": [
      "Cet établissement propose des spécialités de moules de bouchot et ficelles de la baie. Le service est accueillant et rapide en terrasse (couverte et chauffée au besoin)."
    ],
    "es": [
      "Este establecimiento ofrece especialidades de mejillones bouchot y ficelles de la bahía. El servicio es amable y rápido en la terraza (cubierta y climatizada si se desea)."
    ],
    "nl": [
      "Dit etablissement biedt specialiteiten van bouchotmosselen en ficelles uit de baai. De bediening is vriendelijk en snel op het terras (overdekt en verwarmd indien gewenst)."
    ]
  },
  "rdfs:label": {
