  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c93cf3e5-a7e1-32f8-8fef-176ffd8d907d",
      "dc:description": {
        "de": [
          "Bauernhof mit Mischkultur. Gemüseanbau im Freiland und in einem 700 m² großen Gewächshaus\nSchöner Bauernhof, umgeben von Natursteinmauern, Teich, Weiher.\nAutomaten für Kartoffeln und Saisongemüse."
        ],
        "en": [
          "Mixed farming farm. Vegetable growing in the open ground and in a 700 m² greenhouse\nPretty farm surrounded by stone walls, pond.\nVending machines for potatoes and seasonal vegetables."
        ],
        "it": [
          "Agricoltura mista. Ortofrutta in piena terra e in una serra di 700 m²\nGraziosa fattoria circondata da muri in pietra, laghetto, stagno.\nDistributori automatici di patate e verdure di stagione."
        ],
        "fr": [
          "Ferme de polyculture. Maraîchage en pleine terre et sous serre de 700 m². \nJolie ferme entourée de murs de pierres de taille, mare, étang.\nDistributeurs automatiques de pommes de terre et légumes de saison."
        ],
        "nl": [
          "Gemengd bedrijf. Tuinbouw in de volle grond en in een kas van 700 m²\nMooie boerderij omgeven door stenen muren, vijver.\nVerkoopautomaten voor aardappelen en seizoensgroenten."
        ],
        "es": [
          "Agricultura mixta. Huerta en campo abierto y en un invernadero de 700 m²\nBonita granja rodeada de muros de piedra, estanque, estanque.\nMáquinas expendedoras de patatas y verduras de temporada."
        ]
      },
      "@type": [
        "Description"
      ],
