  "rdfs:comment": {
    "de": [
      "Direktverkauf von Kartoffeln und Gemüse der Saison, Eiern, Honig, Mehl, selbstgebrauten Bieren und Cidre.\nVerkaufsautomat 7 Tage die Woche von 7:00 bis 22:00 Uhr geöffnet"
    ],
    "en": [
      "Direct sale of potatoes and seasonal vegetables, eggs, honey, flour, beers and ciders.\nVending machine open 7 days a week from 7am to 10pm"
    ],
    "it": [
      "Vendita diretta di patate e verdure di stagione, uova, miele, farina, birre artigianali e sidro.\nDistributore automatico aperto 7 giorni su 7, dalle 7 alle 22"
    ],
    "fr": [
      "Vente directe de pommes de terre et légumes de saison, oeuf, miel, farine, bières et cidres artisanaux.\nDistributeur automatique ouvert 7j/7 de 7h à 22h"
    ],
    "es": [
      "Venta directa de patatas y verduras de temporada, huevos, miel, harina, cervezas artesanas y sidras.\nMáquina expendedora abierta los 7 días de la semana de 7 a 22 h"
    ],
    "nl": [
      "Directe verkoop van aardappelen en seizoensgroenten, eieren, honing, meel, ambachtelijke bieren en ciders.\nVerkoopautomaat 7 dagen per week geopend van 7 tot 22 uur"
    ]
  },
  "rdfs:label": {
