  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05d53184-6f8b-3c95-964b-c948532cab00",
      "dc:description": {
        "de": [
          "Ein dem Künstler Rodin gewidmeter Raum, flämische Gemälde und Aquarelle der englischen Meister Turner und Bonington, Werke lokaler Künstler? Entdecken Sie Sammlungen, in denen Skulpturen, Aquarelle, Zeichnungen und Fotografien gekonnt miteinander kombiniert werden."
        ],
        "en": [
          "Room dedicated to the artist Rodin, Flemish paintings and watercolours by the English masters Turner and Bonington, works by local artists... Discover collections where sculptures, watercolours, drawings and photographs are skilfully mixed."
        ],
        "it": [
          "Una sala dedicata all'artista Rodin, dipinti fiamminghi e acquerelli dei maestri inglesi Turner e Bonington, opere di artisti locali? Scoprite le collezioni in cui sculture, acquerelli, disegni e fotografie sono sapientemente combinati."
        ],
        "fr": [
          "Salle dédiée à l’artiste Rodin, peintures flamandes et aquarelles des maîtres anglais Turner et Bonington, œuvres d’artistes locaux… Découvrez des collections où sculptures, aquarelles, dessins et photographies se mêlent savamment."
        ],
        "es": [
          "Una sala dedicada al artista Rodin, pinturas flamencas y acuarelas de los maestros ingleses Turner y Bonington, obras de artistas locales? Descubra colecciones en las que se combinan hábilmente esculturas, acuarelas, dibujos y fotografías."
        ],
        "nl": [
          "Een zaal gewijd aan de kunstenaar Rodin, Vlaamse schilderijen en aquarellen van de Engelse meesters Turner en Bonington, werken van lokale kunstenaars? Ontdek collecties waar sculpturen, aquarellen, tekeningen en foto's vakkundig worden gecombineerd."
        ]
      },
      "@type": [
        "Description"
      ],
