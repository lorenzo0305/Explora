  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b20df3e7-8eef-31d1-b8cb-c4db7de7876f",
      "dc:description": {
        "de": [
          "Die Amicale des Sapeurs Pompiers de Fruges organisiert ihren Feuerwehrabend\nTreffpunkt ist am Samstag, den 13. September ab 19 Uhr in der Salle Sagot\nEssen auf Reservierung bis zum 29. August unter 07 61 61 70 69 oder 06 73 86 78 46"
        ],
        "en": [
          "The Amicale des Sapeurs Pompiers de Fruges organizes their Firefighters' Evening\nRendezvous on Saturday September 13 from 7pm at Salle Sagot\nReservations required by August 29 on 07 61 61 70 69 or 06 73 86 78 46"
        ],
        "it": [
          "L'Amicale des Sapeurs Pompiers de Fruges organizza una serata dedicata ai pompieri\nAppuntamento sabato 13 settembre dalle 19.00 alla Salle Sagot\nI pasti devono essere prenotati entro il 29 agosto al numero 07 61 61 70 69 o 06 73 86 78 46"
        ],
        "fr": [
          "L'Amicale des Sapeurs Pompiers de Fruges organise leur soirée des pompiers\nRendez-vous le samedi 13 septembre à partir de 19h à la Salle Sagot\nRepas sur réservation avant le 29 août au 07 61 61 70 69 ou 06 73 86 78 46"
        ],
        "es": [
          "La Amicale des Sapeurs Pompiers de Fruges organiza una velada de bomberos\nCita el sábado 13 de septiembre a partir de las 19.00 h en la Salle Sagot\nLas comidas deben reservarse antes del 29 de agosto llamando al 07 61 61 70 69 o al 06 73 86 78 46"
        ],
        "nl": [
          "De Amicale des Sapeurs Pompiers de Fruges organiseert een brandweeravond\nAfspraak op zaterdag 13 september vanaf 19 uur in de Sagotzaal\nMaaltijden moeten worden gereserveerd vóór 29 augustus op 07 61 61 70 69 of 06 73 86 78 46"
        ]
      },
      "@type": [
        "Description"
      ],
