  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0f2fd398-a079-35ff-9b75-08c5f8313db4",
      "dc:description": {
        "de": [
          "Das Reitzentrum von Picquigny überragt das Tal der Somme. Es bietet zahlreiche Aktivitäten an: Pony-Club, Dressur, CCE, CSO, traditionelles Reiten, Arbeitsreiten, TREC, Coaching Wettbewerbe, Pension, Ausflüge ins Somme-Tal"
        ],
        "en": [
          "The Picquigny riding school overlooks the Somme valley. It offers many activities: Pony club, dressage, CCE, CSO traditional riding, work riding, TREC, coaching competition, boarding, walks in the Somme valley.."
        ],
        "it": [
          "Il centro ippico di Picquigny si affaccia sulla valle della Somme. Offre numerose attività: Pony-club, dressage, CCE, CSO equitazione tradizionale, equitazione da lavoro, TREC, coaching da competizione, pensione, passeggiate nella valle della Somme"
        ],
        "fr": [
          "Le centre équestre de Picquigny domine la vallée de la Somme. Il propose de nombreuses activités : Poney-club, dressage, CCE, CSO équitation de tradition, équitation de travail , TREC, coaching concours, pension, balade en vallée de Somme"
        ],
        "es": [
          "El centro ecuestre de Picquigny domina el valle del Somme. Ofrece muchas actividades: Pony-club, doma, CCE, equitación tradicional CSO, equitación de trabajo, TREC, entrenamiento de competición, pensión, paseos por el valle del Somme"
        ],
        "nl": [
          "De manege van Picquigny kijkt uit over de vallei van de Somme. Het biedt vele activiteiten: Pony-club, dressuur, CCE, CSO traditioneel paardrijden, werkpaardrijden, TREC, competitie coaching, pension, ritten in de Somme vallei"
        ]
      },
