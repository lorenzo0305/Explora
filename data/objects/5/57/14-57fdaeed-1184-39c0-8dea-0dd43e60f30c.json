  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cc6d9eaf-72c9-340e-ac19-e7249ee92c2b",
      "dc:description": {
        "de": [
          "Nehmen Sie mit Ihrer Familie an diesem Workshop teil, um die Geschichte des Standorts des Louvre-Lens zu entdecken, die Merkmale des Museumsparks zu entschlüsseln und anschließend Ihr Modell des Ortes zu erstellen!"
        ],
        "en": [
          "Take part in this family workshop to discover the history of the Louvre-Lens site, decipher the characteristics of the park-museum before creating your own model of the place!"
        ],
        "it": [
          "Partecipate a questo laboratorio per famiglie per scoprire la storia del sito Louvre-Lens, decifrare le caratteristiche del parco-museo prima di creare il vostro modello del sito!"
        ],
        "fr": [
          "Participez en famille à cet atelier pour découvrir l’histoire du site du Louvre-Lens, décrypter les caractéristiques du musée-parc avant de créer votre maquette du lieu !"
        ],
        "es": [
          "Participe en este taller familiar para descubrir la historia del sitio del Louvre-Lens, descifrar las características del parque-museo antes de crear su propia maqueta del sitio"
        ],
        "nl": [
          "Neem deel aan deze familieworkshop om de geschiedenis van de Louvre-Lens site te ontdekken, de kenmerken van het park-museum te ontcijferen alvorens je eigen maquette van de site te maken!"
        ]
      },
