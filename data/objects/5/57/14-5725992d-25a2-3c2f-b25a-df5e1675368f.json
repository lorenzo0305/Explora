  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d34c8c7f-018b-364e-92b7-fb6cea996fd6",
      "dc:description": {
        "de": [
          "Treffen Sie sich am Samstag, den 30. August im Dorfzentrum von Hézecques zu den Intervillages-Spielen\nAb 10.30 Uhr - Eintritt frei\nGetränke und Essen mittags und abends"
        ],
        "en": [
          "Join us on Saturday August 30 in the village center of Hézecques for the Intervillage Games\nFrom 10:30 am - Free admission\nRefreshment bar and catering for lunch and dinner"
        ],
        "it": [
          "Sabato 30 agosto, nel centro del villaggio di Hézecques, partecipate ai Giochi di Intervillaggio\nDalle ore 10.30 - Ingresso libero\nBar e ristorante per pranzo e cena"
        ],
        "fr": [
          "Rendez-vous le samedi 30 août au centre du village de Hézecques pour les Jeux Intervillages\nÀ partir de 10h30 - Entrée gratuite\nBuvette et restauration midi et soir"
        ],
        "es": [
          "Únete a nosotros el sábado 30 de agosto en el centro del pueblo de Hézecques para los Juegos Intervillage\nA partir de las 10.30 h - Entrada gratuita\nBar y restaurante para comer y cenar"
        ],
        "nl": [
          "Kom op zaterdag 30 augustus naar het dorpscentrum van Hézecques voor de Intervillagespelen\nVanaf 10.30 uur - Gratis toegang\nBar en restaurant voor lunch en diner"
        ]
      },
