  "rdfs:comment": {
    "de": [
      "Eine trendige Einrichtung, frische und saisonale Produkte, die jeden Tag für Sie gekocht werden, und eine schöne Dekoration mit einer warmen Atmosphäre - hier werden Sie sehr gut empfangen."
    ],
    "en": [
      "With its trendy decor, fresh seasonal produce cooked for you every day, and warm, welcoming atmosphere, you'll be made to feel right at home."
    ],
    "it": [
      "L'arredamento di tendenza, i prodotti freschi di stagione cucinati ogni giorno e l'atmosfera calda e accogliente vi faranno sentire come a casa vostra."
    ],
    "fr": [
      "Un décor branché, des produits frais et de saisons cuisinés pour vous chaque jour avec une belle décoration à l'atmosphère chaleureuse, vous y serez très bien accueillis."
    ],
    "nl": [
      "Met zijn trendy inrichting, verse seizoensproducten die elke dag voor je worden gekookt en warme, gastvrije sfeer voel je je meteen thuis."
    ],
    "es": [
      "Con una decoración moderna, productos frescos de temporada cocinados a diario y un ambiente cálido y acogedor, se sentirá como en casa."
    ]
  },
