  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7d61b527-e653-3138-8e19-b57b02991009",
      "dc:description": {
        "de": [
          "Der Verein Magnificent ist auf die Organisation von künstlerischen und gastronomischen Erlebnissen spezialisiert. Wir alle haben eine Leidenschaft für Geschichte, Kulturerbe und darstellende Kunst."
        ],
        "en": [
          "The Magnificent association is specialized in the organization of artistic and gastronomic experiences. We are all passionate about history, heritage and live performance."
        ],
        "it": [
          "L'associazione Magnificent è specializzata nell'organizzazione di esperienze artistiche e gastronomiche. Siamo tutti appassionati di storia, patrimonio e intrattenimento dal vivo."
        ],
        "fr": [
          "L'association Magnificent est spécialisée dans l'organisation d'expériences artistiques et gastronomiques. Nous sommes tous des passionnés d'histoire, de patrimoine et de spectacle vivant."
        ],
        "nl": [
          "The Magnificent association is gespecialiseerd in het organiseren van artistieke en gastronomische ervaringen. We zijn allemaal gepassioneerd door geschiedenis, erfgoed en live entertainment."
        ],
        "es": [
          "La asociación Magnificent está especializada en la organización de experiencias artísticas y gastronómicas. Nos apasiona la historia, el patrimonio y el espectáculo en vivo."
        ]
      },
