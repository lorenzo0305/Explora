      "@id": "https://data.datatourisme.fr/0fb918be-db71-3b1b-8326-80f38e84fedf",
      "dc:description": {
        "de": [
          "Hübsche kleine Terrasse in einem der schönsten Dörfer Frankreichs. Jean Pierre bietet Ihnen leckere Crêpes und Getränke aus der Region an."
        ],
        "en": [
          "Nice little terrace located in one of the Most Beautiful Villages of France, Jean Pierre offers you delicious pancakes and local drinks."
        ],
        "it": [
          "Piccola terrazza situata in uno dei più bei villaggi della Francia, Jean Pierre offre deliziose crêpes e bevande locali."
        ],
        "fr": [
          "Jolie petite terrasse située dans l'un des Plus Beaux Villages de France, Jean Pierre vous propose de succulentes crêpes et des boissons du terroir."
        ],
        "es": [
          "Una pequeña y bonita terraza situada en uno de los pueblos más bonitos de Francia, Jean Pierre ofrece deliciosos crêpes y bebidas locales."
        ],
        "nl": [
          "Jean Pierre, een mooi terrasje in een van de mooiste dorpen van Frankrijk, biedt heerlijke crêpes en lokale drankjes."
        ]
      },
