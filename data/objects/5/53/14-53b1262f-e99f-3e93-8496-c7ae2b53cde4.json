  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0b4036de-dd26-3005-a4ab-f27ebb3d1dc2",
      "dc:description": {
        "de": [
          "Möglichkeit einer kostenpflichtigen kommentierten Besichtigung nach Vereinbarung.\n\nGeöffnet:\nMittwochs\n17.00 - 19.30 Uhr\nAm Freitag\n17.00 - 19.30 Uhr\nAm Samstag\n10.00 - 19.30 Uhr\nAm Sonntag\n10.00 - 12.30 Uhr"
        ],
        "en": [
          "Guided tours by appointment only.\n\nOpen on\nWednesday\n5:00 pm - 7:30 pm\nFriday\n5:00 pm - 7:30 pm\nSaturday\n10h00 - 19h30\nSunday\n10h00 - 12h30"
        ],
        "it": [
          "Visite guidate a pagamento, solo su appuntamento.\n\nAperto il\nMercoledì\ndalle 17.00 alle 19.30\nVenerdì\ndalle 17.00 alle 19.30\nSabato\ndalle 10.00 alle 19.30\nDomenica\ndalle 10.00 alle 12.30"
        ],
        "fr": [
          "Possibilité de visite commentée payante, sur rendez-vous.\n\nOuvert : \nLe Mercredi\n17h00 - 19h30 \nLe Vendredi\n17h00 - 19h30 \nLe Samedi\n10h00 - 19h30 \nLe Dimanche\n10h00 - 12h30"
        ],
        "es": [
          "Visitas guiadas de pago, previa cita.\n\nAbierto los\nMiércoles\nde 17.00 a 19.30 h\nViernes\nde 17.00 a 19.30 h\nSábado\n10.00 h - 19.30 h\nDomingo\n10.00 h - 12.30 h"
        ],
        "nl": [
          "Rondleidingen tegen betaling, alleen op afspraak.\n\nGeopend op\nWoensdag\n17.00 - 19.30 uur\nVrijdag\n17.00 - 19.30\nZaterdag\n10.00 - 19.30 uur\nZondag\n10.00 - 12.30 uur"
        ]
      },
