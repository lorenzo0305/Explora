  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9807d5dd-c867-3c12-8294-35be35999e91",
      "dc:description": {
        "de": [
          "Neues Konfektionsgeschäft auf dem Grand'Place in Montreuil, das auch einen kleinen Restaurantservice sowie einen Teesalon anbietet.\n\nÖffnungszeiten: Dienstag bis Samstag von 10 bis 19 Uhr."
        ],
        "en": [
          "New ready-to-wear store on Montreuil's Grand'Place, also offering a small catering service and a tea room.\n\nOpen Tuesday to Saturday, 10am to 7pm."
        ],
        "it": [
          "Un nuovo negozio di prêt-à-porter sulla Grand'Place di Montreuil, che offre anche un piccolo servizio di catering e una sala da tè.\n\nAperto dal martedì al sabato dalle 10.00 alle 19.00."
        ],
        "fr": [
          "Nouveau commerce de prêt-à-porter sur la Grand'Place de Montreuil proposant également un service de petite restauration, ainsi qu'un salon de thé.\n\nOuverture du mardi au samedi de 10h à 19h."
        ],
        "es": [
          "Una nueva tienda de prêt-à-porter en la Grand'Place de Montreuil, que también ofrece un pequeño servicio de restauración y un salón de té.\n\nAbierto de martes a sábado de 10.00 a 19.00 h."
        ],
        "nl": [
          "Een nieuwe confectiezaak op de Grand'Place in Montreuil, die ook een kleine cateringservice en een tearoom biedt.\n\nGeopend van dinsdag tot zaterdag van 10.00 tot 19.00 uur."
        ]
      },
