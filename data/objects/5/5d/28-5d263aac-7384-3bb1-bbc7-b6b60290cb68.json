  "rdfs:comment": {
    "de": [
      "Progetto Napoletano ist der Tempel der neapolitanischen Pizza, der ausschließlich dem Lieferservice und dem Verkauf zum Mitnehmen gewidmet ist.\n\nProgetto Napoletano ist der kleine Bruder von Papà Raffaele. Dieselbe Vision, dieselbe Seele im Produkt, derselbe Anspruch."
    ],
    "en": [
      "Progetto Napoletano is the temple of Neapolitan pizza, dedicated exclusively to delivery and takeaway.\n\nProgetto Napoletano is Papà Raffaele's little brother. Same vision, same soul in the product, same high standards."
    ],
    "it": [
      "Progetto Napoletano è il tempio della pizza napoletana, dedicato esclusivamente alla consegna e all'asporto.\n\nProgetto Napoletano è il fratello minore di Papà Raffaele. La stessa visione, la stessa anima nel prodotto, gli stessi standard elevati."
    ],
    "fr": [
      "Progetto Napoletano est le temple de la pizza napolitaine exclusivement dédié à la livraison et à la vente à emporter. \n\nProgetto Napoletano est le petit frère de Papà Raffaele. Même vision, même âme dans le produit, même exigence."
    ],
    "nl": [
      "Progetto Napoletano is de tempel van de Napolitaanse pizza, uitsluitend gewijd aan bezorging en afhaal.\n\nProgetto Napoletano is het kleine broertje van Papà Raffaele. Dezelfde visie, dezelfde ziel in het product, dezelfde hoge normen."
    ],
    "es": [
      "Progetto Napoletano es el templo de la pizza napolitana, dedicado exclusivamente al reparto y la comida para llevar.\n\nProgetto Napoletano es el hermano pequeño de Papà Raffaele. La misma visión, la misma alma en el producto, los mismos altos estándares."
    ]
  },
