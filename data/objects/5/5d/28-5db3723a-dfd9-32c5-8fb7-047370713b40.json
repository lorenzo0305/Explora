  "rdfs:comment": {
    "de": [
      "Das für seine Umwelt und nachhaltige Entwicklung sensibilisierte Les Tourelles legt Wert auf die Beschaffung von Produkten aus kurzen Wegen bei lokalen Erzeugern, die der Chefkoch und sein Team das ganze Jahr über in einer familiären Atmosphäre für Sie entdecken."
    ],
    "en": [
      "Sensitive to its environment and to sustainable development, Les Tourelles promotes the sourcing of short-distance produce from local producers, which the Chef and his team will introduce you to all year round in a family atmosphere."
    ],
    "it": [
      "Sensibile all'ambiente e allo sviluppo sostenibile, Les Tourelles promuove l'approvvigionamento di prodotti da produttori locali, che lo chef e il suo team vi faranno conoscere tutto l'anno in un'atmosfera familiare."
    ],
    "fr": [
      "Sensible à son environnement et au développement durable, les Tourelles  valorise  l'approvisionnement de produits en circuits courts, chez les producteurs locaux, que le Chef et son équipe vous font découvrir toute l'année dans une ambiance familiale."
    ],
    "es": [
      "Sensible al medio ambiente y al desarrollo sostenible, Les Tourelles promueve el aprovisionamiento de productos de productores locales, que el Chef y su equipo le presentarán durante todo el año en un ambiente familiar."
    ],
    "nl": [
      "Les Tourelles, gevoelig voor het milieu en duurzame ontwikkeling, promoot de aankoop van producten van lokale producenten, waar de chef-kok en zijn team je het hele jaar door in een familiale sfeer mee laten kennismaken."
    ]
  },
