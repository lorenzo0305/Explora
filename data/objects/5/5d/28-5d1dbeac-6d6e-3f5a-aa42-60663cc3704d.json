  "rdfs:comment": {
    "de": [
      "Diese Kirche, deren älteste Teile aus dem 13. Jahrhundert stammen, wurde im Stil der Flamboyant-Gotik errichtet."
    ],
    "en": [
      "This church, the oldest parts of which date back to the 13th century, is in flamboyant gothic style."
    ],
    "it": [
      "Questa chiesa, le cui parti più antiche risalgono al XIII secolo, è in stile gotico fiammeggiante."
    ],
    "fr": [
      "Cette église, dont les parties les plus anciennes remontent au XIIIe siècle, est de style gothique flamboyant."
    ],
    "es": [
      "Esta iglesia, cuyas partes más antiguas datan del siglo XIII, es de estilo gótico flamígero."
    ],
    "nl": [
      "Deze kerk, waarvan de oudste delen dateren uit de 13e eeuw, is uitgevoerd in de flamboyante gotische stijl."
    ]
