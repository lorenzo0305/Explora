  "rdfs:comment": {
    "de": [
      "Für Anfänger, Fortgeschrittene, Sportler, weniger Sportliche, Reiter auf der Durchreise, Turnierreiter, Neugierige!!!\nVon der Entdeckung bis zur Perfektionierung, in Le Lonval finden Sie bestimmt etwas, das Ihnen Freude bereitet!\nEin qualitativ hochwertiger Unterricht, eine angepasste Reiterei!\n\nSie können von 30-minütigen Ponytaufen profitieren."
    ],
    "en": [
      "For beginners, experienced riders, sportsmen and women, recreational riders, competition riders, the curious!!!!\nFrom discovery to improvement, you're sure to find something to please you at Lonval!\nHigh-quality teaching and specially adapted equipment!\n\nWe also offer 30-minute pony baptisms."
    ],
    "it": [
      "Per principianti, cavalieri esperti, sportivi, occasionali, agonisti e curiosi!\nDai principianti ai cavalieri esperti, a Lonval troverete sicuramente qualcosa che vi soddisfa!\nInsegnamento di alta qualità e attrezzature appositamente adattate!\n\nÈ possibile usufruire di battesimi di pony della durata di 30 minuti."
    ],
    "fr": [
      "Pour les débutants, les confirmés, les sportifs, les moins sportifs, les cavaliers de passage, les cavaliers de concours, les curieux!!!\nDe la découverte au perfectionnement, vous trouverez forcément au Lonval  de quoi vous faire plaisir!!\nUn enseignement de qualité, une cavalerie adaptée!\n\nVous pouvez profiter de baptêmes de poney de 30 minutes."
    ],
    "nl": [
      "Voor beginners, ervaren ruiters, sportievelingen, gelegenheidsruiters, wedstrijdruiters en nieuwsgierigen!\nVan beginners tot gevorderden, bij Lonval vind je zeker je gading!\nKwalitatief hoogstaande lessen en aangepast materiaal!\n\nJe kunt profiteren van ponydopen van 30 minuten."
    ],
    "es": [
      "Para principiantes, jinetes experimentados, deportistas, jinetes ocasionales, jinetes de competición y curiosos\nDesde principiantes hasta jinetes avanzados, en Lonval encontrará lo que busca\nEnseñanza de calidad y material adaptado\n\nPodrá disfrutar de bautismos en poni de 30 minutos."
    ]
  },
