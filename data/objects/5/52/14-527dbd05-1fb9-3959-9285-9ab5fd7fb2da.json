  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5aec5501-468b-32b6-b5c7-47f702fed7ec",
      "dc:description": {
        "de": [
          "Pommes Frites, Hamberger und Amerikaner.\n\nGeöffnet Dienstag bis Freitag von 18:00 bis 21:00 Uhr\nSamstag von 12h bis 14h\nSamstag- und Sonntagabend von 18:00 bis 22:00 Uhr\nMontags geschlossen."
        ],
        "en": [
          "French fry shop, hambergers and Americans.\n\nOpen Tuesday to Friday, 6pm to 9pm\nSaturday from 12h to 14h\nSaturday and Sunday evenings from 6pm to 10pm\nClosed on Mondays."
        ],
        "it": [
          "Negozio di patatine, hamburger e americani.\n\nAperto da martedì a venerdì, dalle 18.00 alle 21.00\nSabato dalle 12.00 alle 14.00\nSabato e domenica sera dalle 18.00 alle 22.00\nChiuso il lunedì."
        ],
        "fr": [
          "Friterie, hambergers et américains.\n\nOuvert du mardi au vendredi de 18h à 21h \nSamedi de 12h à 14h\nSamedi et dimanche soir de 18h à 22h \nFermé le lundi."
        ],
        "nl": [
          "Friettent, hamburgers en Amerikanen.\n\nGeopend van dinsdag tot vrijdag van 18.00 tot 21.00 uur\nZaterdag van 12 tot 14 uur\nZaterdag- en zondagavond van 18.00 tot 22.00 uur\nGesloten op maandag."
        ],
        "es": [
          "Chip shop, hambergers y americanos.\n\nAbierto de martes a viernes de 18.00 a 21.00 h\nSábados de 12h a 14h\nSábados y domingos por la noche de 18.00 a 22.00 h\nCerrado los lunes."
        ]
      },
