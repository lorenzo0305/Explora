  "rdfs:comment": {
    "de": [
      "Entdecken Sie die Goji-Plantage der Picardie, kleiden Sie sich dem Wetter entsprechend und tragen Sie Schuhe, um durch die Landschaft zu wandern, Ihre Augen und Geschmacksnerven werden es Ihnen danken."
    ],
    "en": [
      "Come and discover the Picardy Goji plantation, dressed for the weather and with shoes for walking in the countryside, your eyes and taste buds will thank you."
    ],
    "it": [
      "Venite a scoprire la piantagione di Goji della Piccardia, vestiti per il tempo e con scarpe adatte alle passeggiate in campagna: i vostri occhi e le vostre papille gustative vi ringrazieranno."
    ],
    "fr": [
      "Venez découvrir la plantation Goji de Picardie, vêtus selon la météo et chaussés pour marcher dans la campagne, vos yeux et papilles vous remercieront."
    ],
    "es": [
      "Venga a descubrir la plantación de Goji de Picardía, vestido para el tiempo y con calzado para caminar por el campo. Sus ojos y sus papilas gustativas se lo agradecerán."
    ],
    "nl": [
      "Kom de Picardische Goji-plantage ontdekken, gekleed op het weer en met schoenen voor een wandeling in de natuur. Je ogen en smaakpapillen zullen je dankbaar zijn."
    ]
  },
