  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a012d83f-77ad-39b9-9133-29ed65df542e",
      "dc:description": {
        "de": [
          "Besuchen Sie die Ausstellung in 9-9bis und machen Sie anschließend Fingergymnastik (okay, ein Stickworkshop?). Sie werden mit Ihrem gestickten Zitat nach Hause gehen und keine Ausrede mehr haben, Ihre nächste Sportstunde zu verpassen!"
        ],
        "en": [
          "Join us at 9-9bis for a tour of the exhibition, followed by a session of finger gymnastics (well, okay, an embroidery workshop?). You'll leave with your own embroidered quote, and no excuse to miss your next workout!"
        ],
        "it": [
          "Unitevi a noi alle 9-9bis per una visita alla mostra, seguita da una sessione di ginnastica con le dita (ok, un laboratorio di ricamo?). Tornerete a casa con la vostra citazione ricamata, così non avrete più scuse per perdere la prossima sessione di sport!"
        ],
        "fr": [
          "Rendez-vous au 9-9bis pour une visite de l’exposition suivie d’une séance de gymnastique des doigts (bon, ok, un atelier broderie…). Vous repartirez avec votre citation brodée et n’aurez plus aucune excuse pour louper votre prochaine séance de sport !"
        ],
        "nl": [
          "Kom naar 9-9 bis voor een rondleiding door de tentoonstelling, gevolgd door een sessie vingergymnastiek (oké, een borduurworkshop?). Je gaat naar huis met je eigen geborduurde quote, zodat je geen excuus hebt om je volgende sportsessie te missen!"
        ],
        "es": [
          "Acompáñanos a las 9-9bis para visitar la exposición, seguida de una sesión de gimnasia de dedos (vale, ¿un taller de bordado?). Te irás a casa con tu propia cita bordada, ¡así que no tendrás excusa para perderte tu próxima sesión de deporte!"
        ]
      },
