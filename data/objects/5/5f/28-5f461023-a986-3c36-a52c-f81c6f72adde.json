  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0c1fb94e-62bf-35db-a8a8-801bdf15e217",
      "dc:description": {
        "de": [
          "Zeitgenössisches Restaurant und Bistro mit südländischen Akzenten .\nEinfallsreiche und großzügige Küche. Private Terrasse im Sommer und Cateringservice. Workshops und Kochkurse.  Geschäfts- und Gruppenessen. Angenehmer und aufmerksamer Service."
        ],
        "en": [
          "Contemporary restaurant and bistro with southern accents.\nInventive and generous cuisine. Private terrace in the summer and catering service. Workshops and cooking classes.  Business and group meals. Pleasant and attentive service."
        ],
        "it": [
          "Ristorante e bistrot contemporaneo con accento meridionale.\nCucina inventiva e generosa. Terrazza privata in estate e servizio di catering. Laboratori e corsi di cucina.  Pasti aziendali e di gruppo. Servizio piacevole e attento."
        ],
        "fr": [
          "Restaurant et bistrot contemporain aux accents du Sud .\nCuisine inventive et généreuse. Terrasse privée l'été et service traiteur. Ateliers et cours de cuisine.  Repas d'affaires et de groupes. Service agréable et attentionné."
        ],
        "es": [
          "Restaurante y bistró contemporáneo con acento sureño.\nCocina inventiva y generosa. Terraza privada en verano y servicio de catering. Talleres y clases de cocina.  Comidas de empresa y de grupo. Servicio agradable y atento."
        ],
        "nl": [
          "Hedendaags restaurant en bistro met een zuidelijk accent.\nInventieve en genereuze keuken. Privé terras in de zomer en catering service. Workshops en kooklessen.  Zaken- en groepsmaaltijden. Aangename en attente bediening."
        ]
      },
