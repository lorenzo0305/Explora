  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9ac98298-28cc-3847-8291-d67c5b4cf1e5",
      "dc:description": {
        "de": [
          "Jahrestag der Franco-Amerikanischen Stiftung\nAusstellungen in der Villa Normande, im Centre Jacques Calvé, Jacques Calvé und seine Frau Regina Dravo, vom Pasteur-Krankenhaus zum Institut für Krankenpflege (à l'IFSI) , vom Lernzentrum zu Trajectoires (Rang du Fliers)\nJeden Tag von 14.00 bis 17.00 Uhr\nInfos: Françoise DUFOUR\nMail: dufourfr@fondation-hopale.org\nTel: +33 (0)6.83.49.00.46"
        ],
        "en": [
          "Anniversary of the Franco-American Foundation\nExhibitions at the Villa Normande, the Centre Jacques Calvé, Jacques Calvé and his wife Régina Dravo, from the Hôpital Pasteur to the Institut de soins infirmiers (IFSI) , from the Centre d'apprentissage to Trajectoires (Rang du Fliers)\nEvery day from 2pm to 5pm\nInfo: Françoise DUFOUR\nMail: dufourfr@fondation-hopale.org\nTel: +33 (0)6.83.49.00.46"
        ],
        "it": [
          "Anniversario della Fondazione franco-americana\nMostre a Villa Normande, al Centre Jacques Calvé, a Jacques Calvé e a sua moglie Régina Dravo, dall'Hôpital Pasteur all'Institut de soins infirmiers (IFSI), dal centro di apprendistato a Trajectoires (Rang du Fliers)\nTutti i giorni dalle 14.00 alle 17.00\nInformazioni: Françoise DUFOUR\nMail: dufourfr@fondation-hopale.org\nTel : +33 (0)6.83.49.00.46"
        ],
        "fr": [
          "Anniversaire de la Fondation Franco-Américaine \nExpositions à la Villa Normande, au Centre Jacques Calvé, Jacques Calvé et son épouse Régina Dravo, de l'hôpital Pasteur à l'institut de soins infirmiers (à l'IFSI) , du centre d'apprentissage à Trajectoires (Rang du Fliers)\nTous les jours de 14h à 17h \nInfos : Françoise DUFOUR\nMail : dufourfr@fondation-hopale.org \nTel : +33 (0)6.83.49.00.46"
        ],
        "nl": [
          "Verjaardag van de Frans-Amerikaanse Stichting\nTentoonstellingen in de Villa Normande, het Centre Jacques Calvé, Jacques Calvé en zijn vrouw Régina Dravo, van het Hôpital Pasteur tot het Institut de soins infirmiers (IFSI), van het centre d'apprentissage tot Trajectoires (Rang du Fliers)\nElke dag van 14u tot 17u\nInformatie: Françoise DUFOUR\nMail: dufourfr@fondation-hopale.org\nTel : +33 (0)6.83.49.00.46"
        ],
        "es": [
          "Aniversario de la Fundación Franco-Americana\nExposiciones en la Villa Normande, el Centre Jacques Calvé, Jacques Calvé y su esposa Régina Dravo, del Hôpital Pasteur al Institut de soins infirmiers (IFSI), del centre d'apprentissage a Trajectoires (Rang du Fliers)\nTodos los días de 14.00 a 17.00 h\nInformación: Françoise DUFOUR\nCorreo electrónico: dufourfr@fondation-hopale.org\nTel : +33 (0)6.83.49.00.46"
        ]
      },
