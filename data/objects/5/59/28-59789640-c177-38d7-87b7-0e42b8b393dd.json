  "rdfs:comment": {
    "de": [
      "Spezialität: Fleisch vom Charolais-Rind\nVerkauf von Charolais-Fleisch (im Einzelhandel oder als Paket) auf Bestellung\nDirektverkauf, damit Sie von der Qualität des auf dem Hof erzeugten Fleisches profitieren können.\nDer Betrieb ist auf eine nachhaltige Landwirtschaft ausgerichtet und respektiert die Umwelt und das Wohlergehen der Tiere."
    ],
    "en": [
      "Specialty: Charolais meat\nSale of Charolais meat (retail or parcel) on order\nDirect sale so that you can benefit from the quality of the meat produced on the farm.\nFarming oriented towards a sustainable agriculture and respectful of its environment and animal welfare."
    ],
    "it": [
      "Specialità: carne Charolais\nVendita di carne Charolais (al dettaglio o in parcella) su ordinazione\nVendita diretta per poter godere della qualità della carne prodotta in azienda.\nUn'agricoltura orientata alla sostenibilità e rispettosa dell'ambiente e del benessere degli animali."
    ],
    "fr": [
      "Spécialité : viande charolaise\nVente de viande charolaise (au détail ou colis) sur commande. \nVente directe de manière à vous faire profiter de la qualité de la viande produits à la ferme.\nExploitation orientée vers une agriculture durable et respectueuse de son environnement ainsi que du bien-être des animaux."
    ],
    "nl": [
      "Specialiteit: Charolais vlees\nVerkoop van Charolais vlees (detailhandel of percelen) op bestelling\nRechtstreekse verkoop zodat u kunt genieten van de kwaliteit van het vlees dat op de boerderij wordt geproduceerd.\nLandbouw gericht op duurzame landbouw en met respect voor het milieu en dierenwelzijn."
    ],
    "es": [
      "Especialidad: Carne de Charolais\nVenta de carne Charolais (al por menor o en parcela) por encargo\nVenta directa para que pueda disfrutar de la calidad de la carne producida en la granja.\nExplotación orientada a la agricultura sostenible y respetuosa con el medio ambiente y el bienestar de los animales."
    ]
  },
  "rdfs:label": {
