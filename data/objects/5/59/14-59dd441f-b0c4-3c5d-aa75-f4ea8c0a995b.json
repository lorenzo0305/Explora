      "@id": "https://data.datatourisme.fr/2046ccae-0e07-3833-8e7b-a3679424b41e",
      "dc:description": {
        "de": [
          "Besuchen Sie das Konzert von \"Gospel's French Voices\" am Samstag, den 2. August 2025 um 21 Uhr in der Salle de la baie Saint Jean in Wimereux\nEintrittspreis: 12 Euro\nKostenlos für Kinder unter 12 Jahren\n\nAuf Reservierungen"
        ],
        "en": [
          "Attend the \"Gospel's French Voices\" concert on Saturday, August 2, 2025 at 9pm at the Salle de la Baie Saint Jean in Wimereux\nPrice: 12 euros\nFree for children under 12\n\nOn reservation"
        ],
        "it": [
          "Venite a vedere il concerto \"Gospel's French Voices\" sabato 2 agosto 2025 alle 21.00 alla Salle de la Baie Saint Jean di Wimereux\nPrezzo: 12 euro\nGratuito per i bambini sotto i 12 anni\n\nSu prenotazione"
        ],
        "fr": [
          "Venez assister au concert de \"Gospel's French Voices\" le samedi 2 août 2025 à 21 heures à la salle de la baie Saint Jean à Wimereux\nTarif : 12 euros\nGratuit pour les moins de 12 ans\n\nSur réservations"
        ],
        "es": [
          "Venga a ver el concierto \"Gospel's French Voices\" el sábado 2 de agosto de 2025 a las 21:00 h en la Salle de la Baie Saint Jean de Wimereux\nPrecio: 12 euros\nGratis para menores de 12 años\n\nCon reserva previa"
        ],
        "nl": [
          "Kom kijken naar het concert \"Gospel's French Voices\" op zaterdag 2 augustus 2025 om 21.00 uur in de Salle de la Baie Saint Jean in Wimereux\nPrijs: 12 euro\nGratis voor kinderen onder 12 jaar\n\nOp reservering"
        ]
      },
