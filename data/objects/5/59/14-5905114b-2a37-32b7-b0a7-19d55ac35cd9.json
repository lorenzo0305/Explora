  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5087d61-9ba8-35b2-bfd8-627e8352e03a",
      "dc:description": {
        "de": [
          "Schweine, die vollständig mit Getreide vom Bauernhof gefüttert werden (Verkauf als zerlegter Halbschweineschlachtkörper, in 20-kg-Kisten oder im Einzelhandel). Wurstwaren (Knochenschinken- und Barbecue-Spezialitäten, Andouille, Wurst, Rillettes, Pasteten, Mortadella)."
        ],
        "en": [
          "Pigs entirely fed with farm cereals (sale in cut-up half-pig carcass, in 20 kg boxes or retail). Delicatessen (ham specialities on the bone and barbecues, andouille, sausage, rillettes, pâtés, mortadella)."
        ],
        "it": [
          "Suini alimentati interamente con i cereali dell'azienda (vendita di carcasse in scatole da 20 kg o al dettaglio). Delicatessen (prosciutto con osso e specialità al barbecue, andouille, salsiccia, rillettes, paté, mortadella)."
        ],
        "fr": [
          "Porcs entièrement nourris aux céréales de la ferme (vente en carcasse demi-porc découpé, en caissette de 20 kgs ou au détail). Charcuteries (spécialités jambon à l'os et barbecues, andouille, saucisson, rillettes, pâtés, mortadelle)."
        ],
        "nl": [
          "Varkens die volledig met granen van het bedrijf worden gevoederd (verkoop van karkassen in dozen van 20 kg of in de detailhandel). Delicatessen (beenham en barbecuespecialiteiten, andouille, worst, rillettes, patés, mortadella)."
        ],
        "es": [
          "Cerdos alimentados íntegramente con cereales de la explotación (venta de canales en cajas de 20 kg o al por menor). Charcutería (jamón con hueso y especialidades de barbacoa, andouille, salchichas, rillettes, patés, mortadela)."
        ]
      },
