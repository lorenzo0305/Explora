  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f6be046a-a421-3f98-a798-29d3da87bbf6",
      "dc:description": {
        "de": [
          "Typisches ehemaliges Gasthaus mit gedämpftem Rahmen, ideal für ein Essen zu zweit, geschäftlich oder mit der Familie. Die Philosophie dieses Maître Restaurateurs: Ein gutes Gericht kann nur mit guten Produkten zubereitet werden."
        ],
        "en": [
          "A typical old inn in a cosy setting, ideal for romantic, business or family meals. The philosophy of this Master Restaurateur: a good dish can only be made with good products."
        ],
        "it": [
          "Un'antica locanda tipica in un ambiente accogliente, ideale per pranzi romantici, di lavoro o in famiglia. La filosofia di questo Maestro Ristoratore: un buon piatto può essere fatto solo con buoni prodotti."
        ],
        "fr": [
          "Ancienne auberge typique au cadre feutré, idéal pour les repas en amoureux, d'affaires ou en famille. La philosophie de ce Maître Restaurateur : un bon plat ne peut être fait qu'avec de bons produits."
        ],
        "es": [
          "Una antigua posada típica en un entorno acogedor, ideal para comidas románticas, de negocios o familiares. La filosofía de este Maestro Restaurador: un buen plato sólo puede hacerse con buenos productos."
        ],
        "nl": [
          "Een typische oude herberg in een gezellige omgeving, ideaal voor romantische, zakelijke of familiediners. De filosofie van deze meester-restaurateur: een goed gerecht kan alleen worden gemaakt met goede producten."
        ]
      },
      "@type": [
        "Description"
      ],
