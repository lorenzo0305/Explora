  "rdfs:comment": {
    "de": [
      "Der Coteau de la Garenne ist ein 1,5 Hektar großes Gebiet, das als \"Natura-2000-Gebiet\" eingestuft ist und vom regionalen Konservatorium für Naturräume verwaltet wird. Freier Zugang über die Rue Jean Moulin. Die Kalksteinrasen beherbergen eine seltene und bedrohte Flora sowie eine vielfältige Fauna."
    ],
    "en": [
      "The Coteau de la Garenne is a 1.5-hectare area classified as a \"Natura 2000 Zone\" and managed by the region's Conservatoire d'Espaces Naturels. Free access via rue Jean Moulin. The limestone grasslands are home to a rare and endangered flora and fauna."
    ],
    "it": [
      "Il Coteau de la Garenne è un'area di 1,5 ettari classificata come zona Natura 2000 e gestita dal Conservatoire d'Espaces Naturels della regione. Accesso gratuito da rue Jean Moulin. Le praterie calcaree ospitano una flora e una fauna rare e minacciate."
    ],
    "fr": [
      "Le Coteau de la Garenne est un espace d'1,5 hectares classé \"Zone Natura 2000\" géré par le Conservatoire d'Espaces Naturels de la région. Accès libre par la rue Jean Moulin. Les pelouses calcicoles abritent une flore rare et menacée ainsi qu'une faune variée."
    ],
    "nl": [
      "Het Coteau de la Garenne is een gebied van 1,5 hectare dat is geclassificeerd als Natura 2000-gebied en wordt beheerd door het Conservatoire d'Espaces Naturels in de regio. Gratis toegang via de rue Jean Moulin. De kalkgraslanden herbergen een zeldzame en bedreigde flora en fauna."
    ],
    "es": [
      "El Coteau de la Garenne es un espacio de 1,5 hectáreas clasificado como zona Natura 2000 y gestionado por el Conservatoire d'Espaces Naturels de la región. Acceso gratuito por la calle Jean Moulin. Las praderas calcáreas albergan una flora y fauna raras y amenazadas."
    ]
  },
