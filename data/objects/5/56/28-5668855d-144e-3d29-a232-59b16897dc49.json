      "dc:description": {
        "de": [
          "In seiner Brasserie bietet Ihnen der Chefkoch jeden Tag ein anderes Menü an.  Auf Wunsch können die Gerichte auch zum Mitnehmen mitgenommen werden."
        ],
        "en": [
          "In the Brasserie, the chef offers you a different menu every day.  On request, the dishes can be taken away."
        ],
        "it": [
          "Nella Brasserie, lo chef propone un menu diverso ogni giorno.  Su richiesta, i piatti possono essere portati via."
        ],
        "fr": [
          "Au sein de sa Brasserie, le chef cuisinier vous propose un menu différent chaque jour.  Sur demande, les plats peuvent être pris à emporter."
        ],
        "nl": [
          "In de Brasserie biedt de chef elke dag een ander menu aan.  Op verzoek kunnen de gerechten worden meegenomen."
        ],
        "es": [
          "En la Brasserie, el chef ofrece un menú diferente cada día.  A petición, se pueden llevar los platos."
        ]
      },
