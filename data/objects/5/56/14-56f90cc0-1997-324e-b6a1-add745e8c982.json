  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/baf8b72c-f33e-3b18-a0fb-e3efa958393f",
      "dc:description": {
        "de": [
          "Nach einer Zeit der Entdeckung des Raumes, der dem täglichen Leben des prähistorischen Menschen gewidmet ist, werden unsere jungen Besucher und ihre Eltern aufgefordert, ihr Mammut zu zeichnen."
        ],
        "en": [
          "After exploring the space devoted to the daily life of prehistoric man, our young visitors and their parents will be invited to draw their own mammoth."
        ],
        "it": [
          "Dopo aver esplorato l'area dedicata alla vita quotidiana dell'uomo preistorico, i piccoli visitatori e i loro genitori saranno invitati a disegnare il loro mammut."
        ],
        "fr": [
          "Après un temps de découverte de l'espace consacré à la vie quotidienne de l'homme préhistorique, nos jeunes visiteurs et leurs parents seront invités à dessiner leur mammouth."
        ],
        "es": [
          "Tras explorar el espacio dedicado a la vida cotidiana del hombre prehistórico, nuestros jóvenes visitantes y sus padres serán invitados a dibujar su mamut."
        ],
        "nl": [
          "Na het verkennen van de ruimte die gewijd is aan het dagelijks leven van de prehistorische mens, worden onze jonge bezoekers en hun ouders uitgenodigd om hun mammoet te tekenen."
        ]
      },
