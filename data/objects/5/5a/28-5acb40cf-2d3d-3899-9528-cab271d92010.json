  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3bebdccf-af94-3c42-a0ba-a22f8ff27fc8",
      "dc:description": {
        "de": [
          "Restauration zum Mittagessen jeden Mittag außer Mittwoch und Sonntag. Bar, Cocktails usw. den Rest des Tages. Hausgemachte Knabbereien am Abend von 18 bis 20 Uhr, hausgemachtes Gebäck am Nachmittag."
        ],
        "en": [
          "Lunchtime catering every day except Wednesday and Sunday. Bar, cocktails, etc. the rest of the day. Home-made snacks in the evening from 6pm to 8pm, home-made pastries in the afternoon."
        ],
        "it": [
          "Ristorazione a pranzo tutti i giorni tranne il mercoledì e la domenica. Bar, cocktail, ecc. il resto della giornata. Spuntini fatti in casa la sera dalle 18.00 alle 20.00, dolci fatti in casa nel pomeriggio."
        ],
        "fr": [
          "Restauration au déjeuner tous les midis sauf mercredi et dimanche. Bar, cocktails, etc le reste de la journée. Grignoteries maison le soir de 18h à 20h, pâtisseries maison dans l'après midi."
        ],
        "nl": [
          "Catering tijdens lunchtijd, elke dag behalve woensdag en zondag. Bar, cocktails, enz. de rest van de dag. Zelfgemaakte snacks 's avonds van 18.00 tot 20.00 uur, zelfgemaakt gebak 's middags."
        ],
        "es": [
          "Catering a mediodía todos los días excepto miércoles y domingo. Bar, cócteles, etc. el resto del día. Aperitivos caseros por la tarde de 18:00 a 20:00, bollería casera por la tarde."
        ]
      },
