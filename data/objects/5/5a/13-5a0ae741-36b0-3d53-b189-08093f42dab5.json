  "rdfs:comment": {
    "de": [
      "Table d'hôtes und Mikro-Restaurant im Herzen von Trélon mit einem einzigartigen Menü, das jeden Monat wechselt. Dieses wird komplett hausgemacht und je nach Jahreszeit, Inspiration und Lust von Rémi zubereitet."
    ],
    "en": [
      "Table d'hôtes and micro restaurant in the heart of Trélon with a unique menu that changes every month. This one will be entirely home-made and according to the seasons, the inspirations and the desires of Rémi."
    ],
    "it": [
      "Table d'hôtes e micro ristorante nel cuore di Trélon con un menu unico che cambia ogni mese. Il menu sarà interamente fatto in casa e dipenderà dalle stagioni, dalle ispirazioni e dai desideri di Rémi."
    ],
    "fr": [
      "Table d'hôtes et micro restaurant au cœur de Trélon avec un menu unique qui change tous les mois. Celui-ci sera confectionné entièrement maison et en fonction des saisons, des inspirations et des envies de Rémi."
    ],
    "es": [
      "Table d'hôtes y micro restaurante en el corazón de Trélon con un menú único que cambia cada mes. El menú será totalmente casero y dependerá de las estaciones, las inspiraciones y los deseos de Rémi."
    ],
    "nl": [
      "Table d'hôtes en micro-restaurant in het hart van Trélon met een unieke kaart die elke maand verandert. Het menu is volledig huisgemaakt en hangt af van de seizoenen, Rémi's inspiratie en wensen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Table de Rémi"
    ]
  },
