  "rdfs:comment": {
    "de": [
      "Das Centre Culturel Municipal François Mitterrand ist ein wichtiger Ort im kulturellen Leben der Stadt Ternoise. Sein Programm bietet die Möglichkeit, Künstler zu treffen"
    ],
    "en": [
      "The Centre Culturel Municipal François Mitterrand is an essential part of the cultural life of the Tern area. Its programming offers the opportunity to meet artists"
    ],
    "it": [
      "Il Centro Culturale Municipale François Mitterrand è un luogo chiave della vita culturale della zona di Tern. Il suo programma offre la possibilità di incontrare artisti provenienti da tutto il mondo"
    ],
    "fr": [
      "Le Centre Culturel Municipal François Mitterrand est un lieu essentiel de la vie culturelle ternoise. Sa programmation permet d’aller à la rencontre d’artistes"
    ],
    "nl": [
      "Het Gemeentelijk Cultureel Centrum François Mitterrand is een belangrijke locatie in het culturele leven van het Tern-gebied. Het programma biedt de kans om artiesten van over de hele wereld te ontmoeten"
    ],
    "es": [
      "El Centro Cultural Municipal François Mitterrand es un lugar clave en la vida cultural de la región de Tern. Su programación ofrece la posibilidad de conocer a artistas de todo el mundo"
    ]
  },
