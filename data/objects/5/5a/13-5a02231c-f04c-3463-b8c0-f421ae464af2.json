  "rdfs:comment": {
    "de": [
      "Eingebettet im Herzen der Landschaft, nur wenige Schritte von Belgien entfernt, bietet Ihnen Le Baron, Restaurateur de l'Avesnois®, eine regionale Küche mit Terrasse am Flussufer. Vor Ort hergestellte Biere* und Boutique de l'Avesnois."
    ],
    "en": [
      "Nestled in the heart of the countryside, just a stone's throw from Belgium, Le Baron, restaurateur de l'Avesnois®, offers regional cuisine with a riverside terrace. On-site beers* and Avesnois boutique."
    ],
    "it": [
      "Immerso nel cuore della campagna, a due passi dal Belgio, Le Baron, restaurateur de l'Avesnois®, offre una cucina regionale con terrazza sul fiume. Birre* prodotte in loco e negozio Avesnois."
    ],
    "fr": [
      "Niché au cœur de la campagne, à quelques pas de la Belgique, le Baron, restaurateur de l'Avesnois®, vous propose une cuisine régionale avec terrasse en bord de rivière. Bières* fabriquées sur place et boutique de l'Avesnois."
    ],
    "nl": [
      "Le Baron, restaurateur de l'Avesnois®, is genesteld in het hart van het platteland, op een steenworp van België, en biedt regionale gerechten met een terras aan de rivier. Ter plaatse gebrouwen bieren* en Avesnois-winkel."
    ],
    "es": [
      "En plena naturaleza, a dos pasos de Bélgica, Le Baron, restaurateur de l'Avesnois®, ofrece cocina regional con terraza junto al río. Cervezas* de fabricación propia y tienda Avesnois."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Au Baron"
    ]
  },
