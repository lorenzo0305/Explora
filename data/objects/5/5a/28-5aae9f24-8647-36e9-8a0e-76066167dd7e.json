  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/11cffc1d-2737-3955-8b53-08c2c0f73fa2",
      "dc:description": {
        "de": [
          "Fahren Sie nach Napoli, Italien, und begeben Sie sich auf eine kulinarische Reise, die Ihre Geschmacksnerven umhauen wird! Der Chefkoch zaubert Ihnen eine Pizza aus italienischem Mehl und ausgewählten frischen Produkten!"
        ],
        "en": [
          "Head for Napoli, Italy, for a culinary journey that will blow your taste buds away! The chef prepares pizzas using Italian flour and selected fresh produce!"
        ],
        "it": [
          "Partite per Napoli, in Italia, per un viaggio culinario che vi lascerà a bocca aperta! Lo chef preparerà pizze con farina italiana e prodotti freschi selezionati!"
        ],
        "fr": [
          "Direction Napoli, en Italie, pour un voyage culinaire qui va épater vos papilles ! Le chef vous confectionne des pizza à base de farine italienne et de produits frais sélectionnés !"
        ],
        "es": [
          "Viaje a Nápoles (Italia) para disfrutar de una experiencia culinaria que dejará boquiabierto a su paladar El chef elaborará pizzas con harina italiana y productos frescos seleccionados"
        ],
        "nl": [
          "Ga naar Napels, Italië, voor een culinaire reis die je smaakpapillen versteld zal doen staan! De chef-kok maakt pizza's met Italiaans meel en geselecteerde verse producten!"
        ]
      },
