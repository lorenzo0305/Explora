  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2d9229cd-bdb8-3bba-b508-24c1f3b0c9f8",
      "dc:description": {
        "de": [
          "Lacenh Voices singt zum Internationalen Tag der Frauenrechte - Konzert am Sonntag, den 10. März 2024 in der Salle Sainte Gabrielle in Camiers um 16 Uhr\nInformationen und Kartenvorverkauf im Rathaus von Camiers - Preis: 10?"
        ],
        "en": [
          "Lacenh Voices sings for International Women's Rights Day - Concert on Sunday March 10, 2024 at the Salle Sainte Gabrielle in Camiers at 4pm\nInformation and tickets at Camiers Town Hall - Price: 10?"
        ],
        "it": [
          "Lacenh Voices canta per la Giornata internazionale dei diritti della donna - Concerto domenica 10 marzo 2024 presso la Salle Sainte Gabrielle di Camiers alle ore 16.00\nInformazioni e biglietti presso il Municipio di Camiers - Prezzo: 10?"
        ],
        "fr": [
          "Lacenh Voices chante pour la journée internationale des droits des femmes - Concert le dimanche 10 mars 2024 à la salle Sainte Gabrielle à Camiers à 16h - \nRenseignements et billetterie à la Mairie de Camiers - Tarif : 10€"
        ],
        "nl": [
          "Lacenh Voices zingt voor de Internationale Dag van de Rechten van de Vrouw - Concert op zondag 10 maart 2024 in de Salle Sainte Gabrielle in Camiers om 16.00 uur\nInformatie en kaartjes bij het gemeentehuis van Camiers - Prijs: 10?"
        ],
        "es": [
          "Lacenh Voices canta para el Día Internacional de los Derechos de la Mujer - Concierto el domingo 10 de marzo de 2024 en la Salle Sainte Gabrielle de Camiers a las 16h\nInformación y entradas en el Ayuntamiento de Camiers - Precio: 10?"
        ]
      },
      "@type": [
        "Description"
      ],
