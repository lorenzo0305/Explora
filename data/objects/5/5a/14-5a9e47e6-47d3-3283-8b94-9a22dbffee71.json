      "dc:description": {
        "de": [
          "Das Maison des Habitants des Communes du Frugeois organisiert Pétanque - Mölkky\nTreffpunkt am Dienstag, den 5. August von 14.30 bis 16.30 Uhr\nOffen für alle - Freier Eintritt"
        ],
        "en": [
          "La Maison des Habitants des Communes du Frugeois organizes a pétanque - mölkky event\nTuesday, August 5, 2:30 to 4:30 pm\nOpen to all - Free admission"
        ],
        "it": [
          "La Maison des Habitants des Communes du Frugeois organizza un evento di pétanque - mölkky\nAppuntamento martedì 5 agosto dalle 14.30 alle 16.30\nAperto a tutti - Ingresso libero"
        ],
        "fr": [
          "La Maison des Habitants des Communes du Frugeois organise une pétanque - mölkky\nRendez-vous le mardi 5 août de 14h30 à 16h30\nOuvert à tous - Entrée libre"
        ],
        "es": [
          "La Maison des Habitants des Communes du Frugeois organiza un encuentro de petanca y mölkky\nCita el martes 5 de agosto de 14.30 a 16.30 h\nAbierto a todos - Entrada gratuita"
        ],
        "nl": [
          "Het Maison des Habitants des Communes du Frugeois organiseert een petanque - mölkky evenement\nAfspraak op dinsdag 5 augustus van 14u30 tot 16u30\nOpen voor iedereen - Gratis toegang"
        ]
      },
