  "rdfs:comment": {
    "de": [
      "Genießen Sie auf dem Rooftop des Wassersportzentrums Les Bains du Lac den Blick auf den See bei einem Gericht aus frischen, saisonalen Produkten oder nehmen Sie einfach einen Snack nach Ihrem entspannten Nachmittag in Les Bains du Lac ein."
    ],
    "en": [
      "Enjoy the view of the lake from the Rooftop of the Bains du Lac aquatic area, while sampling a dish of fresh seasonal produce, or simply have a snack after a relaxing afternoon at the Bains du Lac."
    ],
    "it": [
      "Venite a godervi la vista del lago dal Rooftop del centro acquatico Bains du Lac mentre assaggiate un piatto a base di prodotti freschi e di stagione, o semplicemente fate uno spuntino dopo un pomeriggio di relax al Bains du Lac."
    ],
    "fr": [
      "Sur le Rooftop de l'espace aquatique les Bains du Lac, venez profiter de la vue sur le lac en dégustant un plat aux produits frais et de saison ou tout simplement prendre un goûter après votre après-midi détente aux Bains du Lac."
    ],
    "es": [
      "Venga a disfrutar de la vista del lago desde la azotea del centro acuático Bains du Lac mientras degusta un plato elaborado con productos frescos de temporada, o simplemente tome un tentempié tras una tarde de relax en los Bains du Lac."
    ],
    "nl": [
      "Kom genieten van het uitzicht op het meer vanaf het dak van het aquacentrum Bains du Lac terwijl u een gerecht proeft dat gemaakt is met verse, seizoensgebonden producten, of neem gewoon een snack na een ontspannen middag in de Bains du Lac."
    ]
  },
