  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e293776a-391d-3c0b-992b-42b78e847899",
      "dc:description": {
        "de": [
          "La Table Saint Firmin ist ein Restaurant, das direkt neben der Kathedrale im Stadtzentrum liegt. Es bietet seinen Gästen eine traditionelle Küche mit hausgemachten Gerichten aus frischen Produkten."
        ],
        "en": [
          "La Table Saint Firmin is a restaurant located right next to the Cathedral in the city centre. It offers its customers a traditional cuisine, homemade dishes based on fresh produce."
        ],
        "it": [
          "La Table Saint Firmin è un ristorante situato proprio accanto alla Cattedrale, nel centro della città. Offre ai suoi ospiti piatti tradizionali e fatti in casa con prodotti freschi."
        ],
        "fr": [
          "La Table Saint Firmin est un restaurant situé juste à coté de la Cathédrale en plein centre-ville. Il propose à ses clients une cuisine traditionnelle, des plats faits maison à base de produit frais."
        ],
        "nl": [
          "La Table Saint Firmin is een restaurant direct naast de kathedraal in het centrum van de stad. Het biedt zijn gasten traditionele, zelfgemaakte gerechten van verse producten."
        ],
        "es": [
          "La Table Saint Firmin es un restaurante situado junto a la Catedral, en el centro de la ciudad. Ofrece a sus huéspedes cocina tradicional y platos caseros elaborados con productos frescos."
        ]
      },
