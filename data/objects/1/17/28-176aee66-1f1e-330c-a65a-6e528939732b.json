  "rdfs:comment": {
    "de": [
      "Das 5-Saal-Kino mit der Klassifizierung Art & Essai in der Unterstadt von Laon, in der Nähe des Bahnhofs!\nWöchentliches Programm (mit Öffnungszeiten, Preisen, Ankündigungen von Kinobesuchen und Veranstaltungen) finden Sie auf ihrer Website ..."
    ],
    "en": [
      "The 5-screen Art & Essai cinema in Laon's lower town, close to the station!\nWeekly program (with schedules, prices, release announcements and events) to be found on their website ..."
    ],
    "it": [
      "Il cinema Art & Essai a 5 schermi nella città bassa di Laon, vicino alla stazione!\nLa programmazione settimanale (con orari, prezzi, annunci di uscite ed eventi) è disponibile sul sito web ..."
    ],
    "fr": [
      "Le cinéma 5 salles classé Art & Essai en ville basse de Laon, proche de la gare !\nProgramme hebdomadaire (avec horaires, tarifs, annonces de sorties et événementiels) à retrouver sur leur site web ..."
    ],
    "nl": [
      "De Art & Essai bioscoop met 5 zalen in de benedenstad van Laon, vlakbij het station!\nWekelijks programma (met tijden, prijzen, aankondigingen van releases en evenementen) te vinden op hun website ..."
    ],
    "es": [
      "Cine Art & Essai de 5 salas en la parte baja de Laon, cerca de la estación\nLa programación semanal (con horarios, precios, anuncios de estrenos y eventos) se encuentra en su página web ..."
    ]
