  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/377dd98d-6af8-35c3-b895-321c7ce3dbf0",
      "dc:description": {
        "de": [
          "SN Cofima ist ein Unternehmen aus Boulogne, das sich auf die Verarbeitung und den Handel mit Meeresfrüchten spezialisiert hat und für sein Know-how und die Qualität seiner verarbeiteten und in Frankreich und international vertriebenen Fische bekannt ist."
        ],
        "en": [
          "SN Cofima is a Boulonnais-based company specializing in the processing and trading of seafood products, renowned for its expertise and the quality of its fish products, which are produced and distributed in France and abroad."
        ],
        "it": [
          "SN Cofima è un'azienda del Boulonnais specializzata nella lavorazione e nel commercio di prodotti ittici, rinomata per la sua esperienza e la qualità del pesce che produce e distribuisce in Francia e all'estero."
        ],
        "fr": [
          "SN Cofima est une entreprise boulonnaise spécialisée dans la transformation et le négoce de produits de la mer, reconnue pour son savoir-faire et la qualité de ses poissons élaborés et distribués en France et à l’international."
        ],
        "nl": [
          "SN Cofima is een bedrijf uit Boulonnais dat gespecialiseerd is in de verwerking van en handel in visproducten. Het staat bekend om zijn expertise en de kwaliteit van de vis die het produceert en distribueert in Frankrijk en daarbuiten."
        ],
        "es": [
          "SN Cofima es una empresa de Boulonnais especializada en la transformación y comercialización de productos del mar, reconocida por su experiencia y la calidad del pescado que produce y distribuye en Francia y en el extranjero."
        ]
      },
      "@type": [
        "Description"
      ],
