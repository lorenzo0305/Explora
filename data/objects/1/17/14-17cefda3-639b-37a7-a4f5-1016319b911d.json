  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ddc225a4-d41a-31c5-8ce4-92054d04c0bd",
      "dc:description": {
        "de": [
          "Machen Sie es sich auf den Kissen bequem und lassen Sie sich von den Geschichten tragen, in denen die Figuren die Natur und das, was sie uns lehrt, hinterfragen"
        ],
        "en": [
          "Sit back on cushions and let yourself be transported by stories in which the characters question nature and what it teaches us"
        ],
        "it": [
          "Sedetevi sui cuscini e lasciatevi trasportare da storie in cui i personaggi si interrogano sulla natura e su ciò che essa ci insegna"
        ],
        "fr": [
          "Installez-vous sur des coussins et laissez vous transporter par des histoires où les personnages questionnent la nature et ce qu’elle nous apprend"
        ],
        "es": [
          "Siéntese en los cojines y déjese transportar por historias en las que los personajes cuestionan la naturaleza y lo que ésta nos enseña"
        ],
        "nl": [
          "Leun achterover op kussens en laat je meevoeren door verhalen waarin de personages de natuur en wat die ons leert in vraag stellen"
        ]
      },
