  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: die familiäre und freundliche Atmosphäre und Benoîts leckere und großzügige Küche mit Meeresprodukten."
    ],
    "en": [
      "You'll love Benoît's generous, gourmet seafood cuisine and the friendly, family atmosphere."
    ],
    "it": [
      "Vi piacerà l'atmosfera amichevole e familiare e i generosi piatti di pesce gourmet di Benoît."
    ],
    "fr": [
      "Vous aimerez : l'ambiance familiale et conviviale et la cuisine gourmande et généreuse de Benoît à base de produits de la mer."
    ],
    "nl": [
      "U zult dol zijn op de vriendelijke, familiaire sfeer en de gulle, gastronomische visgerechten van Benoît."
    ],
    "es": [
