      "dc:description": {
        "de": [
          "Erdbeeren aus Samer, Himbeeren, Walderdbeeren, Stachelbeeren, schwarze Johannisbeeren, Brombeeren...,<br>Handwerklich hergestellte Konfitüren.<br> Kochfertige Vögele auf Bestellung."
        ],
        "en": [
          "Samer strawberries, raspberries, wild strawberries, gooseberries, black currants, blackberries...,<br>Handcrafted jams.<br>Ready to cook poultry to order."
        ],
        "it": [
          "Samer fragole, lamponi, fragoline di bosco, uva spina, ribes, more..."
        ],
        "fr": [
          "Fraises de Samer, framboises, fraises des bois, groseilles à maquereaux, cassis, mûres...,<br>Confitures artisanales.<br>Volailles prêtes à cuire sur commande."
        ],
        "nl": [
          "Samer aardbeien, frambozen, wilde aardbeien, kruisbessen, zwarte bessen, bramen..."
        ],
        "es": [
          "Fresas de Samer, frambuesas, fresas silvestres, grosellas, moras..."
        ]
      },
