      "dc:description": {
        "de": [
          "Die Sandburg ist täglich von 12 bis 22 Uhr am Strand von Portel geöffnet. Ein zeitloser Ort, um sich mit Freunden zu treffen."
        ],
        "en": [
          "The sand castle is open from 12 to 10 pm every day on the beach of the portel, a timeless place to gather with friends."
        ],
        "it": [
          "Il castello di sabbia è aperto dalle 12 alle 22 tutti i giorni sulla spiaggia del porto, un luogo intramontabile per incontrare gli amici."
        ],
        "fr": [
          "Le château de sable est ouvert de 12h à 22h tous les jours sur la plage du portel, un endroit hors du temps pour se réunir entre amis."
        ],
        "nl": [
          "Het zandkasteel is elke dag geopend van 12 tot 22 uur op het strand van de haven, een tijdloze plek om vrienden te ontmoeten."
        ],
        "es": [
          "El castillo de arena está abierto de 12 a 22 horas todos los días en la playa del puerto, un lugar eterno para reunirse con los amigos."
        ]
