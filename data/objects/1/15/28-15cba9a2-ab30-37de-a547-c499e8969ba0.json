  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/70cce413-1fc4-34c1-b90c-05d99f844bc0",
      "dc:description": {
        "de": [
          "Stoßen Sie die Türen dieser Pizzeria auf und reisen Sie mit Tony! Es erwarten Sie italienische Gerichte und sizilianische Spezialitäten.\nFreitags wird Ihnen je nach Anlieferung Fisch angeboten."
        ],
        "en": [
          "Push open the doors of this pizzeria and travel with Tony! Italian dishes and Sicilian specialties await you.\nOn Fridays, fish is served according to availability."
        ],
        "it": [
          "Aprite le porte di questa pizzeria e fate un viaggio con Tony! Vi aspettano piatti italiani e specialità siciliane.\nIl venerdì viene servito pesce in base alla disponibilità."
        ],
        "fr": [
          "Poussez les portes de cette pizzeria pour voyager avec Tony ! Des plats italiens, des spécialités siciliennes vous attendent.\nLe vendredi, du poisson vous sera proposé selon l'arrivage."
        ],
        "nl": [
          "Duw de deuren van deze pizzeria open en maak een reis met Tony! Italiaanse gerechten en Siciliaanse specialiteiten wachten op je.\nOp vrijdag wordt er vis geserveerd volgens beschikbaarheid."
        ],
        "es": [
          "Abra de par en par las puertas de esta pizzería y haga un viaje con Tony Le esperan platos italianos y especialidades sicilianas.\nLos viernes se sirve pescado según disponibilidad."
        ]
      },
