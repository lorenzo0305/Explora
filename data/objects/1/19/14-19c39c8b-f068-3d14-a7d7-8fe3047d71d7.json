      "@id": "https://data.datatourisme.fr/cac9a0ba-fb00-3124-b03c-cf7eaf5a21f3",
      "dc:description": {
        "de": [
          "Jährlicher Mitgliedsbeitrag: Einzelperson: 20? - Familienmitgliedschaft: 30?\nVerein zur Animation der Gemeinde und zur Förderung kollektiver kultureller Freizeitaktivitäten\nVon September bis Juni: täglich außer samstags."
        ],
        "en": [
          "Annual subscription: Individual: 20? - Family: 30?\nAssociation for community activities and the promotion of collective cultural leisure activities\nFrom September to June, every day except Saturday."
        ],
        "it": [
          "Abbonamento annuale: Individuale: 20 euro - Famiglia: 30 euro?\nAssociazione per le attività comunitarie e la promozione di attività culturali collettive per il tempo libero\nDa settembre a giugno, tutti i giorni tranne il sabato."
        ],
        "fr": [
          "Cotisation annuelle : Individuelle : 20€ - Familiale : 30€.\nAssociation d'animation de la commune et de promotion des loisirs collectifs culturels\nDe septembre à juin, tous les jours sauf le samedi."
        ],
        "es": [
          "Suscripción anual: Individual: 20? - Familiar: 30?\nAsociación para las actividades comunitarias y la promoción del ocio cultural colectivo\nDe septiembre a junio, todos los días excepto los sábados."
        ],
        "nl": [
          "Jaarabonnement: Individueel: €20 - Gezin: 30?\nVereniging voor gemeenschapsactiviteiten en de promotie van collectieve culturele vrijetijdsbesteding\nVan september tot juni, elke dag behalve zaterdag."
        ]
      },
