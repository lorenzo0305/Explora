  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3f77e24e-4cb4-3099-ad2b-f6f3b5adea18",
      "dc:description": {
        "de": [
          "Lust auf ein spaßiges Teambuilding? Wir bieten maßgeschneiderte Patisserie-Workshops in Le Touquet und Umgebung an. Erleben Sie die Erfahrung im Stil eines Topkochs, mit Freude und guter Laune."
        ],
        "en": [
          "Looking for a fun team building experience? We offer tailor-made pastry workshops in and around Le Touquet. Come and enjoy the Top Chef experience, in a fun and friendly atmosphere."
        ],
        "it": [
          "Cercate un'attività di team building divertente? Offriamo laboratori di pasticceria su misura a Le Touquet e dintorni. Venite a provare l'esperienza di Top Chef, in un'atmosfera fantastica."
        ],
        "fr": [
          "Envie d'un team building fun ? Nous proposons des ateliers pâtisserie sur mesure sur le Touquet et autour. Venez vivre l'expérience façon Top chef, dans la joie et la bonne humeur."
        ],
        "es": [
          "¿Busca una actividad divertida para fomentar el espíritu de equipo? Ofrecemos talleres de pastelería a medida en Le Touquet y sus alrededores. Venga y disfrute de la experiencia Top Chef, en un gran ambiente."
        ],
        "nl": [
          "Op zoek naar een leuke teambuildingactiviteit? Wij bieden op maat gemaakte patisserie workshops in en rond Le Touquet. Kom en geniet van de Top Chef ervaring, in een geweldige sfeer."
        ]
      },
