  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von den Reflexionen des Jardin de Penin verzaubern, einer wahren grünen Oase im Herzen von Ternois.\nDieser private Garten ist mehr als nur eine Grünfläche, er ist eine Einladung zur Ruhe und Kontemplation."
    ],
    "en": [
      "Let yourself be charmed by Les Reflets du Jardin de Penin, a veritable jewel case of greenery nestling in the heart of the Ternois region.\nMore than just a green space, this private garden is an invitation to serenity and contemplation."
    ],
    "it": [
      "Lasciatevi incantare dai Reflets du Jardin de Penin, un vero e proprio scrigno di verde immerso nel cuore della regione del Ternois.\nPiù che un semplice spazio verde, questo giardino privato è un invito alla serenità e alla contemplazione."
    ],
    "fr": [
      "Laissez-vous charmer par les Reflets du Jardin de Penin, un véritable écrin de verdure niché au cœur du Ternois.\nPlus qu'un simple espace vert, ce jardin privé est une invitation à la sérénité et à la contemplation."
    ],
    "nl": [
      "Laat je betoveren door de Reflets du Jardin de Penin, een juweeltje van groen in het hart van de Ternois.\nDeze privétuin is meer dan een groene ruimte en nodigt uit tot sereniteit en bezinning."
    ],
    "es": [
      "Déjese seducir por los Reflets du Jardin de Penin, una auténtica joya de verdor enclavada en el corazón de la región de Ternois.\nMás que un espacio verde, este jardín privado es una invitación a la serenidad y a la contemplación."
    ]
  },
