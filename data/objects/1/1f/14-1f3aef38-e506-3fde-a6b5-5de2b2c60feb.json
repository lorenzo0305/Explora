      "dc:description": {
        "de": [
          "Das Anbaugebiet der Erdbeere von Samer erstreckt sich über das gesamte Gebiet und wird seit über einem Jahrhundert angebaut.\nErzeuger von Erdbeeren aus Samer."
        ],
        "en": [
          "The Samer strawberry-growing area extends over the whole territory, and has been cultivated for over a century.\nSamer strawberry grower."
        ],
        "it": [
          "La zona di coltivazione delle fragole di Samer copre l'intera regione e viene coltivata da oltre un secolo.\nIl coltivatore di fragole di Samer."
        ],
        "fr": [
          "La zone de culture de la fraise de Samer s'étend sur tout le territoire, elle est cultivée depuis plus d'un siècle. \nProducteur de fraises de Samer."
        ],
        "es": [
          "La zona fresera de Samer abarca toda la región y se cultiva desde hace más de un siglo.\nCultivador de fresas de Samer."
        ],
        "nl": [
          "Het aardbeiengebied van Samer strekt zich uit over de hele regio en wordt al meer dan een eeuw geteeld.\nTeler van aardbeien uit Samer."
        ]
      },
