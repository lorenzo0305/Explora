  "rdfs:comment": {
    "de": [
      "4 klimatisierte Kinosäle mit 4K-Bildtechnik und immersivem Dolby Atmos-Sound. Privater Raum für Ihre Hauptversammlungen, Seminare, Cocktailpartys, Weihnachtsbäume...\nVollständig zugängliches Kino für Personen mit eingeschränkter Mobilität."
    ],
    "en": [
      "4 air-conditioned cinema rooms, equipped with the latest 4K image technology, Dolby Atmos immersive sound. Privatized space for your general meetings, seminars, cocktails, Christmas trees...\nCinema fully accessible to people with reduced mobility."
    ],
    "it": [
      "4 sale cinematografiche climatizzate e a più livelli, dotate della più recente tecnologia di immagini 4K e del suono immersivo Dolby Atmos. Spazio privato per riunioni generali, seminari, cocktail, alberi di Natale...\nCinema completamente accessibile alle persone con mobilità ridotta."
    ],
    "fr": [
      "4  salles de cinéma gradinnées et climatisées, équipées des dernières technologies image 4K , son immersif Dolby Atmos. Espace privatisé pour vos assemblées générales; séminaires, cocktails, arbres de Noël...\nCinéma totalement accessible aux personnes à mobilité réduite."
    ],
    "es": [
      "4 salas de cine climatizadas y escalonadas, equipadas con la última tecnología de imagen 4K y sonido envolvente Dolby Atmos. Espacio privado para sus reuniones generales, seminarios, cócteles, árboles de Navidad...\nCine totalmente accesible para personas con movilidad reducida."
    ],
    "nl": [
      "4 gelaagde bioscoopzalen met airconditioning, uitgerust met de nieuwste 4K-beeldtechnologie en Dolby Atmos-immersief geluid. Privéruimte voor uw algemene vergaderingen, seminars, cocktails, kerstbomen...\nDe bioscoop is volledig toegankelijk voor personen met beperkte mobiliteit."
    ]
  },
