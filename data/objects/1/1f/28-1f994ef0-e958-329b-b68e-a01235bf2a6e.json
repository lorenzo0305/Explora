  "rdfs:comment": {
    "de": [
      "Dieses Museum, das im ehemaligen Bauernhof der wunderschönen Abtei Saint-Michel untergebracht ist, erzählt Ihnen die Geschichte unserer ländlichen Gegenden mit liebevoll gestalteten Ausstellungen über frühere Berufe, Gegenstände und landwirtschaftliche Geräte. Besuchen Sie die Abtei, die prächtige Wandmalereien beherbergt."
    ],
    "en": [
      "Installed in the former farm of the magnificent Abbey of Saint-Michel, this museum tells you the history of our countryside with beautifully displayed exhibitions of old trades, objects and agricultural equipment. Just a stone's throw away, visit the abbey which houses sumptuous murals."
    ],
    "it": [
      "Ospitato nell'ex fattoria della magnifica Abbazia di Saint-Michel, questo museo racconta la storia della nostra campagna con esposizioni di vecchi mestieri, oggetti e attrezzature agricole. A pochi passi di distanza, visitate l'abbazia che ospita sontuosi dipinti murali."
    ],
    "fr": [
      "Installé dans l'ancienne ferme de la magnifique Abbaye de Saint-Michel, ce musée vous raconte l'histoire de nos campagnes avec des expositions joliment mises en valeur de métiers d'autrefois, des objets, du matériel agricole. A deux pas, visitez l'abbaye qui abrite de somptueuses peintures murales."
    ],
    "es": [
      "Ubicado en la antigua granja de la magnífica Abadía de Saint-Michel, este museo cuenta la historia de nuestro campo con exposiciones de oficios, objetos y equipos agrícolas antiguos. A poca distancia, visite la abadía que alberga suntuosas pinturas murales."
    ],
    "nl": [
      "Dit museum, gevestigd in de voormalige boerderij van de prachtige abdij van Saint-Michel, vertelt de geschiedenis van ons platteland aan de hand van prachtig tentoongestelde oude ambachten, voorwerpen en landbouwwerktuigen. Bezoek op korte loopafstand de abdij met prachtige muurschilderingen."
    ]
  },
  "rdfs:label": {
