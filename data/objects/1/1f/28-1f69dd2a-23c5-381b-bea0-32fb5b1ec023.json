  "rdfs:comment": {
    "de": [
      "Der Belfried ist 18 Meter hoch und fast 10 Meter breit und wurde von der UNESCO zum Weltkulturerbe erklärt Er symbolisiert die Gemeindebefreiung der Gemeinde Saint-Riquier."
    ],
    "en": [
      "Listed as a UNESCO World Heritage Site, this belfry is 18 metres high and almost 10 metres wide! It symbolizes the municipal emancipation of the commune of Saint-Riquier."
    ],
    "it": [
      "Inserito nel patrimonio mondiale dell'Unesco, questo campanile è alto 18 metri e largo quasi 10! Simboleggia l'emancipazione municipale del comune di Saint-Riquier."
    ],
    "fr": [
      "Inscrit au Patrimoine mondial de l'Unesco, ce beffroi mesure 18 mètres de haut et presque 10 mètres de large! Il symbolise l'affranchissement municipal de la commune de Saint-Riquier."
    ],
    "nl": [
      "Het belfort, dat op de werelderfgoedlijst van de Unesco staat, is 18 meter hoog en bijna 10 meter breed! Het symboliseert de gemeentelijke emancipatie van de gemeente Saint-Riquier."
    ],
    "es": [
      "Este campanario, declarado Patrimonio de la Humanidad por la Unesco, tiene 18 metros de altura y casi 10 metros de ancho Simboliza la emancipación municipal del municipio de Saint-Riquier."
    ]
  },
