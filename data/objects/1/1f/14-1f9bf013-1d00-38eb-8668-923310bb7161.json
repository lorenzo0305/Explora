  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/838a2afb-c120-3c59-8a01-04cc0b2023fd",
      "dc:description": {
        "de": [
          "Traditionelle Zucht von Fleisch aus Chateauneuf-Rindern in Audincthun.\nBauernspeck von Viandes de Chateauneuf.\nCheddar von Petits plaisirs anglais in Le Touquet.\nTomme au Cidre von La Chapelle aux Pots in der Nähe von Beauvais.\nFrische Pommes frites von Pel Pom in Aix en Issart.\nGeflügel von La Petite basse cour in Wirwignes.\n\nVegetarische Option möglich.\nStandardkäse: Cheddar, Tomme au Cidre, Blauschimmelkäse, Ziegenfrischkäse, Cantal ..."
        ],
        "en": [
          "Traditional Chateauneuf beef farm in Audincthun.\nFarmhouse bacon from Viandes de Chateauneuf.\nCheddar from Petits plaisirs anglais in Le Touquet.\nTomme au Cidre from Chapelle aux Pots near Beauvais.\nFresh French fries from Pel Pom in Aix en Issart.\nPoultry from La Petite basse cour in Wirwignes.\n\nVegetarian option available.\nStandard cheeses: cheddar, tomme au cidre, bleu, chèvre frais, cantal..."
        ],
        "it": [
          "Allevamento di manzo tradizionale di Chateauneuf a Audincthun.\nPancetta di fattoria di Viandes de Chateauneuf.\nFormaggio Cheddar di Petits plaisirs anglais a Le Touquet.\nTomme au Cidre della Chapelle aux Pots, vicino a Beauvais.\nPatatine fresche da Pel Pom a Aix en Issart.\nPollame da La Petite basse cour a Wirwignes.\n\nDisponibile opzione vegetariana.\nFormaggi standard: cheddar, tomme au cidre, bleu, chèvre frais, cantal, ecc."
        ],
        "fr": [
          "Elevage traditionnel de viande d'origine bovine de Chateauneuf à Audincthun.\nBacon fermier des Viandes de Chateauneuf.\nCheddar des Petits plaisirs anglais du Touquet.\nTomme au Cidre de la Chapelle aux Pots proche de Beauvais.\nFrites fraiches de chez Pel Pom à Aix en Issart.\nVolaille de la Petite basse cour à Wirwignes.\n\nOption végétarien possible.\nFromages standards :  cheddar, tomme au cidre, bleu, chèvre frais, cantal ..."
        ],
        "nl": [
          "Traditionele rundvleesboerderij uit Chateauneuf in Audincthun.\nBoerderijspek van Viandes de Chateauneuf.\nCheddarkaas van Petits plaisirs anglais in Le Touquet.\nTomme au Cidre van Chapelle aux Pots bij Beauvais.\nVerse friet van Pel Pom in Aix en Issart.\nGevogelte van La Petite basse cour in Wirwignes.\n\nVegetarische optie beschikbaar.\nStandaard kazen: cheddar, tomme au cidre, bleu, chèvre frais, cantal, etc."
        ],
        "es": [
          "Granja tradicional de vacuno de Chateauneuf en Audincthun.\nTocino de granja de Viandes de Chateauneuf.\nQueso Cheddar de Petits plaisirs anglais en Le Touquet.\nTomme au Cidre de Chapelle aux Pots, cerca de Beauvais.\nPatatas fritas frescas de Pel Pom en Aix en Issart.\nAves de corral de La Petite basse cour en Wirwignes.\n\nOpción vegetariana disponible.\nQuesos estándar: cheddar, tomme au cidre, bleu, chèvre frais, cantal, etc."
        ]
      },
