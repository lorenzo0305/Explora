      "@id": "https://data.datatourisme.fr/fca62713-914b-3a6c-b498-c9263162406c",
      "dc:description": {
        "de": [
          "Eine Geige, eine Flu?te, ein Akkordeon, drei Stimmen und einige Perkussionsinstrumente. Lu?m ist eine Gruppe von drei Musikerinnen, die Sie auf eine Reise durch die Musik des Bal Folk mitnehmen."
        ],
        "en": [
          "A fiddle, a flute, a tuner, three voices and some percussion. Lu?m is a group of three musicians who take you on a journey through folk ball music."
        ],
        "it": [
          "Un violino, un flauto, un accordatore, tre voci e alcune percussioni. Lu?m è un viaggio di tre musicisti attraverso la musica folk a palla."
        ],
        "fr": [
          "Un violon, une flûte, un accordéon, trois voix et quelques percussions. Lüm c'est trois musiciennes complices qui vous proposent un voyage dans les musiques de bal folk."
        ],
        "es": [
          "Un violín, una flauta, un afinador, tres voces y algo de percusión. Lužm son tres músicos en un viaje a través de la música folk de pelota."
        ],
        "nl": [
          "Een viool, een fluit, een stemapparaat, drie stemmen en wat percussie. Lu?m is een reis van drie muzikanten door de folkloristische balmuziek."
        ]
      },
