      "dc:description": {
        "de": [
          "Ort des Austauschs rund um Spezialitäten aus Spanien, Italien und unserer Umgebung. Weine und Biere, um unsere typischen Wurst- und Käsesorten zu probieren."
        ],
        "en": [
          "A place to share specialties from Spain, Italy and our surroundings. Wines and beers to taste our typical cured meats and cheeses."
        ],
        "it": [
          "Un luogo dove condividere le specialità di Spagna, Italia e dintorni. Vini e birre per degustare i nostri salumi e formaggi tipici."
        ],
        "fr": [
          "Lieu de partage autour de spécialités provenant d'Espagne, d'Italie et nos environs. Vins et bières pour déguster nos charcuteries et fromages typiques."
        ],
        "es": [
          "Un lugar para compartir especialidades de España, Italia y nuestros alrededores. Vinos y cervezas para degustar nuestros embutidos y quesos típicos."
        ],
        "nl": [
          "Een plek om specialiteiten uit Spanje, Italië en onze omgeving te delen. Wijnen en bieren om onze typische vleeswaren en kazen te proeven."
        ]
