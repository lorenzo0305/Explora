    "de": [
      "Le Bon Coin in Arques ist ein charmantes Restaurant, das für seine traditionelle französische Küche bekannt ist und ein authentisches und geselliges kulinarisches Erlebnis bietet"
    ],
    "en": [
      "Le Bon Coin in Arques is a charming restaurant renowned for its traditional French cuisine, offering an authentic and convivial culinary experience"
    ],
    "it": [
