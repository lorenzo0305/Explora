      "dc:description": {
        "de": [
          "Kindermenü, Tagesgericht, Welshs, Meeresfrüchteplatten, vegetarische Gerichte, Fisch, Salate, Muscheln, Grillgerichte und Crêpes\nNull-Plastik-Ansatz"
        ],
        "en": [
          "Children's menu, daily specials, welshs, seafood platters, vegetarian dishes, fish, salads, mussels, grills and pancakes\nZero plastic\" approach"
        ],
        "it": [
          "Menù per bambini, piatto del giorno, gallese, vassoi di pesce, piatti vegetariani, pesce, insalate, cozze, grigliate e crêpes\nApproccio \"zero plastica"
        ],
        "fr": [
          "Menu enfant, plat du jour, welshs, plateaux de fruits de mer, plats végétariens, poissons, salades, moules, grillades et crêpes\nDémarche \"zéro plastique\""
        ],
        "es": [
          "Menú infantil, plato del día, galeses, bandejas de marisco, platos vegetarianos, pescado, ensaladas, mejillones, parrilladas y crepes\nPlástico cero"
        ],
        "nl": [
          "Kindermenu, dagschotel, welsh, schotels met zeevruchten, vegetarische gerechten, vis, salades, mosselen, grillgerechten en crêpes\nZero plastic\" benadering"
        ]
      },
