      "dc:description": {
        "de": [
          "Kochen mit Zichorie\nVincent Lutun empfängt Sie zu einem Kochworkshop \"ganz Zichorie\" und zeigt Ihnen neue Rezepte.\nFür alle Altersgruppen"
        ],
        "en": [
          "Cooking with chicory\nVincent Lutun welcomes you to an \"all chicory\" cooking workshop, where you can discover new recipes.\nOpen to all"
        ],
        "it": [
          "Cucinare con la cicoria\nVincent Lutun vi accoglierà in un laboratorio di cucina \"tutto cicoria\", dove potrete scoprire nuove ricette.\nAperto a tutti"
        ],
        "fr": [
          "Cuisiner la chicorée\nVincent Lutun vous accueillera pour un atelier cuisine « tout chicorée » et vous fera découvrir de nouvelles recettes.\nTout public"
        ],
        "nl": [
          "Koken met witlof\nVincent Lutun verwelkomt je op een kookworkshop over witlof, waar je nieuwe recepten kunt ontdekken.\nVoor iedereen toegankelijk"
        ],
        "es": [
          "Cocinar con achicoria\nVincent Lutun le acogerá en un taller de cocina \"todo achicoria\", donde podrá descubrir nuevas recetas.\nAbierto a todos"
        ]
      },
