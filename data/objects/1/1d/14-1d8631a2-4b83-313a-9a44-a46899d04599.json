      "@id": "https://data.datatourisme.fr/6996a917-4666-3eed-a465-a3ec248c0fbc",
      "dc:description": {
        "de": [
          "Mittwoch, 1. und Donnerstag, 2. April 2026\n\nTag der offenen Tür an der EPEAM im Rahmen des Welttages zur Sensibilisierung für Autismus\nVon 10 Uhr bis 16 Uhr.\nOffen für alle."
        ],
        "en": [
          "Wednesday April 1 and Thursday April 2, 2026\n\nEPEAM open house to mark World Autism Awareness Day\nFrom 10am to 4pm.\nOpen to all."
        ],
        "it": [
          "Mercoledì 1 e giovedì 2 aprile 2026\n\nApertura dell'EPEAM nell'ambito della Giornata mondiale della consapevolezza dell'autismo\nDalle 10.00 alle 16.00.\nAperto a tutti."
        ],
        "fr": [
          "Mercredi 1er et jeudi 2 avril 2026\n\nPortes ouvertes de l'EPEAM dans le cadre de la journée mondiale de sensibilisation à l'autisme\nDe 10h à 16h.\nOuvert à tous."
        ],
        "nl": [
          "Woensdag 1 en donderdag 2 april 2026\n\nOpen huis van EPEAM in het kader van Wereld Autisme Dag\nVan 10 tot 16 uur.\nOpen voor iedereen."
        ],
        "es": [
          "Miércoles 1 y jueves 2 de abril de 2026\n\nJornada de puertas abiertas de la EPEAM en el marco del Día Mundial de Concienciación sobre el Autismo\nDe 10h a 16h.\nAbierto a todos."
        ]
      },
