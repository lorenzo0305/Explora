  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6e118a9e-2e70-3d23-9211-6cf39848fd00",
      "dc:description": {
        "de": [
          "Im L'Himalaya in der Oberstadt von Laon kommen indische und pakistanische Spezialitäten auf Ihren Tisch: Samoussas, Nan, Gemüsecurry und Lassis werden Sie begeistern!"
        ],
        "en": [
          "At L'Himalaya, located in the upper town of Laon, Indian and Pakistani specialities are invited to your table: samoussas, nan, vegetable curries and lassis will delight you!"
        ],
        "it": [
          "Al ristorante L'Himalaya, situato nella città alta di Laon, vi aspettano specialità indiane e pakistane: samoussas, nan, curry di verdure e lassis vi delizieranno!"
        ],
        "fr": [
          "A L'Himalaya, situé en ville haute de Laon, les spécialités indiennes et pakistanaises s'invitent à votre table : samoussas, nan, curry de légumes et lassis vont vous enchanter !"
        ],
        "es": [
          "En L'Himalaya, situado en la parte alta de la ciudad de Laon, le esperan en la mesa especialidades indias y pakistaníes: samoussas, nan, currys de verduras y lassis ¡le encantarán!"
        ],
        "nl": [
          "Bij L'Himalaya, gelegen in de bovenstad van Laon, wachten Indiase en Pakistaanse specialiteiten op je aan tafel: samoussas, nan, groentecurry's en lassis zullen je verrukken!"
        ]
      },
