  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ce8b5382-8fd1-378e-97dd-a95c1deab8ed",
      "dc:description": {
        "de": [
          "Feiern Sie ab 19.00 Uhr das Strohhalmfest im Repère de Torcy\n\nAuf der Speisekarte: Spieß, Pommes, Salat, Apfelkuchen und eine Kugel Eis, alles für 16?"
        ],
        "en": [
          "Come and celebrate the Fête de la Paille at Le Repère de Torcy from 7:00 p.m\n\nOn the menu: skewer, French fries, salad, apple pie and scoop of ice cream, all for 16?"
        ],
        "it": [
          "Venite a festeggiare la Fete de la Paille a Le Repère de Torcy dalle 19.00\n\nIl menu: kebab, patatine, insalata, torta di mele e una pallina di gelato, il tutto per 16?"
        ],
        "fr": [
          "Venez célébrer dès 19h00 la Fête de la Paille au Repère de Torcy\n\nAu menu : brochette, frites salades, tar au pomme et sa boule de glace, le tout pour 16€"
        ],
        "es": [
          "Venga a celebrar la Fiesta de la Paille en Le Repère de Torcy a partir de las 19.00 horas\n\nEn el menú: kebab, patatas fritas, ensalada, tarta de manzana y una bola de helado, todo por 16?"
        ],
        "nl": [
          "Kom en vier het Fete de la Paille in Le Repère de Torcy vanaf 19.00 uur\n\nOp het menu: kebab, friet, salade, appeltaart en een bolletje ijs, alles voor 16?"
        ]
      },
