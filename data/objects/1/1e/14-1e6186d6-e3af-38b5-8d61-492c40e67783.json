      "dc:description": {
        "de": [
          "Das Edison Café ist eine Dinner-Bar. Der ideale Ort, um einen angenehmen Moment mit der Familie oder mit Freunden in einer gemütlichen Atmosphäre zu verbringen. Verkauf zum Mitnehmen"
        ],
        "en": [
          "L'Edison café is a dinner bar. The ideal place to spend a pleasant moment with family or friends, in a warm atmosphere. Take-away sales"
        ],
        "it": [
          "L'Edison café è un dinner bar. Il luogo ideale per trascorrere un momento piacevole con la famiglia o gli amici, in un'atmosfera accogliente. Vendite da asporto"
        ],
        "fr": [
          "L'Edison café est un bar dinatoire. Le lieu idéal pour passer un agréable moment en famille ou entre amis, dans une ambiance chaleureuse. Vente à emporter"
        ],
        "nl": [
          "Het Edison café is een eetcafé. De ideale plek om een gezellig moment door te brengen met familie of vrienden, in een warme sfeer. Afhaalmaaltijden"
        ],
        "es": [
          "El café Edison es un bar con cena. El lugar ideal para pasar un momento agradable con la familia o los amigos, en un ambiente cálido. Venta de comida para llevar"
        ]
      },
