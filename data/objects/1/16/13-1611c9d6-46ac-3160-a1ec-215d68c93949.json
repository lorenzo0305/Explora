  "rdfs:comment": {
    "de": [
      "Das Hotel liegt im Herzen des Avesnois am Rande des Forêt de Mormal und empfängt Sie in einer ländlichen und gemütlichen Umgebung."
    ],
    "en": [
      "Nestled in the heart of the Avesnois, on the edge of the Forêt de Mormal, the establishment welcomes you in a warm and rural setting."
    ],
    "it": [
      "Nel cuore dell'Avesnois, ai margini della Forêt de Mormal, la struttura vi accoglie in un ambiente caldo e rurale."
    ],
    "fr": [
      "Niché au cœur de l’Avesnois, en lisière de Forêt de Mormal, l’établissement vous accueille dans un cadre champêtre et chaleureux."
    ],
    "nl": [
      "Genesteld in het hart van de Avesnois, aan de rand van het Forêt de Mormal, ontvangt het etablissement u in een warme en landelijke omgeving."
    ],
    "es": [
      "Enclavado en el corazón del Avesnois, al borde del Forêt de Mormal, el establecimiento le da la bienvenida en un entorno cálido y rural."
    ]
