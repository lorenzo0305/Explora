  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1693a3f3-3999-3cdc-9a09-9245f9052577",
      "dc:description": {
        "de": [
          "Entdecken Sie die Somme-Bucht und ihre atemberaubenden Landschaften mit einem leidenschaftlichen und erfahrenen Führer, der seine Liebe zu diesem natürlichen Lebensraum, seiner Fauna, aber auch seiner Flora mit Ihnen teilen wird!"
        ],
        "en": [
          "Discover the Baie de Somme and its breathtaking landscapes with a passionate and experienced guide who will share with you his love for this natural environment, its fauna, but also its flora!"
        ],
        "it": [
          "Scoprite la Baie de Somme e i suoi paesaggi mozzafiato con una guida appassionata ed esperta che condividerà con voi l'amore per questo ambiente naturale, la sua fauna, ma anche la sua flora!"
        ],
        "fr": [
          "Découvrez la Baie de Somme et ses paysages à couper le souffle avec un guide passionné et expérimenté qui vous partagera son amour pour ce milieu naturel, sa faune, mais également sa flore !"
        ],
        "nl": [
          "Ontdek de Baie de Somme en zijn adembenemende landschappen met een gepassioneerde en ervaren gids die zijn liefde voor deze natuurlijke omgeving, zijn fauna, maar ook zijn flora met u zal delen!"
        ],
        "es": [
          "Descubra la Bahía de Somme y sus impresionantes paisajes con un guía apasionado y experimentado que compartirá con usted su amor por este entorno natural, su fauna, pero también su flora"
        ]
      },
