  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50c22717-8a6e-3491-8813-7d2501374491",
      "dc:description": {
        "de": [
          "Adieu, Misère! ist eine Gruppe aus dem Bergbaugebiet Pas-de-Calais, die eine musikalische Reise in mehreren Sprachen unter Verwendung von akustischen Instrumenten anbietet: Gesang, Banjo, Cello, Gitarre. Machen Sie sich bereit, nach Schottland, in die Bretagne und sogar in die USA zu entfliehen!"
        ],
        "en": [
          "A group from the Pas-de-Calais coalfield, Adieu, Misère! takes us on a musical journey in several languages, using acoustic instruments such as vocals, banjo, cello and guitar. Get ready to escape to Scotland, Brittany and even the USA!"
        ],
        "it": [
          "Un gruppo proveniente dal bacino carbonifero del Pas-de-Calais, Adieu, Misère! vi accompagna in un viaggio musicale in diverse lingue, utilizzando strumenti acustici: voce, banjo, violoncello e chitarra. Preparatevi a fuggire in Scozia, in Bretagna e persino negli Stati Uniti!"
        ],
        "fr": [
          "Groupe du bassin minier du Pas-de-Calais, Adieu, Misère ! propose un voyage musical en plusieurs langues en utilisant des instruments acoustiques : chant, banjo, violoncelle, guitare. Préparez-vous à vous évader en Écosse, en Bretagne et même aux États-Unis !"
        ],
        "es": [
          "Adieu, Misère!, un grupo de la cuenca minera del Pas-de-Calais, le lleva en un viaje musical en varios idiomas, con instrumentos acústicos: voz, banjo, violonchelo y guitarra. Prepárese para una escapada a Escocia, Bretaña e incluso Estados Unidos"
        ],
        "nl": [
          "Adieu, Misère! is een groep uit het steenkoolgebied Pas-de-Calais die je meeneemt op een muzikale reis in verschillende talen met akoestische instrumenten: zang, banjo, cello en gitaar. Maak je klaar om te ontsnappen naar Schotland, Bretagne en zelfs de Verenigde Staten!"
        ]
      },
