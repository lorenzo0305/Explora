  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a0f7171d-63eb-3ff7-8d39-3f5d336a3bed",
      "dc:description": {
        "de": [
          "Das am 8. August 1920 eingeweihte Kriegerdenkmal besteht aus grauem Stein aus Belgien. Der Autor ist der Marmorarbeiter Edmond Maréchal aus Boulogne-sur-mer. Unter dem Portal der Kirche Notre-Dame du Trofort hängt eine Gedenktafel aus Marmor."
        ],
        "en": [
          "Inaugurated on August 8, 1920, the war memorial is made of grey stone from Belgium. The author is the marble worker Edmond Maréchal from Boulogne-sur-mer. Under the porch of the church Notre-Dame du réconfort, a marble commemorative plaque hangs."
        ],
        "it": [
          "Inaugurato l'8 agosto 1920, il monumento ai caduti è realizzato in pietra grigia belga. L'autore è il marmista Edmond Maréchal di Boulogne-sur-mer. Sotto il portico della chiesa di Notre-Dame du réconfort è appesa una targa commemorativa in marmo."
        ],
        "fr": [
          "Inauguré le 8 août 1920, le monument aux morts est en pierre grise de Belgique. L'auteur est le marbrier Edmond Maréchal de Boulogne-sur-mer. Sous le porche de l'église Notre-Dame du réconfort est accrochée une plaque commémorative en marbre."
        ],
        "es": [
          "Inaugurado el 8 de agosto de 1920, el monumento de guerra es de piedra gris belga. El autor es el marmolista Edmond Maréchal de Boulogne-sur-mer. Bajo el pórtico de la iglesia de Notre-Dame du réconfort, cuelga una placa conmemorativa de mármol."
        ],
        "nl": [
          "Het oorlogsmonument, ingehuldigd op 8 augustus 1920, is gemaakt van Belgische grijze steen. De auteur is de marmerbewerker Edmond Maréchal uit Boulogne-sur-mer. Onder het portaal van de kerk Notre-Dame du réconfort hangt een marmeren gedenkplaat."
        ]
      },
      "@type": [
        "Description"
