  "rdfs:comment": {
    "de": [
      "Wenn Sie bei Ihrem Besuch in Jenlain nach einer Möglichkeit zum Essen suchen, ist die Brasserie La Jenlinoise eine Institution, die bei den Einheimischen bekannt und bei Touristen beliebt ist."
    ],
    "en": [
      "If you are looking for a place to eat while in Jenlain, the brasserie La Jenlinoise is an institution known by the locals and appreciated by tourists."
    ],
    "it": [
      "Se cercate un posto dove mangiare quando visitate Jenlain, la brasserie La Jenlinoise è un'istituzione conosciuta dalla gente del posto e apprezzata dai turisti."
    ],
    "fr": [
      "Si vous cherchez où manger lors de votre passage à Jenlain, la brasserie La Jenlinoise est une institution connue des locaux et appréciée des touristes."
    ],
    "es": [
      "Si busca un lugar donde comer cuando visite Jenlain, la brasserie La Jenlinoise es una institución conocida por los lugareños y apreciada por los turistas."
