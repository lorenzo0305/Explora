      "dc:description": {
        "de": [
          "Treffpunkt in der Bibliothek von La Fère für eine Animation und Lesung rund um Sam le Gourmignon von Juliane Bosch am Samstag, den 10. September in der Bibliothek von La Fère ab 13:30 Uhr.\nKinder und Familien, Reservierung empfohlen\nWeitere Informationen unter: 06 34 39 71 42 oder bibliotheque@ville-lafere.fr"
        ],
        "en": [
          "Join Juliane Bosch on Saturday September 10 at the La Fère library from 1.30pm for an animation and reading about Sam le Gourmignon.\nChildren and families, booking recommended\nFurther information: 06 34 39 71 42 or bibliotheque@ville-lafere.fr"
        ],
        "it": [
          "Juliane Bosch leggerà Sam le Gourmignon sabato 10 settembre alla biblioteca di La Fère a partire dalle ore 13.30.\nBambini e famiglie, prenotazione consigliata\nPer ulteriori informazioni: 06 34 39 71 42 o bibliotheque@ville-lafere.fr"
        ],
        "fr": [
          "Rendez-vous à la bibliothèque de La Fère pour une animation et lecture autour de Sam le Gourmignon par Juliane Bosch le samedi 10 septembre à la bibliothèque de La Fère à partir de 13h30.\nEnfants et famille, réservation conseillée\nPlus d’infos au : 06 34 39 71 42 ou bibliotheque@ville-lafere.fr"
        ],
        "nl": [
          "Juliane Bosch leest Sam le Gourmignon voor op zaterdag 10 september in de bibliotheek van La Fère vanaf 13.30 uur.\nKinderen en gezinnen, reserveren aanbevolen\nMeer informatie: 06 34 39 71 42 of bibliotheque@ville-lafere.fr"
        ],
        "es": [
          "Juliane Bosch leerá Sam le Gourmignon el sábado 10 de septiembre en la biblioteca de La Fère a partir de las 13.30 h.\nNiños y familias, se recomienda reservar\nMás información: 06 34 39 71 42 o bibliotheque@ville-lafere.fr"
        ]
      },
