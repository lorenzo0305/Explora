      "dc:description": {
        "de": [
          "Posturale Yogakurse in Minigruppen von 4 Personen (Erwachsene)\nOrganisiert von : SO'Zen Côte d'Opale\nVon 11:00 bis 12:15 Uhr im Bad'Huit St Martin-Boulogne (vollständige Adresse wird bei der Anmeldung angegeben)\nPreis: 15?/Schnupperstunde\nTelefon: 0601902394\nWebsite / Facebook: www.asso-sozen.com mail: sozen.cotedopale@gmail.com\nVorherige Anmeldung erforderlich!"
        ],
        "en": [
          "Postural yoga in mini-groups of 4 (adults)\nOrganized by : SO'Zen Côte d'Opale\n11 a.m. to 12.15 p.m. at Bad'Huit St Martin-Boulogne (full address given on registration)\nPrice: 15?/discovery session\nTelephone: 0601902394\nWebsite / Facebook : www.asso-sozen.com e-mail: sozen.cotedopale@gmail.com\nPrior registration required!"
        ],
        "it": [
          "Corso di yoga posturale in mini-gruppi di 4 persone (adulti)\nOrganizzato da : SO'Zen Côte d'Opale\nDalle 11.00 alle 12.15 presso Bad'Huit St Martin-Boulogne (indirizzo completo fornito al momento dell'iscrizione)\nPrezzo: € 15 /sessione di scoperta\nTelefono: 0601902394\nSito web / Facebook: www.asso-sozen.com e-mail: sozen.cotedopale@gmail.com\nÈ necessaria la registrazione preliminare!"
        ],
        "fr": [
          "Cours de yoga postural en mini-groupe de 4 personnes (adultes) \nOrganisé par : SO'Zen Côte d'Opale\nDe  11h  à 12h15 au Bad'Huit St Martin-Boulogne (adresse complète donnée à l'inscription)\nTarif  : 15€/séance découverte\nTéléphone : 0601902394\nSite web / Facebook : www.asso-sozen.com  mail: sozen.cotedopale@gmail.com\nInscription préalable obligatoire !"
        ],
        "nl": [
          "Houdingsyogales in minigroepen van 4 (volwassenen)\nGeorganiseerd door : SO'Zen Côte d'Opale\n11u tot 12u15 in Bad'Huit St Martin-Boulogne (volledig adres bij inschrijving)\nPrijs: 15 € /ontdekkingssessie\nTelefoon: 0601902394\nWebsite / Facebook: www.asso-sozen.com e-mail: sozen.cotedopale@gmail.com\nVooraf inschrijven verplicht!"
        ],
        "es": [
          "Clase de yoga postural en minigrupos de 4 (adultos)\nOrganizado por : SO'Zen Côte d'Opale\nDe 11:00 a 12:15 h en Bad'Huit St Martin-Boulogne (dirección completa al inscribirse)\nPrecio: 15 euros /sesión de descubrimiento\nTeléfono: 0601902394\nPágina web / Facebook: www.asso-sozen.com e-mail: sozen.cotedopale@gmail.com\nInscripción previa obligatoria"
        ]
