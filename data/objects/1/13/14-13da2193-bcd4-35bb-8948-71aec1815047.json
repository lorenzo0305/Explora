      "dc:description": {
        "de": [
          "Bar, Tabakladen, PMU, Presse, FDJ.\n\nÖffnungszeiten Einschluss :\nMontag bis Samstag (dienstags geschlossen) von 7:00 bis 13:00 Uhr und von 14:00 bis 19:00 Uhr geöffnet. Sonntags von 8:00 bis 13:00 Uhr."
        ],
        "en": [
          "Bar, tobacco, PMU, press, FDJ.\n\nSchedules containment :\nOpen from Monday to Saturday (closed on Tuesday) from 7am to 1pm and from 2pm to 7pm. Sunday from 8am to 1pm."
        ],
        "it": [
          "Bar, tabaccheria, PMU, stampa, FDJ.\n\nOrario di confinamento:\nAperto dal lunedì al sabato (chiuso il martedì) dalle 7.00 alle 13.00 e dalle 14.00 alle 19.00. Domenica dalle 8.00 alle 13.00."
        ],
        "fr": [
          "Bar, tabac, PMU, presse, FDJ.\n\nHoraires confinement :\nOuverture du lundi au samedi (fermé le mardi) de 7h à 13h et de 14h à 19h. Le dimanche de 8h à 13h."
        ],
        "nl": [
          "Bar, tabakswinkel, PMU, pers, FDJ.\n\nOpsluitingsuren:\nOpen van maandag tot zaterdag (dinsdag gesloten) van 7 tot 13 uur en van 14 tot 19 uur. Zondag van 8 tot 13 uur."
        ],
        "es": [
          "Bar, estanco, PMU, prensa, FDJ.\n\nHoras de confinamiento:\nAbierto de lunes a sábado (cerrado los martes) de 7:00 a 13:00 y de 14:00 a 19:00. Domingo de 8 a 13 horas."
        ]
      },
