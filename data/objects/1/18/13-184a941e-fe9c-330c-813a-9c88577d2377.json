  "rdfs:comment": {
    "de": [
      "Biologischer Erzeuger von Gemüse und Beerenfrüchten seit 1982.\r\nVerkauf von Apfelsaft, Apfelsaft und roten Früchten, Sprudel, Essig und Cidre nach Vereinbarung"
    ],
    "en": [
      "Organic producer of vegetables and berries since 1982.\r\nSales by appointment of apple juice, apple and red fruit juice, sparkling wine, vinegar and cider"
    ],
    "it": [
      "Produttore biologico di ortaggi e frutti di bosco dal 1982.\r\nSucco di mela, succo di mela e di frutti rossi, spumante, aceto e sidro disponibili su prenotazione"
    ],
    "fr": [
      "Producteur biologique de légumes et petits fruits depuis 1982.\r\nVente sur rendez-vous de jus de pomme, jus de pomme et fruits rouges, pétillant, vinaigre et cidre"
    ],
    "es": [
      "Productor ecológico de verduras y bayas desde 1982.\r\nZumo de manzana, zumo de manzana y frutos rojos, vino espumoso, vinagre y sidra disponibles con cita previa"
    ],
    "nl": [
      "Biologische producent van groenten en bessen sinds 1982.\r\nAppelsap, appel- en rood vruchtensap, mousserende wijn, azijn en cider verkrijgbaar op afspraak"
    ]
  },
  "rdfs:label": {
