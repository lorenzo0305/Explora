  "rdfs:comment": {
    "de": [
      "Große Spieler ? Kleine Spieler ? Schlechte Spieler ? Spielen Sie mit uns und verbringen Sie einen Abend voller guter Laune! :-)\nAtmosphäre einer spanischen Herberge, denken Sie daran, eine Kleinigkeit zu essen oder zu trinken mitzubringen ;-)"
    ],
    "en": [
      "Big players? Little players? Bad players? Come and play with us and enjoy a fun-filled evening! :-)\nDon't forget to bring a little something to eat or drink ;-)"
    ],
    "it": [
      "Grandi giocatori? Piccoli giocatori? Cattivi giocatori? Venite a giocare con noi e godetevi una serata all'insegna del divertimento! :-)\nNon dimenticate di portare qualcosa da mangiare o da bere)!"
    ],
    "fr": [
      "Grands joueurs ? Petits joueurs ? Mauvais joueurs ? Venez jouer avec nous et passez une soirée pleine de bonne humeur ! :-)\nAmbiance auberge espagnole, pensez à ramener un petit quelque chose à manger ou à boire ;-)"
    ],
    "es": [
      "¿Grandes jugadores? ¿Pequeños jugadores? ¿Malos jugadores? ¡Ven a jugar con nosotros y disfruta de una tarde llena de diversión! :-)\nNo olvides traer algo de comer o beber)"
    ],
    "nl": [
      "Grote spelers? Kleine spelers? Slechte spelers? Kom met ons spelen en geniet van een leuke avond! :-)\nVergeet niet iets te eten of te drinken mee te nemen!)"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée jeux"
    ]
  },
