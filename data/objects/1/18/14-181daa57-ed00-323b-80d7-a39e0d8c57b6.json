      "dc:description": {
        "de": [
          "Stundenplan:\n\nDienstag bis Donnerstag von 12:00 bis 14:00 Uhr und von 19:00 bis 22:00 Uhr\nFreitags bis samstags von 12:00 bis 14:00 Uhr und von 19:00 bis 22:30 Uhr\nSonntags von 12:00 bis 14:00 Uhr\nMontag geschlossen\n "
        ],
        "en": [
          "Opening hours :\n\nTuesday to Thursday, 12pm to 2pm and 7pm to 10pm\nFriday to Saturday, 12pm to 2pm and 7pm to 10:30pm\nSunday from 12h to 14h\nClosed on Monday\n "
        ],
        "it": [
          "Orario :\n\nDa martedì a giovedì, dalle 12.00 alle 14.00 e dalle 19.00 alle 22.00\nDa venerdì a sabato, dalle 12.00 alle 14.00 e dalle 19.00 alle 22.30\nDomenica dalle 12.00 alle 14.00\nChiuso il lunedì\n "
        ],
        "fr": [
          "Horaires :\n\nDu mardi au jeudi de 12h à 14h et de 19h à 22h\nDu vendredi au samedi de 12h à 14h et de 19h à 22h30\nLe dimanche de 12h à 14h\nFermé le lundi\n "
        ],
        "nl": [
          "Tijdschema :\n\nDinsdag tot donderdag, 12u tot 14u en 19u tot 22u\nVrijdag tot zaterdag, 12u tot 14u en 19u tot 22u30\nZondag van 12 tot 14 uur\nMaandag gesloten\n "
        ],
        "es": [
