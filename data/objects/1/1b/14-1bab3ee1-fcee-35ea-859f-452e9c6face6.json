  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1ec06412-1fb4-33bc-80cb-b0b5bdac8c5e",
      "dc:description": {
        "de": [
          "50 m vom Place de l'Hôtel-de-ville entfernt bietet Ihnen dieses Lounge-Restaurant & Bar eine Kombination aus großzügiger Küche und einem schicken und trendigen Rahmen. Verlängern Sie das Erlebnis bis 2 Uhr am Wochenende dank der verschiedenen Abendveranstaltungen, die von DJs moderiert werden."
        ],
        "en": [
          "Just 50 m from the town hall square, this Restaurant & Bar lounge offers you a combination of generous cuisine in a chic and trendy setting. Extend the experience up to 2 hours on weekends thanks to the various evenings hosted by DJs."
        ],
        "it": [
          "A soli 50 metri da Place de l'Hôtel-de-Ville, questo ristorante e lounge bar offre una cucina generosa in un ambiente chic e alla moda. Nei fine settimana l'esperienza si prolunga fino alle 2 di notte grazie alle varie serate con DJ."
        ],
        "fr": [
          "A 50 m de la place de l'Hôtel-de-ville, ce Restaurant & Bar lounge vous propose l'association d'une cuisine généreuse à un cadre chic et branché. Prolongez l'expérience jusqu'à 2h le weekend grâce aux différentes soirées animées par des DJ."
        ],
        "nl": [
          "Op slechts 50 meter van het Place de l'Hôtel-de-Ville biedt dit restaurant en deze loungebar een royale keuken in een chique en trendy omgeving. Verleng de ervaring tot 2 uur 's nachts in het weekend dankzij de verschillende dj-avonden."
        ],
        "es": [
          "A 50 metros de la Place de l'Hôtel-de-Ville, este restaurante y lounge bar ofrece una cocina generosa en un entorno elegante y de moda. Prolongue la experiencia hasta las 2 de la madrugada los fines de semana gracias a las diversas noches de DJ."
        ]
      },
      "@type": [
        "Description"
      ],
