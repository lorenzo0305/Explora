  "rdfs:comment": {
    "de": [
      "Restaurant mit Blick auf den Strand. Küche von Land und Meer. Lokale Produkte, Tagesfang, Miesmuscheln aus der Bucht, Lamm von den Salzwiesen. Jakobsmuscheln von unseren Küsten.\n\nSignature Dishes: Lamm von Salzwiesen, Fisch von unseren Küsten"
    ],
    "en": [
      "Restaurant facing the beach. Land and sea cuisine. Local products, fishing of the day, mussels from the bay, salt meadow lamb. Scallops from our coast.\n\nSignature dishes: salt-meadow lamb, fish from our coasts"
    ],
    "it": [
      "Ristorante affacciato sulla spiaggia. Cucina di terra e di mare. Prodotti locali, pescato del giorno, cozze della baia, agnello dei prati salmastri. Capesante della nostra costa.\n\nPiatti tipici: agnello al sale, pesce della nostra costa"
    ],
    "fr": [
      "Restaurant face à la plage. Cuisine Terre et Mer. Produits locaux, pêche du jour, moules de la baie, agneau de prés-salés. St-Jacques de nos côtes.\n\nPlats signature : agneau de prés-salés, poissons de nos côtes"
    ],
    "es": [
      "Restaurante frente a la playa. Cocina de mar y tierra. Productos locales, pesca del día, mejillones de la bahía, cordero de la pradera salada. Vieiras de nuestra costa.\n\nPlatos de autor: cordero de pradera salada, pescado de nuestra costa"
    ],
    "nl": [
      "Restaurant met uitzicht op het strand. Land en zee keuken. Streekproducten, vangst van de dag, mosselen uit de baai, zoutweiderlam. Jakobsschelpen van onze kust.\n\nHoofdgerechten: lamsvlees van de zoute weide, vis van onze kust"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Petit Baigneur"
    ]
  },
