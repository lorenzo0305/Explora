  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dbb65127-35c6-3f8b-b98e-b90e439d91a0",
      "dc:description": {
        "de": [
          "Samstag, 4. Juli 2026\n- Automobile - Escapade en terres d'Opale, Abfahrt vom Parc des Pins, Kiosk Serge Gainsbourg, Ankunft in den Gärten des Leuchtturms, organisiert von der Association Le Touquet Automobiles de Collection."
        ],
        "en": [
          "Saturday 4th July 2026\n- Automobile - Escapade en terres d'Opale, departure from Parc des Pins, kiosk Serge Gainsbourg, arrival at the Lighthouse Gardens, organized by the Association Le Touquet Automobiles de Collection."
        ],
        "it": [
          "Sabato 4 luglio 2026\n- Automobile - Escapade en terres d'Opale, partenza dal Parc des Pins, chiosco Serge Gainsbourg, arrivo ai Giardini del Faro, organizzata dall'Associazione Le Touquet Automobiles de Collection."
        ],
        "fr": [
          "Samedi 4 juillet 2026\n- Automobile - Escapade en terres d'Opale, départ du Parc des Pins, kiosque Serge Gainsbourg, arrivée aux jardins du Phare, organisé par l'Association Le Touquet Automobiles de Collection."
        ],
        "nl": [
          "Zaterdag 4 juli 2026\n- Automobile - Escapade en terres d'Opale, vertrek vanuit Parc des Pins, Serge Gainsbourg kiosk, aankomst bij de Lighthouse Gardens, georganiseerd door de Association Le Touquet Automobiles de Collection."
        ],
        "es": [
          "Sábado 4 de julio de 2026\n- Automobile - Escapade en terres d'Opale, salida del Parc des Pins, quiosco Serge Gainsbourg, llegada a los Jardines del Faro, organizado por la Association Le Touquet Automobiles de Collection."
        ]
      },
