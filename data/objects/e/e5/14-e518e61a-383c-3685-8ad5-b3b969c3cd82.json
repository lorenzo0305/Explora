  "rdfs:comment": {
    "de": [
      "Das Credo des Vereins ist es, alles zu suchen, zu studieren, zu sammeln, zu entwickeln und zu veröffentlichen, was für die Geschichte von Carvin und seiner Region von Interesse ist. Entdecken Sie die Arbeit des Vereins während des gesamten Wochenendes."
    ],
    "en": [
      "Researching, studying, collecting, developing and publishing everything of interest to the history of Carvin and its region is the association's credo. Come and discover its work all weekend long."
    ],
    "it": [
      "Il credo dell'associazione è quello di ricercare, studiare, raccogliere, sviluppare e pubblicare tutto ciò che interessa la storia di Carvin e della sua regione. Venite a scoprire il suo lavoro per tutto il fine settimana."
    ],
    "fr": [
      "Rechercher, étudier, recueillir, développer et publier tout ce qui intéresse l' histoire de Carvin et de sa région, tel est le crédo de l'association. Venez découvrir ses travaux tout le weekend."
    ],
    "nl": [
      "Het credo van de vereniging is het onderzoeken, bestuderen, verzamelen, ontwikkelen en publiceren van alles wat van belang is voor de geschiedenis van Carvin en zijn regio. Kom het werk van de vereniging het hele weekend ontdekken."
    ],
    "es": [
      "El credo de la asociación es investigar, estudiar, recopilar, desarrollar y publicar todo lo que sea de interés para la historia de Carvin y su región. Venga a descubrir su labor durante todo el fin de semana."
    ]
  },
