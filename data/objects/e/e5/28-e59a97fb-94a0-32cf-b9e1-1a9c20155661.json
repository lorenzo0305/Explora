      "rdfs:comment": {
        "de": [
          "Entdecken Sie unseren pädagogischen Bauernhof in der Nähe von Steenvoorde, Cassel und Hazebrouck. Dort können Sie die Tiere des Bauernhofs auf spielerische und originelle Weise kennenlernen, indem Sie an Aktivitäten teilnehmen."
        ],
        "en": [
          "Discover our educational farm near Steenvoorde, Cassel and Hazebrouck. Here you can discover farm animals in a fun and original way by taking part in activities."
        ],
        "it": [
          "Scoprite la nostra fattoria didattica vicino a Steenvoorde, Cassel e Hazebrouck. Qui potrete scoprire gli animali della fattoria in modo divertente e originale, partecipando alle attività."
        ],
        "fr": [
          "Découvrez notre ferme pédagogique près de Steenvoorde, Cassel et Hazebrouck. Vous pourrez y découvrir les animaux de la ferme de manière ludique et originale en participant à des activités."
        ],
        "nl": [
          "Ontdek onze educatieve boerderij in de buurt van Steenvoorde, Cassel en Hazebrouck. Hier kan je op een leuke en originele manier kennismaken met boerderijdieren door deel te nemen aan activiteiten."
        ],
        "es": [
          "Descubre nuestra granja educativa cerca de Steenvoorde, Cassel y Hazebrouck. Aquí podrás descubrir los animales de granja de una forma divertida y original participando en actividades."
        ]
      },
      "foaf:homepage": [
