  "rdfs:comment": {
    "de": [
      "Die Künstler der Mécanique du Fluide bieten eine künstlerische Entdeckungsreise für die ganze Familie an, eine musikalische Träumerei, bei der die Noten des Cellos mit den Bildern des Schattentheaters verschmelzen. Ein schwebender Moment, den Kinder und Eltern miteinander teilen können, eine träumerische Erkundung des Meeresbodens, die allen ab 3 Jahren offen steht."
    ],
    "en": [
      "The artists of Mécanique du Fluide offer a family moment of artistic discovery, a musical reverie where the notes of the cello intermingle with the images of shadow theater. A suspended moment to share with children and parents, a dreamy exploration of the seabed, open to all, ages 3 and up."
    ],
    "it": [
      "Gli artisti de La Mécanique du Fluide propongono un momento di scoperta artistica in famiglia, una fantasticheria musicale in cui le note del violoncello si mescolano alle immagini del teatro delle ombre. Un momento sospeso da condividere con bambini e genitori, un'esplorazione onirica dei fondali marini, aperta a tutti, dai 3 anni in su."
    ],
    "fr": [
      "Les artistes de la Mécanique du Fluide proposent un temps familial de découverte artistique, une rêverie musicale, où les notes du violoncelle s'entremêlent aux images du théâtre d'ombres. Un instant suspendu à partager entre enfants et parents, une exploration rêveuse des fonds marins, ouverte à toutes et tous, à partir de 3 ans."
    ],
    "es": [
      "Los artistas de La Mécanique du Fluide proponen un momento de descubrimiento artístico en familia, un ensueño musical donde las notas del violonchelo se entremezclan con las imágenes del teatro de sombras. Un momento suspendido para compartir con niños y padres, una exploración onírica de los fondos marinos, abierta a todos, a partir de 3 años."
    ],
    "nl": [
      "De kunstenaars van La Mécanique du Fluide bieden een artistieke ontdekkingstocht voor het hele gezin, een muzikale mijmering waarbij de noten van de cello zich vermengen met de beelden van het schaduwtheater. Een zweverig moment om te delen met kinderen en ouders, een dromerige verkenning van de zeebodem, open voor iedereen vanaf 3 jaar."
    ]
  },
  "rdfs:label": {
    "fr": [
