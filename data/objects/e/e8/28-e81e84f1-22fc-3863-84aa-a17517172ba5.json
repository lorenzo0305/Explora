  "rdfs:comment": {
    "de": [
      "Entdecken Sie in diesem Restaurant mit Blick auf den Fluss die lokalen Geschmäcker. Das Lokale breitet sich auf der Schiefertafel aus, und die Aromen sind typisch für die französische Gastronomie."
    ],
    "en": [
      "Come and discover local flavors in this restaurant overlooking the river. The local produce is displayed on the slate, and the flavors are typical of French gastronomy."
    ],
    "it": [
      "Venite a scoprire i sapori locali in questo ristorante affacciato sul fiume. I prodotti locali sono esposti sulla lavagna e i sapori sono quelli tipici della gastronomia francese."
    ],
    "fr": [
      "Venez découvrir les saveurs locales dans ce restaurant avec vue sur le fleuve. Le local s'étale sur l'ardoise, et les saveurs sont typiques de la gastronomie française."
    ],
    "es": [
      "Venga a descubrir los sabores locales en este restaurante con vistas al río. Los productos locales se exponen en la pizarra y los sabores son típicos de la gastronomía francesa."
    ],
    "nl": [
      "Kom de lokale smaken ontdekken in dit restaurant met uitzicht op de rivier. De lokale producten staan uitgestald op de leisteen en de smaken zijn typisch voor de Franse gastronomie."
    ]
  },
