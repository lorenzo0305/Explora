  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/83eb95a6-6e00-3f95-b5c6-c358487ca9eb",
      "dc:description": {
        "de": [
          "Einfaches und effizientes Restaurant.\nGute Laune das ganze Jahr über.\nBei uns nimmt man sich nicht den Kopf, es ist entspannt wie zu Hause."
        ],
        "en": [
          "Simple and efficient restaurant.\nGood mood all year round.\nWe don't take it too seriously, it's as relaxed as at home."
        ],
        "it": [
          "Ristorante semplice ed efficiente.\nBuon umore tutto l'anno.\nNon lo prendiamo troppo sul serio, è rilassato come a casa."
        ],
        "fr": [
          "Restaurant simple et efficace.\nBonne humeur au rendez-vous toute l’année.\nChez nous on ne se prend pas la tête, c’est détendu comme à la maison."
        ],
        "es": [
          "Restaurante sencillo y eficiente.\nBuen humor todo el año.\nNo nos lo tomamos demasiado en serio, es tan relajado como en casa."
        ],
        "nl": [
          "Eenvoudig en efficiënt restaurant.\nGoed humeur het hele jaar door.\nWe nemen het niet te serieus, het is net zo ontspannen als thuis."
        ]
      },
