    "de": [
      "Au Bureau Valenciennes: Geselliger angelsächsischer Pub, großzügige Küche, Aperitifs, Sport und Musik.\nDen ganzen Tag über geöffnet, um schöne Momente zu teilen."
    ],
    "en": [
      "Au Bureau Valenciennes: friendly Anglo-Saxon pub, generous cuisine, aperitifs, sports and music.\nOpen all day to share good times."
    ],
    "it": [
      "Au Bureau Valenciennes: pub anglosassone accogliente, cucina generosa, aperitivi, sport e musica.\nAperto tutto il giorno per condividere i momenti migliori."
    ],
    "fr": [
      "Au Bureau Valenciennes : pub anglo-saxon convivial, cuisine généreuse, apéros, sport et musique. \nOuvert toute la journée pour partager bons moments."
