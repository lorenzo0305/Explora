  "rdfs:comment": {
    "de": [
      "Als Akteur der nachhaltigen Mobilität bietet der Recyclinghof die Reparatur, Überholung und den Verleih von Elektrofahrrädern an und fördert damit eine zugängliche und umweltfreundliche Fortbewegung."
    ],
    "en": [
      "A key player in sustainable mobility, the Recyclerie offers repair, overhaul and rental services for electric bicycles, promoting accessible, environmentally-friendly travel."
    ],
    "it": [
      "Un attore chiave della mobilità sostenibile, il centro di riciclaggio offre riparazione, revisione e noleggio di biciclette elettriche, promuovendo spostamenti accessibili e rispettosi dell'ambiente."
    ],
    "fr": [
      "Actrice de la mobilité durable, la recyclerie propose la réparation, la révision et la location de vélos électriques, favorisant des déplacements accessibles et écologiques."
    ],
    "nl": [
      "Het recyclingcentrum, een belangrijke speler in duurzame mobiliteit, biedt reparatie, revisie en verhuur van elektrische fietsen, en bevordert toegankelijke, milieuvriendelijke verplaatsingen."
    ],
    "es": [
      "El centro de reciclado, un actor clave de la movilidad sostenible, ofrece servicios de reparación, revisión y alquiler de bicicletas eléctricas, fomentando los desplazamientos accesibles y respetuosos con el medio ambiente."
    ]
  },
