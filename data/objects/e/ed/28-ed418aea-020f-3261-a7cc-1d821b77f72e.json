  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: die schmackhafte Küche mit frischen Produkten und eine Speisekarte, die der Chefkoch alle zwei Monate erneuert"
    ],
    "en": [
      "You'll love: tasty cuisine based on fresh produce and a menu that the chef renews every two months"
    ],
    "it": [
      "Vi piacerà la gustosa cucina a base di prodotti freschi e un menu che lo chef cambia ogni due mesi"
    ],
    "fr": [
      "Vous aimerez : la cuisine savoureuse à base de produits frais et une carte que le chef renouvelle tous les deux mois"
    ],
    "es": [
      "Le encantará la sabrosa cocina basada en productos frescos y un menú que el chef cambia cada dos meses"
    ],
    "nl": [
