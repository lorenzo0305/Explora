      "dc:description": {
        "de": [
          "L'Improviste ist eine neue Brasserie, die den Gaumen mit hausgemachten Gerichten aus frischen Zutaten verwöhnt."
        ],
        "en": [
          "L'Improviste is a new brasserie that delights the taste buds with homemade dishes, made with fresh products."
        ],
        "it": [
          "L'Improviste è una nuova brasserie che delizia il palato con piatti fatti in casa a base di prodotti freschi."
        ],
        "fr": [
          "L'Improviste est une nouvelle brasserie qui régale les papilles avec des plats maison, réalisés à base de produits frais."
        ],
        "nl": [
          "L'Improviste is een nieuwe brasserie die de smaakpapillen verwent met huisgemaakte gerechten van verse producten."
        ],
        "es": [
          "L'Improviste es una nueva brasserie que deleita el paladar con platos caseros elaborados con productos frescos."
        ]
