  "rdfs:comment": {
    "de": [
      "Hier wird genossen, geschmeckt, gelacht und diskutiert..... Das Estaminet befindet sich in einem alten, restaurierten Bauernhaus. Probieren Sie unsere lokalen Spezialitäten, darunter den berühmten Welsh, in einer herzlichen und entspannten Atmosphäre!"
    ],
    "en": [
      "Here we enjoy, we savor, we laugh, we discuss.... The estaminet is installed in an old restored farm. Taste our local specialties, including the famous Welsh, all in a warm and relaxed atmosphere!"
    ],
    "it": [
      "Qui si gode, si assapora, si ride, si discute.... L'estaminet si trova in un'antica casa colonica restaurata. Assaggiate le nostre specialità locali, tra cui il famoso gallese, il tutto in un'atmosfera calda e rilassata!"
    ],
    "fr": [
      "Ici on profite, on savoure, on rit, on discute.... L’estaminet est installé dans une ancienne ferme restaurée. Goûtez à nos spécialités locales dont le fameux Welsh, le tout dans une ambiance chaleureuse et décontractée!"
    ],
    "nl": [
      "Hier genieten we, smullen we, lachen we, discussiëren we .... Het estaminet is gevestigd in een oude gerestaureerde boerderij. Proef onze lokale specialiteiten, waaronder de beroemde Welsh, in een warme en ontspannen sfeer!"
    ],
    "es": [
      "Aquí disfrutamos, saboreamos, reímos, discutimos.... El estaminet se encuentra en una antigua granja restaurada. Deguste nuestras especialidades locales, incluido el famoso galés, ¡todo ello en un ambiente cálido y relajado!"
    ]
  },
