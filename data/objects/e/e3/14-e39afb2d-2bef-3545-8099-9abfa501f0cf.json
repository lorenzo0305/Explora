      "dc:description": {
        "de": [
          "300 m2 großer überdachter Spielplatz für Kinder von 0-10 Jahren. Bereich für Kleinkinder von 0 bis 3 Jahren und Bereich für Kinder von 3-10 Jahren\nFeiern Sie den Geburtstag Ihres Kindes im Sunset Kids!"
        ],
        "en": [
          "300m2 covered play area for 0-10 year-olds. Play area for 0-3 year olds and play area for 3-10 year olds\nCelebrate your child's birthday at Sunset Kids!"
        ],
        "it": [
          "Area giochi coperta di 300 m2 per bambini da 0 a 10 anni. Area per bambini da 0 a 3 anni e area per bambini da 3 a 10 anni\nFesteggiate il compleanno del vostro bambino al Sunset Kids!"
        ],
        "fr": [
          "Aire de jeux couverte de 300m2, pour les 0-10 ans. Espace pour les petits de 0 à 3 ans et espace pour les 3-10 ans\nFêtez l'anniversaire de votre enfant au Sunset Kids !"
        ],
        "es": [
          "Zona de juegos cubierta de 300 m2 para niños de 0 a 10 años. Zona para niños de 0 a 3 años y zona para niños de 3 a 10 años\n¡Celebra el cumpleaños de tu hijo en Sunset Kids!"
        ],
        "nl": [
          "300m2 overdekte speelruimte voor kinderen van 0-10 jaar. Ruimte voor 0-3 jarigen en ruimte voor 3-10 jarigen\nVier de verjaardag van je kind bij Sunset Kids!"
        ]
      },
