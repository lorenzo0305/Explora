  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/61017967-f238-399d-90be-c822a0434ee9",
      "dc:description": {
        "de": [
          "Eine \"hausgemachte\" Küche, die vom Chefkoch zubereitet wird.\nFormule Buffet ab 16€ (Vorspeise, Hauptgericht, Käse, Dessert und Wein inbegriffen)\nSpezielle Gruppen (20 Pers. min.) FESTMESSEN von 19€ bis 39€ - ANIMIERTE MESSEN: Mittag- und/oder Abendessen mit Tanz, mit oder ohne Show."
        ],
        "en": [
          "A \"home-made\" kitchen created by the Chef.\nBuffet formula from 16€ (Starter, main course, cheese, dessert and wine included.)\nSpecial Groups (20 people min.) PARTY MEALS from 19€ to 39€ - MEALS FOR ANIMALS: Lunch and/or dinner dancing with or without show."
        ],
        "it": [
          "Cucina casalinga dello chef.\nFormula a buffet a partire da 16? (Antipasto, piatto principale, formaggio, dessert e vino inclusi)\nGruppi speciali (minimo 20 persone) PASTI FESTIVAL da 19? a 39? - PASTI ANIMALI: Pranzo e/o cena danzante con o senza spettacolo."
        ],
        "fr": [
          "Une cuisine \"maison\" réalisée par le Chef cuisinier.\nFormule Buffet à partir de 16€ (Entrée, plat, fromage, dessert et vin inclus.)\nSpécial Groupes (20 pers mini.) REPAS DE FÊTE de 19€ à 39€ - REPAS ANIMES: Déjeuner et/ou dîner dansant avec ou sans spectacle."
        ],
        "nl": [
          "Thuis koken door de chef.\nBuffetformule vanaf 16? (Voorgerecht, hoofdgerecht, kaas, dessert en wijn inbegrepen)\nSpeciale groepen (minimaal 20 personen) FESTIVALMIDDELEN van 19? tot 39? - DIERENMALEN: Lunch en/of diner met of zonder show."
        ],
        "es": [
          "Cocina casera del chef.\nFórmula buffet a partir de 16? (Entrada, plato principal, queso, postre y vino incluidos)\nGrupos especiales (20 personas mínimo) COMIDAS DEL FESTIVAL de 19? a 39? - COMIDAS ANIMALES: Almuerzo y/o cena baile con o sin espectáculo."
        ]
      },
