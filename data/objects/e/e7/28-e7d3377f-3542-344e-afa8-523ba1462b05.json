  "rdfs:comment": {
    "de": [
      "Modernes Bistro, das die Küche von hier und anderswo auf seine Weise neu interpretiert. Alle unsere Gerichte, Desserts und Soßen sind hausgemacht. Wir bevorzugen frische Produkte und kurze Transportwege. Weinbar, Cocktails mit Signatur. Musikalische und familiäre Atmosphäre."
    ],
    "en": [
      "A modern bistro that revisits local and international cuisine in its own way. All our dishes, desserts and sauces are homemade. We favor fresh produce and short supply chains. Wine bar, signature cocktails. Musical and family atmosphere."
    ],
    "it": [
      "Un bistrot moderno che rivisita a modo suo la cucina locale e internazionale. Tutti i nostri piatti, i dessert e le salse sono fatti in casa. Privilegiamo i prodotti freschi e le filiere corte. Wine bar, cocktail d'autore. Atmosfera musicale e familiare."
    ],
    "fr": [
      "Bistrot moderne qui revisite à sa façon la cuisine d'ici et d'ailleurs. Tous nos plats, desserts et sauces sont faits maison. Nous favorisons les produits frais et les circuits courts. Bar à vins, cocktails signatures. Ambiance musicale et familiale."
    ],
    "es": [
      "Un bistró moderno que revisita a su manera la cocina local e internacional. Todos nuestros platos, postres y salsas son caseros. Favorecemos los productos frescos y las cadenas de suministro cortas. Bar de vinos, cócteles de autor. Ambiente musical y familiar."
    ],
    "nl": [
      "Een moderne bistro die de lokale en internationale keuken op zijn eigen manier herziet. Al onze gerechten, desserts en sauzen zijn huisgemaakt. We geven de voorkeur aan verse producten en korte leveringsketens. Wijnbar, kenmerkende cocktails. Muzikale en familiale sfeer."
    ]
  },
  "rdfs:label": {
