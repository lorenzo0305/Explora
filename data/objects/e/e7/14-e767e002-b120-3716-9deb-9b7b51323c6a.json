  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0bece142-88f5-3c03-b61f-eda2443f16f5",
      "dc:description": {
        "de": [
          "Der Verein schafft Freundschaften, hilft und berät bei Näharbeiten in Form von Beratungen und Umsetzungen (zur Verfügung stehen Nähmaschinen, Überwendlichnäher, Stickerei)."
        ],
        "en": [
          "The association creates bonds of friendship, helps and advises in the work of sewing, in the form of consultations and realizations (at disposal sewing machines, on throws, embroiderer)."
        ],
        "it": [
          "L'associazione crea amicizie, aiuta e consiglia nel cucito, sotto forma di consulenze e realizzazioni (macchine da cucire, rovesciatori, ricamatrici a disposizione)."
        ],
        "fr": [
          "L'association créée des liens d'amitié, aide et conseille dans les travaux de couture, sous forme de consultations et de réalisations (à disposition machines à coudre, sur jeteuse, brodeuse)."
        ],
        "es": [
          "La asociación crea amistades, ayuda y asesora en costura, en forma de consultas y realizaciones (máquinas de coser, volteadora, bordadora a disposición)."
        ],
        "nl": [
          "De vereniging schept vriendschappen, helpt en adviseert bij het naaien, in de vorm van consultaties en realisaties (naaimachines, overgooier, borduurster ter beschikking)."
        ]
      },
