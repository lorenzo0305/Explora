  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/10729d69-9dc1-3c11-a122-c0d73df78781",
      "dc:description": {
        "de": [
          "Gehen Sie durch die Schaufenster der teilnehmenden Händler, um die Ostereier zu finden. Bei der Verlosung mit Überprüfung der Antworten gibt es Schokolade zu gewinnen."
        ],
        "en": [
          "Go round the shop windows of participating retailers to find the Easter eggs. Chocolates to be won in a draw with verification of answers."
        ],
        "it": [
          "Girate per le vetrine dei negozi aderenti all'iniziativa per trovare le uova di Pasqua. I cioccolatini si vincono a sorteggio con la verifica delle risposte."
        ],
        "fr": [
          "Faites le tour des vitrines des commerçants participant à l’opération pour retrouver les œufs de Pâques. Chocolats à gagner au tirage au sort avec vérification des réponses."
        ],
        "es": [
          "Recorra los escaparates de los comercios participantes para encontrar los huevos de Pascua. Se sortearán chocolatinas al comprobar las respuestas."
        ],
        "nl": [
          "Ga langs de etalages van deelnemende winkeliers om de paaseieren te vinden. Er zijn chocolaatjes te winnen in een loterij bij verificatie van de antwoorden."
        ]
      },
