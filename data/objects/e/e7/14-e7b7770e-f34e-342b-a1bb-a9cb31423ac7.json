  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1f9cdfe3-60fe-305b-910a-a6445ddb8a70",
      "dc:description": {
        "de": [
          "Gehen Sie an Bord eines Aluminiumbootes und tauchen Sie ein in eine ruhige, unberührte Umgebung, in der Sie eine Vielzahl von Tieren und Pflanzen sehen und die Lebensweise der Sumpfbewohner kennen lernen können."
        ],
        "en": [
          "Climb aboard an aluminum boat and immerse yourself in a calm, unspoilt setting where you can spot a multitude of animals and plants, and discover the way of life of the marsh's inhabitants."
        ],
        "it": [
          "Salite a bordo di un'imbarcazione in alluminio e immergetevi in un ambiente tranquillo e incontaminato, dove potrete avvistare una moltitudine di animali e piante e scoprire lo stile di vita degli abitanti della palude."
        ],
        "fr": [
          "Embarquez à bord d'une barque en aluminium et plongez dans un décor calme et préservé où vous pourrez apercevoir une multitude d'animaux, de plantes et découvrir le mode de vie des habitants du marais."
        ],
        "es": [
          "Suba a bordo de un barco de aluminio y sumérjase en un entorno tranquilo y virgen donde podrá avistar multitud de animales y plantas y descubrir el modo de vida de los habitantes de la marisma."
        ],
        "nl": [
          "Klim aan boord van een aluminium boot en duik in een kalme, ongerepte omgeving waar je een veelheid aan dieren en planten kunt spotten en de levenswijze van de moerasbewoners kunt ontdekken."
        ]
      },
      "@type": [
        "Description"
      ],
