  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/873dd8a0-c24a-3f88-9453-4409b1a7f562",
      "dc:description": {
        "de": [
          "Entspannen Sie sich zu zweit oder mit der Familie in einer angenehmen und gemütlichen Umgebung mit Blick auf das Schloss und den See.\nRestaurant - Eisdiele - Grillspezialitäten vom Holzkohlengrill - Minigolf - Sommerterrasse"
        ],
        "en": [
          "Come and relax as a couple or with your family in a pleasant and warm setting with a view of the castle and the lake.\nRestaurant - Ice cream parlour - Specialities grilled on wood fire - Mini golf - Summer terrace"
        ],
        "it": [
          "Venite a rilassarvi in coppia o in famiglia in un ambiente piacevole e accogliente con vista sul castello e sul lago.\nRistorante - Gelateria - Specialità alla griglia su fuoco a legna - Mini golf - Terrazza estiva"
        ],
        "fr": [
          "Venez vous détendre en couple ou en famille dans un cadre agréable et chaleureux avec vue sur le château et le lac.\nRestauration - Glacier - Spécialités grillades au feu de bois - Mini golf  - Terrasse d'été"
        ],
        "es": [
          "Venga a relajarse en pareja o en familia en un entorno agradable y cálido con vistas al castillo y al lago.\nRestaurante - Heladería - Especialidades a la parrilla con fuego de leña - Minigolf - Terraza de verano"
        ],
        "nl": [
          "Kom en ontspan als koppel of als gezin in een aangename en warme omgeving met uitzicht op het kasteel en het meer.\nRestaurant - IJssalon - Specialiteiten gegrild op houtvuur - Minigolf - Zomerterras"
        ]
      },
      "@type": [
        "Description"
      ],
