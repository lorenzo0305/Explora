  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/597d58c2-4f5b-3f2b-a3ce-3f435d6cbb21",
      "dc:description": {
        "de": [
          "Beers & Co, Ihr Restaurant im amerikanischen Stil in Ihrer Nähe! Das Team empfängt Sie in einer herzlichen und freundlichen Atmosphäre das ganze Jahr über, jeden Tag :) Kommen Sie und lassen Sie es sich schmecken!"
        ],
        "en": [
          "Beers & Co, your American-style restaurant near you! The team welcomes you in a warm and friendly atmosphere all year round, every day :) Come and enjoy!"
        ],
        "it": [
          "Beers & Co, il ristorante in stile americano vicino a voi! Il team vi accoglie in un'atmosfera calda e amichevole tutto l'anno, tutti i giorni :) Venite e divertitevi!"
        ],
        "fr": [
          "Beers & Co, votre restaurant de style Américain proche de chez vous ! L'équipe vous accueille dans une ambiance chaleureuse et conviviale toute l'année, tous les jours :) Venez vous régaler !"
        ],
        "nl": [
          "Beers & Co, uw restaurant in Amerikaanse stijl bij u in de buurt! Het team verwelkomt je in een warme en vriendelijke sfeer, het hele jaar door, elke dag :) Kom en geniet!"
        ],
        "es": [
          "Beers & Co, ¡su restaurante americano más cercano! El equipo le da la bienvenida en un ambiente cálido y acogedor durante todo el año, todos los días :) ¡Venga y disfrute!"
        ]
      },
