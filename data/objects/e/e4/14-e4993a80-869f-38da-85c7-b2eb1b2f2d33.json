      "@id": "https://data.datatourisme.fr/c8d655f2-3876-3824-9a94-816d14160b10",
      "dc:description": {
        "de": [
          "80er Abend mit :\nWILLIAM (Beginn des Abends) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nTreffpunkt um 21 Uhr in der Sporthalle Giraux-Sannier\n\nPyrotechnische Show im Anschluss an das Konzert\n\nDer Eintritt ist frei ? Begrenzte Anzahl an Plätzen"
        ],
        "en": [
          "Soirée 80 with :\nWILLIAM (Early evening) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRDV at 9pm at the Salle de sport Giraux-Sannier\n\nFireworks show at the end of the concert\n\nFree admission ? Limited seating"
        ],
        "it": [
          "Serata anni '80 con :\nWILLIAM (Inizio serata) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nRitrovo alle 21.00 alla Salle de sport Giraux-Sannier\n\nSpettacolo pirotecnico alla fine del concerto\n\nIngresso libero? Posti limitati"
        ],
        "fr": [
          "Soirée 80 avec :\nWILLIAM (Début de Soirée) – PATRICK HERNANDEZ – JEAN-PIERRE MADER – COOKIE DINGLER\nRDV à 21h à la Salle de sport Giraux-Sannier\n\nSpectacle pyrotechnique à l’issue du concert\n\nEntrée gratuite – Places limitées"
        ],
        "es": [
          "Velada de los 80 con :\nWILLIAM (Comienzo de la velada) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nCita a las 21h en la Salle de sport Giraux-Sannier\n\nEspectáculo de fuegos artificiales al final del concierto\n\nEntrada gratuita Aforo limitado"
        ],
        "nl": [
          "Jaren 80 avond met :\nWILLIAM (vroege avond) ? PATRICK HERNANDEZ ? JEAN-PIERRE MADER ? COOKIE DINGLER\nAfspraak om 21u in de Salle de sport Giraux-Sannier\n\nVuurwerkshow na het concert\n\nGratis toegang? Beperkte zitplaatsen"
        ]
      },
