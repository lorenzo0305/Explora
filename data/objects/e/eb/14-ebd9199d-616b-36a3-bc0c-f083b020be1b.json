  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3f6f79d0-6f54-3fd6-9932-009bbc80beb5",
      "dc:description": {
        "de": [
          "Start: Sorrus (Kirche)\n6 km - 2 Std. - Bei Regen schlammig\nEin Spaziergang für die ganze Familie durch die umliegende Landschaft. Sie werden auch den Communal de Sorrus, ein geschütztes Naturerbe, zu schätzen wissen. Es besteht aus Wäldern, Wiesen, Heideflächen und Tümpeln. Hier finden sich sehr viele Tier- und Pflanzenarten."
        ],
        "en": [
          "Start : Sorrus (Church)\n6 km - 2h - Muddy in wet weather\nA family walk in the surrounding countryside. You'll also appreciate the Sorrus Communal, a protected natural heritage site. It is made up of woods, meadows, moors and ponds. The area is home to many species of flora and fauna."
        ],
        "it": [
          "Partenza : Sorrus (Chiesa)\n6 km - 2h - Fangoso in caso di pioggia\nUna passeggiata per famiglie nella campagna circostante. Potrete apprezzare il Comune di Sorrus, patrimonio naturale protetto. È costituito da boschi, prati, brughiere e stagni. Ospita numerose specie di flora e fauna."
        ],
        "fr": [
          "Départ : Sorrus (Église)\n6 km - 2h - Boueux par temps de pluie\nUne balade familiale dans la campagne environnante. Vous saurez également apprécier le Communal de Sorrus, patrimoine naturel protégé. Il est constitué de bois, de prairies, de landes et de mares. On y trouve de très nombreuses espèces animales et végétales."
        ],
        "nl": [
          "Start : Sorrus (Kerk)\n6 km - 2u - Modderig bij nat weer\nEen gezinswandeling in de omgeving. U zult ook de gemeente Sorrus waarderen, een beschermd natuurlijk erfgoed. Het bestaat uit bossen, weiden, heide en vijvers. Het is de thuisbasis van vele soorten flora en fauna."
        ],
        "es": [
          "Salida : Sorrus (Iglesia)\n6 km - 2h - Embarrado con tiempo húmedo\nUn paseo familiar por los alrededores. Podrá apreciar el Comunal de Sorrus, patrimonio natural protegido. Está formado por bosques, prados, páramos y estanques. Alberga numerosas especies de flora y fauna."
        ]
      },
