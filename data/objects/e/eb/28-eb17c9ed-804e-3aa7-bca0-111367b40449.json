  "rdfs:comment": {
    "de": [
      "Die deutsche Militärnekropole von Vermandovillers ist mit ihren 22 632 Soldaten die größte des Departements. Sie erinnert an die deutschen Soldaten, die von 1916 bis 1918 in der Somme kämpften."
    ],
    "en": [
      "The German military necropolis at Vermandovillers, with its 22,632 soldiers, is the largest in the département. It commemorates the memory of German soldiers who fought in the Somme from 1916 to 1918."
    ],
    "it": [
      "La necropoli militare tedesca di Vermandovillers, con i suoi 22.632 soldati, è la più grande del dipartimento. Commemora la memoria dei soldati tedeschi che hanno combattuto sulla Somme tra il 1916 e il 1918."
    ],
    "fr": [
      "La nécropole militaire allemande de Vermandovillers avec ses 22 632 soldats est la plus grande du département. Elle commémore la mémoire des soldats allemands ayant combattu dans la Somme de 1916 à 1918."
    ],
    "es": [
      "La necrópolis militar alemana de Vermandovillers, con sus 22.632 soldados, es la más grande del departamento. Conmemora la memoria de los soldados alemanes que lucharon en el Somme entre 1916 y 1918."
    ],
    "nl": [
      "De Duitse militaire necropolis in Vermandovillers is met 22.632 soldaten de grootste van het departement. Het herdenkt de Duitse soldaten die tussen 1916 en 1918 aan de Somme vochten."
    ]
  },
