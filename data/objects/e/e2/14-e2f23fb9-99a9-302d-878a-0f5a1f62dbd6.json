  "rdfs:comment": {
    "de": [
      "Zoufris Maracas ist der strahlende Nachwuchs der Partyszene in der Tradition von Mano Negra oder den Grünen Negerinnen. Sie schaffen es besser als je zuvor, poetische Texte, sozialen Aktivismus und musikalische Reisen miteinander zu verbinden."
    ],
    "en": [
      "Zoufris Maracas has established itself as a brilliant newcomer to the party scene in the tradition of Mano Negra and Les Négresses Vertes, succeeding more than ever in combining poetic lyrics, social activism and musical journeys."
    ],
    "it": [
      "Gli Zoufris Maracas si sono affermati come una brillante novità sulla scena dei party nella tradizione di Mano Negra e Les Négresses Vertes, riuscendo più che mai a combinare testi poetici, attivismo sociale e viaggi musicali."
    ],
    "fr": [
      "Zoufris Maracas s’impose comme l’éclatante relève de la scène festive dans la lignée de la Mano Negra ou des Négresses Vertes, en réussissant mieux que jamais à marier poésie des textes, activisme sociale, et voyages musicaux."
    ],
    "es": [
      "Zoufris Maracas se ha consolidado como un brillante recién llegado a la escena de la fiesta en la tradición de Mano Negra y Les Négresses Vertes, logrando más que nunca combinar letras poéticas, activismo social y viajes musicales."
    ],
    "nl": [
      "Zoufris Maracas heeft zich gevestigd als een briljante nieuwkomer in de partyscene in de traditie van Mano Negra en Les Négresses Vertes, die er meer dan ooit in slaagt poëtische teksten, sociaal activisme en muzikale reizen te combineren."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Zoufris Maracas + Guest - Festival les Enchanteurs"
    ]
  },
