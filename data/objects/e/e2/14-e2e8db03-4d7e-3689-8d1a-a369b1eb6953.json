  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4b5cb236-7ef3-317c-afec-906015169d89",
      "dc:description": {
        "de": [
          "Stéphanie ALLISSE ist Erdbeerbäuerin in Coupelle Vieille. Am Eingang ihres Betriebs finden Sie einen Automaten mit vor Ort hergestellten Produkten: Erdbeeren, Apfelsaft, Marmelade, etc."
        ],
        "en": [
          "Stéphanie ALLISSE is a strawberry grower in Coupelle Vieille. At the entrance to her farm, you'll find a vending machine featuring products made on site: strawberries, apple juice, jam, etc..."
        ],
        "it": [
          "Stéphanie ALLISSE è una coltivatrice di fragole a Coupelle Vieille. All'ingresso della sua fattoria, troverete un distributore automatico di prodotti fatti sul posto: fragole, succo di mela, marmellata, ecc..."
        ],
        "fr": [
          "Stéphanie ALLISSE est producteur de fraises à Coupelle Vieille. A l'entée de son exploitation, vous trouverez un distributeur automatique à base de produits fabriqués sur place : fraises, jus de pomme, confiture, etc..."
        ],
        "nl": [
          "Stéphanie ALLISSE is aardbeienteler in Coupelle Vieille. Bij de ingang van haar boerderij vind je een automaat waar producten worden verkocht die ter plekke zijn gemaakt: aardbeien, appelsap, jam, enz..."
        ],
        "es": [
          "Stéphanie ALLISSE cultiva fresas en Coupelle Vieille. A la entrada de su granja, encontrará una máquina expendedora de productos elaborados en la propia explotación: fresas, zumo de manzana, mermelada, etc..."
        ]
      },
