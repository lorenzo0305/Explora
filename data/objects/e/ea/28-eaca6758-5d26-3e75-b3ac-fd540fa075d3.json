  "rdfs:comment": {
    "de": [
      "Dominique PIERRU ist Glasmaler und arbeitet mit altmodischen Glasmalereien, Glasschnitt und Bleigießen, Grisaille und Fusing. Es besteht die Möglichkeit, sich für Workshops anzumelden.\n\nFinden Sie seine Kreationen in seinem Laden- und Atelierbereich (Boutique, Ausstellung und Mini-Flohmarkt)!"
    ],
    "en": [
      "Dominique PIERRU is a stained glass artist who works with traditional stained glass, glass cutting and leaded glass, grisaille and fusing. Possibility of registering for workshops.\n\nSee her creations in her boutique/workshop (store, exhibition and mini-brocante)!"
    ],
    "it": [
      "Dominique PIERRU è un artista della vetrata che lavora con la vetrata tradizionale, il taglio del vetro e il vetro piombato, la grisaglia e la fusione. Possibilità di iscriversi ai workshop.\n\nScoprite le sue creazioni nel suo negozio/laboratorio (boutique, esposizione e mini-brocante)!"
    ],
    "fr": [
      "Artiste vitrailliste, Dominique PIERRU travaille le vitrail à l’ancienne, la découpe du verre et la mise en plomb, la grisaille et le fusing. Possibilité de s’inscrire à des ateliers.\n\nRetrouvez ses créations dans son espace boutique/atelier (boutique, expo et mini brocante) !"
    ],
    "nl": [
      "Dominique PIERRU is een glas-in-lood kunstenaar die werkt met traditioneel glas-in-lood, glas snijden en glas in lood, grisaille en fusing. Mogelijkheid tot inschrijving voor workshops.\n\nBekijk haar creaties in haar winkel/atelier (boetiek, tentoonstelling en mini-brocante)!"
    ],
    "es": [
      "Dominique PIERRU es un artista vidriero que trabaja con vidrieras tradicionales, corte de vidrio y vidrio emplomado, grisalla y fusing. Posibilidad de inscribirse en talleres.\n\nDescubra sus creaciones en su tienda-taller (boutique, exposición y mini-brocante)"
    ]
  },
  "rdfs:label": {
