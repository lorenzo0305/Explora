  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/87dd1934-a96a-36fb-8f13-178f32001e73",
      "dc:description": {
        "de": [
          "Kollektiver Spielplatz für Kinder.\nDie Gelegenheit für Kinder, sich auszutoben, gemeinsam zu spielen und die frische Luft in vollen Zügen zu genießen."
        ],
        "en": [
          "Collective play area for children.\nAn opportunity for children to let off steam, play together and enjoy the great outdoors."
        ],
        "it": [
          "Area di gioco collettiva per bambini.\nUn'opportunità per i bambini di sfogarsi, giocare insieme e sfruttare al meglio l'aria aperta."
        ],
        "fr": [
          "Aire collective de jeux pour enfants.\nL'occasion pour les enfants de se défouler, de jouer ensemble et de profiter pleinement du grand air."
        ],
        "es": [
          "Zona de juegos colectivos para niños.\nUna oportunidad para que los niños se desahoguen, jueguen juntos y aprovechen al máximo el aire libre."
        ],
        "nl": [
          "Collectieve speelruimte voor kinderen.\nEen kans voor kinderen om stoom af te blazen, samen te spelen en te genieten van de buitenlucht."
        ]
      },
