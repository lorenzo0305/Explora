      "dc:description": {
        "de": [
          "Informationen :\n\nÖffnungszeiten: Auf dem Parkplatz des Carrefour Contact\nMittwoch, Donnerstag und Sonntag: 18:00-21:00 Uhr\n \n Bestellung:\nBestellung per Telefon unter 06 82 37 66 40 möglich\n\n "
        ],
        "en": [
          "Information :\n\nOpening days: On the Carrefour Contact parking lot\nWednesday, Thursday and Sunday: 6pm-9pm\n \n Ordering :\nOrder by phone 06 82 37 66 40\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nGiorni di apertura: nel parcheggio del Carrefour Contact\nMercoledì, giovedì e domenica: 18.00-21.00\n \n Come ordinare :\nÈ possibile ordinare per telefono al numero 06 82 37 66 40\n\n "
        ],
        "fr": [
          "Informations :\n\nJours d'ouverture : Sur le parking du Carrefour Contact\nLe mercredi, le jeudi et le dimanche: 18h-21h \n \n Commande : \nPossibilité de commander par téléphone au 06 82 37 66 40\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nOpeningsdagen: In de parking van Carrefour Contact\nWoensdag, donderdag en zondag: 18u-9u\n \n Hoe te bestellen :\nU kunt telefonisch bestellen op 06 82 37 66 40\n\n "
        ],
        "es": [
          "Más información :\n\nDías de apertura: En el aparcamiento Carrefour Contact\nMiércoles, jueves y domingo: de 18.00 a 21.00 h\n \n Cómo hacer un pedido :\nPuede hacer su pedido por teléfono llamando al 06 82 37 66 40\n\n "
        ]
      },
