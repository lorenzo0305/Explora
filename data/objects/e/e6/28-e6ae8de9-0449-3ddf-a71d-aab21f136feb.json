  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a65026a2-a851-3b1f-a71c-779208babf95",
      "dc:description": {
        "de": [
          "Anspielung auf die lokale Geschichte anhand verschiedener Sammlungen: Alte Kirche, Feuerwehr, Templer, Radiosender, verschiedene Berufe, Ausstellung 39/45, Archäologie, Spitzenklöpplerin, Schneider, Arzt 1950, Schuster, Schule 1950, Cécilium,"
        ],
        "en": [
          "Evocation of local history through various collections: Old church, firemen, Templars, radio, various trades, exhibition 39/45, archaeology, lace-maker, tailor clothes, doctor year 1950, shoemaker, school 1950, cécilium,"
        ],
        "it": [
          "Evocazione della storia locale attraverso varie collezioni: Chiesa vecchia, vigili del fuoco, templari, radio, mestieri vari, mostra 39/45, archeologia, merlettaia, sarto, medico 1950, calzolaio, scuola 1950, cecilio,"
        ],
        "fr": [
          "Evocation de l'histoire locale au travers de diverses collections : Ancienne église ,sapeurs pompiers, templiers, poste radio, métier divers, expo 39/45, archéologie, dentellière, tailleur vêtements, docteur année 1950, cordonnier, école 1950, cécilium,"
        ],
        "nl": [
          "Het oproepen van de lokale geschiedenis door middel van verschillende collecties: Oude kerk, brandweer, tempeliers, radio, diverse ambachten, 39/45 tentoonstelling, archeologie, kantklosster, kleermaker, dokter 1950, schoenmaker, school 1950, cecilium,"
        ],
        "es": [
          "Evocación de la historia local a través de diversas colecciones: Antigua iglesia, bomberos, templarios, radio, oficios varios, exposición 39/45, arqueología, encajera, sastre de ropa, médico 1950, zapatero, escuela 1950, cecilio,"
        ]
      },
