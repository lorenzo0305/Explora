  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/697f4c21-3992-35c2-b169-b988f14a8f9d",
      "dc:description": {
        "de": [
          "Indoor-Triathlon-Weltcup der Arena Hallenstadion mit den weltbesten Triathleten (Männer und Frauen) in sehr kurzen Formaten (10 min Rennen) und in Turnierform (1/4-Finale, 1/2-Finale und Finale)."
        ],
        "en": [
          "Indoor Triathlon World Cup at the Arena indoor stadium, featuring the world's best triathletes (men and women) in very short (10-minute race) and tournament formats (1/4 final, 1/2 final and final)."
        ],
        "it": [
          "Coppa del mondo di triathlon indoor allo stadio indoor Arena, con i migliori triatleti del mondo (uomini e donne) che si sfidano in formati molto brevi (gare di 10 minuti) e in formato torneo (1/4 di finale, 1/2 finale e finale)."
        ],
        "fr": [
          "Coupe du monde de Triathlon indoor de l'Arena stade couvert, avec les meilleurs triathlètes mondiaux (hommes et femmes) sur des formats très cours (10 min de course) et sous forme de tournoi (1/4 de finale, 1/2 finale et finale)."
        ],
        "nl": [
          "Wereldkampioenschap triatlon indoor in het Arena indoorstadion, met 's werelds beste triatleten (mannen en vrouwen) die strijden in zeer korte formaten (races van 10 minuten) en in toernooivorm (1/4 finale, 1/2 finale en finale)."
        ],
        "es": [
          "Copa del Mundo de Triatlón Indoor en el estadio cubierto Arena, con los mejores triatletas del mundo (hombres y mujeres) compitiendo en formatos muy cortos (carreras de 10 minutos) y en formato torneo (1/4 de final, 1/2 de final y final)."
        ]
      },
