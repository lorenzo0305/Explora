  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e0dd27a3-41e1-399a-ac61-70530477dd6a",
      "dc:description": {
        "de": [
          "Begeben Sie sich auf eine 45-minütige Führung, um alles zu verstehen, was sich hinter diesen außergewöhnlichen, gefährlichen, zutiefst menschlichen und geschichtsträchtigen archäologischen Baustellen verbirgt. ?"
        ],
        "en": [
          "Take a 45-minute guided tour to understand what lies behind these unusual, dangerous, deeply human and history-filled archaeological sites?"
        ],
        "it": [
          "Partecipate a una visita guidata di 45 minuti per capire cosa si cela dietro questi siti archeologici insoliti, pericolosi, profondamente umani e ricchi di storia?"
        ],
        "fr": [
          "Partez en visite guidée de 45 minutes pour comprendre tout ce qui cache derrière ces chantiers archéologiques hors-du-commun, dangereux, profondément humain et remplis d’histoire. ​"
        ],
        "es": [
          "Realice una visita guiada de 45 minutos para comprender lo que hay detrás de estos yacimientos arqueológicos insólitos, peligrosos, profundamente humanos y llenos de historia.."
        ],
        "nl": [
          "Neem een rondleiding van 45 minuten om te begrijpen wat er achter deze ongewone, gevaarlijke, diep menselijke en met geschiedenis gevulde archeologische sites schuilgaat ?"
        ]
      },
      "@type": [
        "Description"
