  "rdfs:comment": {
    "de": [
      "Traditionelle, frische und abwechslungsreiche Küche. Wird in seinem unabhängigen und ruhigen Raum serviert.\n\nFebruar sowie 3 Wochen im Sommer (letzte Juliwoche und erste Augustwoche) geschlossen."
    ],
    "en": [
      "Traditional, fresh and varied cuisine. Served in a separate, quiet dining room.\n\nClosed the 2nd fortnight of February and 3 weeks in summer (last week of July and first two weeks of August)."
    ],
    "it": [
      "Cucina tradizionale, fresca e varia. Servita in una sala da pranzo separata e tranquilla.\n\nChiuso la seconda metà di febbraio e 3 settimane in estate (ultima settimana di luglio e prime due settimane di agosto)."
    ],
    "fr": [
      "Cuisine traditionnelle, fraîche et diversifiée. Servie dans sa salle indépendante et silencieuse.\n\nFermeture la 2ème quinzaine de février ainsi que 3 semaines en été ( dernière semaine du mois de juillet et deux première semaine du mois d'août)."
    ],
    "nl": [
      "Traditionele, verse en gevarieerde keuken. Geserveerd in een aparte, rustige eetzaal.\n\nGesloten 2e helft van februari en 3 weken in de zomer (laatste week van juli en eerste twee weken van augustus)."
    ],
    "es": [
      "Cocina tradicional, fresca y variada. Servida en un comedor independiente y tranquilo.\n\nCerrado la 2ª quincena de febrero y 3 semanas en verano (última semana de julio y primeras dos semanas de agosto)."
    ]
  },
  "rdfs:label": {
