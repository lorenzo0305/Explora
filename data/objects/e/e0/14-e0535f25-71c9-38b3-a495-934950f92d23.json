  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b21e15d1-37ea-39bf-baed-93fd33a08a12",
      "dc:description": {
        "de": [
          "Chor aus Sängern aus Montreuil und Umgebung, der auch eine Gruppe junger Sänger des Collège du Bras d'Or umfasst, das sich auf dem Gelände von Ecuires befindet."
        ],
        "en": [
          "Choir of singers from Montreuil and its surroundings including also a section of young singers from the Bras d'Or college, the latter located on the grounds of Ecuires."
        ],
        "it": [
          "Un coro di cantanti di Montreuil e dintorni, tra cui una sezione di giovani cantanti del collegio Bras d'Or, quest'ultimo situato sul terreno degli Ecuires."
        ],
        "fr": [
          "Chorale de chanteurs de Montreuil et ses environs incluant aussi une section de jeunes chanteurs du collège du Bras d'Or, ce dernier situé sur le terrain d'Ecuires."
        ],
        "es": [
          "Un coro de cantantes de Montreuil y sus alrededores, incluyendo una sección de jóvenes cantantes del colegio Bras d'Or, este último situado en el recinto de Ecuires."
        ],
        "nl": [
          "Een koor van zangers uit Montreuil en omgeving, waaronder een afdeling jonge zangers van het college Bras d'Or, dat op het terrein van de Ecuires is gevestigd."
        ]
      },
