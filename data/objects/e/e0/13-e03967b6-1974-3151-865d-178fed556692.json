  "rdfs:comment": {
    "de": [
      "Dieser Gastronom aus dem Avesnois® empfängt Sie in einem warmen und freundlichen Rahmen und wird Ihnen ein kulinarisches Erlebnis bieten, das Tradition und Moderne miteinander verbindet."
    ],
    "en": [
      "This Avesnois® restaurant owner welcomes you in a warm and friendly atmosphere and will make you live a culinary experience combining tradition and modernity."
    ],
    "it": [
      "Questo ristoratore di Avesnois® vi accoglie in un ambiente caldo e cordiale e vi offre un'esperienza culinaria che combina tradizione e modernità."
    ],
    "fr": [
      "Ce restaurateur de l'Avesnois® vous accueille dans un cadre chaleureux et convivial vous fera vivre une expérience culinaire alliant le traditionnel et la modernité."
    ],
    "es": [
      "Este restaurador de Avesnois® le da la bienvenida en un ambiente cálido y acogedor y le ofrece una experiencia culinaria que combina lo tradicional y lo moderno."
    ],
    "nl": [
      "Deze Avesnois® restauranthouder ontvangt u in een warm en vriendelijk kader en biedt u een culinaire ervaring die het traditionele en het moderne combineert."
    ]
  },
