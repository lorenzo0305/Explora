  "rdfs:comment": {
    "de": [
      "?sprechen sprechen sprechen sprechen? um die Luft zu bewegen, um zu zeigen, dass man zu leben weiß und dass man Manieren hat? Bernard Dimey"
    ],
    "en": [
      "talk talk talk? to get the air moving, to show that we know how to live and that we have manners? Bernard Dimey"
    ],
    "it": [
      "parlare parlare parlare? Per far muovere l'aria, per dimostrare che sappiamo vivere e che abbiamo le buone maniere? Bernard Dimey"
    ],
    "fr": [
      "“Parler parler parler… pour que l’air se déplace, pour montrer qu’on sait vivre et qu’on a des façons… ” Bernard Dimey"
    ],
    "nl": [
      "om de lucht in beweging te krijgen, om te laten zien dat we weten hoe we moeten leven en dat we manieren hebben? Bernard Dimey"
    ],
    "es": [
      "?hablar hablar hablar? para que corra el aire, para demostrar que sabemos vivir y que tenemos modales? Bernard Dimey"
    ]
  },
