  "rdfs:comment": {
    "de": [
      "St. Patrick's Day-Abend: Irisches Essen und Konzert der Gruppe Just?In, anschließend DJ-Animation.\nEin echtes Eintauchen in die irische Kultur!\nEssen für Erwachsene: 35 (Rindfleisch mit Guiness - Käse - gegrillte Äpfel - 1 Bier gratis)\nKindermenü: 8 (Pommes frites - Nuggets)\n\nReservierungen unter: https://lesephemeres.org/evenements und im Kulturzentrum Leclerc Etalondes, nur Barzahlung oder Scheck möglich."
    ],
    "en": [
      "St. Patrick's evening: Irish meal and concert by the band Just?In, followed by DJ entertainment.\nA real immersion in Irish culture!\nAdult meal: 35? (Beef with Guiness - Cheese - Grilled with apples - 1 complimentary beer)\nChildren's menu: 8? (French fries - Nuggets)\n\nReservations on: https://lesephemeres.org/evenements and at the Leclerc Etalondes cultural center, payment by cash or cheque only."
    ],
    "it": [
      "Serata di San Patrizio: cena irlandese e concerto del gruppo Just?In, seguito da intrattenimento con DJ.\nUna vera e propria immersione nella cultura irlandese!\nCena per adulti: 35 € (Manzo alla Guinness - Formaggio - Grigliata con mele - 1 birra in omaggio)\nMenu per bambini: 8 € (Patatine - Nuggets)\n\nLe prenotazioni possono essere effettuate su: https://lesephemeres.org/evenements e presso il centro culturale Leclerc Etalondes. Pagamento solo in contanti o con assegno."
    ],
    "fr": [
      "Soirée Saint-Patrick : Repas irlandais et concert du groupe Just’In, puis animation DJ. \nUne vrai immersion dans la culture irlandaise ! \nRepas adulte : 35€ (Bœuf à la Guiness - Fromage - Grillé aux pommes - 1 bière offerte)\nMenu enfant : 8€ (Frites - Nuggets)\n\nRéservation sur : https://lesephemeres.org/evenements et en point de vente à l’espace culturel Leclerc Etalondes, paiement en espèce ou en chèque uniquement."
    ],
    "nl": [
      "St Patrick's avond: Ierse maaltijd en concert door de groep Just?In, gevolgd door DJ entertainment.\nEen echte onderdompeling in de Ierse cultuur!\nVolwassen maaltijd: €35 (Rundvlees in Guinness - Kaas - Gegrild met appels - 1 gratis bier)\nKindermenu: €8 (Chips - Nuggets)\n\nReserveren kan op: https://lesephemeres.org/evenements en in het Leclerc Etalondes cultureel centrum. Betaling alleen contant of per cheque."
    ],
    "es": [
      "Noche de San Patricio: cena irlandesa y concierto del grupo Just?In, seguido de animación a cargo de un DJ.\n¡Una auténtica inmersión en la cultura irlandesa!\nComida para adultos: 35 euros (Ternera en Guinness - Queso - Parrillada con manzanas - 1 cerveza gratis)\nMenú infantil: 8 euros (Patatas fritas - Nuggets)\n\nLas reservas pueden hacerse en: https://lesephemeres.org/evenements y en el centro cultural Leclerc Etalondes. Pago en efectivo o cheque únicamente."
    ]
  },
