  "rdfs:comment": {
    "de": [
      "Die Familie Maclart-Barcelère bereitet Ihnen einen herzlichen Empfang, um Ihnen ihre verschiedenen Produkte vorzustellen: Foie gras und Fertiggerichte, Cidre fermier, Apfelsaft, fruchtige Säfte, Konfitüren und Bio-Suppen."
    ],
    "en": [
      "The Maclart-Barcelère Family reserves you a warm welcome in order to present you its various products: foie gras and ready-made meals, farm cider, apple juice, fruit juices, jams and organic soups."
    ],
    "it": [
      "La famiglia Maclart-Barcelère vi darà un caloroso benvenuto e vi presenterà i suoi vari prodotti: foie gras e piatti cucinati, sidro di fattoria, succo di mela, succo di frutta, marmellate e zuppe biologiche."
    ],
    "fr": [
      "La Famille Maclart-Barcelère vous réserve un accueil chaleureux afin de vous présenter ses différents produits : foie gras et plats cuisinés, cidre fermier, jus de pomme, jus fruités, confitures et soupes bio."
    ],
    "es": [
      "La familia Maclart-Barcelère le dará una cálida bienvenida y le presentará sus diversos productos: foie gras y platos cocinados, sidra de granja, zumo de manzana, zumo de frutas, mermeladas y sopas ecológicas."
    ],
    "nl": [
      "De familie Maclart-Barcelère heet u hartelijk welkom en stelt u hun verschillende producten voor: foie gras en bereide gerechten, cider van de boerderij, appelsap, vruchtensap, jam en biologische soepen."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Ferme des Charmettes"
    ]
  },
