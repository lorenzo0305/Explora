  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4bcbecd8-4cba-3418-984d-c44ff7caca16",
      "dc:description": {
        "de": [
          "Fort, das von 1682 bis 1690 von Vauban erbaut wurde. Einzige noch stehende Seefestung nördlich von Cherbourg. Sehenswert: die Festungsmauer und die Terrassen, der Turm und seine Kasematte, die als Informationsbasis eingerichtet wurde, die Hochterrasse und ihr Panorama."
        ],
        "en": [
          "Fort built from 1682 to 1690 by Vauban. The only sea fort still standing north of Cherbourg. Worth seeing: the rampart and terraces, the tower and its casemate converted into an information base, the upper terrace and its panoramic view."
        ],
        "it": [
          "Forte costruito tra il 1682 e il 1690 da Vauban. È l'unico forte marittimo ancora in piedi a nord di Cherbourg. Da non perdere: i bastioni e le terrazze, la torre e la sua casamatta trasformata in centro informazioni, la terrazza superiore e la sua vista panoramica."
        ],
        "fr": [
          "Fort construit de 1682 à 1690 par Vauban. Seul fort en mer encore debout au nord de Cherbourg. A voir : le rempart et les terrasses, la tour et sa casemate aménagée en base d'informations, la terrasse haute et son panorama."
        ],
        "es": [
          "Fuerte construido entre 1682 y 1690 por Vauban. Es el único fuerte marítimo que se conserva al norte de Cherburgo. No se pierda: las murallas y terrazas, la torre y su casamata convertida en centro de información, la terraza superior y su vista panorámica."
        ],
        "nl": [
          "Fort gebouwd tussen 1682 en 1690 door Vauban. Het enige zeefort dat nog overeind staat ten noorden van Cherbourg. Wat je niet mag missen: de wallen en terrassen, de toren en de kazemat die zijn omgebouwd tot informatiecentrum, het bovenste terras en het panoramische uitzicht."
        ]
      },
      "@type": [
        "Description"
      ],
