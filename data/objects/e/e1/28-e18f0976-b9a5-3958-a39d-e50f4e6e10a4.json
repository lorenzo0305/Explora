  "rdfs:comment": {
    "de": [
      "Restaurant und Teestube - Hausgemachtes Mittagessen, Snacks & Teestunden.\n\nHistorisches Gebäude, das unter Denkmalschutz steht. Terrasse inmitten eines bemerkenswerten Gartens.\n\nSaal mit 40 Sitzplätzen.\nPrivatisierung möglich."
    ],
    "en": [
      "Restaurant and tea room - Homemade lunch, snacks & afternoon tea.\n\nListed historic building. Terrace in the heart of a remarkable garden.\n\nSeating for 40.\nPrivatization possible."
    ],
    "it": [
      "Ristorante e sala da tè - Pranzi, spuntini e tè pomeridiani fatti in casa.\n\nEdificio storico classificato. Terrazza nel cuore di un giardino straordinario.\n\n40 posti a sedere.\nPossibilità di noleggio privato."
    ],
    "fr": [
      "Restaurant et salon de thé - Déjeuner, encas & goûter faits maison.\n\nBâtiment historique classé. Terrasse au cœur d'un jardin remarquable.\n\nSalle de 40 places assises.\nPrivatisation possible."
    ],
    "es": [
      "Restaurante y salón de té - Almuerzos caseros, aperitivos y té de la tarde.\n\nEdificio histórico protegido. Terraza en el corazón de un jardín extraordinario.\n\nCapacidad para 40 personas.\nPosibilidad de alquiler privado."
    ],
    "nl": [
      "Restaurant en tearoom - Huisgemaakte lunches, snacks en afternoon tea.\n\nHistorisch gebouw dat op de monumentenlijst staat. Terras in het hart van een opmerkelijke tuin.\n\nPlaats voor 40 personen.\nPrivéverhuur mogelijk."
    ]
  },
