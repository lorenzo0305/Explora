  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/02f90511-eb6d-3f01-826d-554a9e68b454",
      "dc:description": {
        "de": [
          "In der Umgebung von Fruges und Hucqueliers sind die Fachwerkbauten noch sehr präsent. Lehmhäuser zieren die Landschaft des Haut-Pays d'Opale!"
        ],
        "en": [
          "Timber-framed buildings are still very much in evidence around Fruges and Hucqueliers. Cob houses adorn the Haut-Pays d'Opale landscape!"
        ],
        "it": [
          "Gli edifici a struttura in legno sono ancora molto evidenti nei dintorni di Fruges e Hucqueliers. Le case di pannocchie adornano il paesaggio dell'Haut-Pays d'Opale!"
        ],
        "fr": [
          "Les constructions à pans de bois sont encore très présentes autour de Fruges et Hucqueliers. Les maisons en torchis ornent le paysage du Haut-Pays d'Opale !"
        ],
        "nl": [
          "In de omgeving van Fruges en Hucqueliers zijn houtskeletgebouwen nog steeds te vinden. Vakwerkhuizen sieren het landschap van de Haut-Pays d'Opale!"
        ],
        "es": [
          "En los alrededores de Fruges y Hucqueliers, los edificios con entramado de madera siguen estando muy presentes. Las casas de adobe adornan el paisaje del Haut-Pays d'Opale"
        ]
      },
      "@type": [
        "Description"
