  "rdfs:comment": {
    "de": [
      "Der ökologische und künstlerische Landschaftsgarten Le Jardin des Vertueux hat zum Ziel, eine brachliegende Fläche entlang der Hortillonnages in einen öffentlich zugänglichen Landschaftsgarten umzuwandeln, in dem man traditionelle Gemüseanbautechniken kennen lernen kann."
    ],
    "en": [
      "A landscaped, ecological and artistic garden, Le Jardin des Vertueux aims to transform a fallow space along the Hortillonnages into a landscaped garden accessible to the general public where traditional market gardening techniques can be discovered."
    ],
    "it": [
      "Giardino paesaggistico, ecologico e artistico, Le Jardin des Vertueux si propone di trasformare un terreno incolto lungo gli Hortillonnages in un giardino paesaggistico accessibile al pubblico, dove scoprire le tecniche tradizionali dell'orticoltura."
    ],
    "fr": [
      "Jardin paysagiste, écologique et artistique, Le Jardin des Vertueux a pour but de transformer un espace en friche le long des Hortillonnages, en jardin paysager accessible au grand public où l'on découvre les techniques maraîchères traditionnelles."
    ],
    "nl": [
      "Le Jardin des Vertueux, een landschappelijke, ecologische en artistieke tuin, wil een braakliggend terrein langs de Hortillonnages omvormen tot een landschapstuin die toegankelijk is voor het grote publiek en waar traditionele tuiniertechnieken kunnen worden ontdekt."
    ],
    "es": [
      "Jardín paisajístico, ecológico y artístico, Le Jardin des Vertueux pretende transformar un terreno baldío a lo largo de los Hortillonnages en un jardín paisajístico accesible al público en general donde se puedan descubrir las técnicas tradicionales de la horticultura."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Barques des Hortillonnages  -  Le Jardin des Vertueux"
    ]
  },
  "creationDate": "2012-05-15",
