  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2802a278-b486-3f4c-a6c0-236588bc6454",
      "dc:description": {
        "de": [
          "Die Ferme du Bois Joli ist ein Betrieb, der Label-Rouge-Hühner verkauft.\nDieser pädagogische Bauernhof bietet auch Besichtigungen des Bauernhofs und Geburtstagsfeiern zur Freude von Groß und Klein an."
        ],
        "en": [
          "La Ferme du Bois Joli is a farm that sells Label Rouge chickens.\nThis educational farm also offers visits to the farm, birthday snacks for the pleasure of young and old."
        ],
        "it": [
          "La Ferme du Bois Joli è una fattoria che vende polli Label Rouge.\nQuesta fattoria didattica offre anche visite alla fattoria e feste di compleanno per il divertimento di grandi e piccini."
        ],
        "fr": [
          "La Ferme du Bois Joli est une exploitation qui vend des poulets Label Rouge.\nCette ferme pédagogique propose également des visites de la ferme, goûter d'anniversaire pour le plus grand plaisir des petits et grands."
        ],
        "nl": [
          "La Ferme du Bois Joli is een boerderij die Label Rouge kippen verkoopt.\nDeze educatieve boerderij biedt ook bezoeken aan de boerderij en verjaardagsfeestjes voor het plezier van jong en oud."
        ],
        "es": [
          "La Ferme du Bois Joli es una granja que vende pollos Label Rouge.\nEsta granja educativa también ofrece visitas a la granja y fiestas de cumpleaños para el disfrute de grandes y pequeños."
        ]
      },
