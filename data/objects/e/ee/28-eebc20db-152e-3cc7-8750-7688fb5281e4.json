  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3525091f-261e-3126-9c9b-a64130ab4a7e",
      "dc:description": {
        "de": [
          "Le Comptoir du Malt ist eine Brauereigaststätte, die sich auf die volkstümliche und lokale Brauküche mit dem traditionellen Bier als zentralem Thema spezialisiert hat\n\nSignature Dishes: Welsch, Potjevleesch, Carbonnade, Ficelle Picarde"
        ],
        "en": [
          "Le Comptoir du Malt is a brewery restaurant specializing in popular and local brewery cuisine, with traditional beer as its central theme\n\nSignature dishes: welsch, potjevleesch, carbonnade, ficelle picarde"
        ],
        "it": [
          "Le Comptoir du Malt è un ristorante-birreria specializzato in cucina popolare e locale, con la birra tradizionale come tema centrale\n\nPiatti tipici: welsch, potjevleesch, carbonnade, ficelle picarde"
        ],
        "fr": [
          "Le Comptoir du Malt est une enseigne de restauration de brasserie spécialisée dans la cuisine brassicole, populaire et locale, ayant pour thème central la bière de tradition\n\nPlats signature : welsch, potjevleesch, carbonnade, ficelle picarde"
        ],
        "nl": [
          "Le Comptoir du Malt is een brouwerij restaurant gespecialiseerd in populaire en lokale brouwerij gerechten, met traditioneel bier als centraal thema\n\nHoofdgerechten: welsch, potjevleesch, carbonnade, ficelle picarde"
        ],
        "es": [
          "Le Comptoir du Malt es un restaurante cervecero especializado en cocina cervecera popular y local, con la cerveza artesanal como tema central\n\nPlatos estrella: welsch, potjevleesch, carbonnade, ficelle picarde"
        ]
      },
      "@type": [
        "Description"
      ],
