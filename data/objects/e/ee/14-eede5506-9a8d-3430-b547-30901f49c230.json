      "dc:description": {
        "de": [
          "Offen für alle, Rennen ab 13:30 Uhr.\nPreise: Erwachsene: 9 ? und Kinder: 5 ?\nAnmeldung: www.chronopale.fr, am Tag des Rennens unter +33(0)6 83 31 26 26 oder bacoathle@orange.fr\nOrganisiert von Berck Athlétisme Côte d'Opale"
        ],
        "en": [
          "Open to all, races start at 1:30pm.\nPrices : Adults: 9? and Children: 5?\nRegistration: on www.chronopale.fr, on race day, at +33(0)6 83 31 26 26 or bacoathle@orange.fr\nOrganized by Berck Athlétisme Côte d?Opale"
        ],
        "it": [
          "Aperto a tutti, le gare iniziano alle 13.30.\nPrezzi : Adulti: 9 euro e bambini: 5 euro\nIscrizioni: su www.chronopale.fr, il giorno della gara, al +33(0)6 83 31 26 26 o su bacoathle@orange.fr\nOrganizzato da Berck Athlétisme Côte d'Opale"
        ],
        "fr": [
          "Ouvert à tous, courses à partir de 13h 30. \nTarifs : Adultes : 9€ et Enfants : 5€\nInscription : sur www.chronopale.fr, le jour de la course, au +33(0)6 83 31 26 26 ou bacoathle@orange.fr\nOrganisé par Berck Athlétisme Côte d’Opale"
        ],
        "nl": [
          "Open voor iedereen, de wedstrijden beginnen om 13.30 uur.\nPrijzen : Volwassenen: €9 en kinderen: €5\nInschrijven: op www.chronopale.fr, op de dag van de wedstrijd op +33(0)6 83 31 26 26 of bacoathle@orange.fr\nGeorganiseerd door Berck Athlétisme Côte d'Opale"
        ],
        "es": [
          "Abierto a todos, las carreras comienzan a las 13h30.\nPrecios : Adultos: 9 euros y niños: 5 euros\nInscripciones: en www.chronopale.fr, el día de la carrera, en el +33(0)6 83 31 26 26 o en bacoathle@orange.fr\nOrganiza Berck Athlétisme Côte d'Opale"
        ]
      },
