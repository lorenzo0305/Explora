  "rdfs:comment": {
    "de": [
      "Picknickbereich (1 Tisch) auf einer großen Rasenfläche, die vom Bach Wambez gesäumt wird. Bouleplatz und Fußballtor. Wanderweg \"Le Chemin des Ânes\" und Balade d'Histoire & d'histoires in der Nähe. Bänke und Mülleimer. Parkplatz in der Nähe."
    ],
    "en": [
      "Picnic area (1 table) located on a large grassy field, bordered by the Wambez stream. Petanque field and football goal. Hiking trail \"Le Chemin des Ânes\" and \"Balade d'Histoire & d'histoires\" nearby. Benches, dustbin. Parking nearby."
    ],
    "it": [
      "Area picnic (1 tavolo) situata su un ampio prato, costeggiata dal torrente Wambez. Campo da petanque e porta da calcio. Sentiero escursionistico \"Le Chemin des Ânes\" e Balade d'Histoire & d'histoires nelle vicinanze. Panchine, cestino dei rifiuti. Parcheggio nelle vicinanze."
    ],
    "fr": [
      "Aire de pique-nique  (1 table) située sur un grand terrain enherbé, bordé par le ruisseau de Wambez. Terrain de pétanque et cage de but de football. Chemin de randonnée \"Le Chemin des Ânes\" et Balade d'Histoire & d'histoires à proximité. Bancs, poubelle. Parking à proximité."
    ],
    "es": [
      "Área de picnic (1 mesa) situada en un gran campo de hierba, bordeado por el arroyo Wambez. Campo de petanca y portería de fútbol. Ruta de senderismo \"Le Chemin des Ânes\" y Balade d'Histoire & d'histoires en las cercanías. Bancos, cubos de basura. Aparcamiento en las inmediaciones."
    ],
    "nl": [
      "Picknickplaats (1 tafel) gelegen op een groot grasveld, begrensd door de beek Wambez. Petanqueveld en voetbaldoel. Wandelpad \"Le Chemin des Ânes\" en Balade d'Histoire & d'histoires in de buurt. Banken, vuilnisbak. Parkeren in de buurt."
    ]
  },
