  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d77053ff-dff7-38ac-9e8e-e8609082137a",
      "dc:description": {
        "de": [
          "- Eine köstliche Küche mit hausgemachten Gerichten wird Ihnen jeden Mittag angeboten\n- Eine große Auswahl an Bieren und kreativen Cocktails\n- Eine einladende und familiäre Atmosphäre"
        ],
        "en": [
          "- Delicious cuisine with homemade dishes every lunchtime\n- A wide selection of beers and creative cocktails\n- A friendly, family atmosphere"
        ],
        "it": [
          "- Ogni giorno a pranzo verranno serviti deliziosi piatti fatti in casa\n- Un'ampia selezione di birre e cocktail creativi\n- Un'atmosfera amichevole e familiare"
        ],
        "fr": [
          "- Une cuisine délicieuse avec des plats entièrement faits maison vous serons proposés chaque midi\n- Une large sélection de bières et de cocktails créatifs \n- Une ambiance accueillante et familiale"
        ],
        "es": [
          "- Todos los días se servirá deliciosa comida casera para el almuerzo\n- Una amplia selección de cervezas y cócteles creativos\n- Un ambiente familiar y acogedor"
        ],
        "nl": [
          "- Elke dag wordt er heerlijk huisgemaakt eten geserveerd voor de lunch\n- Een brede selectie bieren en creatieve cocktails\n- Een vriendelijke, familiale sfeer"
        ]
      },
