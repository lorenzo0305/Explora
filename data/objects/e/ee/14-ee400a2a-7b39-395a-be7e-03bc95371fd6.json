      "dc:description": {
        "de": [
          "Sonntag, 6. April, 17 Uhr: Konzert mit Amaury Vassili, Tenor, und dem Vokalensemble Manque pas d'Air in der Kirche Notre Dame des sables\nVoller Tarif: 35 ? / Ermäßigter Tarif: 33 ?\nInformationen und Reservierungen: beim Vokalensemble: +33 (0)6.85.52.28.12 oder tstar.mandala@gmail.com\nTickets auf Fnac und Ticket Master / Günstigere Tickets auf samuelducros.com"
        ],
        "en": [
          "Sunday April 6 at 5pm: concert with tenor Amaury Vassili and the vocal ensemble Manque pas d'Air in the church of Notre Dame des sables\nFull price: 35? / Reduced price: 33?\nInformation and reservations: with the Ensemble Vocal: +33 (0)6.85.52.28.12 or tstar.mandala@gmail.com\nBuy tickets on Fnac and Ticket Master / Cheaper tickets on samuelducros.com"
        ],
        "it": [
          "Domenica 6 aprile alle 17.00: concerto con il tenore Amaury Vassili e l'ensemble vocale Manque pas d'Air nella chiesa di Notre Dame des sables\nPrezzo intero: 35 euro / Prezzo ridotto: 33 euro\nInformazioni e prenotazioni: presso l'Ensemble Vocal: +33 (0)6.85.52.28.12 o tstar.mandala@gmail.com\nAcquistare i biglietti su Fnac e Ticket Master / Biglietti più economici su samuelducros.com"
        ],
        "fr": [
          "Dimanche 6 avril à 17h : concert avec Amaury Vassili, ténor et l'ensemble vocal Manque pas d'Air en l'église Notre Dame des sables\nPlein tarif : 35€ / Tarif réduit 33€\nRenseignement et réservations : auprès de l'Ensemble Vocal : +33 (0)6.85.52.28.12 ou tstar.mandala@gmail.com\nAchat des billes sur Fnac et Ticket Master / Billets moins chers sur samuelducros.com"
        ],
        "nl": [
          "Zondag 6 april om 17u: concert met tenor Amaury Vassili en het vocaal ensemble Manque pas d'Air in de kerk Notre Dame des sables\nVolle prijs: €35 / Gereduceerde prijs: €33\nInformatie en reserveringen: bij het Ensemble Vocal: +33 (0)6.85.52.28.12 of tstar.mandala@gmail.com\nKoop tickets bij Fnac en Ticket Master / Goedkopere tickets op samuelducros.com"
        ],
        "es": [
          "Domingo 6 de abril a las 17:00 h: concierto con el tenor Amaury Vassili y el conjunto vocal Manque pas d'Air en la iglesia de Notre Dame des sables\nTarifa completa: 35 euros / Tarifa reducida: 33 euros\nInformación y reservas: en el Ensemble Vocal: +33 (0)6.85.52.28.12 o tstar.mandala@gmail.com\nComprar entradas en Fnac y Ticket Master / Entradas más baratas en samuelducros.com"
        ]
