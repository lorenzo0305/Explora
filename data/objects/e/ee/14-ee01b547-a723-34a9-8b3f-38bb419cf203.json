  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5c809ba7-0778-31c2-b04a-bbb438f362e1",
      "dc:description": {
        "de": [
          "Restaurant, das sich auf Meeresfrüchte spezialisiert hat.\nÖffnungszeiten\nDienstag bis Sonntag von 11:00 bis 14:00 Uhr und von 17:00 bis 22:00 Uhr geöffnet\nTel.: 07 49 06 76 76.\nGourmetgerichte am Mittwoch, akustisches Konzert am Donnerstag und baskische Tapas am Freitagabend."
        ],
        "en": [
          "Restaurant specializing in seafood.\nSchedule\nOpen Tuesday through Sunday, 11 a.m. to 2 p.m. then 5 p.m. to 10 p.m\nTel : 07 49 06 76 76.\nGastronomic dishes on Wednesdays, acoustic concert on Thursdays and Basque tapas on Friday evenings."
        ],
        "it": [
          "Ristorante specializzato in frutti di mare.\nOrari di apertura\nAperto da martedì a domenica, dalle 11.00 alle 14.00 e dalle 17.00 alle 22.00\nTel: 07 49 06 76 76.\nPiatti gastronomici il mercoledì, concerto acustico il giovedì e tapas basche il venerdì sera."
        ],
        "fr": [
          "Restaurant spécialisé dans les produits de la mer.\nHoraire : \nOuvert du mardi au dimanche, de 11 h à 14 h puis de 17 h à 22 h. \nTél. : 07 49 06 76 76.\nPlats gastronomiques le mercredi, concert acoustique le jeudi et tapas basques le vendredi soir."
        ],
        "es": [
          "Restaurante especializado en marisco.\nHorario de apertura\nAbierto de martes a domingo, de 11 a 14 horas y luego de 17 a 22 horas\nTel: 07 49 06 76 76.\nPlatos gastronómicos los miércoles, concierto acústico los jueves y tapas vascas los viernes por la noche."
        ],
        "nl": [
          "Restaurant gespecialiseerd in zeevruchten.\nOpeningstijden\nGeopend van dinsdag tot zondag van 11 tot 14 uur en van 17 tot 22 uur\nTel: 07 49 06 76 76.\nGastronomische gerechten op woensdag, akoestisch concert op donderdag en Baskische tapas op vrijdagavond."
        ]
      },
