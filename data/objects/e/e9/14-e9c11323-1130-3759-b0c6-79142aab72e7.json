  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92f8db55-bbd9-3075-bc5b-a0b8992a182f",
      "dc:description": {
        "de": [
          "Einführung in den Reitsport, Ablegen von Prüfungen, Praktika...<br>Dressur, Voltigieren, Cross, Ponyspiele, Horse Ball<br><br>Das Centre de l'écusson besteht aus einem Reitlehrer, einem Ausbilder sowie BPJEPS-Ausbildern<br><br>"
        ],
        "en": [
          "Introduction to horse riding, exams, training courses...<br>Dressage, acrobatics, cross-country, pony games, horse ball<br><br>The Ecusson center is staffed by an instructor, a monitor and BPJEPS trainers<br><br>"
        ],
        "it": [
          "Introduzione all'equitazione, esami, corsi...<br>Dressage, acrobatica, cross-country, pony games, horse ball<br><br>Il centro Ecusson dispone di un istruttore, di un monitore e di istruttori BPJEPS<br><br>"
        ],
        "fr": [
          "Initiation à l'équitation, passage d'examen, stage...<br>Dressage, voltige, cross, pony games, horse ball<br><br>Le centre de l'écusson est composé d'un instructeur, un moniteur ainsi que de formateurs BPJEPS<br><br>"
        ],
        "nl": [
          "Kennismaking met paardrijden, examens, cursussen...<br>Dressuur, acrobatiek, cross-country, ponyspelen, paardenbal<br><br>De manege in Ecusson heeft een instructeur, een monitor en BPJEPS-trainers<br><br>"
        ],
        "es": [
          "Iniciación a la equitación, exámenes, cursos...<br>Disciplinas de doma, acrobacia, campo a través, juegos con ponis, horse ball<br><br>El centro Ecusson cuenta con un instructor, un monitor y entrenadores BPJEPS<br><br>"
        ]
      },
