  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5257e76a-bce1-3898-b4ff-25f253048b86",
      "dc:description": {
        "de": [
          "Sonntag, den 15. März 2026\n--------------------------------------------------------------\nTreffen von alten Sportwagen und Youngtimern, außergewöhnlichen Motorrädern, Mopeds und Militärfahrzeugen.\nOrganisiert von der Vereinigung \"Les Anciennes en Côte d'Opale\"\nVon 14 bis 17.30 Uhr auf dem Front de Mer von Stella-Plage\nKostenlos und für alle zugänglich\nKONTAKT : 06 27 48 58 34\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Sunday, March 15, 2026\n--------------------------------------------------------------\nGathering of old sports cars and youngtimers, exceptional motorcycles, mopeds and military vehicles.\nOrganized by the association \"Les Anciennes en Côte d'Opale\"\n2pm to 5:30pm on the Stella-Plage seafront\nFree and open to all\nCONTACT : 06 27 48 58 34\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Domenica 15 marzo 2026\n--------------------------------------------------------------\nRaduno di auto sportive e youngtimer d'epoca, moto eccezionali, ciclomotori e veicoli militari.\nOrganizzato dall'associazione \"Les Anciennes en Côte d'Opale\"\nDalle 14.00 alle 17.30 sul lungomare di Stella-Plage\nGratuito e aperto a tutti\nCONTATTO: 06 27 48 58 34\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Dimanche 15 Mars 2026 \n--------------------------------------------------------------\nRassemblement d'ancienne voitures et Youngtimers Sportives, d'Exception moto, mobylettes, et véhicules militaires.\nOrganisée par l'association \"Les Anciennes en Côte d'Opale\"\nDe 14h à 17h30 sur le Front de Mer de Stella-Plage\nGratuit et ouvert à tous\nCONTACT : 06 27 48 58 34\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Zondag 15 maart 2026\n--------------------------------------------------------------\nSamenkomst van oude sportwagens en youngtimers, bijzondere motoren, bromfietsen en militaire voertuigen.\nGeorganiseerd door de vereniging \"Les Anciennes en Côte d'Opale\"\nVan 14.00 tot 17.30 uur op de boulevard van Stella-Plage\nGratis en open voor iedereen\nCONTACT: 06 27 48 58 34\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Domingo 15 de marzo de 2026\n--------------------------------------------------------------\nConcentración de coches deportivos antiguos y youngtimers, motos excepcionales, ciclomotores y vehículos militares.\nOrganizado por la asociación \"Les Anciennes en Côte d'Opale\"\nDe 14:00 a 17:30 en el paseo marítimo de Stella-Plage\nGratuito y abierto a todos\nCONTACTO: 06 27 48 58 34\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
