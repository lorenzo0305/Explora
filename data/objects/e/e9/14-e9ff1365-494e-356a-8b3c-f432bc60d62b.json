  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92599205-8176-3279-9eed-4d52c7b5cd0f",
      "dc:description": {
        "de": [
          "Im Rahmen der Nationalen Woche der Kleinkindbetreuung bietet das Team des MPE in Étaples-sur-mer Eltern und Kindern verschiedene spielerische Workshops für Kinder von 0 bis 3 Jahren an.\nEintritt frei."
        ],
        "en": [
          "As part of the Semaine Nationale de la Petite Enfance, the Étaples-sur-mer MPE team is offering parents and children a range of fun workshops for 0-3 year-olds.\nFree admission."
        ],
        "it": [
          "Nell'ambito della Semaine Nationale de la Petite Enfance, l'équipe dell'MPE di Étaples-sur-mer propone a genitori e bambini una serie di divertenti laboratori per bambini da 0 a 3 anni.\nIngresso libero."
        ],
        "fr": [
          "Dans le cadre de la Semaine Nationale de la Petite Enfance, l’équipe de la MPE d’Étaples-sur-mer propose aux parents et aux enfants divers ateliers ludiques dédiés aux 0 à 3 ans.\nEntrée libre."
        ],
        "nl": [
          "In het kader van de Semaine Nationale de la Petite Enfance biedt het MPE-team van Étaples-sur-mer ouders en kinderen een reeks leuke workshops voor kinderen van 0-3 jaar.\nGratis toegang."
        ],
        "es": [
          "En el marco de la Semana Nacional de la Pequeña Infancia, el equipo del PPE de Étaples-sur-mer propone a padres e hijos una serie de talleres lúdicos para niños de 0 a 3 años.\nEntrada gratuita."
        ]
      },
