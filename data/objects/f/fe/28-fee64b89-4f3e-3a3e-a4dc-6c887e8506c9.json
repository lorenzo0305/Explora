  "rdfs:comment": {
    "de": [
      "Der Staatswald von Bon-Secours (oder Bonsecours), häufiger \"Wald von Bonsecours\" genannt, befindet sich in Condé-sur-l'Escaut und gehört zu den bewaldeten Massiven in Hochfrankreich, innerhalb des regionalen Naturparks Scarpe-Escaut (Frankreich) ."
    ],
    "en": [
      "The state-owned forest of Bon-Secours (or Bonsecours), more often referred to as the \"Bonsecours forest\", is located in Condé-sur-l'Escaut and is part of the woodlands of the Hautes de France region, within the Scarpe-Escaut Regional Nature Park (France)."
    ],
    "it": [
      "La foresta statale di Bon-Secours (o Bonsecours), più comunemente nota come \"foresta di Bonsecours\", si trova a Condé-sur-l'Escaut ed è una delle aree boschive dell'Haut de France, all'interno del Parco Naturale Regionale Scarpe-Escaut (Francia)."
    ],
    "fr": [
      "La forêt domaniale de Bon-Secours (ou Bonsecours), plus souvent dénommée « forêt de Bonsecours » est située à Condé-sur-l'Escaut et fait partie des massifs boisés des hauts de France, au sein du Parc naturel régional de Scarpe-Escaut (France) ."
    ],
    "nl": [
      "Het staatsbos van Bon-Secours (of Bonsecours), beter bekend als het \"bos van Bonsecours\", ligt in Condé-sur-l'Escaut en is een van de bosgebieden van Haut de France, binnen het regionale natuurpark Scarpe-Escaut (Frankrijk)."
    ],
    "es": [
      "El bosque estatal de Bon-Secours (o Bonsecours), más conocido como \"bosque de Bonsecours\", está situado en Condé-sur-l'Escaut y es una de las zonas boscosas de Haut de France, dentro del Parque Natural Regional de Scarpe-Escaut (Francia)."
    ]
  },
