  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f83cc5c4-41e3-3414-b3e0-e591610d483d",
      "dc:description": {
        "de": [
          "La table du beffroi café brasserie traditionnelle bietet Ihnen eine traditionelle und hausgemachte Küche.\nGenießen Sie unsere schöne Terrasse gegenüber dem Jardin éphémère und am Fuße des Belfrieds von Boulogne-sur-Mer."
        ],
        "en": [
          "La table du beffroi café brasserie offers you a traditional and home-made cuisine.\nCome and enjoy our beautiful terrace facing the ephemeral garden and at the foot of the belfry of Boulogne-sur-Mer."
        ],
        "it": [
          "La table du beffroi café brasserie offre una cucina tradizionale e casalinga.\nVenite a godervi la nostra bella terrazza affacciata sul giardino effimero e ai piedi del campanile di Boulogne-sur-Mer."
        ],
        "fr": [
          "La table du beffroi café brasserie traditionnelle vous propose une cuisine traditionnelle et faite maison.\nVenez profiter de notre belle terrasse face au jardin éphémère et au pied du beffroi de Boulogne-sur-Mer."
        ],
        "es": [
          "La table du beffroi café brasserie ofrece una cocina tradicional y casera.\nVenga a disfrutar de nuestra hermosa terraza frente al jardín efímero y al pie del campanario de Boulogne-sur-Mer."
        ],
        "nl": [
          "La table du beffroi café brasserie biedt een traditionele en huisgemaakte keuken.\nKom genieten van ons mooie terras met uitzicht op de tuin en aan de voet van het belfort van Boulogne-sur-Mer."
        ]
      },
      "@type": [
        "Description"
      ],
