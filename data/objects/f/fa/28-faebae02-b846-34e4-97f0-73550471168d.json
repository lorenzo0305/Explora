  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4205f213-73ed-3490-806b-35bf4d7cdfb1",
      "dc:description": {
        "de": [
          "\"L'Etape\" heißen Sie auf dem Gelände des Circuit des Écuyers herzlich willkommen. Genießen Sie Gerichte, die von uns aus frischen Qualitätsprodukten zubereitet werden."
        ],
        "en": [
          "\"L'Etape\" welcomes you to the Circuit des Écuyers. Enjoy dishes prepared by us with fresh quality produce."
        ],
        "it": [
          "\"L'Etape\" vi dà il benvenuto sul Circuit des Écuyers. Gustate i piatti preparati da noi con prodotti freschi e di qualità."
        ],
        "fr": [
          "\"L'Etape\" vous accueillent dans l'enceinte du Circuit des Écuyers. Savourez des plats préparés par nos soins avec des produits frais de qualités."
        ],
        "es": [
          "\"L'Etape\" le da la bienvenida al Circuit des Écuyers. Disfrute de platos preparados por nosotros con productos frescos de calidad."
        ],
        "nl": [
          "\"L'Etape\" heet je welkom op het Circuit des Écuyers. Geniet van door ons bereide gerechten met verse kwaliteitsproducten."
        ]
      },
