      "dc:description": {
        "de": [
          "Sonntag, 21. Juli 2024\n\nVon 10 Uhr bis 12 Uhr\n\n3. Pokal der Kinder.\nIn den Gärten des Kongresszentrums.\nOrganisation: Touquet automobiles de collection."
        ],
        "en": [
          "Sunday, July 21, 2024\n\n10am to 12pm\n\n3rd children's cup.\nIn the gardens of the Palais des Congrès.\nOrganized by Touquet automobiles de collection."
        ],
        "it": [
          "Domenica 21 luglio 2024\n\nDalle 10.00 alle 12.00\n\n3a Coppa dei bambini.\nNei giardini del Palazzo dei Congressi.\nOrganizzata da Touquet automobiles de collection."
        ],
        "fr": [
          "Dimanche 21 juillet 2024\n\nDe 10h à 12h\n\n3ème coupe des enfants.\nDans les jardins du palais des congrès.\nOrganisation : Touquet automobiles de collection."
        ],
        "nl": [
          "Zondag 21 juli 2024\n\n10.00 tot 12.00 uur\n\n3de beker voor kinderen.\nIn de tuinen van het Palais des Congrès.\nGeorganiseerd door Touquet automobiles de collection."
        ],
        "es": [
          "Domingo 21 de julio de 2024\n\nDe 10.00 a 12.00 horas\n\n3ª Copa de los Niños.\nEn los jardines del Palacio de Congresos.\nOrganizado por Touquet automobiles de collection."
        ]
      },
