  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5cb1dd42-9fd0-33c4-ba74-a948ca86005f",
      "dc:description": {
        "de": [
          "Die geführten Touren\nDie Ursprünge der Olympischen Spiele - Boulogne-sur-Mer \"Terre de jeux 2024\" (Land der Spiele 2024)\nWettkämpfe und Körperkult im antiken Griechenland? Eine Tour zu den Ursprüngen der Olympischen Spiele.\n? Sonntag, den 1. September um 15:00 Uhr\nKostenlos (1. Sonntag im Monat) ? Reservierung empfohlen"
        ],
        "en": [
          "Guided tours\nThe origins of the Olympic Games - Boulogne-sur-Mer \"Land of Games 2024\nCompetitions and the cult of the body in ancient Greece? A visit to the origins of the Olympic Games.\n? Sunday, September 1 at 3:00 pm\nFree (1st Sunday of the month) ? Reservation recommended"
        ],
        "it": [
          "Visite guidate\nLe origini dei Giochi Olimpici - Boulogne-sur-Mer \"Terra dei Giochi 2024\nCompetizioni e culto del corpo nell'Antica Grecia? Una visita alle origini dei Giochi Olimpici.\n? Domenica 1 settembre alle 15.00\nGratuito (1a domenica del mese) ? Prenotazione consigliata"
        ],
        "fr": [
          "Les visites guidées\nAux origines des Jeux Olympiques - Boulogne-sur-Mer « Terre de jeux 2024 »\nCompétitions et culte du corps dans la Grèce antique… Une visite à l’origine des jeux olympiques. \n→ Dimanche 1er septembre à 15h00\nGratuit (1er dimanche du mois) – Réservation conseillée"
        ],
        "es": [
          "Visitas guiadas\nLos orígenes de los Juegos Olímpicos - Boulogne-sur-Mer \"Tierra de Juegos 2024\nCompeticiones y culto al cuerpo en la Antigua Grecia.. Una visita a los orígenes de los Juegos Olímpicos.\n? Domingo 1 de septiembre a las 15.00 h\nGratuito (1er domingo del mes) ? Se recomienda reservar"
        ],
        "nl": [
          "Rondleidingen\nDe oorsprong van de Olympische Spelen - Boulogne-sur-Mer \"Land van de Spelen 2024\nWedstrijden en de cultus van het lichaam in het oude Griekenland? Een bezoek aan de oorsprong van de Olympische Spelen.\n? Zondag 1 september om 15.00 uur\nGratis (1e zondag van de maand) ? Reserveren aanbevolen"
        ]
      },
