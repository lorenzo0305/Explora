  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/483aa48d-e98b-328c-b33f-3cdd1db4609a",
      "dc:description": {
        "de": [
          "Was ist die Mômes'box? Ein Kit mit einer Zeitung und vielen Aktivitäten zum Thema Kulturerbe, die Sie zu Hause nachmachen können. Nach einem Besuch, einem Workshop oder einfach einem Spaziergang durch 9-9bis können Sie Ihr Kit mit nach Hause nehmen, um die Entdeckung des Bergbauerbes fortzusetzen."
        ],
        "en": [
          "What is the mômes'box? A kit with a newspaper and lots of heritage activities to do at home. After a visit, a workshop or simply a walk in 9-9bis, leave with your kit to continue the discovery of the mining heritage."
        ],
        "it": [
          "Che cos'è il mômes?box? Un kit con un giornale e tante attività sul patrimonio da fare a casa. Dopo una visita, un laboratorio o semplicemente una passeggiata nei dintorni di 9-9bis, portate a casa il kit per continuare a scoprire il patrimonio minerario."
        ],
        "fr": [
          "La mômes’box, c’est quoi…? Un kit avec un journal et plein d’activités patrimoine à réaliser à la maison. Après une visite, un atelier ou tout simplement une balade au 9-9bis, repartez avec votre kit pour poursuivre la découverte du patrimoine minier."
        ],
        "es": [
          "¿Qué es la mômes?box? Un kit con un periódico y un montón de actividades sobre el patrimonio para hacer en casa. Después de una visita, un taller o simplemente un paseo por 9-9bis, llévate el kit a casa para seguir descubriendo el patrimonio minero."
        ],
        "nl": [
          "Wat is de mômes?box? Een kit met een krant en tal van erfgoedactiviteiten om thuis te doen. Na een bezoek, een workshop of gewoon een wandeling rond 9-9bis, neem je je kit mee naar huis om het mijnerfgoed verder te ontdekken."
        ]
      },
