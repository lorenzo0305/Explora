  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8d29f606-3e6c-3cd4-ab8d-ff1f8a158593",
      "dc:description": {
        "de": [
          "Maël Isaac ist ein Zauberer, Hexer, Guru und Schamane, der mit Björkschen Zaubersprüchen, Kate Bushs Zaubertränken, FKA Twigs' Destillierkolben und Tori Amos' Salben hantiert. Seit September 2020 singt er die zyklonalen Lieder seiner SWIRL Part 1&2, das Album wird 2023 erscheinen! Lassen Sie sich von Maël Isaac verzaubern und hypnotisieren mit den Beschwörungen seines wirbelnden Electro-Pop."
        ],
        "en": [
          "Maël Isaac, magician, sorcerer, guru, shaman, wielding Björkian spells, Kate Bush potions, FKA Twigs stills and Tori Amos ointments, the artist has been churning out the cyclonic songs of his SWIRL Part 1&2 since September 2020, with the album due in 2023! Let Maël Isaac bewitch and hypnotize you with the incantations of his swirling electro-pop."
        ],
        "it": [
          "Maël Isaac, mago, stregone, guru, sciamano, brandendo incantesimi björkiani, pozioni di Kate Bush, alambicchi di FKA Twigs e unguenti di Tori Amos, l'artista sforna le canzoni cicloniche del suo SWIRL Part 1&2 da settembre 2020, con l'album previsto per il 2023! Lasciatevi ipnotizzare da Maël Isaac con gli incantesimi del suo vorticoso electro-pop."
        ],
        "fr": [
          "Maël Isaac magicien, sorcier, gourou, chaman, maniant les sorts björkiens, les potions à la Kate Bush, les alambics de FKA Twigs, les onguents de Tori Amos, l’artiste égraine depuis septembre 2020 les chansons cycloniques de ses SWIRL Part 1&2, l’album sera pour 2023! Laissez Maël Isaac vous envouter, vous hypnotiser avec les incantations de son électro-pop tourbillante."
        ],
        "nl": [
          "Maël Isaac, tovenaar, magiër, goeroe, sjamaan, hanteert Björkiaanse spreuken, Kate Bush toverdrankjes, FKA Twigs stills en Tori Amos zalfjes, de artiest is al sinds september 2020 bezig met het produceren van de cyclonische nummers van zijn SWIRL Part 1&2, waarvan het album in 2023 verschijnt! Laat Maël Isaac je betoveren en hypnotiseren met de bezweringen van zijn wervelende elektropop."
        ],
        "es": [
          "Maël Isaac, mago, hechicero, gurú, chamán, con hechizos björkianos, pócimas de Kate Bush, alambiques de FKA Twigs y ungüentos de Tori Amos, el artista ha estado produciendo las canciones ciclónicas de su SWIRL Part 1&2 desde septiembre de 2020, ¡con el álbum previsto para 2023! Deja que Maël Isaac te hipnotice con los encantamientos de su electropop arremolinado."
        ]
      },
