  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/93182733-7397-3a8c-b036-f68afd0ee36e",
      "dc:description": {
        "de": [
          "Das Restaurant Origin befindet sich im Herzen des Hotels Holiday Inn Calais - Coquelles und bietet Ihnen eine schmackhafte und abwechslungsreiche Küche, bei der lokale Produkte im Vordergrund stehen. Genießen Sie traditionelle Gerichte, die in einer gemütlichen Atmosphäre neu interpretiert werden."
        ],
        "en": [
          "Located in the heart of the Holiday Inn Calais - Coquelles hotel, the Origin restaurant offers tasty, varied cuisine featuring local produce. Enjoy traditional dishes revisited in a friendly atmosphere."
        ],
        "it": [
          "Situato nel cuore dell'hotel Holiday Inn Calais - Coquelles, il ristorante Origin offre una cucina gustosa e varia, con prodotti locali. Gustate i piatti tradizionali in un'atmosfera amichevole."
        ],
        "fr": [
          "Situé au cœur de l'hôtel Holiday Inn Calais - Coquelles, le restaurant Origin vous propose une cuisine savoureuse et variée, mettant à l'honneur les produits locaux. Dégustez des plats traditionnels revisités dans une ambiance conviviale."
        ],
        "es": [
          "Situado en el corazón del hotel Holiday Inn Calais - Coquelles, el restaurante Origin ofrece una cocina sabrosa y variada, con productos locales. Disfrute de platos tradicionales en un ambiente acogedor."
        ],
        "nl": [
          "Het restaurant Origin ligt in het hart van het Holiday Inn Calais - Coquelles hotel en biedt smakelijke en gevarieerde gerechten met lokale producten. Geniet van traditionele gerechten in een vriendelijke sfeer."
        ]
      },
