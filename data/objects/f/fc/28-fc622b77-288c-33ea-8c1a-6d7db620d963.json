  "rdfs:comment": {
    "de": [
      "Bau aus dem 19. Jahrhundert mit vorwiegend neoklassizistischen Elementen. Sie weist eine reiche und vielfältige Ausstattung auf, darunter auch Elemente aus der alten Kirche."
    ],
    "en": [
      "19th century construction with neoclassical dominance. It has a rich and varied furnishings including elements of the old church."
    ],
    "it": [
      "La chiesa è stata costruita nel XIX secolo ed è prevalentemente neoclassica. Presenta una ricca e variegata collezione di arredi, tra cui elementi provenienti dall'antica chiesa."
    ],
    "fr": [
      "Construction du XIXe siècle à dominante néoclassique. Elle présente un mobilier riche et varié dont des éléments de l'ancienne église."
    ],
    "es": [
      "La iglesia fue construida en el siglo XIX y es predominantemente neoclásica. Cuenta con una rica y variada colección de mobiliario, que incluye elementos de la antigua iglesia."
    ],
    "nl": [
      "De kerk werd gebouwd in de 19e eeuw en is overwegend neoklassiek. Het heeft een rijke en gevarieerde collectie meubels, waaronder elementen uit de oude kerk."
    ]
  },
