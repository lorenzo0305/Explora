      "dc:description": {
        "de": [
          "An einer Tradition zum Jahresende teilhaben\nim Centre SocioCulturel ?Audrey BARTIER? einen Guenel herstellen\nKostenlos mit obligatorischer Reservierung an der Rezeption\n\nAuskunft: 03 21 33 29 53"
        ],
        "en": [
          "Participate in a festive holiday tradition\nat the Centre SocioCulturel ?Audrey BARTIER? make your own guenels\nFree of charge, booking essential at reception\n\nInformation : 03 21 33 29 53"
        ],
        "it": [
          "Partecipate a una tradizione festiva\npresso il Centro socioculturale Audrey BARTIER, preparate i vostri guenelli\nGratuito su prenotazione alla reception\n\nInformazioni: 03 21 33 29 53"
        ],
        "fr": [
          "Participer à une tradition des fêtes se fin d'année \nau Centre SocioCulturel “Audrey BARTIER” confectionner votre guenels \nGratuit avec réservation obligatoire auprès de l’accueil\n\nRens. : 03 21 33 29 53"
        ],
        "es": [
          "Participe en una tradición festiva\nen el Centre SocioCulturel ?Audrey BARTIER? elabore sus propios guenels\nGratis previa reserva en recepción\n\nInformación: 03 21 33 29 53"
        ],
        "nl": [
          "Neem deel aan een feestelijke traditie\nin het Centre SocioCulturel ?Audrey BARTIER? maak je eigen guenels\nGratis na reservering bij de receptie\n\nInlichtingen: 03 21 33 29 53"
        ]
      },
