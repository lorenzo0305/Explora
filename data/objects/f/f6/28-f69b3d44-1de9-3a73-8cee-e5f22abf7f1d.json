  "rdfs:comment": {
    "de": [
      "Mitten im Stadtzentrum öffnet Ihnen der Corsaire seine Türen mit seinen schmackhaften Crêpes aus Buchweizen und seiner Spezialität, dem Ker'burger, einem neu interpretierten Burger nach bretonischer Art!"
    ],
    "en": [
      "Right in the center of town, Le Corsaire opens its doors to you with its tasty buckwheat crepes and its specialty, the ker'burger, a Breton-style burger!"
    ],
    "it": [
      "In pieno centro, Le Corsaire vi apre le porte con le sue gustose crêpes di grano saraceno e la sua specialità, il ker'burger, un hamburger in stile bretone!"
    ],
    "fr": [
      "En plein centre ville, le Corsaire vous ouvre ses portes avec ses savoureuses crêpes au blé noir et sa spécialité le ker'burger, un burger revisité à la mode bretonne !"
    ],
    "nl": [
      "Midden in het centrum van de stad opent Le Corsaire zijn deuren voor je met zijn smakelijke boekweit crêpes en zijn specialiteit, de ker'burger, een hamburger in Bretonse stijl!"
    ],
    "es": [
      "En pleno centro de la ciudad, Le Corsaire le abre sus puertas con sus sabrosas crêpes de trigo sarraceno y su especialidad, la ker'burger, ¡una hamburguesa al estilo bretón!"
    ]
  },
