      "@id": "https://data.datatourisme.fr/553de9a5-fa55-33ff-994e-8168b8b1db1d",
      "dc:description": {
        "de": [
          "Kinderanimation im Fun House. Für Kinder von 03 bis 14 Jahren werden verschiedene Aktivitäten angeboten. Fun crea Fun Kid'Chen Fun Anim oder auch Fun Party.\nInfos und Tickets unter www.fun-house-hardelot.fr"
        ],
        "en": [
          "Children's entertainment at the Fun House. Various activities are available for children aged 03 to 14. Fun crea Fun Kid'Chen Fun Anim or Fun Party.\nInfo and tickets at www.fun-house-hardelot.fr"
        ],
        "it": [
          "Animazione per bambini presso la Fun House. Sono disponibili diverse attività per i bambini dai 03 ai 14 anni. Fun crea Fun Kid's Fun Anim e Fun Party.\nInformazioni e biglietti su www.fun-house-hardelot.fr"
        ],
        "fr": [
          "Animations enfants à la Fun House. Diverses activités sont proposées aux enfants de 03 à 14 ans. Fun créa Fun Kid'Chen Fun Anim ou encore Fun Party. \nInfos et Billetterie sur www.fun-house-hardelot.fr"
        ],
        "nl": [
          "Kinderanimatie in het Fun House. Er zijn verschillende activiteiten voor kinderen van 03 tot 14 jaar. Fun crea Fun Kid's Fun Anim en Fun Party.\nInformatie en tickets op www.fun-house-hardelot.fr"
        ],
        "es": [
          "Entretenimiento infantil en la Fun House. Se ofrecen diversas actividades para niños de 03 a 14 años. Fun crea Fun Kid's Fun Anim y Fun Party.\nInformación y entradas en www.fun-house-hardelot.fr"
        ]
      },
