  "rdfs:comment": {
    "de": [
      "Japanisches Restaurant mit Sushi, Maki, Yakitori...im Stadtzentrum von Noyon.\nLieferung bis zur Haustür möglich (-10% auf die Endabrechnung).\n\n7 Tage die Woche geöffnet, außer Sonntagmittag: von 11:30 bis 14:15 Uhr und von 18:00 bis 22:15 Uhr unter der Woche, 22:30 Uhr am Wochenende."
    ],
    "en": [
      "Japanese restaurant offering sushi, maki, yakitori...in Noyon town center.\nHome delivery possible (-10% on final bill).\n\nOPEN 7 days a week, except Sunday lunchtime: 11.30am to 2.15pm and 6pm to 10.15pm weekdays, 10.30pm weekends."
    ],
    "it": [
      "Ristorante giapponese che offre sushi, maki, yakitori... nel centro di Noyon.\nPossibilità di consegna a domicilio (-10% sul conto finale).\n\nAPERTO 7 giorni su 7, tranne la domenica a pranzo: dalle 11.30 alle 14.15 e dalle 18.00 alle 22.15 nei giorni feriali, alle 22.30 nel fine settimana."
    ],
    "fr": [
      "Restaurant japonais vous proposant des sushi, maki, yakitori...en centre ville de Noyon. \nLivraison possible à domicile (-10% sur la note finale).\n\nOUVERT 7J/7, sauf dimanche midi : de 11h30 à 14h15 et de 18h à 22h15 en semaine, 22h30 le week-end."
    ],
    "es": [
      "Restaurante japonés de sushi, maki, yakitori... en el centro de Noyon.\nPosibilidad de entrega a domicilio (-10% en la factura final).\n\nABIERTO los 7 días de la semana, excepto los domingos al mediodía: de 11.30 a 14.15 y de 18.00 a 22.15 los días laborables, 22.30 los fines de semana."
    ],
    "nl": [
      "Japans restaurant met sushi, maki, yakitori... in het centrum van Noyon.\nThuisbezorging mogelijk (-10% op de eindrekening).\n\nOPEN 7 dagen per week, behalve zondagmiddag: van 11.30 tot 14.15 uur en van 18.00 tot 22.15 uur op weekdagen, 22.30 uur in het weekend."
    ]
  },
