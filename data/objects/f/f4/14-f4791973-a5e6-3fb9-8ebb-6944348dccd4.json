  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cd293df9-f924-3eeb-949a-3740c23ef455",
      "dc:description": {
        "de": [
          "Für die Weihnachtsfeierlichkeiten sind zahlreiche Aktivitäten vorgesehen, darunter Hütten, der Weihnachtsmann und eine pyrotechnische Show."
        ],
        "en": [
          "Many activities are planned for the Christmas festivities, including chalets, Santa Claus and a fireworks display."
        ],
        "it": [
          "Per le festività natalizie sono previste numerose attività, tra cui chalet, Babbo Natale e uno spettacolo pirotecnico."
        ],
        "fr": [
          "Ne nombreuses activités sont prévues pour les festivités de Noël notamment des chalets, la présence du père Noël ou encore un spectacle pyrotechnique."
        ],
        "es": [
          "Se han programado numerosas actividades para las fiestas navideñas, como chalets, Papá Noel y un espectáculo de fuegos artificiales."
        ],
        "nl": [
          "Er zijn tal van activiteiten gepland voor de kerstfestiviteiten, waaronder chalets, de kerstman en een vuurwerkshow."
        ]
      },
