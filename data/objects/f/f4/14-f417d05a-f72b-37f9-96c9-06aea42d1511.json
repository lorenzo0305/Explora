  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f881ad24-4a80-3f05-8b52-e9a8bdfe4dd1",
      "dc:description": {
        "de": [
          "Das im Herzen von Desvres gelegene Restaurant La Parenthèse lädt Sie zu einer Gourmetpause in einem warmen und raffinierten Rahmen ein. Sie werden hier eine kreative Küche entdecken, die frische und saisonale Produkte hervorhebt, die durch das Können des Küchenchefs verfeinert werden."
        ],
        "en": [
          "Located in the heart of Desvres, the restaurant La Parenthèse invites you to take a gourmet break in a warm and refined setting. Here you'll discover creative cuisine featuring fresh, seasonal produce, enhanced by the chef's savoir-faire."
        ],
        "it": [
          "Situato nel cuore di Desvres, il ristorante La Parenthèse vi invita a fare una pausa gourmet in un ambiente caldo e raffinato. Qui scoprirete una cucina creativa a base di prodotti freschi di stagione, esaltati dall'esperienza dello chef."
        ],
        "fr": [
          "Situé au cœur de Desvres, le restaurant La Parenthèse vous invite à faire une pause gourmande dans un cadre chaleureux et raffiné. Vous y découvrirez une cuisine créative qui met en valeur des produits frais et de saison, sublimés par le savoir-faire du chef."
        ],
        "es": [
          "Situado en el corazón de Desvres, el restaurante La Parenthèse le invita a una pausa gastronómica en un ambiente cálido y refinado. Aquí descubrirá una cocina creativa con productos frescos de temporada, realzada por la maestría del chef."
        ],
        "nl": [
          "Restaurant La Parenthèse ligt in het hart van Desvres en nodigt je uit voor een gastronomische pauze in een warme en verfijnde omgeving. Hier ontdek je een creatieve keuken met verse seizoensproducten, verrijkt met de expertise van de chef."
        ]
      },
      "@type": [
        "Description"
