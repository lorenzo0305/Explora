      "dc:description": {
        "de": [
          "Zigeuner-Konzert\nSonntag, den 7. Dezember um 16 Uhr\nPlace Gambetta - Montreuil\n--------------------------\nAngeboten von der Association La Vie Culturelle en Montreuillois\nKonzert des 'Swing-Klezmer Orchestra' aus Paris - Geige: David Amsellem\n\nPreis: 12 ? - Reservierungen: 06 22 85 48 63 oder 06 20 06 22 30\nKartenverkauf vor Ort möglich\n\nKredit: Vie Cuturelle en Montreuillois"
        ],
        "en": [
          "Tzigane Concert\nSunday, December 7 at 4 p.m\nPlace Gambetta - Montreuil\n--------------------------\nProposed by the Association La Vie Culturelle en Montreuillois\nConcert by 'Swing-Klezmer Orchestra' from Paris - Violin : David Amsellem\n\nPrice 12? - Reservations: 06 22 85 48 63 or 06 20 06 22 30\nTickets available on site\n\nCredit: Vie Cuturelle en Montreuillois"
        ],
        "it": [
          "Concerto gitano\nDomenica 7 dicembre alle 16.00\nPiazza Gambetta - Montreuil\n--------------------------\nProposto dall'Associazione La Vie Culturelle en Montreuillois\nConcerto della \"Swing-Klezmer Orchestra\" di Parigi - Violino : David Amsellem\n\nPrezzo: 12? - Prenotazioni: 06 22 85 48 63 o 06 20 06 22 30\nBiglietti disponibili sul posto\n\nCredito: Vie Cuturelle en Montreuillois"
        ],
        "fr": [
          "Concert Tzigane\nDimanche 7 décembre à 16h\nPlace Gambetta - Montreuil\n--------------------------\nProposé par l’Association La Vie Culturelle en Montreuillois\nConcert proposé par 'Swing-Klezmer Orchestra' de Paris - Violon : David Amsellem\n\nTarif 12€ - Réservations : 06 22 85 48 63 ou bien 06 20 06 22 30\nBilletterie sur place possible\n\nCrédit : Vie Cuturelle en Montreuillois"
        ],
        "nl": [
          "Zigeunerconcert\nZondag 7 december om 16.00 uur\nPlace Gambetta - Montreuil\n--------------------------\nVoorgesteld door de vereniging La Vie Culturelle en Montreuillois\nConcert door het 'Swing-Klezmer Orkest' uit Parijs - Viool : David Amsellem\n\nPrijs: 12? - Reserveren: 06 22 85 48 63 of 06 20 06 22 30\nTickets ter plaatse verkrijgbaar\n\nKrediet: Vie Cuturelle en Montreuillois"
        ],
        "es": [
          "Concierto gitano\nDomingo 7 de diciembre a las 16:00 h\nPlaza Gambetta - Montreuil\n--------------------------\nPropuesto por la Asociación La Vie Culturelle en Montreuillois\nConcierto de la \"Swing-Klezmer Orchestra\" de París - Violín : David Amsellem\n\nPrecio: 12? - Reservas: 06 22 85 48 63 o 06 20 06 22 30\nEntradas disponibles in situ\n\nCrédito: Vie Cuturelle en Montreuillois"
        ]
      },
