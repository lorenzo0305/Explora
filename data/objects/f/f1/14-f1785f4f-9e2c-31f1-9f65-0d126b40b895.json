  "rdfs:comment": {
    "de": [
      "Lassen Sie sich von einer zauberhaften Auszeit im Herzen von Le Touquet-Paris-Plage verzaubern.\nAls grüne Oase zwischen Land und Meer laden diese außergewöhnlichen Orte zur Entspannung und zum Staunen ein und bieten zu jeder Jahreszeit ein neues Schauspiel."
    ],
    "en": [
      "Let yourself be charmed by an enchanted interlude in the heart of Le Touquet-Paris-Plage.\nA veritable oasis of greenery between land and sea, these exceptional sites invite you to relax and marvel, offering a spectacle renewed every season."
    ],
    "it": [
      "Lasciatevi affascinare da una parentesi incantata nel cuore di Le Touquet-Paris-Plage.\nVera e propria oasi di verde tra terra e mare, questi siti eccezionali invitano a rilassarsi e a stupirsi, offrendo uno spettacolo nuovo a ogni stagione."
    ],
    "fr": [
      "Laissez-vous charmer par une parenthèse enchantée au cœur du Touquet-Paris-Plage.\nVéritable oasis de verdure entre terre et mer, ces sites exceptionnels invite à la détente et à l'émerveillement, offrant un spectacle renouvelé à chaque saison."
    ],
    "nl": [
      "Laat je betoveren door een betoverend intermezzo in het hart van Le Touquet-Paris-Plage.\nDeze uitzonderlijke plekken, een ware oase van groen tussen land en zee, nodigen uit tot ontspanning en verwondering en bieden elk seizoen een nieuw spektakel."
    ],
    "es": [
      "Déjese hechizar por un interludio encantado en el corazón de Le Touquet-Paris-Plage.\nVerdaderos oasis de verdor entre la tierra y el mar, estos parajes excepcionales invitan a relajarse y maravillarse, ofreciendo un espectáculo nuevo cada temporada."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Les jardins de la Manche au Touquet"
    ]
  },
