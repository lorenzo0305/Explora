  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: die Lage in einer grünen Oase neben dem Sumpfgebiet \"Trois Vaches\", die aufmerksame und herzliche Servicequalität."
    ],
    "en": [
      "You'll love the location in a green setting next to the Trois Vaches marsh, and the warm, attentive service."
    ],
    "it": [
      "Vi piacerà la sua posizione nel verde, accanto alla palude di Trois Vaches, e il servizio cordiale e attento."
    ],
    "fr": [
      "Vous aimerez : sa situation dans un écrin de verdure à côté du marais des Trois Vaches, la qualité de service attentionnée et chaleureuse."
    ],
    "nl": [
      "U zult dol zijn op de locatie in een groene omgeving naast het moeras van Trois Vaches en de warme, attente bediening."
    ],
    "es": [
      "Le encantará su ubicación en un entorno verde junto al pantano de Trois Vaches, y el servicio cálido y atento."
    ]
