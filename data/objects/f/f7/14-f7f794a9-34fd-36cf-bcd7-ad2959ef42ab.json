  "rdfs:comment": {
    "de": [
      "In Zusammenarbeit mit dem Etoile d'Oignies Athlétisme, einem symbolträchtigen Verein aus der Zeit des Bergbaus, und Eden62 bieten wir Ihnen einen Spaziergang zum Kulturerbe und Sport an, der an der Ausstellung Second Souffle\" beginnt."
    ],
    "en": [
      "In partnership with Etoile d?Oignies Athlétisme, an emblematic club from the mining era, and Eden62, we offer a heritage and sports walk, starting from the Second Souffle exhibition."
    ],
    "it": [
      "In collaborazione con l'Etoile d'Oignies Athlétisme, club simbolo dell'epoca mineraria, e con Eden62, proponiamo una passeggiata all'insegna del patrimonio e dello sport, partendo dalla mostra Second Souffle."
    ],
    "fr": [
      "En partenariat avec l’Etoile d’Oignies Athlétisme, club emblématique à l’époque minière, et Eden62, nous vous proposons une balade patrimoniale et sportive, au départ de l’exposition Second Souffle."
    ],
    "nl": [
      "In samenwerking met Etoile d'Oignies Athlétisme, een iconische club uit het mijntijdperk, en Eden62 bieden we een erfgoed- en sportwandeling aan die begint bij de tentoonstelling Second Souffle."
    ],
    "es": [
      "En colaboración con Etoile d'Oignies Athlétisme, club emblemático de la época minera, y Eden62, proponemos un paseo patrimonial y deportivo que comienza en la exposición Second Souffle."
    ]
  },
