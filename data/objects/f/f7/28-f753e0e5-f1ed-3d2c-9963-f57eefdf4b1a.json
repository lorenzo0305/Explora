  "rdfs:comment": {
    "de": [
      "Das Restaurant mit familiärer Atmosphäre auf dem Teller und im Speisesaal soll vor allem für alle zugänglich sein. Sie werden von den schmackhaft zubereiteten traditionellen und lokalen Gerichten begeistert sein."
    ],
    "en": [
      "The restaurant has a family atmosphere in the plate and in the room and is accessible to all. You will be delighted by these traditional and local dishes, deliciously cooked."
    ],
    "it": [
      "Il ristorante ha un'atmosfera familiare sia in sala che in cucina ed è accessibile a tutti. Sarete deliziati dai piatti tradizionali e locali, preparati in modo delizioso."
    ],
    "fr": [
      "Le restaurant à l'ambiance familiale dans l’assiette et en salle se veut surtout accessible à tous. Vous serez emballés par ces plats traditionnels et locaux savoureusement cuisinés."
    ],
    "nl": [
      "Het restaurant heeft een familiaire sfeer in de eetzaal en in de keuken en is toegankelijk voor iedereen. U zult verrukt zijn van de traditionele en lokale gerechten, die heerlijk worden bereid."
    ],
    "es": [
      "El restaurante, de ambiente familiar tanto en el comedor como en la cocina, es accesible a todos. Le encantarán los platos tradicionales y locales, deliciosamente preparados."
    ]
  },
