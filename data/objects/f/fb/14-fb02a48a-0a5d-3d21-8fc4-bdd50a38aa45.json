  "rdfs:comment": {
    "de": [
      "Eine Veranstaltung, die für alle offen ist. Verpassen Sie nicht diese Gelegenheit, einen magischen Moment mit Ihren Kindern zu teilen! Kommen Sie zahlreich, um gemeinsam Halloween zu feiern."
    ],
    "en": [
      "An event open to all, don't miss this opportunity to share a magical moment with your children! Come one, come all to celebrate Halloween together."
    ],
    "it": [
      "Questo evento è aperto a tutti, quindi non perdete l'occasione di condividere un momento magico con i vostri bambini! Venite tutti a festeggiare Halloween insieme."
    ],
    "fr": [
      "Un événement ouvert à tous, ne manquez pas cette opportunité de partager un moment magique avec vos enfants ! Venez nombreux pour fêter Halloween ensemble."
    ],
    "es": [
      "Este evento está abierto a todos, ¡así que no pierda la oportunidad de compartir un momento mágico con sus hijos! Venid todos a celebrar Halloween juntos."
    ],
    "nl": [
      "Dit evenement is toegankelijk voor iedereen, dus mis de kans niet om een magisch moment met je kinderen te delen! Kom allen om samen Halloween te vieren."
    ]
  },
  "rdfs:label": {
