  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/af3dbe4b-4fc6-3f1d-bd6c-9f25b6cb0636",
      "dc:description": {
        "de": [
          "Im Winter überdachtes Becken, im Sommer offenes Becken, 0,95 bis 2,15 m tief, sanft abfallend. 25 m lang. 10 m breit. Die Temperatur des Wassers und der Umgebungsluft wird zwischen 28 und 30° gehalten. Solarium und Sauna nach Absprache. Wassergymnastik. Schwimmunterricht."
        ],
        "en": [
          "Basin covered in winter, open in summer, 0.95 to 2.15 m deep on a gentle slope. 25 m long. 10 m wide. The water and air temperature is maintained between 28 and 30°. Solarium and sauna by appointment. Aquagym. Swimming lessons."
        ],
        "it": [
          "Piscina coperta in inverno, aperta in estate, profonda da 0,95 a 2,15 m con una leggera pendenza. Lunghezza 25 m. 10 m di larghezza. La temperatura dell'acqua e dell'aria viene mantenuta tra i 28 e i 30°. Solarium e sauna su prenotazione. Aquagym. Lezioni di nuoto."
        ],
        "fr": [
          "Bassin couvert l’hiver, ouvert l’été, 0,95 à 2,15 m de profondeur en pente douce. 25 m de longueur. 10 m de largeur. La température de l’eau et de l’air ambiant est maintenue entre 28 et 30°. Solarium et sauna sur rendez-vous. Aquagym. Leçons de natation."
        ],
        "es": [
          "Piscina cubierta en invierno, abierta en verano, de 0,95 a 2,15 m de profundidad con una suave pendiente. 25 m de longitud. 10 m de ancho. La temperatura del agua y del aire se mantiene entre 28 y 30°. Solarium y sauna con cita previa. Aquagym. Clases de natación."
        ],
        "nl": [
          "Overdekt zwembad in de winter, open in de zomer, 0,95 tot 2,15 m diep met een zachte helling. 25 m lang. 10 m breed. De temperatuur van het water en de lucht wordt tussen 28 en 30° gehouden. Solarium en sauna op afspraak. Aquagym. Zwemlessen."
        ]
      },
