  "rdfs:comment": {
    "de": [
      "Kommen Sie und kaufen Sie Ihre Rohmilch direkt auf dem Bauernhof Paul. Es besteht die Möglichkeit, am Abend beim Melken der Kühe zuzusehen!"
    ],
    "en": [
      "Come and buy your raw milk directly from Paul's farm. Possibility to attend the milking of the cows in the evening!"
    ],
    "it": [
      "Venite a comprare il vostro latte crudo direttamente dalla fattoria di Paul. La sera potrete assistere alla mungitura delle mucche!"
    ],
    "fr": [
      "Venez acheter votre lait cru directement à la ferme Paul. Possibilité d'assister à la traite des vaches le soir !"
    ],
    "es": [
      "Venga a comprar leche cruda directamente a la granja de Paul. ¡Podrás ver cómo se ordeñan las vacas por la noche!"
    ],
    "nl": [
      "Kom en koop je rauwe melk rechtstreeks van Paul's boerderij. U kunt 's avonds zien hoe de koeien worden gemolken!"
    ]
  },
