  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab2e04a0-1d5c-3cf8-9ccd-c3852bbab946",
      "dc:description": {
        "de": [
          "Abenteuerparcours in den Bäumen.3-Aktivitäten-Angebote für Gruppen.Ein Baby-Parcours (bis 5 Jahre).Ein Kinder-Parcours (5 bis 10 Jahre).Ein Erwachsenen-Parcours (über 10 Jahre).Ein optionaler Seilrutschen-Parcours.Dauer der Aktivität: ca. 2,5 Stunden für Kinder über 10 Jahre und 1 Stunde für Kinder von 5 bis 10 Jahren."
        ],
        "en": [
          "Adventure trail in the trees. 3 activity packages for groups. a baby trail (up to 5 years old). a children's trail (from 5 to 10 years old). an adult trail (over 10 years old). a Tyrolean trail in option. Duration of the activity: about 2h30 for the over 10 years old and 1 hour for the 5/10 years old."
        ],
        "it": [
          "Corso di avventura tra gli alberi.3 pacchetti di attività per gruppi.un corso baby (fino a 5 anni).un corso per bambini (da 5 a 10 anni).un corso per adulti (oltre 10 anni).un corso di traversata tirolese facoltativo.Durata dell'attività: circa 2,5 ore per chi ha più di 10 anni e 1 ora per chi ha 5/10 anni."
        ],
        "fr": [
          "Parcours aventure dans les arbres.Des formules à 3 activités pour les groupes.Un parcours baby (jusque 5 ans).Un parcours enfant (de 5 à 10 ans).Un parcours adulte (+ de 10 ans).Un parcours Tyroliennes en option.Durée de l'activité: environ 2h30 pour les + de 10 ans et 1h pour les 5/10 ans."
        ],
        "es": [
          "Curso de aventura en los árboles.3 paquetes de actividades para grupos.Un curso para bebés (hasta 5 años).Un curso para niños (de 5 a 10 años).Un curso para adultos (más de 10 años).Un curso opcional de tirolina.Duración de la actividad: aproximadamente 2,5 horas para los mayores de 10 años y 1 hora para los de 5/10 años."
        ],
        "nl": [
          "Avonturenparcours in de bomen.3 activiteitenpakketten voor groepen.een babyparcours (tot 5 jaar).een kinderparcours (van 5 tot 10 jaar).een volwassenenparcours (ouder dan 10 jaar).een optioneel Tiroler traverseparcours.duur van de activiteit: ongeveer 2,5 uur voor wie ouder is dan 10 jaar en 1 uur voor wie ouder is dan 5/10 jaar."
        ]
      },
