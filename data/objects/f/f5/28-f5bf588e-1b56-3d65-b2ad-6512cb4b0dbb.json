  "rdfs:comment": {
    "de": [
      "Erkunden Sie mit einem Führer die Kulissen des Stade du Hainaut: Tribünen, VIP-Logen, Presseraum und Umkleidekabinen des VAFC enthüllen ihre Geheimnisse!"
    ],
    "en": [
      "Take a behind-the-scenes tour of the Stade du Hainaut with a guide: the stands, VIP boxes, press room and VAFC changing rooms reveal their secrets!"
    ],
    "it": [
      "Scoprite il dietro le quinte dello Stade du Hainaut con una guida: le tribune, i palchi VIP, la sala stampa e gli spogliatoi del VAFC vi sveleranno i loro segreti!"
    ],
    "fr": [
      "Explorez les coulisses du Stade du Hainaut avec un guide : tribunes, loges VIP, salle de presse et vestiaires du VAFC vous dévoilent leurs secrets !"
    ],
    "nl": [
      "Neem met een gids een kijkje achter de schermen van het Stade du Hainaut: de tribunes, VIP-boxen, perszaal en kleedkamers van VAFC geven allemaal hun geheimen prijs!"
    ],
    "es": [
      "Descubra los entresijos del Stade du Hainaut con un guía: las tribunas, los palcos VIP, la sala de prensa y los vestuarios del VAFC le revelarán sus secretos"
    ]
  },
  "rdfs:label": {
