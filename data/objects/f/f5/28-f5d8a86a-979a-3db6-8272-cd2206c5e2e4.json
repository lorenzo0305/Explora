  "rdfs:comment": {
    "de": [
      "Beginnen Sie Ihren Tag sportlich mit Jonathan oder Emma bei einem dynamischen Spaziergang in der Natur!\nRdv Plage Anima'pôle - Bringen Sie Wanderschuhe und eine Flasche Wasser mit.\nStrecke von ca. 5 km"
    ],
    "en": [
      "Get your day off to a sporty start with Jonathan or Emma on a dynamic nature walk!\nRdv Plage Anima'pôle - Bring walking shoes and a bottle of water.\nApprox. 5km route"
    ],
    "it": [
      "Iniziate la giornata all'insegna dello sport con Jonathan o Emma in una passeggiata dinamica nella natura!\nPunto di ritrovo Anima'pôle Beach - Portare scarpe da trekking e una bottiglia d'acqua.\nCirca 5 km"
    ],
    "fr": [
      "Débutez votre journée sportivement avec Jonathan ou Emma lors d'une marche dynamique en pleine nature !\nRdv Plage Anima'pôle - Prévoir des chaussures de marche et une bouteille d'eau.\nParcours d'environ 5km"
    ],
    "es": [
      "Empiece el día de forma deportiva con Jonathan o Emma en un dinámico paseo por la naturaleza\nPunto de encuentro Playa de Anima'pôle - Llevar calzado para caminar y una botella de agua.\nAproximadamente 5 km"
    ],
    "nl": [
      "Begin je dag sportief met Jonathan of Emma tijdens een dynamische natuurwandeling!\nVerzamelpunt Anima'pôle Beach - Neem wandelschoenen en een fles water mee.\nOngeveer 5 km"
    ]
  },
  "rdfs:label": {
