  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/becbee32-60b5-32ec-9ae7-ddebd47e7d88",
      "dc:description": {
        "de": [
          "Lassen Sie sich vom Best Western Hôtel Hermitage verführen, das Sie bei Ihren romantischen Ausflügen oder Geschäftsreisen in die Region Pas-de-Calais in eine schicke und gemütliche Welt eintauchen lässt.\nDie Hotelbar ist der ideale Ort, um sich am Ende des Tages zu entspannen."
        ],
        "en": [
          "Let yourself be seduced by the Best Western Hôtel Hermitage, which will plunge you into a chic and cosy universe for your romantic getaways or business stays in the Pas-de-Calais.\nThe hotel bar is the ideal place to relax at the end of the day."
        ],
        "it": [
          "Lasciatevi sedurre dal Best Western Hôtel Hermitage, che vi immergerà in un mondo chic e accogliente per le vostre fughe romantiche o i vostri viaggi d'affari nel Pas-de-Calais.\nIl bar dell'hotel è il luogo ideale per rilassarsi a fine giornata."
        ],
        "fr": [
          "Laissez-vous séduire par le Best Western Hôtel Hermitage qui vous plongera dans un univers chic et cosy lors de vos escapades romantiques, vos séjours d’affaires dans le Pas-de-Calais.\nLe bar de l’hôtel sera le lieu idéal pour vous détendre en fin de journée."
        ],
        "nl": [
          "Laat u verleiden door het Best Western Hôtel Hermitage, dat u onderdompelt in een chique en gezellige wereld voor uw romantische uitjes of zakenreizen in Pas-de-Calais.\nDe bar van het hotel is de ideale plek om aan het eind van de dag te ontspannen."
        ],
        "es": [
          "Déjese seducir por el Best Western Hôtel Hermitage, que le sumergirá en un mundo chic y acogedor para sus escapadas románticas o viajes de negocios en el Pas-de-Calais.\nEl bar del hotel es el lugar ideal para relajarse al final del día."
        ]
      },
      "@type": [
        "Description"
      ],
