      "dc:description": {
        "de": [
          "Das Fremdenverkehrsamt Coeur d'Ostrevent bietet den Verleih einer Fahrradflotte an, mit der Sie die Routen in der Nähe erkunden können: die Fahrradroute Galibot..."
        ],
        "en": [
          "The Coeur d'Ostrevent tourist office offers a fleet of bicycles for hire to discover nearby itineraries: the Galibot cycle route..."
        ],
        "it": [
          "L'ufficio turistico di Coeur d'Ostrevent mette a disposizione una flotta di biciclette a noleggio per scoprire i percorsi vicini: la pista ciclabile del Galibot..."
        ],
        "fr": [
          "L'office de tourisme Coeur d'Ostrevent propose la location d'une flotte de vélos pour découvrir les itinéraires à proximité : la véloroute du Galibot..."
        ],
        "es": [
          "La oficina de turismo de Coeur d'Ostrevent pone a su disposición una flota de bicicletas de alquiler para que pueda descubrir las rutas cercanas: la ruta ciclista Galibot..."
        ],
        "nl": [
          "Bij het toeristenbureau van Coeur d'Ostrevent kun je fietsen huren om de nabijgelegen routes te ontdekken: de Galibot-fietsroute..."
        ]
      },
