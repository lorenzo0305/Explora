  "rdfs:comment": {
    "de": [
      "In einem baumbestandenen Park in der Nähe von Chimay an der belgischen Grenze lädt dieses Gourmetrestaurant den Gaumen mit Spezialitäten aus Frankreich und Belgien auf eine Reise ein."
    ],
    "en": [
      "In a wooded park, near Chimay, on the Belgian border, this gastronomic restaurant is a real invitation to travel for the palate through specialties from France and Belgium."
    ],
    "it": [
      "In un parco alberato, vicino a Chimay, al confine con il Belgio, questo ristorante gastronomico è un vero e proprio invito al viaggio per il palato attraverso le specialità francesi e belghe."
    ],
    "fr": [
      "Dans un parc arboré, près de Chimay, à la frontière belge, ce restaurant gastronomique est une véritable invitation au voyage pour le palais à travers des spécialités de France et de Belgique."
    ],
    "nl": [
      "In een bosrijk park, vlakbij Chimay, aan de Belgische grens, is dit gastronomisch restaurant een echte uitnodiging tot een reis voor de smaakpapillen langs specialiteiten uit Frankrijk en België."
    ],
    "es": [
      "En un parque arbolado, cerca de Chimay, en la frontera belga, este restaurante gastronómico es una verdadera invitación a viajar para el paladar a través de especialidades de Francia y Bélgica."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Restaurant Le Château de la Motte"
    ]
  },
