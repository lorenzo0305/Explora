      "rdfs:comment": {
        "de": [
          "Stéphanie und Julien Remiot bieten Freilandhühner Label Rouge, Milchprodukte und Rindfleisch zum Verkauf an.\nSie können eine Fernbestellung aufgeben und Ihre Bestellung abholen, wann immer Sie möchten."
        ],
        "en": [
          "Stéphanie and Julien Remiot offer Label Rouge free-range chickens, dairy products and beef for sale.\nYou can order from a distance and collect your order whenever you like."
        ],
        "it": [
          "Stéphanie e Julien Remiot vendono polli ruspanti, prodotti lattiero-caseari e carne bovina di Label Rouge.\nÈ possibile effettuare l'ordine a distanza e ritirarlo quando si vuole."
        ],
        "fr": [
          "Stéphanie et Julien Remiot proposent des poulets fermiers Label Rouge, des produits laitiers et de la viande bovine à la vente.\nVous pouvez passer commande à distance et venir récupérer votre commande quand vous le souhaitez."
        ],
        "es": [
          "Stéphanie y Julien Remiot venden pollos de corral, productos lácteos y carne de vacuno Label Rouge.\nPuedes hacer tu pedido a distancia y recogerlo cuando quieras."
        ],
        "nl": [
          "Stéphanie en Julien Remiot verkopen Label Rouge scharrelkippen, zuivelproducten en rundvlees.\nJe kunt je bestelling op afstand plaatsen en ophalen wanneer je maar wilt."
        ]
      },
