  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/50adbff9-a5c4-3293-885b-599edbe84d59",
      "dc:description": {
        "de": [
          "Strandbar, Drinks, Food, Cocktails, Wein, Bier vom Fass, Salate, Sandwiches, Brettchen zum Teilen, Meeresfrüchte.\nLiegestuhl mit Meerblick und Musik mit den Füßen im Sand."
        ],
        "en": [
          "Beach bar, drinks, food, cocktails, wine, draught beer, salads, sandwiches, sharing planks, seafood.\nTransat with sea view and music with your feet in the sand."
        ],
        "it": [
          "Bar sulla spiaggia, bevande, cibo, cocktail, vino, birra alla spina, insalate, panini, tavole da condividere, frutti di mare.\nSdraio con vista sul mare e musica con i piedi nella sabbia."
        ],
        "fr": [
          "Bar de plage, drink, food, cocktail, vin, bière pression, salade, sandwichs, planches à partager, fruit de mer.\nTransat avec vue mer et musique les pieds dans le sable."
        ],
        "nl": [
          "Strandbar, drankjes, eten, cocktails, wijn, bier van het vat, salades, sandwiches, planken om te delen, zeevruchten.\nLigstoel met uitzicht op zee en muziek met je voeten in het zand."
        ],
        "es": [
          "Chiringuito, bebidas, comida, cócteles, vino, cerveza de barril, ensaladas, bocadillos, tablas para compartir, marisco.\nTumbona con vistas al mar y música con los pies en la arena."
        ]
      },
