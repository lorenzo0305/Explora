  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6237d3c3-ee04-36d5-827b-155a012beab2",
      "dc:description": {
        "de": [
          "Bar-Brasserie direkt hinter dem Rathaus von Amiens. Eine große Auswahl an Salaten, Pizzen, Flammkuchen, warmen Gerichten und natürlich Feinschmeckerkaffee erwarten Sie jeden Mittag und Abend."
        ],
        "en": [
          "Bar-brewery located just behind Amiens City Hall. A large choice of salads, pizzas, flammekueches, hot dishes, and of course gourmet coffee await you every lunch and evening."
        ],
        "it": [
          "Bar-brasserie situato dietro il Municipio di Amiens. A pranzo e a sera vi attende un'ampia scelta di insalate, pizze, fiammiferi, piatti caldi e, naturalmente, caffè gourmet."
        ],
        "fr": [
          "Bar-brasserie située juste derrière la Mairie d'Amiens. Un grand choix de salades, pizzas, flammekueches, plats chauds, et bien sûr café gourmand vous attendent chaque midi et soir."
        ],
        "es": [
          "Bar-brasserie situado justo detrás del Ayuntamiento de Amiens. Una amplia selección de ensaladas, pizzas, flammekueches, platos calientes y, por supuesto, café gourmet le esperan cada mediodía y cada noche."
        ],
        "nl": [
          "Bar-brasserie gelegen net achter het stadhuis van Amiens. Een ruime keuze aan salades, pizza's, flammekueches, warme gerechten en natuurlijk gastronomische koffie wachten u elke middag en avond op."
        ]
      },
