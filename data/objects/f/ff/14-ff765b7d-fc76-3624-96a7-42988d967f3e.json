  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/755a6abe-05ca-38ed-ab4a-7cd1629af6de",
      "dc:description": {
        "de": [
          "Theater \"Le Bonheur en camping-car\" von der Compagnie Sylvie and Coqs am Freitag, den 2. Juni um 20:30 Uhr im Festsaal des Instituts Albert Calmette in Camiers.\nPreis 5 Euro für Personen über 12 Jahre.\nReservierung und Kartenverkauf im Rathaus von Camiers."
        ],
        "en": [
          "Theater \"Le Bonheur en camping-car\" by Compagnie Sylvie and Coqs, Friday June 2 at 8:30pm at the Salle des fêtes of the Institut Albert Calmette in Camiers.\nPrice 5 euros for children over 12.\nBookings and tickets at Camiers town hall."
        ],
        "it": [
          "Teatro \"Le Bonheur en camping-car\" della Compagnie Sylvie e Coqs, venerdì 2 giugno alle 20.30 nella Salle des Fêtes dell'Institut Albert Calmette di Camiers.\nPrezzo 5 euro per i maggiori di 12 anni.\nPrenotazioni e biglietti presso il municipio di Camiers."
        ],
        "fr": [
          "Théatre \"Le Bonheur en camping-car\" par la Compagnie Sylvie and Coqs, le vendredi 2 juin à 20h30 à la salle des fêtes de l'institut Albert Calmette à Camiers.\nTarif 5 euros pour les plus de 12 ans.\nRéservation et billetterie en mairie de Camiers."
        ],
        "nl": [
          "Theater \"Le Bonheur en camping-car\" door Compagnie Sylvie en Coqs, vrijdag 2 juni om 20.30 uur in de Salle des Fêtes van het Institut Albert Calmette in Camiers.\nPrijs €5 voor kinderen ouder dan 12 jaar.\nReserveringen en kaartjes bij het gemeentehuis van Camiers."
        ],
        "es": [
          "Teatro \"Le Bonheur en camping-car\" de la Compagnie Sylvie y Coqs, viernes 2 de junio a las 20.30 h en la Salle des Fêtes del Institut Albert Calmette de Camiers.\nPrecio: 5 euros para mayores de 12 años.\nReservas y entradas en el ayuntamiento de Camiers."
        ]
      },
