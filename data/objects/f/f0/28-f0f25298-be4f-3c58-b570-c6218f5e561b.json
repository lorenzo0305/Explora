  "rdfs:comment": {
    "de": [
      "Was Ihnen gefallen wird: Die Speisekarte, die Spezialitäten aus der Picardie mit kreativen Rezepten verbindet, die Sie mit Blick auf die Kathedrale Notre-Dame genießen können."
    ],
    "en": [
      "You'll love the menu, which combines Picardy specialities with creative recipes to be enjoyed while gazing at Notre-Dame Cathedral."
    ],
    "it": [
      "Vi piacerà il menu, che combina le specialità della Piccardia con ricette creative da gustare ammirando la cattedrale di Notre-Dame."
    ],
    "fr": [
      "Vous aimerez : la carte qui réunit spécialités picardes et recettes créatives à déguster en contemplant le cathédrale Notre-Dame."
    ],
    "es": [
      "Le encantará el menú, que combina especialidades de Picardía con recetas creativas para degustar contemplando la catedral de Notre-Dame."
    ],
    "nl": [
      "Je zult dol zijn op het menu, dat Picardische specialiteiten combineert met creatieve recepten om van te genieten terwijl je naar de kathedraal Notre-Dame staart."
