  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/31fa595d-98f2-336f-b674-48eb170feef5",
      "dc:description": {
        "de": [
          "Das Restaurant Le Quai befindet sich im Herzen des historischen Viertels von Amiens und ist ein Muss für alle, die Gaumenfreuden mit Dekor und Atmosphäre verbinden möchten. Das Le Quai lädt Sie ein, in einem gemütlichen und raffinierten Ambiente kulinarische Köstlichkeiten zu genießen und dabei einen besonderen Moment zu erleben."
        ],
        "en": [
          "Le Quai restaurant, located in the heart of Amiens' historic district, is a must for all those who wish to combine the pleasures of the palate with those of decor and atmosphere. In a stylish, cosy and refined setting, Le Quai invites you to come and savor delicate and inventive culinary combinations for a privileged moment."
        ],
        "it": [
          "Il ristorante Le Quai, situato nel cuore del quartiere storico di Amiens, è una tappa obbligata per tutti coloro che desiderano unire i piaceri del palato a quelli dell'arredamento e dell'atmosfera. In un ambiente elegante, accogliente e raffinato, Le Quai vi invita a venire a gustare combinazioni culinarie delicate e inventive per un momento speciale."
        ],
        "fr": [
          "Le Quai restaurant situé au cœur du quartier historique d'Amiens, adresse incontournable pour tous ceux qui souhaitent associer au plaisir du palais, celui du décors et de l'ambiance. Dans un cadre design, cosy, et raffiné, Le Quai vous invite à venir savourer des combinaisons culinaires délicates et inventive pour un moment privilégié."
        ],
        "nl": [
          "Restaurant Le Quai ligt in het hart van de historische wijk van Amiens en is een must voor iedereen die de geneugten van het gehemelte wil combineren met die van decor en sfeer. In een stijlvol, gezellig en verfijnd kader nodigt Le Quai je uit om te komen genieten van delicate en inventieve culinaire combinaties voor een speciaal moment."
        ],
        "es": [
          "El restaurante Le Quai, situado en el corazón del barrio histórico de Amiens, es una visita obligada para todos aquellos que deseen combinar los placeres del paladar con los de la decoración y el ambiente. En un marco elegante, acogedor y refinado, Le Quai le invita a venir a saborear delicadas e inventivas combinaciones culinarias para un momento especial."
        ]
      },
      "@type": [
        "Description"
      ],
