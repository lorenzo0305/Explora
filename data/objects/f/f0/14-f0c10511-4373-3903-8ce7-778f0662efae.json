  "rdfs:comment": {
    "de": [
      "Die Band Sar?b - arabisch für \"Fata Morgana\" - entstand aus der Begegnung zwischen der französisch-syrischen Sängerin Climène Zarkan und dem Gitarristen Baptiste Ferrandis. Sie vermischt meisterhaft Rock, modernen Jazz und arabische Klänge."
    ],
    "en": [
      "The brainchild of French-Syrian singer Climène Zarkan and guitarist Baptiste Ferrandis, Sar?b - meaning \"mirage\" in Arabic - is a masterful blend of rock, modern jazz and Arab sounds."
    ],
    "it": [
      "Nato da un'idea della cantante franco-siriana Climène Zarkan e del chitarrista Baptiste Ferrandis, Sar?b - che significa \"miraggio\" in arabo - è una miscela magistrale di rock, jazz moderno e sonorità arabe."
    ],
    "fr": [
      "Né de la rencontre entre la chanteuse franco-syrienne Climène Zarkan et le guitariste Baptiste Ferrandis, le groupe Sarāb - signifiant « mirage » en arabe - mêle avec maestria rock, jazz moderne et sonorités arabes."
    ],
    "es": [
      "La creación de la cantante franco-siria Climène Zarkan y el guitarrista Baptiste Ferrandis, Sar?b -que significa \"espejismo\" en árabe- es una mezcla magistral de rock, jazz moderno y sonidos árabes."
    ],
    "nl": [
      "Het geesteskind van de Frans-Syrische zangeres Climène Zarkan en gitarist Baptiste Ferrandis, Sar?b - wat 'fata morgana' betekent in het Arabisch - is een meesterlijke mix van rock, moderne jazz en Arabische klanken."
    ]
  },
