        "de": [
          "um 15:00 Uhr\n-------------------------\n\n4 Spiele - in formierten Doppelspielen\nVolle Rückgabe der Einsätze\n\n10? pro Doublette\nGetränke und Sandwiches vor Ort"
        ],
        "en": [
          "at 3:00 pm\n-------------------------\n\n4 games - doublettes\nFull reversion of bets\n\n10? per double\nRefreshment bar and sandwiches on site"
        ],
        "it": [
          "alle 15h00\n-------------------------\n\n4 partite - doppie\nRiversamento completo delle scommesse\n\n10? per ogni doppia\nBar e panini in loco"
        ],
        "fr": [
          "à 15h00\n-------------------------\n\n4 parties - en doublettes formées\nRéversion intégrale des mises\n\n10€ la doublette\nBuvette et sandwiches sur place"
        ],
        "nl": [
          "om 15u00\n-------------------------\n\n4 spellen - doubletten\nVolledige teruggave van weddenschappen\n\n10? per doublet\nVersnaperingsbar en broodjes ter plaatse"
        ],
        "es": [
          "a las 15h00\n-------------------------\n\n4 partidos - dobletes\nReversión total de las apuestas\n\n10? por doble\nBar y bocadillos in situ"
        ]
