      "dc:description": {
        "de": [
          "Das Schloss von Plainval wurde gegen Ende des 16. Jahrhunderts erbaut. Zuvor gab es ein befestigtes Herrenhaus in der Mitte des Dorfes."
        ],
        "en": [
          "Château de Plainval was built towards the end of the 16th century. There used to be a fortified manor house in the middle of the village."
        ],
        "it": [
          "Il castello di Plainval fu costruito verso la fine del XVI secolo. Al centro del villaggio si trovava un maniero fortificato."
        ],
        "fr": [
          "Le château de Plainval a été bâti vers la fin du XVIème siècle. Il y avait auparavant un manoir fortifié au milieu du village."
        ],
        "nl": [
          "Plainval Castle werd tegen het einde van de 16e eeuw gebouwd. In het midden van het dorp stond vroeger een versterkt landhuis."
        ],
        "es": [
          "El castillo de Plainval se construyó a finales del siglo XVI. En el centro del pueblo había una casa solariega fortificada."
        ]
      },
