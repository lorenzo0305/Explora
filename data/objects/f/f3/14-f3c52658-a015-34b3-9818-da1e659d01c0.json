  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/32d96e60-8aba-3baf-9e19-9db708b93a5f",
      "dc:description": {
        "de": [
          "Avenir Basket Berck Rang-du-Fliers ist ein historischer Verein in der Region Hauts-de-France, der heute fast 240 Lizenzinhaber hat und von einem Fanionteam in der Nationalen Liga 1 der Männer getragen wird,\nund einem Team für Rollstuhlbasketball in der Nationalen Liga C."
        ],
        "en": [
          "Avenir Basket Berck Rang-du-Fliers is a historic club in the Hauts-de-France region, with 240 members and a men's National 1 pennant team,\nand a wheelchair basketball team in Nationale C."
        ],
        "it": [
          "L'Avenir Basket Berck Rang-du-Fliers è un club storico della regione Hauts-de-France, con 240 membri e una squadra di National 1 maschile,\ne una squadra di basket in carrozzina in Nazionale C."
        ],
        "fr": [
          "L'Avenir Basket Berck Rang-du-Fliers est un club historique des Hauts-de-France qui compte aujourd'hui près de 240 licenciés et est porté par une équipe fanion en Nationale 1 Masculine,\net une équipe de Basket Fauteuil en Nationale C."
        ],
        "nl": [
          "Avenir Basket Berck Rang-du-Fliers is een historische club in de regio Hauts-de-France, met 240 leden en een nationaal 1-team voor mannen,\nen een rolstoelbasketbalteam in Nationaal C."
        ],
        "es": [
          "Avenir Basket Berck Rang-du-Fliers es un club histórico de la región de Hauts-de-France que cuenta con 240 socios y un equipo masculino de Nacional 1,\ny un equipo de baloncesto en silla de ruedas en la Nacional C."
        ]
      },
