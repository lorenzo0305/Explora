  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bf897f1d-75d1-362f-a1b8-8a0e9cee1fa5",
      "dc:description": {
        "de": [
          "Treffen Sie sich im Herzen der Cité Minière des Brebis, in der Nähe des Stadtteilhauses La Bergerie, um kostenlos an einer pyrotechnischen Show teilzunehmen und einen geselligen Moment rund um das Feuerzeug des Bergmanns zu verbringen, das von den Bewohnern des Viertels zubereitet wird."
        ],
        "en": [
          "Join us in the heart of the Cité Minière des Brebis, near the Maison de quartier la Bergerie, to watch a free fireworks display and share a moment of conviviality over a miner's lighter prepared by local residents."
        ],
        "it": [
          "Unitevi a noi nel cuore della Cité Minière des Brebis, vicino alla Maison de quartier la Bergerie, per assistere a uno spettacolo pirotecnico gratuito e condividere un momento di convivialità davanti a un accendino da minatore preparato dai residenti locali."
        ],
        "fr": [
          "Rendez-vous en plein cœur de la Cité Minière des Brebis, aux abords de la Maison de quartier la Bergerie pour assister gratuitement à un spectacle pyrotechnique et partager un moment de convivialité autour du briquet du mineur préparé par les habitants du quartier."
        ],
        "es": [
          "Únase a nosotros en el corazón de la Cité Minière des Brebis, cerca de la Maison de quartier la Bergerie, para asistir a un espectáculo gratuito de fuegos artificiales y compartir un momento de convivencia en torno a un mechero minero preparado por los residentes locales."
        ],
        "nl": [
          "Kom naar het hart van de Cité Minière des Brebis, in de buurt van het Maison de quartier la Bergerie, om naar een gratis vuurwerk te kijken en een moment van gezelligheid te delen onder het genot van een mijnwerkersaansteker bereid door buurtbewoners."
        ]
      },
