  "rdfs:comment": {
    "de": [
      "Entdecken Sie vom Haus der Sümpfe aus das Natur- und Landschaftserbe des mittleren Sommetals. Als Ort der Natur und der Entspannung bietet das Moor von Longpré ein Mosaik aus Landschaften: Teiche, Schilfgürtel, Wiesen und bewaldete Moore, die sich über 160 Hektar erstrecken."
    ],
    "en": [
      "From the marsh house, discover the natural and landscape heritage of the middle valley of the Somme. A place of nature and relaxation, the Longpré marshland offers a mosaic of landscapes: ponds, reed beds, meadows and wooded marshes that extend over more than 160 hectares."
    ],
    "it": [
      "Dalla casa della palude, scoprite il patrimonio naturale e paesaggistico della media valle della Somme. Luogo di natura e relax, le paludi di Longpré offrono un mosaico di paesaggi: stagni, canneti, prati e paludi boscose per oltre 160 ettari."
    ],
    "fr": [
      "Au départ de la maison des marais, découvrez les patrimoines naturels et paysagers de la moyenne vallée de la Somme. Lieu de nature, de détente, le marais de Longpré offre une mosaïque de paysages : étangs, roselières, prairies et marais boisés qui s’étendent sur plus de 160 hectares."
    ],
    "nl": [
      "Ontdek vanuit het moerashuis het natuurlijke en landschappelijke erfgoed van de middenvallei van de Somme. De moerassen van Longpré, een plek van natuur en ontspanning, bieden een mozaïek van landschappen: vijvers, rietvelden, weilanden en beboste moerassen van meer dan 160 hectare."
    ],
    "es": [
      "Desde la casa del pantano, descubra el patrimonio natural y paisajístico del valle medio del Somme. Lugar de naturaleza y relajación, las marismas de Longpré ofrecen un mosaico de paisajes: estanques, cañaverales, praderas y marismas arboladas que cubren más de 160 hectáreas."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Maison des Marais"
    ]
  },
