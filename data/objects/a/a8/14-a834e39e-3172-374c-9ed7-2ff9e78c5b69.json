  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ef3b1dc2-9de2-3602-bcb9-c0a2c17a32a4",
      "dc:description": {
        "de": [
          "Für 6- bis 10-Jährige: Komm und kümmere dich um die Tiere!\nDonnerstag, 19. Februar von 14:30 bis 16:00 Uhr\nDer Bauernhof meiner Kindheit\n-------------------------\nAuf dem Programm stehen:\nZubereitung und Fütterung der Tiere im vertrauten Lebensraum\nSammeln von Eiern\n\nPreis : 20? - Reservierungen: 06 11 01 84 93\nCredit: Pixabay"
        ],
        "en": [
          "For 6-10 year-olds: Come and look after the animals!\nThursday, February 19, 2:30 pm to 4 pm\nLa Ferme de mon Enfance\n-------------------------\nProgram:\nPreparing and distributing food to the animals in the pet area\nEgg harvesting\n\nPrice: 20? - Reservations: 06 11 01 84 93\nCredit : Pixabay"
        ],
        "it": [
          "Per i bambini dai 6 ai 10 anni: vieni a prenderti cura degli animali!\nGiovedì 19 febbraio dalle 14.30 alle 16.00\nLa fattoria della mia infanzia\n-------------------------\nIn programma:\nPreparazione e distribuzione del cibo agli animali nell'area degli animali domestici\nRaccolta delle uova\n\nPrezzo: € 20 - Prenotazioni: 06 11 01 84 93\nCredito: Pixabay"
        ],
        "fr": [
          "Pour les 6-10 ans : Viens t’occuper des bêtes !\nJeudi 19 février de 14h30 à 16h\nLa Ferme de mon Enfance\n-------------------------\nAu programme : \nPréparation et distributions des aliments aux animaux de l’espace familier\nRécolte des oeufs\n\nTarif : 20€ - Réservations : 06 11 01 84 93\nCrédit : Pixabay"
        ],
        "nl": [
          "Voor kinderen van 6-10 jaar: Kom de dieren verzorgen!\nDonderdag 19 februari van 14.30 tot 16.00 uur\nMijn kinderboerderij\n-------------------------\nOp het programma:\nEten klaarmaken en uitdelen aan de dieren in het dierenverblijf\nEieren rapen\n\nPrijs: 20 euro - Boekingen: 06 11 01 84 93\nKrediet: Pixabay"
        ],
        "es": [
          "Para niños de 6 a 10 años: ¡Ven a cuidar de los animales!\nJueves 19 de febrero de 14h30 a 16h00\nLa granja de mi infancia\n-------------------------\nEn el programa:\nPreparar y distribuir comida a los animales en la zona de animales de compañía\nRecogida de huevos\n\nPrecio: 20 - Reservas: 06 11 01 84 93\nCrédito: Pixabay"
        ]
      },
