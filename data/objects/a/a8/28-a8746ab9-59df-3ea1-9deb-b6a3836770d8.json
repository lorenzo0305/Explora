  "rdfs:comment": {
    "de": [
      "Bioburger ist eine Karte mit 100% BIO, FRISCH und GESUND, die sich an die Saisonalität anpasst (Tomaten nur im Sommer, Avocados nur im Winter!), Produkte aus Frankreich, Kartoffeln, Bier, Kaffee, Tee, Maroilles aus dem NORDEN, Gourmet- und VG-Burger."
    ],
    "en": [
      "Bioburger is a 100% ORGANIC, FRESH and HEALTHY menu that adapts to seasonality (tomatoes only in summer, avocados only in winter!), products of French origin, potatoes, beers, coffee, tea, maroilles from the NORD, gourmet and VG burgers."
    ],
    "it": [
      "Bioburger è un menu 100% BIOLOGICO, FRESCO e SANO che si adatta alle stagioni (pomodori solo in estate, avocado solo in inverno!), prodotti di origine francese, patate, birre, caffè, tè, maroilles del NORD, hamburger gourmet e VG."
    ],
    "fr": [
      "Bioburger c’est une carte 100% BIO , FRAIS et SAIN qui s’adapte à la saisonnalité (des tomates uniquement l’été, des avocats uniquement l’hiver !), des produits d’origine française, des pommes de terre, bières, café, thé, maroilles du NORD, des burgers gourmands et VG."
    ],
    "nl": [
      "Bioburger is een 100% ORGANISCH, FRESH en GEZOND menu dat zich aanpast aan de seizoenen (tomaten alleen in de zomer, avocado's alleen in de winter!), producten van Franse oorsprong, aardappelen, bieren, koffie, thee, maroilles uit de NORD, gourmet en VG burgers."
    ],
    "es": [
      "Bioburger es una carta 100% BIO, FRESCA y SALUDABLE que se adapta a las estaciones (¡tomates sólo en verano, aguacates sólo en invierno!), productos de origen francés, patatas, cervezas, café, té, maroilles de la NORD, hamburguesas gourmet y VG."
    ]
  },
