      "openingDetails": {
        "de": [
          "Das Diktat der Junioren\nKinder von 8 bis 12 Jahren in Begleitung eines Elternteils.\nUm 10:30 Uhr. Einlass ab 10.15 Uhr möglich\n\nDie Diktate für Erwachsene und Erwachsene Pro\nUm 11:45 Uhr"
        ],
        "en": [
          "Junior dictation\nChildren aged 8 to 12, accompanied by a parent.\nAt 10:30 am. Admission from 10:15 am\n\nAdult and adult pro dictations\n11:45 a.m"
        ],
        "it": [
          "Dettatura junior\nBambini dagli 8 ai 12 anni, accompagnati da un genitore.\nAlle 10.30. Ingresso dalle 10.15\n\nDettatura adulti e adulti pro\nAlle 11.45"
        ],
        "fr": [
          "La dictée juniors\nEnfants de 8 à 12 ans, accompagnés d’un parent.\nÀ 10h30. Entrée possible dès 10h15\n\nLes dictées adultes et adultes pro\nÀ 11h45"
        ],
        "nl": [
          "Junior dictee\nKinderen van 8 tot 12 jaar, onder begeleiding van een ouder.\nOm 10.30 uur. Toegang vanaf 10.15 uur\n\nDictees voor volwassenen en pro dictees voor volwassenen\nOm 11.45 uur"
        ],
        "es": [
          "Dictado para niños\nNiños de 8 a 12 años, acompañados por uno de sus padres.\nA las 10.30 h. Admisión a partir de las 10.15 h\n\nDictados adultos y adultos pro\nA las 11.45 h"
        ]
