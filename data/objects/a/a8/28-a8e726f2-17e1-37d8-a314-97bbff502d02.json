  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum gelegen. Atmosphäre eines englischen Pubs. Brasserie 7 Tage die Woche geöffnet. Durchgehend bedient. Übertragung von Spielen und Sportereignissen. Themenabende, Konzerte, Karaoke.\n\nAnzahl der Gedecke: 100\nEmpfang von Gruppen: 55 Personen\nDurchgehender Service: 12 Uhr bis 22:30 Uhr und 23:30 Uhr am Freitag und Samstag."
    ],
    "en": [
      "In the town center. English pub atmosphere. Brasserie open 7/7. Continuous service. Broadcasting of matches and sporting events. Theme evenings, concerts, karaoke.\n\nNumber of covers: 100\nGroups welcome: 55 people\nContinuous service: 12pm to 10:30pm and 11:30pm on Friday and Saturday."
    ],
    "it": [
      "Nel centro della città. Atmosfera da pub inglese. Brasserie aperta 7 giorni su 7. Servizio continuo. Trasmissione di partite ed eventi sportivi. Serate a tema, concerti, karaoke.\n\nNumero di coperti: 100\nGruppi: 55 persone\nServizio continuo: dalle 12.00 alle 22.30 e alle 23.30 il venerdì e il sabato."
    ],
    "fr": [
      "En centre-ville. Ambiance pub anglais. Brasserie ouverte 7j/7. Service en continu. Retransmission de matchs et d'évènements sportifs. Soirées à thème, concerts, karaokés.\n\nNombre de couverts : 100\nAccueil groupes : 55 personnes \nService en continu : 12h à 22h30 et 23h30 vendredi et samedi."
    ],
    "nl": [
      "In het stadscentrum. Engelse pubsfeer. Brasserie 7 dagen per week geopend. Continue service. Uitzending van wedstrijden en sportevenementen. Thema-avonden, concerten, karaoke.\n\nAantal couverts: 100\nGroepen: 55 personen\nDoorlopende service: 12.00 tot 22.30 en 23.30 op vrijdag en zaterdag."
    ],
    "es": [
      "En el centro de la ciudad. Ambiente de pub inglés. Brasserie abierta 7 días a la semana. Servicio continuo. Retransmisión de partidos y acontecimientos deportivos. Veladas temáticas, conciertos, karaoke.\n\nNúmero de cubiertos: 100\nGrupos: 55 personas\nServicio continuo: de 12.00 a 22.30 h. y a las 23.30 h. los viernes y sábados."
    ]
  },
