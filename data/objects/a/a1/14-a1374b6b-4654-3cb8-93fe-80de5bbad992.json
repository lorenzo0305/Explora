  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5185bfb2-7357-3ff9-8f57-f5fdb1c341d5",
      "dc:description": {
        "de": [
          "Biblio-Teen\nWir teilen unsere Favoriten mit allen coolen Leuten! Romane, Mangas, Filme? alles ist erlaubt! Biblio-Teen ist der Leseclub, der dir das Wort gibt!\n\nAb 12 Jahren.\n\nBibliothek der Annonciades, Bereich Jugend und Jugendliche\n\nFreier Eintritt"
        ],
        "en": [
          "Biblio-Teen\nLet's share our cool-attitude favorites! Novels, manga, movies? anything goes! Biblio-Teen is the book club that lets you have your say!\n\nFor ages 12 and up.\n\nAnnonciades Library, Youth Sector\n\nFree admission"
        ],
        "it": [
          "Biblio-Teen\nCondividiamo i nostri preferiti con un atteggiamento cool! Romanzi, manga, film... tutto va bene! Biblio-Teen è il club del libro che vi permette di dire la vostra!\n\nPer i maggiori di 12 anni.\n\nBiblioteca Annonciades, Settore Giovani\n\nIngresso libero"
        ],
        "fr": [
          "Biblio-Teen\nPartageons nos coups de cœur en toute cool-attitude ! Romans, mangas, films… tout est permis ! Biblio-Teen c’est le club de lecture qui te donne la parole !\n\nA partir de 12 ans.\n\nBibliothèque des Annonciades, Secteur Jeunesse-Ados\n\nEntrée libre et gratuite"
        ],
        "es": [
          "Biblio-Teen\n¡Compartamos nuestros favoritos con actitud cool! Novelas, manga, películas... ¡todo vale! Biblio-Teen es el club de lectura que te da la palabra\n\nA partir de 12 años.\n\nBiblioteca Annonciades, Sector Juventud\n\nEntrada gratuita"
        ],
        "nl": [
          "Biblio-Teen\nLaten we onze favorieten delen met een coole houding! Romans, manga, films, alles kan! Biblio-Teen is de boekenclub waar jij het voor het zeggen hebt!\n\nVanaf 12 jaar.\n\nBibliotheek Annonciades, Sector Jeugd\n\nGratis toegang"
        ]
      },
