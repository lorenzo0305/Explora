  "rdfs:comment": {
    "de": [
      "Restaurant mit asiatischer Küche, das chinesische, japanische, thailändische und vietnamesische Spezialitäten anbietet.\n\nUnter der Woche und am Wochenende steht den Gästen ein All-you-can-eat-Buffet zur Verfügung."
    ],
    "en": [
      "Asian cuisine restaurant, offering Chinese, Japanese, Thai and Vietnamese specialties.\n\nAn all-you-can-eat buffet is available to customers during the week and at weekends."
    ],
    "it": [
      "Ristorante di cucina asiatica che offre specialità cinesi, giapponesi, tailandesi e vietnamite.\n\nDurante la settimana e nei fine settimana è disponibile un buffet a volontà per gli ospiti."
    ],
    "fr": [
      "Restaurant de cuisine asiatique, proposant des spécialités chinoises, japonaises, thaïlandaises et vietnamiennes.\n\nUn buffet à volonté est à la disposition de la clientèle en semaine et le week-end."
    ],
    "es": [
      "Restaurante de cocina asiática, que ofrece especialidades chinas, japonesas, tailandesas y vietnamitas.\n\nDurante la semana y los fines de semana, los huéspedes tienen a su disposición un buffet libre."
    ],
    "nl": [
      "Aziatisch restaurant met Chinese, Japanse, Thaise en Vietnamese specialiteiten.\n\nEen all-you-can-eat buffet is beschikbaar voor gasten tijdens de week en in het weekend."
    ]
  },
