      "dc:description": {
        "de": [
          "Besuchen Sie das Fest der Heiligen Barbara in der Base 11/19, einer Bergbaustätte, die seit 2012 zum UNESCO-Weltkulturerbe gehört."
        ],
        "en": [
          "Attend the Sainte Barbe festival at Base 11/19, a mining site listed as a Unesco World Heritage Site since 2012."
        ],
        "it": [
          "Partecipate al festival Sainte Barbe presso la Base 11/19, un sito minerario classificato come patrimonio mondiale dell'UNESCO dal 2012."
        ],
        "fr": [
          "Assistez au festival de la Sainte Barbe à la Base 11/19, site minier inscrit au Patrimoine mondial de l'Unesco depuis 2012."
        ],
        "nl": [
          "Woon het Sainte Barbe festival bij op Base 11/19, een mijnbouwlocatie die sinds 2012 op de Werelderfgoedlijst van UNESCO staat."
        ],
        "es": [
          "Asiste a la fiesta de Sainte Barbe en la Base 11/19, un yacimiento minero declarado Patrimonio de la Humanidad por la UNESCO desde 2012."
        ]
