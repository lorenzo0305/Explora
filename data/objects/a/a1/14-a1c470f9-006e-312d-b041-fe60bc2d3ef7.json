  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/359645b9-18e3-369e-b51a-05404047cc6b",
      "dc:description": {
        "de": [
          "Raffinierte und schmackhafte Küche mit herzhaften Gerichten wie Entenparmentier mit Süßkartoffeln, Kabeljauschwanzfilet mit Chicorée-Fondue, Kalbsblanquette mit Reis und Gemüse oder Schweinefilet Mignon mit Kartoffel- und Pilzpfanne."
        ],
        "en": [
          "Refined, flavorful cuisine, featuring tasty dishes such as duck parmentier with sweet potato, cod fillet with chicory fondue, veal blanquette with rice and vegetables, or pork filet mignon with pan-fried potatoes and mushrooms."
        ],
        "it": [
          "Una cucina raffinata e saporita, con piatti gustosi come la parmentier d'anatra con patate dolci, il filetto di merluzzo con fonduta di cicoria, la blanquette di vitello con riso e verdure o il filetto di maiale mignon con patate e funghi in padella."
        ],
        "fr": [
          "Cuisine raffinée et savoureuse, composée de plats savoureux tels que le parmentier de canard à la patate douce, le filet de queue de cabillaud avec une fondue d'endives, la blanquette de veau accompagnée de riz et légumes ou encore le filet mignon de porc avec une poêlée de pommes de terre et champignons."
        ],
        "nl": [
          "Verfijnde, smaakvolle keuken, met smakelijke gerechten zoals eendenparmentier met zoete aardappel, kabeljauwfilet met witloffondue, kalfsblanquette met rijst en groenten, of varkensfilet mignon met gebakken aardappelen en champignons."
        ],
        "es": [
          "Cocina refinada y sabrosa, con sabrosos platos como parmentier de pato con boniato, filete de bacalao con fondue de achicoria, blanqueta de ternera con arroz y verduras, o filete mignon de cerdo con patatas a la sartén y setas."
        ]
      },
      "@type": [
        "Description"
      ],
