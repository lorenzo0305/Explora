  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2a02ee6f-a9ed-37d0-ab35-54dba3a62d4a",
      "dc:description": {
        "de": [
          "Chatte auf Englisch, während du an unserem wunderschönen Strand entlanggehst! Geeignet für alle Altersgruppen. Gehen Sie bei einem Spaziergang auf Englisch an die frische Luft. Das tut gut und Sie machen mit professioneller Hilfe Fortschritte!"
        ],
        "en": [
          "Chat in English while you walk along our beautiful beach! Suitable for all ages. Take a walk in English. It's good for you, and you'll make progress with the help of a professional!"
        ],
        "it": [
          "Chiacchierate in inglese mentre passeggiate lungo la nostra bellissima spiaggia! Adatto a tutte le età. Prendete un po' d'aria fresca in inglese mentre camminate lungo la nostra bellissima spiaggia. Fa bene e in più, con l'aiuto di un professionista, farete progressi!"
        ],
        "fr": [
          "Chat in English while you walk along our beautiful beach! Suitable for all ages. Prenez l’air en anglais le temps d'une promenade. Ca fait du bien et en plus, vous progressez avec l'aide d'une professionnelle !"
        ],
        "nl": [
          "Praat in het Engels terwijl je langs ons prachtige strand loopt! Geschikt voor alle leeftijden. Doe een frisse neus in het Engels terwijl je langs ons prachtige strand wandelt. Het is goed voor je en bovendien boek je vooruitgang met de hulp van een professional!"
        ],
        "es": [
          "Charla en inglés mientras paseas por nuestra hermosa playa Apto para todas las edades. Toma el aire en inglés mientras paseas por nuestra hermosa playa. Es bueno para ti y, además, ¡progresarás con la ayuda de un profesional!"
        ]
      },
      "@type": [
        "Description"
      ],
