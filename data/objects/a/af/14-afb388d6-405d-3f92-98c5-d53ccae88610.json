      "dc:description": {
        "de": [
          "Eine Idee, ein Projekt, kommen Sie und teilen Sie es mit anderen! Merlimont Passion heißt Sie herzlich willkommen, um Ihnen zuzuhören und sie in die Tat umzusetzen."
        ],
        "en": [
          "An idea, a project, come and share it with people of all ages and backgrounds. Merlimont Passion welcomes you to listen to you and put them into action."
        ],
        "it": [
          "Un'idea, un progetto, vieni a condividerlo! Merlimont Passion vi accoglie per ascoltare le vostre idee e metterle in pratica."
        ],
        "fr": [
          "Une idée, un projet, venez les partager!! de tout âge et de tout horizon. Merlimont Passion vous accueille pour vous écouter et les mettre en action."
        ],
        "es": [
          "Una idea, un proyecto, ¡venga a compartirlo! Merlimont Passion le da la bienvenida para escuchar sus ideas y ponerlas en práctica."
        ],
        "nl": [
          "Een idee, een project, kom en deel het! Merlimont Passion verwelkomt u om naar uw ideeën te luisteren en ze in daden om te zetten."
        ]
      },
