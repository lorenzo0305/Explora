  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/68b56b45-089f-300c-b26a-a559a7703494",
      "dc:description": {
        "de": [
          "Die ehemalige Getreidemühle für Brot wurde 1833 erbaut. Der runde Backsteinturm wurde von 1976 bis 1978 restauriert."
        ],
        "en": [
          "Formerly a wheat mill for bread, it was built in 1833. The circular brick tower was restored between 1976 and 1978."
        ],
        "it": [
          "Questo ex mulino per il pane fu costruito nel 1833. La torre circolare in mattoni è stata restaurata tra il 1976 e il 1978."
        ],
        "fr": [
          "Ancien moulin à blé pour le pain, il fut construit en 1833. La tour circulaire en briques fut restaurée de 1976 à 1978."
        ],
        "es": [
          "Este antiguo molino de pan fue construido en 1833. La torre circular de ladrillo fue restaurada entre 1976 y 1978."
        ],
        "nl": [
          "Deze voormalige broodmolen werd gebouwd in 1833. De ronde bakstenen toren werd tussen 1976 en 1978 gerestaureerd."
        ]
      },
