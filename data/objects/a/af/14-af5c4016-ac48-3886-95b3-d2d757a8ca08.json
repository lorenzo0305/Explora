  "rdfs:comment": {
    "de": [
      "Das Haus der Kunst und Kommunikation umfasst mehrere kulturelle Einrichtungen: Tanzschule, Musikschule, Mediathek, Ausstellungsgalerie, Veranstaltungssaal, Multimedia-Kulturraum, Räume für künstlerischen Ausdruck."
    ],
    "en": [
      "The Maison de l'Art et de la Communication brings together several cultural infrastructures: dance school, music school, media library, exhibition gallery, performance hall, multimedia culture space, spaces for artistic expression."
    ],
    "it": [
      "La Maison de l'Art et de la Communication riunisce diverse strutture culturali: una scuola di danza, una scuola di musica, una mediateca, una galleria espositiva, un auditorium, uno spazio culturale multimediale e spazi per l'espressione artistica."
    ],
    "fr": [
      "La Maison de l'Art et de la Communication regroupe plusieurs infrastructures culturelles : école de danse, école de musique, médiathèque, galerie d'exposition, salle de spectacles, espace culture multimédia, espaces d'expression artistique."
    ],
    "es": [
      "La Maison de l'Art et de la Communication reúne varios equipamientos culturales: una escuela de danza, una escuela de música, una mediateca, una galería de exposiciones, un auditorio, un espacio cultural multimedia y espacios de expresión artística."
    ],
    "nl": [
      "Het Maison de l'Art et de la Communication verenigt een aantal culturele faciliteiten: een dansschool, een muziekschool, een mediatheek, een tentoonstellingsgalerij, een auditorium, een multimediale culturele ruimte en ruimtes voor artistieke expressie."
    ]
  },
