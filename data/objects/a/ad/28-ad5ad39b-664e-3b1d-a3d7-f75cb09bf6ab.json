  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fbee0e43-ef00-3a61-a1b4-d067eac004e6",
      "dc:description": {
        "de": [
          "Kurse für Bollywood-, orientalischen und brasilianischen Tanz. Jugendliche, Erwachsene jeden Dienstag von 18:30 bis 19:30 Uhr. Neu: Spezieller Bollywood-Tanzkurs für Kinder um 17:30 Uhr.  Teilnahme an Karnevalsveranstaltungen und Aufführungen für alle (nicht obligatorisch). Preis pro Jahr: 120? und 10? Vereinsmitgliedschaft."
        ],
        "en": [
          "Bollywood, Oriental and Brazilian dance classes. Teens, adults every Tuesday from 6.30 pm to 7.30 pm. New: children's Bollywood dance class at 5:30 p.m.  Participation in carnivals and shows for all (not compulsory). Price per year: 120? plus 10? association membership."
        ],
        "it": [
          "Corsi di danza bollywoodiana, orientale e brasiliana. Adolescenti e adulti ogni martedì dalle 18.30 alle 19.30. Novità: lezione speciale di danza Bollywood per bambini alle 17.30.  Partecipazione a carnevali e spettacoli per tutti (non obbligatoria). Prezzo annuale: 120 euro più 10 euro di iscrizione all'associazione."
        ],
        "fr": [
          "Cours de danse bollywood, orientale et brésilienne. Adolescents, adultes tous les mardis de 18 h30 à 19 h 30. Nouveauté : cours de danse bollywood spécial enfants à 17h30.  Participation carnavals et spectacles pour tous (non obligatoire). Prix à l'année : 120€ et 10€ d'adhésion à l'association."
        ],
        "es": [
          "Clases de Bollywood, danza oriental y brasileña. Adolescentes y adultos, todos los martes de 18.30 a 19.30 h. Novedad: clase especial de Bollywood para niños a las 17.30 h.  Participación en carnavales y espectáculos para todos (no obligatorio). Precio al año: 120 euros más 10 euros de miembro de la asociación."
        ],
        "nl": [
          "Bollywood, Oriëntaalse en Braziliaanse danslessen. Tieners en volwassenen elke dinsdag van 18.30 tot 19.30 uur. Nieuw: speciale Bollywood dansles voor kinderen om 17.30 uur.  Deelname aan carnavals en shows voor iedereen (niet verplicht). Prijs per jaar: 120 euro plus 10 euro lidmaatschap van de vereniging."
        ]
      },
