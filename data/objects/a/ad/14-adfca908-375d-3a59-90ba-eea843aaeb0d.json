  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ce62fbf0-dc8c-38fe-8e95-eda18e17fee7",
      "dc:description": {
        "de": [
          "Pommesbude auf dem Campingplatz Pomme de Pin für alle geöffnet. Verfügbar für Veranstaltungen\n\nÖffnungszeiten Einschluss :\nAn Wochenenden geöffnet. Bestellung per Telefon dringend empfohlen, um die Barrieregesten einzuhalten. Tel: +33 (0)6 50 81 91 62 für weitere Informationen Facebook-Seite"
        ],
        "en": [
          "The Pomme de Pin Campsite's chip shop is open to all. Available for events\n\nSchedules containment :\nOpen on weekends. Ordering by phone is strongly recommended to respect the barrier gestures. Tel: +33 (0)6 50 81 91 62 for more information Facebook page"
        ],
        "it": [
          "Il campeggio Pomme de Pin è aperto a tutti. Disponibile per eventi\n\nOrari di chiusura:\nAperto nei fine settimana. Si consiglia di ordinare per telefono per rispettare i gesti della barriera. Tel: +33 (0)6 50 81 91 62 per maggiori informazioni Pagina Facebook"
        ],
        "fr": [
          "Friterie du Camping Pomme de Pin ouverte à tous. Disponible pour des événements. \n\nHoraires confinement :\nOuvert les week-ends. Commande par téléphone fortement recommandée pour respecter les gestes barrières. Tel : +33 (0)6 50 81 91 62 pour plus d’informations page Facebook"
        ],
        "es": [
          "La tienda de patatas fritas del Camping Pomme de Pin está abierta a todos. Disponible para eventos\n\nHorario de cierre:\nAbierto los fines de semana. Se recomienda encarecidamente hacer el pedido por teléfono para respetar los gestos de la barrera. Tel: +33 (0)6 50 81 91 62 para más información Página de Facebook"
        ],
        "nl": [
          "Camping Pomme de Pin frituur open voor iedereen. Beschikbaar voor evenementen\n\nSluitingstijden:\nOpen in het weekend. Telefonisch bestellen wordt sterk aanbevolen om de gebaren van de slagboom te respecteren. Tel: +33 (0)6 50 81 91 62 voor meer informatie Facebook-pagina"
        ]
      },
