      "@id": "https://data.datatourisme.fr/a16564d9-c347-3171-ae12-88252be1b402",
      "dc:description": {
        "de": [
          "\"Aux Pêcheurs de Moules\", Direktverkauf von Meeresprodukten, wobei Frische und kurze Transportwege im Vordergrund stehen."
        ],
        "en": [
          "\"Aux Pêcheurs de Moules\", direct sales of seafood products, with a focus on freshness and short distribution channels."
        ],
        "it": [
          "\"Aux Pêcheurs de Moules\", vendita diretta di frutti di mare, con particolare attenzione alla freschezza e ai canali di distribuzione brevi."
        ],
        "fr": [
          "« Aux Pêcheurs de Moules », vente directe de produits de la mer, privilégiant fraîcheur et circuit court."
        ],
        "es": [
          "\"Aux Pêcheurs de Moules\", venta directa de marisco, con especial atención a la frescura y a los canales de distribución cortos."
        ],
        "nl": [
          "\"Aux Pêcheurs de Moules\", directe verkoop van zeevruchten, met de nadruk op versheid en korte distributiekanalen."
        ]
      },
