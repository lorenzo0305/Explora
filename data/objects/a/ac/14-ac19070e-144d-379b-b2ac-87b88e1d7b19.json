      "dc:description": {
        "de": [
          "Tennis\nWinter Open, organisiert vom Touquet-Tennis-Club.\nTurnier der 3. Kategorie (1200? Preisgeld) - Dameneinzel und Herreneinzel\nIm Centre Tennistique Pierre de Coubertin."
        ],
        "en": [
          "Tennis\nWinter Open, organized by the Touquet Tennis Club.\n3rd category tournament (1200? prize money) - Ladies and Men?s Singles\nAt the Pierre de Coubertin Tennis Center."
        ],
        "it": [
          "Il tennis\nOpen d'inverno, organizzato dal Tennis Club Touquet.\nTorneo di 3ª categoria (1200? di montepremi) - Singolo femminile e singolare maschile\nPresso il Centro Tennis Pierre de Coubertin."
        ],
        "fr": [
          "Tennis\nOpen d’hiver, organisé par le Touquet-Tennis-Club.\nTournoi 3eme catégorie (1200€ de prix) - Simples Dames et Simples Messieurs \nAu Centre Tennistique Pierre de Coubertin."
        ],
        "nl": [
          "Tennis\nWinter Open, georganiseerd door de Touquet Tennis Club.\nToernooi in de 3e categorie (1200? prijzengeld) - Dames enkelspel en Heren enkelspel\nIn het Pierre de Coubertin tenniscentrum."
        ],
        "es": [
          "Tenis\nOpen de invierno, organizado por el Club de Tenis de Touquet.\nTorneo de 3ª categoría (1200? de premio) - Individual femenino e Individual masculino\nEn el Centro de Tenis Pierre de Coubertin."
        ]
