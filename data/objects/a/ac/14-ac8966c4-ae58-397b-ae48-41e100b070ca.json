  "rdfs:comment": {
    "de": [
      "Bei einer Kanufahrt auf dem Fluss Souchez wird das Leben langsamer und sanfter, und wir versprechen Ihnen einen Moment der Erholung, in dem Sie alles vergessen."
    ],
    "en": [
      "Canoeing on the Souchez, life becomes slower and gentler, and we promise you a moment of rejuvenation where you can forget everything."
    ],
    "it": [
      "In canoa sul Souchez, la vita diventa più lenta e più dolce, e vi promettiamo un momento di ringiovanimento in cui potrete dimenticare tutto."
    ],
    "fr": [
      "En canoë sur la Souchez, la vie se fait plus lente, plus douce et on vous promet un moment de ressourcement où on oublie tout."
    ],
    "es": [
      "Navegando en canoa por el Souchez, la vida se vuelve más lenta y apacible, y le prometemos un momento de rejuvenecimiento en el que podrá olvidarse de todo."
    ],
    "nl": [
      "Kanoënd op de Souchez wordt het leven langzamer en zachter, en we beloven je een moment van verjonging waarin je alles kunt vergeten."
    ]
  },
