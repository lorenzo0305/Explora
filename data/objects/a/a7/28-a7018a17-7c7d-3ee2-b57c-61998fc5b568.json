      "rdfs:comment": {
        "de": [
          "Diversifiziertes Unternehmen im Gemüseanbau, das sich auf Tomaten, Erdbeeren, Gurken und Rhabarber spezialisiert hat. Vertriebshändler auf dem Bauernhof und in den umliegenden Dörfern, um eine vollständige Palette an Obst und Gemüse wiederzufinden."
        ],
        "en": [
          "Diversified market gardening company, specializing in tomatoes, strawberries, cucumbers and rhubarb. Distributor at the farm and in the surrounding villages for a full range of fruit and vegetables."
        ],
        "it": [
          "Azienda agricola diversificata specializzata in pomodori, fragole, cetrioli e rabarbaro. Distributore in azienda e nei villaggi circostanti di una gamma completa di prodotti ortofrutticoli."
        ],
        "fr": [
          "Entreprise diversifiée dans le maraichage, et spécialisée dans les tomates, fraises, concombres et rhubarbe. Distributeur à la ferme et dans les villages alentours pour retrouver une gamme complète de fruits et légumes."
        ],
        "nl": [
          "Gediversifieerd tuinbouwbedrijf gespecialiseerd in tomaten, aardbeien, komkommers en rabarber. Distributeur op de boerderij en in de omliggende dorpen voor een volledig assortiment groenten en fruit."
        ],
        "es": [
          "Empresa de horticultura diversificada especializada en tomates, fresas, pepinos y ruibarbo. Distribuidor en la explotación y en los pueblos de los alrededores de una gama completa de frutas y hortalizas."
        ]
      },
