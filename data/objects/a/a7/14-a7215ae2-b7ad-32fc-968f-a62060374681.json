  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05270410-d21b-3862-b633-45385cacacb4",
      "dc:description": {
        "de": [
          "Das Office de Tourisme Haut-Pays Côte d'Opale bietet Ihnen in Hucqueliers den Verleih von Fahrrädern mit elektrischer Unterstützung an.\nFür einen halben Tag, einen Tag, ein Wochenende oder mehr... zögern Sie nicht, uns zu kontaktieren!"
        ],
        "en": [
          "The Haut-Pays Côte d'Opale Tourist Office offers electrically-assisted bike hire in Hucqueliers.\nFor half a day, a day, a weekend or more... don't hesitate to contact us!"
        ],
        "it": [
          "L'Ufficio del Turismo dell'Haut-Pays Côte d'Opale vi offre la possibilità di noleggiare biciclette a pedalata assistita a Hucqueliers.\nPer mezza giornata, una giornata, un weekend o più... non esitate a contattarci!"
        ],
        "fr": [
          "L'Office de Tourisme Haut-Pays Côte d'Opale vous propose la location de vélos à assistance électrique à Hucqueliers.\nPour une demi journée, une journée, un week-end ou plus... n'hésitez pas à nous contacter !"
        ],
        "es": [
          "La Oficina de Turismo de Haut-Pays Côte d'Opale le ofrece la posibilidad de alquilar bicicletas con asistencia eléctrica en Hucqueliers.\nPara media jornada, un día, un fin de semana o más... ¡no dude en ponerse en contacto con nosotros!"
        ],
        "nl": [
          "Het Office du Tourisme van de Haut-Pays Côte d'Opale biedt je de mogelijkheid om elektrische fietsen te huren in Hucqueliers.\nVoor een halve dag, een dag, een weekend of meer... aarzel niet om contact met ons op te nemen!"
        ]
      },
      "@type": [
        "Description"
      ],
