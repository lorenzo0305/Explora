      "@id": "https://data.datatourisme.fr/351bb2b3-646e-395e-b5d6-e83338e289b4",
      "dc:description": {
        "de": [
          "Besichtigung des Bauernhofs nur nach Vereinbarung für Schulklassen (vom Kindergarten bis zum Gymnasium), Gruppen, Freizeitzentren...\nKindergeburtstagsessen."
        ],
        "en": [
          "Visits to the farm by appointment only for schools (kindergarten to high school), groups, leisure centers...\nBirthday parties for children."
        ],
        "it": [
          "Visite alla fattoria su prenotazione per scolaresche (dalla scuola materna alla scuola secondaria), gruppi, centri ricreativi, ecc.\nFeste di compleanno per bambini."
        ],
        "fr": [
          "Visite de la ferme uniquement sur rendez-vous pour les scolaires (de la maternelle aux lycées), groupes, centres de loisirs...\nGouter d'anniversaires enfants."
        ],
        "es": [
          "Visitas a la granja con cita previa para escolares (desde preescolar hasta secundaria), grupos, centros de ocio, etc.\nFiestas de cumpleaños para niños."
        ],
        "nl": [
          "Bezoeken aan de boerderij op afspraak voor schoolkinderen (van kleuterschool tot middelbare school), groepen, vrijetijdscentra, enz.\nVerjaardagsfeestjes voor kinderen."
        ]
      },
