      "dc:description": {
        "de": [
          "Rüsten Sie sich mit einem Fernglas aus und entdecken Sie die verschiedenen Arten, die die Umgebung der Baie de Canche bevölkern.\nKostenlos."
        ],
        "en": [
          "Equipped with binoculars, set off to discover the different species that inhabit the Baie de Canche.\nFree admission."
        ],
        "it": [
          "Muniti di binocolo, partite alla scoperta delle diverse specie che popolano le coste della Baie de Canche.\nIngresso libero."
        ],
        "fr": [
          "Equipez de jumelles, partez à la découverte des différentes espèces qui peuplent les abords de la Baie de Canche.\nGratuit."
        ],
        "nl": [
          "Uitgerust met een verrekijker ga je op ontdekkingstocht naar de verschillende diersoorten die de oevers van de Baie de Canche bevolken.\nGratis toegang."
        ],
        "es": [
          "Equipado con prismáticos, salga a descubrir las diferentes especies que habitan las orillas de la bahía de Canche.\nEntrada gratuita."
        ]
      },
