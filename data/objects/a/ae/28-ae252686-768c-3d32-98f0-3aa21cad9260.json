  "rdfs:comment": {
    "de": [
      "Die Kirche von Huppy im Stil der Flamboyant-Gotik wurde nach 1945 restauriert und besitzt historisierende Glasfenster aus dem Jahr 1545, die Ende des 19."
    ],
    "en": [
      "In flamboyant Gothic style, restored after 1945, the church of Huppy presents historiated stained glass windows from 1545 restored at the end of the 19th century."
    ],
    "it": [
      "La chiesa di Huppy, in stile gotico fiammeggiante, è stata restaurata dopo il 1945 e presenta vetrate risalenti al 1545 e restaurate alla fine del XIX secolo."
    ],
    "fr": [
      "De style gothique flamboyant, restaurée après 1945, l'église de Huppy présente des vitraux historiés de 1545 restaurés à la fin du XIXe siècle."
    ],
    "es": [
      "La iglesia de Huppy es de estilo gótico flamígero y fue restaurada después de 1945. Tiene vidrieras que datan de 1545 y fueron restauradas a finales del siglo XIX."
    ],
    "nl": [
      "De kerk van Huppy is in flamboyante gotische stijl en werd na 1945 gerestaureerd. Ze heeft gebrandschilderde ramen uit 1545 en werd aan het eind van de 19e eeuw gerestaureerd."
    ]
  },
