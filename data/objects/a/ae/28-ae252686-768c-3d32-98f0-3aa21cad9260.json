  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0b6281af-1751-306c-bbc9-64293e78c0b7",
      "dc:description": {
        "de": [
          "Kirche St Sulpice XV-XVI Jahrhundert. Historische Glasfenster aus dem Jahr 1545. Gewölbter Chor aus Stein. Mit geschnitzten Schlüsseln. Kirchenschiff mit Holzgerüst in Form eines Schiffsrumpfes."
        ],
        "en": [
          "Church of St Sulpice XV-XVIth. Historic stained-glass windows dated 1545. Vaulted stone choir. Carved keys. Nave with a wooden ship's hull."
        ],
        "it": [
          "Chiesa di San Sulpizio XV-XVI secolo. Vetrate datate 1545. Coro a volta in pietra. Chiavi intagliate. Navata con struttura portante in legno."
        ],
        "fr": [
          "Eglise St Sulpice XVe-XVIe. Vitraux historiés datés de 1545. Choeur voûté en pierre. Clefs sculptées. Nef charpente bois en carène de bateau."
        ],
        "nl": [
          "Kerk van St Sulpice 15e-16e eeuw. Gebrandschilderde ramen uit 1545. Koor gewelfd in steen. Gesneden sleutels. Schip met houten romp."
        ],
        "es": [
          "Iglesia de San Sulpicio, siglo XV-XVI. Vidrieras fechadas en 1545. Coro abovedado en piedra. Llaves talladas. Nave con marco de casco de madera."
        ]
      },
