  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/53aa2408-24a1-3e79-ab36-79a9c12fa509",
      "dc:description": {
        "de": [
          "Reparieren oder kaufen Sie Ihr Fahrrad oder Zubehör, bei Intersport im Einkaufszentrum Val d'Halatte!\n\nBereitstellung von hydroalkoholischem Gel, Beschilderung der Ein- und Ausgangstüren"
        ],
        "en": [
          "Repair or buy your bike or accessories at Intersport in the Val d'Halatte shopping centre!\n\nProvision of hydroalcoholic gel, signalling of entry and exit doors"
        ],
        "it": [
          "Riparate o acquistate la vostra bicicletta o i vostri accessori presso Intersport nel centro commerciale Val d'Halatte!\n\nGel idroalcolico a disposizione, segnaletica delle porte di ingresso e di uscita"
        ],
        "fr": [
          "Réparez ou achetez votre vélo ou des accessoires, à Intersport au centre commercial du val d'Halatte !\n\nMise à disposition de gel hydroalcoolique, signalisation des portes entrée et sortie"
        ],
        "nl": [
          "Repareer of koop uw fiets of accessoires bij Intersport in het winkelcentrum Val d'Halatte!\n\nHydro-alcoholische gel beschikbaar, bewegwijzering van in- en uitgangsdeuren"
        ],
        "es": [
          "Repare o compre su bicicleta o accesorios en Intersport, en el centro comercial Val d'Halatte\n\nGel hidroalcohólico disponible, señalización de las puertas de entrada y salida"
        ]
      },
