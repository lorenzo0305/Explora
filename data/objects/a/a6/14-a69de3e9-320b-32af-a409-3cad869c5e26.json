  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/783be5ba-9940-389b-8323-ffaf2c1f69b6",
      "dc:description": {
        "de": [
          "Start: Esplanade de la Citadelle in Montreuil-sur-mer\n\n3 Stunden | 10km\n\nEin Spaziergang entlang der Canche und am Fuße der Festungsmauern. Wandern Sie im Rhythmus des friedlich dahinfließenden Wassers und bewundern Sie die Schönheit der hohen Mauern aus Backstein, Sandstein, Feuerstein und weißer Kreide."
        ],
        "en": [
          "Departure: Esplanade de la Citadelle de Montreuil-sur-mer\n\n3 h | 10km\n\nA walk along the river Canche and at the foot of the ramparts. Walk to the rhythm of the peaceful flowing water and admire the beauty of the high walls of brick, sandstone, flint and white chalk."
        ],
        "it": [
          "Partenza: Esplanade de la Citadelle, Montreuil-sur-mer\n\n3 h | 10 km\n\nUna passeggiata lungo la Canche e ai piedi dei bastioni. Camminate al ritmo del tranquillo scorrere dell'acqua e ammirate la bellezza delle alte mura in mattoni, arenaria, selce e gesso bianco."
        ],
        "fr": [
          "Départ: Esplanade de la Citadelle de Montreuil-sur-mer\n\n3 h | 10km\n\nUne balade le long de la Canche et au pied des remparts. Marchez au rythme de l’eau paisible qui s’écoule et admirez la beauté des hautes murailles en brique, grès, silex et craie blanche."
        ],
        "nl": [
          "Start: Esplanade de la Citadelle, Montreuil-sur-mer\n\n3 uur | 10 km\n\nEen wandeling langs de Canche en aan de voet van de vestingmuren. Wandel op het ritme van het vredige stromende water en bewonder de schoonheid van de hoge muren van baksteen, zandsteen, vuursteen en wit krijt."
        ],
        "es": [
          "Salida: Esplanade de la Citadelle, Montreuil-sur-mer\n\n3 h | 10km\n\nUn paseo a lo largo del Canche y al pie de las murallas. Camine al ritmo del tranquilo fluir del agua y admire la belleza de las altas murallas de ladrillo, arenisca, sílex y tiza blanca."
        ]
      },
