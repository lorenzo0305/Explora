  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ee9c8cb-bd90-3405-9317-8a32d4d8c222",
      "dc:description": {
        "de": [
          "Ensemble von 62 ha. Sportlicher Pfad im Bois Magneux. Waldpfad im Bois de Fau Timon mit einigen Aussichtspunkten auf das Noye-Tal. Picknickplätze, Abri-Preau (Bois Magneux)."
        ],
        "en": [
          "Set of 62 ha. Sports trail in the Bois Magneux. Woodland path in the wood of Fau Timon with some viewpoints on the Noye valley. Picnic areas, shelter-prey (Bois Magneux)."
        ],
        "it": [
          "Un complesso di 62 ettari. Percorso sportivo nel Bois Magneux. Sentiero nel bosco del Bois de Fau Timon con alcuni punti di vista sulla valle della Noye. Aree pic-nic, pozzo-rifugio (Bois Magneux)."
        ],
        "fr": [
          "Ensemble de 62 ha. Sentier sportif dans le Bois Magneux. Sentier sylvestre dans le bois de Fau Timon avec quelques points de vue sur la vallée de la Noye. Aires de pique-nique, abri-préau (Bois Magneux)."
        ],
        "es": [
          "Un complejo de 62 hectáreas. Sendero deportivo en el Bois Magneux. Camino forestal en el Bois de Fau Timon con algunas vistas sobre el valle de Noye. Áreas de picnic, refugio-pozo (Bois Magneux)."
        ],
        "nl": [
          "Een complex van 62 hectare. Sportief parcours in het Bois Magneux. Bosweg in het Bois de Fau Timon met enkele uitzichtpunten op de vallei van de Noye. Picknickplaatsen, schuilplaats (Bois Magneux)."
        ]
      },
