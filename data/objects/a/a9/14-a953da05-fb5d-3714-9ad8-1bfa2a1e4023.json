      "@id": "https://data.datatourisme.fr/af0d16b7-3c51-3aef-b222-8c9821622c2f",
      "dc:description": {
        "de": [
          "Hier finden Sie unsere Produkte aus biologischem Anbau: Apfelsaft, Limonaden, Suppen, Marmeladen und unsere handwerkliche Schokoladenproduktion: Tafeln, Fritten, Bonbons."
        ],
        "en": [
          "Discover our organic products: apple juice, lemonades, soups, jams and our artisanal chocolate production: bars, chips, candies."
        ],
        "it": [
          "Scoprite i nostri prodotti biologici: succhi di mela, limonate, zuppe, marmellate e la nostra produzione artigianale di cioccolato: tavolette, patatine, dolci."
        ],
        "fr": [
          "Retrouvez nos produits issus de l'agriculture biologique : jus de pomme, citronnades, soupes, confitures et notre production artisanale de chocolat : tablettes, fritures, bonbons."
        ],
        "nl": [
          "Ontdek onze biologische producten: appelsap, limonades, soepen, jam en onze ambachtelijke chocoladeproductie: repen, chips, snoepjes."
        ],
        "es": [
          "Descubra nuestros productos ecológicos: zumo de manzana, limonadas, sopas, mermeladas y nuestra producción artesanal de chocolate: tabletas, patatas fritas, dulces."
        ]
      },
