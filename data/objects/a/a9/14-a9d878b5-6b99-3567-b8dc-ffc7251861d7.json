  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c8974b8c-f267-31ce-b7ec-9162b1b22de0",
      "dc:description": {
        "de": [
          "Le Touquet empfängt die Champions im Strandsegeln!\nErleben Sie ein einzigartiges Spektakel: Die besten Piloten treten an den Stränden von Le Touquet bei den Grand Prix Classe Blokart und 7 gegeneinander an."
        ],
        "en": [
          "Le Touquet welcomes sand yacht champions!\nEnjoy a unique show: the best pilots compete on the beaches of Le Touquet in the Blokart and 7 Class Grand Prix."
        ],
        "it": [
          "Le Touquet accoglie i campioni di sand yacht!\nPartecipate a uno spettacolo unico: i migliori piloti si sfidano sulle spiagge di Le Touquet durante il Gran Premio Blokart e 7 Classi."
        ],
        "fr": [
          "Le Touquet accueille les champions de char à voile !\nAssistez à un spectacle unique : les meilleurs pilotes s'affrontent sur les plages du Touquet lors des Grand Prix Classe Blokart et 7."
        ],
        "es": [
          "¡Le Touquet acoge a los campeones de vela de arena!\nParticipe en un espectáculo único: los mejores pilotos se baten en las playas de Le Touquet durante el Gran Premio de Blokart y de 7 clases."
        ],
        "nl": [
          "Le Touquet verwelkomt de zandzeilkampioenen!\nNeem deel aan een uniek spektakel: de beste piloten gaan de strijd aan op de stranden van Le Touquet tijdens de Blokart en 7 Class Grand Prix."
        ]
      },
