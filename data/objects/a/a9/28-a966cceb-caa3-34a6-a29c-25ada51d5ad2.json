      "dc:description": {
        "de": [
          "Traditionelle und familiäre Küche, hausgemacht und mit frischen Produkten. Sie können auch ein Aperitifbrettchen teilen und dabei ein gutes Glas genießen."
        ],
        "en": [
          "Traditional, homemade home cooking with fresh products. You can also share an aperitif board while enjoying a good drink."
        ],
        "it": [
          "Cucina tradizionale e familiare a base di prodotti freschi. È anche possibile condividere un aperitivo a tavola con un buon drink."
        ],
        "fr": [
          "Cuisine traditionnelle et familiale faite maison et avec des produits frais. Vous pourrez aussi partager une planches apéritif en savourant un bon verre."
        ],
        "nl": [
          "Traditionele en familiale keuken met verse producten. U kunt ook een aperitiefplankje delen met een lekker drankje."
        ],
        "es": [
          "Cocina tradicional y familiar elaborada con productos frescos. También puede compartir una tabla de aperitivos con una buena bebida."
        ]
      },
