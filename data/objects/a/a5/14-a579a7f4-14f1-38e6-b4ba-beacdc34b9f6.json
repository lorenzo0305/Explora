  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/12e9f5a6-976c-330a-b147-343ef9b3496d",
      "dc:description": {
        "de": [
          "Bar am Jachthafen, große Terrasse mit schönem Ausblick, alles in einem Geist der Geselligkeit und Einfachheit.\nAperitifplatten, Tapas, Cocktails.\nDart und Tischfußball in der Saison"
        ],
        "en": [
          "Bar located on the marina, large terrace with a lovely view, all in a spirit of conviviality and simplicity.\nAppetizers, tapas, cocktails.\nDartboard and table soccer in season"
        ],
        "it": [
          "Bar situato sul porto turistico, ampia terrazza con vista incantevole, il tutto in uno spirito di convivialità e semplicità.\nAperitivi, tapas, cocktail.\nBiliardo e calcio balilla in stagione"
        ],
        "fr": [
          "Bar situé sur le port de plaisance, grande terrasse avec une jolie vue, le tout dans un esprit de convivialité et de simplicité.\nPlanches apéritives, tapas, cocktails.\nFléchette et baby foot en saison"
        ],
        "es": [
          "Bar situado en el puerto deportivo, gran terraza con una hermosa vista, todo ello en un espíritu de convivencia y sencillez.\nAperitivos, tapas, cócteles.\nDiana y futbolín en temporada"
        ],
        "nl": [
          "Bar gelegen aan de jachthaven, groot terras met prachtig uitzicht, alles in een sfeer van gezelligheid en eenvoud.\nAperitief, tapas, cocktails.\nDartbord en tafelvoetbal in het seizoen"
        ]
      },
      "@type": [
        "Description"
      ],
