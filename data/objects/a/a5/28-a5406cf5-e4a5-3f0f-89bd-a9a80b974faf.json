  "rdfs:comment": {
    "de": [
      "Ländliche Einrichtung, Brasserie mit traditionellen und hausgemachten Gerichten. Innenraum und Außenterrasse, um die Sonne zu genießen. Verkauf von Sandwiches, Gerichten zum Mitnehmen und lokalen Produkten in Zusammenarbeit mit Erzeugern aus der Region.\nJeden Mittwoch steht der Burger des Monats auf der Speisekarte!"
    ],
    "en": [
      "Rural establishment, brasserie with traditional and homemade dishes. Indoor room and outdoor terrace to enjoy the sun. Sandwiches, takeaways and local products sold in partnership with local producers.\nEvery Wednesday, burger of the month on the menu!"
    ],
    "it": [
      "Locale rurale, brasserie con piatti tradizionali e fatti in casa. Sala interna e terrazza esterna per godersi il sole. Panini, piatti da asporto e prodotti locali venduti in collaborazione con i produttori locali.\nOgni mercoledì, il menu con l'hamburger del mese!"
    ],
    "fr": [
      "Établissement rural, brasserie avec plat traditionnel et fait maison. Salle intérieure et terrasse extérieur pour profiter du soleil. Vente de sandwichs, plats à emporter, et produits locaux en partenariat avec les producteurs de la région. \nTous les mercredis, le burger du mois au menu !"
    ],
    "nl": [
      "Landelijk etablissement, brasserie met traditionele en huisgemaakte gerechten. Binnenzaal en buitenterras om van de zon te genieten. Broodjes, meeneemgerechten en streekproducten verkocht in samenwerking met lokale producenten.\nElke woensdag de hamburger van de maand op het menu!"
    ],
    "es": [
      "Establecimiento rural, brasería con platos tradicionales y caseros. Salón interior y terraza exterior para disfrutar del sol. Venta de bocadillos, comida para llevar y productos locales en colaboración con productores locales.\nTodos los miércoles, ¡la hamburguesa del mes en el menú!"
    ]
  },
  "rdfs:label": {
