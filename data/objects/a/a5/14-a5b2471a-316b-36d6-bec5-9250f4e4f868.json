  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f3720e3a-25ed-3957-9c50-c7e6477ef969",
      "dc:description": {
        "de": [
          "Rando cyclotouriste (Radtourismus)\n31. Ausgabe\nMit dem Club Cyclo d?Oye-Plage können Sie sich auf Ihr Fahrrad schwingen und die Straßen der Plaine Maritime durchqueren.\n4 Strecken: 85, 65, 45 und 20 km\nPreis: 5? (85 und 65 km) und 4? (45 und 20 km)"
        ],
        "en": [
          "Cycle touring\n31st edition\nJoin the Club Cyclo d'Oye-Plage on a bike tour of the Plaine Maritime.\n4 routes: 85, 65, 45 and 20 km\nPrice: 5? (85 and 65 km) and 4? (45 and 20 km)"
        ],
        "it": [
          "Cicloturismo\n31a edizione\nUnitevi al Club Cyclo d'Oye-Plage e salite in sella alla vostra bicicletta per esplorare le strade della Plaine Maritime.\n4 percorsi: 85, 65, 45 e 20 km\nPrezzo: 5? (85 e 65 km) e 4? (45 e 20 km)"
        ],
        "fr": [
          "Rando cyclotouriste\n31ème édition\nAvec le Club Cyclo d’Oye-Plage, enfourchez votre vélo pour parcourir les routes de la Plaine Maritime.\n4 parcours : 85, 65, 45 et 20 km\nTarif : 5€ (85 et 65 km) et 4€ (45 et 20 km)"
        ],
        "es": [
          "Vuelta ciclista\n31ª edición\nÚnete al Club Cyclo d'Oye-Plage y súbete a tu bicicleta para explorar las carreteras de la Plaine Maritime.\n4 rutas: 85, 65, 45 y 20 km\nPrecio: 5? (85 y 65 km) y 4? (45 y 20 km)"
        ],
        "nl": [
          "Fietstocht\n31e editie\nSluit je aan bij de Club Cyclo d'Oye-Plage en stap op de fiets om de wegen van de Plaine Maritime te verkennen.\n4 routes: 85, 65, 45 en 20 km\nPrijs: 5? (85 en 65 km) en 4? (45 en 20 km)"
        ]
      },
