  "rdfs:comment": {
    "de": [
      "Im T'CHIOT ZINC finden Sie ein ausgezeichnetes Preis-Leistungs-Verhältnis, eine große Auswahl an Spezialitäten aus der Picardie und Spanferkel. Wir empfangen Sie in einer freundlichen Atmosphäre. Für Gruppen und Familien stehen mehrere Räume zur Verfügung."
    ],
    "en": [
      "At T'CHIOT ZINC, you will find an excellent value for money, a large choice of Picardy specialities and suckling pig. We welcome you in a friendly atmosphere, several rooms are available for groups and families."
    ],
    "it": [
      "Al T'CHIOT ZINC troverete un ottimo rapporto qualità-prezzo, un'ampia scelta di specialità piccarde e il maialino da latte. Vi accogliamo in un'atmosfera amichevole, sono disponibili diverse camere per gruppi e famiglie."
    ],
    "fr": [
      "Au T'CHIOT ZINC, vous trouverez un excellent rapport qualité- prix, un grand choix de spécialités picardes et du cochon de lait. Nous vous accueillons dans une ambiance sympathique, plusieurs salles sont mises à disposition pour les groupes et les familles."
    ],
    "es": [
      "En T'CHIOT ZINC, encontrará una excelente relación calidad-precio, una amplia gama de especialidades de Picardía y cochinillo. Le damos la bienvenida en un ambiente agradable, hay varias habitaciones disponibles para grupos y familias."
    ],
    "nl": [
      "Bij T'CHIOT ZINC vindt u een uitstekende prijs-kwaliteitverhouding, een ruime keuze aan Picardische specialiteiten en speenvarken. Wij ontvangen u in een vriendelijke sfeer, verschillende kamers zijn beschikbaar voor groepen en families."
    ]
  },
  "rdfs:label": {
