  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f9d89811-7c3e-3381-8d12-15ef28215e30",
      "dc:description": {
        "de": [
          "Traditionelles und gemütliches Restaurant.\nDie Speisekarte wird aus frischen, lokalen Produkten zusammengestellt, die vollständig vor Ort verarbeitet werden.\n\nService am Mittag von 12:00 bis 13:30 Uhr\nService am Abend von 19.00 bis 21.30 Uhr\nDienstag-, Mittwoch- und Sonntagabend geschlossen"
        ],
        "en": [
          "Traditional, friendly restaurant.\nThe menu is based on fresh, local produce, prepared entirely on site.\n\nLunchtime service from 12:00 to 13:30\nEvening service from 7:00 pm to 9:30 pm\nClosed Tuesday, Wednesday and Sunday evenings"
        ],
        "it": [
          "Ristorante tradizionale e accogliente.\nIl menu si basa su prodotti freschi e locali, preparati interamente in loco.\n\nServizio a pranzo dalle 12:00 alle 13:30\nServizio serale dalle 19:00 alle 21:30\nChiuso martedì, mercoledì e domenica sera"
        ],
        "fr": [
          "Restaurant traditionnel et convivial. \nLa carte est élaborée à partir de produits frais, locaux, travaillés entièrement sur place. \n\nService le midi de 12h00 à 13h30\nService le soir de 19h00 à 21h30\nFermé le mardi, mercredi et dimanche soir"
        ],
        "nl": [
          "Traditioneel, vriendelijk restaurant.\nHet menu is gebaseerd op verse, lokale producten, volledig ter plaatse bereid.\n\nLunchtijd van 12.00 tot 13.30 uur\nAvondservice van 19:00 tot 21:30\nGesloten op dinsdag-, woensdag- en zondagavond"
        ],
        "es": [
          "Restaurante tradicional y acogedor.\nEl menú se basa en productos frescos y locales, preparados íntegramente in situ.\n\nServicio de almuerzo de 12:00 a 13:30\nServicio nocturno de 19:00 a 21:30\nCerrado los martes, miércoles y domingos por la noche"
        ]
      },
      "@type": [
        "Description"
