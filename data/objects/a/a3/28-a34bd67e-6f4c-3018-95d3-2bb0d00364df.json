      "dc:description": {
        "de": [
          "Der Parc de l'arbre à l'oiseau liegt im Stadtteil Saint-Waast und bietet einen Fitnessparcours und einen Spaziergang um den Teich"
        ],
        "en": [
          "Located in the Saint-Waast district, the Tree to Bird Park offers a fitness trail and a walk around the pond"
        ],
        "it": [
          "Situato nel quartiere di Saint-Waast, il parco dell'arbre à l'oiseau offre un percorso salute e una passeggiata intorno allo stagno"
        ],
        "fr": [
          "Situé à dans le quartier Saint-Waast, le parc de l'arbre à l'oiseau offre un parcours de santé et une promenade autour de l'étang"
        ],
        "es": [
          "Situado en el barrio de Saint-Waast, el parque del \"arbre à l'oiseau\" ofrece un curso de salud y un paseo alrededor del estanque"
        ],
        "nl": [
          "In de wijk Saint-Waast biedt het park van de \"arbre à l'oiseau\" een gezondheidsparcours en een wandeling rond de vijver"
        ]
      },
