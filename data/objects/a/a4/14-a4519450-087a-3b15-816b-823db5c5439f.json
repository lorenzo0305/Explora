  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/caadd063-3a3d-36a2-b028-c62fa87b4cb0",
      "dc:description": {
        "de": [
          "Informationen :\n\nMenü :\nBesuchen Sie die Website oder die Facebook-Seite, um die Karte zu sehen\n\nÖffnungszeiten:\nSonntag bis Donnerstag: 18:00 - 21:30 Uhr\nFreitag bis Samstag: 18:00 - 22:00 Uhr\n \n Bestellung:\nBestellungen können unter der Nummer 03 21 21 25 39 aufgegeben werden\n\n \n Abholung:\nZum Mitnehmen während der Öffnungszeiten der Pizzeria\n\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit the website or Facebook page to see the map\n\nOpening days :\nSunday to Thursday: 6pm - 9:30pm\nFriday to Saturday: 6pm - 10pm\n \n Ordering :\nYou can order by calling 03 21 21 25 39\n\n \n Pick-up:\nTakeaway during pizzeria opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nConsultare il sito web o la pagina Facebook per la mappa\n\nGiorni di apertura :\nDa domenica a giovedì: 18.00 - 21.30\nDa venerdì a sabato: dalle 18.00 alle 22.00\n \n Come ordinare :\nÈ possibile ordinare chiamando il numero 03 21 21 25 39\n\n \n Ritiro:\nDa asporto durante gli orari di apertura della pizzeria\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : \nConsultez le site internet ou  la page Facebook afin de connaître la carte\n\nJours d'ouverture :\nDu dimanche au jeudi: 18h - 21h30\nDu vendredi au samedi: 18h - 22h\n \n Commande : \nPossibilité de commander en appelant au 03 21 21 25 39\n\n \n Retrait :\nÀ emporter aux horaires d'ouverture de la pizzeria\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nCheck de website of Facebook pagina voor de kaart\n\nOpeningsdagen :\nZondag tot donderdag: 18u - 21u30\nVrijdag tot zaterdag: 18u - 22u\n \n Hoe te bestellen :\nU kunt bestellen door te bellen naar 03 21 21 25 39\n\n \n Afhalen:\nAfhalen tijdens de openingstijden van de pizzeria\n\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nConsulte el mapa en el sitio web o en la página de Facebook\n\nDías de apertura :\nDe domingo a jueves: de 18.00 h. a 21.30 h\nDe viernes a sábado: de 18:00 a 22:00\n \n Cómo hacer un pedido :\nPuede hacer su pedido llamando al 03 21 21 25 39\n\n \n Recogida:\nPara llevar durante el horario de apertura de la pizzería\n\n "
        ]
      },
