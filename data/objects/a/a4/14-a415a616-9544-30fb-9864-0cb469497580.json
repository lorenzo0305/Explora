  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ba69fc61-70d4-3551-8ed7-555d869e7fc0",
      "dc:description": {
        "de": [
          "Das Restaurant Le Mississipi befindet sich in Maninghem-au-mont. Es bietet Ihnen eine traditionelle Küche in einer ruhigen und erholsamen Umgebung. Service plat à emporter, Möglichkeit für Empfänge, Geschäftsessen... Diese Einrichtung verfügt auch über ein Hotel mit einer Kapazität von 5 Zimmern."
        ],
        "en": [
          "The Mississippi restaurant is located in Maninghem-au-mont. It offers traditional cuisine in a calm and relaxing setting. Take away service, possibility of receptions, business meals... This establishment also has a hotel with a capacity of 5 rooms."
        ],
        "it": [
          "Il ristorante Le Mississipi si trova a Maninghem-au-mont. Offre una cucina tradizionale in un ambiente tranquillo e rilassante. Servizio d'asporto, possibilità di ricevimenti, pasti di lavoro... Questa struttura dispone anche di un hotel con una capacità di 5 camere."
        ],
        "fr": [
          "Le restaurant Le Mississipi se situe à Maninghem-au-mont. Elle vous propose une cuisine traditionnelle dans un cadre calme et reposant. Service plat à emporter, possibilité de réceptions, repas d'affaires... Cet établissement dispose également d'un hôtel avec une capacité de 5 chambres."
        ],
        "nl": [
          "Het restaurant Le Mississipi ligt in Maninghem-au-mont. Het biedt traditionele gerechten in een rustige en ontspannende omgeving. Afhaalservice, mogelijkheid tot recepties, zakendiners... Dit etablissement heeft ook een hotel met een capaciteit van 5 kamers."
        ],
        "es": [
          "El restaurante Le Mississipi se encuentra en Maninghem-au-mont. Ofrece cocina tradicional en un entorno tranquilo y relajante. Servicio de comida para llevar, posibilidad de recepciones, comidas de negocios... Este establecimiento también dispone de un hotel con capacidad para 5 habitaciones."
        ]
      },
      "@type": [
        "Description"
