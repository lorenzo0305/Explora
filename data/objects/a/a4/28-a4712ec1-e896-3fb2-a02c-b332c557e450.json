  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1d667da3-0a08-3d1e-9f6b-2392c7037138",
      "dc:description": {
        "de": [
          "Erdbeer- und Gemüsebauer: traditioneller Anbau im Freiland... reife Früchte mit Geschmack, das ist bei uns zu Hause!\nLaden auf dem Bauernhof. Freier Garten zum Selbstpflücken von Erdbeeren. Gemüseautomat 7 Tage die Woche."
        ],
        "en": [
          "Strawberry and vegetable grower: traditional open-field cultivation... ripe fruit with taste, it's at home!\nShop at the farm. Free garden picking strawberries. Automatic vegetable vending machine 7 days a week."
        ],
        "it": [
          "Produttore di fragole e ortaggi: coltivazione tradizionale in campo aperto... frutta matura e gustosa, questa è la nostra casa!\nFare la spesa in fattoria. Giardino di fragole auto-raccolte. Distributore automatico di verdure 7 giorni su 7."
        ],
        "fr": [
          "Producteur de fraises et de légumes : culture traditionnelle en plein champ... des fruits mûrs avec du goût, c'est chez nous !\nMagasin à la ferme. Jardin libre cueillette de fraises. Distributeur automatique de légumes 7j/7."
        ],
        "es": [
          "Productor de fresas y hortalizas: cultivo tradicional en campo abierto... fruta madura con sabor, ¡esa es nuestra casa!\nCompra en la granja. Huerto de fresas de cosecha propia. Máquina automática de venta de verduras 7 días a la semana."
        ],
        "nl": [
          "Aardbeien- en groenteteler: traditionele vollegrondsteelt... rijp fruit met smaak, dat is ons thuis!\nWinkelen op de boerderij. Zelfplukkende aardbeientuin. Automatische groenteautomaat 7 dagen per week."
        ]
      },
      "@type": [
        "Description"
      ],
