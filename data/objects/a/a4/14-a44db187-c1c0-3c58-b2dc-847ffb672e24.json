  "rdfs:comment": {
    "de": [
      "Die Possédés d'Illfurth, halb fantastisches Märchen, halb zeitgenössische Fabel, erforscht das Thema der Besessenheit und macht die Resilienz zum neuen Exorzismus unserer zeitgenössischen Welten."
    ],
    "en": [
      "Part fantasy tale, part contemporary fable, Les Possédés d?Illfurth explores the theme of possession, making resilience the new exorcism of our contemporary worlds."
    ],
    "it": [
      "In parte racconto fantastico, in parte favola contemporanea, Les Possédés d'Illfurth esplora il tema della possessione e fa della resilienza il nuovo esorcismo dei nostri mondi contemporanei."
    ],
    "fr": [
      "Mi-conte fantastique, mi-fable contemporaine, Les Possédés d’Illfurth explore le thème de la possession et fait de la résilience le nouvel exorcisme de nos mondes contemporains."
    ],
    "es": [
      "En parte cuento fantástico, en parte fábula contemporánea, Les Possédés d'Illfurth explora el tema de la posesión y hace de la resiliencia el nuevo exorcismo de nuestros mundos contemporáneos."
    ],
    "nl": [
      "Deels fantasieverhaal, deels hedendaagse fabel, Les Possédés d?Illfurth verkent het thema van bezetenheid en maakt veerkracht tot het nieuwe exorcisme van onze hedendaagse werelden."
    ]
  },
