  "rdfs:comment": {
    "de": [
      "Nathalie Seroux hat einen Masterabschluss in Fotografie und zeitgenössischer Kunst. Als Fotografin und Autorin realisiert sie Reportagen und lässt starke und sensible Bilder entstehen. Beim Verlag La Martinière Jeunesse ist sie die Autorin der Kollektion \"Mon premier imagier photo\". Erleben Sie mit ihr einen spielerischen Familienworkshop!"
    ],
    "en": [
      "Nathalie Seroux holds a master's degree in photography and contemporary art. As an artist-photographer, she creates powerful, sensitive images. Published by La Martinière Jeunesse, she is the author of the \"Mon premier imagier photo\" collection. Join her for a fun family workshop!"
    ],
    "it": [
      "Nathalie Seroux ha conseguito un master in fotografia e arte contemporanea. Come fotografa-autrice, crea immagini potenti e sensibili. Pubblicata da La Martinière Jeunesse, è autrice della raccolta \"Mon premier imagier photo\". Unitevi a lei per un divertente workshop per famiglie!"
    ],
    "fr": [
      "Nathalie Seroux est titulaire d'un master de photographie et art contemporain. Photographe-autrice, elle réalise des reportages et fait naître des images fortes et sensibles. Aux éditions de La Martinière Jeunesse, elle est l'autrice de la collection \"Mon premier imagier photo\". Vivez un atelier famille ludique en sa compagnie !"
    ],
    "nl": [
      "Nathalie Seroux heeft een master in fotografie en hedendaagse kunst. Als fotograaf-auteur creëert ze krachtige en gevoelige beelden. Ze wordt uitgegeven door La Martinière Jeunesse en is de auteur van de collectie \"Mon premier imagier photo\". Doe met haar mee aan een leuke familieworkshop!"
    ],
    "es": [
      "Nathalie Seroux es licenciada en fotografía y arte contemporáneo. Como fotógrafa-autora, crea imágenes potentes y sensibles. Publicada por La Martinière Jeunesse, es autora de la colección \"Mon premier imagier photo\". Únete a ella en un divertido taller familiar"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Mon premier imagier photo, de la médiathèque !"
    ]
  },
