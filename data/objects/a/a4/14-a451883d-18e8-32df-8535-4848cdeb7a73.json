  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6db03362-7c9a-3cb3-ae47-fb0258198b14",
      "dc:description": {
        "de": [
          "Sportverein mit dem Ziel, die Praxis des Feld- und Hallenhockeys zu entwickeln, ab 6 Jahren, Anfänger oder Fortgeschrittene, gemischt.\n\nMittwochnachmittag und Samstagvormittag."
        ],
        "en": [
          "Sports association aiming to develop the practice of field field hockey and floor field hockey, from 6 years old, beginners or advanced, mixed.\n\nWednesday afternoons and Saturday mornings."
        ],
        "it": [
          "Un'associazione sportiva il cui obiettivo è sviluppare l'hockey e l'hockey su pista per principianti e avanzati dai 6 anni in su.\n\nMercoledì pomeriggio e sabato mattina."
        ],
        "fr": [
          "Association sportive ayant pour but de développer la pratique du hockey sur gazon et du hockey en salle, à partir de 6 ans, débutants ou confirmés, mixte.\n\nMercredi après-midi et samedi matin."
        ],
        "nl": [
          "Een sportvereniging met als doel het ontwikkelen van hockey en floorhockey voor beginners en gevorderden vanaf 6 jaar.\n\nWoensdagmiddag en zaterdagochtend."
        ],
        "es": [
          "Asociación deportiva cuyo objetivo es desarrollar el hockey y el hockey sobre hierba para jugadores principiantes y avanzados a partir de 6 años.\n\nMiércoles por la tarde y sábados por la mañana."
        ]
      },
