      "dc:description": {
        "de": [
          "Das kommunale Sportamt von Saint-Josse organisiert Pétanque-Wettbewerbe. Außerdem eine Ausstellung und ein jährliches Lotto."
        ],
        "en": [
          "The Saint-Josse municipal sports office organizes pétanque competitions. There's also an annual exhibition and bingo."
        ],
        "it": [
          "L'ufficio sportivo comunale di Saint-Josse organizza gare di pétanque. Organizza anche una mostra e una tombola annuale."
        ],
        "fr": [
          "L'office municipale des sports de Saint-Josse organise des concours de pétanque. Et également une exposition et un loto annuel."
        ],
        "es": [
          "La oficina municipal de deportes de Saint-Josse organiza competiciones de petanca. También organiza una exposición y un bingo anual."
        ],
        "nl": [
          "Het gemeentelijk sportbureau van Sint-Joost organiseert petanquewedstrijden. Het organiseert ook een tentoonstelling en een jaarlijkse bingo."
        ]
