  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/acd56162-03c6-33cd-839d-79b93c5bdee3",
      "dc:description": {
        "de": [
          "Pension und Reitzentrum mit dem Gütesiegel der Fédération Française d'Equitation. Wir bieten das ganze Jahr über Kurse und Lehrgänge für alle Niveaus sowie Ausritte an (Mindestniveau G3 erforderlich). Nach vorheriger Reservierung.\nReiterhof / Equestrian farm / Reitbauernhof / Ruiterboerderij"
        ],
        "en": [
          "Boarding and riding center accredited by the French Equestrian Federation. We offer lessons and courses for all levels all year round, as well as rides (minimum G3 level required). Reservations required.\nEquestrian farm / Reitbauernhof / Ruiterboerderij"
        ],
        "it": [
          "Pensione e centro equestre accreditato dalla Fédération Française d'Equitation. Offriamo tutto l'anno lezioni e corsi a tutti i livelli, nonché passeggiate (è richiesto un livello minimo di G3). È necessaria la prenotazione.\nFattoria equestre / Reitbauernhof / Ruiterboerderij"
        ],
        "fr": [
          "Pension et centre équestre labellisé Fédération Française d'Equitation. Nous dispensons des cours et stages tous niveaux toute l'année, ainsi que des balades (niveau G3 minimum requis). Sur réservation.\nEquestrian farm / Reitbauernhof / Ruiterboerderij"
        ],
        "nl": [
          "Pension en manege erkend door de Fédération Française d'Equitation. We bieden het hele jaar door lessen en cursussen op alle niveaus, evenals ritten (minimaal G3-niveau vereist). Reserveren verplicht.\nPaardenboerderij / Reitbauernhof / Ruiterboerderij"
        ],
        "es": [
          "Pensión y centro ecuestre acreditado por la Fédération Française d'Equitation. Ofrecemos clases y cursos de todos los niveles durante todo el año, así como paseos (se requiere un nivel mínimo de G3). Es necesario reservar.\nGranja ecuestre / Reitbauernhof / Ruiterboerderij"
        ]
      },
