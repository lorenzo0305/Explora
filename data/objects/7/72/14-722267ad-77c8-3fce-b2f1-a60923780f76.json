  "rdfs:comment": {
    "de": [
      "Erkunden Sie mit einem Fremdenführer drei der wichtigsten Themen des Reiseziels rund um die wichtigsten Stätten, die Teil des Welterbes sind. Ein 45-minütiger Rundgang, um die Geschichte dieses Gebiets zu verstehen, das sich in einem ständigen Erneuerungsprozess befindet."
    ],
    "en": [
      "Explore three of the destination?s key themes with a guide, based around the major sites that are part of the World Heritage listing. A 45-minute tour to understand the history of this region in perpetual renaissance."
    ],
    "it": [
      "Con una guida, esplorate tre temi chiave della destinazione intorno ai principali siti inclusi nella Lista del Patrimonio Mondiale. Un tour di 45 minuti per comprendere la storia di questa regione in perenne rinascita."
    ],
    "fr": [
      "Explorez avec un guide trois thématiques phares de la destination autour de sites majeurs faisant partie de l’inscription au Patrimoine mondial. Une visite de 45 min pour comprendre l’histoire de ce territoire en perpétuelle renaissance."
    ],
    "nl": [
      "Verken met een gids drie van de belangrijkste thema's van de bestemming rond de belangrijkste sites die op de Werelderfgoedlijst staan. Een rondleiding van 45 minuten om de geschiedenis van deze regio in eeuwige renaissance te begrijpen."
    ],
    "es": [
      "Con un guía, explore tres de los temas clave del destino en torno a los principales lugares inscritos en la Lista del Patrimonio Mundial. Un recorrido de 45 minutos que le ayudará a comprender la historia de esta región en perpetuo renacimiento."
    ]
  },
  "rdfs:label": {
