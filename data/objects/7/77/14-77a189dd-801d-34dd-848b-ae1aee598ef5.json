  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7c252a95-aa41-3cce-bec9-9432e18f384c",
      "dc:description": {
        "de": [
          "Die Kleinkindbetreuung organisiert einen Workshop \"sensorische Manipulation\".\nSie ermöglicht es Kindern, die Welt durch den Tastsinn, einen ihrer grundlegendsten Sinne, zu erforschen und zu verstehen."
        ],
        "en": [
          "The Early Childhood Department is organizing a \"sensory manipulation\" workshop.\nIt enables children to explore and understand the world through touch, one of their most fundamental senses."
        ],
        "it": [
          "Il Servizio per la prima infanzia organizza un laboratorio di \"manipolazione sensoriale\".\nQuesto permette ai bambini di esplorare e comprendere il mondo attraverso il tatto, uno dei loro sensi fondamentali."
        ],
        "fr": [
          "Le service petite enfance organise un atelier \"manipulation sensorielle\".\nElle permet aux enfants d'explorer et de comprendre le monde à travers le toucher, l'un de leurs sens les plus fondamentaux."
        ],
        "es": [
          "El Servicio de Atención a la Primera Infancia organiza un taller de \"manipulación sensorial\".\nPermite a los niños explorar y comprender el mundo a través del tacto, uno de sus sentidos más fundamentales."
        ],
        "nl": [
          "De Early Childhood Service organiseert een workshop \"zintuiglijke manipulatie\".\nDit stelt kinderen in staat om de wereld te verkennen en te begrijpen door middel van aanraking, een van hun meest fundamentele zintuigen."
        ]
      },
