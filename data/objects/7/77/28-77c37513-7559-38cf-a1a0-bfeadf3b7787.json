  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cd003f7b-ec73-33eb-940b-f85df36862fb",
      "dc:description": {
        "de": [
          "Etablissement mit herzlichem Empfang in einem vollständig renovierten Rahmen. Traditionelle Küche von hoher Qualität. Ausgestattete Zimmer (Wasserkocher, Bügeleisen, Safe, Radiowecker und Haartrockner)"
        ],
        "en": [
          "Establishment with a warm welcome in a completely renovated setting. Quality traditional cuisine. Fully equipped room (kettle, iron, safe, clock radio and hair dryer)"
        ],
        "it": [
          "Una struttura accogliente in un ambiente completamente rinnovato. Cucina tradizionale di qualità. Camera completamente attrezzata (bollitore, ferro da stiro, cassaforte, radiosveglia e asciugacapelli)"
        ],
        "fr": [
          "Etablissement à l'accueil chaleureux dans un cadre entièrement rénové. Cuisine traditionnelle de qualité. Chambre équipée (bouilloire, fer à repasser, coffre-fort, radio-réveil et sèche-cheveux)"
        ],
        "es": [
          "Un establecimiento cálidamente acogedor en un entorno completamente renovado. Cocina tradicional de calidad. Habitación totalmente equipada (hervidor, plancha, caja fuerte, radio reloj y secador de pelo)"
        ],
        "nl": [
          "Een gastvrij etablissement in een volledig gerenoveerd kader. Traditionele kwaliteitskeuken. Volledig ingerichte kamer (waterkoker, strijkijzer, kluis, wekkerradio en haardroger)"
        ]
      },
      "@type": [
        "Description"
      ],
