  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c5528356-d3ef-3379-a7a7-c14b54ed69ea",
      "dc:description": {
        "de": [
          "CIRK'ALORS nimmt den Zuschauer mit auf eine zärtliche, sensible und lustige Reise in die Mitte der Sternenpiste, wo die Codes des Zirkus neu interpretiert werden. Kommen Sie näher, kommen Sie näher, aber hüten Sie sich trotzdem vor dem Tiger."
        ],
        "en": [
          "CIRK'ALORS takes spectators on a tender, sensitive and funny journey to the center of the ring of stars, where circus codes are revisited. Come closer, but beware of the tiger all the same."
        ],
        "it": [
          "CIRK'ALORS accompagna il pubblico in un viaggio tenero, sensibile e divertente al centro della pista delle stelle, dove i codici del circo vengono rivisitati. Avvicinatevi, ma fate attenzione alla tigre."
        ],
        "fr": [
          "CIRK'ALORS entraîne le spectateur dans un voyage tendre, sensible et drôle au centre de la piste aux étoiles, là où les codes du cirque seront revisités. Approchez, approchez mais méfiez vous du tigre tout de même."
        ],
        "nl": [
          "CIRK'ALORS neemt het publiek mee op een tedere, gevoelige en grappige reis naar het centrum van de ring van sterren, waar de codes van het circus opnieuw worden bekeken. Kom dichterbij, maar pas toch op voor de tijger."
        ],
        "es": [
          "CIRK'ALORS lleva al público en un viaje tierno, sensible y divertido al centro de la pista de las estrellas, donde se revisan los códigos del circo. Acércate, pero ten cuidado con el tigre."
        ]
      },
