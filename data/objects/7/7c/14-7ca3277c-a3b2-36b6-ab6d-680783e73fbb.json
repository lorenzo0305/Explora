  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d931ff58-e7d4-300f-89dc-7e6ecd113864",
      "dc:description": {
        "de": [
          "Die Kirche durchläuft mehrere Bauphasen. Jahrhundert wieder aufgebaut und im darauffolgenden Jahrhundert von dem Pariser Architekten Millet umgestaltet."
        ],
        "en": [
          "The church underwent several stages of construction. Rebuilt in the 18th century, it was redesigned the following century by the Parisian architect Millet."
        ],
        "it": [
          "La chiesa ha subito diverse fasi di costruzione. Ricostruita nel XVIII secolo, fu ridisegnata nel secolo successivo dall'architetto parigino Millet."
        ],
        "fr": [
          "L'église connait plusieurs étapes de construction. Reconstruite au XVIIIème, elle est remaniée le siècle suivant par l'architecte parisien Millet."
        ],
        "es": [
          "La iglesia pasó por varias etapas de construcción. Reconstruido en el siglo XVIII, fue rediseñado el siglo siguiente por el arquitecto parisino Millet."
        ],
        "nl": [
          "De kerk onderging verschillende bouwfasen. Herbouwd in de 18e eeuw, werd het de volgende eeuw heringericht door de Parijse architect Millet."
        ]
      },
