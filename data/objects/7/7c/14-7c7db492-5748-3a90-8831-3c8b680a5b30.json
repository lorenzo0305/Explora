  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ec3b4a54-1a39-3c0c-80f1-1671ff3ebb10",
      "dc:description": {
        "de": [
          "Auf dem Programm stehen: Hüpfburg, Kreativworkshops, Tonic Wake-up, Fotostand, Bogenschießen, Schminkstand und ein kleiner Zug mit dem CMCF Oignies, Centre de la Mine et du Chemin de Fer (Zentrum für Bergbau und Eisenbahn)."
        ],
        "en": [
          "On the program: Inflatable games, Creative workshops, Wake-up call, Photo booth, Archery, Make-up booth and Little train with the CMCF Oignies, Centre de la Mine et du Chemin de Fer."
        ],
        "it": [
          "In programma: giochi gonfiabili, laboratori creativi, sveglia, cabina fotografica, tiro con l'arco, cabina trucco e treno in miniatura con il CMCF Oignies, Mine and Railway Centre."
        ],
        "fr": [
          "Au programme : Jeux gonflables, Ateliers créatifs, Réveil tonique, Stand photos, Tir à l'Arc, Stand maquillage et Petit train avec le CMCF Oignies, Centre de la Mine et du Chemin de Fer."
        ],
        "nl": [
          "Op het programma: opblaasbare spellen, creatieve workshops, wake-up call, fotohokje, boogschieten, make-up hokje en miniatuurtrein met het CMCF Oignies, Mijn en Spoorcentrum."
        ],
        "es": [
          "En el programa: juegos hinchables, talleres creativos, despertador, fotomatón, tiro con arco, cabina de maquillaje y tren en miniatura con el CMCF Oignies, Centro Minero y Ferroviario."
        ]
      },
