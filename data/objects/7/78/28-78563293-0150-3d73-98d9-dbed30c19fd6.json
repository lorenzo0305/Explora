      "dc:description": {
        "de": [
          "Hören Sie mit Ihrer Familie und Ihren Kindern ab drei Jahren in der Mediathek von Tergnier Geschichten, die von Sprechern vorgelesen werden."
        ],
        "en": [
          "Come and listen to stories read by storytellers at the Médiathèque de Tergnier with your family and children aged three and over."
        ],
        "it": [
          "Venite ad ascoltare le storie lette da relatori ospiti alla biblioteca multimediale di Tergnier con i vostri bambini dai tre anni in su."
        ],
        "fr": [
          "Venez écouter en famille, avec vos enfants de plus de trois ans, des histoires lues par des intervenants à la Médiathèque de Tergnier."
        ],
        "es": [
          "Ven a escuchar cuentos leídos por conferenciantes invitados en la biblioteca multimedia Tergnier con tus hijos a partir de tres años."
        ],
        "nl": [
          "Kom met je kinderen vanaf drie jaar luisteren naar verhalen die worden voorgelezen door gastsprekers in de mediatheek van Tergnier."
        ]
      },
