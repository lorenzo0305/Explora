  "rdfs:comment": {
    "de": [
      "Die Aufführung findet im Rahmen des Festivals Qu'est-ce-qu'on fabrique en famille? #9.\nAnnabelle Sergent beauftragt Karin Serres, die Geschichte von Mouche zu schreiben. Folgen Sie den Abenteuern eines Mädchens, das die Freude am Raufen entdeckt."
    ],
    "en": [
      "Show programmed as part of the Festival Qu'est-ce-qu'on fabrique en famille? #9.\nAnnabelle Sergent entrusts Karin Serres with writing the story of Mouche. Follow the adventures of a girl who discovers the joy of fighting."
    ],
    "it": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\nAnnabelle Sergent ha chiesto a Karin Serres di scrivere la storia di Mouche. Seguite le avventure di una ragazza che scopre la gioia di combattere."
    ],
    "fr": [
      "Spectacle programmé dans le cadre du Festival Qu'est-ce-qu'on fabrique en famille ? #9.\nAnnabelle Sergent confie à Karin Serres le soin d’écrire l’histoire de Mouche. Suivez alors les aventures d'une fille qui découvre la joie de se bagarrer."
    ],
    "es": [
      "Parte del Festival Qu'est-ce-qu'on fabrique en famille? #9.\nAnnabelle Sergent pidió a Karin Serres que escribiera la historia de Mouche. Sigue las aventuras de una niña que descubre el placer de luchar."
    ],
    "nl": [
      "Onderdeel van het Festival Qu'est-ce-qu'on fabrique en famille? #9.\nAnnabelle Sergent vroeg Karin Serres om het verhaal van Mouche te schrijven. Volg de avonturen van een meisje dat het plezier van vechten ontdekt."
    ]
  },
