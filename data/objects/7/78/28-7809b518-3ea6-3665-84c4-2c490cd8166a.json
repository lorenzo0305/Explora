  "rdfs:comment": {
    "de": [
      "Das junge, dynamische und lächelnde Team des Restaurants L'Estran verwöhnt Sie mit Meeresfrüchten und Spezialitäten aus der Region. Pluspunkt: Im Herzen der Stadt, gegenüber dem Place Jeanne d'Arc, dem festlichsten Ort in Le Crotoy!"
    ],
    "en": [
      "The young, dynamic and smiling team of the restaurant L'Estran offers you to taste seafood and local specialities. The +: in the heart of the city, facing the Place Jeanne d'Arc, the most festive place of the Crotoy!"
    ],
    "it": [
      "Il team giovane, dinamico e sorridente del ristorante L'Estran vi propone di assaggiare frutti di mare e specialità locali. Il vantaggio: nel cuore della città, di fronte alla Place Jeanne d'Arc, il luogo più festoso di Le Crotoy!"
    ],
    "fr": [
      "L’équipe jeune, dynamique et souriante du restaurant L'Estran vous propose de déguster des spécialités de fruits de mer et de terroir. Le + : au coeur de la ville, face à la place Jeanne d’Arc, l’endroit le plus festif du Crotoy !"
    ],
    "nl": [
      "Het jonge, dynamische en goedlachse team van restaurant L'Estran laat u proeven van zeevruchten en lokale specialiteiten. Het voordeel: in het hart van de stad, tegenover de Place Jeanne d'Arc, de meest feestelijke plek van Le Crotoy!"
    ],
    "es": [
      "El equipo joven, dinámico y sonriente del restaurante L'Estran le ofrece degustar mariscos y especialidades locales. La ventaja: en el corazón de la ciudad, frente a la plaza Jeanne d'Arc, ¡el lugar más festivo de Le Crotoy!"
    ]
  },
  "rdfs:label": {
    "fr": [
