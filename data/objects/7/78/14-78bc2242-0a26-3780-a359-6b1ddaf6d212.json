  "rdfs:comment": {
    "de": [
      "Als er seine Antrittsrede halten soll, wird der frischgebackene Präsident der Republik von einem absurden Nasenjucken geplagt."
    ],
    "en": [
      "While he was to give his inaugural speech, the new president of the republic was taken by an absurd nasal itch."
    ],
    "it": [
      "Proprio mentre sta per pronunciare il suo discorso inaugurale, il nuovo Presidente della Repubblica viene colto da un assurdo prurito nasale."
    ],
    "fr": [
      "Alors qu'il doit prononcer son discours d'investiture, le tout nouveau président de la république est pris d'une absurde démangeaison nasale."
    ],
    "nl": [
      "Net als hij op het punt staat zijn inaugurele rede te houden, wordt de kersverse president van de republiek gegrepen door een absurde nasale jeuk."
    ],
    "es": [
      "Justo cuando está a punto de pronunciar su discurso de investidura, el flamante Presidente de la República es presa de un absurdo picor nasal."
    ]
  },
