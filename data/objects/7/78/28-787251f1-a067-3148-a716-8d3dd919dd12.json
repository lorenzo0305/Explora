  "rdfs:comment": {
    "de": [
      "Backstein- und Steingebäude, das zwischen 1688 und 1704 auf den Grundmauern eines früheren Gebäudes aus dem 12. Jahrhundert errichtet wurde, in dem die Kapelle erhalten blieb."
    ],
    "en": [
      "Brick and stone building, built between 1688 and 1704, on the foundations of an earlier building from the 12th century which has kept its chapel."
    ],
    "it": [
      "Edificio in mattoni e pietra, costruito tra il 1688 e il 1704, sulle fondamenta di un precedente edificio del XII secolo, che ha conservato la cappella."
    ],
    "fr": [
      "Bâtiment brique et pierre, édifié entre 1688 et 1704, sur les bases d'un bâtiment antérieur du XIIème siècle qui a conservé sa chapelle."
    ],
    "es": [
      "Edificio de ladrillo y piedra, construido entre 1688 y 1704, sobre los cimientos de un edificio anterior del siglo XII, que ha conservado su capilla."
    ],
    "nl": [
      "Bakstenen en stenen gebouw, gebouwd tussen 1688 en 1704, op de fundamenten van een eerder gebouw uit de 12e eeuw, waarvan de kapel bewaard is gebleven."
    ]
