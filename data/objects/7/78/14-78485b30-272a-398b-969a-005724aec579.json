  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b1d908fe-7d0a-35a3-a624-4b53e60657d1",
      "dc:description": {
        "de": [
          "Das Beefplace ist ein Restaurant, in dem sich alles um Rindfleisch dreht. Es basiert auf einfachen und qualitativ hochwertigen Gerichten in einem zeitgenössischen Dekor mit einem schnellen Service, der auf die Bedürfnisse der Kunden eingeht. Wir heißen Sie mit Freunden, Kollegen oder der Familie zum Mittag- oder Abendessen willkommen."
        ],
        "en": [
          "The Beefplace is the restaurant centered around beef. It's based on simple, quality dishes in a contemporary setting, with fast, attentive service. We welcome friends, colleagues and families for lunch or dinner."
        ],
        "it": [
          "The Beefplace è il ristorante incentrato sulla carne di manzo. Si tratta di piatti semplici e di qualità in un ambiente contemporaneo, con un servizio veloce e attento. Accogliamo amici, colleghi e famiglie a pranzo o a cena."
        ],
        "fr": [
          "Le Beefplace est le restaurant centré autour de la viande de bœuf. Il est basé sur des plats simples et de qualité dans un décor contemporain avec un service rapide à l'écoute de la clientèle On vous accueille entre amis, entre collègues, en famille pour le déjeuner ou le diner."
        ],
        "nl": [
          "The Beefplace is het restaurant waar rundvlees centraal staat. Het biedt eenvoudige gerechten van hoge kwaliteit in een eigentijds decor, met snelle, attente bediening. We verwelkomen vrienden, collega's en gezinnen voor lunch of diner."
        ],
        "es": [
          "The Beefplace es el restaurante centrado en la carne de vacuno. Se trata de platos sencillos y de calidad en un ambiente contemporáneo, con un servicio rápido y atento. Recibimos a amigos, colegas y familias para comer o cenar."
        ]
      },
      "@type": [
        "Description"
