      "dc:description": {
        "de": [
          "Dies ist ein schöner kleiner Landgasthof am linken Ufer der Canche zwischen Montreuil-sur-mer und Le Touquet."
        ],
        "en": [
          "Here's a lovely little country inn on the left bank of the River Canche between Montreuil-sur-mer and Le Touquet."
        ],
        "it": [
          "Si tratta di una piccola e graziosa locanda di campagna sulla riva sinistra del fiume Canche, tra Montreuil-sur-mer e Le Touquet."
        ],
        "fr": [
          "Voici une belle petite auberge de campagne sur la rive gauche de la Canche entre Montreuil-sur-mer et Le Touquet."
        ],
        "es": [
          "Se trata de una encantadora posada rural situada en la orilla izquierda del río Canche, entre Montreuil-sur-mer y Le Touquet."
        ],
        "nl": [
          "Dit is een leuke kleine plattelandsherberg op de linkeroever van de rivier de Canche tussen Montreuil-sur-mer en Le Touquet."
