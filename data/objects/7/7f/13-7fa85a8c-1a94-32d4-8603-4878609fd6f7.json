  "rdfs:comment": {
    "de": [
      "Nehmen Sie für ein Geschäftsessen, ein Familienessen oder ein Abendessen mit Freunden an einem Tisch Platz und entdecken Sie die Speisekarte des Restaurants."
    ],
    "en": [
      "For a business lunch, family meal or dinner with friends, take a seat around a table and discover the restaurant?s menu."
    ],
    "it": [
      "Per un pranzo di lavoro, un pasto in famiglia o una cena tra amici, accomodatevi intorno a un tavolo e scoprite il menu del ristorante."
    ],
    "fr": [
      "Pour un déjeuner d’affaire, un repas en famille ou un dîner entre amis, prenez place autour d’une table et découvrez la carte du restaurant."
    ],
    "es": [
      "Para un almuerzo de negocios, una comida familiar o una cena con amigos, siéntese a la mesa y descubra la carta del restaurante."
    ],
