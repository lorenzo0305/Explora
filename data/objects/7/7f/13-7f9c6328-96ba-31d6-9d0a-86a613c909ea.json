  "rdfs:comment": {
    "de": [
      "Escape Game (La reine rouge, Tchernobyl), Axtwerfen, Menschenfußball, Billardfußball gehören zu den Aktivitäten, die im Escape Wood in Locquignol angeboten werden."
    ],
    "en": [
      "Escape games (The Red Queen, Chernobyl), axe-throwing, human soccer and billiards are just some of the activities on offer at Locquignol's Escape Wood."
    ],
    "it": [
      "Giochi di fuga (The Red Queen, Chernobyl), lancio dell'ascia, calcio umano e biliardo sono solo alcune delle attività proposte dal Locquignol Escape Wood."
    ],
    "fr": [
      "Escape Game (La reine rouge, Tchernobyl), lancer de haches, foot humain, foot billard, font partis des activités proposées par l'Escape Wood de Locquignol."
    ],
    "nl": [
      "Ontsnappingsspellen (De Rode Koningin, Tsjernobyl), bijlwerpen, human football en voetbalpool zijn slechts enkele van de activiteiten die worden aangeboden in Locquignol Escape Wood."
    ],
    "es": [
      "Juegos de evasión (La Reina Roja, Chernóbil), lanzamiento de hachas, fútbol humano y billar de fútbol son algunas de las actividades que se ofrecen en el Bosque de Evasión de Locquignol."
    ]
  },
