  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2c2c3677-f7f8-3aca-8d80-ba224bcc665c",
      "dc:description": {
        "de": [
          "Juli, August und Schulferien: von 12:00 bis 14:00 Uhr geöffnet. Freitag, Samstag, Sonntag und an Feiertagen sowie jeden Abend von 18:30 bis 22:00 Uhr. Im Rest des Jahres samstags und sonntags von 12:00 bis 14:00 Uhr und jeden Abend von 18:30 bis 22:00 Uhr außer donnerstags geöffnet."
        ],
        "en": [
          "July, August and school vacations: open from 12pm to 2pm. Fridays, Saturdays, Sundays and public holidays and every evening from 6:30pm to 10pm. Open the rest of the year from 12h to 14h on Saturdays and Sundays and every evening from 18h30 to 22h except Thursday."
        ],
        "it": [
          "Luglio, agosto e vacanze scolastiche: aperto dalle 12.00 alle 14.00. Venerdì, sabato, domenica e giorni festivi e tutte le sere dalle 18.30 alle 22.00. Il resto dell'anno è aperto dalle 12.00 alle 14.00 il sabato e la domenica e tutte le sere dalle 18.30 alle 22.00, tranne il giovedì."
        ],
        "fr": [
          "Juillet, août et vacances scolaires : ouvert de 12h à 14h. Vendredi, samedi, dimanche et jours fériés et tous les soirs de 18h30 à 22h. Ouvert le reste de l'année de 12h à 14h les samedis et dimanches et tous les soirs de 18h30 à 22h sauf le jeudi."
        ],
        "es": [
          "Julio, agosto y vacaciones escolares: abierto de 12.00 a 14.00 h. Viernes, sábados, domingos y festivos y todas las noches de 18.30 a 22.00 h. Abierto el resto del año de 12.00 a 14.00 h los sábados y domingos y todas las tardes de 18.30 a 22.00 h, excepto los jueves."
        ],
        "nl": [
          "Juli, augustus en schoolvakanties: open van 12u tot 14u. Vrijdag, zaterdag, zondag en feestdagen en elke avond van 18.30 tot 22.00 uur. De rest van het jaar geopend van 12.00 tot 14.00 uur op zaterdag en zondag en elke avond van 18.30 tot 22.00 uur behalve op donderdag."
        ]
      },
