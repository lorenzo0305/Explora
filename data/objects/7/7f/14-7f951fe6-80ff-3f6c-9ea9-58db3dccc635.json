      "dc:description": {
        "de": [
          "Auf dem Programm stehen:\n- einführung in Kokedama\n- herstellung von Mini-Gesellschaftsspielen\n- gesichter der Mine\n- einführung in das Modellieren\n- geführte Besichtigung der Ausstellung"
        ],
        "en": [
          "On the program :\n- introduction to Kokedama\n- making mini board games\n- faces of the mine\n- introduction to modeling\n- guided tour of the exhibition"
        ],
        "it": [
          "Il programma comprende\n- introduzione al Kokedama\n- realizzazione di mini giochi da tavolo\n- facce della miniera\n- introduzione alla modellazione\n- visita guidata alla mostra"
        ],
        "fr": [
          "Au programme : \n- initiation au Kokedama \n- fabrication de minis jeux de société \n- visages de la mine \n- initiation au modelage \n- visite guidée de l'exposition"
        ],
        "nl": [
          "Het programma omvat\n- introductie tot Kokedama\n- mini bordspellen maken\n- gezichten van de mijn\n- inleiding tot boetseren\n- rondleiding door de tentoonstelling"
        ],
        "es": [
          "El programa incluye\n- introducción al Kokedama\n- creación de minijuegos de mesa\n- caras de la mina\n- introducción al modelado\n- visita guiada a la exposición"
        ]
      },
