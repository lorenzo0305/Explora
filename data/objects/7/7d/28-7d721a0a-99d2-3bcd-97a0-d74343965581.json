  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b1c27e74-970b-351c-90dc-8095924c206f",
      "dc:description": {
        "de": [
          "Das Museum Jean de La Fontaine wurde zu Beginn des Jahres 2026 wiedereröffnet. Ein Grund mehr, das Geburtshaus des berühmten Fabulisten nach einer langen Renovierungsphase zu besuchen."
        ],
        "en": [
          "The Musée Jean de La Fontaine reopened its doors at the start of 2026, providing yet another reason to visit the house where the famous fabulist was born after a long period of renovation."
        ],
        "it": [
          "Il Musée Jean de La Fontaine ha riaperto le sue porte all'inizio del 2026, offrendo un ulteriore motivo per visitare la casa natale del famoso favolista dopo un lungo periodo di ristrutturazione."
        ],
        "fr": [
          "Le musée Jean de La Fontaine à réouvert ses portes en ce début d'année 2026, une raison de plus de venir découvrir la maison natale du célèbre fabuliste après une longue période de rénovation."
        ],
        "nl": [
          "Het Musée Jean de La Fontaine heropent zijn deuren begin 2026 en biedt na een lange periode van renovatie nog een reden om het geboortehuis van de beroemde fabeldichter te bezoeken."
        ],
        "es": [
          "El museo Jean de La Fontaine reabrió sus puertas a principios de 2026, ofreciendo una razón más para visitar la casa natal del célebre fabulista tras un largo periodo de renovación."
        ]
      },
