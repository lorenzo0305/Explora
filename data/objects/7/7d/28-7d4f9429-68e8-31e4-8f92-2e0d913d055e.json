      "dc:description": {
        "de": [
          "Küche nach den Jahreszeiten unter Verwendung von Produkten aus der Region. Fleischliebhaber werden von der Qualität der angebotenen Produkte begeistert sein."
        ],
        "en": [
          "Seasonal cuisine using local produce. Meat lovers will be delighted by the quality of the products on offer."
        ],
        "it": [
          "Cucina stagionale con prodotti locali. Gli amanti della carne saranno entusiasti della qualità dei prodotti offerti."
        ],
        "fr": [
