        "de": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés (Briefmarkenausstellung)\n(Erdgeschoss - Zugang über den Boulevard)\nam 13.-14. März 2026 im Nausicaá-Aquarium, von 10 bis 18 Uhr, Boulevard Sainte-Beuve in Boulogne/Mer"
        ],
        "en": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés\n(first floor - boulevard access)\nmarch 13-14, 2026 at the Nausicaá aquarium, from 10 am to 6 pm, boulevard Sainte-Beuve, Boulogne/Mer"
        ],
        "it": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés\n(piano terra - accesso dal viale)\n13-14 marzo 2026 presso l'acquario Nausicaá, dalle 10.00 alle 18.00, boulevard Sainte-Beuve, Boulogne/Mer"
        ],
        "fr": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés\n(rez-de-chaussée - accès par le boulevard)\nles 13-14 mars 2026 à l'aquarium Nausicaá, de 10h à 18h, boulevard Sainte-Beuve à Boulogne/Mer"
        ],
        "es": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés\n(planta baja - acceso desde el bulevar)\n13-14 de marzo de 2026 en el acuario Nausicaá, de 10.00 a 18.00 h, bulevar Sainte-Beuve, Boulogne/Mer"
        ],
        "nl": [
          "Boulogne-sur-Mer - Emisson des Timbres Cétacés\n(begane grond - toegang vanaf de boulevard)\n13-14 maart 2026 in het Nausicaá aquarium, van 10.00 tot 18.00 uur, boulevard Sainte-Beuve, Boulogne/Mer"
        ]
