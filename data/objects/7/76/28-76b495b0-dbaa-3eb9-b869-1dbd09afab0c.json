  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/696ae198-6912-3acc-a59f-872819649796",
      "dc:description": {
        "de": [
          "Kommen Sie zum Reiten in den Wald von Retz!\nDas Reitzentrum in Dampleux bietet Ihnen Einführungskurse und Ausritte in die Natur an.\n\nAuf Reservierung"
        ],
        "en": [
          "Come and ride in the Retz forest!\nThe Dampleux equestrian center offers introductory courses and nature rides.\n\nBook in advance"
        ],
        "it": [
          "Venite a cavalcare nella foresta di Retz!\nIl centro di equitazione di Dampleux offre corsi introduttivi e passeggiate nella natura.\n\nPrenota in anticipo"
        ],
        "fr": [
          "Venez faire du cheval en forêt de Retz !\nLe centre équestre de Dampleux vous propose des stages d'initiation et des balades nature. \n\nSur réservation"
        ],
        "es": [
          "¡Ven a montar a caballo en el bosque de Retz!\nEl centro ecuestre de Dampleux ofrece cursos de iniciación y paseos por la naturaleza.\n\nReserve con antelación"
        ],
        "nl": [
          "Kom paardrijden in het bos van Retz!\nDe manege van Dampleux biedt kennismakingslessen en natuurritten aan.\n\nReserveer vooraf"
        ]
      },
