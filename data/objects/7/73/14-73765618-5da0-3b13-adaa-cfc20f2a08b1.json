  "rdfs:comment": {
    "de": [
      "RESTER RIVAGE ist ein theatralisches, eher multidisziplinäres und fast dokumentarisches Werk über das versunkene Dorf Naussac in der Lozère und die Lebenden, die damit verbunden sind."
    ],
    "en": [
      "RESTER RIVAGE is a theatrical, rather multidisciplinary and almost documentary creation about the sunken village of Naussac, in Lozère, and the people who live there."
    ],
    "it": [
      "RESTER RIVAGE è una creazione teatrale, multidisciplinare e quasi documentaristica sul villaggio sommerso di Naussac nella Lozère e sulle persone che lo abitano."
    ],
    "fr": [
      "RESTER RIVAGE est une création théâtrale, plutôt pluridisciplinaire et presque documentaire autour du village englouti de Naussac, en Lozère et des vivant·e·s qui y sont lié·e·s."
    ],
    "nl": [
      "RESTER RIVAGE is een theatrale, multidisciplinaire en bijna documentaire creatie over het verzonken dorp Naussac in de Lozère en de mensen die er wonen."
    ],
    "es": [
      "RESTER RIVAGE es una creación teatral, multidisciplinar y casi documental sobre el pueblo hundido de Naussac, en la Lozère, y sus habitantes."
    ]
  },
