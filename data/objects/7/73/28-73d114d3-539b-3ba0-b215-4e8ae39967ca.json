  "rdfs:comment": {
    "de": [
      "Unser Restaurant befindet sich im Herzen des Yachthafens und ist für seine hausgemachte Küche bekannt. Hier können Sie eine traditionelle, großzügige Küche genießen, die auf frischen und lokalen Produkten basiert, die von unserem Chefkoch sorgfältig ausgewählt wurden."
    ],
    "en": [
      "Our restaurant is located in the heart of the marina and is renowned for its home cooking. You will be able to taste a traditional and generous cuisine, based on fresh and local products, carefully selected by our Chef."
    ],
    "it": [
      "Il nostro ristorante si trova nel cuore del porto turistico ed è rinomato per la sua cucina casalinga. Potrete gustare una cucina tradizionale e generosa, basata su prodotti freschi e locali, accuratamente selezionati dal nostro Chef."
    ],
    "fr": [
      "Notre restaurant se trouve au cœur du port de plaisance, il est reconnu pour sa cuisine maison. Vous pourrez y déguster une cuisine traditionnelle, généreuse, à base de produits frais et locaux, soigneusement sélectionnés par notre Chef."
    ],
    "nl": [
      "Ons restaurant ligt in het hart van de jachthaven en staat bekend om zijn huiselijke keuken. U zult een traditionele en royale keuken kunnen proeven, gebaseerd op verse en lokale producten, zorgvuldig geselecteerd door onze chef-kok."
    ],
    "es": [
      "Nuestro restaurante está situado en el corazón del puerto deportivo y es famoso por su cocina casera. Podrá degustar una cocina tradicional y generosa, basada en productos frescos y locales, cuidadosamente seleccionados por nuestro Chef."
    ]
  },
