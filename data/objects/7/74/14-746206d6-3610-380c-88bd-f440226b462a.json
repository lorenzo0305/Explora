  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8f33920a-9b39-3bdf-97f4-d641020a0d87",
      "dc:description": {
        "de": [
          "Platzvermietung, Gruppenkurse für Kinder, Privatunterricht, Turniere. 11 Plätze, davon 2 überdachte Sandplätze, 2 beleuchtete Kunstrasenplätze im Freien, 5 Sandplätze im Freien, davon 2 beleuchtet, 2 Quick-Plätze."
        ],
        "en": [
          "Field rentals, Children's group courses, Private lessons, Tournaments. 11 courts including 2 indoor clay courts, 2 outdoor floodlit synthetic courts, 5 outdoor clay courts including 2 floodlit courts, 2 quick courts."
        ],
        "it": [
          "Noleggio campi, corsi di gruppo per bambini, lezioni private, tornei. 11 campi di cui 2 campi in terra battuta indoor, 2 campi sintetici outdoor illuminati, 5 campi in terra battuta outdoor di cui 2 illuminati, 2 campi veloci."
        ],
        "fr": [
          "Locations de terrain, Stages collectifs enfants, Cours particuliers, Tournois. 11 terrains dont 2 couverts en terre battue, 2 synthétiques extérieurs éclairés, 5 terres battues extérieures dont 2 éclairées, 2 terrains quick."
        ],
        "nl": [
          "Baanverhuur, Groepslessen voor kinderen, Privélessen, Toernooien. 11 banen, waaronder 2 overdekte gravelbanen, 2 verlichte synthetische buitenbanen, 5 gravel buitenbanen, waaronder 2 verlichte banen, 2 snelle banen."
        ],
        "es": [
          "Alquiler de pistas, cursos en grupo para niños, clases particulares, torneos. 11 pistas, de las cuales 2 de tierra batida cubiertas, 2 pistas sintéticas exteriores iluminadas, 5 pistas de tierra batida exteriores, de las cuales 2 iluminadas, 2 pistas rápidas."
        ]
      },
