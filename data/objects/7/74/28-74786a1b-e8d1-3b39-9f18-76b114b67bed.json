  "rdfs:comment": {
    "de": [
      "Die AAPPMA von Pont-Sainte-Maxence (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) bietet Angeln in der 2. Kategorie auf dem Fluss Oise (auf 8km) und No Kill am Étang de l'évêché mit einer Fläche von 8,5ha an."
    ],
    "en": [
      "The Pont-Sainte-Maxence AAPPMA (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) offers 2nd category fishing on the Oise River (over 8km) and no-kill fishing at the 8.5ha Etang de l?évêché."
    ],
    "it": [
      "L'AAPPMA (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) di Pont-Sainte-Maxence offre la pesca di seconda categoria sul fiume Oise (oltre 8 km) e la pesca no kill nell'Etang de l'évêché (8,5 ettari)."
    ],
    "fr": [
      "L’AAPPMA de Pont-Sainte-Maxence (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) propose de la pêche en 2ème catégorie sur la rivière de l’Oise (sur 8km) et en no kill à l’étang de l’évêché d’une superficie de 8,5ha."
    ],
    "es": [
      "La AAPPMA (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) de Pont-Sainte-Maxence ofrece pesca de 2ª categoría en el río Oise (más de 8 km) y pesca sin muerte en el Etang de l'évêché, de 8,5 ha."
    ],
    "nl": [
      "De AAPPMA Pont-Sainte-Maxence (Association Agréée pour la Pêche et la Protection du Milieu Aquatique) biedt vissen van de 2e categorie op de rivier de Oise (meer dan 8 km) en no kill vissen op het 8,5 ha grote Etang de l'évêché."
    ]
  },
