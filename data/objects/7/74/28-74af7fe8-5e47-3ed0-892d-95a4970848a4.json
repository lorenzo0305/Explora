  "rdfs:comment": {
    "de": [
      "Das gefällt Ihnen: Die charaktervolle Küche nach Art der \"Großmutter\" aus frischen Zutaten, die von einem Mann mit Charakter zubereitet wird."
    ],
    "en": [
      "You'll love the characterful \"grandma-style\" cooking, using fresh produce and prepared by a man with character."
    ],
    "it": [
      "Vi piacerà la cucina \"stile nonna\" con prodotti freschi, preparata da un uomo di carattere."
    ],
    "fr": [
      "Vous aimerez : la cuisine de caractère façon \"grand-mère\" à partir de produits frais, réalisée par un homme de caractère."
    ],
    "es": [
      "Le encantará la cocina \"al estilo de la abuela\" con productos frescos, preparada por un hombre con carácter."
    ],
    "nl": [
      "Je zult dol zijn op de \"oma-stijl\" keuken met verse producten, bereid door een man met karakter."
    ]
