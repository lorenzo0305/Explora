  "rdfs:comment": {
    "de": [
      "Im Stadtzentrum, 500m vom Matisse-Museum, 500m von der Abtei-Brauerei, in der Nähe des Hauses des englischen Dichters Owen und zahlreicher Zeugnisse aus dem Ersten Weltkrieg, 25km von Cambrai, in der Nähe von Maroilles und dem Regionalen Naturpark Avesnois, Caudry und dem Spitzenmuseum, Valenciennes, dem Minenmuseum Lewarde."
    ],
    "en": [
      "In the town center, 500m from the Matisse Museum, 500m from the Abbey Brewery, near the house of the English poet Owen and numerous reminders of the Great War, 25km from Cambrai, near Maroilles and the Avesnois Regional Nature Park, Caudry and the Lace Museum, Valenciennes and the Lewarde Mine Museum."
    ],
    "it": [
      "Nel centro della città, a 500 m dal Museo Matisse, a 500 m dal Birrificio dell'Abbazia, vicino alla casa del poeta inglese Owen e a numerose testimonianze della Grande Guerra, a 25 km da Cambrai, vicino a Maroilles e al Parco Naturale Regionale dell'Avesnois, a Caudry e al Museo del Merletto, a Valenciennes e al Museo della Miniera di Lewarde."
    ],
    "fr": [
      "En centre-ville, à 500m du musée Matisse, à 500m de la brasserie de l’abbaye, à proximité de la maison du poète anglais Owen et de nombreux témoignages de la Grande Guerre, à 25Km de Cambrai, à proximité de Maroilles et du Parc Naturel Régional de l’Avesnois, Caudry et le musée de la dentelle, Valenciennes, le Musée de la mine de Lewarde."
    ],
    "nl": [
      "In het stadscentrum, op 500 m van het Matisse Museum, op 500 m van de Abdij Brouwerij, vlakbij het huis van de Engelse dichter Owen en talloze herinneringen aan de Grote Oorlog, op 25 km van Cambrai, vlakbij Maroilles en het Regionaal Natuurpark Avesnois, Caudry en het Kantmuseum, Valenciennes en het Mijnmuseum Lewarde."
    ],
    "es": [
      "En el centro de la ciudad, a 500 m del Museo Matisse, a 500 m de la Cervecería de la Abadía, cerca de la casa del poeta inglés Owen y de numerosos recuerdos de la Gran Guerra, a 25 km de Cambrai, cerca de Maroilles y del Parque Natural Regional de Avesnois, de Caudry y del Museo del Encaje, de Valenciennes y del Museo de la Mina de Lewarde."
    ]
  },
