  "rdfs:comment": {
    "de": [
      "In der Umgebung von Crépy-en-Valois gibt es viel zu entdecken: 35 Kirchtürme ragen aus einer grünen Umgebung heraus, gallorömische Ruinen, Bergfried, Abteien, Schlösser, Herrenhäuser und authentische Dörfer sind in perfekter Harmonie mit der Natur."
    ],
    "en": [
      "Around Crépy-en-Valois, you'll find a wealth of heritage: 35 bell towers rise out of a green setting; Gallo-Roman ruins, keeps, abbeys, castles, manor houses and authentic villages are in perfect harmony with nature."
    ],
    "it": [
      "Nei dintorni di Crépy-en-Valois, troverete un patrimonio ricchissimo: 35 campanili si ergono in un contesto verdeggiante; rovine gallo-romane, torrioni, abbazie, castelli, manieri e villaggi autentici sono in perfetta armonia con la natura."
    ],
    "fr": [
      "Autour de Crépy-en-Valois, le Patrimoine s'offre à vous: 35 clochers jaillissent d'un écrin de verdure; ruines gallo-romaines, donjon, abbayes, château, manoirs et villages authentiques sont en parfaite harmonie avec la nature."
    ],
    "nl": [
      "Rond Crépy-en-Valois vind je een schat aan erfgoed: 35 klokkentorens rijzen op uit een groene omgeving; Gallo-Romeinse ruïnes, burchten, abdijen, kastelen, landhuizen en authentieke dorpjes zijn in perfecte harmonie met de natuur."
    ],
    "es": [
      "En los alrededores de Crépy-en-Valois, encontrará una gran riqueza patrimonial: 35 campanarios se alzan en un entorno verde; ruinas galo-romanas, torreones, abadías, castillos, casas solariegas y pueblos auténticos están en perfecta armonía con la naturaleza."
    ]
  },
