  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/19ea8827-9956-3f4e-8dbd-e91442c87567",
      "dc:description": {
        "de": [
          "Im Zentrum des Dorfes, in einem komplett renovierten Rahmen... Eine Mischung aus traditioneller und erfinderischer Küche mit frischen, lokalen Produkten, unter Berücksichtigung der Saisonalität!"
        ],
        "en": [
          "In the center of the village, in a completely renovated setting... A mixture of traditional and inventive cooking based on fresh, local products, while respecting the seasonality!"
        ],
        "it": [
          "Nel centro del paese, in un ambiente completamente rinnovato... Un mix di cucina tradizionale e inventiva basata su prodotti freschi e locali, nel rispetto della stagionalità!"
        ],
        "fr": [
          "Au centre du village ,dans un cadre entièrement rénové... Un mélange de cuisine traditionnelle et inventive à base de produits frais, locaux, tout en respectant la saisonnalité !"
        ],
        "nl": [
          "In het centrum van het dorp, in een volledig gerenoveerde... Een mix van traditionele en inventieve gerechten op basis van verse, lokale producten, met respect voor de seizoensgebondenheid!"
        ],
        "es": [
          "En el centro del pueblo, en un entorno completamente renovado... Una mezcla de cocina tradicional e inventiva basada en productos frescos y locales, respetando la estacionalidad"
        ]
      },
