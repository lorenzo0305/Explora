  "rdfs:comment": {
    "de": [
      "Dieses Schloss wird Sie mit seiner klassischen Architektur und der Schönheit seines Parks begeistern. Als Residenz von Pauline Bonaparte und Hauptquartier während des Ersten Weltkriegs werden Sie von seiner Geschichte überrascht sein. Als Gartenliebhaber werden Sie die französische Linie des Parks lieben."
    ],
    "en": [
      "This castle will seduce you with its classical architecture and the beauty of its park. Residence of Pauline Bonaparte, headquarters during the First World War, you will be amazed by its history. A garden lover, you will love the French line of the park."
    ],
    "it": [
      "Questo castello vi sedurrà con la sua architettura classica e la bellezza del suo parco. Residenza di Paolina Bonaparte, quartier generale durante la Prima Guerra Mondiale, vi stupirà per la sua storia. Gli amanti dei giardini apprezzeranno la linea francese del parco."
    ],
    "fr": [
      "Ce château vous séduira par son architecture classique qui s'en dégage ainsi que par la beauté de son parc. Résidence de Pauline Bonaparte, quartier général pendant la première guerre mondiale, vous serez étonné par son histoire. Amateur de jardin, vous aimerez la ligne française du parc."
    ],
    "es": [
      "Este castillo le seducirá por su arquitectura clásica y la belleza de su parque. Residencia de Pauline Bonaparte, cuartel general durante la Primera Guerra Mundial, le sorprenderá su historia. Como amante de los jardines, le encantará la línea francesa del parque."
    ],
    "nl": [
      "Dit kasteel zal u verleiden met zijn klassieke architectuur en de schoonheid van zijn park. Residentie van Pauline Bonaparte, hoofdkwartier tijdens de Eerste Wereldoorlog, u zult versteld staan van de geschiedenis. Als tuinliefhebber zult u de Franse lijn van het park geweldig vinden."
    ]
  },
