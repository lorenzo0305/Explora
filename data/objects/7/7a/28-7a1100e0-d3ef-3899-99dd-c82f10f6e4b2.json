  "rdfs:comment": {
    "de": [
      "Dieser Picknickplatz befindet sich auf dem Place de l'Eglise. Im Herzen des Dorfes gelegen, wird er Sie mit seiner idealen Lage zum Luftholen begeistern."
    ],
    "en": [
      "Picnic area located on the church square. In the heart of the village, it will seduce you by its ideal location to take the air."
    ],
    "it": [
      "Area picnic situata sulla piazza della chiesa. Nel cuore del villaggio, vi sedurrà con la sua posizione ideale per l'aria fresca."
    ],
    "fr": [
      "Aire de pique-nique située sur la place de l'Eglise. En plein cœur du bourg, elle saura vous séduire par sa localisation idéale pour prendre l'air."
    ],
    "es": [
      "Área de picnic situada en la plaza de la iglesia. En el corazón del pueblo, le seducirá por su ubicación ideal para tomar aire fresco."
    ],
    "nl": [
      "Picknickplaats op het kerkplein. In het hart van het dorp, zal het u verleiden met zijn ideale ligging voor frisse lucht."
    ]
  },
