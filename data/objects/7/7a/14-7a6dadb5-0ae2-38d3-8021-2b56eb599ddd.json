          "Sonntag, 5. April 2026\n\nPony-Animationen - Eiersuche\nSpiele, Herausforderungen, Animationen im gesamten Reitpark.\nAb dem Niveau Galop 1"
        ],
        "en": [
          "Sunday, April 5, 2026\n\nPony entertainment - Egg hunt\nGames, challenges, entertainment throughout the equestrian park.\nFrom galop 1 level"
        ],
        "it": [
          "Domenica 5 aprile 2026\n\nAnimazione con i pony - Caccia alle uova\nGiochi, sfide e intrattenimento in tutto il parco equestre.\nDal livello Galoppo 1"
        ],
        "fr": [
          "Dimanche 5 avril 2026\n\nAnimations poneys - Chasse aux oeufs\nJeux, défis, animations dans tout le parc équestre.\nA partir du niveau galop 1"
        ],
        "nl": [
          "Zondag 5 april 2026\n\nPony entertainment - Eieren zoeken\nSpelletjes, uitdagingen en entertainment door het hele ruiterpark.\nVan Gallop 1 niveau"
        ],
        "es": [
          "Domingo 5 de abril de 2026\n\nEntretenimiento con ponis - Búsqueda del huevo\nJuegos, desafíos y entretenimiento por todo el parque ecuestre.\nDesde el nivel Galop 1"
        ]
      },
