  "rdfs:comment": {
    "de": [
      "Begeben Sie sich mit dem Talier de Didy?s auf eine kulinarische Reise durch die Küchen der Welt, die mit Spezialitäten aus West- und Zentralafrika und Gerichten, in denen die sechseckige Küche eine wichtige Rolle spielt, geehrt werden."
    ],
    "en": [
      "Embark on a culinary voyage with Didy?s Talier, featuring cuisines from around the world, with specialties from West and Central Africa and dishes from France."
    ],
    "it": [
      "Partite per un viaggio culinario con Le Talier de Didy's, che propone cucine di tutto il mondo, con specialità dell'Africa occidentale e centrale e piatti che privilegiano la cucina francese."
    ],
    "fr": [
      "Embarquez dans un voyage culinaire avec le Talier de Didy’s, les cuisines du monde qui sont mises à l’honneur, avec des spécialités d’Afrique de l’Ouest et d’Afrique centrale et des plats faisant la part belle à la cuisine hexagonale."
    ],
    "nl": [
      "Ga op een culinaire reis met Le Talier de Didy's, met keukens uit de hele wereld, met specialiteiten uit West- en Centraal-Afrika en gerechten die de Franse keuken hoog in het vaandel hebben staan."
    ],
    "es": [
      "Embárquese en un viaje culinario con Le Talier de Didy?s, que ofrece cocinas de todo el mundo, con especialidades de África Occidental y Central y platos que dan protagonismo a la cocina francesa."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Talier de Didy's"
    ]
  },
