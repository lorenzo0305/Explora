      "dc:description": {
        "de": [
          "Tauchen Sie ein in die Geschichte der Seefischer zur Zeit des 19. Jahrhunderts! Anlässlich des Festes des Königsherings ist der Eintritt ins Museum ermäßigt."
        ],
        "en": [
          "Immerse yourself in the history of 19th-century fishermen! For the King Herring Festival, admission to the museum is reduced."
        ],
        "it": [
          "Immergetevi nella storia dei pescatori del XIX secolo! In occasione della Festa dell'aringa, l'ingresso al museo è ridotto."
        ],
        "fr": [
          "Plongez dans l'histoire des marins pêcheurs à l'époque du 19ème siècle ! A l'occasion de la fête du Hareng roi, l'entrée du musée est à tarif réduit."
        ],
        "es": [
          "Sumérjase en la historia de los pescadores del siglo XIX Con motivo de la Fiesta del Arenque, la entrada al museo es reducida."
        ],
        "nl": [
          "Dompel jezelf onder in de geschiedenis van 19e-eeuwse vissers! Voor het Koningsharingfestival is de toegang tot het museum gereduceerd."
        ]
