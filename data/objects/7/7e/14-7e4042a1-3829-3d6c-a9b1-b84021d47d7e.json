  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/965652e5-25f8-3f08-80ce-06601d937427",
      "dc:description": {
        "de": [
          "Laurent baut Zwiebeln und Kartoffeln in nachhaltiger Landwirtschaft an. Er bietet Ihnen seine Produkte in den beiden Automaten an, mit denen Sie rund um die Uhr kochen können!"
        ],
        "en": [
          "Laurent grows onions and potatoes in sustainable agriculture. He offers you his products in two dispensers that will allow you to cook at any time!"
        ],
        "it": [
          "Laurent coltiva cipolle e patate in modo sostenibile. Vi offre i suoi prodotti nei due dispenser che vi permetteranno di cucinare in qualsiasi momento!"
        ],
        "fr": [
          "Laurent cultive oignons et pommes de terre en agriculture raisonnée. Il vous propose ses produits dans les deux distributeurs qui vous permettront de cuisiner à toute heure !"
        ],
        "nl": [
          "Laurent teelt uien en aardappelen op een duurzame manier. Hij biedt u zijn producten aan in de twee dispensers waarmee u op elk moment kunt koken!"
        ],
        "es": [
          "Laurent cultiva cebollas y patatas de forma sostenible. Le ofrece sus productos en los dos dispensadores que le permitirán cocinar en cualquier momento"
        ]
      },
