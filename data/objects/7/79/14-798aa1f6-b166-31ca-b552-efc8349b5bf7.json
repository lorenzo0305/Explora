  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/724132be-6d73-34e0-a3c2-a3b339f26ea8",
      "dc:description": {
        "de": [
          "Im Restaurant Bleu herrscht eine gemütliche und warme Atmosphäre. Aurélien und sein Team kochen für Sie mit frischen, saisonalen Produkten und bevorzugen lokale Produkte!"
        ],
        "en": [
          "A warm, cosy atmosphere hangs over the Bleu restaurant. Aurélien and his team cook for you fresh, seasonal produce, using local products as much as possible!"
        ],
        "it": [
          "Il ristorante Bleu è caratterizzato da un'atmosfera accogliente e calorosa. Aurélien e il suo team cucinano prodotti freschi e di stagione, utilizzando il più possibile prodotti locali!"
        ],
        "fr": [
          "Une ambiance cosy & chaleureuse plane au-dessus du restaurant Bleu. Aurélien et son équipe cuisinent pour vous des produits frais, de saison, en favorisant au maximum les produits locaux!"
        ],
        "nl": [
          "In restaurant Bleu hangt een gezellige, warme sfeer. Aurélien en zijn team koken verse, seizoensgebonden producten en gebruiken zoveel mogelijk lokale producten!"
        ],
        "es": [
          "En el restaurante Bleu reina un ambiente acogedor y cálido. Aurélien y su equipo cocinan productos frescos y de temporada, utilizando en la medida de lo posible productos locales"
        ]
      },
