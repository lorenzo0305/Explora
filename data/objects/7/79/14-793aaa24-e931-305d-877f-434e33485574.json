      "@id": "https://data.datatourisme.fr/731111bf-f6ee-31b5-96aa-3c175a3ff146",
      "dc:description": {
        "de": [
          "Das ganze Jahr über geöffnet\n18 Löcher: von 55 Euro bis 95 Euro\n36 Löcher: Tag von 80 Euro bis 150 Euro\nKids-Praktikum ab 7 Jahren\nVon Mittwoch bis Samstag.   4 X 2 Std. Gruppenunterricht"
        ],
        "en": [
          "Open all year round\n18 holes: from 55 euros to 95 euros\n36 holes: full day from 80 euros to 150 euros\nKids' courses from age 7\nWednesday to Saturday.   4 X 2 h group lessons"
        ],
        "it": [
          "Aperto tutto l'anno\n18 buche: da 55 euro a 95 euro\n36 buche: giornata intera da 80 euro a 150 euro\nCorsi per bambini a partire dai 7 anni\nDa mercoledì a sabato.   4 X 2 ore di lezioni di gruppo"
        ],
        "fr": [
          "Ouvert toute l'année\n18 trous : de 55 euros à 95 euros   \n36 trous : journée de 80 euros à 150 euros \nStage kids à partir de 7 ans\nDu mercredi au samedi.   4 X 2 h de cours collectifs"
        ],
        "nl": [
          "Het hele jaar geopend\n18 holes: van 55 euro tot 95 euro\n36 holes: hele dag van 80 euro tot 150 euro\nKindercursussen vanaf 7 jaar\nWoensdag tot zaterdag.   4 X 2 uur groepslessen"
        ],
        "es": [
          "Abierto todo el año\n18 hoyos: de 55 euros a 95 euros\n36 hoyos: día completo de 80 euros a 150 euros\nCursos para niños a partir de 7 años\nDe miércoles a sábado   clases en grupo de 4 x 2 h"
        ]
      },
