      "dc:description": {
        "de": [
          "In einem farbenfrohen Dekor bieten Christophe und sein Team eine traditionelle regionale Küche mit \"hausgemachten\" Produkten wie diesem Potjevlesh an."
        ],
        "en": [
          "In a colourful decor, Christophe and his team offer traditional regional cuisine based on \"home-made\" products, like this potjevlesh."
        ],
        "it": [
          "In un ambiente colorato, Christophe e il suo team propongono una cucina regionale tradizionale basata su prodotti \"fatti in casa\", come questo potjevlesh."
        ],
        "fr": [
          "Dans un décor coloré, Christophe et son équipe proposent une cuisine régionale traditionnelle à base de produits \"faits maison\", comme ce potjevlesh."
        ],
        "nl": [
          "In een kleurrijk decor bieden Christophe en zijn team een traditionele regionale keuken op basis van \"huisgemaakte\" producten, zoals deze potjevlesh."
        ],
        "es": [
          "En un entorno colorido, Christophe y su equipo ofrecen una cocina tradicional regional basada en productos \"caseros\", como este potjevlesh."
        ]
      },
