  "rdfs:comment": {
    "de": [
      "Le Vivier d'Omignon ist auf das Angeln von Forellen spezialisiert. Verschiedene Teiche, die in einer grünen Umgebung liegen, heißen Angler aller Niveaus willkommen."
    ],
    "en": [
      "Le Vivier d'Omignon specializes in trout fishing. A variety of ponds, set in lush green surroundings, welcome anglers of all levels."
    ],
    "it": [
      "Le Vivier d'Omignon è specializzato nella pesca alla trota. Diversi stagni, immersi nel verde, accolgono pescatori di ogni livello."
    ],
    "fr": [
      "Le Vivier d'Omignon est spécialisé dans la pêche à la truite. Divers étangs, situés dans un cadre de verdure, accueillent les pêcheurs de tout niveau."
    ],
    "nl": [
      "Le Vivier d'Omignon is gespecialiseerd in forelvissen. Verschillende vijvers in een weelderig groene omgeving verwelkomen vissers van alle niveaus."
    ],
    "es": [
      "Le Vivier d'Omignon está especializado en la pesca de la trucha. Varios estanques, rodeados de una vegetación exuberante, acogen a pescadores de todos los niveles."
    ]
  },
