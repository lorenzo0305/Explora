  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e31a781f-cd8b-341e-879f-c8f55808c6ac",
      "dc:description": {
        "de": [
          "Moules-frites auf der Sonnenterrasse, lokale Biere vom Fass, eine Platte mit Meeresfrüchten und eine Flasche Weißwein - für jeden Geschmack ist etwas dabei!"
        ],
        "en": [
          "Moules-frites on a sunny terrace, local draught beers, a seafood platter and a bottle of white wine - there's something for everyone!"
        ],
        "it": [
          "Cozze e patatine fritte su una terrazza soleggiata, birre alla spina locali, un piatto di pesce e una bottiglia di vino bianco: ce n'è per tutti i gusti!"
        ],
        "fr": [
          "Moules-frites en terrasse ensoleillée, bières locales pression, plateau de fruits de mer et bouteille de vin blanc, il y en a pour tous les goûts !"
        ],
        "nl": [
          "Mosselen en friet op een zonnig terras, lokale bieren van het vat, een zeevruchtenschotel en een fles witte wijn - er is voor elk wat wils!"
        ],
        "es": [
          "Mejillones y patatas fritas en una soleada terraza, cervezas locales de barril, una fuente de marisco y una botella de vino blanco: ¡hay para todos los gustos!"
        ]
      },
