  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/79c9287b-d082-362a-9f80-d85bc049044a",
      "dc:description": {
        "de": [
          "Trödelmarkt im Dorf Vieille-Église, organisiert vom Comité Athlétique de Vieille-Église.\nMittags: Moules-frites in der Schulkantine.\nSo. 3. August - 7h-18h"
        ],
        "en": [
          "Brocante in the village of Vieille-Église organized by the Comité Athlétique de Vieille-Église.\nLunch: moules-frites at the school canteen.\nSun. August 3 - 7am-6pm"
        ],
        "it": [
          "Mercatino delle pulci nel villaggio di Vieille-Église organizzato dal Comité Athlétique de Vieille-Église.\nPranzo: cozze e patatine alla mensa della scuola.\nDomenica 3 agosto - 7-18"
        ],
        "fr": [
          "Brocante dans le village de Vieille-Église organisée par le Comité Athlétique de Vieille-Église.\nLe midi : moules-frites à la cantine scolaire.\nDim. 3 août - 7h-18h"
        ],
        "nl": [
          "Vlooienmarkt in het dorp Vieille-Église georganiseerd door het Comité Athlétique de Vieille-Église.\nLunch: mosselen en friet in de kantine van de school.\nZon. 3 augustus - 7u-18u"
        ],
        "es": [
          "Mercadillo en el pueblo de Vieille-Église organizado por el Comité Athlétique de Vieille-Église.\nAlmuerzo: mejillones con patatas fritas en el comedor escolar.\nDomingo 3 de agosto - de 7.00 a 18.00 h"
        ]
      },
