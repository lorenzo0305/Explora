  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dec9cda6-7668-3863-af0f-c0f37e350932",
      "dc:description": {
        "de": [
          "In Le Portel kommen Sie, ob groß oder klein, zu Saint-Nicolas. Er trifft sich mit Ihnen am Freitag, den 6. Dezember 2024, um 18.00 Uhr zum Start der Beleuchtung im öffentlichen Garten und um 18.30 Uhr auf dem Place de l'Eglise.\nInformationen bei der Mediathek."
        ],
        "en": [
          "Come and see Saint-Nicolas in Le Portel. We look forward to seeing you on Friday, December 6, 2024 at 6:00 p.m. for the launch of the illuminations in the public garden, and at 6:30 p.m. in the Place de l'Église.\nInformation from the Médiathèque."
        ],
        "it": [
          "Venite a vedere Saint-Nicolas a Le Portel. Vi aspettiamo venerdì 6 dicembre 2024 alle 18.00 per il lancio delle luminarie nel giardino pubblico e alle 18.30 in Place de l'Église.\nPer ulteriori informazioni, contattare la Médiathèque."
        ],
        "fr": [
          "A Le Portel, venez, petits et grands, voir Saint-Nicolas. Il vous donne rendez-vous le vendredi 6 décembre 2024 à 18h00 pour le lancement des illuminations au jardin public et pour 18h30 sur la place de l'Église.\nInformations auprès de la Médiathèque."
        ],
        "es": [
          "Venga a ver Saint-Nicolas en Le Portel. Le esperamos el viernes 6 de diciembre de 2024 a las 18.00 h para el lanzamiento de las iluminaciones en el jardín público y a las 18.30 h en la Place de l'Église.\nPara más información, póngase en contacto con la Médiathèque."
        ],
        "nl": [
          "Kom de Sint-Niklaas bekijken in Le Portel. Graag tot ziens op vrijdag 6 december 2024 om 18u voor de lancering van de verlichtingen in de openbare tuin en om 18u30 op de Place de l'Église.\nNeem voor meer informatie contact op met de Médiathèque."
        ]
      },
      "@type": [
        "Description"
      ],
