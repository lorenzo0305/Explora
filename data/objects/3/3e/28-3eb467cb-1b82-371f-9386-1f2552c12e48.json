  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/098e3cb7-4f52-3dd4-87d7-5caaac0aa14b",
      "dc:description": {
        "de": [
          "Bar, Pariser Brasserie.\n\nArt der Musik: Pop-Rock, allgemein.\nKundschaft: 20 bis 40 Jahre.\nMontags bis samstags von 8:00 bis 3:00 Uhr geöffnet, sonntags geschlossen.\n \nKonzerte, Sportübertragungen.\n\nGesamtkapazität: 50 Personen (2 Räume)."
        ],
        "en": [
          "Bar, Parisian brasserie.\n\nType of music: pop rock, generalist.\nClientele: 20 to 40 years old.\nOpen Monday to Saturday, 8am to 3am, closed on Sundays.\n \nConcerts, sports broadcasts.\n\nTotal capacity: 50 people (2 rooms)."
        ],
        "it": [
          "Bar, brasserie parigina.\n\nTipo di musica: pop rock, generalista.\nClientela: dai 20 ai 40 anni.\nAperto dal lunedì al sabato dalle 8.00 alle 3.00, chiuso la domenica.\n \nConcerti, trasmissioni sportive.\n\nCapacità totale: 50 persone (2 sale)."
        ],
        "fr": [
          "Bar, brasserie parisienne.\n\nType de musique : pop rock, généraliste.\nType de clientèle: de 20 à 40 ans.\nOuvert du lundi au samedi de 8h à 3h, fermé le dimanche.\n \nConcerts, retransmission d'événements sportifs.\n\nCapacité totale : 50 personnes (2 salles)."
        ],
        "es": [
          "Bar, brasserie parisina.\n\nTipo de música: pop rock, generalista.\nClientela: de 20 a 40 años.\nAbierto de lunes a sábado de 8h a 3h, cerrado los domingos.\n \nConciertos, retransmisiones deportivas.\n\nCapacidad total: 50 personas (2 salas)."
        ],
        "nl": [
          "Bar, Parijse brasserie.\n\nSoort muziek: poprock, generalistisch.\nKlantenkring: 20 tot 40 jaar.\nOpen van maandag tot zaterdag van 8.00 tot 3.00 uur, gesloten op zondag.\n \nConcerten, sportuitzendingen.\n\nTotale capaciteit: 50 personen (2 zalen)."
        ]
      },
