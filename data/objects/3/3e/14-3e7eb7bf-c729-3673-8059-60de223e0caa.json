      "@id": "https://data.datatourisme.fr/86d9fba1-0bb0-3674-a6f7-6d87501ad8e7",
      "dc:description": {
        "de": [
          "Nutzen Sie die belebende Luft am Ende des Winters, um den nördlichen Teil der Canche-Mündung zwischen Etaples-sur-mer und Camiers zu erkunden."
        ],
        "en": [
          "Take advantage of the crisp late winter air to discover the northern part of the Canche Estuary, between Etaples-sur-mer and Camiers."
        ],
        "it": [
          "Approfittate dell'aria frizzante di fine inverno per scoprire la parte settentrionale dell'estuario della Canche, tra Etaples-sur-mer e Camiers."
        ],
        "fr": [
          "Profitez de l'air vivifiant de la fin d'hiver pour découvrir la partie nord de l'Estuaire de la Canche, entre Etaples-sur-mer et Camiers."
        ],
        "nl": [
          "Profiteer van de frisse nawinterlucht om het noordelijke deel van het estuarium van de Canche te ontdekken, tussen Etaples-sur-mer en Camiers."
        ],
        "es": [
          "Aproveche el aire fresco de finales de invierno para descubrir la parte norte del estuario del Canche, entre Etaples-sur-mer y Camiers."
        ]
      },
