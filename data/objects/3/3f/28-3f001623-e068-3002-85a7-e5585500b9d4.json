  "rdfs:comment": {
    "de": [
      "Probieren Sie die thailändischen Aromen im Restaurant L'Asiane in Noyon. Reisen Sie zwischen einem Tom Yam Kai, einem sautierten Rindfleisch mit rotem Thai-Curry, einem Pad See Ew Huhn und vielen anderen Gerichten!"
    ],
    "en": [
      "Come taste the Thai flavors at the restaurant l'Asiane de Noyon. Travel between a Tom Yam Kai, a Thai red curry sautéed beef, a Pad See Ew Chicken and many more!"
    ],
    "it": [
      "Venite a gustare i sapori thailandesi al ristorante l'Asiane di Noyon. Viaggiate tra un Tom Yam Kai, un manzo saltato in padella con curry rosso tailandese, un Pad See Ew Chicken e molti altri!"
    ],
    "fr": [
      "Venez dégustez les saveurs thaïlandaises au restaurant l'Asiane de Noyon. Voyagez entre un Tom Yam Kai, un boeuf sauté au curry rouge Thaî, un Pad See Ew Poulet et bien d'autres encore !"
    ],
    "es": [
      "Venga a probar los sabores tailandeses en el restaurante l'Asiane de Noyon. Viaja entre un Tom Yam Kai, un salteado de carne con curry rojo tailandés, un Pad See Ew de pollo y muchos otros"
    ],
    "nl": [
      "Kom Thaise smaken proeven in restaurant l'Asiane in Noyon. Reis tussen een Tom Yam Kai, een roergebakken rundvlees met rode Thaise curry, een Pad See Ew Chicken en vele andere!"
    ]
  },
  "rdfs:label": {
