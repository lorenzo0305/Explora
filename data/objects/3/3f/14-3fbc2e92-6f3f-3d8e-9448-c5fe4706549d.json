      "dc:description": {
        "de": [
          "Traditioneller, nicht wettbewerbsorientierter Karateunterricht für alle.\nAngestrebte Ziele: Selbstbeherrschung, Selbstkontrolle, Geselligkeit, Selbstverteidigung.\n\nsamstag 9h A 12h"
        ],
        "en": [
          "Traditional non-competitive karate for all.\nGoals: self-control, sociability, self-defense.\n\nsaturday 9am to 12pm"
        ],
        "it": [
          "Karate tradizionale non competitivo per tutti.\nObiettivi: autocontrollo, socialità, autodifesa.\n\nsabato dalle 9.00 alle 12.00"
        ],
        "fr": [
          "Enseignement karaté traditionnel non compétitif destiné à tous. \nButs recherchés : maîtrise, contrôle de soi, sociabilité, self défense.\n\nsamedi 9h A 12h"
        ],
        "nl": [
          "Traditioneel niet-competitief karate voor iedereen.\nDoelstellingen: zelfbeheersing, gezelligheid, zelfverdediging.\n\nzaterdag van 9 tot 12 uur"
        ],
        "es": [
          "Karate tradicional no competitivo para todos.\nObjetivos: autocontrol, sociabilidad, defensa personal.\n\nsábado de 9:00 a 12:00"
        ]
