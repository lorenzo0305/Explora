  "rdfs:comment": {
    "de": [
      "La Champagne liegt nur eine Stunde von Paris entfernt. Kommen Sie uns besuchen! Wir heißen Sie jeden Tag willkommen. Vergewissern Sie sich durch einen einfachen Anruf, dass wir anwesend sind."
    ],
    "en": [
      "Champagne is located 1 hour from Paris. Come and visit us! We welcome you every day. Make sure we are there by a simple phone call."
    ],
    "it": [
      "La regione dello Champagne dista solo 1 ora da Parigi. Venite a trovarci! Vi diamo il benvenuto ogni giorno. Per assicurarsi della nostra presenza è sufficiente chiamarci."
    ],
    "fr": [
      "La Champagne se situe à 1 heure de Paris. Venez nous rendre visite ! Nous vous accueillons tous les jours. Assurez-vous de notre présence par simple appel téléphonique."
    ],
    "es": [
      "La región de Champagne está a sólo 1 hora de París. Venga a visitarnos Le damos la bienvenida todos los días. Puede asegurarse de que estamos allí simplemente llamándonos."
    ],
    "nl": [
      "De Champagnestreek ligt op slechts 1 uur van Parijs. Kom ons bezoeken! We verwelkomen je elke dag. U kunt ervoor zorgen dat we er zijn door ons gewoon te bellen."
    ]
  },
