  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6172c868-3256-32fd-88ac-62bdb06380de",
      "dc:description": {
        "de": [
          "Es ist eine Veranstaltung, die den afrolateinischen Tänzen wie Salsa, Bachata und Kizomba gewidmet ist und mehr als 1000 Amateur- und Profitänzer nach Le Touquet bringt."
        ],
        "en": [
          "It's an event dedicated to Afro-Latin dances such as salsa, bachata and kizomba, bringing over 1,000 amateur and professional dancers to Le Touquet."
        ],
        "it": [
          "È un evento dedicato alle danze afro-latine come salsa, bachata e kizomba, che porta a Le Touquet oltre 1.000 ballerini dilettanti e professionisti."
        ],
        "fr": [
          "C'est un événement dédié aux danses afro latines comme la salsa, la bachata et la kizomba qui amène plus de 1000 danseurs amateurs et professionnels au Touquet."
        ],
        "es": [
          "Se trata de un acontecimiento dedicado a bailes afrolatinos como la salsa, la bachata y la kizomba, que reúne en Le Touquet a más de 1.000 bailarines aficionados y profesionales."
        ],
        "nl": [
          "Het is een evenement gewijd aan Afro-Latijnse dansen zoals salsa, bachata en kizomba, dat meer dan 1.000 amateur- en professionele dansers naar Le Touquet brengt."
        ]
      },
