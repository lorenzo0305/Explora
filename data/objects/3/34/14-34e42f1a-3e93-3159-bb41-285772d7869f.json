      "@id": "https://data.datatourisme.fr/07f41f91-dcb6-39ce-a897-68f16cda8848",
      "dc:description": {
        "de": [
          "Bistronomische Küche\nRestaurant am Fuße des Grand place Hôtel .\nEntdecken Sie ein stilvolles Ambiente und genießen Sie im Josper-Ofen gegartes, rassespezifisches und reifes Fleisch."
        ],
        "en": [
          "Bistronomic cuisine\nRestaurant at the foot of the Grand Place Hotel.\nDiscover a chic ambience and savor purebred, mature meats cooked in the Josper oven."
        ],
        "it": [
          "Cucina bistronomica\nRistorante ai piedi dell'Hotel Grand Place.\nScoprite un'atmosfera chic e assaporate carni mature di razza pura cotte nel forno Josper."
        ],
        "fr": [
          "Cuisine bistronomique\nRestaurant au pied du Grand place Hôtel .\nDécouvrez une ambiance chic, dégustez des viandes de race et matures cuites au four Josper."
        ],
        "es": [
          "Cocina bistronómica\nRestaurante al pie del hotel Grand Place.\nDescubra un ambiente chic y saboree carnes maduradas de pura raza cocinadas en el horno Josper."
        ],
        "nl": [
          "Bistronomische keuken\nRestaurant aan de voet van het Grand Place Hotel.\nOntdek een chique sfeer en proef puur, gerijpt vlees bereid in de Josper-oven."
        ]
      },
