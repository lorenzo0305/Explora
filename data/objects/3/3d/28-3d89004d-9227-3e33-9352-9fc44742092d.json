  "rdfs:comment": {
    "de": [
      "Das Grand Hôtel de Valenciennes, gegenüber dem TGV-Bahnhof, bietet komfortable Zimmer und Apartments in einem hellen und eleganten Art-Deco-Rahmen."
    ],
    "en": [
      "The Grand Hôtel de Valenciennes, opposite the TGV station, offers comfortable rooms and apartments in a bright, elegant Art Deco setting."
    ],
    "it": [
      "Il Grand Hôtel de Valenciennes, di fronte alla stazione TGV, offre camere e appartamenti confortevoli in un ambiente Art Déco luminoso ed elegante."
    ],
    "fr": [
      "Le Grand Hôtel de Valenciennes, face à la gare TGV, offre chambres et appartements confortables dans un cadre Art déco lumineux et élégant."
    ],
    "nl": [
      "Het Grand Hôtel de Valenciennes, tegenover het TGV-station, biedt comfortabele kamers en appartementen in een lichte en elegante Art Deco omgeving."
    ],
    "es": [
      "El Grand Hôtel de Valenciennes, frente a la estación de TGV, ofrece habitaciones y apartamentos confortables en un marco Art Déco luminoso y elegante."
    ]
