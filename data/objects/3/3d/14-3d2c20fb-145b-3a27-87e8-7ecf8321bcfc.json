  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a825c20f-ea8b-3c5b-a829-bdd95381d928",
      "dc:description": {
        "de": [
          "La pause rest'o ist ein Nachbarschaftsrestaurant mit gesunden, einfachen und guten Gerichten, die von Integrationshelfern mit lokalen Produkten zubereitet werden, die dank einer differenzierten Preispolitik einen kurzen Lebensweg haben."
        ],
        "en": [
          "La pause rest'o is a neighbourhood restaurant with healthy, simple and good dishes, prepared by people in integration with local products in a short circuit thanks to a differentiated pricing policy."
        ],
        "it": [
          "La pause rest?o è un ristorante di quartiere con piatti sani, semplici e buoni, preparati da persone in integrazione con prodotti locali in cortocircuito grazie a una politica di prezzi differenziati."
        ],
        "fr": [
          "La pause rest’o est un restaurant de quartier avec des plats sains, simples et bons, élaborés par des personnes en insertion avec des produits locaux en circuit court grâce à une politique tarifaire différenciée."
        ],
        "nl": [
          "La pause rest?o is een buurtrestaurant met gezonde, eenvoudige en goede gerechten, bereid door mensen in integratie met lokale producten in het kort dankzij een gedifferentieerd prijsbeleid."
        ],
        "es": [
          "La pause rest?o es un restaurante de barrio con platos sanos, sencillos y buenos, preparados por personas integradas con productos locales en circuito corto gracias a una política de precios diferenciada."
        ]
      },
