      "rdfs:comment": {
        "de": [
          "Museum. Filmvorführung, Erklärungen und Vorführung durch einen professionellen Imker. Entdeckung des Lebens der Honigbiene und der Produkte aus dem Bienenstock: Gelee Royale, Honig, Polypen, Propolis. Imkerschule."
        ],
        "en": [
          "Museum. Projection of a film, explanations and demonstration by a professional beekeeper. Discovery of the life of the honey bee and the products of the hive: royal jelly, honey, polen, propolis. Beekeeping school."
        ],
        "it": [
          "Museo. Proiezione di un filmato, spiegazioni e dimostrazioni da parte di un apicoltore professionista. Scoperta della vita dell'ape e dei prodotti dell'alveare: pappa reale, miele, polene, propoli. Scuola di apicoltura."
        ],
        "fr": [
          "Musée. Projection d'un film, explications et démonstration par un apiculteur professionnel. Découverte de la vie de l'abeille mellifère et des produits de la ruche : gelée royale, miel, polène, propolis. Ecole d'apiculture."
        ],
        "nl": [
          "Museum. Vertoning van een film, uitleg en demonstratie door een professionele imker. Ontdekking van het leven van de honingbij en de producten van de bijenkorf: koninginnengelei, honing, polene, propolis. Bijenteeltschool."
        ],
        "es": [
          "Museo. Proyección de una película, explicaciones y demostración de un apicultor profesional. Descubrimiento de la vida de la abeja melífera y de los productos de la colmena: jalea real, miel, polen, propóleo. Escuela de apicultura."
        ]
      },
