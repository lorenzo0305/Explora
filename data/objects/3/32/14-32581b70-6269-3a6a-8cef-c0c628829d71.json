      "@id": "https://data.datatourisme.fr/65d8db03-5733-38d8-a5bf-9b84aaf3b210",
      "dc:description": {
        "de": [
          "Entwicklung der Praxis des Nordic Walking und des Küstenlongierens.\nKüstenlonge am Donnerstag und Sonntag 10 Uhr.\nNordic Walking samstags 10 Uhr."
        ],
        "en": [
          "Develop Nordic walking and long-distance running.\nLonge côte on Thursdays and Sundays at 10am.\nNordic walking Saturday 10am."
        ],
        "it": [
          "Sviluppare il nordic walking e il coastal lunging.\nLonge côte il giovedì e la domenica alle 10.00.\nNordic walking il sabato alle 10.00."
        ],
        "fr": [
          "Développer la pratique de la marche nordique et du longe-côte.\nLonge côte les jeudi et dimanche 10h.\nMarche nordique le samedi 10h."
        ],
        "nl": [
          "Ontwikkel nordic walking en kustlonging.\nLonge côte op donderdag en zondag om 10 uur.\nNordic walking op zaterdag om 10 uur."
        ],
        "es": [
          "Développer la marche nordique et la longe côte.\nLonge côte los jueves y domingos a las 10h.\nMarcha nórdica los sábados a las 10h."
        ]
      },
