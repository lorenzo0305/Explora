  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4632fbc3-9506-3a03-9f75-e3b57dcc4129",
      "dc:description": {
        "de": [
          "Sonntag, 12. Juli 2026 - 18 Uhr\nKonferenz \"Die Orgel heute\" und Vorstellung des Internationalen Orgelfestivals 2026\nKirche der Heiligen Johanna von Orléans\nFreier Eintritt\n\nSonntag 19. Juli 2026 - 18 Uhr\nSonntag, 26. Juli 2026 - 18 Uhr\nSonntag 02. August 2026 - 18 Uhr\nSonntag, 09. August 2026 - 18 Uhr\nInternationales Orgelfestival\nOrgelkonzert (Übertragung auf Großleinwand)\nKirche der Heiligen Johanna von Orléans\nEintrittspreise: 5 ? für Mitglieder / 10 ? normaler Preis\nKostenlos für Schulklassen bis 18 Jahre."
        ],
        "en": [
          "Sunday, July 12, 2026 - 6pm\nConference \"The organ today\" and presentation of the 2026 International Organ Festival\nChurch of Sainte Jeanne d'Arc\nFree admission\n\nSunday, July 19, 2026 - 6pm\nSunday, july 26 2026 - 18h\nSunday August 02 2026 - 18h\nSunday August 09 2026 - 18h\nInternational Organ Festival\nOrgan concert (broadcast on large screen)\nChurch of Sainte Jeanne d'Arc\nPrices: 5 ? for members / 10 ? normal price\nFree for schoolchildren under 18."
        ],
        "it": [
          "Domenica 12 luglio 2026 - ore 18.00\nConferenza \"L'organo oggi\" e presentazione del Festival Organistico Internazionale 2026\nChiesa di Sainte Jeanne d'Arc\nIngresso libero\n\nDomenica 19 luglio 2026 - ore 18\nDomenica 26 luglio 2026 - 18h\nDomenica 02 agosto 2026 - 18h\nDomenica 09 agosto 2026 - 18h\nFestival organistico internazionale\nConcerto d'organo (trasmesso su grande schermo)\nChiesa di Sainte Jeanne d'Arc\nBiglietti: 5? per i soci / 10? prezzo normale\nGratuito per i ragazzi delle scuole sotto i 18 anni."
        ],
        "fr": [
          "Dimanche 12 juillet 2026 - 18h\nConférence \"L'orgue aujourd'hui\" et présentation du Festival International d'Orgue 2026\nEglise Sainte Jeanne d'Arc\nEntrée libre et gratuite\n\nDimanche 19 juillet 2026 - 18h\nDimanche 26 juillet 2026 - 18h\nDimanche 02 août 2026 - 18h\nDimanche 09 août 2026 - 18h\nFestival International d'Orgue\nConcert d'orgue (retransmission sur grand écran)\nEglise Sainte Jeanne d'Arc\nTarifs : 5 € pour les adhérents / 10 € tarif normal\nGratuit pour les scolaires jusqu’à 18 ans."
        ],
        "nl": [
          "Zondag 12 juli 2026 - 18.00 uur\nConferentie \"Het orgel vandaag\" en presentatie van het Internationaal Orgelfestival 2026\nKerk van Sainte Jeanne d'Arc\nGratis toegang\n\nZondag 19 juli 2026 - 18u\nZondag 26 juli 2026 - 18u\nZondag 02 augustus 2026 - 18u\nZondag 09 augustus 2026 - 18u\nInternationaal Orgelfestival\nOrgelconcert (uitzending op groot scherm)\nKerk Sainte Jeanne d'Arc\nTickets: 5? voor leden / 10? normale prijs\nGratis voor schoolkinderen onder 18 jaar."
        ],
        "es": [
          "Domingo 12 de julio de 2026 - 18.00 horas\nConferencia \"El órgano hoy\" y presentación del Festival Internacional de Órgano 2026\nIglesia de Sainte Jeanne d'Arc\nEntrada libre\n\nDomingo 19 julio 2026 - 18h\nDomingo 26 julio 2026 - 18h\nDomingo 02 agosto 2026 - 18h\nDomingo 09 agosto 2026 - 18h\nFestival Internacional de Órgano\nConcierto de órgano (retransmitido en pantalla grande)\nIglesia Sainte Jeanne d'Arc\nEntradas: 5? para socios / 10? precio normal\nGratis para escolares menores de 18 años."
        ]
      },
