  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2f2d82ee-17c3-392e-a46a-624ea8c340e1",
      "dc:description": {
        "de": [
          "von 07:30 bis 19:00 Uhr\n--------------------------------\n\n30kg große Forellen + 4 super große Forellen am Vortag um 18:30 Uhr ausgebracht\n\nVerkauf von Ködern und Angelausrüstung\n19? pro halben Tag (1 kg Forellen) von 07:30 bis 13:00 Uhr und von 13:00 bis 19:00 Uhr\n\nBar den ganzen Tag über\nBrasserie mittags und abends auf Reservierung"
        ],
        "en": [
          "from 07h30 to 19h00\n--------------------------------\n\n30kg of big trout + 4 super big trout spilled the day before at 6:30 pm\n\nSale of bait and fishing tackle\n19? half-day (1kg of trout) from 07:30 to 13:00 and from 13:00 to 19:00\n\nBar all day\nBrasserie for lunch and dinner by reservation"
        ],
        "it": [
          "dalle 07h30 alle 19h00\n--------------------------------\n\n30 kg di trote grandi + 4 trote super grandi versate il giorno prima alle 18.30\n\nVendita di esche e attrezzatura da pesca\n19? per mezza giornata (1 kg di trote) dalle 07:30 alle 13:00 e dalle 13:00 alle 19:00\n\nBar tutto il giorno\nBrasserie per pranzo e cena su prenotazione"
        ],
        "fr": [
          "de 07h30 à 19h00\n--------------------------------\n\n30kg de grosses truites + 4 super grosses truites déversés la veille à 18h30\n\nVente d'appâts et de matériel de pêche\n19€ la demi-journée (1kg de truites) de 07h30 à 13h00 et de 13h00 à 19h00\n\nBar toute la journée\nBrasserie le midi et le soir sur réservation"
        ],
        "nl": [
          "van 07u30 tot 19u00\n--------------------------------\n\n30kg grote forel + 4 super grote forellen gemorst de dag ervoor om 18u30\n\nVerkoop van aas en vismateriaal\n19? voor een halve dag (1kg forel) van 07:30 tot 13:00 en van 13:00 tot 19:00\n\nBar de hele dag\nBrasserie voor lunch en diner op afspraak"
        ],
        "es": [
          "de 07h30 a 19h00\n--------------------------------\n\n30kg de truchas grandes + 4 truchas supergrandes derramadas el día anterior a las 18h30\n\nVenta de cebos y aparejos de pesca\n19? por medio día (1kg de trucha) de 07:30 a 13:00 y de 13:00 a 19:00\n\nBar todo el día\nBrasserie para almuerzos y cenas con reserva previa"
        ]
      },
