  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6b1e38ef-d0cd-3b5d-8287-80d07c7ee303",
      "dc:description": {
        "de": [
          "15 KM LANGER WANDERWEG - 4 STUNDEN\nABFAHRT VOM KERAMIKMUSEUM IN DESVRES\nGELBE MARKIERUNG - UMLEITUNG WÄHREND DER JAGDSAISON\nFinden Sie den Verlauf des Rundwegs auf der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "15 KM WALKING TRAIL - 4H\nDEPARTURE FROM THE DESVRES CERAMICS MUSEUM\nYELLOW MARKINGS - DEVIATION DURING HUNTING SEASON\nFind the route of the circuit on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO A PIEDI DI 15 KM - 4 ORE\nPARTE DAL MUSEO DELLA CERAMICA DI DESVRES\nSEGNALETICA GIALLA - DEVIAZIONE DURANTE LA STAGIONE DELLA CACCIA\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 15 KM - 4H\nDEPART DU MUSEE DE LA CERAMIQUE DE DESVRES \nBALISAGE EN JAUNE - DEVIATION PENDANT LA SAISON DE LA CHASSE\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA A PIE DE 15 KM - 4 HORAS\nSALE DEL MUSEO DE LA CERÁMICA DE DESVRES\nSEÑALIZACIÓN AMARILLA - DESVÍO DURANTE LA TEMPORADA DE CAZA\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su Smartphone."
        ],
        "nl": [
          "15 KM WANDELROUTE - 4 UUR\nSTART AAN HET KERAMIEKMUSEUM DESVRES\nGELE BEWEGWIJZERING - OMLEIDING TIJDENS HET JACHTSEIZOEN\nJe vindt de route op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
