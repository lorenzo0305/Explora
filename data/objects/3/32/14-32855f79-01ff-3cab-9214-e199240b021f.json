  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d79f8d5d-fa6a-38aa-81ac-2a14526bb6f9",
      "dc:description": {
        "de": [
          "Rotkehlchen, Meisen, Finken, Sperlinge oder Grasmücken? Kennen Sie Ihre gefiederten Nachbarn wirklich? In diesem Workshop lernen Sie die Vielfalt der Wildvögel kennen, die den Park zur Nahrungssuche, zum Nisten und zur Aufzucht ihrer Jungen besuchen."
        ],
        "en": [
          "Robins, chickadees, finches, sparrows or warblers? Do you really know your feathered neighbors? Come and discover the diversity of wild birds that frequent the park to feed, nest and raise their young."
        ],
        "it": [
          "Pettirosso, cinciallegra, fringuello, passero o gorgheggio? Conoscete davvero i vostri vicini pennuti? Partecipate a questo laboratorio e scoprite la varietà di uccelli selvatici che frequentano il parco per nutrirsi, nidificare e crescere i loro piccoli."
        ],
        "fr": [
          "Rouges-gorges, mésanges, pinsons, moineaux ou encore fauvettes… Connaissez vous vraiment vos voisins à plumes ? Lors de cet atelier, venez découvrir la diversité des oiseaux sauvages qui fréquentent le parc pour se nourrir, nicher et élever leurs petits."
        ],
        "es": [
          "¿Petirrojos, herrerillos, pinzones, gorriones o currucas? ¿Conoce realmente a sus vecinos emplumados? Ven a este taller y descubre la diversidad de aves silvestres que frecuentan el parque para alimentarse, anidar y criar a sus polluelos."
        ],
        "nl": [
          "Roodborstjes, mezen, vinken, mussen of fluiters? Ken jij je gevederde buren echt? Kom naar deze workshop en ontdek de diversiteit aan wilde vogels die het park aandoen om te eten, te nestelen en hun jongen groot te brengen."
        ]
      },
      "@type": [
        "Description"
      ],
