  "rdfs:comment": {
    "de": [
      "Produkte vom Bauernhof.\nGemüse: Tomaten, Zucchini, Gurken, Paprika, Auberginen, Erbsen, Karotten, Salat, Rote Beete, Kohl, Lauch, Rüben, Bohnen, Kartoffeln, Radieschen... (saisonales Gemüse)\nObst: Erdbeeren"
    ],
    "en": [
      "Farm produce.\nVegetables: Tomatoes, zucchinis, cucumbers, peppers, eggplants, peas, carrots, lettuce, beet, cabbage, leeks, turnips, beans, potatoes, radishes... (seasonal vegetables)\nFruit: Strawberries"
    ],
    "it": [
      "Prodotti agricoli.\nOrtaggi: pomodori, zucchine, cetrioli, peperoni, melanzane, piselli, carote, lattuga, barbabietole, cavoli, porri, rape, fagioli, patate, ravanelli... (verdure di stagione)\nFrutta: Fragole"
    ],
    "fr": [
      "Produits de la ferme.\nLégumes : Tomates, courgettes, concombres, poivrons, aubergines, petit pois, carottes, salades, betteraves rouges, choux, poireaux, navets, haricots, pommes de terre, radis... (légumes de saisons) \nFruits : Fraises"
    ],
    "es": [
      "Productos agrícolas.\nHortalizas: Tomates, calabacines, pepinos, pimientos, berenjenas, guisantes, zanahorias, lechugas, remolachas, coles, puerros, nabos, judías, patatas, rábanos... (verduras de temporada)\nFrutas: Fresas"
    ],
    "nl": [
      "Producten van de boerderij.\nGroenten: Tomaten, courgettes, komkommers, paprika's, aubergines, erwten, wortelen, sla, rode bieten, kool, prei, rapen, bonen, aardappelen, radijs... (seizoensgroenten)\nFruit: Aardbeien"
    ]
  },
  "rdfs:label": {
