  "rdfs:comment": {
    "de": [
      "Professionelle und erfahrene Guides, schließen Sie sich uns an, um die Reichtümer der Somme-Bucht zu entdecken! Bis bald in der Natur, Estelle und Gwenaël"
    ],
    "en": [
      "Professional and experienced guides, join us to discover the riches of the Baie de Somme! See you soon in nature, Estelle and Gwenaël"
    ],
    "it": [
      "Guide professionali ed esperte, unitevi a noi per scoprire le ricchezze della Baie de Somme! A presto nella natura, Estelle e Gwenaël"
    ],
    "fr": [
      "Guides professionnels et expérimentés, rejoignez-nous pour découvrir les richesses de la Baie de Somme ! A bientôt dans la nature, Estelle et Gwenaël"
    ],
    "nl": [
      "Professionele en ervaren gidsen, ontdek samen met ons de rijkdommen van de Baie de Somme! Tot ziens in de natuur, Estelle en Gwenaël"
    ],
    "es": [
      "Guías profesionales y experimentados, ¡únase a nosotros para descubrir las riquezas de la Bahía de Somme! Hasta pronto en la naturaleza, Estelle y Gwenaël"
    ]
  },
