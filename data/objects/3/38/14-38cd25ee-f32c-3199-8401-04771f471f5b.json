  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1997519d-6114-3a39-a948-18a343564803",
      "dc:description": {
        "de": [
          "Von 14:00 bis 17:30 Uhr zum Thema architektonisches Erbe. Treffpunkt im öffentlichen Garten ( Place de l'Eglise)\nAllein, mit der Familie, unter Freunden... Gehen Sie auf Entdeckungsreise durch die Stadt und lösen Sie die Rätsel.\nKostenlos, für alle offen. Informationen bei der Mediathek von Le Portel"
        ],
        "en": [
          "From 2pm to 5:30pm on the theme of architectural heritage. Meet at the public garden (place de l'Eglise)\nOn your own, with family or friends... Discover the town and solve the riddles.\nFree, open to all. Information from the Médiathèque de Le Portel"
        ],
        "it": [
          "Dalle 14.00 alle 17.30 sul tema del patrimonio architettonico. Appuntamento nel giardino pubblico (place de l'Eglise)\nDa soli, in famiglia, con gli amici... Scoprite la città e risolvete gli enigmi.\nGratuito, aperto a tutti. Informazioni presso la Mediateca Le Portel"
        ],
        "fr": [
          "De 14h à 17h30 sur le thème du patrimoine architectural. Rendez-vous au jardin public ( place de l'Eglise)\nEn solo, en famille, entre amis... Partez à la découverte de la ville et et résolvez les énigmes.\nGratuit, ouvert à tous. Renseignements auprès de la Médiathèque de Le Portel"
        ],
        "nl": [
          "Van 14.00 tot 17.30 uur over het thema architecturaal erfgoed. Afspraak in de openbare tuin (place de l'Eglise)\nAlleen, met het gezin, met vrienden... Ontdek de stad en los de raadsels op.\nGratis, open voor iedereen. Informatie van de mediatheek van Le Portel"
        ],
        "es": [
          "De las 14.00 a las 17.30 horas sobre el tema del patrimonio arquitectónico. Cita en el jardín público (place de l'Eglise)\nSolo, en familia, con amigos... Descubra la ciudad y resuelva los enigmas.\nGratuito, abierto a todos. Información en la mediateca de Le Portel"
        ]
      },
