  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b849fa0d-52d9-35cd-9480-0449759282dc",
      "dc:description": {
        "de": [
          "Das große Konzert des Lions Club Boulogne Val de Liane mit dem Bagad An Alarc'h aus Boulogne-sur-Mer findet am Freitag, den 16. Mai um 20:30 Uhr in der Basilika Notre-Dame statt. Preis: 10 Euro. Kinder unter 12 Jahren sind frei. Kartenverkauf vor Ort am Tag des Konzerts ab 19:30 Uhr. Das Konzert wird zugunsten der sozialen Arbeit des Lions Club Val de Liane veranstaltet."
        ],
        "en": [
          "The Boulogne Val de Liane Lions Club Grand Concert, with Bagad An Alarc'h from Boulogne-sur-Mer, takes place on Friday May 16 at 8:30pm at the Notre-Dame Basilica. Price: 10?. Free for children under 12. Tickets on sale on the day of the concert from 7.30pm. This concert is organized for the benefit of the Lions Club Val de Liane."
        ],
        "it": [
          "Il Gran Concerto del Lions Club Boulogne Val de Liane, con Bagad An Alarc'h di Boulogne-sur-Mer, si terrà venerdì 16 maggio alle 20.30 presso la Basilica di Notre-Dame. Prezzo: 10 euro, gratuito per i minori di 12 anni. Biglietti in vendita il giorno del concerto dalle 19.30. Questo concerto è organizzato a favore del Lions Club Val de Liane."
        ],
        "fr": [
          "Le Grand Concert du Lions Club Boulogne Val de Liane, avec le Bagad An Alarc'h de Boulogne-sur-Mer se déroulera le vendredi 16 mai à 20h30 à la basilique Notre-Dame. Tarif : 10€. gratuit pour les moins de 12 ans. Vente de billets sur place le jour du concert dès 19h30. Ce concert est organisé au profit des œuvres sociales du Lions Club Val de Liane."
        ],
        "nl": [
          "Het Grand Concert van de Boulogne Val de Liane Lions Club, met Bagad An Alarc'h uit Boulogne-sur-Mer, vindt plaats op vrijdag 16 mei om 20.30 uur in de Notre-Dame Basiliek. Prijs: €10. Gratis voor kinderen onder de 12 jaar. Kaarten te koop op de dag van het concert vanaf 19.30 uur. Dit concert wordt georganiseerd ter ondersteuning van de Lions Club Val de Liane."
        ],
        "es": [
          "El Gran Concierto del Club de Leones de Boulogne Val de Liane, con Bagad An Alarc'h de Boulogne-sur-Mer, tendrá lugar el viernes 16 de mayo a las 20.30 h en la Basílica de Notre-Dame. Precio: 10 euros. Gratis para menores de 12 años. Venta de entradas el mismo día del concierto a partir de las 19.30 h. Este concierto se organiza en beneficio del Lions Club Val de Liane."
        ]
      },
