  "rdfs:comment": {
    "de": [
      "Verkauf zum Mitnehmen: Crêpes, Waffeln, heiße Getränke (Kaffee, Schokolade...), Glühwein, Pommes frites, Hotdogs...\n\nBar-Brasserie, 7 Tage die Woche geöffnet. Im Stadtzentrum mit großer Terrasse. Gotischer Keller im Inneren."
    ],
    "en": [
      "Take away: pancakes, waffles, hot drinks (coffee, chocolate...), mulled wine, chips, hot dog...\n\nBar-brewery, open 7 days a week. In the city centre with large terrace. Inside, gothic cellar."
    ],
    "it": [
      "Da asporto: pancake, waffle, bevande calde (caffè, cioccolata...), vin brulé, patatine, hot-dog...\n\nBar-brasserie, aperto 7 giorni su 7. Nel centro della città con un'ampia terrazza. All'interno, cantina gotica."
    ],
    "fr": [
      "Vente à emporter: crêpes, gaufres, boissons chaudes ( café, chocolat...), vin  chaud, frites , hot-dog...\n\nBar-brasserie, ouvert 7 jours/7. En plein centre-ville avec grande terrasse. A l'intérieur, cave gothique."
    ],
    "es": [
      "Para llevar: tortitas, gofres, bebidas calientes (café, chocolate...), vino caliente, patatas fritas, hot-dog...\n\nBar-brasserie, abierto los 7 días de la semana. En el centro de la ciudad con una gran terraza. En el interior, bodega gótica."
    ],
    "nl": [
      "Meenemen: pannenkoeken, wafels, warme dranken (koffie, chocolade...), glühwein, frietjes, hotdog...\n\nBar-brasserie, 7 dagen per week geopend. In het centrum van de stad met een groot terras. Binnen, gotische kelder."
    ]
  },
