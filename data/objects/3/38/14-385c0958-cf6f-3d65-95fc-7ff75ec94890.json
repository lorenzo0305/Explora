  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/49a34ee2-94d0-3f9a-a229-8cfd1a1c11ce",
      "dc:description": {
        "de": [
          "27 KM LANGER WANDER- UND MOUNTAINBIKEWEG - START AUF DEM PLACE MARECHAL FOCH IN SAMER\nGELBE MARKIERUNG\nDEVIATION MTB oder JAGD ÜBER DAS ZENTRUM VERLINCTHUN\n\nFinden Sie den Verlauf der Strecke in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "27 KM PEDESTRIAN AND MOUNTAIN BIKE TRAIL - DEPARTURE FROM PLACE MARECHAL FOCH IN SAMER\nYELLOW MARKINGS\nMOUNTAIN BIKE OR HUNTING ROUTE THROUGH THE VERLINCTHUN CENTER\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "27 KM DI PERCORSO PEDONALE E PER MOUNTAIN BIKE - PARTENZA DA PLACE MARECHAL FOCH A SAMER\nSEGNALETICA GIALLA\nMOUNTAIN BIKE O CACCIA PRESSO IL CENTRO DI VERLINCTHUN\n\nIl percorso è disponibile sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE ET VTT  DE 27 KM - DEPART DE LA PLACE  MARECHAL FOCH DE SAMER\nBALISAGE EN JAUNE\nDEVIATION VTT ou CHASSE PAR LE CENTRE DE VERLINCTHUN\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "SENDERO PEATONAL Y PARA BICICLETA DE MONTAÑA DE 27 KM - SALIDA DESDE PLACE MARECHAL FOCH EN SAMER\nSEÑALIZACIÓN AMARILLA\nBICICLETA DE MONTAÑA O CAZA POR EL CENTRO DE VERLINCTHUN\n\nPuede encontrar la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "27 KM WANDEL- EN MOUNTAINBIKEROUTE - VERTREKPUNT PLACE MARECHAL FOCH IN SAMER\nGELE BEWEGWIJZERING\nMOUNTAINBIKE OF JACHT BIJ HET CENTRUM VAN VERLINCTHUN\n\nJe kunt de route vinden op de wandelapplicatie CIRKWI op je smartphone."
        ]
      },
