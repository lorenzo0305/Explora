  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/876e0562-cf75-35db-ae0f-60cfe9e06acf",
      "dc:description": {
        "de": [
          "Bibliothek, die den Zugang zu einer großen Auswahl an Büchern für das Vergnügen aller ermöglicht!\nGeöffnet montags von 17:00 bis 19:00 Uhr, mittwochs von 10:00 bis 12:00 Uhr und von 16:00 bis 18:00 Uhr und samstags von 14:00 bis 16:00 Uhr."
        ],
        "en": [
          "Library offering a wide choice of books for everyone to enjoy!\nOpen Mondays from 5pm to 7pm, Wednesdays from 10am to 12pm and 4pm to 6pm, and Saturdays from 2pm to 4pm."
        ],
        "it": [
          "La biblioteca offre una vasta gamma di libri per tutti i gusti!\nAperta il lunedì dalle 17.00 alle 19.00, il mercoledì dalle 10.00 alle 12.00 e dalle 16.00 alle 18.00 e il sabato dalle 14.00 alle 16.00."
        ],
        "fr": [
          "Bibliothèque laissant l'accès un large choix de livres pour le plaisir de tous !\nOuvert le lundi de 17h à 19h, le mercredi de 10h à 12h et de 16h à 18h et le samedi de 14h à 16h."
        ],
        "es": [
          "La biblioteca ofrece una amplia gama de libros para disfrute de todos\nAbre los lunes de 17.00 a 19.00, los miércoles de 10.00 a 12.00 y de 16.00 a 18.00 y los sábados de 14.00 a 16.00."
        ],
        "nl": [
          "De bibliotheek biedt een breed scala aan boeken voor iedereen!\nGeopend op maandag van 17.00 tot 19.00 uur, op woensdag van 10.00 tot 12.00 uur en van 16.00 tot 18.00 uur en op zaterdag van 14.00 tot 16.00 uur."
        ]
      },
