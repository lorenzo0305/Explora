      "@id": "https://data.datatourisme.fr/8413b351-d1ba-3a80-8730-9362d388aba9",
      "dc:description": {
        "de": [
          "Regie: John Landis (1980 ? VF)\nDrehbuch und Dialoge: Dan Aykroyd und John Landis\nMit Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker?\n\nJake und Elwood Blues alias The Blues Brothers kehren auf die Bühne zurück, um ein Waisenhaus zu retten."
        ],
        "en": [
          "Directed by John Landis (1980 ? VF)\nScreenplay and dialogues: Dan Aykroyd and John Landis\nWith Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker?\n\nJake and Elwood Blues, aka The Blues Brothers, return to the stage to save an orphanage."
        ],
        "it": [
          "Diretto da: John Landis (1980 ? VF)\nSceneggiatura e dialoghi: Dan Aykroyd e John Landis\nInterpreti: Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker?\n\nJake ed Elwood Blues, alias The Blues Brothers, tornano in scena per salvare un orfanotrofio."
        ],
        "fr": [
          "Réalisation : John Landis (1980 – VF)\nScénario et dialogues : Dan Aykroyd et John Landis\nAvec Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker…\n\nJake et Elwood Blues, alias The Blues Brothers, remontent sur scène pour sauver un orphelinat."
        ],
        "nl": [
          "Regie: John Landis (1980 ? VF)\nScript en dialogen: Dan Aykroyd en John Landis\nMet o.a. Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker ?\n\nJake en Elwood Blues, alias The Blues Brothers, keren terug naar het podium om een weeshuis te redden."
        ],
        "es": [
          "Dirigida por: John Landis (1980 ? VF)\nGuión y diálogos: Dan Aykroyd y John Landis\nCon Dan Aykroyd, John Belushi, Carrie Fischer, Ray Charles, James Brown, Aretha Franklin, Cab Calloway, John Lee Hooker?\n\nJake y Elwood Blues, alias The Blues Brothers, vuelven a los escenarios para salvar un orfanato."
        ]
      },
