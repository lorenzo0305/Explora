  "rdfs:comment": {
    "de": [
      "Sie sind gekommen, um das Pontepiscop/ART-Festival während eines Festwochenendes am 12., 13. und 14. Juli 2019 zu färben und zu beleben. Die Streetartists Seth, Alexone, Akhine oder Zenoy... haben das Lagerhaus in der 2 rue Les Mazures in Pont-l'Évêque mit tausend und einer Farbe neu eingekleidet!"
    ],
    "en": [
      "They came to color and enliven the Pontepiscop/ART festival during a weekend of festivities on July 12, 13 and 14, 2019. Street artists Seth, Alexone, Akhine and Zenoy dressed up the warehouse at 2 rue Les Mazures in Pont-l'Évêque with a thousand and one colors!"
    ],
    "it": [
      "Sono venuti a colorare e animare il festival Pontepiscop/ART durante un weekend di festa il 12, 13 e 14 luglio 2019. Gli artisti di strada Seth, Alexone, Akhine e Zenoy hanno dato mille e uno colore al magazzino di rue Les Mazures 2 a Pont-l'Évêque!"
    ],
    "fr": [
      "Ils sont venus colorer et animer le festival du Pontepiscop/ART lors d'un weekend de festivité les 12, 13 et 14 juillet 2019. Les streetartistes Seth, Alexone, Akhine ou encore Zenoy... ont rhabillé avec mille et une couleurs l'entrepôt du 2 rue Les Mazures à Pont-l'Évêque !"
    ],
    "nl": [
      "Ze kwamen het Pontepiscop/ART festival kleuren en opfleuren tijdens een weekend vol festiviteiten op 12, 13 en 14 juli 2019. Straatartiesten Seth, Alexone, Akhine en Zenoy gaven het pakhuis aan 2 rue Les Mazures in Pont-l'Évêque duizend en één kleuren!"
    ],
    "es": [
      "Vinieron a colorear y animar el festival Pontepiscop/ART durante un fin de semana de fiesta los días 12, 13 y 14 de julio de 2019. ¡Los artistas callejeros Seth, Alexone, Akhine y Zenoy dieron mil y un colores al almacén del número 2 de la calle Les Mazures en Pont-l'Évêque!"
    ]
  },
  "rdfs:label": {
    "fr": [
