  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2cc8312f-569b-3162-a67f-4f3e8b5d52a6",
      "dc:description": {
        "de": [
          "kajak, Paddle, Longe côte...\nDas ganze Jahr über geöffnet\nKid Paddle-Kurs für 6- bis 10-Jährige (Stand up Paddle, Kajak, Surfen, Hawaiianischer Einbaum)\nAd'ocean-Kurs für 11-17-Jährige (Stand up Paddle, Kajak, Surfen, Hawaiianischer Einbaum)\nAdo' plage für 12- bis 17-Jährige (Co-Sport, innovative Sportarten, Ausflüge in die Natur, sportliche Herausforderungen, etc.)"
        ],
        "en": [
          "kayak, paddle, longe côte...\nOpen all year round\nKid Paddle course for 6-10 year-olds (stand-up paddle, kayak, surf, Hawaiian pirogue)\nAd'ocean course for 11-17 year-olds (stand-up paddle, kayak, surf, Hawaiian pirogue)\nAdo' plage for 12-17 year-olds (co-sports, innovative sports, nature outings, sports challenges, etc.)"
        ],
        "it": [
          "kayak, pagaia, longe côte...\nAperto tutto l'anno\nCorso Kid Paddle per 6-10 anni (stand up paddle, kayak, surf, canoa hawaiana)\nCorso Ad'ocean per 11-17 anni (stand up paddle, kayak, surf, piroga hawaiana)\nAdo' plage per ragazzi dai 12 ai 17 anni (co-sport, sport innovativi, uscite nella natura, sfide sportive, ecc.)"
        ],
        "fr": [
          "kayak, paddle, longe côte...\nOuvert à l'année\nStage Kid Paddle pour les 6-10 ans (stand up paddle, kayak, surf, pirogue hawaïenne)\nStage ad'ocean pour les 11-17 ans (stand up paddle, kayak, surf, pirogue hawaïenne)\nAdo' plage pour les 12-17 ans (sports co, innovant, sortie nature, challenge sportif, ect)"
        ],
        "es": [
          "kayak, paddle, longe côte...\nAbierto todo el año\nCurso Kid Paddle para 6-10 años (stand up paddle, kayak, surf, piragua hawaiana)\nCurso Ad'ocean para 11-17 años (stand up paddle, kayak, surf, piragua hawaiana)\nAdo' plage para 12-17 años (co-deportes, deportes innovadores, salidas a la naturaleza, retos deportivos, etc.)"
        ],
        "nl": [
          "kajak, peddel, longe côte...\nHet hele jaar geopend\nKid Paddle cursus voor 6-10 jaar (stand up paddle, kajak, surf, Hawaiiaanse kano)\nAd'ocean-cursus voor 11-17 jaar (stand up paddle, kajak, surf, Hawaiiaanse pirogue)\nAdo' plage voor 12-17 jaar (co-sporten, innovatieve sporten, natuuruitjes, sportieve uitdagingen, enz.)"
        ]
      },
