  "rdfs:comment": {
    "de": [
      "Traditionelle Brauerei Daten 1920 Hundertjähriges Jubiläum in 2020\n\nGeöffnet an allen Wochenenden , und in den Ferien in der Region Paris\nSpezialitäten: Frühstück auf Vorbestellung.\nGruppen werden bis zu 20 Personen akzeptiert."
    ],
    "en": [
      "Traditional brewery dates 1920 Centenary in 2020\n\nOpen every weekend and holidays in the Paris region\nSpecialities : Breakfast on reservation.\nGroups accepted up to 20 people."
    ],
    "it": [
      "Il birrificio tradizionale festeggia il 1920 Centenario nel 2020\n\nAperto tutti i fine settimana e i giorni festivi nella regione di Parigi\nSpecialità : Colazione su prenotazione.\nSi accettano gruppi fino a 20 persone."
    ],
    "fr": [
      "Brasserie traditionelle dates 1920 Centenaire en 2020\n\nOuvert tous les week-end , et les vacances de la région Paris \nSpécialités : Petit déjeuner sur réservation.\nGroupes acceptés maxi 20 personnes."
    ],
    "nl": [
      "Traditionele brouwerij dateert 1920 Eeuwfeest in 2020\n\nElk weekend en op feestdagen geopend in de regio Parijs\nSpecialiteiten : Ontbijt op reservering.\nGroepen tot 20 personen worden geaccepteerd."
    ],
    "es": [
      "La fábrica de cerveza tradicional celebra el centenario de 1920 en 2020\n\nAbierto todos los fines de semana y festivos en la región de París\nEspecialidades : Desayuno bajo reserva.\nSe aceptan grupos de hasta 20 personas."
    ]
  },
