  "rdfs:comment": {
    "de": [
      "L?Archimède ist eine schwimmende Bar und ein Restaurant, ein untypischer Ort, um eine großzügige Bistroküche zu genießen, aber auch ein einzigartiger Rahmen!"
    ],
    "en": [
      "L'Archimède is a floating bar-restaurant, an atypical place to enjoy a generous bistro cuisine, but also a unique setting!"
    ],
    "it": [
      "L'Archimède è un bar-ristorante galleggiante, un luogo atipico per gustare una generosa cucina da bistrot, ma anche un ambiente unico!"
    ],
    "fr": [
      "L’Archimède est un bar-restaurant flottant, un lieu atypique pour déguster une cuisine de bistrot généreuse, mais aussi un cadre unique !"
    ],
    "nl": [
      "L'Archimède is een drijvend bar-restaurant, een atypische plek om te genieten van een royale bistrokeuken, maar ook een uniek kader!"
