  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/30697aa6-4d74-38ee-be6f-b07cff242642",
      "dc:description": {
        "de": [
          "Das Mémorial 14-18 bei Nacht, wie Sie es sich noch nie vorgestellt haben. Entdecken Sie einen Abend lang eine sternenklare Nacht im Centre d'histoire, um zu träumen und die Sterne zu betrachten."
        ],
        "en": [
          "The 14-18 Memorial by night, as you have never imagined. During the interlude of an evening, discover a starry night at the History Center to dream and contemplate in front of the perched stars."
        ],
        "it": [
          "Il Memoriale 14-18 di notte, come non l'avete mai immaginato. Trascorrete una serata alla scoperta della notte stellata al Centro di Storia, sognando e contemplando sotto le stelle."
        ],
        "fr": [
          "Le Mémorial 14-18 de nuit, comme vous ne l’avez jamais imaginé. Durant la parenthèse d’une soirée, partez à la découverte d’une nuit étoilée au Centre d’histoire pour rêver et contempler face aux astres perchés."
        ],
        "nl": [
          "Het 14-18 Memorial bij nacht, zoals je je nog nooit hebt voorgesteld. Breng een avond door met het ontdekken van de sterrennacht in het History Centre, dromend en mijmerend onder de sterren."
        ],
        "es": [
          "El Memorial 14-18 de noche, como nunca lo habías imaginado. Pasa una velada descubriendo la noche estrellada en el Centro de Historia, soñando y contemplando bajo las estrellas."
        ]
      },
