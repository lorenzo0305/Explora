  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5e9a820b-54a8-3dbf-93a1-970acae4c406",
      "dc:description": {
        "de": [
          "Brasserie, die regionale Spezialitäten und traditionelle Küche anbietet. Spezialist für Tartar und Burger.\nIn einem gemütlichen Rahmen, traditioneller Empfang nach Art der \"Nord-Pas de Calais\" mit einer sehr abwechslungsreichen, \"hausgemachten\" und originellen Küche."
        ],
        "en": [
          "Brasserie offering regional specialities and traditional cuisine. Specializing in tartars and burgers.\nA warm, traditional Nord-Pas de Calais welcome, with a wide variety of original, home-made dishes."
        ],
        "it": [
          "Brasserie che offre specialità regionali e cucina tradizionale. Specializzata in tartara e hamburger.\nUn'accoglienza calorosa e tradizionale del Nord-Pas de Calais con un'ampia varietà di piatti fatti in casa e originali."
        ],
        "fr": [
          "Brasserie offrant des spécialités régionales et de la cuisine traditionnelle. Spécialiste des tartares et burgers.\nDans un cadre chaleureux, accueil traditionnel à la façon \"Nord-Pas de Calais\" avec une cuisine très variée, \"Fait maison\" et originale."
        ],
        "es": [
          "Brasserie que ofrece especialidades regionales y cocina tradicional. Especialidad en tártaros y hamburguesas.\nAcogida calurosa y tradicional Nord-Pas de Calais con una gran variedad de platos caseros y originales."
        ],
        "nl": [
          "Brasserie met regionale specialiteiten en traditionele keuken. Gespecialiseerd in tartaar en hamburgers.\nEen warm, traditioneel Nord-Pas de Calais onthaal met een grote verscheidenheid aan huisgemaakte en originele gerechten."
        ]
      },
