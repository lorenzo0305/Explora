  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d3e69717-513f-31e0-985f-a017a732b9bb",
      "dc:description": {
        "de": [
          "Probieren Sie unsere Auswahl an handwerklich gebrauten Qualitätsbieren vor Ort oder zum Mitnehmen. Mehr als 150 Biere sind erhältlich und 5 Biere vom Fass an der Theke! Sie können auch unsere hochwertigen Wurst-, Käse- und Foie Gras-Platten probieren."
        ],
        "en": [
          "Come and taste on site or take away our selection of artisanal and quality beers. More than 150 beers available and 5 draught beers at the counter! You will also be able to taste dishes with our selection of quality deli meats, cheeses and foie gras."
        ],
        "it": [
          "Venite a degustare la nostra selezione di birre artigianali di qualità sul posto o da asporto. Più di 150 birre disponibili e 5 birre alla spina al banco! Potrete anche gustare i nostri taglieri di salumi, formaggi e foie gras di qualità."
        ],
        "fr": [
          "Venez déguster sur place ou à emporter notre sélection de bières artisanales et de qualité. Plus de 150 bières disponibles et 5 bières pression au comptoir! Vous pourrez aussi déguster des mets avec nos planches de charcuteries, de fromages et de foie gras de qualités."
        ],
        "es": [
          "Venga a degustar nuestra selección de cervezas artesanales de calidad in situ o para llevar. Más de 150 cervezas disponibles y 5 cervezas de barril en el mostrador También puede disfrutar de nuestras bandejas de embutidos de calidad, quesos y foie gras."
        ],
        "nl": [
          "Kom en proef onze selectie ambachtelijke kwaliteitsbieren ter plaatse of om mee te nemen. Meer dan 150 bieren verkrijgbaar en 5 tapbieren aan de toog! U kunt ook genieten van onze schotels met kwaliteitsvolle vleeswaren, kazen en foie gras."
        ]
      },
      "@type": [
        "Description"
