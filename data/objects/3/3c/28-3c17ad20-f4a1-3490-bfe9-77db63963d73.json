  "rdfs:comment": {
    "de": [
      "Träumen Sie davon, wieder die Schulbank zu drücken, aber Achtung, die Schulbank des beginnenden 20. Jahrhunderts? Dann ist dieses Museum genau das Richtige für Sie, packen Sie Federn und Schürze ein und freuen Sie sich auf einen guten Schulstart!"
    ],
    "en": [
      "Do you dream of going back to school, but beware of the early 20th century? Then this museum is for you, prepare your feathers and apron and have a good start!"
    ],
    "it": [
      "Sognate di tornare a scuola, ma fate attenzione all'inizio del XX secolo? Allora questo museo fa per voi, preparate piume e grembiule e buon inizio!"
    ],
    "fr": [
      "Vous rêviez de retourner sur les bancs de l'école, mais attention ceux du XXe siècle débutant ? Alors ce musée est fait pour vous, préparez plumes et tablier et bonne rentrée !"
    ],
    "es": [
      "¿Sueña con volver a la escuela, pero cuidado con los principios del siglo XX? Entonces este museo es para ti, ¡prepara tus plumas y tu delantal y empieza con buen pie!"
    ],
    "nl": [
      "Droom je er al van om terug naar school te gaan, maar pas op voor het begin van de 20e eeuw? Dan is dit museum iets voor jou, bereid je veren en schort voor en maak een goede start!"
    ]
  },
