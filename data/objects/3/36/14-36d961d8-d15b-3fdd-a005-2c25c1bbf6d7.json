      "dc:description": {
        "de": [
          "Der größte Outdoor-Skatepark der Region für alle, die gerne rutschen0\nMehr als 4000m2 zum Gleiten. Für jeden etwas dabei: Skates, Roller, Inlineskates und BMX-Räder"
        ],
        "en": [
          "The region's largest outdoor skatepark for skateboarding enthusiasts0\nOver 4,000m2 of skating. Something for everyone: skates, scooters, rollerblades and BMX"
        ],
        "it": [
          "Il più grande skatepark all'aperto della regione per gli appassionati di skateboard0\nOltre 4.000 m2 di pattinaggio. Qualcosa per tutti: pattini, monopattini, rollerblade e BMX"
        ],
        "fr": [
          "Le plus grand skatepark outdoor de la région pour les amateurs de glisse0\nPlus de de 4000m2 de glisse. Il y en a pour tous : skates, trottinettes, rollers et BMX"
        ],
        "nl": [
          "Het grootste outdoor skatepark in de regio voor skateboardfanaten0\nMeer dan 4.000 m2 skaten. Voor elk wat wils: skates, steps, skeelers en BMX"
        ],
        "es": [
          "El mayor skatepark al aire libre de la región para los amantes del monopatín0\nMás de 4.000 m2 para patinar. Para todos los gustos: patines, monopatines, patines de ruedas y BMX"
        ]
      },
