  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e768d744-1e85-3d07-97c3-39f04b1c919e",
      "dc:description": {
        "de": [
          "Handwerklich hergestellte Pizzen mit Zutaten aus der Region. Wir bieten auch Pasta und Bruschetta an. Alles ist hausgemacht.\nWir haben auch 4 Pizzaautomaten: Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ],
        "en": [
          "Artisanal pizzas made with local ingredients. We also offer pasta and bruschetta. All homemade.\nWe also have 4 pizza vending machines: Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ],
        "it": [
          "Pizze fatte in casa con ingredienti locali. Offriamo anche pasta e bruschette. Tutto fatto in casa.\nAbbiamo anche 4 distributori automatici di pizza: Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ],
        "fr": [
          "Des pizzas artisanales faites avec des ingrédients de la région. Nous proposons aussi des pâtes et des bruschettas. Tout est fait maison.\nNous avons aussi 4 distributeurs à pizzas : Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ],
        "es": [
          "Pizzas caseras elaboradas con ingredientes locales. También ofrecemos pasta y bruschetta. Todo casero.\nTambién tenemos 4 máquinas expendedoras de pizza: Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ],
        "nl": [
          "Huisgemaakte pizza's gemaakt met lokale ingrediënten. We bieden ook pasta en bruschetta. Allemaal huisgemaakt.\nWe hebben ook 4 pizza-automaten: Berck / Rang-du-Fliers / Campigneulles-Les-Grandes / Groffliers"
        ]
      },
