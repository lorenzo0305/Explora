  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d9f17145-6f68-34c8-a225-d7bf54ca3c91",
      "dc:description": {
        "de": [
          "Entdecken Sie eine schmackhafte Küche aus frischen Produkten in einer gemütlichen Umgebung im Departement Pas-de-Calais.\nDas Restaurant verfügt über zwei Veranstaltungsräume mit einem Catering-Service, um alle Ihre Veranstaltungen durchzuführen."
        ],
        "en": [
          "Discover a tasty cuisine based on fresh produce in a warm setting in the Pas-de-Calais.\nThe restaurant has two reception rooms with a catering service for all your events."
        ],
        "it": [
          "Scoprite una cucina gustosa a base di prodotti freschi in un ambiente accogliente situato nel Pas-de-Calais.\nIl ristorante dispone di due sale per ricevimenti con servizio di catering per tutti i vostri eventi."
        ],
        "fr": [
          "Découvrez une savoureuse cuisine à base de produits frais dans un cadre chaleureux situé dans le Pas-de-Calais.\nLe restaurant possède deux salles de réception avec un service traiteur pour réaliser tous vos événements."
        ],
        "nl": [
          "Ontdek een smakelijke keuken op basis van verse producten in een warm kader in Pas-de-Calais.\nHet restaurant beschikt over twee ontvangstzalen met een cateringdienst voor al uw evenementen."
        ],
        "es": [
          "Descubra una sabrosa cocina basada en productos frescos en un entorno cálido situado en el Pas-de-Calais.\nEl restaurante dispone de dos salas de recepción con un servicio de catering para todos sus eventos."
        ]
      },
