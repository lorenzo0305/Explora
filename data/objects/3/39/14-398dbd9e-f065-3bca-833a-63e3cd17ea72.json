  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f1fcf549-a89b-354b-88b6-6b26b4355fd7",
      "dc:description": {
        "de": [
          "Entdecken Sie in Begleitung eines Fremdenführers die Galerie der Zeit, einen weltweit einzigartigen Museumsbereich, dessen Schwerpunkt an diesem Wochenende auf Werken liegt, die mit der Natur in Verbindung stehen."
        ],
        "en": [
          "Accompanied by a guide, discover the Galerie du Temps, a unique museographic space in the world, with a special focus this weekend on works related to nature."
        ],
        "it": [
          "Accompagnati da una guida e da un docente, scoprite la Galerie du Temps, uno spazio museale diverso da qualsiasi altro al mondo, che questo fine settimana si concentra in particolare sulle opere legate alla natura."
        ],
        "fr": [
          "En compagnie d’un guide-conférencier,  découvrez la Galerie du temps, espace  muséographique unique au monde, avec  une attention toute particulière portée ce weekend sur les œuvres en lien avec la nature."
        ],
        "nl": [
          "Ontdek onder begeleiding van een gids en docent de Galerie du Temps, een unieke museumruimte ter wereld, met dit weekend speciale aandacht voor werken met betrekking tot de natuur."
        ],
        "es": [
          "Acompañado por un guía y un conferenciante, descubra la Galerie du Temps, un espacio museístico sin igual en el mundo, que este fin de semana se centra especialmente en las obras relacionadas con la naturaleza."
        ]
      },
