  "rdfs:comment": {
    "de": [
      "Ludovic Desjardins, Chef des Restaurants, erhielt den Übernahmepreis des Maison des Entreprises de la Thiérache et de la Serre, weil er aus einer Brasserie einen geselligen Ort rund um eine regionale und qualitativ hochwertige Gastronomie gemacht hat!"
    ],
    "en": [
      "Ludovic Desjardins, Chef of the restaurant received the prize for the takeover of the Maison des Entreprises de la Thiérache et de la Serre for having turned a brasserie into a convivial place, based on local and quality gastronomy!"
    ],
    "it": [
      "Ludovic Desjardins, chef del ristorante, è stato premiato dalla Maison des Entreprises de la Thiérache et de la Serre per aver trasformato una brasserie in un luogo conviviale, basato sulla gastronomia locale e di qualità!"
    ],
    "fr": [
      "Ludovic Desjardins, Chef du restaurant a reçu le prix de la reprise de la Maison des Entreprises de la Thiérache et de la Serre pour avoir fait d'une brasserie un lieu convivial, autour d'une gastronomie de terroir et de qualité !"
    ],
    "es": [
      "Ludovic Desjardins, jefe de cocina del restaurante, recibió el premio de la Casa de las Empresas de la Thiérache y la Serre por haber convertido una brasserie en un lugar de convivencia, ¡basado en la gastronomía local y de calidad!"
    ],
    "nl": [
      "Ludovic Desjardins, de chef-kok van het restaurant, kreeg de prijs voor de overname door het Maison des Entreprises de la Thiérache et de la Serre voor het omvormen van een brasserie tot een gezellige plek, gebaseerd op lokale kwaliteitsgastronomie!"
    ]
  },
  "rdfs:label": {
