      "dc:description": {
        "de": [
          "Friterie du Nord, mit Pommes frites mit Rinderfett, Welsh, Burgern, belgischen Bieren und französischen Weinen.\nVor Ort oder zum Mitnehmen\nTerrasse vor Ort\nHAPPY HOUR: 17h/19h"
        ],
        "en": [
          "Friterie du Nord, with beef fat fries, welsh, burger, Belgian beers and French wines.\nOn site or takeaway\nTerrace on site\nHAPPY HOUR: 5pm/7pm"
        ],
        "it": [
          "Friterie du Nord, con patatine fritte al grasso di manzo, welsh, hamburger, birre belghe e vini francesi.\nSul posto o da asporto\nTerrazza in loco\nHAPPY HOUR: 17:00/17:00"
        ],
        "fr": [
          "Friterie du Nord, avec frites au gras de bœuf, welsh, burger, bières belges et vins français.\nSur place ou à emporter\nTerrasse sur place\nHAPPY HOUR : 17h/19h"
        ],
        "nl": [
          "Friterie du Nord, met friet, welsh, hamburgers, Belgische bieren en Franse wijnen.\nTer plaatse of om mee te nemen\nTerras ter plaatse\nHAPPY HOUR: 17u/7u"
        ],
        "es": [
          "Friterie du Nord, con patatas fritas con grasa de buey, galesas, hamburguesas, cervezas belgas y vinos franceses.\nEn el lugar o para llevar\nTerraza in situ\nHAPPY HOUR: 17.00 h / 19.00 h"
        ]
      },
