  "rdfs:comment": {
    "de": [
      "Das Sure Hôtel by Best Western Lille Tourcoing liegt inmitten eines über 4000 m² großen Gartens und ist liebevoll eingerichtet.\nDas moderne Hotel verfügt über eine Terrasse, eine Bar/Lounge und ein Restaurant, in dem die Produkte des eigenen Gartens im Mittelpunkt stehen."
    ],
    "en": [
      "Nestled in the heart of a 4,000 m² garden, the Sure Hôtel by Best Western Lille Tourcoing is decorated with care.\nThe modern hotel features a terrace, a bar/lounge and a restaurant featuring produce from the kitchen garden."
    ],
    "it": [
      "Immerso nel cuore di un giardino di 4.000 m², il Sure Hôtel by Best Western Lille Tourcoing è arredato con cura.\nQuesto moderno hotel dispone di una terrazza, un bar/lounge e un ristorante con prodotti dell'orto."
    ],
    "fr": [
      "Niché au cœur d'un jardin de plus de 4 000 m², le Sure Hôtel by Best Western Lille Tourcoing est décoré avec soin. \nL'hôtel moderne dispose d’une terrasse, un bar/lounge et un restaurant mettant en avant les produits du potager."
    ],
    "nl": [
      "Het Sure Hôtel by Best Western Lille Tourcoing ligt in het hart van een tuin van 4.000 m² en is met zorg ingericht.\nHet moderne hotel beschikt over een terras, een bar/lounge en een restaurant met producten uit de moestuin."
    ],
    "es": [
      "Enclavado en el corazón de un jardín de 4.000 m², el Sure Hôtel by Best Western Lille Tourcoing está decorado con esmero.\nEste moderno hotel dispone de terraza, bar/salón y restaurante con productos de la huerta."
    ]
  },
