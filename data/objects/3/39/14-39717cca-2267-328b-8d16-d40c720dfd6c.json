      "dc:description": {
        "de": [
          "Pyjama-Party mit Vorführung des Films \"SHREK\".\nKostenloses Popcorn für alle Zuschauer, die im Pyjama kommen!\nNormale Preise für die Vorführung."
        ],
        "en": [
          "Pyjama evening with screening of the film \"SHREK\".\nPopcorn offered to all spectators who come in pyjamas!\nRegular rates for the screening."
        ],
        "it": [
          "Serata in pigiama con proiezione del film \"SHREK\".\nPopcorn offerti a tutti gli spettatori in pigiama!\nPrezzi abituali per la proiezione."
        ],
        "fr": [
          "Soirée Pyjama avec projection du film « SHREK ». \nPopcorn offert à tous les spectateurs qui viendront en pyjama ! \nTarif habituels pour la projection."
        ],
        "nl": [
          "Pyjamanacht met vertoning van de film \"SHREK\".\nPopcorn aangeboden aan alle toeschouwers die in pyjama komen!\nGebruikelijke prijzen voor de vertoning."
        ],
        "es": [
          "Noche de pijamas con proyección de la película \"SHREK\".\nSe ofrecerán palomitas a todos los espectadores que vengan en pijama\nPrecios habituales para la proyección."
        ]
