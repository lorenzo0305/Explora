  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/92bf7bd5-efd0-369e-b0fe-5130a7206b02",
      "dc:description": {
        "de": [
          "Innere Beleuchtung der Kirche Notre-Dame de la mer. Ein origineller Rundgang für Groß und Klein. Der Rundgang kann zu den Gebäuden von Dannes, Frencq, Lefaux, Widehem fortgesetzt werden - Von 21.00 bis 22.30 Uhr."
        ],
        "en": [
          "Interior illumination of the Church of Our Lady of the Sea. An original visit for young and old. The tour can continue to the buildings of Dannes, Frencq, Lefaux and Widehem - from 9 pm to 10.30 pm."
        ],
        "it": [
          "Illuminare l'interno della chiesa di Notre-Dame de la mer. Una visita originale per grandi e piccini. Il tour può proseguire negli edifici di Dannes, Frencq, Lefaux e Widehem - dalle 21.00 alle 22.30."
        ],
        "fr": [
          "Mise en lumière intérieure de l'Eglise Notre-Dame de la mer. Une visite originale pour petits et grands. Le Parcours peut se poursuivre vers les édifices de Dannes, Frencq, Lefaux, Widehem - De 21h à 22h30."
        ],
        "nl": [
          "Verlicht het interieur van de kerk Notre-Dame de la mer. Een origineel bezoek voor jong en oud. De rondleiding kan worden voortgezet naar de gebouwen in Dannes, Frencq, Lefaux en Widehem - van 21.00 tot 22.30 uur."
        ],
        "es": [
          "Iluminación del interior de la iglesia de Notre-Dame de la mer. Una visita original para grandes y pequeños. La visita puede continuar por los edificios de Dannes, Frencq, Lefaux y Widehem - de 21:00 a 22:30."
        ]
      },
      "@type": [
        "Description"
