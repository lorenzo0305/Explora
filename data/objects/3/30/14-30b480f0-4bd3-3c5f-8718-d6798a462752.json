  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom Jardin des Lianes in Chériennes fesseln, einem einzigartigen Ort, an dem sich die Natur ihr Recht zurückerobert hat, um ein wildromantisches Bild zu komponieren."
    ],
    "en": [
      "Let yourself be captivated by the Jardin des Lianes in Chériennes, a unique place where nature has reclaimed its rights to create a wildly romantic tableau."
    ],
    "it": [
      "Lasciatevi conquistare dal Jardin des Lianes di Chériennes, un luogo unico in cui la natura si è riappropriata dei suoi diritti per creare un quadro selvaggiamente romantico."
    ],
    "fr": [
      "Laissez-vous captiver par le Jardin des Lianes à Chériennes, un lieu unique où la nature a repris ses droits pour composer un tableau romantique et sauvage."
    ],
    "nl": [
      "Laat je betoveren door de Jardin des Lianes in Chériennes, een unieke plek waar de natuur haar rechten heeft opgeëist om een wildromantisch plaatje te creëren."
    ],
    "es": [
      "Déjese cautivar por el Jardin des Lianes de Chériennes, un lugar único donde la naturaleza ha reclamado sus derechos para crear una estampa salvajemente romántica."
    ]
  },
