      "dc:description": {
        "de": [
          "Let's Dance bietet Ihnen Kurse in :\n-klassischer Tanz\n-von Modern'n jazz\n-von Aerobic und Step\nalles unter Einhaltung der geltenden Gesundheitsvorschriften."
        ],
        "en": [
          "Let's Dance offers you classes in :\n-classical dance\n-modern'n jazz\n-aerobics and step\nall in the respect of the sanitary rules in force."
        ],
        "it": [
          "Let's Dance vi offre lezioni di :\n-danza classica\n-jazz moderno\n-aerobica e step\nil tutto nel rispetto delle norme sanitarie vigenti."
        ],
        "fr": [
          "Let's Dance vous propose des cours de :\n-danse classique\n-de Modern’n jazz\n-d'aérobic et de step \nle tout dans le respect des règles sanitaires en vigueur."
        ],
        "es": [
          "Let's Dance te ofrece clases en :\n-danza clásica\n-jazz moderno\n-aeróbic y step\ntodo ello en cumplimiento de la normativa sanitaria vigente."
        ],
        "nl": [
          "Let's Dance biedt u lessen aan in :\n-klassieke dans\n-modern'n jazz\n-aerobics en step\nalles in overeenstemming met de geldende gezondheidsvoorschriften."
        ]
      },
