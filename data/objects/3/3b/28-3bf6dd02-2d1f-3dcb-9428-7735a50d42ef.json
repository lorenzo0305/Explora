  "rdfs:comment": {
    "de": [
      "In der letzten Sitzung des Jahres wollen wir uns auf ein Abenteuer im Dschungel begeben!  \nKommt, kleine Abenteurer!  \nvamos a explorar la selva!\n\n\\*Auf geht's, kleine Abenteurer!  \nWir erkunden den Dschungel!"
    ],
    "en": [
      "For the last session of the year, let's go on a jungle adventure!  \nCome on, little adventurers!  \n¡ Vamos a explorar la selva !\\*\n\n\\*Allez! little adventurers!  \nWe're off to explore the jungle!"
    ],
    "it": [
      "Per l'ultima sessione dell'anno, andiamo all'avventura nella giungla!  \nForza, piccoli avventurieri!  \nvamos a explorar la selva!\n\n\\*Forza, piccoli avventurieri!  \nAndiamo a esplorare la giungla!"
    ],
    "fr": [
      "Pour la dernière séance de l'année, partons à l'aventure dans la jungle !  \nCome on, little adventurers!  \n¡ Vamos a explorar la selva !\\*\n\n\\*Allez! les petits aventuriers !  \nOn part explorer la jungle !"
    ],
    "nl": [
      "Voor de laatste sessie van het jaar gaan we op avontuur in de jungle!  \nKom op, kleine avonturiers!  \n¡ Vamos a explorar la selva !\n\n\\*Kom op, kleine avonturiers!  \nWe gaan de jungle verkennen!"
    ],
    "es": [
      "Para la última sesión del año, ¡vámonos de aventura a la selva!  \n¡Vamos, pequeños aventureros!  \n¡ Vamos a explorar la selva !\n\n\\*¡Vamos, pequeños aventureros!  \n¡Vamos a explorar la selva!"
    ]
  },
  "rdfs:label": {
