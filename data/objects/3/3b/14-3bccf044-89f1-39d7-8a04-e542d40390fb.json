  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a025c81d-ce07-3ff3-ac70-4997eb4c56c4",
      "dc:description": {
        "de": [
          "Piste mit Gokart-Verleih für Erwachsene und Kinder. Der ideale Ort, um Ihre Freunde herauszufordern oder sich mit der Familie zu amüsieren!\nAb 4 Jahren in Begleitung - 7 Jahren allein - 1m30"
        ],
        "en": [
          "Go-kart rental track for adults and children. The ideal place to challenge your friends or have fun as a family!\nFrom 4 years old accompanied - 7 years old alone - 1m30"
        ],
        "it": [
          "Pista di noleggio go-kart per adulti e bambini. Il luogo ideale per sfidare gli amici o per divertirsi in famiglia!\nDa 4 anni accompagnati - 7 anni da soli - 1m30"
        ],
        "fr": [
          "Piste de locations de karts pour adultes et enfants. L'endroit idéal pour défier vos amis ou vous amuser en famille !\nA partir de 4 ans accompagné - 7 ans seul - 1m30"
        ],
        "nl": [
          "Verhuur van skelters voor volwassenen en kinderen. De ideale plek om je vrienden uit te dagen of plezier te maken met het hele gezin!\nVanaf 4 jaar onder begeleiding - 7 jaar alleen - 1m30"
        ],
        "es": [
          "Pista de alquiler de karts para adultos y niños. El lugar ideal para retar a tus amigos o divertirte en familia\nA partir de 4 años acompañado - 7 años solo - 1m30"
        ]
      },
