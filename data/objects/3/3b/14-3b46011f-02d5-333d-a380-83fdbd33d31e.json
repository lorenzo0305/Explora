  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/55908123-09e6-3f11-847a-c27ce27f9353",
      "dc:description": {
        "de": [
          "Entdecken Sie im L'Avenue die Aromen vergangener Zeiten wieder. Unser Küchenchef bietet Ihnen eine neu interpretierte, traditionelle Küche voller Authentizität. Ein Moment purer Gaumenfreude erwartet Sie."
        ],
        "en": [
          "Rediscover the flavors of yesteryear at L'Avenue. Our chef offers you a revisited traditional cuisine, full of authenticity. A moment of pure indulgence awaits you."
        ],
        "it": [
          "Riscoprite i sapori di un tempo a L'Avenue. Il nostro chef vi propone una cucina tradizionale rivisitata, ricca di autenticità. Vi aspetta un momento di pura indulgenza."
        ],
        "fr": [
          "Redécouvrez les saveurs d'antan à L'Avenue. Notre chef vous propose une cuisine traditionnelle revisitée, pleine d'authenticité. Un moment de pure gourmandise vous attend."
        ],
        "es": [
          "Redescubra los sabores de antaño en L'Avenue. Nuestro chef le propone una cocina tradicional revisitada, llena de autenticidad. Le espera un momento de puro placer."
        ],
        "nl": [
          "Herontdek de smaken van vroeger bij L'Avenue. Onze chef biedt je een herontdekte traditionele keuken, vol authenticiteit. Er wacht je een moment van pure verwennerij."
        ]
      },
