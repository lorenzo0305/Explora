  "rdfs:comment": {
    "de": [
      "Außerdem: Kommt man nicht ins Theater, um an Geschichten zu glauben, die einem helfen, die Realität besser zu bewältigen?"
    ],
    "en": [
      "After all, don't we come to the theater to believe in stories that help us live better in the real world?"
    ],
    "it": [
      "Dopo tutto, non veniamo a teatro per credere in storie che ci aiutano a vivere meglio nel mondo reale?"
    ],
    "fr": [
      "D’ailleurs, ne vient-on pas au théâtre pour croire à des histoires qui aident à mieux vivre la réalité ?"
    ],
    "nl": [
      "Komen we tenslotte niet naar het theater om te geloven in verhalen die ons helpen om beter met de werkelijkheid om te gaan?"
    ],
    "es": [
      "Al fin y al cabo, ¿no venimos al teatro para creer en historias que nos ayuden a vivir mejor en el mundo real?"
    ]
  },
