  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a67df176-d0fa-3df6-ad84-345dd4db38cb",
      "dc:description": {
        "de": [
          "Entdeckung und Einführung in das Reiten durch das Reitzentrum\n\nVon 6 bis 12 Jahren\n\nReitzentrum\n\nBeschreibung: Entdeckung und Besuch des Reitzentrums von Hardelot, gefolgt von einem einstündigen Einführungskurs. 15?/Kind. Anmeldungen sind unbedingt erforderlich beim Fremdenverkehrsamt: 03.21.83.51.02."
        ],
        "en": [
          "Discovery and introduction to horse riding at the Centre Equestre\n\nAges 6 to 12\n\nEquestrian Center\n\nDescription: Discovery and visit of the Hardelot Equestrian Center followed by a 1-hour introductory lesson. 15/child. Registration essential at the Tourist Information Office: 03.21.83.51.02."
        ],
        "it": [
          "Introduzione all'equitazione presso il Centre équestre\n\nDa 6 a 12 anni\n\nCentro equestre\n\nDescrizione: scoperta e visita del centro ippico Hardelot seguita da una lezione introduttiva di 1 ora. 15 per bambino. Iscrizione obbligatoria presso l'Ufficio informazioni turistiche: 03.21.83.51.02."
        ],
        "fr": [
          "Découverte et Initiation à l’équitation par le Centre équestre\n\nDe 6 à 12 ans\n\nCentre équestre\n\nDescriptif : Découverte et visite du Centre équestre d’Hardelot suivi d’un cours d’initiation d’1h. 15€/enfant. Inscriptions indispensables au Bureau d’Information Touristique : 03.21.83.51.02."
        ],
        "nl": [
          "Kennismaking met paardrijden op het Centre équestre\n\nVan 6 tot 12 jaar\n\nHippisch Centrum\n\nOmschrijving: Ontdekking en bezoek aan het Hardelot ruitersportcentrum gevolgd door een kennismakingsles van 1 uur. 15 per kind. Aanmelding noodzakelijk bij de VVV: 03.21.83.51.02."
        ],
        "es": [
          "Iniciación a la equitación en el Centre équestre\n\nDe 6 a 12 años\n\nCentro ecuestre\n\nDescripción: Descubrimiento y visita del Centro Ecuestre Hardelot seguido de una clase introductoria de 1 hora. 15 por niño. Imprescindible inscribirse en la Oficina de Turismo: 03.21.83.51.02."
        ]
      },
