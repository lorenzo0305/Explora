  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0644f9c2-dada-31a5-b54e-15f63fb77cf6",
      "dc:description": {
        "de": [
          "Mit der Familie oder mit Freunden, ganz nach Ihren Wünschen, machen Sie einen Spaziergang von einer Stunde oder mehr, zwischen Wegen und grasbewachsenen Böschungen, zwischen Feldern und Unterholz, für eine völlige Abwechslung."
        ],
        "en": [
          "As a family or with friends, you can set off for a walk of an hour or more, between paths and grassy slopes, between fields and undergrowth, for a complete change of scenery."
        ],
        "it": [
          "Con la famiglia o gli amici, a scelta, si può partire per una passeggiata di un'ora o più, tra sentieri e pendii erbosi, tra campi e sottobosco, per cambiare completamente scenario."
        ],
        "fr": [
          "En famille ou entre amis, selon vos désirs, vous partirez pour une promenade d'une heure ou plus, entre chemins et talus herbeux, entre champs et sous-bois, pour un complet dépaysement."
        ],
        "nl": [
          "Met je familie of vrienden kun je, als je wilt, een wandeling van een uur of meer maken, tussen paden en grashellingen, tussen velden en kreupelhout, voor een complete verandering van omgeving."
        ],
        "es": [
          "En familia o con amigos, si lo desea, puede dar un paseo de una hora o más, entre caminos y laderas cubiertas de hierba, entre campos y maleza, para cambiar completamente de aires."
        ]
      },
