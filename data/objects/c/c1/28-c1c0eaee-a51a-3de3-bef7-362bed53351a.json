  "rdfs:comment": {
    "de": [
      "Restaurant mit Direktvermarktung Produzenten Karte wöchentlich wechselnd je nach Anlieferung.\nPrivatisierungen für bis zu 50 Personen, Familienfeiern, Seminare und Firmenschulungen..\nZögern Sie nicht, uns für weitere Informationen zu kontaktieren."
    ],
    "en": [
      "Restaurant in direct producers card changing every week according to the arrivals.\nPrivatization up to 50 persons, family parties, seminars and company training..\nDo not hesitate to contact us for any further information."
    ],
    "it": [
      "Ristorante con produttori in carne e ossa. Il menu cambia ogni settimana in base agli arrivi.\nPrivatizzazione fino a 50 persone, feste di famiglia, seminari e formazione aziendale..\nNon esitate a contattarci per qualsiasi ulteriore informazione."
    ],
    "fr": [
      "Restaurant en direct producteurs carte changeant chaque semaine en fonction des arrivages.\nPrivatisation jusqu'à 50 personnes, fêtes de famille, séminaire et formation d'entreprise... \nN'hésitez pas à nous contacter pour toute information complémentaire."
    ],
    "es": [
      "Restaurante con productores en vivo. El menú cambia cada semana según las llegadas.\nPrivatización hasta 50 personas, fiestas familiares, seminarios y formación de empresas..\nNo dude en ponerse en contacto con nosotros para obtener más información."
    ],
    "nl": [
      "Restaurant met levende producenten. Menu verandert elke week afhankelijk van de aankomst.\nPrivatisering tot 50 personen, familiefeesten, seminaries en bedrijfsopleidingen..\nAarzel niet om contact met ons op te nemen voor meer informatie."
    ]
  },
