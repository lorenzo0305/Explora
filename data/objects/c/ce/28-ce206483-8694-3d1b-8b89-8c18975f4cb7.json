  "rdfs:comment": {
    "de": [
      "Wir verbinden Geselligkeit, gutes Essen mit der Familie und mit Freunden. Alle angebotenen Gerichte sind hausgemacht und werden mit direkt aus Italien importierten Produkten zubereitet.\n\nUnser Team empfängt Sie 7 Tage die Woche!"
    ],
    "en": [
      "We combine conviviality with good food for family and friends. All our dishes are homemade, using products imported directly from Italy.\n\nOur teams welcome you 7 days a week!"
    ],
    "it": [
      "Uniamo la convivialità alla buona cucina per la famiglia e gli amici. Tutti i nostri piatti sono fatti in casa, utilizzando prodotti importati direttamente dall'Italia.\n\nI nostri team vi accolgono 7 giorni su 7!"
    ],
    "fr": [
      "Nous allions convivialité, bons repas en famille et entre amis. Tous les plats proposés sont faits maison et réalisés avec des produits directement importés d’Italie.\n\nNos équipes vous reçoivent 7 jours sur 7 !"
    ],
    "nl": [
      "We combineren gezelligheid met lekker eten voor familie en vrienden. Al onze gerechten zijn huisgemaakt, met producten die rechtstreeks uit Italië worden geïmporteerd.\n\nOnze teams heten je 7 dagen per week welkom!"
    ],
    "es": [
      "Combinamos la convivencia con la buena comida para la familia y los amigos. Todos nuestros platos son caseros, con productos importados directamente de Italia.\n\nNuestros equipos le dan la bienvenida los 7 días de la semana"
    ]
  },
