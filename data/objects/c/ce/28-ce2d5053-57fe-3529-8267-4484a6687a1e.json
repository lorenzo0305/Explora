  "rdfs:comment": {
    "de": [
      "Bei O'Burger Picard genießen Sie hausgemachte Burger, die aus hochwertigen Produkten zubereitet werden. Burger vor Ort in einem Bus oder zum Mitnehmen!"
    ],
    "en": [
      "At O'Burger Picard, enjoy homemade burgers, cooked with quality products. Burger to eat on the spot in a bus or to take away!"
    ],
    "it": [
      "Da O'Burger Picard potrete gustare hamburger fatti in casa, cucinati con prodotti di qualità. Hamburger da mangiare sul posto in autobus o da portare via!"
    ],
    "fr": [
      "Chez O'Burger Picard, dégustez des burgers faits maison, cuisinés à partir de produits de qualité. Burger à déguster sur place dans un bus ou à emporter !"
    ],
    "es": [
      "En O'Burger Picard, podrá disfrutar de hamburguesas caseras, cocinadas con productos de calidad. ¡Hamburguesas para comer in situ en autobús o para llevar!"
    ],
    "nl": [
      "Bij O'Burger Picard kun je genieten van huisgemaakte hamburgers, bereid met kwaliteitsproducten. Hamburger om ter plekke in de bus op te eten of om mee te nemen!"
    ]
  },
