      "dc:description": {
        "de": [
          "Bei O'Burger Picard genießen Sie hausgemachte Burger, die aus hochwertigen Produkten zubereitet werden. Burger vor Ort in einem Bus genießen oder mitnehmen!\nLieferung in der Umgebung von Ons-en-Bray möglich."
        ],
        "en": [
          "At O'Burger Picard, enjoy homemade burgers, cooked with quality products. Burger to eat on the spot in a bus or to take away!\nDelivery available around Ons-en-Bray."
        ],
        "it": [
          "Da O'Burger Picard potrete gustare hamburger fatti in casa, cucinati con prodotti di qualità. Hamburger da gustare sul posto in autobus o da portare via!\nConsegna possibile nei dintorni di Ons-en-Bray."
        ],
        "fr": [
          "Chez O'Burger Picard, dégustez des burgers faits maison, cuisinés à partir de produits de qualité. Burger à déguster sur place dans un bus ou à emporter !\nLivraison possible autour d'Ons-en-Bray."
        ],
        "es": [
          "En O'Burger Picard, podrá disfrutar de hamburguesas caseras, cocinadas con productos de calidad. Hamburguesas para degustar in situ en autobús o para llevar\nEntrega posible en los alrededores de Ons-en-Bray."
        ],
        "nl": [
          "Bij O'Burger Picard kun je genieten van huisgemaakte hamburgers, bereid met kwaliteitsproducten. Hamburger om ter plekke in de bus van te genieten of om mee te nemen!\nLevering mogelijk rond Ons-en-Bray."
        ]
      },
