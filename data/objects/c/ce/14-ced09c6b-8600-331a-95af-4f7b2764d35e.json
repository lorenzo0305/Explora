  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/48a41ff2-3c4f-397a-a004-c67dd6666087",
      "dc:description": {
        "de": [
          "Thé dansant organisiert von der Stadt Berck-sur-Mer.\nVon 14:30 bis 19:30 Uhr im Kursaal.\nEddy Busy und Eva sorgen für Unterhaltung. Preis: 10 ?\nInfos und Reservierung unter +33(0)3 21 89 37 29 oder csm@berck-sur-mer.com"
        ],
        "en": [
          "Tea dance organized by the town of Berck-sur-Mer.\nFrom 2.30pm to 7.30pm at the kursaal.\nEntertainment by Eddy Busy and Eva. Price:10?\nInfo and booking +33(0)3 21 89 37 29 or csm@berck-sur-mer.com"
        ],
        "it": [
          "Ballo del tè organizzato dalla città di Berck-sur-Mer.\nDalle 14.30 alle 19.30 al Kursaal.\nIntrattenimento di Eddy Busy ed Eva. Prezzo: 10?\nInformazioni e prenotazioni: +33(0)3 21 89 37 29 o csm@berck-sur-mer.com"
        ],
        "fr": [
          "Thé dansant organisé par la ville de Berck-sur-Mer. \nDe 14h30 à 19h30 au kursaal. \nAnimation assurée par Eddy Busy et Eva. Tarif :10€ \nInfos et réservation eu +33(0)3 21 89 37 29 ou csm@berck-sur-mer.com"
        ],
        "nl": [
          "Theedans georganiseerd door de stad Berck-sur-Mer.\nVan 14.30 tot 19.30 uur in het Kursaal.\nAnimatie door Eddy Busy en Eva. Prijs: 10?\nInformatie en reserveren: +33(0)3 21 89 37 29 of csm@berck-sur-mer.com"
        ],
        "es": [
          "Baile del té organizado por la ciudad de Berck-sur-Mer.\nDe 14h30 a 19h30 en el Kursaal.\nAnimación a cargo de Eddy Busy y Eva. Precio: 10?\nInformación y reservas: +33(0)3 21 89 37 29 o csm@berck-sur-mer.com"
        ]
      },
