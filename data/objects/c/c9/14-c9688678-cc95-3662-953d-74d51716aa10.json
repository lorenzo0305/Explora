  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ce634e81-56ea-3c36-bcc1-f178eea73196",
      "dc:description": {
        "de": [
          "Irish Pub mit familiärer Atmosphäre, mit hausgemachter und lokaler Küche am Mittag und Tapas am Abend. Übertragung von Sportereignissen, Themenabende, Konzerte, ...\n\nNachhaltige Ansätze: \"Null Plastik\", \"Nachhaltige Ernährung\", LGBTQI+ Ort"
        ],
        "en": [
          "Irish pub with a family atmosphere, home-cooked local cuisine at lunchtime and tapas in the evening. Sports broadcasts, theme evenings, concerts, ...\n\nSustainable approaches: \"zero plastic\", \"sustainable food\", LGBTQI+ venue"
        ],
        "it": [
          "Pub irlandese dall'atmosfera familiare, con cucina casalinga e locale a pranzo e tapas la sera. Trasmissioni sportive, serate a tema, concerti, ecc.\n\nApprocci sostenibili: \"zero plastica\", \"cibo sostenibile\", locale LGBTQI+, ecc"
        ],
        "fr": [
          "Pub irlandais à l'ambiance familiale, avec une cuisine maison et locale le midi et tapas le soir. Diffusion d'événements sportifs, soirées à thème, concerts, ...\n\nDémarches durables : \"zéro plastique\", \"alimentation durable\", lieu LGBTQI+"
        ],
        "es": [
          "Pub irlandés de ambiente familiar, cocina casera y local al mediodía y tapas por la noche. Retransmisiones deportivas, veladas temáticas, conciertos, etc.\n\nEnfoques sostenibles: \"plástico cero\", \"comida sostenible\", local LGBTQI+, etc"
        ],
        "nl": [
          "Ierse pub met een familiale sfeer, huisgemaakte en lokale gerechten tijdens de lunch en tapas 's avonds. Sportuitzendingen, thema-avonden, concerten, enz.\n\nDuurzame aanpak: \"nul plastic\", \"duurzaam eten\", LGBTQI+ locatie, enz"
        ]
      },
      "@type": [
        "Description"
      ],
