  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0487a6c6-1d21-3ef8-aa25-b5a2e142bb29",
      "dc:description": {
        "de": [
          "Samstag, den 14. März 2026\n16 Uhr - \"Le passage de Victor Hugo à Montreuil-sur-mer\", moderiert von Gérard Robette-Papet.\nEintritt 5?\n\nSamstag, 18. April 2026\n16:00 Uhr - \"Das religiöse und kulturelle Erbe von Montreuil-sur-Mer\", moderiert von Bruno Béthouart.\nEintritt 5?\n       \nSamstag, 6. Juni 2026\n16:00 Uhr - \"Das mystische Lamm der Brüder Van Eyck\", moderiert von Olivier Ségard.\nEintritt 5?"
        ],
        "en": [
          "Saturday, March 14, 2026\n4pm - \"Victor Hugo's passage through Montreuil-sur-mer\", hosted by Gérard Robette-Papet.\nAdmission 5?\n\nSaturday, April 18, 2026\n16h - \"Montreuil-sur-mer's religious and cultural heritage\" hosted by Bruno Béthouart.\nAdmission 5?\n       \nSaturday June 6, 2026\n16h - \"L'Agneau mystique des frères Van Eyck\" animated by Olivier Ségard.\nAdmission 5?"
        ],
        "it": [
          "Sabato 14 marzo 2026\nore 16.00 - \"Il passaggio di Victor Hugo a Montreuil-sur-mer\", conferenza di Gérard Robette-Papet.\nIngresso 5?\n\nSabato 18 aprile 2026\nore 16.00 - \"Il patrimonio religioso e culturale di Montreuil-sur-mer\", conferenza di Bruno Béthouart.\nIngresso: 5 €?\n       \nSabato 6 giugno 2026\nore 16.00 - \"L'Agnello mistico dei fratelli Van Eyck\", condotto da Olivier Ségard.\nIngresso: 5 €?"
        ],
        "fr": [
          "Samedi 14 mars 2026\n16h - \"Le passage de Victor Hugo à Montreuil-sur-mer\" animée par Gérard Robette-Papet.\nEntrée 5€\n\nSamedi 18 avril 2026\n16h - \"Le patrimoine religieux et culturel de Montreuil-sur-mer\" animée par Bruno Béthouart.\nEntrée 5€\n       \nSamedi 6 juin 2026\n16h - \"L'Agneau mystique des frères Van Eyck\" animée par Olivier Ségard.\nEntrée 5€"
        ],
        "nl": [
          "Zaterdag 14 maart 2026\n16.00 uur - \"Victor Hugo's passage door Montreuil-sur-mer\", lezing door Gérard Robette-Papet.\nToegang 5?\n\nZaterdag 18 april 2026\n16u - \"Het religieuze en culturele erfgoed van Montreuil-sur-mer\", lezing door Bruno Béthouart.\nToegang: €5?\n       \nZaterdag 6 juni 2026\n16u00 - \"Het Lam Gods van de gebroeders Van Eyck\" onder leiding van Olivier Ségard.\nToegangsprijs: €5?"
        ],
        "es": [
          "Sábado 14 de marzo de 2026\n16:00 h - \"El paso de Victor Hugo por Montreuil-sur-mer\", conferencia de Gérard Robette-Papet.\nEntrada 5?\n\nSábado 18 de abril de 2026\n16:00 h - \"El patrimonio religioso y cultural de Montreuil-sur-mer\", conferencia a cargo de Bruno Béthouart.\nEntrada: 5?\n       \nSábado 6 de junio de 2026\n16:00 h - \"El Cordero místico de los hermanos Van Eyck\", a cargo de Olivier Ségard.\nEntrada: 5?"
        ]
      },
