  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f265d2f9-bbef-345c-afd4-d7000a5004e6",
      "dc:description": {
        "de": [
          "Restaurant auf zwei Ebenen, im Keller aus dem 18. Jahrhundert oder im Erdgeschoss.\nFranzösisch-mexikanische Küche \"It's more than rib's\"\nBarteil, in der Terasse oder im Saal im Erdgeschoss\n\nChimichurri- oder Chipotle-Saucen (mit Chili) zu Burgern, Bavette oder auch Rindertartar\nBier vom Fass, Cocktails mit oder ohne Alkohol, lokale Biere in Flaschen\nGemütliches Ambiente mit Musik"
        ],
        "en": [
          "Restaurant on two levels, in the 18th-century cellar or on the first floor.\nIt's more than rib's\" Franco-Mexican cuisine\nBar area, terasse or ground-floor dining room\n\nChimichurri or chipotle (spicy) sauces for burgers, flank steak or beef tartare\nDraught beers, cocktails with or without alcohol, bottled local beers\nCosy, musical atmosphere"
        ],
        "it": [
          "Ristorante su due livelli, in una cantina del XVIII secolo o al piano terra.\nCucina franco-messicana \"It's more than rib's\"\nArea bar, sulla terrazza o nella sala da pranzo al piano terra\n\nSalse Chimichurri o chipotle (piccanti) per accompagnare hamburger, flank steak o tartare di manzo\nBirre alla spina, cocktail con o senza alcol, birre locali in bottiglia\nAtmosfera accogliente e musicale"
        ],
        "fr": [
          "Restaurant sur deux niveaux, en cave du XVIIIe siècle ou au rez-de-chaussée. \nCuisine franco-mexicaine \"It's more than rib's\"\nPartie bar, en terasse ou en salle au rez-de-chaussée\n\nSauces chimichurri ou chipotle (pimentées) pour accompagner les burgers, la bavette ou encore le tartare de boeuf\nBières en pression, cocktails avec ou sans alcool, bières locales en bouteilles\nAmbiance cosy et musicale "
        ],
        "es": [
          "Restaurante en dos niveles, en una bodega del siglo XVIII o en la planta baja.\nCocina franco-mexicana \"Es más que costillas\nZona de bar, en la terraza o en el comedor de la planta baja\n\nSalsas chimichurri o chipotle (picante) para acompañar hamburguesas, arrachera o tartar de ternera\nCervezas de barril, cócteles con o sin alcohol, cervezas locales embotelladas\nAmbiente acogedor y musical"
        ],
        "nl": [
          "Restaurant op twee niveaus, in een 18e-eeuwse kelder of op de begane grond.\nHet is meer dan rib's\" Frans-Mexicaanse keuken\nBar, op het terras of in de eetzaal op de begane grond\n\nChimichurri of chipotle (pikante) sauzen bij hamburgers, steak of tartaar van rundvlees\nTapbieren, cocktails met of zonder alcohol, lokale bieren in flessen\nGezellige, muzikale sfeer"
        ]
      },
