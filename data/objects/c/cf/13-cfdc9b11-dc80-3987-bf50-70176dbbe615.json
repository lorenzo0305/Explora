  "rdfs:comment": {
    "de": [
      "Im Herzen des Staatswaldes von Mormal empfängt Sie die Auberge du Coucou in einer freundlichen Atmosphäre und bietet Ihnen eine traditionelle saisonale Küche."
    ],
    "en": [
      "In the heart of the Mormal national forest, the Auberge du Coucou welcomes you in a friendly atmosphere and offers traditional seasonal cuisine."
    ],
    "it": [
      "Nel cuore della foresta nazionale di Mormal, l'Auberge du Coucou vi accoglie in un'atmosfera amichevole e offre una cucina tradizionale di stagione."
    ],
    "fr": [
      "Au coeur de la forêt domaniale de Mormal, l'Auberge du Coucou vous accueille dans une ambiance conviviale et vous propose une cuisine traditionnelle de saison."
    ],
    "nl": [
      "In het hart van het nationale bos van Mormal verwelkomt de Auberge du Coucou je in een vriendelijke sfeer en biedt een traditionele seizoenskeuken."
    ],
    "es": [
      "En el corazón del bosque nacional de Mormal, el Auberge du Coucou le da la bienvenida en un ambiente acogedor y le ofrece cocina tradicional de temporada."
    ]
  },
