  "rdfs:comment": {
    "de": [
      "Vom Belvédère de Long aus, auf der Chaussée du Catelet, tauchen Sie ein in das ideale Somme-Tal, direkt am Wasser."
    ],
    "en": [
      "From the Belvédère de Long, on the chaussée du Catelet, you can immerse yourself in the water of the Vallée de Somme, an ideal valley."
    ],
    "it": [
      "Dal Belvédère de Long, sulla chaussée du Catelet, ci si può immergere nelle acque della Vallée de Somme, una valle ideale."
    ],
    "fr": [
      "Du Belvédère de Long, sur la chaussée du Catelet, une immersion à fleur d'eau en Vallée de Somme, une vallée idéale."
    ],
    "nl": [
      "Vanaf de Belvédère de Long, aan de chaussée du Catelet, kun je je onderdompelen in het water van de Vallée de Somme, een ideale vallei."
    ],
    "es": [
      "Desde el Belvédère de Long, en la chaussée du Catelet, podrá sumergirse en las aguas del Vallée de Somme, un valle ideal."
    ]
  },
