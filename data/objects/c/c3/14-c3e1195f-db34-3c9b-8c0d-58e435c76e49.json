  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/241fc3db-ec9d-35fb-b068-7af417e2f01a",
      "dc:description": {
        "de": [
          "Das Restaurant l'Orée du Bois empfängt Sie im Herzen des Dorfes Condette.\nGenießen Sie frische Saisonprodukte und hausgemachte Speisen in einem schlichten Zen-Rahmen.\nWöchentlich wechselnde Schiefertafel: 3 Vorspeisen 3 Hauptgerichte 3 Desserts"
        ],
        "en": [
          "The Orée du Bois restaurant welcomes you to the heart of the village of Condette.\nEnjoy fresh seasonal produce and homemade dishes in a zen, uncluttered setting.\nWeekly changing menu: 3 starters 3 main courses 3 desserts"
        ],
        "it": [
          "Il ristorante Orée du Bois vi accoglie nel cuore del villaggio di Condette.\nVenite a gustare i prodotti freschi di stagione e i piatti fatti in casa in un ambiente zen e senza fronzoli.\nMenu a variazione settimanale: 3 antipasti 3 piatti principali 3 dessert"
        ],
        "fr": [
          "Le restaurant l’Orée du Bois vous accueille au cœur du village de Condette.\nVenez déguster des produits frais de saison et du fait maison dans un cadre zen et épuré.\nArdoise qui change chaque semaine : 3 entrées 3 plats 3 desserts"
        ],
        "nl": [
          "Het restaurant Orée du Bois verwelkomt je in het hart van het dorp Condette.\nKom genieten van verse seizoensproducten en huisbereide gerechten in een zen, opgeruimd kader.\nWekelijks wisselend menu: 3 voorgerechten 3 hoofdgerechten 3 desserts"
        ],
        "es": [
          "El restaurante Orée du Bois le da la bienvenida al corazón del pueblo de Condette.\nVenga a degustar productos frescos de temporada y platos caseros en un ambiente zen y despejado.\nMenú semanal: 3 entrantes 3 platos principales 3 postres"
        ]
      },
      "@type": [
        "Description"
      ],
