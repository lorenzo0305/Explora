  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5fba8943-d3d5-3359-bc0a-a9889bc67f75",
      "dc:description": {
        "de": [
          "Wir haben eine abwechslungsreiche Karte mit Sandwiches, die wir aus Salaten / Paninis / Hamburgern / Amerikanern / kalten oder warmen Sandwiches zusammenstellen. Wir achten besonders auf Hygiene und Gastfreundschaft."
        ],
        "en": [
          "We have a varied menu of sandwiches we make salads / paninis / hamburger / American / cold or hot sandwiches. We pay particular attention to hygiene and welcome."
        ],
        "it": [
          "Abbiamo un menu vario di panini, tra cui insalate / panini / hamburger / americani / panini freddi o caldi. Prestiamo particolare attenzione all'igiene e all'accoglienza."
        ],
        "fr": [
          "Nous avons une carte variée de sandwichs nous composent des salades / paninis / hamburger / des américains / sandwichs froid ou chauds. Nous apportons une attention particulière à l’hygiène et l'accueil."
        ],
        "nl": [
          "Wij hebben een gevarieerd menu van broodjes waaronder salades / panini's / hamburgers / Amerikanen / koude of warme broodjes. Wij besteden bijzondere aandacht aan hygiëne en ontvangst."
        ],
        "es": [
          "Disponemos de una variada carta de bocadillos que incluye ensaladas / paninis / hamburguesas / americanos / bocadillos fríos o calientes. Prestamos especial atención a la higiene y la recepción."
        ]
      },
