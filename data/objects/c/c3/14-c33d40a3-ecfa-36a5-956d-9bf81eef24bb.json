      "@id": "https://data.datatourisme.fr/7e557471-8a82-3539-920c-3ae4af68b969",
      "dc:description": {
        "de": [
          "Festliches Buffet und Champomy\nAnimationen, Musik und Überraschungen!\nMach dich schick!\nVon 14:30 bis 17:00 Uhr im Fun House. Partybuffet und Champomy, Animationen, Musik und Überraschungen für 03/14-Jährige 15 ?/Party"
        ],
        "en": [
          "Festive buffet and Champomy\nEntertainment, music and surprises!\nDress to the nines!\nFrom 2.30pm to 5pm at the Fun House. Party buffet and champomy, entertainment, music and surprises for 03/14 year olds 15 ?/Party"
        ],
        "it": [
          "Buffet festivo e Champomy\nIntrattenimento, musica e sorprese!\nVestitevi a festa!\nDalle 14.30 alle 17.00 presso la Fun House. Buffet festivo e champomy, animazione, musica e sorprese per i ragazzi dai 03 ai 14 anni 15 ?/Party"
        ],
        "fr": [
          "Buffet de fête et Champomy\nAnimations, musique et surprises !\nMets toi sur ton 31 ! \nDe 14h30 à 17h00 à la Fun House. Buffet de fête et champomy, animations, musique et surprises pour les 03/14 ans 15 €/Party"
        ],
        "nl": [
          "Feestelijk buffet en Champomy\nEntertainment, muziek en verrassingen!\nKleed je tot in de puntjes!\nVan 14.30 tot 17.00 uur in het Fun House. Feestbuffet en champomy, entertainment, muziek en verrassingen voor 03/14 jarigen 15 ?/Party"
        ],
        "es": [
          "Buffet festivo y Champomy\nEntretenimiento, música y sorpresas\n¡Vístete de punta en blanco!\nDe 14h30 a 17h00 en la Fun House. Buffet festivo y champomy, entretenimiento, música y sorpresas para 03/14 años 15 € /Party"
        ]
      },
