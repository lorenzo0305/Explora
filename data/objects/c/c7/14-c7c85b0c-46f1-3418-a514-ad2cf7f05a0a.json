  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/10793b8c-f69f-3e66-a9db-6d0a296ddf1d",
      "dc:description": {
        "de": [
          "Machen Sie eine Wanderung, um Aix-Noulette zu entdecken. Ein Vormittag mit Wanderungen durch die Hügel des Artois, unterbrochen von Kostproben lokaler Biere und regionaler Käsesorten. Ein bisschen Sport und viel Trost."
        ],
        "en": [
          "Go for a walk to discover Aix-Noulette. A morning of hiking on the hills of Artois punctuated by tastings of local beers and regional cheeses. A bit of sport and a lot of comfort."
        ],
        "it": [
          "Un'escursione alla scoperta di Aix-Noulette. Una mattinata di escursioni sulle colline dell'Artois, scandita da degustazioni di birre locali e formaggi regionali. Un po' di sport e molto comfort."
        ],
        "fr": [
          "Partez en rando à la découverte d'Aix-Noulette. Une matinée de randonnée pédestre sur les collines de l'Artois ponctuée de dégustations de bières locales et de fromages régionaux. Un peu de sport et beaucoup de réconfort."
        ],
        "es": [
          "Pasee para descubrir Aix-Noulette. Una mañana de senderismo por las colinas de Artois, amenizada con degustaciones de cervezas locales y quesos regionales. Un poco de deporte y mucho confort."
        ],
        "nl": [
          "Maak een wandeling om Aix-Noulette te ontdekken. Een ochtend wandelen in de heuvels van de Artois, afgewisseld met proeverijen van lokale bieren en regionale kazen. Een beetje sport en veel comfort."
        ]
      },
