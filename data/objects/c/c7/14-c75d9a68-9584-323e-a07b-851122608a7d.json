  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab501952-034f-3bcf-90e9-6b74312f0a13",
      "dc:description": {
        "de": [
          "Die Stadt bietet Ihnen einen festlichen Tag mit Feuerschluckern, kreativen Workshops, musikalischer Unterhaltung mit Marielle Deroulel und Claude Chevalier und einem Fackelzug."
        ],
        "en": [
          "The town offers a festive day with fire-eaters, creative workshops, musical entertainment with Marielle Deroulel and Claude Chevalier and a torchlight procession."
        ],
        "it": [
          "La città offre una giornata di festa con mangiafuoco, laboratori creativi, intrattenimento musicale con Marielle Deroulel e Claude Chevalier e una fiaccolata."
        ],
        "fr": [
          "La ville vous propose une journée festive avec des cracheurs de feu, des ateliers créatifs, une animation musicale avec Marielle Deroulel et Claude Chevalier et une retraite aux flambeaux."
        ],
        "es": [
          "La ciudad ofrece una jornada festiva con tragafuegos, talleres creativos, animación musical con Marielle Deroulel y Claude Chevalier y un desfile de antorchas."
        ],
        "nl": [
          "De stad biedt een feestelijke dag met vuurspuwers, creatieve workshops, muzikaal entertainment met Marielle Deroulel en Claude Chevalier en een fakkeltocht."
        ]
      },
