  "rdfs:comment": {
    "de": [
      "Ausgehend von dem Gemälde Der Schwur auf die Freiheit von Jean-Louis-Joseph Hoyer lassen Gedichte, Erzählungen, Bilder und Zeugnisse die revolutionären Ideen wieder aufleben.\n\nKOSTENLOS\nAnmeldungen 03 23 59 91 20"
    ],
    "en": [
      "Based on the painting Le Serment à la liberté by Jean-Louis-Joseph Hoyer, poetry, stories, images and personal accounts bring revolutionary ideas to life.\n\nFREE\nRegistration 03 23 59 91 20"
    ],
    "it": [
      "Utilizzando il dipinto Le Serment à la liberté di Jean-Louis-Joseph Hoyer come punto di partenza, poesie, storie, immagini e testimonianze personali danno vita alle idee rivoluzionarie.\n\nGRATUITO\nPrenotazioni 03 23 59 91 20"
    ],
    "fr": [
      "A partir du tableau Le Serment à la liberté de Jean-Louis-Joseph Hoyer, poésie, récits, images et témoignages font revivre les idées révolutionnaires.\n\nGRATUIT\nInscriptions 03 23 59 91 20"
    ],
    "es": [
      "Partiendo del cuadro de Jean-Louis-Joseph Hoyer Le Serment à la liberté, poesías, relatos, imágenes y testimonios dan vida a las ideas revolucionarias.\n\nGRATIS\nReservas 03 23 59 91 20"
    ],
    "nl": [
      "Met het schilderij Le Serment à la liberté van Jean-Louis-Joseph Hoyer als uitgangspunt brengen poëzie, verhalen, beelden en persoonlijke verhalen revolutionaire ideeën tot leven.\n\nGRATIS\nBoekingen 03 23 59 91 20"
    ]
  },
