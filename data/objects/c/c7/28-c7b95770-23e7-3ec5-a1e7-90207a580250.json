  "rdfs:comment": {
    "de": [
      "Spezialitäten: Tintenfisch nach Mascaret-Art, traditionelle picardische Ficelle, Küstenfische, die je nach Ankunft zubereitet und auf dem Schiefertisch angeboten werden."
    ],
    "en": [
      "Specialities: Mascaret-style cuttlefish, traditional Picardy ficelle, coastal fish cooked according to arrival and offered by the slate."
    ],
    "it": [
      "Specialità: seppie alla mascara, ficelle tradizionali della Piccardia, pesce della costa cucinato in base all'arrivo e offerto sulla lavagna."
    ],
    "fr": [
      "Les Spécialités : les seiches façon Mascaret, la ficelle picarde traditionnelle, les poissons côtiers cuisinés selon l'arrivage et proposés à l'ardoise."
    ],
    "nl": [
      "Specialiteiten: inktvis op de wijze van Mascaret, traditionele Picardische ficelle, kustvis gekookt volgens aankomst en aangeboden op de lei."
