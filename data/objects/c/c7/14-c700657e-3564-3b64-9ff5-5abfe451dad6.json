  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e9bd0a58-6de9-3c0e-9212-3a280968fed0",
      "dc:description": {
        "de": [
          "Wurstwaren vom Bauernhof. Mit Getreide gefüttertes Schwein und Schinken ohne Zusatz von Nitritpökelsalz.\nSpezialitäten: Knoblauchwurst, weißer und geräucherter Schinken, Pastete, Rillettes ..."
        ],
        "en": [
          "Farmhouse deli meats. Pork fed with cereals and ham without added nitrite salt.\nSpecialities: Garlic sausage, white and smoked ham, pâté, rillettes ..."
        ],
        "it": [
          "Salumi di fattoria. Carne di maiale alimentata con cereali e prosciutto senza sale nitrito aggiunto.\nSpecialità: salsiccia all'aglio, prosciutto bianco e affumicato, paté, rillettes, ecc."
        ],
        "fr": [
          "Charcuteries fermières. Porc nourri aux céréales et jambon sans sel nitrité ajouté.\nSpécialités : Saucisson à l'ail, jambon blanc et fumé, pâté, rillettes ..."
        ],
        "es": [
          "Charcutería de granja. Carne de cerdo alimentada con cereales y jamón sin adición de sal de nitrito.\nEspecialidades: salchichas al ajillo, jamón blanco y ahumado, paté, rillettes, etc."
        ],
        "nl": [
          "Boerderij vleeswaren. Varkensvlees gevoed met granen en ham zonder toegevoegd nitrietzout.\nSpecialiteiten: knoflookworst, witte en gerookte ham, paté, rillettes, enz."
        ]
      },
