  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9bbb47ee-3c52-378f-9738-d3c23beef42e",
      "dc:description": {
        "de": [
          "Hotel mit 31 Zimmern für 1 bis 4 Personen. Restaurant mittags und abends geöffnet. Zugang rund um die Uhr. Kostenloses Wifi. All-you-can-eat-Frühstücksbuffet, Pauschalangebot Halbpension/Vollpension/Vrp\nGruppenzugang, 200m vom Stadtzentrum, 500m vom Strand, gegenüber dem Kasino, der Mediathek und dem Kino."
        ],
        "en": [
          "Hotel with 31 rooms for 1 to 4 people. Restaurant open for lunch and dinner. 24/24 access. Free Wifi. All-you-can-eat buffet breakfast, half-board/full-board/vrp package\nGroup access, 200m from town center, 500m from the beach, opposite the casino, media library and cinema."
        ],
        "it": [
          "Hotel con 31 camere da 1 a 4 persone. Ristorante aperto a pranzo e a cena. Accesso 24/24. Wifi gratuito. Colazione a buffet a volontà, pacchetto mezza pensione/pensione completa/vrp\nAccesso per gruppi, a 200 m dal centro città, a 500 m dalla spiaggia, di fronte al casinò, alla mediateca e al cinema."
        ],
        "fr": [
          "Hôtel de 31 chambres de 1 à 4 personnes. Restaurant ouvert midi et soir. Accés 24/24. Wifi gratuit. Petit déjeuner buffet à volonté, Forfait demi pension/ pension complète/ vrp\nAccès groupes, 200m du centre ville, 500m de la plage, face au casino, à la médiathèque et au cinéma."
        ],
        "nl": [
          "Hotel met 31 kamers voor 1 tot 4 personen. Restaurant open voor lunch en diner. 24/24 toegang. Gratis Wifi. All-you-can-eat ontbijtbuffet, halfpension/full-board/vrp pakket\nToegang voor groepen, 200m van het stadscentrum, 500m van het strand, tegenover het casino, de mediatheek en de bioscoop."
        ],
        "es": [
          "Hotel con 31 habitaciones para 1 a 4 personas. Restaurante abierto para el almuerzo y la cena. Acceso 24/24. Wifi gratuito. Desayuno buffet libre, media pensión, pensión completa y pensión completa\nAcceso para grupos, a 200 m del centro de la ciudad, a 500 m de la playa, frente al casino, la mediateca y el cine."
        ]
      },
