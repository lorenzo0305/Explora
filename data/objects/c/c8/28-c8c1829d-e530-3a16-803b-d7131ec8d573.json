      "dc:description": {
        "de": [
          "Institutionelle Brasserie in Douai auf dem Hauptplatz. Probieren Sie ihre Pommes frites oder genießen Sie ein Getränk auf der Terrasse. Vor Ort oder zum Mitnehmen."
        ],
        "en": [
          "Institutional brasserie in Douai on the main square, come and try our fries or enjoy a drink on the terrace. On site or to take away."
        ],
        "it": [
          "Brasserie istituzionale a Douai, sulla piazza principale, dove potrete assaggiare le sue patatine fritte o sorseggiare un drink sulla terrazza. In loco o da asporto."
        ],
        "fr": [
          "Brasserie institutionnelle à Douai sur la place principale, venez goûter ses frites ou déguster un verre en terrasse. Sur place ou à emporter."
        ],
        "nl": [
          "Institutionele brasserie in Douai op het centrale plein. Kom de frietjes proeven of geniet van een drankje op het terras. Ter plaatse of om mee te nemen."
        ],
        "es": [
          "Brasserie institucional en Douai, en la plaza mayor. Venga a probar sus patatas fritas o a tomar una copa en la terraza. En el local o para llevar."
        ]
