  "rdfs:comment": {
    "de": [
      "Bierbuik, um mittags und abends gut, gesund und lokal zu essen. Eine in der flämischen Region verwurzelte Küche des Küchenchefs Florent Ladeyn, die nur aus lokalen Produkten zubereitet und auf dem Holzfeuer gegart wird."
    ],
    "en": [
      "Bierbuik, to eat well, healthy and local for lunch and dinner. A cuisine rooted in the Flemish soil, from the chef Florent Ladeyn, elaborated only from local products and cooked on wood fire."
    ],
    "it": [
      "Bierbuik, per una cucina buona, sana e locale a pranzo e a cena. La cucina è radicata nella terra fiamminga ed è preparata dallo chef Florent Ladeyn, utilizzando solo prodotti locali e cucinando a legna."
    ],
    "fr": [
      "Bierbuik, pour manger bien, sain et local le midi et le soir. Une cuisine enracinée dans le terroir flamand, du chef Florent Ladeyn, élaborée uniquement à partir de produits locaux et cuite au feu de bois."
    ],
    "nl": [
      "Bierbuik, voor goed, gezond en lokaal eten tijdens lunch en diner. De keuken is geworteld in de Vlaamse bodem en wordt bereid door chef Florent Ladeyn, met uitsluitend lokale producten en gekookt op houtvuur."
    ],
    "es": [
      "Bierbuik, para comer y cenar comida buena, sana y local. La cocina, arraigada en la tierra flamenca, está elaborada por el chef Florent Ladeyn con productos locales y cocinada al fuego de leña."
    ]
  },
