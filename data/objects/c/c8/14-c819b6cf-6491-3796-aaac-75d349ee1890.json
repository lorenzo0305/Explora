  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a8a74531-1bb3-3c46-92d3-41fc7f84c5f4",
      "dc:description": {
        "de": [
          "\"Wandern und Entspannen\"\n\nWanderung zur Entdeckung des Territoriums, organisiert vom Fremdenverkehrsamt Haut Pays Côté d'Opale\nAb 12 Jahren - Auf Anmeldung\nSamstag, 6. Juli 9.30 bis 12.30 Uhr\n\nAuf dem Programm: Wanderung - Show - Ausstellungen - Workshops - Konzert\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ],
        "en": [
          "\"Walking and relaxing\n\nDiscovery walk organized by the Haut Pays Côté d'Opale Tourist Office\nFrom 12 years old - Registration required\nSaturday, July 6 9:30 am to 12:30 pm\n\nProgram: walk - show - exhibitions - workshops - concert\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ],
        "it": [
          "\"Camminare e rilassarsi\n\nPasseggiata di scoperta organizzata dall'Ufficio del Turismo dell'Haut Pays Côté d'Opale\nA partire dai 12 anni - Iscrizione obbligatoria\nSabato 6 luglio dalle 9.30 alle 12.30\n\nIn programma: passeggiata - spettacolo - mostre - laboratori - concerto\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ],
        "fr": [
          "\"Marche et détente\"\n\nRandonnée découverte du territoire organisée par l'Office de Tourisme Haut Pays Côté d'Opale\nDès 12 ans - Sur inscription\nSamedi 6 juillet 9h30 à 12h30\n\nAu programme : marche - spectacle - expos - ateliers - concert\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ],
        "nl": [
          "\"Wandelen en ontspannen\n\nOntdekkingswandeling georganiseerd door het Office du Tourisme du Haut Pays Côté d'Opale\nVanaf 12 jaar - Inschrijving verplicht\nZaterdag 6 juli 9.30 tot 12.30 uur\n\nOp het programma: wandeling - voorstelling - tentoonstellingen - workshops - concert\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ],
        "es": [
          "\" Pasear y relajarse\n\nPaseo de descubrimiento organizado por la Oficina de Turismo de Haut Pays Côté d'Opale\nA partir de 12 años - Inscripción obligatoria\nSábado 6 de julio de 9h30 a 12h30\n\nPrograma: paseo - espectáculo - exposiciones - talleres - concierto\n\n(03 21 41 70 07 / animations@apetitspas.net)"
        ]
      },
      "@type": [
        "Description"
