  "rdfs:comment": {
    "de": [
      "Haben Sie Lust auf einen sportlichen Moment in einer geschützten natürlichen Umgebung? Durchstreifen Sie den Golf de Champagne mit seinen 18 Löchern, der in 70 Hektar Ebenen und Täler eingebettet ist. Das Glück liegt ebenso im Blick wie im Spiel ..."
    ],
    "en": [
      "Looking for a moment of sport in an unspoilt natural setting? Take a trip to the Champagne golf course with its 18 holes, nestled in 70 hectares of plains and valleys. Happiness is as much in the eyes as in the game..."
    ],
    "it": [
      "Volete praticare sport in un ambiente naturale protetto? Passeggiate nel campo da golf a 18 buche di Champagne, immerso in 70 ettari di pianure e valli. La felicità è tanto negli occhi quanto nel gioco..."
    ],
    "fr": [
      "Envie d’un moment de sport dans un cadre naturel préservé ? Parcourez le golf de Champagne avec ses 18 trous, niché dans 70 hectares de plaines et de vallons. Le bonheur est autant dans le regard que dans le jeu..."
    ],
    "es": [
      "¿Quiere hacer deporte en un entorno natural protegido? Dé un paseo por el campo de golf Champagne de 18 hoyos, enclavado en 70 hectáreas de llanuras y valles. La felicidad está tanto en el ojo como en el juego..."
    ],
    "nl": [
      "Wil je sporten in een beschermde natuurlijke omgeving? Maak een wandeling op de Champagne golfbaan met zijn 18 holes, genesteld in 70 hectare vlaktes en valleien. Geluk zit evenzeer in het oog als in het spel..."
    ]
  },
