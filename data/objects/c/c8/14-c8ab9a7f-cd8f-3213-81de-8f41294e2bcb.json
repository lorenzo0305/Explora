  "rdfs:comment": {
    "de": [
      "Im Herzen der Côte d'Opale, in unmittelbarer Nähe von Le Touquet-Paris-Plage, bietet das Le Manoir Hôtel - Touquet Golf Resort eine prestigeträchtige und inspirierende Umgebung für die Organisation von Seminaren, Geschäftstreffen und professionellen Veranstaltungen."
    ],
    "en": [
      "Located in the heart of the Côte d'Opale, in the immediate vicinity of Le Touquet-Paris-Plage, Le Manoir Hôtel - Touquet Golf Resort offers a prestigious and inspiring setting for seminars, business meetings and professional events."
    ],
    "it": [
      "Situato nel cuore della Côte d'Opale, a breve distanza da Le Touquet-Paris-Plage, Le Manoir Hôtel - Touquet Golf Resort offre un ambiente prestigioso e stimolante per seminari, riunioni di lavoro ed eventi professionali."
    ],
    "fr": [
      "Situé au cœur de la Côte d’Opale, à proximité immédiate du Touquet-Paris-Plage, Le Manoir Hôtel - Touquet Golf Resort offre un environnement prestigieux et inspirant pour l’organisation de séminaires, réunions d’affaires et événements professionnels."
    ],
    "es": [
      "Situado en el corazón de la Costa de Ópalo, a poca distancia de Le Touquet-Paris-Plage, Le Manoir Hôtel - Touquet Golf Resort ofrece un marco prestigioso e inspirador para seminarios, reuniones de negocios y eventos profesionales."
    ],
    "nl": [
      "Le Manoir Hôtel - Touquet Golf Resort ligt in het hart van de Côte d'Opale, op korte afstand van Le Touquet-Paris-Plage, en biedt een prestigieuze en inspirerende omgeving voor seminars, zakelijke bijeenkomsten en professionele evenementen."
    ]
  },
