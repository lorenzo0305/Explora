  "rdfs:comment": {
    "de": [
      "Organisiert von Longe c'Ault.\n- 8.30 Uhr: Empfangskaffee - Salle du marché - Zentrum von Ault.\n- 9 Uhr: Start der 12 km langen Schleife.\n- 9.30 Uhr: Start der 8,5 km langen Schleife\n- 12 Uhr: Kostenloser Aperitif, dann nach Wahl :\n* Picknick aus dem Kofferraum\n* ODER Gegrilltes Schwein mit Gemüse und Dessert.\n20? pro Person ohne Getränke.\nAnmeldung unter https://www.longecault.fr bis zum 19. März erforderlich."
    ],
    "en": [
      "Organized by Longe c'Ault.\n- 8:30 am: Welcome coffee - Salle du marché - Centre d'Ault.\n- 9 a.m.: Start of 12 km loop.\n- 9:30 am: Start of 8.5 km loop\n- 12pm: Aperitif offered, followed by your choice of :\n* Picnic lunch\n* OR Grilled pig with vegetables and dessert.\n20? per person excluding drinks.\nRegistration required on https://www.longecault.fr before March 19."
    ],
    "it": [
      "Organizzato da Longe c'Ault.\n- 8.30: Caffè di benvenuto - Sala del mercato - Centro di Ault.\n- 9.00: Partenza dell'anello di 12 km.\n- 9.30: Partenza del percorso di 8,5 km\n- 12.00: Aperitivo gratuito, seguito da una scelta di :\n* Picnic dal bagagliaio\n* O maialino alla griglia con verdure e dessert.\n20 a persona, bevande escluse.\nIscrizione obbligatoria su https://www.longecault.fr entro il 19 marzo."
    ],
    "fr": [
      "Organisé par Longe c'Ault.\n- 8h30 : Accueil café - Salle du marché - Centre d'Ault.\n- 9h : Départ boucle de 12 Km.\n- 9h30 : Départ boucle de 8,5 Km\n- 12h : Apéritif offert, puis au choix : \n* Pique nique tiré du coffre\n* OU Cochon grillé avec légumes et dessert.\n20€ par personne hors boissons. \nInscription obligatoire sur le site https://www.longecault.fr avant le 19 mars."
    ],
    "es": [
      "Organizado por Longe c'Ault.\n- 8h30: Café de bienvenida - Mercado - Centro de Ault.\n- 9h: Salida del circuito de 12 km.\n- 9h30: Salida del circuito de 8,5 km\n- 12h: Aperitivo de cortesía, seguido de :\n* Picnic del tronco\n* O Cerdo a la parrilla con verduras y postre.\n20 por persona, bebidas no incluidas.\nInscripción obligatoria en https://www.longecault.fr antes del 19 de marzo."
    ],
    "nl": [
      "Georganiseerd door Longe c'Ault.\n- 8.30 uur: Welkomstkoffie - Markthal - Centrum van Ault.\n- 9.00 uur: Start van de 12 km rondwandeling.\n- 9.30 uur: Start van de 8,5 km-ronde\n- 12u: Gratis aperitief, gevolgd door een keuze uit :\n* Picknick uit de kofferbak\n* OF Gegrild varken met groenten en dessert.\n20 per persoon exclusief drankjes.\nInschrijven verplicht op https://www.longecault.fr voor 19 maart."
    ]
  },
