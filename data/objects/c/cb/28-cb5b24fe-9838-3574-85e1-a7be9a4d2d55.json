  "rdfs:comment": {
    "de": [
      "Dieser 1 Hektar große Garten in Avesnois bietet eine sehr persönliche Atmosphäre, die der Fantasie seiner Besitzer entspricht: Nadelbäume, Laubbäume, Sträucher und Stauden laden Sie dazu ein, dem Alltag zu entfliehen."
    ],
    "en": [
      "This one hectare garden offers a very personal atmosphere in the image of the fantasy of its owners: conifers, deciduous trees, shrubs and perennial plants invite you to escape."
    ],
    "it": [
      "Questo giardino di un ettaro nella regione di Avignone offre un'atmosfera molto personale, in linea con l'immaginazione dei suoi proprietari: conifere, alberi a foglia caduca, arbusti e piante perenni invitano alla fuga."
    ],
    "fr": [
      "Ce jardin avesnois d'un hectare propose une ambiance très personnelle à l'image de la fantaisie de ses propriétaires : conifères, feuillus, arbustes et plantes vivaces vous invitent à l'évasion."
    ],
    "es": [
      "Este jardín de una hectárea en la región de Aviñón ofrece un ambiente muy personal acorde con la imaginación de sus propietarios: coníferas, árboles de hoja caduca, arbustos y plantas vivaces invitan a la evasión."
    ],
    "nl": [
      "Deze tuin van een hectare in de streek van Avignon biedt een zeer persoonlijke sfeer die beantwoordt aan de verbeelding van de eigenaars: naaldbomen, loofbomen, struiken en vaste planten nodigen u uit om te ontsnappen."
    ]
  },
  "rdfs:label": {
