  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/97fad45a-d874-37d2-9a3b-4a32f9dc0c46",
      "dc:description": {
        "de": [
          "Nehmen Sie kostenlos jeden Sonntag ab dem 06. Juli 2025 an einer Zumba-Vorführung mit Opale Fitness Evénement teil\nPlace de la concorde von 11.00 bis 12.00 Uhr\nNehmen Sie kostenlos teil"
        ],
        "en": [
          "Take part in a free Zumba demonstration every Sunday from 06 July 2025 with Opale Fitness Evénement\nPlace de la Concorde from 11:00am to 12:00pm\nTake part for free"
        ],
        "it": [
          "Partecipate a una dimostrazione gratuita di Zumba tutte le domeniche a partire dal 06 luglio 2025 con Opale Fitness Evénement\nPlace de la Concorde dalle 11.00 alle 12.00\nPartecipa gratuitamente"
        ],
        "fr": [
          "Participez gratuitement tous les dimanches à partir du 06  Juillet 2025  une démonstration de zumba avec Opale Fitness Evénement\nPlace de la concorde de 11h00 à 12h00\nParticipez gratuitement"
        ],
        "es": [
          "Participe en una demostración gratuita de Zumba todos los domingos a partir del 06 de julio 2025 con Opale Fitness Evénement\nPlace de la Concorde de 11.00 a 12.00 horas\nParticipe gratuitamente"
        ],
        "nl": [
          "Doe elke zondag vanaf 06 juli 2025 mee aan een gratis Zumba-demonstratie met Opale Fitness Evénement\nPlace de la Concorde van 11.00 tot 12.00 uur\nNeem gratis deel"
        ]
      },
