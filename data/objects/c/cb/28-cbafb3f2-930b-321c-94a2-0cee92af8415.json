  "rdfs:comment": {
    "de": [
      "Traditionelle Küche\n\nTraditionelle Gourmetküche. In der Nähe des Stadtzentrums. Gegenüber dem SNCF-Bahnhof. Wunderschöne Veranda mit Blick auf den Park.\n\nAnzahl der Gedecke: 60\nEmpfang von Gruppen: 100 Personen\nLetzte Mahlzeit: 14.00 Uhr und 23.00 Uhr\nRestauration sonntags geschlossen"
    ],
    "en": [
      "Traditional cuisine\n\nTraditional gourmet cuisine. Close to town center. Opposite SNCF train station. Superb veranda overlooking the park.\n\nNumber of seats: 60\nGroups welcome: 100 people\nLast services: 2:00 pm and 11:00 pm\nRestaurant closed on Sundays"
    ],
    "it": [
      "Cucina tradizionale\n\nCucina tradizionale gourmet. Vicino al centro città. Di fronte alla stazione SNCF. Splendida veranda con vista sul parco.\n\nNumero di coperti: 60\nGruppi: 100 persone\nUltimi servizi: 14:00 e 23:00\nRistorante chiuso la domenica"
    ],
    "fr": [
      "Cuisine traditionnelle\n\nCuisine traditionnelle gourmande. Proche du centre-ville. Face à la gare SNCF. Superbe véranda avec vue sur le parc.\n\nNombre de couverts : 60\nAccueil groupes : 100 personnes \nDerniers services : 14h00 et 23h00\nRestauration fermée les dimanches"
    ],
    "nl": [
      "Traditionele keuken\n\nTraditionele gastronomische keuken. Dicht bij het stadscentrum. Tegenover het SNCF-station. Schitterende veranda met uitzicht op het park.\n\nAantal couverts: 60\nGroepen: 100 personen\nLaatste diensten: 14.00 en 23.00\nRestaurant gesloten op zondag"
    ],
    "es": [
      "Cocina tradicional\n\nCocina gastronómica tradicional. Cerca del centro de la ciudad. Frente a la estación SNCF. Magnífica terraza con vistas al parque.\n\nNúmero de cubiertos: 60\nGrupos: 100 personas\nÚltimos servicios: 14h y 23h\nRestaurante cerrado los domingos"
    ]
  },
