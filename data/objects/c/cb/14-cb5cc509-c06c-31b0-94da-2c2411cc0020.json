  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2e3da40e-8d93-3847-9ad0-7704b75a1159",
      "dc:description": {
        "de": [
          "Festkomitee einer kleinen Gemeinde, das sehr aktiv an den angebotenen Festivitäten teilnimmt.\n\nAnimation in unser Dorf bringen und sich mit der gesamten Bevölkerung treffen"
        ],
        "en": [
          "The festival committee of a small town, very active in the proposed festivities.\n\nTo bring an animation in our village and to make meet the whole population"
        ],
        "it": [
          "Il comitato del festival di una piccola città è molto attivo nei festeggiamenti proposti.\n\nPortare l'animazione nel nostro villaggio e incontrare tutta la popolazione"
        ],
        "fr": [
          "Comité des fêtes d'une petite commune, très actif dans les festivités proposées.\n\nApporter une animation dans notre village et se faire rencontrer l'ensemble de la population"
        ],
        "es": [
          "La comisión de fiestas de una pequeña ciudad es muy activa en los festejos propuestos.\n\nLlevar la animación a nuestro pueblo y hacer que se reúna toda la población"
        ],
        "nl": [
          "Het feestcomité van een kleine stad is zeer actief in de voorgestelde festiviteiten.\n\nOm animatie in ons dorp te brengen en de hele bevolking tegemoet te komen"
        ]
      },
