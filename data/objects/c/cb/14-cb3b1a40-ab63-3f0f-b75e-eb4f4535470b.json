  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c9e6e032-d515-3eec-95ce-15169502c33a",
      "dc:description": {
        "de": [
          "JUGEND- UND TEENAGERPRAKTIKUM\n\nPraktikum für Entdecker und Fortgeschrittene\nJugendpraktikum von 8 bis 12 Jahren und für Teenager ab 13 Jahren.\nPreis: 230 ? pro Kind und Woche\nIm Falle einer Stornierung werden Ersatzaktivitäten eingerichtet (Paddeln, Küstenlonge...)."
        ],
        "en": [
          "YOUTH AND TEEN INTERNSHIP\n\nDiscovery and improvement courses\nFor children aged 8 to 12 and teenagers aged 13 and over.\nPrice: 230? per child per week\nSubstitute activities are available in the event of cancellation (paddle, longe côte...)."
        ],
        "it": [
          "STAGE PER GIOVANI E ADOLESCENTI\n\nCorsi di scoperta e perfezionamento\nPer bambini dagli 8 ai 12 anni e adolescenti dai 13 anni in su.\nPrezzo: 230 € per bambino a settimana\nIn caso di annullamento sono previste attività sostitutive (paddle, longe côte, ecc.)."
        ],
        "fr": [
          "STAGE JEUNE ET ADO\n\nStage de découverte et de perfectionnement\nStage jeune de 8 à 12 ans et pour les adolescents à partir de 13 ans.\nTarif : 230 € par enfant et par semaine\nDes activités de remplacement sont mis en place en cas d’annulation (paddle, longe côte...)."
        ],
        "nl": [
          "STAGE VOOR JONGEREN EN TIENERS\n\nOntdekkings- en verbeteringscursussen\nVoor kinderen van 8 tot 12 jaar en tieners vanaf 13 jaar.\nPrijs: €230 per kind per week\nVervangende activiteiten zijn beschikbaar in geval van annulering (peddelen, longe côte, enz.)."
        ],
        "es": [
          "PRÁCTICAS PARA JÓVENES Y ADOLESCENTES\n\nCursos de descubrimiento y perfeccionamiento\nPara niños de 8 a 12 años y adolescentes a partir de 13 años.\nPrecio: 230 euros por niño y semana\nSe ofrecen actividades sustitutorias en caso de cancelación (paddle, longe côte, etc.)."
        ]
      },
