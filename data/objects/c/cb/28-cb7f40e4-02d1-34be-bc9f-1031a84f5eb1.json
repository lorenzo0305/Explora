  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ed47bbd8-64bb-3913-ab13-6ff7c4ebd013",
      "dc:description": {
        "de": [
          "Verkauf von Saisongemüse (Spargel, Salate, Kartoffeln...), das auf dem 85 ha großen Familienbauernhof nach dem Prinzip der nachhaltigen Landwirtschaft angebaut wird.\nErdbeeren werden im Juni gepflückt.\nZusammenstellung von wöchentlichen Körben."
        ],
        "en": [
          "Sale of seasonal vegetables (asparagus, lettuce, potatoes...) grown using sustainable methods on the 85-hectare family farm.\nStrawberries picked in June.\nWeekly baskets available."
        ],
        "it": [
          "Vendita di verdure di stagione (asparagi, lattuga, patate, ecc.) coltivate con metodo biologico nell'azienda agricola di famiglia di 85 ettari.\nFragole raccolte a giugno.\nDisponibilità di cestini settimanali."
        ],
        "fr": [
          "Vente de légumes de saisons (asperges, salades, pommes de terre...) cultivés en raisonné à la ferme familiale de 85ha.\nCueillette de fraises en juin. \nComposition de paniers hebdomadaires."
        ],
        "nl": [
          "Verkoop van seizoensgroenten (asperges, sla, aardappelen, enz.) die biologisch geteeld worden op de 85 hectare grote familieboerderij.\nAardbeien geplukt in juni.\nWekelijkse manden beschikbaar."
        ],
        "es": [
          "Venta de verduras de temporada (espárragos, lechugas, patatas, etc.) cultivadas ecológicamente en la explotación familiar de 85 hectáreas.\nFresas recogidas en junio.\nCestas semanales disponibles."
        ]
      },
