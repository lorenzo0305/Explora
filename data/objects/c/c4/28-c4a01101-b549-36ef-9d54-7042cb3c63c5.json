  "rdfs:comment": {
    "de": [
      "Antoine Vivenel trug eine großartige Sammlung von Kunstwerken zusammen, die seine Liebe zur Antike, zur Renaissance und zur Kunst seiner Zeit zum Ausdruck bringt... Eine in Frankreich außergewöhnliche Sammlung von bemalten Vasen erinnert an das antike Griechenland!"
    ],
    "en": [
      "Antoine Vivenel amassed a superb collection of works of art, reflecting his love of Antiquity, the Renaissance and the art of his time... Exceptional in France, an ensemble of painted vases evokes ancient Greece!"
    ],
    "it": [
      "Antoine Vivenel ha raccolto una superba collezione di opere d'arte che riflette il suo amore per l'antichità, il Rinascimento e l'arte del suo tempo... Eccezionale in Francia, un gruppo di vasi dipinti evoca l'antica Grecia!"
    ],
    "fr": [
      "Antoine Vivenel, rassembla une superbe collection d'œuvres d'art qui manifeste son amour de l'Antiquité, de la Renaissance et de l'art de son temps... Exceptionnel en France, un ensemble de vases peints évoque la Grèce antique !"
    ],
    "nl": [
      "Antoine Vivenel verzamelde een prachtige collectie kunstwerken die zijn liefde voor de Oudheid, de Renaissance en de kunst van zijn tijd weerspiegelen... Uitzonderlijk in Frankrijk, een groep beschilderde vazen doet denken aan het oude Griekenland!"
    ],
    "es": [
      "Antoine Vivenel reunió una magnífica colección de obras de arte que refleja su amor por la Antigüedad, el Renacimiento y el arte de su época... Excepcional en Francia, ¡un grupo de jarrones pintados evoca la antigua Grecia!"
    ]
  },
