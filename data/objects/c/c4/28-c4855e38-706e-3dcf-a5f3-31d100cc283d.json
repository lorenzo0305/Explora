  "rdfs:comment": {
    "de": [
      "Dieses mit dem Gütesiegel Café Rando ausgezeichnete Restaurant mit seiner traditionsreichen französischen Hausmannskost bietet Ihnen eine Vielfalt an schmackhaften und frisch zubereiteten Gerichten. Gastfreundschaft als Bonus!"
    ],
    "en": [
      "This Café Rando-labeled restaurant offers a variety of tasty, freshly-prepared dishes based on traditional French home cooking. And a warm welcome to boot!"
    ],
    "it": [
      "Il ristorante Café Rando, con la sua tradizionale cucina casalinga francese, offre una varietà di piatti gustosi e preparati al momento. E un'accoglienza calorosa!"
    ],
    "fr": [
      "Ce restaurant labellisé Café Rando à la cuisine française maison riche en traditions vous offre une variété de plats savoureux et fraîchement préparés. L'accueil en prime !"
    ],
    "es": [
      "Este restaurante Café Rando, con su cocina casera tradicional francesa, ofrece una gran variedad de platos sabrosos y recién preparados. Y, por si fuera poco, ¡una cálida bienvenida!"
    ],
    "nl": [
      "Dit Café Rando restaurant, met zijn traditionele Franse thuiskeuken, biedt een verscheidenheid aan smakelijke, vers bereide gerechten. En een warm welkom!"
    ]
  },
