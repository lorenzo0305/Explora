  "rdfs:comment": {
    "de": [
      "Charmantes Restaurant, das eine moderne Küche präsentiert. Eine saisonal wechselnde Speisekarte und ein angenehmes Ambiente. Im Sommer können Sie von zwei angenehmen Terrassen profitieren. Mittagsformel von Montag bis Freitag und Vorschläge auf dem Schiefertisch."
    ],
    "en": [
      "Charming restaurant with modern cuisine. A menu that changes with the season and a pleasant atmosphere. In summer you can enjoy 2 pleasant terraces. Lunch formula from Monday to Friday and suggestions on the slate."
    ],
    "it": [
      "Ristorante di charme con cucina moderna. Il menu cambia a seconda della stagione e l'atmosfera è piacevole. In estate potrete godere di 2 piacevoli terrazze. Menu per il pranzo dal lunedì al venerdì e suggerimenti sulla lavagna."
    ],
    "fr": [
      "Charmant restaurant qui présente une cuisine moderne. Une carte qui change avec la saison et une ambiance agréable. L’été vous pourrez profiter de 2 agréables terrasses. Formule déjeuner du lundi au vendredi et suggestions à l’ardoise."
    ],
    "es": [
      "Restaurante con encanto y cocina moderna. El menú cambia con la temporada y el ambiente es agradable. En verano se puede disfrutar de 2 agradables terrazas. Menú de almuerzo de lunes a viernes y sugerencias en la pizarra."
    ],
    "nl": [
      "Charmant restaurant met moderne keuken. Een menu dat verandert met het seizoen en een aangename sfeer. In de zomer kunt u genieten van 2 aangename terrassen. Lunchformule van maandag tot vrijdag en suggesties op de lei."
    ]
  },
