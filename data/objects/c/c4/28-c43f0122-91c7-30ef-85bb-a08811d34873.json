  "rdfs:comment": {
    "de": [
      "Putting Golf ist eine Mischung aus Golf und Minigolf, die Sie in einer herrlichen Umgebung am Fuße der Berge von Flandern empfängt. Hier haben Sie die einmalige Gelegenheit, Putting Golf zu probieren."
    ],
    "en": [
      "Between golf and mini-golf, putting golf welcomes you to a splendid setting at the foot of the Flanders mountains. This is a unique opportunity to try your hand at putting golf."
    ],
    "it": [
      "Incrocio tra golf e minigolf, il putting golf vi accoglie in una splendida cornice ai piedi delle montagne delle Fiandre. È un'occasione unica per cimentarsi nel putting golf."
    ],
    "fr": [
      "Entre le golf et le mini-golf, le putting golf vous accueille dans un cadre splendide au pied des monts des Flandres. Vous pourrez profiter d'une occasion unique de gouter au Putting Golf."
    ],
    "nl": [
      "Putting Golf is een kruising tussen golf en minigolf en verwelkomt je in een prachtige omgeving aan de voet van de Vlaamse bergen. Dit is een unieke kans om de putting golf uit te proberen."
    ],
    "es": [
      "A caballo entre el golf y el minigolf, el putting golf le da la bienvenida en un espléndido entorno a los pies de las montañas de Flandes. Es una oportunidad única para probar el putting golf."
    ]
  },
  "rdfs:label": {
