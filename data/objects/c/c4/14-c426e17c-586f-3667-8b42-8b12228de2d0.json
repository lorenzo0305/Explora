  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0c176768-0283-3df7-bb6e-8f3d25ccc6ac",
      "dc:description": {
        "de": [
          "Im Bois de Vimy können Sie in Begleitung eines professionellen Sportlehrers einen Moment in der Natur genießen, um Ihre Muskeln zu entspannen und gleichzeitig die Augen für die Landschaft um Sie herum zu öffnen."
        ],
        "en": [
          "At Bois de Vimy, enjoy a moment in the heart of nature accompanied by a sports professional to relax all your muscles while opening your eyes wide to the landscape around you."
        ],
        "it": [
          "Al Bois de Vimy, godetevi un momento nel cuore della natura accompagnati da un professionista dello sport per rilassare tutti i muscoli e spalancare gli occhi sul paesaggio circostante."
        ],
        "fr": [
          "Au Bois de Vimy, profitez d’un moment en pleine nature accompagné par un professionnel du sport pour détendre tous vos muscles tout en ouvrant grand les yeux sur le paysage qui vous entoure."
        ],
        "nl": [
          "Geniet in Bois de Vimy van een moment in het hart van de natuur onder begeleiding van een sportprofessional om al je spieren te ontspannen terwijl je je ogen wijd openzet voor het landschap om je heen."
        ],
        "es": [
          "En Bois de Vimy, disfrute de un momento en plena naturaleza acompañado por un profesional del deporte para relajar todos sus músculos mientras abre bien los ojos al paisaje que le rodea."
        ]
      },
