  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/60560bd2-275d-3db2-8aae-ec7a75895940",
      "dc:description": {
        "de": [
          "Panda Wok ist ein All-you-can-eat-Buffetrestaurant in Saint-Martin-Boulogne. Wir bieten eine große Auswahl an frischen Produkten: Gegrilltes, Wok, Asiatisches, Meeresfrüchte... Erleben Sie eine gastronomische Reise in einer entspannten und freundlichen Atmosphäre."
        ],
        "en": [
          "Panda Wok is an all-you-can-eat buffet restaurant in Saint-Martin-Boulogne. We offer a wide range of fresh products: grilled, wok, Asian, seafood ... Experience a gastronomic journey in a relaxed and friendly atmosphere."
        ],
        "it": [
          "Il Panda Wok è un ristorante a buffet a Saint-Martin-Boulogne. Offriamo una vasta gamma di prodotti freschi: grigliate, wok, asiatici, frutti di mare... Vivete un viaggio gastronomico in un'atmosfera rilassata e amichevole."
        ],
        "fr": [
          "Panda Wok est un restaurant buffet à volonté à Saint-Martin-Boulogne. Nous proposons une large gamme de produits frais: grillade, wok, asiatique, fruits de mer... Vivez un voyage gastronomique dans une atmosphère de détente et de convivialité."
        ],
        "nl": [
          "Panda Wok is een all-you-can-eat buffetrestaurant in Saint-Martin-Boulogne. Wij bieden een breed scala aan verse producten: gegrild, wok, Aziatisch, zeevruchten... Beleef een gastronomische reis in een ontspannen en vriendelijke sfeer."
        ],
        "es": [
          "El Panda Wok es un restaurante de buffet libre en Saint-Martin-Boulogne. Ofrecemos una amplia gama de productos frescos: a la parrilla, al wok, asiáticos, mariscos... Experimente un viaje gastronómico en un ambiente relajado y agradable."
        ]
      },
