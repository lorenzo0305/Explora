  "rdfs:comment": {
    "de": [
      "Bereiten Sie sich auf ein einzigartiges Erlebnis an der Côte d'Opale vor! Der Opale Harley Day kehrt mit einer neuen, charaktervollen Ausgabe nach Hardelot zurück. Liebhaber schöner Maschinen und Anhänger des Harley-Davidson-Geistes treffen sich in einer außergewöhnlichen Umgebung zwischen feinen Sandstränden und grünen Wäldern."
    ],
    "en": [
      "Get ready for a unique experience on the Côte d'Opale! Opale Harley Day returns to Hardelot for a new edition full of character. Lovers of fine motorcycles and enthusiasts of the Harley-Davidson spirit meet in an exceptional setting, between sandy beaches and lush forests."
    ],
    "it": [
      "Preparatevi a vivere un'esperienza unica sulla Côte d'Opale! L'Opale Harley Day torna ad Hardelot per una nuova edizione piena di carattere. Gli amanti delle belle moto e gli appassionati dello spirito Harley-Davidson si incontreranno in un contesto eccezionale, tra spiagge di sabbia fine e foreste verdeggianti."
    ],
    "fr": [
      "Préparez-vous à vivre une expérience unique sur la Côte d'Opale ! L'Opale Harley Day revient à Hardelot pour une nouvelle édition pleine de caractère. Amateurs de belles mécaniques et passionnés de l'esprit Harley-Davidson se donnent rendez-vous dans un cadre exceptionnel, entre plages de sable fin et forêts verdoyantes."
    ],
    "es": [
      "¡Prepárate para vivir una experiencia única en la Côte d'Opale! El Opale Harley Day vuelve a Hardelot para una nueva edición llena de carácter. Los amantes de las motos de alta gama y los entusiastas del espíritu Harley-Davidson se darán cita en un marco excepcional, entre playas de arena fina y frondosos bosques verdes."
    ],
    "nl": [
      "Bereid je voor op een unieke ervaring aan de Côte d'Opale! Opale Harley Day keert terug naar Hardelot voor een nieuwe editie vol karakter. Liefhebbers van mooie motoren en liefhebbers van de Harley-Davidson spirit ontmoeten elkaar in een uitzonderlijk kader, tussen fijne zandstranden en weelderige groene bossen."
    ]
  },
  "rdfs:label": {
