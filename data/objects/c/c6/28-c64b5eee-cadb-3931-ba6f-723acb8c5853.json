  "rdfs:comment": {
    "de": [
      "Genießen Sie einen Moment der Entspannung im Restaurant la Flamme - Brasserie Maison. Der Küchenchef bietet Ihnen eine hausgemachte Küche mit frischen und saisonalen Produkten."
    ],
    "en": [
      "Enjoy a moment of escape in the restaurant La Flamme - Brasserie Maison. The chef offers homemade cuisine based on fresh, seasonal produce."
    ],
    "it": [
      "Godetevi un momento di evasione nel ristorante La Flamme - Brasserie Maison. Lo chef propone una cucina casalinga a base di prodotti freschi di stagione."
    ],
    "fr": [
      "Savourez un moment d'évasion dans le restaurant la Flamme - Brasserie Maison. Le chef vous propose une cuisine faite maison, autour de produits frais et de saison."
    ],
    "nl": [
      "Geniet van een moment van ontsnapping in het restaurant La Flamme - Brasserie Maison. De chef biedt huisgemaakte gerechten op basis van verse seizoensproducten."
    ],
    "es": [
      "Disfrute de un momento de evasión en el restaurante La Flamme - Brasserie Maison. El chef ofrece cocina casera basada en productos frescos de temporada."
    ]
  },
