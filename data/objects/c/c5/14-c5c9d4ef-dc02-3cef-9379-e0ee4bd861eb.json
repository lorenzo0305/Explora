  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/05449154-9c33-3392-8c14-200a3b2b6172",
      "dc:description": {
        "de": [
          "Fun Valentines Day\nKomm und feiere mit uns, während die Eltern ihre Liebe zelebrieren\nSamstag, 14. Februar\nVon 19.30 Uhr bis 22.00 Uhr\nPreis: 15 ? pro Kind\nFür 3- bis 15-Jährige"
        ],
        "en": [
          "Fun Valentines Day\nCome party with us while parents celebrate their love\nSaturday, February 14th\nFrom 7:30 pm to 10:00 pm\nPrice: 15 ? per child\nFor ages 3-15"
        ],
        "it": [
          "Divertimento a San Valentino\nVenite a festeggiare con noi mentre i genitori celebrano il loro amore\nSabato 14 febbraio\nDalle 19.30 alle 22.00\nPrezzo: 15? a bambino\nPer bambini dai 3 ai 15 anni"
        ],
        "fr": [
          "Fun Valentines Day \nViens faire la fête avec nous pendant que les parents célèbrent leur amour \nSamedi 14 Février \nDe 19h30 à 22h00 \nTarif : 15 € par enfant \nPour les 3-15 ans"
        ],
        "es": [
          "San Valentín divertido\nVen de fiesta con nosotros mientras los padres celebran su amor\nSábado 14 de febrero\nDe 19:30 a 22:00\nPrecio: 15? por niño\nPara niños de 3 a 15 años"
        ],
        "nl": [
          "Leuke Valentijnsdag\nKom met ons feesten terwijl de ouders hun liefde vieren\nZaterdag 14 februari\nVan 19.30 tot 22.00 uur\nPrijs: 15? per kind\nVoor kinderen van 3-15 jaar"
        ]
      },
