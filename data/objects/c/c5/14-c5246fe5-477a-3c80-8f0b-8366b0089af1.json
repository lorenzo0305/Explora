      "dc:description": {
        "de": [
          "Unterstützen wir unsere Berckerin Lola Lacheré, die zur Miss Nord Pas de Calais für Miss Frankreich gewählt wurde.\nIm Kursaal. Türöffnung um 20.30 Uhr."
        ],
        "en": [
          "Let's support our Berckoise Lola Lacheré, elected Miss Nord Pas de Calais for Miss France.\nAt the Kursaal. Doors open at 8.30pm."
        ],
        "it": [
          "Sosteniamo la nostra ragazza di Berck Lola Lacheré, eletta Miss Nord Pas de Calais per Miss Francia.\nAl Kursaal. Apertura porte alle 20.30."
        ],
        "fr": [
          "Soutenons notre Berckoise Lola Lacheré, élue Miss Nord Pas de Calais pour Miss France.\nAu Kursaal. Ouverture des portes à 20h30."
        ],
        "nl": [
          "Laten we ons Berckse meisje Lola Lacheré steunen, verkozen tot Miss Nord Pas de Calais voor Miss France.\nIn het Kursaal. De deuren gaan open om 20.30 uur."
        ],
        "es": [
          "Apoyemos a nuestra chica de Berck Lola Lacheré, elegida Miss Nord Pas de Calais para Miss Francia.\nEn el Kursaal. Apertura de puertas a las 20.30 h."
        ]
      },
