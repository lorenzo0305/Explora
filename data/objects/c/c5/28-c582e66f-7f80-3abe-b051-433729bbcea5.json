  "rdfs:comment": {
    "de": [
      "Das interkommunale Schwimmbad Jacques Trubert in Bresles. Es verfügt über ein 25 X 12,50 m großes Becken, ein Spielbecken und ein Planschbecken, eine Wasserrutsche mit einer 50 m langen Entwicklung im Außenbereich und einem Höhenunterschied von 6 m sowie Außenstrände mit Liegestühlen und einem Volleyballfeld."
    ],
    "en": [
      "Jacques Trubert intercommunal pool in Bresles. It features a 25 x 12.50-meter pool, a leisure pool and a paddling pool, a waterslide with a 50-meter outdoor section and a 6-meter difference in height, outdoor beaches with deckchairs and a volleyball court."
    ],
    "it": [
      "La piscina intercomunale Jacques Trubert di Bresles. Dispone di una vasca di 25 x 12,50 metri, una vasca per il divertimento e una vasca per bambini, uno scivolo con una sezione esterna di 50 metri e un dislivello di 6 metri, spiagge esterne attrezzate con sedie a sdraio e un campo da pallavolo."
    ],
    "fr": [
      "Piscine intercommunale Jacques Trubert à Bresles. Elle dispose d'un bassin de 25 X 12,50 mètres, d’un bassin ludique et d’une pataugeoire, d'un toboggan aquatique avec un développement de 50 mètres en extérieur et d'un dénivelé de 6 mètres de plages extérieures équipées de transats et d’un terrain de volley."
    ],
    "es": [
      "La piscina intercomunal Jacques Trubert de Bresles. Cuenta con una piscina de 25 x 12,50 metros, una piscina lúdica y una piscina infantil, un tobogán acuático con un tramo exterior de 50 metros y un desnivel de 6 metros, playas exteriores equipadas con tumbonas y una pista de voleibol."
    ],
    "nl": [
      "Het intercommunale zwembad Jacques Trubert in Bresles. Het heeft een zwembad van 25 x 12,50 meter, een ludiek bad en een peuterbad, een waterglijbaan in de open lucht van 50 meter, ligstoelen in de open lucht van 6 meter en een volleybalveld."
    ]
  },
