  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/00f2c44f-67c5-3e01-8461-424b8b09476c",
      "dc:description": {
        "de": [
          "Camille Gonzalez, Illustratorin und bildende Künstlerin, lädt Sie ein, ihre kreativen Techniken wie Tusche und Malerei zu entdecken und zu üben, um Ihr eigenes Werk zu schaffen. Sie können auch zur partizipativen Gestaltung der nächsten Visuals von Culture Commune beitragen."
        ],
        "en": [
          "Illustrator and visual artist Camille Gonzalez invites you to discover and practice her creative techniques, using Indian ink and paint, to create your own work. You'll also be able to contribute to the participative creation of Culture Commune's next visuals."
        ],
        "it": [
          "L'illustratrice e artista visiva Camille Gonzalez vi invita a scoprire e mettere in pratica le sue tecniche creative, utilizzando inchiostro di china e pittura, per creare le vostre opere. Potrete anche contribuire alla creazione delle prossime opere visive di Culture Commune."
        ],
        "fr": [
          "Camille Gonzalez, illustratrice et artiste plasticienne vous invite à découvrir et pratiquer ses techniques de création, encre de chine, peinture, pour réaliser votre propre oeuvre. Vous pourrez également contribuer à la création participative des prochains visuels de Culture Commune."
        ],
        "es": [
          "La ilustradora y artista visual Camille González te invita a descubrir y practicar sus técnicas creativas, utilizando tinta china y pintura, para crear tu propia obra. También podrás contribuir a la creación de los próximos visuales de Culture Commune."
        ],
        "nl": [
          "Illustrator en beeldend kunstenaar Camille Gonzalez nodigt je uit om haar creatieve technieken met Oost-Indische inkt en verf te ontdekken en te oefenen om je eigen werk te maken. Je kunt ook bijdragen aan de creatie van de volgende visuals van Culture Commune."
        ]
      },
      "@type": [
        "Description"
