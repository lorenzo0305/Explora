  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4cb674ad-233a-367b-a2c4-5f650a1e53f4",
      "dc:description": {
        "de": [
          "Für die dritte Ausgabe des Festes der Heiligen Barbara präsentiert Loom Prod ein noch nie dagewesenes Mapping in der Kirche Saint-Amé, mit einem noch eindringlicheren und originelleren Vorschlag."
        ],
        "en": [
          "For this third edition of the Saint Barbara's Day celebrations, Loom Prod comes back to offer us a new mapping in the Saint Amé church, with an even more immersive and original proposal."
        ],
        "it": [
          "Per questa terza edizione delle Fêtes de la Sainte Barbe, Loom Prod torna con una nuovissima esperienza di mapping nella chiesa di Saint-Amé, con una proposta ancora più coinvolgente e originale."
        ],
        "fr": [
          "Pour cette troisième édition des Fêtes de la Sainte Barbe, Loom Prod revient nous proposer un mapping inédit dans l’église Saint-Amé, avec une proposition encore plus immersive et originale."
        ],
        "nl": [
          "Voor deze derde editie van de Fêtes de la Sainte Barbe is Loom Prod terug met een gloednieuwe mapping-ervaring in de kerk van Saint-Amé, met een nog meeslepender en origineler voorstel."
        ],
        "es": [
          "Para esta tercera edición de las Fiestas de la Sainte Barbe, Loom Prod vuelve con una nueva experiencia de mapping en la iglesia de Saint-Amé, con una propuesta aún más inmersiva y original."
        ]
      },
