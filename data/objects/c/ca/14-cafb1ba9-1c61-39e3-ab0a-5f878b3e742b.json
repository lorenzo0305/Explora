      "dc:description": {
        "de": [
          "Restaurant mit Straßenverkauf. Montags bis freitags von 6 Uhr bis 23 Uhr nonstop geöffnet. Samstags ab 17 Uhr geöffnet. Am Sonntag geschlossen. Aligot."
        ],
        "en": [
          "Roadside restaurant. Open from Monday to Friday from 6am to 11pm non stop. Open on Saturday from 17h. Closed on Sunday. Aligot."
        ],
        "it": [
          "Ristorante lungo la strada. Aperto dal lunedì al venerdì dalle 6.00 alle 23.00 senza interruzioni. Aperto il sabato dalle 17:00. Chiuso la domenica. Aligot."
        ],
        "fr": [
          "Restaurant routier. Ouvert du lundi au vendredi de 6h à 23h non stop. Ouvert le samedi à partir de 17h. Fermé le dimanche. Aligot."
        ],
        "nl": [
          "Wegrestaurant. Open van maandag tot vrijdag van 6 tot 23 uur non stop. Geopend op zaterdag vanaf 17.00 uur. Gesloten op zondag. Aligot."
        ],
        "es": [
          "Restaurante de carretera. Abierto de lunes a viernes de 6 a 23 horas ininterrumpidamente. Abierto el sábado a partir de las 17:00 horas. Cerrado el domingo. Aligot."
        ]
      },
