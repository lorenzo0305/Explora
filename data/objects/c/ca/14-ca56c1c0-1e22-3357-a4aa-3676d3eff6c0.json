      "dc:description": {
        "de": [
          "Restaurant Pizzeria in familiärer Atmosphäre. Pizzas, Pasta, Salate und Fleischgerichte mit frischen und hochwertigen Zutaten. Hausgemachte Küche und Kindermenü"
        ],
        "en": [
          "Pizzeria restaurant in a family atmosphere. Pizzas, pastas, salads and meats made with fresh, quality ingredients. Home-made cuisine and children's menu"
        ],
        "it": [
          "Ristorante pizzeria in un'atmosfera familiare. Pizze, paste, insalate e carni preparate con ingredienti freschi e di qualità. Cucina casalinga e menu per bambini"
        ],
        "fr": [
          "Restaurant pizzeria dans une ambiance familiale. Pizzas, pâtes, salades et viandes avec des ingrédients frais et de qualité. Cuisine faite maison et menu enfant"
        ],
        "es": [
          "Restaurante pizzería en un ambiente familiar. Pizzas, pastas, ensaladas y carnes elaboradas con ingredientes frescos y de calidad. Cocina casera y menú infantil"
        ],
        "nl": [
          "Pizzeria-restaurant in een familiale sfeer. Pizza's, pasta's, salades en vlees bereid met verse kwaliteitsingrediënten. Huisgemaakte gerechten en kindermenu"
        ]
      },
