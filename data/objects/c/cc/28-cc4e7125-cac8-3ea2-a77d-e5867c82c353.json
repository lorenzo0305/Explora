  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ac633fdf-5ef3-39a8-8f91-a76e9cb7b01d",
      "dc:description": {
        "de": [
          "Wenn Sie gerne Pétanque spielen, kommen Sie zu Ribemont Pétanque!\nDie Spieler treffen sich zweimal pro Woche mittwochs und freitags von 16:00 bis 18:00 Uhr auf dem Bouleplatz (Route de Villers-le-Sec)\n\nFacebook-Seite: Ribemont Pétanque"
        ],
        "en": [
          "Petanque lovers, come and join Ribemont Pétanque!\nPlayers meet twice a week at the pétanque court (route de Villers-le-Sec) on Wednesdays and Fridays from 4pm to 6pm\n\nFacebook page: Ribemont Pétanque"
        ],
        "it": [
          "Amanti della petanque, venite a partecipare alla Ribemont Pétanque!\nI giocatori si incontrano due volte alla settimana presso il campo da petanque (route de Villers-le-Sec) il mercoledì e il venerdì dalle 16.00 alle 18.00\n\nPagina Facebook: Ribemont Pétanque"
        ],
        "fr": [
          "Amateurs de pétanque, venez rejoindre Ribemont Pétanque!\nLes joueurs se réunissent deux fois par semaine au terrain de pétanque (route de Villers-le-Sec) les mercredis et vendredis de 16h à 18h. \n\nPage facebook : Ribemont Pétanque"
        ],
        "nl": [
          "Petanqueliefhebbers, kom meedoen aan Ribemont Pétanque!\nDe spelers komen twee keer per week bijeen op het petanqueterrein (route de Villers-le-Sec) op woensdag en vrijdag van 16 tot 18 uur\n\nFacebook pagina: Ribemont Pétanque"
        ],
        "es": [
          "Amantes de la petanca, ¡venid a participar en la petanca de Ribemont!\nLos jugadores se reúnen dos veces por semana en el campo de petanca (route de Villers-le-Sec), los miércoles y los viernes de 16 a 18 horas\n\nPágina de Facebook: Ribemont Pétanque"
        ]
      },
