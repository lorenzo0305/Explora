  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a83290dd-8ee8-36e4-b8e3-68a1db2cce3f",
      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte :\nBesuchen Sie die Facebook-Seite, um die Karte zu sehen\n\nÖffnungszeiten: nur abends in Dainville (in der Nähe der Mediathek)\n\nDonnerstag: 17:30-21:00 Uhr\n \n Bestellung:\nBestellung per Telefon unter 06 86 10 53 96 möglich\n\n \n Abholung:\nZum Mitnehmen während der Öffnungszeiten der ambulanten Pizzeria\n\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit the Facebook page to see the map\n\nOpening days: evenings only in Dainville (near the media library)\n\nThursday: 5:30pm-9pm\n \n Ordering :\nOrder by phone 06 86 10 53 96\n\n \n Pick-up:\nTakeaway during the pizzeria's opening hours\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nVisita la pagina Facebook per vedere la mappa\n\nGiorni di apertura: solo la sera a Dainville (vicino alla mediateca)\n\nGiovedì: 17.30-21.00\n \n Ordini :\nLe ordinazioni possono essere effettuate telefonicamente al numero 06 86 10 53 96\n\n \n Ritiro:\nDa asporto durante gli orari di apertura della pizzeria mobile\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : \nConsultez la page Facebook afin de connaîte la carte\n\nJours d'ouverture : uniquement le soir à Dainville (près de la médiathèque)\n\nLe jeudi: 17h30-21h\n \n Commande : \nPossibilité de commander par téléphone au 06 86 10 53 96\n\n \n Retrait :\nÀ emporter aux horaires d'ouverture de la pizzeria ambulante\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nBezoek de Facebook-pagina om de kaart te zien\n\nOpeningsdagen: 's avonds alleen in Dainville (bij de mediatheek)\n\nDonderdag: 17u30-9u00\n \n Bestellen :\nBestellingen kunnen telefonisch geplaatst worden op 06 86 10 53 96\n\n \n Afhalen:\nAfhalen tijdens de openingstijden van de mobiele pizzeria\n\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nVisite la página de Facebook para ver el mapa\n\nDías de apertura: sólo por la noche en Dainville (cerca de la mediateca)\n\nJueves: de 17.30 a 21.00 h\n \n Pedidos :\nLos pedidos pueden hacerse por teléfono llamando al 06 86 10 53 96\n\n \n Recogida:\nPara llevar durante el horario de apertura de la pizzería móvil\n\n "
        ]
      },
