  "rdfs:comment": {
    "de": [
      "Das wird Ihnen gefallen: der direkte Zugang zu Autobahn und Umgehungsstraße (Stadtrand), der geschlossene Parkplatz und die Möglichkeit, zu jeder Tageszeit anzureisen."
    ],
    "en": [
      "You'll love: direct freeway and ring road access (on the outskirts of town), closed parking and the possibility of arriving at any time."
    ],
    "it": [
      "Vi piaceranno: l'accesso diretto all'autostrada e alla tangenziale (alla periferia della città), il parcheggio chiuso e la possibilità di arrivare a qualsiasi ora."
    ],
    "fr": [
      "Vous aimerez : l'accès directe autoroute et rocade (périphérie de ville), le parking fermé et la possibilité d’arriver à toute heure."
    ],
    "es": [
      "Le encantará: acceso directo a la autopista y a la circunvalación (a las afueras de la ciudad), aparcamiento cerrado y la posibilidad de llegar a cualquier hora."
    ],
    "nl": [
      "Je zult genieten van: directe toegang tot de snelweg en ringweg (aan de rand van de stad), afgesloten parkeergelegenheid en de mogelijkheid om op elk moment te arriveren."
    ]
  },
