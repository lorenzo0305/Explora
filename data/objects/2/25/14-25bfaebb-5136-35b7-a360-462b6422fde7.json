  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6aadfcb0-b8a1-3094-b3a1-7104ffdd77a8",
      "dc:description": {
        "de": [
          "Pizzeria Grill\n\nÖffnungszeiten:\nAußerhalb der Saison\nDienstag bis Donnerstag: nur mittags\nVon Freitag bis Sonntag: mittags und abends\njuli und August :\njeden Mittag und jeden Abend außer montags."
        ],
        "en": [
          "Pizzeria Grill\n\nOpening hours :\nOff season\nTuesday to Thursday: only at lunchtime\nFriday to Sunday: lunch and dinner\njuly and August :\nevery noon and every evening except Monday."
        ],
        "it": [
          "Pizzeria Grill\n\nOrari di apertura :\nFuori stagione\nDa martedì a giovedì: solo a pranzo\nDa venerdì a domenica: pranzo e cena\nluglio e agosto :\nogni ora di pranzo e ogni sera, tranne il lunedì."
        ],
        "fr": [
          "Pizzeria Grill\n\nOuverture :\nHors saison \nDu mardi au jeudi : uniquement les midis\nDu vendredi au dimanche : le midi  et le soir\njuillet et août :\ntous les midis et tous les soirs sauf le lundi."
        ],
        "nl": [
          "Pizzeria Grill\n\nOpeningstijden :\nBuiten het seizoen\nDinsdag tot donderdag: alleen 's middags\nVrijdag tot zondag: lunch en diner\njuli en augustus:\nelke middag en avond behalve maandag."
        ],
        "es": [
          "Pizzería Grill\n\nHorario de apertura :\nFuera de temporada\nDe martes a jueves: sólo a la hora del almuerzo\nDe viernes a domingo: almuerzo y cena\njulio y agosto :\ntodos los almuerzos y todas las noches, excepto los lunes."
        ]
      },
