  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d6f4a949-1fb1-35e5-80fe-ab533a308f8e",
      "dc:description": {
        "de": [
          "Deutsche Militärnekropole La Maison Blanche\nDie größte der deutschen Nekropolen in Frankreich, in der die sterblichen Überreste von 44.833 Soldaten (darunter 8.040 nicht identifizierte, die in einem Massengrab zusammengefasst wurden) gesammelt wurden."
        ],
        "en": [
          "German Military Necropolis of the White House\nThe largest German necropolis in France, where the remains of 44,833 soldiers (including 8,040 unidentified, grouped together in a mass grave) were collected."
        ],
        "it": [
          "Necropoli militare tedesca Maison Blanche\nLa più grande delle necropoli tedesche in Francia, dove sono stati raccolti i resti di 44.833 soldati (compresi 8.040 soldati non identificati, raggruppati in una fossa comune)."
        ],
        "fr": [
          "Nécropole militaire allemande de la Maison Blanche\nLa plus vaste des nécropoles allemandes en France, où ont été rassemblés les restes de 44 833 soldats (dont 8 040 non identifiés, regroupés dans une fosse commune)."
        ],
        "es": [
          "Necrópolis militar alemana Maison Blanche\nLa mayor de las necrópolis alemanas en Francia, donde se recogieron los restos de 44.833 soldados (incluidos 8.040 soldados no identificados, agrupados en una fosa común)."
        ],
        "nl": [
          "Maison Blanche Duitse militaire necropolis\nHet grootste van de Duitse necropolissen in Frankrijk, waar de resten van 44.833 soldaten (waaronder 8.040 ongeïdentificeerde soldaten, gegroepeerd in een massagraf) zijn verzameld."
        ]
      },
      "@type": [
        "Description"
      ],
