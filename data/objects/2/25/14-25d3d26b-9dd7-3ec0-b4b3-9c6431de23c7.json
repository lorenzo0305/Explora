  "rdfs:comment": {
    "de": [
      "Entdecken Sie den außergewöhnlichen Werdegang einer unglaublichen Kandidatin - in einer tollen TV-Show! Das sind viele Superlative? Und wieder haben Sie nichts gesehen!"
    ],
    "en": [
      "Discover the extraordinary journey of an incredible contestant, in a great TV show! That's a lot of superlatives? You haven't seen anything yet!"
    ],
    "it": [
      "Scoprite lo straordinario viaggio di un incredibile concorrente, in un grande show televisivo! Sono molti superlativi? Non avete ancora visto nulla!"
    ],
    "fr": [
