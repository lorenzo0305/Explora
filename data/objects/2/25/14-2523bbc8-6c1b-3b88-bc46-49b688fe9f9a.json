  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4e7ed72a-07b9-3cdd-b3f6-ae210d3cabd5",
      "dc:description": {
        "de": [
          "Ein Ort für temporäre Ausstellungen, der sich auf dem Promenadendamm von Wimereux befindet.\nDieser Ausstellungsort ist ein Muss in Wimereux\nGalerie geöffnet:\n- Dienstag Donnerstag: 14.00 bis 19.00 Uhr\n- Freitag Montag: 11.00 Uhr 13.00 Uhr und 14.00 Uhr 19.00 Uhr"
        ],
        "en": [
          "A temporary exhibition space located on the Wimereux promenade.\nThis exhibition space is a must-see in Wimereux\nGallery open :\n- Tuesday Thursday: 2:00 pm to 7:00 pm\n- Friday Monday: 11 h 00 13 h 00 et 14 h 00 19 h 00"
        ],
        "it": [
          "Uno spazio espositivo temporaneo situato sul lungomare di Wimereux.\nQuesto spazio espositivo è una tappa obbligata a Wimereux\nGalleria aperta:\n- Martedì giovedì: dalle 14.00 alle 19.00\n- Venerdì Lunedì: dalle 11.00 alle 13.00 e dalle 14.00 alle 19.00"
        ],
        "fr": [
          "Un lieu d'exposition temporaire situé sur la digue promenade de Wimereux.\nCe lieu d'exposition est un lieu incontournable à Wimereux \nGalerie ouverte : \n- Mardi jeudi : 14 h 00 à 19 h 00\n- Vendredi lundi : 11 h 00 13 h 00 et 14 h 00 19 h 00"
        ],
        "es": [
          "Un espacio de exposición temporal situado en el paseo marítimo de Wimereux.\nEste espacio de exposición es una visita obligada en Wimereux\nGalería abierta :\n- Martes jueves: de 14.00 a 19.00 h\n- Viernes Lunes: de 11.00 a 13.00 h y de 14.00 a 19.00 h"
        ],
        "nl": [
          "Een tijdelijke tentoonstellingsruimte op de promenade van Wimereux.\nDeze tentoonstellingsruimte is een must in Wimereux\nOpen galerie :\n- Dinsdag Donderdag: 14u tot 19u\n- Vrijdag maandag: 11u tot 13u en 14u tot 19u"
        ]
      },
