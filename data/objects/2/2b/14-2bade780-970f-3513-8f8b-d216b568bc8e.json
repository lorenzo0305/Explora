  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5a98c1bb-7351-36fe-adb9-803c2febda7e",
      "dc:description": {
        "de": [
          "Das Gewerkschaftshaus wurde als Reaktion auf die Katastrophe von Courrières im Jahr 1906 errichtet und ist ein symbolträchtiges Gebäude für die Arbeiterkämpfe der Bergarbeiter."
        ],
        "en": [
          "Built in response to the Courrières disaster of 1906, the Maison syndicale is an emblematic building of the miners' labour struggles."
        ],
        "it": [
          "Costruita in risposta al disastro di Courrières del 1906, la Maison syndicale è un edificio emblematico delle lotte sindacali dei minatori."
        ],
        "fr": [
          "Édifiée en réponse à la catastrophe de Courrières de 1906, la Maison syndicale est un édifice emblématique des luttes ouvrières des mineurs."
        ],
        "nl": [
          "Het Maison syndicale werd gebouwd naar aanleiding van de ramp in Courrières in 1906 en is een symbool van de strijd van de mijnwerkers."
        ],
        "es": [
          "Construida en respuesta a la catástrofe de Courrières de 1906, la Maison syndicale es un edificio emblemático de las luchas obreras de los mineros."
        ]
      },
