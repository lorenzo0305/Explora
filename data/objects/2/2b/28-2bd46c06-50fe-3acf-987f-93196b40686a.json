  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/696f0738-8619-34e5-a8a6-cdc240cf4d03",
      "dc:description": {
        "de": [
          "Vorübergehende Schließung wegen Bauarbeiten - bis Mitte 2026\nFamilienschwimmbad mit 2 Becken. Aktivitäten für Kinder wie Babyschwimmen, Wassergarten, aber auch für Erwachsene: Wassergymnastik, Aquafitness, Tauch- und Schwimmkurse und Hammam."
        ],
        "en": [
          "TEMPORARY CLOSURE FOR WORKS - until mid 2026\nFamily pool with 2 pools. Activities for children such as baby swimmers, water garden, but also for adults: aquagym, aquafitness, diving and swimming lessons and Hammam."
        ],
        "it": [
          "CHIUSURA TEMPORANEA PER LAVORI - fino a metà 2026\nPiscina per famiglie con 2 vasche. Attività per i bambini, come i baby nuotatori, il giardino acquatico, ma anche per gli adulti: aquagym, aquafitness, immersioni e lezioni di nuoto e Hammam."
        ],
        "fr": [
          "FERMETURE TEMPORAIRE POUR TRAVAUX - jusque mi 2026\nPiscine familiale avec 2 bassins. Activités pour enfants tels que bébés nageurs, jardin aquatique, mais aussi pour adultes: aquagym, aquafitness, cours de plongée et de natation et Hammam."
        ],
        "nl": [
          "TIJDELIJKE SLUITING VOOR WERKZAAMHEDEN - tot medio 2026\nGezinsbad met 2 zwembaden. Activiteiten voor kinderen zoals babyzwemmers, watertuin, maar ook voor volwassenen: aquagym, aquafitness, duik- en zwemlessen en hamam."
        ],
        "es": [
          "CIERRE TEMPORAL POR OBRAS - hasta mediados de 2026\nPiscina familiar con 2 piscinas. Actividades para niños como baby swimmers, jardín acuático, pero también para adultos: aquagym, aquafitness, clases de buceo y natación y Hammam."
        ]
      },
      "@type": [
        "Description"
      ],
