  "rdfs:comment": {
    "de": [
      "An der Ausfahrt 14 der Autobahn A2 gelegen, in der Nähe des Stadtzentrums. Besuchen Sie Cateau-Cambrésis mit seinem Matisse-Museum, dem Spitzenmuseum, der Abtei von Vaucelles, dem Soldatenfriedhof an der Straße nach Solesmes und allen Rundwegen, dem Panzer von Flesquières."
    ],
    "en": [
      "Located at exit 14 of the A2 freeway, close to the city center, visit Cateau-Cambrésis with its Matisse museum, the lace museum, the Vaucelles abbey, the military cemetery of the Solesmes road and all the circuits, the tank of Flesquières."
    ],
    "it": [
      "Situato all'uscita 14 dell'autostrada A2, vicino al centro città, visitate Cateau-Cambrésis con il suo museo Matisse, il museo del merletto, l'abbazia di Vaucelles, il cimitero militare sulla strada di Solesmes e tutti i circuiti, il carro armato di Flesquières."
    ],
    "fr": [
      "Situé à la sortie 14 de l'autoroute A2, à proximité du centre-ville, visiter le Cateau-Cambrésis avec son musée Matisse, le musée de la dentelle, l'abbaye de Vaucelles, le cimetière militaire de la route de Solesmes et tous les circuits, le tank de Flesquières."
    ],
    "es": [
      "Situado en la salida 14 de la autopista A2, cerca del centro de la ciudad, visite Cateau-Cambrésis con su museo Matisse, el museo del encaje, la abadía de Vaucelles, el cementerio militar de la carretera de Solesmes y todos los circuitos, el tanque de Flesquières."
    ],
    "nl": [
      "Gelegen aan afrit 14 van de snelweg A2, dicht bij het stadscentrum, bezoek Cateau-Cambrésis met zijn Matisse museum, het kantmuseum, de abdij van Vaucelles, de militaire begraafplaats aan de weg van Solesmes en alle circuits, de tank van Flesquières."
    ]
  },
  "rdfs:label": {
