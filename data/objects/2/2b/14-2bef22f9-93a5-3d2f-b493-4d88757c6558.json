  "rdfs:comment": {
    "de": [
      "Souad Massi gehört zu einer großen und reichen Familie, der Folk-Familie, deren DNA sich durch die Gitarre, die Beobachtungsgabe und die Intelligenz, Verletzungen in Lieder umzuwandeln, definiert."
    ],
    "en": [
      "Souad Massi belongs to a large and rich folk family, whose DNA is defined by the guitar, a keen eye for observation and the intelligence to transmute wounds into song."
    ],
    "it": [
      "Souad Massi appartiene a una grande e ricca famiglia folk, il cui DNA è definito dalla chitarra, da un occhio attento all'osservazione e dall'intelligenza con cui trasmette le ferite in canto."
    ],
    "fr": [
      "Souad Massi appartient à une large et riche famille, celle du folk, dont l’ADN se définit par la guitare, le souci de l’observation et l’intelligence qu’il y a à transmuter les blessures en chansons."
    ],
    "es": [
      "Souad Massi pertenece a una familia folclórica numerosa y rica, cuyo ADN está definido por la guitarra, un agudo ojo para la observación y la inteligencia que supone transmutar las heridas en canciones."
    ],
    "nl": [
      "Souad Massi behoort tot een grote en rijke folklorefamilie, wiens DNA wordt bepaald door de gitaar, een scherp oog voor observatie en de intelligentie die komt kijken bij het omzetten van wonden in zang."
    ]
  },
