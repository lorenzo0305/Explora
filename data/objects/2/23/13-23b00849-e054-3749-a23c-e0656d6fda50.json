  "rdfs:comment": {
    "de": [
      "Treten Sie ein zu einer einstündigen Führung durch das vollständig im Stil der Epoche eingerichtete Schloss. Lassen Sie sich von den Räumlichkeiten und der Geschichte einer Prinzessin und der Familie de Merode inspirieren."
    ],
    "en": [
      "Enter for a one-hour guided tour of this fully furnished period castle. Let yourself be immersed in the history of a princess and the de Merode family."
    ],
    "it": [
      "Entrate per una visita guidata di un'ora in questo castello d'epoca completamente arredato. Lasciatevi immergere nella storia di una principessa e della famiglia de Merode."
    ],
    "fr": [
      "Entrez pour une visite guidée d’une heure dans ce château entièrement meublé d’époque. Laissez-vous imprégner des lieux et de de l’histoire d’une princesse et de la famille de Merode."
    ],
    "es": [
      "Venga a realizar una visita guiada de una hora a este castillo de época completamente amueblado. Déjese sumergir en la historia de una princesa y de la familia de Merode."
    ],
    "nl": [
      "Kom binnen voor een rondleiding van een uur door dit volledig ingerichte kasteel. Laat u onderdompelen in de geschiedenis van een prinses en de familie de Merode."
    ]
  },
  "rdfs:label": {
