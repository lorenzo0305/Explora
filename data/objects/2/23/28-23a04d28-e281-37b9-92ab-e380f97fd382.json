  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9e08dd45-9234-3497-8af5-04783cf7b1c2",
      "dc:description": {
        "de": [
          "Besuchen Sie die Thiérache, mit dem Kanu! Kanu- und Kajakfahrten auf der Oise, Freizeit und Entspannung - mit den Mietobjekten der Moulin d'Erloy werden Sie sich wie ein Fisch im Wasser fühlen! - Picknick- und Grillmöglichkeiten, alles auf einer Insel mit Dämmen und Wasserfällen + Kinderspielplatz und Bouleplatz. - Duschen und sanitäre Einrichtungen. - Großer Saal auf Anfrage."
        ],
        "en": [
          "Visit the Thiérache, by canoe! Canoeing down the Oise, leisure and relaxation, you'll feel like a fish in water with the Moulin d'Erloy rentals! - Picnic and barbecue facilities on an island with dams and waterfalls + children's play area and boules pitch. - Showers and sanitary facilities. - Large room on request."
        ],
        "it": [
          "Visitate la Thiérache in canoa! Canoa lungo l'Oise, svago e relax, vi sentirete come un pesce nell'acqua con il Moulin d'Erloy! - Attrezzature per picnic e barbecue su un'isola con dighe e cascate, giochi per bambini e campo da bocce. - Docce e servizi igienici. - Camera grande disponibile su richiesta."
        ],
        "fr": [
          "Visitez la Thiérache, en canoë ! Descente de l'Oise en canoë-kayak, loisirs et détente, vous vous sentirez comme un poisson dans l'eau avec les locations du Moulin d'Erloy ! - Possibilités de pique-nique, de barbecue, le tout sur une île avec barrages et chutes d'eau + jeux pour enfants et terrain de boules. - Douches et sanitaires. - Grande salle sur demande."
        ],
        "es": [
          "¡Visite el Thiérache en canoa! Descenso del Oise en canoa, ocio y relajación, ¡se sentirá como pez en el agua con el Moulin d'Erloy! - Picnic y barbacoa en una isla con presas y cascadas, juegos infantiles y campo de petanca. - Duchas y sanitarios. - Habitación grande disponible previa petición."
        ],
        "nl": [
          "Bezoek de Thiérache per kano! Kanoën op de Oise, vrije tijd en ontspanning, je voelt je als een vis in het water met de Moulin d'Erloy! - Picknick- en barbecuefaciliteiten op een eiland met dammen en watervallen, plus kinderspelen en een petanquebaan. - Douches en sanitair. - Grote zaal beschikbaar op aanvraag."
        ]
      },
