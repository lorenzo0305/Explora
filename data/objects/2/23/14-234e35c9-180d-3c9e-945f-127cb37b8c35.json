      "@id": "https://data.datatourisme.fr/e2da4434-34d8-3922-9bf1-6ca181a21099",
      "dc:description": {
        "de": [
          "Entdecke, wie du eine Windmühle bauen kannst, um deinen Garten zu schmücken - Treffpunkt: Salle du Bosquet in Camiers - Anmeldung im Office de Tourisme erforderlich - Von 14:30 bis 16:30 Uhr"
        ],
        "en": [
          "Discover how to build a windmill to decorate your garden - Meeting point at the Salle du Bosquet in Camiers - Registration essential at the Tourist Office - From 2:30pm to 4:30pm"
        ],
        "it": [
          "Scoprite come costruire un mulino a vento per decorare il vostro giardino - Punto d'incontro presso la Salle du Bosquet a Camiers - Iscrizione obbligatoria presso l'Ufficio del Turismo - 14.30-16.30"
        ],
        "fr": [
          "Découvre comment construire un moulin à vent pour décorer ton jardin - Rendez-vous à la salle du Bosquet à Camiers - Inscription indispensable à l'Office de Tourisme - De 14h30 à 16h30"
        ],
        "nl": [
          "Ontdek hoe je een windmolen bouwt om je tuin te versieren - Trefpunt in de Salle du Bosquet in Camiers - Inschrijving verplicht bij het Office du Tourisme - 14.30-16.30 uur"
        ],
        "es": [
          "Descubra cómo construir un molino de viento para decorar su jardín - Punto de encuentro en la Salle du Bosquet de Camiers - Imprescindible inscribirse en la Oficina de Turismo - 14.30 a 16.30 horas"
        ]
      },
