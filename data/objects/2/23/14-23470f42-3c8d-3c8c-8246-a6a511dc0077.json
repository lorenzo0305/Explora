  "rdfs:comment": {
    "de": [
      "Verabreden Sie sich für einen Monat im August, der ganz im Zeichen des Wassers steht. Gehen Sie auf Entdeckungsreise zu den Senkungsteichen und den Ufern der Deûle!"
    ],
    "en": [
      "Appointment for a month of August under the sign of water. Discover the ponds of subsidence and the banks of the Deûle!"
    ],
    "it": [
      "Il mese di agosto è all'insegna dell'acqua. Partite alla scoperta degli stagni di subsidenza e delle rive della Deûle!"
    ],
    "fr": [
      "Rendez-vous pour un mois d’un août sous le signe de l’eau. Partez à la découverte des étangs d’affaissements et des bords de Deûle !"
    ],
    "es": [
      "El mes de agosto gira en torno al agua. Salga a descubrir los estanques de hundimiento y las orillas del Deûle"
    ],
    "nl": [
      "De maand augustus staat in het teken van water. Ontdek de verzakkingsvijvers en de oevers van de Deûle!"
    ]
  },
