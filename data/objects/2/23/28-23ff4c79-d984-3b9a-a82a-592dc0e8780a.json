  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f69c4473-8b4a-3199-81a2-f85b2a3c059b",
      "dc:description": {
        "de": [
          "Picknickbereich, der sich an der Kreuzung der Rue de Chaumont und der Rue de Boubiers in Liancourt-Saint-Pierre befindet. Verschiedene Ausstattungen: 1 Picknicktisch, 2 Bänke, 1 Spielplatz und Mülleimer\n\nDieser Picknickplatz befindet sich 4 km von der Schleife der zwei Vexin im Pays de Nacre entfernt."
        ],
        "en": [
          "Picnic area located at the intersection of rue de Chaumont and rue de Boubiers in Liancourt-Saint-Pierre. Various equipment: 1 picnic table, 2 benches, 1 playground and garbage cans\n\nThis picnic area is 4 km from the Boucle des deux Vexin in the Pays de Nacre."
        ],
        "it": [
          "Area picnic situata all'incrocio tra rue de Chaumont e rue de Boubiers a Liancourt-Saint-Pierre. Attrezzature varie: 1 tavolo da picnic, 2 panchine, 1 parco giochi e cestini\n\nQuest'area picnic si trova a 4 km dalla Boucle des deux Vexin, nel Pays de Nacre."
        ],
        "fr": [
          "Aire de pique-nique se situant au croisement rue de Chaumont et rue de Boubiers à Liancourt-Saint-Pierre. Divers équipement : 1 table de pique-nique, 2 bancs, 1 aire de jeux et poubelles. \n\nCette aire de pique-nique se trouve à 4 km de la Boucle des deux Vexin au Pays de Nacre."
        ],
        "es": [
          "Área de picnic situada en el cruce de la calle de Chaumont y la calle de Boubiers en Liancourt-Saint-Pierre. Equipamiento diverso: 1 mesa de picnic, 2 bancos, 1 parque infantil y papeleras\n\nEste merendero se encuentra a 4 km del Boucle des deux Vexin en el Pays de Nacre."
        ],
        "nl": [
          "Picknickplaats gelegen op de kruising van de rue de Chaumont en de rue de Boubiers in Liancourt-Saint-Pierre. Diverse voorzieningen: 1 picknicktafel, 2 banken, 1 speeltuin en vuilnisbakken\n\nDeze picknickplaats ligt op 4 km van de Boucle des deux Vexin in het Pays de Nacre."
        ]
      },
