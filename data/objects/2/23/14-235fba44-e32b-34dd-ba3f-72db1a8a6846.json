  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/675310b8-e949-3c0f-8156-c229af486c65",
      "dc:description": {
        "de": [
          "Das Restaurant des Golf des Dunes befindet sich in der Gemeinde Hardelot, einem beliebten Urlaubsziel in Nordfrankreich, das für seine Strände und Golfplätze bekannt ist. Es befindet sich innerhalb des Golfplatzes Les Dunes und bietet einen Panoramablick auf den Golfplatz und die grüne Umgebung."
        ],
        "en": [
          "The Golf des Dunes restaurant is located in Hardelot, a popular tourist destination in northern France, known for its beaches and golf courses. It is located within the Dunes golf course, offering a panoramic view of the course and its verdant surroundings."
        ],
        "it": [
          "Il ristorante Golf des Dunes si trova ad Hardelot, una popolare destinazione turistica nel nord della Francia, nota per le sue spiagge e i suoi campi da golf. Si trova all'interno del campo da golf Dunes e offre una vista panoramica sul campo e sul verde circostante."
        ],
        "fr": [
          "Le restaurant du golf des Dunes est situé dans la commune d’Hardelot, une destination touristique populaire dans le nord de la France, connue pour ses plages et ses parcours de golf. Il est situé au sein du golf des Dunes, offrant ainsi une vue panoramique sur le parcours et l’environnement verdoyant."
        ],
        "nl": [
          "Het restaurant Golf des Dunes ligt in Hardelot, een populaire toeristische bestemming in het noorden van Frankrijk, bekend om zijn stranden en golfbanen. Het ligt binnen de golfbaan van de Dunes en biedt een panoramisch uitzicht op de baan en de groene omgeving."
        ],
        "es": [
          "El restaurante Golf des Dunes se encuentra en Hardelot, un popular destino turístico del norte de Francia, conocido por sus playas y campos de golf. Está situado dentro del campo de golf de las Dunas, ofreciendo una vista panorámica del campo y de los verdes alrededores."
        ]
      },
      "@type": [
        "Description"
