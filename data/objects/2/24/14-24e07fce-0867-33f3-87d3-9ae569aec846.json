  "rdfs:comment": {
    "de": [
      "Ausgabe holen unsere Hexen und Magier wieder ihre Besen, Kessel und Zaubertränke hervor, um Groß und Klein zu begeistern."
    ],
    "en": [
      "For this 18th edition, our witches and wizards bring out their brooms, cauldrons and magic potions to delight young and old alike."
    ],
    "it": [
      "Per questa 18a edizione, le nostre streghe e i nostri maghi tirano fuori scope, calderoni e pozioni magiche per deliziare grandi e piccini."
    ],
    "fr": [
      "Pour cette 18ème édition, nos sorcières et mages ressortent leur balais, chaudron et potions magiques pour ravir les petits comme les grands."
    ],
    "nl": [
      "Voor deze 18e editie halen onze heksen en tovenaars hun bezems, ketels en toverdranken tevoorschijn om jong en oud in verrukking te brengen."
    ],
    "es": [
      "En esta 18ª edición, nuestras brujas y magos sacan a relucir sus escobas, calderos y pociones mágicas para hacer las delicias de grandes y pequeños."
    ]
  },
  "rdfs:label": {
