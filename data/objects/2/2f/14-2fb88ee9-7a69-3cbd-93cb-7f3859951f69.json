        "de": [
          "Donnerstag, den 23. April 2026\nVortrag, organisiert von der Association Gmilopale.\nUm 18:30 Uhr im Maison des Associations.\n\nFreier Eintritt für Mitglieder.\nNicht-Mitglieder: 5?"
        ],
        "en": [
          "Thursday, April 23, 2026\nConference, organized by the Association Gmilopale.\nAt 6:30pm, at the Maison des Associations.\n\nFree admission for members.\nNon-members: 5 ?"
        ],
        "it": [
          "Giovedì 23 aprile 2026\nConferenza organizzata dall'Associazione Gmilopale.\nAlle 18.30, presso la Maison des Associations.\n\nIngresso libero per i soci.\nPer i non soci: 5 ?"
        ],
        "fr": [
          "Jeudi 23 avril 2026\nConférence, organisée par l'Association Gmilopale.\nA 18h30, à la Maison des Associations.\n\nEntrée libre pour les adhérents.\nNon adhérent : 5 €"
        ],
        "es": [
          "Jueves 23 de abril de 2026\nConferencia organizada por la Asociación Gmilopale.\nA las 18.30 h, en la Maison des Associations.\n\nEntrada gratuita para los socios.\nNo socios: 5 ?"
        ],
        "nl": [
          "Donderdag 23 april 2026\nConferentie, georganiseerd door de Vereniging Gmilopale.\nOm 18.30 uur, in het Maison des Associations.\n\nGratis toegang voor leden.\nNiet-leden: 5 ?"
        ]
      },
