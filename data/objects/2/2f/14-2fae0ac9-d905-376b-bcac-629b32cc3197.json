  "rdfs:comment": {
    "de": [
      "Erleben Sie einen außergewöhnlichen Tag voller Feste, Austausch und Entdeckungen in Noyelles-sous-Lens! Am Freitag, den 25. Juli, lädt die Stadt Sie von 14 Uhr bis Mitternacht auf den Platz in der Rue d'Harnes ein, um eine neue Ausgabe von \"Nos quartiers d'été\" (Unsere Sommerquartiere) zu feiern."
    ],
    "en": [
      "Come and enjoy an exceptional day of festivities, sharing and discoveries in Noyelles-sous-Lens! On Friday, July 25, the town invites you to the square, rue d?Harnes, from 2pm to midnight, for a new edition of \"Nos quartiers d?été\"."
    ],
    "it": [
      "Venite a vivere una giornata eccezionale di festa, condivisione e scoperta a Noyelles-sous-Lens! Venerdì 25 luglio, la città vi invita nella piazza di rue d'Harnes, dalle 14.00 alle 24.00, per una nuova edizione di \"Nos quartiers d'été\"."
    ],
    "fr": [
      "Venez vivre une journée exceptionnelle de fête, de partage et de découvertes à Noyelles-sous-Lens ! Le vendredi 25 juillet, la ville vous invite au square, rue d’Harnes, de 14h à minuit, pour une nouvelle édition de “Nos quartiers d’été”."
    ],
    "es": [
      "Venga a disfrutar de una jornada excepcional de fiesta, convivencia y descubrimientos en Noyelles-sous-Lens El viernes 25 de julio, la ciudad le invita a la plaza de la rue d'Harnes, de 14:00 a 24:00 horas, para una nueva edición de \"Nos quartiers d'été\"."
    ],
    "nl": [
      "Kom genieten van een uitzonderlijke dag vol feestelijkheden, uitwisselingen en ontdekkingen in Noyelles-sous-Lens! Op vrijdag 25 juli nodigt de stad u uit op het plein in de rue d'Harnes, van 14u tot middernacht, voor een nieuwe editie van \"Nos quartiers d'été\"."
    ]
  },
  "rdfs:label": {
