  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f024c58c-85ec-3a37-ad39-1f92e7e15ab2",
      "dc:description": {
        "de": [
          "Öffnen Sie die Türen dieses Restaurants und reisen Sie nach Asien.\nDer Chefkoch bietet Ihnen seine Spezialitäten an: Chinesisches Couscous, japanisches Couscous und hawaiianische Küche werden Ihren Gaumen erfreuen!"
        ],
        "en": [
          "Push open the doors of this restaurant and travel to Asia.\nThe chef offers you his specialties: Chinese couscous, Japanese couscous and Hawaiian cuisine will delight your taste buds!"
        ],
        "it": [
          "Aprite le porte di questo ristorante e viaggiate in Asia.\nLo chef vi propone le sue specialità: couscous cinese, couscous giapponese e cucina hawaiana delizieranno il vostro palato!"
        ],
        "fr": [
          "Poussez les portes de ce restaurant et voyagez en Asie.\nLe chef vous propose ses spécialité : couscous chinois, couscous japonais, cuisine hawaïenne vont ravir vos papilles !"
        ],
        "nl": [
          "Duw de deuren van dit restaurant open en reis naar Azië.\nDe chef biedt je zijn specialiteiten: Chinese couscous, Japanse couscous en de Hawaïaanse keuken zullen je smaakpapillen verrukken!"
        ],
        "es": [
          "Abra de par en par las puertas de este restaurante y viaje a Asia.\nEl chef te ofrece sus especialidades: ¡el cuscús chino, el cuscús japonés y la cocina hawaiana harán las delicias de tu paladar!"
        ]
      },
