  "rdfs:comment": {
    "de": [
      "In der Thiérache werden die befestigten Kirchen von Waschhäusern begleitet. Fahren Sie auf der Route des Lavoirs (Straße der Waschhäuser) und entdecken Sie 26 von ihnen!"
    ],
    "en": [
      "In Thiérache, the fortified churches are accompanied by washhouses. Take the Laundromat Route and discover 26 of them!"
    ],
    "it": [
      "A Thiérache, le chiese fortificate sono accompagnate da lavatoi. Percorrete la Strada dei lavatoi e scopritene 26!"
    ],
    "fr": [
      "En Thiérache, les églises fortifiées s'accompagnent de lavoirs. Parcourez la Route des Lavoirs et découvrez 26 d'entre eux !"
    ],
    "nl": [
      "In Thiérache gaan de versterkte kerken vergezeld van washuizen. Neem de wasserijenroute en ontdek er 26!"
    ],
    "es": [
      "En Thiérache, las iglesias fortificadas van acompañadas de lavaderos. ¡Haga la Ruta de los Lavaderos y descubra 26 de ellos!"
    ]
  },
