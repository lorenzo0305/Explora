  "rdfs:comment": {
    "de": [
      "Der Picknickplatz der Gemeinde Lhéraule befindet sich am Eingang des Dorfes an der Wanderraststätte.\nVerschiedene Einrichtungen: Picknicktisch, Basketballfeld."
    ],
    "en": [
      "The picnic area of the commune of Lhéraule is located at the entrance of the village, at the hike stop.\nVarious equipment: picnic table, basketball court."
    ],
    "it": [
      "L'area picnic del comune di Lhéraule si trova all'ingresso del villaggio, presso la fermata del sentiero.\nVarie strutture: tavolo da picnic, campo da basket."
    ],
    "fr": [
      "L'aire de pique-nique de la commune de Lhéraule se situe à l'entrée du village, à la halte de randonnée.\nDivers équipement : table de pique-nique, terrain de basket."
    ],
    "es": [
      "El merendero del municipio de Lhéraule se encuentra a la entrada del pueblo, en la parada de senderismo.\nVarias instalaciones: mesa de picnic, cancha de baloncesto."
    ],
    "nl": [
      "De picknickplaats van de gemeente Lhéraule ligt bij de ingang van het dorp, bij de wandelhalte.\nDiverse voorzieningen: picknicktafel, basketbalveld."
    ]
  },
