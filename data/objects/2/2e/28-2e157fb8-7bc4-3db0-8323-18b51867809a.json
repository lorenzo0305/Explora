  "rdfs:comment": {
    "de": [
      "Traditionelles Restaurant, in dem Sie hausgemachte Aperitifs (Hypokras, Grapefruitwein, Table d'Amis-Coktail), regionale Vorspeisen, kreative Gerichte sowie hausgemachte Desserts in einem gemütlichen Rahmen genießen können."
    ],
    "en": [
      "Traditional restaurant where you can enjoy homemade aperitifs (hypocras, grapefruit wine, Table d'Amis cocktail), regional starters, creative dishes as well as homemade desserts in a warm atmosphere."
    ],
    "it": [
      "Ristorante tradizionale dove si possono gustare aperitivi fatti in casa (ipocras, vino di pompelmo, cocktail Table d'Amis), antipasti regionali, piatti creativi e dolci fatti in casa in un ambiente accogliente."
    ],
    "fr": [
      "Restaurant traditionnel où vous pourrez y déguster des apérétifs maisons (hypocras, vin de pamplemousse, coktail Table d'Amis), des entrées régionales, des plats de création ainsi que des desserts maisons dans un cadre chaleureux."
    ],
    "nl": [
      "Traditioneel restaurant waar u in een warm kader kunt genieten van huisgemaakte aperitieven (hypocras, grapefruitwijn, Table d'Amis-cocktails), regionale voorgerechten, creatieve gerechten en huisgemaakte desserts."
    ],
    "es": [
      "Restaurante tradicional donde podrá disfrutar de aperitivos caseros (hipocrás, vino de pomelo, cócteles Table d'Amis), entrantes regionales, platos creativos y postres caseros en un ambiente cálido."
    ]
  },
