  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c771277c-9e06-35fa-b716-68c1ea3d1516",
      "dc:description": {
        "de": [
          "Ende der Woche, Lust auf Entspannung?\nGönnen Sie sich einen Moment der Ruhe und des Wohlbefindens bei einer Yogastunde am Donnerstag. Ein Termin, der für alle zugänglich ist, in einer ruhigen und beruhigenden Atmosphäre."
        ],
        "en": [
          "End of the week, need to unwind?\nTreat yourself to a moment of calm and well-being with a yoga session this Thursday. An appointment open to all, in a serene and soothing atmosphere."
        ],
        "it": [
          "Fine della settimana, bisogno di rilassarsi?\nConcedetevi un momento di calma e benessere con una sessione di yoga questo giovedì. È accessibile a tutti, in un'atmosfera serena e rilassante."
        ],
        "fr": [
          "Fin de semaine, envie de décompresser?\nAccordez-vous un moment de calme et de bien-être avec une séance de yoga ce jeudi. Un rendez-vous accessible à tous, dans une ambiance sereine et apaisante."
        ],
        "es": [
          "Fin de semana, ¿necesitas desconectar?\nRegálese un momento de calma y bienestar con una sesión de yoga este jueves. Accesible a todos, en un ambiente sereno y relajante."
        ],
        "nl": [
          "Einde van de week, behoefte aan ontspanning?\nGun jezelf een moment van rust en welzijn met een yogasessie deze donderdag. Het is toegankelijk voor iedereen, in een serene en rustgevende sfeer."
        ]
      },
