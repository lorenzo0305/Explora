  "rdfs:comment": {
    "de": [
      "Mieten Sie Ihr Fahrrad in Amiens für ein Wochenende, eine Woche oder das ganze Jahr! Zahlreiche Modelle und Zubehör stehen Ihnen zur Verfügung."
    ],
    "en": [
      "Rent your bike in Amiens for a weekend, a week or all year long! Many models and accessories at your disposal."
    ],
    "it": [
      "Noleggiate la vostra bicicletta ad Amiens per un weekend, una settimana o per tutto l'anno! Molti modelli e accessori a disposizione."
    ],
    "fr": [
      "Louez votre vélo à Amiens pour un week-end, une semaine ou toute l'année ! Nombreux modèles et accessoires à votre disposition."
    ],
    "nl": [
      "Huur uw fiets in Amiens voor een weekend, een week of het hele jaar! Vele modellen en accessoires tot uw beschikking."
    ],
    "es": [
      "Alquile su bicicleta en Amiens para un fin de semana, una semana o todo el año Numerosos modelos y accesorios a tu disposición."
    ]
