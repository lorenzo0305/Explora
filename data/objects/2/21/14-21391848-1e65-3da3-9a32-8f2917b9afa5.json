  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fdf9244c-55b3-35e8-9cde-b74367af344b",
      "dc:description": {
        "de": [
          "34 KM LANGER MOUNTAINBIKE-TRAIL - 4 STUNDEN\nSTART HINTER DEM KERAMIKMUSEUM\nMARKIERUNG IN BRAUN. ZIFFER 3 FÜR DIE KURZE VARIANTE UND ZIFFER 4 FÜR DIE LANGE VARIANTE.\n\nDen Streckenverlauf finden Sie in der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "34KM MOUNTAIN BIKE TRAIL - 4 H\nSTART BEHIND THE CERAMICS MUSEUM\nMARKED IN BROWN. NUMBER 3 FOR SHORT VARIANT AND NUMBER 4 FOR LONG VARIANT.\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO PER MOUNTAIN BIKE DI 34 KM - 4 H\nPARTE DIETRO IL MUSEO DELLA CERAMICA\nSEGNATO IN MARRONE. NUMERO 3 PER L'OPZIONE BREVE E NUMERO 4 PER L'OPZIONE LUNGA.\n\nTrovate il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER  VTT  DE 34KM - 4 H \nDEPART DERRIERE LE MUSEE DE LA CERAMIQUE\nBALISAGE EN MARRON. CHIFFRE 3 POUR VARIANTE COURTE ET CHIFFRE 4 POUR VARIANTE LONGUE.\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RUTA EN BICICLETA DE MONTAÑA DE 34 KM - 4 H\nCOMIENZA DETRÁS DEL MUSEO DE CERÁMICA\nMARCADO EN MARRÓN. NÚMERO 3 PARA LA OPCIÓN CORTA Y NÚMERO 4 PARA LA OPCIÓN LARGA.\n\nEncuentra la ruta en la aplicación de senderismo CIRKWI en tu smartphone."
        ],
        "nl": [
          "34 KM MOUNTAINBIKEPARCOURS - 4 U\nSTART ACHTER HET KERAMIEKMUSEUM\nAANGEGEVEN IN BRUIN. NUMMER 3 VOOR DE KORTE OPTIE EN NUMMER 4 VOOR DE LANGE OPTIE.\n\nVind de route op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
