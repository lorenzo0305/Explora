      "dc:description": {
        "de": [
          "Fenêtres sur livres ist ein Kollektiv, das von dem Wunsch geleitet wird, das Buch und das literarische Schaffen in Montreuillois zu verankern."
        ],
        "en": [
          "Fenêtres sur livres is a collective driven by the desire to inscribe books and literary creation in the Montreuillois."
        ],
        "it": [
          "Fenêtres sur livres è un collettivo animato dal desiderio di collocare i libri e la creazione letteraria nel territorio di Montreuillois."
        ],
        "fr": [
          "Fenêtres sur livres est un collectif animé par le souhait d'inscrire le livre et la création littéraire dans le Montreuillois."
        ],
        "nl": [
          "Fenêtres sur livres is een collectief dat gedreven wordt door de wens om boeken en literaire creatie in de Montreuillois te plaatsen."
        ],
        "es": [
          "Fenêtres sur livres es un colectivo impulsado por el deseo de situar el libro y la creación literaria en el área de Montreuillois."
        ]
