  "rdfs:comment": {
    "de": [
      "Entdecken Sie unsere reichhaltige und abwechslungsreiche Speisekarte in einem freundlichen und gemütlichen Rahmen mit Meerblick. Hier können Sie unsere Fisch- und Meeresfrüchtespezialitäten probieren, die von unserem dynamischen und lächelnden Team serviert werden."
    ],
    "en": [
      "Come and discover a rich and varied menu, in a warm and friendly setting with a view of the sea. You can taste our fish and seafood specialties served by our dynamic and smiling team."
    ],
    "it": [
      "Venite a scoprire un menu ricco e vario, in un ambiente caldo e accogliente con vista sul mare. Potrete gustare le nostre specialità di pesce e frutti di mare servite dal nostro team dinamico e sorridente."
    ],
    "fr": [
      "Venez découvrir une carte riche et variée, dans un cadre convivial et chaleureux avec vue sur mer. Vous pouvez y déguster nos spécialités de poissons et fruits de mer servies par notre équipe dynamique et souriante."
    ],
    "es": [
      "Venga a descubrir una carta rica y variada, en un ambiente cálido y acogedor con vistas al mar. Podrá degustar nuestras especialidades de pescado y marisco servidas por nuestro dinámico y sonriente equipo."
    ],
    "nl": [
      "Kom en ontdek een rijk en gevarieerd menu, in een warm en vriendelijk kader met uitzicht op zee. U kunt onze vis- en zeevruchtenspecialiteiten proeven, geserveerd door ons dynamische en glimlachende team."
    ]
  },
