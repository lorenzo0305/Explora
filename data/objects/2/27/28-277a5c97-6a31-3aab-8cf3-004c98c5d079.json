  "rdfs:comment": {
    "de": [
      "Der Belfried ist in vielen Städten Nordfrankreichs und Belgiens ein Symbol der kommunalen Freiheiten. Als solches wurde auch der Belfried von Amiens 2005 als UNESCO-Weltkulturerbe anerkannt."
    ],
    "en": [
      "The belfry is the symbol of communal freedom in many cities in northern France and Belgium. As such, the belfry of Amiens was also recognized as a UNESCO World Heritage Site in 2005."
    ],
    "it": [
      "Il campanile è il simbolo delle libertà comunali in molte città del nord della Francia e del Belgio. Il campanile di Amiens è stato riconosciuto come patrimonio mondiale dell'UNESCO nel 2005."
    ],
    "fr": [
      "Le beffroi est le symbole des libertés communales dans bien des villes du nord de la France et en Belgique. A ce titre, le beffroi d'Amiens a lui aussi été reconnu au Patrimoine mondial de l'UNESCO en 2005."
    ],
    "nl": [
      "Het belfort is het symbool van de gemeentelijke vrijheden in veel steden in Noord-Frankrijk en België. Het belfort van Amiens werd in 2005 ook erkend als UNESCO-werelderfgoed."
    ],
    "es": [
      "El campanario es el símbolo de las libertades comunales en muchas ciudades del norte de Francia y Bélgica. El campanario de Amiens también fue reconocido Patrimonio de la Humanidad por la UNESCO en 2005."
    ]
  },
