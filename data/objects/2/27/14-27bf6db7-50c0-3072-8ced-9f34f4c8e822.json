      "@id": "https://data.datatourisme.fr/0d3eae73-81d8-35f9-b788-5590fd7eee24",
      "dc:description": {
        "de": [
          "Sonntag, den 19. Juli 2026\n--------------------------------------------------------------\nTreffen von alten Sportwagen und Youngtimern, außergewöhnlichen Motorrädern, Mopeds und Militärfahrzeugen.\nOrganisiert von der Vereinigung \"Les Anciennes en Côte d'Opale\"\nVon 14 bis 17.30 Uhr auf dem Rathausplatz\nKostenlos und für alle zugänglich\nKONTAKT : 06 27 48 58 34\nFOTOKREDIT: Freepik.com"
        ],
        "en": [
          "Sunday, July 19, 2026\n--------------------------------------------------------------\nGathering of old sports cars and youngtimers, exceptional motorcycles, mopeds and military vehicles.\nOrganized by the association \"Les Anciennes en Côte d'Opale\"\nFrom 2pm to 5:30pm on the Place de la Mairie\nFree and open to all\nCONTACT : 06 27 48 58 34\nPHOTO CREDIT: Freepik.com"
        ],
        "it": [
          "Domenica 19 luglio 2026\n--------------------------------------------------------------\nRaduno di auto sportive e youngtimer d'epoca, moto eccezionali, ciclomotori e veicoli militari.\nOrganizzato dall'associazione \"Les Anciennes en Côte d'Opale\"\nDalle 14.00 alle 17.30 in Place de la Mairie\nGratuito e aperto a tutti\nCONTATTO: 06 27 48 58 34\nCREDITO FOTO: Freepik.com"
        ],
        "fr": [
          "Dimanche 19 juillet 2026 \n--------------------------------------------------------------\nRassemblement d'ancienne voitures et Youngtimers Sportives, d'Exception moto, mobylettes, et véhicules militaires.\nOrganisée par l'association \"Les Anciennes en Côte d'Opale\"\nDe 14h à 17h30 sur la place de la Mairie\nGratuit et ouvert à tous\nCONTACT : 06 27 48 58 34\nCREDIT PHOTO : Freepik.com"
        ],
        "nl": [
          "Zondag 19 juli 2026\n--------------------------------------------------------------\nSamenkomst van oude sportwagens en youngtimers, bijzondere motoren, bromfietsen en militaire voertuigen.\nGeorganiseerd door de vereniging \"Les Anciennes en Côte d'Opale\"\nVan 14.00 tot 17.30 uur op de Place de la Mairie\nGratis en open voor iedereen\nCONTACT: 06 27 48 58 34\nFOTO CREDIT: Freepik.com"
        ],
        "es": [
          "Domingo 19 de julio de 2026\n--------------------------------------------------------------\nConcentración de coches deportivos antiguos y youngtimers, motos excepcionales, ciclomotores y vehículos militares.\nOrganizado por la asociación \"Les Anciennes en Côte d'Opale\"\nDe 14:00 a 17:30 en la plaza de la Mairie\nGratuito y abierto a todos\nCONTACTO: 06 27 48 58 34\nCRÉDITO FOTOGRÁFICO: Freepik.com"
        ]
      },
