  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/881f9ddb-29c8-3c45-b4f0-4dc008f8eb2e",
      "dc:description": {
        "de": [
          "Lebensmittelgeschäft Saveurs et Terroirs d'Opale (Frische Produkte: Eier, Butter, Käse, Räucherfisch..., Konserven, Gewürze, Marmeladen, Honig, Kaffee, Kekse...) - 6 rue Victor-Hugo. Geöffnet von Montag bis Samstag von 9:00 bis 13:00 Uhr. Lieferung ab 20€ in einem Umkreis von 5 km. Bestellung über die facebook-Seite \"Saveurs et terroirs d'Opale\"."
        ],
        "en": [
          "Epicerie Saveurs et Terroirs d'Opale (Fresh products: eggs, butter, cheese, smoked fish..., canning, condiments, jams, honey, coffee, biscuits...) - 6 rue Victor-Hugo. Open from Monday to Saturday from 9am to 1pm. Delivery from 20€ within a 5 km perimeter. Order via the facebook page \"Saveurs et terroirs d'Opale\"."
        ],
        "it": [
          "Epicerie Saveurs et Terroirs d'Opale (prodotti freschi: uova, burro, formaggio, pesce affumicato, conserve, condimenti, marmellate, miele, caffè, biscotti, ecc 6 rue Victor-Hugo. Aperto dal lunedì al sabato dalle 9.00 alle 13.00. Consegna a partire da 20? nel raggio di 5 km. Ordinare tramite la pagina facebook \"Saveurs et terroirs d'Opale\"."
        ],
        "fr": [
          "Epicerie Saveurs et Terroirs d’Opale (Produits frais : œufs, beurre, fromage, poisson fumé…, conserverie, condiments, confitures, miel, café, biscuits…) – 6 rue Victor-Hugo. Ouvert du lundi au samedi de 9h à 13h. Livraison à partir de 20€ dans un périmètre de 5 km. Commande via la page facebook « Saveurs et terroirs d’Opale »."
        ],
        "nl": [
          "Epicerie Saveurs et Terroirs d'Opale (Verse producten: eieren, boter, kaas, gerookte vis, conserven, kruiden, jam, honing, koffie, koekjes, enz 6 rue Victor-Hugo. Open van maandag tot zaterdag van 9 tot 13 uur. Levering vanaf 20? Binnen een straal van 5 km. Bestel via de facebookpagina \"Saveurs et terroirs d'Opale\"."
        ],
        "es": [
          "Epicerie Saveurs et Terroirs d'Opale (Productos frescos: huevos, mantequilla, queso, pescado ahumado, conservas, condimentos, mermeladas, miel, café, galletas, etc.) ? 6 rue Victor-Hugo. Abierto de lunes a sábado de 9 a 13 horas. Entrega a partir de 20? en un radio de 5 km. Haga su pedido a través de la página de Facebook \"Saveurs et terroirs d'Opale\"."
        ]
      },
