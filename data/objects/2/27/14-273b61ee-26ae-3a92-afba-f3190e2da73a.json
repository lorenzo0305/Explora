  "rdfs:comment": {
    "de": [
      "Wie wäre es mit einem Spiel, bei dem man sich erschreckt? Wie?\nMit überraschenden Geschichten, die mit den Lippen und den Fingerspitzen erzählt werden. Zwischen Lachsalven und Gänsehaut, eine komische und spielerische Begegnung."
    ],
    "en": [
      "Let's play scare games... How?\nWith surprising stories told with the tip of your lips, the tip of your fingers. Between laughter and shivers, a funny and playful encounter."
    ],
    "it": [
      "Giochiamo a spaventarci... Come?\nCon storie sorprendenti raccontate con la punta delle labbra, con la punta delle dita. Tra risate e brividi, un incontro divertente e giocoso."
    ],
    "fr": [
      "Et si on jouait à se faire peur... Comment ?\nAvec des histoires surprenantes racontées du bout des lèvres, du bout des doigts. Entre éclats de rire et frissons, une rencontre cocasse et ludique."
    ],
    "nl": [
      "Laten we paniek zaaien... Hoe?\nMet verrassende verhalen, verteld met het puntje van je lippen, het puntje van je vingers. Tussen lachen en rillen, een grappige en speelse ontmoeting."
    ],
    "es": [
      "Juguemos a las tácticas del miedo... ¿Cómo?\nCon historias sorprendentes contadas con la punta de los labios, con la punta de los dedos. Entre risas y escalofríos, un encuentro divertido y juguetón."
    ]
  },
  "rdfs:label": {
