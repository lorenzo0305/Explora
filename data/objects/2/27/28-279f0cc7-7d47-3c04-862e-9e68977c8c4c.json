  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/78f6a8d9-f808-3464-bf82-d9128070ecfd",
      "dc:description": {
        "de": [
          "Chicken Best ist eine Restaurantkette, in der Sie Wings und Tenders probieren können.  Es werden verschiedene Menüs angeboten, sodass für jeden Geschmack etwas dabei ist Lust auf Hühnchen? Dann gehen Sie zu Chicken Best!"
        ],
        "en": [
          "Chicken Best is a chain of restaurants where you can enjoy wings or tenders.  Different menus are proposed to you, there is something for all tastes! Fancy some chicken? Don't wait any longer to go to Chicken Best!"
        ],
        "it": [
          "Chicken Best è una catena di ristoranti in cui si possono gustare ali o offerte.  Vengono proposti diversi menu, per tutti i gusti! Volete un po' di pollo? Non aspettate oltre, andate da Chicken Best!"
        ],
        "fr": [
          "Chicken Best est une chaîne de restaurant où vous pouvez déguster wings ou encore tenders.  Différents menus vous sont proposés, il y en pour tous les goûts! Envie de poulet? N'attendez plus allez chez Chicken Best!"
        ],
        "nl": [
          "Chicken Best is een keten van restaurants waar u kunt genieten van wings of tenders.  Verschillende menu's worden u aangeboden, er is voor elk wat wils! Zin in kip? Wacht niet langer, ga naar Chicken Best!"
        ],
        "es": [
          "Chicken Best es una cadena de restaurantes donde se puede disfrutar de alitas o tenders.  Se ofrecen diferentes menús, ¡algo para todos! ¿Te apetece un poco de pollo? No esperes más, ¡ve a Chicken Best!"
        ]
      },
