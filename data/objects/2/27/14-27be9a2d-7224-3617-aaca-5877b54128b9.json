  "rdfs:comment": {
    "de": [
      "Das Restaurant Côte d'Argent in der charmanten Stadt Calais ist eine echte lokale Institution. Mit seinem atemberaubenden Blick auf das Meer und seiner gemütlichen Atmosphäre bietet es ein unvergessliches kulinarisches Erlebnis."
    ],
    "en": [
      "The Côte d'Argent restaurant, located in the charming town of Calais, is a veritable local institution. With its breathtaking sea views and warm ambience, it offers an unforgettable culinary experience."
    ],
    "it": [
      "Il ristorante Côte d'Argent, situato nell'affascinante cittadina di Calais, è una vera e propria istituzione locale. Con la sua vista mozzafiato sul mare e l'atmosfera accogliente, offre un'esperienza culinaria indimenticabile."
    ],
    "fr": [
      "Le restaurant Côte d'Argent, situé dans la charmante ville de Calais, est une véritable institution locale. Avec sa vue imprenable sur la mer et son ambiance chaleureuse, il offre une expérience culinaire inoubliable."
    ],
    "nl": [
      "Het restaurant Côte d'Argent, gelegen in het charmante stadje Calais, is een echt plaatselijk instituut. Met zijn adembenemende uitzicht op zee en vriendelijke sfeer biedt het een onvergetelijke culinaire ervaring."
    ],
    "es": [
      "El restaurante Côte d'Argent, situado en la encantadora localidad de Calais, es una auténtica institución local. Con sus impresionantes vistas al mar y su ambiente acogedor, ofrece una experiencia culinaria inolvidable."
    ]
  },
