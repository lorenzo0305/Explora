  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fd88c536-1c41-3ca5-b852-41468b83b669",
      "dc:description": {
        "de": [
          "La Pause Gourmande bietet Ihnen Mahlzeiten, die vor Ort erhältlich sind und auch zum Mitnehmen angeboten werden.\nGenießen Sie die hausgemachten Desserts!\nZögern Sie nicht, Ihre Treuekarte zu beantragen!"
        ],
        "en": [
          "La Pause Gourmande offers you meals available on site and to take away.\nEnjoy homemade desserts!\nDon't hesitate to ask for your loyalty card!"
        ],
        "it": [
          "La Pause Gourmande offre pasti da consumare o da portare via.\nApprofittate dei dolci fatti in casa!\nNon esitate a chiedere la vostra carta fedeltà!"
        ],
        "fr": [
          "La Pause Gourmande vous propose des repas disponibles sur place et à emporter.\nProfitez des desserts maisons !\nN'hésitez pas à demander votre carte de fidélité !"
        ],
        "es": [
          "La Pause Gourmande le ofrece comidas disponibles para comer en casa o para llevar.\n¡Aprovecha los postres caseros!\nNo dude en pedir su tarjeta de fidelidad"
        ],
        "nl": [
          "La Pause Gourmande biedt u maaltijden die u kunt eten of meenemen.\nProfiteer van de zelfgemaakte desserts!\nVraag gerust naar uw klantenkaart!"
        ]
      },
