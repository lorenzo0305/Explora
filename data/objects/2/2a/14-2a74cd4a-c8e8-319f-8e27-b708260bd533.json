  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ada45421-329d-373d-9c51-78c367818c0a",
      "dc:description": {
        "de": [
          "Die Auswahl des Fleischstücks, das Sie nach dem Kochen genießen werden, ist das Versprechen des Metzgerabdrucks. Sie werden auch köstlichen Couscous und Tajines genießen."
        ],
        "en": [
          "Choosing the piece of meat that you will enjoy after cooking is the promise of the butcher's mark. You will also enjoy delicious couscous and tagines."
        ],
        "it": [
          "La scelta del pezzo di carne da gustare dopo la cottura è la promessa del marchio del macellaio. Potrete anche gustare deliziosi couscous e tajine."
        ],
        "fr": [
          "Choisir le morceau de viande que vous dégusterez après cuisson c'est la promesse de l'empreinte du boucher. Vous dégusterez également de délicieux couscous et tajines."
        ],
        "nl": [
          "Het kiezen van het stuk vlees waar je van zult genieten na het koken is de belofte van het slagersmerk. Je kunt ook genieten van heerlijke couscous en tajines."
        ],
        "es": [
          "Elegir el trozo de carne que disfrutarás después de cocinarlo es la promesa de la marca del carnicero. También disfrutará de deliciosos cuscús y tajines."
        ]
      },
