  "rdfs:comment": {
    "de": [
      "Große ländliche Kirmes im Herzen der Lichtung Saint-Albin.\nAlte Karussells, Geschicklichkeitsspiele, verschiedene Lotterien, Gewehrschießen, Ponyreiten\nGetränke und Speisen vor Ort.\nMusikalische Unterhaltung"
    ],
    "en": [
      "Large country fair in the heart of the Saint-Albin clearing.\nAntique merry-go-rounds, games of skill, various lotteries, rifle shooting, pony rides, etc\nRefreshment bar and catering on site.\nMusical entertainment"
    ],
    "it": [
      "Grande fiera di campagna nel cuore della radura di Saint-Albin.\nGiostre antiche, giochi di abilità, lotterie varie, tiro al fucile, passeggiate su pony, ecc\nRistoro e ristorazione sul posto.\nIntrattenimento musicale"
    ],
    "fr": [
      "Grande kermesse champêtre au cœur de la clairière Saint-Albin.\nManèges anciens, jeux d'adresse, loteries diverses, tir à la carabine, promenades à poneys\nBuvette & restauration sur place.\nAnimations musicales"
    ],
    "nl": [
      "Grote kermis in het hart van de open plek van Saint-Albin.\nAntieke draaimolens, behendigheidsspelletjes, verschillende loterijen, geweerschieten, ponyritjes, enz\nVersnaperingen en catering ter plaatse.\nMuzikaal entertainment"
    ],
    "es": [
      "Gran feria campestre en el corazón del claro de Saint-Albin.\nTiovivos antiguos, juegos de habilidad, loterías diversas, tiro con carabina, paseos en poni, etc\nRestauración y catering in situ.\nAnimación musical"
    ]
  },
  "rdfs:label": {
