  "rdfs:comment": {
    "de": [
      "Anlässlich des 200. Geburtstags von Kaiserin Eugenie erweckt das Schloss Pierrefonds den Glanz der kaiserlichen Pracht für ein kaiserliches Wochenende wieder zum Leben!"
    ],
    "en": [
      "To mark the bicentenary of the birth of Empress Eugenie, Pierrefonds Castle revives the splendor of imperial splendor for an imperial weekend!"
    ],
    "it": [
      "In occasione del bicentenario della nascita dell'imperatrice Eugenia, il castello di Pierrefonds riporta in vita i fasti imperiali per un weekend imperiale!"
    ],
    "fr": [
      "À l’occasion du bicentenaire de la naissance de l’Impératrice Eugénie, le château de Pierrefonds fait renaître l’éclat des fastes impériaux pour un week-end impérial !"
    ],
    "nl": [
      "Ter gelegenheid van de tweehonderdste geboortedag van keizerin Eugénie brengt het kasteel van Pierrefonds de pracht en praal van de keizer terug voor een keizerlijk weekend!"
    ],
    "es": [
      "Con motivo del bicentenario del nacimiento de la emperatriz Eugenia, el castillo de Pierrefonds recupera el esplendor imperial para un fin de semana imperial"
    ]
  },
