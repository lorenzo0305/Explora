  "rdfs:comment": {
    "de": [
      "Bernard Allison ist ein Name, der in der Welt des modernen Blues einen starken Klang hat. Er verkörpert die Verschmelzung der traditionellen Wurzeln des Genres mit einem zeitgenössischen, elektrischen Ansatz."
    ],
    "en": [
      "Bernard Allison is a name that resonates strongly in the world of modern blues, embodying the fusion of the genre?s traditional roots with a contemporary, electric approach."
    ],
    "it": [
      "Bernard Allison è un nome che risuona fortemente nel mondo del blues moderno, incarnando la fusione delle radici tradizionali del genere con un approccio elettrico contemporaneo."
    ],
    "fr": [
      "Bernard Allison est un nom qui résonne avec force dans l’univers du blues moderne, incarnant la fusion des racines traditionnelles du genre avec une approche contemporaine et électrique."
    ],
    "nl": [
      "Bernard Allison is een naam die sterk resoneert in de wereld van de moderne blues. Hij belichaamt de fusie van de traditionele wortels van het genre met een eigentijdse, elektrische benadering."
    ],
    "es": [
      "Bernard Allison es un nombre que resuena con fuerza en el mundo del blues moderno, encarnando la fusión de las raíces tradicionales del género con un enfoque contemporáneo y eléctrico."
    ]
  },
