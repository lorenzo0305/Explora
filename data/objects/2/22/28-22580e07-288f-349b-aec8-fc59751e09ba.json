  "rdfs:comment": {
    "de": [
      "10 Minuten von Lille entfernt empfängt Sie das Team ganz unkompliziert in einer gemütlichen Umgebung. Sie werden eine traditionelle, originelle und abwechslungsreiche Küche genießen, die hausgemacht ist."
    ],
    "en": [
      "10 minutes from Lille, the team welcomes you in a warm and friendly atmosphere. You will taste a traditional, original and varied home-made cooking."
    ],
    "it": [
      "A 10 minuti da Lille, il team vi accoglie in un'atmosfera calda e amichevole. Potrete gustare una cucina casalinga tradizionale, originale e varia."
    ],
    "fr": [
      "A 10 minutes de Lille l'équipe vous accueille en toute simplicité dans un cadre chaleureux. Vous dégusterez une cuisine de tradition, originale et variée faite maison."
    ],
    "nl": [
      "Op 10 minuten van Lille ontvangt het team u in een warme en vriendelijke sfeer. U zult genieten van een traditionele, originele en gevarieerde huisgemaakte keuken."
    ],
    "es": [
      "A 10 minutos de Lille, el equipo le da la bienvenida en un ambiente cálido y acogedor. Disfrutará de una cocina casera tradicional, original y variada."
    ]
  },
