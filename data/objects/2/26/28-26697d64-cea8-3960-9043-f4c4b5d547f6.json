  "rdfs:comment": {
    "de": [
      "Das Tir Na Nog ist eine unumgängliche Adresse, ein echtes Irish Pub & Restaurant, das besonders gesellig ist. Der Chefkoch, Maître Restaurateur, verwöhnt Sie mit irischen Spezialitäten und traditionellen Gerichten."
    ],
    "en": [
      "The Tir Na Nog is a must-visit address, a genuine Irish pub& a particularly convivial restaurant. The chef, a Maître Restaurateur, will introduce you to Irish specialties and traditional dishes."
    ],
    "it": [
      "Tir Na Nog è un indirizzo da non perdere, un vero pub irlandese e un ristorante particolarmente accogliente. Lo chef, un Maître Restaurateur, vi farà conoscere le specialità irlandesi e i piatti tradizionali."
    ],
    "fr": [
      "Le Tir Na Nog est une adresse incontournable, un véritable pub irlandais& restaurant particulièrement convivial. Le chef, Maître Restaurateur, vous fait découvrir des spécialités irlandaises ainsi que des plats traditionnels."
    ],
    "nl": [
      "Tir Na Nog is een must-visit adres, een echte Ierse pub& een bijzonder vriendelijk restaurant. De chef, een Maître Restaurateur, laat je kennismaken met Ierse specialiteiten en traditionele gerechten."
    ],
    "es": [
      "Tir Na Nog es una dirección de visita obligada, un auténtico pub irlandés& un restaurante especialmente acogedor. El chef, un Maître Restaurateur, le presentará especialidades irlandesas y platos tradicionales."
    ]
  },
