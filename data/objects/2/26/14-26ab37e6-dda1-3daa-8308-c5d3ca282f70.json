  "rdfs:comment": {
    "de": [
      "Im Rahmen des Frühlings der Friedhöfe lädt die Gedenkstätte 14-18 Notre-Dame de Lorette Sie ein, einige ihrer schönsten Gedenkstätten in Frankreich zu entdecken."
    ],
    "en": [
      "As part of Printemps des cimetières, the Mémorial 14-18 Notre-Dame de Lorette invites you to discover some of its most beautiful sites of remembrance in France."
    ],
    "it": [
      "Nell'ambito del Printemps des cimetières (Cimiteri in primavera), il Mémorial 14-18 Notre-Dame de Lorette vi invita a scoprire alcuni dei più bei siti della memoria in Francia."
    ],
    "fr": [
      "Dans le cadre du Printemps des cimetières le Mémorial 14-18 Notre-Dame de Lorette vous invite à découvrir certains de ses plus beaux sites de mémoire en France."
    ],
    "nl": [
      "In het kader van de Printemps des cimetières (begraafplaatsen in de lente) nodigt het Mémorial 14-18 Notre-Dame de Lorette je uit om enkele van de mooiste gedenkplaatsen van Frankrijk te ontdekken."
    ],
    "es": [
      "En el marco del Printemps des cimetières (Primavera de los cementerios), el Mémorial 14-18 Notre-Dame de Lorette le invita a descubrir algunos de sus más bellos lugares de memoria en Francia."
    ]
