  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ab5a732d-a061-34f7-8fc6-15b2eff8ee79",
      "dc:description": {
        "de": [
          "Zelobes Indian Cemetery in La Couture, die Militärgrabfelder Gorre British und Indian Cemetery, Saint-Vaast Post Military Cemetery in Richebourg und Vieille-Chapelle New Military Cemetery in La Couture erinnern daran, dass das indische Armeekorps zur Verstärkung des britischen Expeditionskorps in den Krieg eingriff."
        ],
        "en": [
          "Zelobes Indian Cemetery in La Couture, the military squares of Gorre British and Indian Cemetery, Saint-Vaast Post Military Cemetery in Richebourg and Vieille-Chapelle New Military Cemetery in La Couture are a reminder that the Indian Army Corps engaged in the war in support of the British Expeditionary Force."
        ],
        "it": [
          "Il Cimitero Indiano di Zelobes a La Couture, il Cimitero Britannico e Indiano di Gorre, il Cimitero Militare Postale di Saint-Vaast a Richebourg e il Nuovo Cimitero Militare di Vieille-Chapelle a La Couture ricordano che il Corpo d'Armata Indiano entrò in guerra a sostegno della Forza di Spedizione Britannica."
        ],
        "fr": [
          "Zelobes Indian Cemetery à La Couture, les carrés militaires de Gorre British et Indian Cemetery, de Saint-Vaast Post Military Cemetery à Richebourg et de Vieille-Chapelle New Military Cemetery à La Couture rappellent que le corps de l'Armée de l'Inde s'est engagé dans la guerre en renfort du corps expéditionnaire britannique."
        ],
        "nl": [
          "Zelobes Indian Cemetery in La Couture, Gorre British and Indian Cemetery, Saint-Vaast Post Military Cemetery in Richebourg en Vieille-Chapelle New Military Cemetery in La Couture herinneren eraan dat het Indische Legerkorps de oorlog inging om het Britse Expeditieleger te ondersteunen."
        ],
        "es": [
          "El cementerio indio de Zelobes, en La Couture, el cementerio británico e indio de Gorre, el cementerio militar de correos de Saint-Vaast, en Richebourg, y el nuevo cementerio militar de Vieille-Chapelle, en La Couture, recuerdan que el cuerpo de ejército indio entró en la guerra para apoyar a la fuerza expedicionaria británica."
        ]
      },
      "@type": [
        "Description"
      ],
