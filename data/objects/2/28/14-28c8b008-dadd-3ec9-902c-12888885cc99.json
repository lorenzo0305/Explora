  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/202f4bfa-4b7e-3dca-beb4-0d6fdc8412b8",
      "dc:description": {
        "de": [
          "Choffel Cup :\nTurnier für Jungen und Mädchen 15/18 Jahre.\nJugendturnier für Jungen und Mädchen 11/12 Jahre und 13/14 Jahre.\n\nOpen SOFIDA auto :\nTurnier \"hors catégorie\" Open Damen und Herren."
        ],
        "en": [
          "Choffel Cup:\nBoys' and girls' tournament 15/18 years.\nYouth tournament for boys and girls aged 11/12 and 13/14.\n\nOpen SOFIDA auto :\nOpen Ladies' and Gentlemen's \"out of category\" tournament."
        ],
        "it": [
          "Coppa Choffel :\nTorneo per ragazzi e ragazze di 15/18 anni.\nTorneo giovanile per ragazzi e ragazze di 11/12 e 13/14 anni.\n\nOpen SOFIDA auto :\nTorneo Open Ladies e Gentlemen \"fuori categoria\"."
        ],
        "fr": [
          "Coupe Choffel :\nTournoi garçons et filles 15/18 ans.\nTournoi jeunes garçons et filles 11/12 ans et 13/14 ans.\n\nOpen SOFIDA auto :\nTournoi \"hors catégorie\" Open Dames et Messieurs."
        ],
        "es": [
          "Copa Choffel :\nTorneo para chicos y chicas de 15/18 años.\nTorneo juvenil para chicos y chicas de 11/12 y 13/14 años.\n\nOpen SOFIDA auto :\nTorneo Open Damas y Caballeros \"fuera de categoría\"."
        ],
        "nl": [
          "Choffel Cup :\nJongens- en meisjestoernooi 15/18 jaar.\nJeugdtoernooi voor jongens en meisjes van 11/12 en 13/14 jaar.\n\nOpen SOFIDA auto :\nOpen dames- en herentoernooi \"buiten categorie\"."
        ]
      },
