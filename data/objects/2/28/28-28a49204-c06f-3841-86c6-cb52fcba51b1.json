  "rdfs:comment": {
    "de": [
      "Das im Herzen von Fargniers gelegene Le Paon empfängt Sie in einer warmen und freundlichen Umgebung. Sein Team, das aus professionellen Gastronomen besteht, wird Ihnen die Aromen der lokalen Gastronomie näher bringen."
    ],
    "en": [
      "Located in the heart of Fargniers, the Peacock welcomes you in a warm and friendly environment. Its team, made up of professionals of the restoration will make you discover the savours of the local gastronomy."
    ],
    "it": [
      "Situato nel cuore di Fargniers, Le Paon vi accoglie in un'atmosfera calda e accogliente. Il suo team di ristoratori professionisti vi farà scoprire i sapori della gastronomia locale."
    ],
    "fr": [
      "Situé au coeur de Fargniers, le Paon vous accueille dans un cadre chaleureux et convivial. Son équipe, constituée de professionnels de la restauration vous fera découvrir les saveurs de la gastronomie locale."
    ],
    "es": [
      "Situado en el corazón de Fargniers, Le Paon le da la bienvenida en un ambiente cálido y acogedor. Su equipo de restauradores profesionales le hará descubrir los sabores de la gastronomía local."
    ],
    "nl": [
      "Le Paon ligt in het hart van Fargniers en verwelkomt je in een warme en vriendelijke sfeer. Het team van professionele restaurateurs zal u helpen de smaken van de lokale gastronomie te ontdekken."
    ]
  },
