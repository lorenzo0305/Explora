  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2fc653d8-7ca6-3c74-8873-2627adb69c10",
      "dc:description": {
        "de": [
          "Machen Sie sich bereit für einen außergewöhnlichen Abend mit dem talentierten Zauberer Alexis Hazard. Tauchen Sie ein in eine Welt, in der das Unmögliche möglich wird, und lassen Sie sich von faszinierenden Illusionen und verblüffenden Zaubertricks mitreißen."
        ],
        "en": [
          "Get ready for an extraordinary evening with talented magician Alexis Hazard. Immerse yourself in a world where the impossible becomes possible and let yourself be carried away by fascinating illusions and amazing magic tricks."
        ],
        "it": [
          "Preparatevi a una serata straordinaria con il talentuoso mago Alexis Hazard. Immergetevi in un mondo in cui l'impossibile diventa possibile e lasciatevi trasportare da affascinanti illusioni e sorprendenti trucchi di magia."
        ],
        "fr": [
          "Préparez-vous à vivre une soirée extraordinaire avec le talentueux magicien Alexis Hazard. Plongez dans un univers où l'impossible devient possible et laissez-vous emporter par des illusions fascinantes et des tours de magie stupéfiants."
        ],
        "es": [
          "Prepárese para una velada extraordinaria con el talentoso mago Alexis Hazard. Sumérjase en un mundo donde lo imposible se hace posible y déjese llevar por fascinantes ilusiones y asombrosos trucos de magia."
        ],
        "nl": [
          "Bereid je voor op een buitengewone avond met de getalenteerde goochelaar Alexis Hazard. Dompel jezelf onder in een wereld waar het onmogelijke mogelijk wordt en laat je meeslepen door fascinerende illusies en verbazingwekkende goocheltrucs."
        ]
      },
      "@type": [
        "Description"
