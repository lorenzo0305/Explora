  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b04ee397-d0cd-37a5-b974-7126033a6fb7",
      "dc:description": {
        "de": [
          "GRUPPENKURS FÜR POSTURALES YOGA FÜR ERWACHSENE\nOrganisiert von SO'Zen Côte d'Opale\nAm Montag, den 27. Mai, 10. Juni, 17. Juni und 24. Juni\nVon 17H15 bis 18H\nIm Bad'Huit in St Martin Boulogne (vollständige Adresse wird bei der Anmeldung angegeben)\n15? pro Schnupperstunde\nKontakt unter 0601902394\nEine vorherige Anmeldung ist erforderlich!"
        ],
        "en": [
          "GROUP POSTURAL YOGA CLASS FOR ADULTS\nOrganized by SO'Zen Côte d'Opale\nMondays May 27, June 10, June 17 and June 24\nFrom 5.15pm to 6pm\nAt Bad'Huit in St Martin Boulogne (full address given on registration)\n15? per discovery session\nContact 0601902394\nPrior registration is mandatory!"
        ],
        "it": [
          "CORSO DI YOGA POSTURALE DI GRUPPO PER ADULTI\nOrganizzato da SO'Zen Côte d'Opale\nLunedì 27 maggio, 10 giugno, 17 giugno e 24 giugno\nDalle 17.15 alle 18.00\nPresso Bad'Huit a St Martin Boulogne (indirizzo completo fornito al momento dell'iscrizione)\n15? per sessione introduttiva\nContattare 0601902394\nL'iscrizione preventiva è obbligatoria!"
        ],
        "fr": [
          "COURS DE YOGA POSTURAL COLLECTIF POUR ADULTES \nOrganisé par SO'Zen Côte d'Opale \nLes lundi 27 mai, 10 juin, 17 juin et 24 juin\nDe 17H15 à 18H \nAu Bad'Huit à St Martin Boulogne (adresse complète donnée à l'inscription) \n15€ par séance découverte \nContact au 0601902394\nUne inscription préalable est obligatoire !!"
        ],
        "nl": [
          "YOGALES VOOR VOLWASSENEN\nGeorganiseerd door SO'Zen Côte d'Opale\nMaandag 27 mei, 10 juni, 17 juni en 24 juni\nVan 17u15 tot 18u\nBij Bad'Huit in St Martin Boulogne (volledig adres bij inschrijving)\n15 per kennismakingssessie\nNeem contact op met 0601902394\nVooraf inschrijven is verplicht!"
        ],
        "es": [
          "CLASE DE YOGA POSTURAL EN GRUPO PARA ADULTOS\nOrganizado por SO'Zen Côte d'Opale\nLunes 27 de mayo, 10 de junio, 17 de junio y 24 de junio\nDe 17h15 a 18h00\nEn Bad'Huit en St Martin Boulogne (dirección completa al inscribirse)\n15? por sesión introductoria\nPóngase en contacto con 0601902394\nInscripción previa obligatoria"
        ]
      },
