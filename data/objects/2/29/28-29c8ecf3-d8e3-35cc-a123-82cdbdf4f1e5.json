  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a698fdec-1405-3b14-a1fe-653a85ac9e9b",
      "dc:description": {
        "de": [
          "Willkommen bei My Crepe, das Sie mit seinen süßen und herzhaften Crêpes im Herzen des Parc Gouraud verwöhnt.\nSie werden herzlich empfangen und bei der Auswahl Ihrer Gerichte beraten, falls Sie einmal zögern sollten!"
        ],
        "en": [
          "Welcome to My Crepe, serving sweet and savoury crepes in the heart of the Parc Gouraud.\nWe'll give you a warm welcome and help you choose your dishes if you're not sure!"
        ],
        "it": [
          "Benvenuti da My Crepe, che serve crepes dolci e salate nel cuore del Parc Gouraud.\nVi daremo un caloroso benvenuto e vi aiuteremo a scegliere i vostri piatti se non siete sicuri!"
        ],
        "fr": [
          "Bienvenue à My Crepe qui vous régale avec ses crêpes salées, sucrées en plein coeur du Parc Gouraud.\nVous serez accueillis chaleureusement et conseillés pour le choix de vos plats si jamais vous hésitez !"
        ],
        "nl": [
          "Welkom bij My Crepe, met zoete en hartige crêpes in het hart van het Parc Gouraud.\nWe heten je van harte welkom en helpen je bij het kiezen van je gerechten als je het niet zeker weet!"
        ],
        "es": [
          "Bienvenido a My Crepe, crepes dulces y salados en el corazón del Parque Gouraud.\nLe daremos una cálida bienvenida y le ayudaremos a elegir sus platos si no está seguro"
        ]
      },
