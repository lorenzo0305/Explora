      "dc:description": {
        "de": [
          "Salziges vor Ort oder zum Mitnehmen: Amerikaner, Paninis, Pommes frites, Croque Monsieur, Hamburger\nAuch Süßes vor Ort oder zum Mitnehmen: Crêpes, Paninis, amerikanisches Gebäck, Eis"
        ],
        "en": [
          "Savoury on the spot or to take away: american, paninis, french fries, croques monsieur, hamburgers\nAlso sweet products on the spot or to take away: pancakes, paninis, American pastries, ice cream, etc"
        ],
        "it": [
          "Salati sul posto o da asporto: americani, panini, patatine fritte, croques monsieur, hamburger\nDolci anche sul posto o da asporto: pancake, panini, pasticceria americana, gelato"
        ],
        "fr": [
          "Salé sur place ou à emporter : américains, paninis, frites, croques monsieur, hamburgers\nEgalement du sucré sur place ou à emporter : crêpes, paninis, viennoiseries américaines, glaces"
        ],
        "es": [
          "Salados en el momento o para llevar: americanos, paninis, patatas fritas, croques monsieur, hamburguesas\nTambién dulces en el momento o para llevar: tortitas, paninis, bollería americana, helados"
        ],
        "nl": [
          "Hartig ter plaatse of om mee te nemen: American, panini's, frieten, croques monsieur, hamburgers\nOok zoet ter plaatse of om mee te nemen: pannenkoeken, panini's, Amerikaans gebak, ijs"
        ]
      },
