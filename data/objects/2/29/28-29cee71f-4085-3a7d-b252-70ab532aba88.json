  "rdfs:comment": {
    "de": [
      "Ein Tag im Paris der Belle Epoque im Leben von Madame, der von zahlreichen Terminen unterbrochen wird, die Sie unter keinen Umständen verpassen dürfen: Einkaufen, Restaurant, Spaziergang im Wald, Zirkus und Kabarett natürlich!"
    ],
    "en": [
      "A day in the Paris of the Belle Epoque in the life of Madame, punctuated by a host of not-to-be-missed events: shopping, restaurants, walks in the woods, the circus and, of course, cabaret!"
    ],
    "it": [
      "Una giornata nella Parigi della Belle Epoque nella vita di Madame, scandita da una serie di eventi imperdibili: shopping, ristoranti, passeggiate nel bosco, il circo e il cabaret, naturalmente!"
    ],
    "fr": [
      "Une journée dans ce Paris de la Belle époque dans la vie de Madame ponctuée de multiples rendez-vous à ne manquer sous aucun prétexte : emplettes, restaurant, promenade au bois, cirque et cabaret bien sûr !"
    ],
    "es": [
      "Un día en el París de la Belle Époque, en la vida de Madame, salpicado de una serie de citas ineludibles: compras, restaurantes, paseos por el bosque, circo y cabaret, ¡por supuesto!"
    ],
    "nl": [
      "Een dag in het Parijs van de Belle Epoque in het leven van Madame, onderbroken door een reeks niet te missen evenementen: winkelen, restaurants, boswandelingen, het circus en cabaret, natuurlijk!"
    ]
  },
