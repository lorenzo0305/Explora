  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1a3d8dda-8c48-3c5b-9198-86dd3cc5ca7a",
      "dc:description": {
        "de": [
          "BREAKING NEWS! Die Bienen haben beschlossen, ihr Geheimnis der Honigherstellung zu lüften und gewähren uns sogar Zugang zu ihrer Lagereinheit. Dieser Workshop endet mit einer Honigverkostung! Hmmm!"
        ],
        "en": [
          "BREAKING NEWS! The bees have decided to reveal their secret to honey-making, and even let us into their storage unit. The workshop ends with a honey tasting! Hmmm!"
        ],
        "it": [
          "NOTIZIA BREVISSIMA! Le api hanno deciso di rivelarci il loro segreto per la produzione del miele e ci danno persino accesso al loro magazzino. Il workshop si conclude con una degustazione di miele! Hmmm!"
        ],
        "fr": [
          "BREAKING NEWS ! Les abeilles ont décidé de dévoiler leur secret de la fabrication du miel et nous laissent même accéder à leur unité de stockage. Cet atelier se terminera pour une dégustation de miel ! Hmmm !"
        ],
        "es": [
          "NOTICIAS DE ÚLTIMA HORA Las abejas han decidido revelarnos su secreto para fabricar miel, e incluso nos dan acceso a su almacén. El taller termina con una degustación de miel ¡Hmmm!"
        ],
        "nl": [
          "BREAKING NEWS! De bijen hebben besloten hun geheim om honing te maken te onthullen en geven ons zelfs toegang tot hun opslagruimte. De workshop eindigt met een honingproeverij! Hmmm!"
        ]
      },
