  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9a4f22bb-e360-382a-a0d8-376f1f15b058",
      "dc:description": {
        "de": [
          "Japanisch bis zum Abwinken!\nHaben Sie Lust auf Sushi, Yakitori oder andere japanische Spezialitäten?\nEntdecken Sie SUSHIRAMA, die neue japanische Referenz in Amiens!\nHier finden Sie eine große Auswahl an japanischen Spezialitäten, die Sie nach Herzenslust genießen können!\nSie können auch Menüs zum Mitnehmen wählen."
        ],
        "en": [
          "Japanese food at will!\nA desire of Sushi ? of Yakitori ? or other Japanese specialities?\nCome and discover SUSHIRAMA, the new Japanese reference in Amiens!\nYou will find a large choice of Japanese specialties at will!\nYou can also choose take-away menus."
        ],
        "it": [
          "Cibo giapponese a volontà!\nDesiderio di Sushi, Yakitori o altre specialità giapponesi?\nVenite a scoprire SUSHIRAMA, il nuovo riferimento giapponese ad Amiens!\nTroverete un'ampia scelta di specialità giapponesi!\nÈ possibile scegliere anche menu da asporto."
        ],
        "fr": [
          "Du japonais à volonté !\nUne envie de Sushi ? de Yakitori ? ou autres spécialités japonaises?\nVenez découvrir SUSHIRAMA, la nouvelle référence japonaise sur Amiens !\nVous y trouverez un large choix de spécialités japonaises à volonté !\nVous pouvez aussi choisir des menus à emporter."
        ],
        "es": [
          "¡Comida japonesa a voluntad!\n¿Deseos de sushi? ¿Yakitori? u otras especialidades japonesas?\nVenga a descubrir SUSHIRAMA, la nueva referencia japonesa en Amiens\nEncontrará una gran variedad de especialidades japonesas\nTambién puede optar por los menús para llevar."
        ],
        "nl": [
          "Japans eten naar believen!\nZin in Sushi ? Yakitori ? of andere Japanse specialiteiten ?\nKom en ontdek SUSHIRAMA, de nieuwe Japanse referentie in Amiens!\nU vindt er een grote keuze aan Japanse specialiteiten!\nU kunt ook kiezen voor afhaalmenu's."
        ]
      },
