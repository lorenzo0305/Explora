  "rdfs:comment": {
    "de": [
      "Stelle mit den Freiwilligen des Vereins für kreative Freizeitgestaltung eine Osterkreation her\nKostenloses Pausenbrot\n\nVon 4 bis 15 Jahren!\n\nAnmeldung erforderlich - begrenzte Plätze - nur für Kinder (Anwesenheit der Eltern nicht erwünscht)\nSaal Aimé Savary (rue des écoles)"
    ],
    "en": [
      "Make an Easter creation with volunteers from the creative leisure association\nComplimentary snack\n\nAges 4 to 15!\n\nRegistration required - places limited - for children only (parents not welcome)\nSalle Aimé Savary (rue des écoles)"
    ],
    "it": [
      "Realizzare una creazione pasquale con i volontari dell'associazione creativa per il tempo libero\nPranzo offerto\n\nDai 4 ai 15 anni!\n\nIscrizione obbligatoria - posti limitati - solo per bambini (genitori esclusi)\nSala Aimé Savary (rue des écoles)"
    ],
    "fr": [
      "Fabrique une création de Pâques  en compagnie des bénévoles de l'association des loisirs créatifs\nGouter offert \n\nDe 4 à 15 ans !\n\nInscription obligatoire - places limitées - réservées aux enfants (présence des parents non souhaitée)\nSalle Aimé Savary (rue des écoles)"
    ],
    "es": [
      "Realiza una creación de Pascua con los voluntarios de la asociación de ocio creativo\nAlmuerzo ofrecido\n\nDe 4 a 15 años\n\nInscripción obligatoria - plazas limitadas - sólo para niños (padres no bienvenidos)\nSala Aimé Savary (rue des écoles)"
    ],
    "nl": [
      "Maak een paascreatie met vrijwilligers van de creatieve vrijetijdsvereniging\nLunch aangeboden\n\nVan 4 tot 15 jaar!\n\nInschrijving verplicht - plaatsen beperkt - alleen voor kinderen (ouders niet welkom)\nSalle Aimé Savary (Onderwijsstraat)"
    ]
  },
  "rdfs:label": {
