  "rdfs:comment": {
    "de": [
      "Nicolas Gautier erweckt im Bistrot RG die Rezepte seines Vaters zu neuem Leben. Sein Team lässt uns eine Küche entdecken, die mit Erinnerungen beladen ist."
    ],
    "en": [
      "Nicolas Gautier brings his father's recipes back to life in the Bistrot RG. His team makes us discover a kitchen full of memories."
    ],
    "it": [
      "Nicolas Gautier fa rivivere le ricette di suo padre nel Bistrot RG. Il suo team ci fa scoprire una cucina piena di ricordi."
    ],
    "fr": [
      "Nicolas Gautier redonne vie aux recettes de son papa dans le Bistrot RG. Son équipe nous fait découvrir une cuisine chargée de souvenir."
    ],
    "es": [
      "Nicolas Gautier resucita las recetas de su padre en el Bistrot RG. Su equipo nos hace descubrir una cocina llena de recuerdos."
