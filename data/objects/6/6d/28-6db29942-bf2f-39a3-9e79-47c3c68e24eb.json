  "rdfs:comment": {
    "de": [
      "150 ha großes Gelände\n\nEin Lehrpfad ist auf dem Angelgelände zugänglich. Sie lernen die Fauna der Picardie, Vögel, Schmetterlinge, Fische und die aquatische Umwelt anhand von Schautafeln kennen."
    ],
    "en": [
      "150 ha site\n\nAn educational trail is accessible on the fishing site, where you can discover the fauna of Picardy, birds, butterflies, fish and the aquatic environment thanks to display panels."
    ],
    "it": [
      "Sito di 150 ettari\n\nUn percorso didattico è accessibile sul sito di pesca, dove è possibile scoprire la fauna della Piccardia, gli uccelli, le farfalle, i pesci e l'ambiente acquatico grazie a pannelli espositivi."
    ],
    "fr": [
      "Site de 150 ha\n\nUn sentier pédagogique est accessible sur le site de pêche, vous découvrez la faune de Picardie,  les oiseaux, papillons, poissons et le milieu aquatique grâce à des panneaux d'affichage."
    ],
    "nl": [
      "150 ha terrein\n\nOp de visstek is een educatief parcours toegankelijk waar je de fauna van Picardië, vogels, vlinders, vissen en het aquatisch milieu kunt ontdekken dankzij informatieborden."
    ],
    "es": [
      "150 ha de terreno\n\nSe puede acceder a un sendero pedagógico en el lugar de pesca, donde podrá descubrir la fauna de Picardía, las aves, las mariposas, los peces y el medio acuático gracias a paneles expositivos."
    ]
  },
  "rdfs:label": {
