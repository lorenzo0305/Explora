  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a6977481-ae64-31ba-9d96-b7554b9579f6",
      "dc:description": {
        "de": [
          "Montag, den 19. Januar 2026\n\"Die Französische Revolution in den Regionen Nord und Pas-de-Calais\" von Bruno Béthouart.\nUm 18.30 Uhr im Maison des Associations\n\nMontag, den 31. August 2026\n\"Die Heilpflanzen von Madagaskar\" geleitet von Françoise PAYEN\nUm 18.30 Uhr im Maison des Associations"
        ],
        "en": [
          "Monday, January 19, 2026\n\"The French Revolution in Nord and Pas-de-Calais\" by Bruno Béthouart.\nAt 6:30pm at the Maison des Associations\n\nMonday, August 31, 2026\n\"The medicinal plants of Madagascar\" by Françoise PAYEN\nAt 6:30pm at the Maison des Associations"
        ],
        "it": [
          "Lunedì 19 gennaio 2026\n\"La rivoluzione francese nel Nord e nel Pas-de-Calais\" di Bruno Béthouart.\nAlle ore 18.30 presso la Maison des Associations\n\nLunedì 31 agosto 2026\n\"Le piante medicinali del Madagascar\" di Françoise PAYEN\nAlle 18.30 alla Maison des Associations"
        ],
        "fr": [
          "Lundi 19 janvier 2026\n\"La Révolution Française dans le Nord et le Pas-de-Calais\" par Bruno Béthouart.\nA 18h30 à la Maison des Associations\n\nLundi 31 août 2026\n«  Les plantes médicinales de Madagascar » animée par Françoise PAYEN\nA 18h30 à la Maison des Associations"
        ],
        "nl": [
          "Maandag 19 januari 2026\n\"De Franse Revolutie in Nord en Pas-de-Calais\" door Bruno Béthouart.\nOm 18.30 uur in het Maison des Associations\n\nMaandag 31 augustus 2026\n\"De geneeskrachtige planten van Madagaskar\" door Françoise PAYEN\nOm 18u30 in het Maison des Associations"
        ],
        "es": [
          "Lunes 19 de enero de 2026\n\"La Revolución Francesa en el Norte y el Pas-de-Calais\", por Bruno Béthouart.\nA las 18.30 h en la Casa de las Asociaciones\n\nLunes 31 de agosto de 2026\n\"Las plantas medicinales de Madagascar\" por Françoise PAYEN\nA las 18.30 h en la Casa de las Asociaciones"
        ]
      },
