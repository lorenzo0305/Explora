  "rdfs:comment": {
    "de": [
      "Möchten Sie alle Schätze entdecken, die das Nationale Naturschutzgebiet Marais d'Isle birgt? Das Maison de l'Environnement ist jeden Tag kostenlos für Sie geöffnet."
    ],
    "en": [
      "Would you like to discover all the riches of the Marais d'Isle National Nature Reserve? The Maison de l'Environnement is open every day, free of charge."
    ],
    "it": [
      "Volete scoprire tutte le ricchezze della Riserva Naturale Nazionale del Marais d'Isle? La Maison de l'Environnement è aperta tutti i giorni, gratuitamente."
    ],
    "fr": [
      "Vous souhaitez découvrir toutes les richesses que recèle la Réserve Naturelle Nationale des Marais d’Isle ? La Maison de l’Environnement est ouverte pour vous tous les jours, gratuitement."
    ],
    "es": [
      "¿Desea descubrir todas las riquezas de la Reserva Natural Nacional del Marais d'Isle? La Maison de l'Environnement está abierta todos los días, de forma gratuita."
    ],
    "nl": [
      "Wil je alle rijkdommen van het nationale natuurreservaat Marais d'Isle ontdekken? Het Maison de l'Environnement is elke dag gratis geopend."
    ]
  },
