  "rdfs:comment": {
    "de": [
      "Entdecken Sie unseren 850 m² großen Wellnessbereich mit einem Jacuzzi, einem traditionellen Hammam, einer Sauna, einem Sinnestunnel, einer Schneedusche und einer Salzwand."
    ],
    "en": [
      "Discover our 850 m² space and its SPA including a jacuzzi, a traditional hammam, a sauna, a sensory tunnel, a snow shower and a salt wall."
    ],
    "it": [
      "Scoprite il nostro spazio di 850 m² e la sua SPA che comprende una jacuzzi, un hammam tradizionale, una sauna, un tunnel sensoriale, una doccia di neve e una parete di sale."
    ],
    "fr": [
      "Découvrez notre espace de 850 m² et son SPA comprenant un jacuzzi, un hammam traditionnel, un sauna, un tunnel sensoriel, une douche de neige et un mur de sel."
    ],
    "nl": [
      "Ontdek onze 850 m² grote ruimte en zijn SPA met een jacuzzi, een traditionele hammam, een sauna, een zintuiglijke tunnel, een sneeuwdouche en een zoutmuur."
    ],
    "es": [
      "Descubra nuestro espacio de 850 m² y su SPA que incluye un jacuzzi, un hammam tradicional, una sauna, un túnel sensorial, una ducha de nieve y una pared de sal."
    ]
  },
