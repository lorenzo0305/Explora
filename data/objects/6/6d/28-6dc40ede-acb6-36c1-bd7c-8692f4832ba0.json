  "rdfs:comment": {
    "de": [
      "Öffnen Sie die Türen dieses für Nordfrankreich typischen Hauses aus roten Backsteinen. Hier werden Ihnen leckere und großzügige Gerichte serviert."
    ],
    "en": [
      "Push the doors of this red brick house, typical of Northern France. You will find generous and gourmet dishes."
    ],
    "it": [
      "Spingete le porte di questa casa in mattoni rossi, tipica del Nord della Francia. Troverete piatti generosi e gourmet."
    ],
    "fr": [
      "Poussez les portes de cette demeure en briques rouges, typique du Nord de la France. Vous y trouverez des plats gourmands et généreux."
    ],
    "es": [
      "Empuje las puertas de esta casa de ladrillo rojo, típica del norte de Francia. Encontrará platos generosos y gourmet."
    ],
    "nl": [
      "Duw de deuren van dit rode bakstenen huis, typisch voor Noord-Frankrijk. U vindt er royale en gastronomische gerechten."
    ]
  },
