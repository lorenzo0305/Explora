  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/173f4264-7dab-3647-8e9a-608b60e29ed6",
      "dc:description": {
        "de": [
          "Riesige Wasserrutsche, Schwimmbad, Wasserspiele, Workshops, aufblasbare Strukturen... Le Bord-des-Eaux nimmt so den Charakter eines Badeortes mit feinem Sandstrand an."
        ],
        "en": [
          "Giant waterslide, swimming pool, water games, workshops, inflatables... Le Bord-des-Eaux takes on the air of a seaside resort, with a fine sandy beach."
        ],
        "it": [
          "Acquascivolo gigante, piscina, giochi d'acqua, laboratori, gonfiabili... Bord-des-Eaux ha l'aspetto e l'atmosfera di una località balneare, con una spiaggia di sabbia fine."
        ],
        "fr": [
          "Toboggan aquatique géant, piscine, jeux aquatiques, ateliers, structures gonflables... Le Bord-des-Eaux prend ainsi des airs de station balnéaire, avec une plage de sable fin."
        ],
        "es": [
          "Tobogán gigante, piscina, juegos acuáticos, talleres, hinchables... Bord-des-Eaux tiene el aspecto de una estación balnearia, con una playa de arena fina."
        ],
        "nl": [
          "Reuzenglijbaan, zwembad, waterspelletjes, workshops, opblaasbare structuren... Bord-des-Eaux heeft de uitstraling van een badplaats, met een fijn zandstrand."
        ]
      },
