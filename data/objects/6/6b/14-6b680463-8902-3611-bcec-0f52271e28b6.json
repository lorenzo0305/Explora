  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b0164a65-50f6-3b0f-abaa-bc68d63ee338",
      "dc:description": {
        "de": [
          "Fête des Caddys Volants, von 15 bis 18 Uhr, im Palais des Congrès, organisiert von Rotary Canche Authie und der Stadt Le Touquet.\n\nKekswerfen, große Tombola, zahlreiche Preise, Unterhaltung, Getränkestand, Oldtimer."
        ],
        "en": [
          "Fête des Caddys Volants, from 3pm to 6pm, at the Palais des Congrès, organized by Rotary Canche Authie and the town of Le Touquet.\n\nCookie throwing, tombola, lots of prizes, entertainment, refreshments, vintage cars."
        ],
        "it": [
          "Fête des Caddys Volants, dalle 15.00 alle 18.00, presso il Palais des Congrès, organizzata dal Rotary Canche Authie e dalla città di Le Touquet.\n\nLancio di biscotti, tombola, tanti premi, animazione, rinfresco, auto d'epoca."
        ],
        "fr": [
          "Fête des Caddys Volants, de 15h à 18h, au Palais des Congrès, organisée par le Rotary Canche Authie et la ville du Touquet.\n\nLancer de biscuits, grande tombola, nombreux lots, animations, buvette, voitures de collection."
        ],
        "nl": [
          "Fête des Caddys Volants, van 15.00 tot 18.00 uur, in het Palais des Congrès, georganiseerd door Rotary Canche Authie en de stad Le Touquet.\n\nKoekjes gooien, tombola, veel prijzen, entertainment, versnaperingen, oldtimers."
        ],
        "es": [
          "Fête des Caddys Volants, de 15.00 a 18.00 h, en el Palacio de Congresos, organizada por el Rotary Canche Authie y la ciudad de Le Touquet.\n\nLanzamiento de galletas, tómbola, muchos premios, animaciones, refrescos, coches de época."
        ]
      },
