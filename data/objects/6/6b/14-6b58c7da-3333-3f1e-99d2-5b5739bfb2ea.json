  "rdfs:comment": {
    "de": [
      "Wie in jeder Schulferienzeit bietet das Mariska-Theater seinem Publikum mehrere Aufführungen von Puppentheaterstücken an\n fadenpuppen an, in denen Petit Jean, ein junger Held, unglaubliche Abenteuer erlebt."
    ],
    "en": [
      "As it does every school vacation season, Théâtre Mariska offers its audiences several string puppet shows in which Petit Jean, a young hero, is about to experience some incredible adventures\n in which Petit Jean, a young hero, lives out some incredible adventures."
    ],
    "it": [
      "Come ogni periodo di vacanze scolastiche, il Théâtre Mariska propone al suo pubblico una serie di spettacoli di marionette a filo in cui Petit Jean, un giovane eroe, vivrà delle incredibili avventure\n in cui Petit Jean, un giovane eroe, vivrà alcune incredibili avventure."
    ],
    "fr": [
      "Comme à chaque période de vacances scolaires, le Théâtre Mariska propose à son public plusieurs spectacles de\n marionnettes à fils dans lesquels Petit Jean, un jeune héros, va vivre d'incroyables aventures."
    ],
    "nl": [
      "Zoals elke schoolvakantie biedt Théâtre Mariska zijn publiek verschillende voorstellingen met touwpoppen waarin Petit Jean, een jonge held, ongelooflijke avonturen beleeft\n waarin Petit Jean, een jonge held, ongelooflijke avonturen beleeft."
    ],
    "es": [
      "Como cada período de vacaciones escolares, el Théâtre Mariska ofrece a su público varios espectáculos de marionetas de hilo en los que Petit Jean, un joven héroe, vivirá algunas aventuras increíbles\n en los que Petit Jean, un joven héroe, vivirá algunas aventuras increíbles."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La maison du sucre - Théâtre Mariska"
    ]
  },
