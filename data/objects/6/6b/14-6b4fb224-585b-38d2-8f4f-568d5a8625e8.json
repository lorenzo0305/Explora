  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3286473c-f2e3-3915-aa6e-663551911d27",
      "dc:description": {
        "de": [
          "Im Rahmen des Rosa Oktobers\nErneuerung der Aktion im dritten Jahr in Folge.\nWim'Rose-Turniere für den Kampf gegen Krebs.\nDer Erlös geht an den Verein Étincelle.\nGetränke und Speisen vor Ort.\nSpenden vor Ort möglich."
        ],
        "en": [
          "As part of pink october\nRenewal of the operation for the 3rd consecutive year.\nWim'Rose tournaments for the fight against cancer.\nProfits donated to the Étincelle association.\nRefreshment bar and catering on site.\nOn-site donations possible."
        ],
        "it": [
          "Come parte della rosa di ottobre\nRinnovo dell'operazione per il 3° anno consecutivo.\nTornei di Wim'Rose a sostegno della lotta contro il cancro.\nProfitti devoluti all'associazione Étincelle.\nRinfresco e ristorazione sul posto.\nPossibilità di donazioni in loco."
        ],
        "fr": [
          "Dans le cadre d'octobre rose \nRenouvellement de l'opération pour la 3e année consécutive.\nTournois Wim'Rose pour la lutte contre le cancer.\nBénéfice reversé à l'association Étincelle.\nBuvette et restauration sur place.\nDons sur place possible."
        ],
        "es": [
          "Como parte de la rosa de octubre\nRenovación de la operación por 3er año consecutivo.\nTorneos Wim'Rose en apoyo de la lucha contra el cáncer.\nBeneficios donados a la asociación Étincelle.\nRefrescos y catering in situ.\nDonaciones posibles in situ."
        ],
        "nl": [
          "Als onderdeel van oktober steeg\nVernieuwing van de operatie voor het 3e opeenvolgende jaar.\nWim'Rose toernooien ter ondersteuning van de strijd tegen kanker.\nDe winst gaat naar de vereniging Étincelle.\nVersnaperingen en catering ter plaatse.\nDonaties ter plaatse mogelijk."
        ]
      },
      "@type": [
        "Description"
      ],
