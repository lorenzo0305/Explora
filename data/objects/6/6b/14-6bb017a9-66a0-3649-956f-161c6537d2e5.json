      "dc:description": {
        "de": [
          "Bar-Brasserie auf dem Place des Héros gelegen. Biere, Croque-monsieurs, Tagesgerichte....\n\nÖffnungszeiten:\n\nMontag bis Freitag von 11:00 bis 01:00 Uhr\nAm Samstag von 10 Uhr bis 01 Uhr\nSonntag von 15:00 bis 01:00 Uhr"
        ],
        "en": [
          "Bar-brasserie located on Place des Héros. Beers, croque-monsieurs, daily specials....\n\nOpening hours :\n\nMonday to Friday, 11am to 1am\nSaturday from 10am to 01am\nSunday from 15h to 01h"
        ],
        "it": [
          "Bar-brasserie situato in Place des Héros. Birre, croque-monsieurs, specialità del giorno....\n\nOrari di apertura :\n\nDa lunedì a venerdì, dalle 11.00 all'1.00\nSabato dalle 10.00 all'1.00\nDomenica dalle 15.00 all'1.00"
        ],
        "fr": [
          "Bar-brasserie située sur la place des Héros. Bières, croque-monsieurs, plats du jour....\n\nHoraires : \n\nDu lundi au vendredi de 11h à 01h \nLe samedi de 10h à 01h\nLe dimanche de 15h à 01h"
        ],
        "es": [
          "Bar-brasserie situado en la Place des Héros. Cervezas, croque-monsieurs, platos del día....\n\nHorario de apertura :\n\nDe lunes a viernes, de 11:00 a 01:00\nSábado de 10h a 1h\nDomingo de 15h a 1h"
        ],
        "nl": [
          "Bar-brasserie op de Place des Héros. Bieren, croque-monsieurs, dagschotels....\n\nOpeningstijden :\n\nMaandag tot vrijdag van 11 tot 1 uur\nZaterdag van 10.00 tot 1.00 uur\nZondag van 15 tot 1 uur"
        ]
      },
