      "@id": "https://data.datatourisme.fr/a29d316b-1610-3b06-8083-a07c8881de8c",
      "dc:description": {
        "de": [
          "Ein Familienereignis, das um 14:30 Uhr mit einem Workshop Parcours Plastische Kunst im Rahmen des CLEA beginnt. Der Nachmittag wird mit einem Konzert der Gruppe June Bug um 16 Uhr fortgesetzt."
        ],
        "en": [
          "This family-friendly event kicks off at 2:30 pm with a CLEA art workshop. The afternoon continues with a concert by June Bug at 4pm."
        ],
        "it": [
          "Un evento per famiglie che inizia alle 14.30 con un laboratorio CLEA sulle arti visive. Il pomeriggio prosegue con un concerto del gruppo June Bug alle 16.00."
        ],
        "fr": [
          "Un événement familial qui débute à 14h30 par un atelier parcours Arts Plastiques dans le cadre du CLEA. L'après-midi se poursuit avec en concert à 16h du groupe June Bug."
        ],
        "es": [
          "Evento familiar que comienza a las 14.30 h con un taller CLEA de artes plásticas. La tarde continúa con un concierto a las 16:00 del grupo June Bug."
        ],
        "nl": [
          "Een familie-evenement dat om 14.30 uur begint met een CLEA-workshop over beeldende kunst. De middag gaat verder met een concert om 16.00 uur door de groep June Bug."
        ]
      },
