  "rdfs:comment": {
    "de": [
      "Am Samstag, dem 4. April, erstrahlt der Place Jeanne Hachette in den schönsten Farben, um \"Pâques Hachette\" zu begrüßen. Von 14:00 bis 19:30 Uhr feiern Sie die Rückkehr der schönen Tage im Herzen der Hauptstadt der Oise mit einem festlichen und kostenlosen Nachmittag."
    ],
    "en": [
      "On Saturday, April 4, Place Jeanne Hachette will be decked out in its finest colors to welcome \"Easter Hachette\". From 2pm to 7:30pm, come and celebrate the return of fine weather to the heart of the capital of the Oise region during a festive afternoon, entirely free of charge."
    ],
    "it": [
      "Sabato 4 aprile, la Place Jeanne Hachette si vestirà dei suoi colori più belli per dare il benvenuto alla \"Pasqua Hachette\". Dalle 14.00 alle 19.30, venite a festeggiare il ritorno del bel tempo nel cuore della capitale dell'Oise durante un pomeriggio di festa, completamente gratuito."
    ],
    "fr": [
      "Le samedi 4 avril, la place Jeanne Hachette se pare de ses plus belles couleurs pour accueillir « Pâques Hachette ». De 14h à 19h30, venez célébrer le retour des beaux jours au cœur de la capitale de l'Oise lors d'une après-midi festive et entièrement gratuite."
    ],
    "nl": [
      "Op zaterdag 4 april wordt het Jeanne Hachetteplein in zijn mooiste kleuren gehuld om \"Paas Hachette\" te verwelkomen. Kom van 14.00 tot 19.30 uur de terugkeer van het mooie weer vieren in het hart van de hoofdstad van de Oise tijdens een geheel gratis feestelijke middag."
    ],
    "es": [
      "El sábado 4 de abril, la plaza Jeanne Hachette se engalanará con sus mejores colores para dar la bienvenida a la \"Pascua Hachette\". De 14:00 a 19:30, venga a celebrar el regreso del buen tiempo al corazón de la capital de la región de Oise durante una tarde festiva y totalmente gratuita."
    ]
  },
  "rdfs:label": {
