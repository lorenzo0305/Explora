  "rdfs:comment": {
    "de": [
      "Das Arsenal, das als Raum für temporäre Ausstellungen umgebaut wurde, bietet Ausstellungen, die sich an zeitgenössischem Kunstschaffen orientieren, und Konzerte im Rahmen von Museum/Musik."
    ],
    "en": [
      "Rehabilitated as a temporary exhibition space, the Arsenal offers exhibitions focused on contemporary creation and concerts within the framework of Museum/Music."
    ],
    "it": [
      "Riabilitato come spazio espositivo temporaneo, l'Arsenale offre mostre incentrate sulla creazione contemporanea e concerti nell'ambito del programma Museo/Musica."
    ],
    "fr": [
      "Réhabilité en espace d'expositions temporaires, l'Arsenal propose des expositions orientées sur la création contemporaine et des concerts dans le cadre de Musée/Musique."
    ],
    "es": [
      "Rehabilitado como espacio de exposiciones temporales, el Arsenal ofrece exposiciones centradas en la creación contemporánea y conciertos dentro del programa Museo/Música."
    ],
    "nl": [
      "Het Arsenaal, dat is omgebouwd tot tijdelijke tentoonstellingsruimte, biedt tentoonstellingen over hedendaagse creaties en concerten in het kader van het programma Museum/Muziek."
    ]
  },
