  "rdfs:comment": {
    "de": [
      "Genießen Sie im Petit Béret: Weine, Tapas, Käse, Tagesgerichte und Feinschmeckerbretter in einem schicken Bistro mit Terrasse und entspannter Atmosphäre."
    ],
    "en": [
      "Le Petit Béret offers wines, tapas, cheeses, daily specials and gourmet platters in a chic bistro with terrace and relaxed atmosphere."
    ],
    "it": [
      "Assaporate i vini, le tapas, i formaggi, le specialità del giorno e i taglieri gourmet di Le Petit Béret, un bistrot chic con terrazza e un'atmosfera rilassata."
    ],
    "fr": [
      "Savourez au Petit Béret : vins, tapas, fromages, plats du jour et planches gourmandes dans un bistrot-chic avec terrasse et ambiance détendue."
    ],
    "es": [
      "Saboree los vinos, tapas, quesos, platos del día y bandejas gourmet de Le Petit Béret, un elegante bistró con terraza y ambiente relajado."
    ],
    "nl": [
      "Geniet van de wijnen, tapas, kazen, dagschotels en gastronomische schotels in Le Petit Béret, een chique bistro met een terras en een ontspannen sfeer."
    ]
  },
