      "dc:description": {
        "de": [
          "Strandbar, Food Court und festliche Atmosphäre am Strand mit Meerblick.\nEntdecken Sie diese neue Location auf dem Gelände des ehemaligen Hoverports in Le Portel"
        ],
        "en": [
          "Beach bar, food court and festive atmosphere on the beach with sea view.\nDiscover this new venue on the site of the former Hoverport in Le Portel"
        ],
        "it": [
          "Beach bar, food court e atmosfera festosa sulla spiaggia con vista sul mare.\nScoprite questo nuovo locale sul sito dell'ex Hoverport di Le Portel"
        ],
        "fr": [
          "Bar de plage, food court et ambiance festive en bord de plage avec vue mer.\nPartez à la découverte de ce nouveau lieu sur site de l'ancien Hoverport à Le Portel"
        ],
        "es": [
          "Chiringuito, patio de comidas y ambiente festivo en la playa con vistas al mar.\nDescubra este nuevo local en el emplazamiento del antiguo Hoverport de Le Portel"
        ],
        "nl": [
          "Beachbar, foodcourt en feestelijke sfeer op het strand met uitzicht op zee.\nOntdek deze nieuwe locatie op de plek van de voormalige Hoverport in Le Portel"
        ]
      },
