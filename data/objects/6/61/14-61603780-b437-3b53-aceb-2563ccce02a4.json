  "rdfs:comment": {
    "de": [
      "In diesem Jahr beherbergt das Gewerkschaftshaus der Bergarbeiter in Lens eine Ausstellung rund um Comics. Entdecken Sie unveröffentlichte Werke, die eine Hommage an das Bergbaurevier darstellen."
    ],
    "en": [
      "This year, the Maison syndicale des mineurs in Lens is hosting a comic strip exhibition. Discover never-before-seen works that pay tribute to the mining basin."
    ],
    "it": [
      "Quest'anno la Maison syndicale des mineurs di Lens ospita una mostra di fumetti. Scoprite opere inedite che rendono omaggio al bacino minerario."
    ],
    "fr": [
      "Cette année la Maison syndicale des mineurs de Lens accueille une exposition autour de la bande dessinée. Découvrez des oeuvres inédites qui rendent hommage au Bassin minier."
    ],
    "es": [
      "Este año, la Maison syndicale des mineurs de Lens acoge una exposición de cómics. Descubre obras inéditas que rinden homenaje a la cuenca minera."
