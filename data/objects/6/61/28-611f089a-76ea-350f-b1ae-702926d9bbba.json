  "rdfs:comment": {
    "de": [
      "Die 1932 wiederaufgebaute Saint-Géry-Kirche ist ein erstaunliches Bauwerk im Art-déco-Stil. Die heutige Kirche ersetzte ein älteres Gebäude, das nach den Bombenangriffen des Ersten Weltkriegs verschwunden war."
    ],
    "en": [
      "Rebuilt in 1932, Saint-Géry church is a stunning Art Deco structure. The current church replaced an older building that was destroyed by bombing during the Great War."
    ],
    "it": [
      "Ricostruita nel 1932, la chiesa di Saint-Géry è uno splendido edificio in stile Art Déco. La chiesa attuale ha sostituito un edificio più antico, distrutto dai bombardamenti della Grande Guerra."
    ],
    "fr": [
      "Reconstruite en 1932, l'église Saint-Géry est une étonnante construction de style Art déco. L'actuelle église vint remplacer un bâtiment plus ancien ayant disparu suite aux bombardements de la Grande Guerre."
    ],
    "es": [
      "Reconstruida en 1932, la iglesia de Saint-Géry es un impresionante edificio Art Déco. La iglesia actual sustituyó a un edificio más antiguo que fue destruido por los bombardeos durante la Gran Guerra."
    ],
    "nl": [
      "De Saint-Géry kerk werd herbouwd in 1932 en is een prachtig Art Deco gebouw. De huidige kerk verving een ouder gebouw dat tijdens de Grote Oorlog door bombardementen werd verwoest."
    ]
  },
