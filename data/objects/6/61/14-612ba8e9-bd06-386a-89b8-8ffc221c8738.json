  "rdfs:comment": {
    "de": [
      "Das Restaurant Le Départ, das sich gegenüber dem Bahnhof von Béthune befindet, ist eine echte lokale Institution.\nDieses Lokal bietet eine sowohl traditionelle als auch kreative Küche in einem gemütlichen und zeitgemäßen Rahmen."
    ],
    "en": [
      "Le Départ restaurant, located opposite Béthune railway station, is a veritable local institution.\nIt offers both traditional and creative cuisine in a warm, contemporary setting."
    ],
    "it": [
      "Il ristorante Le Départ, di fronte alla stazione di Béthune, è un'istituzione locale.\nOffre una cucina tradizionale e creativa in un ambiente caldo e contemporaneo."
    ],
    "fr": [
      "Le restaurant Le Départ, situé en face de la gare de Béthune, est une véritable institution locale. \nCet établissement propose une cuisine à la fois traditionnelle et créative dans un cadre chaleureux et contemporain."
    ],
    "nl": [
      "Restaurant Le Départ, tegenover het station van Béthune, is een plaatselijke instelling.\nHet biedt zowel traditionele als creatieve gerechten in een warme, eigentijdse omgeving."
    ],
    "es": [
      "El restaurante Le Départ, frente a la estación de Béthune, es toda una institución.\nOfrece cocina tradicional y creativa en un ambiente cálido y contemporáneo."
    ]
  },
