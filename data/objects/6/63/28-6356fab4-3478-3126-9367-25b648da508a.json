  "rdfs:comment": {
    "de": [
      "Das Kyriad Direct liegt vor den Toren von Soissons und bietet Ihnen 49 komplett renovierte und klimatisierte Zimmer. Von Montag bis Donnerstag abends von 19 bis 21 Uhr können Sie à la carte essen."
    ],
    "en": [
      "Located on the outskirts of Soissons, Kyriad Direct offers 49 fully-renovated, air-conditioned rooms and à la carte dining from Monday to Thursday evenings from 7pm to 9pm."
    ],
    "it": [
      "Situato alla periferia di Soissons, il Kyriad Direct offre 49 camere completamente rinnovate e dotate di aria condizionata e una ristorazione à la carte dal lunedì al giovedì sera dalle 19.00 alle 21.00."
    ],
    "fr": [
      "Situé aux portes de Soissons, l'établissement Kyriad Direct vous propose 49 chambres entièrement rénovées et climatisées,  restauration à la carte du lundi au jeudi soir inclus de 19 à 21h."
    ],
    "es": [
      "Situado a las afueras de Soissons, Kyriad Direct ofrece 49 habitaciones totalmente renovadas y climatizadas, así como cenas a la carta de lunes a jueves de 19:00 a 21:00 horas."
    ],
    "nl": [
      "Kyriad Direct ligt aan de rand van Soissons en biedt 49 volledig gerenoveerde kamers met airconditioning en à la carte dineren van maandag- tot donderdagavond van 19.00 tot 21.00 uur."
    ]
  },
