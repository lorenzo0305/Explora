  "rdfs:comment": {
    "de": [
      "20 Jahre später treten die ehemaligen Levi?s-Mitarbeiterinnen wieder auf, um auf der Bühne zu erzählen, wie ihr Alltag in der Fabrik aussah."
    ],
    "en": [
      "20 years on, the Levi?s alumni return to the stage to share their daily lives at the factory."
    ],
    "it": [
      "a distanza di 20 anni, gli ex allievi della Levi's sono tornati sul palco per raccontare la loro vita quotidiana in fabbrica."
    ],
    "fr": [
      "20 ans après, les anciennes de Levi’s reprennent du service pour partager sur scène ce qu’a été leur quotidien à l’usine."
    ],
    "nl": [
      "20 jaar later staan de Levi's alumni weer op het podium om te vertellen hoe hun dagelijks leven in de fabriek was."
    ],
    "es": [
      "20 años después, los antiguos alumnos de Levi's vuelven al escenario para compartir cómo era su vida cotidiana en la fábrica."
    ]
  },
