  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9d7c9f5a-caa7-30f7-ace7-65d5d9352747",
      "dc:description": {
        "de": [
          "Kreative Geschichten\nBarroux im Weltall!\nKomm und entdecke die Welt von Barroux, dem Gastautor und -illustrator des Monats. Es werden Geschichten vorgelesen, gefolgt von einem kleinen Bastelworkshop!\nMediathek des Sandettie\nmittwoch, 20. November, um 15 Uhr\nAb 8 Jahren\nKostenlos, nach Anmeldung"
        ],
        "en": [
          "Creative stories\nBarroux in space!\nCome and discover the world of Barroux, this month's guest author-illustrator, with story readings followed by a craft workshop!\nMédiathèque du Sandettie\nwednesday November 20, at 3pm\nAges 8 and up\nFree, registration required"
        ],
        "it": [
          "Storie creative\nBarroux nello spazio!\nVenite a scoprire il mondo di Barroux, l'autore-illustratore ospite di questo mese, con letture di storie seguite da un piccolo laboratorio artigianale!\nBiblioteca multimediale Sandettie\nmercoledì 20 novembre, ore 15.00\nDa 8 anni in su\nGratuito, su iscrizione"
        ],
        "fr": [
          "Histoires créatives\nBarroux dans l'espace !\nViens découvrir l'univers de Barroux, l'auteur-illustrateur invité du mois, lectures d'histoires suivies d'un petit atelier de bricolage !\nMédiathèque du Sandettie\nmercredi 20 novembre, à 15h\nA partir de 8 ans\nGratuit, sur inscription"
        ],
        "es": [
          "Historias creativas\nBarroux en el espacio\nVen a descubrir el mundo de Barroux, el autor-ilustrador invitado de este mes, con lecturas de cuentos seguidas de un pequeño taller de manualidades\nBiblioteca multimedia Sandettie\nmiércoles 20 de noviembre, 15.00 h\nA partir de 8 años\nGratuito, previa inscripción"
        ],
        "nl": [
          "Creatieve verhalen\nBarroux in de ruimte!\nKom en ontdek de wereld van Barroux, de gastauteur-illustrator van deze maand, met voorgelezen verhalen gevolgd door een kleine knutselworkshop!\nSandettie mediatheek\nwoensdag 20 november, 15.00 uur\nVanaf 8 jaar\nGratis, op inschrijving"
        ]
      },
