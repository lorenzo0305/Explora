  "rdfs:comment": {
    "de": [
      "Die Nationale Woche der frühen Kindheit (0-6 Jahre) bringt Familien, Kinder und Fachkräfte der frühen Kindheit zusammen, um alle für die Herausforderungen der Förderung und Entwicklung von Kleinkindern zu sensibilisieren."
    ],
    "en": [
      "The Semaine Nationale de la Petite Enfance (0-6 years) brings together families, children and early childhood professionals to raise awareness of the challenges of early learning and development."
    ],
    "it": [
      "La Semaine Nationale de la Petite Enfance (0-6 anni) riunisce famiglie, bambini e professionisti della prima infanzia per sensibilizzare sulle sfide dell'apprendimento e dello sviluppo precoci."
    ],
    "fr": [
      "La Semaine Nationale de la Petite Enfance (0-6 ans) réunit familles, enfants et professionnels de la petite enfance pour sensibiliser chacune et chacun aux enjeux de l’éveil et du développement des tout-petits."
    ],
    "es": [
      "La Semaine Nationale de la Petite Enfance (0-6 años) reúne a familias, niños y profesionales de la primera infancia para sensibilizar sobre los retos del aprendizaje y el desarrollo tempranos."
    ],
    "nl": [
      "De Semaine Nationale de la Petite Enfance (0-6 jaar) brengt gezinnen, kinderen en professionals uit de vroege kinderjaren samen om het bewustzijn over de uitdagingen van vroeg leren en ontwikkeling te vergroten."
    ]
  },
  "rdfs:label": {
