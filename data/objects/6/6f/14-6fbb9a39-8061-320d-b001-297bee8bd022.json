  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/25000d31-abd2-3d0e-86cc-8dffcf11da81",
      "dc:description": {
        "de": [
          "Kollektiver Kinderspielplatz am Hafen des Departements.\nDie Gelegenheit für Kinder, sich auszutoben, gemeinsam zu spielen und die frische Luft in vollen Zügen zu genießen."
        ],
        "en": [
          "Collective children's play area located on the departmental port.\nAn opportunity for children to let off steam, play together and enjoy the great outdoors."
        ],
        "it": [
          "Area giochi collettiva per bambini situata sul porto dipartimentale.\nUn'opportunità per i bambini di sfogarsi, giocare insieme e godersi l'aria fresca."
        ],
        "fr": [
          "Aire collective de jeux pour enfants située sur le port départemental.\nL'occasion pour les enfants de se défouler, de jouer ensemble et de profiter pleinement du grand air."
        ],
        "es": [
          "Zona de juegos colectivos para niños situada en el puerto departamental.\nUna oportunidad para que los niños se desahoguen, jueguen juntos y disfruten del aire fresco."
        ],
        "nl": [
          "Collectieve speelruimte voor kinderen op de afdelingshaven.\nEen gelegenheid voor kinderen om zich uit te leven, samen te spelen en te genieten van de frisse lucht."
        ]
      },
