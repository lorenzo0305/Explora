  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/53e8ce45-f2e0-3b02-876d-c4981e7bf76e",
      "dc:description": {
        "de": [
          "Kreative Geschichten\nEs lebe der Karneval!\nLass deine Fantasie spielen, um hübsche, nützliche oder lustige Kreationen herzustellen!\n\nbunte Karnevalsmaske mit Federn\n\nMediathek des Sandettie\n\nAb 4 Jahren\nKostenlos, nach Anmeldung"
        ],
        "en": [
          "Creative stories\nLong live Carnival\nUse your imagination to make pretty, useful or funny creations!\n\ncolorful carnival mask with feathers\n\nSandettie Media Library\n\nAges 4 and up\nFree, registration required"
        ],
        "it": [
          "Storie creative\nViva il Carnevale\nUsa la tua immaginazione per realizzare creazioni carine, utili o divertenti!\n\nmaschera di carnevale colorata con piume\n\nBiblioteca multimediale Sandettie\n\nDa 4 anni\nGratuito, previa registrazione"
        ],
        "fr": [
          "Histoires créatives\nVive le Carnaval\nFais marcher ton imagination pour fabriquer des jolies, des utiles ou des drôles de créations !\n\nmasque de carnaval coloré avec plumes\n\nMédiathèque du Sandettie\n\nA partir de 4 ans\nGratuit, sur inscription"
        ],
        "es": [
          "Historias creativas\nViva el Carnaval\n¡Usa tu imaginación para hacer creaciones bonitas, útiles o divertidas!\n\ncolorida máscara de carnaval con plumas\n\nBiblioteca multimedia Sandettie\n\nA partir de 4 años\nGratis, previa inscripción"
        ],
        "nl": [
          "Creatieve verhalen\nLang leve carnaval\nGebruik je fantasie om mooie, nuttige of grappige creaties te maken!\n\nkleurrijk carnavalsmasker met veren\n\nSandettie multimedia bibliotheek\n\nVanaf 4 jaar\nGratis, na registratie"
        ]
      },
