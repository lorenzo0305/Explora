  "rdfs:comment": {
    "de": [
      "Chemins d'Histoire mit Sitz in Saint-Quentin an der Hindenburglinie nimmt Sie mit auf eine Entdeckungsreise zu den mythischen Orten des Ersten Weltkriegs.\nUnter der Führung eines leidenschaftlichen Historikers werden Sie bekannte und weniger bekannte Orte voller Emotionen entdecken.\nWir können individuelle Touren zusammenstellen, auf den Spuren einer Einheit, eines Soldaten, einer Nationalität, an einem bestimmten Ort etc."
    ],
    "en": [
      "Based in Saint-Quentin on the Hindenburg Line, Chemins d'Histoire takes you on a journey of discovery of the mythical places of the 1st World War.\nGuided by an enthusiast, you will discover known or less known places full of emotions.\nWe can put together personalised tours, in the footsteps of a unit, a soldier, a nationality, on a particular site etc."
    ],
    "it": [
      "Con sede a Saint-Quentin, sulla linea Hindenburg, Chemins d'Histoire vi porta alla scoperta dei luoghi mitici della Prima Guerra Mondiale.\nGuidati da un appassionato, scoprirete luoghi noti o meno noti ricchi di emozioni.\nPossiamo organizzare tour personalizzati, seguendo le tracce di un'unità, di un soldato, di una nazionalità, di un sito particolare, ecc."
    ],
    "fr": [
      "Basé à Saint-Quentin sur la ligne Hindenburg, Chemins d'Histoire vous emmène à la découverte des lieux mythiques de la 1ere Guerre Mondiale.\nGuidés par un passionné, vous découvrirez des lieux connus ou moins connus chargés d'émotions.\nNous pouvons composer des circuits personnalisés, sur les traces d'une unité, d'un soldat, une nationalité, sur un site en particulier etc."
    ],
    "es": [
      "Con sede en Saint-Quentin, en la Línea Hindenburg, Chemins d'Histoire le lleva a descubrir los lugares míticos de la Primera Guerra Mundial.\nGuiado por un entusiasta, descubrirá lugares conocidos o menos conocidos llenos de emociones.\nPodemos organizar recorridos personalizados, siguiendo los pasos de una unidad, un soldado, una nacionalidad, un lugar concreto, etc."
    ],
    "nl": [
      "Chemins d'Histoire, gevestigd in Saint-Quentin aan de Hindenburglijn, neemt u mee op ontdekking naar de mythische plaatsen van de Eerste Wereldoorlog.\nOnder leiding van een enthousiasteling ontdekt u bekende of minder bekende plaatsen vol emoties.\nWij kunnen gepersonaliseerde tochten samenstellen, in de voetsporen van een eenheid, een soldaat, een nationaliteit, een bepaalde site, enz."
    ]
  },
