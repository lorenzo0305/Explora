  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9920b1e5-712f-36e9-bcfb-838593cd972c",
      "dc:description": {
        "de": [
          "Chemins d'Histoire mit Sitz in Saint-Quentin an der Hindenburglinie nimmt Sie mit auf eine Entdeckungsreise zu den mythischen Orten des Ersten Weltkriegs. Unter der Führung eines leidenschaftlichen Historikers werden Sie bekannte und weniger bekannte Orte voller Emotionen entdecken. Wir können individuelle Touren zusammenstellen, auf den Spuren einer Einheit, eines Soldaten, einer Nationalität, an einem bestimmten Ort etc."
        ],
        "en": [
          "Based in Saint-Quentin on the Hindenburg Line, Chemins d'Histoire takes you on a discovery tour of the mythical sites of the First World War. Guided by an enthusiastic guide, you'll discover well-known and lesser-known places full of emotion. We can put together personalized tours, following in the footsteps of a particular unit, soldier, nationality or site."
        ],
        "it": [
          "Con sede a Saint-Quentin, sulla linea dell'Hindenburg, Chemins d'Histoire vi porta a visitare i luoghi leggendari della Prima Guerra Mondiale. Guidati da un appassionato, scoprirete luoghi noti e meno noti, ricchi di emozioni. Possiamo organizzare tour personalizzati, seguendo le tracce di un'unità, di un soldato, di una nazionalità, di un sito particolare, ecc."
        ],
        "fr": [
          "Basé à Saint-Quentin sur la ligne Hindenburg, Chemins d'Histoire vous emmène à la découverte des lieux mythiques de la 1ere Guerre Mondiale. Guidés par un passionné, vous découvrirez des lieux connus ou moins connus chargés d'émotions. Nous pouvons composer des circuits personnalisés, sur les traces d'une unité, d'un soldat, une nationalité, sur un site en particulier etc."
        ],
        "es": [
          "Con base en Saint-Quentin, en la Línea Hindenburg, Chemins d'Histoire le lleva a recorrer los lugares legendarios de la Primera Guerra Mundial. Guiado por un apasionado, descubrirá lugares conocidos y menos conocidos, llenos de emoción. Podemos organizar visitas personalizadas, siguiendo los pasos de una unidad, un soldado, una nacionalidad, un lugar concreto, etc."
        ],
        "nl": [
          "Chemins d'Histoire, gevestigd in Saint-Quentin aan de Hindenburglijn, neemt je mee op een tocht langs de legendarische plekken van de Eerste Wereldoorlog. Onder leiding van een enthousiasteling ontdek je bekende en minder bekende plaatsen die vol emotie zitten. We kunnen gepersonaliseerde rondleidingen samenstellen, in de voetsporen van een eenheid, een soldaat, een nationaliteit, een bepaalde site, enz."
        ]
      },
