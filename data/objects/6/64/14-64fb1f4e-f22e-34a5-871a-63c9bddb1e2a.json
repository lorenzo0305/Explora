  "rdfs:comment": {
    "de": [
      "Droit de cité und die Gemeinden Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle und Vimy bieten Ihnen vom 28. November bis zum 04. Dezember 2025 fünf kostenlose Konzerte im Rahmen des von Lens Tourisme organisierten Festivals der Heiligen Barbara an.  \nFolk, Rock, Cold Wave und Elektro werden in den historischen Stätten der Region zu hören sein."
    ],
    "en": [
      "Droit de cité and the municipalities of Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle and Vimy are offering five free concerts from November 28 to December 04, 2025, as part of the Festival de la Sainte Barbe organized by Lens Tourisme.  \nFolk, rock, cold wave and electro will be on offer in the heart of the region's heritage sites."
    ],
    "it": [
      "Dal 28 novembre al 4 dicembre 2025, Droit de cité e i comuni di Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle e Vimy propongono cinque concerti gratuiti nell'ambito del Festival Sainte Barbe organizzato da Lens Tourisme.  \nFolk, rock, cold wave ed electro saranno proposti nel cuore dei siti storici della regione."
    ],
    "fr": [
      "Droit de cité et les communes d’Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle et Vimy vous proposent du 28 novembre au 04 décembre 2025, cinq concerts gratuits dans le cadre du Festival de la Sainte Barbe organisé par Lens Tourisme.  \nFolk, rock, cold wave et électro seront au rendez-vous au cœur des lieux patrimoniaux du territoire."
    ],
    "nl": [
      "Van 28 november tot 04 december 2025 bieden Droit de cité en de gemeenten Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle en Vimy vijf gratis concerten in het kader van het Festival Sainte Barbe georganiseerd door Lens Tourisme.  \nFolk, rock, cold wave en electro worden aangeboden in het hart van het erfgoed van de regio."
    ],
    "es": [
      "Del 28 de noviembre al 4 de diciembre de 2025, Droit de cité y los municipios de Ablain-Saint-Nazaire, Aix-Noulette, Bouvigny-Boyeffles, Sains-en-Gohelle y Vimy ofrecen cinco conciertos gratuitos en el marco del Festival Sainte Barbe, organizado por Lens Tourisme.  \nFolk, rock, cold wave y electro en el corazón del patrimonio de la región."
    ]
  },
