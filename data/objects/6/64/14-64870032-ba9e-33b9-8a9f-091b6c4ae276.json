      "@id": "https://data.datatourisme.fr/42ea5e60-c845-3dad-87fa-9f5a002dcc84",
      "dc:description": {
        "de": [
          "Fun House Karnevalsparty ?7\n\nVerkleidet, von 14:30 bis 17:30 Uhr im Fun House\n\nBuntes Buffet, Animationen, Musik, Wahl der schönsten Kostüme und Überraschungen.\n\n18. Februar und 25. Februar 2026\n04. März\n\nFür 3- bis 15-Jährige, 15 Euro pro Kind\n\nInfos und Buchungen unter\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ],
        "en": [
          "Fun House Carnaval Party ?7\n\nIn disguise, from 2:30 to 5:30 p.m. at the Fun House\n\nColorful buffet, entertainment, music, election of the best costumes and surprises.\n\nfebruary 18 and February 25, 2026\nmarch 04\n\nFor 3-15 year olds, 15 euros per child\n\nInfos and reservations on\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ],
        "it": [
          "Festa di Carnevale Fun House ?7\n\nIn maschera, dalle 14.30 alle 17.30 presso la Fun House\n\nBuffet colorato, animazione, musica, elezione dei migliori costumi e sorprese.\n\n18 febbraio e 25 febbraio 2026\n04 marzo\n\nPer i bambini dai 3 ai 15 anni, 15 euro a bambino\n\nInformazioni e prenotazioni su\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ],
        "fr": [
          "Fun House Carnaval Party ♯7\n\nDéguisé, de 14h30 à 17h30 à la Fun House\n\nBuffet coloré, animations, musique, élection des plus beaux costumes et surprises.\n\n18 Février et  25 Février 2026\n04 Mars \n\nPour les 3-15 ans, 15 euros par enfant\n\nInfos et réservations sur\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ],
        "nl": [
          "Fun House Carnaval Feest ?7\n\nVerkleed, van 14.30 tot 17.30 uur in het Fun House\n\nKleurrijk buffet, entertainment, muziek, verkiezing van de beste kostuums en verrassingen.\n\n18 februari en 25 februari 2026\n04 maart\n\nVoor 3-15 jaar, 15 euro per kind\n\nInformatie en boekingen op\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ],
        "es": [
          "Fiesta de Carnaval Fun House 7\n\nDisfrazados, de 14:30 a 17:30 en el Fun House\n\nBuffet colorido, animación, música, elección de los mejores disfraces y sorpresas.\n\n18 de febrero y 25 de febrero de 2026\n04 de marzo\n\nPara niños de 3 a 15 años, 15 euros por niño\n\nInformación y reservas en\nwww.fun-house-hardelot.fr\n03 91 21 51 13"
        ]
      },
