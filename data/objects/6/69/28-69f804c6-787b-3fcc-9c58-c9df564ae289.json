  "rdfs:comment": {
    "de": [
      "Das jährliche Mittelalterfest des Château Fort de Guise, die Ducales de Guise, findet vom 19. bis 21. Juni dieses Jahres statt. Es bietet die Möglichkeit, das Château Fort de Guise einen Tag lang so zu erleben, wie es im Mittelalter ausgesehen haben könnte!"
    ],
    "en": [
      "The annual medieval festival of the Château Fort de Guise, the Ducales de Guise, will take place from June 19 to 21. For one day, you can discover the Château Fort de Guise as it was in the Middle Ages!"
    ],
    "it": [
      "L'annuale festa medievale del Château Fort de Guise, i Ducales de Guise, si svolgerà dal 19 al 21 giugno. Per un giorno, potrete scoprire il Château Fort de Guise come era nel Medioevo!"
    ],
    "fr": [
      "La fête médiévale annuelle du Château Fort de Guise, les Ducales de Guise, aura lieu du 19 au 21 juin prochain. Elle permet de découvrir, le temps d’une journée, le Château Fort de Guise comme il pouvait l’être au Moyen-Age !"
    ],
    "es": [
      "La fiesta medieval anual del Château Fort de Guise, las Ducales de Guise, tendrá lugar del 19 al 21 de junio. Durante un día, podrá descubrir el Château Fort de Guise tal y como era en la Edad Media"
    ],
    "nl": [
      "Het jaarlijkse middeleeuwse festival van het Château Fort de Guise, de Ducales de Guise, vindt plaats van 19 tot 21 juni. Voor één dag kun je het Château Fort de Guise ontdekken zoals het was in de Middeleeuwen!"
    ]
  },
