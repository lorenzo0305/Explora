      "dc:description": {
        "de": [
          "Informationen :\n\nSpeisekarte:\nBesuchen Sie die Facebook-Seite, um die Karte zu sehen\n\nÖffnungszeiten: Nur für Abhebungen zum Mitnehmen\nVon Sonntag bis Freitag: 17:00 - 01:00 Uhr\nSamstag: 16:00 - 01:00 Uhr\n \n \n\n "
        ],
        "en": [
          "Information :\n\nMenu:\nSee the Facebook page for the map\n\nOpening days: takeaway only\nSunday to Friday: 17:00 - 01:00\nSaturday: 16:00 - 01:00\n \n \n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu:\nConsulta la pagina Facebook per la mappa\n\nGiorni di apertura: solo da asporto\nDa domenica a venerdì: 17:00 - 01:00\nSabato: 16:00 - 01:00\n \n \n\n "
        ],
        "fr": [
          "Informations :\n\nMenu: \nConsultez la page Facebook afin de connaître la carte\n\nJours d'ouverture : uniquement pour les retraits à emporter\nDu dimanche au vendredi : 17:00 - 01:00\nLe samedi: 16:00 - 01:00\n \n \n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu:\nKijk op de Facebookpagina voor de kaart\n\nOpeningsdagen: alleen afhaalmaaltijden\nZondag t/m vrijdag: 17:00 - 01:00\nZaterdag: 16:00 - 01:00\n \n \n\n "
        ],
        "es": [
          "Más información :\n\nMenú:\nConsulta el mapa en la página de Facebook\n\nDías de apertura: sólo para llevar\nDomingo a viernes: 17:00 - 01:00\nSábado: 16:00 - 01:00\n \n \n\n "
        ]
      },
