  "rdfs:comment": {
    "de": [
      "Gemütliche Zimmer in einer warmen und ländlichen Atmosphäre. Hier fühlt man sich wohl... Der Yachthafen lädt zu einem Spaziergang entlang der Kais und der Duchesse Anne ein. Das Stadtzentrum mit seinen Geschäften ist nur 2 Minuten entfernt."
    ],
    "en": [
      "Cosy rooms in a warm and country atmosphere. We feel good... The marina invites you to stroll along the docks and the Duchess Anne. The city center with the stores is 2 minutes away."
    ],
    "it": [
      "Camere accoglienti in un'atmosfera calda e rustica. Vi sentirete bene... Il porto turistico invita a passeggiare lungo le banchine e la Duchesse Anne. Il centro città con i suoi negozi è a 2 minuti di distanza."
    ],
    "fr": [
      "Chambres cosy dans une ambiance chaleureuse et champêtre. On se sent bien... Le port de plaisance invite à la balade le long des quais et de la Duchesse Anne. Le centre ville avec les boutiques est à 2 minutes."
    ],
    "es": [
      "Habitaciones acogedoras en un ambiente cálido y campestre. Te sientes bien... El puerto deportivo le invita a pasear por los muelles y la Duchesse Anne. El centro de la ciudad con sus tiendas está a 2 minutos."
    ],
    "nl": [
      "Gezellige kamers in een warme en landelijke sfeer. U voelt zich goed... De jachthaven nodigt uit tot een wandeling langs de kades en de Duchesse Anne. Het stadscentrum met zijn winkels ligt op 2 minuten afstand."
    ]
  },
