  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d65dc5c9-ee99-30c3-94ee-5b56dba80c1e",
      "dc:description": {
        "de": [
          "Das Selbstbedienungsunternehmen Cycles & Multi-Services ist eine mobile Werkstatt für die Reparatur und Pannenhilfe von Fahrrädern mit Muskelkraft und/oder elektrischer Unterstützung. Es bietet seine Dienste in der Region Noyonnais an, sowohl für Geschäftskunden (Hotel, Campingplatz, ...) als auch für Privatpersonen, die in der Nähe wohnen oder als Touristen vorbeikommen."
        ],
        "en": [
          "Cycles & Multi-Services is a mobile workshop for repairing muscular and/or electrically-assisted bicycles. It offers its services in the Noyonnais area, for business customers (hotels, camping sites, etc.) and private individuals living nearby or visiting tourists."
        ],
        "it": [
          "Cycles & Multi-Services è un'officina mobile per la riparazione e il ripristino di biciclette muscolari e/o a pedalata assistita. Offre i suoi servizi nell'area di Noyonnais, per clienti commerciali (hotel, campeggi, ecc.) e privati che vivono nelle vicinanze o sono in vacanza."
        ],
        "fr": [
          "L'auto-entreprise Cycles & Multi-Services est un atelier mobile de réparation et dépannage de cycle musculaire et/ou à assistance électrique. Il propose ses services sur le secteur du Noyonnais, pour la clientèle professionnelle (hôtel, camping, ...) et les particuliers résidant à proximité ou de passage touristique."
        ],
        "nl": [
          "Cycles & Multi-Services is een mobiele werkplaats voor het repareren en herstellen van spier- en/of elektrische fietsen. Het bedrijf biedt zijn diensten aan in de omgeving van Noyonnais, aan zakelijke klanten (hotels, campings, enz.) en particulieren die in de buurt wonen of op vakantie zijn."
        ],
        "es": [
          "Cycles & Multi-Services es un taller móvil de reparación y reparación de bicicletas musculares y/o bicicletas con asistencia eléctrica. Ofrece sus servicios en la zona de Noyonnais, para clientes empresariales (hoteles, campings, etc.) y particulares que viven cerca o están de vacaciones."
        ]
      },
