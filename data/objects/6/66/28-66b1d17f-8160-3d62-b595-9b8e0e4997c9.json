  "rdfs:comment": {
    "de": [
      "Die neue Ausgabe dieser Sportveranstaltung, die eine Mischung aus Trail (12 bis 28 km), einem Jugendlauf, Wandern usw. bietet, ist ein voller Erfolg\n\nTreffpunkt: Platz des Mangin-Viertels ab 8 Uhr!"
    ],
    "en": [
      "The new edition of this sporting event, which combines trail running (from 12 to 28 km), a youth race, walking, etc?\n\nRV Place du quartier Mangin from 8 am!"
    ],
    "it": [
      "La nuova edizione di questo evento sportivo, che combina trail running (da 12 a 28 km), gara giovanile, camminata, ecc?\n\nRV Place du quartier Mangin dalle 8 del mattino!"
    ],
    "fr": [
      "La nouvelle édition de cette manifestation sportive qui mixe trail (de 12 à 28 km), une course jeunes, de la marche, etc…\n\nRV Place du quartier Mangin dès 8h !"
    ],
    "es": [
      "La nueva edición de este evento deportivo, que combina trail running (de 12 a 28 km), una carrera juvenil, marcha a pie, etc?\n\n¡RV Place du quartier Mangin a partir de las 8h!"
    ],
    "nl": [
      "De nieuwe editie van dit sportevenement, dat trailrunning (van 12 tot 28 km), een jeugdwedstrijd, wandelen, enz. combineert?\n\nRV Place du quartier Mangin vanaf 8 uur!"
    ]
  },
