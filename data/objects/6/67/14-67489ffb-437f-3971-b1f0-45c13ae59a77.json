  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/79e034dd-7c0c-3925-982a-8f1ec4298f9a",
      "dc:description": {
        "de": [
          "Willkommen im Marina, einem Restaurant, in dem die Frische des Meeres auf Ihrem Teller landet. Das Lokal liegt ideal in Camiers und bietet Ihnen ein authentisches kulinarisches Erlebnis, bei dem die jodhaltigen Aromen und die lokalen Produkte unserer Küste im Vordergrund stehen."
        ],
        "en": [
          "Welcome to the Marina, a restaurant where the freshness of the sea comes to your plate. Ideally located in Camiers, this establishment offers you an authentic culinary experience, featuring the iodized flavors and local products of our coastline."
        ],
        "it": [
          "Benvenuti al Marina, un ristorante dove la freschezza del mare viene portata nel piatto. Situato in posizione ideale a Camiers, questo locale vi offre un'esperienza culinaria autentica, che celebra i sapori iodati e i prodotti locali della nostra costa."
        ],
        "fr": [
          "Bienvenue au Marina, un restaurant où la fraîcheur de la mer s'invite dans votre assiette. Situé idéalement à Camiers, cet établissement vous offre une expérience culinaire authentique, mettant à l'honneur les saveurs iodées et les produits locaux de notre littoral."
        ],
        "nl": [
          "Welkom in de Marina, een restaurant waar de versheid van de zee op je bord wordt gebracht. Dit etablissement, ideaal gelegen in Camiers, biedt je een authentieke culinaire ervaring en viert de jodiumhoudende smaken en lokale producten van onze kustlijn."
        ],
        "es": [
          "Bienvenido al Marina, un restaurante donde la frescura del mar llega a su plato. Idealmente situado en Camiers, este establecimiento le ofrece una auténtica experiencia culinaria, celebrando los sabores yodados y los productos locales de nuestro litoral."
        ]
      },
      "@type": [
        "Description"
      ],
