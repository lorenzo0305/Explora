  "rdfs:comment": {
    "de": [
      "Die Stadt Montigny-en-Gohelle lädt Sie in Partnerschaft mit dem Cirque du Bout du Monde zu einem festlichen und magischen Abend in einer warmen Retro-Atmosphäre ein."
    ],
    "en": [
      "The town of Montigny-en-Gohelle, in partnership with Cirque du Bout du Monde, invites you to a festive, magical evening in a warm, retro atmosphere."
    ],
    "it": [
      "La città di Montigny-en-Gohelle, in collaborazione con il Cirque du Bout du Monde, vi invita a una serata festosa e magica in un'atmosfera calda e retrò."
    ],
    "fr": [
      "La Ville de Montigny-en-Gohelle, en partenariat avec le Cirque du Bout du Monde, vous invite à une soirée festive et magique dans une ambiance rétro et chaleureuse."
    ],
    "es": [
      "La ciudad de Montigny-en-Gohelle, en colaboración con el Cirque du Bout du Monde, le invita a una velada festiva y mágica en un ambiente cálido y retro."
    ],
    "nl": [
      "De stad Montigny-en-Gohelle nodigt je in samenwerking met Cirque du Bout du Monde uit voor een feestelijke en magische avond in een warme, retro sfeer."
    ]
