  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9e8a93e2-aa71-39e8-897d-2cb5cabc6b4a",
      "dc:description": {
        "de": [
          "???? ??? :\n? Nächtlicher Kunsthandwerkermarkt\n? Kostenloser Schminkstand für Groß und Klein\n?? ??? :\nKonzert \"Cocktail Music\", Akkordeonspieler und seine Sängerin\n?? ??? :\nKonzert \"Swing Quartet\" von der Compagnie In Illo Tempore\nEine musikalische Reise zwischen Swing, Guinguette und Retro-Akzenten, um unter den Sternen zu tanzen und zu singen!\n?? ??? :\nShow \"Swing & Fire\" von der \"Compagnie du Cirque du Bout du Monde\"\nEine atemberaubende Show, die Straßentheater, Live-Musik, Tanz und Feuerkünste in einem imaginären Guinguette der Zwischenkriegszeit vereint."
        ],
        "en": [
          "???? ??? :\n? Artisan night market\n? Free face painting for young and old\n?? ??? :\nCocktail Music\" concert, accordionist and singer\n?? ??? :\nQuartet de Swing\" concert by Compagnie In Illo Tempore\nA musical journey through swing, guinguette and retro accents, for dancing and singing under the stars!\n?? ??? :\nSwing & Fire\" show by Compagnie du Cirque du Bout du Monde\nA breathtaking show combining street theater, live music, dance and fire arts, set in an imaginary guinguette between the two world wars."
        ],
        "it": [
          "???? ??? :\n? Mercato notturno artigianale\n? Pittura del viso gratuita per tutte le età\n?? ??? :\nConcerto \"Cocktail Music\", fisarmonicista e cantante\n?? ??? :\nConcerto \"Quartet de Swing\" della Compagnie In Illo Tempore\nUn viaggio musicale tra swing, guinguette e accenti retrò, per ballare e cantare sotto le stelle!\n?? ??? :\nSwing & Fire\" della Compagnie du Cirque du Bout du Monde\nUno spettacolo mozzafiato che unisce teatro di strada, musica dal vivo, danza e arti del fuoco, ambientato in un'immaginaria guinguette tra le due guerre."
        ],
        "fr": [
          "𝗗𝗲̀𝘀 𝟭𝟴𝗵 :\n• Marché nocturne artisanal\n• Stand de maquillage gratuit pour petits et grands\n𝗔̀ 𝟭𝟴𝗵 : \nConcert \"Cocktail Music\", accordéoniste et sa chanteuse\n𝗔̀ 𝟮𝟬𝗵 :\nConcert « Quartet de Swing » par la Compagnie In Illo Tempore\nUn voyage musical entre swing, guinguette et accents rétro, pour danser et chanter sous les étoiles !\n𝗔̀ 𝟮𝟮𝗵 :\nSpectacle « Swing & Fire » par la Compagnie du Cirque du Bout du Monde\nUn show époustouflant mêlant théâtre de rue, musique live, danse et arts du feu, dans une guinguette imaginaire de l’entre-deux-guerres."
        ],
        "es": [
          "???? ??? :\n? Mercado nocturno artesanal\n? Pintura de caras gratis para todas las edades\n?? ??? :\nConcierto \"Cocktail Music\", acordeonista y cantante\n?? ??? :\nConcierto \"Quartet de Swing\" de la Compagnie In Illo Tempore\nUn viaje musical a través del swing, la guinguette y los acentos retro, ¡para bailar y cantar bajo las estrellas!\n?? ??? :\nSwing & Fire\" de la Compagnie du Cirque du Bout du Monde\nUn espectáculo sobrecogedor que combina teatro de calle, música en directo, danza y las artes del fuego, ambientado en una guinguette imaginaria de entreguerras."
        ],
        "nl": [
          "???? ??? :\n? Ambachtelijke nachtmarkt\n? Gratis schminken voor alle leeftijden\n?? ??? :\nCocktail Music\" concert, accordeonist en zangeres\n?? ??? :\nConcert \"Quartet de Swing\" door Compagnie In Illo Tempore\nEen muzikale reis door swing, guinguette en retro-accenten, om te dansen en te zingen onder de sterren!\n?? ??? :\nSwing & Vuur\" door de Compagnie du Cirque du Bout du Monde\nEen adembenemende show die straattheater, livemuziek, dans en vuurkunst combineert en zich afspeelt in een denkbeeldige guinguette tussen de oorlogen."
        ]
      },
