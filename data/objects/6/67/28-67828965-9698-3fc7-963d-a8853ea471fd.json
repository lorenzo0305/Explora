  "rdfs:comment": {
    "de": [
      "Unser Restaurant-Grill mit traditioneller Küche befindet sich in Portes de l'Avesnois in der Region Hauts-de-France. In einem gemütlichen Interieur entdecken Sie eine Küche, die aus frischen und saisonalen Produkten zubereitet wird. Alle unsere Gerichte sind hausgemacht und mit Leidenschaft zubereitet!"
    ],
    "en": [
      "Located in the Portes de l'Avesnois, in the Hauts-de-France, our establishment is a Restaurant-Grill of traditional cooking. In a warm interior, discover a cuisine elaborated from fresh and seasonal products. All our dishes are home-made and with passion!"
    ],
    "it": [
      "Situato nelle Portes de l'Avesnois, nella regione Hauts-de-France, il nostro è un ristorante-griglieria con cucina tradizionale. In un ambiente accogliente, scoprite una cucina elaborata con prodotti freschi e di stagione. Tutti i nostri piatti sono fatti in casa e realizzati con passione!"
    ],
    "fr": [
      "Situé aux Portes de l’Avesnois, dans les Hauts-de-France, notre établissement est un Restaurant-Grill de cuisine traditionnelle. Dans un intérieur chaleureux, découvrez une cuisine élaborée à partir de produits frais et de saison. Tous nos plats sont faits maison et avec passion !"
    ],
    "es": [
      "Situado en las Portes de l'Avesnois, en la región de Hauts-de-France, nuestro establecimiento es un Restaurante Asador de cocina tradicional. En un interior cálido, descubra una cocina elaborada a partir de productos frescos y de temporada. ¡Todos nuestros platos son caseros y elaborados con pasión!"
    ],
    "nl": [
      "Gelegen in de Portes de l'Avesnois, in de Hauts-de-France, is ons etablissement een Restaurant-Grill met een traditionele keuken. Ontdek in een warm interieur een keuken op basis van verse en seizoensgebonden producten. Al onze gerechten zijn huisgemaakt en met passie bereid!"
    ]
  },
  "rdfs:label": {
