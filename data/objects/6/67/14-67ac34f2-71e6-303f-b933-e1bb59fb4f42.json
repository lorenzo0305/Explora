  "rdfs:comment": {
    "de": [
      "La Halte d'Autrefois liegt im grünen Tal von Créquoise und lädt Sie zu einer authentischen und erholsamen Erfahrung zwischen Natur, bäuerlichen Traditionen und ungewöhnlichen Unterkünften ein."
    ],
    "en": [
      "Nestled in the verdant Créquoise valley, La Halte d?Autrefois invites you to enjoy an authentic, rejuvenating experience, combining nature, rural traditions and unusual accommodation."
    ],
    "it": [
      "Immersa nella verdeggiante valle del Créquoise, La Halte d'Autrefois vi invita a vivere un'esperienza autentica e rigenerante, combinando natura, tradizioni rurali e alloggi insoliti."
    ],
    "fr": [
      "Nichée dans la vallée verdoyante de la Créquoise, La Halte d’Autrefois vous invite à vivre une expérience authentique et ressourçante, entre nature, traditions paysannes et hébergements insolites."
    ],
    "nl": [
      "La Halte d'Autrefois, genesteld in de groene Créquoise vallei, nodigt je uit om te genieten van een authentieke en verjongende ervaring, een combinatie van natuur, landelijke tradities en ongewone accommodatie."
    ],
    "es": [
      "Enclavada en el verde valle de Créquoise, La Halte d'Autrefois le invita a disfrutar de una experiencia auténtica y rejuvenecedora, combinando naturaleza, tradiciones rurales y un alojamiento insólito."
    ]
  },
