  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7ae737e1-0d91-3959-9b30-dd8ab39f5e1e",
      "dc:description": {
        "de": [
          "Lucie und Laurent bewirtschaften 36 ha und haben zwei Ställe mit Legehennen aus biologischem Anbau. Sie vermarkten ihre Kartoffel-, Karotten- und Eierproduktion auf Märkten oder auf Bestellung."
        ],
        "en": [
          "Lucie and Laurent cultivate 36 ha and they have two hen houses for laying hens in Organic Agriculture. They market their potato, carrot and egg production on the markets or to order."
        ],
        "it": [
          "Lucie e Laurent coltivano 36 ettari e hanno due pollai biologici. Vendono le loro patate, carote e uova sui mercati o su ordinazione."
        ],
        "fr": [
          "Lucie et Laurent cultivent 36 ha et ils ont deux poulaillers de poules pondeuses en Agriculture Biologique. Ils commercialisent leurs productions de pommes de terres, de carottes et d’œufs sur les marchés ou sur commande."
        ],
        "es": [
          "Lucie y Laurent cultivan 36 ha y tienen dos gallineros ecológicos. Venden sus patatas, zanahorias y huevos en los mercados o por encargo."
        ],
        "nl": [
          "Lucie en Laurent bewerken 36 ha en hebben twee biologische kippenhokken. Ze verkopen hun aardappelen, wortelen en eieren op markten of op bestelling."
        ]
      },
