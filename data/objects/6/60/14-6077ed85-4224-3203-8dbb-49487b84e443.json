  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d3ee509c-ef81-30f8-bee7-e0e13adbeddf",
      "dc:description": {
        "de": [
          "Teilen Sie Ihre Leidenschaft mit anderen Liebhabern des Reittourismus und entdecken Sie unsere schöne Region (neu). Herzliche Atmosphäre garantiert!\n\nGerittene und gefahrene Strecken"
        ],
        "en": [
          "Come and share your passion with other equestrian tourism enthusiasts and (re)discover our beautiful region. Warm atmosphere guaranteed!\n\nMounted and harnessed routes"
        ],
        "it": [
          "Venite a condividere la vostra passione con altri appassionati di turismo equestre e a (ri)scoprire la nostra bella regione. Un'atmosfera calorosa garantita!\n\nPercorsi a cavallo e a briglia sciolta"
        ],
        "fr": [
          "Venez partager votre passion avec d'autres amateurs de tourisme équestre et (re)découvrir notre belle région. Ambiance chaleureuse garantie !\n\nParcours montés et attelés"
        ],
        "es": [
          "Venga a compartir su pasión con otros aficionados al turismo ecuestre y (re)descubra nuestra hermosa región. ¡Un ambiente cálido garantizado!\n\nRutas a caballo y con arnés"
        ],
        "nl": [
          "Kom en deel je passie met andere liefhebbers van paardentoerisme en (her)ontdek onze prachtige regio. Een warme sfeer gegarandeerd!\n\nRoutes te paard en aangespannen"
        ]
      },
      "@type": [
