  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6f0deb16-acb2-3b76-ac25-5f1f56dd429d",
      "dc:description": {
        "de": [
          "Städtischer Kulturraum am Place des Commerces vor der Ecole Maternelle.\nGeöffnet montags von 15:00 bis 17:30 Uhr und mittwochs und freitags von 14:00 bis 17:30 Uhr."
        ],
        "en": [
          "Municipal cultural space located on Place des Commerces in front of the nursery school.\nOpen Mondays from 3pm to 5:30pm and Wednesdays and Fridays from 2pm to 5:30pm."
        ],
        "it": [
          "Spazio culturale comunale situato in Place des Commerces, di fronte alla scuola materna.\nAperto il lunedì dalle 15.00 alle 17.30 e il mercoledì e il venerdì dalle 14.00 alle 17.30."
        ],
        "fr": [
          "Espace culturel municipal situé place des Commerces devant l'école Maternelle.\nOuvert le lundi de 15h à 17h30 et le mercredi et vendredi de 14h à 17h30."
        ],
        "nl": [
          "Gemeentelijke culturele ruimte op de Place des Commerces tegenover de kleuterschool.\nGeopend op maandag van 15.00 tot 17.30 uur en op woensdag en vrijdag van 14.00 tot 17.30 uur."
        ],
        "es": [
          "Espacio cultural municipal situado en la Place des Commerces, frente a la escuela infantil.\nAbierto los lunes de 15.00 a 17.30 h. y los miércoles y viernes de 14.00 a 17.30 h."
        ]
      },
