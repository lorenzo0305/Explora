  "rdfs:comment": {
    "de": [
      "Das Château de Flers ist ein Schloss am Chemin du Chat Botté. Das Gebäude im Stil des Louis XVI mit kurzen, zurückspringenden Flügeln ist aus Backstein mit Steinverblendung gebaut. Es beherbergt das Museum des Schlosses von Flers sowie die Empfangsstelle des Fremdenverkehrsamtes der Metropolregion Lille (Métropole Européenne de Lille)."
    ],
    "en": [
      "Château de Flers is located on the Chemin du Chat Botté. The Louis XVI building, with its short wings, is built of brick with stone facings. It houses the Château de Flers museum and the tourist office of the Métropole Européenne de Lille."
    ],
    "it": [
      "Il Castello di Flers si trova sul Chemin du Chat Botté. L'edificio Luigi XVI, con le sue ali corte, è costruito in mattoni con rivestimenti in pietra. Ospita il museo del Castello di Flers e l'ufficio turistico della Metropoli Europea di Lille."
    ],
    "fr": [
      "Le château de Flers est un château situé chemin du Chat Botté. Le bâtiment Louis XVI à courtes ailes en retour, est bâti en brique avec parements de pierre. Il abrite le musée du château de Flers ainsi que l'antenne d'accueil de l'office de tourisme de la Métropole Européenne de Lille."
    ],
    "es": [
      "El Château de Flers está situado en el Chemin du Chat Botté. El edificio Luis XVI, con sus cortas alas, está construido en ladrillo con revestimientos de piedra. Alberga el museo del castillo de Flers y la oficina de turismo de la metrópolis europea de Lille."
    ],
    "nl": [
      "Château de Flers ligt aan de Chemin du Chat Botté. Het Louis XVI-gebouw met zijn korte vleugels is opgetrokken uit baksteen met stenen gevels. Het herbergt het museum van het Château de Flers en het VVV-kantoor van de Europese Metropool Lille."
    ]
  },
