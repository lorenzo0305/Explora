  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6dc705f0-28d4-3a9e-bb36-4752334c91e5",
      "dc:description": {
        "de": [
          "Diesen Donnerstag, den 3. August :\nÜberwinden Sie Ihre Grenzen unabhängig von Ihrem Niveau beim Biking - Radfahrkurs mit Musik - Anmeldung erforderlich (Office de Tourisme)\nTourisme) - Begrenzte Plätze - Ab 16 Jahren mit elterlicher Erlaubnis - Treffpunkt auf der Esplanade de Sainte Cécile um 18 Uhr - Kostenlos"
        ],
        "en": [
          "This Thursday, August 3 :\nCome and exceed your limits whatever your level at the Biking session - Cycling lessons with music - Registration essential (Office de Tourisme) - Places limited\nTourist Office) - Places are limited - For those aged 16 and over with parental consent - Meeting point on the Sainte Cécile esplanade at 6pm - Free of charge"
        ],
        "it": [
          "Questo giovedì 3 agosto:\nVenite a superare i vostri limiti, qualunque sia il vostro livello, alla sessione Biking - Lezioni di ciclismo con musica - Iscrizione indispensabile (Ufficio del Turismo) - Posti limitati - Da\nUfficio del Turismo) - I posti sono limitati - A partire dai 16 anni con autorizzazione dei genitori - Punto d'incontro sulla spianata di Sainte Cécile alle 18.00 - Gratuito"
        ],
        "fr": [
          "Ce jeudi 3 aout :\nVenez dépasser vos limites quel que soit votre niveau à la séance de Biking - Cours de cyclisme tout en musique - Inscription indispensable (Office de\nTourisme) - Places limitées - A partir de 16 ans avec autorisation parentale - RDV sur l’esplanade de Sainte Cécile à 18h - Gratuit"
        ],
        "es": [
          "Este jueves 3 de agosto :\nVen a superar tus límites sea cual sea tu nivel en la sesión Biking - Clases de ciclismo con música - Imprescindible inscripción previa (Oficina de Turismo) - Plazas limitadas - De\nOficina de Turismo) - Plazas limitadas - A partir de 16 años con autorización paterna - Punto de encuentro en la explanada Sainte Cécile a las 18.00 h - Gratuito"
        ],
        "nl": [
          "Deze donderdag 3 augustus :\nKom je grenzen verleggen, ongeacht je niveau, tijdens de fietssessie - Fietslessen op muziek - Inschrijving noodzakelijk (Dienst voor Toerisme) - Plaatsen beperkt - Van\nDienst voor Toerisme) - Beperkt aantal plaatsen - 16 jaar en ouder met toestemming van de ouders - Trefpunt op de esplanade Sainte Cécile om 18u - Gratis"
        ]
      },
      "@type": [
        "Description"
