  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/21b130dd-8b71-3564-be14-8438ec94d669",
      "dc:description": {
        "de": [
          "Wir bieten Ihnen :\n- Kostenlose Taufen\n- Schulungen für Level 1/2/3 und Vorbereitung auf Level 4\n- Grundlegende und fortgeschrittene Nitrox-Ausbildung\n- Apnoe-Ausbildung\n- Ausflüge in Gruben (Amiens, Courtrai), und in die natürliche Umgebung das ganze Jahr über."
        ],
        "en": [
          "We offer you :\n- Free Baptisms\n- Training level 1/2/3 and preparation level 4\n- Basic and advanced nitrox training\n- Apnea training\n- Outings in pits (Amiens, Kortrijk), and in the natural environment all year round."
        ],
        "it": [
          "Vi offriamo :\n? Battesimi gratuiti\n? Livello di formazione 1/2/3 e livello di preparazione 4\n? Formazione nitrox di base e avanzata\n? Formazione all'apnea\n? Escursioni in buca (Amiens, Courtrai) e in acque libere tutto l'anno."
        ],
        "fr": [
          "Nous vous proposons des :\n• Baptêmes gratuits\n• Formations niveau 1/2/3 et préparation niveau 4\n• Formation nitrox de base et confirmé\n• Formation apnée\n• Sorties en fosses (Amiens, Courtrai), et en milieu naturel toute l’année."
        ],
        "nl": [
          "Wij bieden u:\n- Gratis dopen\n- Opleiding op niveau 1/2/3 en voorbereiding op niveau 4\n- Basis- en gevorderde nitroxopleiding\n- Apneu-training\n- Pit uitstapjes (Amiens, Kortrijk), en in de natuur het hele jaar door."
        ],
        "es": [
          "Le ofrecemos :\n? Bautizos gratuitos\n? Nivel de formación 1/2/3 y nivel de preparación 4\n? Formación básica y avanzada en nitrox\n? Entrenamiento en apnea\n? Excursiones en foso (Amiens, Courtrai) y en aguas abiertas durante todo el año."
        ]
      },
