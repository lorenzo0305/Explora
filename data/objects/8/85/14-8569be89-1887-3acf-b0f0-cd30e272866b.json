  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/044a2939-2c66-3f08-be37-4062b483107b",
      "dc:description": {
        "de": [
          "Das in Busnes gelegene Château de Beaulieu enthüllt eine außergewöhnliche Raffinesse und einen außergewöhnlichen Komfort.\nDas charmante 5-Sterne-Hotel von Relais & Châteaux verbindet klassische Architektur mit zeitgenössischer Kunst."
        ],
        "en": [
          "Located in Busnes, the Château de Beaulieu offers exceptional refinement and comfort.\nThis charming 5-star Relais & Châteaux hotel blends classical architecture with contemporary art."
        ],
        "it": [
          "Situato a Busnes, lo Château de Beaulieu offre raffinatezza e comfort eccezionali.\nQuesto affascinante hotel a 5 stelle Relais & Châteaux combina l'architettura classica con l'arte contemporanea."
        ],
        "fr": [
          "Situé à Busnes, le Château de Beaulieu dévoile un raffinement et un confort hors du commun.\nL'hôtel de charme Relais & Châteaux classé 5 étoiles oscille entre architecture classique et art contemporain."
        ],
        "es": [
          "Situado en Busnes, el Château de Beaulieu ofrece un refinamiento y un confort excepcionales.\nEste encantador hotel Relais & Châteaux de 5 estrellas combina la arquitectura clásica con el arte contemporáneo."
        ],
        "nl": [
          "Château de Beaulieu ligt in Busnes en biedt uitzonderlijke verfijning en comfort.\nDit charmante 5-sterren Relais & Châteaux hotel combineert klassieke architectuur met hedendaagse kunst."
        ]
      },
      "@type": [
        "Description"
