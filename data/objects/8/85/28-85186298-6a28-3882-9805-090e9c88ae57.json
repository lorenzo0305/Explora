  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/721f69ce-741c-3ee1-af16-e1d886aaa09c",
      "dc:description": {
        "de": [
          "Die Brasserie de l'Astrée empfängt Sie in ihrer Bierbar, im Restaurant, auf der Bowlingbahn, beim Minigolf oder auf der Terrasse. Empfang von Gruppen auf Reservierung. Ihr Küchenchef zaubert Ihnen Hausmannskost mit Spezialitäten aus der Region."
        ],
        "en": [
          "The Astrée brasserie welcomes you to its beer bar, restaurant, bowling alley, mini-golf course or terrace. Groups welcome on reservation. Your chef will concoct family-style cuisine with local specialties."
        ],
        "it": [
          "La brasserie Astrée vi accoglie nella sua birreria, nel suo ristorante, nella sua pista da bowling, nel suo campo da minigolf o nella sua terrazza. I gruppi sono benvenuti su prenotazione. Lo chef preparerà una cucina familiare con specialità locali."
        ],
        "fr": [
          "La brasserie de l'Astrée vous accueille dans son bar à bières, restaurant, bowling, mini-golf ou en terrasse. Accueil de groupes sur réservation. Votre chef cuisinier vous concoctera de la cuisine familiale avec des spécialités du terroir."
        ],
        "es": [
          "La brasserie Astrée le da la bienvenida en su cervecería, restaurante, bolera, campo de minigolf o terraza. Los grupos son bienvenidos previo acuerdo. Su chef le preparará una cocina familiar con especialidades locales."
        ],
        "nl": [
          "De brasserie Astrée verwelkomt je in de bierbar, het restaurant, de bowlingbaan, de minigolfbaan of op het terras. Groepen zijn welkom op afspraak. De chef bereidt een familiekeuken met lokale specialiteiten."
        ]
      },
