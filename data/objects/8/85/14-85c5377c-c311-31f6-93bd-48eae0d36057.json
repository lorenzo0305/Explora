      "dc:description": {
        "de": [
          "Um 20 Uhr im Palais des Sports (rue Emile Lavezzari)\nMit der Orchesterklasse und den Workshops der Musikschule von Berck-sur-Mer\nOrganisiert vom Club Musical Berckois +33(0)3 21 09 15 46\nFreier Eintritt"
        ],
        "en": [
          "8pm at Palais des Sports (rue Emile Lavezzari)\nWith the orchestra class and workshops of the Berck-sur-mer music school\nOrganized by Club Musical Berckois +33(0)3 21 09 15 46\nFree admission"
        ],
        "it": [
          "Ore 20.00 presso il Palais des Sports (rue Emile Lavezzari)\nCon la classe d'orchestra e i laboratori della scuola di musica di Berck-sur-mer\nOrganizzato dal Club Musical Berckois +33(0)3 21 09 15 46\nIngresso libero"
        ],
        "fr": [
          "A 20h au Palais des Sports (rue Emile Lavezzari)\nAvec la classe d’orchestre et les ateliers de l’école de musique de Berck-sur-mer\nOrganisé par le Club Musical Berckois +33(0)3 21 09 15 46 \nEntrée gratuite"
        ],
        "nl": [
          "20u in het Palais des Sports (rue Emile Lavezzari)\nMet de orkestklas en workshops van de muziekschool van Berck-sur-mer\nGeorganiseerd door de Club Musical Berckois +33(0)3 21 09 15 46\nGratis toegang"
        ],
        "es": [
          "20:00 h en el Palacio de Deportes (rue Emile Lavezzari)\nCon la clase de orquesta y los talleres de la escuela de música de Berck-sur-mer\nOrganizado por el Club Musical Berckois +33(0)3 21 09 15 46\nEntrada gratuita"
        ]
      },
