  "rdfs:comment": {
    "de": [
      "Nachos bietet seinen Gästen eine riesige Auswahl an mexikanischen Gerichten in einer angenehmen Umgebung im Stadtzentrum von Amiens. Der Chefkoch bietet Bowls, Tacos, Fajitas und Nachos an, die Sie ganz nach Ihrem Geschmack anpassen können."
    ],
    "en": [
      "Nachos offers its clients a wide variety of Mexican dishes in a pleasant setting in the city centre of Amiens. The chef offers bowls, tacos, fajitas, nachos that can be customized according to your tastes."
    ],
    "it": [
      "Nachos offre ai suoi clienti una grande varietà di piatti messicani in un ambiente piacevole nel centro di Amiens. Lo chef offre ciotole, tacos, fajitas e nachos che possono essere personalizzati secondo i propri gusti."
    ],
    "fr": [
      "Nachos fait profiter ses clients d'une immense variété de plats mexicains dans un cadre agréable situé dans le centre ville d'Amiens. Le chef propose des bowls, tacos, fajitas, nachos personnalisables selon vos goûts."
    ],
    "es": [
      "Nachos ofrece a sus clientes una gran variedad de platos mexicanos en un entorno agradable en el centro de Amiens. El chef ofrece cuencos, tacos, fajitas y nachos que se pueden personalizar al gusto."
    ],
    "nl": [
      "Nachos biedt zijn klanten een grote verscheidenheid aan Mexicaanse gerechten in een aangenaam kader in het centrum van Amiens. De chef biedt schalen, taco's, fajitas en nacho's die naar eigen smaak kunnen worden aangepast."
    ]
  },
