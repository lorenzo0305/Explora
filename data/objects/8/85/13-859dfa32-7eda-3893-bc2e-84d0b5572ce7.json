  "rdfs:comment": {
    "de": [
      "In der Nähe von Le Quesnoy empfängt Sie La Flambée in Villers-Pol in einem gemütlichen Rahmen und bietet Ihnen eine großzügige, regionale Gourmetküche, Grillspezialitäten vom Holzfeuer..."
    ],
    "en": [
      "Near Le Quesnoy, La Flambée in Villers-Pol welcomes you in a warm setting and offers generous, local gourmet cuisine, wood-fired grills..."
    ],
    "it": [
      "Vicino a Le Quesnoy, La Flambée a Villers-Pol offre un'accoglienza calorosa e una generosa cucina gourmet locale, grigliate a legna..."
    ],
    "fr": [
      "A proximité du Quesnoy, La Flambée à Villers-Pol, vous accueille dans un cadre chaleureux et vous propose une cuisine gastronomique, généreuse et du terroir, grillades au feu de bois..."
    ],
    "nl": [
      "Vlakbij Le Quesnoy biedt La Flambée in Villers-Pol een warm onthaal en royale, lokale gastronomische gerechten, houtgestookte grills..."
    ],
    "es": [
      "Cerca de Le Quesnoy, La Flambée, en Villers-Pol, ofrece una cálida bienvenida y una generosa cocina gourmet local, parrillas de leña..."
    ]
