  "rdfs:comment": {
    "de": [
      "Der Bois d'infière besteht hauptsächlich aus feuchten Weiden- und Erlenwäldern und Megaphorbien, typischen Vegetationen von feuchten Lichtungen und Waldrändern. Durch diesen sumpfigen Wald führt der Rundweg über einen Kilometer über ein dichtes Netz von Holzplanken."
    ],
    "en": [
      "The Bois d'Infière is mainly made up of wet willow and alder woodlands and megaphorbia, typical vegetation of wet clearings and edges. The trail leads through this marshy wood for over a kilometer, via a dense network of decking."
    ],
    "it": [
      "Il Bois d'Infière è costituito principalmente da boschi umidi di salice e ontano e dalla megaforbia, vegetazione tipica delle radure e dei margini umidi. Il sentiero si snoda per più di un chilometro in questo bosco paludoso attraverso una fitta rete di decking."
    ],
    "fr": [
      "Le Bois d'infière est principalement constitué de boisements humides de saules et d'aulnes et de mégaphorbiaies, végétations typiques des clairières et lisières humides. A travers ce bois marécageux, le circuit chemine sur plus d'un  kilomètre via un réseau dense de platelages."
    ],
    "nl": [
      "Het Bois d'Infière bestaat voornamelijk uit vochtig wilgen- en elzenbos en megaphorbia, de typische vegetatie van vochtige open plekken en randen. Het pad loopt meer dan een kilometer door dit moerassige bos via een dicht netwerk van vlonders."
    ],
    "es": [
      "El Bois d'Infière se compone principalmente de bosque húmedo de sauces y alisos y de megaforbia, vegetación típica de claros y márgenes húmedos. El sendero recorre durante más de un kilómetro este bosque pantanoso a través de una densa red de entarimados."
    ]
  },
  "rdfs:label": {
