  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/8082f67d-62d5-35b0-b6db-34bf7d0cde7e",
      "dc:description": {
        "de": [
          "Samstag 18: 14.00 - 18.00 Uhr\nSonntag 29: 10.00 - 18.00 Uhr\n\nEtwa 40 Autoren, Verleger, Illustratoren und Dichter werden die Besucher während des gesamten Wochenendes begrüßen."
        ],
        "en": [
          "Saturday 18th: 2.00 pm - 6.00 pm\nSunday 29th: 10 a.m. - 6 p.m\n\nSome forty authors, publishers, illustrators and poets will be on hand to welcome visitors throughout the weekend."
        ],
        "it": [
          "Sabato 18: 14.00-18.00\nDomenica 29: dalle 10.00 alle 18.00\n\nCirca quaranta autori, editori, illustratori e poeti saranno a disposizione dei visitatori per tutto il fine settimana."
        ],
        "fr": [
          "Samedi 18 : 14 h 00 - 18 h  00 \nDimanche 29 : 10 h 00 - 18 h  00 \n\nUne quarantaine d’auteurs, éditeurs, illustrateurs, poètes,  accueilleront les visiteurs tout au long de ce week-end."
        ],
        "nl": [
          "Zaterdag 18: 14.00 - 18.00 uur\nZondag 29e: 10.00 - 18.00 uur\n\nOngeveer veertig auteurs, uitgevers, illustratoren en dichters zullen het hele weekend aanwezig zijn om bezoekers te verwelkomen."
        ],
        "es": [
          "Sábado 18: 14.00 h - 18.00 h\nDomingo 29: de 10.00 a 18.00 horas\n\nUna cuarentena de autores, editores, ilustradores y poetas recibirán a los visitantes durante todo el fin de semana."
        ]
      },
