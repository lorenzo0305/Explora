  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/544b0f7d-8564-3601-ad92-fe0a1f3d01e2",
      "dc:description": {
        "de": [
          "Eine traditionelle Küche aus frischen oder saisonalen Produkten, hausgemachte Rezepte und eine entspannte Atmosphäre.\n\nJeden Mittag geöffnet, außer sonntags\n2 Dienste: 11:45-13:00 Uhr & 13:00-14:00 Uhr\n\nmontag- bis Donnerstagabend\n2 Gänge: 18:45-20:00 Uhr & 20:00-22:30 Uhr"
        ],
        "en": [
          "Traditional cuisine using fresh and seasonal produce, homemade recipes and a relaxed atmosphere.\n\nOpen for lunch every day except Sunday\n2 services: 11h45-13h & 13h-14h\n\nmonday to Thursday evenings\n2 courses: 18h45-20h & 20h-22h30"
        ],
        "it": [
          "Cucina tradizionale con prodotti freschi e di stagione, ricette fatte in casa e un'atmosfera rilassata.\n\nAperto a pranzo tutti i giorni tranne la domenica\n2 servizi: 11h45-13h e 13h-14h\n\ndal lunedì al giovedì sera\n2 portate: 18.45-20.00 e 20.00-22.30"
        ],
        "fr": [
          "Une cuisine traditionnelle composée de produits frais ou de saison, des recettes maison, une ambiance détendue.\n\nOuverture tous les midis, sauf le dimanche\n2 services: 11h45-13h & 13h-14h\n\n​Du lundi au jeudi soir\n2 services: 18h45-20h & 20h-22h30"
        ],
        "nl": [
          "Traditionele keuken met verse en seizoensgebonden producten, huisgemaakte recepten en een ontspannen sfeer.\n\nDagelijks geopend voor lunch behalve zondag\n2 diensten: 11u45-13u & 13u-14u\n\nmaandag- tot donderdagavond\n2 gangen: 18u45-20u & 20u-10u30"
        ],
        "es": [
          "Cocina tradicional con productos frescos y de temporada, recetas caseras y un ambiente relajado.\n\nAbierto para el almuerzo todos los días excepto el domingo\n2 servicios: 11h45-13h & 13h-14h\n\nde lunes a jueves por la noche\n2 servicios: 18h45-20h & 20h-22h30"
        ]
      },
