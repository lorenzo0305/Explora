      "dc:description": {
        "de": [
          "Wanderungen\nAnmeldung vor Ort ab 8:45 Uhr\n1 - Von 9.15 bis 12.00 Uhr\nEspace Malraux (Rue de l'Eglise)\n7 km - 2 Stunden\n\n2 - Von 9.15 bis 11.45 Uhr\nSalon Escoffier - Avenue de la Paix\n6 km - 1 Std. 45 Min\n\nVerpflegung und Aufklärung auf der Tribüne des Reitzentrums gegen 10 Uhr"
        ],
        "en": [
          "Hiking\nOn-site registration from 8.45am\n1 - From 9.15am to 12pm\nEspace Malraux (Rue de l'Eglise)\n7 km - 2h\n\n2 - From 9h15 to 11h45\nSalon Escoffier - Avenue de la Paix\n6km - 1h45\n\nRefreshments and awareness-raising at the equestrian center grandstand at around 10 a.m"
        ],
        "it": [
          "Escursioni\nIscrizione in loco dalle 8.45\n1 - Dalle 9.15 alle 12.00\nSpazio Malraux (Rue de l'Eglise)\n7 km - 2 ore\n\n2 - Dalle 9.15 alle 11.45\nSalone Escoffier - Avenue de la Paix\n6 km - 1h45\n\nRinfresco e sensibilizzazione presso la tribuna del centro ippico intorno alle 10.00"
        ],
        "fr": [
          "Randonnées \nInscriptions sur place à partir de 8h45\n1 - De 9h15 à 12h\nEspace Malraux (Rue de l'Eglise)\n7 km - 2h\n\n2 - De 9h15 à 11h45\nSalon Escoffier - Avenue de la Paix \n6km - 1h45\n\nRavitaillement et sensibilisation à la tribune du centre équestre vers 10h"
        ],
        "nl": [
          "Wandelen\nRegistratie ter plaatse vanaf 8.45 uur\n1 - Van 9.15 tot 12.00 uur\nEspace Malraux (Rue de l'Eglise)\n7 km - 2 uur\n\n2 - Van 9.15 tot 11.45 uur\nSalon Escoffier - Avenue de la Paix\n6 km - 1u45\n\nVersnaperingen en sensibilisering op de tribune van de manege rond 10 uur"
        ],
        "es": [
          "Senderismo\nInscripción in situ a partir de las 8h45\n1 - De 9h15 a 12h00\nEspace Malraux (Rue de l'Eglise)\n7 km - 2 horas\n\n2 - De 9.15 h a 11.45 h\nSalón Escoffier - Avenue de la Paix\n6 km - 1h45\n\nRefresco y sensibilización en la tribuna del centro ecuestre hacia las 10h00"
        ]
      },
