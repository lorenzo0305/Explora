      "dc:description": {
        "de": [
          "Espace Cyn'Biose bietet Ihnen verschiedene Hundeaktivitäten an: Agility, Hoopers, Mantrailing, Trailball, Nosework... Kommen Sie und teilen Sie einen Moment der Verbundenheit mit Ihrem Hund!"
        ],
        "en": [
          "Espace Cyn'Biose offers canine activities: agility, hoopers, mantrailing, trailball, nosework... Come and share a moment of complicity with your dog!"
        ],
        "it": [
          "L'Espace Cyn'Biose propone attività canine: agility, hoopers, mantrailing, trailball, nosework... Venite a condividere un momento di complicità con il vostro cane!"
        ],
        "fr": [
          "Espace Cyn'Biose vous propose des activités canines : agility, hoopers, mantrailing, trailball, nosework... Venez partager un moment de complicité avec votre chien !"
        ],
        "es": [
          "Espace Cyn'Biose ofrece actividades caninas: agility, hoopers, mantrailing, trailball, nosework... ¡Venga a compartir un momento de complicidad con su perro!"
        ],
        "nl": [
          "Espace Cyn'Biose biedt activiteiten voor honden: behendigheid, hoepelen, mantrailen, trailball, neuswerk... Kom en deel een moment van medeplichtigheid met je hond!"
        ]
      },
