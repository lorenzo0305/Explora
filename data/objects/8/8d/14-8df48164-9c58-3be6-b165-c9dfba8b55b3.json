  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2e6e7440-e0ee-3ed4-9fcf-f28b063292db",
      "dc:description": {
        "de": [
          "Bogenschießen von 18 bis 19 Uhr.\nAb 16 Jahren mit elterlicher Erlaubnis.\nAnmeldung im Tourismusbüro erforderlich.\nKostenlos."
        ],
        "en": [
          "Archery from 6 to 7 pm.\nAges 16 and over with parental consent.\nRegistration essential at the Tourist Office.\nFree admission."
        ],
        "it": [
          "Tiro con l'arco dalle 18.00 alle 19.00.\nPer i maggiori di 16 anni con autorizzazione dei genitori.\nRegistrazione obbligatoria presso l'Ufficio del turismo.\nIngresso libero."
        ],
        "fr": [
          "Tir à l'Arc de 18 à 19h. \nA partir de 16 ans avec autorisation parentale.\nInscription indispensable à l'Office de Tourisme.\nGratuit."
        ],
        "es": [
          "Tiro con arco de 18.00 a 19.00 h.\nMayores de 16 años con autorización paterna.\nImprescindible inscribirse en la Oficina de Turismo.\nEntrada gratuita."
        ],
        "nl": [
          "Boogschieten van 18.00 tot 19.00 uur.\nVanaf 16 jaar met toestemming van de ouders.\nAanmelding noodzakelijk bij het toeristenbureau.\nGratis toegang."
        ]
      },
