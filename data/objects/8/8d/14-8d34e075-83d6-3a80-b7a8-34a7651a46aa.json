  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1d834db9-d74b-3ed2-834f-2f52d9fef7cd",
      "dc:description": {
        "de": [
          "Die Kirche Saint-Etienne wurde im 19. Jahrhundert restauriert. Die Sakristei wurde wieder aufgebaut und 1878 kam der Glockenturm an die Reihe. Eine Rose über dem Portal und Rundbogenfenster vervollständigen die Ausstattung."
        ],
        "en": [
          "The church of Saint-Etienne was restored in the 19th century. The sacristy was rebuilt and then it was the turn of the bell tower in 1878. A rose above the portal and arched windows complete its decoration."
        ],
        "it": [
          "La chiesa di Saint-Etienne è stata restaurata nel XIX secolo. La sacrestia fu ricostruita e poi il campanile nel 1878. Una rosa sopra il portale e finestre ad arco completano la decorazione."
        ],
        "fr": [
          "L'église Saint-Etienne a bénéficié d'une réstauration au XIXème siècle. La sacristie est reconstruite puis c'est au tour du clocher en 1878. Une rose au-dessus du portail et des fenêtres cintrées complètent son décor."
        ],
        "es": [
          "La iglesia de Saint-Etienne fue restaurada en el siglo XIX. La sacristía fue reconstruida y luego el campanario en 1878. Una rosa sobre el portal y las ventanas arqueadas completan su decoración."
        ],
        "nl": [
          "De kerk Saint-Etienne werd in de 19e eeuw gerestaureerd. De sacristie werd herbouwd en vervolgens de klokkentoren in 1878. Een roos boven het portaal en boogramen maken de decoratie compleet."
        ]
      },
