  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f4921ad6-a174-3439-91d9-a13a07703b43",
      "dc:description": {
        "de": [
          "Treffen Sie die ESSM bei der Strandtour 2025!\nSie werden uns im Skatepark von Hardelot mit einem Animationsstand, Basketballspielen und Herausforderungen antreffen!\nDer DJ Cisco HMZ ist auch mit von der Partie!"
        ],
        "en": [
          "Join ESSM for the 2025 beach tour!\nYou'll find us at the Hardelot skate park with an entertainment stand, basketball games and challenges!\nYou'll also be able to enjoy some music with DJ Cisco HMZ on hand!"
        ],
        "it": [
          "Unisciti a ESSM per il tour della spiaggia 2025!\nCi troverete all'Hardelot skate park con uno stand di intrattenimento, giochi di basket e sfide!\nPotrete anche ascoltare un po' di musica con il DJ Cisco HMZ che si unirà a noi!"
        ],
        "fr": [
          "Retrouvez l'ESSM pour la tournée des plages 2025 ! \nVous nous retrouverez au skate parc d'Hardelot avec un stand animations, des jeux basket et des défis!\nVous pourrez aussi profiter de musique avec le DJ Cisco HMZ présent avec nous !"
        ],
        "es": [
          "¡Únete a ESSM en la gira playera de 2025!\n¡Nos encontrarás en el parque de skate Hardelot con un stand de entretenimiento, juegos de baloncesto y desafíos!\n¡También podrás disfrutar de un poco de música con DJ Cisco HMZ que nos acompañará!"
        ],
        "nl": [
          "Doe mee met ESSM voor de 2025 strandtour!\nJe vindt ons bij het Hardelot skatepark met een entertainmentstand, basketbalspellen en challenges!\nJe kunt ook genieten van muziek met DJ Cisco HMZ die ons komt versterken!"
        ]
      },
      "@type": [
        "Description"
      ],
