  "rdfs:comment": {
    "de": [
      "Geführte Touren zu den Schlachtfeldern in der Picardie, in Nordfrankreich und im französischen und belgischen Flandern (Ypres-Bergvorsprung).\nIndividuelle Rundgänge, auf den Spuren einer Einheit, eines Soldaten, einer bestimmten Nationalität oder eines Dichters oder Schriftstellers."
    ],
    "en": [
      "Guided tours of the battlefields in Picardy, Northern France and French and Belgian Flanders (Ypres Salient).\nPersonalized tours, on the traces of a unit, a soldier, a particular nationality or a poet or a writer."
    ],
    "it": [
      "Visite guidate ai campi di battaglia della Piccardia, della Francia settentrionale e delle Fiandre francesi e belghe (Saliente di Ypres).\nVisite personalizzate, sulle tracce di un'unità, di un soldato, di una particolare nazionalità, di un poeta o di uno scrittore."
    ],
    "fr": [
      "Visites guidées des champs de bataille en Picardie, Nord de la France et les Flandres françaises et belges (saillant d’Ypres).\nCircuits personnalisés, sur les traces d’une unité, d’un soldat, d’une nationalité particulière ou d’un poète ou encore un écrivain."
    ],
    "es": [
      "Visitas guiadas a los campos de batalla de Picardía, Norte de Francia y Flandes francés y belga (Saliente de Ypres).\nRecorridos personalizados, sobre las huellas de una unidad, un soldado, una nacionalidad concreta o un poeta o escritor."
    ],
    "nl": [
      "Rondleidingen over de slagvelden in Picardië, Noord-Frankrijk en Frans en Belgisch Vlaanderen (Ieper Salient).\nGepersonaliseerde tochten, in de voetsporen van een eenheid, een soldaat, een bepaalde nationaliteit of een dichter of schrijver."
    ]
  },
