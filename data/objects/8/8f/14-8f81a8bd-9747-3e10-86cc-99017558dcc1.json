  "rdfs:comment": {
    "de": [
      "Ein Stück zwischen Tanz, Theater und Zirkus, um die Versprechungen eines Ungewissen zu umarmen, das viel zu kostbar geworden ist, um es dem Zufall zu überlassen."
    ],
    "en": [
      "A play between dance, theatre and circus, embracing the promises of an uncertainty that has become far too precious to be left to chance."
    ],
    "it": [
      "Un gioco tra danza, teatro e circo, che abbraccia le promesse di un'incertezza diventata troppo preziosa per essere lasciata al caso."
    ],
    "fr": [
      "Une pièce entre danse, théâtre et cirque, pour embrasser les promesses d’un incertain devenu bien trop précieux pour être laissé aux mains du hasard."
    ],
    "es": [
      "Un juego entre danza, teatro y circo, que abraza las promesas de una incertidumbre que se ha vuelto demasiado valiosa para dejarla al azar."
    ],
    "nl": [
      "Een spel tussen dans, theater en circus, dat de beloften omarmt van een onzekerheid die veel te kostbaar is geworden om aan het toeval over te laten."
    ]
  },
