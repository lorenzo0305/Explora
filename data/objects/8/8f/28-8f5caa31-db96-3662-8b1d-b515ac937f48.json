  "rdfs:comment": {
    "de": [
      "Freigelegtes Theater in der Nähe einer verschütteten antiken Siedlung. Eintritt und Besichtigung frei. Archäologisches Museum der Oise in der Nähe (zu Fuß erreichbar) mit Dauerausstellung über die antoikeische Siedlung und Sonderausstellungen. Zahlreiche Animationen und Workshops."
    ],
    "en": [
      "Open theater near a buried ancient agglomeration. Free entrance and visit. Archaeological museum of the Oise nearby (accessible on foot) with permanent exhibition on the ancient agglomeration and temporary exhibitions. Many animations and workshops."
    ],
    "it": [
      "Teatro aperto vicino a un antico insediamento sepolto. Ingresso e visita gratuiti. Nelle vicinanze Museo Archeologico dell'Oise (accessibile a piedi) con mostra permanente sull'antico insediamento e mostre temporanee. Numerose attività e laboratori."
    ],
    "fr": [
      "Théâtre dégagé à proximité d'une agglomération antique enfouie. Entrée et visite libre. Musée archéologique de l'Oise à proximité (accessible à pied) avec exposition permanente sur l'agglomération antoique et expositions temporaires. Nombreuses animations et ateliers."
    ],
    "es": [
      "Teatro abierto cerca de un antiguo asentamiento enterrado. Entrada y visita gratuitas. Cerca del Museo Arqueológico del Oise (accesible a pie) con una exposición permanente sobre el antiguo asentamiento y exposiciones temporales. Numerosas actividades y talleres."
    ],
    "nl": [
      "Open theater bij een begraven oude nederzetting. Gratis toegang en bezoek. Nabijgelegen Archeologisch Museum van de Oise (te voet bereikbaar) met permanente tentoonstelling over de oude nederzetting en tijdelijke tentoonstellingen. Talrijke activiteiten en workshops."
    ]
  },
