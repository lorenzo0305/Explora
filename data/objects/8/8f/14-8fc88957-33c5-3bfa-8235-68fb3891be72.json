  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/18befad6-fbe5-36fc-94d7-aaa0dc09e7ca",
      "dc:description": {
        "de": [
          "Volleyball-Winterferien\nDienstag, 24., Mittwoch, 25. und Donnerstag, 26. Februar\nPaul-Olombel-Halle\n\nVormittags: 10-12 Uhr Training, Einführung und Verbesserung\nNachmittag: 14-17 Uhr Animationen/Turniere, freies Spiel\n\nBedingungen: vormittags Training von 12 bis 15 Jahren/nachmittags ab 12 Jahren ohne Altersbeschränkung\n\nPreise:\nVormittag (Training) 10?\nNachmittags (Turniere) 8?\nTag 15 ?\nAlle drei Tage 40?\nErmäßigung auf den Wochentarif = 10% Familie (Geschwister)"
        ],
        "en": [
          "Winter vacation volleyball\nTuesday 24, Wednesday 25 and Thursday 26 February\nPaul Olombel Hall\n\nMorning: 10am-12pm Training, initiation and improvement\nAfternoon: 2pm-5pm Activities/tournaments, free play\n\nConditions: training mornings for 12 to 15 year-olds/afternoons for 12 year-olds and over, no age limit\n\nPrices :\nMorning (training) 10?\nAfternoon (tournaments) 8?\nFull day 15?\n3 days 40?\nDiscount on weekly rate = 10% family (brothers and sisters)"
        ],
        "it": [
          "Vacanze invernali di pallavolo\nMartedì 24, mercoledì 25 e giovedì 26 febbraio\nSala Paul Olombel\n\nMattina: 10.00-12.00 Allenamento, corsi introduttivi e avanzati\nPomeriggio: 14.00-17.00 Attività/tornei, gioco libero\n\nCondizioni: mattinate di allenamento per ragazzi dai 12 ai 15 anni/pomeriggio per ragazzi dai 12 anni in su senza limiti di età\n\nPrezzi :\nMattina (allenamento) 10?\nPomeriggio (tornei) 8?\nGiornata intera 15?\n3 giorni 40?\nSconto sulla tariffa settimanale = 10% famiglia (fratelli e sorelle)"
        ],
        "fr": [
          "Volley-vacances hiver\nMardi 24, mercredi 25 et jeudi 26 février\nSalle Paul Olombel\n\nMatin : 10h-12h Entraînement, initiation et perfectionnement\nAprès-midi : 14h-17h Animations/tournois, jeu libre\n\nConditions : matinées entraînements de 12 à 15ans/après-midi à partir de 12 ans sans limitation d'âge\n\nTarifs :\nMatinée (entraînement) 10€\nAprès-midi (tournois) 8€\nJournée 15€\nLes 3 jours 40€\nRéduction sur tarif semaine = 10% famille (frères et soeurs)"
        ],
        "nl": [
          "Winter volleybal vakantie\nDinsdag 24, woensdag 25 en donderdag 26 februari\nSalle Paul Olombel\n\nOchtend: 10u-12u Training, inleidende en gevorderde cursussen\nNamiddag: 14u tot 17u Activiteiten/toernooien, vrij spel\n\nVoorwaarden: trainingsochtenden voor 12- tot 15-jarigen/middagen voor 12-jarigen en ouder zonder leeftijdsbeperking\n\nPrijzen :\nOchtend (training) 10?\nMiddag (toernooien) 8?\nHele dag 15?\n3 dagen 40?\nKorting op weekprijs = 10% familie (broers en zussen)"
        ],
        "es": [
          "Vacaciones de invierno de voleibol\nMartes 24, miércoles 25 y jueves 26 de febrero\nSala Paul Olombel\n\nMañana: 10h-12h Entrenamiento, cursos de iniciación y perfeccionamiento\nTarde: 14.00-17.00 Actividades/torneos, juego libre\n\nCondiciones: mañanas de entrenamiento para jóvenes de 12 a 15 años/tardes para mayores de 12 años, sin límite de edad\n\nPrecios :\nMañana (entrenamiento) 10?\nTarde (torneos) 8?\nDía completo 15?\n3 días 40?\nDescuento sobre tarifa semanal = 10% familia (hermanos y hermanas)"
        ]
      },
