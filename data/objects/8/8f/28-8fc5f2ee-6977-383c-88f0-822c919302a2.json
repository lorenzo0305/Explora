  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0c912fb6-48ac-39d4-8063-cccfc312e760",
      "dc:description": {
        "de": [
          "DKS Motors: Erleben Sie die Geschwindigkeit, genießen Sie das Vergnügen ? Kartfahren und Genießen in Höchstgeschwindigkeit, nur einen Katzensprung von Valenciennes entfernt! Ob Sie nun allein, mit Freunden oder Kollegen unterwegs sind, Sie können in aller Sicherheit einen Moment der Geselligkeit erleben und die besten Zeiten der Rennstrecke herausfordern!"
        ],
        "en": [
          "DKS Motors: Experience speed, savor pleasure? Karting and flavors at full speed, just a stone's throw from Valenciennes! Whether you're on your own, with friends or colleagues, come and share a moment of conviviality in complete safety, and challenge the best lap times on the circuit!"
        ],
        "it": [
          "DKS Motors: provare la velocità, assaporare il piacere? Karting e sapori a tutta velocità a due passi da Valenciennes! Da soli, con amici o colleghi, venite a condividere un momento di convivialità in tutta sicurezza e a sfidare i migliori tempi sul circuito!"
        ],
        "fr": [
          "DKS Motors: Vivez la vitesse, dégustez le plaisir – Karting et saveurs à pleine allure à deux pas de Valenciennes ! Avides de sensations, que vous soyez seul, entre amis ou entre collègues, venez partager un moment de convivialité en toute sécurité et défiez les meilleurs chronos du circuit !"
        ],
        "es": [
          "DKS Motors: Experimente la velocidad, saboree el placer.. ¡Karting y sabores a toda velocidad a dos pasos de Valenciennes! Solo, con amigos o colegas, venga a compartir un momento de convivencia con total seguridad y ¡desafíe los mejores tiempos del circuito!"
        ],
        "nl": [
          "DKS Motors: Ervaar de snelheid, geniet van het plezier? Karten en proeven op volle snelheid op een steenworp afstand van Valenciennes! Of u nu alleen bent, met vrienden of collega's, kom en deel een moment van gezelligheid in alle veiligheid en daag de beste rondetijden op het circuit uit!"
        ]
      },
