  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/61520a86-06b1-33b2-9e0e-ac9268b2adc9",
      "dc:description": {
        "de": [
          "Die St.-Laurentius-Kirche ist eine der wenigen Kirchen in der Gegend, die über einen zentralen Turm verfügt. Der Turm wurde wahrscheinlich um 1170 erbaut und 1585 mit einer Turmspitze versehen. Der Glockenturm ist seit 1926 im Zusatzinventar der historischen Denkmäler eingetragen."
        ],
        "en": [
          "Saint-Laurent church is one of the few churches in the area to feature a central tower. Probably built around 1170, the tower was topped by a spire in 1585. The bell tower has been listed as a Monument Historique since 1926."
        ],
        "it": [
          "La chiesa di Saint-Laurent è una delle poche chiese della zona ad avere una torre centrale. Costruita probabilmente intorno al 1170, la torre fu sormontata da una guglia nel 1585. Il campanile è stato classificato come monumento storico dal 1926."
        ],
        "fr": [
          "L'église Saint-Laurent est une des rares églises du territoire à disposer d'une tour centrale. Construite probablement vers 1170, la tour est coiffée d'une flèche en 1585. Le clocher est inscrit à l'inventaire supplémentaire des Monuments historiques depuis 1926."
        ],
        "es": [
          "La iglesia Saint-Laurent es una de las pocas de la zona que tiene una torre central. Construida probablemente hacia 1170, la torre fue rematada con una aguja en 1585. El campanario está declarado Monumento Histórico desde 1926."
        ],
        "nl": [
          "De kerk Saint-Laurent is een van de weinige kerken in de omgeving met een centrale toren. De toren werd waarschijnlijk rond 1170 gebouwd en kreeg in 1585 een spits. De klokkentoren staat sinds 1926 op de monumentenlijst."
        ]
      },
      "@type": [
        "Description"
      ],
