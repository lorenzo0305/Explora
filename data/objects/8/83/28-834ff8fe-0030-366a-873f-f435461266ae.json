  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0dee9df5-3f4d-384c-b350-8789137d185e",
      "dc:description": {
        "de": [
          "Entdecken Sie den Place Carnégie und seinen ikonischen Art-déco-Stil. Während des Art-Deco-Frühlings, der jedes Frühjahr stattfindet, können Sie an Führungen teilnehmen, um mehr über die Vergangenheit des Platzes zu erfahren."
        ],
        "en": [
          "Discover the Place Carnégie and its emblematic Art Deco style. You will be able to discover its past during the guided tours that take place during the Art Deco Spring which takes place every spring."
        ],
        "it": [
          "Scoprite Place Carnégie e il suo emblematico stile Art Déco. È possibile scoprire il suo passato durante le visite guidate che si svolgono durante il Printemps de l'Art Déco, che ha luogo ogni primavera."
        ],
        "fr": [
          "Partez à la découverte de la Place Carnégie et son style emblématique Art Déco. Vous pourrez découvrir son passé à l'occasion de visites guidées ayant lieu lors du Printemps de l'Art Déco qui a lieu durant chaque printemps."
        ],
        "nl": [
          "Ontdek de Place Carnégie en zijn emblematische Art Deco stijl. U kunt zijn verleden ontdekken tijdens de rondleidingen die plaatsvinden tijdens de Printemps de l'Art Déco, die elk voorjaar plaatsvinden."
        ],
        "es": [
          "Descubra la Place Carnégie y su emblemático estilo Art Déco. Podrá descubrir su pasado durante las visitas guiadas que tienen lugar durante el Printemps de l'Art Déco, que se celebra cada primavera."
        ]
      },
