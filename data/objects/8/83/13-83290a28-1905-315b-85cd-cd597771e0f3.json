  "rdfs:comment": {
    "de": [
      "Wir stellen das ganze Jahr über vier verschiedene Biersorten her, ein helles, ein bernsteinfarbenes, ein dreifaches und ein weißes Bier. Am Ende des Jahres gibt es dann das Weihnachtsbier."
    ],
    "en": [
      "We produce four types of beer all year round: blonde, amber, triple and white, and at the end of the year, Christmas beer."
    ],
    "it": [
      "Produciamo quattro tipi di birra durante tutto l'anno: lager, ambrata, tripla e bianca e, a fine anno, la birra di Natale."
    ],
    "fr": [
      "Nous produisons toute l'année quatre types de bière, une blonde, une ambrée, une triple et une blanche, puis en fin d'année, la bière de Noël."
    ],
    "nl": [
      "We produceren het hele jaar door vier soorten bier: pils, amber, tripel en wit, en aan het eind van het jaar kerstbier."
    ],
    "es": [
      "Producimos cuatro tipos de cerveza a lo largo del año: lager, ámbar, triple y blanca, y a finales de año, la cerveza de Navidad."
    ]
  },
  "rdfs:label": {
