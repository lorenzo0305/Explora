  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/04e1c708-4981-3418-bb57-40a8ee57be43",
      "dc:description": {
        "de": [
          "Ein atypischer Ort am Flussufer mit einer großen Terrasse in Südlage! Auf der Speisekarte: geräucherter und marinierter Fisch, Fish and Chips, Meeresfrüchte, gegrillter Fisch, Salate, Burger und vieles mehr!"
        ],
        "en": [
          "An unusual riverside venue with a large south-facing terrace! On the menu: smoked and marinated fish, fish and chips, seafood, grilled fish, salads, burgers & many more!"
        ],
        "it": [
          "Un locale insolito sulle rive del fiume, con un'ampia terrazza esposta a sud! Nel menu: pesce affumicato e marinato, fish and chips, frutti di mare, pesce alla griglia, insalate, hamburger e molto altro!"
        ],
        "fr": [
          "Un lieu atypique situé en bordure de fleuve, avec une grande terrasse exposée plein sud ! Au menu : poissons fumés, marinés, fish and chips, fruits de mer, grillades de poissons, salades, burgers & many more!"
        ],
        "es": [
          "Un lugar insólito a orillas del río, con una gran terraza orientada al sur En el menú: pescado ahumado y marinado, fish and chips, marisco, pescado a la parrilla, ensaladas, hamburguesas y mucho más"
        ],
        "nl": [
          "Een ongewone locatie aan de oever van de rivier, met een groot terras op het zuiden! Op het menu: gerookte en gemarineerde vis, fish and chips, zeevruchten, gegrilde vis, salades, burgers & nog veel meer!"
        ]
      },
      "@type": [
        "Description"
      ],
