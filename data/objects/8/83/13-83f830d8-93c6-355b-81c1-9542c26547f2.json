  "rdfs:comment": {
    "de": [
      "In der Studie des Geländes, das vorgeschlagen wurde, um den Friedhof zu enthalten, der für den Bau der Kirche verlegt wurde, schrieb der Architekt am 9. Oktober 1865."
    ],
    "en": [
      "On October 9, 1865, the architect wrote in his study of the land proposed to contain the cemetery relocated to build the church."
    ],
    "it": [
      "Nel suo studio del terreno proposto per contenere il cimitero spostato per costruire la chiesa, l'architetto scrive il 9 ottobre 1865."
    ],
    "fr": [
      "Dans l'étude du terrain proposé pour contenir le cimetière déplacé pour construire l'église, l'architecte écrit le 9 octobre 1865."
    ],
    "nl": [
      "In zijn studie van het land dat werd voorgesteld om de begraafplaats te bevatten die werd verplaatst om de kerk te bouwen, schreef de architect op 9 oktober 1865."
    ],
    "es": [
      "En su estudio del terreno propuesto para albergar el cementerio trasladado para construir la iglesia, el arquitecto escribió el 9 de octubre de 1865."
    ]
  },
  "rdfs:label": {
