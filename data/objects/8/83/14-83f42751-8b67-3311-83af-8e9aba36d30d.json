      "dc:description": {
        "de": [
          "Reitzentrum, Dressurschule, Boxen- und Weidepensionen, Gruppen- und Privatunterricht.\npraktikum während der Schulferien, Arbeit mit Pferden, Stallungen von Eigentümern."
        ],
        "en": [
          "Equestrian center, dressage school, stable and pasture boarding, group and private lessons.\nschool vacation courses, horse work, owner's stables."
        ],
        "it": [
          "Centro ippico, scuola di dressage, pensione in stalla e al pascolo, lezioni di gruppo e private.\ncorsi durante le vacanze scolastiche, lavoro a cavallo, scuderia del proprietario."
        ],
        "fr": [
          "Centre équestre, école de dressage, pensions box et pensions pâture, cours collectifs et particuliers. \nstage pendant les vacances scolaires, travail des chevaux, écuries de propriétaires."
        ],
        "nl": [
          "Manege, dressuurschool, stal- en weidegang, groeps- en privélessen.\ncursussen tijdens schoolvakanties, paardenwerk, stallen van de eigenaar."
        ],
        "es": [
          "Centro ecuestre, escuela de doma, pupilaje en cuadras y pastos, clases en grupo y particulares.\ncursos durante las vacaciones escolares, trabajo a caballo, cuadra del propietario."
        ]
      },
