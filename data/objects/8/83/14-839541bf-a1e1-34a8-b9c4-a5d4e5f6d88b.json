  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/342bab05-6415-3617-aa3a-9a95e01a4746",
      "dc:description": {
        "de": [
          "Subtile Aromen und gastronomische Köstlichkeiten. Das Restaurant Le Lodge bietet Ihnen eine Küche, die Leichtigkeit, Finesse und Erfindungsreichtum vereint und Feinschmecker und Gourmets gleichermaßen begeistert."
        ],
        "en": [
          "Subtle flavours and gastronomic delights. The restaurant Le Lodge offers you a cuisine combining lightness, finesse and inventiveness that will delight gourmets and gourmands alike."
        ],
        "it": [
          "Sapori sottili e delizie gastronomiche. Il ristorante Le Lodge propone una cucina che combina leggerezza, finezza e inventiva e che farà la gioia di buongustai e gourmet."
        ],
        "fr": [
          "Saveurs subtiles et Délices gastronomiques. Le restaurant Le Lodge vous propose une cuisine alliant légereté, finesse et inventivité qui ravira gourmands et gourmets."
        ],
        "nl": [
          "Subtiele smaken en gastronomische hoogstandjes. Het restaurant Le Lodge biedt u een keuken die lichtheid, finesse en inventiviteit combineert en die fijnproevers en lekkerbekken in vervoering zal brengen."
        ],
        "es": [
          "Sabores sutiles y delicias gastronómicas. El restaurante Le Lodge le ofrece una cocina que combina ligereza, delicadeza e inventiva y que hará las delicias de gourmets y sibaritas."
        ]
      },
      "@type": [
        "Description"
