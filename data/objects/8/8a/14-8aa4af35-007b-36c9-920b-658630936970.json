      "@id": "https://data.datatourisme.fr/21ab653b-3e84-3541-914a-436f9879b0af",
      "dc:description": {
        "de": [
          "Geöffnet von Dienstag bis Sonntag\n\nTraditionelle marokkanische Küche.\nEntdecken Sie die traditionelle marokkanische Küche: Mechoui, Tagine, Couscous vom Grill..."
        ],
        "en": [
          "Open Tuesday to Sunday\n\nTraditional Moroccan cuisine.\nCome and discover traditional Moroccan cuisine: méchoui, tagine, couscous, grilled meats..."
        ],
        "it": [
          "Aperto da martedì a domenica\n\nCucina tradizionale marocchina.\nVenite a scoprire la cucina tradizionale marocchina: méchoui, tagine, couscous, carni alla griglia..."
        ],
        "fr": [
          "Ouvert du mardi au dimanche\n\nCuisine Marocaine traditionnelle.\nVenez découvrir la cuisine traditionnelle marocaine : méchoui, tagine, couscous grillades..."
        ],
        "nl": [
          "Geopend van dinsdag tot zondag\n\nTraditionele Marokkaanse keuken.\nKom en ontdek de traditionele Marokkaanse keuken: méchoui, tajine, couscous, gegrild vlees..."
        ],
        "es": [
          "Abierto de martes a domingo\n\nCocina tradicional marroquí.\nVenga a descubrir la cocina tradicional marroquí: méchoui, tagine, cuscús, carnes a la parrilla..."
        ]
      },
