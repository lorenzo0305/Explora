  "rdfs:comment": {
    "de": [
      "Picknickplatz mit einem Tisch im Herzen des Weilers Boissy, der in einer schönen grünen Umgebung in der Nähe eines Wasserlaufs und eines alten Waschhauses angelegt wurde. Parkplatz und Mülleimer vor Ort."
    ],
    "en": [
      "Picnic area 1 table situated in the heart of the hamlet of Boissy, set in a beautiful green setting, close to a stream and a former wash-house. Parking and rubbish bin on site."
    ],
    "it": [
      "Area picnic con 1 tavolo nel cuore della frazione di Boissy, immersa nel verde, vicino a un ruscello e a un antico lavatoio. Parcheggio e cestino dei rifiuti in loco."
    ],
    "fr": [
      "Aire de pique-nique 1 table  se situant au cœur du hameau de Boissy, aménagée dans un beau cadre verdoyant, à proximité d'un cours d'eau et d'un ancien lavoir. Parking et poubelle sur place."
    ],
    "es": [
      "Área de picnic con 1 mesa en el corazón de la aldea de Boissy, situada en un hermoso entorno verde, cerca de un arroyo y un antiguo lavadero. Aparcamiento y cubo de basura en el lugar."
    ],
    "nl": [
      "Picknickplaats met 1 tafel in het hart van het gehucht Boissy, in een prachtige groene omgeving, vlakbij een beekje en een oud washuis. Parkeerplaats en vuilnisbak op het terrein."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Aire de pique-nique de Boissy"
    ]
  },
