  "rdfs:comment": {
    "de": [
      "Sie werden in einer gemütlichen und typisch flämischen Umgebung empfangen. Hier können Sie lokale und flämische Küche genießen, die aus frischen Produkten zubereitet wird."
    ],
    "en": [
      "You will be welcomed in a warm and typically Flemish setting. You will be able to taste a local and Flemish kitchen. elaborated from fresh product."
    ],
    "it": [
      "Sarete accolti in un ambiente caldo e tipicamente fiammingo. Potrete gustare una cucina locale e fiamminga, preparata con prodotti freschi."
    ],
    "fr": [
      "Vous serez accueillis dans un cadre chaleureux et typiquement Flamand. Vous pourrez y déguster une cuisine locale et Flamande. élaborée à partir de produit frais."
    ],
    "nl": [
      "U wordt ontvangen in een warm en typisch Vlaams kader. U zult kunnen proeven van een lokale en Vlaamse keuken, bereid met verse producten."
    ],
    "es": [
      "Le acogerán en un ambiente cálido y típicamente flamenco. Podrá degustar una cocina local y flamenca, elaborada con productos frescos."
    ]
