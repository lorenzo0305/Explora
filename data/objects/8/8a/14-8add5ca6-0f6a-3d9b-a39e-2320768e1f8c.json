  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/cfefd874-2b18-335b-9798-7a407b7413a1",
      "dc:description": {
        "de": [
          "Océan Délices ist ein Unternehmen, das sich auf die Verarbeitung und Vermarktung von Meeresfrüchten spezialisiert hat und leckere Zubereitungen aus Fisch und Schalentieren anbietet, die aufgrund ihrer Frische und Qualität ausgewählt wurden."
        ],
        "en": [
          "Océan Délices specializes in the processing and marketing of seafood products, offering tasty preparations made from fish and shellfish selected for their freshness and quality."
        ],
        "it": [
          "Océan Délices è un'azienda specializzata nella lavorazione e commercializzazione di prodotti ittici, che offre gustose preparazioni a base di pesce e crostacei selezionati per freschezza e qualità."
        ],
        "fr": [
          "Océan Délices est une entreprise spécialisée dans la transformation et la commercialisation de produits de la mer, proposant des préparations savoureuses élaborées à partir de poissons et crustacés sélectionnés pour leur fraîcheur et leur qualité."
        ],
        "nl": [
          "Océan Délices is een bedrijf dat gespecialiseerd is in de verwerking en marketing van vis-, schaal- en schelpdierproducten en biedt smakelijke bereidingen op basis van vis en schelpdieren die zijn geselecteerd op versheid en kwaliteit."
        ],
        "es": [
          "Océan Délices es una empresa especializada en la transformación y comercialización de productos del mar, que ofrece sabrosas preparaciones a base de pescados y mariscos seleccionados por su frescura y calidad."
        ]
      },
      "@type": [
        "Description"
      ],
