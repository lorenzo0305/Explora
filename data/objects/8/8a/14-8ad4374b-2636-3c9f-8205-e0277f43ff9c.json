  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/456a9e4d-1057-3bd4-b0c2-4eaa58e2e2b6",
      "dc:description": {
        "de": [
          "Schatzsuche, von 10:30 bis 12:00 Uhr, für Kinder von 6 bis 12 Jahren.\nAnmeldung im Tourismusbüro erforderlich.\n3 Euro pro Kind.\nTreffpunkt auf der Esplanade mit Wasserflasche."
        ],
        "en": [
          "Treasure hunt, from 10.30am to 12pm, for children aged 6 to 12.\nRegistration essential at the Tourist Office.\n3 euros per child.\nMeet at the esplanade with a bottle of water."
        ],
        "it": [
          "Caccia al tesoro, dalle 10.30 alle 12.00, per bambini dai 6 ai 12 anni.\nIscrizione obbligatoria presso l'Ufficio del Turismo.\n3 euro a bambino.\nAppuntamento alla spianata con una bottiglia d'acqua."
        ],
        "fr": [
          "Chasse aux trésors, de 10h30 à 12h, pour les enfants de 6 à 12 ans. \nInscription indispensable à l'Office de Tourisme. \n3 euros par enfants.\nRendez-vous à l'esplanade avec votre bouteille d'eau."
        ],
        "nl": [
          "Schattenjacht, van 10.30 tot 12.00 uur, voor kinderen van 6 tot 12 jaar.\nInschrijving verplicht bij het toeristenbureau.\n3 euro per kind.\nVerzamelen op de esplanade met een fles water."
        ],
        "es": [
          "Búsqueda del tesoro, de 10.30 a 12 h, para niños de 6 a 12 años.\nInscripción obligatoria en la Oficina de Turismo.\n3 euros por niño.\nCita en la explanada con su botella de agua."
        ]
      },
