      "@id": "https://data.datatourisme.fr/23c0c42c-938a-3da6-8806-d143f798df9b",
      "dc:description": {
        "de": [
          "Informationen :\n\nMenü :\nBesuchen Sie die Facebook-Seite\n\nÖffnungszeiten: in Habarcq\nFreitag: 18:30 - 21:00 Uhr\n \nBestellung:\nBestellung per Telefon unter 06 74 51 17 20 ab 17 Uhr möglich\n\n "
        ],
        "en": [
          "Information :\n\nMenu :\nVisit our Facebook page\n\nOpening days: in Habarcq\nFriday: 6:30pm - 9pm\n \nOrdering :\nOrders can be placed by telephone on 06 74 51 17 20 from 5pm\n\n "
        ],
        "it": [
          "Ulteriori informazioni :\n\nMenu :\nVisita la pagina Facebook\n\nGiorni di apertura: a Habarcq\nVenerdì: dalle 18.30 alle 21.00\n \nOrdini :\nLe ordinazioni possono essere effettuate telefonicamente al numero 06 74 51 17 20 a partire dalle ore 17.00\n\n "
        ],
        "fr": [
          "Informations :\n\nMenu : \nConsultez la page Facebook\n\nJours d'ouverture : à Habarcq\nLe vendredi: 18h30 - 21h\n \nCommande :\nPossibilité de commander par téléphone au 06 74 51 17 20 à partir de 17h\n\n "
        ],
        "nl": [
          "Meer informatie :\n\nMenu :\nBezoek de Facebook pagina\n\nOpeningsdagen: in Habarcq\nVrijdag: 18.30 - 21.00\n \nBestellen :\nBestellen kan telefonisch op 06 74 51 17 20 vanaf 17u\n\n "
        ],
        "es": [
          "Más información :\n\nMenú :\nVisite la página de Facebook\n\nDías de apertura: en Habarcq\nViernes: 18h30 - 21h00\n \nPedidos :\nLos pedidos pueden hacerse por teléfono llamando al 06 74 51 17 20 a partir de las 17.00 h\n\n "
        ]
      },
