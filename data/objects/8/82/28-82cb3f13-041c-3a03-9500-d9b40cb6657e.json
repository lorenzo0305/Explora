  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7ab4ff38-ae92-371f-bff3-a022b05204a1",
      "dc:description": {
        "de": [
          "Le Bouillon Douaisien liegt im Stadtzentrum von Douai und empfängt Sie jeden Tag mittags und abends. Das Team bietet Ihnen hausgemachte französische Küche mit lokalen Produkten!"
        ],
        "en": [
          "Located in downtown Douai, Le Bouillon Douaisien welcomes you every day for lunch and dinner. The team serves homemade French cuisine, using local produce!"
        ],
        "it": [
          "Situato nel centro di Douai, Le Bouillon Douaisien vi accoglie ogni giorno per pranzo e cena. Il team serve una cucina francese fatta in casa con prodotti locali!"
        ],
        "fr": [
          "Situé en centre-ville de Douai, Le Bouillon Douaisien vous accueille tous les jours, midi et soir. L'équipe vous propose une cuisine française faite maison, avec des produits locaux !"
        ],
        "es": [
          "Situado en el centro de la ciudad de Douai, Le Bouillon Douaisien le da la bienvenida todos los días para el almuerzo y la cena. El equipo sirve cocina francesa casera elaborada con productos locales"
        ],
        "nl": [
          "Le Bouillon Douaisien ligt in het centrum van Douai en verwelkomt je elke dag voor lunch en diner. Het team serveert huisgemaakte Franse gerechten met lokale producten!"
        ]
      },
