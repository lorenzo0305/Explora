  "rdfs:comment": {
    "de": [
      "Hotel-Restaurant, das im April 2022 komplett renoviert wurde und im Herzen von Guise liegt. Genießen Sie die gemütlichen Zimmer mit raffinierter Dekoration und die Spezialitäten des Hauses, insbesondere ihr köstliches und berühmtes Couscous."
    ],
    "en": [
      "Hotel-restaurant, entirely renovated in April 2022, located in the heart of Guise. You will enjoy warm rooms with refined decoration and the specialties of the house, including their delicious and famous couscous."
    ],
    "it": [
      "Hotel-ristorante, interamente rinnovato nell'aprile 2022, situato nel cuore di Guise. Potrete godere di ambienti caldi con una decorazione raffinata e delle specialità della casa, in particolare il loro delizioso e famoso couscous."
    ],
    "fr": [
      "Hôtel-restaurant, entièrement rénové en avril 2022, situé en plein cœur de Guise. Vous profiterez de chambres chaleureuses à la décoration raffinée et des spécialités de la maison, notamment leur délicieux et réputé couscous."
    ],
    "es": [
      "Hotel-restaurante, totalmente renovado en abril de 2022, situado en el corazón de Guise. Disfrutará de cálidas habitaciones con una refinada decoración y de las especialidades de la casa, en particular su delicioso y famoso cuscús."
    ],
    "nl": [
      "Hotel-restaurant, geheel gerenoveerd in april 2022, gelegen in het hart van Guise. U zult genieten van warme kamers met een verfijnde inrichting en de specialiteiten van het huis, in het bijzonder hun heerlijke en beroemde couscous."
    ]
  },
