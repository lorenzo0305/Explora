  "rdfs:comment": {
    "de": [
      "Das Central wurde mit der Idee eines einladenden und inspirierenden Ortes geschaffen, der bedeutsame Erfahrungen bietet und gleichzeitig seine Auswirkungen auf die Umwelt minimiert."
    ],
    "en": [
      "Le Central was created with the idea of a welcoming and inspiring place that offers meaningful experiences while minimizing its impact on the environment."
    ],
    "it": [
      "Central è stato creato con l'idea di un luogo accogliente e stimolante che offra esperienze significative riducendo al minimo l'impatto sull'ambiente."
    ],
    "fr": [
      "Le Central a été créé avec l’idée d’un endroit accueillant et inspirant, qui offre des expériences significatives tout en minimisant son impact sur l’environnement."
    ],
    "es": [
      "Central se creó con la idea de un lugar acogedor e inspirador que ofrezca experiencias significativas y, al mismo tiempo, minimice su impacto en el medio ambiente."
    ],
    "nl": [
      "Central is gecreëerd met het idee van een gastvrije en inspirerende plek die zinvolle ervaringen biedt en tegelijkertijd de impact op het milieu minimaliseert."
    ]
  },
