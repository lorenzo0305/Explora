  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c02caaa4-15c5-3237-b7ba-480f6541ecfe",
      "dc:description": {
        "de": [
          "Die 28 Parzellen der Kleingärten bewahren die Gemüse- und Gartenbautraditionen der Stadt Achicourt. Ziegen, Schafe und Gänse werden die Kleinsten begeistern."
        ],
        "en": [
          "The 28 allotment garden plots preserve the market gardening and horticultural traditions of the town of Achicourt. Goats, sheep and geese will delight the youngest ones."
        ],
        "it": [
          "I 28 appezzamenti di orto conservano le tradizioni orticole della città di Achicourt. Capre, pecore e oche faranno la gioia dei più piccoli."
        ],
        "fr": [
          "Les 28 parcelles de jardins familiaux préservent les traditions maraîchères et horticoles de la ville d’Achicourt. Chèvres, moutons, oies raviront les plus petits."
        ],
        "es": [
          "Las 28 parcelas de huerta conservan las tradiciones hortícolas de la ciudad de Achicourt. Las cabras, ovejas y gansos harán las delicias de los más pequeños."
        ],
        "nl": [
          "De 28 volkstuinen houden de tuinbouw- en tuinbouwtradities van Achicourt in stand. Geiten, schapen en ganzen zullen de kleintjes verrukken."
        ]
      },
