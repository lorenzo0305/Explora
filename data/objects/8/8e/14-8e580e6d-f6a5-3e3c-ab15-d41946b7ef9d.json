  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eb35575a-b33e-3550-a9f4-486238992e3b",
      "dc:description": {
        "de": [
          "Kollektiver, künstlerischer und bürgerschaftlicher Dritter Ort: Wein-, Bier- und Saftbar / Frühstücks- und Restaurantbetrieb / Veranstaltungssaal / Büros und Ateliers.\nEin Ort des Lebens und der Experimente, an dem man sich trifft, teilt, spielt, entdeckt und lacht..."
        ],
        "en": [
          "Collective, Artistic and Citizen Third-Place: Wine, beer & juice bar / Breakfast & catering / Performance hall / Offices & Workshops.\nA place of life and experimentation where people meet, share, play, discover, laugh..."
        ],
        "it": [
          "Collettivo, artistico e cittadino Terzo posto: Wine, beer & juice bar / Colazione e catering / Sala spettacoli / Uffici e laboratori.\nUn luogo di vita e di sperimentazione dove le persone si incontrano, condividono, giocano, scoprono, ridono..."
        ],
        "fr": [
          "Tiers-lieu Collectif, Artistique et Citoyen : Bar à vins, bières & jus / P'tit déj & restauration / Salle de spectacles / Bureaux & Ateliers.\nLieu de vie et d'expérimentations dans lequel on se rencontre, on partage, on joue, on découvre, on rit..."
        ],
        "nl": [
          "Collectieve, artistieke en burgerlijke derde plaats: Wijn, bier & sap bar / Ontbijt & catering / Voorstellingszaal / Kantoren & Workshops.\nEen plek van leven en experimenteren waar mensen elkaar ontmoeten, delen, spelen, ontdekken, lachen..."
        ],
        "es": [
          "Colectivo, artístico y ciudadano de tercera categoría: Bar de vinos, cervezas y zumos / Desayuno y catering / Sala de espectáculos / Oficinas y talleres.\nUn lugar de vida y experimentación donde la gente se encuentra, comparte, juega, descubre, ríe..."
        ]
      },
      "@type": [
        "Description"
      ],
