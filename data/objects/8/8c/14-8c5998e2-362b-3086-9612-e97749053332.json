  "rdfs:comment": {
    "de": [
      "Während der Schulferien können Sie sich mit Ihrer Familie treffen und Ihre Kinder zum Centre d'Histoire du Mémorial 14-18 Notre-Dame-de-Lorette bringen. Auf dem Programm stehen zwei Bastelaktivitäten nach Wahl, die am Mittwoch organisiert werden und die Sie in Begleitung der Museumsvermittlerin durchführen können."
    ],
    "en": [
      "During the school vacations, get together as a family and take your children to the Centre d?Histoire du Mémorial 14-18 Notre-Dame-de-Lorette. On the program: a choice of two hands-on activities on Wednesdays, to be carried out in the company of a museum mediator."
    ],
    "it": [
      "Durante le vacanze scolastiche, riunitevi in famiglia e portate i vostri bambini al Centre d'Histoire du Mémorial 14-18 Notre-Dame-de-Lorette. In programma: una scelta di due attività artigianali organizzate il mercoledì, da svolgere in compagnia di un mediatore museale."
    ],
    "fr": [
      "Pendant les vacances scolaires, retrouvez-vous en famille et emmenez vos enfants au Centre d’Histoire du Mémorial 14-18 Notre-Dame-de-Lorette. Au programme : deux activités manuelles au choix organisées le mercredi à réaliser en compagnie de la médiatrice du musée."
    ],
    "nl": [
      "Kom tijdens de schoolvakanties met het hele gezin naar het Centre d'Histoire du Mémorial 14-18 Notre-Dame-de-Lorette. Op het programma: een keuze uit twee knutselactiviteiten op woensdag, uit te voeren onder begeleiding van een museummedewerker."
    ],
    "es": [
      "Durante las vacaciones escolares, reúnase en familia y lleve a sus hijos al Centro de Historia del Memorial 14-18 Notre-Dame-de-Lorette. En el programa: una selección de dos actividades artesanales organizadas los miércoles, que se llevarán a cabo en compañía de un mediador del museo."
    ]
  },
  "rdfs:label": {
