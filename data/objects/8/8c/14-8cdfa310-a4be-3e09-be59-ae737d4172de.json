  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ee2132ba-f5aa-3fb3-9fad-a8eceece3d97",
      "dc:description": {
        "de": [
          "Brauchen Sie das Bedürfnis, loszulassen? Lust auf Flucht und Entspannung? Lassen Sie sich von Florence auf den schönsten Wanderwegen der Côte d'Opale zu einer jedes Mal einzigartigen Erfahrung der Entspannung in Symbiose mit der Natur führen."
        ],
        "en": [
          "Need to let go? Looking for escape and relaxation? Let Florence guide you along the most beautiful paths of the Côte d'Opale for a unique experience of relaxation in harmony with nature."
        ],
        "it": [
          "Avete bisogno di lasciarvi andare? Volete evadere e rilassarvi? Lasciatevi guidare da Florence lungo i sentieri più belli della Côte d'Opale per un'esperienza unica di relax in armonia con la natura."
        ],
        "fr": [
          "Besoin de lâcher prise ? Envie d'évasion et de détente ? Laissez vous guider par Florence sur les plus beaux sentiers de la Côte d'Opale pour une expérience à chaque fois unique de détente en symbiose avec la nature."
        ],
        "es": [
          "¿Necesita relajarse? ¿Busca evadirse y relajarse? Deje que Florencia le guíe por los senderos más bellos de la Côte d'Opale para vivir una experiencia única de relajación en armonía con la naturaleza."
        ],
        "nl": [
          "Behoefte om los te laten? Wil je ontsnappen en ontspannen? Laat Florence je leiden langs de mooiste paden van de Côte d'Opale voor een unieke ervaring van ontspanning in harmonie met de natuur."
        ]
      },
      "@type": [
        "Description"
      ],
