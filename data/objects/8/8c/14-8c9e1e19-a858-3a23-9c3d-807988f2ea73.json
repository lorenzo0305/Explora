  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/91223704-6034-3a88-a253-4ac8c8a52935",
      "dc:description": {
        "de": [
          "Ein Denkmal, das zum UNESCO-Weltkulturerbe gehört\nEntdecken Sie den Belfried und seine Geschichte jeden Samstag um 15 Uhr mit Hilfe eines Fremdenführers"
        ],
        "en": [
          "Monument classified in the UNESCO World Heritage List\nTake the opportunity to discover the belfry and its history thanks to the expert comments of a guide every Saturday at 3pm"
        ],
        "it": [
          "Patrimonio mondiale dell'UNESCO\nOgni sabato alle ore 15:00, approfittate dell'occasione per scoprire il campanile e la sua storia con l'aiuto di una guida"
        ],
        "fr": [
          "Monument classé au partimoine mondiale de l'UNESCO\nProfitez pour découvrir le beffroi et sons histoire grâce aux commentaires avisés d'un guide tous les samedis à 15h"
        ],
        "nl": [
          "UNESCO werelderfgoed\nMaak van de gelegenheid gebruik om het belfort en zijn geschiedenis te ontdekken met behulp van een gids, elke zaterdag om 15 uur"
        ],
        "es": [
          "Patrimonio de la Humanidad de la UNESCO\nAproveche la oportunidad de descubrir el campanario y su historia con la ayuda de un guía todos los sábados a las 15 horas"
        ]
      },
