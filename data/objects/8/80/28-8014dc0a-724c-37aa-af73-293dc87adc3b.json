  "rdfs:comment": {
    "de": [
      "Am Freitag, den 6. April, findet in der Grange à Musique ein Rap-Abend mit Demi-Portion und Aka Seul Two statt, der von \"Les Amis de la Grange à Musique\" organisiert wird. Voller Preis 14? Ermäßigter Preis 12? Reservierung empfohlen"
    ],
    "en": [
      "Join us on Friday April 6 at the Grange à Musique for the Rap evening programmed by \"Les Amis de la Grange à Musique\" with Demi-Portion and Aka Seul Two. Full price 14? concessions 12? Reservations recommended"
    ],
    "it": [
      "Venerdì 6 aprile, alla Grange à Musique, si terrà una serata Rap organizzata da \"Les Amis de la Grange à Musique\" con Demi-Portion e Aka Seul Two. Prezzo intero 14? ridotto 12? Prenotazione consigliata"
    ],
    "fr": [
      "Rendez-vous vendredi 6 avril à la Grange à Musique pour la soirée Rap programmée par \"Les Amis de la Grange à Musique\" avec Demi-Portion et Aka Seul Two. Tarif plein 14€ tarif réduit 12€. Réservation conseillée"
    ],
    "es": [
      "Únase a nosotros el viernes 6 de abril en el Grange à Musique para una noche de Rap organizada por \"Les Amis de la Grange à Musique\" con Demi-Portion y Aka Seul Two. Precio normal 14? con descuento 12? Se recomienda reservar"
    ],
    "nl": [
      "Kom op vrijdag 6 april naar de Grange à Musique voor een Rap-avond georganiseerd door \"Les Amis de la Grange à Musique\" met Demi-Portion en Aka Seul Two. Volle prijs 14? kortingen 12? Reservering aanbevolen"
    ]
  },
