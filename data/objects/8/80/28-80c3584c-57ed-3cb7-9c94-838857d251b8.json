  "rdfs:comment": {
    "de": [
      "\"Aux quatre vents\" bietet Ihnen feine und schmackhafte Gerichte, die sich je nach Jahreszeit und den auf dem Markt gefundenen Produkten ändern, und das alles in einem eleganten Design-Rahmen."
    ],
    "en": [
      "\"Aux quatre vents\" offers fine and tasty dishes that change with the seasons and the products found on the market, all in a design and elegant setting."
    ],
    "it": [
      "\"Aux quatre vents\" offre piatti raffinati e gustosi che cambiano con le stagioni e i prodotti trovati sul mercato, il tutto in un ambiente elegante e raffinato."
    ],
    "fr": [
      "\"Aux quatre vents\" vous propose des plats fins et savoureux qui changent au fil des saisons et des produits trouvés sur le marché, le tout dans un cadre design et élégant."
    ],
    "es": [
      "\"Aux quatre vents\" ofrece platos finos y sabrosos que cambian con las estaciones y los productos que se encuentran en el mercado, todo ello en un marco elegante y con estilo."
    ],
    "nl": [
      "\"Aux quatre vents\" biedt fijne en smakelijke gerechten die veranderen met de seizoenen en de producten die op de markt te vinden zijn, dit alles in een stijlvol en elegant kader."
    ]
  },
