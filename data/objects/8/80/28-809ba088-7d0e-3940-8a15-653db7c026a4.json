      "dc:description": {
        "de": [
          "Kleine Brasserie, die sich auf die Zubereitung von Moules de Bouchots direkt aus Le Crotoy spezialisiert hat. Fisch von der Küste je nach Ankunft im Hafen."
        ],
        "en": [
          "Small brewery specialized in the cooking of mussels of bouchots directly of Crotoy. Fish from the coast according to the arrivals in the port."
        ],
        "it": [
          "Piccola brasserie specializzata nella cottura delle cozze del Crotoy. Pescare dalla costa in base agli arrivi in porto."
        ],
        "fr": [
          "Petite brasserie spécialisée dans la cuisine des moules de bouchots en direct du Crotoy. Poisson de la côte en fonction des arrivage au port."
        ],
        "es": [
          "Pequeña brasserie especializada en la cocción de mejillones de la Crotoy. Pescado de la costa según las llegadas al puerto."
        ],
        "nl": [
          "Kleine brasserie gespecialiseerd in de bereiding van mosselen uit de Crotoy. Vis van de kust volgens de aankomst in de haven."
        ]
