  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ff6fb969-4187-3e9a-8c79-522d1acab4f3",
      "dc:description": {
        "de": [
          "Das ideal am Place de la Liberté gelegene Restaurant ist seit 1882 der Treffpunkt der Einwohner von Roubaix! Das Lokal bietet Pizzas, Salate, Burger und regionale Spezialitäten an.  Eine Brasserie mit geselliger Atmosphäre und abwechslungsreichen Gerichten."
        ],
        "en": [
          "Conveniently located on Place de la Liberté, it's been a meeting place for Roubaix residents since 1882! The restaurant serves pizzas, salads, burgers and regional specialties.  A brasserie with a friendly atmosphere and a wide variety of dishes."
        ],
        "it": [
          "Situato in posizione ideale su Place de la Liberté, è un luogo di incontro per gli abitanti di Roubaix dal 1882! Il ristorante serve pizze, insalate, hamburger e specialità regionali.  Una brasserie dall'atmosfera accogliente e con una grande varietà di piatti."
        ],
        "fr": [
          "Idéalement situé  Place de la Liberté, c'est le rendez-vous des roubaisiens depuis 1882 ! L'établissement propose pizzas, salades, burgers et des spécialités régionales.  Une brasserie à l'ambiance conviviale et aux plats variés."
        ],
        "es": [
          "Idealmente situado en la plaza de la Liberté, es el punto de encuentro de los habitantes de Roubaix desde 1882 El restaurante sirve pizzas, ensaladas, hamburguesas y especialidades regionales.  Una brasserie con un ambiente agradable y una gran variedad de platos."
        ],
        "nl": [
          "Dit restaurant is ideaal gelegen aan de Place de la Liberté en is al sinds 1882 een ontmoetingsplaats voor inwoners van Roubaix! Het restaurant serveert pizza's, salades, hamburgers en regionale specialiteiten.  Een brasserie met een gezellige sfeer en een verscheidenheid aan gerechten."
        ]
      },
      "@type": [
        "Description"
      ],
