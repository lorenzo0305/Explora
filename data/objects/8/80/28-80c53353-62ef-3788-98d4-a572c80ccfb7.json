  "rdfs:comment": {
    "de": [
      "Der Belfried stammt aus dem 15. Jahrhundert und gehört zum UNESCO-Weltkulturerbe. Er beherbergt drei Säle: den Saal des Friedensgerichts, den Schöffen- und den Wachsaal. Diese Säle sind über eine Wendeltreppe mit 76 Stufen miteinander verbunden."
    ],
    "en": [
      "Dating from the 15th century and listed as a UNESCO World Heritage Site, this belfry houses three rooms: the Justice of the Peace room, the Aldermen's room and the Guards' room. These rooms are connected to a spiral staircase of 76 steps."
    ],
    "it": [
      "Risalente al XV secolo e dichiarato Patrimonio dell'Umanità dall'UNESCO, questo campanile ospita tre sale: la Sala del Giudice di Pace, la Sala degli Assessori e la Sala della Guardia. Queste camere sono collegate a una scala a chiocciola di 76 gradini."
    ],
    "fr": [
      "Datant du XVème siècle et inscrit au patrimoine mondial de l'UNESCO, ce beffroi abrite trois salles  : salle de Justice de paix, salle des Echevins et salle des gardes. Ces salles sont reliées à un escalier à vis de 76 marches."
    ],
    "es": [
      "Este campanario, que data del siglo XV y está declarado Patrimonio de la Humanidad por la UNESCO, alberga tres salas: la sala del juez de paz, la sala de los regidores y la sala de la guardia. Estas habitaciones están conectadas con una escalera de caracol de 76 peldaños."
    ],
    "nl": [
      "Dit belfort dateert uit de 15e eeuw en staat op de werelderfgoedlijst van de UNESCO. Het herbergt drie zalen: de Vredekamer, de Schepenkamer en de Wachtkamer. Deze kamers zijn verbonden met een wenteltrap met 76 treden."
    ]
  },
