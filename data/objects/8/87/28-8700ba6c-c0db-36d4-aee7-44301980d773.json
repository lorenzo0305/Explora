  "rdfs:comment": {
    "de": [
      "Ihre Crêperie \"La Belle Époque\" lädt Sie ein, ihre süßen oder herzhaften Crêpes zu genießen.\nIhre Crêperie setzt auf den Verkauf zum Mitnehmen nach Hause, zur Arbeit oder nach draußen.\nHier finden Sie Ihre Box mit Galette, Salat, Gedeck und Getränken."
    ],
    "en": [
      "Your Crêperie \"La Belle Époque\" invites you to come and share its sweet and savoury crêpes.\nYour Crêperie focuses on take-away sales at home, at work or outside.\nFind your box with its galette, salad, cutlery and drink."
    ],
    "it": [
      "La vostra Crêperie \"La Belle Époque\" vi invita a venire a condividere le sue crêpes dolci e salate.\nLa vostra Crêperie si concentra sulla vendita da asporto a casa, al lavoro o all'aperto.\nTrovate la vostra scatola con galette, insalata, posate e bevande."
    ],
    "fr": [
      "Votre Crêperie \" La Belle Époque\" vous propose de venir partager ses crêpes salées ou sucrées.\nVotre Crêperie mise sur la vente à emporter à la maison, au travail, à l'extérieur. \nRetrouvez votre box avec sa galette, salade, couvert et boisson."
    ],
    "nl": [
      "Uw Crêperie \"La Belle Époque\" nodigt u uit om haar zoete en hartige crêpes te komen delen.\nYour Crêperie richt zich op meeneemverkoop thuis, op het werk of buiten.\nZoek je doos met galette, salade, bestek en drankje."
    ],
    "es": [
      "Su Crêperie \"La Belle Époque\" le invita a venir y compartir sus crepes dulces y salados.\nTu Crêperie se centra en la venta para llevar a casa, al trabajo o fuera.\nEncuentre su caja con su galette, ensalada, cubiertos y bebida."
    ]
  },
  "rdfs:label": {
