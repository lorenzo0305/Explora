      "dc:description": {
        "de": [
          "DIE FESTI'FRITES\nSEIT 2023\nLa festi'frites Partner Ihrer Veranstaltungen (Hochzeit, Geburtstage....)\n07.81.00.08.27.\nkontaktieren Sie uns für einen Kostenvoranschlag - kommt an den Wochenenden ... für jede Veranstaltung\nlafestifrites@gmail.com"
        ],
        "en": [
          "THE FESTI'FRITES\nSINCE 2023\nThe festi'frites partner for your events (weddings, birthdays....)\n07.81.00.08.27.\ncontact us for a quote - on weekends... for all events\nlafestifrites@gmail.com"
        ],
        "it": [
          "LE FESTI'FRITES\nDAL 2023\nIl partner di festi'frites per i vostri eventi (matrimoni, compleanni....)\n07.81.00.08.27.\ncontattateci per un preventivo - nei fine settimana... per tutti gli eventi\nlafestifrites@gmail.com"
        ],
        "fr": [
          "LA FESTI'FRITES\nDEPUIS 2023\nLa festi'frites partenaire de vos événements (mariage, anniversaires....)\n07.81.00.08.27.\ncontacter pour devis - se déplace les weekends... pour tout évènement\nlafestifrites@gmail.com"
        ],
        "es": [
          "LAS FESTI'FRITES\nDESDE 2023\nEl socio festi'frites para sus eventos (bodas, cumpleaños....)\n07.81.00.08.27.\npóngase en contacto con nosotros para solicitar un presupuesto - los fines de semana... para todos los eventos\nlafestifrites@gmail.com"
        ],
        "nl": [
          "DE FESTI'FRITES\nSINDS 2023\nDe festi'frites partner voor uw evenementen (bruiloften, verjaardagen....)\n07.81.00.08.27.\nneem contact met ons op voor een offerte - in het weekend... voor alle evenementen\nlafestifrites@gmail.com"
        ]
      },
