      "dc:description": {
        "de": [
          "Die Pommesbude des Campingplatzes ist für alle offen und empfängt Sie in der Saison abends. Schlemmen Sie vor Ort oder zum Mitnehmen"
        ],
        "en": [
          "The campsite French fry shop, open to all, welcomes you in the evenings during the season. Come and enjoy your meal on site or to take away"
        ],
        "it": [
          "Il negozio di patatine fritte del campeggio, aperto a tutti, vi accoglie la sera durante la stagione. Venite a gustare il vostro pasto in loco o da asporto"
        ],
        "fr": [
          "La friterie du camping ouverte à tous, vous accueille le soir en saison. Venez vous régaler sur place ou à emporter"
        ],
        "es": [
          "La tienda de patatas fritas del camping, abierta a todos, le da la bienvenida por las tardes durante la temporada. Disfrute de su comida in situ o para llevar"
        ],
        "nl": [
          "De friettent van de camping, die voor iedereen toegankelijk is, verwelkomt je 's avonds tijdens het seizoen. Kom ter plaatse van je maaltijd genieten of om mee te nemen"
        ]
      },
