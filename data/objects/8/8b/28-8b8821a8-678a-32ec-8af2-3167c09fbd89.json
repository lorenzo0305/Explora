  "rdfs:comment": {
    "de": [
      "Der Park des Schlosses Rambures, einschließlich des Rosengartens, ist eine 15 ha große romantische Grünanlage, die in das Zusatzinventar der historischen Denkmäler aufgenommen wurde. Für die Besichtigung des Schlosses und des Parks sollten Sie einen halben Tag einplanen."
    ],
    "en": [
      "The park of Château de Rambures, including the rose garden, can be described as a 15-hectare romantic green setting, listed on the Supplementary Inventory of Historic Monuments. Allow half a day to visit the château and park."
    ],
    "it": [
      "Il parco del Castello di Rambures, compreso il roseto, può essere descritto come una romantica cornice verde di 15 ettari, inserita nell'Inventario supplementare dei monumenti storici. Dedicate mezza giornata alla visita del castello e del parco."
    ],
    "fr": [
      "Le parc du château de Rambures, comprenant la roseraie, peut se définir comme un écrin de verdure romantique de 15ha, inscrit à l’inventaire supplémentaire des Monuments historiques. Prévoir une demi-journée pour visiter le château et la parc."
    ],
    "nl": [
      "Het terrein van Château de Rambures, inclusief de rozentuin, kan worden beschreven als een romantische groene omgeving van 15 hectare, opgenomen in de Aanvullende Inventaris van Monumenten. Trek een halve dag uit voor een bezoek aan het kasteel en het park."
    ],
    "es": [
      "El recinto del castillo de Rambures, incluida la rosaleda, es un romántico paraje verde de 15 hectáreas, inscrito en el Inventario Suplementario de Monumentos Históricos. Dedique medio día a visitar el castillo y su recinto."
    ]
  },
