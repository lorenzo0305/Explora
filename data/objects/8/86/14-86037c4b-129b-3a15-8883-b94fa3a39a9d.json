      "@id": "https://data.datatourisme.fr/3b799c25-2588-3961-b902-c68260534e98",
      "dc:description": {
        "de": [
          "Longe côte ist eine von diplomierten Animateuren betreute sportliche Aktivität, bei der man mit oder ohne Antriebsmaterial auf dem Meer spazieren geht. Aktivität für alle Altersgruppen."
        ],
        "en": [
          "Longe côte is a sporting activity supervised by qualified instructors that involves walking in the sea, with or without propulsion equipment. Open to all."
        ],
        "it": [
          "La Longe côte è un'attività sportiva supervisionata da istruttori qualificati che consiste nel camminare in mare, con o senza mezzi di propulsione. È adatta a tutte le età."
        ],
        "fr": [
          "Le longe côte est une activité sportive encadrée par des animateurs diplômés qui consiste à marcher en mer, avec ou sans matériel de propulsion. Activité tout public."
        ],
        "nl": [
          "Longe côte is een sportieve activiteit onder begeleiding van gekwalificeerde instructeurs waarbij je in zee loopt, met of zonder voortstuwingsmateriaal. Geschikt voor alle leeftijden."
        ],
        "es": [
          "Longe côte es una actividad deportiva supervisada por monitores cualificados que consiste en caminar por el mar, con o sin equipo de propulsión. Apta para todas las edades."
        ]
      },
