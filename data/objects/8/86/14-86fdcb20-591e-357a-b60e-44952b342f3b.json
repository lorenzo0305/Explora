  "rdfs:comment": {
    "de": [
      "Die Kompanie La Ponctuelle setzt ihr Projekt voisins-voisines mit Culture Commune fort und organisiert den ganzen Tag über ein großes Fest mit den Bewohnern des Viertels Cité des Provinces in Lens."
    ],
    "en": [
      "Compagnie La Ponctuelle continues its voisins-voisines project with Culture Commune, organizing an all-day party with residents of the Cité des Provinces district in Lens."
    ],
    "it": [
      "La Ponctuelle prosegue il progetto voisins-voisines con Culture Commune, organizzando una festa di un giorno intero con gli abitanti del quartiere Cité des Provinces di Lens."
    ],
    "fr": [
      "La compagnie La Ponctuelle poursuit son projet voisins-voisines avec Culture Commune et organise une grande fête toute la journée avec les habitant.e.s du quartier de la Cité des Provinces à Lens."
    ],
    "nl": [
      "La Ponctuelle zet haar voisins-voisines project voort met Culture Commune en organiseert een hele dag feest met de bewoners van de wijk Cité des Provinces in Lens."
    ],
    "es": [
      "La Ponctuelle prosigue su proyecto voisins-voisines con Culture Commune, organizando una fiesta de un día de duración con los vecinos del barrio de la Cité des Provinces de Lens."
    ]
  },
  "rdfs:label": {
    "fr": [
      "BIM - fête des voisins voisines de la Cité des Provinces"
    ]
  },
