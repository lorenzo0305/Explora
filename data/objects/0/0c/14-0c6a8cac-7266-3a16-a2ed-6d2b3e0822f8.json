      "dc:description": {
        "de": [
          "Der Club bietet für die Sommermonate ein Abonnement für unbegrenzten Zugang zu den Innen- und Außenkursen an, das 7 Tage die Woche von 8:00 bis 22:00 Uhr gilt"
        ],
        "en": [
          "For the summer season, the club offers unlimited access to indoor and outdoor courses 7/7 from 8:00 am to 10:00 pm"
        ],
        "it": [
          "Per il periodo estivo, il club offre un accesso illimitato alle lezioni al coperto e all'aperto 7 giorni su 7, dalle 8.00 alle 22.00"
        ],
        "fr": [
          "Le club propose pour la période estivale un abonnement d'accès illimités au cours intérieur et extérieur 7/7 j de 8 h 00 à 22 h 00"
        ],
        "nl": [
          "Voor de zomerperiode biedt de club onbeperkte toegang tot binnen- en buitenlessen, 7 dagen per week van 8.00 tot 22.00 uur"
        ],
        "es": [
          "Durante el periodo estival, el club ofrece acceso ilimitado a las clases de interior y exterior los 7 días de la semana, de 8.00 a 22.00 horas"
        ]
