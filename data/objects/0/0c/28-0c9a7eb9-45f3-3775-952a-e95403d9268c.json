      "dc:description": {
        "de": [
          "HOUTKEKETTE 2025 Musikfestival in ländlichen Gebieten.\n\nProgrammgestaltung :\nFreitag 19 Uhr: Generation Goldman by Grand Mix, U2 Project, DJ Ludomix\nSamstag 19 Uhr: Veulebuz, Zouk Machine, La compagnie Créole, DJ Raph.\nSonntag 13 Uhr: Michel Pruvot, Ève Angeli."
        ],
        "en": [
