  "rdfs:comment": {
    "de": [
      "Sie möchten in einer grünen Umgebung in der Nähe eines Flusses empfangen werden, Sie lieben gutes Essen, reservieren Sie Ihren Tisch und probieren Sie einen der schönsten Weinkeller unserer Region bis bald Denis und Françoise"
    ],
    "en": [
      "You wish to be welcomed in a green setting near a river, you like good food, book your table and taste one of the most beautiful cellars of our region. See you soon Denis and Francoise"
    ],
    "it": [
      "Desiderate essere accolti in un ambiente verde vicino a un fiume, vi piace la buona cucina, prenotate il vostro tavolo e assaggiate una delle più belle cantine della nostra regione presto Denis e françoise"
    ],
    "fr": [
      "Vous souhaitez être accueilli dans un cadre de verdure près d'une rivière, vous aimez la bonne table, réservez votre table et dégustez une des plus belles cave de notre région à bientôt Denis et françoise"
    ],
    "nl": [
      "U wenst ontvangen te worden in een groene omgeving nabij een rivier, u houdt van lekker eten, reserveer uw tafel en proef een van de mooiste kelders van onze streek binnenkort Denis en françoise"
    ],
    "es": [
      "Desea ser acogido en un entorno verde cerca de un río, le gusta la buena comida, reserve su mesa y deguste pronto una de las más bellas bodegas de nuestra región Denis y françoise"
    ]
  },
