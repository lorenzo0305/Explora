  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5b67ab67-7395-3d48-9c79-a99eff71d3f8",
      "dc:description": {
        "de": [
          "Rando Sophro\nWanderung auf den Pfaden der Zöllner mit der Sophrologin Florence Pécriaux.\nAbfahrt 15:30 Uhr an der Strandbibliothek.\nWanderschuhe und ein Handtuch zum Sitzen mitbringen.\nKostenlos, für Erwachsene.\nNach vorheriger Anmeldung\nSophrologie-Sitzung in der Mediathek bei schlechtem Wetter."
        ],
        "en": [
          "Rando Sophro\nStroll along the customs paths with sophrologist Florence Pécriaux.\nDeparture 3.30pm from the beach library.\nBring walking shoes and a towel to sit on.\nFree, for adults.\nReservations required\nSophrology session at the mediatheque in case of bad weather."
        ],
        "it": [
          "Rando Sophro\nPasseggiata lungo i sentieri della dogana con la sofrologa Florence Pécriaux.\nPartenza alle 15.30 dalla biblioteca della spiaggia.\nPortare scarpe da trekking e un asciugamano per sedersi.\nGratuito, per adulti.\nSolo su prenotazione\nSessione di sofrologia presso la mediateca in caso di maltempo."
        ],
        "fr": [
          "Rando Sophro\nBalade sur les sentiers des douaniers avec la sophrologue Florence Pécriaux.\nDépart 15h30 à la bibliothèque de plage.\nPrévoir des chaussures de marche et une serviette pour s'asseoir.\nGratuit, pour adultes.\nSur réservation\nSéance de sophrologie à la médiathèque en cas de mauvais temps."
        ],
        "nl": [
          "Rando Sophro\nWandeling langs de douanepaden met sofrologiste Florence Pécriaux.\nVertrek 15.30 uur vanaf de strandbibliotheek.\nNeem wandelschoenen mee en een handdoek om op te zitten.\nGratis, voor volwassenen.\nAlleen op reservering\nSofrologiesessie in de mediatheek bij slecht weer."
        ],
        "es": [
          "Rando Sophro\nPaseo por los senderos de la aduana con la sofróloga Florence Pécriaux.\nSalida a las 15.30 h de la biblioteca de la playa.\nTraer calzado para caminar y una toalla para sentarse.\nGratuito, para adultos.\nCon reserva previa\nSesión de sofrología en la mediateca en caso de mal tiempo."
        ]
      },
