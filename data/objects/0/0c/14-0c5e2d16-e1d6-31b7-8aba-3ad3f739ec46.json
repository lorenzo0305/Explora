  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1130d6ff-400f-3695-858d-3a66332d4996",
      "dc:description": {
        "de": [
          "Spazieren wir unter den Bäumen und bewundern wir die Blätter, die die Äste bedecken. Beobachten wir ihre Unterschiede und lernen wir auf unterhaltsame Weise, sie zu erkennen."
        ],
        "en": [
          "Let's take a walk under the trees and admire the leaves that cover the branches. Observe their differences and learn to recognize them in a fun way."
        ],
        "it": [
          "Fate una passeggiata sotto gli alberi e ammirate le foglie che ricoprono i rami. Osservate le loro differenze e imparate a riconoscerle in modo divertente."
        ],
        "fr": [
          "Promenons-nous sous les arbres et admirons les feuilles qui couvrent les branches. Observons leurs différences et apprenons à les reconnaître de manière amusante."
        ],
        "es": [
          "Pasea bajo los árboles y admira las hojas que cubren las ramas. Observa sus diferencias y aprende a reconocerlas de forma divertida."
        ],
        "nl": [
          "Maak een wandeling onder de bomen en bewonder de bladeren die de takken bedekken. Observeer hun verschillen en leer ze op een leuke manier herkennen."
        ]
      },
      "@type": [
        "Description"
