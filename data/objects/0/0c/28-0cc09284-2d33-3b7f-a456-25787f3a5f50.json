  "rdfs:comment": {
    "de": [
      "Dieses kleine Café-Restaurant im Zentrum von Meru bietet Ihnen traditionelle Küche. Das Geschäft besteht seit über 100 Jahren. Genießen Sie ein Getränk und ein gutes, hausgemachtes Gericht. Bis bald!"
    ],
    "en": [
      "In the centre of Meru, this small café-restaurant offers traditional cuisine. It has existed for more than 100 years. Come and enjoy a drink around a good home-made dish. See you soon!"
    ],
    "it": [
      "Nel centro di Méru, questo piccolo caffè-ristorante offre una cucina tradizionale. Il ristorante esiste da oltre 100 anni. Venite a bere qualcosa con un buon piatto fatto in casa. A presto!"
    ],
    "fr": [
      "Au centre de Méru, ce petit café-restaurant vous propose une cuisine traditionnelle. L'enseigne existe depuis plus de 100 ans. Venez profiter d'un verre autour d'un bon petit plat fait maison. A très vite !"
    ],
    "nl": [
      "In het centrum van Méru biedt dit kleine café-restaurant een traditionele keuken. Het restaurant bestaat al meer dan 100 jaar. Kom en geniet van een drankje met een lekker huisgemaakt gerecht. Tot ziens!"
    ],
    "es": [
      "En el centro de Méru, este pequeño café-restaurante ofrece cocina tradicional. El restaurante existe desde hace más de 100 años. Ven a disfrutar de una bebida con un buen plato casero. Hasta pronto"
    ]
  },
