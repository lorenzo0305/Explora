  "rdfs:comment": {
    "de": [
      "Das Hotel Campanile Lille Est - Villeneuve d'Ascq ist die ideale Unterkunft für einen Wochenendtrip in den Norden. Es liegt 15 km vom Flughafen Lille-Lesquin, 8 km von der Altstadt von Lille und 2 Gehminuten vom LaM entfernt und bietet schnellen Zugang zu den Hotspots der Stadt. Reisen Sie in aller Ruhe, ein Restaurantangebot ist immer verfügbar."
    ],
    "en": [
      "The Campanile Lille Est - Villeneuve d'Ascq hotel is the ideal accommodation for a weekend in the north. Just 15 km from Lille-Lesquin airport, 8 km from Vieux-Lille and a 2-minute walk from LaM, it offers quick access to the city's hotspots. Travel in peace, a catering offer is always available."
    ],
    "it": [
      "L'hotel Campanile Lille Est - Villeneuve d'Ascq è la sistemazione ideale per un weekend nel nord. Situato a 15 km dall'aeroporto di Lille-Lesquin, a 8 km da Vieux-Lille e a 2 minuti a piedi dal LaM, offre un rapido accesso ai punti nevralgici della città. Viaggiate in tutta tranquillità, con un servizio di ristorazione sempre disponibile."
    ],
    "fr": [
      "L'hôtel Campanile Lille Est - Villeneuve d'Ascq est l'hébergement idéal pour un week-end dans le nord. A 15 km de l'aéroport de Lille-Lesquin, à 8 km du Vieux-Lille et à 2 minutes à pied du LaM, il permet un accès rapide aux hotspots de la ville. Voyagez en toute tranquillité, une offre de restauration est toujours disponible."
    ],
    "nl": [
      "Het hotel Campanile Lille Est - Villeneuve d'Ascq is de ideale accommodatie voor een weekend in het noorden. Het ligt op 15 km van de luchthaven Lille-Lesquin, op 8 km van Vieux-Lille en op 2 minuten lopen van de LaM, en biedt snelle toegang tot de hotspots van de stad. Reis in alle rust, met catering die altijd beschikbaar is."
    ],
    "es": [
      "El hotel Campanile Lille Est - Villeneuve d'Ascq es el alojamiento ideal para un fin de semana en el norte. Situado a 15 km del aeropuerto de Lille-Lesquin, a 8 km de Vieux-Lille y a 2 minutos a pie de LaM, ofrece un acceso rápido a los lugares de interés de la ciudad. Viaje tranquilo, con servicio de restauración disponible en todo momento."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Campanile Lille Est Villeneuve d'Ascq"
    ]
  },
  "COVID19SpecialMeasures": {
    "de": [
      "Das Hotel Campanile in Villeneuve d'Ascq ist die ideale Unterkunft für einen Wochenendtrip in den Norden. Es liegt nur 15 km vom Flughafen Lille Lesquin, 8 km von der Altstadt von Lille und 2 Gehminuten vom LAM entfernt.\nReisen Sie ganz entspannt, denn es gibt immer ein Restaurantangebot, das jeden Appetit mit typischen Gerichten aus der Region befriedigt."
    ],
    "en": [
      "The campanile hotel in Villeneuve d?Ascq is the ideal accommodation for a weekend in the North of France. Just 15km from Lille Lesquin airport, 8km from the old town of Lille and a 2-minute walk from the LAM.\nTravel with peace of mind, as our catering service is always on hand to satisfy every appetite with typical regional dishes."
    ],
    "it": [
      "L'hotel Campanile di Villeneuve d'Ascq è la sistemazione ideale per un weekend nel nord della Francia. A soli 15 km dall'aeroporto di Lille Lesquin, a 8 km dal centro storico di Lille e a 2 minuti a piedi dal LAM.\nViaggiate in tutta tranquillità, perché l'offerta del ristorante è sempre disponibile per soddisfare tutti gli appetiti con piatti tipici regionali."
    ],
    "fr": [
      "L’hôtel campanile de Villeneuve d’Ascq est l’hébergement idéal pour un weekend dans le Nord. A seulement 15Km de l’aéroport de Lille Lesquin à 8km du vieux Lille et à 2 minutes à pieds du LAM. \nVoyagez en toute tranquillité, une offre de restauration est toujours disponible pour combler tous les appétits avec des plats typiques de la région."
    ],
    "nl": [
      "Het campanile hotel in Villeneuve d'Ascq is de ideale accommodatie voor een weekend in het noorden van Frankrijk. Op slechts 15 km van de luchthaven Lille Lesquin, op 8 km van de oude binnenstad van Lille en op 2 minuten lopen van de LAM.\nReis met een gerust hart, want het restaurantaanbod is altijd beschikbaar om alle honger te stillen met typische streekgerechten."
    ],
    "es": [
      "El hotel campanile de Villeneuve d'Ascq es el alojamiento ideal para un fin de semana en el norte de Francia. A sólo 15 km del aeropuerto de Lille Lesquin, a 8 km del casco antiguo de Lille y a 2 minutos a pie del LAM.\nViaje con tranquilidad, ya que la oferta de restauración está siempre disponible para satisfacer todos los apetitos con platos típicos de la región."
    ]
  },
