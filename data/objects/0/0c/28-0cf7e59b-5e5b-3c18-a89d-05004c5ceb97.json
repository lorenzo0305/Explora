  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7e187c12-cf0b-3fc0-bd15-a8ff9c70cf4a",
      "dc:description": {
        "de": [
          "L'Incontournable ist der Name einer neuen Bar in der Rue de la Poste in Valenciennes.Biere, Cocktails, Weine, Wurstwaren, Terrinen Gesellschaftsspiele, Tischfußball, Darts, Billard. Geöffnet von Dienstag bis Samstag ab 17:15 Uhr."
        ],
        "en": [
          "L'Incontournable is the name of a new bar on rue de la Poste, in Valenciennes.beers, cocktails, wines sausages, terrines board games, table soccer, darts, billiards. Open Tuesday to Saturday from 5.15pm."
        ],
        "it": [
          "L'Incontournable è il nome di un nuovo bar in rue de la Poste, a Valenciennes.Birre, cocktail, vini salsicce, terrine giochi da tavolo, calcio balilla, freccette, biliardo. Aperto dal martedì al sabato dalle 17.15."
        ],
        "fr": [
          "L'Incontournable est le nom d'un nouveau bar que l'on peut trouver rue de la Poste, à Valenciennes.Bières, cocktails, vins Saucissons, terrines Jeux de sociétés, baby-foot, fléchettes, billard. Ouvert du mardi au samedi dès 17h15."
        ],
        "nl": [
          "L'Incontournable is de naam van een nieuwe bar in de rue de la Poste, in Valenciennes.bieren, cocktails, wijnen worstjes, terrines bordspellen, tafelvoetbal, darts, biljart. Geopend van dinsdag tot zaterdag vanaf 17.15 uur."
        ],
        "es": [
          "L'Incontournable es el nombre de un nuevo bar de la calle de la Poste, en Valenciennes.Cervezas, cócteles, vinos embutidos, terrinas juegos de mesa, futbolín, dardos, billar. Abierto de martes a sábado a partir de las 17.15 h."
        ]
      },
      "@type": [
        "Description"
