  "rdfs:comment": {
    "de": [
      "Eine (Wieder-)Entdeckung des Vaudeville, eines Genres, das allzu oft als minderwertig bezeichnet wird, für eine Aufführung, die reich an Überraschungen und Wendungen ist."
    ],
    "en": [
      "A (re)discovery of vaudeville, a genre too often described as minor, in a show full of surprises and twists."
    ],
    "it": [
      "Una (ri)scoperta del vaudeville, un genere troppo spesso definito minore, in uno spettacolo ricco di sorprese e colpi di scena."
    ],
    "fr": [
      "Une (re)découverte du vaudeville, genre trop souvent qualifié de mineur, pour un spectacle riche en surprises et rebondissements."
    ],
    "es": [
      "Un (re)descubrimiento del vodevil, un género demasiado a menudo calificado de menor, en un espectáculo lleno de sorpresas y giros."
    ],
    "nl": [
      "Een (her)ontdekking van vaudeville, een genre dat te vaak als onbelangrijk wordt beschreven, in een show vol verrassingen en wendingen."
    ]
  },
