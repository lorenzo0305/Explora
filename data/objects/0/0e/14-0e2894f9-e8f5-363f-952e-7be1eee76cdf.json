  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a3aa9102-a55c-3984-94b9-992e275ac6da",
      "dc:description": {
        "de": [
          "Die Entdeckung der Zeitgalerie, des Parks, seiner Fauna und Flora ist ein Vorwand, um alle Geheimnisse der Yogis zu ergründen und einige von Bäumen oder Tieren inspirierte Körperhaltungen einzunehmen."
        ],
        "en": [
          "The discovery of the Gallery of Time, the park, its fauna and flora is a pretext to discover all the secrets of the yogis and to adopt some postures inspired by trees or animals."
        ],
        "it": [
          "La scoperta della Galerie du Temps, del parco e della sua flora e fauna è un pretesto per svelare tutti i segreti degli yogi e adottare alcune posture ispirate agli alberi e agli animali."
        ],
        "fr": [
          "La découverte de la Galerie du temps, du parc, de sa faune et de sa flore est un prétexte pour percer tous les secrets des yogis et adopter quelques postures inspirées des arbres ou des animaux."
        ],
        "es": [
          "El descubrimiento de la Galerie du Temps, del parque y de su flora y fauna es un pretexto para desvelar todos los secretos de los yoguis y adoptar algunas posturas inspiradas en árboles y animales."
        ],
        "nl": [
          "De ontdekking van de Galerie du Temps, het park en zijn flora en fauna is een voorwendsel om alle geheimen van de yogi's te ontsluieren en een paar houdingen aan te nemen die geïnspireerd zijn op bomen en dieren."
        ]
      },
