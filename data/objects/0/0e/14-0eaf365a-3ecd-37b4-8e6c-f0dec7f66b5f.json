  "rdfs:comment": {
    "de": [
      "20ème Rue Ouest versucht, dieses einzigartige Gefühl, das die Fotografie vermittelt, fortzusetzen, diese Körper, die uns anschauen und die wir anschauen."
    ],
    "en": [
      "20ème Rue Ouest seeks to perpetuate the singular emotion of photography, the bodies that look at us and that we look at."
    ],
    "it": [
      "20ème Rue Ouest cerca di perpetuare l'emozione unica della fotografia, i corpi che ci guardano e che noi guardiamo."
    ],
    "fr": [
      "20ème Rue Ouest cherche à perpétuer cette émotion singulière que procure la photographie, ces corps qui nous regardent et que nous regardons."
    ],
    "nl": [
      "20ème Rue Ouest wil de unieke emotie van fotografie vereeuwigen, de lichamen die naar ons kijken en waar wij naar kijken."
    ],
    "es": [
      "20ème Rue Ouest pretende perpetuar la emoción única de la fotografía, los cuerpos que nos miran y que miramos."
    ]
  },
