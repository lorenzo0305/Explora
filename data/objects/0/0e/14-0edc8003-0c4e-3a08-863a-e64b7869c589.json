      "dc:description": {
        "de": [
          "An einem Wochenende gilt für das Meeresmuseum der halbe Eintrittspreis. Die Führung steht unter dem Motto \"Hering\"."
        ],
        "en": [
          "For a weekend, admission to the Musée de la Mer is half-price. The guided tour focuses on the theme of herring."
        ],
        "it": [
          "Per un fine settimana, l'ingresso al Musée de la Mer è a metà prezzo. La visita guidata è incentrata sulle aringhe."
        ],
        "fr": [
          "Le temps d'un week-end, l'entrée du musée de la mer est demi-tarif. La visite guidée se fait sur le thème du hareng."
        ],
        "nl": [
          "Een weekend lang is de toegang tot het Musée de la Mer halve prijs. De rondleiding gaat over haring."
        ],
        "es": [
          "Durante un fin de semana, la entrada al Museo del Mar está a mitad de precio. La visita guiada se centra en el arenque."
        ]
      },
