  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/fe8f42db-5387-3e43-b9b6-32cf03375b11",
      "dc:description": {
        "de": [
          "Springreiterwettbewerbe Challenge Amateur ? Vorbereitung auf die Prüfung.\nReiterabend am Samstag.\nFreier Zugang ? kostenloser Eintritt.\n\nFREIER EINTRITT\n\n> STUNDENZEITEN <\n \n? RESTAURATION\nCatering vor Ort in der Orangerie de la Baie mit unserem Caterer RJ Events und bei Gorisse.\n \n? AUSSTELLER\nPräsenz unserer Aussteller CWD, G2S Photographe, Outlet Riding und Aire Jump.\nPierre Lagache Hufschmied vor Ort anwesend."
        ],
        "en": [
          "Amateur Challenge ? Preparatory classes.\nRider's evening on Saturday.\nFree access ? free entry.\n\nFREE ENTRY\n\n> HOURS <\n \n? RESTAURATION\nOn-site catering in the Orangerie de la Baie with our caterer RJ Events, and chez Gorisse.\n \n? EXHIBITORS\nOur exhibitors CWD, G2S Photographe, Outlet Riding and Aire Jump.\nPierre Lagache Maréchalerie on site."
        ],
        "it": [
          "Sfida amatoriale? Classi preparatorie.\nSerata per i cavalieri il sabato.\nAccesso libero? Ingresso libero.\n\nINGRESSO LIBERO\n\n> ORARIO <\n \n? RISTORAZIONE\nRistorazione in loco presso l'Orangerie de la Baie con il nostro catering RJ Events e a Gorisse.\n \n? ESPOSITORI\nI nostri espositori CWD, G2S Photographe, Outlet Riding e Aire Jump.\nPierre Lagache Maréchalerie sarà presente in loco."
        ],
        "fr": [
          "Concours de saut d'obstacles Challenge Amateur – Préparatoires.\nSoirée cavalière le samedi.\nAccès libre – entrée gratuite.\n\nENTREE LIBRE\n\n> HORAIRES <\n \n• RESTAURATION\nRestauration sur place dans l'Orangerie de la Baie avec notre traiteur RJ Events, et chez Gorisse.\n \n• EXPOSANTS\nPrésence de nos exposants CWD, G2S Photographe, Outlet Riding et Aire Jump.\nPierre Lagache Maréchalerie présent sur place."
        ],
        "es": [
          "Desafío para aficionados ? Clases preparatorias.\nVelada para jinetes el sábado.\nAcceso libre ? entrada gratuita.\n\nENTRADA GRATUITA\n\n> HORARIO <\n \n? RESTAURACIÓN\nRestauración in situ en la Orangerie de la Baie con nuestro catering RJ Events, y en Gorisse.\n \n? EXPOSITORES\nNuestros expositores CWD, G2S Photographe, Outlet Riding y Aire Jump.\nPierre Lagache Maréchalerie estará presente."
        ],
        "nl": [
          "Amateur Uitdaging ? Voorbereidende klassen.\nRuiteravond op zaterdag.\nGratis toegang?\n\nGRATIS TOEGANG\n\n> TIJDSCHEMA <\n \n? RESTAURATIE\nCatering ter plaatse in de Orangerie de la Baie met onze traiteur RJ Events, en in Gorisse.\n \n? EXPOSANTEN\nOnze exposanten CWD, G2S Photographe, Outlet Riding en Aire Jump.\nPierre Lagache Maréchalerie zal aanwezig zijn."
        ]
      },
