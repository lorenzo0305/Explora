  "rdfs:comment": {
    "de": [
      "Der Wald befindet sich auf dem Gemeindegebiet von Faumont und grenzt an seiner Südgrenze an den Wald von\nFlines-lez-Râches und an seiner Nordgrenze an das Naturgebiet Argilière (Gemeindegebiet)."
    ],
    "en": [
      "Located on the Faumont municipal territory, the wood is contiguous on its southern boundary with the Bois de\nFlines-lez-Râches and on its northern boundary to the Argilière nature reserve (communal area)."
    ],
    "it": [
      "Situato nel comune di Faumont, il bosco confina a sud con il Bois de Flines-lez-Râches e a nord con la riserva naturale dell'Argilière (area comunale)\nBosco di Flines-lez-Râches e al confine settentrionale con la riserva naturale dell'Argilière (area comunale)."
    ],
    "fr": [
      "Situé sur le territoire communal de Faumont, le bois est contigu sur sa limite Sud au Bois de \nFlines-lez-Râches et sur sa limite Nord à la zone naturelle de l’Argilière (espace communal)."
    ],
    "es": [
      "Situado en el municipio de Faumont, el bosque limita al sur con el bosque de Flines-lez-Râches y al norte con la reserva natural de Argilière (zona comunal)\nBosque de Flines-lez-Râches y en su límite norte con la reserva natural de Argilière (zona comunal)."
    ],
    "nl": [
      "Het bos ligt in de gemeente Faumont en grenst in het zuiden aan het bos van Flines-lez-Râches en in het noorden aan het natuurreservaat van Argilière (gemeentelijk gebied)\nHet bos van Flines-lez-Râches en zijn noordelijke grens met het natuurreservaat van Argilière (gemeentelijk gebied)."
    ]
  },
  "rdfs:label": {
