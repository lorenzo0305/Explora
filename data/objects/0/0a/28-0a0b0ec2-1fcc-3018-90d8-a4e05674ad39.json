  "rdfs:comment": {
    "de": [
      "Das Restaurant bietet Ihnen eine große Auswahl an hausgemachten Gerichten aus lokalen Produkten. Auch die Desserts werden vor Ort sorgfältig zubereitet. Jeden Tag wird Ihnen ein neues Menü angeboten."
    ],
    "en": [
      "The restaurant offers a wide choice of home-made dishes with local products. Desserts are also carefully prepared on site. Every day, a new menu will be proposed to you."
    ],
    "it": [
      "Il ristorante offre una vasta gamma di piatti fatti in casa con prodotti locali. Anche i dessert sono preparati con cura in loco. Ogni giorno viene proposto un nuovo menu."
    ],
    "fr": [
      "Le restaurant vous propose un large choix de plats faits maison avec des produits locaux. Les desserts sont également préparés avec soin sur place. Tous les jours, un nouveau menu vous sera proposé."
    ],
    "nl": [
      "Het restaurant biedt een breed scala aan huisgemaakte gerechten, gemaakt met lokale producten. Desserts worden ook zorgvuldig ter plaatse bereid. Elke dag wordt een nieuw menu aangeboden."
    ],
    "es": [
      "El restaurante ofrece una amplia gama de platos caseros elaborados con productos locales. Los postres también se preparan cuidadosamente in situ. Cada día se ofrecerá un nuevo menú."
    ]
  },
