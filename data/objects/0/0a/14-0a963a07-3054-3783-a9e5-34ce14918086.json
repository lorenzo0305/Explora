  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a5799f8a-86ea-3cc6-b5f7-6d200e1380d2",
      "dc:description": {
        "de": [
          "Entdecken Sie den Betrieb von Benoît Randoux, der Bio-Produkte anbietet: Rindfleisch, Ziegenkäse.\nle +: Diese Naturjoghurts, die auf der Landwirtschaftsmesse mit einer Bronzemedaille ausgezeichnet wurden!"
        ],
        "en": [
          "Discover Benoît Randoux's organic beef and goat cheese farm.\nthe +: These natural yogurts won a bronze medal at the Salon de l'agriculture!"
        ],
        "it": [
          "Scoprite l'allevamento di manzo e di formaggio di capra biologici di Benoît Randoux.\nin più: questi yogurt semplici hanno vinto una medaglia di bronzo al Salon de l'agriculture!"
        ],
        "fr": [
          "Découvrez l'exploitation de Benoît Randoux qui propose des produits bio : viande bovine, fromage de chèvre.\nle + : Ces yaourts nature qui ont été récompensés par une médaille de bronze au Salon de l'agriculture !"
        ],
        "nl": [
          "Ontdek de boerderij met biologisch rundvlees en geitenkaas van Benoît Randoux.\nplus: Deze gewone yoghurt won een bronzen medaille op de Salon de l'agriculture!"
        ],
        "es": [
          "Descubra la granja de ternera ecológica y queso de cabra de Benoît Randoux.\nademás: ¡estos yogures naturales ganaron una medalla de bronce en el Salón de la Agricultura!"
        ]
      },
      "@type": [
        "Description"
      ],
