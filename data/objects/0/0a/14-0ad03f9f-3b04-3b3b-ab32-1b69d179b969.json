      "dc:description": {
        "de": [
          "Kinder und Jugendliche können unter Anleitung eines staatlich geprüften Lehrers auf einem gesicherten Parcours erste Erfahrungen sammeln."
        ],
        "en": [
          "Children and teenagers can try their hand at a safe, specially-designed course, supervised by a state-qualified instructor."
        ],
        "it": [
          "I bambini e gli adolescenti possono cimentarsi in un percorso sicuro e appositamente progettato, sotto la supervisione di un istruttore qualificato dallo Stato."
        ],
        "fr": [
          "Enfants et ados de s’initient sur un parcours aménagé et sécurisé, encadrés par un moniteur diplômé d’état."
        ],
        "es": [
          "Niños y adolescentes pueden probar suerte en un circuito seguro, especialmente diseñado y supervisado por un instructor cualificado por el Estado."
        ],
        "nl": [
          "Kinderen en tieners kunnen het proberen op een veilige, speciaal ontworpen cursus onder toezicht van een gediplomeerde instructeur."
        ]
      },
