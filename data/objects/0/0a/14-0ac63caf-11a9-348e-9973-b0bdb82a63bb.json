  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/45bf7946-0939-3c7b-bc69-2bc6d5320454",
      "dc:description": {
        "de": [
          "Die AH Haute Ville d'Etaples-sur-mer organisiert das berühmte Lottospiel.\nVerbringen Sie eine schöne Zeit mit der Familie oder mit Freunden und versuchen Sie, schöne Preise zu gewinnen."
        ],
        "en": [
          "The AH Haute Ville d'Etaples-sur-mer organizes the famous lotto game.\nCome and have a good time with family and friends, and try to win some great prizes."
        ],
        "it": [
          "L'AH Haute Ville d'Etaples-sur-mer organizza il famoso gioco del lotto.\nVenite a divertirvi con la vostra famiglia o i vostri amici e provate a vincere dei fantastici premi."
        ],
        "fr": [
          "L'AH Haute Ville d'Etaples-sur-mer organise le célèbre jeu de loto.\nVenez passer un bon moment en famille ou entre amis pour tenter de remporter de jolis lots."
        ],
        "es": [
          "El AH Haute Ville d'Etaples-sur-mer organiza el famoso juego de la lotería.\nVenga a pasar un buen rato con su familia o amigos e intente ganar magníficos premios."
        ],
        "nl": [
          "De AH Haute Ville d'Etaples-sur-mer organiseert het beroemde lottospel.\nKom gezellig langs met je familie of vrienden en probeer mooie prijzen te winnen."
        ]
      },
