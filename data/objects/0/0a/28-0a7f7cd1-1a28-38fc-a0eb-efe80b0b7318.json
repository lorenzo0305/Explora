  "rdfs:comment": {
    "de": [
      "Entdecken Sie das Programm des Museums der Schönen Künste in Valenciennes, das während der Renovierung aufrechterhalten wird, auf unserer Website und in sozialen Netzwerken. Geplante Wiedereröffnung Ende 2026."
    ],
    "en": [
      "Discover the program of the Musée des Beaux-Arts de Valenciennes, maintained during its renovation, on our website and social networks. Reopening scheduled for late 2026."
    ],
    "it": [
      "Per saperne di più sul programma del Musée des Beaux-Arts de Valenciennes, che sarà mantenuto durante la sua ristrutturazione, consultate il nostro sito web e i social network. La riapertura del museo è prevista per la fine del 2026."
    ],
    "fr": [
      "Découvrez la programmation du musée des Beaux-Arts de Valenciennes, maintenue durant sa rénovation, sur notre site et réseaux sociaux. Réouverture prévue fin 2026."
    ],
    "nl": [
      "Ontdek meer over het programma van het Musée des Beaux-Arts de Valenciennes, dat tijdens de renovatie behouden blijft, op onze website en sociale netwerken. De heropening van het museum is gepland voor eind 2026."
    ],
    "es": [
      "Obtenga más información sobre el programa del Museo de Bellas Artes de Valenciennes, que se mantendrá durante su renovación, en nuestro sitio web y redes sociales. La reapertura del museo está prevista para finales de 2026."
    ]
  },
