  "rdfs:comment": {
    "de": [
      "Der beste Ort, um den Sonnenuntergang am Strand von Le Crotoy zu bewundern, der nach Süden ausgerichtet ist! Eine Strandbar mit entspannter Atmosphäre, perfekt für einen Drink und ein Aperitif-Brett mit (fast) den Füßen im Sand!"
    ],
    "en": [
      "The best spot to admire the sunset on the south-facing beach of Le Crotoy! A beach bar with a relaxed atmosphere, perfect for sipping a drink and sharing an aperitif with your feet (almost) in the sand!"
    ],
    "it": [
      "Il posto migliore per ammirare il tramonto sulla spiaggia di Le Crotoy, esposta a sud! Un bar sulla spiaggia dall'atmosfera rilassata, perfetto per sorseggiare un drink e condividere un aperitivo con i piedi (quasi) nella sabbia!"
    ],
    "fr": [
      "Le meilleur spot pour admirer le coucher de soleil sur la plage du Crotoy, exposée plein sud ! Un bar de plage à l’ambiance décontractée, parfait pour siroter un verre et partager une planche apéro les pieds (presque) dans le sable !"
    ],
    "es": [
      "El mejor lugar para contemplar la puesta de sol en la playa de Le Crotoy, orientada al sur Un chiringuito de ambiente relajado, perfecto para tomar una copa y compartir un aperitivo con los pies (casi) en la arena"
    ],
    "nl": [
      "De beste plek om de zon onder te zien gaan op het zuidelijke strand van Le Crotoy! Een strandbar met een ontspannen sfeer, perfect om te nippen van een drankje en een aperitief te delen met je voeten (bijna) in het zand!"
    ]
  },
  "rdfs:label": {
    "fr": [
      "L'Ancrage Bar de Plage au Crotoy"
    ]
  },
