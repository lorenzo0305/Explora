  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/76baca10-8a63-3945-86b2-c2cf75d2624b",
      "dc:description": {
        "de": [
          "Treffen Sie sich diesen Samstag auf dem Campingplatz La Sensation zu einem Abend mit Show-Essen\nKommen Sie, um zu singen, zu tanzen und sich zu amüsieren! Als Belohnung gibt es Geschenke!"
        ],
        "en": [
          "Rendezvous this Saturday at Camping La Sensation for an evening of dinner and entertainment\nCome sing, dance and have fun! Giveaways!"
        ],
        "it": [
          "Unitevi a noi questo sabato al Camping La Sensation per una serata di intrattenimento dal vivo e cibo\nVenite a cantare, ballare e divertirvi! Metteremo in palio dei premi!"
        ],
        "fr": [
          "Rendez-vous ce samedi au Camping La Sensation pour une soirée repas spectacle\nVenez chanter, danser et vous s'amuser ! En distribution, des cadeaux !"
        ],
        "es": [
          "Únete a nosotros este sábado en el Camping La Sensation para una noche de entretenimiento en vivo y comida\n¡Ven a cantar, bailar y divertirte! ¡Regalaremos premios!"
        ],
        "nl": [
          "Kom deze zaterdag naar Camping La Sensation voor een avond vol live entertainment en eten\nKom zingen, dansen en plezier maken! We geven prijzen weg!"
        ]
      },
