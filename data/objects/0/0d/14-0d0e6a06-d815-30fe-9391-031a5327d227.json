  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0f7868ae-0eb4-3bf0-b3b7-a337b98d8801",
      "dc:description": {
        "de": [
          "Baby Gym von Sport Anim\n\nVon 0 bis 4 Jahren\n\nSalon Escoffier\n\nBeschreibung : Motorik-Parcours, kleine Spiele etc. Ihre kleinen Loulous werden begeistert sein! Eine Begleitperson muss anwesend sein. 5 Euro pro Kind. Anmeldungen sind unbedingt erforderlich beim Fremdenverkehrsamt: 03 21 83 51 02."
        ],
        "en": [
          "Baby Gym by Sport Anim\n\nFrom 0 to 4 years\n\nSalon Escoffier\n\nDescription: Motor skills course, little games, etc. Your little ones will love it! Accompanying adult essential. 5/child. Registration essential at the Tourist Information Office: 03 21 83 51 02."
        ],
        "it": [
          "Palestra per bambini di Sport Anim\n\nDa 0 a 4 anni\n\nSalone Escoffier\n\nDescrizione: Corso di motricità, piccoli giochi, ecc. I vostri piccoli lo adoreranno! Devono essere accompagnati da un adulto. 5 a bambino. Iscrizione obbligatoria presso l'Ufficio informazioni turistiche: 03 21 83 51 02."
        ],
        "fr": [
          "Baby Gym par Sport Anim\n\nDe 0 à 4 ans\n\nSalon Escoffier\n\nDescriptif : Parcours motricité, petits jeux, etc. Vos petits loulous vont adorer ! Présence indispensable d’un accompagnateur. 5€/enfant. Inscriptions indispensables au Bureau d’Information Touristique : 03 21 83 51 02."
        ],
        "es": [
          "Gimnasio para bebés de Sport Anim\n\nDe 0 a 4 años\n\nSalón Escoffier\n\nDescripción: Curso de motricidad, pequeños juegos, etc. ¡A tus pequeños les encantará! Deben ir acompañados de un adulto. 5 por niño. Imprescindible inscribirse en la Oficina de Turismo: 03 21 83 51 02."
        ],
        "nl": [
          "Baby Gym van Sport Anim\n\nVan 0 tot 4 jaar\n\nSalon Escoffier\n\nOmschrijving: Cursus motorische vaardigheden, kleine spelletjes, enz. Uw kleintjes zullen het geweldig vinden! Moet worden begeleid door een volwassene. 5 per kind. Inschrijving verplicht bij het VVV-kantoor: 03 21 83 51 02."
        ]
      },
