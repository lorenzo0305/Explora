  "rdfs:comment": {
    "de": [
      "Die Lounge-Bar der Auberge du Jeu de Paume 5* - Relais & Château in Chantilly bietet Ihnen regelmäßig Live-Jazz-Sessions an.\nIn verschiedenen Besetzungen (Gitarren-/Gesangsduo, jazziges Trio oder Gypsy-Jazz) können Sie einen Afterwork-Abend, einen Abend zu zweit oder einen Drink mit Freunden genießen"
    ],
    "en": [
      "The lounge bar at the Auberge du Jeu de Paume 5* - Relais & Château in Chantilly regularly hosts live jazz sessions.\nIn a variety of formations (guitar/voice duo, jazzy trio or gypsy jazz), enjoy an afterwork session, an evening for two or a drink with friends"
    ],
    "it": [
      "Il lounge bar dell'Auberge du Jeu de Paume 5* - Relais & Château di Chantilly ospita regolarmente sessioni di jazz dal vivo.\nIn una varietà di formazioni (duo chitarra/voce, trio jazz o gypsy jazz), godetevi un dopo lavoro, una serata a due o un drink con gli amici"
    ],
    "fr": [
      "Le lounge bar de l'Auberge du Jeu de Paume 5* - Relais & Château à Chantilly, vous propose régulièrement des soirées \"live sessions Jazz\". \nSelon différentes formations (duo guitare/voix, trio jazzy ou jazz manouche), savourez un afterwork, une soirée à deux ou un verre entre amis"
    ],
    "nl": [
      "In de loungebar van de Auberge du Jeu de Paume 5* - Relais & Château in Chantilly vinden regelmatig live jazzsessies plaats.\nIn verschillende formaties (gitaar/stem duo, jazzy trio of gypsy jazz), geniet je van een afterwork sessie, een avond voor twee of een drankje met vrienden"
    ],
    "es": [
      "El bar salón del Auberge du Jeu de Paume 5* - Relais & Château de Chantilly acoge regularmente sesiones de jazz en directo.\nEn diversas formaciones (dúo guitarra/voz, trío jazzístico o jazz gitano), disfrute de una sesión afterwork, de una velada para dos o de una copa con los amigos"
    ]
  },
  "rdfs:label": {
    "fr": [
      "Soirée Jazz au bar de l'Auberge du Jeu de Paume à Chantilly"
    ]
  },
