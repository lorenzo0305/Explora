  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dbc6a6c8-a7ec-38a9-8538-589216b7eb7e",
      "dc:description": {
        "de": [
          "Geführte Tour : Pierre-André Dufetel, Architekt von Damrémont\n\nDauer: 2 Std. ? begrenzte Teilnehmerzahl ? auf Anmeldung\n\nEntdeckung des Viertels Damrémont und der Bauwerke von Dufetel (1960er Jahre). Bevorzugter Zugang zu bestimmten Orten."
        ],
        "en": [
          "Guided tour : Pierre-André Dufetel, architect of Damrémont\n\nDuration: 2 hours ? limited number of participants ? registration required\n\nDiscover the Damrémont district and Dufetel's achievements (1960s). Special access to certain areas."
        ],
        "it": [
          "Visita guidata : Pierre-André Dufetel, architetto di Damrémont\n\nDurata: 2 ore ? capacità limitata ? è richiesta la registrazione\n\nScoprite il quartiere di Damrémont e l'opera di Dufetel (anni '60). Accesso speciale ad alcune aree."
        ],
        "fr": [
          "Circuit guidé : Pierre-André Dufetel, architecte de Damrémont\n\nDurée : 2h – jauge limitée – sur inscription\n\nDécouverte du quartier Damrémont et des réalisations de Dufetel (années 1960). Accès privilégié à certains lieux."
        ],
        "es": [
          "Visita guiada : Pierre-André Dufetel, arquitecto de Damrémont\n\nDuración: 2 horas ? aforo limitado ? inscripción obligatoria\n\nDescubra el barrio de Damrémont y la obra de Dufetel (años 60). Acceso especial a determinadas zonas."
        ],
        "nl": [
          "Rondleiding : Pierre-André Dufetel, architect van Damrémont\n\nDuur: 2 uur ? beperkte capaciteit ? inschrijven verplicht\n\nOntdek de wijk Damrémont en het werk van Dufetel (jaren 1960). Speciale toegang tot bepaalde zones."
        ]
      },
