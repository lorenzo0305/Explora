  "rdfs:comment": {
    "de": [
      "TSN organisiert die Märchen- und Legendenrallye 2026 am Sonntag, den 10. Mai, von Autreppes aus. Ein geselliger Tag mit spielerischen Wanderungen, Rätseln, Minispielen und einer Kanufahrt rund um die Legende der alten Weide. Für Verpflegung, Snacks und eine Tombola ist ebenfalls gesorgt."
    ],
    "en": [
      "TSN is organizing the Rallye des Contes et Légendes 2026 on Sunday, May 10, departing from Autreppes. A fun-filled day of hiking, puzzles, mini-games and canoeing around La Légende du vieux saule. There will also be refreshments, a snack bar and a tombola."
    ],
    "it": [
      "Il TSN organizza il Rallye des Contes et Légendes 2026 domenica 10 maggio, con partenza da Autreppes. Sarà una giornata all'insegna del divertimento con escursioni, enigmi, mini-giochi e canoa intorno alla Leggenda del Vecchio Salice. Ci saranno anche rinfreschi, uno snack bar e una tombola."
    ],
    "fr": [
      "TSN organise le Rallye des Contes et Légendes 2026 le dimanche 10 mai au départ d’Autreppes. Une journée conviviale avec randonnée ludique, énigmes, mini-jeux et descente en canoë autour de La Légende du vieux saule. Ravitaillement, restauration avec le snack et tombola seront aussi au rendez-vous."
    ],
    "es": [
      "TSN organiza el Rallye des Contes et Légendes 2026 el domingo 10 de mayo, con salida en Autreppes. Será una jornada lúdica de senderismo, rompecabezas, minijuegos y piragüismo en torno a la Leyenda del Viejo Sauce. También habrá refrescos, un snack bar y una tómbola."
    ],
    "nl": [
      "TSN organiseert de Rallye des Contes et Légendes 2026 op zondag 10 mei, met vertrek in Autreppes. Het wordt een leuke dag vol wandelingen, puzzels, minigames en kanotochten rond de Legende van de Oude Wilg. Er zijn ook versnaperingen, een snackbar en een tombola."
    ]
  },
