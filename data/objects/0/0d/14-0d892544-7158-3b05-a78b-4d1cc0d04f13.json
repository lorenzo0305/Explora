  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/23d3ce31-78c4-3296-ae57-691935d0ef9b",
      "dc:description": {
        "de": [
          "Praktikum für Fortgeschrittene\nFür Kinder ab 5 Jahren\nOffener Lehrgang für Lizenzinhaber und Nicht-Lizenzinhaber, mit Schwerpunkt auf technischem Fortschritt und Spielfreude, organisiert vom TAC Hockey, im Champ des Sports, Feld Eric Choteau"
        ],
        "en": [
          "Advanced course\nFor children aged 5 and over\nCourse open to members and non-members, focusing on technical progress and enjoyment of the game, organized by TAC Hockey, at Champ des Sports, Eric Choteau field"
        ],
        "it": [
          "Corso avanzato\nPer bambini dai 5 anni in su\nCorso aperto a soci e non soci, incentrato sui progressi tecnici e sul piacere del gioco, organizzato da TAC Hockey, presso il campo Champ des Sports, Eric Choteau"
        ],
        "fr": [
          "Stage de perfectionnement\nPour les enfants à partir de 5 ans\nStage ouvert aux licenciés et non-licenciés, axé sur la progression technique et le plaisir de jeu, organisé par le TAC Hockey, au Champ des Sports, terrain Eric Choteau"
        ],
        "nl": [
          "Cursus voor gevorderden\nVoor kinderen vanaf 5 jaar\nCursus voor leden en niet-leden, gericht op technische vooruitgang en plezier in het spel, georganiseerd door TAC Hockey, op het veld Champ des Sports, Eric Choteau"
        ],
        "es": [
          "Curso avanzado\nPara niños a partir de 5 años\nCurso abierto a socios y no socios, centrado en el progreso técnico y el disfrute del juego, organizado por el TAC Hockey, en el Champ des Sports, campo Eric Choteau"
        ]
      },
