  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f3da3f32-3406-35e6-b9d7-14bf0040edee",
      "dc:description": {
        "de": [
          "Der Duft von frischem Brot empfängt Sie, sobald Sie die Schwelle unserer Bäckerei überschreiten. Lassen Sie sich von unseren Kreationen verführen, vom rustikalen Landbrot bis hin zu Gebäck"
        ],
        "en": [
          "The aroma of freshly baked bread greets you as you enter our bakery. Let yourself be tempted by our creations, from rustic farmhouse bread to pastries"
        ],
        "it": [
          "L'aroma del pane fresco vi accoglie non appena entrate nella nostra panetteria. Lasciatevi tentare dalle nostre creazioni, dal pane rustico di fattoria ai pasticcini"
        ],
        "fr": [
          "Le parfum du pain frais vous accueille dès le seuil de notre boulangerie. Laissez-vous tenter par nos créations, du pain de campagne rustique aux pâtisseries"
        ],
        "es": [
          "El aroma a pan fresco le recibe nada más entrar en nuestra panadería. Déjese tentar por nuestras creaciones, desde pan rústico de granja hasta bollería"
        ],
        "nl": [
          "De geur van vers brood begroet je zodra je onze bakkerij binnenkomt. Laat je verleiden door onze creaties, van rustiek boerenbrood tot gebak"
        ]
      },
      "@type": [
        "Description"
