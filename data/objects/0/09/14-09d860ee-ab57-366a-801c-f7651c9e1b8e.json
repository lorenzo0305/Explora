  "rdfs:comment": {
    "de": [
      "Erforschen Sie die klimatischen Herausforderungen und entdecken Sie auf spielerische Weise die Auswirkungen unserer täglichen Handlungen!"
    ],
    "en": [
      "Explore the challenges of climate change and discover, in a playful way, the impact of our everyday actions!"
    ],
