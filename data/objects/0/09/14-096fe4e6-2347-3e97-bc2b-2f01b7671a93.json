  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/98860519-d085-3157-8555-e8c46ff6b344",
      "dc:description": {
        "de": [
          "Gewehrschießen von 10:00 bis 18:00 Uhr.\nTag der offenen Tür, Einführung in das Schießen mit dem Luftgewehr und der Luftpistole.\nWettbewerbe für alle offen.\nTreffpunkt: Rue du Bosquet in Camiers.\nPreis für die Teilnahme am Wettbewerb: 6 Euro."
        ],
        "en": [
          "Rifle shooting from 10 am to 6 pm.\nOpen house, introduction to rifle and pellet pistol shooting.\nCompetitions open to all.\nMeeting point rue du Bosquet, Camiers.\nEntry fee: 6 euros."
        ],
        "it": [
          "Tiro al fucile dalle 10.00 alle 18.00.\nApertura, introduzione al tiro con carabina e pistola a pallini.\nGare aperte a tutti.\nPunto d'incontro rue du Bosquet a Camiers.\nQuota di iscrizione alla gara: 6 euro."
        ],
        "fr": [
          "Tir à la carabine de 10h à 18h. \nPortes ouvertes, initiation au tir à la carabine et pistolet à plomb. \nConcours ouverts à tous. \nRendez-vous rue du Bosquet à Camiers. \nTarif participation au concours : 6 euros."
        ],
        "es": [
          "Tiro con rifle de 10.00 a 18.00 h.\nJornada de puertas abiertas, iniciación al tiro con rifle y pistola de perdigones.\nCompeticiones abiertas a todos.\nPunto de encuentro rue du Bosquet en Camiers.\nPrecio de la inscripción a la competición: 6 euros."
        ],
        "nl": [
          "Geweerschieten van 10 tot 18 uur.\nOpen huis, kennismaking met geweer- en pistoolschieten.\nWedstrijden open voor iedereen.\nTrefpunt rue du Bosquet in Camiers.\nInschrijfgeld voor de wedstrijd: 6 euro."
        ]
      },
      "@type": [
        "Description"
      ],
