  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/5ff55286-8bdd-3293-a645-07c5716b4afa",
      "dc:description": {
        "de": [
          "Sehen Sie ihnen bei der Arbeit zu, tauschen Sie sich mit ihnen aus, entdecken Sie die Geheimnisse der Malerei...  Lassen Sie sich von Mini-Workshops in einer freundlichen Atmosphäre verführen!"
        ],
        "en": [
          "Watch them at work, chat with them and discover the secrets of painting...  Let yourself be tempted by mini-introductory workshops in a friendly atmosphere!"
        ],
        "it": [
          "Osservateli al lavoro, chiacchierate con loro e scoprite i segreti della pittura...  Lasciatevi tentare da mini workshop introduttivi in un'atmosfera amichevole!"
        ],
        "fr": [
          "Observez-les à l’œuvre, échangez avec eux, découvrez les secrets de la peinture...  Laissez-vous tenter par des mini-ateliers d’initiation dans une ambiance conviviale !"
        ],
        "es": [
          "Obsérvelos trabajar, charle con ellos y descubra los secretos de la pintura...  Déjese tentar por minitalleres introductorios en un ambiente acogedor"
        ],
        "nl": [
          "Bekijk ze aan het werk, praat met ze en ontdek de geheimen van het schilderen...  Laat je verleiden door mini-inleidende workshops in een gezellige sfeer!"
        ]
      },
