  "rdfs:comment": {
    "de": [
      "Auf der Terrasse des Maison de la Mémoire im Jardin Public von Liévin laden die Malerlehrlinge des Ateliers Renoir Sie zu einer künstlerischen Demonstration rund um Themen ein, die von der Natur inspiriert sind."
    ],
    "en": [
      "On the terrace of the Maison de la Mémoire in Liévin?s Jardin Public, apprentice painters from the Atelier Renoir invite you to an artistic demonstration on themes inspired by nature."
    ],
    "it": [
      "Sulla terrazza della Maison de la Mémoire nel Jardin Public di Liévin, gli apprendisti pittori dell'Atelier Renoir vi invitano a una dimostrazione artistica basata su temi ispirati alla natura."
    ],
    "fr": [
      "Sur la terrasse de la Maison de la Mémoire au Jardin Public de Liévin, les apprentis peintres de l’Atelier Renoir vous invitent à une démonstration artistique, autour de thèmes inspirés par la nature."
    ],
    "nl": [
      "Op het terras van het Maison de la Mémoire in de Jardin Public van Liévin nodigen leerling-schilders van het Atelier Renoir u uit voor een artistieke demonstratie, gebaseerd op thema's geïnspireerd door de natuur."
    ],
    "es": [
      "En la terraza de la Maison de la Mémoire, en el Jardin Public de Liévin, los aprendices de pintor del Atelier Renoir le invitan a una demostración artística, basada en temas inspirados en la naturaleza."
    ]
  },
  "rdfs:label": {
    "fr": [
