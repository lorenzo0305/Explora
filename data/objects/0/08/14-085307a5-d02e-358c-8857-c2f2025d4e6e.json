  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3a864030-53da-3730-8a71-3a38f623207b",
      "dc:description": {
        "de": [
          "Traditionelle, vietnamesische Kampfkünste, Selbstverteidigung, Kampf, Fuß- und Fausttechniken.\n\nJugendabteilung 8 -18: Donnerstag 18.00-19.00 Uhr - Samstag 14.30-15.30 Uhr\n\nFrauenabteilung Erwachsene: Donnerstag: 19.00-20.00 Uhr - Samstag: 15.30-16.30 Uhr"
        ],
        "en": [
          "Traditional Vietnamese martial arts, self-defense, combat, fist-fighting techniques.\n\nYouth section 8 -18: Thursday 6.00 pm - 7.00 pm - Saturday 2.30 pm - 3.30 pm\n\nAdult women's section: Thursday: 7.00-8.00 pm - Saturday: 3.30-4.30 pm"
        ],
        "it": [
          "Arti marziali tradizionali vietnamite, autodifesa, combattimento, tecniche di lotta.\n\nSezione giovani 8-18: giovedì 18.00-19.00 - sabato 14.30-15.30\n\nSezione femminile adulti: giovedì: 19.00-20.00 - sabato: 15.30-16.30"
        ],
        "fr": [
          "Arts martiaux traditionnels, vietnamiens, self-défense, combat, techniques pieds-poings.\n\nSection jeunes 8 -18 : Jeudi 18h00-19h00 - Samedi 14h30-15h30\n\nSection féminine adulte : Jeudi : 19h00-20h00 - Samedi : 15h30-16h30"
        ],
        "nl": [
          "Traditionele Vietnamese vechtkunst, zelfverdediging, gevechts- en vuistvechttechnieken.\n\nJeugdafdeling 8-18: donderdag 18.00-19.00 - zaterdag 14.30-3.30\n\nVolwassen vrouwen: donderdag: 19.00-20.00 - zaterdag: 15.30-4.30"
        ],
        "es": [
          "Artes marciales tradicionales vietnamitas, defensa personal, combate, técnicas de lucha con los puños.\n\nSección para jóvenes de 8 a 18 años: jueves de 18.00 a 19.00 y sábados de 14.30 a 15.30\n\nSección femenina adulta: jueves de 19.00 a 20.00 h. y sábados de 15.30 a 16.30 h"
        ]
      },
