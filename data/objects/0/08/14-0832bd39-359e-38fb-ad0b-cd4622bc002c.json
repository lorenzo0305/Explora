  "rdfs:comment": {
    "de": [
      "Im Rahmen der Ausstellung \"Champollion. Der Weg der Hieroglyphen\" laden Sie der Louvre-Lens und das Fremdenverkehrsamt ein, den Aperitif der Pharaonen zu teilen."
    ],
    "en": [
      "As part of the exhibition \"Champollion. La voie des hiéroglyphes\" exhibition, the Louvre-Lens and the tourist office invite you to share an apéro des pharaons."
    ],
    "it": [
      "Nell'ambito della mostra \"Champollion. La voie des hiéroglyphes\", il Louvre-Lens e l'Ufficio del Turismo vi invitano a condividere un aperitivo faraonico."
    ],
    "fr": [
      "Dans le cadre de l’exposition « Champollion. La voie des hiéroglyphes », le Louvre-Lens et l’office de tourisme vous invitent à partager l’apéro des pharaons."
    ],
    "nl": [
      "In het kader van de tentoonstelling \"Champollion. La voie des hiéroglyphes\" nodigen het Louvre-Lens en het Office du Tourisme je uit voor een aperitief van de farao."
    ],
    "es": [
      "En el marco de la exposición \"Champollion. La voie des hiéroglyphes\", el Louvre-Lens y la Oficina de Turismo le invitan a compartir un aperitivo faraónico."
    ]
  },
