  "rdfs:comment": {
    "de": [
      "Ausritte nach Schwierigkeitsgrad: 25?/1 Stunde\n-\tAnfänger: Lernen Sie die Grundlagen des Reitens, während Sie die Schönheit der Landschaft erkunden:\n-\tFortgeschrittene: Anspruchsvollere Herausforderungen auf Pfaden, die ihre Fähigkeiten auf die Probe stellen\n-\t20-minütige Ponyschnupperritte für die Kleinsten"
    ],
    "en": [
      "Horseback rides by level: 25?/1h00\n-\tBeginner: learn the basics of riding while exploring the beauty of the countryside :\n-\tAdvanced: more challenging rides on trails that test their skills\n-\t20-minute pony rides for the little ones"
    ],
    "it": [
      "Passeggiate a cavallo per livello: 25?/1h00\n-\tPrincipiante: imparare le basi dell'equitazione esplorando la bellezza della campagna:\n-\tAvanzato: sfide più stimolanti su percorsi che mettono alla prova le loro abilità\n-\tPasseggiate in pony di 20 minuti per i più piccoli"
    ],
    "fr": [
      "Randonnées à cheval par niveau : 25€/1h00\n-\tDébutant : apprendre les bases de l’équitation en explorant la beauté des paysages : \n-\tConfirmé : Défis plus stimulants sur des sentiers qui mettent à l’épreuve leurs compétences \n-\tBaptêmes à poney d’une durée de 20mn pour les plus petits"
    ],
    "es": [
      "Paseos a caballo por nivel: 25?/1h00\n-\tPrincipiante: aprenda los fundamentos de la equitación mientras explora la belleza del campo:\n-\tAvanzado: desafíos más estimulantes por senderos que ponen a prueba sus habilidades\n-\tPaseos en poni de 20 minutos para los más pequeños"
    ],
    "nl": [
      "Paardrijtochten per niveau: 25?/1h00\n-\tBeginner: Leer de basis van paardrijden terwijl je de schoonheid van het platteland verkent:\n-\tGevorderden: meer stimulerende uitdagingen op paden die hun vaardigheden op de proef stellen\n-\t20 minuten ponyrijden voor de kleintjes"
    ]
  },
