  "rdfs:comment": {
    "de": [
      "Lassen Sie sich vom Jardin du Beau Pays, einer wahren landschaftlichen Oase des Friedens, verzaubern.\nDieser private Garten, der mit einem Gütesiegel ausgezeichnet wurde und passionierten Besuchern offen steht, lädt zum Staunen und zur Gelassenheit ein."
    ],
    "en": [
      "Let yourself be charmed by the Jardin du Beau Pays, a veritable landscaped haven of peace.\nThis private garden, certified and open to enthusiastic visitors, is an invitation to wonder and serenity."
    ],
    "it": [
      "Lasciatevi incantare dal Jardin du Beau Pays, una vera e propria oasi di pace paesaggistica.\nQuesto giardino privato, certificato e aperto a visitatori entusiasti, è un invito alla meraviglia e alla serenità."
    ],
    "fr": [
      "Laissez-vous charmer par le Jardin du Beau Pays, un véritable havre de paix paysager.\nCe jardin privé, labellisé et ouvert aux visiteurs passionnés, est une invitation à l'émerveillement et à la sérénité."
    ],
    "nl": [
      "Laat je betoveren door de Jardin du Beau Pays, een ware oase van aangelegde rust.\nDeze privétuin, gecertificeerd en open voor enthousiaste bezoekers, nodigt uit tot verwondering en sereniteit."
    ],
    "es": [
      "Déjese seducir por el Jardin du Beau Pays, un auténtico remanso de paz paisajística.\nEste jardín privado, certificado y abierto a visitantes entusiastas, es una invitación al asombro y la serenidad."
    ]
  },
