  "rdfs:comment": {
    "de": [
      "Christian und Christophe bereiten Ihnen gute regionale Gerichte auf Bierbasis zu. Sie bieten Ihnen auch eine Brasserie-Karte an, damit Sie sich nach Ihren Spaziergängen stärken können."
    ],
    "en": [
      "Christian and Christophe concoct good regional dishes with beer. They also offer a brasserie menu to recharge your batteries after your walks."
    ],
    "it": [
      "Christian e Christophe vi cucineranno ottimi piatti regionali a base di birra. Offrono anche un menu da brasserie per ricaricarsi dopo le passeggiate."
    ],
    "fr": [
      "Christian et Christophe vous concoctent de bons plats régionaux à base de bière. Ils vous proposent aussi une carte brasserie pour vous ressourcer après vos balades."
    ],
    "es": [
      "Christian y Christophe te prepararán buenos platos regionales a base de cerveza. También ofrecen un menú de brasserie para reponer fuerzas después de las caminatas."
    ],
    "nl": [
      "Christian en Christophe koken voor u lekkere streekgerechten op basis van bier. Ze bieden ook een brasseriemenu om na uw wandelingen nieuwe energie op te doen."
    ]
  },
