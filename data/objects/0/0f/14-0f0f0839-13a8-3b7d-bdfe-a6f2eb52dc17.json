  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/1eb383a9-82a9-309f-8b51-8e3931797bbd",
      "dc:description": {
        "de": [
          "Die Balade des Sucres d'Orge (Zuckerstangenwanderung)\nVom 21. bis 24. Dezember 2024\nSamstag, 21. Dezember um 17 Uhr: DJ-Set \"Familial\"\nTäglich: Pistenspiel in Hardelot\n21., 22. und 23. Dezember von 16.00 bis 19.00 Uhr: Der Weihnachtsmann spaziert durch das Stadtzentrum von Hardelot\nDienstag, 24. Dezember, von 10 bis 12 Uhr: Fotos mit dem Weihnachtsmann am Eingang des Kinos"
        ],
        "en": [
          "The Barley Sugar Stroll\nDecember 21 to 24, 2024\nSaturday December 21 at 5pm: \"Family\" DJ Set\nEvery day: Piste game in Hardelot\nDecember 21, 22 and 23 from 4pm to 7pm: Santa Claus strolls through Hardelot town center\nTuesday, December 24 from 10am to 12pm: Photos with Santa at the entrance to the Cinema"
        ],
        "it": [
          "La passeggiata dello zucchero d'orzo\nDal 21 al 24 dicembre 2024\nSabato 21 dicembre alle ore 17.00: DJ Set \"Famiglia\"\nTutti i giorni: caccia al tesoro a Hardelot\n21, 22 e 23 dicembre dalle 16.00 alle 19.00: Babbo Natale passeggia nel centro di Hardelot\nMartedì 24 dicembre dalle 10.00 alle 12.00: foto con Babbo Natale all'ingresso del cinema"
        ],
        "fr": [
          "La Balade des Sucres d'Orge\nDu 21 au 24 décembre 2024\nSamedi 21 décembre à 17h : DJ Set \"Familial\"\nTous les jours : Jeu de Piste dans Hardelot\nLes 21, 22 et 23 décembre de 16h à 19h : Le père Noel se promène dans le centre ville d'Hardelot\nMardi 24 décembre de 10h à 12h : Photos avec le Père Noel à l'entrée du Cinéma"
        ],
        "es": [
          "Paseo del Azúcar de Cebada\nDel 21 al 24 de diciembre de 2024\nSábado 21 de diciembre a las 17:00: DJ Set \"Familiar\nTodos los días: Búsqueda del tesoro en Hardelot\n21, 22 y 23 de diciembre de 16:00 a 19:00 horas: Paseo de Papá Noel por el centro de Hardelot\nMartes 24 de diciembre de 10:00 a 12:00: Fotos con Papá Noel a la entrada del cine"
        ],
        "nl": [
          "De Gerstesuikerwandeling\nVan 21 tot 24 december 2024\nZaterdag 21 december om 17u: \"Familie\" DJ Set\nElke dag: Schattenjacht in Hardelot\n21, 22 en 23 december van 16 tot 19 uur: Kerstman wandelt door het centrum van Hardelot\nDinsdag 24 december van 10u tot 12u: Foto's met de kerstman aan de ingang van de bioscoop"
        ]
      },
