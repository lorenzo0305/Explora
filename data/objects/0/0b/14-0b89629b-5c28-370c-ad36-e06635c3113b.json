  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f3c8a380-98e1-3454-924c-54d3ea49efe6",
      "dc:description": {
        "de": [
          "Festival Popkultur, Manga, Serien, Kino, Ausstellungen, Konzerte, Show Récré A2 auf der Bühne, Master Class, Foto- und Autogrammstunden, Cosplay-Wettbewerb, Nonstop-Animation...\nWenn Sie ein Fan der 80er-Jahre-Serien, der TV-Titelmelodien, von Goldorak, Candy, Albator, Bibifoc und anderen Serien aus dieser Zeit sind, sollten Sie dieses außergewöhnliche Ereignis nicht verpassen."
        ],
        "en": [
          "Pop culture festival, manga, series, cinema, exhibitions, concerts, Récré A2 show on stage, master classes, photo and signing sessions, cosplay competitions, non-stop animation...\nIf you're a fan of 80s series, TV themes, Goldorak, Candy, Albator, Bibifoc and other series from the era, don't miss this exceptional event."
        ],
        "it": [
          "Festival della cultura pop, manga, serie, cinema, mostre, concerti, spettacolo di Récré A2 sul palco, masterclass, sessioni fotografiche e di autografi, gara di cosplay, intrattenimento non-stop...\nSe siete fan delle serie TV degli anni '80, delle sigle TV, di Goldorak, Candy, Albator, Bibifoc e di altre serie di quell'epoca, non perdetevi questo evento eccezionale."
        ],
        "fr": [
          "Festival Pop culture, manga, séries, cinéma, expositions, concerts, spectacle Récré A2 sur scène, master class, séances photos et dédicaces, concours cosplay, animation non stop...\nVous êtes fans des séries des années 80, des génériques télé, de Goldorak, Candy, Albator, Bibifoc et autres séries de l’époque ne manquez pas cet événement exceptionnel."
        ],
        "nl": [
          "Popcultuurfestival, manga, series, film, tentoonstellingen, concerten, Récré A2 show op het podium, masterclasses, foto- en signeersessies, cosplaywedstrijd, non-stop entertainment...\nAls je een fan bent van tv-series uit de jaren 80, tv-themasongs, Goldorak, Candy, Albator, Bibifoc en andere series uit die tijd, mag je dit uitzonderlijke evenement niet missen."
        ],
        "es": [
          "Festival de cultura pop, manga, series, cine, exposiciones, conciertos, espectáculo Récré A2 en el escenario, clases magistrales, sesiones de fotos y firmas, concurso de cosplay, diversión sin parar...\nSi eres fan de las series de los 80, de los temas de televisión, de Goldorak, Candy, Albator, Bibifoc y otras series de la época, no te pierdas este evento excepcional."
        ]
      },
