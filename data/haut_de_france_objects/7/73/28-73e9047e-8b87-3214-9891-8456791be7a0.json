  "rdfs:comment": {
    "de": [
      "Besuchen Sie die Abteikirche Saint-Nicolas in Saint-Leu-d'Esserent, ein Meisterwerk der Übergangskunst, jeden Sonntagnachmittag von Mai bis September!"
    ],
    "en": [
      "Come and discover the Abbatiale Saint-Nicolas in Saint-Leu-d'Esserent, a masterpiece of transitional art, every Sunday afternoon from May to September!"
    ],
    "it": [
      "Venite a scoprire l'Abbatiale Saint-Nicolas a Saint-Leu-d'Esserent, un capolavoro di arte di transizione, ogni domenica pomeriggio da maggio a settembre!"
    ],
    "fr": [
      "Venez découvrir l'Abbatiale Saint-Nicolas à Saint-Leu-d'Esserent, chef d'œuvre de l'art de transition, tous les dimanches après-midi de mai à septembre !"
    ],
    "es": [
      "Venga a descubrir la Abadía Saint-Nicolas de Saint-Leu-d'Esserent, obra maestra del arte de la transición, todos los domingos por la tarde de mayo a septiembre"
    ],
    "nl": [
      "Kom en ontdek de Abbatiale Saint-Nicolas in Saint-Leu-d'Esserent, een meesterwerk van overgangskunst, elke zondagmiddag van mei tot september!"
    ]
  },
