  "rdfs:comment": {
    "de": [
      "Empfang der Wanderer und Möglichkeit, ein Getränk zu sich zu nehmen. Das Café ist täglich ab 8:30 Uhr geöffnet. Abends wird es geschlossen, wenn keine Gäste mehr kommen."
    ],
    "en": [
      "Hikers welcome and drinks available. The café is open daily from 8:30 am. Closes in the evening when there are no customers."
    ],
    "it": [
      "Accogliamo gli escursionisti e offriamo un rinfresco. La caffetteria è aperta tutti i giorni dalle 8.30 del mattino. Chiude la sera quando non ci sono clienti."
    ],
    "fr": [
      "Accueil des randonneurs et possibilité de prendre une boisson. Le café est ouvert tous les jours dès 8h30. Fermeture le soir quand il n'y a plus de clients."
    ],
    "nl": [
      "We verwelkomen wandelaars en bieden verfrissingen. Het café is elke dag geopend vanaf 8.30 uur. Het sluit 's avonds als er geen klanten zijn."
    ],
    "es": [
      "Damos la bienvenida a los senderistas y ofrecemos refrescos. La cafetería abre todos los días a partir de las 8.30 horas. Cierra por la noche cuando no hay clientes."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Café Rando Nord - Le café de la place"
    ]
  },
