  "rdfs:comment": {
    "de": [
      "Im Herzen des Parks des königlichen Schlosses von Senlis zeigt Ihnen das Musée de la Vénerie die kulturelle und künstlerische Dimension der Hetzjagd, die eine echte Tradition in der Region ist!"
    ],
    "en": [
      "In the heart of the park of the royal castle of Senlis, the museum of the Venery makes you discover the cultural and artistic dimension of the hunt with hounds, true tradition of the area!"
    ],
    "it": [
      "Nel cuore del parco del castello reale di Senlis, il museo della Vénerie permette di scoprire la dimensione culturale e artistica della caccia con i cani da caccia, una vera tradizione della regione!"
    ],
    "fr": [
      "Au cœur du parc du château royal de Senlis, le musée de la Vénerie vous fait découvrir la dimension culturelle et artistique de la chasse à courre, véritable tradition de la région !"
    ],
    "nl": [
      "In het hart van het park van het koninklijk kasteel van Senlis laat het museum Vénerie u de culturele en artistieke dimensie ontdekken van de jacht met honden, een echte traditie van de streek!"
    ],
    "es": [
      "En el corazón del parque del castillo real de Senlis, el museo Vénerie le permite descubrir la dimensión cultural y artística de la caza con perros de presa, ¡una verdadera tradición de la región!"
    ]
  },
