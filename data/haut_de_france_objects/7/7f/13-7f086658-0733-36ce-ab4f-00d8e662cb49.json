  "rdfs:comment": {
    "de": [
      "Es handelt sich um die Schlacht, die die französische Armee gegen die Österreicher gewann, ein Meilenstein vom 16. Oktober 1793. Gallo-römische Überreste sind ebenfalls im Museum ausgestellt."
    ],
    "en": [
      "It is the battle won by the French army against the Austrians, a landmark event dating from October 16, 1793. Gallo-Roman vestiges are also exposed in the museum."
    ],
    "it": [
      "Si tratta della battaglia vinta dall'esercito francese contro gli austriaci, un evento storico che risale al 16 ottobre 1793. Nel museo sono esposti anche resti gallo-romani."
    ],
    "fr": [
      "Il s'agit de la bataille remportée par l'armée Française face aux Autrichiens, un fait marquant datant du 16 Octobre 1793. Des vestiges Gallo-Romains sont également exposés dans le musée."
    ],
    "es": [
      "Se trata de la batalla ganada por el ejército francés contra los austriacos, un acontecimiento histórico que data del 16 de octubre de 1793. También se exponen en el museo restos galo-romanos."
    ],
    "nl": [
      "Dit is de slag die het Franse leger won van de Oostenrijkers, een mijlpaal op 16 oktober 1793. In het museum zijn ook Gallo-Romeinse overblijfselen te zien."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Musée de la Bataille"
    ]
  },
