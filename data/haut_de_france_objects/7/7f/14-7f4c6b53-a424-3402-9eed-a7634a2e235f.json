  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/141a98d9-e95b-3921-a1be-234d8699ed8c",
      "dc:description": {
        "de": [
          "Die Bollaert Boys organisieren Fahrten zum Bollaert-Stadion, aber auch in ganz Frankreich, um den Racing Club de Lens zu verfolgen. Diese Fangruppe ist seit 1996 der verantwortliche Organisator des Teléthon in der Gemeinde Merlimont."
        ],
        "en": [
          "The Bollaert Boys organize trips to the Bollaert stadium, as well as all over France to follow Racing Club de Lens, and have been the organizers of the Teléthon in Merlimont since 1996."
        ],
        "it": [
          "I Bollaert Boys organizzano trasferte allo stadio Bollaert, ma anche in tutta la Francia per seguire il Racing Club de Lens, e dal 1996 organizzano il Teléthon a Merlimont."
        ],
        "fr": [
          "Les Bollaert Boys organisent les déplacements au stade Bollaert, mais aussi dans toute la France pour suivre le Racing Club de Lens.Ce groupe de supporters est l'organisateur responsable du Teléthon dans la commune de Merlimont depuis 1996."
        ],
        "es": [
          "Los Bollaert Boys organizan viajes al estadio de Bollaert, así como por toda Francia para seguir al Racing Club de Lens, y organizan el Teléthon de Merlimont desde 1996."
        ],
        "nl": [
          "De Bollaert Boys organiseren reizen naar het Bollaertstadion, maar ook door heel Frankrijk om Racing Club de Lens te volgen, en organiseren sinds 1996 de Teléthon in Merlimont."
        ]
      },
