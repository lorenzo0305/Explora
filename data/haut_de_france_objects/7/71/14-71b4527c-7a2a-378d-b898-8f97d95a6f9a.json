  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/dd1d6739-8516-3a4b-947e-f2afabcc1f36",
      "dc:description": {
        "de": [
          "Das Hoogaar ist ein Restaurant, das algerische Spezialitäten, Couscous, Bricks oder auch geschmortes Huhn anbietet.\nEs ist täglich mittags und abends geöffnet, vor Ort oder zum Mitnehmen. Mittwochs geschlossen."
        ],
        "en": [
          "The Hoogaar is a restaurant that offers Algerian specialties, couscous, bricks or braised chicken.\nIt is open every day for lunch and dinner, on the spot or to take away. Closed on Wednesday."
        ],
        "it": [
          "L'Hoogaar è un ristorante che offre specialità algerine, couscous, brick e pollo brasato.\nÈ aperto tutti i giorni per pranzo e cena, sul posto o da asporto. Chiuso il mercoledì."
        ],
        "fr": [
          "Le Hoogaar est un restaurant qui propose des spécialités algériennes, du couscous, des bricks ou encore du poulet braisé.\nIl est ouvert tous les jours midi et soir, sur place ou à emporter. Fermeture le mercredi."
        ],
        "es": [
          "El Hoogaar es un restaurante que ofrece especialidades argelinas, cuscús, ladrillos y pollo estofado.\nEstá abierto todos los días para almorzar y cenar, en el lugar o para llevar. Cerrado los miércoles."
        ],
        "nl": [
          "De Hoogaar is een restaurant met Algerijnse specialiteiten, couscous, stenen en gestoofde kip.\nHet is elke dag open voor lunch en diner, ter plaatse of om mee te nemen. Gesloten op woensdag."
        ]
      },
