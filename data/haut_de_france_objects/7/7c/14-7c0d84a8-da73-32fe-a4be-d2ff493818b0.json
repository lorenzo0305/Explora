  "rdfs:comment": {
    "de": [
      "Das Festival verleiht den CineComedies-Preis an Valérie Lemercier anlässlich der Vorführung ihrer ersten beiden Regiearbeiten, Quadrille und Le Derrière."
    ],
    "en": [
      "The festival will award the Prix CineComedies to Valérie Lemercier on the occasion of the screening of her first two films, Quadrille and Le Derrière."
    ],
    "it": [
      "Il festival assegnerà il Prix CineComedies a Valérie Lemercier in occasione della proiezione dei suoi primi due film, Quadrille e Le Derrière."
    ],
    "fr": [
      "Le festival décernera le Prix CineComedies à Valérie Lemercier à l’occasion de la projection de ses deux premières réalisations, Quadrille et Le Derrière."
    ],
    "nl": [
      "Het festival reikt de Prix CineComedies uit aan Valérie Lemercier bij de vertoning van haar eerste twee films, Quadrille en Le Derrière."
    ],
    "es": [
      "El festival otorgará el Prix CineComedies a Valérie Lemercier durante la proyección de sus dos primeras películas, Quadrille y Le Derrière."
    ]
  },
