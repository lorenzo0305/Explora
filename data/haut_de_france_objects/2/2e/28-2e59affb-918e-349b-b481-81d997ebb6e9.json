  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7c4d5eb1-1803-3075-89c7-9b570c2626c6",
      "dc:description": {
        "de": [
          "Der Verein Saint-Vaast Nature ?setzt sich für die Entdeckung unseres lokalen Naturerbes ein und bietet Workshops, Naturbaustellen und von einem Umweltanimateur begleitete Spaziergänge an."
        ],
        "en": [
          "The Saint-Vaast Nature association promotes the discovery of our local natural heritage and offers workshops, nature workcamps and walks accompanied by an environmental coordinator."
        ],
        "it": [
          "L'associazione Saint-Vaast Nature promuove la scoperta del patrimonio naturale locale e propone laboratori, campi di lavoro nella natura e passeggiate accompagnate da un coordinatore ambientale."
        ],
        "fr": [
          "L'association Saint-Vaast Nature œuvre pour la découverte de notre patrimoine naturel local et propose des ateliers, chantiers nature et balades accompagnées par un animateur environnement."
        ],
        "es": [
          "La asociación Saint-Vaast Nature promueve el descubrimiento de nuestro patrimonio natural local y ofrece talleres, campos de trabajo en la naturaleza y paseos acompañados por un coordinador medioambiental."
        ],
        "nl": [
          "De vereniging Saint-Vaast Nature promoot de ontdekking van ons lokale natuurlijke erfgoed en biedt workshops, natuurwerkkampen en wandelingen onder begeleiding van een milieucoördinator."
        ]
      },
      "@type": [
        "Description"
      ],
