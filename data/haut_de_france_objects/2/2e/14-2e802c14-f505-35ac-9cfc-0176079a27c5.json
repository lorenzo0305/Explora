  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/819a88eb-2cb2-3e90-a03f-bdf88d5e99ee",
      "dc:description": {
        "de": [
          "Das Restaurant befindet sich im ersten Stock mit direktem Blick auf das Meer. Auf der Speisekarte stehen 3 Vorspeisen, 3 Hauptgerichte & 3 Desserts, die jede Woche wechseln. Zusätzlich zu diesem Wochenmenü werden 18 Rezepte für Muscheln mit Pommes frites sowie Welshs angeboten."
        ],
        "en": [
          "The restaurant is on the second floor with a direct view of the sea. The menu features 3 starters, 3 main courses & 3 desserts, which change weekly. In addition to this weekly menu, 18 recipes of Moules Frites and Welshs are available."
        ],
        "it": [
          "Il ristorante si trova al primo piano con vista diretta sul mare. Il menu comprende 3 antipasti, 3 piatti principali e 3 dessert, che cambiano ogni settimana. Oltre a questo menu settimanale, sono disponibili 18 ricette di Moules Frites e Welshs."
        ],
        "fr": [
          "Le restaurant se trouve au premier étage avec une vue directe sur la mer. Au menu, 3 entrées, 3 plats & 3 Desserts qui changent toutes les semaines. En plus de ce menu à la semaine, 18 recettes de Moules Frites ainsi que des Welshs sont proposés."
        ],
        "nl": [
          "Het restaurant bevindt zich op de eerste verdieping met direct uitzicht op zee. Het menu bestaat uit 3 voorgerechten, 3 hoofdgerechten en 3 desserts, die elke week veranderen. Naast dit weekmenu zijn er 18 recepten van Moules Frites en Welshs beschikbaar."
        ],
        "es": [
          "El restaurante está en la primera planta, con vistas directas al mar. El menú incluye 3 entrantes, 3 platos principales y 3 postres, que cambian cada semana. Además de este menú semanal, se ofrecen 18 recetas de Moules Frites y Galeses."
        ]
      },
