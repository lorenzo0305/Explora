  "rdfs:comment": {
    "de": [
      "Einfallsreiche, französische Küche, die mit frischen, saisonalen Produkten zubereitet wird.\n\nEntdecken Sie neu interpretierte, hausgemachte traditionelle Gerichte in einem warmen und eleganten Rahmen.\n\nDas Restaurant verfügt über eine Sonnenterrasse.\n\n "
    ],
    "en": [
      "Inventive French cuisine prepared with fresh, seasonal produce.\n\nDiscover traditional dishes revisited and homemade in a warm and elegant setting.\n\nThe restaurant has a sunny terrace.\n\n "
    ],
    "it": [
      "Cucina francese inventiva preparata con prodotti freschi di stagione.\n\nScoprite i piatti tradizionali rivisitati e fatti in casa in un ambiente caldo ed elegante.\n\nIl ristorante dispone di una terrazza soleggiata.\n\n "
    ],
    "fr": [
      "Cuisine inventive, française, préparée avec des produits frais et de saison.\n\nDécouvrez des plats traditionnels revisités, faits maison dans un cadre chaleureux et élégant.\n\nLe restaurant dispose d'une terrasse ensoleillée.\n\n "
    ],
    "nl": [
      "Inventieve Franse keuken bereid met verse seizoensproducten.\n\nOntdek opnieuw bereide traditionele gerechten in een warme en elegante omgeving.\n\nHet restaurant heeft een zonnig terras.\n\n "
    ],
    "es": [
      "Cocina francesa creativa elaborada con productos frescos de temporada.\n\nDescubra platos tradicionales revisitados y caseros en un ambiente cálido y elegante.\n\nEl restaurante dispone de una terraza soleada.\n\n "
    ]
  },
