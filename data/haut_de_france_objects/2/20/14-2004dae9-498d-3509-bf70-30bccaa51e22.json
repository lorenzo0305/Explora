  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b77d9f4b-360e-3d21-a7f4-2ac75067b248",
      "dc:description": {
        "de": [
          "Geführter Rundgang \"Der Hafen\"\n\nEntdecken Sie die verschiedenen Facetten des Hafens von Boulogne, von der Fischerei bis zum Yachthafen\n\nRV vor den Fischständen, bei den Riesen, Quai Gambetta, Boulogne-sur-Mer\n\nUhrzeit: 10 Uhr (Dauer: 1,5 Std.)\n-\tMontag, 27. Oktober"
        ],
        "en": [
          "The port\" guided tour\n\nDiscover the different facets of the port of Boulogne, from fishing to yachting\n\nRV in front of the fish stalls, near the giants, quai Gambetta, Boulogne-sur-Mer\n\nSchedule: 10 a.m. (duration: 1h30)\n-\tMonday, October 27"
        ],
        "it": [
          "Visita guidata \"Il porto\n\nScoprite le diverse sfaccettature del porto di Boulogne, dalla pesca alla nautica\n\nPunto d'incontro davanti ai banchi del pesce, vicino ai giganti, quai Gambetta, Boulogne-sur-Mer\n\nOrario: 10.00 (durata: 1h30)\n-\tLunedì 27 ottobre"
        ],
        "fr": [
          "Visite guidée « Le port »\n\nDécouvrez les différentes facettes du port de Boulogne, de la pêche au port de plaisance\n\nRV devant les étals à poissons, près des géants, quai Gambetta, Boulogne-sur-Mer\n\nHoraire : 10 h (durée : 1h30)\n-\tLundi 27 octobre"
        ],
        "es": [
          "Visita guiada \"El puerto\n\nDescubra las diferentes facetas del puerto de Boulogne, de la pesca a la náutica\n\nPunto de encuentro frente a los puestos de pescado, cerca de los gigantes, quai Gambetta, Boulogne-sur-Mer\n\nHora: 10 h (duración: 1h30)\n-\tLunes 27 de octubre"
        ],
        "nl": [
          "De haven\" rondleiding\n\nOntdek de verschillende facetten van de haven van Boulogne, van visserij tot yachting\n\nTrefpunt voor de viskramen, bij de reuzen, quai Gambetta, Boulogne-sur-Mer\n\nTijd: 10 uur (duur: 1u30)\n-\tMaandag 27 oktober"
        ]
      },
