  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/465cb8bd-40d9-353e-828d-85cdddbdcb88",
      "dc:description": {
        "de": [
          "Kleine Farm mit Schafen und Salers-Kühen, auf der wir Ihnen das Fleisch anbieten. Caisette von halben Lämmern, Merguez, Kräuterwürstchen und Hacksteaks aus 100% Schafen. Kommen Sie und entdecken Sie uns."
        ],
        "en": [
          "Small farm of sheep and Salers cows where we offer you the meat. Caisette of half-lamb, merguez, herb sausages and minced steaks made from 100% sheep. Come and discover us."
        ],
        "it": [
          "Piccolo allevamento di pecore e mucche di razza Salers dove vi offriamo la carne. Caisette di mezz'agnello, merguez, salsicce alle erbe e bistecche macinate al 100% di pecora. Venite a scoprirci."
        ],
        "fr": [
          "Petit élevage de moutons et vaches salers où nous vous proposons la viande. Caisette de demi-agneaux, merguez, saucisses aux herbes et steaks hachés en 100% ovins. Venez nous découvrir."
        ],
        "es": [
          "Pequeña explotación de ovejas y vacas Salers donde le ofrecemos la carne. Caisette de medio cordero, merguez, salchichas a las hierbas y filetes picados 100% de oveja. Venga a descubrirnos."
        ],
        "nl": [
          "Kleine schapen- en Salers koeienboerderij waar we je het vlees aanbieden. Caisette van half lam, merguez, kruidenworstjes en gehakt van 100% schapen. Kom en ontdek ons."
        ]
      },
      "@type": [
        "Description"
      ],
