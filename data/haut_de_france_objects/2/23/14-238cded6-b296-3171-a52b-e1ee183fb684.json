  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/9885ada4-52bd-3be6-aea5-9bbddfb5852e",
      "dc:description": {
        "de": [
          "Mit Hilfe der neuen Technologien des Mapping (animierte Echtzeitprojektion) lädt Josquin Otal die visuellen Künste in den Louvre- Lens ein, als Echo auf Rachmaninovs Werk."
        ],
        "en": [
          "With the help of new mapping technologies (animated projection in real time), Josquin Otal invites the visual arts to the Louvre-Lens, echoing the work of Rachmaninov."
        ],
        "it": [
          "Con l'aiuto delle nuove tecnologie di mappatura (proiezione animata in tempo reale), Josquin Otal invita le arti visive al Louvre-Lens, per fare eco all'opera di Rachmaninov."
        ],
        "fr": [
          "Grâce à l’aide des nouvelles technologies de mapping (projection animée en temps réel), Josquin Otal invite les arts visuels au Louvre- Lens, en écho à l’oeuvre de Rachmaninov."
        ],
        "nl": [
          "Met behulp van nieuwe mapping-technologieën (geanimeerde projectie in real time) nodigt Josquin Otal de beeldende kunst uit in Louvre-Lens, als echo van het werk van Rachmaninov."
        ],
        "es": [
          "Con ayuda de las nuevas tecnologías de mapping (proyección animada en tiempo real), Josquin Otal invita a las artes visuales al Louvre-Lens, para hacerse eco de la obra de Rachmaninov."
        ]
      },
