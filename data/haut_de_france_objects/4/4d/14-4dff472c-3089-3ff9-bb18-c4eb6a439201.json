      "dc:description": {
        "de": [
          "Lerne und baue in Begleitung eines Vermittlers dein Windlicht aus Tauwerk als nützlichen Dekorationsgegenstand in einem Meeresthema"
        ],
        "en": [
          "Accompanied by a mediator, learn and build your own rope photophore for a useful decorative object in a sea theme"
        ],
        "it": [
          "Accompagnati da un mediatore, imparate a costruire il vostro fotoforo in corda per creare un utile oggetto decorativo a tema marittimo"
        ],
        "fr": [
          "Accompagné d'un médiateur, apprend et construit ton photophore en cordage pour un objet de décoration utile dans un thème mer"
        ],
        "nl": [
          "Onder begeleiding van een bemiddelaar leer en bouw je je eigen fotofoor van touw om een nuttig decoratief object met een maritiem thema te maken"
        ],
        "es": [
          "Acompañado por un mediador, aprenda y construya su propio fotóforo de cuerda para crear un útil objeto decorativo de temática marítima"
        ]
