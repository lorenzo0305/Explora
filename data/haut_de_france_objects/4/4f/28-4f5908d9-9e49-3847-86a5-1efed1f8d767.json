  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/eba21a7f-b555-3832-aba4-e4e9f7fdecea",
      "dc:description": {
        "de": [
          "Forellenangeln in einem natürlichen Gebiet am Ufer des Flusses Nièvre. Vor Ort finden Sie einen einladenden Ort mit einer Brasserie, Spielen im Innenbereich und einem Pressezentrum.\nDas Angeln wird Ihnen auf einem Parcours oder in Teichen angeboten."
        ],
        "en": [
          "Trout fishing in a natural site on the banks of the Nièvre river. On the spot you will find a welcoming place with a brasserie, indoor games, a press point.\nFishing is proposed to you on a course or ponds."
        ],
        "it": [
          "Pesca alla trota in un ambiente naturale sulle rive della Nièvre. Sul posto troverete un luogo accogliente con una brasserie, giochi all'interno, un punto stampa.\nLa pesca è offerta su un campo o in stagni."
        ],
        "fr": [
          "Pêche à la truite dans un site naturel au bord de la Nièvre. Sur place vous trouverez un lieu accueillant avec une brasserie, des jeux à l'intérieur, un point presse.\nLa pêche vous est proposée sur un parcours ou des étangs."
        ],
        "nl": [
          "Vissen op forel in een natuurlijke omgeving aan de oevers van de Nièvre. Ter plaatse vindt u een gastvrije plek met een brasserie, spelletjes binnen, een perspunt.\nEr wordt gevist op een parcours of in vijvers."
        ],
        "es": [
          "Pesca de truchas en un entorno natural a orillas del Nièvre. En el lugar encontrará un lugar acogedor con una brasserie, juegos en el interior, un punto de prensa.\nLa pesca se ofrece en un campo o en estanques."
        ]
      },
