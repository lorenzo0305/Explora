  "rdfs:comment": {
    "de": [
      "Charmantes Restaurant in der Thiérache, 15 Minuten von der Abtei Saint-Michel und 10 Minuten von Parfondeval entfernt. Yann, der Chefkoch, bietet Ihnen die Wahl zwischen 5 Vorspeisen, 5 Hauptgerichten und 5 Desserts."
    ],
    "en": [
      "Charming restaurant in Thiérache, 15 minutes from Saint-Michel Abbey and 10 minutes from Parfondeval. Chef Yann offers a choice of 5 starters, 5 main courses and 5 desserts."
    ],
    "it": [
      "Ristorante di charme a Thiérache, a 15 minuti dall'Abbazia di Saint-Michel e a 10 minuti da Parfondeval. Lo chef Yann propone una scelta di 5 antipasti, 5 piatti principali e 5 dessert."
    ],
    "fr": [
      "Charmant restaurant en Thiérache à 15 minutes de l'Abbaye de Saint-Michel et 10 minutes de Parfondeval. Yann, le Chef, vous propose le choix entre  5 entrées, 5 plats et 5 desserts."
    ],
    "es": [
      "Encantador restaurante en Thiérache, a 15 minutos de la Abadía de Saint-Michel y a 10 minutos de Parfondeval. El Chef Yann propone 5 entrantes, 5 platos principales y 5 postres."
    ],
    "nl": [
      "Charmant restaurant in Thiérache, op 15 minuten van de abdij Saint-Michel en 10 minuten van Parfondeval. Chef Yann biedt keuze uit 5 voorgerechten, 5 hoofdgerechten en 5 desserts."
    ]
  },
