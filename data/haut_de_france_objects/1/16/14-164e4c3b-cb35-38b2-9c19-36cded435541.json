      "dc:description": {
        "de": [
          "Eine Säuberungsaktion in Lebensgröße!\n9. Ausgabe der Aktion \"Sauberes Hauts de France\"\nTreffpunkt am Sonntag, den 8. März um 9:30 Uhr am Haus der Dienste\n\nDauer: 3 Stunden"
        ],
        "en": [
          "A life-size clean-up!\n9th \"Hauts de France Propres\" clean-up event\nRendezvous on Sunday, March 8 at 9:30 a.m. at the Maison des Services\n\nDuration: 3 hours"
        ],
        "it": [
          "Una pulizia a grandezza naturale!\n9° evento di pulizia \"Hauts de France Propres\nAppuntamento domenica 8 marzo alle ore 9.30 presso la Maison des Services\n\nDurata: 3 ore"
        ],
        "fr": [
          "Un nettoyage grandeur nature !\n9ème édition des \"Hauts de France Propres\"\nRendez-vous le dimanche 8 mars à 9h30 à la maison des services\n\nDurée : 3 heures"
        ],
        "es": [
          "Una limpieza a escala real\n9ª edición de la campaña de limpieza \"Hauts de France Propres\nCita el domingo 8 de marzo a las 9.30 h en la Maison des Services\n\nDuración: 3 horas"
        ],
        "nl": [
          "Een schoonmaak op ware grootte!\n9e schoonmaakactie \"Hauts de France Propres\nAfspraak op zondag 8 maart om 9.30 uur in het Maison des Services\n\nDuur: 3 uur"
        ]
      },
