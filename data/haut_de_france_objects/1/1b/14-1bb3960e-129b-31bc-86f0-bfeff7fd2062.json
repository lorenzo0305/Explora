      "dc:description": {
        "de": [
          "Machen Sie sich auf den Weg, um die Bäume und Sträucher kennenzulernen, die den Wald im Parc des Cytises bevölkern. Eine spielerische Aktivität, um den Pflanzenreichtum des Ortes besser kennen zu lernen."
        ],
        "en": [
          "Discover the trees and shrubs that grow in the wooded area of the Parc des Cytises. A fun activity to learn more about the site's rich plant life."
        ],
        "it": [
          "Scoprite gli alberi e gli arbusti che crescono nell'area boschiva del Parc des Cytises. È un modo divertente per conoscere la ricca flora del sito."
        ],
        "fr": [
          "Partez à la rencontre des arbres et arbustes qui peuplent l’espace boisé du Parc des Cytises. Une activité ludique pour mieux connaître la richesse végétale du site."
        ],
        "nl": [
          "Ontdek de bomen en struiken die groeien in het beboste gebied van het Parc des Cytises. Het is een leuke manier om meer te weten te komen over het rijke plantenleven van de site."
        ],
        "es": [
          "Descubra los árboles y arbustos que crecen en la zona boscosa del Parc des Cytises. Es una forma divertida de saber más sobre la rica vida vegetal del lugar."
        ]
      },
