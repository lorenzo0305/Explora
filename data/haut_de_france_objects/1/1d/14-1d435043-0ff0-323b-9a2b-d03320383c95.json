  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d9236171-a294-3235-bf02-3f3e5a0b89db",
      "dc:description": {
        "de": [
          "Von 10h bis 21h auf dem Place Claude Wilquin\nWarmes Essen mittags und abends (Aperitif ? gegrillter Schinken ? Gratin dauphinois ? Kuchen) ? Musikalische Unterhaltung ab 11.30 Uhr ? Lokale Brauereien und Handwerker.\nReservierung von Mahlzeiten und Stellplätzen: groupementberck@gmail.com\nOrganisiert von der Groupement des Commerçants de Berck-Ville (Vereinigung der Händler von Berck-Stadt)"
        ],
        "en": [
          "From 10am to 9pm on Place Claude Wilquin\nHot lunch and dinner (aperitif ? grilled ham ? gratin dauphinois ? tart) ? Musical entertainment from 11:30 ? Local brewers and artisans.\nMeal and stand reservations: groupementberck@gmail.com\nOrganized by Groupement des Commerçants de Berck-Ville"
        ],
        "it": [
          "Dalle 10 alle 21 in Place Claude Wilquin\nPasto caldo a pranzo e a cena (aperitivo ? prosciutto alla griglia ? gratin dauphinois ? torta) ? Intrattenimento musicale dalle 11:30 ? Birrai e artigiani locali.\nPrenotazione pasti e piazzole: groupementberck@gmail.com\nOrganizzato dal Groupement des Commerçants de Berck-Ville"
        ],
        "fr": [
          "De 10h à 21h sur la Place Claude Wilquin\nRepas chaud midi et soir (apéritif – jambon grillé – gratin dauphinois – tarte) – Animation musicale dès 11h30 – Brasseurs et artisans locaux.\nRéservation repas et emplacement : groupementberck@gmail.com\nOrganisé par le Groupement des Commerçants de Berck-Ville"
        ],
        "nl": [
          "Van 10 tot 21 uur op de Place Claude Wilquin\nWarme maaltijd voor lunch en diner (aperitief ? gegrilde ham ? gratin dauphinois ? taart) ? Muzikale animatie vanaf 11u30 ? Lokale brouwers en ambachtslieden.\nReserveringen voor maaltijden en staanplaatsen: groupementberck@gmail.com\nGeorganiseerd door de Groupement des Commerçants de Berck-Ville"
        ],
        "es": [
          "De 10:00 a 21:00 h en la plaza Claude Wilquin\nComida caliente para el almuerzo y la cena (aperitivo ? jamón asado ? gratin dauphinois ? tarta) ? Animación musical a partir de las 11:30 ? Cerveceros y artesanos locales.\nReservas de comidas y parcelas: groupementberck@gmail.com\nOrganizado por la Agrupación de Comerciantes de Berck-Ville"
        ]
      },
      "@type": [
        "Description"
      ],
