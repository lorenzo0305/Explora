  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c5ea8c9e-c760-3826-b954-363f67e34324",
      "dc:description": {
        "de": [
          "Tout un monde ist eine nomadische und solidarische Bouquinerie, die im Arrondissement unterwegs ist, um Aktivitäten rund um Geschichten und Bücher sowie einen Verkauf von gebrauchten Büchern anzubieten."
        ],
        "en": [
          "Tout un monde is a nomadic bookshop that travels around the borough offering activities related to stories and books, and selling second-hand books."
        ],
        "it": [
          "Tout un monde è una libreria nomade che gira per il quartiere proponendo attività legate a storie e libri, oltre a vendere libri di seconda mano."
        ],
        "fr": [
          "Tout un monde est une bouquinerie nomade et solidaire qui se déplace dans l'arrondissement afin de proposer des activités en lien avec les histoires et les livres, et une vente de livres d'occasion."
        ],
        "nl": [
          "Tout un monde is een nomadische boekwinkel die door het stadsdeel reist en activiteiten aanbiedt die verband houden met verhalen en boeken, maar ook tweedehands boeken verkoopt."
        ],
        "es": [
          "Tout un monde es una librería nómada que recorre el barrio ofreciendo actividades relacionadas con las historias y los libros, además de vender libros de segunda mano."
        ]
      },
      "@type": [
