  "rdfs:comment": {
    "de": [
      "Del Arte ist das italienische Restaurant Nr. 1 in Frankreich. Wir bieten Pizza, Nudelgerichte, Schnitzel Firenze, usw. Zum Mittag- oder Abendessen in einer warmen und freundlichen Atmosphäre. Vor Ort oder zum Mitnehmen. vegetarisches Menü."
    ],
    "en": [
      "Del Arte is the number one Italian restaurant in France. We offer pizzas, pasta dishes, escalope Firenze, etc... For lunch or dinner in a warm and friendly atmosphere. On the spot or to take away. Vegetarian menu."
    ],
    "it": [
      "Del Arte è il ristorante italiano numero uno in Francia. Offriamo pizze, primi piatti, scaloppine alla fiorentina, ecc. per pranzo o cena in un'atmosfera calda e accogliente. Sul posto o da asporto. Menu vegetariano."
    ],
    "fr": [
      "Del Arte est le restaurant italien n°1 en France. Nous proposons des pizzas, des plats de pâtes, escalope Firenze, etc…Pour le déjeuner ou le dîner dans une ambiance chaleureuse et conviviale. Sur place ou à emporter. menu végé."
    ],
    "nl": [
      "Del Arte is het nummer één Italiaanse restaurant in Frankrijk. Wij bieden pizza's, pastagerechten, escalope Firenze, enz. Voor lunch of diner in een warme en vriendelijke sfeer. Ter plaatse of om mee te nemen. Vegetarisch menu."
    ],
    "es": [
      "Del Arte es el restaurante italiano número uno de Francia. Ofrecemos pizzas, platos de pasta, escalope Firenze, etc. Para el almuerzo o la cena en un ambiente cálido y acogedor. En el momento o para llevar. Menú vegetariano."
    ]
  },
