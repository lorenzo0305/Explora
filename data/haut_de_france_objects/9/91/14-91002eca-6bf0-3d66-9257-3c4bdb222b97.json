      "dc:description": {
        "de": [
          "Schicke französische Küche in Montreuil-sur-Mer: Gourmetrestaurant und schickes Bistro.\n\nGeschlossen während der Weihnachtszeit und im Januar."
        ],
        "en": [
          "Chic French cuisine in Montreuil-sur-Mer: gourmet restaurant and chic bistro.\n\nClosed during the holiday season and in January."
        ],
        "it": [
          "Cucina francese chic e gourmet a Montreuil-sur-Mer: ristorante gourmet e bistrot chic.\n\nChiuso durante le festività e a gennaio."
        ],
        "fr": [
          "Cuisine française chic et gastronomique à Montreuil-sur-Mer : restaurant gastronomique et bistrot chic.\n\nFermetures pendant la période des fêtes de fin d'année et durant le mois de janvier."
        ],
        "es": [
          "Cocina francesa chic y gourmet en Montreuil-sur-Mer: restaurante gourmet y bistró chic.\n\nCerrado durante las fiestas y en enero."
        ],
        "nl": [
          "Chique, gastronomische Franse keuken in Montreuil-sur-Mer: gastronomisch restaurant en chique bistro.\n\nGesloten tijdens de feestdagen en in januari."
        ]
      },
