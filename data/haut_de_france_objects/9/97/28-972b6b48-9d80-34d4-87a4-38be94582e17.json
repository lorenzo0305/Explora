  "rdfs:comment": {
    "de": [
      "Abwechslungsreiche Familienküche, Salate, frische Produkte, verschiedene Nudelgerichte, Paninis, Sandwiches, Spezialität: hausgemachter Clafoutis!\n\nSonnenterrasse, Touristen- und Studentenatmosphäre.\n\nIn der Nähe der Kathedrale im Viertel St Leu."
    ],
    "en": [
      "Varied home cooking, salads, fresh products, various pastas, paninis, sandwiches, specialty: homemade clafoutis!\n\nSunny terrace, tourist and student atmosphere.\n\nNear Cathedral in St Leu district."
    ],
    "it": [
      "Cucina familiare varia, insalate, prodotti freschi, vari tipi di pasta, panini, tramezzini, specialità: clafoutis fatto in casa!\n\nTerrazza soleggiata, ambiente turistico e studentesco.\n\nVicino alla Cattedrale, nel quartiere di St Leu."
    ],
    "fr": [
      "Cuisine familiale variée, salades, produits frais, pâtes diverses, paninis, sandwichs, spécialité: clafoutis maison!\n\nTerrasse ensoleillée, ambiance touristique et étudiantes.\n\nProximité Cathédrale dans quartier St Leu."
    ],
    "nl": [
      "Gevarieerde familiekeuken, salades, verse producten, verschillende soorten pasta, panini's, sandwiches, specialiteit: huisgemaakte clafoutis!\n\nZonnig terras, toeristische en studentensfeer.\n\nVlakbij de kathedraal in de wijk St Leu."
    ],
    "es": [
      "Cocina familiar variada, ensaladas, productos frescos, varios tipos de pasta, paninis, bocadillos, especialidad: ¡clafoutis casero!\n\nTerraza soleada, ambiente turístico y estudiantil.\n\nCerca de la Catedral, en el barrio de St Leu."
    ]
  },
