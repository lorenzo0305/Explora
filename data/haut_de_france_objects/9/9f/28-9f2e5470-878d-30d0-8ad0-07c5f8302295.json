  ],
  "rdfs:comment": {
    "de": [
      "Der Garten im Herzen des Bocage bietet eine Sammlung von Wildpflanzen und -blumen, einen Obstgarten und vieles mehr. Ein spielerischer Parcours aktiviert Ihre Sinne durch Barfußlaufen."
    ],
    "en": [
      "The garden in the heart of the bocage presents a collection of plants and wild flowers, a conservatory orchard... A ludic course will activate your senses by the bare feet."
    ],
    "it": [
      "Il giardino nel cuore del bocage presenta una collezione di piante e fiori selvatici, un frutteto conservatore... Un percorso ludico attiverà i vostri sensi a piedi nudi."
    ],
    "fr": [
      "Le jardin au cœur du bocage présente une collection de plantes et fleurs sauvages, un verger conservatoire... Un parcours ludique activera vos sens par les pieds nus."
    ],
    "es": [
      "El jardín en el corazón del bocage presenta una colección de plantas y flores silvestres, un huerto conservatorio... Un sendero lúdico activará sus sentidos con los pies descalzos."
    ],
    "nl": [
      "De tuin in het hart van de bocage presenteert een verzameling wilde planten en bloemen, een serreboomgaard... Een speels pad zal uw zintuigen activeren met blote voeten."
    ]
  },
  "rdfs:label": {
    "fr": [
      "La Maison du Bocage"
    ]
