  "rdfs:comment": {
    "de": [
      "Dieses gemütliche Estaminet befindet sich in einem ehemaligen Bauernhaus. Es bietet eine hausgemachte Küche mit Brettern, flämischer Karbonade, Filet Mignon mit Maroilles, Welsh, gebackenem Camembert, Potjevleesch..."
    ],
    "en": [
      "This warm estaminet is located in an old farmhouse. It proposes a home cooking of boards, Flemish carbonade, filet mignon with maroilles, welsh, camembert in the oven, potjevleesch..."
    ],
    "it": [
      "Questo accogliente estaminet si trova in un'antica casa colonica. Offre una cucina casalinga a base di assi, carbonade fiamminga, filetto mignon con maroilles, gallese, camembert al forno, potjevleesch..."
    ],
    "fr": [
      "Ce chaleureux estaminet est situé dans un ancien corps de ferme. Il propose une cuisine maison de planches, carbonade flamande, filet mignon au maroilles, welsh, camembert au four, potjevleesch..."
    ],
    "es": [
      "Este acogedor estaminet está ubicado en una antigua granja. Ofrece una cocina casera de tablas, carbonada flamenca, filet mignon con maroilles, gales, camembert al horno, potjevleesch...."
    ],
    "nl": [
      "Dit gezellige estaminet is gevestigd in een oude boerderij. Het biedt een huisgemaakte keuken van planken, Vlaamse carbonade, filet mignon met maroilles, welsh, gebakken camembert, potjevleesch..."
    ]
  },
