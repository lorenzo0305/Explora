  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/605cbee9-1118-33cc-b922-ddb86f0c8a8e",
      "dc:description": {
        "de": [
          "Öffnungszeiten der Bibliothek am 1. April 2025\nMontag: 9.30-11.30 Uhr\nDienstag: 16h-18h\nMittwoch: 10h-12h / 15h30-18h30\nDonnerstag: 16h-18h\nFreitag: 16h-18h\nSamstag: 10h-12h\n\nMitgliedschaft 15 ? pro Jahr pro Familie\n5? für Studenten und kostenlos für Kindergärtnerinnen."
        ],
        "en": [
          "Library opening hours on April 1, 2025\nMonday: 9.30am-11.30am\nTuesday: 16h-18h\nWednesday: 10h-12h / 15h30-18h30\nThursday: 16h-18h\nFriday: 16h-18h\nSaturday: 10am-12pm\n\nMembership 15? per year per family\n5? for students and free for childminders."
        ],
        "it": [
          "Orari di apertura della biblioteca il 1° aprile 2025\nLunedì: 9.30-11.30\nMartedì: 16.00-18.00\nMercoledì: 10.00-12.00 / 15.30-18.30\nGiovedì: 16.00-18.00\nVenerdì: 16.00-18.00\nSabato: 10.00-12.00\n\nIscrizione 15? all'anno per famiglia\n5? per gli studenti e gratis per gli assistenti all'infanzia."
        ],
        "fr": [
          "Horaires d'ouverture de la bibliothèque au 1er Avril 2025\nLundi : 9h30-11h30\nMardi : 16h-18h\nMercredi : 10h-12h / 15h30-18h30\nJeudi : 16h-18h\nVendredi : 16h-18h\nSamedi : 10h-12h\n\nAdhésion 15€ par an par famille\n5€ pour les étudiants et gratuit pour les assistantes maternelle."
        ],
        "nl": [
          "Openingstijden bibliotheek op 1 april 2025\nMaandag: 9.30-11.30 uur\nDinsdag: 16.00-18.00\nWoensdag: 10.00-12.00 / 15.30-18.30\nDonderdag: 16-18 uur\nVrijdag: 16-18 uur\nZaterdag: 10-12 uur\n\nLidmaatschap 15? per jaar per gezin\n5? voor studenten en gratis voor kinderoppas."
        ],
        "es": [
          "Horario de apertura de la biblioteca el 1 de abril de 2025\nLunes: de 9.30 a 11.30 horas\nMartes: de 16.00 a 18.00 horas\nMiércoles: 10.00-12.00 / 15.30-18.30\nJueves: de 16.00 a 18.00 horas\nViernes: de 16.00 a 18.00 horas\nSábado: 10.00-12.00\n\nAfiliación 15? al año por familia\n5? para estudiantes y gratuito para cuidadores de niños."
        ]
      },
