  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d98a977e-2fad-360c-b006-196ff7baa837",
      "dc:description": {
        "de": [
          "5. Festival Ludique, organisiert von Oye-Pla?Jeux.\nZahlreiche Tische mit Gesellschaftsspielen, umgeben von Kunsthandwerkern und Designern!\nEs erwarten Sie Einführungen und Turniere: Jdr, Figurenmalerei, Karten und Bretter."
        ],
        "en": [
          "5th Festival Ludique organized by Oye-Pla?Jeux.\nNumerous board game tables surrounded by artisans and creators!\nInitiations and tournaments await you: jdr, miniature painting, cards and board games."
        ],
        "it": [
          "5° Festival Ludique organizzato da Oye-Pla?Jeux.\nNumerosi tavoli di giochi da tavolo circondati da artigiani e designer!\nIniziative e tornei vi aspettano: jdr, pittura su figurine, carte e tavole."
        ],
        "fr": [
          "5ème Festival Ludique organisé par Oye-Pla’Jeux.\nDe nombreuses tables de jeux de société entourées par des artisans et créateurs ! \nDes initiations et des tournois vous attendent: du jdr , de la peinture sur figurines, des cartes et plateaux."
        ],
        "nl": [
          "5e Ludiek Festival georganiseerd door Oye-Pla?Jeux.\nTalrijke bordspeltafels omringd door ambachtslui en ontwerpers!\nInitiaties en toernooien wachten op je: jdr, schilderen op figuurtjes, kaarten en borden."
        ],
        "es": [
          "5º Festival Ludique organizado por Oye-Pla?Jeux.\nNumerosas mesas de juegos de mesa rodeadas de artesanos y diseñadores\nLe esperan iniciaciones y torneos: jdr, pintura sobre figuritas, cartas y tableros."
        ]
      },
