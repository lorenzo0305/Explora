  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/068c8605-a5a6-3985-93d1-c62de7764fff",
      "dc:description": {
        "de": [
          "Das Restaurant Le Lambi empfängt Sie das ganze Jahr über in einem gemütlichen Rahmen mit seiner Stranddekoration. Entdecken Sie schon jetzt das Wochenmenü mit frischen, französischen Produkten von lokalen Erzeugern."
        ],
        "en": [
          "Le Lambi restaurant welcomes you all year round in a warm, seaside setting. Discover the weekly menu featuring fresh French produce from local producers."
        ],
        "it": [
          "Il ristorante Le Lambi vi accoglie tutto l'anno in un ambiente caldo e balneare. Scoprite il menu settimanale, a base di prodotti freschi francesi provenienti da produttori locali."
        ],
        "fr": [
          "Le restaurant Le Lambi vous accueille dans un cadre chaleureux avec sa décoration balnéaire tout au long de l’année. Découvrez dès à présent le menu de la semaine à base de produits frais, français et issus de producteurs locaux."
        ],
        "nl": [
          "Restaurant Le Lambi verwelkomt je het hele jaar door in een warme omgeving aan zee. Ontdek het wekelijkse menu, gebaseerd op verse Franse producten van lokale producenten."
        ],
        "es": [
          "El restaurante Le Lambi le da la bienvenida todo el año en un ambiente cálido y costero. Descubra el menú semanal, basado en productos franceses frescos de productores locales."
        ]
      },
