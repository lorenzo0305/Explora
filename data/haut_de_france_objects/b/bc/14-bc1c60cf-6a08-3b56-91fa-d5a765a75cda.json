  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/acebf216-a841-3da8-a074-c9a3e510ba8f",
      "dc:description": {
        "de": [
          "Je nach Verfügbarkeit\nDer Parc Equestre bietet Ponykurse (ab 2 Jahren), Reitunterricht für alle Niveaustufen, Ausritte für alle Niveaustufen, Verleih von Ponys in der Hand, Wettkampfkurse, Praktika mit Galopp-Prüfung."
        ],
        "en": [
          "Depending on availability\nLe Parc Equestre offers pony lessons (from age 2), horseback riding lessons for all levels, pony rides for all levels, pony rental, competition lessons, and courses with gallops."
        ],
        "it": [
          "A seconda della disponibilità\nIl Parc Equestre offre lezioni di pony (a partire dai 2 anni), lezioni di equitazione per tutti i livelli, passeggiate a cavallo per tutti i livelli, noleggio di pony, lezioni di gara e corsi con galoppo."
        ],
        "fr": [
          "En fonction des disponibilités\nLe Parc Equestre propose des cours de poneys (à partir de 2 ans), des cours à cheval tous niveaux, des balades à cheval tous niveaux, de la location de poneys en main, des cours de compétition, des stages avec passage de galops."
        ],
        "es": [
          "Según disponibilidad\nEl Parque Ecuestre ofrece clases de poni (a partir de 2 años), clases de equitación para todos los niveles, paseos a caballo para todos los niveles, alquiler de ponis, clases de competición y cursos con galopes."
        ],
        "nl": [
          "Afhankelijk van beschikbaarheid\nHet Parc Equestre biedt ponylessen (vanaf 2 jaar), paardrijlessen voor alle niveaus, buitenritten voor alle niveaus, ponyverhuur, wedstrijdlessen en cursussen met galop."
        ]
      },
      "@type": [
        "Description"
      ],
