  "rdfs:comment": {
    "de": [
      "Le Boulon feiert 28 Jahre Straßenkunst in Vieux-Condé: Lachen, Emotionen, Kreationen und 35.000 Zuschauer, die ab dem 1. Mai für ein magisches Wochenende erwartet werden."
    ],
    "en": [
      "Le Boulon celebrates 28 years of street arts in Vieux-Condé: laughter, emotions, creations and 35,000 spectators expected from May 1st for a magical weekend."
    ],
    "it": [
      "Le Boulon celebra 28 anni di arti di strada nella Vieux-Condé: risate, emozioni, creatività e 35.000 spettatori attesi dal 1° maggio per un magico fine settimana."
    ],
    "fr": [
      "Le Boulon fête 28 ans d’arts de rue à Vieux-Condé : rires, émotions, créations et 35 000 spectateurs attendus dès le 1er mai pour un week-end magique."
    ],
    "nl": [
      "Le Boulon viert 28 jaar straatkunsten in Vieux-Condé: lachen, emotie, creativiteit en 35.000 toeschouwers die vanaf 1 mei worden verwacht voor een magisch weekend."
    ],
    "es": [
      "Le Boulon celebra 28 años de artes de calle en Vieux-Condé: risas, emoción, creatividad y 35.000 espectadores esperados a partir del 1 de mayo para un fin de semana mágico."
    ]
