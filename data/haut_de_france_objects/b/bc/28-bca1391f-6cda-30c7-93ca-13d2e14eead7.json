  "rdfs:comment": {
    "de": [
      "Das Restaurant vereint Eleganz und Modernität und bietet Ihnen eine großzügige, traditionelle und gewagte Küche.\nDie Speisekarte wird je nach Jahreszeit erneuert, um Ihnen Gerichte anzubieten, die aus frischen Zutaten zusammengestellt werden."
    ],
    "en": [
      "The restaurant combines elegance and modernity and offers a generous, traditional and daring cuisine.\nThe menu is renewed according to the seasons to offer you dishes concocted from fresh products."
    ],
    "it": [
      "Il ristorante unisce eleganza e modernità e offre una cucina generosa, tradizionale e audace.\nIl menu viene rinnovato in base alle stagioni per offrirvi piatti preparati con prodotti freschi."
    ],
    "fr": [
      "Le restaurant allie élégance et modernité et vous propose une cuisine généreuse, traditionnelle et audacieuse.\nLa carte est renouvelée au fil des saisons pour vous proposer des plats concoctés à partir de produits frais."
    ],
    "nl": [
      "Het restaurant combineert elegantie en moderniteit en biedt een gulle, traditionele en gedurfde keuken.\nHet menu wordt naargelang de seizoenen vernieuwd om u gerechten aan te bieden die met verse producten worden bereid."
    ],
    "es": [
      "El restaurante combina elegancia y modernidad y ofrece una cocina generosa, tradicional y atrevida.\nLa carta se renueva según las estaciones para ofrecerle platos elaborados con productos frescos."
    ]
  },
