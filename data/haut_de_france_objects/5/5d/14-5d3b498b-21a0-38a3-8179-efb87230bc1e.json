  "rdfs:comment": {
    "de": [
      "Von der Cie La Ponctuelle\nPetite S?ur ist eine halb biografische, halb fiktive Erzählung, die die Familiensaga von Lucien Fradin fortsetzt und mit Zärtlichkeit die Erschütterungen des Übergangs zum Erwachsenwerden beleuchtet."
    ],
    "en": [
      "By Cie La Ponctuelle\nHalf-biographical, half-fiction, Petite S?ur continues Lucien Fradin?s family saga, shedding tender light on the jolts of adolescence."
    ],
    "it": [
      "Da Cie La Ponctuelle\nPer metà biografico e per metà narrativo, Petite S?ur continua la saga familiare di Lucien Fradin e getta una luce tenera sui turbamenti dell'adolescenza."
    ],
    "fr": [
      "Par la Cie La Ponctuelle\nRécit mi-biographique, mi-fictif, Petite Sœur poursuit la saga familiale de Lucien Fradin et éclaire avec tendresse les soubresauts du passage à l’adolescence."
    ],
    "es": [
      "Por Cie La Ponctuelle\nMitad biográfica, mitad ficción, Petite Sœur continúa la saga familiar de Lucien Fradin y arroja una tierna luz sobre los trastornos de la adolescencia."
    ],
    "nl": [
      "Door Cie La Ponctuelle\nHalf biografisch, half fictie, Petite S?ur vervolgt de familie saga van Lucien Fradin en werpt een teder licht op de omwentelingen van de adolescentie."
    ]
  },
