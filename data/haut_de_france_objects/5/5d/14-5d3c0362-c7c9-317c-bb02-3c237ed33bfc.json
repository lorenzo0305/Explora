  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/accaf358-b00a-39a9-a274-efae4aebf906",
      "dc:description": {
        "de": [
          "Spaziergang und Picknick bei Sonnenuntergang, betreut von der Sportabteilung. Treffpunkt vor der Hütte des Strandclubs um 20 Uhr (bringen Sie Ihr Picknick, Wanderschuhe, geeignete Kleidung und Wasser mit). Kostenlos."
        ],
        "en": [
          "Walk and picnic at sunset, supervised by the Sports Department. Meet in front of the beach club chalet at 8pm (bring your own picnic, walking shoes, appropriate clothing and water). Free admission."
        ],
        "it": [
          "Passeggiata e picnic al tramonto, sotto la supervisione del Dipartimento dello Sport. Ritrovo davanti allo chalet del beach club alle 20.00 (portare un picnic, scarpe da trekking, abbigliamento adatto e acqua). Ingresso libero."
        ],
        "fr": [
          "Balade et pique-nique au coucher de soleil, encadrés par le service des sports. Rendez-vous devant le chalet du club de plage à 20h (prévoir votre pique-nique, vos chaussures de marche, des vêtements adaptés ainsi que de l'eau). Gratuit."
        ],
        "nl": [
          "Wandeling en picknick bij zonsondergang onder begeleiding van de sportafdeling. Verzamelen voor het chalet van de strandclub om 20.00 uur (neem een picknick, wandelschoenen, geschikte kleding en water mee). Gratis toegang."
        ],
        "es": [
          "Paseo y picnic al atardecer, supervisado por el Departamento de Deportes. Encuentro frente al chalet del club de playa a las 20.00 horas (llevar picnic, calzado para caminar, ropa adecuada y agua). Entrada gratuita."
        ]
      },
      "@type": [
        "Description"
