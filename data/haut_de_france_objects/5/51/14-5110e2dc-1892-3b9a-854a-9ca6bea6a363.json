  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0b1e35e8-039e-34a9-8928-5207e98ac1bc",
      "dc:description": {
        "de": [
          "Monumentale Bronzeskulptur, entworfen von\nDie neuseeländische Künstlerin Marian Fountain erinnert an die\nin Erinnerung an die Beteiligung der\nneuseeländischen Tunnelbauers in den Steinbrüchen des\nunterirdischen Tunnel in Arras während des 1\nWeltkrieg."
        ],
        "en": [
          "Monumental bronze sculpture designed by\nMarian Fountain, a New Zealand artist, in memory of the\nin memory of the New Zealand Tunnelling\nnew Zealand Tunnellers in the underground quarries\nquarries of Arras during the First World\nWorld War I."
        ],
        "it": [
          "Scultura monumentale in bronzo progettata da\nMarian Fountain, artista neozelandese, in memoria della\nin memoria del coinvolgimento dei Tunnellers neozelandesi\nnuova Zelanda nelle cave sotterranee di Arras durante la Prima Guerra Mondiale\ncave di Arras durante la Prima Guerra Mondiale\nLa Prima guerra mondiale."
        ],
        "fr": [
          "Sculpture monumentale en bronze conçue par\nMarian Fountain, artiste néo-zélandaise à la\nmémoire de l’implication de la compagnie des\ntunneliers néo-zélandais dans les carrières\nsouterraines d’Arras pendant la Première\nGuerre mondiale."
        ],
        "nl": [
          "Monumentale bronzen sculptuur ontworpen door\nMarian Fountain, een Nieuw-Zeelandse kunstenaar, ter nagedachtenis aan de\nter herinnering aan de betrokkenheid van de\nnieuw-Zeelandse tunnelgravers in de ondergrondse steengroeven\nsteengroeven in Arras tijdens de Eerste\nDe Eerste Wereldoorlog."
        ],
        "es": [
          "Escultura monumental de bronce diseñada por\nMarian Fountain, artista neozelandesa, en memoria de la\nen memoria de la participación de los\ntuneladores de Nueva Zelanda en las canteras subterráneas\ncanteras de Arras durante la Primera\nLa Primera Guerra Mundial."
        ]
      },
