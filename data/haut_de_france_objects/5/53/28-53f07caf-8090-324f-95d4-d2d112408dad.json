  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/91cbdb40-5eec-3d89-98b5-40ac753b78ed",
      "dc:description": {
        "de": [
          "Entdecken Sie das saisonale Gemüse aus biologischem Anbau auf dem Bauernhof, wo Olivier Ihnen eine ganze Reihe von Gemüsesorten wie Chicorée, Kartoffeln, Tomaten, Kohl und Lauch anbietet."
        ],
        "en": [
          "Come and discover seasonal organically grown vegetables at the farm, where Olivier offers a whole range of vegetables such as endive, potatoes, tomatoes, cabbage and leeks."
        ],
        "it": [
          "Venite a scoprire le verdure di stagione coltivate con metodo biologico presso la fattoria, dove Olivier propone un'intera gamma di ortaggi tra cui indivia, patate, pomodori, cavoli e porri."
        ],
        "fr": [
          "Venez découvrir les légumes de saison issus de l'agriculture biologique à la ferme, où Olivier vous propose toute une gamme de légumes tels que l’endive, la pomme de terre, des tomates, des choux et des poireaux."
        ],
        "es": [
          "Venga a descubrir las verduras de temporada de cultivo ecológico en la granja, donde Olivier le ofrece toda una gama de hortalizas como escarolas, patatas, tomates, coles y puerros."
        ],
        "nl": [
          "Kom en ontdek seizoensgebonden biologisch geteelde groenten op de boerderij, waar Olivier een hele reeks groenten aanbiedt, waaronder andijvie, aardappelen, tomaten, kool en prei."
        ]
      },
