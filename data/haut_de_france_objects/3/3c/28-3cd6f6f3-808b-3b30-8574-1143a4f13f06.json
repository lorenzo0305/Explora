  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/3bdf89d6-67d5-3af3-9bd9-e6e5207cd22d",
      "dc:description": {
        "de": [
          "Hier können Sie auf Anfrage ein Kanu oder Kajak mieten und die Freuden des Wildwassers entdecken oder eine Wanderung auf dem Fluss Somme unternehmen."
        ],
        "en": [
          "You can rent a canoe or a kayak on simple request, discover the joys of white water or a hike on the Somme River."
        ],
        "it": [
          "Su richiesta è possibile noleggiare una canoa o un kayak, scoprire le gioie dell'acqua bianca o fare un'escursione sul fiume Somme."
        ],
        "fr": [
          "Vous pouvez y louer un canoë ou un kayak sur simple demande,  découvrir  les joies de l'eau vive ou  d'une randonnée sur le fleuve Somme ."
        ],
        "nl": [
          "U kunt op verzoek een kano of kajak huren, de geneugten van het wildwater ontdekken of een wandeling op de Somme maken."
        ],
        "es": [
          "Si lo desea, puede alquilar una canoa o un kayak, descubrir los placeres de las aguas bravas o hacer una excursión por el río Somme."
        ]
      },
