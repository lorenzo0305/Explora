      "@id": "https://data.datatourisme.fr/57b9cb8d-da0c-3252-9511-4473b63efd04",
      "dc:description": {
        "de": [
          "Traditionelles Jahreskonzert\nFreitag, 19. Dezember um 20.30 Uhr\nKirche Saint-Josse au Val - Montreuil Ville Basse\n------------------------------\nMit den Chanterelles du Bras d'Or et du Pays de Montreuil\nTraditionelle Gesangskonzerte unter der Leitung von Cécile Duvivier\n\nFreier Eintritt\n\nFoto: Pixabay"
        ],
        "en": [
          "Traditional annual concert\nFriday, December 19 at 8:30 p.m\nSaint-Josse au Val Church - Montreuil Ville Basse\n------------------------------\nWith the Chanterelles du Bras d?Or et du Pays de Montreuil\nConcerts of traditional songs conducted by Cécile Duvivier\n\nFree admission\n\nPhoto : Pixabay"
        ],
        "it": [
          "Tradizionale concerto annuale\nVenerdì 19 dicembre alle 20.30\nChiesa di Saint-Josse au Val - Montreuil Ville Basse\n------------------------------\nCon le Chanterelle du Bras d'Or et du Pays de Montreuil\nConcerti di canti tradizionali diretti da Cécile Duvivier\n\nIngresso libero\n\nFoto : Pixabay"
        ],
        "fr": [
          "Traditionnel concert annuel\nVendredi 19 décembre à 20h30\nEglise Saint-Josse au Val - Montreuil Ville Basse\n------------------------------\nAvec les Chanterelles du Bras d’Or et du Pays de Montreuil\nConcerts de chants traditionnels sous la direction de Cécile Duvivier\n\nEntrée Gratuite\n\nPhoto : Pixabay"
        ],
        "nl": [
          "Traditioneel jaarlijks concert\nVrijdag 19 december om 20.30 uur\nKerk Saint-Josse au Val - Montreuil Ville Basse\n------------------------------\nMet de Chanterelles du Bras d'Or et du Pays de Montreuil\nConcerten met traditionele liederen onder leiding van Cécile Duvivier\n\nGratis toegang\n\nFoto : Pixabay"
        ],
        "es": [
          "Tradicional concierto anual\nViernes 19 de diciembre a las 20h30\nIglesia Saint-Josse au Val - Montreuil Ville Basse\n------------------------------\nCon las Chanterelles du Bras d'Or et du Pays de Montreuil\nConciertos de canciones tradicionales dirigidos por Cécile Duvivier\n\nEntrada gratuita\n\nFoto : Pixabay"
        ]
      },
