  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ebe9f935-5fe1-3dcb-9fbf-8ac62e68d4c8",
      "dc:description": {
        "de": [
          "WANDERWEG VON 6 KM ODER 9 KM - 1H45\nABFAHRT VOM PLACE FOCH IN SAMER\nPAS DE BALISAGE - Carnet du randonneur erhältlich im Fremdenverkehrsamt\n\nFinden Sie den Verlauf des Rundwegs auf der Wander-App CIRKWI auf Ihrem Smartphone."
        ],
        "en": [
          "6 KM OR 9 KM WALKING TRAIL - 1H45\nDEPARTURE FROM PLACE FOCH IN SAMER\nNO MARKING - Hiker's booklet available from the Tourist Office\n\nFind the route on the CIRKWI hiking application on your Smartphone."
        ],
        "it": [
          "PERCORSO A PIEDI DI 6 KM O 9 KM - 1 ORA E 45 MINUTI\nPARTENZA DA PLACE FOCH A SAMER\nNON SONO PREVISTI MARCATORI - Il libretto dell'escursionista è disponibile presso l'Ufficio del Turismo\n\nTrovate il percorso sull'applicazione escursionistica CIRKWI sul vostro smartphone."
        ],
        "fr": [
          "SENTIER PEDESTRE DE 6 KM OU 9 KM - 1H45\nDEPART DE LA PLACE FOCH DE SAMER\nPAS DE BALISAGE - Carnet du randonneur disponible à l'Office de Tourisme\n\nRetrouvez le tracé du circuit sur l'application Randonnée CIRKWI sur votre Smartphone."
        ],
        "es": [
          "RECORRIDO A PIE DE 6 KM O 9 KM - 1 HORA 45 MINUTOS\nSALIDA DE LA PLAZA FOCH EN SAMER\nSIN MARCAR - Folleto del senderista disponible en la Oficina de Turismo\n\nEncuentre la ruta en la aplicación de senderismo CIRKWI en su smartphone."
        ],
        "nl": [
          "6 KM OF 9 KM WANDELROUTE - 1 UUR 45 MINUTEN\nVERTREK VANAF PLACE FOCH IN SAMER\nGEEN MARKERING - Wandelboekje verkrijgbaar bij de Dienst voor Toerisme\n\nVind de route op de CIRKWI wandelapplicatie op je smartphone."
        ]
      },
