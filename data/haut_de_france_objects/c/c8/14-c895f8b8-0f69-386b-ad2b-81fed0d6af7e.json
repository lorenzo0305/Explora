  "rdfs:comment": {
    "de": [
      "Zurück ins Jahr 1900 ... Entdecken Sie dank der Museumssammlungen das Alltagsleben der Seeleute in der Stadt der Fischer."
    ],
    "en": [
      "Back in 1900... Thanks to our museum collections, come and discover the daily life of sailors in the fishing town."
    ],
    "it": [
      "Ritorno al 1900... Grazie alle collezioni del museo, venite a scoprire la vita quotidiana dei marinai nella città dei pescatori."
    ],
    "fr": [
      "Retour en 1900... Grâce aux collections des musées, venez découvrir la vie quotidienne des marins de la cité des pêcheurs."
    ],
    "nl": [
      "Terug in 1900... Ontdek dankzij de museumcollecties het dagelijkse leven van de zeelieden in de vissersstad."
    ],
    "es": [
      "En 1900... Gracias a las colecciones del museo, venga a descubrir la vida cotidiana de los marineros en la ciudad pesquera."
    ]
  },
  "rdfs:label": {
