      "@id": "https://data.datatourisme.fr/d976f8f1-54b0-3f9c-8f43-086dbc8c2fe7",
      "dc:description": {
        "de": [
          "Weißer Kittel, Schutzbrille, Teststreifen. Werde in diesem Workshop zum Wasserexperten und führe viele lustige Experimente durch."
        ],
        "en": [
          "White coat, safety glasses, test strips. During this workshop, become a water expert with a host of fun experiments."
        ],
        "it": [
          "Camice bianco, occhiali, strisce reattive. Durante questo laboratorio, diventate esperti dell'acqua realizzando una serie di divertenti esperimenti."
        ],
        "fr": [
          "Blouse blanche, lunette de protection, bandelettes d’analyse. Devenez au cours de cet atelier un expert de l’eau en réalisant un tas d’expériences amusantes."
        ],
        "nl": [
          "Witte jas, veiligheidsbril, teststrips. Word tijdens deze workshop een waterexpert door allerlei leuke experimenten uit te voeren."
        ],
        "es": [
          "Bata blanca, gafas, tiras reactivas. Durante este taller, conviértete en un experto del agua realizando un montón de experimentos divertidos."
        ]
      },
