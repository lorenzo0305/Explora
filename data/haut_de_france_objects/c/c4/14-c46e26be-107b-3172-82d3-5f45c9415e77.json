      "@id": "https://data.datatourisme.fr/82768047-ff5f-3420-b90a-e94c083a33fc",
      "dc:description": {
        "de": [
          "Animation durch Phildeco.\n\nVerbringen Sie eine gute Zeit mit Freunden oder der Familie.\n\n3 Sonderspiele: 80 Euro.\n\nWir freuen uns auf Sie!\n\nVerpflegung vor Ort."
        ],
        "en": [
          "Entertainment by Phildeco.\n\nCome and have a good time with friends or family.\n\n3 special games: 80 euros.\n\nWe look forward to seeing you there!\n\nCatering on site."
        ],
        "it": [
          "Intrattenimento a cura di Phildeco.\n\nVenite a divertirvi con gli amici o la famiglia.\n\n3 giochi speciali: 80 euro.\n\nNon vediamo l'ora di vedervi lì!\n\nRistorazione in loco."
        ],
        "fr": [
          "Animation assurée par Phildeco.\n\nVenez passer un bon moment entre amis ou en famille.\n\n3 parties spéciales: 80 euros.\n\nOn vous attend nombreux !\n\nRestauration sur place."
        ],
        "es": [
          "Entretenimiento a cargo de Phildeco.\n\nVen a pasar un buen rato con amigos o familiares.\n\n3 juegos especiales: 80 euros.\n\n¡Te esperamos!\n\nCatering in situ."
        ],
        "nl": [
          "Entertainment verzorgd door Phildeco.\n\nKom gezellig langs met vrienden of familie.\n\n3 speciale spellen: 80 euro.\n\nWe kijken uit naar je komst!\n\nCatering ter plaatse."
        ]
      },
