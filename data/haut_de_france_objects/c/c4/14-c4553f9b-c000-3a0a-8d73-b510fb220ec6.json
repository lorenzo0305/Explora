  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f5896bb2-f3c8-3a99-9906-1beae7a723a5",
      "dc:description": {
        "de": [
          "Ein gemütlicher Ort zum Essen und Trinken, eine gepflegte Dekoration, ein persönlicher Empfang, das Ganze, um nur gute Dinge zu kosten, unsere Gerichte und Desserts sind hausgemacht"
        ],
        "en": [
          "A warm place to eat and drink, carefully decorated, with a personal welcome, all to enjoy good food and homemade dishes and desserts"
        ],
        "it": [
          "Un luogo caldo per mangiare e bere, arredato con gusto, con un'accoglienza personale, dove potrete gustare solo cose buone. I nostri piatti e i nostri dolci sono fatti in casa"
        ],
        "fr": [
          "Un endroit chaleureux pour boire et manger, une décoration soignée, un accueil personnalisé,  le tout pour y déguster que des bonnes choses, nos plats et nos desserts sont faits maison"
        ],
        "es": [
          "Un lugar cálido para comer y beber, decorado con gusto, con una bienvenida personal, donde se puede disfrutar de nada más que cosas buenas. Nuestros platos y postres son caseros"
        ],
        "nl": [
          "Een warme plek om te eten en te drinken, smaakvol ingericht, met een persoonlijk onthaal, waar je alleen maar kunt genieten van lekkere dingen. Onze gerechten en desserts zijn huisgemaakt"
        ]
      },
      "@type": [
        "Description"
      ],
