  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/da396a33-5b59-38d7-bb40-bf1b3b5d114a",
      "dc:description": {
        "de": [
          "La cabane à Poutines ist ein kanadisches Schnellrestaurant in Amiens, mitten im Viertel St Leu, nur wenige Schritte vom Parc de l'Evêché entfernt.\nIn La Cabane à Poutines finden Sie eine Qualitätsküche (frische und hausgemachte Produkte), die die köstlichsten Aromen aus Québec vereint."
        ],
        "en": [
          "La cabane à Poutines is a Canadian fast food restaurant located in Amiens, in the St Leu district, a stone's throw from the Parc de l'Evêché.\nAt La Cabane à Poutines, you will find a quality cuisine (fresh and homemade products), bringing together the most delicious flavors of Quebec."
        ],
        "it": [
          "La Cabane à Poutines è un fast food canadese situato ad Amiens, nel cuore del quartiere St Leu, a due passi dal Parc de l'Evêché.\nA La Cabane à Poutines troverete una cucina di qualità (prodotti freschi e fatti in casa), che raccoglie i sapori più deliziosi del Quebec."
        ],
        "fr": [
          "La cabane à Poutines est un restaurant rapide canadien situé à Amiens, en plein quartier St Leu, à deux pas du Parc de l'Evêché.\nA La Cabane à Poutines, vous pourrez retrouver une cuisine de qualité (produits frais et faits maison), rassemblant les plus délicieuses saveurs de Québec."
        ],
        "nl": [
          "La Cabane à Poutines is een Canadees fastfoodrestaurant in Amiens, in het hart van de wijk St Leu, op een steenworp afstand van het Parc de l'Evêché.\nBij La Cabane à Poutines vindt u kwaliteitsgerechten (verse en zelfgemaakte producten), die de heerlijkste smaken van Quebec verzamelen."
        ],
        "es": [
          "La Cabane à Poutines es un restaurante de comida rápida canadiense situado en Amiens, en el corazón del barrio de St Leu, a dos pasos del Parque del Evêché.\nEn La Cabane à Poutines, encontrará una cocina de calidad (productos frescos y caseros), que reúne los sabores más deliciosos de Quebec."
        ]
      },
