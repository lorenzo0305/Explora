  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/21812a7a-c82f-30cc-8823-7e34d17cc946",
      "dc:description": {
        "de": [
          "Gourmetwanderung am 14. August um 9:30 Uhr vom Château de Fressin aus\nFrühstück, 10 km lange Wanderung durch das Kulturerbe von Fressin und Mittagessen im Schloss von Fressin, das vom Restaurant Repère de Torcy serviert wird\n3 (nur Wanderung) | 6 (Wanderung + Frühstück) | 26 (Wanderung + Essen)"
        ],
        "en": [
          "Gourmet walk on August 14th at 9:30 am starting from Château de Fressin\nBreakfast, 10km heritage walk in Fressin and catered lunch at Château de Fressin by Le Repère de Torcy\n3? (hike only) | 6? (hike + breakfast) | 26? (hike + meal)"
        ],
        "it": [
          "Passeggiata gastronomica il 14 agosto alle 9.30 con partenza da Château de Fressin\nColazione, passeggiata di 10 km a Fressin e pranzo al castello di Fressin a cura di Le Repère de Torcy\n3 (solo escursione) | 6 (escursione + colazione) | 26 (escursione + pasto)"
        ],
        "fr": [
          "Balade gourmande le 14 août à 9h30 au départ du Château de Fressin\nPetit déjeuner, rando patrimoine à Fressin de 10km et déjeuner traiteur au Château de Fressin par le Repère de Torcy\n3€ (rando seule) | 6€ (rando + petit déj') | 26€ (rando + repas)"
        ],
        "es": [
          "Paseo gastronómico el 14 de agosto a las 9.30 h con salida del Château de Fressin\nDesayuno, paseo de 10 km por el patrimonio de Fressin y comida en el castillo de Fressin a cargo de Le Repère de Torcy\n3 (sólo caminata) | 6 (caminata + desayuno) | 26 (caminata + comida)"
        ],
        "nl": [
          "Gastronomische wandeling op 14 augustus om 9.30 uur vanaf Château de Fressin\nOntbijt, 10 km erfgoedwandeling in Fressin en verzorgde lunch in Château de Fressin door Le Repère de Torcy\n3 (alleen wandeling) | 6 (wandeling + ontbijt) | 26 (wandeling + maaltijd)"
        ]
      },
