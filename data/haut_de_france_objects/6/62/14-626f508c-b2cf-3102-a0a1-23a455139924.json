  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e6f8d7d1-4419-3d9b-bda0-b363c2c38881",
      "dc:description": {
        "de": [
          "Die Brasserie artisanale des terres noires, befindet sich in Sallaumines im Herzen des Bergbaubeckens.\nYves bietet ausgezeichnete Biere an: würzige Biere, Sour, IPA und Porter. Es ist für jeden Geschmack etwas dabei."
        ],
        "en": [
          "Brasserie artisanale des terres noires is located in Sallaumines, in the heart of the mining basin.\nYves offers excellent beers: spiced, sour, IPA and porter. Something for every taste."
        ],
        "it": [
          "La Brasserie Artisanale des Terres Noires si trova a Sallaumines, nel cuore del bacino carbonifero.\nYves propone birre eccellenti: speziate, acide, IPA e porter. Ce n'è per tutti i gusti."
        ],
        "fr": [
          "La Brasserie artisanale des terres noires, est située à Sallaumines au coeur du bassin minier.\nYves propose d'excellentes bières : épicées, sour, IPA et Porter. Il y en a pour tous les goûts."
        ],
        "es": [
          "La Brasserie Artisanale des Terres Noires se encuentra en Sallaumines, en el corazón de la cuenca minera.\nYves ofrece excelentes cervezas: especiadas, ácidas, IPA y porter. Hay para todos los gustos."
        ],
        "nl": [
          "De Brasserie Artisanale des Terres Noires ligt in Sallaumines, in het hart van het steenkoolgebied.\nYves biedt uitstekende bieren: gekruid, zuur, IPA en porter. Er is voor elk wat wils."
        ]
      },
      "@type": [
        "Description"
