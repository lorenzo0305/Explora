  "rdfs:comment": {
    "de": [
      "In Villers-Bretonneux stoppten die Australier im April 1918 endgültig die deutsche Offensive. Jedes Jahr am 25. April wird am Fuße dieses majestätischen Denkmals der Anzac Day begangen."
    ],
    "en": [
      "It was at Villers-Bretonneux that the Australians finally stopped the German offensive in April 1918. Every year on 25 April Anzac Day is commemorated at the foot of this majestic monument."
    ],
    "it": [
      "Fu a Villers-Bretonneux che gli australiani fermarono definitivamente l'offensiva tedesca nell'aprile 1918. Ogni anno, il 25 aprile, l'Anzac Day viene commemorato ai piedi di questo maestoso monumento."
    ],
    "fr": [
      "C'est à Villers-Bretonneux que les australiens arrêtèrent définitivement l'offensive allemande en avril 1918. Chaque année, le 25 avril, on commémore l'Anzac Day au pied de ce majestueux monument."
    ],
    "nl": [
      "Het was bij Villers-Bretonneux dat de Australiërs het Duitse offensief in april 1918 eindelijk stopten. Elk jaar op 25 april wordt aan de voet van dit majestueuze monument Anzac Day herdacht."
    ],
    "es": [
      "Fue en Villers-Bretonneux donde los australianos detuvieron finalmente la ofensiva alemana en abril de 1918. Cada año, el 25 de abril, se conmemora el Día de Anzac al pie de este majestuoso monumento."
    ]
  },
