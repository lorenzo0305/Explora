  "rdfs:comment": {
    "de": [
      "Das Neufundländer-Memorial vermittelt mithilfe eines Schlachtfeldes einen bewegenden und realistischen Einblick in die Schlachten. Drei Bronzeplatten, die an der Basis des Hügels eingemauert sind, bilden das Neufundländer Nationaldenkmal, das den Vermissten gewidmet ist."
    ],
    "en": [
      "The Newfoundland Memorial provides a moving and realistic view of the battles through a battlefield. Three bronze plaques sealed at the base of the mound make up the Newfoundland National Memorial to the Missing."
    ],
    "it": [
      "Il Memoriale di Terranova offre una visione commovente e realistica delle battaglie attraverso un campo di battaglia. Tre targhe di bronzo incastonate alla base del tumulo costituiscono il National Newfoundland Memorial to the Missing."
    ],
    "fr": [
      "Le mémorial terre-neuvien donne une vision émouvante et réaliste des batailles grâce à un champ de bataille. Trois plaques de bronze scellées à la base de la butte composent le Mémorial national terre-neuvien dédié aux disparus."
    ],
    "nl": [
      "Het Newfoundland Memorial geeft een ontroerend en realistisch beeld van de gevechten via een slagveld. Drie bronzen platen in de voet van de heuvel vormen het National Newfoundland Memorial to the Missing."
    ],
    "es": [
      "El Memorial de Terranova ofrece una visión conmovedora y realista de las batallas a través de un campo de batalla. Tres placas de bronce colocadas en la base del montículo conforman el Monumento Nacional a los Desaparecidos de Terranova."
    ]
  },
