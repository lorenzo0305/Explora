  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/ae65cabf-eda9-3e5a-a16c-7833e8cd3194",
      "dc:description": {
        "de": [
          "Ausfahrten auf das Meer für Einführungen und Hochseeangeln.\nParken und Zuwasserlassen von Booten des Clubs und von Eigentümern, die Mitglieder sind.\nAb 12 Jahren in Begleitung eines Erwachsenen."
        ],
        "en": [
          "Sea outings for beginners and sea fishing.\nParking and launching of club and owner-member boats.\nFrom 12 years old accompanied by an adult."
        ],
        "it": [
          "Uscite in mare per principianti e pesca in mare.\nParcheggio e varo di barche del club e dei soci.\nA partire da 12 anni accompagnati da un adulto."
        ],
        "fr": [
          "Sorties en mer pour initiation et pêche en mer.\nStationnement et mise à l'eau de bateaux du club et propriétaires adhérents.\nA partir de 12 ans accompagné par un adulte."
        ],
        "nl": [
          "Uitstapjes op zee voor beginners en zeevissen.\nParkeren en te water laten van boten van clubs en eigenaars.\nVanaf 12 jaar onder begeleiding van een volwassene."
        ],
        "es": [
          "Salidas de iniciación y pesca marítima.\nAparcamiento y botadura de embarcaciones del club y de socios propietarios.\nA partir de 12 años acompañado de un adulto."
        ]
      },
