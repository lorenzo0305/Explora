  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/b97c5068-52f5-3e96-949b-22127102442d",
      "dc:description": {
        "de": [
          "Auf dem Place du Général de Gaulle werden verschiedene Angebote gemacht, vom Sandwich allein bis zum kompletten Menü (Burger, Pommes frites, Getränk und hausgemachtes Dessert), Kindermenü. Alle Rezepte können Sie nach Ihren Wünschen anpassen."
        ],
        "en": [
          "On the Place du Général de Gaulle, we offer a variety of menus, from sandwiches to full menus (burger, fries, drink and homemade dessert), as well as children's menus. All recipes can be customized to your taste."
        ],
        "it": [
          "In Place du Général de Gaulle, troverete una gamma di opzioni, dai panini ai menu completi (hamburger, patatine, bevanda e dessert fatto in casa) e ai menu per bambini. Tutte le ricette possono essere personalizzate in base ai vostri gusti."
        ],
        "fr": [
          "Sur la place du Général de Gaulle, différentes formules sont proposées du sandwich seul au menu complet (burger, frites, boisson et dessert fait maison), menu enfant. Toutes les recettes sont à personnaliser selon vos envies."
        ],
        "nl": [
          "Op de Place du Général de Gaulle vind je verschillende opties, van sandwiches tot volledige menu's (hamburger, friet, drankje en zelfgemaakt dessert) en kindermenu's. Alle recepten kunnen naar eigen smaak worden aangepast."
        ],
        "es": [
          "En la Place du Général de Gaulle, encontrará desde bocadillos hasta un menú completo (hamburguesa, patatas fritas, bebida y postre casero), pasando por un menú infantil. Todas las recetas pueden personalizarse según sus gustos."
        ]
      },
