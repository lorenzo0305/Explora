  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/7a264f01-426f-34a0-926d-fff8f974d966",
      "dc:description": {
        "de": [
          "Sophro-Spaziergang im Frühling\nSich wieder mit der Natur verbinden und entspannen\nSamstag, 12. April von 10 bis 12 Uhr\nWeg der Zöllner und Strand\nEQUIHEN PLAGE\nMit Stephanie COPPIN\nZertifizierte Sophrologin\nTreffpunkt Parkplatz der Gletscherspalte in EQUIHEN PLAGE\nNach Anmeldung"
        ],
        "en": [
          "Spring Sophro Walk\nReconnect with nature and relax\nSaturday April 12 from 10am to 12pm\nChemin des douaniers and beach\nEQUIHEN BEACH\nWith Stéphanie COPPIN\nCertified Sophrologist\nRdv Parking de la crevasse à EQUIHEN PLAGE\nRegistration required"
        ],
        "it": [
          "Passeggiata Sophro di primavera\nRiconnettersi con la natura e rilassarsi\nSabato 12 aprile dalle 10.00 alle 12.00\nChemin des douaniers e spiaggia\nSPIAGGIA DELL'AQUILA\nCon Stéphanie COPPIN\nSofrologa diplomata\nRdv Parcheggio della crepaccia a EQUIHEN PLAGE\nRegistrazione obbligatoria"
        ],
        "fr": [
          "Balade Sophro du Printemps\nSe reconnecter à la nature et se détendre \nSamedi 12 Avril de 10h à 12h\nChemin des douaniers et plage \nEQUIHEN PLAGE\nAvec Stéphanie COPPIN\nSophrologue certifiée \nRdv Parking de la crevasse à EQUIHEN PLAGE\nSur inscription"
        ],
        "es": [
          "Paseo primaveral Sophro\nReconecta con la naturaleza y relájate\nSábado 12 de abril de 10h a 12h\nChemin des douaniers y playa\nPLAYA DE EQUIHEN\nCon Stéphanie COPPIN\nSofrologa diplomada\nRdv Parking de la crevasse à EQUIHEN PLAGE\nInscripción obligatoria"
        ],
        "nl": [
          "Lentewandeling\nKom weer in contact met de natuur en ontspan\nZaterdag 12 april van 10.00 tot 12.00 uur\nChemin des douaniers en strand\nEQUIHEN STRAND\nMet Stéphanie COPPIN\nGediplomeerd sofrologist\nRdv parkeerplaats van de crevasse in EQUIHEN PLAGE\nRegistratie verplicht"
        ]
      },
