  "rdfs:comment": {
    "de": [
      "Es besteht die Möglichkeit, die Kirche zu öffnen, indem Sie den Bürgermeister unter 06 72 51 51 49 anrufen. Der Narthex ist frei zugänglich und ermöglicht es, durch das Gitter einen Blick auf das Kirchenschiff zu werfen."
    ],
    "en": [
      "The church can be opened by calling the Mayor on 06 72 51 51 49. The narthex is freely accessible, allowing a glimpse of the nave through the grille."
    ],
    "it": [
      "La chiesa può essere aperta chiamando il Sindaco al numero 06 72 51 51 49. Il nartece è liberamente accessibile e lascia intravedere la navata centrale attraverso la grata."
    ],
    "fr": [
      "Possibilité d'ouvrir l'église en appelant M. le Maire au 06 72 51 51 49. Le narthex est librement accessible et permet d'apercevoir la nef à travers la grille."
    ],
    "es": [
      "La iglesia puede abrirse llamando al alcalde al 06 72 51 51 49. El nártex es de libre acceso y permite vislumbrar la nave a través de la reja."
    ],
    "nl": [
      "De kerk kan worden geopend door de burgemeester te bellen op 06 72 51 51 49. De narthex is vrij toegankelijk en biedt een blik op het schip door het traliewerk."
    ]
  },
  "rdfs:label": {
