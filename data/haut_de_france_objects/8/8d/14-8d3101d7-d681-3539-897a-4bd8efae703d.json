  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/450eabc4-2506-368b-8fef-ae80e4e06917",
      "dc:description": {
        "de": [
          "Entdecken Sie die Köstlichkeiten des Meeres auf der Terrasse oder im Speisesaal. :\n- meeresbretter\n- teller mit Krustentieren\n- geräucherter Lachs\noder einfach nur ein gutes Bier oder einen guten Weißwein, eine kleine Sangria,...\n\nTäglich in der Saison und an Wochenenden mit gutem Wetter außerhalb der Saison, ab 10 Uhr."
        ],
        "en": [
          "Come and discover the flavours of the sea, on the terrace or indoors. :\n- seafood platters\n- shellfish platters\n- smoked salmon\nor simply a good beer or white wine, a little sangria...\n\nEvery day in season and weekends in fine weather out of season, from 10am."
        ],
        "it": [
          "Venite a scoprire i sapori del mare, in terrazza o all'interno. :\n- piatti di mare\n- piatti di crostacei\n- salmone affumicato\no semplicemente una buona birra o un vino bianco, un po' di sangria,...\n\nTutti i giorni in stagione e nei weekend di bel tempo fuori stagione, a partire dalle 10.00."
        ],
        "fr": [
          "Venez découvrir les saveurs de la mer, en terrasse ou en salle. : \n- planches de la mer \n- assiettes de crustacés \n- saumon fumé\nou tout simplement une bonne bière ou un bon vin blanc, une petite sangria,...\n\nTous les jours en saison et les week-ends de beau temps hors saison, à partir de 10h."
        ],
        "es": [
          "Venga a descubrir los sabores del mar, en la terraza o en el interior. :\n- mariscadas\n- platos de marisco\n- salmón ahumado\no simplemente una buena cerveza o vino blanco, un poco de sangría,...\n\nTodos los días en temporada y los fines de semana de buen tiempo fuera de temporada, a partir de las 10h."
        ],
        "nl": [
          "Kom en ontdek de smaken van de zee, op het terras of binnen. :\n- schotels met zeevruchten\n- schalen met schelpdieren\n- gerookte zalm\nof gewoon een goed biertje of witte wijn, een beetje sangria,...\n\nElke dag in het seizoen en weekends bij mooi weer buiten het seizoen, vanaf 10u."
        ]
      },
