  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bc3ccb54-31cb-3354-8700-d0ffdb276853",
      "dc:description": {
        "de": [
          "Kreieren Sie Ihr eigenes Rezept mit unseren Zutaten oder entscheiden Sie sich für eine von unseren Köchen zusammengestellte Mischung. Vor Ort oder zum Mitnehmen, Ihr Menü wird vor Ihren Augen & nach Ihren Wünschen zubereitet!"
        ],
        "en": [
          "Create your own recipe using our ingredients, or opt for a mix created by our chefs. On the spot or to take away, your menu is prepared before your very eyes & according to your desires!"
        ],
        "it": [
          "Create la vostra ricetta con i nostri ingredienti o optate per un mix creato dai nostri chef. Sul posto o da asporto, il vostro menu viene preparato sotto i vostri occhi e secondo i vostri desideri!"
        ],
        "fr": [
          "Créez votre recette avec nos ingrédients ou optez pour une compo élaborée par nos chefs. Sur place ou à emporter, votre menu est préparé sous vos yeux & selon vos envies !"
        ],
        "nl": [
          "Stel je eigen recept samen met onze ingrediënten of kies voor een mix gemaakt door onze chefs. Ter plekke of om mee te nemen, je menu wordt voor je ogen & volgens jouw wensen bereid!"
        ],
        "es": [
          "Cree su propia receta con nuestros ingredientes u opte por una mezcla creada por nuestros chefs. En el momento o para llevar, su menú se prepara ante sus ojos y según sus deseos"
        ]
      },
