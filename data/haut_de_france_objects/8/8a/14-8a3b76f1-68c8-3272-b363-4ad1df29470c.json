  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/45a16bc3-87cf-33af-81df-cb943d424324",
      "dc:description": {
        "de": [
          "Finden Sie im Herzen eines Bauernhofs den Laden mit regionalen Produkten<br>Entdecken Sie die Werkstatt zur Herstellung von Milchprodukten und probieren Sie die Spezialität: die wilde Delikatesse<br>Bereitstellung von Präsentkörben"
        ],
        "en": [
          "In the heart of a farm, discover the local produce shop<br>Discover the dairy products workshop and taste the speciality: wild delights<br>Packed baskets made to order"
        ],
        "it": [
          "Nel cuore di una fattoria, visitate il negozio di prodotti locali<br>Scoprite il laboratorio di produzione di latticini e assaggiate le specialità: delizie selvatiche<br>Cestini confezionati su ordinazione"
        ],
        "fr": [
          "Retrouvez au coeur d'une exploitation, la boutique de produits du terroir<br>Découvrez l'atelier de fabrication de produits laitiers et dégustez la spécialité : le délice sauvage<br>Réalisation de paniers garnis"
        ],
        "es": [
          "En el corazón de una granja, visite la tienda de productos locales<br>Descubra el taller de fabricación de productos lácteos y deguste la especialidad: delicias silvestres<br>Cestas envasadas por encargo"
        ],
        "nl": [
          "Bezoek in het hart van een boerderij de winkel met streekproducten<br>Ontdek de werkplaats waar zuivelproducten worden gemaakt en proef de specialiteit: wilde lekkernijen<br>Verpakte manden op bestelling"
        ]
      },
      "@type": [
        "Description"
      ],
