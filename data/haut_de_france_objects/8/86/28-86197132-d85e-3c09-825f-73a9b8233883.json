  "rdfs:comment": {
    "de": [
      "Restaurant, Lebensmittelgeschäft, Teesalon, Essensplatten für Unternehmen.\nKochworkshops für Kinder und private Abendessen. Küche mit lokalen und saisonalen Produkten.\n\nRestaurant: Dienstag bis Freitag von 12:00 bis 14:00 Uhr.\nMontags, samstags und sonntags geschlossen."
    ],
    "en": [
      "Restaurant, grocery store, tearoom, meal trays for companies.\nCooking workshops for children and private dinners. Cuisine based on local, seasonal produce.\n\nRestaurant: Tuesday to Friday, 12:00 to 14:00.\nClosed Mondays, Saturdays and Sundays."
    ],
    "it": [
      "Ristorante, negozio di alimentari, sala da tè, vassoi di pasti per aziende.\nLaboratori di cucina per bambini e cene private. Cucina a base di prodotti locali e di stagione.\n\nRistorante: da martedì a venerdì dalle 12:00 alle 14:00.\nChiuso il lunedì, il sabato e la domenica."
    ],
    "fr": [
      "Restaurant, épicerie, salon de thé, plateaux repas pour les entreprises.\nAteliers cuisine pour les enfants et dîners privés. Cuisine à base de produits locaux et de saison.\n\nRestaurant : du mardi au vendredi de 12h00 à 14h00.\nFermé les lundis, samedis et dimanches."
    ],
    "es": [
      "Restaurante, tienda de comestibles, salón de té, bandejas de comida para empresas.\nTalleres de cocina para niños y cenas privadas. Cocina basada en productos locales de temporada.\n\nRestaurante: de martes a viernes de 12:00 a 14:00 horas.\nCerrado lunes, sábados y domingos."
    ],
    "nl": [
      "Restaurant, kruidenierswinkel, tearoom, maaltijdschalen voor bedrijven.\nKookworkshops voor kinderen en privédiners. Keuken gebaseerd op lokale, seizoensgebonden producten.\n\nRestaurant: dinsdag t/m vrijdag van 12.00 tot 14.00 uur.\nGesloten op maandag, zaterdag en zondag."
    ]
  },
