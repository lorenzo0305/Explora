  "rdfs:comment": {
    "de": [
      "Seien Sie bereit, Ihr Gehirn in einer begrenzten Zeit zu trainieren, indem Sie die Rätsel des Fort de Bruyères entdecken!\n\nRV vor Ort jeden Freitag, Samstag und Sonntag (Sitzungen um 14 Uhr, 15:30 Uhr und um 17 Uhr / Reservierung erforderlich)"
    ],
    "en": [
      "Get ready to put your brain to the test in a limited time by discovering the riddles of Fort de Bruyères!\n\nOn-site every Friday, Saturday and Sunday (sessions at 2pm, 3:30pm and 5pm / booking essential)"
    ],
    "it": [
      "Preparatevi a mettere alla prova il vostro cervello in un tempo limitato, scoprendo gli enigmi di Fort de Bruyères!\n\nSul posto ogni venerdì, sabato e domenica (sessioni alle 14.00, 15.30 e 17.00 / prenotazione obbligatoria)"
    ],
    "fr": [
      "Soyez prêts à faire travailler vos méninges dans un temps limité en découvrant les énigmes du Fort de Bruyères !\n\nRV sur place chaque vendredi, samedi et dimanche (sessions à 14h, 15h30 et à 17h / réservation obligatoire)"
    ],
    "es": [
      "¡Prepárate para poner a prueba tu cerebro en un tiempo limitado descubriendo los enigmas de Fort de Bruyères!\n\nIn situ todos los viernes, sábados y domingos (sesiones a las 14:00, 15:30 y 17:00 / reserva obligatoria)"
    ],
    "nl": [
      "Bereid je voor om in beperkte tijd je hersenen op de proef te stellen door de raadsels van Fort de Bruyères te ontdekken!\n\nElke vrijdag, zaterdag en zondag ter plaatse (sessies om 14u, 15u30 en 17u / reserveren verplicht)"
    ]
  },
