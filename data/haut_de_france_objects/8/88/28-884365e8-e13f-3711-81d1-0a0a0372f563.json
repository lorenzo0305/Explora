  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/c329e86d-4752-3e9f-90fa-69efd623c211",
      "dc:description": {
        "de": [
          "Cocktailbar mit musikalischer Untermalung.\n\nGeöffnet Dienstag bis Donnerstag von 17:00 bis 0:00 Uhr, Freitag von 17:00 bis 1:00 Uhr, Samstag von 17:00 bis 2:00 Uhr.\n\nArt der Kundschaft: 25 Jahre\n\nArt der Musik: Funk, Soul, Groove"
        ],
        "en": [
          "Cocktail bar with live music.\n\nOpen Tuesday to Thursday 5pm to 12am, Friday 5pm to 1am, Saturday 5pm to 2am.\n\nClientele : 25 years old\n\nType of music: Funk, soul, groove"
        ],
        "it": [
          "Cocktail bar con musica dal vivo.\n\nAperto da martedì a giovedì dalle 17.00 alle 24.00, venerdì dalle 17.00 all'1.00, sabato dalle 17.00 alle 2.00.\n\nClientela : 25 anni\n\nTipo di musica: Funk, soul, groove"
        ],
        "fr": [
          "Bar à cocktails avec ambiance musicale.\n\nOuvert du mardi au jeudi de 17h à 0h, le vendredi de 17h à 1h, le samedi de 17h à 2h.\n\nType de clientèle : 25 ans\n\nType de musique : Funk, soul, groove"
        ],
        "nl": [
          "Cocktailbar met livemuziek.\n\nGeopend van dinsdag tot donderdag van 17.00 tot 12.00 uur, vrijdag van 17.00 tot 1.00 uur en zaterdag van 17.00 tot 2.00 uur.\n\nKlantenkring : 25 jaar oud\n\nSoort muziek: Funk, soul, groove"
        ],
        "es": [
          "Bar de cócteles con música en directo.\n\nAbierto de martes a jueves de 17:00 a 00:00, viernes de 17:00 a 01:00 y sábados de 17:00 a 02:00.\n\nClientela : 25 años\n\nTipo de música : Funk, soul, groove"
        ]
      },
