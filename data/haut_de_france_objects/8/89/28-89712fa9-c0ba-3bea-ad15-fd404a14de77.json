      "@id": "https://data.datatourisme.fr/ad5f277d-8017-3365-838e-de4273955b1f",
      "dc:description": {
        "de": [
          "Neuer Verleihservice für Fahrräder mit elektrischer Unterstützung in der Domaine de Diane.\nEine neue Art, unser Gebiet zu entdecken, ohne sich abzumühen\nPreise: 1 Tag 35€ / 2 Tage 50 €"
        ],
        "en": [
          "New electric bike rental service at Domaine de Diane.\nA new way to discover our territory without getting tired\nRates : 1 day 35€ / 2 days 50 €"
        ],
        "it": [
          "Nuovo servizio di noleggio di biciclette a pedalata assistita presso il Domaine de Diane.\nUn nuovo modo per scoprire il nostro territorio senza stancarsi\nTariffe: 1 giorno 35 ? / 2 giorni 50 ?"
        ],
        "fr": [
          "Nouveau service de location de vélos à assistance électrique  au Domaine de Diane.\nUne nouvelle façon de découvrir notre territoire sans se fatiguer\nTarifs : 1 journée 35€ / 2 jours 50 €"
        ],
        "es": [
          "Nuevo servicio de alquiler de bicicletas con asistencia eléctrica en el Domaine de Diane.\nUna nueva forma de descubrir nuestro territorio sin cansarse\nTarifas: 1 día 35€ / 2 días 50€"
        ],
        "nl": [
          "Nieuwe elektrische fietsverhuur op Domaine de Diane.\nEen nieuwe manier om ons grondgebied te ontdekken zonder moe te worden\nTarieven: 1 day 35€ / 2 days 50 €"
        ]
      },
