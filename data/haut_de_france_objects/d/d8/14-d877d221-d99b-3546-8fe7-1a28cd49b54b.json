  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6ffdf087-9685-34b2-937a-74101b400be4",
      "dc:description": {
        "de": [
          "20:30 Uhr - Palais des Congrès - Ravel-Saal.\n\nMichel Jonasz kehrt mit Manu Katché und Jean-Yves d'Angelo auf einer Soul- und R&B-Tournee auf die Bühne zurück und lässt sein Repertoire mit talentierten Musikern neu aufleben."
        ],
        "en": [
          "8:30pm - Palais des Congrès - Salle Ravel.\n\nMichel Jonasz returns to the stage with Manu Katché and Jean-Yves d'Angelo for a Soul and R&B tour, revisiting his repertoire with talented musicians."
        ],
        "it": [
          "20.30 - Palazzo dei Congressi - Sala Ravel.\n\nMichel Jonasz torna sul palco con Manu Katché e Jean-Yves d'Angelo per un tour Soul e R&B, rivisitando il suo repertorio con musicisti di talento."
        ],
        "fr": [
          "20h30 - Palais des Congrès - Salle Ravel.\n\nMichel Jonasz revient sur scène avec Manu Katché et Jean-Yves d'Angelo pour une tournée Soul et R&B, revisitant son répertoire avec des musiciens talentueux."
        ],
        "es": [
          "20.30 h - Palacio de Congresos - Sala Ravel.\n\nMichel Jonasz vuelve a los escenarios con Manu Katché y Jean-Yves d'Angelo para una gira de Soul y R&B, revisitando su repertorio con músicos de talento."
        ],
        "nl": [
          "20.30 - Palais des Congrès - Salle Ravel.\n\nMichel Jonasz keert terug op het podium met Manu Katché en Jean-Yves d'Angelo voor een Soul en R&B tournee, waarbij hij zijn repertoire herneemt met getalenteerde muzikanten."
        ]
      },
