  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/6be69933-9b33-3d83-9aa8-43d3b4ee3bfb",
      "dc:description": {
        "de": [
          "Ein echter Ausverkauf, bei dem man alles Mögliche und vor allem sehr gute Angebote findet! Er findet in den Straßen André Milhamont, Révérend Père Hallluin und Napoleon statt\nZEITPLAN: von 7.00 bis 19.00 Uhr"
        ],
        "en": [
          "It's a veritable flea market, where you can find anything and everything, and especially great bargains! It takes place in Rues André Milhamont, Révérend Père Hallluin and Napoléon\nSCHEDULE: 7:00 a.m. to 7:00 p.m"
        ],
        "it": [
          "Si tratta di un vero e proprio mercato delle pulci, dove si può trovare di tutto e soprattutto delle ottime occasioni! Si svolge nelle vie André Milhamont, Révérend Père Hallluin e Napoléon\nPROGRAMMA: dalle 7.00 alle 19.00"
        ],
        "fr": [
          "Véritable braderie on y trouve de tout et surtout de très bonnes affaires ! Elle se déroule Rues André Milhamont, Révérend Père Hallluin, et Napoléon\nHORAIRE : de 7 h 00 à 19 h 00"
        ],
        "es": [
          "Se trata de un auténtico mercadillo en el que se puede encontrar de todo y, sobre todo, muy buenas gangas Tiene lugar en las calles André Milhamont, Révérend Père Hallluin y Napoléon\nHORARIO: de 7.00 a 19.00 h"
        ],
        "nl": [
          "Het is een echte vlooienmarkt, waar je van alles en nog wat kunt vinden, en vooral hele goede koopjes! Het vindt plaats in de Rue André Milhamont, Révérend Père Hallluin en Napoléon\nSCHEMA: 7.00 tot 19.00 uur"
        ]
      },
      "@type": [
        "Description"
      ],
