  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/4ba5e112-db12-36cf-b3da-155ea50fe429",
      "dc:description": {
        "de": [
          "Demarne ist ein Unternehmen in Boulogne, das sich auf die Vermarktung und Verarbeitung von Meeresfrüchten spezialisiert hat. Es bietet frischen Qualitätsfisch und Krustentiere von lokalen Fischauktionen an."
        ],
        "en": [
          "Demarne is a Boulonnais-based company specializing in the seafood trade, offering quality fresh fish and shellfish from local auctions."
        ],
        "it": [
          "Demarne è un'azienda del Boulonnais specializzata nel commercio del pesce e nella lavorazione dei prodotti ittici, che offre pesce e crostacei freschi di qualità provenienti da aste locali."
        ],
        "fr": [
          "Demarne est une entreprise boulonnaise spécialisée dans le mareyage et la transformation de produits de la mer, offrant poissons et crustacés frais de qualité issus des criées locales."
        ],
        "nl": [
          "Demarne is een bedrijf uit de Boulonnais dat gespecialiseerd is in de vishandel en de verwerking van visproducten en biedt verse kwaliteitsvis en schaaldieren van lokale veilingen."
        ],
        "es": [
          "Demarne es una empresa de Boulonnais especializada en el comercio de pescado y la transformación de productos del mar, que ofrece pescado y marisco fresco de calidad procedente de subastas locales."
        ]
      },
