  "rdfs:comment": {
    "de": [
      "Der Naturstandort Marest-Dampcourt ist in das europäische ökologische Netzwerk \"Natura 2000\" eingebunden und besteht aus den Standorten Grande Pâture und Grands Clos-Sud in Marest-Dampcourt und Forière-Nizard in Abbécourt."
    ],
    "en": [
      "Part of the European \"Natura 2000\" ecological network, the Marest-Dampcourt natural site comprises the Grande Pâture and Grands Clos-Sud sites in Marest-Dampcourt and the Forière-Nizard site in Abbécourt."
    ],
    "it": [
      "Parte della rete ecologica europea \"Natura 2000\", il sito naturale Marest-Dampcourt comprende i siti Grande Pâture e Grands Clos-Sud a Marest-Dampcourt e il sito Forière-Nizard ad Abbécourt."
    ],
    "fr": [
      "Intégré au réseau écologique européen \"Natura 2000\", le site naturel de Marest-Dampcourt est composé des sites de la Grande Pâture et des Grands Clos-Sud à Marest-Dampcourt et de la Forière-Nizard à Abbécourt."
    ],
    "es": [
      "Integrado en la red ecológica europea \"Natura 2000\", el paraje natural de Marest-Dampcourt comprende los parajes Grande Pâture y Grands Clos-Sud, en Marest-Dampcourt, y Forière-Nizard, en Abbécourt."
    ],
    "nl": [
      "Het natuurgebied Marest-Dampcourt maakt deel uit van het Europese ecologische netwerk \"Natura 2000\" en omvat de gebieden Grande Pâture en Grands Clos-Sud in Marest-Dampcourt en het gebied Forière-Nizard in Abbécourt."
    ]
  },
