  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/e7caa8f4-09d0-3fe1-b935-9716371d3f22",
      "dc:description": {
        "de": [
          "Restaurant und Austernbar.\nDienstags von 18.00 bis 22.00 Uhr geöffnet.\nMittwochs und donnerstags von 11:30 bis 15:00 Uhr und von 18:00 bis 22:00 Uhr.\nFreitags von 11:30 bis 15:00 Uhr und von 17:00 bis 23:00 Uhr.\nSamstags von 11:30 bis 16:00 Uhr und von 17:00 bis 23:00 Uhr.\nSonntagmorgen von 11.00 bis 15.00 Uhr."
        ],
        "en": [
          "Restaurant and oyster bar.\nOpen Tuesdays from 6pm to 10pm.\nWednesday and Thursday, 11:30 a.m. to 3 p.m. and 6 p.m. to 10 p.m.\nFriday, 11.30am to 3pm and 5pm to 11pm.\nSaturday from 11.30am to 4pm and from 5pm to 11pm.\nSunday morning from 11am to 3pm."
        ],
        "it": [
          "Ristorante e oyster bar.\nAperto il martedì dalle 18.00 alle 22.00.\nMercoledì e giovedì dalle 11.30 alle 15.00 e dalle 18.00 alle 22.00.\nVenerdì dalle 11.30 alle 15.00 e dalle 17.00 alle 23.00.\nSabato dalle 11.30 alle 16.00 e dalle 17.00 alle 23.00.\nDomenica mattina dalle 11.00 alle 15.00."
        ],
        "fr": [
          "Restaurant et bar à huîtres.\nOuvert le mardi de 18H à 22H.\nLe mercredi et jeudi de 11H30 à 15H et de 18H à 22H.\nLe vendredi de 11H30 à 15H et de 17H à 23H.\nLe samedi de 11H30 à 16H et de 17H à 23H.\nLe dimanche matin de 11H à 15H."
        ],
        "es": [
          "Restaurante y bar de ostras.\nAbierto los martes de 18.00 a 22.00 h.\nMiércoles y jueves de 11.30 h a 15 h y de 18 h a 22 h.\nViernes de 11.30 h a 15 h y de 17 h a 23 h.\nSábado de 11.30 a 16.00 y de 17.00 a 23.00.\nDomingo por la mañana de 11.00 a 15.00 h."
        ],
        "nl": [
          "Restaurant en oesterbar.\nGeopend op dinsdag van 18.00 tot 22.00 uur.\nWoensdag en donderdag van 11.30 tot 15.00 uur en van 18.00 tot 22.00 uur.\nVrijdag van 11.30 tot 15.00 uur en van 17.00 tot 23.00 uur.\nZaterdag van 11.30 tot 16.00 en van 17.00 tot 23.00.\nZondagochtend van 11.00 tot 15.00 uur."
        ]
      },
