  "rdfs:comment": {
    "de": [
      "Das Conservatoire des espaces naturels des Hauts-de-France organisiert zusammen mit der Gemeinde Saint-Pierre-ès-Champs eine Wanderung zu den Larris und den Torfmooren.\nAb 3 Jahren, Wanderschuhe mitbringen"
    ],
    "en": [
      "The Conservatoire des espaces naturels des Hauts-de-France and the commune of Saint-Pierre-ès-Champs are organizing a hike to Les Larris and Les Tourbières.\nFor children aged 3 and over, please bring walking shoes"
    ],
    "it": [
      "Il Conservatoire des espaces naturels des Hauts-de-France, in collaborazione con il comune di Saint-Pierre-ès-Champs, organizza un'escursione a Les Larris e Les Tourbières.\nI bambini dai 3 anni in su sono pregati di portare le scarpe da trekking"
    ],
    "fr": [
      "Le Conservatoire des espaces naturels des Hauts-de-France avec la commune de Saint-Pierre-ès-Champs, organise une randonnée aux Larris et aux Tourbières. \nA partir de 3 ans, prévoir chaussures de marche"
    ],
    "nl": [
      "Het Conservatoire des espaces naturels des Hauts-de-France organiseert in samenwerking met de gemeente Saint-Pierre-ès-Champs een wandeling naar Les Larris en Les Tourbières.\nVoor kinderen vanaf 3 jaar: neem wandelschoenen mee"
    ],
    "es": [
      "El Conservatoire des espaces naturels des Hauts-de-France, en colaboración con el municipio de Saint-Pierre-ès-Champs, organiza una excursión a Les Larris y Les Tourbières.\nPara los niños a partir de 3 años, se ruega llevar calzado de senderismo"
    ]
  },
