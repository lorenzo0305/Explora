      "dc:description": {
        "de": [
          "Treffpunkt ab 15 Uhr für einen vom Mini-Golf organisierten Nachmittag mit Gesellschaftsspielen, gefolgt von der Céline-Dion-Party ab 19:30 Uhr."
        ],
        "en": [
          "Join us at 3pm for an afternoon of board games organized by Mini-Golf, followed by the Céline Dion evening at 7:30pm."
        ],
        "it": [
          "Unitevi a noi dalle 15.00 per un pomeriggio di giochi da tavolo organizzato da Mini-Golf, seguito dalla serata Céline Dion dalle 19.30."
        ],
        "fr": [
          "Rendez-vous dès 15h pour une après-midi jeux de société organisé par le Mini-Golf, suivi de la soirée Céline Dion dès 19h30."
        ],
        "es": [
          "Únase a nosotros a partir de las 15.00 h para una tarde de juegos de mesa organizada por Mini-Golf, seguida de la velada de Céline Dion a partir de las 19.30 h."
        ],
        "nl": [
          "Doe mee vanaf 15.00 uur voor een middag gezelschapsspelletjes georganiseerd door Mini-Golf, gevolgd door de Céline Dion avond vanaf 19.30 uur."
        ]
      },
