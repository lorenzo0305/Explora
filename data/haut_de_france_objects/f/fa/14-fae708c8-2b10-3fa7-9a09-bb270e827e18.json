      "@id": "https://data.datatourisme.fr/cf32010a-5d81-3074-8934-1b7a48527cd3",
      "dc:description": {
        "de": [
          "In einem Landschaftspark gelegen, in der Nähe des Stadtzentrums.\nDie Salons du Pré Fleuri garantieren Ihnen die Qualität und den Erfolg Ihres Empfangs."
        ],
        "en": [
          "Located in a landscaped park, close to the town center.\nThe Pré Fleuri salons guarantee the quality and success of your reception."
        ],
        "it": [
          "Immerso in un parco paesaggistico, vicino al centro città.\nI saloni del Pré Fleuri garantiscono la qualità e il successo del vostro ricevimento."
        ],
        "fr": [
          "Situé dans un parc paysagé, près du centre ville.\nLes salons du Pré Fleuri vous garantissent la qualité et la réussite de votre réception."
        ],
        "es": [
          "Situado en un terreno ajardinado, cerca del centro de la ciudad.\nLos salones del Pré Fleuri garantizan la calidad y el éxito de su recepción."
        ],
        "nl": [
          "Gelegen op een aangelegd terrein, dicht bij het stadscentrum.\nDe lounges van Pré Fleuri staan garant voor de kwaliteit en het succes van uw receptie."
        ]
      },
