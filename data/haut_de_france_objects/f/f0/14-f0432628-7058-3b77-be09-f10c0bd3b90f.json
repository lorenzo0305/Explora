      "@id": "https://data.datatourisme.fr/81ae8929-784a-3ec0-b12a-a96107aa97b0",
      "dc:description": {
        "de": [
          "Begleiten Sie uns an einem außergewöhnlichen Tag voller Entdeckungen und Herausforderungen beim Klettern, mit drei spannenden Modulen für alle Niveaus! ab 1m10 von 11:00 bis 13:00 Uhr"
        ],
        "en": [
          "Join us for an exceptional day of climbing discoveries and challenges, with three exciting modules for all levels! from 1m10 upwards from 11am to 1pm"
        ],
        "it": [
          "Unisciti a noi per una giornata eccezionale di scoperte e sfide di arrampicata, con tre moduli emozionanti adatti a tutti i livelli! da 1m10 in su dalle 11.00 alle 13.00"
        ],
        "fr": [
          "Rejoignez nous pour une journée exceptionnelle de découvertes et de défis en escalade, avec trois modules captivants adaptés à tous les niveaux ! dès 1m10 de 11h à 13h"
        ],
        "nl": [
          "Doe mee aan een uitzonderlijke dag vol ontdekkingen en uitdagingen, met drie spannende modules geschikt voor alle niveaus! vanaf 1m10 van 11u tot 13u"
        ],
        "es": [
          "Acompáñanos en un día excepcional de descubrimientos y retos de escalada, con tres emocionantes módulos aptos para todos los niveles! a partir de 1m10 de 11h a 13h"
        ]
      },
