  "rdfs:comment": {
    "de": [
      "Der am Wasser und in der Nähe eines Waschhauses gelegene Platz von Saint-Rémy-en-l'Eau ist eine angenehme Pause für Ihr Mittagessen! Sie ist mit Tischen ausgestattet."
    ],
    "en": [
      "Located on the waterfront and near a wash-house, the Saint-Rémy-en-l'Eau area is a pleasant break for your lunch! It is equipped with tables."
    ],
    "it": [
      "Situata in riva al mare e vicino a un lavatoio, la zona di Saint-Rémy-en-l'Eau è un luogo piacevole per fermarsi a pranzo! È dotata di tavoli."
    ],
    "fr": [
      "Située au bord de l'eau et à proximité d'un lavoir, l'aire de Saint-Rémy-en-l'Eau est une pause agréable pour votre déjeuner ! Elle est aménagée avec des tables."
    ],
    "es": [
      "Situada a orillas del agua y cerca de un lavadero, la zona de Saint-Rémy-en-l'Eau es un lugar agradable para parar a comer Está equipado con mesas."
    ],
    "nl": [
      "In Saint-Rémy-en-l'Eau, gelegen aan het water en vlakbij een wasplaats, is het een aangename plek om te stoppen voor de lunch! Het is uitgerust met tafels."
    ]
  },
  "rdfs:label": {
    "fr": [
