  "rdfs:comment": {
    "de": [
      "Das Vieil Abreuvoir bietet Ihnen frische und saisonale Produkte, die alle hausgemacht sind! Sie können auch eine Bar oder einen Fitnessraum mit Sauna und Dampfbad nutzen."
    ],
    "en": [
      "Le Vieil Abreuvoir offers fresh seasonal produce, all homemade! There's also a bar and a fitness room with sauna and hammam."
    ],
    "it": [
      "Le Vieil Abreuvoir serve prodotti freschi di stagione, tutti fatti in casa! A disposizione anche un bar e una sala fitness con sauna e hammam."
    ],
    "fr": [
      "Le Vieil Abreuvoir vous propose des produits frais et de saison, le tout fait maison! Vous pourrez également profiter d'un bar ou d'une salle de fitness avec sauna et hammam."
    ],
    "es": [
      "Le Vieil Abreuvoir sirve productos frescos de temporada, todos caseros También hay un bar y una sala de fitness con sauna y hammam."
    ],
    "nl": [
      "Le Vieil Abreuvoir serveert verse seizoensproducten, allemaal zelfgemaakt! Er is ook een bar en een fitnessruimte met sauna en hammam."
    ]
