  "rdfs:comment": {
    "de": [
      "Nordische Spezialitäten mit dem berühmten Vollkorn-Welsh, Huhn mit Maroilles, flämische Karbonade, Garnelenkroketten...sowie eine Brasserie- und Pizzakarte."
    ],
    "en": [
      "Northern specialties include the famous complete Welsh, Maroilles chicken, Flemish carbonade, shrimp croquettes... as well as a brasserie and pizza menu."
    ],
    "it": [
      "Le specialità del nord includono il famoso Welsh integrale, il pollo con formaggio Maroilles, la carbonade fiamminga, le crocchette di gamberi... oltre a un menu da brasserie e pizze."
    ],
    "fr": [
      "Spécialités du Nord avec le fameux Welsh complet, poulet au Maroilles, carbonade Flamande, croquettes de Crevettes...ainsi qu'une carte brasserie et pizzas."
    ],
    "nl": [
      "Noordelijke specialiteiten zijn onder andere de beroemde volkoren Welsh, kip met Maroilles kaas, Vlaamse carbonade, garnalenkroketten... maar ook een brasseriemenu en pizza's."
    ],
    "es": [
      "Las especialidades del norte incluyen los famosos galeses integrales, pollo con queso Maroilles, carbonada flamenca, croquetas de gambas... así como un menú de brasserie y pizzas."
    ]
  },
