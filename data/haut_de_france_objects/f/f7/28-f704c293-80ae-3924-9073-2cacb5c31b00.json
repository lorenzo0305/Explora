  "rdfs:comment": {
    "de": [
      "Entdecken Sie gemeinsam mit dem Conservatoire d'espaces naturels des Hauts-de-France den Reichtum des Moors zu dieser Jahreszeit: Libellen und Demoisellen sowie Schmetterlinge und die typische Flora der Moore werden kein Geheimnis mehr für Sie sein?"
    ],
    "en": [
      "Join the Conservatoire d?espaces naturels des Hauts-de-France and discover the riches of the marsh at this time of year: dragonflies and damselflies, butterflies and typical peatland flora will hold no secrets for you?"
    ],
    "it": [
      "Unitevi al Conservatoire d'espaces naturels des Hauts-de-France e scoprite le ricchezze della palude in questo periodo dell'anno: libellule e damigelle, farfalle e flora tipica delle torbiere non avranno segreti per voi?"
    ],
    "fr": [
      "Rejoignez le Conservatoire d’espaces naturels des Hauts-de-France et découvrez les richesses du marais en cette saison : libellules et demoiselles ainsi que papillons et flore typiques des tourbières n’auront plus de secret pour vous…"
    ],
    "es": [
      "Únase al Conservatoire d'espaces naturels des Hauts-de-France y descubra las riquezas de la marisma en esta época del año: libélulas y caballitos del diablo, mariposas y la flora típica de las turberas no tendrán secretos para usted.."
    ],
    "nl": [
      "Ga mee met het Conservatoire d'espaces naturels des Hauts-de-France en ontdek de rijkdom van het moeras in deze tijd van het jaar: libellen en waterjuffers, vlinders en de typische veenflora zullen geen geheimen voor je hebben?"
    ]
  },
