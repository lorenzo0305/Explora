  "rdfs:comment": {
    "de": [
      "Das Restaurant de la Mairie befindet sich in Berry-au-Bac, 15 Minuten von Reims in Richtung Laon und in der Nähe der historischen Stätte des Chemin des Dames.\nAuf der Speisekarte dieses Tisches mit sehr freundlichem Empfang steht eine ganze Reihe traditioneller Gerichte, die Ihre Geschmacksknospen wecken werden!"
    ],
    "en": [
      "The restaurant of the Town Hall is located in Berry-au-Bac, 15 min from Reims in the direction of Laon and close to the historic site of the Chemin des Dames\nOn the menu at this very friendly reception, a whole range of traditional dishes that will wake up your taste buds!"
    ],
    "it": [
      "Il ristorante de la Mairie si trova a Berry-au-Bac, a 15 minuti da Reims sulla strada per Laon e vicino al sito storico dello Chemin des Dames.\nIl menu propone una serie di piatti tradizionali per stuzzicare il vostro palato!"
    ],
    "fr": [
      "Le restaurant de la Mairie est situé à Berry-au-Bac, à 15 min de Reims en direction de Laon et à proximité du site historique du Chemin des Dames. \nAu menu de cette table à l'accueil très sympathique, tout un ensemble de plats traditionnels qui vous réveilleront les papilles !"
    ],
    "nl": [
      "Het restaurant de la Mairie ligt in Berry-au-Bac, op 15 minuten van Reims op de weg naar Laon en vlakbij de historische site van de Chemin des Dames.\nOp het menu staat een reeks traditionele gerechten om je smaakpapillen te prikkelen!"
    ],
    "es": [
      "El restaurante de la Mairie está situado en Berry-au-Bac, a 15 minutos de Reims en dirección a Laon y cerca del sitio histórico del Chemin des Dames.\nEn su carta encontrará platos tradicionales para deleitar su paladar"
    ]
  },
