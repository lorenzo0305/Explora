      "dc:description": {
        "de": [
          "Ihr Führer zu Restaurants, hochwertigen Geschäften und Veranstaltungen in und um Montreuil-sur-Mer, der kulinarischen Hochburg im Hochland von Frankreich."
        ],
        "en": [
          "Your guide to restaurants, quality shops and events in and around Montreuil-sur-Mer, a culinary mecca in the upper reaches of France."
        ],
        "it": [
          "La vostra guida ai ristoranti, ai negozi di qualità e agli eventi di Montreuil-sur-Mer e dintorni, la mecca culinaria degli altipiani francesi."
        ],
        "fr": [
          "Votre guide de restaurants, commerces de qualité et événements, dans et autour de Montreuil-sur-Mer, haut lieu culinaire des hauts de France."
        ],
        "nl": [
          "Uw gids voor restaurants, kwaliteitswinkels en evenementen in en rond Montreuil-sur-Mer, het culinaire mekka van de Franse hooglanden."
        ],
        "es": [
          "Su guía de restaurantes, tiendas de calidad y eventos en Montreuil-sur-Mer y sus alrededores, la meca culinaria del altiplano francés."
        ]
      },
