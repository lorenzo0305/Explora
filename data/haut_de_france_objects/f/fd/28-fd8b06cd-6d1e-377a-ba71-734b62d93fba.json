  "rdfs:comment": {
    "de": [
      "Salon für feine Kaffeesorten. Verkostung und Verkauf von Kaffee aus der Region. Bio-Tees, Mate und Rooibos, Valrhona-Schokolade, reine Fruchtsäfte. Erfrischungsgetränke, Bier, Eis. Kleine süße und herzhafte Snacks aus eigener Herstellung zu jeder Zeit. Verzehr vor Ort oder zum Mitnehmen. Terrasse von Mai bis Oktober."
    ],
    "en": [
      "Fine coffee lounge. Tasting and sale of local coffee. Organic teas, mate and rooibos, Valrhona chocolate, pure fruit juice. Cold drinks, beers, ice creams. Sweet and savoury snacks made by craftsmen at any time. Consumption on the spot or to take away. Terrace from May to October."
    ],
    "it": [
      "Caffè raffinato. Degustazione e vendita di caffè locale. Tè biologici, mate e rooibos, cioccolato Valrhona, succo di frutta puro. Bevande fredde, birra, gelato. Spuntini dolci e salati fatti in casa in ogni momento. Consumare sul posto o portare via. Terrazza da maggio a ottobre."
    ],
    "fr": [
      "Salon de cafés fins. Dégustation et vente de café du terroir. Thés,  maté et rooibos bio, chocolat Valrhona, pur jus de fruits. Boissons fraîches, bières, glaces. Petite restauration sucrée et salée de fabrication artisanale à toute heure. Consommation sur place ou à emporter. Terrasse de mai à octobre."
    ],
    "es": [
      "Un buen salón de café. Degustación y venta de café local. Tés ecológicos, mate y rooibos, chocolate Valrhona, zumo de frutas puro. Bebidas frías, cerveza, helado. Aperitivos caseros dulces y salados en todo momento. Consumo in situ o para llevar. Terraza de mayo a octubre."
    ],
    "nl": [
      "Fijne koffielounge. Proeverij en verkoop van lokale koffie. Biologische thee, mate en rooibos, Valrhona chocolade, puur vruchtensap. Koude dranken, bier, ijs. Zelfgemaakte zoete en hartige snacks te allen tijde. Consumptie ter plaatse of om mee te nemen. Terras van mei tot oktober."
    ]
  },
