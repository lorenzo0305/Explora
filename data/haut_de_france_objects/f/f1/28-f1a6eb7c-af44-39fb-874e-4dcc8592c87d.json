  "rdfs:comment": {
    "de": [
      "Gönnen Sie sich eine entspannende Pause im Brune River Spa. Genießen Sie einen Whirlpool und eine Sauna, die perfekt für einen Moment der Entspannung und des Wohlbefindens sind."
    ],
    "en": [
      "Treat yourself to a relaxing break at the Brune River Spa. Enjoy a Jacuzzi and sauna, perfect for a moment of relaxation and well-being."
    ],
    "it": [
      "Concedetevi una pausa rilassante alla Brune River Spa. Godetevi la vasca idromassaggio e la sauna, perfette per un momento di relax e benessere."
    ],
    "fr": [
      "Offrez-vous une pause détente au Brune River Spa. Profitez d’un jacuzzi et d’un sauna, parfaits pour un moment de relaxation et de bien-être."
    ],
    "nl": [
      "Trakteer jezelf op een ontspannende pauze in de Brune River Spa. Geniet van een jacuzzi en sauna, perfect voor een moment van ontspanning en welzijn."
    ],
    "es": [
      "Regálese un descanso relajante en el Spa Brune River. Disfrute de un jacuzzi y una sauna, perfectos para un momento de relajación y bienestar."
    ]
  },
