  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/52852ce7-366f-372c-9c2a-3562c752874f",
      "dc:description": {
        "de": [
          "Geburtstage, Feste mit der Familie/mit Freunden, Seminare, ... für alle Arten von Veranstaltungen stellt Ihnen Ihr Caterer Au fil des Papilles gerne ein maßgeschneidertes Menü aus saisonalen und hausgemachten Produkten zusammen."
        ],
        "en": [
          "Birthday parties, celebrations with family and friends, seminars... for all types of events, your Au fil des Papilles caterer will be delighted to create a customized menu using seasonal, home-made products."
        ],
        "it": [
          "Feste di compleanno, feste con la famiglia e gli amici, seminari... per ogni tipo di evento, il vostro catering Au fil des Papilles sarà lieto di creare un menu su misura utilizzando prodotti stagionali e fatti in casa."
        ],
        "fr": [
          "Anniversaire, fêtes en famille / entre amis, séminaire, ... pour tous types d'événements, votre traiteur Au fil des Papilles se fera un plaisir de vous concocter un menu sur mesure avec des produits de saison et fait maison."
        ],
        "nl": [
          "Verjaardagsfeestjes, feesten met familie en vrienden, seminaries... voor alle soorten evenementen stelt uw traiteur van Au fil des Papilles graag een menu op maat samen met seizoensproducten en huisbereide producten."
        ],
        "es": [
          "Fiestas de cumpleaños, celebraciones con la familia y los amigos, seminarios... para todo tipo de eventos, su servicio de catering Au fil des Papilles estará encantado de crear un menú a medida con productos caseros y de temporada."
        ]
      },
