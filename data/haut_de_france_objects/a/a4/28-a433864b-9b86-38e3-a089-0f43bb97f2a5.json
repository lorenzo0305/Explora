  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a9342c7a-ab4a-3617-93ea-cc22d300d7db",
      "dc:description": {
        "de": [
          "Nur wenige Schritte von der berühmten Kathedrale von Laon entfernt liegt das Le Palais Gourmand, ein Restaurant/Crêperie, das authentische Küche im französischen Chic anbietet!\n\nINFO +: bietet auch vegetarische Gerichte an"
        ],
        "en": [
          "Just a stone's throw from Laon's famous cathedral, Le Palais Gourmand is a restaurant/crêperie offering authentic cuisine in chic French style!\n\nINFO + : offers vegetarian dishes"
        ],
        "it": [
          "A pochi passi dalla famosa cattedrale di Laon, Le Palais Gourmand è un ristorante/crêperie che offre una cucina autentica in stile francese chic!\n\nINFO + : offre piatti vegetariani"
        ],
        "fr": [
          "À deux pas de la célèbre cathédrale de Laon, Le Palais Gourmand est un restaurant/crêperie proposant une cuisine authentique dans un style chic français !\n\nINFO + : propose des plats végétariens"
        ],
        "nl": [
          "Op een steenworp afstand van de beroemde kathedraal van Laon ligt Le Palais Gourmand, een restaurant/crêperie met een authentieke keuken in chique Franse stijl!\n\nINFO + : biedt vegetarische gerechten"
        ],
        "es": [
          "A dos pasos de la célebre catedral de Laon, Le Palais Gourmand es un restaurante-crepería que ofrece auténtica cocina al más puro estilo francés\n\nINFO + : ofrece platos vegetarianos"
        ]
      },
      "@type": [
        "Description"
      ],
