  "rdfs:comment": {
    "de": [
      "Treten Sie in die Pedale und begegnen Sie der Landschaft.\nAm Anfang der Strecke entdecken Sie die Abteikirche und die Heilige Kapelle von Saint Germer de Fly ungefähr in der Gemeinde Lalandelle, einen Orientierungstisch mit Blick auf die Knopflochlandschaft des Pays de Bray."
    ],
    "en": [
      "Pedal to the country.\nAt the start of the circuit discover the abbey church and the Sainte Chapelle de Saint Germer de Fly in the vicinity of the town of Lalandelle, an orientation table with a view of the buttonhole of the Pays de Bray."
    ],
    "it": [
      "Pedalate attraverso la campagna.\nAll'inizio del circuito, scoprite la chiesa abbaziale e la Sainte Chapelle de Saint Germer de Fly nei pressi della città di Lalandelle, una tavola d'orientamento con vista sulla bottoniera del Pays de Bray."
    ],
    "fr": [
      "Pédalez à la rencontre de la campagne.\nAu départ du circuit découvrez l'abbatiale et la Sainte Chapelle de Saint Germer de Fly au environ de la commune de Lalandelle, une table d'orientation avec une vue sur la boutonnière du Pays de Bray."
    ],
    "nl": [
      "Trap je weg door het platteland.\nOntdek aan het begin van het circuit de abdijkerk en de Sainte Chapelle de Saint Germer de Fly in de nabijheid van de stad Lalandelle, een oriëntatietafel met uitzicht op het knooppunt Pays de Bray."
    ],
    "es": [
      "Pedalea por el campo.\nAl inicio del circuito, descubra la iglesia abacial y la Sainte Chapelle de Saint Germer de Fly en las proximidades de la ciudad de Lalandelle, una mesa de orientación con vistas al ojal del Pays de Bray."
    ]
  },
