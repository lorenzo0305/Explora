  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/bee21574-1401-3cca-8f44-38cffc4c7697",
      "dc:description": {
        "de": [
          "Einladender und erholsamer Rahmen im Stadtzentrum, traditionelle und familiäre Küche. Im Stadtzentrum gegenüber dem Theater, angenehme und einladende Bar Brasserie."
        ],
        "en": [
          "Friendly and relaxing setting in the town centre, traditional and family cuisine. Right in the town centre opposite the theatre, pleasant and welcoming bar-brasserie."
        ],
        "it": [
          "Ambiente accogliente e rilassante nel centro della città, cucina tradizionale e familiare. Nel centro della città, di fronte al teatro, un bar-brasserie piacevole e accogliente."
        ],
        "fr": [
          "Cadre accueillant et reposant en centre ville, cuisine traditionnelle et familiale. En plein centre ville en face du théâtre, bar brasserie agréable et accueillant."
        ],
        "nl": [
          "Gastvrije en ontspannende omgeving in het stadscentrum, traditionele en familiale keuken. In het stadscentrum tegenover het theater, een gezellige en gastvrije bar-brasserie."
        ],
        "es": [
          "Ambiente acogedor y relajante en el centro de la ciudad, cocina tradicional y familiar. En el centro de la ciudad, frente al teatro, un bar-brasserie agradable y acogedor."
        ]
      },
