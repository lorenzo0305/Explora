      "@id": "https://data.datatourisme.fr/5c6a485d-5889-3573-9a7d-122c50627ece",
      "dc:description": {
        "de": [
          "Das Maison du Pêcheur ist ein restauriertes Haus aus den 1900er Jahren, das repräsentativ für die traditionelle Wohnweise der Fischerfamilien eingerichtet ist."
        ],
        "en": [
          "La Maison du Pêcheur (The Fisherman's House) is a restored house dating from the 1900s, furnished in a way that is representative of the traditional home of fishing families."
        ],
        "it": [
          "La Maison du Pêcheur è una casa restaurata risalente al 1900 e arredata in modo da rappresentare la casa tradizionale delle famiglie di pescatori."
        ],
        "fr": [
          "La Maison du Pêcheur est une maison restaurée des années 1900 et meublée de façon représentative de l'habitat traditionnel des familles de pêcheurs."
        ],
        "nl": [
          "La Maison du Pêcheur is een gerestaureerd huis uit de jaren 1900 en ingericht op een manier die representatief is voor het traditionele huis van vissersfamilies."
        ],
        "es": [
          "La Maison du Pêcheur es una casa restaurada que data de 1900 y amueblada de forma representativa del hogar tradicional de las familias de pescadores."
        ]
      },
