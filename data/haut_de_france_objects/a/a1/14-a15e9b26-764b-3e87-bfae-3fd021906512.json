  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/f450539e-c723-37b7-8468-da279d603f3d",
      "dc:description": {
        "de": [
          "Moules de Bouchot du Mont Saint-Frieux bietet frische und schmackhafte Muscheln an, die auf den Bouchots der Côte d'Opale gezüchtet werden. Dabei werden die traditionellen Zuchtmethoden eingehalten und Qualität, Geschmack und Frische für Verbraucher und Gastronomen garantiert."
        ],
        "en": [
          "Moule de Bouchot du Mont Saint-Frieux offers fresh, tasty mussels raised on the bouchots of the Côte d'Opale, respecting traditional cultivation methods and guaranteeing quality, taste and freshness for consumers and restaurateurs."
        ],
        "it": [
          "Il Moule de Bouchot du Mont Saint-Frieux offre cozze fresche e gustose allevate sui bouchot della Côte d'Opale, rispettando i metodi di coltivazione tradizionali e garantendo qualità, gusto e freschezza a consumatori e ristoratori."
        ],
        "fr": [
          "Moule de Bouchot du Mont Saint-Frieux propose des moules fraîches et savoureuses, élevées sur les bouchots de la Côte d’Opale, respectant les méthodes traditionnelles de culture et garantissant qualité, goût et fraîcheur pour les consommateurs et restaurateurs."
        ],
        "es": [
          "Moule de Bouchot du Mont Saint-Frieux ofrece mejillones frescos y sabrosos criados en los bouchots de la Côte d'Opale, siguiendo métodos de cultivo tradicionales y garantizando calidad, sabor y frescura a consumidores y restauradores."
        ],
        "nl": [
          "Moule de Bouchot du Mont Saint-Frieux biedt verse, smakelijke mosselen gekweekt op de bouchots van de Côte d'Opale, met respect voor traditionele kweekmethoden en een garantie voor kwaliteit, smaak en versheid voor consumenten en restaurateurs."
        ]
      },
      "@type": [
        "Description"
      ],
