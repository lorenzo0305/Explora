  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/616d73bc-bc0a-3507-b4f7-934a77b79b66",
      "dc:description": {
        "de": [
          "Gesamtkapazität: 100 Personen (3 Räume).\n\nArt der Kundschaft: 25/30.\n\nAkzeptierte Gruppen von 15 bis 50 Personen.\n\nGeöffnet Montag, Dienstag, Mittwoch und Sonntag von 16:00 bis 1:00 Uhr und Donnerstag, Freitag und Samstag von 16:00 bis 3:00 Uhr.\n\nArt der Musik: POP ROCK."
        ],
        "en": [
          "Total capacity: 100 people (3 rooms).\n\nClientele: 25/30.\n\nGroups accepted from 15 to 50 people.\n\nOpen Monday, Tuesday, Wednesday and Sunday from 4pm to 1am and Thursday, Friday and Saturday from 4pm to 3am.\n\nType of music: POP ROCK."
        ],
        "it": [
          "Capacità totale: 100 persone (3 sale).\n\nClientela: 25/30.\n\nSi accettano gruppi da 15 a 50 persone.\n\nAperto lunedì, martedì, mercoledì e domenica dalle 16.00 all'1.00 e giovedì, venerdì e sabato dalle 16.00 alle 3.00.\n\nTipo di musica: POP ROCK."
        ],
        "fr": [
          "Capacité totale : 100 personnes (3 salles).\n\nType de clientèle : 25/30.\n\nGroupes acceptés de 15 à 50 personnes.\n\nOuvert lundi, mardi, mercredi et dimanche de 16h à 1h et jeudi, vendredi et samedi de 16h à 3h.\n\nType de musique : POP ROCK."
        ],
        "nl": [
          "Totale capaciteit: 100 personen (3 zalen).\n\nKlantenkring: 25/30.\n\nGroepen van 15 tot 50 personen worden geaccepteerd.\n\nGeopend op maandag, dinsdag, woensdag en zondag van 16.00 tot 01.00 uur en op donderdag, vrijdag en zaterdag van 16.00 tot 03.00 uur.\n\nSoort muziek: POP ROCK."
        ],
        "es": [
          "Capacidad total: 100 personas (3 salas).\n\nClientela: 25/30.\n\nSe aceptan grupos de 15 a 50 personas.\n\nAbierto lunes, martes, miércoles y domingo de 16:00 a 01:00 y jueves, viernes y sábado de 16:00 a 03:00.\n\nTipo de música: POP ROCK."
        ]
      },
