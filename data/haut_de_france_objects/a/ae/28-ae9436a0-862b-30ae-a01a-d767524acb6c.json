  "rdfs:comment": {
    "de": [
      "Restaurant in Mers-les-Bains.\nDirekt am Meer, Bistro-Küche. Spezialitäten: Fisch (lokaler Fischfang), Meeresfrüchte, regionale Produkte. 39 Sitzplätze, 40 auf der Terrasse (auf der Esplanade). Im Januar geschlossen. Montags geschlossen außer Juli und August.\nMitglied des Fremdenverkehrsamts von Mers-Les-Bains.\n\nMittags und abends 7/7 Tage geöffnet"
    ],
    "en": [
      "Restaurant located in Mers-les-Bains.\nFacing the sea, Bistro kitchen. Specialities: fish (local fishing), seafood, regional products. 39 covers, 40 on the terrace (on the esplanade). Closed in January. Closed on Mondays except July-August.\nMember of the Tourist Office of Mers-Les-Bains.\n\nOpen for lunch and dinner 7/7"
    ],
    "it": [
      "Ristorante situato a Mers-les-Bains.\nDi fronte al mare, cucina bistrot. Specialità: pesce (pesca locale), frutti di mare, prodotti regionali. 39 coperti, 40 sulla terrazza (sulla spianata). Chiuso a gennaio. Chiuso il lunedì, tranne in luglio e agosto.\nMembro dell'Ufficio del Turismo di Mers-Les-Bains.\n\nAperto a pranzo e a cena 7/7"
    ],
    "fr": [
      "Restaurant situé à Mers-les-Bains.\nFace à la mer, Cuisine de bistrot. Spécialités : poissons (pêche locale), fruits de mer, produits régionaux. 39 couverts, 40 en terrasse (sur l'esplanade). Fermé en janvier. Fermé le lundi sauf juillet-août.\nAdhérent à l'Office de Tourisme de Mers-Les-Bains.\n\nOuvert midi et soir 7/7j"
    ],
    "es": [
      "Restaurante situado en Mers-les-Bains.\nFrente al mar, cocina de bistró. Especialidades: pescado (pesca local), marisco, productos regionales. 39 cubiertos, 40 en la terraza (en la explanada). Cerrado en enero. Cerrado los lunes, excepto en julio y agosto.\nMiembro de la Oficina de Turismo de Mers-Les-Bains.\n\nAbierto para el almuerzo y la cena 7/7"
    ],
    "nl": [
      "Restaurant gelegen in Mers-les-Bains.\nMet uitzicht op zee, bistrokeuken. Specialiteiten: vis (lokale visserij), zeevruchten, regionale producten. 39 couverts, 40 op het terras (op de boulevard). Gesloten in januari. Gesloten op maandag, behalve in juli en augustus.\nLid van de toeristische dienst van Mers-Les-Bains.\n\nOpen voor lunch en diner 7/7"
    ]
  },
