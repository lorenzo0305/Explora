  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d4c93258-b510-3434-a119-1a698f5cfc8c",
      "dc:description": {
        "de": [
          "Die Ferme de la Cluse ist auf die Produktion von Rindfleisch aus eigenem Anbau spezialisiert.\nDer Hof bietet einen Direktverkauf auf Bestellung an, ausschließlich in 5- oder 10-kg-Paketen, so dass man von Qualitätsfleisch auf kurzem Wege profitieren kann."
        ],
        "en": [
          "Ferme de la Cluse specializes in the production of beef from the farm.\nThe farm offers direct sales to order, exclusively in 5 or 10 kg packages, enabling you to benefit from quality meat in a short circuit."
        ],
        "it": [
          "La Ferme de la Cluse è specializzata nella produzione di carne bovina di fattoria.\nLa fattoria offre la vendita diretta su ordinazione, esclusivamente in confezioni da 5 o 10 kg, in modo da poter gustare carne di qualità in un circuito breve."
        ],
        "fr": [
          "La Ferme de la Cluse est spécialisée dans la production de viande bovine issue de l’exploitation.\nLa ferme propose une vente directe sur commande, exclusivement en colis de 5 ou 10 kg, permettant de bénéficier d’une viande de qualité en circuit court."
        ],
        "nl": [
          "Ferme de la Cluse is gespecialiseerd in de productie van rundvlees van de boerderij.\nDe boerderij biedt directe verkoop op bestelling, uitsluitend in verpakkingen van 5 of 10 kg, zodat je in een kort circuit kunt genieten van kwaliteitsvlees."
        ],
        "es": [
          "Ferme de la Cluse está especializada en la producción de carne de vacuno de granja.\nLa granja ofrece venta directa por encargo, exclusivamente en paquetes de 5 o 10 kg, para que pueda disfrutar de carne de calidad en un circuito corto."
        ]
      },
      "@type": [
        "Description"
      ],
