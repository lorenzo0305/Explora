  "rdfs:comment": {
    "de": [
      "Erzähl mir eine Geschichte!\nWelches Kind hat sich nicht schon einmal gewünscht, dass ihm vor dem Schlafengehen eine Geschichte vorgelesen wird? Unsere Märchentour führt Sie zu Paul, einem Sportsoldaten im Ersten Weltkrieg."
    ],
    "en": [
      "Tell me a story!\nWhat child hasn't asked to be read a bedtime story? Our storytelling tour takes you to meet Paul, a sports soldier in the First World War."
    ],
    "it": [
      "Raccontami una storia!\nQuale bambino non ha mai chiesto che gli venisse letta una storia della buonanotte? Il nostro tour di narrazione vi porta a conoscere Paul, un soldato sportivo della Prima Guerra Mondiale."
    ],
    "fr": [
      "Raconte moi une histoire !\nQuel enfant n’a jamais demandé de lui lire une histoire avant d’aller dormir ? Notre visite contée vous emmène à la rencontre de Paul, soldat sportif pendant la Première Guerre mondiale."
    ],
    "nl": [
      "Vertel me een verhaaltje!\nWelk kind heeft er niet om een verhaaltje voor het slapengaan gevraagd? Onze verteltocht neemt je mee naar Paul, een sportsoldaat in de Eerste Wereldoorlog."
    ],
    "es": [
      "Cuéntame un cuento\n¿Qué niño no ha pedido alguna vez que le lean un cuento? Nuestro cuentacuentos te lleva a conocer a Paul, un soldado deportista de la Primera Guerra Mundial."
    ]
  },
  "rdfs:label": {
