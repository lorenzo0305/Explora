  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/2d816fa6-161e-3d43-b79f-7f84621f75cb",
      "dc:description": {
        "de": [
          "Umweltfreundliche Guinguette / Freiluftbar mit den Füßen im Sand\n- Ohne Reservierungen\n- Konzerte, Veranstaltungen\n- Fußballweltmeisterschaft auf Großleinwand\n- Bar\n- Hausgemachte Küche\n- Lokale Produkte\n\nNachhaltiger Ansatz: Anti-Verschwendung, kurze Wege, lokale Produkte, ökologisch verantwortungsbewusster Ort (wiederverwertete Materialien, Trockentoiletten), ökologische Reinigungsprodukte"
        ],
        "en": [
          "Eco-responsible guinguette / open-air bar with your feet in the sand\n- No reservations required\n- Concerts, events\n- World Cup on giant screen\n- Bar\n- Home cooking\n- Local products\n\nSustainable approach: anti-gasppi, short circuit, local products, eco-responsible venue (recycled materials, dry toilets), ecological cleaning products"
        ],
        "it": [
          "Guinguette eco-responsabile / bar all'aperto con i piedi nella sabbia\n- Nessuna prenotazione\n- Concerti, eventi\n- Coppa del Mondo su schermo gigante\n- Bar\n- Cucina casalinga\n- Prodotti locali\n\nApproccio sostenibile: anti-gasppi, cortocircuito, prodotti locali, sede eco-responsabile (materiali riciclati, servizi igienici a secco), prodotti di pulizia ecologici"
        ],
        "fr": [
          "Guinguette Écoresponsable / bar de plein air les pieds dans le sable\n- Sans réservations \n- Concerts, événements \n- Coupe du monde sur écran géant \n- Bar \n- Cuisine maison \n- Produits locaux\n\nDémarche durable : anti gaspi, circuit court, produits locaux, lieu eco responsable (matériaux de récupération, toilettes sèches), produits d'entretien écologiques"
        ],
        "nl": [
          "Milieuvriendelijke Guinguette / openluchtbar met je voeten in het zand\n- Geen reserveringen\n- Concerten, evenementen\n- Wereldkampioenschap voetbal op reuzenscherm\n- Bar\n- Thuis koken\n- Lokale producten\n\nDuurzame aanpak: antigasppi, kortsluiting, lokale producten, ecologisch verantwoorde locatie (gerecycleerde materialen, droge toiletten), ecologische schoonmaakproducten"
        ],
        "es": [
          "Guinguette ecorresponsable / bar al aire libre con los pies en la arena\n- Sin reservas\n- Conciertos, eventos\n- Mundial en pantalla gigante\n- Bar\n- Cocina casera\n- Productos locales\n\nEnfoque sostenible: antigasppi, cortocircuito, productos locales, lugar de celebración ecorresponsable (materiales reciclados, aseos secos), productos de limpieza ecológicos"
        ]
      },
