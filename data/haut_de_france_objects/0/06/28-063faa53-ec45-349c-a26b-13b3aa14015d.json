  "rdfs:comment": {
    "de": [
      "Ein bemerkenswertes Naturgebiet entlang des Sommetals (in Richtung der Bucht). Ein Labyrinth aus Sümpfen und torfigen Teichen (einer der größten des Tals), die durch kleine Stege verbunden sind, die einem das Gefühl geben, auf dem Wasser zu laufen. Schöne Wanderung von 3 km - leicht - Picknicktische."
    ],
    "en": [
      "A remarkable natural area along the Somme Valley (towards the Bay). A maze of marshes and peat ponds (one of the largest in the valley), linked by small footbridges that give the impression of walking on water. Nice 3km walk - easy - picnic tables."
    ],
    "it": [
      "Un'area naturale straordinaria lungo la valle della Somme (verso la baia). Un labirinto di paludi e stagni di torba (uno dei più grandi della valle), collegati da piccole passerelle che danno l'impressione di camminare sull'acqua. Bella passeggiata di 3 km - facile - tavoli da picnic."
    ],
    "fr": [
      "Un espace naturel remarquable le long de la Vallée de Somme (en direction de la Baie). Un dédale de marais et d'étangs tourbeux (l'un des plus vastes de la vallée), reliés par des petites passerelles qui donnent l'impression de marcher sur l'eau. Belle balade de 3km - facile - tables de pique-nique."
    ],
    "es": [
      "Un espacio natural notable a lo largo del valle del Somme (hacia la bahía). Un laberinto de marismas y estanques de turba (uno de los más grandes del valle), unidos por pequeñas pasarelas que dan la impresión de caminar sobre el agua. Bonito paseo de 3 km - fácil - mesas de picnic."
    ],
    "nl": [
      "Een opmerkelijk natuurgebied langs de vallei van de Somme (in de richting van de baai). Een doolhof van moerassen en veenplassen (een van de grootste in de vallei), verbonden door kleine loopbruggen die de indruk wekken over water te lopen. Mooie wandeling van 3 km - gemakkelijk - picknicktafels."
    ]
  },
  "rdfs:label": {
