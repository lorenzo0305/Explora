  "rdfs:comment": {
    "de": [
      "Vom 24. Juni bis zum 6. Juli 2025 werden die größten Skipper zu einer 2000 Meilen langen Reise um die Britischen Inseln aufbrechen, ein intensives menschliches und sportliches Abenteuer, das ihr Können und ihre Ausdauer auf die Probe stellen wird."
    ],
    "en": [
      "From June 24 to July 6, 2025, the world's greatest skippers will set off on a 2,000-mile voyage around the British Isles, an intense human and sporting adventure that will put their skills and endurance to the test."
    ],
    "it": [
      "Dal 24 giugno al 6 luglio 2025, i più grandi skipper partiranno per un viaggio di 2.000 miglia intorno alle isole britanniche, un'intensa avventura umana e sportiva che metterà alla prova le loro abilità e la loro resistenza."
    ],
    "fr": [
      "Du 24 juin au 6 juillet 2025, les plus grands skippers s'élanceront pour un parcours de 2000 milles autour des îles Britanniques, une aventure humaine et sportive intense qui mettra à rude épreuve leurs compétences et leur endurance."
    ],
    "nl": [
      "Van 24 juni tot 6 juli 2025 zullen de beste schippers vertrekken voor een reis van 2.000 mijl rond de Britse eilanden, een intens menselijk en sportief avontuur dat hun vaardigheden en uithoudingsvermogen op de proef zal stellen."
    ],
    "es": [
      "Del 24 de junio al 6 de julio de 2025, los mejores patrones emprenderán un viaje de 3.000 kilómetros alrededor de las Islas Británicas, una intensa aventura humana y deportiva que pondrá a prueba sus habilidades y su resistencia."
    ]
  },
