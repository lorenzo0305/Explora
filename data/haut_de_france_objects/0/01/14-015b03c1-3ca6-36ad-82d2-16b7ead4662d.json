  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/d41dc994-3d06-3972-91b7-a5d1b9be8b3e",
      "dc:description": {
        "de": [
          "Organisiert von der Stadt Carvin in Partnerschaft mit Le Cirque du Bout du Monde, im Rahmen der Veranstaltungssaison Plaisirs d'automne\n\"Ein Traum, wie ein Fenster auf ein Stück Himmel, öffnet sich für unsere Sinne und unsere Vorstellungskraft\""
        ],
        "en": [
          "Organized by the town of Carvin in partnership with Le Cirque du Bout du Monde, as part of the Plaisirs d'automne entertainment season\n\"A dream, like a window on a piece of sky, opens onto our senses and our imaginations.\""
        ],
        "it": [
          "Organizzato dalla città di Carvin in collaborazione con Le Cirque du Bout du Monde, nell'ambito della stagione di eventi Plaisirs d'automne\n\"Un sogno, come una finestra su un pezzo di cielo, si apre sui nostri sensi e sulla nostra immaginazione\""
        ],
        "fr": [
          "Organisé par la ville de Carvin en partenariat avec Le Cirque du Bout du Monde, dans le cadre de la saison d'animations Plaisirs d'automne\n\"Un songe, comme une fenêtre sur un morceau de ciel, s’ouvre sur nos sens et nos imaginaires.\""
        ],
        "es": [
          "Organizado por la ciudad de Carvin en colaboración con Le Cirque du Bout du Monde, en el marco de la temporada de eventos Plaisirs d'automne\n\"Un sueño, como una ventana en un trozo de cielo, se abre a nuestros sentidos y a nuestra imaginación\""
        ],
        "nl": [
          "Georganiseerd door de stad Carvin in samenwerking met Le Cirque du Bout du Monde, in het kader van het evenementenseizoen Plaisirs d'automne\n\"Een droom, als een venster op een stuk hemel, opent onze zintuigen en onze verbeelding.\""
        ]
      },
      "@type": [
        "Description"
