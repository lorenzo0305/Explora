      "@id": "https://data.datatourisme.fr/a54b77bc-2437-3e73-9f6e-e06ce7a7e7e7",
      "dc:description": {
        "de": [
          "Von Samstag, dem 4. Februar bis Sonntag, dem 5. März 2023\n\nHier finden Sie das Programm der Kinderanimationen während der Winterferien zum Herunterladen.\nLaden Sie das Programm hier herunter: https://fr.calameo.com/read/003186059d9604edf757e"
        ],
        "en": [
          "Saturday, February 4 to Sunday, March 5, 2023\n\nDownload the children's program for the winter vacations.\nDownload the program here: https://fr.calameo.com/read/003186059d9604edf757e"
        ],
        "it": [
          "Da sabato 4 febbraio a domenica 5 marzo 2023\n\nScarica il programma per bambini per le vacanze invernali.\nScarica il programma qui: https://fr.calameo.com/read/003186059d9604edf757e"
        ],
        "fr": [
          "Du samedi 4 février au dimanche 5 mars 2023\n\nRetrouvez en téléchargement le programme des animations pour enfants pendant les vacances d'hiver.\nTélécharger le programme ici : https://fr.calameo.com/read/003186059d9604edf757e"
        ],
        "nl": [
          "Van zaterdag 4 februari tot zondag 5 maart 2023\n\nDownload het kinderprogramma voor de wintervakantie.\nDownload hier het programma: https://fr.calameo.com/read/003186059d9604edf757e"
        ],
        "es": [
          "Del sábado 4 de febrero al domingo 5 de marzo de 2023\n\nDescargue el programa infantil para las vacaciones de invierno.\nDescargue el programa aquí: https://fr.calameo.com/read/003186059d9604edf757e"
        ]
      },
