  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/877dd2c4-ada8-3f1c-aa69-4c0b8e9e3476",
      "dc:description": {
        "de": [
          "Offen für alle, organisiert von der Elternvereinigung.\nKomm und amüsiere dich untereinander, aber auch in deiner schönsten Verkleidung.\nKleine Verpflegung vor Ort, Geschenke und Überraschungen zu gewinnen."
        ],
        "en": [
          "Open to all, organized by the parents' association.\nCome and join in the fun in your best disguise.\nSnacks on site, gifts and surprises to be won."
        ],
        "it": [
          "Aperto a tutti, organizzato dall'Associazione Genitori.\nVieni a divertirti con i tuoi amici con il tuo travestimento migliore.\nMerenda sul posto, premi e sorprese in palio."
        ],
        "fr": [
          "Ouvert à tous, organisé par l'association des parents d'élèves.\nViens t'éclater entre mais avec ton plus beau déguisement.\nPetite restauration sur place, cadeaux et surprises à gagner."
        ],
        "nl": [
          "Open voor iedereen, georganiseerd door de oudervereniging.\nKom plezier maken met je vrienden in je beste vermomming.\nSnacks ter plaatse, prijzen en verrassingen te winnen."
        ],
        "es": [
          "Abierto a todos, organizado por la Asociación de Padres.\nVen a divertirte con tus amigos con tu mejor disfraz.\nMerienda in situ, premios y sorpresas para ganar."
        ]
      },
      "@type": [
