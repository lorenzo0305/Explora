      "dc:description": {
        "de": [
          "La voie d'Aznavour mit Titiano begleitet von Éric Wilms am Klavier Dirigent von Monsieur Aznavour am Samstag, den 07. Juni 2025 um 20:30 Uhr im Kursaal von Berck\n\nTarife:\nErmäßigt: 10?\nVoller Preis : 15?\nKartenvorverkauf: Casino, Tourismusbüro und Ticketmaster."
        ],
        "en": [
          "La voie d'Aznavour with Titiano accompanied by Éric Wilms on piano, conductor of Monsieur Aznavour's orchestra, Saturday, June 07, 2025 at 8:30 pm at the Kursaal in Berck\n\nTickets\nReduced : 10?\nFull: 15?\nTickets available at: casino, tourist office and ticketmaster."
        ],
        "it": [
          "La voie d'Aznavour con Titiano accompagnato al pianoforte da Éric Wilms, direttore dell'orchestra di Monsieur Aznavour, sabato 07 giugno 2025 alle 20.30 al Kursaal di Berck\n\nBiglietti :\nBiglietto ridotto : 10?\nIntero: 15?\nBiglietti disponibili presso il casinò, l'ufficio turistico e ticketmaster."
        ],
        "fr": [
          "La voie d'Aznavour avec Titiano accompagné d'Éric Wilms au piano chef d'orchestre de Monsieur Aznavour le samedi 07 juin 2025 à 20h30 au Kursaal de Berck \n\nTarifs :\nRéduit : 10€\nPlein : 15€ \nBilletterie ouverte : casino, office de tourisme et ticketmaster."
        ],
        "nl": [
          "La voie d'Aznavour met Titiano begeleid door Éric Wilms op piano Monsieur Aznavour's dirigent op zaterdag 07 juni 2025 om 20.30 uur in het Kursaal in Berck\n\nTickets :\nGereduceerd ticket : 10?\nVol: €15\nTickets verkrijgbaar bij het casino, toeristenbureau en ticketmaster."
        ],
        "es": [
          "La voie d'Aznavour con Titiano acompañado al piano por Éric Wilms, director de la orquesta de Monsieur Aznavour, el sábado 07 de junio de 2025 a las 20.30 h en el Kursaal de Berck\n\nEntradas :\nEntrada reducida : 10?\nCompleta: 15?\nEntradas disponibles en el casino, la oficina de turismo y ticketmaster."
        ]
      },
