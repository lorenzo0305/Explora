      "dc:description": {
        "de": [
          "Die großen Feste von Lens enden in guter Stimmung mit Gilbert Montagné, der auf dem Rathausvorplatz für Stimmung sorgen wird."
        ],
        "en": [
          "Lens?s grand festivities will come to a close with Gilbert Montagné, who will set the mood on the square in front of the town hall."
        ],
        "it": [
          "I grandi festeggiamenti di Lens saranno conclusi da Gilbert Montagné, che sarà a disposizione per creare l'atmosfera sul piazzale del municipio."
        ],
        "fr": [
          "Les grandes fêtes de Lens se termineront dans la bonne humeur en présence de Gilbert Montagné qui viendra mettre l’ambiance sur le parvis de la mairie."
        ],
        "es": [
          "Gilbert Montagné clausurará la gran fiesta de Lens y se encargará de ambientar la explanada del ayuntamiento."
        ],
        "nl": [
          "De grote festiviteiten in Lens worden afgesloten door Gilbert Montagné, die op het voorplein van het stadhuis de sfeer erin brengt."
        ]
      },
