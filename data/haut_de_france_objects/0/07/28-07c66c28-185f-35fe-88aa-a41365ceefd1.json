      "@id": "https://data.datatourisme.fr/b93fb2dc-7bb4-3218-a9e1-8569b5d258ba",
      "dc:description": {
        "de": [
          "Rozana ist ein Restaurant, das libanesische und syrische Küche anbietet. Die Vielfalt an typischen, hausgemachten Gerichten lässt die Gäste in die gastronomische Welt eintauchen, die sie erwarten."
        ],
        "en": [
          "Rozana is a restaurant that offers Lebanese and Syrian cuisine, a variety of typical homemade dishes that will plunge guests into the gastronomic universe they are waiting for."
        ],
        "it": [
          "Rozana è un ristorante che offre cucina libanese e siriana, una varietà di piatti tipici fatti in casa che immergeranno i clienti nel mondo gastronomico che si aspettano."
        ],
        "fr": [
          "Rozana est un restaurant qui propose une cuisine libanaise et syrienne, une diversité de plats typiques faits maison qui feront plonger les clients dans l'univers gastronomique qu'ils attendent."
        ],
        "nl": [
          "Rozana is een restaurant met een Libanese en Syrische keuken, een verscheidenheid aan typische huisgemaakte gerechten die de klanten onderdompelen in de gastronomische wereld die zij verwachten."
        ],
        "es": [
          "Rozana es un restaurante que ofrece cocina libanesa y siria, una variedad de platos típicos caseros que sumergirán a los clientes en el mundo gastronómico que esperan."
        ]
      },
