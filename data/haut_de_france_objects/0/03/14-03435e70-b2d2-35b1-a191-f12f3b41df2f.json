  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/a03d0a5a-22e4-3ce8-9bc1-f20a92d9874e",
      "dc:description": {
        "de": [
          "Valérie lädt Kinder von 2 bis 6 Jahren zu Lesungen ein.\nFür die älteren Kinder gibt es einen geselligen Abend mit Gesellschaftsspielen, der von Jonathan Bourdon moderiert wird, alles in geselliger Runde und guter Laune."
        ],
        "en": [
          "Valérie invites children aged 2 to 6 to read to them.\nFor older children, Jonathan Bourdon hosts an evening of board games in a friendly, fun atmosphere."
        ],
        "it": [
          "Valérie leggerà ai bambini dai 2 ai 6 anni.\nPer i più grandi, Jonathan Bourdon organizzerà una serata di giochi da tavolo in un'atmosfera amichevole e divertente."
        ],
        "fr": [
          "Valérie invite les enfants de 2 à 6 ans pour des lectures.\nPour les plus grands, une soirée conviviale autour de jeux se société, animée par Jonathan Bourdon, le tout dans la convivialité et la bonne humeur."
        ],
        "nl": [
          "Valérie zal voorlezen aan kinderen van 2 tot 6 jaar.\nVoor de oudere kinderen organiseert Jonathan Bourdon een avond met gezelschapsspelletjes in een gezellige sfeer."
        ],
        "es": [
          "Valérie leerá a niños de 2 a 6 años.\nPara los más mayores, Jonathan Bourdon ofrecerá una tarde de juegos de mesa en un ambiente agradable y divertido."
        ]
      },
