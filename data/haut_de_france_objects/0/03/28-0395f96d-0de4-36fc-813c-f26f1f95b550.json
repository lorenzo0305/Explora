  "rdfs:comment": {
    "de": [
      "Oldtimer-Fahrzeuge von 1900 bis 1980.\nVermietung für Hochzeiten, Veranstaltungen, Kino, Location, Transport!\n\nDas etwas andere Museum!"
    ],
    "en": [
      "Vintage vehicles from 1900 to 1980.\nRenting for weddings, events, cinema, location, transport !\n\nThe museum like no other!"
    ],
    "it": [
      "Veicoli d'epoca dal 1900 al 1980.\nNoleggio per matrimoni, eventi, cinema, location, trasporti!\n\nIl museo come nessun altro!"
    ],
    "fr": [
      "Véhicules de collection de 1900 à 1980.\nLocation pour mariages, événementiel, cinéma, emplacement, transport !\n\nLe musée pas comme les autres !"
    ],
    "nl": [
      "Vintage voertuigen van 1900 tot 1980.\nVerhuur voor bruiloften, evenementen, bioscoop, locatie, transport!\n\nHet museum als geen ander!"
    ],
    "es": [
      "Vehículos de época de 1900 a 1980.\n¡Alquiler para bodas, eventos, cine, localizaciones, transporte!\n\n¡El museo como ningún otro!"
    ]
