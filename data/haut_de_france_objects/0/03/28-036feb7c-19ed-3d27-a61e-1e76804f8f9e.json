  "rdfs:comment": {
    "de": [
      "Der Parc d'Isle, eine wahre Freizeitoase, bietet Sportlern, Naturliebhabern, Familien, Feinschmeckern... die Möglichkeit, dem Alltag zu entfliehen, ihrer Leidenschaft zu frönen und sich in einem außergewöhnlichen Rahmen mitten in der Stadt zu entspannen."
    ],
    "en": [
      "The Parc d'Isle, a veritable oasis of leisure, offers sports enthusiasts, nature lovers, families and gourmets the chance to get away from it all, indulge their passion and relax in an exceptional setting right in the heart of the city."
    ],
    "it": [
      "Il Parc d'Isle, una vera e propria oasi di svago, offre agli sportivi, agli amanti della natura, alle famiglie e ai buongustai la possibilità di staccare la spina, assecondare le proprie passioni e rilassarsi in un ambiente eccezionale nel cuore della città."
    ],
    "fr": [
      "Le Parc d'Isle, véritable oasis de loisirs, offre la possibilité aux sportifs, aux amoureux de la nature, aux familles, aux gourmands... de s'évader, de s'adonner à leur passion, de se détendre dans un cadre exceptionnel en plein cœur urbain."
    ],
    "nl": [
      "Het Parc d'Isle, een ware oase van ontspanning, biedt sportliefhebbers, natuurliefhebbers, gezinnen en fijnproevers de kans om er even helemaal tussenuit te zijn, hun passie uit te leven en te ontspannen in een uitzonderlijke omgeving in het hart van de stad."
    ],
    "es": [
      "El Parc d'Isle, verdadero oasis de ocio, ofrece a los deportistas, amantes de la naturaleza, familias y gourmets la posibilidad de evadirse, dar rienda suelta a su pasión y relajarse en un marco excepcional en pleno centro de la ciudad."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Le Parc d'Isle Jacques Braconnier et son Isle sauvage"
    ]
  },
  "creationDate": "2016-07-25",
