  "rdfs:comment": {
    "de": [
      "William Néo, ein junger Tenor aus dem Norden, wird ein breites Spektrum an Liedern von gestern bis heute vortragen!"
    ],
    "en": [
      "William Néo, a young tenor from Northern France, will perform a wide range of songs from the past to the present!"
    ],
    "it": [
      "William Néo, giovane tenore del nord della Francia, si esibirà in una vasta gamma di canzoni dal passato al presente!"
    ],
    "fr": [
      "William Néo, jeune nordiste ténor, interprétera un panel très large de chansons d’hier à aujourd’hui !"
    ],
    "es": [
      "William Néo, joven tenor del norte de Francia, interpretará un amplio abanico de canciones del pasado y del presente"
    ],
    "nl": [
      "William Néo, een jonge tenor uit het noorden van Frankrijk, zal een breed scala aan liederen van vroeger tot nu ten gehore brengen!"
    ]
  },
