  "rdfs:comment": {
    "de": [
      "Guy Alloucherie, der von einer Autofiktion getragen wird, die seine Erinnerungen als Arbeiterkind aufruft, bietet eine seiner intimsten Aufführungen."
    ],
    "en": [
      "Guy Alloucherie offers one of his most intimate shows, driven by a self-fiction that recalls his memories as a working-class child."
    ],
    "it": [
      "Guy Alloucherie propone uno dei suoi spettacoli più intimi, guidato da un'autofiction che evoca i suoi ricordi di bambino della classe operaia."
    ],
    "fr": [
      "Porté par une auto-fiction qui convoque ses souvenirs d’enfant d’ouvrier, Guy Alloucherie offre l’un de ses spectacles les plus intimes."
    ],
    "es": [
      "Guy Alloucherie ofrece una de sus interpretaciones más íntimas, impulsado por una autoficción que evoca sus recuerdos de niño de clase obrera."
    ],
    "nl": [
      "Guy Alloucherie geeft een van zijn meest intieme optredens, gedreven door een zelfbeschouwing die zijn herinneringen aan het opgroeien als kind uit de arbeidersklasse oproept."
    ]
  },
