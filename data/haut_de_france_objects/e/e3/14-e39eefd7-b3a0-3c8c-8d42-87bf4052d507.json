  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/096a4991-7d11-30f5-8f09-ef2408b689dd",
      "dc:description": {
        "de": [
          "Sie sind eingeladen, mit Ihrer Familie an einer Tafel mit Kreidezeichnungen unter den Augen des Publikums und zum Thema Meer teilzunehmen - Von 14:30 bis 15:30 Uhr\nDas Material wird bereitgestellt und wir bieten Ihnen einen Snack an - Anmeldung beim Fremdenverkehrsamt erforderlich - Kostenlos"
        ],
        "en": [
          "You and your family are invited to take part in a chalk drawing competition on the theme of the sea - 2:30 pm to 3:30 pm\nMaterials provided, snack included - Registration required at the Tourist Office - Free of charge"
        ],
        "it": [
          "Voi e la vostra famiglia siete invitati a partecipare a un concorso di disegno con i gessetti sul tema del mare - 14.30-15.30\nMateriale fornito e merenda gratuita - Iscrizione obbligatoria presso l'Ufficio del Turismo - Gratuito"
        ],
        "fr": [
          "Vous êtes invités à participer en famille à un tableau de dessins à la craie sous les yeux du public et sur le thème de la mer - De 14h30 à 15h30\nLe matériel est fourni et nous vous offrons le goûter - Inscription indispensable à l'Office de Tourisme - Gratuit"
        ],
        "es": [
          "Usted y su familia están invitados a participar en un concurso de dibujo con tiza sobre el tema del mar - 14h30 a 15h30\nMaterial y merienda gratuitos - Inscripción obligatoria en la Oficina de Turismo - Gratuito"
        ],
        "nl": [
          "Jij en je familie worden uitgenodigd om deel te nemen aan een krijttekenwedstrijd met als thema de zee - 14.30 - 15.30 uur\nMaterialen worden verstrekt en een gratis snack - Inschrijving vereist bij het VVV-kantoor - Gratis"
        ]
      },
      "@type": [
        "Description"
      ],
