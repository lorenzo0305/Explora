  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/399bee3f-bba0-3755-ba7b-9c95e966ff08",
      "dc:description": {
        "de": [
          "Verkauf und Verleih von Stadt-, Freizeit- und Elektrofahrrädern (keine Mountainbikes)\nVermietung von Rosalies\n\nTäglich von 10:00 bis 18:00 Uhr geöffnet, außer mittwochs und donnerstags (von 10:00 bis 19:00 Uhr)\nKeine Reservierungen"
        ],
        "en": [
          "Sale and rental of city, leisure and electric bikes (no mountain bikes)\nRosalie rental\n\nOpen from 10am to 6pm every day except Wednesdays and Thursdays (from 10am to 7pm)\nNo reservations"
        ],
        "it": [
          "Vendita e noleggio di biciclette da città, da tempo libero ed elettriche (no mountain bike)\nNoleggio Rosalia\n\nAperto dalle 10.00 alle 18.00 tutti i giorni tranne il mercoledì e il giovedì (dalle 10.00 alle 19.00)\nNessuna prenotazione"
        ],
        "fr": [
          "Vente et location de vélos de ville, de loisirs et électriques (pas de VTT)\nLocation de rosalies\n\nOuvert de 10h00 à 18h00 tous les jours sauf les mercredis et jeudis (de 10h00 à 19h00)\nPas de réservations"
        ],
        "nl": [
          "Verkoop en verhuur van stadsfietsen, vrijetijdsfietsen en elektrische fietsen (geen mountainbikes)\nRosalia huren\n\nDagelijks geopend van 10.00 tot 18.00 uur, behalve op woensdag en donderdag (van 10.00 tot 19.00 uur)\nGeen reserveringen"
        ],
        "es": [
          "Venta y alquiler de bicicletas urbanas, de ocio y eléctricas (no hay bicicletas de montaña)\nAlquiler de Rosalía\n\nAbierto de 10.00 a 18.00 horas todos los días excepto los miércoles y jueves (de 10.00 a 19.00 horas)\nSin reservas"
        ]
      },
      "@type": [
        "Description"
