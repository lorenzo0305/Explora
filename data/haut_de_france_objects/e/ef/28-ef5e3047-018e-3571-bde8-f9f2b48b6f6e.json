  "rdfs:comment": {
    "de": [
      "Verbringen Sie einen schönen kulinarischen Moment in einer freundlichen und herzlichen Atmosphäre mit Julie, Dorian und dem gesamten Team! Alle servierten Gerichte sind mit dem Zertifikat \"Fait Maison\" ausgezeichnet\nNeben dem Gourmetrestaurant bietet die Herberge auch 4 Zimmer im charmanten Dorf Apremont."
    ],
    "en": [
      "Spend a good culinary moment in a warm and friendly atmosphere with Julie, Dorian and the whole team! All the dishes served are certified \"Fait Maison\"\nIn addition to its gastronomic restaurant, the inn offers 4 rooms in the charming village of Apremont."
    ],
    "it": [
      "Godetevi un buon pasto in un'atmosfera calda e amichevole con Julie, Dorian e tutto il team! Tutti i piatti serviti sono certificati \"Fait Maison\"\nOltre al suo ristorante gastronomico, la locanda offre 4 camere nell'incantevole villaggio di Apremont."
    ],
    "fr": [
      "Passez un bon moment culinaire dans une ambiance conviviale et chaleureuse avec Julie,  Dorian et toute l’équipe ! Tous les plats servis sont certifiés \"Fait Maison\". \nEn plus de son restaurant gastronomique, l'auberge propose 4 chambres dans le charmant village d’Apremont."
    ],
    "nl": [
      "Geniet van een goede maaltijd in een warme en vriendelijke sfeer met Julie, Dorian en het hele team! Alle geserveerde gerechten zijn gecertificeerd \"Fait Maison\"\nNaast het gastronomische restaurant biedt de herberg 4 kamers in het charmante dorpje Apremont."
    ],
    "es": [
      "Disfrute de una buena comida en un ambiente cálido y agradable con Julie, Dorian y todo el equipo Todos los platos que se sirven están certificados como \"Fait Maison\"\nAdemás de su restaurante gastronómico, la posada ofrece 4 habitaciones en el encantador pueblo de Apremont."
    ]
  },
  "rdfs:label": {
    "fr": [
      "Auberge de la Grange aux Loups"
    ]
  },
