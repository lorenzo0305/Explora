  "rdfs:comment": {
    "de": [
      "Von der Ernte bis zur Assemblage empfängt Sie der Champagner Faÿ, der seit 1695 vom Vater auf den Sohn übergegangen ist, um seine Leidenschaft mit Ihnen zu teilen. Besichtigung der Anlagen von der Presse bis zur Flaschenabfüllung und Besuch der Weinberge auf Anfrage."
    ],
    "en": [
      "From harvest to blending, Faÿ champagne from father to son since 1695 welcomes you to share its passion. Visit of the installations, from the press to the bottling and visit of the vineyards on request."
    ],
    "it": [
      "Dalla vendemmia all'assemblaggio, lo champagne Faÿ di padre in figlio dal 1695 vi accoglie per condividere la sua passione. Visita degli impianti, dalla pressa all'imbottigliamento e visita dei vigneti su richiesta."
    ],
    "fr": [
      "De la récolte à l’assemblage le champagne Faÿ de père en fils depuis 1695 vous accueille pour vous faire partager sa passion. Visite des installations, du pressoir à la mise en bouteille et visite des vignes sur demande."
    ],
    "nl": [
      "Van de oogst tot het mengen, Champagne Faÿ, sinds 1695 doorgegeven van vader op zoon, heet u welkom om zijn passie te delen. Bezoek aan de installaties, van de pers tot de botteling en bezoek aan de wijngaarden op verzoek."
    ],
    "es": [
      "Desde la vendimia hasta el ensamblaje, el champán Faÿ de padre a hijo desde 1695 le invita a compartir su pasión. Visita de las instalaciones, desde la prensa hasta el embotellado y visita de los viñedos a petición."
    ]
  },
