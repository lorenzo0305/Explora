  "hasDescription": [
    {
      "@id": "https://data.datatourisme.fr/0874551a-dba2-34c9-85ec-7ee530af1f41",
      "dc:description": {
        "de": [
          "Die Association de la rue du Clape-en-Bas ist ein Zusammenschluss von Handwerkern und Händlern in derselben Straße, die das ganze Jahr über Veranstaltungen organisieren (Frühlingsfest, Weihnachtsmarkt...)."
        ],
        "en": [
          "The association de la rue du Clape-en-Bas is a group of artisans and shopkeepers from the same street, who organize events throughout the year (spring festival, Christmas market...)."
        ],
        "it": [
          "L'associazione della rue du Clape-en-Bas è un gruppo di artigiani e negozianti di questa stessa strada, che organizza eventi durante tutto l'anno (festa di primavera, mercatino di Natale...)."
        ],
        "fr": [
          "L'association de la rue du Clape-en-Bas est un regroupement des artisans et commerçants de cette même rue, qui organisent tout au long de l'année des évènements (fête du printemps, marché de Noël...)."
        ],
        "es": [
          "La asociación de la rue du Clape-en-Bas es una agrupación de artesanos y comerciantes de esta misma calle, que organizan eventos a lo largo del año (fiesta de la primavera, mercado de Navidad...)."
        ],
        "nl": [
          "De vereniging van de Clape-en-Basstraat is een groep ambachtslieden en winkeliers uit deze straat die het hele jaar door evenementen organiseert (lentefeest, kerstmarkt...)."
        ]
      },
