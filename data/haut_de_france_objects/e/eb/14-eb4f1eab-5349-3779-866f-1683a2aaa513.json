      "dc:description": {
        "de": [
          "Die \"Haut Pays\" ist eine 32 km lange Strecke für Radwanderer.\nHöhenunterschied: 90 bis 180 | Schwierigkeitsgrad: mittelschwer"
        ],
        "en": [
          "The \"Haut Pays\" is a 32 km route for cycling enthusiasts.\nDifference in altitude: 90 to 180 | Difficulty: medium"
        ],
        "it": [
