  "rdfs:comment": {
    "de": [
      "Ein Ort, der hauptsächlich für Privatisierungen am Wochenende (Hochzeiten, Kommunionen, Taufen, Geburtstage) genutzt wird.\n\nPrivatisierungen sind auch außerhalb der Öffnungszeiten möglich."
    ],
    "en": [
      "A living space dedicated mainly to weekend events (weddings, communions, christenings, birthdays).\n\nPrivatization possible outside opening days."
    ],
    "it": [
      "Questo locale è dedicato principalmente agli eventi del fine settimana (matrimoni, comunioni, battesimi, compleanni).\n\nPossibilità di privatizzazione al di fuori dei giorni di apertura."
    ],
    "fr": [
      "Lieu de vie dédier principalement aux privatisations le week-end (mariage, communion, baptême, anniversaire).\n\nPrivatisation possible hors des jours d'ouverture."
    ],
    "es": [
      "Este local se dedica principalmente a eventos de fin de semana (bodas, comuniones, bautizos, cumpleaños).\n\nPosibilidad de privatización fuera de los días de apertura."
    ],
    "nl": [
      "Deze locatie is vooral bedoeld voor evenementen in het weekend (bruiloften, communies, doopfeesten, verjaardagen).\n\nPrivatisering mogelijk buiten de openingsdagen."
    ]
  },
